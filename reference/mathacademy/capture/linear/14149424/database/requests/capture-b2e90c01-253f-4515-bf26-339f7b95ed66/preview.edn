86045417 true] [17592186444835 1079 #uuid "d5a0a656-3346-573d-b4f8-1b43ee3ba445" 13194139534935 17592186045417 true] [17592186444836 1068 #edb/ref 17592186444833 13194139534935 17592186045417 true] [17592186444836 1069 "q-173782" 13194139534935 17592186045417 true] [17592186444836 1070 #edb/ref 17592186045486 13194139534935 17592186045417 true] [17592186444836 1071 "Expressed as a fraction in its simplest form, $\\frac{2}{3}+(-\\frac{4}{9})=${{field-1}}." 13194139534935 17592186045417 true] [17592186444836 1072 #uuid "17e6f69c-9289-5c2f-847c-503ec0fb9123" 13194139534935 17592186045417 true] [17592186444836 1074 "First, we drop the parentheses and the addition sign, which gives \n\n$$\n\\frac{2}{3}+(-\\frac{4}{9})=\\frac{2}{3}-\\frac{4}{9}.\n$$\n\n \n\nNow, we put the fractions over a common denominator of $9$ and combine the numerators, which gives\n\n$$\n\\begin{aligned}\\frac{2}{3}-\\frac{4}{9} & =\\frac{6}{9}-\\frac{4}{9}=\\frac{6-4}{9}.\\end{aligned}\n$$\n\nNext, we work out $6-4$ using our number line.\n\n![](images/4e/4ebf100b7da9bbada9145b4b5ea018cfee8ff2037307ca5023d6c2de54705fdd.png)\n\nWe find that $6-4=2.$ So, we get\n\n$$\n\\frac{6-4}{9}=\\frac{2}{9}.\n$$" 13194139534935 17592186045417 true] [17592186444837 1068 #edb/ref 17592186444831 13194139534935 17592186045417 true] [17592186444837 1069 "q-1955" 13194139534935 17592186045417 true] [17592186444837 1070 #edb/ref 17592186045487 13194139534935 17592186045417 true] [17592186444837 1071 "$2+(-5)=$" 13194139534935 17592186045417 true] [17592186444837 1072 #uuid "400c3acc-5e79-52be-941c-8ede9d67d05b" 13194139534935 17592186045417 true] [17592186444837 1074 "We drop the parentheses and the addition sign to give $2+(-5)=2-5.$ \n\nThen, we move $5$ spaces to the left of $2$ on a number line.\n\n![](images/c6/c63a3db44b79e751c7cf1a49dcebcbb1d00cea0427da4ef271d07646e4be2748.png)\n\nWe end up at $-3.$ So, $2+(-5)=-3.$" 13194139534935 17592186045417 true] [17592186444838 1068 #edb/ref 17592186444834 13194139534935 17592186045417 true] [17592186444838 1069 "q-42864" 13194139534935 17592186045417 true] [17592186444838 1070 #edb/ref 17592186045485 13194139534935 17592186045417 true] [17592186444838 1071 "What is  $\\text{ }-\\frac{1}{11}+(-\\frac{3}{11})?$" 13194139534935 17592186045417 true] [17592186444838 1072 #uuid "4ba4fabf-8311-5600-bcfe-05b44a10e255" 13194139534935 17592186045417 true] [17592186444838 1074 "First, we drop the parentheses and the addition sign, which gives\n\n$$\n\\text{ }-\\frac{1}{11}+(-\\frac{3}{11})=-\\frac{1}{11}-\\frac{3}{11}.\n$$\n\n \n\nNow, since both fractions have a common denominator of $11$, we can combine the numerators, which gives\n\n$$\n\\begin{aligned}-\\frac{1}{11}-\\frac{3}{11} & =\\frac{-1-3}{11}.\\end{aligned}\n$$\n\nNext, we work out $-1-3$ using our number line.\n\n![](images/64/64d008419fd882c918e73b577956b3e36d3a32814fff62d495c0f75b7d107cd1.png)\n\nWe find that $-1-3=-4.$ So, we get\n\n$$\n\\frac{-1-3}{11}=\\frac{-4}{11}=-\\frac{4}{11}.\n$$" 13194139534935 17592186045417 true] [17592186444839 1068 #edb/ref 17592186444830 13194139534935 17592186045417 true] [17592186444839 1069 "q-6127" 13194139534935 17592186045417 true] [17592186444839 1070 #edb/ref 17592186045485 13194139534935 17592186045417 true] [17592186444839 1071 "What is $170+(-70)?$" 13194139534935 17592186045417 true] [17592186444839 1072 #uuid "ba9103c6-cd4f-5fe9-b177-f46928ef48cb" 13194139534935 17592186045417 true] [17592186444839 1074 "We drop the parentheses and the addition sign to give \n\n$$\n170+(-70)=170-70.\n$$\n\n \n\nThen, we carry out the subtraction as usual. This gives\n \n\n$$\n170-70=100.\n$$" 13194139534935 17592186045417 true] [17592186444840 1068 #edb/ref 17592186444835 13194139534935 17592186045417 true] [17592186444840 1069 "q-101304" 13194139534935 17592186045417 true] [17592186444840 1070 #edb/ref 17592186045485 13194139534935 17592186045417 true] [17592186444840 1071 "What is the value of  $9+(-5.5)?$" 13194139534935 17592186045417 true] [17592186444840 1072 #uuid "e1a479d0-fff3-5ce1-b03e-c90e28459585" 13194139534935 17592186045417 true] [17592186444840 1074 "First, we drop the parentheses and the addition sign, which gives\n\n$$\n9+(-5.5)=9-5.5.\n$$\n\nThen, we carry out the subtraction as usual. This gives\n\n$$\n9-5.5=3.5.\n$$" 13194139534935 17592186045417 true] [17592186444841 1068 #edb/ref 17592186444832 13194139534935 17592186045417 true] [17592186444841 1069 "q-128163" 13194139534935 17592186045417 true] [17592186444841 1070 #edb/ref 17592186045487 13194139534935 17592186045417 true] [17592186444841 1071 "What is the value of  $4.7+(-2.5)?$" 13194139534935 17592186045417 true] [17592186444841 1072 #uuid "f9cc8296-f82a-5b59-ab73-a756fc3da0a9" 13194139534935 17592186045417 true] [17592186444841 1074 "First, we drop the parentheses and the addition sign, which gives\n\n$$\n4.7+(-2.5)=4.7-2.5.\n$$\n\nThen, we carry out the subtraction as usual. This gives\n\n$$\n4.7-2.5=2.2.\n$$" 13194139534935 17592186045417 true]] :edb/tempids {"answer-01c085a6-ae35-5446-a9d4-f5599073a413" 17592186444804 "answer-1672c441-3685-546c-b7a6-44e9598ab827" 17592186444805 "answer-28addabe-4e7b-5428-996d-bbd2705ac3b0" 17592186444806 "answer-2a1794ec-e0e4-5310-8b42-ba080bc3d470" 17592186444807 "answer-3ac01d11-7fca-5866-9f35-fc51aef94fd5" 17592186444808 "answer-3ce8bdb3-5972-5a6b-905e-649b466ed368" 17592186444809 "answer-40e46888-3661-52b7-a84f-201e60473da5" 17592186444810 "answer-507dfdb9-0cd7-5932-8c7d-12c1f95fca95" 17592186444811 "answer-523ea15b-7817-5cc6-9723-b93a5c21253d" 17592186444812 "answer-555c9abd-386a-5aaf-a290-7c4f877b5e94" 17592186444813 "answer-622599ef-0615-50ac-af07-8dc9e9fc7fb3" 17592186444814 "answer-67dac6e0-cbfa-5b12-95a3-47db6eeb58ed" 17592186444815 "answer-6c2385dd-e704-5a6f-a5a8-c37149fa46c1" 17592186444816 "answer-6f23ceae-2b55-5e9c-975a-4db1133f2947" 17592186444817 "answer-7181e624-d73c-5c12-82b2-ebdd0c446fe8" 17592186444818 "answer-71abb7b2-24fe-5386-846c-d29251f1c081" 17592186444819 "answer-7ed42