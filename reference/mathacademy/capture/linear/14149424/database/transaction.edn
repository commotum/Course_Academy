0e4-5310-8b42-ba080bc3d470" :answer/type :answer.type/math :answer/value "-1.8" :db/ensure [:answer/validate]} {:db/id "answer-a43e8c22-6b1b-5f17-81d2-f92d54c64990" :answer/id #uuid "a43e8c22-6b1b-5f17-81d2-f92d54c64990" :answer/type :answer.type/math :answer/value "-2.3" :db/ensure [:answer/validate]} {:db/id "answer-1672c441-3685-546c-b7a6-44e9598ab827" :answer/id #uuid "1672c441-3685-546c-b7a6-44e9598ab827" :answer/type :answer.type/math :answer/value "1.8" :db/ensure [:answer/validate]} {:db/id "answer-fdb55062-1d7c-567b-832e-ea3ccf6e358a" :answer/id #uuid "fdb55062-1d7c-567b-832e-ea3ccf6e358a" :answer/type :answer.type/math :answer/value "2.2" :db/ensure [:answer/validate]} {:db/id "answer-622599ef-0615-50ac-af07-8dc9e9fc7fb3" :answer/id #uuid "622599ef-0615-50ac-af07-8dc9e9fc7fb3" :answer/type :answer.type/math :answer/value "2.3" :db/ensure [:answer/validate]} {:db/id "question-4ba4fabf-8311-5600-bcfe-05b44a10e255" :question/id #uuid "4ba4fabf-8311-5600-bcfe-05b44a10e255" :question/math-academy-id "q-42864" :question/problem "What is  $\\text{ }-\\frac{1}{11}+(-\\frac{3}{11})?$" :question/worked-solution "First, we drop the parentheses and the addition sign, which gives\n\n$$\n\\text{ }-\\frac{1}{11}+(-\\frac{3}{11})=-\\frac{1}{11}-\\frac{3}{11}.\n$$\n\n \n\nNow, since both fractions have a common denominator of $11$, we can combine the numerators, which gives\n\n$$\n\\begin{aligned}-\\frac{1}{11}-\\frac{3}{11} & =\\frac{-1-3}{11}.\\end{aligned}\n$$\n\nNext, we work out $-1-3$ using our number line.\n\n![](images/64/64d008419fd882c918e73b577956b3e36d3a32814fff62d495c0f75b7d107cd1.png)\n\nWe find that $-1-3=-4.$ So, we get\n\n$$\n\\frac{-1-3}{11}=\\frac{-4}{11}=-\\frac{4}{11}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a615bd8f-0f0f-5ad3-ae80-ed83e37ef67c"] :db/ensure [:question/validate]} {:db/id "answer-field-a615bd8f-0f0f-5ad3-ae80-ed83e37ef67c" :answer-field/id #uuid "a615bd8f-0f0f-5ad3-ae80-ed83e37ef67c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-71abb7b2-24fe-5386-846c-d29251f1c081" :answer-field/choices ["answer-d28840ce-257e-593b-ac2f-5ded1891a387" "answer-01c085a6-ae35-5446-a9d4-f5599073a413" "answer-7181e624-d73c-5c12-82b2-ebdd0c446fe8" "answer-71abb7b2-24fe-5386-846c-d29251f1c081" "answer-9b88212e-44c8-5c0a-9dfa-9355dd0b993c"] :db/ensure [:answer-field/validate]} {:db/id "answer-d28840ce-257e-593b-ac2f-5ded1891a387" :answer/id #uuid "d28840ce-257e-593b-ac2f-5ded1891a387" :answer/type :answer.type/math :answer/value "-\\frac{1}{11}" :db/ensure [:answer/validate]} {:db/id "answer-01c085a6-ae35-5446-a9d4-f5599073a413" :answer/id #uuid "01c085a6-ae35-5446-a9d4-f5599073a413" :answer/type :answer.type/math :answer/value "-\\frac{2}{11}" :db/ensure [:answer/validate]} {:db/id "answer-7181e624-d73c-5c12-82b2-ebdd0c446fe8" :answer/id #uuid "7181e624-d73c-5c12-82b2-ebdd0c446fe8" :answer/type :answer.type/math :answer/value "-\\frac{3}{11}" :db/ensure [:answer/validate]} {:db/id "answer-71abb7b2-24fe-5386-846c-d29251f1c081" :answer/id #uuid "71abb7b2-24fe-5386-846c-d29251f1c081" :answer/type :answer.type/math :answer/value "-\\frac{4}{11}" :db/ensure [:answer/validate]} {:db/id "answer-9b88212e-44c8-5c0a-9dfa-9355dd0b993c" :answer/id #uuid "9b88212e-44c8-5c0a-9dfa-9355dd0b993c" :answer/type :answer.type/math :answer/value "\\frac{2}{11}" :db/ensure [:answer/validate]} {:db/id "question-17e6f69c-9289-5c2f-847c-503ec0fb9123" :question/id #uuid "17e6f69c-9289-5c2f-847c-503ec0fb9123" :question/math-academy-id "q-173782" :question/problem "Expressed as a fraction in its simplest form, $\\frac{2}{3}+(-\\frac{4}{9})=${{field-1}}." :question/worked-solution "First, we drop the parentheses and the addition sign, which gives \n\n$$\n\\frac{2}{3}+(-\\frac{4}{9})=\\frac{2}{3}-\\frac{4}{9}.\n$$\n\n \n\nNow, we put the fractions over a common denominator of $9$ and combine the numerators, which gives\n\n$$\n\\begin{aligned}\\frac{2}{3}-\\frac{4}{9} & =\\frac{6}{9}-\\frac{4}{9}=\\frac{6-4}{9}.\\end{aligned}\n$$\n\nNext, we work out $6-4$ using our number line.\n\n![](images/4e/4ebf100b7da9bbada9145b4b5ea018cfee8ff2037307ca5023d6c2de54705fdd.png)\n\nWe find that $6-4=2.$ So, we get\n\n$$\n\\frac{6-4}{9}=\\frac{2}{9}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-95888e19-1242-5bc8-a7ff-63552a9743bd"] :db/ensure [:question/validate]} {:db/id "answer-field-95888e19-1242-5bc8-a7ff-63552a9743bd" :answer-field/id #uuid "95888e19-1242-5bc8-a7ff-63552a9743bd" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-40e46888-3661-52b7-a84f-201e60473da5" :answer-field/choices ["answer-40e46888-3661-52b7-a84f-201e60473da5"] :db/ensure [:answer-field/validate]} {:db/id "answer-40e46888-3661-52b7-a84f-201e60473da5" :answer/id #uuid "40e46888-3661-52b7-a84f-201e60473da5" :answer/type :answer.type/math :answer/value "\\frac{2}{9}" :db/ensure [:answer/validate]} {:db/id 17592186065358 :tutorial/content "Whenever we add a negative number, we write parentheses around the negative number so that it's easier to read. \n\nFor example, instead of\n\n$$\n7 + - 5\n$$\n\nwhich is difficult to read, we write\n\n$$\n7+(-5).\n$$\n\nAdding a negative number is the same as subtracting a positive number. Therefore, we can drop the addition sign and the parentheses in the above expression, which gives\n\n$$\n7 - 5.\n$$\n\nCarrying out the subtraction, as usual, we get \n\n$$\n7 - 5 = 2.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186065359 :tutorial/content "We can add a negative fraction using the same method. To demonstrate, let's find the value of\n\n$$\n\\dfrac{2}{7} + \\left(- \\dfrac{5}{7}\\right).\n$$\n\nFirst, we eliminate the parentheses and obtain\n\n$$\n\\dfrac 2 {7} + \\left(-\\dfrac 5 {7}\\right) = \\dfrac 2 {7} -\\dfrac 5 {7}.\n$$\n\nNow, since both fractions have a common denominator of $7,$ we can combine the numerators, which gives\n\n$$\n\\begin{aligned}\\frac{2}{7}-\\frac{5}{7} & =\\frac{2-5}{7}.\\end{aligned}\n$$\n\nNext, we work out $2 - 5$ using our number line.\n\n![](images/c6/c63a3db44b79e751c7cf1a49dcebcbb1d00cea0427da4ef271d07646e4be2748.png)\n\nWe find that $2-5=-3.$ So, we get\n\n$$\n\\dfrac {2 - 5} {7} = \\dfrac{-3}{7} = -\\dfrac{3}{7}.\n$$\n\nIf two fractions have different denominators, we need to put them over a common denominator first and *then* subtract! Let's see an example." :db/ensure [:tutorial/validate]} {:db/id 17592186064419 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
