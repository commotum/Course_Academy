wer/id #uuid "88a3c421-aaf5-5ed8-8c43-248c1f03d80b" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-ab510ebd-c938-5800-81e9-2a598d7aa486" :answer/id #uuid "ab510ebd-c938-5800-81e9-2a598d7aa486" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "answer-82ac54f9-5cfc-5e36-b51e-d3a83b491819" :answer/id #uuid "82ac54f9-5cfc-5e36-b51e-d3a83b491819" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-555c9abd-386a-5aaf-a290-7c4f877b5e94" :answer/id #uuid "555c9abd-386a-5aaf-a290-7c4f877b5e94" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "question-e1a479d0-fff3-5ce1-b03e-c90e28459585" :question/id #uuid "e1a479d0-fff3-5ce1-b03e-c90e28459585" :question/math-academy-id "q-101304" :question/problem "What is the value of  $9+(-5.5)?$" :question/worked-solution "First, we drop the parentheses and the addition sign, which gives\n\n$$\n9+(-5.5)=9-5.5.\n$$\n\nThen, we carry out the subtraction as usual. This gives\n\n$$\n9-5.5=3.5.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d5a0a656-3346-573d-b4f8-1b43ee3ba445"] :db/ensure [:question/validate]} {:db/id "answer-field-d5a0a656-3346-573d-b4f8-1b43ee3ba445" :answer-field/id #uuid "d5a0a656-3346-573d-b4f8-1b43ee3ba445" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-67dac6e0-cbfa-5b12-95a3-47db6eeb58ed" :answer-field/choices ["answer-6f23ceae-2b55-5e9c-975a-4db1133f2947" "answer-507dfdb9-0cd7-5932-8c7d-12c1f95fca95" "answer-28addabe-4e7b-5428-996d-bbd2705ac3b0" "answer-67dac6e0-cbfa-5b12-95a3-47db6eeb58ed" "answer-be1c0915-f500-5e07-b328-60da3be5475f"] :db/ensure [:answer-field/validate]} {:db/id "answer-6f23ceae-2b55-5e9c-975a-4db1133f2947" :answer/id #uuid "6f23ceae-2b55-5e9c-975a-4db1133f2947" :answer/type :answer.type/math :answer/value "-4.5" :db/ensure [:a