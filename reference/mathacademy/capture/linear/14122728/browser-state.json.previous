mjx-mi class=\"mjx-n\"></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c6D\"></mjx-c><mjx-c class=\"mjx-c6F\"></mjx-c><mjx-c class=\"mjx-c64\"></mjx-c></mjx-mtext><mjx-mstyle><mjx-mspace style=\"width: 0.222em;\"></mjx-mspace></mjx-mstyle><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c><mjx-c class=\"mjx-c35\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left right left\" columnspacing=\"0em 2em 0em\" rowspacing=\"0.8em 0.8em 0.8em 0.3em\"><mtr><mtd><msup><mn>6</mn><mn>2</mn></msup></mtd><mtd><mi></mi><mo>≡</mo><mn>36</mn><mo>≡</mo><mn>25</mn><mo>+</mo><mn>11</mn><mo>≡</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>11</mn></mpadded></mstyle></mtd><mtd></mtd><mtd><mi></mi><mo stretchy=\"false\">(</mo><mtext>mod</mtext><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mn>25</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><msup><mn>6</mn><mn>3</mn></msup></mtd><mtd><mi></mi><mo>≡</mo><mn>11</mn><mo>⋅</mo><mn>6</mn><mo>≡</mo><mn>66</mn><mo>≡</mo><mn>2</mn><mo>⋅</mo><mn>25</mn><mo>+</mo><mn>16</mn><mo>≡</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>16</mn></mpadded></mstyle></mtd><mtd></mtd><mtd><mi></mi><mo stretchy=\"false\">(</mo><mtext>mod</mtext><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mn>25</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><msup><mn>6</mn><mn>4</mn></msup></mtd><mtd><mi></mi><mo>≡</mo><mn>16</mn><mo>⋅</mo><mn>6</mn><mo>≡</mo><mn>96</mn><mo>≡</mo><mn>3</mn><mo>⋅</mo><mn>25</mn><mo>+</mo><mn>21</mn><mo>≡</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>21</mn></mpadded></mstyle></mtd><mtd></mtd><mtd><mi></mi><mo stretchy=\"false\">(</mo><mtext>mod</mtext><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mn>25</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><msup><mn>6</mn><mn>5</mn></msup></mtd><mtd><mi></mi><mo>≡</mo><mn>21</mn><mo>⋅</mo><mn>6</mn><mo>≡</mo><mn>126</mn><mo>≡</mo><mn>5</mn><mo>⋅</mo><mn>25</mn><mo>+</mo><mn>1</mn><mo>≡</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>1</mn></mpadded></mstyle></mtd><mtd></mtd><mtd><mi></mi><mo stretchy=\"false\">(</mo><mtext>mod</mtext><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mn>25</mn><mo stretchy=\"false\">)</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>So, <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"86\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c22C5\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c36\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2261\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mstyle><mjx-mspace style=\"width: 0.222em;\"></mjx-mspace></mjx-mstyle><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c6D\"></mjx-c><mjx-c class=\"mjx-c6F\"></mjx-c><mjx-c class=\"mjx-c64\"></mjx-c></mjx-mtext><mjx-mstyle><mjx-mspace style=\"width: 0.222em;\"></mjx-mspace></mjx-mstyle><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c><mjx-c class=\"mjx-c35\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>21</mn><mo>⋅</mo><mn>6</mn><mo>≡</mo><mn>1</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mo stretchy=\"false\">(</mo><mtext>mod</mtext><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mn>25</mn><mo stretchy=\"false\">)</mo><mo>,</mo></math></mjx-assistive-mml></mjx-container> which means that <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"87\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>21</mn></math></mjx-assistive-mml></mjx-container> is the multiplicative inverse of <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"88\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c36\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn></math></mjx-assistive-mml></mjx-container> (modulo <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"89\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c><mjx-c class=\"mjx-c35\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>25</mn></math></mjx-assistive-mml></mjx-container>).</p>\n<p>Now, multiplying both sides of our congruence by <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"90\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>21</mn><mo>,</mo></math></mjx-assistive-mml></mjx-container> we get the following:</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"91\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 15.24em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-bottom: 0.4em;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c36\"></mjx-c></mjx-mn><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"text-align: left; padding-left: 0px; padding-right: 1em; padding-bottom: 0.4em;\"><mjx-mi class=\"mjx-n\"></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2261\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"text-align: right; padding-left: 1em; padding-right: 0px; padding-bottom: 0.4em;\"><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"text-align: left; padding-left: 0px; padding-bottom: 0.4em;\"><mjx-mi class=\"mjx-n\"></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c