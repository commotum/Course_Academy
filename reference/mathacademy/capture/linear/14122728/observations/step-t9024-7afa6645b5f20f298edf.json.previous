189 617T245 641T273 663Q275 666 285 666Q294 666 302 660V361L303 61Q310 54 315 52T339 48T401 46H427V0H416Q395 3 257 3Q121 3 100 0H88V46H114Q136 46 152 46T177 47T193 50T201 52T207 57T213 61V578Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E4-MJMAIN-67\"></use>\n <use xlink:href=\"#E4-MJMAIN-63\" x=\"500\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-64\" x=\"945\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-28\" x=\"1501\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMATHI-61\" x=\"1891\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-2C\" x=\"2420\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMATHI-6E\" x=\"2865\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-29\" x=\"3466\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-3D\" x=\"4133\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-31\" x=\"5189\" y=\"0\"></use>\n</g>\n</svg></span>, then the linear congruence <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"15.283ex\" height=\"2.843ex\" style=\"vertical-align: -0.838ex;\" viewBox=\"0 -863.1 6580 1223.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-5-Title\">\n<title id=\"MathJax-SVG-5-Title\">ax \\equiv b \\:(\\text{mod}\\:n) </title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E5-MJMATHI-61\" d=\"M33 157Q33 258 109 349T280 441Q331 441 370 392Q386 422 416 422Q429 422 439 414T449 394Q449 381 412 234T374 68Q374 43 381 35T402 26Q411 27 422 35Q443 55 463 131Q469 151 473 152Q475 153 483 153H487Q506 153 506 144Q506 138 501 117T481 63T449 13Q436 0 417 -8Q409 -10 393 -10Q359 -10 336 5T306 36L300 51Q299 52 296 50Q294 48 292 46Q233 -10 172 -10Q117 -10 75 30T33 157ZM351 328Q351 334 346 350T323 385T277 405Q242 405 210 374T160 293Q131 214 119 129Q119 126 119 118T118 106Q118 61 136 44T179 26Q217 26 254 59T298 110Q300 114 325 217T351 328Z\"></path>\n<path stroke-wi