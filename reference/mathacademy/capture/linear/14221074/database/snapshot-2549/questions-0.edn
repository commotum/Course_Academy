443f9ab6-a020-5cfa-8c4c-e19f45851927" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186533297}] :answer-field/correct {:answer/id #uuid "443f9ab6-a020-5cfa-8c4c-e19f45851927" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186533297} :answer-field/id #uuid "22b9b191-e1a0-51ff-9ce2-e94546c08ae8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186533808}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eed297ec-4147-52da-9849-c80c4b4539e7" :question/math-academy-id "q-222406" :question/problem "The solution to $-6(3u-8)^{2}=0$ is $u=${{field-1}}." :question/worked-solution "We can solve this equation using the square root method:\n\n$$\n\\begin{aligned}-6(3u-8)^{2} & =0 \\\\ (3u-8)^{2} & =0 \\\\ \\sqrt{(3u-8)^{2}} & =\\sqrt{0} \\\\ |3u-8| & =0 \\\\ 3u-8 & =0 \\\\ 3u & =8 \\\\ u & =\\frac{8}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186534001 :knowledge-point/_questions [{:db/id #edb/ref 17592186110612 :knowledge-point/id #uuid "637d4fe0-abb6-5050-a541-f132e78f9b8a" :knowledge-point/title "Cases When the Perfect Square is Isolated"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b89d7b54-d20e-5195-b3ec-558a112336ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186533590}] :answer-field/correct {:answer/id #uuid "b89d7b54-d20e-5195-b3ec-558a112336ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186533590} :answer-field/id #uuid "5661bb64-4655-5bc6-81bf-0414e5f463d8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186533849}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "49274b7d-2639-522a-95c1-022f42cefd65" :question/math-academy-id "q-222408" :question/problem "The solution to $-9(8a+2)^{2}=0$ is $a=${{field-1}}." :question/worked-solution "We can solve this equation using the square root method:\n\n$$\n\\begin{aligned}-9(8a+2)^{2} & =0 \\\\ (8a+2)^{2} & =0 \\\\ \\sqrt{(8a+2)^{2}} & =\\sqrt{0} \\\\ |8a+2| & =0 \\\\ 8a+2 & =0 \\\\ 8a & =-2 \\\\ a & =-\\frac{1}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186534042 :knowledge-point/_questions [{:db/id #edb/ref 17592186110614 :knowledge-point/id #uuid "f637b472-4c1a-511b-9820-3e07f659eb25" :knowledge-point/title "Factoring a Perfect Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "467430d2-d07a-5c3b-b1a7-dc892ea22db4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186533303}] :answer-field/correct {:answer/id #uuid "467430d2-d07a-5c3b-b1a7-dc892ea22db4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186533303} :answer-field/id #uuid "90de0081-dc0f-59fe-a632-2b84f638ba91" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186533891}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a2d7658e-2fb7-5107-b38d-4768d5865883" :question/math-academy-id "q-222450" :question/problem "If $4{y}^{2}+12y+9=0,$ then $y=${{field-1}}." :question/worked-solution "First, notice that the left-hand side is a perfect square. It just needs to be factored:\n\n$$\n\\begin{aligned}4{y}^{2}+12y+9 & =0 \\\\ (2y)^{2}+2\\cdot 2y\\cdot 3+{3}^{2} & =0 \\\\ (2y+3)^{2} & =0\\end{aligned}\n$$\n\nFrom here, we solve the equation using the square root method:\n\n$$\n\\begin{aligned}\\sqrt{(2y+3)^{2}} & =\\sqrt{0} \\\\ |2y+3| & =0 \\\\ 2y+3 & =0 \\\\ 2y & =-3 \\\\ y & =-\\frac{3}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186534081 :knowledge-point/_questions [{:db/id #edb/ref 17592186110615 :knowledge-point/id #uuid "02785337-efe0-54cb-9433-46ff4a9c6302" :knowledge-point/title "Equations With No Real Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60a41429-39f2-58c1-b560-95db73d80dcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186533361}] :answer-field/correct {:answer/id #uuid "60a41429-39f2-58c1-b560-95db73d80dcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186533361} :answer-field/id #uuid "451198a5-5570-555a-8151-6082d5376447" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186533836} {:answer-field/choices [{:answer/id #uuid "08b0f9a3-96fa-5db2-be80-838f8d7a19d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186533154}] :answer-field/correct {:answer/id #uuid "08b0f9a3-96fa-5db2-be80-838f8d7a19d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186533154} :answer-field/id #uuid "a220450f-0c54-5533-bc4f-ff97444fb758" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186533904}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "df298759-b302-529c-87f4-be55ef966373" :question/math-academy-id "q-222457" :question/problem "Consider the equation ${v}^{2}-4a=16.$ For which values of $a$ does this equation have no real solutions?\n\n$a$\n{{field-1}}{{field-2}}" :question/worked-solution "Let's try and solve using the square root method:\n\n$$\n\\begin{aligned}{v}^{2}-4a & =16 \\\\ {v}^{2} & =16+4a \\\\ \\sqrt{{v}^{2}} & =\\sqrt{16+4a} \\\\ |v| & =\\sqrt{16+4a}\\end{aligned}\n$$\n\nThe equation will have no real solutions if the expression under the square root is negative, which gives the following condition:\n\n$$\n16+4a<0\n$$\n\nWe solve this inequality for $a:$\n\n$$\n\\begin{aligned}16+4a & <0 \\\\ 4a & <-16 \\\\ a & <-4\\end{aligned}\n$$\n\nTherefore, any value of $a$ that is less than $-4$ will give an equation with no real solutions."}] [{:db/id #edb/ref 17592186534052 :knowledge-point/_questions [{:db/id #edb/ref 17592186110613 :knowledge-point/id #uuid "2aca8019-3239-539c-b7a9-e1a9ca461a61" :knowledge-point/title "Finding an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "073b14de-c3fb-53d0-ba44-f3e01485ce49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{7}" :db/id #edb/ref 17592186533151} {:answer/id #uuid "0c485691-e6f8-54ae-90ca-cb01fde97789" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186533166} {:answer/id #uuid "24535b76-6948-59e2-9575-d8fc949658ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186533230} {:answer/id #uuid "80bb3dec-3e97-5f5b-a04e-48160805e362" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186533445} {:answer/id #uuid "973119e3-80d6-5f70-b10d-e87d31dd0758" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186533510}] :answer-field/correct {:answer/id #uuid "24535b76-6948-59e2-9575-d8fc949658ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186533230} :answer-field/id #uuid "dff3bea7-288a-5339-8c3e-cff9c3c9f964" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186533939}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b60332b2-78d9-552d-bf76-3110fd3f37e1" :question/math-academy-id "q-23862" :question/problem "Which value of $k$ gives precisely one solution to the equation $(1+3x)^{2}-5=k?$" :question/worked-solution "First, we solve for $x$ as follows:\n\n$$\n\\begin{aligned}(1+3x)^{2}-5 & =k \\\\ (1+3x)^{2} & =k+5 \\\\ \\sqrt{(1+3x)^{2}} & =\\sqrt{k+5} \\\\ |1+3x| & =\\sqrt{k+5}\\end{aligned}\n$$\n\nThe equation has only one solution if the right-hand side is equal to zero, and the right-hand side is zero only if the expression underneath the radical is zero. So, we solve for the value of $k$ that makes the expression under the radical equal to zero:\n\n$$\n\\begin{aligned}\\sqrt{k+5} & =0 \\\\ k+5 & =0 \\\\ k & =-5\\end{aligned}\n$$\n\nTherefore, $k=-5$ will give only one solution to the equation."}] [{:db/id #edb/ref 17592186534097 :knowledge-point/_questions [{:db/id #edb/ref 17592186110615 :knowledge-point/id #uuid "02785337-efe0-54cb-9433-46ff4a9c6302" :knowledge-point/title "Equations With No Real Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6262ae6d-1e83-5f5c-9c22-b793d6eb9066" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k<1" :db/id #edb/ref 17592186533366} {:answer/id #uuid "8a602158-e399-5555-aefb-b46bdb30dffa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k>0" :db/id #edb/ref 17592186533471} {:answer/id #uuid "9beae6c8-4ae7-5b4b-b857-6cd17d79aa64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k<-2" :db/id #edb/ref 17592186533517} {:answer/id #uuid "cb4bfac1-0fa6-50fb-944a-b417f8463b45" :answer/type {:db/id #edb/ref 175