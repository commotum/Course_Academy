#{[{:activity/first-step {:db/id #edb/ref 17592186111517} :activity/id #uuid "f6c3553a-0bb2-5e80-aaec-94cddf828cfd" :activity/scope {:db/id #edb/ref 17592186049668 :topic/id #uuid "094d9698-9cc9-5916-96dd-6106a9f252e9" :topic/math-academy-id 1425} :activity/steps [{:db/id #edb/ref 17592186111517 :step/content {:db/id #edb/ref 17592186111919 :tutorial/content "Many quadratic equations have two solutions. However, it's also possible for a quadratic equation to have only one solution or no real solutions at all.\n\nFor example, consider the following quadratic equation:\n\n$$\n(3x-6)^2=0\n$$\n\nWe can solve this equation using the square root method:\n\n$$\n\\begin{aligned}\n(3x - 6)^{2} &= 0 \\\\\n\\sqrt{(3x - 6)^{2}} &= \\sqrt{0} \\\\\n\\mid 3x - 6 \\mid &= 0\n\\end{aligned}\n$$\n\nNormally, at this stage, we would obtain two solutions by setting the inside of the absolute value equal to positive or negative $(\\pm)$ the right-hand side. However, in this case, the right-hand side is zero, and $+0$ and $-0$ are both just $0$.\n\nSo, we have only one solution:\n\n$$\n\\begin{aligned}\n\\mid 3x - 6 \\mid &= 0 \\\\\n3x - 6 &= 0 \\\\\n3x &= 6 \\\\\nx &= 2\n\\end{aligned}\n$$" :tutorial/id #uuid "3b3899a9-dbc6-524a-b493-c57a45bfeda9" :tutorial/math-academy-id 9203 :tutorial/title "Introduction"} :step/id #uuid "5f5183e9-19ad-5c69-807b-510db46d8281" :step/math-academy-id 169632 :step/next {:db/id #edb/ref 17592186111518}} {:db/id #edb/ref 17592186111518 :step/content {:db/id #edb/ref 17592186110612 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110346 :question/id #uuid "34bac64f-5afc-5c30-bb87-15b3df40f8a9" :question/math-academy-id "e-14817"} :knowledge-point/id #uuid "637d4fe0-abb6-5050-a541-f132e78f9b8a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048963}] :knowledge-point/questions [{:db/id #edb/ref 17592186110972} {:db/id #edb/ref 17592186111183}] :knowledge-point/title "Cases When the Perfect Square is Isolated"} :step/id #uuid "6967ba33-4930-52a7-a7b4-7ffe0762be89" :step/math-academy-id 169633 :step/next {:db/id #edb/ref 17592186111519}} {:db/id #edb/ref 17592186111519 :step/content {:db/id #edb/ref 17592186110613 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110348 :question/id #uuid "b9db498b-f1e3-5d52-b23d-106895586815" :question/math-academy-id "e-14820"} :knowledge-point/id #uuid "2aca8019-3239-539c-b7a9-e1a9ca461a61" :knowledge-point/questions [{:db/id #edb/ref 17592186110958} {:db/id #edb/ref 17592186111002}] :knowledge-point/title "Finding an Unknown Parameter"} :step/id #uuid "bedc7efe-42c1-54d6-8c86-490434760721" :step/math-academy-id 169636 :step/next {:db/id #edb/ref 17592186111520}} {:db/id #edb/ref 17592186111520 :step/content {:db/id #edb/ref 17592186110614 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110349 :question/id #uuid "281c39c4-7b52-51aa-aad8-dbd40223b796" :question/math-academy-id "e-14822"} :knowledge-point/id #uuid "f637b472-4c1a-511b-9820-3e07f659eb25" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049026}] :knowledge-point/questions [{:db/id #edb/ref 17592186110973} {:db/id #edb/ref 17592186111395}] :knowledge-point/title "Factoring a Perfect Square"} :step/id #uuid "8ba31f89-a15d-5135-be97-97d5978bcacc" :step/math-academy-id 169639 :step/next {:db/id #edb/ref 17592186111521}} {:db/id #edb/ref 17592186111521 :step/content {:db/id #edb/ref 17592186111920 :tutorial/content "Let's try and solve the equation\n\n$$\n(x+1)^2=-1\n$$\n\nusing the square root method.\n\n$$\n\\begin{aligned}\n(x + 1)^{2} &= -1 \\\\\n\\sqrt{(x + 1)^{2}} &= \\sqrt{-1} \\\\\n\\mid x + 1 \\mid &= \\sqrt{-1}\n\\end{aligned}\n$$\n\nWe have a problem here. We cannot take the square root of a negative number. For that reason, the equation above has *no real solutions*." :tutorial/id #uuid "414b731c-3f76-57ad-985a-3d64bda214e0" :tutorial/math-academy-id 9205 :tutorial/title "Perfect Square Quadratic Equations With No Real Solutions"} :step/id #uuid "e56ff91b-5edd-5f4c-9d04-0fdf7c34e322" :step/math-academy-id 169642 :step/next {:db/id #edb/ref 17592186111522}} {:db/id #edb/ref 17592186111522 :step/content {:db/id #edb/ref 17592186110615 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110350 :question/id #uuid "1e0655ad-122c-5d94-8f8b-9e476eaf4d78" :question/math-academy-id "e-14824"} :knowledge-point/id #uuid "02785337-efe0-54cb-9433-46ff4a9c6302" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050503}] :knowledge-point/questions [{:db/id #edb/ref 17592186110959} {:db/id #edb/ref 17592186110974}] :knowledge-point/title "Equations With No Real Solutions"} :step/id #uuid "c852bd3c-c398-5a0c-9830-c6b1283797c0" :step/math-academy-id 169643}] :activity/title "Perfect Square Quadratic Equations with One or No Solutions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110817}]}
