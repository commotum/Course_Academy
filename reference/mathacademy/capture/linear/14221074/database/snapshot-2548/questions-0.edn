#{[{:db/id #edb/ref 17592186110346 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110612 :knowledge-point/id #uuid "637d4fe0-abb6-5050-a541-f132e78f9b8a" :knowledge-point/title "Cases When the Perfect Square is Isolated"}] :question/id #uuid "34bac64f-5afc-5c30-bb87-15b3df40f8a9" :question/math-academy-id "e-14817" :question/problem "Solve $-2(3k-12)^2 = 0$." :question/worked-solution "We can solve this equation using the square root method:\n\n$$\n\\begin{aligned}\n-2(3k - 12)^{2} &= 0 \\\\\n(3k - 12)^{2} &= 0 \\\\\n\\sqrt{(3k - 12)^{2}} &= \\sqrt{0} \\\\\n\\mid 3k - 12 \\mid &= 0 \\\\\n3k - 12 &= 0 \\\\\n3k &= 12 \\\\\nk &= 4\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186110348 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110613 :knowledge-point/id #uuid "2aca8019-3239-539c-b7a9-e1a9ca461a61" :knowledge-point/title "Finding an Unknown Parameter"}] :question/id #uuid "b9db498b-f1e3-5d52-b23d-106895586815" :question/math-academy-id "e-14820" :question/problem "Which value of $k$ gives precisely one solution to the equation $(x+3)^2+10=k$?" :question/worked-solution "First, we solve for $x$ as follows:\n\n$$\n\\begin{aligned}\n(x + 3)^{2} + 10 &= k \\\\\n(x + 3)^{2} &= k - 10 \\\\\n\\sqrt{(x + 3)^{2}} &= \\sqrt{k - 10} \\\\\n\\mid x + 3 \\mid &= \\sqrt{k - 10}\n\\end{aligned}\n$$\n\nThe equation has only one solution if the right-hand side is equal to zero. So, we solve for the value of $k$ that makes the right-hand side equal to zero:\n\n$$\n\\begin{aligned}\n\\sqrt{k - 10} &= 0 \\\\\nk - 10 &= 0 \\\\\nk &= 10\n\\end{aligned}\n$$\n\nTherefore, $k=10$ will give only one solution to the equation."}] [{:db/id #edb/ref 17592186110349 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110614 :knowledge-point/id #uuid "f637b472-4c1a-511b-9820-3e07f659eb25" :knowledge-point/title "Factoring a Perfect Square"}] :question/id #uuid "281c39c4-7b52-51aa-aad8-dbd40223b796" :question/math-academy-id "e-14822" :question/problem "Given that $g^2 -18g + 81 = 0$, what are the values of $g$?" :question/worked-solution "First, notice that the left-hand side is a perfect square. It just needs to be factored:\n\n$$\n\\begin{aligned}\ng^{2} - 18g + 81 &= 0 \\\\\ng^{2} - 2 \\cdot 9 \\cdot g + 9^{2} &= 0 \\\\\n(g - 9)^{2} &= 0\n\\end{aligned}\n$$\n\nFrom here, we solve the equation using the square root method:\n\n$$\n\\begin{aligned}\n\\sqrt{(g - 9)^{2}} &= \\sqrt{0} \\\\\n\\mid g - 9 \\mid &= 0 \\\\\ng - 9 &= 0 \\\\\ng &= 9\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186110350 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110615 :knowledge-point/id #uuid "02785337-efe0-54cb-9433-46ff4a9c6302" :knowledge-point/title "Equations With No Real Solutions"}] :question/id #uuid "1e0655ad-122c-5d94-8f8b-9e476eaf4d78" :question/math-academy-id "e-14824" :question/problem "Consider the equation $(4x+1)^2 +2=3k$. For which values of $k$ does this equation have no real solutions?" :question/worked-solution "Let's try and solve using the square root method:\n\n$$\n\\begin{aligned}\n(4x + 1)^{2} + 2 &= 3k \\\\\n(4x + 1)^{2} &= 3k - 2 \\\\\n\\sqrt{(4x + 1)^{2}} &= \\sqrt{3k - 2} \\\\\n\\mid 4x + 1 \\mid &= \\sqrt{3k - 2}\n\\end{aligned}\n$$\n\nThe equation will have no real solutions if the expression under the square root is negative, which gives the following condition:\n$3k-2 < 0$\n\nWe solve this inequality for $k$:\n\n$$\n\\begin{bmatrix}3k - 2 & < 0 \\\\ 3k & < 2 \\\\ k & < \\frac{2}{3}\\end{bmatrix}\n$$\n\nTherefore, any value of $k$ that is less than\n\n$$\n\\dfrac 2 3\n$$\n\nwill give an equation with no real solutions."}] [{:db/id #edb/ref 17592186111183 :knowledge-point/_questions [{:db/id #edb/ref 17592186110612 :knowledge-point/id #uuid "637d4fe0-abb6-5050-a541-f132e78f9b8a" :knowledge-point/title "Cases When the Perfect Square is Isolated"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89412836-a681-5578-b3a4-65bb32bf555d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q = ± 2" :db/id #edb/ref 17592186108824} {:answer/id #uuid "9794165b-ef5e-5984-875b-b0c1f0d7dd57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q =-\\frac{1}{2}" :db/id #edb/ref 17592186108825} {:answer/id #uuid "f1769611-133d-52bf-915b-ce9141431689" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q = 2" :db/id #edb/ref 17592186108826} {:answer/id #uuid "53ff716e-3a5f-53b8-aada-da63016943f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q = ± \\frac{1}{2}" :db/id #edb/ref 17592186108827} {:answer/id #uuid "634a5633-69d7-54ee-a77a-e0058e634f51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q = \\frac{1}{2}" :db/id #edb/ref 17592186108828}] :answer-field/id #uuid "7bd233f5-e9c5-585c-aae5-bf5e3fead6e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186108823}] :question/id #uuid "4515a99f-af9e-5afd-8162-572a1dd1a9d7" :question/math-academy-id "q-44355" :question/problem "Solve $(2q + 1)^{2} = 0$."}]}
