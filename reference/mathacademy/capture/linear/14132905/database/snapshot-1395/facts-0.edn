b/ref 17592186142811 #edb/ref 17592186045417] [17592186050610 #edb/ref 1028 #edb/ref 17592186142812 #edb/ref 17592186045417] [17592186050610 #edb/ref 1031 "Multiplying Mixed Numbers" #edb/ref 17592186045417] [17592186050610 #edb/ref 1033 2381 #edb/ref 17592186045417] [17592186050610 #edb/ref 1035 #uuid "589205b6-43f1-59a1-a894-6d8e8438cfcd" #edb/ref 17592186045417] [17592186050634 #edb/ref 1027 #edb/ref 17592186049038 #edb/ref 17592186045417] [17592186050634 #edb/ref 1027 #edb/ref 17592186050115 #edb/ref 17592186045417] [17592186050634 #edb/ref 1028 #edb/ref 17592186142798 #edb/ref 17592186045417] [17592186050634 #edb/ref 1028 #edb/ref 17592186142799 #edb/ref 17592186045417] [17592186050634 #edb/ref 1028 #edb/ref 17592186142800 #edb/ref 17592186045417] [17592186050634 #edb/ref 1031 "Multiplying Mixed Numbers by Whole Numbers" #edb/ref 17592186045417] [17592186050634 #edb/ref 1033 2379 #edb/ref 17592186045417] [17592186050634 #edb/ref 1035 #uuid "5a8cf7ea-858c-5b2b-83e2-c517e9b87bd9" #edb/ref 17592186045417] [17592186050927 #edb/ref 1027 #edb/ref 17592186049357 #edb/ref 17592186045417] [17592186050927 #edb/ref 1027 #edb/ref 17592186050634 #edb/ref 17592186045417] [17592186050927 #edb/ref 1027 #edb/ref 17592186050716 #edb/ref 17592186045417] [17592186050927 #edb/ref 1028 #edb/ref 17592186147404 #edb/ref 17592186045417] [17592186050927 #edb/ref 1028 #edb/ref 17592186147405 #edb/ref 17592186045417] [17592186050927 #edb/ref 1028 #edb/ref 17592186147406 #edb/ref 17592186045417] [17592186050927 #edb/ref 1028 #edb/ref 17592186147407 #edb/ref 17592186045417] [17592186050927 #edb/ref 1031 "Multiplying Fractions by Swapping Denominators" #edb/ref 17592186045417] [17592186050927 #edb/ref 1033 2459 #edb/ref 17592186045417] [17592186050927 #edb/ref 1035 #uuid "7275db81-0f7a-5732-8201-28cd81b685b9" #edb/ref 17592186045417] [17592186142622 #edb/ref 1069 "e-13831" #edb/ref 17592186045417] [17592186142622 #edb/ref 1071 "What is the missing digit in the following equality?\n\n$0$" #edb/ref 17592186045417] [17592186142622 #edb/ref 1072 #uuid "294b83f4-2e38-5bf4-a521-01fe8ca13fe5" #edb/ref 17592186045417] [17592186142622 #edb/ref 1074 "First, we write\n\n$$\n3 \\, \\dfrac{1}{2}\n$$\n\nas an improper fraction:\n\n$$\n3 \\,\\dfrac{1}{2} = \\dfrac{(3 \\times 2) + 1}{2}= \\dfrac{7}{2}\n$$\n\nNow, we can multiply the two numbers. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac{7}{2} \\times \\dfrac{1}{4} = \\dfrac {7 \\times 1}{2 \\times 4} = \\dfrac{\\color{blue}7}{8}\n$$\n\nTherefore, the missing number is ${\\color{blue}{7}}$." #edb/ref 17592186045417] [17592186142624 #edb/ref 1069 "e-13835" #edb/ref 17592186045417] [17592186142624 #edb/ref 1071 "Find the value of $\\dfrac{1}{3} \\times 2 \\, \\dfrac{1}{2}$." #edb/ref 17592186045417] [17592186142624 #edb/ref 1072 #uuid "a688fc95-6831-57c6-9fee-f3295412af05" #edb/ref 17592186045417] [17592186142624 #edb/ref 1074 "First, we write\n\n$$\n2 \\,\\dfrac{1}{2}\n$$\n\nas an improper fraction:\n\n$$\n2 \\,\\dfrac{1}{2} = \\dfrac{(2 \\times 2) + 1}{2} = \\dfrac{5}{2}\n$$\n\nNow, we can multiply the two numbers. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac{1}{3} \\times \\dfrac{5}{2} = \\dfrac{1 \\times 5}{3 \\times 2} = \\dfrac{5}{6}\n$$\n\nTherefore:\n\n$$\n\\dfrac{1}{3} \\times 2 \\, \\dfrac{1}{2} = \\dfrac{5}{6}\n$$" #edb/ref 17592186045417] [17592186142626 #edb/ref 1069 "e-13839" #edb/ref 17592186045417] [17592186142626 #edb/ref 1071 "Determine the missing digit in the following equality.\n\n$0$" #edb/ref 17592186045417] [17592186142626 #edb/ref 1072 #uuid "689fd963-ba93-5b0a-b7e4-0b8fd1dc9101" #edb/ref 17592186045417] [17592186142626 #edb/ref 1074 "First, we write\n\n$$\n3 \\, \\dfrac{2}{3}\n$$\n\nas an improper fraction:\n\n$$\n3 \\,\\dfrac{2}{3} = \\dfrac{(3 \\times 3) + 2}{3}= \\dfrac{11}{3}\n$$\n\nNow, we can multiply the two numbers. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac{11}{3} \\times \\dfrac{2}{5} = \\dfrac{11 \\times 2}{3 \\times 5} = \\dfrac{22}{15}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\dfrac{22}{15} = 1 \\, \\textrm{R} 7 = 1 \\, \\dfrac{\\color{blue}7}{15}\n$$\n\nHence, the missing number is ${\\color{blue}{7}}$." #edb/ref 17592186045417] [17592186142627 #edb/ref 1069 "e-13843" #edb/ref 17592186045417] [17592186142627 #edb/ref 1071 "Multiply $1 \\, \\dfrac{7}{8} \\times \\dfrac{2}{3}$." #edb/ref 17592186045417] [17592186142627 #edb/ref 1072 #uuid "db3701cf-af70-508a-a158-5e38ff68246f" #edb/ref 17592186045417] [17592186142627 #edb/ref 1074 "First, we write\n\n$$\n1 \\,\\dfrac{7}{8}\n$$\n\nas an improper fraction:\n\n$$\n1 \\,\\dfrac{7}{8} = \\dfrac{(1 \\times 8) + 7}{8} = \\dfrac{15}{8}\n$$\n\nNow, we can multiply the two numbers.\n\n$$\n\\frac{15}{8} \\cdot \\frac{2}{3}\n$$\n\nWe can simplify this product by swapping the denominators:\n\n$$\n\\begin{aligned}\n\\frac{15}{8} \\cdot \\frac{2}{3} &= \\frac{15}{3} \\cdot \\frac{2}{8} \\\\\n&= 5 \\cdot \\frac{1}{4} \\\\\n&= \\frac{5}{4}\n\\end{aligned}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\dfrac{5}{4} = 1 \\, \\textrm{R} 1 = 1 \\, \\dfrac{1}{4}\n$$" #edb/ref 17592186045417] [17592186142801 #edb/ref 1037 #edb/ref 17592186050634 #edb/ref 17592186045417] [17592186142801 #edb/ref 1038 #edb/ref 17592186143283 #edb/ref 17592186045417] [17592186142801 #edb/ref 1038 #edb/ref 17592186143303 #edb/ref 17592186045417] [17592186142801 #edb/ref 1039 "Finding a Missing Numerator When the Result Is a Proper Fraction" #edb/ref 17592186045417] [17592186142801 #edb/ref 1041 #edb/ref 17592186142622 #edb/ref 17592186045417] [17592186142801 #edb/ref 1042 #uuid "3ef8389c-2909-5e02-a185-817ae3c6219b" #edb/ref 17592186045417] [17592186142802 #edb/ref 1038 #edb/ref 17592186143222 #edb/ref 17592186045417] [17592186142802 #edb/ref 1038 #edb/ref 17592186143272 #edb/ref 17592186045417] [17592186142802 #edb/ref 1039 "Multiplying a Mixed Number by a Fraction When the Result Is a Proper Fraction" #edb/ref 17592186045417] [17592186142802 #edb/ref 1041 #edb/ref 17592186142624 #edb/ref 17592186045417] [17592186142802 #edb/ref 1042 #uuid "fb8e94ce-081f-5ea4-ac09-de30a890f4af" #edb/ref 17592186045417] [17592186142803 #edb/ref 1038 #edb/ref 17592186143306 #edb/ref 17592186045417] [17592186142803 #edb/ref 1038 #edb/ref 17592186143308 #edb/ref 17592186045417] [17592186142803 #edb/ref 1039 "Finding a Missing Numerator When the Result Is a Mixed Number" #edb/ref 17592186045417] [17592186142803 #edb/ref 1041 #edb/ref 17592186142626 #edb/ref 17592186045417] [17592186142803 #edb/ref 1042 #uuid "15c48f93-e112-5d71-bb8a-c23e022931f8" #edb/ref 17592186045417] [17592186142804 #edb/ref 1037 #edb/ref 17592186050927 #edb/ref 17592186045417] [17592186142804 #edb/ref 1038 #edb/ref 17592186143225 #edb/ref 17592186045417] [17592186142804 #edb/ref 1038 #edb/ref 17592186143226 #edb/ref 17592186045417] [17592186142804 #edb/ref 1039 "Multiplying a Mixed Number by a Fraction When the Result Is a Mixed Number" #edb/ref 17592186045417] [17592186142804 #edb/ref 1041 #edb/ref 17592186142627 #edb/ref 17592186045417] [17592186142804 #edb/ref 1042 #uuid "e9f0bba3-2b88-5e77-9359-b238179c7f3d" #edb/ref 17592186045417] [17592186143015 #edb/ref 1043 #edb/ref 17592186143674 #edb/ref 17592186045417] [17592186143015 #edb/ref 1043 #edb/ref 17592186143675 #edb/ref 17592186045417] [17592186143015 #edb/ref 1043 #edb/ref 17592186143676 #edb/ref 17592186045417] [17592186143015 #edb/ref 1043 #edb/ref 17592186143677 #edb/ref 17592186045417] [17592186143015 #edb/ref 1043 #edb/ref 17592186143678 #edb/ref 17592186045417] [17592186143015 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186143015 #edb/ref 1045 "Multiplying Mixed Numbers by Fractions" #edb/ref 17592186045417] [17592186143015 #edb/ref 1046 #edb/ref 17592186143674 #edb/ref 17592186045417] [17592186143015 #edb/ref 1049 #edb/ref 17592186050115 #edb/ref 17592186045417] [17592186143015 #edb/ref 1053 #uuid "d3c63d19-b2be-5958-b93c-b6adbeba66d1" #edb/ref 17592186045417] [17592186143674 #edb/ref 1058 #edb/ref 17592186143675 #edb/ref 17592186045417] [17592186143674 #edb/ref 1061 135774 #edb/ref 17592186045417] [17592186143674 #edb/ref 1062 #uuid "2170dd51-6df3-55a4-b9b7-00f7896da663" #edb/ref 17592186045417] [17592186143674 #edb/ref 1063 #edb/ref 17592186144085 #edb/ref 17592186045417] [17592186143675 #edb/ref 1058 #edb/ref 17592186143676 #edb/ref 17592186045417] [17592186143675 #edb/ref 1061 135775 #edb/ref 17592186045417] [17592186143675 #edb/ref 1062 #uuid "6765eeb3-8e25-5bf0-ad32-029b86e4f0d1" #edb/ref 17592186045417] [17592186143675 #edb/ref 1063 #edb/ref 17592186142801 #edb/ref 17592186045417] [17592186143676 #edb/ref 1058 #edb/ref 17592186143677 #edb/ref 17592186045417] [17592186143676 #edb/ref 1061 135778 #edb/ref 17592186045417] [17592186143676 #edb/ref 1062 #uuid "8debe9fd-fefe-5403-b7f2-fa3ec7410b9b" #edb/ref 17592186045417] [17592186143676 #edb/ref 1063 #edb/ref 17592186142802 #edb/ref 17592186045417] [17592186143677 #edb/ref 1058 #edb/ref 17592186143678 #edb/ref 17592186045417] [17592186143677 #edb/ref 1061 135782 #edb/ref 17592186045417] [17592186143677 #edb/ref 1062 #uuid "96b52e80-a2f7-5d0f-93d4-8021be7afcd5" #edb/ref 17592186045417] [17592186143677 #edb/ref 1063 #edb/ref 17592186142803 #edb/ref 17592186045417] [17592186143678 #edb/ref 1061 135785 #edb/ref 17592186045417] [17592186143678 #edb/ref 1062 #uuid "1db31040-e8c9-5f1e-a326-fb541cc1aa8c" #edb/ref 17592186045417] [17592186143678 #edb/ref 1063 #edb/ref 17592186142804 #edb/ref 17592186045417] [17592186144085 #edb/ref 1064 "Suppose we want to multiply a fraction by a mixed number. For example,\n\n$$\n1 \\,\\dfrac{1}{3} \\times \\dfrac{4}{7}\n$$\n\nTo solve this problem, we can use the following three steps:\n\n**Step 1:** Convert the mixed number to an improper fraction:\n\n$$\n1 \\,\\dfrac{1}{3}=\\dfrac{(1 \\times 3) + 1}{3}= \\dfrac{4}{3}\n$$\n\n**Step 2:** Multiply the fractions by multiplying the numerators and denominators separately:\n\n$$\n\\dfrac{4}{3} \\times \\dfrac{4}{7} = \\dfrac{4 \\times 4}{3 \\times 7} = \\dfrac{16}{21}\n$$\n\n**Step 3:** Simplify or convert back to a mixed number, if necessary. In this case, no simplification is needed because the fraction\n\n$$\n\\dfrac{16}{21}\n$$\n\nis a proper fraction.\n\nSo, the answer is\n\n$$\n1 \\,\\dfrac{1}{3} \\times \\dfrac{4}{7} = \\dfrac{16}{21}\n$$" #edb/ref 17592186045417] [17592186144085 #edb/ref 1065 8630 #edb/ref 17592186045417] [17592186144085 #edb/ref 1066 #uuid "738a78c1-dc39-5272-835f-a143e50534e8" #edb/ref 17592186045417] [17592186144085 #edb/ref 1067 "Introduction" #edb/ref 17592186045417]}
