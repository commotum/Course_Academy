n/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ee8781b3-3ca8-513b-addc-10832dab8031"] :db/ensure [:question/validate]} {:db/id "answer-field-ee8781b3-3ca8-513b-addc-10832dab8031" :answer-field/id #uuid "ee8781b3-3ca8-513b-addc-10832dab8031" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b1091f66-8c7f-5710-887f-be8b73d33fae" :answer-field/choices ["answer-16d4e9b0-39b3-55e8-b47a-71884490d405" "answer-b1091f66-8c7f-5710-887f-be8b73d33fae" "answer-4c6a0d89-b9cb-5f6e-ad12-15a7b1db6742" "answer-dfa68a3e-551a-5816-97be-c41b5b80675c" "answer-7aba5264-6dc2-537f-a92d-1f42d60a96be"] :db/ensure [:answer-field/validate]} {:db/id "answer-16d4e9b0-39b3-55e8-b47a-71884490d405" :answer/id #uuid "16d4e9b0-39b3-55e8-b47a-71884490d405" :answer/type :answer.type/math :answer/value "1\\,\\frac{3}{7}" :db/ensure [:answer/validate]} {:db/id "answer-b1091f66-8c7f-5710-887f-be8b73d33fae" :answer/id #uuid "b1091f66-8c7f-5710-887f-be8b73d33fae" :answer/type :answer.type/math :answer/value "1\\,\\frac{5}{7}" :db/ensure [:answer/validate]} {:db/id "answer-4c6a0d89-b9cb-5f6e-ad12-15a7b1db6742" :answer/id #uuid "4c6a0d89-b9cb-5f6e-ad12-15a7b1db6742" :answer/type :answer.type/math :answer/value "2\\,\\frac{1}{7}" :db/ensure [:answer/validate]} {:db/id "answer-dfa68a3e-551a-5816-97be-c41b5b80675c" :answer/id #uuid "dfa68a3e-551a-5816-97be-c41b5b80675c" :answer/type :answer.type/math :answer/value "\\frac{2}{7}" :db/ensure [:answer/validate]} {:db/id "answer-7aba5264-6dc2-537f-a92d-1f42d60a96be" :answer/id #uuid "7aba5264-6dc2-537f-a92d-1f42d60a96be" :answer/type :answer.type/math :answer/value "\\frac{5}{7}" :db/ensure [:answer/validate]} {:db/id "question-5fb302d8-e54d-5bd0-98ff-6702cdefa4b0" :question/id #uuid "5fb302d8-e54d-5bd0-98ff-6702cdefa4b0" :question/math-academy-id "q-137104" :question/problem "$1\\,\\frac{3}{5}\\times \\frac{2}{3}=$" :question/worked-solution "First, we write $1\\,\\frac{3}{5}$ as an improper fraction:\n\n$$\n1\\,\\frac{3}{5}=\\frac{(1\\times 5)+3}{5}=\\frac{8}{5}\n$$\n\nNow, we can multiply the two numbers. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{8}{5}\\times \\frac{2}{3}=\\frac{8\\times 2}{5\\times 3}=\\frac{16}{15}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{16}{15}=1\\,\\text{R}1=1\\,\\frac{1}{15}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d60a1599-e1a9-5aaf-88bf-566e598dbe64"] :db/ensure [:question/validate]} {:db/id "answer-field-d60a1599-e1a9-5aaf-88bf-566e598dbe64" :answer-field/id #uuid "d60a1599-e1a9-5aaf-88bf-566e598dbe64" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1f260b7a-6064-527f-85e6-fcba901c621c" :answer-field/choices ["answer-1f260b7a-6064-527f-85e6-fcba901c621c" "answer-68ae60d3-8457-5131-9926-083a63502892" "answer-40e485e8-42ce-549d-b184-39b83341c80f" "answer-992bb123-cc88-514a-9006-62f7c171d850" "answer-e191e9e1-195d-5bb4-a6c7-9a7627f647a6"] :db/ensure [:answer-field/validate]} {:db/id "answer-1f260b7a-6064-527f-85e6-fcba901c621c" :answer/id #uuid "1f260b7a-6064-527f-85e6-fcba901c621c" :answer/type :answer.type/math :answer/value "1\\,\\frac{1}{15}" :db/ensure [:answer/validate]} {:db/id "answer-68ae60d3-8457-5131-9926-083a63502892" :answer/id #uuid "68ae60d3-8457-5131-9926-083a63502892" :answer/type :answer.type/math :answer/value "1\\,\\frac{4}{15}" :db/ensure [:answer/validate]} {:db/id "answer-40e485e8-42ce-549d-b184-39b83341c80f" :answer/id #uuid "40e485e8-42ce-549d-b184-39b83341c80f" :answer/type :answer.type/math :answer/value "2\\,\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-992bb123-cc88-514a-9006-62f7c171d850" :answer/id #uuid "992bb123-cc88-514a-9006-62f7c171d850" :answer/type :answer.type/math :answer/value "\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "answer-e191e9e1-195d-5bb4-a6c7-9a7627f647a6" :answer/id #uuid "e191e9e1-195d-5bb4-a6c7-9a7627f647a6" :answer/type :answer.type/math :answer/value "\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id 17592186144085 :tutorial/content "Suppose we want to multiply a fraction by a mixed number. For example,\n\n$$\n1 \\,\\dfrac{1}{3} \\times \\dfrac{4}{7}.\n$$\n\nTo solve this problem, we can use the following three steps:\n\n**Step 1:** Convert the mixed number to an improper fraction:\n\n$$\n1 \\,\\dfrac{1}{3}=\\dfrac{(1 \\times 3) + 1}{3}= \\dfrac{4}{3}\n$$\n\n**Step 2:** Multiply the fractions by multiplying the numerators and denominators separately:\n\n$$\n\\dfrac{4}{3} \\times \\dfrac{4}{7} =  \\dfrac{4 \\times 4}{3 \\times 7} = \\dfrac{16}{21}\n$$\n\n**Step 3:** Simplify or convert back to a mixed number, if necessary. In this case, no simplification is needed because the fraction $\\dfrac{16}{21}$ is a proper fraction.\n\nSo, the answer is \n\n$$\n1 \\,\\dfrac{1}{3} \\times \\dfrac{4}{7} = \\dfrac{16}{21}.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186143015 :activity/expected-seconds 480.0 :db/ensure [:activity/validate]}]
