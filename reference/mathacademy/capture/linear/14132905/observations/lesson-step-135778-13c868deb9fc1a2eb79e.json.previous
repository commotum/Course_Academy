AIN-28\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-32\" x=\"389\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-D7\" x=\"1112\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-32\" x=\"2112\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-29\" x=\"2613\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-2B\" x=\"3225\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-31\" x=\"4225\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E2-MJMAIN-32\" x=\"2172\" y=\"-687\"></use>\n</g>\n</g>\n <use xlink:href=\"#E2-MJMAIN-3D\" x=\"8225\" y=\"0\"></use>\n<g transform=\"translate(9282,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"620\" height=\"60\" x=\"0\" y=\"220\"></rect>\n <use xlink:href=\"#E2-MJMAIN-35\" x=\"60\" y=\"676\"></use>\n <use xlink:href=\"#E2-MJMAIN-32\" x=\"60\" y=\"-687\"></use>\n</g>\n</g>\n</g>\n</svg></span></p>\n<p>Now, we can multiply the two numbers. We multiply the numerators, and we multiply the denominators:</p>\n<p><span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"21.035ex\" height=\"5.176ex\" style=\"vertical-align: -1.838ex;\" viewBox=\"0 -1437.2 9056.5 2228.5\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-3-Title\">\n<title id=\"MathJax-SVG-3-Title\">\n\\dfrac{1}{3} \\times \\dfrac{5}{2} =  \\dfrac{1 \\times 5}{3 \\times 2} = \\dfrac{5}{6}\n</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E3-MJMAIN-31\" d=\"M213 578L200 573Q186 568 160 563T102 556H83V602H102Q149 604 189 617T245 641T273 663Q275 666 285 666Q294 666 302 660V361L303 61Q310 54 315 52T339 48T401 46H427V0H416Q395 3 257 3Q121 3 100 0H88V46H114Q136 46 152 46T177 47T193 50T201 52T207 57T213 61V578Z\"></path>\n<path stroke-width=\"1\" id=\"E3-MJMAIN-33\" d=\"M127 463Q100 463 85 480T69 524Q69 579 117 622T233 665Q268 665 277 664Q351 652 390 611T430 522Q430 470 396 421T302 350L299 348Q299 347 308 345T337 336T375 315Q457 262 457 175Q457 96 395 37T238 