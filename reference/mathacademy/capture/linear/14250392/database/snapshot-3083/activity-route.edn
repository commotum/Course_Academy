#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186570798} :activity/id #uuid "ee5d6eb8-d66a-5590-9825-8b9d8e7d7856" :activity/scope {:db/id #edb/ref 17592186049153 :topic/id #uuid "dee5d85f-d1a2-5a07-8454-81879602e674" :topic/math-academy-id 441} :activity/steps [{:db/id #edb/ref 17592186570798 :step/content {:db/id #edb/ref 17592186570781 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "101ee2de-8b73-5ce0-ac17-7ff2a131872d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(n+2)(9{n}^{2}+6n+4)" :db/id #edb/ref 17592186570152} {:answer/id #uuid "103226af-902e-5a7b-8fa5-0f61ab93b621" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3(3n+2)(9{n}^{2}-6n+4)" :db/id #edb/ref 17592186570153} {:answer/id #uuid "ae8d767d-1181-5a31-be8e-9897b6f24b62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3n+1)(3{n}^{2}-6n+4)" :db/id #edb/ref 17592186570440} {:answer/id #uuid "d2879924-8f25-5ed6-a051-33e68b0dec4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3(3n+2)(3{n}^{2}-6n+8)" :db/id #edb/ref 17592186570493} {:answer/id #uuid "de0604d8-af59-5a9b-9c7f-e0f299b8a32b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3(3n-1)(9{n}^{2}+6n+8)" :db/id #edb/ref 17592186570514}] :answer-field/correct {:db/id #edb/ref 17592186570153} :answer-field/id #uuid "d4e7a715-54af-5638-b9d3-7f1eeed3070d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186570679}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e66f06d6-a158-572d-9c8e-dbcf45eb29af" :question/math-academy-id "q-3531" :question/problem "Factor $81{n}^{3}+24.$" :question/worked-solution "The sum of cubes formula is given by\n\n$$\n{a}^{3}+{b}^{3}=(a+b)({a}^{2}-ab+{b}^{2}).\n$$\n\nNotice that all of the terms have a common factor of $3.$ To simplify the computation, we can factor out the $3,$ as follows:\n\n$$\n81{n}^{3}+24=3(27{n}^{3}+8)\n$$\n\nThe expression in parentheses can be written as a sum of cubes:\n\n$$\n3(27{n}^{3}+8)=3((3n)^{3}+{2}^{3})\n$$\n\nNow, we factor the expression in parentheses using the sum of cubes formula:\n\n$$\n\\begin{aligned}81{n}^{3}+24 & =3((3n)^{3}+{2}^{3}) \\\\  & =3(3n+2)((3n)^{2}-3n\\cdot 2+{2}^{2}) \\\\  & =3(3n+2)(9{n}^{2}-6n+4)\\end{aligned}\n$$"} :step/id #uuid "1681c3be-f584-53ab-9baf-8640d11826db" :step/next {:db/id #edb/ref 17592186570870}} {:db/id #edb/ref 17592186570824 :step/content {:db/id #edb/ref 17592186069489 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ade7268a-6371-596d-aed8-1afa2a8e3e81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2 - \\frac{1}{x})(4 + \\frac{4}{x} + \\frac{1}{x^{2}})" :db/id #edb/ref 17592186068105} {:answer/id #uuid "ece5f707-ffcb-5f20-9a82-ace67aed7982" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2 - \\frac{1}{x})(2 + \\frac{2}{x} + \\frac{1}{x^{2}})" :db/id #edb/ref 17592186068106} {:answer/id #uuid "101737a1-7c23-5141-85ea-8af741abd438" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2 + \\frac{1}{x})(4 + \\frac{2}{x} + \\frac{1}{x^{2}})" :db/id #edb/ref 17592186068107} {:answer/id #uuid "3a52bcaa-7e9a-5fe9-9ee7-2cd86c40572c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2 + \\frac{1}{x})(4 - \\frac{2}{x} + \\frac{1}{x^{2}})" :db/id #edb/ref 17592186068108} {:answer/id #uuid "5601c935-81c3-59c0-b2dc-4d26b61710a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2 + \\frac{1}{x})(2 - \\frac{4}{x} + \\frac{1}{x^{2}})" :db/id #edb/ref 17592186068109}] :answer-field/id #uuid "fa41cc09-9952-58ac-a534-3ed0844163bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186068104}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "775e4db0-4a5e-5392-a88a-fce40375dc68" :question/math-academy-id "q-69318" :question/problem "Factor $8 + \\frac{1}{x^{3}}$."} :step/id #uuid "5c71d979-937c-5284-9ba4-eb3ff5c9c52a"} {:db/id #edb/ref 17592186570870 :step/content {:db/id #edb/ref 17592186570788 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21ff553e-31bf-5462-bc96-18edbe3a3704" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{x}{2}-\\frac{{z}^{2}}{5})(\\frac{{x}^{2}}{4}+\\frac{x{z}^{2}}{10}+\\frac{{z}^{4}}{25})" :db/id #edb/ref 17592186570186} {:answer/id #uuid "2c70c2c2-3b0e-51d8-9462-0a96a3819823" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{x}{6}-\\frac{{z}^{2}}{5})(\\frac{{x}^{2}}{6}+\\frac{x{z}^{2}}{5}+\\frac{{z}^{4}}{5})" :db/id #edb/ref 17592186570199} {:answer/id #uuid "8a828d43-3631-5741-b430-d22059e6ceab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{x}{4}-\\frac{{z}^{2}}{10})(\\frac{{x}^{2}}{2}+\\frac{x{z}^{2}}{5}+\\frac{{z}^{4}}{25})" :db/id #edb/ref 17592186570369} {:answer/id #uuid "d71f1d20-7755-56b8-8c54-b7d4b6442d20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{x}{2}-\\frac{{z}^{2}}{5})(\\frac{{x}^{2}}{2}+\\frac{xz}{5}+\\frac{{z}^{4}}{25})" :db/id #edb/ref 17592186570500} {:answer/id #uuid "f5c141ba-a2f5-57ec-aefe-7eba43f333e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{x}{2}+\\frac{{z}^{2}}{5})(\\frac{{x}^{2}}{4}-\\frac{x{z}^{2}}{10}+\\frac{{z}^{4}}{5})" :db/id #edb/ref 17592186570559}] :answer-field/correct {:db/id #edb/ref 17592186570186} :answer-field/id #uuid "3778dcd4-e5bf-5ca6-87ec-1602ea82538b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186570599}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f995ab76-e781-54a1-b26b-a28e8f4d92d3" :question/math-academy-id "q-37670" :question/problem "Factor the expression $\\frac{{x}^{3}}{8}-\\frac{{z}^{6}}{125}.$" :question/worked-solution "The difference of cubes formula is given by\n\n$$\n{a}^{3}-{b}^{3}=(a-b)({a}^{2}+ab+{b}^{2}).\n$$\n\nNotice that we can write our expression as a difference of cubes:\n\n$$\n\\frac{{x}^{3}}{8}-\\frac{{z}^{6}}{125}={(\\frac{x}{2})}^{3}-{(\\frac{{z}^{2}}{5})}^{3}\n$$\n\nNow, we factor the given expression using the difference of cubes formula:\n\n$$\n\\begin{aligned}\\frac{{x}^{3}}{8}-\\frac{{z}^{6}}{125} & ={(\\frac{x}{2})}^{3}-{(\\frac{{z}^{2}}{5})}^{3} \\\\  & =(\\frac{x}{2}-\\frac{{z}^{2}}{5})({(\\frac{x}{2})}^{2}+\\frac{x}{2}\\cdot \\frac{{z}^{2}}{5}+{(\\frac{{z}^{2}}{5})}^{2}) \\\\  & =(\\frac{x}{2}-\\frac{{z}^{2}}{5})(\\frac{{x}^{2}}{4}+\\frac{x{z}^{2}}{10}+\\frac{{z}^{4}}{25})\\end{aligned}\n$$"} :step/id #uuid "ede8d175-b28e-5b90-908a-805ba56be976" :step/next {:db/id #edb/ref 17592186570824}}] :activity/title "Factoring Sums and Differences of Cubes" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186570117}]}
