#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186538040} :activity/id #uuid "12402d81-17be-551a-9fc6-ae90a859480b" :activity/scope {:db/id #edb/ref 17592186050218 :topic/id #uuid "370d229e-4b9a-5ee8-b857-c25ac383bf2c" :topic/math-academy-id 32} :activity/steps [{:db/id #edb/ref 17592186538012 :step/content {:db/id #edb/ref 17592186537981 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1067a6a6-ea44-54fb-9b49-340362e71e94" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\text{i}" :db/id #edb/ref 17592186537257} {:answer/id #uuid "45daa364-6e41-502c-beff-1da50c08730e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{i}" :db/id #edb/ref 17592186537371} {:answer/id #uuid "8bdda742-6458-58a9-9f84-0b3357e2d275" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\text{i}" :db/id #edb/ref 17592186537495} {:answer/id #uuid "e2479278-1d95-5cf6-8422-f5acf953ba01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186537685} {:answer/id #uuid "e7448cff-8a46-50af-94f3-a8fa8bd54690" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\text{i}}{2}" :db/id #edb/ref 17592186537698}] :answer-field/correct {:db/id #edb/ref 17592186537257} :answer-field/id #uuid "1f1babbe-939f-5426-872c-f51afac57e5d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537769}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e87479bf-28b6-5cab-9b25-26c4f45c1fed" :question/math-academy-id "q-86688" :question/problem "${\\text{i}}^{-1}=$" :question/worked-solution "First, using the laws of exponents, we can write\n\n$$\n{\\text{i}}^{-1}=\\frac{1}{\\text{i}}.\n$$\n\nMultiplying the numerator and denominator by $\\text{i},$ we get\n\n$$\n\\begin{aligned}\\frac{1}{\\text{i}}=\\frac{1}{\\text{i}}\\cdot \\frac{\\text{i}}{\\text{i}}=\\frac{\\text{i}}{{\\text{i}}^{2}}.\\end{aligned}\n$$\n\nWe now recall that ${\\text{i}}^{2}=-1.$ Therefore,\n\n$$\n\\frac{\\text{i}}{{\\text{i}}^{2}}=\\frac{\\text{i}}{(-1)}=-\\text{i}.\n$$"} :step/id #uuid "4298d0e8-1022-557f-ac4a-1cae4225f16c"} {:db/id #edb/ref 17592186538016 :step/content {:db/id #edb/ref 17592186537917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30ea2c74-92f8-5dfc-906d-187ed5899c78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5i" :db/id #edb/ref 17592186537333} {:answer/id #uuid "5e4cfbae-11f6-549a-9180-a3ba9c7d51e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5i" :db/id #edb/ref 17592186537417} {:answer/id #uuid "8d35d5d7-52fb-5e34-a0c3-d5050f550764" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186537498} {:answer/id #uuid "e8bb9244-35b1-5fe4-ad95-b131580d21c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186537699} {:answer/id #uuid "ffd35650-8e87-55f4-ab1d-4ed4eb0f56bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186537756}] :answer-field/correct {:db/id #edb/ref 17592186537699} :answer-field/id #uuid "3bbba762-ecb5-5041-b8ef-4594788c4dee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537779}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5ff8f495-e68c-55fd-b502-1aeaa9ec649a" :question/math-academy-id "q-86685" :question/problem "$5{\\text{i}}^{-2}=$" :question/worked-solution "First, using the laws of exponents, we can write\n\n$$\n5{\\text{i}}^{-2}=\\frac{5}{{\\text{i}}^{2}}.\n$$\n\nWe now recall that ${\\text{i}}^{2}=-1.$ Therefore,\n\n$$\n\\frac{5}{{\\text{i}}^{2}}=\\frac{5}{(-1)}=-5.\n$$"} :step/id #uuid "48bed219-70d8-5c51-8f1e-24f1d3b0be35" :step/next {:db/id #edb/ref 17592186538012}} {:db/id #edb/ref 17592186538026 :step/content {:db/id #edb/ref 17592186055514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d74b34ef-2af6-57a2-983e-a19539375c4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186054322} {:answer/id #uuid "f6cde42d-1768-5616-a268-9908e491dd22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186054324} {:answer/id #uuid "67338fae-1547-5fe7-9d70-7691b5fd4add" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186054326} {:answer/id #uuid "8d3a08f6-fd2f-5782-bbee-624c75d48b43" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\text{i}" :db/id #edb/ref 17592186537499} {:answer/id #uuid "ed2b8611-d8d8-563c-b94b-aac6969ac4ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{i}" :db/id #edb/ref 17592186537714}] :answer-field/correct {:db/id #edb/ref 17592186054326} :answer-field/id #uuid "fa5df6b3-941f-5a1a-8b50-53a754a0bf99" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186054321}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7913907d-f5d7-5002-a444-4a7882688b2e" :question/math-academy-id "q-925" :question/problem "Simplify ${\\text{i}}^{50}.$" :question/worked-solution "To find the value of $\\text{i}$ raised to some positive integer power $n$, we divide $n$ by $4,$ and raise $\\text{i}$ to the remainder.\n\nIn our case, we have $n=50.$ Dividing the power by $4,$ we get:\n\n$$\n50÷4=12\\,\\text{R}2\n$$\n\nSo the remainder is $2.$ Therefore,\n\n$$\n{\\text{i}}^{50}={\\text{i}}^{2}=-1.\n$$"} :step/id #uuid "6a8db41c-81fc-5dff-9303-73c67d1ad74a" :step/next {:db/id #edb/ref 17592186538016}} {:db/id #edb/ref 17592186538040 :step/content {:db/id #edb/ref 17592186537910 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d58e1d6-9058-5654-9cd8-bc85995ee0c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186537290} {:answer/id #uuid "2bd305dc-bb6b-580b-a493-cecb52d1bacb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186537319} {:answer/id #uuid "4ca0ff4d-6e49-5ce7-97f7-0e3c7cc15bd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4\\text{i}" :db/id #edb/ref 17592186537388} {:answer/id #uuid "72a1e6f9-aafc-5e7c-830f-ed757a2ba64b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\text{i}" :db/id #edb/ref 17592186537454} {:answer/id #uuid "7472f77b-aba3-5528-b3ab-22b816acbcc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{i}" :db/id #edb/ref 17592186537458}] :answer-field/correct {:db/id #edb/ref 17592186537319} :answer-field/id #uuid "d69cb58a-9fb7-5a73-a64e-7aa17b27dd9d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537862}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4c9f6489-bb99-5069-afdd-6f597a73df64" :question/math-academy-id "q-551" :question/problem "${\\text{i}}^{24}=$" :question/worked-solution "To find the value of $\\text{i}$ raised to some positive integer power $n$, we divide $n$ by $4,$ and raise $\\text{i}$ to the remainder.\n\nIn our case, we have $n=24.$ Dividing the power by $4,$ we get\n\n$$\n24÷4=6\\,\\text{R}0.\n$$\n\nSo the remainder is $0.$ Therefore,\n\n$$\n{\\text{i}}^{24}={\\text{i}}^{0}=1.\n$$"} :step/id #uuid "a11a61d3-0935-5485-ba4d-8fd670986c6a" :step/next {:db/id #edb/ref 17592186538058}} {:db/id #edb/ref 17592186538058 :step/content {:db/id #edb/ref 17592186537961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d587220c-e013-541b-9d54-8b67285f5388" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186537650} {:answer/id #uuid "dd35346f-a1c5-5550-a5a6-81e168550ef2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\text{i}" :db/id #edb/ref 17592186537674} {:answer/id #uuid "ea41f662-9d78-5477-9638-0d4a0210d5c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{i}" :db/id #edb/ref 17592186537707} {:answer/id #uuid "efee7e06-9ddd-5cc2-a91d-904b6a75f560" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186537723} {:answer/id #uuid "fb570050-11b4-518d-a996-dd6fca923e36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186537748}] :answer-field/correct {:db/id #edb/ref 17592186537674} :answer-field/id #uuid "b6fc5d96-a387-5e91-ac87-cf9885c4df7d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537845}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b7f8ea24-bf7b-5ebd-ac96-307434b99a43" :question/math-academy-id "q-569" :question/problem "If $a={\\text{i}}^{2}$ and $b={\\text{i}}^{9}$, then $ab=$" :question/worked-solution "Using the addition law for exponents, we have\n\n$$\nab={\\text{i}}^{2}\\cdot {\\text{i}}^{9}={\\text{i}}^{2+9}={\\text{i}}^{11}.\n$$\n\nTo find the value of $\\text{i}$ raised to some positive integer power $n$, we divide $n$ by $4,$ and raise $\\text{i}$ to the remainder.\n\nIn our case, we have $n=11.$ Dividing the power by $4,$ we get\n\n$$\n11÷4=2\\,\\text{R}3.\n$$\n\nSo the remainder is $3.$ Therefore,\n\n$$\n{\\text{i}}^{11}={\\text{i}}^{3}=-\\text{i}.\n$$"} :step/id #uuid "cff7f8bd-a3b5-5283-8c95-6bf1c853c6be" :step/next {:db/id #edb/ref 17592186538026}}] :activity/title "The Cyclic Property of the Imaginary Unit" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186537206}]}
