  "live_records": {
    "q-1277": {
      "dom_id": "step-q1277",
      "name": "Question 1",
      "problem": "If $B={-2,-1,0,1,2}$, which collection of subsets of $B$ is a partition of $B?$",
      "worked_solution": "A partition of a set $B$ is a collection of non-empty subsets of $B$ where every element of $B$ is contained in *exactly* one subset. \n\nOf the given collections, only ${{-2,0},{-1,1},{2}}$ is a partition.\n\nThe rest of the collections are not partitions:\n\n- ${{-2,-1},{-1,1},{0}}$ is not a partition because the element $-1$ appears in two subsets.\n\n- ${{-2,-1},{-1,0},{1,2}}$ is not a partition because the element $-1$ appears in two subsets.\n\n- ${{-2,-1,0},{-2,2},{-2,1},{-1,0}}$ is not a partition because the elements $-2,$ $-1$ and $0$ appear in multiple subsets.\n\n- ${∅,{-2,-1},{0,1,2}}$  is not a partition because the subset $∅$ is empty.",
      "calculator_instructions": "",
