[{:db/id 17592186059812 :knowledge-point/questions ["question-9baec781-6727-5070-ba93-d0e0e2886415" "question-ec641cad-eaa5-5110-9da2-21a5ecc5614d" "question-84e33efb-d3f8-5005-acd9-dce160c0ccce"] :db/ensure [:knowledge-point/validate]} {:db/id "question-9baec781-6727-5070-ba93-d0e0e2886415" :question/id #uuid "9baec781-6727-5070-ba93-d0e0e2886415" :question/math-academy-id "q-1277" :question/problem "If $B={-2,-1,0,1,2}$, which collection of subsets of $B$ is a partition of $B?$" :question/worked-solution "A partition of a set $B$ is a collection of non-empty subsets of $B$ where every element of $B$ is contained in *exactly* one subset. \n\nOf the given collections, only ${{-2,0},{-1,1},{2}}$ is a partition.\n\nThe rest of the collections are not partitions:\n\n- ${{-2,-1},{-1,1},{0}}$ is not a partition because the element $-1$ appears in two subsets.\n\n- ${{-2,-1},{-1,0},{1,2}}$ is not a partition because the element $-1$ appears in two subsets.\n\n- ${{-2,-1,0},{-2,2},{-2,1},{-1,0}}$ is not a partition because the elements $-2,$ $-1$ and $0$ appear in multiple subsets.\n\n- ${∅,{-2,-1},{0,1,2}}$  is not a partition because the subset $∅$ is empty." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e9ddadac-650e-54de-9a1d-e42d954b6e57"] :db/ensure [:question/validate]} {:db/id "answer-field-e9ddadac-650e-54de-9a1d-e42d954b6e57" :answer-field/id #uuid "e9ddadac-650e-54de-9a1d-e42d954b6e57" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-692bfd99-d05c-559d-b873-925a9be25d93" :answer-field/choices ["answer-891ed362-4b2b-5b8a-b28f-b5292b27fb71" "answer-a783e766-8c5b-5363-aa72-526349328a1d" "answer-92b07388-d73e-5201-93a0-b4b29a60ff43" "answer-692bfd99-d05c-559d-b873-925a9be25d93" "answer-e665a5e7-42b8-5e73-a201-a5c0c8d557f5"] :db/ensure [:answer-field/validate]} {:db/id "answer-891ed362-4b2b-5b8a-b28f-b5292b27fb71" :answer/id #uuid "891ed362-4b2b-5b8a-b28f-b5292b27fb71" :ans