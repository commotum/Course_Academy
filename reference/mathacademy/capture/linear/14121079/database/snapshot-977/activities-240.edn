#{[{:activity/first-step {:db/id #edb/ref 17592186060748} :activity/id #uuid "a395b4a3-cd2d-5496-be63-828e164fb8a3" :activity/scope {:db/id #edb/ref 17592186049842 :topic/id #uuid "18160fcf-bc16-5973-b12d-9d8b5753934f" :topic/math-academy-id 240} :activity/steps [{:db/id #edb/ref 17592186060748 :step/content {:db/id #edb/ref 17592186060958 :tutorial/content "A **partition** of a set $A$ is a collection of non-empty subsets of $A$ where every element of $A$ is contained in *exactly* one subset.\n\nIn other words, none of the subsets can be the null set $(\\emptyset),$ and every element of $A$ must be contained in one *and only one* subset.\n\nFor example, the following collections of subsets of $X=\\{1, 2, 3, 4, 5\\}$ are all partitions:\n\n- $X_1 = \\{ \\{ 1, 2\\}, \\{ 3, 4 \\}, \\{5\\} \\}$\n- $X_2 = \\{ \\{ 1, 2, 3\\}, \\{4, 5\\} \\}$\n- $X_3 = \\{ \\{ 1, 3\\}, \\{ 2\\}, \\{4, 5\\} \\}$\n- $X_4 = \\{ \\{ 1, 4, 5\\}, \\{ 2, 3\\} \\}$\n- $X_5 = \\{ \\{ 1, 2, 3, 4\\}, \\{5\\} \\}$\n\nHowever, the following collections are *not* partitions:\n\n- $X_6 = \\{ \\{ 1\\}, \\{ 3, 4 \\}, \\{5\\} \\}$ - the number $2$ is not included in any subset\n- $X_7 = \\{ \\emptyset, \\{ 1, 2, 3\\}, \\{4, 5\\} \\}$ - includes $\\emptyset$\n- $X_8 = \\{ \\{ 1, 3\\}, \\{ 2, 3\\}, \\{4, 5\\} \\}$ - the number $3$ is included in two different subsets\n- $X_9 = \\{ \\{ 1, 2 \\}, \\{ 2, 3\\} \\}$ - missing $4$ and $5,$ and $2$ is included in two different subsets\n- $X_{10} = \\{ 1, 2, 3, 4, 5 \\}$ - this not a collection of subsets" :tutorial/id #uuid "7c175282-8683-5a55-a872-02bbd19be4f5" :tutorial/math-academy-id 4252 :tutorial/title "Introduction"} :step/id #uuid "f50a4e80-5c54-5d58-ab17-5ed548aaeb19" :step/math-academy-id 25815 :step/next {:db/id #edb/ref 17592186060750}} {:db/id #edb/ref 17592186060749 :step/content {:db/id #edb/ref 17592186059812 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059615 :question/id #uuid "6e647031-a93a-54b7-8b39-c6d3779a48ab" :question/math-academy-id "e-7008"} :knowledge-point/id #uuid "1b082a95-4d6e-512f-a6ed-9100498d17c8" :knowledge-point/questions [{:db/id #edb/ref 17592186060016} {:db/id #edb/ref 17592186060017} {:db/id #edb/ref 17592186371513} {:db/id #edb/ref 17592186378292} {:db/id #edb/ref 17592186378538} {:db/id #edb/ref 17592186395735} {:db/id #edb/ref 17592186397808} {:db/id #edb/ref 17592186397815}] :knowledge-point/title "Identifying Partitions"} :step/id #uuid "6858b45d-f4c4-5f63-aed8-bbb4bb3ce478" :step/math-academy-id 25821 :step/next {:db/id #edb/ref 17592186060751}} {:db/id #edb/ref 17592186060750 :step/content {:db/id #edb/ref 17592186059813 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059616 :question/id #uuid "fcf768ea-80dc-5238-9694-883204f8f1f8" :question/math-academy-id "e-7009"} :knowledge-point/id #uuid "8c1d9899-21e8-5ab1-9bc5-10e4a8100ed9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050923}] :knowledge-point/questions [{:db/id #edb/ref 17592186060404} {:db/id #edb/ref 17592186060405} {:db/id #edb/ref 17592186371506} {:db/id #edb/ref 17592186378285} {:db/id #edb/ref 17592186380104} {:db/id #edb/ref 17592186380111} {:db/id #edb/ref 17592186386161} {:db/id #edb/ref 17592186386168} {:db/id #edb/ref 17592186394126}] :knowledge-point/title "Identifying the Missing Set to Form a Partition"} :step/id #uuid "23b02b10-a468-528d-9a2e-4a1fa212b764" :step/math-academy-id 25822 :step/next {:db/id #edb/ref 17592186060749}} {:db/id #edb/ref 17592186060751 :step/content {:db/id #edb/ref 17592186059814 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059617 :question/id #uuid "e0696e3c-de10-5b18-ba67-1d381ddbe0be" :question/math-academy-id "e-7010"} :knowledge-point/id #uuid "2b2a9a1d-2d20-58cf-a1ee-bee2f4cf120d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049065}] :knowledge-point/questions [{:db/id #edb/ref 17592186060018} {:db/id #edb/ref 17592186060019} {:db/id #edb/ref 17592186371520} {:db/id #edb/ref 17592186371534} {:db/id #edb