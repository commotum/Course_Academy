 #edb/ref 17592186373271 #edb/ref 17592186045417] [17592186059814 #edb/ref 1038 #edb/ref 17592186378299 #edb/ref 17592186045417] [17592186059814 #edb/ref 1038 #edb/ref 17592186378306 #edb/ref 17592186045417] [17592186059814 #edb/ref 1038 #edb/ref 17592186380118 #edb/ref 17592186045417] [17592186059814 #edb/ref 1038 #edb/ref 17592186397822 #edb/ref 17592186045417] [17592186059814 #edb/ref 1038 #edb/ref 17592186397829 #edb/ref 17592186045417] [17592186059814 #edb/ref 1038 #edb/ref 17592186399111 #edb/ref 17592186045417] [17592186059814 #edb/ref 1039 "Identifying Partitions of Large Sets" #edb/ref 17592186045417] [17592186059814 #edb/ref 1041 #edb/ref 17592186059617 #edb/ref 17592186045417] [17592186059814 #edb/ref 1042 #uuid "2b2a9a1d-2d20-58cf-a1ee-bee2f4cf120d" #edb/ref 17592186045417] [17592186059918 #edb/ref 1043 #edb/ref 17592186060748 #edb/ref 17592186045417] [17592186059918 #edb/ref 1043 #edb/ref 17592186060749 #edb/ref 17592186045417] [17592186059918 #edb/ref 1043 #edb/ref 17592186060750 #edb/ref 17592186045417] [17592186059918 #edb/ref 1043 #edb/ref 17592186060751 #edb/ref 17592186045417] [17592186059918 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186059918 #edb/ref 1045 "Partitions of Sets" #edb/ref 17592186045417] [17592186059918 #edb/ref 1046 #edb/ref 17592186060748 #edb/ref 17592186045417] [17592186059918 #edb/ref 1049 #edb/ref 17592186049842 #edb/ref 17592186045417] [17592186059918 #edb/ref 1053 #uuid "a395b4a3-cd2d-5496-be63-828e164fb8a3" #edb/ref 17592186045417] [17592186060748 #edb/ref 1058 #edb/ref 17592186060750 #edb/ref 17592186045417] [17592186060748 #edb/ref 1061 25815 #edb/ref 17592186045417] [17592186060748 #edb/ref 1062 #uuid "f50a4e80-5c54-5d58-ab17-5ed548aaeb19" #edb/ref 17592186045417] [17592186060748 #edb/ref 1063 #edb/ref 17592186060958 #edb/ref 17592186045417] [17592186060749 #edb/ref 1058 #edb/ref 17592186060751 #edb/ref 17592186045417] [17592186060749 #edb/ref 1061 25821 #edb/ref 17592186045417] [17592186060749 #edb/ref 1062 #uuid "6858b45d-f4c4-5f63-aed8-bbb4bb3ce478" #edb/ref 17592186045417] [17592186060749 #edb/ref 1063 #edb/ref 17592186059812 #edb/ref 17592186045417] [17592186060750 #edb/ref 1058 #edb/ref 17592186060749 #edb/ref 17592186045417] [17592186060750 #edb/ref 1061 25822 #edb/ref 17592186045417] [17592186060750 #edb/ref 1062 #uuid "23b02b10-a468-528d-9a2e-4a1fa212b764" #edb/ref 17592186045417] [17592186060750 #edb/ref 1063 #edb/ref 17592186059813 #edb/ref 17592186045417] [17592186060751 #edb/ref 1061 25823 #edb/ref 17592186045417] [17592186060751 #edb/ref 1062 #uuid "4ec4ab5b-df32-5ad9-bf35-f66b2266e9aa" #edb/ref 17592186045417] [17592186060751 #edb/ref 1063 #edb/ref 17592186059814 #edb/ref 17592186045417] [17592186060958 #edb/ref 1064 "A **partition** of a set $A$ is a collection of non-empty subsets of $A$ where every element of $A$ is contained in *exactly* one subset.\n\nIn other words, none of the subsets can be the null set $(\\emptyset),$ and every element of $A$ must be contained in one *and only one* subset.\n\nFor example, the following collections of subsets of $X=\\{1, 2, 3, 4, 5\\}$ are all partitions:\n\n- $X_1 = \\{ \\{ 1, 2\\}, \\{ 3, 4 \\}, \\{5\\} \\}$\n- $X_2 = \\{ \\{ 1, 2, 3\\}, \\{4, 5\\} \\}$\n- $X_3 = \\{ \\{ 1, 3\\}, \\{ 2\\}, \\{4, 5\\} \\}$\n- $X_4 = \\{ \\{ 1, 4, 5\\}, \\{ 2, 3\\} \\}$\n- $X_5 = \\{ \\{ 1, 2, 3, 4\\}, \\{5\\} \\}$\n\nHowever, the following collections are *not* partitions:\n\n- $X_6 = \\{ \\{ 1\\}, \\{ 3, 4 \\}, \\{5\\} \\}$ - the number $2$ is not included in any subset\n- $X_7 = \\{ \\emptyset, \\{ 1, 2, 3\\}, \\{4, 5\\} \\}$ - includes $\\emptyset$\n- $X_8 = \\{ \\{ 1, 3\\}, \\{ 2, 3\\}, \\{4, 5\\} \\}$ - the number $3$ is included in two different subsets\n- $X_9 = \\{ \\{ 1, 2 \\}, \\{ 2, 3\\} \\}$ - missing $4$ and $5,$ and $2$ is included in two different subsets\n- $X_{10} = \\{ 1, 2, 3, 4, 5 \\}$ - this not a collection of subsets" #edb/ref 17592186045417] [17592186060958 #edb/ref 1065 4252 #edb/ref 17592186045417] [17592186060958 #edb/ref 1066 #uuid "7c175282-8683-5a55-a872-02bbd19be4f5" #edb/ref 17592186045417] [17592186060958 #edb/ref 1067 "Introduction" #edb/ref 17592186045417]}
