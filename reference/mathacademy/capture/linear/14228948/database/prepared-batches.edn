-014d-5dbf-9ea0-9d3c98099132" :step/content "question-6b070545-3ae6-5e49-a6d2-101dac09a1fa" :step/next "step-f8e3443c-5cb1-5b59-839d-7c1ae6dd8ba6" :db/ensure [:step/validate]} {:db/id "step-f8e3443c-5cb1-5b59-839d-7c1ae6dd8ba6" :step/id #uuid "f8e3443c-5cb1-5b59-839d-7c1ae6dd8ba6" :step/content "question-c6760dcc-4403-5b3c-b44a-9e304dd2dc4f" :db/ensure [:step/validate]} {:db/id "assigned-problem-c921b9c1-215e-583b-b5c1-6f40d1ba8918" :assigned-problem/id #uuid "c921b9c1-215e-583b-b5c1-6f40d1ba8918" :assigned-problem/content "multistep-f86c67b8-5ef3-50e6-9f71-b4614feb6dde" :assigned-problem/topic-coverage [17592186050517 17592186050763 17592186050975 17592186049061 17592186049394 17592186049840 17592186049930 17592186050473] :db/ensure [:assigned-problem/validate]} {:db/id "activity-fd591ceb-6ad3-5be8-a2d8-1f9aaf01adbf" :activity/id #uuid "fd591ceb-6ad3-5be8-a2d8-1f9aaf01adbf" :activity/title "Graphs of Linear Equations, Parallel and Perpendicular Lines" :activity/type :activity.type/assignment :activity/steps ["step-60560f38-76bf-5533-943c-7f76b2b4b916"] :activity/first-step "step-60560f38-76bf-5533-943c-7f76b2b4b916" :db/ensure [:activity/validate]} {:db/id "step-60560f38-76bf-5533-943c-7f76b2b4b916" :step/id #uuid "60560f38-76bf-5533-943c-7f76b2b4b916" :step/content "assigned-problem-c921b9c1-215e-583b-b5c1-6f40d1ba8918" :db/ensure [:step/validate]}] "assertions" [["question-403888bf-8094-5cf9-8e20-26739c8d4dcf" :question/id #uuid "403888bf-8094-5cf9-8e20-26739c8d4dcf"] ["question-403888bf-8094-5cf9-8e20-26739c8d4dcf" :question/math-academy-id "q-167097"] ["question-403888bf-8094-5cf9-8e20-26739c8d4dcf" :question/problem "What are the $xy$-coordinates of the point $A?$\n\n$A\\,($\n{{field-1}}\n$,\\,$\n{{field-2}}\n$)$"] ["question-403888bf-8094-5cf9-8e20-26739c8d4dcf" :question/worked-solution "To find the coordinates of the point, we inspect its position along the $x$- and $y$-axes.\n\n* The point is $4$ units to the *right* of the origin, in the *positive* direction of the $x$-axis. So, its $x$-coordinate is $4.$\n\n* The point is $3$ units *below* the origin, in the *negative* direction of the $y$-axis. So, its $y$-coordinate is $-3.$\n\nTherefore, the coordinates of our point are $(4,-3).$"] ["question-403888bf-8094-5cf9-8e20-26739c8d4dcf" :question/difficulty :question.difficulty/easy] ["answer-field-07c73b40-9abe-5992-94a4-bfe4745f4eb5" :answer-field/id #uuid "07c73b40-9abe-5992-94a4-bfe4745f4eb5"] ["answer-eb884622-28d7-5ef0-904b-b681c29a17d5" :answer/id #uuid "eb884622-28d7-5ef0-904b-b681c29a17d5"] ["answer-eb884622-28d7-5ef0-904b-b681c29a17d5" :answer/type :answer.type/math] ["answer-eb884622-28d7-5ef0-904b-b681c29a17d5" :answer/value "4"] ["answer-field-07c73b40-9abe-5992-94a4-bfe4745f4eb5" :answer-field/key "field-1"] ["answer-field-07c73b40-9abe-5992-94a4-bfe4745f4eb5" :answer-field/type :answer-field.type/blank] ["answer-field-07c73b40-9abe-5992-94a4-bfe4745f4eb5" :answer-field/correct "answer-eb884622-28d7-5ef0-904b-b681c29a17d5"] ["answer-field-07c73b40-9abe-5992-94a4-bfe4745f4eb5" :answer-field/choices "answer-eb884622-28d7-5ef0-904b-b681c29a17d5"] ["answer-field-fb638e82-4178-578f-ab04-4a68913057eb" :answer-field/id #uuid "fb638e82-4178-578f-ab04-4a68913057eb"] ["answer-579c8b46-8d33-54c5-a3c3-18cdfc71685e" :answer/id #uuid "579c8b46-8d33-54c5-a3c3-18cdfc71685e"] ["answer-579c8b46-8d33-54c5-a3c3-18cdfc71685e" :answer/type :answer.type/math] ["answer-579c8b46-8d33-54c5-a3c3-18cdfc71685e" :answer/value "-3"] ["answer-field-fb638e82-4178-578f-ab04-4a68913057eb" :answer-field/key "field-2"] ["answer-field-fb638e82-4178-578f-ab04-4a68913057eb" :answer-field/type :answer-field.type/blank] ["answer-field-fb638e82-4178-578f-ab04-4a68913057eb" :answer-field/correct "answer-579c8b46-8d33-54c5-a3c3-18cdfc71685e"] ["answer-field-fb638e82-4178-578f-ab04-4a68913057eb" :answer-field/choices "answer-579c8b46-8d33-54c5-a3c3-18cdfc71685e"] ["question-403888bf-8094-5cf9-8e20-26739c8d4dcf" :question/answer-fields "answer-field-07c73b40-9abe-5992-94a4-bfe4745f4eb5"] ["question-403888bf-8094-5cf9-8e20-26739c8d4dcf" :question/answer-fields "answer-field-fb638e82-4178-578f-ab04-4a68913057eb"] [17592186054807 :knowledge-point/questions "question-403888bf-8094-5cf9-8e20-26739c8d4dcf"] ["question-fc8a9725-c277-5a2e-a217-f21f271d6767" :question/id #uuid "fc8a9725-c277-5a2e-a217-f21f271d6767"] ["question-fc8a9725-c277-5a2e-a217-f21f271d6767" :question/math-academy-id "q-167098"] ["question-fc8a9725-c277-5a2e-a217-f21f271d6767" :question/problem "Write the equations of the vertical and horizontal lines that pass through the point $B.$\n\nThe **equation** of the vertical line is \n{{field-1}}\n\nThe **equation** of the horizontal line is \n{{field-2}}"] ["question-fc8a9725-c277-5a2e-a217-f21f271d6767" :question/worked-solution "The coordinates of $B$ are $(1,3).$\n\n* Since the vertical line should pass through $(1,3)$, the $x$-value for every point on the line is $1.$ Hence, the equation of that line is \n\n$$\nx=1.\n$$\n\n* Since the horizontal line should pass through $(1,3)$, the $y$-value for every point on the line is $3.$ Hence, the equation of that line is \n\n$$\ny=3.\n$$"] ["question-fc8a9725-c277-5a2e-a217-f21f271d6767" :question/difficulty :question.difficulty/moderate] ["answer-field-23fcb6f4-611d-5630-822d-795b4c659afd" :answer-field/id #uuid "23fcb6f4-611d-5630-822d-795b4c659afd"] ["answer-4ae75924-88ff-50f4-b405-d0948000592c" :answer/id #uuid "4ae75924-88ff-50f4-b405-d0948000592c"] ["answer-4ae75924-88ff-50f4-b405-d0948000592c" :answer/type :answer.type/math] ["answer-4ae75924-88ff-50f4-b405-d0948000592c" :answer/value "x=1"] ["answer-field-23fcb6f4-611d-5630-822d-795b4c659afd" :answer-field/key "field-1"] ["answer-field-23fcb6f4-611d-5630-822d-795b4c659afd" :answer-field/type :answer-field.type/blank] ["answer-field-23fcb6f4-611d-5630-822d-795b4c659afd" :answer-field/correct "answer-4ae75924-88ff-50f4-b405-d0948000592c"] ["answer-field-23fcb6f4-611d-5630-822d-795b4c659afd" :answer-field/choices "answer-4ae75924-88ff-50f4-b405-d0948000592c"] ["answer-field-1d9a36f4-bfad-5ab0-a905-4a8fec742bb1" :answer-field/id #uuid "1d9a36f4-bfad-5ab0-a905-4a8fec742bb1"] ["answer-411c1d1a-a1ff-5047-865f-a91267f7a8d7" :answer/id #uuid "411c1d1a-a1ff-5047-865f-a91267f7a8d7"] ["answer-411c1d1a-a1ff-5047-865f-a91267f7a8d7" :answer/type :answer.type/math] ["answer-411c1d1a-a1ff-5047-865f-a91267f7a8d7" :answer/value "y=3"] ["answer-field-1d9a36f4-bfad-5ab0-a905-4a8fec742bb1" :answer-field/key "field-2"] ["answer-field-1d9a36f4-bfad-5ab0-a905-4a8fec742bb1" :answer-field/type :answer-field.type/blank] ["answer-field-1d9a36f4-bfad-5ab0-a905-4a8fec742bb1" :answer-field/correct "answer-411c1d1a-a1ff-5047-865f-a91267f7a8d7"] ["answer-field-1d9a36f4-bfad-5ab0-a905-4a8fec742bb1" :answer-field/choices "answer-411c1d1a-a1ff-5047-865f-a91267f7a8d7"] ["question-fc8a9725-c277-5a2e-a217-f21f271d6767" :question/answer-fields "answer-field-23fcb6f4-611d-5630-822d-795b4c659afd"] ["question-fc8a9725-c277-5a2e-a217-f21f271d6767" :question/answer-fields "answer-field-1d9a36f4-bfad-5ab0-a905-4a8fec742bb1"] [17592186054669 :knowledge-point/questions "question-fc8a9725-c277-5a2e-a217-f21f271d6767"] ["question-3b67bc82-d512-510a-bcaa-06aed32ef341" :question/id #uuid "3b67bc82-d512-510a-bcaa-06aed32ef341"] ["question-3b67bc82-d512-510a-bcaa-06aed32ef341" :question/math-academy-id "q-167099"] ["question-3b67bc82-d512-510a-bcaa-06aed32ef341" :question/problem "What is the length of $\\overset{―}{AB}?$\n\n$|\\overset{―}{AB}|\\,=\\,$\n{{field-1}}"] ["question-3b67bc82-d512-510a-bcaa-06aed32ef341" :question/worked-solution "From the picture, the points $A$ and $B$ have coordinates $({x}_{1},{y}_{1})=(4,-3)$ and $({x}_{2},{y}_{2})=(1,3),$ respectively.\n\nTo find the length of $\\overset{―}{AB},$ we use the distance formula:\n\n$$\n\\begin{aligned}|\\overset{―}{AB}| & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(1-4)^{2}+(3-(-3))^{2}} \\\\  & =\\sqrt{(-3)^{2}+{6}^{2}} \\\\  & =\\sqrt{9+36} \\\\  & =\\sqrt{45} \\\\  & =3\\sqrt{5}\\end{aligned}\n$$"] ["question-3b67bc82-d512-510a-bcaa-06aed32ef341" :question/difficulty :question.difficulty/easy] ["answer-field-713f23a1-e6fa-5079-aa42-25f25406f648" :answer-field/id #uuid "713f23a1-e6fa-5079-aa42-25f25406f648"] ["answer-df49025e-4e33-5fb8-b083-1dc676cfa0fa" :answer/id #uuid "df49025e-4e33-5fb8-b083-1dc676cfa0fa"] ["answer-df49025e-4e33-5fb8-b083-1dc676cfa0fa" :answer/type :answer.type/math] ["answer-df49025e-4e33-5fb8-b083-1dc676cfa0fa" :answer/value "3\\sqrt{5}"] ["answer-field-713f23a1-e6fa-5079-aa42-25f25406f648" :answer-field/key "field-1"] ["answer-field-713f23a1-e6fa-5079-aa42-25f25406f648" :answer-field/type :answer-field.type/blank] ["answer-field-713f23a1-e6fa-5079-aa42-25f25406f648" :answer-field/correct "answer-df49025e-4e33-5fb8-b083-1dc676cfa0fa"] ["answer-field-713f23a1-e6fa-5079-aa42-25f25406f648" :answer-field/choices "answer-df49025e-4e33-5fb8-b083-1dc676cfa0fa"] ["question-3b67bc82-d512-510a-bcaa-06aed32ef341" :question/answer-fields "answer-field-713f23a1-e6fa-5079-aa42-25f25406f648"] [17592186068720 :knowledge-point/questions "question-3b67bc82-d512-510a-bcaa-06aed32ef341"] ["question-79bc14d7-179c-5c17-ba5e-232b6f91a6cf" :question/id #uuid "79bc14d7-179c-5c17-ba5e-232b6f91a6cf"] ["question-79bc14d7-179c-5c17-ba5e-232b6f91a6cf" :question/math-academy-id "q-167100"] ["question-79bc14d7-179c-5c17-ba5e-232b6f91a6cf" :question/problem "What is the slope $m$ of the line $\\overset{↔}{AB}?$\n\n$m\\,=\\,$\n{{field-1}}"] ["question-79bc14d7-179c-5c17-ba5e-232b6f91a6cf" :question/worked-solution "As we found previously, the points $A$ and $B$ have coordinates $({x}_{1},{y}_{1})=(4,-3)$ and $({x}_{2},{y}_{2})=(1,3),$ respectively.\n\nTherefore, we compute the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{3-(-3)}{1-4} \\\\  & =\\frac{6}{-3} \\\\  & =-2\\end{aligned}\n$$"] ["question-79bc14d7-179c-5c17-ba5e-232b6f91a6cf" :question/difficulty :question.difficulty/easy] ["answer-field-bb67feb5-fa89-590c-be41-9c69627fc113" :answer-field/id #uuid "bb67feb5-fa89-590c-be41-9c69627fc113"] ["answer-fb7170ac-fdfb-5a59-ae07-1bb21bc759ed" :answer/id #uuid "fb7170ac-fdfb-5a59-ae07-1bb21bc759ed"] ["answer-fb7170ac-fdfb-5a59-ae07-1bb21bc759ed" :answer/type :answer.type/math] ["answer-fb7170ac-fdfb-5a59-ae07-1bb21bc759ed" :answer/value "-2"] ["answer-field-bb67feb5-fa89-590c-be41-9c69627fc113" :answer-field/key "field-1"] ["answer-field-bb67feb5-fa89-590c-be41-9c69627fc113" :answer-field/type :answer-field.type/blank] ["answer-field-bb67feb5-fa89-590c-be41-9c69627fc113" :answer-field/correct "answer-fb7170ac-fdfb-5a59-ae07-1bb21bc759ed"] ["answer-field-bb67feb5-fa89-590c-be41-9c69627fc113" :answer-field/choices "answer-fb7170ac-fdfb-5a59-ae07-1bb21bc759ed"] ["question-79bc14d7-179c-5c17-ba5e-232b6f91a6cf" :question/answer-fields "answer-field-bb67feb5-fa89-590c-be41-9c69627fc113"] [17592186068894 :knowledge-point/questions "question-79bc14d7-179c-5c17-ba5e-232b6f91a6cf"] ["question-7f09f62f-f5bc-5004-8782-5f89d18c5383" :question/id #uuid "7f09f62f-f5bc-5004-8782-5f89d18c5383"] ["question-7f09f62f-f5bc-5004-8782-5f89d18c5383" :question/math-academy-id "q-167101"] ["question-7f09f62f-f5bc-5004-8782-5f89d18c5383" :question/problem "Find the $y$-intercept of $\\overset{↔}{AB},$ and express the equation of this line in slope-intercept form.\n\nThe $y$ - intercept of the line is $b\\,=\\,$\n{{field-1}}\n\nThe equation is $y\\,=\\,$\n{{field-2}}"] ["question-7f09f62f-f5bc-5004-8782-5f89d18c5383" :question/worked-solution "We will write the equation of the line in the slope-intercept form \n\n$$\ny=mx+b.\n$$\n\nAs we found previously, the slope is $m=-2.$\n\nSubstituting $m=-2$ into the slope-intercept form above, we get\n\n$$\ny=-2x+b.\n$$\n\nWe now need to find the $y$-intercept $b.$ We can find this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(4,-3):$\n\n$$\n\\begin{aligned}y & =-2x+b \\\\ -3 & =-2(4)+b \\\\ -3 & =-8+b \\\\ 5 & =b \\\\ b & =5\\end{aligned}\n$$\n\nTherefore, the equation of the line is \n\n$$\ny=-2x+5.\n$$"] ["question-7f09f62f-f5bc-5004-8782-5f89d18c5383" :question/difficulty :question.difficulty/easy] ["answer-field-2793c581-3bd2-5896-8ef5-e95aced92eee" :answer-field/id #uuid "2793c581-3bd2-5896-8ef5-e95aced92eee"] ["answer-8e4ffc75-7371-5c2d-b74f-e086c2d908f3" :answer/id #uuid "8e4ffc75-7371-5c2d-b74f-e086c2d908f3"] ["answer-8e4ffc75-7371-5c2d-b74f-e086c2d908f3" :answer/type :answer.type/math] ["answer-8e4ffc75-7371-5c2d-b74f-e086c2d908f3" :answer/value "5"] ["answer-field-2793c581-3bd2-5896-8ef5-e95aced92eee" :answer-field/key "field-1"] ["answer-field-2793c581-3bd2-5896-8ef5-e95aced92eee" :answer-field/type :answer-field.type/blank] ["answer-field-2793c581-3bd2-5896-8ef5-e95aced92eee" :answer-field/correct "answer-8e4ffc75-7371-5c2d-b74f-e086c2d908f3"] ["answer-field-2793c581-3bd2-5896-8ef5-e95aced92eee" :answer-field/choices "answer-8e4ffc75-7371-5c2d-b74f-e086c2d908f3"] ["answer-field-8958b128-5689-552d-8a7a-ed52385902c0" :answer-field/id #uuid "8958b128-5689-552d-8a7a-ed52385902c0"] ["answer-35ec4058-3033-5189-b180-d21d1d98d10d" :answer/id #uuid "35ec4058-3033-5189-b180-d21d1d98d10d"] ["answer-35ec4058-3033-5189-b180-d21d1d98d10d" :answer/type :answer.type/math] ["answer-35ec4058-3033-5189-b180-d21d1d98d10d" :answer/value "-2x+5"] ["answer-field-8958b128-5689-552d-8a7a-ed52385902c0" :answer-field/key "field-2"] ["answer-field-8958b128-5689-552d-8a7a-ed52385902c0" :answer-field/type :answer-field.type/blank] ["answer-field-8958b128-5689-552d-8a7a-ed52385902c0" :answer-field/correct "answer-35ec4058-3033-5189-b180-d21d1d98d10d"] ["answer-field-8958b128-5689-552d-8a7a-ed52385902c0" :answer-field/choices "answer-35ec4058-3033-5189-b180-d21d1d98d10d"] ["question-7f09f62f-f5bc-5004-8782-5f89d18c5383" :question/answer-fields "answer-field-2793c581-3bd2-5896-8ef5-e95aced92eee"] ["question-7f09f62f-f5bc-5004-8782-5f89d18c5383" :question/answer-fields "answer-field-8958b128-5689-552d-8a7a-ed52385902c0"] [17592186068925 :knowledge-point/questions "question-7f09f62f-f5bc-5004-8782-5f89d18c5383"] ["question-2ac6642f-2218-5fe7-be53-d9c45b78af41" :question/id #uuid "2ac6642f-2218-5fe7-be53-d9c45b78af41"] ["question-2ac6642f-2218-5fe7-be53-d9c45b78af41" :question/math-academy-id "q-167103"] ["question-2ac6642f-2218-5fe7-be53-d9c45b78af41" :question/problem "Calculate the $x$-intercept of the line $\\overset{↔}{AB}.$\n\n$x\\,=\\,$\n{{field-1}}"] ["question-2ac6642f-2218-5fe7-be53-d9c45b78af41" :question/worked-solution "Previously, we found that $\\overset{↔}{AB}$ has equation\n\n$$\ny=-2x+5.\n$$\n\nAt the $x$-intercept, the $y$-coordinate is equal to $0.$ So, we can substitute $y=0$ into the equation and then solve for $x:$\n\n$$\n\\begin{aligned}y & =-2x+5 \\\\ 0 & =-2x+5 \\\\ 2x & =5 \\\\ x & =\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $x=\\frac{5}{2}.$ The coordinates of the $x$-intercept are $(\\frac{5}{2},0).$"] ["question-2ac6642f-2218-5fe7-be53-d9c45b78af41" :question/difficulty :question.difficulty/easy] ["answer-field-edb8e55d-e68f-59da-af4c-bf5091ccb2d7" :answer-field/id #uuid "edb8e55d-e68f-59da-af4c-bf5091ccb2d7"] ["answer-5356afcd-b86a-5455-aebb-d397c1bba50f" :answer/id #uuid "5356afcd-b86a-5455-aebb-d397c1bba50f"] ["answer-5356afcd-b86a-5455-aebb-d397c1bba50f" :answer/type :answer.type/math] ["answer-5356afcd-b86a-5455-aebb-d397c1bba50f" :answer/value "\\frac{5}{2}"] ["answer-field-edb8e55d-e68f-59da-af4c-bf5091ccb2d7" :answer-field/key "field-1"] ["answer-field-edb8e55d-e68f-59da-af4c-bf5091ccb2d7" :answer-field/type :answer-field.type/blank] ["answer-field-edb8e55d-e68f-59da-af4c-bf5091ccb2d7" :answer-field/correct "answer-5356afcd-b86a-5455-aebb-d397c1bba50f"] ["answer-field-edb8e55d-e68f-59da-af4c-bf5091ccb2d7" :answer-field/choices "answer-5356afcd-b86a-5455-aebb-d397c1bba50f"] ["question-2ac6642f-2218-5fe7-be53-d9c45b78af41" :question/answer-fields "answer-field-edb8e55d-e68f-59da-af4c-bf5091ccb2d7"] [17592186068926 :knowledge-point/questions "question-2ac6642f-2218-5fe7-be53-d9c45b78af41"] ["question-44ed6b9e-67d9-570a-adb5-f3b8825b1118" :question/id #uuid "44ed6b9e-67d9-570a-adb5-f3b8825b1118"] ["question-44ed6b9e-67d9-570a-adb5-f3b8825b1118" :question/math-academy-id "q-167104"] ["question-44ed6b9e-67d9-570a-adb5-f3b8825b1118" :question/problem "Write the equation of $\\overset{↔}{AB}$ in **standard form**.\n\nThe equation is \n{{field-1}} \n$x+y=$\n{{field-2}}."] ["question-44ed6b9e-67d9-570a-adb5-f3b8825b1118" :question/worked-solution "Our goal is to write the equation in the form \n\n$$\nax+by=c,\n$$\n\nwhere $a,b,$ and $c$ are integers with no common factors and $a\\ge 0.$\n\nWe begin by moving all of the variables to the left-hand side and all of the constants to the right-hand side:\n\n$$\n\\begin{aligned}y & =-2x+5 \\\\ 2x+y & =5\\end{aligned}\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a\\ge 0.$ So, we are done!\n\nThe standard form of the line is \n\n$$\n2x+y=5.\n$$"] ["question-44ed6b9e-67d9-570a-adb5-f3b8825b1118" :question/difficulty :question.difficulty/easy] ["answer-field-035e032d-dc16-59b8-a93f-3e5cc5d7945e" :answer-field/id #uuid "035e032d-dc16-59b8-a93f-3e5cc5d7945e"] ["answer-51d43d9d-a774-52bb-ae32-16fc0e455143" :answer/id #uuid "51d43d9d-a774-52bb-ae32-16fc0e455143"] ["answer-51d43d9d-a774-52bb-ae32-16fc0e455143" :answer/type :answer.type/math] ["answer-51d43d9d-a774-52bb-ae32-16fc0e455143" :answer/value "2"] ["answer-field-035e032d-dc16-59b8-a93f-3e5cc5d7945e" :answer-field/key "field-1"] ["answer-field-035e032d-dc16-59b8-a93f-3e5cc5d7945e" :answer-field/type :answer-field.type/blank] ["answer-field-035e032d-dc16-59b8-a93f-3e5cc5d7945e" :answer-field/correct "answer-51d43d9d-a774-52bb-ae32-16fc0e455143"] ["answer-field-035e032d-dc16-59b8-a93f-3e5cc5d7945e" :answer-field/choices "answer-51d43d9d-a774-52bb-ae32-16fc0e455143"] ["answer-field-1be08b7a-1d32-5604-a7dc-34c8e426ca86" :answer-field/id #uuid "1be08b7a-1d32-5604-a7dc-34c8e426ca86"] ["answer-960e4af8-435d-53a1-926a-470205775d95" :answer/id #uuid "960e4af8-435d-53a1-926a-470205775d95"] ["answer-960e4af8-435d-53a1-926a-470205775d95" :answer/type :answer.type/math] ["answer-960e4af8-435d-53a1-926a-470205775d95" :answer/value "5"] ["answer-field-1be08b7a-1d32-5604-a7dc-34c8e426ca86" :answer-field/key "field-2"] ["answer-field-1be08b7a-1d32-5604-a7dc-34c8e426ca86" :answer-field/type :answer-field.type/blank] ["answer-field-1be08b7a-1d32-5604-a7dc-34c8e426ca86" :answer-field/correct "answer-960e4af8-435d-53a1-926a-470205775d95"] ["answer-field-1be08b7a-1d32-5604-a7dc-34c8e426ca86" :answer-field/choices "answer-960e4af8-435d-53a1-926a-470205775d95"] ["question-44ed6b9e-67d9-570a-adb5-f3b8825b1118" :question/answer-fields "answer-field-035e032d-dc16-59b8-a93f-3e5cc5d7945e"] ["question-44ed6b9e-67d9-570a-adb5-f3b8825b1118" :question/answer-fields "answer-field-1be08b7a-1d32-5604-a7dc-34c8e426ca86"] [17592186087710 :knowledge-point/questions "question-44ed6b9e-67d9-570a-adb5-f3b8825b1118"] ["question-6b070545-3ae6-5e49-a6d2-101dac09a1fa" :question/id #uuid "6b070545-3ae6-5e49-a6d2-101dac09a1fa"] ["question-6b070545-3ae6-5e49-a6d2-101dac09a1fa" :question/math-academy-id "q-167105"] ["question-6b070545-3ae6-5e49-a6d2-101dac09a1fa" :question/problem "Write the equation of the line that passes through the point $(4,0)$ and is parallel to $\\overset{↔}{AB}.$\n\nThe slope-intercept form of the equation is $y\\,=\\,$\n{{field-1}}"] ["question-6b070545-3ae6-5e49-a6d2-101dac09a1fa" :question/worked-solution "Since parallel lines have equal slopes, the slope of the new line should be equal to the slope of the line $\\overset{↔}{AB},$ i.e.,\n\n$$\nm=-2.\n$$\n\nSo, we want a line with the slope $m=-2$ that passes through the point $({x}_{1},{y}_{1})=(4,0).$ \n\nUsing point-slope form and simplifying, we obtain the following equation:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-0 & =-2\\cdot (x-4) \\\\ y & =-2x+8\\end{aligned}\n$$"] ["question-6b070545-3ae6-5e49-a6d2-101dac09a1fa" :question/difficulty :question.difficulty/moderate] ["answer-field-23a2ac4b-2fc2-50ff-b99d-a884d3fa4ee2" :answer-field/id #uuid "23a2ac4b-2fc2-50ff-b99d-a884d3fa4ee2"] ["answer-ea512d41-ab28-59ba-a04a-101b45b11211" :answer/id #uuid "ea512d41-ab28-59ba-a04a-101b45b11211"] ["answer-ea512d41-ab28-59ba-a04a-101b45b11211" :answer/type :answer.type/math] ["answer-ea512d41-ab28-59ba-a04a-101b45b11211" :answer/value "-2x+8"] ["answer-field-23a2ac4b-2fc2-50ff-b99d-a884d3fa4ee2" :answer-field/key "field-1"] ["answer-field-23a2ac4b-2fc2-50ff-b99d-a884d3fa4ee2" :answer-field/type :answer-field.type/blank] ["answer-field-23a2ac4b-2fc2-50ff-b99d-a884d3fa4ee2" :answer-field/correct "answer-ea512d41-ab28-59ba-a04a-101b45b11211"] ["answer-field-23a2ac4b-2fc2-50ff-b99d-a884d3fa4ee2" :answer-field/choices "answer-ea512d41-ab28-59ba-a04a-101b45b11211"] ["question-6b070545-3ae6-5e49-a6d2-101dac09a1fa" :question/answer-fields "answer-field-23a2ac4b-2fc2-50ff-b99d-a884d3fa4ee2"] [17592186175910 :knowledge-point/questions "question-6b070545-3ae6-5e49-a6d2-101dac09a1fa"] ["question-c6760dcc-4403-5b3c-b44a-9e304dd2dc4f" :question/id #uuid "c6760dcc-4403-5b3c-b44a-9e304dd2dc4f"] ["question-c6760dcc-4403-5b3c-b44a-9e304dd2dc4f" :question/math-academy-id "q-167106"] ["question-c6760dcc-4403-5b3c-b44a-9e304dd2dc4f" :question/problem "Write the equation of the line that passes through the point $(10,3)$ and is perpendicular to $\\overset{↔}{AB}.$\n\nThe slope-intercept form of the equation is $y\\,=\\,$\n{{field-1}}"] ["question-c6760dcc-4403-5b3c-b44a-9e304dd2dc4f" :question/worked-solution "Perpendicular lines have slopes that are negative reciprocals of each other. Therefore, since $\\overset{↔}{AB}$ has the slope $m=-2,$ our perpendicular line must have a slope of \n\n$$\n{m}_{1}=-\\frac{1}{m}=-\\frac{1}{(-2)}=\\frac{1}{2}.\n$$\n\nSo, our perpendicular line has the slope ${m}_{1}=\\frac{1}{2}$ and passes through the point $({x}_{1},{y}_{1})=(10,3).$ \n\nFinally, using point-slope form and simplifying, we obtain the following equation:\n\n$$\n\\begin{aligned}y-{y}_{1} & ={m}_{1}(x-{x}_{1}) \\\\ y-3 & =\\frac{1}{2}(x-10) \\\\ y-3 & =\\frac{1}{2}x-5 \\\\ y & =\\frac{1}{2}x-2\\end{aligned}\n$$"] ["question-c6760dcc-4403-5b3c-b44a-9e304dd2dc4f" :question/difficulty :question.difficulty/easy] ["answer-field-852439a5-b0a0-5f09-92f8-0c58c72638c3" :answer-field/id #uuid "852439a5-b0a0-5f09-92f8-0c58c72638c3"] ["answer-f5ce881d-23ba-52aa-882e-2cd98b4d1b56" :answer/id #uuid "f5ce881d-23ba-52aa-882e-2cd98b4d1b56"] ["answer-f5ce881d-23ba-52aa-882e-2cd98b4d1b56" :answer/type :answer.type/math] ["answer-f5ce881d-23ba-52aa-882e-2cd98b4d1b56" :answer/value "\\frac{1}{2}x-2"] ["answer-field-852439a5-b0a0-5f09-92f8-0c58c72638c3" :answer-field/key "field-1"] ["answer-field-852439a5-b0a0-5f09-92f8-0c58c72638c3" :answer-field/type :answer-field.type/blank] ["answer-field-852439a5-b0a0-5f09-92f8-0c58c72638c3" :answer-field/correct "answer-f5ce881d-23ba-52aa-882e-2cd98b4d1b56"] ["answer-field-852439a5-b0a0-5f09-92f8-0c58c72638c3" :answer-field/choices "answer-f5ce881d-23ba-52aa-882e-2cd98b4d1b56"] ["question-c6760dcc-4403-5b3c-b44a-9e304dd2dc4f" :question/answer-fields "answer-field-852439a5-b0a0-5f09-92f8-0c58c72638c3"] [17592186175923 :knowledge-point/questions "question-c6760dcc-4403-5b3c-b44a-9e304dd2dc4f"] ["multistep-f86c67b8-5ef3-50e6-9f71-b4614feb6dde" :multistep/id #uuid "f86c67b8-5ef3-50e6-9f71-b4614feb6dde"] ["step-7759f2fa-f496-5dd5-8aff-2653c3e9441a" :step/id #uuid "7759f2fa-f496-5dd5-8aff-2653c3e9441a"] ["step-a2e163d1-dd5b-58d3-b361-e2807e494c9e" :step/id #uuid "a2e163d1-dd5b-58d3-b361-e2807e494c9e"] ["step-e1f2abf3-17aa-5b88-9b26-303aa909a413" :step/id #uuid "e1f2abf3-17aa-5b88-9b26-303aa909a413"] ["step-2c8a856f-5da6-5572-88c5-cde44c333e98" :step/id #uuid "2c8a856f-5da6-5572-88c5-cde44c333e98"] ["step-b6a9945a-7c14