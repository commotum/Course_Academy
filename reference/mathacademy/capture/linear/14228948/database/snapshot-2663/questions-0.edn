#{[{:db/id #edb/ref 17592186551267 :knowledge-point/_questions [{:db/id #edb/ref 17592186054807 :knowledge-point/id #uuid "b509b42a-c38a-5400-8f93-f3e9024b16a2" :knowledge-point/title "Identifying the Coordinates of a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb884622-28d7-5ef0-904b-b681c29a17d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186551004}] :answer-field/correct {:answer/id #uuid "eb884622-28d7-5ef0-904b-b681c29a17d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186551004} :answer-field/id #uuid "07c73b40-9abe-5992-94a4-bfe4745f4eb5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186551064} {:answer-field/choices [{:answer/id #uuid "579c8b46-8d33-54c5-a3c3-18cdfc71685e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186550581}] :answer-field/correct {:answer/id #uuid "579c8b46-8d33-54c5-a3c3-18cdfc71685e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186550581} :answer-field/id #uuid "fb638e82-4178-578f-ab04-4a68913057eb" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186551226}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "403888bf-8094-5cf9-8e20-26739c8d4dcf" :question/math-academy-id "q-167097" :question/problem "What are the $xy$-coordinates of the point $A?$\n\n$A\\,($\n{{field-1}}\n$,\\,$\n{{field-2}}\n$)$" :question/worked-solution "To find the coordinates of the point, we inspect its position along the $x$- and $y$-axes.\n\n* The point is $4$ units to the *right* of the origin, in the *positive* direction of the $x$-axis. So, its $x$-coordinate is $4.$\n\n* The point is $3$ units *below* the origin, in the *negative* direction of the $y$-axis. So, its $y$-coordinate is $-3.$\n\nTherefore, the coordinates of our point are $(4,-3).$"}] [{:db/id #edb/ref 17592186551354 :knowledge-point/_questions [{:db/id #edb/ref 17592186054669 :knowledge-point/id #uuid "bf635847-145c-5da5-927e-8196e809324e" :knowledge-point/title "Points Associated With Horizontal and Vertical Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "411c1d1a-a1ff-5047-865f-a91267f7a8d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186550519}] :answer-field/correct {:answer/id #uuid "411c1d1a-a1ff-5047-865f-a91267f7a8d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186550519} :answer-field/id #uuid "1d9a36f4-bfad-5ab0-a905-4a8fec742bb1" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186551079} {:answer-field/choices [{:answer/id #uuid "4ae75924-88ff-50f4-b405-d0948000592c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=1" :db/id #edb/ref 17592186550544}] :answer-field/correct {:answer/id #uuid "4ae75924-88ff-50f4-b405-d0948000592c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=1" :db/id #edb/ref 17592186550544} :answer-field/id #uuid "23fcb6f4-611d-5630-822d-795b4c659afd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186551084}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fc8a9725-c277-5a2e-a217-f21f271d6767" :question/math-academy-id "q-167098" :question/problem "Write the equations of the vertical and horizontal lines that pass through the point $B.$\n\nThe **equation** of the vertical line is \n{{field-1}}\n\nThe **equation** of the horizontal line is \n{{field-2}}" :question/worked-solution "The coordinates of $B$ are $(1,3).$\n\n* Since the vertical line should pass through $(1,3)$, the $x$-value for every point on the line is $1.$ Hence, the equation of that line is \n\n$$\nx=1.\n$$\n\n* Since the horizontal line should pass through $(1,3)$, the $y$-value for every point on the line is $3.$ Hence, the equation of that line is \n\n$$\ny=3.\n$$"}] [{:db/id #edb/ref 17592186551263 :knowledge-point/_questions [{:db/id #edb/ref 17592186068720 :knowledge-point/id #uuid "5df52cb5-75b1-58d9-8535-07c1bb87be34" :knowledge-point/title "Determining the Length of a Segment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df49025e-4e33-5fb8-b083-1dc676cfa0fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186550975}] :answer-field/correct {:answer/id #uuid "df49025e-4e33-5fb8-b083-1dc676cfa0fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186550975} :answer-field/id #uuid "713f23a1-e6fa-5079-aa42-25f25406f648" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186551130}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3b67bc82-d512-510a-bcaa-06aed32ef341" :question/math-academy-id "q-167099" :question/problem "What is the length of $\\overset{―}{AB}?$\n\n$|\\overset{―}{AB}|\\,=\\,$\n{{field-1}}" :question/worked-solution "From the picture, the points $A$ and $B$ have coordinates $({x}_{1},{y}_{1})=(4,-3)$ and $({x}_{2},{y}_{2})=(1,3),$ respectively.\n\nTo find the length of $\\overset{―}{AB},$ we use the distance formula:\n\n$$\n\\begin{aligned}|\\overset{―}{AB}| & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(1-4)^{2}+(3-(-3))^{2}} \\\\  & =\\sqrt{(-3)^{2}+{6}^{2}} \\\\  & =\\sqrt{9+36} \\\\  & =\\sqrt{45} \\\\  & =3\\sqrt{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186551293 :knowledge-point/_questions [{:db/id #edb/ref 17592186068894 :knowledge-point/id #uuid "2db034b8-5119-5cf3-bb6e-e6c79d024177" :knowledge-point/title "Calculating the Slope Given Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb7170ac-fdfb-5a59-ae07-1bb21bc759ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186551042}] :answer-field/correct {:answer/id #uuid "fb7170ac-fdfb-5a59-ae07-1bb21bc759ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186551042} :answer-field/id #uuid "bb67feb5-fa89-590c-be41-9c69627fc113" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186551179}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "79bc14d7-179c-5c17-ba5e-232b6f91a6cf" :question/math-academy-id "q-167100" :question/problem "What is the slope $m$ of the line $\\overset{↔}{AB}?$\n\n$m\\,=\\,$\n{{field-1}}" :question/worked-solution "As we found previously, the points $A$ and $B$ have coordinates $({x}_{1},{y}_{1})=(4,-3)$ and $({x}_{2},{y}_{2})=(1,3),$ respectively.\n\nTherefore, we compute the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{3-(-3)}{1-4} \\\\  & =\\frac{6}{-3} \\\\  & =-2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186551297 :knowledge-point/_questions [{:db/id #edb/ref 17592186068925 :knowledge-point/id #uuid "5e985ae8-05ba-590a-b504-4c84884679f4" :knowledge-point/title "Finding the Equation of a Line That Passes Through Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e4ffc75-7371-5c2d-b74f-e086c2d908f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186550730}] :answer-field/correct {:answer/id #uuid "8e4ffc75-7371-5c2d-b74f-e086c2d908f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186550730} :answer-field/id #uuid "2793c581-3bd2-5896-8ef5-e95aced92eee" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186551087} {:answer-field/choices [{:answer/id #uuid "35ec4058-3033-5189-b180-d21d1d98d10d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x+5" :db/id #edb/ref 17592186550499}] :answer-field/correct {:answer/id #uuid "35ec4058-3033-5189-b180-d21d1d98d10d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x+5" :db/id #edb/ref 17592186550499} :answer-field/id #uuid "8958b128-5689-552d-8a7a-ed52385902c0" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186551149}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7f09f62f-f5bc-5004-8782-5f89d18c5383" :question/math-academy-id "q-167101" :question/problem "Find the $y$-intercept of $\\overset{↔}{AB},$ and express the equation of this line in slope-intercept form.\n\nThe $y$ - intercept of the line is $b\\,=\\,$\n{{field-1}}\n\nThe equation is $y\\,=\\,$\n{{field-2}}" :question/worked-solution "We will write the equation of the line in the slope-intercept form \n\n$$\ny=mx+b.\n$$\n\nAs we found previously, the slope is $m=-2.$\n\nSubstituting $m=-2$ into the slope-intercept form above, we get\n\n$$\ny=-2x+b.\n$$\n\nWe now need to find the $y$-intercept $b.$ We can find this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(4,-3):$\n\n$$\n\\begin{aligned}y & =-2x+b \\\\ -3 & =-2(4)+b \\\\ -3 & =-8+b \\\\ 5 & =b \\\\ b & =5\\end{aligned}\n$$\n\nTherefore, the equation of the line is \n\n$$\ny=-2x+5.\n$$"}] [{:db/id #edb/ref 17592186551251 :knowledge-point/_questions [{:db/id #edb/ref 17592186068926 :knowledge-point/id #uuid "63461668-4f76-52a4-8115-1ab135eef9e3" :knowledge-point/title "Finding the X-Intercept of a Line Given a Point and a Slope"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5356afcd-b86a-5455-aebb-d397c1bba50f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186550566}] :answer-field/correct {:answer/id #uuid "5356afcd-b86a-5455-aebb-d397c1bba50f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186550566} :answer-field/id #uuid "edb8e55d-e68f-59da-af4c-bf5091ccb2d7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186551217}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2ac6642f-2218-5fe7-be53-d9c45b78af41" :question/math-academy-id "q-167103" :question/problem "Calculate the $x$-intercept of the line $\\overset{↔}{AB}.$\n\n$x\\,=\\,$\n{{field-1}}" :question/worked-solution "Previously, we found that $\\overset{↔}{AB}$ has equation\n\n$$\ny=-2x+5.\n$$\n\nAt the $x$-intercept, the $y$-coordinate is equal to $0.$ So, we can substitute $y=0$ into the equation and then solve for $x:$\n\n$$\n\\begin{aligned}y & =-2x+5 \\\\ 0 & =-2x+5 \\\\ 2x & =5 \\\\ x & =\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $x=\\frac{5}{2}.$ The coordinates of the $x$-intercept are $(\\frac{5}{2},0).$"}] [{:db/id #edb/ref 17592186551270 :knowledge-point/_questions [{:db/id #edb/ref 17592186087710 :knowledge-point/id #uuid "f399f6ed-91bc-594e-9a40-b7c79f60c5dc" :knowledge-point/title "Converting from Slope-Intercept Form to Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51d43d9d-a774-52bb-ae32-16fc0e455143" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186550560}] :answer-field/correct {:answer/id #uuid "51d43d9d-a774-52bb-ae32-16fc0e455143" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186550560} :answer-field/id #uuid "035e032d-dc16-59b8-a93f-3e5cc5d7945e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186551063} {:answer-field/choices [{:answer/id #uuid "960e4af8-435d-53a1-926a-470205775d95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186550747}] :answer-field/correct {:answer/id #uuid "960e4af8-435d-53a1-926a-470205775d95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186550747} :answer-field/id #uuid "1be08b7a-1d32-5604-a7dc-34c8e426ca86" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186551075}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "44ed6b9e-67d9-570a-adb5-f3b8825b1118" :question/math-academy-id "q-167104" :question/problem "Write the equation of $\\overset{↔}{AB}$ in **standard form**.\n\nThe equation is \n{{field-1}} \n$x+y=$\n{{field-2}}." :question/worked-solution "Our goal is to write the equation in the form \n\n$$\nax+by=c,\n$$\n\nwhere $a,b,$ and $c$ are integers with no common factors and $a\\ge 0.$\n\nWe begin by moving all of the variables to the left-hand side and all of the constants to the right-hand side:\n\n$$\n\\begin{aligned}y & =-2x+5 \\\\ 2x+y & =5\\end{aligned}\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a\\ge 0.$ So, we are done!\n\nThe standard form of the line is \n\n$$\n2x+y=5.\n$$"}] [{:db/id #edb/ref 17592186551287 :knowledge-point/_questions [{:db/id #edb/ref 17592186175910 :knowledge-point/id #uuid "4dcbc520-40b5-5c08-ba56-be105c135240" :knowledge-point/title "Finding the Equation of a Line Passing Through a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea512d41-ab28-59ba-a04a-101b45b11211" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x+8" :db/id #edb/ref 17592186551001}] :answer-field/correct {:answer/id #uuid "ea512d41-ab28-59ba-a04a-101b45b11211" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x+8" :db/id #edb/ref 17592186551001} :answer-field/id #uuid "23a2ac4b-2fc2-50ff-b99d-a884d3fa4ee2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186551083}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6b070545-3ae6-5e49-a6d2-101dac09a1fa" :question/math-academy-id "q-167105" :question/problem "Write the equation of the line that passes through the point $(4,0)$ and is parallel to $\\overset{↔}{AB}.$\n\nThe slope-intercept form of the equation is $y\\,=\\,$\n{{field-1}}" :question/worked-solution "Since parallel lines have equal slopes, the slope of the new line should be equal to the slope of the line $\\overset{↔}{AB},$ i.e.,\n\n$$\nm=-2.\n$$\n\nSo, we want a line with the slope $m=-2$ that passes through the point $({x}_{1},{y}_{1})=(4,0).$ \n\nUsing point-slope form and simplifying, we obtain the following equation:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-0 & =-2\\cdot (x-4) \\\\ y & =-2x+8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186551333 :knowledge-point/_questions [{:db/id #edb/ref 17592186175923 :knowledge-point/id #uuid "44b9b212-27c4-5d6d-a221-cd85c25fc956" :knowledge-point/title "Finding the Equation of a Line Perpendicular to a Line Through Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f5ce881d-23ba-52aa-882e-2cd98b4d1b56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}x-2" :db/id #edb/ref 17592186551026}] :answer-field/correct {:answer/id #uuid "f5ce881d-23ba-52aa-882e-2cd98b4d1b56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}x-2" :db/id #edb/ref 17592186551026} :answer-field/id #uuid "852439a5-b0a0-5f09-92f8-0c58c72638c3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186551145}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c6760dcc-4403-5b3c-b44a-9e304dd2dc4f" :question/math-academy-id "q-167106" :question/problem "Write the equation of the line that passes through the point $(10,3)$ and is perpendicular to $\\overset{↔}{AB}.$\n\nThe slope-intercept form of the equation is $y\\,=\\,$\n{{field-1}}" :question/worked-solution "Perpendicular lines have slopes that are negative reciprocals of each other. Therefore, since $\\overset{↔}{AB}$ has the slope $m=-2,$ our perpendicular line must have a slope of \n\n$$\n{m}_{1}=-\\frac{1}{m}=-\\frac{1}{(-2)}=\\frac{1}{2}.\n$$\n\nSo, our perpendicular line has the slope ${m}_{1}=\\frac{1}{2}$ and passes through the point $({x}_{1},{y}_{1})=(10,3).$ \n\nFinally, using point-slope form and simplifying, we obtain the following equation:\n\n$$\n\\begin{aligned}y-{y}_{1} & ={m}_{1}(x-{x}_{1}) \\\\ y-3 & =\\frac{1}{2}(x-10) \\\\ y-3 & =\\frac{1}{2}x-5 \\\\ y & =\\frac{1}{2}x-2\\end{aligned}\n$$"}]}
