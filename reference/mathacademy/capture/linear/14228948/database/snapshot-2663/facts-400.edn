db/ref 17592186045492 #edb/ref 17592186045417] [17592186551217 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186551217 #edb/ref 1078 #edb/ref 17592186550566 #edb/ref 17592186045417] [17592186551217 #edb/ref 1079 #uuid "edb8e55d-e68f-59da-af4c-bf5091ccb2d7" #edb/ref 17592186045417] [17592186551226 #edb/ref 1075 #edb/ref 17592186550581 #edb/ref 17592186045417] [17592186551226 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186551226 #edb/ref 1077 "field-2" #edb/ref 17592186045417] [17592186551226 #edb/ref 1078 #edb/ref 17592186550581 #edb/ref 17592186045417] [17592186551226 #edb/ref 1079 #uuid "fb638e82-4178-578f-ab04-4a68913057eb" #edb/ref 17592186045417] [17592186551231 #edb/ref 1088 #edb/ref 17592186049061 #edb/ref 17592186045417] [17592186551231 #edb/ref 1088 #edb/ref 17592186049394 #edb/ref 17592186045417] [17592186551231 #edb/ref 1088 #edb/ref 17592186049840 #edb/ref 17592186045417] [17592186551231 #edb/ref 1088 #edb/ref 17592186049930 #edb/ref 17592186045417] [17592186551231 #edb/ref 1088 #edb/ref 17592186050473 #edb/ref 17592186045417] [17592186551231 #edb/ref 1088 #edb/ref 17592186050517 #edb/ref 17592186045417] [17592186551231 #edb/ref 1088 #edb/ref 17592186050763 #edb/ref 17592186045417] [17592186551231 #edb/ref 1088 #edb/ref 17592186050975 #edb/ref 17592186045417] [17592186551231 #edb/ref 1089 #edb/ref 17592186551232 #edb/ref 17592186045417] [17592186551231 #edb/ref 1090 #uuid "c921b9c1-215e-583b-b5c1-6f40d1ba8918" #edb/ref 17592186045417] [17592186551232 #edb/ref 1084 #edb/ref 17592186551378 #edb/ref 17592186045417] [17592186551232 #edb/ref 1084 #edb/ref 17592186551397 #edb/ref 17592186045417] [17592186551232 #edb/ref 1084 #edb/ref 17592186551413 #edb/ref 17592186045417] [17592186551232 #edb/ref 1084 #edb/ref 17592186551432 #edb/ref 17592186045417] [17592186551232 #edb/ref 1084 #edb/ref 17592186551442 #edb/ref 17592186045417] [17592186551232 #edb/ref 1084 #edb/ref 17592186551453 #edb/ref 17592186045417] [17592186551232 #edb/ref 1084 #edb/ref 17592186551455 #edb/ref 17592186045417] [17592186551232 #edb/ref 1084 #edb/ref 17592186551458 #edb/ref 17592186045417] [17592186551232 #edb/ref 1084 #edb/ref 17592186551468 #edb/ref 17592186045417] [17592186551232 #edb/ref 1085 "![](images/4f/4f2a3229336aa53a36621138c9cee114b1dee0c8244d778a6e3e2ac28950e908.png)\n\nConsider the diagram shown above." #edb/ref 17592186045417] [17592186551232 #edb/ref 1086 #uuid "f86c67b8-5ef3-50e6-9f71-b4614feb6dde" #edb/ref 17592186045417] [17592186551232 #edb/ref 1087 #edb/ref 17592186551413 #edb/ref 17592186045417] [17592186551251 #edb/ref 1068 #edb/ref 17592186551217 #edb/ref 17592186045417] [17592186551251 #edb/ref 1069 "q-167103" #edb/ref 17592186045417] [17592186551251 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186551251 #edb/ref 1071 "Calculate the $x$-intercept of the line $\\overset{↔}{AB}.$\n\n$x\\,=\\,$\n{{field-1}}" #edb/ref 17592186045417] [17592186551251 #edb/ref 1072 #uuid "2ac6642f-2218-5fe7-be53-d9c45b78af41" #edb/ref 17592186045417] [17592186551251 #edb/ref 1074 "Previously, we found that $\\overset{↔}{AB}$ has equation\n\n$$\ny=-2x+5.\n$$\n\nAt the $x$-intercept, the $y$-coordinate is equal to $0.$ So, we can substitute $y=0$ into the equation and then solve for $x:$\n\n$$\n\\begin{aligned}y & =-2x+5 \\\\ 0 & =-2x+5 \\\\ 2x & =5 \\\\ x & =\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $x=\\frac{5}{2}.$ The coordinates of the $x$-intercept are $(\\frac{5}{2},0).$" #edb/ref 17592186045417] [17592186551263 #edb/ref 1068 #edb/ref 17592186551130 #edb/ref 17592186045417] [17592186551263 #edb/ref 1069 "q-167099" #edb/ref 17592186045417] [17592186551263 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186551263 #edb/ref 1071 "What is the length of $\\overset{―}{AB}?$\n\n$|\\overset{―}{AB}|\\,=\\,$\n{{field-1}}" #edb/ref 17592186045417] [17592186551263 #edb/ref 1072 #uuid "3b67bc82-d512-510a-bcaa-06aed32ef341" #edb/ref 17592186045417] [17592186551263 #edb/ref 1074 "From the picture, the points $A$ and $B$ have coordinates $({x}_{1},{y}_{1})=(4,-3)$ and $({x}_{2},{y}_{2})=(1,3),$ respectively.\n\nTo find the length of $\\overset{―}{AB},$ we use the distance formula:\n\n$$\n\\begin{aligned}|\\overset{―}{AB}| & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(1-4)^{2}+(3-(-3))^{2}} \\\\  & =\\sqrt{(-3)^{2}+{6}^{2}} \\\\  & =\\sqrt{9+36} \\\\  & =\\sqrt{45} \\\\  & =3\\sqrt{5}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186551267 #edb/ref 1068 #edb/ref 17592186551064 #edb/ref 17592186045417] [17592186551267 #edb/ref 1068 #edb/ref 17592186551226 #edb/ref 17592186045417] [17592186551267 #edb/ref 1069 "q-167097" #edb/ref 17592186045417] [17592186551267 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186551267 #edb/ref 1071 "What are the $xy$-coordinates of the point $A?$\n\n$A\\,($\n{{field-1}}\n$,\\,$\n{{field-2}}\n$)$" #edb/ref 17592186045417] [17592186551267 #edb/ref 1072 #uuid "403888bf-8094-5cf9-8e20-26739c8d4dcf" #edb/ref 17592186045417] [17592186551267 #edb/ref 1074 "To find the coordinates of the point, we inspect its position along the $x$- and $y$-axes.\n\n* The point is $4$ units to the *right* of the origin, in the *positive* direction of the $x$-axis. So, its $x$-coordinate is $4.$\n\n* The point is $3$ units *below* the origin, in the *negative* direction of the $y$-axis. So, its $y$-coordinate is $-3.$\n\nTherefore, the coordinates of our point are $(4,-3).$" #edb/ref 17592186045417] [17592186551270 #edb/ref 1068 #edb/ref 17592186551063 #edb/ref 17592186045417] [17592186551270 #edb/ref 1068 #edb/ref 17592186551075 #edb/ref 17592186045417] [17592186551270 #edb/ref 1069 "q-167104" #edb/ref 17592186045417] [17592186551270 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186551270 #edb/ref 1071 "Write the equation of $\\overset{↔}{AB}$ in **standard form**.\n\nThe equation is \n{{field-1}} \n$x+y=$\n{{field-2}}." #edb/ref 17592186045417] [17592186551270 #edb/ref 1072 #uuid "44ed6b9e-67d9-570a-adb5-f3b8825b1118" #edb/ref 17592186045417] [17592186551270 #edb/ref 1074 "Our goal is to write the equation in the form \n\n$$\nax+by=c,\n$$\n\nwhere $a,b,$ and $c$ are integers with no common factors and $a\\ge 0.$\n\nWe begin by moving all of the variables to the left-hand side and all of the constants to the right-hand side:\n\n$$\n\\begin{aligned}y & =-2x+5 \\\\ 2x+y & =5\\end{aligned}\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a\\ge 0.$ So, we are done!\n\nThe standard form of the line is \n\n$$\n2x+y=5.\n$$" #edb/ref 17592186045417] [17592186551287 #edb/ref 1068 #edb/ref 17592186551083 #edb/ref 17592186045417] [17592186551287 #edb/ref 1069 "q-167105" #edb/ref 17592186045417] [17592186551287 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186551287 #edb/ref 1071 "Write the equation of the line that passes through the point $(4,0)$ and is parallel to $\\overset{↔}{AB}.$\n\nThe slope-intercept form of the equation is $y\\,=\\,$\n{{field-1}}" #edb/ref 17592186045417] [17592186551287 #edb/ref 1072 #uuid "6b070545-3ae6-5e49-a6d2-101dac09a1fa" #edb/ref 17592186045417] [17592186551287 #edb/ref 1074 "Since parallel lines have equal slopes, the slope of the new line should be equal to the slope of the line $\\overset{↔}{AB},$ i.e.,\n\n$$\nm=-2.\n$$\n\nSo, we want a line with the slope $m=-2$ that passes through the point $({x}_{1},{y}_{1})=(4,0).$ \n\nUsing point-slope form and simplifying, we obtain the following equation:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-0 & =-2\\cdot (x-4) \\\\ y & =-2x+8\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186551293 #edb/ref 1068 #edb/ref 17592186551179 #edb/ref 17592186045417] [17592186551293 #edb/ref 1069 "q-167100" #edb/ref 17592186045417] [17592186551293 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186551293 #edb/ref 1071 "What is the slope $m$ of the line $\\overset{↔}{AB}?$\n\n$m\\,=\\,$\n{{field-1}}" #edb/ref 17592186045417] [17592186551293 #edb/ref 1072 #uuid "79bc14d7-179c-5c17-ba5e-232b6f91a6cf" #edb/ref 17592186045417] [17592186551293 #edb/ref 1074 "As we found previously, the points $A$ and $B$ have coordinates $({x}_{1},{y}_{1})=(4,-3)$ and $({x}_{2},{y}_{2})=(1,3),$ respectively.\n\nTherefore, we compute the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{3-(-3)}{1-4} \\\\  & =\\frac{6}{-3} \\\\  & =-2\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186551297 #edb/ref 1068 #edb/ref 17592186551087 #edb/ref 17592186045417] [17592186551297 #edb/ref 1068 #edb/ref 17592186551149 #edb/ref 17592186045417] [17592186551297 #edb/ref 1069 "q-167101" #edb/ref 17592186045417] [17592186551297 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186551297 #edb/ref 1071 "Find the $y$-intercept of $\\overset{↔}{AB},$ and express the equation of this line in slope-intercept form.\n\nThe $y$ - intercept of the line is $b\\,=\\,$\n{{field-1}}\n\nThe equation is $y\\,=\\,$\n{{field-2}}" #edb/ref 17592186045417] [17592186551297 #edb/ref 1072 #uuid "7f09f62f-f5bc-5004-8782-5f89d18c5383" #edb/ref 17592186045417] [17592186551297 #edb/ref 1074 "We will write the equation of the line in the slope-intercept form \n\n$$\ny=mx+b.\n$$\n\nAs we found previously, the slope is $m=-2.$\n\nSubstituting $m=-2$ into the slope-intercept form above, we get\n\n$$\ny=-2x+b.\n$$\n\nWe now need to find the $y$-intercept $b.$ We can find this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(4,-3):$\n\n$$\n\\begin{aligned}y & =-2x+b \\\\ -3 & =-2(4)+b \\\\ -3 & =-8+b \\\\ 5 & =b \\\\ b & =5\\end{aligned}\n$$\n\nTherefore, the equation of the line is \n\n$$\ny=-2x+5.\n$$" #edb/ref 17592186045417] [17592186551333 #edb/ref 1068 #edb/ref 17592186551145 #edb/ref 17592186045417] [17592186551333 #edb/ref 1069 "q-167106" #edb/ref 17592186045417] [17592186551333 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186551333 #edb/ref 1071 "Write the equation of the line that passes through the point $(10,3)$ and is perpendicular to $\\overset{↔}{AB}.$\n\nThe slope-intercept form of the equation is $y\\,=\\,$\n{{field-1}}" #edb/ref 17592186045417] [17592186551333 #edb/ref 1072 #uuid "c6760dcc-4403-5b3c-b44a-9e304dd2dc4f" #edb/ref 17592186045417] [17592186551333 #edb/ref 1074 "Perpendicular lines have slopes that are negative reciprocals of each other. Therefore, since $\\overset{↔}{AB}$ has the slope $m=-2,$ our perpendicular line must have a slope of \n\n$$\n{m}_{1}=-\\frac{1}{m}=-\\frac{1}{(-2)}=\\frac{1}{2}.\n$$\n\nSo, our perpendicular line has the slope ${m}_{1}=\\frac{1}{2}$ and passes through the point $({x}_{1},{y}_{1})=(10,3).$ \n\nFinally, using point-slope form and simplifying, we obtain the following equation:\n\n$$\n\\begin{aligned}y-{y}_{1} & ={m}_{1}(x-{x}_{1}) \\\\ y-3 & =\\frac{1}{2}(x-10) \\\\ y-3 & =\\frac{1}{2}x-5 \\\\ y & =\\frac{1}{2}x-2\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186551354 #edb/ref 1068 #edb/ref 17592186551079 #edb/ref 17592186045417] [17592186551354 #edb/ref 1068 #edb/ref 17592186551084 #edb/ref 17592186045417] [17592186551354 #edb/ref 1069 "q-167098" #edb/ref 17592186045417] [17592186551354 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186551354 #edb/ref 1071 "Write the equations of the vertical and horizontal lines that pass through the point $B.$\n\nThe **equation** of the vertical line is \n{{field-1}}\n\nThe **equation** of the horizontal line is \n{{field-2}}" #edb/ref 17592186045417] [17592186551354 #edb/ref 1072 #uuid "fc8a9725-c277-5a2e-a217-f21f271d6767" #edb/ref 17592186045417] [17592186551354 #edb/ref 1074 "The coordinates of $B$ are $(1,3).$\n\n* Since the vertical line should pass through $(1,3)$, the $x$-value for every point on the line is $1.$ Hence, the equation of that line is \n\n$$\nx=1.\n$$\n\n* Since the horizontal line should pass through $(1,3)$, the $y$-value for every point on the line is $3.$ Hence, the equation of that line is \n\n$$\ny=3.\n$$" #edb/ref 17592186045417] [17592186551378 #edb/ref 1058 #edb/ref 17592186551442 #edb/ref 17592186045417] [17592186551378 #edb/ref 1062 #uuid "2c8a856f-5da6-5572-88c5-cde44c333e98" #edb/ref 17592186045417] [17592186551378 #edb/ref 1063 #edb/ref 17592186551293 #edb/ref 17592186045417] [17592186551397 #edb/ref 1058 #edb/ref 17592186551468 #edb/ref 17592186045417] [17592186551397 #edb/ref 1062 #uuid "494f2d04-014d-5dbf-9ea0-9d3c98099132" #edb/ref 17592186045417] [17592186551397 #edb/ref 1063 #edb/ref 17592186551287 #edb/ref 17592186045417] [17592186551406 #edb/ref 1062 #uuid "60560f38-76bf-5533-943c-7f76b2b4b916" #edb/ref 17592186045417] [17592186551406 #edb/ref 1063 #edb/ref 17592186551231 #edb/ref 17592186045417] [17592186551413 #edb/ref 1058 #edb/ref 17592186551432 #edb/ref 17592186045417] [17592186551413 #edb/ref 1062 #uuid "7759f2fa-f496-5dd5-8aff-2653c3e9441a" #edb/ref 17592186045417] [17592186551413 #edb/ref 1063 #edb/ref 17592186551267 #edb/ref 17592186045417] [17592186551432 #edb/ref 1058 #edb/ref 17592186551458 #edb/ref 17592186045417] [17592186551432 #edb/ref 1062 #uuid "a2e163d1-dd5b-58d3-b361-e2807e494c9e" #edb/ref 17592186045417] [17592186551432 #edb/ref 1063 #edb/ref 17592186551354 #edb/ref 17592186045417] [17592186551442 #edb/ref 1058 #edb/ref 17592186551455 #edb/ref 17592186045417] [17592186551442 #edb/ref 1062 #uuid "b6a9945a-7c14-50db-b608-15ec87c24466" #edb/ref 17592186045417] [17592186551442 #edb/ref 1063 #edb/ref 17592186551297 #edb/ref 17592186045417] [17592186551453 #edb/ref 1058 #edb/ref 17592186551397 #edb/ref 17592186045417] [17592186551453 #edb/ref 1062 #uuid "d5db579b-2df0-58ee-8cdf-494999ac6603" #edb/ref 17592186045417] [17592186551453 #edb/ref 1063 #edb/ref 17592186551270 #edb/ref 17592186045417] [17592186551455 #edb/ref 1058 #edb/ref 17592186551453 #edb/ref 17592186045417] [17592186551455 #edb/