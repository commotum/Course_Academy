  & =\\sqrt{16+1} \\\\  & =\\sqrt{17}\\end{aligned}\n$$"} :step/id #uuid "055f6147-a057-5f62-8e99-02d25958931d" :step/next {:db/id #edb/ref 17592186535108}} {:db/id #edb/ref 17592186535108 :step/content {:db/id #edb/ref 17592186069299 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84f9576b-3c49-58d5-b0cf-3be799853487" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{27}" :db/id #edb/ref 17592186066965} {:answer/id #uuid "ed906fd7-c616-5b92-98ac-8e345f436178" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186066966} {:answer/id #uuid "fbe93849-2cb6-5c4b-92d9-24a564948aee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{7}" :db/id #edb/ref 17592186066967} {:answer/id #uuid "4adb34e7-c885-5b78-aaa4-9bed521b95d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186066968} {:answer/id #uuid "6dfd6889-eff1-5096-802f-6ddf0679ad20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{11}" :db/id #edb/ref 17592186066969}] :answer-field/correct {:db/id #edb/ref 17592186066968} :answer-field/id #uuid "b5f61f9a-7bb2-5f98-b5a6-d1d9290326b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186066964}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0e35e59e-36bb-5c2e-8441-bc45ce18079d" :question/math-academy-id "q-3702" :question/problem "What is the distance between the points $(-9,2)$ and $(-12,-4)?$" :question/worked-solution "In this case, we have ${{(-9,2)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(-12,-4)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$\nSo, the distance $d$ can be calculated using the distance formula, as follows:\n\n$$\n\\begin{aligned}d & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(-12-(-9))^{2}+(-4-2)^{2}} \\\\  & =\\sqrt{(-3)^{2}+(-6)^{2}} \\\\  & =\\sqrt{9+36} \\\\  & =\\sqrt{45} \\\\  & =3\\sqrt{5}\\end{aligned}\n$$"} :step/id #uuid "51636569-c0a8-5056-918a-d7101ba9f350" :step/next {:db/id #edb/ref 17592186535133}} {:db/id #edb/ref 17592186535133 :step/content {:db/id #edb/ref 17592186535030 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eec1ef8-9fdc-5230-9417-7755a8d0b87e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186534296} {:answer/id #uuid "0f8e6dec-43af-5f80-ab1e-3eef631db8bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186534300} {:answer/id #uuid "43e972e7-cf56-5b6c-b604-0698d249e7cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186534393} {:answer/id #uuid "9dda4d19-a039-5a94-a7cf-7a1838c89803" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{4}" :db/id #edb/ref 17592186534617} {:answer/id #uuid "e6e5abdb-b91e-58f8-a040-8654f0c602a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\sqrt{3}" :db/id #edb/ref 17592186534774}] :answer-field/correct {:db/id #edb/ref 17592186534296} :answer-field/id #uuid "50de03fc-f361-5d04-9b42-75d709112b35" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186534880}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7b6428c3-ddc3-50c7-8b44-d4c45bc81ecd" :question/math-academy-id "q-3720" :question/problem "![](images/6a/6a225129d0879af950e935d794c09f3b479434154757a643c29c44a9d9e981e2.png)\n\nWhat is the length of $\\overset{―}{DE}?$" :question/worked-solution "From the figure, we note that the points $D$ and $E$ have coordinates ${{(-4,0)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(0,3)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})},$  respectively.\n\nTo find the length of $\\overset{―}{DE},$ we use the distance formula:\n\n$$\n\\begin{aligned}DE & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(0-(-4))^{2}+(3-0)^{2}} \\\\  & =\\sqrt{(4)^{2}+(3)^{2}} \\\\  & =\\sqrt{16+9} \\\\  & =\\sqrt{25} \\\\  & =5\\end{aligned}\n$$"} :step/id #uuid "d14f69d9-fc47-5d93-94d4-48dc6fa8a3a8"}] :activity/title "The Distance Formula" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186534265}]}
