17592186176417} {:db/id #edb/ref 17592186176432} {:db/id #edb/ref 17592186238009} {:db/id #edb/ref 17592186290470} {:db/id #edb/ref 17592186290500} {:db/id #edb/ref 17592186290501} {:db/id #edb/ref 17592186290502} {:db/id #edb/ref 17592186292541} {:db/id #edb/ref 17592186341836} {:db/id #edb/ref 17592186481551} {:db/id #edb/ref 17592186481556} {:db/id #edb/ref 17592186481560}] :knowledge-point/title "Finding the Equation of a Line Perpendicular to a Line in Standard Form"} :step/id #uuid "54ebaf71-e1f2-548d-a8b8-baebf7d035a6" :step/math-academy-id 192126}] :activity/title "Finding Equations of Perpendicular Lines" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186176113}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186525078} :activity/id #uuid "dce5a6b1-8e80-58c8-af08-9ef023487bbb" :activity/scope {:db/id #edb/ref 17592186050473 :topic/id #uuid "4c6d2580-78c9-5782-9c3a-465dcd055b32" :topic/math-academy-id 3562} :activity/steps [{:db/id #edb/ref 17592186525078 :step/content {:db/id #edb/ref 17592186238009 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08fb0cd4-c595-52e2-b7b8-f5921f1664ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x+y=-4" :db/id #edb/ref 17592186235858} {:answer/id #uuid "339a3f8d-ec60-53c0-b70c-2ad1dcb8beef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-2y=-10" :db/id #edb/ref 17592186236143} {:answer/id #uuid "bf918fbb-8ce0-57e4-ba33-761c02c1700f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+2y=2" :db/id #edb/ref 17592186237036} {:answer/id #uuid "cd49d0d7-034b-5674-9bb1-76d06ca38e03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-2y=-6" :db/id #edb/ref 17592186237119} {:answer/id #uuid "f90a028f-fc8e-54be-b155-96319e83f2b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x+2y=-2" :db/id #edb/ref 17592186237390}] :answer-field/correct {:db/id #edb/ref 17592186237390} :answer-field/id #uuid "be8d6f01-6ff4-56d4-9645-4daf3987bc75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237683}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5c2cb582-f805-50f4-ae14-8678782b90fa" :question/math-academy-id "q-103449" :question/problem "Find the equation of the line that passes through the point $(-2,2)$ and is perpendicular to the line passing through the points $(1,-1)$ and $(4,1).$" :question/worked-solution "Perpendicular lines have slopes which are negative reciprocals of each other.\n\nFirst, let's find the slope ${m}_{1}$ of the line passing through the points $(1,-1)$ and $(4,1):$\n\n$$\n\\begin{aligned}{m}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{1-(-1)}{4-1} \\\\  & =\\frac{1+1}{4-1} \\\\  & =\\frac{2}{3}\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm\\cdot (\\frac{2}{3})=-1\\,⇒\\,m=-\\frac{3}{2}.\n$$\n\nWe know that the line passes through the point $(-2,2).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-2 & =-\\frac{3}{2}(x-(-2)) \\\\ y-2 & =-\\frac{3}{2}(x+2) \\\\ y-2 & =-\\frac{3}{2}x-3 \\\\ y & =-\\frac{3}{2}x-1\\end{aligned}\n$$\n\nHowever, we want to write the equation in standard form. So, we will bring the $x$ term to the left-hand side and multiply both sides of the equation by $2:$\n\n$$\n\\begin{aligned}y & =-\\frac{3}{2}x-1 \\\\ \\frac{3}{2}x+y & =-1 \\\\ 2\\cdot (\\frac{3}{2}x+y) & =2\\cdot (-1) \\\\ 3x+2y & =-2\\end{aligned}\n$$"} :step/id #uuid "1eab4d5a-96a8-544b-91f1-6e63e881567a" :step/next {:db/id #edb/ref 17592186525114}} {:db/id #edb/ref 17592186525114 :step/content {:db/id #edb/ref 17592186176417 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ccac27b1-4d1c-5479-8665-d033a45d1913" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-8" :db/id #edb/ref 17592186524721}] :answer-field/correct {:db/id #edb/ref 17592186524721} :answer-field/id #uuid "c97302ea-f8e7-5c70-95e0-5cc0b820ce24" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186174740}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a0a733e1-bbed-5414-830d-e413ae5ce0e3" :question/math-academy-id "q-214033" :question/problem "What is the equation of the line that passes through the point $(1,-5)$ and is perpendicular to $x+3y=12?$\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we write the equation $x+3y=12$ in its slope-intercept form, as follows:\n\n$$\n\\begin{aligned}x+3y & =12 \\\\ 3y & =-x+12 \\\\ y & =-\\frac{1}{3}x+4\\end{aligned}\n$$\n\nSince perpendicular lines have slopes that are negative reciprocals of each other, the slope of the new line should be the negative reciprocal of the slope of the given line $y=-\\frac{1}{3}x+4.$ The given line has a slope of $-\\frac{1}{3},$ so our perpendicular line must have a slope of $3.$\n\nOur perpendicular line must have the slope $m=3$ and pass through the point $({x}_{1},{y}_{1})=(1,-5).$ Using point-slope form and simplifying, we obtain the equation of the line in slope-intercept form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-5) & =3(x-1) \\\\ y+5 & =3x-3 \\\\ y & =3x-8\\end{aligned}\n$$"} :step/id #uuid "91ab80b6-9654-58b5-aeba-94ac364e8346" :step/next {:db/id #edb/ref 17592186525147}} {:db/id #edb/ref 17592186525147 :step/content {:db/id #edb/ref 17592186525046 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cba90753-0239-53f3-8288-4708dc4bd2d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6x+23" :db/id #edb/ref 17592186524719}] :answer-field/correct {:db/id #edb/ref 17592186524719} :answer-field/id #uuid "618796c9-d723-5e11-9f71-2d4878c12e36" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186524880}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d79473d6-bc2e-50df-aa4f-f2c7866c75c4" :question/math-academy-id "q-237034" :question/problem "Find the equation of the line that passes through the point $(4,-1)$ and is perpendicular to the line passing through the points $(2,3)$ and $(-4,2).$\n\n$y=$\n{{field-1}}" :question/worked-solution "Perpendicular lines have slopes that are negative reciprocals of each other.\n\nFirst, let's find the slope ${m}_{1}$ of the line passing through the points $(2,3)$ and $(-4,2):$\n\n$$\n\\begin{aligned}{m}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{2-3}{-4-2} \\\\  & =\\frac{(-1)}{(-6)} \\\\  & =\\frac{1}{6}\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm\\cdot (\\frac{1}{6})=-1\\,⇒\\,m=-6.\n$$\n\nWe know that the line passes through the point $(4,-1).$ Using point-slope form and simplifying, we obtain the equation of the line in slope-intercept form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-1) & =-6(x-4) \\\\ y+1 & =-6x+24 \\\\ y & =-6x+23\\end{aligned}\n$$"} :step/id #uuid "f8031d83-20ce-5562-9e78-310af75e7f3b"}] :activity/title "Finding Equations of Perpendicular Lines" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186524373}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055836} :activity/id #uuid "c871a154-cf68-51db-83a7-946dca52e14d" :activity/scope {:db/id #edb/ref 17592186050517 :topic/id #uuid "50123c1c-7113-541e-8c4f-047f2eec416d" :topic/math-academy-id 92} :activity/steps [{:db/id #edb/ref 17592186055836 :step/content {:db/id #edb/ref 17592186055942 :tutorial/content "The **Cartesian coordinate system** (or **Cartesian plane**) is a grid that we can use to understand where certain objects lie, similar to a map. This grid looks as follows:\n\n![](images/fd/fd702a53ff1127a2432cbdd9a3c7057a08c73ac7a086454c066fa2c96bea7974.png)\n\nIt consists of a horizontal number line called the **$x$-axis** and a vertical number line called the **$y$-axis**.\n\nThe **origin** is the location where the $x$ and $y$ axes meet and is given the symbol $O.$" :tutorial/id #uuid "dacc8373-6186-517b-bba8-ec1729732e4d" :tutorial/math-academy-id 1431 :tutorial/title "Introduction"} :step/id #uuid "5cca38c5-c625-5a28-92d3-ccdcc09f108d" :step/math-academy-id 607419 :step/next {:db/id #edb/ref 17592186055837}} {:db/id #edb/ref 17592186055837 :step/content {:db/id #edb/ref 17592186055943 :tutorial/content "Every location on the Cartesian plane is called a **point**. Every point is identified using an $x$**-coordinate** and a $y$**-coordinate**. Together, points are expressed using an **ordered pair** of **coordinates** $(x,y).$\n\nFor example, we can mark (or **plot**) the point $A$ with coordinates $({\\color{red}{3}},{\\color{blue}{2}})$ by starting from $O$ and then traveling $\\color{red}3$ units towards the right, followed $\\color{blue}2$ units up.\n\n![](images/c1/c1ef61dedbbcc6eedcd125c2c62cdfbaa4d9b9a12f10181714b51c060a059fd3.png)\n\nWe say that\n\n- the $x$-coordinate of $A$ is $3$,\n\n- the $y$-coordinate of $A$ is $2$,\n\n- the $xy$-coordinates (or just \"the coordinates\") of $A$ are $(3,2).$\n\nThe letter $A$ is just a label for our point. It's usually a good idea to label points!" :tutorial/id #uuid "9e7847c5-757a-5cb8-b947-9c7d806b5dc5" :tutorial/math-academy-id 1432 :tutorial/title "Coordinates and Ordered Pairs"} :step/id #uuid "b81ec1ae-2147-51bf-abd0-42837ec9335a" :step/math-academy-id 607420 :step/next {:db/id #edb/ref 17592186055838}} {:db/id #edb/ref 17592186055838 :step/content {:db/id #edb/ref 17592186055957 :tutorial/content "Remember that a coordinate plane is made by two number lines that meet at $0.$ Since these are number lines, we can extend both to include negative numbers.\n\n![](images/f1/f1eeb7f3bc0ab8b39e9dc7127d76a32f1dd130d380748fedc6e11b967f3878ed.png)\n\nWe plot an ordered pair $({\\color{red}x},{\\color{blue}y})$ similar to before, but if the number is negative, we reverse the direction. So, starting at the origin:\n\n- if the first number is positive, move that number of places *right* along the $\\color{red}x$-axis. If its negative, move *left*.\n\n- if the second number is positive, move that number of places *up* along the $\\color{blue}y$-axis. If its negative, move *down*.\n\nTo demonstrate, let's find the coordinates of the point $Q$ above.\n\nTo find the coordinates of $Q,$ we start at the origin, move $\\color{red}3$ units *left*, and then $\\color{blue}2$ units *down*. \n\n![](images/b4/b4f58f0c1ad6dc2936ed1b24c844fa82c1b1d5ec10c80e14c6a43f6f4eaf5544.png)\n\nSince we move left, the $\\color{red}x$-coordinate is negative, and since we move down, the $\\color{blue}y$-coordinate is negative.\n\nTherefore, the coordinates of $Q$ are $({\\color{red}{-3}},{\\color{blue}{-2}}).$" :tutorial/id #uuid "7383452c-9470-5f05-b206-dffbb84808dd" :tutorial/math-academy-id 2092 :tutorial/title "Extending the Coordinate Plane to Negative Numbers"} :step/id #uuid "a86683d5-cc60-54e3-a1ca-8ddc210beec5" :step/math-academy-id 607421 :step/next {:db/id #edb/ref 17592186055839}} {:db/id #edb/ref 17592186055839 :step/content {:db/id #edb/ref 17592186054806 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054511 :question/id #uuid "e4658959-f2fb-5bb4-ad05-d75b7c74a5d5" :question/math-academy-id "e-2372"} :knowledge-point/id #uuid "f41c2f3b-9b55-5f32-bb0a-a8397cdf66ce" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049429} {:db/id #edb/ref 17592186049884} {:db/id #edb/ref 17592186050618}] :knowledge-point/questions [{:db/id #edb/ref 17592186055434} {:db/id #edb/ref 17592186055439} {:db/id #edb/ref 17592186426965} {:db/id #edb/ref 17592186426966} {:db/id #edb/ref 17592186426971} {:db/id #edb/ref 17592186426978}] :knowledge-point/title "Determining the X- or Y-Coordinate of a Point in the Coordinate Plane"} :step/id #uuid "708e4952-07a2-52aa-83ee-e86a33ffcc1d" :step/math-academy-id 607422 :step/next {:db/id #edb/ref 17592186055840}} {:db/id #edb/ref 17592186055840 :step/content {:db/id #edb/ref 17592186054807 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054598 :question/id #uuid "bda7aaff-f03f-53bd-b114-d28a46599641" :question/math-academy-id "e-975"} :knowledge-point/id #uuid "b509b42a-c38a-5400-8f93-f3e9024b16a2" :knowledge-point/questions [{:db/id #edb/ref 17592186055411} {:db/id #edb/ref 17592186055435} {:db/id #edb/ref 17592186235487} {:db/id #edb/ref 17592186426968} {:db/id #edb/ref 17592186426970} {:db/id #edb/ref 17592186426973} {:db/id #edb/ref 17592186426976} {:db/id #edb/ref 17592186426977} {:db/id #edb/ref 17592186486370} {:db/id #edb/ref 17592186486437} {:db/id #edb/ref 17592186510413} {:db/id #edb/ref 17592186521514} {:db/id #edb/ref 17592186523959} {:db/id #edb/ref 17592186551267}] :knowledge-point/title "Identifying the Coordinates of a Point"} :step/id #uuid "b4fa400d-ccbf-5b93-8bb2-f08b681dc5d0" :step/math-academy-id 607425 :step/next {:db/id #edb/ref 17592186055841}} {:db/id #edb/ref 17592186055841 :step/content {:db/id #edb/ref 17592186054808 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054597 :question/id #uuid "f610b8b9-8e9e-5a64-bc52-c1f939a0f147" :question/math-academy-id "e-974"} :knowledge-point/id #uuid "e5418e0e-fff7-5d08-b915-6e87be27a132" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049429} {:db/id #edb/ref 17592186049884} {:db/id #edb/ref 17592186050618}] :knowledge-point/questions [{:db/id #edb/ref 17592186055120} {:db/id #edb/ref 17592186055436} {:db/id #edb/ref 17592186426969} {:db/id #edb/ref 17592186426972} {:db/id #edb/ref 17592186426979} {:db/id #edb/ref 17592186426980} {:db/id #edb/ref 17592186486380} {:db/id #edb/ref 17592186515549} {:db/id #edb/ref 17592186518189}] :knowledge-point/title "Plotting a Point in the Coordinate Plane"} :step/id #uuid "b5dc0ae8-3ca8-53a2-a100-962fd53b4781" :step/math-academy-id 607428 :step/next {:db/id #edb/ref 17592186055842}} {:db/id #edb/ref 17592186055842 :step/content {:db/id #edb/ref 17592186055958 :tutorial/content "The axes split the coordinate plane into four parts, called **quadrants**.\n\n![](images/93/938125e855fcb96f743c01f2a00d289ef13e0601772bab56cf0f255e9adf4dcd.png)\n\nGoing counter-clockwise, it's common to call\n\n- the top-right quadrant the first quadrant (I),\n\n- the top-left is the second quadrant (II),\n\n- the bottom-left is the third quadrant (III),\n\n- and and bottom-right is the fourth quadrant (IV).\n\nTo remember the order of the quadrants, it's helpful to think about writing the letter \"C\" in the graph:\n\n![](images/1e/1ef91f2bc25ea8b887ec449d2dafe2eaf6a157733e7bc50e4480280df8190728.png)" :tutorial/id #uuid "8a1e27dd-9f87-5adf-b0c6-f0f6cd7e2aac" :tutorial/math-academy-id 2097 :tutorial/title "Quadrants in the Coordinate Plane"} :step/id #uuid "3caa8c6c-0602-56f3-a037-3db5c98ff22b" :step/math-academy-id 607431 :step/next {:db/id #edb/ref 17592186055843}} {:db/id #edb/ref 17592186055843 :step/content {:db/id #edb/ref 17592186054809 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054599 :question/id #uuid "419738bb-56e5-52db-aa34-42ccd945fe64" :question/math-academy-id "e-977"} :knowledge-point/id #uuid "7fcec0d8-ca03-5446-a42f-65d0ccddd584" :knowledge-point/questions [{:db/id #edb/ref 17592186055278} {:db/id #edb/ref 17592186055437} {:db/id #edb/ref 17592186424815} {:db/id #edb/ref 17592186426967} {:db/id #edb/ref 17592186426974} {:db/id #edb/ref 17592186426975} {:db/id #edb/ref 17592186426981} {:db/id #edb/ref 17592186486375} {:db/id #edb/ref 17592186523979}] :knowledge-point/title "Identifying the Quadrant of a Given Point"} :step/id #uuid "e7a9127a-071f-5089-a135-f41568b6862d" :step/math-academy-id 607432}] :activity/title "The Cartesian Coordinate System" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054933}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186486467} :activity/id #uuid "2ee8e36f-d6f2-535a-b7e8-f2094eda05e2" :activity/scope {:db/id #edb/ref 17592186050517 :topic/id #uuid "50123c1c-7113-541e-8c4f-047f2eec416d" :topic/math-academy-id 92} :activity/steps [{:db/id #edb/ref 17592186486467 :step/content {:db/id #edb/ref 17592186486370 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e2f253f-f36a-560f-9ec1-161de7ca2936" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-3,-6)" :db/id #edb/ref 17592186485790} {:answer/id #uuid "5b907c20-fdab-5148-9850-5b4dac59cbfc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,6)" :db/id #edb/ref 17592186485926} {:answer/id #uuid "8ea93a26-50f7-53a6-b9a0-fc301c2fc49b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(5,-6)" :db/id #edb/ref 17592186486020} {:answer/id #uuid "bf3c4744-55c7-5126-a9e5-deeb937ce8ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,-6)" :db/id #edb/ref 17592186486108} {:answer/id #uuid "fc37df37-6bf2-589e-b9c3-27692a226298" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,-6)" :db/id #edb/ref 17592186486222}] :answer-field/correct {:db/id #edb/ref 17592186486222} :answer-field/id #uuid "6156ddb1-eb69-58fb-ade4-f35c95453cbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486277}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "33922fa7-9cd5-5240-b5a7-6b856c2f3900" :question/math-academy-id "q-12475" :question/problem "![](images/a3/a3e52270e83d29fe4d53f1429a6648c6ef2451ae5ad5b3d48dd0d1a0f3450df4.png)\n\nWhat are the $xy$-coordinates of the point shown in the axes above?" :question/worked-solution "To find the coordinates of the point, we inspect its position along the $x$ and $y$ axes.\n\nThe point is $3$ units to the right of the origin, in the positive direction of the $x$-axis. So, the point has an $x$-coordinate of $3.$\n\nAdditionally, the point is $6$ units *below* the origin, in the *negative* direction of the $y$-axis. So, the point has a $y$-coordinate of $-6.$\n\nThe point has an $x$-coordinate of $3$ and a $y$-coordinate of $-6,$ so its coordinates are $(3,-6).$"} :step/id #uuid "146a565d-dffc-5e6c-b79e-319aeeb7bc4d" :step/next {:db/id #edb/ref 17592186486486}} {:db/id #edb/ref 17592186486475 :step/content {:db/id #edb/ref 17592186486437 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "649b626b-4386-5c00-bdcf-5dd4938d9112" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,1)" :db/id #edb/ref 17592186485937} {:answer/id #uuid "80ab4c5e-aff9-5dde-a021-093b6b9ddbd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-4,1)" :db/id #edb/ref 17592186485991} {:answer/id #uuid "a9b54552-5965-5854-ba07-c60932f774a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,4)" :db/id #edb/ref 17592186486071} {:answer/id #uuid "c5fcd194-a407-59cf-ae7a-2e21427fcdca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,4)" :db/id #edb/ref 17592186486120} {:answer/id #uuid "dfb98379-8815-506f-a548-b96dd7aea567" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,-4)" :db/id #edb/ref 17592186486174}] :answer-field/correct {:db/id #edb/ref 17592186486071} :answer-field/id #uuid "d0b079f8-570c-5a56-a881-00ac494144c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486321}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c5cd4da4-bcde-5c76-b987-99fb9414b223" :question/math-academy-id "q-93510" :question/problem "![](images/53/53e86e59af40ecd611ad1f7753f4780b692f17afc5a81709ea1c249a0bf011d5.png)\n\nWhat are the coordinates of the point $A?$" :question/worked-solution "To find the coordinates of the point $A,$ we start at the origin, move $1$ unit *left* and then $4$ units *up*. \n\n![](images/14/147aa8c644b24f82abadbbb9362ed51718bf94da992c83d016c72a1898032f0f.png)\n\nThe $x$-coordinate of $A$ is $-1,$ the $y$-coordinate is $4,$ and coordinates are given by the ordered pair $(-1,4).$"} :step/id #uuid "3f07956a-6431-5516-8d25-2cc6c4d55a33"} {:db/id #edb/ref 17592186486486 :step/content {:db/id #edb/ref 17592186486375 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17d8031f-5e2f-5683-84c6-7fe7232955e3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "All" :db/id #edb/ref 17592186485807} {:answer/id #uuid "19d86bf2-74f3-5d7b-a43c-1012785c8707" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186485812} {:answer/id #uuid "41bd2118-a5bb-5da1-8bdd-da8970f09208" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186485890} {:answer/id #uuid "79aeb305-a976-5e19-9df6-af6e17665886" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186485978} {:answer/id #uuid "7dae032f-a2cf-5841-bfb4-ef99e0c6b32f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186485985}] :answer-field/correct {:db/id #edb/ref 17592186485985} :answer-field/id #uuid "db8b3ac8-d583-5e07-b501-9df170f999c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486331}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3b6bba67-98a0-5af4-b6c0-e0b46329b1b5" :question/math-academy-id "q-61365" :question/problem "![](images/6c/6c55183a2999276882036eb3bc54a94f9d7356a58eb7b3d3e1ec7708def1de4f.png)\n\nWhich of the following is true regarding the point $C?$\n\nI. It is in the first quadrant\n\nII. Its $x$-coordinate is $3$\n\nIII. Its $y$-coordinate is $-2$" :question/worked-solution "The point $C$ is in the fourth quadrant, so statement I is false.\n\nTo find the coordinates of the point $C,$ we start at the origin, move $3$ units *right* and then $2$ units *down*. \n\n![](images/98/98c5cd8e245651f99a29c37b6d63122fa7766eed80c64ab6870e05192742dab1.png)\n\nThe coordinates of $C$ are $(3,-2).$ Hence, statements II and III are true."} :step/id #uuid "6a26e169-b937-5d4e-9132-efccf14ec7c7" :step/next {:db/id #edb/ref 17592186486514}} {:db/id #edb/ref 17592186486514 :step/content {:db/id #edb/ref 17592186486380 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2379ed4e-1bad-561c-bd91-f529f4ce1c13" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e8/e8b3ac34b4fe6c877d606d8ddde5f29c9856cc4bdc5ac14e3ffcf5ddccdc0ebb.png" :db/id #edb/ref 17592186485825} {:answer/id #uuid "2a8a49a4-67ee-5dd6-8034-f08b8abe1465" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/79/794cbedc72a4ad51263737802b419bb024f250f67d3a6a8464f3c9b6d61aa194.png" :db/id #edb/ref 17592186485840} {:answer/id #uuid "3f7f4dc2-51a6-57b2-a348-9bb680d817c3" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/5a/5a9caae32c4a20a6646689ceeb16622dbc1982d150988b8b393868e3dab3ac0f.png" :db/id #edb/ref 17592186485885} {:answer/id #uuid "a75b6401-ac5e-5996-87c4-190b7e47c998" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/14/146f5c3b0672a81347edb9d56cfe840ca6acc023444d110584649bf90d741ae6.png" :db/id #edb/ref 17592186486068} {:answer/id #uuid "f9270677-c75b-5726-992c-0684189ac5e6" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/4b/4ba1b8ea826f2d1a095982b03b58c4e75c711dbad168493a6a0d784064e06a74.png" :db/id #edb/ref 17592186486215}] :answer-field/correct {:db/id #edb/ref 17592186486215} :answer-field/id #uuid "3cc8f23d-893d-5af7-ae5b-7ea465b5f2d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486262}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4a14d943-4b53-5214-a1e8-29e07a0ea11f" :question/math-academy-id "q-71670" :question/problem "Which of the following shows the point $A(-2,3)?$" :question/worked-solution "Starting at the origin, we move along the $x$ and $y$ axes to get to the point $A.$\n\nFirst, we move along the $x$-axis. The point $A$ has an $x$-coordinate of $-2,$ so we move $2$ units to the *left*, in the *negative* direction of the $x$-axis.\n\nThen, we move along the $y$-axis. The point $A$ has a $y$-coordinate of $3,$ so we move $3$ units *up*, in the *positive* direction of the $y$-axis.\n\n![](images/4b/4ba1b8ea826f2d1a095982b03b58c4e75c711dbad168493a6a0d784064e06a74.png)"} :step/id #uuid "dd35957b-3e1a-5f26-ae0e-89d442576bd2" :step/next {:db/id #edb/ref 17592186486475}}] :activity/title "The Cartesian Coordinate System" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186485752}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055621} :activity/id #uuid "4fd2aaf3-6b86-52c0-bd25-cdccd740e574" :activity/scope {:db/id #edb/ref 17592186050763 :topic/id #uuid "64c4dbd5-509e-506d-ad70-5a35f835770e" :topic/math-academy-id 97} :activity/steps [{:db/id #edb/ref 17592186055621 :step/content {:db/id #edb/ref 17592186056014 :tutorial/content "Suppose that we wish to find the equation of the **horizontal line** that passes through the point $(0,3)$, as shown below:\n\n![](images/37/379af2ba930fa537f1fbdda5b4b5cc91e355a46e90918cdc56bbce66f3502d7b.png)\n\nNotice that for *any* $x$-value on the line, the $y$-value is always $\\color{red}3.$ \n\n![](images/ff/ff5ec246a558fc981ba5f0b0085ce3663ac6ab837121f31a5d44de6adb91cb90.png)\n\nTherefore, the equation of the line is $y=3.$\n\n**Note**: When writing the equation of a horizontal line, we always put the variable $y$ on the left side and the constant on the right side." :tutorial/id #uuid "8d036bf9-1cb2-59e4-a418-b586ec35d56e" :tutorial/math-academy-id 8070 :tutorial/title "Introduction"} :step/id #uuid "4925b445-d5c7-5a6b-a5f1-da050fb02303" :step/math-academy-id 191798 :step/next {:db/id #edb/ref 17592186055622}} {:db/id #edb/ref 17592186055622 :step/content {:db/id #edb/ref 17592186054666 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054390 :question/id #uuid "ff34ddfb-7ea8-505a-8a4f-7898d7f5c3c0" :question/math-academy-id "e-12902"} :knowledge-point/id #uuid "b57ffad1-b83f-5ebb-b0fe-928566ffe8b6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050517} {:db/id #edb/ref 17592186050790}] :knowledge-point/questions [{:db/id #edb/ref 17592186055063} {:db/id #edb/ref 17592186055423} {:db/id #edb/ref 17592186490260} {:db/id #edb/ref 17592186490295} {:db/id #edb/ref 17592186490307}] :knowledge-point/title "Finding the Equation of a Horizontal Line"} :step/id #uuid "2922d040-74f4-5896-83b7-35b38603c224" :step/math-academy-id 191799 :step/next {:db/id #edb/ref 17592186055623}} {:db/id #edb/ref 17592186055623 :step/content {:db/id #edb/ref 17592186056015 :tutorial/content "Suppose that we want to find the equation of the **vertical line** that passes through the point $(-4,0)$, as shown below:\n\n![](images/06/065dfc149c1624bbe2c6fd51085c48b5e60c1d37d248d073dd1374d08e65b5af.png)\n\nNotice that for *any* $y$-value on the line, the $x$-value is always $\\color{red}-4.$ \n\n![](images/01/01d24274cc3d2b5a7899cc1aa8cee4aef4fb02ddb45acd27629a57d6af41a398.png)\n\nTherefore, the equation of this vertical line is $x=-4.$\n\n**Note**: When writing the equation of a vertical line, we always put the variable $x$ on the left side and the constant on the right side." :tutorial/id #uuid "fcdbdf94-22ce-5781-9f56-42dc93763172" :tutorial/math-academy-id 8071 :tutorial/title "Vertical Lines"} :step/id #uuid "3e8762cd-7d9e-50f2-bb1b-c07fd53a30c1" :step/math-academy-id 191802 :step/next {:db/id #edb/ref 17592186055624}} {:db/id #edb/ref 17592186055624 :step/content {:db/id #edb/ref 17592186054667 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054491 :question/id #uuid "fa11d81b-2154-584a-9fd0-ce4399fd3a93" :question/math-academy-id "e-15644"} :knowledge-point/id #uuid "1f626489-1967-542a-8782-35596cffc7a4" :knowledge-point/questions [{:db/id #edb/ref 17592186055045} {:db/id #edb/ref 17592186055424} {:db/id #edb/ref 17592186490306} {:db/id #edb/ref 17592186490308}] :knowledge-point/title "Finding the Equation of a Vertical Line"} :step/id #uuid "95b8d112-1200-5651-b046-ddd819995d89" :step/math-academy-id 191803 :step/next {:db/id #edb/ref 17592186055625}} {:db/id #edb/ref 17592186055625 :step/content {:db/id #edb/ref 17592186054668 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054391 :question/id #uuid "1af37b2d-2400-5e55-b7b6-6d9652204f4c" :question/math-academy-id "e-12903"} :knowledge-point/id #uuid "9b84d144-1a2b-5007-817e-20a5d6446515" :knowledge-point/questions [{:db/id #edb/ref 17592186055129} {:db/id #edb/ref 17592186055428} {:db/id #edb/ref 17592186490250} {:db/id #edb/ref 17592186490253} {:db/id #edb/ref 17592186551249}] :knowledge-point/title "Identifying a Horizontal or Vertical Line"} :step/id #uuid "f599f285-d643-5707-ac7a-89a8993f9002" :step/math-academy-id 191806 :step/next {:db/id #edb/ref 17592186055626}} {:db/id #edb/ref 17592186055626 :step/content {:db/id #edb/ref 17592186054669 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054392 :question/id #uuid "03ebd3ab-aa4d-5bf4-9079-62cde6da307d" :question/math-academy-id "e-12904"} :knowledge-point/id #uuid "bf635847-145c-5da5-927e-8196e809324e" :knowledge-point/questions [{:db/id #edb/ref 17592186055054} {:db/id #edb/ref 17592186055068} {:db/id #edb/ref 17592186055292} {:db/id #edb/ref 17592186235488} {:db/id #edb/ref 17592186490251} {:db/id #edb/ref 17592186490265} {:db/id #edb/ref 17592186523961} {:db/id #edb/ref 17592186551354}] :knowledge-point/title "Points Associated With Horizontal and Vertical Lines"} :step/id #uuid "30da6f5a-53a7-5a1c-9b14-200b76e84b56" :step/math-academy-id 191809}] :activity/title "Horizontal and Vertical Lines" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054937}] [{:activity/first-step {:db/id #edb/ref 17592186069609} :activity/id #uuid "8ab5b031-09a4-5e75-b365-2c7486f2168f" :activity/scope {:db/id #edb/ref 17592186050975 :topic/id #uuid "7697398d-61ca-52dc-8fab-4d569b573455" :topic/math-academy-id 459} :activity/steps [{:db/id #edb/ref 17592186069609 :step/content {:db/id #edb/ref 17592186070033 :tutorial/content "To find the distance between two points on the Cartesian plane, we can create a right triangle and use the Pythagorean theorem.\n\nTo demonstrate, consider the points $(2, 3)$ and $(5, 7)$, shown in the diagram below. We draw a right triangle so that the segment between the two points is the hypotenuse.\n\n![](images/3d/3d3629fbd659ebfb6d32080feeb64bd2ebdd3fb63e9826970d64aa41a00b9a56.png)\n\nWe can find the distance between the points by finding the length of the hypotenuse $d$ using the Pythagorean theorem in the form\n\n$$\nd = \\sqrt{a^2 + b^2}\n$$\n\nFrom this perspective:\n\n- $a$ is the distance between the $x$-coordinates.\n$a|= x_{2} - x_{1}; = 5 - 2; = 3$\n- $b$ is the distance between the $y$-coordinates.\n$b|= y_{2} - y_{1}; = 7 - 3; = 4$\n\nSo the distance between the points $(2, 3)$ and $(5, 7)$ is given by\n\n$$\n\\begin{aligned} d &= \\sqrt{3^2 + 4^2} \\\\[3pt] &= \\sqrt{9 + 16} \\\\[3pt] &= \\sqrt{25} \\\\[3pt] &= 5. \\end{aligned}\n$$\n\nIn general, the distance $d$ between any two points in the Cartesian plane is given by the **distance formula**:\n\n$$\nd = \\sqrt{(x_2 - x_1)^2 + (y_2 - y_1)^2}\n$$" :tutorial/id #uuid "e9d89e3c-10fa-540c-bc9f-221d84f3a839" :tutorial/math-academy-id 9120 :tutorial/title "Introduction"} :step/id #uuid "8fd761d6-3af8-51f6-824f-a972e67c1b97" :step/math-academy-id 147701 :step/next {:db/id #edb/ref 17592186069610}} {:db/id #edb/ref 17592186069610 :step/content {:db/id #edb/ref 17592186068720 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068508 :question/id #uuid "ca739248-c388-531e-ba5f-7f9cce2aa70b" :question/math-academy-id "e-14706"} :knowledge-point/id #uuid "5df52cb5-75b1-58d9-8535-07c1bb87be34" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049224} {:db/id #edb/ref 17592186049923}] :knowledge-point/questions [{:db/id #edb/ref 17592186069125} {:db/id #edb/ref 17592186069298} {:db/id #edb/ref 17592186069301} {:db/id #edb/ref 17592186233259} {:db/id #edb/ref 17592186233635} {:db/id #edb/ref 17592186235489} {:db/id #edb/ref 17592186523930} {:db/id #edb/ref 17592186523953} {:db/id #edb/ref 17592186535030} {:db/id #edb/ref 17592186551263}] :knowledge-point/title "Determining the Length of a Segment"} :step/id #uuid "0b810045-0fb8-56a2-8dbc-c8ee53eec31b" :step/math-academy-id 147702 :step/next {:db/id #edb/ref 17592186069611}} {:db/id #edb/ref 17592186069611 :step/content {:db/id #edb/ref 17592186068721 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068509 :question/id #uuid "303019d6-7004-5de8-92e3-1119d4829ca8" :question/math-academy-id "e-14707"} :knowledge-point/id #uuid "bdded031-fd95-5a7f-92d4-c0d6713ba64d" :knowledge-point/questions [{:db/id #edb/ref 17592186069126} {:db/id #edb/ref 17592186069136} {:db/id #edb/ref 17592186069299} {:db/id #edb/ref 17592186233458} {:db/id #edb/ref 17592186234007} {:db/id #edb/ref 17592186234145} {:db/id #edb/ref 17592186523992}] :knowledge-point/title "Calculating the Distance Between Two Points"} :step/id #uuid "64a5b83b-0cea-5df2-83c0-47ab8dcad671" :step/math-academy-id 147706}] :activity/title "The Distance Formula" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068986}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186524049} :activity/id #uuid "04dd10aa-617a-57e9-9def-004b4d0d2ea1" :activity/scope {:db/id #edb/ref 17592186050975 :topic/id #uuid "7697398d-61ca-52dc-8fab-4d569b573455" :topic/math-academy-id 459} :activity/steps [{:db/id #edb/ref 17592186524049 :step/content {:db/id #edb/ref 17592186069301 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88eabd55-766f-573b-8305-9db9fb46fea2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186066977} {:answer/id #uuid "b827aac1-596d-54de-9317-02f420f5b264" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186066978} {:answer/id #uuid "dc9efbb1-7d26-572a-8d2c-c509a6d4a218" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\sqrt{13}" :db/id #edb/ref 17592186066979} {:answer/id #uuid "f4a39913-c29c-5674-8ad9-5afeccfbe7b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\sqrt{3}" :db/id #edb/ref 17592186066980} {:answer/id #uuid "4e1c13fe-164d-597b-9a55-f85afdd238b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{65}" :db/id #edb/ref 17592186066981}] :answer-field/correct {:db/id #edb/ref 17592186066981} :answer-field/id #uuid "3f04668a-3df1-560e-950f-53985118bf87" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186066976}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "94652e83-5bd0-5884-9087-2e26389b0cf2" :question/math-academy-id "q-3717" :question/problem "![](images/cd/cd878559d6be37faa60bdb33cbebe2f124d09744aa4df7dae40372499116f239.png)\n\nWhat is the length of $\\overset{―}{CD}?$" :question/worked-solution "From the figure, we note that the points $C$ and $D$ have coordinates ${{(-5,3)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(2,-1)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})},$ respectively.\n\nTo find the length of $\\overset{―}{CD},$ we use the distance formula:\n\n$$\n\\begin{aligned}CD & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(2-(-5))^{2}+(-1-3)^{2}} \\\\  & =\\sqrt{(7)^{2}+(-4)^{2}} \\\\  & =\\sqrt{49+16} \\\\  & =\\sqrt{65}\\end{aligned}\n$$"} :step/id #uuid "31a02459-846b-594d-a08e-bf91b9b551fd" :step/next {:db/id #edb/ref 17592186524050}} {:db/id #edb/ref 17592186524050 :step/content {:db/id #edb/ref 17592186523992 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c855929-b300-53bb-b2f5-24705e47b13c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\sqrt{5}" :db/id #edb/ref 17592186523443} {:answer/id #uuid "6221fb69-119d-504d-b579-13f039a770b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{65}" :db/id #edb/ref 17592186523452} {:answer/id #uuid "7c2e9f91-d463-5286-9ed4-c97a3b93b2bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186523513} {:answer/id #uuid "c60b17ee-f26e-5eec-9f8d-f02e776c1ea8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186523671} {:answer/id #uuid "ebbeab2f-2e72-502f-8588-62b91c0340f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186523747}] :answer-field/correct {:db/id #edb/ref 17592186523747} :answer-field/id #uuid "8db667e4-c6ff-50ef-bf4d-33616aab5cf2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186523862}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9dd278e6-83f6-5c4b-b1f1-6a6ae9e2e467" :question/math-academy-id "q-119011" :question/problem "What is the distance between the points $(-4\\sqrt{5},-2\\sqrt{5})$ and $(\\sqrt{5},-12\\sqrt{5})?$" :question/worked-solution "In this case, we have ${{(-4\\sqrt{5},-2\\sqrt{5})}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(\\sqrt{5},-12\\sqrt{5})}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$\nSo, the distance $d$ can be calculated using the distance formula, as follows:\n\n$$\n\\begin{aligned}d & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{{(\\sqrt{5}-(-4\\sqrt{5}))}^{2}+{(-12\\sqrt{5}-(-2\\sqrt{5}))}^{2}} \\\\  & =\\sqrt{(5\\sqrt{5})^{2}+(-10\\sqrt{5})^{2}} \\\\  & =\\sqrt{25(5)+100(5)} \\\\  & =\\sqrt{125+500} \\\\  & =\\sqrt{625} \\\\  & =25\\end{aligned}\n$$"} :step/id #uuid "31c22abb-16d4-5821-a52d-1bfe8c5323e2" :step/next {:db/id #edb/ref 17592186524067}} {:db/id #edb/ref 17592186524067 :step/content {:db/id #edb/ref 17592186523930 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a941df4e-944d-5b40-96d0-15089e219a36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186523612}] :answer-field/correct {:db/id #edb/ref 17592186523612} :answer-field/id #uuid "69167d57-152a-5b5e-a04c-0fa20c63b0b4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186523842}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "10bae273-6993-5b75-9a9e-139dcefc8633" :question/math-academy-id "q-216294" :question/problem "![](images/94/941efa39e90b946e68ea9ccc65ab7b97f4fce84d1cccbaa19135f8c87383a22f.png)\n\nThe exact length of $\\overset{―}{AB}$ is{{field-1}}." :question/worked-solution "From the figure, we note that the points $A$ and $B$ have coordinates ${{(-2,3)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(2,7)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})},$ respectively.\n\nTo find the length of $\\overset{―}{AB},$ we use the distance formula:\n\n$$\n\\begin{aligned}AB & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(2-(-2))^{2}+(7-3)^{2}} \\\\  & =\\sqrt{{4}^{2}+{4}^{2}} \\\\  & =\\sqrt{16+16} \\\\  & =\\sqrt{32} \\\\  & =4\\sqrt{2}\\end{aligned}\n$$"} :step/id #uuid "6cdce9b7-05c1-5e9f-8efe-1d31cef1a31b"}] :activity/title "The Distance Formula" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186523236}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186535093} :activity/id #uuid "f2d4f687-8d6d-557d-aff5-81bf78a9d509" :activity/scope {:db/id #edb/ref 17592186050975 :topic/id 