8ac9c1d7a58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186572320} {:answer/id #uuid "39c2689e-7e14-5399-b564-9ce98c16d49c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186572384} {:answer/id #uuid "6c76201f-926d-58e3-bd27-4d3220521737" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186572442} {:answer/id #uuid "76f350fc-c99a-5aa2-b13e-6a1ed1d57a8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186572451} {:answer/id #uuid "e104f5da-37f8-5cb6-904e-3df340074d96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186572564}] :answer-field/correct {:answer/id #uuid "76f350fc-c99a-5aa2-b13e-6a1ed1d57a8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186572451} :answer-field/id #uuid "8b5d6150-ecf7-5f47-90e3-e6ef4745bb15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572627}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1eda43e3-b2a8-5d39-8cf8-7675e676743f" :question/math-academy-id "q-32562" :question/problem "Solve for $x$ if ${log}_{3}⁡(x-5)=2.$" :question/worked-solution "To remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $3,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{3}⁡(x-5) & =2 \\\\ {3}^{{log}_{3}⁡(x-5)} & ={3}^{2}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${3}^{{log}_{3}⁡(x-5)}=x-5.$\n\nTherefore,\n\n$$\n\\begin{aligned}x-5 & ={3}^{2} \\\\ x-5 & =9 \\\\ x & =14.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186572682 :knowledge-point/_questions [{:db/id #edb/ref 17592186059795 :knowledge-point/id #uuid "310db608-6d8b-51af-8abd-60f4dbd05423" :knowledge-point/title "Solving Logarithmic Equations by Combining Logarithmic Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cb1ebdc-d911-543c-a5ec-2c39d0bc4252" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186572328} {:answer/id #uuid "6d19565f-be3c-551f-8d53-cfc198fd1d80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[5]{5}" :db/id #edb/ref 17592186572443} {:answer/id #uuid "c46e478d-c5ed-5093-9e4a-7df29e99dfc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186572537} {:answer/id #uuid "c61569de-9294-5a88-bfce-3bd6bd5b4e54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186572538} {:answer/id #uuid "ce3a8353-c68e-51e9-a47a-944828e4d592" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186572547}] :answer-field/correct {:answer/id #uuid "0cb1ebdc-d911-543c-a5ec-2c39d0bc4252" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186572328} :answer-field/id #uuid "d37a1738-f25e-5f6b-a20f-5e8e1491c6e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572650}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2f3b2436-4186-5dc4-8dde-9327a375de0e" :question/math-academy-id "q-79388" :question/problem "If $7{log}_{5}⁡x-2{log}_{5}⁡x=10$, then what is the value of  $x?$" :question/worked-solution "First, we rearrange our equation to isolate the logarithmic term:\n\n$$\n\\begin{aligned}7{log}_{5}⁡x-2{log}_{5}⁡x & =10 \\\\ (7-2){log}_{5}⁡x & =10 \\\\ 5{log}_{5}⁡x & =10 \\\\ {log}_{5}⁡x & =2\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $5,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{5}⁡x & =2 \\\\ {5}^{{log}_{5}⁡x} & ={5}^{2}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${5}^{{log}_{5}⁡x}=x.$\n\nTherefore,\n\n$$\n\\begin{aligned}x & ={5}^{2} \\\\ x & =25.\\end{aligned}\n$$"}]}
