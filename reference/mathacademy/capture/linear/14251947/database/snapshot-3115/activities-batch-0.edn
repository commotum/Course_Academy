#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186060563} :activity/id #uuid "a629931e-b4d2-5295-b978-709da1971402" :activity/scope {:db/id #edb/ref 17592186049944 :topic/id #uuid "204f44c0-5b46-57c1-a87d-a8ddbcbb2008" :topic/math-academy-id 226} :activity/steps [{:db/id #edb/ref 17592186060563 :step/content {:db/id #edb/ref 17592186060906 :tutorial/content "Suppose we are given the equation $\\log_3 x = 4.$ Can we determine $x?$\n\nRecall that the inverse operation of the logarithm is exponentiation. So, to isolate $x,$ we must exponentiate both sides of this equation. \n\nThe base of the logarithm is $3,$ so we use a base of $3$ for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{3}⁡x & =4 \\\\ {3}^{({log}_{3}⁡x)} & ={3}^{4}\\end{aligned}\n$$\n\nThe equation above may look complicated, but since exponentiation is the inverse function of the logarithm, we know that $3^{(\\log_3{x})}=x.$ Therefore, we get   \n\n$$\n\\begin{aligned}x & ={3}^{4} \\\\ x & =81.\\end{aligned}\n$$\n\nWe conclude that $x = 81$ is the solution." :tutorial/id #uuid "bbfe9e19-d1ed-5df9-97f9-0e9c7f9f50e9" :tutorial/math-academy-id 2810 :tutorial/title "Introduction"} :step/id #uuid "eb3435ba-447f-5bc4-baf9-4cf14118da95" :step/math-academy-id 14724 :step/next {:db/id #edb/ref 17592186060718}} {:db/id #edb/ref 17592186060564 :step/content {:db/id #edb/ref 17592186059695 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059518 :question/id #uuid "3590f0e0-2ff9-58f4-8351-772b477c1cd2" :question/math-academy-id "e-4109"} :knowledge-point/id #uuid "98fb5d45-5215-506c-8b2a-99aaadb6631c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673}] :knowledge-point/questions [{:db/id #edb/ref 17592186059984} {:db/id #edb/ref 17592186060240} {:db/id #edb/ref 17592186233679} {:db/id #edb/ref 17592186234411} {:db/id #edb/ref 17592186526054} {:db/id #edb/ref 17592186526104}] :knowledge-point/title "Solving Logarithmic Equations With Linear Arguments"} :step/id #uuid "cc5be384-ef18-597e-a346-067e1c1259b7" :step/math-academy-id 14725 :step/next {:db/id #edb/ref 17592186060717}} {:db/id #edb/ref 17592186060717 :step/content {:db/id #edb/ref 17592186059793 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059592 :question/id #uuid "7055ec96-b829-5cca-8149-314b4c8fc6c8" :question/math-academy-id "e-5111"} :knowledge-point/id #uuid "7b024b05-1efe-594e-9a7e-6d51a28c0c78" :knowledge-point/questions [{:db/id #edb/ref 17592186059991} {:db/id #edb/ref 17592186059992} {:db/id #edb/ref 17592186233031} {:db/id #edb/ref 17592186233138} {:db/id #edb/ref 17592186234257} {:db/id #edb/ref 17592186234258} {:db/id #edb/ref 17592186526032} {:db/id #edb/ref 17592186526082} {:db/id #edb/ref 17592186534970}] :knowledge-point/title "Solving Logarithmic Equations by First Rearranging the Equation"} :step/id #uuid "618d5a34-ee3f-59a7-970d-ba42b21fbda4" :step/math-academy-id 18774 :step/next {:db/id #edb/ref 17592186060719}} {:db/id #edb/ref 17592186060718 :step/content {:db/id #edb/ref 17592186059794 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059593 :question/id #uuid "77f6d553-3291-5110-a30e-11991ae88425" :question/math-academy-id "e-5118"} :knowledge-point/id #uuid "5fd76722-397f-564f-b592-52156e86ddc0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049865}] :knowledge-point/questions [{:db/id #edb/ref 17592186060433} {:db/id #edb/ref 17592186060434} {:db/id #edb/ref 17592186234133} {:db/id #edb/ref 17592186234475} {:db/id #edb/ref 17592186526024}] :knowledge-point/title "Solving Logarithmic Equations"} :step/id #uuid "dc6280f1-e022-5030-8917-7e7e99e2ee1b" :step/math-academy-id 18852 :step/next {:db/id #edb/ref 17592186060564}} {:db/id #edb/ref 17592186060719 :step/content {:db/id #edb/ref 17592186059795 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059594 :question/id #uuid "bd3c7932-a6eb-5de6-a485-84e5d44656a0" :question/math-academy-id "e-5119"} :knowledge-point/id #uuid "310db608-6d8b-51af-8abd-60f4dbd05423" :knowledge-point/questions [{:db/id #edb/ref 17592186059990} {:db/id #edb/ref 17592186060219} {:db/id #edb/ref 17592186233032} {:db/id #edb/ref 17592186233033} {:db/id #edb/ref 17592186234412} {:db/id #edb/ref 17592186526019}] :knowledge-point/title "Solving Logarithmic Equations by Combining Logarithmic Terms"} :step/id #uuid "587b6ddb-fb1f-588a-934a-3923f5e86004" :step/math-academy-id 18855}] :activity/title "Solving Logarithmic Equations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186059909}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186535119} :activity/id #uuid "76083efd-d525-5432-a337-c60866a16fa3" :activity/scope {:db/id #edb/ref 17592186049944 :topic/id #uuid "204f44c0-5b46-57c1-a87d-a8ddbcbb2008" :topic/math-academy-id 226} :activity/steps [{:db/id #edb/ref 17592186535098 :step/content {:db/id #edb/ref 17592186534970 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bb7199e-65dd-5bd9-a79d-442fc232faa9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "425" :db/id #edb/ref 17592186534288} {:answer/id #uuid "6f1ae7c7-2dee-55e1-8b00-d4531dcc5579" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "362" :db/id #edb/ref 17592186534497} {:answer/id #uuid "cf067dd4-c8bc-5704-b97b-05088b2a487b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "343" :db/id #edb/ref 17592186534729} {:answer/id #uuid "e8cde56b-bba5-5c32-a43d-c79e4c3cdd75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "371" :db/id #edb/ref 17592186534782} {:answer/id #uuid "f3a6a46f-1b59-5281-b140-01c12fd66cf1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "471" :db/id #edb/ref 17592186534807}] :answer-field/correct {:db/id #edb/ref 17592186534807} :answer-field/id #uuid "25a7aacd-0ade-5f57-a8d3-34286e4a41cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186534854}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "00bde4d7-2128-56ee-87f4-eb818e9cb4e3" :question/math-academy-id "q-100626" :question/problem "If $-16{log}_{7}⁡(x-128)=-48$, then $x=$" :question/worked-solution "First, we rearrange our equation to isolate the logarithmic term:\n\n$$\n\\begin{aligned}-16{log}_{7}⁡(x-128) & =-48 \\\\ {log}_{7}⁡(x-128) & =\\frac{-48}{-16} \\\\ {log}_{7}⁡(x-128) & =3\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $7,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{7}⁡(x-128) & =3 \\\\ {7}^{{log}_{7}⁡(x-128)} & ={7}^{3}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${7}^{{log}_{7}⁡(x-128)}=x-128.$\n\nTherefore,\n\n$$\n\\begin{aligned}x-128 & ={7}^{3} \\\\ x-128 & =343 \\\\ x & =471.\\end{aligned}\n$$"} :step/id #uuid "1c02ef41-09d7-5c72-a8d1-2766d66724c0"} {:db/id #edb/ref 17592186535103 :step/content {:db/id #edb/ref 17592186233679 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13d98f75-ec98-55b8-bd6d-557ed859ed11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{83}{4}" :db/id #edb/ref 17592186534309} {:answer/id #uuid "48c860bd-e06a-5669-aacd-322bd3817f4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{68}{3}" :db/id #edb/ref 17592186534403} {:answer/id #uuid "51a1eea1-22ad-5e39-840b-a993eeed3ec9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "33" :db/id #edb/ref 17592186534427} {:answer/id #uuid "c020f3d7-85a1-5452-a318-b9aba6af4d51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "22" :db/id #edb/ref 17592186534693} {:answer/id #uuid "e55c01a0-412d-5e01-991f-926ab7486bb7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{62}{3}" :db/id #edb/ref 17592186534771}] :answer-field/correct {:db/id #edb/ref 17592186534693} :answer-field/id #uuid "2b66e190-3a44-5bcd-8fa8-92a479622c92" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186534857}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "96612b32-04f7-536b-8298-ef008f709116" :question/math-academy-id "q-25135" :question/problem "Find $x$ such that ${log}_{4}⁡(3x-2)=3.$" :question/worked-solution "To remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $4,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{4}⁡(3x-2) & =3 \\\\ {4}^{{log}_{4}⁡(3x-2)} & ={4}^{3}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${4}^{{log}_{4}⁡(3x-2)}=3x-2.$\n\nTherefore,\n\n$$\n\\begin{aligned}3x-2 & ={4}^{3} \\\\ 3x-2 & =64 \\\\ 3x & =66 \\\\ x & =22.\\end{aligned}\n$$"} :step/id #uuid "2a4f9450-03d9-5f9e-9859-0889b3ec4d3f" :step/next {:db/id #edb/ref 17592186535098}} {:db/id #edb/ref 17592186535119 :step/content {:db/id #edb/ref 17592186059991 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de1991f6-b528-5998-88b7-54673d5bf939" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "48" :db/id #edb/ref 17592186056305} {:answer/id #uuid "0b104d48-c89f-50d8-aa70-08caaff8e170" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "49" :db/id #edb/ref 17592186056306} {:answer/id #uuid "299ea40c-ff2e-55e3-9ec0-9f7d8d31dedf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50" :db/id #edb/ref 17592186056307} {:answer/id #uuid "3138227c-8c5f-52fb-8708-ee41e7e743dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186056308} {:answer/id #uuid "34747a1f-7188-5548-9064-656c70f5fa08" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186056309}] :answer-field/correct {:db/id #edb/ref 17592186056305} :answer-field/id #uuid "d6ac5b0b-cfa5-5e6b-a1be-33551e6bff78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186056304}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "38edf6bf-dbb8-50a2-9424-49395fd3a840" :question/math-academy-id "q-1120" :question/problem "If $\\frac{{log}_{7}⁡(x+1)}{2}=1$, then $x=$" :question/worked-solution "First, we rearrange our equation to isolate the logarithmic term:\n\n$$\n\\begin{aligned}\\frac{{log}_{7}⁡(x+1)}{2} & =1 \\\\ {log}_{7}⁡(x+1) & =2\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $7,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{7}⁡(x+1) & =2 \\\\ {7}^{{log}_{7}⁡(x+1)} & ={7}^{2}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${7}^{{log}_{7}⁡(x+1)}=x+1.$\n\nTherefore,\n\n$$\n\\begin{aligned}x+1 & ={7}^{2} \\\\ x+1 & =49 \\\\ x & =48.\\end{aligned}\n$$"} :step/id #uuid "9f12e949-c5a4-5db4-9f36-811356009a82" :step/next {:db/id #edb/ref 17592186535103}}] :activity/title "Solving Logarithmic Equations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186534257}]}
