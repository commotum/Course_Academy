9"} :knowledge-point/id #uuid "310db608-6d8b-51af-8abd-60f4dbd05423" :knowledge-point/questions [{:db/id #edb/ref 17592186059990} {:db/id #edb/ref 17592186060219} {:db/id #edb/ref 17592186233032} {:db/id #edb/ref 17592186233033} {:db/id #edb/ref 17592186234412} {:db/id #edb/ref 17592186526019} {:db/id #edb/ref 17592186572682}] :knowledge-point/title "Solving Logarithmic Equations by Combining Logarithmic Terms"} :step/id #uuid "587b6ddb-fb1f-588a-934a-3923f5e86004" :step/math-academy-id 18855}] :activity/title "Solving Logarithmic Equations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186059909}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186535119} :activity/id #uuid "76083efd-d525-5432-a337-c60866a16fa3" :activity/scope {:db/id #edb/ref 17592186049944 :topic/id #uuid "204f44c0-5b46-57c1-a87d-a8ddbcbb2008" :topic/math-academy-id 226} :activity/steps [{:db/id #edb/ref 17592186535098 :step/content {:db/id #edb/ref 17592186534970 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bb7199e-65dd-5bd9-a79d-442fc232faa9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "425" :db/id #edb/ref 17592186534288} {:answer/id #uuid "6f1ae7c7-2dee-55e1-8b00-d4531dcc5579" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "362" :db/id #edb/ref 17592186534497} {:answer/id #uuid "cf067dd4-c8bc-5704-b97b-05088b2a487b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "343" :db/id #edb/ref 17592186534729} {:answer/id #uuid "e8cde56b-bba5-5c32-a43d-c79e4c3cdd75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "371" :db/id #edb/ref 17592186534782} {:answer/id #uuid "f3a6a46f-1b59-5281-b140-01c12fd66cf1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "471" :db/id #edb/ref 17592186534807}] :answer-field/correct {:db/id #edb/ref 17592186534807} :answer-field/id #uuid "25a7aacd-0ade-5f57-a8d3-34286e4a41cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186534854}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "00bde4d7-2128-56ee-87f4-eb818e9cb4e3" :question/math-academy-id "q-100626" :question/problem "If $-16{log}_{7}⁡(x-128)=-48$, then $x=$" :question/worked-solution "First, we rearrange our equation to isolate the logarithmic term:\n\n$$\n\\begin{aligned}-16{log}_{7}⁡(x-128) & =-48 \\\\ {log}_{7}⁡(x-128) & =\\frac{-48}{-16} \\\\ {log}_{7}⁡(x-128) & =3\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $7,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{7}⁡(x-128) & =3 \\\\ {7}^{{log}_{7}⁡(x-128)} & ={7}^{3}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${7}^{{log}_{7}⁡(x-128)}=x-128.$\n\nTherefore,\n\n$$\n\\begin{aligned}x-128 & ={7}^{3} \\\\ x-128 & =343 \\\\ x & =471.\\end{aligned}\n$$"} :step/id #uuid "1c02ef41-09d7-5c72-a8d1-2766d66724c0"} {:db/id #edb/ref 17592186535103 :step/content {:db/id #edb/ref 17592186233679 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13d98f75-ec98-55b8-bd6d-557ed859ed11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{83}{4}" :db/id #edb/ref 17592186534309} {:answer/id #uuid "48c860bd-e06a-5669-aacd-322bd3817f4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{68}{3}" :db/id #edb/ref 17592186534403} {:answer/id #uuid "51a1eea1-22ad-5e39-840b-a993eeed3ec9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "33" :db/id #edb/ref 17592186534427} {:answer/id #uuid "c020f3d7-85a1-5452-a318-b9aba6af4d51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "22" :db/id #edb/ref 17592186534693} {:answer/id #uuid "e55c01a0-412d-5e01-991f-926ab7486bb7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{62}{3}" :db/id #edb/ref 17592186534771}] :answer-field/correct {:db/id #edb/ref 17592186534693} :answer-field/id #uuid "2b66e190-3a44-5bcd-8fa8-92a479622c92" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186534857}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "96612b32-04f7-536b-8298-ef008f709116" :question/math-academy-id "q-25135" :question/problem "Find $x$ such that ${log}_{4}⁡(3x-2)=3.$" :question/worked-solution "To remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $4,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{4}⁡(3x-2) & =3 \\\\ {4}^{{log}_{4}⁡(3x-2)} & ={4}^{3}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${4}^{{log}_{4}⁡(3x-2)}=3x-2.$\n\nTherefore,\n\n$$\n\\begin{aligned}3x-2 & ={4}^{3} \\\\ 3x-2 & =64 \\\\ 3x & =66 \\\\ x & =22.\\end{aligned}\n$$"} :step/id #uuid "2a4f9450-03d9-5f9e-9859-0889b3ec4d3f" :step/next {:db/id #edb/ref 17592186535098}} {:db/id #edb/ref 17592186535119 :step/content {:db/id #edb/ref 17592186059991 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de1991f6-b528-5998-88b7-54673d5bf939" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "48" :db/id #edb/ref 17592186056305} {:answer/id #uuid "0b104d48-c89f-50d8-aa70-08caaff8e170" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "49" :db/id #edb/ref 17592186056306} {:answer/id #uuid "299ea40c-ff2e-55e3-9ec0-9f7d8d31dedf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50" :db/id #edb/ref 17592186056307} {:answer/id #uuid "3138227c-8c5f-52fb-8708-ee41e7e743dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186056308} {:answer/id #uuid "34747a1f-7188-5548-9064-656c70f5fa08" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186056309}] :answer-field/correct {:db/id #edb/ref 17592186056305} :answer-field/id #uuid "d6ac5b0b-cfa5-5e6b-a1be-33551e6bff78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186056304}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "38edf6bf-dbb8-50a2-9424-49395fd3a840" :question/math-academy-id "q-1120" :question/problem "If $\\frac{{log}_{7}⁡(x+1)}{2}=1$, then $x=$" :question/worked-solution "First, we rearrange our equation to isolate the logarithmic term:\n\n$$\n\\begin{aligned}\\frac{{log}_{7}⁡(x+1)}{2} & =1 \\\\ {log}_{7}⁡(x+1) & =2\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $7,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{7}⁡(x+1) & =2 \\\\ {7}^{{log}_{7}⁡(x+1)} & ={7}^{2}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${7}^{{log}_{7}⁡(x+1)}=x+1.$\n\nTherefore,\n\n$$\n\\begin{aligned}x+1 & ={7}^{2} \\\\ x+1 & =49 \\\\ x & =48.\\end{aligned}\n$$"} :step/id #uuid "9f12e949-c5a4-5db4-9f36-811356009a82" :step/next {:db/id #edb/ref 17592186535103}}] :activity/title "Solving Logarithmic Equations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186534257}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186572752} :activity/id #uuid "3a8bd941-6c1d-5a78-9f47-aa480350898d" :activity/scope {:db/id #edb/ref 17592186049944 :topic/id #uuid "204f44c0-5b46-57c1-a87d-a8ddbcbb2008" :topic/math-academy-id 226} :activity/steps [{:db/id #edb/ref 17592186572752 :step/content {:db/id #edb/ref 17592186059992 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b1be147-f511-5bee-a466-2fc4542d5031" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186056311} {:answer/id #uuid "b0f587bc-f9e1-54f5-a2f0-cd6ad21129cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "84" :db/id #edb/ref 17592186056312} {:answer/id #uuid "d4e6a26d-18a8-5f12-b330-710b4e665df4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186056313} {:answer/id #uuid "ef96eeca-40ca-59d9-ba44-6b24d5f93a18" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186056314} {:answer/id #uuid "73a4a9d1-da33-5744-8c6b-584a79a5e4a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186056315}] :answer-field/id #uuid "5219f4f0-f7d3-53cc-8123-96447542439f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186056310}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "65c1a586-740e-5e33-b66b-844ddf70d184" :question/math-academy-id "q-1129" :question/problem "If $-6\\log_{3} (x - 3) =-24$, then $x =$"} :step/id #uuid "3a1e0312-75fb-54c7-a879-e67bc1eb68c0" :step/next {:db/id #edb/ref 17592186572776}} {:db/id #edb/ref 17592186572776 :step/content {:db/id #edb/ref 17592186572674 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04d4eaef-9aba-53fe-a0d9-58ac9c1d7a58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186572320} {:answer/id #uuid "39c2689e-7e14-5399-b564-9ce98c16d49c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186572384} {:answer/id #uuid "6c76201f-926d-58e3-bd27-4d3220521737" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186572442} {:answer/id #uuid "76f350fc-c99a-5aa2-b13e-6a1ed1d57a8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186572451} {:answer/id #uuid "e104f5da-37f8-5cb6-904e-3df340074d96" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186572564}] :answer-field/correct {:db/id #edb/ref 17592186572451} :answer-field/id #uuid "8b5d6150-ecf7-5f47-90e3-e6ef4745bb15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186572627}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1eda43e3-b2a8-5d39-8cf8-7675e676743f" :question/math-academy-id "q-32562" :question/problem "Solve for $x$ if ${log}_{3}⁡(x-5)=2.$" :question/worked-solution "To remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $3,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{3}⁡(x-5) & =2 \\\\ {3}^{{log}_{3}⁡(x-5)} & ={3}^{2}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${3}^{{log}_{3}⁡(x-5)}=x-5.$\n\nTherefore,\n\n$$\n\\begin{aligned}x-5 & ={3}^{2} \\\\ x-5 & =9 \\\\ x & =14.\\end{aligned}\n$$"} :step/id #uuid "844768ff-fb48-5a95-86f4-b402d7531d58" :step/next {:db/id #edb/ref 17592186572789}} {:db/id #edb/ref 17592186572789 :step/content {:db/id #edb/ref 17592186572682 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cb1ebdc-d911-543c-a5ec-2c39d0bc4252" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186572328} {:answer/id #uuid "6d19565f-be3c-551f-8d53-cfc198fd1d80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[5]{5}" :db/id #edb/ref 17592186572443} {:answer/id #uuid "c46e478d-c5ed-5093-9e4a-7df29e99dfc4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186572537} {:answer/id #uuid "c61569de-9294-5a88-bfce-3bd6bd5b4e54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186572538} {:answer/id #uuid "ce3a8353-c68e-51e9-a47a-944828e4d592" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30" :db/id #edb/ref 17592186572547}] :answer-field/correct {:db/id #edb/ref 17592186572328} :answer-field/id #uuid "d37a1738-f25e-5f6b-a20f-5e8e1491c6e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186572650}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2f3b2436-4186-5dc4-8dde-9327a375de0e" :question/math-academy-id "q-79388" :question/problem "If $7{log}_{5}⁡x-2{log}_{5}⁡x=10$, then what is the value of  $x?$" :question/worked-solution "First, we rearrange our equation to isolate the logarithmic term:\n\n$$\n\\begin{aligned}7{log}_{5}⁡x-2{log}_{5}⁡x & =10 \\\\ (7-2){log}_{5}⁡x & =10 \\\\ 5{log}_{5}⁡x & =10 \\\\ {log}_{5}⁡x & =2\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $5,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{5}⁡x & =2 \\\\ {5}^{{log}_{5}⁡x} & ={5}^{2}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${5}^{{log}_{5}⁡x}=x.$\n\nTherefore,\n\n$$\n\\begin{aligned}x & ={5}^{2} \\\\ x & =25.\\end{aligned}\n$$"} :step/id #uuid "baf6dd19-582e-523e-99fd-f96f25b7727e"}] :activity/title "Solving Logarithmic Equations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186572301}]}
