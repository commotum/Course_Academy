#{[{:activity/first-step {:db/id #edb/ref 17592186158137} :activity/id #uuid "8bdf85c1-4b83-5092-87f5-18958edf4721" :activity/scope {:db/id #edb/ref 17592186050134 :topic/id #uuid "2edfad38-c4ef-5df9-8b35-5ea30d354656" :topic/math-academy-id 2823} :activity/steps [{:db/id #edb/ref 17592186158107 :step/content {:db/id #edb/ref 17592186157280 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157084 :question/id #uuid "d91fdb8d-5a45-5ac2-a281-20dcbbd7d6ce" :question/math-academy-id "e-7079"} :knowledge-point/id #uuid "4106fe70-b9df-5621-ba64-66703855aaf9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049830} {:db/id #edb/ref 17592186050783}] :knowledge-point/questions [{:db/id #edb/ref 17592186157805} {:db/id #edb/ref 17592186157807} {:db/id #edb/ref 17592186378187} {:db/id #edb/ref 17592186378194} {:db/id #edb/ref 17592186378201} {:db/id #edb/ref 17592186378208} {:db/id #edb/ref 17592186380165} {:db/id #edb/ref 17592186407304}] :knowledge-point/title "Simplifying an Expression Using the Law that Conjunction Absorbs Disjunction"} :step/id #uuid "06b73134-c888-557b-b24b-5c077c2e7029" :step/math-academy-id 26063 :step/next {:db/id #edb/ref 17592186158108}} {:db/id #edb/ref 17592186158108 :step/content {:db/id #edb/ref 17592186157281 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157085 :question/id #uuid "228d6823-70ab-5b04-807a-b87e5f98bccb" :question/math-academy-id "e-7080"} :knowledge-point/id #uuid "5d4ea352-2a82-5ff5-8c08-b7f9a09929e6" :knowledge-point/questions [{:db/id #edb/ref 17592186157806} {:db/id #edb/ref 17592186157808} {:db/id #edb/ref 17592186378215} {:db/id #edb/ref 17592186378222} {:db/id #edb/ref 17592186378229} {:db/id #edb/ref 17592186380172} {:db/id #edb/ref 17592186380179}] :knowledge-point/title "Simplifying an Expression Using the Law that Disjunction Absorbs Conjunction"} :step/id #uuid "bfff8667-4509-537f-8b85-edfe60cfa421" :step/math-academy-id 26064} {:db/id #edb/ref 17592186158137 :step/content {:db/id #edb/ref 17592186158488 :tutorial/content "There are two laws, called the **absorption laws**, that can be used to drastically simplify some logical expressions.\n\n- The law that conjunction absorbs disjunction is stated as $$A \\land (A \\lor B) \\equiv A.$$\n- Likewise, the law that disjunction absorbs conjunction is stated as $$A \\lor (A \\land B) \\equiv A.$$\n\nSometimes, the laws are stated more concisely as\n\n$$A \\land (A \\lor B) \\equiv A \\lor (A \\land B) \\equiv A.$$\n\nTo prove that these laws hold, we can construct truth tables:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\, A \\land (A \\lor B) \\,$ | $\\, A \\lor (A \\land B) \\,$ |\n| --- | --- | --- | --- |\n| $\\color{blue} \\textrm T$ | $\\textrm T$ | $\\color{blue} \\textrm T$ | $\\color{blue} \\textrm T$ |\n| $\\color{blue} \\textrm T$ | $\\textrm F$ | $\\color{blue} \\textrm T$ | $\\color{blue} \\textrm T$ |\n| $\\color{blue} \\textrm F$ | $\\textrm T$ | $\\color{blue} \\textrm F$ | $\\color{blue} \\textrm F$ |\n| $\\color{blue} \\textrm F$ | $\\textrm F$ | $\\color{blue} \\textrm F$ | $\\color{blue} \\textrm F$ |" :tutorial/id #uuid "dcc7f471-b2da-52b6-b003-76ae7ca1e64a" :tutorial/math-academy-id 4344 :tutorial/title "Introduction"} :step/id #uuid "46368002-98d2-5228-8269-a1aea4e09ac3" :step/math-academy-id 26413 :step/next {:db/id #edb/ref 17592186158107}}] :activity/title "The Absorption Laws" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186157486}] [{:activity/course {:db/id #edb/ref 17592186046679} :activity/first-step {:db/id #edb/ref 17592186407307} :activity/id #uuid "6b51003e-add2-53e1-8890-39467458041f" :activity/scope {:db/id #edb/ref 17592186050134 :topic/id #uuid "2edfad38-c4ef-5df9-8b35-5ea30d354656" :topic/math-academy-id 2823} :activity/steps [{:db/id #edb/ref 17592186407305 :step/content {:db/id #edb/ref 17592186157807 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f510f76-f3c6-5a7a-b248-a17219184fb6" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II only" :db/id #edb/ref 17592186407292} {:answer/id #uuid "7cb016f2-03b4-57bf-9fcc-8b9cdc170a1e" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "III only" :db/id #edb/ref 17592186407293} {:answer/id #uuid "d3c92d20-75ab-5758-8f5c-12c90997983b" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I, II, and III" :db/id #edb/ref 17592186407297} {:answer/id #uuid "d4b2ca85-080e-5af9-b237-63e3fefef845" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II and III only" :db/id #edb/ref 17592186407298} {:answer/id #uuid "f8be1cf7-b273-55bf-a561-7d5869642a0f" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I and II only" :db/id #edb/ref 17592186407300}] :answer-field/correct {:db/id #edb/ref 17592186407293} :answer-field/id #uuid "43de8a0c-6ffb-50fa-9e93-31fde48b6d17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407302}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c9f0b645-6838-5cad-b5bd-0b7bf64c64fb" :question/math-academy-id "q-81276" :question/problem "Which of the following are logically equivalent to $C?$\n\n- $B∨(B∨C)$\n- $B∧(B∨C)$\n- $C∧(B∨C)$" :question/worked-solution "The law that conjunction absorbs disjunction is stated as\n\n$$\nC∧(C∨B)≡C.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is *not* logically equivalent to $C.$ This statement cannot be simplified using the absorption laws.\n\n- Statement II is *not* logically equivalent to $C.$ We have\n\n$$\n\\begin{aligned}B∧(B∨C) & ≡B≢C.\\,\\times \\end{aligned}\n$$\n\n- Statement III is logically equivalent to $C.$ We have\n\n$$\n\\begin{aligned}C∧(B∨C) & ≡C∧(C∨B) \\\\  & ≡C.\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"III only.\""} :step/id #uuid "1eeac7d8-2e60-5c1b-bc79-fffcaf37ea73" :step/next {:db/id #edb/ref 17592186407306}} {:db/id #edb/ref 17592186407306 :step/content {:db/id #edb/ref 17592186407304 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1835dbe5-7a53-5bf2-a332-74cb2d5f68f3" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "III only" :db/id #edb/ref 17592186407287} {:answer/id #uuid "195e7fd9-c549-5aab-828f-eeabfcdeb266" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I and III only" :db/id #edb/ref 17592186407288} {:answer/id #uuid "303cbb99-bbc1-5f11-9171-09fabe0ff92a" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I, II, and III" :db/id #edb/ref 17592186407290} {:answer/id #uuid "5b3655f9-81c0-5fdb-a48d-05082b26b7d9" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II only" :db/id #edb/ref 17592186407291} {:answer/id #uuid "d09757aa-fd5d-54fd-b3d1-49c505fad041" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II and III only" :db/id #edb/ref 17592186407296}] :answer-field/correct {:db/id #edb/ref 17592186407296} :answer-field/id #uuid "3ef12586-e2eb-58c0-8a26-29cbae2f1aeb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407301}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "669b0027-14f5-5068-b932-b9686df06625" :question/math-academy-id "q-81717" :question/problem "Which of the following are logically equivalent to $R?$\n\n- $(T∨R)∧T$\n- $R∧(T∨R)$\n- $(R∨T)∧R$" :question/worked-solution "The law that conjunction absorbs disjunction is stated as\n\n$$\nR∧(R∨T)≡R.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is *not* logically equivalent to $R.$ We have\n\n$$\n\\begin{aligned}(T∨R)∧T & ≡T∧(T∨R) \\\\  & ≡T≢R.\\,\\times \\end{aligned}\n$$\n\n- Statement II is logically equivalent to $R.$ We have\n\n$$\n\\begin{aligned}R∧(T∨R) & ≡R∧(R∨T) \\\\  & ≡R.\\,✓\\end{aligned}\n$$\n\n- Statement III is logically equivalent to $R.$ We have\n\n$$\n\\begin{aligned}(R∨T)∧R & ≡R∧(R∨T) \\\\  & ≡R.\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II and III only.\""} :step/id #uuid "39c66e43-2842-5715-bce0-22271f5c494c"} {:db/id #edb/ref 17592186407307 :step/content {:db/id #edb/ref 17592186157806 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cc9dfdc-588c-582f-9f2b-c80f69517904" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II only" :db/id #edb/ref 17592186407286} {:answer/id #uuid "1ab4fef3-6b76-545c-a2e2-0dad117ccb95" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I, II and III" :db/id #edb/ref 17592186407289} {:answer/id #uuid "bdb55b9e-b815-5740-9c0c-62a65fdabd92" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I only" :db/id #edb/ref 17592186407294} {:answer/id #uuid "c5ea4095-baee-5787-855f-5de1e85f86e1" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I and II only" :db/id #edb/ref 17592186407295} {:answer/id #uuid "e9eb4a13-2ded-5150-8eb6-f810b7f1c872" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II and III only" :db/id #edb/ref 17592186407299}] :answer-field/correct {:db/id #edb/ref 17592186407286} :answer-field/id #uuid "f770988e-367c-568b-b9ad-aed362d52e80" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407303}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d2ca6bb7-dcf8-5600-9384-c5d2e8fe7476" :question/math-academy-id "q-81082" :question/problem "Which of the following are logically equivalent to $X?$\n\n- $X∨(X∨Y)$\n- $(Y∧X)∨X$\n- $Y∨(X∧Y)$" :question/worked-solution "The law that disjunction absorbs conjunction is stated as\n\n$$\nX∨(X∧Y)≡X.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is *not* logically equivalent to $X.$ This statement cannot be simplified using the absorption laws.\n\n- Statement II is logically equivalent to $X.$ We have\n\n$$\n\\begin{aligned}(Y∧X)∨X & ≡X∨(Y∧X) \\\\  & ≡X∨(X∧Y) \\\\  & ≡X.\\,✓\\end{aligned}\n$$\n\n- Statement III is *not* logically equivalent to $A.$ We have\n\n$$\n\\begin{aligned}Y∨(X∧Y) & ≡Y∨(Y∧X) \\\\  & ≡Y≢X.\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"II only.\""} :step/id #uuid "b0f2e79f-7c2d-591d-875f-4038c46d10e7" :step/next {:db/id #edb/ref 17592186407305}}] :activity/title "The Absorption Laws" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186407285}]}
