#{[{:db/id #edb/ref 17592186507499 :knowledge-point/_questions [{:db/id #edb/ref 17592186054772 :knowledge-point/id #uuid "b6b0cad0-354b-5c4c-9fe2-3aceff7e5b6e" :knowledge-point/title "Solving an Inequality and Adjusting the Final Result"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "825a3f94-5d5f-59b8-9d4e-7d0f168885a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z>-24" :db/id #edb/ref 17592186506965} {:answer/id #uuid "9bfb137d-cdc8-5e43-84c6-ea0025793bde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z<24" :db/id #edb/ref 17592186507016} {:answer/id #uuid "a1a10480-cbf4-58a2-9e6b-17815d58cadd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z<-24" :db/id #edb/ref 17592186507026} {:answer/id #uuid "b207b853-0fed-5188-a900-3bb18b72d272" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z>\\frac{2}{3}" :db/id #edb/ref 17592186507070} {:answer/id #uuid "ef835f55-6239-5e48-941a-ae73fc43925e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z<-\\frac{2}{3}" :db/id #edb/ref 17592186507208}] :answer-field/correct {:answer/id #uuid "a1a10480-cbf4-58a2-9e6b-17815d58cadd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z<-24" :db/id #edb/ref 17592186507026} :answer-field/id #uuid "b4490670-0ae0-5d23-9e69-8c96fae8a13a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186507356}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c8a935c4-ddf1-51df-a83c-2659ff68e2ef" :question/math-academy-id "q-154041" :question/problem "Solve the inequality $4<-\\frac{z}{6}.$" :question/worked-solution "The variable $z$ is being *divided* by $6.$ To isolate $z$ and remove the negative sign, we *multiply* by $-6$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}4\\,\\, & <\\,\\,-\\frac{z}{6} \\\\ (-6)\\cdot 4\\,\\, & >\\,\\,(-6)\\cdot (-\\frac{z}{6}) \\\\ -24\\,\\, & >\\,\\,(-6)\\cdot (-\\frac{z}{6})\\end{aligned}\n$$\n\nSince two negative numbers multiply to give a positive number, we first cancel the negatives:\n\n$$\n\\begin{aligned}-24\\,\\, & >(-6)\\cdot (-\\frac{z}{6}) \\\\ -24 & >(\\cancel{-}6)\\cdot (\\cancel{-}\\frac{z}{6}) \\\\ -24 & >6\\cdot \\frac{z}{6}\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $6$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}-24 & >6\\cdot \\frac{z}{6} \\\\ -24 & >\\frac{6z}{6} \\\\ -24 & >\\frac{\\cancel{6}z}{\\cancel{6}} \\\\ -24 & >z\\end{aligned}\n$$\n\nFinally, we rewrite the inequality with the variable on the left-hand side:\n\n$$\nz<-24\n$$\n\nTherefore, the solution is $z<-24.$"}] [{:db/id #edb/ref 17592186507405 :knowledge-point/_questions [{:db/id #edb/ref 17592186054770 :knowledge-point/id #uuid "281841fb-287e-597a-abb1-3917212e0dcb" :knowledge-point/title "Solving a One-Step Inequality When Flipping Is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ddfe654-6c20-5256-8c77-e26f467b5752" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge" :db/id #edb/ref 17592186506823}] :answer-field/correct {:answer/id #uuid "3ddfe654-6c20-5256-8c77-e26f467b5752" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge" :db/id #edb/ref 17592186506823} :answer-field/id #uuid "844948db-6db2-5198-81c4-adc418e774dd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186507318} {:answer-field/choices [{:answer/id #uuid "6ff7601c-194b-518f-be31-b3982ec9d2d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186506935}] :answer-field/correct {:answer/id #uuid "6ff7601c-194b-518f-be31-b3982ec9d2d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186506935} :answer-field/id #uuid "cfff5c34-1b4e-574b-b2cd-51c419fcd650" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186507368}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1670dd77-8590-5cdd-be80-9cfcce9e381b" :question/math-academy-id "q-181002" :question/problem "The solution to the inequality $-9a\\le -54$ is $a${{field-1}}{{field-2}}." :question/worked-solution "The variable $a$ is being *multiplied* by $-9.$ To isolate $a,$ we perform the *opposite* operation, which is *dividing* by $-9.$ Remember to perform the same operation on both sides.\n\nAlso, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-9a\\,\\, & \\le \\,\\,-54 \\\\ \\frac{-9a}{-9}\\,\\, & \\ge \\,\\,\\frac{-54}{-9} \\\\ \\frac{-9a}{-9}\\,\\, & \\ge \\,\\,6\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $-9$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}\\frac{-9a}{-9} & \\ge 6 \\\\ \\frac{\\cancel{-9}a}{\\cancel{-9}} & \\ge 6 \\\\ a & \\ge 6\\end{aligned}\n$$\n\nTherefore, the solution is $a\\ge 6.$"}] [{:db/id #edb/ref 17592186507412 :knowledge-point/_questions [{:db/id #edb/ref 17592186054770 :knowledge-point/id #uuid "281841fb-287e-597a-abb1-3917212e0dcb" :knowledge-point/title "Solving a One-Step Inequality When Flipping Is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e3dff68-6795-523f-999b-07af4af3ec70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y<6" :db/id #edb/ref 17592186506706} {:answer/id #uuid "7668d459-4f42-5919-bb7f-fa7eec09053a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y>9" :db/id #edb/ref 17592186506946} {:answer/id #uuid "9074c12a-1d5b-5242-a19c-1b503006d445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y<9" :db/id #edb/ref 17592186506999} {:answer/id #uuid "acb62ac6-c48e-569b-a36c-c8b94883aa98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y>-9" :db/id #edb/ref 17592186507060} {:answer/id #uuid "e10be7fe-3362-55cd-9dae-30e59a1d1e04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y<-9" :db/id #edb/ref 17592186507168}] :answer-field/correct {:answer/id #uuid "e10be7fe-3362-55cd-9dae-30e59a1d1e04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y<-9" :db/id #edb/ref 17592186507168} :answer-field/id #uuid "1301f956-a5f9-5af2-b9fc-78b855c39882" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186507253}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2d8f9e5d-ffea-59b8-9f7c-2f9037766a19" :question/math-academy-id "q-6277" :question/problem "Solve the inequality $-2y>18.$" :question/worked-solution "The variable $y$ is being *multiplied* by $-2.$ To isolate $y,$ we perform the *opposite* operation, which is *dividing* by $-2.$ Remember to perform the same operation on both sides.\n\nAlso, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-2y\\,\\, & >\\,\\,18 \\\\ \\frac{-2y}{-2}\\,\\, & <\\,\\,\\frac{18}{-2} \\\\ \\frac{-2y}{-2}\\,\\, & <\\,\\,-9\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $-2$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}\\frac{-2y}{-2} & <-9 \\\\ \\frac{\\cancel{-2}y}{\\cancel{-2}} & <-9 \\\\ y & <-9\\end{aligned}\n$$\n\nTherefore, the solution is $y<-9.$"}]}
