#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186570875} :activity/id #uuid "305b1754-459f-5e23-bbf5-c6aeddd3beff" :activity/scope {:db/id #edb/ref 17592186050490 :topic/id #uuid "4d8d1b92-7074-5d18-8e35-15cd34d42567" :topic/math-academy-id 1377} :activity/steps [{:db/id #edb/ref 17592186570853 :step/content {:db/id #edb/ref 17592186570740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1320e23e-adb4-5b08-998c-94e38cda3275" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\infty" :db/id #edb/ref 17592186570161} {:answer/id #uuid "15d9b284-c74a-58f9-b7b8-47d504faf3ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186570166} {:answer/id #uuid "504ca40a-75a2-55af-8c3d-3557a719d902" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\infty" :db/id #edb/ref 17592186570266} {:answer/id #uuid "c0002cc8-289d-5260-80cb-a81a46bb58b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186570462} {:answer/id #uuid "e5867d94-88cf-53e1-8290-f2df95ac10c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186570525}] :answer-field/correct {:db/id #edb/ref 17592186570525} :answer-field/id #uuid "bec4ef46-c3c9-5b5f-b667-e3c769648f01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186570670}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6f0201d6-c736-51e8-8b5c-a5fa2133c2b7" :question/math-academy-id "q-67654" :question/problem "Calculate ${lim}_{x\\to (-1)}\\operatorname{ln}⁡(x+1).$" :question/worked-solution "Let's sketch the graph of $y=\\operatorname{ln}⁡(x+1).$\n\n![](images/52/52817b9c0ede04e8e920de8a52ebe025916f314cc937097c7fb91ea612e18f1b.png)\n\nThe function is not defined for $x\\le -1.$ Therefore,\n\n$$\n{lim}_{x\\to -{1}^{-}}\\operatorname{ln}⁡(x+1)=\\text{DNE}.\n$$\n\nHowever, the function is defined for $x>-1.$ Moreover,\n\n$$\n{lim}_{x\\to -{1}^{+}}\\operatorname{ln}⁡(x+1)=-\\infty .\n$$\n\nSince the left and right-sided limits are not equal, we have\n\n$$\n{lim}_{x\\to -1}\\operatorname{ln}⁡(x+1)=\\text{DNE}.\n$$"} :step/id #uuid "b9688c8c-f696-5a99-9e0f-4cedd962c3d3"} {:db/id #edb/ref 17592186570862 :step/content {:db/id #edb/ref 17592186106453 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5c20fa8-200a-506a-94c2-80fcfa6c7a0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "∞" :db/id #edb/ref 17592186104867} {:answer/id #uuid "fb678f74-246c-57d7-b868-cf5895ba3cc4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186104868} {:answer/id #uuid "25d991d4-55c5-5c1d-bfa4-c7e0a3ea1f30" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- ∞" :db/id #edb/ref 17592186104869} {:answer/id #uuid "7250aa1b-cc45-55a4-bb75-1bdbc872a474" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "DNE" :db/id #edb/ref 17592186104870} {:answer/id #uuid "7af864a1-8d1c-587b-b28f-ae7247b1d1f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186104871}] :answer-field/id #uuid "bab8e87b-d7ac-5191-a877-e9001cf37a7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186104866}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cd9f98b1-8823-50d1-9aca-175557f35e81" :question/math-academy-id "q-54451" :question/problem "Calculate $lim_(x → (-4))\\log_{2} (x + 4)$."} :step/id #uuid "d8cd7ccd-d160-50f1-b1f0-3764b14a4f54" :step/next {:db/id #edb/ref 17592186570853}} {:db/id #edb/ref 17592186570875 :step/content {:db/id #edb/ref 17592186234146 :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f3cfd611-2ed4-57ad-9eb8-915a29e67aa0" :question/math-academy-id "q-54448" :question/problem "${lim}_{x\\to -\\infty }\\operatorname{log}(2-7x)=$" :question/worked-solution "Let's sketch the graph of $y=\\operatorname{log}(2-7x).$\n\n![](images/b4/b4fcf2946431788963444f22bcd51b2a617b53dfc4bbfdd0d8b90bd9fd9304d2.png)\n\nFrom the graph, we see that the function increases without bound as $x$ decreases. Therefore,\n\n$$\n{lim}_{x\\to -\\infty }\\operatorname{log}(2-7x)=\\infty \n$$"} :step/id #uuid "f568387c-f695-56ad-a2dc-4c74c8af2e96" :step/next {:db/id #edb/ref 17592186570862}}] :activity/title "Limits of Logarithmic Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186570102}]}
