#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186106603} :activity/id #uuid "c5f2642e-6a87-5aeb-a038-d51e520f5f7e" :activity/scope {:db/id #edb/ref 17592186050490 :topic/id #uuid "4d8d1b92-7074-5d18-8e35-15cd34d42567" :topic/math-academy-id 1377} :activity/steps [{:db/id #edb/ref 17592186106603 :step/content {:db/id #edb/ref 17592186107069 :tutorial/content "Let's look at the graph of $y=\\log_2{x}$ below.\n\n![](images/00/004265d2269924c6ce8905b6b92e9050b84066b3b5a3cc5383c75dd08e62f413.png)\n\nFrom the graph, we see that\n\n$$\n\\lim_{x\\to3}\\log_2{x} = \\log_2{3}\\approx 1.58.\n$$\n\nFor logarithmic functions, the limit at a point is equal to the value of the function at that point, so for any base $b \\gt 1$ we have\n\n$$\n\\lim_{x\\to c}\\log_b{x} = \\log_b{c}.\n$$\n\nRemember that logarithms are only defined for positive inputs $x\\gt 0,$ so we must have $c>0.$ Otherwise, the limit does not exist $\\textrm{(DNE}).$" :tutorial/id #uuid "e274ae6b-34e4-5fe4-be2f-c7a278dfa917" :tutorial/math-academy-id 2891 :tutorial/title "Introduction"} :step/id #uuid "163cb50e-cc52-5928-a53e-74d0de7c5711" :step/math-academy-id 15581 :step/next {:db/id #edb/ref 17592186106604}} {:db/id #edb/ref 17592186106604 :step/content {:db/id #edb/ref 17592186105723 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105580 :question/id #uuid "b18540cc-5822-5620-a36f-60cfbbf3196b" :question/math-academy-id "e-4255"} :knowledge-point/id #uuid "86137b90-ca62-515c-b8d1-fe28d477c1bf" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048964} {:db/id #edb/ref 17592186049226}] :knowledge-point/questions [{:db/id #edb/ref 17592186106458} {:db/id #edb/ref 17592186106459} {:db/id #edb/ref 17592186233762} {:db/id #edb/ref 17592186233895} {:db/id #edb/ref 17592186564486} {:db/id #edb/ref 17592186564525}] :knowledge-point/title "Evaluating Using Direct Substitution"} :step/id #uuid "2209645b-5517-5350-9f59-734ba0a67972" :step/math-academy-id 15582 :step/next {:db/id #edb/ref 17592186106605}} {:db/id #edb/ref 17592186106605 :step/content {:db/id #edb/ref 17592186107070 :tutorial/content "Let's take a look again at the function $y=\\log_2(x).$\n\n![](images/30/30a66b56ea1422fc61941d22aedbbf3f17e06810e66e6590490bd4b7188fd361.png)\n\nAs $x$ gets larger and larger, the curve increases without bound. So, we have\n\n$$\n\\lim_{x\\to\\infty} \\log_2{x}= \\infty.\n$$\n\nThe curve is not defined for $x\\leq 0,$ but as $x$ approaches zero from the right the curve *decreases* without bound. So\n\n$$\n\\lim_{x\\to0^+}\\log_2{x} = -\\infty.\n$$\n\nAlso, note that\n\n$$\n\\lim_{x\\to0^-}\\log_2{x} = \\textrm{DNE},\\qquad\\qquad \\lim_{x\\to0}\\log_2{x} = \\textrm{DNE}.\n$$\n\nThese properties are true for logarithms of any base $b\\gt 1.$" :tutorial/id #uuid "12a53922-65d6-5add-afe1-cbf5afcf1f1e" :tutorial/math-academy-id 2892 :tutorial/title "Infinite Limits and Limits at Infinity of Logarithmic Functions"} :step/id #uuid "ddeebcf7-8414-5bf9-aa2c-92ea6d072894" :step/math-academy-id 15584 :step/next {:db/id #edb/ref 17592186106606}} {:db/id #edb/ref 17592186106606 :step/content {:db/id #edb/ref 17592186105724 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105581 :question/id #uuid "16cc98d7-5998-5727-a5c8-659e88dc158e" :question/math-academy-id "e-4257"} :knowledge-point/id #uuid "f956a45f-29cb-5b78-a29f-3796e22af09d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049247} {:db/id #edb/ref 17592186050259}] :knowledge-point/questions [{:db/id #edb/ref 17592186106456} {:db/id #edb/ref 17592186106457} {:db/id #edb/ref 17592186233896} {:db/id #edb/ref 17592186234146} {:db/id #edb/ref 17592186234147} {:db/id #edb/ref 17592186564471} {:db/id #edb/ref 17592186564521}] :knowledge-point/title "Evaluating Limits at Infinity of Logarithmic Functions"} :step/id #uuid "2bb03a3f-9645-5c0b-9b4b-51be0f4e67c5" :step/math-academy-id 15585 :step/next {:db/id #edb/ref 17592186106608}} {:db/id #edb/ref 17592186106607 :step/content {:db/id #edb/ref 17592186105725 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105582 :question/id #uuid "f8cafc9c-8e5b-5b95-bdc9-aedded6ebf52" :question/math-academy-id "e-4258"} :knowledge-point/id #uuid "bae52078-17b6-536d-9cf8-4a92b811c2ae" :knowledge-point/questions [{:db/id #edb/ref 17592186106453} {:db/id #edb/ref 17592186106454} {:db/id #edb/ref 17592186234240} {:db/id #edb/ref 17592186234515} {:db/id #edb/ref 17592186564474} {:db/id #edb/ref 17592186564478} {:db/id #edb/ref 17592186570740}] :knowledge-point/title "Evaluating Infinite Limits of Logarithmic Functions"} :step/id #uuid "e9ffa842-4803-5023-b78c-905ecf2fa2a4" :step/math-academy-id 15586} {:db/id #edb/ref 17592186106608 :step/content {:db/id #edb/ref 17592186105726 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105583 :question/id #uuid "482f17ff-3008-5098-ad7e-18f1c72fb523" :question/math-academy-id "e-4259"} :knowledge-point/id #uuid "d107785c-82d2-5dbf-9293-e66fad67ba54" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050454}] :knowledge-point/questions [{:db/id #edb/ref 17592186106455} {:db/id #edb/ref 17592186106460} {:db/id #edb/ref 17592186233763} {:db/id #edb/ref 17592186233904} {:db/id #edb/ref 17592186234401} {:db/id #edb/ref 17592186234513} {:db/id #edb/ref 17592186234514} {:db/id #edb/ref 17592186564476} {:db/id #edb/ref 17592186564509}] :knowledge-point/title "Evaluating One-Sided Infinite Limits of Logarithmic Functions"} :step/id #uuid "6085ecf7-d126-56f1-a1dd-a3281f3b035b" :step/math-academy-id 15587 :step/next {:db/id #edb/ref 17592186106607}}] :activity/title "Limits of Logarithmic Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186106004}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186570875} :activity/id #uuid "305b1754-459f-5e23-bbf5-c6aeddd3beff" :activity/scope {:db/id #edb/ref 17592186050490 :topic/id #uuid "4d8d1b92-7074-5d18-8e35-15cd34d42567" :topic/math-academy-id 1377} :activity/steps [{:db/id #edb/ref 17592186570853 :step/content {:db/id #edb/ref 17592186570740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1320e23e-adb4-5b08-998c-94e38cda3275" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\infty" :db/id #edb/ref 17592186570161} {:answer/id #uuid "15d9b284-c74a-58f9-b7b8-47d504faf3ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186570166} {:answer/id #uuid "504ca40a-75a2-55af-8c3d-3557a719d902" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\infty" :db/id #edb/ref 17592186570266} {:answer/id #uuid "c0002cc8-289d-5260-80cb-a81a46bb58b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186570462} {:answer/id #uuid "e5867d94-88cf-53e1-8290-f2df95ac10c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186570525}] :answer-field/correct {:db/id #edb/ref 17592186570525} :answer-field/id #uuid "bec4ef46-c3c9-5b5f-b667-e3c769648f01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186570670}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6f0201d6-c736-51e8-8b5c-a5fa2133c2b7" :question/math-academy-id "q-67654" :question/problem "Calculate ${lim}_{x\\to (-1)}\\operatorname{ln}⁡(x+1).$" :question/worked-solution "Let's sketch the graph of $y=\\operatorname{ln}⁡(x+1).$\n\n![](images/52/52817b9c0ede04e8e920de8a52ebe025916f314cc937097c7fb91ea612e18f1b.png)\n\nThe function is not defined for $x\\le -1.$ Therefore,\n\n$$\n{lim}_{x\\to -{1}^{-}}\\operatorname{ln}⁡(x+1)=\\text{DNE}.\n$$\n\nHowever, the function is defined for $x>-1.$ Moreover,\n\n$$\n{lim}_{x\\to -{1}^{+}}\\operatorname{ln}⁡(x+1)=-\\infty .\n$$\n\nSince the left and right-sided limits are not equal, we have\n\n$$\n{lim}_{x\\to -1}\\operatorname{ln}⁡(x+1)=\\text{DNE}.\n$$"} :step/id #uuid "b9688c8c-f696-5a99-9e0f-4cedd962c3d3"} {:db/id #edb/ref 17592186570862 :step/content {:db/id #edb/ref 17592186106453 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5c20fa8-200a-506a-94c2-80fcfa6c7a0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "∞" :db/id #edb/ref 17592186104867} {:answer/id #uuid "fb678f74-246c-57d7-b868-cf5895ba3cc4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186104868} {:answer/id #uuid "25d991d4-55c5-5c1d-bfa4-c7e0a3ea1f30" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- ∞" :db/id #edb/ref 17592186104869} {:answer/id #uuid "7250aa1b-cc45-55a4-bb75-1bdbc872a474" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "DNE" :db/id #edb/ref 17592186104870} {:answer/id #uuid "7af864a1-8d1c-587b-b28f-ae7247b1d1f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186104871}] :answer-field/id #uuid "bab8e87b-d7ac-5191-a877-e9001cf37a7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186104866}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cd9f98b1-8823-50d1-9aca-175557f35e81" :question/math-academy-id "q-54451" :question/problem "Calculate $lim_(x → (-4))\\log_{2} (x + 4)$."} :step/id #uuid "d8cd7ccd-d160-50f1-b1f0-3764b14a4f54" :step/next {:db/id #edb/ref 17592186570853}} {:db/id #edb/ref 17592186570875 :step/content {:db/id #edb/ref 17592186234146 :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f3cfd611-2ed4-57ad-9eb8-915a29e67aa0" :question/math-academy-id "q-54448" :question/problem "${lim}_{x\\to -\\infty }\\operatorname{log}(2-7x)=$" :question/worked-solution "Let's sketch the graph of $y=\\operatorname{log}(2-7x).$\n\n![](images/b4/b4fcf2946431788963444f22bcd51b2a617b53dfc4bbfdd0d8b90bd9fd9304d2.png)\n\nFrom the graph, we see that the function increases without bound as $x$ decreases. Therefore,\n\n$$\n{lim}_{x\\to -\\infty }\\operatorname{log}(2-7x)=\\infty \n$$"} :step/id #uuid "f568387c-f695-56ad-a2dc-4c74c8af2e96" :step/next {:db/id #edb/ref 17592186570862}}] :activity/title "Limits of Logarithmic Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186570102}]}
