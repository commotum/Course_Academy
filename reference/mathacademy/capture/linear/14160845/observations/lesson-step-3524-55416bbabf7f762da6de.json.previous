{
  "dom_id": "step-3524",
  "name": "Example: \n                    Applying the Quotient Rule with Negative Exponents",
  "problem": "Simplify $\\dfrac{z^5}{z^{-3} }.$",
  "worked_solution": "We subtract the exponents, as follows:\n\n$$\n\\begin{aligned}\\frac{{z}^{5}}{{z}^{-3}} & = \\\\ {z}^{5-(-3)} & = \\\\ {z}^{5+3} & = \\\\ {z}^{8}\\end{aligned}\n$$",
  "calculator_instructions": "",
  "fields": [],
  "problem_field_keys": [],
  "answer_fields_complete": null,
  "result": null,
  "proof_feedback": null,
