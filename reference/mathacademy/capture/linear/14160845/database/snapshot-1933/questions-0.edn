\ {u}^{3} & \\end{aligned}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{u}^{5}\\cdot \\frac{{u}^{2}}{{u}^{4}}={u}^{3}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485494 :knowledge-point/_questions [{:db/id #edb/ref 17592186064300 :knowledge-point/id #uuid "fd5f2545-503b-503c-a1e6-294bfe966b2a" :knowledge-point/title "Applying the Quotient Rule and Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2655cd3b-2747-5203-9113-5c1c82e5f477" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186484888} {:answer/id #uuid "3dcd1809-ac2d-5261-ae5d-73e582ca6db3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{2}" :db/id #edb/ref 17592186484951} {:answer/id #uuid "4a5d0cba-b75a-5db6-8ed5-3ab5cbf01c72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{a}" :db/id #edb/ref 17592186484981} {:answer/id #uuid "daa1f54f-f802-5d5b-a24b-5777fb6a7514" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a" :db/id #edb/ref 17592186485277} {:answer/id #uuid "dfd7bb96-cae9-57b2-980a-b903d96581dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{4}" :db/id #edb/ref 17592186485288}] :answer-field/correct {:answer/id #uuid "2655cd3b-2747-5203-9113-5c1c82e5f477" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186484888} :answer-field/id #uuid "2f65387b-3f20-5940-81f4-84e80b5a99c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485386}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0e69e5e6-7016-5a90-88d1-935042e944fb" :question/math-academy-id "q-72677" :question/problem "Simplify ${a}^{5}\\cdot \\frac{{a}^{-3}}{{a}^{2}}.$" :question/worked-solution "First we apply the quotient rule, subtracting exponents in the fraction:\n\n$$\n\\begin{aligned}{a}^{5}\\cdot \\frac{{a}^{-3}}{{a}^{2}} & = \\\\ {a}^{5}\\cdot {a}^{(-3-2)} & = \\\\ {a}^{5}\\cdot {a}^{-5} & \\end{aligned}\n$$\n\nThen we apply the product rule, adding exponents in the product:\n\n$$\n\\begin{aligned}\\begin{aligned}{a}^{5}\\cdot {a}^{-5} & = \\\\ {a}^{5+(-5)} & = \\\\ {a}^{5-5} & = \\\\ {a}^{0} & = \\\\ 1 & \\end{aligned}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{a}^{5}\\cdot \\frac{{a}^{-3}}{{a}^{2}}=1.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485519 :knowledge-point/_questions [{:db/id #edb/ref 17592186064300 :knowledge-point/id #uuid "fd5f2545-503b-503c-a1e6-294bfe966b2a" :knowledge-point/title "Applying the Quotient Rule and Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36100c30-c4a8-5793-b8d3-4e0f727b569a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{14}" :db/id #edb/ref 17592186484931} {:answer/id #uuid "aec841b0-1b3a-503b-aa83-5840f21c3f9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{12}" :db/id #edb/ref 17592186485195} {:answer/id #uuid "c47043fe-0892-5394-979e-3e1a613032ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{-3}" :db/id #edb/ref 17592186485238} {:answer/id #uuid "de68479f-5cc4-51ec-9379-a49578fc8571" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{-12}" :db/id #edb/ref 17592186485283} {:answer/id #uuid "faa77c94-d4f3-50ef-910c-42b7691e88dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{5}" :db/id #edb/ref 17592186485355}] :answer-field/correct {:answer/id #uuid "faa77c94-d4f3-50ef-910c-42b7691e88dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{5}" :db/id #edb/ref 17592186485355} :answer-field/id #uuid "8002220d-d13b-50ca-8bb3-c0601d2f074c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485419}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3be04767-4c26-5347-b891-6186a74ead6b" :question/math-academy-id "q-72679" :question/problem "Simplify the  expression\n$\\frac{n}{{n}^{4}}\\cdot {n}^{8}.$" :question/worked-solution "First we apply the quotient rule, subtracting exponents in the fraction:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{n}{{n}^{4}}\\cdot {n}^{8} & = \\\\ {n}^{1-4}\\cdot {n}^{8} & = \\\\ {n}^{-3}\\cdot {n}^{8} & \\end{aligned}\\end{aligned}\n$$\n\nThen we apply the product rule, adding exponents in the product:\n\n$$\n\\begin{aligned}\\begin{aligned}{n}^{-3}\\cdot {n}^{8} & = \\\\ {n}^{-3+8} & = \\\\ {n}^{5} & \\end{aligned}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{n}{{n}^{4}}\\cdot {n}^{8}={n}^{5}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485553 :knowledge-point/_questions [{:db/id #edb/ref 17592186064300 :knowledge-point/id #uuid "fd5f2545-503b-503c-a1e6-294bfe966b2a" :knowledge-point/title "Applying the Quotient Rule and Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00ddfa3b-7d8d-5460-89cf-64315fc87036" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{q}^{5}}" :db/id #edb/ref 17592186484815} {:answer/id #uuid "4692b4b8-c0ef-5a31-bbc7-0c0cee5491eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{q}^{5}" :db/id #edb/ref 17592186484967} {:answer/id #uuid "46a86097-4fe5-5eec-b23c-2d48991beefe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{q}^{3}" :db/id #edb/ref 17592186484968} {:answer/id #uuid "64ef98c1-92eb-56d9-954f-a4978e35f40c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{q}^{3}}" :db/id #edb/ref 17592186485037} {:answer/id #uuid "e0f90363-cd83-574a-8e4c-59b61b493419" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186485292}] :answer-field/correct {:answer/id #uuid "64ef98c1-92eb-56d9-954f-a4978e35f40c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{q}^{3}}" :db/id #edb/ref 17592186485037} :answer-field/id #uuid "18a56d48-4b3b-5ee9-aa5b-0b92f3bd8a6d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485377}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8ac0604e-5343-56c6-8dd6-8c555b217bdc" :question/math-academy-id "q-72682" :question/problem "Simplify the  expression\n${q}^{2}\\cdot \\frac{{q}^{3}}{{q}^{8}}.$" :question/worked-solution "First we apply the quotient rule, subtracting exponents in the fraction:\n\n$$\n\\begin{aligned}\\begin{aligned}{q}^{2}\\cdot \\frac{{q}^{3}}{{q}^{8}} & = \\\\ {q}^{2}\\cdot {q}^{3-8} & = \\\\ {q}^{2}\\cdot {q}^{-5} & \\end{aligned}\\end{aligned}\n$$\n\nThen we apply the product rule, adding exponents in the product:\n\n$$\n\\begin{aligned}\\begin{aligned}{q}^{2}\\cdot {q}^{-5} & = \\\\ {q}^{2+(-5)} & = \\\\ {q}^{2-5} & = \\\\ {q}^{-3} & = \\\\ \\frac{1}{{q}^{3}} & \\end{aligned}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{q}^{2}\\cdot \\frac{{q}^{3}}{{q}^{8}}=\\frac{1}{{q}^{3}}.\\end{aligned}\\end{aligned}\n$$"}]}
