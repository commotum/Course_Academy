#{[{:db/id #edb/ref 17592186063919 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064298 :knowledge-point/id #uuid "577ff555-4622-5388-8bc3-b49fa39c5674" :knowledge-point/title "Applying the Quotient Rule for Exponents"}] :question/id #uuid "46a52c71-86ed-5e9c-a1cb-f2110a4c6484" :question/math-academy-id "e-1073" :question/problem "Simplify $\\dfrac{x^2}{x^3}.$" :question/worked-solution "We subtract the exponents, as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{x}^{3}} & = \\\\ {x}^{(2-3)} & = \\\\ {x}^{-1}\\end{aligned}\n$$\n\nThen, we convert the negative exponent to a positive exponent by taking the reciprocal:\n\n$$\n\\begin{aligned}{x}^{-1} & =\\frac{1}{x}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\dfrac{x^2}{x^3} = \\dfrac 1 x.\n$$"}] [{:db/id #edb/ref 17592186063920 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064299 :knowledge-point/id #uuid "c099e644-e8e1-5889-a228-af1e38fff0f7" :knowledge-point/title "Applying the Quotient Rule with Negative Exponents"}] :question/id #uuid "d09010dc-a725-5d22-91ba-cb4372187dbc" :question/math-academy-id "e-1074" :question/problem "Simplify $\\dfrac{z^5}{z^{-3} }.$" :question/worked-solution "We subtract the exponents, as follows:\n\n$$\n\\begin{aligned}\\frac{{z}^{5}}{{z}^{-3}} & = \\\\ {z}^{5-(-3)} & = \\\\ {z}^{5+3} & = \\\\ {z}^{8}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063921 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064300 :knowledge-point/id #uuid "fd5f2545-503b-503c-a1e6-294bfe966b2a" :knowledge-point/title "Applying the Quotient Rule and Product Rule"}] :question/id #uuid "a8d19b4c-5361-5520-b0c9-7f6667b6a1c4" :question/math-academy-id "e-1075" :question/problem "Simplify the  expression $\\dfrac {p^7} {p^2}  \\cdot p^3 .$" :question/worked-solution "First we apply the quotient rule, subtracting exponents in the fraction:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{{p}^{7}}{{p}^{2}}\\cdot {p}^{3} & = \\\\ {p}^{(7-2)}\\cdot {p}^{3} & = \\\\ {p}^{5}\\cdot {p}^{3}\\end{aligned}\\end{aligned}\n$$\n\nThen we apply the product rule, adding exponents in the product:\n\n$$\n\\begin{aligned}\\begin{aligned}{p}^{5}\\cdot {p}^{3} & = \\\\ {p}^{(5+3)} & = \\\\ {p}^{8}\\end{aligned}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{{p}^{7}}{{p}^{2}}\\cdot {p}^{3}={p}^{8}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485592 :knowledge-point/_questions [{:db/id #edb/ref 17592186064300 :knowledge-point/id #uuid "fd5f2545-503b-503c-a1e6-294bfe966b2a" :knowledge-point/title "Applying the Quotient Rule and Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32b1c548-49f0-5278-ade5-87ae9a836c68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}^{16}" :db/id #edb/ref 17592186484924} {:answer/id #uuid "3cc7469a-4c5a-5c02-a707-a6d244caa391" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}^{2}" :db/id #edb/ref 17592186484944} {:answer/id #uuid "68550f76-8068-5a20-95d4-041e618def53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v" :db/id #edb/ref 17592186485044} {:answer/id #uuid "da946435-d01a-5a40-bc6e-afdd394c6d14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{v}^{16}}" :db/id #edb/ref 17592186485276} {:answer/id #uuid "e9bbb3c6-e4c5-5c33-82a6-4a8eea794f84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{v}^{2}}" :db/id #edb/ref 17592186485312}] :answer-field/correct {:answer/id #uuid "3cc7469a-4c5a-5c02-a707-a6d244caa391" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}^{2}" :db/id #edb/ref 17592186484944} :answer-field/id #uuid "ca0326c8-0f04-5e25-9913-33c2c01289fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485452}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "faa7323c-2fa9-5fe0-9081-c51997dba998" :question/math-academy-id "q-104629" :question/problem "Simplify the  expression\n${v}^{9}\\cdot \\frac{{v}^{5}}{{v}^{12}}.$" :question/worked-solution "First we apply the quotient rule, subtracting exponents in the fraction:\n\n$$\n\\begin{aligned}\\begin{aligned}{v}^{9}\\cdot \\frac{{v}^{5}}{{v}^{12}} & = \\\\ {v}^{9}\\cdot {v}^{5-12} & = \\\\ {v}^{9}\\cdot {v}^{-7} & \\end{aligned}\\end{aligned}\n$$\n\nThen we apply the product rule, adding exponents in the product:\n\n$$\n\\begin{aligned}\\begin{aligned}{v}^{9}\\cdot {v}^{-7} & = \\\\ {v}^{9+(-7)} & = \\\\ {v}^{9-7} & = \\\\ {v}^{2}\\end{aligned}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{v}^{9}\\cdot \\frac{{v}^{5}}{{v}^{12}}={v}^{2}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485583 :knowledge-point/_questions [{:db/id #edb/ref 17592186064298 :knowledge-point/id #uuid "577ff555-4622-5388-8bc3-b49fa39c5674" :knowledge-point/title "Applying the Quotient Rule for Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15652b6a-f89d-5b13-ba4c-c9109edd3ae2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{-3}" :db/id #edb/ref 17592186484859} {:answer/id #uuid "17330892-079d-594f-9793-ca9800def76b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{3}" :db/id #edb/ref 17592186484863} {:answer/id #uuid "4539c934-06dc-505d-9c83-4c4e5581015d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{-6}" :db/id #edb/ref 17592186484965} {:answer/id #uuid "86e3f884-9987-5e1b-b338-f3d6361f1272" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{r}^{6}}" :db/id #edb/ref 17592186485109} {:answer/id #uuid "f