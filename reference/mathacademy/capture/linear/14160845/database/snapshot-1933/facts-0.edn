edb/ref 17592186179816 #edb/ref 17592186045417] [17592186051009 #edb/ref 1031 "Constructing Algebraic Expressions" #edb/ref 17592186045417] [17592186051009 #edb/ref 1033 3721 #edb/ref 17592186045417] [17592186051009 #edb/ref 1035 #uuid "7931e951-f0f8-5132-97e2-67fa64802a65" #edb/ref 17592186045417] [17592186063540 #edb/ref 1075 #edb/ref 17592186063543 #edb/ref 17592186045417] [17592186063540 #edb/ref 1075 #edb/ref 17592186485042 #edb/ref 17592186045417] [17592186063540 #edb/ref 1075 #edb/ref 17592186485081 #edb/ref 17592186045417] [17592186063540 #edb/ref 1075 #edb/ref 17592186485188 #edb/ref 17592186045417] [17592186063540 #edb/ref 1075 #edb/ref 17592186485210 #edb/ref 17592186045417] [17592186063540 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186063540 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186063540 #edb/ref 1078 #edb/ref 17592186485042 #edb/ref 17592186045417] [17592186063540 #edb/ref 1079 #uuid "8141b8b3-9a6c-5d0e-8486-e37d0221dabc" #edb/ref 17592186045417] [17592186063543 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186063543 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186063543 #edb/ref 1083 #uuid "d293c221-9b9a-5d3c-b74a-958f1204db3c" #edb/ref 17592186045417] [17592186063919 #edb/ref 1069 "e-1073" #edb/ref 17592186045417] [17592186063919 #edb/ref 1071 "Simplify $\\dfrac{x^2}{x^3}.$" #edb/ref 17592186045417] [17592186063919 #edb/ref 1072 #uuid "46a52c71-86ed-5e9c-a1cb-f2110a4c6484" #edb/ref 17592186045417] [17592186063919 #edb/ref 1074 "We subtract the exponents, as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{x}^{3}} & = \\\\ {x}^{(2-3)} & = \\\\ {x}^{-1}\\end{aligned}\n$$\n\nThen, we convert the negative exponent to a positive exponent by taking the reciprocal:\n\n$$\n\\begin{aligned}{x}^{-1} & =\\frac{1}{x}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\dfrac{x^2}{x^3} = \\dfrac 1 x.\n$$" #edb/ref 17592186045417] [17592186063920 #edb/ref 1069 "e-1074" #edb/ref 17592186045417] [17592186063920 #edb/ref 1071 "Simplify $\\dfrac{z^5}{z^{-3} }.$" #edb/ref 17592186045417] [17592186063920 #edb/ref 1072 #uuid "d09010dc-a725-5d22-91ba-cb4372187dbc" #edb/ref 17592186045417] [17592186063920 #edb/ref 1074 "We subtract the exponents, as follows:\n\n$$\n\\begin{aligned}\\frac{{z}^{5}}{{z}^{-3}} & = \\\\ {z}^{5-(-3)} & = \\\\ {z}^{5+3} & = \\\\ {z}^{8}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186063921 #edb/ref 1069 "e-1075" #edb/ref 17592186045417] [17592186063921 #edb/ref 1071 "Simplify the  expression $\\dfrac {p^7} {p^2}  \\cdot p^3 .$" #edb/ref 17592186045417] [17592186063921 #edb/ref 1072 #uuid "a8d19b4c-5361-5520-b0c9-7f6667b6a1c4" #edb/ref 17592186045417] [17592186063921 #edb/ref 1074 "First we apply the quotient rule, subtracting exponents in the fraction:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{{p}^{7}}{{p}^{2}}\\cdot {p}^{3} & = \\\\ {p}^{(7-2)}\\cdot {p}^{3} & = \\\\ {p}^{5}\\cdot {p}^{3}\\end{aligned}\\end{aligned}\n$$\n\nThen we apply the product rule, adding exponents in the product:\n\n$$\n\\begin{aligned}\\begin{aligned}{p}^{5}\\cdot {p}^{3} & = \\\\ {p}^{(5+3)} & = \\\\ {p}^{8}\\end{aligned}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{{p}^{7}}{{p}^{2}}\\cdot {p}^{3}={p}^{8}.\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186064298 #edb/ref 1037 #edb/ref 17592186049081 #edb/ref 17592186045417] [17592186064298 #edb/ref 1037 #edb/ref 17592186051009 #edb/ref 17592186045417] [17592186064298 #edb/ref 1038 #edb/ref 17592186064748 #edb/ref 17592186045417] [17592186064298 #edb/ref 1038 #edb/ref 17592186064914 #edb/ref 17592186045417] [17592186064298 #edb/ref 1038 #edb/ref 17592186485583 #edb/ref 17592186045417] [17592186064298 #edb/ref 1039 "Applying the Quotient Rule for Exponents" #edb/ref 17592186045417] [17592186064298 #edb/ref 1041 #edb/ref 17592186063919 #edb/ref 17592186045417] [17592186064298 #edb/ref 1042 #uuid "577ff555-4622-5388-8bc3-b49fa39c5674" #edb/ref 17592186045417] [175921