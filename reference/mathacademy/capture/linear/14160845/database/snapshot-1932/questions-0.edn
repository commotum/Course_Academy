#{[{:db/id #edb/ref 17592186063919 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064298 :knowledge-point/id #uuid "577ff555-4622-5388-8bc3-b49fa39c5674" :knowledge-point/title "Applying the Quotient Rule for Exponents"}] :question/id #uuid "46a52c71-86ed-5e9c-a1cb-f2110a4c6484" :question/math-academy-id "e-1073" :question/problem "Simplify $\\dfrac{x^2}{x^3}$." :question/worked-solution "We subtract the exponents, as follows:\n\n$$\n\\begin{aligned}\n\\frac{x^{2}}{x^{3}} &=  \\\\\nx^{(2 - 3)} &=  \\\\\n&= x^{-1}\n\\end{aligned}\n$$\n\nThen, we convert the negative exponent to a positive exponent by taking the reciprocal:\n\n$$\n\\begin{aligned}\nx^{-1} &= \\frac{1}{x}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\dfrac{x^2}{x^3} = \\dfrac 1 x\n$$"}] [{:db/id #edb/ref 17592186063920 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064299 :knowledge-point/id #uuid "c099e644-e8e1-5889-a228-af1e38fff0f7" :knowledge-point/title "Applying the Quotient Rule with Negative Exponents"}] :question/id #uuid "d09010dc-a725-5d22-91ba-cb4372187dbc" :question/math-academy-id "e-1074" :question/problem "Simplify $\\dfrac{z^5}{z^{-3}}$." :question/worked-solution "We subtract the exponents, as follows:\n\n$$\n\\begin{aligned}\n\\frac{z^{5}}{z^{-3}} &=  \\\\\nz^{5 - (-3)} &=  \\\\\nz^{5 + 3} &=  \\\\\n&= z^{8}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063921 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064300 :knowledge-point/id #uuid "fd5f2545-503b-503c-a1e6-294bfe966b2a" :knowledge-point/title "Applying the Quotient Rule and Product Rule"}] :question/id #uuid "a8d19b4c-5361-5520-b0c9-7f6667b6a1c4" :question/math-academy-id "e-1075" :question/problem "Simplify the expression $\\dfrac {p^7} {p^2} \\cdot p^3$." :question/worked-solution "First we apply the quotient rule, subtracting exponents in the fraction:\n\n$$\n\\begin{aligned}\n\\frac{p^{7}}{p^{2}} \\cdot p^{3} &=  \\\\\np^{(7 - 2)} \\cdot p^{3} &=  \\\\\n&= p^{5} \\cdot p^{3}\n\\end{aligned}\n$$\n\nThen we apply the product rule, adding exponents in the product:\n\n$$\n\\begin{aligned}\np^{5} \\cdot p^{3} &=  \\\\\np^{(5 + 3)} &=  \\\\\n&= p^{8}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{p^{7}}{p^{2}} \\cdot p^{3} = p^{8}\n$$"}] [{:db/id #edb/ref 17592186064914 :knowledge-point/_questions [{:db/id #edb/ref 17592186064298 :knowledge-point/id #uuid "577ff555-4622-5388-8bc3-b49fa39c5674" :knowledge-point/title "Applying the Quotient Rule for Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2943646-870e-58a6-8ad3-6d150621a64a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{a^{14}}" :db/id #edb/ref 17592186063541} {:answer/id #uuid "cc9d975f-73ec-5e03-bec5-45d24cbdb5fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a^{4}" :db/id #edb/ref 17592186063542} {:answer/id #uuid "d293c221-9b9a-5d3c-b74a-958f1204db3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186063543} {:answer/id #uuid "37b43096-5069-5c16-9e42-3d07f0f56f1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{a^{4}}" :db/id #edb/ref 17592186063544} {:answer/id #uuid "3954d0eb-0650-575f-ac38-edfa99193237" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a^{14}" :db/id #edb/ref 17592186063545}] :answer-field/id #uuid "8141b8b3-9a6c-5d0e-8486-e37d0221dabc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186063540}] :question/id #uuid "5e67fcd0-74f3-542c-ab05-d6c58bbf219a" :question/math-academy-id "q-60572" :question/problem "What is $\\frac{a^{5}}{a^{9}}$?"}]}
