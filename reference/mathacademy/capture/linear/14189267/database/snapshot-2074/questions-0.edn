#{[{:db/id #edb/ref 17592186087433 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087686 :knowledge-point/id #uuid "353a2fb8-5677-5047-8f39-595f43d9eeb9" :knowledge-point/title "Identifying Parallel Lines Given in Slope-Intercept Form"}] :question/id #uuid "4f0593d8-bce5-5c73-aedd-ffe0faf15a59" :question/math-academy-id "e-14364" :question/problem "The lines $y=cx+7$ and $y=5x-3$ are parallel. What is the value of $c$?" :question/worked-solution "For two lines to be parallel, they must have the same slope.\n\nBoth lines are in slope-intercept form, so we can pick out the slope of each equation by looking at the $x$-coefficient.\n\n- The slope of the line $y=cx+7$ is $c$.\n- The slope of the line $y=5x-3$ is $5$.\n\nBecause the slopes must be the same, we must have $c=5$."}] [{:db/id #edb/ref 17592186087434 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087687 :knowledge-point/id #uuid "d5bf8c8b-64f1-5552-a59e-78eef021c122" :knowledge-point/title "Identifying Parallel Lines Given in Standard Form"}] :question/id #uuid "b2f31785-e173-518c-a1fd-b069e0834b2a" :question/math-academy-id "e-14367" :question/problem "Which of the following lines is parallel to $12x - y=3$?\n\n1. $y=4x-8$\n2. $y=12x+1$\n3. $y=3x-12$" :question/worked-solution "For two lines to be parallel, they must have the same slope.\n\nTo find the slope of the line $12x-y=3$, we convert to slope-intercept form:\n\n$$\n\\begin{aligned}\n12x - y &= 3 \\\\\n- y &= -12x + 3 \\\\\ny &= 12x - 3\n\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope is $12$.\n\nFrom the given options, the only line that has a slope of $12$ is\n\n$$\ny = 12x+1\n$$"}] [{:db/id #edb/ref 17592186087435 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087688 :knowledge-point/id #uuid "43401830-730c-57d7-8831-9a0580042ffe" :knowledge-point/title "Finding Unknown Parameters"}] :question/id #uuid "88c5f90c-9bf9-58a2-a9a2-7c7ff1fc4f8a" :question/math-academy-id "e-14370" :question/problem "The lines $y=2x$ and $kx-2y=-1$ are parallel. What is the value of $k$?" :question/worked-solution "For two lines to be parallel, they must have the same slope.\n\n- The line $y=2x$ is in slope-intercept form, and its slope is $2$.\n- To find the slope of the line $kx-2y=-1$, we convert to slope-intercept form:\n$kx - 2y|=-1; - 2y|=-kx - 1; 2y|= kx + 1; y|= \\frac{k}{2}x + \\frac{1}{2}$\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope is $\\dfrac{k}{2}$.\n\nSince the slopes of the two lines must be equal, we must have\n\n$$\n\\dfrac{k}{2}=2\n$$\n\nConsequently, $k=4$."}] [{:db/id #edb/ref 17592186088003 :knowledge-point/_questions [{:db/id #edb/ref 17592186087687 :knowledge-point/id #uuid "d5bf8c8b-64f1-5552-a59e-78eef021c122" :knowledge-point/title "Identifying Parallel Lines Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eba8ed3a-e9e6-572d-8f63-2af14720b605" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = 8x - 3" :db/id #edb/ref 17592186084753} {:answer/id #uuid "f142c471-0c73-5027-a095-f1f7d546e328" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y =-x - 2" :db/id #edb/ref 17592186084754} {:answer/id #uuid "f3c15800-7ce4-5396-9281-1383a52cea32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = 2x + 1" :db/id #edb/ref 17592186084755} {:answer/id #uuid "272782b2-6790-5674-984f-51d44fa23337" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y =-2x + 4" :db/id #edb/ref 17592186084756} {:answer/id #uuid "50e98dd6-1638-5596-814d-46afe7764172" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = 16x" :db/id #edb/ref 17592186084757}] :answer-field/id #uuid "bd77a636-6d7b-542f-8b77-f6789c29dbfc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084752}] :question/id #uuid "18660893-6110-5df8-bfd8-f3d922709ebc" :question/math-academy-id "q-13400" :question/problem "Which of the following lines is parallel to $8x - y = 2$?"}] [{:db/id #edb/ref 17592186088068 :knowledge-point/_questions [{:db/id #edb/ref 17592186087688 :knowledge-point/id #uuid "43401830-730c-57d7-8831-9a0580042ffe" :knowledge-point/title "Finding Unknown Parameters"}] :question/answer-fields [{:answer-field/id #uuid "ad8dd299-34e2-51c8-9ba6-9b32de88cb92" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186085129}] :question/id #uuid "93f5de54-6bcd-5688-b2b5-e060b8822757" :question/math-academy-id "q-214099" :question/problem "The lines $8x - 2y =-2$ and $kx - 5y = 15$ are parallel. What is the value of $k$?$k =$\n{{field-1}}"}]}
