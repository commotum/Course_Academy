#{[{:db/id #edb/ref 17592186087433 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087686 :knowledge-point/id #uuid "353a2fb8-5677-5047-8f39-595f43d9eeb9" :knowledge-point/title "Identifying Parallel Lines Given in Slope-Intercept Form"}] :question/id #uuid "4f0593d8-bce5-5c73-aedd-ffe0faf15a59" :question/math-academy-id "e-14364" :question/problem "The lines $y=cx+7$ and $y=5x-3$ are parallel. What is the value of $c$?" :question/worked-solution "For two lines to be parallel, they must have the same slope.\n\nBoth lines are in slope-intercept form, so we can pick out the slope of each equation by looking at the $x$-coefficient.\n\n- The slope of the line $y=cx+7$ is $c.$\n\n- The slope of the line $y=5x-3$ is $5.$\n\nBecause the slopes must be the same, we must have $c=5.$"}] [{:db/id #edb/ref 17592186087434 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087687 :knowledge-point/id #uuid "d5bf8c8b-64f1-5552-a59e-78eef021c122" :knowledge-point/title "Identifying Parallel Lines Given in Standard Form"}] :question/id #uuid "b2f31785-e173-518c-a1fd-b069e0834b2a" :question/math-academy-id "e-14367" :question/problem "Which of the following lines is parallel to $12x - y=3?$\n\nI. $y=4x-8$\n\nII. $y=12x+1$\n\nIII. $y=3x-12$" :question/worked-solution "For two lines to be parallel, they must have the same slope.\n\nTo find the slope of the line $12x-y=3,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}12x-y & =3 \\\\ -y & =-12x+3 \\\\ y & =12x-3.\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope is $12.$\n\nFrom the given options, the only line that has a slope of $12$ is $y = 12x+1.$"}] [{:db/id #edb/ref 17592186087435 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087688 :knowledge-point/id #uuid "43401830-730c-57d7-8831-9a0580042ffe" :knowledge-point/title "Finding Unknown Parameters"}] :question/id #uuid "88c5f90c-9bf9-58a2-a9a2-7c7ff1fc4f8a" :question/math-academy-id "e-14370" :question/problem "The lines $y=2x$ and $kx-2y=-1$ are parallel. What is the value of $k?$" :question/worked-solution "For two lines to be parallel, they must have the same slope.\n\n- The line $y=2x$ is in slope-intercept form, and its slope is $2.$\n\n- To find the slope of the line $kx-2y=-1,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}kx-2y & =-1 \\\\ -2y & =-kx-1 \\\\ 2y & =kx+1 \\\\ y & =\\frac{k}{2}x+\\frac{1}{2}\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope is $\\dfrac{k}{2}.$\n\nSince the slopes of the two lines must be equal, we must have $\\dfrac{k}{2}=2.$ Consequently, $k=4.$"}] [{:db/id #edb/ref 17592186502071 :knowledge-point/_questions [{:db/id #edb/ref 17592186087688 :knowledge-point/id #uuid "43401830-730c-57d7-8831-9a0580042ffe" :knowledge-point/title "Finding Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6575d776-7f8b-5b97-9011-4e59f2270332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186501653} {:answer/id #uuid "7106821d-c7b4-548f-a75f-09d537e7d3d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186501673} {:answer/id #uuid "cc3ee1a9-76b7-5435-96c4-77dce8a3e24a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186501873} {:answer/id #uuid "d7e707d3-9f9a-5e23-abbd-a7d263426dc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186501896} {:answer/id #uuid "e90a4bce-59f2-5446-ae05-de09cf654ac9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186501937}] :answer-field/correct {:answer/id #uuid "cc3ee1a9-76b7-5435-96c4-77dce8a3e24a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186501873} :answer-field/id #uuid "657d9ac1-f6be-595b-b713-0c7e495af6bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502010}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0a195cf2-04b2-54a7-a4cb-7f79ce0266f0" :question/math-academy-id "q-110095" :question/problem "The lines $y=-3x+1$ and $kx-2y=12$ are parallel. The value of $k=$" :question/worked-solution "For two lines to be parallel, they must have the same slope.\n\n- The line $y=-3x+1$ is in slope-intercept form, and its slope is $-3.$\n\n- To find the slope of the line $kx-2y=12,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}kx-2y & =12 \\\\ -2y & =-kx+12 \\\\ 2y & =kx-12 \\\\ y & =\\frac{k}{2}x-6\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope is $\\frac{k}{2}.$\n\nSince the slopes of the two lines must be equal, we must have $\\frac{k}{2}=-3.$ Consequently, $k=-6.$"}] [{:db/id #edb/ref 17592186502088 :knowledge-point/_questions [{:db/id #edb/ref 17592186087688 :knowledge-point/id #uuid "43401830-730c-57d7-8831-9a0580042ffe" :knowledge-point/title "Finding Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35eec1dd-4c49-50dd-9f3d-b76b51f36587" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186501564} {:answer/id #uuid "3d5ed668-45b9-5e68-aacd-a1d7b77b0d34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186501575} {:answer/id #uuid "68fe6cc0-1600-5a47-9f88-95202793571d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186501659} {:answer/id #uuid "6a194ac4-0015-5288-8e78-47cdee62ba55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186501662} {:answer/id #uuid "a7c2211f-deb4-54e0-a62a-93580ba3e9eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186501791}] :answer-field/correct {:answer/id #uuid "3d5ed668-45b9-5e68-aacd-a1d7b77b0d34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186501575} :answer-field/id #uuid "5e2cbc20-a3be-526b-a577-9ccc1fc2af26" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502007}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2f90abbd-1fee-558b-aa1d-be0b1bb7d5ca" :question/math-academy-id "q-110102" :question/problem "For what value of $k$ are the lines $2x-4y=8$ and $kx+2y=12$ parallel?" :question/worked-solution "For two lines to be parallel, they must have the same slope.\n\n- To find the slope of the line $2x-4y=8,$ we convert to slope-intercept form, as follows:\n\n$$\n\\begin{aligned}2x-4y & =8 \\\\ -4y & =-2x+8 \\\\ 4y & =2x-8 \\\\ y & =\\frac{1}{2}x-2\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope is $\\frac{1}{2}.$\n\n- To find the slope of the line $kx+2y=12,$ we convert to slope-intercept form, as follows:\n\n$$\n\\begin{aligned}kx+2y & =12 \\\\ 2y & =-kx+12 \\\\ y & =-\\frac{k}{2}x+6\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope is $-\\frac{k}{2}.$\n\nSince the slopes of the two lines must be equal, we must have $-\\frac{k}{2}=\\frac{1}{2}.$ We solve for $k:$\n\n$$\n\\begin{aligned}-\\frac{k}{2} & =\\frac{1}{2} \\\\ \\frac{k}{2} & =-\\frac{1}{2} \\\\ k & =-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186088003 :knowledge-point/_questions [{:db/id #edb/ref 17592186087687 :knowledge-point/id #uuid "d5bf8c8b-64f1-5552-a59e-78eef021c122" :knowledge-point/title "Identifying Parallel Lines Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b7d9d0a-4938-5758-bef7-3f54c308a828" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=8x-3" :db/id #edb/ref 17592186501636} {:answer/id #uuid "5c1ce75d-066c-56fa-a447-9bc0e4fb0ecf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2x+4" :db/id #edb/ref 17592186501637} {:answer/id #uuid "a0ba89fb-60f7-5fc6-a5b8-1badc793089e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x-2" :db/id #edb/ref 17592186501769} {:answer/id #uuid "b4a7c51a-8f42-5ba3-bd46-8379e75ac83f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+1" :db/id #edb/ref 17592186501828} {:answer/id #uuid "da3addca-0b1d-53d7-9827-4676fc539386" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=16x" :db/id #edb/ref 17592186501902}] :answer-field/correct {:answer/id #uuid "5b7d9d0a-4938-5758-bef7-3f54c308a828" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=8x-3" :db/id #edb/ref 17592186501636} :answer-field/id #uuid "bd77a636-6d7b-542f-8b77-f6789c29dbfc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084752}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "18660893-6110-5df8-bfd8-f3d922709ebc" :question/math-academy-id "q-13400" :question/problem "Which of the following lines is parallel to $8x-y=2?$" :question/worked-solution "For two lines to be parallel, they must have the same slope.\n\nTo find the slope of the line $8x-y=2,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}8x-y & =2 \\\\ -y & =-8x+2 \\\\ y & =8x-2.\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope is $8.$\n\nFrom the given options, the only line that has a slope of $8$ is $y=8x-3.$"}] [{:db/id #edb/ref 17592186088068 :knowledge-point/_questions [{:db/id #edb/ref 17592186087688 :knowledge-point/id #uuid "43401830-730c-57d7-8831-9a0580042ffe" :knowledge-point/title "Finding Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67310dbd-b4ba-5314-aa75-e34ad505fc34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186501655}] :answer-field/correct {:answer/id #uuid "67310dbd-b4ba-5314-aa75-e34ad505fc34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186501655} :answer-field/id #uuid "ad8dd299-34e2-51c8-9ba6-9b32de88cb92" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186085129}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "93f5de54-6bcd-5688-b2b5-e060b8822757" :question/math-academy-id "q-214099" :question/problem "The lines $8x-2y=-2$ and $kx-5y=15$ are parallel. What is the value of $k?$\n\n$k=$\n\n{{field-1}}" :question/worked-solution "For two lines to be parallel, they must have the same slope.\n\n- To find the slope of the line $8x-2y=-2,$ we convert to slope-intercept form, as follows:\n\n$$\n\\begin{aligned}8x-2y & =-2 \\\\ -2y & =-8x-2 \\\\ 2y & =8x+2 \\\\ y & =4x+1\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope is $4.$\n\n- To find the slope of the line $kx-5y=15,$ we convert to slope-intercept form, as follows:\n\n$$\n\\begin{aligned}kx-5y & =15 \\\\ -5y & =-kx+15 \\\\ 5y & =kx-15 \\\\ y & =\\frac{k}{5}x-3\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope is $\\frac{k}{5}.$\n\nSince the slopes of the two lines must be equal, we must have $\\frac{k}{5}=4.$ We solve for $k:$\n\n$$\n\\begin{aligned}\\frac{k}{5} & =4 \\\\ k & =20\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502083 :knowledge-point/_questions [{:db/id #edb/ref 17592186087686 :knowledge-point/id #uuid "353a2fb8-5677-5047-8f39-595f43d9eeb9" :knowledge-point/title "Identifying Parallel Lines Given in Slope-Intercept Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73f0fb36-6abf-5a5a-bfdf-05576227c4f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186501679}] :answer-field/correct {:answer/id #uuid "73f0fb36-6abf-5a5a-bfdf-05576227c4f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186501679} :answer-field/id #uuid "f09cc482-8990-5f8f-aec3-23bc08a4425c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186502056}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "26dd17ae-021a-54b3-9443-27a8619f8c0b" :question/math-academy-id "q-215722" :question/problem "The lines $y=\\frac{2}{3}x+4$ and $y=mx+2$ are parallel.  What is the value of $m?$\n\n$m=$\n{{field-1}}" :question/worked-solution "For two lines to be parallel, they must have the same slope.\n\nBoth lines are in slope-intercept form, so we can pick out the slope of each equation by looking at the $x$-coefficient.\n\n- The slope of the line $y=\\frac{2}{3}x+4$ is $\\frac{2}{3}.$\n\n- The slope of the line $y=mx+2$ is $m.$\n\nBecause the slopes must be the same, we must have $m=\\frac{2}{3}.$"}] [{:db/id #edb/ref 17592186502109 :knowledge-point/_questions [{:db/id #edb/ref 17592186087687 :knowledge-point/id #uuid "d5bf8c8b-64f1-5552-a59e-78eef021c122" :knowledge-point/title "Identifying Parallel Lines Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "124a7bb7-ae6e-503b-b2b6-2d040b8f853d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6x+3" :db/id #edb/ref 17592186501498} {:answer/id #uuid "341534a0-7fae-50cc-ab8a-3b36904892d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x+8" :db/id #edb/ref 17592186501561} {:answer/id #uuid "a82da13f-ae7d-59c1-a9b0-c02ec5938b43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+6" :db/id #edb/ref 17592186501794} {:answer/id #uuid "e8390c49-841d-5569-afdf-c7be1ff51f02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4x-4" :db/id #edb/ref 17592186501934} {:answer/id #uuid "ec81f36b-a032-5f51-afa7-bba1b6434ad6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3x-9" :db/id #edb/ref 17592186501940}] :answer-field/correct {:answer/id #uuid "a82da13f-ae7d-59c1-a9b0-c02ec5938b43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+6" :db/id #edb/ref 17592186501794} :answer-field/id #uuid "15dedf20-d4e5-5216-862b-d27b1914301a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501982}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "63caf14b-4a45-5fc8-9446-996c19cf7a2b" :question/math-academy-id "q-28288" :question/problem "A line $l$ is parallel to $4x-2y=6.$ A possible equation for $l$ is" :question/worked-solution "For two lines to be parallel, they must have the same slope.\n\nTo find the slope of the line $4x-2y=6,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}4x-2y & =6 \\\\ -2y & =-4x+6 \\\\ y & =2x-3\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope is $2.$\n\nFrom the given options, the only line that has a slope of $2$ is $y=2x+6.$"}] [{:db/id #edb/ref 17592186502137 :knowledge-point/_questions [{:db/id #edb/ref 17592186087687 :knowledge-point/id #uuid "d5bf8c8b-64f1-5552-a59e-78eef021c122" :knowledge-point/title "Identifying Parallel Lines Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63aec5ed-70dd-568a-b800-b96182667ad1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{12}x-\\frac{2}{5}" :db/id #edb/ref 17592186501651} {:answer/id #uuid "6b220cef-1e57-5c7c-b8c9-140cde054ae5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3x-8" :db/id #edb/ref 17592186501665} {:answer/id #uuid "73ec87cf-5e2f-5cab-8bf8-4edb168c5394" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3x+6" :db/id #edb/ref 17592186501678} {:answer/id #uuid "7f25e14f-dfb9-523c-b53b-932d5481661c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-12x+4" :db/id #edb/ref 17592186501706} {:answer/id #uuid "c722783d-27d3-5cb8-8edc-899b5962a24e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{3}x+2" :db/id #edb/ref 17592186501863}] :answer-field/correct {:answer/id #uuid "6b220cef-1e57-5c7c-b8c9-140cde054ae5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3x-8" :db/id #edb/ref 17592186501665} :answer-field/id #uuid "04d55a55-dcb2-5f1f-bb49-f359d2f4f066" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501977}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b444fd71-00fa-57c3-8df1-8666ae2725d8" :question/math-academy-id "q-44380" :question/problem "A line $l$ is parallel to $6x-2y=11.$ A possible equation for $l$ is" :question/worked-solution "For two lines to be parallel, they must have the same slope.\n\nTo find the slope of the line $6x-2y=11,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}6x-2y & =11 \\\\ \\frac{6}{2}x-\\frac{2}{2}y & =\\frac{11}{2} \\\\ 3x-y & =\\frac{11}{2} \\\\ -y & =-3x+\\frac{11}{2} \\\\ y & =3x-\\frac{11}{2}.\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope is $3.$\n\nFrom the given options, the only line that has a slope of $3$ is $y=3x-8.$"}] [{:db/id #edb/ref 17592186502128 :knowledge-point/_questions [{:db/id #edb/ref 17592186087687 :knowledge-point/id #uuid "d5bf8c8b-64f1-5552-a59e-78eef021c122" :knowledge-point/title "Identifying Parallel Lines Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ea92f20-abc3-55e6-9cb0-e212a4501b51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x-1" :db/id #edb/ref 17592186501577} {:answer/id #uuid "61fe2478-10d2-5bca-920d-9f0daaf0b6ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4x+8" :db/id #edb/ref 17592186501649} {:answer/id #uuid "7f128d65-7d5f-525e-9edd-3162254412a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=22x-\\frac{1}{2}" :db/id #edb/ref 17592186501705} {:answer/id #uuid "ed89ed12-51bd-556e-b4ad-ed83525eab09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-4x" :db/id #edb/ref 17592186501943} {:answer/id #uuid "f1b5fe75-82cb-53ca-9624-82b3c3a6b868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3x" :db/id #edb/ref 17592186501951}] :answer-field/correct {:answer/id #uuid "61fe2478-10d2-5bca-920d-9f0daaf0b6ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4x+8" :db/id #edb/ref 17592186501649} :answer-field/id #uuid "e2adee77-1817-5967-af7e-f4bab1e9df6e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502052}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9815706a-98d4-5baf-aff8-15181269835f" :question/math-academy-id "q-44382" :question/problem "A line $l$ is parallel to $4x-y=22.$  A possible equation for $l$ is" :question/worked-solution "For two lines to be parallel, they must have the same slope.\n\nTo find the slope of the line $4x-y=22,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}4x-y & =22 \\\\ -y & =-4x+22 \\\\ y & =4x-22.\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope is $4.$\n\nFrom the given options, the only line that has a slope of $4$ is $y=4x+8.$"}] [{:db/id #edb/ref 17592186502163 :knowledge-point/_questions [{:db/id #edb/ref 17592186087686 :knowledge-point/id #uuid "353a2fb8-5677-5047-8f39-595f43d9eeb9" :knowledge-point/title "Identifying Parallel Lines Given in Slope-Intercept Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "228faacc-9021-5872-b7db-9b38a2220648" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186501525} {:answer/id #uuid "471a5e54-7e04-558d-9667-02762828119c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186501596} {:answer/id #uuid "7f548e04-d6dc-57ef-8416-be3c21cd0e2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186501707} {:answer/id #uuid "b312b3b3-33c5-5504-81c0-2898d8da72d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{8}" :db/id #edb/ref 17592186501825} {:answer/id #uuid "d799bd3b-848c-555c-83d1-0c10c53d06d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186501895}] :answer-field/correct {:answer/id #uuid "7f548e04-d6dc-57ef-8416-be3c21cd0e2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186501707} :answer-field/id #uuid "c00507c7-749d-533c-becb-5a6fefcc307c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502044}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f9e5b1d4-9811-5c7c-998e-01070d311e7e" :question/math-academy-id "q-44391" :question/problem "The lines $y=\\frac{8}{5}x+9$ and $y=mx+3$ are parallel. The value of $m=$" :question/worked-solution "For two lines to be parallel, they must have the same slope.\n\nBoth lines are in slope-intercept form, so we can pick out the slope of each equation by looking at the $x$-coefficient.\n\n- The slope of the line $y=\\frac{8}{5}x+9$ is $\\frac{8}{5}.$\n\n- The slope of the line $y=mx+3$ is $m.$\n\nBecause the slopes must be the same, we must have $m=\\frac{8}{5}.$"}]}
