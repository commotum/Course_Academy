#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186088504} :activity/id #uuid "16a4de81-848b-5638-b998-ac9062204da4" :activity/scope {:db/id #edb/ref 17592186050245 :topic/id #uuid "3913d667-ede5-5fee-ba67-ff64afeb7883" :topic/math-academy-id 837} :activity/steps [{:db/id #edb/ref 17592186088504 :step/content {:db/id #edb/ref 17592186088989 :tutorial/content "Two distinct lines that never intersect are said to be **parallel.** For two lines to be parallel, they must have the same slope. \n\nFor example, the lines $y=2x+4$ and $y=2x-5$ have the same slope of $m=2,$ so they are parallel. Indeed, looking at the graph, we see that the two lines never cross.\n\n![](images/c7/c7d36372d9646d0ce10eff5d35a4f9b8e56a7b37b333c5d53ac243065ee751af.png)\n\nOn the other hand, the lines $y=\\dfrac{1}{2}x+4$ and $y=2x-5$ have different slopes, so they are *not* parallel. Indeed, looking at the graph, we see that the two lines *do* cross.\n\n![](images/92/92c1ee39ccbbbf20dc3f4a7f76a1114d975fb0826eeac13d273b4b4fd9a83105.png)" :tutorial/id #uuid "2a7600a0-ce9a-5126-866d-bc3d1cf82b41" :tutorial/math-academy-id 8902 :tutorial/title "Introduction"} :step/id #uuid "cab8d9d2-3173-5553-86f8-e9fb1aecfd16" :step/math-academy-id 144181 :step/next {:db/id #edb/ref 17592186088505}} {:db/id #edb/ref 17592186088505 :step/content {:db/id #edb/ref 17592186087686 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087433 :question/id #uuid "4f0593d8-bce5-5c73-aedd-ffe0faf15a59" :question/math-academy-id "e-14364"} :knowledge-point/id #uuid "353a2fb8-5677-5047-8f39-595f43d9eeb9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049716}] :knowledge-point/question-generator {:db/id #edb/ref 17592186477090} :knowledge-point/questions [{:db/id #edb/ref 17592186088072} {:db/id #edb/ref 17592186088073} {:db/id #edb/ref 17592186088176} {:db/id #edb/ref 17592186477079} {:db/id #edb/ref 17592186477083} {:db/id #edb/ref 17592186477084} {:db/id #edb/ref 1759218647