#{[{:db/id #edb/ref 17592186204598 :knowledge-point/_questions [{:db/id #edb/ref 17592186204092 :knowledge-point/id #uuid "d63847ef-6360-50b5-b585-9084140b2d67" :knowledge-point/title "Solving For an Unknown Parameter - Variables and Constants on Both Sides"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0f08b77-eeef-5fc2-8543-09a2276b46e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186203498} {:answer/id #uuid "ed88b415-ec31-5753-9538-94d29a0edac6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186203499} {:answer/id #uuid "06e406e9-458f-5b5b-8a76-47ae321cb09d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186203500} {:answer/id #uuid "217b4c73-d235-5933-8a9f-ef748ad498ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186203501} {:answer/id #uuid "7cc66499-02a0-5560-9357-f491dc4ae661" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186203502}] :answer-field/id #uuid "204618ec-8108-58ed-8408-6f51fe3d50c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186203497}] :question/id #uuid "c5eb239a-6da7-5d84-946d-c53824d57aa5" :question/math-academy-id "q-287677" :question/problem "Consider the equation in the variable $x$, given by\n$2px = 3x + 5$\nwhere $p$ is a constant. Given that this equation has no solution, what is the value of $p$?"}] [{:db/id #edb/ref 17592186297197 :knowledge-point/_questions [{:db/id #edb/ref 17592186204090 :knowledge-point/id #uuid "c0e7426e-553d-5f20-811f-15f3a5ea0056" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "298bad1f-9367-5a05-95d2-933a09daee2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186295501} {:answer/id #uuid "3dad73b7-975d-5246-83b7-9657d612712e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186295623} {:answer/id #uuid "a52921f6-35e3-5fd6-831b-5c76a68fe597" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186296138} {:answer/id #uuid "c10c0188-b833-5221-be57-af73a4dae17b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186296286} {:answer/id #uuid "f34978c9-f088-5aab-b438-960ba47ee1ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186296559}] :answer-field/correct {:answer/id #uuid "a52921f6-35e3-5fd6-831b-5c76a68fe597" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186296138} :answer-field/id #uuid "aab0add4-30b0-59ee-8400-8a7cc1beaf29" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296994}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1328ee8c-fdcc-59c5-a877-6291af207d84" :question/math-academy-id "q-288596" :question/problem "Consider the equation in the variable $y,$ given by\n\n$$\n(q+9)y=-6\n$$\n\nwhere $q$ is a constant. Given that this equation has no solution, what is the value of $q?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=b\n$$\n\nwhere $a$ and $b$ are constants, and $b\\ne 0.$ If $a=0,$ then the equation has no solution.\n\nNotice that this equation is in the form $ay=b.$ In this case,\n\n$$\na=q+9,\\,b=-6.\n$$\n\nTherefore, the equation has no solution if\n\n$$\nq+9=0.\n$$\n\nSolving this for $q,$ we get\n\n$$\n\\begin{aligned}q+9 & =0 \\\\ q & =-9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297202 :knowledge-point/_questions [{:db/id #edb/ref 17592186204091 :knowledge-point/id #uuid "ba644b27-7245-5b7b-8cd6-2493836a7d03" :knowledge-point/title "Solving For an Unknown Parameter - Constants on Both Sides"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "488785de-3552-5c44-b37c-f80db84151a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186295682}] :answer-field/correct {:answer/id #uuid "488785de-3552-5c44-b37c-f80db84151a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186295682} :answer-field/id #uuid "4f518425-6bb3-513e-9a2f-cd6d4cd2d157" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296784}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e9e21b0c-1002-52c2-8ff0-0958a8c28640" :question/math-academy-id "q-288644" :question/problem "Consider the equation in the variable $v,$ given by\n\n$$\n(k-2)v-3=5\n$$\n\nwhere $k$ is a constant. Given that this equation has no solution, what is the value of $k?$\n\n$k=$\n{{field-1}}" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=b\n$$\n\nwhere $a$ and $b$ are constants, and $b\\ne 0.$ If $a=0,$ then the equation has no solution.\n\nFirst, let's write our equation in the form $av=b:$\n\n$$\n\\begin{aligned}(k-2)v-3 & =5 \\\\ (k-2)v-3+3 & =5+3 \\\\ {{(k-2)}_{⏟}}_{a}v & ={{8}_{⏟}}_{b}\\end{aligned}\n$$\n\nTherefore, the equation has no solution if\n\n$$\nk-2=0.\n$$\n\nSolving this for $k,$ we get\n\n$$\n\\begin{aligned}k-2 & =0 \\\\ k & =2.\\end{aligned}\n$$"}]}
