#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186565489} :activity/id #uuid "c337d6eb-3aa0-55bd-86e4-7976b5c91d04" :activity/scope {:db/id #edb/ref 17592186050884 :topic/id #uuid "6e36fc4f-7ad7-519b-88fa-4bc240d36c28" :topic/math-academy-id 5572} :activity/steps [{:db/id #edb/ref 17592186565489 :step/content {:db/id #edb/ref 17592186204598 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0f08b77-eeef-5fc2-8543-09a2276b46e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186203498} {:answer/id #uuid "ed88b415-ec31-5753-9538-94d29a0edac6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186203499} {:answer/id #uuid "06e406e9-458f-5b5b-8a76-47ae321cb09d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186203500} {:answer/id #uuid "217b4c73-d235-5933-8a9f-ef748ad498ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186203501} {:answer/id #uuid "7cc66499-02a0-5560-9357-f491dc4ae661" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186203502}] :answer-field/correct {:db/id #edb/ref 17592186203502} :answer-field/id #uuid "204618ec-8108-58ed-8408-6f51fe3d50c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186203497}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c5eb239a-6da7-5d84-946d-c53824d57aa5" :question/math-academy-id "q-287677" :question/problem "Consider the equation in the variable $x,$ given by\n\n$$\n2px=3x+5\n$$\n\nwhere $p$ is a constant. Given that this equation has no solution, what is the value of $p?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=b\n$$\n\nwhere $a$ and $b$ are constants, and $b\\ne 0.$ If $a=0,$ then the equation has no solution.\n\nFirst, we rewrite the equation in the form $ax=b.$ \n\nWe start by subtracting $3x$ from both sides of the equation:\n\n$$\n\\begin{aligned}2px & =3x+5 \\\\ 2px-3x & =3x+5-3x \\\\ 2px-3x & =5\\end{aligned}\n$$\n\nNext, we factor $x$ on the left-hand side. This gives\n\n$$\n(2p-3)x=5.\n$$\n\nNotice that this equation is now in the form $ax=b:$\n\n$$\n{{(2p-3)}_{⏟}}_{a}x={{5}_{⏟}}_{b}\n$$\n\nTherefore, the equation has no solution if\n\n$$\n2p-3=0.\n$$\n\nSolving this for $p,$ we get\n\n$$\n\\begin{aligned}2p-3 & =0 \\\\ 2p-3+3 & =0+3 \\\\ 2p & =3 \\\\ \\frac{2p}{2} & =\\frac{3}{2} \\\\ p & =\\frac{3}{2}.\\end{aligned}\n$$"} :step/id #uuid "1866355e-5a27-511e-8e09-7bbdcb7e2ecf" :step/next {:db/id #edb/ref 17592186565540}} {:db/id #edb/ref 17592186565519 :step/content {:db/id #edb/ref 17592186297202 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "488785de-3552-5c44-b37c-f80db84151a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186295682}] :answer-field/correct {:db/id #edb/ref 17592186295682} :answer-field/id #uuid "4f518425-6bb3-513e-9a2f-cd6d4cd2d157" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186296784}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e9e21b0c-1002-52c2-8ff0-0958a8c28640" :question/math-academy-id "q-288644" :question/problem "Consider the equation in the variable $v,$ given by\n\n$$\n(k-2)v-3=5\n$$\n\nwhere $k$ is a constant. Given that this equation has no solution, what is the value of $k?$\n\n$k=$\n{{field-1}}" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=b\n$$\n\nwhere $a$ and $b$ are constants, and $b\\ne 0.$ If $a=0,$ then the equation has no solution.\n\nFirst, let's write our equation in the form $av=b:$\n\n$$\n\\begin{aligned}(k-2)v-3 & =5 \\\\ (k-2)v-3+3 & =5+3 \\\\ {{(k-2)}_{⏟}}_{a}v & ={{8}_{⏟}}_{b}\\end{aligned}\n$$\n\nTherefore, the equation has no solution if\n\n$$\nk-2=0.\n$$\n\nSolving this for $k,$ we get\n\n$$\n\\begin{aligned}k-2 & =0 \\\\ k & =2.\\end{aligned}\n$$"} :step/id #uuid "9195a63d-152b-58e5-95a9-d8c8dcb4ee50"} {:db/id #edb/ref 17592186565540 :step/content {:db/id #edb/ref 17592186297197 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "298bad1f-9367-5a05-95d2-933a09daee2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186295501} {:answer/id #uuid "3dad73b7-975d-5246-83b7-9657d612712e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186295623} {:answer/id #uuid "a52921f6-35e3-5fd6-831b-5c76a68fe597" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186296138} {:answer/id #uuid "c10c0188-b833-5221-be57-af73a4dae17b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186296286} {:answer/id #uuid "f34978c9-f088-5aab-b438-960ba47ee1ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186296559}] :answer-field/correct {:db/id #edb/ref 17592186296138} :answer-field/id #uuid "aab0add4-30b0-59ee-8400-8a7cc1beaf29" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186296994}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1328ee8c-fdcc-59c5-a877-6291af207d84" :question/math-academy-id "q-288596" :question/problem "Consider the equation in the variable $y,$ given by\n\n$$\n(q+9)y=-6\n$$\n\nwhere $q$ is a constant. Given that this equation has no solution, what is the value of $q?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=b\n$$\n\nwhere $a$ and $b$ are constants, and $b\\ne 0.$ If $a=0,$ then the equation has no solution.\n\nNotice that this equation is in the form $ay=b.$ In this case,\n\n$$\na=q+9,\\,b=-6.\n$$\n\nTherefore, the equation has no solution if\n\n$$\nq+9=0.\n$$\n\nSolving this for $q,$ we get\n\n$$\n\\begin{aligned}q+9 & =0 \\\\ q & =-9.\\end{aligned}\n$$"} :step/id #uuid "f4a9ce2d-f2d1-5c3c-aac6-760f7e33d1b4" :step/next {:db/id #edb/ref 17592186565519}}] :activity/title "Linear Equations With No Solutions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186564936}]}
