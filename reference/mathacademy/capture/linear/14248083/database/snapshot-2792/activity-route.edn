#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186566317} :activity/id #uuid "9139e18c-366b-55b6-82b3-e75c6b6d20b4" :activity/scope {:db/id #edb/ref 17592186051043 :topic/id #uuid "7cda6484-cda1-5805-8a40-963bb1a60fdf" :topic/math-academy-id 204} :activity/steps [{:db/id #edb/ref 17592186566290 :step/content {:db/id #edb/ref 17592186566210 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00b2ecca-75b6-58f7-9c07-3aae92dbe5b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{tan}⁡{40}^{∘}" :db/id #edb/ref 17592186565675} {:answer/id #uuid "20dae444-9a20-5951-872d-636ff74d0e7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡{50}^{∘}" :db/id #edb/ref 17592186565732} {:answer/id #uuid "72107be3-b641-5537-86ee-9ce79f3a22d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{tan}⁡{50}^{∘}" :db/id #edb/ref 17592186565856} {:answer/id #uuid "adb24147-d3a9-5b6a-a6d7-62f15b0ad41f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡{130}^{∘}" :db/id #edb/ref 17592186565953} {:answer/id #uuid "b428d1f0-e349-530d-a4b4-24f6a6274e19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{tan}⁡{130}^{∘}" :db/id #edb/ref 17592186565966}] :answer-field/correct {:db/id #edb/ref 17592186565856} :answer-field/id #uuid "44907bf6-096e-5980-bb96-b4f7f77f9980" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566134}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1bb75070-fc2e-5a03-b839-07558cdd2a36" :question/math-academy-id "q-156605" :question/problem "What is $\\operatorname{tan}⁡{310}^{∘}$ expressed in terms of a reference angle?" :question/worked-solution "To express $\\operatorname{tan}⁡{310}^{∘}$ in terms of $\\operatorname{tan}⁡{\\theta }_{R},$ we follow three steps:\n\n1\\. Find its reference angle ${\\theta }_{R}.$\n\n2\\. Calculate the value of the function for ${\\theta }_{R}.$\n\n3\\. Determine whether the resulting value is positive or negative.\n\nFirst, let's draw the angle ${310}^{∘}$ in the coordinate plane (CAST diagram):\n\n![](images/70/70325d2a1d2d252e20eea4f4940b8dc03b21c737709ffe65d95f36b51bb63fcf.png)\n\n**Step 1**: Since $\\theta ={310}^{∘}$ is in the $4$th quadrant, the reference angle ${\\theta }_{R}$ is\n\n$$\n\\begin{aligned}{\\theta }_{R} & ={360}^{∘}-\\theta  \\\\  & ={360}^{∘}-{310}^{∘} \\\\  & ={50}^{∘}.\\end{aligned}\n$$\n\n**Step 2**: The given ratio is $\\operatorname{tan}⁡{310}^{∘}$, and therefore we're interested in $\\operatorname{tan}⁡{\\theta }_{R}=\\operatorname{tan}⁡{50}^{∘}.$\n\n**Step 3:** The ratio $\\operatorname{tan}⁡{310}^{∘}$ must be *negative* because the tangent ratio is *always* negative in the $4$th quadrant. Therefore,\n\n$$\n\\operatorname{tan}⁡{310}^{∘}=-\\operatorname{tan}⁡{50}^{∘}.\n$$"} :step/id #uuid "52d91b10-95e2-5853-b058-9550461fe27f"} {:db/id #edb/ref 17592186566305 :step/content {:db/id #edb/ref 17592186566213 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19431c0a-bdd3-5225-b483-6b0891c69d48" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡{163}^{∘}" :db/id #edb/ref 17592186565721} {:answer/id #uuid "33c1b2bb-e8d5-5650-84a0-fe62bfe7ed4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{sin}⁡{163}^{∘}" :db/id #edb/ref 17592186565757} {:answer/id #uuid "7aab4335-e6f8-50ff-8426-deb0887acff3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡{17}^{∘}" :db/id #edb/ref 17592186565869} {:answer/id #uuid "935f5752-b045-5b47-affc-7b3fa1825b85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡{17}^{∘}" :db/id #edb/ref 17592186565916} {:answer/id #uuid "c8bf9e37-3223-5311-ae58-de6d9f5ee716" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{sin}⁡{17}^{∘}" :db/id #edb/ref 17592186566003}] :answer-field/correct {:db/id #edb/ref 17592186566003} :answer-field/id #uuid "6d8fcf9e-df13-5b5c-a903-7cb43af2426c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566149}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "27716467-fe24-5b2e-a5ee-4be993036021" :question/math-academy-id "q-156075" :question/problem "What is $\\operatorname{sin}⁡{197}^{∘}$ expressed in terms of a reference angle?" :question/worked-solution "To express $\\operatorname{sin}⁡{197}^{∘}$ in terms of $\\operatorname{sin}⁡{\\theta }_{R},$ we follow three steps:\n\n1\\. Find its reference angle ${\\theta }_{R}.$\n\n2\\. Calculate the value of the function for ${\\theta }_{R}.$\n\n3\\. Determine whether the resulting value is positive or negative.\n\nFirst, let's draw the angle ${197}^{∘}$ in the coordinate plane (CAST diagram):\n\n![](images/d4/d483d80833650a101f993d9f66ffb9c786681240a4bfa4e255fb116cc7ad5fd2.png)\n\n**Step 1**: Since $\\theta ={197}^{∘}$ is in the $3$rd quadrant, the reference angle ${\\theta }_{R}$ is\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\theta -{180}^{∘} \\\\  & ={197}^{∘}-{180}^{∘} \\\\  & ={17}^{∘}.\\end{aligned}\n$$\n\n**Step 2**: The given ratio is $\\operatorname{sin}⁡{197}^{∘}$, and therefore we're interested in $\\operatorname{sin}⁡{\\theta }_{R}=\\operatorname{sin}⁡{17}^{∘}.$\n\n**Step 3:** The ratio $\\operatorname{sin}⁡{197}^{∘}$ must be *negative* because the sine ratio is *always* negative in the $3$rd quadrant. Therefore,\n\n$$\n\\operatorname{sin}⁡{197}^{∘}=-\\operatorname{sin}⁡{17}^{∘}.\n$$"} :step/id #uuid "a9ca7eb4-f756-5736-925f-230f1fbb54f7" :step/next {:db/id #edb/ref 17592186566290}} {:db/id #edb/ref 17592186566317 :step/content {:db/id #edb/ref 17592186566262 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e13521f-e2ed-5d00-b9ec-9e2f3dadbd85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}⁡{65}^{∘}" :db/id #edb/ref 17592186565780} {:answer/id #uuid "63332c80-08c6-5406-95e6-80bf617f3929" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}⁡{115}^{∘}" :db/id #edb/ref 17592186565833} {:answer/id #uuid "6d610513-4b2e-5430-b55e-31a452283674" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{sin}⁡{65}^{∘}" :db/id #edb/ref 17592186565847} {:answer/id #uuid "c3e44820-bc6c-5c8d-9869-91c626a31610" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡{65}^{∘}" :db/id #edb/ref 17592186565991} {:answer/id #uuid "eadecdc5-c208-5546-bbf1-1d575e05ac4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡{115}^{∘}" :db/id #edb/ref 17592186566063}] :answer-field/correct {:db/id #edb/ref 17592186565847} :answer-field/id #uuid "f5d4c08d-a6b6-51ef-ab36-7ea7637d3cfa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566188}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bd9a81c2-dd21-5cb3-9488-a8b270b5ad9b" :question/math-academy-id "q-124446" :question/problem "What is $\\operatorname{sin}⁡{245}^{∘}$ expressed in terms of a reference angle?" :question/worked-solution "To express $\\operatorname{sin}⁡{245}^{∘}$ in terms of $\\operatorname{sin}⁡{\\theta }_{R},$ we follow three steps:\n\n1\\. Find its reference angle ${\\theta }_{R}.$\n\n2\\. Calculate the value of the function for ${\\theta }_{R}.$\n\n3\\. Determine whether the resulting value is positive or negative.\n\nFirst, let's draw the angle ${245}^{∘}$ in the coordinate plane (CAST diagram):\n\n![](images/31/312fc3581d9da413254a0eb4dbc64091b286675492821838ba9a65ee06f45a7c.png)\n\n**Step 1**: Since $\\theta ={245}^{∘}$ is in the $3$rd quadrant, the reference angle ${\\theta }_{R}$ is\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\theta -{180}^{∘} \\\\  & ={245}^{∘}-{180}^{∘} \\\\  & ={65}^{∘}.\\end{aligned}\n$$\n\n**Step 2**: The given ratio is $\\operatorname{sin}⁡{245}^{∘}$, and therefore we're interested in $\\operatorname{sin}⁡{\\theta }_{R}=\\operatorname{sin}⁡{65}^{∘}.$\n\n**Step 3:** The ratio $\\operatorname{sin}⁡{245}^{∘}$ must be *negative* because the sine ratio is *always* negative in the $3$rd quadrant. Therefore,\n\n$$\n\\operatorname{sin}⁡{245}^{∘}=-\\operatorname{sin}⁡{65}^{∘}.\n$$"} :step/id #uuid "f1616495-15a6-5d1e-979a-c28e0d2a8770" :step/next {:db/id #edb/ref 17592186566319}} {:db/id #edb/ref 17592186566319 :step/content {:db/id #edb/ref 17592186566255 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a2505a0-14df-51c6-ad4c-3b9e3be1a49c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡{60}^{∘}" :db/id #edb/ref 17592186565744} {:answer/id #uuid "349f69bc-bcdc-5122-ac2c-a188f806b7b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{sin}⁡{40}^{∘}" :db/id #edb/ref 17592186565760} {:answer/id #uuid "3f8a5f81-69f6-532a-bfcc-6895c9a965a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡{40}^{∘}" :db/id #edb/ref 17592186565783} {:answer/id #uuid "5722dc1e-7879-5efa-9e3e-63d11d333004" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡{40}^{∘}" :db/id #edb/ref 17592186565819} {:answer/id #uuid "5b696c45-4f0f-51d6-a0a5-7c025c4830aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}⁡{40}^{∘}" :db/id #edb/ref 17592186565828}] :answer-field/correct {:db/id #edb/ref 17592186565828} :answer-field/id #uuid "290ee7a2-24f2-5c09-8d37-e125475616d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566121}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a1630114-3830-5e2d-b973-4d57fd87afe3" :question/math-academy-id "q-124455" :question/problem "What is $\\operatorname{cos}⁡{140}^{∘}$ expressed in terms of a reference angle?" :question/worked-solution "To express $\\operatorname{cos}⁡{140}^{∘}$ in terms of $\\operatorname{cos}⁡{\\theta }_{R},$ we follow three steps:\n\n1\\. Find its reference angle ${\\theta }_{R}.$\n\n2\\. Calculate the value of the function for ${\\theta }_{R}.$\n\n3\\. Determine whether the resulting value is positive or negative.\n\nFirst, let's draw the angle ${140}^{∘}$ in the coordinate plane (CAST diagram):\n\n![](images/5f/5f2b641a3a765f65f1d7d11837193341edb6876dfaea45e9eeaf1d7610178435.png)\n\n**Step 1**: Since $\\theta ={140}^{∘}$ is in the $2$nd quadrant, the reference angle ${\\theta }_{R}$ is\n\n$$\n\\begin{aligned}{\\theta }_{R} & ={180}^{∘}-\\theta  \\\\  & ={180}^{∘}-{140}^{∘} \\\\  & ={40}^{∘}.\\end{aligned}\n$$\n\n**Step 2**: The given ratio is $\\operatorname{cos}⁡{140}^{∘}$, and therefore we're interested in $\\operatorname{cos}⁡{\\theta }_{R}=\\operatorname{cos}⁡{40}^{∘}.$\n\n**Step 3:** The ratio $\\operatorname{cos}⁡{140}^{∘}$ must be *negative* because the cosine ratio is *always* negative in the $2$nd quadrant. Therefore,\n\n$$\n\\operatorname{cos}⁡{140}^{∘}=-\\operatorname{cos}⁡{40}^{∘}.\n$$"} :step/id #uuid "f6120112-ac2e-5621-b0e7-28a667256cbb" :step/next {:db/id #edb/ref 17592186566305}}] :activity/title "Extending the Trigonometric Ratios Using the Unit Circle" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186565669}]}
