#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186573961} :activity/id #uuid "5cdac913-5d87-512c-ade1-3ecfb3db340e" :activity/scope {:db/id #edb/ref 17592186050669 :topic/id #uuid "5d821651-a7cb-50af-8f0d-bc162e3a74e7" :topic/math-academy-id 729} :activity/steps [{:db/id #edb/ref 17592186573955 :step/content {:db/id #edb/ref 17592186233744 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "119dc29c-b137-50a6-9c2e-9ac8d5e9af59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{7}" :db/id #edb/ref 17592186295367} {:answer/id #uuid "3082a4a4-01f9-5e69-8589-4ae793f7d894" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186295545} {:answer/id #uuid "60e31fc5-d679-52f0-8403-e834f9c90e53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186295823} {:answer/id #uuid "e3fabf97-650c-5f20-8a3e-869f773274b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{7}" :db/id #edb/ref 17592186296483} {:answer/id #uuid "eb5f880e-5916-5bea-a034-1eba1b1f15a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186296519}] :answer-field/correct {:db/id #edb/ref 17592186295823} :answer-field/id #uuid "888fe82e-2f83-5273-a943-a23e7c4d783d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186296915}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8ed9536d-f38c-5295-8805-abb310c76773" :question/math-academy-id "q-288814" :question/problem "Consider the quadratic equation\n\n$$\n7{x}^{2}-5x-14=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=7,\\,b=-5,\\,c=-14.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-14)}{7}=-2.\\end{aligned}\n$$"} :step/id #uuid "21b93cc5-5238-55b5-bb4b-3b10815912cb" :step/next {:db/id #edb/ref 17592186573973}} {:db/id #edb/ref 17592186573961 :step/content {:db/id #edb/ref 17592186573917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c2510f0-b810-5894-bd56-bedbac242aa4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1\\,720}{83}" :db/id #edb/ref 17592186573438} {:answer/id #uuid "565b004c-dfa1-5d9f-8adf-d1c864f95c20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\cdot 83" :db/id #edb/ref 17592186573531} {:answer/id #uuid "5941e2d5-bac3-5d4f-a11e-6eaba1eaa217" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{83}{2}" :db/id #edb/ref 17592186573538} {:answer/id #uuid "6f09b0e3-c7d5-5351-a62d-9fa02774dbc1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "83" :db/id #edb/ref 17592186573560} {:answer/id #uuid "91846439-79eb-5c63-bbaa-4ac88bbb6e7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-83" :db/id #edb/ref 17592186573613}] :answer-field/correct {:db/id #edb/ref 17592186573560} :answer-field/id #uuid "e266ed12-ce03-5365-bb09-c240fd5249db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186573853}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b7cd0468-ad38-596e-ad84-07e63c57d66b" :question/math-academy-id "q-288807" :question/problem "Consider the quadratic equation\n\n$$\n{x}^{2}-83x+1\\,720=0.\n$$\n\n**Without** solving the equation, determine the sum of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=1,\\,b=-83,\\,c=1\\,720.\n$$\n\nTherefore, the sum of the solutions is\n\n$$\n\\begin{aligned}-\\frac{b}{a} & =-\\frac{(-83)}{1}=83.\\end{aligned}\n$$"} :step/id #uuid "53653a5c-3f90-57ee-b328-66b30a5ef05f" :step/next {:db/id #edb/ref 17592186573955}} {:db/id #edb/ref 17592186573973 :step/content {:db/id #edb/ref 17592186390572 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a1d95b8-6f28-5ebe-ae92-d043359fa511" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\,395" :db/id #edb/ref 17592186390574} {:answer/id #uuid "eed1e1d6-f081-50ba-9a0f-960b330272be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-2)\\cdot 8\\,395" :db/id #edb/ref 17592186390575} {:answer/id #uuid "28190f64-9c46-5f7f-af80-807614a00568" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{146}{2}" :db/id #edb/ref 17592186390576} {:answer/id #uuid "6125f799-589f-5f34-b51a-3dae9be8eba0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8\\,395" :db/id #edb/ref 17592186390577} {:answer/id #uuid "9b4ae3e2-672a-57a7-8dcb-1c4b9825daed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{-8\\,395}{146}" :db/id #edb/ref 17592186390578}] :answer-field/correct {:db/id #edb/ref 17592186390577} :answer-field/id #uuid "e368a500-4f4d-5598-bf19-014504f88343" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186390573}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a60a042a-0631-504b-9c2c-28fdb04eadac" :question/math-academy-id "q-288819" :question/problem "Consider the quadratic equation\n\n$$\n{x}^{2}+146x-8\\,395=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=1,\\,b=146,\\,c=-8\\,395.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-8\\,395)}{1}=-8\\,395.\\end{aligned}\n$$"} :step/id #uuid "d1b20453-a0bf-5498-be05-d3dc519365f7"}] :activity/title "Vieta's Formulas" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186573415}]}
