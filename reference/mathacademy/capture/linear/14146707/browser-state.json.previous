e=\"3\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-mstyle></mjx-texatom><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-texatom space=\"4\" texclass=\"ORD\"><mjx-mstyle style=\"color: blue;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c><mjx-c class=\"mjx-c34\"></mjx-c></mjx-mn></mjx-mstyle></mjx-texatom></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"red\"><mo stretchy=\"false\">(</mo><mo>−</mo><mn>12</mn><mo stretchy=\"false\">)</mo></mstyle></mrow><mo>⋅</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"red\"><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><mo stretchy=\"false\">)</mo></mstyle></mrow><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mn>12</mn><mo>⋅</mo><mn>2</mn></mstyle></mrow><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mn>24</mn></mstyle></mrow></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
