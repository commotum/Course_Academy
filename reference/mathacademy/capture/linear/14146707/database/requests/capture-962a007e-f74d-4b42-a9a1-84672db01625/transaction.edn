emaining product using the fact that a positive times a negative gives a negative:\n\n$$\n16\\cdot (-3)=-(16\\cdot 3)=-48\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a3a193d6-5af2-544d-aafe-ac5491d5b1b1"] :db/ensure [:question/validate]} {:db/id "answer-field-a3a193d6-5af2-544d-aafe-ac5491d5b1b1" :answer-field/id #uuid "a3a193d6-5af2-544d-aafe-ac5491d5b1b1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b571edf9-6056-5cc0-8192-4ad3edfcb952" :answer-field/choices ["answer-a63c048f-7df0-5ce1-9cad-c027c81e7ac5" "answer-b571edf9-6056-5cc0-8192-4ad3edfcb952" "answer-5a09c649-99db-5f27-a92d-cf443b9bbb5a" "answer-0c234924-49eb-58c0-9bd7-f4577d3acd85" "answer-e30b65b8-9ebd-5059-9550-81fbbb55e2bf"] :db/ensure [:answer-field/validate]} {:db/id "answer-a63c048f-7df0-5ce1-9cad-c027c81e7ac5" :answer/id #uuid "a63c048f-7df0-5ce1-9cad-c027c81e7ac5" :answer/type :answer.type/math :answer/value "-32" :db/ensure [:answer/validate]} {:db/id "answer-b571edf9-6056-5cc0-8192-4ad3edfcb952" :answer/id #uuid "b571edf9-6056-5cc0-8192-4ad3edfcb952" :answer/type :answer.type/math :answer/value "-48" :db/ensure [:answer/validate]} {:db/id "answer-5a09c649-99db-5f27-a92d-cf443b9bbb5a" :answer/id #uuid "5a09c649-99db-5f27-a92d-cf443b9bbb5a" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "answer-0c234924-49eb-58c0-9bd7-f4577d3acd85" :answer/id #uuid "0c234924-49eb-58c0-9bd7-f4577d3acd85" :answer/type :answer.type/math :answer/value "42" :db/ensure [:answer/validate]} {:db/id "answer-e30b65b8-9ebd-5059-9550-81fbbb55e2bf" :answer/id #uuid "e30b65b8-9ebd-5059-9550-81fbbb55e2bf" :answer/type :answer.type/math :answer/value "48" :db/ensure [:answer/validate]} {:db/id "question-6db7b1f8-571b-596f-b937-087002cb4535" :question/id #uuid "6db7b1f8-571b-596f-b937-087002cb4535" :question/math-academy-id "q-128409" :question/problem "$7\\cdot (-2)\\cdot (-5)=$" :question/worked-solution "Let's start by multiplying the first two numbers. We have the product of a positive and a negative, which gives a negative:\n\n$$\n7\\cdot (-2)=-14\n$$\n\nSo we now have\n\n$$\n{{7\\cdot (-2)}_{⏟}}_{-14}\\cdot (-5)=(-14)\\cdot (-5).\n$$\n\nThen, we work out this remaining product using the fact that the product of two negatives gives a positive:\n\n$$\n(-14)\\cdot (-5)=14\\cdot 5=70\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-21db98eb-ad0a-55fe-820a-349262b09ab3"] :db/ensure [:question/validate]} {:db/id "answer-field-21db98eb-ad0a-55fe-820a-349262b09ab3" :answer-field/id #uuid "21db98eb-ad0a-55fe-820a-349262b09ab3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d65c5775-e478-5e7d-852f-ce3df408057d" :answer-field/choices ["answer-71c2204c-464f-548a-a3c3-ae84cc6b12aa" "answer-1978eb85-167c-5cc9-b3a3-98ca1a3c6746" "answer-aa95cecf-7fab-557f-8f17-1b63b55d7331" "answer-090f426b-ae78-587e-a752-bdabbff21ce4" "answer-d65c5775-e478-5e7d-852f-ce3df408057d"] :db/ensure [:answer-field/validate]} {:db/id "answer-71c2204c-464f-548a-a3c3-ae84cc6b12aa" :answer/id #uuid "71c2204c-464f-548a-a3c3-ae84cc6b12aa" :answer/type :answer.type/math :answer/value "-63" :db/ensure [:answer/validate]} {:db/id "answer-1978eb85-167c-5cc9-b3a3-98ca1a3c6746" :answer/id #uuid "1978eb85-167c-5cc9-b3a3-98ca1a3c6746" :answer/type :answer.type/math :answer/value "-70" :db/ensure [:answer/validate]} {:db/id "answer-aa95cecf-7fab-557f-8f17-1b63b55d7331" :answer/id #uuid "aa95cecf-7fab-557f-8f17-1b63b55d7331" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "answer-090f426b-ae78-587e-a752-bdabbff21ce4" :answer/id #uuid "090f426b-ae78-587e-a752-bdabbff21ce4" :answer/type :answer.type/math :answer/value "63" :db/ensure [:answer/validate]} {:db/id "answer-d65c5775-e478-5e7d-852f-ce3df408057d" :answer/id #uuid "d65c5775-e478-5e7d-852f-ce3df408057d