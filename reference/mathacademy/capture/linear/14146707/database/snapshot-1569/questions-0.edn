 :db/ident :answer.type/math} :answer/value "-\\frac{35}{12}" :db/id #edb/ref 17592186442373} :answer-field/id #uuid "1d373760-5a89-5b26-bc5e-1afb0e01c86e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442408}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c193a4aa-2a3b-50a7-9351-eac6230e1fa9" :question/math-academy-id "q-42994" :question/problem "$(-\\frac{7}{3})\\cdot \\frac{5}{4}=$" :question/worked-solution "We have a product of a negative number and a positive number, so the product will be negative:\n\n$$\n(-\\frac{7}{3})\\cdot \\frac{5}{4}=-(\\frac{7}{3}\\cdot \\frac{5}{4})\n$$\n\nNow, we multiply the fractions by multiplying the numerators and denominators separately:\n\n$$\n\\begin{aligned}-(\\frac{7}{3}\\cdot \\frac{5}{4}) & =-(\\frac{7\\cdot 5}{3\\cdot 4}) \\\\  & =-(\\frac{35}{12}) \\\\  & =-\\frac{35}{12}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186442427 :knowledge-point/_questions [{:db/id #edb/ref 17592186179824 :knowledge-point/id #uuid "e39bc3f9-6e7c-5e13-abe1-ba7d88c68379" :knowledge-point/title "Multiplying Decimals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "119e2286-9660-5b93-97b8-0392beffd035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3.2" :db/id #edb/ref 17592186442340} {:answer/id #uuid "3e571c39-b0f8-5fdf-8258-564c2a1b1391" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.1" :db/id #edb/ref 17592186442354} {:answer/id #uuid "9bf19e2b-4ecc-50e6-b996-e3fd3de622ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.2" :db/id #edb/ref 17592186442380} {:answer/id #uuid "dca5ab5b-bfb5-5cd2-811c-2454b9ce0192" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3.6" :db/id #edb/ref 175921864423