d "6bbd766b-35ac-5531-abbe-97f4cd30fe7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186442369}] :answer-field/correct {:answer/id #uuid "40cee691-844c-55f0-80f2-f3687fcfd5fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186442355} :answer-field/id #uuid "1db1209a-a7a4-5bc6-ad0b-b36bc9c2e40e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442409}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3cfaf2ea-e7d3-519a-880f-3892d2b32646" :question/math-academy-id "q-43042" :question/problem "$(-\\frac{5}{3})\\cdot (-\\frac{3}{4})=$" :question/worked-solution "We have a product of two negative numbers, so the product will be positive, and we can drop the minus signs as follows:\n\n$$\n(-\\frac{5}{3})\\cdot (-\\frac{3}{4})=\\frac{5}{3}\\cdot \\frac{3}{4}\n$$\n\nNow, we multiply the fractions by multiplying the numerators and denominators separately:\n\n$$\n\\begin{aligned}\\frac{5}{3}\\cdot \\frac{3}{4} & =\\frac{5\\cdot 3}{3\\cdot 4} \\\\  & =\\frac{5\\cdot \\cancel{3}}{\\cancel{3}\\cdot 4} \\\\  & =\\frac{5}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186442424 :knowledge-point/_questions [{:db/id #edb/ref 17592186179823 :knowledge-point/id #uuid "192eeaef-4283-5db1-9a8f-0f2fbff163d1" :knowledge-point/title "Multiplying Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "075a0264-5d31-51b8-ab78-b715207f554f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186442333} {:answer/id #uuid "144c1491-1de4-51f2-a930-02e621153cd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186442341} {:answer/id #uuid "1ed9b