#{[{:db/id #edb/ref 17592186411155 :knowledge-point/_questions [{:db/id #edb/ref 17592186059780 :knowledge-point/id #uuid "4e85e1e6-6a11-52e6-96d3-a768ced940d4" :knowledge-point/title "Simplifying Expressions Involving Equivalences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "940f2589-9f73-5417-804b-2bb82c8143cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬B⇒A" :db/id #edb/ref 17592186411134} {:answer/id #uuid "b492421a-8fbc-5f3d-88d9-040402e7893f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(A∧B)∨¬(B∨A)" :db/id #edb/ref 17592186411138} {:answer/id #uuid "d3188347-6e03-5c7a-b90e-0a84321cc0f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(A∨B)∧¬(B∨A)" :db/id #edb/ref 17592186411140} {:answer/id #uuid "e4314ff2-9a8b-5692-b710-657e0db7b72c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(A∨B)∧¬(B∧A)" :db/id #edb/ref 17592186411141} {:answer/id #uuid "f72d28f7-58e9-5fb1-a702-3dc4acfad2ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(A∧B)∧¬(B∨A)" :db/id #edb/ref 17592186411145}] :answer-field/correct {:answer/id #uuid "e4314ff2-9a8b-5692-b710-657e0db7b72c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(A∨B)∧¬(B∧A)" :db/id #edb/ref 17592186411141} :answer-field/id #uuid "e18107c3-8a03-5991-a93e-5223d254814d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411151}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "75186b51-1b0d-58e4-a5b9-b90965af20bd" :question/math-academy-id "q-107158" :question/problem "$¬A⇔B≡$" :question/worked-solution "First, we use the definition of the biconditional statement to write the equivalence as a conjunction of implications: \n\n$$\n¬A⇔B≡(¬A⇒B)∧(B⇒¬A)\n$$\n\nNow, we represent all the implications using disjunctions and negations:\n\n$$\n(¬A⇒B)∧(B⇒¬A)≡(¬¬A∨B)∧(¬B∨¬A)\n$$\n\nNext, we use De Morgan's laws:\n\n$$\n(¬¬A∨B)∧(¬B∨¬A)≡(¬¬A∨B)∧¬(B∧A)\n$$\n\nFinally, we simplify the double negations:\n\n$$\n(¬¬A∨B)∧¬(B∧A)≡(A∨B)∧¬(B∧A)\n$$"}] [{:db/id #edb/ref 17592186411154 :knowledge-point/_questions [{:db/id #edb/ref 17592186059779 :knowledge-point/id #uuid "8946f811-40c4-5a19-a867-576c42364f15" :knowledge-point/title "Writing Biconditionals as Conditionals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03fc9076-17bb-57a9-be73-dfacce174097" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬(Y∧X)⇒¬Y" :db/id #edb/ref 17592186411118} {:answer/id #uuid "109311f5-5d8e-5ac6-9266-8b6d76321bc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y⇒(Y∧X)" :db/id #edb/ref 17592186411121} {:answer/id #uuid "2059d0ef-498b-554c-8e0d-85c9f988c719" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y⇒¬(Y∧X)" :db/id #edb/ref 17592186411122} {:answer/id #uuid "3bd9c0da-02e8-5952-b449-71cbb6aaf381" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬Y⇒(Y∧X)" :db/id #edb/ref 17592186411125} {:answer/id #uuid "633df85e-a6e9-521a-b6f5-a5c33c788554" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬(Y∧X)⇒Y" :db/id #edb/ref 17592186411128}] :answer-field/correct {:answer/id #uuid "2059d0ef-498b-554c-8e0d-85c9f988c719" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Y⇒¬(Y∧X)" :db/id #edb/ref 17592186411122} :answer-field/id #uuid "92f17ad3-acc3-5640-8a98-5f227a64f6be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411148}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "22a767fa-9117-5005-b0eb-ffcf7c23df74" :question/math-academy-id "q-107221" :question/problem "$$\n¬(Y∧X)⇔Y≡[¬(Y∧X)⇒Y]∧\n$$\n\nWhat expression should be inserted into the blank space above to give logically equivalent statements?" :question/worked-solution "According to the definition of the biconditional, \n\n- $A⇔B$ is true if $A⇒B$ **and** $B⇒A.$ Otherwise, it is false.\n\n- In other words, $A⇔B$ is true if $A$ and $B$ have the same truth values. Otherwise, it is false.\n\nSo, in this case, we have\n\n$$\n¬(Y∧X)⇔Y≡[¬(Y∧X)⇒Y]∧[\\,Y⇒¬(Y∧X)].\n$$\n\nTherefore, the missing part is $Y⇒¬(Y∧X).$"}] [{:db/id #edb/ref 17592186060063 :knowledge-point/_questions [{:db/id #edb/ref 17592186059779 :knowledge-point/id #uuid "8946f811-40c4-5a19-a867-576c42364f15" :knowledge-point/title "Writing Biconditionals as Conditionals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32e1d597-926b-5231-b70c-426d169352c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P⇒Q" :db/id #edb/ref 17592186411124} {:answer/id #uuid "4d866fd2-43a3-573e-991b-92a748eb725b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(P⇒Q)∧(Q⇒P)" :db/id #edb/ref 17592186411127} {:answer/id #uuid "87c0e178-1f23-5517-94ff-105ac4ae0d9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(P⇒Q)∨(Q⇒P)" :db/id #edb/ref 17592186411132} {:answer/id #uuid "e50fba5b-5161-546c-8d3c-3d19539ab036" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q⇒P" :db/id #edb/ref 17592186411142} {:answer/id #uuid "f025e2ab-90b3-5479-bb88-23644a67a768" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(¬P⇒¬Q)∧(Q⇒P)" :db/id #edb/ref 17592186411143}] :answer-field/correct {:answer/id #uuid "4d866fd2-43a3-573e-991b-92a748eb725b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(P⇒Q)∧(Q⇒P)" :db/id #edb/ref 17592186411127} :answer-field/id #uuid "fbcd1085-7f9a-5980-ac51-cc2a3484d383" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411153}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "994db419-8ab8-5b1c-9e43-3da4dc72767f" :question/math-academy-id "q-1471" :question/problem "$P⇔Q≡$" :question/worked-solution "According to the definition of the biconditional, \n\n- $A⇔B$ is true if $A⇒B$ **and** $B⇒A.$ Otherwise, it is false.\n\n- In other words, $A⇔B$ is true if $A$ and $B$ have the same truth values. Otherwise, it is false.\n\nSo in this case, we have\n\n$$\nP⇔Q≡(P⇒Q)∧(Q⇒P).\n$$"}] [{:db/id #edb/ref 17592186411157 :knowledge-point/_questions [{:db/id #edb/ref 17592186059780 :knowledge-point/id #uuid "4e85e1e6-6a11-52e6-96d3-a768ced940d4" :knowledge-point/title "Simplifying Expressions Involving Equivalences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0833f240-185e-532a-824f-4ccd738ff6d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(Y∧X)∨(¬X∧¬Y)" :db/id #edb/ref 17592186411120} {:answer/id #uuid "81e51dfb-5df1-5588-964c-928acab1bcb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "X∧¬Y" :db/id #edb/ref 17592186411131} {:answer/id #uuid "8bda5940-fd50-546b-b1c8-6f4ae1ea16b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬X∧Y" :db/id #edb/ref 17592186411133} {:answer/id #uuid "999bcf3c-92e7-59d4-bcad-b3707c6d09dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(Y∧¬X)∧(X∧¬Y)" :db/id #edb/ref 17592186411135} {:answer/id #uuid "9b327029-890c-51ee-9cd1-2d50c1493769" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(Y∧¬X)∨(X∧¬Y)" :db/id #edb/ref 17592186411136}] :answer-field/correct {:answer/id #uuid "9b327029-890c-51ee-9cd1-2d50c1493769" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(Y∧¬X)∨(X∧¬Y)" :db/id #edb/ref 17592186411136} :answer-field/id #uuid "67aed17a-d2cd-554a-99c0-e5486a53aa69" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411147}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "96aebafe-ff76-58ac-a04c-e47b82d4e2a3" :question/math-academy-id "q-182523" :question/problem "$¬(Y⇔X)≡$" :question/worked-solution "First, we use the definition of the biconditional statement to write the equivalence as a conjunction of implications: \n\n$$\n¬(Y⇔X)≡¬[(Y⇒X)∧(X⇒Y)]\n$$\n\nNow, we represent all the implications using disjunctions and negations:\n\n$$\n¬[(Y⇒X)∧(X⇒Y)]≡¬[(¬Y∨X)∧(¬X∨Y)]\n$$\n\nNext, we use De Morgan's laws:\n\n$$\n\\begin{aligned}¬[(¬Y∨X)∧(¬X∨Y)] & ≡¬(¬Y∨X)∨¬(¬X∨Y) \\\\  & ≡(¬¬Y∧¬X)∨(¬¬X∧¬Y)\\end{aligned}\n$$\n\nFinally, we simplify the double negations:\n\n$$\n\\begin{aligned}(¬¬Y∧¬X)∨(¬¬X∧¬Y) & ≡(Y∧¬X)∨(X∧¬Y)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186411156 :knowledge-point/_questions [{:db/id #edb/ref 17592186059778 :knowledge-point/id #uuid "35e42262-e78c-5553-acfe-739684165622" :knowledge-point/title "Completing a Truth Table for an Equivalence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49b4a957-e2ab-592d-98ad-6b79c9d61e79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186411126} {:answer/id #uuid "6d8ee3de-1f02-5693-b88a-f715165a2f8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{F}" :db/id #edb/ref 17592186411130}] :answer-field/correct {:answer/id #uuid "49b4a957-e2ab-592d-9