#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186559925} :activity/id #uuid "27a2bc46-a0f5-5791-9d35-ee6f833ee8a1" :activity/scope {:db/id #edb/ref 17592186050323 :topic/id #uuid "3fe5d92e-4a94-51cb-9e17-50ec23a535d3" :topic/math-academy-id 1676} :activity/steps [{:db/id #edb/ref 17592186559895 :step/content {:db/id #edb/ref 17592186559801 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80e32f2d-3c6b-5170-a45d-be7ada8fedbb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{y}{w-8}" :db/id #edb/ref 17592186559336} {:answer/id #uuid "8b4ec7b5-df2a-5e2a-b909-c4a35d9c756f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{w}{y+6}" :db/id #edb/ref 17592186559367} {:answer/id #uuid "a6b8a513-772f-5dc4-817b-22432a5926b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{y}{w+6}" :db/id #edb/ref 17592186559436} {:answer/id #uuid "bcf406c8-4db3-5b65-bc38-6eab06e49c34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{y}{w-4}" :db/id #edb/ref 17592186559484} {:answer/id #uuid "d3b6ccb4-6cb2-50a8-88bd-e105ef902df7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{y{w}^{2}}{w-4}" :db/id #edb/ref 17592186559537}] :answer-field/correct {:db/id #edb/ref 17592186559484} :answer-field/id #uuid "7460b50b-08fe-5e2c-a44b-c9f0b9e966d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559709}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "414107e1-417e-5cee-adda-177a3b9f7f95" :question/math-academy-id "q-113009" :question/problem "Simplify $\\frac{wy+6y}{{w}^{2}+2w-24}.$" :question/worked-solution "The numerator can be factored as $wy+6y=y(w+6)$ and the denominator can be factored as ${w}^{2}+2w-24=(w+6)(w-4).$ Canceling out any common factors that appear in the numerator and the denominator, we get\n\n$$\n\\begin{aligned}\\frac{wy+6y}{{w}^{2}+2w-24} & =\\frac{y(w+6)}{(w+6)(w-4)} \\\\  & =\\frac{y\\cancel{(w+6)}}{\\cancel{(w+6)}(w-4)} \\\\  & =\\frac{y}{w-4}.\\end{aligned}\n$$"} :step/id #uuid "04d8a637-3615-5a68-9997-f32c9376b669"} {:db/id #edb/ref 17592186559925 :step/content {:db/id #edb/ref 17592186559821 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cf3dbed-1703-5b05-93dc-b37b08d4a82e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3n+9}{n+2}" :db/id #edb/ref 17592186559043} {:answer/id #uuid "39e44e38-e794-51af-ad5d-9b587ae72e0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3n+6}{n+2}" :db/id #edb/ref 17592186559158} {:answer/id #uuid "4280fe2d-0adf-5531-bf2e-d7764e07d575" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3(n+2)}{n+3}" :db/id #edb/ref 17592186559187} {:answer/id #uuid "42e7fc1e-cc93-5bae-9631-3b795d5b8a67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3n+9}{n+3}" :db/id #edb/ref 17592186559190} {:answer/id #uuid "a441ed5a-7914-56cb-b2d9-8fa07a623a90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3n+6}{n+3}" :db/id #edb/ref 17592186559428}] :answer-field/correct {:db/id #edb/ref 17592186559043} :answer-field/id #uuid "136bc470-9c8a-559a-8356-694cb123166f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559651}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "80a74124-ec47-55a3-9e24-4bd2a521aa8c" :question/math-academy-id "q-3488" :question/problem "Which of the following is equivalent to $\\frac{3{n}^{2}+15n+18}{{n}^{2}+4n+4}?$" :question/worked-solution "We factor the numerator and denominator, canceling out any common factors that appear in both.\n\n$$\n\\begin{aligned}\\frac{3{n}^{2}+15n+18}{{n}^{2}+4n+4} & =\\frac{3({n}^{2}+5n+6)}{{n}^{2}+4n+4} \\\\  & =\\frac{3(n+3)(n+2)}{(n+2)(n+2)} \\\\  & =\\frac{3(n+3)\\cancel{(n+2)}}{(n+2)\\cancel{(n+2)}} \\\\  & =\\frac{3(n+3)}{n+2} \\\\  & =\\frac{3n+9}{n+2}.\\end{aligned}\n$$"} :step/id #uuid "4988ca31-6da1-55bf-9d02-a1ae7f0e0e80" :step/next {:db/id #edb/ref 17592186559942}} {:db/id #edb/ref 17592186559942 :step/content {:db/id #edb/ref 17592186559778 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a19ebb9-eb32-5f26-b024-e4e111e111e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5(h+5)}{h-5}" :db/id #edb/ref 17592186559322} {:answer/id #uuid "9a149eb4-3b76-5d09-90e7-b82fe272cdf3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h-15" :db/id #edb/ref 17592186559406} {:answer/id #uuid "a5c62dbc-9eb7-5b0e-9f7c-6b7a00979eee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5h-15" :db/id #edb/ref 17592186559433} {:answer/id #uuid "c22acf02-c6c6-5c01-be71-8571630d69d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5(h+5)}{h+3}" :db/id #edb/ref 17592186559494} {:answer/id #uuid "dd4c551c-c05a-570f-9f97-6911d7e8970e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5h-25" :db/id #edb/ref 17592186559559}] :answer-field/correct {:db/id #edb/ref 17592186559559} :answer-field/id #uuid "7505a7c9-8965-5038-af54-42cf0716d0a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559710}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0c6bffa8-a78e-5e02-8975-6f49c316264d" :question/math-academy-id "q-112994" :question/problem "What is $\\frac{5{h}^{2}-10h-75}{h+3}$ reduced to lowest terms?" :question/worked-solution "The numerator can be factored as\n\n$$\n5{h}^{2}-10h-75=5({h}^{2}-2h-15)=5(h-5)(h+3).\n$$\n\nCanceling out any common factors that appear in the numerator and the denominator, we get\n\n$$\n\\begin{aligned}\\frac{5{h}^{2}-10h-75}{h+3} & = \\\\ \\frac{5(h-5)(h+3)}{h+3} & = \\\\ \\frac{5(h-5)\\cancel{(h+3)}}{\\cancel{h+3}} & = \\\\ \\frac{5(h-5)}{1} & = \\\\ 5h-25 & .\\end{aligned}\n$$"} :step/id #uuid "73032011-28db-5c08-842d-4e460d031593" :step/next {:db/id #edb/ref 17592186559895}}] :activity/title "Simplifying Rational Expressions Using Polynomial Factorization" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186558999}]}
