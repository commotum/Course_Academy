069425 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43bca481-7d34-5259-91cb-874aca82b8b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9(x-1)" :db/id #edb/ref 17592186498885} {:answer/id #uuid "4f0d4325-0f8d-5187-a9a0-6346e4c4c09b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3(x-1)^{3}" :db/id #edb/ref 17592186498914} {:answer/id #uuid "6831cc29-926d-5a0f-9b44-864c4b8510e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3(1-x)" :db/id #edb/ref 17592186498964} {:answer/id #uuid "75522216-0f2f-585a-a400-b83699659bdb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "27(x-1)" :db/id #edb/ref 17592186498991} {:answer/id #uuid "8516910a-3ad3-5900-bf26-9abcee760676" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3(x-1)" :db/id #edb/ref 17592186499029}] :answer-field/correct {:db/id #edb/ref 17592186499029} :answer-field/id #uuid "3c8712f6-aae6-50a7-bb10-c5dc0c11f25f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186067720}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "49c6fb96-74c6-5438-982d-666dbe67b2e9" :question/math-academy-id "q-52493" :question/problem "Simplify $\\sqrt[3]{27(x-1)^{3}}.$" :question/worked-solution "To simplify the expression, we write the term under the radical as a perfect cube, and simplify:\n\n$$\n\\begin{aligned}\\sqrt[3]{27(x-1)^{3}} & = \\\\ \\sqrt[3]{3(x-1)\\cdot 3(x-1)\\cdot 3(x-1)} & = \\\\ \\sqrt[3]{{(3(x-1))}^{3}} & = \\\\ 3(x-1)\\end{aligned}\n$$"} :step/id #uuid "b51e797c-a377-52f5-acf1-019291d3535d" :step/next {:db/id #edb/ref 17592186499576}} {:db/id #edb/ref 17592186499629 :step/content {:db/id #edb/ref 17592186499461 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34df0886-f589-5a77-91fd-b574dff15d23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{a}{4{x}^{2}}" :db/id #edb/ref 17592186498850} {:answer/id #uuid "4869d8e8-8306-5d02-89de-d7b839a472df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{a}{2x}" :db/id #edb/ref 17592186498896} {:answer/id #uuid "669efc65-a593-55a2-9cb2-e9832fd6adb8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{a}{8x}" :db/id #edb/ref 17592186498959} {:answer/id #uuid "9d702685-480a-51e1-930a-6e01b50056fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{a}{4x}" :db/id #edb/ref 17592186499064} {:answer/id #uuid "b0037796-de78-55f7-b178-e17d9506d50d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{a}{8x}" :db/id #edb/ref 17592186499117}] :answer-field/correct {:db/id #edb/ref 17592186498896} :answer-field/id #uuid "efd8c6c1-d268-5074-8c20-054b800150f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186499424}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3ee83331-c90f-5e77-b2f4-e2b981936cc1" :question/math-academy-id "q-82157" :question/problem "Find $\\sqrt[3]{-\\frac{{a}^{3}}{8{x}^{3}}}.$" :question/worked-solution "To simplify the expression, we write the term under the radical as a perfect cube, and simplify:\n\n$$\n\\begin{aligned}\\sqrt[3]{-\\frac{{a}^{3}}{8{x}^{3}}} & = \\\\ \\sqrt[3]{(-\\frac{a}{2x})\\cdot (-\\frac{a}{2x})\\cdot (-\\frac{a}{2x})} & = \\\\ \\sqrt[3]{{(-\\frac{a}{2x})}^{3}} & = \\\\ -\\frac{a}{2x}\\end{aligned}\n$$"} :step/id #uuid "e5848270-698c-55c8-973b-062f99103d08"}] :activity/title "The Cube Root of a Perfect Cube With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186498726}]}
