" :question/problem "The expression $\\sqrt[3]{(8-y)^{3}}$ is equivalent to" :question/worked-solution "The expression underneath the radical is already a perfect cube. Therefore,\n\n$$\n\\begin{aligned}\\sqrt[3]{(8-y)^{3}} & =8-y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186499461 :knowledge-point/_questions [{:db/id #edb/ref 17592186068851 :knowledge-point/id #uuid "11c07788-b01d-5788-b2f1-0a027ea53cb2" :knowledge-point/title "Finding the Cube Root of a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34df0886-f589-5a77-91fd-b574dff15d23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{a}{4{x}^{2}}" :db/id #edb/ref 17592186498850} {:answer/id #uuid "4869d8e8-8306-5d02-89de-d7b839a472df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{a}{2x}" :db/id #edb/ref 17592186498896} {:answer/id #uuid "669efc65-a593-55a2-9cb2-e9832fd6adb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{a}{8x}" :db/id #edb/ref 17592186498959} {:answer/id #uuid "9d702685-480a-51e1-930a-6e01b50056fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{a}{4x}" :db/id #edb/ref 17592186499064} {:answer/id #uuid "b0037796-de78-55f7-b178-e17d9506d50d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{a}{8x}" :db/id #edb/ref 17592186499117}] :answer-field/correct {:answer/id #uuid "4869d8e8-8306-5d02-89de-d7b839a472df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{a}{2x}" :db/id #edb/ref 17592186498896} :answer-field/id #uuid "efd8c6c1-d268-5074-8c20-054b800150f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499424}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3ee83331-c90f-5e77-b2f4-e2b981936cc1" :question/math-academy-id "q-82157" :question/problem "Find $\\sqrt[3]{-\\frac{{a}^{3}}{8{x}^{3}}}.$" :question/worked-solution "To simplify the expression, we write the term under the radical as a perfect cube, and simplify:\n\n$$\n\\begin{aligned}\\sqrt[3]{-\\frac{{a}^{3}}{8{x}^{3}}} & = \\\\ \\sqrt[3]{(-\\frac{a}{2x})\\cdot (-\\frac{a}{2x})\\cdot (-\\frac{a}{2x})} & = \\\\ \\sqrt[3]{{(-\\frac{a}{2x})}^{3}} & = \\\\ -\\frac{a}{2x}\\end{aligned}\n$$"}]}
