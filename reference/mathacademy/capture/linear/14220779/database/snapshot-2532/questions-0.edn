x+7)^{2}-18\n$$\n\nTherefore, $p=7$ and $q=-18.$"}] [{:db/id #edb/ref 17592186532699 :knowledge-point/_questions [{:db/id #edb/ref 17592186068873 :knowledge-point/id #uuid "f10e4a34-a512-5ff4-abbc-66e6830d63d0" :knowledge-point/title "Completing the Square When the Perfect Square is Isolated"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1021c09e-4b23-50d3-922d-60106d1d6f81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186531965}] :answer-field/correct {:answer/id #uuid "1021c09e-4b23-50d3-922d-60106d1d6f81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186531965} :answer-field/id #uuid "31ec9ab8-de52-53b3-909d-0327c74ae195" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186532514} {:answer-field/choices [{:answer/id #uuid "47abdbbd-a0d6-5b25-bcb3-0e7fbfbaf20f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+9" :db/id #edb/ref 17592186532078}] :answer-field/correct {:answer/id #uuid "47abdbbd-a0d6-5b25-bcb3-0e7fbfbaf20f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+9" :db/id #edb/ref 17592186532078} :answer-field/id #uuid "6b269a0c-0c11-5a2c-b30d-ef3067f26c41" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186532542}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ba6abf23-a5c2-510c-be10-8fd79a136d85" :question/math-academy-id "q-250394" :question/problem "Rewrite the following expression as the sum of a perfect square and a constant.\n\n$({x}^{2}+18x+81)+5=(${{field-1}}$)^{2}\\,+$\n{{field-2}}" :question/worked-solution "First, we recall the following formula:\n\n$$\n{x}^{2}+2ax+{a}^{2}=(x+a)^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}+18x+81 & = \\\\ {x}^{2}+2\\cdot 9x+{9}^{2} & = \\\\ (x+9)^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}+18x+81)+5 & = \\\\ (x+9)^{2}+5 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186532655 :knowledge-point/_questions [{:db/id #edb/ref 17592186068874 :knowledge-point/id #uuid "bf9b812d-0dbf-5a67-9d45-3cc5e373b2b1" :knowledge-point/title "Completing the Square When the Perfect Square is Isolated: Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b7af212-c1d2-56fa-a87f-39287490fd25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-2" :db/id #edb/ref 17592186532019}] :answer-field/correct {:answer/id #uuid "2b7af212-c1d2-56fa-a87f-39287490fd25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-2" :db/id #edb/ref 17592186532019} :answer-field/id #uuid "81488556-25a0-54f8-9b86-fc8c6d278aeb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186532552} {:answer-field/choices [{:answer/id #uuid "0c271b6e-988f-5695-b299-e313212eddc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186531956}] :answer-field/correct {:answer/id #uuid "0c271b6e-988f-5695-b299-e313212eddc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186531956} :answer-field/id #uuid "83bb5c88-4cf2-5ca9-a453-6a2cc425e006" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186532554}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "51d99f03-ded8-52c4-99a8-b04fbc348a7b" :question/math-academy-id "q-250441" :question/problem "Rewrite the following expression as the sum of a perfect square and a constant.\n\n$({x}^{2}-4x+4)-10=(${{field-1}}$)^{2}\\,-$\n{{field-2}}" :question/worked-solution "First, we recall the following formula:\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a)^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}-4x+4 & = \\\\ {x}^{2}-2\\cdot 2x+{2}^{2} & = \\\\ (x-2)^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}-4x+4)-10 & = \\\\ (x-2)^{2}-10 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186532698 :knowledge-point/_questions [{:db/id #edb/ref 17592186068875 :knowledge-point/id #uuid "366b36a5-c909-5ea5-a05d-a6052fcd41d7" :knowledge-point/title "Completing the Square on a Quadratic Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e718716f-1d7d-5c1e-9371-daf7cde9204b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186532431}] :answer-field/correct {:answer/id #uuid "e718716f-1d7d-5c1e-9371-daf7cde9204b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186532431} :answer-field/id #uuid "67fff968-5b69-5ebe-bfa8-7177a003e2c4" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186532539} {:answer-field/choices [{:answer/id #uuid "5f776a6a-8c50-57af-a155-1ddb98fbcde2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+10" :db/id #edb/ref 17592186532144}] :answer-field/correct {:answer/id #uuid "5f776a6a-8c50-57af-a155-1ddb98fbcde2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+10" :db/id #edb/ref 17592186532144} :answer-field/id #uuid "e5d7deea-2cab-5d6a-b2d3-2220e5988275" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186532601}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b855896c-0e74-5e62-9ab7-478fd01cda70" :question/math-academy-id "q-250450" :question/problem "Complete the square on the quadratic expression ${y}^{2}+20y+106.$\n\n${y}^{2}+20y+106=(${{field-1}}$)^{2}\\,+$\n{{field-2}}" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}+2\\cdot 10y+106\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${10}^{2},$ writing the constant term $106$ last:\n\n$$\n{{y}^{2}+2\\cdot 10y+{10}^{2}}_{⏟}-\\,{10}^{2}+106\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(y+10)^{2}-{10}^{2}+106\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(y+10)^{2}+6.\n$$"}] [{:db/id #edb/ref 17592186532669 :knowledge-point/_questions [{:db/id #edb/ref 17592186068876 :knowledge-point/id #uuid "08c6d8d6-3d86-5074-bf99-0cb744c9412a" :knowledge-point/title "Completing the Square on a Quadratic Expression with a Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80303f1c-e488-559a-b935-80446c88791a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186532223}] :answer-field/correct {:answer/id #uuid "80303f1c-e488-559a-b935-80446c88791a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186532223} :answer-field/id #uuid "0022224a-fdbd-54de-967f-2328c3eb6871" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186532492} {:answer-field/choices [{:answer/id #uuid "420966e2-15ca-55c3-9f09-b53c223be7c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-4" :db/id #edb/ref 17592186532069}] :answer-field/correct {:answer/id #uuid "420966e2-15ca-55c3-9f09-b53c223be7c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-4" :db/id #edb/ref 17592186532069} :answer-field/id #uuid "acac12fd-6050-55d3-9678-5af612254a1a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186532572}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7bec21b0-2997-5975-9f9b-3c9e1dd0a0f7" :question/math-academy-id "q-250468" :question/problem "Complete the square on the quadratic expression ${y}^{2}-8y+26.$\n\n${y}^{2}-8y+26=(${{field-1}}$)^{2}\\,+$\n{{field-2}}" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}-2\\cdot 4y+26\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${4}^{2},$ writing the constant term $26$ last:\n\n$$\n{{y}^{2}-2\\cdot 4y+{4}^{2}}_{⏟}-\\,{4}^{2}+26\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(y-4)^{2}-{4}^{2}+26\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(y-4)^{2}+10.\n$$"}] [{:db/id #edb/ref 17592186532681 :knowledge-point/_questions [{:db/id #edb/ref 17592186068876 :knowledge-point/id #uuid "08c6d8d6-3d86-5074-bf99-0cb744c9412a" :knowledge-point/title "Completing the Square on a Quadratic Expression with a Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1932a79d-4e2f-5d3f-a617-e8ffcb8d71aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-6)^{2}-3" :db/id #edb/ref 17592186531985} {:answer/id #uuid "5743c63c-942a-5f21-8bac-7ec193c1e106" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-6)^{2}+4" :db/id #edb/ref 17592186532125} {:answer/id #uuid "5e016c46-3617-5f9d-94b5-1c43f2e69e06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-6)^{2}-21" :db/id #edb/ref 17592186532142} {:answer/id #uuid "a4c82222-c3ad-57fc-b6a2-8ef786ebfe1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-12)^{2}+3" :db/id #edb/ref 17592186532304} {:answer/id #uuid "f603e514-ee50-5297-9060-98ad3751aeb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-6)^{2}-25" :db/id #edb/ref 17592186532467}] :answer-field/correct {:answer/id #uuid "5e016c46-3617-5f9d-94b5-1c43f2e69e06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-6)^{2}-21" :db/id #edb/ref 17592186532142} :answer-field/id #uuid "4962f429-26e5-56ce-9a63-ab7afa5c8c95" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186532526}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "93dc778c-0905-5be0-ac96-c8581ce3887e" :question/math-academy-id "q-3661" :question/problem "Complete the square on the quadratic expression ${y}^{2}-12y+15.$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}-2\\cdot 6y+15\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${6}^{2},$ writing the constant term $15$ last:\n\n$$\n{{y}^{2}-2\\cdot 6y+{6}^{2}}_{⏟}-\\,{6}^{2}+15\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(y-6)^{2}-{6}^{2}+15\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(y-6)^{2}-21.\n$$"}]}
