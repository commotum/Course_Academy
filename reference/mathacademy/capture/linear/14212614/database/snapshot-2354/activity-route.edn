#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186525099} :activity/id #uuid "1565ea4e-c392-50d1-9414-12d443b010cf" :activity/scope {:db/id #edb/ref 17592186050269 :topic/id #uuid "3b1ff160-959d-503b-acf5-2be698a50baa" :topic/math-academy-id 3595} :activity/steps [{:db/id #edb/ref 17592186525092 :step/content {:db/id #edb/ref 17592186524960 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "155561b0-11da-52be-a290-8bc7fd41e681" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186524422} {:answer/id #uuid "56a2ddd1-cadc-5a93-9a25-8dddff01f271" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186524532} {:answer/id #uuid "aefdfe8c-fa67-577b-98ee-259e0b602d66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186524663} {:answer/id #uuid "e0fe8d85-7874-5929-8753-4945ee9ab9ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186524773} {:answer/id #uuid "e2a545ba-ef49-5db8-a0d9-0458f6933545" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.5" :db/id #edb/ref 17592186524778}] :answer-field/correct {:db/id #edb/ref 17592186524773} :answer-field/id #uuid "48948107-5211-5ac2-9e2d-522c9771683b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186524871}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "06429645-5834-5aa5-be8c-7530ab34a0e8" :question/math-academy-id "q-134787" :question/problem "![](images/55/553af60aa28cbdd7565259eacc167187bc9c63a5b30cd78a6c14a3c43603fca2.png)\n\nThe scatter plot for the data sets $x$ and $y$ of paired observations and the corresponding linear regression line are shown above.\n\nAccording to the regression model, what is the residual for the highlighted datapoint?" :question/worked-solution "The residual equals the difference between the actual value of the dependent variable and the value estimated using the linear regression model:\n\n$$\n\\text{Residual}=\\text{Actual}-\\text{Estimated}\n$$\n\n \n\nThe highlighted datapoint has coordinates $(5,3).$ So, our actual value is $y=3.$\n\nOn the other hand, the point on the regression line that corresponds to $x=5$ has the $y$-coordinate $5.$ So, our estimated value of is $\\overset{^}{y}=5.$\n\n![](images/c5/c558c80b7056b794534146d3b99f399c3084806758f78bd6eddb39e8c89248e9.png)\n\nTherefore, the residual is\n\n$$\n\\begin{aligned}\\text{Residual} & =\\text{Actual}-\\text{Estimated} \\\\  & =y-\\overset{^}{y} \\\\  & =3-5 \\\\  & =-2.\\end{aligned}\n$$"} :step/id #uuid "4f48dbfb-61be-5cd7-8c7c-7f3723f848b5" :step/next {:db/id #edb/ref 17592186525098}} {:db/id #edb/ref 17592186525098 :step/content {:db/id #edb/ref 17592186525051 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "288479be-98bd-57e4-9608-f6f04980af8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186524457} {:answer/id #uuid "a92e5308-f602-5b56-8117-08f3a63517ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186524653} {:answer/id #uuid "cc7640de-088c-554a-a442-df97fc11d882" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186524720} {:answer/id #uuid "e5da0595-ab74-5f54-bd61-a8b4f9a3237a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186524785} {:answer/id #uuid "ffffc3bb-9a0e-59c2-9d08-ba493528be35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186524841}] :answer-field/correct {:db/id #edb/ref 17592186524457} :answer-field/id #uuid "c15ed523-3e32-50d6-b2d3-15996b2f731b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186524922}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e01898f3-3b5c-52d9-b3b4-b90e