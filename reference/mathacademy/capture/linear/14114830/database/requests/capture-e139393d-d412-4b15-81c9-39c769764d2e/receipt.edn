6045417 true] [17592186409582 1075 #edb/ref 17592186409577 13194139533575 17592186045417 true] [17592186409582 1075 #edb/ref 17592186409579 13194139533575 17592186045417 true] [17592186409582 1076 #edb/ref 17592186045493 13194139533575 17592186045417 true] [17592186409582 1077 "selection" 13194139533575 17592186045417 true] [17592186409582 1078 #edb/ref 17592186409568 13194139533575 17592186045417 true] [17592186409582 1079 #uuid "bc790e07-5a28-514e-aa55-ed9af585fbba" 13194139533575 17592186045417 true] [17592186409583 1075 #edb/ref 17592186409566 13194139533575 17592186045417 true] [17592186409583 1075 #edb/ref 17592186409569 13194139533575 17592186045417 true] [17592186409583 1075 #edb/ref 17592186409570 13194139533575 17592186045417 true] [17592186409583 1075 #edb/ref 17592186409572 13194139533575 17592186045417 true] [17592186409583 1075 #edb/ref 17592186409573 13194139533575 17592186045417 true] [17592186409583 1076 #edb/ref 17592186045493 13194139533575 17592186045417 true] [17592186409583 1077 "selection" 13194139533575 17592186045417 true] [17592186409583 1078 #edb/ref 17592186409566 13194139533575 17592186045417 true] [17592186409583 1079 #uuid "eea492f1-156d-5834-96c0-8454fc274282" 13194139533575 17592186045417 true] [17592186409584 1068 #edb/ref 17592186409581 13194139533575 17592186045417 true] [17592186409584 1069 "q-182506" 13194139533575 17592186045417 true] [17592186409584 1070 #edb/ref 17592186045486 13194139533575 17592186045417 true] [17592186409584 1071 "Which of the following statements are true?\n\n- $A⇒¬B≡¬(A∧B)$\n- $¬(A⇒¬B)≡A∧B$\n- $¬(A⇒¬B)≡¬A∧B$" 13194139533575 17592186045417 true] [17592186409584 1072 #uuid "1308109d-5efe-51ad-bfa1-4050522344dd" 13194139533575 17592186045417 true] [17592186409584 1074 "Let's examine each of our statements:\n\n- Statement I is true. Indeed, $A⇒¬B$ is logically equivalent to the disjunction $¬A∨¬B,$ which by De Morgan's law is equivalent to $¬(A∧B).$\n\n- Statement II is true, while statement III is false. From part I, we have the following equivalence:\n\n$$\nA⇒¬B≡¬(A∧B)\n$$\n\nBy negating this statement, we get\n\n$$\n¬(A⇒¬B)≡¬(¬(A∧B)).\n$$\n\nCanceling out double negation, we reach\n\n$$\nA∧B.\n$$\n\nSo, $¬(A⇒¬B)$ is equivalent to $A∧B.$\n\nTherefore, the correct answer is \"I and II only.\"" 13194139533575 17592186045417 true] [17592186409585 1068 #edb/ref 17592186409582 13194139533575 17592186045417 true] [17592186409585 1069 "q-182492" 13194139533575 17592186045417 true] [17592186409585 1070 #edb/ref 17592186045485 13194139533575 17592186045417 true] [17592186409585 1071 "$Y⇒X\\,≡$" 13194139533575 17592186045417 true] [17592186409585 1072 #uuid "6b7c7494-65e2-5888-808a-8604d9b7cfa1" 13194139533575 17592186045417 true] [17592186409585 1074 "The conditional statement $P⇒Q$ is logically equivalent to the disjunction $¬P∨Q:$\n\nSo, in this case, we have the following equivalence:\n\n$$\nY⇒X\\,≡\\,¬Y∨X\n$$" 13194139533575 17592186045417 true] [17592186409586 1068 #edb/ref 17592186409583 13194139533575 17592186045417 true] [17592186409586 1069 "q-81892" 13194139533575 17592186045417 true] [17592186409586 1070 #edb/ref 17592186045486 13194139533575 17592186045417 true] [17592186409586 1071 "Simplify the statement $(¬B∧C)⇒(B∨¬C).$" 13194139533575 17592186045417 true] [17592186409586 1072 #uuid "c7953127-b916-5d8d-98b4-eeece8a2e1ec" 13194139533575 17592186045417 true] [17592186409586 1074 "First, note that\n\n$$\n(¬B∧C)⇒(B∨¬C)≡¬(¬B∧C)∨(B∨¬C).\n$$\n\nWe can distribute the negation over the disjunction using De Morgan's law:\n\n$$\n¬(¬B∧C)∨(B∨¬C)≡(¬(¬B)∨¬C)∨(B∨¬C)\n$$\n\nCanceling out double negations, we reach\n\n$$\n(¬(¬B)∨¬C)∨(B∨¬C)≡(B∨¬C)∨(B∨¬C).\n$$\n\nFinally, we simplify the disjunction of a statement with itself:\n\n$$\n(B∨¬C)∨(B∨¬C)≡B∨¬C\n$$\n\nSo the given statement is equivalent to $B∨¬C.$" 13194139533575 17592186045417 true] [17592186409587 1062 #uuid "7e76a699-413c-5c79-9a86-67728b6bb289" 13194139533575 17592186045417 true] [17592186409587 1063 #edb/ref 17592186