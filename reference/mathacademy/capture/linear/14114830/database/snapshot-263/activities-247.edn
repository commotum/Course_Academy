#{[{:activity/first-step {:db/id #edb/ref 17592186060552} :activity/id #uuid "29cf2698-b761-565d-9655-9c36bff61aab" :activity/scope {:db/id #edb/ref 17592186049805 :topic/id #uuid "155403ed-fbfa-59a9-b928-e762a73145ef" :topic/math-academy-id 247} :activity/steps [{:db/id #edb/ref 17592186060552 :step/content {:db/id #edb/ref 17592186060984 :tutorial/content "The conditional statement $A \\Rightarrow B$ is logically equivalent to the disjunction $\\lnot A \\lor B{:}$\n\n$$A \\Rightarrow B \\equiv \\lnot A \\lor B$$\n\nWe can verify this by the following truth table:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\, A \\Rightarrow B \\,$ | $\\, \\neg A \\lor B \\,$ |\n| --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\color{blue} \\textrm T$ | $\\color{blue} \\textrm T$ |\n| $\\textrm T$ | $\\textrm F$ | $\\color{blue} \\textrm F$ | $\\color{blue} \\textrm F$ |\n| $\\textrm F$ | $\\textrm T$ | $\\color{blue} \\textrm T$ | $\\color{blue} \\textrm T$ |\n| $\\textrm F$ | $\\textrm F$ | $\\color{blue} \\textrm T$ | $\\color{blue} \\textrm T$ |\n\nIn other words, any conditional statement of the form\n\n$\\qquad$ *if antecedent, then consequent*\n\ncan be expressed equivalently as\n\n$\\qquad$ *not antecedent, or consequent.*\n\nFor example, consider the following conditional statement:\n\n$\\qquad$ *If you do not take your watch, then you will be late for the meeting.*\n\nLet's rewrite this statement using its logically equivalent form.\n\nFirst, we denote the antecedent $A$ and consequent $B$ as follows:\n\n- $A{:}$ You do not take your watch.\n- $B{:}$ You will be late for the meeting.\n\nThen, our initial statement can be written as $A \\Rightarrow B,$ which is logically equivalent to\n\n$$\\neg A \\lor B.$$\n\nThe negation of $A$ is:\n\n- $\\neg A{:}$ You take your watch.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\qquad$ *You take your watch, or you will be late for the meeting.*\n\nWe can write this using more everyday language as follows:\n\n$\\qquad$ *Take your watch, or you will be late for the meeting.*\n\nAnother way to write this is to append the word \"either\" to the beginning of the sentence, like so:\n\n$\\qquad$ *Either you take your watch, or you will be late for the meeting.*\n\nUsing the word \"either\" helps clarify that the sentence structure presents two alternatives and is particularly useful when employing the disjunctive form $(\\lnot A\\lor B)$ in conversational or formal English. So, the phrase effectively conveys that one of the two stated conditions will hold true." :tutorial/id #uuid "6634a172-a5c9-557f-9091-35a4ebd198d3" :tutorial/math-academy-id 7978 :tutorial/title "Introduction"} :step/id #uuid "082980d1-6f7a-54ee-8a3f-6ce0b731dc29" :step/math-academy-id 139680 :step/next {:db/id #edb/ref 17592186060553}} {:db/id #edb/ref 17592186060553 :step/content {:db/id #edb/ref 17592186059687 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059409 :question/id #uuid "48364248-d296-502c-96da-d1905be35627" :question/math-academy-id "e-12707"} :knowledge-point/id #uuid "8b60a8ae-c04f-530a-b89c-f8ac70969d0f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048349} {:db/id #edb/ref 17592186048778} {:db/id #edb/ref 17592186050360}] :knowledge-point/questions [{:db/id #edb/ref 17592186060139} {:db/id #edb/ref 17592186060140} {:db/id #edb/ref 17592186379181} {:db/id #edb/ref 17592186379188} {:db/id #edb/ref 17592186401722} {:db/id #edb/ref 17592186401729}] :knowledge-point/title "Expressing Conditional Statements as Disjunctions"} :step/id #uuid "9889ed7d-e94e-5481-9500-3dcd8edb1f23" :step/math-academy-id 139681 :step/next {:db/id #edb/ref 17592186060554}} {:db/id #edb/ref 17592186060554 :step/content {:db/id #edb/ref 17592186059688 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059425 :question/id #uuid "54512495-0ca8-55a3-834d-0b70f96a5fe7" :question/math-academy-id "e-13231"} :knowledge-point/id #uuid "0936217d-66d2-5360-b88b-a30683720415" :knowledge-point/questions [{:db/id #edb/ref 17592186060149} {:db/id #edb/ref 17592186060150} {:db/id #edb/ref 17592186379154} {:db/id #edb/ref 17592186379260} {:db/id #edb/ref 17592186379267} {:db/id #edb/ref 17592186401736}] :knowledge-point/title "Expressing Disjunctive Statements as Conditionals"} :step/id #uuid "c1808ea7-1187-5229-8eb6-1d0bb6fff501" :step/math-academy-id 139684 :step/next {:db/id #edb/ref 17592186060555}} {:db/id #edb/ref 17592186060555 :step/content {:db/id #edb/ref 17592186059689 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059411 :question/id #uuid "b9a65dc8-528a-5c3c-b518-a2bbecc551c8" :question/math-academy-id "e-12709"} :knowledge-point/id #uuid "0d56b033-a2c8-57c7-adde-e574d726ec78" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048378}] :knowledge-point/questions [{:db/id #edb/ref 17592186060142} {:db/id #edb/ref 17592186060143} {:db/id #edb/ref 17592186378712} {:db/id #edb/ref 17592186379167} {:db/id #edb/ref 17592186379174} {:db/id #edb/ref 17592186389677} {:db/id #edb/ref 17592186409584} {:db/id #edb/ref 17592186409585}] :knowledge-point/title "Rewriting Symbolic Conditional Statements"} :step/id #uuid "34a8f3e2-6b17-513b-bc4e-df73bc766ffa" :step/math-academy-id 139687 :step/next {:db/id #edb/ref 17592186060556}} {:db/id #edb/ref 17592186060556 :step/content {:db/id #edb/ref 17592186059690 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059410 :question/id #uuid "caa49bb8-c66f-56cb-a3d2-a7616abee38c" :question/math-academy-id "e-12708"} :knowledge-point/id #uuid "eec6cf11-74cc-5b3a-b2fe-bd4285fe4a88" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049824} {:db/id #edb/ref 17592186050128}] :knowledge-point/questions [{:db/id #edb/ref 17592186060062} {:db/id #edb/ref 17592186060412} {:db/id #edb/ref 17592186060421} {:db/id #edb/ref 17592186378174} {:db/id #edb/ref 17592186378732} {:db/id #edb/ref 17592186386034} {:db/id #edb/ref 17592186386041} {:db/id #edb/ref 17592186409586}] :knowledge-point/title "Rewriting Conditional Statement Using the Associative, Commutative, and Absorption Laws"} :step/id #uuid "f956015e-ca45-5f2f-8813-7e7f2a215cba" :step/math-academy-id 139690}] :activity/title "Logical Equivalence with Conditional Statements" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186059925}] [{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186409588} :activity/id #uuid "f39321ff-9db6-52db-bca8-a10eccf4ff9b" :activity/scope {:db/id #edb/ref 17592186049805 :topic/id #uuid "155403ed-fbfa-59a9-b928-e762a73145ef" :topic/math-academy-id 247} :activity/steps [{:db/id #edb/ref 17592186409587 :step/content {:db/id #edb/ref 17592186409584 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "776196c9-cd05-5240-9195-0b0ce27cb444" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186409574} {:answer/id #uuid "8c6f81fa-ef3e-50ce-8cd2-a95e102cf1da" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186409575} {:answer/id #uuid "9ebe90ec-2497-5de0-b5bd-ba3d0c79d56c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186409576} {:answer/id #uuid "cff472a8-e087-557d-80e6-5d535af2d5c5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186409578} {:answer/id #uuid "e1eca4c9-2b1c-5f16-824c-d7eea7cfd316" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186409580}] :answer-field/correct {:db/id #edb/ref 17592186409574} :answer-field/id #uuid "7645b3d9-5bcf-5720-89a4-adc2f8073a1c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409581}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1308109d-5efe-51ad-bfa1-4050522344dd" :question/math-academy-id "q-182506" :question/problem "Which of the following statements are true?\n\n- $A⇒¬B≡¬(A∧B)$\n- $¬(A⇒¬B)≡A∧B$\n- $¬(A⇒¬B)≡¬A∧B$" :question/worked-solution "Let's examine each of our statements:\n\n- Statement I is true. Indeed, $A⇒¬B$ is logically equivalent to the disjunction $¬A∨¬B,$ which by De Morgan's law is equivalent to $¬(A∧B).$\n\n- Statement II is true, while statement III is false. From part I, we have the following equivalence:\n\n$$\nA⇒¬B≡¬(A∧B)\n$$\n\nBy negating this statement, we get\n\n$$\n¬(A⇒¬B)≡¬(¬(A∧B)).\n$$\n\nCanceling out double negation, we reach\n\n$$\nA∧B.\n$$\n\nSo, $¬(A⇒¬B)$ is equivalent to $A∧B.$\n\nTherefore, the correct answer is \"I and II only.\""} :step/id #uuid "7e76a699-413c-5c79-9a86-67728b6bb289"} {:db/id #edb/ref 17592186409588 :step/content {:db/id #edb/ref 17592186409586 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "191c421c-bbe9-5286-9beb-03027543bcc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "B∨¬C" :db/id #edb/ref 17592186409566} {:answer/id #uuid "33e9615f-fd80-5202-949f-ebfef4f3e8b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬B∨C" :db/id #edb/ref 17592186409569} {:answer/id #uuid "35dc661b-8042-5dd9-ae2c-1ddb0493316b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "B∧¬C" :db/id #edb/ref 17592186409570} {:answer/id #uuid "442d26c2-04f3-57d7-adf7-53465469c631" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬B∧C" :db/id #edb/ref 17592186409572} {:answer/id #uuid "4c2b2d55-0e4e-5769-9706-03ec9ecc763c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "B∨C" :db/id #edb/ref 17592186409573}] :answer-field/correct {:db/id #edb/ref 17592186409566} :answer-field/id #uuid "eea492f1-156d-5834-96c0-8454fc274282" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409583}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c7953127-b916-5d8d-98b4-eeece8a2e1ec" :question/math-academy-id "q-81892" :question/problem "Simplify the statement $(¬B∧C)⇒(B∨¬C).$" :question/worked-solution "First, note that\n\n$$\n(¬B∧C)⇒(B∨¬C)≡¬(¬B∧C)∨(B∨¬C).\n$$\n\nWe can distribute the negation over the disjunction using De Morgan's law:\n\n$$\n¬(¬B∧C)∨(B∨¬C)≡(¬(¬B)∨¬C)∨(B∨¬C)\n$$\n\nCanceling out double negations, we reach\n\n$$\n(¬(¬B)∨¬C)∨(B∨¬C)≡(B∨¬C)∨(B∨¬C).\n$$\n\nFinally, we simplify the disjunction of a statement with itself:\n\n$$\n(B∨¬C)∨(B∨¬C)≡B∨¬C\n$$\n\nSo the given statement is equivalent to $B∨¬C.$"} :step/id #uuid "b1214e01-49e9-573c-a4c8-4d572ee5620a" :step/next {:db/id #edb/ref 17592186409589}} {:db/id #edb/ref 17592186409589 :step/content {:db/id #edb/ref 17592186409585 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b57f374-7974-5938-b11d-cfd731887fe8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∨¬Y" :db/id #edb/ref 17592186409567} {:answer/id #uuid "33e6f69b-ceb9-546e-bc81-3a178a362d67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬Y∨X" :db/id #edb/ref 17592186409568} {:answer/id #uuid "42a65b2d-e5f8-5a76-b55d-46a8613eea7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬Y∧X" :db/id #edb/ref 17592186409571} {:answer/id #uuid "a433720c-898a-5e82-b529-c83bbf9df930" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∧Y" :db/id #edb/ref 17592186409577} {:answer/id #uuid "d0b85a9a-afc4-5057-b50b-a3fabfd591bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∨Y" :db/id #edb/ref 17592186409579}] :answer-field/correct {:db/id #edb/ref 17592186409568} :answer-field/id #uuid "bc790e07-5a28-514e-aa55-ed9af585fbba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409582}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6b7c7494-65e2-5888-808a-8604d9b7cfa1" :question/math-academy-id "q-182492" :question/problem "$Y⇒X\\,≡$" :question/worked-solution "The conditional statement $P⇒Q$ is logically equivalent to the disjunction $¬P∨Q:$\n\nSo, in this case, we have the following equivalence:\n\n$$\nY⇒X\\,≡\\,¬Y∨X\n$$"} :step/id #uuid "ede73126-39fd-544c-9a47-ac55caf10274" :step/next {:db/id #edb/ref 17592186409587}}] :activity/title "Logical Equivalence with Conditional Statements" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186409565}]}
