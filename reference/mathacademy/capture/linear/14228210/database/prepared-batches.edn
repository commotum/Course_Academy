[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186073673 :knowledge-point/questions ["question-ebda143e-32ac-588d-bb70-63d0142c284b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ebda143e-32ac-588d-bb70-63d0142c284b" :question/id #uuid "ebda143e-32ac-588d-bb70-63d0142c284b" :question/math-academy-id "q-54165" :question/problem "Find a value of $x$ satisfying the equation $\\operatorname{cot}⁡{61}^{∘}=\\operatorname{tan}⁡x.$" :question/worked-solution "Since the cotangent of an angle equals the tangent of its complement, we have\n\n$$\n\\operatorname{cot}⁡{61}^{∘}=\\operatorname{tan}⁡({90}^{∘}-{61}^{∘})=\\operatorname{tan}⁡{29}^{∘}.\n$$\n\nTherefore, $x={29}^{∘}$ satisfies the given equation." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f1136b74-6034-598a-adbe-d3d54ab43b8c"] :db/ensure [:question/validate]} {:db/id "answer-field-f1136b74-6034-598a-adbe-d3d54ab43b8c" :answer-field/id #uuid "f1136b74-6034-598a-adbe-d3d54ab43b8c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8718d378-3671-57d6-8abd-ace85ee02878" :answer-field/choices ["answer-38c3d6a9-5ad0-509f-b053-9f0356aa4fcf" "answer-afe422a8-d707-5f59-ab2f-273daf6ca9d9" "answer-f35e6b7b-5124-511d-b409-af45d7700f1c" "answer-8718d378-3671-57d6-8abd-ace85ee02878" "answer-37e36ca0-728d-5777-83e2-15bb76b35468"] :db/ensure [:answer-field/validate]} {:db/id "answer-38c3d6a9-5ad0-509f-b053-9f0356aa4fcf" :answer/id #uuid "38c3d6a9-5ad0-509f-b053-9f0356aa4fcf" :answer/type :answer.type/math :answer/value "{20}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-afe422a8-d707-5f59-ab2f-273daf6ca9d9" :answer/id #uuid "afe422a8-d707-5f59-ab2f-273daf6ca9d9" :answer/type :answer.type/math :answer/value "{22}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-f35e6b7b-5124-511d-b409-af45d7700f1c" :answer/id #uuid "f35e6b7b-5124-511d-b409-af45d7700f1c" :answer/type :answer.type/math :answer/value "{25}^{∘}" :db/en