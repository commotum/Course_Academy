knowledge-point/questions "question-ebda143e-32ac-588d-bb70-63d0142c284b"] ["question-5cb3bde9-32a4-52cd-9e8b-d6d4c061a2e8" :question/id #uuid "5cb3bde9-32a4-52cd-9e8b-d6d4c061a2e8"] ["question-5cb3bde9-32a4-52cd-9e8b-d6d4c061a2e8" :question/math-academy-id "q-76838"] ["question-5cb3bde9-32a4-52cd-9e8b-d6d4c061a2e8" :question/problem "$\\operatorname{cot}⁡({27}^{∘}-\\theta )=$"] ["question-5cb3bde9-32a4-52cd-9e8b-d6d4c061a2e8" :question/worked-solution "We know that the cofunction of $\\operatorname{cot}⁡\\theta $ is $\\operatorname{tan}⁡\\theta ,$ and the angle complementary to ${27}^{∘}-\\theta $ is \n\n$$\n{90}^{∘}-({27}^{∘}-\\theta )={90}^{∘}-{27}^{∘}+\\theta ={63}^{∘}+\\theta .\n$$\n\nSo we have\n\n$$\n\\operatorname{cot}⁡({27}^{∘}-\\theta )=\\operatorname{tan}⁡({90}^{∘}-({27}^{∘}-\\theta ))=\\operatorname{tan}⁡({63}^{∘}+\\theta ).\n$$"] ["question-5cb3bde9-32a4-52cd-9e8b-d6d4c061a2e8" :question/difficulty :question.difficulty/moderate] ["answer-field-555314da-5e88-5538-91a3-29bd66ea2f89" :answer-field/id #uuid "555314da-5e88-5538-91a3-29bd66ea2f89"] ["answer-ffea38d3-c884-5870-9640-07170f484d8c" :answer/id #uuid "ffea38d3-c884-5870-9640-07170f484d8c"] ["answer-ffea38d3-c884-5870-9640-07170f484d8c" :answer/type :answer.type/math] ["answer-ffea38d3-c884-5870-9640-07170f484d8c" :answer/value "\\operatorname{sin}⁡({117}^{∘}-\\theta )"] ["answer-41ef6204-53b5-57d1-aff2-d8612595549f" :answer/id #uuid "41ef6204-53b5-57d1-aff2-d8612595549f"] ["answer-41ef6204-53b5-57d1-aff2-d8612595549f" :answer/type :answer.type/math] ["answer-41ef6204-53b5-57d1-aff2-d8612595549f" :answer/value "\\operatorname{sin}⁡({63}^{∘}+\\theta )"] ["answer-b0afc406-fee9-55f5-92dc-507c9f3aad2f" :answer/id #uuid "b0afc406-fee9-55f5-92dc-507c9f3aad2f"] ["answer-b0afc406-fee9-55f5-92dc-507c9f3aad2f" :answer/type :answer.type/math] ["answer-b0afc406-fee9-55f5-92dc-507c9f3aad2f" :answer/value "\\operatorname{tan}⁡({117}^{∘}+\\theta )"] ["answer-2bbc56e7-2aaf-5e66-b87f-ea39cdff55ec" :answer/id #uuid "