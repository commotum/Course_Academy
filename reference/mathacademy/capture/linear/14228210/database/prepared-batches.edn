validate]} {:db/id "answer-field-3954b075-3cbd-547a-ab25-a35f014d84a8" :answer-field/id #uuid "3954b075-3cbd-547a-ab25-a35f014d84a8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ec8b7699-f736-58a7-a627-e8c62a400d67" :answer-field/choices ["answer-201f479f-c986-5031-a33c-dbafb94414b7" "answer-196e30cc-dd4b-56ea-a0b6-1806966dbb09" "answer-ec8b7699-f736-58a7-a627-e8c62a400d67" "answer-6244bb6c-d4f3-5dc9-b931-a8f929d8ca7e" "answer-80eac182-2d21-5af9-acc3-8bc865bbba69"] :db/ensure [:answer-field/validate]} {:db/id "answer-201f479f-c986-5031-a33c-dbafb94414b7" :answer/id #uuid "201f479f-c986-5031-a33c-dbafb94414b7" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-196e30cc-dd4b-56ea-a0b6-1806966dbb09" :answer/id #uuid "196e30cc-dd4b-56ea-a0b6-1806966dbb09" :answer/type :answer.type/math :answer/value "13" :db/ensure [:answer/validate]} {:db/id "answer-ec8b7699-f736-58a7-a627-e8c62a400d67" :answer/id #uuid "ec8b7699-f736-58a7-a627-e8c62a400d67" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "answer-6244bb6c-d4f3-5dc9-b931-a8f929d8ca7e" :answer/id #uuid "6244bb6c-d4f3-5dc9-b931-a8f929d8ca7e" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-80eac182-2d21-5af9-acc3-8bc865bbba69" :answer/id #uuid "80eac182-2d21-5af9-acc3-8bc865bbba69" :answer/type :answer.type/math :answer/value "17" :db/ensure [:answer/validate]} {:db/id "activity-85248f71-9a91-59f8-abfd-a331609b85d7" :activity/id #uuid "85248f71-9a91-59f8-abfd-a331609b85d7" :activity/title "Trigonometric Functions of Complementary Angles" :activity/type :activity.type/review :activity/scope 17592186050295 :activity/course 17592186046647 :activity/steps ["step-936a37e0-3b01-55f9-87dc-10c8d8e898c3" "step-85c20f4a-b465-5c04-9a70-5f8524fd68f3" "step-0a6e5921-a726-56cb-bfef-3f735f7f9c34"] :activity/first-step "step-936a37e0-3b01-55f9-87d