#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186550079} :activity/id #uuid "85248f71-9a91-59f8-abfd-a331609b85d7" :activity/scope {:db/id #edb/ref 17592186050295 :topic/id #uuid "3d7bd7bf-6970-5ce8-8de1-27d53b866227" :topic/math-academy-id 510} :activity/steps [{:db/id #edb/ref 17592186550026 :step/content {:db/id #edb/ref 17592186549955 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "196e30cc-dd4b-56ea-a0b6-1806966dbb09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186549367} {:answer/id #uuid "201f479f-c986-5031-a33c-dbafb94414b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186549379} {:answer/id #uuid "6244bb6c-d4f3-5dc9-b931-a8f929d8ca7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186549510} {:answer/id #uuid "80eac182-2d21-5af9-acc3-8bc865bbba69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "17" :db/id #edb/ref 17592186549555} {:answer/id #uuid "ec8b7699-f736-58a7-a627-e8c62a400d67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186549750}] :answer-field/correct {:db/id #edb/ref 17592186549750} :answer-field/id #uuid "3954b075-3cbd-547a-ab25-a35f014d84a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549827}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3a13b69c-0da2-5493-86d2-76c8bc977240" :question/math-academy-id "q-76841" :question/problem "If $m∠A=(3x+1)^{∘}$ and $m∠B=(4x-9)^{∘},$ find a value of $x$ that satisfies $\\operatorname{cot}⁡A=\\operatorname{tan}⁡B.$  Suppose that both $∠A$ and $∠B$ are acute." :question/worked-solution "If both angles are acute and $\\operatorname{cot}⁡A=\\operatorname{tan}⁡B,$ then the angles $∠A$ and $∠B$ must be complementary, and we have\n\n$$\n\\begin{aligned}(3x+1)^{∘}+(4x-9)^{∘} & ={90}^{∘} \\\\ (7x-8)^{∘} & ={90}^{∘} \\\\ 7x-8 & =90 \\\\ 7x & =98 \\\\ x & =14.\\end{aligned}\n$$"} :step/id #uuid "0a6e5921-a726-56cb-bfef-3f735f7f9c34"} {:db/id #edb/ref 17592186550074 :step/content {:db/id #edb/ref 17592186549964 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "232770a9-261e-542e-9bec-2581712671f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡({63}^{∘}+\\theta )" :db/id #edb/ref 17592186549387} {:answer/id #uuid "2bbc56e7-2aaf-5e66-b87f-ea39cdff55ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡({117}^{∘}-\\theta )" :db/id #edb/ref 17592186549412} {:answer/id #uuid "41ef6204-53b5-57d1-aff2-d8612595549f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡({63}^{∘}+\\theta )" :db/id #edb/ref 17592186549454} {:answer/id #uuid "b0afc406-fee9-55f5-92dc-507c9f3aad2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡({117}^{∘}+\\theta )" :db/id #edb/ref 17592186549646} {:answer/id #uuid "ffea38d3-c884-5870-9640-07170f484d8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡({117}^{∘}-\\theta )" :db/id #edb/ref 17592186549795}] :answer-field/correct {:db/id #edb/ref 17592186549387} :answer-field/id #uuid "555314da-5e88-5538-91a3-29bd66ea2f89" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549835}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5cb3bde9-32a4-52cd-9e8b-d6d4c061a2e8" :question/math-academy-id "q-76838" :question/problem "$\\operatorname{cot}⁡({27}^{∘}-\\theta )=$" :question/worked-solution "We know that the cofunction of $\\operatorname{cot}⁡\\theta $ is $\\operatorname{tan}⁡\\theta ,$ and the angle complementary to ${27}^{∘}-\\theta $ is \n\n$$\n{90}^{∘}-({27}^{∘}-\\theta )={90}^{∘}-{27}^{∘}+\\theta ={63}^{∘}+\\theta .\n$$\n\nSo we have\n\n$$\n\\operatorname{cot}⁡({27}^{∘}-\\theta )=\\operatorname{tan}⁡({90}^{∘}-({27}^{∘}-\\theta ))=\\operatorname{tan}⁡({63}^{∘}+\\theta ).\n$$"} :step/id #uuid "85c20f4a-b465-5c04-9a70-5f8524fd68f3" :step/next {:db/id #edb/ref 17592186550026}} {:db/id #edb/ref 17592186550079 :step/content {:db/id #edb/ref 17592186550010 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37e36ca0-728d-5777-83e2-15bb76b35468" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{31}^{∘}" :db/id #edb/ref 17592186549429} {:answer/id #uuid "38c3d6a9-5ad0-509f-b053-9f0356aa4fcf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{20}^{∘}" :db/id #edb/ref 17592186549431} {:answer/id #uuid "8718d378-3671-57d6-8abd-ace85ee02878" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{29}^{∘}" :db/id #edb/ref 17592186549568} {:answer/id #uuid "afe422a8-d707-5f59-ab2f-273daf6ca9d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{22}^{∘}" :db/id #edb/ref 17592186549645} {:answer/id #uuid "f35e6b7b-5124-511d-b409-af45d7700f1c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{25}^{∘}" :db/id #edb/ref 17592186549771}] :answer-field/correct {:db/id #edb/ref 17592186549568} :answer-field/id #uuid "f1136b74-6034-598a-adbe-d3d54ab43b8c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549915}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ebda143e-32ac-588d-bb70-63d0142c284b" :question/math-academy-id "q-54165" :question/problem "Find a value of $x$ satisfying the equation $\\operatorname{cot}⁡{61}^{∘}=\\operatorname{tan}⁡x.$" :question/worked-solution "Since the cotangent of an angle equals the tangent of its complement, we have\n\n$$\n\\operatorname{cot}⁡{61}^{∘}=\\operatorname{tan}⁡({90}^{∘}-{61}^{∘})=\\operatorname{tan}⁡{29}^{∘}.\n$$\n\nTherefore, $x={29}^{∘}$ satisfies the given equation."} :step/id #uuid "936a37e0-3b01-55f9-87dc-10c8d8e898c3" :step/next {:db/id #edb/ref 17592186550074}}] :activity/title "Trigonometric Functions of Complementary Angles" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186549309}]}
