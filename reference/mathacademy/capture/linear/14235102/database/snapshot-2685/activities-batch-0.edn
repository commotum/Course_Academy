#{[{:activity/first-step {:db/id #edb/ref 17592186055736} :activity/id #uuid "20dc52fd-28a9-5191-a425-32855a28683b" :activity/scope {:db/id #edb/ref 17592186049831 :topic/id #uuid "1726eb44-d776-5df6-8797-69b129ad3167" :topic/math-academy-id 34} :activity/steps [{:db/id #edb/ref 17592186055736 :step/content {:db/id #edb/ref 17592186055976 :tutorial/content "The **magnitude** of a complex number is its distance from the origin. It's denoted as $\\mid z \\mid$.\n\nFor example, consider the complex number\n\n$$\nz=-4+5\\textrm{i}\n$$\n\nshown in the complex plane below.\n\n![](images/33/33d0294178c15b883f8f4988e34d7c81244edd9f426e9ed206e10469dbc5abf1.png)\n\nUsing the Pythagorean theorem, we obtain\n\n$$\n\\begin{aligned}\n\\mid z \\mid &= \\sqrt{(-4)^{2} + (5)^{2}} \\\\\n&= \\sqrt{16 + 25} \\\\\n&= \\sqrt{41}\n\\end{aligned}\n$$\n\nIn general, for a complex number\n\n$$\nz=a+b\\textrm{i}\n$$\n\nthe magnitude of $z$ can be found as follows:\n\n$$\n\\mid z \\mid = \\sqrt{a^2+b^2}\n$$" :tutorial/id #uuid "df0d2109-2954-5b2d-8b02-98a43f80ac89" :tutorial/math-academy-id 3329 :tutorial/title "Introduction"} :step/id #uuid "332a5684-42f1-5051-9109-e6eecf07792c" :step/math-academy-id 464642 :step/next {:db/id #edb/ref 17592186055737}} {:db/id #edb/ref 17592186055737 :step/content {:db/id #edb/ref 17592186054735 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054548 :question/id #uuid "98b156f1-66b9-56f5-be59-ba15d1b857db" :question/math-academy-id "e-5038"} :knowledge-point/id #uuid "54d9d8e4-c521-5b7d-bca7-f3c5b0d2b1d7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050191} {:db/id #edb/ref 17592186050975}] :knowledge-point/questions [{:db/id #edb/ref 17592186055466} {:db/id #edb/ref 17592186055511} {:db/id #edb/ref 17592186234471}] :knowledge-point/title "Finding the Magnitude of a Complex Number"} :step/id #uuid "cb92b79b-ab97-5fdc-b40d-801d52bba2ca" :step/math-academy-id 464643 :step/next {:db/id #edb/ref 17592186055738}} {:db/id #edb/ref 17592186055738 :step/content {:db/id #edb/ref 17592186054736 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054549 :question/id #uuid "d9f8cffb-bbf9-5b42-bec1-26c43277a335" :question/math-academy-id "e-5039"} :knowledge-point/id #uuid "0959286b-1859-50b5-acd2-d83ffc4ed96d" :knowledge-point/questions [{:db/id #edb/ref 17592186055468} {:db/id #edb/ref 17592186055469} {:db/id #edb/ref 17592186515596} {:db/id #edb/ref 17592186515604} {:db/id #edb/ref 17592186544810} {:db/id #edb/ref 17592186544890}] :knowledge-point/title "Finding the Magnitude of a Complex Number With No Real Part"} :step/id #uuid "fd86a525-dbf1-5d5d-8bce-6a9c5a832457" :step/math-academy-id 464646 :step/next {:db/id #edb/ref 17592186055739}} {:db/id #edb/ref 17592186055739 :step/content {:db/id #edb/ref 17592186054737 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054550 :question/id #uuid "bb7cf016-642b-5cd2-8fd8-006b890b3c1b" :question/math-academy-id "e-5041"} :knowledge-point/id #uuid "0ba72f2d-3029-5ebe-9527-8ea775beac22" :knowledge-point/questions [{:db/id #edb/ref 17592186055512} {:db/id #edb/ref 17592186055513} {:db/id #edb/ref 17592186515521}] :knowledge-point/title "Finding the Magnitude of a Complex Number With Variable Coefficients"} :step/id #uuid "ea96e969-a594-52d8-a7bc-fe570264819e" :step/math-academy-id 464649}] :activity/title "The Magnitude of a Complex Number" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054896}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186515664} :activity/id #uuid "f464d2cc-f0ba-5134-8a71-a42676f27b5c" :activity/scope {:db/id #edb/ref 17592186049831 :topic/id #uuid "1726eb44-d776-5df6-8797-69b129ad3167" :topic/math-academy-id 34} :activity/steps [{:db/id #edb/ref 17592186515664 :step/content {:db/id #edb/ref 17592186515604 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4240242c-ccfc-5919-bcd1-23f365cf0d9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-13" :db/id #edb/ref 17592186515012} {:answer/id #uuid "5fc877af-90aa-504b-aeaa-80f58a1269ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{13}" :db/id #edb/ref 17592186515080} {:answer/id #uuid "81fce244-4b65-5986-bf17-3c08a29adf62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{13}" :db/id #edb/ref 17592186515142} {:answer/id #uuid "9313ceb2-8065-5a51-8891-b63edaff61bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186515181} {:answer/id #uuid "e910e0d2-e229-5e15-aa4e-2cbc5871b5be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{-13}" :db/id #edb/ref 17592186515363}] :answer-field/correct {:db/id #edb/ref 17592186515181} :answer-field/id #uuid "fea1f402-87f7-543c-a08b-8028f822c3a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186515515}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d1878d53-723f-5989-b8bc-003976423212" :question/math-academy-id "q-70258" :question/problem "What is the magnitude of the number $z=-13\\text{i}?$" :question/worked-solution "The imaginary number $-13\\text{i}$ is equivalent to the complex number $z=0-13\\text{i}.$\n\nWe know that for a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nSo, the magnitude of $z=0-13\\text{i}$ is given by\n\n$$\n\\begin{aligned}|z| & =\\sqrt{{a}^{2}+{b}^{2}} \\\\  & =\\sqrt{(0)^{2}+(-13)^{2}} \\\\  & =13.\\end{aligned}\n$$"} :step/id #uuid "7220f931-8523-5f49-b4d1-5a8977c89c7b" :step/next {:db/id #edb/ref 17592186515678}} {:db/id #edb/ref 17592186515678 :step/content {:db/id #edb/ref 17592186515521 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "336f253c-9736-520b-8fb7-d41987f37473" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{x}^{2}+4{c}^{2}" :db/id #edb/ref 17592186514987} {:answer/id #uuid "58e24837-7d55-5cdf-a839-e3afda08636c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{4{x}^{2}-16{c}^{2}}" :db/id #edb/ref 17592186515072} {:answer/id #uuid "7989544f-7ea6-5b3b-8e3c-3231d82c6955" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{4{x}^{2}+16{c}^{2}}" :db/id #edb/ref 17592186515125} {:answer/id #uuid "8b810d0d-88c0-5a8f-aeca-ac3055abcc67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2{x}^{2}+4{c}^{2}}" :db/id #edb/ref 17592186515165} {:answer/id #uuid "d4f229fc-d9e2-5832-9150-33c974b452ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2{x}^{2}-4{c}^{2}}" :db/id #edb/ref 17592186515317}] :answer-field/correct {:db/id #edb/ref 17592186515125} :answer-field/id #uuid "17b8dedc-9dc9-5851-973e-6ace85b1c419" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186515415}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "08d92dcc-49dd-5acf-9195-6229900ba610" :question/math-academy-id "q-79466" :question/problem "Find $|z|$ if $z=2x+4c\\text{i},$ where $x$ and $c$ are real numbers." :question/worked-solution "For a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nFor the complex number $z=2x+4c\\text{i},$ we have $a=2x$ and $b=4c.$ So, the magnitude is given by\n\n$$\n\\begin{aligned}\\begin{aligned}|2x+4c\\text{i}| & =\\sqrt{(2x)^{2}+(4c)^{2}} \\\\  & =\\sqrt{4{x}^{2}+16{c}^{2}}.\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "a5133add-db8f-51c9-ba6d-cd7cde437126" :step/next {:db/id #edb/ref 17592186515680}} {:db/id #edb/ref 17592186515680 :step/content {:db/id #edb/ref 17592186515596 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "008a9322-bc09-5270-b395-42f5ae02f992" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186514873} {:answer/id #uuid "2370feff-0720-50c4-8b43-d0d1aab5431b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186514956} {:answer/id #uuid "8ef6c697-69ee-5d21-b15c-a353586495fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186515175} {:answer/id #uuid "ab0f6764-317d-5061-9f80-de4f98c14068" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186515231} {:answer/id #uuid "eb76ce3d-4469-58f1-ae4b-06566734b7f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186515369}] :answer-field/correct {:db/id #edb/ref 17592186515231} :answer-field/id #uuid "35aa10d9-d0b5-5bf2-a319-9f587b8c0a83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186515429}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c3ed3524-1800-5472-a34a-a2b28ed462d4" :question/math-academy-id "q-160277" :question/problem "What is the magnitude of the number $z=2\\text{i}?$" :question/worked-solution "The imaginary number $2\\text{i}$ is equivalent to the complex number $z=0+2\\text{i}.$\n\nWe know that for a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nSo, the magnitude of $z=0+2\\text{i}$ is given by\n\n$$\n\\begin{aligned}|z| & =\\sqrt{{a}^{2}+{b}^{2}} \\\\  & =\\sqrt{(0)^{2}+(2)^{2}} \\\\  & =2.\\end{aligned}\n$$"} :step/id #uuid "a94f0ad1-2aea-563c-ab9b-921184c576f7"}] :activity/title "The Magnitude of a Complex Number" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186514868}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186544926} :activity/id #uuid "582cf0be-b649-5c80-ab83-11d8d6de800e" :activity/scope {:db/id #edb/ref 17592186049831 :topic/id #uuid "1726eb44-d776-5df6-8797-69b129ad3167" :topic/math-academy-id 34} :activity/steps [{:db/id #edb/ref 17592186544926 :step/content {:db/id #edb/ref 17592186055513 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15acad6a-1588-50dc-884b-0bc494d8457f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{{c}^{2}+{d}^{2}}" :db/id #edb/ref 17592186544132} {:answer/id #uuid "854035a8-ed0e-5bd3-9e72-e2d04380d94d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{{c}^{2}-{d}^{2}}" :db/id #edb/ref 17592186544375} {:answer/id #uuid "98affaef-6797-5eee-a74c-fa5d61288f53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{c-d}" :db/id #edb/ref 17592186544419} {:answer/id #uuid "b58e593b-db73-5134-8433-9704c2af763a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{c+d}" :db/id #edb/ref 17592186544470} {:answer/id #uuid "dd2ae299-d491-5962-8c63-b8d3103f30bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{{c}^{2}}\\sqrt{{d}^{2}}" :db/id #edb/ref 17592186544563}] :answer-field/correct {:db/id #edb/ref 17592186544132} :answer-field/id #uuid "3986505e-1ad4-514c-9a76-d29a84124f71" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186054315}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1234cf5e-bc44-54a6-aa08-551f55b5254e" :question/math-academy-id "q-904" :question/problem "Find $|z|$ if $z=-c-d\\text{i},$ where $c$ and $d$ are real numbers." :question/worked-solution "For a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nFor the complex number $z=-c-d\\text{i},$ we have $a=-c$ and $b=-d.$ So, the magnitude is given by\n\n$$\n\\begin{aligned}\\begin{aligned}|-c-d\\text{i}| & =\\sqrt{(-c)^{2}+(-d)^{2}} \\\\  & =\\sqrt{{c}^{2}+{d}^{2}}.\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "4e4d1882-3af3-542b-a0de-5d934be9d250" :step/next {:db/id #edb/ref 17592186544967}} {:db/id #edb/ref 17592186544967 :step/content {:db/id #edb/ref 17592186544810 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20fcdb42-91ca-575f-b2d7-0e66f5434d4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186544162} {:answer/id #uuid "57c8a3b4-8173-5938-b698-2abfcad48518" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186544281} {:answer/id #uuid "803a45f2-870d-54d9-83cb-ae54be25ca4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186544368} {:answer/id #uuid "901f0f8f-ae86-5446-bb09-058c84094a71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186544403} {:answer/id #uuid "baa275e2-b6b5-5efe-92e8-68e43ce68a9f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\sqrt{2}" :db/id #edb/ref 17592186544485}] :answer-field/correct {:db/id #edb/ref 17592186544281} :answer-field/id #uuid "700c44b0-518b-5383-9cc4-49a4e33ab23a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544705}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "407ccba6-df92-5ced-bae5-a0584a2e9a9b" :question/math-academy-id "q-70259" :question/problem "What is the magnitude of the number $z=3\\sqrt{2}\\,\\text{i}?$" :question/worked-solution "The imaginary number $3\\sqrt{2}\\,\\text{i}$ is equivalent to the complex number $z=0+3\\sqrt{2}\\,\\text{i}.$\n\nWe know that for a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nSo, the magnitude of $z=0+3\\sqrt{2}\\,\\text{i}$ is given by\n\n$$\n\\begin{aligned}|z| & =\\sqrt{{a}^{2}+{b}^{2}} \\\\  & =\\sqrt{(0)^{2}+(3\\sqrt{2})^{2}} \\\\  & =3\\sqrt{2}.\\end{aligned}\n$$"} :step/id #uuid "bf91d901-c429-5294-8b90-ff69ad18fb15" :step/next {:db/id #edb/ref 17592186544971}} {:db/id #edb/ref 17592186544971 :step/content {:db/id #edb/ref 17592186544890 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "297edda3-9036-5d3f-841d-95794066b68e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186544182} {:answer/id #uuid "6fdb107c-f069-5a3f-b408-4442f17dca80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\sqrt{3}" :db/id #edb/ref 17592186544336} {:answer/id #uuid "d488e77f-965b-5239-a2f4-9c5c6fd27700" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186544539} {:answer/id #uuid "f69636d0-b0c4-52be-8443-48117c693451" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186544625} {:answer/id #uuid "fa74a01a-75f7-5f19-9147-121c4a1a9617" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186544633}] :answer-field/correct {:db/id #edb/ref 17592186544182} :answer-field/id #uuid "82433c6e-f90d-5505-9496-d2c147d30d79" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544712}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e440f356-fb13-5144-832e-aba59bbee006" :question/math-academy-id "q-160280" :question/problem "What is the magnitude of the number $z=-9\\text{i}?$" :question/worked-solution "The imaginary number $-9\\text{i}$ is equivalent to the complex number $z=0-9\\text{i}.$\n\nWe know that for a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nSo, the magnitude of $z=0-9\\text{i}$ is given by\n\n$$\n\\begin{aligned}|z| & =\\sqrt{{a}^{2}+{b}^{2}} \\\\  & =\\sqrt{(0)^{2}+(-9)^{2}} \\\\  & =\\sqrt{81} \\\\  & =9.\\end{aligned}\n$$"} :step/id #uuid "c5102343-0d92-5737-bfce-0a300f842184"}] :activity/title "The Magnitude of a Complex Number" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186544077}]}
