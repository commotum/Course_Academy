#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186555936} :activity/id #uuid "f83222ca-111d-52ca-ac32-cdf2501208e6" :activity/scope {:db/id #edb/ref 17592186049831 :topic/id #uuid "1726eb44-d776-5df6-8797-69b129ad3167" :topic/math-academy-id 34} :activity/steps [{:db/id #edb/ref 17592186555906 :step/content {:db/id #edb/ref 17592186555830 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73992287-adf4-5d20-bc99-b1db86b5dacc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7\\sqrt{7}" :db/id #edb/ref 17592186555260} {:answer/id #uuid "7f00bf42-08f2-5516-afe2-e1a78689766e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186555292} {:answer/id #uuid "ab296d37-af25-552d-b19d-d93fbfe91b3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186555411} {:answer/id #uuid "c7531847-0d45-560c-8932-2293b0d779c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186555479} {:answer/id #uuid "fd4f0b9c-20c0-5f4b-b54b-8d7b7392c9a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{7}" :db/id #edb/ref 17592186555631}] :answer-field/correct {:db/id #edb/ref 17592186555411} :answer-field/id #uuid "ca1efa44-0d37-5e8b-93b6-53f162d055b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555737}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "855d3f5e-247d-532b-b8b2-b14ad8b71bc3" :question/math-academy-id "q-160278" :question/problem "What is the magnitude of the number $z=\\sqrt{7}\\,\\text{i}?$" :question/worked-solution "The imaginary number $\\sqrt{7}\\,\\text{i}$ is equivalent to the complex number $z=0+\\sqrt{7}\\,\\text{i}.$\n\nWe know that for a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nSo, the magnitude of $z=0+\\sqrt{7}\\,\\text{i}$ is given by\n\n$$\n\\begin{aligned}|z| & =\\sqrt{{a}^{2}+{b}^{2}} \\\\  & =\\sqrt{(0)^{2}+(\\sqrt{7})^{2}} \\\\  & =\\sqrt{0+7} \\\\  & =\\sqrt{7}.\\end{aligned}\n$$"} :step/id #uuid "54b8c62c-9e30-5ba1-a31d-ce297b16c0c6" :step/next {:db/id #edb/ref 17592186555951}} {:db/id #edb/ref 17592186555936 :step/content {:db/id #edb/ref 17592186555863 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d46a9e2-7e89-5bdc-802a-37b7219e826b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2{c}^{2}-15{d}^{2}}" :db/id #edb/ref 17592186555131} {:answer/id #uuid "444fc648-9e08-5355-afa7-719ab52a2a9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5{c}^{2}-25{d}^{2}}" :db/id #edb/ref 17592186555146} {:answer/id #uuid "6ca319f1-0cbf-5b45-8e0e-96b1d6eac97f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{4{c}^{2}+25{d}^{2}}" :db/id #edb/ref 17592186555248} {:answer/id #uuid "8f412f49-11e0-5cb4-a1a4-380193cd889c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{{c}^{2}-{d}^{2}}" :db/id #edb/ref 17592186555336} {:answer/id #uuid "d34111e3-843d-501c-b945-9583c3a25a72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{8{c}^{2}+10{d}^{2}}" :db/id #edb/ref 17592186555500}] :answer-field/correct {:db/id #edb/ref 17592186555248} :answer-field/id #uuid "cc6afa9a-e364-5ab4-bcd5-a1f3970571e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555738}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "df8c7ab8-3861-5c49-964d-3d49c4f6daab" :question/math-academy-id "q-16851" :question/problem "Find $|z|$ if $z=2c-5d\\text{i},$ where $c$ and $d$ are real numbers." :question/worked-solution "For a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nFor the complex number $z=2c-5d\\text{i},$ we have $a=2c$ and $b=-5d.$ So, the magnitude is given by\n\n$$\n\\begin{aligned}\\begin{aligned}|2c-5d\\text{i}| & =\\sqrt{(2c)^{2}+(-5d)^{2}} \\\\  & =\\sqrt{4{c}^{2}+25{d}^{2}}.\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "cc00d91b-1329-56e0-ad28-628ed46c9309" :step/next {:db/id #edb/ref 17592186555906}} {:db/id #edb/ref 17592186555951 :step/content {:db/id #edb/ref 17592186555849 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35dda891-930d-5283-82ec-3c522747ecc6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{k+4m}" :db/id #edb/ref 17592186555114} {:answer/id #uuid "3f013632-20cc-5e44-a90c-d7a4e95be4cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{k+2m}" :db/id #edb/ref 17592186555136} {:answer/id #uuid "6dd996c1-44f7-5e17-bab6-39b9a9f028d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{{k}^{2}+4{m}^{2}}" :db/id #edb/ref 17592186555250} {:answer/id #uuid "787da0a7-0cb6-5f2f-9aa4-3e823fbbc1d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{{k}^{2}+2{m}^{2}}" :db/id #edb/ref 17592186555278} {:answer/id #uuid "d529f2ea-4dcf-50f9-9391-157032c832e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{-k-2m}" :db/id #edb/ref 17592186555506}] :answer-field/correct {:db/id #edb/ref 17592186555250} :answer-field/id #uuid "d995544c-fa38-5062-a61b-6bdf50c77156" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555746}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b2ac4656-c00e-5c47-8021-7036e619bd8c" :question/math-academy-id "q-160292" :question/problem "Find $|z|$ if $z=-k-2m\\text{i},$ where $k$ and $m$ are real numbers." :question/worked-solution "For a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nFor the complex number $z=-k-2m\\text{i},$ we have $a=-k$ and $b=-2m.$ So, the magnitude is given by\n\n$$\n\\begin{aligned}\\begin{aligned}|-k-2m\\text{i}| & =\\sqrt{(-k)^{2}+(-2m)^{2}} \\\\  & =\\sqrt{{k}^{2}+4{m}^{2}}.\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "e31b65a3-7c3f-5528-960e-2ed9bc704565"}] :activity/title "The Magnitude of a Complex Number" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186555003}]}
