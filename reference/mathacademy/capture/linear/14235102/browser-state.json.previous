olumnspacing=\"\" rowspacing=\"3pt\"><mtr><mtd><mtable rowspacing=\"1em 0.5em\" columnspacing=\"0.278em\" displaystyle=\"true\" columnalign=\"right left\"><mtr><mtd><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">|</mo><mn>2</mn><mi>c</mi><mo>−</mo><mn>5</mn><mi>d</mi><mtext>i</mtext><mo data-mjx-texclass=\"CLOSE\">|</mo></mrow></mtd><mtd><mo>=</mo><msqrt><mo stretchy=\"false\">(</mo><mn>2</mn><mi>c</mi><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>+</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>5</mn><mi>d</mi><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><msqrt><mn>4</mn><msup><mi>c</mi><mn>2</mn></msup><mo>+</mo><mn>25</mn><msup><mi>d</mi><mn>2</mn></msup></msqrt><mo>.</mo></mtd></mtr></mtable></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
