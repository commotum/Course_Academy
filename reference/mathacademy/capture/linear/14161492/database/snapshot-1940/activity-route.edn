#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186486523} :activity/id #uuid "332f39d2-fe5b-5fe5-bfa7-8da0dfbe5393" :activity/scope {:db/id #edb/ref 17592186048502 :topic/id #uuid "a4f450cf-8fc5-50db-946a-e2e69ec67915" :topic/math-academy-id 2560} :activity/steps [{:db/id #edb/ref 17592186486464 :step/content {:db/id #edb/ref 17592186152558 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a39d413-aa71-523a-b6b3-dae4d712baf0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3600" :db/id #edb/ref 17592186485945}] :answer-field/correct {:db/id #edb/ref 17592186485945} :answer-field/id #uuid "290d7c72-0a37-54c1-928d-b289c4e12639" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186149800}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cf1e4b17-b634-5d17-aa2d-098e82d8022f" :question/math-academy-id "q-327654" :question/problem "A factory produced $900$ boxes of cereal last year. This year, production is $300%$ greater than last year. How many boxes of cereal did the factory produce this year?\n\nThe factory produced\n{{field-1}}\nboxes of cereal this year." :question/worked-solution "To find this year's cereal production, we apply a $300%$ increase to last year's figure.\n\nIncreasing by $300%$ means that we must apply a new percentage of\n\n$$\n100%+300%=400%.\n$$\n\nWe begin by converting the percentage to a decimal:\n\n$$\n400%=\\frac{400}{100}=4\n$$\n\nNow, we multiply the original amount by $4:$\n\n$$\n900\\times 4=3,600\n$$\n\nSo, the factory produced $3600$ boxes of cereal this year."} :step/id #uuid "00e71b2a-765d-5d7f-a25b-d91d73442118"} {:db/id #edb/ref 17592186486503 :step/content {:db/id #edb/ref 17592186486423 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63a00a9b-f175-5563-a7e5-e9656e27a637" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "108" :db/id #edb/ref 17592186485935} {:answer/id #uuid "758ee6d2-143b-5d0c-85c7-1b00d67826f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "120" :db/id #edb/ref 17592186485969} {:answer/id #uuid "974abbd8-6ac1-5b5c-809b-ef8a1790dbd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "102" :db/id #edb/ref 17592186486038} {:answer/id #uuid "aca33ef9-b028-5c98-a62b-f95962819c99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "80" :db/id #edb/ref 17592186486076} {:answer/id #uuid "be2c74de-5ea2-597a-8fc7-7510c00cdf16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "95" :db/id #edb/ref 17592186486103}] :answer-field/correct {:db/id #edb/ref 17592186486038} :answer-field/id #uuid "3b3f1f35-966b-596c-862d-3ab162b9470c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486261}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "aa7ba5f1-091b-5461-b064-b9a572c0acc9" :question/math-academy-id "q-318357" :question/problem "What number is $155%$ greater than $40?$" :question/worked-solution "To find a number $155%$ *greater than* $40,$ we apply a new percentage of\n\n$$\n100%+155%=255%.\n$$\n\nWe begin by converting the percentage to a decimal:\n\n$$\n255%=\\frac{255}{100}=2.55\n$$\n\nSo, to find a number that is $155%$ greater than $40,$ we multiply $40$ by $2.55:$\n\n$$\n2.55\\cdot 40=102\n$$\n\nTherefore, the number that is $155%$ greater than $40$ is $102.$"} :step/id #uuid "aa852896-f641-5bf3-81c3-1ddb33a1c5d8" :step/next {:db/id #edb/ref 17592186486505}} {:db/id #edb/ref 17592186486504 :step/content {:db/id #edb/ref 17592186486445 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00e18203-4dbf-5257-84e1-5d825b64f9da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5,\\,000,\\,000" :db/id #edb/ref 17592186485764} {:answer/id #uuid "01c47803-fa37-5ad4-a822-f030d4115e5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5,\\,050,\\,000" :db/id #edb/ref 17592186485767} {:answer/id #uuid "22fa57f8-4bd0-583b-b691-d351b66f3152" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5,\\,075,\\,000" :db/id #edb/ref 17592186485824} {:answer/id #uuid "26239f53-9cc0-56a7-acb2-66f332c11f19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5,\\,100,\\,000" :db/id #edb/ref 17592186485828} {:answer/id #uuid "623d64e1-d70f-5584-bac1-b87f99bf2302" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5,\\,025,\\,000" :db/id #edb/ref 17592186485934}] :answer-field/correct {:db/id #edb/ref 17592186485824} :answer-field/id #uuid "fa4f452c-1a22-5679-9e96-6dcc369d76d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486346}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ceab7d75-8909-5909-a769-ff36bb9c7667" :question/math-academy-id "q-326524" :question/problem "A country welcomed $3,\\,500,\\,000$ tourists in $2018.$  Travel authorities predict that this number will increase by $45%$ by the year $2028.$ Which of the following is closest to the projected number of tourists in $2028?$" :question/worked-solution "To find the projected number of tourists in $2028,$ we apply a $45%$ increase to the $2018$ figure.\n\nIncreasing by $45%$ means that we must apply a new percentage of\n\n$$\n100%+45%=145%.\n$$\n\nWe begin by converting the percentage to a decimal:\n\n$$\n145%=\\frac{145}{100}=1.45\n$$\n\nFinally, we compute the new value by multiplying the original amount by $1.45:$\n\n$$\n3,\\,500,\\,000\\times 1.45=5,\\,075,\\,000\n$$\n\nTherefore, the projected number of tourists in $2028$ is $5,\\,075,\\,000.$"} :step/id #uuid "ad0e7bc5-f3f5-5418-b7be-7515dd52c1f2" :step/next {:db/id #edb/ref 17592186486464}} {:db/id #edb/ref 17592186486505 :step/content {:db/id #edb/ref 17592186486395 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d2bf66f-071b-599c-870d-beb08d151c52" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$14.00$" :db/id #edb/ref 17592186485789} {:answer/id #uuid "81d65c1e-4fea-5d3d-b067-2a903bca796a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$12.75$" :db/id #edb/ref 17592186485993} {:answer/id #uuid "9a524f5e-5406-5bdc-81e7-caf6bc6d50a9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$12.95$" :db/id #edb/ref 17592186486041} {:answer/id #uuid "f89dfbd4-8787-51f2-b071-d16433f03c99" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$13.50$" :db/id #edb/ref 17592186486213} {:answer/id #uuid "fccdd420-a0f2-5e8c-abe0-1561c37428e6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$13.14$" :db/id #edb/ref 17592186486226}] :answer-field/correct {:db/id #edb/ref 17592186486226} :answer-field/id #uuid "901b558e-ee47-587e-b837-3417a076e126" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486296}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6f6e2bde-069f-5dbd-8445-437abb3c38f2" :question/math-academy-id "q-326517" :question/problem "A sandwich costs $$12$ before tax. If a $9.5%$ sales tax is applied, what is the total price after tax?" :question/worked-solution "To find the total price after tax, we apply a $9.5%$ increase to the original cost.\n\nIncreasing by $9.5%$ means that we must apply a new percentage of\n\n$$\n100%+9.5%=109.5%=1.095\n$$\n\nNow, we multiply the original price by $1.095:$\n\n$$\n12\\times 1.095=13.14.\n$$\n\nSo, the total price after tax is $$13.14.$"} :step/id #uuid "af48d2fc-c0ee-5116-9e15-35ee93f0388c" :step/next {:db/id #edb/ref 17592186486504}} {:db/id #edb/ref 17592186486523 :step/content {:db/id #edb/ref 17592186486392 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a7cc659-73e4-532b-99a7-3c634766ec34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "144" :db/id #edb/ref 17592186485946} {:answer/id #uuid "7b9ddf9b-1b91-530e-8514-164da8ccae4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "160" :db/id #edb/ref 17592186485981} {:answer/id #uuid "b58bfefd-ae8c-59b0-b73a-de23da9e8c2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "128" :db/id #edb/ref 17592186486088} {:answer/id #uuid "c94777e7-dc40-5649-ab0e-9b864344dabb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "136" :db/id #edb/ref 17592186486127} {:answer/id #uuid "dc4ed7cc-6a7f-517f-944e-d4397979f27d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "180" :db/id #edb/ref 17592186486166}] :answer-field/correct {:db/id #edb/ref 17592186485946} :answer-field/id #uuid "a94424b9-97e6-5016-9825-443b370a2c58" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486306}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "62ed2686-5fd2-570f-9e2c-651f1d63d801" :question/math-academy-id "q-318127" :question/problem "What number is $125%$ greater than $64?$" :question/worked-solution "To find a number $125%$ *greater than* $64,$ we apply a new percentage of\n\n$$\n100%+125%=225%.\n$$\n\nWe begin by converting the percentage to a decimal:\n\n$$\n225%=\\frac{225}{100}=2.25\n$$\n\nSo, to find a number that is $125%$ greater than $64,$ we multiply $64$ by $2.25:$\n\n$$\n2.25\\cdot 64=144\n$$\n\nTherefore, the number that is $125%$ greater than $64$ is $144.$"} :step/id #uuid "ff1f3d10-46ad-5cfc-b250-e2375bf213df" :step/next {:db/id #edb/ref 17592186486503}}] :activity/title "Applying Percentage Increases" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186485754}]}
