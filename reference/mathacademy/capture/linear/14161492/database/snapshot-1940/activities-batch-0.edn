#{[{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186153298} :activity/id #uuid "b42cbc99-dc3a-5ea5-af15-2e43d6dacdce" :activity/scope {:db/id #edb/ref 17592186048502 :topic/id #uuid "a4f450cf-8fc5-50db-946a-e2e69ec67915" :topic/math-academy-id 2560} :activity/steps [{:db/id #edb/ref 17592186153298 :step/content {:db/id #edb/ref 17592186153325 :tutorial/content "Sometimes we need to find a number that is a certain percentage *greater than* a given amount. This corresponds to applying a so-called **percentage increase.**\n\nTo apply a percentage increase, we add the increase to $100\\%,$ convert the result to a decimal multiplier, and then find the product of the multiplier and the original number.\n\nTo demonstrate, let's consider the following problem.\n\nWhat number is $25\\%$ *greater than* $160?$\n\nThe key words here are \"$\\boldsymbol{25\\%}$ **greater than.**\" This means we need to apply a percentage increase, increasing the original number by $25\\%.$\n\nTo find a number $25\\%$ greater than $160,$ we apply a new percentage of\n\n$$\n100\\% + 25\\% = 125\\%.\n$$\n\nThis means that our new number is $125\\%$ of $160.$ \n\nSo, first, we convert this percentage to a decimal:\n\n$$\n125\\% = \\dfrac{125}{100} = 1.25\n$$\n\nTo find a number that is $25\\%$ greater than $160,$ we multiply $160$ by $1.25{:}$\n\n$$\n1.25 \\cdot 160 = 200\n$$\n\nTherefore, the number that is $25\\%$ *greater than* $160$ is $200.$\n\nThis method applies to *any* percentage increase, including those greater than $100\\%{;}$ add the increase to $100\\%$ before converting to a decimal multiplier." :tutorial/id #uuid "83dbd64f-3ab9-5239-b54b-ae6d91816248" :tutorial/math-academy-id 14336 :tutorial/title "Introduction"} :step/id #uuid "547ba33b-b6b3-5bae-b2dc-eacefe1e81a4" :step/math-academy-id 615692 :step/next {:db/id #edb/ref 17592186153299}} {:db/id #edb/ref 17592186153299 :step/content {:db/id #edb/ref 17592186152295 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151899 :question/id #uuid "2cfd1ed7-8249-5970-9ddc-1bb69929951c" :question/math-academy-id "e-21450"} :knowledge-point/id #uuid "125ed0b3-14ad-5af8-8370-ca6f83d93c35" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050716}] :knowledge-point/questions [{:db/id #edb/ref 17592186152552} {:db/id #edb/ref 17592186152553} {:db/id #edb/ref 17592186455458} {:db/id #edb/ref 17592186455469}] :knowledge-point/title "Applying a Percentage Increase"} :step/id #uuid "a946c7fa-5aee-54d2-b223-0a3b560b3401" :step/math-academy-id 615693 :step/next {:db/id #edb/ref 17592186153300}} {:db/id #edb/ref 17592186153300 :step/content {:db/id #edb/ref 17592186152296 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151900 :question/id #uuid "95c3dedd-accd-57dc-91ee-4ee8fdb2f3a4" :question/math-academy-id "e-21451"} :knowledge-point/id #uuid "f90ea994-79f2-5409-bf96-306803b4ef01" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049467}] :knowledge-point/questions [{:db/id #edb/ref 17592186152554} {:db/id #edb/ref 17592186152555} {:db/id #edb/ref 17592186455451} {:db/id #edb/ref 17592186455478} {:db/id #edb/ref 17592186455495} {:db/id #edb/ref 17592186455498} {:db/id #edb/ref 17592186486395} {:db/id #edb/ref 17592186486445}] :knowledge-point/title "Applying a Percentage Increase: Word Problems"} :step/id #uuid "fd57418f-a99a-5c17-9192-9191eca0084b" :step/math-academy-id 615696 :step/next {:db/id #edb/ref 17592186153301}} {:db/id #edb/ref 17592186153301 :step/content {:db/id #edb/ref 17592186153340 :tutorial/content "It's possible to increase a number by $100\\%$ or more. \n\nFor example, what number is $150\\%$ greater than $90?$\n\nTo find a number $150\\%$ *greater than* $90,$ we apply a new percentage of\n\n$$\n100\\% + 150\\% = 250\\%.\n$$\n\nWe begin by converting the percentage to a decimal:\n\n$$\n250\\% = \\dfrac{250}{100} = 2.5\n$$\n\nSo, to find a number that is $150\\%$ greater than $90,$ we multiply $90$ by $2.5:$\n\n$$\n2.5 \\cdot 90 = 225\n$$\n\nTherefore, the number that is $150\\%$ greater than $90$ is $225.$" :tutorial/id #uuid "a0514684-2b6b-52ce-9ccb-6d28ed8d4850" :tutorial/math-academy-id 15090 :tutorial/title "Percentage Increases Greater Than 100%"} :step/id #uuid "a3bd6e9e-9d93-51a6-9a20-5e9292cf93f4" :step/math-academy-id 615700 :step/next {:db/id #edb/ref 17592186153302}} {:db/id #edb/ref 17592186153302 :step/content {:db/id #edb/ref 17592186152297 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151901 :question/id #uuid "4af9bc31-4980-5c3c-9025-45e85ac09d8a" :question/math-academy-id "e-21517"} :knowledge-point/id #uuid "88d0f4ad-a3f9-5275-b5d5-a9973bf63ebf" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050618}] :knowledge-point/questions [{:db/id #edb/ref 17592186152551} {:db/id #edb/ref 17592186152556} {:db/id #edb/ref 17592186455476} {:db/id #edb/ref 17592186455482} {:db/id #edb/ref 17592186486392} {:db/id #edb/ref 17592186486423}] :knowledge-point/title "Applying Percentage Increases Greater Than 100%"} :step/id #uuid "d9b4f520-6201-594a-907d-e7a899c8d57c" :step/math-academy-id 615701 :step/next {:db/id #edb/ref 17592186153303}} {:db/id #edb/ref 17592186153303 :step/content {:db/id #edb/ref 17592186152298 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151913 :question/id #uuid "92d9c3ca-6e59-5c73-b640-114dfb7d13cd" :question/math-academy-id "e-22093"} :knowledge-point/id #uuid "bbb0103d-d686-575a-8ef8-81640227f4dc" :knowledge-point/questions [{:db/id #edb/ref 17592186152557} {:db/id #edb/ref 17592186152558} {:db/id #edb/ref 17592186455431} {:db/id #edb/ref 17592186455511}] :knowledge-point/title "Solving Word Problems Involving Percentage Increases Greater Than 100%"} :step/id #uuid "10eca415-b601-5bc8-80c2-c2db5a9c451e" :step/math-academy-id 615704}] :activity/title "Applying Percentage Increases" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186152315}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186486523} :activity/id #uuid "332f39d2-fe5b-5fe5-bfa7-8da0dfbe5393" :activity/scope {:db/id #edb/ref 17592186048502 :topic/id #uuid "a4f450cf-8fc5-50db-946a-e2e69ec67915" :topic/math-academy-id 2560} :activity/steps [{:db/id #edb/ref 17592186486464 :step/content {:db/id #edb/ref 17592186152558 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a39d413-aa71-523a-b6b3-dae4d712baf0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3600" :db/id #edb/ref 17592186485945}] :answer-field/correct {:db/id #edb/ref 17592186485945} :answer-field/id #uuid "290d7c72-0a37-54c1-928d-b289c4e12639" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186149800}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cf1e4b17-b634-5d17-aa2d-098e82d8022f" :question/math-academy-id "q-327654" :question/problem "A factory produced $900$ boxes of cereal last year. This year, production is $300%$ greater than last year. How many boxes of cereal did the factory produce this year?\n\nThe factory produced\n{{field-1}}\nboxes of cereal this year." :question/worked-solution "To find this year's cereal production, we apply a $300%$ increase to last year's figure.\n\nIncreasing by $300%$ means that we must apply a new percentage of\n\n$$\n100%+300%=400%.\n$$\n\nWe begin by converting the percentage to a decimal:\n\n$$\n400%=\\frac{400}{100}=4\n$$\n\nNow, we multiply the original amount by $4:$\n\n$$\n900\\times 4=3,600\n$$\n\nSo, the factory produced $3600$ boxes of cereal this year."} :step/id #uuid "00e71b2a-765d-5d7f-a25b-d91d73442118"} {:db/id #edb/ref 17592186486503 :step/content {:db/id #edb/ref 17592186486423 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63a00a9b-f175-5563-a7e5-e9656e27a637" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "108" :db/id #edb/ref 17592186485935} {:answer/id #uuid "758ee6d2-143b-5d0c-85c7-1b00d67826f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "120" :db/id #edb/ref 17592186485969} {:answer/id #uuid "974abbd8-6ac1-5b5c-809b-ef8a1790dbd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "102" :db/id #edb/ref 17592186486038} {:answer/id #uuid "aca33ef9-b028-5c98-a62b-f95962819c99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "80" :db/id #edb/ref 17592186486076} {:answer/id #uuid "be2c74de-5ea2-597a-8fc7-7510c00cdf16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "95" :db/id #edb/ref 17592186486103}] :answer-field/correct {:db/id #edb/ref 17592186486038} :answer-field/id #uuid "3b3f1f35-966b-596c-862d-3ab162b9470c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486261}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "aa7ba5f1-091b-5461-b064-b9a572c0acc9" :question/math-academy-id "q-318357" :question/problem "What number is $155%$ greater than $40?$" :question/worked-solution "To find a number $155%$ *greater than* $40,$ we apply a new percentage of\n\n$$\n100%+155%=255%.\n$$\n\nWe begin by converting the percentage to a decimal:\n\n$$\n255%=\\frac{255}{100}=2.55\n$$\n\nSo, to find a number that is $155%$ greater than $40,$ we multiply $40$ by $2.55:$\n\n$$\n2.55\\cdot 40=102\n$$\n\nTherefore, the number that is $155%$ greater than $40$ is $102.$"} :step/id #uuid "aa852896-f641-5bf3-81c3-1ddb33a1c5d8" :step/next {:db/id #edb/ref 17592186486505}} {:db/id #edb/ref 17592186486504 :step/content {:db/id #edb/ref 17592186486445 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00e18203-4dbf-5257-84e1-5d825b64f9da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5,\\,000,\\,000" :db/id #edb/ref 17592186485764} {:answer/id #uuid "01c47803-fa37-5ad4-a822-f030d4115e5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5,\\,050,\\,000" :db/id #edb/ref 17592186485767} {:answer/id #uuid "22fa57f8-4bd0-583b-b691-d351b66f3152" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5,\\,075,\\,000" :db/id #edb/ref 17592186485824} {:answer/id #uuid "26239f53-9cc0-56a7-acb2-66f332c11f19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5,\\,100,\\,000" :db/id #edb/ref 17592186485828} {:answer/id #uuid "623d64e1-d70f-5584-bac1-b87f99bf2302" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5,\\,025,\\,000" :db/id #edb/ref 17592186485934}] :answer-field/correct {:db/id #edb/ref 17592186485824} :answer-field/id #uuid "fa4f452c-1a22-5679-9e96-6dcc369d76d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486346}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ceab7d75-8909-5909-a769-ff36bb9c7667" :question/math-academy-id "q-326524" :question/problem "A country welcomed $3,\\,500,\\,000$ tourists in $2018.$  Travel authorities predict that this number will increase by $45%$ by the year $2028.$ Which of the following is closest to the projected number of tourists in $2028?$" :question/worked-solution "To find the projected number of tourists in $2028,$ we apply a $45%$ increase to the $2018$ figure.\n\nIncreasing by $45%$ means that we must apply a new percentage of\n\n$$\n100%+45%=145%.\n$$\n\nWe begin by converting the percentage to a decimal:\n\n$$\n145%=\\frac{145}{100}=1.45\n$$\n\nFinally, we compute the new value by multiplying the original amount by $1.45:$\n\n$$\n3,\\,500,\\,000\\times 1.45=5,\\,075,\\,000\n$$\n\nTherefore, the projected number of tourists in $2028$ is $5,\\,075,\\,000.$"} :step/id #uuid "ad0e7bc5-f3f5-5418-b7be-7515dd52c1f2" :step/next {:db/id #edb/ref 17592186486464}} {:db/id #edb/ref 17592186486505 :step/content {:db/id #edb/ref 17592186486395 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d2bf66f-071b-599c-870d-beb08d151c52" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$14.00$" :db/id #edb/ref 17592186485789} {:answer/id #uuid "81d65c1e-4fea-5d3d-b067-2a903bca796a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$12.75$" :db/id #edb/ref 17592186485993} {:answer/id #uuid "9a524f5e-5406-5bdc-81e7-caf6bc6d50a9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$12.95$" :db/id #edb/ref 17592186486041} {:answer/id #uuid "f89dfbd4-8787-51f2-b071-d16433f03c99" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$13.50$" :db/id #edb/ref 17592186486213} {:answer/id #uuid "fccdd420-a0f2-5e8c-abe0-1561c37428e6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$13.14$" :db/id #edb/ref 17592186486226}] :answer-field/correct {:db/id #edb/ref 17592186486226} :answer-field/id #uuid "901b558e-ee47-587e-b837-3417a076e126" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486296}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6f6e2bde-069f-5dbd-8445-437abb3c38f2" :question/math-academy-id "q-326517" :question/problem "A sandwich costs $$12$ before tax. If a $9.5%$ sales tax is applied, what is the total price after tax?" :question/worked-solution "To find the total price after tax, we apply a $9.5%$ increase to the original cost.\n\nIncreasing by $9.5%$ means that we must apply a new percentage of\n\n$$\n100%+9.5%=109.5%=1.095\n$$\n\nNow, we multiply the original price by $1.095:$\n\n$$\n12\\times 1.095=13.14.\n$$\n\nSo, the total price after tax is $$13.14.$"} :step/id #uuid "af48d2fc-c0ee-5116-9e15-35ee93f0388c" :step/next {:db/id #edb/ref 17592186486504}} {:db/id #edb/ref 17592186486523 :step/content {:db/id #edb/ref 17592186486392 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a7cc659-73e4-532b-99a7-3c634766ec34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "144" :db/id #edb/ref 17592186485946} {:answer/id #uuid "7b9ddf9b-1b91-530e-8514-164da8ccae4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "160" :db/id #edb/ref 17592186485981} {:answer/id #uuid "b58bfefd-ae8c-59b0-b73a-de23da9e8c2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "128" :db/id #edb/ref 17592186486088} {:answer/id #uuid "c94777e7-dc40-5649-ab0e-9b864344dabb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "136" :db/id #edb/ref 17592186486127} {:answer/id #uuid "dc4ed7cc-6a7f-517f-944e-d4397979f27d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "180" :db/id #edb/ref 17592186486166}] :answer-field/correct {:db/id #edb/ref 17592186485946} :answer-field/id #uuid "a94424b9-97e6-5016-9825-443b370a2c58" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486306}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "62ed2686-5fd2-570f-9e2c-651f1d63d801" :question/math-academy-id "q-318127" :question/problem "What number is $125%$ greater than $64?$" :question/worked-solution "To find a number $125%$ *greater than* $64,$ we apply a new percentage of\n\n$$\n100%+125%=225%.\n$$\n\nWe begin by converting the percentage to a decimal:\n\n$$\n225%=\\frac{225}{100}=2.25\n$$\n\nSo, to find a number that is $125%$ greater than $64,$ we multiply $64$ by $2.25:$\n\n$$\n2.25\\cdot 64=144\n$$\n\nTherefore, the number that is $125%$ greater than $64$ is $144.$"} :step/id #uuid "ff1f3d10-46ad-5cfc-b250-e2375bf213df" :step/next {:db/id #edb/ref 17592186486503}}] :activity/title "Applying Percentage Increases" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186485754}]}
