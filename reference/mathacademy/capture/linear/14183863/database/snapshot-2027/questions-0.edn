/choices [{:answer/id #uuid "6da3c059-e7a2-561d-b24f-ae1a025126bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-|s|+3" :db/id #edb/ref 17592186498066} {:answer/id #uuid "aa13e59a-2a4d-535a-9aff-88818af6a236" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4|s|+3" :db/id #edb/ref 17592186498176} {:answer/id #uuid "ae900989-fa31-5ec7-a8af-afd82d4149e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4s-3" :db/id #edb/ref 17592186498187} {:answer/id #uuid "ccc825dd-39a6-5b11-a839-62ca6e000973" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4|s|+3" :db/id #edb/ref 17592186498260} {:answer/id #uuid "db6d064b-135a-5826-aa11-e1ee2c639e09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4s+3" :db/id #edb/ref 17592186498290}] :answer-field/correct {:answer/id #uuid "aa13e59a-2a4d-535a-9aff-88818af6a236" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4|s|+3" :db/id #edb/ref 17592186498176} :answer-field/id #uuid "f5c1e571-065f-56e1-b547-c5d8576a10bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186498481}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "176b69af-2301-5857-a64b-7b0669d9dca3" :question/math-academy-id "q-52130" :question/problem "Simplify the expression $2\\cdot |-2s|+3.$" :question/worked-solution "Firstly, since $|-a|=|a|,$ we can write our expression as\n\n$$\n2\\cdot |2s|+3.\n$$\n\nThen, we distribute the absolute value over the multiplication, and simplify:\n\n$$\n\\begin{aligned}2\\cdot |2s|+3 & = \\\\ 2\\cdot |2|\\cdot |s|+3 & = \\\\ 2\\cdot 2\\cdot |s|+3 & = \\\\ 4|s|+3 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186498552 :knowledge-point/_questions [{:db/id #edb/ref 17592186172111 :knowledge-point/id #uuid "2b534245-8276-5e9b-8b9f-0d749116477a" :knowledge-point/title "Simplifying the Absolute Value of a Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fc0bc59-3785-5eda-b8fc-f947d9ab58ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-2(k)^{2}}{3}" :db/id #edb/ref 17592186497835} {:answer/id #uuid "22d42365-3034-57f9-b80d-03413fa89807" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6{k}^{2}" :db/id #edb/ref 17592186497872} {:answer/id #uuid "4cfef805-d8bd-5a29-b7b3-ef894a92d11c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2{k}^{2}}{3}" :db/id #edb/ref 17592186497976} {:answer/id #uuid "8824de24-d3dc-5d98-b0ca-f43ee7699f9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{k}^{2}}{3}" :db/id #edb/ref 17592186498113} {:answer/id #uuid "bf56fbd2-f5c2-579c-8ebb-6d499c95b621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{k}^{2}" :db/id #edb/ref 17592186498224}] :answer-field/correct {:answer/id #uuid "8824de24-d3dc-5d98-b0ca-f43ee7699f9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{k}^{2}}{3}" :db/id #edb/ref 17592186498113} :answer-field/id #uuid "cbfbd916-b1d3-545a-8514-bc1cb5dfc2a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186498459}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7d1d6d3a-1caf-53a1-9cd7-47e7cd04105c" :question/math-academy-id "q-78941" :question/problem "$|-\\frac{2{k}^{2}}{3}|=$" :question/worked-solution "Firstly, since $|-a|=|a|,$ we can write our expression as\n\n$$\n|\\frac{2{k}^{2}}{3}|.\n$$\n\nThen, we distribute the absolute value over the multiplication and division:\n\n$$\n\\begin{aligned}|\\frac{2{k}^{2}}{3}| & = \\\\ \\frac{|2{k}^{2}|}{|3|} & = \\\\ \\frac{|2|\\cdot |{k}^{2}|}{3} & = \\\\ \\frac{2|{k}^{2}|}{3}\\end{aligned}\n$$\n\nSince ${k}^{2}\\ge 0$ for any real $k,$ we have that $|{k}^{2}|={k}^{2}.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{2|{k}^{2}|}{3} & =\\frac{2{k}^{2}}{3}.\\end{aligned}\n$$"}]}
