#{[{:db/id #edb/ref 17592186171714 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186172111 :knowledge-point/id #uuid "2b534245-8276-5e9b-8b9f-0d749116477a" :knowledge-point/title "Simplifying the Absolute Value of a Square"}] :question/id #uuid "8b27c37f-10a7-5e55-8230-916bb246142b" :question/math-academy-id "e-1238" :question/problem "Simplify the expression $\\left| - \\dfrac{x^2}{10} \\right|.$" :question/worked-solution "Firstly, since $|{-a}| = |a|,$ we can write our expression as\n\n$$\n\\left| \\dfrac{x^2}{10} \\right|.\n$$\n\nThen, we distribute the absolute value over the multiplication and division:\n\n$$\n\\begin{aligned}|\\frac{{x}^{2}}{10}| & = \\\\ \\frac{|{x}^{2}|}{|10|} & = \\\\ \\frac{|{x}^{2}|}{10}\\end{aligned}\n$$\n\nSince $x^2 \\geq 0$ for any real $x,$ we have that $\\left|x^2\\right|=x^2.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{|{x}^{2}|}{10} & =\\frac{{x}^{2}}{10}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186171715 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186172112 :knowledge-point/id #uuid "60502703-f918-51c6-98dc-62fdd6e3241e" :knowledge-point/title "Evaluating an Absolute Value Expression with a Domain Restriction"}] :question/id #uuid "e0d4030c-4490-5e36-af26-7ded6003e841" :question/math-academy-id "e-1239" :question/problem "Given that $x\\lt 0,$ simplify $|{-6x}|+2x.$" :question/worked-solution "Firstly, since $|{-a}| = |a|,$ we can write our expression as\n\n$$\n|6x|+2x.\n$$\n\nThen, we distribute the absolute value over the multiplication. This gives\n\n$$\n\\begin{aligned}|6x|+2x & = \\\\ |6|\\cdot |x|+2x & = \\\\ 6\\cdot |x|+2x & = \\\\ 6|x|+2x & .\\end{aligned}\n$$\n\nNow, since $x \\lt 0,$ we have that $|x|=-x.$ Therefore,\n\n$$\n\\begin{aligned}6|x|+2x & = \\\\ 6(-x)+2x & = \\\\ -6x+2x & = \\\\ -4x & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186171819 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186172015 :knowledge-point/id #uuid "72810e1e-8a12-5488-8aac-3a94cc027e68" :knowledge-point/title "Simplifying Absolute Value Expressions"}] :question/id #uuid "9c4b5b23-3d35-593a-ae69-4766e5b1d996" :question/math-academy-id "e-6800" :question/problem "Simplify the expression $|{-3z}|-5\\cdot|4z|.$" :question/worked-solution "Firstly, since $|{-a}| = |a|,$ we can write our expression as\n\n$$\n|3z|-5\\cdot|4z|.\n$$\n\nThen, we distribute the absolute value over the multiplication, and simplify:\n\n$$\n\\begin{aligned}|3z|-5\\cdot |4z| & = \\\\ |3|\\cdot |z|-5\\cdot |4|\\cdot |z| & = \\\\ 3\\cdot |z|-5\\cdot 4\\cdot |z| & = \\\\ 3\\cdot |z|-20\\cdot |z| & = \\\\ 3|z|-20|z| & = \\\\ -17|z| & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186498592 :knowledge-point/_questions [{:db/id #edb/ref 17592186172111 :knowledge-point/id #uuid "2b534245-8276-5e9b-8b9f-0d749116477a" :knowledge-point/title "Simplifying the Absolute Value of a Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21bf1704-ae50-5b54-a182-325089ab00d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23{x}^{2}" :db/id #edb/ref 17592186497869} {:answer/id #uuid "321ca6e7-d285-51c9-adf9-dfbc55c99850" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-23{x}^{2}" :db/id #edb/ref 17592186497905} {:answer/id #uuid "5d0bcf01-4cbe-5eb8-9d07-d7f0a66f2376" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17{x}^{2}" :db/id #edb/ref 17592186498021} {:answer/id #uuid "6213ccd5-c307-524b-bc39-8b8b7e2483b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20{x}^{2}" :db/id #edb/ref 17592186498033} {:answer/id #uuid "a52788c1-3a77-5c4b-ade7-61069bf6f83e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-17{x}^{2}" :db/id #edb/ref 17592186498166}] :answer-field/correct {:answer/id #uuid "321ca6e7-d285-51c9-adf9-dfbc55c99850" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-23{x}^{2}" :db/id #edb/ref 17592186497905} :answer-field/id #uuid "7e64f76b-2425-5767-b9ca-e2c7784c239d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186498422}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e3661ca5-897d-5020-9895-05a1bf678821" :question/math-academy-id "q-112119" :question/problem "Simplify the expression $-|3{x}^{2}|-20{x}^{2}.$" :question/worked-solution "Since ${x}^{2}\\ge 0$ for any real $x,$ we have that $|{x}^{2}|={x}^{2}.$ Therefore,\n\n$$\n\\begin{aligned}-3|{x}^{2}|-20{x}^{2} & = \\\\ -3{x}^{2}-20{x}^{2} & = \\\\ -23{x}^{2} & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186498593 :knowledge-point/_questions [{:db/id #edb/ref 17592186172112 :knowledge-point/id #uuid "60502703-f918-51c6-98dc-62fdd6e3241e" :knowledge-point/title "Evaluating an Absolute Value Expression with a Domain Restriction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03e4c244-a68e-55ae-a92b-6540fc8c4b9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8t" :db/id #edb/ref 17592186497808} {:answer/id #uuid "78bde8d4-2f51-5499-a365-c45edac01872" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12t" :db/id #edb/ref 17592186498087} {:answer/id #uuid "8e144f82-d6b5-5c17-89bc-8e3b36699d8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-60t" :db/id #edb/ref 17592186498124} {:answer/id #uuid "aa08d3f1-d288-5d4f-bc40-67c27f035c8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60t" :db/id #edb/ref 17592186498175} {:answer/id #uuid "fd72f5e5-6116-5149-af66-7c80c1a4d93d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12t" :db/id #edb/ref 17592186498355}] :answer-field/correct {:answer/id #uuid "78bde8d4-2f51-5499-a365-c45edac01872" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12t" :db/id #edb/ref 17592186498087} :answer-field/id #uuid "9c92d9a2-3859-545b-a533-f16c27765483" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186498435}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e5e4373f-fc17-548d-be9f-bc3f6efcbaf7" :question/math-academy-id "q-135707" :question/problem "Given that $t\\ge 0,$ simplify $-36t+|-24t|.$" :question/worked-solution "Firstly, since $|-a|=|a|,$ we can write our expression as\n\n$$\n-36t+|24t|.\n$$\n\nThen, we distribute the absolute value over the multiplication. This gives\n\n$$\n\\begin{aligned}-36t+|24t| & = \\\\ -36t+|24|\\cdot |t| & = \\\\ -36t+24\\cdot |t| & = \\\\ -36t+24|t| & .\\end{aligned}\n$$\n\nNow, since $t\\ge 0,$ we have that $|t|=t.$ Therefore,\n\n$$\n\\begin{aligned}-36t+24|t| & = \\\\ -36t+24t & = \\\\ -12t & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186498496 :knowledge-point/_questions [{:db/id #edb/ref 17592186172112 :knowledge-point/id #uuid "60502703-f918-51c6-98dc-62fdd6e3241e" :knowledge-point/title "Evaluating an Absolute Value Expression with a Domain Restriction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44c2ade4-f5ae-5da7-92f6-13439bcfb0e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10q" :db/id #edb/ref 17592186497952} {:answer/id #uuid "95da5035-aa03-5fd9-9934-1276912a83bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12q" :db/id #edb/ref 17592186498140} {:answer/id #uuid "b8b6c976-6a54-5ca3-9ff2-d2becacd1202" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14q" :db/id #edb/ref 17592186498210} {:answer/id #uuid "c096d1ec-d8c4-558c-995c-07ceb55cc2fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14q" :db/id #edb/ref 17592186498227} {:answer/id #uuid "f20d18bf-7e28-55a2-8282-878eb89dcddf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10q" :db/id #edb/ref 17592186498330}] :answer-field/correct {:answer/id #uuid "44c2ade4-f5ae-5da7-92f6-13439bcfb0e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10q" :db/id #edb/ref 17592186497952} :answer-field/id #uuid "b1a3138f-68f7-5a88-b85b-47ce925e2372" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186498446}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "13de8b24-aaa0-5ec2-ad2b-e4d7d0eec094" :question/math-academy-id "q-135712" :question/problem "Given that $q\\ge 0,$ simplify $12q-|-2q|.$" :question/worked-solution "Firstly, since $|-a|=|a|,$ we can write our expression as\n\n$$\n12q-|2q|.\n$$\n\nThen, we distribute the absolute value over the multiplication. This gives\n\n$$\n\\begin{aligned}12q-|2q| & = \\\\ 12q-|2|\\cdot |q| & = \\\\ 12q-2\\cdot |q| & = \\\\ 12q-2|q| & .\\end{aligned}\n$$\n\nNow, since $q\\ge 0,$ we have that $|q|=q.$ Therefore,\n\n$$\n\\begin{aligned}12q-2|q| & = \\\\ 12q-2q & = \\\\ 10q & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186172574 :knowledge-point/_questions [{:db/id #edb/ref 17592186172015 :knowledge-point/id #uuid "72810e1e-8a12-5488-8aac-3a94cc027e68" :knowledge-point/title "Simplifying Absolute Value Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1aa2fee-c2fb-55e9-ace9-208c5cc6a263" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186171070} {:answer/id #uuid "10a2ca61-b1fd-543e-a25d-6398f268236d" :answer/type {