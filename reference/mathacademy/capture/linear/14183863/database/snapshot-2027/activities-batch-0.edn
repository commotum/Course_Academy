#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186173015} :activity/id #uuid "0db9f058-2c2b-5d1f-a85c-11f1e1e699e3" :activity/scope {:db/id #edb/ref 17592186049636 :topic/id #uuid "07291a04-1a38-5ba5-bc33-f7a4e1cf0c19" :topic/math-academy-id 3536} :activity/steps [{:db/id #edb/ref 17592186172867 :step/content {:db/id #edb/ref 17592186172015 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171819 :question/id #uuid "9c4b5b23-3d35-593a-ae69-4766e5b1d996" :question/math-academy-id "e-6800"} :knowledge-point/id #uuid "72810e1e-8a12-5488-8aac-3a94cc027e68" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048159} {:db/id #edb/ref 17592186050452}] :knowledge-point/questions [{:db/id #edb/ref 17592186172573} {:db/id #edb/ref 17592186172574} {:db/id #edb/ref 17592186498498}] :knowledge-point/title "Simplifying Absolute Value Expressions"} :step/id #uuid "4c2ee3dc-ab94-51f0-bcdc-ab20413c5355" :step/math-academy-id 25123 :step/next {:db/id #edb/ref 17592186173102}} {:db/id #edb/ref 17592186173015 :step/content {:db/id #edb/ref 17592186173210 :tutorial/content "In this lesson, we'll extend our knowledge of absolute value. \n\nLet's first remind ourselves of the rules of absolute value:\n\n- $|{-a}| = |a|$\n\n- $|a \\cdot b| = |a| \\cdot |b|$\n\n- $\\left| \\dfrac{a}{b} \\right| = \\dfrac{|a|}{|b|}$\n\nRecall that the last two rules are known as the **distributive properties.**" :tutorial/id #uuid "3d23d2e9-6bc0-5a8b-bdb3-84a2f0e9d4d6" :tutorial/math-academy-id 6010 :tutorial/title "Introduction"} :step/id #uuid "de7a2169-7d86-5d52-813f-d1d199541882" :step/math-academy-id 36685 :step/next {:db/id #edb/ref 17592186172867}} {:db/id #edb/ref 17592186173035 :step/content {:db/id #edb/ref 17592186172111 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171714 :question/id #uuid "8b27c37f-10a7-5e55-8230-916bb246142b" :question/math-academy-id "e-1238"} :knowledge-point/id #uuid "2b534245-8276-5e9b-8b9f-0d749116477a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050428}] :knowledge-point/questions [{:db/id #edb/ref 17592186172550} {:db/id #edb/ref 17592186172584} {:db/id #edb/ref 17592186498552} {:db/id #edb/ref 17592186498592}] :knowledge-point/title "Simplifying the Absolute Value of a Square"} :step/id #uuid "a35c659d-3a92-5292-a856-8e051b0df01d" :step/math-academy-id 3977 :step/next {:db/id #edb/ref 17592186173103}} {:db/id #edb/ref 17592186173036 :step/content {:db/id #edb/ref 17592186172112 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171715 :question/id #uuid "e0d4030c-4490-5e36-af26-7ded6003e841" :question/math-academy-id "e-1239"} :knowledge-point/id #uuid "60502703-f918-51c6-98dc-62fdd6e3241e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050519}] :knowledge-point/questions [{:db/id #edb/ref 17592186172314} {:db/id #edb/ref 17592186172549} {:db/id #edb/ref 17592186498496} {:db/id #edb/ref 17592186498593}] :knowledge-point/title "Evaluating an Absolute Value Expression with a Domain Restriction"} :step/id #uuid "6c3441ba-31e5-52c4-9a8b-3e8a4cd3a43d" :step/math-academy-id 3978} {:db/id #edb/ref 17592186173102 :step/content {:db/id #edb/ref 17592186173140 :tutorial/content "We know that the absolute value operation does nothing to a number if it is non-negative. For example:\n\n$$\n\\begin{aligned}|0| & =0 \\\\ |1| & =1 \\\\ |2| & =2 \\\\ |3| & =3 \\\\  & ⋮\\end{aligned}\n$$\n\nWe can summarize this fact as follows:\n\n$$\n|x| = x \\quad \\text{ if } \\quad x \\geq 0\n$$\n\nWe also know that $x^2$ is non-negative for any value of $x$. Therefore, \n\n$$\n\\left|x^2\\right| = x^2\n$$\n\nwhere $x$ is *any* real number." :tutorial/id #uuid "b20a7fe3-4627-5ed7-a7dd-afd383fa3c59" :tutorial/math-academy-id 1716 :tutorial/title "The Absolute Value of a Square"} :step/id #uuid "f329f688-b5f5-5222-a1c0-599debe7606f" :step/math-academy-id 5019 :step/next {:db/id #edb/ref 17592186173035}} {:db/id #edb/ref 17592186173103 :step/content {:db/id #edb/ref 17592186173141 :tutorial/content "We know that $|x|=x$ if $x \\geq 0.$ But what if $x < 0?$\n\nIf a variable is known to be negative, then the absolute value changes it to positive. To turn a negative number into a positive number, we multiply by $-1.$ Therefore, we have\n\n$$\n|x|  = -x \\quad\\textrm{for}\\quad x < 0.\n$$\n\nTo convince ourselves that this is indeed true, let's verify it in the case when $x=-2.$ Substituting this value into the above, we get\n\n$$\n\\begin{aligned}|-2| & =-(-2)=2.\\,✓\\end{aligned}\n$$" :tutorial/id #uuid "93c4f77c-611c-5870-88b3-e76b8bbc7275" :tutorial/math-academy-id 1831 :tutorial/title "The Absolute Value of a Negative Variable"} :step/id #uuid "3819c50d-8c6b-5e33-b8c9-e35bd4855c00" :step/math-academy-id 5922 :step/next {:db/id #edb/ref 17592186173036}}] :activity/title "Further Rules of Absolute Value" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186172208}]}
