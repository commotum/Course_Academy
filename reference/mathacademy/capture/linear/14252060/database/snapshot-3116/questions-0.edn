#{[{:db/id #edb/ref 17592186572720 :knowledge-point/_questions [{:db/id #edb/ref 17592186157331 :knowledge-point/id #uuid "48968893-6430-5e1b-ac7a-bd36991f910f" :knowledge-point/title "Manipulating Rational Expressions With Two-Term Numerators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4628792-4682-5a1d-a874-d58d1eaf6e72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+11" :db/id #edb/ref 17592186572551}] :answer-field/correct {:answer/id #uuid "d4628792-4682-5a1d-a874-d58d1eaf6e72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+11" :db/id #edb/ref 17592186572551} :answer-field/id #uuid "530ba967-fb51-5147-9beb-a54a4c2cbcd1" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572617} {:answer-field/choices [{:answer/id #uuid "04e2c946-62a1-5997-9aaa-d03ba638dfce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186572321}] :answer-field/correct {:answer/id #uuid "04e2c946-62a1-5997-9aaa-d03ba638dfce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186572321} :answer-field/id #uuid "a9598e78-a214-52b2-8ddf-fd78a112790d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572634}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e60ce661-ee8f-513d-978f-4505c3b6113e" :question/math-academy-id "q-319887" :question/problem "Write $\\frac{7{x}^{2}+11}{7{x}^{2}-x}$ in the form $a+\\frac{bx+c}{7{x}^{2}-x},$ where $a\\ne 0.$\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"25\" width=\"20\">$7{x}^{2}+11$</td>\n<td align=\"center\" rowspan=\"2\" width=\"20\">$=$</td>\n<td align=\"center\" rowspan=\"2\" width=\"20\">\n{{field-1}}\n</td>\n<td align=\"center\" rowspan=\"2\" width=\"20\">$+$</td>\n<td align=\"center\" height=\"25\" width=\"20\">\n{{field-2}} \n</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"20\">$7{x}^{2}-x$</td>\n<td align=\"center\" height=\"25\" width=\"25\">$7{x}^{2}-x$</td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we add and subtract $x$ in the numerator. This reveals a copy of the denominator without changing the value of the expression.\n\n$$\n\\begin{aligned}\\frac{7{x}^{2}+11}{7{x}^{2}-x}\\, &=\\,\\frac{7{x}^{2}-x+x+11}{7{x}^{2}-x}\\end{aligned}\n$$\n\nThen, we split the fraction into two, and then simplify:\n\n$$\n\\begin{aligned}\\frac{7{x}^{2}-x+x+11}{7{x}^{2}-x} & =\\frac{7{x}^{2}-x}{7{x}^{2}-x}+\\frac{x+11}{7{x}^{2}-x} \\\\  & =1+\\frac{x+11}{7{x}^{2}-x}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186572680 :knowledge-point/_questions [{:db/id #edb/ref 17592186157331 :knowledge-point/id #uuid "48968893-6430-5e1b-ac7a-bd36991f910f" :knowledge-point/title "Manipulating Rational Expressions With Two-Term Numerators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d846a64-abc2-5e79-900f-14546c13193f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x+8" :db/id #edb/ref 17592186572466}] :answer-field/correct {:answer/id #uuid "8d846a64-abc2-5e79-900f-14546c13193f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x+8" :db/id #edb/ref 17592186572466} :answer-field/id #uuid "06cc8abc-9969-520a-92ec-da121eb11e0e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572590} {:answer-field/choices [{:answer/id #uuid "16245121-faf6-59e2-91c2-178909efd6ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186572340}] :answer-field/correct {:answer/id #uuid "16245121-faf6-59e2-91c2-178909efd6ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186572340} :answer-field/id #uuid "24b07630-8e0e-5bd4-9fd6-7d99d663bf65" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572602}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2560be5d-dea1-5429-b927-2f169d6e2bc3" :question/math-academy-id "q-320734" :question/problem "Write $\\frac{3{x}^{6}+8}{3{x}^{6}+2x}$ in the form $a+\\frac{bx+c}{3{x}^{6}+2x},$ where $a\\ne 0.$\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"25\" width=\"20\">$3{x}^{6}+8$</td>\n<td align=\"center\" rowspan=\"2\" width=\"20\">$=$</td>\n<td align=\"center\" rowspan=\"2\" width=\"20\">\n{{field-1}}\n</td>\n<td align=\"center\" rowspan=\"2\" width=\"20\">$+$</td>\n<td align=\"center\" height=\"25\" width=\"20\">\n{{field-2}} \n</td></tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"20\">$3{x}^{6}+2x$</td>\n<td align=\"center\" height=\"25\" width=\"25\">$3{x}^{6}+2x$</td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we add and subtract $2x$ in the numerator. This reveals a copy of the denominator without changing the value of the expression.\n\n$$\n\\begin{aligned}\\frac{3{x}^{6}+8}{3{x}^{6}+2x}\\, &=\\,\\frac{3{x}^{6}+2x-2x+8}{3{x}^{6}+2x}\\end{aligned}\n$$\n\nThen, we split the fraction into two, and then simplify:\n\n$$\n\\begin{aligned}\\frac{3{x}^{6}+2x-2x+8}{3{x}^{6}+2x} & =\\frac{3{x}^{6}+2x}{3{x}^{4}+2x}+\\frac{-2x+8}{3{x}^{6}+2x} \\\\  & =1+\\frac{-2x+8}{3{x}^{6}+2x}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186572703 :knowledge-point/_questions [{:db/id #edb/ref 17592186157332 :knowledge-point/id #uuid "81690612-bbae-5d54-a65c-f280d627e051" :knowledge-point/title "Manipulating Rational Expressions With Single-Term Numerators When Factoring Is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f9ea0c4-76bf-5905-be8b-b3f2a63ceb17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186572469}] :answer-field/correct {:answer/id #uuid "8f9ea0c4-76bf-5905-be8b-b3f2a63ceb17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186572469} :answer-field/id #uuid "24f92d24-8798-5945-aea4-27e7c6675cc0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572603} {:answer-field/choices [{:answer/id #uuid "117b0321-12f8-5db2-9373-93df7784178e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186572334}] :answer-field/correct {:answer/id #uuid "117b0321-12f8-5db2-9373-93df7784178e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186572334} :answer-field/id #uuid "9b4a5073-566c-54e9-b4bd-3787bd35281f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572631}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "902313f6-5fff-5e8d-b85b-2153357455ee" :question/math-academy-id "q-320766" :question/problem "Write $\\frac{12{x}^{7}}{6{x}^{7}+4}$ in the form $a+\\frac{b}{6{x}^{7}+4},$ where $a\\ne 0.$\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"25\" width=\"30\">$12{x}^{7}$</td>\n<td align=\"center\" rowspan=\"2\" width=\"25\">$=$</td>\n<td align=\"center\" rowspan=\"2\" width=\"30\">\n{{field-1}}\n</td>\n<td align=\"center\" rowspan=\"2\" width=\"25\">$+$</td>\n<td align=\"center\" height=\"25\" width=\"60\">\n{{field-2}}\n</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"30\">$6{x}^{7}+4$</td>\n<td align=\"center\" height=\"25\" width=\"60\">$6{x}^{7}+4$</td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we factor the numerator to put $6{x}^{7}$ in parentheses. Then, we add and subtract $4$ in the parentheses. This reveals a copy of the denominator without changing the value of the expression.\n\n$$\n\\begin{aligned}\\frac{12{x}^{7}}{6{x}^{7}+4} & =\\frac{2(6{x}^{7})}{6{x}^{7}+4} \\\\  & =\\frac{2(6{x}^{7}+4-4)}{6{x}^{7}+4} \\\\  & =\\frac{2[(6{x}^{7}+4)-(4)]}{6{x}^{7}+4} \\\\  & =\\frac{2(6{x}^{7}+4)-2(4)}{6{x}^{7}+4} \\\\  & =\\frac{2(6{x}^{7}+4)-8}{6{x}^{7}+4}\\end{aligned}\n$$\n\nThen, we split the fraction into two, and then simplify:\n\n$$\n\\begin{aligned}\\frac{2(6{x}^{7}+4)-8}{6{x}^{7}+4} & =\\frac{2(6{x}^{7}+4)}{6{x}^{7}+4}+\\frac{-8}{6{x}^{7}+4} \\\\  & =2+\\frac{-8}{6{x}^{7}+4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186157915 :knowledge-point/_questions [{:db/id #edb/ref 17592186157332 :knowledge-point/id #uuid "81690612-bbae-5d54-a65c-f280d627e051" :knowledge-point/title "Manipulating Rational Expressions With Single-Term Numerators When Factoring Is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee0eddf6-99f2-5ce4-bb90-9e201037296b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186156412} {:answer/id #uuid "1d340778-bacc-54c9-b3b0-a8b784941051" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186156413} {:answer/id #uuid "29644247-2a10-540f-8b51-0ce5f75ee888" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186156414} {:answer/id #uuid "45377d04-6450-52a1-92c4-1cdb1d0fe8bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186156415} {:answer/id #uuid "4b4208ff-3339-55ef-bbce-73ea5baae33b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186156416}] :answer-field/id #uuid "9fcce30f-d5e7-5714-9af1-58ca909a130a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186156411}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5a74ccce-5b2e-5223-bac8-fd44083f3ad3" :question/math-academy-id "q-87780" :question/problem "Write $\\frac{12x^{3}}{4x^{2} + 5}$ in the form $ax + \\frac{bx}{4x^{2} + 5}$, where $a \\ne 0$. What is the value of $a + b$?"}] [{:db/id #edb/ref 17592186572675 :knowledge-point/_questions [{:db/id #edb/ref 17592186157331 :knowledge-point/id #uuid "48968893-6430-5e1b-ac7a-bd36991f910f" :knowledge-point/title "Manipulating Rational Expressions With Two-Term Numerators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08b9d701-17fb-509e-8c7b-01064dbfe77e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186572324} {:answer/id #uuid "0ec33733-a92b-513a-8b3a-441394690614" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186572331} {:answer/id #uuid "38f33d30-e38c-5faa-9338-dbf365de000d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186572383} {:answer/id #uuid "8513669d-7bff-5157-b69b-9aeddb648094" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186572459} {:answer/id #uuid "aebed835-e63b-5938-9cad-6b9f4db797ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186572506}] :answer-field/correct {:answer/id #uuid "0ec33733-a92b-513a-8b3a-441394690614" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186572331} :answer-field/id #uuid "0b37f42c-dcbd-5572-b8fc-d3cf6928d353" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572592}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1f4665bd-3b2f-5e28-98c1-a2915a1c6960" :question/math-academy-id "q-88260" :question/problem "Write $\\frac{4x-1}{4x-7}$ in the form $a+\\frac{b}{4x-7},$ where $a\\ne 0.$ What is the value of $a+b?$" :question/worked-solution "First, we subtract and add $7$ in the numerator. This reveals a copy of the denominator without changing the value of the expression.\n\n$$\n\\begin{aligned}\\frac{4x-1}{4x-7} &=\\frac{4x-7+7-1}{4x-7}\\end{aligned}\n$$\n\nThen, we split the fraction into two, and then simplify:\n\n$$\n\\begin{aligned}\\frac{4x-7+7-1}{4x-7} & =\\frac{4x-7}{4x-7}+\\frac{7-1}{4x-7} \\\\  & =1+\\frac{6}{4x-7}\\end{aligned}\n$$\n\nTherefore, we have $a=1$ and $b=6,$ and we get\n\n$$\na+b=1+6=7.\n$$"}]}
