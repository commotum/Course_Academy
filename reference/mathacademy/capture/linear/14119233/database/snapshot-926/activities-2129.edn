#{[{:activity/first-step {:db/id #edb/ref 17592186134693} :activity/id #uuid "268bdff9-18d6-5412-ae6e-b8444e305d46" :activity/scope {:db/id #edb/ref 17592186050130 :topic/id #uuid "2f232786-4262-5d64-9c58-1578e8c629d2" :topic/math-academy-id 2129} :activity/steps [{:db/id #edb/ref 17592186134693 :step/content {:db/id #edb/ref 17592186135058 :tutorial/content "The **QR factorization** of an $m\\times n$ matrix $A$ with linearly independent columns is the matrix product $$\\underset{{\\large m} \\times {\\large n}}{A} = \\underset{{\\large m} \\times {\\large n}}{Q} \\times \\underset{{\\large n} \\times {\\large n}}{R},$$\n\nwhere\n\n- $Q$ is an $m \\times n$ matrix whose columns form an orthonormal basis of $\\text{Col}(A),$ and\n- $R$ is an $n \\times n$ upper triangular matrix with positive entries on its diagonal.\n\nFor example, the $3\\times 2$ matrix\n\n$$A = [\\begin{aligned}2 & -3 \\\\ -4 & 3 \\\\ 4 & 0\\end{aligned}]$$\n\nhas the QR factorization\n\n$$\\overbrace{ [\\begin{aligned}2 & -3 \\\\ -4 & 3 \\\\ 4 & 0\\end{aligned}] }^{\\Large A} = \\overbrace{ [\\begin{aligned}\\frac{1}{3} & -\\frac{2}{3} \\\\ -\\frac{2}{3} & \\frac{1}{3} \\\\ \\frac{2}{3} & \\frac{2}{3}\\end{aligned}] }^{\\Large Q} \\overbrace{ [\\begin{aligned}6 & -3 \\\\ 0 & 3\\end{aligned}] }^{\\Large R}.$$" :tutorial/id #uuid "ce4cf9b1-a257-518d-befa-0bfba1cdec60" :tutorial/math-academy-id 3635 :tutorial/title "Introduction"} :step/id #uuid "69e8ec76-c280-55f4-8fc9-a6277b14654a" :step/math-academy-id 20266 :step/next {:db/id #edb/ref 17592186134800}} {:db/id #edb/ref 17592186134694 :step/content {:db/id #edb/ref 17592186133798 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133607 :question/id #uuid "f042812b-fb14-520a-bb6d-08631d941d04" :question/math-academy-id "e-5586"} :knowledge-point/id #uuid "19ae0632-68ac-5da9-8adf-cf71d5ecbc7c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050578}] :knowledge-point/questions [{:db/id #edb/ref 17592186134324} {:db/id #edb/ref 17592186134326} {:db/id #edb/ref 17592186364620} {:db/id #edb/ref 17592186364627} {:db/id #edb/ref 17592186378705} {:db/id #edb/ref 17592186388792} {:db/id #edb/ref 17592186395107}] :knowledge-point/title "Finding the QR Factorization of a Matrix"} :step/id #uuid "154bb446-4c57-548a-b863-0bfee2ca6f92" :step/math-academy-id 20267} {:db/id #edb/ref 17592186134732 :step/content {:db/id #edb/ref 17592186133821 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133633 :question/id #uuid "c6fe3751-c00b-592b-903e-567d95174cd2" :question/math-academy-id "e-5959"} :knowledge-point/id #uuid "cd18abf3-b551-55d6-a573-690745a65b3e" :knowledge-point/questions [{:db/id #edb/ref 17592186134352} {:db/id #edb/ref 17592186134354} {:db/id #edb/ref 17592186363217} {:db/id #edb/ref 17592186364171} {:db/id #edb/ref 17592186364178} {:db/id #edb/ref 17592186364599} {:db/id #edb/ref 17592186364606}] :knowledge-point/title "Finding a QR Factorization of a Matrix Given an Orthogonal Basis in Terms of the Columns of a Matrix"} :step/id #uuid "909730ba-aeca-592b-b525-e38e4f18e31a" :step/math-academy-id 22120 :step/next {:db/id #edb/ref 17592186134803}} {:db/id #edb/ref 17592186134798 :step/content {:db/id #edb/ref 17592186133862 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133678 :question/id #uuid "0a812585-d467-562d-acda-e379ac9dc544" :question/math-academy-id "e-8324"} :knowledge-point/id #uuid "38edbd80-2aef-5b3e-8dd9-de9f2fbeca9b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049606}] :knowledge-point/questions [{:db/id #edb/ref 17592186134315} {:db/id #edb/ref 17592186134355} {:db/id #edb/ref 17592186364152} {:db/id #edb/ref 17592186364585} {:db/id #edb/ref 17592186364592} {:db/id #edb/ref 17592186392389}] :knowledge-point/title "Finding the Triangular Factor of a QR Factorization Given the Orthogonal Factor"} :step/id #uuid "4035e4b7-aa8c-56a6-be26-0855ad0ce971" :step/math-academy-id 31108 :step/next {:db/id #edb/ref 17592186134802}} {:db/id #edb/ref 17592186134799 :step/content {:db/id #edb/ref 17592186133863 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133679 :question/id #uuid "155ed7f9-909e-5550-b1ef-f707b49f7fde" :question/math-academy-id "e-8325"} :knowledge-point/id #uuid "1ed5119c-5ce8-52dc-bd57-f9439ea199e6" :knowledge-point/questions [{:db/id #edb/ref 17592186134316} {:db/id #edb/ref 17592186134356} {:db/id #edb/ref 17592186363224} {:db/id #edb/ref 17592186363231} {:db/id #edb/ref 17592186364613} {:db/id #edb/ref 17592186380318} {:db/id #edb/ref 17592186395093} {:db/id #edb/ref 17592186395100}] :knowledge-point/title "Finding a QR Factorization of a Matrix Given a Matrix With Orthogonal Columns"} :step/id #uuid "133bd600-5eaf-5eaa-99fa-64b4c2a014a2" :step/math-academy-id 31109 :step/next {:db/id #edb/ref 17592186134694}} {:db/id #edb/ref 17592186134800 :step/content {:db/id #edb/ref 17592186133864 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133680 :question/id #uuid "35fdd570-1c80-5b0d-9c5f-fa277bd30afb" :question/math-academy-id "e-8326"} :knowledge-point/id #uuid "1304189f-61ac-53c5-9b09-8e365f763136" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049811} {:db/id #edb/ref 17592186050283} {:db/id #edb/ref 17592186050656}] :knowledge-point/questions [{:db/id #edb/ref 17592186134546} {:db/id #edb/ref 17592186134548} {:db/id #edb/ref 17592186363203} {:db/id #edb/ref 17592186363210} {:db/id #edb/ref 17592186364571} {:db/id #edb/ref 17592186364578}] :knowledge-point/title "Identifying Dimensions of Factors in a QR Factorization"} :step/id #uuid "28dbf6ab-32c9-578d-b6cd-07619f45dc9d" :step/math-academy-id 31119 :step/next {:db/id #edb/ref 17592186134801}} {:db/id #edb/ref 17592186134801 :step/content {:db/id #edb/ref 17592186135097 :tutorial/content "Given the matrix $Q$ in the QR factorization of an $m\\times n$ matrix $A,$ how do we find $R?$\n\nRecall that $Q$ has orthonormal columns, so pre-multiplying both sides of $A=QR$ by $Q^T,$ we obtain\n\n$$\\begin{aligned}{Q}^{T}\\cdot A & ={Q}^{T}\\cdot QR \\\\ {Q}^{T}A & ={Q}^{T}QR.\\end{aligned}$$\n\nNow, note that since the columns of $Q$ are orthonormal we have $Q^TQ = I_n.$ Therefore,\n\n$$\\begin{aligned}{Q}^{T}A & =({Q}^{T}Q)R \\\\ {Q}^{T}A & ={I}_{n}R \\\\ R & ={Q}^{T}A.\\end{aligned}$$\n\nSo, we can find $R$ by pre-multiplying $A$ by the transpose of $Q.$" :tutorial/id #uuid "20b6ab0a-cf41-550b-9242-2bb3f84c4917" :tutorial/math-academy-id 5017 :tutorial/title "Computing the Matrix R Given the Matrix Q in a QR Factorization"} :step/id #uuid "eebb9689-f8b3-55e2-8167-e5f5525e382a" :step/math-academy-id 31388 :step/next {:db/id #edb/ref 17592186134798}} {:db/id #edb/ref 17592186134802 :step/content {:db/id #edb/ref 17592186135098 :tutorial/content "Let's consider the QR factorization of the matrix $A$ shown below:\n\n$$\\overbrace{ [\\begin{aligned}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{aligned}] }^{\\Large A} = \\overbrace{ [\\begin{aligned}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{aligned}] }^{\\Large Q} \\overbrace{ [\\begin{aligned}{r}_{11} & {r}_{12} & {r}_{13} \\\\ 0 & {r}_{22} & {r}_{23} \\\\ 0 & 0 & {r}_{33}\\end{aligned}] }^{\\Large R}$$\n\nSuppose also that we are given the following system of equations that connects the columns of $Q$ and the columns of $A{:}$\n\n$${\\begin{aligned}{q}_{1}=\\frac{1}{2}{a}_{1} \\\\ {q}_{2}=\\frac{1}{3}{a}_{2}+3{q}_{1} \\\\ {q}_{3}=\\frac{1}{4}{a}_{3}-2{q}_{1}+{q}_{2}\\end{aligned}$$\n\nHow do we find $R?$ First, let's rewrite the vectors $\\mathbf{a}_1, \\mathbf{a}_2, \\mathbf{a}_3$ as a linear combination of the vectors $\\mathbf{q}_1, \\mathbf{q}_2, \\mathbf{q}_3 \\mathbin{:}$ $${\\begin{aligned}{q}_{1}=\\frac{1}{2}{a}_{1} \\\\ {q}_{2}=\\frac{1}{3}{a}_{2}+3{q}_{1} \\\\ {q}_{3}=\\frac{1}{4}{a}_{3}-2{q}_{1}+{q}_{2}\\end{aligned} \\qquad\\Longrightarrow\\qquad {\\begin{aligned}{a}_{1}=2{q}_{1} \\\\ {a}_{2}=-9{q}_{1}+3{q}_{2} \\\\ {a}_{3}=8{q}_{1}-4{q}_{2}+4{q}_{3}.\\end{aligned}$$\n\nIn this new system, the coefficients of $\\mathbf{q}_1$ correspond to the first-row entries of $R,$ the coefficients of $\\mathbf{q}_2$ correspond to the second-row entries of $R,$ and the coefficients of $\\mathbf{q}_3$ correspond to the third-row entries of $R.$ Therefore,\n\n$$\\overbrace{ [\\begin{aligned}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{aligned}] }^{\\Large A} = \\overbrace{ [\\begin{aligned}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{aligned}] }^{\\Large Q} \\overbrace{ [\\begin{aligned}2 & -9 & 8 \\\\ 0 & 3 & -4 \\\\ 0 & 0 & 4\\end{aligned}] }^{\\Large R}.$$\n\nTo see why this is, we can take the transpose of both sides of $A=QR{:}$ $$\\begin{aligned}A & =QR \\\\ {A}^{T} & =(QR)^{T} \\\\ {A}^{T} & ={R}^{T}{Q}^{T} \\\\ \\overset{{A}^{T}}{\\overset{⏞}{[\\begin{aligned}-\\,\\,\\,\\, & {a}_{1} & \\,\\,\\,\\,- \\\\ -\\,\\,\\,\\, & {a}_{2} & \\,\\,\\,\\,- \\\\ -\\,\\,\\,\\, & {a}_{3} & \\,\\,\\,\\,-\\end{aligned}]}} & =\\overset{{R}^{T}}{\\overset{⏞}{[\\begin{aligned}2 & 0 & 0 \\\\ -9 & 3 & 0 \\\\ 8 & -4 & 4\\end{aligned}]}}\\overset{{Q}^{T}}{\\overset{⏞}{[\\begin{aligned}-\\,\\,\\,\\, & {q}_{1} & \\,\\,\\,\\,- \\\\ -\\,\\,\\,\\, & {q}_{2} & \\,\\,\\,\\,- \\\\ -\\,\\,\\,\\, & {q}_{3} & \\,\\,\\,\\,-\\end{aligned}]}}\\end{aligned}$$\n\nIf we were to expand this matrix product, we would obtain our system of equations." :tutorial/id #uuid "9a6d9a3e-33d4-52e8-b8b0-98cd20590dd6" :tutorial/math-academy-id 5018 :tutorial/title "Interpreting Relations Between Two Bases as Matrix Multiplication"} :step/id #uuid "fdc0053f-e37d-51ef-835e-365ca5c6da98" :step/math-academy-id 31389 :step/next {:db/id #edb/ref 17592186134732}} {:db/id #edb/ref 17592186134803 :step/content {:db/id #edb/ref 17592186135099 :tutorial/content "Let's now go through the QR factorization algorithm to find the factorization of the matrix\n\n$$A = [\\begin{aligned}2 & 1 \\\\ 4 & 3 \\\\ -4 & -1\\end{aligned}].$$\n\n**Step 1**. Orthogonalize the columns of $A$ to get the columns of $Q.$ Using the Gram-Schmidt process, we obtain\n\n$$\\begin{aligned}{q}_{1}=\\frac{1}{3}[\\begin{aligned}1 \\\\ 2 \\\\ -2\\end{aligned}],\\,{q}_{2}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}].\\end{aligned}$$\n\n**Step 2**. Compute $R=Q^TA.$ We get\n\n$$\\begin{aligned}R=[\\begin{aligned}6 & 3 \\\\ 0 & \\sqrt{2}\\end{aligned}].\\end{aligned}$$\n\nTherefore, the QR factorization of $A$ is\n\n$$\\overbrace{ [\\begin{aligned}2 & 1 \\\\ 4 & 3 \\\\ -4 & -1\\end{aligned}] }^{\\Large A} = \\overbrace{ [\\begin{aligned}\\frac{1}{3} & 0 \\\\ \\frac{2}{3} & \\frac{1}{\\sqrt{2}} \\\\ -\\frac{2}{3} & \\frac{1}{\\sqrt{2}}\\end{aligned}] }^{\\Large Q} \\overbrace{ [\\begin{aligned}6 & 3 \\\\ 0 & \\sqrt{2}\\end{aligned}] }^{\\Large R}.$$" :tutorial/id #uuid "c2f59e79-8a0c-543b-8af0-381e95a18a8a" :tutorial/math-academy-id 5019 :tutorial/title "The QR Factorization Algorithm"} :step/id #uuid "94bcb87e-b43a-5740-aaed-1937658ca1d1" :step/math-academy-id 31390 :step/next {:db/id #edb/ref 17592186134799}}] :activity/title "QR Factorization" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186134008}]}
