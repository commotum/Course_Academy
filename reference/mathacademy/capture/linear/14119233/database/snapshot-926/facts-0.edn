86045417] [17592186134732 #edb/ref 1058 #edb/ref 17592186134803 #edb/ref 17592186045417] [17592186134732 #edb/ref 1061 22120 #edb/ref 17592186045417] [17592186134732 #edb/ref 1062 #uuid "909730ba-aeca-592b-b525-e38e4f18e31a" #edb/ref 17592186045417] [17592186134732 #edb/ref 1063 #edb/ref 17592186133821 #edb/ref 17592186045417] [17592186134798 #edb/ref 1058 #edb/ref 17592186134802 #edb/ref 17592186045417] [17592186134798 #edb/ref 1061 31108 #edb/ref 17592186045417] [17592186134798 #edb/ref 1062 #uuid "4035e4b7-aa8c-56a6-be26-0855ad0ce971" #edb/ref 17592186045417] [17592186134798 #edb/ref 1063 #edb/ref 17592186133862 #edb/ref 17592186045417] [17592186134799 #edb/ref 1058 #edb/ref 17592186134694 #edb/ref 17592186045417] [17592186134799 #edb/ref 1061 31109 #edb/ref 17592186045417] [17592186134799 #edb/ref 1062 #uuid "133bd600-5eaf-5eaa-99fa-64b4c2a014a2" #edb/ref 17592186045417] [17592186134799 #edb/ref 1063 #edb/ref 17592186133863 #edb/ref 17592186045417] [17592186134800 #edb/ref 1058 #edb/ref 17592186134801 #edb/ref 17592186045417] [17592186134800 #edb/ref 1061 31119 #edb/ref 17592186045417] [17592186134800 #edb/ref 1062 #uuid "28dbf6ab-32c9-578d-b6cd-07619f45dc9d" #edb/ref 17592186045417] [17592186134800 #edb/ref 1063 #edb/ref 17592186133864 #edb/ref 17592186045417] [17592186134801 #edb/ref 1058 #edb/ref 17592186134798 #edb/ref 17592186045417] [17592186134801 #edb/ref 1061 31388 #edb/ref 17592186045417] [17592186134801 #edb/ref 1062 #uuid "eebb9689-f8b3-55e2-8167-e5f5525e382a" #edb/ref 17592186045417] [17592186134801 #edb/ref 1063 #edb/ref 17592186135097 #edb/ref 17592186045417] [17592186134802 #edb/ref 1058 #edb/ref 17592186134732 #edb/ref 17592186045417] [17592186134802 #edb/ref 1061 31389 #edb/ref 17592186045417] [17592186134802 #edb/ref 1062 #uuid "fdc0053f-e37d-51ef-835e-365ca5c6da98" #edb/ref 17592186045417] [17592186134802 #edb/ref 1063 #edb/ref 17592186135098 #edb/ref 17592186045417] [17592186134803 #edb/ref 1058 #edb/ref 17592186134799 #edb/ref 17592186045417] [17592186134803 #edb/ref 1061 31390 #edb/ref 17592186045417] [17592186134803 #edb/ref 1062 #uuid "94bcb87e-b43a-5740-aaed-1937658ca1d1" #edb/ref 17592186045417] [17592186134803 #edb/ref 1063 #edb/ref 17592186135099 #edb/ref 17592186045417] [17592186135058 #edb/ref 1064 "The **QR factorization** of an $m\\times n$ matrix $A$ with linearly independent columns is the matrix product $$\\underset{{\\large m} \\times {\\large n}}{A} = \\underset{{\\large m} \\times {\\large n}}{Q} \\times \\underset{{\\large n} \\times {\\large n}}{R},$$\n\nwhere\n\n- $Q$ is an $m \\times n$ matrix whose columns form an orthonormal basis of $\\text{Col}(A),$ and\n- $R$ is an $n \\times n$ upper triangular matrix with positive entries on its diagonal.\n\nFor example, the $3\\times 2$ matrix\n\n$$A = [\\begin{aligned}2 & -3 \\\\ -4 & 3 \\\\ 4 & 0\\end{aligned}]$$\n\nhas the QR factorization\n\n$$\\overbrace{ [\\begin{aligned}2 & -3 \\\\ -4 & 3 \\\\ 4 & 0\\end{aligned}] }^{\\Large A} = \\overbrace{ [\\begin{aligned}\\frac{1}{3} & -\\frac{2}{3} \\\\ -\\frac{2}{3} & \\frac{1}{3} \\\\ \\frac{2}{3} & \\frac{2}{3}\\end{aligned}] }^{\\Large Q} \\overbrace{ [\\begin{aligned}6 & -3 \\\\ 0 & 3\\end{aligned}] }^{\\Large R}.$$" #edb/ref 17592186045417] [17592186135058 #edb/ref 1065 3635 #edb/ref 17592186045417] [17592186135058 #edb/ref 1066 #uuid "ce4cf9b1-a257-518d-befa-0bfba1cdec60" #edb/ref 17592186045417] [17592186135058 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186135097 #edb/ref 1064 "Given the matrix $Q$ in the QR factorization of an $m\\times n$ matrix $A,$ how do we find $R?$\n\nRecall that $Q$ has orthonormal columns, so pre-multiplying both sides of $A=QR$ by $Q^T,$ we obtain\n\n$$\\begin{aligned}{Q}^{T}\\cdot A & ={Q}^{T}\\cdot QR \\\\ {Q}^{T}A & ={Q}^{T}QR.\\end{aligned}$$\n\nNow, note that since the columns of $Q$ are orthonormal we have $Q^TQ = I_n.$ Therefore,\n\n$$\\begin{aligned}{Q}^{T}A & =({Q}^{T}Q)R \\\\ {Q}^{T}A & ={I}_{n}R \\\\ R & ={Q}^{T}A.\\end{aligned}$$\n\nSo, we can find $R$ by pre-multiplying $A$ by the transpose of $Q.$" #edb/ref 17592186045417] [17592186135097 #edb/ref 1065 5017 #edb/ref 17592186045417] [17592186135097 #edb/ref 1066 #uuid "20b6ab0a-cf41-550b-9242-2bb3f84c4917" #edb/ref 17592186045417] [17592186135097 #edb/ref 1067 "Computing the Matrix R Given the Matrix Q in a QR Factorization" #edb/ref 17592186045417] [17592186135098 #edb/ref 1064 "Let's consider the QR factorization of the matrix $A$ shown below:\n\n$$\\overbrace{ [\\begin{aligned}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{aligned}] }^{\\Large A} = \\overbrace{ [\\begin{aligned}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{aligned}] }^{\\Large Q} \\overbrace{ [\\begin{aligned}{r}_{11} & {r}_{12} & {r}_{13} \\\\ 0 & {r}_{22} & {r}_{23} \\\\ 0 & 0 & {r}_{33}\\end{aligned}] }^{\\Large R}$$\n\nSuppose also that we are given the following system of equations that connects the columns of $Q$ and the columns of $A{:}$\n\n$${\\begin{aligned}{q}_{1}=\\frac{1}{2}{a}_{1} \\\\ {q}_{2}=\\frac{1}{3}{a}_{2}+3{q}_{1} \\\\ {q}_{3}=\\frac{1}{4}{a}_{3}-2{q}_{1}+{q}_{2}\\end{aligned}$$\n\nHow do we find $R?$ First, let's rewrite the vectors $\\mathbf{a}_1, \\mathbf{a}_2, \\mathbf{a}_3$ as a linear combination of the vectors $\\mathbf{q}_1, \\mathbf{q}_2, \\mathbf{q}_3 \\mathbin{:}$ $${\\begin{aligned}{q}_{1}=\\frac{1}{2}{a}_{1} \\\\ {q}_{2}=\\frac{1}{3}{a}_{2}+3{q}_{1} \\\\ {q}_{3}=\\frac{1}{4}{a}_{3}-2{q}_{1}+{q}_{2}\\end{aligned} \\qquad\\Longrightarrow\\qquad {\\begin{aligned}{a}_{1}=2{q}_{1} \\\\ {a}_{2}=-9{q}_{1}+3{q}_{2} \\\\ {a}_{3}=8{q}_{1}-4{q}_{2}+4{q}_{3}.\\end{aligned}$$\n\nIn this new system, the coefficients of $\\mathbf{q}_1$ correspond to the first-row entries of $R,$ the coefficients of $\\mathbf{q}_2$ correspond to the second-row entries of $R,$ and the coefficients of $\\mathbf{q}_3$ correspond to the third-row entries of $R.$ Therefore,\n\n$$\\overbrace{ [\\begin{aligned}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{aligned}] }^{\\Large A} = \\overbrace{ [\\begin{aligned}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{aligned}] }^{\\Large Q} \\overbrace{ [\\begin{aligned}2 & -9 & 8 \\\\ 0 & 3 & -4 \\\\ 0 & 0 & 4\\end{aligned}] }^{\\Large R}.$$\n\nTo see why this is, we can take the transpose of both sides of $A=QR{:}$ $$\\begin{aligned}A & =QR \\\\ {A}^{T} & =(QR)^{T} \\\\ {A}^{T} & ={R}^{T}{Q}^{T} \\\\ \\overset{{A}^{T}}{\\overset{⏞}{[\\begin{aligned}-\\,\\,\\,\\, & {a}_{1} & \\,\\,\\,\\,- \\\\ -\\,\\,\\,\\, & {a}_{2} & \\,\\,\\,\\,- \\\\ -\\,\\,\\,\\, & {a}_{3} & \\,\\,\\,\\,-\\end{aligned}]}} & =\\overset{{R}^{T}}{\\overset{⏞}{[\\begin{aligned}2 & 0 & 0 \\\\ -9 & 3 & 0 \\\\ 8 & -4 & 4\\end{aligned}]}}\\overset{{Q}^{T}}{\\overset{⏞}{[\\begin{aligned}-\\,\\,\\,\\, & {q}_{1} & \\,\\,\\,\\,- \\\\ -\\,\\,\\,\\, & {q}_{2} & \\,\\,\\,\\,- \\\\ -\\,\\,\\,\\, & {q}_{3} & \\,\\,\\,\\,-\\end{aligned}]}}\\end{aligned}$$\n\nIf we were to expand this matrix product, we would obtain our system of equations." #edb/ref 17592186045417] [17592186135098 #edb/ref 1065 5018 #edb/ref 17592186045417] [17592186135098 #edb/ref 1066 #uuid "9a6d9a3e-33d4-52e8-b8b0-98cd20590dd6" #edb/ref 17592186045417] [17592186135098 #edb/ref 1067 "Interpreting Relations Between Two Bases as Matrix Multiplication" #edb/ref 17592186045417] [17592186135099 #edb/ref 1064 "Let's now go through the QR factorization algorithm to find the factorization of the matrix\n\n$$A = [\\begin{aligned}2 & 1 \\\\ 4 & 3 \\\\ -4 & -1\\end{aligned}].$$\n\n**Step 1**. Orthogonalize the columns of $A$ to get the columns of $Q.$ Using the Gram-Schmidt process, we obtain\n\n$$\\begin{aligned}{q}_{1}=\\frac{1}{3}[\\begin{aligned}1 \\\\ 2 \\\\ -2\\end{aligned}],\\,{q}_{2}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}].\\end{aligned}$$\n\n**Step 2**. Compute $R=Q^TA.$ We get\n\n$$\\begin{aligned}R=[\\begin{aligned}6 & 3 \\\\ 0 & \\sqrt{2}\\end{aligned}].\\end{aligned}$$\n\nTherefore, the QR factorization of $A$ is\n\n$$\\overbrace{ [\\begin{aligned}2 & 1 \\\\ 4 & 3 \\\\ -4 & -1\\end{aligned}] }^{\\Large A} = \\overbrace{ [\\begin{aligned}\\frac{1}{3} & 0 \\\\ \\frac{2}{3} & \\frac{1}{\\sqrt{2}} \\\\ -\\frac{2}{3} & \\frac{1}{\\sqrt{2}}\\end{aligned}] }^{\\Large Q} \\overbrace{ [\\begin{aligned}6 & 3 \\\\ 0 & \\sqrt{2}\\end{aligned}] }^{\\Large R}.$$" #edb/ref 17592186045417] [17592186135099 #edb/ref 1065 5019 #edb/ref 17592186045417] [17592186135099 #edb/ref 1066 #uuid "c2f59e79-8a0c-543b-8af0-381e95a18a8a" #edb/ref 17592186045417] [17592186135099 #edb/ref 1067 "The QR Factorization Algorithm" #edb/ref 17592186045417]}
