/mrow></msub><mo>+</mo><msub><mi>r</mi><mrow data-mjx-texclass=\"ORD\"><mn>33</mn></mrow></msub><mo>=</mo><mn>3</mn><mo>+</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mn>4</mn><mo>=</mo><mn>5.</mn></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
