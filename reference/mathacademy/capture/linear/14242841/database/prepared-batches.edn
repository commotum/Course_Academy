e2fb" :answer-field/choices "answer-38ad1ec9-e0dc-5d85-a635-9bcc0fefb7f1"] ["answer-field-24cf66c6-628b-5c32-85e7-2bd6b460e2fb" :answer-field/choices "answer-fc8dd64e-ec20-5a0f-95d2-dcc78741a884"] ["answer-field-24cf66c6-628b-5c32-85e7-2bd6b460e2fb" :answer-field/choices "answer-bfdeda9b-e9e4-5b96-83b9-31a071005f4f"] ["answer-field-24cf66c6-628b-5c32-85e7-2bd6b460e2fb" :answer-field/choices "answer-a3a19c24-8b9c-5d7b-912a-07b3466a45bd"] ["question-6cfbc389-30d9-53d7-b8c8-e6f86312705b" :question/answer-fields "answer-field-24cf66c6-628b-5c32-85e7-2bd6b460e2fb"] [17592186133746 :knowledge-point/questions "question-6cfbc389-30d9-53d7-b8c8-e6f86312705b"] ["question-2e740a26-9734-5997-8349-4d773f862d1d" :question/id #uuid "2e740a26-9734-5997-8349-4d773f862d1d"] ["question-2e740a26-9734-5997-8349-4d773f862d1d" :question/math-academy-id "q-236692"] ["question-2e740a26-9734-5997-8349-4d773f862d1d" :question/problem "The formula for the $n$th term of an arithmetic sequence is ${a}_{n}=1-9n$ for $n\\ge 1.$ The recursive formula for this sequence is\n\n${a}_{n+1}=$\n{{field-1}},\n$\\,{a}_{1}=$\n{{field-2}},\n$\\,n\\ge 1.$"] ["question-2e740a26-9734-5997-8349-4d773f862d1d" :question/worked-solution "The recursive formula for an arithmetic sequence is as follows:\n\n$$\n{a}_{n+1}={a}_{n}+d,\\,{a}_{1}=___\\,,\\,n\\ge 1\n$$\n\nTo complete the formula, we need to work out the first term and common difference. The first two terms are\n\n$$\n\\begin{aligned}{a}_{1} & =1-9(1)=-8 \\\\ {a}_{2} & =1-9(2)=-17\\end{aligned}\n$$\n\nand the common difference is\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =-17-(-8) \\\\  & =-17+8 \\\\  & =-9.\\end{aligned}\n$$\n\nSo, the first term is ${a}_{1}=-8$ and the common difference is $d=-9.$ Therefore, the recursive formula is as follows:\n\n$$\n{a}_{n+1}={a}_{n}-9,\\,{a}_{1}=-8,\\,n\\ge 1\n$$"] ["question-2e740a26-9734-5997-8349-4d773f862d1d" :question/difficulty :question.difficulty/moderate] ["answer-field-af354a29-8f42-5155-a64c-ca4506ba75c3" :answer-field/id #uuid "af354a29-8f42-5155-a64c-ca4506ba75c3"] ["answer-1b693ecb-3453-5bef-92d1-b886000e827b" :answer/id #uuid "1b693ecb-3453-5bef-92d1-b886000e827b"] ["answer-1b693ecb-3453-5bef-92d1-b886000e827b" :answer/type :answer.type/math] ["answer-1b693ecb-3453-5bef-92d1-b886000e827b" :answer/value "a_n-9"] ["answer-field-af354a29-8f42-5155-a64c-ca4506ba75c3" :answer-field/key "field-1"] ["answer-field-af354a29-8f42-5155-a64c-ca4506ba75c3" :answer-field/type :answer-field.type/blank] ["answer-field-af354a29-8f42-5155-a64c-ca4506ba75c3" :answer-field/correct "answer-1b693ecb-3453-5bef-92d1-b886000e827b"] ["answer-field-af354a29-8f42-5155-a64c-ca4506ba75c3" :answer-field/choices "answer-1b693ecb-3453-5bef-92d1-b886000e827b"] ["answer-field-9a516b1f-f38c-5bad-b893-90895addb12b" :answer-field/id #uuid "9a516b1f-f38c-5bad-b893-90895addb12b"] ["answer-ad5300bc-3c3b-54fb-bb65-8650047ba4e2" :answer/id #uuid "ad5300bc-3c3b-54fb-bb65-8650047ba4e2"] ["answer-ad5300bc-3c3b-54fb-bb65-8650047ba4e2" :answer/type :answer.type/math] ["answer-ad5300bc-3c3b-54fb-bb65-8650047ba4e2" :answer/value "-8"] ["answer-field-9a516b1f-f38c-5bad-b893-90895addb12b" :answer-field/key "field-2"] ["answer-field-9a516b1f-f38c-5bad-b893-90895addb12b" :answer-field/type :answer-field.type/blank] ["answer-field-9a516b1f-f38c-5bad-b893-90895addb12b" :answer-field/correct "answer-ad5300bc-3c3b-54fb-bb65-8650047ba4e2"] ["answer-field-9a516b1f-f38c-5bad-b893-90895addb12b" :answer-field/choices "answer-ad5300bc-3c3b-54fb-bb65-8650047ba4e2"] ["question-2e740a26-9734-5997-8349-4d773f862d1d" :question/answer-fields "answer-field-af354a29-8f42-5155-a64c-ca4506ba75c3"] ["question-2e740a26-9734-5997-8349-4d773f862d1d" :question/answer-fields "answer-field-9a516b1f-f38c-5bad-b893-90895addb12b"] [17592186133746 :knowledge-point/questions "question-2e740a26-9734-5997-8349-4d773f862d1d"] ["question-0d952218-06b1-5f09-827d-2a6a5b13b0f6" :question/id #uuid "0d952218-06b1-5f09-827d-2a6a5b13b0f6"] ["question-0d952218-06b1-5f09-827d-2a6a5b13b0f6" :question/math-academy-id "q-236696"] ["question-0d952218-06b1-5f09-827d-2a6a5b13b0f6" :question/problem "The formula for the $n$th term of a sequence is $f(n)=1-6n$ for $n\\ge 1.$ The recursive formula for this sequence is\n\n$f(n+1)=$\n{{field-1}},\n$\\,f(1)=$\n{{field-2}},\n$\\,n\\ge 1.$"] ["question-0d952218-06b1-5f09-827d-2a6a5b13b0f6" :question/worked-solution "The recursive formula for an arithmetic sequence is as follows:\n\n$$\nf(n+1)=f(n)+d,\\,f(1)=___\\,,\\,n\\ge 1\n$$\n\nTo complete the formula, we need to work out the first term and common difference. The first two terms are\n\n$$\n\\begin{aligned}f(1) & =1-6(1)=-5 \\\\ f(2) & =1-6(2)=-11\\end{aligned}\n$$\n\nand the common difference is\n\n$$\n\\begin{aligned}d & =f(2)-f(1) \\\\  & =-11-(-5) \\\\  & =-11+5 \\\\  & =-6.\\end{aligned}\n$$\n\nSo, the first term is $f(1)=-5$ and the common difference is $d=-6.$ Therefore, the recursive formula is as follows:\n\n$$\nf(n+1)=f(n)-6,\\,f(1)=-5,\\,n\\ge 1\n$$"] ["question-0d952218-06b1-5f09-827d-2a6a5b13b0f6" :question/difficulty :question.difficulty/easy] ["answer-field-3e84a00f-0b3d-5749-8084-dabc2f5c352a" :answer-field/id #uuid "3e84a00f-0b3d-5749-8084-dabc2f5c352a"] ["answer-961ef303-57c1-5fb9-9e3e-50c8c603c21c" :answer/id #uuid "961ef303-57c1-5fb9-9e3e-50c8c603c21c"] ["answer-961ef303-57c1-5fb9-9e3e-50c8c603c21c" :answer/type :answer.type/math] ["answer-961ef303-57c1-5fb9-9e3e-50c8c603c21c" :answer/value "f(n)-6"] ["answer-field-3e84a00f-0b3d-5749-8084-dabc2f5c352a" :answer-field/key "field-1"] ["answer-field-3e84a00f-0b3d-5749-8084-dabc2f5c352a" :answer-field/type :answer-field.type/blank] ["answer-field-3e84a00f-0b3d-5749-8084-dabc2f5c352a" :answer-field/correct "answer-961ef303-57c1-5fb9-9e3e-50c8c603c21c"] ["answer-field-3e84a00f-0b3d-5749-8084-dabc2f5c352a" :answer-field/choices "answer-961ef303-57c1-5fb9-9e3e-50c8c603c21c"] ["answer-field-de285235-a8d6-5932-a9ac-01bfdef66d64" :answer-field/id #uuid "de285235-a8d6-5932-a9ac-01bfdef66d64"] ["answer-6d4d82ae-57da-5bf4-8406-d67d911d1420" :answer/id #uuid "6d4d82ae-57da-5bf4-8406-d67d911d1420"] ["answer-6d4d82ae-57da-5bf4-8406-d67d911d1420" :answer/type :answer.type/math] ["answer-6d4d82ae-57da-5bf4-8406-d67d911d1420" :answer/value "-5"] ["answer-field-de285235-a8d6-5932-a9ac-01bfdef66d64" :answer-field/key "field-2"] ["answer-field-de285235-a8d6-5932-a9ac-01bfdef66d64" :answer-field/type :answer-field.type/blank] ["answer-field-de285235-a8d6-5932-a9ac-01bfdef66d64" :answer-field/correct "answer-6d4d82ae-57da-5bf4-8406-d67d911d1420"] ["answer-field-de285235-a8d6-5932-a9ac-01bfdef66d64" :answer-field/choices "answer-6d4d82ae-57da-5bf4-8406-d67d911d1420"] ["question-0d952218-06b1-5f09-827d-2a6a5b13b0f6" :question/answer-fields "answer-field-3e84a00f-0b3d-5749-8084-dabc2f5c352a"] ["question-0d952218-06b1-5f09-827d-2a6a5b13b0f6" :question/answer-fields "answer-field-de285235-a8d6-5932-a9ac-01bfdef66d64"] [17592186133747 :knowledge-point/questions "question-0d952218-06b1-5f09-827d-2a6a5b13b0f6"] ["question-6500f3df-ea0f-5675-b52f-b066bf2e3cba" :question/id #uuid "6500f3df-ea0f-5675-b52f-b066bf2e3cba"] ["question-6500f3df-ea0f-5675-b52f-b066bf2e3cba" :question/math-academy-id "q-108596"] ["question-6500f3df-ea0f-5675-b52f-b066bf2e3cba" :question/problem "The formula for the $n$th term of an arithmetic sequence is $f(n)=5n-4$ for $n\\ge 1.$  What is the recursive formula for this sequence?"] ["question-6500f3df-ea0f-5675-b52f-b066bf2e3cba" :question/worked-solution "The recursive formula for an arithmetic sequence (in function notation) is as follows:\n\n$$\nf(n+1)=f(n)+d,\\,f(1)=___\\,,\\,n\\ge 1\n$$\n\nTo complete the formula, we need to work out the first term and common difference. The first two terms are\n\n$$\n\\begin{aligned}f(1) & =5(1)-4=1 \\\\ f(2) & =5(2)-4=6\\end{aligned}\n$$\n\nand the common difference is\n\n$$\n\\begin{aligned}d & =f(2)-f(1) \\\\  & =6-1 \\\\  & =5.\\end{aligned}\n$$\n\nSo, the first term is $f(1)=1$ and the common difference is $d=5.$ Therefore, the recursive formula is as follows:\n\n$$\nf(n+1)=f(n)+5,\\,f(1)=1,\\,n\\ge 1\n$$"] ["question-6500f3df-ea0f-5675-b52f-b066bf2e3cba" :question/difficulty :question.difficulty/easy] ["answer-field-326e30b4-a294-51af-8098-84eba9d55ad1" :answer-field/id #uuid "326e30b4-a294-51af-8098-84eba9d55ad1"] ["answer-bd5ec8e0-0e47-567a-a150-53a79384d822" :answer/id #uuid "bd5ec8e0-0e47-567a-a150-53a79384d822"] ["answer-bd5ec8e0-0e47-567a-a150-53a79384d822" :answer/type :answer.type/math] ["answer-bd5ec8e0-0e47-567a-a150-53a79384d822" :answer/value "f(n+1)=f(n)+2,\\,f(1)=5,\\,n\\ge 1"] ["answer-abb82d56-6841-5ed4-ade0-8cb4e9939600" :answer/id #uuid "abb82d56-6841-5ed4-ade0-8cb4e9939600"] ["answer-abb82d56-6841-5ed4-ade0-8cb4e9939600" :answer/type :answer.type/math] ["answer-abb82d56-6841-5ed4-ade0-8cb4e9939600" :answer/value "f(n+1)=f(n)+5,\\,f(1)=1,\\,n\\ge 1"] ["answer-c17ca360-e415-5ff9-aa8b-4cea7e81dbe6" :answer/id #uuid "c17ca360-e415-5ff9-aa8b-4cea7e81dbe6"] ["answer-c17ca360-e415-5ff9-aa8b-4cea7e81dbe6" :answer/type :answer.type/math] ["answer-c17ca360-e415-5ff9-aa8b-4cea7e81dbe6" :answer/value "f(n+1)=f(n)+7,\\,f(1)=1,\\,n\\ge 1"] ["answer-ca03916a-519d-5cfc-addd-8ce2d67ff1ba" :answer/id #uuid "ca03916a-519d-5cfc-addd-8ce2d67ff1ba"] ["answer-ca03916a-519d-5cfc-addd-8ce2d67ff1ba" :answer/type :answer.type/math] ["answer-ca03916a-519d-5cfc-addd-8ce2d67ff1ba" :answer/value "f(n+1)=f(n)+9,\\,f(1)=1,\\,n\\ge 1"] ["answer-39307755-ded1-5ea1-835f-97505b50d059" :answer/id #uuid "39307755-ded1-5ea1-835f-97505b50d059"] ["answer-39307755-ded1-5ea1-835f-97505b50d059" :answer/type :answer.type/math] ["answer-39307755-ded1-5ea1-835f-97505b50d059" :answer/value "f(n+1)=f(n)-5,\\,f(1)=1,\\,n\\ge 1"] ["answer-field-326e30b4-a294-51af-8098-84eba9d55ad1" :answer-field/key "selection"] ["answer-field-326e30b4-a294-51af-8098-84eba9d55ad1" :answer-field/type :answer-field.type/radio] ["answer-field-326e30b4-a294-51af-8098-84eba9d55ad1" :answer-field/correct "answer-abb82d56-6841-5ed4-ade0-8cb4e9939600"] ["answer-field-326e30b4-a294-51af-8098-84eba9d55ad1" :answer-field/choices "answer-bd5ec8e0-0e47-567a-a150-53a79384d822"] ["answer-field-326e30b4-a294-51af-8098-84eba9d55ad1" :answer-field/choices "answer-abb82d56-6841-5ed4-ade0-8cb4e9939600"] ["answer-field-326e30b4-a294-51af-8098-84eba9d55ad1" :answer-field/choices "answer-c17ca360-e415-5ff9-aa8b-4cea7e81dbe6"] ["answer-field-326e30b4-a294-51af-8098-84eba9d55ad1" :answer-field/choices "answer-ca03916a-519d-5cfc-addd-8ce2d67ff1ba"] ["answer-field-326e30b4-a294-51af-8098-84eba9d55ad1" :answer-field/choices "answer-39307755-ded1-5ea1-835f-97505b50d059"] ["question-6500f3df-ea0f-5675-b52f-b066bf2e3cba" :question/answer-fields "answer-field-326e30b4-a294-51af-8098-84eba9d55ad1"] [17592186133747 :knowledge-point/questions "question-6500f3df-ea0f-5675-b52f-b066bf2e3cba"] ["question-9e6b4405-b1f3-59b3-b412-8d0c0e5d7557" :question/id #uuid "9e6b4405-b1f3-59b3-b412-8d0c0e5d7557"] ["question-9e6b4405-b1f3-59b3-b412-8d0c0e5d7557" :question/math-academy-id "q-236728"] ["question-9e6b4405-b1f3-59b3-b412-8d0c0e5d7557" :question/problem "Consider the following arithmetic sequence:\n\n$$\n{a}_{n+1}={a}_{n}-8,\\,\\,{a}_{1}=2,\\,\\,n\\ge 1\n$$\n\nThe explicit formula for the $n$th term is\n\n${a}_{n}=$\n{{field-1}}$,\\,n\\ge 1.$"] ["question-9e6b4405-b1f3-59b3-b412-8d0c0e5d7557" :question/worked-solution "The explicit formula for the $n$th term of an arithmetic sequence is\n\n$$\n{a}_{n}={a}_{1}+(n-1)d,\\,n\\ge 1,\n$$\n\nso we need to determine the first term ${a}_{1}$ and the common difference $d.$\n\nWe are given that the first term is ${a}_{1}=2,$ and we can use the recursive rule to compute the second term, as follows:\n\n$$\n\\begin{aligned}{a}_{2} & ={a}_{1}-8 \\\\  & =2-8 \\\\  & =-6\\end{aligned}\n$$\n\nUsing the first and second terms, we can compute the common difference:\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =-6-2 \\\\  & =-8\\end{aligned}\n$$\n\nNow we substitute ${a}_{1}=2$ and $d=-8$ into the formula for the $n$th term:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =2+(n-1)(-8) \\\\  & =2-8n+8 \\\\  & =10-8n\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is\n\n$$\n{a}_{n}=10-8n,\\,n\\ge 1.\n$$"] ["question-9e6b4405-b1f3-59b3-b412-8d0c0e5d7557" :question/difficulty :question.difficulty/easy] ["answer-field-3ed487f3-ddab-5cec-965c-1188a0a71c47" :answer-field/id #uuid "3ed487f3-ddab-5cec-965c-1188a0a71c47"] ["answer-1772ef23-3c6a-5a9b-8fd6-67e54fcb0ef0" :answer/id #uuid "1772ef23-3c6a-5a9b-8fd6-67e54fcb0ef0"] ["answer-1772ef23-3c6a-5a9b-8fd6-67e54fcb0ef0" :answer/type :answer.type/math] ["answer-1772ef23-3c6a-5a9b-8fd6-67e54fcb0ef0" :answer/value "10-8n"] ["answer-field-3ed487f3-ddab-5cec-965c-1188a0a71c47" :answer-field/key "field-1"] ["answer-field-3ed487f3-ddab-5cec-965c-1188a0a71c47" :answer-field/type :answer-field.type/blank] ["answer-field-3ed487f3-ddab-5cec-965c-1188a0a71c47" :answer-field/correct "answer-1772ef23-3c6a-5a9b-8fd6-67e54fcb0ef0"] ["answer-field-3ed487f3-ddab-5cec-965c-1188a0a71c47" :answer-field/choices "answer-1772ef23-3c6a-5a9b-8fd6-67e54fcb0ef0"] ["question-9e6b4405-b1f3-59b3-b412-8d0c0e5d7557" :question/answer-fields "answer-field-3ed487f3-ddab-5cec-965c-1188a0a71c47"] [17592186133748 :knowledge-point/questions "question-9e6b4405-b1f3-59b3-b412-8d0c0e5d7557"] ["question-424dd539-6c70-5877-8bbc-fc51ba75e083" :question/id #uuid "424dd539-6c70-5877-8bbc-fc51ba75e083"] ["question-424dd539-6c70-5877-8bbc-fc51ba75e083" :question/math-academy-id "q-45058"] ["question-424dd539-6c70-5877-8bbc-fc51ba75e083" :question/problem "What is the explicit formula for the $n$th term of the arithmetic sequence\n\n$$\n{a}_{n+1}={a}_{n}-3,\\,\\,{a}_{1}=7,\\,\\,n\\ge 1?\n$$"] ["question-424dd539-6c70-5877-8bbc-fc51ba75e083" :question/worked-solution "The explicit formula for the $n$th term of an arithmetic sequence is\n\n$$\n{a}_{n}={a}_{1}+(n-1)d,\\,n\\ge 1,\n$$\n\nso we need to determine the first term ${a}_{1}$ and the common difference $d.$\n\nWe are given that the first term is ${a}_{1}=7,$ and we can use the recursive rule to compute the second term, as follows:\n\n$$\n\\begin{aligned}{a}_{2} & ={a}_{1}-3 \\\\  & =7-3 \\\\  & =4\\end{aligned}\n$$\n\nUsing the first and second terms, we can compute the common difference:\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =4-7 \\\\  & =-3\\end{aligned}\n$$\n\nNow we substitute ${a}_{1}=7$ and $d=-3$ into the formula for the $n$th term:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =7+(n-1)(-3) \\\\  & =7-3n+3 \\\\  & =-3n+10\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is\n\n$$\n{a}_{n}=-3n+10,\\,n\\ge 1.\n$$"] ["question-424dd539-6c70-5877-8bbc-fc51ba75e083" :question/difficulty :question.difficulty/easy] ["answer-field-d125b15d-4f81-5935-b076-db66967f564d" :answer-field/id #uuid "d125b15d-4f81-5935-b076-db66967f564d"] ["answer-09f826f6-dee2-5750-ba35-f3e8c0ed13a6" :answer/id #uuid "09f826f6-dee2-5750-ba35-f3e8c0ed13a6"] ["answer-09f826f6-dee2-5750-ba35-f3e8c0ed13a6" :answer/type :answer.type/math] ["answer-09f826f6-dee2-5750-ba35-f3e8c0ed13a6" :answer/value "{a}_{n}=-3n+10,\\,n\\ge 1"] ["answer-a044dcf5-a552-598d-b5ec-509dc7df9fb4" :answer/id #uuid "a044dcf5-a552-598d-b5ec-509dc7df9fb4"] ["answer-a044dcf5-a552-598d-b5ec-509dc7df9fb4" :answer/type :answer.type/math] ["answer-a044dcf5-a552-598d-b5ec-509dc7df9fb4" :answer/value "{a}_{n}=-3n+4,\\,n\\ge 1"] ["answer-ec085fc8-84db-5382-8e01-516fb3b277e2" :answer/id #uuid "ec085fc8-84db-5382-8e01-516fb3b277e2"] ["answer-ec085fc8-84db-5382-8e01-516fb3b277e2" :answer/type :answer.type/math] ["answer-ec085fc8-84db-5382-8e01-516fb3b277e2" :answer/value "{a}_{n}=-3n-4,\\,n\\ge 1"] ["answer-1a38053c-c466-55f4-ae96-9f5bf2daa389" :answer/id #uuid "1a38053c-c466-55f4-ae96-9f5bf2daa389"] ["answer-1a38053c-c466-55f4-ae96-9f5bf2daa389" :answer/type :answer.type/math] ["answer-1a38053c-c466-55f4-ae96-9f5bf2daa389" :answer/value "{a}_{n}=3n+10,\\,n\\ge 1"] ["answer-f20c8871-0fb4-5a47-8d79-ec05f64afe3f" :answer/id #uuid "f20c8871-0fb4-5a47-8d79-ec05f64afe3f"] ["answer-f20c8871-0fb4-5a47-8d79-ec05f64afe3f" :answer/type :answer.type/math] ["answer-f20c8871-0fb4-5a47-8d79-ec05f64afe3f" :answer/value "{a}_{n}=3n+4,\\,n\\ge 1"] ["answer-field-d125b15d-4f81-5935-b076-db66967f564d" :answer-field/key "selection"] ["answer-field-d125b15d-4f81-5935-b076-db66967f564d" :answer-field/type :answer-field.type/radio] ["answer-field-d125b15d-4f81-5935-b076-db66967f564d" :answer-field/correct "answer-09f826f6-dee2-5750-ba35-f3e8c0ed13a6"] ["answer-field-d125b15d-4f81-5935-b076-db66967f564d" :answer-field/choices "answer-09f826f6-dee2-5750-ba35-f3e8c0ed13a6"] ["answer-field-d125b15d-4f81-5935-b076-db66967f564d" :answer-field/choices "answer-a044dcf5-a552-598d-b5ec-509dc7df9fb4"] ["answer-field-d125b15d-4f81-5935-b076-db66967f564d" :answer-field/choices "answer-ec085fc8-84db-5382-8e01-516fb3b277e2"] ["answer-field-d125b15d-4f81-5935-b076-db66967f564d" :answer-field/choices "answer-1a38053c-c466-55f4-ae96-9f5bf2daa389"] ["answer-field-d125b15d-4f81-5935-b076-db66967f564d" :answer-field/choices "answer-f20c8871-0fb4-5a47-8d79-ec05f64afe3f"] ["question-424dd539-6c70-5877-8bbc-fc51ba75e083" :question/answer-fields "answer-field-d125b15d-4f81-5935-b076-db66967f564d"] [17592186133748 :knowledge-point/questions "question-424dd539-6c70-5877-8bbc-fc51ba75e083"] ["question-df1d75ef-4d29-5e1f-bd95-e67ad6f7bd69" :question/id #uuid "df1d75ef-4d29-5e1f-bd95-e67ad6f7bd69"] ["question-df1d75ef-4d29-5e1f-bd95-e67ad6f7bd69" :question/math-academy-id "q-45060"] ["question-df1d75ef-4d29-5e1f-bd95-e67ad6f7bd69" :question/problem "What is the explicit formula for the $n$th term of the sequence\n\n$$\nf(n+1)=f(n)-7,\\,\\,f(1)=-1,\\,\\,n\\ge 1?\n$$"] ["question-df1d75ef-4d29-5e1f-bd95-e67ad6f7bd69" :question/worked-solution "The explicit formula for the $n$th term of an arithmetic sequence (in function notation) is\n\n$$\nf(n)=f(1)+(n-1)d,\\,n\\ge 1,\n$$\n\nso we need to determine the first term $f(1)$ and the common difference $d.$\n\nWe are given that the first term is $f(1)=-1,$ and we can use the recursive rule to compute the second term, as follows:\n\n$$\n\\begin{aligned}f(2) & =f(1)-7 \\\\  & =-1-7 \\\\  & =-8\\end{aligned}\n$$\n\nUsing the first and second terms, we can compute the common difference:\n\n$$\n\\begin{aligned}d & =f(2)-f(1) \\\\  & =-8-(-1) \\\\  & =-7\\end{aligned}\n$$\n\nNow, we substitute $f(1)=-1$ and $d=-7$ into the formula for the $n$th term:\n\n$$\n\\begin{aligned}f(n) & =f(1)+(n-1)d \\\\  & =-1+(n-1)(-7) \\\\  & =-1-7n+7 \\\\  & =-7n+6\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is\n\n$$\nf(n)=-7n+6,\\,n\\ge 1.\n$$"] ["question-df1d75ef-4d29-5e1f-bd95-e67ad6f7bd69" :question/difficulty :question.difficulty/easy] ["answer-field-9d09d176-3b75-5790-9c62-35e5c3af73fc" :answer-field/id #uuid "9d09d176-3b75-5790-9c62-35e5c3af73fc"] ["answer-39bc481f-ef54-57c3-9dda-a91729d168ca" :answer/id #uuid "39bc481f-ef54-57c3-9dda-a91729d168ca"] ["answer-39bc481f-ef54-57c3-9dda-a91729d168ca" :answer/type :answer.type/math] ["answer-39bc481f-ef54-57c3-9dda-a91729d168ca" :answer/value "f(n)=-7n+6,\\,n\\ge 1"] ["answer-c45e815f-5034-57e8-afe1-5727800c9003" :answer/id #uuid "c45e815f-5034-57e8-afe1-5727800c9003"] ["answer-c45e815f-5034-57e8-afe1-5727800c9003" :answer/type :answer.type/math] ["answer-c45e815f-5034-57e8-afe1-5727800c9003" :answer/value "f(n)=-7n+8,\\,n\\ge 1"] ["answer-cce5d326-1025-5461-8eec-5ca2239b2c4e" :answer/id #uuid "cce5d326-1025-5461-8eec-5ca2239b2c4e"] ["answer-cce5d326-1025-5461-8eec-5ca2239b2c4e" :answer/type :answer.type/math] ["answer-cce5d326-1025-5461-8eec-5ca2239b2c4e" :answer/value "f(n)=-7n-6,\\,n\\ge 1"] ["answer-5db4a106-72b9-51b7-af86-550a159c81be" :answer/id #uuid "5db4a106-72b9-51b7-af86-550a159c81be"] ["answer-5db4a106-72b9-51b7-af86-550a159c81be" :answer/type :answer.type/math] ["answer-5db4a106-72b9-51b7-af86-550a159c81be" :answer/value "f(n)=-7n-7,\\,n\\ge 1"] ["answer-09f19810-1419-5e88-b9aa-920ccb894242" :answer/id #uuid "09f19810-1419-5e88-b9aa-920ccb894242"] ["answer-09f19810-1419-5e88-b9aa-920ccb894242" :answer/type :answer.type/math] ["answer-09f19810-1419-5e88-b9aa-920ccb894242" :answer/value "f(n)=-7n-8,\\,n\\ge 1"] ["answer-field-9d09d176-3b75-5790-9c62-35e5c3af73fc" :answer-field/key "selection"] ["answer-field-9d09d176-3b75-5790-9c62-35e5c3af73fc" :answer-field/type :answer-field.type/radio] ["answer-field-9d09d176-3b75-5790-9c62-35e5c3af73fc" :answer-field/correct "answer-39bc481f-ef54-57c3-9dda-a91729d168ca"] ["answer-field-9d09d176-3b75-5790-9c62-35e5c3af73fc" :answer-field/choices "answer-39bc481f-ef54-57c3-9dda-a91729d168ca"] ["answer-field-9d09d176-3b75-5790-9c62-35e5c3af73fc" :answer-field/choices "answer-c45e815f-5034-57e8-afe1-5727800c9003"] ["answer-field-9d09d176-3b75-5790-9c62-35e5c3af73fc" :answer-field/choices "answer-cce5d326-1025-5461-8eec-5ca2239b2c4e"] ["answer-field-9d09d176-3b75-5790-9c62-35e5c3af73fc" :answer-field/choices "answer-5db4a106-72b9-51b7-af86-550a159c81be"] ["answer-field-9d09d176-3b75-5790-9c62-35e5c3af73fc" :answer-field/choices "answer-09f19810-1419-5e88-b9aa-920ccb894242"] ["question-df1d75ef-4d29-5e1f-bd95-e67ad6f7bd69" :question/answer-fields "answer-field-9d09d176-3b75-5790-9c62-35e5c3af73fc"] [17592186133749 :knowledge-point/questions "question-df1d75ef-4d29-5e1f-bd95-e67ad6f7bd69"] ["question-0d53c105-6357-5aa5-b9db-2ac9c9ee796f" :question/id #uuid "0d53c105-6357-5aa5-b9db-2ac9c9ee796f"] ["question-0d53c105-6357-5aa5-b9db-2ac9c9ee796f" :question/math-academy-id "q-45061"] ["question-0d53c105-6357-5aa5-b9db-2ac9c9ee796f" :question/problem "What is the explicit formula for the $n$th term of the sequence\n\n$$\nf(n+1)=f(n)+5,\\,\\,f(1)=4,\\,\\,n\\ge 1?\n$$"] ["question-0d53c105-6357-5aa5-b9db-2ac9c9ee796f" :question/worked-solution "The explicit formula for the $n$th term of an arithmetic sequence (in function notation) is\n\n$$\nf(n)=f(1)+(n-1)d,\\,n\\ge 1,\n$$\n\nso we need to determine the first term $f(1)$ and the common difference $d.$\n\nWe are given that the first term is $f(1)=4,$ and we can use the recursive rule to compute the second term, as follows:\n\n$$\n\\begin{aligned}f(2) & =f(1)+5 \\\\  & =4+5 \\\\  & =9\\end{aligned}\n$$\n\nUsing the first and second terms, we can compute the common difference:\n\n$$\n\\begin{aligned}d & =f(2)-f(1) \\\\  & =9-4 \\\\  & =5\\end{aligned}\n$$\n\nNow, we substitute $f(1)=4$ and $d=5$ into the formula for the $n$th term:\n\n$$\n\\begin{aligned}f(n) & =f(1)+(n-1)d \\\\  & =4+(n-1)(5) \\\\  & =4+5n-5 \\\\  & =5n-1\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is\n\n$$\nf(n)=5n-1,\\,n\\ge 1.\n$$"] ["question-0d53c105-6357-5aa5-b9db-2ac9c9ee796f" :question/difficulty :question.difficulty/easy] ["answer-field-aaae199b-8dec-5212-ad48-bb1689431b89" :answer-field/id #uuid "aaae199b-8dec-5212-ad48-bb1689431b89"] ["answer-99585a27-0917-5e4a-9abf-f795aea875e9" :answer/id #uuid "99585a27-0917-5e4a-9abf-f795aea875e9"] ["answer-99585a27-0917-5e4a-9abf-f795aea875e9" :answer/type :answer.type/math] ["answer-99585a27-0917-5e4a-9abf-f795aea875e9" :answer/value "f(n)=5n+1,\\,n\\ge 1"] ["answer-0174ffc1-4d64-59ff-b5cc-0033753339cb" :answer/id #uuid "0174ffc1-4d64-59ff-b5cc-0033753339cb"] ["answer-0174ffc1-4d64-59ff-b5cc-0033753339cb" :answer/type :answer.type/math] ["answer-0174ffc1-4d64-59ff-b5cc-0033753339cb" :answer/value "f(n)=5n+9,\\,n\\ge 1"] ["answer-8534916c-9ccc-5795-9ab2-54c6ae8c9738" :answer/id #uuid "8534916c-9ccc-5795-9ab2-54c6ae8c9738"] ["answer-8534916c-9ccc-5795-9ab2-54c6ae8c9738" :answer/type :answer.type/math] ["answer-8534916c-9ccc-5795-9ab2-54c6ae8c9738" :answer/value "f(n)=5n-1,\\,n\\ge 1"] ["answer-ba774170-a3c2-5c43-a2a7-3f593d4924f5" :answer/id #uuid "ba774170-a3c2-5c43-a2a7-3f593d4924f5"] ["answer-ba774170-a3c2-5c43-a2a7-3f593d4924f5" :answer/type :answer.type/math] ["answer-ba774170-a3c2-5c43-a2a7-3f593d4924f5" :answer/value "f(n)=5n-6,\\,n\\ge 1"] ["answer-ba843649-0f55-51c4-b499-3741d60d7720" :answer/id #uuid "ba843649-0f55-51c4-b499-3741d60d7720"] ["answer-ba843649-0f55-51c4-b499-3741d60d7720" :answer/type :answer.type/math] ["answer-ba843649-0f55-51c4-b499-3741d60d7720" :answer/value "f(n)=5n-9,\\,n\\ge 1"] ["answer-field-aaae199b-8dec-5212-ad48-bb1689431b89" :answer-field/key "selection"] ["answer-field-aaae199b-8dec-5212-ad48-bb1689431b89" :answer-field/type :answer-field.type/radio] ["answer-field-aaae199b-8dec-5212-ad48-bb1689431b89" :answer-field/correct "answer-8534916c-9ccc-5795-9ab2-54c6ae8c9738"] ["answer-field-aaae199b-8dec-5212-ad48-bb1689431b89" :answer-field/choices "answer-99585a27-0917-5e4a-9abf-f795aea875e9"] ["answer-field-aaae199b-8dec-5212-ad48-bb1689431b89" :answer-field/choices "answer-0174ffc1-4d64-59ff-b5cc-0033753339cb"] ["answer-field-aaae199b-8dec-5212-ad48-bb1689431b89" :answer-field/choices "answer-8534916c-9ccc-5795-9ab2-54c6ae8c9738"] ["answer-field-aaae199b-8dec-5212-ad48-bb1689431b89" :answer-field/choices "answer-ba774170-a3c2-5c43-a2a7-3f593d4924f5"] ["answer-field-aaae199b-8dec-5212-ad48-bb1689431b89" :answer-field/choices "answer-ba843649-0f55-51c4-b499-3741d60d7720"] ["question-0d53c105-6357-5aa5-b9db-2ac9c9ee796f" :question/answer-fields "answer-field-aaae199b-8dec-5212-ad48-bb1689431b89"] [17592186133749 :knowledge-point/questions "question-0d53c105-6357-5aa5-b9db-2ac9c9ee796f"] [17592186135191 :tutorial/content "The explicit formula for the $n$th term of an arithmetic sequence is\n\n$$\na_n = a_1 + (n-1)d, \\quad n \\geq 1.\n$$\n\nEvery arithmetic sequence can also be written using the following recursive formula:\n\n![](images/a2/a2d28772cb4cb6078d2fccdca054ec1c2dccf27a5ea0b5972b9ac174eaad671f.svg)\n\nFor example, suppose that we're given the following explicit formula for an arithmetic sequence:\n\n$$\na_n =2n+6, \\quad n\\geq 1\n$$\n\nTo convert to a recursive formula, we just need to work out the first term and common difference. The first two terms are\n\n$$\n\\begin{aligned}{a}_{1} & =2(1)+6=8 \\\\ {a}_{2} & =2(2)+6=10,\\end{aligned}\n$$\n\nand the common difference is\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =10-8 \\\\  & =2.\\end{aligned}\n$$\n\nSo, the first term is $a_1={\\color{blue}8}$ and the common difference is $d={\\color{red}2}.$ Therefore, the recursive formula is as follows:\n\n$$\na_{n+1} = a_n + {\\color{red}2}, \\quad a_1 = {\\color{blue}8}, \\quad n \\geq 1\n$$"] [17592186135192 :tutorial/content "It's often more useful to translate from the recursive formula to an explicit one. So how do we find the explicit formula for the arithmetic sequence defined recursively as\n\n$$\na_{n+1} = a_n + {\\color{red}1},\\, \\quad a_1 = {\\color{blue}6},\\, \\quad n\\geq 1?\n$$\n\nThe explicit formula is\n\n$$\na_n = a_1 + (n-1)d, \\quad n \\geq 1,\n$$\n\nso we just need to determine the first term $a_1$ and the common difference $d.$\n\nWe are given that the first term is $a_1={\\color{blue}6},$ and we can use the recursive rule to compute the second term, as follows:\n\n$$\n\\begin{aligned}{a}_{2} & ={a}_{1}+1 \\\\  & =6+1 \\\\  & =7\\end{aligned}\n$$\n\nUsing the first and second terms, we can compute the common difference:\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =7-6 \\\\  & =1\\end{aligned}\n$$\n\nNow, we substitute $a_1 = {\\color{blue}6}$ and $d={\\color{red}1}$ into the formula for the $n$th term:\n\n$$\n\\eqalign{\na_n&= a_{1}+(n-1)d \\[3pt]\n&= {\\color{blue}6} + (n - 1)({\\color{red}1}) \\[3pt]\n& =6 + n-1\\[3pt]\n&=n+5\n}\n$$\n\nTherefore, the formula for the $n$th term is\n\n$$\na_n=n+5, \\quad n \\geq 1.\n$$"] [17592186134049 :activity/expected-seconds 780.0]] "retractions" [[17592186133531 :question/problem "The formula for the $n$th term of an arithmetic sequence is $a_n = 1-2n$ for $n\\geq 1$. What is the recursive formula for this sequence?"] [17592186133531 :question/worked-solution "The recursive formula for an arithmetic sequence is as follows:\n\n$$\na_{n+1} = a_n + d, \\qquad a_1 = \\_\\_\\_ \\,, \\qquad n \\geq 1\n$$\n\nTo complete the formula, we need to work out the first term and common difference. The first two terms are\n\n$$\n\\begin{aligned}\na_{1} &= 1 - 2(1) =-1 \\\\\na_{2} &= 1 - 2(2) =-3\n\\end{aligned}\n$$\n\nand the common difference is\n\n$$\n\\begin{aligned}\nd &= a_{2} - a_{1} \\\\\n&=-3 - (-1) \\\\\n&=-3 + 1 \\\\\n&=-2\n\\end{aligned}\n$$\n\nSo, the first term is\n\n$$\na_1={\\color{blue}-1}\n$$\n\nand the common difference is\n\n$$\nd={\\color{red}-2}\n$$\n\nTherefore, the recursive formula is as follows:\n\n$$\na_{n+1}=a_n{\\color{red}-2}, \\qquad a_1={\\color{blue}-1}, \\qquad n\\geq1\n$$"] [17592186133532 :question/problem "The formula for the $n$th term of an arithmetic sequence is $f(n) = 3n-11$ for $n\\geq 1$. What is the recursive formula for this sequence?"] [17592186133532 :question/worked-solution "The recursive formula for an arithmetic sequence is as follows:\n\n$$\nf(n+1) = f(n) + d, \\qquad f(1) = \\_\\_\\_ \\,, \\qquad n \\geq 1\n$$\n\nTo complete the formula, we need to work out the first term and common difference. The first two terms are\n\n$$\n\\begin{aligned}\nf(1) &= 3(1) - 11 =-8 \\\\\nf(2) &= 3(2) - 11 =-5\n\\end{aligned}\n$$\n\nand the common difference is\n\n$$\n\\begin{aligned}\nd &= f(2) - f(1) \\\\\n&=-5 - (-8) \\\\\n&= 3\n\\end{aligned}\n$$\n\nSo, the first term is\n\n$$\nf(1)={\\color{blue}-8}\n$$\n\nand the common difference is\n\n$$\nd={\\color{red}3}\n$$\n\nTherefore, the recursive formula is as follows:\n\n$$\nf(n+1) = f(n) + {\\color{red}3}, \\qquad f(1) = {\\color{blue}-8}, \\qquad n \\geq 1\n$$"] [17592186133533 :question/problem "What is the explicit formula for the $n$th term of the arithmetic sequence\n$a_{n+1} = a_n + 3,\\, \\qquad a_1 = -1,\\, \\qquad n\\geq 1$?"] [17592186133533 :question/worked-solution "The explicit formula for the $n$th term of an arithmetic sequence is\n\n$$\na_n = a_1 + (n-1)d, \\quad n \\geq 1\n$$\n\nso we need to determine the first term $a_1$ and the common difference $d$.\n\nWe are given that the first term is\n\n$$\na_1 = {\\color{blue}-1}\n$$\n\nand we can use the recursive rule to compute the second term, as follows:\n\n$$\n\\begin{aligned}\na_{2} &= a_{1} + 3 \\\\\n&=-1 + 3 \\\\\n&= 2\n\\end{aligned}\n$$\n\nUsing the first and second terms, we can compute the common difference:\n\n$$\n\\begin{aligned}\nd &= a_{2} - a_{1} \\\\\n&= 2 - (-1) \\\\\n&= 3\n\\end{aligned}\n$$\n\nNow we substitute\n\n$$\na_1 = {\\color{blue}-1}\n$$\n\nand\n\n$$\nd={\\color{red}3}\n$$\n\ninto the formula for the $n$th term:\n\n$$\n\\begin{aligned} a_n &= a_1+(n-1)d \\\\[5pt] &= {\\color{blue}-1} + (n - 1)({\\color{red}3}) \\\\[5pt] & =-1 + 3n - 3 \\\\[5pt] &=3n - 4 \\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is\n\n$$\na_n=3n - 4, \\qquad n \\geq 1\n$$"] [17592186133534 :question/problem "What is the explicit formula for the $n$th term of the sequence\n$f(n+1) = f(n) - 5,\\, \\qquad f(1) = 3,\\, \\qquad n\\geq 1$?"] [17592186133534 :question/worked-solution "The explicit formula for the $n$th term of an arithmetic sequence (in function notation) is\n\n$$\nf(n) = f(1) + (n-1)d, \\quad n \\geq 1\n$$\n\nso we need to determine the first term $f(1)$ and the common difference $d$.\n\nWe are given that the first term is\n\n$$\nf(1)={\\color{blue}3}\n$$\n\nand we can use the recursive rule to compute the second term, as follows:\n\n$$\n\\begin{aligned}\nf(2) &= f(1) - 5 \\\\\n&= 3 - 5 \\\\\n&=-2\n\\end{aligned}\n$$\n\nUsing the first and second terms, we can compute the common difference:\n\n$$\n\\begin{aligned}\nd &= f(2) - f(1) \\\\\n&=-2 - 3 \\\\\n&=-5\n\\end{aligned}\n$$\n\nNow we substitute\n\n$$\nf(1) = {\\color{blue}3}\n$$\n\nand\n\n$$\nd={\\color{red}-5}\n$$\n\ninto the formula for the $n$th term:\n\n$$\n\\begin{aligned} f(n)&= f(1)+(n-1)d \\\\[5pt] &= {\\color{blue}3} + (n - 1)({\\color{red}-5}) \\\\[5pt] & =3 - 5n + 5 \\\\[5pt] &=8 - 5n \\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is\n\n$$\nf(n)=8 - 5n, \\qquad n \\geq 1\n$$"] [17592186135191 :tutorial/content "The explicit formula for the $n$th term of an arithmetic sequence is\n\n$$\na_n = a_1 + (n-1)d, \\quad n \\geq 1\n$$\n\nEvery arithmetic sequence can also be written using the following recursive formula:\n\n$$\na\n$$\n\nFor example, suppose that we're given the following explicit formula for an arithmetic sequence:\n\n$$\na_n =2n+6, \\quad n\\geq 1\n$$\n\nTo convert to a recursive formula, we just need to work out the first term and common difference. The first two terms are\n\n$$\n\\begin{aligned}\na_{1} &= 2(1) + 6 = 8 \\\\\na_{2} &= 2(2) + 6 = 10\n\\end{aligned}\n$$\n\nand the common difference is\n\n$$\n\\begin{aligned}\nd &= a_{2} - a_{1} \\\\\n&= 10 - 8 \\\\\n&= 2\n\\end{aligned}\n$$\n\nSo, the first term is\n\n$$\na_1={\\color{blue}8}\n$$\n\nand the common difference is\n\n$$\nd={\\color{red}2}\n$$\n\nTherefore, the recursive formula is as follows:\n\n$$\na_{n+1} = a_n + {\\color{red}2}, \\quad a_1 = {\\color{blue}8}, \\quad n \\geq 1\n$$"] [17592186135192 :tutorial/content "It's often more useful to translate from the recursive formula to an explicit one. So how do we find the explicit formula for the arithmetic sequence defined recursively as\n\n$$\na_{n+1} = a_n + {\\color{red}1},\\, \\quad a_1 = {\\color{blue}6},\\, \\quad n\\geq 1\n$$\n\nThe explicit formula is\n\n$$\na_n = a_1 + (n-1)d, \\quad n \\geq 1\n$$\n\nso we just need to determine the first term $a_1$ and the common difference $d$.\n\nWe are given that the first term is\n\n$$\na_1={\\color{blue}6}\n$$\n\nand we can use the recursive rule to compute the second term, as follows:\n\n$$\n\\begin{aligned}\na_{2} &= a_{1} + 1 \\\\\n&= 6 + 1 \\\\\n&= 7\n\\end{aligned}\n$$\n\nUsing the first and second terms, we can compute the common difference:\n\n$$\n\\begin{aligned}\nd &= a_{2} - a_{1} \\\\\n&= 7 - 6 \\\\\n&= 1\n\\end{aligned}\n$$\n\nNow, we substitute\n\n$$\na_1 = {\\color{blue}6}\n$$\n\nand\n\n$$\nd={\\color{red}1}\n$$\n\ninto the formula for the $n$th term:\n\n$$\n\\begin{aligned} a_n&= a_{1}+(n-1)d \\\\[3pt] &= {\\color{blue}6} + (n - 1)({\\color{red}1}) \\\\[3pt] & =6 + n-1 \\\\[3pt] &=n+5 \\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is\n\n$$\na_n=n+5, \\quad n \\geq 1\n$$"]]}]