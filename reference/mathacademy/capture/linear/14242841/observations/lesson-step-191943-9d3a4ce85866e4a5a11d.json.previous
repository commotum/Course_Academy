xlink:href=\"#E2-MJMAIN-33\" x=\"14416\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-2C\" x=\"14917\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMATHI-6E\" x=\"17529\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-2265\" x=\"18407\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-31\" x=\"19463\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-3F\" x=\"19964\" y=\"0\"></use>\n</g>\n</svg></span></p>\n\n            </div>     \n\n            <div class=\"explanationHeader\">EXPLANATION</div>\n\n            <div class=\"exampleExplanation\">\n                <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                            float: none;\n                            direction: ltr;\n                            max-width: none;\n                            max-height: none;\n                            min-width: 0;\n                            min-height: 0;\n                            border: 0;\n                            padding: 0;\n                            margin: 0\n                            }\n\n                            .mjpage 