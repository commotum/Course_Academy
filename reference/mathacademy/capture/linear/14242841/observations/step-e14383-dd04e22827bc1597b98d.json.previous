e(0.707)\" xlink:href=\"#E1-MJMAIN-2B\" x=\"600\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E1-MJMAIN-31\" x=\"1379\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E1-MJMAIN-3D\" x=\"2236\" y=\"0\"></use>\n<g transform=\"translate(3292,0)\">\n <use xlink:href=\"#E1-MJMATHI-61\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E1-MJMATHI-6E\" x=\"748\" y=\"-213\"></use>\n</g>\n <use xlink:href=\"#E1-MJMAIN-2B\" x=\"4568\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMATHI-64\" x=\"5569\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-2C\" x=\"6093\" y=\"0\"></use>\n<g transform=\"translate(8538,0)\">\n <use xlink:href=\"#E1-MJMATHI-61\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E1-MJMAIN-31\" x=\"748\" y=\"-213\"></use>\n</g>\n <use xlink:href=\"#E1-MJMAIN-3D\" x=\"9799\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-5F\" x=\"10855\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-5F\" x=\"11356\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-5F\" x=\"11856\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-2C\" x=\"12523\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMATHI-6E\" x=\"14969\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-2265\" x=\"15847\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-31\" x=\"16903\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p>To complete the formula, we need to work out the first term and common difference. The first two terms are</p>\n<p><span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"20.34ex\" height=\"7.176ex\" style=\"vertical-align: -3.005ex;\" viewBox=\"0 -1796 8757.5 3089.6\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-2-Title\">\n<title id=\"MathJax-SVG-2-Title\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"3\" style=\"font-size: 113.1%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TE