          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:40px;\n                                        margin-left:2px;\n                                        margin-right:1px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"31\"><span class=\"mq-fraction mq-non-leaf\" mathquill-command-id=\"33\"><span class=\"mq-numerator\" mathquill-block-id=\"35\"><span mathquill-command-id=\"34\">1</span><span mathquill-command-id=\"36\">1</span><span class=\"mq-nonSymbola\" mathquill-command-id=\"38\">π</span></span><span class=\"mq-denominator\" mathquill-block-id=\"41\"><span mathquill-command-id=\"40\">6</span></span><span style=\"display:inline-block;width:0\">​</span></span></span></div></div>",
          "rendered_text": "11π6​",
