5 460 320Q460 165 417 83Q397 41 362 16T301 -15T250 -22Q224 -22 198 -16T137 16T82 83Q39 165 39 320Q39 494 96 585ZM321 597Q291 629 250 629Q208 629 178 597Q153 571 145 525T137 333Q137 175 145 125T181 46Q209 16 250 16Q290 16 318 46Q347 76 354 130T362 333Q362 478 354 524T321 597Z\"></path>\n<path stroke-width=\"1\" id=\"E4-MJMAIN-29\" d=\"M60 749L64 750Q69 750 74 750H86L114 726Q208 641 251 514T294 250Q294 182 284 119T261 12T224 -76T186 -143T145 -194T113 -227T90 -246Q87 -249 86 -250H74Q66 -250 63 -250T58 -247T55 -238Q56 -237 66 -225Q221 -64 221 250T66 725Q56 737 55 738Q55 746 60 749Z\"></path>\n<path stroke-width=\"1\" id=\"E4-MJMAIN-2212\" d=\"M84 237T84 250T98 270H679Q694 262 694 250T679 230H98Q84 237 84 250Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E4-MJMAIN-28\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-31\" x=\"389\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-2C\" x=\"890\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-30\" x=\"1335\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-29\" x=\"1835\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-2C\" x=\"2225\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-28\" x=\"3670\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-30\" x=\"4059\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-2C\" x=\"4560\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-31\" x=\"5005\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-29\" x=\"5506\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-2C\" x=\"5895\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-28\" x=\"7340\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-2212\" x=\"7730\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-31\" x=\"8508\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-2C\" x=\"9009\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-30\" x=\"9454\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-29\" x=\"9954\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-2C\" x=\"10344\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-28\" x=\"11789\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-30\" x=\"12179\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-2C\" x=\"12679\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-2212\" x=\"13124\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-31\" x=\"13903\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-29\" x=\"14403\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-2C\" x=\"14793\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p>that correspond to the angles</p>\n<p><span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"25.395ex\" height=\"2.676ex\" style=\"vertical-align: -0.671ex;\" viewBox=\"0 -863.1 10934.1 1152.1\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-5-Title\">\n<title id=\"MathJax-SVG-5-Title\"> 0^\\circ, \\quad 90^\\circ,\\quad 180^\\circ, \\quad 270^\\circ,</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E5-MJMAIN-30\" d=\"M96 585Q152 666 249 666Q297 666 345 640T423 548Q460 465 460 320Q460 165 417 83Q397 41 362 16T301 -15T250 -22Q224 -22 198 -16T137 16T82 83Q39 165 39 320Q39 494 96 585ZM321 597Q291 629 250 629Q208 629 178 597Q153 571 145 525T137 333Q137 175 145 125T181 46Q209 16 250 16Q290 16 318 46Q347 76 354 130T362 333Q362 478 354 524T321 597Z\"></path>\n<path stroke-width=\"1\" id=\"E5-MJMAIN-2218\" d=\"M55 251Q55 328 112 386T249 444T386 388T444 249Q444 171 388 113T250 55Q170 55 113 112T55 251ZM245 403Q188 403 142 361T96 250Q96 183 141 140T250 96Q284 96 313 109T354 135T375 160Q403 197 403 250Q403 313 360 358T245 403Z\"></path>\n<path stroke-width=\"1\" id=\"E5-MJMAIN-2C\" d=\"M78 35T78 60T94 103T137 121Q165 121 187 96T210 8Q210 -27 201 -60T180 -117T154 -158T130 -185T117 -194Q113 -194 104 -185T95 -172Q95 -168 106 -156T131 -126T157 -76T173 -3V9L172 8Q170 7 167 6T161 3T152 1T140 0Q113 0 96 17Z\"></path>\n<path stroke-width=\"1\" id=\"E5-MJMAIN-39\" d=\"M352 287Q