rect {:answer/id #uuid "6238dcb6-e730-5761-a8fc-314e6a8b5732" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186569597} :answer-field/id #uuid "d78da839-c447-5f6a-b9f4-52fee3e7c783" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569932}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "29efc143-8ef6-514b-b08b-b09cf3c6dccf" :question/math-academy-id "q-64861" :question/problem "Find the value of $\\operatorname{sin}⁡(\\frac{\\pi }{2}).$" :question/worked-solution "The angle $\\frac{\\pi }{2}$ is a quadrantal angle. Let's draw out the quadrantal angles on the unit circle.\n\n![](images/79/792a778286533d589a3410223aaf197b07e64ea77566042d7bb8ac13fbad9768.png)\n\nFrom the unit circle, we see that the angle $\\frac{\\pi }{2}$ corresponds to the point $(0,1).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡(\\frac{\\pi }{2})=1.$"}] [{:db/id #edb/ref 17592186060338 :knowledge-point/_questions [{:db/id #edb/ref 17592186059841 :knowledge-point/id #uuid "b547a211-99ec-5325-8d76-da3f7da13174" :knowledge-point/title "Computing the Tangent or Cotangent of a Quadrantal Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4d603e4-4a6f-5d9d-9f74-961dc515094d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186058651} {:answer/id #uuid "e5a3cf69-e2b9-5f94-a59b-88d4b3a17f12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186058652} {:answer/id #uuid "11d29a74-a3a2-5c16-9623-9aa9f752d338" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "π" :db/id #edb/ref 17592186058653} {:answer/id #uuid "12de9e7d-33b3-500e-9cb7-569fb445c7e2" :