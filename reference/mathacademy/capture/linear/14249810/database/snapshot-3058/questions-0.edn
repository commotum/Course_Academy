#{[{:db/id #edb/ref 17592186059515 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059840 :knowledge-point/id #uuid "b406f464-6326-5dbf-b35c-8cde390a65de" :knowledge-point/title "Computing the Sine or Cosine of a Quadrantal Angle"}] :question/id #uuid "e8b9ae0a-cc32-558d-9b59-f7c7608a4eaa" :question/math-academy-id "e-3863" :question/problem "Find the value of $\\sin{270^\\circ}$." :question/worked-solution "The angle $270^\\circ$ is a quadrantal angle. Let's draw out the quadrantal angles on the unit circle.\n\n![](images/79/792a778286533d589a3410223aaf197b07e64ea77566042d7bb8ac13fbad9768.png)\n\nFrom the unit circle, we see that the angle $270^\\circ$ corresponds to the point $(0,-1)$.\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have\n\n$$\n\\sin{270^\\circ} = -1\n$$"}] [{:db/id #edb/ref 17592186059516 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059841 :knowledge-point/id #uuid "b547a211-99ec-5325-8d76-da3f7da13174" :knowledge-point/title "Computing the Tangent or Cotangent of a Quadrantal Angle"}] :question/id #uuid "33f8f1c3-eeca-5092-804d-ab6cd468d5c3" :question/math-academy-id "e-3864" :question/problem "Find the value of $\\tan\\left(\\dfrac{3\\pi}{2}\\right)$." :question/worked-solution "The angle\n\n$$\n\\dfrac{3\\pi}{2}\n$$\n\nis a quadrantal angle. Let's draw out the quadrantal angles on the unit circle.\n\n![](images/79/792a778286533d589a3410223aaf197b07e64ea77566042d7bb8ac13fbad9768.png)\n\nFrom the unit circle, we see that the angle\n\n$$\n\\dfrac{3\\pi}{2}\n$$\n\ncorresponds to the point $(0,-1)$.\n\n- Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\cos\\left(\\dfrac{3\\pi}{2}\\right) = 0$.\n- Since the sine of the angle corresponds to the $y$-coordinate, we have $\\sin\\left(\\dfrac{3\\pi}{2}\\right) = -1$.\n\nTherefore, using the fact that\n\n$$\n\\tan{\\theta} = \\dfrac{\\sin \\theta}{\\cos\\theta}\n$$\n\nwe have\n\n$$\n\\tan\\left(\\dfrac{3\\pi}{2}\\right) = \\dfrac{\\sin\\left(\\dfrac{3\\pi}{2}\\right)}{\\cos\\left(\\dfrac{3\\pi}{2}\\right)} = \\dfrac{-1}{0}\n$$\n\nHowever, division by zero is undefined. Therefore,\n\n$$\n\\tan\\left(\\dfrac{3\\pi}{2}\\right)\n$$\n\nis undefined."}] [{:db/id #edb/ref 17592186059517 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059842 :knowledge-point/id #uuid "d2e28247-1113-5d9f-9c76-49af8b498fc5" :knowledge-point/title "Computing a Reciprocal Ratio of a Quadrantal Angle"}] :question/id #uuid "23de6cbe-0e4f-508e-a955-0d48dbdd93ba" :question/math-academy-id "e-3865" :question/problem "Find the value of $\\sec \\left(\\dfrac{\\pi}{2}\\right)$." :question/worked-solution "The angle\n\n$$\n\\dfrac {\\pi} 2\n$$\n\nis a quadrantal angle. Let's draw out the quadrantal angles on the unit circle.\n\n![](images/79/792a778286533d589a3410223aaf197b07e64ea77566042d7bb8ac13fbad9768.png)\n\nFrom the unit circle, we see that the angle\n\n$$\n\\dfrac{\\pi}{2}\n$$\n\ncorresponds to the point $(0,1)$.\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have\n\n$$\n\\cos{\\left(\\dfrac {\\pi} 2\\right)} = 0\n$$\n\nTherefore, using the fact that\n\n$$\n\\sec{\\theta} = \\dfrac{1}{\\cos\\theta}\n$$\n\nwe have\n\n$$\n\\sec{\\left(\\dfrac {\\pi} 2\\right)} = \\dfrac{1}{\\cos{\\left(\\dfrac {\\pi} 2\\right)}} = \\dfrac{1}{0}\n$$\n\nHowever, division by zero is undefined. Therefore,\n\n$$\n\\sec\\left(\\dfrac {\\pi} 2\\right)\n$$\n\nis undefined."}] [{:db/id #edb/ref 17592186060255 :knowledge-point/_questions [{:db/id #edb/ref 17592186059840 :knowledge-point/id #uuid "b406f464-6326-5dbf-b35c-8cde390a65de" :knowledge-point/title "Computing the Sine or Cosine of a Quadrantal Angle"}] :question/answer-fields [{:answer-field/id #uuid "dc9edcfc-589f-5ca4-8a40-2ce180d59be8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186058167}] :question/id #uuid "6a236920-488d-5d06-a1f4-5237d538b8be" :question/math-academy-id "q-262318" :question/problem "$\\sin (90^{∘}) =$ {{field-1}}"}] [{:db/id #edb/ref 17592186060256 :knowledge-point/_questions [{:db/id #edb/ref 17592186059841 :knowledge-point/id #uuid "b547a211-99ec-5325-8d76-da3f7da13174" :knowledge-point/title "Computing the Tangent or Cotangent of a Quadrantal Angle"}] :question/answer-fields [{:answer-field/id #uuid "9f4046cd-feda-54c3-a257-119416dbaa03" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186058168}] :question/id #uuid "4a4c738b-9987-5ad4-a834-cb376015af6f" :question/math-academy-id "q-262382" :question/problem "Find the value of $\\tan (180^{∘})$.$\\tan (180^{∘}) =$\n{{field-1}}"}] [{:db/id #edb/ref 17592186060338 :knowledge-point/_questions [{:db/id #edb/ref 17592186059841 :knowledge-point/id #uuid "b547a211-99ec-5325-8d76-da3f7da13174" :knowledge-point/title "Computing the Tangent or Cotangent of a Quadrantal Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4d603e4-4a6f-5d9d-9f74-961dc515094d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186058651} {:answer/id #uuid "e5a3cf69-e2b9-5f94-a59b-88d4b3a17f12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186058652} {:answer/id #uuid "11d29a74-a3a2-5c16-9623-9aa9f752d338" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "π" :db/id #edb/ref 17592186058653} {:answer/id #uuid "12de9e7d-33b3-500e-9cb7-569fb445c7e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186058654} {:answer/id #uuid "5bda50d9-f5b4-5dd2-93a9-56affdae452e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186058655}] :answer-field/id #uuid "d41e032b-cbb4-5835-be79-d