#{[{:activity/expected-seconds 900.0 :activity/first-step {:db/id #edb/ref 17592186093116} :activity/id #uuid "9ed557a5-e06f-5f5a-9230-32a93a80b727" :activity/scope {:db/id #edb/ref 17592186050271 :topic/id #uuid "3b427f21-e66e-500e-b1b5-ede02904d802" :topic/math-academy-id 1007} :activity/steps [{:db/id #edb/ref 17592186093116 :step/content {:db/id #edb/ref 17592186093369 :tutorial/content "The chain rule can be used to differentiate exponential functions like \n\n$$\ny = e^{3x}.\n$$\n\nFirst, notice that this function can be written as the composite function\n\n$$\ny = e^u, \\qquad u = 3x.\n$$\n\nWe can use the chain rule to compute the derivative of this composite function:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{\\text{d}}{\\text{d}u}({e}^{u})\\cdot \\frac{\\text{d}}{\\text{d}x}(3x) \\\\  & ={e}^{u}\\cdot 3 \\\\  & =3{e}^{u}\\end{aligned}\n$$\n\nSubstituting $u=3x,$ we obtain the final result:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =3{e}^{3x}\\end{aligned}\n$$" :tutorial/id #uuid "cf67b8fb-2658-5221-b309-6cf09e93b5e7" :tutorial/math-academy-id 1268 :tutorial/title "Introduction"} :step/id #uuid "87b44f73-3af6-53c8-a8c8-61525491b5d4" :step/math-academy-id 646582 :step/next {:db/id #edb/ref 17592186093117}} {:db/id #edb/ref 17592186093117 :step/content {:db/id #edb/ref 17592186092260 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092116 :question/id #uuid "c986ab8f-a8a6-5721-bc8d-ba7ec19b95ea" :question/math-academy-id "e-727"} :knowledge-point/id #uuid "a83f86ab-a008-5487-b118-f1495a0fe4d6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048749} {:db/id #edb/ref 17592186051084}] :knowledge-point/questions [{:db/id #edb/ref 17592186092512} {:db/id #edb/ref 17592186092513} {:db/id #edb/ref 17592186233098} {:db/id #edb/ref 17592186234086} {:db/id #edb/ref 17592186314963} {:db/id #edb/ref 17592186314964} {:db/id #edb/ref 1759