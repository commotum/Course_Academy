#{[{:db/id #edb/ref 17592186092116 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186092260 :knowledge-point/id #uuid "a83f86ab-a008-5487-b118-f1495a0fe4d6" :knowledge-point/title "Differentiating an Exponential Function with a Linear Exponent"}] :question/id #uuid "c986ab8f-a8a6-5721-bc8d-ba7ec19b95ea" :question/math-academy-id "e-727" :question/problem "Calculate $f'(x)$ if $f(x) = e^{5x +4}.$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf = e^u, \\qquad u=5x+4.\n$$\n\nDifferentiating gives\n\n$$\n\\dfrac{\\textrm d f}{\\textrm d u} = e^u,\\qquad \\dfrac{\\textrm d u}{\\textrm d x} =5.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot 5 \\\\  & =5{e}^{u} \\\\  & =5{e}^{5x+4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092118 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186092261 :knowledge-point/id #uuid "2f4bfd24-dafd-57b3-940a-154a6e0acf3d" :knowledge-point/title "Differentiating a General Exponential Function Using the Chain Rule"}] :question/id #uuid "775dfc95-df31-5198-aeb2-4603b8386957" :question/math-academy-id "e-728" :question/problem "Given that $y= 3\\cdot 2^{1 - x},$ find $\\dfrac{\\textrm d y}{\\textrm d x}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny = 3\\cdot 2^u, \\qquad u=1-x.\n$$\n\nDifferentiating gives\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d u} = 3\\cdot 2^u\\ln(2),\\qquad \\dfrac{\\textrm d u}{\\textrm d x} =-1.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =3\\cdot {2}^{u}ln⁡(2)\\cdot (-1) \\\\  & =-3\\cdot {2}^{u}ln⁡(2) \\\\  & =-3\\cdot {2}^{1-x}ln⁡(2).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092119 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186092263 :knowledge-point/id #uuid "107eaf98-be8c-5fb1-ac4c-948b1e00df0a" :knowledge-point/title "Differentiating an Exponential Function with a Nonlinear Exponent"}] :question/id #uuid "b15a88b5-e2c4-51c1-90d5-031c2a8c23d3" :question/math-academy-id "e-729" :question/problem "Given that $y=e^{-x^2},$ calculate $\\dfrac{\\textrm d y}{\\textrm d x}.$" :question/worked-solution "First we express $y$ as the composite function\n\n$$\ny = e^u, \\qquad u=-x^2.\n$$\n\nDifferentiating gives\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d u} = e^u,\\qquad \\dfrac{\\textrm d u}{\\textrm d x} =-2x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (-2x) \\\\  & =-2x{e}^{u} \\\\  & =-2x{e}^{-{x}^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092513 :knowledge-point/_questions [{:db/id #edb/ref 17592186092260 :knowledge-point/id #uuid "a83f86ab-a008-5487-b118-f1495a0fe4d6" :knowledge-point/title "Differentiating an Exponential Function with a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a72f46cd-ae5e-5369-ac3a-906a711a6a72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^{2x + 5}}{2}" :db/id #edb/ref 17592186089250} {:answer/id #uuid "b53db06b-92b9-5298-810d-18bcc71b09a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2xe^{2x + 5}" :db/id #edb/ref 17592186089251} {:answer/id #uuid "181aab1e-8a13-55d1-af91-7902b69fdb42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e^{2x + 5}" :db/id #edb/ref 17592186089252} {:answer/id #uuid "228c28d4-c54c-59fc-abc4-8bd4a76de28f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{2x + 5}" :db/id #edb/ref 17592186089253} {:answer/id #uuid "4de1d19f-8a03-5aca-a314-5556b81aac11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2x + 5)e^{2x + 5}" :db/id #edb/ref 17592186089254}] :answer-field/id #uuid "aa7337e6-4d8a-5b6d-9fd4-37daba6415d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089249}] :question/id #uuid "b27b93f8-5f19-566f-95e3-f0a0b21ec684" :question/math-academy-id "q-11817" :question/problem "Given that $f(x) = e^{2x + 5}$, find $\\frac{df}{dx}$."}] [{:db/id #edb/ref 17592186314963 :knowledge-point/_questions [{:db/id #edb/ref 17592186092260 :knowledge-point/id #uuid "a83f86ab-a008-5487-b118-f1495a0fe4d6" :knowledge-point/title "Differentiating an Exponential Function with a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0cfd52e-1fc1-51eb-85e5-32d9d3dc6090" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{e}^{-3x+5}+8" :db/id #edb/ref 17592186313486}] :answer-field/correct {:answer/id #uuid "c0cfd52e-1fc1-51eb-85e5-32d9d3dc6090" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{e}^{-3x+5}+8" :db/id #edb/ref 17592186313486} :answer-field/id #uuid "7fd73eaf-0df8-5718-b843-1cd77b6090a3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314351}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8593de99-5055-5455-bd33-e38ccd6c9851" :question/math-academy-id "q-340496" :question/problem "Calculate ${f}^{′}(x)$ if $f(x)=8x+{e}^{-3x+5}.$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "First, we express $y={e}^{-3x+5}$ as the composite function\n\n$$\ny={e}^{u},\\,u=-3x+5.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-3.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (-3) \\\\  & =-3{e}^{u} \\\\  & =-3{e}^{-3x+5}.\\end{aligned}\n$$\n\nFinally, using the sum rule of differentiation, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(8x+{e}^{-3x+5}) \\\\  & =8-3{e}^{-3x+5} \\\\  & =-3{e}^{-3x+5}+8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329898 :knowledge-point/_questions [{:db/id #edb/ref 17592186092263 :knowledge-point/id #uuid "107eaf98-be8c-5fb1-ac4c-948b1e00df0a" :knowledge-point/title "Differentiating an Exponential Function with a Nonlinear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33b1c38d-bd47-595a-85a4-aaa20457bc59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{x}^{2}{e}^{8-2{x}^{3}}" :db/id #edb/ref 17592186327383} {:answer/id #uuid "87871190-a65e-5c1e-8282-1faf7bde4a6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(8-6{x}^{2}){e}^{8-2{x}^{3}}" :db/id #edb/ref 17592186328101} {:answer/id #uuid "b8909401-18d1-5019-a6f0-ca794f50ba31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{x}^{4}{e}^{8-2{x}^{3}}" :db/id #edb/ref 17592186328540} {:answer/id #uuid "c387f8bc-a855-544f-9080-010895d03bd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6{x}^{2}{e}^{8-2{x}^{3}}" :db/id #edb/ref 17592186328643} {:answer/id #uuid "e092d66a-dbb8-5e12-ab82-47da6c4607df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6{x}^{4}{e}^{8-2{x}^{3}}" :db/id #edb/ref 17592186328899}] :answer-field/correct {:answer/id #uuid "c387f8bc-a855-544f-9080-010895d03bd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6{x}^{2}{e}^{8-2{x}^{3}}" :db/id #edb/ref 17592186328643} :answer-field/id #uuid "025f7489-d455-5ba5-a862-9edaba9cd328" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329189}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "97112097-e97d-59a1-a70d-99c7a4daf89b" :question/math-academy-id "q-48629" :question/problem "Find ${f}^{′}(x)$ for $f(x)={e}^{8-2{x}^{3}}.$" :question/worked-solution "First we express $f(x)$ as the composite function\n\n$$\nf={e}^{u},\\,u=8-2{x}^{3}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-6{x}^{2}.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (-6{x}^{2}) \\\\  & =-6{x}^{2}{e}^{8-2{x}^{3}}.\\end{aligned}\n$$"}]}
