#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186069792} :activity/id #uuid "2dc87c95-826a-555a-9423-36fffbf47e86" :activity/scope {:db/id #edb/ref 17592186051032 :topic/id #uuid "7bffda20-cdd5-5dc8-9399-950fa61fbd19" :topic/math-academy-id 382} :activity/steps [{:db/id #edb/ref 17592186069792 :step/content {:db/id #edb/ref 17592186069940 :tutorial/content "Sometimes, perfect square trinomials have a leading coefficient that is something other than $1.$ For example, the expression\n\n$$\n4x^2+12x+9\n$$\n\nhas a leading coefficient of $4,$ and it is a perfect square trinomial because it is the square of the binomial $(2x+3)$ as we can see below:\n\n$$\n\\begin{aligned}(2x+3)^{2} & = \\\\ (2x)^{2}+2(2x)(3)+(3)^{2} & = \\\\ 4{x}^{2}+12x+9 & \\end{aligned}\n$$\n\nTo factor a perfect square trinomial with a leading coefficient other than $1,$ we use the square of sum formula:\n\n$$\n\\begin{aligned}{a}^{2}+2ab+{b}^{2} & =(a+b)^{2}\\end{aligned}\n$$\n\nTo illustrate, let's factor the expression $4x^2+12x+9$ using the square of sum formula. We perform the following steps:\n\n1\\. Write both the quadratic term and the constant term as perfect squares:\n\n  $$\n  \\begin{aligned}4{x}^{2}+12x+9 & = \\\\ (2x)^{2}+12x+(3)^{2}\\end{aligned}\n  $$\n\n2\\. Factor a $2$ out of the linear term:\n\n  $$\n  \\begin{aligned}(2x)^{2}+2(6x)+(3)^{2}\\end{aligned}\n  $$\n\n3\\. Write the middle parentheses $(6x)$ as a product of $2x$ and ${\\color{blue}3}\\mathbin{:}$\n\n  $$\n  \\begin{aligned}(2x)^{2}+2(2x\\cdot 3)+(3)^{2}\\end{aligned}\n  $$\n\n4\\. Factor the trinomial using the square of sum formula. In this case, we have $a=2x$ and $b=3\\mathbin{:}$\n\n  $$\n  \\begin{aligned}(2x+3)^{2}\\end{aligned}\n  $$\n\n**Note:** This method works *only* when the trinomial is a perfect square! It will *not* work for every trinomial. But we will learn more general methods in the future." :tutorial/id #uuid "5d43b5e8-672e-5cdd-b7a3-8de29e6552f3" :tutorial/math-academy-id 1597 :tutorial/title "Introduction"} :step/id #uuid "8854423e-52a6-5077-ab8f-c9de25d23206" :step/math-academy-id 4236 :step/next {:db/id #edb/ref 17592186069793}} {:db/id #edb/ref 17592186069793 :step/content {:db/id #edb/ref 17592186068847 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068464 :question/id #uuid "99376061-f11c-50f9-8c6e-e67ad640afd1" :question/math-academy-id "e-1331"} :knowledge-point/id #uuid "0f4dc7f6-d085-5ad8-8ac3-95e5b9cc337f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049026}] :knowledge-point/questions [{:db/id #edb/ref 17592186069216} {:db/id #edb/ref 17592186069252} {:db/id #edb/ref 17592186484281} {:db/id #edb/ref 17592186484296}] :knowledge-point/title "Factoring a Perfect Square Trinomial Generated by the Square of a Sum"} :step/id #uuid "ac3a35ba-8b05-5a52-9f06-dc5add492619" :step/math-academy-id 4237 :step/next {:db/id #edb/ref 17592186069898}} {:db/id #edb/ref 17592186069794 :step/content {:db/id #edb/ref 17592186068848 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068465 :question/id #uuid "e9c8bdc9-696d-5a55-bb0d-d247008c5684" :question/math-academy-id "e-1333"} :knowledge-point/id #uuid "5f64efad-73ef-5caa-b38b-060d24ce13cf" :knowledge-point/questions [{:db/id #edb/ref 17592186069219} {:db/id #edb/ref 17592186069220} {:db/id #edb/ref 17592186484210} {:db/id #edb/ref 17592186542225}] :knowledge-point/title "Factoring a Perfect Square Trinomial Whose Terms Have a Common Factor"} :step/id #uuid "6a2dd26d-51b3-5cc1-8396-efeb5b1b8bb7" :step/math-academy-id 4242 :step/next {:db/id #edb/ref 17592186069795}} {:db/id #edb/ref 17592186069795 :step/content {:db/id #edb/ref 17592186069941 :tutorial/content "How can we factor a trinomial that has a negative leading coefficient, like\n\n$$\n-25y^2 + 20y - 4\\,?\n$$\n\n \nWe can reduce this to a more familiar problem by factoring out $−1$ from the entire expression:\n\n$$\n-(25y^2 - 20y + 4)\n$$\n\nNow, we factor the quadratic expression inside the parentheses using the square of a difference formula:\n\n$$\n\\begin{aligned}25{y}^{2}-20y+4 & = \\\\ (5y)^{2}-20y+{2}^{2} & = \\\\ (5y)^{2}-2(10y)+{2}^{2} & = \\\\ (5y)^{2}-2(5y\\cdot 2)+{2}^{2} & = \\\\ (5y-2)^{2} & \\end{aligned}\n$$\n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}-(25{y}^{2}-20y+4) & = \\\\ -(5y-2)^{2}\\end{aligned}\n$$" :tutorial/id #uuid "757d1827-0402-5d3d-b8da-a4dc88c254bb" :tutorial/math-academy-id 1598 :tutorial/title "Factoring a Perfect Square Trinomial With a Negative Leading Coefficient"} :step/id #uuid "3464306e-5c3f-55f3-9c10-87ab309dded2" :step/math-academy-id 4244 :step/next {:db/id #edb/ref 17592186069796}} {:db/id #edb/ref 17592186069796 :step/content {:db/id #edb/ref 17592186068849 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068466 :question/id #uuid "b74ed282-c54c-56f8-aa9f-8c5ef4465712" :question/math-academy-id "e-1334"} :knowledge-point/id #uuid "b67de190-3b32-506e-b375-bd18d4543bf6" :knowledge-point/questions [{:db/id #edb/ref 17592186069338} {:db/id #edb/ref 17592186069339} {:db/id #edb/ref 17592186484231} {:db/id #edb/ref 17592186484282} {:db/id #edb/ref 17592186484292} {:db/id #edb/ref 17592186484295} {:db/id #edb/ref 17592186542210}] :knowledge-point/title "Factoring a Perfect Square Trinomial With a Negative Leading Coefficient"} :step/id #uuid "3222e5cc-52d3-5afd-8468-ab3d87c483b2" :step/math-academy-id 4245} {:db/id #edb/ref 17592186069876 :step/content {:db/id #edb/ref 17592186068902 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068520 :question/id #uuid "b7141e58-61cf-5134-8443-a82d79a5506e" :question/math-academy-id "e-1593"} :knowledge-point/id #uuid "69a3b7a7-1042-511a-aaff-8b0911eae499" :knowledge-point/questions [{:db/id #edb/ref 17592186069215} {:db/id #edb/ref 17592186069251} {:db/id #edb/ref 17592186484249} {:db/id #edb/ref 17592186484291} {:db/id #edb/ref 17592186542124}] :knowledge-point/title "Factoring a Perfect Square Trinomial Generated by the Square of a Difference"} :step/id #uuid "d8accb58-b4d7-5dc8-9c5e-a5ca4f3588a2" :step/math-academy-id 5059 :step/next {:db/id #edb/ref 17592186069794}} {:db/id #edb/ref 17592186069898 :step/content {:db/id #edb/ref 17592186069954 :tutorial/content "Other perfect square trinomials can be factored as the square of a difference:\n\n$$\n\\begin{aligned}{a}^{2}-2ab+{b}^{2} & =(a-b)^{2}\\end{aligned}\n$$\n\nTo illustrate, let's factor the expression $9x^2-24x+16$ using the square of difference formula. We perform the following steps:\n\n1\\. Write both the quadratic term and the constant term as perfect squares:\n\n  $$\n  \\begin{aligned}9{x}^{2}-24x+16 & = \\\\ (3x)^{2}-24x+(4)^{2}\\end{aligned}\n  $$\n\n2\\. Factor a $2$ out of the linear term:\n\n  $$\n  \\begin{aligned}(3x)^{2}-24x+(4)^{2} & = \\\\ (3x)^{2}-2(12x)+(4)^{2}\\end{aligned}\n  $$\n\n3\\. Write the middle parentheses $(12x)$ as a product of $3x$ and ${\\color{blue}4}\\mathbin{:}$\n\n  $$\n  \\begin{aligned}(3x)^{2}-2(12x)+(4)^{2} & = \\\\ (3x)^{2}-2(3x\\cdot 4)+(4)^{2}\\end{aligned}\n  $$\n\n4\\. Factor the trinomial using the square of difference formula. In this case, we have $a=3x$ and $b=4\\mathbin{:}$\n\n  $$\n  \\begin{aligned}(3x)^{2}-2(3x\\cdot 4)+(4)^{2} & = \\\\ (3x-4)^{2}\\end{aligned}\n  $$\n\n**Note:** Once again, we note that this method works *only* when the trinomial is a perfect square! It will *not* work for every trinomial." :tutorial/id #uuid "609ce9b5-1b4e-5dfc-9d22-4ec6ea2d640b" :tutorial/math-academy-id 1856 :tutorial/title "Factoring a Perfect Square Trinomial Generated by the Square of a Difference"} :step/id #uuid "ecc30896-0712-5c97-a35e-e51485979c95" :step/math-academy-id 6170 :step/next {:db/id #edb/ref 17592186069876}}] :activity/title "Factoring Perfect Square Trinomials With Leading Coefficients" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068930}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186542265} :activity/id #uuid "f6b132f1-8395-5934-a798-3dc92cf19ca0" :activity/scope {:db/id #edb/ref 17592186051032 :topic/id #uuid "7bffda20-cdd5-5dc8-9399-950fa61fbd19" :topic/math-academy-id 382} :activity/steps [{:db/id #edb/ref 17592186542263 :step/content {:db/id #edb/ref 17592186542225 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "374194b8-85ae-5815-89c6-1a8f87cc6dbe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2(2x-3)^{2}" :db/id #edb/ref 17592186541540} {:answer/id #uuid "39ef85ad-8276-5ed8-b41e-7af905c91f91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x+3)^{2}" :db/id #edb/ref 17592186541548} {:answer/id #uuid "5bd98886-b613-531e-838d-f40fd260e8e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2x+1)^{2}" :db/id #edb/ref 17592186541605} {:answer/id #uuid "8c94784c-933a-51ab-b0f4-2713a3427fc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4(x-3)^{2}" :db/id #edb/ref 17592186541706} {:answer/id #uuid "bbb07f95-43b5-5477-a9d0-0c1c20b3c07b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4(2x-3)^{2}" :db/id #edb/ref 17592186541811}] :answer-field/correct {:db/id #edb/ref 17592186541811} :answer-field/id #uuid "5e25dd26-d9cd-5142-93e6-a7e8dbdac2b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542014}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f03b5992-4a97-5b3b-9545-c672d1a6e209" :question/math-academy-id "q-79002" :question/problem "Factor $16{x}^{2}-48x+36.$" :question/worked-solution "Notice that all of the terms have a common factor of $4.$ Therefore, we can simplify the expression by factoring out $4,$ as follows:\n\n$$\n\\begin{aligned}16{x}^{2}-48x+36 & = \\\\ 4(4{x}^{2}-12x+9)\\end{aligned}\n$$\n\nNow, let's factor the expression inside parentheses using the square of a difference formula: \n\n$$\n\\begin{aligned}4{x}^{2}-12x+9 & = \\\\ (2x)^{2}-12x+{3}^{2} & = \\\\ (2x)^{2}-2\\cdot (2x\\cdot 3)+{3}^{2} & = \\\\ (2x-3)^{2}\\end{aligned}\n$$\n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}4(4{x}^{2}-12x+9) & = \\\\ 4(2x-3)^{2}\\end{aligned}\n$$"} :step/id #uuid "77f81baa-f622-5822-ad79-2391b7a40d19"} {:db/id #edb/ref 17592186542265 :step/content {:db/id #edb/ref 17592186542124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bb9bce2-0c34-585a-9786-18cdbee30507" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3y-3)^{2}" :db/id #edb/ref 17592186541510} {:answer/id #uuid "41931e51-fe5c-5024-b27f-7666c39e6cec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(y-3)^{2}" :db/id #edb/ref 17592186541559} {:answer/id #uuid "b7268394-d3df-50dd-aefd-a1d483bd162e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3y-1)^{2}" :db/id #edb/ref 17592186541799} {:answer/id #uuid "bfc42d89-bdf4-5894-9f74-40a503a37160" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9(y-1)^{2}" :db/id #edb/ref 17592186541827} {:answer/id #uuid "c4b7e90c-e93d-59fc-87e0-2091f13f04ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3(y-1)^{2}" :db/id #edb/ref 17592186541835}] :answer-field/correct {:db/id #edb/ref 17592186541799} :answer-field/id #uuid "bbdf1e33-0fba-578c-aaad-d0ea6db8cbc2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542052}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1c00ad8d-9908-5ab2-b9e6-65ef0d5fcd94" :question/math-academy-id "q-31964" :question/problem "$9{y}^{2}-6y+1=$" :question/worked-solution "The \"square of a difference\" formula states that\n\n$$\n{a}^{2}-2ab+{b}^{2}=(a-b)^{2}.\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n9{y}^{2}-6y+1.\n$$\n\nFirst, we write both the quadratic term and the constant term as perfect squares:\n\n$$\n\\begin{aligned}(3y)^{2}-6y+(1)^{2}\\end{aligned}\n$$\n\nNext, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}(3y)^{2}-2(3y)+(1)^{2}\\end{aligned}\n$$\n\nThen, we write the middle parentheses $(3y)$ as a product of $3y$ and $1:$ \n\n$$\n\\begin{aligned}(3y)^{2}-2(3y\\cdot 1)+(1)^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of difference formula with $a=3y$ and $b=1.$ This gives \n\n$$\n\\begin{aligned}(3y-1)^{2}.\\end{aligned}\n$$"} :step/id #uuid "7da91827-5e59-5953-84fa-3077985bee0d" :step/next {:db/id #edb/ref 17592186542275}} {:db/id #edb/ref 17592186542275 :step/content {:db/id #edb/ref 17592186542210 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30bc40bd-0baa-53bc-b504-a2c240a14dc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-(2x-1)^{2}" :db/id #edb/ref 17592186541522} {:answer/id #uuid "37d6615e-66de-5728-ae8f-8e2fb4faec1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-(2x+1)^{2}" :db/id #edb/ref 17592186541541} {:answer/id #uuid "464d7d12-8513-5d3d-b8c3-79b6c483fb54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-(4x-1)^{2}" :db/id #edb/ref 17592186541571} {:answer/id #uuid "62b93017-abd9-5aa6-a8a4-50b59a42230d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x-2)^{2}" :db/id #edb/ref 17592186541625} {:answer/id #uuid "995306bc-ae35-5f95-966b-0932e6545022" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4x-1)^{2}" :db/id #edb/ref 17592186541741}] :answer-field/correct {:db/id #edb/ref 17592186541522} :answer-field/id #uuid "d785b8b3-293e-5ba6-866c-d51249e905eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542068}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cf9a0034-0b04-5113-8b59-eaa614930923" :question/math-academy-id "q-44032" :question/problem "Factor $-4{x}^{2}+4x-1.$" :question/worked-solution "Notice that the leading coefficient is negative. To reduce the expression to a more familiar form, we can factor out $-1,$ as follows:\n\n$$\n\\begin{aligned}-4{x}^{2}+4x-1 & = \\\\ -(4{x}^{2}-4x+1)\\end{aligned}\n$$\n\nNow, we factor the quadratic expression inside the parentheses using the square of a difference formula:\n\n$$\n\\begin{aligned}4{x}^{2}-4x+1 & = \\\\ (2x)^{2}-4x+{1}^{2} & = \\\\ (2x)^{2}-2\\cdot (2x)+{1}^{2} & = \\\\ (2x-1)^{2} & \\end{aligned}\n$$\n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}-(4{x}^{2}-4x+1) & = \\\\ -(2x-1)^{2} & \\end{aligned}\n$$"} :step/id #uuid "bf2aa872-b9dd-51ab-a97f-7add7180d9e9" :step/next {:db/id #edb/ref 17592186542263}}] :activity/title "Factoring Perfect Square Trinomials With Leading Coefficients" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186541427}]}
