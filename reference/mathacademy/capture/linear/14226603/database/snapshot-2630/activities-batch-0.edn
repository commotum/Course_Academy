uuid "116d4e70-b784-54f1-b8a9-1880b475e2a2" :step/math-academy-id 165699}] :activity/title "Solving Equations Using the Square Root Method" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068962}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186492934} :activity/id #uuid "e5862109-bc69-574a-aa55-2c8e894e10bd" :activity/scope {:db/id #edb/ref 17592186048187 :topic/id #uuid "86a29d40-d28e-53d5-b56d-cdcc72f7fe80" :topic/math-academy-id 430} :activity/steps [{:db/id #edb/ref 17592186492934 :step/content {:db/id #edb/ref 17592186492907 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a6f09a0-ccd7-5f3c-b936-37c4d8190186" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{3}{7}" :db/id #edb/ref 17592186492363} {:answer/id #uuid "72c93668-102e-59cf-bbee-5a2ec27c8f74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\pm \\frac{3}{7}" :db/id #edb/ref 17592186492444} {:answer/id #uuid "8bbf1f51-b87d-56f3-a2e4-c8c1a5907fb8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\pm \\frac{7}{3}" :db/id #edb/ref 17592186492494} {:answer/id #uuid "aabe0e05-f4e4-5dba-8d77-0379c8bb7619" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\pm \\frac{3}{49}" :db/id #edb/ref 17592186492562} {:answer/id #uuid "d05fdd44-d514-56b7-a034-70edb6be2559" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\pm \\frac{9}{7}" :db/id #edb/ref 17592186492631}] :answer-field/correct {:db/id #edb/ref 17592186492444} :answer-field/id #uuid "52cb84e8-9f4d-596d-8658-8754ec0aa693" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492737}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c009e53d-f124-53fe-9bd5-4569b0faacf3" :question/math-academy-id "q-78906" :question/problem "Solve for $x$ where $\\frac{{x}^{2}}{2}=\\frac{9}{98}.$" :question/worked-solution "First, we isolate the ${x}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{2} & =\\frac{9}{98} \\\\ {x}^{2} & =\\frac{9\\cdot 2}{98} \\\\ {x}^{2} & =\\frac{9}{49}\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}} & =\\sqrt{\\frac{9}{49}} \\\\ |x| & =\\frac{\\sqrt{9}}{\\sqrt{49}} \\\\ |x| & =\\frac{3}{7} \\\\ x & =\\pm \\frac{3}{7}\\end{aligned}\n$$"} :step/id #uuid "1c1afa0a-f568-5caf-ba70-ff3df6c7dca6" :step/next {:db/id #edb/ref 17592186492940}} {:db/id #edb/ref 17592186492940 :step/content {:db/id #edb/ref 17592186492916 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7524c348-11f2-59fe-89ce-2554d91064a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm \\frac{5}{7}" :db/id #edb/ref 17592186492451}] :answer-field/correct {:db/id #edb/ref 17592186492451} :answer-field/id #uuid "246155e5-4b6f-5296-89cb-0ce66033efc4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186492717}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dc9b5d6a-36da-5369-a8e0-149a58110d0a" :question/math-academy-id "q-218577" :question/problem "If $49{a}^{2}+12=37,$ then $a=${{field-1}}." :question/worked-solution "First, we isolate the ${a}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}49{a}^{2}+12 & =37 \\\\ 49{a}^{2} & =25 \\\\ {a}^{2} & =\\frac{25}{49}\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{a}^{2}} & =\\sqrt{\\frac{25}{49}} \\\\ |a| & =\\frac{\\sqrt{25}}{\\sqrt{49}} \\\\ |a| & =\\frac{5}{7} \\\\ a & =\\pm \\frac{5}{7}\\end{aligned}\n$$"} :step/id #uuid "3342109e-04c1-5840-b62d-667fd5a7fffe" :step/next {:db/id #edb/ref 17592186492966}} {:db/id #edb/ref 17592186492966 :step/content {:db/id #edb/ref 17592186492883 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b1bc9b8-0ea0-52cc-a644-25016e73c24b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm 3\\sqrt{5}" :db/id #edb/ref 17592186492465}] :answer-field/correct {:db/id #edb/ref 17592186492465} :answer-field/id #uuid "fb6954e1-945b-51aa-b2d8-20a643556b8d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186492816}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "90d6c1a2-df8a-556c-89a1-d672dd78eab8" :question/math-academy-id "q-218588" :question/problem "Solve the equation ${v}^{2}=45.$ Express your final answer in its simplest form.\n\n$v=$\n\n{{field-1}}" :question/worked-solution "We take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{v}^{2}} & =\\sqrt{45} \\\\ |v| & =\\sqrt{9\\cdot 5} \\\\ |v| & =\\sqrt{9}\\cdot \\sqrt{5} \\\\ |v| & =3\\sqrt{5} \\\\ v & =\\pm 3\\sqrt{5}\\end{aligned}\n$$"} :step/id #uuid "88a5c700-3e29-5300-852c-85cc903204b4"}] :activity/title "Solving Equations Using the Square Root Method" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186492220}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186545914} :activity/id #uuid "baea3878-87f7-5c2d-97d8-1054599f9f7d" :activity/scope {:db/id #edb/ref 17592186048187 :topic/id #uuid "86a29d40-d28e-53d5-b56d-cdcc72f7fe80" :topic/math-academy-id 430} :activity/steps [{:db/id #edb/ref 17592186545914 :step/content {:db/id #edb/ref 17592186545838 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "000f3d81-c5d0-5946-b172-3bf3fe65444a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a=\\pm 2\\sqrt{10}" :db/id #edb/ref 17592186545200} {:answer/id #uuid "34ac2f0d-2f64-5eae-b276-d1d7570929cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a=-2\\sqrt{10}" :db/id #edb/ref 17592186545305} {:answer/id #uuid "43f62726-6db5-59d8-a65d-6482ea48a157" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a=\\pm 2\\sqrt{2}" :db/id #edb/ref 17592186545328} {:answer/id #uuid "492c1b78-ce03-55b1-9771-7be25a941eaf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a=\\pm 2\\sqrt{5}" :db/id #edb/ref 17592186545338} {:answer/id #uuid "9ba5b039-42c1-5f88-a8de-65c4f49d3c7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a=2\\sqrt{10}" :db/id #edb/ref 17592186545481}] :answer-field/correct {:db/id #edb/ref 17592186545200} :answer-field/id #uuid "74304a95-1479-50c8-b9fd-11f3f0128771" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545722}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9a2ec726-00b7-5cc7-85a6-cb62e4711dd2" :question/math-academy-id "q-12796" :question/problem "Find $a$ if ${a}^{2}=40.$" :question/worked-solution "We take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{a}^{2}} & =\\sqrt{40} \\\\ |a| & =\\sqrt{4\\cdot 10} \\\\ |a| & =\\sqrt{4}\\cdot \\sqrt{10} \\\\ |a| & =2\\sqrt{10} \\\\ a & =\\pm 2\\sqrt{10}\\end{aligned}\n$$"} :step/id #uuid "3f35f28c-8140-5525-adb9-84b98af741a1" :step/next {:db/id #edb/ref 17592186545958}} {:db/id #edb/ref 17592186545953 :step/content {:db/id #edb/ref 17592186545849 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "363dd3dd-0402-51c3-b564-d0f77502fd2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=\\pm 5" :db/id #edb/ref 17592186545311} {:answer/id #uuid "58910719-15f1-5c10-aba5-c08657d568a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=\\pm 6" :db/id #edb/ref 17592186545366} {:answer/id #uuid "5d867956-1afa-545a-8d5e-158bee736d9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=\\pm \\frac{5}{6}" :db/id #edb/ref 17592186545377} {:answer/id #uuid "9ee5e500-cf1f-5e17-88ce-c0068943b54e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=\\pm \\frac{6}{5}" :db/id #edb/ref 17592186545492} {:answer/id #uuid "dae9e2a6-948b-5b95-a02c-61c1a8d0f2ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=\\frac{5}{6}" :db/id #edb/ref 17592186545605}] :answer-field/correct {:db/id #edb/ref 17592186545377} :answer-field/id #uuid "2138cdc1-7319-514a-94f4-c743a1b5525e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545687}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "af7384d0-ffc3-51cc-833d-b329ee1b978c" :question/math-academy-id "q-111429" :question/problem "Solve for $z$ where $3{z}^{2}-\\frac{25}{12}=0.$" :question/worked-solution "First, we isolate the ${z}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}3{z}^{2}-\\frac{25}{12} & =0 \\\\ 3{z}^{2} & =\\frac{25}{12} \\\\ {z}^{2} & =\\frac{25}{36}\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{z}^{2}} & =\\sqrt{\\frac{25}{36}} \\\\ |z| & =\\frac{\\sqrt{25}}{\\sqrt{36}} \\\\ |z| & =\\frac{5}{6} \\\\ z & =\\pm \\frac{5}{6}\\end{aligned}\n$$"} :step/id #uuid "9976cbb6-bd4a-584c-b73f-c65c17b1a0de"} {:db/id #edb/ref 17592186545958 :step/content {:db/id #edb/ref 17592186545817 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "174968af-4f97-5fc2-96c1-946a1318679f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm 2\\sqrt{6}" :db/id #edb/ref 17592186545243} {:answer/id #uuid "1787098a-f4be-583e-8b74-371cf41e0f4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm 3\\sqrt{2}" :db/id #edb/ref 17592186545244} {:answer/id #uuid "1f6a6925-66ac-5529-a6b8-a5006b6b8998" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm 4\\sqrt{3}" :db/id #edb/ref 17592186545260} {:answer/id #uuid "260a6d7a-9e0e-525f-a529-7e99511654a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm \\sqrt{6}" :db/id #edb/ref 17592186545281} {:answer/id #uuid "81d4dc11-5639-5bc7-9888-4db8339d8ad3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm 2\\sqrt{3}" :db/id #edb/ref 17592186545440}] :answer-field/correct {:db/id #edb/ref 17592186545440} :answer-field/id #uuid "825ca9e2-d349-54be-8ff8-677e119c487a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545731}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "48d8f1b2-776f-5613-8b52-d9e267acd25f" :question/math-academy-id "q-56116" :question/problem "Find $a$ if ${a}^{2}-6=6.$" :question/worked-solution "First, we isolate the ${a}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}{a}^{2}-6 & =6 \\\\ {a}^{2} & =12\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{a}^{2}} & =\\sqrt{12} \\\\ |a| & =\\sqrt{12} \\\\ |a| & =\\sqrt{4\\cdot 3} \\\\ |a| & =\\sqrt{4}\\cdot \\sqrt{3} \\\\ |a| & =2\\sqrt{3} \\\\ a & =\\pm 2\\sqrt{3}\\end{aligned}\n$$"} :step/id #uuid "a00c9687-cbb9-5d05-9d5b-a0e30fddfa25" :step/next {:db/id #edb/ref 17592186545953}}] :activity/title "Solving Equations Using the Square Root Method" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186545193}]}
