#{[{:db/id #edb/ref 17592186545849 :knowledge-point/_questions [{:db/id #edb/ref 17592186068726 :knowledge-point/id #uuid "6c5d24fa-8a65-5c20-bb50-530ca8dcf061" :knowledge-point/title "Solving Equations With Fractional Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "363dd3dd-0402-51c3-b564-d0f77502fd2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm 5" :db/id #edb/ref 17592186545311} {:answer/id #uuid "58910719-15f1-5c10-aba5-c08657d568a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm 6" :db/id #edb/ref 17592186545366} {:answer/id #uuid "5d867956-1afa-545a-8d5e-158bee736d9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{5}{6}" :db/id #edb/ref 17592186545377} {:answer/id #uuid "9ee5e500-cf1f-5e17-88ce-c0068943b54e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{6}{5}" :db/id #edb/ref 17592186545492} {:answer/id #uuid "dae9e2a6-948b-5b95-a02c-61c1a8d0f2ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\frac{5}{6}" :db/id #edb/ref 17592186545605}] :answer-field/correct {:answer/id #uuid "5d867956-1afa-545a-8d5e-158bee736d9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{5}{6}" :db/id #edb/ref 17592186545377} :answer-field/id #uuid "2138cdc1-7319-514a-94f4-c743a1b5525e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186545687}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "af7384d0-ffc3-51cc-833d-b329ee1b978c" :question/math-academy-id "q-111429" :question/problem "Solve for $z$ where $3{z}^{2}-\\frac{25}{12}=0.$" :question/worked-solution "First, we isolate the ${z}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}3{z}^{2}-\\frac{25}{12} & =0 \\\\ 3{z}^{2} & =\\frac{25}{12} \\\\ {z}^{2} & =\\frac{25}{36}\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{z}^{2}} & =\\sqrt{\\frac{25}{36}} \\\\ |z| & =\\frac{\\sqrt{25}}{\\sqrt{36}} \\\\ |z| & =\\frac{5}{6} \\\\ z & =\\pm \\frac{5}{6}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186545838 :knowledge-point/_questions [{:db/id #edb/ref 17592186068727 :knowledge-point/id #uuid "a21c64f2-1b4b-54b3-a8a1-70ca63330e04" :knowledge-point/title "Solving Equations With Radical Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "000f3d81-c5d0-5946-b172-3bf3fe65444a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\pm 2\\sqrt{10}" :db/id #edb/ref 17592186545200} {:answer/id #uuid "34ac2f0d-2f64-5eae-b276-d1d7570929cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=-2\\sqrt{10}" :db/id #edb/ref 17592186545305} {:answer/id #uuid "43f62726-6db5-59d8-a65d-6482ea48a157" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\pm 2\\sqrt{2}" :db/id #edb/ref 17592186545328} {:answer/id #uuid "492c1b78-ce03-55b1-9771-7be25a941eaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\pm 2\\sqrt{5}" :db/id #edb/ref 17592186545338} {:answer/id #uuid "9ba5b039-42c1-5f88-a8de-65c4f49d3c7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=2\\sqrt{10}" :db/id #edb/ref 17592186545481}] :answer-field/correct {:answer/id #uuid "000f3d81-c5d0-5946-b172-3bf3fe65444a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\pm 2\\sqrt{10}" :db/id #edb/ref 17592186545200} :answer-field/id #uuid "74304a95-1479-50c8-b9fd-11f3f0128771" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186545722}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9a2ec726-00b7-5cc7-85a6-cb62e4711dd2" :question/math-academy-id "q-12796" :question/problem "Find $a$ if ${a}^{2}=40.$" :question/worked-solution "We take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{a}^{2}} & =\\sqrt{40} \\\\ |a| & =\\sqrt{4\\cdot 10} \\\\ |a| & =\\sqrt{4}\\cdot \\sqrt{10} \\\\ |a| & =2\\sqrt{10} \\\\ a & =\\pm 2\\sqrt{10}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186545817 :knowledge-point/_questions [{:db/id #edb/ref 17592186068727 :knowledge-point/id #uuid "a21c64f2-1b4b-54b3-a8a1-70ca63330e04" :knowledge-point/title "Solving Equations With Radical Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "174968af-4f97-5fc2-96c1-946a1318679f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 2\\sqrt{6}" :db/id #edb/ref 17592186545243} {:answer/id #uuid "1787098a-f4be-583e-8b74-371cf41e0f4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 3\\sqrt{2}" :db/id #edb/ref 17592186545244} {:answer/id #uuid "1f6a6925-66ac-5529-a6b8-a5006b6b8998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 4\\sqrt{3}" :db/id #edb/ref 17592186545260} {:answer/id #uuid "260a6d7a-9e0e-525f-a529-7e99511654a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\sqrt{6}" :db/id #edb/ref 17592186545281} {:answer/id #uuid "81d4dc11-5639-5bc7-9888-4db8339d8ad3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 2\\sqrt{3}" :db/id #edb/ref 17592186545440}] :answer-field/correct {:answer/id #uuid "81d4dc11-5639-5bc7-9888-4db8339d8ad3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 2\\sqrt{3}" :db/id #edb/ref 17592186545440} :answer-field/id #uuid "825ca9e2-d349-54be-8ff8-677e119c487a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186545731}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "48d8f1b2-776f-5613-8b52-d9e267acd25f" :question/math-academy-id "q-56116" :question/problem "Find $a$ if ${a}^{2}-6=6.$" :question/worked-solution "First, we isolate the ${a}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}{a}^{2}-6 & =6 \\\\ {a}^{2} & =12\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{a}^{2}} & =\\sqrt{12} \\\\ |a| & =\\sqrt{12} \\\\ |a| & =\\sqrt{4\\cdot 3} \\\\ |a| & =\\sqrt{4}\\cdot \\sqrt{3} \\\\ |a| & =2\\sqrt{3} \\\\ a & =\\pm 2\\sqrt{3}\\end{aligned}\n$$"}]}
