ation:\n\n$$\n\\begin{aligned}3{z}^{2}-\\frac{25}{12} & =0 \\\\ 3{z}^{2} & =\\frac{25}{12} \\\\ {z}^{2} & =\\frac{25}{36}\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{z}^{2}} & =\\sqrt{\\frac{25}{36}} \\\\ |z| & =\\frac{\\sqrt{25}}{\\sqrt{36}} \\\\ |z| & =\\frac{5}{6} \\\\ z & =\\pm \\frac{5}{6}\\end{aligned}\n$$"] ["question-af7384d0-ffc3-51cc-833d-b329ee1b978c" :question/difficulty :question.difficulty/hard] ["answer-field-2138cdc1-7319-514a-94f4-c743a1b5525e" :answer-field/id #uuid "2138cdc1-7319-514a-94f4-c743a1b5525e"] ["answer-dae9e2a6-948b-5b95-a02c-61c1a8d0f2ce" :answer/id #uuid "dae9e2a6-948b-5b95-a02c-61c1a8d0f2ce"] ["answer-dae9e2a6-948b-5b95-a02c-61c1a8d0f2ce" :answer/type :answer.type/math] ["answer-dae9e2a6-948b-5b95-a02c-61c1a8d0f2ce" :answer/value "z=\\frac{5}{6}"] ["answer-363dd3dd-0402-51c3-b564-d0f77502fd2e" :answer/id #uuid "363dd3dd-0402-51c3-b564-d0f77502fd2e"] ["answer-363dd3dd-0402-51c3-b564-d0f77502fd2e" :answer/type :answer.type/math] ["answer-363dd3dd-0402-51c3-b564-d0f77502fd2e" :answer/value "z=\\pm 5"] ["answer-58910719-15f1-5c10-aba5-c08657d568a9" :answer/id #uuid "58910719-15f1-5c10-aba5-c08657d568a9"] ["answer-58910719-15f1-5c10-aba5-c08657d568a9" :answer/type :answer.type/math] ["answer-58910719-15f1-5c10-aba5-c08657d568a9" :answer/value "z=\\pm 6"] ["answer-5d867956-1afa-545a-8d5e-158bee736d9a" :answer/id #uuid "5d867956-1afa-545a-8d5e-158bee736d9a"] ["answer-5d867956-1afa-545a-8d5e-158bee736d9a" :answer/type :answer.type/math] ["answer-5d867956-1afa-545a-8d5e-158bee736d9a" :answer/value "z=\\pm \\frac{5}{6}"] ["answer-9ee5e500-cf1f-5e17-88ce-c0068943b54e" :answer/id #uuid "9ee5e500-cf1f-5e17-88ce-c0068943b54e"] ["answer-9ee5e500-cf1f-5e17-88ce-c0068943b54e" :answer/type :answer.type/math] ["answer-9ee5e500-cf1f-5e17-88ce-c0068943b54e" :answer/value "z=\\pm \\frac{6}{5}"] ["answer-field-2138cdc1-7319-514a-94f4-c743a1b