dge-point/questions "question-9a2ec726-00b7-5cc7-85a6-cb62e4711dd2"] ["question-48d8f1b2-776f-5613-8b52-d9e267acd25f" :question/id #uuid "48d8f1b2-776f-5613-8b52-d9e267acd25f"] ["question-48d8f1b2-776f-5613-8b52-d9e267acd25f" :question/math-academy-id "q-56116"] ["question-48d8f1b2-776f-5613-8b52-d9e267acd25f" :question/problem "Find $a$ if ${a}^{2}-6=6.$"] ["question-48d8f1b2-776f-5613-8b52-d9e267acd25f" :question/worked-solution "First, we isolate the ${a}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}{a}^{2}-6 & =6 \\\\ {a}^{2} & =12\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{a}^{2}} & =\\sqrt{12} \\\\ |a| & =\\sqrt{12} \\\\ |a| & =\\sqrt{4\\cdot 3} \\\\ |a| & =\\sqrt{4}\\cdot \\sqrt{3} \\\\ |a| & =2\\sqrt{3} \\\\ a & =\\pm 2\\sqrt{3}\\end{aligned}\n$$"] ["question-48d8f1b2-776f-5613-8b52-d9e267acd25f" :question/difficulty :question.difficulty/easy] ["answer-field-825ca9e2-d349-54be-8ff8-677e119c487a" :answer-field/id #uuid "825ca9e2-d349-54be-8ff8-677e119c487a"] ["answer-81d4dc11-5639-5bc7-9888-4db8339d8ad3" :answer/id #uuid "81d4dc11-5639-5bc7-9888-4db8339d8ad3"] ["answer-81d4dc11-5639-5bc7-9888-4db8339d8ad3" :answer/type :answer.type/math] ["answer-81d4dc11-5639-5bc7-9888-4db8339d8ad3" :answer/value "\\pm 2\\sqrt{3}"] ["answer-174968af-4f97-5fc2-96c1-946a1318679f" :answer/id #uuid "174968af-4f97-5fc2-96c1-946a1318679f"] ["answer-174968af-4f97-5fc2-96c1-946a1318679f" :answer/type :answer.type/math] ["answer-174968af-4f97-5fc2-96c1-946a1318679f" :answer/value "\\pm 2\\sqrt{6}"] ["answer-1787098a-f4be-583e-8b74-371cf41e0f4e" :answer/id #uuid "1787098a-f4be-583e-8b74-371cf41e0f4e"] ["answer-1787098a-f4be-583e-8b74-371cf41e0f4e" :answer/type :answer.type/math] ["answer-1787098a-f4be-583e-8b74-371cf41e0f4e" :answer/value "\\pm 3\\sqrt{2}"] ["answer-1f6a6925-66ac-5529-a6b8-a5006b6b8998" :answer/id #uuid "1f6a6925-66ac-5529-a6b8-a5006b6b8998