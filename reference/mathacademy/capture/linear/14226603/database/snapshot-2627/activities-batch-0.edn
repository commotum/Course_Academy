#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186069617} :activity/id #uuid "10771a71-8e46-50cc-b75f-ab2b84a9afeb" :activity/scope {:db/id #edb/ref 17592186048187 :topic/id #uuid "86a29d40-d28e-53d5-b56d-cdcc72f7fe80" :topic/math-academy-id 430} :activity/steps [{:db/id #edb/ref 17592186069617 :step/content {:db/id #edb/ref 17592186070019 :tutorial/content "When an equation contains an $x^2$ term and a constant, it can be solved using the **square root method**. The square root method makes use of the fact that\n\n$$\n\\sqrt{x^2} = \\vert x \\vert \\,.\n$$\n\nTo illustrate, we can solve the equation $2x^2-18=0$ using the following three steps:\n\n1\\. Isolate the $x^2$ on one side of the equation:\n\n  $$\n  \\begin{aligned}2{x}^{2}-18 & =0 \\\\ 2{x}^{2} & =18 \\\\ {x}^{2} & =9\\end{aligned}\n  $$\n\n2\\. Take the square root of both sides of the equation\n\n  $$\n  \\begin{aligned}\\sqrt{{x}^{2}} & =\\sqrt{9} \\\\ |x| & =3\\end{aligned}\n  $$\n\n3\\. Solve the resulting absolute value equation:\n\n  $$\n  \\begin{aligned}x & =3\\,\\text{or}\\,x=-3\\end{aligned}\n  $$\n\nSo, there are two solutions, $x=3$ and $x=-3.$ We can write this more concisely as $x= \\pm 3,$ where the \"$\\pm$\" symbol stands for \"plus or minus.\"" :tutorial/id #uuid "7ef92091-e041-5715-ac4e-75fa146c4cea" :tutorial/math-academy-id 8692 :tutorial/title "Introduction"} :step/id #uuid "6a92a024-3077-5b06-9926-573d76e002f6" :step/math-academy-id 165690 :step/next {:db/id #edb/ref 17592186069618}} {:db/id #edb/ref 17592186069618 :step/content {:db/id #edb/ref 17592186068725 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068475 :question/id #uuid "fed35802-1128-5cb4-a91b-e98227dcfba8" :question/math-academy-id "e-13966"} :knowledge-point/id #uuid "f544d0a4-24ce-5078-ad9d-93e733c091e6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048267} {:db/id #edb/ref 17592186049843}] :knowledge-point/questions [{:db/id #edb/ref 17592186069222} {:db/id #edb/ref 17592186069263} {:db/id #edb/ref 17592186069340} {:db/id #edb/ref 17592186487308} {:db/id #edb/ref 17592186487400}] :knowledge-point/title "Solving Equations With Integer Solutions"} :step/id #uuid "e261bc60-5f18-5ce3-8444-d66fb71d6b56" :step/math-academy-id 165691 :step/next {:db/id #edb/ref 17592186069619}} {:db/id #edb/ref 17592186069619 :step/content {:db/id #edb/ref 17592186068726 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068476 :question/id #uuid "6145c2d5-5d09-543c-8405-1319277323aa" :question/math-academy-id "e-13968"} :knowledge-point/id #uuid "6c5d24fa-8a65-5c20-bb50-530ca8dcf061" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050315}] :knowledge-point/questions [{:db/id #edb/ref 17592186069138} {:db/id #edb/ref 17592186069173} {:db/id #edb/ref 17592186069341} {:db/id #edb/ref 17592186487300} {:db/id #edb/ref 17592186487346} {:db/id #edb/ref 17592186492907} {:db/id #edb/ref 17592186492916}] :knowledge-point/title "Solving Equations With Fractional Solutions"} :step/id #uuid "f81f6359-676f-52fc-9e50-90a17ad8c71b" :step/math-academy-id 165695 :step/next {:db/id #edb/ref 17592186069620}} {:db/id #edb/ref 17592186069620 :step/content {:db/id #edb/ref 17592186068727 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068477 :question/id #uuid "9c00e3e1-9337-5380-af51-e7e8c7ae9f48" :question/math-academy-id "e-13970"} :knowledge-point/id #uuid "a21c64f2-1b4b-54b3-a8a1-70ca63330e04" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049923}] :knowledge-point/questions [{:db/id #edb/ref 17592186069036} {:db/id #edb/ref 17592186069139} {:db/id #edb/ref 17592186069163} {:db/id #edb/ref 17592186487289} {:db/id #edb/ref 17592186487296} {:db/id #edb/ref 17592186487318} {:db/id #edb/ref 17592186487406} {:db/id #edb/ref 17592186492883}] :knowledge-point/title "Solving Equations With Radical Solutions"} :step/id #uuid "116d4e70-b784-54f1-b8a9-1880b475e2a2" :step/math-academy-id 165699}] :activity/title "Solving Equations Using the Square Root Method" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068962}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186492934} :activity/id #uuid "e5862109-bc69-574a-aa55-2c8e894e10bd" :activity/scope {:db/id #edb/ref 17592186048187 :topic/id #uuid "86a29d40-d28e-53d5-b56d-cdcc72f7fe80" :topic/math-academy-id 430} :activity/steps [{:db/id #edb/ref 17592186492934 :step/content {:db/id #edb/ref 17592186492907 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a6f09a0-ccd7-5f3c-b936-37c4d8190186" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{3}{7}" :db/id #edb/ref 17592186492363} {:answer/id #uuid "72c93668-102e-59cf-bbee-5a2ec27c8f74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\pm \\frac{3}{7}" :db/id #edb/ref 17592186492444} {:answer/id #uuid "8bbf1f51-b87d-56f3-a2e4-c8c1a5907fb8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\pm \\frac{7}{3}" :db/id #edb/ref 17592186492494} {:answer/id #uuid "aabe0e05-f4e4-5dba-8d77-0379c8bb7619" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\pm \\frac{3}{49}" :db/id #edb/ref 17592186492562} {:answer/id #uuid "d05fdd44-d514-56b7-a034-70edb6be2559" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\pm \\frac{9}{7}" :db/id #edb/ref 17592186492631}] :answer-field/correct {:db/id #edb/ref 17592186492444} :answer-field/id #uuid "52cb84e8-9f4d-596d-8658-8754ec0aa693" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492737}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c009e53d-f124-53fe-9bd5-4569b0faacf3" :question/math-academy-id "q-78906" :question/problem "Solve for $x$ where $\\frac{{x}^{2}}{2}=\\frac{9}{98}.$" :question/worked-solution "First, we isolate the ${x}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{2} & =\\frac{9}{98} \\\\ {x}^{2} & =\\frac{9\\cdot 2}{98} \\\\ {x}^{2} & =\\frac{9}{49}\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}} & =\\sqrt{\\frac{9}{49}} \\\\ |x| & =\\frac{\\sqrt{9}}{\\sqrt{49}} \\\\ |x| & =\\frac{3}{7} \\\\ x & =\\pm \\frac{3}{7}\\end{aligned}\n$$"} :step/id #uuid "1c1afa0a-f568-5caf-ba70-ff3df6c7dca6" :step/next {:db/id #edb/ref 17592186492940}} {:db/id #edb/ref 17592186492940 :step/content {:db/id #edb/ref 17592186492916 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7524c348-11f2-59fe-89ce-2554d91064a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm \\frac{5}{7}" :db/id #edb/ref 17592186492451}] :answer-field/correct {:db/id #edb/ref 17592186492451} :answer-field/id #uuid "246155e5-4b6f-5296-89cb-0ce66033efc4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186492717}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dc9b5d6a-36da-5369-a8e0-149a58110d0a" :question/math-academy-id "q-218577" :question/problem "If $49{a}^{2}+12=37,$ then $a=${{field-1}}." :question/worked-solution "First, we isolate the ${a}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}49{a}^{2}+12 & =37 \\\\ 49{a}^{2} & =25 \\\\ {a}^{2} & =\\frac{25}{49}\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{a}^{2}} & =\\sqrt{\\frac{25}{49}} \\\\ |a| & =\\frac{\\sqrt{25}}{\\sqrt{49}} \\\\ |a| & =\\frac{5}{7} \\\\ a & =\\pm \\frac{5}{7}\\end{aligned}\n$$"} :step/id #uuid "3342109e-04c1-5840-b62d-667fd5a7fffe" :step/next {:db/id #edb/ref 17592186492966}} {:db/id #edb/ref 17592186492966 :step/content {:db/id #edb/ref 17592186492883 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b1bc9b8-0ea0-52cc-a644-25016e73c24b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm 3\\sqrt{5}" :db/id #edb/ref 17592186492465}] :answer-field/correct {:db/id #edb/ref 17592186492465} :answer-field/id #uuid "fb6954e1-945b-51aa-b2d8-20a643556b8d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186492816}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "90d6c1a2-df8a-556c-89a1-d672dd78eab8" :question/math-academy-id "q-218588" :question/problem "Solve the equation ${v}^{2}=45.$ Express your final answer in its simplest form.\n\n$v=$\n\n{{field-1}}" :question/worked-solution "We take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{v}^{2}} & =\\sqrt{45} \\\\ |v| & =\\sqrt{9\\cdot 5} \\\\ |v| & =\\sqrt{9}\\cdot \\sqrt{5} \\\\ |v| & =3\\sqrt{5} \\\\ v & =\\pm 3\\sqrt{5}\\end{aligned}\n$$"} :step/id #uuid "88a5c700-3e29-5300-852c-85cc903204b4"}] :activity/title "Solving Equations Using the Square Root Method" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186492220}]}
