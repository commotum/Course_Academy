#{[{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186084135} :activity/id #uuid "93504fb3-0cac-5a79-88f9-a68a78187dd4" :activity/scope {:db/id #edb/ref 17592186050551 :topic/id #uuid "52c5223b-6fe6-5437-ac08-e4f0cd89565a" :topic/math-academy-id 727} :activity/steps [{:db/id #edb/ref 17592186084135 :step/content {:db/id #edb/ref 17592186084455 :tutorial/content "We have learned how to solve quadratic equations by factoring. Just like quadratic equations, some (but not all) cubic equations can also be solved by factoring.\n\nTo solve a cubic equation by factoring, we just need to follow three steps:\n\n1\\. Write the equation with $0$ on one side\n\n2\\. Factor the expression on the other side\n\n3\\. Set each factor equal to $0$ and solve\n\nTo factor the cubic, we can often use the method of grouping.\n\n**Note:** The cubic equations in the following examples can all be factored, but keep in mind that most cubic equations cannot be!" :tutorial/id #uuid "3c5846e9-07ca-5d29-824a-9bb84c33473a" :tutorial/math-academy-id 3710 :tutorial/title "Introduction"} :step/id #uuid "007ccdec-9f76-50fb-9833-3a3f6ac946e8" :step/math-academy-id 20914 :step/next {:db/id #edb/ref 17592186084194}} {:db/id #edb/ref 17592186084156 :step/content {:db/id #edb/ref 17592186083246 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083042 :question/id #uuid "edbd084f-e8ad-53e7-9384-94094a6e7bc6" :question/math-academy-id "e-5879"} :knowledge-point/id #uuid "385b1ccd-ea68-5c59-a0e6-1a0bb7937460" :knowledge-point/questions [{:db/id #edb/ref 17592186083532} {:db/id #edb/ref 17592186083533} {:db/id #edb/ref 17592186233448} {:db/id #edb/ref 17592186233450} {:db/id #edb/ref 17592186520493}] :knowledge-point/title "Solving Cubic Equations With Leading Coefficients by Grouping"} :step/id #uuid "1f4ae760-dcdb-5fe7-ad58-6d57db23484b" :step/math-academy-id 21147 :step/next {:db/id #edb/ref 17592186084195}} {:db/id #edb/ref 17592186084157 :step/content {:db/id #edb/re