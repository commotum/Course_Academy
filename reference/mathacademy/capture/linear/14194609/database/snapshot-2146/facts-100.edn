db/ref 17592186048921 #edb/ref 17592186045417] [17592186508032 #edb/ref 1088 #edb/ref 17592186050514 #edb/ref 17592186045417] [17592186508032 #edb/ref 1088 #edb/ref 17592186051041 #edb/ref 17592186045417] [17592186508032 #edb/ref 1089 #edb/ref 17592186508033 #edb/ref 17592186045417] [17592186508032 #edb/ref 1090 #uuid "fa5d8411-d4a1-5b32-ac8c-8e8a3fb8068d" #edb/ref 17592186045417] [17592186508033 #edb/ref 1084 #edb/ref 17592186508122 #edb/ref 17592186045417] [17592186508033 #edb/ref 1084 #edb/ref 17592186508126 #edb/ref 17592186045417] [17592186508033 #edb/ref 1084 #edb/ref 17592186508129 #edb/ref 17592186045417] [17592186508033 #edb/ref 1084 #edb/ref 17592186508130 #edb/ref 17592186045417] [17592186508033 #edb/ref 1084 #edb/ref 17592186508131 #edb/ref 17592186045417] [17592186508033 #edb/ref 1084 #edb/ref 17592186508136 #edb/ref 17592186045417] [17592186508033 #edb/ref 1084 #edb/ref 17592186508142 #edb/ref 17592186045417] [17592186508033 #edb/ref 1084 #edb/ref 17592186508150 #edb/ref 17592186045417] [17592186508033 #edb/ref 1085 "![](images/03/0353900626189bbb7f009b5b36909ca584520325c2eb515047f48700bffdc2a5.png)\n\n \n\nA part of a mosaic consisting of regular octagons and squares is shown above." #edb/ref 17592186045417] [17592186508033 #edb/ref 1086 #uuid "3b2744b7-1cb0-57fe-b93d-862607556a2a" #edb/ref 17592186045417] [17592186508033 #edb/ref 1087 #edb/ref 17592186508129 #edb/ref 17592186045417] [17592186508035 #edb/ref 1068 #edb/ref 17592186507963 #edb/ref 17592186045417] [17592186508035 #edb/ref 1069 "q-134600" #edb/ref 17592186045417] [17592186508035 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186508035 #edb/ref 1071 "Find the value of $\\gamma $, the angle shown in trapezoid $D.$\n\n$\\gamma =$  \n{{field-1}}${}^{∘}$" #edb/ref 17592186045417] [17592186508035 #edb/ref 1072 #uuid "0199ac32-0250-5816-84be-6c71995ddb1d" #edb/ref 17592186045417] [17592186508035 #edb/ref 1074 "Let's label the vertices of trapezoid $D$ as follows:\n\n![](images/14/14814c5373405af8211f12b18f591c7a9c34645bfc8396b8304d6fcc73f5a539.png)\n\n \n\nIn step 1, we found that measures of the interior angles of a regular octagon equal\n\n$$\nm∠O=m∠N={135}^{∘}.\n$$\n\nThe sum of the measures of the interior angles for the trapezoid equals ${360}^{∘}.$\n\nTherefore, we can find $\\gamma $ by summing the measures of the interior angles of the trapezoid $D.$ We get \n\n$$\n\\begin{aligned}m∠M+m∠N+m∠O+m∠P & ={360}^{∘} \\\\ \\gamma +{135}^{∘}+{135}^{∘}+\\gamma  & ={360}^{∘} \\\\ {270}^{∘}+2\\gamma  & ={360}^{∘} \\\\ 2\\gamma  & ={90}^{∘} \\\\ \\gamma  & ={45}^{∘}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186508044 #edb/ref 1068 #edb/ref 17592186508001 #edb/ref 17592186045417] [17592186508044 #edb/ref 1069 "q-134549" #edb/ref 17592186045417] [17592186508044 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186508044 #edb/ref 1071 "Determine the measure of angle $\\alpha .$\n\n$\\alpha =$  \n{{field-1}}${}^{∘}$" #edb/ref 17592186045417] [17592186508044 #edb/ref 1072 #uuid "0e7a888c-cec5-5044-9f5d-6a42f018a041" #edb/ref 17592186045417] [17592186508044 #edb/ref 1074 "From the graph, angle $\\alpha $ is an interior angle of a regular octagon.\n\nA regular octagon is an $8$-sided polygon where all the interior angles have the same measure.\n\nThe sum of the measures of the interior angles for the $n$-sided polygon equals\n\n$$\n{180}^{∘}\\times (n-2).\n$$\n\n \n\nTherefore, the sum of the measures of the interior angles of a regular octagon is\n\n$$\n{180}^{∘}\\times (8-2)=1\\,{080}^{∘}.\n$$\n\n \n\nTherefore, the measure of each interior angle is \n\n$$\n\\alpha =\\frac{1\\,{080}^{∘}}{8}={135}^{∘}.\n$$" #edb/ref 17592186045417] [17592186508050 #edb/ref 1068 #edb/ref 17592186507955 #edb/ref 17592186045417] [17592186508050 #edb/ref 1069 "q-134550" #edb/ref 17592186045417] [17592186508050 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186508050 #edb/ref 1071 "Given that all four squares shown in the diagram are congruent, find the perimeter $p$ of square $B.$\n\n$p=$  \n{{field-1}}$cm$" #edb/ref 17592186045417] [17592186508050 #edb/ref 1072 #uuid "160e2a67-96cf-5111-8246-74329f1cd311" #edb/ref 17592186045417] [17592186508050 #edb/ref 1074 "Since all the squares in the graph are congruent, their sides are of equal length. \n\nFrom the graph, the measure of one of the sides is $5\\,cm$, so all four sides of square $B$ have length $5\\,cm.$\n\nThe perimeter $p$ of a polygon is the sum of the measures of all its sides. Therefore, we have\n\n$$\np=4\\cdot 5=20\\,cm.\n$$" #edb/ref 17592186045417] [17592186508056 #edb/ref 1068 #edb/ref 17592186507983 #edb/ref 17592186045417] [17592186508056 #edb/ref 1069 "q-134595" #edb/ref 17592186045417] [17592186508056 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186508056 #edb/ref 1071 "Polygon $A$ is congruent to polygon{{field-1}} (enter the polygon's label)." #edb/ref 17592186045417] [17592186508056 #edb/ref 1072 #uuid "34ed8780-12db-5c6f-9281-2e2a475215ec" #edb/ref 17592186045417] [17592186508056 #edb/ref 1074 "In general, congruent polygons have the same shape. In other words:\n\n* they have the same number of sides,\n\n* all corresponding sides are congruent, and\n\n* all corresponding interior angles are congruent.\n\nWith that in mind, let's compare polygons $B$ and $D$ to $A.$\n\n* The polygon $A$ is an octagon (it has $8$ sides). So, the polygons $B$ and $D$ can't be congruent to the polygon $A$ because they do not have $8$ sides.\n\n* On the other hand, $A$ and $C$ have the same shape: they have congruent corresponding sides, and since they are regular polygons, congruent corresponding angles. This implies that $A≅C.$" #edb/ref 17592186045417] [17592186508083 #edb/ref 1068 #edb/ref 17592186507977 #edb/ref 17592186045417] [17592186508083 #edb/ref 1069 "q-134617" #edb/ref 17592186045417] [17592186508083 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186508083 #edb/ref 1071 "Find the perimeter of the entire figure.\n\n$p=$  \n{{field-1}}$cm$" #edb/ref 17592186045417] [17592186508083 #edb/ref 1072 #uuid "922cc406-bf6e-549f-8f16-dbc5eef7f87b" #edb/ref 17592186045417] [17592186508083 #edb/ref 1074 "The perimeter $p$ of a polygon is the sum of the measures of all its sides.\n\nSince there are $24$ sides in total, and sides of the given figure are equal with length $5\\,cm$, we have \n\n$$\np=24\\cdot 5=120\\,cm.\n$$" #edb/ref 17592186045417] [17592186508095 #edb/ref 1068 #edb/ref 17592186507949 #edb/ref 17592186045417] [17592186508095 #edb/ref 1069 "q-134601" #edb/ref 17592186045417] [17592186508095 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186508095 #edb/ref 1071 "Given that $\\delta =(3y-15)^{∘},$ find the value of $y.$\n\n$y=$  \n{{field-1}}" #edb/ref 17592186045417] [17592186508095 #edb/ref 1072 #uuid "bf6b20ed-8b8a-511e-9502-26f8a79629b1" #edb/ref 17592186045417] [17592186508095 #edb/ref 1074 "Since the two bases of the trapezoid $D$ are parallel, angles $\\delta $ and $\\gamma $ in the graph are alternate interior angles and consequently, they have the same measure. So, we have\n\n$$\n\\begin{aligned}\\delta  & =\\gamma ={45}^{∘}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\delta  & ={45}^{∘} \\\\ (3y-15)^{∘} & ={45}^{∘} \\\\ 3y-15 & =45 \\\\ 3y & =60 \\\\ y & =20.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186508109 #edb/ref 1068 #edb/ref 17592186507997 #edb/ref 17592186045417] [17592186508109 #edb/ref 1069 "q-134616" #edb/ref 17592186045417] [17592186508109 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186508109 #edb/ref 1071 "Find the measure of the exterior angle $\\omega .$\n\n$\\omega =$  \n{{field-1}}${}^{∘}$" #edb/ref 17592186045417] [17592186508109 #edb/ref 1072 #uuid "e422e657-fc67-5f57-8e3f-8fd6f2f37149" #edb/ref 17592186045417] [17592186508109 #edb/ref 1074 "The angle $\\omega $ is the sum of the measures of the exterior angles of a regular octagon and a square.\n \n\n![](images/25/2586359b460d4e4ce0324b21caa9328f1d319ebdefa5f7118aaa4719973cb79d.png)\n\n \n\nFor any polygon, the exterior angles sum to ${360}^{∘}.$ In a regular octagon, there are $8$ equivalent exterior angles, so each has a measure of \n\n$$\n\\frac{{360}^{∘}}{8}={45}^{∘}.\n$$\n\nLikewise, in a square, there are $4$ equivalent exterior angles, so each has a measure of \n\n$$\n\\frac{{360}^{∘}}{4}={90}^{∘}.\n$$\n\nSo, since the shaded angle is the sum of the measures of exterior angles of a regular octagon and a square, it must have a measure of\n\n$$\n{45}^{∘}+{90}^{∘}={135}^{∘}.\n$$" #edb/ref 17592186045417] [17592186508112 #edb/ref 1068 #edb/ref 17592186507994 #edb/ref 17592186045417] [17592186508112 #edb/ref 1069 "q-134596" #edb/ref 17592186045417] [17592186508112 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186508112 #edb/ref 1071 "Find the value of $x$ given that $\\beta =(2x+3)^{∘}.$\n\n$x=$  \n{{field-1}}" #edb/ref 17592186045417] [17592186508112 #edb/ref 1072 #uuid "e9331587-ba62-51b2-9497-b1e12f18138c" #edb/ref 17592186045417] [17592186508112 #edb/ref 1074 "The angle $\\beta $ is an angle obtained after bisecting one of the interior angles of a square by a diagonal. Therefore, we must have \n\n$$\n\\beta =\\frac{{90}^{∘}}{2}={45}^{∘}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\beta  & ={45}^{∘} \\\\ (2x+3)^{∘} & ={45}^{∘} \\\\ 2x+3 & =45 \\\\ 2x & =42 \\\\ x & =21.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186508121 #edb/ref 1062 #uuid "209e9668-9299-5ef2-8569-2207f557593d" #edb/ref 17592186045417] [17592186508121 #edb/ref 1063 #edb/ref 17592186508032 #edb/ref 17592186045417] [17592186508122 #edb/ref 1058 #edb/ref 17592186508130 #edb/ref 17592186045417] [17592186508122 #edb/ref 1062 #uuid "243095fd-f2f7-5a43-8444-5d732b6aaddb" #edb/ref 17592186045417] [17592186508122 #edb/ref 1063 #edb/ref 17592186508109 #edb/ref 17592186045417] [17592186508126 #edb/ref 1058 #edb/ref 17592186508131 #edb/ref 17592186045417] [17592186508126 #edb/ref 1062 #uuid "37891410-298a-5507-a41a-daa799b65788" #edb/ref 17592186045417] [17592186508126 #edb/ref 1063 #edb/ref 17592186508112 #edb/ref 17592186045417] [17592186508129 #edb/ref 1058 #edb/ref 17592186508136 #edb/ref 17592186045417] [17592186508129 #edb/ref 1062 #uuid "42229977-027b-5fb0-8642-9ec41c9f66e2" #edb/ref 17592186045417] [17592186508129 #edb/ref 1063 #edb/ref 17592186508044 #edb/ref 17592186045417] [17592186508130 #edb/ref 1062 #uuid "46a3ffb7-b975-549b-b574-519f79cb1523" #edb/ref 17592186045417] [17592186508130 #edb/ref 1063 #edb/ref 17592186508083 #edb/ref 17592186045417] [17592186508131 #edb/ref 1058 #edb/ref 17592186508150 #edb/ref 17592186045417] [17592186508131 #edb/ref 1062 #uuid "57464aba-791c-59a0-8216-21e1028be36a" #edb/ref 17592186045417] [17592186508131 #edb/ref 1063 #edb/ref 17592186508035 #edb/ref 17592186045417] [17592186508136 #edb/ref 1058 #edb/ref 17592186508142 #edb/ref 17592186045417] [17592186508136 #edb/ref 1062 #uuid "629ce222-cd6e-5b09-a05d-4fab322d8235" #edb/ref 17592186045417] [17592186508136 #edb/ref 1063 #edb/ref 17592186508056 #edb/ref 17592186045417] [17592186508142 #edb/ref 1058 #edb/ref 17592186508126 #edb/ref 17592186045417] [17592186508142 #edb/ref 1062 #uuid "8590ac05-1261-5904-b49b-9f553a79867a" #edb/ref 17592186045417] [17592186508142 #edb/ref 1063 #edb/ref 17592186508050 #edb/ref 17592186045417] [17592186508150 #edb/ref 1058 #edb/ref 17592186508122 #edb/ref 17592186045417] [17592186508150 #edb/ref 1062 #uuid "aedb7621-fad9-55ec-8e8a-ac1a5083ed6f" #edb/ref 17592186045417] [17592186508150 #edb/ref 1063 #edb/ref 17592186508095 #edb/ref 17592186045417]}
