#{[{:activity/first-step {:db/id #edb/ref 17592186111770} :activity/id #uuid "0be09731-4b99-5a42-a70e-c1f672108f62" :activity/scope {:db/id #edb/ref 17592186048360 :topic/id #uuid "9894c8b0-6628-5c7a-b1f4-a6bfebc14d33" :topic/math-academy-id 1461} :activity/steps [{:db/id #edb/ref 17592186111429 :step/content {:db/id #edb/ref 17592186111858 :tutorial/content "The diagonals of a rectangle are equal and bisect each other. Consequently, they divide a rectangle into four isosceles triangles, as shown below.\n\n![](images/4f/4f0aafdf04bb7f967122fc8f90454b1b09787e375857bac3bcf5fdf80925e32c.png)\n\nIn a square, the diagonals also bisect the angles.\n\n![](images/cd/cd61fabe993fa6cde5ea4020a659e86b3543597d70a304b3e5ada3abfa426186.png)" :tutorial/id #uuid "4643230c-067e-5817-af66-88717e7b8c66" :tutorial/math-academy-id 2357 :tutorial/title "The Diagonals of Rectangles and Squares"} :step/id #uuid "11275c8d-5eda-5537-b710-43e9d7986214" :step/math-academy-id 10171 :step/next {:db/id #edb/ref 17592186111773}} {:db/id #edb/ref 17592186111770 :step/content {:db/id #edb/ref 17592186111848 :tutorial/content "A **rectangle** is a parallelogram where all angles are right. It has all the properties of parallelograms: its opposite sides are parallel and congruent.\n\n![](images/1f/1fa96b5993a48483798ff4ac05d75f1ffa271f82e5ed6e61a452eb97b3daf3e4.png)\n\nIf all $4$ sides of a rectangle are congruent, then it is a **square**.\n\n![](images/82/822788813f0e81eebef50f324e1bcaf329e7fa5552e10557a19d20b4e868063e.png)" :tutorial/id #uuid "1fb26940-464f-55d2-9903-b4695c595b5f" :tutorial/math-academy-id 2270 :tutorial/title "Introduction"} :step/id #uuid "337c70d4-a057-5cca-a1b3-1b562ca18243" :step/math-academy-id 9475 :step/next {:db/id #edb/ref 17592186111771}} {:db/id #edb/ref 17592186111771 :step/content {:db/id #edb/ref 17592186110780 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110409 :question/id #uuid "b5149f89-fb8c-5a67-9cd6-08742f659b57" :question/math-academy-id "e-2850"} :knowledge-point/id #uuid "71118d0d-bd31-5af1-a881-608b88f777d2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050585}] :knowledge-point/questions [{:db/id #edb/ref 17592186111286} {:db/id #edb/ref 17592186111287}] :knowledge-point/title "Finding the Value of a Variable That Makes a Rectangle a Square"} :step/id #uuid "d1cc100b-1e40-5423-9063-33792faf9ba3" :step/math-academy-id 9477 :step/next {:db/id #edb/ref 17592186111772}} {:db/id #edb/ref 17592186111772 :step/content {:db/id #edb/ref 17592186110781 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110410 :question/id #uuid "2e99f745-a0e5-5242-8767-2f26ab39108d" :question/math-academy-id "e-2852"} :knowledge-point/id #uuid "6ff69d0d-cc28-5528-be82-d874fbecb064" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048921}] :knowledge-point/questions [{:db/id #edb/ref 17592186111288} {:db/id #edb/ref 17592186111289}] :knowledge-point/title "Finding the Measures of the Sides of a Rectangle"} :step/id #uuid "e9d3b922-be32-5148-9777-69106a03603f" :step/math-academy-id 9480 :step/next {:db/id #edb/ref 17592186111429}} {:db/id #edb/ref 17592186111773 :step/content {:db/id #edb/ref 17592186110782 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110411 :question/id #uuid "8b9285e6-2091-51ba-baf6-2d1b32cceacd" :question/math-academy-id "e-2853"} :knowledge-point/id #uuid "c9f0fffa-aef8-5f2e-af1b-32d67dd954a1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050357}] :knowledge-point/questions [{:db/id #edb/ref 17592186111290} {:db/id #edb/ref 17592186111292}] :knowledge-point/title "Finding the Measure of a Diagonal of a Square"} :step/id #uuid "bdf53605-b19b-5cf7-8ba7-50a6b1345a67" :step/math-academy-id 9482 :step/next {:db/id #edb/ref 17592186111774}} {:db/id #edb/ref 17592186111774 :step/content {:db/id #edb/ref 17592186110783 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110412 :question/id #uuid "e03d3b05-2333-5a65-ab82-b6cb839e9fba" :question/math-academy-id "e-2855"} :knowledge-point/id #uuid "0730375d-ba61-5f0a-85f3-23c9535f7a38" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048161} {:db/id #edb/ref 17592186049949}] :knowledge-point/questions [{:db/id #edb/ref 17592186111291} {:db/id #edb/ref 17592186111293} {:db/id #edb/ref 17592186508112}] :knowledge-point/title "Finding the Value of a Variable That Makes a Given Quadrilateral a Rectangle"} :step/id #uuid "d10125a1-a3c4-5723-8b84-ca4ef525a806" :step/math-academy-id 9486}] :activity/title "Properties of Rectangles and Squares" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110833}] [{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186055602} :activity/id #uuid "d26484f6-2f5d-5b6e-8df4-eb33b5788fd7" :activity/scope {:db/id #edb/ref 17592186048673 :topic/id #uuid "b3c9ca33-97a8-546e-af44-a9a7a7a71eb5" :topic/math-academy-id 66} :activity/steps [{:db/id #edb/ref 17592186055602 :step/content {:db/id #edb/ref 17592186056012 :tutorial/content "To solve an equation like $2x+4 =10$, we need to apply both the addition and multiplication principles.\n\nFirst, we apply the addition principle, subtracting $4$ from both sides:\n\n$$\n\\eqalign{\n    \t\t2x+4{\\color{red}\\:-\\:4} &=10{\\color{red}\\:-\\:4}\\\n               2x+0&=6\\\n\t\t2x &=6\n\t}\n$$\n\nSecond, we apply the multiplication principle, dividing both sides by $2\\mathbin{:}$\n\n$$\n\\require{cancel}\n\t\\eqalign{\n    \t\t\\dfrac{2x}{\\color{red}2} &=\\dfrac{6}{\\color{red}2}\\\n                \\dfrac{\\cancel{2}x}{\\cancel{\\color{red}2}} &= 3 \\\n\t\tx &=3\n\t}\n$$\n\nSo $x=3$ is our solution. Let's plug this back into the original equation, to be sure that it's correct.\n\n$$\n\\begin{aligned}2x+4 & =10 \\\\ 2\\cdot 3+4 & =10 \\\\ 6+4 & =10 \\\\ 10 & =10\\,✓\\end{aligned}\n$$\n\n**Note:** When solving these types of equations, we always apply the addition principle first, and the multiplication principle second." :tutorial/id #uuid "f8f52cdf-9de7-5b27-addc-4bc35612fa15" :tutorial/math-academy-id 8055 :tutorial/title "Introduction"} :step/id #uuid "362ed182-60db-5089-b1e6-79bd2e6be30b" :step/math-academy-id 175799 :step/next {:db/id #edb/ref 17592186055603}} {:db/id #edb/ref 17592186055603 :step/content {:db/id #edb/ref 17592186054654 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054384 :question/id #uuid "8955a3ce-a161-5dc5-8ec0-c357a0403b46" :question/math-academy-id "e-12862"} :knowledge-point/id #uuid "b170bf27-76bc-5558-9133-e81a4760072f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048725} {:db/id #edb/ref 17592186050613}] :knowledge-point/questions [{:db/id #edb/ref 17592186054941} {:db/id #edb/ref 17592186055056} {:db/id #edb/ref 17592186055227} {:db/id #edb/ref 17592186486391} {:db/id #edb/ref 17592186486411} {:db/id #edb/ref 17592186503722}] :knowledge-point/title "Solving Linear Equations that Involve Multiplication"} :step/id #uuid "80f9fb5b-00db-570c-a6f4-98191654603b" :step/math-academy-id 175800 :step/next {:db/id #edb/ref 17592186055604}} {:db/id #edb/ref 17592186055604 :step/content {:db/id #edb/ref 17592186054655 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054385 :question/id #uuid "074b5213-4f4e-5d1b-a5c4-8b5403901b4d" :question/math-academy-id "e-12863"} :knowledge-point/id #uuid "52c2b31a-9b7a-52cb-9fa7-111de8bc53ea" :knowledge-point/questions [{:db/id #edb/ref 17592186055057} {:db/id #edb/ref 17592186055058} {:db/id #edb/ref 17592186055059} {:db/id #edb/ref 17592186055279} {:db/id #edb/ref 17592186486386} {:db/id #edb/ref 17592186486417}] :knowledge-point/title "Solving Linear Equations while Keeping the Variable on the Right-Hand Side"} :step/id #uuid "14f3a665-daa8-52a3-ae20-e94b27c5c513" :step/math-academy-id 175804 :step/next {:db/id #edb/ref 17592186055605}} {:db/id #edb/ref 17592186055605 :step/content {:db/id #edb/ref 17592186056013 :tutorial/content "Solving equations with both the addition and multiplication principles can be a lot of work. There are often many steps to write down. However, we don't have to write down all of the steps.\n\nFor example, when using the multiplication principle to solve\n\n$$\n\\dfrac{y}{2} = 5,\n$$\n\nthe set of full steps are as follows:\n\n$$\n\\begin{aligned}\\frac{y}{2} & =5 \\\\ 2\\cdot \\frac{y}{2} & =2\\cdot 5 \\\\ \\frac{2y}{2} & =10 \\\\ \\frac{\\cancel{2}y}{\\cancel{2}} & =10 \\\\ y & =10\\end{aligned}\n$$\n\nHowever, if we cancel out the $2$'s to indicate that they disappear, then we can skip writing down several of the steps.\n\n$$\n\\begin{aligned}\\frac{y}{2} & =5 \\\\ \\cancel{2}\\cdot \\frac{y}{\\cancel{2}} & =2\\cdot 5 \\\\ y & =10\\end{aligned}\n$$" :tutorial/id #uuid "f3b97f5f-3831-50b9-bb82-d4f1b7b6f8c0" :tutorial/math-academy-id 8056 :tutorial/title "Cancellation Notation"} :step/id #uuid "3130b1e1-9a50-5105-90e9-828c84b859a6" :step/math-academy-id 175809 :step/next {:db/id #edb/ref 17592186055606}} {:db/id #edb/ref 17592186055606 :step/content {:db/id #edb/ref 17592186054656 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054386 :question/id #uuid "1f5b9030-a5de-5ac2-95c4-2fbaf638cdab" :question/math-academy-id "e-12864"} :knowledge-point/id #uuid "ac53e171-0a02-5b74-8a3a-465dbecda9d7" :knowledge-point/questions [{:db/id #edb/ref 17592186055178} {:db/id #edb/ref 17592186055273} {:db/id #edb/ref 17592186486394} {:db/id #edb/ref 17592186486398} {:db/id #edb/ref 17592186508095}] :knowledge-point/title "Solving Linear Equations that Involve Division"} :step/id #uuid "827a7c9f-0805-5567-b393-4e871523a84e" :step/math-academy-id 175810 :step/next {:db/id #edb/ref 17592186055607}} {:db/id #edb/ref 17592186055607 :step/content {:db/id #edb/ref 17592186054657 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054387 :question/id #uuid "6ed7ae7f-2591-5747-9fa0-933260aaaebf" :question/math-academy-id "e-12866"} :knowledge-point/id #uuid "82077653-3463-5132-b0a9-8376fdb47319" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050637}] :knowledge-point/questions [{:db/id #edb/ref 17592186055179} {:db/id #edb/ref 17592186055421} {:db/id #edb/ref 17592186486396}] :knowledge-point/title "Solving Linear Equations that Involve Fractions"} :step/id #uuid "df8a8dfe-a623-5ae2-b654-42325ba5b869" :step/math-academy-id 175813}] :activity/title "Solving Two-Step Equations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054918}] [{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186106737} :activity/id #uuid "2fb56d40-545a-510d-a693-25bf992fdb77" :activity/scope {:db/id #edb/ref 17592186048921 :topic/id #uuid "cc9dbee5-9d12-52e7-a3e4-6d1b31e3ecaf" :topic/math-academy-id 1386} :activity/steps [{:db/id #edb/ref 17592186106737 :step/content {:db/id #edb/ref 17592186107044 :tutorial/content "Consider the triangle $\\triangle ABC$ shown below.\n\n![](images/46/46a85010d46969ffb7df440efd72bb3fa8d1394b35cc2887ee4567cda15079c5.png)\n\nThe sum of the length of its sides is called the **perimeter**. Here, the perimeter of our triangle is\n\n$$\n\\begin{aligned}p & =AB+BC+AC \\\\  & =2+4.2+3.8 \\\\  & =10\\,\\text{cm}.\\end{aligned}\n$$" :tutorial/id #uuid "7664d7c3-e47c-57b6-97aa-1131f036852c" :tutorial/math-academy-id 2244 :tutorial/title "Introduction"} :step/id #uuid "2dd79ef0-aa4a-5d52-ba67-92d8d47fd909" :step/math-academy-id 623181 :step/next {:db/id #edb/ref 17592186106738}} {:db/id #edb/ref 17592186106738 :step/content {:db/id #edb/ref 17592186105806 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105528 :question/id #uuid "00942425-ab13-5a50-a63a-d29cf2f34889" :question/math-academy-id "e-2752"} :knowledge-point/id #uuid "b1d4b0c2-10d0-5c3a-8a58-4d7598dd9f96" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049027} {:db/id #edb/ref 17592186050410}] :knowledge-point/questions [{:db/id #edb/ref 17592186106137} {:db/id #edb/ref 17592186106384} {:db/id #edb/ref 17592186492074}] :knowledge-point/title "Calculating the Perimeter of a Triangle Given the Perimeter of Another Triangle"} :step/id #uuid "48b5c886-bff4-52b2-b702-6be7c990ade1" :step/math-academy-id 623182 :step/next {:db/id #edb/ref 17592186106739}} {:db/id #edb/ref 17592186106739 :step/content {:db/id #edb/ref 17592186107045 :tutorial/content "Suppose we have a quadrilateral $ABCD$ as shown below and it is known that ${AD} = 6\\,\\mathrm{m},$ ${AB} = 2\\,\\mathrm{m},$ ${BC} = 4\\,\\mathrm{m},$ and $CD=5\\,\\mathrm{m}.$ What is the perimeter of the quadrilateral?   \n\n![](images/a7/a74251f1c72eccad42b98e0d3fd9a7e7cd0a60018a6f03bb65ec2abc34eb1c88.png)\n\nRemember that the **perimeter** $p$ of a polygon is the sum of the measures of all its sides. So, we can simply calculate \n\n$$\n\\begin{aligned}p & =AD+AB+BC+CD \\\\  & =6+2+4+5 \\\\  & =17\\,m.\\end{aligned}\n$$" :tutorial/id #uuid "0428807f-e6a6-5280-81bc-ab454203aebf" :tutorial/math-academy-id 2246 :tutorial/title "Perimeters of Polygons"} :step/id #uuid "2154c4c2-efe1-5888-87e0-905e612555d4" :step/math-academy-id 623185 :step/next {:db/id #edb/ref 17592186106740}} {:db/id #edb/ref 17592186106740 :step/content {:db/id #edb/ref 17592186105807 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105529 :question/id #uuid "b4864184-6983-58ab-9787-524e04dc5c73" :question/math-academy-id "e-2754"} :knowledge-point/id #uuid "6f6c0ca1-297a-5f25-bccf-c74d0c565c24" :knowledge-point/questions [{:db/id #edb/ref 17592186106202} {:db/id #edb/ref 17592186106203} {:db/id #edb/ref 17592186492033} {:db/id #edb/ref 17592186492041} {:db/id #edb/ref 17592186508050} {:db/id #edb/ref 17592186508083}] :knowledge-point/title "Calculating the Perimeter of a Polygon"} :step/id #uuid "2896eab9-aca7-5163-8e08-2101c4fa2827" :step/math-academy-id 623186 :step/next {:db/id #edb/ref 17592186106741}} {:db/id #edb/ref 17592186106741 :step/content {:db/id #edb/ref 17592186107046 :tutorial/content "Let's take a look at the polygons depicted below and find their perimeters.\n\n![](images/69/69ef06a71f13625ad4525a03966f4a4c62ae2b2136b085e97b8dc02a6a6963cc.png)\n\nFrom the picture, we conclude that polygons I, II and III all have a perimeter of $10$ while polygon IV has a perimeter of $8.$ \n\nPolygons that have the same perimeter are called **isoperimetric**. So I, II and III are isoperimetric polygons." :tutorial/id #uuid "596db00e-9cf7-51e1-902e-73c6670780eb" :tutorial/math-academy-id 2247 :tutorial/title "Isoperimetric Polygons"} :step/id #uuid "ffc5ce2a-4bcb-5660-a1ce-e79bd1b4c604" :step/math-academy-id 623189 :step/next {:db/id #edb/ref 17592186106742}} {:db/id #edb/ref 17592186106742 :step/content {:db/id #edb/ref 17592186105808 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105530 :question/id #uuid "3de76784-4137-5093-9c35-847edd10ef62" :question/math-academy-id "e-2756"} :knowledge-point/id #uuid "b2c2a15f-617d-5515-98a8-ccdc525092b3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050613}] :knowledge-point/questions [{:db/id #edb/ref 17592186106204} {:db/id #edb/ref 17592186106205} {:db/id #edb/ref 17592186492007} {:db/id #edb/ref 17592186492071}] :knowledge-point/title "Determining the Value of Variables Given Two Isoperimetric Polygons"} :step/id #uuid "ec3bbafa-69db-5676-8013-221157e979a6" :step/math-academy-id 623190}] :activity/title "The Perimeter of a Polygon" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186106009}] [{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186106553} :activity/id #uuid "a6ad28b0-f9e7-5bdd-80d5-adf3fcee2856" :activity/scope {:db/id #edb/ref 17592186050514 :topic/id #uuid "4fadec48-6c17-5c63-a22a-02d845645b15" :topic/math-academy-id 1322} :activity/steps [{:db/id #edb/ref 17592186106553 :step/content {:db/id #edb/ref 17592186107161 :tutorial/content "A **regular polygon** is a polygon where all sides are congruent (have the same length), and all interior angles are congruent (have the same measure).\n\nSome examples of regular polygons are shown below.\n\n![](images/d3/d33f23d3d3e301e336d7f70f37e88eee0f605c31b098969805d7c6346e34470e.png)\n\nSome examples of polygons that are **NOT** regular are as follows:\n\n- The rectangle below is **NOT** regular since the sides are not all congruent.\n\n![](images/6d/6d0c6eaee1ae1932d3bd44013c0b8aca977cbe0d98242d5c10aaa24d4f281a77.png)\n\n- The rhombus below is **NOT** regular since the interior angles are not all congruent.\n\n![](images/ce/ce2b908945db56934f08dc0da47f6c708f5220bce3a80f5147362c8b915c5613.png)\n\n- A $30^\\circ$-$60^\\circ$-$90^\\circ$ triangle is **NOT** regular since neither the sides nor the angles are all congruent.\n\n![](images/bf/bfe00eb1d1374252fd12f6c74eff7c052021a7305ce10027efc8869f561e3ef5.png)" :tutorial/id #uuid "cd59495c-0fc7-5db8-8d91-05d02fa8e26f" :tutorial/math-academy-id 7926 :tutorial/title "Introduction"} :step/id #uuid "f6dcb244-ba60-524d-bafc-0fd7ed3097aa" :step/math-academy-id 119188 :step/next {:db/id #edb/ref 17592186106554}} {:db/id #edb/ref 17592186106554 :step/content {:db/id #edb/ref 17592186105696 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105470 :question/id #uuid "fbeb62a5-1a2c-53df-ab8d-6aaee87c4a11" :question/math-academy-id "e-12647"} :knowledge-point/id #uuid "e9f78a76-4d2f-5694-971c-e734bc330602" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049584} {:db/id #edb/ref 17592186050164}] :knowledge-point/questions [{:db/id #edb/ref 17592186106075} {:db/id #edb/ref 17592186106076} {:db/id #edb/ref 17592186507464} {:db/id #edb/ref 17592186507524}] :knowledge-point/title "Identifying Regular Polygons"} :step/id #uuid "91bb4d37-5646-5ecb-b152-184d3a1e7df5" :step/math-academy-id 119189 :step/next {:db/id #edb/ref 17592186106555}} {:db/id #edb/ref 17592186106555 :step/content {:db/id #edb/ref 17592186107160 :tutorial/content "![](images/24/24c4c952103f245cd4dc32e34d5dd2363478f5400ddecfbe2503130135c01946.png)\n\nConsider the regular pentagon above. What is the measure of each interior angle?\n\nRecall that the sum of the interior angles of a polygon with $n$ sides equals $180^\\circ \\cdot (n-2).$ \n\nAll interior angles in a regular polygon are congruent. So, to calculate the measure of each interior angle, we find the sum of the interior angles and divide by the number of angles.\n\nA pentagon has $n=5$ sides. Therefore, the sum of its interior angles is\n\n$$\n180^\\circ \\times (5 - 2) = 540^\\circ.\n$$\n\n \n\nTherefore, the measure of each interior angle is\n\n$$\n\\dfrac{540^\\circ}{5} = 108^\\circ,\n$$\n\nas shown below.\n\n![](images/a7/a74a23a8dd760a31a0888eb694e36978c4767fd32bca6fae4fe8fe380c85e2e1.png)" :tutorial/id #uuid "d7abf1fc-4082-5a4f-a8ea-a74559737f2d" :tutorial/math-academy-id 7912 :tutorial/title "Interior Angles of Regular Polygons"} :step/id #uuid "542a4e61-51eb-5729-8e5c-2bd1bfdc8f6b" :step/math-academy-id 119192 :step/next {:db/id #edb/ref 17592186106556}} {:db/id #edb/ref 17592186106556 :step/content {:db/id #edb/ref 17592186105697 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105467 :question/id #uuid "f617d0de-cdcb-5d15-aa91-1d3e6f5edb60" :question/math-academy-id "e-12627"} :knowledge-point/id #uuid "2e475613-ff86-5655-a966-121d622b0bd7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048764} {:db/id #edb/ref 17592186049223}] :knowledge-point/questions [{:db/id #edb/ref 17592186106034} {:db/id #edb/ref 17592186106210} {:db/id #edb/ref 17592186234246} {:db/id #edb/ref 17592186507430} {:db/id #edb/ref 17592186508035} {:db/id #edb/ref 17592186508044}] :knowledge-point/title "Finding the Interior Angles of a Regular Polygon"} :step/id #uuid "b1672354-ac07-5ce6-aea9-42ade75a5756" :step/math-academy-id 119193 :step/next {:db/id #edb/ref 17592186106559}} {:db/id #edb/ref 17592186106557 :step/content {:db/id #edb/ref 17592186105698 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105468 :question/id #uuid "2fff10bc-b4a2-5f6c-b1a2-2fa2c5510f60" :question/math-academy-id "e-12628"} :knowledge-point/id #uuid "5231e20f-0e57-517c-bae9-3a152234d5ab" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050650}] :knowledge-point/questions [{:db/id #edb/ref 17592186106211} {:db/id #edb/ref 17592186106467} {:db/id #edb/ref 17592186507454} {:db/id #edb/ref 17592186507469} {:db/id #edb/ref 17592186508109}] :knowledge-point/title "Finding the Exterior Angles of a Regular Polygon"} :step/id #uuid "5963d13b-c8a9-5e42-9832-539b63c97ffd" :step/math-academy-id 119196 :step/next {:db/id #edb/ref 17592186106558}} {:db/id #edb/ref 17592186106558 :step/content {:db/id #edb/ref 17592186105699 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105469 :question/id #uuid "97bdacef-ecd4-52da-9fef-b8e9233f21a8" :question/math-academy-id "e-12629"} :knowledge-point/id #uuid "372bcfad-79d0-5758-a66b-efeacfb13762" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048174}] :knowledge-point/questions [{:db/id #edb/ref 17592186106394} {:db/id #edb/ref 17592186106395} {:db/id #edb/ref 17592186507495} {:db/id #edb/ref 17592186507500}] :knowledge-point/title "Finding Exterior Angles With Multiple Polygons"} :step/id #uuid "6be9e91b-24ac-5965-9577-4a57a3357b17" :step/math-academy-id 119199} {:db/id #edb/ref 17592186106559 :step/content {:db/id #edb/ref 17592186107165 :tutorial/content "![](images/8e/8e128a2320d2658cc61cf83a1871d09caa7e4527b684c2af9086f80a00ecc717.png)\n\nConsider the regular hexagon above. What is the measure of each *exterior* angle?\n\nNote the following:\n\n- The exterior angles in a regular polygon are all congruent.\n\n- The sum of the exterior angles of *any* convex polygon equals $360^\\circ.$\n\nSo, to find the measure of the exterior angles of a regular polygon, we divide $360^\\circ$ by the number of sides.\n\nSince a regular hexagon has $n=6$ sides, the measure of each exterior angle is\n\n$$\n\\dfrac{360^\\circ}{6} = 60^\\circ,\n$$\n\nas shown below.\n\n![](images/4f/4f4538d9e2e09715fa3aa2035cd8b22cdc326b0ac02326551d193f26f1946473.png)" :tutorial/id #uuid "754fe990-2a6b-5799-bb6d-bd83d8b8fff4" :tutorial/math-academy-id 9042 :tutorial/title "Exterior Angles of Regular Polygons"} :step/id #uuid "60bdea8a-315f-547f-a828-49aa84b406ef" :step/math-academy-id 119202 :step/next {:db/id #edb/ref 17592186106557}}] :activity/title "Regular Polygons" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186105976}] [{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186111783} :activity/id #uuid "0008051f-7603-507f-b160-f673aeb16997" :activity/scope {:db/id #edb/ref 17592186051041 :topic/id #uuid "7cb38e4f-6e1e-50f0-9388-bd5b8a4168e2" :topic/math-academy-id 1515} :activity/steps [{:db/id #edb/ref 17592186111783 :step/content {:db/id #edb/ref 17592186111851 :tutorial/content "Two polygons are **congruent** if they have the same shape. This means that\n\n- they have the same number of sides,\n\n- all corresponding sides are congruent, and\n\n- all corresponding interior angles are congruent.\n\nConsider the two polygons $\\mathcal{P}$ and $\\mathcal{Q}$ below. Are they congruent?\n\n![](images/b0/b0a11815bf9006ccdca0ebe71ff7ba53ac7526c71a715ece71914b103b4a24a8.png)\n\nLet's check these criteria for our polygons $\\mathcal{P}$ and $\\mathcal{Q}.$ We can see that both polygons have $3$ sides, and\n\n$$\n\\begin{aligned}\\overset{―}{AB} & ≅\\overset{―}{XY}\\,, & \\overset{―}{AC} & ≅\\overset{―}{XZ}\\,, & \\overset{―}{BC} & ≅\\overset{―}{YZ}\\,, \\\\ ∠X & ≅∠A\\,, & ∠Y & ≅∠B\\,, & ∠Z & ≅∠C\\,.\\end{aligned}\n$$\n\nTherefore, the polygons are congruent, and we can write \n\n$$\nABC \\cong XYZ.\n$$\n\nThe order in which we write the symbols is important: the corresponding vertices have to be in the same order.\n\nWe can also write $\\mathcal{P} \\cong \\mathcal{Q}.$" :tutorial/id #uuid "e6be6893-a7ca-578a-9510-8a8c2166e89b" :tutorial/math-academy-id 2293 :tutorial/title "Introduction"} :step/id #uuid "a10c82d4-3ea7-5197-929f-a0a7a5910276" :step/math-academy-id 9553 :step/next {:db/id #edb/ref 17592186111784}} {:db/id #edb/ref 17592186111784 :step/content {:db/id #edb/ref 17592186110790 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110419 :question/id #uuid "aedb6e30-d1e6-5d89-aa83-56c1d6946b50" :question/math-academy-id "e-2904"} :knowledge-point/id #uuid "2e2f2884-829b-5e09-8fc0-16556b177732" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049584} {:db/id #edb/ref 17592186050164}] :knowledge-point/questions [{:db/id #edb/ref 17592186111064} {:db/id #edb/ref 17592186111065} {:db/id #edb/ref 17592186499475} {:db/id #edb/ref 17592186499493}] :knowledge-point/title "Identifying Congruent Polygons on a Grid"} :step/id #uuid "2fa4b989-a0cc-59a1-af0b-34fffe8e4efd" :step/math-academy-id 9554 :step/next {:db/id #edb/ref 17592186111785}} {:db/id #edb/ref 17592186111785 :step/content {:db/id #edb/ref 17592186110791 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110420 :question/id #uuid "fd18dfda-f385-5e24-a200-882a71d3b063" :question/math-academy-id "e-2908"} :knowledge-point/id #uuid "30fc8daf-a6eb-537b-b19b-06ad5504b5e6" :knowledge-point/questions [{:db/id #edb/ref 17592186111066} {:db/id #edb/ref 17592186111093} {:db/id #edb/ref 17592186499487} {:db/id #edb/ref 17592186508056}] :knowledge-point/title "Identifying Congruent Polygons Given Side and Angle Measures"} :step/id #uuid "7b16a667-2831-57ad-9ccc-a74ad42b6006" :step/math-academy-id 9559 :step/next {:db/id #edb/ref 17592186111786}} {:db/id #edb/ref 17592186111786 :step/content {:db/id #edb/ref 17592186110792 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110421 :question/id #uuid "b3ec8468-a64a-5f55-b392-8f0072fbdd78" :question/math-academy-id "e-2910"} :knowledge-point/id #uuid "46dbecc9-70e8-55c9-b7d7-7b5629ea1549" :knowledge-point/questions [{:db/id #edb/ref 17592186111295} {:db/id #edb/ref 17592186111305} {:db/id #edb/ref 17592186499465} {:db/id #edb/ref 17592186499533} {:db/id #edb/ref 17592186499557}] :knowledge-point/title "Writing a Congruence Statement"} :step/id #uuid "904ecf87-997e-5efd-aa14-ee221a6d6685" :step/math-academy-id 9560 :step/next {:db/id #edb/ref 17592186111787}} {:db/id #edb/ref 17592186111787 :step/content {:db/id #edb/ref 17592186110793 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110422 :question/id #uuid "f6e8ab4f-f21a-5c5e-9682-9f9b00e4fdc1" :question/math-academy-id "e-2911"} :knowledge-point/id #uuid "0921774a-ff9d-5760-93eb-13517043d509" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673}] :knowledge-point/questions [{:db/id #edb/ref 17592186111063} {:db/id #edb/ref 17592186111294} {:db/id #edb/ref 17592186499452} {:db/id #edb/ref 17592186499471}] :knowledge-point/title "Identifying Unknown Quantities From Congruent Polygons"} :step/id #uuid "c961c803-6d65-5690-a563-dc412e97f007" :step/math-academy-id 9561}] :activity/title "Congruent Polygons" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110868}]}
