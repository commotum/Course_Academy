m 0.6em 0.3em\"><mtr><mtd><mi>δ</mi></mtd><mtd><mi></mi><mo>=</mo><msup><mrow data-mjx-texclass=\"ORD\"><mn>45</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mo>∘</mo></mrow></msup></mtd></mtr><mtr><mtd><mo stretchy=\"false\">(</mo><mn>3</mn><mi>y</mi><mo>−</mo><mn>15</mn><msup><mo stretchy=\"false\">)</mo><mo>∘</mo></msup></mtd><mtd><mi></mi><mo>=</mo><msup><mrow data-mjx-texclass=\"ORD\"><mn>45</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mo>∘</mo></mrow></msup></mtd></mtr><mtr><mtd><mn>3</mn><mi>y</mi><mo>−</mo><mn>15</mn></mtd><mtd><mi></mi><mo>=</mo><mn>45</mn></mtd></mtr><mtr><mtd><mn>3</mn><mi>y</mi></mtd><mtd><mi></mi><mo>=</mo><mn>60</mn></mtd></mtr><mtr><mtd><mi>y</mi></mtd><mtd><mi></mi><mo>=</mo><mn>20.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>             \n\n                           \n                    </div>",
