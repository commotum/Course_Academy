#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186134917} :activity/id #uuid "b257a2d9-a21e-5e7b-8297-daf3ed7e1fae" :activity/scope {:db/id #edb/ref 17592186048868 :topic/id #uuid "c7dda967-adbc-5d28-94d6-a574e5483086" :topic/math-academy-id 2184} :activity/steps [{:db/id #edb/ref 17592186134917 :step/content {:db/id #edb/ref 17592186135015 :tutorial/content "Suppose that we wish to evaluate the expression $\\sqrt x + 3$ for the value $x=9.$ This type of expression is called a **radical expression** because it contains the radical symbol $\\sqrt{\\phantom 0}.$ Remember that $\\sqrt x$ means \"the positive square root of the number $x.$\" \n\nTo evaluate this expression at the given value, we replace $x$ with $9$ in the given expression and simplify.\n\n$$\n\\begin{aligned}\\sqrt{x}+3 & = \\\\ \\sqrt{9}+3 & = \\\\ \\sqrt{{3}^{2}}+3 & = \\\\ 3+3 & = \\\\ 6\\end{aligned}\n$$\n\n**Important:** You may have heard somewhere that $\\sqrt{9} = \\pm 3,$ because $(-3)^2=9$ and $(3)^2 = 9.$ However, when we write down $\\sqrt{9},$ we *always* mean \"the positive square root of $9$\".\n\nIf we want the negative square root of $9$, we write $-\\sqrt{9} = -3.$ Sometimes, we want both, in which case we would write $\\pm\\sqrt{9}=\\pm 3.$" :tutorial/id #uuid "4457c20d-88c9-5028-8390-390579fa7229" :tutorial/math-academy-id 1610 :tutorial/title "Introduction"} :step/id #uuid "9851ef2d-c687-52a6-8ea1-ff43bff4d334" :step/math-academy-id 4338 :step/next {:db/id #edb/ref 17592186134918}} {:db/id #edb/ref 17592186134918 :step/content {:db/id #edb/ref 17592186133918 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133524 :question/id #uuid "6488c7bd-4179-5b78-bdfc-92973f9a141f" :question/math-academy-id "e-1375"} :knowledge-point/id #uuid "779a527b-c35d-5c94-b783-2e6eb117f00a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048652}] :knowledge-point/questions [{:db/id #edb/ref 17592186134186} {:db/id #edb/ref 17592186134341} {:db/id 