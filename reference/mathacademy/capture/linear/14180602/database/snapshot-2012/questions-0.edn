:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496078}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "573468a3-fb63-5275-a038-70008c621f95" :question/math-academy-id "q-52512" :question/problem "Given $h(x)=\\frac{\\sqrt{2x+7}}{\\sqrt{x-7}},$ find $h(10).$" :question/worked-solution "We replace $x$ with $10$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}h(10) & =\\frac{\\sqrt{2x+7}}{\\sqrt{x-7}} \\\\  & =\\frac{\\sqrt{2(10)+7}}{\\sqrt{10-7}} \\\\  & =\\frac{\\sqrt{27}}{\\sqrt{3}} \\\\  & =\\sqrt{\\frac{27}{3}} \\\\  & =\\sqrt{9} \\\\  & =3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186496276 :knowledge-point/_questions [{:db/id #edb/ref 17592186133921 :knowledge-point/id #uuid "b3351708-be25-5d86-8aa8-f651263505be" :knowledge-point/title "Evaluating a Radical Expression Containing a Cube Root"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3308a8c5-80f5-511f-b76a-4421e28d64df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186495629} {:answer/id #uuid "44057f65-5e0b-5abb-9f88-1d6765f2c3cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt[3]{2}" :db/id #edb/ref 17592186495666} {:answer/id #uuid "751bfe77-634f-5b8c-9e0e-ec26f932991e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186495765} {:answer/id #uuid "c453f044-0ddc-57f7-a430-a4b1237e6816" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt[3]{3}" :db/id #edb/ref 17592186495940} {:answer/id #uuid "cf142703-648a-59a8-9972-954f2b3fd31f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{3}" :db/id #edb/ref 17592186495964}] :answer-field/correct {:answer/id #uuid "c453f044-0ddc-57f7-a430-a4b1237e6816" :answer/type {:db/id #edb/