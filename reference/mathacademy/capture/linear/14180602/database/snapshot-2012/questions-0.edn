 in the given expression, and simplify:\n\n$$\n\\begin{aligned}h(5) & =\\frac{\\sqrt{2(5)+6}}{\\sqrt{2(5)-1}} \\\\  & =\\frac{\\sqrt{10+6}}{\\sqrt{10-1}} \\\\  & =\\frac{\\sqrt{16}}{\\sqrt{9}} \\\\  & =\\frac{4}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186496310 :knowledge-point/_questions [{:db/id #edb/ref 17592186133921 :knowledge-point/id #uuid "b3351708-be25-5d86-8aa8-f651263505be" :knowledge-point/title "Evaluating a Radical Expression Containing a Cube Root"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d6bcdc9-14f9-5f71-9835-f562c6809b64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt[3]{6}" :db/id #edb/ref 17592186495570} {:answer/id #uuid "6c922236-31af-5996-9c74-c387180cbf5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt[3]{3}" :db/id #edb/ref 17592186495749} {:answer/id #uuid "8e8abba6-8d33-582a-b745-99b175925a46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186495822} {:answer/id #uuid "c12064ba-3ce2-5917-bf15-83f64346a24a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186495933} {:answer/id #uuid "d1987438-6c46-55eb-8e91-3ecdd71e97a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt[3]{4}" :db/id #edb/ref 17592186495968}] :answer-field/correct {:answer/id #uuid "8e8abba6-8d33-582a-b745-99b175925a46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186495822} :answer-field/id #uuid "eb373ce3-e8bd-579b-8051-9b912f1cd1ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496205}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c6b