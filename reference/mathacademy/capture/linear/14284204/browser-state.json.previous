      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14284204/observations/step-q156194-67a4047564ac72211753.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14284204/observations/step-q156194-67a4047564ac72211753.png",
      "source_url": "https://mathacademy.com/tasks/14284204/topics/333/lesson",
      "captured_at": 1792271152.1551096,
      "math_academy_id": "q-156194",
      "topic_id": "333",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q156194",
        "placement_id": null,
