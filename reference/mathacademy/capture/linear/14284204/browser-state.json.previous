      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14284204/observations/step-q49309-a5bdcee58cfc8e718d27.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14284204/observations/step-q49309-a5bdcee58cfc8e718d27.png",
      "source_url": "https://mathacademy.com/tasks/14284204/topics/333/lesson",
      "captured_at": 1792271170.8487356,
      "math_academy_id": "q-49309",
      "topic_id": "333",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q49309",
        "placement_id": null,
