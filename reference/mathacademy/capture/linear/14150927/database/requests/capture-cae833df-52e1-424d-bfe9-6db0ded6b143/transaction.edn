∘}\\,\\text{C}.\n$$\n\nTherefore, the average temperature in Oslo in March is ${1.7}^{∘}\\,\\text{C}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c46302bf-3ab9-5335-bba9-dc5d421fed1f"] :db/ensure [:question/validate]} {:db/id "answer-field-c46302bf-3ab9-5335-bba9-dc5d421fed1f" :answer-field/id #uuid "c46302bf-3ab9-5335-bba9-dc5d421fed1f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2a92ffa2-e67b-5d1d-93bc-87b38d849626" :answer-field/choices ["answer-be3a9878-1566-5e31-98e2-48dc8ac33038" "answer-2a92ffa2-e67b-5d1d-93bc-87b38d849626" "answer-d0a32b05-ed28-52ce-8809-299b736deab3" "answer-1f6f34e7-af0a-5515-ac9b-aab27c95e173" "answer-6f11a7da-1195-563c-853d-f585521c643b"] :db/ensure [:answer-field/validate]} {:db/id "answer-be3a9878-1566-5e31-98e2-48dc8ac33038" :answer/id #uuid "be3a9878-1566-5e31-98e2-48dc8ac33038" :answer/type :answer.type/math :answer/value "{0.9}^{∘}\\,\\text{C}" :db/ensure [:answer/validate]} {:db/id "answer-2a92ffa2-e67b-5d1d-93bc-87b38d849626" :answer/id #uuid "2a92ffa2-e67b-5d1d-93bc-87b38d849626" :answer/type :answer.type/math :answer/value "{1.7}^{∘}\\,\\text{C}" :db/ensure [:answer/validate]} {:db/id "answer-d0a32b05-ed28-52ce-8809-299b736deab3" :answer/id #uuid "d0a32b05-ed28-52ce-8809-299b736deab3" :answer/type :answer.type/math :answer/value "{1.9}^{∘}\\,\\text{C}" :db/ensure [:answer/validate]} {:db/id "answer-1f6f34e7-af0a-5515-ac9b-aab27c95e173" :answer/id #uuid "1f6f34e7-af0a-5515-ac9b-aab27c95e173" :answer/type :answer.type/math :answer/value "{2.1}^{∘}\\,\\text{C}" :db/ensure [:answer/validate]} {:db/id "answer-6f11a7da-1195-563c-853d-f585521c643b" :answer/id #uuid "6f11a7da-1195-563c-853d-f585521c643b" :answer/type :answer.type/math :answer/value "{2.3}^{∘}\\,\\text{C}" :db/ensure [:answer/validate]} {:db/id 17592186097845 :tutorial/content "We can solve some real-world problems using addition and subtraction of real numbers.\n