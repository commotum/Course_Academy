#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186558580} :activity/id #uuid "5bd4e534-c7eb-5234-81ae-c5e88e1af798" :activity/scope {:db/id #edb/ref 17592186048904 :topic/id #uuid "cadfbf13-0689-5ad0-86fa-0607bad5c76c" :topic/math-academy-id 812} :activity/steps [{:db/id #edb/ref 17592186558580 :step/content {:db/id #edb/ref 17592186088189 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "125c2c5c-61b7-5d55-8f98-6b218c5c51da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{′}(x)=5-8x" :db/id #edb/ref 17592186557907} {:answer/id #uuid "27dc9e0c-011e-521d-8ad7-d9d93470042c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{′}(x)=15+8x" :db/id #edb/ref 17592186557945} {:answer/id #uuid "6d2eab43-a851-5fcc-9855-5ebae7ded852" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{′}(x)=5x-8" :db/id #edb/ref 17592186558079} {:answer/id #uuid "98bd8735-0b1c-52c7-88b3-8d0c169afb94" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{′}(x)=15-8x" :db/id #edb/ref 17592186558164} {:answer/id #uuid "e1e836cf-bbc1-5aba-b0f6-de39516f1a5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{′}(x)=5+8x" :db/id #edb/ref 17592186558318}] :answer-field/correct {:db/id #edb/ref 17592186557907} :answer-field/id #uuid "51909d3e-6b80-5264-9fd1-f708fe7f41a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186085788}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "46eecd6b-234b-5d91-be76-8bf8679a9744" :question/math-academy-id "q-47332" :question/problem "Given the curve $y=5x-4{x}^{2}$, calculate ${y}^{′}(x)$ using the definition of the derivative." :question/worked-solution "Let $f(x)=5x-4{x}^{2}.$ The definition of ${y}^{′}(x)$ is\n\n$$\n\\begin{aligned}{y}^{′}(x)={lim}_{h\\to 0}\\frac{f(x+h)-f(x)}{h}.\\end{aligned}\n$$\n\nApplying this to $f(x)=5x-4{x}^{2}$, we get \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={lim}_{h\\to 0}(\\frac{(5(x+h)-4(x+h)^{2})-(5x-4{x}^{2})}{h}) \\\\  & ={lim}_{h\\to 0}(\\frac{5x+5h-4{x}^{2}-8xh-4{h}^{2}-5x+4{x}^{2}}{h}) \\\\  & ={lim}_{h\\to 0}(\\frac{h(5-8x-4h)}{h}) \\\\  & ={lim}_{h\\to 0}(5-8x-4h) \\\\  & =5-8x-4(0) \\\\  & =5-8x.\\end{aligned}\n$$"} :step/id #uuid "0634f784-ec42-5ab7-a748-cd849fc04149" :step/next {:db/id #edb/ref 17592186558676}} {:db/id #edb/ref 17592186558583 :step/content {:db/id #edb/ref 17592186558489 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74e9abe3-ae25-5eb6-a3d8-e6abe4b1a035" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{h\\to 0}(\\frac{-7(x+h)^{3}+7{x}^{3}}{h})" :db/id #edb/ref 17592186558095} {:answer/id #uuid "88a7a363-3ef9-510d-b369-ff0b144e229c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{h\\to 0}(\\frac{-7(x+h)^{3}-{x}^{3}}{h})" :db/id #edb/ref 17592186558137} {:answer/id #uuid "9617f768-f886-59ab-b3de-bf8fd78415bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{h\\to 0}(\\frac{(x+h)^{3}-7{x}^{3}}{h})" :db/id #edb/ref 17592186558158} {:answer/id #uuid "c0eb3b2a-e2ba-5069-a970-9c79168ba89a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{h\\to 0}(\\frac{7(x+h)^{2}+7{x}^{2}}{h})" :db/id #edb/ref 17592186558252} {:answer/id #uuid "dfc3ccd5-2ecb-5e57-b2a8-334ff1aec347" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{h\\to 0}(\\frac{7(x+h)^{3}+7{x}^{3}}{h})" :db/id #edb/ref 17592186558311}] :answer-field/correct {:db/id #edb/ref 17592186558095} :answer-field/id #uuid "509510e5-7bfa-5f23-b3a6-bd148219ac8b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558392}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "11af5bea-b828-576f-8c93-cbaa94a7c406" :question/math-academy-id "q-78201" :question/problem "Given that $f(x)=-7{x}^{3}$, what is ${f}^{′}(x)$ according to the definition of the derivative?" :question/worked-solution "The derivative ${f}^{′}(x)$ is given by the limit \n\n$$\n{lim}_{h\\to 0}(\\frac{f(x+h)-f(x)}{h}).\n$$\n\nSince $f(x)=-7{x}^{3}$,  we have that $f(x+h)=-7(x+h)^{3}.$ Hence,  we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={lim}_{h\\to 0}(\\frac{-7(x+h)^{3}-(-7{x}^{3})}{h}) \\\\  & ={lim}_{h\\to 0}(\\frac{-7(x+h)^{3}+7{x}^{3}}{h}).\\end{aligned}\n$$"} :step/id #uuid "0b3778c8-beae-53c5-a0e4-d4036cecf1e6"} {:db/id #edb/ref 17592186558676 :step/content {:db/id #edb/ref 17592186558508 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08fc9cb6-3103-5342-8644-8743938348cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{′}(x)=-2x" :db/id #edb/ref 17592186557887} {:answer/id #uuid "25a2dc8a-f83a-5d98-8451-c28d8ccd2e5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{′}(x)=-5x" :db/id #edb/ref 17592186557943} {:answer/id #uuid "658f8baf-5d00-5e66-95a8-dcde0d7540e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{′}(x)=2x" :db/id #edb/ref 17592186558064} {:answer/id #uuid "73ed5a00-2cea-5d23-b3c0-0776a1b5fa29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{′}(x)=5x" :db/id #edb/ref 17592186558093} {:answer/id #uuid "74391e24-8355-5cf2-a23e-bd06872eff45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{′}(x)=-10x" :db/id #edb/ref 17592186558094}] :answer-field/correct {:db/id #edb/ref 17592186558094} :answer-field/id #uuid "34a87a7a-7c0b-5de4-808e-8f0389961190" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558379}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3ff53e55-bdde-5229-8f33-424172733d15" :question/math-academy-id "q-47900" :question/problem "Use the definition of the derivative to find ${f}^{′}(x)$ if  $f(x)=-5{x}^{2}+2.$" :question/worked-solution "The definition of ${f}^{′}(x)$ is\n\n$$\n\\begin{aligned}{f}^{′}(x)={lim}_{h\\to 0}\\frac{f(x+h)-f(x)}{h}.\\end{aligned}\n$$\n\nApplying this to $f(x)=-5{x}^{2}+2$, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={lim}_{h\\to 0}(\\frac{-5(x+h)^{2}+2-(-5{x}^{2}+2)}{h}) \\\\  & ={lim}_{h\\to 0}(\\frac{-5({x}^{2}+2xh+{h}^{2})+2+5{x}^{2}-2)}{h}) \\\\  & ={lim}_{h\\to 0}(\\frac{-5{x}^{2}-10xh-5{h}^{2}+2+5{x}^{2}-2}{h}) \\\\  & ={lim}_{h\\to 0}(\\frac{-10xh-5{h}^{2}}{h}) \\\\  & ={lim}_{h\\to 0}\\frac{h(-10x-5h)}{h} \\\\  & ={lim}_{h\\to 0}(-10x-5h) \\\\  & =-10x.\\end{aligned}\n$$"} :step/id #uuid "b05b4e89-df23-53ba-bf23-f74a65f51e5f" :step/next {:db/id #edb/ref 17592186558583}}] :activity/title "Defining the Derivative Using Derivative Notation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186557861}]}
