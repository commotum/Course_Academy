#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186088823} :activity/id #uuid "bb9db01e-936b-52c3-b219-e1950b5ae188" :activity/scope {:db/id #edb/ref 17592186048904 :topic/id #uuid "cadfbf13-0689-5ad0-86fa-0607bad5c76c" :topic/math-academy-id 812} :activity/steps [{:db/id #edb/ref 17592186088823 :step/content {:db/id #edb/ref 17592186088899 :tutorial/content "The instantaneous rate of change of a function $f(x)$ at the point $x=a,$ denoted $f'(a),$ is given by the limit\n\n$$\nf'(a) = \\lim_{h\\to 0}\\dfrac{f(a+h) - f(a)}{h}.\n$$\n\nThis formula works for a specific point $x=a.$ If we want a method that works for a *general* point $x,$ then we substitute $a=x$ in the formula and get\n\n$$\nf'(x) = \\lim_{h\\to 0}\\dfrac{f(x+h) - f(x)}{h}.\n$$\n\nThe function $f'(x)$ is called the **derivative of $f(x)$ with respect to $x$**. It gives the slope of the tangent line to the curve $y=f(x)$ at a general point with coordinates $(x,f(x)).$" :tutorial/id #uuid "098fd6b0-306b-544a-9e7f-b301ff48f525" :tutorial/math-academy-id 327 :tutorial/title "Introduction"} :step/id #uuid "454777cc-cdc5-5db8-b536-5b674f1199d6" :step/math-academy-id 605 :step/next {:db/id #edb/ref 17592186088824}} {:db/id #edb/ref 17592186088824 :step/content {:db/id #edb/ref 17592186087880 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087431 :question/id #uuid "36199fc1-505f-5179-9eeb-bec0534bab5f" :question/math-academy-id "e-128"} :knowledge-point/id #uuid "5e905212-8796-5742-a83e-892fdf66eced" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049362}] :knowledge-point/questions [{:db/id #edb/ref 17592186088191} {:db/id #edb/ref 17592186088192} {:db/id #edb/ref 17592186537884} {:db/id #edb/ref 17592186537953}] :knowledge-point/title "Constructing an Expression that Represents the Derivative of a Function"} :step/id #uuid "37cc5660-640c-5836-92be-6ff27138fdcb" :step/math-academy-id 606 :step/next {:db/id #edb/ref 17592186088827}} {:db/id #edb/ref 17592186088827 :step/content {:db/id #edb/ref 17592186088900 :tutorial/content "For a given curve $y=f(x),$ the derivative can be represented using several different notations. They are\n\n$$\nf'(x),\\qquad y'(x), \\qquad \\dfrac{\\textrm{d}f}{\\textrm{d}x}, \\qquad \\dfrac{\\textrm{d}y}{\\textrm{d}x}.\n$$\n\nIn words, the term $y'(x)$  is said like\n\n- \"$y$ prime of $x$,\" or\n\n- \"$y$ prime,\" or sometimes\n\n- \"$y$ dash.\"\n\nThe term $\\dfrac{\\textrm{d}y}{\\textrm{d}x}$ is said like \"dee $y$ by dee $x$.\"\n\nThe important thing to remember is that they all represent the same thing, the derivative." :tutorial/id #uuid "cda9f5ac-1ad1-50ce-8bc4-ee5f3be5fd92" :tutorial/math-academy-id 329 :tutorial/title "Alternative Definitions For the Derivative"} :step/id #uuid "1b806b59-9344-54a4-8988-8cb76d4286c3" :step/math-academy-id 609 :step/next {:db/id #edb/ref 17592186088828}} {:db/id #edb/ref 17592186088828 :step/content {:db/id #edb/ref 17592186087881 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087432 :question/id #uuid "7fb64010-dc03-5db5-b5d1-563d2fe44b6d" :question/math-academy-id "e-130"} :knowledge-point/id #uuid "9c6f3c71-d11b-59af-bad6-5f5c0ff6634f" :knowledge-point/questions [{:db/id #edb/ref 17592186088189} {:db/id #edb/ref 17592186088190} {:db/id #edb/ref 17592186233549} {:db/id #edb/ref 17592186235416} {:db/id #edb/ref 17592186537931} {:db/id #edb/ref 17592186537947}] :knowledge-point/title "Calculating the Derivative of a Function"} :step/id #uuid "2c77b3ab-7255-54eb-92d4-2ad06b30a0cd" :step/math-academy-id 613}] :activity/title "Defining the Derivative Using Derivative Notation" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186087898}]}
