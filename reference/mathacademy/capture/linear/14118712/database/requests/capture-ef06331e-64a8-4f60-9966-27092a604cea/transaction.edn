e]} {:db/id "answer-d95df757-4f9e-5360-a232-168c68f04785" :answer/id #uuid "d95df757-4f9e-5360-a232-168c68f04785" :answer/type :answer.type/math :answer/value "∃\\,k\\in Z,\\,k={512}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-6ba09872-e3ca-54c9-806a-1e8cf5a8c8b8" :answer/id #uuid "6ba09872-e3ca-54c9-806a-1e8cf5a8c8b8" :answer/type :answer.type/math :answer/value "∃\\,k\\in Z,\\,{2}^{k}=512" :db/ensure [:answer/validate]} {:db/id "answer-36385d37-b616-5435-802e-28750f745704" :answer/id #uuid "36385d37-b616-5435-802e-28750f745704" :answer/type :answer.type/math :answer/value "∃\\,k\\in Z,\\,{k}^{2}=512" :db/ensure [:answer/validate]} {:db/id "question-61ea11f5-e114-5b4e-93aa-fef7b636de63" :question/id #uuid "61ea11f5-e114-5b4e-93aa-fef7b636de63" :question/math-academy-id "q-183569" :question/problem "There is a real number such that, added to any natural number, gives a positive number.\n\nExpress the above in formal language." :question/worked-solution "Notice that our sentence can be re-phrased as \n\nThere exists a real number $x$ such that, added to any natural number, gives a positive number.\n\nNow, \"$x$ added to any natural number gives a positive number\" means that\n\nFor any natural number $n,$ we have that $x+n>0.$\n\nTherefore, we get the following statement:\n\nThere exists a real number $x$ such that for any natural number $n$ we have that $x+n>0.$\n\nMore formally, this reads as\n\n$∃\\,x\\in R,\\,∀\\,n\\in N,\\,x+n>0.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-b9937ecd-67a0-55f8-9d21-e9472a02b1f0"] :db/ensure [:question/validate]} {:db/id "answer-field-b9937ecd-67a0-55f8-9d21-e9472a02b1f0" :answer-field/id #uuid "b9937ecd-67a0-55f8-9d21-e9472a02b1f0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-75fd620c-3826-539d-aadf-0db05cc1c187" :answer-field/choices ["answer-9effbd25-3f4e-52ec-adfe-e05327867b1a" "answer-4ec06de9-0d99-57b0-9a3a-16fc00cab7e1" "answer-21397aad-294d-5cb0-8fc2-55534f4a6fba" "answer-75fd620c-3826-539d-aadf-0db05cc1c187" "answer-884a72c8-4262-5b6c-97e1-72f59632519a"] :db/ensure [:answer-field/validate]} {:db/id "answer-9effbd25-3f4e-52ec-adfe-e05327867b1a" :answer/id #uuid "9effbd25-3f4e-52ec-adfe-e05327867b1a" :answer/type :answer.type/math :answer/value "∀\\,n\\in N,\\,∃\\,x\\in R,\\,x+n>0" :db/ensure [:answer/validate]} {:db/id "answer-4ec06de9-0d99-57b0-9a3a-16fc00cab7e1" :answer/id #uuid "4ec06de9-0d99-57b0-9a3a-16fc00cab7e1" :answer/type :answer.type/math :answer/value "∀\\,x\\in R,\\,∃\\,n\\in N,\\,x+n>0" :db/ensure [:answer/validate]} {:db/id "answer-21397aad-294d-5cb0-8fc2-55534f4a6fba" :answer/id #uuid "21397aad-294d-5cb0-8fc2-55534f4a6fba" :answer/type :answer.type/math :answer/value "∃\\,n\\in N,\\,∀\\,x\\in R,\\,x+n>0" :db/ensure [:answer/validate]} {:db/id "answer-75fd620c-3826-539d-aadf-0db05cc1c187" :answer/id #uuid "75fd620c-3826-539d-aadf-0db05cc1c187" :answer/type :answer.type/math :answer/value "∃\\,x\\in R,\\,∀\\,n\\in N,\\,x+n>0" :db/ensure [:answer/validate]} {:db/id "answer-884a72c8-4262-5b6c-97e1-72f59632519a" :answer/id #uuid "884a72c8-4262-5b6c-97e1-72f59632519a" :answer/type :answer.type/math :answer/value "∃\\,x\\in R,\\,∀\\,n\\in N,\\,xn>0" :db/ensure [:answer/validate]} {:db/id 17592186157463 :knowledge-point/questions ["question-f4dd7341-6f18-5e73-afaa-e4cf5a0832e8" "question-822441e0-0d3a-577b-9cb1-929e6c39db8d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f4dd7341-6f18-5e73-afaa-e4cf5a0832e8" :question/id #uuid "f4dd7341-6f18-5e73-afaa-e4cf5a0832e8" :question/math-academy-id "q-183715" :question/problem "There exists an integer number such that, for any rational number, the product of both numbers is the second number.\n\nExpress the statement above in formal language." :question/worked-solution "Let's examine our statement:\n\n- The words \"there exists\" indicate that we use an existential quantifier, $∃.$\n\n- The word \"any\" indicates that we use a universal quantifier, $∀.$\n\n- The sentence refers to integers and rational numbers. So, by denoting our numbers as $k$ and $q,$ respectively, we have\n\n$$\n∃\\,k\\in Z,\\,∀\\,q\\in Q.\n$$\n\n- Finally, the condition in the statement can be written as follows:\n\n$$\nkq=q\n$$\n\nTherefore, we write the statement as follows:\n\n$∃\\,k\\in Z,\\,∀\\,q\\in Q,\\,kq=q$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-bd95aa99-f4e5-52d5-a54e-5119eca0a5a1"] :db/ensure [:question/validate]} {:db/id "answer-field-bd95aa99-f4e5-52d5-a54e-5119eca0a5a1" :answer-field/id #uuid "bd95aa99-f4e5-52d5-a54e-5119eca0a5a1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-84a0f7dc-748f-5977-98f4-cc7c7bcb7a32" :answer-field/choices ["answer-14428b06-3047-50b9-aa88-3ad9212e487b" "answer-7bad8008-4b08-5444-bc02-a16600d66a30" "answer-84a0f7dc-748f-5977-98f4-cc7c7bcb7a32" "answer-337eee28-d0ff-5774-974d-6f7b31464bc5" "answer-c314ce38-5463-5799-a600-f517694af5db"] :db/ensure [:answer-field/validate]} {:db/id "answer-14428b06-3047-50b9-aa88-3ad9212e487b" :answer/id #uuid "14428b06-3047-50b9-aa88-3ad9212e487b" :answer/type :answer.type/math :answer/value "∀\\,k\\in Z,\\,∃\\,q\\in Q,\\,kq=k" :db/ensure [:answer/validate]} {:db/id "answer-7bad8008-4b08-5444-bc02-a16600d66a30" :answer/id #uuid "7bad8008-4b08-5444-bc02-a16600d66a30" :answer/type :answer.type/math :answer/value "∀\\,q\\in Q,\\,∃\\,k\\in Z,\\,kq=q" :db/ensure [:answer/validate]} {:db/id "answer-84a0f7dc-748f-5977-98f4-cc7c7bcb7a32" :answer/id #uuid "84a0f7dc-748f-5977-98f4-cc7c7bcb7a32" :answer/type :answer.type/math :answer/value "∃\\,k\\in Z,\\,∀\\,q\\in Q,\\,kq=q" :db/ensure [:answer/validate]} {:db/id "answer-337eee28-d0ff-5774-974d-6f7b31464bc5" :answer/id #uuid "337eee28-d0ff-5774-974d-6f7b31464bc5" :answer/type :answer.type/math :answer/value "∃\\,k\\in Z,\\,∃\\,q\\in Q,\\,kq=q" :db/ensure [:answer/validate]} {:db/id "answer-c314ce38-5463-5799-a600-f517694af5db" :answer/id #uuid "c314ce38-5463-5799-a600-f517694af5db" :answer/type :answer.type/math :answer/value "∃\\,q\\in Q,\\,∀\\,k\\in Z,\\,kq=k" :db/ensure [:answer/validate]} {:db/id "question-822441e0-0d3a-577b-9cb1-929e6c39db8d" :question/id #uuid "822441e0-0d3a-577b-9cb1-929e6c39db8d" :question/math-academy-id "q-183717" :question/problem "There is a real number such that, raised to any integer, the result is a rational number.\n\nExpress the statement above in formal language." :question/worked-solution "Let's examine our statement:\n\n- The words \"there exists\" indicate that we use an existential quantifier, $∃.$\n\n- The word \"any\" indicates that we use a universal quantifier, $∀.$\n\n- The sentence refers to real numbers and integers. So, by denoting our numbers as $x$ and $k,$ respectively, we have\n\n$$\n∃\\,x\\in R,\\,∀\\,k\\in Z.\n$$\n\n- Finally, the condition in the statement can be written as follows:\n\n$$\n{x}^{k}\\in Q\n$$\n\nTherefore, we write the statement as follows:\n\n$∃\\,x\\in R,\\,∀\\,k\\in Z,\\,{x}^{k}\\in Q$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3cdc6710-ca1a-5981-b0a2-0186ffd3f509"] :db/ensure [:question/validate]} {:db/id "answer-field-3cdc6710-ca1a-5981-b0a2-0186ffd3f509" :answer-field/id #uuid "3cdc6710-ca1a-5981-b0a2-0186ffd3f509" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cfdf3270-1913-5243-b0a3-4b9066c9a5ae" :answer-field/choices ["answer-87bd3680-2669-50c3-a706-c4f21ca5a8f1" "answer-60f48153-5303-511e-a5c1-204d5bb84306" "answer-857fcb90-58e7-5169-a4e8-cdffb26d856a" "answer-cfdf3270-1913-5243-b0a3-4b9066c9a5ae" "answer-665dd058-0658-5bbd-a0ab-dcb1fc441209"] :db/ensure [:answer-field/validate]} {:db/id "answer-87bd3680-2669-50c3-a706-c4f21ca5a8f1" :answer/id #uuid "87bd3680-2669-50c3-a706-c4f21ca5a8f1" :answer/type :answer.type/math :answer/value "∀\\,k\\in Z,\\,∃\\,x\\in R,\\,