#{[{:db/id #edb/ref 17592186115031 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115202 :knowledge-point/id #uuid "9bc0be03-9369-508e-9765-8c88871ec20b" :knowledge-point/title "The Range of a Transformed Logarithmic Function"}] :question/id #uuid "9369a037-e52c-5864-b691-297ae956d0f7" :question/math-academy-id "e-4124" :question/problem "What is the range of $f(x) = 5\\log_6(x-1)-4?$" :question/worked-solution "The range of the function $y = \\log_{6}(x)$ is $y \\in (-\\infty,\\infty).$ \n\nFor a logarithmic function, horizontal and vertical shifts and stretches do not affect the range.\n\nTherefore, the range of the given function is $f(x) \\in (-\\infty,\\infty).$"}] [{:db/id #edb/ref 17592186115036 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115206 :knowledge-point/id #uuid "03c91ac6-d580-536d-90a8-dc4bebdcdf7b" :knowledge-point/title "The Domain of a Transformed Logarithmic Function"}] :question/id #uuid "408f7da1-fe32-5c33-9293-01103faf1385" :question/math-academy-id "e-4134" :question/problem "What is the domain of $f(x)=\\ln (2x+4)-2?$" :question/worked-solution "The domain of $y = \\ln x$ is\n\n$$\nx \\gt 0.\n$$\n\nTo find the domain of $f(x),$ we replace $x$ with $2x+4$ in the above inequality. This gives\n\n$$\n2x+4 > 0.\n$$\n\nSolving this inequality, we obtain\n\n$$\n\\begin{aligned}2x+4 & >0 \\\\ 2x & >-4 \\\\ x & >-2.\\end{aligned}\n$$\n\nTherefore, the domain of $y = f(x)$ is $x\\in\\left( -2, \\infty \\right).$"}] [{:db/id #edb/ref 17592186115037 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115207 :knowledge-point/id #uuid "c21c1eca-cf80-56bd-9f44-aab7989cb210" :knowledge-point/title "The Root of a Transformed Logarithmic Function"}] :question/id #uuid "fe3c041b-ffb9-5b10-be4a-8a7bb3469a7c" :question/math-academy-id "e-4135" :question/problem "Find the root of $f(x) = \\log(2x) - 2.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0\\mathbin{:}$\n\n$$\n\\log(2x) - 2 = 0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(2x)-2 & =0 \\\\ \\operatorname{log}⁡(2x) & =2 \\\\ {10}^{\\operatorname{log}⁡(2x)} & ={10}^{2} \\\\ 2x & =100 \\\\ x & =50\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=50.$"}] [{:db/id #edb/ref 17592186115038 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115208 :knowledge-point/id #uuid "2f6f4cfa-db03-5ae6-9f43-79fd3167c473" :knowledge-point/title "The Vertical Asymptote of a Transformed Logarithmic Function"}] :question/id #uuid "f32fd8b8-7e72-5927-a75f-64237997c175" :question/math-academy-id "e-4137" :question/problem "Find the equation of the vertical asymptote of the function $f(x) = -\\ln(4x).$" :question/worked-solution "The equation of the vertical asymptote of the function $y = \\ln{x}$ is $x=0.$\n\nTo find the equation of the vertical asymptote of $f(x),$ we set the argument of the logarithmic term equal to zero, and solve for $x.$ This gives\n\n$$\n\\begin{aligned}4x & =0 \\\\ x & =0.\\end{aligned}\n$$\n\nTherefore, the equation of the vertical asymptote is $x = 0.$"}] [{:db/id #edb/ref 17592186564523 :knowledge-point/_questions [{:db/id #edb/ref 17592186115202 :knowledge-point/id #uuid "9bc0be03-9369-508e-9765-8c88871ec20b" :knowledge-point/title "The Range of a Transformed Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "294c8be5-9207-557e-bc83-1962a7384a81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186564033} {:answer/id #uuid "6138d91b-8219-58ef-a46d-5a53d78fb785" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)$ has no maximum value" :db/id #edb/ref 17592186564120} {:answer/id #uuid "6667b192-562c-5e48-8727-d1811a01ade7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186564130} {:answer/id #uuid "91ac72ca-94cc-556f-9e0b-0e02e4fa7c7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186564196} {:answer/id #uuid "cf8874f7-b734-5002-8cd2-d18ad56523c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186564296}] :answer-field/correct {:answer/id #uuid "6138d91b-8219-58ef-a46d-5a53d78fb785" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)$ has no maximum value" :db/id #edb/ref 17592186564120} :answer-field/id #uuid "55b3c41d-9ab9-5b46-9a5f-0309beda7ca0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564398}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cf10c890-1bed-5075-9d7f-bb216357cf94" :question/math-academy-id "q-166551" :question/problem "Find the maximum value of $f(x)=\\frac{1}{5}\\operatorname{log}⁡(3x-4)+3.$" :question/worked-solution "The range of the function $y=\\operatorname{log}⁡x$ is $y\\in (-\\infty ,\\infty ).$ \n\nHorizontal and vertical shifts and stretches do not affect the range of a logarithmic function.\n\nTherefore, the range of the given function is $f(x)\\in (-\\infty ,\\infty ),$ and the function has no maximum value."}] [{:db/id #edb/ref 17592186234035 :knowledge-point/_questions [{:db/id #edb/ref 17592186115206 :knowledge-point/id #uuid "03c91ac6-d580-536d-90a8-dc4bebdcdf7b" :knowledge-point/title "The Domain of a Transformed Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3550efc7-35cb-5814-94b8-fede4a088302" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (2,\\infty )" :db/id #edb/ref 17592186564056} {:answer/id #uuid "6beda0ec-d95b-5c6d-8778-b960e0ffbf50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-2,\\infty )" :db/id #edb/ref 17592186564138} {:answer/id #uuid "8b4b88eb-cf91-5136-ae61-f146f08cef17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [2,\\infty )" :db/id #edb/ref 17592186564185} {:answer/id #uuid "a36986d0-a604-5b40-87fb-231cd29bf444" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (\\frac{1}{2},\\infty )" :db/id #edb/ref 17592186564218} {:answer/id #uuid "fd982dca-1b36-5bf3-8e60-832ad2064c87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [\\frac{1}{2},\\infty )" :db/id #edb/ref 17592186564374}] :answer-field/correct {:answer/id #uuid "3550efc7-35cb-5814-94b8-fede4a088302" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (2,\\infty )" :db/id #edb/ref 17592186564056} :answer-field/id #uuid "29b036b2-53a7-5982-a624-2d6079e0bb8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564385}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "681f6cce-6a63-504d-a5b9-ef8102cd6098" :question/math-academy-id "q-4115" :question/problem "Find the domain of the function $f(x)=\\operatorname{log}⁡(\\frac{x}{2}-1)-4.$" :question/worked-solution "The domain of $y=\\operatorname{log}⁡x$ is\n\n$$\nx>0.\n$$\n\nTo find the domain of $f(x),$ we replace $x$ with $\\frac{x}{2}-1$ in the above inequality. This gives\n\n$$\n\\frac{x}{2}-1>0.\n$$\n\nSolving this inequality, we get\n\n$$\n\\begin{aligned}\\frac{x}{2}-1 & >0 \\\\ \\frac{x}{2} & >1 \\\\ x & >2.\\end{aligned}\n$$\n\nTherefore, the domain of $y=f(x)$ is $x\\in (2,\\infty ).$"}] [{:db/id #edb/ref 17592186564470 :knowledge-point/_questions [{:db/id #edb/ref 17592186115206 :knowledge-point/id #uuid "03c91ac6-d580-536d-90a8-dc4bebdcdf7b" :knowledge-point/title "The Domain of a Transformed Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c8bb634-5f7a-526b-b108-ac68b8ec6d79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (3,\\infty )" :db/id #edb/ref 17592186564006} {:answer/id #uuid "5f697687-ec84-5c60-ac6b-c8ef620378f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-3,\\infty )" :db/id #edb/ref 17592186564118} {:answer/id #uuid "9e80d32f-b381-5f5e-ada5-9f3b71ef09ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (\\frac{3}{2},\\infty )" :db/id #edb/ref 17592186564209} {:answer/id #uuid "d4a03f4b-ffe0-5cc9-94bd-21afd40d50db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186564305} {:answer/id #uuid "eafff2db-2dce-5e16-ad27-40dcf2655fe9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\frac{3}{2},\\frac{3}{2})" :db/id #edb/ref 17592186564345}] :answer-field/correct {:answer/id #uuid "9e80d32f-b381-5f5e-ada5-9f3b71ef09ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (\\frac{3}{2},\\infty )" :db/id #edb/ref 17592186564209} :answer-field/id #uuid "66632494-a4ad-5cc3-8b8f-9fc6ebacf3b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564405}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1124f708-b647-5fc7-9069-27535f9fe6bb" :question/math-academy-id "q-41247" :question/problem "Determine the domain of the function $f(x)=-\\frac{1}{4}{log}_{7}⁡(2x-3)+2.$" :question/worked-solution "The domain of $y={log}_{7}⁡x$ is\n\n$$\nx>0.\n$$\n\nTo find the domain of $f(x),$ we replace $x$ with $2x-3$ in the above inequality. This gives\n\n$$\n2x-3>0.\n$$\n\nSolving this inequality, we get\n\n$$\n\\begin{aligned}2x-3 & >0 \\\\ 2x & >3 \\\\ x & >\\frac{3}{2}\\end{aligned}\n$$\n\nTherefore, the domain of $y=f(x)$ is $x\\in (\\frac{3}{2},\\infty ).$"}] [{:db/id #edb/ref 17592186564500 :knowledge-point/_questions [{:db/id #edb/ref 17592186115202 :knowledge-point/id #uuid "9bc0be03-9369-508e-9765-8c88871ec20b" :knowledge-point/title "The Range of a Transformed Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e0ed534-4003-583b-b0cb-07a91f0d3599" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-4)" :db/id #edb/ref 17592186564008} {:answer/id #uuid "20d66e1a-2b6a-5c47-a4b1-f400a0483cb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186564015} {:answer/id #uuid "2c73133c-2ea2-5288-afe7-f8e114b0bfce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (0,\\infty )" :db/id #edb/ref 17592186564040} {:answer/id #uuid "965f1838-da64-5428-9b89-29a1f523deb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-4,\\infty )" :db/id #edb/ref 17592186564202} {:answer/id #uuid "b848b9ad-d1ad-5380-b3cf-6833aab59f24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-3,\\infty )" :db/id #edb/ref 17592186564253}] :answer-field/correct {:answer/id #uuid "20d66e1a-2b6a-5c47-a4b1-f400a0483cb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186564015} :answer-field/id #uuid "607549e3-c7c2-556c-bfd6-1c5bdeb01a33" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564402}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "800d4066-ddae-513f-a0b6-998ce2ab2521" :question/math-academy-id "q-81862" :question/problem "Determine the range of the function $f(x)={log}_{2}⁡(x+4)-3.$" :question/worked-solution "The range of the function $y={log}_{2}⁡(x)$ is $y\\in (-\\infty ,\\infty ).$ \n\nHorizontal and vertical shifts and stretches do not affect the range of a logarithmic function.\n\nTherefore, the range of the given function is $f(x)\\in (-\\infty ,\\infty ).$"}] [{:db/id #edb/ref 17592186234436 :knowledge-point/_questions [{:db/id #edb/ref 17592186115208 :knowledge-point/id #uuid "2f6f4cfa-db03-5ae6-9f43-79fd3167c473" :knowledge-point/title "The Vertical Asymptote of a Transformed Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18d08f42-e36c-5817-bb88-673383f3d8b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}" :db/id #edb/ref 17592186564003} {:answer/id #uuid "20bc18b6-3403-52ad-9d00-895d3898c60d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{4}" :db/id #edb/ref 17592186564013} {:answer/id #uuid "2b0b2db5-67a4-567e-9fd8-540f60ee1dba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186564036} {:answer/id #uuid "6f280d9f-2645-5146-bc46-5bac76779a40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=8" :db/id #edb/ref 17592186564141} {:answer/id #uuid "c5302e38-7aa6-5e48-9361-9c951f484d3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186564276}] :answer-field/correct {:answer/id #uuid "c5302e38-7aa6-5e48-9361-9c951f484d3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186564276} :answer-field/id #uuid "7aa3ee0d-cde1-5830-b46d-bcaca8241b0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564412}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a2fa019a-adf5-5729-8706-0b94847387b1" :question/math-academy-id "q-81990" :question/problem "Find the equation of the vertical asymptote of the function $f(x)=\\operatorname{log}⁡(2x)-8.$" :question/worked-solution "The equation of the vertical asymptote of the function $y=\\operatorname{log}⁡x$ is $x=0.$\n\nTo find the equation of the vertical asymptote of $f(x)$, we set the argument of the logarithmic term equal to zero, and solve for $x.$ This gives\n\n$$\n\\begin{aligned}2x & =0 \\\\ x & =0.\\end{aligned}\n$$\n\nTherefore, the equation of the vertical asymptote is $x=0.$"}] [{:db/id #edb/ref 17592186234437 :knowledge-point/_questions [{:db/id #edb/ref 17592186115208 :knowledge-point/id #uuid "2f6f4cfa-db03-5ae6-9f43-79fd3167c473" :knowledge-point/title "The Vertical Asymptote of a Transformed Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "499e3a9f-a923-51f5-87ce-febf5570144d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186564092} {:answer/id #uuid "5ad0934e-ac45-5e5a-966d-8d3b997ea00c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{10}" :db/id #edb/ref 17592186564112} {:answer/id #uuid "687ea3cb-6fc5-534a-986a-201d5b2e216b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=5" :db/id #edb/ref 17592186564133} {:answer/id #uuid "8233d628-290e-5135-b160-f3e991418b7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}" :db/id #edb/ref 17592186564170} {:answer/id #u