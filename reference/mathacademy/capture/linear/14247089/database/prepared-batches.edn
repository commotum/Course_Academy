71-8ae9-12aa552971f9"] ["answer-field-d4978139-adc9-5b94-8e08-b020f6e0a655" :answer-field/choices "answer-687ea3cb-6fc5-534a-986a-201d5b2e216b"] ["answer-field-d4978139-adc9-5b94-8e08-b020f6e0a655" :answer-field/choices "answer-5ad0934e-ac45-5e5a-966d-8d3b997ea00c"] ["answer-field-d4978139-adc9-5b94-8e08-b020f6e0a655" :answer-field/choices "answer-8233d628-290e-5135-b160-f3e991418b7d"] [17592186234437 :question/answer-fields "answer-field-d4978139-adc9-5b94-8e08-b020f6e0a655"] ["question-1e7e97e3-f06a-5ac7-917d-a28a5b06bd45" :question/id #uuid "1e7e97e3-f06a-5ac7-917d-a28a5b06bd45"] ["question-1e7e97e3-f06a-5ac7-917d-a28a5b06bd45" :question/math-academy-id "q-81997"] ["question-1e7e97e3-f06a-5ac7-917d-a28a5b06bd45" :question/problem "Find the root of $f(x)=\\operatorname{ln}⁡(2x+7).$"] ["question-1e7e97e3-f06a-5ac7-917d-a28a5b06bd45" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n\\operatorname{ln}⁡(2x+7)=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(2x+7) & =0 \\\\ {e}^{\\operatorname{ln}⁡(2x+7)} & ={e}^{0} \\\\ 2x+7 & =1 \\\\ 2x & =-6 \\\\ x & =-3\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=-3.$"] ["question-1e7e97e3-f06a-5ac7-917d-a28a5b06bd45" :question/difficulty :question.difficulty/easy] ["answer-field-6088b2f7-2581-5b62-9b22-3ffa46f44d91" :answer-field/id #uuid "6088b2f7-2581-5b62-9b22-3ffa46f44d91"] ["answer-54dbec5e-bb89-52c0-ab0f-690a484002ff" :answer/id #uuid "54dbec5e-bb89-52c0-ab0f-690a484002ff"] ["answer-54dbec5e-bb89-52c0-ab0f-690a484002ff" :answer/type :answer.type/math] ["answer-54dbec5e-bb89-52c0-ab0f-690a484002ff" :answer/value "x=-2"] ["answer-2f937e83-c00e-5e24-b941-669dcd4af536" :answer/id #uuid "2f937e83-c00e-5e24-b941-669dcd4af536"] ["answer-2f937e83-c00e-5e24-b941-669dcd4af536" :answer/type :answer.type/math] ["answer-2f937e83-c00e-5e24-b941-669dcd4af536" :answer/value "x=-3"] ["answer-f027a5aa-0171-5629-ac7d-daef459b821c