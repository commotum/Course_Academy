idate]} {:db/id "answer-field-d4978139-adc9-5b94-8e08-b020f6e0a655" :answer-field/id #uuid "d4978139-adc9-5b94-8e08-b020f6e0a655" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-499e3a9f-a923-51f5-87ce-febf5570144d" :answer-field/choices ["answer-499e3a9f-a923-51f5-87ce-febf5570144d" "answer-9937c1bf-8d48-5871-8ae9-12aa552971f9" "answer-687ea3cb-6fc5-534a-986a-201d5b2e216b" "answer-5ad0934e-ac45-5e5a-966d-8d3b997ea00c" "answer-8233d628-290e-5135-b160-f3e991418b7d"] :db/ensure [:answer-field/validate]} {:db/id "answer-499e3a9f-a923-51f5-87ce-febf5570144d" :answer/id #uuid "499e3a9f-a923-51f5-87ce-febf5570144d" :answer/type :answer.type/math :answer/value "x=0" :db/ensure [:answer/validate]} {:db/id "answer-9937c1bf-8d48-5871-8ae9-12aa552971f9" :answer/id #uuid "9937c1bf-8d48-5871-8ae9-12aa552971f9" :answer/type :answer.type/math :answer/value "x=10" :db/ensure [:answer/validate]} {:db/id "answer-687ea3cb-6fc5-534a-986a-201d5b2e216b" :answer/id #uuid "687ea3cb-6fc5-534a-986a-201d5b2e216b" :answer/type :answer.type/math :answer/value "x=5" :db/ensure [:answer/validate]} {:db/id "answer-5ad0934e-ac45-5e5a-966d-8d3b997ea00c" :answer/id #uuid "5ad0934e-ac45-5e5a-966d-8d3b997ea00c" :answer/type :answer.type/math :answer/value "x=\\frac{1}{10}" :db/ensure [:answer/validate]} {:db/id "answer-8233d628-290e-5135-b160-f3e991418b7d" :answer/id #uuid "8233d628-290e-5135-b160-f3e991418b7d" :answer/type :answer.type/math :answer/value "x=\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "question-1e7e97e3-f06a-5ac7-917d-a28a5b06bd45" :question/id #uuid "1e7e97e3-f06a-5ac7-917d-a28a5b06bd45" :question/math-academy-id "q-81997" :question/problem "Find the root of $f(x)=\\operatorname{ln}⁡(2x+7).$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n\\operatorname{ln}⁡(2x+7)=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(2x+7) & =0 \\\\ {e}^{\\operatorname{ln}⁡(2x+7)} & ={e}^{0} \\\\ 2x+7 & =1 \\\\ 2x & =-6 \\\\ x & =-3\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=-3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6088b2f7-2581-5b62-9b22-3ffa46f44d91"] :db/ensure [:question/validate]} {:db/id "answer-field-6088b2f7-2581-5b62-9b22-3ffa46f44d91" :answer-field/id #uuid "6088b2f7-2581-5b62-9b22-3ffa46f44d91" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2f937e83-c00e-5e24-b941-669dcd4af536" :answer-field/choices ["answer-54dbec5e-bb89-52c0-ab0f-690a484002ff" "answer-2f937e83-c00e-5e24-b941-669dcd4af536" "answer-f027a5aa-0171-5629-ac7d-daef459b821c" "answer-ef8be49d-6b79-527f-8dc8-5e1926470d59" "answer-4a2d223a-b4c3-59b7-8f03-696f806b5729"] :db/ensure [:answer-field/validate]} {:db/id "answer-54dbec5e-bb89-52c0-ab0f-690a484002ff" :answer/id #uuid "54dbec5e-bb89-52c0-ab0f-690a484002ff" :answer/type :answer.type/math :answer/value "x=-2" :db/ensure [:answer/validate]} {:db/id "answer-2f937e83-c00e-5e24-b941-669dcd4af536" :answer/id #uuid "2f937e83-c00e-5e24-b941-669dcd4af536" :answer/type :answer.type/math :answer/value "x=-3" :db/ensure [:answer/validate]} {:db/id "answer-f027a5aa-0171-5629-ac7d-daef459b821c" :answer/id #uuid "f027a5aa-0171-5629-ac7d-daef459b821c" :answer/type :answer.type/math :answer/value "x=-\\frac{7}{2}" :db/ensure [:answer/validate]} {:db/id "answer-ef8be49d-6b79-527f-8dc8-5e1926470d59" :answer/id #uuid "ef8be49d-6b79-527f-8dc8-5e1926470d59" :answer/type :answer.type/math :answer/value "x=3" :db/ensure [:answer/validate]} {:db/id "answer-4a2d223a-b4c3-59b7-8f03-696f806b5729" :answer/id #uuid "4a2d223a-b4c3-59b7-8f03-696f806b5729" :answer/type :answer.type/math :answer/value "x=4" :db/ensure [:answer/validate]} {:db/id 17592186234440 :question/problem "Find the root of $f(x)=2{log}_{2}⁡(x)-6.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n2{log}_{2}⁡(x)-6=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}2{log}_{2}⁡(x)-6 & =0 \\\\ 2{log}_{2}⁡(x) & =6 \\\\ {log}_{2}⁡(x) & =3 \\\\ {2}^{{log}_{2}⁡(x)} & ={2}^{3} \\\\ x & =8\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=8.$" :question/answer-fields ["answer-field-9768eaaa-8761-51c7-87c0-8475f53214f4"] :db/ensure [:question/validate]} {:db/id "answer-field-9768eaaa-8761-51c7-87c0-8475f53214f4" :answer-field/id #uuid "9768eaaa-8761-51c7-87c0-8475f53214f4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e97016e4-6a8f-5328-b33e-52efd1dc2a5e" :answer-field/choices ["answer-f0704e6b-a2ce-5b70-bceb-9f22d2c7b3f1" "answer-ed15a969-b552-5a08-90d0-2f86afcf0b42" "answer-d054c24f-b046-5e4b-9c2e-39da68f8ec3b" "answer-ab806a45-cc37-5501-bd80-db533a934d1d" "answer-e97016e4-6a8f-5328-b33e-52efd1dc2a5e"] :db/ensure [:answer-field/validate]} {:db/id "answer-f0704e6b-a2ce-5b70-bceb-9f22d2c7b3f1" :answer/id #uuid "f0704e6b-a2ce-5b70-bceb-9f22d2c7b3f1" :answer/type :answer.type/math :answer/value "x=1" :db/ensure [:answer/validate]} {:db/id "answer-ed15a969-b552-5a08-90d0-2f86afcf0b42" :answer/id #uuid "ed15a969-b552-5a08-90d0-2f86afcf0b42" :answer/type :answer.type/math :answer/value "x=16" :db/ensure [:answer/validate]} {:db/id "answer-d054c24f-b046-5e4b-9c2e-39da68f8ec3b" :answer/id #uuid "d054c24f-b046-5e4b-9c2e-39da68f8ec3b" :answer/type :answer.type/math :answer/value "x=4" :db/ensure [:answer/validate]} {:db/id "answer-ab806a45-cc37-5501-bd80-db533a934d1d" :answer/id #uuid "ab806a45-cc37-5501-bd80-db533a934d1d" :answer/type :answer.type/math :answer/value "x=6" :db/ensure [:answer/validate]} {:db/id "answer-e97016e4-6a8f-5328-b33e-52efd1dc2a5e" :answer/id #uuid "e97016e4-6a8f-5328-b33e-52efd1dc2a5e" :answer/type :answer.type/math :answer/value "x=8" :db/ensure [:answer/validate]} {:db/id "question-800d4066-ddae-513f-a0b6-998ce2ab2521" :question/id #uuid "800d4066-ddae-513f-a0b6-998ce2ab2521" :question/math-academy-id "q-81862" :question/problem "Determine the range of the function $f(x)={log}_{2}⁡(x+4)-3.$" :question/worked-solution "The range of the function $y={log}_{2}⁡(x)$ is $y\\in (-\\infty ,\\infty ).$ \n\nHorizontal and vertical shifts and stretches do not affect the range of a logarithmic function.\n\nTherefore, the range of the given function is $f(x)\\in (-\\infty ,\\infty ).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-607549e3-c7c2-556c-bfd6-1c5bdeb01a33"] :db/ensure [:question/validate]} {:db/id "answer-field-607549e3-c7c2-556c-bfd6-1c5bdeb01a33" :answer-field/id #uuid "607549e3-c7c2-556c-bfd6-1c5bdeb01a33" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-20d66e1a-2b6a-5c47-a4b1-f400a0483cb3" :answer-field/choices ["answer-b848b9ad-d1ad-5380-b3cf-6833aab59f24" "answer-965f1838-da64-5428-9b89-29a1f523deb8" "answer-1e0ed534-4003-583b-b0cb-07a91f0d3599" "answer-20d66e1a-2b6a-5c47-a4b1-f400a0483cb3" "answer-2c73133c-2ea2-5288-afe7-f8e114b0bfce"] :db/ensure [:answer-field/validate]} {:db/id "answer-b848b9ad-d1ad-5380-b3cf-6833aab59f24" :answer/id #uuid "b848b9ad-d1ad-5380-b3cf-6833aab59f24" :answer/type :answer.type/math :answer/value "f(x)\\in (-3,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-965f1838-da64-5428-9b89-29a1f523deb8" :answer/id #uuid "965f1838-da64-5428-9b89-29a1f523deb8" :answer/type :answer.type/math :answer/value "f(x)\\in (-4,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-1e0ed534-4003-583b-b0cb-07a91f0d3599" :answer/id #uuid "1e0ed534-4003-583b-b0cb-07a91f0d3599" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,-4)" :db/ensure [:answer/validate]} {:db/id "answer-20d66e1a-2b6a-5c47-a4b1-f400a0483cb3" :answer/id #uuid "20d66e1a-2b6a-5c47-a4b1-f400a0483cb3" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-2c73133c-2ea2-5288-afe7-f8e114b0bfce" :answer/id #uuid "2c73133c-2ea2-5288-afe7-f8e114b0bfce" :answer/type :answer.type/math :answer/value "f(x)\\in (0,\\infty )" :db/ensure [:answer/validate]} {:db/id "question-cf10c890-1bed-5075-9d7f-bb216357cf94" :question/id #uuid "cf10c890-1bed-5075-9d7f-bb216357cf94" :question/math-academy-id "q-166551" :question/problem "Find the maximum value of $f(x)=\\frac{1}{5}\\operatorname{log}⁡(3x-4)+3.$" :question/worked-solution "The range of the function $y=\\operatorname{log}⁡x$ is $y\\in (-\\infty ,\\infty ).$ \n\nHorizontal and vertical shifts and stretches do not affect the range of a logarithmic function.\n\nTherefore, the range of the given function is $f(x)\\in (-\\infty ,\\infty ),$ and the function has no maximum value." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-55b3c41d-9ab9-5b46-9a5f-0309beda7ca0"] :db/ensure [:question/validate]} {:db/id "answer-field-55b3c41d-9ab9-5b46-9a5f-0309beda7ca0" :answer-field/id #uuid "55b3c41d-9ab9-5b46-9a5f-0309beda7ca0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6138d91b-8219-58ef-a46d-5a53d78fb785" :answer-field/choices ["answer-91ac72ca-94cc-556f-9e0b-0e02e4fa7c7e" "answer-294c8be5-9207-557e-bc83-1962a7384a81" "answer-cf8874f7-b734-5002-8cd2-d18ad56523c4" "answer-6667b192-562c-5e48-8727-d1811a01ade7" "answer-6138d91b-8219-58ef-a46d-5a53d78fb785"] :db/ensure [:answer-field/validate]} {:db/id "answer-91ac72ca-94cc-556f-9e0b-0e02e4fa7c7e" :answer/id #uuid "91ac72ca-94cc-556f-9e0b-0e02e4fa7c7e" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-294c8be5-9207-557e-bc83-1962a7384a81" :answer/id #uuid "294c8be5-9207-557e-bc83-1962a7384a81" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-cf8874f7-b734-5002-8cd2-d18ad56523c4" :answer/id #uuid "cf8874f7-b734-5002-8cd2-d18ad56523c4" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-6667b192-562c-5e48-8727-d1811a01ade7" :answer/id #uuid "6667b192-562c-5e48-8727-d1811a01ade7" :answer/type :answer.type/math :answer/value "\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "answer-6138d91b-8219-58ef-a46d-5a53d78fb785" :answer/id #uuid "6138d91b-8219-58ef-a46d-5a53d78fb785" :answer/type :answer.type/text :answer/value "$f(x)$ has no maximum value" :db/ensure [:answer/validate]} {:db/id 17592186116480 :tutorial/content "When we transform a logarithmic function $y = \\log_a (x),$ its domain might be modified as well.\n\nFor example, the diagram below shows the graph of the transformed logarithmic function $f(x) = \\log_2(x-1).$ What is the domain of $f(x)?$\n\n![](images/f1/f135e52b40df0923dea0bfd58a3255a096cab4ab23faa7c761ac5998fdfdd782.png)\n\nFirst, recall that the domain of $y=\\log_a (x)$ is\n\n$$\nx > 0.\n$$\n\nTo find the domain of $f(x),$ we take the above inequality and replace $x$ with the argument (or input) of the logarithm function contained in $f(x).$ In this case, the argument is $x-1,$ so we get\n\n$$\nx-1 > 0.\n$$\n\nSolving this inequality, we obtain\n\n$$\n\\begin{aligned}x-1 & >0 \\\\ x & >1.\\end{aligned}\n$$\n\nTherefore, the domain of $y=f(x)$ is $x\\in(1, \\infty).$" :db/ensure [:tutorial/validate]} {:db/id 17592186116527 :tutorial/content "When we transform a logarithmic function $y = \\log_a (x),$ its range is not affected.\n\nFor example, the diagram below shows the graph of the transformed logarithmic function $f(x) = 3\\log_2(x-1)+1.$ \n\n![](images/4a/4a5bad1159efe184b0afc2731ebd6b5dd6149a0a1ba2d530cfdc769ab2acf250.png)\n\nThe range of $\\log_2 x$ is\n\n$$\n\\log_2 x \\in (-\\infty,\\infty).\n$$\n\nBecause the range of the logarithm function is the interval containing all real numbers, horizontal and vertical shifts and stretches do not affect its range. Therefore, the range of $f(x)$ is\n\n$$\nf(x) \\in (-\\infty,\\infty).\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186115436 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}] "assertions" [[17592186115036 :question/problem "What is the domain of $f(x)=\\ln (2x+4)-2?$"] [17592186115036 :question/worked-solution "The domain of $y = \\ln x$ is\n\n$$\nx \\gt 0.\n$$\n\nTo find the domain of $f(x),$ we replace $x$ with $2x+4$ in the above inequality. This gives\n\n$$\n2x+4 > 0.\n$$\n\nSolving this inequality, we obtain\n\n$$\n\\begin{aligned}2x+4 & >0 \\\\ 2x & >-4 \\\\ x & >-2.\\end{aligned}\n$$\n\nTherefore, the domain of $y = f(x)$ is $x\\in\\left( -2, \\infty \\right).$"] [17592186115038 :question/problem "Find the equation of the vertical asymptote of the function $f(x) = -\\ln(4x).$"] [17592186115038 :question/worked-solution "The equation of the vertical asymptote of the function $y = \\ln{x}$ is $x=0.$\n\nTo find the equation of the vertical asymptote of $f(x),$ we set the argument of the logarithmic term equal to zero, and solve for $x.$ This gives\n\n$$\n\\begin{aligned}4x & =0 \\\\ x & =0.\\end{aligned}\n$$\n\nTherefore, the equation of the vertical asymptote is $x = 0.$"] [17592186115037 :question/problem "Find the root of $f(x) = \\log(2x) - 2.$"] [17592186115037 :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0\\mathbin{:}$\n\n$$\n\\log(2x) - 2 = 0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(2x)-2 & =0 \\\\ \\operatorname{log}⁡(2x) & =2 \\\\ {10}^{\\operatorname{log}⁡(2x)} & ={10}^{2} \\\\ 2x & =100 \\\\ x & =50\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=50.$"] [17592186115031 :question/problem "What is the range of $f(x) = 5\\log_6(x-1)-4?$"] [17592186115031 :question/worked-solution "The range of the function $y = \\log_{6}(x)$ is $y \\in (-\\infty,\\infty).$ \n\nFor a logarithmic function, horizontal and vertical shifts and stretches do not affect the range.\n\nTherefore, the range of the given function is $f(x) \\in (-\\infty,\\infty).$"] ["question-1124f708-b647-5fc7-9069-27535f9fe6bb" :question/id #uuid "1124f708-b647-5fc7-9069-27535f9fe6bb"] ["question-1124f708-b647-5fc7-9069-27535f9fe6bb" :question/math-academy-id "q-41247"] ["question-1124f708-b647-5fc7-9069-27535f9fe6bb" :question/problem "Determine the domain of the function $f(x)=-\\frac{1}{4}{log}_{7}⁡(2x-3)+2.$"] ["question-1124f708-b647-5fc7-9069-27535f9fe6bb" :question/worked-solution "The domain of $y={log}_{7}⁡x$ is\n\n$$\nx>0.\n$$\n\nTo find the domain of $f(x),$ we replace $x$ with $2x-3$ in the above inequality. This gives\n\n$$\n2x-3>0.\n$$\n\nSolving this inequality, we get\n\n$$\n\\begin{aligned}2x-3 & >0 \\\\ 2x & >3 \\\\ x & >\\frac{3}{2}\\end{aligned}\n$$\n\nTherefore, the domain of $y=f(x)$ is $x\\in (\\frac{3}{2},\\infty ).$"] ["question-1124f708-b647-5fc7-9069-27535f9fe6bb" :question/difficulty :question.difficulty/moderate] ["answer-field-66632494-a4ad-5cc3-8b8f-9fc6ebacf3b4" :answer-field/id #uuid "66632494-a4ad-5cc3-8b8f-9fc6ebacf3b4"] ["answer-5f697687-ec84-5c60-ac6b-c8ef620378f1" :answer/id #uuid "5f697687-ec84-5c60-ac6b-c8ef620378f1"] ["answer-5f697687-ec84-5c60-ac6b-c8ef620378f1" :answer/type :answer.type/math] ["answer-5f697687-ec84-5c60-ac6b-c8ef620378f1" :answer/value "x\\in (-3,\\infty )"] ["answer-eafff2db-2dce-5e16-ad27-40dcf2655fe9" :answer/id #uuid "eafff2db-2dce-5e16-ad27-40dcf2655fe9"] ["answer-eafff2db-2dce-5e16-ad27-40dcf2655fe9" :answer/type :answer.type/math] ["answer-eafff2db-2dce-5e16-ad27-40dcf2655fe9" :answer/value "x\\in (-\\frac{3}{2},\\frac{3}{2})"] ["answer-d4a03f4b-ffe0-5cc9-94bd-21afd40d50db" :answer/id #uuid "d4a03f4b-ffe0-5cc9-94bd-21afd40d50db"] ["answer-d4a03f4b-ffe0-5cc9-94bd-21afd40d50db" :answer/type :answer.type/math] ["answer-d4a03f4b-ffe0-5cc9-94bd-21afd40d50db" :answer/value "x\\in (-\\infty ,\\infty )"] ["answer-1c8bb634-5f7a-526b-b108-ac68b8ec6d79" :answer/id #uuid "1c8bb634-5f7a-526b-b108-ac68b8ec6d79"] 