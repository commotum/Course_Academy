0 \\\\ \\frac{x}{2} & >1 \\\\ x & >2.\\end{aligned}\n$$\n\nTherefore, the domain of $y=f(x)$ is $x\\in (2,\\infty ).$"] ["answer-field-29b036b2-53a7-5982-a624-2d6079e0bb8d" :answer-field/id #uuid "29b036b2-53a7-5982-a624-2d6079e0bb8d"] ["answer-6beda0ec-d95b-5c6d-8778-b960e0ffbf50" :answer/id #uuid "6beda0ec-d95b-5c6d-8778-b960e0ffbf50"] ["answer-6beda0ec-d95b-5c6d-8778-b960e0ffbf50" :answer/type :answer.type/math] ["answer-6beda0ec-d95b-5c6d-8778-b960e0ffbf50" :answer/value "x\\in (-2,\\infty )"] ["answer-3550efc7-35cb-5814-94b8-fede4a088302" :answer/id #uuid "3550efc7-35cb-5814-94b8-fede4a088302"] ["answer-3550efc7-35cb-5814-94b8-fede4a088302" :answer/type :answer.type/math] ["answer-3550efc7-35cb-5814-94b8-fede4a088302" :answer/value "x\\in (2,\\infty )"] ["answer-a36986d0-a604-5b40-87fb-231cd29bf444" :answer/id #uuid "a36986d0-a604-5b40-87fb-231cd29bf444"] ["answer-a36986d0-a604-5b40-87fb-231cd29bf444" :answer/type :answer.type/math] ["answer-a36986d0-a604-5b40-87fb-231cd29bf444" :answer/value "x\\in (\\frac{1}{2},\\infty )"] ["answer-8b4b88eb-cf91-5136-ae61-f146f08cef17" :answer/id #uuid "8b4b88eb-cf91-5136-ae61-f146f08cef17"] ["answer-8b4b88eb-cf91-5136-ae61-f146f08cef17" :answer/type :answer.type/math] ["answer-8b4b88eb-cf91-5136-ae61-f146f08cef17" :answer/value "x\\in [2,\\infty )"] ["answer-fd982dca-1b36-5bf3-8e60-832ad2064c87" :answer/id #uuid "fd982dca-1b36-5bf3-8e60-832ad2064c87"] ["answer-fd982dca-1b36-5bf3-8e60-832ad2064c87" :answer/type :answer.type/math] ["answer-fd982dca-1b36-5bf3-8e60-832ad2064c87" :answer/value "x\\in [\\frac{1}{2},\\infty )"] ["answer-field-29b036b2-53a7-5982-a624-2d6079e0bb8d" :answer-field/key "selection"] ["answer-field-29b036b2-53a7-5982-a624-2d6079e0bb8d" :answer-field/type :answer-field.type/radio] ["answer-field-29b036b2-53a7-5982-a624-2d6079e0bb8d" :answer-field/correct "answer-3550efc7-35cb-5814-94b8-fede4a088302"] ["answer-field-29b036b2-53a7-5982-a624-2d6079e0bb8d" :answer-field/choices "answer-6beda0ec-d95b-5c6d-8778-