#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186116065} :activity/id #uuid "3ac35acf-8ff9-5443-aae3-b13b39b2c063" :activity/scope {:db/id #edb/ref 17592186049984 :topic/id #uuid "23eb9850-2a23-5b4a-945c-ef50f44e8b95" :topic/math-academy-id 1610} :activity/steps [{:db/id #edb/ref 17592186116064 :step/content {:db/id #edb/ref 17592186115202 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115031 :question/id #uuid "9369a037-e52c-5864-b691-297ae956d0f7" :question/math-academy-id "e-4124"} :knowledge-point/id #uuid "9bc0be03-9369-508e-9765-8c88871ec20b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050580}] :knowledge-point/questions [{:db/id #edb/ref 17592186115826} {:db/id #edb/ref 17592186115827} {:db/id #edb/ref 17592186234036} {:db/id #edb/ref 17592186234037} {:db/id #edb/ref 17592186234472} {:db/id #edb/ref 17592186234473} {:db/id #edb/ref 17592186284571} {:db/id #edb/ref 17592186404191} {:db/id #edb/ref 17592186564500} {:db/id #edb/ref 17592186564523}] :knowledge-point/title "The Range of a Transformed Logarithmic Function"} :step/id #uuid "384c0c6c-5248-5290-97c1-92fb295d4a23" :step/math-academy-id 14751} {:db/id #edb/ref 17592186116065 :step/content {:db/id #edb/ref 17592186116480 :tutorial/content "When we transform a logarithmic function $y = \\log_a (x),$ its domain might be modified as well.\n\nFor example, the diagram below shows the graph of the transformed logarithmic function $f(x) = \\log_2(x-1).$ What is the domain of $f(x)?$\n\n![](images/f1/f135e52b40df0923dea0bfd58a3255a096cab4ab23faa7c761ac5998fdfdd782.png)\n\nFirst, recall that the domain of $y=\\log_a (x)$ is\n\n$$\nx > 0.\n$$\n\nTo find the domain of $f(x),$ we take the above inequality and replace $x$ with the argument (or input) of the logarithm function contained in $f(x).$ In this case, the argument is $x-1,$ so we get\n\n$$\nx-1 > 0.\n$$\n\nSolving this inequality, we obtain\n\n$$\n\\begin{aligned}x-1 & >0 \\\\ x & >1.\\end{aligned}\n$$\n\nTherefore, the domain of $y=f(x)$ is $x\\in(1, \\infty).$" :tutorial/id #uuid "345c9fab-a753-50d1-8833-12d8b2699fdc" :tutorial/math-academy-id 2817 :tutorial/title "Introduction"} :step/id #uuid "c28010bb-768d-5180-80ed-fe083c51657a" :step/math-academy-id 14752 :step/next {:db/id #edb/ref 17592186116069}} {:db/id #edb/ref 17592186116069 :step/content {:db/id #edb/ref 17592186115206 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115036 :question/id #uuid "408f7da1-fe32-5c33-9293-01103faf1385" :question/math-academy-id "e-4134"} :knowledge-point/id #uuid "03c91ac6-d580-536d-90a8-dc4bebdcdf7b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049072} {:db/id #edb/ref 17592186049986} {:db/id #edb/ref 17592186050126}] :knowledge-point/questions [{:db/id #edb/ref 17592186115823} {:db/id #edb/ref 17592186115824} {:db/id #edb/ref 17592186234031} {:db/id #edb/ref 17592186234035} {:db/id #edb/ref 17592186564470}] :knowledge-point/title "The Domain of a Transformed Logarithmic Function"} :step/id #uuid "90725b0a-e073-5cef-9f8c-63d3ced7c252" :step/math-academy-id 14763 :step/next {:db/id #edb/ref 17592186116071}} {:db/id #edb/ref 17592186116070 :step/content {:db/id #edb/ref 17592186115207 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115037 :question/id #uuid "fe3c041b-ffb9-5b10-be4a-8a7bb3469a7c" :question/math-academy-id "e-4135"} :knowledge-point/id #uuid "c21c1eca-cf80-56bd-9f44-aab7989cb210" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049944}] :knowledge-point/questions [{:db/id #edb/ref 17592186115939} {:db/id #edb/ref 17592186115940} {:db/id #edb/ref 17592186234439} {:db/id #edb/ref 17592186234440} {:db/id #edb/ref 17592186234441} {:db/id #edb/ref 17592186234442} {:db/id #edb/ref 17592186234443} {:db/id #edb/ref 17592186284570} {:db/id #edb/ref 17592186351387} {:db/id #edb/ref 17592186564475}] :knowledge-point/title "The Root of a Transformed Logarithmic Function"} :step/id #uuid "636b36e3-3d80-555c-9df7-ca290c70e2a7" :step/math-academy-id 14764 :step/next {:db/id #edb/ref 17592186116215}} {:db/id #edb/ref 17592186116071 :step/content {:db/id #edb/ref 17592186115208 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115038 :question/id #uuid "f32fd8b8-7e72-5927-a75f-64237997c175" :question/math-academy-id "e-4137"} :knowledge-point/id #uuid "2f6f4cfa-db03-5ae6-9f43-79fd3167c473" :knowledge-point/questions [{:db/id #edb/ref 17592186115937} {:db/id #edb/ref 17592186115938} {:db/id #edb/ref 17592186233554} {:db/id #edb/ref 17592186234434} {:db/id #edb/ref 17592186234435} {:db/id #edb/ref 17592186234436} {:db/id #edb/ref 17592186234437} {:db/id #edb/ref 17592186234438} {:db/id #edb/ref 17592186284569} {:db/id #edb/ref 17592186351385} {:db/id #edb/ref 17592186351386}] :knowledge-point/title "The Vertical Asymptote of a Transformed Logarithmic Function"} :step/id #uuid "52c020a1-e0a6-5cb2-bf97-12bce02196c2" :step/math-academy-id 14766 :step/next {:db/id #edb/ref 17592186116070}} {:db/id #edb/ref 17592186116215 :step/content {:db/id #edb/ref 17592186116527 :tutorial/content "When we transform a logarithmic function $y = \\log_a (x),$ its range is not affected.\n\nFor example, the diagram below shows the graph of the transformed logarithmic function $f(x) = 3\\log_2(x-1)+1.$ \n\n![](images/4a/4a5bad1159efe184b0afc2731ebd6b5dd6149a0a1ba2d530cfdc769ab2acf250.png)\n\nThe range of $\\log_2 x$ is\n\n$$\n\\log_2 x \\in (-\\infty,\\infty).\n$$\n\nBecause the range of the logarithm function is the interval containing all real numbers, horizontal and vertical shifts and stretches do not affect its range. Therefore, the range of $f(x)$ is\n\n$$\nf(x) \\in (-\\infty,\\infty).\n$$" :tutorial/id #uuid "c2975532-f898-5fd3-a901-a0d8f037906f" :tutorial/math-academy-id 4589 :tutorial/title "The Range of a Transformed Logarithmic Function"} :step/id #uuid "d6a66ee2-2a89-5925-b760-ad474a57ea5c" :step/math-academy-id 28229 :step/next {:db/id #edb/ref 17592186116064}}] :activity/title "Properties of Transformed Logarithmic Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115436}]}
