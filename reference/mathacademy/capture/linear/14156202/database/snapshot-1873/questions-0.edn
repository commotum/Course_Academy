#{[{:db/id #edb/ref 17592186133496 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133958 :knowledge-point/id #uuid "10b6f888-d49e-5ddf-be39-e26d7f82c110" :knowledge-point/title "Finding the Reciprocal of an Integer"}] :question/id #uuid "fc3055a3-5118-5a5b-8150-caadbfdae02b" :question/math-academy-id "e-12788" :question/problem "What is the reciprocal of $-21?$" :question/worked-solution "To find the reciprocal of $-21,$ we divide $1$ by $-21.$ So, we obtain \n\n$$\n1 \\div (-21) = -\\dfrac{1}{21}.\n$$"}] [{:db/id #edb/ref 17592186133497 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133959 :knowledge-point/id #uuid "b955f390-c260-5f97-8e5c-62b8eb67242e" :knowledge-point/title "Finding the Reciprocal of a Fraction"}] :question/id #uuid "2132b7c8-2d11-51c8-a1e3-06bb59c08f84" :question/math-academy-id "e-12789" :question/problem "Find the reciprocal of $\\dfrac{1}{10}.$" :question/worked-solution "We flip the numerator and the denominator. So, the reciprocal of $\\dfrac{1}{10}$ is  $\\dfrac{10}{1} = 10.$"}] [{:db/id #edb/ref 17592186133498 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133960 :knowledge-point/id #uuid "7e422f35-9db3-5969-b72e-ea8bf681da91" :knowledge-point/title "Finding the Reciprocal of a Mixed Number"}] :question/id #uuid "e757528d-e87f-5739-85d4-0b35267db955" :question/math-academy-id "e-12790" :question/problem "Calculate the reciprocal of $-2\\,\\dfrac{1}{3}.$" :question/worked-solution "First, we write the mixed number as an improper fraction:\n\n$$\n-2\\,\\dfrac{1}{3}=-\\dfrac{2\\cdot 3+1}{3}=-\\dfrac{7}{3}\n$$\n\nThen, we flip the numerator and the denominator, keeping the negative sign. Therefore, the reciprocal of $-2\\,\\dfrac{1}{3}$ is $-\\dfrac{3}{7}.$"}] [{:db/id #edb/ref 17592186133499 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133961 :knowledge-point/id #uuid "65e46d22-ed28-5950-8672-7926f9ceef50" :knowledge-point/title "Finding the Reciprocal of a Decimal"}] :question/id #uuid "7c2a7d91-c840-5f6a-8e9d-d17673e8cb70" :question/math-academy-id "e-12791" :question/problem "What is the reciprocal of $0.4?$" :question/worked-solution "First, we must convert the decimal to a fraction. Doing this, we get\n\n$$\n0.4 = \\dfrac{4}{10} = \\dfrac{{\\color{blue}{2}}}{{\\color{red}{5}}}.\n$$\n\nNow, we flip the fraction, as before. So the reciprocal of $0.4$ is $\\dfrac{{\\color{red}{5}}}{{\\color{blue}{2}}} = 2.5.$"}] [{:db/id #edb/ref 17592186479108 :knowledge-point/_questions [{:db/id #edb/ref 17592186133960 :knowledge-point/id #uuid "7e422f35-9db3-5969-b72e-ea8bf681da91" :knowledge-point/title "Finding the Reciprocal of a Mixed Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87e9c5ba-4bd4-55ce-88cf-90e6f8c4b1a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{9}" :db/id #edb/ref 17592186478769}] :answer-field/correct {:answer/id #uuid "87e9c5ba-4bd4-55ce-88cf-90e6f8c4b1a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{9}" :db/id #edb/ref 17592186478769} :answer-field/id #uuid "9a2cc768-0bf0-5878-9554-f1f1743dde13" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479019}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "91c3c8c6-ac05-5f5c-bd08-a6bb467209d7" :question/math-academy-id "q-173695" :question/problem "The reciprocal of $-4\\,\\frac{1}{2}$ is{{field-1}}." :question/worked-solution "First, we write the number as a regular fraction:\n\n$$\n-4\\,\\frac{1}{2}=-\\frac{4\\cdot 2+1}{2}=-\\frac{9}{2}\n$$\n\nThen, we flip the numerator and denominator, keeping the sign of the fraction. So the reciprocal of $-4\\frac{1}{2}$ is $-\\frac{2}{9}.$"}] [{:db/id #edb/ref 17592186479142 :knowledge-point/_questions [{:db/id #edb/ref 17592186133960 :knowledge-point/id #uuid "7e422f35-9db3-5969-b72e-ea8bf681da91" :knowledge-point/title "Finding the Reciprocal of a Mixed Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7567db39-67e8-5474-b3f5-331ea3bd5083" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{14}" :db/id #edb/ref 17592186478733}] :answer-field/correct {:answer/id #uuid "7567db39-67e8-5474-b3f5-331ea3bd5083" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{14}" :db/id #edb/ref 17592186478733} :answer-field/id #uuid "236ee32a-5f42-50af-8a76-80651d348499" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186478969}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f127ccf9-f581-5522-a0c1-5f3908dc1d25" :question/math-academy-id "q-178342" :question/problem "The reciprocal of $4\\,\\frac{2}{3}$ is{{field-1}}." :question/worked-solution "First, we write the number as a regular fraction:\n\n$$\n4\\,\\frac{2}{3}=\\frac{4\\cdot 3+2}{3}=\\frac{14}{3}\n$$\n\nThen, we flip the numerator and denominator, keeping the sign of the fraction. So the reciprocal of $\\frac{14}{3}$ is $\\frac{3}{14}.$"}] [{:db/id #edb/ref 17592186479100 :knowledge-point/_questions [{:db/id #edb/ref 17592186133961 :knowledge-point/id #uuid "65e46d22-ed28-5950-8672-7926f9ceef50" :knowledge-point/title "Finding the Reciprocal of a Decimal"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44d2b8d3-02b8-55a7-92b7-737930bcb33f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{39}" :db/id #edb/ref 17592186478655}] :answer-field/correct {:answer/id #uuid "44d2b8d3-02b8-55a7-92b7-737930bcb33f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{39}" :db/id #edb/ref 17592186478655} :answer-field/id #uuid "f14fc10f-c4d9-50cc-87e1-30b95f0d82a1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479052}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "807be93b-6cd0-5b9f-b7c9-fdc2729b89b6" :question/math-academy-id "q-178518" :question/problem "Expressed as a **fraction in its simplest form**, the reciprocal of $-7.8$ is{{field-1}}." :question/worked-solution "We first convert the decimal to a fraction. By doing this, we get\n\n$$\n-7.8=-\\frac{78}{10}=-\\frac{39}{5}.\n$$\n\nNow, we flip the numerator and denominator, keeping the negative sign. So the reciprocal of $-7.8$ is $-\\frac{5}{39}.$"}] [{:db/id #edb/ref 17592186479135 :knowledge-point/_questions [{:db/id #edb/ref 17592186133958 :knowledge-point/id #uuid "10b6f888-d49e-5ddf-be39-e26d7f82c110" :knowledge-point/title "Finding the Reciprocal of an Integer"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "325944bc-97bb-5227-be7e-060399a69c30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{13}" :db/id #edb/ref 17592186478636} {:answer/id #uuid "8c5bb816-ce47-5bbb-a441-153569463e41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{2}" :db/id #edb/ref 17592186478783} {:answer/id #uuid "bb55160b-32f0-539f-8172-780af82eec74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{13}" :db/id #edb/ref 17592186478862} {:answer/id #uuid "e2e8c824-d0ea-5973-8915-13e80b3614d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{26}" :db/id #edb/ref 17592186478912} {:answer/id #uuid "f81630e6-10c0-55bc-8ea8-88ec783ecc6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 1759