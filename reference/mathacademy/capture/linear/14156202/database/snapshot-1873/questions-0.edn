nswer/value "-\\frac{8}{85}" :db/id #edb/ref 17592186478893} {:answer/id #uuid "d93b9067-cb4b-5e35-836d-d52f39ef7a38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18}{5}" :db/id #edb/ref 17592186478902}] :answer-field/correct {:answer/id #uuid "d0b5dd53-7ff1-5875-97af-ce171d0a2e39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{85}" :db/id #edb/ref 17592186478889} :answer-field/id #uuid "7084abcd-1786-50ea-abb5-04f3da896109" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479002}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "657c51ff-9f17-50fc-8c5e-6121474d9102" :question/math-academy-id "q-99738" :question/problem "What is the reciprocal of $10\\,\\frac{5}{8}?$" :question/worked-solution "First, we write the number as a regular fraction:\n\n$$\n10\\,\\frac{5}{8}=\\frac{10\\cdot 8+5}{8}=\\frac{85}{8}\n$$\n\nThen, we flip the numerator and denominator, keeping the sign of the fraction. So the reciprocal of $10\\,\\frac{5}{8}$ is $\\frac{8}{85}.$"}] [{:db/id #edb/ref 17592186479086 :knowledge-point/_questions [{:db/id #edb/ref 17592186133961 :knowledge-point/id #uuid "65e46d22-ed28-5950-8672-7926f9ceef50" :knowledge-point/title "Finding the Reciprocal of a Decimal"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1650a834-fc87-5021-b8bf-062eb30d1dc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186478589} {:answer/id #uuid "19782674-e6b3-57a2-ae3e-8c71b8f55bdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186478597} {:answer/id #uuid "8a753aba-cf51-5d44-a250-a965d4985f4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{15}" :db/id #edb/ref 17592186478776} {:answer/id #uuid "edbe65dc-9c8a-5d95-8a59-e3b79418e861" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{15}" :db/id #edb/ref 17592186478929} {:answer/id #uuid "f030bd91-951d-54bd-81eb-7437b4fdae44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186478933}] :answer-field/correct {:answer/id #uuid "edbe65dc-9c8a-5d95-8a59-e3b79418e861" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{15}" :db/id #edb/ref 17592186478929} :answer-field/id #uuid "9c291585-3958-5d0e-a07d-aef87471a966" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479020}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4dd2325a-9268-5f8d-bfb0-40e4777f32e3" :question/math-academy-id "q-99743" :question/problem "What is the reciprocal of $7.5?$" :question/worked-solution "We first convert the decimal to a fraction. By doing this, we get\n\n$$\n7.5=\\frac{75}{10}=\\frac{15}{2}.\n$$\n\nNow, we flip the numerator and denominator. So the reciprocal of $7.5$ is $\\frac{2}{15}.$"}]}
