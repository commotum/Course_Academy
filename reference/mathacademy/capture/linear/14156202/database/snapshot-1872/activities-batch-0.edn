#{[{:activity/first-step {:db/id #edb/ref 17592186134980} :activity/id #uuid "ac987a0f-7119-50c7-9103-b67c3da2d247" :activity/scope {:db/id #edb/ref 17592186050749 :topic/id #uuid "637f4c0b-d733-5c82-bade-e519d631ab5d" :topic/math-academy-id 2202} :activity/steps [{:db/id #edb/ref 17592186134980 :step/content {:db/id #edb/ref 17592186135172 :tutorial/content "The **reciprocal** of a number is equal to ${\\color{red}{1}}$ divided by the number. For example:\n\n- the reciprocal of ${\\color{blue}{2}}$ is equal to ${\\color{red}{1}} \\div {\\color{blue}{2}} = \\dfrac{1}{2}$\n- the reciprocal of ${\\color{blue}{3}}$ is equal to ${\\color{red}{1}} \\div {\\color{blue}{3}} = \\dfrac{1}{3}$\n- the reciprocal of $-{\\color{blue}{7}}$ is equal to ${\\color{red}{1}} \\div ({\\color{blue}{-7}}) = -\\dfrac{1}{7}$\n\nThe reciprocal of ${\\color{blue}{1}}$ is equal to\n\n$$\n{\\color{red}{1}} \\div {\\color{blue}{1}} = 1\n$$\n\nSo the number $1$ is equal to its reciprocal. The same is true for $-1$.\n\nThe reciprocal of a number always has the same sign as the original number.\n\n- If the number is positive, its reciprocal will be positive, while\n- if the number is negative, its reciprocal is also negative." :tutorial/id #uuid "bcbb31e1-711c-5521-b35a-8fe1e56f4b95" :tutorial/math-academy-id 8017 :tutorial/title "Introduction"} :step/id #uuid "3ab9edfc-72ab-545f-8656-eba90ad9fb84" :step/math-academy-id 75671 :step/next {:db/id #edb/ref 17592186134981}} {:db/id #edb/ref 17592186134981 :step/content {:db/id #edb/ref 17592186133958 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133496 :question/id #uuid "fc3055a3-5118-5a5b-8150-caadbfdae02b" :question/math-academy-id "e-12788"} :knowledge-point/id #uuid "10b6f888-d49e-5ddf-be39-e26d7f82c110" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049356} {:db/id #edb/ref 17592186050719}] :knowledge-point/questions [{:db/id #edb/ref 17592186134142} {:db/id #edb/ref 17592186134410}] :knowledge-point/title "Finding the Reciprocal of an Integer"} :step/id #uuid "6aa31b08-55ed-541a-a90c-f77bb28f32b0" :step/math-academy-id 75672 :step/next {:db/id #edb/ref 17592186134982}} {:db/id #edb/ref 17592186134982 :step/content {:db/id #edb/ref 17592186135173 :tutorial/content "We find the reciprocal of a fraction by flipping its numerator and denominator, keeping the sign of the fraction. For example:\n\n- the reciprocal of $\\dfrac {\\color{red}{1}}{\\color{blue}{2}}$ is $\\dfrac{{\\color{blue}{2}}}{{\\color{red}{1}}} = 2$\n- the reciprocal of $-\\dfrac {\\color{red}{1}}{\\color{blue}{7}}$ is $-\\dfrac{{\\color{blue}{7}}}{{\\color{red}{1}}} = -7$\n- the reciprocal of $\\dfrac {\\color{red}{2}} {\\color{blue}{5}}$ is $\\dfrac{{\\color{blue}{5}}}{\\color{red}{2}}$\n- the reciprocal of $-\\dfrac {\\color{red}{4}} {\\color{blue}{9}}$ is $-\\dfrac{{\\color{blue}{9}}}{\\color{red}{4}}$" :tutorial/id #uuid "86dec423-8754-593a-b078-6da2c0c843bf" :tutorial/math-academy-id 8018 :tutorial/title "The Reciprocal of a Fraction"} :step/id #uuid "fe562915-5ab2-5452-99c2-e769a0f22843" :step/math-academy-id 75676 :step/next {:db/id #edb/ref 17592186134983}} {:db/id #edb/ref 17592186134983 :step/content {:db/id #edb/ref 17592186133959 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133497 :question/id #uuid "2132b7c8-2d11-51c8-a1e3-06bb59c08f84" :question/math-academy-id "e-12789"} :knowledge-point/id #uuid "b955f390-c260-5f97-8e5c-62b8eb67242e" :knowledge-point/questions [{:db/id #edb/ref 17592186134409} {:db/id #edb/ref 17592186134413}] :knowledge-point/title "Finding the Reciprocal of a Fraction"} :step/id #uuid "7cea4067-d1d9-59cd-a968-027e35a7be04" :step/math-academy-id 75677 :step/next {:db/id #edb/ref 17592186134984}} {:db/id #edb/ref 17592186134984 :step/content {:db/id #edb/ref 17592186133960 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133498 :question/id #uuid "e757528d-e87f-5739-85d4-0b35267db955" :question/math-academy-id "e-12790"} :knowledge-point/id #uuid "7e422f35-9db3-5969-b72e-ea8bf681da91" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049316}] :knowledge-point/questions [{:db/id #edb/ref 17592186134417} {:db/id #edb/ref 17592186134419}] :knowledge-point/title "Finding the Reciprocal of a Mixed Number"} :step/id #uuid "cf39ddce-006f-58d7-ab25-8f57d898dfa7" :step/math-academy-id 75681 :step/next {:db/id #edb/ref 17592186134985}} {:db/id #edb/ref 17592186134985 :step/content {:db/id #edb/ref 17592186133961 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133499 :question/id #uuid "7c2a7d91-c840-5f6a-8e9d-d17673e8cb70" :question/math-academy-id "e-12791"} :knowledge-point/id #uuid "65e46d22-ed28-5950-8672-7926f9ceef50" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050724}] :knowledge-point/questions [{:db/id #edb/ref 17592186134418} {:db/id #edb/ref 17592186134497}] :knowledge-point/title "Finding the Reciprocal of a Decimal"} :step/id #uuid "4eb49f49-a993-5e8b-b29e-6a2cde35472e" :step/math-academy-id 75684 :step/next {:db/id #edb/ref 17592186134986}} {:db/id #edb/ref 17592186134986 :step/content {:db/id #edb/ref 17592186135174 :tutorial/content "The product of a number and its reciprocal is *always* equal to $1$.\n\nFor instance, the reciprocal of $2$ is\n\n$$\n\\dfrac{1}{2}\n$$\n\nIf we multiply these two numbers together, we get\n\n$$\n2 \\cdot \\dfrac{1}{2} = \\dfrac{2\\cdot 1}{2} = \\dfrac{2}{2} = 1\n$$\n\nSimilarly, the product of $-10$ and its reciprocal\n\n$$\n-\\dfrac{1}{10}\n$$\n\nis\n\n$$\n(-10) \\cdot \\left(-\\dfrac{1}{10}\\right) = \\dfrac{10\\cdot 1}{10} = \\dfrac{10}{10} = 1\n$$\n\nIn this case, we had a negative multiplied by a negative, which gave a positive." :tutorial/id #uuid "edd57a89-fc66-5955-9185-5c5134714805" :tutorial/math-academy-id 8019 :tutorial/title "The Product of a Number and Its Reciprocal"} :step/id #uuid "cb341253-5241-5eab-ad40-87b4efbc4915" :step/math-academy-id 75688}] :activity/title "Reciprocals of Rational Numbers" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186134043}]}
