#{[{:db/id #edb/ref 17592186133496 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133958 :knowledge-point/id #uuid "10b6f888-d49e-5ddf-be39-e26d7f82c110" :knowledge-point/title "Finding the Reciprocal of an Integer"}] :question/id #uuid "fc3055a3-5118-5a5b-8150-caadbfdae02b" :question/math-academy-id "e-12788" :question/problem "What is the reciprocal of $-21$?" :question/worked-solution "To find the reciprocal of $-21$, we divide $1$ by $-21$. So, we obtain\n\n$$\n1 \\div (-21) = -\\dfrac{1}{21}\n$$"}] [{:db/id #edb/ref 17592186133497 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133959 :knowledge-point/id #uuid "b955f390-c260-5f97-8e5c-62b8eb67242e" :knowledge-point/title "Finding the Reciprocal of a Fraction"}] :question/id #uuid "2132b7c8-2d11-51c8-a1e3-06bb59c08f84" :question/math-academy-id "e-12789" :question/problem "Find the reciprocal of $\\dfrac{1}{10}$." :question/worked-solution "We flip the numerator and the denominator. So, the reciprocal of\n\n$$\n\\dfrac{1}{10}\n$$\n\nis\n\n$$\n\\dfrac{10}{1} = 10\n$$"}] [{:db/id #edb/ref 17592186133498 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133960 :knowledge-point/id #uuid "7e422f35-9db3-5969-b72e-ea8bf681da91" :knowledge-point/title "Finding the Reciprocal of a Mixed Number"}] :question/id #uuid "e757528d-e87f-5739-85d4-0b35267db955" :question/math-academy-id "e-12790" :question/problem "Calculate the reciprocal of $-2\\,\\dfrac{1}{3}$." :question/worked-solution "First, we write the mixed number as an improper fraction:\n\n$$\n-2\\,\\dfrac{1}{3}=-\\dfrac{2\\cdot 3+1}{3}=-\\dfrac{7}{3}\n$$\n\nThen, we flip the numerator and the denominator, keeping the negative sign. Therefore, the reciprocal of\n\n$$\n-2\\,\\dfrac{1}{3}\n$$\n\nis\n\n$$\n-\\dfrac{3}{7}\n$$"}] [{:db/id #edb/ref 17592186133499 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133961 :knowledge-point/id #uuid "65e46d22-ed28-5950-8672-7926f9ceef50" :knowledge-point/title "Finding the Reciprocal of a Decimal"}] :question/id #uuid "7c2a7d91-c840-5f6a-8e9d-d17673e8cb70" :question/math-academy-id "e-12791" :question/problem "What is the reciprocal of $0.4$?" :question/worked-solution "First, we must convert the decimal to a fraction. Doing this, we get\n\n$$\n0.4 = \\dfrac{4}{10} = \\dfrac{{\\color{blue}{2}}}{{\\color{red}{5}}}\n$$\n\nNow, we flip the fraction, as before. So the reciprocal of $0.4$ is\n\n$$\n\\dfrac{{\\color{red}{5}}}{{\\color{blue}{2}}} = 2.5\n$$"}]}
