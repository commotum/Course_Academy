ned}g(x) & =(x+1)^{2}-(x-2)^{2} \\\\ g(-3) & =(-3+1)^{2}-(-3-2)^{2} \\\\  & =(-2)^{2}-(-5)^{2} \\\\  & =4-25 \\\\  & =-21\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492852 :knowledge-point/_questions [{:db/id #edb/ref 17592186068702 :knowledge-point/id #uuid "2b5f42de-fad6-54b6-90e1-205fdbe8a456" :knowledge-point/title "Evaluating a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ea9fe05-136c-54fa-8287-468235cbdb0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186492316} {:answer/id #uuid "92ff2ec6-c1ed-57da-a105-85732944baad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186492504} {:answer/id #uuid "c4dd854f-76b8-57b7-925b-6bec0085d762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186492611} {:answer/id #uuid "c81618e6-76ad-5708-8e7c-de8c549d1cea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186492616} {:answer/id #uuid "cfb62b1a-34c6-56d6-983c-37f403386609" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186492629}] :answer-field/correct {:answer/id #uuid "c81618e6-76ad-5708-8e7c-de8c549d1cea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186492616} :answer-field/id #uuid "021d4422-18e9-573a-aea3-c035cc557e6f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492706}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3e8b84ea-82b6-5138-bf4d-e73af61fdac3" :question/math-academy-id "q-130576" :question/problem "Evaluate $f(-1,2)$ if $f(x,y)=(2x-y)(x+2y).$" :question/worked-solution "We substitute $x=-1$ and $y=2$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x,y) & =(2x-y)(x+2y) \\\\ f(-1,2) & =(2(-1)-2)((-1)+2(2)) \\\\  & =(-4)(3) \\\\  & =-12\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492831 :knowledge-point/_questions [{:db/id #edb/ref 17592186068701 :knowledge-point/id #uuid "4e5366dd-a374-5abd-bdf6-77f378f97145" :knowledge-point/title "Evaluating a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e1864d1-334e-5ed1-a854-e574404fd88a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186492368}] :answer-field/correct {:answer/id #uuid "4e1864d1-334e-5ed1-a854-e574404fd88a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186492368} :answer-field/id #uuid "40e76a0e-856c-5852-affb-986c061df288" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186492730}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "135b40fb-5cf8-57bf-b723-676d052a026d" :question/math-academy-id "q-214832" :question/problem "If $f(x)={x}^{2}-{4}^{x-2},$ then $f(4)=${{field-1}}." :question/worked-solution "We substitute $x=4$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x) & ={x}^{2}-{4}^{x-2} \\\\ f(4) & ={4}^{2}-{4}^{4-2} \\\\  & =16-{4}^{2} \\\\  & =16-16 \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492901 :knowledge-point/_questions [{:db/id #edb/ref 17592186068701 :knowledge-point/id #uuid "4e5366dd-a374-5abd-bdf6-77f378f97145" :knowledge-point/title "Evaluating a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04609b43-5111-5208-b18d-1c6e7b99af15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g(-1)=-