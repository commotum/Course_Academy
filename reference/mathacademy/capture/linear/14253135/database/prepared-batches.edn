question/validate]} {:db/id "answer-field-c2a0708b-7945-5f75-9a00-102eed748cf7" :answer-field/id #uuid "c2a0708b-7945-5f75-9a00-102eed748cf7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1abec0a2-2985-570c-8695-2ecc24490eae" :answer-field/choices ["answer-d5368701-435d-548a-b26c-6ef9378f764b" "answer-ec947263-d207-537c-af6f-5d7e2280bc12" "answer-409f1dba-79fc-5670-8867-00333b8ccb07" "answer-b342b964-b316-5883-8132-7e7da0da3481" "answer-1abec0a2-2985-570c-8695-2ecc24490eae"] :db/ensure [:answer-field/validate]} {:db/id "answer-d5368701-435d-548a-b26c-6ef9378f764b" :answer/id #uuid "d5368701-435d-548a-b26c-6ef9378f764b" :answer/type :answer.type/math :answer/value "-\\infty" :db/ensure [:answer/validate]} {:db/id "answer-ec947263-d207-537c-af6f-5d7e2280bc12" :answer/id #uuid "ec947263-d207-537c-af6f-5d7e2280bc12" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-409f1dba-79fc-5670-8867-00333b8ccb07" :answer/id #uuid "409f1dba-79fc-5670-8867-00333b8ccb07" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-b342b964-b316-5883-8132-7e7da0da3481" :answer/id #uuid "b342b964-b316-5883-8132-7e7da0da3481" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "answer-1abec0a2-2985-570c-8695-2ecc24490eae" :answer/id #uuid "1abec0a2-2985-570c-8695-2ecc24490eae" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "question-3eaa5b30-a278-5d74-aa62-f0c0942c6bee" :question/id #uuid "3eaa5b30-a278-5d74-aa62-f0c0942c6bee" :question/math-academy-id "q-303004" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to -\\infty }\\sqrt{-(x+7)}=$\n{{field-1}}" :question/worked-solution "Let $f(x)=\\sqrt{-(x+7)}.$ Let's sketch the graph of $y=f(x):$\n\n![](images/fc/fcd2e8fce7bacf19fc5dd4f65dbee568293ed7ee54f7c4542fdb65d85aaba7d8.png)\n\nFrom the graph, we see that the function increases without bound as $x$ decreases. Therefore,\n\n$$\n{lim}_{x\\to -\\infty }f(x)=\\infty .\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-89f6d33c-6d77-579b-97c7-a321f8bf3483"] :db/ensure [:question/validate]} {:db/id "answer-field-89f6d33c-6d77-579b-97c7-a321f8bf3483" :answer-field/id #uuid "89f6d33c-6d77-579b-97c7-a321f8bf3483" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-57936fa8-32dd-5da0-9b2e-b9e751f9ea27" :answer-field/choices ["answer-57936fa8-32dd-5da0-9b2e-b9e751f9ea27"] :db/ensure [:answer-field/validate]} {:db/id "answer-57936fa8-32dd-5da0-9b2e-b9e751f9ea27" :answer/id #uuid "57936fa8-32dd-5da0-9b2e-b9e751f9ea27" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id 17592186129260 :knowledge-point/questions ["question-6ddd96c4-07f2-5b15-8bd6-7a9ad63bd667" "question-e2036c5e-2390-5572-8e7b-4c6870ad7092"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6ddd96c4-07f2-5b15-8bd6-7a9ad63bd667" :question/id #uuid "6ddd96c4-07f2-5b15-8bd6-7a9ad63bd667" :question/math-academy-id "q-337883" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to -3}\\sqrt[3]{7x-6}=$\n{{field-1}}" :question/worked-solution "We substitute $x=-3$ into the expression, and get\n\n$$\n\\begin{aligned}{lim}_{x\\to -3}\\sqrt[3]{7x-6} & =\\sqrt[3]{7(-3)-6} \\\\  & =\\sqrt[3]{-27} \\\\  & =-3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a0a68138-90e9-5068-a45f-1618bd9b7a35"] :db/ensure [:question/validate]} {:db/id "answer-field-a0a68138-90e9-5068-a45f-1618bd9b7a35" :answer-field/id #uuid "a0a68138-90e9-5068-a45f-1618bd9b7a35" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a9f9beaf-1f3f-5ecb-b382-c70b7e9d4750" :answer-field/choices ["answer-a9f9beaf-1f3f-5ecb-b382-c70b7e9d4750"] :db/ensure [:answer-field/validate]} {:db/id "answer-a9f9beaf-1f3f-5ecb-b382-c70b7e9d4750" :answer/id #uuid "a9f9beaf-1f3f-5ecb-b382-c70b7e9d4750" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "question-e2036c5e-2390-5572-8e7b-4c6870ad7092" :question/id #uuid "e2036c5e-2390-5572-8e7b-4c6870ad7092" :question/math-academy-id "q-47030" :question/problem "Calculate ${lim}_{x\\to (-3)}\\sqrt[3]{3x+9}.$" :question/worked-solution "We substitute $x=-3$ into the expression, and get\n\n$$\n\\begin{aligned}{lim}_{x\\to (-3)}\\sqrt[3]{3x+9} & =\\sqrt[3]{3(-3)+9} \\\\  & =\\sqrt[3]{0} \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ffd166d5-4d21-5931-892a-8c7a62e2391f"] :db/ensure [:question/validate]} {:db/id "answer-field-ffd166d5-4d21-5931-892a-8c7a62e2391f" :answer-field/id #uuid "ffd166d5-4d21-5931-892a-8c7a62e2391f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-afeeae55-0de4-520e-8a33-1a73f89436a3" :answer-field/choices ["answer-afeeae55-0de4-520e-8a33-1a73f89436a3" "answer-ed910bcb-c45c-590f-96de-77266658fafe" "answer-f5718a2a-5072-5b1f-968f-fb515cabbbec" "answer-5ea5e906-b90b-5b73-ba18-97c53de970e5" "answer-03491c58-45d4-593a-8833-c523eef6f713"] :db/ensure [:answer-field/validate]} {:db/id "answer-afeeae55-0de4-520e-8a33-1a73f89436a3" :answer/id #uuid "afeeae55-0de4-520e-8a33-1a73f89436a3" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-ed910bcb-c45c-590f-96de-77266658fafe" :answer/id #uuid "ed910bcb-c45c-590f-96de-77266658fafe" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-f5718a2a-5072-5b1f-968f-fb515cabbbec" :answer/id #uuid "f5718a2a-5072-5b1f-968f-fb515cabbbec" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "answer-5ea5e906-b90b-5b73-ba18-97c53de970e5" :answer/id #uuid "5ea5e906-b90b-5b73-ba18-97c53de970e5" :answer/type :answer.type/math :answer/value "\\sqrt[3]{9}" :db/ensure [:answer/validate]} {:db/id "answer-03491c58-45d4-593a-8833-c523eef6f713" :answer/id #uuid "03491c58-45d4-593a-8833-c523eef6f713" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id 17592186129195 :knowledge-point/questions ["question-887153cd-9896-52b0-b927-cb3be4108046" "question-fc34fb90-8995-5075-866b-ef20040dee62"] :db/ensure [:knowledge-point/validate]} {:db/id "question-887153cd-9896-52b0-b927-cb3be4108046" :question/id #uuid "887153cd-9896-52b0-b927-cb3be4108046" :question/math-academy-id "q-337904" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\infty }\\,\\sqrt[3]{-6-3x}=$\n{{field-1}}" :question/worked-solution "Let $f(x)=\\sqrt[3]{-6-3x}.$ Let's sketch the graph of $y=f(x):$\n\n![](images/48/481fd6651401a37e221648026506b508f3ba9984a0637c2f2219c52a5f561b23.png)\n\nFrom the graph, we see that the function decreases without bound as $x$ increases. Therefore,\n\n$$\n{lim}_{x\\to \\infty }f(x)=-\\infty .\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c2188212-e382-544c-835c-9192c8bf0f9a"] :db/ensure [:question/validate]} {:db/id "answer-field-c2188212-e382-544c-835c-9192c8bf0f9a" :answer-field/id #uuid "c2188212-e382-544c-835c-9192c8bf0f9a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-61606271-882c-55fa-afae-9c47c12185ca" :answer-field/choices ["answer-61606271-882c-55fa-afae-9c47c12185ca"] :db/ensure [:answer-field/validate]} {:db/id "answer-61606271-882c-55fa-afae-9c47c12185ca" :answer/id #uuid "61606271-882c-55fa-afae-9c47c12185ca" :answer/type :answer.type/math :answer/value "-\\infty" :db/ensure [:answer/validate]} {:db/id "question-fc34fb90-8995-5075-866b-ef20040dee62" :question/id #uuid "fc34fb90-8995-5075-866b-ef20040dee62" :question/math-academy-id "q-99792" :question/problem "${lim}_{x\\to -\\infty }\\,\\sqrt[3]{7-3x}=$" :question/worked-solution "Let $f(x)=\\sqrt[3]{7-3x}.$ Let's sketch the graph of $y=f(x):$\n\n![](images/5e/5e1d8114757e72cefa7c861cef054545a4adf4868bbb9e602683dc4b960bb428.png)\n\nFrom the graph, we see that the function increases without bound as $x$ decreases. Therefore,\n\n$$\n{lim}_{x\\to -\\infty }f(x)=\\infty .\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4909d287-3318-53e5-9ea2-409a7c8fe123"] :db/ensure [:question/validate]} {:db/id "answer-field-4909d287-3318-53e5-9ea2-409a7c8fe123" :answer-field/id #uuid "4909d287-3318-53e5-9ea2-409a7c8fe123" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9d4e1826-2dbf-53ab-aee2-bbfdeb3889a5" :answer-field/choices ["answer-d5db5f04-aa9c-58d3-9a00-7c4085e976a3" "answer-306bbf6d-7b89-5eb8-ab32-f4ee513fe024" "answer-6ec3b1c2-40c7-51fd-ac13-e624c8f2870a" "answer-9d4e1826-2dbf-53ab-aee2-bbfdeb3889a5" "answer-047ce78e-011e-5d8d-880e-3f85520cc9e0"] :db/ensure [:answer-field/validate]} {:db/id "answer-d5db5f04-aa9c-58d3-9a00-7c4085e976a3" :answer/id #uuid "d5db5f04-aa9c-58d3-9a00-7c4085e976a3" :answer/type :answer.type/math :answer/value "-\\frac{7}{3}" :db/ensure [:answer/validate]} {:db/id "answer-306bbf6d-7b89-5eb8-ab32-f4ee513fe024" :answer/id #uuid "306bbf6d-7b89-5eb8-ab32-f4ee513fe024" :answer/type :answer.type/math :answer/value "-\\infty" :db/ensure [:answer/validate]} {:db/id "answer-6ec3b1c2-40c7-51fd-ac13-e624c8f2870a" :answer/id #uuid "6ec3b1c2-40c7-51fd-ac13-e624c8f2870a" :answer/type :answer.type/math :answer/value "\\frac{7}{3}" :db/ensure [:answer/validate]} {:db/id "answer-9d4e1826-2dbf-53ab-aee2-bbfdeb3889a5" :answer/id #uuid "9d4e1826-2dbf-53ab-aee2-bbfdeb3889a5" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "answer-047ce78e-011e-5d8d-880e-3f85520cc9e0" :answer/id #uuid "047ce78e-011e-5d8d-880e-3f85520cc9e0" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id 17592186130324 :tutorial/content "Consider the graph of $y=\\sqrt{x}$ below. We will use this graph to compute $\\lim\\limits_{x \\to \\, 4} \\sqrt{x} \\, .$\n\n![](images/e6/e6423b96ce60348e780ffd437207bdbeb456e3aae2888d7525f8c4e680f4ee43.png)\n\nFrom the graph, we see that as $x$ approaches $4,$ the value of $y$ approaches $\\sqrt{4}.$ Therefore,\n\n$$\n\\lim\\limits_{x\\to 4} \\sqrt{x} = \\sqrt{4} = 2.\n$$\n\nThe limit of the square root function at a point is equal to the value of the square root function at that point, and this is true for any point *that is greater than $0.$* However, for points that are less than or equal to $0,$ the limit does not exist:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,c}\\sqrt{x}=\\{\\begin{aligned}\\sqrt{c} & \\text{ if }c>0 \\\\ \\text{DNE} & \\text{ if }c\\le 0\\end{aligned}\\end{aligned}\n$$\n\nWhy doesn't the limit exist for $c \\leq 0$?\n\n- For $c < 0,$ the limit $\\lim\\limits_{x \\to \\, c} \\sqrt{x}$ does not exist because the square root function $f(x) = \\sqrt{x}$ is not defined for negative inputs.\n\n- Although $\\sqrt{x}$ is defined at $x=0,$ the left limit $\\lim\\limits_{x \\to \\, 0^-} \\sqrt{x}$ does not exist because $\\sqrt{x}$ is undefined left of $x=0.$ Consequently, the overall limit $\\lim\\limits_{x \\to \\, 0} \\sqrt{x}$ does not exist either." :db/ensure [:tutorial/validate]} {:db/id 17592186130325 :tutorial/content "Let's go back to our plot of $y=\\sqrt x$ and work out its limits at infinity.\n\n![](images/a0/a04b7cbc735c20a866b1d22287e2f3a1ffc247931c2de08c545cbd2fe922397b.png)\n\nAs $x \\to \\infty,$ the square root function increases without bound. So, we have\n\n$$\n\\lim_{x\\to \\infty}\\sqrt{x} = \\infty.\n$$\n\nOn the other hand, when computing the limit as $x \\to -\\infty,$ remember that the square root function isn't defined for $x<0.$ Therefore,\n\n$$\n\\lim_{x\\to -\\infty}\\sqrt{x} = \\textrm{DNE}.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186130326 :tutorial/content "Consider the graph of the cube root function $y=\\sqrt[3]{x}$ below.\n\n![](images/20/20deb13b6bce6608c84db84472e19ade1d073c9562f4c414ebee36f4f9e9aebc.png)\n\nUnlike the square root function, the cube root is defined for all real $x.$ As $x$ approaches any finite number $a,$ the limit of the cube root function can be obtained by simply substituting $x=a$ into the cube root:\n\n$$\n\\lim_{x\\to a} \\sqrt[3]{x} = \\sqrt[3]{a}\n$$\n\nAdditionally, we can see from the graph that the limits at infinity are\n\n$$\n\\lim_{x\\to \\infty} \\sqrt[3]{x} = \\infty \\qquad \\textrm{and}\\qquad \\lim_{x\\to -\\infty} \\sqrt[3]{x} = -\\infty.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186129334 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}] "assertions" [["question-d819e52a-c888-5641-90f2-d3ac6277e69f" :question/id #uuid "d819e52a-c888-5641-90f2-d3ac6277e69f"] ["question-d819e52a-c888-5641-90f2-d3ac6277e69f" :question/math-academy-id "q-337856"] ["question-d819e52a-c888-5641-90f2-d3ac6277e69f" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to 2}\\sqrt{12{x}^{2}+1}=$\n{{field-1}}"] ["question-d819e52a-c888-5641-90f2-d3ac6277e69f" :question/worked-solution "The function $\\sqrt{12{x}^{2}+1}$ is well defined for $x\\in (-\\infty ,\\infty ),$ and so to find this limit we substitute $x=2$ into the above expression:\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\sqrt{12{x}^{2}+1} & =\\sqrt{12\\cdot {2}^{2}+1} \\\\  & =\\sqrt{49} \\\\  & =7\\end{aligned}\n$$"] ["question-d819e52a-c888-5641-90f2-d3ac6277e69f" :question/difficulty :question.difficulty/easy] ["answer-field-94bf7dd6-1930-5377-b560-90079795f29f" :answer-field/id #uuid "94bf7dd6-1930-5377-b560-90079795f29f"] ["answer-e46ec9d6-8f02-5d8f-9894-f1b79717a007" :answer/id #uuid "e46ec9d6-8f02-5d8f-9894-f1b79717a007"] ["answer-e46ec9d6-8f02-5d8f-9894-f1b79717a007" :answer/type :answer.type/math] ["answer-e46ec9d6-8f02-5d8f-9894-f1b79717a007" :answer/value "7"] ["answer-field-94bf7dd6-1930-5377-b560-90079795f29f" :answer-field/key "field-1"] ["answer-field-94bf7dd6-1930-5377-b560-90079795f29f" :answer-field/type :answer-field.type/blank] ["answer-field-94bf7dd6-1930-5377-b560-90079795f29f" :answer-field/correct "answer-e46ec9d6-8f02-5d8f-9894-f1b79717a007"] ["answer-field-94bf7dd6-1930-5377-b560-90079795f29f" :answer-field/choices "answer-e46ec9d6-8f02-5d8f-9894-f1b79717a007"] ["question-d819e52a-c888-5641-90f2-d3ac6277e69f" :question/answer-fields "answer-field-94bf7dd6-1930-5377-b560-90079795f29f"] [17592186129256 :knowledge-point/questions "question-d819e52a-c888-5641-90f2-d3ac6277e69f"] [17592186129723 :question/difficulty :question.difficulty/hard] ["question-3c654afa-cc01-5e40-b594-f3f8e260bef1" :question/id #uuid "3c654afa-cc01-5e40-b594-f3f8e260bef1"] ["question-3c654afa-cc01-5e40-b594-f3f8e260bef1" :question/math-academy-id "q-337878"] ["question-3c654afa-cc01-5e40-b594-f3f8e260bef1" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to -\\infty }\\sqrt{-3x+8}=$\n{{field-1}}"] ["question-3c654afa-cc01-5e40-b594-f3f8e260bef1" :question/worked-solution "Let $f(x)=\\sqrt{-3x+8}.$ Let's sketch the graph of $y=f(x):$\n\n![](images/26/267253d5390727373450d700edb503e595a8e8fe2bedda6ac93597a1dc9b3e9b.png)\n\nFrom the graph, we see that the function increases without bound as $x$ decreases. Therefore,\n\n$$\n{lim}_{x\\to -\\infty }f(x)=\\infty .\n$$"] ["question-3c654afa-cc01-5e40-b594-f3f8e260bef1" :question/difficulty :question.difficulty/moderate] ["answer-field-c33021e9-8a52-56da-aff9-d35ed874340f" :answer-field/id #uuid "c33021e9-8a52-56da-aff9-d35ed874340f"] ["answer-d3bde7cc-0467-5c03-b0da-3d4d975316c6" :answer/id #uuid "d3bde7cc-0467-5c03-b0da-3d4d975316c6"] ["answer-d3bde7cc-0467-5c03-b0da-3d4d975316c6" :answer/type :answer.type/math] ["answer-d3bde7cc-0467-5c03-b0da-3d4d975316c6" :answer/value "\\infty"] ["answer-field-c33021e9-8a52-56da-aff9-d35ed874340f" :answer-field/key "field-1"] ["answer-field-c33021e9-8a52-56da-aff9-d35ed874340f" :answer-field/type :answer-field.type/blank] ["answer-field-c33021e9-8a52-56da-aff9-d35ed874340f" :answer-field/correct "answer-d3bde7cc-0467-5c03-b0da-3d4d975316c6"] ["answer-field-c33021e9-8a52-56da-aff9-d35ed874340f" :answer-field/choices "answer-d3bde7cc-0467-5c03-b0da-3d4d975316c6"] ["question-3c654afa-cc01-5e40-b594-f3f8e260bef1" :question/answer-fields "answer-field-c33021e9-8a52-56da-aff9-d35ed874340f"] [17592186129258 :knowledge-point/questions "question-3c654afa-cc01-5e40-b594-f3f8e260bef1"] ["question-a670531c-23b0-5284-9480-aa6e39d68c2d" :question/id #uuid "a670531c-23b0-5284-9480-aa6e39d68c2d"] ["question-a670531c-23b0-5284-9480-aa6e39d68c2d" :question/math-academy-id "q-99718"] ["question-a670531c-23b0-5284-9480-aa6e39d68c2d" :question/problem "Find ${lim}_{x\\to \\infty }\\sqrt{5-x}.$"] ["question-a670531c-23b0-5284-9480-aa6e39d68c2d" :question/worked-solution "Let $f(x)=\\sqrt{5-x}.$ Let's sketch the graph of $y=f(x):$\n\n![](images/f2/f22f3680e9637e1630a01fe8b89c4b1f8252822908c1c2d162c88be0610c65c8.png)\n\nWe see that the function is not defined for $x>5.$ Therefore,\n\n$$\n{lim}_{x\\to \\infty }f(x)=\\text{DNE}.\n$$"] ["question-a670531c-23b0-5284-9480-aa6e39d68c2d" :question/difficulty :question.difficulty/easy] ["answer-field-6fd2b496-a9cd-5f1b-ae5d-36d6a2973893" :answer-field/id #uuid "6fd2b496-a9cd-5f1b-ae5d-36d6a2973893"] ["answer-06b65209-c998-579c-8515-164883d73dcf" :answer/id #uuid "06b65209-c998-579c-8515-164883d73dcf"] ["answer-06b65209-c998-579c-8515-164883d73dcf" :answer/type :answer.type/math] ["answer-06b65209-c998-579c-8515-164883d73dcf" :answer/value "-5"] ["answer-603e163c-20ee-546d-b512-fe429eda0ed0" :answer/id #uuid "603e163c-20ee-546d-b512-fe429eda0ed0"] ["answer-603e163c-20ee-546d-b512-fe429eda0ed0" :answer/type :answer.type/math] ["answer-603e163c-20ee-546d-b512-fe429eda0ed0" :answer/value "-\\infty"] ["answer-ac1be47f-ab5d-5e6e-9c39-2d02