[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186129256 :knowledge-point/questions ["question-d819e52a-c888-5641-90f2-d3ac6277e69f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d819e52a-c888-5641-90f2-d3ac6277e69f" :question/id #uuid "d819e52a-c888-5641-90f2-d3ac6277e69f" :question/math-academy-id "q-337856" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to 2}\\sqrt{12{x}^{2}+1}=$\n{{field-1}}" :question/worked-solution "The function $\\sqrt{12{x}^{2}+1}$ is well defined for $x\\in (-\\infty ,\\infty ),$ and so to find this limit we substitute $x=2$ into the above expression:\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\sqrt{12{x}^{2}+1} & =\\sqrt{12\\cdot {2}^{2}+1} \\\\  & =\\sqrt{49} \\\\  & =7\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-94bf7dd6-1930-5377-b560-90079795f29f"] :db/ensure [:question/validate]} {:db/id "answer-field-94bf7dd6-1930-5377-b560-90079795f29f" :answer-field/id #uuid "94bf7dd6-1930-5377-b560-90079795f29f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e46ec9d6-8f02-5d8f-9894-f1b79717a007" :answer-field/choices ["answer-e46ec9d6-8f02-5d8f-9894-f1b79717a007"] :db/ensure [:answer-field/validate]} {:db/id "answer-e46ec9d6-8f02-5d8f-9894-f1b79717a007" :answer/id #uuid "e46ec9d6-8f02-5d8f-9894-f1b79717a007" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id 17592186129723 :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186129258 :knowledge-point/questions ["question-3c654afa-cc01-5e40-b594-f3f8e260bef1" "question-a670531c-23b0-5284-9480-aa6e39d68c2d" "question-e20bccd2-46e5-525c-8c6b-9a901fe69cdc" "question-3eaa5b30-a278-5d74-aa62-f0c0942c6bee"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3c654afa-cc01-5e40-b594-f3f8e260bef1" :question/id #uuid "3c654afa-cc01-5e40-b594-f3f8e260bef1" :question/math-academy-id "q-337878" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to -\\infty }\\sqrt{-3x+8}=$\n{{field-1}}" :question/worked-solution "Let $f(x)=\\sqrt{-3x+8}.$ Let's sketch the graph of $y=f(x):$\n\n![](images/26/267253d5390727373450d700edb503e595a8e8fe2bedda6ac93597a1dc9b3e9b.png)\n\nFrom the graph, we see that the function increases without bound as $x$ decreases. Therefore,\n\n$$\n{lim}_{x\\to -\\infty }f(x)=\\infty .\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c33021e9-8a52-56da-aff9-d35ed874340f"] :db/ensure [:question/validate]} {:db/id "answer-field-c33021e9-8a52-56da-aff9-d35ed874340f" :answer-field/id #uuid "c33021e9-8a52-56da-aff9-d35ed874340f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d3bde7cc-0467-5c03-b0da-3d4d975316c6" :answer-field/choices ["answer-d3bde7cc-0467-5c03-b0da-3d4d975316c6"] :db/ensure [:answer-field/validate]} {:db/id "answer-d3bde7cc-0467-5c03-b0da-3d4d975316c6" :answer/id #uuid "d3bde7cc-0467-5c03-b0da-3d4d975316c6" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "question-a670531c-23b0-5284-9480-aa6e39d68c2d" :question/id #uuid "a670531c-23b0-5284-9480-aa6e39d68c2d" :question/math-academy-id "q-99718" :question/problem "Find ${lim}_{x\\to \\infty }\\sqrt{5-x}.$" :question/worked-solution "Let $f(x)=\\sqrt{5-x}.$ Let's sketch the graph of $y=f(x):$\n\n![](images/f2/f22f3680e9637e1630a01fe8b89c4b1f8252822908c1c2d162c88be0610c65c8.png)\n\nWe see that the function is not defined for $x>5.$ Therefore,\n\n$$\n{lim}_{x\\to \\infty }f(x)=\\text{DNE}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6fd2b496-a9cd-5f1b-ae5d-36d6a2973893"] :db/ensure [:question/validate]} {:db/id "answer-field-6fd2b496-a9cd-5f1b-ae5d-36d6a2973893" :answer-field/id #uuid "6fd2b496-a9cd-5f1b-ae5d-36d6a2973893" :answer-field/key "selection" :answer-field/type