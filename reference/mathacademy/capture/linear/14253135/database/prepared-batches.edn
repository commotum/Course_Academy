nswer-field/id #uuid "89f6d33c-6d77-579b-97c7-a321f8bf3483"] ["answer-57936fa8-32dd-5da0-9b2e-b9e751f9ea27" :answer/id #uuid "57936fa8-32dd-5da0-9b2e-b9e751f9ea27"] ["answer-57936fa8-32dd-5da0-9b2e-b9e751f9ea27" :answer/type :answer.type/math] ["answer-57936fa8-32dd-5da0-9b2e-b9e751f9ea27" :answer/value "\\infty"] ["answer-field-89f6d33c-6d77-579b-97c7-a321f8bf3483" :answer-field/key "field-1"] ["answer-field-89f6d33c-6d77-579b-97c7-a321f8bf3483" :answer-field/type :answer-field.type/blank] ["answer-field-89f6d33c-6d77-579b-97c7-a321f8bf3483" :answer-field/correct "answer-57936fa8-32dd-5da0-9b2e-b9e751f9ea27"] ["answer-field-89f6d33c-6d77-579b-97c7-a321f8bf3483" :answer-field/choices "answer-57936fa8-32dd-5da0-9b2e-b9e751f9ea27"] ["question-3eaa5b30-a278-5d74-aa62-f0c0942c6bee" :question/answer-fields "answer-field-89f6d33c-6d77-579b-97c7-a321f8bf3483"] [17592186129258 :knowledge-point/questions "question-3eaa5b30-a278-5d74-aa62-f0c0942c6bee"] ["question-6ddd96c4-07f2-5b15-8bd6-7a9ad63bd667" :question/id #uuid "6ddd96c4-07f2-5b15-8bd6-7a9ad63bd667"] ["question-6ddd96c4-07f2-5b15-8bd6-7a9ad63bd667" :question/math-academy-id "q-337883"] ["question-6ddd96c4-07f2-5b15-8bd6-7a9ad63bd667" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to -3}\\sqrt[3]{7x-6}=$\n{{field-1}}"] ["question-6ddd96c4-07f2-5b15-8bd6-7a9ad63bd667" :question/worked-solution "We substitute $x=-3$ into the expression, and get\n\n$$\n\\begin{aligned}{lim}_{x\\to -3}\\sqrt[3]{7x-6} & =\\sqrt[3]{7(-3)-6} \\\\  & =\\sqrt[3]{-27} \\\\  & =-3.\\end{aligned}\n$$"] ["question-6ddd96c4-07f2-5b15-8bd6-7a9ad63bd667" :question/difficulty :question.difficulty/easy] ["answer-field-a0a68138-90e9-5068-a45f-1618bd9b7a35" :answer-field/id #uuid "a0a68138-90e9-5068-a45f-1618bd9b7a35"] ["answer-a9f9beaf-1f3f-5ecb-b382-c70b7e9d4750" :answer/id #uuid "a9f9beaf-1f3f-5ecb-b382-c70b7e9d4750"] ["answer-a9f9beaf-1f3f-5ecb-b382-c70b7e9d4750" :answer/type :answer.type/math] ["answer-a9f9beaf-1f3f-5ecb-b382-c70b7e9d4750" :answer/value "-3"] ["answer-field-a0a68138-90e9-5068-a45f-1618bd9b7a35" :answer-field/key "field-1"] ["answer-field-a0a68138-90e9-5068-a45f-1618bd9b7a35" :answer-field/type :answer-field.type/blank] ["answer-field-a0a68138-90e9-5068-a45f-1618bd9b7a35" :answer-field/correct "answer-a9f9beaf-1f3f-5ecb-b382-c70b7e9d4750"] ["answer-field-a0a68138-90e9-5068-a45f-1618bd9b7a35" :answer-field/choices "answer-a9f9beaf-1f3f-5ecb-b382-c70b7e9d4750"] ["question-6ddd96c4-07f2-5b15-8bd6-7a9ad63bd667" :question/answer-fields "answer-field-a0a68138-90e9-5068-a45f-1618bd9b7a35"] [17592186129260 :knowledge-point/questions "question-6ddd96c4-07f2-5b15-8bd6-7a9ad63bd667"] ["question-e2036c5e-2390-5572-8e7b-4c6870ad7092" :question/id #uuid "e2036c5e-2390-5572-8e7b-4c6870ad7092"] ["question-e2036c5e-2390-5572-8e7b-4c6870ad7092" :question/math-academy-id "q-47030"] ["question-e2036c5e-2390-5572-8e7b-4c6870ad7092" :question/problem "Calculate ${lim}_{x\\to (-3)}\\sqrt[3]{3x+9}.$"] ["question-e2036c5e-2390-5572-8e7b-4c6870ad7092" :question/worked-solution "We substitute $x=-3$ into the expression, and get\n\n$$\n\\begin{aligned}{lim}_{x\\to (-3)}\\sqrt[3]{3x+9} & =\\sqrt[3]{3(-3)+9} \\\\  & =\\sqrt[3]{0} \\\\  & =0.\\end{aligned}\n$$"] ["question-e2036c5e-2390-5572-8e7b-4c6870ad7092" :question/difficulty :question.difficulty/easy] ["answer-field-ffd166d5-4d21-5931-892a-8c7a62e2391f" :answer-field/id #uuid "ffd166d5-4d21-5931-892a-8c7a62e2391f"] ["answer-afeeae55-0de4-520e-8a33-1a73f89436a3" :answer/id #uuid "afeeae55-0de4-520e-8a33-1a73f89436a3"] ["answer-afeeae55-0de4-520e-8a33-1a73f89436a3" :answer/type :answer.type/math] ["answer-afeeae55-0de4-520e-8a33-1a73f89436a3" :answer/value "0"] ["answer-ed910bcb-c45c-590f-96de-77266658fafe" :answer/id #uuid "ed910bcb-c45c-590f-96de-77266658fafe"] ["answer-ed910bcb-c45c-590f-96de-77266658fafe" :answer/type :answer.type/math] ["answer-ed910bcb-c45c-590f-96de-77266658fafe" :answer/value "3"] ["answer-f5718a2a-5072-5b1f-968f-fb515cabbbec" :an