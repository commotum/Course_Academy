066ac7-3e74-53e0-a852-3680d4d4d5ac" #edb/ref 17592186045417] [17592186485458 #edb/ref 1075 #edb/ref 17592186484845 #edb/ref 17592186045417] [17592186485458 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186485458 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186485458 #edb/ref 1078 #edb/ref 17592186484845 #edb/ref 17592186045417] [17592186485458 #edb/ref 1079 #uuid "d74ba4e3-6609-57f0-a5d9-9c0bee314a02" #edb/ref 17592186045417] [17592186485477 #edb/ref 1075 #edb/ref 17592186485342 #edb/ref 17592186045417] [17592186485477 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186485477 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186485477 #edb/ref 1078 #edb/ref 17592186485342 #edb/ref 17592186045417] [17592186485477 #edb/ref 1079 #uuid "fac530a4-31cf-5ed3-9ace-18c2b43e1fd3" #edb/ref 17592186045417] [17592186485483 #edb/ref 1088 #edb/ref 17592186048825 #edb/ref 17592186045417] [17592186485483 #edb/ref 1088 #edb/ref 17592186048924 #edb/ref 17592186045417] [17592186485483 #edb/ref 1088 #edb/ref 17592186049143 #edb/ref 17592186045417] [17592186485483 #edb/ref 1088 #edb/ref 17592186049253 #edb/ref 17592186045417] [17592186485483 #edb/ref 1088 #edb/ref 17592186049640 #edb/ref 17592186045417] [17592186485483 #edb/ref 1088 #edb/ref 17592186049752 #edb/ref 17592186045417] [17592186485483 #edb/ref 1088 #edb/ref 17592186050462 #edb/ref 17592186045417] [17592186485483 #edb/ref 1089 #edb/ref 17592186485484 #edb/ref 17592186045417] [17592186485483 #edb/ref 1090 #uuid "58780267-ebaa-5a3b-a474-b12f78c0b5b6" #edb/ref 17592186045417] [17592186485484 #edb/ref 1084 #edb/ref 17592186485599 #edb/ref 17592186045417] [17592186485484 #edb/ref 1084 #edb/ref 17592186485600 #edb/ref 17592186045417] [17592186485484 #edb/ref 1084 #edb/ref 17592186485605 #edb/ref 17592186045417] [17592186485484 #edb/ref 1084 #edb/ref 17592186485609 #edb/ref 17592186045417] [17592186485484 #edb/ref 1084 #edb/ref 17592186485612 #edb/ref 17592186045417] [17592186485484 #edb/ref 1084 #edb/ref 17592186485632 #edb/ref 17592186045417] [17592186485484 #edb/ref 1084 #edb/ref 17592186485635 #edb/ref 17592186045417] [17592186485484 #edb/ref 1085 "A school is holding a bake sale. All of the cakes and pies at the sale are of the same size." #edb/ref 17592186045417] [17592186485484 #edb/ref 1086 #uuid "8ce01573-84d9-5c59-8210-9379d68685c7" #edb/ref 17592186045417] [17592186485484 #edb/ref 1087 #edb/ref 17592186485635 #edb/ref 17592186045417] [17592186485489 #edb/ref 1068 #edb/ref 17592186485450 #edb/ref 17592186045417] [17592186485489 #edb/ref 1068 #edb/ref 17592186485458 #edb/ref 17592186045417] [17592186485489 #edb/ref 1069 "q-133807" #edb/ref 17592186045417] [17592186485489 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186485489 #edb/ref 1071 "After Ellen takes her bite of Darryl's cherry pie, Darryl's remaining cherry pie is{{field-1}}\nthan Darryl's remaining apple pie because  $1\\frac{2}{7}$\n{{field-2}} $\\frac{4}{3}.$" #edb/ref 17592186045417] [17592186485489 #edb/ref 1072 #uuid "0a57b3c9-03a4-52de-a46c-64a4643241ad" #edb/ref 17592186045417] [17592186485489 #edb/ref 1074 "Darryl has $1\\frac{2}{7}$ cherry pies and $\\frac{4}{3}$ apple pies remaining.\n\nWe cannot compare the fractions directly as they don't have a common denominator.\n\nWe can make a common denominator of $7\\times 3=21.$\n\nTo put $1\\frac{2}{7}$ over a denominator of $21,$ we first convert to an improper fraction and then multiply the numerator and denominator by $3:$\n\n$$\n1\\frac{2}{7}=\\frac{9}{7}=\\frac{9\\times 3}{7\\times 3}=\\frac{27}{21}\n$$\n\nTo put $\\frac{4}{3}$ over a denominator of $21,$ we multiply the numerator and denominator by $7:$\n\n$$\n\\frac{4}{3}=\\frac{4\\times 7}{3\\times 7}=\\frac{28}{21}\n$$\n\nWe can now compare the fractions $\\frac{27}{21}$ and $\\frac{28}{21}$ by looking at the numerators only.\n\nSince $27<28,$ the correct statement must be:\n\n$$\n\\frac{27}{21}<\\frac{28}{21}\n$$\n\nSo, the correct answer is\n\n> \"After Ellen takes her bite of Darryl's cherry pie, Darryl's remaining cherry pie is $<$ than Darryl's remaining apple pie because $1\\frac{2}{7}<\\frac{4}{3}.$\"" #edb/ref 17592186045417] [17592186485523 #edb/ref 1068 #edb/ref 17592186485434 #edb/ref 17592186045417] [17592186485523 #edb/ref 1069 "q-133804" #edb/ref 17592186045417] [17592186485523 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186485523 #edb/ref 1071 "If a total of $9$ people made all the cakes for the sale, and each person made the same number of cakes, then they each made{{field-1}}\ncakes." #edb/ref 17592186045417] [17592186485523 #edb/ref 1072 #uuid "43bd5eed-55d7-5512-b491-efa9bc5b652f" #edb/ref 17592186045417] [17592186485523 #edb/ref 1074 "We know that there are $216$ cakes in total. So, each person made $216÷9$ cakes.\n\nWe start by writing down the question using long division notation:\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" width=\"150\">\n<table align=\"left\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" bgcolor=\"#EBF5FB\" height=\"20\" width=\"20\">$9$</td>\n<td align=\"center\" colspan=\"2\" height=\"20\" width=\"15\">$\\,\\,\\enclose{longdiv}{2\\,\\phantom{|}1\\,\\phantom{|}6}$</td>\n</tr>\n</tbody></table>\n</td>\n<td align=\"left\" width=\"250\">\n<table align=\"left\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr height=\"20\">\n<td></td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n</tbody></table>\n\nNotice that $2$ (the number of hundreds in $216$) is less than the divisor $9.$ Therefore, we should consider both the hundreds and tens:\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" width=\"150\">\n<table align=\"left\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" bgcolor=\"#EBF5FB\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" bgcolor=\"#EBF5FB\" height=\"20\" width=\"15\">$2$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#EBF5FB\" height=\"20\" width=\"20\">$9$</td>\n<td align=\"center\" colspan=\"3\" height=\"20\" width=\"15\">$\\,\\,\\enclose{longdiv}{2\\,\\phantom{|}1\\,\\phantom{|}6}$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\,\\,\\,\\,\\,\\,\\,$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$8$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$↓$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$3$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$6$</td>\n</tr>\n</tbody></table>\n</td>\n<td align=\"left\" width=\"250\">\n<table align=\"left\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr height=\"20\">\n<td>Divide: $21÷9=2\\,\\text{R}\\,3$</td>\n</tr>\n<tr height=\"20\">\n<td>Write over tens: $2$</td>\n</tr>\n<tr height=\"25\">\n<td>Multiply: $9\\times 2=18$</td>\n</tr>\n<tr height=\"20\">\n<td>Subtract: $21-18=3$</td>\n</tr>\n<tr height=\"25\">\n<td>Bring down: $6$</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n</tbody></table>\n\nNext, we consider the ones:\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" width=\"150\">\n<table align=\"left\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" bgcolor=\"#EBF5FB\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" bgcolor=\"#EBF5FB\" height=\"20\" width=\"15\">$2$</td>\n<td align=\"center\" bgcolor=\"#EBF5FB\" height=\"20\" width=\"15\">$4$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#EBF5FB\" height=\"20\" width=\"20\">$9$</td>\n<td align=\"center\" colspan=\"3\" height=\"20\" width=\"15\">$\\,\\,\\enclose{longdiv}{2\\,\\phantom{|}1\\,\\phantom{|}6}$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\,\\,\\,\\,\\,\\,\\,$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$8$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$3$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$6$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\,\\,\\,\\,\\,$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$3$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$6$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\boxed{\\text{0}}$</td>\n</tr>\n</tbody></table>\n</td>\n<td align=\"left\" width=\"250\">\n<table align=\"left\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr height=\"20\">\n<td>Divide: $36÷9=4$</td>\n</tr>\n<tr height=\"20\">\n<td>Write over ones: $4$</td>\n</tr>\n<tr height=\"25\">\n<td>Multiply: $9\\times 4=36$</td>\n</tr>\n<tr height=\"20\">\n<td>Subtract: $36-36=0$</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n</tbody></table>\n\nWe get the remainder $0$, so the division is done.\n\nTherefore,\n\n$$\n216÷9=24.\n$$" #edb/ref 17592186045417] [17592186485547 #edb/ref 1068 #edb/ref 17592186485453 #edb/ref 17592186045417] [17592186485547 #edb/ref 1069 "q-133808" #edb/ref 17592186045417] [17592186485547 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186485547 #edb/ref 1071 "Darryl gives $\\frac{2}{5}$ of his apple pies to his daughter. What fraction of a whole pie does Darryl's daughter have?\n\n*Remember that Darryl bought $\\frac{4}{3}$ of an apple pie.*\n\nDarryl's daughter has\n{{field-1}}\nof a pie." #edb/ref 17592186045417] [17592186485547 #edb/ref 1072 #uuid "7d63aa21-54c3-5793-bdf0-1f7c092e61d0" #edb/ref 17592186045417] [17592186485547 #edb/ref 1074 "We know that Darryl has $\\frac{4}{3}$ of an apple pie.\n\nTo calculate the fraction of a whole pie that Darryl's daughter has, we need to multiply $\\frac{2}{5}$ by $\\frac{4}{3}.$\n\nTo multiply two fractions, we multiply the numerators and we multiply the denominators:\n\n$$\n\\frac{2}{5}\\times \\frac{4}{3}=\\frac{2\\times 4}{5\\times 3}=\\frac{8}{15}.\n$$\n\nTherefore, Darry's daughter have $\\frac{8}{15}$ of a pie." #edb/ref 17592186045417] [17592186485548 #edb/ref 1068 #edb/ref 17592186485477 #edb/ref 17592186045417] [17592186485548 #edb/ref 1069 "q-133803" #edb/ref 17592186045417] [17592186485548 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186485548 #edb/ref 1071 "At the bake sale, there are $12$ tables with $18$ cakes at each table. Therefore, there are{{field-1}}\ncakes in total." #edb/ref 17592186045417] [17592186485548 #edb/ref 1072 #uuid "7dffbb18-69db-5548-9e20-8e99e6ab3d7c" #edb/ref 17592186045417] [17592186485548 #edb/ref 1074 "To calculate the total number of cakes, we need to multiply $12$ by $18.$\n\nSo, we write it this way:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  &  &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\  &  &  &  &  & \\end{aligned}\\end{aligned}\n$$\n\nFirst, we multiply the ones:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned} \\\\ \\boxed{1}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\,\\end{aligned} & \\,\\, & \\begin{aligned}12\\times 8=96\\end{aligned}\\end{aligned}\n$$\n\nNext, we multiply the tens:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{1}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\,\\end{aligned} & \\,\\, & \\begin{aligned}12\\times 10=120\\end{aligned}\\end{aligned}\n$$\n\nFinally, we add the results:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{1}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\,\\end{aligned} & \\,\\, & \\begin{aligned}96+120=216\\end{aligned} \\\\  & \\end{aligned}\n$$\n\nTherefore, $12\\times 18=216.$\n\nTherefore, there are $216$ cakes in total." #edb/ref 17592186045417] [17592186485568 #edb/ref 1068 #edb/ref 17592186485418 #edb/ref 17592186045417] [17592186485568 #edb/ref 1069 "q-133806" #edb/ref 17592186045417] [17592186485568 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186485568 #edb/ref 1071 "Of the $2$ of Darryl's cherry pies, Ellen takes $\\frac{5}{7}$ of a pie. As a mixed number, Darryl has{{field-1}}\ncherry pies left." #edb/ref 17592186045417] [17592186485568 #edb/ref 1072 #uuid "aa1b20cc-21de-5821-9525-46da1d460229" #edb/ref 17592186045417] [17592186485568 #edb/ref 1074 "To find out how much cherry pie Darryl has left, we must calculate the difference $2-\\frac{5}{7}.$\n\nTo subtract $\\frac{5}{7}$ from $2,$ we need to express the whole number $2$ as an equivalent fraction with a denominator of $7.$\n\nFirst, we write $2$ as an improper fraction:\n\n$$\n\\frac{2}{1}\n$$\n\nThen, we put this fraction over a denominator of $7$ by multiplying the numerator and denominator by $7:$\n\n$$\n\\frac{2\\times 7}{1\\times 7}=\\frac{14}{7}\n$$\n\nSo now, we have to find:\n\n$$\n\\frac{14}{7}-\\frac{5}{7}\n$$\n\nTo subtract two fractions with like denominators, we subtract the numerators and keep the denominators the same. Therefore:\n\n$$\n\\frac{14}{7}-\\frac{5}{7}=\\frac{14-5}{7}=\\frac{9}{7}\n$$\n\nFinally, we convert to a mixed number:\n\n$$\n9÷7=1\\,\\text{R}\\,2=1\\,\\frac{2}{7}\n$$\n\nTherefore, Darryl has $1\\,\\frac{2}{7}$ cherry pies left." #edb/ref 17592186045417] [17592186485590 #edb/ref 1068 #edb/ref 17592186485389 #edb/ref 17592186045417] [17592186485590 #edb/ref 1069 "q-133802" #edb/ref 17592186045417] [17592186485590 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186485590 #edb/ref 1071 "Aaron, Beatrice, and Chetna have each baked $2$ cherry pies and $3$ apple pies for the sale. In total, they baked{{field-1}}\npies." #edb/ref 17592186045417] [17592186485590 #edb/ref 1072 #uuid "f3cfd772-56f0-5f8d-9613-e2a636e3f6c4" #edb/ref 17592186045417] [17592186485590 #edb/ref 1074 "We need to write and evaluate an expression representing the total number of pies.\n\nSince each of them baked $2$ cherry pies and $3$ apple pies, the number of pies each person made is:\n\n$$\n{{2}_{⏟}}_{\\text{cherry pies}}+{{3}_{⏟}}_{\\text{apple pies}}\n$$\n\nSince *each* person made this number of pies, and there are $3$ people, we must multiply the number of pies by $3.$ Therefore, the total number of pies is:\n\n$$\n{{(2+3)}_{⏟}}_{\\text{each person}}\\times {{3}_{⏟}}_{\\text{people}}\n$$\n\nTo evaluate the expression, we follow the order of operations with parentheses.\n\nFirst, we perform the operations inside the parentheses:\n\n$$\n\\begin{aligned}(2+3)\\times 3 & =(2+3)\\times 3 \\\\  & =5\\times 3.\\end{aligned}\n$$\n\nNow, we multiply:\n\n$$\n5\\times 3=15\n$$" #edb/ref 17592186045417] [17592186485593 #edb/ref 1068 #edb/ref 17592186485424 #edb/ref 17592186045417] [17592186485593 #edb/ref 1069 "q-133805" #edb/ref 17592186045417] [17592186485593 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186485593 #edb/ref 1071 "Darryl buys $2$ cherry pies and $\\frac{4}{3}$ of an apple pie. How much pie did Darryl buy in total? Express your final answer as a mixed number.\n\nDarryl bought\n{{field-1}}\npies." #edb/ref 17592186045417] [17592186485593 #edb/ref 1072 #uuid "fb3049fb-d3cf-5bb1-b456-516f986d2262" #edb/ref 17592186045417] [17592186485593 #edb/ref 1074 "To find out how much pie Darryl bought, we have to calculate the following sum:\n\n$$\n2+\\frac{4}{3}\n$$\n\nTo add $2$ and $\\frac{4}{3},$ we need to express the whole number $2$ as an equivalent fraction with a denominator of $3.$\n\nFirst, we write $2$ as an improper fraction:\n\n$$\n\\frac{2}{1}\n$$\n\nThen, we put this fraction over a denominator of $3$ by multiplying the numerator and denominator by $3:$\n\n$$\n\\frac{2\\times 3}{1\\times 3}=\\frac{6}{3}\n$$\n\nSo now, we have to find:\n\n$$\n\\frac{6}{3}+\\frac{4}{3}\n$$\n\nTo add two fractions with like denominators, we add the numerators and keep the denominators the same:\n\n$$\n\\frac{6}{3}+\\frac{4}{3}=\\frac{6+4}{3}=\\frac{10}{3}\n$$\n\nExpressing our answer as a mixed number, we have\n\n$$\n10÷3=3\\,\\text{R}\\,1=3\\,\\frac{1}{3}.\n$$\n\nTherefore, Darryl bought $3\\,\\frac{1}{3}$ pies." #edb/ref 17592186045417] [17592186485599 #edb/ref 1058 #edb/ref 17592186485605 #edb/ref 17592186045417] [17592186485599 #edb/ref 1062 #uuid "0b1d3568-dd0f-5ab5-a242-44cbf5280b8e" #edb/ref 17592186045417] [17592186485599 #edb/ref 1063 #edb/ref 17592186485489 #edb/ref 17592186045417] [17592186485600 #edb/ref 1058 #edb/ref 17592186485632 #edb/ref 17592186045417] [17592186485600 #edb/ref 1062 #uuid "1005f30a-98c7-5f52-8fb4-cef4933ce2c2" #edb/ref 17592186045417] [17592186485600 #edb/ref 1063 #edb/ref 17592186485593 #edb/ref 17592186045417] [17592186485605 #edb/ref 1062 #uuid "250e0ba2-ce87-595a-98ed-8e88d6aeea89" #edb/ref 17592186045417] [17592186485605 #edb/ref 1063 #edb/ref 17592186485547 #edb/ref 17592186045417] [17592186485609 #edb/ref 1058 #edb/ref 17592186485600 #edb/ref 17592186045417] [17592186485609 #edb/ref 1062 #uuid "2f76befb-0989-5b52-a5d4-98b6b22eea91" #edb/ref 17592186045417] [17592186485609 #edb/ref 1063 #edb/ref 17592186485523 #edb/ref 17592186045417] [17592186485612 #edb/ref 1058 #edb/ref 17592186485609 #edb/ref 17592186045417] [17592186485612 #edb/ref 1062 #uuid "35876edb-4371-56e7-9ef9-92bb7142e009" #edb/ref 17592186045417] [17592186485612 #edb/ref 1063 #edb/ref 17592186485548 #edb/ref 17592186045417] [17592186485632 #edb/ref 1058 #edb/ref 17592186485599 #edb/ref 17592186045417] [17592186485632 #edb/ref 1062 #uuid "bbdcb7ee-2a5b-5d81-8e13-c0609475d264" #edb/ref 17592186045417] [17592186485632 #edb/ref 1063 #edb/ref 17592186485568 #edb/ref 17592186045417] [17592186485635 #edb/ref 1058 #edb/ref 17592186485612 #edb/ref 17592186045417] [17592186485635 #edb/ref 1062 #uuid "c46447df-ee16-5021-ade6-214526310e43" #edb/ref 17592186045417] [17592186485635 #edb/ref 1063 #edb/ref 17592186485590 #edb/ref 17592186045417] [17592186485640 #edb/ref 1062 #uuid "ee8a0c98-42e4-563d-b438-f838078b0c1a" #edb/ref 17592186045417] [17592186485640 #edb/ref 1063 #edb/ref 17592186485483 #edb/ref 17592186045417] [17592186508