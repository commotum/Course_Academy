      "html": "<div id=\"question-133807\" class=\"question\">                                \n                        <div id=\"question-133807-text\" class=\"questionText\">      \n                            \n                            <!--<span style=\"font-weight: bold; margin-right: 10px;\">f.</span>-->\n\n                            <div id=\"question-133807-graphic\" class=\"questionGraphic\">\n                                \n                            </div>   \n\n\n                            After Ellen takes her bite of Darryl's cherry pie, Darryl's remaining cherry pie is\n\n                            \n                                    \n                            \n                                        <div class=\"matheditor-wrapper-answer\" style=\"min-width: 15px; margin-left: 4px; margin-right: 2px;\">\n                                             \n                                        <div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"11\"><var mathquill-command-id=\"47\">l</var><var mathquill-command-id=\"49\">e</var><var mathquill-command-id=\"51\">s</var><var mathquill-command-id=\"53\">s</var></span></div></div>                \n                                    \n                                \n                                    \n                                        \n                                        \nthan Darryl's remaining apple pie because  <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"9\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mstyle><mjx-mfrac><m