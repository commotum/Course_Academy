    "q-43919": {
      "dom_id": "step-q43919",
      "name": "Question 5",
      "problem": "$3(\\frac{a}{3}-\\frac{b}{2})=$",
      "worked_solution": "Applying the distributive law and simplifying, we have:\n\n$$\n\\begin{aligned}3(\\frac{a}{3}-\\frac{b}{2}) & = \\\\ 3\\cdot \\frac{a}{3}+3\\cdot (-\\frac{b}{2}) & = \\\\ \\frac{3a}{3}+(-\\frac{3b}{2}) & = \\\\ a-\\frac{3b}{2}\\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-43919-a",
