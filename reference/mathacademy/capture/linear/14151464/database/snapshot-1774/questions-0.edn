#{[{:db/id #edb/ref 17592186138069 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138510 :knowledge-point/id #uuid "54498b47-9a43-5b4d-8bbf-806af5968829" :knowledge-point/title "Simplifying Fractions with Like Denominators"}] :question/id #uuid "e85da1d1-1cf3-547c-86ce-42329475fbdd" :question/math-academy-id "e-12835" :question/problem "Simplify $\\dfrac{1}{3}k +1 + \\dfrac{4}{3}k - 3.$" :question/worked-solution "We collect and combine the like terms, simplifying the coefficients as much as possible.\n\n$$\n\\begin{aligned}\\frac{1}{3}k+1+\\frac{4}{3}k-3 & = \\\\ (\\frac{1}{3}k+\\frac{4}{3}k)+(1-3) & = \\\\ (\\frac{1+4}{3})k+(-2) & = \\\\ \\frac{5}{3}k-2 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186138070 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138512 :knowledge-point/id #uuid "dec4e22a-5882-56d9-8e13-b18b4d22efdc" :knowledge-point/title "Using the Distributive Law With Fractions"}] :question/id #uuid "30cf0891-33d3-566c-8286-4c161f84c1dd" :question/math-academy-id "e-12836" :question/problem "Simplify $\\dfrac{1}{2}(p-4q).$" :question/worked-solution "Applying the distributive law and simplifying, we have:\n\n$$\n\\begin{aligned}\\frac{1}{2}(p-4q) & = \\\\ (\\frac{1}{2})\\cdot p-(\\frac{1}{2})\\cdot 4q & = \\\\ \\frac{1}{2}p-\\frac{4q}{2} & = \\\\ \\frac{1}{2}p-2q & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186138071 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138511 :knowledge-point/id #uuid "75d096f5-9834-5e52-a7eb-9aae72398d19" :knowledge-point/title "Simplifying Fractions with Unlike Denominators"}] :question/id #uuid "53c1f7ca-bcaa-59e4-9929-0695b67621cb" :question/math-academy-id "e-12837" :question/problem "Simplify the expression $-\\dfrac{1}{2}u  + \\dfrac{7}{8}u.$" :question/worked-solution "We combine the like terms by adding the coefficients.\n\n$$\n\\begin{aligned}-\\frac{1}{2}u+\\frac{7}{8}u & = \\\\ (-\\frac{1}{2}+\\frac{7}{8})u & \\end{aligned}\n$$\n\nIn order to add the coefficients, we have to convert them to have the same denominator.\n\n$$\n\\begin{aligned}(-\\frac{1}{2}+\\frac{7}{8})u & = \\\\ (-\\frac{4}{8}+\\frac{7}{8})u & = \\\\ (\\frac{-4+7}{8})u & = \\\\ \\frac{3}{8}u & \\end{aligned}\n$$\n\nThus, the expression simplifies to $\\dfrac{3}{8}u.$"}] [{:db/id #edb/ref 17592186138072 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138513 :knowledge-point/id #uuid "e3e39a9d-1f97-54f2-a388-90c71c83b93e" :knowledge-point/title "Simplifying Expressions Using the Distributive Law"}] :question/id #uuid "957b3102-6eb7-52d3-9299-54ed9bd4718e" :question/math-academy-id "e-12892" :question/problem "Simplify $\\dfrac{1}{3}(3a+6b)+2a.$" :question/worked-solution "First, we apply the distributive law.\n\n$$\n\\begin{aligned}\\frac{1}{3}(3a+6b)+2a & = \\\\ (\\frac{1}{3})\\cdot 3a+(\\frac{1}{3})\\cdot 6b+2a & = \\\\ \\frac{3a}{3}+\\frac{6b}{3}+2a & = \\\\ a+2b+2a & \\end{aligned}\n$$\n\nThen, we collect and combine the like terms, simplifying the coefficients as much as possible.\n\n$$\n\\begin{aligned}a+2b+2a & = \\\\ a+2a+2b & = \\\\ 3a+2b & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186459293 :knowledge-point/_questions [{:db/id #edb/ref 17592186138511 :knowledge-point/id #uuid "75d096f5-9834-5e52-a7eb-9aae72398d19" :knowledge-point/title "Simplifying Fractions with Unlike Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01c09e5b-7e4c-5782-8384-76280dc7cfdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23x}{35}+22" :db/id #edb/ref 17592186458618} {:answer/id #uuid "01c5e166-86c7-5683-922c-c6a72cf2a69d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{22x}{35}+23" :db/id #edb/ref 17592186458619} {:answer/id #uuid "3ca191ae-ecd6-5959-8171-b55afa13cc03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{35x}{23}-22" :db/id #edb/ref 17592186458744} {:answer/id #uuid "a539b382-351d-5f45-96fd-7219ec78e7f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23x}{35}-22" :db/id #edb/ref 17592186458920} {:answer/id #uuid "c4f90038-622c-52d6-84df-3ba78748cf1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{22x}{5}+23" :db/id #edb/ref 17592186458981}] :answer-field/correct {:answer/id #uuid "01c5e166-86c7-5683-922c-c6a72cf2a69d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{22x}{35}+23" :db/id #edb/ref 17592186458619} :answer-field/id #uuid "aa284a81-c607-55d4-8e5d-f033a3ac3d07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186459158}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dc80fc0c-88ad-5f7a-b174-a89a65c11a38" :question/math-academy-id "q-100054" :question/problem "Simplify the expression $\\frac{6x}{5}+15-\\frac{4x}{7}+8.$" :question/worked-solution "We collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}\\frac{6x}{5}+15-\\frac{4x}{7}+8 & = \\\\ (\\frac{6x}{5}-\\frac{4x}{7})+(15+8) & = \\\\ (\\frac{42x}{35}-\\frac{20x}{35})+(15+8) & = \\\\ (\\frac{42x-20x}{35})+23 & = \\\\ \\frac{22x}{35}+23\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186459205 :knowledge-point/_questions [{:db/id #edb/ref 17592186138511 :knowledge-point/id #uuid "75d096f5-9834-5e52-a7eb-9aae72398d19" :knowledge-point/title "Simplifying Fractions with Unlike Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a56a8231-fa23-5f97-b089-27fbbd678426" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186458921}] :answer-field/correct {:answer/id #uuid "a56a8231-fa23-5f97-b089-27fbbd678426" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186458921} :answer-field/id #uuid "a13a9d5d-2416-5caf-aa6b-9a5345f1752d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186459153}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "00c8c3c6-017f-53bd-8aef-13e6a3aec175" :question/math-academy-id "q-171540" :question/problem "$\\frac{5}{2}q-\\frac{7}{6}q=${{field-1}}\n$q$" :question/worked-solution "We combine the like terms by subtracting the coefficients:\n\n$$\n\\begin{aligned}\\frac{5}{2}q-\\frac{7}{6}q & = \\\\ (\\frac{5}{2}-\\frac{7}{6})q\\end{aligned}\n$$\n\nIn order to subtract the coefficients, we have to convert them to have the same denominator:\n\n$$\n\\begin{aligned}(\\frac{5}{2}-\\frac{7}{6})q & = \\\\ (\\frac{15}{6}-\\frac{7}{6})q & = \\\\ (\\frac{15-7}{6})q & = \\\\ \\frac{8}{6}q & = \\\\ \\frac{4}{3}\\,q\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186459288 :knowledge-point/_questions [{:db/id #edb/ref 17592186138513 :knowledge-point/id #uuid "e3e39a9d-1f97-54f2-a388-90c71c83b93e" :knowledge-point/title "Simplifying Expressions Using the Distributive Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d14116a7-25cd-55f0-9feb-5d2b4683f446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186458991}] :answer-field/correct {:answer/id #uuid "d14116a7-25cd-55f0-9feb-5d2b4683f446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186458991} :answer-field/id #uuid "5c3af921-0dbd-532b-94fa-6556205e3ff7" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186459124} {:answer-field/choices [{:answer/id #uuid "21928bb2-a099-507a-