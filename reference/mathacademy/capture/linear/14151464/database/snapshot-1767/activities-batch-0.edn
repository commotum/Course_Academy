#{[{:activity/first-step {:db/id #edb/ref 17592186139486} :activity/id #uuid "63522699-6803-576b-82ed-8d88d13eba2f" :activity/scope {:db/id #edb/ref 17592186049047 :topic/id #uuid "d5a8629a-110d-5d05-beb7-159e81536910" :topic/math-academy-id 2244} :activity/steps [{:db/id #edb/ref 17592186139486 :step/content {:db/id #edb/ref 17592186139661 :tutorial/content "Suppose that we want to simplify the following expression:\n\n$$\n2+\\dfrac{5}{2}x -5 + \\dfrac{7}{2}x\n$$\n\nWe begin by collecting like terms.\n\n$$\n(\\frac{5}{2}x + \\frac{7}{2}x) + (2 - 5)\n$$\n\nThen, we combine the like terms, simplifying the coefficients as much as possible.\n\n$$\n\\begin{aligned}\n(\\frac{5}{2}x + \\frac{7}{2}x) + (2 - 5) &=  \\\\\n(\\frac{5 + 7}{2})x + (-3) &=  \\\\\n\\frac{12}{2}x - 3 &=  \\\\\n&= 6x - 3 \\mid\n\\end{aligned}\n$$\n\nThus, the simplified expression is $6x-3$." :tutorial/id #uuid "7ef8a0d2-a9fe-57f8-b3fc-7b69cbb3a818" :tutorial/math-academy-id 8040 :tutorial/title "Introduction"} :step/id #uuid "3cca408f-980b-5a63-a54c-03cd0d86a422" :step/math-academy-id 71207 :step/next {:db/id #edb/ref 17592186139487}} {:db/id #edb/ref 17592186139487 :step/content {:db/id #edb/ref 17592186138510 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138069 :question/id #uuid "e85da1d1-1cf3-547c-86ce-42329475fbdd" :question/math-academy-id "e-12835"} :knowledge-point/id #uuid "54498b47-9a43-5b4d-8bbf-806af5968829" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050311} {:db/id #edb/ref 17592186050452} {:db/id #edb/ref 17592186050833}] :knowledge-point/questions [{:db/id #edb/ref 17592186138716} {:db/id #edb/ref 17592186138809}] :knowledge-point/title "Simplifying Fractions with Like Denominators"} :step/id #uuid "24f9787a-6b3b-581b-a228-064feb6d711c" :step/math-academy-id 71208 :step/next {:db/id #edb/ref 17592186139488}} {:db/id #edb/ref 17592186139488 :step/content {:db/id #edb/ref 17592186138511 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138071 :