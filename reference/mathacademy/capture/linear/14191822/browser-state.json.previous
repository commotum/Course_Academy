></mtd></mtr><mtr><mtd><msup><mn>110</mn><mo>∘</mo></msup></mtd><mtd><mi></mi><mo>=</mo><mi>x</mi><mo>+</mo><mi>x</mi></mtd></mtr><mtr><mtd><msup><mn>110</mn><mo>∘</mo></msup></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><mi>x</mi></mtd></mtr><mtr><mtd><msup><mn>55</mn><mo>∘</mo></msup></mtd><mtd><mi></mi><mo>=</mo><mi>x</mi></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
