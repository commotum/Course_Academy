5417] [17592186515532 #edb/ref 1068 #edb/ref 17592186515505 #edb/ref 17592186045417] [17592186515532 #edb/ref 1069 "q-270847" #edb/ref 17592186045417] [17592186515532 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186515532 #edb/ref 1071 "Find the roots of $f(x)=\\frac{{x}^{2}-9x+14}{{x}^{2}-4}.$\n\n$x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186515532 #edb/ref 1072 #uuid "35ce6eb4-991f-5d5d-bf8d-bb7ed13aec66" #edb/ref 17592186045417] [17592186515532 #edb/ref 1074 "The roots of $f(x)$ are the solutions to the equation $f(x)=0.$ In our case, we have\n\n$$\n\\frac{{x}^{2}-9x+14}{{x}^{2}-4}=0.\n$$\n\nFirst, we factor the numerator and denominator and cancel any common factors, as follows:\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}-9x+14}{{x}^{2}-4} \\\\  & =\\frac{(x-7)(x-2)}{(x+2)(x-2)} \\\\  & =\\frac{(x-7)\\cancel{(x-2)}}{(x+2)\\cancel{(x-2)}} \\\\  & =\\frac{x-7}{x+2}\\end{aligned}\n$$\n\nNow, we set the numerator equal to zero and solve for $x:$\n\n$$\n\\begin{aligned}x-7 & =0\\,⟹\\,x=7\\end{aligned}\n$$\n\nTherefore, the solution to $f(x)=0$ is $x=7.$" #edb/ref 17592186045417] [17592186515550 #edb/ref 1068 #edb/ref 17592186515472 #edb/ref 17592186045417] [17592186515550 #edb/ref 1069 "q-113088" #edb/ref 17592186045417] [17592186515550 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186515550 #edb/ref 1071 "Find the roots of $f(z)=\\frac{{z}^{2}+5z+4}{{z}^{2}+4z}.$" #edb/ref 17592186045417] [17592186515550 #edb/ref 1072 #uuid "60c93613-0dc8-54aa-a9e0-7ec27315eb60" #edb/ref 17592186045417] [17592186515550 #edb/ref 1074 "The roots of $f(z)$ are the solutions to the equation $f(z)=0.$ In our case, we have\n\n$$\n\\frac{{z}^{2}+5z+4}{{z}^{2}+4z}=0.\n$$\n\nFirst, we factor the numerator and denominator and cancel any common factors, as follows:\n\n$$\n\\begin{aligned}f(z) & =\\frac{{z}^{2}+5z+4}{{z}^{2}+4z} \\\\  & =\\frac{(z+1)(z+4)}{z(z+4)} \\\\  & =\\frac{(z+1)\\cancel{(z+4)}}{z\\cancel{(z+4)}} \\\\  & =\\frac{(z+1)}{z}\\end{aligned}\n$$\n\nNow, we set the numerator equal to zero and solve for $z:$\n\n$$\n\\begin{aligned}z+1 & =0\\,⟹\\,z=-1\\end{aligned}\n$$\n\nTherefore, the solution to $f(z)=0$ is $z=-1.$" #edb/ref 17592186045417] [17592186515571 #edb/ref 1068 #edb/ref 17592186515421 #edb/ref 17592186045417] [17592186515571 #edb/ref 1068 #edb/ref 17592186515488 #edb/ref 17592186045417] [17592186515571 #edb/ref 1069 "q-278034" #edb/ref 17592186045417] [17592186515571 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186515571 #edb/ref 1071 "In **ascending order**, the roots of $f(x)=\\frac{{x}^{3}-2{x}^{2}-x+2}{3x-3}$ are\n\n$x=$\n{{field-1}} $\\,$\nand\n$\\,\\,x=$\n{{field-2}}" #edb/ref 17592186045417] [17592186515571 #edb/ref 1072 #uuid "8460a1ed-5635-5121-961a-4a208d9777ff" #edb/ref 17592186045417] [17592186515571 #edb/ref 1074 "The roots of $f(x)$ are the solutions to the equation $f(x)=0.$ In our case, we have\n\n$$\n\\frac{{x}^{3}-2{x}^{2}-x+2}{3x-3}=0.\n$$\n\nFirst, we factor the numerator and denominator and cancel any common factors, as follows:\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{3}-2{x}^{2}-x+2}{3x-3} \\\\  & =\\frac{{x}^{2}(x-2)-1(x-2)}{3x-3} \\\\  & =\\frac{({x}^{2}-1)(x-2)}{3(x-1)} \\\\  & =\\frac{(x-1)(x+1)(x-2)}{3(x-1)} \\\\  & =\\frac{\\cancel{(x-1)}(x+1)(x-2)}{3\\cancel{(x-1)}} \\\\  & =\\frac{(x+1)(x-2)}{3}\\end{aligned}\n$$\n\nNow, we set the numerator equal to zero and solve for $x:$\n\n$$\n\\begin{aligned}(x+1)(x-2) & =0 \\\\ x & =-1,\\,2.\\end{aligned}\n$$\n\nTherefore, the solutions to $f(x)=0$, in ascending order, are $x=-1$ and $x=2.$" #edb/ref 17592186045417] [17592186515573 #edb/ref 1068 #edb/ref 17592186515501 #edb/ref 17592186045417] [17592186515573 #edb/ref 1069 "q-25312" #edb/ref 17592186045417] [17592186515573 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186515573 #edb/ref 1071 "Find the roots of $f(h)=\\frac{{h}^{2}+9h+20}{{h}^{3}+3{h}^{2}-25h-75}.$" #edb/ref 17592186045417] [17592186515573 #edb/ref 1072 #uuid "88464372-728b-5e12-ab3a-004869808716" #edb/ref 17592186045417] [17592186515573 #edb/ref 1074 "The roots of $f(h)$ are the solutions to the equation $f(h)=0.$ In our case, we have\n\n$$\n\\frac{{h}^{2}+9h+20}{{h}^{3}+3{h}^{2}-25h-75}=0.\n$$\n\nFirst, we factor the numerator and denominator and cancel any common factors, as follows:\n\n$$\n\\begin{aligned}f(h) & =\\frac{{h}^{2}+9h+20}{{h}^{3}+3{h}^{2}-25h-75} \\\\  & =\\frac{(h+5)(h+4)}{{h}^{2}(h+3)-25(h+3)} \\\\  & =\\frac{(h+5)(h+4)}{({h}^{2}-25)(h+3)} \\\\  & =\\frac{(h+5)(h+4)}{(h+5)(h-5)(h+3)} \\\\  & =\\frac{\\cancel{(h+5)}(h+4)}{\\cancel{(h+5)}(h-5)(h+3)} \\\\  & =\\frac{h+4}{(h-5)(h+3)}\\end{aligned}\n$$\n\nNow, we set the numerator equal to zero and solve for $h:$\n\n$$\n\\begin{aligned}h+4=0\\,⟹\\,h=-4\\end{aligned}\n$$\n\nTherefore, the solution to $f(h)=0$ is $h=-4.$" #edb/ref 17592186045417] [17592186515583 #edb/ref 1068 #edb/ref 17592186515485 #edb/ref 17592186045417] [17592186515583 #edb/ref 1069 "q-113062" #edb/ref 17592186045417] [17592186515583 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186515583 #edb/ref 1071 "Solve $f(x)=0$ where $f(x)=\\frac{x+5}{2{x}^{2}-5x-25}.$" #edb/ref 17592186045417] [17592186515583 #edb/ref 1072 #uuid "a2cc15c9-6ca6-5c2d-9f16-f12bfe047553" #edb/ref 17592186045417] [17592186515583 #edb/ref 1074 "First, we factor $f(x),$ as follows:\n\n$$\n\\begin{aligned}f(x) & =\\frac{x+5}{2{x}^{2}-5x-25} \\\\  & =\\frac{x+5}{(x-5)(2x+5)}\\end{aligned}\n$$\n\n \n\nThere are no common factors in the numerator and denominator, so we set the numerator equal to zero and solve for $x:$\n\n$$\n\\begin{aligned}x+5 & =0 \\\\ x & =-5\\end{aligned}\n$$\n\nTherefore, the solution to $f(x)=0$ is $x=-5.$" #edb/ref 17592186045417] [17592186515599 #edb/ref 1068 #edb/ref 17592186515459 #edb/ref 17592186045417] [17592186515599 #edb/ref 1069 "q-25299" #edb/ref 17592186045417] [17592186515599 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186515599 #edb/ref 1071 "Find the roots of $f(x)=\\frac{{x}^{2}+x-20}{{x}^{3}-2{x}^{2}-9x+18}.$" #edb/ref 17592186045417] [17592186515599 #edb/ref 1072 #uuid "c9052e44-409b-5493-8da2-7b4975b14835" #edb/ref 17592186045417] [17592186515599 #edb/ref 1074 "The roots of $f(x)$ are the solutions to the equation $f(x)=0.$ In our case, we have\n\n$$\n\\frac{{x}^{2}+x-20}{{x}^{3}-2{x}^{2}-9x+18}=0.\n$$\n\nFirst, we factor the numerator and denominator and cancel any common factors, as follows:\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}+x-20}{{x}^{3}-2{x}^{2}-9x+18} \\\\  & =\\frac{(x+5)(x-4)}{{x}^{2}(x-2)-9(x-2)} \\\\  & =\\frac{(x+5)(x-4)}{({x}^{2}-9)(x-2)} \\\\  & =\\frac{(x+5)(x-4)}{(x+3)(x-3)(x-2)}\\end{aligned}\n$$\n\nNow, we set the numerator equal to zero and solve for $x:$\n\n$$\n\\begin{aligned}(x+5)(x-4)=0\\,⟹\\,x=-5,\\,4\\end{aligned}\n$$\n\nTherefore, the solution to $f(x)=0$ are $x=-5$ and $x=4.$" #edb/ref 17592186045417] [17592186515607 #edb/ref 1068 #edb/ref 17592186515437 #edb/ref 17592186045417] [17592186515607 #edb/ref 1069 "q-70499" #edb/ref 17592186045417] [17592186515607 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186515607 #edb/ref 1071 "Solve $f(t)=0$ where $f(t)=\\frac{t-3}{{t}^{2}+6t+5}.$" #edb/ref 17592186045417] [17592186515607 #edb/ref 1072 #uuid "dd3c4104-b695-59fd-871c-afa5ad204e67" #edb/ref 17592186045417] [17592186515607 #edb/ref 1074 "First, we factor $f(t),$ as follows:\n\n$$\n\\begin{aligned}f(t) & =\\frac{t-3}{{t}^{2}+6t+5} \\\\  & =\\frac{t-3}{(t+5)(t+1)}\\end{aligned}\n$$\n\n \n\nThere are no common factors in the numerator and denominator, so we set the numerator equal to zero and solve for $t:$\n\n$$\n\\begin{aligned}t-3 & =0 \\\\ t & =3\\end{aligned}\n$$\n\nTherefore, the solution to $f(t)=0$ is $t=3.$" #edb/ref 17592186045417] [17592186515608 #edb/ref 1068 #edb/ref 17592186515444 #edb/ref 17592186045417] [17592186515608 #edb/ref 1069 "q-25307" #edb/ref 17592186045417] [17592186515608 #edb/ref 1070 #edb/ref 17