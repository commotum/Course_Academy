#{[{:activity/first-step {:db/id #edb/ref 17592186055741} :activity/id #uuid "923904ff-312a-55b4-a100-3a7d7ffea386" :activity/scope {:db/id #edb/ref 17592186049931 :topic/id #uuid "1f6ee093-7e77-5fea-be72-a47ed3862b7a" :topic/math-academy-id 133} :activity/steps [{:db/id #edb/ref 17592186055741 :step/content {:db/id #edb/ref 17592186055979 :tutorial/content "To find the zeros of a rational function, we first need to factor the numerator and denominator and cancel any common factors. Then, we set the numerator equal to zero and solve.\n\nFor example, consider the function\n\n$$\nf(x) = \\dfrac{x-3}{x^2-25}\n$$\n\nFactoring the numerator and denominator, we get\n\n$$\nf(x) = \\dfrac{x-3}{(x+5)(x-5)}\n$$\n\nThere are no common factors to cancel, so we set the numerator equal to zero and solve:\n\n$$\n\\begin{aligned}\nx - 3 &= 0 \\\\\nx &= 3\n\\end{aligned}\n$$\n\nTherefore, the solution to\n\n$$\nf(x)=0\n$$\n\nis $x=3$." :tutorial/id #uuid "ba9f3296-27d6-5ebc-93b3-bfd93d9384c8" :tutorial/math-academy-id 3380 :tutorial/title "Introduction"} :step/id #uuid "9401928f-ea2f-5f26-8234-d667d795a44d" :step/math-academy-id 466118 :step/next {:db/id #edb/ref 17592186055742}} {:db/id #edb/ref 17592186055742 :step/content {:db/id #edb/ref 17592186054739 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054566 :question/id #uuid "b8371b7c-dfd8-52b3-9c34-00d6814cc5de" :question/math-academy-id "e-5257"} :knowledge-point/id #uuid "7d084b4e-7ca3-5569-b2a5-42c4b8f47917" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673} {:db/id #edb/ref 17592186049074}] :knowledge-point/questions [{:db/id #edb/ref 17592186055163} {:db/id #edb/ref 17592186055471}] :knowledge-point/title "Finding the Roots of a Rational Function With a Linear Numerator and No Common Factors"} :step/id #uuid "650bf011-937b-57f7-a8ee-bf0e54ee1856" :step/math-academy-id 466119 :step/next {:db/id #edb/ref 17592186055743}} {:db/id #edb/ref 17592186055743 :step/content {:db/id #edb/ref 175921860547