#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186101850} :activity/id #uuid "35b6b482-18e8-514d-960d-4d6d3def3f54" :activity/scope {:db/id #edb/ref 17592186050491 :topic/id #uuid "4d8f1d46-f874-5332-bc47-cbcf6b21068c" :topic/math-academy-id 1252} :activity/steps [{:db/id #edb/ref 17592186101850 :step/content {:db/id #edb/ref 17592186101970 :tutorial/content "When we multiply a function by a constant, the graph either stretches out or compresses. Transforming a function in this way is called **scaling**.\n\nTo illustrate, consider the graph of $y=f(x)$ shown below.\n\n![](images/21/21f9b06e470ca0e94605eb72c5a12d2a1f2ec56645588a960f12be81ad8252ec.png)\n\nThe following table lists four sets of points. The set of points in the left-hand column correspond to the graph of $y=f(x),$ and the set on the right-hand side corresponds to $y=2f(x).$\n\n$$\n\\begin{aligned}\\text{Points on [math]y=f(x)[/math]} & \\text{Points on [math]y=2f(x)[/math]} \\\\ (1,2) & (1,4) \\\\ (4,-3) & (4,-6) \\\\ (0,2) & (0,4) &  \\\\ (-2,0) & (-2,0)\\end{aligned}\n$$\n\nFor each point on the graph of $y=f(x),$ there is a point on the graph of $y=2f(x)$ with the same $x$-value and *double* the $y$-value. \n\nNow that we have four points on the graph of $y=2f(x),$ let's plot the full graph.\n\n![](images/26/262b6515b995f6fdcf7b959dc62d9599b71476471fbc2bde394dcebfd47cabc0.png)\n\nWe say that the graph of $y=2f(x)$ is the graph of $y=f(x)$ **vertically stretched** by a **scale factor** of $2.$ \n\nWe can also say that the graph of $y=2f(x)$ is the graph of $y=f(x)$ stretched by a factor of $2$ **parallel to the $\\mathbf y$-axis.**" :tutorial/id #uuid "bea7d899-701e-53ab-9bb8-42e452f0f5c7" :tutorial/math-academy-id 3284 :tutorial/title "Introduction"} :step/id #uuid "c4c40517-5865-5128-af8f-564d6a22648d" :step/math-academy-id 457106 :step/next {:db/id #edb/ref 17592186101851}} {:db/id #edb/ref 17592186101851 :step/content {:db/id #edb/ref 17592186100985 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100709 :question/id #uuid "780bc2f7-da0f-5615-92cd-3a9733b3c333" :question/math-academy-id "e-4980"} :knowledge-point/id #uuid "0dd2eb6c-270f-5537-96f3-5c5438966eab" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048838}] :knowledge-point/questions [{:db/id #edb/ref 17592186101246} {:db/id #edb/ref 17592186101267} {:db/id #edb/ref 17592186529101} {:db/id #edb/ref 17592186529103}] :knowledge-point/title "Plotting the Graph of a Vertically Stretched Function"} :step/id #uuid "60cd62a7-4991-57ac-90fb-b574ced67839" :step/math-academy-id 457107 :step/next {:db/id #edb/ref 17592186101852}} {:db/id #edb/ref 17592186101852 :step/content {:db/id #edb/ref 17592186100986 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100708 :question/id #uuid "b9857541-376a-5256-b302-74346878af3a" :question/math-academy-id "e-4979"} :knowledge-point/id #uuid "d755013d-f02d-5cde-abcb-5be4c06e3b6b" :knowledge-point/questions [{:db/id #edb/ref 17592186101255} {:db/id #edb/ref 17592186101257} {:db/id #edb/ref 17592186529131} {:db/id #edb/ref 17592186529183} {:db/id #edb/ref 17592186547997}] :knowledge-point/title "Plotting the Graph of a Vertically Compressed Function"} :step/id #uuid "ea2e9c61-fcab-5300-8818-9590ecbb72e7" :step/math-academy-id 457110 :step/next {:db/id #edb/ref 17592186101853}} {:db/id #edb/ref 17592186101853 :step/content {:db/id #edb/ref 17592186100987 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100711 :question/id #uuid "446b51d8-1ec7-532c-9b53-21aeb32d57a0" :question/math-academy-id "e-4987"} :knowledge-point/id #uuid "9cb1c0a6-992e-5f39-be35-0a80084ed650" :knowledge-point/questions [{:db/id #edb/ref 17592186101337} {:db/id #edb/ref 17592186101358} {:db/id #edb/ref 17592186101361} {:db/id #edb/ref 17592186529105} {:db/id #edb/ref 17592186529186} {:db/id #edb/ref 17592186547994}] :knowledge-point/title "Finding a Point that Lies on a Vertically Scaled Function"} :step/id #uuid "c481045b-1f32-5a1d-8b62-25e89a1b9393" :step/math-academy-id 457113}] :activity/title "Vertical Stretches of Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186101092}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186548106} :activity/id #uuid "84b5bf88-b15e-5eb2-a1c2-4ee3cfd7b4a8" :activity/scope {:db/id #edb/ref 17592186050491 :topic/id #uuid "4d8f1d46-f874-5332-bc47-cbcf6b21068c" :topic/math-academy-id 1252} :activity/steps [{:db/id #edb/ref 17592186548106 :step/content {:db/id #edb/ref 17592186101361 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d5c5df4-40c2-50ae-85fb-430c28173d99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(8,12)" :db/id #edb/ref 17592186547375} {:answer/id #uuid "297b5739-965f-5d97-afde-d24a71c50915" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(16,24)" :db/id #edb/ref 17592186547394} {:answer/id #uuid "2d45c5ae-1977-58ce-b66c-6465eb267d0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(8,24)" :db/id #edb/ref 17592186547407} {:answer/id #uuid "538243a7-2282-5f10-a989-6f2e0978aa9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(16,12)" :db/id #edb/ref 17592186547503} {:answer/id #uuid "b1ca4171-8d99-55e2-ab66-dae2712d819c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(8,6)" :db/id #edb/ref 17592186547704}] :answer-field/correct {:db/id #edb/ref 17592186547407} :answer-field/id #uuid "ce63585e-30a6-527e-8a5a-356180d8d29a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186099361}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "03fd89d5-cc6f-56c7-a854-1b970edc5ff5" :question/math-academy-id "q-26935" :question/problem "The point $P$ with coordinates $(8,12)$ lies on the curve $y=f(x).$ Which of the following points must lie on $y=2f(x)?$" :question/worked-solution "The function $y=2f(x)$ represents a stretch of the function $y=f(x)$ by a factor of $2$ parallel to the $y$-axis. This has the effect of multiplying the $y$-coordinates of all points on $y=f(x)$ by $2.$\n\nTherefore, the point $(8,12)$ on $f(x)$ is mapped to the point $(8,2\\cdot 12)=(8,24),$ and this point must lie on the graph of $y=2f(x).$"} :step/id #uuid "58b3c8d6-2ca8-5b9b-9ad1-a157a307dfaa" :step/next {:db/id #edb/ref 17592186548147}} {:db/id #edb/ref 17592186548145 :step/content {:db/id #edb/ref 17592186547997 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47254958-c6e9-508c-ab38-416305b1b3df" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/12/12d4221b81ac7e5b7d5215df9bcedcce32cad9296d43fac4f76689f59af1a239.png" :db/id #edb/ref 17592186547473} {:answer/id #uuid "6d1c33c6-4f01-51ce-906e-400e9a367abd" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/54/5431a7e47a308e988a6e81de01b569e68c787994b6717009eb760e9ec5019464.png" :db/id #edb/ref 17592186547559} {:answer/id #uuid "6f2e6727-9491-5e81-abbf-30bc6689d940" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e3/e3be32cb1df28a1f7f48cfaf1bb2fff311113d9a3a1ed3ea87420be33703032c.png" :db/id #edb/ref 17592186547563} {:answer/id #uuid "73a47950-119b-501c-b6d6-3dcaa1db8188" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/63/63051c6eeed231b2153ec9e0ffc505359c09755c8e46cb2f7d430fb7925de58d.png" :db/id #edb/ref 17592186547570} {:answer/id #uuid "d5cc25c3-1cb1-5454-bbd8-68f4535626b4" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/8b/8ba557b178733dfe1c630aaf89052721c09871e76e19d1859c39e110f1b0134d.png" :db/id #edb/ref 17592186547769}] :answer-field/correct {:db/id #edb/ref 17592186547769} :answer-field/id #uuid "bdb4473c-84af-5e05-a80a-89f2a6a04705" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186547936}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "46986aeb-b3ed-5a20-9bf3-78659d9de421" :question/math-academy-id "q-111174" :question/problem "![](images/04/04a4c0b720676f48d1587c2e8ff0cd7096868ef0192738812af09bba725fd224.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following is the graph of $y=\\frac{1}{4}f(x)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "To graph the function $y=\\frac{1}{4}f(x),$ we take the graph of $y=f(x)$ and compress it by factor of $4$ parallel to the $y$-axis. This has the effect of dividing the $y$-coordinates of all points on $y=f(x)$ by $4.$\n\nThe resulting graph is the solid blue curve shown below.\n\n![](images/e7/e7f418df59b24e1410b172f362c087241b85c0fa9861231ec352f80cbc0668ff.png)"} :step/id #uuid "adbf7b99-bd18-5f21-9b0c-3d1593c2aa97"} {:db/id #edb/ref 17592186548147 :step/content {:db/id #edb/ref 17592186547994 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e4ff37e-6e33-5e71-a809-34b53b71daa2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(5,4)" :db/id #edb/ref 17592186547344} {:answer/id #uuid "3bb4b77c-886c-5116-b814-fa3023c988a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(5,8)" :db/id #edb/ref 17592186547445} {:answer/id #uuid "493c1ac4-f93b-5cc1-b151-9391c7ffa2b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(10,4)" :db/id #edb/ref 17592186547478} {:answer/id #uuid "935c105d-8186-59e8-9c38-2769ba4d5f69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(10,16)" :db/id #edb/ref 17592186547643} {:answer/id #uuid "cd72122e-035b-5d73-a118-62046f1b574d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(20,16)" :db/id #edb/ref 17592186547754}] :answer-field/correct {:db/id #edb/ref 17592186547478} :answer-field/id #uuid "c4efac58-0e1b-5cda-b9ed-a1fe7c4d15f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186547941}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "370ca68a-a4c7-585b-aa83-7cfb70ebc27e" :question/math-academy-id "q-81958" :question/problem "The point $P$ with coordinates $(10,8)$ lies on the curve $y=2f(x).$ Which of the following points must lie on $y=f(x)?$" :question/worked-solution "The function $y=2f(x)$ represents a stretch of the function $y=f(x)$ by a factor of $2$ parallel to the $y$-axis. This has the effect of multiplying the $y$-coordinates of all points on $y=f(x)$ by $2.$\n\nThe point $Q(10,q)$ on $f(x)$ is mapped to the point $P(10,8)$ on $y=2f(x).$ Since we know that the $y$-coordinate of $P$ is $2$ times the $y$-coordinate of $Q,$ we can form the following equation:\n\n$$\n2q=8\n$$\n\nSolving this equation, we get $q=4.$ Therefore, the coordinates of $Q$ are $(10,4).$"} :step/id #uuid "b2d90f21-2ff1-5eb2-9c2b-2bcd08962316" :step/next {:db/id #edb/ref 17592186548145}}] :activity/title "Vertical Stretches of Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186547300}]}
