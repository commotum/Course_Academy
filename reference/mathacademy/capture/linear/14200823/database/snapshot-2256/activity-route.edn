#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186518255} :activity/id #uuid "778b6c61-0a3f-550a-a089-d845f1d501a3" :activity/steps [{:db/id #edb/ref 17592186518225 :step/content {:db/id #edb/ref 17592186518189 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11ecafca-23d1-501a-b842-fac6e3f5d367" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f7/f70e2533c9484076d1a899d55ffb22206dc69c5364178fde115d6f8dd4b2b19c.png" :db/id #edb/ref 17592186517523} {:answer/id #uuid "247b63ff-ef4c-59a6-8a1c-d39e512a4827" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/43/433d36abaf01ce607bc536c7a69956fd2f306479eeaca375948a3cfb22baaa99.png" :db/id #edb/ref 17592186517556} {:answer/id #uuid "6b558799-faf9-534e-aa65-41d66e79512e" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/3c/3c0fa9f5b6c9dfa35bc4fa1c160f63a261a853c4c2fddb2bb08f293ed90cccf4.png" :db/id #edb/ref 17592186517688} {:answer/id #uuid "7d868048-21b4-5600-937d-9be2d5b10f59" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/19/19520b88504572a892e70dc3a40d16a3635c8528f9e591ac82aa0411d8091129.png" :db/id #edb/ref 17592186517726} {:answer/id #uuid "c2f06e0b-eeee-5d35-ab97-c6ede01375a4" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/64/64177bb93f55ad709a3fa8219fc7971dc903a9a28e71967bca9cb66d3f7daf1b.png" :db/id #edb/ref 17592186517860}] :answer-field/correct {:db/id #edb/ref 17592186517726} :answer-field/id #uuid "63b03bab-6a94-55d1-98c6-554a345ccc3e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518022}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c49fa7b3-27b5-573b-aadb-233575243dcc" :question/math-academy-id "q-109030" :question/problem "Which of the following shows the point $D(-5,4)?$" :question/worked-solution "Starting at the origin, we move along the $x$ and $y$ axes to get to the point $D.$\n\nFirst, we move along the $x$-axis. The point $D$ has an $x$-coordinate of $-5,$ so we move $5$ units to the *left*, in the negative direction of the $x$-axis.\n\nThen, we move along the $y$-axis. The point $D$ has a $y$-coordinate of $4,$ so we move $4$ units *up*, in the positive direction of the $y$-axis.\n\n![](images/19/19520b88504572a892e70dc3a40d16a3635c8528f9e591ac82aa0411d8091129.png)"} :step/id #uuid "06956ae6-a0ed-51f5-858f-eee00b1ca616" :step/next {:db/id #edb/ref 17592186518243}} {:db/id #edb/ref 17592186518228 :step/content {:db/id #edb/ref 17592186518126 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d95e62e-9e4b-5826-9690-2dd1c535569f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186517611} {:answer/id #uuid "47461420-eebc-5210-9f02-135bf2199ac7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186517624} {:answer/id #uuid "ba920345-040b-5c00-9222-48c01b435190" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186517841} {:answer/id #uuid "d67c4190-47a5-58db-9d33-fefd4a5da6e6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186517894} {:answer/id #uuid "ea490ea3-55ec-50ba-b568-f292077c0820" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186517932}] :answer-field/correct {:db/id #edb/ref 17592186517841} :answer-field/id #uuid "252ef2a1-dcf1-50c9-9860-56f9e9785136" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186517987}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "38eccaa1-2de4-5013-b379-9718f328c233" :question/math-academy-id "q-350272" :question/problem "Ella and Nora run bakeries. In the previous week, $10%$ of Ella’s pastries were gluten-free, while the decimal proportion of Nora’s pastries that were gluten-free was $0.05.$\n\nWhich of the following statements are true?\n\nI. Less than one fourth of Ella's pastries were gluten-free.\n\nII. More than one fourth of Nora's pastries were gluten-free.\n\nIII. Ella had a greater percentage of gluten-free pastries compared to Nora." :question/worked-solution "Let's examine our statements in turn.\n\n- Statement I is true. Indeed, since \n\n$$\n10%<\\frac{1}{4}\\cdot 100%=25%,\n$$\n\nless than one-fourth of Ella's pastries were gluten-free.\n\n- Statement II is false. Notice that \n\n$$\n0.05<\\frac{1}{4}=0.25.\n$$\n\nSo, less than one-fourth of Nora's pastries were gluten-free.\n\n- Statement III is true. We can compare $10%$ and $0.05$ by converting the decimal into a percent.\n\nTo do this, we multiply it by $100:$\n\n$$\n0.05\\times 100=5%\n$$\n\nSince $10%>5%,$ Ella had a **greater** percentage of gluten-free pastries compared to Nora.\n\nTherefore, the correct answer is \"I and III only\"."} :step/id #uuid "0e4a3401-c189-5f87-82f9-223689f4ee7b" :step/next {:db/id #edb/ref 17592186518281}} {:db/id #edb/ref 17592186518235 :step/content {:db/id #edb/ref 17592186518125 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29c93de5-8d1f-562e-89c7-389d504aabef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186517565}] :answer-field/correct {:db/id #edb/ref 17592186517565} :answer-field/id #uuid "e68bf2f3-762f-5da1-9e8f-676a80dfc16c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186518084}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3851cb9c-32ab-50a5-b26d-1f3dac949677" :question/math-academy-id "q-236322" :question/problem "The ratio $3:2$ is equivalent to the ratio{{field-1}}$:10.$" :question/worked-solution "To find the ratio equivalent to $3:2$, we multiply both numbers by the same value:\n\n$$\n\\begin{aligned}\\,3 &  & : & \\,\\,\\, & \\,\\,2 &  \\\\ \\,\\,↓\\times \\,\\,5 &  &  &  & \\,\\,\\,↓\\times \\,\\,5 &  \\\\ \\,\\,\\boxed{} &  & : &  & \\,\\,\\,10 & \\end{aligned}\n$$\n\nTo get $10$ from $2,$ we multiply $2$ by $5.$ So, to get $\\,\\boxed{}\\,$ from $3,$ we multiply $3$ by $5$ as well:\n\n$$\n3\\times 5=15\n$$\n\nThe ratio $3:2$ is equivalent to $15:10.$"} :step/id #uuid "30e06609-47fd-5091-95a4-9a463054dd15" :step/next {:db/id #edb/ref 17592186518257}} {:db/id #edb/ref 17592186518243 :step/content {:db/id #edb/ref 17592186518175 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06bd77d7-6973-53e6-a4fe-f2c82d993ecf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186517502} {:answer/id #uuid "21b57cb3-fc0d-564e-95de-da986f4e2407" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186517549} {:answer/id #uuid "6fb2daa7-5a15-5bc1-9fad-8efe11262852" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186517703} {:answer/id #uuid "7a97aade-7741-5b60-bcc2-a3ecaceb3f55" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186517721} {:answer/id #uuid "b70aeab0-a4e9-51d7-aa0a-588121c2fe9d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186517833}] :answer-field/correct {:db/id #edb/ref 17592186517721} :answer-field/id #uuid "40a9649d-c150-553c-95e3-691521407741" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518002}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8e57b39f-05a9-5f35-9efb-5ed20831848c" :question/math-academy-id "q-43872" :question/problem "Which of the following is **not** an algebraic expression?\n\nI. $4+2y$\n\nII. $x+\\sqrt{5}$\n\nIII. $7-4=3$" :question/worked-solution "III is **not** an algebraic expression since it contains the equality sign."} :step/id #uuid "3934ded0-6a6c-5dd0-956e-fecc34500caa" :step/next {:db/id #edb/ref 17592186518275}} {:db/id #edb/ref 17592186518255 :step/content {:db/id #edb/ref 17592186518121 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0411dfeb-e3a8-5dc4-9b78-e2d3d9b02b15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186517497} {:answer/id #uuid "133dff8c-5de2-5a42-af45-1dc2089abeef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-25" :db/id #edb/ref 17592186517526} {:answer/id #uuid "2396cb0f-cf6c-5511-a0cf-32332fccd198" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186517554} {:answer/id #uuid "994b30f4-895d-550b-ab51-e6d5983c68e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186517780} {:answer/id #uuid "aeb70b96-6db0-5bcc-b838-a7e4522e3491" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186517815}] :answer-field/correct {:db/id #edb/ref 17592186517526} :answer-field/id #uuid "b5d7548f-4651-5714-a212-98fe6364d378" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518054}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2b95da98-1f5f-5fa5-ad72-3959a1d46504" :question/math-academy-id "q-2129" :question/problem "$5\\cdot (-5)=$" :question/worked-solution "We have a product of a positive number $(5)$ and a negative number $(-5).$ So the product will be negative:\n\n$$\n5\\cdot (-5)=-\\boxed{}\n$$\n\nNow, to compute the number that goes in the box, we multiply $5$ by $5$ without any signs: $5\\cdot 5=25.$ So, we get\n\n$$\n5\\cdot (-5)=-25.\n$$"} :step/id #uuid "5f74c32c-ae96-56d4-ae69-17e12286369e" :step/next {:db/id #edb/ref 17592186518314}} {:db/id #edb/ref 17592186518257 :step/content {:db/id #edb/ref 17592186518183 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40e4fb97-951d-5b68-859b-21f442ae9424" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186517614}] :answer-field/correct {:db/id #edb/ref 17592186517614} :answer-field/id #uuid "ee82855a-a9a9-5945-b471-65f010904c24" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186518086}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a98d2b92-1f79-5299-a15c-071e314b9a2c" :question/math-academy-id "q-171153" :question/problem "$0÷(\\frac{2}{3})=${{field-1}}" :question/worked-solution "Zero divided by any number (other than zero) equals zero. Therefore, $0÷(\\frac{2}{3})=0.$"} :step/id #uuid "66e17220-fc20-5871-9abf-d593d06ab365"} {:db/id #edb/ref 17592186518275 :step/content {:db/id #edb/ref 17592186518173 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40774ba8-a6a5-56dc-b62b-b32a5fe719fa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186517613} {:answer/id #uuid "5f2cb3de-1316-52f2-be07-043399d5f93d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186517662} {:answer/id #uuid "6a04fccc-5a20-5e09-8879-a31a6e27b132" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186517683} {:answer/id #uuid "9c33d0b1-3305-503c-99ec-baac4e90a33b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186517789} {:answer/id #uuid "edaef11f-f6fd-5e0c-ad4d-5d1395a1797e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186517940}] :answer-field/correct {:db/id #edb/ref 17592186517789} :answer-field/id #uuid "33758373-5bbe-5e79-862d-c6b0cf8fdadf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186517994}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8c89a512-5fc0-599a-9173-8df36d4b9b39" :question/math-academy-id "q-98376" :question/problem "Which of the following statements are true?\n\nI. $\\frac{7}{10}$ is a rational number\n\nII. $-\\frac{5}{3}$ is a rational number\n\nIII. $3$ is a rational number" :question/worked-solution "A rational number is any number that can be written as the ratio of two integers.\n\nNow, let's go through each number in turn.\n\n- $\\frac{7}{10}$ is a rational number.\n\n- $-\\frac{5}{3}$ is a rational number. It can be written as $\\frac{(-5)}{3}.$\n\n- $3$ is a rational number. It can be written as $\\frac{3}{1}.$\n\nTherefore, the correct answer is \"I, II, and III.\""} :step/id #uuid "967c9564-f50f-5c61-9408-07a338c12e4a" :step/next {:db/id #edb/ref 17592186518235}} {:db/id #edb/ref 17592186518281 :step/content {:db/id #edb/ref 17592186518169 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2de39e75-06fe-5828-9b1e-26772a43909d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186517575} {:answer/id #uuid "4aa36735-7bbe-5b13-ab8f-722801427503" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186517632} {:answer/id #uuid "a47150a2-4d2c-528f-86a0-ceb4e70b28ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186517795} {:answer/id #uuid "d8e9a1a6-a981-5a12-836d-7987e291ca25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186517901} {:answer/id #uuid "de19f2d7-b048-5fd2-a5d0-b10b55dad122" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186517906}] :answer-field/correct {:db/id #edb/ref 17592186517795} :answer-field/id #uuid "c968ce86-4d0c-5e9e-8768-5180c33c524e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518064}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7fc0e3a0-04f8-58fa-8d72-05025f5c40e7" :question/math-academy-id "q-60254" :question/problem "![](images/a3/a37bbb00bcf37dce19970f5494412eaa9c68e5db134354e3c9d790cd9dc7a5b5.png)\n\nWhat ratio describes the number of triangles to squares?" :question/worked-solution "We count the number of triangles. We see that there is $1$ triangle.\n\n We count the number of square. We see that there are $3$ squares.\n\nSo the ratio of triangles to squares is $\\frac{1}{3}.$"} :step/id #uuid "a91deb52-df8e-58f3-a80c-61f97b3b3d3c" :step/next {:db/id #edb/ref 17592186518225}} {:db/id #edb/ref 17592186518309 :step/content {:db/id #edb/ref 17592186518187 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aa071bc-3705-5e8f-a8c4-66af19f5f97a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186517508} {:answer/id #uuid "67027953-9b36-5a07-91c8-e63f2d9c44d0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186517677} {:answer/id #uuid "9735e0c8-6095-51ae-8f1f-6a22cd6c37b2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186517774} {:answer/id #uuid "e3a8e7a6-c558-5c83-9825-bcf1b0f38adf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186517916} {:answer/id #uuid "ff608879-f846-5e5f-a92a-af8609b27731" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186517968}] :answer-field/correct {:db/id #edb/ref 17592186517916} :answer-field/id #uuid "bdc5610c-12bb-5623-b3c8-987e1a880e7f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518060}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bd6001aa-5beb-57ae-855c-a9db7b063e64" :question/math-academy-id "q-85435" :question/problem "Which of the following numbers are divisible by $6?$\n\nI. $26\\,489\\,225$\n\nII. $14\\,736\\,438$\n\nIII. $749\\,356\\,314$" :question/worked-solution "A number is divisible by $6$ if it is divisible by both $2$ and $3.$\n\n- The number $26\\,489\\,225$ is not divisible by $2,$ so it is not divisible by $6$ either.\n\n- The number $14\\,736\\,438$ is divisible by $2,$ and it is also divisible by $3$ since the sum of its digits is divisible by $3:$\n\n$$\n1+4+7+3+6+4+3+8=36\n$$\n\nSo, $14\\,736\\,438$ is divisible by $6.$\n\n- The number $749\\,356\\,314$ is divisible by $2,$ and it is also divisible by $3$ since the sum of its digits is divisible by $3:$\n\n$$\n7+4+9+3+5+6+3+1+4=42\n$$\n\nSo, $749\\,356\\,314$ is divisible by $6.$\n\nTherefore, the correct answer is \"II and III only.\""} :step/id #uuid "e6399d6d-b625-57cf-b71c-979b3a44630a" :step/next {:db/id #edb/ref 17592186518228}} {:db/id #edb/ref 17592186518314 :step/content {:db/id #edb/ref 17592186518127 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c71f521f-acfa-538e-b4a4-b5ccf0744921" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-37" :db/id #edb/ref 17592186517868}] :answer-field/correct {:db/id #edb/ref 17592186517868} :answer-field/id #uuid "53ee380b-dbad-5bda-b397-5e40d67dcaef" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186518010}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "38fc7adf-0452-58e7-9840-3560c89df130" :question/math-academy-id "q-236832" :question/problem "$6-43=${{field-1}}" :question/worked-solution "Since $43$ is larger than $6,$ the answer will be negative.\n\nWe start by solving an easier problem:\n\n$$\n43-6\n$$\n\nNext, we carry out the subtraction:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\begin{aligned}\\,\\,\\,3\\end{aligned} & \\,\\,\\,\\begin{aligned}\\,\\,\\,13\\end{aligned} \\\\  &  & \\,\\,\\,4\\,\\,\\, & \\,\\,\\,3\\,\\,\\, \\\\ \\,\\,\\,\\,-\\,\\,\\,\\, &  &  & \\,\\,\\,6\\,\\,\\, \\\\  &  & \\,\\,\\,3\\,\\,\\, & \\,\\,\\,7\\,\\,\\,\\end{aligned}\n$$\n\nSo, we have\n\n$$\n43-6=37.\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n6-43=-37.\n$$"} :step/id #uuid "edb517ce-1a8e-5bc2-8f59-f6abc82050e2" :step/next {:db/id #edb/ref 17592186518309}}] :activity/title "Quiz 2" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186517487}]}
