#{[{:db/id #edb/ref 17592186073464 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073806 :knowledge-point/id #uuid "2d8a8280-5248-57e4-a5ed-14e281f3db77" :knowledge-point/title "Simplifying Square Root Expressions"}] :question/id #uuid "cf793c45-6c89-50c8-bb28-d066d2b8342a" :question/math-academy-id "e-1370" :question/problem "Simplify $8\\sqrt 3 - 5\\sqrt 3 + \\sqrt 5.$" :question/worked-solution "We can combine the two $\\sqrt{3}$ terms together, as follows:\n\n$$\n\\begin{aligned}8\\sqrt{3}-5\\sqrt{3}+\\sqrt{5} & = \\\\ (8-5)\\sqrt{3}+\\sqrt{5} & = \\\\ 3\\sqrt{3}+\\sqrt{5} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186073663 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073788 :knowledge-point/id #uuid "1a31c2b6-585a-5715-98f8-4b82605f4c22" :knowledge-point/title "Simplifying Expressions Containing Cube Roots"}] :question/id #uuid "e5202e06-b6a8-5d74-a395-fe7c56b8e9bb" :question/math-academy-id "e-9728" :question/problem "Simplify $2\\sqrt[3]{5} +5 \\sqrt{10} -3 \\sqrt[3]{40}.$" :question/worked-solution "First, we use the product rule for radicals, as follows:\n\n$$\n\\begin{aligned}\\sqrt[3]{40} & =\\sqrt[3]{8\\cdot 5}=\\sqrt[3]{8}\\cdot \\sqrt[3]{5}=2\\sqrt[3]{5} & \\end{aligned}\n$$\n\nAs a result, we have\n\n$$\n\\begin{aligned}2\\sqrt[3]{5}+5\\sqrt{10}-3\\sqrt[3]{40} & = \\\\ 2\\sqrt[3]{5}+5\\sqrt{10}-3(2\\sqrt[3]{5}) & = \\\\ 2\\sqrt[3]{5}+5\\sqrt{10}-6\\sqrt[3]{5}.\\end{aligned}\n$$\n\nNow, we can combine the two $\\sqrt[3]{5}$ terms together:\n\n$$\n\\begin{aligned}2\\sqrt[3]{5}+5\\sqrt{10}-6\\sqrt[3]{5} & = \\\\ 5\\sqrt{10}+(2\\sqrt[3]{5}-6\\sqrt[3]{5}) & = \\\\ 5\\sqrt{10}+(2-6)\\sqrt[3]{5} & = \\\\ 5\\sqrt{10}-4\\sqrt[3]{5} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186073664 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073789 :knowledge-point/id #uuid "622cd109-3764-5f32-8205-046be4b57c54" :knowledge-point/title "Simplifying Square Root Expressions Using the Product Rule for Radicals"}] :question/id #uuid "c1f1d037-45a6-5e72-a735-0c0512290120" :question/math-academy-id "e-9729" :question/problem "Simplify the expression $3\\sqrt{80} -8\\sqrt{5}.$" :question/worked-solution "First, we use the product rule for radicals to simplify $\\sqrt{80},$ as follows:\n\n$$\n\\begin{aligned}\\sqrt{80} & =\\sqrt{16\\cdot 5}=\\sqrt{16}\\cdot \\sqrt{5}=4\\sqrt{5} & \\end{aligned}\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}3\\sqrt{80}-8\\sqrt{5} & = \\\\ 3(4\\sqrt{5})-8\\sqrt{5} & = \\\\ 12\\sqrt{5}-8\\sqrt{5}. & \\end{aligned}\n$$\n\nNow, we can combine the two $\\sqrt{5}$ terms together:\n\n$$\n\\begin{aligned}12\\sqrt{5}-8\\sqrt{5} & = \\\\ (12-8)\\sqrt{5} & = \\\\ 4\\sqrt{5} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485544 :knowledge-point/_questions [{:db/id #edb/ref 17592186073789 :knowledge-point/id #uuid "622cd109-3764-5f32-8205-046be4b57c54" :knowledge-point/title "Simplifying Square Root Expressions Using the Product Rule for Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f797177-d53a-5907-82e8-bb0f6bd637df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{5}-2\\sqrt{3}" :db/id #edb/ref 17592186484989} {:answer/id #uuid "6c57493f-9a04-58df-b0f0-bbb6bc2ec0cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{5}+\\sqrt{3}" :db/id #edb/ref 17592186485051} {:answer/id #uuid "89117265-7cab-503c-92af-f188b42f42c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{5}" :db/id #edb/ref 17592186485117} {:answer/id #uuid "a25c76c2-2df2-5c95-a861-9dd96c3f4a8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28\\sqrt{5}-2\\sqrt{3}" :db/id #edb/ref 17592186485170} {:answer/id #uuid "c3fc03d7-9299-50fb-8795-b3487550b44a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{3}" :db/id #edb/ref 17592186485237}] :answer-field/correct {:answer/id #uuid "4f797177-d53a-5907-82e8-bb0f6bd637df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{5}-2\\sqrt{3}" :db/id #edb/ref 17592186484989} :answer-field/id #uuid "df44ef82-3c73-5b75-bc3d-d84c7c1380c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485464}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "72ebf39d-3bb6-58bc-806b-137a4fead9d6" :question/math-academy-id "q-134543" :question/problem "Simplify $\\sqrt{125}-2\\sqrt{3}+3\\sqrt{5}.$" :question/worked-solution "First, we use the product rule for radicals, as follows:\n\n$$\n\\begin{aligned}\\sqrt{125} & =\\sqrt{25\\cdot 5}=\\sqrt{25}\\cdot \\sqrt{5}=5\\sqrt{5} & \\end{aligned}\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}\\sqrt{125}-2\\sqrt{3}+3\\sqrt{5} & = \\\\ 5\\sqrt{5}-2\\sqrt{3}+3\\sqrt{5} & \\end{aligned}\n$$\n\nNow, we can combine the two $\\sqrt{5}$ terms together:\n\n$$\n\\begin{aligned}5\\sqrt{5}-2\\sqrt{3}+3\\sqrt{5} & = \\\\ (5\\sqrt{5}+3\\sqrt{5})-2\\sqrt{3} & = \\\\ (5+3)\\sqrt{5}-2\\sqrt{3} & = \\\\ 8\\sqrt{5}-2\\sqrt{3} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485566 :knowledge-point/_questions [{:db/id #edb/ref 17592186073789 :knowledge-point/id #uuid "622cd109-3764-5f32-8205-046be4b57c54" :knowledge-point/title "Simplifying Square Root Expressions Using the Product Rule for Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "771e6036-105c-5e38-8132-37931b12b769" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\sqrt{5}" :db/id #edb/ref 17592186485071} {:answer/id #uuid "85921482-60cc-5b3b-bac9-34c591e98316" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\sqrt{5}+2\\sqrt{10}" :db/id #edb/ref 17592186485107} {:answer/id #uuid "89e8d243-f4d9-5efb-b831-ec8cb1c16af1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{5}+4\\sqrt{10}" :db/id #edb/ref 17592186485119} {:answer/id #uuid "d73f86a3-d6be-5522-9996-33d10e15ceab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\sqrt{10}-2\\sqrt{5}" :db/id #edb/ref 17592186485269} {:answer/id #uuid "dfe8f46d-8281-5450-aa1e-1db2a8b09dbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\sqrt{10}" :db/id #edb/ref 17592186485289}] :answer-field/correct {:answer/id #uuid "89e8d243-f4d9-5efb-b831-ec8cb1c16af1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{5}+4\\sqrt{10}" :db/id #edb/ref 17592186485119} :answer-field/id #uuid "11096cdf-2d5a-55cb-ab12-cdce2b0d4e9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485372}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a9e25ac2-f767-5781-99ee-621462efc511" :question/math-academy-id "q-134546" :question/problem "Simplify $\\sqrt{500}+4\\sqrt{10}-2\\sqrt{5}.$" :question/worked-solution "First, we use the product rule for radicals, as follows:\n\n$$\n\\begin{aligned}\\sqrt{500} & =\\sqrt{100\\cdot 5}=\\sqrt{100}\\cdot \\sqrt{5}=10\\sqrt{5} & \\end{aligned}\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}\\sqrt{500}+4\\sqrt{10}-2\\sqrt{5} & = \\\\ 10\\sqrt{5}+4\\sqrt{10}-2\\sqrt{5} & \\end{aligned}\n$$\n\nNow, we can combine the two $\\sqrt{5}$ terms together:\n\n$$\n\\begin{aligned}10\\sqrt{5}+4\\sqrt{10}-2\\sqrt{5} & = \\\\ (10\\sqrt{5}-2\\sqrt{5})+4\\sqrt{10} & = \\\\ (10-2)\\sqrt{5}+4\\sqrt{10} & = \\\\ 8\\sqrt{5}+4\\sqrt{10} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485534 :knowledge-point/_questions [{:db/id #edb/ref 17592186073788 :knowledge-point/id #uuid "1a31c2b6-585a-5715-98f8-4b8