{4}=5\\sqrt[3]{4} & \\end{aligned}\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}4\\sqrt[3]{500}+\\sqrt[3]{4}-\\sqrt{3} & = \\\\ 4(5\\sqrt[3]{4})+\\sqrt[3]{4}-\\sqrt{3} & = \\\\ 20\\sqrt[3]{4}+\\sqrt[3]{4}-\\sqrt{3}.\\end{aligned}\n$$\n\nNow, we can combine the two $\\sqrt[3]{4}$ terms together:\n\n$$\n\\begin{aligned}20\\sqrt[3]{4}+\\sqrt[3]{4}-\\sqrt{3} & = \\\\ (20\\sqrt[3]{4}+\\sqrt[3]{4})-\\sqrt{3} & = \\\\ (20+1)\\sqrt[3]{4}-\\sqrt{3} & = \\\\ 21\\sqrt[3]{4}-\\sqrt{3} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485537 :knowledge-point/_questions [{:db/id #edb/ref 17592186073788 :knowledge-point/id #uuid "1a31c2b6-585a-5715-98f8-4b82605f4c22" :knowledge-point/title "Simplifying Expressions Containing Cube Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ab91932-e355-5352-aba3-b6df560e9b3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}+14\\sqrt[3]{6}" :db/id #edb/ref 17592186484836} {:answer/id #uuid "55572885-5954-5b49-bbf7-ae2b41c0b283" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}+18\\sqrt[3]{6}" :db/id #edb/ref 17592186485010} {:answer/id #uuid "7451faf5-8af1-525e-8e9d-8f546d5c31b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}+2\\sqrt[3]{6}" :db/id #edb/ref 17592186485068} {:answer/id #uuid "90c5b765-e85d-55b5-bfdb-78a5e3f6f707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15\\sqrt[3]{6}" :db/id #edb/ref 17592186485133} {:answer/id #uuid "ebecd2a6-8dca-5397-bfd3-0a2018b2b27f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{7}" :db/id #edb/ref 17592186485320}] :answer-field/correct {:answer/id #uuid "0ab91932-e355-5352-aba3-b6df560e9b3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}+14\\sqrt[3]{6}" :db/id #edb/ref 17592186484836} :answer-field/id #uuid "648d8aec-59b5-5928-b88a-f36a1aea213d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485407}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5ea12d57-149c-5e75-92c8-881bf2f1c4e9" :question/math-academy-id "q-134567" :question/problem "Simplify $\\sqrt{7}+5\\sqrt[3]{162}-\\sqrt[3]{6}.$" :question/worked-solution "First, we use the product rule for radicals, as follows:\n\n$$\n\\begin{aligned}\\sqrt[3]{162} & =\\sqrt[3]{27\\cdot 6}=\\sqrt[3]{27}\\cdot \\sqrt[3]{6}=3\\sqrt[3]{6} & \\end{aligned}\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}\\sqrt{7}+5\\sqrt[3]{162}-\\sqrt[3]{6} & = \\\\ \\sqrt{7}+5(3\\sqrt[3]{6})-\\sqrt[3]{6}= \\\\ \\sqrt{7}+15\\sqrt[3]{6}-\\sqrt[3]{6}. & \\end{aligned}\n$$\n\nNow, we can combine the two $\\sqrt[3]{6}$ terms together:\n\n$$\n\\begin{aligned}\\sqrt{7}+15\\sqrt[3]{6}-\\sqrt[3]{6}= \\\\ \\sqrt{7}+(15\\sqrt[3]{6}-\\sqrt[3]{6}) & = \\\\ \\sqrt{7}+(15-1)\\sqrt[3]{6} & = \\\\ \\sqrt{7}+14\\sqrt[3]{6} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485554 :knowledge-point/_questions [{:db/id #edb/ref 17592186073806 :knowledge-point/id #uuid "2d8a8280-5248-57e4-a5ed-14e281f3db77" :knowledge-point/title "Simplifying Square Root Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2aaf527d-34f7-5ae4-b8a8-94bafa5a4ff2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}-3\\sqrt{3}" :db/id #edb/ref 17592186484903} {:answer/id #uuid "3d304dda-963e-5449-a2b5-7b6c48a04212" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{3}+3\\sqrt{2}" :db/id #edb/ref 17592186484948} {:answer/id #uuid "99379c0c-fbdc-5b04-b21f-46cc528ca026" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{3}" :db/id #edb/ref 175921864