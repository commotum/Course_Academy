#{[{:activity/first-step {:db/id #edb/ref 17592186074751} :activity/id #uuid "17691de4-8d73-56a0-9388-fcd801f22dd1" :activity/scope {:db/id #edb/ref 17592186050341 :topic/id #uuid "4116a9b1-1ae1-5c46-ab2a-fcbda7bb3a26" :topic/math-academy-id 484} :activity/steps [{:db/id #edb/ref 17592186074725 :step/content {:db/id #edb/ref 17592186073788 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073663 :question/id #uuid "e5202e06-b6a8-5d74-a395-fe7c56b8e9bb" :question/math-academy-id "e-9728"} :knowledge-point/id #uuid "1a31c2b6-585a-5715-98f8-4b82605f4c22" :knowledge-point/questions [{:db/id #edb/ref 17592186074003} {:db/id #edb/ref 17592186074004} {:db/id #edb/ref 17592186233430}] :knowledge-point/title "Simplifying Expressions Containing Cube Roots"} :step/id #uuid "74aa14ec-4817-573b-816c-aa9e7cef4458" :step/math-academy-id 36487} {:db/id #edb/ref 17592186074726 :step/content {:db/id #edb/ref 17592186073789 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073664 :question/id #uuid "c1f1d037-45a6-5e72-a735-0c0512290120" :question/math-academy-id "e-9729"} :knowledge-point/id #uuid "622cd109-3764-5f32-8205-046be4b57c54" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049923}] :knowledge-point/questions [{:db/id #edb/ref 17592186074001} {:db/id #edb/ref 17592186074002}] :knowledge-point/title "Simplifying Square Root Expressions Using the Product Rule for Radicals"} :step/id #uuid "b782d57f-6faa-597a-9408-0b6fc960adfb" :step/math-academy-id 36491 :step/next {:db/id #edb/ref 17592186074728}} {:db/id #edb/ref 17592186074727 :step/content {:db/id #edb/ref 17592186075012 :tutorial/content "Recall that the product rule for radicals states that\n\n$$\n\\sqrt{a\\cdot b} = \\sqrt{a}\\cdot \\sqrt{b}\n$$\n\nwhere $a$ and $b$ are nonnegative numbers.\n\nWe can use the product rule for radicals to simplify some expressions. Let's see an example." :tutorial/id #uuid "4af2af2e-0f81-5094-adf6-2ede72a493d2" :tutorial/math-academy-id 5995 :tutorial/title "The Product Rule for Radicals"} :step/id #uuid "d050b8f3-0cc1-593c-8200-076f5b4f824f" :step/math-academy-id 36619 :step/next {:db/id #edb/ref 17592186074726}} {:db/id #edb/ref 17592186074728 :step/content {:db/id #edb/ref 17592186075013 :tutorial/content "We can simplify cube root expressions in the same way as with square roots.\n\nFor example, consider the following expression:\n\n$$\n4\\sqrt[3]2 - 6\\sqrt[3] 2\n$$\n\nWe can simplify our expression by combining the two radicals, as follows:\n\n$$\n\\begin{aligned}\n4\\sqrt[3]{2} - 6\\sqrt[3]{2} &=  \\\\\n(4 - 6)\\sqrt[3]{2} &=  \\\\\n&= - 2\\sqrt[3]{2}\n\\end{aligned}\n$$\n\nAs with square roots, we *cannot* combine terms when the numbers under the radical are different. For example, the expression\n\n$$\n3\\sqrt[3] 2 + \\sqrt[3] 5\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt[3] 2$ and $\\sqrt[3] 5$.\n\nFinally, it is not possible to combine square root and cube root terms -- not even if the numbers under the radical symbol are the same! For example, the expression\n\n$$\n4\\sqrt 2 + \\sqrt[3] 2\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt 2$ and $\\sqrt[3] 2$." :tutorial/id #uuid "32078f96-6eaf-57d2-bc71-8af8495d5d6f" :tutorial/math-academy-id 5996 :tutorial/title "Simplifying Expressions With Cube Roots"} :step/id #uuid "f9fded71-c2d5-5d66-9f13-5b0253efd6ff" :step/math-academy-id 36620 :step/next {:db/id #edb/ref 17592186074725}} {:db/id #edb/ref 17592186074751 :step/content {:db/id #edb/ref 17592186074948 :tutorial/content "When dealing with sums of square roots, we can combine any terms with the same number under the square root symbol $\\sqrt{\\phantom 0}$.\n\nFor example, consider the following expression:\n\n$$\n2\\sqrt 5 + 4\\sqrt 5\n$$\n\nRemember that $2\\sqrt 5$ and $4\\sqrt 5$ mean $2\\cdot\\sqrt 5$ and $4\\cdot\\sqrt 5$, respectively.\n\nWe can simplify our expression by combining the two radicals, as follows:\n\n$$\n\\begin{aligned}\n2\\sqrt{5} + 4\\sqrt{5} &=  \\\\\n(2 + 4)\\sqrt{5} &=  \\\\\n&= 6\\sqrt{5}\n\\end{aligned}\n$$\n\nSimilarly,\n\n$$\n\\begin{aligned}\n2\\sqrt{7} - \\sqrt{7} &=  \\\\\n2\\sqrt{7} - 1 \\cdot \\sqrt{7} &=  \\\\\n(2 - 1)\\sqrt{7} &=  \\\\\n1 \\cdot \\sqrt{7} &=  \\\\\n&= \\sqrt{7}\n\\end{aligned}\n$$\n\nHowever, we *cannot* combine terms when the numbers under the radical are different. For example, the expression\n\n$$\n2\\sqrt 3 + \\sqrt 5\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt 3$ and $\\sqrt 5$." :tutorial/id #uuid "9aa49408-30d5-57b5-8dff-ec1744f9fc6e" :tutorial/math-academy-id 1609 :tutorial/title "Introduction"} :step/id #uuid "38f3ace0-f394-598e-8dad-37fefda9d86e" :step/math-academy-id 4327 :step/next {:db/id #edb/ref 17592186074752}} {:db/id #edb/ref 17592186074752 :step/content {:db/id #edb/ref 17592186073806 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073464 :question/id #uuid "cf793c45-6c89-50c8-bb28-d066d2b8342a" :question/math-academy-id "e-1370"} :knowledge-point/id #uuid "2d8a8280-5248-57e4-a5ed-14e281f3db77" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050404}] :knowledge-point/questions [{:db/id #edb/ref 17592186074147} {:db/id #edb/ref 17592186074186}] :knowledge-point/title "Simplifying Square Root Expressions"} :step/id #uuid "459089fc-d278-5487-bc0b-e4cd6237c142" :step/math-academy-id 4328 :step/next {:db/id #edb/ref 17592186074727}}] :activity/title "Adding and Subtracting Radicals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073921}]}
