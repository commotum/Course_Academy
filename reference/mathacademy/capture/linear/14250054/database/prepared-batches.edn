-852b-c929575d9d27" :answer/id #uuid "be71877f-860f-5d7d-852b-c929575d9d27" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-0bfa5d02-e4eb-518c-a47d-3cd19a41adbc" :answer/id #uuid "0bfa5d02-e4eb-518c-a47d-3cd19a41adbc" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-cd50ebd5-d88b-5455-b76f-14f6d0b51105" :answer/id #uuid "cd50ebd5-d88b-5455-b76f-14f6d0b51105" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id 17592186060429 :question/problem "$\\operatorname{csc}⁡{225}^{∘}=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/d9/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\nFrom the unit circle, we see that the angle ${225}^{∘}$ corresponds to the point $(-\\frac{\\sqrt{2}}{2},-\\frac{\\sqrt{2}}{2}).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡{225}^{∘}=-\\frac{\\sqrt{2}}{2}.$\n\nTherefore, using the fact that $\\operatorname{csc}⁡\\theta =\\frac{1}{\\operatorname{sin}⁡\\theta },$ we have\n\n$$\n\\operatorname{csc}⁡{225}^{∘}=\\frac{1}{\\operatorname{sin}⁡{225}^{∘}}=-\\frac{2}{\\sqrt{2}}=-\\sqrt{2}.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186059196 :answer-field/correct 17592186059200 :db/ensure [:answer-field/validate]} {:db/id "question-d25800d2-aaa9-5069-8bc6-84b04968eef5" :question/id #uuid "d25800d2-aaa9-5069-8bc6-84b04968eef5" :question/math-academy-id "q-1696" :question/problem "$\\operatorname{sec}⁡(\\frac{7\\pi }{6})=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{7\\pi }{6}$ corresponds to the point $(-\\frac{\\sqrt{3}}{2},-\\frac{1}{2}).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}⁡(\\frac{7\\pi }{6})=-\\frac{\\sqrt{3}}{2}.$\n\nTherefore, using the fact that $\\operatorname{sec}⁡\\theta =\\frac{1}{\\operatorname{cos}⁡\\theta },$ we have\n\n$$\n\\operatorname{sec}⁡(\\frac{7\\pi }{6})=\\frac{1}{\\operatorname{cos}⁡(\\frac{7\\pi }{6})}=-\\frac{2}{\\sqrt{3}}=-\\frac{2\\sqrt{3}}{3}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9ad166a8-68f6-52e5-aeab-c9f3b40cf4fa"] :db/ensure [:question/validate]} {:db/id "answer-field-9ad166a8-68f6-52e5-aeab-c9f3b40cf4fa" :answer-field/id #uuid "9ad166a8-68f6-52e5-aeab-c9f3b40cf4fa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dbf553dd-432a-5db7-9330-1fe86b00d67e" :answer-field/choices ["answer-da706140-bf28-56bb-9b3d-9c80fbbb5352" "answer-dbf553dd-432a-5db7-9330-1fe86b00d67e" "answer-f93b95d6-53f4-5c55-b1c0-20f5b8ed7c69" "answer-b2225633-3982-500e-aceb-598ad2c9dd69" "answer-d59e1f90-02b8-5b16-90e7-10a8e98457fb"] :db/ensure [:answer-field/validate]} {:db/id "answer-da706140-bf28-56bb-9b3d-9c80fbbb5352" :answer/id #uuid "da706140-bf28-56bb-9b3d-9c80fbbb5352" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-dbf553dd-432a-5db7-9330-1fe86b00d67e" :answer/id #uuid "dbf553dd-432a-5db7-9330-1fe86b00d67e" :answer/type :answer.type/math :answer/value "-\\frac{2\\sqrt{3}}{3}" :db/ensure [:answer/validate]} {:db/id "answer-f93b95d6-53f4-5c55-b1c0-20f5b8ed7c69" :answer/id #uuid "f93b95d6-53f4-5c55-b1c0-20f5b8ed7c69" :answer/type :answer.type/math :answer/value "-\\frac{2}{\\sqrt{2}}" :db/ensure [:answer/validate]} {:db/id "answer-b2225633-3982-500e-aceb-598ad2c9dd69" :answer/id #uuid "b2225633-3982-500e-aceb-598ad2c9dd69" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}}{3}" :db/ensure [:answer/validate]} {:db/id "answer-d59e1f90-02b8-5b16-90e7-10a8e98457fb" :answer/id #uuid "d59e1f90-02b8-5b16-90e7-10a8e98457fb" :answer/type :answer.type/math :answer/value "\\frac{2}{\\sqrt{3}}" :db/ensure [:answer/validate]} {:db/id 17592186060340 :question/problem "$\\operatorname{cot}⁡(\\frac{\\pi }{3})=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{\\pi }{3}$ corresponds to the point $(\\frac{1}{2},\\frac{\\sqrt{3}}{2}).$\n\n- Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}⁡(\\frac{\\pi }{3})=\\frac{1}{2}.$\n\n- Since the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡(\\frac{\\pi }{3})=\\frac{\\sqrt{3}}{2}.$\n\nTherefore, using the fact that $\\operatorname{cot}⁡\\theta =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta },$ we have\n\n$$\n\\operatorname{cot}⁡(\\frac{\\pi }{3})=\\frac{\\operatorname{cos}⁡(\\frac{\\pi }{3})}{\\operatorname{sin}⁡(\\frac{\\pi }{3})}=\\frac{(\\frac{1}{2})}{(\\frac{\\sqrt{3}}{2})}=\\frac{1}{\\sqrt{3}}.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186058662 :answer-field/correct 17592186058667 :db/ensure [:answer-field/validate]} {:db/id 17592186233324 :question/problem "$\\operatorname{tan}⁡(\\frac{\\pi }{3})=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{\\pi }{3}$ corresponds to the point $(\\frac{1}{2},\\frac{\\sqrt{3}}{2}).$\n\n- Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}⁡(\\frac{\\pi }{3})=\\frac{1}{2}.$\n\n- Since the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡(\\frac{\\pi }{3})=\\frac{\\sqrt{3}}{2}.$\n\nTherefore, using the fact that $\\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta },$ we have\n\n$$\n\\operatorname{tan}⁡(\\frac{\\pi }{3})=\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{3})}{\\operatorname{cos}⁡(\\frac{\\pi }{3})}=\\frac{(\\frac{\\sqrt{3}}{2})}{(\\frac{1}{2})}=\\sqrt{3}.\n$$" :question/answer-fields ["answer-field-d6728fbb-2118-5ddf-8d01-55cf6e89cf7f"] :db/ensure [:question/validate]} {:db/id "answer-field-d6728fbb-2118-5ddf-8d01-55cf6e89cf7f" :answer-field/id #uuid "d6728fbb-2118-5ddf-8d01-55cf6e89cf7f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0e12fabf-6c9d-52dc-8004-2e768bf88fe6" :answer-field/choices ["answer-0318f6ea-db45-593b-8c73-46416662ffdb" "answer-bf50eb0f-9ced-5cef-a4e9-c0277bfbc7de" "answer-7eaca82c-db20-5028-b486-75c6d54f44c6" "answer-77dbc120-eb29-5d5f-841f-c63ff2bb4c02" "answer-0e12fabf-6c9d-52dc-8004-2e768bf88fe6"] :db/ensure [:answer-field/validate]} {:db/id "answer-0318f6ea-db45-593b-8c73-46416662ffdb" :answer/id #uuid "0318f6ea-db45-593b-8c73-46416662ffdb" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-bf50eb0f-9ced-5cef-a4e9-c0277bfbc7de" :answer/id #uuid "bf50eb0f-9ced-5cef-a4e9-c0277bfbc7de" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-7eaca82c-db20-5028-b486-75c6d54f44c6" :answer/id #uuid "7eaca82c-db20-5028-b486-75c6d54f44c6" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{3}}" :db/ensure [:answer/validate]} {:db/id "answer-77dbc120-eb29-5d5f-841f-c63ff2bb4c02" :answer/id #uuid "77dbc120-eb29-5d5f-841f-c63ff2bb4c02" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-0e12fabf-6c9d-52dc-8004-2e768bf88fe6" :answer/id #uuid "0e12fabf-6c9d-52dc-8004-2e768bf88fe6" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id 17592186060977 :tutorial/content "The unit circle provides a convenient way to represent the sine and cosine of special angles in each quadrant. \n\nWe first recall the following:\n\n- The ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg)-coordinate of any point on the unit circle equals the *cosine* of the corresponding central angle, and\n\n- the ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-coordinate equals the *sine* of the corresponding central angle.\n\nLet's use the unit circle to list the special values of sine and cosine, starting with the first quadrant. First, we mark off the special angles in this quadrant.\n\n![](images/3a/3a0c6eb5bc286272ef67aee5ef0fa625a6f4e44635413ca43060efc9082b1848.png)\n\nNow, let's write down each point's ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg)- and ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-coordinates, corresponding to the cosine and sine of each point's central angle. In addition, we'll highlight the ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-coordinate at each point.\n\n![](images/6b/6bb6bb7cc95a17c605056e1e1e1ae27bc8cf2f124e419c5e6b9810a72b950508.png)\n\nBefore we move on, observe that if we rotate counterclockwise from the positive ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg)-axis, we see that the ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-coordinates at the special angles are given by the following sequence:\n![](images/ef/ef3998f9651e37dba31e1597a503577243def17e903dbeb5322ab434a4815b3c.svg) \n\nas shown below.\n\n![](images/ae/ae75322c270db13d7ee5ba6079b236b9a18d463f74cc3e5ee70b6fe113d224e3.png)\n\nThere is a similar pattern for the ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg)-coordinates (corresponding to the cosine of the central angle). The only difference is that now we go in reverse, from ![](images/26/2614c435bff188ded3027f2a8f1ea011b37b41a1d62d2ff4bae181ce9107b5c2.svg) to ![](images/f1/f12b2ec86446e22fc9d1c982c156c7d089a97fecca1670f416ecfd63cf5899d3.svg) as shown below \n\n![](images/2a/2af7f2c7cf14c017a545a4144ed88dffe7b7f7bfb6e13a2b6144552ef3cfaa6c.png)\n\nTake a moment to ensure you can reproduce this diagram on your own without looking. We'll add to it shortly." :db/ensure [:tutorial/validate]} {:db/id 17592186060978 :tutorial/content "So, we know how the unit circle can be used to list the cosine and sine of the special angles in the *first* quadrant. But what about the other quadrants? \n\nThe values in the remaining quadrants can be obtained from the coordinates in the first quadrant. Let's see how:\n\n- To obtain the points in the *second* quadrant, let's first mark off the special angles in this quadrant. These angles have the same reference angles as the angles in the first quadrant:\n\n- $180^\\circ - 30^\\circ = 150^\\circ$\n\n- $180^\\circ - 45^\\circ = 135^\\circ$\n\n- $180^\\circ - 60^\\circ = 120^\\circ$\n\nWe mark these angles below and include the quadrantal angle $180^\\circ.$\n\n![](images/49/49105a62c4eecffeb32f6777ddf98022c5ca46079a33294e7eeafc9164444cba.png)\n\nNow, we reflect the coordinates in the first quadrant in the $y$-axis. This changes the sign of the $x$-coordinate at each point and leaves the $y$-coordinate unchanged.\n\n![](images/e4/e44980d06903b6570182b99787ca7dec8cceacab2f72dce04fc48b3d7c660059.png)\n\n- To obtain the points in the third quadrant, we first find the special angles in this quadrant. Again, these angles have the same reference angles as the special angles in the first quadrant:\n\n- $180^\\circ + 30^\\circ = 210^\\circ$\n\n- $180^\\circ + 45^\\circ = 225^\\circ$\n\n- $180^\\circ + 60^\\circ = 240^\\circ$\n\nThen, we take the points in the second quadrant and reflect them in the $x$-axis. This changes the sign of the $y$-coordinate at each point and leaves the $x$-coordinate unchanged.\n\n![](images/bb/bbfcf14e39ee122cf1bd7048903ac7f205325c77d4b2899c53619495ffeb8d8c.png)\n\n- Finally, to obtain the points in the fourth quadrant, we first compute the special angles in this quadrant:\n\n- $360^\\circ - 30^\\circ = 330^\\circ$\n\n- $360^\\circ - 45^\\circ = 315^\\circ$\n\n- $360^\\circ - 60^\\circ = 300^\\circ$\n\nThen, we take the points in the first quadrant and reflect them in the $x$-axis. This changes the sign of the $y$-coordinate at each point and leaves the $x$-coordinate unchanged.\n\n![](images/f5/f507964e8fe06cc54ceab447d570bb004b4e9a2b0b8fa3074762e28a41009a2a.png)\n\nTherefore, our complete unit circle is as follows.\n\n![](images/f5/f5006a5a3c363f83e6d4624fc72fefa140e29ef6ef23db16fbab5538b421a058.png)\n\nTake a moment to ensure you can create this diagram yourself without looking. We'll be referring to it often!" :db/ensure [:tutorial/validate]} {:db/id 17592186059943 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]}] "assertions" [[17592186059399 :question/problem "What is the value of $\\cos 225^\\circ?$"] [17592186059399 :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/d9/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\nFrom the unit circle, we see that the angle $225^\\circ$ corresponds to the point $\\left( -\\dfrac{\\sqrt{2}}{2}, -\\dfrac{\\sqrt{2}}{2} \\right).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $\\cos 225^\\circ  = -\\dfrac{\\sqrt{2}}{2}.$"] [17592186059400 :question/problem "What is the value of $\\sin \\left(\\dfrac {7\\pi} 4\\right)?$"] [17592186059400 :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\dfrac{7\\pi}{4}$ corresponds to the point $\\left( \\dfrac{\\sqrt{2}}{2}, -\\dfrac{\\sqrt{2}}{2} \\right).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\sin \\left(\\dfrac {7\\pi} 4\\right)  = -\\dfrac {\\sqrt 2} 2.$"] [17592186059401 :question/problem "Find the value of $\\csc 120^\\circ.$"] [17592186059401 :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/d9/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\nFrom the unit circle, we see that the angle $120^\\circ$ corresponds to the point $\\left( -\\dfrac{1}{2}, \\dfrac{\\sqrt{3}}{2} \\right).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\sin 120^\\circ= \\dfrac{\\sqrt 3}{2}.$\n\nTherefore, using the fact that $\\csc{\\theta} = \\dfrac{1}{\\sin\\theta},$ we have\n\n$$\n\\csc 120^\\circ = \\dfrac{1}{\\sin 120^\\circ } = \\dfrac{2}{\\sqrt 3} = \\dfrac{2\\sqrt 3}{3}.\n$$"] [17592186059402 :question/problem "Find the value of $\\tan \\left(\\dfrac {4 \\pi} 3\\right).$"] [17592186059402 :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\dfrac{4\\pi}{3}$ corresponds to the point $\\left( -\\dfrac{1}{2}, -\\dfrac{\\sqrt{3}}{2} \\right).$\n\n- Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\cos\\left( \\dfrac {4\\pi} {3}\\right)  = -\\dfrac 1 2.$\n\n- Since the sine of the angle corresponds to the $y$-coordinate, we have $\\sin\\left( \\dfrac {4\\pi} {3}\\right)  = -\\dfrac {\\sqrt 3} 2.$\n\nTherefore, using the fact that $\\tan{\\theta} = \\dfrac{\\sin\\theta}{\\cos\\theta},$ we have\n\n$$\n\\tan\\left(\\dfrac{4\\pi}{3}\\right)  = \\dfrac{\\sin{\\left(\\dfrac{4\\pi}{3}\\right) }}{\\cos{\\left(\\dfrac{4\\pi}{3}\\right) }} = \\dfrac{\\left(-\\dfrac {\\sqrt 3} 2\\right)}{\\left(-\\dfrac 1 2\\right)} = \\sqrt{3}.\n$$"] [17592186233307 :question/problem "$\\operatorname{sin}⁡{210}^{∘}=$"] [17592186233307 :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/d9/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\nFrom the unit circle, we see that the angle ${210}^{∘}$ corresponds to the point $(-\\frac{\\sqrt{3}}{2},-\\frac{1}{2}).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡{210}^{∘}=-\\frac{1}{2}.$"] ["answer-field-dcc95cae-2a41-5292-8333-6c71877ee9b8" :answer-field/id #uuid "dcc95cae-2a41-5292-8333-6c71877ee9b8"] ["answer-6f15e5df-c04e-5387-8967-9ef24d2b5564" :answer/id #uuid "6f15e5df-c04e-5387-8967-9ef24d2b5564"] ["answer-6f15e5df-c04e-5387-8967-9ef24d2b5564" :answer/type :answer.type/math] ["answer-6f15e5df-c04e-5387-8967-9ef24d2b5564" :answer/value "-\\frac{1}{2}"] ["answer-94e173d4-a33d-579b-918a-c205ed8ceb06" :answer/id #uuid "94e173d4-a33d-579b-918a-c205ed8ceb06"] ["answer-94e173d4-a33d-579b-918a-c205ed8ceb06" :answer/type :answer.type/math] ["answer-94e173d4-a33d-579b-918a-c205ed8ceb06" :answer/value "-\\frac{\\sqrt{3}}{2}"] ["answer-e621f025-9b39-5453-a07b-7ce0adbcc585" :answer/id #uuid "e621f025-9b39-5453-a07b-7ce0adbcc585"] ["answer-e621f025-9b39-5453-a07b-7ce0adbcc585" :answer/type :answer.type/math] ["answer-e621f025-9b39-5453-a07b-7ce0adbcc585" :answer/value "\\frac{1}{2}"] ["answer-b9878a3e-b0e9-50aa-b40c-a9ca56e85f59" :answer/id #uuid "b9878a3e-b0e9-50aa-b40c-a9ca56e85f59"] ["answer-b9878a3e-b0e9-50aa-b40c-a9ca56e85f59" :answer/type :answer.type/math] ["answer-b9878a3e-b0e9-50aa-b40c-a9ca56e85f59" :answer/value "\\frac{\\sqrt{2}}{2}"] ["answer-c372e4ce-1412-5124-ab09-93c