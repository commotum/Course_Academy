#{[{:db/id #edb/ref 17592186059399 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059843 :knowledge-point/id #uuid "6699397d-0014-5749-b439-4a8486990986" :knowledge-point/title "Finding the Sine or Cosine of a Special Angle Given in Degrees"}] :question/id #uuid "ce1e1013-987e-5c1e-82e6-a8524d8be168" :question/math-academy-id "e-12613" :question/problem "What is the value of $\\cos 225^\\circ$?" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/d9/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\nFrom the unit circle, we see that the angle $225^\\circ$ corresponds to the point\n\n$$\n\\left(-\\dfrac{\\sqrt{2}}{2}, -\\dfrac{\\sqrt{2}}{2} \\right)\n$$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have\n\n$$\n\\cos 225^\\circ = -\\dfrac{\\sqrt{2}}{2}\n$$"}] [{:db/id #edb/ref 17592186059400 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059844 :knowledge-point/id #uuid "f0052499-42ab-5818-a844-20eb099c3f7b" :knowledge-point/title "Finding the Sine or Cosine of a Special Angle Given in Radians"}] :question/id #uuid "dd543c7f-fb05-54a9-a9e3-3f7cb88940b9" :question/math-academy-id "e-12614" :question/problem "What is the value of $\\sin \\left(\\dfrac {7\\pi} 4\\right)$?" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle\n\n$$\n\\dfrac{7\\pi}{4}\n$$\n\ncorresponds to the point\n\n$$\n\\left(\\dfrac{\\sqrt{2}}{2}, -\\dfrac{\\sqrt{2}}{2} \\right)\n$$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have\n\n$$\n\\sin \\left(\\dfrac {7\\pi} 4\\right) = -\\dfrac {\\sqrt 2} 2\n$$"}] [{:db/id #edb/ref 17592186059401 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059845 :knowledge-point/id #uuid "ecd367ac-2a68-56d0-b553-85277a9c921d" :knowledge-point/title "Finding the Secant or Cosecant of a Special Angle"}] :question/id #uuid "179c218a-924a-57a6-93fd-44899242412f" :question/math-academy-id "e-12615" :question/problem "Find the value of $\\csc 120^\\circ$." :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/d9/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\nFrom the unit circle, we see that the angle $120^\\circ$ corresponds to the point\n\n$$\n\\left(-\\dfrac{1}{2}, \\dfrac{\\sqrt{3}}{2} \\right)\n$$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have\n\n$$\n\\sin 120^\\circ= \\dfrac{\\sqrt 3}{2}\n$$\n\nTherefore, using the fact that\n\n$$\n\\csc{\\theta} = \\dfrac{1}{\\sin\\theta}\n$$\n\nwe have\n\n$$\n\\csc 120^\\circ = \\dfrac{1}{\\sin 120^\\circ} = \\dfrac{2}{\\sqrt 3} = \\dfrac{2\\sqrt 3}{3}\n$$"}] [{:db/id #edb/ref 17592186059402 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059846 :knowledge-point/id #uuid "405ff4a2-8cfb-5459-9be7-2d308c82d026" :knowledge-point/title "Finding the Tangent or Cotangent of a Special Angle"}] :question/id #uuid "41928771-a3e4-54fb-9237-e60191f215c1" :question/math-academy-id "e-12616" :question/problem "Find the value of $\\tan \\left(\\dfrac {4 \\pi} 3\\right)$." :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle\n\n$$\n\\dfrac{4\\pi}{3}\n$$\n\ncorresponds to the point\n\n$$\n\\left(-\\dfrac{1}{2}, -\\dfrac{\\sqrt{3}}{2} \\right)\n$$\n\n- Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\cos\\left(\\dfrac {4\\pi} {3}\\right) = -\\dfrac 1 2$.\n- Since the sine of the angle corresponds to the $y$-coordinate, we have $\\sin\\left(\\dfrac {4\\pi} {3}\\right) = -\\dfrac {\\sqrt 3} 2$.\n\nTherefore, using the fact that\n\n$$\n\\tan{\\theta} = \\dfrac{\\sin\\theta}{\\cos\\theta}\n$$\n\nwe have\n\n$$\n\\tan\\left(\\dfrac{4\\pi}{3}\\right) = \\dfrac{\\sin{\\left(\\dfrac{4\\pi}{3}\\right)}}{\\cos{\\left(\\dfrac{4\\pi}{3}\\right)}} = \\dfrac{\\left(-\\dfrac {\\sqrt 3} 2\\right)}{\\left(-\\dfrac 1 2\\right)} = \\sqrt{3}\n$$"}] [{:db/id #edb/ref 17592186570015 :knowledge-point/_questions [{:db/id #edb/ref 17592186059843 :knowledge-point/id #uuid "6699397d-0014-5749-b439-4a8486990986" :knowledge-point/title "Finding the Sine or Cosine of a Special Angle Given in Degrees"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dc11e74-5683-5e8d-80d8-76b11e1ef5b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186569486} {:answer/id #uuid "243136ce-4a0a-57c9-a550-54229f41104f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186569495} {:answer/id #uuid "95626cd5-58bf-5b05-9d17-272dc4d286b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186569679} {:answer/id #uuid "bb36dd47-9d34-5a02-9fba-9e0b0e7b2af1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186569743} {:answer/id #uuid "d22384f1-7ee3-57c8-b472-368fa995344e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186569773}] :answer-field/correct {:answer/id #uuid "d22384f1-7ee3-57c8-b472-368fa995344e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186569773} :answer-field/id #uuid "8fd4e1c0-3680-5d3a-9d0f-c3d351751bcd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569899}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a462c56c-120f-5159-b0b8-404f14801fe3" :question/math-academy-id "q-123595" :question/problem "$\\operatorname{sin}⁡{45}^{∘}=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/d9/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\nFrom the unit circle, we see that the angle ${45}^{∘}$ corresponds to the point $(\\frac{\\sqrt{2}}{2},\\frac{\\sqrt{2}}{2}).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡{45}^{∘}=\\frac{\\sqrt{2}}{2}.$"}] [{:db/id #edb/ref 17592186233307 :knowledge-point/_questions [{:db/id #edb/ref 17592186059843 :knowledge-point/id #uuid "6699397d-0014-5749-b439-4a8486990986" :knowledge-point/title "Finding the Sine or Cosine of a Special Angle Given in Degrees"}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c4fe9757-2d60-5e00-a868-aa48063d0b65" :question/math-academy-id "q-123598" :question/problem "$\\operatorname{sin}{210}^{∘}=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/d9/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\nFrom the unit circle, we see that the angle ${210}^{∘}$ corresponds to the point $(-\\frac{\\sqrt{3}}{2},-\\frac{1}{2}).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}{210}^{∘}=-\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186233313 :knowledge-point/_questions [{:db/id #edb/ref 17592186059844 :knowledge-point/id #uuid "f0052499-42ab-5818-a844-20eb099c3f7b" :knowledge-point/title "Finding the Sine or Cosine of a Special Angle Given in Radians"}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "84a0eb74-4e3b-5b80-807e-ccf4f3502fe5" :question/math-academy-id "q-123608" :question/problem "$\\operatorname{cos}(\\frac{7\\pi }{6})=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{7\\pi }{6}$ corresponds to the point $(-\\frac{\\sqrt{3}}{2},-\\frac{1}{2}).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}(\\frac{7\\pi }{6})=-\\frac{\\sqrt{3}}{2}.$"}] [{:db/id #edb/ref 17592186233324 :knowledge-point/_questions [{:db/id #edb/ref 17592186059846 :knowledge-point/id #uuid "405ff4a2-8cfb-5459-9be7-2d308c82d026" :knowledge-point/title "Finding the Tangent or Cotangent of a Special Angle"}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2d02f521-e8ed-522a-a329-1f6d01f412b9" :question/math-academy-id "q-123638" :question/problem "$\\operatorname{tan}(\\frac{\\pi }{3})=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{\\pi }{3}$ corresponds to the point $(\\frac{1}{2},\\frac{\\sqrt{3}}{2}).$\n\n- Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}(\\frac{\\pi }{3})=\\frac{1}{2}.$\n\n- Since the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}(\\frac{\\pi }{3})=\\frac{\\sqrt{3}}{2}.$\n\nTherefore, using the fact that $\\operatorname{tan}\\theta =\\frac{\\operatorname{sin}\\theta }{\\operatorname{cos}\\theta },$ we have\n\n$$\n\\operatorname{tan}(\\frac{\\pi }{3})=\\frac{\\operatorname{sin}(\\frac{\\pi }{3})}{\\operatorname{cos}(\\frac{\\pi }{3})}=\\frac{(\\frac{\\sqrt{3}}{2})}{(\\frac{1}{2})}=\\sqrt{3}.\n$$"}] [{:db/id #edb/ref 17592186570027 :knowledge-point/_questions [{:db/id #edb/ref 17592186059845 :knowledge-point/id #uuid "ecd367ac-2a68-56d0-b553-85277a9c921d" :knowledge-point/title "Finding the Secant or Cosecant of a Special Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2225633-3982-500e-aceb-598ad2c9dd69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186569723} {:answer/id #uuid "d59e1f90-02b8-5b16-90e7-10a8e98457fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{3}}" :db/id #edb/ref 17592186569778} {:answer/id #uuid "da706140-bf28-56bb-9b3d-9c80fbbb5352" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186569787} {:answer/id #uuid "dbf553dd-432a-5db7-9330-1fe86b00d67e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2\\sqrt{3}}{3}" :db/id #edb/ref 17592186569790} {:answer/id #uuid "f93b95d6-53f4-5c55-b1c0-20f5b8ed7c69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{\\sqrt{2}}" :db/id #edb/ref 17592186569832}] :answer-field/correct {:answer/id #uuid "dbf553dd-432a-5db7-9330-1fe86b00d67e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2\\sqrt{3}}{3}" :db/id #edb/ref 17592186569790} :answer-field/id #uuid "9ad166a8-68f6-52e5-aeab-c9f3b40cf4fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569905}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d25800d2-aaa9-5069-8bc6-84b04968eef5" :question/math-academy-id "q-1696" :question/problem "$\\operatorname{sec}⁡(\\frac{7\\pi }{6})=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{7\\pi }{6}$ corresponds to the point $(-\\frac{\\sqrt{3}}{2},-\\frac{1}{2}).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}⁡(\\frac{7\\pi }{6})=-\\frac{\\sqrt{3}}{2}.$\n\nTherefore, using the fact that $\\operatorname{sec}⁡\\theta =\\frac{1}{\\operatorname{cos}⁡\\theta },$ we have\n\n$$\n\\operatorname{sec}⁡(\\frac{7\\pi }{6})=\\frac{1}{\\operatorname{cos}⁡(\\frac{7\\pi }{6})}=-\\frac{2}{\\sqrt{3}}=-\\frac{2\\sqrt{3}}{3}.\n$$"}] [{:db/id #edb/ref 17592186234174 :knowledge-point/_questions [{:db/id #edb/ref 17592186059844 :knowledge-point/id #uuid "f0052499-42ab-5818-a844-20eb099c3f7b" :knowledge-point/title "Finding the Sine or Cosine of a Special Angle Given in Radians"}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "52fdb8a8-7b9e-5f48-95b6-5c145626cfac" :question/math-academy-id "q-64929" :question/problem "$\\operatorname{sin}(\\frac{11\\pi }{6})=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/a3/a33ea7c6d1aa7cd7e54376aefb2af4347da59a61ecaabdbf4964d41b9661870a.png)\n\nFrom the unit circle, we see that the angle $\\frac{11\\pi }{6}$ corresponds to the point $(\\frac{\\sqrt{3}}{2},-\\frac{1}{2}).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}(\\frac{11\\pi }{6})=-\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186060340 :knowledge-point/_questions [{:db/id #edb/ref 17592186059846 :knowledge-point/id #uuid "405ff4a2-8cfb-5459-9be7-2d308c82d026" :knowledge-point/title "Finding the Tangent or Cotangent of a Special Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87866b24-07e8-5c44-a12b-706f576b7759" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186058663} {:answer/id #uuid "8ac33c7c-6b5c-5f78-bfd0-0d8e877675b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186058664} {:answer/id #uuid "f2a64bd9-1440-5b69-a410-350315353536" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186058665} {:answer/id #uuid "06e13c81-4b82-5c33-8d2a-a5adf4317e74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186058666} {:answer/id #uuid "16ae3e71-8453-5c89-8364-c44cca6db837" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186058667}] :answer-field/id #uuid "7986210b-cc64-52a9-869e-7ea2e31df092" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058662}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3ae845d5-9238-5eb9-b150-eab184b11552" :question/math-academy-id "q-64945" :question/problem "What is $\\cot (\\frac{π}{3})$?"}] [{:db/id #edb/ref 17592186060429 :knowledge-point/_questions [{:db/id #edb/ref 17592186059845 :knowledge-point/id #uuid "ecd367ac-2a68-56d0-b553-85277a9c921d" :knowledge-point/title "Finding the Secant or Cosecant of a Special Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ceb99233-29bb-53c6-9cf6-bcbdb792c073" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186059197} {:answer/id #uuid "e1