#{[{:db/id #edb/ref 17592186111135 :knowledge-point/_questions [{:db/id #edb/ref 17592186110720 :knowledge-point/id #uuid "c6cd2f04-e0d5-5df0-8e74-ea737501cdf8" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14a449b2-0875-581b-a2ec-8813a227c1de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186295383} {:answer/id #uuid "2d6f283f-3592-5248-baf7-ca782b7d8c9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186295530} {:answer/id #uuid "4009ef03-e229-5324-9dbd-214305b60cd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186295633} {:answer/id #uuid "4dfca85a-c698-5e36-ba67-02a55f783f85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186295715} {:answer/id #uuid "d199324f-9733-59f2-82cf-8e4f45ae01ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186296371}] :answer-field/correct {:answer/id #uuid "14a449b2-0875-581b-a2ec-8813a227c1de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186295383} :answer-field/id #uuid "1739b830-13d4-586f-9761-4372557e83e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296679}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "435ae769-5577-5924-a2b3-9f23f7e0ccc8" :question/math-academy-id "q-287971" :question/problem "Consider the equation\n\n$$\n(p-3)x=4x\n$$\n\nwhere $p$ is a constant. Given that this equation has infinitely many solutions, what is the value of $p?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=bx\n$$\n\nwhere $a$ and $b$ are constants. If $a=b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax=bx.$ In this case, \n\n$$\na=p-3,\\,b=4.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\np-3=4.\n$$\n\nSolving this for $p,$ we get\n\n$$\np=7.\n$$"}] [{:db/id #edb/ref 17592186297195 :knowledge-point/_questions [{:db/id #edb/ref 17592186110721 :knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe4c39bf-4560-5825-a22a-76a5df230cbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186296621}] :answer-field/correct {:answer/id #uuid "fe4c39bf-4560-5825-a22a-76a5df230cbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186296621} :answer-field/id #uuid "58355121-2d5d-5aa8-91c2-79f41befa005" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296811}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c1e37e75-7d0c-5923-8a40-5f706dc21da1" :question/math-academy-id "q-288584" :question/problem "Consider the equation\n\n$$\n(-s+3)x+2t=x+6\n$$\n\nwhere $s$ and $t$ are constants. Given that this equation has infinitely many solutions, what is the value of $s+t?$\n\n$s+t=$\n{{field-1}}" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $s$ and $t$ such that the equation\n\n$$\n(-s+3)x+2t=x+6\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\n-s+3=1.\n$$\n\nSolving this equation for $s,$ we get\n\n$$\ns=2.\n$$\n\n- Equating the constants, we have\n\n$$\n2t=6.\n$$\n\nSolving this equation for $t,$ we get\n\n$$\nt=3.\n$$\n\nFinally, since $s=2$ and $t=3,$ we have\n\n$$\ns+t=2+3=5.\n$$"}]}
