#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186549131} :activity/id #uuid "53e407aa-b874-5ab8-ad52-b6329fa3b408" :activity/scope {:db/id #edb/ref 17592186049310 :topic/id #uuid "eb6655db-68e9-5ef3-bf7a-81223e92dac0" :topic/math-academy-id 1414} :activity/steps [{:db/id #edb/ref 17592186549090 :step/content {:db/id #edb/ref 17592186297195 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe4c39bf-4560-5825-a22a-76a5df230cbf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186296621}] :answer-field/correct {:db/id #edb/ref 17592186296621} :answer-field/id #uuid "58355121-2d5d-5aa8-91c2-79f41befa005" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186296811}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c1e37e75-7d0c-5923-8a40-5f706dc21da1" :question/math-academy-id "q-288584" :question/problem "Consider the equation\n\n$$\n(-s+3)x+2t=x+6\n$$\n\nwhere $s$ and $t$ are constants. Given that this equation has infinitely many solutions, what is the value of $s+t?$\n\n$s+t=$\n{{field-1}}" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $s$ and $t$ such that the equation\n\n$$\n(-s+3)x+2t=x+6\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\n-s+3=1.\n$$\n\nSolving this equation for $s,$ we get\n\n$$\ns=2.\n$$\n\n- Equating the constants, we have\n\n$$\n2t=6.\n$$\n\nSolving this equation for $t,$ we get\n\n$$\nt=3.\n$$\n\nFinally, since $s=2$ and $t=3,$ we have\n\n$$\ns+t=2+3=5.\n$$"} :step/id #uuid "3b9efce2-cc34-5966-9ee7-777169e666e6"} {:db/id #edb/ref 17592186549108 :step/content {:db/id #edb/ref 17592186549054 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eab2015-3700-56bf-ac92-fd0a94f661e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186548387} {:answer/id #uuid "598ab84f-b8ec-5739-8cb0-fcbd36abfb06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186548519} {:answer/id #uuid "96f6e7b6-efcd-5a03-89c8-76e8676edae9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186548648} {:answer/id #uuid "987b69a0-afb9-52c1-b363-d34b352bfb3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186548656} {:answer/id #uuid "f71c8c9c-cd96-5e6e-b046-0e4cdbb2a210" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186548847}] :answer-field/correct {:db/id #edb/ref 17592186548656} :answer-field/id #uuid "1e0b4382-89cc-5b45-b568-d6f0542bad8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186548879}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d6ec3c46-2316-5f98-be70-c232b5719be1" :question/math-academy-id "q-288560" :question/problem "Consider the equation\n\n$$\n(r-7)x=-x\n$$\n\nwhere $r$ is a constant. Given that this equation has infinitely many solutions, what is the value of $r?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=bx\n$$\n\nwhere $a$ and $b$ are constants. If $a=b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax=bx.$ In this case, \n\n$$\na=r-7,\\,b=-1.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\nr-7=-1.\n$$\n\nSolving this for $r,$ we get\n\n$$\nr=6.\n$$"} :step/id #uuid "70e3dbbc-f265-58ec-abc4-fa61aa670f9a" :step/next {:db/id #edb/ref 17592186549129}} {:db/id #edb/ref 17592186549129 :step/content {:db/id #edb/ref 17592186549009 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bc56c0e-abb3-5e53-818e-6aa51cc4af57" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186548439} {:answer/id #uuid "36c25fee-f58b-5409-a5a6-477628433eda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186548463} {:answer/id #uuid "5ade53e2-0afe-522f-a54b-d5db209e2043" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186548522} {:answer/id #uuid "6e3dbfdf-aa6d-5049-8e76-3fb7df01f4ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186548560} {:answer/id #uuid "7e1a1e15-d44d-54e8-a331-6ddc82706537" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186548595}] :answer-field/correct {:db/id #edb/ref 17592186548595} :answer-field/id #uuid "e27fc349-c24d-5039-a135-0c2dd2d434ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186548967}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "61992611-6e48-5a2e-9a4c-b280b994c51d" :question/math-academy-id "q-288561" :question/problem "Consider the equation\n\n$$\n(t+4)x=2x\n$$\n\nwhere $t$ is a constant. Given that this equation has infinitely many solutions, what is the value of $t?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=bx\n$$\n\nwhere $a$ and $b$ are constants. If $a=b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax=bx.$ In this case, \n\n$$\na=t+4,\\,b=2.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\nt+4=2.\n$$\n\nSolving this for $t,$ we get\n\n$$\nt=-2.\n$$"} :step/id #uuid "9c38efa4-70b9-572d-aabd-a33044024fc7" :step/next {:db/id #edb/ref 17592186549090}} {:db/id #edb/ref 17592186549131 :step/content {:db/id #edb/ref 17592186111135 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14a449b2-0875-581b-a2ec-8813a227c1de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186295383} {:answer/id #uuid "2d6f283f-3592-5248-baf7-ca782b7d8c9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186295530} {:answer/id #uuid "4009ef03-e229-5324-9dbd-214305b60cd3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186295633} {:answer/id #uuid "4dfca85a-c698-5e36-ba67-02a55f783f85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186295715} {:answer/id #uuid "d199324f-9733-59f2-82cf-8e4f45ae01ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186296371}] :answer-field/correct {:db/id #edb/ref 17592186295383} :answer-field/id #uuid "1739b830-13d4-586f-9761-4372557e83e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186296679}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "435ae769-5577-5924-a2b3-9f23f7e0ccc8" :question/math-academy-id "q-287971" :question/problem "Consider the equation\n\n$$\n(p-3)x=4x\n$$\n\nwhere $p$ is a constant. Given that this equation has infinitely many solutions, what is the value of $p?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=bx\n$$\n\nwhere $a$ and $b$ are constants. If $a=b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax=bx.$ In this case, \n\n$$\na=p-3,\\,b=4.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\np-3=4.\n$$\n\nSolving this for $p,$ we get\n\n$$\np=7.\n$$"} :step/id #uuid "a60530a2-2052-544d-a2a2-f6b827880aca" :step/next {:db/id #edb/ref 17592186549108}}] :activity/title "Linear Equations With Infinitely Many Solutions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186548342}]}
