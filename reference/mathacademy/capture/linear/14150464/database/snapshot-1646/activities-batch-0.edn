#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186065270} :activity/id #uuid "2b791225-d099-574f-a09c-f5e19fbcc668" :activity/scope {:db/id #edb/ref 17592186049626 :topic/id #uuid "066efed6-041e-5946-85d0-c8b308da2022" :topic/math-academy-id 297} :activity/steps [{:db/id #edb/ref 17592186065270 :step/content {:db/id #edb/ref 17592186065425 :tutorial/content "Subtracting a negative number is the same as adding a positive number. To remember this, just think that whenever you see a minus ($-$) sign followed by a negative ($-$) sign, they combine into a single plus $(+)$ sign, like so:\n![](images/54/54cf3d5630d0f6f43570b1c290019e92d035acaaac13b43ac40b7e3b093f988b.svg)\n\nA minus sign followed by a negative sign can be hard to make out, so it's considered better form to place parentheses around the negative number. For example, $9-(-4)$ is the same thing as $9 + 4.$ This gives\n\n$$\n\\begin{aligned}9\\,\\overset{+}{\\overset{⏞}{-\\,(-}}\\,4) & = \\\\ 9\\,+\\,4 & = \\\\ 13 & .\\end{aligned}\n$$\n\nSimilarly, \n\n$$\n\\eqalign{\n    \t\t- 16 -(-5) &= - 16 + 5.\n\t}\n$$\n\nTo compute the result of adding $5$ to $-16,$ we start at $-16$ and move $5$ places to the right:\n\n![](images/fa/fa636855c7ec14299ddcb750b21561799f2b76848d52ee492f0a868cd77bccf0.png)\n\n \n\nWhen we do this, we land at $-11$. Therefore, \n\n$$\n-16-(-5)=-16+5=-11.\n$$" :tutorial/id #uuid "2d792699-d4e9-5272-8abf-a14fdff5a6c7" :tutorial/math-academy-id 8280 :tutorial/title "Introduction"} :step/id #uuid "4366cd90-46a9-58c6-b3b3-808a95a3eb28" :step/math-academy-id 73985 :step/next {:db/id #edb/ref 17592186065271}} {:db/id #edb/ref 17592186065271 :step/content {:db/id #edb/ref 17592186064350 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063956 :question/id #uuid "18486b46-10bc-5e64-b1d9-df3ba0736b05" :question/math-academy-id "e-13262"} :knowledge-point/id #uuid "72f03bd5-4e2c-5d8c-9d08-129fb9949a3c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049429}] :knowledge-point/questions [{:db/id #edb/ref 17592186064466} {:db/id #edb/ref 17592186064575} {:db/id #edb/ref 17592186445720} {:db/id #edb/ref 17592186445723}] :knowledge-point/title "Subtracting a Negative Number From a Positive Number"} :step/id #uuid "4b7d8666-97bc-5c4c-b5c1-26f89205e202" :step/math-academy-id 73986 :step/next {:db/id #edb/ref 17592186065272}} {:db/id #edb/ref 17592186065272 :step/content {:db/id #edb/ref 17592186064351 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063957 :question/id #uuid "1c75cfa3-630e-5b37-82c0-ec421bb8c206" :question/math-academy-id "e-13263"} :knowledge-point/id #uuid "0ac4d4f6-ade4-59d0-a633-fac839543b23" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048546}] :knowledge-point/questions [{:db/id #edb/ref 17592186064548} {:db/id #edb/ref 17592186064922} {:db/id #edb/ref 17592186445721} {:db/id #edb/ref 17592186445722} {:db/id #edb/ref 17592186445724}] :knowledge-point/title "Subtracting a Negative Number From a Negative Number"} :step/id #uuid "730d0ad1-005d-58e9-bbc7-275738ac5661" :step/math-academy-id 73989 :step/next {:db/id #edb/ref 17592186065273}} {:db/id #edb/ref 17592186065273 :step/content {:db/id #edb/ref 17592186064352 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063958 :question/id #uuid "735b7c5c-68c6-51b9-b3c0-cc38a4e59e95" :question/math-academy-id "e-13264"} :knowledge-point/id #uuid "430390f1-fd74-564c-a8d6-3925ba8b1832" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048207}] :knowledge-point/questions [{:db/id #edb/ref 17592186064772} {:db/id #edb/ref 17592186064774} {:db/id #edb/ref 17592186445719} {:db/id #edb/ref 17592186445727}] :knowledge-point/title "Subtracting a Negative Decimal From a Number"} :step/id #uuid "00c19dde-49f5-517a-85e7-ad8edcdca57b" :step/math-academy-id 73992 :step/next {:db/id #edb/ref 17592186065274}} {:db/id #edb/ref 17592186065274 :step/content {:db/id #edb/ref 17592186064353 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063959 :question/id #uuid "347baa8c-4ba0-559a-a5b6-81e024054af6" :question/math-academy-id "e-13265"} :knowledge-point/id #uuid "801cc9bd-b65c-5a79-873b-ee4c5bffdc6e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050131}] :knowledge-point/questions [{:db/id #edb/ref 17592186064773} {:db/id #edb/ref 17592186064775} {:db/id #edb/ref 17592186445725} {:db/id #edb/ref 17592186445726}] :knowledge-point/title "Subtracting a Negative Fraction From a Fraction"} :step/id #uuid "3230ce8d-0539-5fec-ad7f-32838ba54ee8" :step/math-academy-id 73995 :step/next {:db/id #edb/ref 17592186065275}} {:db/id #edb/ref 17592186065275 :step/content {:db/id #edb/ref 17592186065426 :tutorial/content "Lastly, let's recap the rules for dealing with *pluses* and *minuses* if they follow each other:\n\n- $\\mathbf{\\color{blue}+} \\: (\\mathbf{\\color{red}-}) = \\mathbf{\\color{red}-} \\quad$ [ **plus** followed by **minus** becomes **minus** ]\n\n- $\\mathbf{\\color{red}-} \\: (\\mathbf{\\color{blue}+}) = \\mathbf{\\color{red}-} \\quad$ [ **minus** followed by **plus** becomes **minus** ]\n\n- $\\mathbf{\\color{blue}+} \\: (\\mathbf{\\color{blue}+}) = \\mathbf{\\color{blue}+} \\quad$ [ **plus** followed by **plus** becomes **plus** ]\n\n- $\\mathbf{\\color{red}-} \\: (\\mathbf{\\color{red}-}) = \\mathbf{\\color{blue}+} \\quad$ [ **minus** followed by **minus** becomes **plus** ]" :tutorial/id #uuid "2698ec2f-9136-5c28-ae55-d86994d0d377" :tutorial/math-academy-id 8281 :tutorial/title "Rules for Dealing with Pluses and Minuses"} :step/id #uuid "d9aa0646-15a4-5787-adca-46fa0833f19c" :step/math-academy-id 73998}] :activity/title "Subtracting a Negative Number" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064400}]}
