#{[{:db/id #edb/ref 17592186063956 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064350 :knowledge-point/id #uuid "72f03bd5-4e2c-5d8c-9d08-129fb9949a3c" :knowledge-point/title "Subtracting a Negative Number From a Positive Number"}] :question/id #uuid "18486b46-10bc-5e64-b1d9-df3ba0736b05" :question/math-academy-id "e-13262" :question/problem "Calculate the value of $0-(-6).$" :question/worked-solution "To subtract $-6$ from $0,$ we combine the two negative signs to make a single plus sign. This gives\n\n$$\n\\begin{aligned}0-(-6) & = \\\\ 0+6 & = \\\\ 6 & .\\end{aligned}\n$$\n\n![](images/a7/a793deb0faa2f175a7f9bddc13dcff381b48aaee40b6082bd320a8748d8c8c37.png)"}] [{:db/id #edb/ref 17592186063957 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064351 :knowledge-point/id #uuid "0ac4d4f6-ade4-59d0-a633-fac839543b23" :knowledge-point/title "Subtracting a Negative Number From a Negative Number"}] :question/id #uuid "1c75cfa3-630e-5b37-82c0-ec421bb8c206" :question/math-academy-id "e-13263" :question/problem "Subtract $-100$ from $-85$." :question/worked-solution "To subtract $−100$ from $-85,$ we combine the two negative signs to make a single plus sign. This gives\n\n$$\n\\begin{aligned}-85-(-100) & = \\\\ -85+100 & = \\\\ 15 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063958 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064352 :knowledge-point/id #uuid "430390f1-fd74-564c-a8d6-3925ba8b1832" :knowledge-point/title "Subtracting a Negative Decimal From a Number"}] :question/id #uuid "735b7c5c-68c6-51b9-b3c0-cc38a4e59e95" :question/math-academy-id "e-13264" :question/problem "What is the value of $-3-(-1.5)$?" :question/worked-solution "To subtract $-1.5$ from $-3,$ we combine the two negative signs to make a single plus sign. This gives\n\n$$\n\\begin{aligned}-3-(-1.5)=-3+1.5.\\end{aligned}\n$$\n\nTo calculate $-3+1.5,$ we start at  $-3$ and move $1$ place to the right. Then, we move another  $0.5$ places to the right: \n\n![](images/f8/f8ebeccc7db234acc592ffd79aeeb92ce5ce5a756c4500019a1c5316f78d640d.png)\n\nTherefore, \n\n$$\n-3-(-1.5)= -1.5.\n$$"}] [{:db/id #edb/ref 17592186063959 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064353 :knowledge-point/id #uuid "801cc9bd-b65c-5a79-873b-ee4c5bffdc6e" :knowledge-point/title "Subtracting a Negative Fraction From a Fraction"}] :question/id #uuid "347baa8c-4ba0-559a-a5b6-81e024054af6" :question/math-academy-id "e-13265" :question/problem "Find $\\dfrac{3}{7} - \\left( -\\dfrac{11}{7} \\right).$" :question/worked-solution "To subtract $-\\dfrac{11}{7}$ from $\\dfrac{3}{7},$ we combine the two negative signs to make a single plus sign. This gives\n\n$$\n\\begin{aligned}\\frac{3}{7}-(-\\frac{11}{7}) & =\\frac{3}{7}+\\frac{11}{7}.\\end{aligned}\n$$\n\nWe have a common denominator of $7,$ so we combine numerators:\n\n$$\n\\begin{aligned}\\frac{3}{7}+\\frac{11}{7}=\\frac{3+11}{7}=\\frac{14}{7}\\end{aligned}\n$$\n\nNow, we can simplify the resulting fraction:\n\n$$\n\\begin{aligned}\\frac{14}{7} & =14÷7=2\\end{aligned}\n$$\n\n**Note:** If two fractions have different denominators, we need to put them over a common denominator first and *then* add or subtract!"}] [{:db/id #edb/ref 17592186445727 :knowledge-point/_questions [{:db/id #edb/ref 17592186064352 :knowledge-point/id #uuid "430390f1-fd74-564c-a8d6-3925ba8b1832" :knowledge-point/title "Subtracting a Negative Decimal From a Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00abcdff-8954-57d9-8dc3-25c2a12665fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.5" :db/id #edb/ref 17592186445682}] :answer-field/correct {:answer/id #uuid "00abcdff-8954-57d9-8dc3-25c2a12665fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.5" :db/id #edb/ref 17592186445682} :answer-field/id #uuid "6a9f7f5f-0443-54e8-b986-223a68545e3d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186445715}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ffbebb40-40fa-5363-9f70-e6c4fb7297ce" :question/math-academy-id "q-186143" :question/problem "$8-(-1.5)=${{field-1}}" :question/worked-solution "To subtract $-1.5$ from $8$, we combine the two negative signs to make a single plus sign. This gives\n\n$$\n\\begin{aligned}8-(-1.5)=8+1.5.\\end{aligned}\n$$\n\nTo calculate $8+1.5$, we start at $8$ and move $1$ place to the right. Then, we move another $0.5$ places to the right: \n\n![](images/6c/6c5594e76467d574192f48b23ef994e9d86afbff76f3fb75c34082445e938774.png)\n\nThus,\n\n$$\n8-(-1.5)=9.5.\n$$"}] [{:db/id #edb/ref 17592186445725 :knowledge-point/_questions [{:db/id #edb/ref 17592186064353 :knowledge-point/id #uuid "801cc9bd-b65c-5a79-873b-ee4c5bffdc6e" :knowledge-point/title "Subtracting a Negative Fraction From a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8752fd3-2d27-5d63-ae71-c16259246c5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{5}" :db/id #edb/ref 17592186445708}] :answer-field/correct {:answer/id #uuid "f8752fd3-2d27-5d63-ae71-c16259246c5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{5}" :db/id #edb/ref 17592186445708} :answer-field/id #uuid "29d4ecd8-0eea-5359-8461-12881bc9690d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186445713}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fa5f817f-8157-5950-9e2c-39ce077a420a" :question/math-academy-id "q-186221" :question/problem "Expressed as an improper fraction in its simplest form, $\\frac{3}{10}-(-\\frac{11}{10})=${{field-1}}." :question/worked-solution "To subtract $-\\frac{11}{10}$ from $\\frac{3}{10}$, we first combine the two negative signs to make a single plus sign. This gives\n\n$$\n\\begin{aligned}\\frac{3}{10}-(-\\frac{11}{10})=\\frac{3}{10}+\\frac{11}{10}.\\end{aligned}\n$$\n\nWe have a common denominator of $10$, so we combine the numerators:\n\n$$\n\\begin{aligned}\\frac{3}{10}+\\frac{11}{10}=\\frac{14}{10}=\\frac{7}{5} & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186445724 :knowledge-point/_questions [{:db/id #edb/ref 17592186064351 :knowledge-point/id #uuid "0ac4d4f6-ade4-59d0-a633-fac839543b23" :knowledge-point/title "Subtracting a Negative Number From a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "447cc66e-703c-5fbd-842e-478f167f4b4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186445688}] :answer-field/correct {:answer/id #uuid "447cc66e-703c-5fbd-842e-478f167f4b4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186445688} :answer-field/id #uuid "e16e9fbd-b89b-56ce-a36c-7a7afb8cdfac" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186445718}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f34dcfc4-667b-546b-9710-69444b9a8901" :question/math-academy-id "q-186285" :question/problem "$-25-(-16)=${{field-1}}" :question/worked-solution "To subtract $-16$ from $-25,$ we combine the two negative signs to make a single plus sign. This gives\n\n$$\n\\begin{aligned}-25-(-16) & = \\\\ -25+16 & = \\\\ -9 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186445721 :knowledge-point/_questions [{:db/id #edb/ref 17592186064351 :knowledge-point/id #uuid "0ac4d4f6-ade4-59d0-a633-fac839543b23" :knowledge-point/title "Subtracting a Negative Number From a Negative Number"}] :question/answer-fiel