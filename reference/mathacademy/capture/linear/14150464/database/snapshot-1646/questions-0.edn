 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186445698} {:answer/id #uuid "ec125e8b-0063-547d-b33f-974f3b03b3a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186445706}] :answer-field/correct {:answer/id #uuid "70987559-1929-5802-8867-0199664879f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186445697} :answer-field/id #uuid "a7dad6e6-1e14-5259-a263-084d6f2e00a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186445716}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9aec2749-6917-5728-a2e1-6c693f03cce7" :question/math-academy-id "q-2124" :question/problem "$2-(-3)=$" :question/worked-solution "To subtract $-3$ from $2,$ we combine the two negative signs to make a single plus sign. This gives\n\n$$\n\\begin{aligned}2-(-3) & = \\\\ 2+3 & = \\\\ 5 & .\\end{aligned}\n$$\n\n![](images/c8/c83beb4c78b8690dc04d2cc95bb20e94e33eac19962edea1055089adb4213ad4.png)"}] [{:db/id #edb/ref 17592186445719 :knowledge-point/_questions [{:db/id #edb/ref 17592186064352 :knowledge-point/id #uuid "430390f1-fd74-564c-a8d6-3925ba8b1832" :knowledge-point/title "Subtracting a Negative Decimal From a Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fb3f4ba-3d52-5e66-b900-fccf08dcf77b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186445690} {:answer/id #uuid "661fa446-4bfd-5099-bde4-63ad4d69a9f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186445693} {:answer/id #uuid "669dd8e0-903b-5033-868b-bf398f3dbda2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-45.5" :db/id #edb/ref 17592186445694} {:answer/id #uuid "678deee5-0d03-575a-a959-ea7c5b503245" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186445695} {:answer/id #uuid "f9fa4cd5-b59c-54a9-8889-79abefd56008" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.5" :db/id #edb/ref 17592186445709}] :answer-field/correct {:answer/id #uuid "661fa446-4bfd-5099-bde4-63ad4d69a9f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186445693} :answer-field/id #uuid "10e463b9-ba5f-58a7-9ef9-b8289f46f1c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186445711}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "001c0a2b-30d4-5c66-b0d0-618860b684f3" :question/math-academy-id "q-43176" :question/problem "$-1.5-(-6.5)=$" :question/worked-solution "To subtract $-6.5$ from $-1.5$, we first combine the two negative signs to make a single plus sign:\n\n$$\n\\begin{aligned}-1.5-(-6.5)=-1.5+6.5.\\end{aligned}\n$$\n\nTo calculate $-1.5+6.5$, we start at $-1.5$ and move $6$ places to the right. Then, we move another  $0.5$ places to the right.  \n\n![](images/e3/e327ed5a6489a26d775b83c759c1e8ea21b5584797ce08f1a6e4419c99149392.png)\n\nThus, \n\n$$\n\\begin{aligned}-1.5-(-6.5)=5 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186445726 :knowledge-point/_questions [{:db/id #edb/ref 17592186064353 :knowledge-point/id #uuid "801cc9bd-b65c-5a79-873b-ee4c5bffdc6e" :knowledge-point/title "Subtracting a Negative Fraction From a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00ab7b04-8bb4-5994-a9b1-2c6cc51602f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186445681} {:answer/id #uuid "63b5c5e9-542e-56bc-bf6e-00663382629c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186445691} {:answer/id #uuid "cd70e7b2-44f7-57f7-a2c0-e6f3e33f08ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186445703} {:answer/id #uuid "da9a4d52-5225-5be1-9efb-c173bdb1e9d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186445704} {:answer/id #uuid "e74591fe-613c-5e8d-871e-37de94558d1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186445705}] :answer-field/correct {:answer/id #uuid "cd70e7b2-44f7-57f7-a2c0-e6f3e33f08ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186445703} :answer-field/id #uuid "d283bc53-5170-5a5b-a29a-63545feaa539" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186445717}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fdf4e37b-42ef-5f25-823e-4a4fb056ca0b" :question/math-academy-id "q-43178" :question/problem "$1-(-\\frac{3}{2})=$" :question/worked-solution "To subtract $-\\frac{3}{2}$ from $1$, we drop  the parentheses and combine the two negative signs to make a single plus sign:\n\n$$\n\\begin{aligned}1-(-\\frac{3}{2})=1+\\frac{3}{2} & .\\end{aligned}\n$$\n\nNow, we express the two numbers as fractions over a common denominator of $2$\n and combine the numerators. This gives \n\n$$\n\\begin{aligned}1+\\frac{3}{2}=\\frac{2}{2}+\\frac{3}{2}=\\frac{2+3}{2} & .\\end{aligned}\n$$\n\nNext, we work out $2+3$ using our number line.\n\n![](images/c8/c83beb4c78b8690dc04d2cc95bb20e94e33eac19962edea1055089adb4213ad4.png)\n\nSo we get\n\n$$\n\\frac{2+3}{2}=\\frac{5}{2}.\n$$"}] [{:db/id #edb/ref 17592186445720 :knowledge-point/_questions [{:db/id #edb/ref 17592186064350 :knowledge-point/id #uuid "72f03bd5-4e2c-5d8c-9d08-129fb9949a3c" :knowledge-point/title "Subtracting a Negative Number From a Positive Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "108f7f12-e1c2-51f0-8a90-534e160f00c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-67" :db/id #edb/ref 17592186445683} {:answer/id #uuid "2e35aa85-6422-5e8f-b0f2-c7b393b706b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "63" :db/id #edb/ref 17592186445685} {:answer/id #uuid "430b3b0a-c396-5a84-82d7-c8084652f7d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "77" :db/id #edb/ref 17592186445687} {:answer/id #uuid "66168dbe-2261-555c-bd59-65c43facf78b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "73" :db/id #edb/ref 17592186445692} {:answer/id #uuid "ef0b8595-32d4-57c5-9335-1c4d41373ca3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "67" :db/id #edb/ref 17592186445707}] :answer-field/correct {:answer/id #uuid "430b3b0a-c396-5a84-82d7-c8084652f7d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "77" :db/id #edb/ref 17592186445687} :answer-field/id #uuid "0e91ee15-93cf-59d7-94be-0ae88f73ae89" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186445710}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "202f9bc7-56db-5d92-8c9b-914c1a4e35e5" :question/math-academy-id "q-6141" :question/problem "$40-(-37)=$" :question/worked-solution "To subtract $-37$ from $40,$ we combine the two negative signs to make a single plus sign. This gives\n\n$$\n\\begin{aligned}40-(-37) & = \\\\ 40+37 & = \\\\ 77 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186445722 :knowledge-point/_questions [{:db/id #edb/ref 17592186064351 :knowledge-point/id #uuid "0ac4d4f6-ade4-59d0-a633-fac839543b23" :knowledge-point/title "Subtracting a Negative Number From a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "463b67e5-6f16-520e-8d28-4a7b594c686a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186445689} {:answer/id #uuid "69cd6bc6-65aa-55fc-86c4-0c0c6baf8411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-80" :db/id #edb/ref 17592186445696} {:answer/id #uuid "845ae37b-0984-50bf-b127-abaf96a6fce0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-200" :db/id #edb/ref 17592186445699} {:answer/id #uuid "a49c017a-5dd3-5932-a6ea-b44e95467f0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186445701} {:answer/id #uuid "b6c628ce-7054-5087-8ffa-cbea38dd8c5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "200" :db/id #edb/ref 17592186445702}] :answer-field/correct {:answer/id #uuid "69cd6bc6-65aa-55fc-86c4-0c0c6baf8411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-80" :db/id #edb/ref 17592186445696} :answer-field/id #uuid "178db5da-3eb8-5ece-b49f-ac902f43719c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186445712}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "56103953-2099-536e-9354-228c5ba450e3" :question/math-academy-id "q-6142" :question/problem "$-140-(-60)=$" :question/worked-solution "To subtract $-60$ from $-14