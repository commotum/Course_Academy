/ref 17592186445704 13194139534958 17592186045417 true] [17592186445717 1075 #edb/ref 17592186445705 13194139534958 17592186045417 true] [17592186445717 1076 #edb/ref 17592186045493 13194139534958 17592186045417 true] [17592186445717 1077 "selection" 13194139534958 17592186045417 true] [17592186445717 1078 #edb/ref 17592186445703 13194139534958 17592186045417 true] [17592186445717 1079 #uuid "d283bc53-5170-5a5b-a29a-63545feaa539" 13194139534958 17592186045417 true] [17592186445718 1075 #edb/ref 17592186445688 13194139534958 17592186045417 true] [17592186445718 1076 #edb/ref 17592186045492 13194139534958 17592186045417 true] [17592186445718 1077 "field-1" 13194139534958 17592186045417 true] [17592186445718 1078 #edb/ref 17592186445688 13194139534958 17592186045417 true] [17592186445718 1079 #uuid "e16e9fbd-b89b-56ce-a36c-7a7afb8cdfac" 13194139534958 17592186045417 true] [17592186445719 1068 #edb/ref 17592186445711 13194139534958 17592186045417 true] [17592186445719 1069 "q-43176" 13194139534958 17592186045417 true] [17592186445719 1070 #edb/ref 17592186045487 13194139534958 17592186045417 true] [17592186445719 1071 "$-1.5-(-6.5)=$" 13194139534958 17592186045417 true] [17592186445719 1072 #uuid "001c0a2b-30d4-5c66-b0d0-618860b684f3" 13194139534958 17592186045417 true] [17592186445719 1074 "To subtract $-6.5$ from $-1.5$, we first combine the two negative signs to make a single plus sign:\n\n$$\n\\begin{aligned}-1.5-(-6.5)=-1.5+6.5.\\end{aligned}\n$$\n\nTo calculate $-1.5+6.5$, we start at $-1.5$ and move $6$ places to the right. Then, we move another  $0.5$ places to the right.  \n\n![](images/e3/e327ed5a6489a26d775b83c759c1e8ea21b5584797ce08f1a6e4419c99149392.png)\n\nThus, \n\n$$\n\\begin{aligned}-1.5-(-6.5)=5 & .\\end{aligned}\n$$" 13194139534958 17592186045417 true] [17592186445720 1068 #edb/ref 17592186445710 13194139534958 17592186045417 true] [17592186445720 1069 "q-6141" 13194139534958 17592186045417 true] [17592186445720 1070 #edb/ref 17592186045487 13194139534958 17592186045417 true] [17592186445720 1071 "$40-(-37)=$" 13194139534958 17592186045417 true] [17592186445720 1072 #uuid "202f9bc7-56db-5d92-8c9b-914c1a4e35e5" 13194139534958 17592186045417 true] [17592186445720 1074 "To subtract $-37$ from $40,$ we combine the two negative signs to make a single plus sign. This gives\n\n$$\n\\begin{aligned}40-(-37) & = \\\\ 40+37 & = \\\\ 77 & .\\end{aligned}\n$$" 13194139534958 17592186045417 true] [17592186445721 1068 #edb/ref 17592186445714 13194139534958 17592186045417 true] [17592186445721 1069 "q-186286" 13194139534958 17592186045417 true] [17592186445721 1070 #edb/ref 17592186045486 13194139534958 17592186045417 true] [17592186445721 1071 "$-235-(-480)=${{field-1}}" 13194139534958 17592186045417 true] [17592186445721 1072 #uuid "2cb63cf6-7431-5ab7-86ac-f9b0b723fbb7" 13194139534958 17592186045417 true] [17592186445721 1074 "To subtract $-480$ from $-235,$ we combine the two negative signs to make a single plus sign. This gives\n\n$$\n\\begin{aligned}-235-(-480) & = \\\\ -235+480 & = \\\\ 245 & .\\end{aligned}\n$$" 13194139534958 17592186045417 true] [17592186445722 1068 #edb/ref 17592186445712 13194139534958 17592186045417 true] [17592186445722 1069 "q-6142" 13194139534958 17592186045417 true] [17592186445722 1070 #edb/ref 17592186045486 13194139534958 17592186045417 true] [17592186445722 1071 "$-140-(-60)=$" 13194139534958 17592186045417 true] [17592186445722 1072 #uuid "56103953-2099-536e-9354-228c5ba450e3" 13194139534958 17592186045417 true] [17592186445722 1074 "To subtract $-60$ from $-140,$ we combine the two negative signs to make a single plus sign. This gives\n\n$$\n\\begin{aligned}-140-(-60) & = \\\\ -140+60 & = \\\\ -80 & .\\end{aligned}\n$$" 13194139534958 17592186045417 true] [17592186445723 1068 #edb/ref 17592186445716 13194139534958 17592186045417 true] [17592186445723 1069 "q-2124" 13194139534958 17592186045417 true] [17592186445723 1070 #edb/ref 17592186045485 13194139534958 17592186045417 true] [17592186445723 1071 "$2-(-3)=$" 13194139534958 17592186045417 true] [17592186445723 1072 #uuid "9aec2749-6917-5728-a2e1-6c693f03cce7" 13194139534958 17592186045417 true] [17592186445723 1074 "To subtract $-3$ from $2,$ we combine the two negative signs to make a single plus sign. This gives\n\n$$\n\\begin{aligned}2-(-3) & = \\\\ 2+3 & = \\\\ 5 & .\\end{aligned}\n$$\n\n![](images/c8/c83beb4c78b8690dc04d2cc95bb20e94e33eac19962edea1055089adb4213ad4.png)" 13194139534958 17592186045417 true] [17592186445724 1068 #edb/ref 17592186445718 13194139534958 17592186045417 true] [17592186445724 1069 "q-186285" 13194139534958 17592186045417 true] [17592186445724 1070 #edb/ref 17592186045487 13194139534958 17592186045417 true] [17592186445724 1071 "$-25-(-16)=${{field-1}}" 13194139534958 17592186045417 true] [17592186445724 1072 #uuid "f34dcfc4-667b-546b-9710-69444b9a8901" 13194139534958 17592186045417 true] [17592186445724 1074 "To subtract $-16$ from $-25,$ we combine the two negative signs to make a single plus sign. This gives\n\n$$\n\\begin{aligned}-25-(-16) & = \\\\ -25+16 & = \\\\ -9 & .\\end{aligned}\n$$" 13194139534958 17592186045417 true] [17592186445725 1068 #edb/ref 17592186445713 13194139534958 17592186045417 true] [17592186445725 1069 "q-186221" 13194139534958 17592186045417 true] [17592186445725 1070 #edb/ref 17592186045485 13194139534958 17592186045417 true] [17592186445725 1071 "Expressed as an improper fraction in its simplest form, $\\frac{3}{10}-(-\\frac{11}{10})=${{field-1}}." 13194139534958 17592186045417 true] [17592186445725 1072 #uuid "fa5f817f-8157-5950-9e2c-39ce077a420a" 13194139534958 17592186045417 true] [17592186445725 1074 "To subtract $-\\frac{11}{10}$ from $\\frac{3}{10}$, we first combine the two negative signs to make a single plus sign. This gives\n\n$$\n\\begin{aligned}\\frac{3}{10}-(-\\frac{11}{10})=\\frac{3}{10}+\\frac{11}{10}.\\end{aligned}\n$$\n\nWe have a common denominator of $10$, so we combine the numerators:\n\n$$\n\\begin{aligned}\\frac{3}{10}+\\frac{11}{10}=\\frac{14}{10}=\\frac{7}{5} & .\\end{aligned}\n$$" 13194139534958 17592186045417 true] [17592186445726 1068 #edb/ref 17592186445717 13194139534958 17592186045417 true] [17592186445726 1069 "q-43178" 13194139534958 17592186045417 true] [17592186445726 1070 #edb/ref 17592186045487 13194139534958 17592186045417 true] [17592186445726 1071 "$1-(-\\frac{3}{2})=$" 13194139534958 17592186045417 true] [17592186445726 1072 #uuid "fdf4e37b-42ef-5f25-823e-4a4fb056ca0b" 13194139534958 17592186045417 true] [17592186445726 1074 "To subtract $-\\frac{3}{2}$ from $1$, we drop  the parentheses and combine the two negative signs to make a single plus sign:\n\n$$\n\\begin{aligned}1-(-\\frac{3}{2})=1+\\frac{3}{2} & .\\end{aligned}\n$$\n\nNow, we express the two numbers as fractions over a common denominator of $2$\n and combine the numerators. This gives \n\n$$\n\\begin{aligned}1+\\frac{3}{2}=\\frac{2}{2}+\\frac{3}{2}=\\frac{2+3}{2} & .\\end{aligned}\n$$\n\nNext, we work out $2+3$ using our number line.\n\n![](images/c8/c83beb4c78b8690dc04d2cc95bb20e94e33eac19962edea1055089adb4213ad4.png)\n\nSo we get\n\n$$\n\\frac{2+3}{2}=\\frac{5}{2}.\n$$" 13194139534958 17592186045417 true] [17592186445727 1068 #edb/ref 17592186445715 13194139534958 17592186045417 true] [17592186445727 1069 "q-186143" 13194139534958 17592186045417 true] [17592186445727 1070 #edb/ref 17592186045485 13194139534958 17592186045417 true] [17592186445727 1071 "$8-(-1.5)=${{field-1}}" 13194139534958 17592186045417 true] [17592186445727 1072 #uuid "ffbebb40-40fa-5363-9f70-e6c4fb7297ce" 13194139534958 17592186045417 true] [17592186445727 1074 "To subtract $-1.5$ from $8$, we combine the two negative signs to make a single plus sign. This gives\n\n$$\n\\begin{aligned}8-(-1.5)=8+1.5.\\end{aligned}\n$$\n\nTo calculate $8+1.5$, we start at $8$ and move $1$ place to the right. Then, we move another $0.5$ places to the right: \n\n![](images/6c/6c5594e76467d574192f48b23ef994e9d86afbff76f3fb75c34082445e938774.png)\n\nThus,\n\n$$\n8-(-1.5)=9.5.\n$$" 13194139534958 17592186045417 true]] :edb/tempids {"answer-00ab7b04-8bb4-5994-a9b1-2c6cc51602f6" 17592186445681 "answer-00abcdff-8954-57d9-8dc3-25c2a12665fa" 17592186445682 "answer-108f7f12-e1c2-51f0-8a90-534e160f00c7" 17592186445683 "answer-1d9638f3-e580-586d-b51b-9f10f7b64d37" 17592186445684 "answer-2e35aa85-6422-5e8f-b0f2-c7b393b706b3" 17592186445685 "answer-39460979-a9b1-56dc-8be5-a7c360f3456d" 17592186445686 "answer-430b3b0a-c396-5a84-82d7-c8084652f7d5" 17592186445687 "answer-447cc66e-703c-5fbd-842e-478f167f4b4d" 17592186445688 "answer-463b67e5-6f16-520e-8d28-4a7b594c686a" 17592186445689 "answer-5fb3f4ba-3d52-5e66-b900-fccf08dcf77b" 17592186445690 "answer-63b5c5e9-542e-56bc-bf6e-00663382629c" 17592186445691 "answer-66168dbe-2261-555c-bd59-65c43facf78b" 17592186445692 "answer-661fa446-4bfd-5099-bde4-63ad4d69a9f7" 17592186445693 "answer-669dd8e0-903b-5033-868b-bf398f3dbda2" 17592186445694 "answer-678deee5-0d03-575a-a959-ea7c5b503245" 17592186445695 "answer-69cd6bc6-65aa-55fc-86c4-0c0c6baf8411" 17592186445696 "answer-70987559-1929-5802-8867-0199664879f4" 17592186445697 "answer-79307ae3-eb39-5426-b7a3-d87240b2527d" 17592186445698 "answer-845ae37b-0984-50bf-b127-abaf96a6fce0" 17592186445699 "answer-8ce761a0-953d-53c2-b100-656712a6c5fe" 17592186445700 "answer-a49c017a-5dd3-5932-a6ea-b44e95467f0e" 17592186445701 "answer-b6c628ce-7054-5087-8ffa-cbea38dd8c5a" 17592186445702 "answer-cd70e7b2-44f7-57f7-a2c0-e6f3e33f08ce" 17592186445703 "answer-da9a4d52-5225-5be1-9efb-c173bdb1e9d4" 17592186445704 "answer-e74591fe-613c-5e8d-871e-37de94558d1f" 17592186445705 "answer-ec125e8b-0063-547d-b33f-974f3b03b3a2" 17592186445706 "answer-ef0b8595-32d4-57c5-9335-1c4d41373ca3" 17592186445707 "answer-f8752fd3-2d27-5d63-ae71-c16259246c5e" 17592186445708 "answer-f9fa4cd5-b59c-54a9-8889-79abefd56008" 17592186445709 "answer-field-0e91ee15-93cf-59d7-94be-0ae88f73ae89" 17592186445710 "answer-field-10e463b9-ba5f-58a7-9ef9-b8289f46f1c0" 17592186445711 "answer-field-