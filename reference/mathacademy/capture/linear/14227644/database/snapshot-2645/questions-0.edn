#{[{:db/id #edb/ref 17592186233301 :knowledge-point/_questions [{:db/id #edb/ref 17592186068834 :knowledge-point/id #uuid "452d826b-4cb3-56e1-989a-b025b5d5c955" :knowledge-point/title "Choosing a Parameter to Force a Desired Number of Solutions to a Quadratic Equation"}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a04dee46-e349-5f31-9089-697114c8639e" :question/math-academy-id "q-12218" :question/problem "Find the values of $k$ for which the quadratic equation $5{x}^{2}+15x+k=0$ has one distinct real solution." :question/worked-solution "The equation has one distinct real solution if its discriminant is zero. So, we need to find the values of $k$ so that the discriminant is zero.\n\nFirst, we calculate the discriminant. We have $a=5,$ $b=15,$ and $c=k,$ so the discriminant is as follows:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(15)^{2}-4(5)(k) \\\\  & =225-20k\\end{aligned}\n$$\n\nNow, we find the values of $k$ such that the discriminant is zero:\n\n$$\n\\begin{aligned}D & =0 \\\\ 225-20k & =0 \\\\ 20k & =225 \\\\ k & =\\frac{225}{20} \\\\ k & =\\frac{45}{4}\\end{aligned}\n$$\n\nTherefore, the given equation will have one distinct real solution if $k=\\frac{45}{4}.$"}] [{:db/id #edb/ref 17592186069069 :knowledge-point/_questions [{:db/id #edb/ref 17592186068835 :knowledge-point/id #uuid "adc75098-5640-5e81-a0bc-003fa20c090c" :knowledge-point/title "Identifying Quadratic Equations With Rational Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da17e968-9000-5bf7-b1b8-4ac69644a8cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only." :db/id #edb/ref 17592186065848} {:answer/id #uuid "2d340b06-3adc-5e91-95d4-b12fd2b9610b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186065849} {:answer/id #uuid "38e47f0b-ad13-5ad5-b4c6-1a6804c2be89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only." :db/id #edb/ref 17592186065850} {:answer/id #uuid "514fb001-491c-5ba7-9ad8-39d5fe33cf32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186065851} {:answer/id #uuid "64e5ea06-cda8-5514-b0a3-e1b00faea02c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186065852}] :answer-field/id #uuid "5361b2fe-0cc4-5239-b815-9e9fc9c7eb4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186065847}] :question/id #uuid "555b4713-c6f1-5ebd-b6b9-f73907d00fc1" :question/math-academy-id "q-150890" :question/problem "Consider the quadratic equation $x^{2} + 2x - 15 = 0$. Which of the following statements are true?\n\n1. The discriminant of the equation is a perfect square.\n2. The equation has only rational solutions.\n3. The equation has only irrational solutions."}]}
