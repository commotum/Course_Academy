56f6-9e0c-8b7da65a0478"] [17592186069069 :question/problem "Consider the quadratic equation ${x}^{2}+2x-15=0.$ Which of the following statements are true?\n\nI. The discriminant of the equation is a perfect square.\n\nII. The equation has only rational solutions.\n\nIII. The equation has only irrational solutions."] [17592186069069 :question/worked-solution "Let's examine our statements in turn.\n\n- Statement I is true. We have $a=1,$ $b=2,$ and $c=-15.$ So, we calculate the discriminant as follows:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(2)^{2}-4(1)(-15) \\\\  & =4+60 \\\\  & =64\\end{aligned}\n$$\n\nAnd $64={8}^{2}$ is a perfect square.\n\n- Statement II is true, while statement III is false. \n\nFirst, notice that our quadratic equation has rational coefficients. And, since the discriminant is a nonzero perfect square, the equation must have two rational solutions.\n\nTherefore, the correct answer is \"I and II only.\""] [17592186069069 :question/difficulty :question.difficulty/easy] [17592186065847 :answer-field/correct 17592186065849] ["question-8988f053-e75a-5c75-a866-50d1b2af5964" :question/id #uuid "8988f053-e75a-5c75-a866-50d1b2af5964"] ["question-8988f053-e75a-5c75-a866-50d1b2af5964" :question/math-academy-id "q-218746"] ["question-8988f053-e75a-5c75-a866-50d1b2af5964" :question/problem "The equation $2{x}^{2}+5x-9=0$ has{{field-1}}\ndistinct real solutions."] ["question-8988f053-e75a-5c75-a866-50d1b2af5964" :question/worked-solution "To quickly determine the number of solutions, we can compute the discriminant. We have $a=2,$ $b=5,$ and $c=-9,$ so the discriminant is as follows:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & ={5}^{2}-4(2)(-9) \\\\  & =25+72 \\\\  & =97\\end{aligned}\n$$\n\nSince the discriminant is positive $(D>0),$ the equation has $2$ distinct real solutions."] ["question-8988f053-e75a-5c75-a866-50d1b2af5964" :question/difficulty :question.difficulty/easy] ["answer-field-9d35e828-7244-5a93-b7ac-e296f8c506d6" :answer-field/id #uuid "9d35e828-7244-5a93-b7ac-e296f8c506d6"] ["answer-f30d992b-a29e-5752-8a9c-afea2119fa9d" :answer/id #uuid "f30d992b-a29e-5752-8a9c-afea2119fa9d"] ["answer-f30d992b-a29e-5752-8a9c-afea2119fa9d" :answer/type :answer.type/math] ["answer-f30d992b-a29e-5752-8a9c-afea2119fa9d" :answer/value "2"] ["answer-field-9d35e828-7244-5a93-b7ac-e296f8c506d6" :answer-field/key "field-1"] ["answer-field-9d35e828-7244-5a93-b7ac-e296f8c506d6" :answer-field/type :answer-field.type/blank] ["answer-field-9d35e828-7244-5a93-b7ac-e296f8c506d6" :answer-field/correct "answer-f30d992b-a29e-5752-8a9c-afea2119fa9d"] ["answer-field-9d35e828-7244-5a93-b7ac-e296f8c506d6" :answer-field/choices "answer-f30d992b-a29e-5752-8a9c-afea2119fa9d"] ["question-8988f053-e75a-5c75-a866-50d1b2af5964" :question/answer-fields "answer-field-9d35e828-7244-5a93-b7ac-e296f8c506d6"] [17592186068833 :knowledge-point/questions "question-8988f053-e75a-5c75-a866-50d1b2af5964"] ["question-3d7da907-2808-5b79-bfed-ca1f9e228ecb" :question/id #uuid "3d7da907-2808-5b79-bfed-ca1f9e228ecb"] ["question-3d7da907-2808-5b79-bfed-ca1f9e228ecb" :question/math-academy-id "q-218748"] ["question-3d7da907-2808-5b79-bfed-ca1f9e228ecb" :question/problem "If the quadratic equation $k{x}^{2}+4x+2=0$ has one distinct real solution, then $k=${{field-1}}."] ["question-3d7da907-2808-5b79-bfed-ca1f9e228ecb" :question/worked-solution "The equation has one distinct real solution if its discriminant is zero. So, we need to find the values of $k$ so that the discriminant is zero.\n\nFirst, we calculate the discriminant. We have $a=k,$ $b=4,$ and $c=2,$ so the discriminant is as follows:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(4)^{2}-4(k)(2) \\\\  & =16-8k\\end{aligned}\n$$\n\nNow, we find the values of $k$ such that the discriminant is zero:\n\n$$\n\\begin{aligned}D & =0 \\\\ 16-8k & =0 \\\\ 8k & =16 \\\\ k & =\\frac{16}{8} \\\\ k & =2\\end{aligned}\n$$\n\nTherefore, the given equation will have one distinct real solution if $k=2.$"] ["question-3d7da907-2808-5b79-bfed-ca1f9e228ecb" :question/difficulty :question.difficulty/easy] ["answer-field-4aa3d16b-4100-574f-84df-1c8d2de4cb31" :answer-field/id #uuid "4aa3d16b-4100-574f-84df-1c8d2de4cb31"] ["answer-f5241c35-4c53-5fa0-9bb4-acb9e908070a" :answer/id #uuid "f5241c35-4c53-5fa0-9bb4-acb9e908070a"] ["answer-f5241c35-4c53-5fa0-9bb4-acb9e908070a" :answer/type :answer.type/math] ["answer-f5241c35-4c53-5fa0-9bb4-acb9e908070a" :answer/value "2"] ["answer-field-4aa3d16b-4100-574f-84df-1c8d2de4cb31" :answer-field/key "field-1"] ["answer-field-4aa3d16b-4100-574f-84df-1c8d2de4cb31" :answer-field/type :answer-field.type/blank] ["answer-field-4aa3d16b-4100-574f-84df-1c8d2de4cb31" :answer-field/correct "answer-f5241c35-4c53-5fa0-9bb4-acb9e908070a"] ["answer-field-4aa3d16b-4100-574f-84df-1c8d2de4cb31" :answer-field/choices "answer-f5241c35-4c53-5fa0-9bb4-acb9e908070a"] ["question-3d7da907-2808-5b79-bfed-ca1f9e228ecb" :question/answer-fields "answer-field-4aa3d16b-4100-574f-84df-1c8d2de4cb31"] [17592186068834 :knowledge-point/questions "question-3d7da907-2808-5b79-bfed-ca1f9e228ecb"] ["activity-c1dc22aa-5172-525c-b53a-74cc35f15bd2" :activity/id #uuid "c1dc22aa-5172-525c-b53a-74cc35f15bd2"] ["step-5e21b816-beb3-56a2-9b03-c6291942c7f6" :step/id #uuid "5e21b816-beb3-56a2-9b03-c6291942c7f6"] ["step-75aa9ea7-1039-562b-8c94-a84abad863b3" :step/id #uuid "75aa9ea7-1039-562b-8c94-a84abad863b3"] ["step-812fd524-4a1b-57bd-bd50-8cf2bc0a2512" :step/id #uuid "812fd524-4a1b-57bd-bd50-8cf2bc0a2512"] ["step-82745d32-719e-5bc8-8560-08d4296cae8c" :step/id #uuid "82745d32-719e-5bc8-8560-08d4296cae8c"] ["step-6eeafe58-00df-54fd-bf15-a1b13055fb09" :step/id #uuid "6eeafe58-00df-54fd-bf15-a1b13055fb09"] ["step-5e21b816-beb3-56a2-9b03-c6291942c7f6" :step/content 17592186233301] ["step-5e21b816-beb3-56a2-9b03-c6291942c7f6" :step/next "step-75aa9ea7-1039-562b-8c94-a84abad863b3"] ["step-75aa9ea7-1039-562b-8c94-a84abad863b3" :step/content "question-7966ce86-501b-56f6-9e0c-8b7da65a0478"] ["step-75