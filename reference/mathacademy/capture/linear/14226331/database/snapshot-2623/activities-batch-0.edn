b/ref 17592186533991} {:db/id #edb/ref 17592186544885}] :knowledge-point/title "Filling a Ratio Table by Multiplying and Dividing"} :step/id #uuid "bd74231b-139c-5091-8fd3-66103c7f1329" :step/math-academy-id 81663 :step/next {:db/id #edb/ref 17592186074897}} {:db/id #edb/ref 17592186074897 :step/content {:db/id #edb/ref 17592186073897 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073456 :question/id #uuid "f1a6757d-3e68-5263-a6c7-d03c73391848" :question/math-academy-id "e-13410"} :knowledge-point/id #uuid "84a526bf-9d98-54e1-a54e-cd625bbaea49" :knowledge-point/questions [{:db/id #edb/ref 17592186074385} {:db/id #edb/ref 17592186074398} {:db/id #edb/ref 17592186455467} {:db/id #edb/ref 17592186455502} {:db/id #edb/ref 17592186544785}] :knowledge-point/title "Word Problems"} :step/id #uuid "b13509a4-8a23-5240-a77b-f79cb3691c99" :step/math-academy-id 81666}] :activity/title "Ratio Tables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073973}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186544970} :activity/id #uuid "246e194b-38b8-58e5-8bf1-ed23e18707c6" :activity/scope {:db/id #edb/ref 17592186050138 :topic/id #uuid "2fda426e-c98b-5b36-800a-304f9ce90e0d" :topic/math-academy-id 554} :activity/steps [{:db/id #edb/ref 17592186544960 :step/content {:db/id #edb/ref 17592186544785 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "257f2818-68c3-56e8-8274-f829f0a2508c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "26" :db/id #edb/ref 17592186544171} {:answer/id #uuid "3b6ac35d-9f43-5857-b1f2-871ed91f248e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32" :db/id #edb/ref 17592186544214} {:answer/id #uuid "4f9324be-63c9-5f43-89d5-f643aba91802" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30" :db/id #edb/ref 17592186544259} {:answer/id #uuid "67aa2a37-93dc-537d-8c25-bd3d37cb5f4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186544312} {:answer/id #uuid "91cc30be-ed6a-5c8b-b0fc-539e49732127" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "28" :db/id #edb/ref 17592186544405}] :answer-field/correct {:db/id #edb/ref 17592186544405} :answer-field/id #uuid "143347e7-6d5a-5881-950d-01ac371e0e93" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544659}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "07105131-b758-5e72-bdb4-02c98035c4fe" :question/math-academy-id "q-59864" :question/problem "Gerry, a gardener, is planting roses. He knows he needs $1$ cup of water for every $4$ seeds he plants. So, Gerry creates a ratio table to determine the ratio of water to seeds for different quantities.\n\n| Water (cups) | Seeds |\n| --- | --- |\n| $1$ | $4$ |\n| $7$ | $?$ |\n| $12$ | $48$ |\n\n$$\n\n$$\n\nHow many seeds can Gerry plant with $7$ cups of water?" :question/worked-solution "We start with the ratio $1:4$ and write it as a fraction:\n\n$$\n\\frac{1}{4}\n$$\n\nSo the numerator represents the number of cups of water ($1$), and the denominator represents the number of seeds ($4$).\n\nWe can make a numerator of $7$ by multiplying the numerator and denominator by $7$:\n\n$$\n\\begin{aligned}\\frac{1\\times 7}{4\\times 7} & =\\frac{7}{28}\\end{aligned}\n$$\n\nWe add this to our ratio table:\n\n| Water (cups) | Seeds |\n| --- | --- |\n| $1$ | $4$ |\n| $7$ | $28$ |\n| $12$ | $48$ |\n\n$$\n\n$$\n\nSo, Gerry can plant $28$ seeds with $7$ cups of water."} :step/id #uuid "b2e36d57-8213-53e5-bff9-ed407c12c943" :step/next {:db/id #edb/ref 17592186544993}} {:db/id #edb/ref 17592186544970 :step/content {:db/id #edb/ref 17592186074384 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "805fcf6a-52c6-530b-93ed-5397ad073053" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$21$ and $20$" :db/id #edb/ref 17592186072543} {:answer/id #uuid "b6d607ee-0b23-5d1a-beeb-1fbeecaeadcb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$21$ and $16$" :db/id #edb/ref 17592186072544} {:answer/id #uuid "dfb84b1f-8738-59b6-ac48-27feb1cfefbd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$28$ and $20$" :db/id #edb/ref 17592186072545} {:answer/id #uuid "fbd78151-6ab0-5687-8eed-258100912557" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$42$ and $24$" :db/id #edb/ref 17592186072546} {:answer/id #uuid "6890ecb2-7743-5147-b5f9-be5a6b87114d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$14$ and $16$" :db/id #edb/ref 17592186072547}] :answer-field/correct {:db/id #edb/ref 17592186072543} :answer-field/id #uuid "e097f782-347d-504a-b939-0a797ec8e368" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186072542}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "71ed15e5-6449-55de-bddd-3b4b9bf5265e" :question/math-academy-id "q-59819" :question/problem "From top to bottom, what are the missing numbers in the ratio table below?\n\n| $4$ | $7$ |\n| --- | --- |\n| $12$ | $?$ |\n| $?$ | $35$ |\n\n$$\n\n$$" :question/worked-solution "We start with the ratio $4:7$ and write it as a fraction:\n\n$$\n\\frac{4}{7}\n$$\n\nSo the numerator represents the left-hand entry ($4$), and the denominator represents the right-hand entry ($7$).\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n- To create a numerator of $12,$ we multiply the numerator and denominator of our fraction by $3:$\n\n$$\n\\frac{4\\times 3}{7\\times 3}=\\frac{12}{21}\n$$\n\n- To create a denominator of $35,$ we multiply the numerator and denominator of our fraction by $5:$\n\n$$\n\\frac{4\\times 5}{7\\times 5}=\\frac{20}{35}\n$$\n\nFinally, we fill in the ratio table:\n\n| $4$ | $7$ |\n| --- | --- |\n| $12$ | $21$ |\n| $20$ | $35$ |\n\n$$\n\n$$\n\nSo, from top to bottom, the missing numbers are $21$ and $20.$"} :step/id #uuid "c2a4f642-7f5e-5258-bf8b-7514a82eded7" :step/next {:db/id #edb/ref 17592186544960}} {:db/id #edb/ref 17592186544993 :step/content {:db/id #edb/ref 17592186544885 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e1d0b9d-3357-54ab-82cf-abf91011ffa6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5$ and $30$" :db/id #edb/ref 17592186544152} {:answer/id #uuid "38f59563-e260-5f22-a248-5d3fefc64cdc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ and $30$" :db/id #edb/ref 17592186544210} {:answer/id #uuid "a545f8d6-c144-53ff-ae29-f028d06395f6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4$ and $20$" :db/id #edb/ref 17592186544443} {:answer/id #uuid "a67179fa-5ca5-5e82-94ea-ac2e1fb430df" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ and $18$" :db/id #edb/ref 17592186544447} {:answer/id #uuid "e37e6ce5-4981-521e-804c-81bef08aaaba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5$ and $18$" :db/id #edb/ref 17592186544577}] :answer-field/correct {:db/id #edb/ref 17592186544210} :answer-field/id #uuid "00fa6310-f945-5eef-a33e-d1403f30df5d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544648}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d91b69e3-fd77-5457-a2ba-3ce70f9e9f93" :question/math-academy-id "q-101518" :question/problem "From top to bottom, what are the missing numbers in the ratio table below?\n\n| $?$ | $10$ |\n| --- | --- |\n| $3$ | $15$ |\n| $6$ | $?$ |\n\n$$\n\n$$" :question/worked-solution "We start with the ratio $3:15$ and write it as a fraction:\n\n$$\n\\frac{3}{15}\n$$\n\nSo the numerator represents the left-hand entry ($3$), and the denominator represents the right-hand entry ($15$).\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n- To create a numerator of $6,$ we multiply the numerator and denominator of our fraction by $2:$\n\n$$\n\\frac{3\\times 2}{15\\times 2}=\\frac{6}{30}\n$$\n\n- To create a denominator of $10,$ we divide the numerator and denominator of the previous fraction by $3:$\n\n$$\n\\frac{6÷3}{30÷3}=\\frac{2}{10}\n$$\n\nFinally, we fill in the ratio table:\n\n| $2$ | $10$ |\n| --- | --- |\n| $3$ | $15$ |\n| $6$ | $30$ |\n\n$$\n\n$$\n\nSo, from top to bottom, the missing numbers are $2$ and $30.$"} :step/id #uuid "fcd7a88c-39ee-5167-897e-fa978522f159"}] :activity/title "Ratio Tables" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186544071}]}
