b/ref 17592186045417] [17592186073897 #edb/ref 1042 #uuid "84a526bf-9d98-54e1-a54e-cd625bbaea49" #edb/ref 17592186045417] [17592186073973 #edb/ref 1043 #edb/ref 17592186074893 #edb/ref 17592186045417] [17592186073973 #edb/ref 1043 #edb/ref 17592186074894 #edb/ref 17592186045417] [17592186073973 #edb/ref 1043 #edb/ref 17592186074895 #edb/ref 17592186045417] [17592186073973 #edb/ref 1043 #edb/ref 17592186074896 #edb/ref 17592186045417] [17592186073973 #edb/ref 1043 #edb/ref 17592186074897 #edb/ref 17592186045417] [17592186073973 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186073973 #edb/ref 1045 "Ratio Tables" #edb/ref 17592186045417] [17592186073973 #edb/ref 1046 #edb/ref 17592186074893 #edb/ref 17592186045417] [17592186073973 #edb/ref 1049 #edb/ref 17592186050138 #edb/ref 17592186045417] [17592186073973 #edb/ref 1050 480.0 #edb/ref 17592186045417] [17592186073973 #edb/ref 1053 #uuid "48334486-8ae7-5572-8e8f-b176d6318f35" #edb/ref 17592186045417] [17592186074384 #edb/ref 1068 #edb/ref 17592186072542 #edb/ref 17592186045417] [17592186074384 #edb/ref 1069 "q-59819" #edb/ref 17592186045417] [17592186074384 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186074384 #edb/ref 1071 "From top to bottom, what are the missing numbers in the ratio table below?\n\n| $4$ | $7$ |\n| --- | --- |\n| $12$ | $?$ |\n| $?$ | $35$ |\n\n$$\n\n$$" #edb/ref 17592186045417] [17592186074384 #edb/ref 1072 #uuid "71ed15e5-6449-55de-bddd-3b4b9bf5265e" #edb/ref 17592186045417] [17592186074384 #edb/ref 1074 "We start with the ratio $4:7$ and write it as a fraction:\n\n$$\n\\frac{4}{7}\n$$\n\nSo the numerator represents the left-hand entry ($4$), and the denominator represents the right-hand entry ($7$).\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n- To create a numerator of $12,$ we multiply the numerator and denominator of our fraction by $3:$\n\n$$\n\\frac{4\\times 3}{7\\times 3}=\\frac{12}{21}\n$$\n\n- To create a denominator of $35,$ we multiply the numerator and denominator of our fraction by $5:$\n\n$$\n\\frac{4\\times 5}{7\\times 5}=\\frac{20}{35}\n$$\n\nFinally, we fill in the ratio table:\n\n| $4$ | $7$ |\n| --- | --- |\n| $12$ | $21$ |\n| $20$ | $35$ |\n\n$$\n\n$$\n\nSo, from top to bottom, the missing numbers are $21$ and $20.$" #edb/ref 17592186045417] [17592186074893 #edb/ref 1058 #edb/ref 17592186074894 #edb/ref 17592186045417] [17592186074893 #edb/ref 1061 81656 #edb/ref 17592186045417] [17592186074893 #edb/ref 1062 #uuid "ac8583b6-39eb-5a51-9b51-c3c4ebec13fa" #edb/ref 17592186045417] [17592186074893 #edb/ref 1063 #edb/ref 17592186075038 #edb/ref 17592186045417] [17592186074894 #edb/ref 1058 #edb/ref 17592186074895 #edb/ref 17592186045417] [17592186074894 #edb/ref 1061 81657 #edb/ref 17592186045417] [17592186074894 #edb/ref 1062 #uuid "f054590d-449e-5753-b1fc-569c01699cad" #edb/ref 17592186045417] [17592186074894 #edb/ref 1063 #edb/ref 17592186073894 #edb/ref 17592186045417] [17592186074895 #edb/ref 1058 #edb/ref 17592186074896 #edb/ref 17592186045417] [17592186074895 #edb/ref 1061 81660 #edb/ref 17592186045417] [17592186074895 #edb/ref 1062 #uuid "aab5d8f4-9d49-5c7f-9619-01557ca3969b" #edb/ref 17592186045417] [17592186074895 #edb/ref 1063 #edb/ref 17592186073895 #edb/ref 17592186045417] [17592186074896 #edb/ref 1058 #edb/ref 17592186074897 #edb/ref 17592186045417] [17592186074896 #edb/ref 1061 81663 #edb/ref 17592186045417] [17592186074896 #edb/ref 1062 #uuid "bd74231b-139c-5091-8fd3-66103c7f1329" #edb/ref 17592186045417] [17592186074896 #edb/ref 1063 #edb/ref 17592186073896 #edb/ref 17592186045417] [17592186074897 #edb/ref 1061 81666 #edb/ref 17592186045417] [17592186074897 #edb/ref 1062 #uuid "b13509a4-8a23-5240-a77b-f79cb3691c99" #edb/ref 17592186045417] [17592186074897 #edb/ref 1063 #edb/ref 17592186073897 #edb/ref 17592186045417] [17592186075038 #edb/ref 1064 "Let's take a look at the following equivalent ratios:\n\n![](images/6c/6cda61e0fbd0d9695644a29f0c6fa3478eae84cf253623da7f4b544f35873472.svg)\n\nWe can place the equivalent ratios in a **ratio table**, such as the one below. In a ratio table, each row represents a ratio.\n\n| ${\\color{blue}5}$ | ${\\color{red}10}$ |\n| --- | --- |\n| ${\\color{blue}10}$ | $\\bbox[3pt,Gainsboro]{\\color{red}\\textrm{?}}$ |\n| ${\\color{blue}20}$ | ${\\color{red}40}$ |\n\nOne number is missing. Let's figure out what it is.\n\nWe start with the ratio ${\\color{blue}5}:{\\color{red}10},$ which is the first ratio in the table. Writing this ratio as a fraction, we have\n\n$$\n\\dfrac{{\\color{blue}5}}{{\\color{red}10}}.\n$$\n\nThe numerator represents the left-hand entry (${\\color{blue}5}$), and the denominator represents the right-hand entry (${\\color{red}10}$).\n\nTo find the missing number, we need to make a numerator of ${\\color{blue}10}.$ We can do this by multiplying the numerator and denominator by $2$:\n\n$$\n\\begin{aligned}\\frac{5\\times 2}{10\\times 2} & =\\frac{10}{20}\\end{aligned}\n$$\n\nWe now add this to our ratio table:\n\n| ${\\color{blue}5}$ | ${\\color{red}10}$ |\n| --- | --- |\n| ${\\color{blue}10}$ | $\\bbox[3pt,Gainsboro]{\\color{red}20}$ |\n| ${\\color{blue}20}$ | ${\\color{red}40}$ |\n\nSo, the missing number is $\\color{red}20.$" #edb/ref 17592186045417] [17592186075038 #edb/ref 1065 8357 #edb/ref 17592186045417] [17592186075038 #edb/ref 1066 #uuid "ca7b3d51-7281-5705-bed5-276f34939c25" #edb/ref 17592186045417] [17592186075038 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186544071 #edb/ref 1043 #edb/ref 17592186544960 #edb/ref 17592186045417] [17592186544071 #edb/ref 1043 #edb/ref 17592186544970 #edb/ref 17592186045417] [17592186544071 #edb/ref 1043 #edb/ref 17592186544993 #edb/ref 17592186045417] [17592186544071 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186544071 #edb/ref 1045 "Ratio Tables" #edb/ref 17592186045417] [17592186544071 #edb/ref 1046 #edb/ref 17592186544970 #edb/ref 17592186045417] [17592186544071 #edb/ref 104