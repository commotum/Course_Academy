se\" stretchy=\"false\">→</mo><mi mathvariant=\"normal\">∞</mi><mo>,</mo></math></mjx-assistive-mml></mjx-container> we conclude that\n<mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"85\" style=\"font-size: 113.1%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D453 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2192\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c221E\"></mjx-c></mjx-mi><mjx-mstyle><mjx-mspace style=\"width: 1em;\"></mjx-mspace></mjx-mstyle><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c61\"></mjx-c><mjx-c class=\"mjx-c73\"></mjx-c></mjx-mtext><mjx-mstyle><mjx-mspace style=\"width: 1em;\"></mjx-mspace></mjx-mstyle><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2192\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c221E\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mi>f</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo><mo accent=\"false\" stretchy=\"false\">→</mo><mi mathvariant=\"normal\">∞</mi><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mtext>as</mtext><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mi>x</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mi mathvariant=\"normal\">∞</mi><mo>.</mo></math></mjx-assistive-mml></mjx-container></p