#{[{:activity/first-step {:db/id #edb/ref 17592186060674} :activity/id #uuid "780b6d06-4e3c-5fb9-a687-1ad2687e0771" :activity/scope {:db/id #edb/ref 17592186050953 :topic/id #uuid "7525f3f4-fbe5-5024-8fab-55ad3066edd8" :topic/math-academy-id 266} :activity/steps [{:db/id #edb/ref 17592186060580 :step/content {:db/id #edb/ref 17592186059706 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059519 :question/id #uuid "935e8644-8d66-5be6-87ec-b8176675aa91" :question/math-academy-id "e-4233"} :knowledge-point/id #uuid "4af25d77-e2aa-585a-971f-693c44f34e48" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050613} {:db/id #edb/ref 17592186050749}] :knowledge-point/questions [{:db/id #edb/ref 17592186060370} {:db/id #edb/ref 17592186060371}] :knowledge-point/title "Solving Rational Equations with a Variable in One Denominator"} :step/id #uuid "a0e30d07-9c41-5c2c-839c-9e49ca64764c" :step/math-academy-id 15458 :step/next {:db/id #edb/ref 17592186060581}} {:db/id #edb/ref 17592186060581 :step/content {:db/id #edb/ref 17592186059707 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059520 :question/id #uuid "e7d11d09-773c-58a9-8582-2cd47a3b141c" :question/math-academy-id "e-4234"} :knowledge-point/id #uuid "93665eb6-5d3e-52d2-afc6-bc27488190e1" :knowledge-point/questions [{:db/id #edb/ref 17592186060372} {:db/id #edb/ref 17592186060377}] :knowledge-point/title "Solving Rational Equations with a Binomial in One Denominator"} :step/id #uuid "233132be-0fc4-52d1-9152-818b8c45b168" :step/math-academy-id 15459 :step/next {:db/id #edb/ref 17592186060582}} {:db/id #edb/ref 17592186060582 :step/content {:db/id #edb/ref 17592186059708 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059521 :question/id #uuid "3ae175a8-7654-57c8-b5d8-33d7892b7a24" :question/math-academy-id "e-4235"} :knowledge-point/id #uuid "c2c24d70-3bde-5277-bc92-ae081065deee" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048725}] :knowledge-point/questions [{:db/id #edb/ref 17592186060373} {:db/id #edb/ref 17592186060376}] :knowledge-point/title "Solving Rational Equations with a Binomial and a Monomial in Denominators"} :step/id #uuid "13e292aa-c881-5526-9904-6d174bbb856b" :step/math-academy-id 15460 :step/next {:db/id #edb/ref 17592186060583}} {:db/id #edb/ref 17592186060583 :step/content {:db/id #edb/ref 17592186059709 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059522 :question/id #uuid "13f9fd01-802e-5331-b422-b9aa2cdda7ea" :question/math-academy-id "e-4236"} :knowledge-point/id #uuid "387a794f-17ea-5ea9-86a1-656a495f62cb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048213}] :knowledge-point/questions [{:db/id #edb/ref 17592186060374} {:db/id #edb/ref 17592186060375} {:db/id #edb/ref 17592186234237}] :knowledge-point/title "Solving Rational Equations with Binomials in Both Denominators"} :step/id #uuid "634f203a-900b-5f9f-977b-e1bb2ab2c5ab" :step/math-academy-id 15461} {:db/id #edb/ref 17592186060674 :step/content {:db/id #edb/ref 17592186060937 :tutorial/content "Remember that to solve a rational equation, such as the one below, we can use cross-multiplication:\n\n$$\n\\begin{aligned}\n\\frac{2}{x} &= \\frac{3}{5} \\\\\n5 \\cdot 2 &= 3 \\cdot x \\\\\n10 &= 3x \\\\\n\\frac{10}{3} &= x\n\\end{aligned}\n$$\n\nHowever, there is also another method that we can use, known as the **flip method,** which involves taking the reciprocal of both sides of an equation. So, when an equation involves two fractions, we can \"flip\" them as follows:\n\n$$\n\\dfrac{a}{b} = \\dfrac{c}{d}\\quad\\Longrightarrow\\quad \\dfrac ba =\\dfrac dc\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nThe flip method is useful because it allows us to remove a variable from a denominator. For example, applying the flip method, we have\n\n$$\n\\dfrac{\\color{red}2}{\\color{blue}x}=\\dfrac{\\color{blue}3}{\\color{red}5} \\quad\\Longrightarrow\\quad \\dfrac{\\color{blue}x}{\\color{red}2} = \\dfrac{\\color{red}5}{\\color{blue}3}\n$$\n\nNow, we can solve the resulting equation using the multiplication principle:\n\n$$\n\\begin{aligned}\n2 \\cdot \\frac{x}{2} &= 2 \\cdot \\frac{5}{3} \\\\\n2 \\cdot \\frac{x}{2} &= 2 \\cdot \\frac{5}{3} \\\\\nx &= \\frac{10}{3}\n\\end{aligned}\n$$" :tutorial/id #uuid "33bd96be-8ef8-525c-be19-8590b4893b52" :tutorial/math-academy-id 3123 :tutorial/title "Introduction"} :step/id #uuid "b043ea3a-fd3a-5de4-b7ac-21a29627ca53" :step/math-academy-id 17016 :step/next {:db/id #edb/ref 17592186060580}}] :activity/title "Solving Rational Equations Using the Flip Method" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186059941}]}
