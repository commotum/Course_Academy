b43a-b3fdb0795ea2" #edb/ref 17592186045417] [17592186058887 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186058887 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186058887 #edb/ref 1083 #uuid "e1d6978c-429a-5678-9673-1dad8790f86f" #edb/ref 17592186045417] [17592186058888 #edb/ref 1080 "\\frac{1}{2}" #edb/ref 17592186045417] [17592186058888 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186058888 #edb/ref 1083 #uuid "e7d08e45-da77-54d2-b0fb-f110b3c9d317" #edb/ref 17592186045417] [17592186058889 #edb/ref 1080 "-\\frac{1}{3}" #edb/ref 17592186045417] [17592186058889 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186058889 #edb/ref 1083 #uuid "1a59f56e-4565-51e2-8e93-bdc2b248a059" #edb/ref 17592186045417] [17592186059519 #edb/ref 1069 "e-4233" #edb/ref 17592186045417] [17592186059519 #edb/ref 1071 "Solve the equation $\\dfrac 23 = \\dfrac 2x.$" #edb/ref 17592186045417] [17592186059519 #edb/ref 1072 #uuid "935e8644-8d66-5be6-87ec-b8176675aa91" #edb/ref 17592186045417] [17592186059519 #edb/ref 1074 "First, we note that $x=0$ cannot be a solution since this would make the denominator on the right-hand side zero.\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\dfrac{a}{b} = \\dfrac{c}{d}\\quad\\Longrightarrow\\quad \\dfrac ba =\\dfrac dc\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\dfrac 23 = \\dfrac 2x \\quad\\Longrightarrow\\quad \\dfrac 32 = \\dfrac x2\n$$\n\nWe can now solve this equation using the multiplication principle:\n\n![](images/8e/8e7b2d027a761ba93f679cfb517709811938da412b06e59212391741b5660a2b.svg)" #edb/ref 17592186045417] [17592186059520 #edb/ref 1069 "e-4234" #edb/ref 17592186045417] [17592186059520 #edb/ref 1071 "Solve the equation $\\dfrac 1{x+1} = 2.$" #edb/ref 17592186045417] [17592186059520 #edb/ref 1072 #uuid "e7d11d09-773c-58a9-8582-2cd47a3b141c" #edb/ref 17592186045417] [17592186059520 #edb/ref 1074 "First, we note that $x=-1$ cannot be a solution since this would make the denominator on the left-hand side zero.\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\dfrac{a}{b} = \\dfrac{c}{d}\\quad\\Longrightarrow\\quad \\dfrac ba =\\dfrac dc\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\dfrac 1{x+1} = 2 \\quad\\Longrightarrow\\quad \\dfrac {x+1}{1} = \\dfrac 12\n$$\n\nThe above equation simplifies to\n\n$$\nx+1 = \\dfrac 12 .\n$$\n\nWe can now solve this equation using the addition principle:\n\n![](images/d7/d7150c6093121f9f6dc0ecd9675d5be8f0855d339f3404d7a357875362d9990f.svg)" #edb/ref 17592186045417] [17592186059521 #edb/ref 1069 "e-4235" #edb/ref 17592186045417] [17592186059521 #edb/ref 1071 "Solve the equation $\\dfrac 1{x-2} = \\dfrac 3{5x}.$" #edb/ref 17592186045417] [17592186059521 #edb/ref 1072 #uuid "3ae175a8-7654-57c8-b5d8-33d7892b7a24" #edb/ref 17592186045417] [17592186059521 #edb/ref 1074 "First, we note that\n\n- $x=2$ cannot be a solution since this would make the denominator on the left-hand side zero, and\n\n- $x=0$ cannot be a solution since this would make the denominator on the right-hand side zero.\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\dfrac{a}{b} = \\dfrac{c}{d}\\quad\\Longrightarrow\\quad \\dfrac ba =\\dfrac dc\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\dfrac 1{x-2} = \\dfrac 3{5x} \\quad\\Longrightarrow\\quad \\dfrac {x-2}{1} = \\dfrac{5x}{3}\n$$\n\nThe above equation simplifies to \n\n$$\nx-2 = \\dfrac{5x}{3}.\n$$\n\nWe can now solve this equation with the addition and multiplication principles:\n\n$$\n\\begin{aligned}3\\cdot (x-2) & =3\\cdot \\frac{5x}{3} \\\\ 3x-6 & =5x \\\\ 3x-5x & =6 \\\\ -2x & =6 \\\\ x & =-3\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186059522 #edb/ref 1069 "e-4236" #edb/ref 17592186045417] [17592186059522 #edb/ref 1071 "Solve the equation $\\dfrac 1{2x-1} = \\dfrac{1}{x+1}.$" #edb/ref 17592186045417] [17592186059522 #edb/ref 1072 #uuid "13f9fd01-802e-5331-b422-b9aa2cdda7ea" #edb/ref 17592186045417] [17592186059522 #edb/ref 1074 "First, we note that\n\n- $x=\\dfrac 12$ cannot be a solution since this would make the denominator on the left-hand side zero, and\n\n- $x=-1$ cannot be a solution since this would make the denominator on the right-hand side zero.\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\dfrac{a}{b} = \\dfrac{c}{d}\\quad\\Longrightarrow\\quad \\dfrac ba =\\dfrac dc\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\dfrac 1{2x-1} = \\dfrac{1}{x+1} \\quad\\Longrightarrow\\quad \\dfrac{2x-1}{1} = \\dfrac{x+1}1\n$$\n\nThe above equation simplifies to\n\n$$\n2x-1 = x+1.\n$$\n\nWe can now solve this equation with the addition principle:\n\n$$\n\\begin{aligned}2x-1 & =x+1 \\\\ 2x-x & =1+1 \\\\ x & =2\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186059706 #edb/ref 1037 #edb/ref 17592186050613 #edb/ref 17592186045417] [17592186059706 #edb/ref 1037 #edb/ref 17592186050749 #edb/ref 17592186045417] [17592186059706 #edb/ref 1038 #edb/ref 17592186060370 #edb/ref 17592186045417] [17592186059706 #edb/ref 1038 #edb/ref 17592186060371 #edb/ref 17592186045417] [17592186059706 #edb/ref 1038 #edb/ref 17592186503715 #edb/ref 17592186045417] [17592186059706 #edb/ref 1039 "Solving Rational Equations with a Variable in One Denominator" #edb/ref 17592186045417] [17592186059706 #edb/ref 1041 #edb/ref 17592186059519 #edb/ref 17592186045417] [17592186059706 #edb/ref 1042 #uuid "4af25d77-e2aa-585a-971f-693c44f34e48" #edb/ref 17592186045417] [17592186059707 #edb/ref 1038 #edb/ref 17592186060372 #edb/ref 17592186045417] [17592186059707 #edb/ref 1038 #edb/ref 17592186060377 #edb/ref 17592186045417] [17592186059707 #edb/ref 1038 #edb/ref 17592186503666 #edb/ref 17592186045417] [17592186059707 #edb/ref 1038 #edb/ref 17592186503684 #edb/ref 17592186045417] [17592186059707 #edb/ref 1039 "Solving Rational Equations with a Binomial in One Denominator" #edb/ref 17592186045417] [17592186059707 #edb/ref 1041 #edb/ref 17592186059520 #edb/ref 17592186045417] [17592186059707 #edb/ref 1042 #uuid "93665eb6-5d3e-52d2-afc6-bc27488190e1" #edb/ref 17592186045417] [17592186059708 #edb/ref 1037 #edb/ref 17592186048725 #edb/ref 17592186045417] [17592186059708 #edb/ref 1038 #edb/ref 17592186060373 #edb/ref 17592186045417] [17592186059708 #edb/ref 1038 #edb/ref 17592186060376 #edb/ref 17592186045417] [17592186059708 #edb/ref 1038 #edb/ref 17592186503661 #edb/ref 17592186045417] [17592186059708 #edb/ref 1038 #edb/ref 17592186503729 #edb/ref 17592186045417] [17592186059708 #edb/ref 1039 "Solving Rational Equations with a Binomial and a Monomial in Denominators" #edb/ref 17592186045417] [17592186059708 #edb/ref 1041 #edb/ref 17592186059521 #edb/ref 17592186045417] [17592186059708 #edb/ref 1042 #uuid "c2c24d70-3bde-5277-bc92-ae081065deee" #edb/ref 17592186045417] [17592186059709 #edb/ref 1037 #edb/ref 17592186048213 #edb/ref 17592186045417] [17592186059709 #edb/ref 1038 #edb/ref 17592186060374 #edb/ref 17592186045417] [17592186059709 #edb/ref 1038 #edb/ref 17592186060375 #edb/ref 17592186045417] [17592186059709 #edb/ref 1038 #edb/ref 17592186234237 #edb/ref 17592186045417] [17592186059709 #edb/ref 1038 #edb/ref 17592186503706 #edb/ref 17592186045417] [17592186059709 #edb/ref 1039 "Solving Rational Equations with Binomials in Both Denominators" #edb/ref 17592186045417] [17592186059709 #edb/ref 1041 #edb/ref 17592186059522 #edb/ref 17592186045417] [17592186059709 #edb/ref 1042 #uuid "387a794f-17ea-5ea9-86a1-656a495f62cb" #edb/ref 17592186045417] [17592186059941 #edb/ref 1043 #edb/ref 17592186060580 #edb/ref 17592186045417] [17592186059941 #edb/ref 1043 #edb/ref 17592186060581 #edb/ref 17592186045417] [17592186059941 #edb/ref 1043 #edb/ref 17592186060582 #edb/ref 17592186045417] [17592186059941 #edb/ref 1043 #edb/ref 17592186060583 #edb/ref 17592186045417] [17592186059941 #edb/ref 1043 #edb/ref 17592186060674 #edb/ref 17592186045417] [17592186059941 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186059941 #edb/ref 1045 "Solving Rational Equations Using the Flip Method" #edb/ref 17592186045417] [17592186059941 #edb/ref 1046 #edb/ref 17592186060674 #edb/ref 17592186045417] [17592186059941 #edb/ref 1049 #edb/ref 17592186050953 #edb/ref 17592186045417] [17592186059941 #edb/ref 1050 420.0 #edb/ref 17592186045417] [17592186059941 #edb/ref 1053 #uuid "780b6d06-4e3c-5fb9-a687-1ad2687e0771" #edb/ref 17592186045417] [17592186060371 #edb/ref 1068 #edb/ref 17592186058848 #edb/ref 17592186045417] [17592186060371 #edb/ref 1069 "q-67325" #edb/ref 17592186045417] [17592186060371 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186060371 #edb/ref 1071 "Solve the equation $-\\frac{1}{2x}=\\frac{3}{5}.$" #edb/ref 17592186045417] [17592186060371 #edb/ref 1072 #uuid "eddd7f11-274f-563c-bc35-743113376d12" #edb/ref 17592186045417] [17592186060371 #edb/ref 1074 "First, we note that $x=0$ cannot be a solution since this would make the denominator on the left-hand side zero.\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n-\\frac{2x}{1}=\\frac{5}{3}\n$$\n\nThe above equation simplifies to\n\n$$\n-2x=\\frac{5}{3}\n$$\n\nWe can now solve this equation using the multiplication principle:\n\n$$\n\\begin{aligned}-2x & =\\frac{5}{3} \\\\ (-\\frac{1}{2})\\cdot (-2x) & =(-\\frac{1}{2})\\cdot \\frac{5}{3} \\\\ \\cancel{(-\\frac{1}{2})}\\cdot (\\cancel{-2}x) & =-\\frac{5}{6} \\\\ x & =-\\frac{5}{6}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186060374 #edb/ref 1068 #edb/ref 17592186058866 #edb/ref 17592186045417] [17592186060374 #edb/ref 1069 "q-67329" #edb/ref 17592186045417] [17592186060374 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186060374 #edb/ref 1071 "Solve the equation $\\frac{6}{x-3}=\\frac{2}{x+6}.$" #edb/ref 17592186045417] [17592186060374 #edb/ref 1072 #uuid "8b4e7858-1264-5def-86e5-7598a8adf5a9" #edb/ref 17592186045417] [17592186060374 #edb/ref 1074 "First, we note that\n\n- $x=3$ cannot be a solution since this would make the denominator on the left-hand side zero\n\n- $x=-6$ cannot be a solution since this would make the denominator on the right-hand side zero\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\frac{x-3}{6}=\\frac{x+6}{2}\n$$\n\nNext, we write both fractions using the least common denominator, $6.$ The equation becomes\n\n$$\n\\frac{x-3}{6}=\\frac{3x+18}{6}.\n$$\n\nWe can now solve this equation with the addition and the multiplication principles:\n\n$$\n\\begin{aligned}6\\cdot \\frac{x-3}{6} & =6\\cdot \\frac{3x+18}{6} \\\\ x-3 & =3x+18 \\\\ x-3x & =18+3 \\\\ -2x & =21 \\\\ (-\\frac{1}{2})(-2x) & =(-\\frac{1}{2})21 \\\\ (-\\cancel{\\frac{1}{2}})(-\\cancel{2}x) & =(-\\frac{1}{2})21 \\\\ x & =-\\frac{21}{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186060377 #edb/ref 1068 #edb/ref 17592186058884 #edb/ref 17592186045417] [17592186060377 #edb/ref 1069 "q-67355" #edb/ref 17592186045417] [17592186060377 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186060377 #edb/ref 1071 "Solve the equation $\\frac{3}{2}=\\frac{1}{x+1}.$" #edb/ref 17592186045417] [17592186060377 #edb/ref 1072 #uuid "6bbc3969-7e62-5072-9fb8-19f0fe79bb27" #edb/ref 17592186045417] [17592186060377 #edb/ref 1074 "First, we note that $x=-1$ cannot be a solution since this would make the denominator on the right-hand side zero.\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\frac{2}{3}=\\frac{x+1}{1}\n$$\n\nThe above equation simplifies to\n\n$$\n\\frac{2}{3}=x+1\n$$\n\nWe can now solve this equation using the addition principle:\n\n$$\n\\begin{aligned}\\frac{2}{3} & =x+1 \\\\ \\frac{2}{3}-1 & =x+1-1 \\\\ -\\frac{1}{3} & =x\\end{aligned}\n$$\n\nWe conclude that the solution is $x=-\\frac{1}{3}.$" #edb/ref 17592186045417] [17592186060580 #edb/ref 1058 #edb/ref 17592186060581 #edb/ref 17592186045417] [17592186060580 #edb/ref 1061 15458 #edb/ref 17592186045417] [17592186060580 #edb/ref 1062 #uuid "a0e30d07-9c41-5c2c-839c-9e49ca64764c" #edb/ref 17592186045417] [17592186060580 #edb/ref 1063 #edb/ref 17592186059706 #edb/ref 17592186045417] [17592186060581 #edb/ref 1058 #edb/ref 17592186060582 #edb/ref 17592186045417] [17592186060581 #edb/ref 1061 15459 #edb/ref 17592186045417] [17592186060581 #edb/ref 1062 #uuid "233132be-0fc4-52d1-9152-818b8c45b168" #edb/ref 17592186045417] [17592186060581 #edb/ref 1063 #edb/ref 17592186059707 #edb/ref 17592186045417] [17592186060582 #edb/ref 1058 #edb/ref 17592186060583 #edb/ref 17592186045417] [17592186060582 #edb/ref 1061 15460 #edb/ref 17592186045417] [17592186060582 #edb/ref 1062 #uuid "13e292aa-c881-5526-9904-6d174bbb856b" #edb/ref 17592186045417] [17592186060582 #edb/ref 1063 #edb/ref 17592186059708 #edb/ref 17592186045417] [17592186060583 #edb/ref 1061 15461 #edb/ref 17592186045417] [17592186060583 #edb/ref 1062 #uuid "634f203a-900b-5f9f-977b-e1bb2ab2c5ab" #edb/ref 17592186045417] [17592186060583 #edb/ref 1063 #edb/ref 17592186059709 #edb/ref 17592186045417] [17592186060674 #edb/ref 1058 #edb/ref 17592186060580 #edb/ref 17592186045417] [17592186060674 #edb/ref 1061 17016 #edb/ref 17592186045417] [17592186060674 #edb/ref 1062 #uuid "b043ea3a-fd3a-5de4-b7ac-21a29627ca53" #edb/ref 17592186045417] [17592186060674 #edb/ref 1063 #edb/ref 17592186060937 #edb/ref 17592186045417] [17592186060937 #edb/ref 1064 "Remember that to solve a rational equation, such as the one below, we can use cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{2}{x} & =\\frac{3}{5} \\\\ 5\\cdot 2 & =3\\cdot x \\\\ 10 & =3x \\\\ \\frac{10}{3} & =x\\end{aligned}\n$$\n\nHowever, there is also another method that we can use, known as the **flip method,** which involves taking the reciprocal of both sides of an equation. So, when an equation involves two fractions, we can \"flip\" them as follows:\n\n$$\n\\dfrac{a}{b} = \\dfrac{c}{d}\\quad\\Longrightarrow\\quad \\dfrac ba =\\dfrac dc\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nThe flip method is useful because it allows us to remove a variable from a denominator. For example, applying the flip method, we have\n\n$$\n\\dfrac{\\color{red}2}{\\color{blue}x}=\\dfrac{\\color{blue}3}{\\color{red}5}  \\quad\\Longrightarrow\\quad \\dfrac{\\color{blue}x}{\\color{red}2} = \\dfrac{\\color{red}5}{\\color{blue}3}.\n$$\n\nNow, we can solve the resulting equation using the multiplication principle:\n\n$$\n\\begin{aligned}2\\cdot \\frac{x}{2} & =2\\cdot \\frac{5}{3} \\\\ \\cancel{2}\\cdot \\frac{x}{\\cancel{2}} & =2\\cdot \\frac{5}{3} \\\\ x & =\\frac{10}{3}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186060937 #edb/ref 1065 3123 #edb/ref 17592186045417] [17592186060937 #edb/ref 1066 #uuid "33bd96be-8ef8-525c-be19-8590b4893b52" #edb/ref 17592186045417] [17592186060937 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186502991 #edb/ref 1080 "\\frac{1}{2}" #edb/ref 17592186045417] [17592186502991 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [175921865