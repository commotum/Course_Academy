#{[{:activity/first-step {:db/id #edb/ref 17592186065089} :activity/id #uuid "7d552a48-87b4-5e70-9852-ea30a169d751" :activity/scope {:db/id #edb/ref 17592186049948 :topic/id #uuid "208ad900-2568-5e64-a594-cff48ca19048" :topic/math-academy-id 299} :activity/steps [{:db/id #edb/ref 17592186065089 :step/content {:db/id #edb/ref 17592186065361 :tutorial/content "Multiplying any number by zero *always* equals zero. Below are some examples.\n\n- $5 \\times 0 = 0$\n- $123\\times 0 = 0$\n- $-314\\,159 \\times 0 = 0$\n- $0\\times 0 = 0$\n\nTo see *why* multiplying any number by zero always equals zero, let's take a look at the multiplication table for $5$, shown below.\n\n$$\n\\begin{aligned}\n5 \\cdot 4 &= 20 \\\\\n5 \\cdot 3 &= 15 \\\\\n5 \\cdot 2 &= 10 \\\\\n5 \\cdot 1 &= 5 \\\\\n5 \\cdot 0 &= ◻\n\\end{aligned}\n$$\n\nAs we go down the list, the number in blue is reduced by $5$ each time. Following this pattern, we must have\n\n$$\n\\color{blue}\\square = 0\n$$\n\n.\n\nNote that, since multiplication is commutative, multiplying zero by any number (including itself) equals zero as well. Some examples are shown below.\n\n- $0 \\times 5 = 0$\n- $0 \\times 123 = 0$\n- $0 \\times -314\\,159 = 0$\n- $0 \\times 0 = 0$" :tutorial/id #uuid "7ed778da-8d5a-5363-972b-d9435e22a0e1" :tutorial/math-academy-id 3119 :tutorial/title "Introduction"} :step/id #uuid "77ea407f-55c3-5258-ba3f-15c16ab12b9a" :step/math-academy-id 16956 :step/next {:db/id #edb/ref 17592186065090}} {:db/id #edb/ref 17592186065090 :step/content {:db/id #edb/ref 17592186064228 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064086 :question/id #uuid "078b5c64-d765-52da-9d87-56c23618c6a6" :question/math-academy-id "e-4635"} :knowledge-point/id #uuid "42032d61-c2d5-5154-9a9d-d93e69d1ba53" :knowledge-point/questions [{:db/id #edb/ref 17592186064769} {:db/id #edb/ref 17592186064923}] :knowledge-point/title "Multiplying a Number by Zero"} :step/id #uuid "32f923a1-966b-5c2d-aa49-a238ba8d46c2" :step/math-academy-id 16957 :step/next {:db/id #edb/ref 17592186065091}} {:db/id #edb/ref 17592186065091 :step/content {:db/id #edb/ref 17592186065363 :tutorial/content "Dividing zero by any number (other than zero) always equals zero. For example:\n\n- $0 \\div 2 = 0$\n- $0\\div (-456) = 0$\n\nTo understand why dividing zero by any number (other than zero) always equals zero, think about it this way: if you have zero pizzas, and you want to divide zero pizzas among ten friends, then each friend will get exactly zero pizza." :tutorial/id #uuid "65c0e3ec-7962-5911-a3c9-9de126e87edc" :tutorial/math-academy-id 3120 :tutorial/title "Dividing Zero by Another Number"} :step/id #uuid "cb642d1f-f4bb-5b57-be91-7221332ef04b" :step/math-academy-id 16959 :step/next {:db/id #edb/ref 17592186065092}} {:db/id #edb/ref 17592186065092 :step/content {:db/id #edb/ref 17592186064229 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064087 :question/id #uuid "897fedd3-db36-5614-886c-c88fba708692" :question/math-academy-id "e-4637"} :knowledge-point/id #uuid "c2097574-c45c-504d-8ec8-44474880cd21" :knowledge-point/questions [{:db/id #edb/ref 17592186064552} {:db/id #edb/ref 17592186064768} {:db/id #edb/ref 17592186433080} {:db/id #edb/ref 17592186433081}] :knowledge-point/title "Dividing Zero by a Number"} :step/id #uuid "28f3ce5f-977b-550b-9bda-7ae39c91c330" :step/math-academy-id 16960 :step/next {:db/id #edb/ref 17592186065093}} {:db/id #edb/ref 17592186065093 :step/content {:db/id #edb/ref 17592186064230 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064088 :question/id #uuid "800d4367-20e6-55a9-8469-7c3654d512a0" :question/math-academy-id "e-4638"} :knowledge-point/id #uuid "3df16e28-70ed-5dd0-9bf0-d56b38f542eb" :knowledge-point/questions [{:db/id #edb/ref 17592186064770} {:db/id #edb/ref 17592186064771} {:db/id #edb/ref 17592186433083} {:db/id #edb/ref 17592186433084}] :knowledge-point/title "Dividing Zero by a Fraction"} :step/id #uuid "a914b898-5054-5bf0-b58e-1526eea6a0fa" :step/math-academy-id 16961 :step/next {:db/id #edb/ref 17592186065094}} {:db/id #edb/ref 17592186065094 :step/content {:db/id #edb/ref 17592186065364 :tutorial/content "Division by zero is **undefined.** No number can be divided by zero, not even zero itself.\n\nTo see why, notice that if we divide $6$ by $3$, we get\n\n$$\n6\\div 3 = 2\n$$\n\nTherefore, by the relationship between multiplication and division, we have\n\n$$\n6 = 3\\times 2\n$$\n\nHowever, this argument does not work if we divide by zero. Suppose we have\n\n$$\n\n$$\n\nThen, by the relationship between multiplication and division, we have\n\n$$\n\n$$\n\nand this relationship cannot be true because any number multiplied by zero is zero! Therefore, $$? is not a number." :tutorial/id #uuid "d8152649-f215-53b2-9811-ce74f0d61dc3" :tutorial/math-academy-id 3121 :tutorial/title "Dividing by Zero is Undefined"} :step/id #uuid "42aa28fe-57c7-5ba0-9e1f-9bced6b58754" :step/math-academy-id 16962 :step/next {:db/id #edb/ref 17592186065095}} {:db/id #edb/ref 17592186065095 :step/content {:db/id #edb/ref 17592186064231 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064089 :question/id #uuid "c2eb29fb-9a40-5db8-b377-14c50b87fd86" :question/math-academy-id "e-4639"} :knowledge-point/id #uuid "c76b2b1b-7536-5b3c-a4c4-6f5e5b72e6ec" :knowledge-point/questions [{:db/id #edb/ref 17592186064553} {:db/id #edb/ref 17592186064924} {:db/id #edb/ref 17592186424816} {:db/id #edb/ref 17592186433082}] :knowledge-point/title "Dividing a Number by Zero"} :step/id #uuid "027aea00-6bd5-5235-9135-7e82295e6484" :step/math-academy-id 16963}] :activity/title "Multiplying and Dividing With Zero" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064402}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186433087} :activity/id #uuid "5979afb1-3102-54e4-800a-b76b986ea6ef" :activity/scope {:db/id #edb/ref 17592186049948 :topic/id #uui