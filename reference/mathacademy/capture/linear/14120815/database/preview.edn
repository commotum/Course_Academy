 & -4 & -1\\end{aligned}].\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}-1 & 1 \\\\ 1 & -4 \\\\ 1 & -1\\end{aligned}]\\cdot {([\\begin{aligned}-1 & 1 & 1 \\\\ 1 & -4 & -1\\end{aligned}]\\cdot [\\begin{aligned}-1 & 1 \\\\ 1 & -4 \\\\ 1 & -1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}-1 & 1 & 1 \\\\ 1 & -4 & -1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 2 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 1 \\\\ 1 & -4 \\\\ 1 & -1\\end{aligned}]\\cdot {[\\begin{aligned}3 & -6 \\\\ -6 & 18\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}0 \\\\ -6\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 1 \\\\ 1 & -4 \\\\ 1 & -1\\end{aligned}]\\cdot \\frac{1}{6}[\\begin{aligned}6 & 2 \\\\ 2 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ -6\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 1 \\\\ 1 & -4 \\\\ 1 & -1\\end{aligned}]\\cdot [\\begin{aligned}-2 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}]\\end{aligned}\n$$\n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x.$\n\nComputing the cosine using the dot product, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{2\\cdot 1+2\\cdot 2+0\\cdot (-1)}{\\sqrt{{2}^{2}+{2}^{2}+{0}^{2}}\\sqrt{{1}^{2}+{2}^{2}+(-1)^{2}}} \\\\  & =\\frac{6}{\\sqrt{8}\\sqrt{6}} \\\\  & =\\frac{\\sqrt{6}}{2\\sqrt{2}} \\\\  & =\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{3}}{2})=\\frac{\\pi }{6},\n$$\n\nwhich is already an acute angle." 13194139534258 17592186045417 true] [17592186416357 1068 #edb/ref 17592186416354 13194139534258 17592186045417 true] [17592186416357 1069 "q-86853" 13194139534258 17592186045417 true] [17592186416357 1070 #edb/ref 17592186045486 13194139534258 17592186045417 true] [17592186416357 1071 "Given the vector $x$ and the system of linear equations below, find the projection of $x$ onto the solution space of the system.\n\n$$\nx=[\\begin{aligned}-7 \\\\ -4 \\\\ 5\\end{aligned}],\\,{\\begin{aligned}{x}_{1}-2{x}_{2}+{x}_{3}=0 \\\\ 3{x}_{1}-6{x}_{2}+3{x}_{3}=0\\end{aligned}\n$$" 13194139534258 17592186045417 true] [17592186416357 1072 #uuid "15ea3713-dc0a-53ca-b70c-c22a6b79a105" 13194139534258 17592186045417 true] [17592186416357 1074 "First, we need to find a basis for the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -2 & 1 & 0 \\\\ 3 & -6 & 3 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 1 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there is $1$ pivot column (the $1$st one). Thus, ${x}_{2},\\,{x}_{3}$ are free variables. Now, from the first equation, we get ${x}_{1}=2{x}_{2}-{x}_{3}.$ Therefore, the general solution is \n\n$$\n[\\begin{aligned}2{x}_{2}-{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}[\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{3}[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}],\\,{x}_{2},\\,{x}_{3}\\in R.\n$$\n\nConsequently, $B={[\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}]}$ is the basis of the solution space of the system. \n\nNow, we find the orthogonal projection of $x$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x \\\\  & =[\\begin{aligned}2 & -1 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {([\\begin{aligned}2 & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 & -1 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}2 & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}-7 \\\\ -4 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -1 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {[\\begin{aligned}5 & -2 \\\\ -2 & 2\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}-18 \\\\ 12\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -1 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot \\frac{1}{6}[\\begin{aligned}2 & 2 \\\\ 2 & 5\\end{aligned}]\\cdot [\\begin{aligned}-18 \\\\ 12\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -1 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}-2 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}-8 \\\\ -2 \\\\ 4\\end{aligned}]\\end{aligned}\n$$" 13194139534258 17592186045417 true] [17592186416358 1068 #edb/ref 17592186416353 13194139534258 17592186045417 true] [17592186416358 1069 "q-139474" 13194139534258 17592186045417 true] [17592186416358 1070 #edb/ref 17592186045485 13194139534258 17592186045417 true] [17592186416358 1071 "Find the distance between the vector $x$ and the subspace spanned by the linearly independent vectors ${{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}-2 \\\\ -1 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}],\\,x=[\\begin{aligned}-2 \\\\ 6 \\\\ 2\\end{aligned}].\n$$" 13194139534258 17592186045417 true] [17592186416358 1072 #uuid "d93f91c3-07ee-5843-9236-38543eb4a92a" 13194139534258 17592186045417 true] [17592186416358 1074 "The orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have \n\n$$\nA=[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]=[\\begin{aligned}-2 & 1 \\\\ -1 & 0 \\\\ 1 & 1\\end{aligned}]\\,⟹\\,{A}^{T}=[\\begin{aligned}-2 & -1 & 1 \\\\ 1 & 0 & 1\\end{aligned}].\n$$\n\nTherefore, we get the following projection: \n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}-2 & 1 \\\\ -1 & 0 \\\\ 1 & 1\\end{aligned}]\\cdot {([\\begin{aligned}-2 & -1 & 1 \\\\ 1 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}-2 & 1 \\\\ -1 & 0 \\\\ 1 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}-2 & -1 & 1 \\\\ 1 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}-2 \\\\ 6 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 1 \\\\ -1 & 0 \\\\ 1 & 1\\end{aligned}]\\cdot {[\\begin{aligned}6 & -1 \\\\ -1 & 2\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 1 \\\\ -1 & 0 \\\\ 1 & 1\\end{aligned}]\\cdot \\frac{1}{11}[\\begin{aligned}2 & 1 \\\\ 1 & 6\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 1 \\\\ -1 & 0 \\\\ 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]=\\overset{^}{x}\\end{aligned}\n$$\n\n \n\nFinally, the distance between $x$ and the subspace $S$ is given by\n\n$$\n\\begin{aligned}d(x,\\overset{^}{x}) & =‖x-\\overset{^}{x}‖ \\\\  & =\\sqrt{({x}_{1}-{\\overset{^}{x}}_{1})^{2}+({x}_{2}-{\\overset{^}{x}}_{2})^{2}+({x}_{3}-{\\overset{^}{x}}_{3})^{2}} \\\\  & =\\sqrt{(-2-0)^{2}+(6-0)^{2}+(2-0)^{2}} \\\\  & =\\sqrt{4+36+4} \\\\  & =\\sqrt{44} \\\\  & =2\\sqrt{11}.\\end{aligned}\n$$" 13194139534258 17592186045417 true] [17592186416359 1068 #edb/ref 17592186416352 13194139534258 17592186045417 true] [17592186416359 1069 "q-39856" 13194139534258 17592186045417 true] [17592186416359 1070 #edb/ref 17592186045487 13194139534258 17592186045417 true] [17592186416359 1071 "Find the acute angle between the vector $x$ and the subspace spanned by the linearly independent vectors ${{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ -1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}],\\,x=[\\begin{aligned}4 \\\\ 0 \\\\ 0\\end{aligned}].\n$$" 13194139534258 17592186045417 true] [17592186416359 1072 #uuid "f6dcfad9-4fa8-567a-ab9a-f61e9f6b1a76" 13194139534258 17592186045417 true] [17592186416359 1074 "The orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]A=[\\begin{aligned}1 & 1 \\\\ -1 & -1 \\\\ -1 & 1\\end{aligned}]\\,⟹\\,{A}^{T}=[\\begin{aligned}1 & -1 & -1 \\\\ 1 & -1 & 1\\end{aligned}].\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}1 & 1 \\\\ -1 & -1 \\\\ -1 & 1\\end{aligned}]\\cdot {([\\begin{aligned}1 & -1 & -1 \\\\ 1 & -1 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 1 \\\\ -1 & -1 \\\\ -1 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}1 & -1 & -1 \\\\ 1 & -1 & 1\\end{aligned}]\\cdot [\\begin{aligned}4 \\\\ 0 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ -1 & -1 \\\\ -1 & 1\\end{aligned}]\\cdot {[\\begin{aligned}3 & 1 \\\\ 1 & 3\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}4 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ -1 & -1 \\\\ -1 & 1\\end{aligned}]\\cdot \\frac{1}{8}[\\begin{aligned}3 & -1 \\\\ -1 & 3\\end{aligned}]\\cdot [\\begin{aligned}4 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ -1 & -1 \\\\ -1 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ -2 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x.$  \n\nComputing the cosine using the dot product, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{x\\cdot {\\text{proj}}_{S}x}{‖x‖‖{\\text{proj}}_{S}x‖} \\\\  & =\\frac{4\\cdot 2+0\\cdot (-2)+0\\cdot 0}{\\sqrt{{4}^{2}+{0}^{2}+{0}^{2}}\\sqrt{{2}^{2}+(-2)^{2}+{0}^{2}}} \\\\  & =\\frac{8}{\\sqrt{16}\\sqrt{8}} \\\\  & =\\frac{8}{4\\cdot 2\\sqrt{2}} \\\\  & =\\frac{1}{\\sqrt{2}} \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{2}}{2})=\\frac{\\pi }{4},\n$$\n\nwhich is already an acute angle." 13194139534258 17592186045417 true] [17592186416360 1058 #edb/ref 17592186416364 13194139534258 17592186045417 true] [17592186416360 1062 #uuid "22bcf45c-640c-