#{[{:db/id #edb/ref 17592186522701 :knowledge-point/_questions [{:db/id #edb/ref 17592186054741 :knowledge-point/id #uuid "e77fe2f6-0e93-5378-aa8d-cc6d5122bdaa" :knowledge-point/title "Finding the Roots of a Rational Function With Common Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c6081c3-38a0-553f-95b3-bb1b79615863" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-3" :db/id #edb/ref 17592186522045} {:answer/id #uuid "7fe183f1-adc3-55ca-a0f5-2cb7c6c206e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No roots" :db/id #edb/ref 17592186522273} {:answer/id #uuid "804cb341-7dd4-5100-bc89-462928a3d075" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=3" :db/id #edb/ref 17592186522275} {:answer/id #uuid "94e6af2f-d3d4-5aa3-96b5-dd921249cb1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-4" :db/id #edb/ref 17592186522324} {:answer/id #uuid "9df9d439-2cc7-5118-ac3a-b34455eb4e49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186522344}] :answer-field/correct {:answer/id #uuid "7fe183f1-adc3-55ca-a0f5-2cb7c6c206e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No roots" :db/id #edb/ref 17592186522273} :answer-field/id #uuid "ce072ed5-fff1-5f57-8574-8b1467c81f11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522655}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "11794345-6933-57d1-83b3-9cd504769483" :question/math-academy-id "q-113152" :question/problem "Find the roots of $f(t)=\\frac{3t-9}{{t}^{2}+t-12}.$" :question/worked-solution "The roots of $f(t)$ are the solutions to the equation $f(t)=0.$ In our case, we have\n\n$$\n\\frac{3t-9}{{t}^{2}+t-12}=0.\n$$\n\nFirst, we factor the numerator and denominator and cancel any common factors, as follows:\n\n$$\n\\begin{aligned}f(t) & =\\frac{3t-9}{{t}^{2}+t-12} \\\\  & =\\frac{3(t-3)}{(t-3)(t+4)} \\\\  & =\\frac{3\\cancel{(t-3)}}{\\cancel{(t-3)}(t+4)} \\\\  & =\\frac{3}{t+4}\\end{aligned}\n$$\n\nSetting the numerator equal to zero, we get $3=0,$ which is a false statement. Therefore, $f(t)=0$ has no solution, and so $f(t)$ has no roots."}] [{:db/id #edb/ref 17592186522751 :knowledge-point/_questions [{:db/id #edb/ref 17592186054742 :knowledge-point/id #uuid "688b4f72-387b-5757-9b81-d24a1d9c727d" :knowledge-point/title "Finding the Roots of a Rational Function Containing a Cubic Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09e45747-6dab-55e5-a4ac-42f5c054c709" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5,\\,5" :db/id #edb/ref 17592186522037} {:answer/id #uuid "3035b6f7-dba3-5eb6-b785-1c9139483a03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186522125} {:answer/id #uuid "55c97b34-1a0c-5fa1-a935-7a5e02916c64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The equation has no solution" :db/id #edb/ref 17592186522199} {:answer/id #uuid "9ea0ed19-e8bc-5906-af88-d2c141f8e4a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2,\\,5" :db/id #edb/ref 17592186522347} {:answer/id #uuid "bba86845-7980-5a1c-8edf-d8acd2d217eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1" :db/id #edb/ref 17592186522408}] :answer-field/correct {:answer/id #uuid "3035b6f7-dba3-5eb6-b785-1c9139483a03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186522125} :answer-field/id #uuid "4500e6f6-1360-506a-b80c-23e6f852f50c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522594}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "87c77350-058a-500e-bb8c-ed314494ab76" :question/math-academy-id "q-113168" :question/problem "Solve $g(y)=0$ where $g(y)=\\frac{{y}^{3}-2{y}^{2}-25y+50}{{y}^{3}+{y}^{2}-25y-25}.$" :question/worked-solution "First, we factor the numerator and denominator and cancel any common factors, as follows:\n\n$$\n\\begin{aligned}g(y) & =\\frac{{y}^{3}-2{y}^{2}-25y+50}{{y}^{3}+{y}^{2}-25y-25} \\\\  & =\\frac{{y}^{2}(y-2)-25(y-2)}{{y}^{2}(y+1)-25(y+1)} \\\\  & =\\frac{(y-2)({y}^{2}-25)}{(y+1)({y}^{2}-25)} \\\\  & =\\frac{(y-2)(y-5)(y+5)}{(y+1)(y-5)(y+5)} \\\\  & =\\frac{(y-2)\\cancel{(y-5)(y+5)}}{(y+1)\\cancel{(y-5)(y+5)}} &  \\\\  & =\\frac{y-2}{y+1}\\end{aligned}\n$$\n\nNow, we set the numerator equal to zero and solve for $y:$\n\n$$\n\\begin{aligned}y-2=0\\,⟹\\,y=2\\end{aligned}\n$$\n\nTherefore, the solution to $g(y)=0$ is $y=2.$"}] [{:db/id #edb/ref 17592186522768 :knowledge-point/_questions [{:db/id #edb/ref 17592186054740 :knowledge-point/id #uuid "3d98f7bd-2351-5eb8-80ff-67adcba4adbc" :knowledge-point/title "Finding the Roots of a Rational Function With a Quadratic Numerator and No Common Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03a4f702-63d6-559a-a0dd-ab624a5eb606" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4" :db/id #edb/ref 17592186522022} {:answer/id #uuid "27570a30-bc64-5dd2-bf7a-c9dfffda49a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=-2" :db/id #edb/ref 17592186522109} {:answer/id #uuid "3e970e43-56e8-51a7-8b67-1a34c8189d31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=-2,4" :db/id #edb/ref 17592186522154} {:answer/id #uuid "609ca3c1-35ba-50ca-a3f5-8ffaec27d898" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The equation has no real solution" :db/id #edb/ref 17592186522219} {:answer/id #uuid "654e9075-d5c0-5942-8335-3af4eecc1069" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2" :db/id #edb/ref 17592186522229}] :answer-field/correct {:answer/id #uuid "609ca3c1-35ba-50ca-a3f5-8ffaec27d898" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The equation has no real solution" :db/id #edb/ref 17592186522219} :answer-field/id #uuid "88c05edb-27ce-5999-bea1-f451f6da5f5a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522626}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "afbc25b8-e022-51c1-8f23-554ddf441b28" :question/math-academy-id "q-24662" :question/problem "Solve $g(z)=0$ where $g(z)=\\frac{{z}^{2}+4}{{z}^{2}-4}.$" :question/worked-solution "First, we factor $g(z),$ as follows:\n\n$$\n\\begin{aligned}g(z) & =\\frac{{z}^{2}+4}{{z}^{2}-4} \\\\  & =\\frac{{z}^{2}+4}{(z+2)(z-2)}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we set the numerator equal to zero and solve for $z:$\n\n$$\n{z}^{2}+4=0\n$$\n\nSince ${z}^{2}+4>0$ for all $z,$ there is no real solution to $g(z)=0.$"}]}
