#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186185016} :activity/id #uuid "a963d35a-d51d-50f7-b102-8821b5ecb011" :activity/scope {:db/id #edb/ref 17592186048132 :topic/id #uuid "81fdc96c-a638-5049-8995-3d48064b08cb" :topic/math-academy-id 3848} :activity/steps [{:db/id #edb/ref 17592186185015 :step/content {:db/id #edb/ref 17592186184225 :knowledge-point/canonical-example {:db/id #edb/ref 17592186184131 :question/id #uuid "cd3fba6a-bb16-51b1-b2ea-fb88656d5aa6" :question/math-academy-id "e-9979"} :knowledge-point/id #uuid "37603549-5c55-5b9e-8d2d-2121db167d02" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049923}] :knowledge-point/questions [{:db/id #edb/ref 17592186184801} {:db/id #edb/ref 17592186184802} {:db/id #edb/ref 17592186503673} {:db/id #edb/ref 17592186503703}] :knowledge-point/title "Combining Radical Expressions"} :step/id #uuid "2a88297e-0c93-59fc-a45e-bb8dc09591fe" :step/math-academy-id 37583 :step/next {:db/id #edb/ref 17592186185195}} {:db/id #edb/ref 17592186185016 :step/content {:db/id #edb/ref 17592186185346 :tutorial/content "The **product rule for radicals** states that the square root of a product equals the product of the square roots:\n\n$$\n\\eqalign{\n\t\t\\sqrt{a} \\cdot \\sqrt{b} = \\sqrt{ab}\n\t}\n$$\n\nWe can use the product rule to combine radical expressions. \n\nFor example, let's suppose we want to combine the radicals in the following expression:\n\n$$\n\\sqrt{5x} \\cdot \\sqrt{6z}\n$$\n\nTo combine the radicals, we apply the product rule as follows:\n\n$$\n\\begin{aligned}\\sqrt{5x}\\cdot \\sqrt{6z} & = \\\\ \\sqrt{5x\\cdot 6z} & = \\\\ \\sqrt{30xz} & \\end{aligned}\n$$" :tutorial/id #uuid "1c9d8f0d-315b-5c83-a8e6-17638c1c3d24" :tutorial/math-academy-id 6200 :tutorial/title "Introduction"} :step/id #uuid "9a6b95b2-a3b2-5264-9183-0fefe3abfed8" :step/math-academy-id 37588 :step/next {:db/id #edb/ref 17592186185015}} {:db/id #edb/ref 17592186185195 :step/content {:db/id #edb/ref 17592186184320 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183935 :question/id #uuid "d669aafc-c1f1-5acd-b7d8-5ff0f31178b0" :question/math-academy-id "e-1361"} :knowledge-point/id #uuid "5fcba20f-b43b-558d-bd84-d76816d3186b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050890}] :knowledge-point/questions [{:db/id #edb/ref 17592186184740} {:db/id #edb/ref 17592186184803} {:db/id #edb/ref 17592186503733} {:db/id #edb/ref 17592186503743} {:db/id #edb/ref 17592186563692} {:db/id #edb/ref 17592186563731}] :knowledge-point/title "Combining Radical Expressions Using the Rules of Absolute Value"} :step/id #uuid "83175ccc-7da0-50d9-b695-82571c0cb353" :step/math-academy-id 4307 :step/next {:db/id #edb/ref 17592186185196}} {:db/id #edb/ref 17592186185196 :step/content {:db/id #edb/ref 17592186185310 :tutorial/content "The product rule for radicals also works for higher-order roots, like the cube root. In the case of the cube root, we have\n\n$$\n\\sqrt[3]{ab} = \\sqrt[3]{a}\\cdot \\sqrt[3]{b}.\n$$\n\nIn general,\n\n$$\n\\sqrt[n]{ab} = \\sqrt[n]{a}\\cdot \\sqrt[n]{b}.\n$$" :tutorial/id #uuid "f9406c08-e6de-514e-aeae-9f581d5730a5" :tutorial/math-academy-id 1607 :tutorial/title "The Product Rule for Cube Roots"} :step/id #uuid "c0a3a07c-d5b4-5d4b-805c-3c93987ee6fe" :step/math-academy-id 4313 :step/next {:db/id #edb/ref 17592186185197}} {:db/id #edb/ref 17592186185197 :step/content {:db/id #edb/ref 17592186184321 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183936 :question/id #uuid "d6b143d1-7d3f-5836-8797-19cb37181541" :question/math-academy-id "e-1364"} :knowledge-point/id #uuid "de2b7926-fa13-5636-9682-8fa382336be7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048170}] :knowledge-point/questions [{:db/id #edb/ref 17592186184500} {:db/id #edb/ref 17592186184501} {:db/id #edb/ref 17592186503701} {:db/id #edb/ref 17592186503731} {:db/id #edb/ref 17592186563675}] :knowledge-point/title "Simplifying a Cube Root Expression"} :step/id #uuid "d028b29f-988d-5038-a9c2-8a95b472232b" :step/math-academy-id 4314}] :activity/title "Combining Radical Expressions Using the Product Rule" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186184432}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186563813} :activity/id #uuid "966a76d8-0c6e-5591-b99a-1917424d151b" :activity/scope {:db/id #edb/ref 17592186048132 :topic/id #uuid "81fdc96c-a638-5049-8995-3d48064b08cb" :topic/math-academy-id 3848} :activity/steps [{:db/id #edb/ref 17592186563770 :step/content {:db/id #edb/ref 17592186563675 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f9d67ae-479b-5212-a32d-ea72ac199fdf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "28\\sqrt[3]{s{t}^{2}}" :db/id #edb/ref 17592186562975} {:answer/id #uuid "3121334e-b5ff-5d7f-b931-c4cc6aff67e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[3]{14st}" :db/id #edb/ref 17592186563057} {:answer/id #uuid "44050778-0a11-5b3d-8de9-552e09f1598c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\sqrt[3]{28s}" :db/id #edb/ref 17592186563097} {:answer/id #uuid "66a4a5e4-546c-53dd-b661-09d0f6e93243" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7\\sqrt[3]{st}" :db/id #edb/ref 17592186563184} {:answer/id #uuid "e708cbcb-204a-515f-a2ee-8880e52ab193" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[3]{28s{t}^{2}}" :db/id #edb/ref 17592186563454}] :answer-field/correct {:db/id #edb/ref 17592186563454} :answer-field/id #uuid "8a3551f7-6554-57bf-8d88-2777fb8978a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563590}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "41a2ad72-53df-54b1-8f6d-95041c4754db" :question/math-academy-id "q-141851" :question/problem "$\\sqrt[3]{4s}\\cdot \\sqrt[3]{7{t}^{2}}=$" :question/worked-solution "We apply the product rule for radicals, as follows:\n\n$$\n\\begin{aligned}\\sqrt[3]{4s}\\cdot \\sqrt[3]{7{t}^{2}} & = \\\\ \\sqrt[3]{4s\\cdot 7{t}^{2}} & = \\\\ \\sqrt[3]{28s{t}^{2}}\\end{aligned}\n$$"} :step/id #uuid "25b65737-ade2-56c9-a926-c3e2f2a2500e"} {:db/id #edb/ref 17592186563777 :step/content {:db/id #edb/ref 17592186563731 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20037864-692e-5bfb-9322-3b5120acbe5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{a}^{2}\\sqrt{10bc}" :db/id #edb/ref 17592186563017} {:answer/id #uuid "4d77eb1e-d305-5769-be60-4814a62a8015" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{a}^{2}b\\sqrt{10c}" :db/id #edb/ref 17592186563119} {:answer/id #uuid "85b799e3-d57c-539f-acb8-811ec4f3f811" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6{a}^{2}\\sqrt{15bc}" :db/id #edb/ref 17592186563246} {:answer/id #uuid "d988c7ff-7f4c-5175-9b2b-46df6a682046" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{a}^{4}{b}^{2}\\sqrt{5c}" :db/id #edb/ref 17592186563421} {:answer/id #uuid "e3bd976f-4efd-55f3-be7f-8f74b45ff7e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6{a}^{2}b\\sqrt{15c}" :db/id #edb/ref 17592186563446}] :answer-field/correct {:db/id #edb/ref 17592186563119} :answer-field/id #uuid "19a40071-b4ac-5acd-960c-d9a0e6445961" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563532}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "bd6c8038-fcc2-5fa5-ad44-54f20efc3514" :question/math-academy-id "q-141498" :question/problem "Simplify $\\sqrt{6{a}^{3}b}\\cdot \\sqrt{15abc}$ given that $a,b,c\\ge 0.$" :question/worked-solution "We perform the multiplication under a single radical and then simplify the result:\n\n$$\n\\begin{aligned}\\sqrt{6{a}^{3}b}\\cdot \\sqrt{15abc} & = \\\\ \\sqrt{6{a}^{3}b\\cdot 15abc} & = \\\\ \\sqrt{90{a}^{4}{b}^{2}c} & = \\\\ \\sqrt{9{a}^{4}{b}^{2}\\cdot 10c} & = \\\\ \\sqrt{(3{a}^{2}b)^{2}\\cdot 10c} & = \\\\ 3\\cdot |{a}^{2}|\\cdot |b|\\cdot \\sqrt{10c}\\end{aligned}\n$$\n\nA squared number is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have that $|{a}^{2}|={a}^{2}$ and $|b|=b.$  Therefore, our final answer is\n\n$$\n\\begin{aligned}3\\cdot |{a}^{2}|\\cdot |b|\\cdot \\sqrt{10c} & = \\\\ 3{a}^{2}b\\sqrt{10c} & .\\end{aligned}\n$$"} :step/id #uuid "3a66b197-3ff8-5d27-8cde-046d95da9317" :step/next {:db/id #edb/ref 17592186563770}} {:db/id #edb/ref 17592186563813 :step/content {:db/id #edb/ref 17592186563692 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02d5136f-8e3c-524a-ae1b-d2c7d6281429" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36{b}^{2}\\sqrt{a}" :db/id #edb/ref 17592186562943} {:answer/id #uuid "4ee323e3-08d6-546b-8935-72052398ce78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36a{b}^{2}\\sqrt{2}" :db/id #edb/ref 17592186563124} {:answer/id #uuid "9a2ab45f-3b8e-59d8-ae0d-a84bcaf91d90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36{b}^{2}\\sqrt{2a}" :db/id #edb/ref 17592186563292} {:answer/id #uuid "cfba2d73-242a-5b18-a815-bc4b2611b506" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6a{b}^{2}\\sqrt{11a}" :db/id #edb/ref 17592186563401} {:answer/id #uuid "fc68b7fb-a728-5929-84b3-caef82248a8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18{b}^{2}\\sqrt{a}" :db/id #edb/ref 17592186563512}] :answer-field/correct {:db/id #edb/ref 17592186563292} :answer-field/id #uuid "1a8b84a5-9da7-5fc7-9d58-31f7e5a5ff16" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563534}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "60bf46ec-c41d-5bd2-93b6-b056ca651773" :question/math-academy-id "q-3077" :question/problem "$2\\sqrt{8a{b}^{3}}\\cdot 3\\sqrt{9b}=$" :question/worked-solution "We perform the multiplication under a single radical and then simplify the result:\n\n$$\n\\begin{aligned}2\\sqrt{8a{b}^{3}}\\cdot 3\\sqrt{9b} & = \\\\ 2\\cdot 3\\sqrt{8a{b}^{3}\\cdot 9b} & = \\\\ 6\\sqrt{72a{b}^{4}} & = \\\\ 6\\sqrt{36{b}^{4}\\cdot 2a} & = \\\\ 6\\sqrt{(6{b}^{2})^{2}\\cdot 2a} & = \\\\ 6\\sqrt{(6{b}^{2})^{2}}\\cdot \\sqrt{2a} & = \\\\ 6\\cdot |6{b}^{2}|\\cdot \\sqrt{2a} & = \\\\ 6\\cdot |6|\\cdot |{b}^{2}|\\cdot \\sqrt{2a} & = \\\\ 6\\cdot 6\\cdot |{b}^{2}|\\cdot \\sqrt{2a}\\end{aligned}\n$$\n\nA squared number is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have\n\n$$\n\\begin{aligned}6\\cdot 6\\cdot |{b}^{2}|\\cdot \\sqrt{2a} & = \\\\ 36\\cdot {b}^{2}\\cdot \\sqrt{2a} & = \\\\ 36{b}^{2}\\sqrt{2a}.\\end{aligned}\n$$"} :step/id #uuid "f58651f1-e6af-576f-8e7f-3b48b9f27e36" :step/next {:db/id #edb/ref 17592186563777}}] :activity/title "Combining Radical Expressions Using the Product Rule" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186562933}]}
