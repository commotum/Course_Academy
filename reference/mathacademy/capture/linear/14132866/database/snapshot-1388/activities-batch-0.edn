#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186065131} :activity/id #uuid "af1ad9c9-eddf-59bb-aedf-24a165cae134" :activity/scope {:db/id #edb/ref 17592186048911 :topic/id #uuid "cbbdf6cb-f6ca-5deb-b060-a316432db0ee" :topic/math-academy-id 327} :activity/steps [{:db/id #edb/ref 17592186065131 :step/content {:db/id #edb/ref 17592186065412 :tutorial/content "When we subtract a positive number from another positive number, we move towards the left on the number line. \n\nFor example, let's consider the following subtraction problem:\n\n$$\n3 - 5\n$$\n\nTo subtract $5$ from $3,$ we start at $3$ on the number line and move $5$ places to the left.\n\n![](images/57/57ac1fe7a28ae5fefadf900d2276d499cdccf01df48b819b0aafa5347a2ec506.png)\n\nWhen we do this, we land at $-2.$ Therefore, \n\n$$\n3-5 = -2.\n$$" :tutorial/id #uuid "8af27dde-6aa4-5067-84f8-9538f1acaa18" :tutorial/math-academy-id 8029 :tutorial/title "Introduction"} :step/id #uuid "e99d8d22-f103-5560-a608-35f0957133f4" :step/math-academy-id 188374 :step/next {:db/id #edb/ref 17592186065132}} {:db/id #edb/ref 17592186065132 :step/content {:db/id #edb/ref 17592186064255 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063935 :question/id #uuid "34280e7c-023c-5c7f-b22b-3f322ff97dad" :question/math-academy-id "e-12813"} :knowledge-point/id #uuid "6a3c970b-4086-52ef-ac0f-2b8c3d72fd51" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049429}] :knowledge-point/questions [{:db/id #edb/ref 17592186064527} {:db/id #edb/ref 17592186064570} {:db/id #edb/ref 17592186064629} {:db/id #edb/ref 17592186433314} {:db/id #edb/ref 17592186433317} {:db/id #edb/ref 17592186433318} {:db/id #edb/ref 17592186433319} {:db/id #edb/ref 17592186433320}] :knowledge-point/title "Subtracting a Positive Number From a Non-Negative Number"} :step/id #uuid "a7e8a41f-1f30-5c54-b22b-c51e7a5efd82" :step/math-academy-id 188375 :step/next {:db/id #edb/ref 17592186065133}} {:db/id #edb/ref 17592186065133 :step/content {:db/id #edb/ref 17592186065413 :tutorial/content "It is impractical to use number lines to subtract large numbers. \n\nHowever, a neat trick makes subtracting a positive number from a smaller positive number very easy!\n\nAs an example, let's consider the following subtraction problem:\n\n$$\n{\\color{red}{37}} - {\\color{blue}{68}}\n$$\n\nSince $68$ is larger than $37,$ the answer *must be negative*.\n\nWe start by solving an easier problem: subtracting the numbers *in the reverse order*. In our case, the reverse problem is\n\n$$\n{\\color{blue}{68}} - {\\color{red}{37}}.\n$$\n\nNext, we carry out the subtraction:\n\n![](images/db/db192e5c1f089e3d4cc2a7b1238392e44a7ba36bff99345a997042c16ebc304f.svg)\n\nSo, we have\n\n$$\n{\\color{blue}{68}} - {\\color{red}{37}} = 31.\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n{\\color{red}{37}} - {\\color{blue}{68}} = -31.\n$$\n\nAnd that's it! \n\nLet's use the same idea to subtract two three-digit numbers." :tutorial/id #uuid "d7dbb60e-47d5-56db-981a-145c532f7ace" :tutorial/math-academy-id 8030 :tutorial/title "Subtraction With Larger Numbers"} :step/id #uuid "12b96179-bf32-5136-bbf1-e7631a656dfb" :step/math-academy-id 188379 :step/next {:db/id #edb/ref 17592186065134}} {:db/id #edb/ref 17592186065134 :step/content {:db/id #edb/ref 17592186064256 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063936 :question/id #uuid "1850f823-4159-5bd1-afac-71d8090c754b" :question/math-academy-id "e-12814"} :knowledge-point/id #uuid "f1c51da0-7569-50c0-b405-c74419d47ef3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049516}] :knowledge-point/questions [{:db/id #edb/ref 17592186064485} {:db/id #edb/ref 17592186064526} {:db/id #edb/ref 17592186064528} {:db/id #edb/ref 17592186433315} {:db/id #edb/ref 17592186433316} {:db/id #edb/ref 17592186433321} {:db/id #edb/ref 17592186433322}] :knowledge-point/title "Subtracting a Positive Number From a Non-Negative Number With Larger Numbers"} :step/id #uuid "9f2475d1-01ac-524a-9a5e-a1adfdc797a2" :step/math-academy-id 188380}] :activity/title "Subtracting a Positive Number From a Smaller Positive Number" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064418}]}
