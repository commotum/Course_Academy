ed} \\\\  &  & \\,\\,\\,1\\,\\,\\, & \\,\\,\\,1\\,\\,\\, & \\,\\,\\,5\\,\\,\\, \\\\ \\,\\,\\,\\,-\\,\\,\\,\\, &  &  & \\,\\,\\,1\\,\\,\\, & \\,\\,\\,6\\,\\,\\, \\\\  &  &  & \\,\\,\\,9\\,\\,\\, & \\,\\,\\,9\\,\\,\\,\\end{aligned}\n$$\n\nSo, we have\n\n$$\n115-16=99.\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n16-115=-99.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d639debe-1fc6-5fc2-8f24-1c814fc71d5c"] :db/ensure [:question/validate]} {:db/id "answer-field-d639debe-1fc6-5fc2-8f24-1c814fc71d5c" :answer-field/id #uuid "d639debe-1fc6-5fc2-8f24-1c814fc71d5c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b36f00b5-fd65-59fa-924c-ea3e3c2ccf25" :answer-field/choices ["answer-c17bb5e6-fd1c-5871-90b2-6a52c5171c2e" "answer-b7b59e3a-7e03-5a12-a413-cb931defb1c7" "answer-b36f00b5-fd65-59fa-924c-ea3e3c2ccf25" "answer-8746249b-a535-5581-824d-07a2dd655aef" "answer-e62f7e81-add4-52c7-96b4-889b216f61f7"] :db/ensure [:answer-field/validate]} {:db/id "answer-c17bb5e6-fd1c-5871-90b2-6a52c5171c2e" :answer/id #uuid "c17bb5e6-fd1c-5871-90b2-6a52c5171c2e" :answer/type :answer.type/math :answer/value "-101" :db/ensure [:answer/validate]} {:db/id "answer-b7b59e3a-7e03-5a12-a413-cb931defb1c7" :answer/id #uuid "b7b59e3a-7e03-5a12-a413-cb931defb1c7" :answer/type :answer.type/math :answer/value "-91" :db/ensure [:answer/validate]} {:db/id "answer-b36f00b5-fd65-59fa-924c-ea3e3c2ccf25" :answer/id #uuid "b36f00b5-fd65-59fa-924c-ea3e3c2ccf25" :answer/type :answer.type/math :answer/value "-99" :db/ensure [:answer/validate]} {:db/id "answer-8746249b-a535-5581-824d-07a2dd655aef" :answer/id #uuid "8746249b-a535-5581-824d-07a2dd655aef" :answer/type :answer.type/math :answer/value "89" :db/ensure [:answer/validate]} {:db/id "answer-e62f7e81-add4-52c7-96b4-889b216f61f7" :answer/id #uuid "e62f7e81-add4-52c7-96b4-889b216f61f7" :answer/type :answer.type/math :answer/value "98" :db/ensure [:answer/validate]} {:db/id 17592186064526 :question/problem "$12-36=${{field-1}}" :question/worked-solution "Since $36$ is larger than $12,$ the answer will be negative.\n\nWe start by solving an easier problem:\n\n$$\n36-12\n$$\n\nNext, we carry out the subtraction:\n\n$$\n\\begin{aligned} &  & \\,\\,\\, & \\,\\,\\, \\\\  &  & \\,\\,\\,3\\,\\,\\, & \\,\\,\\,6\\,\\,\\, \\\\ \\,\\,\\,\\,-\\,\\,\\,\\, &  & \\,\\,\\,1\\,\\,\\, & \\,\\,\\,2\\,\\,\\, \\\\  &  & \\,\\,\\,2\\,\\,\\, & \\,\\,\\,4\\,\\,\\,\\end{aligned}\n$$\n\nSo, we have\n\n$$\n36-12=24.\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n12-36=-24.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186061386 :answer-field/correct "answer-4fac70db-d065-51b6-9ca6-93465e345589" :answer-field/choices ["answer-4fac70db-d065-51b6-9ca6-93465e345589"] :db/ensure [:answer-field/validate]} {:db/id "answer-4fac70db-d065-51b6-9ca6-93465e345589" :answer/id #uuid "4fac70db-d065-51b6-9ca6-93465e345589" :answer/type :answer.type/math :answer/value "-24" :db/ensure [:answer/validate]} {:db/id "question-3bd3baa9-664f-5f07-829f-2e36fa203893" :question/id #uuid "3bd3baa9-664f-5f07-829f-2e36fa203893" :question/math-academy-id "q-2090" :question/problem "$5-30=$" :question/worked-solution "Since $30$ is larger than $5,$ the answer will be negative.\n\nWe start by solving an easier problem:\n\n$$\n30-5\n$$\n\nNext, we carry out the subtraction:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\begin{aligned}\\,\\,2\\end{aligned} & \\,\\,\\,\\begin{aligned}\\,\\,10\\end{aligned} \\\\  &  & \\,\\,\\,3\\,\\,\\, & \\,\\,\\,0\\,\\,\\, \\\\ \\,\\,\\,\\,-\\,\\,\\,\\, &  &  & \\,\\,\\,5\\,\\,\\, \\\\  &  & \\,\\,\\,2\\,\\,\\, & \\,\\,\\,5\\,\\,\\,\\end{aligned}\n$$\n\nSo, we have\n\n$$\n30-5=25.\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n5-30=-25.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-135d3462-40c7-5f61-a7be-266651674f7a"] :db/ensure [:question/validate]} {:db/id "answer-field-135d3462-40c7-5f61-a7be-266651674f7a" :answer-field/id #uuid "135d3462-40c7-5f61-a7be-266651674f7a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bd30fb5e-a371-52e9-ab95-fb89ab333a24" :answer-field/choices ["answer-9feea84a-2090-5f4d-b170-1443528444a8" "answer-bd30fb5e-a371-52e9-ab95-fb89ab333a24" "answer-64d4eb43-4817-5512-b4e4-d70bc0b3f431" "answer-85a40cec-3f1f-58fd-aa1e-f363d7d21dc8" "answer-bc120bfe-a98e-529b-ab1a-418d33f64cfe"] :db/ensure [:answer-field/validate]} {:db/id "answer-9feea84a-2090-5f4d-b170-1443528444a8" :answer/id #uuid "9feea84a-2090-5f4d-b170-1443528444a8" :answer/type :answer.type/math :answer/value "-15" :db/ensure [:answer/validate]} {:db/id "answer-bd30fb5e-a371-52e9-ab95-fb89ab333a24" :answer/id #uuid "bd30fb5e-a371-52e9-ab95-fb89ab333a24" :answer/type :answer.type/math :answer/value "-25" :db/ensure [:answer/validate]} {:db/id "answer-64d4eb43-4817-5512-b4e4-d70bc0b3f431" :answer/id #uuid "64d4eb43-4817-5512-b4e4-d70bc0b3f431" :answer/type :answer.type/math :answer/value "-35" :db/ensure [:answer/validate]} {:db/id "answer-85a40cec-3f1f-58fd-aa1e-f363d7d21dc8" :answer/id #uuid "85a40cec-3f1f-58fd-aa1e-f363d7d21dc8" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "answer-bc120bfe-a98e-529b-ab1a-418d33f64cfe" :answer/id #uuid "bc120bfe-a98e-529b-ab1a-418d33f64cfe" :answer/type :answer.type/math :answer/value "35" :db/ensure [:answer/validate]} {:db/id 17592186065412 :tutorial/content "When we subtract a positive number from another positive number, we move towards the left on the number line. \n\nFor example, let's consider the following subtraction problem:\n\n$$\n3 - 5\n$$\n\nTo subtract $5$ from $3,$ we start at $3$ on the number line and move $5$ places to the left.\n\n![](images/57/57ac1fe7a28ae5fefadf900d2276d499cdccf01df48b819b0aafa5347a2ec506.png)\n\nWhen we do this, we land at $-2.$ Therefore, \n\n$$\n3-5 = -2.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186065413 :tutorial/content "It is impractical to use number lines to subtract large numbers. \n\nHowever, a neat trick makes subtracting a positive number from a smaller positive number very easy!\n\nAs an example, let's consider the following subtraction problem:\n\n$$\n{\\color{red}{37}} - {\\color{blue}{68}}\n$$\n\nSince $68$ is larger than $37,$ the answer *must be negative*.\n\nWe start by solving an easier problem: subtracting the numbers *in the reverse order*. In our case, the reverse problem is\n\n$$\n{\\color{blue}{68}} - {\\color{red}{37}}.\n$$\n\nNext, we carry out the subtraction:\n\n![](images/db/db192e5c1f089e3d4cc2a7b1238392e44a7ba36bff99345a997042c16ebc304f.svg)\n\nSo, we have\n\n$$\n{\\color{blue}{68}} - {\\color{red}{37}} = 31.\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n{\\color{red}{37}} - {\\color{blue}{68}} = -31.\n$$\n\nAnd that's it! \n\nLet's use the same idea to subtract two three-digit numbers." :db/ensure [:tutorial/validate]} {:db/id 17592186064418 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
