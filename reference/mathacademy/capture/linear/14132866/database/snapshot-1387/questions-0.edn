#{[{:db/id #edb/ref 17592186063935 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064255 :knowledge-point/id #uuid "6a3c970b-4086-52ef-ac0f-2b8c3d72fd51" :knowledge-point/title "Subtracting a Positive Number From a Non-Negative Number"}] :question/id #uuid "34280e7c-023c-5c7f-b22b-3f322ff97dad" :question/math-academy-id "e-12813" :question/problem "What is the value of $0 - 4$?" :question/worked-solution "To subtract $4$ from $0$, we start at $0$ on the number line and move $4$ places to the left.\n\n![](images/0b/0b52e781b6de8144eef5248de1941ea102834b77ec9ec07a9c266fd395b2b0e8.png)\n\nWhen we do this, we land at $-4$. Therefore, $0-4 = -4$."}] [{:db/id #edb/ref 17592186063936 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064256 :knowledge-point/id #uuid "f1c51da0-7569-50c0-b405-c74419d47ef3" :knowledge-point/title "Subtracting a Positive Number From a Non-Negative Number With Larger Numbers"}] :question/id #uuid "1850f823-4159-5bd1-afac-71d8090c754b" :question/math-academy-id "e-12814" :question/problem "Find the value of $170 - 281$." :question/worked-solution "Since $281$ is larger than $170$, the answer will be negative.\n\nWe start by solving an easier problem:\n$281 - 170$\n\nNext, we carry out the subtraction:\n\n$$\n2\\begin{vmatrix}8 & 1 \\\\ - & 1\\end{vmatrix}7\\begin{vmatrix}0 \\\\ 1\\end{vmatrix}1 \\mid 1\n$$\n\nSo, we have\n\n$$\n281-170 = 111\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above.\n\nTherefore, we conclude that\n\n$$\n170 - 281 = -111\n$$"}] [{:db/id #edb/ref 17592186064526 :knowledge-point/_questions [{:db/id #edb/ref 17592186064256 :knowledge-point/id #uuid "f1c51da0-7569-50c0-b405-c74419d47ef3" :knowledge-point/title "Subtracting a Positive Number From a Non-Negative Number With Larger Numbers"}] :question/answer-fields [{:answer-field/id #uuid "156fe49c-9c2d-55e0-b505-14d092bff060" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186061386}] :question/id #uuid "b8f6a9f4-4f58-50a4-818d-d75ee08e55ed" :question/math-academy-id "q-170960" :question/problem "$12 - 36 =$ {{field-1}}"}]}
