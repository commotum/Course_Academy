#{[{:db/id #edb/ref 17592186096413 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186096613 :knowledge-point/id #uuid "a71301e9-bc7f-53b9-900e-c3bd37f96b03" :knowledge-point/title "Differentiating the Product of a Constant and the Natural Logarithm Function"}] :question/id #uuid "6624681a-bb00-59db-8df9-4d5a3cd00434" :question/math-academy-id "e-3627" :question/problem "Given that $y=5\\ln x$, find $\\dfrac{\\textrm{d}y}{\\textrm{d}x}.$" :question/worked-solution "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\dfrac{\\textrm{d}}{ \\textrm{d} x}\\left( \\ln x \\right)= \\dfrac{1}{x}\n$$\n\nWe apply our formula and get\n\n$$\n\\eqalign{\n\\dfrac{\\textrm{d}y}{\\textrm{d}x}   & = \\left(5\\ln x\\right)'\\  \n                                                    & = 5 (\\ln x)'\\\n                                                    &=5\\cdot \\dfrac{1}{x}\\\n                                                    &= \\dfrac{5}{x}.\n\t\t\t\t\t\t  \n\n}\n$$"}] [{:db/id #edb/ref 17592186096414 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186096614 :knowledge-point/id #uuid "83ce3c28-857b-5538-b362-cf52526e3688" :knowledge-point/title "Differentiating a Sum Containing a Natural Logarithm Function"}] :question/id #uuid "58d47fb0-cf75-58c4-8eea-f3ae97333159" :question/math-academy-id "e-3628" :question/problem "Given that $f(x)=2\\ln x+x^2-1$, find $f'(x).$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\eqalign{\n\t\t\tf'(x) &= \\left(2\\ln x+x^2-1\\right)'\\\n\t\t\t&=2 \\cdot \\dfrac{1}{x}+2x-0\\\n\t\t\t&=\\dfrac{2}{x}+2x.\n\n}\n$$"}] [{:db/id #edb/ref 17592186096415 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186096615 :knowledge-point/id #uuid "5856f3cc-5423-5a97-b2fd-7f44e0797ec7" :knowledge-point/title "Differentiating a Logarithmic Function With a General Base"}] :question/id #uuid "f61ac550-d62c-558f-b6d5-0d4c9aba8089" :question/math-academy-id "e-3629" :question/problem "Given that $y=4\\log_3 x,$ find $\\dfrac{\\textrm{d}y}{\\textrm{d}x}.$" :question/worked-solution "Here, we apply our formula for the derivative when the base of the logarithm is a number other than $e.$ By doing so, we obtain\n\n$$\n\\eqalign{\n\t\t\t\\dfrac{\\textrm{d}y}{\\textrm{d}x}&=\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(4\\log_3 x\\right)\\\n\t\t\t\t\t\t\t\t\t &=4\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(\\log_3 x\\right)\\\n\t\t\t\t\t\t\t\t\t &=4\\cdot\\dfrac{1}{x \\ln 3}\\\n\t\t\t\t\t\t\t\t\t&=\\dfrac{4}{x \\ln 3}.\n\n}\n$$"}] [{:db/id #edb/ref 17592186096416 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186096616 :knowledge-point/id #uuid "cef7fc21-23f4-5d6a-a208-9963ef23c784" :knowledge-point/title "Calculating the Slope of the Tangent Line of a Logarithmic Function at a Point"}] :question/id #uuid "5eaa00f8-0fd0-5de6-a7c0-965db6de3a5c" :question/math-academy-id "e-3630" :question/problem "Given that $y= \\log_4 x + \\ln x$,  find the slope of the tangent at $x=1.$" :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\dfrac {\\textrm{d}y} {\\textrm{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\eqalign{\n\\dfrac{\\textrm{d}y}{\\textrm{d}x}\n\t\t&= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left( \\log_4 x + \\ln x \\right)\\\n\t\t&= \\dfrac{\\textrm{d}}{\\textrm{d}x}(\\log_4 x) + \\dfrac{\\textrm{d}}{\\textrm{d}x}(\\ln x )\\\n\t\t&= \\dfrac{1}{x\\ln 4} + \\dfrac{1}{x}.\n}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{1}{x\\operatorname{ln}⁡4}+\\frac{1}{x})|}_{x=1} \\\\  & =\\frac{1}{\\operatorname{ln}⁡4}+1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186526083 :knowledge-point/_questions [{:db/id #edb/ref 17592186096615 :knowledge-point/id #uuid "5856f3cc-5423-5a97-b2fd-7f44e0797ec7" :knowledge-point/title "Differentiating a Logarithmic Function With a General Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cf04a0a-0bd8-5d2e-812d-5432f2df6590" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{x}\\text{ }\\operatorname{ln}⁡3-\\frac{5}{x\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186525444} {:answer/id #uuid "685cda01-0888-5a6f-a987-bf7af628d202" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{x}\\text{ }\\operatorname{ln}⁡3+\\frac{1}{x}" :db/id #edb/ref 17592186525470} {:answer/id #uuid "6907ae6b-ecfe-5991-afbd-41207f7fe49d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{4}^{x}\\text{ }\\operatorname{ln}⁡3-\\frac{1}{x\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186525472} {:answer/id #uuid "aad87334-dafd-5198-b9f8-50bb56d246b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{x}+\\frac{5}{x\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186525638} {:answer/id #uuid "ff183bf4-fc17-5f4a-9084-a9260a322616" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{x}\\text{ }\\operatorname{ln}⁡3-\\frac{5}{\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186525843}] :answer-field/correct {:answer/id #uuid "5cf04a0a-0bd8-5d2e-812d-5432f2df6590" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{x}\\text{ }\\operatorname{ln}⁡3-\\frac{5}{x\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186525444} :answer-field/id #uuid "58bb8e68-b3ea-5304-b0a6-2288d1ff79da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525892}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d56133b4-1a38-5a0f-927e-e0aa0995c936" :question/math-academy-id "q-105259" :question/problem "Find ${f}^{′}(x)$ for $f(x)={3}^{x}-5{log}_{2}⁡x.$" :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{x\\operatorname{ln}⁡a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({3}^{x}-5{log}_{2}⁡x) \\\\  & ={3}^{x}\\cdot \\operatorname{ln}⁡3-5\\cdot \\frac{1}{x\\operatorname{ln}⁡2} \\\\  & ={3}^{x}\\text{ }\\operatorname{ln}⁡3-\\frac{5}{x\\operatorname{ln}⁡2}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186526025 :knowledge-point/_questions [{:db/id #edb/ref 17592186096616 :knowledge-point/id #uuid "cef7fc21-23f4-5d6a-a208-9963ef23c784" :knowledge-point/title "Calculating the Slope of the Tangent Line of a Logarithmic Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5055e728-2745-5bd6-aa2d-52f75d5a7936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186525410} {:answer/id #uuid "564f16f8-7148-5fe5-976e-a28969e4028a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{5}" :db/id #edb/ref 17592186525428} {:answer/id #uuid "73dfc5f3-9e80-528c-a5ab-77acda2a98a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186525500} {:answer/id #uuid "85994c7d-f00b-5eeb-877e-5a8a347c02d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186525544} {:answer/id #uuid "d244ce26-b20f-5f01-a9eb-9966bbe28980" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186525730}] :answer-field/correct {:answer/id #uuid "5055e728-2745-5bd6-aa2d-52f75d5a7936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186525410} :answer-field/id #uuid "eb26c42c-3215-5776-a674-4934970fcf28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525965}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5fc69141-ff6d-5890-b291-b49f76733a86" :question/math-academy-id "q-17369" :question/problem "Given that $y=2x-5\\operatorname{ln}⁡x$,  find the slope of the tangent at $x=1.$" :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2x-5\\operatorname{ln}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2x)-5\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x) \\\\  & =2-5\\cdot \\frac{1}{x} \\\\  & =2-\\frac{5}{x}\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(2-\\frac{5}{x})|}_{x=1} \\\\  & =2-\\frac{5}{1} \\\\  & =2-5 \\\\  & =-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097156 :knowledge-point/_questions [{:db/id #edb/ref 17592186096614 :knowledge-point/id #uuid "83ce3c28-857b-5538-b362-cf52526e3688" :knowledge-point/title "Differentiating a Sum Containing a Natural Logarithm Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff507140-fe41-5deb-989d-ac21680f83b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{11}^{x}-\\frac{1}{x}" :db/id #edb/ref 17592186287129} {:answer/id #uuid "070152db-0b56-5a15-9bff-980d661d1882" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{11}^{x}\\operatorname{ln}⁡11-\\frac{5}{x}" :db/id #edb/ref 17592186525220} {:answer/id #uuid "0f08df40-5d30-561e-a821-4262c4d01536" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{11}^{x}\\operatorname{ln}⁡x-\\frac{1}{x}" :db/id #edb/ref 17592186525238} {:answer/id #uuid "41a952b2-de1e-529f-89c0-b1bbc3304929" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡11+\\frac{5}{x}" :db/id #edb/ref 17592186525370} {:answer/id #uuid "e322243b-c805-52e3-9ad1-1204b6682a3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{11}^{x}-\\operatorname{ln}⁡11-\\frac{5}{x}" :db/id #edb/ref 17592186525767}] :answer-field/correct {:answer/id #uuid "070152db-0b56-5a15-9bff-980d661d1882" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{11}^{x}\\operatorname{ln}⁡11-\\frac{5}{x}" :db/id #edb/ref 17592186525220} :answer-field/id #uuid "38feddcb-991e-5fb6-9fb0-47bd31940554" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287264}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1cb4423b-343c-5035-85a6-f38acaa8835d" :question/math-academy-id "q-1919" :question/problem "Find ${f}^{′}(x)$ for $f(x)={11}^{x}-5\\operatorname{ln}⁡x.$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({11}^{x}-5\\operatorname{ln}⁡x) \\\\  & ={11}^{x}\\cdot \\operatorname{ln}⁡11-5(\\frac{1}{x}) \\\\  & ={11}^{x}\\operatorname{ln}⁡11-\\frac{5}{x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097157 :knowledge-point/_questions [{:db/id #edb/ref 17592186096614 :knowledge-point/id #uuid "83ce3c28-857b-5538-b362-cf52526e3688" :knowledge-point/title "Differentiating a Sum Containing a Natural Logarithm Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "282e3b77-3571-5c6a-ba34-714702518211" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{e}^{x}+\\frac{1}{x}" :db/id #edb/ref 17592186525302} {:answer/id #uuid "695f7304-4997-5fe5-a040-194fb430bdcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5{e}^{x}\\operatorname{ln}⁡x+\\frac{1}{x}" :db/id #edb/ref 17592186525474} {:answer/id #uuid "ac7327e1-20db-51a3-96cb-1e6ba6555a8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5{e}^{x}-\\operatorname{ln}⁡3+\\frac{2}{x}" :db/id #edb/ref 17592186525643} {:answer/id #uuid "e0897052-84de-574b-9163-c775144bbcb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5{e}^{x}+\\frac{2}{x}" :db/id #edb/ref 17592186525763} {:answer/id #uuid "e65d93b3-13ff-5e6a-9e5c-9bdc1d72afed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5{e}^{x}ln-5+\\frac{2}{x}" :db/id #edb/ref 17592186525775}] :answer-field/correct {:answer/id #uuid "e0897052-84de-574b-9163-c775144bbcb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5{e}^{x}+\\frac{2}{x}" :db/id #edb/ref 17592186525763} :answer-field/id #uuid "e0978740-9d55-5364-bce6-ab2f65f0ed46" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094915}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e09c4141-d749-574e-b1a3-1f49f5b7e3d8" :question/math-academy-id "q-1920" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=-5{e}^{x}+2\\operatorname{ln}⁡x.$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-5{e}^{x}+2\\operatorname{ln}⁡x) \\\\  & =-5{e}^{x}+2(\\frac{1}{x}) \\\\  & =-5{e}^{x}+\\frac{2}{x}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186526008 :knowledge-point/_questions [{:db/id #edb/ref 17592186096614 :knowledge-point/id #uuid "83ce3c28-857b-5538-b362-cf52526e3688" :knowledge-point/title "Differentiating a Sum Containing a Natural Logarithm Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fa4d90f-a918-5ed3-b385-36da02a383b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{x}+\\sqrt{5}\\,{x}^{\\sqrt{5}-1}" :db/id #edb/ref 17592186525317}] :answer-field/correct {:answer/id #uuid "2fa4d90f-a918-5ed3-b385-36da02a383b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{x}+\\sqrt{5}\\,{x}^{\\sqrt{5}-1}" :db/id #edb/ref 17592186525317} :answer-field/id #uuid "d43d0069-7eca-5550-b958-b760fbd1e40e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186525951}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3937eb65-3904-5741-a603-d6263de51574" :question/math-academy-id "q-339969" :question/problem "Given that $y=4\\operatorname{ln}⁡x+{x}^{\\sqrt{5}}+7$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$ \n{{field-1}}" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(4\\operatorname{ln}⁡x+3{x}^{\\sqrt{5}}+7) \\\\  & =4(\\frac{1}{x})+(\\sqrt{5}\\,{x}^{\\sqrt{5}-1}) \\\\  & =\\frac{4}{x}+\\sqrt{5}\\,{x}^{\\sqrt{5}-1}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186314898 :knowledge-point/_questions [{:db/id #edb/ref 17592186096615 :knowledge-point/id #uuid "5856f3cc-5423-5a97-b2fd-7f44e0797ec7" :knowledge-point/title "Differentiating a Logarithmic Function With a General Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "277904a9-9e9e-53f0-a87c-616303962482" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "55-\\frac{1}{\\operatorname{ln}6}" :db/id #edb/ref 17592186312275} {:answer/id #uuid "fce43cba-9363-5793-89ef-2161d7a4191d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "55-\\frac{1}{\\ln 6}" :db/id #edb/ref 17592186525833}] :answer-field/correct {:answer/id #uuid "fce43cba-9363-5793-89ef-2161d7a4191d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "55-\\frac{1}{\\ln 6}" :db/id #edb/ref 17592186525833} :answer-field/id #uuid "0bb11537-ff22-5776-85db-c4e4d92da407" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314045}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b9fb0b98-97be-5fa4-a0a8-73b036fd9d03" :question/math-academy-id "q-339994" :question/problem "Given the function $y=2{x}^{3}+x-3{log}_{6}⁡x,$ find the instantaneous rate of change at $x=3.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=3$ is\n{{field-1}}." :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{x\\operatorname{ln}⁡a}.\n$$\n\nTo find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}+x-3{log}_{6}⁡x) \\\\  & =2\\cdot 3{x}^{2}+1-3\\cdot \\frac{1}{x\\operatorname{ln}⁡6} \\\\  & =6{x}^{2}+1-\\frac{3}{x\\operatorname{ln}⁡6}.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=3$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=3} & ={(6{x}^{2}+1-\\frac{3}{x\\operatorname{ln}⁡6})|}_{x=3} \\\\  & =6(3)^{2}+1-\\frac{3}{3\\cdot \\operatorname{ln}⁡6} \\\\  & =55-\\frac{1}{\\operatorname{ln}⁡6}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186314912 :knowledge-point/_questions [{:db/id #edb/ref 17592186096614 :knowledge-point/id #uuid "83ce3c28-857b-5538-b362-cf52526e3688" :knowledge-point/title "Differentiating a Sum Containing a Natural Logarithm Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39500646-122f-5de4-a3f8-1b1dfa91aa61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\frac{4}{3}\\operatorname{ln}(2)" :db/id #edb/ref 17592186312439} {:answer/id #uuid "c5134f79-de9b-56b2-8b51-7a5d813bddac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\frac{4\\ln 2}{3}" :db/id #edb/ref 17592186525705}] :answer-field/correct {:answer/id #uuid "c5134f79-de9b-56b2-8b51-7a5d813bddac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\frac{4\\ln 2}{3}" :db/id #edb/ref 17592186525705} :answer-field/id #uuid "c1560d5a-5716-563a-970a-84ea931d3b0b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314550}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "905686ba-b3f6-58e7-998d-63ec7c2c2866" :question/math-academy-id "q-340104" :question/problem "Given the function  $y=4\\operatorname{ln}⁡x-\\frac{1}{3}\\cdot {2}^{x}+5$, find the instantaneous rate of change at $x=2.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=2$ is\n{{field-1}}." :question/worked-solution "To find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(4\\operatorname{ln}⁡x-\\frac{1}{3}\\cdot {2}^{x}+5) \\\\  & =\\frac{4}{x}-\\frac{1}{3}\\cdot {2}^{x}\\operatorname{ln}⁡(2).\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=2$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={(\\frac{4}{x}-\\frac{1}{3}\\cdot {2}^{x}\\operatorname{ln}⁡(2))|}_{x=2} \\\\  & =\\frac{4}{2}-\\frac{1}{3}\\cdot {2}^{2}\\operatorname{ln}⁡(2) \\\\  & =2-\\frac{4}{3}\\operatorname{ln}⁡(2)\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186526067 :knowledge-point/_questions [{:db/id #edb/ref 17592186096616 :knowledge-point/id #uuid "cef7fc21-23f4-5d6a-a208-9963ef23c784" :knowledge-point/title "Calculating the Slope of the Tangent Line of a Logarithmic Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7cfc336-57d9-5dec-907f-338b4a0deb28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4-\\frac{3}{\\ln 2}" :db/id #edb/ref 17592186525780}] :answer-field/correct {:answer/id #uuid "e7cfc336-57d9-5dec-907f-338b4a0deb28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4-\\frac{3}{\\ln 2}" :db/id #edb/ref 17592186525780} :answer-field/id #uuid "a8fbe119-4292-551a-8361-7221b4390c27" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186525931}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ada1f0d5-c981-59b4-bce0-235ff7c6a380" :question/math-academy-id "q-340112" :question/problem "Given the function $y=-3{log}_{2}⁡x+4\\operatorname{ln}⁡x-5,$ the slope of the tangent line at $x=1$ is{{field-1}}." :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-3{log}_{2}⁡x+4\\operatorname{ln}⁡x-5) \\\\  & =-3\\frac{\\text{d}}{\\text{d}x}({log}_{2}⁡x)+4\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x)+\\frac{\\text{d}}{\\text{d}x}(-5) \\\\  & =-3\\cdot \\frac{1}{x\\operatorname{ln}⁡2}+4\\cdot \\frac{1}{x}+0 \\\\  & =-\\frac{3}{x\\operatorname{ln}⁡2}+\\frac{4}{x}\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(-\\frac{3}{x\\operatorname{ln}⁡2}+\\frac{4}{x})|}_{x=1} \\\\  & =-\\frac{3}{1\\cdot \\operatorname{ln}⁡2}+\\frac{4}{1} \\\\  & =4-\\frac{3}{\\operatorname{ln}⁡2}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186526014 :knowledge-point/_questions [{:db/id #edb/ref 17592186096613 :knowledge-point/id #uuid "a71301e9-bc7f-53b9-900e-c3bd37f96b03" :knowledge-point/title "Differentiating the Product of a Constant and the Natural Logarithm Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3be6398b-72ea-5680-8cab-aa7da8cbf075" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4x}" :db/id #edb/ref 17592186525352} {:answer/id #uuid "7b7d9e39-128e-5483-b6bb-f240e6bc751e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4x}" :db/id #edb/ref 17592186525513} {:answer/id #uuid "7f778359-dbac-5e42-9c14-e4ed66dfc4f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{x}" :db/id #edb/ref 17592186525521} {:answer/id #uuid "85cd2de0-1d1e-5a84-9740-a8680df5a642" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{x}" :db/id #edb/ref 17592186525546} {:answer/id #uuid "f1e22649-5794-5e1c-9be5-cb8a4f5f5c28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{x}" :db/id #edb/ref 17592186525807}] :answer-field/correct {:answer/id #uuid "7b7d9e39-128e-5483-b6bb-f240e6bc751e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4x}" :db/id #edb/ref 17592186525513} :answer-field/id #uuid "3fce1adb-76f0-545b-a5e4-be69ad432788" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525879}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4890c920-695d-52f8-8b20-5f7886a5c8be" :question/math-academy-id "q-70887" :question/problem "Given that $y=\\frac{\\operatorname{ln}⁡x}{4}$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x)=\\frac{1}{x}\n$$\n\nWe apply our formula and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{ln}⁡x}{4}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{4}\\,\\operatorname{ln}⁡x) \\\\  & =\\frac{1}{4}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x) \\\\  & =\\frac{1}{4}\\cdot \\frac{1}{x} \\\\  & =\\frac{1}{4x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186526101 :knowledge-point/_questions [{:db/id #edb/ref 17592186096613 :knowledge-point/id #uuid "a71301e9-bc7f-53b9-900e-c3bd37f96b03" :knowledge-point/title "Differentiating the Product of a Constant and the Natural Logarithm Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d4682da-deff-5183-90cf-e39fcf5b3165" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6+\\frac{e}{x}" :db/id #edb/ref 17592186525270} {:answer/id #uuid "548d1f5f-cdfd-5fdd-9275-b9a6b9ecb7bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e}{6x}" :db/id #edb/ref 17592186525426} {:answer/id #uuid "7050daed-4adc-5e52-9565-12b1e7729268" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+\\frac{6}{x}" :db/id #edb/ref 17592186525488} {:answer/id #uuid "81d3e063-0cda-5d7d-bf76-b3404db639f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{ex}" :db/id #edb/ref 17592186525532} {:answer/id #uuid "f8950131-4593-5298-bfa0-f7c969d206fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6e}{x}" :db/id #edb/ref 17592186525822}] :answer-field/correct {:answer/id #uuid "f8950131-4593-5298-bfa0-f7c969d206fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6e}{x}" :db/id #edb/ref 17592186525822} :answer-field/id #uuid "586da03f-efe3-51c9-b69d-a4e8f3d33fcd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525891}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f8867c14-c978-5609-8feb-155bfedae13c" :question/math-academy-id "q-70889" :question/problem "Given that $y=6e\\operatorname{ln}⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x)=\\frac{1}{x}\n$$\n\nWe apply our formula and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(6e\\operatorname{ln}⁡x) \\\\  & =6e\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x) \\\\  & =6e\\cdot \\frac{1}{x} \\\\  & =\\frac{6e}{x}.\\end{aligned}\n$$"}]}
