#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186065276} :activity/id #uuid "273c64d6-9225-51a9-8513-982dcfdd1973" :activity/scope {:db/id #edb/ref 17592186048546 :topic/id #uuid "a8d02ba6-b6bf-5189-bb4e-2eec42cf7133" :topic/math-academy-id 329} :activity/steps [{:db/id #edb/ref 17592186065276 :step/content {:db/id #edb/ref 17592186065430 :tutorial/content "There are two ways to add a positive number to a negative number. Let's work out the value of $-5+7$ using both methods.\n\n**Method 1 - Picturing a Number Line**\n\nWhen we add, we move to the right on the number line.\n\nSo, to add $7$ to $-5,$ we start at $-5$ on a number line and move $7$ spaces to the right.\n\n![](images/e6/e6f99b09208d09824dc7c4e6dfaafdc0e20feb7fde00f821a57a70d79196936d.png)\n\n \n\nWhen we do this, we land at $2.$ Therefore, $-5+7 =2.$\n\n**Method 2 - Subtraction in Reverse**\n\nAdding a positive number to a negative number is like *subtraction in reverse*. To turn the addition into a subtraction, we must switch the numbers around.\n\nSo, to work out ${\\color{red}{-5}} + {\\color{blue}{7}},$ we can switch the numbers around to get \n$\\,{\\color{blue}{7}} {\\color{red}{\\,-\\,5}} =2.$\n\nWe're allowed to swap the numbers because addition is **commutative**, which means the order in which we add two numbers does not matter." :tutorial/id #uuid "fea61476-1945-5134-8063-3e50b2865f8f" :tutorial/math-academy-id 8382 :tutorial/title "Introduction"} :step/id #uuid "1c01112c-13ce-5b10-8825-cd205fd87939" :step/math-academy-id 74975 :step/next {:db/id #edb/ref 17592186065277}} {:db/id #edb/ref 17592186065277 :step/content {:db/id #edb/ref 17592186064354 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063965 :question/id #uuid "4d61f8ae-cf47-5aa7-96f8-770a232509ea" :question/math-academy-id "e-13380"} :knowledge-point/id #uuid "09d49af8-8aed-5434-bbf4-12c90c658fc0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048911}] :knowledge-point/questions [{:db/id #edb/ref 17592186064487} {:db/id #edb/ref 17592186064555} {:db/id #edb/ref 17592186445414}] :knowledge-point/title "Adding a Positive Number to a Negative Number"} :step/id #uuid "d317273f-64d9-5382-91e1-beb5ef25c23c" :step/math-academy-id 74976 :step/next {:db/id #edb/ref 17592186065278}} {:db/id #edb/ref 17592186065278 :step/content {:db/id #edb/ref 17592186064355 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063966 :question/id #uuid "a92db588-62a8-5a19-8420-a38d25dd9088" :question/math-academy-id "e-13381"} :knowledge-point/id #uuid "b20f6b97-6531-5ece-a1d0-4d25d4895dab" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048207}] :knowledge-point/questions [{:db/id #edb/ref 17592186064486} {:db/id #edb/ref 17592186064760} {:db/id #edb/ref 17592186064761} {:db/id #edb/ref 17592186445412} {:db/id #edb/ref 17592186445413} {:db/id #edb/ref 17592186445415} {:db/id #edb/ref 17592186506520}] :knowledge-point/title "Adding a Positive Decimal to a Negative Decimal"} :step/id #uuid "fdbb7f5d-0de1-5533-a248-8d52ffb6de29" :step/math-academy-id 74979 :step/next {:db/id #edb/ref 17592186065279}} {:db/id #edb/ref 17592186065279 :step/content {:db/id #edb/ref 17592186065431 :tutorial/content "Suppose that we want to calculate $-\\dfrac 1 3 + \\dfrac 5 3.$\n\nSince both fractions have a common denominator of $3,$ we can combine them to form one fraction:\n\n \n\n$$\n-\\dfrac{1}{3} + \\dfrac{5}{3} =\\dfrac{-1+5}{3}\n$$\n\nTo compute the numerator, we can use either method that we've learned.\n\n**Method 1 - Picturing a Number Line**\n\nTo add $5$ to $-1,$ we start at $-1$ on a number line and move $5$ spaces to the right.\n\n![](images/63/632e4bcce5b619f9a5c4dfb2c414a33da0e9567b7b4d8b15adb439da1b3dd88d.png)\n\nWe end up at $4.$ So $-1+5=4,$ and therefore\n\n$$\n\\dfrac{-1+5}{3} = \\dfrac{4}{3}.\n$$\n\n**Method 2 - Subtraction in Reverse**\n\nWe can swap the order of the numbers in the numerator and then compute the resulting subtraction:\n\n$$\n\\begin{aligned}\\frac{-1+5}{3}=\\frac{5-1}{3}=\\frac{4}{3}\\end{aligned}\n$$\n\nSo, we conclude that $-\\dfrac1 3 + \\dfrac 5 3 = \\dfrac{4}{3}.$\n\n**Note:** If two fractions have different denominators, we need to put them over a common denominator *first* and *then* subtract!" :tutorial/id #uuid "9522d6a9-a066-57d7-bf8a-e4baf0467548" :tutorial/math-academy-id 8383 :tutorial/title "Adding a Positive Fraction to a Negative Fraction"} :step/id #uuid "51a3f9a7-44e9-5617-afa0-b6145e79910d" :step/math-academy-id 74983 :step/next {:db/id #edb/ref 17592186065280}} {:db/id #edb/ref 17592186065280 :step/content {:db/id #edb/ref 17592186064356 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063967 :question/id #uuid "a287913a-827a-56fa-8bbf-5f716dff277e" :question/math-academy-id "e-13382"} :knowledge-point/id #uuid "169a836e-5209-53a1-bda9-0542b044819d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048639}] :knowledge-point/questions [{:db/id #edb/ref 17592186064464} {:db/id #edb/ref 17592186064465} {:db/id #edb/ref 17592186064488} {:db/id #edb/ref 17592186445410} {:db/id #edb/ref 17592186445411} {:db/id #edb/ref 17592186506563}] :knowledge-point/title "Adding a Positive Fraction to a Negative Fraction"} :step/id #uuid "fb6f62cc-a440-5782-82f3-8987d7d10530" :step/math-academy-id 74984}] :activity/title "Adding a Positive Number to a Negative Number" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064420}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186506636} :activity/id #uuid "c18cf1f6-b782-529c-9687-b480366e0abb" :activity/scope {:db/id #edb/ref 17592186048546 :topic/id #uuid "a8d02ba6-b6bf-5189-bb4e-2eec42cf7133" :topic/math-academy-id 329} :activity/steps [{:db/id #edb/ref 17592186506605 :step/content {:db/id #edb/ref 17592186506563 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c6f050c-347c-5715-bfbc-fa64bfc3a91e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186505934} {:answer/id #uuid "a465af2b-dec0-551b-ba69-d768948fa6a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186506210} {:answer/id #uuid "b200d3b9-1e60-511b-aaa3-c5cd7e7271c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186506236} {:answer/id #uuid "cf755884-e084-5588-aa54-d216bf7e6e7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186506281} {:answer/id #uuid "db32d174-5601-574a-a970-b10c4b349d19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186506305}] :answer-field/correct {:db/id #edb/ref 17592186506210} :answer-field/id #uuid "246cfafb-6189-5729-9be6-ca9bbaab24e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186506394}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "89efd351-a602-5741-a803-e137883a9ffc" :question/math-academy-id "q-42784" :question/problem "$-1+\\frac{8}{5}=$" :question/worked-solution "We put both fractions over a common denominator of $5$ and then add the numerators. This gives\n\n$$\n-1+\\frac{8}{5}=-\\frac{5}{5}+\\frac{8}{5}=\\frac{-5+8}{5}.\n$$\n\nTo compute the numerator, we can use either Method 1 or Method 2, shown below.\n\n**Method 1 - Picturing a Number Line**\n\nTo add $8$ to $-5,$ we start at $-5$ on a number line and move $8$ spaces to the right.\n\n![](images/0b/0b6274b1cb65e330c81602212fe081835eb86c1c1c8e3a6eee278fbfd2614776.png)\n\nSo, $-5+8=3.$ Therefore,\n\n$$\n\\frac{-5+8}{5}=\\frac{3}{5}.\n$$\n\n**Method 2 - Subtraction in Reverse**\n\nWe can swap the order of the numbers in the numerator, and we get\n\n$$\n\\frac{-5+8}{5}=\\frac{8-5}{5}=\\frac{3}{5}.\n$$\n\nSo, we conclude that $-1+\\frac{8}{5}=\\frac{3}{5}.$"} :step/id #uuid "0efb6d7a-37b4-5a9c-baab-888a01b1d387" :step/next {:db/id #edb/ref 17592186506658}} {:db/id #edb/ref 17592186506636 :step/content {:db/id #edb/ref 17592186064760 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c743cd40-625d-55c6-9c5b-b5a5b871563b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3.1" :db/id #edb/ref 17592186062618} {:answer/id #uuid "02f23049-e390-5fca-8974-84f16959bd6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.3" :db/id #edb/ref 17592186062619} {:answer/id #uuid "46091aa3-9fcd-5a1e-9cda-cd6e11aa6038" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.5" :db/id #edb/ref 17592186062620} {:answer/id #uuid "5d9d4ef8-4ce8-5fdd-ac61-f6a1121f8752" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1.4" :db/id #edb/ref 17592186062621} {:answer/id #uuid "5daf76c0-c6a7-5b84-8785-520561b0bf37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.5" :db/id #edb/ref 17592186062622}] :answer-field/correct {:db/id #edb/ref 17592186062622} :answer-field/id #uuid "14e0f7dc-27b2-569b-b94e-ce8ea1e731e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186062617}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f7767196-7c4f-505d-9cb8-74af84712773" :question/math-academy-id "q-42736" :question/problem "$-2+4.5=$" :question/worked-solution "We can swap the order of the numbers and then compute the resulting subtraction:\n\n$$\n-2+4.5=4.5-2=2.5\n$$"} :step/id #uuid "85d85619-b8de-50f5-92ee-a08b512ce531" :step/next {:db/id #edb/ref 17592186506605}} {:db/id #edb/ref 17592186506658 :step/content {:db/id #edb/ref 17592186506520 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a1c250d-164f-5f47-9a26-9438d7f566ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2.31" :db/id #edb/ref 17592186505932} {:answer/id #uuid "8ecb71be-9558-5f7e-9c24-85c0d2bdee86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1.88" :db/id #edb/ref 17592186506155} {:answer/id #uuid "b816418a-a268-5949-8a85-901c9d55dd6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2.09" :db/id #edb/ref 17592186506245} {:answer/id #uuid "c029931b-c7eb-5a6d-a179-f9ea69c5f61e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2.91" :db/id #edb/ref 17592186506259} {:answer/id #uuid "e209064d-2e8c-507a-bfa5-d4017ece1766" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1.91" :db/id #edb/ref 17592186506325}] :answer-field/correct {:db/id #edb/ref 17592186506245} :answer-field/id #uuid "59340a3d-da2b-598b-9af5-fbf05febf9c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186506415}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1c8e8af8-f023-59d2-a762-8f1491820c16" :question/math-academy-id "q-128260" :question/problem "$-4.69+2.6=$" :question/worked-solution "We can swap the order of the numbers and then compute the resulting subtraction:\n\n$$\n-4.69+2.6=2.6-4.69=-2.09\n$$"} :step/id #uuid "e6925eb7-f263-5012-a586-f8fa6ea699aa"}] :activity/title "Adding a Positive Number to a Negative Number" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186505913}]}
