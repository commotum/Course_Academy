#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186506636} :activity/id #uuid "c18cf1f6-b782-529c-9687-b480366e0abb" :activity/scope {:db/id #edb/ref 17592186048546 :topic/id #uuid "a8d02ba6-b6bf-5189-bb4e-2eec42cf7133" :topic/math-academy-id 329} :activity/steps [{:db/id #edb/ref 17592186506605 :step/content {:db/id #edb/ref 17592186506563 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c6f050c-347c-5715-bfbc-fa64bfc3a91e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186505934} {:answer/id #uuid "a465af2b-dec0-551b-ba69-d768948fa6a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186506210} {:answer/id #uuid "b200d3b9-1e60-511b-aaa3-c5cd7e7271c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186506236} {:answer/id #uuid "cf755884-e084-5588-aa54-d216bf7e6e7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186506281} {:answer/id #uuid "db32d174-5601-574a-a970-b10c4b349d19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186506305}] :answer-field/correct {:db/id #edb/ref 17592186506210} :answer-field/id #uuid "246cfafb-6189-5729-9be6-ca9bbaab24e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186506394}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "89efd351-a602-5741-a803-e137883a9ffc" :question/math-academy-id "q-42784" :question/problem "$-1+\\frac{8}{5}=$" :question/worked-solution "We put both fractions over a common denominator of $5$ and then add the numerators. This gives\n\n$$\n-1+\\frac{8}{5}=-\\frac{5}{5}+\\frac{8}{5}=\\frac{-5+8}{5}.\n$$\n\nTo compute the numerator, we can use either Method 1 or Method 2, shown below.\n\n**Method 1 - Picturing a Number Line**\n\nTo add $8$ to $-5,$ we start at $-5$ on a number line and move $8$ spaces to the right.\n\n![](images/0b/0b6274b1cb65e330c81602212fe081835eb86c1c1c8e3a6eee278fbfd2614776.png)\n\nSo, $-5+8=3.$ Therefore,\n\n$$\n\\frac{-5+8}{5}=\\frac{3}{5}.\n$$\n\n**Method 2 - Subtraction in Reverse**\n\nWe can swap the order of the numbers in the numerator, and we get\n\n$$\n\\frac{-5+8}{5}=\\frac{8-5}{5}=\\frac{3}{5}.\n$$\n\nSo, we conclude that $-1+\\frac{8}{5}=\\frac{3}{5}.$"} :step/id #uuid "0efb6d7a-37b4-5a9c-baab-888a01b1d387" :step/next {:db/id #edb/ref 17592186506658}} {:db/id #edb/ref 17592186506636 :step/content {:db/id #edb/ref 17592186064760 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c743cd40-625d-55c6-9c5b-b5a5b871563b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3.1" :db/id #edb/ref 17592186062618} {:answer/id #uuid "02f23049-e390-5fca-8974-84f16959bd6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.3" :db/id #edb/ref 17592186062619} {:answer/id #uuid "46091aa3-9fcd-5a1e-9cda-cd6e11aa6038" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.5" :db/id #edb/ref 17592186062620} {:answer/id #uuid "5d9d4ef8-4ce8-5fdd-ac61-f6a1121f8752" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1.4" :db/id #edb/ref 17592186062621} {:answer/id #uuid "5daf76c0-c6a7-5b84-8785-520561b0bf37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.5" :db/id #edb/ref 17592186062622}] :answer-field/correct {:db/id #edb/ref 17592186062622} :answer-field/id #uuid "14e0f7dc-27b2-569b-b94e-ce8ea1e731e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186062617}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f7767196-7c4f-505d-9cb8-74af84712773" :question/math-academy-id "q-42736" :question/problem "$-2+4.5=$" :question/worked-solution "We can swap the order of the numbers and then compute the resulting subtraction:\n\n$$\n-2+4.5=4.5-2=2.5\n$$"} :step/id #uuid "85d85619-b8de-50f5-92ee-a08b512ce531" :step/next {:db/id #edb/ref 17592186506605}} {:db/id #edb/ref 17592186506658 :step/content {:db/id #edb/ref 17592186506520 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a1c250d-164f-5f47-9a26-9438d7f566ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2.31" :db/id #edb/ref 17592186505932} {:answer/id #uuid "8ecb71be-9558-5f7e-9c24-85c0d2bdee86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1.88" :db/id #edb/ref 17592186506155} {:answer/id #uuid "b816418a-a268-5949-8a85-901c9d55dd6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2.09" :db/id #edb/ref 17592186506245} {:answer/id #uuid "c029931b-c7eb-5a6d-a179-f9ea69c5f61e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2.91" :db/id #edb/ref 17592186506259} {:answer/id #uuid "e209064d-2e8c-507a-bfa5-d4017ece1766" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1.91" :db/id #edb/ref 17592186506325}] :answer-field/correct {:db/id #edb/ref 17592186506245} :answer-field/id #uuid "59340a3d-da2b-598b-9af5-fbf05febf9c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186506415}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1c8e8af8-f023-59d2-a762-8f1491820c16" :question/math-academy-id "q-128260" :question/problem "$-4.69+2.6=$" :question/worked-solution "We can swap the order of the numbers and then compute the resulting subtraction:\n\n$$\n-4.69+2.6=2.6-4.69=-2.09\n$$"} :step/id #uuid "e6925eb7-f263-5012-a586-f8fa6ea699aa"}] :activity/title "Adding a Positive Number to a Negative Number" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186505913}]}
