#{[{:db/id #edb/ref 17592186068495 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068731 :knowledge-point/id #uuid "f1e0a7d0-f891-5f5f-8d8d-1ced62b2899e" :knowledge-point/title "Solving an Exponential Equation"}] :question/id #uuid "4912a540-482c-51be-bdc4-8fb128ddfb77" :question/math-academy-id "e-14246" :question/problem "What is the solution to the equation $6^x - 6^5= 0$?" :question/worked-solution "First, we isolate the term with the variable exponent by adding $6^5$ to both sides:\n\n$$\n\\begin{aligned}\n6^{x} - 6^{5} &= 0 \\\\\n6^{x} - 6^{5} + 6^{5} &= 0 + 6^{5} \\\\\n6^{x} - 6^{5} + 6^{5} &= 0 + 6^{5} \\\\\n6^{x} &= 6^{5}\n\\end{aligned}\n$$\n\nSince both sides of the equation share the same base $(6)$, we can equate the exponents.\n\n$$\n\\begin{aligned}\n6^{x} &= 6^{5} \\\\\nx &= 5\n\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\n{\\color{blue}x} = {\\color{blue}5}\n$$"}] [{:db/id #edb/ref 17592186068496 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068732 :knowledge-point/id #uuid "7e0c15b8-dc6e-570d-9392-4c679395cc87" :knowledge-point/title "Solving an Exponential Equation by Changing the Base"}] :question/id #uuid "bc9650d4-c12f-5e7a-b0b2-aacca9a9d698" :question/math-academy-id "e-14248" :question/problem "What is the solution to $3^x = \\dfrac{1}{9}$?" :question/worked-solution "First, we rewrite $9$ as $3^2$ and then proceed as before:\n\n$$\n\\begin{aligned}\n3^{x} &= \\frac{1}{9} \\\\\n3^{x} &= \\frac{1}{3^{2}} \\\\\n3^{x} &= 3^{-2}\n\\end{aligned}\n$$\n\nSince both sides of the equation share the same base $(3)$, we equate the exponents and get $x=-2$."}] [{:db/id #edb/ref 17592186068497 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068733 :knowledge-point/id #uuid "368d83db-e01e-543b-ba45-8fc9c63242e9" :knowledge-point/title "Rearranging and Solving an Exponential Equation"}] :question/id #uuid "9a971439-a68b-58e5-a8f3-51045b2a0bf0" :question/math-academy-id "e-14252" :question/problem "Solve the equation $2\\cdot 3^x=54$." :question/worked-solution "First, we divide both sides of the equation by $2$:\n\n$$\n\\begin{aligned}\n2 \\cdot 3^{x} &= 54 \\\\\n\\frac{2 \\cdot 3^{x}}{2} &= \\frac{54}{2} \\\\\n\\frac{2 \\cdot 3^{x}}{2} &= 27 \\\\\n3^{x} &= 27\n\\end{aligned}\n$$\n\nNow, we can rewrite $27$ as $3^3$ so that both sides have the same base:\n\n$$\n3^{x} = 3^{3}\n$$\n\nEquating the exponents, we get\n\n$$\n{\\color{blue}x}={\\color{blue}3}\n$$"}] [{:db/id #edb/ref 17592186069158 :knowledge-point/_questions [{:db/id #edb/ref 17592186068733 :knowledge-point/id #uuid "368d83db-e01e-543b-ba45-8fc9c63242e9" :knowledge-point/title "Rearranging and Solving an Exponential Equation"}] :question/answer-fields [{:answer-field/id #uuid "72c56336-2a3e-5cd0-b70e-c6cad4b4b776" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186066202}] :question/id #uuid "82072348-e506-5a54-8f29-a9a2b212c19f" :question/math-academy-id "q-223185" :question/problem "If $2 \\cdot 6^{k} = 72$, then $k =$ {{field-1}}."}]}
