#{[{:db/id #edb/ref 17592186068495 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068731 :knowledge-point/id #uuid "f1e0a7d0-f891-5f5f-8d8d-1ced62b2899e" :knowledge-point/title "Solving an Exponential Equation"}] :question/id #uuid "4912a540-482c-51be-bdc4-8fb128ddfb77" :question/math-academy-id "e-14246" :question/problem "What is the solution to the equation $6^x - 6^5= 0?$" :question/worked-solution "First, we isolate the term with the variable exponent by adding $6^5$ to both sides:\n\n$$\n\\begin{aligned}{6}^{x}-{6}^{5} & =0 \\\\ {6}^{x}-{6}^{5}+{6}^{5} & =0+{6}^{5} \\\\ {6}^{x}-\\cancel{{6}^{5}}+\\cancel{{6}^{5}} & =0+{6}^{5} \\\\ {6}^{x} & ={6}^{5}\\end{aligned}\n$$\n\nSince both sides of the equation share the same base $(6),$ we can equate the exponents. \n\n$$\n\\begin{aligned}{6}^{x} & ={6}^{5} \\\\ x & =5\\end{aligned}\n$$\n\nTherefore, the solution is ${\\color{blue}x} = {\\color{blue}5}.$"}] [{:db/id #edb/ref 17592186068496 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068732 :knowledge-point/id #uuid "7e0c15b8-dc6e-570d-9392-4c679395cc87" :knowledge-point/title "Solving an Exponential Equation by Changing the Base"}] :question/id #uuid "bc9650d4-c12f-5e7a-b0b2-aacca9a9d698" :question/math-academy-id "e-14248" :question/problem "What is the solution to $3^x = \\dfrac{1}{9}?$" :question/worked-solution "First, we rewrite $9$ as $3^2$ and then proceed as before:\n\n$$\n\\begin{aligned}{3}^{x} & =\\frac{1}{9} \\\\ {3}^{x} & =\\frac{1}{{3}^{2}} \\\\ {3}^{x} & ={3}^{-2}\\end{aligned}\n$$\n\nSince both sides of the equation share the same base $(3),$ we equate the exponents and get $x=-2.$"}] [{:db/id #edb/ref 17592186068497 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068733 :knowledge-point/id #uuid "368d83db-e01e-543b-ba45-8fc9c63242e9" :knowledge-point/title "Rearranging and Solving an Exponential Equation"}] :question/id #uuid "9a971439-a68b-58e5-a8f3-51045b2a0bf0" :question/math-academy-id "e-14252" :question/problem "Solve the equation $2\\cdot 3^x=54.$" :question/worked-solution "First, we divide both sides of the equation by $2\\mathbin{:}$\n\n$$\n\\begin{aligned}2\\cdot {3}^{x} & =54 \\\\ \\frac{2\\cdot {3}^{x}}{2} & =\\frac{54}{2} \\\\ \\frac{\\cancel{2}\\cdot {3}^{x}}{\\cancel{2}} & =27 \\\\ {3}^{x} & =27\\end{aligned}\n$$\n\nNow, we can rewrite $27$ as $3^3$ so that both sides have the same base:\n\n$$\n\\begin{aligned}{3}^{x}={3}^{3}\\end{aligned}\n$$\n\nEquating the exponents, we get ${\\color{blue}x}={\\color{blue}3}.$"}] [{:db/id #edb/ref 17592186488279 :knowledge-point/_questions [{:db/id #edb/ref 17592186068731 :knowledge-point/id #uuid "f1e0a7d0-f891-5f5f-8d8d-1ced62b2899e" :knowledge-point/title "Solving an Exponential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0370a28c-5196-5fd5-955c-8fc124345c20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186487574} {:answer/id #uuid "3d657148-f23e-5863-a74f-7584f3960595" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-7" :db/id #edb/ref 17592186487685} {:answer/id #uuid "4fdfea1a-84f8-588f-9016-c8524ba406d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=7" :db/id #edb/ref 17592186487726} {:answer/id #uuid "8ba0165c-ff00-5fbc-b6d0-d08376711b8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3" :db/id #edb/ref 17592186487831} {:answer/id #uuid "8e5d0e28-6dad-52eb-bf18-ab5a8bcbdcf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-21" :db/id #edb/ref 17592186487837}] :answer-field/correct {:answer/id #uuid "8ba0165c-ff00-5fbc-b6d0-d08376711b8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3" :db/id #edb/ref 17592186487831} :answer-field/id #uuid "96f297c3-a41a-56f6-a004-9a211994094a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186488118}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f1e12ec8-496f-581a-aa45-273ef2ee6953" :question/math-academy-id "q-111695" :question/problem "Solve the equation ${7}^{-3}={7}^{y}.$" :question/worked-solution "Since both sides of the equation share the same base $(7)$, we can equate the exponents:\n\n$$\n\\begin{aligned}{7}^{-3} & ={7}^{y} \\\\ -3 & =y\\end{aligned}\n$$\n\nTherefore, the solution is $y=-3.$"}] [{:db/id #edb/ref 17592186488218 :knowledge-point/_questions [{:db/id #edb/ref 17592186068731 :knowledge-point/id #uuid "f1e0a7d0-f891-5f5f-8d8d-1ced62b2899e" :knowledge-point/title "Solving an Exponential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "032c5a17-00aa-5d32-9327-a2d1a4e62fc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-5" :db/id #edb/ref 17592186487572} {:answer/id #uuid "2047cbfe-c2a1-5346-83bd-23d20199308f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=18" :db/id #edb/ref 17592186487636} {:answer/id #uuid "a63c8a33-a6cd-5708-b3d4-76e8a627257a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=5" :db/id #edb/ref 17592186487877} {:answer/id #uuid "ed6d6d49-fb80-5072-ae45-f2dc7c1ecf94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-13" :db/id #edb/ref 17592186488016} {:answer/id #uuid "f201bf17-2033-520f-b0ef-29cc73c56264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=13" :db/id #edb/ref 17592186488020}] :answer-field/correct {:answer/id #uuid "f201bf17-2033-520f-b0ef-29cc73c56264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=13" :db/id #edb/ref 1759