              "dom_id": "questionWidget-choiceLetterCircle-216465-b",
              "type": "text",
              "value": "III only",
              "html": "III only"
            },
            {
              "option": "c",
              "dom_id": "questionWidget-choiceLetterCircle-216465-c",
              "type": "text",
              "value": "II and III only",
              "html": "II and III only"
            },
            {
              "option": "d",
              "dom_id": "questionWidget-choiceLetterCircle-216465-d",
              "type": "text",
              "value": "None of the statements are true.",
              "html": "None of the statements are true."
