    "q-49059": {
      "dom_id": "step-q49059",
      "name": "Question 3",
      "problem": "$\\int \\frac{{x}^{5}+7}{{x}^{2}}\\,\\text{d}x=$",
      "worked_solution": "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int \\frac{{x}^{5}+7}{{x}^{2}}\\,\\text{d}x & =\\int ({x}^{3}+\\frac{7}{{x}^{2}})\\,\\text{d}x \\\\  & =\\int {x}^{3}\\,\\text{d}x+\\int 7{x}^{-2}\\,\\text{d}x \\\\  & =\\int {x}^{3}\\,\\text{d}x+7\\int {x}^{-2}\\,\\text{d}x \\\\  & =(\\frac{{x}^{4}}{4})+7(\\frac{{x}^{-1}}{-1})+C \\\\  & =\\frac{{x}^{4}}{4}-\\frac{7}{x}+C.\\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-49059-a",
