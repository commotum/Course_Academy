#{[{:db/id #edb/ref 17592186184057 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186184153 :knowledge-point/id #uuid "0db9b1c3-1e31-53f6-9fc2-1c611e2f9398" :knowledge-point/title "Computing an Integral Using the Sum Rule"}] :question/id #uuid "e4a94ca8-82ee-5776-a46d-b735d4ab60fb" :question/math-academy-id "e-371" :question/problem "Find the integral of $x^2 + 1$." :question/worked-solution "Applying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\n\\intx^{2} + 1dx &= \\intx^{2}dx + \\int1dx \\\\\n&= \\intx^{2}dx + \\intx^{0}dx \\\\\n&= (\\frac{x^{2 + 1}}{2 + 1}) + x + C \\\\\n&= \\frac{1}{3}x^{3} + x + C\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184058 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186184154 :knowledge-point/id #uuid "a58c0a18-4221-50f1-b31c-ae58d099d79d" :knowledge-point/title "Computing an Integral Using the Sum and Constant Factor Rules"}] :question/id #uuid "ea7dadee-2b44-5e62-bef4-26fb0cb185ea" :question/math-academy-id "e-372" :question/problem "Calculate $\\displaystyle \\int 2 x^3 - x \\,\\textrm d x$." :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\n\\int2x^{3} - xdx &= 2\\intx^{3}dx - \\intxdx \\\\\n&= 2(\\frac{x^{3 + 1}}{3 + 1}) - (\\frac{x^{1 + 1}}{1 + 1}) + C \\\\\n&= 2(\\frac{x^{4}}{4}) - (\\frac{x^{2}}{2}) + C \\\\\n&= \\frac{x^{4}}{2} - \\frac{x^{2}}{2} + C\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184059 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186184155 :knowledge-point/id #uuid "007f3355-427a-5da4-8af7-22581f1cb1de" :knowledge-point/title "Integrating Sums of Power Functions"}] :question/id #uuid "8f99b603-2fba-5a58-9966-b91d3a8a773e" :question/math-academy-id "e-373" :question/problem "Calculate $\\displaystyle \\int \\left(5(\\sqrt{x})^{3} - 4 x^2 + 5\\right) \\,\\textrm d x$." :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\n\\int(5(\\sqrt{x})^{3} - 4x^{2} + 5)dx &= \\int(5x^{3/2} - 4x^{2} + 5)dx \\\\\n&= 5\\intx^{3/2}dx - 4\\intx^{2}dx + 5\\int1dx \\\\\n&= 5(\\frac{x^{5/2}}{\\frac{5}{2}}) - 4(\\frac{x^{3}}{3}) + 5(x) + C \\\\\n&= 5 \\cdot \\frac{2}{5}x^{5/2} - \\frac{4}{3}x^{3} + 5x + C \\\\\n&= 2\\sqrt{x^{5}} - \\frac{4}{3}x^{3} + 5x + C\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250124 :knowledge-point/_questions [{:db/id #edb/ref 17592186184155 :knowledge-point/id #uuid "007f3355-427a-5da4-8af7-22581f1cb1de" :knowledge-point/title "Integrating Sums of Power Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4d74b89-75a1-56f3-b6b6-828088510585" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt[3]{x}}+\\frac{{x}^{4}}{4}+\\frac{1}{x}+C" :db/id #edb/ref 17592186249171} {:answer/id #uuid "de570091-257b-5378-a03a-2502b905ef6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt[3]{x}}+\\frac{{x}^{2}}{4}+\\frac{1}{{x}^{3}}+C" :db/id #edb/ref 17592186249396} {:answer/id #uuid "e77f388d-8a73-59ce-8f66-bc9a394fa477" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt[3]{{x}^{4}}}+\\frac{{x}^{2}}{2}+\\frac{1}{x}+C" :db/id #edb/ref 17592186249466} {:answer/id #uuid "f18e54e2-bbf7-5c09-a529-02ac0e448d1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{x}^{3}}}{3}+4{x}^{4}+\\frac{x}{2}+C" :db/id #edb/ref 17592186249545} {:answer/id #uuid "f8f381b4-0b8f-5cfb-8192-5f7af284e5dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{x}+\\frac{{x}^{4}}{4}-\\frac{x}{4}+C" :db/id #edb/ref 17592186249595}] :answer-field/correct {:answer/id #uuid "c4d74b89-75a1-56f3-b6b6-828088510585" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt[3]{x}}+\\frac{{x}^{4}}{4}+\\frac{1}{x}+C" :db/id #edb/ref 17592186249171} :answer-field/id #uuid "bb1b4399-41fb-5b60-b839-8a80147e6a2e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249996}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e132caee-594d-5f81-b6a1-2e2a44a2d5f6" :question/math-academy-id "q-113848" :question/problem "Find the antiderivative of \n$\\frac{1}{\\sqrt[3]{{x}^{4}}}+{x}^{3}-\\frac{1}{{x}^{2}}.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (\\frac{1}{\\sqrt[3]{{x}^{4}}}+{x}^{3}-\\frac{1}{{x}^{2}})\\,\\text{d}x & =\\int {x}^{-4/3}\\,\\text{d}x+\\int {x}^{3}\\,\\text{d}x-\\int {x}^{-2}\\,\\text{d}x \\\\  & =\\frac{{x}^{-4/3+1}}{(-\\frac{4}{3}+1)}+\\frac{{x}^{3+1}}{(3+1)}-\\frac{{x}^{-2+1}}{(-2+1)}+C \\\\  & =\\frac{{x}^{-1/3}}{(-\\frac{1}{3})}+\\frac{{x}^{4}}{4}-\\frac{{x}^{-1}}{(-1)}+C \\\\  & =-\\frac{3}{\\sqrt[3]{x}}+\\frac{{x}^{4}}{4}+\\frac{1}{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234302 :knowledge-point/_questions [{:db/id #edb/ref 17592186184153 :knowledge-point/id #uuid "0db9b1c3-1e31-53f6-9fc2-1c611e2f9398" :knowledge-point/title "Computing an Integral Using the Sum Rule"}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "79aa6724-ce36-5977-907b-506fab54c4d7" :question/math-academy-id "q-71169" :question/problem "Find the integral of $\\frac{1}{\\sqrt{{x}^{3}}}+4.$" :question/worked-solution "Applying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{{x}^{3}}}+4\\,\\text{d}x & =\\int \\frac{1}{{x}^{3/2}}\\,\\text{d}x+4\\int 1\\,\\text{d}x \\\\  & =\\int {x}^{-3/2}\\text{d}x+4\\int {x}^{0}\\text{d}x \\\\  & =\\frac{{x}^{-3/2+1}}{(-\\frac{3}{2}+1)}+4(\\frac{{x}^{0+1}}{0+1})+C \\\\  & =-2\\cdot {x}^{-1/2}+4x+C \\\\  & =-\\frac{2}{\\sqrt{x}}+4x+C\\end{aligned}\n$$"}]}
