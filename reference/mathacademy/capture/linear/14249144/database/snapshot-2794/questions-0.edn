#{[{:db/id #edb/ref 17592186184057 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186184153 :knowledge-point/id #uuid "0db9b1c3-1e31-53f6-9fc2-1c611e2f9398" :knowledge-point/title "Computing an Integral Using the Sum Rule"}] :question/id #uuid "e4a94ca8-82ee-5776-a46d-b735d4ab60fb" :question/math-academy-id "e-371" :question/problem "Find the integral of $x^2 + 1.$" :question/worked-solution "Applying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int {x}^{2}+1\\,\\text{d}x & =\\int {x}^{2}\\,\\text{d}x+\\int 1\\,\\text{d}x \\\\  & =\\int {x}^{2}\\,\\text{d}x+\\int {x}^{0}\\,\\text{d}x \\\\  & =(\\frac{{x}^{2+1}}{2+1})+x+C \\\\  & =\\frac{1}{3}{x}^{3}+x+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184058 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186184154 :knowledge-point/id #uuid "a58c0a18-4221-50f1-b31c-ae58d099d79d" :knowledge-point/title "Computing an Integral Using the Sum and Constant Factor Rules"}] :question/id #uuid "ea7dadee-2b44-5e62-bef4-26fb0cb185ea" :question/math-academy-id "e-372" :question/problem "Calculate $\\displaystyle \\int 2 x^3 - x \\,\\textrm d x.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int 2{x}^{3}-x\\,\\text{d}x & =2\\int {x}^{3}\\,\\text{d}x-\\int x\\,\\text{d}x \\\\  & =2(\\frac{{x}^{3+1}}{3+1})-(\\frac{{x}^{1+1}}{1+1})+C \\\\  & =2(\\frac{{x}^{4}}{4})-(\\frac{{x}^{2}}{2})+C \\\\  & =\\frac{{x}^{4}}{2}-\\frac{{x}^{2}}{2}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184059 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186184155 :knowledge-point/id #uuid "007f3355-427a-5da4-8af7-22581f1cb1de" :knowledge-point/title "Integrating Sums of Power Functions"}] :question/id #uuid "8f99b603-2fba-5a58-9966-b91d3a8a773e" :question/math-academy-id "e-373" :question/problem "Calculate $\\displaystyle \\int \\left( 5(\\sqrt{x})^{3} - 4 x^2 + 5\\right) \\,\\textrm d x.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (5(\\sqrt{x})^{3}-4{x}^{2}+5)\\,\\text{d}x & =\\int (5{x}^{3/2}-4{x}^{2}+5)\\,\\text{d}x \\\\  & =5\\int {x}^{3/2}\\,\\text{d}x-4\\int {x}^{2}\\text{d}x+5\\int 1\\,\\text{d}x \\\\  & =5(\\frac{{x}^{5/2}}{\\frac{5}{2}})-4(\\frac{{x}^{3}}{3})+5(x)+C \\\\  & =5\\cdot \\frac{2}{5}{x}^{5/2}-\\frac{4}{3}{x}^{3}+5x+C \\\\  & =2\\sqrt{{x}^{5}}-\\frac{4}{3}{x}^{3}+5x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250124 :knowledge-point/_questions [{:db/id #edb/ref 17592186184155 :knowledge-point/id #uuid "007f3355-427a-5da4-8af7-22581f1cb1de" :knowledge-point/title "Integrating Sums of Power Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4d74b89-75a1-56f3-b6b6-828088510585" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt[3]{x}}+\\frac{{x}^{4}}{4}+\\frac{1}{x}+C" :db/id #edb/ref 17592186249171} {:answer/id #uuid "de570091-257b-5378-a03a-2502b905ef6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt[3]{x}}+\\frac{{x}^{2}}{4}+\\frac{1}{{x}^{3}}+C" :db/id #edb/ref 17592186249396} {:answer/id #uuid "e77f388d-8a73-59ce-8f66-bc9a394fa477" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt[3]{{x}^{4}}}+\\frac{{x}^{2}}{2}+\\frac{1}{x}+C" :db/id #edb/ref 17592186249466} {:answer/id #uuid "f18e54e2-bbf7-5c09-a529-02ac0e448d1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{x}^{3}}}{3}+4{x}^{4}+\\frac{x}{2}+C" :db/id #edb/ref 17592186249545} {:answer/id #uuid "f8f381b4-0b8f-5cfb-8192-5f7af284e5dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{x}+\\frac{{x}^{4}}{4}-\\frac{x}{4}+C" :db/id #edb/ref 17592186249595}] :answer-field/correct {:answer/id #uuid "c4d74b89-75a1-56f3-b6b6-828088510585" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt[3]{x}}+\\frac{{x}^{4}}{4}+\\frac{1}{x}+C" :db/id #edb/ref 17592186249171} :answer-field/id #uuid "bb1b4399-41fb-5b60-b839-8a80147e6a2e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249996}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e132caee-594d-5f81-b6a1-2e2a44a2d5f6" :question/math-academy-id "q-113848" :question/problem "Find the antiderivative of \n$\\frac{1}{\\sqrt[3]{{x}^{4}}}+{x}^{3}-\\frac{1}{{x}^{2}}.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (\\frac{1}{\\sqrt[3]{{x}^{4}}}+{x}^{3}-\\frac{1}{{x}^{2}})\\,\\text{d}x & =\\int {x}^{-4/3}\\,\\text{d}x+\\int {x}^{3}\\,\\text{d}x-\\int {x}^{-2}\\,\\text{d}x \\\\  & =\\frac{{x}^{-4/3+1}}{(-\\frac{4}{3}+1)}+\\frac{{x}^{3+1}}{(3+1)}-\\frac{{x}^{-2+1}}{(-2+1)}+C \\\\  & =\\frac{{x}^{-1/3}}{(-\\frac{1}{3})}+\\frac{{x}^{4}}{4}-\\frac{{x}^{-1}}{(-1)}+C \\\\  & =-\\frac{3}{\\sqrt[3]{x}}+\\frac{{x}^{4}}{4}+\\frac{1}{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186567046 :knowledge-point/_questions [{:db/id #edb/ref 17592186184155 :knowledge-point/id #uuid "007f3355-427a-5da4-8af7-22581f1cb1de" :knowledge-point/title "Integrating Sums of Power Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37dd99bc-3607-581f-978c-a71b67914c2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[5]{{x}^{9}}-2{x}^{2}-\\frac{2}{3{x}^{3}}+C" :db/id #edb/ref 17592186566477} {:answer/id #uuid "9126a86d-bcfd-5fec-9571-5503eba42ee5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt[5]{{x}^{9}}}{9}-\\frac{{x}^{2}}{2}-\\frac{2}{3{x}^{3}}+C" :db/id #edb/ref 17592186566648} {:answer/id #uuid "a5d265ad-a1a6-58b0-b6d6-e96a59278366" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{5\\sqrt[5]{{x}^{9}}}-\\frac{2}{x}-\\frac{6}{{x}^{3}}+C" :db/id #edb/ref 17592186566688} {:answer/id #uuid "dafdca6c-9141-5612-9f79-f5c98e819afc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\sqrt[5]{{x}^{4}}}-\\frac{2}{{x}^{2}}-\\frac{6}{{x}^{4}}+C" :db/id #edb/ref 17592186566803} {:answer/id #uuid "f64dcd14-9eac-5db3-bba6-758aa5bc23bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt[5]{{x}^{4}}}{4}-\\frac{1}{2x}-\\frac{2}{3{x}^{6}}+C" :db/id #edb/ref 17592186566857}] :answer-field/correct {:answer/id #uuid "9126a86d-bcfd-5fec-9571-5503eba42ee5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt[5]{{x}^{9}}}{9}-\\frac{{x}^{2}}{2}-\\frac{2}{3{x}^{3}}+C" :db/id #edb/ref 17592186566648} :answer-field/id #uuid "e1056adf-eded-5bde-8128-44705a2baad4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186566981}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "676d4494-4f46-573f-a890-2a8daa607201" :question/math-academy-id "q-113850" :question/problem "Find the antiderivative of \n$\\sqrt[5]{{x}^{4}}-x+\\frac{2}{{x}^{4}}.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (\\sqrt[5]{{x}^{4}}-x+\\frac{2}{{x}^{4}})\\,\\text{d}x & =\\int {x}^{4/5}\\,\\text{d}x-\\int x\\,\\text{d}x+2\\int {x}^{-4}\\,\\text{d}x \\\\  & =\\frac{{x}^{4/5+1}}{(\\frac{4}{5}+1)}-\\frac{{x}^{1+1}}{(1+1)}+2\\cdot \\frac{{x}^{-4+1}}{(-4+1)}+C \\\\  & =\\frac{{x}^{9/5}}{(\\frac{9}{5})}-\\frac{{x}^{2}}{2}+2\\cdot \\frac{{x}^{-3}}{(-3)}+C \\\\  & =\\frac{5\\sqrt[5]{{x}^{9}}}{9}-\\frac{{x}^{2}}{2}-\\frac{2}{3{x}^{3}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186567083 :knowledge-point/_questions [{:db/id #edb/ref 17592186184154 :knowledge-point/id #uuid "a58c0a18-4221-50f1-b31c-ae58d099d79d" :knowledge-point/title "Computing an Integral Using the Sum and Constant Factor Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3179ff10-c8be-5032-b116-17b3d443db6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{4}}{4}-\\frac{7}{x}+C" :db/id #edb/ref 17592186566460} {:answer/id #uuid "51d8327b-b62f-54ce-a7a1-472117a5b25e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{3}}{3}-\\frac{7}{{x}^{2}}+C" :db/id #edb/ref 17592186566520} {:answer/id #uuid "52a5c30a-6d06-54eb-a7f8-2ebe257c1193" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{3}}{3}-\\frac{7}{x}+C" :db/id #edb/ref 17592186566522} {:answer/id #uuid "6ef5f0ad-1feb-54d4-9d4a-009b294fb168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{3}}{4}-\\frac{7}{x}+C" :db/id #edb/ref 17592186566572} {:answer/id #uuid "cdcbdf16-64b9-50b1-9679-0fa5d22435fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{6}}{6}-\\frac{7}{{x}^{3}}+C" :db/id #edb/ref 17592186566770}] :answer-field/correct {:answer/id #uuid "3179ff10-c8be-5032-b116-17b3d443db6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{4}}{4}-\\frac{7}{x}+C" :db/id #edb/ref 17592186566460} :answer-field/id #uuid "69ab0297-0b7d-5f64-9cc7-f805d6068f4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186566924}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c3b5e67d-32a5-5a89-860d-1eeac5fbca6e" :question/math-academy-id "q-49059" :question/problem "$\\int \\frac{{x}^{5}+7}{{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int \\frac{{x}^{5}+7}{{x}^{2}}\\,\\text{d}x & =\\int ({x}^{3}+\\frac{7}{{x}^{2}})\\,\\text{d}x \\\\  & =\\int {x}^{3}\\,\\text{d}x+\\int 7{x}^{-2}\\,\\text{d}x \\\\  & =\\int {x}^{3}\\,\\text{d}x+7\\int {x}^{-2}\\,\\text{d}x \\\\  & =(\\frac{{x}^{4}}{4})+7(\\frac{{x}^{-1}}{-1})+C \\\\  & =\\frac{{x}^{4}}{4}-\\frac{7}{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186567073 :knowledge-point/_questions [{:db/id #edb/ref 17592186184154 :knowledge-point/id #uuid "a58c0a18-4221-50f1-b31c-ae58d099d79d" :knowledge-point/title "Computing an Integral Using the Sum and Constant Factor Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06327c3c-dce0-563c-b02b-f7d69ae0503a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{{x}^{5}}}{5}+\\frac{4\\sqrt{{x}^{3}}}{3}+C" :db/id #edb/ref 17592186566371} {:answer/id #uuid "56759450-adc6-5b0d-a635-c7f96a6a0550" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{{x}^{3}}}{3}-\\frac{4}{\\sqrt{x}}+C" :db/id #edb/ref 17592186566525} {:answer/id #uuid "86252f96-8aa6-54b2-b5a8-c3649023555d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{{x}^{3}}}{3}+\\frac{4}{\\sqrt{x}}+C" :db/id #edb/ref 17592186566616} {:answer/id #uuid "98759795-857b-56c3-8fe8-c710268b79fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{{x}^{5}}}{2}+3\\sqrt{{x}^{3}}+C" :db/id #edb/ref 17592186566661} {:answer/id #uuid "ec410b0b-b1e5-506b-ad48-150967b9799d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{x}^{5}}}{5}+\\frac{2\\sqrt{{x}^{3}}}{3}+C" :db/id #edb/ref 17592186566841}] :answer-field/correct {:answer/id #uuid "06327c3c-dce0-563c-b02b-f7d69ae0503a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{{x}^{5}}}{5}+\\frac{4\\sqrt{{x}^{3}}}{3}+C" :db/id #edb/ref 17592186566371} :answer-field/id #uuid "dea66fd9-ec24-52e5-9e8a-c08de6b5d949" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186566978}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aa2d5333-814d-52c3-9ed1-e83660135b41" :question/math-academy-id "q-49063" :question/problem "Calculate $\\int \\sqrt{x}(2+x)\\,\\text{d}x.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int \\sqrt{x}(2+x)\\text{d}x & =\\int {x}^{1/2}(2+x)\\text{d}x \\\\  & =\\int (2{x}^{1/2}+{x}^{3/2})\\text{d}x \\\\  & =2\\int {x}^{1/2}\\text{d}x+\\int {x}^{3/2}\\text{d}x \\\\  & =2(\\frac{2{x}^{3/2}}{3})+(\\frac{2{x}^{5/2}}{5})+C \\\\  & =\\frac{2\\sqrt{{x}^{5}}}{5}+\\frac{4\\sqrt{{x}^{3}}}{3}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186567064 :knowledge-point/_questions [{:db/id #edb/ref 17592186184153 :knowledge-point/id #uuid "0db9b1c3-1e31-53f6-9fc2-1c611e2f9398" :knowledge-point/title "Computing an Integral Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67ebaae1-1b6f-54a0-9ee3-20ad6d94b297" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x-{x}^{4}+C" :db/id #edb/ref 17592186566561} {:answer/id #uuid "75869535-6c65-5fee-b563-b5239aaa4910" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{x}^{2}-\\frac{{x}^{4}}{2}+C" :db/id #edb/ref 17592186566587} {:answer/id #uuid "949d1af7-fd39-55bc-bf6f-81a0c846d362" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5-\\frac{{x}^{3}}{4}+C" :db/id #edb/ref 17592186566654} {:answer/id #uuid "a1102e39-908b-5d4b-9cc6-16a7726229bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x-\\frac{{x}^{4}}{4}+C" :db/id #edb/ref 17592186566676} {:answer/id #uuid "e18db342-254e-56c4-b18d-3e730f819b2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x+\\frac{2{x}^{4}}{3}+C" :db/id #edb/ref 17592186566817}] :answer-field/correct {:answer/id #uuid "a1102e39-908b-5d4b-9cc6-16a7726229bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x-\\frac{{x}^{4}}{4}+C" :db/id #edb/ref 17592186566676} :answer-field/id #uuid "abc76652-94ff-55a2-98b8-14e731f2dc71" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186566961}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9e4827b1-c8af-5e0e-a92c-bab0c6f19c7d" :question/math-academy-id "q-71167" :question/problem "$\\int 5-{x}^{3}\\,\\text{d}x=$" :question/worked-solution "Applying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int 5-{x}^{3}\\,\\text{d}x & =5\\int 1\\,\\text{d}x-\\int {x}^{3}\\,\\text{d}x \\\\  & =5\\int {x}^{0}\\,\\text{d}x-\\int {x}^{3}\\,\\text{d}x \\\\  & =5(\\frac{{x}^{0+1}}{0+1})-\\frac{{x}^{3+1}}{3+1}+C \\\\  & =5x-\\frac{{x}^{4}}{4}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234302 :knowledge-point/_questions [{:db/id #edb/ref 17592186184153 :knowledge-point/id #uuid "0db9b1c3-1e31-53f6-9fc2-1c611e2f9398" :knowledge-point/title "Computing an Integral Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80a672a5-9018-5a78-9672-cf47be4d95f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{x}}+3x+C" :db/id #edb/ref 17592186566608} {:answer/id #uuid "98e55f7b-e970-5ec1-8f87-371c4a6f55f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{{x}^{3}}}-4x+C" :db/id #edb/ref 17592186566663} {:answer/id #uuid "d87f3a3b-f1ff-5e22-81b2-679daf615e23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{x}}-x+C" :db/id #edb/ref 17592186566796} {:answer/id #uuid "eb4e8d2e-8e7f-55f8-887c-4c3c6d134e97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{x}+4x+C" :db/id #edb/ref 17592186566840} {:answer/id #uuid "f5261de7-027d-545e-bff9-4ea8c302891e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{\\sqrt{x}}+4x+C" :db/id #edb/ref 17592186566855}] :answer-field/correct {:answer/id #uuid "f5261de7-027d-545e-bff9-4ea8c302891e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{\\sqrt{x}}+4x+C" :db/id #edb/ref 17592186566855} :answer-field/id #uuid "f689fbb7-4820-549d-86af-2dc10f9a0677" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186567001}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "79aa6724-ce36-5977-907b-506fab54c4d7" :question/math-academy-id "q-71169" :question/problem "Find the integral of $\\frac{1}{\\sqrt{{x}^{3}}}+4.$" :question/worked-solution "Applying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{{x}^{3}}}+4\\,\\text{d}x & =\\int \\frac{1}{{x}^{3/2}}\\,\\text{d}x+4\\int 1\\,\\text{d}x \\\\  & =\\int {x}^{-3/2}\\text{d}x+4\\int {x}^{0}\\text{d}x \\\\  & =\\frac{{x}^{-3/2+1}}{(-\\frac{3}{2}+1)}+4(\\frac{{x}^{0+1}}{0+1})+C \\\\  & =-2\\cdot {x}^{-1/2}+4x+C \\\\  & =-\\frac{2}{\\sqrt{x}}+4x+C\\end{aligned}\n$$"}]}
