54 #edb/ref 17592186045417] [17592186539931 #edb/ref 1075 #edb/ref 17592186539651 #edb/ref 17592186045417] [17592186539931 #edb/ref 1075 #edb/ref 17592186539895 #edb/ref 17592186045417] [17592186539931 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186539931 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186539931 #edb/ref 1078 #edb/ref 17592186539554 #edb/ref 17592186045417] [17592186539931 #edb/ref 1079 #uuid "2074e74d-97be-5bfc-a833-d26865f40ab6" #edb/ref 17592186045417] [17592186539976 #edb/ref 1075 #edb/ref 17592186539494 #edb/ref 17592186045417] [17592186539976 #edb/ref 1075 #edb/ref 17592186539610 #edb/ref 17592186045417] [17592186539976 #edb/ref 1075 #edb/ref 17592186539652 #edb/ref 17592186045417] [17592186539976 #edb/ref 1075 #edb/ref 17592186539702 #edb/ref 17592186045417] [17592186539976 #edb/ref 1075 #edb/ref 17592186539799 #edb/ref 17592186045417] [17592186539976 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186539976 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186539976 #edb/ref 1078 #edb/ref 17592186539702 #edb/ref 17592186045417] [17592186539976 #edb/ref 1079 #uuid "9e8273b7-9a04-5a9b-97ef-a69e365e1149" #edb/ref 17592186045417] [17592186540017 #edb/ref 1075 #edb/ref 17592186539563 #edb/ref 17592186045417] [17592186540017 #edb/ref 1075 #edb/ref 17592186539578 #edb/ref 17592186045417] [17592186540017 #edb/ref 1075 #edb/ref 17592186539588 #edb/ref 17592186045417] [17592186540017 #edb/ref 1075 #edb/ref 17592186539744 #edb/ref 17592186045417] [17592186540017 #edb/ref 1075 #edb/ref 17592186539793 #edb/ref 17592186045417] [17592186540017 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186540017 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186540017 #edb/ref 1078 #edb/ref 17592186539563 #edb/ref 17592186045417] [17592186540017 #edb/ref 1079 #uuid "f5c348f4-a62e-5a54-86d9-1566ff2e8df2" #edb/ref 17592186045417] [17592186540038 #edb/ref 1068 #edb/ref 17592186539931 #edb/ref 17592186045417] [17592186540038 #edb/ref 1069 "q-78777" #edb/ref 17592186045417] [17592186540038 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186540038 #edb/ref 1071 "The point $Q$ with coordinates $(4,1)$ lies on the curve $y=f(x).$ Which of the following points must lie on $y=f(-x)?$" #edb/ref 17592186045417] [17592186540038 #edb/ref 1072 #uuid "30ee1395-5a0d-5715-816e-6b81b1745415" #edb/ref 17592186045417] [17592186540038 #edb/ref 1074 "The transformation $y=f(-x)$ reflects the curve $y=f(x)$ in the $y$-axis.\n\nFirst, notice that the point $P(4,1)$ lies $4$ units to the *right* from the $y$-axis. So, under the action of the transformation, this point will be reflected $4$ units to the *left* from the $y$-axis.\n\n![](images/7e/7e76fb2b9821c8bb116740381248e16d8331fbfc2cce4314984fe39bbfc723e7.png)\n\nWe conclude that the point $(-4,1)$ must lie on the graph of $y=f(-x).$" #edb/ref 17592186045417] [17592186540090 #edb/ref 1068 #edb/ref 17592186539976 #edb/ref 17592186045417] [17592186540090 #edb/ref 1069 "q-78473" #edb/ref 17592186045417] [17592186540090 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186540090 #edb/ref 1071 "The point $Q$ with coordinates $(2,-4)$ lies on the curve $y=f(x).$ Which of the following points must lie on $y=f(-x)?$" #edb/ref 17592186045417] [17592186540090 #edb/ref 1072 #uuid "c1cdde3c-f636-5b56-ac5b-9b6bdec51038" #edb/ref 17592186045417] [17592186540090 #edb/ref 1074 "The transformation $y=f(-x)$ reflects the curve $y=f(x)$ in the $y$-axis.\n\nFirst, notice that the point $P(2,-4)$ lies $2$ units to the *right* from the $y$-axis. So, under the action of the transformation, this point will be reflected $2$ units to the *left* from the $y$-axis.\n\n![](images/45/456a145820b2a36693df572b49064332a18a2e79c35f2a0e3240b9995660c9a5.png)\n\nWe conclude that the point $(-2,-4)$ must lie on the graph of $y=f(-x).$" #edb/ref 17592186045417] [17592186540091 #edb/ref 1068 #edb/ref 17592186540017 #edb/ref 17592186045417] [17592186540091 #edb/ref 1069 "q-17836" #edb/ref 17592186045417] [17592186540091 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186540091 #edb/ref 1071 "![](images/6e/6e075462cab65c4070ed285e78d71fb2fafd7bcdcb898957456e83cddbf45c18.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following is the graph of $y=f(-x)?$" #edb/ref 17592186045417] [17592186540091 #edb/ref 1072 #uuid "c4f3f9b9-166f-5dd9-8c08-9d9ad8ea8dae" #edb/ref 17592186045417] [17592186540091 #edb/ref 1074 "To obtain the graph of $y=f(-x)$ from $y=f(x)$, we need to reflect the graph over the $y$-axis. The resulting graph is shown below.\n\n![](images/ed/ed0d31d46df8c973f92ff5b8e23a3aaeeb782fa90c2f5abb75dcf88f2d7b7421.png)" #edb/ref 17592186045417]}
