3 #edb/ref 17592186045417] [17592186050306 #edb/ref 1035 #uuid "3e940c02-4b9e-5ae3-9ac3-00ad626c7df8" #edb/ref 17592186045417] [17592186050526 #edb/ref 1027 #edb/ref 17592186051017 #edb/ref 17592186045417] [17592186050526 #edb/ref 1028 #edb/ref 17592186133730 #edb/ref 17592186045417] [17592186050526 #edb/ref 1028 #edb/ref 17592186133731 #edb/ref 17592186045417] [17592186050526 #edb/ref 1028 #edb/ref 17592186133732 #edb/ref 17592186045417] [17592186050526 #edb/ref 1028 #edb/ref 17592186133733 #edb/ref 17592186045417] [17592186050526 #edb/ref 1031 "The Greatest Common Factor of Two Monomials" #edb/ref 17592186045417] [17592186050526 #edb/ref 1033 2181 #edb/ref 17592186045417] [17592186050526 #edb/ref 1035 #uuid "507c4552-c3af-55c9-9104-67d8bb5a0bd4" #edb/ref 17592186045417] [17592186050818 #edb/ref 1027 #edb/ref 17592186048134 #edb/ref 17592186045417] [17592186050818 #edb/ref 1027 #edb/ref 17592186048543 #edb/ref 17592186045417] [17592186050818 #edb/ref 1027 #edb/ref 17592186048861 #edb/ref 17592186045417] [17592186050818 #edb/ref 1027 #edb/ref 17592186049077 #edb/ref 17592186045417] [17592186050818 #edb/ref 1027 #edb/ref 17592186049198 #edb/ref 17592186045417] [17592186050818 #edb/ref 1027 #edb/ref 17592186049500 #edb/ref 17592186045417] [17592186050818 #edb/ref 1027 #edb/ref 17592186049793 #edb/ref 17592186045417] [17592186050818 #edb/ref 1027 #edb/ref 17592186049847 #edb/ref 17592186045417] [17592186050818 #edb/ref 1027 #edb/ref 17592186049943 #edb/ref 17592186045417] [17592186050818 #edb/ref 1027 #edb/ref 17592186050320 #edb/ref 17592186045417] [17592186050818 #edb/ref 1027 #edb/ref 17592186050782 #edb/ref 17592186045417] [17592186050818 #edb/ref 1027 #edb/ref 17592186051019 #edb/ref 17592186045417] [17592186050818 #edb/ref 1028 #edb/ref 17592186064241 #edb/ref 17592186045417] [17592186050818 #edb/ref 1028 #edb/ref 17592186064242 #edb/ref 17592186045417] [17592186050818 #edb/ref 1028 #edb/ref 17592186064243 #edb/ref 17592186045417] [17592186050818 #edb/ref 1031 "Multiplying Binomials" #edb/ref 17592186045417] [17592186050818 #edb/ref 1033 371 #edb/ref 17592186045417] [17592186050818 #edb/ref 1035 #uuid "68e64e22-0e3c-5eac-8837-c36b21dd36c0" #edb/ref 17592186045417] [17592186054348 #edb/ref 1069 "e-10650" #edb/ref 17592186045417] [17592186054348 #edb/ref 1071 "Categorize the polynomial $2y^2+3$ based on the number of terms it has." #edb/ref 17592186045417] [17592186054348 #edb/ref 1072 #uuid "b8742776-1dc7-5816-afb6-9a72142ecb5c" #edb/ref 17592186045417] [17592186054348 #edb/ref 1074 "The polynomial $2y^2+3$ has two terms, so it is a binomial." #edb/ref 17592186045417] [17592186054349 #edb/ref 1069 "e-10651" #edb/ref 17592186045417] [17592186054349 #edb/ref 1071 "Categorize the polynomial $1+2x^2 - 8x$ based on its degree and the number of terms it has." #edb/ref 17592186045417] [17592186054349 #edb/ref 1072 #uuid "6270e77f-6ccb-5304-90da-2419fa309007" #edb/ref 17592186045417] [17592186054349 #edb/ref 1074 "The polynomial $1+2x^2 - 8x$ has three terms, so it is a trinomial.\n\nAlso, its degree is $2,$ so it is quadratic. \n\nTherefore, the polynomial is a quadratic trinomial." #edb/ref 17592186045417] [17592186054350 #edb/ref 1069 "e-10652" #edb/ref 17592186045417] [17592186054350 #edb/ref 1071 "Which of the following statements are true?\n\nI. The sum of $x^2+2$ and $3x$ is a trinomial.\n\nII. The sum of $5x^2+4x$ and $-4x$ is a trinomial.\n\nIII. The sum of a monomial and a binomial is **always** a trinomial." #edb/ref 17592186045417] [17592186054350 #edb/ref 1072 #uuid "3400928d-9463-56f2-af47-e193a1e18a47" #edb/ref 17592186045417] [17592186054350 #edb/ref 1074 "Let's analyze each statement, in turn.\n\n- Statement I is true. We have\n\n$$\n(x^2+2) + (3x) = x^2+3x+2,\n$$\n\nwhich is a trinomial.\n\n- Statement II is false. We have\n\n$$\n(5x^2+4x) + (-4x) = 5x^2,\n$$\n\nwhich is *not* a trinomial (it's a monomial).\n\n- Statement III is false. The sum of a monomial and a binomial *could be* a trinomial (see, for example, the statement I).\n\nHowever, the sum of a monomial and a binomial is *not always* a trinomial (see, for example, the statement II).\n\nSo, the sum of a monomial and a binomial is *not always* a trinomial.\n\nTherefore, the correct answer is \"I only.\"" #edb/ref 17592186045417] [17592186054710 #edb/ref 1037 #edb/ref 17592186050306 #edb/ref 17592186045417] [17592186054710 #edb/ref 1038 #edb/ref 17592186055300 #edb/ref 17592186045417] [17592186054710 #edb/ref 1038 #edb/ref 17592186055301 #edb/ref 17592186045417] [17592186054710 #edb/ref 1038 #edb/ref 17592186475965 #edb/ref 17592186045417] [17592186054710 #edb/ref 1038 #edb/ref 17592186475967 #edb/ref 17592186045417] [17592186054710 #edb/ref 1039 "Categorizing a Polynomial by the Number of Terms It Has" #edb/ref 17592186045417] [17592186054710 #edb/ref 1041 #edb/ref 17592186054348 #edb/ref 17592186045417] [17592186054710 #edb/ref 1042 #uuid "d3a71018-8f67-53cb-aa6c-7f17e0af9ef9" #edb/ref 17592186045417] [17592186054711 #edb/ref 1037 #edb/ref 17592186048406 #edb/ref 17592186045417] [17592186054711 #edb/ref 1038 #edb/ref 17592186055361 #edb/ref 17592186045417] [17592186054711 #edb/ref 1038 #edb/ref 17592186055442 #edb/ref 17592186045417] [17592186054711 #edb/ref 1038 #edb/ref 17592186234398 #edb/ref 17592186045417] [17592186054711 #edb/ref 1038 #edb/ref 17592186475918 #edb/ref 17592186045417] [17592186054711 #edb/ref 1038 #edb/ref 17592186475973 #edb/ref 17592186045417] [17592186054711 #edb/ref 1039 "Categorizing a Polynomial by Its Degree and Number of Terms" #edb/ref 17592186045417] [17592186054711 #edb/ref 1041 #edb/ref 17592186054349 #edb/ref 17592186045417] [17592186054711 #edb/ref 1042 #uuid "3b8feb96-7432-5fe7-a6c7-b2d8ebe7e766" #edb/ref 17592186045417] [17592186054712 #edb/ref 1037 #edb/ref 17592186048524 #edb/ref 17592186045417] [17592186054712 #edb/ref 1038 #edb/ref 17592186055015 #edb/ref 17592186045417] [17592186054712 #edb/ref 1038 #edb/ref 17592186055016 #edb/ref 17592186045417] [17592186054712 #edb/ref 10