592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390341}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "09d1de29-e974-591a-b590-9887d91abf1f" :question/math-academy-id "q-18523" :question/problem "Which of the following is the graph of $y=2{(\\frac{1}{6})}^{x}?$" :question/worked-solution "First we plot the graph of $y={(\\frac{1}{6})}^{x}:$\n\n![](images/4d/4dacecba4626f7c202777cad0a723295a2954f4b0c65fde83a81c6c849414d51.png)\n\nThen, we scale this graph by a factor of $2.$ The $y$-intercept becomes $(0,2),$ and the resulting graph is as follows:\n\n![](images/b7/b747ae8c29f01b840930d81f9c4b706d049ca685ee982efff717ddb13213937d.png)"}] [{:db/id #edb/ref 17592186557217 :knowledge-point/_questions [{:db/id #edb/ref 17592186110669 :knowledge-point/id #uuid "34645eb8-3624-5ff3-817d-28f8d0cee4ba" :knowledge-point/title "Identifying the Scaling Constant From a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29951222-87d7-548a-9a5e-144857424fb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186556519} {:answer/id #uuid "46324b89-8e6d-58d2-acb1-a3d8251446db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186556585} {:answer/id #uuid "9ff11515-d97e-5995-80f0-2ad0af75b6ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186556820} {:answer/id #uuid "b92f6a22-272b-56d9-abd2-b059ce0496cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186556882} {:answer/id #uuid "e276d83b-7cf3-5d6b-86cd-b9f78e932f09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186556990}] :answer-field/correct {:answer/id #uuid "9ff11515-d97e-5995-80f0-2ad0af75b6ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186556820} :answer-field/id #uuid "50488e0d-3249-550c-8d98-bec9f2011aab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557111}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "228ddf28-6449-527a-a0f3-502e03cb4eba" :question/math-academy-id "q-18525" :question/problem "![](images/f9/f9738ccf12d8b9e8f3ed84870371972767e67a624f31fe5782f39679253965c4.png)\n\nThe graph above shows $y=k{(\\frac{1}{3})}^{x}.$ What is the value of $k?$" :question/worked-solution "To plot the graph of $y=k{(\\frac{1}{3})}^{x},$ we take the graph of $y={(\\frac{1}{3})}^{x}$ and stretch it vertically by a scale factor of  $k.$ Under the action of this transformation, the $y$-intercept is mapped from $(0,1)$ to $(0,k).$\n\nComparing the point $(0,4)$ on the graph to $(0,k),$ we see that we must have $k=4.$"}] [{:db/id #edb/ref 17592186557244 :knowledge-point/_questions [{:db/id #edb/ref 17592186110668 :knowledge-point/id #uuid "46b4837f-6ba5-5812-8dc7-4671fcd6b20d" :knowledge-point/title "Plotting a Vertically Scaled Exponential Decay Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19c4c61c-51ad-50d2-aac0-fb3d0ca8ba37" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/37/374572e9b9313502b6d806d37b095320496dc65d4e6383ea509b3ec30bc1aa85.png" :db/id #edb/ref 17592186556485} {:answer/id #uuid "1bb02bbf-e4db-51d2-820e-c820cd6c3132" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a3/a31cc9740f5db8ae825021de611c67b8114c3a5bffb13aca95b973b3718e8bd5.png" :db/id #edb/ref 17592186556493} {:answer/id #uuid "2307cbd4-8b2c-507e-9d61-ab458dea3b70" :answer/type {:db/id #edb/ref 175921860454