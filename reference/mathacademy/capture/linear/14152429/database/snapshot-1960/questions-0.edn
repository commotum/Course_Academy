20\" width=\"20\">$8$</td>\n<td align=\"left\" colspan=\"5\" height=\"20\" width=\"15\">$\\,\\enclose{longdiv}{2\\,\\phantom{|}3\\,\\phantom{|}8\\,.\\,0\\,\\phantom{|}0}$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\,\\,\\,\\,\\,\\,\\,$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$6$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$7$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$8$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\,\\,\\,\\,\\,$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$7$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$2$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$6$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\,\\,\\,\\,\\,$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$5$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$6$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$4$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\,\\,\\,\\,\\,$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$4$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n</tr>\n</tbody></table>\n<p></p></td>\n</tr>\n</tbody></table>\n\nTherefore,\n\n$$\n\\frac{238}{8}=29.75.\n$$"}] [{:db/id #edb/ref 17592186152676 :knowledge-point/_questions [{:db/id #edb/ref 17592186152127 :knowledge-point/id #uuid "be826645-6351-54ab-b57d-2c2a83a1b68d" :knowledge-point/title "Identifying Rational Decimals"} {:db/id #edb/ref 17592186489170 :knowledge-point/id #uuid "4c28dcab-dd12-58c2-88c6-0301dc0f9ce4" :knowledge-point/title "Identifying Rational Decimals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81b65eac-0d01-5e63-a86a-175e61ee884a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186150564} {:answer/id #uuid "893059fd-147d-54f6-92cb-3dd72a0d3ce8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186150565} {:answer/id #uuid "cecbaf33-69c6-5ad4-aada-7836443323a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186150566} {:answer/id #uuid "0c2b1620-3b61-5db4-abe5-c22aa26b2a13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186150567} {:answer/id #uuid "119199f6-e915-5adb-8374-0e4979d274c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186150568}] :answer-field/correct {:answer/id #uuid "cecbaf33-69c6-5ad4-aada-7836443323a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186150566} :answer-field/id #uuid "ea9c58c1-598e-51b6-96e7-17645bea528e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186150563}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c6c3e0da-28e4-5597-bf32-45b74ed695c0" :question/math-academy-id "q-68517" :question/problem "Which of the following numbers are rational?\n\nI. $3.624$\n\nII. $0.\\overset{―}{25}$\n\nIII. $7.526380…$" :question/worked-solution "Let's examine each of our numbers in turn.\n\n- $3.624$ is a rational number because it can be expressed as a ratio of two integers:\n\n$$\n3.624=\\frac{3\\,624}{1\\,000}\n$$\n\n- $0.\\overset{―}{25}$ is a rational number. The notation $\\overset{―}{25}$ tells us that the digits $2$ and $5$ after the decimal point repeat indefinitely.\n\n$$\n0.\\overset{―}{25}=0.2525252525…\n$$\n\nAny decimal with repeating digits can be represented as a ratio of two integers. In this case,\n\n$$\n0.\\overset{―}{25}=\\frac{25}{99}.\n$$\n\n- $7.526380…$ is not a rational number. The notation \"$…$\" tells us that digits after the decimal point extend forever. However, there are no repeating digits.\n\nTherefore, the correct answer is \"I and II only.\""}]}
