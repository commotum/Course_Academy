riant=\"normal\">∠</mi><mi>B</mi><mo>+</mo><mi>m</mi><mi mathvariant=\"normal\">∠</mi><mi>C</mi><mo>+</mo><mi>m</mi><mi mathvariant=\"normal\">∠</mi><mi>D</mi></mtd><mtd><mi></mi><mo>=</mo><msup><mn>360</mn><mo>∘</mo></msup></mtd></mtr><mtr><mtd><msup><mn>70</mn><mo>∘</mo></msup><mo>+</mo><msup><mn>75</mn><mo>∘</mo></msup><mo>+</mo><mi>m</mi><mi mathvariant=\"normal\">∠</mi><mi>C</mi><mo>+</mo><msup><mn>110</mn><mo>∘</mo></msup></mtd><mtd><mi></mi><mo>=</mo><msup><mn>360</mn><mo>∘</mo></msup></mtd></mtr><mtr><mtd><mi>m</mi><mi mathvariant=\"normal\">∠</mi><mi>C</mi><mo>+</mo><msup><mn>255</mn><mo>∘</mo></msup></mtd><mtd><mi></mi><mo>=</mo><msup><mn>360</mn><mo>∘</mo></msup></mtd></mtr><mtr><mtd><mi>m</mi><mi mathvariant=\"normal\">∠</mi><mi>C</mi></mtd><mtd><mi></mi><mo>=</mo><msup><mn>105</mn><mo>∘</mo></msup><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
