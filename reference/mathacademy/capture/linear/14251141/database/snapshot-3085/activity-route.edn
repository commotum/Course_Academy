#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186571490} :activity/id #uuid "138360b1-768e-5e3c-ac72-e07110620982" :activity/scope {:db/id #edb/ref 17592186049223 :topic/id #uuid "e4ba6b67-ce78-5f37-b120-6055b0e97c6c" :topic/math-academy-id 1319} :activity/steps [{:db/id #edb/ref 17592186571456 :step/content {:db/id #edb/ref 17592186571389 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "087ccede-33f5-5195-9b20-20231b7111e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186570904} {:answer/id #uuid "57b5d47e-d89a-5826-aea5-db085b14ccab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186571026} {:answer/id #uuid "c47bbdb0-97dd-558f-8cbd-d5cedcbbf537" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186571195} {:answer/id #uuid "da9be92d-36c8-5e75-9fa1-ce0bcc251023" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186571227} {:answer/id #uuid "ffd6fbd6-2ac9-570c-8cf7-38cf4ec08434" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186571280}] :answer-field/correct {:db/id #edb/ref 17592186571227} :answer-field/id #uuid "aa5a75a9-cf7a-5ed4-8499-ccb893baaf9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571349}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "407e8da8-449d-50a1-846d-17321f5d621f" :question/math-academy-id "q-68108" :question/problem "The sum of the interior angles of a polygon is ${1260}^{∘}.$ How many sides does it have?" :question/worked-solution "Remember that the sum of the interior angles of a polygon with $n$ sides is ${180}^{∘}\\cdot (n-2).$\n\nTo find the number of sides in our polygon, we start by setting up the following equation:\n\n$$\n{180}^{∘}\\cdot (n-2)=1\\,{260}^{∘}\n$$\n\nNow, we solve for $n,$ as follows:\n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & =1\\,{260}^{∘} \\\\ n-2 & =\\frac{1\\,{260}^{∘}}{{180}^{∘}} \\\\ n-2 & =7 \\\\ n & =9\\end{aligned}\n$$\n\nTherefore, the polygon has $n=9$ sides (so it is a nonagon)."} :step/id #uuid "000349e2-1e18-52dc-948a-61a295c5ca01"} {:db/id #edb/ref 17592186571462 :step/content {:db/id #edb/ref 17592186571431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55bbde82-dc2a-5198-9282-78920ca4d7b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{76}^{∘}" :db/id #edb/ref 17592186571020} {:answer/id #uuid "68d9c9d2-c4ee-5369-ad28-406b236d5756" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{80}^{∘}" :db/id #edb/ref 17592186571055} {:answer/id #uuid "715bae87-ddc1-5d3b-a222-2343cb0987a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{72}^{∘}" :db/id #edb/ref 17592186571067} {:answer/id #uuid "8ecfa468-92a9-55f5-9f15-5d0ce9e5f16b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{84}^{∘}" :db/id #edb/ref 17592186571113} {:answer/id #uuid "cee2fb05-a7b0-5c6e-88e4-091526dba551" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{92}^{∘}" :db/id #edb/ref 17592186571210}] :answer-field/correct {:db/id #edb/ref 17592186571020} :answer-field/id #uuid "f576a5f9-158f-5c8f-9257-5b6840166ec6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571374}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9e56717a-c5ad-51b8-ae63-5cc496ab485e" :question/math-academy-id "q-4310" :question/problem "![](images/fc/fc485a3c47295e08c917d1c9a2e90df0a0d6eaa931f4df23e17700da1536ca6e.png)\n\nIn the quadrilateral $OMNP$ shown above, find the measure of $∠N.$" :question/worked-solution "A quadrilateral has $n=4$ sides. Therefore, the sum of the interior angles of a quadrilateral must be \n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={180}^{∘}\\cdot (4-2) \\\\  & ={180}^{∘}\\cdot 2 \\\\  & ={360}^{∘}.\\end{aligned}\n$$\n\nAdding up the internal angles and solving for $x,$ we get\n\n$$\n\\begin{aligned}m∠M+m∠N+m∠P+m∠O & ={360}^{∘} \\\\ {104}^{∘}+(10x-{4}^{∘})+{104}^{∘}+{76}^{∘} & ={360}^{∘} \\\\ 10x+{280}^{∘} & ={360}^{∘} \\\\ 10x & ={80}^{∘} \\\\ x & ={8}^{∘}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}m∠N & =10x-{4}^{∘} \\\\  & =10({8}^{∘})-{4}^{∘} \\\\  & ={76}^{∘}.\\end{aligned}\n$$"} :step/id #uuid "168198c9-67f3-5f0f-8907-74beb26be266" :step/next {:db/id #edb/ref 17592186571456}} {:db/id #edb/ref 17592186571490 :step/content {:db/id #edb/ref 17592186106315 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "906388b6-93f9-5ca5-a23a-5c68acb32845" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "105^{∘}" :db/id #edb/ref 17592186104039} {:answer/id #uuid "038caf9d-24e4-5261-b4b7-93f45459b83a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "125^{∘}" :db/id #edb/ref 17592186104040} {:answer/id #uuid "210f4cc2-b4c4-5b25-9892-f0a285e15759" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "115^{∘}" :db/id #edb/ref 17592186104041} {:answer/id #uuid "3c811a6e-5a94-5f69-8deb-0d0415c81014" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "110^{∘}" :db/id #edb/ref 17592186104042} {:answer/id #uuid "6e453b8a-ef6d-5bf4-8a09-cfad11ab71b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "95^{∘}" :db/id #edb/ref 17592186104043}] :answer-field/id #uuid "ddeecf2e-88eb-55a2-8a26-c77cbaf870a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186104038}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7ba7dcfb-4dc0-5068-be2d-bf724179f704" :question/math-academy-id "q-4216" :question/problem "![](images/f2/f22e09654fb5562f1ac1b91b9ced70c41c5f796705f4bf76820950f69f706fb9.png)\n\nFind $m∠C$ In the quadrilateral $ABCD$ above."} :step/id #uuid "7983dc6b-c0cf-5e72-baec-ade88db8ba03" :step/next {:db/id #edb/ref 175921