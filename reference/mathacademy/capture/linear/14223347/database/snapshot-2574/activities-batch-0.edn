#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186055890} :activity/id #uuid "c6035687-0b20-5278-942e-d7c865a8e2a4" :activity/scope {:db/id #edb/ref 17592186050127 :topic/id #uuid "2ed40600-0b7c-5540-8255-04fca5187c09" :topic/math-academy-id 64} :activity/steps [{:db/id #edb/ref 17592186055890 :step/content {:db/id #edb/ref 17592186056016 :tutorial/content "To **evaluate** the expression $3+x$ for $x={\\color{blue}2}$, we replace $x$ with $\\color{blue}2$ in the expression and simplify:\n\n$$\n\\begin{aligned}3+x & = \\\\ 3+(2) & = \\\\ 3+2 & = \\\\ 5 & \\end{aligned}\n$$" :tutorial/id #uuid "f4532e0a-1865-5de3-b251-2774b7d5d45d" :tutorial/math-academy-id 8079 :tutorial/title "Introduction"} :step/id #uuid "34a47b76-009d-562d-9fa3-84f6480e10ea" :step/math-academy-id 73028 :step/next {:db/id #edb/ref 17592186055891}} {:db/id #edb/ref 17592186055891 :step/content {:db/id #edb/ref 17592186054838 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054393 :question/id #uuid "dad98e52-6c94-5cb9-95f1-0db822fbb44a" :question/math-academy-id "e-12915"} :knowledge-point/id #uuid "9a02aff6-185a-56b7-8139-5efad8ddf403" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048888} {:db/id #edb/ref 17592186050618}] :knowledge-point/questions [{:db/id #edb/ref 17592186055412} {:db/id #edb/ref 17592186055478} {:db/id #edb/ref 17592186055479} {:db/id #edb/ref 17592186479062} {:db/id #edb/ref 17592186479123}] :knowledge-point/title "Evaluating Linear Expressions"} :step/id #uuid "7a44adb4-ec60-5635-a786-870b859b9277" :step/math-academy-id 73029 :step/next {:db/id #edb/ref 17592186055892}} {:db/id #edb/ref 17592186055892 :step/content {:db/id #edb/ref 17592186054839 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054424 :question/id #uuid "6acd4bf9-8cf9-5a35-a1f5-a9a01766af87" :question/math-academy-id "e-13069"} :knowledge-point/id #uuid "f915db41-a929-5ff0-b571-9ab3a1d510e5" :knowledge-point/questions [{:db/id #edb/ref 17592186055062} {:db/id #edb/ref 17592186055288} {:db/id #edb/ref 17592186055289} {:db/id #edb/ref 17592186479069} {:db/id #edb/ref 17592186479111} {:db/id #edb/ref 17592186491149} {:db/id #edb/ref 17592186536818} {:db/id #edb/ref 17592186536859}] :knowledge-point/title "Evaluating Linear Expressions Containing Fractions"} :step/id #uuid "c4f792f2-3137-5f3d-835f-27e81b7b0ddb" :step/math-academy-id 73033 :step/next {:db/id #edb/ref 17592186055893}} {:db/id #edb/ref 17592186055893 :step/content {:db/id #edb/ref 17592186056017 :tutorial/content "The usual order of operations (PEMDAS) applies when evaluating expressions. So when an algebraic expression contains parentheses $(\\ldots)$, we calculate what's inside the parentheses *first*. \n\nFor example, we evaluate $6 - (2x+3)$ at $x=3$, as follows:\n\n$$\n\\begin{aligned}6-(2x+3) & = \\\\ 6-(2\\cdot 3+3) & = \\\\ 6-(6+3) & = \\\\ 6-9 & = \\\\ -3.\\end{aligned}\n$$" :tutorial/id #uuid "34dded6d-159e-5c07-9693-340cd7e2080e" :tutorial/math-academy-id 8081 :tutorial/title "Evaluating Expressions Containing Parentheses"} :step/id #uuid "6c3059f6-37e7-57cf-a1da-3e8a8ac0f0b4" :step/math-academy-id 73037 :step/next {:db/id #edb/ref 17592186055894}} {:db/id #edb/ref 17592186055894 :step/content {:db/id #edb/ref 17592186054840 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054394 :question/id #uuid "51bb6ac7-5c24-5805-85ba-9c697f4360b6" :question/math-academy-id "e-12919"} :knowledge-point/id #uuid "e5dcee75-1c40-5885-81e2-960bee2dd3a8" :knowledge-point/questions [{:db/id #edb/ref 17592186055260} {:db/id #edb/ref 17592186055261} {:db/id #edb/ref 17592186055268} {:db/id #edb/ref 17592186479081} {:db/id #edb/ref 17592186479109} {:db/id #edb/ref 17592186491166}] :knowledge-point/title "Evaluating Expressions of a Single Variable with Parentheses"} :step/id #uuid "0feb005d-8dfd-50f1-975c-f0edcb47caeb" :step/math-academy-id 73038 :step/next {:db/id #edb/ref 17592186055895}} {:db/id #edb/ref 17592186055895 :step/content {:db/id #edb/ref 17592186056018 :tutorial/content "If an expression contains more than one variable, we evaluate it using the same procedure, replacing each variable with the appropriate value.\n\nFor example, to find the value of $2b + \\dfrac{1}{2}a$ when $a=-2$ and $b=3,$ we replace $a$ with $-2$ and $b$ with $3\\mathbin{:}$\n\n$$\n\\begin{aligned}2b+\\frac{1}{2}a & = \\\\ 2\\cdot 3+\\frac{1}{2}\\cdot (-2) & = \\\\ 6-1 & = \\\\ 5\\end{aligned}\n$$" :tutorial/id #uuid "5858aaa3-b757-5794-a965-368222b8122f" :tutorial/math-academy-id 8082 :tutorial/title "Evaluating Expressions Containing More Than One Variable"} :step/id #uuid "fd60f94d-fcfc-5630-bf91-5646b04bf125" :step/math-academy-id 73042 :step/next {:db/id #edb/ref 17592186055896}} {:db/id #edb/ref 17592186055896 :step/content {:db/id #edb/ref 17592186054841 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054395 :question/id #uuid "caf5354e-e240-5515-94c7-6c3caa2063af" :question/math-academy-id "e-12920"} :knowledge-point/id #uuid "6d42c63b-4549-5ed0-8da5-72561253acb9" :knowledge-point/questions [{:db/id #edb/ref 17592186055266} {:db/id #edb/ref 17592186055267} {:db/id #edb/ref 17592186479068} {:db/id #edb/ref 17592186479125} {:db/id #edb/ref 17592186536895}] :knowledge-point/title "Evaluating Expressions Containing Multiple Variables"} :step/id #uuid "561eb475-e13d-577e-88df-bf741708db2f" :step/math-academy-id 73043}] :activity/title "Evaluating Linear Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054916}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186491276} :activity/id #uuid "c5c757e6-bbf4-5e43-b295-6e94b7d7c532" :activity/scope {:db/id #edb/ref 17592186050127 :topic/id #uuid "2ed40600-0b7c-5540-8255-04fca5187c09" :topic/math-academy-id 64} :activity/steps [{:db/id #edb/ref 17592186491231 :step/content {:db/id #edb/ref 17592186491166 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3a3f7b6-e8b6-5e89-888c-8054c2bbbae3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186490846}] :answer-field/correct {:db/id #edb/ref 17592186490846} :answer-field/id #uuid "73f6cac1-03ce-521d-a9ba-b9024d58d2b5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186491047}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "79ba2bde-8132-53b1-8d2a-2c8fb0089fe0" :question/math-academy-id "q-180248" :question/problem "If $h=5,$ then $3(h-8)+11=${{field-1}}." :question/worked-solution "We replace $h$ with $5$ in the expression and evaluate the parentheses first:\n\n$$\n\\begin{aligned}3(h-8)+11 & = \\\\ 3(5-8)+11 & = \\\\ 3(-3)+11 & = \\\\ -9+11 & = \\\\ 2 & \\end{aligned}\n$$"} :step/id #uuid "39d80571-3269-5150-845b-28436a0a2497"} {:db/id #edb/ref 17592186491246 :step/content {:db/id #edb/ref 17592186491149 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "abfc1b8e-9de5-5538-aee2-de9cac0e9509" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186490853}] :answer-field/correct {:db/id #edb/ref 17592186490853} :answer-field/id #uuid "ae77bf12-3e74-5cbf-b87a-cc3a8d30f6a1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186491071}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5b99e56c-ad94-54d0-842e-fa2fe1eccf19" :question/math-academy-id "q-179537" :question/problem "If $v=8,$ then $2-\\frac{v}{5}=${{field-1}}." :question/worked-solution "Replacing $v$ with $8$ in the expression, we get\n\n$$\n\\begin{aligned}2-\\frac{v}{5} & = \\\\ 2-\\frac{8}{5} & = \\\\ \\frac{2\\cdot 5-8}{5} & = \\\\ \\frac{2}{5} & .\\end{aligned}\n$$"} :step/id #uuid "6bf4c860-29fa-57b1-8224-b01d35195e0f" :step/next {:db/id #edb/ref 17592186491231}} {:db/id #edb/ref 17592186491276 :step/content {:db/id #edb/ref 17592186055289 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f91b176-7a76-531d-bf78-d71efd4387f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186052972} {:answer/id #uuid "b92e5659-9a39-53ea-9213-d39f1ed36e56" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186052973} {:answer/id #uuid "f3b6aae1-a2f8-5c78-ab69-05c5e8cd91a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186052974} {:answer/id #uuid "11d98231-154d-5aa8-a2a4-915b69036b58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186052975} {:answer/id #uuid "12a6ca44-5064-5ec7-bec7-d128f6981b6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186052976}] :answer-field/correct {:db/id #edb/ref 17592186052976} :answer-field/id #uuid "176da1dd-e17f-5c3d-aaf3-4fabcd678809" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186052971}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "74548fba-87bb-5bd8-bd8a-1a1dbe7d1130" :question/math-academy-id "q-44272" :question/problem "Evaluate $3-\\frac{m}{3}$ for $m=6.$" :question/worked-solution "Replacing $m$ with $6$ in the expression, we get\n\n$$\n\\begin{aligned}3-\\frac{m}{3} & = \\\\ 3-\\frac{6}{3} & = \\\\ 3-2 & = \\\\ 1.\\end{aligned}\n$$"} :step/id #uuid "f968670f-d1d6-543f-b58f-f0cbb571267d" :step/next {:db/id #edb/ref 17592186491246}}] :activity/title "Evaluating Linear Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186490510}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186536964} :activity/id #uuid "64f22741-1620-5ebf-a698-c114e4dfd2d4" :activity/scope {:db/id #edb/ref 17592186050127 :topic/id #uuid "2ed40600-0b7c-5540-8255-04fca5187c09" :topic/math-academy-id 64} :activity/steps [{:db/id #edb/ref 17592186536907 :step/content {:db/id #edb/ref 17592186536818 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d3ba2ca-3832-5dc3-9fb9-10f0bb92af21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186536467} {:answer/id #uuid "6ebd1e88-6bcf-591f-926c-4a1673c2672c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186536469} {:answer/id #uuid "caccab01-04b7-51d0-a959-905fccb9ed6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186536603} {:answer/id #uuid "f10524ba-6897-50bd-a165-464eef34e996" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186536666} {:answer/id #uuid "ffad4caf-5fdb-50bf-a855-3942f62af10f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186536693}] :answer-field/correct {:db/id #edb/ref 17592186536693} :answer-field/id #uuid "b81d465f-8515-5dea-92b5-4f5818d1c903" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536778}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "23eee6bd-a3f3-5d31-99a2-293051ea115d" :question/math-academy-id "q-179516" :question/problem "Evaluate $8+\\frac{3x}{4}$ for $x=-8.$" :question/worked-solution "Replacing $x$ with $-8$ in the expression, we get\n\n$$\n\\begin{aligned}8+\\frac{3x}{4} & = \\\\ 8+\\frac{3}{4}\\cdot (-8) & = \\\\ 8-\\frac{24}{4} & = \\\\ 8-6 & = \\\\ 2 & .\\end{aligned}\n$$"} :step/id #uuid "0f37d062-2bc9-5789-a927-01f7e374eae9"} {:db/id #edb/ref 17592186536961 :step/content {:db/id #edb/ref 17592186536895 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d10c19e-e150-55eb-b24f-880c7b312823" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186536466} {:answer/id #uuid "a3b3c01c-522f-573c-9eb2-ad4d95b6fe5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186536548} {:answer/id #uuid "aabb5221-9e59-59ad-89e3-cdfd40a76ef1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-22" :db/id #edb/ref 17592186536557} {:answer/id #uuid "ceffc3ea-0be6-5e49-bd61-93965c77fc7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186536609} {:answer/id #uuid "ee0c7ef3-1224-563f-ab0a-0e9a6c26a9b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "22" :db/id #edb/ref 17592186536662}] :answer-field/correct {:db/id #edb/ref 17592186536609} :answer-field/id #uuid "bd06868d-23f4-5b1c-a48c-3253d06db7ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536783}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f350f45b-6b40-5442-831e-bda149e4ff5d" :question/math-academy-id "q-41203" :question/problem "If $p=2$ and $q=-2,$ then $8p+7q+2=$" :question/worked-solution "Replacing $p$ with $2$ and $q$ with $-2$ in the expression, we get\n\n$$\n\\begin{aligned}8p+7q+2 & = \\\\ 8(2)+7(-2)+2 & = \\\\ 16+(-14)+2 & = \\\\ 16-14+2 & = \\\\ 4.\\end{aligned}\n$$"} :step/id #uuid "b3cc2331-6b4e-5004-b3ef-6e9ebe344a7c" :step/next {:db/id #edb/ref 17592186536907}} {:db/id #edb/ref 17592186536964 :step/content {:db/id #edb/ref 17592186055261 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "836062b0-524b-538a-ae83-7cad477cb4ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186052804} {:answer/id #uuid "8536fa93-92ba-5579-8423-a5d6f6b4e5c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186052805} {:answer/id #uuid "965dad9f-9100-51ca-9460-5f28cbd40484" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186052806} {:answer/id #uuid "9b99030e-5927-5114-bb6a-579ed4a631f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186052807} {:answer/id #uuid "1c804d08-6d90-5c98-bbd8-0145eeb15e1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186052808}] :answer-field/correct {:db/id #edb/ref 17592186052805} :answer-field/id #uuid "0738cf39-8cba-5493-9162-fc131deb3619" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186052803}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a40f13fa-0e75-5597-9336-15bb065e38ac" :question/math-academy-id "q-41015" :question/problem "Evaluate $1+(2-3x)$ for $x=-1.$" :question/worked-solution "We replace $x$ with $-1$ in the expression and evaluate the parentheses first:\n\n$$\n\\begin{aligned}1+(2-3x) & = \\\\ 1+(2-3\\cdot (-1)) & = \\\\ 1+(2-(-3)) & = \\\\ 1+(2+3) & = \\\\ 1+5 & = \\\\ 6\\end{aligned}\n$$"} :step/id #uuid "bb29e9d5-2794-5eb8-b471-0795b5e1d4ca" :step/next {:db/id #edb/ref 17592186536961}}] :activity/title "Evaluating Linear Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186536275}]}
