    "q-179516": {
      "dom_id": "step-q179516",
      "name": "Question 3",
      "problem": "Evaluate $8+\\frac{3x}{4}$ for $x=-8.$",
      "worked_solution": "Replacing $x$ with $-8$ in the expression, we get\n\n$$\n\\begin{aligned}8+\\frac{3x}{4} & = \\\\ 8+\\frac{3}{4}\\cdot (-8) & = \\\\ 8-\\frac{24}{4} & = \\\\ 8-6 & = \\\\ 2 & .\\end{aligned}\n$$",
      "calculator_instructions": "",
