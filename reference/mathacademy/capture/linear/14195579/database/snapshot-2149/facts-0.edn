72 #uuid "35ea5fbe-0a0e-53a6-8872-3cafe1bfb9c7" #edb/ref 17592186045417] [17592186193285 #edb/ref 1068 #edb/ref 17592186191552 #edb/ref 17592186045417] [17592186193285 #edb/ref 1068 #edb/ref 17592186191553 #edb/ref 17592186045417] [17592186193285 #edb/ref 1069 "q-238087" #edb/ref 17592186045417] [17592186193285 #edb/ref 1071 "Consider the following system of equations:\n\n${-5x + 2y = 11; 7x + 4y = 5$\n\nFind the solution $(x, y)$ to this system by eliminating the variable $y$.\n\nThe solution is $($\n{{field-1}} $$,\n{{field-2}}\n$)$." #edb/ref 17592186045417] [17592186193285 #edb/ref 1072 #uuid "659bfd82-a0b2-5112-81eb-2185b857af31" #edb/ref 17592186045417] [17592186193457 #edb/ref 1058 #edb/ref 17592186193458 #edb/ref 17592186045417] [17592186193457 #edb/ref 1061 196622 #edb/ref 17592186045417] [17592186193457 #edb/ref 1062 #uuid "6912b472-9f6a-508c-a69c-38d65838fd66" #edb/ref 17592186045417] [17592186193457 #edb/ref 1063 #edb/ref 17592186193941 #edb/ref 17592186045417] [17592186193458 #edb/ref 1058 #edb/ref 17592186193459 #edb/ref 17592186045417] [17592186193458 #edb/ref 1061 196623 #edb/ref 17592186045417] [17592186193458 #edb/ref 1062 #uuid "49980fef-ad30-5576-b1f1-83af40688b8d" #edb/ref 17592186045417] [17592186193458 #edb/ref 1063 #edb/ref 17592186192654 #edb/ref 17592186045417] [17592186193459 #edb/ref 1058 #edb/ref 17592186193460 #edb/ref 17592186045417] [17592186193459 #edb/ref 1061 196626 #edb/ref 17592186045417] [17592186193459 #edb/ref 1062 #uuid "265ee39c-4cd0-5b4e-aa5d-ee235fb56821" #edb/ref 17592186045417] [17592186193459 #edb/ref 1063 #edb/ref 17592186192655 #edb/ref 17592186045417] [17592186193460 #edb/ref 1058 #edb/ref 17592186193461 #edb/ref 17592186045417] [17592186193460 #edb/ref 1061 196629 #edb/ref 17592186045417] [17592186193460 #edb/ref 1062 #uuid "eda2262d-345c-51a1-8e6b-f401d897793d" #edb/ref 17592186045417] [17592186193460 #edb/ref 1063 #edb/ref 17592186192656 #edb/ref 17592186045417] [17592186193461 #edb/ref 1061 196633 #edb/ref 17592186045417] [17592186193461 #edb/ref 1062 #uuid "b192016c-1e87-5722-996d-cfdb2a97badd" #edb/ref 17592186045417] [17592186193461 #edb/ref 1063 #edb/ref 17592186192657 #edb/ref 17592186045417] [17592186193941 #edb/ref 1064 "Suppose we want to solve the following system of linear equations using the elimination method:\n\n$$\n{x + 2y = 1; x - y =-2\n$$\n\nAs it stands, adding the two equations will not eliminate any of the variables.\n\nHowever, suppose we want to eliminate the variable $x$. We begin by multiplying the second equation by $\\color{blue}-1$, which gives the following equivalent system:\n\n$$\n{(x + 2y = 1; (x - y =-2)\\cdot (-1)\n$$\n\nThen, we add the two resulting equations together. This will eliminate the variable $x$, allowing us to solve for $y$:\n\n$$\n\\begin{aligned}\nx + 2y &= 1 \\\\\n- x + y &= 2 \\\\\n(2y + y) &= (1 + 2) \\\\\n3y &= 3 \\\\\ny &= 1\n\\end{aligned}\n$$\n\nSo, the solution must have $y=1$. However, we still need to find $x$. To do this, we substitute $y=1$ back into one of the equations. Let's choose the second equation:\n\n$$\n\\begin{aligned}\nx - y &= -2 \\\\\nx - (1) &= -2 \\\\\nx &= -1\n\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=-1$ and $y=1$, which can be expressed as $(-1, 1)$." #edb/ref 17592186045417] [17592186193941 #edb/ref 1065 8703 #edb/ref 17592186045417] [17592186193941 #edb/ref 1066 #uuid "97211668-1a0d-5471-9a0a-c223dfb2f8a6" #edb/ref 17592186045417] [17592186193941 #edb/ref 1067 "Introduction" #edb/ref 17592186045417]}
