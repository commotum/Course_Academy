swer-field/id #uuid "24fdb15c-a8b3-5277-abc3-5f3c2cfa726d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186191552} {:answer-field/id #uuid "7a2a4186-c9b8-58ca-9163-304a07832933" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186191553}] :question/id #uuid "659bfd82-a0b2-5112-81eb-2185b857af31" :question/math-academy-id "q-238087" :question/problem "Consider the following system of equations:\n\n${-5x + 2y = 11; 7x + 4y = 5$\n\nFind the solution $(x, y)$ to this system by eliminating the variable $y$.\n\nThe solution is $($\n{{field-1}} $$,\n{{field-2}}\n$)$."}]}
