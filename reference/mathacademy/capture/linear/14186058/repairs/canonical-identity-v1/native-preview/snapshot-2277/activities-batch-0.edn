#{[{:activity/first-step {:db/id #edb/ref 17592186116385} :activity/id #uuid "b85783b5-715c-504c-962c-64f5c0c99bb0" :activity/scope {:db/id #edb/ref 17592186050661 :topic/id #uuid "5d18c23d-b718-5823-8edb-6d9b84a6faab" :topic/math-academy-id 1639} :activity/steps [{:db/id #edb/ref 17592186115996 :step/content {:db/id #edb/ref 17592186116451 :tutorial/content "Two angles don't have to be adjacent to be complementary. As long as their measures add up to $90^\\circ$, they are complementary.\n\nSo, for instance, the following angles are also complementary, even though they are not adjacent:\n\n![](images/83/8330ff57974640f90f46662932bf6023e55bc26a68471232387c09fb1bec3702.png)" :tutorial/id #uuid "0194ee9a-7629-59f5-809c-f0fe7c23aee5" :tutorial/math-academy-id 2356 :tutorial/title "Non-Adjacent Complementary Angles"} :step/id #uuid "276ae67c-3602-59c5-bd34-f8b205c38d8c" :step/math-academy-id 10146 :step/next {:db/id #edb/ref 17592186116387}} {:db/id #edb/ref 17592186116385 :step/content {:db/id #edb/ref 17592186116445 :tutorial/content "**Complementary angles** are two angles whose measures have a sum of $90^\\circ$, a right angle.\n\n![](images/27/2723049c087f5fa7b061bc9f1d4fb8c894c1e94aee3dfb994a237cd889a377e0.png)\n\nFor example, the angles in the diagram above are complementary because the sum of their measures is $90^\\circ$:\n\n$$\n60^\\circ +30^\\circ = 90^\\circ\n$$" :tutorial/id #uuid "afcaca1a-2251-56a1-8a14-8094eb10881b" :tutorial/math-academy-id 2192 :tutorial/title "Introduction"} :step/id #uuid "19af5218-338f-5484-b5aa-81756b2575f6" :step/math-academy-id 8799 :step/next {:db/id #edb/ref 17592186116386}} {:db/id #edb/ref 17592186116386 :step/content {:db/id #edb/ref 17592186115402 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114978 :question/id #uuid "af3cc0f3-0971-5b26-b9bc-eda04373f225" :question/math-academy-id "e-2620"} :knowledge-point/id #uuid "72e4154b-bb7a-5029-b698-98588634d677" :knowledge-point/key-prerequisites [{:db/id #edb/ref 175