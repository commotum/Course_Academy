#{[{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186116385} :activity/id #uuid "b85783b5-715c-504c-962c-64f5c0c99bb0" :activity/scope {:db/id #edb/ref 17592186050661 :topic/id #uuid "5d18c23d-b718-5823-8edb-6d9b84a6faab" :topic/math-academy-id 1639} :activity/steps [{:db/id #edb/ref 17592186116385 :step/content {:db/id #edb/ref 17592186116445 :tutorial/content "**Complementary angles** are two angles whose measures have a sum of $90^\\circ,$ a right angle.\n\n![](images/27/2723049c087f5fa7b061bc9f1d4fb8c894c1e94aee3dfb994a237cd889a377e0.png)\n\nFor example, the angles in the diagram above are complementary because the sum of their measures is $90^\\circ\\mathbin{:}$\n\n$$\n60^\\circ +30^\\circ = 90^\\circ\n$$" :tutorial/id #uuid "afcaca1a-2251-56a1-8a14-8094eb10881b" :tutorial/math-academy-id 13548 :tutorial/title "Introduction"} :step/id #uuid "19af5218-338f-5484-b5aa-81756b2575f6" :step/math-academy-id 484813 :step/next {:db/id #edb/ref 17592186521657}} {:db/id #edb/ref 17592186116387 :step/content {:db/id #edb/ref 17592186115403 :knowledge-point/canonical-example {:db/id #edb/ref 17592186503653 :question/id #uuid "0d68be9a-8e75-5378-a88f-92da1a8cda66" :question/math-academy-id "e-18991"} :knowledge-point/id #uuid "b6f00614-8fb3-5aed-8730-2118f31ab4d8" :knowledge-point/questions [{:db/id #edb/ref 17592186115634} {:db/id #edb/ref 17592186115904} {:db/id #edb/ref 17592186503694} {:db/id #edb/ref 17592186503734} {:db/id #edb/ref 17592186503736} {:db/id #edb/ref 17592186503748}] :knowledge-point/title "Finding an Unknown Quantity Using Complementary Angles"} :step/id #uuid "790ac8d8-6b3c-515e-bae7-1b5db1ffcb7b" :step/math-academy-id 484817 :step/next {:db/id #edb/ref 17592186116389}} {:db/id #edb/ref 17592186116389 :step/content {:db/id #edb/ref 17592186115405 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114981 :question/id #uuid "0c3ef1dc-0262-5bed-9980-1672ca0e6f62" :question/math-academy-id "e-18993"} :knowledge-point/id #uuid "13c03056-9692-573f-bf7e-b938ec3a6529" :knowledge-point/questions [{:db/id #edb/ref 17592186115637} {:db/id #edb/ref 17592186115638}] :knowledge-point/title "Solving Multi-Step Problems Involving Complementary Angles"} :step/id #uuid "a2f44644-7f23-5c1b-a15d-3ba19782fc8c" :step/math-academy-id 484820} {:db/id #edb/ref 17592186521612 :step/content {:db/id #edb/ref 17592186521659 :tutorial/content "Now, consider the following diagram.\n\n![](images/02/02d8744bbc39ac9ed10d276071599f9008185023ebdfc3aaf97aebd498d82629.png)\n\nLet's solve for $x$ given the figure above.\n\nFrom the diagram, we have two complementary angles, so\n\n$$\n46^\\circ + (8x + 4^\\circ) = 90^\\circ.\n$$\n\nHence, we can solve for $x$ as follows:\n\n$$\n\\begin{aligned}{46}^{∘}+(8x+{4}^{∘}) & ={90}^{∘} \\\\ 8x+{50}^{∘} & ={90}^{∘} \\\\ 8x & ={40}^{∘} \\\\ x & ={5}^{∘}\\end{aligned}\n$$" :tutorial/id #uuid "62b39d73-2c91-59ba-9e98-44a61a98c7b4" :tutorial/math-academy-id 15157 :tutorial/title "Working With Diagrams"} :step/id #uuid "70f7bf88-80a0-59ab-b3a1-742cf3923640" :step/math-academy-id 619142 :step/next {:db/id #edb/ref 17592186116387}} {:db/id #edb/ref 17592186521657 :step/content {:db/id #edb/ref 17592186503647 :knowledge-point/canonical-example {:db/id #edb/ref 17592186503730 :question/id #uuid "b2c15979-d071-5f8a-b3a3-0e1228124d71" :question/math-academy-id "e-18990"} :knowledge-point/id #uuid "e79fca72-ad43-5c9b-94cd-57daec56de76" :knowledge-point/questions [{:db/id #edb/ref 17592186503682} {:db/id #edb/ref 17592186503710}] :knowledge-point/title "Finding an Unknown Complementary Angle"} :step/id #uuid "fab99fb7-13ba-526e-9805-8357cfddf511" :step/math-academy-id 484814 :step/next {:db/id #edb/ref 17592186521612}}] :activity/title "Complementary Angles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115442}]}
