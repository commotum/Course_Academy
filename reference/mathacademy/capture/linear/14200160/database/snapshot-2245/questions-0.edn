#{[{:db/id #edb/ref 17592186054533 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054730 :knowledge-point/id #uuid "bc8aa32b-ebb2-5c6e-8436-2fbd8282a90d" :knowledge-point/title "Multiplying a Complex Number by a Real Number"}] :question/id #uuid "2a1183fe-8fdc-549e-8f1b-4b0d6b7909aa" :question/math-academy-id "e-4040" :question/problem "Evaluate $2 \\cdot 3\\,\\textrm{i}.$" :question/worked-solution "Multiplying a purely imaginary number by a real number is similar to multiplying two monomials.\n\nFor the given problem, we have\n\n$$\n2\\cdot 3\\,\\textrm{i}\n\t= (2\\cdot 3) \\,\\textrm{i}\n\t= 6\\,\\textrm{i}.\n$$"}] [{:db/id #edb/ref 17592186054534 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054731 :knowledge-point/id #uuid "77c51556-8646-5850-a24d-3fadf6b5a546" :knowledge-point/title "Multiplying Two Purely Imaginary Numbers"}] :question/id #uuid "fb4ef9ac-0c5d-5fab-b84f-c2bad182b3c3" :question/math-academy-id "e-4041" :question/problem "Evaluate $2\\,\\textrm{i}\\cdot (-3\\,\\textrm{i}).$" :question/worked-solution "Multiplying two purely imaginary numbers is similar to multiplying two monomials. We also use the fact that $\\textrm{i}^2=-1.$\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}2\\,\\text{i}\\cdot (-3\\,\\text{i}) & =2\\cdot (-3)\\cdot {\\text{i}}^{2} \\\\  & =-6\\,{\\text{i}}^{2} \\\\  & =-6\\cdot (-1) \\\\  & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054535 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054732 :knowledge-point/id #uuid "f8e2d975-43da-5efc-8741-fc2e206bed29" :knowledge-point/title "Multiplying a Complex Number by a Purely Imaginary Number"}] :question/id #uuid "8f53a72e-adc4-584d-8d51-efb42c3ddbc3" :question/math-academy-id "e-4043" :question/problem "Evaluate $6\\,\\textrm{i}\\cdot(4 + 2\\,\\textrm{i}).$" :question/worked-solution "To multiply a complex number by a purely imaginary number, we use the distributive property and the fact that $\\textrm{i}^2 = -1.$\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}6\\,\\text{i}\\cdot (4+2\\,\\text{i}) & =6\\,\\text{i}\\cdot 4+6\\,\\text{i}\\cdot 2\\,\\text{i} \\\\  & =4\\cdot 6\\,\\text{i}+6\\cdot 2\\cdot \\,{\\text{i}}^{2} \\\\  & =24\\,\\text{i}+12\\cdot (-1) \\\\  & =24\\,\\text{i}-12 \\\\  & =-12+24\\,\\text{i}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054536 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054733 :knowledge-point/id #uuid "a09b3f4a-a1df-504e-8e9f-510225da1392" :knowledge-point/title "Multiplying Two Complex Numbers"}] :question/id #uuid "c3412df7-29a2-50d3-be4d-e2c6fcf8804a" :question/math-academy-id "e-4044" :question/problem "Evaluate $(1 - 3\\,\\textrm{i})(2 + 4\\, \\textrm{i}).$" :question/worked-solution "Multiplying two complex numbers is similar to multiplying two binomials. We also use the fact that $\\textrm{i}^2 = -1.$\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(1-3\\,\\text{i})(2+4\\,\\text{i}) & =1\\cdot 2+1\\cdot 4\\,\\text{i}+(-3\\,\\text{i})\\cdot 2+(-3\\,\\text{i})\\cdot 4\\,\\text{i} \\\\  & =2+4\\,\\text{i}-6\\,\\text{i}-12\\,{\\text{i}}^{2} \\\\  & =2-2\\,\\text{i}-12\\cdot (-1) \\\\  & =2-2\\,\\text{i}+12 \\\\  & =14-2\\,\\text{i}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186516839 :knowledge-point/_questions [{:db/id #edb/ref 17592186054731 :knowledge-point/id #uuid "77c51556-8646-5850-a24d-3fadf6b5a546" :knowledge-point/title "Multiplying Two Purely Imaginary Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ca8ef22-6814-53ad-9235-ed6ef6841a6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20\\,\\text{i}" :db/id #edb/ref 17592186516138} {:answer/id #uuid "4f86693a-6fde-5cf0-a418-81ec424e61f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186516276} {:answer/id #uuid "61497f7c-8daf-56de-9ce0-88f52004f4b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186516323} {:answer/id #uuid "8eddba26-64a4-5abb-a73a-2d1bac7377ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186516410} {:answer/id #uuid "b0fc2cd3-ff77-5c8a-aede-9a83db9c1c12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{i}" :db/id #edb/ref 17592186516479}] :answer-field/correct {:answer/id #uuid "61497f7c-8daf-56de-9ce0-88f52004f4b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186516323} :answer-field/id #uuid "87528f74-e184-53fa-9700-2d274f3beff9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516715}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b42abf22-f9b8-53ea-a9b2-d2089bc8c810" :question/math-academy-id "q-113005" :question/problem "$10\\,\\text{i}\\cdot 2\\,\\text{i}=$" :question/worked-solution "Multiplying two purely imaginary numbers is similar to multiplying two monomials. We also use the fact that ${\\text{i}}^{2}=-1.$\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}10\\,\\text{i}\\cdot 2\\,\\text{i} & =10\\cdot 2\\cdot {\\text{i}}^{2} \\\\  & =20\\,{\\text{i}}^{2} \\\\  & =20\\cdot (-1) \\\\  & =-20.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186516869 :knowledge-point/_questions [{:db/id #edb/ref 17592186054732 :knowledge-point/id #uuid "f8e2d975-43da-5efc-8741-fc2e206bed29" :knowledge-point/title "Multiplying a Complex Number by a Purely Imaginary Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b87c381-1bbc-5639-98b2-a0bfe7627031" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5-7\\,\\text{i}" :db/id #edb/ref 17592186516134} {:answer/id #uuid "34e236ff-bef6-5