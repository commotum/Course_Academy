07-fb398a618154" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-56" :db/id #edb/ref 17592186516565}] :answer-field/correct {:answer/id #uuid "d69e2601-7aaf-5155-8007-fb398a618154" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-56" :db/id #edb/ref 17592186516565} :answer-field/id #uuid "778b917c-7b8f-5ae3-8ad1-6d5052ea5cd8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186516709}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0d32bc5c-aa8a-5acb-83e8-efefaeff57bd" :question/math-academy-id "q-250413" :question/problem "Evaluate the following product.\n\n$(-7\\,\\text{i})\\cdot (-8\\,\\text{i})=${{field-1}}" :question/worked-solution "Multiplying two purely imaginary numbers is similar to multiplying two monomials. We also use the fact that ${i}^{2}=-1.$\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(-7\\,\\text{i})\\cdot (-8\\,\\text{i}) & =(-7)\\cdot (-8)\\cdot {\\text{i}}^{2} \\\\  & =56\\,{\\text{i}}^{2} \\\\  & =56\\cdot (-1) \\\\  & =-56.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186055456 :knowledge-point/_questions [{:db/id #edb/ref 17592186054730 :knowledge-point/id #uuid "bc8aa32b-ebb2-5c6e-8436-2fbd8282a90d" :knowledge-point/title "Multiplying a Complex Number by a Real Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6ab4ce1-f093-52ed-aeaf-56ad8cef2e44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186053974} {:answer/id #uuid "7b4f903e-92e8-5c2f-9ad9-64926188e9c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186053978} {:answer/id #uuid "4a77e042-2262-52a8-a2ee-858f1ddbfce0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/ma