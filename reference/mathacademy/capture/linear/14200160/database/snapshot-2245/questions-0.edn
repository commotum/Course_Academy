 17592186516211} {:answer/id #uuid "8189c65b-8f68-5e60-8151-7f6ec946e026" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9+21\\,\\text{i}" :db/id #edb/ref 17592186516384} {:answer/id #uuid "966c27f9-9dc8-5166-90fb-85c079445450" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1+20\\,\\text{i}" :db/id #edb/ref 17592186516423} {:answer/id #uuid "d59b9b75-19fd-57eb-b89b-89eaadfe21ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1+21\\,\\text{i}" :db/id #edb/ref 17592186516562}] :answer-field/correct {:answer/id #uuid "d59b9b75-19fd-57eb-b89b-89eaadfe21ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1+21\\,\\text{i}" :db/id #edb/ref 17592186516562} :answer-field/id #uuid "49fb3134-74a9-5b52-a717-96a10d7ae83e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516678}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f55b3f2b-8f47-5135-bd49-917d58ab247b" :question/math-academy-id "q-932" :question/problem "$(4+\\text{i})(1+5\\,\\text{i})=$" :question/worked-solution "Multiplying two complex numbers is similar to multiplying two binomials. We also use the fact that ${\\text{i}}^{2}=-1.$\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(4+\\text{i})(1+5\\,\\text{i}) & =4\\cdot 1+4\\cdot 5\\,\\text{i}+\\text{i}\\cdot 1+\\text{i}\\cdot 5\\,\\text{i} \\\\  & =4+20\\,\\text{i}+\\text{i}+5\\,{\\text{i}}^{2} \\\\  & =4+21\\,\\text{i}+5\\cdot (-1) \\\\  & =4+21\\,\\text{i}-5 \\\\  & =-1+21\\,\\text{i}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186516811 :knowledge-point/_questions [{:db/id #edb/ref 17592186054733 :knowledge-point/id #uuid "a09b3f4a-a1df-504e-8e9f-510225da1392" :knowledge-point/title "Multiplying Two Complex Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ca3946f-366a-5b81-a4c9-0b0c61934598" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54-28\\,\\text{i}" :db/id #edb/ref 17592186516310} {:answer/id #uuid "9c12aa67-46aa-500d-9908-ebcdf6ecdfe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49+28\\,\\text{i}" :db/id #edb/ref 17592186516432} {:answer/id #uuid "a1576592-467c-52ef-9310-305561672ba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54+14\\,\\text{i}" :db/id #edb/ref 17592186516444} {:answer/id #uuid "b3cc1bb3-def6-5f96-9d20-24497c7227f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-45+28\\,\\text{i}" :db/id #edb/ref 17592186516483} {:answer/id #uuid "f27eda8b-5fc9-5661-af7f-6892669ec75c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54+28\\,\\text{i}" :db/id #edb/ref 17592186516614}] :answer-field/correct {:answer/id #uuid "b3cc1bb3-def6-5f96-9d20-24497c7227f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-45+28\\,\\text{i}" :db/id #edb/ref 17592186516483} :answer-field/id #uuid "91c14745-4e3f-5bf4-9922-6ace350017c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516722}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6a20d5bb-9361-5e72-b467-6cb5fe6df5c3" :question/math-academy-id "q-933" :question/problem "$(2+7\\,\\text{i})^{2}=$" :question/worked-solution "Squaring a complex number means to multiply it by itself, i.e.,\n\n$$\n(2+7\\,\\text{i})^{2}=(2+7\\,\\text{i})(2+7\\,\\text{i})\n$$\n\nMultiplying two complex numbers is similar to multiplying two binomials. We also use the fact that ${\\text{i}}^{2}=-1.$\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(2+7\\,\\text{i})^{2} & =(2+7\\,\\text{i})(2+7\\,\\text{i}) \\\\  & =2\\cdot 2+2\\cdot 7\\,\\text{i}+7\\,\\text{i}\\cdot 2+7\\,\\text{i}\\cdot 7\\,\\text{i} \\\\  & =4+14\\,\\text{i}+14\\,\\text{i}+49\\,{\\text{i}}^{2} \\\\  & =4+28\\,\\text{i}+49\\cdot (-1) \\\\  & =4+28\\,\\text{i}-49 \\\\  & =-45+28\\,\\text{i}.\\end{aligned}\n$$"}]}
