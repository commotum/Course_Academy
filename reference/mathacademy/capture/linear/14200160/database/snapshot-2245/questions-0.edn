 #edb/ref 17592186054730 :knowledge-point/id #uuid "bc8aa32b-ebb2-5c6e-8436-2fbd8282a90d" :knowledge-point/title "Multiplying a Complex Number by a Real Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d61833c7-6949-5304-81bd-a1340bf8f4bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0+12i" :db/id #edb/ref 17592186516564}] :answer-field/correct {:answer/id #uuid "d61833c7-6949-5304-81bd-a1340bf8f4bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0+12i" :db/id #edb/ref 17592186516564} :answer-field/id #uuid "aae767c5-ba26-569d-a0d8-9c1c459aacf1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186516731}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c89aaf3b-3742-5fd3-b01e-fe196c4b4e9e" :question/math-academy-id "q-218536" :question/problem "Express the following product in the form $a+b\\text{i}.$ Use $i$ to denote the imaginary unit.\n\n$3\\cdot 4\\,\\text{i}=$\n{{field-1}}" :question/worked-solution "Multiplying a purely imaginary number by a real number is similar to multiplying two monomials.\n\nFor the given problem, we have\n\n$$\n3\\cdot 4\\,\\text{i}=(3\\cdot 4)\\,\\text{i}=12\\,\\text{i}.\n$$"}] [{:db/id #edb/ref 17592186055115 :knowledge-point/_questions [{:db/id #edb/ref 17592186054732 :knowledge-point/id #uuid "f8e2d975-43da-5efc-8741-fc2e206bed29" :knowledge-point/title "Multiplying a Complex Number by a Purely Imaginary Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f57df792-c516-5993-a83e-7cf765473431" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186516622}] :answer-field/correct {:answer/id #uuid "f57df792-c516-5993-a83e-7cf765473431" :answer/type {:db/id #edb/ref 17592186045498 :db/ident 