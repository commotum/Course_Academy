#{[{:db/id #edb/ref 17592186054533 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054730 :knowledge-point/id #uuid "bc8aa32b-ebb2-5c6e-8436-2fbd8282a90d" :knowledge-point/title "Multiplying a Complex Number by a Real Number"}] :question/id #uuid "2a1183fe-8fdc-549e-8f1b-4b0d6b7909aa" :question/math-academy-id "e-4040" :question/problem "Evaluate $2 \\cdot 3\\,\\textrm{i}$." :question/worked-solution "Multiplying a purely imaginary number by a real number is similar to multiplying two monomials.\n\nFor the given problem, we have\n\n$$\n2\\cdot 3\\,\\textrm{i} = (2\\cdot 3) \\,\\textrm{i} = 6\\,\\textrm{i}\n$$"}] [{:db/id #edb/ref 17592186054534 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054731 :knowledge-point/id #uuid "77c51556-8646-5850-a24d-3fadf6b5a546" :knowledge-point/title "Multiplying Two Purely Imaginary Numbers"}] :question/id #uuid "fb4ef9ac-0c5d-5fab-b84f-c2bad182b3c3" :question/math-academy-id "e-4041" :question/problem "Evaluate $2\\,\\textrm{i}\\cdot (-3\\,\\textrm{i})$." :question/worked-solution "Multiplying two purely imaginary numbers is similar to multiplying two monomials. We also use the fact that\n\n$$\n\\textrm{i}^2=-1\n$$\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}\n2\\textrm{i} \\cdot (-3\\textrm{i}) &= 2 \\cdot (-3) \\cdot \\textrm{i}^{2} \\\\\n&=-6\\textrm{i}^{2} \\\\\n&=-6 \\cdot (-1) \\\\\n&= 6\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054535 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054732 :knowledge-point/id #uuid "f8e2d975-43da-5efc-8741-fc2e206bed29" :knowledge-point/title "Multiplying a Complex Number by a Purely Imaginary Number"}] :question/id #uuid "8f53a72e-adc4-584d-8d51-efb42c3ddbc3" :question/math-academy-id "e-4043" :question/problem "Evaluate $6\\,\\textrm{i}\\cdot(4 + 2\\,\\textrm{i})$." :question/worked-solution "To multiply a complex number by a purely imaginary number, we use the distributive property and the fact that\n\n$$\n\\textrm{i}^2 = -1\n$$\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}\n6\\textrm{i} \\cdot (4 + 2\\textrm{i}) &= 6\\textrm{i} \\cdot 4 + 6\\textrm{i} \\cdot 2\\textrm{i} \\\\\n&= 4 \\cdot 6\\textrm{i} + 6 \\cdot 2 \\cdot \\textrm{i}^{2} \\\\\n&= 24\\textrm{i} + 12 \\cdot (-1) \\\\\n&= 24\\textrm{i} - 12 \\\\\n&=-12 + 24\\textrm{i}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054536 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054733 :knowledge-point/id #uuid "a09b3f4a-a1df-504e-8e9f-510225da1392" :knowledge-point/title "Multiplying Two Complex Numbers"}] :question/id #uuid "c3412df7-29a2-50d3-be4d-e2c6fcf8804a" :question/math-academy-id "e-4044" :question/problem "Evaluate $(1 - 3\\,\\textrm{i})(2 + 4\\, \\textrm{i})$." :question/worked-solution "Multiplying two complex numbers is similar to multiplying two binomials. We also use the fact that\n\n$$\n\\textrm{i}^2 = -1\n$$\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}\n(1 - 3\\textrm{i})(2 + 4\\textrm{i}) &= 1 \\cdot 2 + 1 \\cdot 4\\textrm{i} + (-3\\textrm{i}) \\cdot 2 + (-3\\textrm{i}) \\cdot 4\\textrm{i} \\\\\n&= 2 + 4\\textrm{i} - 6\\textrm{i} - 12\\textrm{i}^{2} \\\\\n&= 2 - 2\\textrm{i} - 12 \\cdot (-1) \\\\\n&= 2 - 2\\textrm{i} + 12 \\\\\n&= 14 - 2\\textrm{i}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186055115 :knowledge-point/_questions [{:db/id #edb/ref 17592186054732 :knowledge-point/id #uuid "f8e2d975-43da-5efc-8741-fc2e206bed29" :knowledge-point/title "Multiplying a Complex Number by a Purely Imaginary Number"}] :question/answer-fields [{:answer-field/id #uuid "97d28175-ef60-5641-9be0-b1ff50c252fb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186052066} {:answer-field/id #uuid "4e913e2e-103b-5c17-8943-5d510453266c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186052067}] :question/id #uuid "3415ad70