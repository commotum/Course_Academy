#{[{:activity/first-step {:db/id #edb/ref 17592186055727} :activity/id #uuid "3279a6d8-3b67-54d4-ba44-c6160115f458" :activity/scope {:db/id #edb/ref 17592186048861 :topic/id #uuid "c70c51db-61f6-5d14-a3c6-bbee2caa27c6" :topic/math-academy-id 33} :activity/steps [{:db/id #edb/ref 17592186055727 :step/content {:db/id #edb/ref 17592186055968 :tutorial/content "Multiplying a purely imaginary number by a real number is similar to multiplying two monomials.\n\nFor example, we can multiply the purely imaginary number $3 \\textrm{i}$ by the real number $6$ as follows:\n\n$$\n\\begin{aligned}\n6 \\cdot 3\\textrm{i} &= (6 \\cdot 3)\\textrm{i} = 18\\textrm{i}\n\\end{aligned}\n$$\n\nSimilarly, we can multiply a complex number by a real number using the distributive property.\n\nFor example, we can multiply the complex number $2-3\\textrm{i}$ by the real number $3$ as follows:\n\n$$\n\\begin{aligned} 3(2-3\\textrm{i}) &= 3\\cdot2 + 3\\cdot(-3\\textrm{i}) \\\\[3pt] &= 6 + 3\\cdot (-3)\\textrm{i} \\\\[3pt] &= 6 -9\\textrm{i} \\end{aligned}\n$$" :tutorial/id #uuid "4e54cae3-6a6c-50bb-a0d7-5ddc1fefaaf2" :tutorial/math-academy-id 2789 :tutorial/title "Introduction"} :step/id #uuid "5c69169e-c502-578a-abe5-85bc37ca7d7a" :step/math-academy-id 456602 :step/next {:db/id #edb/ref 17592186055728}} {:db/id #edb/ref 17592186055728 :step/content {:db/id #edb/ref 17592186054730 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054533 :question/id #uuid "2a1183fe-8fdc-549e-8f1b-4b0d6b7909aa" :question/math-academy-id "e-4040"} :knowledge-point/id #uuid "bc8aa32b-ebb2-5c6e-8436-2fbd8282a90d" :knowledge-point/questions [{:db/id #edb/ref 17592186055171} {:db/id #edb/ref 17592186055455} {:db/id #edb/ref 17592186055456}] :knowledge-point/title "Multiplying a Complex Number by a Real Number"} :step/id #uuid "35ab8803-b819-5c4c-9b48-af83535e2876" :step/math-academy-id 456603 :step/next {:db/id #edb/ref 17592186055729}} {:db/id #edb/ref 17592186055729 :step/content {:db/id #edb/ref 17592186055973 :tutorial/content "Multiplying two purely imaginary numbers is similar to multiplying two monomials. But we also need to use the fact that\n\n$$\n\\textrm{i}^2=-1\n$$\n\nFor example, to multiply $2\\textrm{i}$ and $3\\textrm{i}$, we proceed as follows:\n\n$$\n\\begin{aligned}\n(2\\textrm{i})(3\\textrm{i}) &= 2 \\cdot 3 \\cdot \\textrm{i}^{2} \\\\\n&= 6\\textrm{i}^{2} \\\\\n&= 6(-1) \\\\\n&=-6\n\\end{aligned}\n$$\n\nKnowing this, we can also multiply a complex number by a purely imaginary number.\nFor instance, to multiply $2\\textrm{i}$ and $4-3\\textrm{i}$, we use the distributive property and the fact that\n\n$$\n\\textrm{i}^2=-1\n$$\n\n$$\n\\begin{aligned} 2\\textrm{i}(4-3\\textrm{i}) &= 2\\textrm{i}\\cdot 4+2\\textrm{i}\\cdot(-3\\textrm{i}) \\\\[3pt] &=2\\cdot 4\\textrm{i}+2\\cdot(-3)\\textrm{i}^2 \\\\[3pt] &= 8\\textrm{i}+(-6)(-1) \\\\[3pt] &= 8\\textrm{i}+6 \\\\[3pt] &=6+8\\textrm{i} \\end{aligned}\n$$" :tutorial/id #uuid "1f770f0f-47fd-5f77-b4f3-e19b7dd9e29e" :tutorial/math-academy-id 2857 :tutorial/title "Multiplying by a Purely Imaginary Number"} :step/id #uuid "f5bb8cc0-0a4e-5168-b64d-efd7ffe27f06" :step/math-academy-id 456607 :step/next {:db/id #edb/ref 17592186055730}} {:db/id #edb/ref 17592186055730 :step/content {:db/id #edb/ref 17592186054731 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054534 :question/id #uuid "fb4ef9ac-0c5d-5fab-b84f-c2bad182b3c3" :question/math-academy-id "e-4041"} :knowledge-point/id #uuid "77c51556-8646-5850-a24d-3fadf6b5a546" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048428}] :knowledge-point/questions [{:db/id #edb/ref 17592186055172} {:db/id #edb/ref 17592186055173} {:db/id #edb/ref 17592186055374}] :knowledge-point/title "Multiplying Two Purely Imaginary Numbers"} :step/id #uuid "5e17a50b-2757-55e2-a21b-840cd5cfc26d" :step/math-academy-id 456608 :step/next {:db/id #edb/ref 17592186055731}} {:db/id #edb/ref 17592186055731 :step/content {:db/id #edb/ref 17592186054732 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054535 :question/id #uuid "8f53a72e-adc4-584d-8d51-efb42c3ddbc3" :question/math-academy-id "e-4043"} :knowledge-point/id #uuid "f8e2d975-43da-5efc-8741-fc2e206bed29" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049565} {:db/id #edb/ref 17592186050908}] :knowledge-point/questions [{:db/id #edb/ref 17592186055115} {:db/id #edb/ref 17592186055457} {:db/id #edb/ref 17592186055510}] :knowledge-point/title "Multiplying a Complex Number by a Purely Imaginary Number"} :step/id #uuid "210933e7-f659-5996-b3be-ca5b78ae3686" :step/math-academy-id 456612 :step/next {:db/id #edb/ref 17592186055732}} {:db/id #edb/ref 17592186055732 :step/content {:db/id #edb/ref 17592186055972 :tutorial/content "Finally, we can multiply two complex numbers just like multiplying two binomials. Again, we use the fact that\n\n$$\n\\mathrm{i}^2=-1\n$$\n\nSo, to multiply $2 + \\textrm{i}$ and $5 + 3\\textrm{i}$, we proceed as follows:\n\n$$\n\\begin{aligned} (2+\\textrm{i})(5+3\\textrm{i}) &= 2 (5+3\\textrm{i}) + \\textrm{i} (5+3\\textrm{i}) \\\\ &= 2\\cdot5 + 2\\cdot(3\\textrm{i}) +\\textrm{i}\\cdot 5+ \\textrm{i} \\cdot (3\\textrm{i}) \\\\ &= 10 + 6\\textrm{i} + 5\\textrm{i} +3\\textrm{i}^2 \\\\ &= 10 + 11\\textrm{i} + 3(-1) \\\\ &= 10 + 11\\textrm{i} - 3 \\\\ &= 7 + 11\\textrm{i} \\end{aligned}\n$$" :tutorial/id #uuid "c3f115ff-3eaa-551b-b31d-11d45b3c2c0d" :tutorial/math-academy-id 2856 :tutorial/title "Multiplying Two Complex Numbers"} :step/id #uuid "e112e986-5505-5bc1-bbbb-2547c8a09595" :step/math-academy-id 456616 :step/next {:db/id #edb/ref 17592186055733}} {:db/id #edb/ref 17592186055733 :step/content {:db/id #edb/ref 17592186054733 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054536 :question/id #uuid "c3412df7-29a2-50d3-be4d-e2c6fcf8804a" :question/math-academy-id "e-4044"} :knowledge-point/id #uuid "a09b3f4a-a1df-504e-8e9f-510225da1392" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048511} {:db/id #edb/ref 17592186050818}] :knowledge-point/questions [{:db/id #edb/ref 17592186055116} {:db/id #edb/ref 17592186055174} {:db/id #edb/ref 17592186055367} {:db/id #edb/ref 17592186233542}] :knowledge-point/title "Multiplying Two Complex Numbers"} :step/id #uuid "74a12e7b-1673-579d-a0ca-7b5809e38284" :step/math-academy-id 456617}] :activity/title "Multiplying Complex Numbers" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054895}]}
