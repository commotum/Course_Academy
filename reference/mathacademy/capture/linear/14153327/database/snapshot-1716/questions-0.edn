#{[{:db/id #edb/ref 17592186188007 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186188300 :knowledge-point/id #uuid "bec12e1c-bc47-5ac1-a1aa-f9de136b90cd" :knowledge-point/title "Determining Appropriate Units of Area and Volume"}] :question/id #uuid "6cbff12b-cc20-5db4-9e64-8bb7b4c62dd9" :question/math-academy-id "e-10149" :question/problem "Suppose we want to measure the volume of a shoe box. What units could we use?\n\nI. $\\textrm{cm}^2$\n\nII. $\\textrm{cm}^3$\n\nIII. $\\textrm{kg}$" :question/worked-solution "We can measure length in centimeters $(\\textrm{cm}).$ When measuring lengths in centimeters, volumes are measured in $\\textrm{cm} \\times \\textrm{cm} \\times \\textrm{cm},$ which is usually written as $\\textrm{cm}^3.$ \n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186188008 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186188301 :knowledge-point/id #uuid "469f0c76-3641-5a56-82bb-9ac807ff2017" :knowledge-point/title "Computing a Volume With the Correct Units"}] :question/id #uuid "94639d5a-c922-52f3-8e50-82d0e9a3dbad" :question/math-academy-id "e-10150" :question/problem "![](images/7e/7e21a9afeb5a6c102a8426255b17112479144845be87f121435c8e27078610ab.png)\n\n What is the volume of the cube shown in the diagram above?" :question/worked-solution "To find the volume $V$ of a cube, we cube its side length. Therefore,\n\n$$\n\\begin{aligned}V & =(5\\,\\text{m})^{3} \\\\  & =5\\,\\text{m}\\times 5\\,\\text{m}\\times 5\\,\\text{m} \\\\  & =(5\\times 5\\times 5)\\times (\\text{m}\\times \\text{m}\\times \\text{m}) \\\\  & =125\\,{\\text{m}}^{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186188009 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186188302 :knowledge-point/id #uuid "09b56d66-4e96-56de-b3fa-747cb2e3487d" :knowledge-point/title "Computing an Area With the Correct Units"}] :question/id #uuid "5f153b4a-2706-5ff6-b0b3-65cfc29e1391" :question/math-academy-id "e-10163" :question/problem "![](images/7e/7e300a90dbfda5a9210cec502c2879b7950e2765c433eb6ee6284e74db3cd220.png)\n\n What is the area of the square above?" :question/worked-solution "To calculate the area $A$ of a square, we square its side length. Therefore, the area of the square is\n\n$$\n\\begin{aligned}A & =(5\\,\\text{ft})^{2} \\\\  & =5\\,\\text{ft}\\times 5\\,\\text{ft} \\\\  & =(5\\times 5)\\times (\\text{ft}\\times \\text{ft}) \\\\  & =25\\,{\\text{ft}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186188569 :knowledge-point/_questions [{:db/id #edb/ref 17592186188300 :knowledge-point/id #uuid "bec12e1c-bc47-5ac1-a1aa-f9de136b90cd" :knowledge-point/title "Determining Appropriate Units of Area and Volume"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cefd9d35-79bf-58c5-993c-1464bec5edbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "m^{3}" :db/id #edb/ref 17592186185695} {:answer/id #uuid "5307bd96-9130-5886-ab60-935ce6f99802" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "kg^{2}" :db/id #edb/ref 17592186185696} {:answer/id #uuid "658379c9-6ee3-56fd-ad74-f704138aee73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s" :db/id #edb/ref 17592186185697} {:answer/id #uuid "6d22a71d-0916-53e4-b4df-11303489734d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "m^{2}" :db/id #edb/ref 17592186185698} {:answer/id #uuid "7edc9493-53c2-545e-acfd-16d2ffc23f1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "m" :db/id #edb/ref 17592186185699}] :answer-field/id #uuid "900de0fd-7e9d-582d-b547-24aedf985a6b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186185694}] :question/id #uuid "6b0b7e82-8faa-5540-aeef-c57c0104f921" :question/math-academy-id "q-144070" :question/problem "Suppose we want to measure the area of the school playground. What units could we use?"}]}
