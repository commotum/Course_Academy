#{[{:db/id #edb/ref 17592186188007 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186188300 :knowledge-point/id #uuid "bec12e1c-bc47-5ac1-a1aa-f9de136b90cd" :knowledge-point/title "Determining Appropriate Units of Area and Volume"}] :question/id #uuid "6cbff12b-cc20-5db4-9e64-8bb7b4c62dd9" :question/math-academy-id "e-10149" :question/problem "Suppose we want to measure the volume of a shoe box. What units could we use?\n\nI. $\\textrm{cm}^2$\n\nII. $\\textrm{cm}^3$\n\nIII. $\\textrm{kg}$" :question/worked-solution "We can measure length in centimeters $(\\textrm{cm}).$ When measuring lengths in centimeters, volumes are measured in $\\textrm{cm} \\times \\textrm{cm} \\times \\textrm{cm},$ which is usually written as $\\textrm{cm}^3.$ \n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186188008 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186188301 :knowledge-point/id #uuid "469f0c76-3641-5a56-82bb-9ac807ff2017" :knowledge-point/title "Computing a Volume With the Correct Units"}] :question/id #uuid "94639d5a-c922-52f3-8e50-82d0e9a3dbad" :question/math-academy-id "e-10150" :question/problem "![](images/7e/7e21a9afeb5a6c102a8426255b17112479144845be87f121435c8e27078610ab.png)\n\n What is the volume of the cube shown in the diagram above?" :question/worked-solution "To find the volume $V$ of a cube, we cube its side length. Therefore,\n\n$$\n\\begin{aligned}V & =(5\\,\\text{m})^{3} \\\\  & =5\\,\\text{m}\\times 5\\,\\text{m}\\times 5\\,\\text{m} \\\\  & =(5\\times 5\\times 5)\\times (\\text{m}\\times \\text{m}\\times \\text{m}) \\\\  & =125\\,{\\text{m}}^{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186188009 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186188302 :knowledge-point/id #uuid "09b56d66-4e96-56de-b3fa-747cb2e3487d" :knowledge-point/title "Computing an Area With the Correct Units"}] :question/id #uuid "5f153b4a-2706-5ff6-b0b3-65cfc29e1391" :question/math-academy-id "e-10163" :question/problem "![](images/7e/7e300a90dbfda5a9210cec502c2879b7950e2765c433eb6ee6284e74db3cd220.png)\n\n What is the area of the square above?" :question/worked-solution "To calculate the area $A$ of a square, we square its side length. Therefore, the area of the square is\n\n$$\n\\begin{aligned}A & =(5\\,\\text{ft})^{2} \\\\  & =5\\,\\text{ft}\\times 5\\,\\text{ft} \\\\  & =(5\\times 5)\\times (\\text{ft}\\times \\text{ft}) \\\\  & =25\\,{\\text{ft}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186188569 :knowledge-point/_questions [{:db/id #edb/ref 17592186188300 :knowledge-point/id #uuid "bec12e1c-bc47-5ac1-a1aa-f9de136b90cd" :knowledge-point/title "Determining Appropriate Units of Area and Volume"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17ee6b9c-4172-5bd2-a0f3-b25c16cb8d9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{s}" :db/id #edb/ref 17592186458666} {:answer/id #uuid "1e7eaeed-81ae-5102-ae70-6d3c1429de0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\text{m}}^{3}" :db/id #edb/ref 17592186458685} {:answer/id #uuid "25da6136-a203-50f7-b3ec-dd30497bffaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\text{kg}}^{2}" :db/id #edb/ref 17592186458705} {:answer/id #uuid "2baea77d-f4de-543c-91de-4951fccee8fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{m}" :db/id #edb/ref 17592186458714} {:answer/id #uuid "b62e721c-11d8-5a0a-a7a2-c82702956ee1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\text{m}}^{2}" :db/id #edb/ref 17592186458955}] :answer-field/correct {:answer/id #uuid "b62e721c-11d8-5a0a-a7a2-c82702956ee1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\text{m}}^{2}" :db/id #edb/ref 17592186458955} :answer-field/id #uuid "900de0fd-7e9d-582d-b547-24aedf985a6b" :answe