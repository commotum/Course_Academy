#{[{:db/id #edb/ref 17592186558542 :knowledge-point/_questions [{:db/id #edb/ref 17592186087769 :knowledge-point/id #uuid "a560db4d-e9d3-5d89-b2cd-c886f32db9df" :knowledge-point/title "Finding the Argument of a Complex Number in the Third Quadrant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "104bc3a7-627d-5647-8e7d-4eea81329a46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.36" :db/id #edb/ref 17592186557901} {:answer/id #uuid "28a7987e-9b33-5c48-b269-8c754afacd8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.96" :db/id #edb/ref 17592186557952} {:answer/id #uuid "4ac37d84-54a0-5fe9-8253-107ddf071cec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.04" :db/id #edb/ref 17592186558012} {:answer/id #uuid "8506fd8c-945e-52c8-b0e1-74187692fb61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.91" :db/id #edb/ref 17592186558122} {:answer/id #uuid "a21a68c5-01d7-5c72-935d-95175eb97050" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.27" :db/id #edb/ref 17592186558187}] :answer-field/correct {:answer/id #uuid "4ac37d84-54a0-5fe9-8253-107ddf071cec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.04" :db/id #edb/ref 17592186558012} :answer-field/id #uuid "7f5b1c16-6971-52b9-8c02-c275e3e2d630" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558423}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "988b9d1c-fc7b-517a-96d5-48ac19b5792c" :question/math-academy-id "q-170489" :question/problem "Find, in radians to two decimal places, the argument of $z=-4-5\\text{i}.$ \n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$" :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/07/07ec3b50f52a0d1fa365b407bc9d7ff59005716a787f80ccd1472f1339d712ca.png)\n\nThe complex number $z$ lies in the third quadrant of the complex plane. Therefore $\\pi <\\operatorname{arg}⁡(z)<\\frac{3\\pi }{2}.$ If $\\alpha $ is the angle that $z$ makes with the negative real axis, then\n\n$$\n\\begin{aligned}\\alpha  & =\\operatorname{arctan}⁡(\\frac{5}{4})≈0.896\\,06.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arg}⁡(z)≈\\pi +0.896\\,06≈4.04\n$$\n\nto two decimal places."}] [{:db/id #edb/ref 17592186233711 :knowledge-point/_questions [{:db/id #edb/ref 17592186087759 :knowledge-point/id #uuid "54588722-bb80-54ca-b100-03aca39e0c17" :knowledge-point/title "Finding the Argument of a Complex Number in the Fourth Quadrant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa713718-4023-5280-813d-3aa91128a3be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.62" :db/id #edb/ref 17592186232408}] :answer-field/correct {:answer/id #uuid "aa713718-4023-5280-813d-3aa91128a3be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.62" :db/id #edb/ref 17592186232408} :answer-field/id #uuid "2bdc18ae-186c-5350-9538-a2d1a6ea5f2a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232407}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0c91f4f8-2fbe-5963-a53b-2aead62a5f7f" :question/math-academy-id "q-275159" :question/problem "Find, **in radians**, the argument of $z=9-7\\text{i}.$ Round your final answer to **two decimal places**.\n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$ \n\n$\\operatorname{arg}⁡(z)≈$\n{{field-1}}" :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/b6/b6ec4332891a4c7684be8de2ca94bf24a1d9abd5170d9fe38ad3a1346afae56a.png)\n\nThe complex number $z$ lies in the fourth quadrant of the complex plane. Hence $\\frac{3\\pi }{2}<\\operatorname{arg}⁡(z)<2\\pi .$ \n\nIf $\\alpha $ is the angle that $z$ makes with the positive real axis, then\n\n$$\n\\alpha =\\operatorname{arctan}⁡(\\frac{7}{9})=0.661\\,043…\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arg}⁡(z)=2\\pi -0.661\\,043≈5.62,\n$$\n\nrounded to $2$ decimal places."}] [{:db/id #edb/ref 17592186558538 :knowledge-point/_questions [{:db/id #edb/ref 17592186087759 :knowledge-point/id #uuid "54588722-bb80-54ca-b100-03aca39e0c17" :knowledge-point/title "Finding the Argument of a Complex Number in the Fourth Quadrant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "134158df-c0b0-5853-b4a6-2a3eb3356475" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.25" :db/id #edb/ref 17592186557911} {:answer/id #uuid "2024df8f-b277-5706-a784-53c9236f7938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.92" :db/id #edb/ref 17592186557935} {:answer/id #uuid "5615d1cc-853f-5d9c-aa1c-623fbdecdcc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.85" :db/id #edb/ref 17592186558027} {:answer/id #uuid "6a7f3a10-224f-54c8-b677-1974143321f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.42" :db/id #edb/ref 17592186558072} {:answer/id #uuid "7d85d4ec-8d29-56ab-bd8f-c492d1726a30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.82" :db/id #edb/ref 17592186558109}] :answer-field/correct {:answer/id #uuid "134158df-c0b0-5853-b4a6-2a3eb3356475" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.25" :db/id #edb/ref 17592186557911} :answer-field/id #uuid "78b141fc-d9d7-524e-af83-6c374bb3001b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558417}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "91f0ad6d-6bff-5117-8528-fadde580581f" :question/math-academy-id "q-74732" :question/problem "Find, in radians to two decimal places, the argument of $z=3-5\\text{i}.$ \n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$" :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/8e/8e6594c570523f66eaa9b5cce5ea960f438698caa18d1f150055e88518b936b4.png)\n\nThe complex number $z$ lies in the fourth quadrant of the complex plane. Therefore $\\frac{3\\pi }{2}<\\operatorname{arg}⁡(z)<2\\pi .$ \n\nIf $\\alpha $ is the angle that $z$ makes with the positive real axis, then\n\n$$\n\\alpha =\\operatorname{arctan}⁡(\\frac{5}{3})≈1.030\\,38.\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arg}⁡(z)=2\\pi -1.030\\,38≈5.25\n$$\n\nto two decimal places."}]}
