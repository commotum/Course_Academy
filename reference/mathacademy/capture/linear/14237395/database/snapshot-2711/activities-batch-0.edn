{:db/id #edb/ref 17592186558538}] :knowledge-point/title "Finding the Argument of a Complex Number in the Fourth Quadrant"} :step/id #uuid "d2193b17-f424-59a7-88cc-dcdc12efdb4b" :step/math-academy-id 20976} {:db/id #edb/ref 17592186088638 :step/content {:db/id #edb/ref 17592186087769 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087589 :question/id #uuid "d1a9b27b-80e7-53af-add8-4c740d750746" :question/math-academy-id "e-6224"} :knowledge-point/id #uuid "a560db4d-e9d3-5d89-b2cd-c886f32db9df" :knowledge-point/questions [{:db/id #edb/ref 17592186088047} {:db/id #edb/ref 17592186088306} {:db/id #edb/ref 17592186233583} {:db/id #edb/ref 17592186233812} {:db/id #edb/ref 17592186233813} {:db/id #edb/ref 17592186299773} {:db/id #edb/ref 17592186299774} {:db/id #edb/ref 17592186299775} {:db/id #edb/ref 17592186344973} {:db/id #edb/ref 17592186344974} {:db/id #edb/ref 17592186544870} {:db/id #edb/ref 17592186544879} {:db/id #edb/ref 17592186558542}] :knowledge-point/title "Finding the Argument of a Complex Number in the Third Quadrant"} :step/id #uuid "0d5a8786-d0ae-54eb-bba0-009fae043bc4" :step/math-academy-id 23298 :step/next {:db/id #edb/ref 17592186088623}}] :activity/title "The Argument of a Complex Number" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186087955}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186558599} :activity/id #uuid "5d4a9fd9-2ade-54dc-a485-9442eec7067a" :activity/scope {:db/id #edb/ref 17592186048900 :topic/id #uuid "ca65b01a-1b26-51b3-b923-b5a1e97a0e03" :topic/math-academy-id 893} :activity/steps [{:db/id #edb/ref 17592186558594 :step/content {:db/id #edb/ref 17592186558542 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "104bc3a7-627d-5647-8e7d-4eea81329a46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4.36" :db/id #edb/ref 17592186557901} {:answer/id #uuid "28a7987e-9b33-5c48-b269-8c754afacd8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3.96" :db/id #edb/ref 17592186557952} {:answer/id #uuid "4ac37d84-54a0-5fe9-8253-107ddf071cec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4.04" :db/id #edb/ref 17592186558012} {:answer/id #uuid "8506fd8c-945e-52c8-b0e1-74187692fb61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3.91" :db/id #edb/ref 17592186558122} {:answer/id #uuid "a21a68c5-01d7-5c72-935d-95175eb97050" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4.27" :db/id #edb/ref 17592186558187}] :answer-field/correct {:db/id #edb/ref 17592186558012} :answer-field/id #uuid "7f5b1c16-6971-52b9-8c02-c275e3e2d630" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558423}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "988b9d1c-fc7b-517a-96d5-48ac19b5792c" :question/math-academy-id "q-170489" :question/problem "Find, in radians to two decimal places, the argument of $z=-4-5\\text{i}.$ \n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$" :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/07/07ec3b50f52a0d1fa365b407bc9d7ff59005716a787f80ccd1472f1339d712ca.png)\n\nThe complex number $z$ lies in the third quadrant of the complex plane. Therefore $\\pi <\\operatorname{arg}⁡(z)<\\frac{3\\pi }{2}.$ If $\\alpha $ is the angle that $z$ makes with the negative real axis, then\n\n$$\n\\begin{aligned}\\alpha  & =\\operatorname{arctan}⁡(\\frac{5}{4})≈0.896\\,06.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arg}⁡(z)≈\\pi +0.896\\,06≈4.04\n$$\n\nto two decimal places."} :step/id #uuid "20257268-498f-58bc-acc5-c3e4b2329946" :step/next {:db/id #edb/ref 17592186558709}} {:db/id #edb/ref 17592186558599 :step/content {:db/id #edb/ref 17592186558538 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "134158df-c0b0-5853-b4a6-2a3eb3356475" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5.25" :db/id #edb/ref 17592186557911} {:answer/id #uuid "2024df8f-b277-5706-a784-53c9236f7938" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4.92" :db/id #edb/ref 17592186557935} {:answer/id #uuid "5615d1cc-853f-5d9c-aa1c-623fbdecdcc4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4.85" :db/id #edb/ref 17592186558027} {:answer/id #uuid "6a7f3a10-224f-54c8-b677-1974143321f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5.42" :db/id #edb/ref 17592186558072} {:answer/id #uuid "7d85d4ec-8d29-56ab-bd8f-c492d1726a30" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5.82" :db/id #edb/ref 17592186558109}] :answer-field/correct {:db/id #edb/ref 17592186557911} :answer-field/id #uuid "78b141fc-d9d7-524e-af83-6c374bb3001b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558417}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "91f0ad6d-6bff-5117-8528-fadde580581f" :question/math-academy-id "q-74732" :question/problem "Find, in radians to two decimal places, the argument of $z=3-5\\text{i}.$ \n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$" :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/8e/8e6594c570523f66eaa9b5cce5ea960f438698caa18d1f150055e88518b936b4.png)\n\nThe complex number $z$ lies in the fourth quadrant of the complex plane. Therefore $\\frac{3\\pi }{2}<\\operatorname{arg}⁡(z)<2\\pi .$ \n\nIf $\\alpha $ is the angle that $z$ makes with the positive real axis, then\n\n$$\n\\alpha =\\operatorname{arctan}⁡(\\frac{5}{3})≈1.030\\,38.\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arg}⁡(z)=2\\pi -1.030\\,38≈5.25\n$$\n\nto two decimal places."} :step/id #uuid "22f54450-81d4-5d4c-9ca4-b63ee4aedba0" :step/next {:db/id #edb/ref 17592186558594}} {:db/id #edb/ref 17592186558709 :step/content {:db/id #edb/ref 17592186233711 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa713718-4023-5280-813d-3aa91128a3be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5.62" :db/id #edb/ref 17592186232408}] :answer-field/correct {:db/id #edb/ref 17592186232408} :answer-field/id #uuid "2bdc18ae-186c-5350-9538-a2d1a6ea5f2a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186232407}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0c91f4f8-2fbe-5963-a53b-2aead62a5f7f" :question/math-academy-id "q-275159" :question/problem "Find, **in radians**, the argument of $z=9-7\\text{i}.$ Round your final answer to **two decimal places**.\n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$ \n\n$\\operatorname{arg}⁡(z)≈$\n{{field-1}}" :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/b6/b6ec4332891a4c7684be8de2ca94bf24a1d9abd5170d9fe38ad3a1346afae56a.png)\n\nThe complex number $z$ lies in the fourth quadrant of the complex plane. Hence $\\frac{3\\pi }{2}<\\operatorname{arg}⁡(z)<2\\pi .$ \n\nIf $\\alpha $ is the angle that $z$ makes with the positive real axis, then\n\n$$\n\\alpha =\\operatorname{arctan}⁡(\\frac{7}{9})=0.661\\,043…\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arg}⁡(z)=2\\pi -0.661\\,043≈5.62,\n$$\n\nrounded to $2$ decimal places."} :step/id #uuid "f33ec1ce-1596-56dc-92a6-7a5545f7d21f"}] :activity/title "The Argument of a Complex Number" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186557862}]}
