#{[{:activity/first-step {:db/id #edb/ref 17592186180350} :activity/id #uuid "83044b10-d4a9-5617-a56e-6d6330eeb3ae" :activity/scope {:db/id #edb/ref 17592186050310 :topic/id #uuid "3ef53278-7672-5742-99fe-d07cf78639fe" :topic/math-academy-id 3739} :activity/steps [{:db/id #edb/ref 17592186180350 :step/content {:db/id #edb/ref 17592186180669 :tutorial/content "Remember that in order to add fractions with different denominators, like\n\n$$\n\\dfrac 1 4 + \\dfrac 1 8\n$$\n\nwe need to put the fractions over a **common denominator**, as follows:\n\n$$\n\\begin{aligned}\n\\frac{1}{4} + \\frac{1}{8} &=  \\\\\n\\frac{2}{8} + \\frac{1}{8} &=  \\\\\n&= \\frac{3}{8}\n\\end{aligned}\n$$\n\nIt works the same in algebra! To add two fractions, we need to put each fraction over a common denominator. Then, we add the numerators." :tutorial/id #uuid "f5b564ba-0934-5110-87ce-f04259821232" :tutorial/math-academy-id 3377 :tutorial/title "Introduction"} :step/id #uuid "2e650778-2844-52ef-8b57-d9a72869e882" :step/math-academy-id 18875 :step/next {:db/id #edb/ref 17592186180351}} {:db/id #edb/ref 17592186180351 :step/content {:db/id #edb/ref 17592186179648 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179509 :question/id #uuid "0346b5d4-3d16-53e5-a25d-4f770ef5f863" :question/math-academy-id "e-5127"} :knowledge-point/id #uuid "63080bb8-7a6a-505d-813a-e6c99d337064" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049752} {:db/id #edb/ref 17592186049782} {:db/id #edb/ref 17592186050462} {:db/id #edb/ref 17592186050575}] :knowledge-point/questions [{:db/id #edb/ref 17592186180182} {:db/id #edb/ref 17592186180183} {:db/id #edb/ref 17592186247331} {:db/id #edb/ref 17592186247332} {:db/id #edb/ref 17592186247333} {:db/id #edb/ref 17592186247334} {:db/id #edb/ref 17592186247335} {:db/id #edb/ref 17592186323916} {:db/id #edb/ref 17592186338755} {:db/id #edb/ref 17592186348233}] :knowledge-point/title "Adding and Subtracting a Number and a Rational Expression"} :step/id #