#{[{:db/id #edb/ref 17592186180183 :knowledge-point/_questions [{:db/id #edb/ref 17592186179648 :knowledge-point/id #uuid "63080bb8-7a6a-505d-813a-e6c99d337064" :knowledge-point/title "Adding and Subtracting a Number and a Rational Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43113724-4737-55bd-be10-ea13f354c498" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n+4}{4n}" :db/id #edb/ref 17592186324512} {:answer/id #uuid "557c2210-cde2-5a90-ab2d-278d391fa572" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n+4}{n}" :db/id #edb/ref 17592186324681} {:answer/id #uuid "7c80d65a-f4b4-5976-85e0-2d42b91e04f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4(n+1)}{n}" :db/id #edb/ref 17592186325018} {:answer/id #uuid "86d696a3-51f6-5c74-b60a-ee777cf766f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(n+1)}{n}" :db/id #edb/ref 17592186325119} {:answer/id #uuid "a5c3cf18-f2f8-5303-b271-47d390e13977" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4n+1}{4n}" :db/id #edb/ref 17592186325381}] :answer-field/correct {:answer/id #uuid "7c80d65a-f4b4-5976-85e0-2d42b91e04f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4(n+1)}{n}" :db/id #edb/ref 17592186325018} :answer-field/id #uuid "b3a0ac12-5ec7-59fe-bcab-532f6789e555" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326544}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "65698589-f97d-56e6-8561-436b3f3f5011" :question/math-academy-id "q-41574" :question/problem "Write $4+\\frac{4}{n}$ as a single fraction." :question/worked-solution "Using the fact that $4=\\frac{4}{1},$ we can write the expression as\n\n$$\n\\frac{4}{1}+\\frac{4}{n}.\n$$\n\n \n\nIn order to add the two fractions, we need them to have a common denominator. So, we put both fractions over a common denominator of $n$ by multiplying the top and bottom of the first fraction by $n:$\n\n$$\n\\begin{aligned}\\frac{4}{1}+\\frac{4}{n} & = \\\\ \\frac{n}{n}\\cdot \\frac{4}{1}+\\frac{4}{n} & = \\\\ \\frac{4n}{n}+\\frac{4}{n}\\end{aligned}\n$$\n\nFinally, we add the fractions and simplify the result:\n\n$$\n\\begin{aligned}\\frac{4n}{n}+\\frac{4}{n} & = \\\\ \\frac{4n+4}{n} & = \\\\ \\frac{4(n+1)}{n}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338784 :knowledge-point/_questions [{:db/id #edb/ref 17592186179649 :knowledge-point/id #uuid "3db20b82-9561-5c54-8e12-8914bb6747c3" :knowledge-point/title "Adding and Subtracting Rational Expressions With No Common Factors in the Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23230936-6ede-555f-ac91-3c044ab9947d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6y}{(x-6)(2x+3)}" :db/id #edb/ref 17592186336358} {:answer/id #uuid "4074a980-228d-5828-ab71-32afde6b77ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12y}{(x-6)(2x+3)}" :db/id #edb/ref 17592186336638} {:answer/id #uuid "743513e5-b247-5471-8090-48db4264523a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10xy}{(x-6)(2x+3)}" :db/id #edb/ref 17592186337077} {:answer/id #uuid "8aec4cf8-600b-58f9-850c-ced09356e35f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6y+12}{(x-6)(2x+3)}" :db/id #edb/ref 17592186337285} {:answer/id #uuid "b742ba17-9648-55cf-b4aa-2135be1b063d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6xy+12y}{(x-6)(2x+3)}" :db/id #edb/ref 17592186337656}] :answer-field/correct {:answer/id #uuid "743513e5-b247-5471-8090-48db4264523a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10xy}{(x-6)(2x+3)}" :db/id #edb/ref 17592186337077} :answer-field/id #uuid "61d7ba6e-61e4-5e0f-8a2f-b4cb3ba074b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338451}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2200c232-3a06-51de-9140-6ed4836a8667" :question/math-academy-id "q-70360" :question/problem "$\\frac{4y}{x-6}+\\frac{2y}{2x+3}=$" :question/worked-solution "In this case, we need to put the fractions over a common denominator of $(x-6)(2x+3),$ since there are no common factors in either denominator that we can exploit. \n\nTo do this, we multiply the top and bottom of the first fraction by $2x+3,$ and the top and bottom of the second fraction by $x-6:$ \n\n$$\n\\begin{aligned}\\frac{4y}{x-6}+\\frac{2y}{2x+3} & = \\\\ \\frac{2x+3}{2x+3}\\cdot \\frac{4y}{x-6}+\\frac{x-6}{x-6}\\cdot \\frac{2y}{2x+3} & = \\\\ \\frac{4y(2x+3)}{(x-6)(2x+3)}+\\frac{2y(x-6)}{(x-6)(2x+3)} & = \\\\ \\frac{4y(2x+3)+2y(x-6)}{(x-6)(2x+3)} & = \\\\ \\frac{8xy+12y+2xy-12y}{(x-6)(2x+3)} & = \\\\ \\frac{10xy}{(x-6)(2x+3)}\\end{aligned}\n$$"}]}
