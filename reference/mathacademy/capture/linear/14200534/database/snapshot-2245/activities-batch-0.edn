#{[{:activity/first-step {:db/id #edb/ref 17592186180350} :activity/id #uuid "83044b10-d4a9-5617-a56e-6d6330eeb3ae" :activity/scope {:db/id #edb/ref 17592186050310 :topic/id #uuid "3ef53278-7672-5742-99fe-d07cf78639fe" :topic/math-academy-id 3739} :activity/steps [{:db/id #edb/ref 17592186180350 :step/content {:db/id #edb/ref 17592186180669 :tutorial/content "Remember that in order to add fractions with different denominators, like\n\n$$\n\\dfrac 1 4 + \\dfrac 1 8\n$$\n\nwe need to put the fractions over a **common denominator**, as follows:\n\n$$\n\\begin{aligned}\n\\frac{1}{4} + \\frac{1}{8} &=  \\\\\n\\frac{2}{8} + \\frac{1}{8} &=  \\\\\n&= \\frac{3}{8}\n\\end{aligned}\n$$\n\nIt works the same in algebra! To add two fractions, we need to put each fraction over a common denominator. Then, we add the numerators." :tutorial/id #uuid "f5b564ba-0934-5110-87ce-f04259821232" :tutorial/math-academy-id 3377 :tutorial/title "Introduction"} :step/id #uuid "2e650778-2844-52ef-8b57-d9a72869e882" :step/math-academy-id 18875 :step/next {:db/id #edb/ref 17592186180351}} {:db/id #edb/ref 17592186180351 :step/content {:db/id #edb/ref 17592186179648 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179509 :question/id #uuid "0346b5d4-3d16-53e5-a25d-4f770ef5f863" :question/math-academy-id "e-5127"} :knowledge-point/id #uuid "63080bb8-7a6a-505d-813a-e6c99d337064" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049752} {:db/id #edb/ref 17592186049782} {:db/id #edb/ref 17592186050462} {:db/id #edb/ref 17592186050575}] :knowledge-point/questions [{:db/id #edb/ref 17592186180182} {:db/id #edb/ref 17592186180183} {:db/id #edb/ref 17592186247331} {:db/id #edb/ref 17592186247332} {:db/id #edb/ref 17592186247333} {:db/id #edb/ref 17592186247334} {:db/id #edb/ref 17592186247335} {:db/id #edb/ref 17592186323916} {:db/id #edb/ref 17592186338755} {:db/id #edb/ref 17592186348233}] :knowledge-point/title "Adding and Subtracting a Number and a Rational Expression"} :step/id #uuid "619ce5a9-f7df-5e65-b3c8-68102bc19437" :step/math-academy-id 18876 :step/next {:db/id #edb/ref 17592186180352}} {:db/id #edb/ref 17592186180352 :step/content {:db/id #edb/ref 17592186179649 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179510 :question/id #uuid "866c1453-6d54-584c-ae65-0bc495ebf23a" :question/math-academy-id "e-5130"} :knowledge-point/id #uuid "3db20b82-9561-5c54-8e12-8914bb6747c3" :knowledge-point/questions [{:db/id #edb/ref 17592186180184} {:db/id #edb/ref 17592186180262} {:db/id #edb/ref 17592186234270} {:db/id #edb/ref 17592186321142} {:db/id #edb/ref 17592186336017} {:db/id #edb/ref 17592186338773} {:db/id #edb/ref 17592186338774} {:db/id #edb/ref 17592186338782} {:db/id #edb/ref 17592186338783} {:db/id #edb/ref 17592186338784} {:db/id #edb/ref 17592186516785}] :knowledge-point/title "Adding and Subtracting Rational Expressions With No Common Factors in the Denominators"} :step/id #uuid "833d312d-0148-58a3-bccf-4edf9a9c2020" :step/math-academy-id 18879}] :activity/title "Adding Rational Expressions With No Common Factors in the Denominator" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179887}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186516937} :activity/id #uuid "6fdef0bc-21c9-5e03-80e4-df685b2f8a55" :activity/scope {:db/id #edb/ref 17592186050310 :topic/id #uuid "3ef53278-7672-5742-99fe-d07cf78639fe" :topic/math-academy-id 3739} :activity/steps [{:db/id #edb/ref 17592186516927 :step/content {:db/id #edb/ref 17592186338784 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23230936-6ede-555f-ac91-3c044ab9947d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6y}{(x-6)(2x+3)}" :db/id #edb/ref 17592186336358} {:answer/id #uuid "4074a980-228d-5828-ab71-32afde6b77ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{12y}{(x-6)(2x+3)}" :db/id #edb/ref 17592186336638} {:answer/id #uuid "743513e5-b247-5471-8090-48db4264523a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10xy}{(x-6)(2x+3)}" :db/id #edb/ref 17592186337077} {:answer/id #uuid "8aec4cf8-600b-58f9-850c-ced09356e35f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6y+12}{(x-6)(2x+3)}" :db/id #edb/ref 17592186337285} {:answer/id #uuid "b742ba17-9648-55cf-b4aa-2135be1b063d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6xy+12y}{(x-6)(2x+3)}" :db/id #edb/ref 17592186337656}] :answer-field/correct {:db/id #edb/ref 17592186337077} :answer-field/id #uuid "61d7ba6e-61e4-5e0f-8a2f-b4cb3ba074b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338451}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2200c232-3a06-51de-9140-6ed4836a8667" :question/math-academy-id "q-70360" :question/problem "$\\frac{4y}{x-6}+\\frac{2y}{2x+3}=$" :question/worked-solution "In this case, we need to put the fractions over a common denominator of $(x-6)(2x+3),$ since there are no common factors in either denominator that we can exploit. \n\nTo do this, we multiply the top and bottom of the first fraction by $2x+3,$ and the top and bottom of the second fraction by $x-6:$ \n\n$$\n\\begin{aligned}\\frac{4y}{x-6}+\\frac{2y}{2x+3} & = \\\\ \\frac{2x+3}{2x+3}\\cdot \\frac{4y}{x-6}+\\frac{x-6}{x-6}\\cdot \\frac{2y}{2x+3} & = \\\\ \\frac{4y(2x+3)}{(x-6)(2x+3)}+\\frac{2y(x-6)}{(x-6)(2x+3)} & = \\\\ \\frac{4y(2x+3)+2y(x-6)}{(x-6)(2x+3)} & = \\\\ \\frac{8xy+12y+2xy-12y}{(x-6)(2x+3)} & = \\\\ \\frac{10xy}{(x-6)(2x+3)}\\end{aligned}\n$$"} :step/id #uuid "805d3373-2bfa-59ad-b9de-b827b3792b78"} {:db/id #edb/ref 17592186516937 :step/content {:db/id #edb/ref 17592186180183 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43113724-4737-55bd-be10-ea13f354c498" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{n+4}{4n}" :db/id #edb/ref 17592186324512} {:answer/id #uuid "557c2210-cde2-5a90-ab2d-278d391fa572" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{n+4}{n}" :db/id #edb/ref 17592186324681} {:answer/id #uuid "7c80d65a-f4b4-5976-85e0-2d42b91e04f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4(n+1)}{n}" :db/id #edb/ref 17592186325018} {:answer/id #uuid "86d696a3-51f6-5c74-b60a-ee777cf766f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2(n+1)}{n}" :db/id #edb/ref 17592186325119} {:answer/id #uuid "a5c3cf18-f2f8-5303-b271-47d390e13977" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4n+1}{4n}" :db/id #edb/ref 17592186325381}] :answer-field/correct {:db/id #edb/ref 17592186325018} :answer-field/id #uuid "b3a0ac12-5ec7-59fe-bcab-532f6789e555" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186326544}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "65698589-f97d-56e6-8561-436b3f3f5011" :question/math-academy-id "q-41574" :question/problem "Write $4+\\frac{4}{n}$ as a single fraction." :question/worked-solution "Using the fact that $4=\\frac{4}{1},$ we can write the expression as\n\n$$\n\\frac{4}{1}+\\frac{4}{n}.\n$$\n\n \n\nIn order to add the two fractions, we need them to have a common denominator. So, we put both fractions over a common denominator of $n$ by multiplying the top and bottom of the first fraction by $n:$\n\n$$\n\\begin{aligned}\\frac{4}{1}+\\frac{4}{n} & = \\\\ \\frac{n}{n}\\cdot \\frac{4}{1}+\\frac{4}{n} & = \\\\ \\frac{4n}{n}+\\frac{4}{n}\\end{aligned}\n$$\n\nFinally, we add the fractions and simplify the result:\n\n$$\n\\begin{aligned}\\frac{4n}{n}+\\frac{4}{n} & = \\\\ \\frac{4n+4}{n} & = \\\\ \\frac{4(n+1)}{n}\\end{aligned}\n$$"} :step/id #uuid "96219574-7431-50c0-baf3-3503c3ab2b03" :step/next {:db/id #edb/ref 17592186516941}} {:db/id #edb/ref 17592186516941 :step/content {:db/id #edb/ref 17592186516785 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23cffcff-4a22-5e78-8990-abb8fe32d5d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{xy+12y-4x+1}{3x(6y+1)}" :db/id #edb/ref 17592186516179} {:answer/id #uuid "8739ac13-98e3-58b6-bd8d-3dcf3862c9ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x-y-1}{3x(6y+1)}" :db/id #edb/ref 17592186516396} {:answer/id #uuid "b6e44f64-471c-5144-a4df-c008428924d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x+6y+1}{3x(6y+1)}" :db/id #edb/ref 17592186516495} {:answer/id #uuid "c128981f-be94-519f-99fe-617a7e7058aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6xy+x+6y+1}{3x(6y+1)}" :db/id #edb/ref 17592186516523} {:answer/id #uuid "c641f253-108d-57d7-b92a-300f6c43cac3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3xy+6y+2}{3x+6y+1}" :db/id #edb/ref 17592186516532}] :answer-field/correct {:db/id #edb/ref 17592186516495} :answer-field/id #uuid "76acf816-9d43-55de-b720-1823543ac3f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516708}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1f6be087-1fa7-52c8-8b37-3dc253f9f151" :question/math-academy-id "q-70298" :question/problem "If $\\frac{2y}{6y+1}+Z=\\frac{x+1}{3x},$ then what is $Z?$" :question/worked-solution "Since $\\frac{2y}{6y+1}+Z=\\frac{x+1}{3x},$ we have\n\n$$\n\\begin{aligned}Z & =\\frac{x+1}{3x}-\\frac{2y}{6y+1}.\\end{aligned}\n$$\n\nNow, we need to put the fractions over a common denominator of $3x(6y+1),$ since there are no common factors in either denominator that we can exploit. \n\nTo do this, we multiply the top and bottom of the first fraction by $6y+1,$ and the top and bottom of the second fraction by $3x:$ \n\n$$\n\\begin{aligned}Z & =\\frac{x+1}{3x}-\\frac{2y}{6y+1} \\\\  & =\\frac{6y+1}{6y+1}\\cdot \\frac{x+1}{3x}-\\frac{3x}{3x}\\cdot \\frac{2y}{6y+1} \\\\  & =\\frac{(6y+1)(x+1)}{3x(6y+1)}-\\frac{3x(2y)}{3x(6y+1)} \\\\  & =\\frac{(6y+1)(x+1)-3x(2y)}{3x(6y+1)} \\\\  & =\\frac{6yx+x+6y+1-6xy}{3x(6y+1)} \\\\  & =\\frac{x+6y+1}{3x(6y+1)}\\end{aligned}\n$$"} :step/id #uuid "9fadf4e2-4826-56c6-8d16-4e2b4f03bec4" :step/next {:db/id #edb/ref 17592186516927}}] :activity/title "Adding Rational Expressions With No Common Factors in the Denominator" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186516101}]}
