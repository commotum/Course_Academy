<mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-top: 0.3em;\"><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"text-align: left; padding-left: 0px; padding-top: 0.3em;\"><mjx-mi class=\"mjx-n\"></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-texatom space=\"4\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D43F TEX-I\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-texatom space=\"3\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D43D TEX-I\"></mjx-c></mjx-mi></mjx-texatom><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.6em 0.6em 0.3em\"><mtr><mtd><mrow data-mjx-texclass=\"ORD\"><mi>K</mi></mrow><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mi>L</mi></mrow><mo>−</mo><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi>K</mi></mrow><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mi>J</mi></mrow><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mi>K</mi></mrow><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mi>L</mi></mrow><mo>−</mo><mrow data-mjx-texclass=\"ORD\"><mi>K</mi></mrow><mo>−</mo><mrow data-mjx-texclass=\"ORD\"><mi>J</mi></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><menclose notation=\"updiagonalstrike\"><mi>K</mi></menclose><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mi>L</mi></mrow><mo>−</mo><menclose notation=\"updiagonalstrike\"><mi>K</mi></menclose><mo>−</mo><mrow data-mjx-texclass=\"ORD\"><mi>J</mi></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mi>L</mi></mrow><mo>−</mo><mrow data-mjx-texclass=\"ORD\"><mi>J</mi></mrow></mtd