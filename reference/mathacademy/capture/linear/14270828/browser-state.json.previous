evel=\"0\"><mfrac><mn>16</mn><mn>5</mn></mfrac></mstyle><mo>⋅</mo><mn>5</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>16</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
