ass=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-top: 0.3em;\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D441 TEX-I\"></mjx-c></mjx-mi><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"text-align: left; padding-left: 0px; padding-top: 0.3em;\"><mjx-mi class=\"mjx-n\"></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c31\"></mjx-c><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.8em 0.8em 0.6em 0.6em 0.3em\"><mtr><mtd><msub><mi>S</mi><mi>N</mi></msub></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mi>N</mi><mn>2</mn></mfrac></mstyle><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">(</mo></mrow><mn>2</mn><msub><mi>a</mi><mn>1</mn></msub><mo>+</mo><mo stretchy=\"false\">(</mo><mi>N</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mi>d</mi><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">)</mo></mrow></mtd></mtr><mtr><mtd><mn>288</mn></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mi>N</mi><mn>2</mn></mfrac></mstyle><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">(</mo></mrow><mn>2</mn><mo>⋅</mo><mn>2</mn><mo>+</mo><mo stretchy=\"false\">(</mo><mi>N</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>⋅</mo><mn>4</mn><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">)</mo></mrow></mtd></mtr><mtr><mtd><mn>288</mn></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mi>N</mi><mn>2</mn></mfrac></mstyle><mo stretchy=\"false\">(</mo><mn>4</mn><mo>+</mo><mn>4</mn><mi>N</mi><mo>−</mo><mn>4</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><mn>288</mn></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mi>N</mi><mn>2</mn></mfrac></mstyle><mo stretchy=\"false\">(</mo><mn>4</mn><mi>N</mi><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><mn>288</mn></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><msup><mi>N</mi><mn>2</mn></msup></mtd></mtr><mtr><mtd><mn>144</mn></mtd><mtd><mi></mi><mo>=</mo><msup><mi>N</mi><mn>2</mn></msup></mtd></mtr><mtr><mtd><mi>N</mi></mtd><mtd><mi></mi><mo>=</mo><mn>12</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Notice that we take the positive square root because <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"176\" style=\"font-size: 119.6%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D441 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>N</mi></math></mjx-assistive-mml></mjx-container> can't be negative.</p>\n</div></div>",
