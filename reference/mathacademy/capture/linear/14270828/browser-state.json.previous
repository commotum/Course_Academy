      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14270828/observations/diagnostic-2-9be95081ca1283a1245f.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14270828/observations/diagnostic-2-9be95081ca1283a1245f.png",
