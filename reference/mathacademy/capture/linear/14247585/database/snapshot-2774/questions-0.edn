cm},\\,h=6\\,\\text{cm}\n$$\n\ninto the formula, we obtain\n\n$$\nV=12\\cdot 2\\cdot 6=144\\,{\\text{cm}}^{3}.\n$$"}] [{:db/id #edb/ref 17592186540046 :knowledge-point/_questions [{:db/id #edb/ref 17592186119890 :knowledge-point/id #uuid "4d503d5d-ee8f-57a2-a6ef-b5b05d5e8ae4" :knowledge-point/title "Calculating the Volume of a Rectangular Solid Given Its Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72cc8687-cff9-5656-adb4-2b4961a69b57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\sqrt{6}\\,{\\text{m}}^{3}" :db/id #edb/ref 17592186539671} {:answer/id #uuid "be3f41bd-e03f-5f3c-adf5-43aca87d9777" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24\\,{\\text{m}}^{3}" :db/id #edb/ref 17592186539811} {:answer/id #uuid "d6662e26-2cf3-52e8-883d-f629f99e8a5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\sqrt{5}\\,{\\text{m}}^{3}" :db/id #edb/ref 17592186539845} {:answer/id #uuid "f5f2a638-a6db-5c93-b667-0d33daf6af55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24\\sqrt{6}\\,{\\text{m}}^{3}" :db/id #edb/ref 17592186539891} {:answer/id #uuid "fde1b598-50a6-581f-af9e-fe3b828f8b00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24\\sqrt{5}\\,{\\text{m}}^{3}" :db/id #edb/ref 17592186539910}] :answer-field/correct {:answer/id #uuid "f5f2a638-a6db-5c93-b667-0d33daf6af55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24\\sqrt{6}\\,{\\text{m}}^{3}" :db/id #edb/ref 17592186539891} :answer-field/id #uuid "3ad8f5b3-de32-550c-bc2b-1bd72fc02a0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539945}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3d05a680-5939-5ca9-9607-1df6158bf7b7" :question/math-academy-id "q-107606" :question/problem "What is the volume of a rectangular solid that has length, width, and height of $2\\sqrt{2}\\,\\text{m},$ $4\\,\\text{m},$ and $3\\sqrt{3}\\,\\text{m},$ respectively?" :question/worked-solution "We can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV=lwh,\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting \n\n$$\nl=2\\sqrt{2}\\,\\text{m},\\,w=4\\,\\text{m},\\,h=3\\sqrt{3}\\,\\text{m}\n$$\n\ninto the formula, we obtain\n\n$$\nV=2\\sqrt{2}\\cdot 4\\cdot 3\\sqrt{3}=24\\sqrt{6}\\,{\\text{m}}^{3}.\n$$"}] [{:db/id #edb/ref 17592186565418 :knowledge-point/_questions [{:db/id #edb/ref 17592186119891 :knowledge-point/id #uuid "a97dc9e3-b5a4-5913-94c3-aea43e639ce8" :knowledge-point/title "Finding a Dimension of a Rectangular Solid Given Its Volume and Some Other Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18bede78-93d9-5055-8c28-4ed347f8c022" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}\\,\\text{cm}" :db/id #edb/ref 17592186564977} {:answer/id #uuid "27a9d428-028f-57f6-94ed-62f8935466f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}\\,\\text{cm}" :db/id #edb/ref 17592186565003} {:answer/id #uuid "61b87019-ffdf-519c-ae5d-090eb7a4c23a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\text{cm}" :db/id #edb/ref 17592186565089} {:answer/id #uuid "da38aa33-19f6-578b-adf3-631d77411995" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\text{cm}" :db/id #edb/ref 17592186565262} {:answer/id #uuid "ed9dc081-59dd-5bac-a238-eb2aec578600" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\text{cm}" :db/id #edb/ref 17592186565294}] :answer-field/correct {:answer/id #uuid "61b87019-ffdf-519c-ae5d-090eb7a4c23a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\text{cm}" :db/id #edb/ref 17592186565089} :answer-field/id #uuid "f142235c-4b9c-5720-bdc0-9cd4320ec5e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186565404}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2bf849af-f99e-5349-b3c0-22dba12fdf42" :question/math-academy-id "q-118848" :question/problem "![](images/c3/c38953be7964fa371aaf82b20318aa87f9cc2641ada73c9f2778eeed61713450.png)\n\nDetermine the length of the rectangular solid above given that its volume is $105\\,{\\text{cm}}^{3}.$" :question/worked-solution "We can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV=lwh,\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting \n\n$$\nV=105,\\,w=5,\\,h=7\n$$\n\ninto the formula, we obtain the following\n\n$$\n\\begin{aligned}105 & =l\\cdot 5\\cdot 7 \\\\ 105 & =35l \\\\ l & =3\\end{aligned}\n$$\n\nTherefore, the length is $3\\,\\text{cm}.$"}] [{:db/id #edb/ref 17592186565417 :knowledge-point/_questions [{:db/id #edb/ref 17592186119891 :knowledge-point/id #uuid "a97dc9e3-b5a4-5913-94c3-aea43e639ce8" :knowledge-point/title "Finding a Dimension of a Rectangular Solid Given Its Volume and Some Other Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a4820ff-c940-5e49-ab2d-091e7242efca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{10}\\,\\text{ft}" :db/id #edb/ref 17592186565022} {:answer/id #uuid "62232616-9670-5cb6-98c2-2cdc26aec438" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{ft}" :db/id #edb/ref 17592186565090} {:answer/id #uuid "e7dc7f7e-eda8-511d-a185-29c6f05793ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}\\,\\text{ft}" :db/id #edb/ref 17592186565284} {:answer/id #uuid "ebc6dd75-bd90-5b33-813d-0b70e4da79f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\text{ft}" :db/id #edb/ref 17592186565290} {:answer/id #uuid "f152c486-b18d-5f7c-bbda-402cea16b82b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\text{ft}" :db/id #edb/ref 17592186565301}] :answer-field/correct {:answer/id #uuid "ebc6dd75-bd90-5b33-813d-0b70e4da79f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\text{ft}" :db/id #edb/ref 17592186565290} :answer-field/id #uuid "f2401f1c-06d1-5801-99a9-014558325a8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186565406}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2a4cb01f-06d4-5935-8045-405f9fc7f7c5" :question/math-academy-id "q-118850" :question/problem "![](images/0a/0a2f45da66edebc2c565b36472648c76421a33513fb51c6a26e79e7a551b526e.png)\n\nDetermine the height of the rectangular solid above given that its volume is $90\\,{\\text{ft}}^{3}.$" :question/worked-solution "We can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV=lwh,\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting\n\n$$\nV=90,\\,l=3,\\,w=5\n$$\n\ninto the formula, we obtain the following:\n\n$$\n\\begin{aligned}90 & =3\\cdot 5\\cdot h \\\\ 90 & =15h \\\\ h & =6\\end{aligned}\n$$\n\nTherefore, the height is $6\\,\\text{ft}.$"}] [{:db/id #edb/ref 17592186540071 :knowledge-point/_questions [{:db/id #edb/ref 17592186119892 :knowledge-point/id #uuid "ba5bf1d9-f6e2-5494-91fd-31c20d7fa09b" :knowledge-point/title "Finding the Volume of a Rectangular Solid: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04a735cc-2bb5-57f8-afb8-bf8a9f6cfe7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,400\\,{\\text{in}}^{3}" :db/id #edb/ref 17592186539487} {:answer/id #uuid "253a500f-10a7-5a2b-9a1d-48a97e3d0acb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "720\\,{\\text{in}}^{3}" :db/id #edb/ref 17592186539552} {:answer/id #uuid "2db94192-9608-59d6-be5f-b026801ae9ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,040\\,{\\text{in}}^{3}" :db/id #edb/ref 17592186539564} {:answer/id #uuid "a7c962e9-6e8e-5b95-b1f4-d86b14823f96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "640\\,{\\text{in}}^{3}" :db/id #edb/ref 17592186539762} {:answer/id #uuid "cb4cf501-4a8b-53d9-ba1c-97b7ebf0dc55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,480\\,{\\text{in}}^{3}" :db/id #edb/ref 17592186539827}] :answer-field/correct {:answer/id #uuid "cb4cf501-4a8b-53d9-ba1c-97b7ebf0dc55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,480\\,{\\text{in}}^{3}" :db/id #edb/ref 17592186539827} :answer-field/id #uuid "60d097f1-bd2b-5eac-9e0c-c6fa3b7f0885" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539960}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "90edfdf5-24c3-54cd-8862-63c978f95f47" :question/math-academy-id "q-118872" :question/problem "A person has seven identical boxes in the form of a rectangular solid. Each box is $10\\,\\text{in}$ long, $8\\,\\text{in}$ wide, and $8\\,\\text{in}$ high. What is the total combined volume of the boxes?" :question/worked-solution "First, we need to find the volume of one box.\n\nWe can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV=lwh,\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting \n\n$$\nl=10,\\,w=8,\\,h=8\n$$\n\ninto the formula, we obtain \n\n$$\n\\begin{aligned}V=10\\cdot 8\\cdot 8=640\\,{\\text{in}}^{3}.\\end{aligned}\n$$\n\nFinally, the total volume of the seven storage boxes is\n\n$$\n640\\cdot 7=4\\,480\\,{\\text{in}}^{3}.\n$$"}] [{:db/id #edb/ref 17592186540102 :knowledge-point/_questions [{:db/id #edb/ref 17592186119892 :knowledge-point/id #uuid "ba5bf1d9-f6e2-5494-91fd-31c20d7fa09b" :knowledge-point/title "Finding the Volume of a Rectangular Solid: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15b438ae-a475-5594-ad18-73d79bb97fd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "38\\,400\\,{\\text{cm}}^{3}" :db/id #edb/ref 17592186539523} {:answer/id #uuid "3aa5ef76-016b-5b8c-a1bf-7bbd48e16bf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,400\\,{\\text{cm}}^{3}" :db/id #edb/ref 17592186539587} {:answer/id #uuid "3c929f1b-223c-53e1-a752-772c1da2087e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,000\\,{\\text{cm}}^{3}" :db/id #edb/ref 17592186539590} {:answer/id #uuid "4161ce64-ccaa-5a03-9428-ac5e7b833fc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64\\,000\\,{\\text{cm}}^{3}" :db/id #edb/ref 17592186539598} {:answer/id #uuid "ca2f13e7-3f99-5d2e-8c4c-1840ccbbf980" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48\\,000\\,{\\text{cm}}^{3}" :db/id #edb/ref 17592186539825}] :answer-field/correct {:answer/id #uuid "ca2f13e7-3f99-5d2e-8c4c-1840ccbbf980" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48\\,000\\,{\\text{cm}}^{3}" :db/id #edb/ref 17592186539825} :answer-field/id #uuid "187877f5-c38d-5e21-86e6-44ed4b5fbfcc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539930}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e195bf20-65ce-5bd5-85a8-c18879f5cecb" :question/math-academy-id "q-118873" :question/problem "A shipping company delivered six identical packages in the form of a rectangular prism. Each package is $40\\,\\text{cm}$ long, $20\\,\\text{cm}$ wide, and $10\\,\\text{cm}$ high. What is the total combined volume of the packages?" :question/worked-solution "First, we need to find the volume of one package.\n\nWe can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV=lwh,\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting \n\n$$\nl=40,\\,w=20,\\,h=10\n$$\n\ninto the formula, we obtain \n\n$$\n\\begin{aligned}V=40\\cdot 20\\cdot 10=8\\,000\\,{\\text{cm}}^{3}.\\end{aligned}\n$$\n\nFinally, the total volume of the six packages is\n\n$$\n8\\,000\\cdot 6=48\\,000\\,{\\text{cm}}^{3}.\n$$"}]}
