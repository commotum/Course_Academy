#{[{:db/id #edb/ref 17592186499505 :knowledge-point/_questions [{:db/id #edb/ref 17592186105852 :knowledge-point/id #uuid "ae5f5e65-7642-5ca1-bf84-013dbd3c7ae4" :knowledge-point/title "Using the Power of Product Rule with Three Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07ea1924-7617-55bc-a41d-f3f63731e352" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{v}^{2/5}}{{u}^{4}}" :db/id #edb/ref 17592186498743} {:answer/id #uuid "18c1e186-f60e-5c4e-8d46-814f50c709af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{27}^{-1}{u}^{-4}{v}^{2/5}" :db/id #edb/ref 17592186498782} {:answer/id #uuid "6f4d5935-7560-51ee-b28a-e74d36717445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27{v}^{2/5}}{{u}^{4}}" :db/id #edb/ref 17592186498977} {:answer/id #uuid "98eaecfe-aa7c-56ba-90d9-9617e401d57e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{v}^{2/5}}{9{u}^{4}}" :db/id #edb/ref 17592186499056} {:answer/id #uuid "ab1a011f-e1bb-5e3f-807a-a03812cc1855" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{v}^{2/5}}{{9}^{-1}{u}^{-4}}" :db/id #edb/ref 17592186499104}] :answer-field/correct {:answer/id #uuid "98eaecfe-aa7c-56ba-90d9-9617e401d57e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{v}^{2/5}}{9{u}^{4}}" :db/id #edb/ref 17592186499056} :answer-field/id #uuid "f70e860c-0687-51a2-b8e1-d1ade86eee91" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499429}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "86ce32ac-6d75-5ef7-8ed3-9dc3f527e973" :question/math-academy-id "q-3928" :question/problem "${(27{u}^{6}{v}^{-3/5})}^{-2/3}=$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}{(27{u}^{6}{v}^{-3/5})}^{-2/3} & = \\\\ {({3}^{3}{u}^{6}{v}^{-3/5})}^{-2/3} & = \\\\ {({3}^{3})}^{-2/3}\\cdot {({u}^{6})}^{-2/3}\\cdot {({v}^{-3/5})}^{-2/3} & = \\\\ {3}^{3\\cdot (-2/3)}\\cdot {u}^{6\\cdot (-2/3)}\\cdot {v}^{(-3/5)\\cdot (-2/3)} & = \\\\ {3}^{-6/3}\\cdot {u}^{-12/3}\\cdot {v}^{6/15} & = \\\\ {3}^{-2}\\cdot {u}^{-4}\\cdot {v}^{2/5} & = \\\\ \\frac{{v}^{2/5}}{{3}^{2}{u}^{4}} & = \\\\ \\frac{{v}^{2/5}}{9{u}^{4}} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186499514 :knowledge-point/_questions [{:db/id #edb/ref 17592186105851 :knowledge-point/id #uuid "85159201-5cf2-53da-91bf-ba7ef462a4fa" :knowledge-point/title "Using the Power of Product Rule with a Negative Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "190ab1b2-874e-5bb3-a0ed-b02168022ef8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{{x}^{3}}" :db/id #edb/ref 17592186498784} {:answer/id #uuid "56bb8639-a83b-5c9f-bd37-2d2900c18393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{{x}^{3}}" :db/id #edb/ref 17592186498927} {:answer/id #uuid "5d92a4cf-c350-5c03-8652-d25b59a9ea08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49{x}^{10}" :db/id #edb/ref 17592186498944} {:answer/id #uuid "a35a3d2b-2936-57a9-91bf-b88b9ea4ee2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{{x}^{10}}" :db/id #edb/ref 17592186499083} {:answer/id #uuid "de2b212e-5da9-515f-8bd1-2141c6761d88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{{x}^{10}}" :db/id #edb/ref 17592186499224}] :answer-field/correct {:answer/id #uuid "a35a3d2b-2936-57a9-91bf-b88b9ea4ee2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{{x}^{10}}" :db/id #edb/ref 17592186499083} :answer-field/id #uuid "bcd19327-ff40-5dae-b2cf-088be8eeca6b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499399}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "997d06ae-bfea-5bdd-ad34-25a8461aee43" :question/math-academy-id "q-72553" :question/problem "Which of the following is equivalent to ${(7{x}^{-5})}^{2}?$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}{(7{x}^{-5})}^{2} & = \\\\ {7}^{2}{({x}^{-5})}^{2} & = \\\\ 49\\cdot {x}^{-5\\cdot 2} & = \\\\ 49{x}^{-10} \\\\ \\frac{49}{{x}^{10}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186499517 :knowledge-point/_questions [{:db/id #edb/ref 17592186105852 :knowledge-point/id #uuid "ae5f5e65-7642-5ca1-bf84-013dbd3c7ae4" :knowledge-point/title "Using the Power of Product Rule with Three Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01a0d9e9-f16f-5e35-91eb-3bd865760ce9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-{x}^{8}{y}^{-3}}{6}" :db/id #edb/ref 17592186498733} {:answer/id #uuid "45914d4a-b895-5bc8-a1de-5a3d97104256" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{6}{y}^{-3}}{6}" :db/id #edb/ref 17592186498891} {:answer/id #uuid "49c8eea6-1485-5196-a051-14e2a91ed557" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{6}{y}^{-3}}{8}" :db/id #edb/ref 17592186498901} {:answer/id #uuid "d3a6ab37-02d3-5559-97f9-826e50636e02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{8}{y}^{3}}{6}" :db/id #edb/ref 17592186499201} {:answer/id #uuid "e19915ad-81b9-58ed-9cd8-716103a6d691" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-{x}^{6}{y}^{-3}}{8}" :db/id #edb/ref 17592186499236}] :answer-field/correct {:answer/id #uuid "49c8eea6-1485-5196-a051-14e2a91ed557" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{6}{y}^{-3}}{8}" :db/id #edb/ref 17592186498901} :answer-field/id #uuid "010a4b8c-41ba-5ff0-99c3-e6f5f3685048" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499307}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9d191fc2-9ac2-5981-97ca-4426376145b0" :question/math-academy-id "q-816" :question/problem "${(2{x}^{-2}y)}^{-3}=$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}(2{x}^{-2}y)^{-3} & = \\\\ {2}^{-3}{({x}^{-2})}^{-3}{({y}^{1})}^{-3} & = \\\\ \\frac{1}{{2}^{3}}\\cdot {x}^{(-2)(-3)}\\cdot {y}^{(1)(-3)} & = \\\\ \\frac{1}{8}\\cdot {x}^{6}\\cdot {y}^{-3} & = \\\\ \\frac{{x}^{6}{y}^{-3}}{8} & \\end{aligned}\n$$"}]}
