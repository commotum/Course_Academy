      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14156761/observations/step-q185208-abf2e6366f1a3fffc83f.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14156761/observations/step-q185208-abf2e6366f1a3fffc83f.png",
