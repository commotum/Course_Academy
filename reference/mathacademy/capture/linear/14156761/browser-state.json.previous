style></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>20</mn></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><menclose notation=\"updiagonalstrike\"><mn>4</mn></menclose><mi>t</mi></mrow><menclose notation=\"updiagonalstrike\"><mn>4</mn></menclose></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>20</mn></mtd></mtr><mtr><mtd><mi>t</mi></mtd><mtd><mi></mi><mo>=</mo><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+3pt\" depth=\"+3pt\" lspace=\"3pt\" width=\"+6pt\"><mstyle mathcolor=\"blue\"><mo>−</mo><mn>20</mn></mstyle></mpadded></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
