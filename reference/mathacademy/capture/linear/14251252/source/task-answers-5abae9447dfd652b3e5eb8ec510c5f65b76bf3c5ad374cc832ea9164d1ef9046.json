nse":null,"timeElapsed":18182},"graphic":false,"difficultyClass":"difficultyModerate","difficultySymbol":"M","rendered":true,"testMode":false}},{"id":62307068,"created":"2026-10-15T22:23:53.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":14749,"number":2,"createdStr":"Thu, Oct 15th @ 10:23 PM","timeElapsedFormatted":"0:15","question":{"id":52250,"format":"MC","difficulty":2,"exampleId":1325,"text":"<p>Factor the polynomial expression $x(w-6)-10(w-6) .$</p>\n","choice1":"$(x-10)(w-6)$ ","choice2":"$(x-6)(w-10)$","choice3":"$x(w-6)$","choice4":"$10(w-6)$","choice5":"$10x(w-6)$","freeAnswerChoice":"","explanation":"<p>First, we find the $\\textrm{GCF}$ of the two terms:</p>\n<p>\\[ \\textrm{GCF}(x(w-6),10(w-6)) = w-6 \\]</p>\n<p>Each term is already written as a product with the $\\textrm{GCF}\\mathbin{:}$</p>\n<p>\\begin{align*}\nx\\cdot (w-6)-10\\cdot (w-6)\n\\end{align*}</p>\n<p>Finally, we write the $\\textrm{GCF}$ outside the parentheses and keep the remaining terms inside:</p>\n<p>\\begin{align*}\nx\\cdot (w-6)-10\\cdot (w-6)&= \\\\[3pt]\n(x-10)(w-6) &\n\\end{align*}</p>\n","topic":{"id":353,"name":"Factoring Polynomials Using GCFs"},"example":{"id":1325,"title":"Factoring a Binomial"},"group":{"id":75262,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14251252,"answer":{"id":62307068,"cread":"2026-10-15T22:23:53.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":14749},"graphic":false,"difficultyClass":"difficultyModerate","difficultySymbol":"M","rendered":true,"testMode":false}},{"id":62307109,"created":"2026-10-15T22:24:12.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":15481,"number":3,"createdStr":"Thu, Oct 15th @ 10:24 PM","timeElapsedFormatted":"0:15","question":{"id":52275,"format":"MC","difficulty":2,"exampleId":1325,"text":"<p>Factor the polynomial expression $p(s^2-11)-12(s^2-11).$</p>\n","choice1":"$(p-1