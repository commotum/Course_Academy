#{[{:activity/first-step {:db/id #edb/ref 17592186065228} :activity/id #uuid "28a8e191-2419-5067-b551-a263baa08308" :activity/scope {:db/id #edb/ref 17592186051017 :topic/id #uuid "7a611e07-341d-5ee4-914f-fa436e11a160" :topic/math-academy-id 353} :activity/steps [{:db/id #edb/ref 17592186065228 :step/content {:db/id #edb/ref 17592186065340 :tutorial/content "To factor a polynomial expression like $2a^2+6a$, we follow the three steps below:\n\n1. First, we find the greatest common factor (or $\\textrm{GCF}$) of both terms. In this case,\n$\\textrm{GCF}(2a^2,6a) = 2a$.\n2. Then, we rewrite each term in the original expression as a product with the $\\textrm{GCF}$:\n$2a^{2} + 6a|=; (2a \\cdot a) + (2a \\cdot 3)$\n3. Finally, we write the $\\textrm{GCF}$ outside the parentheses and keep the remaining terms inside:\n$(2a \\cdot a) + (2a \\cdot 3)|=; 2a(a + 3)$\n\nTherefore, the factored form of $2a^2+6a$ is $2a(a+3)$.\n\nWe can check that we factored correctly by multiplying it out:\n\n$$\n\\begin{aligned}\n2a(a + 3) &=  \\\\\n2a \\cdot a + 2a \\cdot 3 &=  \\\\\n&= 2a^{2} + 6a \\mid ✓\n\\end{aligned}\n$$" :tutorial/id #uuid "f84c09f1-b24a-50f1-a8c4-24b8d857bca2" :tutorial/math-academy-id 1595 :tutorial/title "Introduction"} :step/id #uuid "79b200d6-ffc5-573e-9352-08bd5b609ca7" :step/math-academy-id 4216 :step/next {:db/id #edb/ref 17592186065257}} {:db/id #edb/ref 17592186065229 :step/content {:db/id #edb/ref 17592186064322 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063953 :question/id #uuid "e0ffd89f-c43e-578d-a2b0-da1229a4ef0f" :question/math-academy-id "e-1323"} :knowledge-point/id #uuid "12fed420-dbc6-57b4-8b3b-a13d441a51df" :knowledge-point/questions [{:db/id #edb/ref 17592186064684} {:db/id #edb/ref 17592186064720}] :knowledge-point/title "Factoring a Monomial out of a Binomial Containing Two Variables"} :step/id #uuid "3968652b-1ef7-5b97-9ac6-78222515a6b5" :step/math-academy-id 4217 :step/next {:db/id #edb/ref 17592186065230}} {:db/id #edb/ref 175