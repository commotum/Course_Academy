ledge-point/title "Factoring a Monomial out of a Binomial Containing One Variable"} :step/id #uuid "91fe4526-e0c8-5bb3-a113-cd8bccfd7e6d" :step/math-academy-id 6208 :step/next {:db/id #edb/ref 17592186065229}}] :activity/title "Factoring Polynomials Using GCFs" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064442}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186571491} :activity/id #uuid "b2618742-1884-586e-9829-b1e11578dd38" :activity/scope {:db/id #edb/ref 17592186051017 :topic/id #uuid "7a611e07-341d-5ee4-914f-fa436e11a160" :topic/math-academy-id 353} :activity/steps [{:db/id #edb/ref 17592186571485 :step/content {:db/id #edb/ref 17592186571445 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2abccb54-16a1-565a-a3d7-7b17784660fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x-6)(w-10)" :db/id #edb/ref 17592186570953} {:answer/id #uuid "66ae83bc-77cf-51f1-a087-6bdd8ac365c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10(w-6)" :db/id #edb/ref 17592186571048} {:answer/id #uuid "7895f872-6b80-5972-8cff-a79b32fa8e44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10x(w-6)" :db/id #edb/ref 17592186571080} {:answer/id #uuid "a36b2445-43ae-55ce-a7aa-df740ce6b8f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x(w-6)" :db/id #edb/ref 17592186571147} {:answer/id #uuid "ae6a0a05-29ac-5657-8660-18b7cdfba4cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x-10)(w-6)" :db/id #edb/ref 17592186571160}] :answer-field/correct {:db/id #edb/ref 17592186571160} :answer-field/id #uuid "2708da49-07a5-536d-a886-c5f8ed22fc70" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571299}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e2bc30f9-89bd-586d-8e06-36b5ff066cb1" :question/math-academy-id "q-52250" :question/problem "Factor the polynomial expression $x(w-6)-10(w-6).$" :question/worked-solution "First, we find the $\\text{GCF}$ of the two terms:\n\n$$\n\\text{GCF}(x(w-6),10(w-6))=w-6\n$$\n\nEach term is already written as a product with the $\\text{GCF}:$\n\n$$\n\\begin{aligned}x\\cdot (w-6)-10\\cdot (w-6)\\end{aligned}\n$$\n\nFinally, we write the $\\text{GCF}$ outside the parentheses and keep the remaining terms inside:\n\n$$\n\\begin{aligned}x\\cdot (w-6)-10\\cdot (w-6) & = \\\\ (x-10)(w-6) & \\end{aligned}\n$$"} :step/id #uuid "69058107-d847-5a32-9c70-82ea679d1eba" :step/next {:db/id #edb/ref 17592186571515}} {:db/id #edb/ref 17592186571491 :step/content {:db/id #edb/ref 17592186571406 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7725c40c-c7d1-5a07-b1ed-5bc83db25764" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "v(2{t}^{2}+5t{v}^{2}+6v)" :db/id #edb/ref 17592186571079} {:answer/id #uuid "7f0deb1c-6e6d-5201-be46-8acd1f3de62e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{v}^{2}(2{t}^{2}+5t+6)" :db/id #edb/ref 17592186571089} {:answer/id #uuid "befda994-40ed-5fd5-82a5-ebfabcf3c853" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t(2t+11{v}^{2})" :db/id #edb/ref 17592186571186} {:answer/id #uuid "c734fab6-5d21-5144-b416-fc359fbaef35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t(2t+5{v}^{2}+6{v}^{2})" :db/id #edb/ref 17592186571198} {:answer/id #uuid "ce4484aa-f3f4-5bd9-88f1-5c0385dee98b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{t}^{2}+5t{v}^{3}+6{v}^{2}" :db/id #edb/ref 17592186571209}] :answer-field/correct {:db/id #edb/ref 17592186571209} :answer-field/id #uuid "5b40158f-c199-5426-b54f-3956c841723d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571323}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "60cacfbe-5c7a-52cc-86ec-dc2c6a600d4a" :question/math-academy-id "q-2740" :question/problem "Factor $2{t}^{2}+5t{v}^{3}+6{v}^{2}.$" :question/worked-solution "First, we find the $\\text{GCF}$ of the three terms:\n\n$$\n\\text{GCF}(2{t}^{2},5t{v}^{3},6{v}^{2})=1\n$$\n\nSince the $\\text{GCF}$ of the three terms is $1$, the given expression cannot be factored any further."} :step/id #uuid "7f0926e4-9b33-5df4-b283-a705cc5ebc64" :step/next {:db/id #edb/ref 17592186571485}} {:db/id #edb/ref 17592186571515 :step/content {:db/id #edb/ref 17592186571411 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11048dc5-c619-5b38-9741-5859a2f2a50f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p(s-11)" :db/id #edb/ref 17592186570916} {:answer/id #uuid "32002788-a360-5052-ae64-5689e34590f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(p-12)({s}^{2}-11)" :db/id #edb/ref 17592186570971} {:answer/id #uuid "b4209178-f9e4-5a9e-b002-8f82ea618938" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11(p-12)" :db/id #edb/ref 17592186571169} {:answer/id #uuid "b8a948e4-12fe-5885-adb8-61fce698c6ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(12-p)({s}^{2}-11)" :db/id #edb/ref 17592186571176} {:answer/id #uuid "d58b1732-c1c0-510d-8b42-66c08129e6a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(p-11)({s}^{2}-12)" :db/id #edb/ref 17592186571222}] :answer-field/correct {:db/id #edb/ref 17592186570971} :answer-field/id #uuid "069a8ba6-90f3-5bde-b0e0-93af47e1ca96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571286}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6b40873b-cd99-5437-a84e-b998bb4576d6" :question/math-academy-id "q-52275" :question/problem "Factor the polynomial expression $p({s}^{2}-11)-12({s}^{2}-11).$" :question/worked-solution "First, we find the $\\text{GCF}$ of the two terms:\n\n$$\n\\text{GCF}(p({s}^{2}-11),12({s}^{2}-11))={s}^{2}-11\n$$\n\nEach term is already written as a product with the $\\text{GCF}:$\n\n$$\n\\begin{aligned}p\\cdot ({s}^{2}-11)-12\\cdot ({s}^{2}-11)\\end{aligned}\n$$\n\nFinally, we write the $\\text{GCF}$ outside the parentheses and keep the remaining terms inside:\n\n$$\n\\begin{aligned}p\\cdot ({s}^{2}-11)-12\\cdot ({s}^{2}-11) & = \\\\ (p-12)({s}^{2}-11) & \\end{aligned}\n$$"} :step/id #uuid "f2551290-cf86-5ec0-b279-c039286a9eb0"}] :activity/title "Factoring Polynomials Using GCFs" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186570888}]}
