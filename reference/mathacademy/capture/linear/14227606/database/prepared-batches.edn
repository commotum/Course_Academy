or $x:$\n\n$$\n\\begin{aligned}KM & =LM \\\\ 2x+2 & =4x-6 \\\\ -2x & =-8 \\\\ x & =4\\end{aligned}\n$$"] ["question-8e4299a8-dbfe-5e92-9aa9-392339c4eb42" :question/difficulty :question.difficulty/moderate] ["answer-field-bc772387-bb72-5d5b-abe3-ac9a76d448eb" :answer-field/id #uuid "bc772387-bb72-5d5b-abe3-ac9a76d448eb"] ["answer-824ef6d0-40cc-5ffb-90ae-9f5f0cac548b" :answer/id #uuid "824ef6d0-40cc-5ffb-90ae-9f5f0cac548b"] ["answer-824ef6d0-40cc-5ffb-90ae-9f5f0cac548b" :answer/type :answer.type/math] ["answer-824ef6d0-40cc-5ffb-90ae-9f5f0cac548b" :answer/value "2"] ["answer-7db77d85-a0dc-5dc2-a4db-a208a7e4e24b" :answer/id #uuid "7db77d85-a0dc-5dc2-a4db-a208a7e4e24b"] ["answer-7db77d85-a0dc-5dc2-a4db-a208a7e4e24b" :answer/type :answer.type/math] ["answer-7db77d85-a0dc-5dc2-a4db-a208a7e4e24b" :answer/value "4"] ["answer-0a509626-e980-52d1-8ac6-b779e420ad7c" :answer/id #uuid "0a509626-e980-52d1-8ac6-b779e420ad7c"] ["answer-0a509626-e980-52d1-8ac6-b779e420ad7c" :answer/type :answer.type/math] ["answer-0a509626-e980-52d1-8ac6-b779e420ad7c" :answer/value "5"] ["answer-5595a2b1-93ac-5938-9351-2e8f17025a42" :answer/id #uuid "5595a2b1-93ac-5938-9351-2e8f17025a42"] ["answer-5595a2b1-93ac-5938-9351-2e8f17025a42" :answer/type :answer.type/math] ["answer-5595a2b1-93ac-5938-9351-2e8f17025a42" :answer/value "6"] ["answer-1fe152df-c056-56e4-8835-05f63b7ca375" :answer/id #uuid "1fe152df-c056-56e4-8835-05f63b7ca375"] ["answer-1fe152df-c056-56e4-8835-05f63b7ca375" :answer/type :answer.type/math] ["answer-1fe152df-c056-56e4-8835-05f63b7ca375" :answer/value "8"] ["answer-field-bc772387-bb72-5d5b-abe3-ac9a76d448eb" :answer-field/key "selection"] ["answer-field-bc772387-bb72-5d5b-abe3-ac9a76d448eb" :answer-field/type :answer-field.type/radio] ["answer-field-bc772387-bb72-5d5b-abe3-ac9a76d448eb" :answer-field/correct "answer-7db77d85-a0dc-5dc2-a4db-a208a7e4e24b"] ["answer-field-bc772387-bb72-5d5b-abe3-ac9a76d448eb" :answer-field/choices "answer-824ef6d0-40cc-5ffb-90ae-9f5f0cac548b"] ["answe