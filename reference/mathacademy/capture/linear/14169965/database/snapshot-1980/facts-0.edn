8f3c7-e6d0-50da-9063-b316066bc334" #edb/ref 17592186045417] [17592186081581 #edb/ref 1075 #edb/ref 17592186491630 #edb/ref 17592186045417] [17592186081581 #edb/ref 1075 #edb/ref 17592186491645 #edb/ref 17592186045417] [17592186081581 #edb/ref 1075 #edb/ref 17592186491675 #edb/ref 17592186045417] [17592186081581 #edb/ref 1075 #edb/ref 17592186491848 #edb/ref 17592186045417] [17592186081581 #edb/ref 1075 #edb/ref 17592186491857 #edb/ref 17592186045417] [17592186081581 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186081581 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186081581 #edb/ref 1078 #edb/ref 17592186491857 #edb/ref 17592186045417] [17592186081581 #edb/ref 1079 #uuid "0cc6fca3-03eb-5c75-b6f4-e8cb60eeaa09" #edb/ref 17592186045417] [17592186082936 #edb/ref 1069 "e-14140" #edb/ref 17592186045417] [17592186082936 #edb/ref 1071 "Solve $\\dfrac{3}{2x} = \\dfrac 9 8.$" #edb/ref 17592186045417] [17592186082936 #edb/ref 1072 #uuid "5d89b84d-71cc-5c63-96f1-8abc8e2b2ca9" #edb/ref 17592186045417] [17592186082936 #edb/ref 1074 "First, note that $x=0$ cannot be a solution since division by $0$ is undefined.\n\nTo solve the equation, we first apply cross-multiplication:\n\n$$\n\\eqalign{\n\t\t\\dfrac{3}{2x} &= \\dfrac 9 8 \\[5pt]\n\t\t3 \\cdot 8 &= 2x \\cdot 9 \\[5pt]\n\t\t24 &= 18x\n\t}\n$$\n\nThen, we apply the multiplication principle:\n\n$$\n\\eqalign{\n\t\t24 &= 18x \\[5pt]\n\t\t\\dfrac{24}{18} &= \\dfrac{18x}{18} \\[5pt]\n\t\t\\dfrac{4}{3} &= x\n\t}\n$$\n\nSince  $x = \\dfrac{4}{3}$ is different from $x=0,$ we can accept it as a solution. Thus, the solution is $x=\\dfrac{4}{3}.$" #edb/ref 17592186045417] [17592186082937 #edb/ref 1069 "e-14142" #edb/ref 17592186045417] [17592186082937 #edb/ref 1071 "Solve $-\\dfrac{2}{5y} = \\dfrac{1}{10}.$" #edb/ref 17592186045417] [17592186082937 #edb/ref 1072 #uuid "4a26be93-e244-596b-9341-383dbbbc3e88" #edb/ref 17592186045417] [17592186082937 #edb/ref 1074 "First, note that $y=0$ cannot be a solution since division by $0$ is undefined.\n\nTo solve the equation, we move the negative sign onto the numerator of the fraction and then apply cross-multiplication:\n\n$$\n\\eqalign{\n\t\t-\\dfrac{2}{5y}&=\\dfrac{1}{10}\\\n\t\t\\dfrac{-2}{5y}&=\\dfrac{1}{10}\\\n(-2) \\cdot 10 &= 5y \\cdot 1 \\\n-20 &= 5y\n\t}\n$$\n\nThen, we apply the multiplication principle:\n\n$$\n\\eqalign{\n-20 &= 5y \\\n\\dfrac{-20}{5} &= y \\\n-4 &= y\n\t}\n$$\n\nSince  $y = -4$ is different from $y=0,$ we can accept it as a solution. Therefore, the solution is $y=-4.$" #edb/ref 17592186045417] [17592186082938 #edb/ref 1069 "e-14145" #edb/ref 17592186045417] [17592186082938 #edb/ref 1071 "Solve $\\dfrac{3x}{2x+1} = \\dfrac 9 8.$" #edb/ref 17592186045417] [17592186082938 #edb/ref 1072 #uuid "cbd8760f-af04-5196-90d6-0d4cfdfaec2d" #edb/ref 17592186045417] [17592186082938 #edb/ref 1074 "First, note that the denominator $2x+1$ cannot be zero, since division by $0$ is undefined. Therefore we cannot have $2x+1=0,$ which means $x=-\\dfrac{1}{2}$ cannot be a solution.\n\nTo solve the equation, we first apply cross-multiplication:\n\n$$\n\\eqalign{\n\t\t\\dfrac{3x}{2x+1} &= \\dfrac 9 8 \\[5pt]\n\t\t3x \\cdot 8 &= (2x+1) \\cdot 9 \\[5pt]\n\t\t24x &= 18x + 9 \n\t}\n$$\n\nThen, we apply the addition and multiplication principles, as usual:\n\n$$\n\\eqalign{\n\t\t24x &= 18x + 9 \\[5pt]\n\t\t24x-18x &= 18x + 9 -18x \\[5pt]\n\t\t6x& = 9 \\[5pt]\n\t\t\\dfrac{6x}{6} & = \\dfrac{9}{6} \\[5pt]\n\t\tx &= \\dfrac{3}{2}\n\t}\n$$\n\nSince  $x = \\dfrac{3}{2}$ is different from $x=-\\dfrac{1}{2}$, we can accept it as a solution. Thus, the solution is $x=\\dfrac{3}{2}.$" #edb/ref 17592186045417] [17592186083192 #edb/ref 1037 #edb/ref 17592186049846 #edb/ref 17592186045417] [17592186083192 #edb/ref 1037 #edb/ref 17592186050383 #edb/ref 17592186045417] [17592186083192 #edb/ref 1038 #edb/ref 17592186083618 #edb/ref 17592186045417] [17592186083192 #edb/ref 1038 #edb/ref 17592186083787 #edb/ref 17592186045417] [17592186083192 #edb/ref 1038 #edb/ref 17592186492019 #edb/ref 17592186045417] [17592186083192 #edb/ref 1038 #edb/ref 17592186492067 #edb/ref 17592186045417] [17592186083192 #edb/ref 1039 "Rational Equations With Variables in One Denominator" #edb/ref 17592186045417] [17592186083192 #edb/ref 1041 #edb/ref 17592186082936 #edb/ref 17592186045417] [17592186083192 #edb/ref 1042 #uuid "783c067b-9676-57f1-81a9-7724c18e1534" #edb/ref 17592186045417] [17592186083193 #edb/ref 1038 #edb/ref 17592186083619 #edb/ref 17592186045417] [17592186083193 #edb/ref 1038 #edb/ref 17592186083928 #edb/ref 17592186045417] [17592186083193 #edb/ref 1038 #edb/ref 17592186492034 #edb/ref 17592186045417] [17592186083193 #edb/ref 1039 "Rational Equations Containing Negative Signs" #edb/ref 17592186045417] [17592186083193 #edb/ref 1041 #edb/ref 17592186082937 #edb/ref 17592186045417] [17592186083193 #edb/ref 1042 #uuid "20c12caf-9f3e-5dcb-a12c-5c368824ede9" #edb/ref 17592186045417] [17592186083194 #edb/ref 1038 #edb/ref 17592186083616 #edb/ref 17592186045417] [17592186083194 #edb/ref 1038 #edb/ref 17592186083774 #edb/ref 17592186045417] [17592186083194 #edb/ref 1038 #edb/ref 17592186083775 #edb/ref 17592186045417] [17592186083194 #edb/ref 1038 #edb/ref 17592186491997 #edb/ref 17592186045417] [17592186083194 #edb/ref 1039 "Rational Equations With Binomials in One Denominator" #edb/ref 17592186045417] [17592186083194 #edb/ref 1041 #edb/ref 17592186082938 #edb/ref 17592186045417] [17592186083194 #edb/ref 1042 #uuid "a8f96a06-1ebb-5ed1-9e47-23525e2a756e" #edb/ref 17592186045417] [17592186083407 #edb/ref 1043 #edb/ref 17592186084066 #edb/ref 17592186045417] [17592186083407 #edb/ref 1043 #edb/ref 17592186084067 #edb/ref 17592186045417] [17592186083407 #edb/ref 1043 #edb/ref 17592186084068 #edb/ref 17592186045417] [17592186083407 #edb/ref 1043 #edb/ref 17592186084069 #edb/ref 17592186045417] [17592186083407 #edb/ref 1043 #edb/ref 17592186084070 #edb/ref 17592186045417] [17592186083407 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186083407 #edb/ref 1045 "Solving Rational Equations Using Cross-Multiplication" #edb/ref 17592186045417] [17592186083407 #edb/ref 1046 #edb/ref 17592186084066 #edb/ref 17592186045417] [17592186083407 #edb/ref 1049 #edb/ref 17592186048891 #edb/ref 17592186045417] [17592186083407 #edb/ref 1050 420.0 #edb/ref 17592186045417] [17592186083407 #edb/ref 1053 #uuid "654c7bcb-8774-5d52-8516-2b544db9deef" #edb/ref 17592186045417] [17592186083619 #edb/ref 1068 #edb/ref 17592186080767 #edb/ref 17592186045417] [17592186083619 #edb/ref 1069 "q-217272" #edb/ref 17592186045417] [17592186083619 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186083619 #edb/ref 1071 "The solution to $-\\frac{4}{3}=\\frac{2}{6t}$ is$\\,\\,t\\,=$\n{{field-1}}." #edb/ref 17592186045417] [17592186083619 #edb/ref 1072 #uuid "3dabaa4a-5173-540d-876b-8e293aec78da" #edb/ref 17592186045417] [17592186083619 #edb/ref 1074 "First, note that $t=0$ cannot be a solution since division by $0$ is undefined.\n\nTo solve the equation, we move the negative sign onto the numerator of the fraction and then apply cross-multiplication:\n\n$$\n\\begin{aligned}-\\frac{4}{3} & =\\frac{2}{6t} \\\\ \\frac{-4}{3} & =\\frac{2}{6t} \\\\ (-4)\\cdot 6t & =3\\cdot 2 \\\\ -24t & =6\\end{aligned}\n$$\n\nThen, we apply the multiplication principle:\n\n$$\n\\begin{aligned}-24t & =6 \\\\ t & =\\frac{6}{-24} \\\\ t & =-\\frac{1}{4}\\end{aligned}\n$$\n\nSince $t=-\\frac{1}{4}$ is different from $t=0,$ we can accept it as a solution. Therefore, the solution is $t=-\\frac{1}{4}.$" #edb/ref 17592186045417] [17592186083774 #edb/ref 1068 #edb/ref 17592186081575 #edb/ref 17592186045417] [17592186083774 #edb/ref 1069 "q-51469" #edb/ref 17592186045417] [17592186083774 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186083774 #edb/ref 1071 "Solve for $s$ where $\\frac{2s+4}{2s+6}=\\frac{6}{5}.$" #edb/ref 17592186045417] [17592186083774 #edb/ref 1072 #uuid "b4331fcc-d8fb-56a5-96f2-8155ef941b7d" #edb/ref 17592186045417] [17592186083774 #edb/ref 1074 "First, note that the denominator $2s+6$ cannot be zero, since division by $0$ is undefined. Therefore we cannot have $2s+6=0,$ which means $s=-3$ cannot be a solution.\n\nTo solve the equation, we first apply cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{2s+4}{2s+6} & =\\frac{6}{5} \\\\ (2s+4)\\cdot 5 & =(2s+6)\\cdot 6 \\\\ 10s+20 & =12s+36\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}10s+20 & =12s+36 \\\\ 10s+20-10s & =12s+36-10s \\\\ 20 & =2s+36 \\\\ 20-36 & =2s+36-36 \\\\ -16 & =2s \\\\ \\frac{-16}{2} & =\\frac{2s}{2} \\\\ -8 & =s\\end{aligned}\n$$\n\nSince  $s=-8$ is different from $s=-3$, we can accept it as a solution. Thus, the solution is $s=-8.$" #edb/ref 17592186045417] [17592186083775 #edb/ref 1068 #edb/ref 17592186081581 #edb/ref 17592186045417] [17592186083775 #edb/ref 1069 "q-51490" #edb/ref 17592186045417] [17592186083775 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186083775 #edb/ref 1071 "Solve for $z$ where $\\frac{z}{3z-9}=\\frac{2}{3}.$" #edb/ref 17592186045417] [17592186083775 #edb/ref 1072 #uuid "6007ed74-923e-50f6-b933-38dcf66d92eb" #edb/ref 17592186045417] [17592186083775 #edb/ref 1074 "First, note that the denominator $3z-9$ cannot be zero, since division by $0$ is undefined. Therefore we cannot have $3z-9=0,$ which means $z=3$ cannot be a solution.\n\nTo solve the equation, we first apply cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{z}{3z-9} & =\\frac{2}{3} \\\\ z\\cdot 3 & =(3z-9)\\cdot 2 \\\\ 3z & =6z-18\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}3z & =6z-18 \\\\ 3z-6z & =6z-18-6z \\\\ -3z & =-18 \\\\ \\frac{-3z}{-3} & =\\frac{-18}{-3} \\\\ z & =6\\end{aligned}\n$$\n\nSince  $z=6$ is different from $z=3$, we can accept it as a solution. Thus, the solution is $z=6.$" #edb/ref 17592186045417] [17592186084066 #edb/ref 1058 #edb/ref 17592186084067 #edb/ref 17592186045417] [17592186084066 #edb/ref 1061 170984 #edb/ref 17592186045417] [17592186084066 #edb/ref 1062 #uuid "cc5abf0d-f453-5c16-a078-3ade2b5464f0" #edb/ref 17592186045417] [17592186084066 #edb/ref 1063 #edb/ref 17592186084516 #edb/ref 17592186045417] [17592186084067 #edb/ref 1058 #edb/ref 17592186084068 #edb/ref 17592186045417] [17592186084067 #edb/ref 1061 170985 #edb/ref 17592186045417] [17592186084067 #edb/ref 1062 #uuid "a296ae16-d9ac-5336-88fb-84c518347b2a" #edb/ref 17592186045417] [17592186084067 #edb/ref 1063 #edb/ref 17592186083192 #edb/ref 17592186045417] [17592186084068 #edb/ref 1058 #edb/ref 17592186084069 #edb/ref 17592186045417] [17592186084068 #edb/ref 1061 170988 #edb/ref 17592186045417] [17592186084068 #edb/ref 1062 #uuid "ccd40655-e59d-59b1-925d-4907d84cca52" #edb/ref 17592186045417] [17592186084068 #edb/ref 1063 #edb/ref 17592186084517 #edb/ref 17592186045417] [17592186084069 #edb/ref 1058 #edb/ref 17592186084070 #edb/ref 17592186045417] [17592186084069 #edb/ref 1061 170989 #edb/ref 17592186045417] [17592186084069 #edb/ref 1062 #uuid "5cdcec66-242d-5007-990f-d0802020baee" #edb/ref 17592186045417] [17592186084069 #edb/ref 1063 #edb/ref 17592186083193 #edb/ref 17592186045417] [17592186084070 #edb/ref 1061 170992 #edb/ref 17592186045417] [17592186084070 #edb/ref 1062 #uuid "1970d372-6794-5a8a-8180-36e7434e572b" #edb/ref 17592186045417] [17592186084070 #edb/ref 1063 #edb/ref 17592186083194 #edb/ref 17592186045417] [17592186084516 #edb/ref 1064 "Let's consider the rational equation\n\n$$\n\\dfrac{2}{x}=\\dfrac{3}{5}.\n$$\n\n \n\nWhen the equation consists of a single rational expression on each side, like the one above, then the easiest way to solve it is usually to use cross-multiplication.\n\nBefore we start, though, we note that $x=0$ *cannot* be a solution. This is because when $x=0$, we get a zero in the denominator on the left-hand side.\n\nNow, let's solve the equation. First, we cross-multiply:\n\n$$\n\\begin{aligned}\\frac{2}{x} & =\\frac{3}{5} \\\\ 2\\cdot 5 & =x\\cdot 3 \\\\ 10 & =3x\\end{aligned}\n$$\n\nThen, we can solve for $x$ using the multiplication principle:\n\n$$\n\\begin{aligned}10 & =3x \\\\ \\frac{10}{3} & =\\frac{3x}{3} \\\\ \\frac{10}{3} & =x\\end{aligned}\n$$\n\nSince $x= \\dfrac{10}{3}$ is different from $x=0$, we can accept it as a solution. Thus, the solution is $x = \\dfrac{10}{3}.$" #edb/ref 17592186045417] [17592186084516 #edb/ref 1065 8779 #edb/ref 17592186045417] [17592186084516 #edb/ref 1066 #uuid "89ea4830-364e-5105-8df0-54cf9f7e1e36" #edb/ref 17592186045417] [17592186084516 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186084517 #edb/ref 1064 "If there is a negative sign in a rational equation, we can still solve it using cross-multiplication. The only difference is that we have to move the negative sign onto the numerator of the fraction first.\n\nFor example, let's solve the equation\n\n$$\n\\dfrac{3}{2x} = -\\dfrac 9 8 .\n$$\n\nThis is similar to the equation from the previous example, but this time, there is a negative sign on the right-hand side.\n\nWe deal with the negative sign by moving it onto the numerator of the fraction, as follows:\n\n$$\n\\dfrac{3}{2x} = \\dfrac{\\color{red}-9}{8} .\n$$\n\nNow, we can proceed to solve the equation by cross-multiplication, as usual. (We also note that $x=0$ cannot be a solution since division by $0$ is undefined.) Cross-multiplying, we get\n\n$$\n\\eqalign{\n\t\t\\dfrac{3}{2x} &= \\dfrac{\\color{red}-9}{8} \\[5pt]\n\t\t3 \\cdot 8 &= 2x \\cdot (-9) \\[5pt]\n\t\t24 &= -18x\n\t}\n$$\n\nThen, we apply the multiplication principle:\n\n$$\n\\eqalign{\n\t\t24 &= -18x \\[5pt]\n\t\t\\dfrac{24}{-18} &= \\dfrac{-18x}{-18} \\[5pt]\n\t\t-\\dfrac{4}{3} &= x\n\t}\n$$\n\nSince  $x = -\\dfrac{4}{3}$ is different from $x=0,$ we can accept it as a solution. Thus, the solution is $x=-\\dfrac{4}{3}.$" #edb/ref 17592186045417] [17592186084517 #edb/ref 1065 8780 #edb/ref 17592186045417] [17592186084517 #edb/ref 1066 #uuid "d61fcf8b-f639-5c4c-8997-66813230bedf" #edb/ref 17592186045417] [17592186084517 #edb/ref 1067 "Solving Rational Equations Containing Negative Signs" #edb/ref 17592186045417] [17592186491532 #edb/ref 1080 "15" #edb/ref 17592186045417] [17592186491532 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186491532 #edb/ref 1083 #uuid "2685e781-f788-5fa6-8a92-d2f45e223738" #edb/ref 17592186045417] [17592186491612 #edb/ref 1080 "s=-8" #edb/ref 17592186045417] [17592186491612 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186491612 #edb/ref 1083 #uuid "5285db25-2043-5b84-a665-1c4f14532190" #edb/ref 17592186045417] [17592186491630 #edb/ref 1080 "z=4" #edb/ref 17592186045417] [17592186491630 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186491630 #edb/ref 1083 #uuid "619ea7f1-7bfc-5c8e-9134-5ca2070b2a16" #edb/ref 17592186045417] [17592186491632 #edb/ref 1080 "s=-4" #edb/ref 17592186045417] [17592186491632 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186491632 #edb/ref 1083 #uuid "623d62ba-5f6c-55db-af4c-88dc796a426c" #edb/ref 17592186045417] [17592186491645 #edb/ref 1080 "z=-3" #edb/ref 17592186045417] [17592186491645 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186491645 #edb/ref 1083 #uuid "6b0db6f7-5af3-52ea-bc6e-b48bdf933377" #edb/ref 17592186045417] [17592186491675 #edb/ref 1080 "z=-8" #edb/ref 17592186045417] [17592186491675 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186491675 #edb/ref 1083 #uuid "7da2ad91-904a-54ab-a5dc-948a6b3a7432" #edb/ref 17592186045417] [17592186491697 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186491697 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186491697 #edb/ref 1083 #uuid "8e658c3a-07a2-5225-bf5d-c932fd8090cb" #edb/ref 17592186045417] [17592186491703 #edb/ref 1080 "\\frac{1}{2}" #edb/ref 17592186045417] [17592186491703 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186491703 #edb/ref 1083 #uuid "92c0440c-c2b6-50ec-b2ed-afb587eb080d" #edb/ref 17592186045417] [17592186491768 #edb/ref 1080 "s=3" #edb/ref 17592186045417] [17592186491768 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186491768 #edb/ref 1083 #uuid "b692d1cd-bfaf-5673-910d-a935b2e80ed7" #edb/ref 17592186045417] [17592186491793 #edb/ref 1080 "-4" #edb/ref 17592186045417] [17592186491793 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186491793 #edb/ref 1083 #uuid "c650547a-d8fe-5cfe-abe4-1a8b0a65c0b2" #edb/ref 17592186045417] [17592186491827 #edb/ref 1080 "-\\frac{1}{4}" #edb/ref 17592186045417] [17592186491827 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186491827 #edb/ref 1083 #uuid "dbfc2d87-7c9c-564b-ad91-b142574b0bb0" #edb/ref 17592186045417] [17592186491828 #edb/ref 1080 "s=-\\frac{3}{4}" #edb/ref 17592186045417] [17592186491828 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186491828 #edb/ref 1083 #uuid "dc921c88-d065-5e95-9fa1-a3dc2bdfc347" #edb/ref 17592186045417] [17592186491839 #edb/ref 1080 "s=-2" #edb/ref 17592186045417] [17592186491839 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186491839 #edb/ref 1083 #uuid "e2888218-4669-53d9-bf83-2b380a12afd7" #edb/ref 17592186045417] [17592186491848 #edb/ref 1080 "z=-\\frac{3}{5}" #edb/ref 17592186045417] [17592186491848 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186491848 #edb/ref 1083 #uuid "e56441ea-d357-5f17-915d-a770a2c4bc43" #edb/ref 17592186045417] [17592186491857 #edb/ref 1080 "z=6" #edb/ref 17592186045417] [17592186491857 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186491857 #edb/ref 1083 #uuid "eb652a95-3b1d-5ded-92f9-326d6d70e6b6" #edb/ref 17592186045417] [17592186491889 #edb/ref 1075 #edb/ref 17592186491532 #edb/ref 17592186045417] [17592186491889 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186491889 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186491889 #edb/ref 1078 #edb/ref 17592186491532 #edb/ref 17592186045417] [17592186491889 #edb/ref 1079 #uuid "08bd13ca-d3f5-57d7-b850-5946e06f5302" #edb/ref 17592186045417] [17592186491929 #edb/ref 1075 #edb/ref 17592186491793 #edb/ref 17592186045417] [17592186491929 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186491929 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186491929 #edb/ref 1078 #edb/ref 17592186491793 #edb/ref 17592186045417] [17592186491929 #edb/ref 1079 #uuid "74a21a5f-c5bd-50c2-b9c1-3fe31e565b4e" #edb/ref 17592186045417] [17592186491943 #edb/ref 1075 #edb/ref 17592186491697 #edb/ref 17592186045417] [17592186491943 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186491943 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186491943 #edb/ref 1078 #edb/ref 17592186491697 #edb/ref 17592186045417] [17592186491943 #edb/ref 1079 #uuid "98cfb4b9-cb7f-5109-aed8-436c2f8c1279" #edb/ref 17592186045417] [17592186491953 #edb/ref 1075 #edb/ref 17592186491703 #edb/ref 17592186045417] [17592186491953 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186491953 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186491953 #edb/ref 1078 #edb/ref 17592186491703 #edb/ref 17592186045417] [17592186491953 #edb/ref 1079 #uuid "ac38501b-6d94-509e-a0df-f179d54503a1" #edb/ref 17592186045417] [17592186491997 #edb/ref 1068 #edb/ref 17592186491943 #edb/ref 17592186045417] [17592186491997 #edb/ref 1069 "q-217287" #edb/ref 17592186045417] [17592186491997 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186491997 #edb/ref 1071 "The solution to $\\frac{2s}{4s+3}=\\frac{2}{5}$  is$\\,\\,s\\,=$\n{{field-1}}." #edb/ref 17592186045417] [17592186491997 #edb/ref 1072 #uuid "1a7e838b-8b66-5959-8c4c-b78f9766fc40" #edb/ref 17592186045417] [17592186491997 #edb/ref 1074 "First, note that the denominator $4s+3$ cannot be zero, since division by $0$ is undefined. Therefore we cannot have $4s+3=0,$ which means $s=-\\frac{3}{4}$ cannot be a solution.\n\nTo solve the equation, we first apply cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{2s}{4s+3} & =\\frac{2}{5} \\\\ 2s\\cdot 5 & =(4s+3)\\cdot 2 \\\\ 10s & =8s+6\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}10s & =8s+6 \\\\ 10s-8s & =8s+6-8s \\\\ 2s & =6 \\\\ s & =3\\end{aligned}\n$$\n\nSince  $s=3$ is different from $s=-\\frac{3}{4}$, we can accept it as a solution. Thus, the solution is $s=3.$" #edb/ref 17592186045417] [17592186492019 #edb/ref 1068 #edb/ref 17592186491889 #edb/ref 17592186045417] [17592186492019 #edb/ref 1069 "q-217263" #edb/ref 17592186045417] [17592186492019 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186492019 #edb/ref 1071 "The solution to $\\frac{2}{5}=\\frac{6}{y}$ is$\\,\\,y\\,=$\n{{field-1}}." #edb/ref 17592186045417] [17592186492019 #edb/ref 1072 #uuid "5e402e88-9f33-5d37-b9c4-f754ce694bc7" #edb/ref 17592186045417] [17592186492019 #edb/ref 1074 "First, note that $y=0$ cannot be a solution since division by $0$ is undefined. \n\nTo solve the equation, we first apply cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{2}{5} & =\\frac{6}{y} \\\\ 2\\cdot y & =6\\cdot 5 \\\\ 2y & =30\\end{aligned}\n$$\n\nThen, we apply the multiplication principle:\n\n$$\n\\begin{aligned}2y & =30 \\\\ \\frac{2y}{2} & =\\frac{30}{2} \\\\ y & =15\\end{aligned}\n$$\n\nSince  $y=15$ is different from $y=0,$ we can accept it as a solution. Thus, the solution is $y=15.$" #edb/ref 17592186045417] [17592186492034 #edb/ref 1068 #edb/ref 17592186491929 #edb/ref 17592186045417] [17592186492034 #edb/ref 1069 "q-217277" #edb/ref 17592186045417] [17592186492034 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186492034 #edb/ref 1071 "The solution to $\\frac{3}{2}=-\\frac{6}{y}$ is$\\,\\,y\\,=$\n{{field-1}}." #edb/ref 17592186045417] [17592186492034 #edb/ref 1072 #uuid "8d4f14d8-ccdb-55e4-bebf-43b325848ca2" #edb/ref 17592186045417] [17592186492034 #edb/ref 1074 "First, note that $y=0$ cannot be a solution since division by $0$ is undefined.\n\nTo solve the equation, we move the negative sign onto the numerator of the fraction and then apply cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{3}{2} & =-\\frac{6}{y} \\\\ \\frac{3}{2} & =\\frac{-6}{y} \\\\ 3\\cdot y & =2\\cdot (-6) \\\\ 3y & =-12\\end{aligned}\n$$\n\nThen, we apply the multiplication principle:\n\n$$\n\\begin{aligned}3y & =-12 \\\\ y & =\\frac{-12}{3} \\\\ y & =-4\\end{aligned}\n$$\n\nSince $y=-4$ is different from $y=0,$ we can accept it as a solution. Therefore, the solution is $y=-4.$" #edb/ref 17592186045417] [17592186492067 #edb/ref 1068 #edb/ref 17592186491953 #edb/ref 17592186045417] [17592186492067 #edb/ref 1069 "q-217265" #edb/ref 17592186045417] [17592186492067 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186492067 #edb/ref 1071 "The solution to $\\frac{1}{2}=\\frac{1}{4q}$ is$\\,\\,q\\,=$\n{{field-1}}." #edb/ref 17592186045417] [17592186492067 #edb/ref 1072 #uuid "e6ff61be-775a-511d-beb8-a9bafba2e916" #edb/ref 17592186045417] [17592186492067 #edb/ref 1074 "First, note that $q=0$ cannot be a solution since division by $0$ is undefined. \n\nTo solve the equation, we first apply cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{1}{2} & =\\frac{1}{4q} \\\\ 1\\cdot 4q & =2\\cdot 1 \\\\ 4q & =2\\end{aligned}\n$$\n\nThen, we apply the multiplication principle:\n\n$$\n\\begin{aligned}4q & =2 \\\\ \\frac{4q}{4} & =\\frac{2}{4} \\\\ q & =\\frac{1}{2}\\end{aligned}\n$$\n\nSince  $q=\\frac{1}{2}$ is different from $q=0,$ we can accept it as a solution. Thus, the solution is $q=\\frac{1}{2}.$" #edb/ref 17592186045417]}
