#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186176936} :activity/id #uuid "61376723-049b-59ca-b0d0-9082d5e50b82" :activity/scope {:db/id #edb/ref 17592186050495 :topic/id #uuid "4dbeffe2-9f1b-50ed-8f1c-59e3cce889c3" :topic/math-academy-id 3561} :activity/steps [{:db/id #edb/ref 17592186176936 :step/content {:db/id #edb/ref 17592186177087 :tutorial/content "We know how to find $2^{-1}.$ But what about $2^{-2}, 2^{-3},2^{-4},\\ldots$?\n\nTo work out ${\\color{blue}{2}}^{{\\color{red}{-2}}},$ all we need to do is find the reciprocal of the base $({\\color{blue}{2}})$ and then raise that reciprocal to the same power but with the *opposite* sign $({{\\color{red}{+2}}})$.\n\n$$\n\\begin{aligned}{2}^{-2} & ={(\\frac{1}{2})}^{2} \\\\  & =(\\frac{1}{2})\\times (\\frac{1}{2}) \\\\  & =(\\frac{1\\times 1}{2\\times 2}) \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$\n\nA similar approach can be used for other powers. Let's see another example." :tutorial/id #uuid "d6f8e85f-3130-5d56-9648-0225b32a7478" :tutorial/math-academy-id 8025 :tutorial/title "Introduction"} :step/id #uuid "ea1ea371-2406-5b35-ae41-17d84bdbd793" :step/math-academy-id 71920 :step/next {:db/id #edb/ref 17592186176937}} {:db/id #edb/ref 17592186176937 :step/content {:db/id #edb/ref 17592186176090 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175716 :question/id #uuid "3bb5bbce-4606-5a62-91a0-7f3fe0ce184b" :question/math-academy-id "e-12805"} :knowledge-point/id #uuid "66cc300e-ea2a-5a29-b7d7-ca3c91e9c84a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049714} {:db/id #edb/ref 17592186049823}] :knowledge-point/questions [{:db/id #edb/ref 17592186176318} {:db/id #edb/ref 17592186176555} {:db/id #edb/ref 17592186480693} {:db/id #edb/ref 17592186480708}] :knowledge-point/title "Raising an Integer to a Negative Power"} :step/id #uuid "f4330c43-f8f3-5717-a93f-a11b12412504" :step/math-academy-id 71921 :step/next {:db/id #edb/ref 17592186176938}} {:db/id #edb/re