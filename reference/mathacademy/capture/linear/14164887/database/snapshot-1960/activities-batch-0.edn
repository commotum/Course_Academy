8} :answer/value "-9" :db/id #edb/ref 17592186488507} {:answer/id #uuid "452d066e-6309-536b-a676-51ef94af1656" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{18}" :db/id #edb/ref 17592186488611} {:answer/id #uuid "516b5642-52ca-558f-b89f-3669698c909c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{9}^{-2}" :db/id #edb/ref 17592186488626} {:answer/id #uuid "698410dd-928f-564c-97a4-4166984a33ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{-9}" :db/id #edb/ref 17592186488676} {:answer/id #uuid "aab053b1-122b-5e8c-a002-523e16312d4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{9}^{2}" :db/id #edb/ref 17592186488808}] :answer-field/correct {:db/id #edb/ref 17592186488626} :answer-field/id #uuid "1ef6f073-8e74-5ee7-b25d-e99ceba5ec74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489038}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4d4bee9d-ce76-579e-9d30-cf5f9cf2d405" :question/math-academy-id "q-6190" :question/problem "Express $\\frac{1}{81}$ as a base raised to a negative exponent." :question/worked-solution "First, we write $\\frac{1}{81}$ as a base raised to a power:\n\n$$\n\\begin{aligned}\\frac{1}{81} & =\\frac{1\\times 1}{9\\times 9} \\\\  & =\\frac{1}{9}\\times \\frac{1}{9} \\\\  & ={(\\frac{1}{9})}^{2}\\end{aligned}\n$$\n\nNow, we find the reciprocal of the base $(\\frac{1}{9}),$ and then raise that reciprocal to the same power but with the *opposite* sign $(-2),$ as follows:\n\n$$\n{(\\frac{1}{9})}^{2}={9}^{-2}\n$$"} :step/id #uuid "b1e8a66e-55d5-5db0-9038-791aff3a99ac" :step/next {:db/id #edb/ref 17592186489367}} {:db/id #edb/ref 17592186489365 :step/content {:db/id #edb/ref 17592186489296 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01c88b39-c18f-5609-af42-c6464e1f7b4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{8}{3}" :db/id #edb/ref 17592186488470} {:answer/id #uuid "5562f759-bcb2-503a-ac9b-ecb74fcf42ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186488633} {:answer/id #uuid "8e1ae6d0-4bff-533a-a95d-92a0c5ae1908" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186488754} {:answer/id #uuid "c22dc3fd-3ecc-5018-99e3-cdf1d5738a25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{9}{16}" :db/id #edb/ref 17592186488863} {:answer/id #uuid "c2ac44af-4e14-559a-9ea7-7a5197b44ac9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16}{9}" :db/id #edb/ref 17592186488864}] :answer-field/correct {:db/id #edb/ref 17592186488864} :answer-field/id #uuid "3520d9ec-94dd-56e9-883d-3d54c63b1325" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489045}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fe935012-f0c6-58bc-9344-9d20da9c881b" :question/math-academy-id "q-71764" :question/problem "${(\\frac{3}{4})}^{-2}=$" :question/worked-solution "We find the reciprocal of the base $(\\frac{3}{4})$, and then raise that reciprocal to the same power but with the *opposite* sign $(+2)$, as follows:\n\n$$\n\\begin{aligned}{(\\frac{3}{4})}^{-2} & ={(\\frac{4}{3})}^{2} \\\\  & =\\frac{4}{3}\\cdot \\frac{4}{3} \\\\  & =\\frac{16}{9}\\end{aligned}\n$$"} :step/id #uuid "d4caf3a0-5c40-55ce-be61-96aecb662c7e"} {:db/id #edb/ref 17592186489367 :step/content {:db/id #edb/ref 17592186489244 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d8803b9-9eda-553f-a752-47d73f4bbb07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{4}^{2}" :db/id #edb/ref 17592186488622} {:answer/id #uuid "4dc9514e-15da-5744-b3cb-398a119df9ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{4}^{-4}" :db/id #edb/ref 17592186488623} {:answer/id #uuid "7227bf75-2f02-5620-88b4-37a4f6a8cfad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{4}^{-3}" :db/id #edb/ref 17592186488699} {:answer/id #uuid "e75f783f-03f5-5e7e-8e42-cbec60546365" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{3}^{-4}" :db/id #edb/ref 17592186488953} {:answer/id #uuid "fd3e80ba-adf6-5413-b1da-31afe0a77c7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{4}^{3}" :db/id #edb/ref 17592186489008}] :answer-field/correct {:db/id #edb/ref 17592186488699} :answer-field/id #uuid "b5943d0a-4750-5c6b-97ba-3430e1cd7e36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489118}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "955d0666-e318-54f6-bac2-1bee61b1768a" :question/math-academy-id "q-6194" :question/problem "Express $\\frac{1}{64}$ as a base raised to a negative exponent." :question/worked-solution "First, we write $\\frac{1}{64}$ as a power with a negative exponent.\n\n$$\n\\begin{aligned}\\frac{1}{64} & =\\frac{1\\times 1\\times 1}{4\\times 4\\times 4} \\\\  & =\\frac{1}{4}\\times \\frac{1}{4}\\times \\frac{1}{4} \\\\  & ={(\\frac{1}{4})}^{3}\\end{aligned}\n$$\n\nNow, we find the reciprocal of the base $(\\frac{1}{4}),$ and then raise that reciprocal to the same power but with the *opposite* sign $(-3),$ as follows:\n\n$$\n{(\\frac{1}{4})}^{3}={4}^{-3}\n$$"} :step/id #uuid "d5c12135-c9d0-5089-88d1-3ca92f8bf295" :step/next {:db/id #edb/ref 17592186489365}}] :activity/title "Negative Exponents" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186488452}]}
