-be61-96aecb662c7e"} {:db/id #edb/ref 17592186489367 :step/content {:db/id #edb/ref 17592186489244 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d8803b9-9eda-553f-a752-47d73f4bbb07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{4}^{2}" :db/id #edb/ref 17592186488622} {:answer/id #uuid "4dc9514e-15da-5744-b3cb-398a119df9ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{4}^{-4}" :db/id #edb/ref 17592186488623} {:answer/id #uuid "7227bf75-2f02-5620-88b4-37a4f6a8cfad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{4}^{-3}" :db/id #edb/ref 17592186488699} {:answer/id #uuid "e75f783f-03f5-5e7e-8e42-cbec60546365" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{3}^{-4}" :db/id #edb/ref 17592186488953} {:answer/id #uuid "fd3e80ba-adf6-5413-b1da-31afe0a77c7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{4}^{3}" :db/id #edb/ref 17592186489008}] :answer-field/correct {:db/id #edb/ref 17592186488699} :answer-field/id #uuid "b5943d0a-4750-5c6b-97ba-3430e1cd7e36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489118}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "955d0666-e318-54f6-bac2-1bee61b1768a" :question/math-academy-id "q-6194" :question/problem "Express $\\frac{1}{64}$ as a base raised to a negative exponent." :question/worked-solution "First, we write $\\frac{1}{64}$ as a power with a negative exponent.\n\n$$\n\\begin{aligned}\\frac{1}{64} & =\\frac{1\\times 1\\times 1}{4\\times 4\\times 4} \\\\  & =\\frac{1}{4}\\times \\frac{1}{4}\\times \\frac{1}{4} \\\\  & ={(\\frac{1}{4})}^{3}\\end{aligned}\n$$\n\nNow, we find the reciprocal of the base $(\\frac{1}{4}),$ and then raise that reciprocal to the same power but with the *opposite* sign $(-3),$ as follows:\n\n$$\n{(\\frac{1}{4})}^{3}={4}^{-3}\n$$"} :step/id #uuid "d5c12135-c9d0-5089-88d1-3ca92f8bf295" :step/next {:db/id #edb/ref 17592186489365}}] :activity/title "Negative Exponents" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186488452}]}
