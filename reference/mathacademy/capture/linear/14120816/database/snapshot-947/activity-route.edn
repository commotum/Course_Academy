#{[{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186416402} :activity/id #uuid "fba459f1-c56d-57d7-af42-f74e494466e0" :activity/scope {:db/id #edb/ref 17592186050065 :topic/id #uuid "2a6bebd4-c41b-566e-8d69-b14df5637cea" :topic/math-academy-id 1961} :activity/steps [{:db/id #edb/ref 17592186416400 :step/content {:db/id #edb/ref 17592186416397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ce3ee34-0bbc-5bf1-8519-a5c6f5ca4be2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186416368} {:answer/id #uuid "2dfe1fac-b11a-54dc-b55d-c32d6ffe73e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186416370} {:answer/id #uuid "8ed59ef4-4b16-5d39-970e-9eb55064e9c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186416378} {:answer/id #uuid "afc0693e-b8b8-5f98-a567-53b12025e699" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186416381} {:answer/id #uuid "ed2eead7-3610-52a9-8cf6-5173ec43049c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186416387}] :answer-field/correct {:db/id #edb/ref 17592186416370} :answer-field/id #uuid "9715d32b-de54-5e1d-b216-07bf1e7e3fc2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186416393}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5979cff9-340a-5b78-84fd-5ca3a8c1f370" :question/math-academy-id "q-140374" :question/problem "The basis $B$ of ${R}^{3}$ and the matrix $[\\,T\\,]_{B}$ of the linear transformation $T:{R}^{3}\\to {R}^{3}$ relative to $B$ are given by\n\n$$\nB={[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}],[\\begin{aligned}2 \\\\ -1 \\\\ 0\\end{aligned}],[\\begin{aligned}0 \\\\ 0 \\\\ 3\\end{aligned}]},\\,[\\,T\\,]_{B}=[\\begin{aligned}a & -5 & -9 \\\\ 3 & b & 6 \\\\ 1 & \\frac{4}{3} & c\\end{aligned}].\n$$\n\nWhat is the value of $\\,a+b+c,\\,$ given that  \n\n$$\nT([\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}])=[\\begin{aligned}x+y+z \\\\ x+z \\\\ y-z\\end{aligned}]\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${{b}_{1},{b}_{2},{b}_{3}}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B.$\n\nFirst, let's find the image of ${b}_{1},$ ${b}_{2},$ and ${b}_{3}$ under $T,$ as follows:\n\n$$\n\\begin{aligned}T({b}_{1}) & =T([\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}])=[\\begin{aligned}1 \\\\ 2 \\\\ -2\\end{aligned}] \\\\ T({b}_{2}) & =T([\\begin{aligned}2 \\\\ -1 \\\\ 0\\end{aligned}])=[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}] \\\\ T({b}_{3}) & =T([\\begin{aligned}0 \\\\ 0 \\\\ 3\\end{aligned}])=[\\begin{aligned}3 \\\\ 3 \\\\ -3\\end{aligned}]\\end{aligned}\n$$\n\nTo find the coordinates of $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | & | & | \\\\ {b}_{1} & {b}_{2} & {b}_{3} & T({b}_{1}) & T({b}_{2}) & T({b}_{3}) \\\\ | & | & | & | & | & |\\end{aligned}].\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 2 & 0 & 1 & 1 & 3 \\\\ -1 & -1 & 0 & 2 & 2 & 3 \\\\ 1 & 0 & 3 & -2 & -1 & -3\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{1}+{R}_{2} \\\\ {R}_{3}:={R}_{3}-{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 2 & 0 & 1 & 1 & 3 \\\\ 0 & 1 & 0 & 3 & 3 & 6 \\\\ 0 & -2 & 3 & -3 & -2 & -6\\end{aligned}] &  & \\begin{aligned}{R}_{1}:={R}_{1}-2{R}_{2} \\\\ {R}_{3}:=2{R}_{2}+{R}_{3}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & -5 & -5 & -9 \\\\ 0 & 1 & 0 & 3 & 3 & 6 \\\\ 0 & 0 & 3 & 3 & 4 & 6\\end{aligned}] &  & \\begin{aligned}{R}_{3}:=\\frac{1}{3}{R}_{3}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & -5 & -5 & -9 \\\\ 0 & 1 & 0 & 3 & 3 & 6 \\\\ 0 & 0 & 1 & 1 & \\frac{4}{3} & 2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=[\\begin{aligned}-5 & -5 & -9 \\\\ 3 & 3 & 6 \\\\ 1 & \\frac{4}{3} & 2\\end{aligned}].\n$$\n\nFinally, $a=-5,$ $b=3,$ $c=2$ and \n\n$$\na+b+c=-5+3+2=0.\n$$"} :step/id #uuid "221c00bb-a31d-5347-8911-eac2ff00072c"} {:db/id #edb/ref 17592186416401 :step/content {:db/id #edb/ref 17592186416399 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c6e04b1-baff-5b92-8e15-ea0dfbc34cf6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}5 & 2 \\\\ -5 & -6\\end{aligned}]" :db/id #edb/ref 17592186416366} {:answer/id #uuid "6f10e2cb-3c02-510f-8245-4c4fef2fb57e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}3 & 5 \\\\ 5 & -5\\end{aligned}]" :db/id #edb/ref 17592186416376} {:answer/id #uuid "d919b397-4a17-5c1a-b41c-a4d8613b1b00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 & 5 \\\\ -4 & -5\\end{aligned}]" :db/id #edb/ref 17592186416384} {:answer/id #uuid "e2593c00-382d-5cff-bc6a-79ef94821d99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}5 & 1 \\\\ 5 & 0\\end{aligned}]" :db/id #edb/ref 17592186416386} {:answer/id #uuid "f8dab090-6ca4-5789-8aba-16cd40d5c9b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}5 & 5 \\\\ 5 & -5\\end{aligned}]" :db/id #edb/ref 17592186416390}] :answer-field/correct {:db/id #edb/ref 17592186416390} :answer-field/id #uuid "d40ebe53-c259-5fc7-9393-ddb15fac1751" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186416395}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e8f9b1b9-d1e3-5a9e-a4fd-34ae92b559e5" :question/math-academy-id "q-140360" :question/problem "Let $B$ be a basis of ${R}^{2}$ and let $T:{R}^{2}\\to {R}^{2}$ be a linear transformation. Find $[\\,T\\,]_{B}$, given that\n\n$\\,$ $T([\\begin{aligned}x \\\\ y\\end{aligned}])=[\\begin{aligned}6x-7y \\\\ -2x-6y\\end{aligned}]\\,$ and $\\,B={[\\begin{aligned}6 \\\\ -2\\end{aligned}],[\\begin{aligned}4 \\\\ 2\\end{aligned}]}.$" :question/worked-solution "Let's denote the vectors of $B$ as ${{b}_{1},{b}_{2}}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $B.$\n\nFirst, let's find the image of ${b}_{1}$ and ${b}_{2}$ under $T,$ as follows:\n\n$$\n\\begin{aligned}T({b}_{1}) & =T([\\begin{aligned}6 \\\\ -2\\end{aligned}])=[\\begin{aligned}50 \\\\ 0\\end{aligned}] \\\\ T({b}_{2}) & =T([\\begin{aligned}4 \\\\ 2\\end{aligned}])=[\\begin{aligned}10 \\\\ -20\\end{aligned}]\\end{aligned}\n$$\n\nTo find the coordinates of $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {b}_{1} & {b}_{2} & T({b}_{1}) & T({b}_{2}) \\\\ | & | & | & |\\end{aligned}].\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}6 & 4 & 50 & 10 \\\\ -2 & 2 & 0 & -20\\end{aligned}] &  & \\begin{aligned}{R}_{1}:=\\frac{1}{6}{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & \\frac{2}{3} & \\frac{25}{3} & \\frac{5}{3} \\\\ -2 & 2 & 0 & -20\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+2{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & \\frac{2}{3} & \\frac{25}{3} & \\frac{5}{3} \\\\ 0 & \\frac{10}{3} & \\frac{50}{3} & -\\frac{50}{3}\\end{aligned}] &  & \\begin{aligned}{R}_{2}:=\\frac{3}{10}{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & \\frac{2}{3} & \\frac{25}{3} & \\frac{5}{3} \\\\ 0 & 1 & 5 & -5\\end{aligned}] &  & \\begin{aligned}{R}_{1}:={R}_{1}-\\frac{2}{3}{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 5 & 5 \\\\ 0 & 1 & 5 & -5\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=[\\begin{aligned}5 & 5 \\\\ 5 & -5\\end{aligned}].\n$$"} :step/id #uuid "31c1f001-a165-53a3-a48f-20a1363b6bd5" :step/next {:db/id #edb/ref 17592186416400}} {:db/id #edb/ref 17592186416402 :step/content {:db/id #edb/ref 17592186125123 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64eb9c2e-66d0-5fc4-aa5a-2c7fb43cd368" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}\\frac{5}{4} & \\frac{7}{4} \\\\ -\\frac{5}{4} & \\frac{5}{4}\\end{aligned}]" :db/id #edb/ref 17592186416374} {:answer/id #uuid "cc5383fc-ca27-5bd5-b02a-bf1e5f43198b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}\\frac{5}{4} & -\\frac{5}{4} \\\\ \\frac{7}{4} & \\frac{5}{4}\\end{aligned}]" :db/id #edb/ref 17592186416382} {:answer/id #uuid "dec55aef-e332-5ab4-a920-1dee4e7fa6b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}\\frac{4}{7} & -1 \\\\ 1 & -\\frac{4}{7}\\end{aligned}]" :db/id #edb/ref 17592186416385} {:answer/id #uuid "eed1b8eb-075d-5e89-ac91-165ab413e66d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}\\frac{7}{4} & -\\frac{9}{4} \\\\ -\\frac{7}{4} & -\\frac{7}{4}\\end{aligned}]" :db/id #edb/ref 17592186416388} {:answer/id #uuid "f8c3f922-86e4-52c9-b2cc-7fc300650e6e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-\\frac{7}{4} & \\frac{9}{4} \\\\ \\frac{7}{4} & -\\frac{7}{4}\\end{aligned}]" :db/id #edb/ref 17592186416389}] :answer-field/correct {:db/id #edb/ref 17592186416388} :answer-field/id #uuid "197649b0-e179-5dbc-96a2-7c730a9f52c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186416391}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "de77921d-5cbd-5106-8c3d-d64b6e5602e4" :question/math-academy-id "q-38194" :question/problem "Let $B$ be a basis of ${R}^{2}$ and let $T:{R}^{2}\\to {R}^{2}$ be a linear transformation. Find $[\\,T\\,]_{B}$, given that\n\n$\\,$ $T([\\begin{aligned}x \\\\ y\\end{aligned}])=[\\begin{aligned}x+3y \\\\ 2x-y\\end{aligned}]\\,$ and $\\,B={[\\begin{aligned}1 \\\\ 2\\end{aligned}],[\\begin{aligned}-3 \\\\ 2\\end{aligned}]}.$" :question/worked-solution "Let's denote the vectors of $B$ as ${{b}_{1},{b}_{2}}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $B.$\n\nFirst, let's find the image of ${b}_{1}$ and ${b}_{2}$ under $T,$ as follows:\n\n$$\n\\begin{aligned}T({b}_{1}) & =T([\\begin{aligned}1 \\\\ 2\\end{aligned}])=[\\begin{aligned}7 \\\\ 0\\end{aligned}] \\\\ T({b}_{2}) & =T([\\begin{aligned}-3 \\\\ 2\\end{aligned}])=[\\begin{aligned}3 \\\\ -8\\end{aligned}]\\end{aligned}\n$$\n\nTo find the coordinates of $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {b}_{1} & {b}_{2} & T({b}_{1}) & T({b}_{2}) \\\\ | & | & | & |\\end{aligned}].\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -3 & 7 & 3 \\\\ 2 & 2 & 0 & -8\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}-2{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -3 & 7 & 3 \\\\ 0 & 8 & -14 & -14\\end{aligned}] &  & \\begin{aligned}{R}_{2}:=\\frac{1}{8}{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -3 & 7 & 3 \\\\ 0 & 1 & -\\frac{7}{4} & -\\frac{7}{4}\\end{aligned}] &  & \\begin{aligned}{R}_{1}:={R}_{1}+3{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & \\frac{7}{4} & -\\frac{9}{4} \\\\ 0 & 1 & -\\frac{7}{4} & -\\frac{7}{4}\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=[\\begin{aligned}\\frac{7}{4} & -\\frac{9}{4} \\\\ -\\frac{7}{4} & -\\frac{7}{4}\\end{aligned}].\n$$"} :step/id #uuid "9a8c8f2a-1dbf-57d0-bdf1-3df2a4ffe578" :step/next {:db/id #edb/ref 17592186416404}} {:db/id #edb/ref 17592186416403 :step/content {:db/id #edb/ref 17592186416396 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "160cf1c3-ac0f-5878-aa13-d5ddd7963cf2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186416367} {:answer/id #uuid "1d6e6bfd-9b54-517b-b0e0-a62d79b1f20a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186416369} {:answer/id #uuid "5711295d-197b-58b6-9e28-191b003214aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186416372} {:answer/id #uuid "582cb2d5-d3fc-5e12-b72f-d8cfda5e904d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186416373} {:answer/id #uuid "83656066-e5fe-596a-a8ca-783daf5d23d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186416377}] :answer-field/correct {:db/id #edb/ref 17592186416377} :answer-field/id #uuid "55345e60-62bc-5001-9ca7-f576705f2f04" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186416392}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2fc0336a-ad5e-573a-ac70-a523b483c681" :question/math-academy-id "q-82488" :question/problem "The basis $B$ of ${R}^{3}$ and the matrix $[\\,T\\,]_{B}$ of the linear transformation $T:{R}^{3}\\to {R}^{3}$ relative to $B$ are given by\n\n$$\nB={[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}],[\\begin{aligned}2 \\\\ 3 \\\\ 0\\end{aligned}],[\\begin{aligned}0 \\\\ 0 \\\\ 5\\end{aligned}]},\\,[\\,T\\,]_{B}=[\\begin{aligned}0 & b & 4 \\\\ a & 3 & 0 \\\\ 0 & 0 & c\\end{aligned}].\n$$\n\nWhat is the value of $\\,a+b+c,\\,$ given that  \n\n$$\nT({b}_{1})=[\\begin{aligned}2 \\\\ 3 \\\\ 0\\end{aligned}],\\,T({b}_{2})=[\\begin{aligned}-1 \\\\ 9 \\\\ 0\\end{aligned}],\\,T({b}_{3})=[\\begin{aligned}4 \\\\ 0 \\\\ 10\\end{aligned}].\n$$" :question/worked-solution "Let's denote the vectors of $B$ as ${{b}_{1},{b}_{2},{b}_{3}}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B.$\n\nTo find the coordinates of $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | & | & | \\\\ {b}_{1} & {b}_{2} & {b}_{3} & T({b}_{1}) & T({b}_{2}) & T({b}_{3}) \\\\ | & | & | & | & | & |\\end{aligned}].\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 2 & 0 & 2 & -1 & 4 \\\\ 0 & 3 & 0 & 3 & 9 & 0 \\\\ 0 & 0 & 5 & 0 & 0 & 10\\end{aligned}] &  & \\begin{aligned}{R}_{2}:=\\frac{1}{3}{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 2 & 0 & 2 & -1 & 4 \\\\ 0 & 1 & 0 & 1 & 3 & 0 \\\\ 0 & 0 & 5 & 0 & 0 & 10\\end{aligned}] &  & \\begin{aligned}{R}_{1}:={R}_{1}-2{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 0 & -7 & 4 \\\\ 0 & 1 & 0 & 1 & 3 & 0 \\\\ 0 & 0 & 5 & 0 & 0 & 10\\end{aligned}] &  & \\begin{aligned}{R}_{3}:=\\frac{1}{5}{R}_{3}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 0 & -7 & 4 \\\\ 0 & 1 & 0 & 1 & 3 & 0 \\\\ 0 & 0 & 1 & 0 & 0 & 2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=[\\begin{aligned}0 & -7 & 4 \\\\ 1 & 3 & 0 \\\\ 0 & 0 & 2\\end{aligned}]\n$$\n\nFinally, $a=1,$ $b=-7,$ $c=2$ and \n\n$$\na+b+c=1+(-7)+2=-4.\n$$"} :step/id #uuid "d199631a-4b67-55a6-a1cd-91665077dcd8" :step/next {:db/id #edb/ref 17592186416401}} {:db/id #edb/ref 17592186416404 :step/content {:db/id #edb/ref 17592186416398 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fb9e7d4-7d49-5611-aa8c-f624e6e0dc8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186416371} {:answer/id #uuid "6e0f4265-777b-5a68-a83b-4d5ec07516f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186416375} {:answer/id #uuid "9051dc30-494b-5b2b-98d2-22f5ecef3027" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186416379} {:answer/id #uuid "ab6e7a2c-0fcc-54a7-8cfc-46063d0feef7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186416380} {:answer/id #uuid "d806f1c8-7b38-5943-8f66-4ce22d0914ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186416383}] :answer-field/correct {:db/id #edb/ref 17592186416383} :answer-field/id #uuid "cb7d556e-1c97-50dc-be6c-38b9a13c9e90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186416394}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "abf9f8e2-5bef-5f02-8f73-975c228317db" :question/math-academy-id "q-82461" :question/problem "Let $B={{b}_{1},{b}_{2},{b}_{3}}$ be a basis of ${R}^{3}.$ The matrix $[\\,T\\,]_{B}$ of the linear transformation $T:{R}^{3}\\to {R}^{3}$ is given by\n\n$$\n[\\,T\\,]_{B}=[\\begin{aligned}a & 1 & 2 \\\\ -1 & b & -2 \\\\ 3 & 0 & c\\end{aligned}].\n$$\n\nFind the value of $\\,a+b+c,\\,$ given that \n\n$$\n\\begin{aligned}T({b}_{1}) & =2{b}_{1}-{b}_{2}+3{b}_{3}, \\\\ T({b}_{2}) & ={b}_{1}+3{b}_{2}, \\\\ T({b}_{3}) & =2{b}_{1}-2{b}_{2}+3{b}_{3}.\\end{aligned}\n$$" :question/worked-solution "First, we write down the coordinates of the images relative to the basis $B:$\n\n$$\n[T({b}_{1})]_{B}=[\\begin{aligned}2 \\\\ -1 \\\\ 3\\end{aligned}],\\,[T({b}_{2})]_{B}=[\\begin{aligned}1 \\\\ 3 \\\\ 0\\end{aligned}],\\,[T({b}_{3})]_{B}=[\\begin{aligned}2 \\\\ -2 \\\\ 3\\end{aligned}]\n$$\n\nNow, the $B$-matrix for $T$ is a matrix  whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $B.$ Therefore, we obtain\n\n$$\n[\\,T\\,]_{B}=[\\begin{aligned}2 & 1 & 2 \\\\ -1 & 3 & -2 \\\\ 3 & 0 & 3\\end{aligned}].\n$$\n\nFinally, $a=2,$ $b=3,$ $c=3$ and \n\n$$\na+b+c=2+3+3=8.\n$$"} :step/id #uuid "fc9d50c6-34cb-59b8-909c-50ceb04dbf99" :step/next {:db/id #edb/ref 17592186416403}}] :activity/title "The Matrix of a Linear Transformation Relative to a Basis" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186416365}]}
