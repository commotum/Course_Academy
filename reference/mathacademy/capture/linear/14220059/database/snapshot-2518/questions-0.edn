#{[{:db/id #edb/ref 17592186068593 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068755 :knowledge-point/id #uuid "7ee9f8f9-37dd-5e7f-9a5c-b6d757c12025" :knowledge-point/title "Multiplying Rational Expressions With No Common Factor"}] :question/id #uuid "5d90ba01-2318-5f03-9d7a-a7ad66555886" :question/math-academy-id "e-5131" :question/problem "Simplify $\\dfrac 2 x \\cdot \\dfrac 3 {y^2} .$" :question/worked-solution "We multiply the numerators and the denominators as follows:\n\n$$\n\\eqalign{\n\t\t\\dfrac 2 x \\cdot \\dfrac 3 {y^2} \n\t\t&=\\dfrac {2 \\cdot 3} {x \\cdot y^2}\n\t\t&=\\dfrac {6} {xy^2}\n\t}\n$$"}] [{:db/id #edb/ref 17592186068594 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068756 :knowledge-point/id #uuid "a771c493-d19b-561b-94e6-dc421b828b44" :knowledge-point/title "Multiplying Rational Expressions and Simplifying the Result"}] :question/id #uuid "702e4d33-7021-5b21-9c9d-d41463f7b665" :question/math-academy-id "e-5132" :question/problem "Given that $\\dfrac {6a} {b^2} = x$ and $\\dfrac {3b} {2a}= y,$ what is $x\\cdot y?$" :question/worked-solution "We multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned}x\\cdot y & =\\frac{6a}{{b}^{2}}\\cdot \\frac{3b}{2a} \\\\  & =\\frac{6a\\cdot 3b}{{b}^{2}\\cdot 2a} \\\\  & =\\frac{18ab}{2a{b}^{2}} \\\\  & =\\frac{9}{b}.\\end{aligned}\n$$\n\n**Note:** In the above example, we performed some cancellations after multiplying. However, with more complex expressions, it's often easier to cancel *before* multiplying."}] [{:db/id #edb/ref 17592186068595 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068757 :knowledge-point/id #uuid "3b2a63d1-c113-5866-8128-348fa0e59b22" :knowledge-point/title "Multiplying Rational Expressions by Canceling Common Terms"}] :question/id #uuid "e75ba094-e762-5e8d-9175-1d9617d32128" :question/math-academy-id "e-5133" :question/problem "Simplify $\\dfrac {(n + 1)(n + 3)} {4n^2} \\cdot \\dfrac {8n}{(n + 3)(n - 2)}.$" :question/worked-solution "First, we cancel any terms that appear in both a numerator and a denominator. Then, we multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned}\\frac{(n+1)(n+3)}{4{n}^{2}}\\cdot \\frac{8n}{(n+3)(n-2)} & =\\frac{(n+1)\\cancel{(n+3)}}{\\cancel{4n}\\cdot n}\\cdot \\frac{2\\cdot \\cancel{4n}}{\\cancel{(n+3)}(n-2)} \\\\  & =\\frac{n+1}{n}\\cdot \\frac{2}{n-2} \\\\  & =\\frac{2n+2}{{n}^{2}-2n}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068596 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068758 :knowledge-point/id #uuid "2524afb3-e044-545e-8f7d-14a6ade93fb5" :knowledge-point/title "Multiplying Rational Expressions by Factoring and Canceling Common Terms"}] :question/id #uuid "e521a677-4e95-5c86-80c1-447924b6d34d" :question/math-academy-id "e-5134" :question/problem "Simplify $\\dfrac {3p - 12}{p^2 - 9} \\cdot \\dfrac {p + 3} {p - 4}.$" :question/worked-solution "First, we factor all of the expressions and cancel any terms that appear in both a numerator and a denominator. Then, we multiply the numerators and the denominators as follows:\n\n$$\n\\eqalign{\n\t\t\\dfrac {3p - 12}{p^2 - 9} \\cdot \\dfrac {p + 3} {p - 4} \n\t\t&=\\dfrac {3(p - 4)} {(p + 3)(p - 3)} \\cdot \\dfrac {p + 3} {p - 4} \\[5pt]\n\t\t&=\\dfrac {3\\cancel{(p - 4)}} {\\cancel{(p + 3)}(p - 3)} \\cdot \\dfrac {\\cancel{p + 3}} {\\cancel{p - 4}} \\[5pt]\n\t\t&=\\dfrac {3}{p - 3}\n\n\t}\n$$"}] [{:db/id #edb/ref 17592186531601 :knowledge-point/_questions [{:db/id #edb/ref 17592186068755 :knowledge-point/id #uuid "7ee9f8f9-37dd-5e7f-9a5c-b6d757c12025" :knowledge-point/title "Multiplying Rational Expressions With No Common Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51953942-3d47-57c4-84c0-afc890691776" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{w}^{3}}{5z}" :db/id #edb/ref 17592186531043} {:answer/id #uuid "56e67d10-eedb-5942-9ff3-264c25cf8c03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6{w}^{3}z}" :db/id #edb/ref 17592186531055} {:answer/id #uuid "651525e9-05ac-534a-9b83-9a2ce1154529" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{w}^{3}}{6z}" :db/id #edb/ref 17592186531088} {:answer/id #uuid "7e77e7a6-9827-5e34-b7cb-73b6f216446a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{w}^{3}z}{6}" :db/id #edb/ref 17592186531140} {:answer/id #uuid "c0b05000-0f87-5eec-8f77-3ac5b01af44a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{w}^{3}}{z}" :db/id #edb/ref 17592186531270}] :answer-field/correct {:answer/id #uuid "651525e9-05ac-534a-9b83-9a2ce1154529" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{w}^{3}}{6z}" :db/id #edb/ref 17592186531088} :answer-field/id #uuid "67f3f964-1b7f-53db-9cb0-2e1db93fceff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531460}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6455b841-9f87-516b-8fea-0d225062fdb2" :question/math-academy-id "q-113355" :question/problem "$\\frac{{w}^{3}}{2}\\cdot \\frac{5}{3z}=$" :question/worked-solution "We multiply the numerators and the denominators as follows:\n\n$$\n\\frac{{w}^{3}}{2}\\cdot \\frac{5}{3z}=\\frac{{w}^{3}\\cdot 5}{2\\cdot 3z}=\\frac{5{w}^{3}}{6z}\n$$"}] [{:db/id #edb/ref 17592186531650 :knowledge-point/_questions [{:db/id #edb/ref 17592186068758 :knowledge-point/id #uuid "2524afb3-e044-545e-8f7d-14a6ade93fb5" :knowledge-point/title "Multiplying Rational Expressions by Factoring and Canceling Common Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07ac96b0-64cb-518d-8210-e3d3fdcb5473" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x+1}{x-2}" :db/id #edb/ref 17592186530874} {:answer/id #uuid "661fe2c0-29f3-5094-a30d-b7df43b97a39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-4}{x-3}" :db/id #edb/ref 17592186531091} {:answer/id #uuid "666a6341-9514-55c9-8b88-d14cc270aa4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+4}{x-2}" :db/id #edb/ref 17592186531092} {:answer/id #uuid "a810caef-0770-5295-bd89-ff677b2b0d1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-8}{x-2}" :db/id #edb/ref 17592186531226} {:answer/id #uuid "a89e0287-44ad-514b-acc6-1fa5b569129b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+4}{2x-1}" :db/id #edb/ref 17592186531229}] :answer-field/correct {:answer/id #uuid "666a6341-9514-55c9-8b88-d14cc270aa4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+4}{x-2}" :db/id #edb/ref 17592186531092} :answer-field/id #uuid "41c2ce33-393f-50a3-9843-3fcc93fedacc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531442}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e1404dec-45bb-593f-8444-817e3a0c6414" :question/math-academy-id "q-14403" :question/problem "Which of the following is equivalent to $\\frac{{x}^{2}-16}{{x}^{2}-5x+6}\\cdot \\frac{x-3}{x-4}?$" :question/worked-solution "First, we factor all of the expressions and cancel any terms that appear in both a numerator and a denominator. Then, we multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}-16}{{x}^{2}-5x+6}\\cdot \\frac{x-3}{x-4} & =\\frac{(x+4)(x-4)}{(x-2)(x-3)}\\cdot \\frac{x-3}{x-4} \\\\  & =\\frac{(x+4)\\cancel{(x-4)}}{(x-2)\\cancel{(x-3)}}\\cdot \\frac{\\cancel{(x-3)}}{\\cancel{x-4}} \\\\  & =\\frac{x+4}{x-2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186531580 :knowledge-point/_questions [{:db/id #edb/ref 17592186068757 :knowledge-point/id #uuid "3b2a63d1-c113-5866-8128-348fa0e59b22" :knowledge-point/title "Multiplying Rational Expressions by Canceling Common Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2135b485-86da-56e1-99e5-5980e0fdf574" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{{z}^{2}}" :db/id #edb/ref 17592186530934} {:answer/id #uuid "589dfa25-339d-59c6-9961-222f07bcde3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5xz}{y}" :db/id #edb/ref 17592186531060} {:answer/id #uuid "709816ae-3d7b-5836-98c7-115f160436d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10y}{{z}^{2}}" :db/id #edb/ref 17592186531113} {:answer/id #uuid "c9990a1d-b112-561c-8ea2-8f77e51a3977" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5x{y}^{2}}{z}" :db/id #edb/ref 17592186531285} {:answer/id #uuid "f19b24ba-53c6-5d80-aeb7-7ad70ffd21af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10xy}{z}" :db/id #edb/ref 17592186531356}] :answer-field/correct {:answer/id #uuid "f19b24ba-53c6-5d80-aeb7-7ad70ffd21af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10xy}{z}" :db/id #edb/ref 17592186531356} :answer-field/id #uuid "85c27fcd-3331-5240-8e4b-a92ab75ac3c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531478}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "375b774b-1afa-5119-93c1-a64d09ffe7d5" :question/math-academy-id "q-14411" :question/problem "Which of the following is equivalent to $\\frac{5{y}^{2}}{4{z}^{2}}\\cdot \\frac{8xz}{y}?$" :question/worked-solution "First, we cancel any terms that appear in both a numerator and a denominator. Then, we multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned}\\frac{5{y}^{2}}{4{z}^{2}}\\cdot \\frac{8xz}{y} & =\\frac{5y\\cdot y}{4z\\cdot z}\\cdot \\frac{4z\\cdot 2x}{y} \\\\  & =\\frac{5y\\cdot \\cancel{y}}{\\cancel{4z}\\cdot z}\\cdot \\frac{\\cancel{4z}\\cdot 2x}{\\cancel{y}} \\\\  & =\\frac{5y}{z}\\cdot \\frac{2x}{1} \\\\  & =\\frac{10xy}{z}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186531610 :knowledge-point/_questions [{:db/id #edb/ref 17592186068758 :knowledge-point/id #uuid "2524afb3-e044-545e-8f7d-14a6ade93fb5" :knowledge-point/title "Multiplying Rational Expressions by Factoring and Canceling Common Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2586580c-5e06-53d6-b4ba-93241858e150" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n}{m}" :db/id #edb/ref 17592186530947} {:answer/id #uuid "34b08626-2d00-5b7e-9efa-74a3354cae2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{m}" :db/id #edb/ref 17592186530976} {:answer/id #uuid "3fb38320-3554-5dad-b771-ca9d7405cb42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n}{{m}^{2}}" :db/id #edb/ref 17592186530998} {:answer/id #uuid "733172b4-d725-5010-882c-86b19527c3c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n" :db/id #edb/ref 17592186531120} {:answer/id #uuid "f3d23487-0517-59a2-ad90-00b344f62e58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2n}{{m}^{2}}" :db/id #edb/ref 17592186531362}] :answer-field/correct {:answer/id #uuid "2586580c-5e06-53d6-b4ba-93241858e150" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n}{m}" :db/id #edb/ref 17592186530947} :answer-field/id #uuid "6b52c0d2-22e4-591e-be62-bf893c2cb281" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531463}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "77bb223c-233d-57ea-b08b-423b072f4e97" :question/math-academy-id "q-14412" :question/problem "Given that $\\frac{mn-4n}{2m}=a$ and $\\frac{2}{m-4}=b$, what is $a\\cdot b?$" :question/worked-solution "First, we factor all of the expressions and cancel any terms that appear in both a numerator and a denominator. Then, we multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned}a\\cdot b & =\\frac{mn-4n}{2m}\\cdot \\frac{2}{m-4} \\\\  & =\\frac{n(m-4)}{2\\cdot m}\\cdot \\frac{2}{m-4} \\\\  & =\\frac{n\\cancel{(m-4)}}{\\cancel{2}\\cdot m}\\cdot \\frac{\\cancel{2}}{\\cancel{m-4}} \\\\  & =\\frac{n}{m}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186531572 :knowledge-point/_questions [{:db/id #edb/ref 17592186068757 :knowledge-point/id #uuid "3b2a63d1-c113-5866-8128-348fa0e59b22" :knowledge-point/title "Multiplying Rational Expressions by Canceling Common Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "118add16-3226-55a3-a5bc-8972164c57a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5q}{11{p}^{2}}" :db/id #edb/ref 17592186530896} {:answer/id #uuid "34f1ffcd-f1a6-5efb-8f17-d4c2da7795b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{q}{121pr}" :db/id #edb/ref 17592186530977} {:answer/id #uuid "35f47d4f-cb38-52db-a4b5-d7d8e34b95be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5q}{11{p}^{3}r}" :db/id #edb/ref 17592186530980} {:answer/id #uuid "bd92409f-07bc-59f3-a706-ba815db31cee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{55q}{121{p}^{3}}" :db/id #edb/ref 17592186531266} {:answer/id #uuid "d6030517-ea9c-52e5-bf13-7b136eb8ce0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5q}{11{r}^{2}}" :db/id #edb/ref 17592186531304}] :answer-field/correct {:answer/id #uuid "35f47d4f-cb38-52db-a4b5-d7d8e34b95be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5q}{11{p}^{3}r}" :db/id #edb/ref 17592186530980} :answer-field/id #uuid "3513e198-c7c0-5e29-849a-4ed2ffa42413" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531428}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2867a50e-2edc-52ac-9829-fb91f9cd04d7" :question/math-academy-id "q-3517" :question/problem "$\\frac{11p{q}^{2}}{{r}^{3}}\\cdot \\frac{5{r}^{2}}{121{p}^{4}q}=$" :question/worked-solution "First, we cancel any terms that appear in both a numerator of one fraction and a denominator of the other one. Then, we multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned}\\frac{11p{q}^{2}}{{r}^{3}}\\cdot \\frac{5{r}^{2}}{121{p}^{4}q} & =\\frac{11pq\\cdot q}{r\\cdot {r}^{2}}\\cdot \\frac{5\\cdot {r}^{2}}{11pq\\cdot 11{p}^{3}} \\\\  & =\\frac{\\cancel{11pq}\\cdot q}{r\\cdot \\cancel{{r}^{2}}}\\cdot \\frac{5\\cdot \\cancel{{r}^{2}}}{\\cancel{11pq}\\cdot 11{p}^{3}} \\\\  & =\\frac{q}{r}\\cdot \\frac{5}{11{p}^{3}} \\\\  & =\\frac{5q}{11{p}^{3}r}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186531623 :knowledge-point/_questions [{:db/id #edb/ref 17592186068755 :knowledge-point/id #uuid "7ee9f8f9-37dd-5e7f-9a5c-b6d757c12025" :knowledge-point/title "Multiplying Rational Expressions With No Common Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a350eb6-e83b-5a99-b963-705099d2df61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{b{c}^{3}(a-5)}{21}" :db/id #edb/ref 17592186531100} {:answer/id #uuid "6dd481cc-758f-59ca-bdea-2301d0162683" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7b{c}^{3}}{3(a-5)}" :db/id #edb/ref 17592186531110} {:answer/id #uuid "7ca274d0-b348-544f-8ce6-4453819e2116" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7b{c}^{3}(a-5)}{3}" :db/id #edb/ref 17592186531137} {:answer/id #uuid "9edca370-d986-55df-923e-d5c4725ac77d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7(a-5)}{3b{c}^{3}}" :db/id #edb/ref 17592186531207} {:answer/id #uuid "a1d085c9-ae71-5898-a42e-adb06da0a886" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{b{c}^{3}(a-5)}" :db/id #edb/ref 17592186531214}] :answer-field/correct {:answer/id #uuid "6dd481cc-758f-59ca-bdea-2301d0162683" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7b{c}^{3}}{3(a-5)}" :db/id #edb/ref 17592186531110} :answer-field/id #uuid "eeb194b9-a54d-58d0-8b4c-728fcaac5750" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531544}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "98c5a09c-66f3-5ba5-a68c-81bc86cd79e6" :question/math-academy-id "q-70318" :question/problem "$\\frac{7}{a-5}\\cdot \\frac{b{c}^{3}}{3}=$" :question/worked-solution "We multiply the numerators and the denominators as follows:\n\n$$\n\\frac{7}{a-5}\\cdot \\frac{b{c}^{3}}{3}=\\frac{7\\cdot b{c}^{3}}{(a-5)\\cdot 3}=\\frac{7b{c}^{3}}{3(a-5)}\n$$"}] [{:db/id #edb/ref 17592186531654 :knowledge-point/_questions [{:db/id #edb/ref 17592186068756 :knowledge-point/id #uuid "a771c493-d19b-561b-94e6-dc421b828b44" :knowledge-point/title "Multiplying Rational Expressions and Simplifying the Result"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a52a41f-7227-580c-b754-7137ec9d1f09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x}{y}" :db/id #edb/ref 17592186530882} {:answer/id #uuid "46014d02-a9d0-58f2-9e55-ffdc3821139d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}}{y}" :db/id #edb/ref 17592186531014} {:answer/id #uuid "46ea2257-9905-5a18-8e6b-4dbd806bcae7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x" :db/id #edb/ref 17592186531017} {:answer/id #uuid "5b01537a-238a-50a4-a32f-018853dacd6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3y" :db/id #edb/ref 17592186531064} {:answer/id #uuid "5e455b43-3370-566d-a1e5-b7f9cd18e0d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{y}^{2}}{x}" :db/id #edb/ref 17592186531072}] :answer-field/correct {:answer/id #uuid "5b01537a-238a-50a4-a32f-018853dacd6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3y" :db/id #edb/ref 17592186531064} :answer-field/id #uuid "1f904be5-775e-56d5-aae6-eb8af51836e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531412}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f3ac8b1a-7d85-55e8-a403-9ecc671851c3" :question/math-academy-id "q-70319" :question/problem "$\\frac{{x}^{2}}{2y}\\cdot \\frac{6{y}^{2}}{{x}^{2}}=$" :question/worked-solution "We multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{2y}\\cdot \\frac{6{y}^{2}}{{x}^{2}} & =\\frac{{x}^{2}\\cdot 6{y}^{2}}{2y\\cdot {x}^{2}} \\\\  & =\\frac{6{x}^{2}{y}^{2}}{2{x}^{2}y} \\\\  & =3y\\end{aligned}\n$$\n\n**Note:** In the above example, we performed some cancellations after multiplying. However, with more complex expressions, it's often easier to cancel *before* multiplying."}] [{:db/id #edb/ref 17592186531636 :knowledge-point/_questions [{:db/id #edb/ref 17592186068756 :knowledge-point/id #uuid "a771c493-d19b-561b-94e6-dc421b828b44" :knowledge-point/title "Multiplying Rational Expressions and Simplifying the Result"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09bd9650-94ca-5181-9ee0-893b163ebb81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{st}{2}" :db/id #edb/ref 17592186530881} {:answer/id #uuid "29e29e5e-9116-598c-80bb-1c8e6648ca82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{s}^{2}t" :db/id #edb/ref 17592186530957} {:answer/id #uuid "2c716f25-fd40-5238-8508-1984409c4959" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{st}" :db/id #edb/ref 17592186530961} {:answer/id #uuid "33445949-61c0-5af2-9d05-116bb19b21b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{s}^{3}}{2{t}^{3}}" :db/id #edb/ref 17592186530974} {:answer/id #uuid "4395f6aa-bc44-53fc-aa3e-2cd85e399160" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{s}^{3}}{{t}^{3}}" :db/id #edb/ref 17592186531006}] :answer-field/correct {:answer/id #uuid "29e29e5e-9116-598c-80bb-1c8e6648ca82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{s}^{2}t" :db/id #edb/ref 17592186530957} :answer-field/id #uuid "9ab002fa-1296-5bf0-b94c-53d23d1a7c1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531490}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c11871ea-d169-5487-96ff-63c7ffae0586" :question/math-academy-id "q-70320" :question/problem "$\\frac{4{s}^{2}}{t}\\cdot \\frac{{t}^{2}}{2}=$" :question/worked-solution "We multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned}\\frac{4{s}^{2}}{t}\\cdot \\frac{{t}^{2}}{2} & =\\frac{4{s}^{2}\\cdot {t}^{2}}{t\\cdot 2} \\\\  & =\\frac{4{s}^{2}{t}^{2}}{2t} \\\\  & =2{s}^{2}t\\end{aligned}\n$$\n\n**Note:** In the above example, we performed some cancellations after multiplying. However, with more complex expressions, it's often easier to cancel *before* multiplying."}]}
