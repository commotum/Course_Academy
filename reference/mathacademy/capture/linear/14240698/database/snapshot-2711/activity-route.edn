#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186558659} :activity/id #uuid "d37c9ba1-7a39-5831-87ff-34c70ac9d8df" :activity/scope {:db/id #edb/ref 17592186049657 :topic/id #uuid "08c0f60c-daa6-535e-8559-0b890fd64487" :topic/math-academy-id 2472} :activity/steps [{:db/id #edb/ref 17592186558605 :step/content {:db/id #edb/ref 17592186558510 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c5f1225-6f0a-505c-86ce-562e015af918" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p(t)=58\\,000\\cdot (0.6)^{t}" :db/id #edb/ref 17592186557894} {:answer/id #uuid "2de2448f-732d-557d-b173-162765b2dd4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p(t)=58\\,000\\cdot (0.94)^{t}" :db/id #edb/ref 17592186557962} {:answer/id #uuid "88841433-8f87-5d36-9b04-98fc315ada9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p(t)=58\\,000\\cdot (0.96)^{t}" :db/id #edb/ref 17592186558135} {:answer/id #uuid "9c041606-fc36-5db6-8431-7d0c0feaf2fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p(t)=58\\,000\\cdot (0.4)^{t}" :db/id #edb/ref 17592186558174} {:answer/id #uuid "c09e46e2-3be6-5701-9069-54411490d90d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p(t)=58\\,000\\cdot (0.06)^{t}" :db/id #edb/ref 17592186558251}] :answer-field/correct {:db/id #edb/ref 17592186557962} :answer-field/id #uuid "1b826ca2-dd9d-5e40-a2b1-27a1b445aeb4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558373}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "476bf309-f448-501a-8dca-89cb923e9fd5" :question/math-academy-id "q-62052" :question/problem "Austin's average monthly profit has been decreasing at a rate of $6%$ every year. If he initially recorded an average monthly profit of $$58\\,000$, then which function correctly represents $p(t),$ Austin's average monthly profit since the start of the decline?" :question/worked-solution "The formula for exponential decay (in terms of a decay rate $r$) is\n\n$$\np(t)=a(1-r)^{t}.\n$$\n\nIn our case, we have the following:\n\n- $a=58\\,000$ is the initial average monthly profit.\n\n- $r=0.06$ is the decay rate ($6%$ expressed as a decimal).\n\n- $t=$ the time, in years.\n\nTherefore, the correct expression for $p$ is\n\n$$\np(t)=58\\,000\\cdot (1-0.06)^{t}=58\\,000\\cdot (0.94)^{t}.\n$$"} :step/id #uuid "2f1bf5b6-2615-592e-aedc-3e9f1565ab81" :step/next {:db/id #edb/ref 17592186558618}} {:db/id #edb/ref 17592186558618 :step/content {:db/id #edb/ref 17592186558533 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1780eced-9ab1-5f96-8157-861bdec2da92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{9}" :db/id #edb/ref 17592186557921} {:answer/id #uuid "22bd5fa6-46e3-5592-96b9-b09472d6e659" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{10}" :db/id #edb/ref 17592186557940} {:answer/id #uuid "acc98af6-0c0d-5c03-9cc8-ce22b28bc5a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186558209} {:answer/id #uuid "dc20887a-51b2-57bb-8eac-b5c6d40d238c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{10}" :db/id #edb/ref 17592186558301} {:answer/id #uuid "f49c2365-4c22-5026-b8ab-7656932789ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186558347}] :answer-field/correct {:db/id #edb/ref 17592186558301} :answer-field/id #uuid "b80b6de0-d629-5831-8a5c-74da1f4dac9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558446}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "85b49133-7772-5722-8e3e-dbe769864a2c" :question/math-academy-id "q-62061" :question/problem "A lake currently has a depth of $320$ feet. The depth of the lake is expected to decrease by one-tenth every year.\n\nThe function $d(t)$ models the depth of the lake after $t$ years and is given by\n\n$$\nd(t)=320\\cdot {(\\text{___})}^{t}.\n$$\n\nWhat number is missing?" :question/worked-solution "If the depth reduces by $\\frac{1}{10}$ every month, then $\\frac{9}{10}$ of the depth remains every year. So the decay factor is $\\frac{9}{10}.$\n\nThe formula for exponential decay (in terms of a decay factor $b$) is\n\n$$\nd(t)=a{b}^{t}.\n$$\n\nIn our case, we have the following:\n\n- $a=320$ is the initial depth.\n\n- $b=\\frac{9}{10}$ is the decay factor.\n\n- $t=$ the time, in years.\n\nTherefore, the correct expression for $d(t)$ is\n\n$$\nd(t)=320\\cdot {(\\frac{9}{10})}^{t}.\n$$\n\nSo the missing number is $\\frac{9}{10}.$"} :step/id #uuid "4812dcec-6a52-59bd-bb5b-c5e1a060a776"} {:db/id #edb/ref 17592186558659 :step/content {:db/id #edb/ref 17592186558525 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2adaf691-aa9c-5bc6-b97f-4fecc09a46b8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$14$ mg" :db/id #edb/ref 17592186557959} {:answer/id #uuid "31d63a7a-9931-5043-95f8-51d42fe3cd84" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$13$ mg" :db/id #edb/ref 17592186557969} {:answer/id #uuid "7dbb1c4d-d71a-536c-aae7-34b9dda5e56b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$7$ mg" :db/id #edb/ref 17592186558110} {:answer/id #uuid "dd65015e-d881-5c60-ad4b-103340e29f8e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$9$ mg" :db/id #edb/ref 17592186558304} {:answer/id #uuid "e4e9b59d-2751-5ad3-b00f-47582f8eab5e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$18$ mg" :db/id #edb/ref 17592186558323}] :answer-field/correct {:db/id #edb/ref 17592186558323} :answer-field/id #uuid "412474d7-c770-5c0d-8c2c-215a6bc5fac2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558384}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6c8488d4-9154-55d8-8e4c-cbf91ba1e38c" :question/math-academy-id "q-1418" :question/problem "An adult drinks a cup of coffee that contains $110$ mg of caffeine, and each hour the amount of caffeine in their body decreases by $15%.$ To the nearest integer, how much caffeine will be left in their system after $11$ hours?" :question/worked-solution "The formula for exponential decay (in terms of a decay rate $r$) is\n\n$$\ny=a(1-r)^{t}.\n$$\n\nIn our case, we have the following:\n\n- $a=110$ is the initial amount of caffeine in the adult's body.\n\n- $r=0.15$ is the decay rate ($15%$ expressed as a decimal).\n\n- $t=$ the time, in hours.\n\nTherefore, the correct expression for $y$ is\n\n$$\n\\begin{aligned}y & =110\\cdot (1-0.15)^{t} \\\\  & =110\\cdot (0.85)^{t}.\\end{aligned}\n$$\n\nEvaluating the expression for $t=11$ hours, we get\n\n$$\ny(11)=110\\cdot (0.85)^{11}≈18.\n$$\n\nHence, after $11$ hours, there will be $18$ mg of caffeine left in their system."} :step/id #uuid "9459a6e5-4631-59b7-af40-bc1c6ff0d9df" :step/next {:db/id #edb/ref 17592186558605}}] :activity/title "Modeling Exponential Decay With Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186557867}]}
