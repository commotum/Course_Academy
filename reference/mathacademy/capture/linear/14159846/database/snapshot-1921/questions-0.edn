#{[{:db/id #edb/ref 17592186068467 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068850 :knowledge-point/id #uuid "942732a6-ca14-5b61-b8fb-ab9ef81610cf" :knowledge-point/title "Finding the Cube Root of a Monomial"}] :question/id #uuid "2ca53a08-7b11-552c-983f-96e7a392156c" :question/math-academy-id "e-1357" :question/problem "Find $\\sqrt[3]{-8x^6}$." :question/worked-solution "We write the term under the radical as a perfect cube, and simplify:\n\n$$\n\\begin{aligned}\n\\sqrt[3]{-8x^{6}} &=  \\\\\n\\sqrt[3]{(-2x^{2}) \\cdot (-2x^{2}) \\cdot (-2x^{2})} &=  \\\\\n\\sqrt[3]{(-2x^{2})^{3}} &=  \\\\\n&= - 2x^{2}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068468 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068851 :knowledge-point/id #uuid "11c07788-b01d-5788-b2f1-0a027ea53cb2" :knowledge-point/title "Finding the Cube Root of a Fraction"}] :question/id #uuid "c52719a7-544b-5844-b716-9b9d2999c028" :question/math-academy-id "e-1358" :question/problem "Simplify $\\sqrt[3]{\\dfrac{a^3}{(b-1)^3}}$." :question/worked-solution "We write the term under the radical as a perfect cube, and simplify:\n\n$$\n\\begin{aligned}\n\\sqrt[3]{(a^{3})/((b - 1)^{3})} &=  \\\\\n\\sqrt[3]{(a)/((b - 1)) \\cdot (a)/((b - 1)) \\cdot (a)/((b - 1))} &=  \\\\\n\\sqrt[3]{(\\frac{a}{b - 1})^{3}} &=  \\\\\n&= \\frac{a}{b - 1}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068639 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068796 :knowledge-point/id #uuid "3979b4ea-910f-5037-b8e8-b0297f31c47c" :knowledge-point/title "Finding Cube Roots of Terms Containing Binomials"}] :question/id #uuid "ca60143b-d02c-5497-a134-56444304c2fa" :question/math-academy-id "e-7223" :question/problem "Simplify $\\sqrt[3]{(5x - 4)^3}$." :question/worked-solution "The expression underneath the radical is already a perfect cube. Therefore,\n\n$$\n\\begin{aligned}\n\\sqrt[3]{(5x - 4)^{3}} &= 5x - 4\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069427 :knowledge-point/_questions [{:db/id #edb/ref 17592186068796 :knowledge-point/id #uuid "3979b4ea-910f-5037-b8e8-b0297f31c47c" :knowledge-point/title "Finding Cube Roots of Terms Containing Binomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94cc95d5-efaf-5603-b7c2-acc3bdb3f0ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186067733} {:answer/id #uuid "a563e43e-1fa8-5820-bb4a-5b000405ebe0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8x" :db/id #edb/ref 17592186067734} {:answer/id #uuid "f13c9818-e5bd-5482-9a19-6a8273c58e0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{8x - 1}" :db/id #edb/ref 17592186067735} {:answer/id #uuid "0b0b96d9-0db2-5efe-8a1f-b20767212917" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x - 1" :db/id #edb/ref 17592186067736} {:answer/id #uuid "6fdf7801-387b-59b1-9efc-af9c3983c00e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt[3]{x} - 1" :db/id #edb/ref 17592186067737}] :answer-field/id #uuid "85561fb4-1f0b-5f3b-9176-f67b37ab173d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067732}] :question/id #uuid "f85c6ba2-7023-57fb-a7f0-f9cb4849e914" :question/math-academy-id "q-52514" :question/problem "Simplify $\\sqrt[3]{(2x - 1)^{3}}$."}]}
