#{[{:db/id #edb/ref 17592186068467 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068850 :knowledge-point/id #uuid "942732a6-ca14-5b61-b8fb-ab9ef81610cf" :knowledge-point/title "Finding the Cube Root of a Monomial"}] :question/id #uuid "2ca53a08-7b11-552c-983f-96e7a392156c" :question/math-academy-id "e-1357" :question/problem "Find $\\sqrt[3]{-8x^6}.$" :question/worked-solution "We write the term under the radical as a perfect cube, and simplify:\n\n$$\n\\begin{aligned}\\sqrt[3]{-8{x}^{6}} & = \\\\ \\sqrt[3]{(-2{x}^{2})\\cdot (-2{x}^{2})\\cdot (-2{x}^{2})} & = \\\\ \\sqrt[3]{(-2{x}^{2})^{3}} & = \\\\ -2{x}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068468 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068851 :knowledge-point/id #uuid "11c07788-b01d-5788-b2f1-0a027ea53cb2" :knowledge-point/title "Finding the Cube Root of a Fraction"}] :question/id #uuid "c52719a7-544b-5844-b716-9b9d2999c028" :question/math-academy-id "e-1358" :question/problem "Simplify $\\sqrt[3]{\\dfrac{a^3}{(b-1)^3}}.$" :question/worked-solution "We write the term under the radical as a perfect cube, and simplify:\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{{a}^{3}}{(b-1)^{3}}} & = \\\\ \\sqrt[3]{\\frac{a}{(b-1)}\\cdot \\frac{a}{(b-1)}\\cdot \\frac{a}{(b-1)}} & = \\\\ \\sqrt[3]{{(\\frac{a}{b-1})}^{3}} & = \\\\ \\frac{a}{b-1}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068639 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068796 :knowledge-point/id #uuid "3979b4ea-910f-5037-b8e8-b0297f31c47c" :knowledge-point/title "Finding Cube Roots of Terms Containing Binomials"}] :question/id #uuid "ca60143b-d02c-5497-a134-56444304c2fa" :question/math-academy-id "e-7223" :question/problem "Simplify $\\sqrt[3]{(5x - 4)^3}.$" :question/worked-solution "The expression underneath the radical is already a perfect cube. Therefore,\n\n$$\n\\begin{aligned}\\sqrt[3]{(5x-4)^{3}} & =5x-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186484217 :knowledge-point/_questions [