wer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{3}}{p}" :db/id #edb/ref 17592186484035}] :answer-field/correct {:answer/id #uuid "ca887def-b645-5ef1-a8a1-7be7ba8b5454" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{{p}^{2}}" :db/id #edb/ref 17592186483971} :answer-field/id #uuid "161e2489-910a-5447-9f86-73a13b031f89" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186484092}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fe75fff3-f9bd-5fd1-9943-ab7910546025" :question/math-academy-id "q-82158" :question/problem "Find $\\sqrt[3]{\\frac{{x}^{6}}{{p}^{6}}}.$" :question/worked-solution "To simplify the expression, we write the term under the radical as a perfect cube, and simplify:\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{{x}^{6}}{{p}^{6}}} & = \\\\ \\sqrt[3]{(\\frac{{x}^{2}}{{p}^{2}})\\cdot (\\frac{{x}^{2}}{{p}^{2}})\\cdot (\\frac{{x}^{2}}{{p}^{2}})} & = \\\\ \\sqrt[3]{{(\\frac{{x}^{2}}{{p}^{2}})}^{3}} & = \\\\ \\frac{{x}^{2}}{{p}^{2}}\\end{aligned}\n$$"}]}
