:db/id #edb/ref 17592186484120}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a86cd21a-bd7e-5314-bf81-48804b9affac" :question/math-academy-id "q-82153" :question/problem "Simplify $\\sqrt[3]{125(x+8y)^{3}}.$" :question/worked-solution "To simplify the expression, we write the term under the radical as a perfect cube, and simplify:\n\n$$\n\\begin{aligned}\\sqrt[3]{125(x+8y)^{3}} & = \\\\ \\sqrt[3]{5(x+8y)\\cdot 5(x+8y)\\cdot 5(x+8y)} & = \\\\ \\sqrt[3]{{(5(x+8y))}^{3}} & = \\\\ 5(x+8y)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186484266 :knowledge-point/_questions [{:db/id #edb/ref 17592186068851 :knowledge-point/id #uuid "11c07788-b01d-5788-b2f1-0a027ea53cb2" :knowledge-point/title "Finding the Cube Root of a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a41c020-4ee4-5481-b86e-95d2d7b1efb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{(3-x)^{2}}" :db/id #edb/ref 17592186483699} {:answer/id #uuid "755dad48-bba6-521d-b6b1-4c1792b0fde6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{(3-x)}" :db/id #edb/ref 17592186483804} {:answer/id #uuid "7d3024b4-aff7-5c39-87b9-27adafd22f9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{(3-x)^{2}}" :db/id #edb/ref 17592186483821} {:answer/id #uuid "c9e7c6ec-11ff-55ed-94bd-3c2dc2afe7e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{(3-x)}" :db/id #edb/ref 17592186483968} {:answer/id #uuid "d5d4928e-8cb5-55fe-95ef-93b9144c043b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{(3-x)}" :db/id #edb/ref 17592186483993}] :answer-field/correct {:answer/id #uuid "d5d4928e-8cb5-55fe-95ef-93b9144c043b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/