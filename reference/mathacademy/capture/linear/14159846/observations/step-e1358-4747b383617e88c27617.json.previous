{
  "dom_id": "step-e1358",
  "name": "Example: Finding the Cube Root of a Fraction",
  "problem": "Simplify $\\sqrt[3]{\\dfrac{a^3}{(b-1)^3}}.$",
  "worked_solution": "We write the term under the radical as a perfect cube, and simplify:\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{{a}^{3}}{(b-1)^{3}}} & = \\\\ \\sqrt[3]{\\frac{a}{(b-1)}\\cdot \\frac{a}{(b-1)}\\cdot \\frac{a}{(b-1)}} & = \\\\ \\sqrt[3]{{(\\frac{a}{b-1})}^{3}} & = \\\\ \\frac{a}{b-1}\\end{aligned}\n$$",
  "calculator_instructions": "",
  "fields": [],
  "problem_field_keys": [],
  "answer_fields_complete": null,
  "result": null,
  "proof_feedback": null,
