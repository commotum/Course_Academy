N-32\" x=\"809\" y=\"408\"></use>\n</g>\n <use xlink:href=\"#E22-MJMAIN-3D\" x=\"2137\" y=\"0\"></use>\n <use xlink:href=\"#E22-MJMAIN-7C\" x=\"3193\" y=\"0\"></use>\n <use xlink:href=\"#E22-MJMATHI-78\" x=\"3472\" y=\"0\"></use>\n <use xlink:href=\"#E22-MJMAIN-7C\" x=\"4044\" y=\"0\"></use>\n <use xlink:href=\"#E22-MJMAIN-2C\" x=\"4323\" y=\"0\"></use>\n</g>\n</svg></span> but for cube roots, we have <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"9.395ex\" height=\"3.009ex\" style=\"vertical-align: -0.505ex;\" viewBox=\"0 -1078.4 4045 1295.7\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-23-Title\">\n<title id=\"MathJax-SVG-23-Title\">\\sqrt[3]{x^3} = x.</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E23-MJMATHI-78\" d=\"M52 289Q59 331 106 386T222 442Q257 442 286 424T329 379Q371 442 430 442Q467 442 494 420T522 361Q522 332 508 314T481 292T458 288Q439 288 427 299T415 328Q415 374 465 391Q454 404 425 404Q412 404 406 402Q368 386 350 336Q290 115 290 78Q290 50 306 38T341 26Q378 26 414 59T463 140Q466 150 469 151T485 153H489Q504 153 504 145Q504 144 502 134Q486 77 440 33T333 -11Q263 -11 227 52Q186 -10 133 -10H127Q78 -10 57 16T35 71Q35 103 54 123T99 143Q142 143 142 101Q142 81 130 66T107 46T94 41L91 40Q91 39 97 36T113 29T132 26Q168 26 194 71Q203 87 217 139T245 247T261 313Q266 340 266 352Q266 380 251 392T217 404Q177 404 142 372T93 290Q91 281 88 280T72 278H58Q52 284 52 289Z\"></path>\n<path stroke-width=\"1\" id=\"E23-MJMAIN-33\" d=\"M127 463Q100 463 85 480T69 524Q69 579 117 622T233 665Q268 665 277 664Q351 652 390 611T430 522Q430 470 396 421T302 350L299 348Q299 347 308 345T337 336T375 315Q457 262 457 175Q457 96 395 37T238 -22Q158 -22 100 21T42 130Q42 158 60 175T105 193Q133 193 151 175T169 130Q169 119 166 110T159 94T148 82T136 74T126 70T118 67L114 66Q165 21 238 21Q293 21 321 74Q338 107 338 175V195Q338 290 274 322Q259 328 213 329L171 330L168 332Q166 335 166 348Q166 366 174 366Q202 366 232 371Q266 376 294 413T322 525V533Q322 590 287 612Q265 626 240 626Q208 626 181 615T143 592T132 580H135Q138 579 143 578T153 573T165 566T175 555T183 540T186 520Q186 498 172 481T127 463Z\"></path>\n<path stroke-width=\"1\" id=\"E23-MJMAIN-221A\" d=\"M95 178Q89 178 81 186T72 200T103 230T169 280T207 309Q209 311 212 311H213Q219 311 227 294T281 177Q300 134 312 108L397 -77Q398 -77 501 136T707 565T814 786Q820 800 834 800Q841 800 846 794T853 782V776L620 293L385 -193Q381 -200 366 -200Q357 -200 354 -197Q352 -195 256 15L160 225L144 214Q129 202 113 190T95 178Z\"></path>\n<path stroke-width=\"1\" id=\"E23-MJMAIN-3D\" d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\"></path>\n<path stroke-width=\"1\" id=\"E23-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use transform=\"scale(0.574)\" xlink:href=\"#E23-MJMAIN-33\" x=\"486\" y=\"914\"></use>\n <use xlink:href=\"#E23-MJMAIN-221A\" x=\"0\" y=\"80\"></use>\n<rect stroke=\"none\" width=\"1026\" height=\"60\" x=\"833\" y=\"821\"></rect>\n<g transform=\"translate(833,0)\">\n <use xlink:href=\"#E23-MJMATHI-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E23-MJMAIN-33\" x=\"809\" y=\"408\"></use>\n</g>\n <use xlink:href=\"#E23-MJMAIN-3D\" x=\"2137\" y=\"0\"></use>\n <use xlink:href=\"#E23-MJMATHI-78\" x=\"3193\" y=\"0\"></use>\n <use xlink:href=\"#E23-MJMAIN-2E\" x=\"3766\" y=\"0\"></use>\n</g>\n</svg></span> No absolute value is needed for cube roots, because</p>\n<ul>\n<li><p>the cube root of a positive number is a positive number, and</p>\n</li>\n<li><p>the cube root of a negative number is a negative number.</p>\n</li>\n</ul>\n           \n                </div>        \n             