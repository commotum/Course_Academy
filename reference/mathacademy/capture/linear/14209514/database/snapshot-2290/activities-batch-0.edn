#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186069651} :activity/id #uuid "484aecae-ce38-5933-8c1b-d7a4869c93b3" :activity/scope {:db/id #edb/ref 17592186048369 :topic/id #uuid "99e1fe28-92a1-545f-8ee9-b78506123551" :topic/math-academy-id 469} :activity/steps [{:db/id #edb/ref 17592186069651 :step/content {:db/id #edb/ref 17592186069968 :tutorial/content "A **root** of a polynomial is a value that will make the polynomial equal zero when substituted for the polynomial's variable.\n\nFor example, consider the polynomial $x^2-9.$ This polynomial has two roots, $x=3$ and $x=-3,$ because the polynomial evaluates to $0$ when either of these values is substituted for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}x=3\\,⇒\\,{x}^{2}-9 & = \\\\ (3)^{2}-9 & = \\\\ 9-9 & = \\\\ 0 & \\,✓ \\\\ x=-3\\,⇒\\,{x}^{2}-9 & = \\\\ (-3)^{2}-9 & = \\\\ 9-9 & = \\\\ 0 & \\,✓\\end{aligned}\n$$\n\nOn the other hand, a number like $x=1$ is *not* a root of the polynomial because the polynomial does not evaluate to $0$ when this value is substituted for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}x=1\\,⇒\\,{x}^{2}-9 & = \\\\ (1)^{2}-9 & = \\\\ 1-9 & = \\\\ -8 & \\,\\times \\end{aligned}\n$$" :tutorial/id #uuid "5b765b45-ae0c-5c2f-958b-e69d41100abc" :tutorial/math-academy-id 3321 :tutorial/title "Introduction"} :step/id #uuid "7bf976d5-f5da-5111-a8db-afd7667d6464" :step/math-academy-id 18472 :step/next {:db/id #edb/ref 17592186069652}} {:db/id #edb/ref 17592186069652 :step/content {:db/id #edb/ref 17592186068749 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068582 :question/id #uuid "4968972d-3bc9-5100-aa70-46213e0c3581" :question/math-academy-id "e-5028"} :knowledge-point/id #uuid "2b680bd3-e1e3-5ff5-ade3-39977cbdaaf7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049472}] :knowledge-point/questions [{:db/id #edb/ref 17592186069303} {:db/id #edb/ref 17592186069316} {:db/id #edb/ref 17592186514357}] :knowledge-point/title "Identifying Values that are Roots of a Given Polynomial"} :step/id #uuid "43f1293f-5871-5104-98bf-b58f5a85bbdc" :step/math-academy-id 18473 :step/next {:db/id #edb/ref 17592186069653}} {:db/id #edb/ref 17592186069653 :step/content {:db/id #edb/ref 17592186069969 :tutorial/content "A **parametric polynomial** is a polynomial in which one of the coefficients is itself represented as another variable.\n\nFor example, the polynomial below is a parametric polynomial:\n\n$$\nf(x)=2x^2 -px\n$$\n\nHere, $p$ is a **parameter**,  which means that it corresponds to a certain constant value. Unlike the variable $x,$ the parameter is treated exactly like any other coefficient. It's only special in that we don't know its numerical value.\n\nIf we're given the root of a polynomial, we can find the numerical value of a parameter. Let's say, for instance, that a root of the above polynomial is $x=1.$ This means that the polynomial is zero for that value:\n\n$$\nf(1)=0\n$$\n\nTherefore, we can evaluate the polynomial at $x=1,$ set it equal to $0,$ and solve the equation for the parameter $p\\mathbin{:}$\n\n$$\n\\begin{aligned}f(1) & =0 \\\\ 2(1)^{2}-p(1) & =0 \\\\ 2-p & =0 \\\\ p & =2\\end{aligned}\n$$" :tutorial/id #uuid "91fb2858-964a-50e9-a2fc-ae2af84b6b20" :tutorial/math-academy-id 3322 :tutorial/title "Solving for an Unknown Parameter Given the Root of a Polynomial"} :step/id #uuid "b2f6b6b9-edee-5a14-9900-fb89f4ef499a" :step/math-academy-id 18475 :step/next {:db/id #edb/ref 17592186069654}} {:db/id #edb/ref 17592186069654 :step/content {:db/id #edb/ref 17592186068750 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068583 :question/id #uuid "c1830274-3260-5bf5-aef1-c855a89efbf2" :question/math-academy-id "e-5030"} :knowledge-point/id #uuid "9328cc9a-2e6c-5ac2-bae4-f02c86fe9d29" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673}] :knowledge-point/questions [{:db/id #edb/ref 17592186069060} {:db/id #edb/ref 17592186069305} {:db/id #edb/ref 17592186234129} {:db/id #edb/ref 17592186514421}] :knowledge-point/title "Solving for an Unknown Parameter Given the Root of a Polynomial"} :step/id #uuid "7174685e-b638-5eb0-a858-a847b1762b27" :step/math-academy-id 18476}] :activity/title "Determining the Roots of Polynomials" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068994}]}
