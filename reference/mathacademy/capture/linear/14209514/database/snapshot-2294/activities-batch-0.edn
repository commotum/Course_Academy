#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186069651} :activity/id #uuid "484aecae-ce38-5933-8c1b-d7a4869c93b3" :activity/scope {:db/id #edb/ref 17592186048369 :topic/id #uuid "99e1fe28-92a1-545f-8ee9-b78506123551" :topic/math-academy-id 469} :activity/steps [{:db/id #edb/ref 17592186069651 :step/content {:db/id #edb/ref 17592186069968 :tutorial/content "A **root** of a polynomial is a value that will make the polynomial equal zero when substituted for the polynomial's variable.\n\nFor example, consider the polynomial $x^2-9.$ This polynomial has two roots, $x=3$ and $x=-3,$ because the polynomial evaluates to $0$ when either of these values is substituted for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}x=3\\,⇒\\,{x}^{2}-9 & = \\\\ (3)^{2}-9 & = \\\\ 9-9 & = \\\\ 0 & \\,✓ \\\\ x=-3\\,⇒\\,{x}^{2}-9 & = \\\\ (-3)^{2}-9 & = \\\\ 9-9 & = \\\\ 0 & \\,✓\\end{aligned}\n$$\n\nOn the other hand, a number like $x=1$ is *not* a root of the polynomial because the polynomial does not evaluate to $0$ when this value is substituted for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}x=1\\,⇒\\,{x}^{2}-9 & = \\\\ (1)^{2}-9 & = \\\\ 1-9 & = \\\\ -8 & \\,\\times \\end{aligned}\n$$" :tutorial/id #uuid "5b765b45-ae0c-5c2f-958b-e69d41100abc" :tutorial/math-academy-id 3321 :tutorial/title "Introduction"} :step/id #uuid "7bf976d5-f5da-5111-a8db-afd7667d6464" :step/math-academy-id 18472 :step/next {:db/id #edb/ref 17592186069652}} {:db/id #edb/ref 17592186069652 :step/content {:db/id #edb/ref 17592186068749 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068582 :question/id #uuid "4968972d-3bc9-5100-aa70-46213e0c3581" :question/math-academy-id "e-5028"} :knowledge-point/id #uuid "2b680bd3-e1e3-5ff5-ade3-39977cbdaaf7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049472}] :knowledge-point/questions [{:db/id #edb/ref 17592186069303} {:db/id #edb/ref 17592186069316} {:db/id #edb/ref 17592186514357}] :knowledge-point/title "Identifying Values that are Roots of a Given Polynomial"} :step/id #uuid "43f1293f-5871-5104-98bf-b58f5a85bbdc" :step/math-academy-id 18473 :step/next {:db/id #edb/ref 17592186069653}} {:db/id #edb/ref 17592186069653 :step/content {:db/id #edb/ref 17592186069969 :tutorial/content "A **parametric polynomial** is a polynomial in which one of the coefficients is itself represented as another variable.\n\nFor example, the polynomial below is a parametric polynomial:\n\n$$\nf(x)=2x^2 -px\n$$\n\nHere, $p$ is a **parameter**,  which means that it corresponds to a certain constant value. Unlike the variable $x,$ the parameter is treated exactly like any other coefficient. It's only special in that we don't know its numerical value.\n\nIf we're given the root of a polynomial, we can find the numerical value of a parameter. Let's say, for instance, that a root of the above polynomial is $x=1.$ This means that the polynomial is zero for that value:\n\n$$\nf(1)=0\n$$\n\nTherefore, we can evaluate the polynomial at $x=1,$ set it equal to $0,$ and solve the equation for the parameter $p\\mathbin{:}$\n\n$$\n\\begin{aligned}f(1) & =0 \\\\ 2(1)^{2}-p(1) & =0 \\\\ 2-p & =0 \\\\ p & =2\\end{aligned}\n$$" :tutorial/id #uuid "91fb2858-964a-50e9-a2fc-ae2af84b6b20" :tutorial/math-academy-id 3322 :tutorial/title "Solving for an Unknown Parameter Given the Root of a Polynomial"} :step/id #uuid "b2f6b6b9-edee-5a14-9900-fb89f4ef499a" :step/math-academy-id 18475 :step/next {:db/id #edb/ref 17592186069654}} {:db/id #edb/ref 17592186069654 :step/content {:db/id #edb/ref 17592186068750 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068583 :question/id #uuid "c1830274-3260-5bf5-aef1-c855a89efbf2" :question/math-academy-id "e-5030"} :knowledge-point/id #uuid "9328cc9a-2e6c-5ac2-bae4-f02c86fe9d29" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673}] :knowledge-point/questions [{:db/id #edb/ref 17592186069060} {:db/id #edb/ref 17592186069305} {:db/id #edb/ref 17592186234129} {:db/id #edb/ref 17592186514421} {:db/id #edb/ref 17592186522760} {:db/id #edb/ref 17592186522786} {:db/id #edb/ref 17592186522789}] :knowledge-point/title "Solving for an Unknown Parameter Given the Root of a Polynomial"} :step/id #uuid "7174685e-b638-5eb0-a858-a847b1762b27" :step/math-academy-id 18476}] :activity/title "Determining the Roots of Polynomials" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068994}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186522825} :activity/id #uuid "e7cdfaae-9f34-5e4f-854e-c1d607458903" :activity/scope {:db/id #edb/ref 17592186048369 :topic/id #uuid "99e1fe28-92a1-545f-8ee9-b78506123551" :topic/math-academy-id 469} :activity/steps [{:db/id #edb/ref 17592186522822 :step/content {:db/id #edb/ref 17592186522789 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8141248f-ae02-59d5-9985-216116e2a8e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=-3" :db/id #edb/ref 17592186522278} {:answer/id #uuid "a5e33f54-5f9e-5175-b0c7-6035f1211b8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=3" :db/id #edb/ref 17592186522370} {:answer/id #uuid "c30cf463-743f-5343-9b3b-e2b54d327e16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=9" :db/id #edb/ref 17592186522428} {:answer/id #uuid "d4dbce40-8e28-5d99-a914-1fc7bae9ef3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=1" :db/id #edb/ref 17592186522461} {:answer/id #uuid "de6f2964-ee7a-5958-a213-8d1216e4287b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=-6" :db/id #edb/ref 17592186522487}] :answer-field/correct {:db/id #edb/ref 17592186522428} :answer-field/id #uuid "59e0a079-1230-556b-88e6-09520bd04216" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186522606}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d718b4fe-ac83-5ded-9cff-9bf61a11c436" :question/math-academy-id "q-14238" :question/problem "Find $k$ if $2$ is a root of $f(x)={x}^{4}+k{x}^{3}-7{x}^{2}-57x+6k.$" :question/worked-solution "Since  $x=2$ is a root, we have $f(2)=0.$ Therefore, we can evaluate the polynomial at $x=2,$ set it equal to $0,$ and solve the equation for the parameter $k:$\n\n$$\n\\begin{aligned}(2)^{4}+k(2)^{3}-7(2)^{2}-57(2)+6k & =0 \\\\ 16+8k-28-114+6k & =0 \\\\ 14k-126 & =0 \\\\ 14k & =126 \\\\ k & =9\\end{aligned}\n$$"} :step/id #uuid "149763fa-fcc2-55ff-bbcd-e8ae22afe33e"} {:db/id #edb/ref 17592186522825 :step/content {:db/id #edb/ref 17592186522760 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "027f0819-c021-5635-b7d1-21f53a81eb36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=3" :db/id #edb/ref 17592186522018} {:answer/id #uuid "16c11ec4-ff0c-5c06-86de-a5fdbf8b9db1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=4" :db/id #edb/ref 17592186522067} {:answer/id #uuid "2bc0013d-319f-5abd-b000-4099afd2ca7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=2" :db/id #edb/ref 17592186522117} {:answer/id #uuid "a670b93b-9bea-55ed-97fc-24e49d5de5cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=0" :db/id #edb/ref 17592186522371} {:answer/id #uuid "c210b6d6-4799-5836-860c-3d8f72c0f36e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=6" :db/id #edb/ref 17592186522425}] :answer-field/correct {:db/id #edb/ref 17592186522067} :answer-field/id #uuid "9a0a44b2-6e7c-58bd-8a08-7b91d747ebd4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186522636}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "940f3759-8774-576e-891c-0f76989295c4" :question/math-academy-id "q-14194" :question/problem "Find $p$ if $-2$ is a root of $f(x)=5{x}^{2}+6x-2p.$" :question/worked-solution "Since  $x=-2$ is a root, we have $f(-2)=0.$ Therefore, we can evaluate the polynomial at $x=-2,$ set it equal to $0,$ and solve the equation for the parameter $p:$\n\n$$\n\\begin{aligned}5(-2)^{2}+6(-2)-2p & =0 \\\\ 20-12-2p & =0 \\\\ 8-2p & =0 \\\\ -2p & =-8 \\\\ p & =4\\end{aligned}\n$$"} :step/id #uuid "23d9f834-3911-510e-bae1-ec6c30e48281" :step/next {:db/id #edb/ref 17592186522886}} {:db/id #edb/ref 17592186522886 :step/content {:db/id #edb/ref 17592186522786 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "127d7eca-f156-5581-bb3f-5909c3e3a681" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=-9" :db/id #edb/ref 17592186522057} {:answer/id #uuid "2f612688-2f3d-57bb-9415-7a91d68a847c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=-2" :db/id #edb/ref 17592186522124} {:answer/id #uuid "5b55e4a9-5374-5c37-bb1e-cee774d9b81e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=\\frac{1}{3}" :db/id #edb/ref 17592186522206} {:answer/id #uuid "74efa23a-d4f4-5131-99b2-7c1b585da360" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=1" :db/id #edb/ref 17592186522250} {:answer/id #uuid "f9994e31-f0b7-5d6f-8912-7380e35bb9c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=3" :db/id #edb/ref 17592186522547}] :answer-field/correct {:db/id #edb/ref 17592186522206} :answer-field/id #uuid "075758a5-0cef-58d0-bf2e-50db1a582ad6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186522558}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d2b7c3bc-8988-5881-96d5-877a27dfd407" :question/math-academy-id "q-14203" :question/problem "Find $p$ if $-2$ is a root of $f(x)=3p{x}^{2}-21px-18.$" :question/worked-solution "Since  $x=-2$ is a root, we have $f(-2)=0.$ Therefore, we can evaluate the polynomial at $x=-2,$ set it equal to $0,$ and solve the equation for the parameter $p:$\n\n$$\n\\begin{aligned}3p(-2)^{2}-21p(-2)-18 & =0 \\\\ 12p+42p-18 & =0 \\\\ 54p-18 & =0 \\\\ 54p & =18 \\\\ p & =\\frac{1}{3}\\end{aligned}\n$$"} :step/id #uuid "df6a6199-b720-581e-9425-82f1d00b1651" :step/next {:db/id #edb/ref 17592186522822}}] :activity/title "Determining the Roots of Polynomials" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186522013}]}
