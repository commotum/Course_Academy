ial at $x=-2,$ set it equal to $0,$ and solve the equation for the parameter $p:$\n\n$$\n\\begin{aligned}5(-2)^{2}+6(-2)-2p & =0 \\\\ 20-12-2p & =0 \\\\ 8-2p & =0 \\\\ -2p & =-8 \\\\ p & =4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186522786 :knowledge-point/_questions [{:db/id #edb/ref 17592186068750 :knowledge-point/id #uuid "9328cc9a-2e6c-5ac2-bae4-f02c86fe9d29" :knowledge-point/title "Solving for an Unknown Parameter Given the Root of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "127d7eca-f156-5581-bb3f-5909c3e3a681" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-9" :db/id #edb/ref 17592186522057} {:answer/id #uuid "2f612688-2f3d-57bb-9415-7a91d68a847c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-2" :db/id #edb/ref 17592186522124} {:answer/id #uuid "5b55e4a9-5374-5c37-bb1e-cee774d9b81e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=\\frac{1}{3}" :db/id #edb/ref 17592186522206} {:answer/id #uuid "74efa23a-d4f4-5131-99b2-7c1b585da360" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=1" :db/id #edb/ref 17592186522250} {:answer/id #uuid "f9994e31-f0b7-5d6f-8912-7380e35bb9c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3" :db/id #edb/ref 17592186522547}] :answer-field/correct {:answer/id #uuid "5b55e4a9-5374-5c37-bb1e-cee774d9b81e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=\\frac{1}{3}" :db/id #edb/ref 17592186522206} :answer-field/id #uuid "075758a5-0cef-58d0-bf2e-50db1a582ad6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522558}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d2b7c3bc-8988-5881-96d5