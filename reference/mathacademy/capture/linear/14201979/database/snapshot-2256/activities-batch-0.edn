#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074871} :activity/id #uuid "6d7f90a6-7b6b-52db-bbf3-10269a41623a" :activity/scope {:db/id #edb/ref 17592186050481 :topic/id #uuid "4d30ea10-ea6d-511a-a7e5-cce5fffa2a64" :topic/math-academy-id 552} :activity/steps [{:db/id #edb/ref 17592186074723 :step/content {:db/id #edb/ref 17592186073786 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073658 :question/id #uuid "b3b354ef-26fc-55dc-acdd-4b28c5f273ef" :question/math-academy-id "e-8139"} :knowledge-point/id #uuid "b6a21dbe-0674-5fa2-b3ee-e4069115c6be" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050924}] :knowledge-point/questions [{:db/id #edb/ref 17592186074382} {:db/id #edb/ref 17592186074383} {:db/id #edb/ref 17592186434577} {:db/id #edb/ref 17592186434578} {:db/id #edb/ref 17592186434580} {:db/id #edb/ref 17592186434585} {:db/id #edb/ref 17592186434586} {:db/id #edb/ref 17592186515588} {:db/id #edb/ref 17592186518169} {:db/id #edb/ref 17592186518172}] :knowledge-point/title "Writing a Ratio as a Fraction"} :step/id #uuid "1c6ef1b8-edb3-5545-930a-73cc7c32d2b9" :step/math-academy-id 30450 :step/next {:db/id #edb/ref 17592186074872}} {:db/id #edb/ref 17592186074871 :step/content {:db/id #edb/ref 17592186074966 :tutorial/content "We can write ratios as fractions by placing the first number over the second number.\n\nSo, what ratio describes the number of rectangles to triangles below?\n\n![](images/25/25426db008d4b246f36959f51433e0a5cebe609fc01f9539d4f45af353919261.png)\n\nFirst, we count the number of rectangles. We see that there are $\\color{blue}4$ rectangles.\n\nThen, we count the number of triangles. We see that there are $\\color{red}3$ triangles.\n\nSo the ratio of rectangles to triangles is ${\\color{blue}4}:{\\color{red}3}.$ As a fraction, this is $\\dfrac{\\color{blue}4}{\\color{red}3}.$\n\nWe interpret this number to mean that there are $\\dfrac{\\color{blue}4}{\\color{red}3}$ rectangles for each triangle." :tutorial/id #uuid "d0b88e38-94c5-52f0-8b5d-de261fe7f82e" :tutorial/math-academy-id 2047 :tutorial/title "Introduction"} :step/id #uuid "710f2d4c-d273-5b72-9ccc-f38b8242da5e" :step/math-academy-id 7777 :step/next {:db/id #edb/ref 17592186074723}} {:db/id #edb/ref 17592186074872 :step/content {:db/id #edb/ref 17592186073879 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073558 :question/id #uuid "44e1e2da-6e2f-50b1-b982-dd5d4b5a432c" :question/math-academy-id "e-2265"} :knowledge-point/id #uuid "6e191386-9391-5e3c-9f2f-f17d55f9b6ca" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048508} {:db/id #edb/ref 17592186050078}] :knowledge-point/questions [{:db/id #edb/ref 17592186074380} {:db/id #edb/ref 17592186074427} {:db/id #edb/ref 17592186424823} {:db/id #edb/ref 17592186434579} {:db/id #edb/ref 17592186434582} {:db/id #edb/ref 17592186434583} {:db/id #edb/ref 17592186484232} {:db/id #edb/ref 17592186484255} {:db/id #edb/ref 17592186484280} {:db/id #edb/ref 17592186518106}] :knowledge-point/title "Completing a Statement Describing a Ratio as a Fraction"} :step/id #uuid "ac944726-318f-5b1c-a830-c224ef6cc5c8" :step/math-academy-id 7778 :step/next {:db/id #edb/ref 17592186074873}} {:db/id #edb/ref 17592186074873 :step/content {:db/id #edb/ref 17592186073880 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073559 :question/id #uuid "cd725418-654f-5cb2-a77a-9f6f9ed27825" :question/math-academy-id "e-2267"} :knowledge-point/id #uuid "7435b531-e922-5db5-8140-463b7e66dd64" :knowledge-point/questions [{:db/id #edb/ref 17592186074381} {:db/id #edb/ref 17592186074425} {:db/id #edb/ref 17592186434581} {:db/id #edb/ref 17592186434584} {:db/id #edb/ref 17592186434587} {:db/id #edb/ref 17592186484228} {:db/id #edb/ref 17592186484230} {:db/id #edb/ref 17592186518223}] :knowledge-point/title "Completing a Statement by Interpreting a Fraction as a Ratio"} :step/id #uuid "94e66fd6-c348-57bd-ad13-f242226deafe" :step/math-academy-id 7780}]