#{[{:db/id #edb/ref 17592186179539 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179680 :knowledge-point/id #uuid "f1e9abbc-b0b5-51a6-b23b-a32a027382f3" :knowledge-point/title "Solving Equations Containing an Expression Raised to an Odd Power"}] :question/id #uuid "20f6391d-7ada-51b2-a384-f12a31a622c7" :question/math-academy-id "e-8053" :question/problem "Find the real solution to the equation $5(x-6)^7 = 640.$" :question/worked-solution "We can solve this equation by isolating the $(x-6)^7$ term and then taking the $7$th root of each side.\n\nFirst, let's isolate the $(x-6)^7$ term on the left-hand side:\n\n$$\n\\begin{aligned}5(x-6)^{7} & =640 \\\\ (x-6)^{7} & =128\\end{aligned}\n$$\n\nNow, we take the $7$th root of each side and solve for $x.$ Since $n=7$ is odd, there is only one real solution to this equation:\n\n$$\n\\begin{aligned}(x-6)^{7} & =128 \\\\ \\sqrt[7]{(x-6)^{7}} & =\\sqrt[7]{128} \\\\ x-6 & =\\sqrt[7]{{2}^{7}} \\\\ x-6 & =2 \\\\ x & =8\\end{aligned}\n$$\n\nTherefore, the solution is $x=8.$"}] [{:db/id #edb/ref 17592186179540 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179681 :knowledge-point/id #uuid "98f98657-c9c6-5b38-825c-992bcf28d9e3" :knowledge-point/title "Solving Equations With Odd Exponents"}] :question/id #uuid "26f0aea2-1440-5e96-9013-8238214b4966" :question/math-academy-id "e-8065" :question/problem "Find the real solution to the equation $96x^5=3.$" :question/worked-solution "We can solve this equation by isolating the $x^5$ term and then taking the $5$th root of each side.\n\nFirst, let's isolate the $x^5$ term on the left-hand side:\n\n$$\n\\begin{aligned}96{x}^{5} & =3 \\\\ {x}^{5} & =\\frac{1}{32}\\end{aligned}\n$$\n\nNow, we take the $5$th root of each side and solve for $x.$ Since $n=5$ is odd, there is only one real solution to this equation:\n\n$$\n\\begin{aligned}{x}^{5} & =\\frac{1}{32} \\\\ \\sqrt[5]{{x}^{5}} & =\\sqrt[5]{\\frac{1}{32}} \\\\ x & =\\sqrt[5]{{(\\frac{1}{2})}^{5}} \\\\ x & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the solution is $x=\\dfrac12.$"}] [{:db/id #edb/ref 17592186501224 :knowledge-point/_questions [{:db/id #edb/ref 17592186179681 :knowledge-point/id #uuid "98f98657-c9c6-5b38-825c-992bcf28d9e3" :knowledge-point/title "Solving Equations With Odd Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ac74bf1-c829-5e81-ba8e-4fd203c6336e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186500487} {:answer/id #uuid "58ff20e3-a059-5a2b-b7c3-904742a44ac1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186500649} {:answer/id #uuid "6267fb3f-a1e1-5114-a6e0-3d532383b112" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186500672} {:answer/id #uuid "9d4994a8-8333-5b8c-aaa0-7166a9d9eff9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is no real solution" :db/id #edb/ref 17592186500786} {:answer/id #uuid "d2964b1e-1e01-5aae-90ce-23893971c637" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186500917}] :answer-field/correct {:answer/id #uuid "6267fb3f-a1e1-5114-a6e0-3d532383b112" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186500672} :answer-field/id #uuid "a526f7fb-2163-5bae-a670-b1a0e921b3ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501093}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cb6a3551-b7c8-5448-9dd7-361a94a204ac" :question/math-academy-id "q-111446" :question/problem "Find the real solution to the equation ${x}^{3}=-512.$" :question/worked-solution "We can solve this equation by taking the $3$rd root of each side and solving for $x.$ Since $n=3$ is odd, there is only one real solution to this equation:\n\n$$\n\\begin{aligned}{x}^{3} & =-512 \\\\ \\sqrt[3]{{x}^{3}} & =\\sqrt[3]{-512} \\\\ x & =\\sqrt[3]{(-8)^{3}} \\\\ x & =-8\\end{aligned}\n$$\n\nTherefore, the solution is $x=-8.$"}] [{:db/id #edb/ref 17592186501229 :knowledge-point/_questions [{:db/id #edb/ref 17592186179680 :knowledge-point/id #uuid "f1e9abbc-b0b5-51a6-b23b-a32a027382f3" :knowledge-point/title "Solving Equations Containing an Expression Raised to an Odd Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b38477e-8cf2-57e3-940f-0e89aacc7ff2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186500554} {:answer/id #uuid "61d11fcf-2a35-5855-bdae-7f327a075eb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186500668} {:answer/id #uuid "6e6fd3ad-fa63-5890-9408-650907686585" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186500691} {:answer/id #uuid "ad6b9e59-a711-5b03-a42f-7d2aaa7209c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186500826} {:answer/id #uuid "c4d00532-1734-576c-bad9-0b15fbfc48f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186500882}] :answer-field/correct {:answer/id #uuid "61d11fcf-2a35-5855-bdae-7f327a075eb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186500668} :answer-field/id #uuid "580192e7-570b-5540-8797-e5c58d054e27" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501053}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e173cb82-cae9-5da1-9ec4-a1b561689a6a" :question/math-academy-id "q-111453" :question/problem "Find the real solution to the equation $(x-5)^{3}=-27.$" :question/worked-solution "We can solve this equation by taking the $3$rd root of each side and solving for $x.$\nSince $n=3$ is odd, there is only one real solution to this equation:\n\n$$\n\\begin{aligned}(x-5)^{3} & =-27 \\\\ \\sqrt[3]{(x-5)^{3}} & =\\sqrt[3]{-27} \\\\ x-5 & =\\sqrt[3]{(-3)^{3}} \\\\ x-5 & =-3 \\\\ x & =2\\end{aligned}\n$$\n\nTherefore, the solution is $x=2.$"}] [{:db/id #edb/ref 17592186501233 :knowledge-point/_questions [{:db/id #edb/ref 17592186179680 :knowledge-point/id #uuid "f1e9abbc-b0b5-51a6-b23b-a32a027382f3" :knowledge-point/title "Solving Equations Containing an Expression Raised to an Odd Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f8186ba-e3b0-5bd9-9843-2090471b6685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186500628} {:answer/id #uuid "81c72bf6-fc39-5e64-83f6-21c70539e4ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186500735} {:answer/id #uuid "a70181af-098d-507c-9e5c-9a6c9cea4359" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186500812} {:answer/id #uuid "c5610a42-df77-5563-8e3b-315f0bdd9b5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186500884} {:answer/id #uuid "d50b88ab-07d6-5703-bc25-f4ee2a8d8d9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186500922}] :answer-field/correct {:answer/id #uuid "c5610a42-df77-5563-8e3b-315f0bdd9b5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186500884} :answer-field/id #uuid "5ef8fbba-e17b-5d21-9b7e-67231bfee328" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501060}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ea193efd-d8e8-59fc-adc1-1d1595da20e0" :question/math-academy-id "q-111455" :question/problem "Find the real solution to the equation $3(x+7)^{9}=1\\,536.$" :question/worked-solution "We can solve this equation by isolating the $(x+7)^{9}$ term and then taking the $9$th root of each side.\n\nFirst, let's isolate the $(x+7)^{9}$ term on the left-hand side:\n\n$$\n\\begin{aligned}3(x+7)^{9} & =1\\,536 \\\\ (x+7)^{9} & =512\\end{aligned}\n$$\n\nNow, we take the $9$th root of each side and solve for $x.$ Since $n=9$ is odd, there is only one real solution to this equation:\n\n$$\n\\begin{aligned}(x+7)^{9} & =512 \\\\ \\sqrt[9]{(x+7)^{9}} & =\\sqrt[9]{512} \\\\ x+7 & =\\sqrt[9]{{2}^{9}} \\\\ x+7 & =2 \\\\ x & =-5\\end{aligned}\n$$\n\nTherefore, the solution is $x=-5.$"}] [{:db/id #edb/ref 17592186501202 :knowledge-point/_questions [{:db/id #edb/ref 17592186179681 :knowledge-point/id #uuid "98f98657-c9c6-5b38-825c-992bcf28d9e3" :knowledge-point/title "Solving Equations With Odd Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67519f82-bf90-5eae-92ab-759d66a46d20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186500684} {:answer/id #uuid "751c3f3c-6fe2-5175-b4e8-c998c19d82f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is no real solution" :db/id #edb/ref 17592186500707} {:answer/id #uuid "7560d60b-fe06-51f7-9bf9-6fae9c2eb5a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186500709} {:answer/id #uuid "af93c50c-2cba-5f1c-ac97-840c015