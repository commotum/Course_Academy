#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186180403} :activity/id #uuid "5af1262a-1c56-58b3-9acb-3b64b5f1eea9" :activity/scope {:db/id #edb/ref 17592186049066 :topic/id #uuid "d72fac68-834e-516a-9e98-9df9b0527be6" :topic/math-academy-id 3748} :activity/steps [{:db/id #edb/ref 17592186180401 :step/content {:db/id #edb/ref 17592186179680 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179539 :question/id #uuid "20f6391d-7ada-51b2-a384-f12a31a622c7" :question/math-academy-id "e-8053"} :knowledge-point/id #uuid "f1e9abbc-b0b5-51a6-b23b-a32a027382f3" :knowledge-point/questions [{:db/id #edb/ref 17592186180296} {:db/id #edb/ref 17592186180299} {:db/id #edb/ref 17592186501229} {:db/id #edb/ref 17592186501233}] :knowledge-point/title "Solving Equations Containing an Expression Raised to an Odd Power"} :step/id #uuid "52ee7c85-875f-5a5f-af14-c666ff0b02e9" :step/math-academy-id 30069} {:db/id #edb/ref 17592186180402 :step/content {:db/id #edb/ref 17592186179681 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179540 :question/id #uuid "26f0aea2-1440-5e96-9013-8238214b4966" :question/math-academy-id "e-8065"} :knowledge-point/id #uuid "98f98657-c9c6-5b38-825c-992bcf28d9e3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048170} {:db/id #edb/ref 17592186048187}] :knowledge-point/questions [{:db/id #edb/ref 17592186180297} {:db/id #edb/ref 17592186180298} {:db/id #edb/ref 17592186501202} {:db/id #edb/ref 17592186501224}] :knowledge-point/title "Solving Equations With Odd Exponents"} :step/id #uuid "247ebd22-9eec-58a6-b24f-de774c47432e" :step/math-academy-id 30121 :step/next {:db/id #edb/ref 17592186180401}} {:db/id #edb/ref 17592186180403 :step/content {:db/id #edb/ref 17592186180684 :tutorial/content "How do we solve an equation with a variable raised to an odd exponent, such as\n\n$$\nx^3 = 125?\n$$\n\nWe can solve this equation by taking the $3$rd root of each side and solving for $x.$ \n\nSince $n=3$ is odd, there will be only one real solution:\n\n$$\n\\begin{aligned}{x}^{3} & =125 \\\\ \\sqrt[3]{{x}^{3}} & =\\sqrt[3]{125} \\\\ x & =\\sqrt[3]{{5}^{3}} \\\\ x & =5\\end{aligned}\n$$\n\nTherefore, the solution is $x=5.$\n\nIn general, we have the following rule of thumb:\n\n*When $n$ is odd, and we take the $n$th root of both sides of $x^n = a,$ we get only one solution:* \n\n$$\nx = \\sqrt[n]{a}\n$$" :tutorial/id #uuid "a3deb3f5-8f54-5126-a222-4b9346b3c89f" :tutorial/math-academy-id 4834 :tutorial/title "Introduction"} :step/id #uuid "c7f88cee-5451-591c-bcf6-e4c817bdbf06" :step/math-academy-id 30129 :step/next {:db/id #edb/ref 17592186180402}}] :activity/title "Solving Equations With Odd Exponents Using the Nth Root Method" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179891}]}
