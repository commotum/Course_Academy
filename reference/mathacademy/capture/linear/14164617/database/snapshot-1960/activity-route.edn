#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186489361} :activity/id #uuid "e9225a93-dc03-57da-bec9-4f535a279d72" :activity/scope {:db/id #edb/ref 17592186048650 :topic/id #uuid "b227b0cb-b6cd-53a5-8a0d-c105c56b3477" :topic/math-academy-id 2465} :activity/steps [{:db/id #edb/ref 17592186489341 :step/content {:db/id #edb/ref 17592186489246 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "036eafb8-c49d-58cf-aba0-dbb85b8a6d63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,560" :db/id #edb/ref 17592186488476} {:answer/id #uuid "18adfc4b-40de-5736-b8ad-16bd94bf6b24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\,653" :db/id #edb/ref 17592186488523} {:answer/id #uuid "19915433-b6de-5ef5-93c0-b49e9f51d44a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\,096" :db/id #edb/ref 17592186488525} {:answer/id #uuid "292544c4-976c-5a08-ba6c-8e830e5ab925" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\,536" :db/id #edb/ref 17592186488557} {:answer/id #uuid "929acbf8-3e5b-5715-a98b-c7c7b5f2beba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,460" :db/id #edb/ref 17592186488764}] :answer-field/correct {:db/id #edb/ref 17592186488557} :answer-field/id #uuid "d469c932-3585-58b1-be22-0b73b73c3ef8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489139}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "978bca7b-e158-5bd2-ae01-fa65d0556739" :question/math-academy-id "q-45697" :question/problem "The population $M(t)$ of a colony of rodents is given by $M(t)=1\\,000\\cdot (1.6)^{t}$, where $t$ is the time in years since the beginning of the observations. How many additional rodents will be born in the colony between years $2$ and $3?$" :question/worked-solution "To find the growth in the population of rodents between year $2$ and year $3$, we need to subtract the population after year $2$ from the population after year $3.$ So we need to calculate\n\n$$\nM(3)-M(2).\n$$\n\nFirst, we find the population after the second year, $M(2)$:\n\n$$\n\\begin{aligned}M(2) & =1\\,000\\cdot (1.6)^{(2)} \\\\  & =1\\,000\\cdot 2.56 \\\\  & =2\\,560\\end{aligned}\n$$\n\nNext, we find $M(3),$ the population after the third year:\n\n$$\n\\begin{aligned}M(3) & =1\\,000\\cdot (1.6)^{(3)} \\\\  & =1\\,000\\cdot 4.096 \\\\  & =4\\,096\\end{aligned}\n$$\n\nTherefore, the growth in the population between year $2$ and year $3$ is\n\n$$\n\\begin{aligned}M(3)-M(2) & =4\\,096-2\\,560=1\\,536.\\end{aligned}\n$$\n\nSo, the population of rodents increased by $1\\,536$ between years $2$ and $3.$"} :step/id #uuid "92b6b921-bfab-5106-aebc-d9c7e4e38733" :step/next {:db/id #edb/ref 17592186489357}} {:db/id #edb/ref 17592186489357 :step/content {:db/id #edb/ref 17592186489175 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e8344b2-9e67-5157-94a5-d4ffcc91bb42" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The area covered by the bushes grows at a rate of $11%$ per year" :db/id #edb/ref 17592186488535} {:answer/id #uuid "90b44fdb-a8cc-514c-95fd-f7202dd8720f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The area covered by the bushes grows at a rate of $10%$ per year" :db/id #edb/ref 17592186488759} {:answer/id #uuid "b4c80e48-faec-5b72-aef4-f19de49c3f3f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The area covered by the bushes increases by a factor of $1.1$ every $8$ years" :db/id #edb/ref 17592186488834} {:answer/id #uuid "bc4ad3b6-0cd3-5e75-bd2f-774f75c48689" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The area covered by the bushes grows at a rate of $8%$ per year" :db/id #edb/ref 17592186488849} {:answer/id #uuid "fdfb7f6b-b500-55a3-b9aa-cd8cc691d7b6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The area covered by the bushes grows at a rate of $1.1%$ per year" :db/id #edb/ref 17592186489010}] :answer-field/correct {:db/id #edb/ref 17592186488759} :answer-field/id #uuid "365bcff0-9da9-51b5-b700-1716404308aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489046}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "065bbf88-3b11-5079-b0c1-f463dc0506a1" :question/math-academy-id "q-64102" :question/problem "The total area, in square meters,  covered by blueberry bushes in a forest can be modeled by the expression $800\\cdot (1.1)^{t},$ where $t$ is the number of years since the year $2015.$ What does the base of the exponential expression $(1.1)$ mean in this context?" :question/worked-solution "The answer choices require interpretation as a percent, and so we use the growth rate formula.\n\nThe given expression is an exponential growth expression of the form $y(t)=a\\cdot (1+r)^{t}$, where:\n\n- $a=800$ represents the initial area covered by the  blueberry bushes\n\n- $1+r=1.1,$ where $r$ is the growth rate\n\n- $t$ is the number of years since $2015$\n\nSolving for $r$:\n\n$$\n1+r=1.1\\,⟹\\,r=0.1\n$$\n\nNow, $0.1$ (expressed as a percent) is equal to $10%.$ Therefore, the area covered by the bushes grows at a rate of $10%$ per year."} :step/id #uuid "b2e8828f-e8f0-5f6b-8f2a-4544652c7ffc"} {:db/id #edb/ref 17592186489361 :step/content {:db/id #edb/ref 17592186489204 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01c8a340-3d84-5653-a1c7-a6b291ebaf8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11\\,{\\text{km}}^{2}" :db/id #edb/ref 17592186488471} {:answer/id #uuid "2888b44b-0869-5796-ade9-2cdfc7016b90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12.1\\,{\\text{km}}^{2}" :db/id #edb/ref 17592186488555} {:answer/id #uuid "782c49fd-1ec9-542f-9446-c12766d3d684" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.1\\,{\\text{km}}^{2}" :db/id #edb/ref 17592186488708} {:answer/id #uuid "7ca68bbc-a218-5b0c-a014-725824cd865d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.1\\,{\\text{km}}^{2}" :db/id #edb/ref 17592186488720} {:answer/id #uuid "bc8370e9-2478-56a9-9b58-f413970d8e02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\,{\\text{km}}^{2}" :db/id #edb/ref 17592186488852}] :answer-field/correct {:db/id #edb/ref 17592186488720} :answer-field/id #uuid "1bf52d0f-f83a-5aa3-b11c-feea28b4ef8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489035}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "38bb781d-e24d-5ca2-821e-7901089bd6a3" :question/math-academy-id "q-45601" :question/problem "The area of an oil patch, measured in square kilometers, is given by the function $A(t)=10\\cdot (1.1)^{t}$, where $t$ is the time in days since the pollution occurred. How many square kilometers does the area increase by between day $1$ and day $2?$" :question/worked-solution "To find the growth of the patch between day $1$ and day $2$, we need to subtract the area after day $1$ from the area after day $2.$ So we need to calculate\n\n$$\nA(2)-A(1).\n$$\n\nFirst, we find the area after the first day, $A(1)$:\n\n$$\n\\begin{aligned}A(1) & =10\\cdot (1.1)^{1} \\\\  & =10\\cdot 1.1 \\\\  & =11\\end{aligned}\n$$\n\nNext, we find $A(2),$ the area after the second day:\n\n$$\n\\begin{aligned}A(2) & =10\\cdot (1.1)^{2} \\\\  & =10\\cdot 1.21 \\\\  & =12.1\\end{aligned}\n$$\n\nTherefore, the growth of the patch between day $1$ and day $2$ is\n\n$$\n\\begin{aligned}A(2)-A(1) & =12.1-11=1.1.\\end{aligned}\n$$\n\nSo, the area increased by $1.1$ square kilometer between day $1$ and day $2.$"} :step/id #uuid "c81e5c67-ac42-5acf-b9ba-dd9c76587fb0" :step/next {:db/id #edb/ref 17592186489341}}] :activity/title "Interpreting Exponential Growth" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186488465}]}
