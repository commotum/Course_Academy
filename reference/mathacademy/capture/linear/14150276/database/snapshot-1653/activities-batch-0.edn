#{[{:activity/first-step {:db/id #edb/ref 17592186106789} :activity/id #uuid "c2a49596-9588-55a0-8deb-bab9b956aeec" :activity/scope {:db/id #edb/ref 17592186050998 :topic/id #uuid "782cde63-c3cf-5599-8f18-28a9d8b09d13" :topic/math-academy-id 1297} :activity/steps [{:db/id #edb/ref 17592186106789 :step/content {:db/id #edb/ref 17592186107032 :tutorial/content "Two expressions involving fractions are **equivalent** if they are the same.\n\nEven if two expressions initially appear different, they might still be equivalent. For example, the expressions\n\n$$\n\\dfrac{1}{2}x\n$$\n\nand\n\n$$\n\\dfrac{x}{2}\n$$\n\nboth represent the same thing: \"half of $x$.\" Consequently, they are equivalent.\n\nWe can also see that these expressions are equivalent because\n\n$$\n\\dfrac{1}{2}x\n$$\n\ncan be transformed into\n\n$$\n\\dfrac{x}{2}\n$$\n\nWriting $x$ as\n\n$$\n\\dfrac{x}{1}\n$$\n\nwe can multiply\n\n$$\n\\dfrac 1 2\n$$\n\nand\n\n$$\n\\dfrac x 1\n$$\n\nusing fraction multiplication, as follows:\n\n$$\n\\begin{aligned}\n\\frac{1}{2}x &= \\frac{1}{2} \\cdot x \\\\\n&= \\frac{1}{2} \\cdot \\frac{x}{1} \\\\\n&= \\frac{1 \\cdot x}{2 \\cdot 1} \\\\\n&= \\frac{x}{2}\n\\end{aligned}\n$$" :tutorial/id #uuid "a90bc179-e52a-5754-8b86-3729572a90d8" :tutorial/math-academy-id 1366 :tutorial/title "Introduction"} :step/id #uuid "2c48316d-05f5-59b9-a77c-b685a5127ce2" :step/math-academy-id 2820 :step/next {:db/id #edb/ref 17592186106933}} {:db/id #edb/ref 17592186106790 :step/content {:db/id #edb/ref 17592186105835 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105683 :question/id #uuid "9062b933-10d8-5f52-b41e-c528d35c9fe5" :question/math-academy-id "e-832"} :knowledge-point/id #uuid "cd86e42a-deb3-5f59-bbbc-f096a1f368aa" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049349} {:db/id #edb/ref 17592186050287}] :knowledge-point/questions [{:db/id #edb/ref 17592186106382} {:db/id #edb/ref 17592186106383}] :knowledge-point/title "Identifying Equivalent Expressions with Negative Terms"} :step/id #uuid "4c17202e-e185-5578-bb4c-14c96ae01ec3" :step/math-academy-id 2824 :step/next {:db/id #edb/ref 17592186106932}} {:db/id #edb/ref 17592186106791 :step/content {:db/id #edb/ref 17592186107033 :tutorial/content "The usual procedure also works in the reverse direction. For example, to find an equivalent expression for\n\n$$\n\\dfrac{2(y+1)}5\n$$\n\nwe can separate the variable part from the rest of the fraction, as follows:\n\n$$\n\\begin{aligned}\n(2(y + 1))/(5) &= (2 \\cdot (y + 1))/(5 \\cdot 1) \\\\\n&= \\frac{2}{5} \\cdot ((y + 1))/(1) \\\\\n&= \\frac{2}{5} \\cdot (y + 1) \\\\\n&= \\frac{2}{5}(y + 1)\n\\end{aligned}\n$$" :tutorial/id #uuid "094b5543-1d48-5d70-9fdd-ea1dc9829418" :tutorial/math-academy-id 1367 :tutorial/title "Expressing a Fraction as a Product"} :step/id #uuid "0b0436c3-5877-556a-ab04-3a933c1b4463" :step/math-academy-id 2827 :step/next {:db/id #edb/ref 17592186106934}} {:db/id #edb/ref 17592186106932 :step/content {:db/id #edb/ref 17592186105910 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105485 :question/id #uuid "45b1ee7d-b7ce-5336-9d2a-1a5953310026" :question/math-academy-id "e-1521"} :knowledge-point/id #uuid "796da155-1e8c-5f6c-896f-2dce9a678f5b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050908}] :knowledge-point/questions [{:db/id #edb/ref 17592186106379} {:db/id #edb/ref 17592186106381}] :knowledge-point/title "Identifying Equivalent Expressions with Binomial Terms"} :step/id #uuid "eb7fe3e9-40a1-55ab-81cb-45bd464a0081" :step/math-academy-id 4768 :step/next {:db/id #edb/ref 17592186106791}} {:db/id #edb/ref 17592186106933 :step/content {:db/id #edb/ref 17592186105911 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105486 :question/id #uuid "53825e9f-1b2f-582e-ad91-50970995d523" :question/math-academy-id "e-1543"} :knowledge-point/id #uuid "afca9dea-4471-582f-b15f-a5899d3789aa" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049253} {:db/id #edb/ref 17592186051009}] :knowledge-point/questions [{:db/id #edb/ref 17592186106378} {:db/id #edb/ref 17592186106463}] :knowledge-point/title "Identifying Equivalent Expressions with Positive Terms"} :step/id #uuid "12adceb3-fbee-5964-9a8f-987db7df7bee" :step/math-academy-id 4899 :step/next {:db/id #edb/ref 17592186106790}} {:db/id #edb/ref 17592186106934 :step/content {:db/id #edb/ref 17592186105912 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105487 :question/id #uuid "0c24fff9-3d43-53f3-8c87-daacb675f802" :question/math-academy-id "e-1544"} :knowledge-point/id #uuid "7002c6fc-ae50-5b7f-995f-2147db19e9ec" :knowledge-point/questions [{:db/id #edb/ref 17592186106461} {:db/id #edb/ref 17592186106464}] :knowledge-point/title "Expressing a Fraction as a Product"} :step/id #uuid "471f6117-285f-5918-b5e3-f3eee6a5c192" :step/math-academy-id 4900}] :activity/title "Equivalent Expressions With Fractions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186105969}]}
