2186446008 #edb/ref 1072 #uuid "15c1975a-5c77-59ea-b22f-26a9fa9a40fc" #edb/ref 17592186045417] [17592186446008 #edb/ref 1074 "Using the definition for the product of two fractions and the distributive property,  we obtain\n\n$$\n\\begin{aligned}\\frac{2}{5}\\,(R+1) & =\\frac{2}{5}\\cdot (R+1) \\\\  & =\\frac{2}{5}\\cdot \\frac{R+1}{1} \\\\  & =\\frac{2\\cdot (R+1)}{5\\cdot 1} \\\\  & =\\frac{2R+2}{5}\\,.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186446009 #edb/ref 1068 #edb/ref 17592186446001 #edb/ref 17592186045417] [17592186446009 #edb/ref 1069 "q-51638" #edb/ref 17592186045417] [17592186446009 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186446009 #edb/ref 1071 "The expression $\\frac{4}{5}\\,(n-2)$ is equivalent to" #edb/ref 17592186045417] [17592186446009 #edb/ref 1072 #uuid "1e7a5473-d897-50f6-be12-c307a084dd8c" #edb/ref 17592186045417] [17592186446009 #edb/ref 1074 "Using the definition for the product of two fractions,  we have\n\n$$\n\\begin{aligned}\\frac{4}{5}\\,(n-2) & =\\frac{4}{5}\\cdot (n-2) \\\\  & =\\frac{4}{5}\\cdot \\frac{n-2}{1} \\\\  & =\\frac{4\\cdot (n-2)}{5\\cdot 1} \\\\  & =\\frac{4(n-2)}{5}\\,.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186446010 #edb/ref 1068 #edb/ref 17592186446007 #edb/ref 17592186045417] [17592186446010 #edb/ref 1069 "q-100008" #edb/ref 17592186045417] [17592186446010 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186446010 #edb/ref 1071 "$\\frac{2}{7}x$ is equivalent to" #edb/ref 17592186045417] [17592186446010 #edb/ref 1072 #uuid "7183bcde-c002-5fb8-96a6-052694ff64b0" #edb/ref 17592186045417] [17592186446010 #edb/ref 1074 "Writing $x$ as $\\frac{x}{1},$ we have\n\n$$\n\\begin{aligned}\\frac{2}{7}x & =\\frac{2}{7}\\cdot x \\\\  & =\\frac{2}{7}\\cdot \\frac{x}{1} \\\\  & =\\frac{2\\cdot x}{7\\cdot 1} \\\\  & =\\frac{2x}{7}.\\end{aligned}\n$$\n\nThus, the expressions $\\frac{2}{7}x$ and $\\frac{2x}{7}$ are equivalent." #edb/ref 17592186045417] [17592186446011 #edb/ref 1068 #edb/ref 17592186446005 #edb/ref 17592186045417] [17592186446011 #edb/ref 1069 "q-70084" #edb/ref 17592186045417] [17592186446011 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186446011 #edb/ref 1071 "$\\frac{q}{8}$ is equivalent to" #edb/ref 17592186045417] [17592186446011 #edb/ref 1072 #uuid "8c6ba30d-a56f-524d-91ab-97b68e7f3806" #edb/ref 17592186045417] [17592186446011 #edb/ref 1074 "Pulling out the variable part, we have\n\n$$\n\\begin{aligned}\\frac{q}{8} & =\\frac{1\\cdot q}{8\\cdot 1} \\\\  & =\\frac{1}{8}\\cdot \\frac{q}{1} \\\\  & =\\frac{1}{8}\\cdot q \\\\  & =\\frac{1}{8}\\,q.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186446012 #edb/ref 1068 #edb/ref 17592186446004 #edb/ref 17592186045417] [17592186446012 #edb/ref 1069 "q-70072" #edb/ref 17592186045417] [17592186446012 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186446012 #edb/ref 1071 "The expression $\\frac{4}{9}z$ is equivalent to" #edb/ref 17592186045417] [17592186446012 #edb/ref 1072 #uuid "b1d14526-d850-5fde-b6de-399e3114c554" #edb/ref 17592186045417] [17592186446012 #edb/ref 1074 "Writing $z$ as $\\frac{z}{1}$, we have\n\n$$\n\\begin{aligned}\\frac{4}{9}z & =\\frac{4}{9}\\cdot z \\\\  & =\\frac{4}{9}\\cdot \\frac{z}{1} \\\\  & =\\frac{4\\cdot z}{9\\cdot 1} \\\\  & =\\frac{4z}{9}\\,.\\end{aligned}\n$$\n\nThus, the expressions $\\frac{4}{9}z$ and $\\frac{4z}{9}$ are equivalent." #edb/ref 17592186045417] [17592186446013 #edb/ref 1068 #edb/ref 17592186446006 #edb/ref 17592186045417] [17592186446013 #edb/ref 1069 "q-108701" #edb/ref 17592186045417] [17592186446013 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186446013 #edb/ref 1071 "Find an expression equivalent to $\\frac{5(h-7)}{3}.$" #edb/ref 17592186045417] [17592186446013 #edb/ref 1072 #uuid "b7c9d305-cc80-564f-85ac-61aa6b7be138" #edb/ref 17592186045417] [17592186446013 #edb/ref 1074 "Pulling out the variable part, we have\n\n$$\n\\begin{aligned}\\frac{5(h-7)}{3} & =\\frac{5\\cdot (h-7)}{3\\cdot 1} \\\\  & =\\frac{5}{3}\\cdot \\frac{h-7}{1} \\\\  & =\\frac{5}{3}\\cdot (h-7) \\\\  & =\\frac{5}{3}(h-7)\\,.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186446014 #edb/ref 1068 #edb/ref 17592186446003 #edb/ref 17592186045417] [17592186446014 #edb/ref 1069 "q-108696" #edb/ref 17592186045417] [17592186446014 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186446014 #edb/ref 1071 "$\\frac{1}{7}\\,(-f)$ is equivalent to" #edb/ref 17592186045417] [17592186446014 #edb/ref 1072 #uuid "bc5db206-5120-5419-9d82-dc30e18e3280" #edb/ref 17592186045417] [17592186446014 #edb/ref 1074 "First, remember that the product of a positive number and a negative number is a negative number. Thus, \n\n$$\n\\frac{1}{7}(-f)=-\\frac{1}{7}f.\n$$\n\nNow, writing $f$ as $\\frac{f}{1},$ we have\n\n$$\n\\begin{aligned}-\\frac{1}{7}f & =-\\frac{1}{7}\\cdot f \\\\  & =-\\frac{1}{7}\\cdot \\frac{f}{1} \\\\  & =-\\frac{1\\cdot f}{7\\cdot 1} \\\\  & =-\\frac{f}{7}.\\end{aligned}\n$$\n\nThus, the expressions $\\frac{1}{7}(-f)$ and $-\\frac{f}{7}$ are equivalent." #edb/ref 17592186045417] [17592186446015 #edb/ref 1068 #edb/ref 17592186446002 #edb/ref 17592186045417] [17592186446015 #edb/ref 1069 "q-100026" #edb/ref 17592186045417] [17592186446015 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186446015 #edb/ref 1071 "$-\\frac{7}{4}\\,(-h)$ is equivalent to" #edb/ref 17592186045417] [17592186446015 #edb/ref 1072 #uuid "c402ae86-03e2-521f-97be-fa33095984c9" #edb/ref 17592186045417] [17592186446015 #edb/ref 1074 "First, remember that the product of two negative numbers is a positive number. Thus, \n\n$$\n-\\frac{7}{4}(-h)=\\frac{7}{4}h.\n$$\n\nNow, writing $h$ as $\\frac{h}{1},$ we have\n\n$$\n\\begin{aligned}\\frac{7}{4}h & =\\frac{7}{4}\\cdot h \\\\  & =\\frac{7}{4}\\cdot \\frac{h}{1} \\\\  & =\\frac{7\\cdot h}{4\\cdot 1} \\\\  & =\\frac{7h}{4}.\\end{aligned}\n$$\n\nThus, the expressions $-\\frac{7}{4}(-h)$ and $\\frac{7h}{4}$ are equivalent." #edb/ref 17592186045417]}
