#{[{:db/id #edb/ref 17592186105485 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105910 :knowledge-point/id #uuid "796da155-1e8c-5f6c-896f-2dce9a678f5b" :knowledge-point/title "Identifying Equivalent Expressions with Binomial Terms"}] :question/id #uuid "45b1ee7d-b7ce-5336-9d2a-1a5953310026" :question/math-academy-id "e-1521" :question/problem "Find an expression equivalent to $\\dfrac 27\\, {(y-3)}$" :question/worked-solution "Writing $y-3$ as $\\dfrac{y-3}{1},$ we have\n\n$$\n\\begin{aligned}\\frac{2}{7}\\,(y-3) & =\\frac{2}{7}\\cdot (y-3) \\\\  & =\\frac{2}{7}\\cdot \\frac{y-3}{1} \\\\  & =\\frac{2\\cdot (y-3)}{7\\cdot 1} \\\\  & =\\frac{2y-6}{7}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105486 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105911 :knowledge-point/id #uuid "afca9dea-4471-582f-b15f-a5899d3789aa" :knowledge-point/title "Identifying Equivalent Expressions with Positive Terms"}] :question/id #uuid "53825e9f-1b2f-582e-ad91-50970995d523" :question/math-academy-id "e-1543" :question/problem "Find an expression that's equivalent to $\\dfrac{2}3 a.$" :question/worked-solution "Writing $a$ as $\\dfrac{a}{1},$ we have\n\n$$\n\\begin{aligned}\\frac{2}{3}\\,a & =\\frac{2}{3}\\cdot a \\\\  & =\\frac{2}{3}\\cdot \\frac{a}{1} \\\\  & =\\frac{2\\cdot a}{3\\cdot 1} \\\\  & =\\frac{2a}{3}.\\end{aligned}\n$$\n\nThus, the expressions $\\dfrac{2}{3}a$ and $\\dfrac{2a}{3}$ are equivalent."}] [{:db/id #edb/ref 17592186105487 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105912 :knowledge-point/id #uuid "7002c6fc-ae50-5b7f-995f-2147db19e9ec" :knowledge-point/title "Expressing a Fraction as a Product"}] :question/id #uuid "0c24fff9-3d43-53f3-8c87-daacb675f802" :question/math-academy-id "e-1544" :question/problem "Find an expression equivalent to $\\dfrac{2(3-x)}{5}.$" :question/worked-solution "Pulling out the variable part, we have\n\n$$\n\\begin{aligned}\\frac{2(3-x)}{5} & =\\frac{2\\cdot (3-x)}{5\\cdot 1} \\\\  & =\\frac{2}{5}\\cdot \\frac{3-x}{1} \\\\  & =\\frac{2}{5}\\cdot (3-x) \\\\  & =\\frac{2}{5}(3-x)\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105683 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105835 :knowledge-point/id #uuid "cd86e42a-deb3-5f59-bbbc-f096a1f368aa" :knowledge-point/title "Identifying Equivalent Expressions with Negative Terms"}] :question/id #uuid "9062b933-10d8-5f52-b41e-c528d35c9fe5" :question/math-academy-id "e-832" :question/problem "Find an  expression  equivalent to $-\\dfrac{2}9 (-z).$" :question/worked-solution "First, remember that the product of two negative numbers is a positive number. Thus, \n\n$$\n-\\dfrac{2}9 (-z) = \\dfrac{2}{9} z.\n$$\n\nNow, writing $z$ as $\\dfrac{z}{1},$ we have\n\n$$\n\\begin{aligned}\\frac{2}{9}z & =\\frac{2}{9}\\cdot z \\\\  & =\\frac{2}{9}\\cdot \\frac{z}{1} \\\\  & =\\frac{2\\cdot z}{9\\cdot 1} \\\\  & =\\frac{2z}{9}.\\end{aligned}\n$$\n\nThus, the expressions $-\\dfrac{2}9 (-z)$ and $\\dfrac{2z}{9}$ are equivalent."}] [{:db/id #edb/ref 17592186446010 :knowledge-point/_questions [{:db/id #edb/ref 17592186105911 :knowledge-point/id #uuid "afca9dea-4471-582f-b15f-a5899d3789aa" :knowledge-point/title "Identifying Equivalent Expressions with Positive Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0360965d-f973-5603-8409-536e327814aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x}{7}" :db/id #edb/ref 17592186445962} {:answer/id #uuid "23592a79-11a7-5e05-b314-534dbaff194a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{7}" :db/id #edb/ref 17592186445968} {:answer/id #uuid "5ad1c69f-2930-5a25-979d-1a42a836f0c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7x}{2}" :db/id #edb/ref 17592186445974} {:answer/id #uuid "b885d7d9-709f-59d0-b8b6-07db0a9ccc7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{2}" :db/id #edb/ref 17592186445981} {:answer/id #uuid "d9275783-0c0b-5d4c-bdbd-6b2f78c3db9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{7}" :db/id #edb/ref 17592186445987}] :answer-field/correct {:answer/id #uuid "23592a79-11a7-5e05-b314-534dbaff194a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{7}" :db/id #edb/ref 17592186445968} :answer-field/id #uuid "e8046021-5a29-51c1-a59a-a55e75b9e1ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446007}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7183bcde-c002-5fb8-96a6-052694ff64b0" :question/math-academy-id "q-100008" :question/problem "$\\frac{2}{7}x$ is equivalent to" :question/worked-solution "Writing $x$ as $\\frac{x}{1},$ we have\n\n$$\n\\begin{aligned}\\frac{2}{7}x & =\\frac{2}{7}\\cdot x \\\\  & =\\frac{2}{7}\\cdot \\frac{x}{1} \\\\  & =\\frac{2\\cdot x}{7\\cdot 1} \\\\  & =\\frac{2x}{7}.\\end{aligned}\n$$\n\nThus, the expressions $\\frac{2}{7}x$ and $\\frac{2x}{7}$ are equivalent."}] [{:db/id #edb/ref 17592186446015 :knowledge-point/_questions [{:db/id #edb/ref 17592186105835 :knowledge-point/id #uuid "cd86e42a-deb3-5f59-bbbc-f096a1f368aa" :knowledge-point/title "Identifying Equivalent Expressions with Negative Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21ee8460-7b54-5b03-bcf8-fa08792bb084" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7h}{2}" :db/id #edb/ref 17592186445967} {:answer/id #uuid "371b3702-d4a0-55a7-b4c5-68d47387ea73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{h}{4}" :db/id #edb/ref 17592186445971} {:answer/id #uuid "8fbfa788-ef11-5737-9121-c1d00db0f98c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{h}{2}" :db/id #edb/ref 17592186445979} {:answer/id #uuid "a670f552-d694-5993-af51-941d6a61b163" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4h}{7}" :db/id #edb/ref 17592186445980} {:answer/id #uuid "fb2c5c25-35ea-5961-8a0b-b89d157dcc9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7h}{4}" :db/id #edb/ref 17592186445998}] :answer-field/correct {:answer/id #uuid "fb2c5c25-35ea-5961-8a0b-b89d157dcc9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7h}{4}" :db/id #edb/ref 17592186445998} :answer-field/id #uuid "6f565cbf-acd2-515d-897e-857c7b678992" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446002}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c402ae86-03e2-521f-97be-fa33095984c9" :question/math-academy-id "q-100026" :question/problem "$-\\frac{7}{4}\\,(-h)$ is equivalent to" :question/worked-solution "First, remember that the product of two negative numbers is a positive number. Thus, \n\n$$\n-\\frac{7}{4}(-h)=\\frac{7}{4}h.\n$$\n\nNow, writing $h$ as $\\frac{h}{1},$ we have\n\n$$\n\\begin{aligned}\\frac{7}{4}h & =\\frac{7}{4}\\cdot h \\\\  & =\\frac{7}{4}\\cdot \\frac{h}{1} \\\\  & =\\frac{7\\cdot h}{4\\cdot 1} \\\\  & =\\frac{7h}{4}.\\end{aligned}\n$$\n\nThus, the expressions $-\\frac{7}{4}(-h)$ and $\\frac{7h}{4}$ are equivalent."}] [{:db/id #edb/ref 17592186446014 :knowledge-point/_questions [{:db/id #edb/ref 17592186105835 :knowledge-point/id #uuid "cd86e42a-deb3-5f59-bbbc-f096a1f368aa" :knowledge-point/title "Identifying Equivalent Expressions with Negative Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ec3b03a-6d8e-5507-9613-b52e86bfd1b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{f-7}{7}" :db/id #edb/ref 17592186445963} {:answer/id #uuid "ba3fa3ef-bbff-50f2-8f89-41fe96327311" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{f-1}{7}" :db/id #edb/ref 17592186445982} {:answer/id #uuid "f070feac-ed8e-548d-8eaf-462fbb8c1f9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{f}{7}" :db/id #edb/ref 17592186445994} {:answer/id #uuid "f6f1c573-d371-5b6b-82c1-218973f9275d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{f}" :db/id #edb/ref 17592186445996} {:answer/id #uuid "fd851a64-b416-5c7e-b1e0-d928cdb1c585" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-f}{7}" :db/id #edb/ref 17592186445999}] :answer-field/correct {:answer/id #uuid "f070feac-ed8e-548d-8eaf-462fbb8c1f9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{f}{7}" :db/id #edb/ref 17592186445994} :answer-field/id #uuid "727624da-e764-532a-9a7b-71d20498aae7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446003}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bc5db206-5120-5419-9d82-dc30e18e3280" :question/math-academy-id "q-108696" :question/problem "$\\frac{1}{7}\\,(-f)$ is equivalent to" :question/worked-solution "First, remember that the product of a positive number and a negative number is a negative number. Thus, \n\n$$\n\\frac{1}{7}(-f)=-\\frac{1}{7}f.\n$$\n\nNow, writing $f$ as $\\frac{f}{1},$ we have\n\n$$\n\\begin{aligned}-\\frac{1}{7}f & =-\\frac{1}{7}\\cdot f \\\\  & =-\\frac{1}{7}\\cdot \\frac{f}{1} \\\\  & =-\\frac{1\\cdot f}{7\\cdot 1} \\\\  & =-\\frac{f}{7}.\\end{aligned}\n$$\n\nThus, the expressions $\\frac{1}{7}(-f)$ and $-\\frac{f}{7}$ are equivalent."}] [{:db/id #edb/ref 17592186446013 :knowledge-point/_questions [{:db/id #edb/ref 17592186105912 :knowledge-point/id #uuid "7002c6fc-ae50-5b7f-995f-2147db19e9ec" :knowledge-point/title "Expressing a Fraction as a Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c828ca6-478f-5d13-b730-03b546f17d19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{h}-\\frac{7}{3}" :db/id #edb/ref 17592186445964} {:answer/id #uuid "64048473-c43e-50d6-97ba-5a502bb393c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}-\\frac{7}{h-7}" :db/id #edb/ref 17592186445975} {:answer/id #uuid "c5e04d72-6333-5423-8a26-be3f7c87b38a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5h}{3}-\\frac{7}{3}" :db/id #edb/ref 17592186445985} {:answer/id #uuid "f3ba6131-3d4c-5d31-b82c-11420617b643" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}(h-7)" :db/id #edb/ref 17592186445995} {:answer/id #uuid "fa0eeda1-b4fa-59c1-8266-fac7db871771" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{h}{3(h-7)}" :db/id #edb/ref 17592186445997}] :answer-field/correct {:answer/id #uuid "f3ba6131-3d4c-5d31-b82c-11420617b643" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}(h-7)" :db/id #edb/ref 17592186445995} :answer-field/id #uuid "e538b378-3b69-56c5-ba57-e6cbee09c67e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446006}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b7c9d305-cc80-564f-85ac-61aa6b7be138" :question/math-academy-id "q-108701" :question/problem "Find an expression equivalent to $\\frac{5(h-7)}{3}.$" :question/worked-solution "Pulling out the variable part, we have\n\n$$\n\\begin{aligned}\\frac{5(h-7)}{3} & =\\frac{5\\cdot (h-7)}{3\\cdot 1} \\\\  & =\\frac{5}{3}\\cdot \\frac{h-7}{1} \\\\  & =\\frac{5}{3}\\cdot (h-7) \\\\  & =\\frac{5}{3}(h-7)\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186446008 :knowledge-point/_questions [{:db/id #edb/ref 17592186105910 :knowledge-point/id #uuid "796da155-1e8c-5f6c-896f-2dce9a678f5b" :knowledge-point/title "Identifying Equivalent Expressions with Binomial Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1df9b012-30e6-5c73-8c6a-5322d48b4ba3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2R+2}{10}" :db/id #edb/ref 17592186445965} {:answer/id #uuid "3af6fa54-b458-57c0-bbd5-da3fd4023122" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2R+2}{5}" :db/id #edb/ref 17592186445972} {:answer/id #uuid "8c58ed31-7000-5ada-9259-4e1d67dd03e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{R+2}{5}" :db/id #edb/ref 17592186445978} {:answer/id #uuid "bf7d9dc7-d3f9-5bfc-a658-6e93d97e5cad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2R+10}{5}" :db/id #edb/ref 17592186445983} {:answer/id #uuid "dc421687-fbb1-5e50-8e77-fb49dd3da735" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2R+1}{5}" :db/id #edb/ref 17592186445989}] :answer-field/correct {:answer/id #uuid "3af6fa54-b458-57c0-bbd5-da3fd4023122" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2R+2}{5}" :db/id #edb/ref 17592186445972} :answer-field/id #uuid "0d3a2f57-9269-5ba7-8406-ceec11ee95a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446000}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "15c1975a-5c77-59ea-b22f-26a9fa9a40fc" :question/math-academy-id "q-51468" :question/problem "The expression $\\frac{2}{5}\\,(R+1)$ is equivalent to" :question/worked-solution "Using the definition for the product of two fractions and the distributive property,  we obtain\n\n$$\n\\begin{aligned}\\frac{2}{5}\\,(R+1) & =\\frac{2}{5}\\cdot (R+1) \\\\  & =\\frac{2}{5}\\cdot \\frac{R+1}{1} \\\\  & =\\frac{2\\cdot (R+1)}{5\\cdot 1} \\\\  & =\\frac{2R+2}{5}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186446009 :knowledge-point/_questions [{:db/id #edb/ref 17592186105910 :knowledge-point/id #uuid "796da155-1e8c-5f6c-896f-2dce9a678f5b" :knowledge-point/title "Identifying Equivalent Expressions with Binomial Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23ea4c59-1bb5-5c81-818d-1f17c052ea58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4(n-2)}{5}" :db/id #edb/ref 17592186445969} {:answer/id #uuid "7ba50e26-7ff9-5da3-b3f2-1f1906f04fad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4n-2}{5}" :db/id #edb/ref 17592186445976} {:answer/id #uuid "bfc69bc3-7ab0-500c-b718-bd48211ae4f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n-8}{5}" :db/id #edb/ref 17592186445984} {:answer/id #uuid "e4b6487f-68d6-58bc-b6d8-952195e95a7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n-12}{5}" :db/id #edb/ref 17592186445990} {:answer/id #uuid "e902e6e0-754a-544e-bede-9a17c9df9862" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n-2}{20}" :db/id #edb/ref 17592186445991}] :answer-field/correct {:answer/id #uuid "23ea4c59-1bb5-5c81-818d-1f17c052ea58" :answer/type {:db/id #edb/ref 175921860