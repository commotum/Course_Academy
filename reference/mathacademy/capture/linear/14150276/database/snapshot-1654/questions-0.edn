:answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4z}{9}" :db/id #edb/ref 17592186445992}] :answer-field/correct {:answer/id #uuid "eb0d942f-6012-5fcf-8917-500064bac3a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4z}{9}" :db/id #edb/ref 17592186445992} :answer-field/id #uuid "7678abef-6fc9-566f-a3d2-51bceb099136" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446004}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b1d14526-d850-5fde-b6de-399e3114c554" :question/math-academy-id "q-70072" :question/problem "The expression $\\frac{4}{9}z$ is equivalent to" :question/worked-solution "Writing $z$ as $\\frac{z}{1}$, we have\n\n$$\n\\begin{aligned}\\frac{4}{9}z & =\\frac{4}{9}\\cdot z \\\\  & =\\frac{4}{9}\\cdot \\frac{z}{1} \\\\  & =\\frac{4\\cdot z}{9\\cdot 1} \\\\  & =\\frac{4z}{9}\\,.\\end{aligned}\n$$\n\nThus, the expressions $\\frac{4}{9}z$ and $\\frac{4z}{9}$ are equivalent."}] [{:db/id #edb/ref 17592186446011 :knowledge-point/_questions [{:db/id #edb/ref 17592186105912 :knowledge-point/id #uuid "7002c6fc-ae50-5b7f-995f-2147db19e9ec" :knowledge-point/title "Expressing a Fraction as a Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02c245ff-1482-52e4-bae8-ae7027d33cf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}\\,q" :db/id #edb/ref 17592186445960} {:answer/id #uuid "1e025295-ad73-5e33-ab2f-f48cf29b6ba5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}-q" :db/id #edb/ref 17592186445966} {:answer/id #uuid "3515399b-d41a-5057-8485-9428f04cbf49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q-\\frac{1}{8}" :db/id #edb/ref 17592186445970} {:answer/id #uuid "806af50c-a985-5b05-ad91-4722d5532c0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}+q" :db/id #edb/ref 17592186445977} {:answer/id #uuid "eca40d4f-0ca8-577f-9212-35bf9417f2d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8q}" :db/id #edb/ref 17592186445993}] :answer-field/correct {:answer/id #uuid "02c245ff-1482-52e4-bae8-ae7027d33cf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}\\,q" :db/id #edb/ref 17592186445960} :answer-field/id #uuid "8d4bcf16-d35c-5fb5-a3d3-abc4106846f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446005}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8c6ba30d-a56f-524d-91ab-97b68e7f3806" :question/math-academy-id "q-70084" :question/problem "$\\frac{q}{8}$ is equivalent to" :question/worked-solution "Pulling out the variable part, we have\n\n$$\n\\begin{aligned}\\frac{q}{8} & =\\frac{1\\cdot q}{8\\cdot 1} \\\\  & =\\frac{1}{8}\\cdot \\frac{q}{1} \\\\  & =\\frac{1}{8}\\cdot q \\\\  & =\\frac{1}{8}\\,q.\\end{aligned}\n$$"}]}
