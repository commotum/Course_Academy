 :answer-field/id #uuid "727624da-e764-532a-9a7b-71d20498aae7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f070feac-ed8e-548d-8eaf-462fbb8c1f9a" :answer-field/choices ["answer-f6f1c573-d371-5b6b-82c1-218973f9275d" "answer-f070feac-ed8e-548d-8eaf-462fbb8c1f9a" "answer-fd851a64-b416-5c7e-b1e0-d928cdb1c585" "answer-ba3fa3ef-bbff-50f2-8f89-41fe96327311" "answer-0ec3b03a-6d8e-5507-9613-b52e86bfd1b0"] :db/ensure [:answer-field/validate]} {:db/id "answer-f6f1c573-d371-5b6b-82c1-218973f9275d" :answer/id #uuid "f6f1c573-d371-5b6b-82c1-218973f9275d" :answer/type :answer.type/math :answer/value "-\\frac{7}{f}" :db/ensure [:answer/validate]} {:db/id "answer-f070feac-ed8e-548d-8eaf-462fbb8c1f9a" :answer/id #uuid "f070feac-ed8e-548d-8eaf-462fbb8c1f9a" :answer/type :answer.type/math :answer/value "-\\frac{f}{7}" :db/ensure [:answer/validate]} {:db/id "answer-fd851a64-b416-5c7e-b1e0-d928cdb1c585" :answer/id #uuid "fd851a64-b416-5c7e-b1e0-d928cdb1c585" :answer/type :answer.type/math :answer/value "\\frac{1-f}{7}" :db/ensure [:answer/validate]} {:db/id "answer-ba3fa3ef-bbff-50f2-8f89-41fe96327311" :answer/id #uuid "ba3fa3ef-bbff-50f2-8f89-41fe96327311" :answer/type :answer.type/math :answer/value "\\frac{f-1}{7}" :db/ensure [:answer/validate]} {:db/id "answer-0ec3b03a-6d8e-5507-9613-b52e86bfd1b0" :answer/id #uuid "0ec3b03a-6d8e-5507-9613-b52e86bfd1b0" :answer/type :answer.type/math :answer/value "\\frac{f-7}{7}" :db/ensure [:answer/validate]} {:db/id "question-c402ae86-03e2-521f-97be-fa33095984c9" :question/id #uuid "c402ae86-03e2-521f-97be-fa33095984c9" :question/math-academy-id "q-100026" :question/problem "$-\\frac{7}{4}\\,(-h)$ is equivalent to" :question/worked-solution "First, remember that the product of two negative numbers is a positive number. Thus, \n\n$$\n-\\frac{7}{4}(-h)=\\frac{7}{4}h.\n$$\n\nNow, writing $h$ as $\\frac{h}{1},$ we have\n\n$$\n\\begin{aligned}\\frac{7}{4}h & =\\frac{7}{4}\\cdot h \\\\  & =\\frac{7}{4}\\cdot \\frac{h}{1} \\\\  & =\\frac{7\\cdot h}{4\\cdot 1} \\\\  & =\\frac{7h}{4}.\\end{aligned}\n$$\n\nThus, the expressions $-\\frac{7}{4}(-h)$ and $\\frac{7h}{4}$ are equivalent." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6f565cbf-acd2-515d-897e-857c7b678992"] :db/ensure [:question/validate]} {:db/id "answer-field-6f565cbf-acd2-515d-897e-857c7b678992" :answer-field/id #uuid "6f565cbf-acd2-515d-897e-857c7b678992" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fb2c5c25-35ea-5961-8a0b-b89d157dcc9e" :answer-field/choices ["answer-21ee8460-7b54-5b03-bcf8-fa08792bb084" "answer-8fbfa788-ef11-5737-9121-c1d00db0f98c" "answer-a670f552-d694-5993-af51-941d6a61b163" "answer-fb2c5c25-35ea-5961-8a0b-b89d157dcc9e" "answer-371b3702-d4a0-55a7-b4c5-68d47387ea73"] :db/ensure [:answer-field/validate]} {:db/id "answer-21ee8460-7b54-5b03-bcf8-fa08792bb084" :answer/id #uuid "21ee8460-7b54-5b03-bcf8-fa08792bb084" :answer/type :answer.type/math :answer/value "-\\frac{7h}{2}" :db/ensure [:answer/validate]} {:db/id "answer-8fbfa788-ef11-5737-9121-c1d00db0f98c" :answer/id #uuid "8fbfa788-ef11-5737-9121-c1d00db0f98c" :answer/type :answer.type/math :answer/value "-\\frac{h}{2}" :db/ensure [:answer/validate]} {:db/id "answer-a670f552-d694-5993-af51-941d6a61b163" :answer/id #uuid "a670f552-d694-5993-af51-941d6a61b163" :answer/type :answer.type/math :answer/value "\\frac{4h}{7}" :db/ensure [:answer/validate]} {:db/id "answer-fb2c5c25-35ea-5961-8a0b-b89d157dcc9e" :answer/id #uuid "fb2c5c25-35ea-5961-8a0b-b89d157dcc9e" :answer/type :answer.type/math :answer/value "\\frac{7h}{4}" :db/ensure [:answer/validate]} {:db/id "answer-371b3702-d4a0-55a7-b4c5-68d47387ea73" :answer/id #uuid "371b3702-d4a0-55a7-b4c5-68d47387ea73" :answer/type :answer.type/math :answer/value "\\frac{h}{4}" :db/ensure [:answer/validate]} {:db/id "question-1e7a5473-d897-50f6-be12-c307a084dd8c" :question/id #uuid "1e7a5473-d897-50f6-be12-c307a084dd8c" :question/math-academy-id "q-51638" :question/problem "The expression $\\frac{4}{5}\\,(n-2)$ is equivalent to" :question/worked-solution "Using the definition for the product of two fractions,  we have\n\n$$\n\\begin{aligned}\\frac{4}{5}\\,(n-2) & =\\frac{4}{5}\\cdot (n-2) \\\\  & =\\frac{4}{5}\\cdot \\frac{n-2}{1} \\\\  & =\\frac{4\\cdot (n-2)}{5\\cdot 1} \\\\  & =\\frac{4(n-2)}{5}\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-52756e18-cbaa-5594-99c5-fa0b8fb2e611"] :db/ensure [:question/validate]} {:db/id "answer-field-52756e18-cbaa-5594-99c5-fa0b8fb2e611" :answer-field/id #uuid "52756e18-cbaa-5594-99c5-fa0b8fb2e611" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-23ea4c59-1bb5-5c81-818d-1f17c052ea58" :answer-field/choices ["answer-23ea4c59-1bb5-5c81-818d-1f17c052ea58" "answer-7ba50e26-7ff9-5da3-b3f2-1f1906f04fad" "answer-e4b6487f-68d6-58bc-b6d8-952195e95a7a" "answer-e902e6e0-754a-544e-bede-9a17c9df9862" "answer-bfc69bc3-7ab0-500c-b718-bd48211ae4f1"] :db/ensure [:answer-field/validate]} {:db/id "answer-23ea4c59-1bb5-5c81-818d-1f17c052ea58" :answer/id #uuid "23ea4c59-1bb5-5c81-818d-1f17c052ea58" :answer/type :answer.type/math :answer/value "\\frac{4(n-2)}{5}" :db/ensure [:answer/validate]} {:db/id "answer-7ba50e26-7ff9-5da3-b3f2-1f1906f04fad" :answer/id #uuid "7ba50e26-7ff9-5da3-b3f2-1f1906f04fad" :answer/type :answer.type/math :answer/value "\\frac{4n-2}{5}" :db/ensure [:answer/validate]} {:db/id "answer-e4b6487f-68d6-58bc-b6d8-952195e95a7a" :answer/id #uuid "e4b6487f-68d6-58bc-b6d8-952195e95a7a" :answer/type :answer.type/math :answer/value "\\frac{n-12}{5}" :db/ensure [:answer/validate]} {:db/id "answer-e902e6e0-754a-544e-bede-9a17c9df9862" :answer/id #uuid "e902e6e0-754a-544e-bede-9a17c9df9862" :answer/type :answer.type/math :answer/value "\\frac{n-2}{20}" :db/ensure [:answer/validate]} {:db/id "answer-bfc69bc3-7a