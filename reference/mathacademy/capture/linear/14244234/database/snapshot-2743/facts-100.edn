38 #edb/ref 17592186152869 #edb/ref 17592186045417] [17592186152145 #edb/ref 1038 #edb/ref 17592186497331 #edb/ref 17592186045417] [17592186152145 #edb/ref 1038 #edb/ref 17592186497349 #edb/ref 17592186045417] [17592186152145 #edb/ref 1038 #edb/ref 17592186497374 #edb/ref 17592186045417] [17592186152145 #edb/ref 1038 #edb/ref 17592186516804 #edb/ref 17592186045417] [17592186152145 #edb/ref 1039 "Interpreting Data From Proportional Relationships" #edb/ref 17592186045417] [17592186152145 #edb/ref 1041 #edb/ref 17592186151830 #edb/ref 17592186045417] [17592186152145 #edb/ref 1042 #uuid "bea5c8e3-3a8e-58a6-b289-84137c2b60cf" #edb/ref 17592186045417] [17592186152311 #edb/ref 1043 #edb/ref 17592186153033 #edb/ref 17592186045417] [17592186152311 #edb/ref 1043 #edb/ref 17592186153034 #edb/ref 17592186045417] [17592186152311 #edb/ref 1043 #edb/ref 17592186153035 #edb/ref 17592186045417] [17592186152311 #edb/ref 1043 #edb/ref 17592186153036 #edb/ref 17592186045417] [17592186152311 #edb/ref 1043 #edb/ref 17592186153037 #edb/ref 17592186045417] [17592186152311 #edb/ref 1043 #edb/ref 17592186153038 #edb/ref 17592186045417] [17592186152311 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186152311 #edb/ref 1045 "Understanding Proportional Relationships Using Tables" #edb/ref 17592186045417] [17592186152311 #edb/ref 1046 #edb/ref 17592186153033 #edb/ref 17592186045417] [17592186152311 #edb/ref 1049 #edb/ref 17592186049405 #edb/ref 17592186045417] [17592186152311 #edb/ref 1050 480.0 #edb/ref 17592186045417] [17592186152311 #edb/ref 1053 #uuid "e1e5c1d4-ae13-5c28-8065-9304d1a284b4" #edb/ref 17592186045417] [17592186153033 #edb/ref 1058 #edb/ref 17592186153034 #edb/ref 17592186045417] [17592186153033 #edb/ref 1061 186936 #edb/ref 17592186045417] [17592186153033 #edb/ref 1062 #uuid "8723b6ec-51b3-591f-8a78-8d66a882e2c0" #edb/ref 17592186045417] [17592186153033 #edb/ref 1063 #edb/ref 17592186153438 #edb/ref 17592186045417] [17592186153034 #edb/ref 1058 #edb/ref 17592186153035 #edb/ref 17592186045417] [17592186153034 #edb/ref 1061 186937 #edb/ref 17592186045417] [17592186153034 #edb/ref 1062 #uuid "86063632-706f-5896-a287-131371bbfac1" #edb/ref 17592186045417] [17592186153034 #edb/ref 1063 #edb/ref 17592186152142 #edb/ref 17592186045417] [17592186153035 #edb/ref 1058 #edb/ref 17592186153036 #edb/ref 17592186045417] [17592186153035 #edb/ref 1061 186940 #edb/ref 17592186045417] [17592186153035 #edb/ref 1062 #uuid "174d042b-40fb-57f2-912b-20fe1548d308" #edb/ref 17592186045417] [17592186153035 #edb/ref 1063 #edb/ref 17592186152143 #edb/ref 17592186045417] [17592186153036 #edb/ref 1058 #edb/ref 17592186153037 #edb/ref 17592186045417] [17592186153036 #edb/ref 1061 186944 #edb/ref 17592186045417] [17592186153036 #edb/ref 1062 #uuid "387c9c18-edb6-507f-8ae3-d5a4d7a375b6" #edb/ref 17592186045417] [17592186153036 #edb/ref 1063 #edb/ref 17592186153439 #edb/ref 17592186045417] [17592186153037 #edb/ref 1058 #edb/ref 17592186153038 #edb/ref 17592186045417] [17592186153037 #edb/ref 1061 186945 #edb/ref 17592186045417] [17592186153037 #edb/ref 1062 #uuid "4a43a0a6-a976-52ad-b7ac-89aca2144fe1" #edb/ref 17592186045417] [17592186153037 #edb/ref 1063 #edb/ref 17592186152144 #edb/ref 17592186045417] [17592186153038 #edb/ref 1061 186948 #edb/ref 17592186045417] [17592186153038 #edb/ref 1062 #uuid "faaa86eb-acf9-5373-90c9-af1a462a10aa" #edb/ref 17592186045417] [17592186153038 #edb/ref 1063 #edb/ref 17592186152145 #edb/ref 17592186045417] [17592186153438 #edb/ref 1064 "Two variables, $x$ and $y,$ are said to have a **proportional relationship** if their ratio is constant. That is, for any $(x,y)$ pair, we have\n\n$$\nk = \\dfrac{y}{x}\n$$\n\nwhere $k$ is a fixed number called the **constant of proportionality** or **constant of variation.**\n\nAs a concrete example, let's consider the table below. \n\n| $x$ | $y$ |\n| --- | --- |\n| $1$ | $2$ |\n| $2$ | $4$ |\n| $4$ | $8$ |\n\nDo $x$ and $y$ have a proportional relationship?\n\nTo determine whether $x$ and $y$ have a proportional relationship, we first add a new $\\dfrac yx$ column:\n\n| $x$ | $y$ | $\\dfrac{y}{x}$ |\n| --- | --- | --- |\n| $1$ | $2$ |  |\n| $2$ | $4$ |  |\n| $4$ | $8$ |  |\n\nNext, we compute $\\dfrac yx$ for each row:\n\n| $x$ | $y$ | $\\dfrac{y}{x}$ |\n| --- | --- | --- |\n| $1$ | $2$ | $2\\div 1 = {\\color{blue}{2}}$ |\n| $2$ | $4$ | $4\\div 2 = {\\color{blue}{2}}$ |\n| $4$ | $8$ | $8\\div 4 = {\\color{blue}{2}}$ |\n\nSince all the entries in the third column have the same value, this table does indeed represent a proportional relationship. In this case, the constant of proportionality $k = {\\color{blue}{2}}.$" #edb/ref 17592186045417] [17592186153438 #edb/ref 1065 8207 #edb/ref 17592186045417] [17592186153438 #edb/ref 1066 #uuid "935405f7-2fd3-5fb6-a9ef-e3d74aa721b6" #edb/ref 17592186045417] [17592186153438 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186153439 #edb/ref 1064 "When the variables $x$ and $y$ form a proportional relationship, the ratio of any $(x,y)$ pair is constant:\n\n$$\n\\dfrac y x = k\n$$\n\nUsing the relationship between multiplication and division, we can rewrite this equation above as follows:\n\n$$\ny = kx\n$$" #edb/ref 17592186045417] [17592186153439 #edb/ref 1065 8208 #edb/ref 17592186045417] [17592186153439 #edb/ref 1066 #uuid "d635aed4-07fa-5ffc-a25c-f9d760dbed7f" #edb/ref 17592186045417] [17592186153439 #edb/ref 1067 "Finding the Equation of a Proportional Relationship" #edb/ref 17592186045417] [17592186179761 #edb/ref 1038 #edb/ref 17592186179915 #edb/ref 17592186045417] [17592186179761 #edb/ref 1038 #edb/ref 17592186180213 #edb/ref 17592186045417] [17592186179761 #edb/ref 1038 #edb/ref 17592186501226 #edb/ref 17592186045417] [17592186179761 #edb/ref 1038 #edb/ref 17592186501231 #edb/ref 17592186045417] [17592186179761 #edb/ref 1039 "Simplifying an Expression Given That Some Variables Are Negative" #edb/ref 17592186045417] [17592186179761 #edb/ref 1041 #edb/ref 17592186179461 #edb/ref 17592186045417] [17592186179761 #edb/ref 1042 #uuid "a7d2284f-c4ba-571f-91a6-be472f185c0b" #edb/ref 17592186045417] [17592186179762 #edb/ref 1037 #edb/ref 17592186049636 #edb/ref 17592186045417] [17592186179762 #edb/ref 1037 #edb/ref 17592186049843 #edb/ref 17592186045417] [17592186179762 #edb/ref 1038 #edb/ref 17592186180161 #edb/ref 17592186045417] [17592186179762 #edb/ref 1038 #edb/ref 17592186180216 #edb/ref 17592186045417] [17592186179762 #edb/ref 1038 #edb/ref 17592186501177 #edb/ref 17592186045417] [17592186179762 #edb/ref 1038 #edb/ref 17592186562486 #edb/ref 17592186045417] [17592186179762 #edb/ref 1039 "Simplifying an Expression Given That Some Variables Are Non-Negative" #edb/ref 17592186045417] [17592186179762 #edb/ref 1041 #edb/ref 17592186179462 #edb/ref 17592186045417] [17592186179762 #edb/ref 1042 #uuid "5b8f0a91-f0de-5907-9c96-eac8a3a0e7cf" #edb/ref 17592186045417] [17592186179879 #edb/ref 1043 #edb/ref 17592186180517 #edb/ref 17592186045417] [17592186179879 #edb/ref 1043 #edb/ref 17592186180521 #edb/ref 17592186045417] [17592186179879 #edb/ref 1043 #edb/ref 17592186180547 #edb/ref 17592186045417] [17592186179879 #edb/ref 1043 #edb/ref 17592186180548 #edb/ref 17592186045417] [17592186179879 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186179879 #edb/ref 1045 "The Square Root of a Perfect Square With Domain Restrictions" #edb/ref 17592186045417] [17592186179879 #edb/ref 1046 #edb/ref 17592186180517 #edb/ref 17592186045417] [17592186179879 #edb/ref 1049 #edb/ref 17592186050890 #edb/ref 17592186045417] [17592186179879 #edb/ref 1050 420.0 #edb/ref 17592186045417] [17592186179879 #edb/ref 1053 #uuid "ae806ffe-8add-5f7b-a38d-5d4077cc72cb" #edb/ref 17592186045417]}
