#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186493985} :activity/id #uuid "1faba002-0fe8-5c3a-b172-4c31ffabe97e" :activity/scope {:db/id #edb/ref 17592186048207 :topic/id #uuid "886ced30-c0cc-548f-90c0-8a84697856ec" :topic/math-academy-id 3680} :activity/steps [{:db/id #edb/ref 17592186493985 :step/content {:db/id #edb/ref 17592186179939 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f71a683-7a1e-5254-83aa-435b95cefd8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3.2" :db/id #edb/ref 17592186177304} {:answer/id #uuid "ff238f2b-54fe-52a4-bede-85ada20612d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2.5" :db/id #edb/ref 17592186177305} {:answer/id #uuid "678029b8-8094-59ba-9f30-b8af5b59536a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2.2" :db/id #edb/ref 17592186177306} {:answer/id #uuid "67ba88b2-8670-57a3-ab0a-86430ddf9c80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3.1" :db/id #edb/ref 17592186177307} {:answer/id #uuid "7dd28e8b-8de3-50e0-833f-b5f4958b897e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2.8" :db/id #edb/ref 17592186177308}] :answer-field/correct {:db/id #edb/ref 17592186177308} :answer-field/id #uuid "990be945-bd50-539c-94a1-aafdbc3b95e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186177303}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "07a41ea1-448d-54d3-bef2-faec2900cf35" :question/math-academy-id "q-119565" :question/problem "$3-5.8=$" :question/worked-solution "Since $5.8$ is larger than $3,$ the answer will be negative.\n\nWe start by solving an easier problem, which is to carry out the subtraction in the reverse order:\n\n$$\n5.8-3=2.8\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n3-5.8=-2.8\n$$"} :step/id #uuid "27274a67-7e81-5979-85d8-f958ecda56fb" :step/next {:db/id #edb/ref 17592186494070}} {:db/id #edb/ref 17592186493999 :step/content {:db/id #edb/ref 17592186493935 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f51a08b5-544d-56bf-b524-00c4e402e1fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5.9" :db/id #edb/ref 17592186493786}] :answer-field/correct {:db/id #edb/ref 17592186493786} :answer-field/id #uuid "89d68d1f-65d8-579a-bcd1-d6d181a6133c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186493844}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8f920e3a-0555-530e-885c-0505096145f6" :question/math-academy-id "q-186102" :question/problem "$-3.6-2.3=${{field-1}}" :question/worked-solution "The answer will be negative since $-3.6$ is negative, and we're subtracting $2.3$ from it.\n\nWe start by solving an easier problem, which is to add their absolute values:\n\n$$\n3.6+2.3=5.9\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n-3.6-2.3=-5.9.\n$$"} :step/id #uuid "44f0d32e-1ab0-51b5-842a-9748e41b55ab"} {:db/id #edb/ref 17592186494070 :step/content {:db/id #edb/ref 17592186493907 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2862e84e-f462-5032-8dfa-808b3125fdc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1.3" :db/id #edb/ref 17592186493456} {:answer/id #uuid "41078b77-96a0-5f7c-bb94-1be5ec73d85e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2.3" :db/id #edb/ref 17592186493502} {:answer/id #uuid "823212ce-1cfb-5c75-bb92-ea01b8f7d8f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1.7" :db/id #edb/ref 17592186493597} {:answer/id #uuid "b7bebb8b-c4ab-5271-bbaa-eee64c1d8059" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2.7" :db/id #edb/ref 17592186493689} {:answer/id #uuid "de59e0c6-68e6-5941-9e8b-b9a2293c2c62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-14.7" :db/id #edb/ref 17592186493741}] :answer-field/correct {:db/id #edb/ref 17592186493689} :answer-field/id #uuid "256bfffe-3c5a-55f0-9609-ab2ee806e2e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493810}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2d4d7236-1971-52db-b086-a77353f5fe00" :question/math-academy-id "q-128150" :question/problem "$6-8.7=$" :question/worked-solution "Since $8.7$ is larger than $6,$ the answer will be negative.\n\nWe start by solving an easier problem, which is to carry out the subtraction in the reverse order:\n\n$$\n8.7-6=2.7\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n6-8.7=-2.7\n$$"} :step/id #uuid "f559c8d7-8fa9-505d-b2c5-2de1201ff6c8" :step/next {:db/id #edb/ref 17592186493999}}] :activity/title "Subtracting a Positive Decimal From a Smaller Decimal" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186493368}]}
