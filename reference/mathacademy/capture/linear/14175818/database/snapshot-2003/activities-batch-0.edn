#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186180626} :activity/id #uuid "171b476e-9322-594d-b1d2-c603a90f1b67" :activity/scope {:db/id #edb/ref 17592186048207 :topic/id #uuid "886ced30-c0cc-548f-90c0-8a84697856ec" :topic/math-academy-id 3680} :activity/steps [{:db/id #edb/ref 17592186180626 :step/content {:db/id #edb/ref 17592186180777 :tutorial/content "Suppose we want to solve the following subtraction problem:\n\n$$\n2 - 4.5\n$$\n\nWe can solve this problem using a number line. \n\nTo subtract $4.5$ from $2,$ we break up $4.5$ into its whole number part ($4$) and its decimal part ($0.5$) and proceed in two steps.\n\n- First, we subtract the whole number part. We start at $2$ on the number line and move $4$ places to the left, which brings us to $-2.$\n\n- Then, we subtract the decimal part. We move the remaining $0.5$ places to the left, leaving us at $-2.5.$\n\n![](images/e7/e79d6ec2413d47e2b2b67237194a057d802746d1b9b016dcf118ca91b2bf31df.png)\n\nTherefore, we conclude that \n\n$$\n2 - 4.5 = -2.5.\n$$" :tutorial/id #uuid "1e60ed87-2f30-5d4d-9d0b-990a5f1b8e1f" :tutorial/math-academy-id 8384 :tutorial/title "Introduction"} :step/id #uuid "8566447b-d96f-5adc-9b6e-c089a3f423a4" :step/math-academy-id 75114 :step/next {:db/id #edb/ref 17592186180627}} {:db/id #edb/ref 17592186180627 :step/content {:db/id #edb/ref 17592186179812 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179458 :question/id #uuid "0e9e4dd1-3161-5d3c-afab-5514e1c2d0d4" :question/math-academy-id "e-13383"} :knowledge-point/id #uuid "44b96053-1ffa-56d3-8129-15ada765b9a7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048549} {:db/id #edb/ref 17592186048911} {:db/id #edb/ref 17592186049097}] :knowledge-point/questions [{:db/id #edb/ref 17592186180189} {:db/id #edb/ref 17592186180191} {:db/id #edb/ref 17592186444435} {:db/id #edb/ref 17592186444436} {:db/id #edb/ref 17592186444438} {:db/id #edb/ref 17592186444439} {:db/id #edb/ref 17592186444440}] :knowledge-point/title "Subtracting Positive Decimals From Decimals With Halves"} :step/id #uuid "6c4541f7-07d8-51f6-b705-9bb2d82f1069" :step/math-academy-id 75115 :step/next {:db/id #edb/ref 17592186180628}} {:db/id #edb/ref 17592186180628 :step/content {:db/id #edb/ref 17592186180778 :tutorial/content "We can use the same methods that we learned to subtract whole numbers in more complicated situations.\n\nAs an example, let's consider the following problem:\n\n$$\n{\\color{red}{3.5}} - {\\color{blue}{9.8}}\n$$\n\nWe're subtracting a *positive* decimal from a smaller *positive* decimal. So the final answer must be negative. \n\nWe start by solving the following easier problem, which is to carry out the subtraction *in the reverse order*:\n\n$$\n{\\color{blue}{9.8}} - {\\color{red}{3.5}} = 6.3\n$$\n\nHowever, since our final answer must be negative, we conclude that\n\n$$\n{\\color{red}{3.5}} - {\\color{blue}{9.8}} = -6.3\n$$" :tutorial/id #uuid "b35021fd-095a-5cca-9a9e-24ce11a93ae2" :tutorial/math-academy-id 8385 :tutorial/title "Subtracting Positive Decimals From Positive Decimals"} :step/id #uuid "56a03151-c084-5924-9eca-03e11afc4c98" :step/math-academy-id 75118 :step/next {:db/id #edb/ref 17592186180629}} {:db/id #edb/ref 17592186180629 :step/content {:db/id #edb/ref 17592186180779 :tutorial/content "Now suppose we have the following problem:\n\n$$\n-3.2 - 6.4\n$$\n\nIn this case, we're subtracting a *positive* decimal from a *negative* decimal. So the final answer must be negative. \n\nWe start by solving the following easier problem, which is to *add their absolute values*:\n\n$$\n3.2+6.4 = 9.6\n$$\n\nHowever, since our final answer must be negative, we conclude that\n\n$$\n-3.2 - 6.4 = -9.6\n$$\n\n \n\n**Remember**\n\n- When we subtract a *positive* number from a smaller *positive* number, we carry out the subtraction *in the reverse order* and then make the final answer negative.\n\n- When we subtract a *positive* number from a *negative* number, we *add their absolute values* and then make the final answer negative." :tutorial/id #uuid "93e4bd99-076c-5ac9-9c1b-362ae1e66e8f" :tutorial/math-academy-id 8386 :tutorial/title "Subtracting Positive Decimals From Negative Decimals"} :step/id #uuid "a503405f-0d74-5b80-9c37-8d32b6f8da23" :step/math-academy-id 75119 :step/next {:db/id #edb/ref 17592186180630}} {:db/id #edb/ref 17592186180630 :step/content {:db/id #edb/ref 17592186179813 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179459 :question/id #uuid "6bd42661-9814-51ce-a359-39bd54aff3e7" :question/math-academy-id "e-13384"} :knowledge-point/id #uuid "507d4d46-699c-5b4f-a010-66aec6abef67" :knowledge-point/questions [{:db/id #edb/ref 17592186179932} {:db/id #edb/ref 17592186179935} {:db/id #edb/ref 17592186444441} {:db/id #edb/ref 17592186444444} {:db/id #edb/ref 17592186444445} {:db/id #edb/ref 17592186444447} {:db/id #edb/ref 17592186444448} {:db/id #edb/ref 17592186493935}] :knowledge-point/title "Subtracting Positive Decimals From Decimals"} :step/id #uuid "96ee8d90-d6bf-59b8-a1c3-bf6554a1e0f9" :step/math-academy-id 75120 :step/next {:db/id #edb/ref 17592186180631}} {:db/id #edb/ref 17592186180631 :step/content {:db/id #edb/ref 17592186179814 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179460 :question/id #uuid "45b45968-91b2-5ed4-86c2-51d31e02b714" :question/math-academy-id "e-13385"} :knowledge-point/id #uuid "778ae1c8-c651-56f1-ab58-1817d3fe4bb9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048588}] :knowledge-point/questions [{:db/id #edb/ref 17592186179938} {:db/id #edb/ref 17592186179939} {:db/id #edb/ref 17592186444437} {:db/id #edb/ref 17592186444442} {:db/id #edb/ref 17592186444443} {:db/id #edb/ref 17592186444446} {:db/id #edb/ref 17592186444449} {:db/id #edb/ref 17592186493907}] :knowledge-point/title "Subtracting Positive Decimals From Decimals With Unequal Numbers of Decimals"} :step/id #uuid "ef013d16-ba95-5bba-b84c-4f5db1abc151" :step/math-academy-id 75123}] :activity/title "Subtracting a Positive Decimal From a Smaller Decimal" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179836}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186493985} :activity/id #uuid "1faba002-0fe8-5c3a-b172-4c31ffabe97e" :activity/scope {:db/id #edb/ref 17592186048207 :topic/id #uuid "886ced30-c0cc-548f-90c0-8a84697856ec" :topic/math-academy-id 3680} :activity/steps [{:db/id #edb/ref 17592186493985 :step/content {:db/id #edb/ref 17592186179939 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f71a683-7a1e-5254-83aa-435b95cefd8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3.2" :db/id #edb/ref 17592186177304} {:answer/id #uuid "ff238f2b-54fe-52a4-bede-85ada20612d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2.5" :db/id #edb/ref 17592186177305} {:answer/id #uuid "678029b8-8094-59ba-9f30-b8af5b59536a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2.2" :db/id #edb/ref 17592186177306} {:answer/id #uuid "67ba88b2-8670-57a3-ab0a-86430ddf9c80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3.1" :db/id #edb/ref 17592186177307} {:answer/id #uuid "7dd28e8b-8de3-50e0-833f-b5f4958b897e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2.8" :db/id #edb/ref 17592186177308}] :answer-field/correct {:db/id #edb/ref 17592186177308} :answer-field/id #uuid "990be945-bd50-539c-94a1-aafdbc3b95e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186177303}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "07a41ea1-448d-54d3-bef2-faec2900cf35" :question/math-academy-id "q-119565" :question/problem "$3-5.8=$" :question/worked-solution "Since $5.8$ is larger than $3,$ the answer will be negative.\n\nWe start by solving an easier problem, which is to carry out the subtraction in the reverse order:\n\n$$\n5.8-3=2.8\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n3-5.8=-2.8\n$$"} :step/id #uuid "27274a67-7e81-5979-85d8-f958ecda56fb" :step/next {:db/id #edb/ref 17592186494070}} {:db/id #edb/ref 17592186493999 :step/content {:db/id #edb/ref 17592186493935 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f51a08b5-544d-56bf-b524-00c4e402e1fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5.9" :db/id #edb/ref 17592186493786}] :answer-field/correct {:db/id #edb/ref 17592186493786} :answer-field/id #uuid "89d68d1f-65d8-579a-bcd1-d6d181a6133c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186493844}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8f920e3a-0555-530e-885c-0505096145f6" :question/math-academy-id "q-186102" :question/problem "$-3.6-2.3=${{field-1}}" :question/worked-solution "The answer will be negative since $-3.6$ is negative, and we're subtracting $2.3$ from it.\n\nWe start by solving an easier problem, which is to add their absolute values:\n\n$$\n3.6+2.3=5.9\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n-3.6-2.3=-5.9.\n$$"} :step/id #uuid "44f0d32e-1ab0-51b5-842a-9748e41b55ab"} {:db/id #edb/ref 17592186494070 :step/content {:db/id #edb/ref 17592186493907 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2862e84e-f462-5032-8dfa-808b3125fdc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1.3" :db/id #edb/ref 17592186493456} {:answer/id #uuid "41078b77-96a0-5f7c-bb94-1be5ec73d85e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2.3" :db/id #edb/ref 17592186493502} {:answer/id #uuid "823212ce-1cfb-5c75-bb92-ea01b8f7d8f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1.7" :db/id #edb/ref 17592186493597} {:answer/id #uuid "b7bebb8b-c4ab-5271-bbaa-eee64c1d8059" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2.7" :db/id #edb/ref 17592186493689} {:answer/id #uuid "de59e0c6-68e6-5941-9e8b-b9a2293c2c62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-14.7" :db/id #edb/ref 17592186493741}] :answer-field/correct {:db/id #edb/ref 17592186493689} :answer-field/id #uuid "256bfffe-3c5a-55f0-9609-ab2ee806e2e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493810}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2d4d7236-1971-52db-b086-a77353f5fe00" :question/math-academy-id "q-128150" :question/problem "$6-8.7=$" :question/worked-solution "Since $8.7$ is larger than $6,$ the answer will be negative.\n\nWe start by solving an easier problem, which is to carry out the subtraction in the reverse order:\n\n$$\n8.7-6=2.7\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n6-8.7=-2.7\n$$"} :step/id #uuid "f559c8d7-8fa9-505d-b2c5-2de1201ff6c8" :step/next {:db/id #edb/ref 17592186493999}}] :activity/title "Subtracting a Positive Decimal From a Smaller Decimal" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186493368}]}
