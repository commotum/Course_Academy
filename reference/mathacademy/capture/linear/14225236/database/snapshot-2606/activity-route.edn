#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186542258} :activity/id #uuid "672652bb-f97d-53e5-ac91-2daa74826e74" :activity/scope {:db/id #edb/ref 17592186051084 :topic/id #uuid "7fcc3a06-676a-55a2-9979-d3726053babe" :topic/math-academy-id 1108} :activity/steps [{:db/id #edb/ref 17592186542241 :step/content {:db/id #edb/ref 17592186317327 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc8b5aee-000a-5a8d-818f-e20c5debd3ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20(4x+3)^{4}" :db/id #edb/ref 17592186316184} {:answer/id #uuid "7c419ad2-83cf-57c7-b5a2-d7c1c6a8cf6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20(4x+3)^4" :db/id #edb/ref 17592186541677}] :answer-field/correct {:db/id #edb/ref 17592186541677} :answer-field/id #uuid "625a79d7-54d7-570b-aa7c-729d582ac660" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186316778}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9ebc59fe-5ccc-59b1-9757-9c760459c2ae" :question/math-academy-id "q-342804" :question/problem "Given that $f(x)={(4x+3)}^{5},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "Let $g(x)=4x+3$ and $f(g(x))=g(x)^{5}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & =({g}^{5})^{′}=5{g}^{4}, \\\\ {g}^{′}(x) & =(4x+3)^{′}=4.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =5{g}^{4}\\cdot (4) \\\\  & =20(4x+3)^{4}.\\end{aligned}\n$$"} :step/id #uuid "262d4a97-2a24-516f-befc-4aec82c20974"} {:db/id #edb/ref 17592186542258 :step/content {:db/id #edb/ref 17592186542221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "365d6570-d8cb-539f-a88f-8f59a136deaa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{145}{2}" :db/id #edb/ref 17592186541535} {:answer/id #uuid "a8e65a94-bc73-5511-b4e0-737b7fd4a52d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186541771} {:answer/id #uuid "ba942dc9-148d-5089-895a-5986590e89c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{289}{2}" :db/id #edb/ref 17592186541806} {:answer/id #uuid "dfa31f6a-0231-55ef-b7c1-eda435cc6895" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{73}{2}" :db/id #edb/ref 17592186541897} {:answer/id #uuid "fb45a9d2-d3cd-5774-a7e6-b9653552ab14" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{33}{2}" :db/id #edb/ref 17592186541949}] :answer-field/correct {:db/id #edb/ref 17592186541806} :answer-field/id #uuid "02bb9c7f-0a51-5ad4-a60d-65bfb06add50" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186541965}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ed421aa6-2e1d-544f-a145-c01b981f6e83" :question/math-academy-id "q-20181" :question/problem "Find the slope of the tangent to the curve $y=\\sqrt{x-3}+3{x}^{3}$ at the point where $x=4.$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nLet $f(x)=\\sqrt{x-3}.$ We use the chain rule in the form\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=x-3.$ Then $f=\\sqrt{u}={u}^{1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=\\frac{1}{2}{u}^{-1/2}=\\frac{1}{2\\sqrt{u}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot 1 \\\\  & =\\frac{1}{2\\sqrt{u}} \\\\  & =\\frac{1}{2\\sqrt{x-3}}.\\end{aligned}\n$$\n\nApplying the sum rule, we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{2\\sqrt{x-3}}+9{x}^{2}.\n$$\n\nFinally, substituting $x=4,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=4} & =\\frac{1}{2\\sqrt{4-3}}+9(4)^{2} \\\\  & =\\frac{1}{2}+144 \\\\  & =\\frac{289}{2}.\\end{aligned}\n$$"} :step/id #uuid "68e702e2-55d1-5021-9663-e37aa362023f" :step/next {:db/id #edb/ref 17592186542278}} {:db/id #edb/ref 17592186542278 :step/content {:db/id #edb/ref 17592186542130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "496974f1-cd7b-5abe-b03b-8caf3c2ef7ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186541574}] :answer-field/correct {:db/id #edb/ref 17592186541574} :answer-field/id #uuid "6df6c47b-c813-591d-800c-7da989a956a4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186542020}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "316d8b52-05f5-5660-9987-6f2357a674ed" :question/math-academy-id "q-342789" :question/problem "The slope of the tangent to the curve $y=\\sqrt{-{x}^{2}+2x}$ at the point where $x=1$ is{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=-{x}^{2}+2x.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2x+2.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot (-2x+2) \\\\  & =\\frac{-2x+2}{2\\sqrt{-{x}^{2}+2x}}.\\end{aligned}\n$$\n\nFinally, substituting $x=1,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{-2x+2}{2\\sqrt{-{x}^{2}+2x}})|}_{x=1} \\\\  & =\\frac{-2(1)+2}{2\\sqrt{-{1}^{2}+2(1)}} \\\\  & =\\frac{0}{2\\sqrt{1}} \\\\  & =0.\\end{aligned}\n$$"} :step/id #uuid "dd09ffd1-587d-547b-937b-c610cc67ad37" :step/next {:db/id #edb/ref 17592186542241}}] :activity/title "The Chain Rule for Differentiation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186541420}]}
