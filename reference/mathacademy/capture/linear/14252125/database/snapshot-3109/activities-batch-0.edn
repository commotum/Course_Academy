db/ref 17592186566277 :step/content {:db/id #edb/ref 17592186566239 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2194c414-3f47-5f2b-ac54-1499746d5c9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y<\\frac{7}{3}" :db/id #edb/ref 17592186565734} {:answer/id #uuid "2824e734-1d0e-59ba-9fa3-74ca7138f894" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y<-3" :db/id #edb/ref 17592186565742} {:answer/id #uuid "57a09a4a-eca2-51d2-adf2-83b39061ac56" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y>-3" :db/id #edb/ref 17592186565823} {:answer/id #uuid "687c3b63-c49a-5b4f-a05a-69ec916c4557" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y>-\\frac{7}{3}" :db/id #edb/ref 17592186565839} {:answer/id #uuid "8ff2dbd3-daef-550b-944a-1e868b75ca46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y<3" :db/id #edb/ref 17592186565907}] :answer-field/correct {:db/id #edb/ref 17592186565823} :answer-field/id #uuid "309cb488-1b6e-5abd-9b12-84b31690a593" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566125}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6cb83115-237f-5265-8ee0-e3661c1aa677" :question/math-academy-id "q-154330" :question/problem "Solve the inequality $8>-3y-1.$" :question/worked-solution "First, we apply the addition principle, adding $1$ to both sides:\n\n$$\n\\begin{aligned}8 & >-3y-1 \\\\ 8+1 & >-3y-1+1 \\\\ 9 & >-3y+0 \\\\ 9 & >-3y\\end{aligned}\n$$\n\nThen, we apply the multiplication principle, dividing both sides by $-3.$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}9\\,\\, & >\\,\\,-3y \\\\ \\frac{9}{-3}\\, & <\\,\\,\\frac{-3y}{-3} \\\\ -3\\, & <\\,\\,\\frac{\\cancel{-3}y}{\\cancel{-3}} \\\\ -3\\, & <\\,\\,y\\end{aligned}\n$$\n\nFinally, let's swap the left and right-hand sides so that the variable is on the left-hand side. Remember, we also need to flip the inequality.\n\n$$\ny>-3\n$$\n\nTherefore, the solution is $y>-3.$"} :step/id #uuid "0b6c0382-e0e6-5a11-acdd-801c9c98f6d5" :step/next {:db/id #edb/ref 17592186566282}} {:db/id #edb/ref 17592186566282 :step/content {:db/id #edb/ref 17592186566238 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b6d4d1f-fe13-5d6f-ad23-9e6fdadd762f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value ">" :db/id #edb/ref 17592186565845}] :answer-field/correct {:db/id #edb/ref 17592186565845} :answer-field/id #uuid "28989681-8083-513e-8cb9-ac9e3a421813" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566120} {:answer-field/choices [{:answer/id #uuid "0128a262-82a1-5207-9efa-8d990c844899" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186565676}] :answer-field/correct {:db/id #edb/ref 17592186565676} :answer-field/id #uuid "634bfe49-e89b-5d75-a701-ef10907af9e4" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566146}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6bc91ea0-3fcd-5fed-9f63-f013dbd34da2" :question/math-academy-id "q-176017" :question/problem "The solution to the inequality $-4x+5<-7$ is $x${{field-1}}{{field-2}}." :question/worked-solution "First, we apply the addition principle, subtracting $5$ from both sides:\n\n$$\n\\begin{aligned}-4x+5 & <-7 \\\\ -4x+5-5 & <-7-5 \\\\ -4x+0 & <-12 \\\\ -4x & <-12\\end{aligned}\n$$\n\nThen, we apply the multiplication principle, dividing both sides by $-4.$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-4x\\,\\, & <\\,\\,-12 \\\\ \\frac{-4x}{-4}\\, & >\\,\\,\\frac{-12}{-4} \\\\ \\frac{\\cancel{-4}x}{\\cancel{-4}}\\, & >\\,\\,3 \\\\ x\\,\\, & >\\,3\\end{aligned}\n$$\n\nTherefore, the solution is $x>3.$"} :step/id #uuid "206bf70a-edd4-5336-bda0-885ad4c20a15" :step/next {:db/id #edb/ref 17592186566301}} {:db/id #edb/ref 17592186566301 :step/content {:db/id #edb/ref 17592186566259 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3b21fd7-3a01-5064-9900-f721f255ee82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le" :db/id #edb/ref 17592186565965}] :answer-field/correct {:db/id #edb/ref 17592186565965} :answer-field/id #uuid "04e9947e-f17a-5a85-9520-49f3ca6f1715" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566103} {:answer-field/choices [{:answer/id #uuid "1e1ec133-84cc-5dfd-ab86-4c990c6b8e05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186565727}] :answer-field/correct {:db/id #edb/ref 17592186565727} :answer-field/id #uuid "7bf29e7a-3d2a-5b89-a970-2efcbd44a944" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566155}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b84140b5-0b6b-54d3-81ed-16117dd9ce00" :question/math-academy-id "q-176019" :question/problem "The solution to the inequality $-2x+10\\ge 4$ is $x${{field-1}}{{field-2}}." :question/worked-solution "First, we apply the addition principle, subtracting $10$ from both sides:\n\n$$\n\\begin{aligned}-2x+10 & \\ge 4 \\\\ -2x+10-10 & \\ge 4-10 \\\\ -2x+0 & \\ge -6 \\\\ -2x & \\ge -6\\end{aligned}\n$$\n\nThen, we apply the multiplication principle, dividing both sides by $-2.$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-2x\\,\\, & \\ge \\,\\,-6 \\\\ \\frac{-2x}{-2}\\, & \\le \\,\\,\\frac{-6}{-2} \\\\ \\frac{\\cancel{-2}x}{\\cancel{-2}}\\, & \\le \\,\\,3 \\\\ x\\,\\, & \\le \\,3\\end{aligned}\n$$\n\nTherefore, the solution is $x\\le 3.$"} :step/id #uuid "974300c1-4dd6-59e1-b165-c4b71f32045c"}] :activity/title "Solving Two-Step Inequalities" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186565670}]}
