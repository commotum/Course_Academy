#{[{:db/id #edb/ref 17592186572678 :knowledge-point/_questions [{:db/id #edb/ref 17592186192843 :knowledge-point/id #uuid "4cb884d3-1a4f-56aa-8628-b899f4eefacb" :knowledge-point/title "Solving Linear Inequalities When Flipping is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6feeef5c-dcc6-5b6c-99a5-a154469f7a1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186572444}] :answer-field/correct {:answer/id #uuid "6feeef5c-dcc6-5b6c-99a5-a154469f7a1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186572444} :answer-field/id #uuid "abe5a691-0dde-59ef-aeae-d67842711c04" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572636} {:answer-field/choices [{:answer/id #uuid "5a743f62-a91d-5623-8dd4-29eeb4c18ea0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186572424}] :answer-field/correct {:answer/id #uuid "5a743f62-a91d-5623-8dd4-29eeb4c18ea0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186572424} :answer-field/id #uuid "d30c22eb-2d07-5424-a15f-025543298f6b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572649}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "24db3001-b38e-58e0-a2db-d37c5cfbbf6a" :question/math-academy-id "q-177678" :question/problem "The solution to the inequality $-10x-13<17$ is$\\,x$\n{{field-1}}{{field-2}}." :question/worked-solution "First, we apply the addition principle, adding $13$ to both sides:\n\n$$\n\\begin{aligned}-10x-13 & <17 \\\\ -10x-13+13 & <17+13 \\\\ -10x+0 & <30 \\\\ -10x & <30\\end{aligned}\n$$\n\nThen, we apply the multiplication principle, dividing both sides by $-10.$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-10x\\,\\, & <\\,\\,30 \\\\ \\frac{-10x}{-10}\\, & >\\,\\,\\frac{30}{-10} \\\\ \\frac{\\cancel{-10}x}{\\cancel{-10}}\\, & >\\,\\,-3 \\\\ x\\,\\, & >\\,-3\\end{aligned}\n$$\n\nTherefore, the solution is $x>-3.$"}] [{:db/id #edb/ref 17592186572679 :knowledge-point/_questions [{:db/id #edb/ref 17592186192844 :knowledge-point/id #uuid "b6076650-101c-5fbf-bf47-9de8e6888288" :knowledge-point/title "Solving an Inequality and Adjusting the Final Result"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "149864cd-a4f9-5a32-a316-10a25d5c7f51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186572338}] :answer-field/correct {:answer/id #uuid "149864cd-a4f9-5a32-a316-10a25d5c7f51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186572338} :answer-field/id #uuid "4f06723b-7db7-528a-9b91-ba58a0a4a497" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572616} {:answer-field/choices [{:answer/id #uuid "1afbb936-56f0-5bfd-83bb-05a7b3ab155f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186572346}] :answer-field/correct {:answer/id #uuid "1afbb936-56f0-5bfd-83bb-05a7b3ab155f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186572346} :answer-field/id #uuid "d2881ca4-e313-595d-ad9a-e74eb7ec53fd" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572648}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "24f35f07-8a41-5d2b-b978-5fe26a8e2dc9" :question/math-academy-id "q-177686" :question/problem "The solution to the inequality $2<9y-7$ is $y${{field-1}}{{field-2}}." :question/worked-solution "First, we apply the addition principle, adding $7$ to both sides:\n\n$$\n\\begin{aligned}2 & <9y-7 \\\\ 2+7 & <9y-7+7 \\\\ 9 & <9y+0 \\\\ 9 & <9y\\end{aligned}\n$$\n\nSecond, we apply the multiplication principle, dividing both sides by $9:$\n\n$$\n\\begin{aligned}9 & <9y \\\\ \\frac{9}{9} & <\\frac{9y}{9} \\\\ 1 & <\\frac{\\cancel{9}y}{\\cancel{9}} \\\\ 1 & <y\\end{aligned}\n$$\n\nFinally, let's swap the left and right-hand sides so that the variable is on the left-hand side. Remember, we also need to flip the inequality.\n\n$$\ny>1\n$$\n\nTherefore, the solution is $y>1.$"}] [{:db/id #edb/ref 17592186572692 :knowledge-point/_questions [{:db/id #edb/ref 17592186192843 :knowledge-point/id #uuid "4cb884d3-1a4f-56aa-8628-b899f4eefacb" :knowledge-point/title "Solving Linear Inequalities When Flipping is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5984d0a1-af5a-506a-bd3d-f4742f93bd1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -6" :db/id #edb/ref 17592186572423} {:answer/id #uuid "ae2737bd-5a02-5f7d-b662-3be2c7a7a4b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le -4" :db/id #edb/ref 17592186572504} {:answer/id #uuid "b1bb3fec-7fa5-56c4-bdbc-f9b4538f570f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 2" :db/id #edb/ref 17592186572514} {:answer/id #uuid "b8c556c6-37e1-5b77-8d76-57fcbc0b4c3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le -6" :db/id #edb/ref 17592186572519} {:answer/id #uuid "c0d8ebb2-e776-553b-bcae-7b8cdfd081ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -4" :db/id #edb/ref 17592186572532}] :answer-field/correct {:answer/id #uuid "5984d0a1-af5a-506a-bd3d-f4742f93bd1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -6" :db/id #edb/ref 17592186572423} :answer-field/id #uuid "3e6e9bff-56b9-56a9-abf2-3f9a586746de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572612}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "599ba4ee-64d2-5b0c-a2ee-cad2a14843d9" :question/math-academy-id "q-29060" :question/problem "Solve the inequality $-2x-8\\le 4.$" :question/worked-solution "First, we apply the addition principle, adding $8$ to both sides:\n\n$$\n\\begin{aligned}-2x-8 & \\le 4 \\\\ -2x-8+8 & \\le 4+8 \\\\ -2x+0 & \\le 12 \\\\ -2x & \\le 12\\end{aligned}\n$$\n\nThen, we apply the multiplication principle, dividing both sides by $-2.$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-2x\\,\\, & \\le \\,\\,12 \\\\ \\frac{-2x}{-2}\\, & \\ge \\,\\,\\frac{12}{-2} \\\\ \\frac{\\cancel{-2}x}{\\cancel{-2}}\\, & \\ge \\,\\,-6 \\\\ x\\,\\, & \\ge \\,-6\\end{aligned}\n$$\n\nTherefore, the solution is $x\\ge -6.$"}]}
