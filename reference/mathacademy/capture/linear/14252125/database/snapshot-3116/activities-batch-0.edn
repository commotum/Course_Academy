uid "4e9c2678-4be0-55d7-9838-e4f11d55dccf" :topic/math-academy-id 4021} :activity/steps [{:db/id #edb/ref 17592186566277 :step/content {:db/id #edb/ref 17592186566239 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2194c414-3f47-5f2b-ac54-1499746d5c9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y<\\frac{7}{3}" :db/id #edb/ref 17592186565734} {:answer/id #uuid "2824e734-1d0e-59ba-9fa3-74ca7138f894" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y<-3" :db/id #edb/ref 17592186565742} {:answer/id #uuid "57a09a4a-eca2-51d2-adf2-83b39061ac56" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y>-3" :db/id #edb/ref 17592186565823} {:answer/id #uuid "687c3b63-c49a-5b4f-a05a-69ec916c4557" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y>-\\frac{7}{3}" :db/id #edb/ref 17592186565839} {:answer/id #uuid "8ff2dbd3-daef-550b-944a-1e868b75ca46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y<3" :db/id #edb/ref 17592186565907}] :answer-field/correct {:db/id #edb/ref 17592186565823} :answer-field/id #uuid "309cb488-1b6e-5abd-9b12-84b31690a593" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566125}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6cb83115-237f-5265-8ee0-e3661c1aa677" :question/math-academy-id "q-154330" :question/problem "Solve the inequality $8>-3y-1.$" :question/worked-solution "First, we apply the addition principle, adding $1$ to both sides:\n\n$$\n\\begin{aligned}8 & >-3y-1 \\\\ 8+1 & >-3y-1+1 \\\\ 9 & >-3y+0 \\\\ 9 & >-3y\\end{aligned}\n$$\n\nThen, we apply the multiplication principle, dividing both sides by $-3.$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}9\\,\\, & >\\,\\,-3y \\\\ \\frac{9}{-3}\\, & <\\,\\,\\frac{-3y}{-3} \\\\ -3\\, & <\\,\\,\\frac{\\cancel{-3}y}{\\cancel{-3}} \\\\ -3\\, & <\\,\\,y\\end{aligned}\n$$\n\nFinally, let's swap the left and right-hand sides so that the variable is on the left-hand side. Remember, we also need to flip the inequality.\n\n$$\ny>-3\n$$\n\nTherefore, the solution is $y>-3.$"} :step/id #uuid "0b6c0382-e0e6-5a11-acdd-801c9c98f6d5" :step/next {:db/id #edb/ref 17592186566282}} {:db/id #edb/ref 17592186566282 :step/content {:db/id #edb/ref 17592186566238 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b6d4d1f-fe13-5d6f-ad23-9e6fdadd762f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value ">" :db/id #edb/ref 17592186565845}] :answer-field/correct {:db/id #edb/ref 17592186565845} :answer-field/id #uuid "28989681-8083-513e-8cb9-ac9e3a421813" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566120} {:answer-field/choices [{:answer/id #uuid "0128a262-82a1-5207-9efa-8d990c844899" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186565676}] :answer-field/correct {:db/id #edb/ref 17592186565676} :answer-field/id #uuid "634bfe49-e89b-5d75-a701-ef10907af9e4" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566146}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6bc91ea0-3fcd-5fed-9f63-f013dbd34da2" :question/math-academy-id "q-176017" :question/problem "The solution to the inequality $-4x+5<-7$ is $x${{field-1}}{{field-2}}." :question/worked-solution "First, we apply the addition principle, subtracting $5$ from both sides:\n\n$$\n\\begin{aligned}-4x+5 & <-7 \\\\ -4x+5-5 & <-7-5 \\\\ -4x+0 & <-12 \\\\ -4x & <-12\\end{aligned}\n$$\n\nThen, we apply the multiplication principle, dividing both sides by $-4.$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-4x\\,\\, & <\\,\\,-12 \\\\ \\frac{-4x}{-4}\\, & >\\,\\,\\frac{-12}{-4} \\\\ \\frac{\\cancel{-4}x}{\\cancel{-4}}\\, & >\\,\\,3 \\\\ x\\,\\, & >\\,3\\end{aligned}\n$$\n\nTherefore, the solution is $x>3.$"} :step/id #uuid "206bf70a-edd4-5336-bda0-885ad4c20a15" :step/next {:db/id #edb/ref 17592186566301}} {:db/id #edb/ref 17592186566301 :step/content {:db/id #edb/ref 17592186566259 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3b21fd7-3a01-5064-9900-f721f255ee82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le" :db/id #edb/ref 17592186565965}] :answer-field/correct {:db/id #edb/ref 17592186565965} :answer-field/id #uuid "04e9947e-f17a-5a85-9520-49f3ca6f1715" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566103} {:answer-field/choices [{:answer/id #uuid "1e1ec133-84cc-5dfd-ab86-4c990c6b8e05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186565727}] :answer-field/correct {:db/id #edb/ref 17592186565727} :answer-field/id #uuid "7bf29e7a-3d2a-5b89-a970-2efcbd44a944" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566155}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b84140b5-0b6b-54d3-81ed-16117dd9ce00" :question/math-academy-id "q-176019" :question/problem "The solution to the inequality $-2x+10\\ge 4$ is $x${{field-1}}{{field-2}}." :question/worked-solution "First, we apply the addition principle, subtracting $10$ from both sides:\n\n$$\n\\begin{aligned}-2x+10 & \\ge 4 \\\\ -2x+10-10 & \\ge 4-10 \\\\ -2x+0 & \\ge -6 \\\\ -2x & \\ge -6\\end{aligned}\n$$\n\nThen, we apply the multiplication principle, dividing both sides by $-2.$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-2x\\,\\, & \\ge \\,\\,-6 \\\\ \\frac{-2x}{-2}\\, & \\le \\,\\,\\frac{-6}{-2} \\\\ \\frac{\\cancel{-2}x}{\\cancel{-2}}\\, & \\le \\,\\,3 \\\\ x\\,\\, & \\le \\,3\\end{aligned}\n$$\n\nTherefore, the solution is $x\\le 3.$"} :step/id #uuid "974300c1-4dd6-59e1-b165-c4b71f32045c"}] :activity/title "Solving Two-Step Inequalities" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186565670}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186572767} :activity/id #uuid "354f1928-0c7c-5c8c-acc7-4c998ed0685b" :activity/scope {:db/id #edb/ref 17592186050503 :topic/id #uuid "4e9c2678-4be0-55d7-9838-e4f11d55dccf" :topic/math-academy-id 4021} :activity/steps [{:db/id #edb/ref 17592186572767 :step/content {:db/id #edb/ref 17592186572692 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5984d0a1-af5a-506a-bd3d-f4742f93bd1e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge -6" :db/id #edb/ref 17592186572423} {:answer/id #uuid "ae2737bd-5a02-5f7d-b662-3be2c7a7a4b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\le -4" :db/id #edb/ref 17592186572504} {:answer/id #uuid "b1bb3fec-7fa5-56c4-bdbc-f9b4538f570f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge 2" :db/id #edb/ref 17592186572514} {:answer/id #uuid "b8c556c6-37e1-5b77-8d76-57fcbc0b4c3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\le -6" :db/id #edb/ref 17592186572519} {:answer/id #uuid "c0d8ebb2-e776-553b-bcae-7b8cdfd081ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge -4" :db/id #edb/ref 17592186572532}] :answer-field/correct {:db/id #edb/ref 17592186572423} :answer-field/id #uuid "3e6e9bff-56b9-56a9-abf2-3f9a586746de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186572612}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "599ba4ee-64d2-5b0c-a2ee-cad2a14843d9" :question/math-academy-id "q-29060" :question/problem "Solve the inequality $-2x-8\\le 4.$" :question/worked-solution "First, we apply the addition principle, adding $8$ to both sides:\n\n$$\n\\begin{aligned}-2x-8 & \\le 4 \\\\ -2x-8+8 & \\le 4+8 \\\\ -2x+0 & \\le 12 \\\\ -2x & \\le 12\\end{aligned}\n$$\n\nThen, we apply the multiplication principle, dividing both sides by $-2.$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-2x\\,\\, & \\le \\,\\,12 \\\\ \\frac{-2x}{-2}\\, & \\ge \\,\\,\\frac{12}{-2} \\\\ \\frac{\\cancel{-2}x}{\\cancel{-2}}\\, & \\ge \\,\\,-6 \\\\ x\\,\\, & \\ge \\,-6\\end{aligned}\n$$\n\nTherefore, the solution is $x\\ge -6.$"} :step/id #uuid "5eec0d80-9fb5-59b6-a142-c389b2152a0e" :step/next {:db/id #edb/ref 17592186572783}} {:db/id #edb/ref 17592186572783 :step/content {:db/id #edb/ref 17592186572678 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6feeef5c-dcc6-5b6c-99a5-a154469f7a1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186572444}] :answer-field/correct {:db/id #edb/ref 17592186572444} :answer-field/id #uuid "abe5a691-0dde-59ef-aeae-d67842711c04" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186572636} {:answer-field/choices [{:answer/id #uuid "5a743f62-a91d-5623-8dd4-29eeb4c18ea0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value ">" :db/id #edb/ref 17592186572424}] :answer-field/correct {:db/id #edb/ref 17592186572424} :answer-field/id #uuid "d30c22eb-2d07-5424-a15f-025543298f6b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186572649}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "24db3001-b38e-58e0-a2db-d37c5cfbbf6a" :question/math-academy-id "q-177678" :question/problem "The solution to the inequality $-10x-13<17$ is$\\,x$\n{{field-1}}{{field-2}}." :question/worked-solution "First, we apply the addition principle, adding $13$ to both sides:\n\n$$\n\\begin{aligned}-10x-13 & <17 \\\\ -10x-13+13 & <17+13 \\\\ -10x+0 & <30 \\\\ -10x & <30\\end{aligned}\n$$\n\nThen, we apply the multiplication principle, dividing both sides by $-10.$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-10x\\,\\, & <\\,\\,30 \\\\ \\frac{-10x}{-10}\\, & >\\,\\,\\frac{30}{-10} \\\\ \\frac{\\cancel{-10}x}{\\cancel{-10}}\\, & >\\,\\,-3 \\\\ x\\,\\, & >\\,-3\\end{aligned}\n$$\n\nTherefore, the solution is $x>-3.$"} :step/id #uuid "a1244929-29fe-56d1-a501-304c2c5033d4" :step/next {:db/id #edb/ref 17592186572794}} {:db/id #edb/ref 17592186572794 :step/content {:db/id #edb/ref 17592186572679 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "149864cd-a4f9-5a32-a316-10a25d5c7f51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value ">" :db/id #edb/ref 17592186572338}] :answer-field/correct {:db/id #edb/ref 17592186572338} :answer-field/id #uuid "4f06723b-7db7-528a-9b91-ba58a0a4a497" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186572616} {:answer-field/choices [{:answer/id #uuid "1afbb936-56f0-5bfd-83bb-05a7b3ab155f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186572346}] :answer-field/correct {:db/id #edb/ref 17592186572346} :answer-field/id #uuid "d2881ca4-e313-595d-ad9a-e74eb7ec53fd" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186572648}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "24f35f07-8a41-5d2b-b978-5fe26a8e2dc9" :question/math-academy-id "q-177686" :question/problem "The solution to the inequality $2<9y-7$ is $y${{field-1}}{{field-2}}." :question/worked-solution "First, we apply the addition principle, adding $7$ to both sides:\n\n$$\n\\begin{aligned}2 & <9y-7 \\\\ 2+7 & <9y-7+7 \\\\ 9 & <9y+0 \\\\ 9 & <9y\\end{aligned}\n$$\n\nSecond, we apply the multiplication principle, dividing both sides by $9:$\n\n$$\n\\begin{aligned}9 & <9y \\\\ \\frac{9}{9} & <\\frac{9y}{9} \\\\ 1 & <\\frac{\\cancel{9}y}{\\cancel{9}} \\\\ 1 & <y\\end{aligned}\n$$\n\nFinally, let's swap the left and right-hand sides so that the variable is on the left-hand side. Remember, we also need to flip the inequality.\n\n$$\ny>1\n$$\n\nTherefore, the solution is $y>1.$"} :step/id #uuid "c9d8eb0d-3333-565c-838b-ead042a6edcd"}] :activity/title "Solving Two-Step Inequalities" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186572300}]}
