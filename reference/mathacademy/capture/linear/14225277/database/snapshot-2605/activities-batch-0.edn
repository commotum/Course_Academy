#{[{:activity/first-step {:db/id #edb/ref 17592186111631} :activity/id #uuid "feae763a-2772-5c42-8d68-d26117ce10df" :activity/scope {:db/id #edb/ref 17592186050795 :topic/id #uuid "6795a15c-6464-519e-8d5a-863db0c700e4" :topic/math-academy-id 1456} :activity/steps [{:db/id #edb/ref 17592186111631 :step/content {:db/id #edb/ref 17592186111863 :tutorial/content "Suppose that we have an angle $\\theta$ in the coordinate plane positioned in the usual way. Its **reference angle**, denoted $\\theta_R$, is the smallest positive acute angle formed with the $x$-axis.\n\nFor example, let's consider the angles\n\n$$\n\\theta=45^\\circ, 135^\\circ, 225^\\circ\n$$\n\nand $315^\\circ$. These angles lie in the first, second, third, and fourth quadrants, respectively. And each of these angles has a reference angle\n\n$$\n\\theta_R = 45^\\circ\n$$\n\nas shown below.\n\n![](images/bf/bfba74ff2c6a69b3db1c9478f5caac4c31578ed93b47302a74d843b04fc6ee85.png)\n\n**Note:** Any reference angle always lies between $0^\\circ$ and $90^\\circ$ inclusively:\n\n$$\n0\\leq \\theta_R \\leq 90^\\circ\n$$" :tutorial/id #uuid "2338474e-8937-5e5e-88ae-7e7848bf2d6f" :tutorial/math-academy-id 2492 :tutorial/title "Introduction"} :step/id #uuid "2eb8ccdf-870a-5b82-b080-81cf456dd7a1" :step/math-academy-id 453317 :step/next {:db/id #edb/ref 17592186111632}} {:db/id #edb/ref 17592186111632 :step/content {:db/id #edb/ref 17592186110686 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110447 :question/id #uuid "1a73bf50-94b6-536b-8213-eb3d0b3ea1a3" :question/math-academy-id "e-3349"} :knowledge-point/id #uuid "e9655010-b852-53ec-a6ae-f3fc95cc50cb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049407}] :knowledge-point/questions [{:db/id #edb/ref 17592186110988} {:db/id #edb/ref 17592186111094} {:db/id #edb/ref 17592186111336}] :knowledge-point/title "Calculating a Reference Angle in Degrees"} :step/id #uuid "92a8408d-b6dc-5738-a411-4477ccccd35d" :step/math-academy-id 453318 :step/next {: