{3}}\\cdot \\sqrt[3]{2} & = \\\\ 3\\sqrt[3]{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134341 :knowledge-point/_questions [{:db/id #edb/ref 17592186133918 :knowledge-point/id #uuid "779a527b-c35d-5c94-b783-2e6eb117f00a" :knowledge-point/title "Evaluating a Radical Expression that Simplifies to a Whole Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ccb9dcd2-ad9c-51db-8cba-e6b93f38a4f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186132086} {:answer/id #uuid "d6362d98-55f0-59b6-bf66-a5f5e9cd508e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186132087} {:answer/id #uuid "01bfcdff-a1c3-5bfb-9af0-07c7e99e804e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186132088} {:answer/id #uuid "0ca01b39-dd93-59db-85be-dc46006a3834" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186132089} {:answer/id #uuid "5aba8c0b-2f21-56e2-a6b1-d990a7d89ea2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186132090}] :answer-field/correct {:answer/id #uuid "ccb9dcd2-ad9c-51db-8cba-e6b93f38a4f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186132086} :answer-field/id #uuid "478ebdd0-c2e2-5bc7-bf68-1074d3ed20bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186132085}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a9bd52dc-5c5c-5748-a35c-548249142332" :question/math-academy-id "q-41315" :question/problem "Evaluate $2\\sqrt{2x}+8$ when $x=18.$" :question/worked-solution "We replace $x$ with $18$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}2\\sqrt{2x}+8 & = \\\\ 2\\sqrt{2\\cdot 18}+8 & = \\\\ 2\\sqrt{36}+8 & = \\\\ 2\\sqrt{{6}^{2}}+8 & = \\\\ 2\\cdot 6+8 & = \\\\ 12+8 & = \\\\ 20\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186483381 :knowledge-point/_questions [{:db/id #edb/ref 17592186133918 :knowledge-point/id #uuid "779a527b-c35d-5c94-b783-2e6eb117f00a" :knowledge-point/title "Evaluating a Radical Expression that Simplifies to a Whole Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11619533-2dd2-5a3d-81c2-7ecb3d60408b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186482840} {:answer/id #uuid "2f3a61b6-3f9c-5e3a-93ac-ec4bc5edb44a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186482894} {:answer/id #uuid "55716078-9de3-567e-a8ba-7657ff811bd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186482961} {:answer/id #uuid "cc98a45c-95cd-5beb-b363-4ca699f09bda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186483153} {:answer/id #uuid "f63e6f58-7157-5263-bd40-2a29df7413e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186483228}] :answer-field/correct {:answer/id #uuid "2f3a61b6-3f9c-5e3a-93ac-ec4bc5edb44a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186482894} :answer-field/id #uuid "fce42114-c1b5-50a6-bf85-6ab3f5076bae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483342}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "835570d9-9990-53ad-94a8-897ce7e4ef85" :question/math-academy-id "q-41328" :question/problem "Find the value of $\\frac{1}{3}\\sqrt{3+3y-6x}$ when $x=-4$ and $y=3.$" :question/worked-solution "We replace $x$ with $-4$ and $y$ with $3$ in the given expression, and simplify as much as possible:\n\n$$\n\\begin{aligned}\\frac{1}{3}\\sqrt{3+3y-6x} & = \\\\ \\frac{1}{3}\\sqrt{3+3\\cdot 3-6\\cdot (-4)} & = \\\\ \\frac{1}{3}\\sqrt{3+9+24} & = \\\\ \\frac{1}{3}\\sqrt{36} & = \\\\ \\frac{1}{3}\\sqrt{{6}^{2}} & = \\\\ \\frac{1}{3}\\cdot 6 & = \\\\ 2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186483387 :knowledge-point/_questions [{:db/id #edb/ref 17592186133920 :knowledge-point/id #uuid "4accb1de-fe16-587c-b1e2-a3e59e4707fc" :knowledge-point/title "Evaluating a Radical Expression Containing Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14b446ee-925e-5150-9102-8ce738601644" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186482847} {:answer/id #uuid "4b1d7bf3-79e8-5f6a-a787-1942ef2d447c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186482944} {:answer/id #uuid "72ecac52-df71-5a38-a2de-7bbcc536ca98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186483012} {:answer/id #uuid "a32d3e56-29c9-5f9e-ae3b-31974d85ea9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186483087} {:answer/id #uuid "c5ffdf83-1221-565a-a1d5-b13a32ab5b2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186483142}] :answer-field/correct {:answer/id #uuid "a32d3e56-29c9-5f9e-ae3b-31974d85ea9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186483087} :answer-field/id #uuid "fb2688e1-5e14-5f96-96c0-66110c3015b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483340}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8f049718-46eb-5f7d-b555-f56c650c3d43" :question/math-academy-id "q-52468" :question/problem "Given $f(x)=\\frac{\\sqrt{6-x}}{\\sqrt{2x}},$ find $f(4).$" :question/worked-solution "We replace $x$ with $4$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}f(4) & =\\frac{\\sqrt{6-4}}{\\sqrt{2(4)}} \\\\  & =\\frac{\\sqrt{2}}{\\sqrt{8}} \\\\  & =\\sqrt{\\frac{2}{8}} \\\\  & =\\sqrt{\\frac{1}{4}} \\\\  & =\\frac{\\sqrt{1}}{\\sqrt{4}} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186483401 :knowledge-point/_questions [{:db/id #edb/ref 17592186133921 :knowledge-point/id #uuid "b3351708-be25-5d86-8aa8-f651263505be" :knowledge-point/title "Evaluating a Radical Expression Containing a Cube Root"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44c26405-c9e8-5b8d-b617-8a4c895247f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186482931} {:answer/id #uuid "6b981511-553b-51fd-9968-f5007d617ad5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}-\\sqrt[3]{4}" :db/id #edb/ref 17592186482998} {:answer/id #uuid "89e3ad7b-e29a-54e1-93c0-e9b1de54fa63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}-4\\sqrt[3]{2}" :db/id #edb/ref 17592186483054} {:answer/id #uuid "e462e986-00a1-584c-9e31-8de004506627" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}-\\sqrt[3]{2}" :db/id #edb/ref 17592186483197} {:answer/id #uuid "f5b60c12-92c3-5869-8174-2f4a7acd8cae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5-