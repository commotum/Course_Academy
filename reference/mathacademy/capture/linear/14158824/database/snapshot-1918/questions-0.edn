#{[{:db/id #edb/ref 17592186133524 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133918 :knowledge-point/id #uuid "779a527b-c35d-5c94-b783-2e6eb117f00a" :knowledge-point/title "Evaluating a Radical Expression that Simplifies to a Whole Number"}] :question/id #uuid "6488c7bd-4179-5b78-bdfc-92973f9a141f" :question/math-academy-id "e-1375" :question/problem "Evaluate $\\sqrt{x} + 2x -1$ when $x=16.$" :question/worked-solution "We replace $x$ with $16$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}\\sqrt{x}+2x-1 & = \\\\ \\sqrt{16}+2\\cdot 16-1 & = \\\\ \\sqrt{{4}^{2}}+32-1 & = \\\\ 4+32-1 & = \\\\ 35\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186133525 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133919 :knowledge-point/id #uuid "63a2c63d-2329-5679-b426-eea89828b39a" :knowledge-point/title "Evaluating a Radical Expression that Does Not Simplify to a Whole Number"}] :question/id #uuid "6c9e9059-c72a-5cd4-94ee-33cabb839cab" :question/math-academy-id "e-1377" :question/problem "Evaluate $\\sqrt{3x-1}$ for $x=3.$" :question/worked-solution "We replace $x$ with $3$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}\\sqrt{3x-1} & = \\\\ \\sqrt{3\\cdot 3-1} & = \\\\ \\sqrt{9-1} & = \\\\ \\sqrt{8} & \\end{aligned}\n$$\n\nWe can simplify even further using the product rule:\n\n$$\n\\begin{aligned}\\sqrt{8} & = \\\\ \\sqrt{4\\cdot 2} & = \\\\ \\sqrt{{2}^{2}\\cdot 2} & = \\\\ \\sqrt{{2}^{2}}\\cdot \\sqrt{2} & = \\\\ 2\\sqrt{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186133526 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133920 :knowledge-point/id #uuid "4accb1de-fe16-587c-b1e2-a3e59e4707fc" :knowledge-point/title "Evaluating a Radical Expression Containing Fractions"}] :question/id #uuid "94bd4811-8dca-542d-8c23-1950c9212a3b" :question/math-academy-id "e-1378" :question/problem "Given that $f(x) = \\dfrac{\\sqrt{9x+3}}{\\sqrt{x-2}},$ find  $f(5).$" :question/worked-solution "We replace $x$ with $5$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}f(5) & =\\frac{\\sqrt{9(5)+3}}{\\sqrt{(5)-2}} \\\\  & =\\frac{\\sqrt{48}}{\\sqrt{3}} \\\\  & =\\sqrt{\\frac{48}{3}} \\\\  & =\\sqrt{16} \\\\  & =\\sqrt{{4}^{2}} \\\\  & =4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186133527 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133921 :knowledge-point/id #uuid "b3351708-be25-5d86-8aa8-f651263505be" :knowledge-point/title "Evaluating a Radical Expression Containing a Cube Root"}] :question/id #uuid "5046e564-44ca-5e7b-bdbc-9388b5a30581" :question/math-academy-id "e-1379" :question/problem "Evaluate $\\sqrt[3]{x+6}$ at $x=2.$" :question/worked-solution "We replace $x$ with $2$ in the given expression, and simplify as much as possible:\n\n$$\n\\begin{aligned}\\sqrt[3]{x+6} & = \\\\ \\sqrt[3]{2+6} & = \\\\ \\sqrt[3]{8} & = \\\\ \\sqrt[3]{{2}^{3}} & = \\\\ 2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186483366 :knowledge-point/_questions [{:db/id #edb/ref 17592186133919 :knowledge-point/id #uuid "63a2c63d-2329-5679-b426-eea89828b39a" :knowledge-point/title "Evaluating a Radical Expression that Does Not Simplify to a Whole Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4616f056-d400-5fed-af7e-805ceebb663a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{6}" :db/id #edb/ref 17592186482935} {:answer/id #uuid "56837697-58ac-5ac8-bb0e-bac392cdf4c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{6}" :db/id #edb/ref 17592186482964} {:answer/id #uuid "bc62b660-ca90-5160-8d3b-b8f9d40e5821" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186483129} {:answer/id #uuid "ca122d4f-8f7f-562e-8e01-40a512ff22e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{3}" :db/id #edb/ref 17592186483147} {:answer/id #uuid "dfbfb