5a05-8dd1-6cb147dae13d" #edb/ref 17592186045417] [17592186483359 #edb/ref 1074 "We replace $t$ with $6$ in the given expression, and simplify as much as possible:\n\n$$\n\\begin{aligned}\\sqrt[3]{8t+6} & = \\\\ \\sqrt[3]{8(6)+6} & = \\\\ \\sqrt[3]{48+6} & = \\\\ \\sqrt[3]{54} & = \\\\ \\sqrt[3]{27\\cdot 2} & = \\\\ \\sqrt[3]{27}\\cdot \\sqrt[3]{2} & = \\\\ \\sqrt[3]{{3}^{3}}\\cdot \\sqrt[3]{2} & = \\\\ 3\\sqrt[3]{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186483366 #edb/ref 1068 #edb/ref 17592186483297 #edb/ref 17592186045417] [17592186483366 #edb/ref 1069 "q-110876" #edb/ref 17592186045417] [17592186483366 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186483366 #edb/ref 1071 "Evaluate $\\sqrt{x+6}$ for $x=18.$" #edb/ref 17592186045417] [17592186483366 #edb/ref 1072 #uuid "47b013be-1b3f-5223-b931-2de57a055397" #edb/ref 17592186045417] [17592186483366 #edb/ref 1074 "We replace $x$ with $18$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}\\sqrt{x+6} & = \\\\ \\sqrt{18+6} & = \\\\ \\sqrt{24}\\end{aligned}\n$$\n\nWe can simplify even further using the product rule:\n\n$$\n\\begin{aligned}\\sqrt{24} & = \\\\ \\sqrt{4\\cdot 6} & = \\\\ \\sqrt{{2}^{2}\\cdot 6} & = \\\\ \\sqrt{{2}^{2}}\\cdot \\sqrt{6} & = \\\\ 2\\sqrt{6}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186483381 #edb/ref 1068 #edb/ref 17592186483342 #edb/ref 17592186045417] [17592186483381 #edb/ref 1069 "q-41328" #edb/ref 17592186045417] [17592186483381 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186483381 #edb/ref 1071 "Find the value of $\\frac{1}{3}\\sqrt{3+3y-6x}$ when $x=-4$ and $y=3.$" #edb/ref 17592186045417] [17592186483381 #edb/ref 1072 #uuid "835570d9-9990-53ad-94a8-897ce7e4ef85" #edb/ref 17592186045417] [17592186483381 #edb/ref 1074 "We replace $x$ with $-4$ and $y$ with $3$ in the given expression, and simplify as much as possible:\n\n$$\n\\begin{aligned}\\frac{1}{3}\\sqrt{3+3y-6x} & = \\\\ \\frac{1}{3}\\sqrt{3+3\\cdot 3-6\\cdot (-4)} & = \\\\ \\frac{1}{3}\\sqrt{3+9+24} & = \\\\ \\frac{1}{3}\\sqrt{36} & = \\\\ \\frac{1}{3}\\sqrt{{6}^{2}} & = \\\\ \\frac{1}{3}\\cdot 6 & = \\\\ 2\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186483387 #edb/ref 1068 #edb/ref 17592186483340 #edb/ref 17592186045417] [17592186483387 #edb/ref 1069 "q-52468" #edb/ref 17592186045417] [17592186483387 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186483387 #edb/ref 1071 "Given $f(x)=\\frac{\\sqrt{6-x}}{\\sqrt{2x}},$ find $f(4).$" #edb/ref 17592186045417] [17592186483387 #edb/ref 1072 #uuid "8f049718-46eb-5f7d-b555-f56c650c3d43" #edb/ref 17592186045417] [17592186483387 #edb/ref 1074 "We replace $x$ with $4$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}f(4) & =\\frac{\\sqrt{6-4}}{\\sqrt{2(4)}} \\\\  & =\\frac{\\sqrt{2}}{\\sqrt{8}} \\\\  & =\\sqrt{\\frac{2}{8}} \\\\  & =\\sqrt{\\frac{1}{4}} \\\\  & =\\frac{\\sqrt{1}}{\\sqrt{4}} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186483401 #edb/ref 1068 #edb/ref 17592186483312 #edb/ref 17592186045417] [17592186483401 #edb/ref 1069 "q-63879" #edb/ref 17592186045417] [17592186483401 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186483401 #edb/ref 1071 "Evaluate $\\sqrt{3t+4}-\\sqrt[3]{9t+1}$ at $t=7.$" #edb/ref 17592186045417] [17592186483401 #edb/ref 1072 #uuid "b915ea49-eb32-5bde-bff7-6605ab07f81d" #edb/ref 17592186045417] [17592186483401 #edb/ref 1074 "We replace $t$ with $7$ in the given expression, and simplify as much as possible:\n\n$$\n\\begin{aligned}\\sqrt{3t+4}-\\sqrt[3]{9t+1} & = \\\\ \\sqrt{3\\cdot 7+4}-\\sqrt[3]{9\\cdot 7+1} & = \\\\ \\sqrt{21+4}-\\sqrt[3]{63+1} & = \\\\ \\sqrt{25}-\\sqrt[3]{64} & = \\\\ \\sqrt{{5}^{2}}-\\sqrt[3]{{4}^{3}} & = \\\\ 5-4 & = \\\\ 1 & \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186483425 #edb/ref 1068 #edb/ref 17592186483339 #edb/ref 17592186045417] [17592186483425 #edb/ref 1069 "q-110880" #edb/ref 17592186045417] [17592186483425 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186483425 #edb/ref 1071 "Given $f(x)=\\frac{\\sqrt{2x+1}}{\\sqrt{x}},$ find $f(4).$" #edb/ref 17592186045417] [17592186483425 #edb/ref 1072 #uuid "eb936307-5973-5d57-8360-74e0a38a6a75" #edb/ref 17592186045417] [17592186483425 #edb/ref 1074 "We replace $x$ with $4$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}f(4) & =\\frac{\\sqrt{2(4)+1}}{\\sqrt{4}} \\\\  & =\\frac{\\sqrt{8+1}}{\\sqrt{4}} \\\\  & =\\frac{\\sqrt{9}}{\\sqrt{4}} \\\\  & =\\frac{3}{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186483429 #edb/ref 1068 #edb/ref 17592186483306 #edb/ref 17592186045417] [17592186483429 #edb/ref 1069 "q-110877" #edb/ref 17592186045417] [17592186483429 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186483429 #edb/ref 1071 "Find the value of $\\sqrt{3x+5y}$ when $x=1$ and $y=5.$" #edb/ref 17592186045417] [17592186483429 #edb/ref 1072 #uuid "f713a7bd-9c0b-5d5c-8fbb-e0cb95a59072" #edb/ref 17592186045417] [17592186483429 #edb/ref 1074 "We replace $x$ with $1$ and $y$ with $5$ in the given expression, and simplify as much as possible:\n\n$$\n\\begin{aligned}\\sqrt{3x+5y} & = \\\\ \\sqrt{3(1)+5(5)} & = \\\\ \\sqrt{3+25} & = \\\\ \\sqrt{28} & = \\\\ \\sqrt{4\\cdot 7} & = \\\\ \\sqrt{{2}^{2}\\cdot 7} & = \\\\ \\sqrt{{2}^{2}}\\cdot \\sqrt{7} & = \\\\ 2\\sqrt{7}\\end{aligned}\n$$" #edb/ref 17592186045417]}
