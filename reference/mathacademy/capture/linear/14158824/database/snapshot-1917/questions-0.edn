#{[{:db/id #edb/ref 17592186133524 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133918 :knowledge-point/id #uuid "779a527b-c35d-5c94-b783-2e6eb117f00a" :knowledge-point/title "Evaluating a Radical Expression that Simplifies to a Whole Number"}] :question/id #uuid "6488c7bd-4179-5b78-bdfc-92973f9a141f" :question/math-academy-id "e-1375" :question/problem "Evaluate $\\sqrt{x} + 2x -1$ when $x=16$." :question/worked-solution "We replace $x$ with $16$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}\n\\sqrt{x} + 2x - 1 &=  \\\\\n\\sqrt{16} + 2 \\cdot 16 - 1 &=  \\\\\n\\sqrt{4^{2}} + 32 - 1 &=  \\\\\n4 + 32 - 1 &=  \\\\\n&= 35\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186133525 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133919 :knowledge-point/id #uuid "63a2c63d-2329-5679-b426-eea89828b39a" :knowledge-point/title "Evaluating a Radical Expression that Does Not Simplify to a Whole Number"}] :question/id #uuid "6c9e9059-c72a-5cd4-94ee-33cabb839cab" :question/math-academy-id "e-1377" :question/problem "Evaluate $\\sqrt{3x-1}$ for $x=3$." :question/worked-solution "We replace $x$ with $3$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}\n\\sqrt{3x - 1} &=  \\\\\n\\sqrt{3 \\cdot 3 - 1} &=  \\\\\n\\sqrt{9 - 1} &=  \\\\\n&= \\sqrt{8}\n\\end{aligned}\n$$\n\nWe can simplify even further using the product rule:\n\n$$\n\\begin{aligned}\n\\sqrt{8} &=  \\\\\n\\sqrt{4 \\cdot 2} &=  \\\\\n\\sqrt{2^{2} \\cdot 2} &=  \\\\\n\\sqrt{2^{2}} \\cdot \\sqrt{2} &=  \\\\\n&= 2\\sqrt{2}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186133526 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133920 :knowledge-point/id #uuid "4accb1de-fe16-587c-b1e2-a3e59e4707fc" :knowledge-point/title "Evaluating a Radical Expression Containing Fractions"}] :question/id #uuid "94bd4811-8dca-542d-8c23-1950c9212a3b" :question/math-academy-id "e-1378" :question/problem "Given that $f(x) = \\dfrac{\\sqrt{9x+3}}{\\sqrt{x-2}}$, find $f(5)$." :question/worked-solution "We replace $x$ with $5$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}\nf(5) &= (\\sqrt{9(5) + 3})/(\\sqrt{(5) - 2}) \\\\\n&= \\frac{\\sqrt{48}}{\\sqrt{3}} \\\\\n&= \\sqrt{\\frac{48}{3}} \\\\\n&= \\sqrt{16} \\\\\n&= \\sqrt{4^{2}} \\\\\n&= 4\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186133527 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133921 :knowledge-point/id #uuid "b3351708-be25-5d86-8aa8-f651263505be" :knowledge-point/title "Evaluating a Radical Expression Containing a Cube Root"}] :question/id #uuid "5046e564-44ca-5e7b-bdbc-9388b5a30581" :question/math-academy-id "e-1379" :question/problem "Evaluate $\\sqrt[3]{x+6}$ at $x=2$." :question/worked-solution "We replace $x$ with $2$ in the given expression, and simplify as much as possible:\n\n$$\n\\begin{aligned}\n\\sqrt[3]{x + 6} &=  \\\\\n\\sqrt[3]{2 + 6} &=  \\\\\n\\sqrt[3]{8} &=  \\\\\n\\sqrt[3]{2^{3}} &=  \\\\\n&= 2\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134341 :knowledge-point/_questions [{:db/id #edb/ref 17592186133918 :knowledge-point/id #uuid "779a527b-c35d-5c94-b783-2e6eb117f00a" :knowledge-point/title "Evaluating a Radical Expression that Simplifies to a Whole Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ccb9dcd2-ad9c-51db-8cba-e6b93f38a4f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186132086} {:answer/id #uuid "d6362d98-55f0-59b6-bf66-a5f5e9cd508e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186132087} {:answer/id #uuid "01bfcdff-a1c3-5bfb-9af0-07c7e99e804e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186132088} {:answer/id #uuid "0ca01b39-dd93-59db-85be-dc46006a3834" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186132089} {:answer/id #uuid "5aba8c0b-2f21-56e2-a6b1-d990a7d89ea2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186132090}] :answer-field/id #uuid "478ebdd0-c2e2-5bc7-bf68-1074d3ed20bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186132085}] :question/id #uuid "a9bd52dc-5c5c-5748-a35c-548249142332" :question/math-academy-id "q-41315" :question/problem "Evaluate $2\\sqrt{2x} + 8$ when $x = 18$."}]}
