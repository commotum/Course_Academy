#{[{:db/id #edb/ref 17592186198173 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198312 :knowledge-point/id #uuid "64180fa2-2268-5954-aadb-2982a2d7a224" :knowledge-point/title "Finding the Maximum and Minimum of a Set"}] :question/id #uuid "b817524b-bf24-5f11-a0c8-d544f026b0b8" :question/math-academy-id "e-13188" :question/problem "What are the minimum and maximum of the set $A = \\left[0,3\\right]?$" :question/worked-solution "Recall that \n\n- $x_{\\max}$ is the maximum of a set $S$ if $x_{\\max} \\in S$ and $x \\leq x_{\\max}$ for all $x \\in S,$ and\n\n- $x_{\\min}$ is the minimum of a set $S$ if $x_{\\min} \\in S$ and $x_{\\min} \\leq x$ for all $x \\in S.$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}min(A) & =min[0,3]=0 \\\\ max(A) & =max[0,3]=3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186198174 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198314 :knowledge-point/id #uuid "f8ed1932-b363-5a07-a816-93f3078cb801" :knowledge-point/title "Maximums and Minimums in More Complex Settings"}] :question/id #uuid "cf3362e1-4d5b-5cb4-bcef-523f9927044b" :question/math-academy-id "e-13189" :question/problem "What are the maximum and minimum values of the set $A = \\{ n \\in \\mathbb{Z} \\mid \\: 3 \\lt n \\leq 8 \\}?$" :question/worked-solution "Recall that \n\n- $x_{\\max}$ is the maximum of a set $S$ if $x_{\\max} \\in S$ and $x \\leq x_{\\max}$ for all $x \\in S,$ and\n\n- $x_{\\min}$ is the minimum of a set $S$ if $x_{\\min} \\in S$ and $x_{\\min} \\leq x$ for all $x \\in S.$\n\nNotice that the elements of the set can be listed as \n\n$$\nA = \\{ 4, \\: 5, \\: 6, \\: 7, 8\\}.\n$$\n\nTherefore, the minimum of the set equals $4,$ while the maximum of the set equals $8.$"}] [{:db/id #edb/ref 17592186198176 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198313 :knowledge-point/id #uuid "8f45befc-412b-58aa-8901-d10e63858b52" :knowledge-point/title "Explaining the Existence of a Maximum or Minimum"}] :question/id #uuid "2bf6f02e-e7af-5b94-880d-6f1760a666ec" :question/math-academy-id "e-13194" :question/problem "Given the set $S = (-\\infty,7],$ explain why $\\max(S) = 7.$" :question/worked-solution "Recall that $x_{\\max}$ is the maximum of a set $S$ if \n\n- $x_{\\max} \\in S,$ and\n\n- $x\\leq x_{\\max}$ for all $x \\in S.$\n\nIn our case, we have that $7$ is the maximum of the set $S$ because\n\n- $7 \\in S,$ and\n\n- $x \\leq 7$ for all $x \\in S.$"}] [{:db/id #edb/ref 17592186198804 :knowledge-point/_questions [{:db/id #edb/ref 17592186198314 :knowledge-point/id #uuid "f8ed1932-b363-5a07-a816-93f3078cb801" :knowledge-point/title "Maximums and Minimums in More Complex Settings"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04c24015-2433-5836-b081-d24c5852f0b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186406745} {:answer/id #uuid "74fb204e-62de-5113-a57a-b0d722924c1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186406752} {:answer/id #uuid "8524fdad-28da-528a-92f9-faca4791d98f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186406758} {:answer/id #uuid "8f9753b3-62da-5662-8688-049fcc1bf71f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186406759} {:answer/id #uuid "f6902130-3b72-504d-8069-c5b5ea38e581" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186406772}] :answer-field/correct {:answer/id #uuid "8f9753b3-62da-5662-8688-049fcc1bf71f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186406759} :answer-field/id #uuid "3ea78180-0fde-56dc-91ec-da9439574c93" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 1759218604549