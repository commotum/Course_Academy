#{[{:db/id #edb/ref 17592186198173 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198312 :knowledge-point/id #uuid "64180fa2-2268-5954-aadb-2982a2d7a224" :knowledge-point/title "Finding the Maximum and Minimum of a Set"}] :question/id #uuid "b817524b-bf24-5f11-a0c8-d544f026b0b8" :question/math-academy-id "e-13188" :question/problem "What are the minimum and maximum of the set $A = \\left[0,3\\right]$?" :question/worked-solution "Recall that\n\n- $x_{\\max}$ is the maximum of a set $S$ if $x_{\\max} \\in S$ and $x \\leq x_{\\max}$ for all $x \\in S$, and\n- $x_{\\min}$ is the minimum of a set $S$ if $x_{\\min} \\in S$ and $x_{\\min} \\leq x$ for all $x \\in S$.\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}\nmin(A) &= min[0, 3] = 0 \\\\\nmax(A) &= max[0, 3] = 3\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186198174 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198314 :knowledge-point/id #uuid "f8ed1932-b363-5a07-a816-93f3078cb801" :knowledge-point/title "Maximums and Minimums in More Complex Settings"}] :question/id #uuid "cf3362e1-4d5b-5cb4-bcef-523f9927044b" :question/math-academy-id "e-13189" :question/problem "What are the maximum and minimum values of the set $A = \\{n \\in \\mathbb{Z} \\mid \\: 3 \\lt n \\leq 8 \\}$?" :question/worked-solution "Recall that\n\n- $x_{\\max}$ is the maximum of a set $S$ if $x_{\\max} \\in S$ and $x \\leq x_{\\max}$ for all $x \\in S$, and\n- $x_{\\min}$ is the minimum of a set $S$ if $x_{\\min} \\in S$ and $x_{\\min} \\leq x$ for all $x \\in S$.\n\nNotice that the elements of the set can be listed as\n\n$$\nA = \\{4, \\: 5, \\: 6, \\: 7, 8\\}\n$$\n\nTherefore, the minimum of the set equals $4$, while the maximum of the set equals $8$."}] [{:db/id #edb/ref 17592186198176 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198313 :knowledge-point/id #uuid "8f45befc-412b-58aa-8901-d10e63858b52" :knowledge-point/title "Explaining the Existence of a Maximum of Minimum"}] :question/id #uuid "2bf6f02e-e7af-5b94-880d-6f1760a666ec" :question/math-academy-id "e-13194" :question/problem "Given the set $S = (-\\infty,7]$, explain why $\\max(S) = 7$." :question/worked-solution "Recall that $x_{\\max}$ is the maximum of a set $S$ if\n\n- $x_{\\max} \\in S$, and\n- $x\\leq x_{\\max}$ for all $x \\in S$.\n\nIn our case, we have that $7$ is the maximum of the set $S$ because\n\n- $7 \\in S$, and\n- $x \\leq 7$ for all $x \\in S$."}] [{:db/id #edb/ref 17592186198804 :knowledge-point/_questions [{:db/id #edb/ref 17592186198314 :knowledge-point/id #uuid "f8ed1932-b363-5a07-a816-93f3078cb801" :knowledge-point/title "Maximums and Minimums in More Complex Settings"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8866741-e33a-521b-bc84-e71e8774cf17" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "maximum" :db/id #edb/ref 17592186195528} {:answer/id #uuid "7296147e-e9bb-5988-8d3d-d5864c111e3f" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "minimum" :db/id #edb/ref 17592186195529}] :answer-field/id #uuid "a00ae24d-c575-561c-bd87-cb589a3c872f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186195527} {:answer-field/choices [{:answer/id #uuid "aed52d4a-e581-573c-ac78-7dd08739fa3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186195531} {:answer/id #uuid "b9ed6117-543a-58f9-a577-4d233043282a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186195532} {:answer/id #uuid "19fc960a-d8a9-5af9-a0a3-828fab63f263" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186195533} {:answer/id #uuid "24e519b6-99df-543f-80c7-61072adcb7cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :an