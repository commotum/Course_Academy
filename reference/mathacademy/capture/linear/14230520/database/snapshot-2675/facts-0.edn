186553461 #edb/ref 1079 #uuid "b5b1b578-337f-5ed8-beb9-491bd54e7954" #edb/ref 17592186045417] [17592186553487 #edb/ref 1068 #edb/ref 17592186553441 #edb/ref 17592186045417] [17592186553487 #edb/ref 1069 "q-38029" #edb/ref 17592186045417] [17592186553487 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186553487 #edb/ref 1071 "What is the quotient of $48{x}^{3}+16{x}^{2}-12x-4$ divided by $12{x}^{2}-2x-2?$" #edb/ref 17592186045417] [17592186553487 #edb/ref 1072 #uuid "00e30455-d65a-5c3e-852c-94513d65dea1" #edb/ref 17592186045417] [17592186553487 #edb/ref 1074 "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,4x+2 \\\\  & 12{x}^{2}-2x-2\\,\\enclose{longdiv}{\\,\\,48{x}^{3}+16{x}^{2}-12x-4\\,\\,} \\\\  & \\,\\,\\,\\,\\,{48{x}^{3}-8{x}^{2}-8x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,24{x}^{2}-4x-4 \\\\  & \\,\\,\\,\\,\\,\\,\\,{24{x}^{2}-4x-4}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,0\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $4x+2,$ and\n\n- the remainder is $0.$" #edb/ref 17592186045417] [17592186553494 #edb/ref 1068 #edb/ref 17592186553395 #edb/ref 17592186045417] [17592186553494 #edb/ref 1069 "q-18417" #edb/ref 17592186045417] [17592186553494 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186553494 #edb/ref 1071 "$\\frac{2{x}^{4}-11{x}^{2}+2x+1}{-2{x}^{3}+6{x}^{2}-1}=$" #edb/ref 17592186045417] [17592186553494 #edb/ref 1072 #uuid "0cb3699b-22c9-5a80-a605-3b7138e8d50e" #edb/ref 17592186045417] [17592186553494 #edb/ref 1074 "Notice that the dividend is missing the ${x}^{3}$ term. So, we first rewrite it by including the missing term with a coefficient of zero, as follows:\n\n$$\n2{x}^{4}-11{x}^{2}+2x+1=2{x}^{4}+0{x}^{3}-11{x}^{2}+2x+1\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,-x-3 \\\\  & -2{x}^{3}+6{x}^{2}-1\\,\\enclose{longdiv}{\\,\\,2{x}^{4}+0{x}^{3}-11{x}^{2}+2x+1\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,\\,{2{x}^{4}-6{x}^{3}+0{x}^{2}+x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,6{x}^{3}-11{x}^{2}+x+1 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,{6{x}^{3}-18{x}^{2}+0x+3}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,7{x}^{2}+x-2\\end{aligned}\n$$\n\nAs a result, \n\n- the quotient is $-x-3,$ and\n\n- the remainder is $7{x}^{2}+x-2.$\n\nTherefore,\n\n$$\n\\frac{2{x}^{4}-11{x}^{2}+2x+1}{-2{x}^{3}+6{x}^{2}-1}=-x-3+\\frac{7{x}^{2}+x-2}{-2{x}^{3}+6{x}^{2}-1}.\n$$" #edb/ref 17592186045417] [17592186553495 #edb/ref 1068 #edb/ref 17592186553461 #edb/ref 17592186045417] [17592186553495 #edb/ref 1069 "q-324365" #edb/ref 17592186045417] [17592186553495 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186553495 #edb/ref 1071 "What is the quotient of $8{x}^{4}+24x+2$ divided by $-2{x}^{2}+3x-5?$\n\nThe quotient is\n{{field-1}}." #edb/ref 17592186045417] [17592186553495 #edb/ref 1072 #uuid "0cc307df-ec47-5e9f-872f-4b9b3e943019" #edb/ref 17592186045417] [17592186553495 #edb/ref 1074 "Notice that the dividend is missing the ${x}^{3}$ and ${x}^{2}$ terms. So, we first rewrite it by including the missing terms with zero coefficients, as follows:\n\n$$\n8{x}^{4}+24x+2=8{x}^{4}+0{x}^{3}+0{x}^{2}+24x+2\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,-4{x}^{2}-6x+1 \\\\  & -2{x}^{2}+3x-5\\,\\enclose{longdiv}{\\,\\,8{x}^{4}+\\phantom{0}0{x}^{3}+\\phantom{0}0{x}^{2}+24x+2\\,\\,} \\\\  & \\,\\,\\,\\,\\,{8{x}^{4}-12{x}^{3}+20{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,12{x}^{3}-20{x}^{2}+24x+2 \\\\  & \\,\\,\\,\\,\\,\\,\\,{12{x}^{3}-18{x}^{2}+30x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,-\\,2{x}^{2}-6x+2 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,2{x}^{2}+3x-5}_{―} \\\\  & \\,\\,\\,\\,\\,\\,-\\,9x+7\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $-4{x}^{2}-6x+1,$ and\n\n- the remainder is $-9x+7.$" #edb/ref 17592186045417] [17592186553500 #edb/ref 1068 #edb/ref 17592186553380 #edb/ref 17592186045417] [17592186553500 #edb/ref 1069 "q-37960" #edb/ref 17592186045417] [17592186553500 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186553500 #edb/ref 1071 "What is the quotient of ${x}^{3}+2{x}^{2}+x+1$ divided by ${x}^{2}+2x+1?$" #edb/ref 17592186045417] [17592186553500 #edb/ref 1072 #uuid "1eb31ef2-fef5-5bd3-b730-66864ae07e56" #edb/ref 17592186045417] [17592186553500 #edb/ref 1074 "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,x \\\\  & {x}^{2}+2x+1\\,\\enclose{longdiv}{\\,\\,{x}^{3}+2{x}^{2}+x+1\\,\\,} \\\\  & \\,\\,\\,\\,\\,{{x}^{3}+2{x}^{2}+x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,1\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $x,$ and\n\n- the remainder is $1.$" #edb/ref 17592186045417] [17592186553501 #edb/ref 1068 #edb/ref 17592186553377 #edb/ref 17592186045417] [17592186553501 #edb/ref 1069 "q-37940" #edb/ref 17592186045417] [17592186553501 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186553501 #edb/ref 1071 "What is the remainder when $3{x}^{3}-2{x}^{2}-18x-1$ is divided by $3{x}^{2}-8x-2?$" #edb/ref 17592186045417] [17592186553501 #edb/ref 1072 #uuid "21ff56f4-ae4e-5c23-af7e-5388474cb582" #edb/ref 17592186045417] [17592186553501 #edb/ref 1074 "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,x+2 \\\\  & 3{x}^{2}-8x-2\\,\\enclose{longdiv}{\\,\\,3{x}^{3}-2{x}^{2}-18x-1\\,\\,} \\\\  & \\,\\,\\,\\,\\,{3{x}^{3}-8{x}^{2}-2x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,6{x}^{2}-16x-1 \\\\  & \\,\\,\\,\\,\\,\\,\\,{6{x}^{2}-16x-4}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,3\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $x+2,$ and\n\n- the remainder is $3.$" #edb/ref 17592186045417] [17592186553549 #edb/ref 1068 #edb/ref 17592186553431 #edb/ref 17592186045417] [17592186553549 #edb/ref 1069 "q-18395" #edb/ref 17592186045417] [17592186553549 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186553549 #edb/ref 1071 "$\\frac{4{x}^{4}-2{x}^{3}-8{x}^{2}+3x+1}{2{x}^{2}-x-2}=$" #edb/ref 17592186045417] [17592186553549 #edb/ref 1072 #uuid "8bc4fde0-a670-521d-a87d-b0fba4bc56ab" #edb/ref 17592186045417] [17592186553549 #edb/ref 1074 "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,2{x}^{2}-2 \\\\  & 2{x}^{2}-x-2\\,\\enclose{longdiv}{\\,\\,4{x}^{4}-2{x}^{3}-8{x}^{2}+3x+1\\,\\,} \\\\  & \\,\\,\\,\\,\\,{4{x}^{4}-2{x}^{3}-4{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,-4{x}^{2}+3x+1 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,4{x}^{2}+2x+4}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,x-3\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $2{x}^{2}-2,$ and\n\n- the remainder is $x-3.$\n\nTherefore, \n\n$$\n\\frac{4{x}^{4}-2{x}^{3}-8{x}^{2}+3x+1}{2{x}^{2}-x-2}=2{x}^{2}-2+\\frac{x-3}{2{x}^{2}-x-2}.\n$$" #edb/ref 17592186045417] [17592186553557 #edb/ref 1068 #edb/ref 17592186553413 #edb/ref 17592186045417] [17592186553557 #edb/ref 1069 "q-270166" #edb/ref 17592186045417] [17592186553557 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186553557 #edb/ref 1071 "What is the quotient of $12{x}^{4}-5$ divided by $-2{x}^{2}+2x-3?$\n\nThe quotient is\n{{field-1}}." #edb/ref 17592186045417] [17592186553557 #edb/ref 1072 #uuid "99ee3ecb-35ab-58a3-9bc3-d74b99668ec7" #edb/ref 17592186045417] [17592186553557 #edb/ref 1074 "Notice that the dividend is missing the ${x}^{3},{x}^{2}$ and $x$ terms. So, we first rewrite it by including the missing terms with zero coefficients, as follows:\n\n$$\n12{x}^{4}-5=12{x}^{4}+0{x}^{3}+0{x}^{2}+0x-5\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,-6{x}^{2}-6x+3 \\\\  & -2{x}^{2}+2x-3\\,\\enclose{longdiv}{\\,\\,12{x}^{4}+\\phantom{0}0{x}^{3}+\\phantom{0}0{x}^{2}+\\phantom{0}0x-5\\,\\,} \\\\  & \\,\\,\\,\\,\\,{12{x}^{4}-12{x}^{3}+18{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,12{x}^{3}-18{x}^{2}+0x-5 \\\\  & \\,\\,\\,\\,\\,\\,\\,{12{x}^{3}-12{x}^{2}+18x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,-\\,6{x}^{2}-18x-5 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,6{x}^{2}+6x-9}_{―} \\\\  & \\,\\,\\,\\,\\,\\,-\\,24x+4\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $-6{x}^{2}-6x+3,$ and\n\n- the remainder is $-24x+4.$" #edb/ref 17592186045417] [17592186553571 #edb/ref 1068 #edb/ref 17592186553384 #edb/ref 17592186045417] [17592186553571 #edb/ref 1068 #edb/ref 17592186553402 #edb/ref 17592186045417] [17592186553571 #edb/ref 1069 "q-270090" #edb/ref 17592186045417] [17592186553571 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186553571 #edb/ref 1071 "Express $\\frac{20{x}^{3}+6{x}^{2}-5x-8}{2{x}^{2}-4x+3}$ in the form $q(x)+\\frac{r(x)}{2{x}^{2}-4x+3},$ where $q(x)$ is the quotient and $r(x)$ is the reminder of the division.$$\n\n| $20{x}^{3}+6{x}^{2}-5x-8$ | __ | {{field-1}} | $+$ | {{field-2}} |\n| --- | --- | --- | --- | --- |\n| $2{x}^{2}-4x+3$ | __ |  |  | $2{x}^{2}-4x+3$ |" #edb/ref 17592186045417] [17592186553571 #edb/ref 1072 #uuid "ca48cb34-e90b-5e17-8caa-9e1b065ee2bb" #edb/ref 17592186045417] [17592186553571 #edb/ref 1074 "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,10x+23 \\\\  & 2{x}^{2}-4x+3\\,\\enclose{longdiv}{\\,\\,20{x}^{3}+\\phantom{0}6{x}^{2}-\\phantom{0}5x-\\phantom{0}8\\,\\,} \\\\  & \\,\\,\\,\\,\\,{20{x}^{3}-40{x}^{2}+30x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,46{x}^{2}-35x-8 \\\\  & \\,\\,\\,\\,\\,\\,\\,{46{x}^{2}-92x+69}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,57x-77\\end{aligned}\n$$\n\nAs a result, \n\n- the quotient is $10x+23,$ and\n\n- the remainder is $57x-77.$\n\nTherefore,\n\n$$\n\\frac{20{x}^{3}+6{x}^{2}-5x-8}{2{x}^{2}-4x+3}=10x+23+\\frac{57x-77}{2{x}^{2}-4x+3}.\n$$" #edb/ref 17592186045417]}
