5417] [17592186065491 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186065491 #edb/ref 1083 #uuid "5346c601-9c4e-5ddf-a193-70ba90454c28" #edb/ref 17592186045417] [17592186065493 #edb/ref 1075 #edb/ref 17592186552880 #edb/ref 17592186045417] [17592186065493 #edb/ref 1075 #edb/ref 17592186552953 #edb/ref 17592186045417] [17592186065493 #edb/ref 1075 #edb/ref 17592186552959 #edb/ref 17592186045417] [17592186065493 #edb/ref 1075 #edb/ref 17592186553131 #edb/ref 17592186045417] [17592186065493 #edb/ref 1075 #edb/ref 17592186553198 #edb/ref 17592186045417] [17592186065493 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186065493 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186065493 #edb/ref 1078 #edb/ref 17592186553198 #edb/ref 17592186045417] [17592186065493 #edb/ref 1079 #uuid "d1f35cfe-1f68-5083-8599-cf6709dac637" #edb/ref 17592186045417] [17592186068599 #edb/ref 1069 "e-5143" #edb/ref 17592186045417] [17592186068599 #edb/ref 1071 "Determine the quotient and remainder of $6x^3-x^2+3x+1$ divided by $3x^2+x+2.$" #edb/ref 17592186045417] [17592186068599 #edb/ref 1072 #uuid "a2aac357-23c5-5038-84c6-bc263bd45afa" #edb/ref 17592186045417] [17592186068599 #edb/ref 1074 "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,2x-1 \\\\  & 3{x}^{2}+x+2\\,\\enclose{longdiv}{\\,\\,6{x}^{3}-\\phantom{0}{x}^{2}+3x+1\\,\\,} \\\\  & \\,\\,\\,\\,\\,{6{x}^{3}+2{x}^{2}+4x}_{―} \\\\  & \\,\\,\\,\\,\\,-3{x}^{2}-x+1 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,3{x}^{2}-x-2}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,3\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is ${\\color{blue}2x-1},$ and\n\n- the remainder is ${\\color{red}3}.$" #edb/ref 17592186045417] [17592186068600 #edb/ref 1069 "e-5144" #edb/ref 17592186045417] [17592186068600 #edb/ref 1071 "Find the quotient and remainder of the following division problem:\n\n$$\n\\dfrac{2x^4 - 7x^2 - x + 8}{x^2 - 1}\n$$" #edb/ref 17592186045417] [17592186068600 #edb/ref 1072 #uuid "bd9a160c-574e-506e-865c-d08061c75aed" #edb/ref 17592186045417] [17592186068600 #edb/ref 1074 "Notice that the dividend is missing the $x^3$ term. So, we first rewrite it by including the missing term with a coefficient of zero, as follows:\n\n$$\n2x^4-7x^2-x+8 = 2x^4+{\\color{red}0}x^3-7x^2-x+8\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,2{x}^{2}-5 \\\\  & {x}^{2}-1\\,\\enclose{longdiv}{\\,\\,2{x}^{4}+0{x}^{3}-7{x}^{2}-\\phantom{0}x+8\\,\\,} \\\\  & \\,\\,\\,\\,\\,{2{x}^{4}+0{x}^{3}-2{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,-5{x}^{2}-x+8 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,5{x}^{2}+0x+5}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-x+3\\end{aligned}\n$$\n\nAs a result, \n\n- the quotient is ${2x^2 - 5},$ and\n\n- the remainder is ${-x+3}.$\n\nTherefore,\n\n$$\n\\dfrac{2x^4 - 7x^2 - x +8}{x^2 - 1} \n= \n2x^2-5 + \\dfrac{-x+3}{x^2-1}.\n$$\n\nWe can rewrite this result as follows:\n\n$$\n\\dfrac{2x^4 - 7x^2 - x +8}{x^2 - 1} \n= \n2x^2-5 - \\dfrac{x-3}{x^2-1}\n$$" #edb/ref 17592186045417] [17592186068660 #edb/ref 1069 "e-8932" #edb/ref 17592186045417] [17592186068660 #edb/ref 1071 "Find the quotient and remainder of the following division problem:\n\n$$\n\\dfrac {5x^4- 2x^3 - 18x^2 + 11x - 13} {5x^2-2x+2}\n$$" #edb/ref 17592186045417] [17592186068660 #edb/ref 1072 #uuid "9438b41b-2ad4-5248-881c-cb938b6cf1c3" #edb/ref 17592186045417] [17592186068660 #edb/ref 1074 "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,{x}^{2}-4 \\\\  & 5{x}^{2}-2x+2\\,\\enclose{longdiv}{\\,\\,5{x}^{4}-2{x}^{3}-18{x}^{2}+11x-13\\,\\,} \\\\  & \\,\\,\\,\\,\\,{5{x}^{4}-2{x}^{3}+2{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,-20{x}^{2}+11x-13 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,20{x}^{2}+8x-8}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,3x-5\\end{aligned}\n$$\n\nAs a result,\n\n- the quotient is $x^2-4,$ and\n\n- the remainder is $3x-5.$\n\nTherefore, \n\n$$\n\\dfrac{5x^4-2x^3-18x^2+11x-13}{5x^2-2x+2}=x^2-4 + \\dfrac{3x-5}{5x^2-2x+2}.\n$$" #edb/ref 17592186045417] [17592186068761 #edb/ref 1037 #edb/ref 17592186049759 #edb/ref 17592186045417] [17592186068761 #edb/ref 1038 #edb/ref 17592186069008 #edb/ref 17592186045417] [17592186068761 #edb/ref 1038 #edb/ref 17592186069307 #edb/ref 17592186045417] [17592186068761 #edb/ref 1038 #edb/ref 17592186287869 #edb/ref 17592186045417] [17592186068761 #edb/ref 1038 #edb/ref 17592186302094 #edb/ref 17592186045417] [17592186068761 #edb/ref 1038 #edb/ref 17592186302095 #edb/ref 17592186045417] [17592186068761 #edb/ref 1038 #edb/ref 17592186302125 #edb/ref 17592186045417] [17592186068761 #edb/ref 1038 #edb/ref 17592186323966 #edb/ref 17592186045417] [17592186068761 #edb/ref 1038 #edb/ref 17592186485486 #edb/ref 17592186045417] [17592186068761 #edb/ref 1038 #edb/ref 17592186485502 #edb/ref 17592186045417] [17592186068761 #edb/ref 1038 #edb/ref 17592186485574 #edb/ref 17592186045417] [17592186068761 #edb/ref 1038 #edb/ref 17592186553487 #edb/ref 17592186045417] [17592186068761 #edb/ref 1038 #edb/ref 17592186553500 #edb/ref 17592186045417] [17592186068761 #edb/ref 1038 #edb/ref 17592186553501 #edb/ref 17592186045417] [17592186068761 #edb/ref 1038 #edb/ref 17592186553571 #edb/ref 17592186045417] [17592186068761 #edb/ref 1039 "Dividing a Cubic Polynomial by a Quadratic Polynomial" #edb/ref 17592186045417] [17592186068761 #edb/ref 1041 #edb/ref 17592186068599 #edb/ref 17592186045417] [17592186068761 #edb/ref 1042 #uuid "da0ca17e-50f3-5f67-bb1c-27868f7b4f45" #edb/ref 17592186045417] [17592186068762 #edb/ref 1038 #edb/ref 17592186069009 #edb/ref 17592186045417] [17592186068762 #edb/ref 1038 #edb/ref 17592186069310 #edb/ref 17592186045417] [17592186068762 #edb/ref 1038 #edb/ref 17592186250278 #edb/ref 17592186045417] [17592186068762 #edb/ref 1038 #edb/ref 17592186250279 #edb/ref 17592186045417] [17592186068762 #edb/ref 1038 #edb/ref 17592186250280 #edb/ref 17592186045417] [17592186068762 #edb/ref 1038 #edb/ref 175921