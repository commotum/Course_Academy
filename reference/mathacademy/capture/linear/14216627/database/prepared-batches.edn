$ gallons of thinner." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-34a6e6c6-0e15-53b6-808a-63020a7889ec"] :db/ensure [:question/validate]} {:db/id "answer-field-34a6e6c6-0e15-53b6-808a-63020a7889ec" :answer-field/id #uuid "34a6e6c6-0e15-53b6-808a-63020a7889ec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8f05742c-c5dd-55fd-82a0-9d57aea45582" :answer-field/choices ["answer-8f05742c-c5dd-55fd-82a0-9d57aea45582" "answer-3ea22cec-3976-5306-b057-80fe9b5fca34" "answer-7fb8aa12-476f-54d9-a946-3a656640cd8d" "answer-81318e94-fe4f-503d-9fe9-cea67c21da42" "answer-d182b9fc-285a-5a5a-a274-975a40cad8f6"] :db/ensure [:answer-field/validate]} {:db/id "answer-8f05742c-c5dd-55fd-82a0-9d57aea45582" :answer/id #uuid "8f05742c-c5dd-55fd-82a0-9d57aea45582" :answer/type :answer.type/text :answer/value "$3$ and $4$" :db/ensure [:answer/validate]} {:db/id "answer-3ea22cec-3976-5306-b057-80fe9b5fca34" :answer/id #uuid "3ea22cec-3976-5306-b057-80fe9b5fca34" :answer/type :answer.type/text :answer/value "$3$ and $7$" :db/ensure [:answer/validate]} {:db/id "answer-7fb8aa12-476f-54d9-a946-3a656640cd8d" :answer/id #uuid "7fb8aa12-476f-54d9-a946-3a656640cd8d" :answer/type :answer.type/text :answer/value "$4$ and $3$" :db/ensure [:answer/validate]} {:db/id "answer-81318e94-fe4f-503d-9fe9-cea67c21da42" :answer/id #uuid "81318e94-fe4f-503d-9fe9-cea67c21da42" :answer/type :answer.type/text :answer/value "$4$ and $7$" :db/ensure [:answer/validate]} {:db/id "answer-d182b9fc-285a-5a5a-a274-975a40cad8f6" :answer/id #uuid "d182b9fc-285a-5a5a-a274-975a40cad8f6" :answer/type :answer.type/text :answer/value "$7$ and $3$" :db/ensure [:answer/validate]} {:db/id 17592186064924 :question/problem "$45÷0=$" :question/worked-solution "We cannot divide any number by zero. Therefore, $45÷0$ is undefined." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186063600 :answer-field