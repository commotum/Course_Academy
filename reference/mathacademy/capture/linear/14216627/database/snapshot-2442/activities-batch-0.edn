/id #edb/ref 17592186518172 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f4e2340-8ee0-5351-9fb5-c525dfce930d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186517520} {:answer/id #uuid "36eea84d-8adf-5277-ab85-88e996c1fbca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186517596} {:answer/id #uuid "3ccb5484-6c71-5479-8103-efc8575ddd3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186517609} {:answer/id #uuid "c434fe79-4413-5270-a27f-9ddb3e2c1623" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186517863} {:answer/id #uuid "f9df7a6a-2bf6-55ee-9e50-cffb838757e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186517959}] :answer-field/correct {:db/id #edb/ref 17592186517863} :answer-field/id #uuid "260e99a3-e5e1-53cf-915e-ef78d3294c9f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186517988}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8c4f25cf-0173-54ec-98c6-ab10b632fa9a" :question/math-academy-id "q-60256" :question/problem "![](images/06/06931fae92045635d523614dce24063856209b1f04987471b9de183a3ccce4a2.png)\n\nIf the ratio of rhombuses to total shapes is $\\frac{3}{\\boxed{}}$ then what is the missing number?" :question/worked-solution "We count the number of rhombuses. We see that there are $3$ rhombuses.\n\n We count the total number of shapes. We see that there are $7$ shapes.\n\nHence, the ratio of circles to triangles is$\\frac{3}{7}$\n\nSo the missing number is $7.$"} :step/id #uuid "4104b582-02c9-5a3d-a68c-63888ab13e51"} {:db/id #edb/ref 17592186518261 :step/content {:db/id #edb/ref 17592186518223 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42896cb7-0d0b-54cc-969c-bb0fda2c6508" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$9$ and $4$" :db/id #edb/ref 17592186517618} {:answer/id #uuid "6cced7a0-4aa3-52bc-9f11-947258d1a3be" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$13$ and $4$" :db/id #edb/ref 17592186517693} {:answer/id #uuid "7ac161ed-1d7c-54b3-a3a8-e7718d81f9d9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4$ and $13$" :db/id #edb/ref 17592186517722} {:answer/id #uuid "80b5563d-a832-5f85-beb1-f5023beb53ca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4$ and $9$" :db/id #edb/ref 17592186517732} {:answer/id #uuid "ef6e0e18-3319-51dc-bd29-cc144c970a2a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5$ and $9$" :db/id #edb/ref 17592186517946}] :answer-field/correct {:db/id #edb/ref 17592186517732} :answer-field/id #uuid "adf5e13e-d3c5-59f6-8423-d12c85673faf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518051}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fed5c231-48f8-530b-a66d-407d2c45633b" :question/math-academy-id "q-60250" :question/problem "From left to right, what are the missing numbers in the following sentence?\n\nA student makes a mixture having $\\frac{4}{9}$ grams of ginger for each gram of glucose to make his own energy drink. Therefore, the energy drink has a ratio of $\\boxed{}$ grams of ginger to $\\boxed{}$ grams of glucose." :question/worked-solution "Let's rewrite the fraction $\\frac{4}{9}$ as a ratio:\n\n$$\n4:9\n$$\n\nTherefore, the energy drink has a ratio of $4$ grams of ginger to $9$ grams of glucose."} :step/id #uuid "73d398fa-e284-584b-af53-0ec2a7adc313" :step/next {:db/id #edb/ref 17592186518247}}] :activity/title "Writing Ratios Using Fractions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186517482}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186065281} :activity/id #uuid "5c56a3ff-c078-5460-97b4-4cf59ad749b8" :activity/scope {:db/id #edb/ref 17592186050719 :topic/id #uuid "61178d17-c292-5e1d-a08e-a6ce03bd5a13" :topic/math-academy-id 330} :activity/steps [{:db/id #edb/ref 17592186065281 :step/content {:db/id #edb/ref 17592186065416 :tutorial/content "Dividing with negative numbers follows similar rules as multiplying with negative numbers. \n\nFirst of all, a negative number divided by a positive number gives a negative number. We can picture this rule as\n\n$$\n\\begin{aligned}(-)\\,÷\\,(+)\\,=\\,(-).\\end{aligned}\n$$\n\nFor example, let's use this rule to find the value of $(-6) \\div 2.$\n\nHere, since we are dividing a negative number $\\color{red}(-6)$ by a positive number ${\\color{blue}(2)},$ the result is going to be negative:\n![](images/b6/b64108fa03fc286ddcd04ac4cd7a9d77c1672d0ced66ebb1953c97afa5488533.svg)\n\nNow, to compute the number that goes in the box, we divide $6$ by $2$ *without* any signs: $6 \\div 2 = 3.$ So, we get\n\n$$\n{\\color{red}(-6)} \\div {\\color{blue}2} = {\\color{red} -3 }.\n$$" :tutorial/id #uuid "b92ac2e4-b983-5fd5-bc18-7dfb821497f0" :tutorial/math-academy-id 8108 :tutorial/title "Introduction"} :step/id #uuid "39aa10e9-422a-5c1c-b5b2-de119dcca067" :step/math-academy-id 77819 :step/next {:db/id #edb/ref 17592186065282}} {:db/id #edb/ref 17592186065282 :step/content {:db/id #edb/ref 17592186064357 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063941 :question/id #uuid "5b4f3b5f-2f0b-5178-9055-cf83a9885920" :question/math-academy-id "e-12972"} :knowledge-point/id #uuid "b434d0d5-bd04-554b-888e-df84e3961839" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049349}] :knowledge-point/questions [{:db/id #edb/ref 17592186064489} {:db/id #edb/ref 17592186064564} {:db/id #edb/ref 17592186064764} {:db/id #edb/ref 17592186442926} {:db/id #edb/ref 17592186442927} {:db/id #edb/ref 17592186442928} {:db/id #edb/ref 17592186442933} {:db/id #edb/ref 17592186442937}] :knowledge-point/title "Dividing a Negative Number by a Positive Number"} :step/id #uuid "46d3cb51-86b4-59d6-8a39-eab709bb05a3" :step/math-academy-id 77820 :step/next {:db/id #edb/ref 17592186065283}} {:db/id #edb/ref 17592186065283 :step/content {:db/id #edb/ref 17592186065417 :tutorial/content "A positive number divided by a negative number is also a negative number. We can picture this rule as\n\n$$\n\\begin{aligned}(+)\\,÷\\,(-)\\,=\\,(-).\\end{aligned}\n$$\n\nFor instance, to find $8\\div (-2),$ we have to divide a positive number $\\color{blue}(8)$ by a negative one ${\\color{red}(-2)}.$ So the result will be negative:\n![](images/79/797eda7126fff569fccda2681c628f99f103057d7c5e23c1b65cb566b48ef203.svg)\n\nNow, to compute the number that goes in the box, we divide $8$ by $2$ without any signs: $8 \\div 2 = 4.$ So, we get\n\n$$\n{\\color{blue}8} \\div {\\color{red}(-2)} = {\\color{red}-4}.\n$$" :tutorial/id #uuid "67beb927-7da4-5576-8982-1a823c878691" :tutorial/math-academy-id 8109 :tutorial/title "The Quotient of a Positive and a Negative is a Negative"} :step/id #uuid "b2792086-a352-5ca3-b086-f381a58864aa" :step/math-academy-id 77824 :step/next {:db/id #edb/ref 17592186065284}} {:db/id #edb/ref 17592186065284 :step/content {:db/id #edb/ref 17592186064358 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063942 :question/id #uuid "166aaac7-bc88-577a-8e84-47347408e3c9" :question/math-academy-id "e-12973"} :knowledge-point/id #uuid "7de4234d-932f-537c-9eae-746e1711cccd" :knowledge-point/questions [{:db/id #edb/ref 17592186064490} {:db/id #edb/ref 17592186064551} {:db/id #edb/ref 17592186442924} {:db/id #edb/ref 17592186442925} {:db/id #edb/ref 17592186442929} {:db/id #edb/ref 17592186442934} {:db/id #edb/ref 17592186442938} {:db/id #edb/ref 17592186491118}] :knowledge-point/title "Dividing a Positive Number by a Negative Number"} :step/id #uuid "503ce197-02ae-5ae2-897a-80af7de15a2a" :step/math-academy-id 77825 :step/next {:db/id #edb/ref 17592186065285}} {:db/id #edb/ref 17592186065285 :step/content {:db/id #edb/ref 17592186065418 :tutorial/content "Finally, the third rule is that a negative number divided by a negative number is a positive number:\n\n$$\n\\begin{aligned}(-)\\,÷\\,(-)\\,=\\,(+)\\end{aligned}\n$$\n\nTo demonstrate, let's find $-12 \\div (-3).$ We have to divide a negative number $\\color{red}(-12)$ by another negative number ${\\color{red}(-3)}.$ So the result will be positive:\n![](images/d3/d31776de6ab95f8178d0bdd6e3b34cfa2f4fc0b987851dcace50aff1818936da.svg)\n\nNow, to compute the number that goes in the box, we divide $12$ by $3$ without any signs: $12 \\div 3 = 4.$ Therefore,  we get\n\n$$\n{\\color{red}(-12)} \\div {\\color{red}(-3)} = {\\color{blue}4}.\n$$" :tutorial/id #uuid "b1d3d95e-7953-5c5b-b97b-d4eb85e1f80d" :tutorial/math-academy-id 8111 :tutorial/title "The Quotient of a Negative and a Negative is a Positive"} :step/id #uuid "b129822d-f637-5611-9cad-e2f8b6aefca4" :step/math-academy-id 77828 :step/next {:db/id #edb/ref 17592186065286}} {:db/id #edb/ref 17592186065286 :step/content {:db/id #edb/ref 17592186064359 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063943 :question/id #uuid "e2005c9d-c0ff-5b8e-bc64-4e222fd19fdf" :question/math-academy-id "e-12976"} :knowledge-point/id #uuid "b85ef92b-d5fb-5927-aa68-60e72d0b3e72" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050287}] :knowledge-point/questions [{:db/id #edb/ref 17592186064491} {:db/id #edb/ref 17592186064549} {:db/id #edb/ref 17592186064763} {:db/id #edb/ref 17592186442930} {:db/id #edb/ref 17592186442931} {:db/id #edb/ref 17592186442932} {:db/id #edb/ref 17592186442935} {:db/id #edb/ref 17592186442936} {:db/id #edb/ref 17592186491216}] :knowledge-point/title "Dividing a Negative Number by a Negative Number"} :step/id #uuid "8ddc832d-59f9-5fa2-85e2-002f7b9c4ccc" :step/math-academy-id 77829}] :activity/title "Dividing With Negative Numbers" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064421}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186491250} :activity/id #uuid "c415186d-7a79-528f-ade9-bfd554821382" :activity/scope {:db/id #edb/ref 17592186050719 :topic/id #uuid "61178d17-c292-5e1d-a08e-a6ce03bd5a13" :topic/math-academy-id 330} :activity/steps [{:db/id #edb/ref 17592186491239 :step/content {:db/id #edb/ref 17592186064490 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9291dd81-8db7-572e-abb6-47ed16d95a66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\,\\frac{1}{6}" :db/id #edb/ref 17592186490808} {:answer/id #uuid "a20fd88b-a1ae-59ea-8d71-bf0e83f3c2c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\,\\frac{1}{6}" :db/id #edb/ref 17592186490843} {:answer/id #uuid "a820a307-a4eb-5ebe-b435-dac2bf7599a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\,\\frac{5}{6}" :db/id #edb/ref 17592186490848} {:answer/id #uuid "e515b3dc-e776-5382-bf68-34b85c10532d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,\\frac{5}{6}" :db/id #edb/ref 17592186490948} {:answer/id #uuid "f2562b5c-a5b7-583e-97c1-be81c5954f49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\,\\frac{5}{6}" :db/id #edb/ref 17592186490974}] :answer-field/correct {:db/id #edb/ref 17592186490808} :answer-field/id #uuid "7b7911da-da11-5f0a-8cf6-b9c959a6a7e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186061170}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ae2c2497-1704-5e15-bc0f-8e11eb0096e2" :question/math-academy-id "q-128420" :question/problem "Expressed as a mixed number, $19÷(-6)=$" :question/worked-solution "We have to divide a positive number $(19)$ by a negative one $(-6).$ So the result will be negative:\n\n$$\n19÷(-6)=-\\boxed{}\n$$\n\nNow, to compute the number that goes in the box, we divide $19$ by $-6$ without any signs: $19÷6=3\\,\\frac{1}{6}.$ Therefore,  we get\n\n$$\n19÷(-6)=-3\\,\\frac{1}{6}.\n$$"} :step/id #uuid "5b7adfc4-1e35-5210-86d5-7cc073bac538"} {:db/id #edb/ref 17592186491242 :step/content {:db/id #edb/ref 17592186491216 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08c411ff-06f1-50ae-9d29-1123f1bab60d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186490526} {:answer/id #uuid "5bc6dc80-cdb9-5185-ba72-5b0da18b7582" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186490683} {:answer/id #uuid "8249b61b-93f1-54d1-854b-9e287db3d2d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186490773} {:answer/id #uuid "89708e45-ac37-5535-8af3-daf84400d218" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186490784} {:answer/id #uuid "d2880e74-af73-5a7f-8818-28f2c30eaf89" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186490906}] :answer-field/correct {:db/id #edb/ref 17592186490773} :answer-field/id #uuid "de86693b-0da8-5680-a7f2-4ee5874a75ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491091}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f6155bbb-a188-5f03-8345-dcc4bcd6b6f9" :question/math-academy-id "q-99580" :question/problem "$(-21)÷(-7)=$" :question/worked-solution "We have to divide a negative number $(-21)$ by another negative number $(-7).$ So the result will be positive:\n\n$$\n(-21)÷(-7)=\\boxed{}\n$$\n\nNow, to compute the number that goes in the box, we divide $21$ by $7$ without any signs: $21÷7=3.$ Therefore,  we get\n\n$$\n(-21)÷(-7)=3.\n$$"} :step/id #uuid "66340262-74f7-59b9-a3de-975a459daadf" :step/next {:db/id #edb/ref 17592186491239}} {:db/id #edb/ref 17592186491250 :step/content {:db/id #edb/ref 17592186491118 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17caec73-9eb6-523a-86fb-b27f98488576" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186490559} {:answer/id #uuid "47bce39b-7e6b-582c-8a7b-066f77808d00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "22" :db/id #edb/ref 17592186490645} {:answer/id #uuid "8e4ef98f-abc5-5e98-8041-a38342b8599d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-11" :db/id #edb/ref 17592186490796} {:answer/id #uuid "de147237-ad5d-5f58-b44f-b0ef595e5120" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186490931} {:answer/id #uuid "eb05b152-3028-51fb-96ca-91a12c391753" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186490957}] :answer-field/correct {:db/id #edb/ref 17592186490931} :answer-field/id #uuid "c6d0c77a-4046-5f98-9521-dbb913fd4bed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491082}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "12419829-aad3-59c5-99f9-c3ca68b0aa45" :question/math-academy-id "q-75665" :question/problem "$22÷(-11)=$" :question/worked-solution "We have to divide a positive number $(22)$ by a negative one $(-11).$ So the result will be negative:\n\n$$\n22÷(-11)=-\\boxed{}\n$$\n\nNow, to compute the number that goes in the box, we divide $22$ by $11$ without any signs: $22÷11=2.$ Therefore,  we get\n\n$$\n22÷(-11)=-2.\n$$"} :step/id #uuid "7b274cbf-563b-590e-860e-79fdb4e37351" :step/next {:db/id #edb/ref 17592186491242}}] :activity/title "Dividing With Negative Numbers" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186490509}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055793} :activity/id #uuid "beb0ff73-9801-5d7a-8cda-68d3cc158437" :activity/scope {:db/id #edb/ref 17592186050908 :topic/id #uuid "704c70d6-1bf4-5b23-b4da-d122a744acda" :topic/math-academy-id 135} :activity/steps [{:db/id #edb/ref 17592186055793 :step/content {:db/id #edb/ref 17592186056023 :tutorial/content "The **distributive law** states that multiplying a group of terms by a number is the same as multiplying each term separately by that same number and adding the products.\n\nFor example, let's take a look at the following expression: \n\n$$\n2(3+4).\n$$\n\n \n\nWe can evaluate this expression using the distributive law:\n\n![](images/4c/4ca32844e45f756ce88e4d8e6d73e8b69099d2c517157b51fed9bb1f02a699ea.png)\n\nTherefore,\n\n$$\n\\begin{aligned}2(3+4) & = \\\\ 2\\cdot 3+2\\cdot 4 & = \\\\ 6+8 & = \\\\ 14 & .\\end{aligned}\n$$\n\nThe distributive law also applies when the multiplication occurs on the right of the parentheses:\n\n$$\n\\begin{aligned}(3+4)\\cdot 2 & = \\\\ 3\\cdot 2+4\\cdot 2 & = \\\\ 6+8 & = \\\\ 14 & \\end{aligned}\n$$" :tutorial/id #uuid "38c806d3-fe46-5786-81c9-63a1d1bdd9d3" :tutorial/math-academy-id 8112 :tutorial/title "Introduction"} :step/id #uuid "0260c802-439e-52f2-a68b-09274c6a571b" :step/math-academy-id 52198 :step/next {:db/id #edb/ref 17592186055794}} {:db/id #edb/ref 17592186055794 :step/content {:db/id #edb/ref 17592186054777 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054403 :question/id #uuid "cc355989-794d-5053-9539-930149bb2019" :question/math-academy-id "e-12977"} :knowledge-point/id #uuid "070ef753-e976-5aeb-bc1c-5d0397e962ed" :knowledge-point/questions [{:db/id #edb/ref 17592186055379} {:db/id #edb/ref 17592186055395} {:db/id #edb/ref 17592186445155}] :knowledge-point/title "Distributing a Positive Number Over the Sum of Two Terms"} :step/id #uuid "2773b7a6-5cf0-5ec7-ab24-7c3f3e071778" :step/math-academy-id 52199 :step/next {:db/id #edb/ref 17592186055795}} {:db/id #edb/ref 17592186055795 :step/content {:db/id #edb/ref 17592186054778 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054404 :question/id #uuid "8cbbff48-a8bb-54c8-8e64-a73b6f83b590" :question/math-academy-id "e-12978"} :knowledge-point/id #uuid "6cb5920c-6481-57a8-b669-35a94ecb1062" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049349} {:db/id #edb/ref 17592186050421}] :knowledge-point/questions [{:db/id #edb/ref 17592186055230} {:db/id #edb/ref 17592186055396} {:db/id #edb/ref 17592186445153} {:db/id #edb/ref 17592186445154}] :knowledge-point/title "Distributing a Negative Number Over the Sum of Two Terms"} :step/id #uuid "13fb6de4-d0af-5464-a0b6-d0869bef3942" :step/math-academy-id 52202 :step/next {:db/id #edb/ref 17592186055796}} {:db/id #edb/ref 17592186055796 :step/content {:db/id #edb/ref 17592186056024 :tutorial/content "The distributive law also works when there is subtraction inside the parentheses. \n\nFor example, we can expand the expression $2(3-4)$ as follows:\n\n![](images/05/05ba4424f566b35af2a279b994c3a8f13564560deaa60f1c7c4616f52d2fb8d6.png)\n\nNotice that we keep a plus ($+$) sign between the two terms. This helps us to avoid mistakes when multiplying with negative numbers.\n\nNow, evaluating our expression, we have\n\n$$\n\\begin{aligned}2(3-4) & = \\\\ 2\\cdot 3+2\\cdot (-4) & = \\\\ (6)+(-8) & = \\\\ 6-8 & = \\\\ -2 & .\\end{aligned}\n$$\n\nFinally, the distributive law also applies when the multiplication occurs on the right of the parentheses:\n\n$$\n\\begin{aligned}(3-4)\\cdot 2 & = \\\\ 3\\cdot 2+(-4)\\cdot 2 & = \\\\ (6)+(-8) & = \\\\ 6-8 & = \\\\ -2 & .\\end{aligned}\n$$" :tutorial/id #uuid "ac1d8340-9788-5072-a2ae-b1a73d0df048" :tutorial/math-academy-id 8113 :tutorial/title "Dealing With a Minus Inside the Parentheses"} :step/id #uuid "bf71b983-d8a0-5ea7-b63f-9c9cc0dee5ed" :step/math-academy-id 52205 :step/next {:db/id #edb/ref 17592186055797}} {:db/id #edb/ref 17592186055797 :step/content {:db/id #edb/ref 17592186054779 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054405 :question/id #uuid "5a98cb1f-a23d-522b-9677-ed4163db76d2" :question/math-academy-id "e-12979"} :knowledge-point/id #uuid "c3908758-abd6-58c4-bd6e-d4df02c6dff2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050287}] :knowledge-point/questions [{:db/id #edb/ref 17592186055362} {:db/id #edb/ref 17592186055376} {:db/id #edb/ref 17592186445151} {:db/id #edb/ref 17592186445152}] :knowledge-point/title "Distributing a Positive Number Over the Difference of Two Terms"} :step/id #uuid "7b50cc40-2af9-5f98-b18f-05c4449bce2b" :step/math-academy-id 52206 :step/next {:db/id #edb/ref 17592186055798}} {:db/id #edb/ref 17592186055798 :step/content {:db/id #edb/ref 17592186054780 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054406 :question/id #uuid "f93a8815-c7ef-51f9-9c22-f297248fdd6b" :question/math-academy-id "e-12980"} :knowledge-point/id #uuid "1a1b70d3-5120-5def-b9b5-eca62577b587" :knowledge-point/questions [{:db/id #edb/ref 17592186055005} {:db/id #edb/ref 17592186055249} {:db/id #edb/ref 17592186445149} {:db/id #edb/ref 17592186445150}] :knowledge-point/title "Distributing a Negative Number Over the Difference of Two Terms"} :step/id #uuid "9c926434-2ec0-590c-b30c-36f58052ba12" :step/math-academy-id 52209}] :activity/title "Applying the Distributive Law With Linear Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054885}]}
