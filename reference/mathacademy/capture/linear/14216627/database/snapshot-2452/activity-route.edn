#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186527269} :activity/id #uuid "a1eafad8-5c67-5174-abf1-3c1e87367909" :activity/steps [{:db/id #edb/ref 17592186527236 :step/content {:db/id #edb/ref 17592186527137 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d493e3b-385a-5107-9343-c1afd5716efe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1,500\\,\\text{g}" :db/id #edb/ref 17592186526617} {:answer/id #uuid "68969a12-ab8d-5fe8-a14a-06fb1ccbf98d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1,680\\,\\text{g}" :db/id #edb/ref 17592186526711} {:answer/id #uuid "c5535379-efbb-5009-b0bb-c57b33664b00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1,800\\,\\text{g}" :db/id #edb/ref 17592186526882} {:answer/id #uuid "f32e068b-f6a5-59ea-bb32-923d006f5206" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1,940\\,\\text{g}" :db/id #edb/ref 17592186526985} {:answer/id #uuid "f5caf7c2-b7e5-5bcd-82ab-296088282d8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1,720\\,\\text{g}" :db/id #edb/ref 17592186526990}] :answer-field/correct {:db/id #edb/ref 17592186526711} :answer-field/id #uuid "3a6a6020-2874-502a-b31a-02a3e3de1818" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527039}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "21a2d2fe-461f-5c6a-9efc-076472c2d6af" :question/math-academy-id "q-169408" :question/problem "Anna makes two cakes. The first cake weighs $1,200\\,\\text{g},$ while the second cake weighs $140%$ of the weight of the first. What is the weight of the second cake?" :question/worked-solution "To solve this problem, we can use the formula:\n\n$$\n\\text{part}=\\text{percentage}\\times \\text{whole}\n$$\n\nIn our case, the whole is the weight of the first cake, which is $1,200\\,\\text{g}.$ The percentage is $140%,$ and the part is the weight of the second cake.\n\n**Method 1**\n\nFirst, we convert the percentage to a decimal:\n\n$$\n140%=140÷100=1.4\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =140%\\times 1,200 \\\\  & =1.4\\times 1,200 \\\\  & =1,680\\end{aligned}\n$$\n\nTherefore, $140%$ of $1,200$ is $1,680.$ So, the weight of the second cake is $1,680\\,\\text{g}.$\n\n**Method 2**\n\nFirst, we convert the percentage to a fraction:\n\n$$\n140%=\\frac{140}{100}=\\frac{140÷20}{100÷20}=\\frac{7}{5}\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =140%\\times 1,200 \\\\  & =\\frac{7}{5}\\times 1,200 \\\\  & =7\\times \\frac{1,200}{5} \\\\  & =7\\times 240 \\\\  & =1,680\\end{aligned}\n$$\n\nTherefore, $140%$ of $1,200$ is $1,680.$ So, the weight of the second cake is $1,680\\,\\text{g}.$"} :step/id #uuid "1970f46e-8dbe-50a6-9b8a-0d7228e09450" :step/next {:db/id #edb/ref 17592186527280}} {:db/id #edb/ref 17592186527237 :step/content {:db/id #edb/ref 17592186064924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4c8faa5-1306-5258-adad-d2352799b8df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{0}{45}" :db/id #edb/ref 17592186063601} {:answer/id #uuid "17eb0cce-19b6-5e1c-9f58-41f2cd28abc4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Undefined" :db/id #edb/ref 17592186063602} {:answer/id #uuid "258e9e2a-2a79-548b-ad98-33e5ef37c12d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "45" :db/id #edb/ref 17592186063603} {:answer/id #uuid "507bc250-aaa1-5af3-aaf7-aa50b211c534" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{45}" :db/id #edb/ref 17592186063604} {:answer/id #uuid "719cf9fd-9ceb-54c2-a684-617c4694035d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186063605}] :answer-field/correct {:db/id #edb/ref 17592186063602} :answer-field/id #uuid "25815424-57db-5200-9ae4-cdb5fb4e6754" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186063600}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6ad8c94b-1867-5f83-a1f4-c24d479954e0" :question/math-academy-id "q-6165" :question/problem "$45÷0=$" :question/worked-solution "We cannot divide any number by zero. Therefore, $45÷0$ is undefined."} :step/id #uuid "2059b1b0-20c9-5501-aea4-da8a1b553909"} {:db/id #edb/ref 17592186527239 :step/content {:db/id #edb/ref 17592186074391 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96a30579-97a0-54b7-aaa3-ba4885ce522d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186072585} {:answer/id #uuid "da8dab79-c406-52dc-9761-cab9f1e94c2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186072586} {:answer/id #uuid "fc3ff0ca-4bfe-5c56-b214-d654cd70d5c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186072587} {:answer/id #uuid "16e5bcc2-3aef-5c77-b188-7addfb7d0af6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186072588} {:answer/id #uuid "35c818cf-2192-5c9c-aa78-86136c50e3e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186072589}] :answer-field/correct {:db/id #edb/ref 17592186072586} :answer-field/id #uuid "201ae864-664f-5562-b8e8-0155bb54a635" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186072584}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0691c732-4d32-5281-9884-b582edd2db81" :question/math-academy-id "q-59906" :question/problem "There are $18$ parrots and $15$ ducks in a zoo. What number is missing from the boxes in the statement below?\n\nThe ratio of parrots to ducks is $6:\\boxed{}\\,$ because there are $6$ parrots for every $\\boxed{}\\,$ ducks." :question/worked-solution "Since there are $18$ parrots and $15$ ducks, the ratio of parrots to ducks is $18:15.$\n\nWe can simplify this ratio by dividing both numbers by $3$:\n\n$$\n\\begin{aligned}\\,18 &  & : & \\,\\,\\,\\, & \\,\\,15 &  \\\\ \\,\\,\\,↓÷\\,\\,3 &  &  &  & \\,\\,\\,\\,↓÷\\,\\,3 &  \\\\ \\,\\,\\,6 &  & : &  & \\,\\,\\,\\,5 & \\end{aligned}\n$$\n\nThat means that $6:5$ is equivalent to $18:15.$ \n\nSo, the complete statement is\n\"The ratio of parrots to ducks is $6:5\\,$ because there are $6$ parrots for every $5\\,$ ducks.\"\n\nTherefore, the missing number is $5.$"} :step/id #uuid "225a8f92-e15a-59b5-bf0e-1b68e30dd8c1" :step/next {:db/id #edb/ref 17592186527246}} {:db/id #edb/ref 17592186527244 :step/content {:db/id #edb/ref 17592186527207 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "430c59fb-0ec1-5a91-a924-97b3c1a01c01" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$10x$ and $10$" :db/id #edb/ref 17592186526632} {:answer/id #uuid "74649e04-5255-5f44-bde0-61194f6bfa86" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No like terms" :db/id #edb/ref 17592186526729} {:answer/id #uuid "8d5f42c9-e0cb-5e6f-a668-0a91b96a3f91" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-7z$ and $10x$" :db/id #edb/ref 17592186526785} {:answer/id #uuid "b03c765f-e75f-5dcf-809c-01376850ca45" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-18y$ and $10$" :db/id #edb/ref 17592186526837} {:answer/id #uuid "cd60ad42-5e67-5777-adad-2ef5ec66220b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-18y$ and $-7z$" :db/id #edb/ref 17592186526894}] :answer-field/correct {:db/id #edb/ref 17592186526729} :answer-field/id #uuid "df398605-069b-578f-992d-7e4d3a80a44a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527106}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c03bfbc1-ac68-5596-a4f4-f714ecc885a9" :question/math-academy-id "q-101757" :question/problem "What are the like terms in the expression $10x-18y-7z+10?$" :question/worked-solution "We write the terms of the expression as follows:\n\n$$\n(10x)+(-18y)+(-7z)+(10).\n$$\n\nNone of these terms have the same variable part. Consequently, there are no like terms in this expression."} :step/id #uuid "3dfc868b-da60-56e8-b7f4-a17062334783" :step/next {:db/id #edb/ref 17592186527253}} {:db/id #edb/ref 17592186527246 :step/content {:db/id #edb/ref 17592186152870 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9670980d-0c33-5120-a8ae-e23cf2dd27d8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186151728} {:answer/id #uuid "b302849a-eda8-5c71-b37c-efab8f9fb26e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186151729} {:answer/id #uuid "e5cfffb3-0174-533c-96f5-9f587474d935" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186151730} {:answer/id #uuid "eacca51c-b53a-5e95-aff5-f97957308643" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186151731} {:answer/id #uuid "44525daf-0489-5c87-96c1-14f06cd29ce5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186151732}] :answer-field/correct {:db/id #edb/ref 17592186151731} :answer-field/id #uuid "e7ddc8fa-ba31-589c-9917-aee0dc71b65e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186151727}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "39369502-10cb-5b34-b9b4-f444ee2b4bd4" :question/math-academy-id "q-93603" :question/problem "Which of the following numbers are integers?\n\nI. $1$\n\nII. $-2$\n\nIII. $-\\frac{1}{2}$" :question/worked-solution "The integers consist of all positive and negative whole numbers and zero.\n\n$$\n…,-3,\\,-2,\\,-1,\\,0,\\,1,\\,2,\\,3,…\n$$\n\n \n\nOf the given numbers, $1$ and $-2$ are integers, but $-\\frac{1}{2}$ is not.\n\nTherefore, the correct answer is \"I and II only.\""} :step/id #uuid "432e8981-4006-548f-8eab-786e3e1d223a" :step/next {:db/id #edb/ref 17592186527244}} {:db/id #edb/ref 17592186527248 :step/content {:db/id #edb/ref 17592186527138 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22e3e76f-dc9c-57b8-8257-1bd0e126870c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186526578} {:answer/id #uuid "78fb9bb8-f5cd-579b-8da8-ad29d8ac8d2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186526740} {:answer/id #uuid "79cf0447-e1e6-5819-a545-67c520d7fb14" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186526742} {:answer/id #uuid "8f773a58-226e-501c-8fe2-a236b4c4f65a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186526787} {:answer/id #uuid "b0dc1b05-f0bd-55da-a84f-44cdc160d318" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186526841}] :answer-field/correct {:db/id #edb/ref 17592186526787} :answer-field/id #uuid "6a86050d-8890-58f8-9edb-a6ea2587521d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527062}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "23bd23d2-9b32-5ac7-a70a-faac16c61773" :question/math-academy-id "q-160597" :question/problem "What is the distance between the points $(0,2)$  and $(0,5)?$" :question/worked-solution "**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/f3/f329376e27ec08d2695db0e6d007e7a7b5342e7737c5d3f45eb524a2b1c2e572.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $3$ units, so the distance equals $3.$\n\n![](images/66/66543bc73667ed70a965db4af2e657ad991660fc1b3a73a6e585943deffd3bbb.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $x$-axis and then subtracting.\n\n![](images/5d/5ded01b570e62d1e206aa8abd1012121367e60e749d441eb4e6ec7e3b12f6e8a.png)\n\nThe point $(0,5)$ is at a distance of $5$ from the $x$-axis, and the point $(0,2)$ is at a distance of $2$ from the $x$-axis. Therefore, the distance between the two points is $5-2=3.$"} :step/id #uuid "4702ef88-748a-5129-9991-89f17d1f3e25" :step/next {:db/id #edb/ref 17592186527275}} {:db/id #edb/ref 17592186527251 :step/content {:db/id #edb/ref 17592186527161 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fd8663f-2fcb-5208-a496-a309cc26dd51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4b" :db/id #edb/ref 17592186526629} {:answer/id #uuid "59d32871-b127-5f6c-abbd-d1dfc584422f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186526685} {:answer/id #uuid "7e5b6940-eace-5aff-ac22-af6a6f97e50c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186526750} {:answer/id #uuid "7fa11361-56d4-5ceb-927c-caac0ea52b15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186526758} {:answer/id #uuid "df0a8216-29ab-5dcc-bed2-d4bf11ad9854" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6a" :db/id #edb/ref 17592186526938}] :answer-field/correct {:db/id #edb/ref 17592186526758} :answer-field/id #uuid "c4199400-b56c-59e9-9b3d-11651577e755" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527097}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "454efe3b-e281-5051-bb7a-cf90c5710624" :question/math-academy-id "q-75596" :question/problem "What is the constant term in the expression $\\frac{2}{3}+6a-4b?$" :question/worked-solution "The expression has three terms: $\\frac{2}{3}$, $6a$, and $-4b.$  The only term that does not contain any variables is $\\frac{2}{3}$, so $\\frac{2}{3}$ is the constant term."} :step/id #uuid "52bea015-1465-5dc3-8bb7-db8390ac1fea" :step/next {:db/id #edb/ref 17592186527276}} {:db/id #edb/ref 17592186527253 :step/content {:db/id #edb/ref 17592186527149 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "185162bb-5aa3-5c3e-a43d-52c81ce56230" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186526553} {:answer/id #uuid "2271ac3f-928c-59b8-9b16-901dbbb47dce" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186526576} {:answer/id #uuid "6e1bce80-8f6f-54f6-a118-9120fdf04361" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186526719} {:answer/id #uuid "9af44677-9124-5bfd-b6ec-4ab308b7a5a2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186526803} {:answer/id #uuid "bbac0612-ed15-5839-94e6-475dabcd03b4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186526863}] :answer-field/correct {:db/id #edb/ref 17592186526863} :answer-field/id #uuid "c2693e54-d2f9-5e44-a62c-c85a8a82a915" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527096}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "33724016-d9da-53c5-bcf3-d48acaf1fa22" :question/math-academy-id "q-85461" :question/problem "Which of the following numbers are divisible by $6?$\n\nI. $11\\,289\\,643$\n\nII. $13\\,298\\,784$\n\nIII. $215\\,153\\,238$" :question/worked-solution "A number is divisible by $6$ if it is divisible by both $2$ and $3.$\n\n- The number $11\\,289\\,643$ is not divisible by $2,$ so it is not divisible by $6$ either.\n\n- The number $13\\,298\\,784$ is divisible by $2,$ and it is also divisible by $3$ since the sum of its digits is divisible by $3:$\n\n$$\n1+3+2+9+8+7+8+4=42\n$$\n\nSo, $13\\,298\\,784$ is divisible by $6.$\n\n- The number $215\\,153\\,238$ is divisible by $2,$ and it is also divisible by $3$ since the sum of its digits is divisible by $3:$\n\n$$\n2+1+5+1+5+3+2+3+8=30\n$$\n\nSo, $215\\,153\\,238$ is divisible by $6.$\n\nTherefore, the correct answer is \"II and III only.\""} :step/id #uuid "57ae26bb-1d1c-5519-9232-41ff1c3d805d" :step/next {:db/id #edb/ref 17592186527263}} {:db/id #edb/ref 17592186527263 :step/content {:db/id #edb/ref 17592186527191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ea22cec-3976-5306-b057-80fe9b5fca34" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $7$" :db/id #edb/ref 17592186526622} {:answer/id #uuid "7fb8aa12-476f-54d9-a946-3a656640cd8d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4$ and $3$" :db/id #edb/ref 17592186526759} {:answer/id #uuid "81318e94-fe4f-503d-9fe9-cea67c21da42" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4$ and $7$" :db/id #edb/ref 17592186526761} {:answer/id #uuid "8f05742c-c5dd-55fd-82a0-9d57aea45582" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $4$" :db/id #edb/ref 17592186526786} {:answer/id #uuid "d182b9fc-285a-5a5a-a274-975a40cad8f6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$7$ and $3$" :db/id #edb/ref 17592186526907}] :answer-field/correct {:db/id #edb/ref 17592186526786} :answer-field/id #uuid "34a6e6c6-0e15-53b6-808a-63020a7889ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527034}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a55cec5a-6ff7-549a-82f5-76546ccf37c7" :question/math-academy-id "q-92945" :question/problem "From left to right, what are the missing numbers in the following sentence?\n\nTo paint his car, Anthony mixes blue paint with thinner. ​He requires $\\frac{3}{4}$ gallons of paint for every gallon of thinner. Therefore, the mixture has a ratio of $\\boxed{}$ gallons of paint to $\\boxed{}$ gallons of thinner." :question/worked-solution "Let's rewrite the fraction $\\frac{3}{4}$ as a ratio:\n\n$$\n3:4\n$$\n\nTherefore, the mixture has a ratio of $3$ gallons of paint to $4$ gallons of thinner."} :step/id #uuid "7dd5b233-5ec1-5271-b9f4-243c09dcaf30" :step/next {:db/id #edb/ref 17592186527237}} {:db/id #edb/ref 17592186527266 :step/content {:db/id #edb/ref 17592186527167 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3086bc9e-0fdf-59d0-b482-9782173550b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{12}{5}" :db/id #edb/ref 17592186526597}] :answer-field/correct {:db/id #edb/ref 17592186526597} :answer-field/id #uuid "2f6e0284-0b7f-5c7c-9d1a-d5093d110973" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186527026}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "61f14a3a-d997-54ee-80e7-e8241a88c524" :question/math-academy-id "q-181162" :question/problem "The value of $12÷(-5),$ expressed as an **improper fraction** in lowest terms, is{{field-1}}." :question/worked-solution "We have to divide a positive number $(12)$ by a negative one $(-5).$ So the result will be negative:\n\n$$\n12÷(-5)=-\\boxed{}\n$$\n\nNow, to compute the number that goes in the box, we divide $12$ by $5$ without any signs: $12÷5=\\frac{12}{5}.$ Therefore, we get\n\n$$\n12÷(-5)=-\\frac{12}{5}.\n$$"} :step/id #uuid "81e062c8-fe4c-518b-8931-2324fe9f7c1e" :step/next {:db/id #edb/ref 17592186527236}} {:db/id #edb/ref 17592186527269 :step/content {:db/id #edb/ref 17592186527123 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "971a476b-092c-5d91-b8fa-81b2b6ab3d00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4900" :db/id #edb/ref 17592186526799}] :answer-field/correct {:db/id #edb/ref 17592186526799} :answer-field/id #uuid "46e559e6-e4ac-5019-a50d-551c23e251b4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186527048}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "01e96138-a1bd-5aa7-aa98-7c5862390efd" :question/math-academy-id "q-185123" :question/problem "$(-70)^{2}=${{field-1}}" :question/worked-solution "To work out $(-70)^{2},$ we multiply $-70$ by itself:\n\n$$\n(-70)^{2}=(-70)\\cdot (-70)=4,900\n$$"} :step/id #uuid "9815ddbf-daf1-5c76-b2f4-2074e02235c2" :step/next {:db/id #edb/ref 17592186527251}} {:db/id #edb/ref 17592186527272 :step/content {:db/id #edb/ref 17592186527150 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09c7191f-9231-5628-b2be-151f0fe75054" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186526522} {:answer/id #uuid "46afe266-6d3a-5859-a3fe-9e6843b9f2d9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186526640} {:answer/id #uuid "5207156e-3306-5267-bf27-448383fe284d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186526666} {:answer/id #uuid "85523798-fbc8-51c4-81ec-a6fd45f4f5f6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186526770} {:answer/id #uuid "af88dc91-36a7-5516-bde0-5fb4f3671912" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186526836}] :answer-field/correct {:db/id #edb/ref 17592186526640} :answer-field/id #uuid "120ed5ca-accb-5a8e-8311-e6ba2c45c2e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527019}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "34603e37-b60f-5eb1-996c-5382f05619c6" :question/math-academy-id "q-155548" :question/problem "![](images/86/867e0d53894e1cacac86120e5c79b32071e2b0a4863b445e6d3492392a59461d.png)\n\nConsider the figure shown above. Which of the following triplets of points are collinear?\n\nI. $M,Q,J$\n\nII. $P,O,L$\n\nIII. $L,O,M$" :question/worked-solution "- $M,Q,J$ are **not** collinear since we can't draw a straight line that passes through all of them.\n\n![](images/7f/7f707d8fbeb9853ccb9441bbdab3b0674c5f51da7f73da73d73ee6592dca04ea.png)\n\n- $P,O,L$ are **not** collinear since we can't draw a straight line that passes through all of them.\n\n![](images/02/028ae56c8a85699d4d6719df2f80a989f1271e392546d005093319af2365675d.png)\n\n \n\n- $L,O,M$ are collinear since there is a straight line that passes through all of them.\n\n![](images/bf/bf0579ecbc33ebe2d97dc1b305de0a89b0c22dadd6a11d0e88ac4a36acbd447f.png)\n\nTherefore, the correct answer is \"III only.\""} :step/id #uuid "a25a34e2-198b-56d4-b21b-6a474dab3cf8" :step/next {:db/id #edb/ref 17592186527248}} {:db/id #edb/ref 17592186527275 :step/content {:db/id #edb/ref 17592186527176 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02e1c9af-d060-5bfc-b1e9-24bfc3c85aec" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$A$ and $G$" :db/id #edb/ref 17592186526507} {:answer/id #uuid "4843a18c-f231-51a7-86f1-a3a822413c27" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$B$ and $E$" :db/id #edb/ref 17592186526646} {:answer/id #uuid "6246fcce-dc76-5572-8d13-e91c256ef040" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$C$ and $G$" :db/id #edb/ref 17592186526698} {:answer/id #uuid "dd251353-2c7e-5ab4-9771-6cd4f927f27a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$E$ and $G$" :db/id #edb/ref 17592186526934} {:answer/id #uuid "e51fe53a-9370-5baf-91e6-98eb06fd11fa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$A$ and $D$" :db/id #edb/ref 17592186526952}] :answer-field/correct {:db/id #edb/ref 17592186526934} :answer-field/id #uuid "c7344e6a-19ec-5e61-9602-eaee720b79b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527098}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8670832a-c9ac-5ad5-acea-ff50047338a5" :question/math-academy-id "q-117935" :question/problem "![](images/3e/3e1675e22ef33aa40b96349c910f04178dd4b11b1e7e97f15a5314977eea914f.png)\n\nWhich vertices are adjacent to $F?$" :question/worked-solution "$F$ is the endpoint of the sides $\\overset{―}{FG}$ and $\\overset{―}{EF}.$ Therefore, the vertices $E$ and $G$ are adjacent to $F.$"} :step/id #uuid "b678e3cc-2177-5e35-8a73-c03505a5ac3d" :step/next {:db/id #edb/ref 17592186527266}} {:db/id #edb/ref 17592186527276 :step/content {:db/id #edb/ref 17592186527220 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dca033f0-f14b-5230-bf01-67d043b720cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3.8" :db/id #edb/ref 17592186526932}] :answer-field/correct {:db/id #edb/ref 17592186526932} :answer-field/id #uuid "f248478f-3341-58c6-9f8c-098a17912162" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186527118}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e12935f7-7208-5953-a547-9693833e1308" :question/math-academy-id "q-186120" :question/problem "$1.2-5=${{field-1}}" :question/worked-solution "Since $5$ is larger than $1.2,$ the answer will be negative.\n\nWe start by solving an easier problem, which is to carry out the subtraction in the reverse order:\n\n$$\n5-1.2=3.8\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n1.2-5=-3.8.\n$$"} :step/id #uuid "b6d054df-38a3-594e-be57-1c28893d93fd" :step/next {:db/id #edb/ref 17592186527272}} {:db/id #edb/ref 17592186527280 :step/content {:db/id #edb/ref 17592186527188 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ee77bd5-df0e-510f-b7f2-51e63de54bcd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186526569}] :answer-field/correct {:db/id #edb/ref 17592186526569} :answer-field/id #uuid "074cf9a5-849c-5c4d-8d92-a3bbdf321b5e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186527014} {:answer-field/choices [{:answer/id #uuid "e65f4f12-b4e4-5cf1-a812-0955161571c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40" :db/id #edb/ref 17592186526955}] :answer-field/correct {:db/id #edb/ref 17592186526955} :answer-field/id #uuid "386eb6df-75b9-5eab-b726-efd4b1504a1b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186527037}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9d8b1706-5dbe-56db-8638-95f308211cb0" :question/math-academy-id "q-171509" :question/problem "$8(2u-5v)=${{field-1}}\n$u\\,-$\n{{field-2}}\n$v$" :question/worked-solution "Using the distributive law, we multiply each term inside the parentheses by the number $8:$\n\n$$\n\\begin{aligned}8(2u-5v) & = \\\\ 8\\cdot 2u+8\\cdot (-5v) & = \\\\ (16u)+(-40v) & = \\\\ 16u-40v\\end{aligned}\n$$"} :step/id #uuid "dddfe964-9d8d-54a5-b036-2e51ec7242a2" :step/next {:db/id #edb/ref 17592186527285}} {:db/id #edb/ref 17592186527285 :step/content {:db/id #edb/ref 17592186527169 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "233ea723-90ba-5735-940f-5b13fb2a72aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186526580} {:answer/id #uuid "6b69c0f3-19cd-5195-893f-15c580e17e44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186526716} {:answer/id #uuid "6ee49291-e290-50b6-83d8-095e7de4ef05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1\\,\\frac{2}{3}" :db/id #edb/ref 17592186526720} {:answer/id #uuid "975bb6ad-0f2c-5252-bd1b-a38be3669eed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186526800} {:answer/id #uuid "b3fd647d-63c1-548a-8bd3-47160dff89c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186526848}] :answer-field/correct {:db/id #edb/ref 17592186526716} :answer-field/id #uuid "43e0bccd-6b23-5084-88cd-20af6e72cdf6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186527046}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "72a5b03b-3213-5354-ab4d-cb82e383745f" :question/math-academy-id "q-119548" :question/problem "Find the value of $\\frac{2}{3}-1\\,\\frac{1}{3}.$" :question/worked-solution "First, we write $1\\,\\frac{1}{3}$ as an improper fraction:\n\n$$\n1\\,\\frac{1}{3}=\\frac{(1\\times 3)+1}{3}=\\frac{4}{3}\n$$\n\nSince both fractions have the same denominators, we can combine them into one fraction, which gives\n\n$$\n\\frac{2}{3}-\\frac{4}{3}=\\frac{2-4}{3}.\n$$\n\nNow, we work out $2-4$ using a number line:\n\n![](images/fd/fd7fc3fedd2dbf8c90592bbedfdc15181eae63e4d2cbd71a4c036b2d75e8921c.png)\n\nSo, we get \n\n$$\n\\frac{2-4}{3}=\\frac{-2}{3}=-\\frac{2}{3}.\n$$"} :step/id #uuid "eec50d62-f0ab-5ad9-b2e5-0d10ea312c48" :step/next {:db/id #edb/ref 17592186527239}}] :activity/title "Quiz 6" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186526491}]}
