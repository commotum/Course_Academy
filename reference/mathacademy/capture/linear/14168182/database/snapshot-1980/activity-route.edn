#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186492094} :activity/id #uuid "9814bdeb-c5c1-549b-8942-0dcd8592f0fd" :activity/scope {:db/id #edb/ref 17592186049051 :topic/id #uuid "d5e55293-c14f-55db-a945-4aa2b42df552" :topic/math-academy-id 2310} :activity/steps [{:db/id #edb/ref 17592186492079 :step/content {:db/id #edb/ref 17592186492061 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03910583-d566-5a8b-bfc2-8972fe3ecdd6" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f6/f6139cea308db19681b8e2239e01f77d4af406a728041aa738b29ee3ce6a603e.png" :db/id #edb/ref 17592186491454} {:answer/id #uuid "7b650c21-47ed-5214-a59e-48d2075d1b3f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/90/901ffc463b1516e30690f41af6225c62a1a3cc3950bc34e28bc5b13ae7314b28.png" :db/id #edb/ref 17592186491672} {:answer/id #uuid "8698ddac-ea80-50d9-9ad8-a8742ba97aef" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/24/2415d02b1c88fbeb254f41d3540b81e20be8fb94da400b77fabca65e40da3b8c.png" :db/id #edb/ref 17592186491685} {:answer/id #uuid "97ae2684-9fda-5d9f-bda1-046e9cd84f79" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/6f/6fa6ef603a454d9f219ca5967a87a99cc8afabc30105d36879c172b8385fd36b.png" :db/id #edb/ref 17592186491718} {:answer/id #uuid "ad0ec700-72a5-535a-a4a1-e48679183f05" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/49/496986cb7dca8bffb2d2856f3867e48d794f106139d4703e1b2166d9a223781d.png" :db/id #edb/ref 17592186491756}] :answer-field/correct {:db/id #edb/ref 17592186491454} :answer-field/id #uuid "d9c1885b-25c3-55b9-8caf-90ff3bd587c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491970}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d2934ac4-af1a-5b63-bae8-4d35ad544ba0" :question/math-academy-id "q-54810" :question/problem "Which of the following number lines represents the inequality $-3<x<1?$" :question/worked-solution "The inequality $-3<x<1$ means that $x$ can take any value greater than $-3,$ and less than $1.$\n\nTo represent this on a number line, we draw an open circle at $-3$ and another open circle at $1.$ Then, we highlight the region between the points.\n\n![](images/f6/f6139cea308db19681b8e2239e01f77d4af406a728041aa738b29ee3ce6a603e.png)"} :step/id #uuid "1a122adf-7490-5a96-86fc-64fdc36ac5fa" :step/next {:db/id #edb/ref 17592186492092}} {:db/id #edb/ref 17592186492092 :step/content {:db/id #edb/ref 17592186491986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0158d2c2-46e2-511e-9829-663aca526316" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x\\le -1$ or $x\\ge 1$" :db/id #edb/ref 17592186491450} {:answer/id #uuid "2fd0b12d-c6d3-5074-bd89-cbaa31e2e2ef" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x<-1$ or $x>1$" :db/id #edb/ref 17592186491548} {:answer/id #uuid "3f38c2dd-7e7e-5407-9e8b-c247c54b9afc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x>-1$ or $x>1$" :db/id #edb/ref 17592186491579} {:answer/id #uuid "7853872b-6305-5952-a1e3-1e4da4e83d64" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x<-1$ or $x<1$" :db/id #edb/ref 17592186491663} {:answer/id #uuid "a7ce2a8a-1854-5692-8ab6-ce6a4ef7ea6e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x\\ge -1$ or $x\\le 1$" :db/id #edb/ref 17592186491747}] :answer-field/correct {:db/id #edb/ref 17592186491548} :answer-field/id #uuid "81599ce3-b5fd-5790-a91f-aa92a6b6fa9f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491931}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "087d9e13-8fc3-51e2-a62c-c006b17d535f" :question/math-academy-id "q-54820" :question/problem "![](images/f2/f2fc2248ce56cd8209d9f6438d24c7f9e9f805f320ef5549be25282cfbaa6e61.png)\n\nWhich inequality corresponds to the highlighted region shown on the number line above?" :question/worked-solution "The red rays contain all values less than  $-1$ or greater than $1.$ In addition,\n\n- the open circle at $-1$ implies that $x$ cannot be equal to $-1,$ and\n\n- the open circle at $1$ implies that $x$ cannot be equal to $1.$\n\nTherefore, the highlighted region represents $x<-1$ or $x>1.$"} :step/id #uuid "471f4a51-0ae6-5b3b-b0f1-91ebb382a932"} {:db/id #edb/ref 17592186492094 :step/content {:db/id #edb/ref 17592186492032 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05fd7dc9-4b77-586d-9ed5-f96227aed75b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2<x<2" :db/id #edb/ref 17592186491463} {:answer/id #uuid "1b458bce-037d-59e4-a297-afaa3a6e5449" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2<x\\le 2" :db/id #edb/ref 17592186491508} {:answer/id #uuid "5101b5ff-6f7e-5771-aeaf-1f3ea7c2baa6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\le x\\le 2" :db/id #edb/ref 17592186491607} {:answer/id #uuid "9bb5ca05-d4de-59e6-8172-825f719298fb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x\\le 2$ or $x\\ge -2$" :db/id #edb/ref 17592186491722} {:answer/id #uuid "f6121d20-e884-5a07-9ef4-25a31648abf1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\le x<2" :db/id #edb/ref 17592186491875}] :answer-field/correct {:db/id #edb/ref 17592186491607} :answer-field/id #uuid "9deac3f0-5baf-51d6-9fda-87f6599c1dbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491947}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8a1c7bea-76d1-5380-abbc-23d155edc522" :question/math-academy-id "q-28797" :question/problem "![](images/67/67c1fa5db66f96b6bbbccacf251f3cdc655fc88a6b87499234f4b1cd0a21da1d.png)\n\nWhich inequality corresponds to the highlighted region shown on the number line above?" :question/worked-solution "The red segment contains all values between  $-2$ and $2.$\n\n- the closed circle at $-2$ implies that $x$ can be equal to $-2,$ while\n\n- the closed circle at $2$ implies that $x$ can be equal to $2.$\n\nTherefore, the highlighted region represents $-2\\le x\\le 2.$"} :step/id #uuid "5ec340ac-62fa-5a0a-99de-ca8554313a1d" :step/next {:db/id #edb/ref 17592186492079}}] :activity/title "Compound Inequalities" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186491445}]}
