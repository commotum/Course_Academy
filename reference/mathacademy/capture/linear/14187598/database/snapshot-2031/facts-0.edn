92186045417] [17592186268572 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186268572 #edb/ref 1078 #edb/ref 17592186266810 #edb/ref 17592186045417] [17592186268572 #edb/ref 1079 #uuid "5c6cafc4-9dc2-565c-80eb-4f8b664e9a00" #edb/ref 17592186045417] [17592186268717 #edb/ref 1075 #edb/ref 17592186266412 #edb/ref 17592186045417] [17592186268717 #edb/ref 1075 #edb/ref 17592186266732 #edb/ref 17592186045417] [17592186268717 #edb/ref 1075 #edb/ref 17592186266770 #edb/ref 17592186045417] [17592186268717 #edb/ref 1075 #edb/ref 17592186268214 #edb/ref 17592186045417] [17592186268717 #edb/ref 1075 #edb/ref 17592186268364 #edb/ref 17592186045417] [17592186268717 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186268717 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186268717 #edb/ref 1078 #edb/ref 17592186266770 #edb/ref 17592186045417] [17592186268717 #edb/ref 1079 #uuid "acd1cc16-ec8f-5475-977d-083061ae322e" #edb/ref 17592186045417] [17592186268977 #edb/ref 1068 #edb/ref 17592186268461 #edb/ref 17592186045417] [17592186268977 #edb/ref 1069 "q-134166" #edb/ref 17592186045417] [17592186268977 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186268977 #edb/ref 1071 "A starfish moves $12$ miles in $20$ hours, moving at a constant pace. What is the speed of the starfish?" #edb/ref 17592186045417] [17592186268977 #edb/ref 1072 #uuid "92eb8359-565d-5258-8440-1577884a7d0c" #edb/ref 17592186045417] [17592186268977 #edb/ref 1074 "Speed is a special unit rate applied to moving objects. It is defined as *the distance traveled per unit of time*:\n\n$$\n\\text{speed}=\\frac{\\text{distance}}{\\text{time}}\n$$\n\nTo find the speed (in miles per hour), we divide the number of miles, $12,$ by the number of hours, $20.$ This gives,\n\n$$\n\\begin{aligned}\\frac{12}{20} & =\\frac{12÷2}{20÷2} \\\\  & =\\frac{6}{10} \\\\  & =6÷10 \\\\  & =0.6.\\end{aligned}\n$$\n\nTherefore, the speed of starfish is $0.6$ miles per hour." #edb/ref 17592186045417] [17592186268982 #edb/ref 1068 #edb/ref 17592186268572 #edb/ref 17592186045417] [17592186268982 #edb/ref 1069 "q-134175" #edb/ref 17592186045417] [17592186268982 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186268982 #edb/ref 1071 "A glacier moves $49$ feet in $14$ months, moving at a constant rate. What is the speed of the glacier?" #edb/ref 17592186045417] [17592186268982 #edb/ref 1072 #uuid "092153b5-3d29-5359-9158-6afcdd233831" #edb/ref 17592186045417] [17592186268982 #edb/ref 1074 "Speed is a special unit rate applied to moving objects. It is defined as *the distance traveled per unit of time*:\n\n$$\n\\text{speed}=\\frac{\\text{distance}}{\\text{time}}\n$$\n\nTo find the speed, in feet per month, we divide the number of feet $49,$ by the number of months, $14.$ This gives,\n\n$$\n\\begin{aligned}\\frac{49}{14} & =\\frac{49÷7}{14÷7} \\\\  & =\\frac{7}{2} \\\\  & =7÷2 \\\\  & =3.5.\\end{aligned}\n$$\n\nTherefore, the speed of the glacier is $3.5$ feet per month." #edb/ref 17592186045417] [17592186268983 #edb/ref 1068 #edb/ref 17592186268717 #edb/ref 17592186045417] [17592186268983 #edb/ref 1069 "q-134176" #edb/ref 17592186045417] [17592186268983 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186268983 #edb/ref 1071 "A spacecraft traveled for $15$ seconds at a constant speed of $12$ kilometers per second. Find the distance covered by the spacecraft." #edb/ref 17592186045417] [17592186268983 #edb/ref 1072 #uuid "51d90e7f-b1f8-520b-8eca-6b795a2f6717" #edb/ref 17592186045417] [17592186268983 #edb/ref 1074 "The speed is $12$ kilometers per second. To find the distance covered in $15$ seconds, we multiply the speed by $15.$ This gives\n\n$$\n\\begin{aligned}\\text{distance} & =\\text{speed}\\cdot \\text{time} \\\\  & =12\\times 15 \\\\  & =180.\\end{aligned}\n$$\n\nTherefore, the spacecraft covered $180$ kilometers in $15$ seconds." #edb/ref 17592186045417] [17592186268990 #edb/ref 1068 #edb/ref 17592186268553 #edb/ref 17592186045417] [17592186268990 #edb/ref 1069 "q-134220" #edb/ref 17592186045417] [17592186268990 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186268990 #edb/ref 1071 "A jet ski traveled $3\\,960$ meters at a constant speed of $660$ meters per minute. For how long was the jet ski in motion?" #edb/ref 17592186045417] [17592186268990 #edb/ref 1072 #uuid "27bf74aa-5d79-5da2-ae74-80f3b8309260" #edb/ref 17592186045417] [17592186268990 #edb/ref 1074 "The speed is $660$ meters per minute. To find the time it took the jet ski to cover $3\\,960$ meters, we divide the distance by $660.$ This gives\n\n$$\n\\begin{aligned}\\text{time} & =\\frac{\\text{distance}}{\\text{speed}} \\\\  & =\\frac{3\\,960}{660} \\\\  & =\\frac{3\\,960÷60}{660÷60} \\\\  & =\\frac{66}{11} \\\\  & =66÷11 \\\\  & =6.\\end{aligned}\n$$\n\nTherefore, the jet ski was in motion for $6$ minutes." #edb/ref 17592186045417]}
