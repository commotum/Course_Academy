/ident :answer.type/text} :answer/value "$0.4$ miles per hour" :db/id #edb/ref 17592186267168} {:answer/id #uuid "8a9ec757-ea60-57ac-98aa-44123ac4c3e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$60$ miles per hour" :db/id #edb/ref 17592186267381} {:answer/id #uuid "a2b3603b-e675-5ab2-bb5c-4cc753f2e340" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0.6$ miles per hour" :db/id #edb/ref 17592186267607} {:answer/id #uuid "e2648c37-45ba-53bc-9614-4d27b8f0b799" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1.2$ miles per hour" :db/id #edb/ref 17592186268143}] :answer-field/correct {:answer/id #uuid "a2b3603b-e675-5ab2-bb5c-4cc753f2e340" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0.6$ miles per hour" :db/id #edb/ref 17592186267607} :answer-field/id #uuid "22554186-b81b-5c6f-9b87-31f0d839d4f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268461}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "92eb8359-565d-5258-8440-1577884a7d0c" :question/math-academy-id "q-134166" :question/problem "A starfish moves $12$ miles in $20$ hours, moving at a constant pace. What is the speed of the starfish?" :question/worked-solution "Speed is a special unit rate applied to moving objects. It is defined as *the distance traveled per unit of time*:\n\n$$\n\\text{speed}=\\frac{\\text{distance}}{\\text{time}}\n$$\n\nTo find the speed (in miles per hour), we divide the number of miles, $12,$ by the number of hours, $20.$ This gives,\n\n$$\n\\begin{aligned}\\frac{12}{20} & =\\frac{12÷2}{20÷2} \\\\  & =\\frac{6}{10} \\\\  & =6÷10 \\\\  & =0.6.\\end{aligned}\n$$\n\nTherefore, the speed of starfish is $0.6$ miles per hour."}] [{:db/id #edb/ref 17592186268982 :knowledge-point/_questions [{:db/id #edb/ref 17592186176030 :knowledge-point/id #uuid "88babe91-d8bf-53ba-8d72-35ad35f9253e" :knowledge-point/title "Calculating the Speed of an Object"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c860c0c-180d-5348-9a89-50590ef2af0d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$14$ feet per month" :db/id #edb/ref 17592186266675} {:answer/id #uuid "3ff68337-30a6-56cb-9e0c-cceec84e978d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ feet per month" :db/id #edb/ref 17592186266720} {:answer/id #uuid "4b017598-f873-5e89-9456-aafa8e9bda99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3.5$ feet per month" :db/id #edb/ref 17592186266810} {:answer/id #uuid "d7760980-efdd-5cd2-a127-c574a19dabfe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7.5$ feet per month" :db/id #edb/ref 17592186268059} {:answer/id #uuid "ee174e05-a53b-532c-a170-e15711d62d92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4.5$ feet per month" :db/id #edb/ref 17592186268262}] :answer-field/correct {:answer/id #uuid "4b017598-f873-5e89-9456-aafa8e9bda99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3.5$ feet per month" :db/id #edb/ref 17592186266810} :answer-field/id #uuid "5c6cafc4-9dc2-565c-80eb-4f8b664e9a00" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268572}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "092153b5-3d29-5359-9158-6afcdd233831" :question/math-academy-id "q-134175" :question/problem "A glacier moves $49$ feet in $14$ months, moving at a constant rate. What is the speed of the glacier?" :question/worked-solution "Speed is a special unit rate applied to moving objects. It is defined as *the distance traveled per unit of time*:\n\n$$\n\\text{speed}=\\frac{\\text{distance}}{\\text{time}}\n$$\n\nTo find the speed, in feet per month, we divide the number of feet $49,$ by the number of months, $14.$ This gives,\n\n$$\n\\begin{aligned}\\frac{49}{14} & =\\frac{49÷7}{14÷7} \\\\  & =\\frac{7}{2} \\\\  & =7÷2 \\\\  & =3.5.\\end{aligned}\n$$\n\nTherefore, the speed of the glacier is $3.5$ feet per month."}] [{:db/id #edb/ref 17592186268983 :knowledge-point/_questions [{:db/id #edb/ref 17592186176031 :knowledge-point/id #uuid "534de76f-d4bc-55b5-858e-2b594f63b7bc" :knowledge-point/title "Calculating Distance Given Speed and Time"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ef48712-83ca-543d-a0c9-9799b7aeb83e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$234$ kilometers" :db/id #edb/ref 17592186266412} {:answer/id #uuid "413826d2-676d-570e-a054-a657fa0eb102" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$90$ kilometers" :db/id #edb/ref 17592186266732} {:answer/id #uuid "463bf5a9-6eee-591c-b895-870beb09c4dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$180$ kilometers" :db/id #edb/ref 17592186266770} {:answer/id #uuid "e90cb705-2ad8-55ce-899a-7e7cfc162757" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1.25$ kilometers" :db/id #edb/ref 17592186268214} {:answer/id #uuid "fabf48f8-bf7d-51f7-93dc-2b457ddab34f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2.5$ kilometers" :db/id #edb/ref 17592186268364}] :answer-field/correct {:answer/id #uuid "463bf5a9-6eee-591c-b895-870beb09c4dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$180$ kilometers" :db/id #edb/ref 17592186266770} :answer-field/id #uuid "acd1cc16-ec8f-5475-977d-083061ae322e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268717}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "51d90e7f-b1f8-520b-8eca-6b795a2f6717" :question/math-academy-id "q-134176" :question/problem "A spacecraft traveled for $15$ seconds at a constant speed of $12$ kilometers per second. Find the distance covered by the spacecraft." :question/worked-solution "The speed is $12$ kilometers per second. To find the distance covered in $15$ seconds, we multiply the speed by $15.$ This gives\n\n$$\n\\begin{aligned}\\text{distance} & =\\text{speed}\\cdot \\text{time} \\\\  & =12\\times 15 \\\\  & =180.\\end{aligned}\n$$\n\nTherefore, the spacecraft covered $180$ kilometers in $15$ seconds."}] [{:db/id #edb/ref 17592186268990 :knowledge-point/_questions [{:db/id #edb/ref 17592186176032 :knowledge-point/id #uuid "6570253a-b05a-5721-9108-5fddab2b5388" :knowledge-point/title "Calculating Time Given Distance and Speed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cab5046-233a-5880-a03b-503b0856d91c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6.5$ minutes" :db/id #edb/ref 17592186266680} {:answer/id #uuid "e325a324-10a4-5f82-b231-fa3bd706ffd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7.5$ minutes" :db/id #edb/ref 17592186268151} {:answer/id #uuid "e83770ff-718f-52f9-990d-ade35dfa8b0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ minutes" :db/id #edb/ref 17592186268205} {:answer/id #uuid "e91f6d7c-f724-5d0a-abea-83d4d6399631" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ minutes" :db/id #edb/ref 17592186268215} {:answer/id #uuid "ef6e5bd5-073f-5a36-96f8-f3263a6b14de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ minutes" :db/id #edb/ref 17592186268273}] :answer-field/correct {:answer/id #uuid "e83770ff-718f-52f9-990d-ade35dfa8b0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ minutes" :db/id #edb/ref 17592186268205} :answer-field/id #uuid "51bb6fb1-a3cf-54cb-9a80-1e8569ed6784" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268553}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "27bf74aa-5d79-5da2-ae74-80f3b8309260" :question/math-academy-id "q-134220" :question/problem "A jet ski traveled $3\\,960$ meters at a constant speed of $660$ meters per minute. For how long was the jet ski in motion?" :question/worked-solution "The speed is $660$ meters per minute. To find the time it took the jet ski to cover $3\\,960$ meters, we divide the distance by $660.$ This gives\n\n$$\n\\begin{aligned}\\text{time} & =\\frac{\\text{distance}}{\\text{speed}} \\\\  & =\\frac{3\\,960}{660} \\\\  & =\\frac{3\\,960÷60}{660÷60} \\\\  & =\\frac{66}{11} \\\\  & =66÷11 \\\\  & =6.\\end{aligned}\n$$\n\nTherefore, the jet ski was in motion for $6$ minutes."}]}
