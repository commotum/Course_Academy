,0)\">\n<rect stroke=\"none\" width=\"620\" height=\"60\" x=\"0\" y=\"220\"></rect>\n <use xlink:href=\"#E3-MJMAIN-32\" x=\"60\" y=\"676\"></use>\n <use xlink:href=\"#E3-MJMAIN-33\" x=\"60\" y=\"-686\"></use>\n</g>\n</g>\n<g transform=\"translate(4834,0)\">\n<g fill=\"red\" stroke=\"red\">\n<g fill=\"red\" stroke=\"red\">\n<g fill=\"red\" stroke=\"red\">\n <use xlink:href=\"#E3-MJMAIN-D7\"></use>\n</g>\n</g>\n</g>\n</g>\n<g transform=\"translate(5779,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"620\" height=\"60\" x=\"0\" y=\"220\"></rect>\n <use xlink:href=\"#E3-MJMAIN-31\" x=\"60\" y=\"676\"></use>\n<g fill=\"blue\" stroke=\"blue\" transform=\"translate(60,-697)\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n <use xlink:href=\"#E3-MJMAIN-37\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E3-MJMAIN-2E\" x=\"6639\" y=\"0\"></use>\n</g>\n</svg></span> </p>\n<p>Now, we multiply fractions. We multiply the numerators, and we multiply the denominators:</p>\n<p><span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"22.197ex\" height=\"5.343ex\" style=\"vertical-align: -2.005ex;\" viewBox=\"0 -1437.2 9557 2300.3\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-4-Title\">\n<title id=\"MathJax-SVG-4-Title\">  \\dfrac 2 3 \\times \\dfrac{1}{7} = \\dfrac {2\\times 1} {3\\times 7} = \\dfrac{2}{21}  </title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E4-MJMAIN-32\" d=\"M109 429Q82 429 66 447T50 491Q50 562 103 614T235 666Q326 666 387 610T449 465Q449 422 429 383T381 315T301 241Q265 210 201 149L142 93L218 92Q375 92 385 97Q392 99 409 186V189H449V186Q448 183 436 95T421 3V0H50V19V31Q50 38 56 46T86 81Q115 113 136 137Q145 147 170 174T204 211T233 244T261 278T284 308T305 340T320 369T333 401T340 431T343 464Q343 527 309 573T212 619Q179 619 154 602T119 569T109 550Q109 549 114 549Q132 549 151 535T170 489Q170 464 154 44