#{[{:db/id #edb/ref 17592186142644 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142747 :knowledge-point/id #uuid "9941f7e5-aee1-5b0b-8f6e-f9f6a91a0c72" :knowledge-point/title "Dividing a Unit Fraction by a Whole Number"}] :question/id #uuid "a2af42e6-fa21-5419-bc0b-dbcec4e73c5d" :question/math-academy-id "e-14518" :question/problem "What is the value of $\\dfrac 1 6 \\div 5 ?$" :question/worked-solution "Dividing a fraction by a whole number is equivalent to multiplying the fraction by the reciprocal of that whole number.\n\nThe reciprocal of $\\color{blue}5$ is $\\dfrac{1}{{\\color{blue}{5}}}.$ So, we have\n\n$$\n\\dfrac 1 6\\, {\\color{red}\\div} \\, {\\color{blue}5} = \\dfrac 1 6\\, {\\color{red}\\times} \\,\\dfrac{1}{\\color{blue}5}.\n$$\n\n \n\nNow, we multiply the fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac 1 6 \\times \\dfrac{1}{5} = \\dfrac {1\\times 1} {6\\times 5} = \\dfrac{1}{30}\n$$"}] [{:db/id #edb/ref 17592186142645 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142748 :knowledge-point/id #uuid "cf2557f5-25cc-581f-99c5-5adf9419b963" :knowledge-point/title "Dividing a Fraction by a Whole Number"}] :question/id #uuid "42c81ef5-519f-5d53-9719-92cee05c8e87" :question/math-academy-id "e-14519" :question/problem "What is the values of $\\dfrac 2 3 \\div 7 ?$" :question/worked-solution "Dividing a fraction by a whole number is equivalent to multiplying the fraction by the reciprocal of that whole number.\n\nThe reciprocal of $\\color{blue}7$ is $\\dfrac{1}{{\\color{blue}{7}}}.$ So, we have\n\n$$\n\\dfrac 2 3\\, {\\color{red}\\div} \\, {\\color{blue}7} = \\dfrac 2 3\\, {\\color{red}\\times} \\,\\dfrac{1}{\\color{blue}7} .\n$$\n\n \n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac 2 3 \\times \\dfrac{1}{7} = \\dfrac {2\\times 1} {3\\times 7} = \\dfrac{2}{21}\n$$"}] [{:db/id #edb/ref 17592186142646 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142749 :knowledge-point/id #uuid "8a992d8d-1a80-56bd-80f4-650d3a1bbc53" :knowledge-point/title "Cases Where Simplification Is Required"}] :question/id #uuid "3f350570-ed4d-5f5b-8435-9f8c2af5b0fb" :question/math-academy-id "e-14521" :question/problem "Find the value of $\\dfrac{6}{11} \\div 3 .$" :question/worked-solution "Dividing a fraction by a whole number is equivalent to multiplying the fraction by the reciprocal of that whole number.\n\nThe reciprocal of $\\color{blue}3$ is $\\dfrac{1}{{\\color{blue}{3}}}.$ So, we have\n\n$$\n\\dfrac {6}{11} \\, {\\color{red}\\div} \\, {\\color{blue}3} =  \\dfrac {6}{11}\\, {\\color{red}\\times} \\,\\dfrac{1}{\\color{blue}3}.\n$$\n\n \n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac {6}{11} \\times \\dfrac{1}{3} = \\dfrac {6\\times 1} {11\\times 3} = \\dfrac{6}{33}\n$$\n\nFinally, we simplify our result by dividing the numerator and denominator by $3\\mathbin{:}$\n\n$$\n\\dfrac{6}{33} = \\dfrac{6\\div 3}{33\\div 3} = \\dfrac{2}{11}\n$$"}] [{:db/id #edb/ref 17592186440568 :knowledge-point/_questions [{:db/id #edb/ref 17592186142747 :knowledge-point/id #uuid "9941f7e5-aee1-5b0b-8f6e-f9f6a91a0c72" :knowledge-point/title "Dividing a Unit Fraction by a Whole Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25676b11-fdef-5ee1-9bf0-facedf030626" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186440500} {:answer/id #uuid "4832ae7c-fd56-5f77-ab99-273462f5bc3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186440503} {:answer/id #uuid "654cd363-fe1d-5cc7-9810-2b0b16743af2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{3}" :db/id #edb/ref 17592186440509} {:answer/id #uuid "a34241c7-6b8a-525f-b4b2-5d18061404ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186440522} {:answer/id #uuid "a710982e-40ea-5e36-aa19-f2624f9e30f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{32}" :db/id #edb/ref 17592186440524}] :answer-field/correct {:answer/id #uuid "a710982e-40ea-5e36-aa19-f2624f9e30f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{32}" :db/id #edb/ref 17592186440524} :answer-field/id #uuid "f1720535-35ab-5500-8736-1885634c1833" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186440554}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f9b7769c-50a8-5c21-9b7b-d88c90ff5615" :question/math-academy-id "q-100145" :question/problem "$\\frac{1}{4}÷8=$" :question/worked-solution "Dividing a fraction by a whole number is equivalent to multiplying the fraction by the reciprocal of that whole number.\n\nThe reciprocal of $8$ is $\\frac{1}{8}.$ So, we have\n\n$$\n\\frac{1}{4}\\,÷\\,8=\\frac{1}{4}\\,\\times \\,\\frac{1}{8}.\n$$\n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{1}{4}\\times \\frac{1}{8}=\\frac{1\\times 1}{4\\times 8}=\\frac{1}{32}\n$$"}] [{:db/id #edb/ref 17592186440563 :knowledge-point/_questions [{:db/id #edb/ref 17592186142749 :knowledge-point/id #uuid "8a992d8d-1a80-56bd-80f4-650d3a1bbc53" :knowledge-point/title "Cases Where Simplification Is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "073c542b-9eda-5068-9401-3e870bb9dcf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{27}" :db/id #edb/ref 17592186440494} {:answer/id #uuid "5a9cb3d1-d539-526e-8f8e-7ca242eb8b7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident