ield/id #uuid "a2003963-bbfd-5e73-904c-9cf5199d5567" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186440550}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4d44aca2-82e0-5f20-ace0-bbb17307dbfa" :question/math-academy-id "q-57237" :question/problem "$\\frac{6}{7}÷2=$" :question/worked-solution "Dividing a fraction by a whole number is equivalent to multiplying the fraction by the reciprocal of that whole number.\n\nThe reciprocal of $2$ is $\\frac{1}{2}.$ So, we have\n\n$$\n\\frac{6}{7}\\,÷\\,2=\\frac{6}{7}\\,\\times \\,\\frac{1}{2}.\n$$\n\n \n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{6}{7}\\times \\frac{1}{2}=\\frac{6\\times 1}{7\\times 2}=\\frac{6}{14}\n$$\n\nFinally, we simplify our result by dividing the numerator and denominator by $2:$\n\n$$\n\\frac{6}{14}=\\frac{6÷2}{14÷2}=\\frac{3}{7}\n$$"}] [{:db/id #edb/ref 17592186440566 :knowledge-point/_questions [{:db/id #edb/ref 17592186142749 :knowledge-point/id #uuid "8a992d8d-1a80-56bd-80f4-650d3a1bbc53" :knowledge-point/title "Cases Where Simplification Is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02a4db1b-a071-5a60-bdd4-827e9f369f61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{32}{11}" :db/id #edb/ref 17592186440492} {:answer/id #uuid "b4b664e6-72d3-5d77-a2ff-373bafdd15a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{11}" :db/id #edb/ref 17592186440527} {:answer/id #uuid "d88ad4a5-0081-524c-b96d-97cd07b58f97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{11}" :db/id #edb/ref 17592186440531} {:answer/id #uuid "f5929577-fd72-5a34-9503-a6e03136e545" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{22}" :db/id #edb/ref 17592186440537} {:answer/id #uuid "fa004bb3-29fa-522d-b7a5-8c70be828f2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{22}" :db/id #edb/ref 17592186440538}] :answer-field/correct {:answer/id #uuid "d88ad4a5-0081-524c-b96d-97cd07b58f97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{11}" :db/id #edb/ref 17592186440531} :answer-field/id #uuid "3bcbd7f2-df99-58a1-9584-c57b41d226a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186440543}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c1a99f57-fa06-5739-b60a-94b0deccc6fc" :question/math-academy-id "q-57242" :question/problem "$\\frac{8}{11}÷4=$" :question/worked-solution "Dividing a fraction by a whole number is equivalent to multiplying the fraction by the reciprocal of that whole number.\n\nThe reciprocal of $4$ is $\\frac{1}{4}.$ So, we have\n\n$$\n\\frac{8}{11}\\,÷\\,4=\\frac{8}{11}\\,\\times \\,\\frac{1}{4}.\n$$\n\n \n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{8}{11}\\times \\frac{1}{4}=\\frac{8\\times 1}{11\\times 4}=\\frac{8}{44}\n$$\n\nFinally, we simplify our result by dividing the numerator and denominator by $4:$\n\n$$\n\\frac{8}{44}=\\frac{8÷4}{44÷4}=\\frac{2}{11}\n$$"}]}
