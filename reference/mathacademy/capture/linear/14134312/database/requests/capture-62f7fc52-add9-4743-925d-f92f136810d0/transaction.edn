tion/id #uuid "96170013-5e0f-501d-81cf-eceefbf4bc14" :question/math-academy-id "q-211038" :question/problem "Expressed as a fraction in its lowest terms, $\\frac{1}{2}÷10=${{field-1}}." :question/worked-solution "Dividing a fraction by a whole number is equivalent to multiplying the fraction by the reciprocal of that whole number.\n\nThe reciprocal of $10$ is $\\frac{1}{10}.$ So, we have\n\n$$\n\\frac{1}{2}\\,÷\\,10=\\frac{1}{2}\\,\\times \\,\\frac{1}{10}.\n$$\n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{1}{2}\\times \\frac{1}{10}=\\frac{1\\times 1}{2\\times 10}=\\frac{1}{20}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e2c2ea80-81d9-5bd0-81eb-bc860b3482ce"] :db/ensure [:question/validate]} {:db/id "answer-field-e2c2ea80-81d9-5bd0-81eb-bc860b3482ce" :answer-field/id #uuid "e2c2ea80-81d9-5bd0-81eb-bc860b3482ce" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8ac9d678-8917-50dd-a9bd-9f7490c0346c" :answer-field/choices ["answer-8ac9d678-8917-50dd-a9bd-9f7490c0346c"] :db/ensure [:answer-field/validate]} {:db/id "answer-8ac9d678-8917-50dd-a9bd-9f7490c0346c" :answer/id #uuid "8ac9d678-8917-50dd-a9bd-9f7490c0346c" :answer/type :answer.type/math :answer/value "\\frac{1}{20}" :db/ensure [:answer/validate]} {:db/id 17592186143312 :question/problem "$\\frac{1}{7}÷3=$" :question/worked-solution "Dividing a fraction by a whole number is equivalent to multiplying the fraction by the reciprocal of that whole number.\n\nThe reciprocal of $3$ is $\\frac{1}{3}.$ So, we have\n\n$$\n\\frac{1}{7}\\,÷\\,3=\\frac{1}{7}\\,\\times \\,\\frac{1}{3}.\n$$\n\n \n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{1}{7}\\times \\frac{1}{3}=\\frac{1\\times 1}{7\\times 3}=\\frac{1}{21}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592