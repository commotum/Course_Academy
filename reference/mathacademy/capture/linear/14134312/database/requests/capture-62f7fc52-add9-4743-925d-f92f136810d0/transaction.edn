r-fields ["answer-field-4e46b766-826d-5fce-987c-5548bfadaabe"] :db/ensure [:question/validate]} {:db/id "answer-field-4e46b766-826d-5fce-987c-5548bfadaabe" :answer-field/id #uuid "4e46b766-826d-5fce-987c-5548bfadaabe" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-38b9729a-82e8-5d19-b63b-e8556f73778d" :answer-field/choices ["answer-38b9729a-82e8-5d19-b63b-e8556f73778d"] :db/ensure [:answer-field/validate]} {:db/id "answer-38b9729a-82e8-5d19-b63b-e8556f73778d" :answer/id #uuid "38b9729a-82e8-5d19-b63b-e8556f73778d" :answer/type :answer.type/math :answer/value "\\frac{1}{10}" :db/ensure [:answer/validate]} {:db/id "question-4d44aca2-82e0-5f20-ace0-bbb17307dbfa" :question/id #uuid "4d44aca2-82e0-5f20-ace0-bbb17307dbfa" :question/math-academy-id "q-57237" :question/problem "$\\frac{6}{7}÷2=$" :question/worked-solution "Dividing a fraction by a whole number is equivalent to multiplying the fraction by the reciprocal of that whole number.\n\nThe reciprocal of $2$ is $\\frac{1}{2}.$ So, we have\n\n$$\n\\frac{6}{7}\\,÷\\,2=\\frac{6}{7}\\,\\times \\,\\frac{1}{2}.\n$$\n\n \n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{6}{7}\\times \\frac{1}{2}=\\frac{6\\times 1}{7\\times 2}=\\frac{6}{14}\n$$\n\nFinally, we simplify our result by dividing the numerator and denominator by $2:$\n\n$$\n\\frac{6}{14}=\\frac{6÷2}{14÷2}=\\frac{3}{7}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a2003963-bbfd-5e73-904c-9cf5199d5567"] :db/ensure [:question/validate]} {:db/id "answer-field-a2003963-bbfd-5e73-904c-9cf5199d5567" :answer-field/id #uuid "a2003963-bbfd-5e73-904c-9cf5199d5567" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c43c5ae5-7227-55a1-8aa1-ae168334431f" :answer-field/choices ["answer-fdaef089-ef35-5799-91a3-5bd86f4779a8" "answer-acf0f1f7-d9d8-58f5-9415-4f478cf6d3e8" "answer-c43c5ae5-7227-55a1-8aa1-ae168334431f" "answer-ee906a8a-a89b-5c82-9251-e0c8707fd7de" "answer-cd1b55c6-a9a7-51e8-a2aa-24323c744494"] :db/ensure [:answer-field/validate]} {:db/id "answer-fdaef089-ef35-5799-91a3-5bd86f4779a8" :answer/id #uuid "fdaef089-ef35-5799-91a3-5bd86f4779a8" :answer/type :answer.type/math :answer/value "\\frac{12}{7}" :db/ensure [:answer/validate]} {:db/id "answer-acf0f1f7-d9d8-58f5-9415-4f478cf6d3e8" :answer/id #uuid "acf0f1f7-d9d8-58f5-9415-4f478cf6d3e8" :answer/type :answer.type/math :answer/value "\\frac{2}{7}" :db/ensure [:answer/validate]} {:db/id "answer-c43c5ae5-7227-55a1-8aa1-ae168334431f" :answer/id #uuid "c43c5ae5-7227-55a1-8aa1-ae168334431f" :answer/type :answer.type/math :answer/value "\\frac{3}{7}" :db/ensure [:answer/validate]} {:db/id "answer-ee906a8a-a89b-5c82-9251-e0c8707fd7de" :answer/id #uuid "ee906a8a-a89b-5c82-9251-e0c8707fd7de" :answer/type :answer.type/math :answer/value "\\frac{4}{7}" :db/ensure [:answer/validate]} {:db/id "answer-cd1b55c6-a9a7-51e8-a2aa-24323c744494" :answer/id #uuid "cd1b55c6-a9a7-51e8-a2aa-24323c744494" :answer/type :answer.type/math :answer/value "\\frac{8}{7}" :db/ensure [:answer/validate]} {:db/id 17592186144094 :tutorial/content "To divide a fraction by a whole number, we multiply the fraction by the whole number's reciprocal.\n\nLet's use this rule to solve the following division problem:\n\n$$\n\\dfrac14 \\div {\\color{blue}{3}}\n$$\n\nThe reciprocal of $\\color{blue}3$ is $\\dfrac{1}{{\\color{blue}{3}}}.$ So, we have\n\n$$\n\\dfrac 1 4\\, {\\color{red}\\div} \\, {\\color{blue}3} = \\dfrac 1 4\\, {\\color{red}\\times} \\,\\dfrac{1}{\\color{blue}3}.\n$$\n\n \n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac 1 4 \\times \\dfrac{1}{3} = \\dfrac {1\\times 1} {4\\times 3} = \\dfrac{1}{12}\n$$\n\nTherefore, we conclude that\n\n$$\n\\dfrac14 \\div 3 = \\dfrac{1}{12}.\n$$\n\nWe get the same result by using a fraction model:\n\n![](images/79/7991699ec1878bf1de6e52ca48807a78605832b29418f90f87e9923a42796eba.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186143005 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
