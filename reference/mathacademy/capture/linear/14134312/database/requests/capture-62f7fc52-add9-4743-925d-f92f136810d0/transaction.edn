1}{20}" :db/ensure [:answer/validate]} {:db/id "question-c1a99f57-fa06-5739-b60a-94b0deccc6fc" :question/id #uuid "c1a99f57-fa06-5739-b60a-94b0deccc6fc" :question/math-academy-id "q-57242" :question/problem "$\\frac{8}{11}÷4=$" :question/worked-solution "Dividing a fraction by a whole number is equivalent to multiplying the fraction by the reciprocal of that whole number.\n\nThe reciprocal of $4$ is $\\frac{1}{4}.$ So, we have\n\n$$\n\\frac{8}{11}\\,÷\\,4=\\frac{8}{11}\\,\\times \\,\\frac{1}{4}.\n$$\n\n \n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{8}{11}\\times \\frac{1}{4}=\\frac{8\\times 1}{11\\times 4}=\\frac{8}{44}\n$$\n\nFinally, we simplify our result by dividing the numerator and denominator by $4:$\n\n$$\n\\frac{8}{44}=\\frac{8÷4}{44÷4}=\\frac{2}{11}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3bcbd7f2-df99-58a1-9584-c57b41d226a6"] :db/ensure [:question/validate]} {:db/id "answer-field-3bcbd7f2-df99-58a1-9584-c57b41d226a6" :answer-field/id #uuid "3bcbd7f2-df99-58a1-9584-c57b41d226a6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d88ad4a5-0081-524c-b96d-97cd07b58f97" :answer-field/choices ["answer-fa004bb3-29fa-522d-b7a5-8c70be828f2c" "answer-d88ad4a5-0081-524c-b96d-97cd07b58f97" "answer-02a4db1b-a071-5a60-bdd4-827e9f369f61" "answer-f5929577-fd72-5a34-9503-a6e03136e545" "answer-b4b664e6-72d3-5d77-a2ff-373bafdd15a5"] :db/ensure [:answer-field/validate]} {:db/id "answer-fa004bb3-29fa-522d-b7a5-8c70be828f2c" :answer/id #uuid "fa004bb3-29fa-522d-b7a5-8c70be828f2c" :answer/type :answer.type/math :answer/value "\\frac{15}{22}" :db/ensure [:answer/validate]} {:db/id "answer-d88ad4a5-0081-524c-b96d-97cd07b58f97" :answer/id #uuid "d88ad4a5-0081-524c-b96d-97cd07b58f97" :answer/type :answer.type/math :answer/value "\\frac{2}{11}" :db/ensure [:answer/validate]} {:db/id "answer-02a4db1b-a071-5a60-bdd4-8