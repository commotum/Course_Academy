#{[{:db/id #edb/ref 17592186142644 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142747 :knowledge-point/id #uuid "9941f7e5-aee1-5b0b-8f6e-f9f6a91a0c72" :knowledge-point/title "Dividing a Unit Fraction by a Whole Number"}] :question/id #uuid "a2af42e6-fa21-5419-bc0b-dbcec4e73c5d" :question/math-academy-id "e-14518" :question/problem "What is the value of $\\dfrac 1 6 \\div 5$?" :question/worked-solution "Dividing a fraction by a whole number is equivalent to multiplying the fraction by the reciprocal of that whole number.\n\nThe reciprocal of $\\color{blue}5$ is\n\n$$\n\\dfrac{1}{{\\color{blue}{5}}}\n$$\n\nSo, we have\n\n$$\n\\dfrac 1 6\\, {\\color{red}\\div} \\, {\\color{blue}5} = \\dfrac 1 6\\, {\\color{red}\\times} \\,\\dfrac{1}{\\color{blue}5}\n$$\n\nNow, we multiply the fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac 1 6 \\times \\dfrac{1}{5} = \\dfrac {1\\times 1} {6\\times 5} = \\dfrac{1}{30}\n$$"}] [{:db/id #edb/ref 17592186142645 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142748 :knowledge-point/id #uuid "cf2557f5-25cc-581f-99c5-5adf9419b963" :knowledge-point/title "Dividing a Fraction by a Whole Number"}] :question/id #uuid "42c81ef5-519f-5d53-9719-92cee05c8e87" :question/math-academy-id "e-14519" :question/problem "What is the values of $\\dfrac 2 3 \\div 7$?" :question/worked-solution "Dividing a fraction by a whole number is equivalent to multiplying the fraction by the reciprocal of that whole number.\n\nThe reciprocal of $\\color{blue}7$ is\n\n$$\n\\dfrac{1}{{\\color{blue}{7}}}\n$$\n\nSo, we have\n\n$$\n\\dfrac 2 3\\, {\\color{red}\\div} \\, {\\color{blue}7} = \\dfrac 2 3\\, {\\color{red}\\times} \\,\\dfrac{1}{\\color{blue}7}\n$$\n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac 2 3 \\times \\dfrac{1}{7} = \\dfrac {2\\times 1} {3\\times 7} = \\dfrac{2}{21}\n$$"}] [{:db/id #edb/ref 17592186142646 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142749 :knowledge-point/id #uuid "8a992d8d-1a80-56bd-80f4-650d3a1bbc53" :knowledge-point/title "Cases Where Simplification Is Required"}] :question/id #uuid "3f350570-ed4d-5f5b-8435-9f8c2af5b0fb" :question/math-academy-id "e-14521" :question/problem "Find the value of $\\dfrac{6}{11} \\div 3$." :question/worked-solution "Dividing a fraction by a whole number is equivalent to multiplying the fraction by the reciprocal of that whole number.\n\nThe reciprocal of $\\color{blue}3$ is\n\n$$\n\\dfrac{1}{{\\color{blue}{3}}}\n$$\n\nSo, we have\n\n$$\n\\dfrac {6}{11} \\, {\\color{red}\\div} \\, {\\color{blue}3} = \\dfrac {6}{11}\\, {\\color{red}\\times} \\,\\dfrac{1}{\\color{blue}3}\n$$\n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac {6}{11} \\times \\dfrac{1}{3} = \\dfrac {6\\times 1} {11\\times 3} = \\dfrac{6}{33}\n$$\n\nFinally, we simplify our result by dividing the numerator and denominator by $3$:\n\n$$\n\\dfrac{6}{33} = \\dfrac{6\\div 3}{33\\div 3} = \\dfrac{2}{11}\n$$"}] [{:db/id #edb/ref 17592186143312 :knowledge-point/_questions [{:db/id #edb/ref 17592186142747 :knowledge-point/id #uuid "9941f7e5-aee1-5b0b-8f6e-f9f6a91a0c72" :knowledge-point/title "Dividing a Unit Fraction by a Whole Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ca14f4ae-6eaa-5340-94b1-b10647f92c9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186140842} {:answer/id #uuid "fda272fb-702e-57be-b0c7-8d41fb3c2f05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{21}" :db/id #edb/ref 17592186140843} {:answer/id #uuid "ffeca3a5-a654-5b97-a0b7-c8f88dc5fdb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{21}" :db/id #edb/ref 17592186140844} {:answer/id #uuid "27a858d2-a2dc-5ad1-bfef-8d4d699b42af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{7}" :db/id #edb/ref 17592186140845} {:answer/id #uuid "56e0086b-5e8a-5855-b3c7-b948d15c66ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186140846}] :answer-field/id #uuid "a53558fb-692f-5e57-a28c-8811056dfc86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186140841}] :question/id #uuid "c04b229d-4a22-5434-a2a2-872524226464" :question/math-academy-id "q-57166" :question/problem "What is $\\frac{1}{7} \\div 3$?"}]}
