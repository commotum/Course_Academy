#{[{:activity/first-step {:db/id #edb/ref 17592186143595} :activity/id #uuid "680785ff-cc7a-5852-9be8-17e2b7fa8128" :activity/scope {:db/id #edb/ref 17592186049046 :topic/id #uuid "d5a7f682-950d-524d-b46a-babe4ebe7463" :topic/math-academy-id 2369} :activity/steps [{:db/id #edb/ref 17592186143595 :step/content {:db/id #edb/ref 17592186144094 :tutorial/content "To divide a fraction by a whole number, we multiply the fraction by the whole number's reciprocal.\n\nLet's use this rule to solve the following division problem:\n\n$$\n\\dfrac14 \\div {\\color{blue}{3}}\n$$\n\nThe reciprocal of $\\color{blue}3$ is\n\n$$\n\\dfrac{1}{{\\color{blue}{3}}}\n$$\n\nSo, we have\n\n$$\n\\dfrac 1 4\\, {\\color{red}\\div} \\, {\\color{blue}3} = \\dfrac 1 4\\, {\\color{red}\\times} \\,\\dfrac{1}{\\color{blue}3}\n$$\n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac 1 4 \\times \\dfrac{1}{3} = \\dfrac {1\\times 1} {4\\times 3} = \\dfrac{1}{12}\n$$\n\nTherefore, we conclude that\n\n$$\n\\dfrac14 \\div 3 = \\dfrac{1}{12}\n$$\n\nWe get the same result by using a fraction model:\n\n![](images/79/7991699ec1878bf1de6e52ca48807a78605832b29418f90f87e9923a42796eba.png)" :tutorial/id #uuid "746860e0-e435-58d1-8080-bcb3846ccb7a" :tutorial/math-academy-id 8977 :tutorial/title "Introduction"} :step/id #uuid "1b82e184-a67c-5b55-8a51-d895dbb505de" :step/math-academy-id 113044 :step/next {:db/id #edb/ref 17592186143596}} {:db/id #edb/ref 17592186143596 :step/content {:db/id #edb/ref 17592186142747 :knowledge-point/canonical-example {:db/id #edb/ref 17592186142644 :question/id #uuid "a2af42e6-fa21-5419-bc0b-dbcec4e73c5d" :question/math-academy-id "e-14518"} :knowledge-point/id #uuid "9941f7e5-aee1-5b0b-8f6e-f9f6a91a0c72" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049253} {:db/id #edb/ref 17592186049415}] :knowledge-point/questions [{:db/id #edb/ref 17592186143072} {:db/id #edb/ref 17592186143312}] :knowledge-point/title "Dividing a Unit Fraction by a Whole Number"} :step/id #uuid "4fa9b979-d892-57ba-924f-8f61f7ee2c05" :step/math-academy-id 113045 :step/next {:db/id #edb/ref 17592186143597}} {:db/id #edb/ref 17592186143597 :step/content {:db/id #edb/ref 17592186142748 :knowledge-point/canonical-example {:db/id #edb/ref 17592186142645 :question/id #uuid "42c81ef5-519f-5d53-9719-92cee05c8e87" :question/math-academy-id "e-14519"} :knowledge-point/id #uuid "cf2557f5-25cc-581f-99c5-5adf9419b963" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049347}] :knowledge-point/questions [{:db/id #edb/ref 17592186143320} {:db/id #edb/ref 17592186143321}] :knowledge-point/title "Dividing a Fraction by a Whole Number"} :step/id #uuid "58a9d8fd-18fb-54f2-a971-bac0866c5e00" :step/math-academy-id 113048 :step/next {:db/id #edb/ref 17592186143598}} {:db/id #edb/ref 17592186143598 :step/content {:db/id #edb/ref 17592186142749 :knowledge-point/canonical-example {:db/id #edb/ref 17592186142646 :question/id #uuid "3f350570-ed4d-5f5b-8435-9f8c2af5b0fb" :question/math-academy-id "e-14521"} :knowledge-point/id #uuid "8a992d8d-1a80-56bd-80f4-650d3a1bbc53" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049733}] :knowledge-point/questions [{:db/id #edb/ref 17592186143313} {:db/id #edb/ref 17592186143322}] :knowledge-point/title "Cases Where Simplification Is Required"} :step/id #uuid "4b15cf67-3820-5a0c-952d-1630b3f8c396" :step/math-academy-id 113051}] :activity/title "Dividing Fractions by Whole Numbers" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186143005}]}
