>1</mn><mn>10</mn></mfrac></mstyle><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>1</mn><mo>×</mo><mn>1</mn></mrow><mrow><mn>2</mn><mo>×</mo><mn>10</mn></mrow></mfrac></mstyle><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>20</mn></mfrac></mstyle></mpadded></mstyle></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
