 "4f0a9915-e3e4-5878-9583-e0f6d2d4f1b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186149266}] :answer-field/id #uuid "9a662b4c-b382-5657-803d-f717f4dec77d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186149261}] :question/id #uuid "b1189e0d-f1d2-59f2-9035-c87ca64ef4f1" :question/math-academy-id "q-172313" :question/problem "$n^{2} + 2n - 3 = 0$\n\nWhich of the following conditions are sufficient for the above to be true?\n\n1. $n = 1$\n2. $n < 0$\n3. $\\mid n \\mid < 5$"}]}
