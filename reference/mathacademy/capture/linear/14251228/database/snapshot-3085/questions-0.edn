eld/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186489107}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "49c672a2-d467-5f34-bcf7-e5d722eb09ca" :question/math-academy-id "q-235999" :question/problem "![](images/ac/acf26785a0591659fb6c2d9ef906614f8c282a31fcf6e06d1718477c4c6aba38.png)\n\nWhat is the range of the function $f(x),$ shown above?\n\nThe range is \n{{field-1}}\n$<f(x)$\n{{field-2}}{{field-3}}." :question/worked-solution "First, we find the smallest and largest $y$-values in the graph.\n\n- The smallest $y$-value is $-1.$ This occurs when $x\\to \\infty .$ However, note that this point is not included in the graph.\n\n- The largest $y$-value is $3.$ This occurs when $x\\to -\\infty .$ However, note that this point is not included in the graph.\n\nThe function covers all the $y$-values between $-1$ and $3,$ not including $-1$ and $3.$\n\nTherefore, the range is $-1<y<3,$ which can also be written as $-1<f(x)<3.$"}] [{:db/id #edb/ref 17592186115865 :knowledge-point/_questions [{:db/id #edb/ref 17592186115384 :knowledge-point/id #uuid "cd0f5949-6a1a-5187-a246-8f9bac2e8d58" :knowledge-point/title "Interpreting a Decay Rate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea7ced4d-d092-5e8a-8bb7-9d8a84776b0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The car's market value increases by $90%$ every year." :db/id #edb/ref 17592186114128} {:answer/id #uuid "fcb1b099-cdaa-53a1-930d-d02676568096" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The car loses $90%$ of its market value every year." :db/id #edb/ref 17592186114129} {:answer/id #uuid "18875869-1bce-592e-aeee-7828c83cae3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The car's market value increases by $10%$ every yea