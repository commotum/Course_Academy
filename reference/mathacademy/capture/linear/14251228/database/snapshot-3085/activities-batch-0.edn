#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186180522} :activity/id #uuid "847ae41b-99e9-5c25-94db-a091578bf000" :activity/scope {:db/id #edb/ref 17592186048138 :topic/id #uuid "8277b645-964a-5702-acc5-193fe49612d2" :topic/math-academy-id 3756} :activity/steps [{:db/id #edb/ref 17592186180522 :step/content {:db/id #edb/ref 17592186180739 :tutorial/content "When dealing with sums or differences of square roots, we can combine any terms with the same algebraic expression under the square root symbol $\\sqrt{\\phantom 0}.$ This is similar to collecting like terms in a linear expression.\n\nFor example, consider the following expression:\n\n$$\n5\\sqrt{x} - 3\\sqrt{x}\n$$\n\nWe can simplify our expression by combining the two radicals, as follows:\n\n$$\n\\begin{aligned}5\\sqrt{x}-3\\sqrt{x} & = \\\\ (5-3)\\sqrt{x} & = \\\\ 2\\sqrt{x} & \\end{aligned}\n$$\n\nWe *cannot* combine terms when the expressions under the radical are different. For example, the expression\n\n$$\n5\\sqrt{x} - 3\\sqrt{y}\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt x$ and $\\sqrt y.$" :tutorial/id #uuid "deda60a8-4b35-50ac-a71c-d3f884aa8e1d" :tutorial/math-academy-id 5971 :tutorial/title "Introduction"} :step/id #uuid "9e6999c1-79fe-5006-91df-3c25468791e3" :step/math-academy-id 36452 :step/next {:db/id #edb/ref 17592186180549}} {:db/id #edb/ref 17592186180523 :step/content {:db/id #edb/ref 17592186179751 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179619 :question/id #uuid "213ad0ee-813b-5a4b-8926-5fbd1aed4906" :question/math-academy-id "e-9723"} :knowledge-point/id #uuid "79a1c2e0-4183-58c6-ac88-0a4856b751a2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048170}] :knowledge-point/questions [{:db/id #edb/ref 17592186180162} {:db/id #edb/ref 17592186180179} {:db/id #edb/ref 17592186501140} {:db/id #edb/ref 17592186501154} {:db/id #edb/ref 17592186501180} {:db/id #edb/ref 17592186501203} {:db/id #edb/ref 17592186502098} {:db/id #edb/ref 17592186502138} {:db/id #edb/ref 17592186563736}] :knowledge-point/title "Simplifying Sums of Radicals with Cube Roots"} :step/id #uuid "145c40ab-6bce-539c-acfa-6819834eff82" :step/math-academy-id 36453} {:db/id #edb/ref 17592186180536 :step/content {:db/id #edb/ref 17592186180749 :tutorial/content "Recall that the product rule for radicals states that\n\n$$\n\\sqrt{a\\cdot b} = \\sqrt{a}\\cdot \\sqrt{b}\n$$\n\nwhere $a$ and $b$ are nonnegative.\n\nWe can use the product rule for radicals to simplify some expressions. Let's see an example." :tutorial/id #uuid "30549c94-702e-5e00-8cdc-4a050a34243f" :tutorial/math-academy-id 6012 :tutorial/title "The Product Rule for Radicals"} :step/id #uuid "e61e6895-553c-5528-9f47-4ce31a87b2fc" :step/math-academy-id 36694 :step/next {:db/id #edb/ref 17592186180550}} {:db/id #edb/ref 17592186180537 :step/content {:db/id #edb/ref 17592186180750 :tutorial/content "We can simplify cube root expressions in the same way as with square roots.\n\nFor example, consider the following expression:\n\n$$\n4\\sqrt[3]x - 2\\sqrt[3] x\n$$\n\nWe can simplify our expression by combining the two radicals, as follows:\n\n$$\n\\begin{aligned}4\\sqrt[3]{x}-2\\sqrt[3]{x} & = \\\\ (4-2)\\sqrt[3]{x} & = \\\\ 2\\sqrt[3]{x} & \\end{aligned}\n$$\n\n \n\nAs with square roots, we *cannot* combine terms when the expressions under the radical are different. For example, the expression\n\n$$\n\\sqrt[3]{x-1} + \\sqrt[3]{x+1}\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt[3]{x-1}$ and $\\sqrt[3]{x+1}.$\n\nFinally, it is not possible to combine square root and cube root terms, even if the numbers under the radical symbol are the same! For example, the expression\n\n$$\n2\\sqrt x + \\sqrt[3] x\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt x$ and $\\sqrt[3] x.$" :tutorial/id #uuid "a4a25921-e2bd-5bf7-99ed-3a8dd852fb70" :tutorial/math-academy-id 6013 :tutorial/title "Simplifying Expressions with Cube Roots"} :step/id #uuid "9ed96a02-bacb-559e-9bf4-ebf7f568ed2f" :step/math-academy-id 36695 :step/next {:db/id #edb/ref 17592186180523}} {:db/id #edb/ref 17592186180549 :step/content {:db/id #edb/ref 17592186179763 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179463 :question/id #uuid "13f8fdac-32c2-5f2a-a818-cde14e59299e" :question/math-academy-id "e-1373"} :knowledge-point/id #uuid "477301de-0888-5f46-84cc-5b2939516e7b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050341} {:db/id #edb/ref 17592186050452}] :knowledge-point/questions [{:db/id #edb/ref 17592186180214} {:db/id #edb/ref 17592186180215} {:db/id #edb/ref 17592186501137} {:db/id #edb/ref 17592186501209} {:db/id #edb/ref 17592186502097} {:db/id #edb/ref 17592186502146}] :knowledge-point/title "Simplifying Expressions Containing Radicals"} :step/id #uuid "402d2fd6-c005-5674-be33-360f1b1762d7" :step/math-academy-id 4334 :step/next {:db/id #edb/ref 17592186180536}} {:db/id #edb/ref 17592186180550 :step/content {:db/id #edb/ref 17592186179764 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179464 :question/id #uuid "eb35e7da-e6d0-5811-a2ee-92390f71c5f7" :question/math-academy-id "e-1374"} :knowledge-point/id #uuid "35580c97-b64e-55a3-b71e-9190dbcac10b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050496}] :knowledge-point/questions [{:db/id #edb/ref 17592186179916} {:db/id #edb/ref 17592186180180} {:db/id #edb/ref 17592186501220} {:db/id #edb/ref 17592186502101} {:db/id #edb/ref 17592186502133} {:db/id #edb/ref 17592186563718} {:db/id #edb/ref 17592186563723}] :knowledge-point/title "Simplifying Sums of Radicals Using the Product Rule"} :step/id #uuid "e9871c72-8aa0-5596-948e-55a61792f893" :step/math-academy-id 4336 :step/next {:db/id #edb/ref 17592186180537}}] :activity/title "Adding and Subtracting Radical Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179899}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186563790} :activity/id #uuid "5f674834-2a57-5e4c-9972-af563d469b92" :activity/scope {:db/id #edb/ref 17592186048138 :topic/id #uuid "8277b645-964a-5702-acc5-193fe49612d2" :topic/math-academy-id 3756} :activity/steps [{:db/id #edb/ref 17592186563786 :step/content {:db/id #edb/ref 17592186563736 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c2f4616-54cd-5516-be79-b77cd37a59b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6\\sqrt{y}" :db/id #edb/ref 17592186562964} {:answer/id #uuid "1aed403b-dbdf-50cf-b8cc-99506a344078" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\sqrt{y}-4\\sqrt[3]{y}" :db/id #edb/ref 17592186563005} {:answer/id #uuid "40bbda36-b2ef-5389-b981-78447392ad16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\sqrt{y}-2\\sqrt[3]{y}" :db/id #edb/ref 17592186563094} {:answer/id #uuid "784a2285-292b-5a35-aaf7-7340d809529b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{y}-4\\sqrt[3]{y}" :db/id #edb/ref 17592186563211} {:answer/id #uuid "89462c96-0fb9-5051-8f94-3c90423306ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{y}-5\\sqrt[3]{y}" :db/id #edb/ref 17592186563249}] :answer-field/correct {:db/id #edb/ref 17592186563005} :answer-field/id #uuid "a8669faa-71b0-532d-ba32-5f961f40b158" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563611}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ce532f1b-ce31-55ab-8ca6-180ef8818c5e" :question/math-academy-id "q-29319" :question/problem "Simplify $3\\sqrt[3]{y}-4\\sqrt{y}-7\\sqrt[3]{y}+2\\sqrt{y}.$" :question/worked-solution "We can combine the two $\\sqrt[3]{y}$ terms together, and the two $\\sqrt{y}$ terms together:\n\n$$\n\\begin{aligned}3\\sqrt[3]{y}-4\\sqrt{y}-7\\sqrt[3]{y}+2\\sqrt{y} & = \\\\ (-4+2)\\sqrt{y}+(3-7)\\sqrt[3]{y} & = \\\\ -2\\sqrt{y}-4\\sqrt[3]{y}\\end{aligned}\n$$\n\nNotice that we cannot combine the $\\sqrt[3]{y}$ and $\\sqrt{y}$ terms."} :step/id #uuid "749f734f-f9f3-581f-9e6b-58c70b1f490a" :step/next {:db/id #edb/ref 17592186563801}} {:db/id #edb/ref 17592186563790 :step/content {:db/id #edb/ref 17592186563718 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85b4904a-d133-59e2-89df-d49b787f7a62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt[3]{{x}^{2}}-{x}^{2}\\sqrt{x}" :db/id #edb/ref 17592186563245} {:answer/id #uuid "9026f5ff-791a-5770-911f-0b0b83b85fb1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[3]{{x}^{2}}-3x\\sqrt{x}" :db/id #edb/ref 17592186563268} {:answer/id #uuid "9c93eb0d-6ded-596d-b4ab-b36cd01140e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}+3\\sqrt[3]{{x}^{2}}-{x}^{2}\\sqrt{x}" :db/id #edb/ref 17592186563296} {:answer/id #uuid "ac5245bd-caba-5f74-b81d-55f9a9e8ac2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}+3\\sqrt[3]{{x}^{2}}-x\\sqrt{x}" :db/id #edb/ref 17592186563336} {:answer/id #uuid "ebcfccec-dd55-5089-ac9a-b0ae93280f1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[3]{3{x}^{2}-{x}^{5}}" :db/id #edb/ref 17592186563472}] :answer-field/correct {:db/id #edb/ref 17592186563245} :answer-field/id #uuid "c61d8497-db30-5312-b6cc-cc9f8eeed283" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563622}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a056777d-2d90-5391-b8e4-3c8ae89bd6c6" :question/math-academy-id "q-4064" :question/problem "$3\\sqrt{3}-\\sqrt{27}+3\\sqrt[3]{{x}^{2}}-\\sqrt{{x}^{5}}=$" :question/worked-solution "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}3\\sqrt{3}-\\sqrt{27}+3\\sqrt[3]{{x}^{2}}-\\sqrt{{x}^{5}} & = \\\\ 3\\sqrt{3}-\\sqrt{9\\cdot 3}+3\\sqrt[3]{{x}^{2}}-\\sqrt{{x}^{4}\\cdot x} & = \\\\ 3\\sqrt{3}-\\sqrt{9}\\cdot \\sqrt{3}+3\\sqrt[3]{{x}^{2}}-\\sqrt{{x}^{4}}\\cdot \\sqrt{x} & = \\\\ 3\\sqrt{3}-3\\sqrt{3}+3\\sqrt[3]{{x}^{2}}-{x}^{2}\\sqrt{x} & \\end{aligned}\n$$\n\nFinally, we combine the like terms:\n\n$$\n\\begin{aligned}3\\sqrt{3}-3\\sqrt{3}+3\\sqrt[3]{{x}^{2}}-{x}^{2}\\sqrt{x} & = \\\\ (3-3)\\sqrt{3}+3\\sqrt[3]{{x}^{2}}-{x}^{2}\\sqrt{x} & = \\\\ 0\\cdot \\sqrt{3}+3\\sqrt[3]{{x}^{2}}-{x}^{2}\\sqrt{x} & = \\\\ 3\\sqrt[3]{{x}^{2}}-{x}^{2}\\sqrt{x} & \\end{aligned}\n$$"} :step/id #uuid "8968f935-7b70-53c6-a08f-fcaf88c8bc02" :step/next {:db/id #edb/ref 17592186563786}} {:db/id #edb/ref 17592186563801 :step/content {:db/id #edb/ref 17592186563723 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18d7d654-83a6-5095-8350-0c24ed3b09f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{6}+\\sqrt{x}" :db/id #edb/ref 17592186563002} {:answer/id #uuid "3f460124-51cf-5f31-ae09-245b7c4d361f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x" :db/id #edb/ref 17592186563088} {:answer/id #uuid "5b0c664c-f8c9-5f53-b9f0-e91c57fa6455" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\sqrt{6}" :db/id #edb/ref 17592186563151} {:answer/id #uuid "8d383985-681c-53c8-9484-5c98b6262456" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\sqrt{6}+2x\\sqrt{x}" :db/id #edb/ref 17592186563263} {:answer/id #uuid "e8fc2ea4-ed54-5789-9c1b-da6da0a36fc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\sqrt{6}-x\\sqrt{x}" :db/id #edb/ref 17592186563466}] :answer-field/correct {:db/id #edb/ref 17592186563263} :answer-field/id #uuid "2edd54bc-8785-50e5-9005-f3528fdfbcbc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563548}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aceecb75-92cf-58b4-997d-d31ecad9d81f" :question/math-academy-id "q-29322" :question/problem "Simplify $2x\\sqrt{54}+2x\\sqrt{x}-5x\\sqrt{6}.$" :question/worked-solution "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}2x\\sqrt{54}+2x\\sqrt{x}-5x\\sqrt{6} & = \\\\ 2x\\sqrt{9\\cdot 6}+2x\\sqrt{x}-5x\\sqrt{6} & = \\\\ 2x\\sqrt{9}\\cdot \\sqrt{6}+2x\\sqrt{x}-5x\\sqrt{6} & = \\\\ 2x\\cdot 3\\cdot \\sqrt{6}+2x\\sqrt{x}-5x\\sqrt{6} & = \\\\ 6x\\sqrt{6}+2x\\sqrt{x}-5x\\sqrt{6} & \\end{aligned}\n$$\n\nFinally, we combine the like terms:\n\n$$\n\\begin{aligned}6x\\sqrt{6}+2x\\sqrt{x}-5x\\sqrt{6} & = \\\\ (6x-5x)\\sqrt{6}+2x\\sqrt{x} & = \\\\ x\\sqrt{6}+2x\\sqrt{x}\\end{aligned}\n$$"} :step/id #uuid "b609203c-4095-58fb-bb8f-2ece8932910b"}] :activity/title "Adding and Subtracting Radical Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186562928}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186176598} :activity/id #uuid "ec9d4c2b-1a22-5786-bdab-76e3e5ac092b" :activity/scope {:db/id #edb/ref 17592186049135 :topic/id #uuid "dd916270-3c49-5d1a-a09d-9c318a1004ba" :topic/math-academy-id 3565} :activity/steps [{:db/id #edb/ref 17592186176598 :step/content {:db/id #edb/ref 17592186176967 :tutorial/content "Let's consider yet more important parts of a circle:\n\n- The **circumference** of a circle is used to describe the perimeter of the circle, as shown in the left diagram below.\n\n- An **arc** is a part of the circumference which is enclosed between two points on a circle. In the right diagram below, we have the arc $\\overset{\\frown}{AB}.$\n\n![](images/5c/5c918b32007a68beecfdef486e9cd5d0818a2122ad672415608f761f7f7953e7.png)\n\nIf an arc is denoted using only two letters, we are referring to the *shortest* arc. However, to avoid ambiguity, we can use three letters. For example, in the diagram below, $\\overset{\\frown}{ACB}$ is the arc to the left and $\\overset{\\frown}{ADB}$ is the arc to the right.\n\n![](images/f6/f6329cc70c467e968628d2d82a0839253ee443881371893d6d7721724e9ae02a.png)" :tutorial/id #uuid "8e47b911-fb88-5251-8c9f-e05a36b02014" :tutorial/math-academy-id 2419 :tutorial/title "Introduction"} :step/id #uuid "25d2b401-6584-5b07-9e4c-0c4734e5d10a" :step/math-academy-id 10841 :step/next {:db/id #edb/ref 17592186176670}} {:db/id #edb/ref 17592186176599 :step/content {:db/id #edb/ref 17592186175896 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175763 :question/id #uuid "2c4c8545-1b0a-519d-95b5-55c1da11b443" :question/math-academy-id "e-3169"} :knowledge-point/id #uuid "c1941876-94d1-52d5-9104-7875de691ca0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049856}] :knowledge-point/questions [{:db/id #edb/ref 17592186176521} {:db/id #edb/ref 17592186176522} {:db/id #edb/ref 17592186504650} {:db/id #edb/ref 17592186504675} {:db/id #edb/ref 17592186570766}] :knowledge-point/title "Identifying Parts of a Circle"} :step/id #uuid "9822102f-f61a-5ba7-a66f-4d48d24c1c3e" :step/math-academy-id 10842 :step/next {:db/id #edb/ref 17592186176600}} {:db/id #edb/ref 17592186176600 :step/content {:db/id #edb/ref 17592186175897 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175764 :question/id #uuid "11cc1b43-3faf-5687-aca8-12c3e60befca" :question/math-academy-id "e-3170"} :knowledge-point/id #uuid "938c4422-a8ae-56c4-b728-31776db43653" :knowledge-point/questions [{:db/id #edb/ref 17592186176520} {:db/id #edb/ref 17592186176523} {:db/id #edb/ref 17592186504636} {:db/id #edb/ref 17592186504670}] :knowledge-point/title "Completing a True Statement Regarding Circles"} :step/id #uuid "86752c7b-de72-5f68-969c-03022173a2d1" :step/math-academy-id 10843} {:db/id #edb/ref 17592186176670 :step/content {:db/id #edb/ref 17592186176974 :tutorial/content "Finally, we have two more elements of a circle to remember:\n\n- A **circular sector** is the region bounded by an arc of the circle and two radii which connect the center of the circle with the endpoints of the arc. In the left diagram below, we have the circular sector $OCD.$\n\n- A **circular segment** is the region bounded by an arc of the circle and the chord that connects the endpoints of the arc. In the right diagram below, we have the circular segment $PQ.$\n\n![](images/84/848e64be2b80b78d88da42473f6778d4012f7ec52ae6950f4ca3635b5b154ca6.png)" :tutorial/id #uuid "3f8e3ddf-673b-5e4a-9d61-f8a2c682ee36" :tutorial/math-academy-id 3986 :tutorial/title "Circular Segments and Sectors"} :step/id #uuid "6b12863c-3e31-50e4-b812-6ce26cac6267" :step/math-academy-id 23718 :step/next {:db/id #edb/ref 17592186176599}}] :activity/title "Arcs, Segments, and Sectors of Circles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186176115}] [{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186106588} :activity/id #uuid "2af93617-2850-5d80-8e89-a45566d1d99b" :activity/scope {:db/id #edb/ref 17592186049223 :topic/id #uuid "e4ba6b67-ce78-5f37-b120-6055b0e97c6c" :topic/math-academy-id 1319} :activity/steps [{:db/id #edb/ref 17592186106588 :step/content {:db/id #edb/ref 17592186107137 :tutorial/content "The sum of the interior angles of *any* triangle equals $180^\\circ.$\n\n![](images/fc/fcc21c5e13ab095da35eeca128e3a82a075d649e205aa0e1683b6ab0e4a4cc4c.png)\n\nAs it turns out, there is a general rule for the sum of the interior angles that applies to all polygons:\n\n*The sum of the interior angles of a polygon with $n$ sides equals $180^\\circ \\cdot (n-2).$*\n\nFor example, every triangle has ${\\color{blue}3}$ sides. Let's substitute $n={\\color{blue}3}$ into the formula to check that it works:\n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={180}^{∘}\\cdot (3-2) \\\\  & ={180}^{∘}\\cdot 1 \\\\  & ={180}^{∘}\\,✓\\end{aligned}\n$$\n\nSo, the formula tells us that the sum of the interior angles of a triangle equals $180^\\circ,$ which we know is correct.\n\nLet's see some more examples." :tutorial/id #uuid "8edf1574-04d8-5aea-839f-9c03c16e6ab5" :tutorial/math-academy-id 6654 :tutorial/title "Introduction"} :step/id #uuid "6daf0d6e-d3ca-5943-93ac-6a8d0ae04d45" :step/math-academy-id 136665 :step/next {:db/id #edb/ref 17592186106589}} {:db/id #edb/ref 17592186106589 :step/content {:db/id #edb/ref 17592186107138 :tutorial/content "The sum of the interior angles of a polygon with $n$ sides equals \n\n$$\n180^\\circ \\cdot (n-2).\n$$\n\nEvery quadrilateral has $n={\\color{blue}4}$ sides. Applying the formula, we get\n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={180}^{∘}\\cdot (4-2) \\\\  & ={180}^{∘}\\cdot 2 \\\\  & ={360}^{∘}.\\end{aligned}\n$$\n\nSo, the formula tells us that the sum of the interior angles of a quadrilateral equals $360^\\circ.$ \n\n![](images/a0/a0d6cd7aa4b4e7aba6451b32087fa6cf86e0f63d2ff70e68328a5ac9d4eddcfc.png)" :tutorial/id #uuid "1de6f70b-9797-56cc-b325-b5375efaf06b" :tutorial/math-academy-id 6688 :tutorial/title "The Sum of the Interior Angles of a Quadrilateral"} :step/id #uuid "55ff9455-d9c5-5dfd-b9aa-7d7ad79f0ad7" :step/math-academy-id 136666 :step/next {:db/id #edb/ref 17592186106590}} {:db/id #edb/ref 17592186106590 :step/content {:db/id #edb/ref 17592186105717 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105440 :question/id #uuid "757aacb7-c988-5f1f-9ae6-c69ebf1399ec" :question/math-academy-id "e-10772"} :knowledge-point/id #uuid "3d6d5827-91a8-5fd4-85ea-7564e8f5396e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049949} {:db/id #edb/ref 17592186049993} {:db/id #edb/ref 17592186050127}] :knowledge-point/questions [{:db/id #edb/ref 17592186106132} {:db/id #edb/ref 17592186106468} {:db/id #edb/ref 17592186500366}] :knowledge-point/title "Identifying Possible Interior Angles of a Quadrilateral"} :step/id #uuid "93903594-40c4-5f1f-b805-5569c124dd4b" :step/math-academy-id 136667 :step/next {:db/id #edb/ref 17592186106591}} {:db/id #edb/ref 17592186106591 :step/content {:db/id #edb/ref 17592186107139 :tutorial/content "The sum of the interior angles of a polygon with $n$ sides equals \n\n$$\n180^\\circ \\cdot (n-2).\n$$\n\nEvery pentagon has $n={\\color{blue}5}$ sides. Applying the formula, we get\n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={180}^{∘}\\cdot (5-2) \\\\  & ={180}^{∘}\\cdot 3 \\\\  & ={540}^{∘}.\\end{aligned}\n$$\n\nSo, the formula tells us that the sum of the interior angles of a pentagon equals $540^\\circ.$ \n\n![](images/8d/8d0478edf5e40b947b06b7b6b0b726999b11ce39dc8af5daaf414f2bd2292647.png)\n\nWe can use the same formula to deduce the sum of the interior angles of hexagons, heptagons, octagons, and so forth." :tutorial/id #uuid "573fd3ba-e480-5a75-ba71-1fd15e977637" :tutorial/math-academy-id 6738 :tutorial/title "The Sum of the Interior Angles of a Pentagon"} :step/id #uuid "9d73fd08-d0b3-549f-8356-26bd528a081c" :step/math-academy-id 136670 :step/next {:db/id #edb/ref 17592186106592}} {:db/id #edb/ref 17592186106592 :step/content {:db/id #edb/ref 17592186105718 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105438 :question/id #uuid "5f89d47f-4068-508e-9fdd-1f3768d53a92" :question/math-academy-id "e-10637"} :knowledge-point/id #uuid "bad93a16-17d4-50ff-89c8-f3d966df5f1a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673} {:db/id #edb/ref 17592186050452}] :knowledge-point/questions [{:db/id #edb/ref 17592186106315} {:db/id #edb/ref 17592186106317} {:db/id #edb/ref 17592186500330} {:db/id #edb/ref 17592186500342} {:db/id #edb/ref 17592186500365} {:db/id #edb/ref 17592186500375} {:db/id #edb/ref 17592186511562} {:db/id #edb/ref 17592186549028} {:db/id #edb/ref 17592186571431}] :knowledge-point/title "Finding Unknown Quantities in Quadrilaterals and Pentagons"} :step/id #uuid "66ba6652-6516-5c96-9fc2-f1a279bbcdce" :step/math-academy-id 136671 :step/next {:db/id #edb/ref 17592186106593}} {:db/id #edb/ref 17592186106593 :step/content {:db/id #edb/ref 17592186105719 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105439 :question/id #uuid "7d0dd769-07d8-58c6-a2c8-d6165ca5bb5a" :question/math-academy-id "e-10638"} :knowledge-point/id #uuid "0b111120-41dd-5a58-bcc5-b0b6fc78b384" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048354}] :knowledge-point/questions [{:db/id #edb/ref 17592186106206} {:db/id #edb/ref 17592186106207} {:db/id #edb/ref 17592186500302} {:db/id #edb/ref 17592186500305} {:db/id #edb/ref 17592186500348} {:db/id #edb/ref 17592186549030} {:db/id #edb/ref 17592186571389}] :knowledge-point/title "Finding the Number of Sides of a Polygon Given the Sum of Its Interior Angles"} :step/id #uuid "7f2b2f6c-0f00-518c-8edf-15031fffc70c" :step/math-academy-id 136674 :step/next {:db/id #edb/ref 17592186106594}} {:db/id #edb/ref 17592186106594 :step/content {:db/id #edb/ref 17592186107170 :tutorial/content "We've made use of the following theorem throughout this lesson. \n\n*The sum of the interior angles of a polygon with $n$ sides equals $180^\\circ \\cdot (n-2).$*\n\nThis formula works because any $n$-sided polygon can be split into $n-2$ triangles using diagonals that meet at one fixed vertex of the polygon. \n\nLet's illustrate this for a few different polygons.\n\n| ![](images/20/20aae267ba75bb418e509d548b1519af47b4cf9464d7f8400369c8e77b013aae.png) | **Quadrilateral** \n\nNumber of vertices: $4$ \n\nNumber of triangles: $4 - 2 = {\\color{blue}{2}}$ \n\nSum of interior angles: $180^\\circ \\cdot {\\color{blue}{2}} = 360^\\circ$ |\n| --- | --- |\n| ![](images/20/20551ad9f4661402aef9e501bf9d4c841e671b4277fae78f85d9e9ada9830592.png) | **Pentagon** \n\nNumber of vertices: $5$ \n\nNumber of triangles: $5 - 2 = {\\color{blue}{3}}$ \n\nSum of interior angles: $180^\\circ \\cdot {\\color{blue}{3}} = 540^\\circ$ |\n| ![](images/de/de8ec9be742a40384891de3a682a151e817f6c24d624e0ef505fb98ce6a1e60d.png) | **Hexagon** \n\nNumber of vertices: $6$ \n\nNumber of triangles: $6 - 2 = {\\color{blue}{4}}$ \n\nSum of interior angles: $180^\\circ \\cdot {\\color{blue}{4}} = 720^\\circ$ |\n\nThe sum of the interior angles of each polygon is the same as the sum of the interior angles of the corresponding triangles. \n\nEach triangle has interior angles that sum to $180^\\circ,$ and any $n$-sided polygon can be split into $n-2$ triangles in the manner shown above. Therefore, the sum of the interior angles in an $n$-sided polygon is\n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2).\\end{aligned}\n$$" :tutorial/id #uuid "211863f5-73c2-57af-83e9-696d21971d5b" :tutorial/math-academy-id 9114 :tutorial/title "Justification of the Formula"} :step/id #uuid "19ab5e9d-cd9a-5abe-b2d8-a8c2a4b0511a" :step/math-academy-id 136677}] :activity/title "Interior Angles of Polygons" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186105973}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186549143} :activity/id #uuid "44b9f3a5-0dff-53bd-9ea1-9ffa89f58594" :activity/scope {:db/id #edb/ref 17592186049223 :topic/id #uuid "e4ba6b67-ce78-5f37-b120-6055b0e97c6c" :topic/math-academy-id 1319} :activity/steps [{:db/id #edb/ref 17592186549105 :step/content {:db/id #edb/ref 17592186549030 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f8c4f4d-a7cb-5f36-ba29-a840d9bbe587" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186548564} {:answer/id #uuid "ae31482c-97e7-5e10-8bf9-1fb019613501" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "29" :db/id #edb/ref 17592186548700} {:answer/id #uuid "ca5c0925-8ebb-5ac7-b69a-43148347d1bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186548752} {:answer/id #uuid "ef70b68e-e007-52ca-93c9-efe7e0c22ece" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "23" :db/id #edb/ref 17592186548828} {:answer/id #uuid "f4c3f901-4de5-5726-95e7-07fe74a05efc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "26" :db/id #edb/ref 17592186548842}] :answer-field/correct {:db/id #edb/ref 17592186548752} :answer-field/id #uuid "d8f0acf3-60c9-5fe9-a760-cefa37eb9b66" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186548963}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "918f9202-d934-535a-b14f-29131ec63f3f" :question/math-academy-id "q-118069" :question/problem "The sum of the interior angles of a polygon is ${3960}^{∘}.$ How many sides does it have?" :question/worked-solution "Remember that the sum of the interior angles of a polygon with $n$ sides is ${180}^{∘}\\cdot (n-2).$\n\nTo find the number of sides in our polygon, we start by setting up the following equation:\n\n$$\n{180}^{∘}\\cdot (n-2)=3\\,{960}^{∘}\n$$\n\nNow, we solve for $n,$ as follows:\n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & =3\\,{960}^{∘} \\\\ n-2 & =\\frac{3\\,{960}^{∘}}{{180}^{∘}} \\\\ n-2 & =22 \\\\ n & =24\\end{aligned}\n$$\n\nTherefore, the polygon has $n=24$ sides."} :step/id #uuid "607ff265-5b9e-5bf6-aea9-88e5319e920b"} {:db/id #edb/ref 17592186549120 :step/content {:db/id #edb/ref 17592186549028 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23ba891b-8c25-5525-b032-ab5b189de223" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{3}^{∘}" :db/id #edb/ref 17592186548425} {:answer/id #uuid "779f08b8-d128-5006-babf-2a4ce92fda54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{8}^{∘}" :db/id #edb/ref 17592186548574} {:answer/id #uuid "78305b75-af32-5483-8ec7-da87251e1870" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{14}^{∘}" :db/id #edb/ref 17592186548577} {:answer/id #uuid "8845496d-a3e1-5e36-8bf1-e36d44baa191" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{10}^{∘}" :db/id #edb/ref 17592186548617} {:answer/id #uuid "c14baac9-826a-5be1-a8d3-292463298b03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{21}^{∘}" :db/id #edb/ref 17592186548739}] :answer-field/correct {:db/id #edb/ref 17592186548574} :answer-field/id #uuid "172b1f55-032f-506f-a1f3-de37620daea9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186548874}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8d216a5f-ca4b-530d-81c3-76f09a214af9" :question/math-academy-id "q-4316" :question/problem "![](images/fa/fa797de4c7edfb4e4c4bc4eab40e8443f832c0407f08fd9d9ae28730c468a71e.png)\n\nIn the quadrilateral $OMNP$ shown above, find $x.$" :question/worked-solution "A quadrilateral has $n=4$ sides. Therefore, the sum of the interior angles of a quadrilateral must be \n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={180}^{∘}\\cdot (4-2) \\\\  & ={180}^{∘}\\cdot 2 \\\\  & ={360}^{∘}.\\end{aligned}\n$$\n\nAdding up the internal angles and solving for $x,$ we get\n\n$$\n\\begin{aligned}m∠O+m∠M+m∠N+m∠P & ={360}^{∘} \\\\ {93}^{∘}+(14x-{7}^{∘})+(11x-{2}^{∘})+{76}^{∘} & ={360}^{∘} \\\\ 25x+{160}^{∘} & ={360}^{∘} \\\\ 25x & ={200}^{∘} \\\\ x & ={8}^{∘}\\end{aligned}\n$$"} :step/id #uuid "85a2f551-1e0a-5802-976a-5d521b297245" :step/next {:db/id #edb/ref 17592186549105}} {:db/id #edb/ref 17592186549143 :step/content {:db/id #edb/ref 17592186106317 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dc54541-63d3-5382-8d61-ad8fb7a2df0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{75}^{∘}" :db/id #edb/ref 17592186548386} {:answer/id #uuid "55f686c3-4dc7-5ee6-94df-392ace9f44b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{81}^{∘}" :db/id #edb/ref 17592186548516} {:answer/id #uuid "a4ab1399-f698-5779-856e-01b204aa3767" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{63}^{∘}" :db/id #edb/ref 17592186548680} {:answer/id #uuid "b20abdd4-a291-58d8-b13c-b588f3c268d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{34}^{∘}" :db/id #edb/ref 17592186548708} {:answer/id #uuid "b25b8a4a-c870-5c94-9647-8973446f4945" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{68}^{∘}" :db/id #edb/ref 17592186548711}] :answer-field/correct {:db/id #edb/ref 17592186548516} :answer-field/id #uuid "c276b696-0a88-550f-b1ad-bf6a66980d06" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186104050}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b1f1caf2-8ee2-5aae-ae77-233643724815" :question/math-academy-id "q-4231" :question/problem "![](images/48/48d9d8513f45b87f9deffeffcef31e49a6dcaba0b033c91a918c1d72d87eb215.png)\n\nIn the quadrilateral $ABCD$ above, determine the measure of $∠C.$" :question/worked-solution "A quadrilateral has $n=4$ sides. Therefore, the sum of the interior angles of a quadrilateral  must be \n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={180}^{∘}\\cdot (4-2) \\\\  & ={180}^{∘}\\cdot 2 \\\\  & ={360}^{∘}\\end{aligned}\n$$\n\nAdding up the internal angles and solving for $x,$ we get\n\n$$\n\\begin{aligned}m∠A+m∠B+m∠C+m∠D & ={360}^{∘} \\\\ x+{90}^{∘}+3x+6x & ={360}^{∘} \\\\ 10x+{90}^{∘} & ={360}^{∘} \\\\ 10x & ={270}^{∘} \\\\ x & ={27}^{∘}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}m∠C & =3x \\\\  & =3({27}^{∘}) \\\\  & ={81}^{∘}.\\end{aligned}\n$$"} :step/id #uuid "ceeba030-1335-5012-a7a2-5d16d0992cf8" :step/next {:db/id #edb/ref 17592186549120}}] :activity/title "Interior Angles of Polygons" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186548341}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186571490} :activity/id #uuid "138360b1-768e-5e3c-ac72-e07110620982" :activity/scope {:db/id #edb/ref 17592186049223 :topic/id #uuid "e4ba6b67-ce78-5f37-b120-6055b0e97c6c" :topic/math-academy-id 1319} :activity/steps [{:db/id #edb/ref 17592186571456 :step/content {:db/id #edb/ref 17592186571389 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "087ccede-33f5-5195-9b20-20231b7111e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186570904} {:answer/id #uuid "57b5d47e-d89a-5826-aea5-db085b14ccab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186571026} {:answer/id #uuid "c47bbdb0-97dd-558f-8cbd-d5cedcbbf537" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186571195} {:answer/id #uuid "da9be92d-36c8-5e75-9fa1-ce0bcc251023" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186571227} {:answer/id #uuid "ffd6fbd6-2ac9-570c-8cf7-38cf4ec08434" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186571280}] :answer-field/correct {:db/id #edb/ref 17592186571227} :answer-field/id #uuid "aa5a75a9-cf7a-5ed4-8499-ccb893baaf9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571349}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "407e8da8-449d-50a1-846d-17321f5d621f" :question/math-academy-id "q-68108" :question/problem "The sum of the interior angles of a polygon is ${1260}^{∘}.$ How many sides does it have?" :question/worked-solution "Remember that the sum of the interior angles of a polygon with $n$ sides is ${180}^{∘}\\cdot (n-2).$\n\nTo find the number of sides in our polygon, we start by setting up the following equation:\n\n$$\n{180}^{∘}\\cdot (n-2)=1\\,{260}^{∘}\n$$\n\nNow, we solve for $n,$ as follows:\n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & =1\\,{260}^{∘} \\\\ n-2 & =\\frac{1\\,{260}^{∘}}{{180}^{∘}} \\\\ n-2 & =7 \\\\ n & =9\\end{aligned}\n$$\n\nTherefore, the polygon has $n=9$ sides (so it is a nonagon)."} :step/id #uuid "000349e2-1e18-52dc-948a-61a295c5ca01"} {:db/id #edb/ref 17592186571462 :step/content {:db/id #edb/ref 17592186571431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55bbde82-dc2a-5198-9282-78920ca4d7b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{76}^{∘}" :db/id #edb/ref 17592186571020} {:answer/id #uuid "68d9c9d2-c4ee-5369-ad28-406b236d5756" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{80}^{∘}" :db/id #edb/ref 17592186571055} {:answer/id #uuid "715bae87-ddc1-5d3b-a222-2343cb0987a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{72}^{∘}" :db/id #edb/ref 17592186571067} {:answer/id #uuid "8ecfa468-92a9-55f5-9f15-5d0ce9e5f16b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{84}^{∘}" :db/id #edb/ref 17592186571113} {:answer/id #uuid "cee2fb05-a7b0-5c6e-88e4-091526dba551" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{92}^{∘}" :db/id #edb/ref 17592186571210}] :answer-field/correct {:db/id #edb/ref 17592186571020} :answer-field/id #uuid "f576a5f9-158f-5c8f-9257-5b6840166ec6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571374}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9e56717a-c5ad-51b8-ae63-5cc496ab485e" :question/math-academy-id "q-4310" :question/problem "![](images/fc/fc485a3c47295e08c917d1c9a2e90df0a0d6eaa931f4df23e17700da1536ca6e.png)\n\nIn the quadrilateral $OMNP$ shown above, find the measure of $∠N.$" :question/worked-solution "A quadrilateral has $n=4$ sides. Therefore, the sum of the interior angles of a quadrilateral must be \n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={180}^{∘}\\cdot (4-2) \\\\  & ={180}^{∘}\\cdot 2 \\\\  & ={360}^{∘}.\\end{aligned}\n$$\n\nAdding up the internal angles and solving for $x,$ we get\n\n$$\n\\begin{aligned}m∠M+m∠N+m∠P+m∠O & ={360}^{∘} \\\\ {104}^{∘}+(10x-{4}^{∘})+{104}^{∘}+{76}^{∘} & ={360}^{∘} \\\\ 10x+{280}^{∘} & ={360}^{∘} \\\\ 10x & ={80}^{∘} \\\\ x & ={8}^{∘}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}m∠N & =10x-{4}^{∘} \\\\  & =10({8}^{∘})-{4}^{∘} \\\\  & ={76}^{∘}.\\end{aligned}\n$$"} :step/id #uuid "168198c9-67f3-5f0f-8907-74beb26be266" :step/next {:db/id #edb/ref 17592186571456}} {:db/id #edb/ref 17592186571490 :step/content {:db/id #edb/ref 17592186106315 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "906388b6-93f9-5ca5-a23a-5c68acb32845" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "105^{∘}" :db/id #edb/ref 17592186104039} {:answer/id #uuid "038caf9d-24e4-5261-b4b7-93f45459b83a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "125^{∘}" :db/id #edb/ref 17592186104040} {:answer/id #uuid "210f4cc2-b4c4-5b25-9892-f0a285e15759" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "115^{∘}" :db/id #edb/ref 17592186104041} {:answer/id #uuid "3c811a6e-5a94-5f69-8deb-0d0415c81014" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "110^{∘}" :db/id #edb/ref 17592186104042} {:answer/id #uuid "6e453b8a-ef6d-5bf4-8a09-cfad11ab71b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "95^{∘}" :db/id #edb/ref 17592186104043}] :answer-field/id #uuid "ddeecf2e-88eb-55a2-8a26-c77cbaf870a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186104038}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7ba7dcfb-4dc0-5068-be2d-bf724179f704" :question/math-academy-id "q-4216" :question/problem "![](images/f2/f22e09654fb5562f1ac1b91b9ced70c41c5f796705f4bf76820950f69f706fb9.png)\n\nFind $m∠C$ In the quadrilateral $ABCD$ above."} :step/id #uuid "7983dc6b-c0cf-5e72-baec-ade88db8ba03" :step/next {:db/id #edb/ref 17592186571462}}] :activity/title "Interior Angles of Polygons" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186570879}] [{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186139353} :activity/id #uuid "753f3c2c-963f-5bf9-82db-0290639a9a4b" :activity/scope {:db/id #edb/ref 17592186049281 :topic/id #uuid "e9994744-cb83-57d9-8154-ea5ac4c05cc8" :topic/math-academy-id 2274} :activity/steps [{:db/id #edb/ref 17592186139353 :step/content {:db/id #edb/ref 17592186139717 :tutorial/content "A good example of a direct variation model is the distance an object travels when moving at a constant rate. In this case, the corresponding direct variation equation is \n\n$$\nd=vt,\n$$\n\n \n\nwhere \n\n- $d$ is the total distance traveled by the object,\n\n- $t$ is the total time that the object has been traveling, and,\n\n- $v$ is the constant of proportionality, called the **speed** of the object.\n\nFor instance, if an object travels a distance of $24\\,\\textrm m$ in $4$ seconds, then we can substitute $d=24\\,\\textrm m$ and $t=4\\,\\textrm s$ into the above equation and solve for $v,$ as follows:\n\n$$\n\\begin{aligned}24 & =v\\cdot 4 \\\\ \\frac{24}{4} & =v \\\\ 6 & =v\\end{aligned}\n$$\n\nSo, the equation that relates $d$ and $t$ is\n\n$$\nd=6t.\n$$\n\n \n\nOne thing to note is that the constant of proportionality $v = 6$ also has units. So let's work out what these units are.\n\nSince we have\n\n$$\nd = vt,\n$$\n\nit follows that\n\n$$\nv = \\dfrac{d}{t}.\n$$\n\nSo, the units of $v$ are\n\n$$\n\\dfrac{\\textrm m}{\\textrm s} = \\textrm m / \\textrm s.\n$$\n\nTherefore, the constant of proportionality (including its unit) is $v = 6\\, \\textrm m / \\textrm s.$" :tutorial/id #uuid "dcda3158-97b6-5a4a-b062-3803a3db7b26" :tutorial/math-academy-id 8753 :tutorial/title "Introduction"} :step/id #uuid "577c6468-9f0e-55fb-84fc-17fcc4e6bca8" :step/math-academy-id 196782 :step/next {:db/id #edb/ref 17592186139354}} {:db/id #edb/ref 17592186139354 :step/content {:db/id #edb/ref 17592186138430 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138166 :question/id #uuid "f01f91de-9010-5429-ba83-faaf90c866d7" :question/math-academy-id "e-14086"} :knowledge-point/id #uuid "a35a2fee-a1a5-59aa-9390-f73d2898320c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049092} {:db/id #edb/ref 17592186049141}] :knowledge-point/questions [{:db/id #edb/ref 17592186138736} {:db/id #edb/ref 17592186138826} {:db/id #edb/ref 17592186499522} {:db/id #edb/ref 17592186499543} {:db/id #edb/ref 17592186541112}] :knowledge-point/title "Calculating a Constant of Variation"} :step/id #uuid "fd7ad040-afed-5ba6-ad72-f3ed0909fc54" :step/math-academy-id 196783 :step/next {:db/id #edb/ref 17592186139355}} {:db/id #edb/ref 17592186139355 :step/content {:db/id #edb/ref 17592186138431 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138168 :question/id #uuid "f1408bad-ae5c-55fb-b78e-60ee0d8a1ca0" :question/math-academy-id "e-14088"} :knowledge-point/id #uuid "7df32abc-07bd-5213-a838-50e893ff5759" :knowledge-point/questions [{:db/id #edb/ref 17592186138664} {:db/id #edb/ref 17592186138738} {:db/id #edb/ref 17592186499547}] :knowledge-point/title "Modeling With Direct Variation"} :step/id #uuid "d2efc257-0a27-570d-a356-98d12f63e6c2" :step/math-academy-id 196786 :step/next {:db/id #edb/ref 17592186139356}} {:db/id #edb/ref 17592186139356 :step/content {:db/id #edb/ref 17592186139719 :tutorial/content "When modeling proportional relationships, we sometimes find that a quantity $y$ varies directly with the *square* of a second quantity $x.$ In such cases, we write\n\n$$\ny = kx^2.\n$$\n\nFor example, consider a circle of radius $r,$ measured in centimeters.\n\n![](images/fa/fad3151a754d96d3e4ad97fa812ce7087601cebe7c4ab00f7b3c8cd603b140c0.png)\n\nIt can be shown that the area $A,$ measured in square meters, of a circle varies directly with the *square* of the radius $r.$ Therefore, we have the equation\n\n$$\nA = k r^2.\n$$" :tutorial/id #uuid "c5a8d87f-edfb-5e37-ad6d-6cafde48e4ef" :tutorial/math-academy-id 8755 :tutorial/title "Variations With Second Powers"} :step/id #uuid "80f09102-b1f8-5a4e-8df1-f285f0944581" :step/math-academy-id 196789 :step/next {:db/id #edb/ref 17592186139357}} {:db/id #edb/ref 17592186139357 :step/content {:db/id #edb/ref 17592186138432 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138171 :question/id #uuid "201cba9a-1d9e-5bf3-b312-d84fb3d59407" :question/math-academy-id "e-14091"} :knowledge-point/id #uuid "01db3ebe-66ec-5340-8e29-c99fb149f5da" :knowledge-point/questions [{:db/id #edb/ref 17592186138739} {:db/id #edb/ref 17592186138898} {:db/id #edb/ref 17592186499473} {:db/id #edb/ref 17592186499532} {:db/id #edb/ref 17592186571394} {:db/id #edb/ref 17592186571398} {:db/id #edb/ref 17592186571412}] :knowledge-point/title "Modeling Direct Variations With Second Powers"} :step/id #uuid "458a0b34-716e-5233-8ee6-52e6a9afd6a3" :step/math-academy-id 196790}] :activity/title "Modeling with Direct Variation" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186138600}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186571503} :activity/id #uuid "af367d3a-cdad-5fce-b0de-9044800e4633" :activity/scope {:db/id #edb/ref 17592186049281 :topic/id #uuid "e9994744-cb83-57d9-8154-ea5ac4c05cc8" :topic/math-academy-id 2274} :activity/steps [{:db/id #edb/ref 17592186571496 :step/content {:db/id #edb/ref 17592186571398 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b0f61ca-4b31-5d02-b3fa-da62506bb922" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186570909} {:answer/id #uuid "178a11f1-2e2f-512c-81ef-7ba747eb04b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi" :db/id #edb/ref 17592186570924} {:answer/id #uuid "31844f5d-e1c6-58a5-911d-752c2c6738db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186570969} {:answer/id #uuid "34146648-0aef-5194-b0bd-b28640147dea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\pi" :db/id #edb/ref 17592186570972} {:answer/id #uuid "4841b2db-6473-515a-b60c-cb4143294f92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\pi" :db/id #edb/ref 17592186571005}] :answer-field/correct {:db/id #edb/ref 17592186570972} :answer-field/id #uuid "4782ff3c-c734-5dad-88e3-9bed03473528" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571309}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "52c4a416-f053-5e55-99b6-12fd0ef1b322" :question/math-academy-id "q-120299" :question/problem "The surface $S,$ in square centimeters, of a cylinder whose height equals the radius of its base varies directly with the **square** of its radius $r,$ measured in centimeters. If the surface is $16\\pi \\,{\\text{cm}}^{2}$ when the radius is $2\\,\\text{cm},$ then what is the constant of variation?" :question/worked-solution "The surface $S$ is directly proportional to the radius $r,$ so we have\n\n$$\nS=k{r}^{2},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that $S=16\\pi \\,{\\text{cm}}^{2}$ when $r=2\\,\\text{cm}.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}16\\pi  & =k\\cdot {2}^{2} \\\\ 16\\pi  & =k\\cdot 4 \\\\ \\frac{16\\pi }{4} & =k \\\\ 4\\pi  & =k\\end{aligned}\n$$\n\nTherefore, the constant of variation is $k=4\\pi .$"} :step/id #uuid "a99e37c4-23d9-55c1-b8b6-ca1793b52727" :step/next {:db/id #edb/ref 17592186571517}} {:db/id #edb/ref 17592186571503 :step/content {:db/id #edb/ref 17592186571412 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1897ea72-c13e-5fd4-8083-32c921ead598" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186570927} {:answer/id #uuid "4786e8d1-90b1-5d13-9ebd-a4ddaedea0e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186571003} {:answer/id #uuid "58ba7898-216c-5d88-b22b-f355ac55120b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186571031} {:answer/id #uuid "82b7408e-0165-58fb-9ffe-29dd90fb32bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186571094} {:answer/id #uuid "d611d837-c607-55f1-84f6-82a363b4fcc6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186571224}] :answer-field/correct {:db/id #edb/ref 17592186571224} :answer-field/id #uuid "cf2bf7fa-473d-5f46-831b-f02037509aa6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571356}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6bd84e69-7c5f-5a4e-bce4-f665a1006214" :question/math-academy-id "q-52005" :question/problem "The distance $d$, in meters, a falling body travels after being released from rest varies directly with the **square** of the time $t,$ measured in seconds, since the body was released. If the body covers $12$ meters in $2$ seconds, then what is the constant of variation?" :question/worked-solution "The distance $d$ is directly proportional to the square of the time $t$, so we have\n\n$$\nd=k{t}^{2},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that $d=12\\,\\text{m}$ when $t=2\\,\\text{s}.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}12 & =k\\cdot {2}^{2} \\\\ 12 & =k\\cdot 4 \\\\ \\frac{12}{4} & =k \\\\ 3 & =k\\end{aligned}\n$$\n\nTherefore, the constant of variation is $k=3.$"} :step/id #uuid "c86fa239-db3c-5048-bcc4-8263276901e2" :step/next {:db/id #edb/ref 17592186571496}} {:db/id #edb/ref 17592186571517 :step/content {:db/id #edb/ref 17592186571394 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6f99b8f-3a5a-5ef1-bccb-09ce2846b404" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2244q^2" :db/id #edb/ref 17592186571154}] :answer-field/correct {:db/id #edb/ref 17592186571154} :answer-field/id #uuid "d70374a3-fd1e-563a-bc82-ef9476203959" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186571362}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "493093e8-547a-52cb-ae1e-43635271726b" :question/math-academy-id "q-210542" :question/problem "The electrostatic force $F,$ in newtons ($N$), exerted between two identical charged particles kept at a fixed distance apart, varies directly with the **square** of the charge $q$ of each particle, measured in coulombs $(C).$ If the electrostatic force is $8\\,976\\,N$ when the charges are $2\\,C,$ then express $F$ in terms of $q.$\n\n$F=$\n{{field-1}}" :question/worked-solution "The electrostatic force $F$ is directly proportional to the square of the charge $q,$ so we have\n\n$$\nF=k{q}^{2},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that $F=8\\,976\\,\\text{N}$ when $q=2\\,\\text{C}.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}8\\,976 & =k\\cdot {2}^{2} \\\\ 8\\,976 & =k\\cdot 4 \\\\ \\frac{8\\,976}{4} & =k \\\\ 2\\,244 & =k\\end{aligned}\n$$\n\nTherefore, our direct variation equation is\n\n$$\nF=2\\,244{q}^{2}.\n$$"} :step/id #uuid "f590571b-7252-57ff-b911-5ccaa64a69e4"}] :activity/title "Modeling with Direct Variation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186570886}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186084061} :activity/id #uuid "da88a97d-6c4e-5299-b921-71200664bd9d" :activity/scope {:db/id #edb/ref 17592186049474 :topic/id #uuid "f80da52a-4a96-5269-8885-c600a798d61e" :topic/math-academy-id 790} :activity/steps [{:db/id #edb/ref 17592186084061 :step/content {:db/id #edb/ref 17592186084526 :tutorial/content "Let's plot the graph of ![](images/e3/e31f27c483c52d7933201e37d1f6020c20d7903402be16f28ffd407c7f3db93a.svg). According to the algebraic definition of absolute value, we have\n![](images/eb/ebc6cc8f3964043ffa2ff15f7e3501222794753f30577e4b71037efb2e4ffa30.svg)\nSo, the left-hand branch of the graph is the function ![](images/8f/8f96aa73ce843c7815a1fed6bf3f3774a173cfa4d56f13e1f3a8c48d53cd7097.svg), and the right-hand branch is ![](images/23/238e977be23f692486c8bf68f6b40255435b3d1796cc50d260a014a8c670be7b.svg):\n\n![](images/60/60ad4dfdb6086f20f5137c5b4ac4905e55d5697ec4cf31575bf79be5fd408e0c.png)\n\nNotice that the graph has a sharp corner at ![](images/c1/c1e8c20213b45135f50bdc8d4544220f7b0f943ff3ca49439660c86d017e789f.svg) We call this point the **vertex** or the **minimum point.**\n\nWe can apply **horizontal** and **vertical translations** to the graph of ![](images/e3/e31f27c483c52d7933201e37d1f6020c20d7903402be16f28ffd407c7f3db93a.svg).\n\n- The graph of ![](images/91/91c9b5c48d46f81336e889febab90a9027a96accef8626bd0743ca81042f25b8.svg) is a **vertical translation** of the absolute value graph ![](images/0c/0cb4d1ae0c2e2451edd095b9dbcca94222e8ef0514db46745a2acce4b617d78e.svg) It moves the graph ![](images/34/349015631ec44ef653936c85586d2c5ef56ba64392b3f92b4b92cbef3e731bc5.svg) units up.\n\n![](images/cd/cd8b826034f7c3668cacb490e0fab60daaf7c5cae63975bfa5cae9d468c7dec6.png)\n\n- The graph of ![](images/30/3016548be8be38ace3450d51a10371543820a3357b1adbf809d69c23c70f14bb.svg) is a **horizontal translation** of the absolute value graph ![](images/0c/0cb4d1ae0c2e2451edd095b9dbcca94222e8ef0514db46745a2acce4b617d78e.svg) It moves the graph ![](images/34/349015631ec44ef653936c85586d2c5ef56ba64392b3f92b4b92cbef3e731bc5.svg) units to the *right*.\n\n![](images/65/65912d2831dd525964b78a20f2a707d7d828daa2a5e2ebd0793c6b337a42e360.png)\n\nNote the following:\n\n- When drawing horizontal and vertical translations, it is easiest to transform the graph's vertex first. Then, the two branches can be drawn coming out of the vertex.\n\n- When we translate the graph ![](images/87/87f4b5227cb69bd468d75d826fe448c91ae677181f9142fcbe9bc757d0acea77.svg) the resulting curve is called the **image** of ![](images/e3/e31f27c483c52d7933201e37d1f6020c20d7903402be16f28ffd407c7f3db93a.svg) under the translation." :tutorial/id #uuid "1b8dce6a-8742-581b-80f6-e39c9943b395" :tutorial/math-academy-id 9295 :tutorial/title "Introduction"} :step/id #uuid "bdb8f706-56c3-508a-a745-c4cf4b268e01" :step/math-academy-id 169443 :step/next {:db/id #edb/ref 17592186084062}} {:db/id #edb/ref 17592186084062 :step/content {:db/id #edb/ref 17592186083189 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082947 :question/id #uuid "5a2db9be-6ef3-5466-a7cc-4e7e2b5670ec" :question/math-academy-id "e-14919"} :knowledge-point/id #uuid "61ec00a6-06ae-5d78-bb1a-b06351432cc3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049534} {:db/id #edb/ref 17592186049844}] :knowledge-point/questions [{:db/id #edb/ref 17592186083554} {:db/id #edb/ref 17592186083623} {:db/id #edb/ref 17592186506600}] :knowledge-point/title "Graphing a Vertical Translation"} :step/id #uuid "6d0878f5-845c-5163-b1ae-e72f37806b6d" :step/math-academy-id 169444 :step/next {:db/id #edb/ref 17592186084063}} {:db/id #edb/ref 17592186084063 :step/content {:db/id #edb/ref 17592186083190 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082948 :question/id #uuid "2e688f8d-16cc-58d6-8791-538cc335ce04" :question/math-academy-id "e-14925"} :knowledge-point/id #uuid "05cffafa-cfcf-5979-a413-b7d0b66dd434" :knowledge-point/questions [{:db/id #edb/ref 17592186083624} {:db/id #edb/ref 17592186083676} {:db/id #edb/ref 17592186506528} {:db/id #edb/ref 17592186570741} {:db/id #edb/ref 17592186570773}] :knowledge-point/title "Graphing a Horizontal Translation"} :step/id #uuid "dfd03723-b5ce-5ca8-98bb-2b1cf56700d6" :step/math-academy-id 169447 :step/next {:db/id #edb/ref 17592186084064}} {:db/id #edb/ref 17592186084064 :step/content {:db/id #edb/ref 17592186084528 :tutorial/content "Horizontal and vertical translations can be combined. It does not matter which we do first.\n\nIn general, the graph of $y=|x-h|+k$ is a translation of the graph $y=|x|$ by\n\n- $h$ units right, and\n\n- $k$ units up." :tutorial/id #uuid "b55739df-8b0d-5ef2-9702-d56de0246597" :tutorial/math-academy-id 9302 :tutorial/title "Combining Translations"} :step/id #uuid "3287422a-9367-5f91-9957-0152a7e772df" :step/math-academy-id 169450 :step/next {:db/id #edb/ref 17592186084065}} {:db/id #edb/ref 17592186084065 :step/content {:db/id #edb/ref 17592186083191 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082949 :question/id #uuid "82de263c-391b-5d45-bbd6-353c31c806fc" :question/math-academy-id "e-14933"} :knowledge-point/id #uuid "ca5dcf12-db1a-5cfc-b369-986caa8f666c" :knowledge-point/questions [{:db/id #edb/ref 17592186083546} {:db/id #edb/ref 17592186083625} {:db/id #edb/ref 17592186083628} {:db/id #edb/ref 17592186506530} {:db/id #edb/ref 17592186506595} {:db/id #edb/ref 17592186570706} {:db/id #edb/ref 17592186570714} {:db/id #edb/ref 17592186570739}] :knowledge-point/title "Combining Horizontal and Vertical Translations"} :step/id #uuid "09be9587-52a8-510c-841a-fe31ae2eb30e" :step/math-academy-id 169451}] :activity/title "Absolute Value Graphs" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083468}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186570848} :activity/id #uuid "b4da87d0-f5a5-50ee-a9f0-c6cb2fb5fc32" :activity/scope {:db/id #edb/ref 17592186049474 :topic/id #uuid "f80da52a-4a96-5269-8885-c600a798d61e" :topic/math-academy-id 790} :activity/steps [{:db/id #edb/ref 17592186570841 :step/content {:db/id #edb/ref 17592186570706 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "189651b0-54f3-5292-acb1-78996d20c50d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186570173} {:answer/id #uuid "80b350c2-d6af-593a-8af1-2ec69b5c8cad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186570352} {:answer/id #uuid "933e034e-403a-57ae-b3fe-587b30e14b03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186570383} {:answer/id #uuid "aa9212d0-88ad-5f2e-997d-59a47e64e7c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186570425} {:answer/id #uuid "dc88590b-2d68-5698-b5ee-ad190de36855" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186570511}] :answer-field/correct {:db/id #edb/ref 17592186570425} :answer-field/id #uuid "7196b41d-0d52-543a-bb1d-8738e6064d5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186570631}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "17bccb94-8027-5ec1-b42e-ebe5775a61ec" :question/math-academy-id "q-15814" :question/problem "Find the minimum value of $y$ on the graph $y=|x-3|+3.$" :question/worked-solution "Remember that $y=|x-h|+k$ is a vertical translation of the absolute value graph $y=|x|$ by $h$ units right and $k$ units up.\n\nThe function $y=|x-3|+3$ has $h=3$ and $k=3.$ Therefore, it is a translation of the absolute value graph $y=|x|$ by $3$ units *right* and $3$ units *up*.\n\n![](images/d5/d5c67a156d80c6dabd832539a4912c2bdd7ef38af9735fcade7ee46e4ba66eaa.png)\n\nLooking at the graph, we can see that the minimum value of $y$ is $3.$ This occurs at the point $(3,3).$"} :step/id #uuid "878cfbc6-5471-58e8-915b-20a46b57e956" :step/next {:db/id #edb/ref 17592186570844}} {:db/id #edb/ref 17592186570843 :step/content {:db/id #edb/ref 17592186570773 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23d06b4f-bc10-59f4-bad3-9be438d8e2e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,-1)" :db/id #edb/ref 17592186570189} {:answer/id #uuid "3ba1fb6c-8327-51bf-8fb0-05e23abf8c83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,0)" :db/id #edb/ref 17592186570222} {:answer/id #uuid "4cf6e7fe-b201-5c9d-a8a4-bd5f53457d4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,0)" :db/id #edb/ref 17592186570259} {:answer/id #uuid "a4336403-9070-5be9-84ed-ebf6940c61a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,1)" :db/id #edb/ref 17592186570415} {:answer/id #uuid "e950df02-b773-5199-bf04-fc99be23ac4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,1)" :db/id #edb/ref 17592186570532}] :answer-field/correct {:db/id #edb/ref 17592186570222} :answer-field/id #uuid "a0a5060b-5648-5c20-ac0c-e7491147f963" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186570651}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bc3a1a0d-0a47-5924-a45a-6ae72b37f737" :question/math-academy-id "q-78063" :question/problem "If $y=|x+1|$, what are the coordinates of the minimum point on the graph?" :question/worked-solution "Remember that $y=|x-a|$ is a horizontal translation of the absolute value graph $y=|x|$ by $a$ units right.\n\nThe function $y=|x+1|$ has $a=-1.$ Therefore, it is a horizontal translation of the absolute value graph $y=|x|$ by $1$ unit left.\n\n![](images/38/38532ccdd10c7a60f26fdf35c837376af799d7b024370e8b223cd61b7b18eb9d.png)\n\nLooking at the graph, we can see that the coordinates of the minimum point are $(-1,0).$"} :step/id #uuid "9272e140-eade-50e0-aa74-a463e9e7aca4" :step/next {:db/id #edb/ref 17592186570857}} {:db/id #edb/ref 17592186570844 :step/content {:db/id #edb/ref 17592186570741 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d75859b-74a6-5c31-b94d-cfb3fec63748" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-5,0)" :db/id #edb/ref 17592186570202} {:answer/id #uuid "53d0ffba-e11b-5c18-a494-dc8db0e90b44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,0)" :db/id #edb/ref 17592186570272} {:answer/id #uuid "7df37ea3-f56a-521e-9c32-559774529837" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,-5)" :db/id #edb/ref 17592186570346} {:answer/id #uuid "96e0d1b5-5c60-5283-a61c-715d74c22923" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,5)" :db/id #edb/ref 17592186570388} {:answer/id #uuid "ca1bc01f-1907-59c5-ae47-53cddb450003" :answer/type {: