/id #edb/ref 17592186489226} {:db/id #edb/ref 17592186489242} {:db/id #edb/ref 17592186490278} {:db/id #edb/ref 17592186490322} {:db/id #edb/ref 17592186508089}] :knowledge-point/title "Identifying the Range of a Piecewise Function"} :step/id #uuid "849d9b18-604f-5277-ad59-023540eb2af9" :step/math-academy-id 192948}] :activity/title "The Range of a Function: Advanced Cases" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179878}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186488300} :activity/id #uuid "8306db39-3e98-5063-b2e6-7356607f65e1" :activity/scope {:db/id #edb/ref 17592186050580 :topic/id #uuid "557f8b58-be49-555e-8162-3d1448eaff0c" :topic/math-academy-id 3728} :activity/steps [{:db/id #edb/ref 17592186488300 :step/content {:db/id #edb/ref 17592186488269 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10ea4a4a-6af7-53e3-a2da-4e9270ae9e01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-2,1]\\cup [2,4)" :db/id #edb/ref 17592186487597} {:answer/id #uuid "26f9270d-7428-5041-b676-2ee3659c97b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-2,4)" :db/id #edb/ref 17592186487646} {:answer/id #uuid "6fd394ee-b057-5379-9a1b-d34d572d1ec8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-2,4)" :db/id #edb/ref 17592186487788} {:answer/id #uuid "c054f2cd-383f-5029-9555-38cd2116b746" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-2,1)\\cup [2,4)" :db/id #edb/ref 17592186487929} {:answer/id #uuid "e1002e66-6e75-53b6-9e3d-dc25f3c7a1fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-2,4]" :db/id #edb/ref 17592186487996}] :answer-field/correct {:db/id #edb/ref 17592186487929} :answer-field/id #uuid "d6134758-b46e-5c42-a114-442ec1a2403f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186488154}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d9cb8bb3-9f8a-56a1-975b-7665fdd7f9a0" :question/math-academy-id "q-129499" :question/problem "![](images/38/3812ff158f2268f78bbc22cc0fa11f86fd8506a78ce05104df04fef1fe39d037.png)\n\nWhat is the range of the function $f(x),$ shown above?" :question/worked-solution "We find the ranges of the individual pieces, and then calculate their union:\n\n- The range of the branch defined on $x\\in (-4,-2)$ is $(-2,1)$\n\n- The range of the branch defined on $x\\in [2,4)$ is $[2,4)$\n\nTherefore, the range of $f(x)$ is $(-2,1)\\cup [2,4).$\n\n**Note:** From the graph, we see that the values $y=-2,$ $y=1$ and $y=4$ are NOT valid outputs of the function $y=f(x).$ Therefore, we use parentheses $(…)$ instead of brackets $[…]$ at these endpoints."} :step/id #uuid "40697110-9e45-55db-9be6-4b07b907e38a" :step/next {:db/id #edb/ref 17592186488339}} {:db/id #edb/ref 17592186488303 :step/content {:db/id #edb/ref 17592186488185 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17813372-0022-5522-af1c-fab6020b80fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186487617}] :answer-field/correct {:db/id #edb/ref 17592186487617} :answer-field/id #uuid "694c12d7-35b7-50b7-a57a-c8771900c109" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186488090} {:answer-field/choices [{:answer/id #uuid "fdf40489-c386-5ad4-99e1-9b5fa7eb9d8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186488043}] :answer-field/correct {:db/id #edb/ref 17592186488043} :answer-field/id #uuid "9398e924-c066-58e8-b0dd-14445e79a0b1" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186488114} {:answer-field/choices [{:answer/id #uuid "88549f65-3136-52ea-9c3a-7cc1ab54d8ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186487827}] :answer-field/correct {:db/id #edb/ref 17592186487827} :answer-field/id #uuid "f3182c8f-3c10-5274-b0bc-3a0bd8c926f3" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186488169}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "117f6ecc-4203-5323-8f20-261b6a681a27" :question/math-academy-id "q-236721" :question/problem "![](images/df/dff5e6055378143e81d4771d8beeb21e2b9b287b6fb630779885a1bce288d77d.png)\n\nWhat is the range of the function $f(x),$ shown above?\n\nThe range is \n{{field-1}}{{field-2}}\n$f(x)<$\n{{field-3}}." :question/worked-solution "We find the ranges of the individual pieces and then calculate their union:\n\n- The range of the branch defined on $x\\in (-3,-1)$ is $(-3,-1)$\n\n- The range of the branch defined on $x\\in [-1,3)$ is $[-2,2)$\n\nTherefore, the range of $f(x)$ is $(-3,-1)\\cup [-2,2)=(-3,2),$ which can also be written as \n\n$$\n-3<f(x)<2.\n$$\n\n**Note:** From the graph, we see that the values $y=-3$ and $y=2$ are NOT valid outputs of the function $y=f(x).$ Therefore, we use \"less than\" $(<)$ instead of \"less than or equal to\" $(\\le )$ at these endpoints."} :step/id #uuid "4ef4868a-bee6-5ee8-af14-3583672658a7"} {:db/id #edb/ref 17592186488309 :step/content {:db/id #edb/ref 17592186488219 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21dd6e14-5383-55cc-8778-fcb55c7e3f15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\infty" :db/id #edb/ref 17592186487639}] :answer-field/correct {:db/id #edb/ref 17592186487639} :answer-field/id #uuid "071a882c-1715-5b85-843f-a8a7f6c4e013" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186488056} {:answer-field/choices [{:answer/id #uuid "953aa3c7-d4a2-555a-8836-e8d648a99b6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186487847}] :answer-field/correct {:db/id #edb/ref 17592186487847} :answer-field/id #uuid "4f7c168b-0c23-5b91-84ac-a2b54ac765c3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186488080} {:answer-field/choices [{:answer/id #uuid "fa7c657d-fa96-531c-9c31-c9baeb8c5149" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186488035}] :answer-field/correct {:db/id #edb/ref 17592186488035} :answer-field/id #uuid "a842b6b2-34f6-55fe-9267-080b75e9b770" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186488123}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "68f16f52-3b3f-54c0-8129-b8dd5925efc4" :question/math-academy-id "q-236385" :question/problem "![](images/a4/a4b653263aa47cfeecceeda20adfe5851b81d0a7c4fc6457ef87f45ea65ca27d.png)\n\nWhat is the range of the function $f(x),$ shown above?\n\nThe range is \n{{field-1}}\n$<f(x)$\n{{field-2}}{{field-3}}." :question/worked-solution "First, we find the smallest and largest $y$-values in the graph.\n\n- The smallest $y$-value is $0.$ This occurs when $x\\to \\infty .$ However, note  that this point is not included in the graph.\n\n- There is no largest $y$-value.\n\nThe function covers all the $y$-values between $0$ and $\\infty ,$ but not including $0.$\n\nTherefore, the range is $0<y<\\infty ,$ which can also be written as \n$0<f(x)<\\infty .$"} :step/id #uuid "6611bc85-d953-563e-85e8-d62dff8c725c" :step/next {:db/id #edb/ref 17592186488329}} {:db/id #edb/ref 17592186488329 :step/content {:db/id #edb/ref 17592186488275 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2ecbaae-0b74-5f3e-ba28-4c9b99e7ab6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le" :db/id #edb/ref 17592186487968}] :answer-field/correct {:db/id #edb/ref 17592186487968} :answer-field/id #uuid "0310b7f7-fce3-5481-b2a1-2c3a2be1c6d9" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186488053} {:answer-field/choices [{:answer/id #uuid "706fe481-c6a1-51cd-a428-f0aab0b63636" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186487791}] :answer-field/correct {:db/id #edb/ref 17592186487791} :answer-field/id #uuid "0d5af0e8-6f2f-52d3-9829-6e69a00a9674" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186488058} {:answer-field/choices [{:answer/id #uuid "a8229625-57aa-55e5-82a8-9b3cff6b9ed2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\infty" :db/id #edb/ref 17592186487884}] :answer-field/correct {:db/id #edb/ref 17592186487884} :answer-field/id #uuid "1538a00e-7bb6-5483-bce6-eb783fbd88b4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186488062}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e22474d8-8407-520c-b16d-2ce97d2431d2" :question/math-academy-id "q-236460" :question/problem "![](images/6a/6a3822492b4d8fda25ad48a7edd44cf82209857f7a1d67997ff691a770264afb.png)\n\nWhat is the range of the function $f(x),$ shown above?\n\nThe range is \n{{field-1}}\n$<f(x)$\n{{field-2}}{{field-3}}." :question/worked-solution "First, we find the smallest and largest $y$-values in the graph.\n\n- There is no smallest $y$-value.\n\n- The largest $y$-value is $3.$ This occurs when $x=0.$\n\nThe function covers all the $y$-values between $-\\infty $ and $3,$ including $3.$\n\nTherefore, the range is $-\\infty <y\\le 3,$ which can also be written as  $-\\infty <f(x)\\le 3.$"} :step/id #uuid "b83b940c-4e3f-57f0-9f7e-eb02d0534548" :step/next {:db/id #edb/ref 17592186488303}} {:db/id #edb/ref 17592186488339 :step/content {:db/id #edb/ref 17592186488214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c81f06b3-793d-5bee-a0df-270cca11e13d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186487949}] :answer-field/correct {:db/id #edb/ref 17592186487949