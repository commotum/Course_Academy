 #edb/ref 17592186045417] [17592186114133 #edb/ref 1079 #uuid "a32a33fa-fb7f-52f5-a0c8-9f50caf27e8d" #edb/ref 17592186045417] [17592186114134 #edb/ref 1080 "The car increases its value by $85%$ each year" #edb/ref 17592186045417] [17592186114134 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186114134 #edb/ref 1083 #uuid "9131f976-07ea-52cc-9cba-99a846e52f02" #edb/ref 17592186045417] [17592186114135 #edb/ref 1080 "The car increases its value by $15%$ each year" #edb/ref 17592186045417] [17592186114135 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186114135 #edb/ref 1083 #uuid "fbde3adb-07da-5f3e-9471-c7c404c031e0" #edb/ref 17592186045417] [17592186114136 #edb/ref 1080 "The value of the car depreciates by $15%$ each year" #edb/ref 17592186045417] [17592186114136 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186114136 #edb/ref 1083 #uuid "15751958-c03e-595e-bf69-e4c3ce7d40fd" #edb/ref 17592186045417] [17592186114137 #edb/ref 1080 "The value of the car depreciates by $85%$ each year" #edb/ref 17592186045417] [17592186114137 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186114137 #edb/ref 1083 #uuid "16c7b050-fa51-5bed-8e60-38696acb397a" #edb/ref 17592186045417] [17592186114145 #edb/ref 1075 #edb/ref 17592186114146 #edb/ref 17592186045417] [17592186114145 #edb/ref 1075 #edb/ref 17592186114147 #edb/ref 17592186045417] [17592186114145 #edb/ref 1075 #edb/ref 17592186114148 #edb/ref 17592186045417] [17592186114145 #edb/ref 1075 #edb/ref 17592186114149 #edb/ref 17592186045417] [17592186114145 #edb/ref 1075 #edb/ref 17592186114150 #edb/ref 17592186045417] [17592186114145 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186114145 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186114145 #edb/ref 1078 #edb/ref 17592186114149 #edb/ref 17592186045417] [17592186114145 #edb/ref 1079 #uuid "dc1f24b2-6672-5293-99ef-07e0e6f5b77d" #edb/ref 17592186045417] [17592186114