#{[{:db/id #edb/ref 17592186572136 :knowledge-point/_questions [{:db/id #edb/ref 17592186064241 :knowledge-point/id #uuid "7ff8de23-e4f2-51e1-9390-78ff7edd2176" :knowledge-point/title "Multiplying Binomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c2f45df-4f60-5116-9efa-d662af1cd213" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{2}+2z-35" :db/id #edb/ref 17592186571561} {:answer/id #uuid "158f13cf-06f8-5671-9ba0-7b986831fb4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{2}+12z-35" :db/id #edb/ref 17592186571577} {:answer/id #uuid "6bdc5840-c168-54a5-bc38-c99449256be6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{2}-2z-2" :db/id #edb/ref 17592186571721} {:answer/id #uuid "87b22d66-eea0-50cf-81b1-912e9e1f8a95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{2}-12z-35" :db/id #edb/ref 17592186571772} {:answer/id #uuid "bc41fd89-5484-57c0-aaf5-755da3cd1786" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{2}-2z-35" :db/id #edb/ref 17592186571875}] :answer-field/correct {:answer/id #uuid "bc41fd89-5484-57c0-aaf5-755da3cd1786" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{2}-2z-35" :db/id #edb/ref 17592186571875} :answer-field/id #uuid "8895b1d9-28a9-54aa-a012-08481cc5a266" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572044}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5fbbc181-ab02-53e1-a097-fa8b9ef68cb3" :question/math-academy-id "q-111297" :question/problem "$(z-7)(z+5)=$" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(z-7)(z+5) & = \\\\ z(z+5)+(-7)(z+5) & = \\\\ {z}^{2}+5z-7z-35 & = \\\\ {z}^{2}-2z-35\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186572135 :knowledge-point/_questions [{:db/id #edb/ref 17592186096654 :knowledge-point/id #uuid "711d0e70-a248-5f93-a836-43bed5435d4f" :knowledge-point/title "Subtracting Two Vectors Using the Triangle Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "041468a9-cf21-5f7e-870b-5a70bcb988f5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3b/3b4ff1b6fa118dfaac221f1476d77069eb1229234652ec85dc12f14a862375c7.png" :db/id #edb/ref 17592186571546} {:answer/id #uuid "35846370-d20b-53e2-a3fc-fa0109554dab" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/71/71db33914d9122aa3bdbf8d3b4b28fcdd778696decefd5e8c0b4c481756b2b11.png" :db/id #edb/ref 17592186571630} {:answer/id #uuid "68271c55-10f5-5b4f-afc4-a12228948e82" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/44/44d7651e8baa950d172e8a502c92f03e0c1ac438ef610afd6668b1175f92988e.png" :db/id #edb/ref 17592186571717} {:answer/id #uuid "bacd973a-9428-58e0-a74c-7ac39528c9fa" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/44/44529c3aea1f99d3912804acd7e8824d9a439c14d3acf5af12b6f3438a48857b.png" :db/id #edb/ref 17592186571870} {:answer/id #uuid "cb31bce9-73a4-5d79-9120-0206297e41db" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1b/1bb5d8591881b77b40603a15aa65757e6ef8c298bfcc0d4c4be7a8c58b3a964d.png" :db/id #edb/ref 17592186571902}] :answer-field/correct {:answer/id #uuid "68271c55-10f5-5b4f-afc4-a12228948e82" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/44/44d7651e8baa950d172e8a502c92f03e0c1ac438ef610afd6668b1175f92988e.png" :db/id #edb/ref 17592186571717} :answer-field/id #uuid "308eec90-1c41-5a84-8f26-1e6606284fb0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572001}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "59df03f5-b0de-547f-a369-251d1939cc3e" :question/math-academy-id "q-118542" :question/problem "![](images/b6/b604de78802c70f2fa5960de7560b6adde1b4e72153aa92e22411507ef70320f.png)\n\nThe vectors $\\text{a}$ and $\\text{b}$ are shown in the diagram above. Which of the following could be $-a+b?$" :question/worked-solution "We interpret  $-a+b$ as the addition\n\n$$\n(-a)+b,\n$$\n\nwhere $-a$ is the vector that has the same magnitude as $a$ but goes in the direction *opposite* of $a.$\n\nFinally, we use the triangle law to add the vectors $-a$ and $b:$ \n\n- We can start $-a$ from an arbitrary point on the plane.\n\n- Next, we draw the vector that is equal to $b$ and has its tail placed at the head of $-a.$\n\n- Now, according to the triangle law of addition, the resultant is the vector that goes from the tail of $-\\text{a}$ to the head of $\\text{b}$, as shown below.\n\n![](images/7e/7ed9a5ed605856d8c81976951711a3a5d2561ca1874843e8a618972151acf3c2.png)"}] [{:db/id #edb/ref 17592186572197 :knowledge-point/_questions [{:db/id #edb/ref 17592186179818 :knowledge-point/id #uuid "b5406de3-483e-56c2-b9c6-73de6769552e" :knowledge-point/title "Calculating an Amount Given a Ratio as a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fbec65e-4c97-5e61-9acb-24af080e5eeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186571618} {:answer/id #uuid "41a24730-0924-54c5-b93a-650e04790c3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186571658} {:answer/id #uuid "afc9851c-7bc0-506b-bdf8-1daa2b0b0a7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186571844} {:answer/id #uuid "b6d7b07c-302c-52a1-8443-43d9662e863a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186571862} {:answer/id #uuid "fff22f55-63b9-500f-8956-b3769e696344" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186571981}] :answer-field/correct {:answer/id #uuid "2fbec65e-4c97-5e61-9acb-24af080e5eeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186571618} :answer-field/id #uuid "a9aea0b5-d43b-5bdb-a917-a638e0240307" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572059}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f004f03a-3145-589b-b783-dc999853f011" :question/math-academy-id "q-147067" :question/problem "Jane writes down a $28$ digit number, where $\\frac{3}{7}$ of the digits are odd. How many even digits are in the number?" :question/worked-solution "We are given that the ratio of odd digits to the total number of digits is $\\frac{3}{7}.$ \n\nIn this fraction, the numerator represents the number of odd digits, and the denominator represents the total number of digits.\n\nWe can make a denominator of $28$ by multiplying the numerator and denominator by $4:$\n\n$$\n\\frac{3\\times 4}{7\\times 4}=\\frac{12}{28}\n$$\n\nTherefore, there are $12$ odd digits in the number. \nSo, the number of even digits is\n\n$$\n28-12=16.\n$$"}] [{:db/id #edb/ref 17592186572182 :knowledge-point/_questions [{:db/id #edb/ref 17592186175896 :knowledge-point/id #uuid "c1941876-94d1-52d5-9104-7875de691ca0" :knowledge-point/title "Identifying Parts of a Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d7e3d12-0f1f-532d-8700-05d55527e6cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The chord $\\overset{―}{OB}$" :db/id #edb/ref 17592186571652} {:answer/id #uuid "49b8e864-867a-5333-b950-2c7e67fb4f5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The radius $\\overset{―}{AB}$" :db/id #edb/ref 17592186571670} {:answer/id #uuid "56f72342-cf15-51b6-aed5-6e8719b0fe6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circular sector $OAB$" :db/id #edb/ref 17592186571692} {:answer/id #uuid "660b9c4b-d1fe-5f25-9744-8975e0502fef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circular segment $AOB$" :db/id #edb/ref 17592186571713} {:answer/id #uuid "b1119c95-f46c-5a27-8327-679e10b99b56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The diameter $\\overset{―}{OA}$" :db/id #edb/ref 17592186571847}] :answer-field/correct {:answer/id #uuid "56f72342-cf15-51b6-aed5-6e8719b0fe6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circular sector $OAB$" :db/id #edb/ref 17592186571692} :answer-field/id #uuid "781739ff-eeb3-53a7-b3a9-b7f68ce8cd9f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572036}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2ee3b0e-faf8-58c6-aa1f-4a103b69243b" :question/math-academy-id "q-21137" :question/problem "![](images/f5/f58bf69e5449710785053d04ccec129bd6ed51c67b29ad8701c0b66e842897c0.png)\n\nWhat element of the circle is depicted in the diagram above?" :question/worked-solution "The region shown in the diagram is bounded by the arc $\\overset{⌢}{AB}$ of the circle and the radii $\\overset{―}{OA}$ and $\\overset{―}{OB}.$ So, this region represents the circular sector $OAB.$"}] [{:db/id #edb/ref 17592186572189 :knowledge-point/_questions [{:db/id #edb/ref 17592186083189 :knowledge-point/id #uuid "61ec00a6-06ae-5d78-bb1a-b06351432cc3" :knowledge-point/title "Graphing a Vertical Translation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a9f19db-d214-580f-b288-bef9f51d4425" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|x|+6" :db/id #edb/ref 17592186571609}] :answer-field/correct {:answer/id #uuid "2a9f19db-d214-580f-b288-bef9f51d4425" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|x|+6" :db/id #edb/ref 17592186571609} :answer-field/id #uuid "b0554f1a-a77c-5836-a872-5ce671a63c4b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572062}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "df7c4c47-80d6-5201-b456-75a42c3c1fbc" :question/math-academy-id "q-222327" :question/problem "![](images/d8/d87a618227b9f71d205080ca18321b988c0aae321ac382ace14ba3c42cb640a5.png)\n\nThe graph above shows the image of the graph $y=|x|$ under the action of a single translation. What is the equation of this curve?\n\nThe equation of this curve is $y=$\n{{field-1}}." :question/worked-solution "Remember that $y=|x|+a$ is a vertical translation of the absolute value graph $y=|x|$ by $a$ units up.\n\nHere, the graph is moved up by $6$ units. This corresponds to $a=6.$ \n\nTherefore, the equation of the curve is $y=|x|+6.$\n\n![](images/91/9175449249193509c2cfd0717004516d51f15811391d3e056d552166df6da8b1.png)"}] [{:db/id #edb/ref 17592186489211 :knowledge-point/_questions [{:db/id #edb/ref 17592186179651 :knowledge-point/id #uuid "6df7104d-0f74-5301-9525-132c74c19ca9" :knowledge-point/title "Identifying the Range of a Function by Considering Its End Behavior"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53d33833-5d73-5cd1-aaa3-ebbde8ba8d94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186488630}] :answer-field/correct {:answer/id #uuid "53d33833-5d73-5cd1-aaa3-ebbde8ba8d94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186488630} :answer-field/id #uuid "230144b7-3e1c-5d00-a4ef-98175b07993a" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186489039} {:answer-field/choices [{:answer/id #uuid "17ad29ad-17ec-5062-a971-d2e903f99dea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186488521}] :answer-field/correct {:answer/id #uuid "17ad29ad-17ec-5062-a971-d2e903f99dea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186488521} :answer-field/id #uuid "24135b41-8d9b-5bb6-b1a6-3b7dacf56dbb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186489040} {:answer-field/choices [{:answer/id #uuid "5d6d2512-b6ad-5e4c-a557-45ccf9fd3ebb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186488650}] :answer-field/correct {:answer/id #uuid "5d6d2512-b6ad-5e4c-a557-45ccf9fd3ebb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186488650} :answer-field/id #uuid "a54f849e-6d30-5e86-8655-07915a3cbd2f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186489107}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "49c672a2-d467-5f34-bcf7-e5d722eb09ca" :question/math-academy-id "q-235999" :question/problem "![](images/ac/acf26785a0591659fb6c2d9ef906614f8c282a31fcf6e06d1718477c4c6aba38.png)\n\nWhat is the range of the function $f(x),$ shown above?\n\nThe range is \n{{field-1}}\n$<f(x)$\n{{field-2}}{{field-3}}." :question/worked-solution "First, we find the smallest and largest $y$-values in the graph.\n\n- The smallest $y$-value is $-1.$ This occurs when $x\\to \\infty .$ However, note that this point is not included in the graph.\n\n- The largest $y$-value is $3.$ This occurs when $x\\to -\\infty .$ However, note that this point is not included in the graph.\n\nThe function covers all the $y$-values between $-1$ and $3,$ not including $-1$ and $3.$\n\nTherefore, the range is $-1<y<3,$ which can also be written as $-1<f(x)<3.$"}] [{:db/id #edb/ref 17592186572195 :knowledge-point/_questions [{:db/id #edb/ref 17592186138432 :knowledge-point/id #uuid "01db3ebe-66ec-5340-8e29-c99fb149f5da" :knowledge-point/title "Modeling Direct Variations With Second Powers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8dce6baa-40e1-5594-abda-aafce3c56365" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186571785}] :answer-field/correct {:answer/id #uuid "8dce6baa-40e1-5594-abda-aafce3c56365" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186571785} :answer-field/id #uuid "730fb550-7a51-52ad-b041-ee4242e1e5f2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572033}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "eb47fc03-5b60-58b0-9d3f-f700dc615259" :question/math-academy-id "q-237175" :question/problem "The kinetic energy $K$ of a non-rotating object, measured in joules ($\\text{J}$), varies directly with the **square** of the object velocity $v,$ measured in meters per second ($\\text{m/s}$). If $K=100\\,\\text{J}$ when the velocity is $v=5\\,\\text{m/s},$ then what is the constant of variation? You do not need to state the units.\n\nThe constant of variation is\n{{field-1}}." :question/worked-solution "The kinetic energy $K$ is directly proportional to the square of the velocity $v.$ So, we have\n\n$$\nK=k{v}^{2},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that $K=100\\,\\text{J}$ when $v=5\\,\\text{m/s}.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}100 & =k\\cdot {5}^{2} \\\\ 100 & =k\\cdot 25 \\\\ \\frac{100}{25} & =k \\\\ 4 & =k\\end{aligned}\n$$\n\nTherefore, the constant of variation is $4.$"}] [{:db/id #edb/ref 17592186572169 :knowledge-point/_questions [{:db/id #edb/ref 17592186179763 :knowledge-point/id #uuid "477301de-0888-5f46-84cc-5b2939516e7b" :knowledge-point/title "Simplifying Expressions Containing Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d149dcf-bc00-5039-ad6d-3e55cf380535" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186571615} {:answer/id #uuid "47481b34-eee7-5c53-a851-a0d02c6f04d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt[3]{xy}-24\\sqrt{xy}" :db/id #edb/ref 17592186571666} {:answer/id #uuid "835be230-c641-55e2-9c48-887dbccaded2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt[3]{xy}-2\\sqrt{xy}" :db/id #edb/ref 17592186571763} {:answer/id #uuid "9d3c2885-add8-5d0b-940c-e52b3aeada68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt[3]{xy}+2\\sqrt{xy}" :db/id #edb/ref 17592186571811} {:answer/id #uuid "d96f079d-bb01-5b16-9e68-54a60c3c5d79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt[3]{xy}+2|x|\\sqrt{y}" :db/id #edb/ref 17592186571931}] :answer-field/correct {:answer/id #uuid "9d3c2885-add8-5d0b-940c-e52b3aeada68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt[3]{xy}+2\\sqrt{xy}" :db/id #edb/ref 17592186571811} :answer-field/id #uuid "49b5efc9-5d97-504a-9727-7f1b6b2050e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572016}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b56a30ba-e6cb-544a-bbd5-8a6dcd830acc" :question/math-academy-id "q-34204" :question/problem "Simplify $-2\\sqrt[3]{xy}-4\\sqrt{xy}+6\\sqrt{xy}.$" :question/worked-solution "We can combine the two $\\sqrt{xy}$ terms together, but we cannot combine $\\sqrt{xy}$ and $\\sqrt[3]{xy}$ term:\n\n$$\n\\begin{aligned}-2\\sqrt[3]{xy}-4\\sqrt{xy}+6\\sqrt{xy} & = \\\\ -2\\sqrt[3]{xy}+(-4+6)\\sqrt{xy} & = \\\\ -2\\sqrt[3]{xy}+2\\sqrt{xy} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115865 :knowledge-point/_questions [{:db/id #edb/ref 17592186115384 :knowledge-point/id #uuid "cd0f5949-6a1a-5187-a246-8f9bac2e8d58" :knowledge-point/title "Interpreting a Decay Rate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea7ced4d-d092-5e8a-8bb7-9d8a84776b0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The car's market value increases by $90%$ every year." :db/id #edb/ref 17592186114128} {:answer/id #uuid "fcb1b099-cdaa-53a1-930d-d02676568096" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The car loses $90%$ of its market value every year." :db/id #edb/ref 17592186114129} {:answer/id #uuid "18875869-1bce-592e-aeee-7828c83cae3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The car's market value increases by $10%$ every year." :db/id #edb/ref 17592186114130} {:answer/id #uuid "29313382-ff48-537f-85eb-3b5948ce765e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The initial value of the car was $$900$." :db/id #edb/ref 17592186114131} {:answer/id #uuid "6f240cff-4783-5ef7-97d4-ddd0f6ad3ccc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The car loses $10%$ of its market value every year." :db/id #edb/ref 17592186114132}] :answer-field/id #uuid "1514e5e5-98af-5984-804b-835f796c778c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186114127}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6b0edb44-4f65-5f8c-b3b9-8d9238dbd7ef" :question/math-academy-id "q-45418" :question/problem "The market value of a car, in dollars, is given by the expression $8000 \\cdot (0.9)^{t}$, where $t$ is the number of years since the car was produced. What does the base of the exponential expression $(0.9)$ mean in this context?"}] [{:db/id #edb/ref 17592186572177 :knowledge-point/_questions [{:db/id #edb/ref 17592186105718 :knowledge-point/id #uuid "bad93a16-17d4-50ff-89c8-f3d966df5f1a" :knowledge-point/title "Finding Unknown Quantities in Quadrilaterals and Pentagons"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2607a663-da9f-5de2-9879-917d0ec70427" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{210}^{∘}" :db/id #edb/ref 17592186571603} {:answer/id #uuid "6c4865a8-40bd-5c4b-973b-ff850e95c59c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{190}^{∘}" :db/id #edb/ref 17592186571723} {:answer/id #uuid "91243bcc-d017-512f-955f-e2739cb6bb3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{220}^{∘}" :db/id #edb/ref 17592186571792} {:answer/id #uuid "aca15a68-8b8f-5a62-ac46-cb86056d745f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{200}^{∘}" :db/id #edb/ref 17592186571832} {:answer/id #uuid "c20db42e-0a88-5016-9744-2f0ea9af0af3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{230}^{∘}" :db/id #edb/ref 17592186571884}] :answer-field/correct {:answer/id #uuid "91243bcc-d017-512f-955f-e2739cb6bb3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{220}^{∘}" :db/id #edb/ref 17592186571792} :answer-field/id #uuid "96e13149-79c3-5a4f-aa08-eb9e3aff70f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572048}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c85d6d2c-7d60-53c2-9293-99f57c859bc7" :question/math-academy-id "q-52934" :question/problem "![](images/76/766f2cc9fe5a205c4eadfa50c6ba87145106efd97db51041aea4629313a8d80f.png)\n\nFind $m∠N$ in the quadrilateral $OMNP$ above." :question/worked-solution "A quadrilateral has $n=4$ sides. Therefore, the sum of the interior angles of a quadrilateral must be \n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={180}^{∘}\\cdot (4-2) \\\\  & ={180}^{∘}\\cdot 2 \\\\  & ={360}^{∘}.\\end{aligned}\n$$\n\nAdding up the internal angles and solving for $m∠N,$ we get\n\n$$\n\\begin{aligned}m∠O+m∠M+m∠N+m∠P & ={360}^{∘} \\\\ {60}^{∘}+{40}^{∘}+m∠N+{40}^{∘} & ={360}^{∘} \\\\ {140}^{∘}+m∠N & ={360}^{∘} \\\\ m∠N & ={220}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186572133 :knowledge-point/_questions [{:db/id #edb/ref 17592186059708 :knowledge-point/id #uuid "c2c24d70-3bde-5277-bc92-ae081065deee" :knowledge-point/title "Solving Rational Equations with a Binomial and a Monomial in Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10a3543e-a251-579f-b8fc-7f9ba24706ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186571566} {:answer/id #uuid "1621b1c6-95e0-5b2c-bd45-64e852812aa9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186571579} {:answer/id #uuid "65daad1e-0611-5bd7-afbf-4fd9443314b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186571712} {:answer/id #uuid "adca5567-c435-5016-bb46-aa649ccb320e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186571836} {:answer/id #uuid "fb02bb4e-edfe-536a-8159-eeaa09da9182" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186571969}] :answer-field/correct {:answer/id #uuid "10a3543e-a251-579f-b8fc-7f9ba24706ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186571566} :answer-field/id #uuid "b35c0d69-6d83-53fa-b5c9-4ab6a701cd32" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572069}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "50efbd3d-db78-53ec-922c-e4529ac97e50" :question/math-academy-id "q-67426" :question/problem "Solve the equation $\\frac{6}{x-5}=\\frac{2}{x}.$" :question/worked-solution "First, we note that\n\n- $x=5$ cannot be a solution since this would make the denominator on the left-hand side zero\n\n- $x=0$ cannot be a solution since this would make the denominator on the right-hand side zero\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\frac{x-5}{6}=\\frac{x}{2}\n$$\n\nNext, we write both fractions using the least common denominator $6.$ The above equation becomes\n\n$$\n\\frac{x-5}{6}=\\frac{3x}{6}\n$$\n\nWe can now solve this equation with the addition and the multiplication principles:\n\n$$\n\\begin{aligned}6\\cdot \\frac{x-5}{6} & =6\\cdot \\frac{3x}{6} \\\\ x-5 & =3x \\\\ x-x-5 & =3x-x \\\\ -5 & =2x \\\\ (\\frac{1}{2})\\cdot (-5) & =(\\frac{1}{2})\\cdot (2x) \\\\ -\\frac{5}{2} & =x\\end{aligned}\n$$\n\nWe conclude that the solution is $x=-\\frac{5}{2}.$"}] [{:db/id #edb/ref 17592186572170 :knowledge-point/_questions [{:db/id #edb/ref 17592186068687 :knowledge-point/id #uuid "b3ff37f0-6e45-5da4-ac87-1b93c8df3e80" :knowledge-point/title "Representing Solutions of Compound Inequalities on Number Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13a0d091-a9f3-50d0-b96d-dfd1f9aa526a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e9/e96737c3e6cc75c33f9365a005a6d550fe85168cb9b4c032c2f06f4d2c7becca.png" :db/id #edb/ref 17592186571574} {:answer/id #uuid "1f53e451-b19f-5c87-879a-846da71677ef" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a8/a8caf5752a9ba55fcfcd28778d940898ef1a6ea01744b14b027cdd387df120e2.png" :db/id #edb/ref 17592186571592} {:answer/id #uuid "4be979ee-1cc5-5bdb-9be8-33f408cbfcda" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a7/a70249a33b29eeec3c36c1077486fecfcdf19eb653973d41d19987be4a80be0a.png" :db/id #edb/ref 17592186571675} {:answer/id #uuid "bfc12d3e-ffd8-5758-a5af-218cc9012abf" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/19/197ac29bb5a8c6644f50c3161c0aafe7411609bd6f13036aee5ccd807bf9f3c0.png" :db/id #edb/ref 17592186571881} {:answer/id #uuid "ed31b874-9890-5253-bc9f-c61d2789699b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7d/7d3d1fb902dec99a88c634990be5b9534bf6378beb2afd0aff3a1c970aa79097.png" :db/id #edb/ref 17592186571955}] :answer-field/correct {:answer/id #uuid "4be979ee-1cc5-5bdb-9be8-33f408cbfcda" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a7/a70249a33b29eeec3c36c1077486fecfcdf19eb653973d41d19987be4a80be0a.png" :db/id #edb/ref 17592186571675} :answer-field/id #uuid "f5de6842-82de-5750-82ca-c06c56c35e1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572099}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b6a1d8df-14fd-58d7-a188-333aa892620d" :question/math-academy-id "q-73877" :question/problem "Which of the following number lines gives the solution to $-1<\\frac{5x+7}{3}\\le 4?$" :question/worked-solution "We isolate $x$ by applying the addition and multiplication principles, as usual.\n\n$$\n\\begin{aligned}-1 & <\\frac{5x+7}{3}\\le 4 \\\\ -1\\cdot 3 & <\\frac{5x+7}{3}\\cdot 3\\le 4\\cdot 3 \\\\ -3 & <5x+7\\le 12 \\\\ -3-7 & <5x+7-7\\le 12-7 \\\\ -10 & <5x\\le 5 \\\\ \\frac{-10}{5} & <\\frac{5x}{5}\\le \\frac{5}{5} \\\\ -2 & <x\\le 1\\end{aligned}\n$$\n\nWe can represent this solution using a number line, as follows.\n\n![](images/a7/a70249a33b29eeec3c36c1077486fecfcdf19eb653973d41d19987be4a80be0a.png)"}]}
