(-12)\\cdot (-1) \\\\  & =12.\\end{aligned}\n$$"} :step/id #uuid "2a300984-ba42-56ba-b359-9a1f873369b3"} {:db/id #edb/ref 17592186543615 :step/content {:db/id #edb/ref 17592186543503 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b547066-5b29-546d-8cd5-74b2bb005d5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12+30\\,\\text{i}" :db/id #edb/ref 17592186542665} {:answer/id #uuid "0ebbfedf-cc4d-5617-919c-fd8b3aaa4d8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12-30\\,\\text{i}" :db/id #edb/ref 17592186542673} {:answer/id #uuid "28d2ad66-3a96-5b91-af9f-1f8a95b92045" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12+21\\,\\text{i}" :db/id #edb/ref 17592186542746} {:answer/id #uuid "9e1c27a1-fc83-51da-9238-863b51cf68a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12+30\\,\\text{i}" :db/id #edb/ref 17592186543057} {:answer/id #uuid "ba47eb89-2c3e-50f5-a576-4e75f6181684" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9-30\\,\\text{i}" :db/id #edb/ref 17592186543128}] :answer-field/correct {:db/id #edb/ref 17592186542665} :answer-field/id #uuid "580c7707-147e-5610-a367-5714a00847a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543345}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "553ad9a0-8f10-59ef-ab22-b325bd3075cb" :question/math-academy-id "q-16297" :question/problem "$(3+7\\,\\text{i})(3+3\\,\\text{i})=$" :question/worked-solution "Multiplying two complex numbers is similar to multiplying two binomials. We also use the fact that ${\\text{i}}^{2}=-1.$\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(3+7\\,\\text{i})(3+3\\,\\text{i}) & =3\\cdot 3+3\\cdot 3\\,\\text{i}+7\\,\\text{i}\\cdot 3+7\\,\\text{i}\\cdot 3\\,\\text{i} \\\\  & =9+9\\,\\text{i}+21\\,\\text{i}+21\\,{\\text{i}}^{2} \\\\  & =9+30\\,\\text{i}+21\\cdot (-1) \\\\  & =9+30\\,\\text{i}-21 \\\\  & =-12+30\\,\\text{i}.\\end{aligned}\n$$"} :step/id #uuid "2dc50eaf-bd5a-5af1-a243-a36243a52db6" :step/next {:db/id #edb/ref 17592186543612}} {:db/id #edb/ref 17592186543664 :step/content {:db/id #edb/ref 17592186543475 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0059d172-90f9-5235-b4b6-a75ec1495e4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-85+15\\,\\text{i}" :db/id #edb/ref 17592186542635} {:answer/id #uuid "019bcb77-6632-5049-bc18-e7872975dbf5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "115+15\\,\\text{i}" :db/id #edb/ref 17592186542640} {:answer/id #uuid "8dbdb540-b9c7-5f11-ada4-b26f705d451f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-95" :db/id #edb/ref 17592186543010} {:answer/id #uuid "d46811a2-7647-5666-89f8-61c884b6aea1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-115" :db/id #edb/ref 17592186543188} {:answer/id #uuid "e79a1e12-010f-589f-8be2-c9f49ab64cec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "117" :db/id #edb/ref 17592186543230}] :answer-field/correct {:db/id #edb/ref 17592186543230} :answer-field/id #uuid "ecefc22e-34e7-5318-982a-11314974e138" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543461}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "079ed9ef-ed52-5aa5-892f-741aff5b9f4c" :question/math-academy-id "q-16296" :question/problem "$(6-9\\,\\text{i})(6+9\\,\\text{i})=$" :question/worked-solution "Multiplying two complex numbers is similar to multiplying two binomials. We also use the fact that ${\\text{i}}^{2}=-1.$\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(6-9\\,\\text{i})(6+9\\,\\text{i}) & =6\\cdot 6+6\\cdot 9\\,\\text{i}+(-9\\,\\text{i})\\cdot 6+(-9\\,\\text{i})\\cdot 9\\,\\text{i} \\\\  & =36+54\\,\\text{i}-54\\,\\text{i}-81\\,{\\text{i}}^{2} \\\\  & =36-81\\cdot (-1) \\\\  & =36+81 \\\\  & =117.\\end{aligned}\n$$"} :step/id #uuid "c9e00008-3