#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186495235} :activity/id #uuid "09d4bb8f-af12-534d-8b4d-e6041622fc03" :activity/scope {:db/id #edb/ref 17592186049061 :topic/id #uuid "d6b26631-d5b7-59f4-92ca-62af4fe95872" :topic/math-academy-id 396} :activity/steps [{:db/id #edb/ref 17592186495186 :step/content {:db/id #edb/ref 17592186495158 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b675aa5-7ca8-5a20-8b98-50a672fad62c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{7}{5}" :db/id #edb/ref 17592186494469} {:answer/id #uuid "6c973c76-cd0c-5576-8885-0c465bab546c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186494541} {:answer/id #uuid "b734c1fc-7b80-5cc1-bb58-37307d83cd9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{5}{7}" :db/id #edb/ref 17592186494745} {:answer/id #uuid "b78ba8a4-7052-5d26-92c7-8724b2179bd5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186494746} {:answer/id #uuid "e729bea2-1620-507c-a9ae-744cc39dcf39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186494865}] :answer-field/correct {:db/id #edb/ref 17592186494745} :answer-field/id #uuid "c796a5cc-7470-555e-8c4a-e7fb39dc2c3e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186495010}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e554ee9f-50e5-5692-8b77-359b451c2bbf" :question/math-academy-id "q-26721" :question/problem "![](images/20/2026a71a7cb647e7a5d844e9c5259f73321d7fd8097255245dc99f87dfc60a92.png)\n\nThe straight line shown above intersects the $y$-axis when $y=5$ and intersects the $x$-axis when $x=7.$ Find its slope." :question/worked-solution "Note that the line passes through the points $(0,5)$ and $(7,0).$ So, we let $({x}_{1},{y}_{1})=(0,5)$ and $({x}_{2},{y}_{2})=(7,0),$ and compute the slope using the formula:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{0-5}{7-0} \\\\  & =\\frac{-5}{7} \\\\  & =-\\frac{5}{7}\\end{aligned}\n$$\n\nTherefore, the slope of the line is $-\\frac{5}{7}.$"} :step/id #uuid "1ee2439e-7d28-5eed-8491-df2f7b1c6696" :step/next {:db/id #edb/ref 17592186495261}} {:db/id #edb/ref 17592186495198 :step/content {:db/id #edb/ref 17592186495084 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "484abde8-3f23-5338-9c82-1f609256f392" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The slope is undefined" :db/id #edb/ref 17592186494464} {:answer/id #uuid "a94896a9-afbd-5dcf-897e-6e39774c9d93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186494708} {:answer/id #uuid "af8582df-e76d-5bc1-866b-413a649a9aa1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186494726} {:answer/id #uuid "cd105698-8a3d-5869-9c58-5a3942269556" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186494802} {:answer/id #uuid "d715396f-441d-5f1d-866c-9fd33dcca6d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186494825}] :answer-field/correct {:db/id #edb/ref 17592186494464} :answer-field/id #uuid "3628f8b5-c830-5168-a45d-4e97b7e4df21" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494938}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4e8669dc-08f6-5619-b2c9-0ec5b114ec63" :question/math-academy-id "q-44165" :question/problem "![](images/d4/d459697b7a62f75b89093ab5d12ec9b2087f4d4854cbb91ad7fffab8d13a02d1.png)\n\nFind the slope of the line shown above." :question/worked-solution "The slope of the vertical line is undefined. We can see this by choosing two points on the line, such as $(-1,0)$ and $(-1,1),$ and computing the slope between them:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{1-0}{-1-(-1)}=\\frac{1-0}{-1+1}=\\frac{1}{0}=\\text{undefined}\\end{aligned}\n$$"} :step/id #uuid "37d7d0a6-9a6c-5c70-b5b2-dd15dea2c00a" :step/next {:db/id #edb/ref 17592186495208}} {:db/id #edb/ref 17592186495208 :step/content {:db/id #edb/ref 17592186495119 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18c4c7ec-5083-5460-99fa-85cb717da0d7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Not enough information" :db/id #edb/ref 17592186494367} {:answer/id #uuid "847d5534-9a07-591e-8c65-030a30cdf269" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Positive" :db/id #edb/ref 17592186494610} {:answer/id #uuid "a7e924e6-94bb-598a-91c2-4fb36c4c10ad" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Zero" :db/id #edb/ref 17592186494704} {:answer/id #uuid "bf0dc2fd-800b-5cc0-abd4-015b13c25b9b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Negative" :db/id #edb/ref 17592186494767} {:answer/id #uuid "e062f903-0c5a-5932-92b5-ed51805f36a6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Undefined" :db/id #edb/ref 17592186494849}] :answer-field/correct {:db/id #edb/ref 17592186494610} :answer-field/id #uuid "02ad41b4-5643-5fdd-94bb-5143aa556000" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494919}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a3f99f18-7d73-54ee-9fa8-4712411f913a" :question/math-academy-id "q-109447" :question/problem "![](images/93/939cada46a127b1b8ea90a3f2daf643974b1ba31a8f6c88230d8d4ca0e43e5d3.png)\n\nWhich of the following best describes the slope of the graph above?" :question/worked-solution "Remember that slope is the amount the line rises vertically per unit that it runs horizontally.\n\nSince the graph increases ($↗$) as we go from left to right, the line rises by a positive amount.\n\nTherefore, the slope of the line is positive."} :step/id #uuid "68a65e47-dfc9-516a-8d1c-a0762f44a9ea"} {:db/id #edb/ref 17592186495235 :step/content {:db/id #edb/ref 17592186495128 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d057346-e893-5b56-91c9-02634ef0bcb7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Zero" :db/id #edb/ref 17592186494445} {:answer/id #uuid "882f8417-b97a-55e7-b84a-177f0eeb323f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Positive" :db/id #edb/ref 17592186494620} {:answer/id #uuid "a3055d8e-02f8-5c6b-9d08-3e0f1c8c247c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Not enough information" :db/id #edb/ref 17592186494689} {:answer/id #uuid "e42a8251-dec1-5e57-810b-6a64baa82cce" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Negative" :db/id #edb/ref 17592186494863} {:answer/id #uuid "e7e48cab-a94e-569b-b463-524076435452" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Undefined" :db/id #edb/ref 17592186494869}] :answer-field/correct {:db/id #edb/ref 17592186494863} :answer-field/id #uuid "845d3982-0f38-5a31-810f-b6e038ecbee7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494979}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b0e9e07f-b858-555b-898c-02f94b1a944b" :question/math-academy-id "q-7360" :question/problem "![](images/76/76cd6a4f07d424a3ce8ae6d2f939e52f5aa2fc66331f671c4b926b1ee5fdae8c.png)\n\nWhich of the following best describes the slope of the graph above?" :question/worked-solution "Remember that slope is the amount the line rises vertically per unit that it runs horizontally.\n\nSince the graph decreases ($↘$) as we go from left to right, the line rises by a negative amount.\n\nTherefore, the slope of the line is negative."} :step/id #uuid "a6d81c12-5c8e-549b-b250-a6e8619ef300" :step/next {:db/id #edb/ref 17592186495186}} {:db/id #edb/ref 17592186495261 :step/content 