#{[{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186419008} :activity/id #uuid "71036dcd-e882-527a-9681-dd5cc25371dc" :activity/scope {:db/id #edb/ref 17592186049064 :topic/id #uuid "d6e3ec39-fd1a-5be7-9200-cb1c6c27e338" :topic/math-academy-id 3835} :activity/steps [{:db/id #edb/ref 17592186419008 :step/content {:db/id #edb/ref 17592186184764 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54174a8e-4b9f-5398-9c3e-042309cf5af7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\text{A1}$, $\\text{A3}$" :db/id #edb/ref 17592186418998} {:answer/id #uuid "7c55b42e-8e25-5d4a-9c6c-fb23853f6637" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\text{A4}$, $\\text{A3}$" :db/id #edb/ref 17592186419001} {:answer/id #uuid "923e4cd4-7cb7-513f-a013-6b459182a21c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\text{A5}$, $\\text{A4}$" :db/id #edb/ref 17592186419002} {:answer/id #uuid "c5a112ad-76a7-5358-b6fe-7be7dc9072ca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\text{A3}$, $\\text{A4}$" :db/id #edb/ref 17592186419003} {:answer/id #uuid "edaa960c-9666-5ef7-ae8f-8608f1b827e8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\text{A1}$, $\\text{A2}$" :db/id #edb/ref 17592186419004}] :answer-field/correct {:db/id #edb/ref 17592186418998} :answer-field/id #uuid "90535267-04a3-5209-88fc-9a5564318779" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186183193}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "19147c4b-722c-5ed5-9d91-8a4847b759ae" :question/math-academy-id "q-35626" :question/problem "From top to bottom, fill in the blanks and hence complete the proof of the following statement using the axioms $[\\text{A}1]-[\\text{A}8]$ given below.\n\n*Statement:*\n\n*If $w$ is a vector such that $x+w=x$ for some $x\\in V$, then $w=0.$*\n\n*Proof:*\n\n$$\n\\begin{aligned}x+w & =x &  & [\\,\\text{given}\\,] \\\\ (x+w)+(-x) & =x+(-x) &  & [\\,\\text{add }-x\\text{ to both sides}\\,] \\\\ (w+x)+(-x) & =x+(-x) &  & [\\,\\text{axiom __}\\,\\,] \\\\ w+(x+(-x)) & =x+(-x) &  & [\\,\\text{axiom A2}\\,] \\\\ w+0 & =0 &  & [\\,\\text{axiom A4}\\,] \\\\ w & =0 &  & [\\,\\text{axiom __}\\,\\,]\\end{aligned}\n$$\n\nThe axioms:\n\n$$\n\\begin{aligned}\\text{[A1]}:x+y=y+x & \\text{[A5]}:1\\cdot x=x \\\\ \\text{[A2]}:(x+y)+z=x+(y+z) & \\text{[A6]}:\\alpha (\\beta x)=(\\alpha \\beta )x \\\\ \\text{[A3]}:x+0=x & \\text{[A7]}:(\\alpha +\\beta )x=\\alpha x+\\beta x \\\\ \\text{[A4]}:x+(-x)=0 & \\text{[A8]}:\\alpha (x+y)=\\alpha x+\\alpha y\\end{aligned}\n$$" :question/worked-solution "Using the vector space axioms, we obtain the following:\n\n$$\n\\begin{aligned}x+w & =x &  & [\\,\\text{given}\\,] \\\\ (x+w)+(-x) & =x+(-x) &  & [\\,\\text{add }-x\\text{ to both sides}\\,] \\\\ (w+x)+(-x) & =x+(-x) &  & [\\,\\text{axiom }\\text{A1}\\,] \\\\ w+(x+(-x)) & =x+(-x) &  & [\\,\\text{axiom A2}\\,] \\\\ w+0 & =0 &  & [\\,\\text{axiom A4}\\,] \\\\ w & =0 &  & [\\,\\text{axiom }\\text{A3}\\,]\\end{aligned}\n$$"} :step/id #uuid "2f729f32-9ccf-5071-9aab-348325a597e5" :step/next {:db/id #edb/ref 17592186419010}} {:db/id #edb/ref 17592186419009 :step/content {:db/id #edb/ref 17592186419007 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "313cdc82-5d69-5af4-95bb-ace914a012ac" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "multiplication of $f\\in A$ by a scalar is not closed" :db/id #edb/ref 17592186418996} {:answer/id #uuid "4f43eb35-6698-556b-937a-7540b2eaa194" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "addition of functions in $A$  is not associative" :db/id #edb/ref 17592186418997} {:answer/id #uuid "54d7d70f-b06b-5dba-8920-ce4be2335648" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "addition of functions in $A$  is not commutative" :db/id #edb/ref 17592186418999} {:answer/id #uuid "61ff392f-4de3-5c34-9123-789573d772b5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1\\cdot f\\ne f$ for some $f\\in A$" :db/id #edb/ref 17592186419000} {:answer/id #uuid "f187a6fa-78fb-565f-9a52-c1915abb65f1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "addition and scalar multiplication of functions  in $A$ do not satisfy the distributive laws" :db/id #edb/ref 17592186419005}] :answer-field/correct {:db/id #edb/ref 17592186418996} :answer-field/id #uuid "4628fceb-08d9-5ba5-86ad-00d444e18706" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186419006}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1a47334c-0a05-5b9c-b7eb-76cf4c1d5cfb" :question/math-academy-id "q-94792" :question/problem "Let $A$ be the set of all functions $f:R\\to R$ of the form  $f(x)=a+{x}^{2},$ where $a\\in R.$ Complete the following sentence:\n\n*$A$ is **not** a vector space (with respect to function addition and scalar multiplication) because $\\text{_________}\\,.$*" :question/worked-solution "The correct answer is as follows:\n\n*$A$ is **not** a vector space (with respect to function addition and scalar multiplication) because **multiplication of $f\\in A$ by a scalar is not closed.** *\n\nFor example, if $\\alpha =2$ and $f(x)={x}^{2},$ then $\\alpha f(x)=2{x}^{2}.$ So, $\\alpha f(x)\\notin A$ because the coefficient of ${x}^{2}$ is not $1.$\n\nOn the other hand:\n\n- Addition of real valued functions  is associative. $\\,✓$\n\n- Addition and scalar multiplication of polynomials satisfy the distributive laws.\n$\\,✓$\n\n- Addition of real valued functions  is commutative. $\\,✓$\n\n- $1\\cdot f=f$ for all $f\\in A.$ $\\,✓$"} :step/id #uuid "4418ef90-81d3-58b0-a3d7-e0c226069037"} {:db/id #edb/ref 17592186419010 :step/content {:db/id #edb/ref 17592186385324 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1337dd4f-9280-53a2-a0bf-10fa5a1172ab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\text{A4}$, $\\text{A1}$" :db/id #edb/ref 17592186385326} {:answer/id #uuid "d3b06213-6b70-5fb1-9074-bd29c49e8d32" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\text{A4}$, $\\text{A2}$" :db/id #edb/ref 17592186385327} {:answer/id #uuid "175edfb7-a947-56df-a366-83319bf965d4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\text{A2}$, $\\text{A3}$" :db/id #edb/ref 17592186385328} {:answer/id #uuid "fb4ae0dc-f023-5eac-8d6f-6539fcd8b68a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\text{A5}$, $\\text{A2}$" :db/id #edb/ref 17592186385329} {:answer/id #uuid "f383b979-fa8e-5c2b-8977-e24abfd545ba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\text{A1}$, $\\text{A2}$" :db/id #edb/ref 17592186385330}] :answer-field/correct {:db/id #edb/ref 17592186385328} :answer-field/id #uuid "6de75fa4-40ed-54ed-9a38-aaf2ba31ee58" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186385325}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c7e8b0d2-1b58-5e69-8702-c53196883e47" :question/math-academy-id "q-35627" :question/problem "From top to bottom, fill in the blanks and hence complete the proof of the following statement using the axioms $[\\text{A}1]-[\\text{A}8]$ given below.\n\n*Given any $x\\in V$, if $w$ is a vector such that $x+w=0$, then $w=-x$* \n\n*Proof:*\n\n$$\n\\begin{aligned}x+w & =0 &  & [\\,\\text{given}\\,] \\\\ (x+w)+(-x) & =0+(-x) &  & [\\,\\text{add }-x\\text{ to both sides}\\,] \\\\ (w+x)+(-x) & =(-x)+0 &  & [\\,\\text{axiom A1}\\,] \\\\ (w+x)+(-x) & =-x &  & [\\,\\text{axiom A3}\\,] \\\\ w+(x+(-x)) & =-x &  & [\\,\\text{axiom __}\\,\\,] \\\\ w+0 & =-x &  & [\\,\\text{axiom A4}\\,] \\\\ w & =-x &  & [\\,\\text{axiom __}\\,\\,]\\end{aligned}\n$$\n\nThe axioms:\n\n$$\n\\begin{aligned}\\text{[A1]}:x+y=y+x & \\text{[A5]}:1\\cdot x=x \\\\ \\text{[A2]}:(x+y)+z=x+(y+z) & \\text{[A6]}:\\alpha (\\beta x)=(\\alpha \\beta )x \\\\ \\text{[A3]}:x+0=x & \\text{[A7]}:(\\alpha +\\beta )x=\\alpha x+\\beta x \\\\ \\text{[A4]}:x+(-x)=0 & \\text{[A8]}:\\alpha (x+y)=\\alpha x+\\alpha y\\end{aligned}\n$$" :question/worked-solution "Using the vector space axioms, we obtain the following:\n\n$$\n\\begin{aligned}x+w & =0 &  & [\\,\\text{given}\\,] \\\\ (x+w)+(-x) & =0+(-x) &  & [\\,\\text{add }-x\\text{ to both sides}\\,] \\\\ (w+x)+(-x) & =(-x)+0 &  & [\\,\\text{axiom A1}\\,] \\\\ (w+x)+(-x) & =-x &  & [\\,\\text{axiom A3}\\,] \\\\ w+(x+(-x)) & =-x &  & [\\,\\text{axiom }\\text{A2}\\,\\,] \\\\ w+0 & =-x &  & [\\,\\text{axiom A4}\\,] \\\\ w & =-x &  & [\\,\\text{axiom }\\text{A3}\\,\\,]\\end{aligned}\n$$"} :step/id #uuid "8de51b15-aacb-5258-b556-fea43597fd8c" :step/next {:db/id #edb/ref 17592186419009}}] :activity/title "Defining Abstract Vector Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186418995}]}
