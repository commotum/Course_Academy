r.type/math} :answer/value "\\sqrt{11}" :db/id #edb/ref 17592186573140}] :answer-field/correct {:answer/id #uuid "3b6bb977-d9f3-5ac7-aa36-12e676435303" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{2}" :db/id #edb/ref 17592186572889} :answer-field/id #uuid "75e5c39a-4f29-5171-b743-cd598384ab3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573190}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "de84f93a-9a95-5709-8b3a-1c7aaa638199" :question/math-academy-id "q-1330" :question/problem "Let $\\overset{\\to }{U}=⟨7,-1⟩.$ Find $|\\,\\overset{\\to }{U}|.$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}|\\,\\overset{\\to }{U}| & =\\sqrt{{u}_{x}^{2}+{u}_{y}^{2}} \\\\  & =\\sqrt{(7)^{2}+(-1)^{2}} \\\\  & =\\sqrt{49+1} \\\\  & =\\sqrt{50} \\\\  & =\\sqrt{25\\cdot 2} \\\\  & =5\\sqrt{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573300 :knowledge-point/_questions [{:db/id #edb/ref 17592186059714 :knowledge-point/id #uuid "a6b4ebe4-9baa-5ff0-847a-49d99ba69795" :knowledge-point/title "Calculating the Magnitude of a Vector Given in Component Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "111fbb05-f522-5735-8207-38753554e5cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{55}" :db/id #edb/ref 17592186572842} {:answer/id #uuid "60bf083e-3a33-524b-9653-f2ca3d265df2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{53}" :db/id #edb/ref 17592186572937} {:answer/id #uuid "951751dc-25fa-54f0-bb3e-3f6f69037922" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{50}" :db/id #edb/ref 17592186573018} {:answer/id #uuid "f2a9e490-80bb-5877-8dc0-511713e73021" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{56}" :db/id #edb/ref 17592186573132} {:answer/id #uuid "f9e1c41a-04cb-544b-8889-aaf571180749" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{52}" :db/id #edb/ref 17592186573141}] :answer-field/correct {:answer/id #uuid "60bf083e-3a33-524b-9653-f2ca3d265df2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{53}" :db/id #edb/ref 17592186572937} :answer-field/id #uuid "837da19e-bdf7-595c-b9f5-dac18fb60790" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573196}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "aee063d1-50f9-564e-a7e9-bfddcd038224" :question/math-academy-id "q-17616" :question/problem "Let $a=⟨-2,7⟩.$ Find $|\\,a\\,|.$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}|\\,a\\,| & =\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}} \\\\  & =\\sqrt{(-2)^{2}+(7)^{2}} \\\\  & =\\sqrt{4+49} \\\\  & =\\sqrt{53}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573288 :knowledge-point/_questions [{:db/id #edb/ref 17592186059715 :knowledge-point/id #uuid "7bc170fa-a70e-55af-8f3e-f4ea07431e30" :knowledge-point/title "Calculating a Vector From Position Vectors and then Computing its Magnitude"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b71bc5a-ea49-5c5c-8189-d231b7b94741" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186572854} {:answer/id #uuid "61691c6b-be2a-578a-a95a-691cf407bc55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186572939} {:answer/id #uuid "911f0451-83e2-59cb-94bc-9e71ecca138f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186573011} {:answer/id #uuid "a1d6c940-f208-59e6-abc2-918bb6b4ed48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186573029} {:answer/id #uuid "aec58b42-8779-526c-bd77-df664c625168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186573046}] :answer-field/correct {:answer/id #uuid "aec58b42-8779-526c-bd77-df664c625168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186573046} :answer-field/id #uuid "23f50047-f3e3-54c2-a0eb-ca4d6b6bb3ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573163}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8c1db841-92ab-5a9b-b59a-bd03ce09afe3" :question/math-academy-id "q-18057" :question/problem "![](images/b9/b911126b4468e016afbab7faaf20223d0811827bb7f57cdefc2f1923cb7faf1b.png)\n\nPoints $A$ and $C$ are shown in the picture above. Find $|\\overset{\\to }{AC}|.$" :question/worked-solution "From the picture, we obtain $A(0,3)$ and $C(4,0).$ So, we have\n\n$$\n\\begin{aligned} & \\overset{\\to }{OA}=a=0i+3j, \\\\  & \\overset{\\to }{OC}=c=4i+0j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{AC}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{AC} & =\\overset{\\to }{OC}-\\overset{\\to }{OA} \\\\  & =c-a \\\\  & =(4i)-(3j) \\\\  & =4i-3j\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{AC}| & =\\sqrt{(4)^{2}+(-3)^{2}} \\\\  & =\\sqrt{16+9} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573297 :knowledge-point/_questions [{:db/id #edb/ref 17592186059715 :knowledge-point/id #uuid "7bc170fa-a70e-55af-8f3e-f4ea07431e30" :knowledge-point/title "Calculating a Vector From Position Vectors and then Computing its Magnitude"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "200a4d21-812f-5dd9-a1e8-34e8c33d93df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{34}" :db/id #edb/ref 17592186572861}] :answer-field/correct {:answer/id #uuid "200a4d21-812f-5dd9-a1e8-34e8c33d93df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{34}" :db/id #edb/ref 17592186572861} :answer-field/id #uuid "f71eec51-55f5-5ed3-a5a6-c93f3bce746d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573247}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a88ebacd-81cc-571b-8835-0aed7b200fdc" :question/math-academy-id "q-320964" :question/problem "![](images/cf/cf7890789d1b80002ac2055fd61e8c8f58525f9bb1714bd77ff6e8542567e962.png)\n\nLet $A(-2,0)$ and $B(3,3).$ Find $|\\overset{\\to }{AB}|.$ Do not round the answer.\n\n$|\\overset{\\to }{AB}|=$\n{{field-1}}" :question/worked-solution "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OA}=a=-2i+0j, \\\\  & \\overset{\\to }{OB}=b=3i+3j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{AB}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\overset{\\to }{OB}-\\overset{\\to }{OA} \\\\  & =b-a \\\\  & =(3i+3j)-(-2i+0j) \\\\  & =5i+3j.\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{AB}| & =\\sqrt{{5}^{2}+{3}^{2}} \\\\  & =\\sqrt{25+9} \\\\  & =\\sqrt{34}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573283 :knowledge-point/_questions [{:db/id #edb/ref 17592186059715 :knowledge-point/id #uuid "7bc170fa-a70e-55af-8f3e-f4ea07431e30" :knowledge-point/title "Calculating a Vector From Position Vectors and then Computing its Magnitude"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7001357a-d27f-5f38-bb51-c1671b2f85e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186572963}] :answer-field/correct {:answer/id #uuid "7001357a-d27f-5f38-bb51-c1671b2f85e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186572963} :answer-field/id #uuid "19605a89-6fbc-50e5-80b4-4cc3c9941a36" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573159}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "65c77d8f-4e68-5667-bebf-382cd66bf3e2" :question/math-academy-id "q-320965" :question/problem "![](images/45/453e8fc1c4d8a5262fd0a8aa7341dd71b909a4a72cec94cd2698f800f7dc06c9.png)\n\nLet $A(0,3)$ and $B(4,-1).$ Find $|\\overset{\\to }{AB}|.$ Do not round the answer.\n\n$|\\overset{\\to }{AB}|=$\n{{field-1}}" :question/worked-solution "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OA}=a=0i+3j, \\\\  & \\overset{\\to }{OB}=b=4i-j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{AB}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\overset{\\to }{OB}-\\overset{\\to }{OA} \\\\  & =b-a \\\\  & =(4i-j)-(0i+3j) \\\\  & =4i-4j.\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{AB}| & =\\sqrt{{4}^{2}+(-4)^{2}} \\\\  & =\\sqrt{16+16} \\\\  & =4\\sqrt{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573276 :knowledge-point/_questions [{:db/id #edb/ref 17592186059716 :knowledge-point/id #uuid "9c45a70b-273c-5fec-a768-40a1cf218628" :knowledge-point/title "Calculating a Unit Vector Parallel to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72f71719-0fa2-5d74-951f-4a5a6316e2e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{2}{\\sqrt{3}} \\\\ -\\frac{1}{\\sqrt{3}}\\end{bmatrix}" :db/id #edb/ref 17592186572967} {:answer/id #uuid "76cef696-33d5-53c7-a20a-186993b395fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{6}{\\sqrt{5}} \\\\ -\\frac{3}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186572977} {:answer/id #uuid "c8e40bc8-06c3-562a-83ac-e13c465cde6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{2}{\\sqrt{15}} \\\\ -\\frac{1}{\\sqrt{15}}\\end{bmatrix}" :db/id #edb/ref 17592186573076} {:answer/id #uuid "cf3a28aa-2fb3-5f9e-a119-7bce309125f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{6}{\\sqrt{13}} \\\\ -\\frac{3}{\\sqrt{13}}\\end{bmatrix}" :db/id #edb/ref 17592186573087} {:answer/id #uuid "ebc2b5a5-a24d-5729-84ca-0b3b24f51964" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186573124}] :answer-field/correct {:answer/id #uuid "ebc2b5a5-a24d-5729-84ca-0b3b24f51964" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186573124} :answer-field/id #uuid "486b8f01-6945-5809-91a8-88d9d6a85f09" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573174}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "54931a2c-0179-55ba-b42e-021e69939399" :question/math-academy-id "q-70415" :question/problem "Let $r=\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}$ and $s=\\begin{bmatrix}0 \\\\ -3\\end{bmatrix}.$ Find a unit vector that is parallel to $3r+2s$ and points the same direction." :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector and points the same direction., we need to divide the given vector by its length:\n\n$$\n\\begin{aligned}u & =\\frac{3r+2s}{|3r+2s|}\\end{aligned}\n$$\n\nFirst, let's compute the sum:\n\n$$\n\\begin{aligned}3r+2s & =3\\cdot \\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}+2\\cdot \\begin{bmatrix}0 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 \\\\ 3\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}(-6)+0 \\\\ 3+(-6)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 \\\\ -3\\end{bmatrix}\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|3r+2s| & =\\sqrt{(-6)^{2}+(-3)^{2}} \\\\  & =\\sqrt{45} \\\\  & =3\\sqrt{5}.\\end{aligned}\n$$\n\nFinally, we divide $3r+2s$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{3r+2s}{|3r+2s|} \\\\  & =\\frac{1}{3\\sqrt{5}}(3r+2s) \\\\  & =\\frac{1}{3\\sqrt{5}}\\cdot \\begin{bmatrix}-6 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{bmatrix}\\end{aligned}\n$$"}]}
