b/ref 17592186045493 #edb/ref 17592186045417] [17592186573211 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186573211 #edb/ref 1078 #edb/ref 17592186572980 #edb/ref 17592186045417] [17592186573211 #edb/ref 1079 #uuid "ad9dfc42-a7b2-570f-831f-bdb8b850c4c5" #edb/ref 17592186045417] [17592186573247 #edb/ref 1075 #edb/ref 17592186572861 #edb/ref 17592186045417] [17592186573247 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186573247 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186573247 #edb/ref 1078 #edb/ref 17592186572861 #edb/ref 17592186045417] [17592186573247 #edb/ref 1079 #uuid "f71eec51-55f5-5ed3-a5a6-c93f3bce746d" #edb/ref 17592186045417] [17592186573276 #edb/ref 1068 #edb/ref 17592186573174 #edb/ref 17592186045417] [17592186573276 #edb/ref 1069 "q-70415" #edb/ref 17592186045417] [17592186573276 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186573276 #edb/ref 1071 "Let $r=\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}$ and $s=\\begin{bmatrix}0 \\\\ -3\\end{bmatrix}.$ Find a unit vector that is parallel to $3r+2s$ and points the same direction." #edb/ref 17592186045417] [17592186573276 #edb/ref 1072 #uuid "54931a2c-0179-55ba-b42e-021e69939399" #edb/ref 17592186045417] [17592186573276 #edb/ref 1074 "Remember that to find a unit vector that is parallel to a given vector and points the same direction., we need to divide the given vector by its length:\n\n$$\n\\begin{aligned}u & =\\frac{3r+2s}{|3r+2s|}\\end{aligned}\n$$\n\nFirst, let's compute the sum:\n\n$$\n\\begin{aligned}3r+2s & =3\\cdot \\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}+2\\cdot \\begin{bmatrix}0 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 \\\\ 3\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}(-6)+0 \\\\ 3+(-6)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 \\\\ -3\\end{bmatrix}\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|3r+2s| & =\\sqrt{(-6)^{2}+(-3)^{2}} \\\\  & =\\sqrt{45} \\\\  & =3\\sqrt{5}.\\end{aligned}\n$$\n\nFinally, we divide $3r+2s$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{3r+2s}{|3r+2s|} \\\\  & =\\frac{1}{3\\sqrt{5}}(3r+2s) \\\\  & =\\frac{1}{3\\sqrt{5}}\\cdot \\begin{bmatrix}-6 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{bmatrix}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186573283 #edb/ref 1068 #edb/ref 17592186573159 #edb/ref 17592186045417] [17592186573283 #edb/ref 1069 "q-320965" #edb/ref 17592186045417] [17592186573283 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186573283 #edb/ref 1071 "![](images/45/453e8fc1c4d8a5262fd0a8aa7341dd71b909a4a72cec94cd2698f800f7dc06c9.png)\n\nLet $A(0,3)$ and $B(4,-1).$ Find $|\\overset{\\to }{AB}|.$ Do not round the answer.\n\n$|\\overset{\\to }{AB}|=$\n{{field-1}}" #edb/ref 17592186045417] [17592186573283 #edb/ref 1072 #uuid "65c77d8f-4e68-5667-bebf-382cd66bf3e2" #edb/ref 17592186045417] [17592186573283 #edb/ref 1074 "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OA}=a=0i+3j, \\\\  & \\overset{\\to }{OB}=b=4i-j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{AB}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\overset{\\to }{OB}-\\overset{\\to }{OA} \\\\  & =b-a \\\\  & =(4i-j)-(0i+3j) \\\\  & =4i-4j.\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{AB}| & =\\sqrt{{4}^{2}+(-4)^{2}} \\\\  & =\\sqrt{16+16} \\\\  & =4\\sqrt{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186573287 #edb/ref 1068 #edb/ref 17592186573161 #edb/ref 17592186045417] [17592186573287 #edb/ref 1069 "q-1307" #edb/ref 17592186045417] [17592186573287 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186573287 #edb/ref 1071 "If $u=⟨2,3⟩$, then what is the magnitude of $u?$" #edb/ref 17592186045417] [17592186573287 #edb/ref 1072 #uuid "84731c4b-0fa0-51b7-ab58-c2cc224240fc" #edb/ref 17592186045417] [17592186573287 #edb/ref 1074 "Using the formula, we have \n\n$$\n\\begin{aligned}|\\,u\\,| & =\\sqrt{{u}_{x}^{2}+{u}_{y}^{2}} \\\\  & =\\sqrt{(2)^{2}+(3)^{2}} \\\\  & =\\sqrt{4+9} \\\\  & =\\sqrt{13}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186573288 #edb/ref 1068 #edb/ref 17592186573163 #edb/ref 17592186045417] [17592186573288 #edb/ref 1069 "q-18057" #edb/ref 17592186045417] [17592186573288 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186573288 #edb/ref 1071 "![](images/b9/b911126b4468e016afbab7faaf20223d0811827bb7f57cdefc2f1923cb7faf1b.png)\n\nPoints $A$ and $C$ are shown in the picture above. Find $|\\overset{\\to }{AC}|.$" #edb/ref 17592186045417] [17592186573288 #edb/ref 1072 #uuid "8c1db841-92ab-5a9b-b59a-bd03ce09afe3" #edb/ref 17592186045417] [17592186573288 #edb/ref 1074 "From the picture, we obtain $A(0,3)$ and $C(4,0).$ So, we have\n\n$$\n\\begin{aligned} & \\overset{\\to }{OA}=a=0i+3j, \\\\  & \\overset{\\to }{OC}=c=4i+0j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{AC}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{AC} & =\\overset{\\to }{OC}-\\overset{\\to }{OA} \\\\  & =c-a \\\\  & =(4i)-(3j) \\\\  & =4i-3j\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{AC}| & =\\sqrt{(4)^{2}+(-3)^{2}} \\\\  & =\\sqrt{16+9} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186573295 #edb/ref 1068 #edb/ref 17592186573178 #edb/ref 17592186045417] [17592186573295 #edb/ref 1069 "q-1326" #edb/ref 17592186045417] [17592186573295 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186573295 #edb/ref 1071 "If $u=⟨-3,-5⟩$, then what is the magnitude of $u?$" #edb/ref 17592186045417] [17592186573295 #edb/ref 1072 #uuid "9c74dff8-a34c-5a12-a8c0-881272406626" #edb/ref 17592186045417] [17592186573295 #edb/ref 1074 "Using the formula, we have \n\n$$\n\\begin{aligned}|\\,u\\,| & =\\sqrt{{u}_{x}^{2}+{u}_{y}^{2}} \\\\  & =\\sqrt{(-3)^{2}+(-5)^{2}} \\\\  & =\\sqrt{9+25} \\\\  & =\\sqrt{34}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186573297 #edb/ref 1068 #edb/ref 17592186573247 #edb/ref 17592186045417] [17592186573297 #edb/ref 1069 "q-320964" #edb/ref 17592186045417] [17592186573297 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186573297 #edb/ref 1071 "![](images/cf/cf7890789d1b80002ac2055fd61e8c8f58525f9bb1714bd77ff6e8542567e962.png)\n\nLet $A(-2,0)$ and $B(3,3).$ Find $|\\overset{\\to }{AB}|.$ Do not round the answer.\n\n$|\\overset{\\to }{AB}|=$\n{{field-1}}" #edb/ref 17592186045417] [17592186573297 #edb/ref 1072 #uuid "a88ebacd-81cc-571b-8835-0aed7b200fdc" #edb/ref 17592186045417] [17592186573297 #edb/ref 1074 "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OA}=a=-2i+0j, \\\\  & \\overset{\\to }{OB}=b=3i+3j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{AB}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\overset{\\to }{OB}-\\overset{\\to }{OA} \\\\  & =b-a \\\\  & =(3i+3j)-(-2i+0j) \\\\  & =5i+3j.\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{AB}| & =\\sqrt{{5}^{2}+{3}^{2}} \\\\  & =\\sqrt{25+9} \\\\  & =\\sqrt{34}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186573300 #edb/ref 1068 #edb/ref 17592186573196 #edb/ref 17592186045417] [17592186573300 #edb/ref 1069 "q-17616" #edb/ref 17592186045417] [17592186573300 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186573300 #edb/ref 1071 "Let $a=⟨-2,7⟩.$ Find $|\\,a\\,|.$" #edb/ref 17592186045417] [17592186573300 #edb/ref 1072 #uuid "aee063d1-50f9-564e-a7e9-bfddcd038224" #edb/ref 17592186045417] [17592186573300 #edb/ref 1074 "Using the formula, we have\n\n$$\n\\begin{aligned}|\\,a\\,| & =\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}} \\\\  & =\\sqrt{(-2)^{2}+(7)^{2}} \\\\  & =\\sqrt{4+49} \\\\  & =\\sqrt{53}.\\end{aligned}\n$$" #edb/ref 17592186045417]}
