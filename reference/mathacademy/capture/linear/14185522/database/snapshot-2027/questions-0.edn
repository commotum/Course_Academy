#{[{:db/id #edb/ref 17592186498544 :knowledge-point/_questions [{:db/id #edb/ref 17592186059639 :knowledge-point/id #uuid "26db86bd-122c-5d1b-9684-9444897d1c44" :knowledge-point/title "Relating the Length of the Shorter Leg to the Length of the Longer Leg"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4da9fb6c-fce4-5acb-9e17-120df5e26665" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\sqrt{3}" :db/id #edb/ref 17592186497983} {:answer/id #uuid "6a18641a-fc11-59e5-854c-6411d7507876" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{7}" :db/id #edb/ref 17592186498056} {:answer/id #uuid "6a325992-e856-576c-91f7-df3f2ff65284" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186498057} {:answer/id #uuid "72d672f8-30a6-5729-819b-bcd0ca845735" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186498073} {:answer/id #uuid "78288c7d-e32f-51d9-91dc-975f09e50567" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186498084}] :answer-field/correct {:answer/id #uuid "78288c7d-e32f-51d9-91dc-975f09e50567" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186498084} :answer-field/id #uuid "56b57fc3-f626-5cfd-921b-551fd91eff75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186498396}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "66769d5d-040d-51bf-90cd-9a689f5af1ed" :question/math-academy-id "q-119567" :question/problem "![](images/42/4234a330c5f497e3eae5af5006b87197f6911114f8b104b9050223d08ae7d310.png)\n\nIn the triangle above, what is the length of the shorter leg?" :question/worked-solution "Let's refer to our standard ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle.\n\n![](images/b8/b8f2ba89d30a41072f635916eb07b394fd4bd83eb39181f13e852d1b776de5ee.png)\n\nSince this is a ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle, the length of the longer leg is $\\sqrt{3}$ times that of the shorter leg.\n\nHere, the longer leg has length $7\\sqrt{3},$ and the shorter leg has length $x,$ so we have\n\n$$\n\\begin{aligned}7\\sqrt{3} & =\\sqrt{3}x \\\\ x & =\\frac{7\\sqrt{3}}{\\sqrt{3}} \\\\ x & =7.\\end{aligned}\n$$\n\nSo, the length of the shorter leg is $7.$"}] [{:db/id #edb/ref 17592186498594 :knowledge-point/_questions [{:db/id #edb/ref 17592186059639 :knowledge-point/id #uuid "26db86bd-122c-5d1b-9684-9444897d1c44" :knowledge-point/title "Relating the Length of the Shorter Leg to the Length of the Longer Leg"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21e34be6-9d43-52e0-b22e-907ce34bc24d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{7}" :db/id #edb/ref 17592186497870} {:answer/id #uuid "73884abd-8071-5124-a2c0-7bf649d6ebc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\sqrt{3}" :db/id #edb/ref 17592186498075} {:answer/id #uuid "9f3833b4-dcec-536d-bf70-19da49848ce7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186498155} {:answer/id #uuid "bdba409b-c32c-5c89-936d-51658a2ee188" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186498220} {:answer/id #uuid "f895f4a1-8bdc-521b-b919-11a1fec165de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186498341}] :answer-field/correct {:answer/id #uuid "73884abd-8071-5124-a2c0-7bf649d6ebc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\sqrt{3}" :db/id #edb/ref 17592186498075} :answer-field/id #uuid "8711fdf9-4038-5d22-903a-76bcdd15aa01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186498427}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e7ef9681-e380-5003-b606-ef9960f3bfee" :question/math-academy-id "q-119569" :question/problem "What is the length of the side opposite the ${30}^{∘}$ angle in a ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle if the side opposite the ${60}^{∘}$ angle has a length of $21?$" :question/worked-solution "Let's refer to our standard ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle.\n\n![](images/1f/1f7084b210e13a9c2753c3ae8bfcc9302b109cc9584f589c6b8937536ae93682.png)\n\n  \n\nSince this is a ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle, the length of the longer leg is $\\sqrt{3}$ times that of the shorter leg.\n\nHere, the longer leg has length $21,$ and the shorter leg has length $x,$ so we have\n\n$$\n\\begin{aligned}21 & =\\sqrt{3}x \\\\ x & =\\frac{21}{\\sqrt{3}}.\\end{aligned}\n$$\n\nTo remove the radical from the denominator, we can multiply the numerator and denominator by the radical:\n\n$$\nx=\\frac{21}{\\sqrt{3}}=\\frac{21\\cdot \\sqrt{3}}{\\sqrt{3}\\cdot \\sqrt{3}}=\\frac{21\\sqrt{3}}{3}=7\\sqrt{3}\n$$\n\nSo, the length of the shorter leg is $7\\sqrt{3}.$"}] [{:db/id #edb/ref 17592186498579 :knowledge-point/_questions [{:db/id #edb/ref 17592186059639 :knowledge-point/id #uuid "26db86bd-122c-5d1b-9684-9444897d1c44" :knowledge-point/title "Relating the Length of the Shorter Leg to the Length of the Longer Leg"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39c1eea0-7c1a-5512-a40b-b00ac6438521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186497928} {:answer/id #uuid "72d18ca3-fe51-56a9-9bfa-889608a412a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186498072} {:answer/id #uuid "846d4048-65cc-5295-b258-ea3a58ef9c5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186498105} {:answer/id #uuid "c2a38599-4447-5901-bca9-9207e3d7d95c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186498229} {:answer/id #uuid "e911db0b-16ef-5b6b-9539-32d02e521317" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186498312}] :answer-field/correct {:answer/id #uuid "72d18ca3-fe51-56a9-9bfa-889608a412a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186498072} :answer-field/id #uuid "fdbaebde-f52c-5ca0-b6d8-fe1dfd1cd8d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186498485}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c6bb31a7-2bac-5692-829b-abedff759b19" :question/math-academy-id "q-53474" :question/problem "![](images/56/56b286d9b7c503c84891ebdf410797f715844eb8de344f71dc2fc652cbf3b5ef.png)\n\nIn the triangle above, what is the length of $\\overset{―}{AC}?$" :question/worked-solution "Let's refer to our standard ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle.\n\n![](images/85/85f119cdc6b7a80dd7cd4ea2a2a235e80723b7c2fe6837fa127beb8fd994d7ea.png)\n\nSince this is a ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle, the length of the longer leg is $\\sqrt{3}$ times that of the shorter leg.\n\nHere, the shorter leg has length $x=3$ and the longer leg has length $\\sqrt{3}x,$ so we have\n\n$$\n\\begin{aligned}AC=\\sqrt{3}x=\\sqrt{3}\\cdot 3=3\\sqrt{3}.\\end{aligned}\n$$\n\nSo, the length of the longer leg is $3\\sqrt{3}.$"}]}
