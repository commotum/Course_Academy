#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186060470} :activity/id #uuid "8089f422-4708-55f1-8234-e77b87f79d18" :activity/scope {:db/id #edb/ref 17592186048737 :topic/id #uuid "b9ffda55-6967-5939-88c6-796a478b7b95" :topic/math-academy-id 262} :activity/steps [{:db/id #edb/ref 17592186060470 :step/content {:db/id #edb/ref 17592186060874 :tutorial/content "Let's consider an equilateral triangle with sides of length $2x$. Notice that any altitude will split it into two congruent triangles, as shown below.\n\n![](images/30/301fe26a314d91d0d316758a5076cea2383f325991789addceaec71f0e7b16dd.png)\n\nIn the new smaller triangle the acute angles will be $30^\\circ$ and $60^\\circ.$ Such triangles are called **$\\boldsymbol{30^\\circ}$-$\\boldsymbol{60^\\circ}$-$\\boldsymbol{90^\\circ}$ triangles**.\n\nBased on the picture above, we see a special property shared by all $30^\\circ$-$60^\\circ$-$90^\\circ$ triangles:\n\n*In any ${30^\\circ}$-${60^\\circ}$-${90^\\circ}$ triangle, the hypotenuse is twice as long as the shortest leg (which is opposite the $30^\\circ$ angle).*\n\nThis also works in the other direction:\n\n*If the hypotenuse is twice as long as the shortest leg, then the given right triangle is a ${30^\\circ}$-${60^\\circ}$-${90^\\circ}$ triangle.*" :tutorial/id #uuid "e07c8310-fe8a-5f3e-9ff0-7cd4e93a784c" :tutorial/math-academy-id 2383 :tutorial/title "Introduction"} :step/id #uuid "f3aaec85-3c9b-585d-9138-8646ce0db776" :step/math-academy-id 10425 :step/next {:db/id #edb/ref 17592186060471}} {:db/id #edb/ref 17592186060471 :step/content {:db/id #edb/ref 17592186059637 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059465 :question/id #uuid "b5f19406-37c2-569e-9c9e-b99e00234f91" :question/math-academy-id "e-3084"} :knowledge-point/id #uuid "4cc0e4fc-64ca-5c1b-abbe-357e930af7a4" :knowledge-point/questions [{:db/id #edb/ref 17592186060087} {:db/id #edb/ref 17592186060291} {:db/id #edb/ref 17592186491179} {:db/id #edb/ref 17592186491201}] :knowledge-point/title "Relating the Length of the Hypotenuse to the Length Of the Shortest Side"} :step/id #uuid "a6377883-059a-5ebf-97b1-38ef2ad683fd" :step/math-academy-id 10427 :step/next {:db/id #edb/ref 17592186060472}} {:db/id #edb/ref 17592186060472 :step/content {:db/id #edb/ref 17592186060875 :tutorial/content "Consider the same ${30^\\circ}$-${60^\\circ}$-${90^\\circ}$ triangle from before. This time, however, we will focus on the height ($h$) instead of the hypotenuse.\n\n![](images/30/301fe26a314d91d0d316758a5076cea2383f325991789addceaec71f0e7b16dd.png)\n\nApplying the Pythagorean Theorem, we have\n\n$$\n\\begin{aligned}(2x)^{2} & ={x}^{2}+{h}^{2} \\\\ {h}^{2} & =4{x}^{2}-{x}^{2} \\\\ {h}^{2} & =3{x}^{2} \\\\ h & =\\sqrt{3}x,\\end{aligned}\n$$\n\nwhich gives us the second important property:\n\n*In any ${30^\\circ}$-${60^\\circ}$-${90^\\circ}$ triangle, the length of the longer leg (which is opposite the $60^\\circ$ angle) is $\\sqrt{3}$ times the length of the shorter leg (which is opposite the $30^\\circ$ angle).*\n\nWe can summarize everything we know about ${30^\\circ}$-${60^\\circ}$-${90^\\circ}$ triangles using the diagram below:\n\n![](images/85/8598f9163b29833bb5895416e3dec9b6aa2358bd2cfcca944625ebb9f576b3a4.png)" :tutorial/id #uuid "e2dbb6c4-dedc-56fa-8e66-87e843a7f7fb" :tutorial/math-academy-id 2386 :tutorial/title "The Longer Leg"} :step/id #uuid "860a330d-51b9-5aba-a7ce-25da9f5b8254" :step/math-academy-id 10429 :step/next {:db/id #edb/ref 17592186060474}} {:db/id #edb/ref 17592186060474 :step/content {:db/id #edb/ref 17592186059639 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059467 :question/id #uuid "f399fe29-f767-5ea5-bc2b-0d47c0e8fbaf" :question/math-academy-id "e-3086"} :knowledge-point/id #uuid "26db86bd-122c-5d1b-9684-9444897d1c44" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048702}] :knowledge-point/questions [{:db/id #edb/ref 17592186060292} {:db/id #edb/ref 17592186060293} {:db/id #edb/ref 17592186491122} {:db/id #edb/ref 17592186498544} {:db/id #edb/ref 17592186498579} {:db/id #edb/ref 17592186498594}] :knowledge-point/title "Relating the Length of the Shorter Leg to the Length of the Longer Leg"} :step/id #uuid "ec4f5b67-5c3e-5ce2-bb3a-7b6b95c2a0c8" :step/math-academy-id 10432 :step/next {:db/id #edb/ref 17592186060475}} {:db/id #edb/ref 17592186060475 :step/content {:db/id #edb/ref 17592186059640 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059468 :question/id #uuid "40a94955-95e0-5945-9a84-d51b8c691bce" :question/math-academy-id "e-3088"} :knowledge-point/id #uuid "ca6bd1cf-98e8-5fc8-b605-dd4d24ac8f6c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050613}] :knowledge-point/questions [{:db/id #edb/ref 17592186060085} {:db/id #edb/ref 17592186060094} {:db/id #edb/ref 17592186491146} {:db/id #edb/ref 17592186491188}] :knowledge-point/title "Relating the Length of the Hypotenuse to the Length Of the Longer Leg"} :step/id #uuid "ab1f256a-5f6e-5d12-9b0f-482675761ab1" :step/math-academy-id 10434}] :activity/title "30-60-90 Triangles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186059937}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186498606} :activity/id #uuid "ec4d6c60-9493-5c8e-8def-a6cecde39a5a" :activity/scope {:db/id #edb/ref 17592186048737 :topic/id #uuid "b9ffda55-6967-5939-88c6-796a478b7b95" :topic/math-academy-id 262} :activity/steps [{:db/id #edb/ref 17592186498606 :step/content {:db/id #edb/ref 17592186498579 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39c1eea0-7c1a-5512-a40b-b00ac6438521" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186497928} {:answer/id #uuid "72d18ca3-fe51-56a9-9bfa-889608a412a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186498072} {:answer/id #uuid "846d4048-65cc-5295-b258-ea3a58ef9c5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186498105} {:answer/id #uuid "c2a38599-4447-5901-bca9-9207e3d7d95c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186498229} {:answer/id #uuid "e911db0b-16ef-5b6b-9539-32d02e521317" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186498312}] :answer-field/correct {:db/id #edb/ref 17592186498072} :answer-field/id #uuid "fdbaebde-f52c-5ca0-b6d8-fe1dfd1cd8d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186498485}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c6bb31a7-2bac-5692-829b-abedff759b19" :question/math-academy-id "q-53474" :question/problem "![](images/56/56b286d9b7c503c84891ebdf410797f715844eb8de344f71dc2fc652cbf3b5ef.png)\n\nIn the triangle above, what is the length of $\\overset{―}{AC}?$" :question/worked-solution "Let's refer to our standard ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle.\n\n![](images/85/85f119cdc6b7a80dd7cd4ea2a2a235e80723b7c2fe6837fa127beb8fd994d7ea.png)\n\nSince this is a ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle, the length of the longer leg is $\\sqrt{3}$ times that of the shorter leg.\n\nHere, the shorter leg has length $x=3$ and the longer leg has length $\\sqrt{3}x,$ so we have\n\n$$\n\\begin{aligned}AC=\\sqrt{3}x=\\sqrt{3}\\cdot 3=3\\sqrt{3}.\\end{aligned}\n$$\n\nSo, the length of the longer leg is $3\\sqrt{3}.$"} :step/id #uuid "095a68ee-12f6-53d3-a8d2-90e37f449112" :step/next {:db/id #edb/ref 17592186498636}} {:db/id #edb/ref 17592186498624 :step/content {:db/id #edb/ref 17592186498594 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21e34be6-9d43-52e0-b22e-907ce34bc24d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{7}" :db/id #edb/ref 17592186497870} {:answer/id #uuid "73884abd-8071-5124-a2c0-7bf649d6ebc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7\\sqrt{3}" :db/id #edb/ref 17592186498075} {:answer/id #uuid "9f3833b4-dcec-536d-bf70-19da49848ce7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186498155} {:answer/id #uuid "bdba409b-c32c-5c89-936d-51658a2ee188" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186498220} {:answer/id #uuid "f895f4a1-8bdc-521b-b919-11a1fec165de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186498341}] :answer-field/correct {:db/id #edb/ref 17592186498075} :answer-field/id #uuid "8711fdf9-4038-5d22-903a-76bcdd15aa01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186498427}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e7ef9681-e380-5003-b606-ef9960f3bfee" :question/math-academy-id "q-119569" :question/problem "What is the length of the side opposite the ${30}^{∘}$ angle in a ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle if the side opposite the ${60}^{∘}$ angle has a length of $21?$" :question/worked-solution "Let's refer to our standard ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle.\n\n![](images/1f/1f7084b210e13a9c2753c3ae8bfcc9302b109cc9584f589c6b8937536ae93682.png)\n\n  \n\nSince this is a ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle, the length of the longer leg is $\\sqrt{3}$ times that of the shorter leg.\n\nHere, the longer leg has length $21,$ and the shorter leg has length $x,$ so we have\n\n$$\n\\begin{aligned}21 & =\\sqrt{3}x \\\\ x & =\\frac{21}{\\sqrt{3}}.\\end{aligned}\n$$\n\nTo remove the radical from the denominator, we can multiply the numerator and denominator by the radical:\n\n$$\nx=\\frac{21}{\\sqrt{3}}=\\frac{21\\cdot \\sqrt{3}}{\\sqrt{3}\\cdot \\sqrt{3}}=\\frac{21\\sqrt{3}}{3}=7\\sqrt{3}\n$$\n\nSo, the length of the shorter leg is $7\\sqrt{3}.$"} :step/id #uuid "45a49306-50df-53e5-a942-01eb1a2f5ffd"} {:db/id #edb/ref 17592186498636 :step/content {:db/id #edb/ref 17592186498544 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4da9fb6c-fce4-5acb-9e17-120df5e26665" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7\\sqrt{3}" :db/id #edb/ref 17592186497983} {:answer/id #uuid "6a18641a-fc11-59e5-854c-6411d7507876" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{7}" :db/id #edb/ref 17592186498056} {:answer/id #uuid "6a325992-e856-576c-91f7-df3f2ff65284" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186498057} {:answer/id #uuid "72d672f8-30a6-5729-819b-bcd0ca845735" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186498073} {:answer/id #uuid "78288c7d-e32f-51d9-91dc-975f09e50567" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186498084}] :answer-field/correct {:db/id #edb/ref 17592186498084} :answer-field/id #uuid "56b57fc3-f626-5cfd-921b-551fd91eff75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186498396}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "66769d5d-040d-51bf-90cd-9a689f5af1ed" :question/math-academy-id "q-119567" :question/problem "![](images/42/4234a330c5f497e3eae5af5006b87197f6911114f8b104b9050223d08ae7d310.png)\n\nIn the triangle above, what is the length of the shorter leg?" :question/worked-solution "Let's refer to our standard ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle.\n\n![](images/b8/b8f2ba89d30a41072f635916eb07b394fd4bd83eb39181f13e852d1b776de5ee.png)\n\nSince this is a ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle, the length of the longer leg is $\\sqrt{3}$ times that of the shorter leg.\n\nHere, the longer leg has length $7\\sqrt{3},$ and the shorter leg has length $x,$ so we have\n\n$$\n\\begin{aligned}7\\sqrt{3} & =\\sqrt{3}x \\\\ x & =\\frac{7\\sqrt{3}}{\\sqrt{3}} \\\\ x & =7.\\end{aligned}\n$$\n\nSo, the length of the shorter leg is $7.$"} :step/id #uuid "91dbe6b8-3a0b-5bb5-abce-3fde9a626f55" :step/next {:db/id #edb/ref 17592186498624}}] :activity/title "30-60-90 Triangles" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186497797}]}
