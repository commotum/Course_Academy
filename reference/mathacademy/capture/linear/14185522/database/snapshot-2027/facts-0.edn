8427 #edb/ref 1075 #edb/ref 17592186498155 #edb/ref 17592186045417] [17592186498427 #edb/ref 1075 #edb/ref 17592186498220 #edb/ref 17592186045417] [17592186498427 #edb/ref 1075 #edb/ref 17592186498341 #edb/ref 17592186045417] [17592186498427 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186498427 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186498427 #edb/ref 1078 #edb/ref 17592186498075 #edb/ref 17592186045417] [17592186498427 #edb/ref 1079 #uuid "8711fdf9-4038-5d22-903a-76bcdd15aa01" #edb/ref 17592186045417] [17592186498485 #edb/ref 1075 #edb/ref 17592186497928 #edb/ref 17592186045417] [17592186498485 #edb/ref 1075 #edb/ref 17592186498072 #edb/ref 17592186045417] [17592186498485 #edb/ref 1075 #edb/ref 17592186498105 #edb/ref 17592186045417] [17592186498485 #edb/ref 1075 #edb/ref 17592186498229 #edb/ref 17592186045417] [17592186498485 #edb/ref 1075 #edb/ref 17592186498312 #edb/ref 17592186045417] [17592186498485 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186498485 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186498485 #edb/ref 1078 #edb/ref 17592186498072 #edb/ref 17592186045417] [17592186498485 #edb/ref 1079 #uuid "fdbaebde-f52c-5ca0-b6d8-fe1dfd1cd8d1" #edb/ref 17592186045417] [17592186498544 #edb/ref 1068 #edb/ref 17592186498396 #edb/ref 17592186045417] [17592186498544 #edb/ref 1069 "q-119567" #edb/ref 17592186045417] [17592186498544 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186498544 #edb/ref 1071 "![](images/42/4234a330c5f497e3eae5af5006b87197f6911114f8b104b9050223d08ae7d310.png)\n\nIn the triangle above, what is the length of the shorter leg?" #edb/ref 17592186045417] [17592186498544 #edb/ref 1072 #uuid "66769d5d-040d-51bf-90cd-9a689f5af1ed" #edb/ref 17592186045417] [17592186498544 #edb/ref 1074 "Let's refer to our standard ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle.\n\n![](images/b8/b8f2ba89d30a41072f635916eb07b394fd4bd83eb39181f13e852d1b776de5ee.png)\n\nSince this is a ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle, the length of the longer leg is $\\sqrt{3}$ times that of the shorter leg.\n\nHere, the longer leg has length $7\\sqrt{3},$ and the shorter leg has length $x,$ so we have\n\n$$\n\\begin{aligned}7\\sqrt{3} & =\\sqrt{3}x \\\\ x & =\\frac{7\\sqrt{3}}{\\sqrt{3}} \\\\ x & =7.\\end{aligned}\n$$\n\nSo, the length of the shorter leg is $7.$" #edb/ref 17592186045417] [17592186498579 #edb/ref 1068 #edb/ref 17592186498485 #edb/ref 17592186045417] [17592186498579 #edb/ref 1069 "q-53474" #edb/ref 17592186045417] [17592186498579 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186498579 #edb/ref 1071 "![](images/56/56b286d9b7c503c84891ebdf410797f715844eb8de344f71dc2fc652cbf3b5ef.png)\n\nIn the triangle above, what is the length of $\\overset{―}{AC}?$" #edb/ref 17592186045417] [17592186498579 #edb/ref 1072 #uuid "c6bb31a7-2bac-5692-829b-abedff759b19" #edb/ref 17592186045417] [17592186498579 #edb/ref 1074 "Let's refer to our standard ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle.\n\n![](images/85/85f119cdc6b7a80dd7cd4ea2a2a235e80723b7c2fe6837fa127beb8fd994d7ea.png)\n\nSince this is a ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle, the length of the longer leg is $\\sqrt{3}$ times that of the shorter leg.\n\nHere, the shorter leg has length $x=3$ and the longer leg has length $\\sqrt{3}x,$ so we have\n\n$$\n\\begin{aligned}AC=\\sqrt{3}x=\\sqrt{3}\\cdot 3=3\\sqrt{3}.\\end{aligned}\n$$\n\nSo, the length of the longer leg is $3\\sqrt{3}.$" #edb/ref 17592186045417] [17592186498594 #edb/ref 1068 #edb/ref 17592186498427 #edb/ref 17592186045417] [17592186498594 #edb/ref 1069 "q-119569" #edb/ref 17592186045417] [17592186498594 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186498594 #edb/ref 1071 "What is the length of the side opposite the ${30}^{∘}$ angle in a ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle if the side opposite the ${60}^{∘}$ angle has a length of $21?$" #edb/ref 17592186045417] [17592186498594 #edb/ref 1072 #uuid "e7ef9681-e380-5003-b606-ef9960f3bfee" #edb/ref 17592186045417] [17592186498594 #edb/ref 1074 "Let's refer to our standard ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle.\n\n![](images/1f/1f7084b210e13a9c2753c3ae8bfcc9302b109cc9584f589c6b8937536ae93682.png)\n\n  \n\nSince this is a ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle, the length of the longer leg is $\\sqrt{3}$ times that of the shorter leg.\n\nHere, the longer leg has length $21,$ and the shorter leg has length $x,$ so we have\n\n$$\n\\begin{aligned}21 & =\\sqrt{3}x \\\\ x & =\\frac{21}{\\sqrt{3}}.\\end{aligned}\n$$\n\nTo remove the radical from the denominator, we can multiply the numerator and denominator by the radical:\n\n$$\nx=\\frac{21}{\\sqrt{3}}=\\frac{21\\cdot \\sqrt{3}}{\\sqrt{3}\\cdot \\sqrt{3}}=\\frac{21\\sqrt{3}}{3}=7\\sqrt{3}\n$$\n\nSo, the length of the shorter leg is $7\\sqrt{3}.$" #edb/ref 17592186045417] [17592186498606 #edb/ref 1058 #edb/ref 17592186498636 #edb/ref 17592186045417] [17592186498606 #edb/ref 1062 #uuid "095a68ee-12f6-53d3-a8d2-90e37f449112" #edb/ref 17592186045417] [17592186498606 #edb/ref 1063 #edb/ref 17592186498579 #edb/ref 17592186045417] [17592186498624 #edb/ref 1062 #uuid "45a49306-50df-53e5-a942-01eb1a2f5ffd" #edb/ref 17592186045417] [17592186498624 #edb/ref 1063 #edb/ref 17592186498594 #edb/ref 17592186045417] [17592186498636 #edb/ref 1058 #edb/ref 17592186498624 #edb/ref 17592186045417] [17592186498636 #edb/ref 1062 #uuid "91dbe6b8-3a0b-5bb5-abce-3fde9a626f55" #edb/ref 17592186045417] [17592186498636 #edb/ref 1063 #edb/ref 17592186498544 #edb/ref 17592186045417]}
