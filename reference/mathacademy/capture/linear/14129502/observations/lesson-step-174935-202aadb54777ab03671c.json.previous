119T101 77Q136 26 198 26Q295 26 295 104Q295 133 277 151Q257 175 194 187T111 210Q75 227 54 256T33 318Q33 357 50 384T93 424T143 442T187 447H198Q238 447 268 432L283 424L292 431Q302 440 314 448H322H326Q329 448 335 442V310L329 304H301Q295 310 295 316Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E2-MJMAIN-39\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E2-MJMAIN-32\" x=\"707\" y=\"583\"></use>\n <use xlink:href=\"#E2-MJMAIN-3D\" x=\"1232\" y=\"0\"></use>\n<g transform=\"translate(2288,0)\">\n<g transform=\"translate(218,0)\">\n <use xlink:href=\"#E2-MJMAIN-39\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-D7\" x=\"722\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-39\" x=\"1723\" y=\"0\"></use>\n<g transform=\"translate(12,-537)\">\n <use xlink:href=\"#E2-MJSZ4-E152\" x=\"23\" y=\"0\"></use>\n<g transform=\"translate(488.01425264550267,0) scale(0.42255291005290996,1)\">\n <use xlink:href=\"#E2-MJSZ4-E154\"></use>\n</g>\n<g transform=\"translate(661,0)\">\n <use xlink:href=\"#E2-MJSZ4-E151\"></use>\n <use xlink:href=\"#E2-MJSZ4-E150\" x=\"450\" y=\"0\"></use>\n</g>\n<g transform=\"translate(1566.4864748677248,0) scale(0.42255291005290996,1)\">\n <use xlink:href=\"#E2-MJSZ4-E154\"></use>\n</g>\n <use xlink:href=\"#E2-MJSZ4-E153\" x=\"1749\" y=\"0\"></use>\n</g>\n</g>\n<g transform=\"translate(0,-1487)\">\n <use transform=\"scale(0.849)\" xlink:href=\"#E2-MJMAIN-32\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(424,0)\">\n <use transform=\"scale(0.849)\" xlink:href=\"#E2-MJMAIN-74\" x=\"294\" y=\"0\"></use>\n <use transform=\"scale(0.849)\" xlink:href=\"#E2-MJMAIN-69\" x=\"684\" y=\"0\"></use>\n <use transform=\"scale(0.849)\" xlink:href=\"#E2-MJMAIN-6D\" x=\"962\" y=\"0\"></use>\n <use transform=\"scale(0.849)\" xlink:href=\"#E2-MJMAIN-65\" x=\"1796\" y=\"0\"></use>\n <use transform=\"scale(0.849)\" xlink:href=\"#E2-MJMAIN-73\" x=\"2240\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n<p>Then, we compute the product:\n<span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"16.655ex\" height=\"3.176ex\" style=\"vertical-align: -1.005ex;\" viewBox=\"0 -934.9 7171 1367.4\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-3-Title\">\n<title id=\"MathJax-SVG-3-Title\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"2\" style=\"font-size: 113.1%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 6.826em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right;\"><mjx-msup><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c39\"></mjx-c></mjx-mn><mjx-script style=\"vertical-align: 0.413em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c39\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-cD7\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c39\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c38\"></mjx-c><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right\" columnspacing=\"\" rowspacing=\"3pt\"><mtr><mtd><msup><mn>9</mn><mn>2</mn></msup><mo>=</mo><mn>9</mn><mo>×</mo><mn>9</mn><mo>=</mo><mn>81</mn></mtd