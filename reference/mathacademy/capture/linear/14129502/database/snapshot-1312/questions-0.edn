\\\\  &  & \\,\\,\\,\\,8\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, &  & \\,\\,\\,\\,9\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\,\\end{aligned} \\\\  & \\end{aligned}\n$$\n\nSince $81\\times 9=729,$ then ${9}^{3}=729.$"}] [{:db/id #edb/ref 17592186429903 :knowledge-point/_questions [{:db/id #edb/ref 17592186138404 :knowledge-point/id #uuid "70a364f5-5384-5ba6-8142-5740aa51f4bc" :knowledge-point/title "Raising Zero or One to a Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ff70c75-fdf0-5b77-9add-2312202eb0ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186429824} {:answer/id #uuid "3e13ab7e-cec8-59eb-a41a-bd4453910d40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "303" :db/id #edb/ref 17592186429833} {:answer/id #uuid "41e2ea61-dd9a-54e8-9ac9-cdc41fd5df6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186429834} {:answer/id #uuid "462618ff-f6ff-5452-bada-5b13b78841df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186429835} {:answer/id #uuid "9d52e40e-6a2f-5490-8b2b-b5211cdf7580" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186429855}] :answer-field/correct {:answer/id #uuid "462618ff-f6ff-5452-bada-5b13b78841df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186429835} :answer-field/id #uuid "2e623bb2-70b9-5f01-9cae-c7fdfa5d42ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186429873}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :que