#{[{:db/id #edb/ref 17592186138135 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138401 :knowledge-point/id #uuid "9c336cc3-c89e-5af2-b170-1fc6d9cf8307" :knowledge-point/title "Squaring a Number"}] :question/id #uuid "b5313725-78fc-57ee-9acc-19d03f6624bf" :question/math-academy-id "e-13752" :question/problem "Find the value of $4$ raised to the second power." :question/worked-solution "We need to evaluate $4^2$.\n\nTo evaluate $4^2$, we write it out with multiplication signs and then compute the product:\n\n$$\n4^{2} = 4 \\cdot 4_(⏟)_([math]2[/math] times) = 16\n$$"}] [{:db/id #edb/ref 17592186138136 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138402 :knowledge-point/id #uuid "fc1a0e6d-ed51-5797-8ab7-305e861d1109" :knowledge-point/title "Cubing a Number"}] :question/id #uuid "213a088d-3427-5313-adc2-1fcc9d64bb74" :question/math-academy-id "e-13754" :question/problem "What is the value of $5$ raised to the power of $3$?" :question/worked-solution "Here, $5$ raised to the power of $3$ means $5^3$.\n\nTo compute this power, we start by writing it out with multiplication signs:\n$3$\n\nNow, we compute the product. Since\n\n$$\n5 \\times 5 = 25\n$$\n\nwe have\n\n$$\n\\begin{aligned}\n5 \\cdot 5_(⏟)_(25) \\cdot 5 &= 25 \\cdot 5\n\\end{aligned}\n$$\n\nFinally, we work out ${\\color{blue}25} \\times 5$.\n$_(2); 2\\begin{vmatrix}5 \\\\ \\cdot\\end{vmatrix}5; 1 \\mid 2 \\mid 5$\n\nTherefore, $5^3=125$."}] [{:db/id #edb/ref 17592186138137 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138403 :knowledge-point/id #uuid "2cd9435f-cb8b-57b2-99ce-d856f613b0fd" :knowledge-point/title "Raising a Number to the First Power"}] :question/id #uuid "0c0e05b6-e633-5b9e-a070-3e26e0349355" :question/math-academy-id "e-13757" :question/problem "Find the value of $6^1$." :question/worked-solution "Here, ${\\color{blue}6}^{\\color{red}1}$ is in exponent form. The base is $\\color{blue}6$ and the exponent is ${\\color{red}1}$.\n\nThis means that $\\color{blue}6$ is taken as a factor only once. Therefore,\n$6^1 = 6$."}] [{:db/id #edb/ref 17592186138138 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138404 :knowledge-point/id #uuid "70a364f5-5384-5ba6-8142-5740aa51f4bc" :knowledge-point/title "Raising Zero or One to a Power"}] :question/id #uuid "d4e63087-a01f-59b3-bf6c-cf7cbfa3ce78" :question/math-academy-id "e-13760" :question/problem "Calculate the value of $0^5$." :question/worked-solution "Here, ${\\color{blue}0}^{\\color{red}5}$ is in exponent form. The base is $\\color{blue}0$ and the exponent is ${\\color{red}5}$.\n\nThis means that ${\\color{blue}0}$ is taken as a factor ${\\color{red}5}$ times. Therefore,\n$5$"}] [{:db/id #edb/ref 17592186138714 :knowledge-point/_questions [{:db/id #edb/ref 17592186138404 :knowledge-point/id #uuid "70a364f5-5384-5ba6-8142-5740aa51f4bc" :knowledge-point/title "Raising Zero or One to a Power"}] :question/answer-fields [{:answer-field/id #uuid "ed2b163e-f418-5803-9223-687190c52195" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186135454}] :question/id #uuid "8b868e1e-2207-586e-9bc6-bd4ad015584e" :question/math-academy-id "q-172531" :question/problem "$0^{4} =$ {{field-1}}"}]}
