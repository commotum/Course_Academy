r-2dfc505d-98fc-5843-bf4f-e1cb78862d60" "answer-75c9a73e-36b6-5e3b-86b9-deb610a519cc" "answer-ceb2c862-2582-57ba-a416-9e3fd6d2437b" "answer-f26dd7f4-4d26-58ba-a960-7424d6ba4984" "answer-84af4d0f-daf1-504b-b32f-35d8375a371c"] :db/ensure [:answer-field/validate]} {:db/id "answer-2dfc505d-98fc-5843-bf4f-e1cb78862d60" :answer/id #uuid "2dfc505d-98fc-5843-bf4f-e1cb78862d60" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-75c9a73e-36b6-5e3b-86b9-deb610a519cc" :answer/id #uuid "75c9a73e-36b6-5e3b-86b9-deb610a519cc" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-ceb2c862-2582-57ba-a416-9e3fd6d2437b" :answer/id #uuid "ceb2c862-2582-57ba-a416-9e3fd6d2437b" :answer/type :answer.type/math :answer/value "101" :db/ensure [:answer/validate]} {:db/id "answer-f26dd7f4-4d26-58ba-a960-7424d6ba4984" :answer/id #uuid "f26dd7f4-4d26-58ba-a960-7424d6ba4984" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "answer-84af4d0f-daf1-504b-b32f-35d8375a371c" :answer/id #uuid "84af4d0f-daf1-504b-b32f-35d8375a371c" :answer/type :answer.type/math :answer/value "110" :db/ensure [:answer/validate]} {:db/id "question-47a275b6-8ed5-5b82-b1e3-8feb36ab37f8" :question/id #uuid "47a275b6-8ed5-5b82-b1e3-8feb36ab37f8" :question/math-academy-id "q-172532" :question/problem "${1}^{12}=${{field-1}}" :question/worked-solution "Here, ${1}^{12}$ is in exponent form. The base is $1$ and the exponent is $12.$ \n\nThis means that $1$ is taken as a factor $12$ times. Therefore,\n\n$$\n{1}^{12}={{1\\times 1\\times 1\\times 1\\times 1\\times 1\\times 1\\times 1\\times 1\\times 1\\times 1\\times 1}_{⏟}}_{12\\text{ times}}=1.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9f86dc9e-f417-5acd-8efa-e57867fbb112"] :db/ensure [:question/validate]} {:db/id "answer-field-9f86dc9e-f417-5acd-8efa-e57867fbb112" :answer-field/id #uuid "9f86dc9e-f417-5acd-8efa-e57867fbb112" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a4fa67ab-62df-5af3-889a-0e76e67f9c5d" :answer-field/choices ["answer-a4fa67ab-62df-5af3-889a-0e76e67f9c5d"] :db/ensure [:answer-field/validate]} {:db/id "answer-a4fa67ab-62df-5af3-889a-0e76e67f9c5d" :answer/id #uuid "a4fa67ab-62df-5af3-889a-0e76e67f9c5d" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id 17592186139702 :tutorial/content "To evaluate a power, we write it out with multiplication signs and then compute the resulting product.\n\nSo, to find the value of $9^2,$ we first write it out with multiplication signs as follows:\n![](images/c7/c7e4007e9b80b07aca028ffc9bf8f5c4354bafb4e15dd0ce7e474279e364e1a3.svg)\n\nThen, we compute the product:\n\n$$\n\\begin{aligned}{9}^{2}=9\\times 9=81\\end{aligned}\n$$\n\nRaising a number to the power of $2$ is known as **squaring** a number. Therefore, the following are equivalent.\n\n- $9^2 = 81$\n\n- The **square** of $9$ is $81.$\n\n- $9$ raised to the *second* power equals $81.$" :db/ensure [:tutorial/validate]} {:db/id 17592186139743 :tutorial/content "Let's evaluate the following exponent:\n\n$$\n2^{\\color{red}{3}}\n$$\n\nWe start by writing our exponent as repeated multiplication:\n![](images/fe/fea572ac021fd3eabd4d5b1ade6692cbb1507d993b16616f63b8aa78259d3ade.svg)\n\nNow, we compute the product. \n\nSince $2 \\times 2 = 4,$ we have\n\n$$\n\\begin{aligned}{{2\\times 2}_{⏟}}_{4}\\times 2 & =4\\times 2.\\end{aligned}\n$$\n\nFinally, since ${\\color{blue}{4}}\\times 2=8,$ we have $2^3=8.$\n\nRaising a number to the power of $3$ is known as **cubing** a number. Therefore, the following are equivalent.\n\n- $2^3 = 8$\n\n- The **cube** of $2$ is $8.$\n\n- $2$ raised to the *third* power equals $8.$" :db/ensure [:tutorial/validate]} {:db/id 17592186138624 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
