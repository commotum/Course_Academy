#{[{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186106917} :activity/id #uuid "75a4e4a8-271a-52f6-80d3-a6bbb0833cfd" :activity/scope {:db/id #edb/ref 17592186050149 :topic/id #uuid "30edc058-70f2-5a72-9472-b7c90e677423" :topic/math-academy-id 1275} :activity/steps [{:db/id #edb/ref 17592186106917 :step/content {:db/id #edb/ref 17592186107063 :tutorial/content "The formula for the area of a general triangle is\n\n$$\n\\mathcal{A}=\\frac{1}{2}{\\color{red}{a}}{\\color{blue}{b}}\\sin{C},\n$$\n\nwhere $\\color{red}a$ and $\\color{blue}b$ are two sides of the triangle and $C$ is the measure of the angle between those sides (called the **included angle**).\n\nWe'll prove this result at the end of the lesson.\n\nTo demonstrate how this works, suppose that we want to calculate the area of the non-right-angled triangle below:\n\n![](images/4b/4b0fb75f9b2eaf3d0237d8cfe2e31bc27b02425b6cffa8d15f27d6de03f60838.png)\n\nLet's call the lengths of the sides $BC = \\color{red}{a}$ and $AC ={\\color{blue}{b}}.$ For the triangle above we have\n${\\color{red}a=10},$ ${\\color{blue}b=12},$ and  $m\\angle C=45^{\\circ}.$\n\nTherefore, the area of our triangle is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot 10\\cdot 12\\cdot \\operatorname{sin}⁡{45}^{∘} \\\\  & =60\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =30\\sqrt{2}.\\end{aligned}\n$$" :tutorial/id #uuid "ff9f9791-f688-59c5-8c9d-b776016045be" :tutorial/math-academy-id 2465 :tutorial/title "Introduction"} :step/id #uuid "e26490ba-2418-5a78-9c31-5425d1b67c42" :step/math-academy-id 655395 :step/next {:db/id #edb/ref 17592186106918}} {:db/id #edb/ref 17592186106918 :step/content {:db/id #edb/ref 17592186105903 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105560 :question/id #uuid "62405619-31ca-5403-aa45-360e6b3fbd59" :question/math-academy-id "e-3289"} :knowledge-point/id #uuid "acc86fb6-2ef4-5f8f-b204-6e1fdbbf0530" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049449}] :knowledge-point/question-generator {:db/id #edb/ref 17592186528224} :knowledge-point/questions [{:db/id #edb/ref 17592186106085} {:db/id #edb/ref 17592186106086} {:db/id #edb/ref 17592186284783} {:db/id #edb/ref 17592186295109} {:db/id #edb/ref 17592186295110} {:db/id #edb/ref 17592186295123} {:db/id #edb/ref 17592186528147} {:db/id #edb/ref 17592186528157} {:db/id #edb/ref 17592186528162} {:db/id #edb/ref 17592186528169} {:db/id #edb/ref 17592186528172} {:db/id #edb/ref 17592186528186} {:db/id #edb/ref 17592186528187} {:db/id #edb/ref 17592186528197} {:db/id #edb/ref 17592186528202} {:db/id #edb/ref 17592186528204} {:db/id #edb/ref 17592186528213} {:db/id #edb/ref 17592186528214} {:db/id #edb/ref 17592186547048} {:db/id #edb/ref 17592186547053}] :knowledge-point/title "Calculating the Area of a Triangle"} :step/id #uuid "ee7e485d-cba2-595c-b5bd-d8cd98cc7e04" :step/math-academy-id 655396 :step/next {:db/id #edb/ref 17592186106919}} {:db/id #edb/ref 17592186106919 :step/content {:db/id #edb/ref 17592186105904 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105579 :question/id #uuid "c8d31ea4-41c6-5f24-bf7a-a950a30342d7" :question/math-academy-id "e-4253"} :knowledge-point/id #uuid "cafdb077-0e02-5e7a-bf78-c3a8aacfb6f7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050847}] :knowledge-point/question-generator {:db/id #edb/ref 17592186556406} :knowledge-point/questions [{:db/id #edb/ref 17592186106346} {:db/id #edb/ref 17592186106347} {:db/id #edb/ref 17592186278381} {:db/id #edb/ref 17592186278383} {:db/id #edb/ref 17592186295125} {:db/id #edb/ref 17592186295126} {:db/id #edb/ref 17592186323821} {:db/id #edb/ref 17592186329720} {:db/id #edb/ref 17592186329721} {:db/id #edb/ref 17592186556353} {:db/id #edb/ref 17592186556359} {:db/id #edb/ref 17592186556366} {:db/id #edb/ref 17592186556379} {:db/id #edb/ref 17592186556381} {:db/id #edb/ref 17592186556384} {:db/id #edb/ref 17592186556391} {:db/id #edb/ref 17592186556396} {:db/id #edb/ref 17592186556400} {:db/id #edb/ref 17592186556401}] :knowledge-point/title "Calculating an Angle or Side of a Triangle Given the Area of a Triangle"} :step/id #uuid "ca664e6a-cebd-5079-927f-7fc062b9c6fd" :step/math-academy-id 655399 :step/next {:db/id #edb/ref 17592186106920}} {:db/id #edb/ref 17592186106920 :step/content {:db/id #edb/ref 17592186105905 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105561 :question/id #uuid "b41b2354-c339-5398-ab43-5886b8447c1c" :question/math-academy-id "e-3294"} :knowledge-point/id #uuid "3173d361-b91d-5699-97d8-6595ef59d0a3" :knowledge-point/question-generator {:db/id #edb/ref 17592186556101} :knowledge-point/questions [{:db/id #edb/ref 17592186106087} {:db/id #edb/ref 17592186106439} {:db/id #edb/ref 17592186234325} {:db/id #edb/ref 17592186295111} {:db/id #edb/ref 17592186297160} {:db/id #edb/ref 17592186297161} {:db/id #edb/ref 17592186332914} {:db/id #edb/ref 17592186335939} {:db/id #edb/ref 17592186335940} {:db/id #edb/ref 17592186341859} {:db/id #edb/ref 17592186547012} {:db/id #edb/ref 17592186547025} {:db/id #edb/ref 17592186556057} {:db/id #edb/ref 17592186556065} {:db/id #edb/ref 17592186556068} {:db/id #edb/ref 17592186556073} {:db/id #edb/ref 17592186556077} {:db/id #edb/ref 17592186556082} {:db/id #edb/ref 17592186556083} {:db/id #edb/ref 17592186556085} {:db/id #edb/ref 17592186556094} {:db/id #edb/ref 17592186556097} {:db/id #edb/ref 17592186557305}] :knowledge-point/title "Calculating the Area of a Quadrilateral"} :step/id #uuid "ab2a0c05-ebeb-54b0-a9a3-b37d1f143e15" :step/math-academy-id 655402 :step/next {:db/id #edb/ref 17592186106921}} {:db/id #edb/ref 17592186106921 :step/content {:db/id #edb/ref 17592186105906 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105562 :question/id #uuid "472216c8-da7d-58fb-9056-e71d5e33460d" :question/math-academy-id "e-3297"} :knowledge-point/id #uuid "5dd3dcff-06d2-5d61-9863-0f5b541d8d4b" :knowledge-point/questions [{:db/id #edb/ref 17592186106088} {:db/id #edb/ref 17592186106089} {:db/id #edb/ref 17592186278380} {:db/id #edb/ref 17592186297162} {:db/id #edb/ref 17592186297163} {:db/id #edb/ref 17592186297164} {:db/id #edb/ref 17592186297165} {:db/id #edb/ref 17592186341858} {:db/id #edb/ref 17592186547072} {:db/id #edb/ref 17592186547082} {:db/id #edb/ref 17592186557293}] :knowledge-point/title "Finding the Area of a Triangle Given the Area of a Quadrilateral"} :step/id #uuid "85b3474e-aa3e-5a9b-8c47-069d6e314fad" :step/math-academy-id 655405 :step/next {:db/id #edb/ref 17592186106922}} {:db/id #edb/ref 17592186106922 :step/content {:db/id #edb/ref 17592186107027 :tutorial/content "Consider $\\triangle ABC$ with sides of lengths $a,b,$ and $c,$ as shown below.\n\n![](images/1d/1d30e12e2252b27a651bb02b718cf2214c7ddcf4f0e768c5bd952c11b2e4ecde.png)\n\nLet's now add the height of length $h$ perpendicular to $\\overline{BC},$ as shown.\n\n![](images/96/96817ab2168b9ec37777166a26001ee8bc7e7709f80fdf234ac6d70cdfbb5ddc.png)\n\nUsing the usual formula for the area $\\mathcal A$ of a triangle in terms of its base and height, we have\n\n$$\n\\mathcal A = \\dfrac12 ah.\n$$\n\nUsing elementary trigonometry, we have that\n\n$$\n\\dfrac{h}{b} = \\sin C\n$$\n\nwhich means that \n\n$$\nh = b\\sin C.\n$$\n\nTherefore, by substituting this into our expression for $\\mathcal A,$ we have\n\n$$\n\\mathcal A = \\dfrac12ab\\sin C\n$$\n\nas required.\n\nWe can use a similar approach to prove the following formulas:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}bc\\operatorname{sin}⁡A \\\\ A & =\\frac{1}{2}ac\\operatorname{sin}⁡B\\end{aligned}\n$$" :tutorial/id #uuid "e126d83f-0c01-514b-bb7e-ce2d16291b22" :tutorial/math-academy-id 13277 :tutorial/title "Deriving the Formula for the Area of a General Triangle"} :step/id #uuid "29c5a503-b01d-5845-a29d-0bd76807b33f" :step/math-academy-id 655408}] :activity/title "The Area of a General Triangle" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186105954}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186557370} :activity/id #uuid "1f6d27b5-729c-512f-8bbb-fd371c843cf4" :activity/scope {:db/id #edb/ref 17592186050149 :topic/id #uuid "30edc058-70f2-5a72-9472-b7c90e677423" :topic/math-academy-id 1275} :activity/steps [{:db/id #edb/ref 17592186557353 :step/content {:db/id #edb/ref 17592186557305 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "056ae85b-4497-51c3-bf0f-16db555df25d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "87" :db/id #edb/ref 17592186556442} {:answer/id #uuid "893a2d02-47a2-54d1-80f0-24b55f689ea0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "58" :db/id #edb/ref 17592186556754} {:answer/id #uuid "9e8e098e-a66d-5126-99c7-db91b01066aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "82" :db/id #edb/ref 17592186556816} {:answer/id #uuid "a7188c0a-2793-54f6-a856-19adbe5707e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "93" :db/id #edb/ref 17592186556841} {:answer/id #uuid "cc4e118b-ddd2-55e0-a765-c19e81224e03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "66" :db/id #edb/ref 17592186556923}] :answer-field/correct {:db/id #edb/ref 17592186556923} :answer-field/id #uuid "0bd6e77c-1825-574d-9544-ad954df128e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557069}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c86bcf22-54c7-51dc-bd7b-9dc7538670ba" :question/math-academy-id "q-67785" :question/problem "![](images/27/27dc9ff8452d9a9aa95322492549ba0eabed5f68a7aa2e586ebe239143268bde.png)\n\nRounded to the nearest integer, what is the area of the quadrilateral $ABCD?$" :question/worked-solution "The area of the quadrilateral $ABCD$ is the sum of the areas of the triangles $△ABD$ and $△BDC$ (see the illustration below).\n\n![](images/da/da7cc00005fbeb686443e2075009fda7c68f6d379a8ddb924a7dfe5b60e6ab16.png)\n\n \n\nFirst we find the area for $△ABD:$ \n \n\n$$\n\\begin{aligned}{A}_{ABD} & =\\frac{1}{2}\\cdot 10\\cdot 8\\cdot \\operatorname{sin}⁡{75}^{∘} \\\\  & =40\\cdot \\operatorname{sin}⁡{75}^{∘} \\\\  & ≈38.637,\\end{aligned}\n$$\n\nrounded to $3$ decimal places.\n\nNow we find the area for $△BCD:$ \n \n\n$$\n\\begin{aligned}{A}_{BDC} & =\\frac{1}{2}\\cdot 5\\cdot 12\\cdot \\operatorname{sin}⁡{67.2}^{∘} \\\\  & =30\\cdot \\operatorname{sin}⁡{67.2}^{∘} \\\\  & ≈27.656,\\end{aligned}\n$$\n\nrounded to $3$ decimal places.\n\nFinally, we add together the areas of our two triangles to determine the area of $ABCD:$\n\n$$\n\\begin{aligned}{A}_{ABCD} & ={A}_{ABD}+{A}_{BDC} \\\\  & =38.637+27.656 \\\\  & =66.293\\end{aligned}\n$$\n\nConsequently, to the nearest integer, the area of the quadrilateral $ABCD$ is $66.$"} :step/id #uuid "3f0057db-8c02-55c7-898f-3136c6331c68" :step/next {:db/id #edb/ref 17592186557371}} {:db/id #edb/ref 17592186557370 :step/content {:db/id #edb/ref 17592186106346 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00d6fe5b-b93a-5b3a-b3ae-957d16951d55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{22}{3}\\text{ cm}" :db/id #edb/ref 17592186556429} {:answer/id #uuid "16b5e456-0628-5b28-9973-d24a67f59883" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9\\text{ cm}" :db/id #edb/ref 17592186556479} {:answer/id #uuid "42dfb8fe-2ca7-5bf5-a862-8097a357954b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7\\text{ cm}" :db/id #edb/ref 17592186556578} {:answer/id #uuid "d645e81a-5337-5246-a811-91c0e07d93c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\text{ cm}" :db/id #edb/ref 17592186556952} {:answer/id #uuid "fdb5a129-5ab4-5d2c-9e01-2c562f075800" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{25}{2}\\text{ cm}" :db/id #edb/ref 17592186557057}] :answer-field/correct {:db/id #edb/ref 17592186556578} :answer-field/id #uuid "04104815-55f0-5585-b546-93a2c497895f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186104224}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e987c676-ae94-5f92-bdbb-ee11dc914f54" :question/math-academy-id "q-43310" :question/problem "![](images/cc/cce0e775722bbaaa8eeeb60a7cd097e8ad59b7c83c838f072416112aed657e33.png)\n\nThe area of ​​the triangle $△ABC$ is $\\frac{21}{4}{\\text{ cm}}^{2}.$ Find $AC.$" :question/worked-solution "The formula for the area of the triangle is \n\n$$\nA=\\frac{1}{2}bc\\operatorname{sin}⁡A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere\n\n$$\n\\begin{aligned}c & =AB=3\\text{ cm}, \\\\ b & =AC, \\\\ m∠A & ={30}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{30}^{∘}=\\frac{1}{2},\n$$\n\nwe can calculate $b=AC,$ as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot b\\cdot c\\cdot \\operatorname{sin}⁡A \\\\ \\frac{21}{4} & =\\frac{1}{2}\\cdot b\\cdot 3\\cdot \\operatorname{sin}⁡{30}^{∘} \\\\ \\frac{21}{4} & =\\frac{1}{2}\\cdot b\\cdot 3\\cdot (\\frac{1}{2}) \\\\ \\frac{21}{4} & =\\frac{3b}{4} \\\\ 3b & =21 \\\\ b & =7\\text{ cm}.\\end{aligned}\n$$\n\nWe conclude that $AC=7\\text{cm}.$"} :step/id #uuid "7b22a461-459d-538c-a7ad-2b24ce04d8e3" :step/next {:db/id #edb/ref 17592186557353}} {:db/id #edb/ref 17592186557371 :step/content {:db/id #edb/ref 17592186557293 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65d7e23d-a662-543a-949a-9f1103f2f026" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16\\,{\\text{ in}}^{2}" :db/id #edb/ref 17592186556669} {:answer/id #uuid "718ad878-e04a-5234-a710-bf3756d5dd41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15\\,{\\text{ in}}^{2}" :db/id #edb/ref 17592186556688} {:answer/id #uuid "7822939c-8917-5fa9-999c-a9b7716110f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14\\,{\\text{ in}}^{2}" :db/id #edb/ref 17592186556703} {:answer/id #uuid "863c7b23-cd66-50d9-b292-999cccff557f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\,{\\text{ in}}^{2}" :db/id #edb/ref 17592186556747} {:answer/id #uuid "8fbfadd0-9675-506a-9f67-970459a5eb77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\,{\\text{ in}}^{2}" :db/id #edb/ref 17592186556778}] :answer-field/correct {:db/id #edb/ref 17592186556703} :answer-field/id #uuid "c1ee5adb-4e16-5916-9acc-b73f1caa075b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557175}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b105592d-99b2-5bf4-877e-0bc7baf37cd7" :question/math-academy-id "q-161105" :question/problem "![](images/0b/0b460a07026e489fb7c63dad99c04c7e44540138632626dcd3ebcafb5c0a93d3.png)\n\nThe area of $ABCD$ is $52{\\text{ in}}^{2}.$   What is the area of $△BCD$ rounded to the nearest integer?" :question/worked-solution "Let's start by finding the area of $△ABD.$ We get \n\n$$\n\\begin{aligned}{A}_{△ABD} & =\\frac{1}{2}\\cdot AB\\cdot AD\\cdot \\operatorname{sin}⁡A \\\\  & =\\frac{1}{2}\\cdot 9\\cdot 16\\cdot \\operatorname{sin}⁡{66}^{∘} \\\\  & =72\\cdot \\operatorname{sin}⁡{66}^{∘} \\\\  & =65.775… \\\\  & ≈66{\\text{ in}}^{2},\\end{aligned}\n$$\n\nrounded to the nearest integer.\n\nThe difference of the areas of  $△ABD$ and the quadrilateral $ABCD$ gives the area of $△BCD.$ Therefore, \n \n\n$$\n\\begin{aligned}{A}_{△BCD} & ={A}_{△ABD}-{A}_{ABCD} \\\\  & =66-52 \\\\  & =14\\,{\\text{ in}}^{2}.\\end{aligned}\n$$"} :step/id #uuid "80b2a081-7fde-5691-bde6-6ceee92db580"}] :activity/title "The Area of a General Triangle" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186556410}]}
