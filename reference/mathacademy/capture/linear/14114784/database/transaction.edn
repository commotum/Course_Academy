[{:db/id 17592186105742 :knowledge-point/questions ["question-32b7570a-855d-5799-88e4-c24fe54119de" "question-627a3422-ad6a-5d23-b76b-6cf6cb390db2"] :db/ensure [:knowledge-point/validate]} {:db/id "question-32b7570a-855d-5799-88e4-c24fe54119de" :question/id #uuid "32b7570a-855d-5799-88e4-c24fe54119de" :question/math-academy-id "q-20053" :question/problem "Let $a=⟨-2,2,-3⟩$, $b=⟨2,-1,2⟩$ and $c=⟨-2,1,1⟩.$ Find $a\\cdot (b\\times c).$" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}-2 & 2 & -3 \\\\ 2 & -1 & 2 \\\\ -2 & 1 & 1\\end{aligned}| \\\\  & =(-2)\\cdot |\\begin{aligned}-1 & 2 \\\\ 1 & 1\\end{aligned}|-2\\cdot |\\begin{aligned}2 & 2 \\\\ -2 & 1\\end{aligned}|+(-3)\\cdot |\\begin{aligned}2 & -1 \\\\ -2 & 1\\end{aligned}| \\\\  & =-2((-1)\\cdot 1-1\\cdot 2)-2(2\\cdot 1-(-2)\\cdot 2)-3(2\\cdot 1-(-2)\\cdot (-1)) \\\\  & =6-12+0 \\\\  & =-6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5fd432bd-eb14-5f9d-bc51-e98dfa9d5d17"] :db/ensure [:question/validate]} {:db/id "answer-field-5fd432bd-eb14-5f9d-bc51-e98dfa9d5d17" :answer-field/id #uuid "5fd432bd-eb14-5f9d-bc51-e98dfa9d5d17" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-56ef0874-008a-597f-b2cb-02be44cd3944" :answer-field/choices ["answer-9cf98593-9506-526d-9be6-5176a031c0ec" "answer-d6d39875-cd66-5fd6-9485-32650cce5157" "answer-56ef0874-008a-597f-b2cb-02be44cd3944" "answer-a019b149-6685-5c94-9ead-07affcb89def" "answer-6d8dcecd-d942-5c7a-b18e-cb5a2602acc6"] :db/ensure [:answer-field/validate]} {:db/id "answer-9cf98593-9506-526d-9be6-5176a031c0ec" :answer/id #uuid "9cf98593-9506-526d-9be6-5176a031c0ec" :answer/type :answer.type/math :answer/value "-10" :db/ensure [:answer/validate]} {:db/id "answer-d6d