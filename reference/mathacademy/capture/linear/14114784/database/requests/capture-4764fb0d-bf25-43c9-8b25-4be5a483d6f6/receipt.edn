#edb/ref 17592186408142 13194139533562 17592186045585 true] [17592186408144 1069 "q-20053" 13194139533562 17592186045585 true] [17592186408144 1070 #edb/ref 17592186045485 13194139533562 17592186045585 true] [17592186408144 1071 "Let $a=⟨-2,2,-3⟩$, $b=⟨2,-1,2⟩$ and $c=⟨-2,1,1⟩.$ Find $a\\cdot (b\\times c).$" 13194139533562 17592186045585 true] [17592186408144 1072 #uuid "32b7570a-855d-5799-88e4-c24fe54119de" 13194139533562 17592186045585 true] [17592186408144 1074 "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}-2 & 2 & -3 \\\\ 2 & -1 & 2 \\\\ -2 & 1 & 1\\end{aligned}| \\\\  & =(-2)\\cdot |\\begin{aligned}-1 & 2 \\\\ 1 & 1\\end{aligned}|-2\\cdot |\\begin{aligned}2 & 2 \\\\ -2 & 1\\end{aligned}|+(-3)\\cdot |\\begin{aligned}2 & -1 \\\\ -2 & 1\\end{aligned}| \\\\  & =-2((-1)\\cdot 1-1\\cdot 2)-2(2\\cdot 1-(-2)\\cdot 2)-3(2\\cdot 1-(-2)\\cdot (-1)) \\\\  & =6-12+0 \\\\  & =-6.\\end{aligned}\n$$" 13194139533562 17592186045585 true] [17592186408145 1068 #edb/ref 17592186408143 13194139533562 17592186045585 true] [17592186408145 1069 "q-317318" 13194139533562 17592186045585 true] [17592186408145 1070 #edb/ref 17592186045485 13194139533562 17592186045585 true] [17592186408145 1071 "Let $a=⟨-1,2,4⟩$, $b=⟨0,3,1⟩$ and $c=⟨2,5,0⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n\n$-15$" 13194139533562 17592186045585 true] [17592186408145 1072 #uuid "627a3422-ad6a-5d23-b76b-6cf6cb390db2" 13194139533562 17592186045585 true] [17592186408145 1074 "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}-1 & 2 & 4 \\\\ 0 & 3 & 1 \\\\ 2 & 5 & 0\\end{aligned}| \\\\  & =(-1)\\cdot |\\begin{aligned}3 & 1 \\\\ 5 & 0\\end{aligned}|\\,-\\,2\\cdot |\\begin{aligned}0 & 1 \\\\ 2 & 0\\end{aligned}|\\,+\\,4\\cdot |\\begin{aligned}0 & 3 \\\\ 2 & 5\\end{aligned}| \\\\  & =(-1)\\,(3\\cdot 0-1\\cdot 5)\\,-\\,2\\,(0\\cdot 0-1\\cdot 2)\\,+\\,4\\,(0\\cdot 5-3\\cdot 2) \\\\  & =(-1)\\,(-5)\\,-\\,2\\,(-2)\\,+\\,4\\,(-6) \\\\  & =5+4-24 \\\\  & =-15.\\end{aligned}\n$$" 13194139533562 17592186045585 true] [17592186408146 1058 #edb/ref 17592186408150 13194139533562 17592186045585 true] [17592186408146 1062 #uuid "09e1afca-7cd5-5ac9-8a1c-381614403a24" 13194139533562 17592186045585 true] [17592186408146 1063 #edb/ref 17592186262892 13194139533562 17592186045585 true] [17592186408147 1058 #edb/ref 17592186408148 13194139533562 17592186045585 true] [17592186408147 1062 #uuid "9d367acc-118a-5937-a41c-6d7159bd7657" 13194139533562 17592186045585 true] [17592186408147 1063 #edb/ref 17592186408144 13194139533562 17592186045585 true] [17592186408148 1058 #edb/ref 17592186408149 13194139533562 17592186045585 true] [17592186408148 1062 #uuid "bf136a46-14cf-58e5-ae21-1b4fd4c26349" 13194139533562 17592186045585 true] [17592186408148 1063 #edb/ref 17592186106135 13194139533562 17592186045585 true] [17592186408149 1058 #edb/ref 17592186408146 13194139533562 17592186045585 true] [17592186408149 1062 #uuid "c9595afb-61e2-5d8f-929b-2f523416e52a" 13194139533562 17592186045585 true] [17592186408149 1063 #edb/ref 17592186341986 13194139533562 17592186045585 true] [17592186408150 1062 #uuid "ca58aca0-69d3-55b1-a46c-485edbd29743" 13194139533562 17592186045585 true] [17592186408150 1063 #edb/ref 17592186408145 13194139533562 17592186045585 true]] :edb/tempids {"activity-541e0bf9-d38c-5752-a23f-c4c9f0e075e8" 17592186408135 "answer-56ef0874-008a-597f-b2cb-02be44cd3944" 17592186408136 "answer-6d8dcecd-d942-5c7a-b18e-cb5a2602acc6" 17592186408137 "answer-9cf98593-9506-526d-9be6-5176a031c0ec" 17592186408138 "answer-a019b149-6685-5c94-9ead-07affcb89def" 17592186408139 "answer-a28f1b85-eac0-597c-848e-a2bdbc20cee3" 17592186408140 "ans