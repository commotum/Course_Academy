#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186539090} :activity/id #uuid "e6236cb7-b333-595b-87b9-895ea4f220f1" :activity/scope {:db/id #edb/ref 17592186049844 :topic/id #uuid "181a217b-aefb-5b16-abf7-81644bd30ca2" :topic/math-academy-id 96} :activity/steps [{:db/id #edb/ref 17592186539042 :step/content {:db/id #edb/ref 17592186539026 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f530b9-512a-59c4-b8dc-f3b975a5f9af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186538250}] :answer-field/correct {:db/id #edb/ref 17592186538250} :answer-field/id #uuid "259bb8b7-b747-5b79-8d8c-16284cc398a3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186538821}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f4d3cdfc-97df-54f6-9ee5-ecd71be4d0bd" :question/math-academy-id "q-215802" :question/problem "If $x=2,$ then $|x+1{|}^{2}-|x-1{|}^{3}+2=${{field-1}}." :question/worked-solution "We substitute $x=2$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|x+1{|}^{2}-|x-1{|}^{3}+2 & = \\\\ |2+1{|}^{2}-|2-1{|}^{3}+2 & = \\\\ |3{|}^{2}-|1{|}^{3}+2 & = \\\\ {3}^{2}-{1}^{3}+2 & = \\\\ 9-1+2 & = \\\\ 10 & \\end{aligned}\n$$"} :step/id #uuid "1b023f9e-0298-554e-be5a-bf787e7e1d6c" :step/next {:db/id #edb/ref 17592186539052}} {:db/id #edb/ref 17592186539052 :step/content {:db/id #edb/ref 17592186538971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da4845bf-1401-512a-8c52-28302042301c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186538733}] :answer-field/correct {:db/id #edb/ref 17592186538733} :answer-field/id #uuid "ea38a251-ab23-5c87-abfe-28a8670ee8a6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186538912}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6a42fde9-ed9b-5e9d-86c6-940fc99b7d25" :question/math-academy-id "q-215803" :question/problem "If $y=0,$ then $|2y+3{|}^{3}-|y+2|=${{field-1}}." :question/worked-solution "We substitute $y=0$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|2y+3{|}^{3}-|y+2| & = \\\\ |2(0)+3{|}^{3}-|0+2| & = \\\\ |0+3{|}^{3}-|0+2| & = \\\\ |3{|}^{3}-|2| & = \\\\ {3}^{3}-2 & = \\\\ 27-2 & = \\\\ 25 & \\end{aligned}\n$$"} :step/id #uuid "3291a708-b56a-592b-9ee3-bf5079c19589"} {:db/id #edb/ref 17592186539084 :step/content {:db/id #edb/ref 17592186538949 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b62c904-4d93-5e91-8fcd-3d63b312cd13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186538293} {:answer/id #uuid "543e9569-ebcc-52ee-b615-3c6d09b84d55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186538415} {:answer/id #uuid "5cb9b356-5932-53cb-a1f6-0aeb3ef4cb11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186538431} {:answer/id #uuid "d1540b6d-345a-5120-8ab5-0582cc400a53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186538717} {:answer/id #uuid "e404cb10-11b0-59fe-9d87-fdcbd419c82f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186538752}] :answer-field/correct {:db/id #edb/ref 17592186538431} :answer-field/id #uuid "52c1e553-d74d-59fd-a539-db479dc23184" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538846}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3e848dbc-438d-5d9d-8de6-41c96328b31b" :question/math-academy-id "q-131806" :question/problem "If $x=2$ then $|3-{2}^{x}|+4=$" :question/worked-solution "We substitute $x=2$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|3-{2}^{x}|+4 & = \\\\ |3-{2}^{2}|+4 & = \\\\ |3-4|+4 & = \\\\ |-1|+4 & = \\\\ 1+4 & = \\\\ 5\\end{aligned}\n$$"} :step/id #uuid "a08163e8-a307-5f7d-8731-fa1cbf7422a3" :step/next {:db/id #edb/ref 17592186539103}} {:db/id #edb/ref 17592186539090 :step/content {:db/id #edb/ref 17592186538969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18a638e8-6cda-5be6-a77d-f20d9d4443b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186538288} {:answer/id #uuid "18f4ba97-b8dc-5324-888d-a39a7e05bc49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186538290} {:answer/id #uuid "310cbe50-de0c-523d-89e2-0bff3267c529" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186538331} {:answer/id #uuid "3cdc4bb2-5d9e-5596-97e3-5781ff5e4c86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186538357} {:answer/id #uuid "a07da073-1567-54b2-ab82-80e4aeed8938" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186538615}] :answer-field/correct {:db/id #edb/ref 17592186538290} :answer-field/id #uuid "e60f0809-006d-5d59-8100-1de6658c3ea0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538911}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "68630caf-af8f-50ee-bc03-18c9657f8cb4" :question/math-academy-id "q-103238" :question/problem "Evaluate $|x-5|-|3-x|+2$ for $x=8.$" :question/worked-solution "We substitute $x=8$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|x-5|-|3-x|+2 & = \\\\ |8-5|-|3-8|+2 & = \\\\ |3|-|-5|+2 & = \\\\ 3-5+2 & = \\\\ 0 & \\end{aligned}\n$$"} :step/id #uuid "b0b38d0b-0e33-50a6-903b-f2396119b21a" :step/next {:db/id #edb/ref 17592186539084}} {:db/id #edb/ref 17592186539103 