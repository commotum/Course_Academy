id #uuid "b3421362-8e23-5e85-ae83-5b52d5e44df5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186492575} {:answer/id #uuid "e01edf29-ecf9-53cc-bc5d-84c6e77d2648" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-14" :db/id #edb/ref 17592186492652}] :answer-field/correct {:db/id #edb/ref 17592186492652} :answer-field/id #uuid "cef39244-d4ac-5c09-b904-ef69c6554e61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492789}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "46b75057-d4db-5536-a016-1c597f33ff13" :question/math-academy-id "q-25403" :question/problem "If $x=-9$ then $-|x-12|+7=$" :question/worked-solution "We substitute $x=-9$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}-|x-12|+7 & = \\\\ -|-9-12|+7 & = \\\\ -|-21|+7 & = \\\\ -21+7 & = \\\\ -14\\end{aligned}\n$$"} :step/id #uuid "f304f3f8-e188-5590-8410-c6b111d1b2ca" :step/next {:db/id #edb/ref 17592186492973}}] :activity/title "Absolute Value Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186492217}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186539090} :activity/id #uuid "e6236cb7-b333-595b-87b9-895ea4f220f1" :activity/scope {:db/id #edb/ref 17592186049844 :topic/id #uuid "181a217b-aefb-5b16-abf7-81644bd30ca2" :topic/math-academy-id 96} :activity/steps [{:db/id #edb/ref 17592186539042 :step/content {:db/id #edb/ref 17592186539026 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f530b9-512a-59c4-b8dc-f3b975a5f9af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186538250}] :answer-field/correct {:db/id #edb/ref 17592186538250} :answer-field/id #uuid "259bb8b7-b747-5b79-8d8c-16284cc398a3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186538821}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f4d3cdfc-97df-54f6-9ee5-ecd71be4d0bd" :question/math-academy-id "q-215802" :question/problem "If $x=2,$ then $|x+1{|}^{2}-|x-1{|}^{3}+2=${{field-1}}." :question/worked-solution "We substitute $x=2$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|x+1{|}^{2}-|x-1{|}^{3}+2 & = \\\\ |2+1{|}^{2}-|2-1{|}^{3}+2 & = \\\\ |3{|}^{2}-|1{|}^{3}+2 & = \\\\ {3}^{2}-{1}^{3}+2 & = \\\\ 9-1+2 & = \\\\ 10 & \\end{aligned}\n$$"} :step/id #uuid "1b023f9e-0298-554e-be5a-bf787e7e1d6c" :step/next {:db/id #edb/ref 17592186539052}} {:db/id #edb/ref 17592186539052 :step/content {:db/id #edb/ref 17592186538971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da4845bf-1401-512a-8c52-28302042301c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186538733}] :answer-field/correct {:db/id #edb/ref 17592186538733} :answer-field/id #uuid "ea38a251-ab23-5c87-abfe-28a8670ee8a6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186538912}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6a42fde9-ed9b-5e9d-86c6-940fc99b7d25" :question/math-academy-id "q-215803" :question/problem "If $y=0,$ then $|2y+3{|}^{3}-|y+2|=${{field-1}}." :question/worked-solution "We substitute $y=0$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|2y+3{|}^{3}-|y+2| & = \\\\ |2(0)+3{|}^{3}-|0+2| & = \\\\ |0+3{|}^{3}-|0+2| & = \\\\ |3{|}^{3}-|2| & = \\\\ {3}^{3}-2 & = \\\\ 27-2 & = \\\\ 25 & \\end{aligned}\n$$"} :step/id #uuid "3291a708-b56a-592b-9ee3-bf5079c19589"} {:db/id #edb/ref 17592186539084 :step/content {:db/id #edb/ref 17592186538949 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b62c904-4d93-5e91-8fcd-3d63b312cd13"