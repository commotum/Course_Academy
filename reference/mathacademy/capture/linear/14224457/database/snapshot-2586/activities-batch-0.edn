" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186538331} {:answer/id #uuid "3cdc4bb2-5d9e-5596-97e3-5781ff5e4c86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186538357} {:answer/id #uuid "a07da073-1567-54b2-ab82-80e4aeed8938" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186538615}] :answer-field/correct {:db/id #edb/ref 17592186538290} :answer-field/id #uuid "e60f0809-006d-5d59-8100-1de6658c3ea0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538911}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "68630caf-af8f-50ee-bc03-18c9657f8cb4" :question/math-academy-id "q-103238" :question/problem "Evaluate $|x-5|-|3-x|+2$ for $x=8.$" :question/worked-solution "We substitute $x=8$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|x-5|-|3-x|+2 & = \\\\ |8-5|-|3-8|+2 & = \\\\ |3|-|-5|+2 & = \\\\ 3-5+2 & = \\\\ 0 & \\end{aligned}\n$$"} :step/id #uuid "b0b38d0b-0e33-50a6-903b-f2396119b21a" :step/next {:db/id #edb/ref 17592186539084}} {:db/id #edb/ref 17592186539103 :step/content {:db/id #edb/ref 17592186539001 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24a75248-37a5-5151-b8cb-0f5575576d3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186538306}] :answer-field/correct {:db/id #edb/ref 17592186538306} :answer-field/id #uuid "4149acf6-bd2b-5cdb-9109-58f31fcedb99" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186538836}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b8991b67-f1ef-53f9-975f-0551777dc4d1" :question/math-academy-id "q-212313" :question/problem "If $x=1,$ then $3-|{2}^{-x}-\\frac{5}{2}|=${{field-1}}." :question/worked-solution "We substitute $x=1$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}3-|{2}^{-x}-\\frac{5}{2}| & = \\\\ 3-|{2}^{-1}-\\frac{5}{2}| & = \\\\ 3-|\\frac{1}{2}-\\frac{5}{2}| & = \\\\ 3-|-2| & = \\\\ 3-2 & = \\\\ 1\\end{aligned}\n$$"} :step/id #uuid "d775aea7-e108-5ef4-9f6e-296230133d2c" :step/next {:db/id #edb/ref 17592186539042}}] :activity/title "Absolute Value Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186538231}]}
