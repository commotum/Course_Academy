#{[{:activity/first-step {:db/id #edb/ref 17592186199407} :activity/id #uuid "5f56a4f9-bc1e-5b83-af00-1c3cf76a9018" :activity/scope {:db/id #edb/ref 17592186050916 :topic/id #uuid "708a8959-ec54-51e9-bf31-27b3539bdb74" :topic/math-academy-id 4319} :activity/steps [{:db/id #edb/ref 17592186199407 :step/content {:db/id #edb/ref 17592186199543 :tutorial/content "A linear transformation $\\mathbf{Q}:\\mathbb{R}^n \\to \\mathbb{R}^n$ is an **orthogonal linear transformation** if for any $\\mathbf{x}, \\mathbf{y} \\in \\mathbb{R}^n,$ we have that\n\n$$\n\\mathbf{Q}(\\mathbf{x}) \\cdot \\mathbf{Q}(\\mathbf{y}) = \\mathbf{x} \\cdot \\mathbf{y}.\n$$\n\nIn this case, we say that $\\mathbf{Q}$ *preserves the dot product*.\n\nThe linear transformation $\\mathbf{Q}$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $\\mathbf{Q}$ relative to any orthonormal basis (including the standard basis) of $\\mathbb{R}^n$ is orthogonal.\n\n- $\\| \\mathbf{Q}(\\mathbf{x}) \\| = \\| \\mathbf{x} \\|$. In other words, $\\mathbf{Q}$ preserves vector norms.\n\n- If $\\mathbf{x} \\perp \\mathbf{y}$ then $\\mathbf{Q}(\\mathbf{x}) \\perp \\mathbf{Q}(\\mathbf{y})$ for any $\\mathbf{x}, \\mathbf{y} \\in \\mathbb{R}^n.$ In general, $\\mathbf{Q}$ preserves the angle between any two vectors.\n\n- $\\mathbf{Q}$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set." :tutorial/id #uuid "fed8f501-fcb5-5852-bf23-1e999e4c9e1e" :tutorial/math-academy-id 8098 :tutorial/title "Introduction"} :step/id #uuid "1ef8589c-4324-58ea-9201-f5ba88997554" :step/math-academy-id 52322 :step/next {:db/id #edb/ref 17592186199408}} {:db/id #edb/ref 17592186199408 :step/content {:db/id #edb/ref 17592186198454 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198137 :question/id #uuid "0070a453-0237-571f-84fc-a9f58446e6a9" :question/math-academy-id "e-12954"} :knowledge-point/id #uuid "455b3713-34a3-535d-8baf-d279a0341e9f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048855} {:db/id #edb/ref 17592186049051} {:db/id #edb/ref 17592186049612}] :knowledge-point/questions [{:db/id #edb/ref 17592186198984} {:db/id #edb/ref 17592186198985} {:db/id #edb/ref 17592186284763} {:db/id #edb/ref 17592186284764} {:db/id #edb/ref 17592186284765} {:db/id #edb/ref 17592186326853}] :knowledge-point/title "Applying the Angle Preserving Property of Orthogonal Linear Transformations"} :step/id #uuid "8416cf3f-5dd0-52a4-a389-a27f110ac992" :step/math-academy-id 52323 :step/next {:db/id #edb/ref 17592186199409}} {:db/id #edb/ref 17592186199409 :step/content {:db/id #edb/ref 17592186198455 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198136 :question/id #uuid "a77db107-d157-5063-b44a-1ca0a93be099" :question/math-academy-id "e-12951"} :knowledge-point/id #uuid "b4a5d6b1-e76a-5b33-8973-04d1d9062dc6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049817}] :knowledge-point/questions [{:db/id #edb/ref 17592186198755} {:db/id #edb/ref 17592186198756} {:db/id #edb/ref 17592186284754} {:db/id #edb/ref 17592186284767} {:db/id #edb/ref 17592186284770}] :knowledge-point/title "Identifying the Orthogonality of a Two-Vector Set"} :step/id #uuid "49d42b8f-bd36-5613-9a00-8f0c28f5f77d" :step/math-academy-id 52326}] :activity/title "Orthogonal Linear Transformations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186198530}]}
