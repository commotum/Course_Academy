#{[{:activity/first-step {:db/id #edb/ref 17592186199407} :activity/id #uuid "5f56a4f9-bc1e-5b83-af00-1c3cf76a9018" :activity/scope {:db/id #edb/ref 17592186050916 :topic/id #uuid "708a8959-ec54-51e9-bf31-27b3539bdb74" :topic/math-academy-id 4319} :activity/steps [{:db/id #edb/ref 17592186199407 :step/content {:db/id #edb/ref 17592186199543 :tutorial/content "A linear transformation $\\mathbf{Q}:\\mathbb{R}^n \\to \\mathbb{R}^n$ is an **orthogonal linear transformation** if for any $\\mathbf{x}, \\mathbf{y} \\in \\mathbb{R}^n,$ we have that\n\n$$\n\\mathbf{Q}(\\mathbf{x}) \\cdot \\mathbf{Q}(\\mathbf{y}) = \\mathbf{x} \\cdot \\mathbf{y}.\n$$\n\nIn this case, we say that $\\mathbf{Q}$ *preserves the dot product*.\n\nThe linear transformation $\\mathbf{Q}$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $\\mathbf{Q}$ relative to any orthonormal basis (including the standard basis) of $\\mathbb{R}^n$ is orthogonal.\n\n- $\\| \\mathbf{Q}(\\mathbf{x}) \\| = \\| \\mathbf{x} \\|$. In other words, $\\mathbf{Q}$ preserves vector norms.\n\n- If $\\mathbf{x} \\perp \\mathbf{y}$ then $\\mathbf{Q}(\\mathbf{x}) \\perp \\mathbf{Q}(\\mathbf{y})$ for any $\\mathbf{x}, \\mathbf{y} \\in \\mathbb{R}^n.$ In general, $\\mathbf{Q}$ preserves the angle between any two vectors.\n\n- $\\mathbf{Q}$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set." :tutorial/id #uuid "fed8f501-fcb5-5852-bf23-1e999e4c9e1e" :tutorial/math-academy-id 8098 :tutorial/title "Introduction"} :step/id #uuid "1ef8589c-4324-58ea-9201-f5ba88997554" :step/math-academy-id 52322 :step/next {:db/id #edb/ref 17592186199408}} {:db/id #edb/ref 17592186199408 :step/content {:db/id #edb/ref 17592186198454 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198137 :question/id #uuid "0070a453-0237-571f-84fc-a9f58446e6a9" :question/math-academy-id "e-12954"} :knowledge-point/id #uuid "455b3713-34a3-535d-8baf-d279a0341e9f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048855} {:db/id #edb/ref 17592186049051} {:db/id #edb/ref 17592186049612}] :knowledge-point/questions [{:db/id #edb/ref 17592186198984} {:db/id #edb/ref 17592186198985} {:db/id #edb/ref 17592186284763} {:db/id #edb/ref 17592186284764} {:db/id #edb/ref 17592186284765} {:db/id #edb/ref 17592186326853} {:db/id #edb/ref 17592186406685} {:db/id #edb/ref 17592186406687}] :knowledge-point/title "Applying the Angle Preserving Property of Orthogonal Linear Transformations"} :step/id #uuid "8416cf3f-5dd0-52a4-a389-a27f110ac992" :step/math-academy-id 52323 :step/next {:db/id #edb/ref 17592186199409}} {:db/id #edb/ref 17592186199409 :step/content {:db/id #edb/ref 17592186198455 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198136 :question/id #uuid "a77db107-d157-5063-b44a-1ca0a93be099" :question/math-academy-id "e-12951"} :knowledge-point/id #uuid "b4a5d6b1-e76a-5b33-8973-04d1d9062dc6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049817}] :knowledge-point/questions [{:db/id #edb/ref 17592186198755} {:db/id #edb/ref 17592186198756} {:db/id #edb/ref 17592186284754} {:db/id #edb/ref 17592186284767} {:db/id #edb/ref 17592186284770} {:db/id #edb/ref 17592186406686}] :knowledge-point/title "Identifying the Orthogonality of a Two-Vector Set"} :step/id #uuid "49d42b8f-bd36-5613-9a00-8f0c28f5f77d" :step/math-academy-id 52326}] :activity/title "Orthogonal Linear Transformations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186198530}] [{:activity/course {:db/id #edb/ref 17592186046679} :activity/first-step {:db/id #edb/ref 17592186406688} :activity/id #uuid "11d38e3f-6339-5429-8d89-8272fca9a35c" :activity/scope {:db/id #edb/ref 17592186050916 :topic/id #uuid "708a8959-ec54-51e9-bf31-27b3539bdb74" :topic/math-academy-id 4319} :activity/steps [{:db/id #edb/ref 17592186406688 :step/content {:db/id #edb/ref 17592186406687 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33d47db5-c434-55d6-9456-167ab8a0b67c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "7" :db/id #edb/ref 17592186406672} {:answer/id #uuid "7c3a74ea-6a6d-5da3-b53b-157fcb966ead" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-1" :db/id #edb/ref 17592186406674} {:answer/id #uuid "b81c5bc9-bfe5-5ce5-928d-fa684e207472" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-5" :db/id #edb/ref 17592186406676} {:answer/id #uuid "c6a8591a-2779-5016-a0d3-d51746099b13" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "9" :db/id #edb/ref 17592186406678} {:answer/id #uuid "f3f62bc1-8a13-5efa-ad9a-759018432b14" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "17" :db/id #edb/ref 17592186406681}] :answer-field/correct {:db/id #edb/ref 17592186406672} :answer-field/id #uuid "ac075b6f-3299-5310-ad52-26f9cf648385" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406684}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cf616da5-d6d0-5837-a9fb-64c2cf137040" :question/math-academy-id "q-40488" :question/problem "Let $Q$ be an orthogonal linear transformation. Find $Q(x)\\cdot Q(y)$, where $x=[\\begin{aligned}1 \\\\ 3 \\\\ -2\\end{aligned}]$ and $y=[\\begin{aligned}-3 \\\\ 4 \\\\ 1\\end{aligned}].$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nIn this case, since $Q$ is orthogonal, we have \n\n$$\n\\begin{aligned}Q(x)\\cdot Q(y) & =x\\cdot y \\\\  & =1\\cdot (-3)+3\\cdot 4+(-2)\\cdot 1 \\\\  & =7.\\end{aligned}\n$$"} :step/id #uuid "0bda9774-6623-5015-9c4f-2876bc204742" :step/next {:db/id #edb/ref 17592186406689}} {:db/id #edb/ref 17592186406689 :step/content {:db/id #edb/ref 17592186406686 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dfd22c3-475e-57e7-a43b-2426876d96a9" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "$U$ and $W$ only" :db/id #edb/ref 17592186406667} {:answer/id #uuid "18261590-5d63-59fa-a5a2-24d4904d43be" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "$U$ only" :db/id #edb/ref 17592186406668} {:answer/id #uuid "25feb7c8-dd5c-59a1-bec8-c633a782af5e" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "$V$ and $W$ only" :db/id #edb/ref 17592186406670} {:answer/id #uuid "2eca64ea-f21c-59ab-b00b-5d3ef14bd0fb" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "$W$ only" :db/id #edb/ref 17592186406671} {:answer/id #uuid "d2e6fe6e-e075-5371-baff-975eb86d75ba" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "$U$ and $V$ only" :db/id #edb/ref 17592186406679}] :answer-field/correct {:db/id #edb/ref 17592186406667} :answer-field/id #uuid "90932faf-686a-5262-b048-f69de0f0ccfb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406683}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9892c6c7-24de-57f2-a3e8-0b32de0c1349" :question/math-academy-id "q-40491" :question/problem "Let $Q$ be an orthogonal linear transformation. Which of the following are orthogonal sets?\n\n- $U={Q([\\begin{aligned}9 \\\\ 6\\end{aligned}]),Q([\\begin{aligned}2 \\\\ -3\\end{aligned}])}$\n- $W={Q([\\begin{aligned}\\frac{1}{6} \\\\ 1\\end{aligned}]),Q([\\begin{aligned}6 \\\\ -1\\end{aligned}])}$\n- $V={Q([\\begin{aligned}2 \\\\ 3 \\\\ 5\\end{aligned}]),Q([\\begin{aligned}1 \\\\ 4 \\\\ -1\\end{aligned}]),Q([\\begin{aligned}3 \\\\ 3 \\\\ -3\\end{aligned}])}$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nLet's denote the elements of $U,W,$ and $V$ respectively as \n\n$\\,$ ${Q({u}_{1}),Q({u}_{2})},\\,$ ${Q({w}_{1}),Q({w}_{2})},\\,$ and $\\,{Q({v}_{1}),Q({v}_{2}),Q({v}_{3})}.$ \n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- $Q({u}_{1})\\cdot Q({u}_{2})=0.$\n\n- $Q({w}_{1})\\cdot Q({w}_{2})=0.$\n\n- $Q({v}_{1})\\cdot Q({v}_{2})=0,\\,Q({v}_{1})\\cdot Q({v}_{3})=0,\\,Q({v}_{2})\\cdot Q({v}_{3})=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get \n\n$$\n\\begin{aligned}Q({u}_{1})\\cdot Q({u}_{2}) & ={u}_{1}\\cdot {u}_{2}=[\\begin{aligned}9 \\\\ 6\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -3\\end{aligned}]=18-18=0.\\,✓\\end{aligned}\n$$\n\nSo, the set $U$ is orthogonal.\n\n- For the set $W,$ we get \n\n$$\n\\begin{aligned}Q({w}_{1})\\cdot Q({w}_{2}) & ={w}_{1}\\cdot {w}_{2}=[\\begin{aligned}\\frac{1}{6} \\\\ 1\\end{aligned}]\\cdot [\\begin{aligned}6 \\\\ -1\\end{aligned}]=1-1=0.\\,✓\\end{aligned}\n$$\n\nSo, the set $W$ is orthogonal.\n\n- For the Set $V,$ notice that \n\n$$\n\\begin{aligned}Q({v}_{1})\\cdot Q({v}_{2}) & ={v}_{1}\\cdot {v}_{2}=[\\begin{aligned}2 \\\\ 3 \\\\ 5\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 4 \\\\ -1\\end{aligned}]=2+12-5=9\\ne 0.\\,\\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthogonal set.\n\nTherefore, the correct answer is \"$U$ and $W$ only\"."} :step/id #uuid "5c0620be-2d88-50a9-b295-5b90712b0a8b" :step/next {:db/id #edb/ref 17592186406690}} {:db/id #edb/ref 17592186406690 :step/content {:db/id #edb/ref 17592186406685 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24e42699-a0f0-5e81-a194-c91514b7e8ae" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186406669} {:answer/id #uuid "46c27bd0-b639-51d1-a04d-8098da45991e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "6" :db/id #edb/ref 17592186406673} {:answer/id #uuid "b3565871-fc75-5a3f-bb6e-506cbb0458f5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "4" :db/id #edb/ref 17592186406675} {:answer/id #uuid "bfd57b0f-3965-5b70-833f-7fa36e06ae4f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "3" :db/id #edb/ref 17592186406677} {:answer/id #uuid "e14e0ad1-a7b2-5023-b79c-bff39fbd35df" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "6\\sqrt{2}" :db/id #edb/ref 17592186406680}] :answer-field/correct {:db/id #edb/ref 17592186406675} :answer-field/id #uuid "491c6e1c-81dd-5170-b618-833ce2679d93" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406682}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8a69da2c-f673-5e64-a265-9fe904a3c9ad" :question/math-academy-id "q-40514" :question/problem "Let $Q$ be an orthogonal linear transformation. Find $‖Q(x)‖$, where $x=[\\begin{aligned}\\sqrt{6} \\\\ 1 \\\\ 3\\end{aligned}].$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nIn this case, since $Q$ is orthogonal, we have \n\n$$\n\\begin{aligned}‖Q(x)‖ & =‖x‖ \\\\  & =\\sqrt{{x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}} \\\\  & =\\sqrt{{(\\sqrt{6})}^{2}+{1}^{2}+{3}^{2}} \\\\  & =4.\\end{aligned}\n$$"} :step/id #uuid "c999b8fd-0d25-5711-adf5-8e3f0c95ef68"}] :activity/title "Orthogonal Linear Transformations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186406666}]}
