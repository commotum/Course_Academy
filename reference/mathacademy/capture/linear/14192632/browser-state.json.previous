          "dom_index": 0,
          "disabled": false,
          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:60px;\n                                        margin-left:2px;\n                                        margin-right:1px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"13\"><span class=\"mq-non-leaf\" mathquill-command-id=\"23\"><span class=\"mq-scaled mq-paren\" style=\"transform: scale(0.997101, 1.18261);\">|</span><span class=\"mq-non-leaf\" mathquill-block-id=\"17\"><var mathquill-command-id=\"16\">x</var><span mathquill-command-id=\"18\" class=\"mq-binary-operator\">−</span><span mathquill-command-id=\"20\">7</span></span><span class=\"mq-scaled mq-paren\" style=\"transform: scale(0.997101, 1.18261);\">|</span></span></span></div></div>",
