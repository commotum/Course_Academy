#{[{:db/id #edb/ref 17592186082947 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083189 :knowledge-point/id #uuid "61ec00a6-06ae-5d78-bb1a-b06351432cc3" :knowledge-point/title "Graphing a Vertical Translation"}] :question/id #uuid "5a2db9be-6ef3-5466-a7cc-4e7e2b5670ec" :question/math-academy-id "e-14919" :question/problem "Sketch the graph of $y=|x|-3$." :question/worked-solution "Remember that $y=|x|+a$ is a vertical translation of the absolute value graph $y=|x|$ by $a$ units up.\n\nThe function $y=|x|-3$ has $a=-3.$ Therefore, it is a vertical translation of the absolute value graph $y=|x|$ by $3$ units *down*.\n\n![](images/72/7266634257d662b0af75fdb80d402acaa779df2ed4b62fc43c074a7f4f902de0.png)"}] [{:db/id #edb/ref 17592186082948 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083190 :knowledge-point/id #uuid "05cffafa-cfcf-5979-a413-b7d0b66dd434" :knowledge-point/title "Graphing a Horizontal Translation"}] :question/id #uuid "2e688f8d-16cc-58d6-8791-538cc335ce04" :question/math-academy-id "e-14925" :question/problem "Sketch the graph of $y=|x-3|$." :question/worked-solution "Remember that $y=|x-a|$ is a horizontal translation of the absolute value graph $y=|x|$ by $a$ units right.\n\nThe function $y=|x-3|$ has $a=3.$ Therefore, it is a horizontal translation of the absolute value graph $y=|x|$ by $3$ units right.\n\n![](images/eb/ebe57ac4935c6ffc84abf20de2959c0f6f543514821ff32900fba65515b55646.png)\n\n**Watch Out!** It's easy to confuse the translations $y=|x-3|$ and $y=|x+3|$. The graph of $y=|x-3|$ is shifted to the right and the graph of $y=|x+3|$ is shifted to the left, even though it seems like it should be the other way around."}] [{:db/id #edb/ref 17592186082949 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083191 :knowledge-point/id #uuid "ca5dcf12-db1a-5cfc-b369-986caa8f666c" :knowledge-point/title "Combining Horizontal and Vertical Translations"}] :question/id #uuid "82de263c-391b-5d45-bbd6-353c31c806fc" :question/math-academy-id "e-14933" :question/problem "Sketch the graph of $y=|x+1|+2$." :question/worked-solution "Remember that $y=|x-h|+k$ is a translation of the absolute value graph $y=|x|$ by $h$ units right and $k$ units up.\n\nThe function $y=|x+1|+2$ has $h=-1$ and $k=2.$ Therefore, it is a translation of the absolute value graph $y=|x|$ by $1$ unit *left* and $2$ units up.\n\n![](images/e8/e80f640da0a2e6e6c1e14790f66b6a05747f6149dddc8a14fc48932bd5e696eb.png)"}] [{:db/id #edb/ref 17592186083554 :knowledge-point/_questions [{:db/id #edb/ref 17592186083189 :knowledge-point/id #uuid "61ec00a6-06ae-5d78-bb1a-b06351432cc3" :knowledge-point/title "Graphing a Vertical Translation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "682ded9a-2dd4-583d-bcdc-b3e447a9e368" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-2)" :db/id #edb/ref 17592186080224} {:answer/id #uuid "2e66c3cc-f7cf-58f5-8192-9227767d5b9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186505994} {:answer/id #uuid "4cb06b3e-9c0f-5dc0-838e-f4036f7adaaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,0)" :db/id #edb/ref 17592186506041} {:answer/id #uuid "8b5c1d6e-5e25-5bb0-95f8-e06759a9b228" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186506152} {:answer/id #uuid "f86ba674-714b-56cb-b55c-60ac41f9871e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,2)" :db/id #edb/ref 17592186506366}] :answer-field/correct {:answer/id #uuid "f86ba674-714b-56cb-b55c-60ac41f9871e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,2)" :db/id #edb/ref 17592186506366} :answer-field/id #uuid "e6f379ff-f33d-58bb-bbf9-df5e15f00cc4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186080219}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "28a546d4-15ea-50f3-baba-d0f944994712" :question/math-academy-id "q-15819" :question/problem "If $y=|x|+2$, what are the coordinates of the minimum point on the graph?" :question/worked-solution "Remember that $y=|x|+a$ is a vertical translation of the absolute value graph $y=|x|$ by $a$ units up.\n\nThe function $y=|x|+2$ has $a=2.$ Therefore, it is a vertical translation of the absolute value graph $y=|x|$ by $2$ units up.\n\n![](images/47/47bab8c5a2fa41bbe03dd6d5ed8d3c4a7d005e3cbb0eefdd258ff0ecbd61ee5c.png)\n\nLooking at the graph, we can see that the coordinates of the minimum point are $(0,2).$"}] [{:db/id #edb/ref 17592186506530 :knowledge-point/_questions [{:db/id #edb/ref 17592186083191 :knowledge-point/id #uuid "ca5dcf12-db1a-5cfc-b369-986caa8f666c" :knowledge-point/title "Combining Horizontal and Vertical Translations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b14bbe4-bb62-5df0-a7d7-eddd893f69d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,4)" :db/id #edb/ref 17592186506070} {:answer/id #uuid "6e72b2cb-449b-5006-a14c-2f45b8a444b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,3)" :db/id #edb/ref 17592186506108} {:answer/id #uuid "87e4b0ca-ea36-5d56-96c6-2a601c9e1f2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,3)" :db/id #edb/ref 17592186506149} {:answer/id #uuid "8b6ac952-7ce7-51a9-a901-e7e424ad44bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,4)" :db/id #edb/ref 17592186506153} {:answer/id #uuid "ebb51025-d133-5cbf-a693-beb08481d006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,-3)" :db/id #edb/ref 17592186506343}] :answer-field/correct {:answer/id #uuid "6e72b2cb-449b-5006-a14c-2f45b8a444b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,3)" :db/id #edb/ref 17592186506108} :answer-field/id #uuid "f8dbe3da-a555-5efe-9207-dbf146e7141d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186506506}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2d5712de-7b42-579e-9943-a685763e7f7c" :question/math-academy-id "q-15822" :question/problem "If $y=|x-4|+3$, what are the coordinates of the minimum point on the graph?" :question/worked-solution "Remember that $y=|x-h|+k$ is a vertical translation of the absolute value graph $y=|x|$ by $h$ units right and $k$ units up.\n\nThe function $y=|x-4|+3$ has $h=4$ and $k=3.$ Therefore, it is a translation of the absolute value graph $y=|x|$ by $4$ units *right* and $3$ units *up*.\n\n![](images/a0/a0a914b0961f151f2b05b18e30feabb304915c016ee9552251130aa740a4e715.png)\n\nLooking at the graph, we can see that the coordinates of the minimum point are $(4,3).$"}] [{:db/id #edb/ref 17592186506600 :knowledge-point/_questions [{:db/id #edb/ref 17592186083189 :knowledge-point/id #uuid "61ec00a6-06ae-5d78-bb1a-b06351432cc3" :knowledge-point/title "Graphing a Vertical Translation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b32a26f2-a0a7-56e6-a8d4-7226c80af79b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left|x\\right|-8" :db/id #edb/ref 17592186506237}] :answer-field/correct {:answer/id #uuid "b32a26f2-a0a7-56e6-a8d4-7226c80af79b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left|x\\right|-8" :db/id #edb/ref 17592186506237} :answer-field/id #uuid "bbe57635-9ea1-50d5-b454-9cab79720de9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186506468}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ed33137c-8a0a-513d-a96f-11ce31e8009b" :question/math-academy-id "q-222329" :question/problem "![](images/66/66a45a4a2f5a794b53c05f5886fe944d7a2fd3d0344c3e25fc5a9d0c1984006f.png)\n\nThe graph above shows the image of the graph $y=|x|$ under the action of a single translation. What is the equation of this curve?\n\nThe equation of this curve is $y=$\n{{field-1}}." :question/worked-solution "Remember that $y=|x|+a$ is a vertical translation of the absolute value graph $y=|x|$ by $a$ units up.\n\nHere, the graph is moved down by $8$ units. This corresponds to $a=-8.$ \n\nTherefore, the equation of the curve is $y=|x|-8.$\n\n![](images/47/477932b4bf3420b86a105da3ffe8c554ff9778fe574d62ef4625a29834b2ec83.png)"}] [{:db/id #edb/ref 17592186506528 :knowledge-point/_questions [{:db/id #edb/ref 17592186083190 :knowledge-point/id #uuid "05cffafa-cfcf-5979-a413-b7d0b66dd434" :knowledge-point/title "Graphing a Horizontal Translation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69059512-0123-51a4-ba8c-37e6d06f1ef4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left|x-7\\right|" :db/id #edb/ref 17592186506089}] :answer-field/correct {:answer/id #uuid "69059512-0123-51a4-ba8c-37e6d06f1ef4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left|x-7\\right|" :db/id #edb/ref 17592186506089} :answer-field/id #uuid "557637a6-25ce-583e-8770-0b00d28d71bc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186506413}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "276e0cea-6920-5a35-bd19-e10e6d09e8ad" :question/math-academy-id "q-222357" :question/problem "![](images/ce/ce3b78035978226d9b095a4746d76b090a9225e2c6eaf20a6a19a2857c056f98.png)\n\nThe graph above shows the image of the graph $y=|x|$ under the action of a single translation. What is the equation of this curve?\n\nThe equation of this curve is\n$y=$\n{{field-1}}." :question/worked-solution "Remember that $y=|x-a|$ is a horizontal translation of the absolute value graph $y=|x|$ by $a$ units right.\n\nNotice that here, the graph is moved *right* by $7$ units. This corresponds to $a=7.$\n\n Therefore, the equation of the curve is $y=|x-7|.$\n\n![](images/4b/4be0b85e84626fa9960cb44017209b842cec090d1dfd409a290721a7250caf6c.png)"}] [{:db/id #edb/ref 17592186506595 :knowledge-point/_questions [{:db/id #edb/ref 17592186083191 :knowledge-point/id #uuid "ca5dcf12-db1a-5cfc-b369-986caa8f666c" :knowledge-point/title "Combining Horizontal and Vertical Translations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97361026-0945-559f-ace7-f7afd35162ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186506172}] :answer-field/correct {:answer/id #uuid "97361026-0945-559f-ace7-f7afd35162ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186506172} :answer-field/id #uuid "f46ad421-de88-5153-8d34-6ba10a17d548" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186506499}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e80f0782-a7b9-5425-b344-19fe7f2eb11e" :question/math-academy-id "q-222359" :question/problem "The minimum value of the function $y=|x+1|+3$ is $y=${{field-1}}." :question/worked-solution "Remember that $y=|x-h|+k$ is a vertical translation of the absolute value graph $y=|x|$ by $h$ units right and $k$ units up.\n\nThe function $y=|x+1|+3$ has $h=-1$ and $k=3.$ Therefore, it is a translation of the absolute value graph $y=|x|$ by $1$ unit *left* and $3$ units *up*.\n\n![](images/aa/aabce12b2665678053ad7a440be44dc0b73e37d2ab45664a2347f55c14641b2a.png)\n\nLooking at the graph, we can see that the minimum value of $y$ is $3.$"}] [{:db/id #edb/ref 17592186083676 :knowledge-point/_questions [{:db/id #edb/ref 17592186083190 :knowledge-point/id #uuid "05cffafa-cfcf-5979-a413-b7d0b66dd434" :knowledge-point/title "Graphing a Horizontal Translation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05053c27-bf42-59a1-ad29-2607a9d8d05a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2|x|" :db/id #edb/ref 17592186505928} {:answer/id #uuid "5d74c09d-980c-52cc-b153-8f9ef9eaee8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=|x|+2" :db/id #edb/ref 17592186506073} {:answer/id #uuid "675c91da-7f14-501a-96c7-9d6ca516b68d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=|x|-2" :db/id #edb/ref 17592186506086} {:answer/id #uuid "690d0474-f26e-57d5-bcb3-5886ad3b4d93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=|x-2|" :db/id #edb/ref 17592186506090} {:answer/id #uuid "7e600479-7010-5639-af9a-cb25ab59f26e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=|x+2|" :db/id #edb/ref 17592186506130}] :answer-field/correct {:answer/id #uuid "690d0474-f26e-57d5-bcb3-5886ad3b4d93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=|x-2|" :db/id #edb/ref 17592186506090} :answer-field/id #uuid "cee33c1c-d05c-56ce-957b-777342b20af5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186080987}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4d93ade0-ed53-54e6-9369-4b83f3ad2124" :question/math-academy-id "q-3677" :question/problem "![](images/6e/6e662d75baca8ed3220915e3ff47daf32c4d25c34933a0188e29c404664273c7.png)\n\nWhat is the equation of the curve shown above?" :question/worked-solution "Remember that the graph of $y=|x-a|$ is a horizontal translation of the absolute value graph $y=|x|$ by $a$ units right.\n\nHere, the graph is moved *right* by $2$ units. This corresponds to $a=2.$ So, the equation of the graph is $y=|x-2|.$\n\n![](images/3c/3c305a89fe9fd400cd9c58cfb12522b143b2654a49fa58aee582ba1100f94daa.png)"}]}
