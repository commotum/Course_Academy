#{[{:db/id #edb/ref 17592186082947 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083189 :knowledge-point/id #uuid "61ec00a6-06ae-5d78-bb1a-b06351432cc3" :knowledge-point/title "Graphing a Vertical Translation"}] :question/id #uuid "5a2db9be-6ef3-5466-a7cc-4e7e2b5670ec" :question/math-academy-id "e-14919" :question/problem "Sketch the graph of $y= \\mid x \\mid -3$." :question/worked-solution "Remember that\n\n$$\ny= \\mid x \\mid +a\n$$\n\nis a vertical translation of the absolute value graph\n\n$$\ny= \\mid x \\mid\n$$\n\nby $a$ units up.\n\nThe function\n\n$$\ny= \\mid x \\mid -3\n$$\n\nhas $a=-3$. Therefore, it is a vertical translation of the absolute value graph\n\n$$\ny= \\mid x \\mid\n$$\n\nby $3$ units *down*.\n\n![](images/72/7266634257d662b0af75fdb80d402acaa779df2ed4b62fc43c074a7f4f902de0.png)"}] [{:db/id #edb/ref 17592186082948 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083190 :knowledge-point/id #uuid "05cffafa-cfcf-5979-a413-b7d0b66dd434" :knowledge-point/title "Graphing a Horizontal Translation"}] :question/id #uuid "2e688f8d-16cc-58d6-8791-538cc335ce04" :question/math-academy-id "e-14925" :question/problem "Sketch the graph of $y= \\mid x-3 \\mid$." :question/worked-solution "Remember that\n\n$$\ny= \\mid x-a \\mid\n$$\n\nis a horizontal translation of the absolute value graph\n\n$$\ny= \\mid x \\mid\n$$\n\nby $a$ units right.\n\nThe function\n\n$$\ny= \\mid x-3 \\mid\n$$\n\nhas $a=3$. Therefore, it is a horizontal translation of the absolute value graph\n\n$$\ny= \\mid x \\mid\n$$\n\nby $3$ units right.\n\n![](images/eb/ebe57ac4935c6ffc84abf20de2959c0f6f543514821ff32900fba65515b55646.png)\n\n**Watch Out!** It's easy to confuse the translations\n\n$$\ny= \\mid x-3 \\mid\n$$\n\nand\n\n$$\ny= \\mid x+3 \\mid\n$$\n\n. The graph of\n\n$$\ny= \\mid x-3 \\mid\n$$\n\nis shifted to the right and the graph of\n\n$$\ny= \\mid x+3 \\mid\n$$\n\nis shifted to the left, even though it seems like it should be the other way around."}] [{:db/id #edb/ref 17592186082949 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083191 :knowledge-point/id #uuid "ca5dcf12-db1a-5cfc-b369-986caa8f666c" :knowledge-point/title "Combining Horizontal and Vertical Translations"}] :question/id #uuid "82de263c-391b-5d45-bbd6-353c31c806fc" :question/math-academy-id "e-14933" :question/problem "Sketch the graph of $y= \\mid x+1 \\mid +2$." :question/worked-solution "Remember that\n\n$$\ny= \\mid x-h \\mid +k\n$$\n\nis a translation of the absolute value graph\n\n$$\ny= \\mid x \\mid\n$$\n\nby $h$ units right and $k$ units up.\n\nThe function\n\n$$\ny= \\mid x+1 \\mid +2\n$$\n\nhas $h=-1$ and $k=2$. Therefore, it is a translation of the absolute value graph\n\n$$\ny= \\mid x \\mid\n$$\n\nby $1$ unit *left* and $2$ units up.\n\n![](images/e8/e80f640da0a2e6e6c1e14790f66b6a05747f6149dddc8a14fc48932bd5e696eb.png)"}] [{:db/id #edb/ref 17592186083554 :knowledge-point/_questions [{:db/id #edb/ref 17592186083189 :knowledge-point/id #uuid "61ec00a6-06ae-5d78-bb1a-b06351432cc3" :knowledge-point/title "Graphing a Vertical Translation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "926a1c5a-83db-5783-b682-b5093a16b043" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2, 0)" :db/id #edb/ref 17592186080220} {:answer/id #uuid "b4b868da-77ed-5eec-bfca-653444846504" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0, 0)" :db/id #edb/ref 17592186080221} {:answer/id #uuid "bb61d09c-9bef-526e-a431-ed865e5d3456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0, 2)" :db/id #edb/ref 17592186080222} {:answer/id #uuid "d447a52e-5f28-546c-bdfe-8158a0cb5396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2, 0)" :db/id #edb/ref 17592186080223} {:answer/id #uuid "682ded9a-2dd4-583d-bcdc-b3e447a9e368" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-2)" :db/id #edb/ref 17592186080224}] :answer-field/id #uuid "e6f379ff-f33d-58bb-bbf9-df5e15f00cc4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186080219}] :question/id #uuid "28a546d4-15ea-50f3-baba-d0f944994712" :question/math-academy-id "q-15819" :question/problem "If $y = \\mid x \\mid + 2$, what are the coordinates of the minimum point on the graph?"}] [{:db/id #edb/ref 17592186083676 :knowledge-point/_questions [{:db/id #edb/ref 17592186083190 :knowledge-point/id #uuid "05cffafa-cfcf-5979-a413-b7d0b66dd434" :knowledge-point/title "Graphing a Horizontal Translation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd326570-5cfb-509b-b032-75403ccbfffb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = \\mid x - 2 \\mid" :db/id #edb/ref 17592186080988} {:answer/id #uuid "fd797849-ceed-5a3a-82c0-cb3e5398f9ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = 2 \\mid x \\mid" :db/id #edb/ref 17592186080989} {:answer/id #uuid "ff53adeb-1f30-5328-a3bf-ff4d5d51695b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = \\mid x + 2 \\mid" :db/id #edb/ref 17592186080990} {:answer/id #uuid "350503ec-5a13-512f-8efe-e9ff5fd383c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = \\mid x \\mid + 2" :db/id #edb/ref 17592186080991} {:answer/id #uuid "6212a032-8185-5ceb-8a00-9014749929a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = \\mid x \\mid - 2" :db/id #edb/ref 17592186080992}] :answer-field/id #uuid "cee33c1c-d05c-56ce-957b-777342b20af5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186080987}] :question/id #uu