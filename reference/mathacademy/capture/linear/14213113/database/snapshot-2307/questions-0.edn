#{[{:db/id #edb/ref 17592186523959 :knowledge-point/_questions [{:db/id #edb/ref 17592186054807 :knowledge-point/id #uuid "b509b42a-c38a-5400-8f93-f3e9024b16a2" :knowledge-point/title "Identifying the Coordinates of a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36e48d3d-4733-542f-98fa-3ea3a4663971" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186523371}] :answer-field/correct {:answer/id #uuid "36e48d3d-4733-542f-98fa-3ea3a4663971" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186523371} :answer-field/id #uuid "875d3e82-b9de-5b7b-af8a-882e7608648a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523860} {:answer-field/choices [{:answer/id #uuid "234a4add-4112-5e4c-9cd7-e931f52bb5e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186523324}] :answer-field/correct {:answer/id #uuid "234a4add-4112-5e4c-9cd7-e931f52bb5e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186523324} :answer-field/id #uuid "9e0c4408-e28e-501a-87bf-74e351180982" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523870}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5d427fb2-847d-5c45-9124-9759bd9b4b84" :question/math-academy-id "q-167067" :question/problem "What are the $xy$-coordinates of the point $A?$\n\n$A\\,($\n{{field-1}}\n$,\\,$\n{{field-2}}\n$)$" :question/worked-solution "To find the coordinates of the point, we inspect its position along the $x$- and $y$-axes.\n\n* The point is $2$ units to the *left* of the origin, in the *negative* direction of the $x$-axis. So, its $x$-coordinate is $-2.$\n\n* The point is $3$ units *above* the origin, in the *positive* direction of the $y$-axis. So, its $y$-coordinate is $3.$\n\nTherefore, the coordinates of our point are $(-2,3).$"}] [{:db/id #edb/ref 17592186523961 :knowledge-point/_questions [{:db/id #edb/ref 17592186054669 :knowledge-point/id #uuid "bf635847-145c-5da5-927e-8196e809324e" :knowledge-point/title "Points Associated With Horizontal and Vertical Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c453d67a-491f-52bb-bf5b-d73d3745c964" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4" :db/id #edb/ref 17592186523664}] :answer-field/correct {:answer/id #uuid "c453d67a-491f-52bb-bf5b-d73d3745c964" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4" :db/id #edb/ref 17592186523664} :answer-field/id #uuid "2a7dc394-988b-531c-a6fb-3a938bffd1dc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523810} {:answer-field/choices [{:answer/id #uuid "d1f16580-85bc-52cc-b5fd-1be71020ec6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186523698}] :answer-field/correct {:answer/id #uuid "d1f16580-85bc-52cc-b5fd-1be71020ec6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186523698} :answer-field/id #uuid "8f600507-f040-5dba-b29a-f3b5303afbf5" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523863}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6b73135a-679b-5521-bab1-ffd76e8e9cf8" :question/math-academy-id "q-167068" :question/problem "Write the equations of the vertical and horizontal lines that pass through the point $B.$\n\nThe **equation** of the vertical line is \n{{field-1}}\n\nThe **equation** of the horizontal line is \n{{field-2}}" :question/worked-solution "The coordinates of $B$ are $(4,1).$\n\n* Since the vertical line should pass through $(4,1)$, the $x$-value for every point on the line is $4.$ Hence, the equation of that line is \n\n$$\nx=4.\n$$\n\n* Since the horizontal line should pass through $(4,1)$, the $y$-value for every point on the line is $1.$ Hence, the equation of that line is \n\n$$\ny=1.\n$$"}] [{:db/id #edb/ref 17592186523953 :knowledge-point/_questions [{:db/id #edb/ref 17592186068720 :knowledge-point/id #uuid "5df52cb5-75b1-58d9-8535-07c1bb87be34" :knowledge-point/title "Determining the Length of a Segment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6df9f240-6228-5924-a16f-fd52d2430387" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{10}" :db/id #edb/ref 17592186523479}] :answer-field/correct {:answer/id #uuid "6df9f240-6228-5924-a16f-fd52d2430387" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{10}" :db/id #edb/ref 17592186523479} :answer-field/id #uuid "356d702a-8ff9-5134-b7b6-f459b7f2fb8a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523814}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "53008a1b-048b-5530-aee9-c37309ee0c8c" :question/math-academy-id "q-167069" :question/problem "What is the length of $\\overset{―}{AB}?$\n\n$|\\overset{―}{AB}|\\,=\\,$\n{{field-1}}" :question/worked-solution "From the picture, the points $A$ and $B$ have coordinates $({x}_{1},{y}_{1})=(-2,3)$ and $({x}_{2},{y}_{2})=(4,1),$ respectively.\n\nTo find the length of $\\overset{―}{AB},$ we use the distance formula:\n\n$$\n\\begin{aligned}|\\overset{―}{AB}| & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(4-(-2))^{2}+(1-3)^{2}} \\\\  & =\\sqrt{(6)^{2}+(-2)^{2}} \\\\  & =\\sqrt{36+4} \\\\  & =\\sqrt{40} \\\\  & =2\\sqrt{10}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186524019 :knowledge-point/_questions [{:db/id #edb/ref 17592186068894 :knowledge-point/id #uuid "2db034b8-5119-5cf3-bb6e-e6c79d024177" :knowledge-point/title "Calculating the Slope Given Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2be143ce-02c5-529c-91e7-30b4b109ab46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186523342}] :answer-field/correct {:answer/id #uuid "2be143ce-02c5-529c-91e7-30b4b109ab46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186523342} :answer-field/id #uuid "2740cd2d-d984-544c-8909-67c29a2952fd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523807}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "db023775-f57a-5eec-8870-ad9e9767c00a" :question/math-academy-id "q-167070" :question/problem "What is the slope $m$ of the line $\\overset{↔}{AB}?$\n\n$m\\,=\\,$\n{{field-1}}" :question/worked-solution "As we found previously, the points $A$ and $B$ have coordinates $({x}_{1},{y}_{1})=(-2,3)$ and $({x}_{2},{y}_{2})=(4,1),$ respectively.\n\nTherefore, we compute the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{1-3}{4-(-2)} \\\\  & =\\frac{-2}{6} \\\\  & =-\\frac{1}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186523950 :knowledge-point/_questions [{:db/id #edb/ref 17592186068925 :knowledge-point/id #uuid "5e985ae8-05ba-590a-b504-4c84884679f4" :knowledge-point/title "Finding the Equation of a Line That Passes Through Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d240067-2b7d-5da0-8ced-35c460f862bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}x+\\frac{7}{3}" :db/id #edb/ref 17592186523545}] :answer-field/correct {:answer/id #uuid "8d240067-2b7d-5da0-8ced-35c460f862bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}x+\\frac{7}{3}" :db/id #edb/ref 17592186523545} :answer-field/id #uuid "134b35bc-2fdc-55d1-875e-ea8fc777f10d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523802} {:answer-field/choices [{:answer/id #uuid "f31d8396-8c45-5a1c-8211-0e6b56b99240" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186523760}] :answer-field/correct {:answer/id #uuid "f31d8396-8c45-5a1c-8211-0e6b56b99240" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186523760} :answer-field/id #uuid "249d3757-eb22-5461-8905-b54111d72bd7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523806}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4a3e6aca-bc4b-546e-bf1b-908fe05212b5" :question/math-academy-id "q-167071" :question/problem "Find the $y$-intercept of $\\overset{↔}{AB},$ and express the equation of this line in slope-intercept form.\n\nThe $y$-intercept of the line is $b\\,=\\,$\n{{field-1}}\n\nThe equation is $y\\,=\\,$\n{{field-2}}" :question/worked-solution "We will write the equation of the line in the slope-intercept form \n\n$$\ny=mx+b.\n$$\n\nAs we found previously, the slope is $m=-\\frac{1}{3}.$\n\nSubstituting $m=-\\frac{1}{3}$ into the slope-intercept form above, we get\n\n$$\ny=-\\frac{1}{3}x+b.\n$$\n\nWe now need to find the $y$-intercept $b.$ We can find this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(4,1):$\n\n$$\n\\begin{aligned}y & =-\\frac{1}{3}x+b \\\\ 1 & =-(\\frac{1}{3})(4)+b \\\\ 1 & =-\\frac{4}{3}+b \\\\ 1+\\frac{4}{3} & =b \\\\ b & =\\frac{7}{3}\\end{aligned}\n$$\n\nTherefore, the equation of the line is \n\n$$\ny=-\\frac{1}{3}x+\\frac{7}{3}.\n$$"}] [{:db/id #edb/ref 17592186523928 :knowledge-point/_questions [{:db/id #edb/ref 17592186068926 :knowledge-point/id #uuid "63461668-4f76-52a4-8115-1ab135eef9e3" :knowledge-point/title "Finding the X-Intercept of a Line Given a Point and a Slope"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "268490bc-9e7e-5df1-9744-32be636876f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186523330}] :answer-field/correct {:answer/id #uuid "268490bc-9e7e-5df1-9744-32be636876f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186523330} :answer-field/id #uuid "fee87274-1758-561e-9348-38338dad65bb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523921}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0bc94237-c7e5-59e2-b81f-4ca609b2837a" :question/math-academy-id "q-167073" :question/problem "Calculate the $x$-intercept of the line $\\overset{↔}{AB}.$\n\n$x\\,=\\,$\n{{field-1}}" :question/worked-solution "Previously, we found that $\\overset{↔}{AB}$ has equation\n\n$$\ny=-\\frac{1}{3}x+\\frac{7}{3}.\n$$\n\nAt the $x$-intercept, the $y$-coordinate is equal to $0.$ So, we can substitute $y=0$ into the equation and then solve for $x:$\n\n$$\n\\begin{aligned}y & =-\\frac{1}{3}x+\\frac{7}{3} \\\\ 0 & =-\\frac{1}{3}x+\\frac{7}{3} \\\\ 0 & =-x+7 \\\\ x & =7\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $x=7.$ The coordinates of the $x$-intercept are $(7,0).$"}] [{:db/id #edb/ref 17592186523946 :knowledge-point/_questions [{:db/id #edb/ref 17592186087710 :knowledge-point/id #uuid "f399f6ed-91bc-594e-9a40-b7c79f60c5dc" :knowledge-point/title "Converting from Slope-Intercept Form to Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd04c69d-53b7-5e6a-9054-97ee1c1c253f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186523717}] :answer-field/correct {:answer/id #uuid "dd04c69d-53b7-5e6a-9054-97ee1c1c253f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186523717} :answer-field/id #uuid "39b1df79-bf8b-562d-b2ed-3bc481d2effb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523815} {:answer-field/choices [{:answer/id #uuid "5ef26725-eef3-57f7-9013-c61e4007068e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186523446}] :answer-field/correct {:answer/id #uuid "5ef26725-eef3-57f7-9013-c61e4007068e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186523446} :answer-field/id #uuid "b51244ef-8a40-5480-b54f-4378e874a5c5" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523881}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3fd08c56-40e8-5db2-852c-0b5043fc5d70" :question/math-academy-id "q-167074" :question/problem "Write the equation of $\\overset{↔}{AB}$ in **standard form**.\n\nThe equation is \n$x\\,+$\n{{field-1}}\n$y=$\n{{field-2}}." :question/worked-solution "Our goal is to write the equation in the form \n\n$$\nax+by=c,\n$$\n\nwhere $a,b,$ and $c$ are integers with no common factors and $a\\ge 0.$\n\nWe begin by moving all of the variables to the left-hand side and all of the constants to the right-hand side:\n\n$$\n\\begin{aligned}y & =-\\frac{1}{3}x+\\frac{7}{3} \\\\ \\frac{1}{3}x+y & =\\frac{7}{3} \\\\ x+3y & =7\\end{aligned}\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a\\ge 0.$ So, we are done!\n\nThe standard form of the line is \n\n$$\nx+3y=7.\n$$"}] [{:db/id #edb/ref 17592186523988 :knowledge-point/_questions [{:db/id #edb/ref 17592186175910 :knowledge-point/id #uuid "4dcbc520-40b5-5c08-ba56-be105c135240" :knowledge-point/title "Finding the Equation of a Line Passing Through a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ca9f6489-52e9-5751-9fa8-55e469b75710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}x-1" :db/id #edb/ref 17592186523676}] :answer-field/correct {:answer/id #uuid "ca9f6489-52e9-5751-9fa8-55e469b75710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}x-1" :db/id #edb/ref 17592186523676} :answer-field/id #uuid "44132ea1-b7c9-5842-96df-a89dcc91fc33" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523823}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9a61b0f7-d3d4-5914-af7a-56cdc12fc887" :question/math-academy-id "q-167075" :question/problem "Write the equation of the line that passes through the point $(3,-2)$ and is parallel to $\\overset{↔}{AB}.$\n\nThe slope-intercept form of the equation is $y\\,=\\,$\n{{field-1}}" :question/worked-solution "Since parallel lines have equal slopes, the slope of the new line should be equal to the slope of the line $\\overset{↔}{AB},$ i.e.,\n\n$$\nm=-\\frac{1}{3}.\n$$\n\nSo, we want a line with the slope $m=-\\frac{1}{3}$ that passes through the point $({x}_{1},{y}_{1})=(3,-2).$ \n\nUsing point-slope form and simplifying, we obtain the following equation:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-2) & =-\\frac{1}{3}\\cdot (x-3) \\\\ y+2 & =-\\frac{1}{3}x+1 \\\\ y & =-\\frac{1}{3}x-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186524010 :knowledge-point/_questions [{:db/id #edb/ref 17592186175923 :knowledge-point/id #uuid "44b9b212-27c4-5d6d-a221-cd85c25fc956" :knowledge-point/title "Finding the Equation of a Line Perpendicular to a Line Through Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "363dfa66-499c-5d2c-a96a-6760e5b32e6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+2" :db/id #edb/ref 17592186523369}] :answer-field/correct {:answer/id #uuid "363dfa66-499c-5d2c-a96a-6760e5b32e6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+2" :db/id #edb/ref 17592186523369} :answer-field/id #uuid "4d80dd15-54e7-5576-9c18-bbe7d5170a37" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523829}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c73684cd-cbd4-53ce-a02e-b8f120478413" :question/math-academy-id "q-167076" :question/problem "Write the equation of the line that passes through the point $(2,8)$ and is perpendicular to $\\overset{↔}{AB}.$\n\nThe slope-intercept form of the equation is $y\\,=\\,$\n{{field-1}}" :question/worked-solution "Perpendicular lines have slopes that are negative reciprocals of each other. Therefore, since $\\overset{↔}{AB}$ has the slope $m=-\\frac{1}{3},$ our perpendicular line must have a slope of \n\n$$\n{m}_{1}=-\\frac{1}{m}=-\\frac{1}{(-\\frac{1}{3})}=3.\n$$\n\nSo, our perpendicular line has the slope ${m}_{1}=3$ and passes through the point $({x}_{1},{y}_{1})=(2,8).$ \n\nFinally, using point-slope form and simplifying, we obtain the following equation:\n\n$$\n\\begin{aligned}y-{y}_{1} & ={m}_{1}(x-{x}_{1}) \\\\ y-8 & =3(x-2) \\\\ y-8 & =3x-6 \\\\ y & =3x+2\\end{aligned}\n$$"}]}
