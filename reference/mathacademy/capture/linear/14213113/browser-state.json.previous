      "html": "<div id=\"question-167069\" class=\"question\">                                \n                        <div id=\"question-167069-text\" class=\"questionText\">      \n                            \n                            <!--<span style=\"font-weight: bold; margin-right: 10px;\">c.</span>-->\n\n                            <div id=\"question-167069-graphic\" class=\"questionGraphic\">\n                                \n                            </div>   \n\n\n                            What is the length of <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"6\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mover><mjx-over style=\"padding-bottom: 0.18em; margin-bottom: -0.248em;\"><mjx-mo class=\"mjx-n\"><mjx-stretchy-h class=\"mjx-c2013\" style=\"width: 1.509em;\"><mjx-ext><mjx-c></mjx-c></mjx-ext></mjx-stretchy-h></mjx-mo></mjx-over><mjx-base><mjx-mrow><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D434 TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D435 TEX-I\"></mjx-c></mjx-mi></mjx-mrow></mjx-base></mjx-mover><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c3F\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mrow><mi>A</mi><mi>B</mi></mrow><mo accent=\"true\">―</mo></mover><mo>?</mo></math></mjx-assistive-mml></mjx-container>\n\n                            \n                                    \n                                        \n                                            <div class=\"freeResponse\">\n                                                <div class=\"freeResponseLine\">\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \