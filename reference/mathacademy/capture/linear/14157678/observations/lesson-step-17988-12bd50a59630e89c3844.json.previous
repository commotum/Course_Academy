{
  "dom_id": "step-17988",
  "name": "Example: \n                    Converting a Unit Fraction Exponent to a Radical",
  "problem": "Write $8^{1/5}$ using radical notation.",
  "worked_solution": "The fractional exponent $x^{1/n}$ can be written as the radical $\\sqrt[n]{x}.$\n\nComparing $x^{1/n}$ with $8^{1/5},$ we get $x = 8$ and $n = 5.$ Therefore,\n\n$$\n8^{1/5} = \\sqrt[5]{8}.\n$$",
  "calculator_instructions": "",
  "fields": [],
  "problem_field_keys": [],
  "answer_fields_complete": null,
  "result": null,
  "proof_feedback": null,
