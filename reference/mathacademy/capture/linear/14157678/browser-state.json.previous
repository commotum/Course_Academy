  "live_records": {
    "q-69210": {
      "dom_id": "step-q69210",
      "name": "Question 1",
      "problem": "Write ${10}^{1/4}$ using radical notation.",
      "worked_solution": "The fractional exponent ${x}^{1/n}$ can be written as the radical $\\sqrt[n]{x}.$\n\nComparing ${x}^{1/n}$ with ${10}^{1/4},$ we get $x=10$ and $n=4.$ Therefore,\n\n$$\n{10}^{1/4}=\\sqrt[4]{10}.\n$$",
