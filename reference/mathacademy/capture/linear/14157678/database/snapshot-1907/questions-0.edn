#{[{:db/id #edb/ref 17592186151930 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186152128 :knowledge-point/id #uuid "285a1b25-5f08-562c-8dc8-820d7de1f963" :knowledge-point/title "Converting a Fractional Exponent to a Radical"}] :question/id #uuid "85913448-bf44-5c48-a845-edf7c36b2c7d" :question/math-academy-id "e-4902" :question/problem "Write $5^{2/3}$ using radical notation." :question/worked-solution "First, using the power law for exponents, we can write our expression as\n\n$$\n5^{2/3} = 5^{2\\cdot (1/3)} = \\left(5^2\\right)^{1/3}.\n$$\n\nThe fractional exponent $x^{1/n}$ can be written as the radical $\\sqrt[n]{x}.$\n\nComparing $x^{1/n}$ with our expression above, we get $x = 5^2$ and $n = 3.$ Therefore,\n\n$$\n\\left(5^2\\right)^{1/3} = \\sqrt[3]{5^2}.\n$$"}] [{:db/id #edb/ref 17592186151931 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186152129 :knowledge-point/id #uuid "bb7b6041-4844-5476-9980-d0851c95b7d0" :knowledge-point/title "Converting a Radical to a Fractional Exponent"}] :question/id #uuid "a7466252-b70d-5a77-83d5-28390c82c820" :question/math-academy-id "e-4903" :question/problem "Express $\\sqrt[3]{4^2}$ using a fractional exponent." :question/worked-solution "The radical $\\sqrt[n]{x}$ can be written using a fractional exponent as $x^{1/n}.$\n\nComparing $\\sqrt[n]{x}$ with $\\sqrt[3]{4^2},$ we get $x = 4^2$ and $n = 3.$ Therefore,\n\n$$\n\\sqrt[3]{4^2} = \\left(4^2\\right)^{1/3}.\n$$\n\nFinally, using the power law for exponents, we have\n\n$$\n\\left(4^2\\right)^{1/3} = 4^{2/3}.\n$$"}] [{:db/id #edb/ref 17592186151932 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186152130 :knowledge-point/id #uuid "9d5152b1-c5e4-5c4a-be4f-f4193264c0d7" :knowledge-point/title "Converting a Unit Fraction Exponent to a Radical"}] :question/id #uuid "6b1fb9cd-6d21-5649-b456-0ca8f7081141" :question/math-academy-id "e-4958" :question/problem "Write $8^{1/5}$ using radical notation." :question/worked-solution "The fractional exponent $x^{1/n}$ can be written as the radical $\\sqrt[n]{x}.$\n\nComparing $x^{1/n}$ with $8^{1/5},$ we get $x = 8$ and $n = 5.$ Therefore,\n\n$$\n8^{1/5} = \\sqrt[5]{8}.\n$$"}] [{:db/id #edb/ref 17592186151933 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186152131 :knowledge-point/id #uuid "e2d7fb12-c66c-524e-b9f6-1b86972c3520" :knowledge-point/title "Converting a Radical to a Unit Fraction Exponent"}] :question/id #uuid "87e686a5-7b8a-529b-a8fa-17445c52e012" :question/math-academy-id "e-4959" :question/problem "Express $\\sqrt[5]{4}$ using a fractional exponent." :question/worked-solution "The radical $\\sqrt[n]{x}$ can be written using a fractional exponent as $x^{1/n}.$\n\nComparing $\\sqrt[n]{x}$ with $\\sqrt[5]{4},$ we get $x = 4$ and $n = 5.$ Therefore,\n\n$$\n\\sqrt[5]{4} = 4^{1/5}.\n$$"}] [{:db/id #edb/ref 17592186152696 :knowledge-point/_questions [{:db/id #edb/ref 17592186152129 :knowledge-point/id #uuid "bb7b6041-4844-5476-9980-d0851c95b7d0" :knowledge-point/title "Converting a Radical to a Fractional Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "182df961-9776-5f94-a07c-927ff8b0a3b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5}^{3/4}" :db/id #edb/ref 17592186480786} {:answer/id #uuid "7cd7a02b-b328-5fda-9aa4-b0918c39d759" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{5/4}" :db/id #edb/ref 17592186480972} {:answer/id #uuid "bbe5b71a-f9c3-53b3-903a-acef7a8f86cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5}^{4/3}" :db/id #edb/ref 17592186481094} {:answer/id #uuid "e698ffda-145f-5163-99fe-519623cc39bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{4}^{3/5}" :db/id #edb/ref 17592186481179} {:answer/id #uuid "f15c6190-9471-5a3b-bf00-12121400c985" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answe