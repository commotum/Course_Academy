#{[{:activity/first-step {:db/id #edb/ref 17592186153014} :activity/id #uuid "940f1cda-30ac-5ae0-bbd9-17314a49e330" :activity/scope {:db/id #edb/ref 17592186049089 :topic/id #uuid "d981a0da-fc14-5387-9101-c6f311b598a6" :topic/math-academy-id 2607} :activity/steps [{:db/id #edb/ref 17592186153010 :step/content {:db/id #edb/ref 17592186152128 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151930 :question/id #uuid "85913448-bf44-5c48-a845-edf7c36b2c7d" :question/math-academy-id "e-4902"} :knowledge-point/id #uuid "285a1b25-5f08-562c-8dc8-820d7de1f963" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050697}] :knowledge-point/questions [{:db/id #edb/ref 17592186152698} {:db/id #edb/ref 17592186152700}] :knowledge-point/title "Converting a Fractional Exponent to a Radical"} :step/id #uuid "cc0b77f7-f0eb-5453-8bb8-2c3c94686386" :step/math-academy-id 17817 :step/next {:db/id #edb/ref 17592186153011}} {:db/id #edb/ref 17592186153011 :step/content {:db/id #edb/ref 17592186152129 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151931 :question/id #uuid "a7466252-b70d-5a77-83d5-28390c82c820" :question/math-academy-id "e-4903"} :knowledge-point/id #uuid "bb7b6041-4844-5476-9980-d0851c95b7d0" :knowledge-point/questions [{:db/id #edb/ref 17592186152696} {:db/id #edb/ref 17592186152703}] :knowledge-point/title "Converting a Radical to a Fractional Exponent"} :step/id #uuid "72fa2690-b99a-5293-afc3-1a8866143df7" :step/math-academy-id 17818} {:db/id #edb/ref 17592186153012 :step/content {:db/id #edb/ref 17592186152130 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151932 :question/id #uuid "6b1fb9cd-6d21-5649-b456-0ca8f7081141" :question/math-academy-id "e-4958"} :knowledge-point/id #uuid "9d5152b1-c5e4-5c4a-be4f-f4193264c0d7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048770}] :knowledge-point/questions [{:db/id #edb/ref 17592186152699} {:db/id #edb/ref 17592186152701}] :knowledge-point/title "Converting a Unit Fraction Exponent to a Radical"} :step/id #uuid "4b0d1645-9677-5e92-8d28-2d453f3082e3" :step/math-academy-id 17988 :step/next {:db/id #edb/ref 17592186153013}} {:db/id #edb/ref 17592186153013 :step/content {:db/id #edb/ref 17592186152131 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151933 :question/id #uuid "87e686a5-7b8a-529b-a8fa-17445c52e012" :question/math-academy-id "e-4959"} :knowledge-point/id #uuid "e2d7fb12-c66c-524e-b9f6-1b86972c3520" :knowledge-point/questions [{:db/id #edb/ref 17592186152697} {:db/id #edb/ref 17592186152702}] :knowledge-point/title "Converting a Radical to a Unit Fraction Exponent"} :step/id #uuid "5a64cf15-703f-5617-8fd4-5055abf5ad57" :step/math-academy-id 17989 :step/next {:db/id #edb/ref 17592186153010}} {:db/id #edb/ref 17592186153014 :step/content {:db/id #edb/ref 17592186153346 :tutorial/content "So far, we know the following:\n\n- To find the square root of a number, we need to find another that multiplies by itself $2$ times to give the original number. For example,\n$\\sqrt{9} = \\sqrt{3 \\cdot 3} = \\sqrt{3^2} = 3$.\n- To find the cube root of a number, we need to find another that multiplies by itself $3$ times to give the original number. For example,\n$\\sqrt[3]{8} = \\sqrt[3]{2 \\cdot 2 \\cdot 2} = \\sqrt[3]{2^3} = 2$.\n\nWe can extend this to any root. In general, to find the $n$th root of a number, we needed to find another number that multiplies by itself $n$ times to give the original number. We express the $n$th root as the radical $\\sqrt[n]{\\phantom{0}}$. For instance,\n\n$$\n\\sqrt[{\\color{blue}4}]{16} = \\sqrt[{\\color{blue}4}]{\\underbrace{2\\cdot 2\\cdot 2\\cdot 2}_{{\\color{blue}4}\\text{times}}} = \\sqrt[{\\color{blue}4}]{2^4} = 2\n$$\n\nGiven a radical $\\sqrt[n]{x}$, we can write an equivalent expression using the fractional exponent $x^{1/n}$. To demonstrate, let's write an equivalent expression for $\\sqrt[7]{3}$.\n\nComparing $\\sqrt[n]{x}$ with $\\sqrt[7]{3}$, we get $x = 3$ and $n = 7$. Therefore,\n\n$$\n\\sqrt[7]{3} = 3^{1/7}\n$$\n\nThe reverse is also true: the fractional exponent $x^{1/n}$ can be written as the radical $\\sqrt[n]{x}$.\n\n**Note:** Remember that the square root of a number corresponds to the case of $n=2$. So, for example, we have\n\n$$\n\\sqrt{3} = 3^{1/2}\n$$" :tutorial/id #uuid "ace9adb3-54cf-5410-b2e4-d0e8ae4fb000" :tutorial/math-academy-id 3293 :tutorial/title "Introduction"} :step/id #uuid "47028c77-f8df-57f6-ad0c-476649be1dd4" :step/math-academy-id 18077 :step/next {:db/id #edb/ref 17592186153012}}] :activity/title "Radicals as Fractional Exponents" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186152321}]}
