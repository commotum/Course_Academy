86045417] [17592186065368 #edb/ref 1064 "Remember that the derivative of a function ![](images/93/93f888a1ee0b7da5e29f442f803f1c0eaf73ad02f5eaa97e85bb8a35d607015b.svg) represents the slope of the tangent line to the curve ![](images/e2/e2ed4a9881134f510823ba710f835acf5720b866f0df86fa6cd24448524431d6.svg)\n\nFor example, consider the curve ![](images/2e/2eb046be7e52e5a72d29a1333f9cf483411f0a8d6d897fe53014cc1952c6f759.svg), shown below. If we want to compute the slope of the tangent to the curve at the point ![](images/3a/3a613cb22e7bfd4038442b830babc21756061f5b18d1b1969451c8403d2894a3.svg) then we compute ![](images/a5/a54bfe86ff259aa5b62b72de2f050ee0c2818056cbc4bd30385c5faab112f71d.svg) and evaluate ![](images/91/910d575ac485dde82a562406c34e5e80677b10d5fb0e38b3370558d22badc908.svg)\n\n![](images/63/63f675532755376a733f2f0cad2b40e55f19b3278c1bcc5e8cb355fc6bdac277.png)\n\nIf ![](images/01/01ced1892dd48d3cbba7806664f3a1d763ef692dd88e5bf031d84db220141410.svg) then ![](images/a9/a9460f8b0abe06f33ff168a2a1887572f1c282de78c982c3af65c1c0670b9818.svg) by the power rule. Substituting ![](images/df/df9822243c11ec9f0fabca5cc578976d0bdea2c521b4f61964f5f3850a970504.svg) into ![](images/a5/a54bfe86ff259aa5b62b72de2f050ee0c2818056cbc4bd30385c5faab112f71d.svg) gives\n![](images/e0/e046ab7a11915ca797bd74e8e304484fe46ecaf4d2f19429409a4a8c6a3b1456.svg)\n\nTherefore, the slope of the tangent to the curve ![](images/2e/2eb046be7e52e5a72d29a1333f9cf483411f0a8d6d897fe53014cc1952c6f759.svg) at the point ![](images/32/3207697e43e4f88223ad85c16964c3103a50c0c999a4ca14417695158d45526b.svg) is ![](images/27/270d33581e0657a10d567c6cfaa529521b34e20a39c9a29550698cbf252fabfa.svg)" #edb/ref 17592186045417] [17592186065368 #edb/ref 1065 351 #edb/ref 17592186045417] [17592186065368 #edb/ref 1066 #uuid "93644195-f209-5d8c-bcaf-bbb6766c7193" #edb/ref 17592186045417] [17592186065368 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186327200 #edb/ref 1080 "x=3" #edb/ref 17592186045417] [17592186327200 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186327200 #edb/ref 1083 #uuid "1eaebcbd-9756-50eb-bd1d-5df67107c5f7" #edb/ref 17592186045417] [17592186327946 #edb/ref 1080 "x=-3" #edb/ref 17592186045417] [17592186327946 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186327946 #edb/ref 1083 #uuid "76095c4e-fe50-5e62-a537-b4a30720bfe8" #edb/ref 17592186045417] [17592186328265 #edb/ref 1080 "x=1" #edb/ref 17592186045417] [17592186328265 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186328265 #edb/ref 1083 #uuid "9a0124b8-1270-54e6-85c6-b6c4821e0345" #edb/ref 17592186045417] [17592186328332 #edb/ref 1080 "x=-3,\\,1." #edb/ref 17592186045417] [17592186328332 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186328332 #edb/ref 1083 #uuid "a11fde28-0164-5479-b55c-449aff8e5bd9" #edb/ref 17592186045417] [17592186329105 #edb/ref 1080 "x=-1,\\,3" #edb/ref 17592186045417] [17592186329105 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186329105 #edb/ref 1083 #uuid "f75dcddb-213f-536c-96ae-50a77358eeb7" #edb/ref 17592186045417] [17592186329343 #edb/ref 1075 #edb/ref 17592186327200 #edb/ref 17592186045417] [17592186329343 #edb/ref 1075 #edb/ref 17592186327946 #edb/ref 17592186045417] [17592186329343 #edb/ref 1075 #edb/ref 17592186328265 #edb/ref 17592186045417] [17592186329343 #edb/ref 1075 #edb/ref 17592186328332 #edb/ref 17592186045417] [17592186329343 #edb/ref 1075 #edb/ref 17592186329105 #edb/ref 17592186045417] [17592186329343 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186329343 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186329343 #edb/ref 1078 #edb/ref 17592186329105 #edb/ref 17592186045417] [17592186329343 #edb/ref 1079 #uuid "587f04fc-1b5a-59da-ba85-fcbbd60d19f2" #edb/ref 17592186045417] [17592186329926 #edb/ref 1068 #edb/ref 17592186329343 #edb/ref 17592186045417] [17592186329926 #edb/ref 1069 "q-48817" #edb/ref 17592186045417] [17592186329926 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186329926 #edb/ref 1071 "Find the $x$-coordinates of the points on the curve $y=-2{x}^{3}+6{x}^{2}+20x-1$ whose tangent has a slope of $2.$" #edb/ref 17592186045417] [17592186329926 #edb/ref 1072 #uuid "ac72967c-0395-50e5-812a-2bfe9c19348f" #edb/ref 17592186045417] [17592186329926 #edb/ref 1074 "Let $f(x)=-2{x}^{3}+6{x}^{2}+20x-1.$ The slope of the tangent at the point $x$ is equal to ${f}^{′}(x).$ Computing the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-2{x}^{3}+6{x}^{2}+20x-1) \\\\  & =-2\\frac{\\text{d}}{\\text{d}x}({x}^{3})+6\\frac{\\text{d}}{\\text{d}x}({x}^{2})+20\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =-2\\cdot 3{x}^{2}+6\\cdot 2x+20\\cdot 1-0 \\\\  & =-6{x}^{2}+12x+20.\\end{aligned}\n$$\n\nWe now set ${f}^{′}(x)=2$ and solve for $x:$\n\n$$\n\\begin{aligned}-6{x}^{2}+12x+20 & =2 \\\\ -6{x}^{2}+12x+18 & =0 \\\\ -6({x}^{2}-2x-3) & =0 \\\\ -6(x+1)(x-3) & =0.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent is equal to $2$ at the points where $x=-1,3.$" #edb/ref 17592186045417] [17592186510685 #edb/ref 1068 #edb/ref 17592186510687 #edb/ref 17592186045443] [17592186510685 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186510685 #edb/ref 1071 "Find the exact value of the slope $m$ of the tangent to the curve $y=9x-2\\sqrt{x}$ at the point $(25,215).$\n\n$m=$\n{{field-1}}" #edb/ref 17592186045443] [17592186510685 #edb/ref 1072 #uuid "08e2c497-48ce-5260-bb75-340ad4b7ea14" #edb/ref 17592186045443] [17592186510685 #edb/ref 1074 "This time, we'll use $\\frac{\\text{d}y}{\\text{d}x}$ notation. First, we compute the derivative, which gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(9x-2\\sqrt{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(9x-2{x}^{1/2}) \\\\  & =9-2\\cdot \\frac{1}{2}{x}^{-1/2} \\\\  & =9-\\frac{1}{\\sqrt{x}}.\\end{aligned}\n$$\n\nEvaluating at $x=25$ gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=25} & =9-\\frac{1}{\\sqrt{25}} \\\\  & =9-\\frac{1}{5} \\\\  & =\\frac{44}{5}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent to the curve at the point $(25,215)$ is\n\n$$\nm={\\frac{\\text{d}y}{\\text{d}x}|}_{x=25}=\\frac{44}{5}.\n$$" #edb/ref 17592186045443] [17592186510689 #edb/ref 1068 #edb/ref 17592186510686 #edb/ref 17592186045443] [17592186510689 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186510689 #edb/ref 1071 "Find the exact value of the slope $m$ of the tangent to the curve $y=4x-4\\sqrt{x}$ at the point $(25,80).$\n\n$m=$\n{{field-1}}" #edb/ref 17592186045443] [17592186510689 #edb/ref 1072 #uuid "7526651e-3bb1-5a8c-b6a7-9e835e617845" #edb/ref 17592186045443] [17592186510689 #edb/ref 1074 "This time, we'll use $\\frac{\\text{d}y}{\\text{d}x}$ notation. First, we compute the derivative, which gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(4x-4\\sqrt{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4x-4{x}^{1/2}) \\\\  & =4-4\\cdot \\frac{1}{2}{x}^{-1/2} \\\\  & =4-\\frac{2}{\\sqrt{x}}.\\end{aligned}\n$$\n\nEvaluating at $x=25$ gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=25} & =4-\\frac{2}{\\sqrt{25}} \\\\  & =4-\\frac{2}{5} \\\\  & =\\frac{18}{5}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent to the curve at the point $(25,80)$ is\n\n$$\nm={\\frac{\\text{d}y}{\\text{d}x}|}_{x=25}=\\frac{18}{5}.\n$$" #edb/ref 17592186045443] [17592186510690 #edb/ref 1068 #edb/ref 17592186510688 #edb/ref 17592186045443] [17592186510690 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045443] [17592186510690 #edb/ref 1071 "Find the exact value of the slope $m$ of the tangent to the curve $y=9\\sqrt{x}-2{x}^{3/4}$ at the point $(256,16).$\n\n$m=$\n{{field-1}}" #edb/ref 17592186045443] [17592186510690 #edb/ref 1072 #uuid "88fecdbc-7bc6-55ea-9ea8-19f24b070e65" #edb/ref 17592186045443] [17592186510690 #edb/ref 1074 "This time, we'll use $\\frac{\\text{d}y}{\\text{d}x}$ notation. First, we compute the derivative, which gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(9\\sqrt{x}-2{x}^{3/4}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(9{x}^{1/2}-2{x}^{3/4}) \\\\  & =9\\cdot \\frac{1}{2}{x}^{-1/2}-2\\cdot \\frac{3}{4}{x}^{-1/4} \\\\  & =\\frac{9}{2}{x}^{-1/2}-\\frac{3}{2}{x}^{-1/4}.\\end{aligned}\n$$\n\nEvaluating at $x=256$ gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=256} & =\\frac{9}{2}\\cdot \\frac{1}{16}-\\frac{3}{2}\\cdot \\frac{1}{4} \\\\  & =-\\frac{3}{32}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent to the curve at the point $(256,16)$ is\n\n$$\nm={\\frac{\\text{d}y}{\\text{d}x}|}_{x=256}=-\\frac{3}{32}.\n$$" #edb/ref 17592186045443] [17592186510691 #edb/ref 1068 #edb/ref 17592186510697 #edb/ref 17592186045443] [17592186510691 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186510691 #edb/ref 1071 "Find the exact value of the slope $m$ of the tangent to the curve $y=3x-6\\sqrt{x}$ at the point $(25,45).$\n\n$m=$\n{{field-1}}" #edb/ref 17592186045443] [17592186510691 #edb/ref 1072 #uuid "99a60241-72e6-5737-aea9-72c487d2682d" #edb/ref 17592186045443] [17592186510691 #edb/ref 1074 "This time, we'll use $\\frac{\\text{d}y}{\\text{d}x}$ notation. First, we compute the derivative, which gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3x-6\\sqrt{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3x-6{x}^{1/2}) \\\\  & =3-6\\cdot \\frac{1}{2}{x}^{-1/2} \\\\  & =3-\\frac{3}{\\sqrt{x}}.\\end{aligned}\n$$\n\nEvaluating at $x=25$ gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=25} & =3-\\frac{3}{\\sqrt{25}} \\\\  & =3-\\frac{3}{5} \\\\  & =\\frac{12}{5}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent to the curve at the point $(25,45)$ is\n\n$$\nm={\\frac{\\text{d}