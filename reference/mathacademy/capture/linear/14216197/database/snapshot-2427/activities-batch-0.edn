)\n\n![](images/63/63f675532755376a733f2f0cad2b40e55f19b3278c1bcc5e8cb355fc6bdac277.png)\n\nIf ![](images/01/01ced1892dd48d3cbba7806664f3a1d763ef692dd88e5bf031d84db220141410.svg) then ![](images/a9/a9460f8b0abe06f33ff168a2a1887572f1c282de78c982c3af65c1c0670b9818.svg) by the power rule. Substituting ![](images/df/df9822243c11ec9f0fabca5cc578976d0bdea2c521b4f61964f5f3850a970504.svg) into ![](images/a5/a54bfe86ff259aa5b62b72de2f050ee0c2818056cbc4bd30385c5faab112f71d.svg) gives\n![](images/e0/e046ab7a11915ca797bd74e8e304484fe46ecaf4d2f19429409a4a8c6a3b1456.svg)\n\nTherefore, the slope of the tangent to the curve ![](images/2e/2eb046be7e52e5a72d29a1333f9cf483411f0a8d6d897fe53014cc1952c6f759.svg) at the point ![](images/32/3207697e43e4f88223ad85c16964c3103a50c0c999a4ca14417695158d45526b.svg) is ![](images/27/270d33581e0657a10d567c6cfaa529521b34e20a39c9a29550698cbf252fabfa.svg)" :tutorial/id #uuid "93644195-f209-5d8c-bcaf-bbb6766c7193" :tutorial/math-academy-id 351 :tutorial/title "Introduction"} :step/id #uuid "d5f47d99-6d75-561c-aa52-ee6d298efded" :step/math-academy-id 649 :step/next {:db/id #edb/ref 17592186065259}} {:db/id #edb/ref 17592186065259 :step/content {:db/id #edb/ref 17592186064342 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063980 :question/id #uuid "9c9b5972-f775-5cbe-8e66-2a0309f24f0e" :question/math-academy-id "e-142"} :knowledge-point/id #uuid "2ffbc4bb-e179-543f-bcb5-3aaf6540a8a1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048932} {:db/id #edb/ref 17592186049061}] :knowledge-point/question-generator {:db/id #edb/ref 17592186510719} :knowledge-point/questions [{:db/id #edb/ref 17592186064535} {:db/id #edb/ref 17592186064536} {:db/id #edb/ref 17592186235367} {:db/id #edb/ref 17592186235458} {:db/id #edb/ref 17592186235472} {:db/id #edb/ref 17592186244051} {:db/id #edb/ref 17592186287885} {:db/id #edb/ref 17592186317207} {:db/id #edb/ref 17592186317341} {:db/id #edb/ref 17592186317342} {:db/id #edb/ref 17592186510702} {:db