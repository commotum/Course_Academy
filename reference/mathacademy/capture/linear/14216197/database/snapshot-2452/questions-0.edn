#{[{:db/id #edb/ref 17592186527209 :knowledge-point/_questions [{:db/id #edb/ref 17592186064343 :knowledge-point/id #uuid "3ca13570-d504-53e6-8e02-0f1e85047a3e" :knowledge-point/title "Calculating the Slope of a Tangent Line of a Curve With Fractional Powers at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63e3b5b0-8900-5d3b-a978-40215b9d1186" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186526701} {:answer/id #uuid "81aaba10-9584-56fc-820a-b7e4eac20857" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{37}^{1/2}" :db/id #edb/ref 17592186526763} {:answer/id #uuid "96e8e335-61a7-558f-af2f-626fcdb03817" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "37" :db/id #edb/ref 17592186526798} {:answer/id #uuid "c8c4ee29-a991-5ae6-951a-7337721cee54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186526889} {:answer/id #uuid "f3dd1db2-27d9-5d30-b720-d5b687f99de0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{45}^{1/4}" :db/id #edb/ref 17592186526987}] :answer-field/correct {:answer/id #uuid "96e8e335-61a7-558f-af2f-626fcdb03817" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "37" :db/id #edb/ref 17592186526798} :answer-field/id #uuid "f1af0502-f90d-51c8-983f-2a023e69d3fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186527116}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c428807e-3362-57cf-8f18-309a6336affe" :question/math-academy-id "q-10685" :question/problem "What is the slope of the tangent to the curve $y=3{x}^{4}+12{x}^{2}+2\\sqrt{x}$ at the point $(1,17)?$" :question/worked-solution "This time, we'll use $\\frac{\\text{d}y}{\\text{d}x}$ notation. First, we compute the derivative, which gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{4}+12{x}^{2}+2{x}^{1/2}) \\\\  & =4\\cdot 3{x}^{3}+2\\cdot 12x+\\frac{1}{2}\\cdot 2{x}^{-1/2} \\\\  & =12{x}^{3}+24x+{x}^{-1/2}.\\end{aligned}\n$$\n\nEvaluating at $x=1$ gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & =12(1)^{3}+24(1)+(1)^{-1/2} \\\\  & =12+24+1 \\\\  & =37.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent to the curve is $37.$"}] [{:db/id #edb/ref 17592186527218 :knowledge-point/_questions [{:db/id #edb/ref 17592186064342 :knowledge-point/id #uuid "2ffbc4bb-e179-543f-bcb5-3aaf6540a8a1" :knowledge-point/title "Calculating the Slope of a Tangent Line of a Curve at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47783d62-c870-5147-b953-7ccd97997d07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186526642}] :answer-field/correct {:answer/id #uuid "47783d62-c870-5147-b953-7ccd97997d07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186526642} :answer-field/id #uuid "51c33fc1-b49f-5319-ad00-3e78fb97a0a3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186527052}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "def70879-cf84-5b54-bdb7-d96481c22cc6" :question/math-academy-id "q-342102" :question/problem "Find the exact value of the slope $m$ of the tangent to the curve $y=2{x}^{5}-8{x}^{4}+24{x}^{2}-16$ at the point where $x=3.$\n\n$m=$\n{{field-1}}" :question/worked-solution "Let $f(x)=2{x}^{5}-8{x}^{4}+24{x}^{2}-16.$ The slope of the tangent at $x=3$ is equal to ${f}^{′}(3).$ Computing the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{5}-8{x}^{4}+24{x}^{2}-16) \\\\  & =2\\cdot 5{x}^{4}-8\\cdot 4{x}^{3}+24\\cdot 2x-0 \\\\  & =10{x}^{4}-32{x}^{3}+48x.\\end{aligned}\n$$\n\nNow, we evaluate at $x=3$ and get\n\n$$\n\\begin{aligned}{f}^{′}(3) & =10({3}^{4})-32({3}^{3})+48(3) \\\\  & =810-864+144 \\\\  & =90.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent to the curve at $x=3$ is\n\n$$\nm={f}^{′}(3)=90.\n$$"}] [{:db/id #edb/ref 17592186527206 :knowledge-point/_questions [{:db/id #edb/ref 17592186064259 :knowledge-point/id #uuid "00a74f63-a4eb-5894-b4a4-eb4fd297a3f3" :knowledge-point/title "Finding a Point on a Curve With a Certain Slope"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8bcc3fc-12cf-5236-886b-39227298c64c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186526888}] :answer-field/correct {:answer/id #uuid "c8bcc3fc-12cf-5236-886b-39227298c64c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186526888} :answer-field/id #uuid "40385704-7f81-5553-874b-03df9d2fbb08" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186527043}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bc8ddc72-3ceb-5b31-bf69-44ea85d72dfb" :question/math-academy-id "q-342248" :question/problem "Find the exact value of the $x$-coordinate of the point on the curve $y={x}^{3}-6{x}^{2}+12x$ whose tangent has a slope of $0.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Let $f(x)={x}^{3}-6{x}^{2}+12x.$ The slope of the tangent at the point $x$ is equal to ${f}^{′}(x).$ Computing the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{3}-6{x}^{2}+12x) \\\\  & =3{x}^{2}-12x+12.\\end{aligned}\n$$\n\nWe now set ${f}^{′}(x)=0$ and solve for $x:$\n\n$$\n\\begin{aligned}3{x}^{2}-12x+12 & =0 \\\\ {x}^{2}-4x+4 & =0 \\\\ (x-2)^{2} & =0 \\\\ x & =2.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent is equal to $0$ at the point where $x=2.$"}] [{:db/id #edb/ref 17592186329926 :knowledge-point/_questions [{:db/id #edb/ref 17592186064259 :knowledge-point/id #uuid "00a74f63-a4eb-5894-b4a4-eb4fd297a3f3" :knowledge-point/title "Finding a Point on a Curve With a Certain Slope"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1eaebcbd-9756-50eb-bd1d-5df67107c5f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3" :db/id #edb/ref 17592186327200} {:answer/id #uuid "76095c4e-fe50-5e62-a537-b4a30720bfe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3" :db/id #edb/ref 17592186327946} {:answer/id #uuid "9a0124b8-1270-54e6-85c6-b6c4821e0345" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=1" :db/id #edb/ref 17592186328265} {:answer/id #uuid "a11fde28-0164-5479-b55c-449aff8e5bd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3,\\,1." :db/id #edb/ref 17592186328332} {:answer/id #uuid "f75dcddb-213f-536c-96ae-50a77358eeb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1,\\,3" :db/id #edb/ref 17592186329105}] :answer-field/correct {:answer/id #uuid "f75dcddb-213f-536c-96ae-50a77358eeb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1,\\,3" :db/id #edb/ref 17592186329105} :answer-field/id #uuid "587f04fc-1b5a-59da-ba85-fcbbd60d19f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329343}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac72967c-0395-50e5-812a-2bfe9c19348f" :question/math-academy-id "q-48817" :question/problem "Find the $x$-coordinates of the points on the curve $y=-2{x}^{3}+6{x}^{2}+20x-1$ whose tangent has a slope of $2.$" :question/worked-solution "Let $f(x)=-2{x}^{3}+6{x}^{2}+20x-1.$ The slope of the tangent at the point $x$ is equal to ${f}^{′}(x).$ Computing the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-2{x}^{3}+6{x}^{2}+20x-1) \\\\  & =-2\\frac{\\text{d}}{\\text{d}x}({x}^{3})+6\\frac{\\text{d}}{\\text{d}x}({x}^{2})+20\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =-2\\cdot 3{x}^{2}+6\\cdot 2x+20\\cdot 1-0 \\\\  & =-6{x}^{2}+12x+20.\\end{aligned}\n$$\n\nWe now set ${f}^{′}(x)=2$ and solve for $x:$\n\n$$\n\\begin{aligned}-6{x}^{2}+12x+20 & =2 \\\\ -6{x}^{2}+12x+18 & =0 \\\\ -6({x}^{2}-2x-3) & =0 \\\\ -6(x+1)(x-3) & =0.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent is equal to $2$ at the points where $x=-1,3.$"}]}
