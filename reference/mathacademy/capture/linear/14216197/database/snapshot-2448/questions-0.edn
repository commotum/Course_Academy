#{[{:db/id #edb/ref 17592186329926 :knowledge-point/_questions [{:db/id #edb/ref 17592186064259 :knowledge-point/id #uuid "00a74f63-a4eb-5894-b4a4-eb4fd297a3f3" :knowledge-point/title "Finding a Point on a Curve With a Certain Slope"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1eaebcbd-9756-50eb-bd1d-5df67107c5f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3" :db/id #edb/ref 17592186327200} {:answer/id #uuid "76095c4e-fe50-5e62-a537-b4a30720bfe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3" :db/id #edb/ref 17592186327946} {:answer/id #uuid "9a0124b8-1270-54e6-85c6-b6c4821e0345" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=1" :db/id #edb/ref 17592186328265} {:answer/id #uuid "a11fde28-0164-5479-b55c-449aff8e5bd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3,\\,1." :db/id #edb/ref 17592186328332} {:answer/id #uuid "f75dcddb-213f-536c-96ae-50a77358eeb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1,\\,3" :db/id #edb/ref 17592186329105}] :answer-field/correct {:answer/id #uuid "f75dcddb-213f-536c-96ae-50a77358eeb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1,\\,3" :db/id #edb/ref 17592186329105} :answer-field/id #uuid "587f04fc-1b5a-59da-ba85-fcbbd60d19f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329343}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac72967c-0395-50e5-812a-2bfe9c19348f" :question/math-academy-id "q-48817" :question/problem "Find the $x$-coordinates of the points on the curve $y=-2{x}^{3}+6{x}^{2}+20x-1$ whose tangent has a slope of $2.$" :question/worked-solution "Let $f(x)=-2{x}^{3}+6{x}^{2}+20x-1.$ The slope of the tangent at the point $x$ is equal to ${f}^{′}(x).$ Computing the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-2{x}^{3}+6{x}^{2}+20x-1) \\\\  & =-2\\frac{\\text{d}}{\\text{d}x}({x}^{3})+6\\frac{\\text{d}}{\\text{d}x}({x}^{2})+20\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =-2\\cdot 3{x}^{2}+6\\cdot 2x+20\\cdot 1-0 \\\\  & =-6{x}^{2}+12x+20.\\end{aligned}\n$$\n\nWe now set ${f}^{′}(x)=2$ and solve for $x:$\n\n$$\n\\begin{aligned}-6{x}^{2}+12x+20 & =2 \\\\ -6{x}^{2}+12x+18 & =0 \\\\ -6({x}^{2}-2x-3) & =0 \\\\ -6(x+1)(x-3) & =0.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent is equal to $2$ at the points where $x=-1,3.$"}]}
