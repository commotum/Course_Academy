ef 17592186556998 #edb/ref 17592186045417] [17592186557173 #edb/ref 1075 #edb/ref 17592186557022 #edb/ref 17592186045417] [17592186557173 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186557173 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186557173 #edb/ref 1078 #edb/ref 17592186557022 #edb/ref 17592186045417] [17592186557173 #edb/ref 1079 #uuid "bfa95610-12f2-5abb-9640-0c55094b614f" #edb/ref 17592186045417] [17592186557180 #edb/ref 1075 #edb/ref 17592186556463 #edb/ref 17592186045417] [17592186557180 #edb/ref 1075 #edb/ref 17592186556580 #edb/ref 17592186045417] [17592186557180 #edb/ref 1075 #edb/ref 17592186556779 #edb/ref 17592186045417] [17592186557180 #edb/ref 1075 #edb/ref 17592186556969 #edb/ref 17592186045417] [17592186557180 #edb/ref 1075 #edb/ref 17592186556970 #edb/ref 17592186045417] [17592186557180 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186557180 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186557180 #edb/ref 1078 #edb/ref 17592186556463 #edb/ref 17592186045417] [17592186557180 #edb/ref 1079 #uuid "cd3749e3-5087-5fa4-954a-a11f49413b13" #edb/ref 17592186045417] [17592186557189 #edb/ref 1075 #edb/ref 17592186556560 #edb/ref 17592186045417] [17592186557189 #edb/ref 1075 #edb/ref 17592186556785 #edb/ref 17592186045417] [17592186557189 #edb/ref 1075 #edb/ref 17592186556875 #edb/ref 17592186045417] [17592186557189 #edb/ref 1075 #edb/ref 17592186557036 #edb/ref 17592186045417] [17592186557189 #edb/ref 1075 #edb/ref 17592186557056 #edb/ref 17592186045417] [17592186557189 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186557189 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186557189 #edb/ref 1078 #edb/ref 17592186556875 #edb/ref 17592186045417] [17592186557189 #edb/ref 1079 #uuid "de85a63e-a3d0-55fd-b8a5-f8452278c0c9" #edb/ref 17592186045417] [17592186557245 #edb/ref 1068 #edb/ref 17592186557173 #edb/ref 17592186045417] [17592186557245 #edb/ref 1069 "q-25402" #edb/ref 17592186045417] [17592186557245 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186557245 #edb/ref 1071 "Find all the values of $x$ that satisfy $2x-5>1$ or $2x-7<13.$" #edb/ref 17592186045417] [17592186557245 #edb/ref 1072 #uuid "49cc684c-6a61-5a0a-9979-944836444765" #edb/ref 17592186045417] [17592186557245 #edb/ref 1074 "We start by solving $2x-5>1:$ \n\n$$\n\\begin{aligned}2x-5 & >1 \\\\ 2x & >6 \\\\ x & >3\\end{aligned}\n$$\n\n![](images/20/2048d360b427cfd94e92a16f7b9f8cd9ca9c88e808bf3b6205d60eebd71aa1cf.png)\n\nThen, we solve $2x-7<13:$\n\n$$\n\\begin{aligned}2x-7 & <13 \\\\ 2x & <20 \\\\ x & <10\\end{aligned}\n$$\n\n![](images/c1/c1a63d1c991f309dbc10a89f0416c910c2c31bde5fdf069682a6127a1f66987a.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/e0/e03d04e5d2d5d571f5b80353081253087f99b2bf58fd86ae56eff3af26415b92.png)\n\nTherefore, the final solution is $x<10$ or $x>3.$ We can write this using interval notation as $x\\in (-\\infty ,\\infty ).$" #edb/ref 17592186045417] [17592186557264 #edb/ref 1068 #edb/ref 17592186557180 #edb/ref 17592186045417] [17592186557264 #edb/ref 1069 "q-76082" #edb/ref 17592186045417] [17592186557264 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186557264 #edb/ref 1071 "What is the set of values of $x$ that satisfy $6\\le 3x+9\\le 15$ or $4x-3\\ge 5?$" #edb/ref 17592186045417] [17592186557264 #edb/ref 1072 #uuid "6d993076-511f-5d5a-b4e5-bf19ec4e8490" #edb/ref 17592186045417] [17592186557264 #edb/ref 1074 "We start by solving $6\\le 3x+9\\le 15:$\n\n$$\n\\begin{aligned}6 & \\le 3x+9\\le 15 \\\\ -3 & \\le 3x\\le 6 \\\\ -1 & \\le x\\le 2\\end{aligned}\n$$\n\n![](images/ab/ab1b1f6494c00b463e7912ab3f9710aee553e3a99484822e678494b55268e398.png)\n\nThen, we solve $4x-3\\ge 5:$\n\n$$\n\\begin{aligned}4x-3 & \\ge 5 \\\\ 4x & \\ge 8 \\\\ x & \\ge 2\\end{aligned}\n$$\n\n![](images/1b/1b0700462c3957759abbe608c300fece27f92dfdb9b8c14dbeb44cc053de7784.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/25/25f4136a1e248ab30fc0c01feef1e27c331553c1adcf4a1c27c133764cca1ae1.png)\n\nTherefore, the final solution is $x\\ge -1.$" #edb/ref 17592186045417] [17592186557310 #edb/ref 1068 #edb/ref 17592186557189 #edb/ref 17592186045417] [17592186557310 #edb/ref 1069 "q-25767" #edb/ref 17592186045417] [17592186557310 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186557310 #edb/ref 1071 "Find the set of values of $x$ that satisfy $5x-1>7$ or $2\\le 2x+5<16.$" #edb/ref 17592186045417] [17592186557310 #edb/ref 1072 #uuid "cbe793da-7d16-5ef3-b7b6-788b5db16db0" #edb/ref 17592186045417] [17592186557310 #edb/ref 1074 "We start by solving $5x-1>7:$\n\n$$\n\\begin{aligned}5x-1 & >7 \\\\ 5x & >8 \\\\ x & >\\frac{8}{5}\\end{aligned}\n$$\n\n![](images/0e/0efcf15a3abee964ad2dfc0c1dac12a0f2f43c86180d2ead869fc2ee7b8e9c76.png)\n\nThen, we solve $2\\le 2x+5<16:$\n\n$$\n\\begin{aligned}2 & \\le 2x+5<16 \\\\ 2-5 & \\le 2x<16-5 \\\\ -3 & \\le 2x<11 \\\\ -\\frac{3}{2} & \\le x<\\frac{11}{2}\\end{aligned}\n$$\n\n![](images/22/22f51dad4248c565cd3afcf03ec9f5a8c50494ad79ed1366b3513083be27182a.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/e7/e769eea6e55f7138cbce08cb285253fc1c710c2e39384994a8b36bd43a41ea32.png)\n\nTherefore, the final solution is $x\\ge -\\frac{3}{2}.$  We can write this using interval notation as $[-\\frac{3}{2},\\infty ).$" #edb/ref 17592186045417] [17592186557318 #edb/ref 1068 #edb/ref 17592186557087 #edb/ref 17592186045417] [17592186557318 #edb/ref 1069 "q-28966" #edb/ref 17592186045417] [17592186557318 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186557318 #edb/ref 1071 "Find all the values of $x$ that satisfy $3x+5>11$ or $2x-3\\le 1.$" #edb/ref 17592186045417] [17592186557318 #edb/ref 1072 #uuid "e377c474-d1b6-5e34-ae2e-6bda298c1707" #edb/ref 17592186045417] [17592186557318 #edb/ref 1074 "We start by solving $3x+5>11:$ \n\n$$\n\\begin{aligned}3x+5 & >11 \\\\ 3x & >6 \\\\ x & >2\\end{aligned}\n$$\n\n![](images/87/87831ea65f4caa557c8e8826faaa43a60737c3590393872902818921668787d0.png)\n\nThen, we solve $2x-3\\le 1:$\n\n$$\n\\begin{aligned}2x-3 & \\le 1 \\\\ 2x & \\le 4 \\\\ x & \\le 2\\end{aligned}\n$$\n\n![](images/49/4965930532798f18907e5319f2fd9fe5f17d9c1969c12d9795f9867a2cb13351.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/a9/a9543d5a2add249d869a667d16bea75780b0e44e4c0d2bde2cf460733d5e9634.png)\n\nTherefore, the final solution is $x\\le 2$ or $x>2.$ We can write this using interval notation as\n\n$$\nx\\in (-\\infty ,\\infty ).\n$$" #edb/ref 17592186045417] [17592186557323 #edb/ref 1068 #edb/ref 17592186557158 #edb/ref 17592186045417] [17592186557323 #edb/ref 1069 "q-104015" #edb/ref 17592186045417] [17592186557323 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186557323 #edb/ref 1071 "Find the set of values of $x$ that satisfy $-8<4x-4<8$ or $2-x>3.$" #edb/ref 17592186045417] [17592186557323 #edb/ref 1072 #uuid "f2b14810-a4bb-5d69-856a-68799a4e514a" #edb/ref 17592186045417] [17592186557323 #edb/ref 1074 "We start by solving $-8<4x-4<8:$\n\n$$\n\\begin{aligned}-8 & <4x-4<8 \\\\ -4 & <4x<12 \\\\ -1 & <x<3\\end{aligned}\n$$\n\n![](images/fd/fdf77a12d535974088d36ca7508443a2aab00bb147fde65a17fc06cf5f0bce23.png)\n\nThen, we solve $2-x>3:$\n\n$$\n\\begin{aligned}2-x & >3 \\\\ -x & >1 \\\\ \\frac{-x}{-1} & <\\frac{1}{-1} \\\\ x & <-1\\end{aligned}\n$$\n\n![](images/8a/8a1af65f2cebbcaeb73c138be5d1cd67d714aacb8db1c995f29b930c06b953fe.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/be/be8cace3271cdfa133d1b647359400681db04f504560ad306e3e1807eb1502d9.png)\n\nTherefore, the final solution is $-1<x<3$ or $x<-1.$ We can write this using interval notation as $(-\\infty ,-1)\\cup (-1,3).$" #edb/ref 17592186045417] [17592186557343 #edb/ref 1058 #edb/ref 17592186557382 #edb/ref 17592186045417] [17592186557343 #edb/ref 1062 #uuid "18a200e9-cd70-5bff-86ec-4b2d64cebd6c" #edb/ref 17592186045417] [17592186557343 #edb/ref 1063 #edb/ref 17592186557310 #edb/ref 17592186045417] [17592186557350 #edb/ref 1062 #uuid "33dd4d66-72f1-548e-a8ea-98c8e4f5383e" #edb/ref 17592186045417] [17592186557350 #edb/ref 1063 #edb/ref 17592186557323 #edb/ref 17592186045417] [17592186557380 #edb/ref 1058 #edb/ref 17592186557350 #edb/ref 17592186045417] [17592186557380 #edb/ref 1062 #uuid "96826635-bbbd-5238-b2a0-5744527987c9" #edb/ref 17592186045417] [17592186557380 #edb/ref 1063 #edb/ref 17592186557264 #edb/ref 17592186045417] [17592186557382 #edb/ref 1058 #edb/ref 17592186557380 #edb/ref 17592186045417] [17592186557382 #edb/ref 1062 #uuid "9920cd70-713b-5652-a589-462984092c55" #edb/ref 17592186045417] [17592186557382 #edb/ref 1063 #edb/ref 17592186557318 #edb/ref 17592186045417] [17592186557402 #edb/ref 1058 #edb/ref 17592186557343 #edb/ref 17592186045417] [17592186557402 #edb/ref 1062 #uuid "e397555c-38d7-597d-9eef-be097531f336" #edb/ref 17592186045417] [17592186557402 #edb/ref 1063 #edb/ref 17592186557245 #edb/ref 17592186045417]}
