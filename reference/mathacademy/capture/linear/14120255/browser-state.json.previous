      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14120255/observations/step-q213265-2ea833233eac470cbb5e.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14120255/observations/step-q213265-2ea833233eac470cbb5e.png",
      "source_url": "https://mathacademy.com/tasks/14120255/topics/4837/lesson",
      "captured_at": 1791734460.925427,
      "math_academy_id": "q-213265",
      "topic_id": "4837",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q213265",
        "placement_id": null,
        "content_id": null,
