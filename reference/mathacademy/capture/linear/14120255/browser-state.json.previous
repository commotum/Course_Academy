      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14120255/observations/step-q213011-4c83a3279d2f196fecd9.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14120255/observations/step-q213011-4c83a3279d2f196fecd9.png",
