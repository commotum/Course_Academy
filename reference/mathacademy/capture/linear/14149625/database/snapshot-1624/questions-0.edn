db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aaf35c78-310f-5644-af7b-d8eed5daf52f" :question/math-academy-id "q-243" :question/problem "How many pairs of like terms are present in the expression $2x-4y+3-7x+10y-5$?" :question/worked-solution "There are three pairs of like terms:  the $x$ terms, the $y$ terms, and the constant terms $3$ and $-5$."}] [{:db/id #edb/ref 17592186444878 :knowledge-point/_questions [{:db/id #edb/ref 17592186078572 :knowledge-point/id #uuid "3abcb6ff-e659-520e-9bc3-ac19f88e8702" :knowledge-point/title "Identifying Like Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "121c5493-ec8e-5d78-ae0c-e87c7710e2d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ and $10x$" :db/id #edb/ref 17592186444843} {:answer/id #uuid "265ee5ad-d055-54c9-ada2-8b5881b5c261" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$y$ and $49y$" :db/id #edb/ref 17592186444848} {:answer/id #uuid "3bcd6b3e-b205-5407-97e2-2b3abfd8b6de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$49y$ and $10$" :db/id #edb/ref 17592186444849} {:answer/id #uuid "7e3f8959-2ae0-56f2-b384-9b1ee309c3ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$y$ and $10x$" :db/id #edb/ref 17592186444857} {:answer/id #uuid "8e0e7e6b-fbed-5c53-b811-d3c003a41afc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$y$ and $10$" :db/id #edb/ref 17592186444860}] :answer-field/correct {:answer/id #uuid "265ee5ad-d055-54c9-ada2-8b5881b5c261" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$y$ and $49y$" :db/id #edb/ref 17592186444848} :answer-field/id #uuid "8262ea40-3433-5203-bc2e-d4837a4919ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-fi