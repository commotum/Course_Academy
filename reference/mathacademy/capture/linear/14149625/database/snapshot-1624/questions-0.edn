 :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "03bb4f75-478e-512c-9792-6e52916ed485" :question/math-academy-id "q-56803" :question/problem "How many pairs of like terms are in the expression $a+2b+3-10b-9-8a?$" :question/worked-solution "We write the terms of the expression as follows:\n\n$$\n(a)+(2b)+(3)+(-10b)+(-9)+(-8a).\n$$\n\nThere are three pairs of like terms:\n\n- $a$ and $-8a$ are like terms because they both contain the variable $a.$\n\n- $2b$ and $-10b$ are like terms because they both contain the variable $b.$\n\n- $3$ and $-9$ are like terms because they both contain no variable."}] [{:db/id #edb/ref 17592186444881 :knowledge-point/_questions [{:db/id #edb/ref 17592186078507 :knowledge-point/id #uuid "2e7bac34-87d8-5183-bdef-a68b66b3a212" :knowledge-point/title "Identifying Like Terms when there are No Like Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "903c3f02-1d63-5d7e-99c2-58db15363a93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No like  terms" :db/id #edb/ref 17592186444861} {:answer/id #uuid "a1b10e45-7174-511f-99e5-751845ff6f99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3h$ and $7u$" :db/id #edb/ref 17592186444862} {:answer/id #uuid "a40eed80-a657-531e-9e30-b6272fd74f47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5x$ and $3t$" :db/id #edb/ref 17592186444863} {:answer/id #uuid "b09bec20-e545-5d14-b9cb-fde4bc352f4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3h$ and $3t$" :db/id #edb/ref 17592186444865} {:answer/id #uuid "f33585fa-e18e-59b6-b2e0-40aeaf074f86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-v$, $7u$ and $3h$" :db/id #edb/ref 17592186444868}] :answer-field/correct {:answer/id #uuid "903c3f02-1d63-5d7e-99c2-58db15363a93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No like  terms" :db/id #edb/ref 17592186444861} :answer-field/id #uuid "48b07f47-4fcc-58ea-be39-752a6cbb826f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186444874}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b1195c4e-bdb0-5fa7-bea2-b175640ceb43" :question/math-academy-id "q-67068" :question/problem "What are the like terms in the expression $3h-v+7u+3t+5x?$" :question/worked-solution "We write the terms of the expression as follows:\n\n$$\n(3h)+(-v)+(7u)+(3t)+(5x).\n$$\n\nNone of these terms have the same variable part. Consequently, there are no like terms in this expression."}] [{:db/id #edb/ref 17592186444882 :knowledge-point/_questions [{:db/id #edb/ref 17592186078506 :knowledge-point/id #uuid "d06439e2-eba9-5cf0-be94-0beb379bc925" :knowledge-point/title "Identifying Constants as Like Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a4d5dde-dec3-5bd0-bc98-11f4d40df504" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186444846} {:answer/id #uuid "3e8bceef-d437-5965-b3f7-06f784fdb2cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186444850} {:answer/id #uuid "5e91f9b6-ccd1-5956-9d4f-018d30330539" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186444855} {:answer/id #uuid "838d51cc-3d11-524b-8c2e-fc03bc3db6de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186444858} {:answer/id #uuid "f3783601-7d45-507d-ae0a-45c8519419b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186444869}] :answer-field/correct {:answer/id #uuid "3e8bceef-d437-5965-b3f7-06f784fdb2cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186444850} :answer-field/id #uuid "128088e5-82fb-5590-85f8-009c087cafef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186444872}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b4754c7a-8749-5793-bafb-b31cee518a08" :question/math-academy-id "q-75670" :question/problem "How many pairs of like terms are in the expression $6p-3+5q-2p-3q+1?$" :question/worked-solution "We write the terms of the expression as follows:\n\n$$\n(6p)+(-3)+(5q)+(-2p)+(-3q)+(1)\n$$\n\nThere are three pairs of like terms:\n\n- $6p$ and $-2p$ are like terms because they both contain the variable $p.$\n\n- $5q$ and $-3q$ are like terms because they both contain the variable $q.$\n\n- $-3$ and $1$ are like terms because they both contain no variable."}]}
