#{[{:db/id #edb/ref 17592186078207 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078572 :knowledge-point/id #uuid "3abcb6ff-e659-520e-9bc3-ac19f88e8702" :knowledge-point/title "Identifying Like Terms"}] :question/id #uuid "3e57a60d-9470-5d02-b5bb-880f9ee3de21" :question/math-academy-id "e-1538" :question/problem "List the like terms for the expression\n\n$$\nx - 2y + 11y - 6z - 5x.\n$$" :question/worked-solution "We write the terms of the expression as follows: \n\n$$\n({\\color{red}x}) + ({\\color{blue}-2y}) + ({\\color{blue}11y}) + (-6z) + ({\\color{red}-5x})\n$$\n\nWe see two pairs of like terms:\n\n- The terms $-2y$ and $11y$ are like terms since they both contain the variable $y.$\n\n- The terms $x$ and $-5x$ are like terms since they both contain the variable $x.$"}] [{:db/id #edb/ref 17592186078370 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078506 :knowledge-point/id #uuid "d06439e2-eba9-5cf0-be94-0beb379bc925" :knowledge-point/title "Identifying Constants as Like Terms"}] :question/id #uuid "0dba136b-d72d-56a5-91bd-2f3cde60e600" :question/math-academy-id "e-799" :question/problem "What are the like terms of the expression $4 + 0.8p - 2.3p - 3.2p + 10?$" :question/worked-solution "We write the terms of the expression as follows:\n\n$$\n(4) + (0.8p) + (-2.3p) + (-3.2p) + (10)\n$$\n\nThere are two groups of like terms:\n\n- $0.8p,$ $-2.3p,$ and $-3.2p$ are like terms because they all contain the variable $p.$\n\n- $4$ and $10$ are like terms because they both contain no variable."}] [{:db/id #edb/ref 17592186078372 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078507 :knowledge-point/id #uuid "2e7bac34-87d8-5183-bdef-a68b66b3a212" :knowledge-point/title "Identifying Like Terms when there are No Like Terms"}] :question/id #uuid "b3e687e2-d4f9-5cbb-9b80-43d8904c3436" :question/math-academy-id "e-800" :question/problem "List the like terms for the expression\n\n$$\n20 - 6a + 2b - 6c.\n$$" :question/worked-solution "We write the terms of the expression as follows:\n\n$$\n(20) + (-6a) + (2b) + (-6c)\n$$\n\nNone of these terms have the same variable part. Consequently, there are no like terms in this expression."}] [{:db/id #edb/ref 17592186444883 :knowledge-point/_questions [{:db/id #edb/ref 17592186078507 :knowledge-point/id #uuid "2e7bac34-87d8-5183-bdef-a68b66b3a212" :knowledge-point/title "Identifying Like Terms when there are No Like Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05878f37-134d-59b9-8f6b-daa44ae9eca0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No like terms" :db/id #edb/ref 17592186444842} {:answer/id #uuid "5b86a1e1-1879-52ac-9479-2f1729eb4348" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$8x$ and $10z$" :db/id #edb/ref 17592186444853} {:answer/id #uuid "5baf360d-8b56-5d04-b7a0-1a1d7685f8d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-9y$ and $8$" :db/id #edb/ref 17592186444854} {:answer/id #uuid "be98f75a-60d7-5ace-9fcc-ffa5487165d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$8x$ and $8$" :db/id #edb/ref 17592186444866} {:answer/id #uuid "d151fce3-aa5a-521b-8fbd-d23441da29ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-9y$ and $10z$" :db/id #edb/ref 17592186444867}] :answer-field/correct {:answer/id #uuid "05878f37-134d-59b9-8f6b-daa44ae9eca0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No like terms" :db/id #edb/ref 17592186444842} :answer-field/id #uuid "cc72e96b-988d-51c4-90d2-308f4675a55c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186444876}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d0f76