[{:db/id 17592186078572 :knowledge-point/questions ["question-b065b0a1-2f69-56d2-893c-84bf7f3f3787" "question-89bdaeba-7457-5931-94c9-4ac589ccd204"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078207 :question/problem "List the like terms for the expression\n\n$$\nx - 2y + 11y - 6z - 5x.\n$$" :question/worked-solution "We write the terms of the expression as follows: \n\n$$\n({\\color{red}x}) + ({\\color{blue}-2y}) + ({\\color{blue}11y}) + (-6z) + ({\\color{red}-5x})\n$$\n\nWe see two pairs of like terms:\n\n- The terms $-2y$ and $11y$ are like terms since they both contain the variable $y.$\n\n- The terms $x$ and $-5x$ are like terms since they both contain the variable $x.$" :db/ensure [:question/validate]} {:db/id 17592186078507 :knowledge-point/questions ["question-b1195c4e-bdb0-5fa7-bea2-b175640ceb43" "question-d0f76c69-d8c0-5996-bfc8-0e524b6847e9"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078372 :question/problem "List the like terms for the expression\n\n$$\n20 - 6a + 2b - 6c.\n$$" :db/ensure [:question/validate]} {:db/id 17592186078506 :knowledge-point/questions ["question-aaf35c78-310f-5644-af7b-d8eed5daf52f" "question-b4754c7a-8749-5793-bafb-b31cee518a08"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078370 :question/problem "What are the like terms of the expression $4 + 0.8p - 2.3p - 3.2p + 10?$" :question/worked-solution "We write the terms of the expression as follows:\n\n$$\n(4) + (0.8p) + (-2.3p) + (-3.2p) + (10)\n$$\n\nThere are two groups of like terms:\n\n- $0.8p,$ $-2.3p,$ and $-3.2p$ are like terms because they all contain the variable $p.$\n\n- $4$ and $10$ are like terms because they both contain no variable." :db/ensure [:question/validate]} {:db/id "question-b065b0a1-2f69-56d2-893c-84bf7f3f3787" :question/id #uuid "b065b0a1-2f69-56d2-893c-84bf7f3f3787" :question/math-academy-id "q-21823" :question/problem "The like terms in the expression $-x+2y+z+5y$ are" :question/worked-solution "The like terms are $2y$ and $5y$ because they are both terms of the variable $y.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-165d1720-1119-533b-ac9f-626b7ed91bdb"] :db/ensure [:question/validate]} {:db/id "answer-field-165d1720-1119-533b-ac9f-626b7ed91bdb" :answer-field/id #uuid "165d1720-1119-533b-ac9f-626b7ed91bdb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8dd63d6b-1910-5852-bbf8-54c4d94cd10b" :answer-field/choices ["answer-477bd012-e49d-5536-b808-b0e3819359c7" "answer-6e6043cd-809a-58af-90f6-11f0021288ad" "answer-8dd63d6b-1910-5852-bbf8-54c4d94cd10b" "answer-18cd95de-1fea-58f8-8ec4-e41863840306" "answer-f4514aad-b6b1-574e-931f-abf09e190ee8"] :db/ensure [:answer-field/validate]} {:db/id "answer-477bd012-e49d-5536-b808-b0e3819359c7" :answer/id #uuid "477bd012-e49d-5536-b808-b0e3819359c7" :answer/type :answer.type/text :answer/value "$-2y$ and $5y$" :db/ensure [:answer/validate]} {:db/id "answer-6e6043cd-809a-58af-90f6-11f0021288ad" :answer/id #uuid "6e6043cd-809a-58af-90f6-11f0021288ad" :answer/type :answer.type/text :answer/value "$2y$ and $-5y$" :db/ensure [:answer/validate]} {:db/id "answer-8dd63d6b-1910-5852-bbf8-54c4d94cd10b" :answer/id #uuid "8dd63d6b-1910-5852-bbf8-54c4d94cd10b" :answer/type :answer.type/text :answer/value "$2y$ and $5y$" :db/ensure [:answer/validate]} {:db/id "answer-18cd95de-1fea-58f8-8ec4-e41863840306" :answer/id #uuid "18cd95de-1fea-58f8-8ec4-e41863840306" :answer/type :answer.type/text :answer/value "$2y$ and $y$" :db/ensure [:answer/validate]} {:db/id "answer-f4514aad-b6b1-574e-931f-abf09e190ee8" :answer/id #uuid "f4514aad-b6b1-574e-931f-abf09e190ee8" :answer/type :answer.type/text :answer/value "$y$ and $5y$" :db/ensure [:answer/validate]} {:db/id "question-89bdaeba-7457-5931-94c9-4ac589ccd204" :question/id #uuid "89bdaeba-7457-5931-94c9-4ac589ccd204" :question/math-academy-id "q-27261" :question/problem "Which of $10$, $10x$, $y$, and $49y$ are like 