#{[{:db/id #edb/ref 17592186078207 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078572 :knowledge-point/id #uuid "3abcb6ff-e659-520e-9bc3-ac19f88e8702" :knowledge-point/title "Identifying Like Terms"}] :question/id #uuid "3e57a60d-9470-5d02-b5bb-880f9ee3de21" :question/math-academy-id "e-1538" :question/problem "List the like terms for the expression\n$x - 2y + 11y - 6z - 5x$." :question/worked-solution "We write the terms of the expression as follows:\n$({\\color{red}x}) + ({\\color{blue}-2y}) + ({\\color{blue}11y}) + (-6z) + ({\\color{red}-5x})$\n\nWe see two pairs of like terms:\n\n- The terms $-2y$ and $11y$ are like terms since they both contain the variable $y$.\n- The terms $x$ and $-5x$ are like terms since they both contain the variable $x$."}] [{:db/id #edb/ref 17592186078370 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078506 :knowledge-point/id #uuid "d06439e2-eba9-5cf0-be94-0beb379bc925" :knowledge-point/title "Identifying Constants as Like Terms"}] :question/id #uuid "0dba136b-d72d-56a5-91bd-2f3cde60e600" :question/math-academy-id "e-799" :question/problem "What are the like terms of the expression $4 + 0.8p - 2.3p - 3.2p + 10$?" :question/worked-solution "We write the terms of the expression as follows:\n\n$$\n(4) + (0.8p) + (-2.3p) + (-3.2p) + (10)\n$$\n\nThere are two groups of like terms:\n\n- $0.8p$, $-2.3p$, and $-3.2p$ are like terms because they all contain the variable $p$.\n- $4$ and $10$ are like terms because they both contain no variable."}] [{:db/id #edb/ref 17592186078372 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078507 :knowledge-point/id #uuid "2e7bac34-87d8-5183-bdef-a68b66b3a212" :knowledge-point/title "Identifying Like Terms when there are No Like Terms"}] :question/id #uuid "b3e687e2-d4f9-5cbb-9b80-43d8904c3436" :question/math-academy-id "e-800" :question/problem "List the like terms for the expression\n$20 - 6a + 2b - 6c$." :question/worked-solution "We write the terms of the expression as follows:\n\n$$\n(20) + (-6a) + (2b) + (-6c)\n$$\n\nNone of these terms have the same variable part. Consequently, there are no like terms in this expression."}] [{:db/id #edb/ref 17592186079135 :knowledge-point/_questions [{:db/id #edb/ref 17592186078506 :knowledge-point/id #uuid "d06439e2-eba9-5cf0-be94-0beb379bc925" :knowledge-point/title "Identifying Constants as Like Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8856be19-a713-5a03-bc19-8727add2d3b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186077589} {:answer/id #uuid "9c6b7000-421f-5c29-840a-fb968d9e5b30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186077590} {:answer/id #uuid "ab67cb93-ee2d-5ac5-99a1-7c51cd52f421" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186077591} {:answer/id #uuid "2258fdb2-3cef-5b03-aa80-63e1a5311bed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186077592} {:answer/id #uuid "3afb13dc-2c14-55b9-9186-64f809af07cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186077593}] :answer-field/id #uuid "b7a8ca88-8906-522b-bca8-e8f87b5dfb6d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186077588}] :question/id #uuid "03bb4f75-478e-512c-9792-6e52916ed485" :question/math-academy-id "q-56803" :question/problem "How many pairs of like terms are in the expression $a + 2b + 3 - 10b - 9 - 8a$?"}]}
