#{[{:activity/first-step {:db/id #edb/ref 17592186079416} :activity/id #uuid "24987256-107f-5a82-ab0f-aa09289e48f1" :activity/scope {:db/id #edb/ref 17592186049264 :topic/id #uuid "e80811d9-e5d1-5c85-9386-86f6f8cb9ee3" :topic/math-academy-id 644} :activity/steps [{:db/id #edb/ref 17592186079416 :step/content {:db/id #edb/ref 17592186079609 :tutorial/content "Terms in a linear expression are called **like terms** if their variable part is the same. For example, in the linear expression\n\n$$\n{\\color{blue}2x}+3y{\\color{blue}-5x}\n$$\n\nthe terms ${\\color{blue}2x}$ and ${\\color{blue}-5x}$ are like terms because both terms contain the same variable $x$.\n\nA linear expression may also contain multiple groups of like terms. For example, in the expression\n\n$$\n2a + \\dfrac{1}{2}b + 3a - 0.4 b - a\n$$\n\nwe have two groups of like terms:\n\n- $2a$, $3a$, and $-a$ are like terms because they all contain the variable $a$.\n- $\\dfrac{1}{2}b$ and $-0.4b$ are like terms because they both contain the variable $b$.\n\n**Remember:** When a term has a subtraction symbol $(-)$ in front of it, the term is treated as a *negative*." :tutorial/id #uuid "dd5dd68d-3a84-5088-8ffe-a4f52618d31e" :tutorial/math-academy-id 1352 :tutorial/title "Introduction"} :step/id #uuid "deb2e31e-6ff8-541f-9e7c-df91c6033fb3" :step/math-academy-id 2728 :step/next {:db/id #edb/ref 17592186079522}} {:db/id #edb/ref 17592186079418 :step/content {:db/id #edb/ref 17592186078506 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078370 :question/id #uuid "0dba136b-d72d-56a5-91bd-2f3cde60e600" :question/math-academy-id "e-799"} :knowledge-point/id #uuid "d06439e2-eba9-5cf0-be94-0beb379bc925" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049018}] :knowledge-point/questions [{:db/id #edb/ref 17592186079122} {:db/id #edb/ref 17592186079135}] :knowledge-point/title "Identifying Constants as Like Terms"} :step/id #uuid "78685eef-0c38-5b93-b9c9-d6fcdce7fb2b" :step/math-academy-id 2732} {:db/id #edb/ref 17592186079419 :step/content {:db/id #edb/ref 17592186078507 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078372 :question/id #uuid "b3e687e2-d4f9-5cbb-9b80-43d8904c3436" :question/math-academy-id "e-800"} :knowledge-point/id #uuid "2e7bac34-87d8-5183-bdef-a68b66b3a212" :knowledge-point/questions [{:db/id #edb/ref 17592186079044} {:db/id #edb/ref 17592186079134}] :knowledge-point/title "Identifying Like Terms when there are No Like Terms"} :step/id #uuid "28b1904c-01fc-5896-8cc6-c6e1339160bb" :step/math-academy-id 2735 :step/next {:db/id #edb/ref 17592186079524}} {:db/id #edb/ref 17592186079522 :step/content {:db/id #edb/ref 17592186078572 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078207 :question/id #uuid "3e57a60d-9470-5d02-b5bb-880f9ee3de21" :question/math-academy-id "e-1538"} :knowledge-point/id #uuid "3abcb6ff-e659-520e-9bc3-ac19f88e8702" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050306}] :knowledge-point/questions [{:db/id #edb/ref 17592186079042} {:db/id #edb/ref 17592186079133}] :knowledge-point/title "Identifying Like Terms"} :step/id #uuid "cfc957cf-190f-528a-80f0-2faf92179217" :step/math-academy-id 4889 :step/next {:db/id #edb/ref 17592186079523}} {:db/id #edb/ref 17592186079523 :step/content {:db/id #edb/ref 17592186079628 :tutorial/content "In some expressions, there are no like terms. For example, in the expression $a+2b$ there are two terms, $a$ and $2b$. These two terms do not have the same variable part, so they are not like terms." :tutorial/id #uuid "5bfd8a6b-a049-550a-848e-9c936685c24b" :tutorial/math-academy-id 1699 :tutorial/title "Expressions with No Like Terms"} :step/id #uuid "4ec7c8ab-e45c-53e4-aab7-9f47bef74302" :step/math-academy-id 4891 :step/next {:db/id #edb/ref 17592186079419}} {:db/id #edb/ref 17592186079524 :step/content {:db/id #edb/ref 17592186079629 :tutorial/content "*Constants are like terms, even though they do not contain variables.*\n\nTo understand why this is, remember that two terms are called like terms if they share the same variable part.\n\nAll constants have no variables, so technically they do share the same variable part. Their variable part consists of no variables at all!" :tutorial/id #uuid "09d3ea5a-55b8-51b8-8c8b-39642db6a8e6" :tutorial/math-academy-id 1700 :tutorial/title "Constants are Like Terms"} :step/id #uuid "06c9ea06-b129-5e3c-8a12-fcef8fd2fb29" :step/math-academy-id 4892 :step/next {:db/id #edb/ref 17592186079418}}] :activity/title "Identifying Like Terms in Linear Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078666}]}
