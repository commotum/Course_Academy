#{[{:db/id #edb/ref 17592186493945 :knowledge-point/_questions [{:db/id #edb/ref 17592186119959 :knowledge-point/id #uuid "e588edf8-345e-57e7-b3ee-9c3666da08e6" :knowledge-point/title "Finding the Cube Root of a Positive Perfect Cube"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa5916f5-b95b-5530-9d9f-19d0168e2209" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186493658}] :answer-field/correct {:answer/id #uuid "aa5916f5-b95b-5530-9d9f-19d0168e2209" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186493658} :answer-field/id #uuid "f90a68c7-dc57-5362-b958-0dc11f3f0c40" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493888}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "aafcb24f-fde2-52b2-b44a-c7d7fddbc683" :question/math-academy-id "q-186155" :question/problem "Evaluate the following:\n\n$\\sqrt[3]{\\frac{27}{8}}=$\n{{field-1}}" :question/worked-solution "First, notice that the numbers $27$ and $8$ are both perfect cubes. \n\nSo, to determine the value of $\\sqrt[3]{\\frac{27}{8}},$ we express $\\frac{27}{8}$ as a perfect cube:\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{27}{8}} & = \\\\ \\sqrt[3]{\\frac{{3}^{3}}{{2}^{3}}} & = \\\\ \\sqrt[3]{\\frac{3\\cdot 3\\cdot 3}{2\\cdot 2\\cdot 2}} & = \\\\ \\sqrt[3]{\\frac{3}{2}\\cdot \\frac{3}{2}\\cdot \\frac{3}{2}} & = \\\\ \\sqrt[3]{{(\\frac{3}{2})}^{3}} & = \\\\ \\frac{3}{2} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493892 :knowledge-point/_questions [{:db/id #edb/ref 17592186119959 :knowledge-point/id #uuid "e588edf8-345e-57e7-b3ee-9c3666da08e6" :knowledge-point/title "Finding the Cube Root of a Positive Perfect Cube"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cbd15cf-50e0-5f6c-a023-66b7777a5ea1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186493467}] :answer-field/correct {:answer/id #uuid "2cbd15cf-50e0-5f6c-a023-66b7777a5ea1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186493467} :answer-field/id #uuid "77156935-a293-5f77-b17e-01ad81fabeda" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493837}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "03b02208-a47d-5484-9a1d-0e9d1a5e06da" :question/math-academy-id "q-186156" :question/problem "Evaluate the following:\n\n$\\sqrt[3]{\\frac{125}{8}}=$\n{{field-1}}" :question/worked-solution "First, notice that the numbers $125$ and $8$ are both perfect cubes. \n\nSo, to determine the value of $\\sqrt[3]{\\frac{125}{8}},$ we express $\\frac{125}{8}$ as a perfect cube:\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{125}{8}} & = \\\\ \\sqrt[3]{\\frac{{5}^{3}}{{2}^{3}}} & = \\\\ \\sqrt[3]{\\frac{5\\cdot 5\\cdot 5}{2\\cdot 2\\cdot 2}} & = \\\\ \\sqrt[3]{\\frac{5}{2}\\cdot \\frac{5}{2}\\cdot \\frac{5}{2}} & = \\\\ \\sqrt[3]{{(\\frac{5}{2})}^{3}} & = \\\\ \\frac{5}{2} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493942 :knowledge-point/_questions [{:db/id #edb/ref 17592186119961 :knowledge-point/id #uuid "c331c742-c620-5e3c-ae77-37de9ded75cc" :knowledge-point/title "Finding the Cube of the Cube Root of a Positive or Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11db075b-d65e-51e5-8dca-f8e9ab1adb79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186493421} {:answer/id #uuid "5c730b9a-1755-532b-b8d1-24d3aece98b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1,000" :db/id #edb/ref 17592186493533} {:answer/id #uuid "671ff086-c9db-58f6-af7a-4edb329a1ac6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186493544} {:answer/id #uuid "8b0b316d-8f3a-5a45-a97f-136faefce7bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1,000" :db/id #edb/ref 17592186493609} {:answer/id #uuid "f015c16e-7bc0-5eb8-9649-05d8fe751886" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186493777}] :answer-field/correct {:answer/id #uuid "8b0b316d-8f3a-5a45-a97f-136faefce7bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1,000" :db/id #edb/ref 17592186493609} :answer-field/id #uuid "7a4987cd-b000-5d3d-b94d-9c8d5cd48460" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493840}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9e1e6dba-6746-5b7e-9ed7-77e1ee7e8c76" :question/math-academy-id "q-71494" :question/problem "$(\\sqrt[3]{1,000})^{3}=$" :question/worked-solution "The cube and the cube root cancel each other out. So, we have\n\n$$\n(\\sqrt[3]{1,000})^{3}=1,000.\n$$"}]}
