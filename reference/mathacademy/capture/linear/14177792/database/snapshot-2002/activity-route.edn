ices [{:answer/id #uuid "2cbd15cf-50e0-5f6c-a023-66b7777a5ea1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186493467}] :answer-field/correct {:db/id #edb/ref 17592186493467} :answer-field/id #uuid "77156935-a293-5f77-b17e-01ad81fabeda" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186493837}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "03b02208-a47d-5484-9a1d-0e9d1a5e06da" :question/math-academy-id "q-186156" :question/problem "Evaluate the following:\n\n$\\sqrt[3]{\\frac{125}{8}}=$\n{{field-1}}" :question/worked-solution "First, notice that the numbers $125$ and $8$ are both perfect cubes. \n\nSo, to determine the value of $\\sqrt[3]{\\frac{125}{8}},$ we express $\\frac{125}{8}$ as a perfect cube:\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{125}{8}} & = \\\\ \\sqrt[3]{\\frac{{5}^{3}}{{2}^{3}}} & = \\\\ \\sqrt[3]{\\frac{5\\cdot 5\\cdot 5}{2\\cdot 2\\cdot 2}} & = \\\\ \\sqrt[3]{\\frac{5}{2}\\cdot \\frac{5}{2}\\cdot \\frac{5}{2}} & = \\\\ \\sqrt[3]{{(\\frac{5}{2})}^{3}} & = \\\\ \\frac{5}{2} & \\end{aligned}\n$$"} :step/id #uuid "734e7353-a71f-5a59-9552-8bb9d82e349e"} {:db/id #edb/ref 17592186494056 :step/content {:db/id #edb/ref 17592186493945 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa5916f5-b95b-5530-9d9f-19d0168e2209" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186493658}] :answer-field/correct {:db/id #edb/ref 17592186493658} :answer-field/id #uuid "f90a68c7-dc57-5362-b958-0dc11f3f0c40" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186493888}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "aafcb24f-fde2-52b2-b44a-c7d7fddbc683" :question/math-academy-id "q-186155" :question/problem "Evaluate the following:\n\n$\\sqrt[3]{\\frac{27}{8}}=$\n{{field-1}}" :question/worked-solution "First, notice that the numbers $27$ and $8$ are both perfect cubes. \n\nSo, to determine the value of $\\sqrt[3]{\\frac{27}{8}},$ we express $\\frac{27}{8}$ as a perfect cube:\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{27}{8}} & = \\\\ \\sqrt[3]{\\frac{{3}^{3}}{{2}^{3}}} & = \\\\ \\sqrt[3]{\\frac{3\\cdot 3\\cdot 3}{2\\cdot 2\\cdot 2}} & = \\\\ \\sqrt[3]{\\frac{3}{2}\\cdot \\frac{3}{2}\\cdot \\frac{3}{2}} & = \\\\ \\sqrt[3]{{(\\frac{3}{2})}^{3}} & = \\\\ \\frac{3}{2} & \\end{aligned}\n$$"} :step/id #uuid "d4a52c70-3918-5a00-b200-12e071807393" :step/next {:db/id #edb/ref 17592186494013}}] :activity/title "The Cube Root of a Perfect Cube" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186493383}]}
