  "live_records": {
    "q-339260": {
      "dom_id": "step-q339260",
      "name": "Question 1",
      "problem": "Evaluate the following limit:\n\n${lim}_{x\\to \\,(\\pi /6)^{+}}\\operatorname{sin}⁡(4x-\\frac{\\pi }{3})=$\n{{field-1}}",
      "worked_solution": "Substituting $x=\\frac{\\pi }{6}$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,(\\pi /6)^{+}}\\operatorname{sin}⁡(4x-\\frac{\\pi }{3}) & =\\operatorname{sin}⁡(4\\cdot \\frac{\\pi }{6}-\\frac{\\pi }{3}) \\\\  & =\\operatorname{sin}⁡(\\frac{2\\pi }{3}-\\frac{\\pi }{3}) \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{3}) \\\\  & =\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$",
      "calculator_instructions": "",
