 fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n <use xlink:href=\"#E1-MJMAIN-31\"></use>\n <use xlink:href=\"#E1-MJMAIN-30\" x=\"500\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E1-MJMAIN-3A\" x=\"6059\" y=\"0\"></use>\n<g transform=\"translate(6615,0)\">\n<g fill=\"#C0C1C2\" stroke=\"#C0C1C2\">\n<g fill=\"#C0C1C2\" stroke=\"#C0C1C2\">\n<g fill=\"#C0C1C2\" stroke=\"#C0C1C2\">\n<g fill=\"#C0C1C2\" stroke=\"#C0C1C2\" transform=\"translate(275,0)\">\n<g fill=\"#C0C1C2\" stroke=\"#C0C1C2\">\n<g fill=\"#C0C1C2\" stroke=\"#C0C1C2\">\n<g fill=\"#C0C1C2\" stroke=\"#C0C1C2\">\n<g fill=\"#C0C1C2\" stroke=\"#C0C1C2\">\n<g fill=\"#C0C1C2\" stroke=\"#C0C1C2\"></g>\n</g>\n</g>\n</g>\n</g>\n</g>\n<line stroke-linecap=\"square\" stroke=\"#C0C1C2\" stroke-width=\"75\" y2=\"37\" y1=\"37\" x1=\"37\" x2=\"1513\" transform=\"translate(0,867)\"></line>\n<line stroke-linecap=\"square\" stroke=\"#C0C1C2\" stroke-width=\"75\" y1=\"37\" x2=\"37\" x1=\"37\" y2=\"1202\" transform=\"translate(1476,-298)\"></line>\n<line stroke-linecap=\"square\" stroke=\"#C0C1C2\" stroke-width=\"75\" y2=\"37\" y1=\"37\" x1=\"37\" x2=\"1513\" transform=\"translate(0,-298)\"></line>\n<line stroke-linecap=\"square\" stroke=\"#C0C1C2\" stroke-width=\"75\" y1=\"37\" x2=\"37\" x1=\"37\" y2=\"1202\" transform=\"translate(0,-298)\"></line>\n</g>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E1-MJMAIN-2C\" x=\"8166\" y=\"0\"></use>\n<g transform=\"translate(10611,0)\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n <use xlink:href=\"#E1-MJMAIN-32\"></use>\n <use xlink:href=\"#E1-MJMAIN-30\" x=\"500\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E1-MJMAIN-3A\" x=\"11890\" y=\"0\"></use>\n<g transform=\"translate(12446,0)\">\n<g fill=\"red\" stroke=\"red\">\n<g fill=\"red\" stroke=\"red\">\n<g fill=\"red\" stroke=\"red\">\n <use xlink:href=\"#E1-MJMAIN-34\"></use>\n <use xlink:href=\"#E1-MJMAIN-30\" x=\"500\" y=\"0\">