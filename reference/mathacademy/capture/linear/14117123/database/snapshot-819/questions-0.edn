 #edb/ref 17592186411399} {:answer-field/choices [{:answer/id #uuid "817425b0-ace1-5205-9154-099c68553a12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186411334}] :answer-field/correct {:answer/id #uuid "817425b0-ace1-5205-9154-099c68553a12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186411334} :answer-field/id #uuid "fa977fd4-3715-5eee-bc40-a52f0c7898ad" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186411407}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a78ff0f6-57a5-5952-a9ea-65ceb61c3575" :question/math-academy-id "q-212672" :question/problem "Let $A={2,3,5}$ and consider the relation $R$  that expresses \"divides\" on $A.$ If this relation is given by the set $R,$ express $R$ as a set of ordered pairs.\n\n$R={(2,$\n{{field-1}}$),(3,$\n{{field-2}}$),($\n{{field-3}}$,$\n{{field-4}}$)}$" :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊆{A}^{2}\n$$\n\nIn this case, $R$ is the set of ordered pairs $(x,y)\\in {A}^{2}$ such that $x∣y.$\n\nLet's check each element $x\\in A$ to see which elements $y\\in A$ it could be paired with to satisfy the relation.\n\n- If $x=2,$ then the value $y=2$ satisfies $x∣y.$ So, $R$ contains the ordered pair $(2,2).$\n\n- If $x=3,$ then the value $y=3$ satisfies $x∣y.$ So, $R$ contains the ordered pair $(3,3).$\n\n- If $x=5,$ then the value $y=5$ satisfies $x∣y.$ So, $R$ contains the ordered pair $(5,5).$\n\nTherefore we have\n\n$$\nR={(2,2),(3,3),(5,5)}.\n$$"}] [{:db/id #edb/ref 17592186411418 :knowledge-point/_questions [{:db/id #edb/ref 17592186157238 :knowledge-point/id #uuid "d20eac1d-b78f-5ac7-a3b7-fc72b15307a2" :knowledge-point/title "Listing the Elements of a Non-Standard Relation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ff85075-84c8-552a-abcf-15d9e99ceec0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,4),(4,2)}" :db/id #edb/ref 17592186411319} {:answer/id #uuid "611cf4d1-8a67-5f11-a534-3c447c496121" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,2),(4,2),(4,4)}" :db/id #edb/ref 17592186411320} {:answer/id #uuid "d426d50d-255d-544f-bf06-8545672015f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,2),(2,4),(4,2),(4,4)}" :db/id #edb/ref 17592186411362} {:answer/id #uuid "e78a8bd7-845d-5e27-bae5-2124620c8c46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,2),(2,4),(4,4)}" :db/id #edb/ref 17592186411366} {:answer/id #uuid "f290c802-71c9-53a5-a438-0ec774d59a21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,2),(4,4)}" :db/id #edb/ref 17592186411373}] :answer-field/correct {:answer/id #uuid "611cf4d1-8a67-5f11-a534-3c447c496121" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,2),(4,2),(4,4)}" :db/id #edb/ref 17592186411320} :answer-field/id #uuid "fecaf988-cb99-5dc9-a94d-0ddb5fc7e352" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411408}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "83c912bb-3acb-52a2-b07a-063ab598ee02" :question/math-academy-id "q-212680" :question/problem "Let $B={2,4}.$ Which set is equivalent to the following relation on $B?$\n\n$$\nR={(x,y)\\in {B}^{2}\\,:\\,y\\ne 2x}\n$$" :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊆A\\times A\n$$\n\nIn this case, $R$ is the set of ordered pairs $(x,y)\\in {B}^{2}$ such that $y\\ne 2x.$\n\nLet's check each element $x\\in B$ to see which elements $y\\in B$ it could be paired with to satisfy the conditions of our relation.\n\n- If $x=2,$  then the value $y=2$ satisfies $y\\ne 2x.$ So, $R$ contains the ordered pair $(2,2).$\n\n- If $x=4,$ then the values $y=2$ and $y=4$ satisfy $y\\ne 2x.$ So, $R$ contains the ordered pairs $(4,2)$ and $(4,4).$\n\nTherefore, we can describe our relation as the following set of ordered pairs:\n\n$$\nR={(2,2),(4,2),(4,4)}\n$$"}] [{:db/id #edb/ref 17592186411422 :knowledge-point/_questions [{:db/id #edb/ref 17592186157238 :knowledge-point/id #uuid "d20eac1d-b78f-5ac7-a3b7-fc72b15307a2" :knowledge-point/title "Listing the Elements of a Non-Standard Relation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "062eef9a-d695-51df-997b-6dbff43970c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-1,-1),(0,0),(1,1)}" :db/id #edb/ref 17592186411292} {:answer/id #uuid "0cc4d213-ab46-5a61-9eeb-6fcdea273470" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(0,-1),(0,1)}" :db/id #edb/ref 17592186411295} {:answer/id #uuid "9b310337-8e8d-5fcf-b163-488e852a4756" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-1,0),(1,0)}" :db/id #edb/ref 17592186411343} {:answer/id #uuid "a5a23483-f183-50bb-b8a0-25abcc57fd99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-1,0),(0,1)}" :db/id #edb/ref 17592186411346} {:answer/id #uuid "ed06703d-b1da-5c2e-baee-e17baa87d3f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-1,0),(0,-1),(0,1),(1,0)}" :db/id #edb/ref 17592186411367}] :answer-field/correct {:answer/id #uuid "ed06703d-b1da-5c2e-baee-e17baa87d3f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-1,0),(0,-1),(0,1),(1,0)}" :db/id #edb/ref 17592186411367} :answer-field/id #uuid "c992d4ef-f4b0-5356-b57f-ca3d4886f15e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411400}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e334acc3-1257-55fa-a023-43a93b22b41c" :question/math-academy-id "q-212682" :question/problem "Let $B={-1,0,1}.$ Which set is equivalent to the following relation on $B?$\n\n$$\nR={(x,y)\\in {B}^{2}\\,:\\,|x|\\ne |y|}\n$$" :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊆A\\times A\n$$\n\nIn this case, $R$ is the set of ordered pairs $(x,y)\\in {B}^{2}$ such that $|x|\\ne |y|.$\n\nLet's check each element $x\\in B$ to see which elements $y\\in B$ it could be paired with to satisfy the conditions of our relation.\n\n- If $x=-1,$  then the value $y=0$ satisfies $|x|\\ne |y|.$ So, $R$ contains the ordered pair $(-1,0).$\n\n- If $x=0,$ then the values $y=-1$ and $y=1$ satisfy $|x|\\ne |y|.$ So, $R$ contains the ordered pairs $(0,-1)$ and $(0,1).$\n\n- If $x=1,$  then the value $y=0$ satisfies $|x|\\ne |y|.$ So, $R$ contains the ordered pair $(1,0).$\n\nTherefore, we can describe our relation as the following set of ordered pairs:\n\n$$\nR={(-1,0),(0,-1),(0,1),(1,0)}\n$$"}] [{:db/id #edb/ref 17592186411412 :knowledge-point/_questions [{:db/id #edb/ref 17592186157238 :knowledge-point/id #uuid "d20eac1d-b78f-5ac7-a3b7-fc72b15307a2" :knowledge-point/title "Listing the Elements of a Non-Standard Relation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "049c5d72-e52b-5919-9ea2-e45de1d3dc93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,3),(3,2),(3,4),(4,3)}" :db/id #edb/ref 17592186411290} {:answer/id #uuid "653be230-d17e-59ac-bd89-f763870e1489" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,2),(3,2),(3,4),(4,3),(4,4)}" :db/id #edb/ref 17592186411321} {:answer/id #uuid "edd90124-3f30-5b6b-88a0-76519c0384f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,3),(3,2)}" :db/id #edb/ref 17592186411368} {:answer/id #uuid "f9611862-6363-5312-95fd-1bd8b5529014" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,3),(3,4)}" :db/id #edb/ref 17592186411377} {:answer/id #uuid "fc327c96-f859-56ca-8311-44d9c34d34ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(3,4),(4,3)}" :db/id #edb/ref 17592186411380}] :answer-field/correct {:answer/id #uuid "049c5d72-e52b-5919-9ea2-e45de1d3dc93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,3),(3,2),(3,4),(4,3)}" :db/id #edb/ref 17592186411290} :answer-field/id #uuid "bdb7ef21-56fd-5217-8d74-98919d28940a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411397}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3851f98e-30d8-57c7-a741-0f30315f4e40" :question/math-academy-id "q-212987" :question/problem "Let $B={2,3,4}.$ Which set is equivalent to the following relation on $B?$\n\n$$\nR={(x,y)\\in {B}^{2}\\,:\\,6∣xy}\n$$" :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊆A\\times A\n$$\n\nIn this case, $R$ is the set of ordered pairs $(x,y)\\in {B}^{2}$ such that $6∣xy.$\n\nLet's check each element $x\\in B$ to see which elements $y\\in B$ it could be paired with to satisfy the conditions of our relation.\n\n- If $x=2,$ then the value $y=3$ satisfies $6∣xy.$ So, $R$ contains the ordered pair $(2,3).$\n\n- If $x=3,$ then the values $y=2,4$ satisfy $6∣xy.$ So, $R$ contains the ordered pairs $(3,2)$ and $(3,4).$\n\n- If $x=4,$ then the value $y=3$ satisfies $6∣xy.$ So, $R$ contains the ordered pair $(4,3).$\n\nTherefore, we can describe our relation as the following set of ordered pairs:\n\n$$\nR={(2,3),(3,2),(3,4),(4,3)}\n$$"}] [{:db/id #edb/ref 17592186411428 :knowledge-point/_questions [{:db/id #edb/ref 17592186157236 :knowledge-point/id #uuid "f77177ee-74b0-5681-92a8-ed6994ab9f9c" :knowledge-point/title "Identifying Elements of Standard Relations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b23e99e-1de5-5692-a3a2-5e71190c3a00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,2),(7,7)}" :db/id #edb/ref 17592186411294} {:answer/id #uuid "2968b5a9-37c2-509f-ae03-8610194ddb2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,2),(2,6),(6,2),(6,6),(7,7)}" :db/id #edb/ref 17592186411305} {:answer/id #uuid "350f986b-683b-5497-b64f-269441499b3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,2),(2,7),(6,6),(7,2),(7,7)}" :db/id #edb/ref 17592186411310} {:answer/id #uuid "81b0727d-ee68-559d-8314-8b52ff89305c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,2),(6,6)}" :db/id #edb/ref 17592186411335} {:answer/id #uuid "a93c8df8-be46-5d45-9c8b-528320c106ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,2),(6,6),(7,7)}" :db/id #edb/ref 17592186411349}] :answer-field/correct {:answer/id #uuid "a93c8df8-be46-5d45-9c8b-528320c106ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,2),(6,6),(7,7)}" :db/id #edb/ref 17592186411349} :answer-field/id #uuid "3df79f96-c8f5-54fb-8485-e7041ea3278a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411385}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fde29981-bedc-59e2-aa69-f2b0b112afe3" :question/math-academy-id "q-212992" :question/problem "Let $A={2,6,7}$ and consider the relation \"are congruent modulo $3$\" on $A.$ Write out $R$ as a set of ordered pairs." :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊆{A}^{2}\n$$\n\nIn this case, $R$ is the set of ordered pairs $(x,y)\\in {A}^{2}$ such that $x≡y\\,(\\text{mod}\\,3).$\n\nLet's check each element $x\\in A$ to see which elements $y\\in A$ it could be paired with to satisfy the relation.\n\n- If $x=2,$ then the value $y=2$ satisfies $x≡y\\,(\\text{mod}\\,3),$ since $3∣(2-2).$ So, $R$ contains the ordered pair $(2,2).$\n\n- If $x=6,$ then the value $y=6$ satisfies $x≡y\\,(\\text{mod}\\,3),$ since $3∣(6-6).$ So, $R$ contains the ordered pair $(6,6).$\n\n- If $x=7,$ then the value $y=7$ satisfies $x≡y\\,(\\text{mod}\\,3),$ since $3∣(7-7).$ So, $R$ contains the ordered pair $(7,7).$\n\nTherefore, we can describe our relation as the following set of ordered pairs:\n\n$$\nR={(2,2),(6,6),(7,7)}\n$$"}] [{:db/id #edb/ref 17592186411414 :knowledge-point/_questions [{:db/id #edb/ref 17592186157236 :knowledge-point/id #uuid "f77177ee-74b0-5681-92a8-ed6994ab9f9c" :knowledge-point/title "Identifying Elements of Standard Relations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f234402-5996-5684-928e-7b0ae18f1678" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,7),(5,8),(7,2),(8,5)}" :db/id #edb/ref 17592186411314} {:answer/id #uuid "693664ab-3d6c-5886-bbe2-793b4383b88b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,2),(8,2)}" :db/id #edb/ref 17592186411323} {:answer/id #uuid "ac6d453c-2244-5dae-b520-317dbb2b7fdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,2),(5,5),(7,7)}" :db/id #edb/ref 17592186411351} {:answer/id #uuid "f13b87d5-60ca-51a7-a731-e812b70eabc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,2),(5,5),(7,7),(8,8)}" :db/id #edb/ref 17592186411371} {:answer/id #uuid "f6a44e7a-ffa7-553f-91c8-4409f1dfdae6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,5),(5,2),(7,7)}" :db/id #edb/ref 17592186411375}] :answer-field/correct {:answer/id #uuid "f13b87d5-60ca-51a7-a731-e812b70eabc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,2),(5,5),(7,7),(8,8)}" :db/id #edb/ref 17592186411371} :answer-field/id #uuid "c1dc1273-46be-5e0f-ac29-ed393ac36d5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411398}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "574049a2-4cdf-559c-928c-2935ffb5f29c" :question/math-academy-id "q-212993" :question/problem "Let $A={2,5,7,8}$ and consider the relation \"are congruent modulo $4$\" on $A.$ Write out $R$ as a set of ordered pairs." :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊆{A}^{2}\n$$\n\nIn this case, $R$ is the set of ordered pairs $(x,y)\\in {A}^{2}$ such that $x≡y\\,(\\text{mod}\\,4).$\n\nLet's check each element $x\\in A$ to see which elements $y\\in A$ it could be paired with to satisfy the relation.\n\n- If $x=2,$ then the value $y=2$ satisfies $x≡y\\,(\\text{mod}\\,4),$ since $4∣(2-2).$ So, $R$ contains the ordered pair $(2,2).$\n\n- If $x=5,$ then the value $y=5$ satisfies $x≡y\\,(\\text{mod}\\,4),$ since $4∣(5-5).$ So, $R$ contains the ordered pair $(5,5).$\n\n- If $x=7,$ then the value $y=7$ satisfies $x≡y\\,(\\text{mod}\\,4),$ since $4∣(7-7).$ So, $R$ contains the ordered pair $(7,7).$\n\n- If $x=8,$ then the value $y=8$ satisfies $x≡y\\,(\\text{mod}\\,4),$ since $4∣(8-8).$ So, $R$ contains the ordered pair $(8,8).$\n\nTherefore, we can describe our relation as the following set of ordered pairs:\n\n$$\nR={(2,2),(5,5),(7,7),(8,8)}\n$$"}] [{:db/id #edb/ref 17592186411426 :knowledge-point/_questions [{:db/id #edb/ref 17592186157236 :knowledge-point/id #uuid "f77177ee-74b0-5681-92a8-ed6994ab9f9c" :knowledge-point/title "Identifying Elements of Standard Relations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15dac1d9-fe63-5721-9ab9-da8fc1bab8f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(1,1),(5,5),(8,8)}" :db/id #edb/ref 17592186411297} {:answer/id #uuid "18ee8622-5b6f-58a5-805d-8e60c7ef123e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(1,8),(5,10),(8,1),(10,5)}" :db/id #edb/ref 17592186411298} {:answer/id #uuid "2f2b76e5-878a-50c1-800f-9991b9c884ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(1,5),(5,1),(8,8)}" :db/id #edb/ref 17592186411309} {:answer/id #uuid "c88518ac-e616-52fd-9a8b-b836755a0e56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(1,1),(5,5),(8,8),(10,10)}" :db/id #edb/ref 17592186411357} {:answer/id #uuid "fa7fff05-0e03-5f11-9307-fb11de4611ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(1,1),(10,1)}" :db/id #edb/ref 17592186411378}] :answer-field/correct {:answer/id #uuid "c88518ac-e616-52fd-9a8b-b836755a0e56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(1,1),(5,5),(8,8),(10,10)}" :db/id #edb/ref 17592186411357} :answer-field/id #uuid "6d607400-fd49-5439-8653-e1c05d6d24d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411390}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ea035c4b-8c95-55ec-bda8-6412f4cfc534" :question/math-academy-id "q-212994" :question/problem "Let $A={1,5,8,10}$ and consider the relation \"are congruent modulo $6$\" on $A.$ Write out $R$ as a set of ordered pairs." :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊆{A}^{2}\n$$\n\nIn this case, $R$ is the set of ordered pairs $(x,y)\\in {A}^{2}$ such that $x≡y\\,(\\text{mod}\\,6).$\n\nLet's check each element $x\\in A$ to see which elements $y\\in A$ it could be paired with to satisfy the relation.\n\n- If $x=1,$ then the value $y=1$ satisfies $x≡y\\,(\\text{mod}\\,6),$ since $6∣(1-1).$ So, $R$ contains the ordered pair $(1,1).$\n\n- If $x=5,$ then the value $y=5$ satisfies $x≡y\\,(\\text{mod}\\,6),$ since $6∣(5-5).$ So, $R$ contains the ordered pair $(5,5).$\n\n- If $x=8,$ then the value $y=8$ satisfies $x≡y\\,(\\text{mod}\\,6),$ since $6∣(8-8).$ So, $R$ contains the ordered pair $(8,8).$\n\n- If $x=10,$ then the value $y=10$ satisfies $x≡y\\,(\\text{mod}\\,6),$ since $6∣(10-10).$ So, $R$ contains the ordered pair $(10,10).$\n\nTherefore, we can describe our relation as the following set of ordered pairs:\n\n$$\nR={(1,1),(5,5),(8,8),(10,10)}\n$$"}] [{:db/id #edb/ref 17592186411424 :knowledge-point/_questions [{:db/id #edb/ref 17592186157236 :knowledge-point/id #uuid "f77177ee-74b0-5681-92a8-ed6994ab9f9c" :knowledge-point/title "Identifying Elements of Standard Relations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05d68007-c8a5-5b35-9d67-46ee6326aaf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,2),(2,5),(5,2),(5,5)}" :db/id #edb/ref 17592186411291} {:answer/id #uuid "772a90b0-1a02-5e16-b0a0-a46a4c8a84c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,5),(5,2)}" :db/id #edb/ref 17592186411328} {:answer/id #uuid "781984fa-07a6-5b6f-b98d-17c1d0d8bee3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,2),(2,5),(5,5)}" :db/id #edb/ref 17592186411330} {:answer/id #uuid "a6537ffb-bb0e-5640-97f1-20f818f26f43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,2),(5,2),(5,5)}" :db/id #edb/ref 17592186411347} {:answer/id #uuid "fc102a2a-5763-5d46-8b6b-bbee3d064deb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,2),(5,5)}" :db/id #edb/ref 17592186411379}] :answer-field/correct {:answer/id #uuid "05d68007-c8a5-5b35-9d67-46ee6326aaf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,2),(2,5),(5,2),(5,5)}" :db/id #edb/ref 17592186411291} :answer-field/id #uuid "87aa18b4-cff3-56a1-bf1b-654c57d19070" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411393}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e361298d-a398-53c4-959a-8c4c1fccbe8b" :question/math-academy-id "q-212996" :question/problem "Let $A={2,5}$ and consider the relation \"are congruent modulo $3$\" on $A.$ Write out $R$ as a set of ordered pairs." :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊆{A}^{2}\n$$\n\nIn this case, $R$ is the set of ordered pairs $(x,y)\\in {A}^{2}$ such that $x≡y\\,(\\text{mod}\\,3).$\n\nLet's check each element $x\\in A$ to see which elements $y\\in A$ it could be paired with to satisfy the relation.\n\n- If $x=2,$ then the values $y=2$ and $y=5$ satisfy $x≡y\\,(\\text{mod}\\,3),$ since $3∣(2-2)$ and $3∣(2-5).$ So, $R$ contains the ordered pairs $(2,2),(2,5).$\n\n- If $x=5,$ then the values $y=2$ and $y=5$ satisfy $x≡y\\,(\\text{mod}\\,3),$ since $3∣(5-2)$ and $3∣(5-5).$ So, $R$ contains the ordered pairs $(5,2),(5,5).$\n\nTherefore, we can describe our relation as the following set of ordered pairs:\n\n$$\nR={(2,2),(2,5),(5,2),(5,5)}\n$$"}] [{:db/id #edb/ref 17592186411420 :knowledge-point/_questions [{:db/id #edb/ref 17592186157236 :knowledge-point/id #uuid "f77177ee-74b0-5681-92a8-ed6994ab9f9c" :knowledge-point/title "Identifying Elements of Standard Relations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "046a0b5d-b969-58cc-947c-f4f868bbbdde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186411289} {:answer/id #uuid "1c321d12-faed-5b6b-b6cb-b31615bfec34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the ordered pairs are elements of the relation." :db/id #edb/ref 17592186411299} {:answer/id #uuid "83250d56-27d9-5d35-998f-7c225e26de93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186411336} {:answer/id #uuid "d0ffa5ba-9fc3-5ce6-841a-f2088a84936d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186411359} {:answer/id #uuid "f5797c74-f7f7-51f3-9dfa-2fc0175bef87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186411374}] :answer-field/correct {:answer/id #uuid "046a0b5d-b969-58cc-947c-f4f868bbbdde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186411289} :answer-field/id #uuid "cee0f5da-3466-5854-93e2-01adf980becc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411403}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bb1a702e-c18f-5fe7-b6f2-5f1506bc9396" :question/math-academy-id "q-213003" :question/problem "Consider the following set:\n\n$$\nA={{0},{1,0}}\n$$\n\nWhich of the following ordered pairs is an element of the relation \"is **not** a subset of\" on $A?$ \n\n- $({0},{1,0})$\n- $({1,0},{0})$\n- $({1,0},{1,0})$" :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊆{A}^{2}\n$$\n\nIn this case, $R$ is the set of ordered pairs $(x,y)\\in {A}^{2}$ such that $x⊈y.$\n\nWith that in mind, let's examine our ordered pairs in turn.\n\n- The ordered pair $({0},{1,0})$ is **not** an element of $R$ since ${0}⊆{1,0}.\\,\\times $\n\n- The ordered pair $({1,0},{0})$ is an element of $R$ since ${1,0}⊈{0}.\\,✓$\n\n- The ordered pair $({1,0},{1,0})$ is **not** an element of $R$ since ${1,0}⊆{1,0}.\\,\\times $\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186411415 :knowledge-point/_questions [{:db/id #edb/ref 17592186157237 :knowledge-point/id #uuid "8479a60b-b5db-5ad4-8100-fd2db8002091" :knowledge-point/title "Using the x R y Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d51ed98-ac24-5fc6-a3ec-b6f3ee2ab3da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186411306} {:answer/id #uuid "7a3dd6bc-4ebf-5239-844d-55920fd64463" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186411331} {:answer/id #uuid "843aa144-29e1-5a7a-b5ed-0a15c64b58f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186411337} {:answer/id #uuid "de98701f-4772-5961-b734-93e00e6687bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186411364} {:answer/id #uuid "f09ba51b-bb92-5a76-b8d4-9b2465b49c33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186411370}] :answer-field/correct {:answer/id #uuid "7a3dd6bc-4ebf-5239-844d-55920fd64463" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186411331} :answer-field/id #uuid "6eed9603-46c9-5a60-91ed-069b81019517" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411391}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5fbac889-73d0-5b8f-a301-da4ef8cb327a" :question/math-academy-id "q-213127" :question/problem "Consider the following set:\n\n$$\nA={1,3}\n$$\n\nGiven the relation $R$ on $A$ defined by\n\n$$\nx\\,R\\,y\\,⇔\\,x=y,\n$$\n\nwhich of the following statements are true?\n\n- $1\\,R\\,1$\n- $1\\,R\\,3$\n- $3\\,\\cancel{\\,R\\,}\\,3$" :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊆{A}^{2}\n$$\n\nWe also have the following notations:\n\n- $x\\,R\\,y$ if and only if $(x,y)\\in R$\n\n- $x\\,\\cancel{\\,R\\,}\\,y$ if and only if $(x,y)\\notin R$\n\nIn this case, we have $x\\,R\\,y$ if and only if $x=y.$ For this relation, note that\n\n- the symbols $R$ and $=$ are interchangeable, and\n\n- the symbols $\\cancel{\\,R\\,}$ and $\\ne $ are also interchangeable.\n\nWith that in mind, let's examine our statements in turn:\n\n- Statement I is  true. Replacing $R$ with the symbol $=$, we have $1=1,$ which is true.\n\n- Statement II is false. Replacing $R$ with the symbol $=,$ we have $1=3,$ which is false.\n\n- Statement III is false. Replacing $\\cancel{\\,R\\,}$ with the symbol $\\ne ,$ we have $3\\ne 3,$ which is false.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186411410 :knowledge-point/_questions [{:db/id #edb/ref 17592186157237 :knowledge-point/id #uuid "8479a60b-b5db-5ad4-8100-fd2db8002091" :knowledge-point/title "Using the x R y Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50d4ef47-2283-5013-800d-55532771b590" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186411315} {:answer/id #uuid "69a086d9-ed8a-5d19-a711-31dea503c803" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id #edb/ref 17592186411324} {:answer/id #uuid "8488ff21-a2ea-5b43-889c-08cc212c8dc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186411338} {:answer/id #uuid "94a8c259-c943-5b5a-8249-ef29a64409c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186411341} {:answer/id #uuid "a68b31a5-13d7-58c4-8b9a-c44045ea0cd4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186411348}] :answer-field/correct {:answer/id #uuid "a68b31a5-13d7-58c4-8b9a-c44045ea0cd4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186411348} :answer-field/id #uuid "b5e8b322-e012-50ae-b918-cd16e0ce7f37" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411396}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2006d399-9a69-519f-8bb4-45f612aefe6e" :question/math-academy-id "q-213141" :question/problem "Consider the following set:\n\n$$\nA={{0},{0,1}}\n$$\n\nGiven the relation $R$ on $A$ defined by\n\n$$\nX\\,R\\,Y\\,⇔\\,X⊃Y,\n$$\n\nwhich of the following statements are true?\n\n- ${0}\\,R\\,{0,1}$\n- ${0,1}\\,R\\,{0,1}$\n- ${0}\\,\\cancel{\\,R\\,}\\,{0}$" :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊂{A}^{2}\n$$\n\nWe also have the following notations:\n\n- $x\\,R\\,y$ if and only if $(x,y)\\in R$\n\n- $x\\,\\cancel{\\,R\\,}\\,y$ if and only if $(x,y)\\notin R$\n\nIn this case, we have $X\\,R\\,Y$ if and only if $X⊃Y.$ For this relation, note that\n\n- the symbols $R$ and $⊃$ are interchangeable, and\n\n- the symbols $\\cancel{\\,R\\,}$ and $⊅$ are also interchangeable.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. Replacing $R$ with the symbol $⊃,$ we have ${0}⊃{0,1}.$ This is equivalent to ${0,1}⊂{0},$ which is false.\n\n- Statement II is false. Replacing $R$ with the symbol $⊃,$ we have ${0,1}⊃{0,1}.$ This is equivalent to ${0,1}⊂{0,1},$ which is false.\n\n- Statement III is true. Replacing $\\cancel{\\,R\\,}$ with the symbol $⊅,$ we have ${0}⊅{0}.$ This is equivalent to ${0}⊄{0},$ which is true.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186411416 :knowledge-point/_questions [{:db/id #edb/ref 17592186157237 :knowledge-point/id #uuid "8479a60b-b5db-5ad4-8100-fd2db8002091" :knowledge-point/title "Using the x R y Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "239771eb-1873-5866-a462-6727c30f35e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186411301} {:answer/id #uuid "4b2c6f96-fc4e-5564-95d5-c89c5d1f7d0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186411312} {:answer/id #uuid "d26ca1a3-71a4-578b-b77f-cb0242ad66b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186411361} {:answer/id #uuid "db9ed992-4a83-51d6-999e-2f07e0541fbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186411363} {:answer/id #uuid "f7a71d76-19a3-532b-ba22-51c4aa5690b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186411376}] :answer-field/correct {:answer/id #uuid "d26ca1a3-71a4-578b-b77f-cb0242ad66b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186411361} :answer-field/id #uuid "ce8e8452-662e-5d96-814f-930fa128fbd9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411402}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "77fae439-40b7-5f50-94ed-61df5583b377" :question/math-academy-id "q-213144" :question/problem "Consider the following set:\n\n$$\nA={2,4,6}\n$$\n\nGiven the relation $R$ on $A$ defined by\n\n$$\nx\\,R\\,y\\,⇔\\,x∤y,\n$$\n\nwhich of the following statements are true?\n\n- $2\\,R\\,4$\n- $4\\,R\\,6$\n- $2\\,\\cancel{\\,R\\,}\\,6$" :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊆{A}^{2}\n$$\n\nWe also have the following notations:\n\n- $x\\,R\\,y$ if and only if $(x,y)\\in R$\n\n- $x\\,\\cancel{\\,R\\,}\\,y$ if and only if $(x,y)\\notin R$\n\nIn this case, we have $x\\,R\\,y$ if and only if $x∤y.$ For this relation, note that\n\n- the symbols $R$ and $∤$ are interchangeable, and\n\n- the symbols $\\cancel{\\,R\\,}$ and $∣$ are also interchangeable.\n\nWith that in mind, let's examine our statements in turn:\n\n- Statement I is false. Replacing $R$ with the symbol $∤$, we have $2∤4,$ which is false.\n\n- Statement II is true. Replacing $R$ with the symbol $∤,$ we have $4∤6,$ which is true.\n\n- Statement III is true. Replacing $\\cancel{\\,R\\,}$ with the symbol $∣,$ we have $2∣6,$ which is true.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186411423 :knowledge-point/_questions [{:db/id #edb/ref 17592186157237 :knowledge-point/id #uuid "8479a60b-b5db-5ad4-8100-fd2db8002091" :knowledge-point/title "Using the x R y Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fb48062-390e-5f50-95e5-46245a4669c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186411325} {:answer/id #uuid "862baade-6c89-5f3f-a85b-756cfdc43c56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186411339} {:answer/id #uuid "8868f605-fc4c-52a6-a072-da3b71bc8621" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186411340} {:answer/id #uuid "d231e4f4-a503-5b71-aee4-7e628eb0ceaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186411360} {:answer/id #uuid "df350fa9-2809-583c-a268-f8b8d3e8def1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186411365}] :answer-field/correct {:answer/id #uuid "6fb48062-390e-5f50-95e5-46245a4669c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186411325} :answer-field/id #uuid "5deadd58-de08-5459-bea5-ad5b2c6a1739" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411389}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e3479154-8b81-59b7-8f1a-b3765342f61c" :question/math-academy-id "q-213145" :question/problem "Consider the following set:\n\n$$\nA={1,2}\n$$\n\nGiven the relation $R$ on $A$ defined by\n\n$$\nx\\,R\\,y\\,⇔\\,x∣y,\n$$\n\nwhich of the following statements are true?\n\n- $1\\,R\\,1$\n- $1\\,R\\,2$\n- $2\\,\\cancel{\\,R\\,}\\,2$" :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊆{A}^{2}\n$$\n\nWe also have the following notations:\n\n- $x\\,R\\,y$ if and only if $(x,y)\\in R$\n\n- $x\\,\\cancel{\\,R\\,}\\,y$ if and only if $(x,y)\\notin R$\n\nIn this case, we have $x\\,R\\,y$ if and only if $x∣y.$ For this relation, note that\n\n- the symbols $R$ and $∣$ are interchangeable, and\n\n- the symbols $\\cancel{\\,R\\,}$ and $∤$ are also interchangeable.\n\nWith that in mind, let's examine our statements in turn:\n\n- Statement I is true. Replacing $R$ with the symbol $∣$, we have $1∣1,$ which is true.\n\n- Statement II is true. Replacing $R$ with the symbol $∣,$ we have $1∣2,$ which is true.\n\n- Statement III is false. Replacing $\\cancel{\\,R\\,}$ with the symbol $∤,$ we have $2∤2,$ which is false.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186411421 :knowledge-point/_questions [{:db/id #edb/ref 17592186157238 :knowledge-point/id #uuid "d20eac1d-b78f-5ac7-a3b7-fc72b15307a2" :knowledge-point/title "Listing the Elements of a Non-Standard Relation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03d2e1d8-b19e-57f6-97a6-97712408191a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-3,-3),(4,-3),(4,4)}" :db/id #edb/ref 17592186411288} {:answer/id #uuid "2f1a5510-01d0-517e-aa7d-b577a1995fee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(3,3),(4,4)}" :db/id #edb/ref 17592186411308} {:answer/id #uuid "4088dcdd-6da7-565d-a4c7-f6c2fdec1349" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(4,-3)}" :db/id #edb/ref 17592186411311} {:answer/id #uuid "aa395104-66ea-531c-86a0-d4e5a9926b19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-3,-3),(-3,4),(4,-3),(4,4)}" :db/id #edb/ref 17592186411350} {:answer/id #uuid "b7fc812e-bc00-5c66-92c5-c5fcbf5ecbab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-3,-3),(4,4),}" :db/id #edb/ref 17592186411352}] :answer-field/correct {:answer/id #uuid "03d2e1d8-b19e-57f6-97a6-97712408191a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-3,-3),(4,-3),(4,4)}" :db/id #edb/ref 17592186411288} :answer-field/id #uuid "0371d26b-89a5-595b-af82-53817cdb9826" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411383}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c4d6f6f1-1f94-593d-9a86-a74c8d692551" :question/math-academy-id "q-80827" :question/problem "Let $X={-3,4}.$ Which set is equivalent to the following relation on $X?$\n\n$$\nS={(x,y)\\in {X}^{2}\\,:\\,x>y-2}\n$$" :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊆A\\times A\n$$\n\nIn this case, $S$ is the set of ordered pairs $(x,y)\\in {X}^{2}$ such that $x>y-2.$\n\nLet's check each element $x\\in X$ to see which elements $y\\in X$ it could be paired with to satisfy the conditions of our relation.\n\n- If $x=-3,$ then the value $y=-3$ satisfies $x>y-2.$ So, $S$ contains the ordered pair $(-3,-3).$\n\n- If $x=4,$ then the values $y=-3,4$ satisfy $x>y-2.$ So, $S$ contains the ordered pairs $(4,-3),(4,4).$\n\nTherefore, we can describe our relation as the following set of ordered pairs:\n\n$$\nS={(-3,-3),(4,-3),(4,4)}\n$$"}] [{:db/id #edb/ref 17592186411425 :knowledge-point/_questions [{:db/id #edb/ref 17592186157238 :knowledge-point/id #uuid "d20eac1d-b78f-5ac7-a3b7-fc72b15307a2" :knowledge-point/title "Listing the Elements of a Non-Standard Relation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25fea826-58a1-557d-b3b1-f039d3b38948" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(0,0),(1,2),(2,4),(3,6),(4,8)}" :db/id #edb/ref 17592186411303} {:answer/id #uuid "5f3e4d2b-6935-5acd-bca1-e452ceaf0a64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(0,0),(1,2),(2,4)}" :db/id #edb/ref 17592186411318} {:answer/id #uuid "9db20c0f-75fd-5a68-95fc-a43ea8d75d14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(0,0),(1,2),(2,1)}" :db/id #edb/ref 17592186411344} {:answer/id #uuid "bc145f72-ba17-5e60-a29a-392f841ec3c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(2,2),(4,4)}" :db/id #edb/ref 17592186411353} {:answer/id #uuid "bec92dfe-fed6-5699-95d9-4104be6385c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(0,1),(1,2),(3,4)}" :db/id #edb/ref 17592186411354}] :answer-field/correct {:answer/id #uuid "5f3e4d2b-6935-5acd-bca1-e452ceaf0a64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(0,0),(1,2),(2,4)}" :db/id #edb/ref 17592186411318} :answer-field/id #uuid "02cbbdcb-3772-5ead-be55-a689a2b35c64" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411382}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e8f12d3f-cce2-55c4-a847-238022b586e2" :question/math-academy-id "q-85991" :question/problem "Let $B={0,1,2,3,4}.$ Which set is equivalent to the following relation on $B?$\n\n$$\nR={(x,y)\\in {B}^{2}\\,:\\,y=2x}\n$$" :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊆A\\times A\n$$\n\nIn this case, $R$ is the set of ordered pairs $(x,y)\\in {B}^{2}$ such that $y=2x.$\n\nLet's check each element $x\\in B$ to see which elements $y\\in B$ it could be paired with to satisfy the conditions of our relation.\n\n- If $x=0,$  then the value $y=0$ satisfies $y=2x.$ So, $R$ contains the ordered pair $(0,0).$\n\n- If $x=1,$ then the value $y=2$ satisfies $y=2x.$ So, $R$ contains the ordered pair  $(1,2).$\n\n- If $x=2,$ then the value $y=4$ satisfies $y=2x.$ So, $R$ contains the ordered pair  $(2,4).$\n\n- If $x=3,$  then there is no value of $y\\in B$ that satisfies $y=2x.$\n\n- If $x=4,$ then there is no value of $y\\in B$ that satisfies $y=2x.$\n\nTherefore, we can describe our relation as the following set of ordered pairs:\n\n$$\nR={(0,0),(1,2),(2,4)}\n$$"}] [{:db/id #edb/ref 17592186411417 :knowledge-point/_questions [{:db/id #edb/ref 17592186157235 :knowledge-point/id #uuid "481d9abf-1edd-5049-bae7-2e727fe3954c" :knowledge-point/title "Listing the Elements of a Standard Relation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28fffde8-0f15-590b-b313-a615bbc7d100" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(1,1),(2,2)}" :db/id #edb/ref 17592186411304} {:answer/id #uuid "50e8c12d-d76f-554c-95cf-22755b1a8087" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(1,2),(2,3),(3,1)}" :db/id #edb/ref 17592186411316} {:answer/id #uuid "594fb071-71f3-54b0-9e54-8f6f7d06c463" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(1,3),(1,2),(2,3)}" :db/id #edb/ref 17592186411317} {:answer/id #uuid "9b1ed781-65d2-51f6-b0c0-b747ad7f2fb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(1,1),(2,2),(3,3)}" :db/id #edb/ref 17592186411342} {:answer/id #uuid "d0d08f05-09bc-57d5-a523-a34df8911c1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(1,2)}" :db/id #edb/ref 17592186411358}] :answer-field/correct {:answer/id #uuid "9b1ed781-65d2-51f6-b0c0-b747ad7f2fb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(1,1),(2,2),(3,3)}" :db/id #edb/ref 17592186411342} :answer-field/id #uuid "aa624be9-63b4-5b08-ab97-1c06e571369d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411395}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "838da398-ab9b-51bd-b33e-d5677f36abd0" :question/math-academy-id "q-85997" :question/problem "Let $A={1,2,3}$ and consider the relation \"is equal to\" $(=)$ on $A.$ Which of the following sets describes the relation?" :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊆{A}^{2}\n$$\n\nIn this case, $R$ is the set of ordered pairs $(x,y)\\in {A}^{2}$ such that $x=y.$\n\nLet's check each element $x\\in A$ to see which elements $y\\in A$ it could be paired with to satisfy the relation.\n\n- If $x=1,$ then the value $y=1$ satisfies $x=y.$ So, $R$ contains the ordered pair $(1,1).$\n\n- If $x=2,$ then the value $y=2$ satisfies $x=y.$ So, $R$ contains the ordered pair $(2,2).$\n\n- If $x=3,$ then the value $y=3$ satisfies $x=y.$  So, $R$ contains the ordered pair $(3,3).$\n\nTherefore, we can describe our relation as the following set of ordered pairs:\n\n$$\nR={(1,1),(2,2),(3,3)}\n$$"}]}
