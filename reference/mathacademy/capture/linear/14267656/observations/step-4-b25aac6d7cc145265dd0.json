67em\"></mspace></mstyle></math></mjx-assistive-mml></mjx-container>\n\n\n                                    \n                                \n                                    \n                            \n                                        <div class=\"matheditor-wrapper-answer\" style=\"min-width: 30px; margin-left: 5px; margin-right: 5px;\">\n                                             \n                                        <div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"7\"><span mathquill-command-id=\"31\">1</span></span></div></div>                \n                                    \n                                 \n\n                                \n                                        </div> <!-- freeResponseLine --> \n                                    </div> <!-- freeResponse --> \n                                \n\n                                                      \n                        </div>  \n\n                        \n\n                        <div class=\"submitButtonFrame\">                     \n                            <div id=\"submitButton-4\" class=\"submitButton enabledButton\" style=\"display: none;\">Submit</div>                            \n                        </div>  \n                  \n                        <div class=\"spinnerFrame\">\n                            <img id=\"spinner-4\" class=\"spinner\" src=\"/img/spinner.gif\" style=\"display: none;\">\n                        </div>\n\n                        <div id=\"question-167536-explanationFrame\" style=\"display: block;\">\n                               \n                        <div class=\"answer\">\n                <table>\n                    <tbo