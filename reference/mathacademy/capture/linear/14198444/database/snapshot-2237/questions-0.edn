-point/_questions [{:db/id #edb/ref 17592186054759 :knowledge-point/id #uuid "203f17e9-3efb-5637-ac02-2c31e5a8a632" :knowledge-point/title "Rationalizing Denominators Containing Surds in the Numerator and Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52506a91-197c-5fae-8c50-1577880fdaea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{5}-5}{4}" :db/id #edb/ref 17592186515051} {:answer/id #uuid "c7a2949a-2eac-5516-8b3e-0a0551438446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}-2" :db/id #edb/ref 17592186515296} {:answer/id #uuid "ca073c5c-f114-5614-9d30-fddd83084c4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{5}-3}{2}" :db/id #edb/ref 17592186515300} {:answer/id #uuid "e4315590-fb74-5bd1-859f-d18f7a914d2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{5}+7}{4}" :db/id #edb/ref 17592186515348} {:answer/id #uuid "eace7a1d-adb7-55cc-b124-2f588406660b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{5}-7}{4}" :db/id #edb/ref 17592186515367}] :answer-field/correct {:answer/id #uuid "eace7a1d-adb7-55cc-b124-2f588406660b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{5}-7}{4}" :db/id #edb/ref 17592186515367} :answer-field/id #uuid "d60c623e-cd54-521e-b4cc-4ee18ee381c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515497}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5aa76a5d-2fdf-5390-a4d4-41bc22f928df" :question/math-academy-id "q-293700" :question/problem "Rationalize the denominator of $\\frac{2-\\sqrt{5}}{\\sqrt{5}+1}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{5}-1.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{5}-1,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{2-\\sqrt{5}}{\\sqrt{5}+1} & = \\\\ \\frac{2-\\sqrt{5}}{\\sqrt{5}+1}\\cdot \\frac{\\sqrt{5}-1}{\\sqrt{5}-1} & = \\\\ \\frac{(2-\\sqrt{5})(\\sqrt{5}-1)}{(\\sqrt{5}+1)(\\sqrt{5}-1)} & = \\\\ \\frac{2\\sqrt{5}-2-(\\sqrt{5})^{2}+\\sqrt{5}}{(\\sqrt{5})^{2}-(1)^{2}} & = \\\\ \\frac{2\\sqrt{5}-2-5+\\sqrt{5}}{5-1} & = \\\\ \\frac{3\\sqrt{5}-7}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186515520 :knowledge-point/_questions [{:db/id #edb/ref 17592186054759 :knowledge-point/id #uuid "203f17e9-3efb-5637-ac02-2c31e5a8a632" :knowledge-point/title "Rationalizing Denominators Containing Surds in the Numerator and Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09a11886-ba0a-5688-ae42-6dba68e1d651" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\sqrt{2}-8" :db/id #edb/ref 17592186514893} {:answer/id #uuid "4077c927-c70e-5d55-98fb-81d0b8fabfa4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\sqrt{2}-9" :db/id #edb/ref 17592186515011} {:answer/id #uuid "b652bb4a-19f0-5d00-84a5-07c32285b424" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8\\sqrt{2}-9}{4}" :db/id #edb/ref 17592186515257} {:answer/id #uuid "dc504732-4c06-5c31-b7b3-ed11f4ba1707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{2}-9" :db/id #edb/ref 17592186515336} {:answer/id #uuid "e54e6c46-50cd-5170-a2b5-90a0063808a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8\\sqrt{2}-9}{2}" :db/id #edb/ref 17592186515352}] :answer-field/correct {:answer/id #uuid "dc504732-4c06-5c31-b7b3-ed11f4ba1707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{2}-9" :db/id #edb/ref 17592186515336} :answer-field/id #uuid "1239588e-50a4-52fa-9f56-2372f3d6c0ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515414}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "082850c1-2de3-5d40-b02c-e3313d031987" :question/math-academy-id "q-293703" :question/problem "Rationalize the denominator of $\\frac{7-\\sqrt{2}}{\\sqrt{2}+1}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{2}-1.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{2}-1,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{7-\\sqrt{2}}{\\sqrt{2}+1} & = \\\\ \\frac{7-\\sqrt{2}}{\\sqrt{2}+1}\\cdot \\frac{\\sqrt{2}-1}{\\sqrt{2}-1} & = \\\\ \\frac{(7-\\sqrt{2})(\\sqrt{2}-1)}{(\\sqrt{2}+1)(\\sqrt{2}-1)} & = \\\\ \\frac{7\\sqrt{2}-7-(\\sqrt{2})^{2}+\\sqrt{2}}{(\\sqrt{2})^{2}-(1)^{2}} & = \\\\ \\frac{7\\sqrt{2}-7-2+\\sqrt{2}}{2-1} & = \\\\ \\frac{8\\sqrt{2}-9}{1} & = \\\\ 8\\sqrt{2}-9\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186515536 :knowledge-point/_questions [{:db/id #edb/ref 17592186054759 :knowledge-point/id #uuid "203f17e9-3efb-5637-ac02-2c31e5a8a632" :knowledge-point/title "Rationalizing Denominators Containing Surds in the Numerator and Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b7a18ec-3843-5cbc-8a5d-b60819493f11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}+\\sqrt{10}}{3}" :db/id #edb/ref 17592186514896} {:answer/id #uuid "1d0d9767-2d96-5f24-9479-9a6e77c04025" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}+\\sqrt{10}}{4}" :db/id #edb/ref 17592186514936} {:answer/id #uuid "7459bda2-26bd-5869-a23