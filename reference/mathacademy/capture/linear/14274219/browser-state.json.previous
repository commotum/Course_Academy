></mtr><mtr><mtd></mtd><mtd><mo>=</mo><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mo accent=\"false\" stretchy=\"false\">→</mo><msup><mn>8</mn><mo>+</mo></msup></mrow></munder><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo stretchy=\"false\">(</mo><mi>x</mi><mo>−</mo><mn>8</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>4</mn><mo>+</mo><msqrt><mn>2</mn><mi>x</mi></msqrt><mo stretchy=\"false\">)</mo></mrow><mrow><mn>16</mn><mo>−</mo><mn>2</mn><mi>x</mi></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mo accent=\"false\" stretchy=\"false\">→</mo><msup><mn>8</mn><mo>+</mo></msup></mrow></munder><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo stretchy=\"false\">(</mo><mi>x</mi><mo>−</mo><mn>8</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>4</mn><mo>+</mo><msqrt><mn>2</mn><mi>x</mi></msqrt><mo stretchy=\"false\">)</mo></mrow><mrow><mo>−</mo><mn>2</mn><mo stretchy=\"false\">(</mo><mi>x</mi><mo>−</mo><mn>8</mn><mo stretchy=\"false\">)</mo></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mo accent=\"false\" stretchy=\"false\">→</mo><msup><mn>8</mn><mo>+</mo></msup></mrow></munder><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>4</mn><mo>+</mo><msqrt><mn>2</mn><mi>x</mi></msqrt></mrow><mrow><mo>−</mo><mn>2</mn></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>4</mn><mo>+</mo><msqrt><mn>2</mn><mo stretchy=\"false\">(</mo><mn>8</mn><mo stretchy=\"false\">)</mo></msqrt></mrow><mrow><mo>−</mo><mn>2</mn></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mo>−</mo><mn>4.</mn></m