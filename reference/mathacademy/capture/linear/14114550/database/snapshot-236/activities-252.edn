#{[{:activity/first-step {:db/id #edb/ref 17592186060563} :activity/id #uuid "5783ad54-a014-54a2-bf03-179b532b54dc" :activity/scope {:db/id #edb/ref 17592186050749 :topic/id #uuid "62da5cd1-bbc7-584a-ba89-8e03cd9c311f" :topic/math-academy-id 252} :activity/steps [{:db/id #edb/ref 17592186060563 :step/content {:db/id #edb/ref 17592186060991 :tutorial/content "A conditional statement $A \\Rightarrow B$ has three related logical forms:\n\n- the **converse:** $B \\Rightarrow A$\n- the **inverse:** $\\lnot A \\Rightarrow \\lnot B$\n- the **contrapositive:** $\\lnot B \\Rightarrow \\lnot A$\n\nFor example, consider the following true statement:\n\n$\\qquad$ If I am George Washington, then I am an American.\n\nHere, the antecedent is $A=$ \"I am George Washington,\" and the consequent is $B=$ \"I am an American.\"\n\n- The *converse* is \"If I am an American, then I am George Washington.\"\n- The *inverse* is \"If I am not George Washington, then I am not an American.\"\n- The *contrapositive* is \"If I am not an American, then I am not George Washington.\"\n\nAs we can see from the statements above, only the contrapositive is also true." :tutorial/id #uuid "f381549b-ee22-54fc-8819-f65677237a08" :tutorial/math-academy-id 7979 :tutorial/title "Introduction"} :step/id #uuid "359b59a3-ea7e-534e-bcef-10e9ba22f6e5" :step/math-academy-id 143402 :step/next {:db/id #edb/ref 17592186060564}} {:db/id #edb/ref 17592186060564 :step/content {:db/id #edb/ref 17592186059697 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059419 :question/id #uuid "9f3fe8eb-f539-539e-96c6-33b6a238fc82" :question/math-academy-id "e-12711"} :knowledge-point/id #uuid "ec5acb94-b33a-5921-b761-6f78db3f25f7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050366}] :knowledge-point/questions [{:db/id #edb/ref 17592186060117} {:db/id #edb/ref 17592186060428} {:db/id #edb/ref 17592186378319} {:db/id #edb/ref 17592186379294} {:db/id #edb/ref 17592186380213} {:db/id #edb/ref 17592186404210} {:db/id #edb/ref 17592186404217}] :knowledge-point/title "Finding the Converse of a Statement"} :step/id #uuid "e2eb4f41-af42-517b-80cc-4e15c689de2d" :step/math-academy-id 143403 :step/next {:db/id #edb/ref 17592186060565}} {:db/id #edb/ref 17592186060565 :step/content {:db/id #edb/ref 17592186059698 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059418 :question/id #uuid "144f352c-5696-5ad3-841f-3a6a1cf2e5f2" :question/math-academy-id "e-12710"} :knowledge-point/id #uuid "dffa4760-00cb-5395-8fab-dc7f9fe20597" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048355}] :knowledge-point/questions [{:db/id #edb/ref 17592186060116} {:db/id #edb/ref 17592186060419} {:db/id #edb/ref 17592186379280} {:db/id #edb/ref 17592186379287} {:db/id #edb/ref 17592186380206} {:db/id #edb/ref 17592186399530} {:db/id #edb/ref 17592186399551}] :knowledge-point/title "Finding the Inverse of a Statement"} :step/id #uuid "c85a942c-f9af-53b4-b1da-fa03e8854a2d" :step/math-academy-id 143406 :step/next {:db/id #edb/ref 17592186060566}} {:db/id #edb/ref 17592186060566 :step/content {:db/id #edb/ref 17592186059699 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059420 :question/id #uuid "9e1fa00b-8e51-5689-959d-049df21077bd" :question/math-academy-id "e-12712"} :knowledge-point/id #uuid "7f58ec96-53b3-5317-9801-c730728f32c6" :knowledge-point/questions [{:db/id #edb/ref 17592186060118} {:db/id #edb/ref 17592186060420} {:db/id #edb/ref 17592186378326} {:db/id #edb/ref 17592186379301} {:db/id #edb/ref 17592186379308} {:db/id #edb/ref 17592186386222}] :knowledge-point/title "Finding the Contrapositive of a Statement"} :step/id #uuid "a0cda17a-d96e-5ea8-bb9e-ccd79d7904dc" :step/math-academy-id 143409 :step/next {:db/id #edb/ref 17592186060567}} {:db/id #edb/ref 17592186060567 :step/content {:db/id #edb/ref 17592186060992 :tutorial/content "In general, we have the following facts:\n\n- The contrapositive is logically equivalent to the original statement: $$\\underbrace{A \\Rightarrow B}_{\\textrm{original}} \\equiv \\underbrace{\\neg B \\Rightarrow \\neg A}_{\\textrm{contrapositive}}$$\n- The inverse and the converse are logically equivalent to each other but not to the original statement: $$\\underbrace{\\neg A \\Rightarrow \\neg B}_{\\textrm{inverse}} \\equiv \\underbrace{B \\Rightarrow A}_{\\textrm{converse}}$$\n\nWe can prove these results using a truth table, as shown below:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\, A \\Rightarrow B \\,$ | $\\, \\neg A \\Rightarrow \\neg B \\,$ | $\\, B \\Rightarrow A \\,$ | $\\, \\neg B \\Rightarrow \\neg A \\,$ |\n| --- | --- | --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\color{blue} \\textrm T$ | $\\color{red} \\textrm T$ | $\\color{red} \\textrm T$ | $\\color{blue} \\textrm T$ |\n| $\\textrm T$ | $\\textrm F$ | $\\color{blue} \\textrm F$ | $\\color{red} \\textrm T$ | $\\color{red} \\textrm T$ | $\\color{blue} \\textrm F$ |\n| $\\textrm F$ | $\\textrm T$ | $\\color{blue} \\textrm T$ | $\\color{red} \\textrm F$ | $\\color{red} \\textrm F$ | $\\color{blue} \\textrm T$ |\n| $\\textrm F$ | $\\textrm F$ | $\\color{blue} \\textrm T$ | $\\color{red} \\textrm T$ | $\\color{red} \\textrm T$ | $\\color{blue} \\textrm T$ |\n\nThis can be visualized using the following diagram.\n\n![](images/d9/d946d2a81d46cbde934ebbab54f9b69b514092e02da4f8a3b79768f218929449.png)" :tutorial/id #uuid "5bbcfb96-5707-521a-bea1-559cf154472f" :tutorial/math-academy-id 7980 :tutorial/title "Logically Equivalent Conditional Statements"} :step/id #uuid "74a00ea0-ef35-56ab-86b6-44c08bc91491" :step/math-academy-id 143412 :step/next {:db/id #edb/ref 17592186060568}} {:db/id #edb/ref 17592186060568 :step/content {:db/id #edb/ref 17592186059700 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059421 :question/id #uuid "31e2f48c-65cc-53c3-b34c-70e2c53a9274" :question/math-academy-id "e-12713"} :knowledge-point/id #uuid "93d3501b-96ef-5fbd-9d93-788021156ddb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049811}] :knowledge-point/questions [{:db/id #edb/ref 17592186060119} {:db/id #edb/ref 17592186060421} {:db/id #edb/ref 17592186378333} {:db/id #edb/ref 17592186379315} {:db/id #edb/ref 17592186380220} {:db/id #edb/ref 17592186380227}] :knowledge-point/title "Identifying Logically Equivalent Statements"} :step/id #uuid "f375663a-5188-59fe-b4e2-7d315657f509" :step/math-academy-id 143413}] :activity/title "Converse, Inverse, and Contrapositive" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186059936}]}
