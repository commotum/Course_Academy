#{[{:activity/course {:db/id #edb/ref 17592186046679} :activity/first-step {:db/id #edb/ref 17592186407704} :activity/id #uuid "b3117d1c-d259-5ca7-8dcf-c2ea2b248c11" :activity/scope {:db/id #edb/ref 17592186050749 :topic/id #uuid "62da5cd1-bbc7-584a-ba89-8e03cd9c311f" :topic/math-academy-id 252} :activity/steps [{:db/id #edb/ref 17592186407704 :step/content {:db/id #edb/ref 17592186407700 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3eae7c6d-d67a-5016-94d4-ba2e2583ac41" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II and III only" :db/id #edb/ref 17592186407673} {:answer/id #uuid "4dadcbd4-89e1-5f7f-b35e-97b14996f8c1" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I only" :db/id #edb/ref 17592186407676} {:answer/id #uuid "5d4387d3-9988-5bde-be08-da7a99278325" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II only" :db/id #edb/ref 17592186407679} {:answer/id #uuid "74ea4131-ad8e-5771-b71c-87bc0c921675" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "III only" :db/id #edb/ref 17592186407680} {:answer/id #uuid "a2272929-b0b3-5b3c-95b1-8195ac004a98" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I and II only" :db/id #edb/ref 17592186407684}] :answer-field/correct {:db/id #edb/ref 17592186407680} :answer-field/id #uuid "99b94ba6-62ef-53e6-b475-846d742173b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407696}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "41c661ac-cdce-5cf9-814b-cfcfe49d2399" :question/math-academy-id "q-82665" :question/problem "$\\,$ **If** you are sick, **then** you are not going to school.\n\nWhich of the following statements are equivalent to the conditional statement above?\n\n- If you are not going to school, then you are sick.\n- If you are not sick, then you are going to school.\n- If you are going to school, then you are not sick." :question/worked-solution "Let's recall the following facts:\n\n- The contrapositive is logically equivalent to the original statement.\n\n- The inverse and the converse are logically equivalent to each other, but not to the original statement.\n\n![](images/0d/0deb19675402bf931111bb80cb616682aac08491b5cd3e1ab5812da05b6df8a8.png)\n\nSo, we are looking for the contrapositive.\n\n- Statement I is the converse, not the contrapositive. $\\,\\times $\n\n- Statement II is the inverse, not the contrapositive. $\\,\\times $\n\n- Statement III is the contrapositive. $\\,✓$\n\nTherefore, the correct answer is \"III only.\""} :step/id #uuid "19a46d5b-7cad-5c8f-bf15-b2f08d43ce6e" :step/next {:db/id #edb/ref 17592186407705}} {:db/id #edb/ref 17592186407705 :step/content {:db/id #edb/ref 17592186407702 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f50cc62-1ef8-5d26-94fe-19cc0496e946" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "If $6$ is not even, then $3$ divides $6.$" :db/id #edb/ref 17592186407671} {:answer/id #uuid "55a2ad61-ddd6-50db-8998-9ea2b6f81055" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "If $3$ doesn't divide $6,$ then $6$ is not even." :db/id #edb/ref 17592186407678} {:answer/id #uuid "96b53686-f3f0-55fa-86a0-e4e41c9ed2c3" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "If $3$ divides $6,$ then $6$ is not even." :db/id #edb/ref 17592186407681} {:answer/id #uuid "9ccbc68f-f80e-568d-9af1-dbe5b040a3d8" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "If $6$ is even, then $3$ divides $6.$" :db/id #edb/ref 17592186407682} {:answer/id #uuid "d67594ef-42cc-5ae7-bb86-e6ecd7ab3420" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "If $6$ is not even, then $3$ doesn't divide $6.$" :db/id #edb/ref 17592186407691}] :answer-field/correct {:db/id #edb/ref 17592186407678} :answer-field/id #uuid "6f850b69-588c-535b-85d5-0554bb105429" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407695}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "eca4be9a-a852-52a1-8e8c-2e200b9d2794" :question/math-academy-id "q-183274" :question/problem "Find the inverse of the following statement: \n\n$\\,$ **If** $3$ divides $6,$ **then** $6$ is even." :question/worked-solution "In our conditional statement:\n\n- The antecedent is $A:$ $3$ divides $6.$\n\n- The consequent is $B:$ $6$ is even.\n\nThe inverse of a conditional statement $A⇒B$ is given by \n\n$$\n¬A⇒¬B.\n$$\n\nFirst, we write down the negations of $A$ and $B:$\n\n- $¬A:$ $3$ doesn't divide $6.$\n\n- $¬B:$ $6$ is not even.\n\nTherefore, the inverse is the following: \n\n$\\,$ If $3$ doesn't divide $6,$ then $6$ is not even."} :step/id #uuid "9864b616-65d6-5ca3-a7e3-49b7953da8ad" :step/next {:db/id #edb/ref 17592186407708}} {:db/id #edb/ref 17592186407706 :step/content {:db/id #edb/ref 17592186407703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07403375-0a14-5e0c-9b83-f1f7a1d8d5eb" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "If $4>6,$ then ${0}⊄{1,2,3}.$" :db/id #edb/ref 17592186407669} {:answer/id #uuid "41036f0e-f48f-54b0-ad45-917785a0ae65" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "If ${0}⊄{1,2,3},$ then $4>6.$" :db/id #edb/ref 17592186407674} {:answer/id #uuid "4b732aa6-c0fa-544f-860e-c7f782bacec2" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "If $4\\le 6,$ then ${0}⊄{1,2,3}.$" :db/id #edb/ref 17592186407675} {:answer/id #uuid "a4fd80e3-a875-5579-b274-b169a9611ea3" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "If ${0}⊄{1,2,3},$ then $4\\le 6.$" :db/id #edb/ref 17592186407685} {:answer/id #uuid "cad940a3-7a30-5ff4-93a8-409b9be10a0f" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "If $4>6,$ then ${0}⊂{1,2,3}.$" :db/id #edb/ref 17592186407690}] :answer-field/correct {:db/id #edb/ref 17592186407675} :answer-field/id #uuid "e647ef76-2240-59c3-8c83-9a4ef59a40a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407697}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fa1fdfba-09c3-560d-b8ff-6308784b3029" :question/math-academy-id "q-183337" :question/problem "Find the contrapositive of the following statement: \n\n$\\,$ **If** ${0}⊂{1,2,3},$ **then** $4>6.$" :question/worked-solution "In our conditional statement:\n\n- The antecedent is $A:$ ${0}⊂{1,2,3}.$\n\n- The consequent is $B:$ $4>6.$\n\nThe contrapositive of a conditional statement $A⇒B$ is given by \n\n$$\n¬B⇒¬A.\n$$\n\nFirst, we write down the negations of $A$ and $B:$\n\n- $¬A:$ ${0}⊄{1,2,3}.$\n\n- $¬B:$ $4\\le 6.$\n\nTherefore, the contrapositive is the following: \n\n$\\,$ If $4\\le 6,$ then ${0}⊄{1,2,3}.$"} :step/id #uuid "b4ffe877-52e1-50d0-9ff6-0d5690dd67b5" :step/next {:db/id #edb/ref 17592186407707}} {:db/id #edb/ref 17592186407707 :step/content {:db/id #edb/ref 17592186407699 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f03e2de-9bca-59dd-a15f-41efb9506acf" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "None" :db/id #edb/ref 17592186407670} {:answer/id #uuid "2cea398d-083d-5498-8f17-f61d869d92b8" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II only" :db/id #edb/ref 17592186407672} {:answer/id #uuid "b4341088-2cf8-57e6-b2a2-ecbb99ffa35e" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I only" :db/id #edb/ref 17592186407687} {:answer/id #uuid "b6ae58e7-3641-5e2c-ab97-4e30b902c980" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I and II only" :db/id #edb/ref 17592186407688} {:answer/id #uuid "fd59c42e-69a0-5435-bc75-63d45cfde2aa" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "III only" :db/id #edb/ref 17592186407693}] :answer-field/correct {:db/id #edb/ref 17592186407693} :answer-field/id #uuid "f09bd681-f86e-50ed-9622-eb57559db7da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407698}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "23603376-708c-5de8-b4d0-019ec40ac31f" :question/math-academy-id "q-183340" :question/problem "$\\,$ **If** $-2\\in Z,$ **then** $5$ is prime.\n\nWhich of the following statements are equivalent to the conditional statement above?\n\n- If $-2\\notin Z,$ then $5$ is not prime.\n- If $5$ is prime, then $-2\\in Z.$\n- If $5$ is not prime, then $-2\\notin Z.$" :question/worked-solution "Let's recall the following facts:\n\n- The contrapositive is logically equivalent to the original statement.\n\n- The inverse and the converse are logically equivalent to each other, but not to the original statement.\n\n![](images/0d/0deb19675402bf931111bb80cb616682aac08491b5cd3e1ab5812da05b6df8a8.png)\n\nSo, we are looking for the contrapositive of the given statement.\n\n- Statement I is the inverse, not the contrapositive. $\\,\\times $\n\n- Statement II is the converse, not the contrapositive. $\\,\\times $\n\n- Statement III is the contrapositive. $\\,✓$\n\nTherefore, the correct answer is \"III only.\""} :step/id #uuid "c7672cfc-51b1-5edd-a593-97ceb2928169"} {:db/id #edb/ref 17592186407708 :step/content {:db/id #edb/ref 17592186407701 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "510c98ba-ef87-5fff-b4b1-e86de7cdfb0a" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "If it is summer, then you go to the beach." :db/id #edb/ref 17592186407677} {:answer/id #uuid "9e2b2fc1-d648-5d31-a1bf-eb01219a5fe4" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "If you don't go to the beach, then it is not summer" :db/id #edb/ref 17592186407683} {:answer/id #uuid "aa3283a3-cded-5b86-bf40-e38e5cd197ab" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "If it is not summer, then you go to the beach." :db/id #edb/ref 17592186407686} {:answer/id #uuid "c584f385-4eba-5ef1-a423-eac23cbae655" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "If you go to the beach, then it is summer" :db/id #edb/ref 17592186407689} {:answer/id #uuid "fb8ad54f-4913-5b36-8cdb-740da26e279e" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "If it is summer, then you don't go to the beach." :db/id #edb/ref 17592186407692}] :answer-field/correct {:db/id #edb/ref 17592186407677} :answer-field/id #uuid "286c752f-2970-5ff4-abd2-b57ef3623964" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407694}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a480d9fc-6f80-5af5-b6f1-0b67fa2323fc" :question/math-academy-id "q-183281" :question/problem "Find the inverse of the following statement: \n\n$\\,$ **If** it is not summer, **then** you don't go to the beach." :question/worked-solution "In our conditional statement:\n\n- The antecedent is $A:$ It is not summer.\n\n- The consequent is $B:$ You don't go to the beach.\n\nThe inverse of a conditional statement $A⇒B$ is given by \n\n$$\n¬A⇒¬B.\n$$\n\nFirst, we write down the negations of $A$ and $B:$\n\n- $¬A:$ It is summer.\n\n- $¬B:$ You go to the beach.\n\nTherefore, the inverse is the following: \n\n$\\,$ If it is summer, then you go to the beach."} :step/id #uuid "f22856db-f661-53df-a19e-2bc1cf583961" :step/next {:db/id #edb/ref 17592186407706}}] :activity/title "Converse, Inverse, and Contrapositive" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186407668}]}
