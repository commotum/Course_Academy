,0\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, &  & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\,\\end{aligned}\n$$\n\nSo, we have \n\n$$\n50+50=100.\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n-50-50=-100.\n$$"}] [{:db/id #edb/ref 17592186443306 :knowledge-point/_questions [{:db/id #edb/ref 17592186179642 :knowledge-point/id #uuid "bf53d532-092b-5a8f-ad89-31d98d1a87e9" :knowledge-point/title "Subtracting a Positive Number From a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "265e20b9-254f-5ca4-b250-6c604a7bfb5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186443271} {:answer/id #uuid "39814ff9-0a8c-5b15-ab7e-fc69e6f64c9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186443274} {:answer/id #uuid "ef72f075-7eac-55eb-a24d-2e7454d725d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186443290} {:answer/id #uuid "f8778662-cb9d-56e5-a9cd-67078cdd7520" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186443292} {:answer/id #uuid "fdc089e5-a34f-55b9-b60f-1cc0fb9577eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186443294}] :answer-field/correct {:answer/id #uuid "265e20b9-254f-5ca4-b250-6c604a7bfb5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186443271} :answer-field/id #uuid "f681c3f3-6a3c-58d4-9049-43fc8caae6f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 