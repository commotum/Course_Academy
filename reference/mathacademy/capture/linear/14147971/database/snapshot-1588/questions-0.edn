\\, &  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\,\\end{aligned}\n$$\n\nSo, we have \n\n$$\n30+215=245.\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n-30-215=-245.\n$$"}] [{:db/id #edb/ref 17592186443310 :knowledge-point/_questions [{:db/id #edb/ref 17592186179642 :knowledge-point/id #uuid "bf53d532-092b-5a8f-ad89-31d98d1a87e9" :knowledge-point/title "Subtracting a Positive Number From a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ca1a19f-2e90-52d8-8e2e-74cd79967468" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186443272} {:answer/id #uuid "3b712146-398a-52c7-94f1-db0bc0b758e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186443275} {:answer/id #uuid "a75060e9-fc21-5dde-acc2-412dee857de9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186443281} {:answer/id #uuid "b025b69f-daa0-5578-b85c-061d0621d264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186443283} {:answer/id #uuid "d9d8867d-2ee5-5125-99c1-c542bdb44115" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186443287}] :answer-field/correct {:answer/id #uuid "a75060e9-fc21-5dde-acc2-412dee857de9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186443281} :answer-field/id #uuid "6c4cf2fa-cc97-55c6-9310-effb379c5fdc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 1759218