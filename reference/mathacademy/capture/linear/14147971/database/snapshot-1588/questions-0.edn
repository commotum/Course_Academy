492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186443302}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ae461202-cffe-5f3e-9a80-3b16cb6085db" :question/math-academy-id "q-235650" :question/problem "$-75-15=${{field-1}}" :question/worked-solution "The answer will be negative since $-75$ is negative, and we're subtracting $15$ from it.\n\nWe start by solving an easier problem:\n\n$$\n75+15\n$$\n\nNext, we carry out the addition:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\,\\text{ }1\\,\\,\\,\\, &  \\\\  &  & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\,\\end{aligned}\n$$\n\nSo, we have \n\n$$\n75+15=90.\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n-75-15=-90.\n$$"}] [{:db/id #edb/ref 17592186443309 :knowledge-point/_questions [{:db/id #edb/ref 17592186179643 :knowledge-point/id #uuid "e0bedede-4182-5356-a663-74c459c7f571" :knowledge-point/title "Subtracting a Positive Number From a Negative Number With Larger Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bfbfc7d2-93f7-529c-b728-a16988c05d3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-321" :db/id #edb/ref 17592186443285}] :answer-field/correct {:answer/id #uuid "bfbfc7d2-93f7-529c-b728-a16988c05d3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-321" :db/id #edb/ref 17592186443285} :answer-field/id #uuid "86a6b753-c475-57bd-8171-3e3847ffdc5d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186443301}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4d1b13ee-c2f7-5d7d-b7d0-387ee0a0e47c" :question/math-academy-id "q-235765" :question/problem "$-18-303=${{field-1}}" :question/worked-solution "The answer will be negative since $-18$ is negative, and we're subtracting $303$ from it.\n\nWe start by solving an easier problem:\n\n$$\n18+303\n$$\n\nNext, we carry out the addition:\n\n$$\n\\begin{aligned} &  &  & \\,\\,\\,\\,\\text{ }1\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, &  & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\,\\end{aligned}\n$$\n\nSo, we have \n\n$$\n18+303=321.\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n-18-303=-321.\n$$"}] [{:db/id #edb/ref 17592186443314 :knowledge-point/_questions [{:db/id #edb/ref 17592186179643 :knowledge-point/id #uuid "e0bedede-4182-5356-a663-74c459c7f571" :knowledge-point/title "Subtracting a Positive Number From a Negative Number With Larger Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df160c1a-bb36-5116-98e1-b396393bba4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-554" :db/id #edb/ref 17592186443289}] :answer-field/correct {:answer/id #uuid "df160c1a-bb36-5116-98e1-b396393bba4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-554" :db/id #edb/ref 17592186443289} :answer-field/id #uuid "5b6c445a-2d2b-5c07-9254-68e2530c6900" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186443299}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b5172c27-b2c7-5978-b0fc-61a2e9bf3c63" :question/math-academy-id "q-235768" :question/problem "$-52-502=${{field-1}}" :question/worked-solution "The answer will be negative since $-52$ is negative, and we're subtracting $502$ from it.\n\nWe start by solving an easier problem:\n\n$$\n52+502\n$$\n\nNext, we carry out the addition:\n\n$$\n\\begin{aligned} &  &  & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, &  & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\,\\end{aligned}\n$$\n\nSo, we have \n\n$$\n52+502=554.\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n-52-502=-554.\n$$"}]}
