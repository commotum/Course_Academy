#{[{:activity/first-step {:db/id #edb/ref 17592186180337} :activity/id #uuid "0390c610-5ff3-5821-8133-d58cd1d8d8ab" :activity/scope {:db/id #edb/ref 17592186048549 :topic/id #uuid "a8fa6619-18ed-5c67-bc9f-76a149827775" :topic/math-academy-id 3720} :activity/steps [{:db/id #edb/ref 17592186180337 :step/content {:db/id #edb/ref 17592186180770 :tutorial/content "When we subtract a positive number from a negative number, we move towards the left on the number line.\n\nFor example, let's consider the following subtraction problem:\n\n$$\n-1 - 6\n$$\n\nTo subtract $6$ from $-1$, we start at $-1$ on the number line and move $6$ places to the left.\n\n![](images/27/27f1ec50826854059d1794b7f449704e084688437f7fecd64ff23de65a081343.png)\n\nWhen we do this, we land at $-7$. Therefore,\n\n$$\n-1-6 = -7\n$$" :tutorial/id #uuid "b57137f2-5ba3-52f0-8753-20db9c53029e" :tutorial/math-academy-id 8027 :tutorial/title "Introduction"} :step/id #uuid "f2d1a353-35b0-53c9-98c6-f6d937a348c2" :step/math-academy-id 184897 :step/next {:db/id #edb/ref 17592186180338}} {:db/id #edb/ref 17592186180338 :step/content {:db/id #edb/ref 17592186179642 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179448 :question/id #uuid "cdef4ec4-2985-5f50-ac8d-4ebf89fe51e4" :question/math-academy-id "e-12811"} :knowledge-point/id #uuid "bf53d532-092b-5a8f-ad89-31d98d1a87e9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049429}] :knowledge-point/questions [{:db/id #edb/ref 17592186179905} {:db/id #edb/ref 17592186180111}] :knowledge-point/title "Subtracting a Positive Number From a Negative Number"} :step/id #uuid "d1ef028d-efb7-5b03-9301-8e39badd9e51" :step/math-academy-id 184898 :step/next {:db/id #edb/ref 17592186180339}} {:db/id #edb/ref 17592186180339 :step/content {:db/id #edb/ref 17592186180771 :tutorial/content "It is impractical to use number lines to subtract large numbers.\n\nHowever, a neat trick makes subtracting a positive number from a negative number very easy!\n\nAs an example, let's consider the following subtraction problem:\n\n$$\n-37 - 52\n$$\n\nThe answer will be *negative* since $-37$ is negative, and we're subtracting $52$ from it.\n\nWe start by solving an easier problem: adding their absolute values. In other words, we need to figure out\n$37+52$.\n\nCarrying out the addition gives the following:\n\n$$\n3\\begin{vmatrix}7 \\\\ +\\end{vmatrix}5\\begin{vmatrix}2 \\\\ 8\\end{vmatrix}9\n$$\n\nSo, we have\n\n$$\n37+52 = 89\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above.\n\nTherefore, we conclude that\n\n$$\n-37 - 52 = -89\n$$\n\nAnd that's it!\n\nLet's use this technique to solve a problem with three-digit numbers." :tutorial/id #uuid "cc72f3ff-5b98-5f5a-8a84-0de67abf8baa" :tutorial/math-academy-id 8028 :tutorial/title "Larger Numbers"} :step/id #uuid "27207554-e812-5c18-93a7-04354e0106de" :step/math-academy-id 184902 :step/next {:db/id #edb/ref 17592186180340}} {:db/id #edb/ref 17592186180340 :step/content {:db/id #edb/ref 17592186179643 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179449 :question/id #uuid "e5a01c97-e61b-589a-babd-6be4c211e487" :question/math-academy-id "e-12812"} :knowledge-point/id #uuid "e0bedede-4182-5356-a663-74c459c7f571" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049688}] :knowledge-point/questions [{:db/id #edb/ref 17592186180110} {:db/id #edb/ref 17592186180241}] :knowledge-point/title "Subtracting a Positive Number From a Negative Number With Larger Numbers"} :step/id #uuid "bc6f1773-9f08-5eaa-9416-61ea5af7aa92" :step/math-academy-id 184903}] :activity/title "Subtracting a Positive Number From a Negative Number" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179871}]}
