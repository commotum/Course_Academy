#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186515630} :activity/id #uuid "fbfe7b63-dd84-5bb9-ae0b-151a90820b22" :activity/scope {:db/id #edb/ref 17592186048508 :topic/id #uuid "a587db09-9578-5d61-b811-99a95c85061d" :topic/math-academy-id 553} :activity/steps [{:db/id #edb/ref 17592186515630 :step/content {:db/id #edb/ref 17592186074373 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cf06951-cbcc-525c-9842-0890581834c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186072477} {:answer/id #uuid "b04ecb02-3d9b-5237-9855-274124892856" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186072478} {:answer/id #uuid "d7352e89-2b19-5a8c-a0e2-f926cfe67ea2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186072479} {:answer/id #uuid "1cf88531-0b03-5971-a795-d3362dd0c20c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186072480} {:answer/id #uuid "41370d63-4b05-5808-abe3-4ce7f528b248" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186072481}] :answer-field/correct {:db/id #edb/ref 17592186072479} :answer-field/id #uuid "4ad60804-e649-58c3-9918-6d89f3cb7178" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186072476}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cd08e83a-7cd3-5ff7-9cbf-8fd4782df22a" :question/math-academy-id "q-59740" :question/problem "![](images/38/3865ec425991f0d8ceae82f002d0096f2fd2ea56743173e754b15472b7c85031.png)\n\nWhat number is missing from the boxes in the statement below?\n\nThe ratio of triangles to hexagons is $1:\\boxed{}\\,$ because there is $1$ triangle for every $\\boxed{}$ hexagon." :question/worked-solution "First, we count the number of triangles. We see that there are $3$ triangles.\n\nThen, we count the number of hexagons. We see that there are $3$ hexagons.\n\nSo the ratio of triangles to hexagons is $3:3.$\n\nWe can simplify this ratio by dividing both numbers by $3$:\n\n$$\n\\begin{aligned}\\,\\,3 &  & : & \\,\\,\\,\\, & \\,\\,\\,3 &  \\\\ \\,\\,↓÷\\,\\,3 &  &  &  & \\,\\,\\,↓÷\\,\\,3 &  \\\\ \\,\\,1 &  & : &  & \\,\\,\\,1 & \\end{aligned}\n$$\n\nThis means that $1:1$ is equivalent to $3:3.$ \n\nSo, the complete statement is\n\"The ratio of triangles to hexagons is $1:1$ because there is $1$ triangle for every $1$ hexagon.\""} :step/id #uuid "11c74a03-1f27-5d00-94fb-dfb867dd0243" :step/next {:db/id #edb/ref 17592186515703}} {:db/id #edb/ref 17592186515670 :step/content {:db/id #edb/ref 17592186515529 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e450b03-7981-5093-828a-cb8e22ab078c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186514940} {:answer/id #uuid "1eea5d3b-05dc-5f21-af4a-69cd688d94b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186514942} {:answer/id #uuid "39f0e787-bfeb-525d-962e-fbc0be1dea03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186514999} {:answer/id #uuid "a036cbb4-0c7b-5101-b61a-3587c08488d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186515214} {:answer/id #uuid "f2cded69-fda8-50a1-9450-6993ad54936e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186515382}] :answer-field/correct {:db/id #edb/ref 17592186514999} :answer-field/id #uuid "c4ada293-0707-5fcb-af41-5176ed9ea4fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186515489}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2295df98-ce45-53e5-ab4e-ebfbd4881c7a" :question/math-academy-id "q-131918" :question/problem "If there are $21$ pears and $15$ apples, then what number is missing from the boxes in the statement below?\n\nThe ratio of pears to apples is $7:\\boxed{}\\,$ because there are $7$ pears for every $\\boxed{}\\,$ apples." :question/worked-solution "Since there are $21$ pears and $15$ apples, the ratio of pears to apples is $21:15.$\n\nWe can simplify this ratio by dividing both numbers by $3:$\n\n$$\n\\begin{aligned}\\,21 &  & : & \\,\\,\\,\\, & \\,\\,15 &  \\\\ \\,\\,\\,↓÷\\,\\,3 &  &  &  & \\,\\,\\,\\,↓÷\\,\\,3 &  \\\\ \\,\\,\\,7 &  & : &  & \\,\\,\\,\\,5 & \\end{aligned}\n$$\n\nThat means that $21:15$ is equivalent to $7:5.$ \n\nSo, the complete statement is \"The ratio of pears to apples is $7:5\\,$ because there are $7$ pears for every $5\\,$ apples.\"\n\nTherefore, the missing number is $5.$"} :step/id #uuid "9791145a-39f3-503d-85e5-4249e43b05a5"} {:db/id #edb/ref 17592186515703 :step/content {:db/id #edb/ref 17592186515610 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1034259d-6a50-53d2-8b2a-548dd4a01b24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186514905} {:answer/id #uuid "58839e93-46a7-5cba-a7a8-b5b186148928" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186515069} {:answer/id #uuid "9818025a-7109-5370-82e1-53582885ae81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186515193} {:answer/id #uuid "a24fea6b-a341-5cf3-808c-27c825cb1528" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186515218} {:answer/id #uuid "f8464049-28bd-5b10-888e-adf0b228fb7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186515394}] :answer-field/correct {:db/id #edb/ref 17592186515218} :answer-field/id #uuid "25ccbefd-df3d-54b1-82ef-3bcd139c5460" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186515423}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e345f1f6-4e4b-57f5-a961-226088f10a38" :question/math-academy-id "q-92799" :question/problem "Dominick has $8$ steel marbles and $14$ glass marbles. What number is missing from the boxes in the statement below?\n\nThe ratio of steel marbles to glass marbles is $4:\\boxed{}\\,$ because there are $4$ steel marbles for every $\\boxed{}\\,$ glass marbles." :question/worked-solution "Since there are $8$ steel marbles and $14$ glass marbles, the ratio of steel marbles to glass marbles is $8:14.$\n\nWe can simplify this ratio by dividing both numbers by $2:$\n\n$$\n\\begin{aligned}\\,8 &  & : & \\,\\,\\,\\, & \\,\\,14 &  \\\\ \\,\\,\\,↓÷\\,\\,2 &  &  &  & \\,\\,\\,\\,↓÷\\,\\,2 &  \\\\ \\,\\,\\,4 &  & : &  & \\,\\,\\,\\,7 & \\end{aligned}\n$$\n\nThat means that $4:7$ is equivalent to $8:14.$ \n\nSo, the complete statement is\n\"The ratio of steel marbles to glass marbles is $4:7$ because there are $4$ steel marbles for every $7$ glass marbles.\"\n\nHence, the missing number is $7.$"} :step/id #uuid "e2d088e6-4253-54d2-b40f-9e61dc190ae1" :step/next {:db/id #edb/ref 17592186515670}}] :activity/title "Equivalent Ratios" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186514870}]}
