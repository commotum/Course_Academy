#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186060460} :activity/id #uuid "3a267dc0-721f-5a1c-ad3a-5fa7fec62f8e" :activity/scope {:db/id #edb/ref 17592186048121 :topic/id #uuid "809502b3-ee2f-5a96-8373-13e255b37eac" :topic/math-academy-id 263} :activity/steps [{:db/id #edb/ref 17592186060460 :step/content {:db/id #edb/ref 17592186060872 :tutorial/content "In isosceles right triangles such as the one shown below, the angles always measure $45^\\circ,$ $45^\\circ,$ and $90^\\circ.$ \n\nConsequently, isosceles right triangles are often called **$\\boldsymbol{45^\\circ}$-$\\boldsymbol{45^\\circ}$-$\\boldsymbol{90^\\circ}$ triangles**.\n\n![](images/d3/d32159528abc75f3ed8bcccaedb2765b676fd6cc64164e2f8c81f98eb37f6db4.png)\n\nAll $45^\\circ$-$45^\\circ$-$90^\\circ$ triangles share a special property:\n\n*In any ${45^\\circ}$-${45^\\circ}$-${90^\\circ}$ triangle, the length of the hypotenuse is $\\sqrt{2}$ times the length of a leg.*\n\nTo see why this is, remember that\n\n- in an isosceles triangle, the two legs must have the same length, and\n\n- in a right triangle, the square of the longest side must equal the sum of the squares of the two shorter sides.\n\nSo, if an isosceles right triangle has legs of length $a$ and the hypotenuse has length $h,$ then we have\n\n$$\n\\begin{aligned}{h}^{2} & ={a}^{2}+{a}^{2} \\\\ {h}^{2} & =2{a}^{2} \\\\ h & =\\sqrt{2{a}^{2}} \\\\ h & =\\sqrt{2}\\cdot a.\\end{aligned}\n$$" :tutorial/id #uuid "7e5fefd4-4ac4-5999-8c6d-0ad927da9ca6" :tutorial/math-academy-id 2381 :tutorial/title "Introduction"} :step/id #uuid "8b5ee65a-7747-5a0e-9d06-721118b74e10" :step/math-academy-id 10416 :step/next {:db/id #edb/ref 17592186060461}} {:db/id #edb/ref 17592186060461 :step/content {:db/id #edb/ref 17592186059630 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059462 :question/id #uuid "d1277863-7d33-566d-91b9-7a78458dca8e" :question/math-academy-id "e-3077"} :knowledge-point/id #uuid "73ad4cd2-e7f0-5b7d-82fc-1a8e4b0597d8" :knowledge-point/questions [{:db/id #edb/ref 17592186060289} {:db/id #edb/ref 17592186060290} {:db/id #edb/ref 17592186497361} {:db/id #edb/ref 17592186497375}] :knowledge-point/title "Calculating the Length of the Hypotenuse of a 45-45-90 Triangle Given the Legs"} :step/id #uuid "0b3e5ddd-300e-5258-b19c-3499c565bdad" :step/math-academy-id 10419 :step/next {:db/id #edb/ref 17592186060462}} {:db/id #edb/ref 17592186060462 :step/content {:db/id #edb/ref 17592186059631 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059463 :question/id #uuid "ce112319-10a9-5483-82c3-566c0630b23a" :question/math-academy-id "e-3080"} :knowledge-point/id #uuid "d5faa905-dcfc-5eed-b4ed-5818ca6ef342" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048702}] :knowledge-point/questions [{:db/id #edb/ref 17592186060096} {:db/id #edb/ref 17592186060282} {:db/id #edb/ref 17592186497351} {:db/id #edb/ref 17592186497385}] :knowledge-point/title "Calculating the Length of the Legs of a 45-45-90 Triangle Given the Hypotenuse"} :step/id #uuid "7049be2a-b0af-5170-a1cb-c440a35c6663" :step/math-academy-id 10420 :step/next {:db/id #edb/ref 17592186060473}} {:db/id #edb/ref 17592186060468 :step/content {:db/id #edb/ref 17592186060873 :tutorial/content "Now that we know about $45^\\circ$-$45^\\circ$-$90^\\circ$ triangles, it's straightforward to see that the diagonal of any square is $\\sqrt{2}$ times the side length of the square.\n\nTo illustrate, consider the square below, where $a$ is the measure of a side and $c$ is the measure of a diagonal.\n\n![](images/07/0743e533eefd4c7e51eaca51c9285fc1b6277553d4f214602a65fc50d1d69ace.png)\n\nSince the sides of a square are congruent, $\\triangle{ABC}$ is an isosceles right triangle (a $45^{\\circ}$-$45^{\\circ}$-$90^{\\circ}$ triangle). \n\nSo, for the diagonal, we have\n\n$$\n\\begin{aligned}c=\\sqrt{2}\\cdot a.\\end{aligned}\n$$" :tutorial/id #uuid "e5c49477-841f-56f9-8779-f1a2a1f115cf" :tutorial/math-academy-id 2382 :tutorial/title "Applications to Squares"} :step/id #uuid "f44a11e0-a932-51d6-97d6-b216a7d42d5f" :step/math-academy-id 10423 :step/next {:db/id #edb/ref 17592186060469}} {:db/id #edb/ref 17592186060469 :step/content {:db/id #edb/ref 17592186059636 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059464 :question/id #uuid "0d244991-c12e-5c56-8f58-762d8be22f8a" :question/math-academy-id "e-3082"} :knowledge-point/id #uuid "6ae8076e-25bc-5489-ae14-ffa16d17a32c" :knowledge-point/questions [{:db/id #edb/ref 17592186060200} {:db/id #edb/ref 17592186060279} {:db/id #edb/ref 17592186497395} {:db/id #edb/ref 17592186497406}] :knowledge-point/title "Determining the Length of the Diagonal or Side of a Square Given its Perimeter"} :step/id #uuid "247c54c1-1228-55a9-8289-046846fffeeb" :step/math-academy-id 10424} {:db/id #edb/ref 17592186060473 :step/content {:db/id #edb/ref 17592186059638 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059466 :question/id #uuid "e4466ef9-61d2-5b02-960b-c5c421a9dc1a" :question/math-academy-id "e-3085"} :knowledge-point/id #uuid "16fd63e8-664f-53c2-b623-c696b86b5642" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048921}] :knowledge-point/questions [{:db/id #edb/ref 17592186060221} {:db/id #edb/ref 17592186060418} {:db/id #edb/ref 17592186497389} {:db/id #edb/ref 17592186497415}] :knowledge-point/title "Calculating the Length of a Hypotenuse or Leg of a 45-45-90 Triangle Given its Perimeter"} :step/id #uuid "718ecaa7-a103-5a7c-a12a-2815eaf19f82" :step/math-academy-id 10430 :step/next {:db/id #edb/ref 17592186060468}}] :activity/title "Isosceles Right Triangles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186059938}]}
