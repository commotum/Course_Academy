ht: 0px; padding-top: 0.3em;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c39\"></mjx-c></mjx-mn><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"text-align: left; padding-left: 0px; padding-top: 0.3em;\"><mjx-mi class=\"mjx-n\"></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"4\"><mjx-c class=\"mjx-c1D44E TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.6em 0.6em 0.6em 0.6em 0.6em 0.3em\"><mtr><mtd><mi>p</mi></mtd><mtd><mi></mi><mo>=</mo><mi>A</mi><mi>B</mi><mo>+</mo><mi>B</mi><mi>C</mi><mo>+</mo><mi>A</mi><mi>C</mi></mtd></mtr><mtr><mtd><mn>18</mn><mo>+</mo><mn>9</mn><msqrt><mn>2</mn></msqrt></mtd><mtd><mi></mi><mo>=</mo><mi>a</mi><mo>+</mo><mi>a</mi><mo>+</mo><mi>a</mi><msqrt><mn>2</mn></msqrt></mtd></mtr><mtr><mtd><mn>9</mn><mo stretchy=\"false\">(</mo><mn>2</mn><mo>+</mo><msqrt><mn>2</mn></msqrt><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><mi>a</mi><mo>+</mo><mi>a</mi><msqrt><mn>2</mn></msqrt></mtd></mtr><mtr><mtd><mn>9</mn><mo stretchy=\"false\">(</mo><mn>2</mn><mo>+</mo><msqrt><mn>2</mn></msqrt><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><mn>2</mn><mo>+</mo><msqrt><mn>2</mn></msqrt><mo stretchy=\"false\">)</mo><mi>a</mi></mtd></mtr><mtr><mtd><mn>9</mn><menclose notation=\"updiagonalstrike\"><mo stretchy=\"false\">(</mo><mn>2</mn><mo>+</mo><msqrt><mn>2</mn></msqrt><mo stretchy=\"false\">)</mo></menclose></mtd><mtd><mi></mi><mo>=</mo><menclose notation=\"updiagonalstrike\"><mo stretchy=\"false\">(</mo><mn>2</mn><mo>+</mo><msqrt><mn>2</mn></msqrt><mo stretchy=\"false\">)</mo></menclose><mi>a</mi></mtd></mtr><mtr><mtd><mn>9</mn></mtd><mtd><mi></mi><mo>=</mo><mi>a</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Therefore, the measure of a leg is <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"87\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c39\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>9.</mn></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
