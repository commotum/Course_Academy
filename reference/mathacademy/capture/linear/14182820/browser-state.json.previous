ue\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.8em 0.8em 0.3em\"><mtr><mtd><mi>F</mi><mi>H</mi></mtd><mtd><mi></mi><mo>=</mo><msqrt><mn>2</mn></msqrt><mo>⋅</mo><mi>H</mi><mi>G</mi></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>48</mn><msqrt><mn>2</mn></msqrt></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><msqrt><mn>2</mn></msqrt><mo>⋅</mo><mi>H</mi><mi>G</mi></mtd></mtr><mtr><mtd><mi>H</mi><mi>G</mi></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>48</mn><mrow><msqrt><mn>2</mn></msqrt><mo>⋅</mo><msqrt><mn>2</mn></msqrt></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd><mi>H</mi><mi>G</mi></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>48</mn><mn>2</mn></mfrac></mstyle></mtd></mtr><mtr><mtd><mi>H</mi><mi>G</mi></mtd><mtd><mi></mi><mo>=</mo><mn>24</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi data-mjx-auto-op=\"false\">mm</mi></mrow></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Finally, the perimeter <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"124\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45D TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>p</mi></math></mjx-assistive-mml></mjx-container> is given by</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"125\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45D TEX-I\"></mj