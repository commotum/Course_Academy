h=\"0.167em\"></mspace></mstyle></mtd><mtd><mi></mi><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mo>&lt;</mo></mstyle></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mn>7</mn></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo>−</mo><mn>2</mn><mi>z</mi></mrow><mrow><mo>−</mo><mn>2</mn></mrow></mfrac></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle></mtd><mtd><mi></mi><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"red\"><mo>&gt;</mo></mstyle></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>7</mn><mrow><mo>−</mo><mn>2</mn></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo>−</mo><mn>2</mn><mi>z</mi></mrow><mrow><mo>−</mo><mn>2</mn></mrow></mfrac></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle></mtd><mtd><mi></mi><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"red\"><mo>&gt;</mo></mstyle></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>7</mn><mn>2</mn></mfrac></mstyle></mrow></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Now, we can cancel a common factor of <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"71\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mo class=\"mjx-n\"><