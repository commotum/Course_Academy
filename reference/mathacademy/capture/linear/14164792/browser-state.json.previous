      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14164792/observations/step-q154011-f69a92b175b8cab8c7dc.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14164792/observations/step-q154011-f69a92b175b8cab8c7dc.png",
      "source_url": "https://mathacademy.com/tasks/14164792/topics/38/lesson",
      "captured_at": 1791890984.4898753,
      "math_academy_id": "q-154011",
      "topic_id": "38",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q154011",
