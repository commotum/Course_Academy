exatom><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.3em\"><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo>−</mo><mn>5</mn><mi>x</mi></mrow><mrow><mo>−</mo><mn>5</mn></mrow></mfrac></mstyle></mtd><mtd><mi></mi><mo>&gt;</mo><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>2</mn></mrow></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><menclose notation=\"updiagonalstrike\"><mo>−</mo><mn>5</mn></menclose><mi>x</mi></mrow><menclose notation=\"updiagonalstrike\"><mo>−</mo><mn>5</mn></menclose></mfrac></mstyle></mtd><mtd><mi></mi><mo>&gt;</mo><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>2</mn></mrow></mtd></mtr><mtr><mtd><mi>x</mi></mtd><mtd><mi></mi><mo>&gt;</mo><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>2</mn></mrow></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Therefore, the solution is <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"87\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3E\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>&gt;</mo><mo>−</mo><mn>2.</mn></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
