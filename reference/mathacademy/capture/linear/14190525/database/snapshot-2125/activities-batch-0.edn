#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186069776} :activity/id #uuid "3fcb435e-dc90-5888-b34e-40125c4a37f1" :activity/scope {:db/id #edb/ref 17592186050887 :topic/id #uuid "6e563fb5-2e53-5b68-a90b-a963f8d0dc96" :topic/math-academy-id 390} :activity/steps [{:db/id #edb/ref 17592186069776 :step/content {:db/id #edb/ref 17592186069998 :tutorial/content "To simplify radical expressions, we can use the quotient rule for radicals, which states \n\n$$\n\\dfrac {\\sqrt {a}} {\\sqrt{b}} = \\sqrt{\\dfrac a b}.\n$$\n\nFor example, let's simplify $\\sqrt{\\dfrac{16w^2}{25}}$\n\nFirst, we put the numerator and denominator under separate radicals and then simplify the result:\n\n$$\n\\sqrt{\\dfrac{16w^2}{25}}  = \\dfrac {\\sqrt{16w^2}} {\\color{blue}\\sqrt{25}} = \\dfrac{\\sqrt{16w^2}}{\\color{blue}\\sqrt{5^2}} = \\dfrac{\\sqrt{16w^2}}{\\color{blue}5}\n$$\n\nNow, notice that the expression inside the radical is a perfect square. So, we can continue simplifying by writing the expression under the radical as a perfect square and taking its square root:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{16{w}^{2}}}{5} & = \\\\ \\frac{\\sqrt{(4w)^{2}}}{5} & = \\\\ \\frac{|4w|}{5} & = \\\\ \\frac{|4|\\cdot |w|}{5} & = \\\\ \\frac{4\\cdot |w|}{5} & = \\\\ \\frac{4|w|}{5}\\end{aligned}\n$$" :tutorial/id #uuid "7bfc07d9-feb0-5bcc-b3f0-50bb42eb2b6d" :tutorial/math-academy-id 6691 :tutorial/title "Introduction"} :step/id #uuid "2bc45b7b-b768-5e67-92eb-6d8dfdb26080" :step/math-academy-id 40513 :step/next {:db/id #edb/ref 17592186069777}} {:db/id #edb/ref 17592186069777 :step/content {:db/id #edb/ref 17592186068836 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068442 :question/id #uuid "dd7c79e5-d274-5f04-af44-335b5a6d95df" :question/math-academy-id "e-10699"} :knowledge-point/id #uuid "bc723e84-3051-5e73-ac57-08da7193c368" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050315} {:db/id #edb/ref 17592186050496}] :knowledge-point/questions [{:db/id #edb/ref 17592186069096} {:db/id #edb/ref 17592186069423} {:db/id #edb/ref 17592186503656} {:db/id #edb/ref 17592186503672}] :knowledge-point/title "Simplifying Radical Expressions With Perfect Squares Under the Radical"} :step/id #uuid "92bbfce1-1705-5e28-a0bf-e544d5fecdf9" :step/math-academy-id 40520 :step/next {:db/id #edb/ref 17592186069780}} {:db/id #edb/ref 17592186069778 :step/content {:db/id #edb/ref 17592186069999 :tutorial/content "The quotient rule for radicals also works for higher-order roots, like the cube root:\n\n$$\n\\sqrt[3]{ \\dfrac a b } = \\dfrac{ \\sqrt[3]{a} }{ \\sqrt[3]{b} }\n$$\n\nIn general, we have the following result:\n\n$$\n\\sqrt[n]{ \\dfrac a b } = \\dfrac{ \\sqrt[n]{a} }{ \\sqrt[n]{b} }\n$$" :tutorial/id #uuid "a1d735da-05d5-5959-9226-229b7c29c497" :tutorial/math-academy-id 6692 :tutorial/title "The Quotient Rule for Cube Roots and Other Radicals"} :step/id #uuid "57fbfe53-6167-5a8c-ac3b-d190aa02b687" :step/math-academy-id 40523} {:db/id #edb/ref 17592186069779 :step/content {:db/id #edb/ref 17592186068837 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068443 :question/id #uuid "40af3166-710b-508c-9a8e-2c54365cd238" :question/math-academy-id "e-10712"} :knowledge-point/id #uuid "f03bcc0e-23e1-534b-81bb-146079d37c3e" :knowledge-point/questions [{:db/id #edb/ref 17592186069229} {:db/id #edb/ref 17592186069419} {:db/id #edb/ref 17592186503721}] :knowledge-point/title "Simplifying a Radical Expression With Domain Restrictions"} :step/id #uuid "25606295-3ea3-509a-91f7-294ef43bb1c1" :step/math-academy-id 40568 :step/next {:db/id #edb/ref 17592186069778}} {:db/id #edb/ref 17592186069780 :step/content {:db/id #edb/ref 17592186068838 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068444 :question/id #uuid "9ceac090-9a1c-57d7-a311-f771ece6e0b6" :question/math-academy-id "e-10716"} :knowledge-point/id #uuid "eeca0971-59ed-576d-a248-293decd655b1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048132}] :knowledge-point/questions [{:db/id #edb/ref 17592186069071} {:db/id #edb/ref 17592186069072} {:db/id #edb/ref 17592186503650} {:db/id #edb/ref 17592186503686}] :knowledge-point/title "Simplifying Radical Expressions With Perfect Fourths Under the Radical"} :step/id #uuid "d917615e-b6ee-5929-8832-7bcfe670df91" :step/math-academy-id 40586 :step/next {:db/id #edb/ref 17592186069779}}] :activity/title "Simplifying Square Root Expressions Using the Quotient Rule" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068937}]}
