k\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable rowspacing=\"0.8em 0.8em 0.8em 0.5em\" columnspacing=\"0.278em\" displaystyle=\"true\" columnalign=\"right left\"><mtr><mtd><mo stretchy=\"false\">(</mo><mn>2</mn><mi>x</mi><mo>+</mo><msup><mn>3</mn><mo>∘</mo></msup><mo stretchy=\"false\">)</mo><mo>+</mo><mo stretchy=\"false\">(</mo><mn>4</mn><mi>x</mi><mo stretchy=\"false\">)</mo><mo>+</mo><mo stretchy=\"false\">(</mo><mi>x</mi><mo>+</mo><msup><mn>2</mn><mo>∘</mo></msup><mo stretchy=\"false\">)</mo></mtd><mtd><mo>=</mo><msup><mn>180</mn><mo>∘</mo></msup></mtd></mtr><mtr><mtd><mn>7</mn><mi>x</mi><mo>+</mo><msup><mn>5</mn><mo>∘</mo></msup></mtd><mtd><mo>=</mo><msup><mn>180</mn><mo>∘</mo></msup></mtd></mtr><mtr><mtd><mn>7</mn><mi>x</mi></mtd><mtd><mo>=</mo><msup><mn>175</mn><mo>∘</mo></msup></mtd></mtr><mtr><mtd><mi>x</mi></mtd><mtd><mo>=</mo><msup><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>25</mn></mpadded></mstyle><mo>∘</mo></msup><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
