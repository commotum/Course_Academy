ption of a Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "facbbcf5-fd8b-5c1a-b9bd-ec0bb250a625" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186488036}] :answer-field/correct {:answer/id #uuid "facbbcf5-fd8b-5c1a-b9bd-ec0bb250a625" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186488036} :answer-field/id #uuid "b018b8b0-8050-5346-9228-9d30a066ed6e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186488130}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "08ae86f4-7baa-5fd1-bf6d-dfc10d8069d6" :question/math-academy-id "q-171876" :question/problem "Consider a triangle $△RST,$ where $m∠R=2x+{3}^{∘},$ $m∠S=4x$ and $m∠T=x+{2}^{∘}.$ Find the value of $x.$\n\n$x=$\n{{field-1}}${}^{∘}$" :question/worked-solution "The sum of the measures of the interior angles must be ${180}^{∘}.$ Therefore,\n\n$$\n\\begin{aligned}(2x+{3}^{∘})+(4x)+(x+{2}^{∘}) & ={180}^{∘} \\\\ 7x+{5}^{∘} & ={180}^{∘} \\\\ 7x & ={175}^{∘} \\\\ x & ={25}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186488272 :knowledge-point/_questions [{:db/id #edb/ref 17592186073741 :knowledge-point/id #uuid "fdb1e0fe-da89-5d80-b9a0-82d4daddc396" :knowledge-point/title "Finding a Missing Angle in a Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87d8a051-5f02-51fd-9928-bdea3b9de44d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "75" :db/id #edb/ref 17592186487826}] :answer-field/correct {:answer/id #uuid "87d8a051-5f02-51fd-9928-bdea3b9de44d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "75" :db/id #edb/ref 17592186487826} :answer-field/id #uuid "c00b6c87-f0b2-52e4-893d-66fe637fc6c1" :answer