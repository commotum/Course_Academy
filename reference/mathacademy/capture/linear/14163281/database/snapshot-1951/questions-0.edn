#{[{:db/id #edb/ref 17592186073507 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073741 :knowledge-point/id #uuid "fdb1e0fe-da89-5d80-b9a0-82d4daddc396" :knowledge-point/title "Finding a Missing Angle in a Triangle"}] :question/id #uuid "ed0361cf-cec0-5ec2-baab-e0f558619191" :question/math-academy-id "e-14725" :question/problem "![](images/1a/1afba9a36c6fd04fecfd50877181380776e13a83422697de4a39d71381f09aff.png)\n\nFind the value of $x$ in the triangle above." :question/worked-solution "Since the sum of the measures of the interior angles in any triangle is equal to $180^\\circ$, we have\n\n$$\n\\begin{aligned}\nm∠A + m∠B + m∠C &= 180^{∘} \\\\\n36^{∘} + 112^{∘} + x &= 180^{∘} \\\\\n148^{∘} + x &= 180^{∘} \\\\\nx &= 32^{∘}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186073508 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073742 :knowledge-point/id #uuid "3eb85b52-cd40-5469-b2f5-ceee2f0bf0cb" :knowledge-point/title "Calculating an Unknown Quantity From a Triangle"}] :question/id #uuid "bf72c879-105c-5416-8dbd-7976228f0b4b" :question/math-academy-id "e-14727" :question/problem "![](images/e4/e43daa39b169c8ba29c21dd33e7a7fab1e92c7c78eafbd1021971e1883f6c9f8.png)\n\nFind the measure of $\\angle C$." :question/worked-solution "Since the sum of the measures of the interior angles of a triangle is $180^\\circ$, we have\n\n$$\n\\begin{aligned}\n3z + 4z + 40^{∘} &= 180^{∘} \\\\\n7z + 40^{∘} &= 180^{∘} \\\\\n7z &= 140^{∘} \\\\\nz &= 20^{∘}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nm∠C &= 4z \\\\\n&= 4(20^{∘}) \\\\\n&= 80^{∘}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186073509 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073743 :knowledge-point/id #uuid "6a4f969d-aebf-53b5-ad47-1376bb98dc6a" :knowledge-point/title "Calculating an Unknown Quantity Given a Description of a Triangle"}] :question/id #uuid "8200fc85-afcc-5fb9-b942-cedbc87c739b" :question/math-academy-id "e-14728" :question/problem "Consider a triangle $\\triangle ABC$, where $m\\angle{A} = 55^\\circ$, $m\\angle B = x + 10^\\circ$, and $m\\angle C = 3x - 5^\\circ$. Find the value of $x$." :question/worked-solution "The sum of the measures of the interior angles must be $180^\\circ$. Therefore,\n\n$$\n\\begin{aligned}\n55^{∘} + (x + 10^{∘}) + (3x - 5^{∘}) &= 180^{∘} \\\\\n60^{∘} + 4x &= 180^{∘} \\\\\n4x &= 120^{∘} \\\\\nx &= 30^{∘}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186073510 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073744 :knowledge-point/id #uuid "8b1f86d8-805c-55c7-8e8c-d96d99e3636b" :knowledge-point/title "Finding Angles in Triangles With Congruent Angles"}] :question/id #uuid "b015f8d6-ac1b-537d-a673-839fc7418f71" :question/math-academy-id "e-15572" :question/problem "![](images/1a/1a24187f280eb99640c3d1bfae3b7fe873383f04c2c492e7873a40de16a9560b.png)\n\nFind the measure of angle $C$ given that $m\\angle{A} = m\\angle{B}$." :question/worked-solution "Using\n\n$$\nm\\angle{A} = m\\angle{B}\n$$\n\nwe get\n\n$$\n\\begin{aligned}\nm∠A &= m∠B \\\\\n3x - 27^{∘} &= 2x \\\\\nx &= 27^{∘}\n\\end{aligned}\n$$\n\nConsequently, substituting $x=27^\\circ$ in the expression for $m\\angle B$, we get\n\n$$\nm\\angle{B}=2(27^\\circ)=54^\\circ\n$$\n\nNow, we can find $m\\angle C$ using the fact that the internal angles of any triangle sum to $180^\\circ$:\n\n$$\n\\begin{aligned}\nm∠A + m∠B + m∠C &= 180^{∘} \\\\\n2m∠B + m∠C &= 180^{∘} \\\\\n2 \\cdot 54^{∘} + m∠C &= 180^{∘} \\\\\n108^{∘} + m∠C &= 180^{∘} \\\\\nm∠C &= 72^{∘}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186074173 :knowledge-point/_questions [{:db/id #edb/ref 17592186073741 :knowledge-point/id #uuid "fdb1e0fe-da89-5d80-b9a0-82d4daddc396" :knowledge-point/title "Finding a Missing Angle in a Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9268c8c6-7552-55f4-be86-6e1e59c3e62b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "33^{∘}" :db/id #edb/ref 17592186071277} {:answer/id #uuid "a1f35c23-f7f5-51c0-8019-7b3098ba8ac0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "34^{∘}" :db/id #edb/ref 17592186071278} {:answer/id #uuid "b64a613a-0e7d-56da-9bb4-82318ed4de6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32^{∘}" :db/id #edb/ref 17592186071279} {:answer/id #uuid "d87fd8a9-909f-50db-bb23-655299660d9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "29^{∘}" :db/id #edb/ref 17592186071280} {:answer/id #uuid "071decc7-c4d2-5be8-8973-c39af8a5736b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30^{∘}" :db/id #edb/ref 17592186071281}] :answer-field/id #uuid "62b01f1f-915d-551f-87fc-c511ebf0a88a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186071276}] :question/id #uuid "1769a383-2122-517d-a6f5-ae3c81a6f9f3" :question/math-academy-id "q-4181" :question/problem "![](images/72/7210d4af96bf9c4c6c347b9dd91712b14aa9cd8cc21ed5f8535e0546db03068e.png)\n\nDetermine the value of $x$."}]}
