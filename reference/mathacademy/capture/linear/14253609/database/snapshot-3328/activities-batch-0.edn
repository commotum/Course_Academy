#{[{:activity/first-step {:db/id #edb/ref 17592186176609} :activity/id #uuid "a69d7410-d0a6-5806-8fc7-1ac33cf4c963" :activity/scope {:db/id #edb/ref 17592186049513 :topic/id #uuid "faf1f300-4d99-5875-b639-29be09100069" :topic/math-academy-id 3568} :activity/steps [{:db/id #edb/ref 17592186176609 :step/content {:db/id #edb/ref 17592186176969 :tutorial/content "For quadrantal angles that lie outside $[0^\\circ,360^\\circ)$, we first find a coterminal angle in the interval $[0^\\circ,360^\\circ)$, and then we proceed as usual.\n\nFor example, if the angle is $540^\\circ$, then we write\n\n$$\n540^\\circ - 360^\\circ = 180^\\circ.\\quad{\\color{green}{\\checkmark}}\n$$\n\nSo $180^\\circ$ is coterminal with $540^\\circ$, and we need to look at the point on the unit circle that corresponds to $180^\\circ$, which is $(-1,0)$.\n\n![](images/79/792a778286533d589a3410223aaf197b07e64ea77566042d7bb8ac13fbad9768.png)\n\nWe can do a similar thing when working with negative angles. For example, if the angle is\n\n$$\n-\\dfrac{7\\pi}{2}\n$$\n\nwe can write\n\n$$\n\\begin{aligned}\n-\\frac{7π}{2} + 2π &= -\\frac{3π}{2} \\\\\n- \\frac{3π}{2} + 2π &= \\frac{π}{2}.✓\n\\end{aligned}\n$$\n\nSo, we need to look at the point that corresponds to\n\n$$\n\\dfrac{\\pi}2\n$$\n\nthat is, $(0,1)$." :tutorial/id #uuid "5a5b94dd-c0f5-5c2e-a0f1-419a6ebcdf6c" :tutorial/math-academy-id 2724 :tutorial/title "Introduction"} :step/id #uuid "ec1c77c4-a638-50ab-8dfb-91536e58750b" :step/math-academy-id 13374 :step/next {:db/id #edb/ref 17592186176611}} {:db/id #edb/ref 17592186176610 :step/content {:db/id #edb/ref 17592186175904 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175771 :question/id #uuid "9c5acd23-2011-56f9-b1a9-749c7590c53c" :question/math-academy-id "e-3866"} :knowledge-point/id #uuid "37414146-16e2-5190-9fa5-0a7ecafdff22" :knowledge-point/questions [{:db/id #edb/ref 17592186176402} {:db/id #edb/ref 17592186176431}] :knowledge-point/title "Computing the Trigonometric Ratio of a Negative Quadrantal Angle"} :step/id #uuid "0a839e63-f096-52db-ac19-cec0ae653752" :step/math-academy-id 13376} {:db/id #edb/ref 17592186176611 :step/content {:db/id #edb/ref 17592186175905 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175772 :question/id #uuid "3192749c-2bdd-5fb8-a5ca-a5b8238fca84" :question/math-academy-id "e-3867"} :knowledge-point/id #uuid "74bd8bfc-a69a-5d02-a22e-4f8c2d062111" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049532} {:db/id #edb/ref 17592186051050}] :knowledge-point/questions [{:db/id #edb/ref 17592186176405} {:db/id #edb/ref 17592186176430}] :knowledge-point/title "Computing a Trigonometric Ratio of a Quadrantal Angle Greater Than One Full Rotation"} :step/id #uuid "4deed9ba-dcca-5bbb-bc78-72b51823a4ae" :step/math-academy-id 13378 :step/next {:db/id #edb/ref 17592186176610}}] :activity/title "Trigonometric Ratios of Quadrantal Angles Outside the Standard Range" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186176118}]}
