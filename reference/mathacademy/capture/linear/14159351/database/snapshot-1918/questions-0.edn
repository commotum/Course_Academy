#{[{:db/id #edb/ref 17592186059385 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059826 :knowledge-point/id #uuid "74f45f69-d8e7-5e79-a1ec-38d8912cbc19" :knowledge-point/title "Converting Between Intervals and Inequalities: Open Intervals"}] :question/id #uuid "9096883e-6dd0-5dd1-8e9c-176775edadba" :question/math-academy-id "e-10785" :question/problem "Which inequality corresponds to the interval $x \\in (1, 5)?$" :question/worked-solution "Every interval can be expressed as an inequality. We use the following notations:\n\n- Parentheses ${\\color{red}{(}}\\phantom{0} \\phantom{0}{\\color{red}{)}}$ to indicate that the endpoints are *not* included.\n\n- Brackets ${\\color{blue}{[}}\\phantom{0} \\phantom{0}{\\color{blue}{]}}$ to indicate that the endpoints *are* included.\n\nOur interval contains only parentheses. So, the endpoints are *not* included. \n\n$$\nx\\in {\\color{red}{(}}1, 5{\\color{red}{)}}\n$$\n\nTherefore, our interval can be expressed as the following inequality:\n\n$$\n1 \\,\\,{\\color{red}{<      }}\\,\\,      x  \\,\\,{\\color{red}{<      }}\\,\\,      5\n$$"}] [{:db/id #edb/ref 17592186059386 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059827 :knowledge-point/id #uuid "bdf77469-6c2a-5339-b216-3bc5e2316e4d" :knowledge-point/title "Translating Between Half-Open Intervals and Inequalities"}] :question/id #uuid "b828f144-b8b8-5eda-94f1-43cccdcb1aaa" :question/math-academy-id "e-10786" :question/problem "Write the interval $y\\in\\big(-4, \\sqrt{2}\\big]$ as an inequality." :question/worked-solution "Every interval can be expressed as an inequality. We use the following notations:\n\n- Parentheses ${\\color{red}{(}}\\phantom{0} \\phantom{0}{\\color{red}{)}}$ to indicate that the endpoints are *not* included.\n\n- Brackets ${\\color{blue}{[}}\\phantom{0}\\phantom{0}{\\color{blue}{]}}$ to indicate that the endpoints *are* included.\n\nFor the given interval \n\n$$\n{\\color{red}{{\\big(}}} -4, \\sqrt2\\, {\\color{blue}{\\big]}}\n$$\n\nwe note the following:\n\n- The left endpoint $-4$ is *not* included in the interval. Therefore, we use ${\\color{red}{\\lt}}\\,.$\n\n- The right endpoint $\\sqrt2$ *is* included in the interval. Therefore, we use ${\\color{blue}{\\leq      }}\\,.$\n\nTherefore, the inequality that corresponds to the given interval is \n\n$$\n-4 \\,\\,{\\color{red}{\\lt  }}\\,\\,   y \\,\\,{\\color{blue}{\\leq}}\\,\\, \\sqrt 2.\n$$"}] [{:db/id #edb/ref 17592186059387 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059828 :knowledge-point/id #uuid "c8c3e092-d9ff-5dc9-ad1e-f31aa2b226ba" :knowledge-point/title "Translating Between Half-Open Intervals and Number Lines"}] :question/id #uuid "45d05c7d-e278-552f-a524-926d4a57d870" :question/math-academy-id "e-10787" :question/problem "What interval corresponds to the segment shown below?\n\n![](images/43/430481f9d0863b0bb5602f949e6f994d8007ea29fdd741a485d880df8d5d2dec.png)" :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses ${\\color{red}{(}}\\phantom{0} \\phantom{0}{\\color{red}{)}}$ if the endpoints are *not* included.\n\n- Brackets ${\\color{blue}{[}}\\phantom{0} \\phantom{0}{\\color{blue}{]}}$ if the endpoints *are* included.\n\nThe given interval can be represented by the following inequality:\n\n$$\n-2\\,\\, {\\color{blue}{\\leq}}  \\,\\, x \\,\\, {\\color{red}{\\lt}} \\,\\, 2\n$$\n\nWe can express our inequality in interval notation as follows:\n\n$$\nx\\in {\\color{blue}{[}}-2,2{\\color{red}{)}}\n$$"}] [{:db/id #edb/ref 17592186059388 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059829 :knowledge-point/id #uuid "2f519fa9-de89-5b00-aa02-312cf8e32cba" :knowledge-point/title "Converting Between Intervals and Inequalities: Closed Intervals"}] :question/id #uuid "6d4bd0a2-0961-54c1-b781-b470d420d848" :question/math-academy-id "e-10816" :question/problem "Express the inequality $1 \\le x \\le4$ in interval notation." :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses ${\\color{red}{(}}\\phantom{0} \\phantom{0}{\\color{red}{)}}$ if the endpoints are *not* included.\n\n- Brackets ${\\color{blue}{[}}\\phantom{0} \\phantom{0}{\\color{blue}{]}}$ if the endpoints *are* included.\n\nOur inequality contains only \"or equal to\" symbols. So, the endpoints $1$ and $4$ *are* included. \n\n$$\n1\\,\\, {\\color{blue}{\\le}} \\,\\, x \\,\\, {\\color{blue}{\\le}} \\,\\, 4\n$$\n\nTherefore, we can express our inequality in interval notation as follows:\n\n$$\n{\\color{blue}{[}}1,4{\\color{blue}{]}}\n$$\n\nMore formally, we can also write\n\n$$\nx\\in [1,4].\n$$"}] [{:db/id #edb/ref 17592186059958 :knowledge-point/_questions [{:db/id #edb/ref 17592186059829 :knowledge-point/id #uuid "2f519fa9-de89-5b00-aa02-312cf8e32cba" :knowledge-point/title "Converting Between Intervals and Inequalities: Closed Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b3d8a45-fe13-581e-9e3f-055e9482e906" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-10,3)" :db/id #edb/ref 17592186482865} {:answer/id #uuid "2eee8041-f4fa-545a-a3f7-4d63c35b6ba8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-10,3)" :db/id #edb/ref 17592186482892} {:answer/id #uuid "3dacba62-f7cd-5fb4-b7ac-b6a55cdc2a73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-10,3]" :db/id #edb/ref 17592186482917} {:answer/id #uuid "982b05bc-9e84-5fbb-95ab-465cc3b39a18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,3]" :db/id #edb/ref 17592186483074} {:answer/id #uuid "b9d2aab1-6872-5e77-8697-9067584fdf64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-10,3]" :db/id #edb/ref 17592186483125}] :answer-field/correct {:answer/id #uuid "b9d2aab1-6872-5e77-8697-9067584fdf64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-10,3]" :db/id #edb/ref 17592186483125} :answer-field/id #uuid "bbff7b41-8a1b-509f-91ec-dd43bc73c6e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056107}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5bdfaded-c508-56ef-8657-15a990f7ff66" :question/math-academy-id "q-102200" :question/problem "The inequality $-10\\le x\\le 3$ can be expressed in interval notation as" :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses $()$ if the endpoints are *not* included.\n\n- Brackets $[]$ if the endpoints *are* included.\n\nOur inequality contains only \"or equal to\" symbols. So, the endpoints $-10$ and $3$ *are* included. \n\n$$\n-10\\,\\,\\le \\,\\,x\\,\\,\\le \\,\\,3\n$$\n\nTherefore, we can express our inequality in interval notation as follows:\n\n$$\n[-10,3]\n$$\n\nMore formally, we can also write\n\n$$\nx\\in [-10,3].\n$$"}] [{:db/id #edb/ref 17592186483356 :knowledge-point/_questions [{:db/id #edb/ref 17592186059826 :knowledge-point/id #uuid "74f45f69-d8e7-5e79-a1ec-38d8912cbc19" :knowledge-point/title "Converting Between Intervals and Inequalities: Open Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53fe5584-384d-5b44-83a0-f1565841f276" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-3,-1]" :db/id #edb/ref 17592186482959} {:answer/id #uuid "631edece-fedb-545f-b23e-c597b59cd67d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-1)" :db/id #edb/ref 17592186482988} {:answer/id #uuid "7ddeac29-1350-586f-8402-4f2cd5a011bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,3)" :db/id #edb/ref 17592186483035} {:answer/id #uuid "bfc2ca2b-8fa1-563e-a4a9-2513bd36fe61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-3,-1)" :db/id #edb/ref 17592186483134} {:answer/id #uuid "ed26bb47-211c-5dd4-826f-0c63b9010f1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-1]" :db/id #edb/ref 17592186483211}] :answer-field/correct {:answer/id #uuid "631edece-fedb-545f-b23e-c597b59cd67d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-1)" :db/id #edb/ref 17592186482988} :answer-field/id #uuid "94593ba1-9997-5f67-b991-f19edf5d49e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483299}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2f96fab2-a0f2-58ca-be0a-3d7653559b4b" :question/math-academy-id "q-1256" :question/problem "The inequality $-3<x<-1$ can be expressed in interval notation as" :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses $()$ if the endpoints are *not* included.\n\n- Brackets $[]$ if the endpoints *are* included.\n\nOur inequality contains only \"less than\" symbols. So, the endpoints $-3$ and $-1$ are *not* included. \n\n$$\n-3\\,\\,<\\,\\,x\\,\\,<\\,\\,-1\n$$\n\nTherefore, we can express our inequality in interval notation as follows:\n\n$$\n(-3,-1)\n$$\n\nMore formally, we can also write\n\n$$\nx\\in (-3,-1).\n$$"}] [{:db/id #edb/ref 17592186483411 :knowledge-point/_questions [{:db/id #edb/ref 17592186059826 :knowledge-point/id #uuid "74f45f69-d8e7-5e79-a1ec-38d8912cbc19" :knowledge-point/title "Converting Between Intervals and Inequalities: Open Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ee599d9-032e-5cfa-8854-fa874620cf26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\sqrt{2},\\sqrt{2}]" :db/id #edb/ref 17592186482871} {:answer/id #uuid "466db8a9-5692-5840-8350-8a1339f4dc4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,\\sqrt{2})" :db/id #edb/ref 17592186482937} {:answer/id #uuid "631e7e91-f606-52be-bde6-7906debd7ca2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-\\sqrt{2},\\sqrt{2}]" :db/id #edb/ref 17592186482987} {:answer/id #uuid "7c3612a6-8098-5473-9fd3-e8a509fdfc5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\sqrt{2},\\sqrt{2})" :db/id #edb/ref 17592186483030} {:answer/id #uuid "ea146e9c-cd0f-5d3f-a757-f080a85565c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-\\sqrt{2},\\sqrt{2})" :db/id #edb/ref 17592186483205}] :answer-field/correct {:answer/id #uuid "7c3612a6-8098-5473-9fd3-e8a509fdfc5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\sqrt{2},\\sqrt{2})" :db/id #edb/ref 17592186483030} :answer-field/id #uuid "657476d4-a8fb-55ad-87cf-4c749b0e1c83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483274}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c556bd18-7997-5c17-980e-bee5855d1c3c" :question/math-academy-id "q-154704" :question/problem "The inequality $-\\sqrt{2}<x<\\sqrt{2}$ can be expressed in interval notation as" :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses $()$ if the endpoints are *not* included.\n\n- Brackets $[]$ if the endpoints *are* included.\n\nOur inequality contains only \"less than\" symbols. So, the endpoints $-\\sqrt{2}$ and $\\sqrt{2}$ are *not* included. \n\n$$\n-\\sqrt{2}\\,\\,<\\,\\,x\\,\\,<\\,\\,\\sqrt{2}\n$$\n\nTherefore, we can express our inequality in interval notation as follows:\n\n$$\n(-\\sqrt{2},\\sqrt{2})\n$$\n\nMore formally, we can also write\n\n$$\nx\\in (-\\sqrt{2},\\sqrt{2}).\n$$"}] [{:db/id #edb/ref 17592186483384 :knowledge-point/_questions [{:db/id #edb/ref 17592186059829 :knowledge-point/id #uuid "2f519fa9-de89-5b00-aa02-312cf8e32cba" :knowledge-point/title "Converting Between Intervals and Inequalities: Closed Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75a68108-a8cc-5fb7-90d8-d305c41c4fae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7<x\\le 0" :db/id #edb/ref 17592186483015} {:answer/id #uuid "943f78de-1311-5dd7-ac1a-856ec0cb4c99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7\\le x\\le 0" :db/id #edb/ref 17592186483070} {:answer/id #uuid "a18f6b94-6b53-545a-a37a-bd11450bb699" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7\\le x<0" :db/id #edb/ref 17592186483083} {:answer/id #uuid "a3a2c334-25f5-5b4f-b754-81cc023155a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7<x<0" :db/id #edb/ref 17592186483089} {:answer/id #uuid "aefb8691-5a94-57f6-a7c9-d4669ca141d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x\\le -7$ or $x\\ge 0$" :db/id #edb/ref 17592186483108}] :answer-field/correct {:answer/id #uuid "943f78de-1311-5dd7-ac1a-856ec0cb4c99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7\\le x\\le 0" :db/id #edb/ref 17592186483070} :answer-field/id #uuid "8a0884c4-5df6-5fd3-b8ad-b0ee63b9d7ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483294}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8752fefa-3c8b-5341-99df-0d350ae12f59" :question/math-academy-id "q-154728" :question/problem "Which inequality corresponds to the interval $x\\in [-7,0]?$" :question/worked-solution "Every interval can be expressed as an inequality. We use the following notations:\n\n- Parentheses $(,)$ to indicate that the endpoints are *not* included.\n\n- Brackets $[]$ to indicate that the endpoints *are* included.\n\nOur interval contains only brackets. So, the endpoints *are* included. \n\n$$\nx\\in [-7,0]\n$$\n\nTherefore, our interval can be expressed as the following inequality:\n\n$$\n-7\\,\\,\\le \\,\\,x\\,\\,\\le \\,\\,0\n$$"}] [{:db/id #edb/ref 17592186483404 :knowledge-point/_questions [{:db/id #edb/ref 17592186059828 :knowledge-point/id #uuid "c8c3e092-d9ff-5dc9-ad1e-f31aa2b226ba" :knowledge-point/title "Translating Between Half-Open Intervals and Number Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04d2bb6c-1af1-5e65-9ea5-53d69510ab43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,2)" :db/id #edb/ref 17592186482816} {:answer/id #uuid "338136d4-03d3-5b9a-9c7f-00a504b6f047" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-3,2]" :db/id #edb/ref 17592186482902} {:answer/id #uuid "4622d0d7-a8c1-5f2c-9352-7f3037f736e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-3,2)" :db/id #edb/ref 17592186482936} {:answer/id #uuid "533c57fc-8f74-5b0d-adae-a85840204f66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-3,2)" :db/id #edb/ref 17592186482957} {:answer/id #uuid "55fccfdd-8453-5e6e-a352-f594e50395a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-3,2]" :db/id #edb/ref 17592186482962}] :answer-field/correct {:answer/id 