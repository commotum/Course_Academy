swer/value "x\\in [-5,-2]" :db/id #edb/ref 17592186482889} {:answer/id #uuid "4b6c9f84-1d4a-5826-bc2e-d1338c645d51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-5,-2]" :db/id #edb/ref 17592186482945} {:answer/id #uuid "78f8e2a1-909f-520f-b506-e3974280f4b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-5,-2)" :db/id #edb/ref 17592186483023}] :answer-field/correct {:answer/id #uuid "78f8e2a1-909f-520f-b506-e3974280f4b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-5,-2)" :db/id #edb/ref 17592186483023} :answer-field/id #uuid "8e0bb284-b5cb-58ef-a60f-c6b90ddcc36a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483296}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "864c6e65-68a8-5041-8665-c620b19d5bdd" :question/math-academy-id "q-28834" :question/problem "The inequality $-5\\le x<-2$ can be expressed in interval notation as" :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses $()$ if the endpoints are *not* included.\n\n- Brackets $[]$ if the endpoints *are* included.\n\nFor the given inequality \n\n$$\n-5\\,\\,\\le \\,\\,x\\,\\,<\\,\\,-2\n$$\n\nwe note the following:\n\n- The left endpoint $-5$ *is* included in the interval. Therefore, we use $[\\,.$\n\n- The right endpoint $-2$ is *not* included in the interval. Therefore, we use $)\\,.$\n\nTherefore, the corresponding interval is\n\n$$\nx\\in [-5,-2).\n$$"}] [{:db/id #edb/ref 17592186483422 :knowledge-point/_questions [{:db/id #edb/ref 17592186059828 :knowledge-point/id #uuid "c8c3e092-d9ff-5dc9-ad1e-f31aa2b226ba" :knowledge-point/title "Translating Between Half-Open Intervals and Number Lines"}] :question/answer-fields [{:answer-field/