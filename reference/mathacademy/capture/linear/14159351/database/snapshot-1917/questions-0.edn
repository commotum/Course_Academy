#{[{:db/id #edb/ref 17592186059385 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059826 :knowledge-point/id #uuid "74f45f69-d8e7-5e79-a1ec-38d8912cbc19" :knowledge-point/title "Converting Between Intervals and Inequalities: Open Intervals"}] :question/id #uuid "9096883e-6dd0-5dd1-8e9c-176775edadba" :question/math-academy-id "e-10785" :question/problem "Which inequality corresponds to the interval $x \\in (1, 5)$?" :question/worked-solution "Every interval can be expressed as an inequality. We use the following notations:\n\n- Parentheses ${\\color{red}{(}}\\phantom{0} \\phantom{0}{\\color{red}{)}}$ to indicate that the endpoints are *not* included.\n- Brackets ${\\color{blue}{[}}\\phantom{0} \\phantom{0}{\\color{blue}{]}}$ to indicate that the endpoints *are* included.\n\nOur interval contains only parentheses. So, the endpoints are *not* included.\n\n$$\nx\\in {\\color{red}{(}}1, 5{\\color{red}{)}}\n$$\n\nTherefore, our interval can be expressed as the following inequality:\n\n$$\n1 \\,\\,{\\color{red}{<}}\\,\\, x \\,\\,{\\color{red}{<}}\\,\\, 5\n$$"}] [{:db/id #edb/ref 17592186059386 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059827 :knowledge-point/id #uuid "bdf77469-6c2a-5339-b216-3bc5e2316e4d" :knowledge-point/title "Translating Between Half-Open Intervals and Inequalities"}] :question/id #uuid "b828f144-b8b8-5eda-94f1-43cccdcb1aaa" :question/math-academy-id "e-10786" :question/problem "Write the interval $y\\in\\big(-4, \\sqrt{2}\\big]$ as an inequality." :question/worked-solution "Every interval can be expressed as an inequality. We use the following notations:\n\n- Parentheses ${\\color{red}{(}}\\phantom{0} \\phantom{0}{\\color{red}{)}}$ to indicate that the endpoints are *not* included.\n- Brackets ${\\color{blue}{[}}\\phantom{0}\\phantom{0}{\\color{blue}{]}}$ to indicate that the endpoints *are* included.\n\nFor the given interval\n\n$$\n{\\color{red}{{\\big(}}} -4, \\sqrt2\\, {\\color{blue}{\\big]}}\n$$\n\nwe note the following:\n\n- The left endpoint $-4$ is *not* included in the interval. Therefore, we use ${\\color{red}{\\lt}}\\,$.\n- The right endpoint $\\sqrt2$ *is* included in the interval. Therefore, we use ${\\color{blue}{\\leq}}\\,$.\n\nTherefore, the inequality that corresponds to the given interval is\n\n$$\n-4 \\,\\,{\\color{red}{\\lt}}\\,\\, y \\,\\,{\\color{blue}{\\leq}}\\,\\, \\sqrt 2\n$$"}] [{:db/id #edb/ref 17592186059387 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059828 :knowledge-point/id #uuid "c8c3e092-d9ff-5dc9-ad1e-f31aa2b226ba" :knowledge-point/title "Translating Between Half-Open Intervals and Number Lines"}] :question/id #uuid "45d05c7d-e278-552f-a524-926d4a57d870" :question/math-academy-id "e-10787" :question/problem "What interval corresponds to the segment shown below?\n\n![](images/43/430481f9d0863b0bb5602f949e6f994d8007ea29fdd741a485d880df8d5d2dec.png)" :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses ${\\color{red}{(}}\\phantom{0} \\phantom{0}{\\color{red}{)}}$ if the endpoints are *not* included.\n- Brackets ${\\color{blue}{[}}\\phantom{0} \\phantom{0}{\\color{blue}{]}}$ if the endpoints *are* included.\n\nThe given interval can be represented by the following inequality:\n\n$$\n-2\\,\\, {\\color{blue}{\\leq}} \\,\\, x \\,\\, {\\color{red}{\\lt}} \\,\\, 2\n$$\n\nWe can express our inequality in interval notation as follows:\n\n$$\nx\\in {\\color{blue}{[}}-2,2{\\color{red}{)}}\n$$"}] [{:db/id #edb/ref 17592186059388 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059829 :knowledge-point/id #uuid "2f519fa9-de89-5b00-aa02-312cf8e32cba" :knowledge-point/title "Converting Between Intervals and Inequalities: Closed Intervals"}] :question/id #uuid "6d4bd0a2-0961-54c1-b781-b470d420d848" :question/math-academy-id "e-10816" :question/problem "Express the inequality $1 \\le x \\le4$ in interval notation." :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses ${\\color{red}{(}}\\phantom{0} \\phantom{0}{\\color{red}{)}}$ if the endpoints are *not* included.\n- Brackets ${\\color{blue}{[}}\\phantom{0} \\phantom{0}{\\color{blue}{]}}$ if the endpoints *are* included.\n\nOur inequality contains only \"or equal to\" symbols. So, the endpoints $1$ and $4$ *are* included.\n\n$$\n1\\,\\, {\\color{blue}{\\le}} \\,\\, x \\,\\, {\\color{blue}{\\le}} \\,\\, 4\n$$\n\nTherefore, we can express our inequality in interval notation as follows:\n\n$$\n{\\color{blue}{[}}1,4{\\color{blue}{]}}\n$$\n\nMore formally, we can also write\n\n$$\nx\\in [1,4]\n$$"}] [{:db/id #edb/ref 17592186059958 :knowledge-point/_questions [{:db/id #edb/ref 17592186059829 :knowledge-point/id #uuid "2f519fa9-de89-5b00-aa02-312cf8e32cba" :knowledge-point/title "Converting Between Intervals and Inequalities: Closed Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9bde48c0-e5a3-5ec8-ae61-b4b406b5d038" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[- 10, 3)" :db/id #edb/ref 17592186056108} {:answer/id #uuid "a324f11c-84eb-5e97-81a6-e51cdd32f99d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-10, 3)" :db/id #edb/ref 17592186056109} {:answer/id #uuid "c980cfab-047c-538b-8c86-405d0d88529d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- ∞, 3]" :db/id #edb/ref 17592186056110} {:answer/id #uuid "2751dc53-f2a4-5cd1-b51a-da0988e098a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[- 10, 3]" :db/id #edb/ref 17592186056111} {:answer/id #uuid "47020c3d-65bc-521b-838e-ef7ab75d3e0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-10, 3]" :db/id #edb/ref 17592186056112}] :answer-field/id #uuid "bbff7b41-8a1b-509f-91ec-dd43bc73c6e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056107}] :question/id #uuid "5bdfaded-c508-56ef-8657-15a990f7ff66" :question/math-academy-id "q-102200" :question/problem "The inequality $-10 \\le x \\le 3$ can be expressed in interval notation as"}]}
