#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186088734} :activity/id #uuid "577ff41d-cd6b-5bfb-9a19-db4815d18bb2" :activity/scope {:db/id #edb/ref 17592186050915 :topic/id #uuid "70dfa99f-c825-5da5-8721-f8fa26795d6f" :topic/math-academy-id 840} :activity/steps [{:db/id #edb/ref 17592186088734 :step/content {:db/id #edb/ref 17592186088985 :tutorial/content "Remember that a number is a **factor** of another number if it divides the number with no remainder. \n\nA whole number is a **prime number** if it has *exactly two* factors: itself and $1.$\n\nFor instance, $3$ is a prime number because it has only two factors, namely $3$ and $1{:}$\n\n$$\n3 = 3\\times 1\n$$\n\nThere are infinitely many prime numbers. The first few prime numbers are\n\n$$\n2,\\quad 3,\\quad 5,\\quad 7,\\quad 11,\\quad 13,\\quad 17,\\quad 19,\\quad 23,\\quad 29,\\quad \\ldots\n$$\n\nPrime numbers are very important. For example, computers use them to send and receive information across the internet securely." :tutorial/id #uuid "ee084b63-b5c9-54fe-8f73-750445535efe" :tutorial/math-academy-id 6639 :tutorial/title "Introduction"} :step/id #uuid "61039992-084b-5a41-8a84-d5d32f71239e" :step/math-academy-id 40187 :step/next {:db/id #edb/ref 17592186088736}} {:db/id #edb/ref 17592186088735 :step/content {:db/id #edb/ref 17592186088986 :tutorial/content "Numbers with *more* than two factors are called **composite numbers**. \n\nFor example, $4$ is composite because it has three factors, namely $1, 2,$ and $4.$ \n\nWe can think of composite numbers geometrically. Let the number $4$ be represented by a collection of four items:\n\n![](images/5b/5b0d7581cb6e9ce19bd9337ee1311ceb5260943b96ecd50984db3b3a03a5dd87.png)\n\nWe can pile the objects up to form a rectangle where the length and width are both greater than $1{:}$ \n\n![](images/d6/d6d1f8ff0c888300090d1f3c438abcaed9f30e898f4cf7b5b2d6ccbbad27e831.png)\n\nIn contrast, a prime number of objects *cannot* be rearranged to form a rectangle where the length and width are *both* greater than $1.$" :tutorial/id #uuid "db98b259-0f36-53b5-b62a-788af51d2b32" :tutorial/math-academy-id 6640 :tutorial/title "Composite Numbers"} :step/id #uuid "dbf16eb4-9e74-5637-b88b-0c59bf07c9e3" :step/math-academy-id 40188 :step/next {:db/id #edb/ref 17592186088737}} {:db/id #edb/ref 17592186088736 :step/content {:db/id #edb/ref 17592186087825 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087420 :question/id #uuid "580e631f-10aa-5f3c-92a9-592c879df478" :question/math-academy-id "e-10623"} :knowledge-point/id #uuid "af9aa6af-5cbe-5933-9c7b-62e32a63386c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048351}] :knowledge-point/questions [{:db/id #edb/ref 17592186088010} {:db/id #edb/ref 17592186088011} {:db/id #edb/ref 17592186424832} {:db/id #edb/ref 17592186434654} {:db/id #edb/ref 17592186434655}] :knowledge-point/title "Identifying Prime Numbers"} :step/id #uuid "4c44f455-2994-5b1f-b5a9-5ea9a33d7a2a" :step/math-academy-id 40189 :step/next {:db/id #edb/ref 17592186088735}} {:db/id #edb/ref 17592186088737 :step/content {:db/id #edb/ref 17592186087826 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087421 :question/id #uuid "f1e2d3d3-8819-5988-8ec1-195cbd548773" :question/math-academy-id "e-10624"} :knowledge-point/id #uuid "cd997467-85ee-5288-a574-2719cbff167b" :knowledge-point/questions [{:db/id #edb/ref 17592186088014} {:db/id #edb/ref 17592186088015} {:db/id #edb/ref 17592186434651} {:db/id #edb/ref 17592186434653}] :knowledge-point/title "Identifying Composite Numbers"} :step/id #uuid "b769077a-6aa9-51b2-b700-b41bc8260115" :step/math-academy-id 40192 :step/next {:db/id #edb/ref 17592186088739}} {:db/id #edb/ref 17592186088738 :step/content {:db/id #edb/ref 17592186087827 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087422 :question/id #uuid "72d7834c-fdfd-5f05-ad5f-cd9f6a2fcffc" :question/math-academy-id "e-10625"} :knowledge-point/id #uuid "b45eb1fc-7e00-5ece-8dcf-f27e6d4fb78e" :knowledge-point/questions [{:db/id #edb/ref 17592186088012} {:db/id #edb/ref 17592186088013} {:db/id #edb/ref 17592186434650} {:db/id #edb/ref 17592186434652}] :knowledge-point/title "Identifying One as Neither Prime Nor Composite"} :step/id #uuid "03211f8f-c13f-570c-b8d1-d99bafd6d977" :step/math-academy-id 40196} {:db/id #edb/ref 17592186088739 :step/content {:db/id #edb/ref 17592186088987 :tutorial/content "Every positive whole number is either prime or composite, but not both. \n\nThe only exception is the number $1.$ The number $1$ is neither prime nor composite because it only has one whole number factor, namely $1.$" :tutorial/id #uuid "2092df40-d7b5-5553-a2d1-05d8166f06bb" :tutorial/math-academy-id 6646 :tutorial/title "One Is Neither Prime Nor Composite"} :step/id #uuid "758bd934-4f53-5080-bca6-e617305ccced" :step/math-academy-id 40237 :step/next {:db/id #edb/ref 17592186088738}}] :activity/title "Prime and Composite Numbers" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186087912}]}
