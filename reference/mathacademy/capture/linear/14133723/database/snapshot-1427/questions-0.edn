#{[{:db/id #edb/ref 17592186087420 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087825 :knowledge-point/id #uuid "af9aa6af-5cbe-5933-9c7b-62e32a63386c" :knowledge-point/title "Identifying Prime Numbers"}] :question/id #uuid "580e631f-10aa-5f3c-92a9-592c879df478" :question/math-academy-id "e-10623" :question/problem "Which of the following is a list containing only prime numbers?\n\nI. $3, \\: 5, \\: 8, \\: 17$\n\nII. $3, \\: 7, \\: 11, \\: 29$\n\nIII. $2, \\: 4, \\: 7, \\: 13$" :question/worked-solution "A prime number is a positive whole number with exactly two distinct whole number factors: itself and $1.$\n\nWith that in mind, let's examine the numbers in each list.\n\n- List I includes $8$, which is not prime as it has more than two factors:  $1,$ $2,$ $4,$ and $8.$\n\n- List II contains only prime numbers since $3,$ $7,$ $11,$ and $29$ have only two factors each: $1$ and themselves.\n\n- List III contains $4$, which is not prime as it has more than two factors: $1,$ $2,$ and $4.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186087421 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087826 :knowledge-point/id #uuid "cd997467-85ee-5288-a574-2719cbff167b" :knowledge-point/title "Identifying Composite Numbers"}] :question/id #uuid "f1e2d3d3-8819-5988-8ec1-195cbd548773" :question/math-academy-id "e-10624" :question/problem "Which of the following lists contains only composite numbers?\n\nI. $4, \\: 16, \\: 24, \\: 28$\n\nII. $6, \\: 15, \\: 19, \\: 20$\n\nIII. $8, \\: 15, \\: 21, \\: 29$" :question/worked-solution "A prime number is a positive whole number with exactly two distinct whole number factors: itself and $1.$ A composite number is a number that has more than two distinct factors.\n\nWith that in mind, let's examine each list.\n\n- List I contains only composite numbers. Notice that all of them have $2$ as a factor.\n\n- List II includes $19,$ which is prime.\n\n- List III contains $29,$ which is prime.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186087422 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087827 :knowledge-point/id #uuid "b45eb1fc-7e00-5ece-8dcf-f27e6d4fb78e" :knowledge-point/title "Identifying One as Neither Prime Nor Composite"}] :question/id #uuid "72d7834c-fdfd-5f05-ad5f-cd9f6a2fcffc" :question/math-academy-id "e-10625" :question/problem "Which of the following numbers are prime?\n\n$$\n13, \\quad 15, \\quad  17, \\quad  1, \\quad  6\n$$" :question/worked-solution "A prime number is a positive whole number with exactly two distinct whole number factors: itself and $1.$ A composite number is a number that has more than two distinct factors.\n\nThe number $1$ is neither prime nor composite.\n\nWith that in mind, let's examine the numbers in the list.\n\n- $13$ is prime since it has only two factors: $1$ and $13.$\n\n- $15$ is *not* prime as it has factors distinct from itself and $1.$ For example, $3$ is a factor of $15\\mathbin{:}$ \n\n$$\n15= 3\\times 5\n$$\n\n- $17$ is prime since it has only two factors: $1$ and $17.$\n\n- $1$ is *not* prime since it has only one factor. Moreover, $1$ is *not* composite either.\n\n- $6$ is *not* prime as it has factors distinct from itself and $1.$ For example, $3$ is a factor of $6\\mathbin{:}$ \n\n$$\n6= 3\\times 2\n$$\n\nTherefore, only $13$ and $17$ are prime."}] [{:db/id #edb/ref 17592186434655 :knowledge-point/_questions [{:db/id #edb/ref 17592186087825 :knowledge-point/id #uuid "af9aa6af-5cbe-5933-9c7b-62e32a63386c" :knowledge-point/title "Identifying Prime Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04ba9281-e055-5aba-970f-eea79fd99e1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186434615} {:answer/id #uuid "0edf644b-50d5-5dc0-afc6-6ebfe7b7231d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186434616} {:answer/id #uuid "108adbab-9bb2-5eae-a020-085b73ba5a40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186434617} {:answer/id #uuid "3d7f49e4-98e5-596d-a690-56fffb16ebb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186434624} {:answer/id #uuid "e19ff8d8-036c-529e-adcc-9db441fe5350" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186434640}] :answer-field/correct {:answer/id #uuid "0edf644b-50d5-5dc0-afc6-6ebfe7b7231d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186434616} :answer-field/id #uuid "a4b1d287-4b48-5946-907b-3c3e5085a237" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186434646}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f5bec05f-8e68-5a1d-a365-731ec8194eb9" :question/math-academy-id "q-151064" :question/problem "Which of the following numbers is prime?" :question/worked-solution "A prime number is a positive whole number with exactly two distinct whole number factors: itself and $1.$\n\nThe only number that satisfies this definition is $3.$ It has only two factors: $1$ and $3.$\n\n$$\n\\begin{aligned}3 & =1\\times 3 \\\\  & =3\\times 1\\end{aligned}\n$$\n\nAll the other given numbers have at least one factor distinct from itself, and $1:$\n\n- $9$ has $3$ as a factor:\n\n$$\n9=3\\times 3\n$$\n\n- $27$ has $3$ and $9$ as factors:\n\n$$\n27=3\\times 9\n$$\n\n- $8$ has $2$ and $4$ as factors:\n\n$$\n8=2\\times 4\n$$\n\n- $32$ has $2$ and $16$ as factors:\n\n$$\n32=2\\times 16\n$$\n\nTherefore, the correct answer is $3.$"}] [{:db/id #edb/ref 17592186434652 :knowledge-point/_questions [{:db/id #edb/ref 17592186087827 :knowledge-point/id #uuid "b45eb1fc-7e00-5ece-8dcf-f27e6d4fb78e" :knowledge-point/title "Identifying One as Neither Prime Nor Composite"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18b300c4-a8e1-5815-9085-b4e89af37a36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $14$ only" :db/id #edb/ref 17592186434619} {:answer/id #uuid "204a4cbe-1c80-5987-b940-181581d7640b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1,$ $14,$ and $39$ only" :db/id #edb/ref 17592186434620} {:answer/id #uuid "77b11a08-6bbc-5a97-802e-7e923c2ee2fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the numbers are composite" :db/id #edb/ref 17592186434629} {:answer/id #uuid "b9bd3b1f-0289-5ffb-988d-f9c78537119d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$14$ and $39$ only" :db/id #edb/ref 17592186434635} {:answer/id #uuid "da2c6b8a-c3fa-5497-934c-8adef4689c4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$19$ only" :db/id #edb/ref 17592186434639}] :answer-field/correct {:answer/id #uuid "b9bd3b1f-0289-5ffb-988d-f9c78537119d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$14$ and $39$ only" :db/id #edb/ref 17592186434635} :answer-field/id #uuid "e5e6cc24-1a60-5d41-9a41-af89d9b04ab4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186434647}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6c5be044-29e6-5f84-b096-b5932b361863" :question/math-academy-id "q-151202" :question/problem "Which of the following numbers are composite?\n\n$$\n14,\\,39,\\,1,\\,19,\\,2\n$$" :question/worked-solution "A prime number is a positive whole number with exactly two distinct whole number factors: itself and $1.$ A composite number is a number that has more than two distinct factors.\n\nThe number $1$ is neither prime nor composite.\n\nWith that in mind, let's examine the numbers in the list.\n\n- $14$ is composite as it has factors distinct from itself and $1.$ For example, $2$ is a factor of $14:$ \n\n$$\n14=2\\times 7\n$$\n\n- $39$ is composite as it has factors distinct from itself and $1.$ For example, $3$ is a factor of $39:$ \n\n$$\n39=3\\times 13\n$$\n\n- $1$ is *not* composite since it has only one factor. Moreover, $1$ is *not* prime either.\n\n- $19$ is *not* composite since it has only two factors: $1$ and $19.$\n\n- $2$ is *not* composite since it has only two factors: $1$ and $2.$\n\nTherefore, the correct answer is \"$14$ and $39$ only.\""}] [{:db/id #edb/ref 17592186434651 :knowledge-point/_questions [{:db/id #edb/ref 17592186087826 :knowledge-point/id #uuid "cd997467-85ee-5288-a574-2719cbff167b" :knowledge-point/title "Identifying Composite Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a66695c-f369-56b3-b63d-4c0b3b14fb3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4,$ $15,$ and $21$ only" :db/id #edb/ref 17592186434623} {:answer/id #uuid "52a37c55-5b9b-5e53-9f9f-7cd24ac071e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ and $15$ only" :db/id #edb/ref 17592186434626} {:answer/id #uuid "ae552646-ffff-5619-a37a-fe13d3b7352c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ only" :db/id #edb/ref 17592186434634} {:answer/id #uuid "ce8a3e10-978e-59e2-a370-1da4ea1415b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$17$ and $21$ only" :db/id #edb/ref 17592186434638} {:answer/id #uuid "e9133fb1-21b4-5ec7-92dd-6f7b99210fef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5,$ and $17$ only" :db/id #edb/ref 17592186434642}] :answer-field/correct {:answer/id #uuid "3a66695c-f369-56b3-b63d-4c0b3b14fb3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4,$ $15,$ and $21$ only" :db/id #edb/ref 17592186434623} :answer-field/id #uuid "f0407751-3348-5140-a28a-a812be0eb2c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186434648}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "28d07878-4721-5eb5-b0be-c107be86a38a" :question/math-academy-id "q-151284" :question/problem "Which of the following numbers are composite?\n\n$$\n4,\\,15,\\,5,\\,17,\\,21\n$$" :question/worked-solution "A prime number is a positive whole number with exactly two distinct whole number factors: itself and $1.$ A composite number is a number that has more than two distinct factors.\n\nWith that in mind, let's examine each of the numbers in turn.\n\n- $4$ is composite as it has factors distinct from itself and $1.$ For example, $2$ is a factor of $4:$ \n\n$$\n4=2\\times 2\n$$\n\n- $15$ is composite as it has factors distinct from itself and $1.$ For example, $3$ is a factor of $15:$ \n\n$$\n15=3\\times 5\n$$\n\n- $5$ is prime since it has only two factors: $1$ and $5.$\n\n- $17$ is prime since it has only two factors: $1$ and $17.$\n\n- $21$ is composite as it has factors distinct from itself and $1.$ For example, $3$ is a factor of $21:$ \n\n$$\n21=3\\times 7\n$$\n\nTherefore, the correct answer is \"$4,$ $15,$ and $21$ only.\""}] [{:db/id #edb/ref 17592186434653 :knowledge-point/_questions [{:db/id #edb/ref 17592186087826 :knowledge-point/id #uuid "cd997467-85ee-5288-a574-2719cbff167b" :knowledge-point/title "Identifying Composite Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0170376b-1703-5848-91b7-1bdf5372127a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$13$ and $23$ only" :db/id #edb/ref 17592186434614} {:answer/id #uuid "17f554f4-6ec4-50a4-b0ae-4c5f480254b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$19$ and $29$ only" :db/id #edb/ref 17592186434618} {:answer/id #uuid "7f57c3ed-1ad5-5ca3-8b26-6cd6acd77a2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$12$ and $23$ only" :db/id #edb/ref 17592186434630} {:answer/id #uuid "ab53565d-7bb7-56a5-8040-4685d4b99858" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$12$ only" :db/id #edb/ref 17592186434633} {:answer/id #uuid "e9eef686-c034-5793-be34-0e3df8069184" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$13,$ $19,$ and $23$ only" :db/id #edb/ref 17592186434643}] :answer-field/correct {:answer/id #uuid "ab53565d-7bb7-56a5-8040-4685d4b99858" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$12$ only" :db/id #edb/ref 17592186434633} :answer-field/id #uuid "6643d86e-0adf-5b80-be53-f06b957e2351" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186434645}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "972da6da-62d7-5b9f-b8a6-856a5ad278f9" :question/math-academy-id "q-151625" :question/problem "Which of the following numbers are **not** prime?\n\n$$\n12,\\,13,\\,19,\\,23,\\,29\n$$" :question/worked-solution "A prime number is a positive whole number with exactly two distinct whole number factors: itself and $1.$ A composite number is a number that has more than two distinct factors.\n\nWith that in mind, let's examine each of the numbers in turn.\n\n- $12$ is *not* prime as it has factors distinct from itself and $1.$ For example, $2$ is a factor of $12:$ \n\n$$\n12=2\\times 6\n$$\n\n- $13$ is prime since it has only two factors: $1$ and $13.$\n\n- $19$ is prime since it has only two factors: $1$ and $19.$\n\n- $23$ is prime since it has only two factors: $1$ and $23.$\n\n- $29$ is prime since it has only two factors: $1$ and $29.$\n\nTherefore, the correct answer is \"$12$ only.\""}] [{:db/id #edb/ref 17592186434650 :knowledge-point/_questions [{:db/id #edb/ref 17592186087827 :knowledge-point/id #uuid "b45eb1fc-7e00-5ece-8dcf-f27e6d4fb78e" :knowledge-point/title "Identifying One as Neither Prime Nor Composite"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30013d7b-d1c4-55c6-95ff-a07756e917bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$36$ and $40$ only" :db/id #edb/ref 17592186434621} {:answer/id #uuid "5a358aef-dd18-52cf-882b-0d509a8b078e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$19$ and $23$ only" :db/id #edb/ref 17592186434627} {:answer/id #uuid "8b2bbafb-ad29-5f9b-8b3c-1567b637e7d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$19$ only" :db/id #edb/ref 17592186434631} {:answer/id #uuid "bb7aee24-19a2-5243-8fbf-b2953176cccf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$ and $23$ only" :db/id #edb/ref 17592186434636} {:answer/id #uuid "e77effd6-5472-5228-a821-7732b919792a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1,\\,19,$ and $23$ only" :db/id #edb/ref 17592186434641}] :answer-field/correct {:answer/id #uuid "5a358aef-dd18-52cf-882b-0d509a8b078e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$19$ and $23$ only" :db/id #edb/ref 17592186434627} :answer-field/id #uuid "49572303-bc44-5164-afa7-108b2adc0b8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186434644}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0449931c-054f-54ef-852c-1a5c16adcd76" :question/math-academy-id "q-151679" :question/problem "Which of the following numbers are prime?\n\n$$\n40,\\,1,\\,23,\\,36,\\,19\n$$" :question/worked-solution "A prime number is a positive whole number with exactly two distinct whole number factors: itself and $1.$ A composite number is a number that has more than two distinct factors.\n\nThe number $1$ is neither prime nor composite.\n\nWith that in mind, let's examine the numbers in the list.\n\n- $40$ is *not* prime as it has factors distinct from itself and $1.$ For example, $10$ is a factor of $40:$ \n\n$$\n40=10\\times 4\n$$\n\n- $1$ is *not* prime since it has only one factor. Moreover, $1$ is *not* composite either.\n\n- $23$ is prime since it has only two factors: $1$ and $23.$\n\n- $36$ is *not* prime as it has factors distinct from itself and $1.$ For example, $6$ is a factor of $36:$ \n\n$$\n36=6\\times 6\n$$\n\n- $19$ is prime since it has only two factors: $1$ and $19.$\n\nTherefore, the correct answer is \"$19$ and $23$ only.\""}] [{:db/id #edb/ref 17592186434654 :knowledge-point/_questions [{:db/id #edb/ref 17592186087825 :knowledge-point/id #uuid "af9aa6af-5cbe-5933-9c7b-62e32a63386c" :knowledge-point/title "Identifying Prime Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38c5d5cf-621e-5080-87d9-79657e0efe92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186434622} {:answer/id #uuid "4989a881-4c6b-52f3-8503-347cea62c833" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186434625} {:answer/id #uuid "65555e2d-eb63-5b48-a3cc-eddd792da507" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186434628} {:answer/id #uuid "9bd90748-2327-509e-bb3f-e9f582596ff0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186434632} {:answer/id #uuid "bf2099e0-e648-5472-8f09-1eb809abd98e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186434637}] :answer-field/correct {:answer/id #uuid "4989a881-4c6b-52f3-8503-347cea62c833" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186434625} :answer-field/id #uuid "fcb78ec7-eb04-59e7-ad32-0c034d96790e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186434649}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d6642a8e-2349-55aa-9e5d-871dc8226b24" :question/math-academy-id "q-151780" :question/problem "Which of the following numbers is prime?" :question/worked-solution "A prime number is a positive whole number with exactly two distinct whole number factors: itself and $1.$\n\nThe only number that satisfies this definition is $7.$ It has only two factors: $1$ and $7.$\n\n$$\n\\begin{aligned}7 & =1\\times 7 \\\\  & =7\\times 1\\end{aligned}\n$$\n\nAll the other given numbers have at least one factor distinct from itself, and $1:$\n\n- $21$ has $3$ and $7$ as factors:\n\n$$\n21=3\\times 7\n$$\n\n- $9$ has $3$ as a factor:\n\n$$\n9=3\\times 3\n$$\n\n- $24$ has $3$ and $8$ as factors:\n\n$$\n24=3\\times 8\n$$\n\n- $15$ has $3$ and $5$ as factors:\n\n$$\n15=3\\times 5\n$$\n\nTherefore, the correct answer is $7.$"}]}
