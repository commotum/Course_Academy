#{[{:db/id #edb/ref 17592186147146 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186147573 :knowledge-point/id #uuid "a2cfba3f-e03a-5cf2-8f7d-9b5576c8eb91" :knowledge-point/title "Finding a Missing Percentage Given Two Numbers"}] :question/id #uuid "2ed2e15c-4ac7-5cd8-bfda-65573ff6fb44" :question/math-academy-id "e-13064" :question/problem "What is the missing number?\n\n$\\qquad$ ![](images/81/81b70e75c29649960c40e1fde55949f210718ebc3ea188686742605717512933.svg) of $20 = 35$" :question/worked-solution "We can write the given problem as the following product:\n\n![](images/44/44ceb7ccb604fc5f57bb5be3f77c564716f4bd9281c07d349d89fe298ae0e43a.svg)\n\nUsing the relationship between multiplication and division, we can write our problem as follows:\n![](images/5c/5c86d175be61156120db260d435e715db5b7e123a707d860a043582469ac0455.svg)\n\nTo write this fraction as a percentage, we write an equivalent fraction with $100$ as the denominator:\n\n$$\n\\dfrac{35}{20} = \\dfrac{35 \\times 5}{20 \\times 5} = \\dfrac{175}{100}\n$$\n\nNow we can write this fraction as a percentage:\n\n$$\n\\dfrac{175}{100} = 175 \\%\n$$"}] [{:db/id #edb/ref 17592186147147 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186147574 :knowledge-point/id #uuid "e81c1d02-c62a-59e9-9c15-66ec632802da" :knowledge-point/title "Finding a Missing Percentage Given Two Numbers Using Simplification"}] :question/id #uuid "146d6a70-f2ed-5f9a-9d6a-5e4c856acda0" :question/math-academy-id "e-13065" :question/problem "If ![](images/0b/0b6591a213a91a5c24d49c3aca4f54fb5812bb64e3f0015c29be323e75484da9.svg) then ![](images/11/1165d6dd086f396f3473dd6da171256cc78ceeef91ce3d3bc128c3e82a9aafd9.svg)" :question/worked-solution "Using the relationship between multiplication and division, we can write our problem as follows:\n![](images/5e/5eabee5d5350cd0d0ab35358f35078c5e3dc1c788ac176804f62753462c2ca34.svg)\n\nWe can simplify this fraction as follows:\n\n$$\n\\dfrac{7}{35} = \\dfrac{7 \\div 7}{35 \\div 7} = \\dfrac{1}{5}\n$$\n\nTo write this fraction as a percentage, we write an equivalent fraction with $100$ as the denominator:\n\n$$\n\\dfrac{1}{5} = \\dfrac{1 \\times 20}{5 \\times 20} = \\dfrac{20}{100}\n$$\n\nNow we can write this fraction as a percentage:\n\n$$\n\\dfrac{20}{100} = 20\\%\n$$"}] [{:db/id #edb/ref 17592186455444 :knowledge-point/_questions [{:db/id #edb/ref 17592186147573 :knowledge-point/id #uuid "a2cfba3f-e03a-5cf2-8f7d-9b5576c8eb91" :knowledge-point/title "Finding a Missing Percentage Given Two Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89d06a78-0268-5589-bbe5-1f803fd17784" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186455154} {:answer/id #uuid "9e3564ce-20aa-5dd9-8582-52a7f48aa3dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "160" :db/id #edb/ref 17592186455187} {:answer/id #uuid "a4ed59b0-bae6-5f11-942c-85bfea14ce27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186455194} {:answer/id #uuid "aad92959-356f-5281-b44f-276729d69382" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186455202} {:answer/id #uuid "eaef82ad-2d7a-51ac-9e84-46b14c86db3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186455310}] :answer-field/correct {:answer/id #uuid "9e3564ce-20aa-5dd9-8582-52a7f48aa3dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "160" :db/id #edb/ref 17592186455187} :answer-field/id #uuid "c5003fc5-5077-5aac-96d3-91784251d114" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186455408}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3efa1a19-2402-5224-861f-b75cf9662684" :question/math-academy-id "q-148051" :question/problem "What is the missing number?\n\n$\\,$ $\\boxed{}\\,%$ of $25=40$" :question/worked-solution "We can write the given problem as the following product:\n\n$$\n\\boxed{}\\,%\\times 25=40\n$$\n\nUsing the relationship between multiplication and division, we can write our problem as:\n\n$$\n\\boxed{}\\,%=40÷25=\\frac{40}{25}\n$$\n\nTo write this fraction as a percentage, we write an equivalent fraction with $100$ as the denominator:\n\n$$\n\\frac{40}{25}=\\frac{40\\times 4}{25\\times 4}=\\frac{160}{100}\n$$\n\nNow we can write this fraction as a percentage:\n\n$$\n\\frac{160}{100}=160%\n$$"}] [{:db/id #edb/ref 17592186455493 :knowledge-point/_questions [{:db/id #edb/ref 17592186147574 :knowledge-point/id #uuid "e81c1d02-c62a-59e9-9c15-66ec632802da" :knowledge-point/title "Finding a Missing Percentage Given Two Numbers Using Simplification"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "067991d8-b641-57f3-9108-03d53b4a6751" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186454920} {:answer/id #uuid "3f731da2-101a-5cc2-bfd8-34bfd1cb8353" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "250" :db/id #edb/ref 17592186455008} {:answer/id #uuid "88cdf51f-8de3-5db3-85f6-efc273fe932e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "170" :db/id #edb/ref 17592186455149} {:answer/id #uuid "e4692d29-df3f-5906-be3b-0b79ffde0a74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186455297} {:answer/id #uuid "edfcddf2-a4c0-5bd1-a3e4-e42049e94b1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "150" :db/id #edb/ref 17592186455316}] :answer-field/correct {:answer/id #uuid "3f731da2-101a-5cc2-bfd8-34bfd1cb8353" 