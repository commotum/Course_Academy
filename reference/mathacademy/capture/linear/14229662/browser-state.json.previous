  "live_records": {
    "q-105592": {
      "dom_id": "step-q105592",
      "name": "Question 1",
      "problem": "From top to bottom, what are the missing expressions in the following polynomial division problem?\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\boxed{} \\\\  & 2x+3\\,\\enclose{longdiv}{4{x}^{3}+2{x}^{2}+2x+14\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{4{x}^{3}+6{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,-\\,4{x}^{2}+2x+14 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{\\boxed{}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,8x+14 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{8x+12}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,2\\end{aligned}\n$$",
      "worked_solution": "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,2{x}^{2}-2x+4 \\\\  & 2x+3\\,\\enclose{longdiv}{4{x}^{3}+2{x}^{2}+2x+14\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{4{x}^{3}+6{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,-\\,4{x}^{2}+2x+14 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{-\\,4{x}^{2}-6x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,8x+14 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{8x+12}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,2\\end{aligned}\n$$\n\n \n\nTherefore, the missing expressions are \n\n$\\,$ $2{x}^{2}-2x+4\\,$ and $\\,-4{x}^{2}-6x.$",
      "calculator_instructions": "",
