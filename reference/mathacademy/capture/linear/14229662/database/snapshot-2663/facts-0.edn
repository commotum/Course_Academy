problem?\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\boxed{} \\\\  & 2x+3\\,\\enclose{longdiv}{4{x}^{3}+2{x}^{2}+2x+14\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{4{x}^{3}+6{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,-\\,4{x}^{2}+2x+14 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{\\boxed{}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,8x+14 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{8x+12}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,2\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186551356 #edb/ref 1072 #uuid "fe67be82-4bb6-56a3-b9ff-5fcade759364" #edb/ref 17592186045417] [17592186551356 #edb/ref 1074 "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,2{x}^{2}-2x+4 \\\\  & 2x+3\\,\\enclose{longdiv}{4{x}^{3}+2{x}^{2}+2x+14\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{4{x}^{3}+6{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,-\\,4{x}^{2}+2x+14 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{-\\,4{x}^{2}-6x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,8x+14 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{8x+12}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,2\\end{aligned}\n$$\n\n \n\nTherefore, the missing expressions are \n\n$\\,$ $2{x}^{2}-2x+4\\,$ and $\\,-4{x}^{2}-6x.$" #edb/ref 17592186045417]}
