34951 17592186045417 true] [17592186445406 1077 "field-1" 13194139534951 17592186045417 true] [17592186445406 1078 #edb/ref 17592186445395 13194139534951 17592186045417 true] [17592186445406 1079 #uuid "2d674a5c-fdfd-5d98-b059-a94b119773c7" 13194139534951 17592186045417 true] [17592186445407 1075 #edb/ref 17592186445391 13194139534951 17592186045417 true] [17592186445407 1075 #edb/ref 17592186445397 13194139534951 17592186045417 true] [17592186445407 1075 #edb/ref 17592186445399 13194139534951 17592186045417 true] [17592186445407 1075 #edb/ref 17592186445400 13194139534951 17592186045417 true] [17592186445407 1075 #edb/ref 17592186445403 13194139534951 17592186045417 true] [17592186445407 1076 #edb/ref 17592186045493 13194139534951 17592186045417 true] [17592186445407 1077 "selection" 13194139534951 17592186045417 true] [17592186445407 1078 #edb/ref 17592186445399 13194139534951 17592186045417 true] [17592186445407 1079 #uuid "54f6bfc9-156f-56af-9a68-93e35ceaafd4" 13194139534951 17592186045417 true] [17592186445408 1075 #edb/ref 17592186445394 13194139534951 17592186045417 true] [17592186445408 1076 #edb/ref 17592186045492 13194139534951 17592186045417 true] [17592186445408 1077 "field-1" 13194139534951 17592186045417 true] [17592186445408 1078 #edb/ref 17592186445394 13194139534951 17592186045417 true] [17592186445408 1079 #uuid "7e5b8b97-ae6f-5b9d-81bd-9420bb384ac9" 13194139534951 17592186045417 true] [17592186445409 1075 #edb/ref 17592186445398 13194139534951 17592186045417 true] [17592186445409 1076 #edb/ref 17592186045492 13194139534951 17592186045417 true] [17592186445409 1077 "field-1" 13194139534951 17592186045417 true] [17592186445409 1078 #edb/ref 17592186445398 13194139534951 17592186045417 true] [17592186445409 1079 #uuid "ce961bdb-0b16-58aa-9186-57cb2f2ecbd3" 13194139534951 17592186045417 true] [17592186445410 1068 #edb/ref 17592186445406 13194139534951 17592186045417 true] [17592186445410 1069 "q-186817" 13194139534951 17592186045417 true] [17592186445410 1070 #edb/ref 17592186045487 13194139534951 17592186045417 true] [17592186445410 1071 "$-\\frac{7}{15}+\\frac{3}{5}=${{field-1}}" 13194139534951 17592186045417 true] [17592186445410 1072 #uuid "04148a8c-1c50-5c75-a5ce-265853c3b05d" 13194139534951 17592186045417 true] [17592186445410 1074 "We put both fractions over a common denominator of $15$ and then add the numerators. This gives\n\n$$\n-\\frac{7}{15}+\\frac{3}{5}=-\\frac{7}{15}+\\frac{9}{15}=\\frac{-7+9}{15}.\n$$\n\nTo compute the numerator, we can use either Method 1 or Method 2, shown below.\n\n**Method 1 - Picturing a Number Line**\n\nTo add $9$ to $-7,$ we start at $-7$ on a number line and move $9$ spaces to the right.\n\n![](images/f2/f2d170548e38956afa1354e7df74f645ea5101c3dde6665c110ada01ab7a96b8.png)\n\nSo, $-7+9=2.$ Therefore,\n\n$$\n\\frac{-7+9}{15}=\\frac{2}{15}.\n$$\n\n**Method 2 - Subtraction in Reverse**\n\nWe can swap the order of the numbers in the numerator, and we get\n\n$$\n\\frac{-7+9}{15}=\\frac{9-7}{15}=\\frac{2}{15}.\n$$\n\nSo, we conclude that $-\\frac{7}{15}+\\frac{3}{5}=\\frac{2}{15}.$" 13194139534951 17592186045417 true] [17592186445411 1068 #edb/ref 17592186445407 13194139534951 17592186045417 true] [17592186445411 1069 "q-42771" 13194139534951 17592186045417 true] [17592186445411 1070 #edb/ref 17592186045485 13194139534951 17592186045417 true] [17592186445411 1071 "$-\\frac{1}{6}+\\frac{5}{6}=$" 13194139534951 17592186045417 true] [17592186445411 1072 #uuid "2f37489a-3f1a-5d45-bf2c-50769e7aa76a" 13194139534951 17592186045417 true] [17592186445411 1074 "Since both fractions have a common denominator of $6$, we can combine them to form one fraction, which gives\n \n\n$$\n-\\frac{1}{6}+\\frac{5}{6}=\\frac{-1+5}{6}.\n$$\n\nTo compute the numerator, we can use either Method 1 or Method 2, shown below.\n\n**Method 1 - Picturing a Number Line**\n\nTo add $5$ to $-1,$ we start at $-1$ on a number line and move $5$ spaces to the right.\n\n![](images/63/632e4bcce5b619f9a5c4dfb2c414a33da0e9567b7b4d8b15adb439da1b3dd88d.png)\n\nSo, $-1+5=4.$ Therefore,\n\n$$\n\\frac{-1+5}{6}=\\frac{4}{6}=\\frac{2}{3}.\n$$\n\n**Method 2 - Subtraction in Reverse**\n\nWe can swap the order of the numbers in the numerator, and we get\n\n$$\n\\begin{aligned}\\frac{-1+5}{6}=\\frac{5-1}{6}=\\frac{4}{6}=\\frac{2}{3}.\\end{aligned}\n$$\n\nSo, we conclude that $-\\frac{1}{6}+\\frac{5}{6}=\\frac{2}{3}.$" 13194139534951 17592186045417 true] [17592186445412 1068 #edb/ref 17592186445409 13194139534951 17592186045417 true] [17592186445412 1069 "q-186761" 13194139534951 17592186045417 true] [17592186445412 1070 #edb/ref 17592186045487 13194139534951 17592186045417 true] [17592186445412 1071 "$-4+1.3=${{field-1}}" 13194139534951 17592186045417 true] [17592186445412 1072 #uuid "456bbb28-9f6e-59b4-94a9-4565fc858899" 13194139534951 17592186045417 true] [17592186445412 1074 "We can swap the order of the numbers and then compute the resulting subtraction:\n\n$$\n-4+1.3=1.3-4=-2.7\n$$" 13194139534951 17592186045417 true] [17592186445413 1068 #edb/ref 17592186445404 13194139534951 17592186045417 true] [17592186445413 1069 "q-171019" 13194139534951 17592186045417 true] [17592186445413 1070 #edb/ref 17592186045487 13194139534951 17592186045417 true] [17592186445413 1071 "$-5.1+7.8=${{field-1}}" 13194139534951 17592186045417 true] [17592186445413 1072 #uuid "b19e586f-b5e5-54ad-9f34-9f32c29b74be" 13194139534951 17592186045417 true] [17592186445413 1074 "We can swap the order of the numbers and then compute the resulting subtraction:\n\n$$\n-5.1+7.8=7.8-5.1=2.7\n$$" 13194139534951 17592186045417 true] [17592186445414 1068 #edb/ref 17592186445405 13194139534951 17592186045417 true] [17592186445414 1069 "q-2111" 13194139534951 17592186045417 true] [17592186445414 1070 #edb/ref 17592186045485 13194139534951 17592186045417 true] [17592186445414 1071 "$-2+4=$" 13194139534951 17592186045417 true] [17592186445414 1072 #uuid "d61e161d-c16f-54c4-b847-5ce2fd8181a2" 13194139534951 17592186045417 true] [17592186445414 1074 "**Method 1 - Picturing a Number Line**\n\nTo add $4$ to $-2,$ we start at $-2$ on a number line and move $4$ spaces to the right.\n\n![](images/29/291bb445c414ae60c0093038554a780370b3e4d747e7e51a737aa15ffa7a6cf0.png)\n\nWe end up at $2.$ So, $-2+4=2.$\n\n**Method 2 - Subtraction in Reverse**\n\nWe can swap the order of the numbers and then compute the resulting subtraction:\n\n$$\n-2+4=4-2=2\n$$" 13194139534951 17592186045417 true] [17592186445415 1068 #edb/ref 17592186445408 13194139534951 17592186045417 true] [17592186445415 1069 "q-186759" 13194139534951 17592186045417 true] [17592186445415 1070 #edb/ref 17592186045485 13194139534951 17592186045417 true] [17592186445415 1071 "$-7.2+9=${{field-1}}" 13194139534951 17592186045417 true] [17592186445415 1072 #uuid "dbe692b7-3891-54fa-af44-56909b7f8af6" 13194139534951 17592186045417 true] [17592186445415 1074 "We can swap the order of the numbers and then compute the resulting subtraction:\n\n$$\n-7.2+9=9-7.2=1.8\n$$" 13194139534951 17592186045417 true]] :edb/tempids {"answer-029931bb-b5f8-5fb0-9873-fecc74600828" 17592186445390 "answer-1bb6d7c8-0f9b-5a72-997d-9319e4d9909f" 17592186445391 "answer-23598180-5131-56ac-a678-284f1be0f865" 17592186445392 "answer-39bdbb7d-1c2e-52f0-adb2-575085e56b8c" 17592186445393 "answer-4cd19208-d390-5649-bac1-18dae3a47955" 17592186445394 "answer-6964b9d9-786b-5c01-9b32-664218330975" 17592186445395 "answer-84427d74-3ee1-560e-bc68-770067d24981" 17592186445396 "answer-d2da51ed-49ab-5a35-8936-978067b61077" 17592186445397 "answer-d8c29228-4935-5f4f-92c0-8084c40f90c1" 17592186445398 "answer-ef3643e8-e01d-5c50-898f-0a065ba5fe4b" 17592186445399 "answer-f221eb0f-a3ec-559c-96de-9b221d2f6830" 17592186445400 "answer-f6a526c1-f065-5fe2-8d96-7ea86354ca6c" 17592186445401 "answer-fa1dfaf1-bfb2-5467-8046-aad5191102e4" 17592186445402 "answer-fe1d4d2c-65a3-5028-a3c4-6fec7489e8ab" 17592186445403 "answer-field-063dade4-c614-5849-9dd5-3fd50b05fb88" 17592186445404 "answer-field-1a262c79-dfba-55a4