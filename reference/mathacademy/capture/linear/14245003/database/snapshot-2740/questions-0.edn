#{[{:db/id #edb/ref 17592186233646 :knowledge-point/_questions [{:db/id #edb/ref 17592186087690 :knowledge-point/id #uuid "765ef63a-e3f0-503b-876d-3b4776b2cafe" :knowledge-point/title "Finding Approximate Solutions to Exponential Equations Using the Natural Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52b6d851-07bf-50a6-ba74-60a93aaab1ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.527" :db/id #edb/ref 17592186232335}] :answer-field/correct {:answer/id #uuid "52b6d851-07bf-50a6-ba74-60a93aaab1ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.527" :db/id #edb/ref 17592186232335} :answer-field/id #uuid "80d6b8d0-cd10-519f-aa6e-beaba5dff6e6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232334}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "37b84130-ad1d-51d8-b7bf-029b37f28c20" :question/math-academy-id "q-228899" :question/problem "If ${e}^{2x+3}=7,$ then $x\\approx ${{field-1}}, rounded to $3$ decimal places." :question/worked-solution "First, we take $ln$ of both sides of the equation and solve for $x:$\n\n$$\n\\begin{aligned}{e}^{2x+3} & =7 \\\\ \\operatorname{ln}({e}^{2x+3}) & =\\operatorname{ln}(7) \\\\ 2x+3 & =\\operatorname{ln}(7) \\\\ 2x & =\\operatorname{ln}(7)-3 \\\\ x & =\\frac{\\operatorname{ln}(7)-3}{2}\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nx\\approx -0.527\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186088256 :knowledge-point/_questions [{:db/id #edb/ref 17592186087691 :knowledge-point/id #uuid "10095048-0db6-5b4e-889f-303f07449367" :knowledge-point/title "Finding Solutions to Exponential Equations when Rearrangement is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87d6