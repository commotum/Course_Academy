#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186562557} :activity/id #uuid "bb2cc893-318b-5c46-9187-dc4662c5ec1c" :activity/scope {:db/id #edb/ref 17592186050649 :topic/id #uuid "5c4bc59d-ac0f-5225-a803-5b20b7524274" :topic/math-academy-id 870} :activity/steps [{:db/id #edb/ref 17592186562529 :step/content {:db/id #edb/ref 17592186233646 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52b6d851-07bf-50a6-ba74-60a93aaab1ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-0.527" :db/id #edb/ref 17592186232335}] :answer-field/correct {:db/id #edb/ref 17592186232335} :answer-field/id #uuid "80d6b8d0-cd10-519f-aa6e-beaba5dff6e6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186232334}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "37b84130-ad1d-51d8-b7bf-029b37f28c20" :question/math-academy-id "q-228899" :question/problem "If ${e}^{2x+3}=7,$ then $x≈${{field-1}}, rounded to $3$ decimal places." :question/worked-solution "First, we take $ln$ of both sides of the equation and solve for $x:$\n\n$$\n\\begin{aligned}{e}^{2x+3} & =7 \\\\ \\operatorname{ln}⁡({e}^{2x+3}) & =\\operatorname{ln}⁡(7) \\\\ 2x+3 & =\\operatorname{ln}⁡(7) \\\\ 2x & =\\operatorname{ln}⁡(7)-3 \\\\ x & =\\frac{\\operatorname{ln}⁡(7)-3}{2}\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nx≈-0.527\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "39f10d29-c503-5877-bdb9-888929fce129"} {:db/id #edb/ref 17592186562557 :step/content {:db/id #edb/ref 17592186088256 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a966bea-c2c7-552f-8b5b-fa831cc51613" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{7}{5}\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186561804} {:answer/id #uuid "83d81e6a-97cd-5d70-bf86-f4147a265d74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{7}\\operatorname{ln}⁡(4)" :db/id #edb/ref 17592186561913} {:answer/id #uuid "8f83f208-59ad-53c2-b961-74a5502985a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186561939} {:answer/id #uuid "e83c4852-1306-5f2d-9931-2c55058c46e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}\\operatorname{ln}⁡(7)" :db/id #edb/ref 17592186562155} {:answer/id #uuid "ea5b3a18-587d-588e-a8f2-045924faba19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186562167}] :answer-field/correct {:db/id #edb/ref 17592186562167} :answer-field/id #uuid "a6ea08e6-1bef-5ee9-8f14-f173d322f2e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186086190}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3d0d0e96-a523-5322-8133-5394507a5dd3" :question/math-academy-id "q-66604" :question/problem "Given that $-4{e}^{z}+7=5,$ then $z=$" :question/requires-calculator true :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}-4{e}^{z}+7 & =5 \\\\ -4{e}^{z} & =-2 \\\\ {e}^{z} & =\\frac{1}{2}\\end{aligned}\n$$\n\nThen, we find the natural logarithm $(ln)$ of both sides of the equation and solve for $z:$\n\n$$\n\\begin{aligned}{e}^{z} & =\\frac{1}{2} \\\\ \\operatorname{ln}⁡({e}^{z}) & =\\operatorname{ln}⁡(\\frac{1}{2}) \\\\ z & =-\\operatorname{ln}⁡(2)\\end{aligned}\n$$\n\nTherefore, the solution is $z=-\\operatorname{ln}⁡(2).$"} :step/id #uuid "893ce8ba-2439-5cf1-aec0-6855c2c81f6d" :step/next {:db/id #edb/ref 17592186562582}} {:db/id #edb/ref 17592186562582 :step/content {:db/id #edb/ref 17592186562427 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50094e0d-929c-58f0-8790-a6406f9ad6a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.110" :db/id #edb/ref 17592186561786} {:answer/id #uuid "670e1daf-3afb-59e1-9b42-ce9dff2c1033" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.011" :db/id #edb/ref 17592186561838} {:answer/id #uuid "7c320dc5-b88c-5faa-9a64-40fbe15a2db4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.107" :db/id #edb/ref 17592186561889} {:answer/id #uuid "99413ae4-eb90-54f6-8500-8a42fd390e61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.701" :db/id #edb/ref 17592186561963} {:answer/id #uuid "de1047ef-abb1-54f1-9a8b-9c9de60033b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.101" :db/id #edb/ref 17592186562135}] :answer-field/correct {:db/id #edb/ref 17592186562135} :answer-field/id #uuid "e976916e-93a3-584d-9937-d0ffaf77228b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186562372}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4010032d-a265-55ab-a980-12aa209eef4e" :question/math-academy-id "q-100285" :question/problem "Find the solution to the equation ${e}^{8x}=\\sqrt{5}$ rounded to $3$ decimal places." :question/worked-solution "First, we take $ln$ of both sides of the equation:\n\n$$\n\\begin{aligned}{e}^{8x} & =\\sqrt{5} \\\\ \\operatorname{ln}⁡({e}^{8x}) & =\\operatorname{ln}⁡(\\sqrt{5}) \\\\ 8x & =\\operatorname{ln}⁡({5}^{1/2})\\end{aligned}\n$$\n\nThen, we apply the power rule to the right-hand side and solve for $x$:\n\n$$\n\\begin{aligned}8x & =\\frac{1}{2}\\operatorname{ln}⁡(5) \\\\ x & =\\frac{1}{16}\\operatorname{ln}⁡(5)\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nx≈0.101\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "dc55817f-2a4e-5b97-8eb2-44246d45d570" :step/next {:db/id #edb/ref 17592186562529}}] :activity/title "Solving Equations Containing the Exponential Function" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186561574}]}
