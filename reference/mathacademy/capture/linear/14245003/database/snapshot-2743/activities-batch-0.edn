#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186088508} :activity/id #uuid "42a5638e-ae95-59db-93c5-895568bf8257" :activity/scope {:db/id #edb/ref 17592186050649 :topic/id #uuid "5c4bc59d-ac0f-5225-a803-5b20b7524274" :topic/math-academy-id 870} :activity/steps [{:db/id #edb/ref 17592186088508 :step/content {:db/id #edb/ref 17592186088885 :tutorial/content "Suppose we are given an equation containing an exponential function, such as\n\n$$\ne^{t}= 12.\n$$\n\nWe can solve it in the same way that we usually solve exponential equations, by taking the log on both sides where the base of the logarithm is the base of the exponential.\n\nHere, the base of the exponential is $e,$ so we take the *natural* logarithm of both sides, since\n\n$$\n\\log_e{x} = \\ln{x}.\n$$\n\nTaking the natural logarithm of both sides, we have that\n\n$$\n\\begin{aligned}{e}^{t} & =12 \\\\ \\operatorname{ln}⁡({e}^{t}) & =\\operatorname{ln}⁡(12).\\end{aligned}\n$$\n\nNow, we use the fact that $\\ln \\left( e^a \\right) = a$ to simplify the left-hand side. This gives\n\n$$\nt = \\ln (12).\n$$\n\nThis is the solution! We often present the solution of an exponential equation as an exact solution in logarithmic form." :tutorial/id #uuid "0f1cb099-7970-59ba-ad74-7052da9f2872" :tutorial/math-academy-id 2806 :tutorial/title "Introduction"} :step/id #uuid "3e65faf1-635c-5bbb-91ce-53b8a40b35a6" :step/math-academy-id 14672 :step/next {:db/id #edb/ref 17592186088509}} {:db/id #edb/ref 17592186088509 :step/content {:db/id #edb/ref 17592186087689 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087494 :question/id #uuid "5e22ac55-3e84-5cb4-8231-5f882da9240e" :question/math-academy-id "e-4103"} :knowledge-point/id #uuid "4d8c6c93-9d15-5482-8130-25bb9cabf008" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049053} {:db/id #edb/ref 17592186049589} {:db/id #edb/ref 17592186049879}] :knowledge-point/questions [{:db/id #edb/ref 17592186088253} {:db/id #edb/ref 17592186088255} {:db/id #edb/ref 17592186233027} {:db/id #edb/ref 17592186234220} {:db/id #edb/ref 17592186546961} {:db/id #edb/ref 17592186547056}] :knowledge-point/title "Finding Exact Solutions to Exponential Equations Using the Natural Logarithm"} :step/id #uuid "632071a8-82e8-5443-8212-3e2e2ffa7ee6" :step/math-academy-id 14673 :step/next {:db/id #edb/ref 17592186088510}} {:db/id #edb/ref 17592186088510 :step/content {:db/id #edb/ref 17592186087690 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087495 :question/id #uuid "ccf59ef2-a5dd-5a56-9af8-1878376dea16" :question/math-academy-id "e-4104"} :knowledge-point/id #uuid "765ef63a-e3f0-503b-876d-3b4776b2cafe" :knowledge-point/questions [{:db/id #edb/ref 17592186088254} {:db/id #edb/ref 17592186088264} {:db/id #edb/ref 17592186233646} {:db/id #edb/ref 17592186233696} {:db/id #edb/ref 17592186290441} {:db/id #edb/ref 17592186292617} {:db/id #edb/ref 17592186292618} {:db/id #edb/ref 17592186292619} {:db/id #edb/ref 17592186547080} {:db/id #edb/ref 17592186562427}] :knowledge-point/title "Finding Approximate Solutions to Exponential Equations Using the Natural Logarithm"} :step/id #uuid "81c5f02d-5078-5c6d-87e6-c8b57b026759" :step/math-academy-id 14675 :step/next {:db/id #edb/ref 17592186088511}} {:db/id #edb/ref 17592186088511 :step/content {:db/id #edb/ref 17592186087691 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087496 :question/id #uuid "12eedc57-11a6-540c-bdc9-bf5df777de60" :question/math-academy-id "e-4105"} :knowledge-point/id #uuid "10095048-0db6-5b4e-889f-303f07449367" :knowledge-point/questions [{:db/id #edb/ref 17592186088256} {:db/id #edb/ref 17592186088263} {:db/id #edb/ref 17592186233028} {:db/id #edb/ref 17592186234217} {:db/id #edb/ref 17592186234218} {:db/id #edb/ref 17592186247135} {:db/id #edb/ref 17592186292626} {:db/id #edb/ref 17592186292627} {:db/id #edb/ref 17592186292628} {:db/id #edb/ref 17592186335918} {:db/id #edb/ref 17592186547019}] :knowledge-point/title "Finding Solutions to Exponential Equations when Rearrangement is Required"} :step/id #uuid "f0ead52e-70c8-5090-85fd-195f595064bf" :step/math-academy-id 14676}] :activity/title "Solving Equations Containing the Exponential Function" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186087935}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186562557} :activity/id #uuid "bb2cc893-318b-5c46-9187-dc4662c5ec1c" :activity/scope {:db/id #edb/ref 17592186050649 :topic/id #uuid "5c4bc59d-ac0f-5225-a803-5b20b7524274" :topic/math-academy-id 870} :activity/steps [{:db/id #edb/ref 17592186562529 :step/content {:db/id #edb/ref 17592186233646 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52b6d851-07bf-50a6-ba74-60a93aaab1ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-0.527" :db/id #edb/ref 17592186232335}] :answer-field/correct {:db/id #edb/ref 17592186232335} :answer-field/id #uuid "80d6b8d0-cd10-519f-aa6e-beaba5dff6e6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186232334}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "37b84130-ad1d-51d8-b7bf-029b37f28c20" :question/math-academy-id "q-228899" :question/problem "If ${e}^{2x+3}=7,$ then $x≈${{field-1}}, rounded to $3$ decimal places." :question/worked-solution "First, we take $ln$ of both sides of the equation and solve for $x:$\n\n$$\n\\begin{aligned}{e}^{2x+3} & =7 \\\\ \\operatorname{ln}⁡({e}^{2x+3}) & =\\operatorname{ln}⁡(7) \\\\ 2x+3 & =\\operatorname{ln}⁡(7) \\\\ 2x & =\\operatorname{ln}⁡(7)-3 \\\\ x & =\\frac{\\operatorname{ln}⁡(7)-3}{2}\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nx≈-0.527\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "39f10d29-c503-5877-bdb9-888929fce129"} {:db/id #edb/ref 17592186562557 :step/content {:db/id #edb/ref 17592186088256 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a966bea-c2c7-552f-8b5b-fa831cc51613" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{7}{5}\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186561804} {:answer/id #uuid "83d81e6a-97cd-5d70-bf86-f4147a265d74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{7}\\operatorname{ln}⁡(4)" :db/id #edb/ref 17592186561913} {:answer/id #uuid "8f83f208-59ad-53c2-b961-74a5502985a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186561939} {:answer/id #uuid "e83c4852-1306-5f2d-9931-2c55058c46e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}\\operatorname{ln}⁡(7)" :db/id #edb/ref 17592186562155} {:answer/id #uuid "ea5b3a18-587d-588e-a8f2-045924faba19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186562167}] :answer-field/correct {:db/id #edb/ref 17592186562167} :answer-field/id #uuid "a6ea08e6-1bef-5ee9-8f14-f173d322f2e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186086190}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3d0d0e96-a523-5322-8133-5394507a5dd3" :question/math-academy-id "q-66604" :question/problem "Given that $-4{e}^{z}+7=5,$ then $z=$" :question/requires-calculator true :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}-4{e}^{z}+7 & =5 \\\\ -4{e}^{z} & =-2 \\\\ {e}^{z} & =\\frac{1}{2}\\end{aligned}\n$$\n\nThen, we find the natural logarithm $(ln)$ of both sides of the equation and solve for $z:$\n\n$$\n\\begin{aligned}{e}^{z} & =\\frac{1}{2} \\\\ \\operatorname{ln}⁡({e}^{z}) & =\\operatorname{ln}⁡(\\frac{1}{2}) \\\\ z & =-\\operatorname{ln}⁡(2)\\end{aligned}\n$$\n\nTherefore, the solution is $z=-\\operatorname{ln}⁡(2).$"} :step/id #uuid "893ce8ba-2439-5cf1-aec0-6855c2c81f6d" :step/next {:db/id #edb/ref 17592186562582}} {:db/id #edb/ref 17592186562582 :step/content {:db/id #edb/ref 17592186562427 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50094e0d-929c-58f0-8790-a6406f9ad6a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.110" :db/id #edb/ref 17592186561786} {:answer/id #uuid "670e1daf-3afb-59e1-9b42-ce9dff2c1033" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.011" :db/id #edb/ref 17592186561838} {:answer/id #uuid "7c320dc5-b88c-5faa-9a64-40fbe15a2db4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.107" :db/id #edb/ref 17592186561889} {:answer/id #uuid "99413ae4-eb90-54f6-8500-8a42fd390e61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.701" :db/id #edb/ref 17592186561963} {:answer/id #uuid "de1047ef-abb1-54f1-9a8b-9c9de60033b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.101" :db/id #edb/ref 17592186562135}] :answer-field/correct {:db/id #edb/ref 17592186562135} :answer-field/id #uuid "e976916e-93a3-584d-9937-d0ffaf77228b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186562372}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4010032d-a265-55ab-a980-12aa209eef4e" :question/math-academy-id "q-100285" :question/problem "Find the solution to the equation ${e}^{8x}=\\sqrt{5}$ rounded to $3$ decimal places." :question/worked-solution "First, we take $ln$ of both sides of the equation:\n\n$$\n\\begin{aligned}{e}^{8x} & =\\sqrt{5} \\\\ \\operatorname{ln}⁡({e}^{8x}) & =\\operatorname{ln}⁡(\\sqrt{5}) \\\\ 8x & =\\operatorname{ln}⁡({5}^{1/2})\\end{aligned}\n$$\n\nThen, we apply the power rule to the right-hand side and solve for $x$:\n\n$$\n\\begin{aligned}8x & =\\frac{1}{2}\\operatorname{ln}⁡(5) \\\\ x & =\\frac{1}{16}\\operatorname{ln}⁡(5)\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nx≈0.101\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "dc55817f-2a4e-5b97-8eb2-44246d45d570" :step/next {:db/id #edb/ref 17592186562529}}] :activity/title "Solving Equations Containing the Exponential Function" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186561574}]}
