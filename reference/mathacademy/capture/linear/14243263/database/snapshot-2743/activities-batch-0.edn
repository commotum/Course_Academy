2186541104}] :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors When the Denominator Has Complex Roots"} :step/id #uuid "46d199f3-c63f-504d-9563-18ec7b6371c8" :step/math-academy-id 464830}] :activity/title "Vertical Asymptotes of Rational Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186087895}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186541182} :activity/id #uuid "fc490cb4-41f1-58ce-80a7-4802442a64c4" :activity/scope {:db/id #edb/ref 17592186049363 :topic/id #uuid "eefd5285-6b99-569d-a5bb-365f176fa757" :topic/math-academy-id 807} :activity/steps [{:db/id #edb/ref 17592186541162 :step/content {:db/id #edb/ref 17592186541104 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08a7bfaf-f352-5f83-9833-9f14be0ae9bd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The function has no vertical asymptotes" :db/id #edb/ref 17592186540542} {:answer/id #uuid "51293c2d-b318-5b99-9ae4-5ebf29413921" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x=1$ only" :db/id #edb/ref 17592186540666} {:answer/id #uuid "73c848ac-5929-5be7-a1f7-bc2d63b16268" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x=-1$ only" :db/id #edb/ref 17592186540726} {:answer/id #uuid "ad9d5860-e760-5700-9aff-e93115166a53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=0,\\,x=1" :db/id #edb/ref 17592186540820} {:answer/id #uuid "dc1b2574-36d1-5554-90f6-4d4b1edb1776" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-1,\\,x=1" :db/id #edb/ref 17592186540903}] :answer-field/correct {:db/id #edb/ref 17592186540542} :answer-field/id #uuid "8422c58a-bb72-5552-8ac2-10a4a7678ba9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540997}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "781bab37-c587-565a-bce8-f5952a2abc55" :question/math-academy-id "q-80695" :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{x-1}{(x-1)({x}^{2}-x+1)}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{x-1}{(x-1)({x}^{2}-x+1)} \\\\  & =\\frac{\\cancel{x-1}}{\\cancel{(x-1)}({x}^{2}-x+1)} \\\\  & =\\frac{1}{{x}^{2}-x+1}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}-x+1=0\n$$\n\nThe last equation does not have any real solutions because the discriminant $D$ is negative:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(-1)^{2}-4(1)(1) \\\\  & =-3\\end{aligned}\n$$\n\nTherefore, $y=f(x)$ has no vertical asymptotes."} :step/id #uuid "166e71ed-29ee-50dc-b54b-0613a103566b"} {:db/id #edb/ref 17592186541182 :step/content {:db/id #edb/ref 17592186088187 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac7e8e9d-f212-5d13-a5be-734b534e5ef8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439795} {:answer/id #uuid "5ea5db37-0c6c-57f3-aa92-22d599e01482" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439796}] :answer-field/correct {:db/id #edb/ref 17592186439795} :answer-field/id #uuid "c3a10d88-9b25-5ba8-a920-18c9befa1b6e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440255} {:answer-field/choices [{:answer/id #uuid "24378b01-8101-5c88-a387-6a512efe0082" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439797} {:answer/id #uuid "2d02dfd9-1e6f-580a-9505-c1f8993a2089" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439798}] :answer-field/correct {:db/id #edb/ref 17592186439797} :answer-field/id #uuid "1163cfa2-ceb0-509e-b9b3-474f092a0cd7" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440256} {:answer-field/choices [{:answer/id #uuid "c76b53ff-046b-5caa-bb43-91ecb54d1fb2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439799} {:answer/id #uuid "8a1a8d07-8d18-5acf-8aad-f2d716a92199" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439800}] :answer-field/correct {:db/id #edb/ref 17592186439799} :answer-field/id #uuid "7ed1c692-891a-5c7c-ab31-5b579d7bc24f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440257}] :question/id #uuid "9804f06a-3a1e-50fe-a8f6-ab3f28486a47" :question/math-academy-id "q-4695" :question/problem "Determine the vertical asymptotes of the function $f(x) = \\frac{x^{2} - 1}{x^{3} - x^{2} + x - 1}$.\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $x=-1$\n- **II.** $x=0$\n- **III.** $x=1$" :question/worked-solution "After cancellation, $f(x)=\\frac{x + 1}{x^{2} + 1}$. Its real denominator zeros are $\\emptyset$; canceled factors produce holes, not vertical asymptotes."} :step/id #uuid "53a224c7-b29b-56f8-9951-a3cb256ba6c1" :step/next {:db/id #edb/ref 17592186541226}} {:db/id #edb/ref 17592186541226 :step/content {:db/id #edb/ref 17592186541119 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32cce2c2-d815-5331-a11b-0d19441db9b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=0,\\,x=3" :db/id #edb/ref 17592186540608} {:answer/id #uuid "418eab50-c9be-5bde-a643-625b2f0266a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-3,\\,x=3" :db/id #edb/ref 17592186540639} {:answer/id #uuid "473c7038-e652-54d5-ab9a-ae67ae6333ef" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x=3$ only" :db/id #edb/ref 17592186540653} {:answer/id #uuid "84c9e974-4825-5131-be89-35779e2c4e6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-3,\\,x=0,\\,x=3" :db/id #edb/ref 17592186540752} {:answer/id #uuid "cde31b8d-253e-5ef3-ab47-05524cfc02e5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x=-1$ only" :db/id #edb/ref 17592186540874}] :answer-field/correct {:db/id #edb/ref 17592186540653} :answer-field/id #uuid "f2c35c17-55da-5b77-8910-3e001dd2509d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186541047}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b35c6507-ab8b-56e8-83d7-4c48d4acc5bc" :question/math-academy-id "q-39806" :question/problem "Calculate the vertical asymptotes of $f(x)=\\frac{2{x}^{3}}{x(x-3)^{3}}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{2{x}^{3}}{x(x-3)^{3}} \\\\  & =\\frac{2x\\cdot {x}^{2}}{x(x-3)^{3}} \\\\  & =\\frac{2\\cancel{x}\\cdot {x}^{2}}{\\cancel{x}(x-3)^{3}} \\\\  & =\\frac{2{x}^{2}}{(x-3)^{3}}.\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero and solve for $x:$\n\n$$\n(x-3)^{3}=0\n$$\n\nThis gives the solution $x=3.$ Therefore, $x=3$ is the only vertical asymptote."} :step/id #uuid "ec1ae9bd-a8a1-5c93-817d-6fbe07478581" :step/next {:db/id #edb/ref 17592186541162}}] :activity/title "Vertical Asymptotes of Rational Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186540527}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186562567} :activity/id #uuid "1bc580bd-bab1-5252-8f89-1d6e091cb72a" :activity/scope {:db/id #edb/ref 17592186049363 :topic/id #uuid "eefd5285-6b99-569d-a5bb-365f176fa757" :topic/math-academy-id 807} :activity/steps [{:db/id #edb/ref 17592186562562 :step/content {:db/id #edb/ref 17592186562431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3090ddd4-ba21-512c-990d-4756a8244d20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-1,\\,x=1" :db/id #edb/ref 17592186561710} {:answer/id #uuid "35c729a0-c7ea-5011-a804-71e03289e149" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-1,\\,x=0" :db/id #edb/ref 17592186561721} {:answer/id #uuid "595a0126-8d7e-5b02-91aa-42e18d824bf2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x=1$ only" :db/id #edb/ref 17592186561803} {:answer/id #uuid "9a525491-4e0c-5dc0-b10d-ff5b7fcb4ad5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x=0$ only" :db/id #edb/ref 17592186561965} {:answer/id #uuid "aa864310-9250-5715-9a2f-b40402b5e93f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=0,\\,x=1" :db/id #edb/ref 17592186562008}] :answer-field/correct {:db/id #edb/ref 17592186561965} :answer-field/id #uuid "92a7d330-f172-52c6-b231-05809763df8c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186562320}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4c74e25d-895a-5838-9281-315f3c190014" :question/math-academy-id "q-80678" :question/problem "Calculate the vertical asymptotes of $f(x)=\\frac{x-1}{{x}^{3}-2{x}^{2}+3x}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{x-1}{{x}^{3}-2{x}^{2}+3x} \\\\  & =\\frac{x-1}{x({x}^{2}-2x+3)}.\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero. This gives\n\n$$\nx({x}^{2}-2x+3)=0.\n$$\n\nWe now solve the above equation using the zero product property:\n\n- Solving $x=0$ gives the solution $x=0.$\n\n- The equation ${x}^{2}-2x+3=0$ has no real solutions because the discriminant $D$ is negative:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(-2)^{2}-4(1)(3) \\\\  & =4-12 \\\\  & =-8\\end{aligned}\n$$\n\nTherefore, the only vertical asymptote is $x=0.$"} :step/id #uuid "a2df92f1-6772-5b52-800f-86871befecc4" :step/next {:db/id #edb/ref 17592186562579}} {:db/id #edb/ref 17592186562567 :step/content {:db/id #edb/ref 17592186402695 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b9b1cd4-2765-5911-bf4d-ab94fa28dffe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439745} {:answer/id #uuid "0205637e-c6c7-5efb-b969-574286186336" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439746}] :answer-field/correct {:db/id #edb/ref 17592186439745} :answer-field/id #uuid "701fd38d-2e9d-5fa9-8c52-97331a2dfb74" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440230} {:answer-field/choices [{:answer/id #uuid "96d20032-2a04-59d8-b369-c2bfeac9edd2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439747} {:answer/id #uuid "24389cce-7954-5559-8a48-cb113db6a3b4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439748}] :answer-field/correct {:db/id #edb/ref 17592186439747} :answer-field/id #uuid "46d0b0ba-2dd6-5782-b55b-cb34395d0dbb" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440231} {:answer-field/choices [{:answer/id #uuid "b282cc6e-6169-5ed9-a853-fb5f4099d1b0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439749} {:answer/id #uuid "cbe67003-c376-5e53-9dfd-0cfa311921d4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439750}] :answer-field/correct {:db/id #edb/ref 17592186439749} :answer-field/id #uuid "c72a2f69-f2cb-53c3-ba4e-785cc447b97f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440232} {:answer-field/choices [{:answer/id #uuid "d697ca92-f93c-5a09-a8a7-f68d5a89e7a2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439751} {:answer/id #uuid "de2f7cfa-4da2-5415-a70d-d30b77950777" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439752}] :answer-field/correct {:db/id #edb/ref 17592186439751} :answer-field/id #uuid "ec77f5ec-84e5-5013-a57b-41a9e6b810af" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440233} {:answer-field/choices [{:answer/id #uuid "fbe97263-3047-5bd8-9894-ead82588f849" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439753} {:answer/id #uuid "944b4a1e-c5b6-522f-a703-be8b22db86b5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439754}] :answer-field/correct {:db/id #edb/ref 17592186439753} :answer-field/id #uuid "9289e91e-6f0c-5a94-b1b0-b92d76ca8929" :answer-field/key "V" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440234}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "10e486fb-a153-567a-b122-83eab72817c1" :question/math-academy-id "q-39936" :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{{x}^{2}-1}{{x}^{4}-1}.$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $x=-1$\n- **II.** $x=- \\frac{1}{2}$\n- **III.** $x=0$\n- **IV.** $x=\\frac{1}{2}$\n- **V.** $x=1$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}-1}{{x}^{4}-1} \\\\  & =\\frac{{x}^{2}-1}{({x}^{2}-1)({x}^{2}+1)} \\\\  & =\\frac{(x-1)(x+1)}{(x-1)(x+1)({x}^{2}+1)} \\\\  & =\\frac{\\cancel{(x-1)(x+1)}}{\\cancel{(x-1)(x+1)}({x}^{2}+1)} \\\\  & =\\frac{1}{{x}^{2}+1}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}+1=0\n$$\n\nThis equation does not have any real solutions. Therefore, $f(x)$ has no vertical asymptotes."} :step/id #uuid "b4835b16-d349-509d-bcb0-57408b9982c7" :step/next {:db/id #edb/ref 17592186562562}} {:db/id #edb/ref 17592186562579 :step/content {:db/id #edb/ref 17592186292694 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d05da919-52fc-509f-a8f8-2528fc830fcf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186291517}] :answer-field/correct {:db/id #edb/ref 17592186291517} :answer-field/id #uuid "fd09b302-f2ca-548f-87d3-3d4055d98ae4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292519}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8b59dc04-b4de-517d-b908-41d7f801e2fd" :question/math-academy-id "q-270004" :question/problem "The vertical asymptote of $f(x)=\\frac{{x}^{2}-9}{2{x}^{3}-2}$ is $x=${{field-1}}." :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}-9}{2{x}^{3}-2} \\\\  & =\\frac{{x}^{2}-9}{2({x}^{3}-1)} \\\\  & =\\frac{{x}^{2}-{3}^{2}}{2({x}^{3}-{1}^{3})} \\\\  & =\\frac{(x-3)(x+3)}{2(x-1)({x}^{2}+x+1)}.\\end{aligned}\n$$\n\nNotice that we used the difference of cubes formula to factor the denominator.\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero. This gives\n\n$$\n(x-1)({x}^{2}+x+1)=0.\n$$\n\nWe now solve the above equation using the zero product property:\n\n- Solving $(x-1)=0$ gives the solution $x=1.$\n\n- The equation ${x}^{2}+x+1=0$ has no real solutions because the discriminant $D$ is negative:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & ={1}^{2}-4(1)(1) \\\\  & =1-4 \\\\  & =-3\\end{aligned}\n$$\n\nTherefore, the vertical asymptote is $x=1.$"} :step/id #uuid "d5ef6de6-3274-5f4e-8c11-7d506bd00ecb"}] :activity/title "Vertical Asymptotes of Rational Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186561563}]}
