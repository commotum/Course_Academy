#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186116396} :activity/id #uuid "3186d920-ff1f-5f36-a31d-2756c7f5f4f9" :activity/scope {:db/id #edb/ref 17592186048472 :topic/id #uuid "a26cd4f5-8420-5521-8401-af794c94636b" :topic/math-academy-id 1644} :activity/steps [{:db/id #edb/ref 17592186116268 :step/content {:db/id #edb/ref 17592186115336 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115160 :question/id #uuid "43c770ec-d353-5e9e-b44e-f06417dab2ab" :question/math-academy-id "e-9731"} :knowledge-point/id #uuid "6a916099-a237-5612-b7f1-3679b7ff069d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048723} {:db/id #edb/ref 17592186049949} {:db/id #edb/ref 17592186050410}] :knowledge-point/questions [{:db/id #edb/ref 17592186115491} {:db/id #edb/ref 17592186115655} {:db/id #edb/ref 17592186253502} {:db/id #edb/ref 17592186253503} {:db/id #edb/ref 17592186269004} {:db/id #edb/ref 17592186294980} {:db/id #edb/ref 17592186500347}] :knowledge-point/title "Calculating an Unknown Angle"} :step/id #uuid "9cedeba2-5a6c-5062-880b-beb7fa0aa70f" :step/math-academy-id 36502} {:db/id #edb/ref 17592186116396 :step/content {:db/id #edb/ref 17592186116449 :tutorial/content "Consider $\\triangle ABC$ shown below. \n\n![](images/6f/6fdb9a8337d16f1ef1910989b3df92844c5393c33108f98ae7993cc939bed0b3.png)\n\nNow, let's draw a line segment that \n\n- runs from $\\color{blue}C$ to the line ${\\color{red}\\overset{\\longleftrightarrow}{AB}},$ and\n\n- is *perpendicular* to ${\\color{red}\\overset{\\longleftrightarrow}{AB}}.$\n\nThis line segment is the dashed segment shown below:\n\n![](images/4a/4a7ee2771c9b0c60dbb07c43b0439e822ea9b2c261ac41af9b44fec72b9f2a91.png)\n\nFinally, let's label the other endpoint of our segment ${\\color{blue}{H}}.$\n\n![](images/75/758eab533719220515460b6677054438a9ac0e2701d1a5267b973e526f63bd90.png)\n\nNote the following:\n\n- The line segment ${\\color{blue}\\overline{CH}}$ is called the **height** (or **altitude**) *corresponding to* ${\\color{red}\\overset{\\longleftrightarrow}{AB}}.$\n\n- The line $\\overset{\\longleftrightarrow}{AB}$ is called the **base** of the altitude ${\\color{blue}\\overline{CH}}.$\n\nAs we'll soon discover, the heights and their corresponding bases are important attributes of triangles." :tutorial/id #uuid "bdb9bfbd-b830-51f0-8712-5d34f83f2812" :tutorial/math-academy-id 2232 :tutorial/title "Introduction"} :step/id #uuid "4231f520-72fe-5c14-8733-25cc76a6e65e" :step/math-academy-id 9151 :step/next {:db/id #edb/ref 17592186116397}} {:db/id #edb/ref 17592186116397 :step/content {:db/id #edb/ref 17592186115409 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114985 :question/id #uuid "972fe403-9a15-5d10-8f9f-f5c93eb586ff" :question/math-academy-id "e-2725"} :knowledge-point/id #uuid "f7e817a0-edcf-54ca-ba4c-ffe91af04675" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050357}] :knowledge-point/questions [{:db/id #edb/ref 17592186115646} {:db/id #edb/ref 17592186115952} {:db/id #edb/ref 17592186253495} {:db/id #edb/ref 17592186253496} {:db/id #edb/ref 17592186294864} {:db/id #edb/ref 17592186386882} {:db/id #edb/ref 17592186393737} {:db/id #edb/ref 17592186500371}] :knowledge-point/title "Finding a Height of a Triangle"} :step/id #uuid "52e4c58c-e58e-5223-98e5-cc31383de47c" :step/math-academy-id 9154 :step/next {:db/id #edb/ref 17592186116398}} {:db/id #edb/ref 17592186116398 :step/content {:db/id #edb/ref 17592186116450 :tutorial/content "We can draw exactly three heights (or altitudes) in any triangle. However, sometimes the height lies outside the triangle.\n\nTo demonstrate, consider $\\triangle{ABC}$ below.\n\n![](images/df/df1ac2c1074305f8ead506d9aeb8c3927ad51ae5949b45976f1971b52d402ee5.png)\n\nThe height corresponding to $\\overline{BC}$ is a line segment that \n\n- runs from the opposite vertex $A$ to the line $\\overset{\\longleftrightarrow}{BC},$ and\n\n- is perpendicular to $\\overset{\\longleftrightarrow}{BC}.$\n\nIn this case, it's impossible to draw a perpendicular from $A$ to the *segment* $\\overline{BC}.$ However, we can first *extend* the line segment $\\overline{BC}$ as follows:\n\n![](images/26/26bf9eb8af1e9b71c263c08cae5797d5c911410985cdc01213ac2c295f7b8d46.png)\n\nNow, we draw the perpendicular from $A$ to $\\overset{\\longleftrightarrow}{BC}.$ This gives the height $\\overline{AH}{:}$\n\n![](images/89/894686fce1393ebcf998be6885020627c9f3cde5916adfec67234f15f8895826.png)" :tutorial/id #uuid "4031d801-f4b8-543f-ad4d-9ef60d513427" :tutorial/math-academy-id 2236 :tutorial/title "Case of Extended Bases"} :step/id #uuid "b9f034d0-1d0e-54ea-83b8-ad683048d5c5" :step/math-academy-id 9158 :step/next {:db/id #edb/ref 17592186116399}} {:db/id #edb/ref 17592186116399 :step/content {:db/id #edb/ref 17592186115410 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114986 :question/id #uuid "2e6213d0-702f-5795-a99a-0051790c4e6d" :question/math-academy-id "e-2730"} :knowledge-point/id #uuid "6a76efbd-cefd-5aa0-953e-8ab50bec7ae0" :knowledge-point/questions [{:db/id #edb/ref 17592186115647} {:db/id #edb/ref 17592186115648} {:db/id #edb/ref 17592186253497} {:db/id #edb/ref 17592186335937} {:db/id #edb/ref 17592186392742} {:db/id #edb/ref 17592186392952} {:db/id #edb/ref 17592186500367} {:db/id #edb/ref 17592186564510} {:db/id #edb/ref 17592186564516}] :knowledge-point/title "Finding a Height Corresponding to an Extended Base"} :step/id #uuid "25c91feb-798e-5857-9090-3b36088bc71b" :step/math-academy-id 9160 :step/next {:db/id #edb/ref 17592186116268}}] :activity/title "Heights of Triangles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115444}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186564569} :activity/id #uuid "b344a744-3440-50e5-9d6c-33f6246db0c2" :activity/scope {:db/id #edb/ref 17592186048472 :topic/id #uuid "a26cd4f5-8420-5521-8401-af794c94636b" :topic/math-academy-id 1644} :activity/steps [{:db/id #edb/ref 17592186564569 :step/content {:db/id #edb/ref 17592186294980 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "250975f6-1855-51d4-855b-4756eab86379" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186293090} {:answer/id #uuid "74682fc2-217c-57f5-ab98-c931310e5466" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{18}^{∘}" :db/id #edb/ref 17592186293411} {:answer/id #uuid "7d0ac39b-3059-5c95-9035-fede9601ced2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{15}^{∘}" :db/id #edb/ref 17592186293433} {:answer/id #uuid "c8f82474-ac34-5dcf-9935-8a82efc05435" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{20}^{∘}" :db/id #edb/ref 17592186293712} {:answer/id #uuid "e390ae5f-9602-5bc0-bd7b-333ec91cd6ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{25}^{∘}" :db/id #edb/ref 17592186293825}] :answer-field/correct {:db/id #edb/ref 17592186293712} :answer-field/id #uuid "5dff0f5f-38be-5491-8c48-4be6dc5f48b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186294264}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "94753d7f-95e4-5b39-9c21-ede7ecea7547" :question/math-academy-id "q-27832" :question/problem "![](images/66/6665784a8ce048fd26fbd97038346e8e6fdf6800d645ea0488f1c18986f5864b.png)\n\nConsider the triangle $△ABC$ shown above. The line segment $\\overset{―}{CH}$ is the altitude corresponding to $\\overset{―}{AB}.$ If $m∠BAC={110}^{∘},$ calculate $m∠HCA.$" :question/worked-solution "Since the straight angle must have a measure of ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠HAC+m∠BAC & ={180}^{∘} \\\\ m∠HAC+{110}^{∘} & ={180}^{∘} \\\\ m∠HAC & ={70}^{∘}.\\end{aligned}\n$$\n\nNote that $△ACH$ is a right triangle. Since its interior angles must sum to ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠HCA+m∠HAC+m∠AHC & ={180}^{∘} \\\\ m∠HCA+{70}^{∘}+{90}^{∘} & ={180}^{∘} \\\\ m∠HCA+{160}^{∘} & ={180}^{∘} \\\\ m∠HCA & ={20}^{∘}.\\end{aligned}\n$$"} :step/id #uuid "85fdfdf6-5023-58b6-a609-0e7f25680884" :step/next {:db/id #edb/ref 17592186564593}} {:db/id #edb/ref 17592186564579 :step/content {:db/id #edb/ref 17592186564516 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c137d98-33bd-5cfc-8f63-359ad6471b1e" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/0b/0bc641736877902ac9272906ed276d36d475ef8060c3c00f0814d9881c3a2153.png" :db/id #edb/ref 17592186564157} {:answer/id #uuid "aead06b8-c27b-5d22-b1e5-e50e94418aa7" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b0/b06b43ef5a57621be16e22eeaf3e60f76fc9203752af363ada5e6ab5081cfa19.png" :db/id #edb/ref 17592186564237} {:answer/id #uuid "af7cf62f-39bf-5878-a434-74498dd8362d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/d5/d5cd2b3c3dbc4a9231a8738bea83a51bb731e94ef971864ac9174edcc7f1a3ba.png" :db/id #edb/ref 17592186564240} {:answer/id #uuid "c9c9dd0c-f5d7-5a25-8f7a-404b4d4b1521" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/2e/2e48106e4aedb44faef00060f6af9632bd0c8e62eb8d06f12606c2a476bacac3.png" :db/id #edb/ref 17592186564284} {:answer/id #uuid "e7e35b9d-a5b5-58b5-ad4a-c12b98096c07" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/c7/c7b37d825464a35ef515d3cd7ce388025a1c93e07ae80246344d4785360d5d9e.png" :db/id #edb/ref 17592186564333}] :answer-field/correct {:db/id #edb/ref 17592186564284} :answer-field/id #uuid "678739dc-dd99-5411-8aaf-f8c9ecc011df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186564406}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a800f321-defb-572d-a55b-71be8add2663" :question/math-academy-id "q-118707" :question/problem "![](images/81/812bde152b84abaf518f6e9b09c43824786c724eac768d83e4d53615d69e1693.png)\n\nGiven $△PQR$ shown above, which of the following diagrams represents the height corresponding to $\\overset{―}{PQ}?$" :question/worked-solution "The height (or altitude) corresponding to $\\overset{―}{PQ}$ is a line segment that \n\n- runs from the opposite vertex $R$ to the line $\\overset{⟷}{PQ},$ and\n\n- is perpendicular to $\\overset{⟷}{PQ}.$\n\nTo draw the height, we proceed as follows:\n\n- Extend the line segment $\\overset{―}{PQ}.$\n\n![](images/26/265ee40283911b754264224b3b0f349b24cae377373941304865b336a53c7b8e.png)\n\n- Draw the perpendicular from $R$ to $\\overset{⟷}{PQ}.$\n\n![](images/2e/2e48106e4aedb44faef00060f6af9632bd0c8e62eb8d06f12606c2a476bacac3.png)"} :step/id #uuid "af027b92-4026-580f-8e12-1889fa5766ab"} {:db/id #edb/ref 17592186564593 :step/content {:db/id #edb/ref 17592186564510 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09d7bbb4-3bc2-51db-bc57-a7edc95b5b12" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/aa/aa3254d24cd0d21a8a78009c8c07591e34ab46fa0449fc27e179d5a32ac70a17.png" :db/id #edb/ref 17592186563984} {:answer/id #uuid "749fefbd-6ad9-5a5f-8a13-394b61b686ee" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/83/832934fe55d335ac380a03c3baf8e9aaf08127349b1fdb42d20bb990a8416674.png" :db/id #edb/ref 17592186564144} {:answer/id #uuid "bf16add8-dafb-5323-b37a-182bc79bf8e8" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b9/b96c5fd6b4bce6744402275432a85e8ee4c31f32fd2f5dbfde593626e5bbff3a.png" :db/id #edb/ref 17592186564261} {:answer/id #uuid "c4ee513f-9682-5bc9-85b8-9ce4afe58e11" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/6d/6db153bb43ae3a25eecb7f9dad30b5631137ca81b51480c72d4228d0a7b007bb.png" :db/id #edb/ref 17592186564273} {:answer/id #uuid "e22f0b89-ef15-50d8-9928-9838ddb470b7" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/01/01a61d38b1586958f887a12389d435faa70fc0988616e3dc4304860f49e96919.png" :db/id #edb/ref 17592186564324}] :a