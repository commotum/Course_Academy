6045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253197}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cb784875-1e4e-5fb7-a306-93faadab9fdf" :question/math-academy-id "q-118711" :question/problem "![](images/8f/8faa4d9c078379aa0a74ab25ff235c68cce809c532a0ad38bfb14c045b4fd877.png)\n\nGiven $△JKL$ shown above, which of the following diagrams represents the height corresponding to $\\overset{―}{KL}?$" :question/worked-solution "The height (or altitude) corresponding to $\\overset{―}{KL}$ is a line segment that \n\n- runs from the opposite vertex $J$ to the line $\\overset{⟷}{KL},$ and\n\n- is perpendicular to $\\overset{⟷}{KL}.$\n\nTo draw the height, we proceed as follows:\n\n- Extend the line segment $\\overset{―}{KL}.$\n\n![](images/8f/8fa817d73f39106248403b6690757a701b2bdaf6e1b189a46572201d36f64554.png)\n\n- Draw the perpendicular from $J$ to $\\overset{⟷}{KL}.$\n\n![](images/73/737e030ba35f922fc67ed421bec7c072e5d2b6b2d1fda11d2f081453b541d4a8.png)"}] [{:db/id #edb/ref 17592186115655 :knowledge-point/_questions [{:db/id #edb/ref 17592186115336 :knowledge-point/id #uuid "6a916099-a237-5612-b7f1-3679b7ff069d" :knowledge-point/title "Calculating an Unknown Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c961a7c-022a-5c1a-be65-195e699992e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{35}^{∘}" :db/id #edb/ref 17592186292985} {:answer/id #uuid "14d56cac-ed17-5710-841c-febbaf99df41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186293018} {:answer/id #uuid "1c85e6c0-f9c5-59fd-82f4-b7d8d7bfef47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186293050} {:answer/id #uuid "b1627ee8-4d51-52a6-8929-c4107d5d9df6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{40}^{∘}" :db/id #edb/ref 17592186293626} {:answer/id #uuid "b7d4b089-0b2e-50ee-85b5-fddac40bfb50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{37}^{∘}" :db/id #edb/ref 17592186293649}] :answer-field/correct {:answer/id #uuid "0c961a7c-022a-5c1a-be65-195e699992e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{35}^{∘}" :db/id #edb/ref 17592186292985} :answer-field/id #uuid "4393158b-4653-59fb-b173-c91805421904" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294165}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a35f6859-2f6e-53eb-b636-6ed7f822bc20" :question/math-academy-id "q-27826" :question/problem "![](images/81/812e1c08b671e54023a65dc5b9fbf089ddd27781ad555d6fb9e4d2a9816d193f.png)\n\nConsider the triangle $△ABC$ shown above. The line segment $\\overset{―}{AH}$ is the altitude corresponding to $\\overset{―}{BC}.$ If $m∠ACB={125}^{∘},$ calculate $m∠HAC.$" :question/worked-solution "Since the straight angle must have a measure of ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠HCA+m∠ACB & ={180}^{∘} \\\\ m∠HCA+{125}^{∘} & ={180}^{∘} \\\\ m∠HCA & ={55}^{∘}.\\end{aligned}\n$$\n\nNote that $△AHC$ is a right triangle. Since its interior angles must sum to ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠HCA+m∠HAC+m∠AHC & ={180}^{∘} \\\\ {55}^{∘}+m∠HAC+{90}^{∘} & ={180}^{∘} \\\\ m∠HAC+{145}^{∘} & ={180}^{∘} \\\\ m∠HAC & ={35}^{∘}.\\end{aligned}\n$$"}]}
