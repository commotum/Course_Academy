#{[{:db/id #edb/ref 17592186192581 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186192627 :knowledge-point/id #uuid "90cbd355-34ae-5c9a-aba6-3351c09933e2" :knowledge-point/title "Converting Inequalities to Left-Bounded Intervals"}] :question/id #uuid "e6c81f79-c86d-5964-8b88-5bfa3f489d75" :question/math-academy-id "e-13937" :question/problem "Express the inequality $x \\geq 1$ in interval notation." :question/worked-solution "The inequality $x \\geq 1$ corresponds to all numbers greater than or equal to $1.$ A number line for this inequality is shown below:\n\n![](images/82/829c0bd7c365ef7e5b1d3bee70a632b34cd644349a7528b688abdfd57575a1ab.png)\n\nFrom the segment on the number line, we have the following:\n\n- The left endpoint $1$ *is* included in the interval.\n\n- There is no right endpoint - it continues forever. So, we write the interval with infinity as the right endpoint, not included.\n\nTherefore, using interval notation, we represent $x \\geq 1$ as\n\n$$\nx \\in [1,\\infty).\n$$"}] [{:db/id #edb/ref 17592186192582 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186192628 :knowledge-point/id #uuid "b8faaee6-bcba-508b-bd4c-51f0add67fa1" :knowledge-point/title "Converting Left-Bounded Intervals to Inequalities"}] :question/id #uuid "16206aac-d66a-5473-b49d-36b688ddf73e" :question/math-academy-id "e-13940" :question/problem "What inequality corresponds the interval $x\\in\\left[5, \\infty\\right)?$" :question/worked-solution "The statement $x\\in\\left[5, \\infty\\right)$ means that $x$ lies between $5$ and $\\infty,$ where \n\n- the left endpoint $5$ *is* included, and\n\n- the right endpoint $\\infty$ is *not* included.\n\nTherefore, the inequality represented by this interval is \n\n$$\n5 \\leq   x <     \\infty.\n$$\n\nHowever, since all numbers are smaller than infinity, it suffices to write \n\n$$\n5 \\leq   x\n$$\n\nor, equivalently, \n\n$$\nx \\geq 5.\n$$"}] [{:db/id #edb/ref 17592186192583 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186192629 :knowledge-point/id #uuid "a9534b7a-2c3b-5b8d-a22b-6ab928b7b268" :knowledge-point/title "Converting Inequalities to Right-Bounded Intervals"}] :question/id #uuid "9c9186ce-dd3e-544a-a76e-626e0667b5b9" :question/math-academy-id "e-13944" :question/problem "Express the inequality $x \\le 1$ in interval notation." :question/worked-solution "The inequality $x \\leq 1$ corresponds to all numbers less than or equal to $1.$ A number line for this interval is shown below:\n\n![](images/b5/b506caa666e4715b3f153459b8ec7f650ff53e97401ec9887fe6c294fb680887.png)\n\nFrom the segment on the number line, we have the following:\n\n- There is no left endpoint - it continues forever. So, we write the interval with negative infinity as the left endpoint, not included.\n\n- The right endpoint $1$ *is* included in the interval.\n\nTherefore, using interval notation, we represent $x \\leq 1$ as\n\n$$\nx\\in(-\\infty, 1].\n$$"}] [{:db/id #edb/ref 17592186192584 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186192630 :knowledge-point/id #uuid "51d228cc-574d-5436-9542-24b5fbb6fba4" :knowledge-point/title "Converting Right-Bounded Intervals to Inequalities"}] :question/id #uuid "5ede0c02-193c-57ee-96d4-77bab7a74b19" :question/math-academy-id "e-13947" :question/problem "What inequality corresponds to the interval $x\\in\\left(-\\infty, 9\\right)?$" :question/worked-solution "The statement $x \\in \\left(-\\infty, 9\\right)$ means that $x$ lies between $-\\infty$ and $9,$ where \n\n- the left endpoint $-\\infty$ is *not* included, and\n\n- the right endpoint $9$ is *not* included.\n\nTherefore, the inequality represented by this interval is \n\n$$\n-\\infty <   x <   9.\n$$\n\nHowever, since all numbers are greater than negative infinity, it suffices to write \n\n$$\nx <   9.\n$$"}] [{:db/id #edb/ref 17592186504605 :knowledge-point/_questions [{:db/id #edb/ref 17592186192629 :knowledge-point/id #uuid "a9534b7a-2c3b-5b8d-a22b-6ab928b7b268" :knowledge-point/title "Converting Inequalities to Right-Bounded Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51cd4b43-3511-5e00-816b-32a834a207e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,5)" :db/id #edb/ref 17592186504180} {:answer/id #uuid "7cb73b16-271e-54c3-bcdf-c7e3667c51c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [4,\\infty )" :db/id #edb/ref 17592186504251} {:answer/id #uuid "b5263679-8ad7-594f-bf49-0f3557b68c74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [5,\\infty )" :db/id #edb/ref 17592186504344} {:answer/id #uuid "f3196173-b085-58b4-b56d-8f7b7b30e72a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,5]" :db/id #edb/ref 17592186504453} {:answer/id #uuid "fd249a90-649d-5cc0-a33c-217f34c342d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-5)" :db/id #edb/ref 17592186504474}] :answer-field/correct {:answer/id #uuid "51cd4b43-3511-5e00-816b-32a834a207e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,5)" :db/id #edb/ref 17592186504180} :answer-field/id #uuid "89e0b9d8-8cbb-552b-9d87-a0cb5ffd887a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504542}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0b34c9dd-15c6-517b-a545-622b3797f82a" :question/math-academy-id "q-1240" :question/problem "The inequality $x<5$ can be expressed in interval notation as" :question/worked-solution "The inequality $x<5$ corresponds to all numbers less than $5.$ A number line for this interval is shown below:\n\n$$\n\n$$\n\n![](images/61/61a3fcdcc19f822c0d94b806441ea2888dab3bb9ac0b846c965a8fe23ad078ae.png)\n\n$$\n\n$$\n\nFrom the segment on the number line, we have the following:\n\n- There is no left endpoint - it continues forever. So, we write the interval with negative infinity as the left endpoint, not included.\n\n- The right endpoint $5$ is *not* included in the interval.\n\nTherefore, using interval notation, we represent $x<5$ as\n\n$$\nx\\in (-\\infty ,5).\n$$"}] [{:db/id #edb/ref 17592186192953 :knowledge-point/_questions [{:db/id #edb/ref 17592186192629 :knowledge-point/id #uuid "a9534b7a-2c3b-5b8d-a22b-6ab928b7b268" :knowledge-point/title "Converting Inequalities to Right-Bounded Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09698758-15fa-5097-b3c4-eadafb6bb51e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-7,\\infty )" :db/id #edb/ref 17592186504050} {:answer/id #uuid "0b0af212-881a-5cd1-b5a5-a5f841e92e0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-7)" :db/id #edb/ref 17592186504053} {:answer/id #uuid "10c327ba-b932-5721-924f-a6edf38cc480" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [7,\\infty )" :db/id #edb/ref 17592186504062} {:answer/id #uuid "b01ef1d0-b5dd-5247-a394-7b27a327315e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-7,\\infty )" :db/id #edb/ref 17592186504336} {:answer/id #uuid "eaee6b7d-9e88-5cdb-94e6-4ed8e320fb7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-7]" :db/id #edb/ref 17592186504440}] :answer-field/correct {:answer/id #uuid "0b0af212-881a-5cd1-b5a5-a5f841e92e0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-7)" :db/id #edb/ref 17592186504053} :answer-field/id #uuid "b3e24798-ddae-5831-867f-7145c0a63d64" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186189604}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8ef3c4ea-a031-5477-bdfa-9d17b8ca3563" :question/math-academy-id "q-1241" :question/problem "The inequality $x<-7$ can be expressed in interval notation as" :question/worked-solution "The inequality $x<-7$ corresponds to all numbers less than $-7.$ A number line for this interval is shown below:\n\n$$\n\n$$\n\n![](images/30/309a19968d017e575543f8165405dea2fe102a2d9a10d575ecf1cead17d36e07.png)\n\n$$\n\n$$\n\nFrom the segment on the number line, we have the following:\n\n- There is no left endpoint - it continues forever. So, we write the interval with negative infinity as the left endpoint, not included.\n\n- The right endpoint $-7$ is *not* included in the interval.\n\nTherefore, using interval notation, we represent $x<-7$ as\n\n$$\nx\\in (-\\infty ,-7).\n$$"}] [{:db/id #edb/ref 17592186504660 :knowledge-point/_questions [{:db/id #edb/ref 17592186192627 :knowledge-point/id #uuid "90cbd355-34ae-5c9a-aba6-3351c09933e2" :knowledge-point/title "Converting Inequalities to Left-Bounded Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2836bee1-61a1-5fc8-ba92-bc0be5cbfe08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,\\frac{1}{2})" :db/id #edb/ref 17592186504103} {:answer/id #uuid "74d28b52-4f8f-5e13-bb4b-1c8a42a0f5c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (\\frac{1}{2},\\infty )" :db/id #edb/ref 17592186504232} {:answer/id #uuid "7c374a01-55de-5d00-a12e-1da7b17e670f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,\\frac{1}{2}]" :db/id #edb/ref 17592186504248} {:answer/id #uuid "d49907ba-9747-5982-b921-a1b7f419a0c2" :answer/ty