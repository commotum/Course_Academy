 [{:answer-field/choices [{:answer/id #uuid "8ef8e188-7649-5fc9-a35b-5dbd23ec1f3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 14" :db/id #edb/ref 17592186504284} {:answer/id #uuid "d0b406c4-a406-5db4-b387-69b7378a24ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>-14" :db/id #edb/ref 17592186504388} {:answer/id #uuid "d2510ac9-9ed4-5e30-9064-f40cddb3f292" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>14" :db/id #edb/ref 17592186504389} {:answer/id #uuid "d731faec-e77b-53d8-a3de-ea6d54a26534" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<-14" :db/id #edb/ref 17592186504408} {:answer/id #uuid "eaa2db69-bf7c-5800-9eda-c91d8ba24118" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le -14" :db/id #edb/ref 17592186504439}] :answer-field/correct {:answer/id #uuid "d0b406c4-a406-5db4-b387-69b7378a24ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>-14" :db/id #edb/ref 17592186504388} :answer-field/id #uuid "1fc90c65-a21a-5b64-98e0-57d3a49e45bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504492}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "05484b4a-57a2-55c2-9049-f423ce09e86a" :question/math-academy-id "q-154781" :question/problem "The interval $x\\in (-14,\\infty )$ corresponds to the inequality" :question/worked-solution "The statement $x\\in (-14,\\infty )$ means that $x$ lies between $-14$ and $\\infty ,$ where \n\n- the left endpoint $-14$ is *not* included, and\n\n- the right endpoint $\\infty $ is *not* included.\n\nTherefore, the inequality represented by this interval is \n\n$$\n-14<x<\\infty .\n$$\n\nHowever, since all numbers are smaller than infinity, it suffices to write \n\n$$\n-14<x\n$$\n\nor, equivalently, \n\n$$\nx>-14.\n$$"}] [{:db/id #edb/ref 17592186504640 :knowledge-point/_questions [{:db/id #edb/ref 17592186192630 :knowledge-point/id #uuid "51d228cc-574d-5436-9542-24b5fbb6fba4" :knowledge-point/title "Converting Right-Bounded Intervals to Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50cdcef6-9c18-58ca-95d8-1aabfed4067b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 7" :db/id #edb/ref 17592186504178} {:answer/id #uuid "7bb20d81-b551-56ae-b425-39c6bd43e715" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>-7" :db/id #edb/ref 17592186504247} {:answer/id #uuid "912382eb-e86d-53d1-a4f9-37de67d559dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le -7" :db/id #edb/ref 17592186504289} {:answer/id #uuid "ba6abd59-760c-5139-8f9d-3e2306642a11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<-7" :db/id #edb/ref 17592186504354} {:answer/id #uuid "cf64deaf-eb4c-5e28-a5cb-c0d8a5ca27d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<7" :db/id #edb/ref 17592186504387}] :answer-field/correct {:answer/id #uuid "ba6abd59-760c-5139-8f9d-3e2306642a11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<-7" :db/id #edb/ref 17592186504354} :answer-field/id #uuid "17aef558-2ba7-5da3-b0f3-5fde99d8b14a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504487}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6d843358-b3f1-509e-8689-eba95475d008" :question/math-academy-id "q-154786" :question/problem "The interval notation  $x\\in (-\\infty ,-7)$ corresponds to the inequality" :question/worked-solution "The statement $x\\in (-\\infty ,-7)$ means that $x$ lies between $-\\infty $ and $-7,$ where \n\n- the left endpoint $-\\infty $ is *not* included, and\n\n- the right endpoint $-7$ is *not* included.\n\nTherefore, the inequality represented by this interval is \n\n$$\n-\\infty <x<-7.\n$$\n\nHowever, since all numbers are greater than negative infinity, it suffices to write \n\n$$\nx<-7.\n$$"}] [{:db/id #edb/ref 17592186504649 :knowledge-point/_questions [{:db/id #edb/ref 17592186192627 :knowledge-point/id #uuid "90cbd355-34ae-5c9a-aba6-3351c09933e2" :knowledge-point/title "Converting Inequalities to Left-Bounded Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d3bbadf-ccc2-5300-a850-1769ba55c0c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z\\in [-\\frac{1}{2},\\infty )" :db/id #edb/ref 17592186504111} {:answer/id #uuid "60dc9639-01b6-5701-9994-8446bedf174e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z\\in (-\\infty ,-\\frac{1}{2})" :db/id #edb/ref 17592186504201} {:answer/id #uuid "622bb683-ec82-5c0d-a0a5-fb8a28e07527" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z\\in (-\\infty ,-\\frac{1}{2}]" :db/id #edb/ref 17592186504202} {:answer/id #uuid "796451a9-5be4-5106-ac4f-9a37718c86dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z\\in (\\frac{1}{2},\\infty )" :db/id #edb/ref 17592186504240} {:answer/id #uuid "8b68d747-fa45-5571-8c8e-b2aa6696eb01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z\\in (-\\frac{1}{2},\\infty )" :db/id #edb/ref 17592186504276}] :answer-field/correct {:answer/id #uuid "8b68d747-fa45-5571-8c8e-b2aa6696eb01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z\\in (-\\frac{1}{2},\\infty )" :db/id #edb/ref 17592186504276} :answer-field/id #uuid "63c647a9-6d08-512a-a32d-8a217a8878e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504519}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8301710f-dfbb-5680-866d-b67f486e14d7" :question/math-academy-id "q-154802" :question/problem "The inequality $z>-\\frac{1}{2}$ can be expressed in interval notation as" :question/worked-solution "The inequality $z>-\\frac{1}{2}$ corresponds to all numbers greater than $-\\frac{1}{2}.$ A number line for this inequality is shown below:\n\n$$\n\n$$\n\n![](images/9d/9d43b5c54e0beb341f682f44ee4c6d42821a93d45e7d5f0c5576c13e69bff903.png)\n\n \n\n$$\n\n$$\n\nFrom the segment on the number line, we have the following:\n\n- The left endpoint $-\\frac{1}{2}$ is *not* included in the interval.\n\n- There is no right endpoint - it continues forever. So, we write the interval with infinity as the right endpoint, not included.\n\nTherefore, using interval notation, we represent $z>-\\frac{1}{2}$ as\n\n$$\nz\\in (-\\frac{1}{2},\\infty ).\n$$"}] [{:db/id #edb/ref 17592186504697 :knowledge-point/_questions [{:db/id #edb/ref 17592186192628 :knowledge-point/id #uuid "b8faaee6-bcba-508b-bd4c-51f0add67fa1" :knowledge-point/title "Converting Left-Bounded Intervals to Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2964d5b2-bd8c-5c98-9c4c-490a1173865c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\ge -16" :db/id #edb/ref 17592186504106} {:answer/id #uuid "8e8566df-8e2b-5644-ba47-ec91b900128a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\le -16" :db/id #edb/ref 17592186504282} {:answer/id #uuid "9507964e-3f84-5253-9f9e-29b549ddc86c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\ge 16" :db/id #edb/ref 17592186504297} {:answer/id #uuid "ce76174c-29fb-522e-a139-92eefdfb2052" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y>16" :db/id #edb/ref 17592186504383} {:answer/id #uuid "fa29b4a0-7a98-51d3-baa8-b0ab054901e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y<-16" :db/id #edb/ref 17592186504471}] :answer-field/correct {:answer/id #uuid "2964d5b2-bd8c-5c98-9c4c-490a1173865c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\ge -16" :db/id #edb/ref 17592186504106} :answer-field/id #uuid "83bd5374-0a8c-5016-b5fe-ae14e18a0a1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504538}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "df8b3cd8-e582-5e68-8862-832cf8d8a7f7" :question/math-academy-id "q-154829" :question/problem "The interval $y\\in [-16,\\infty )$ corresponds to the inequality" :question/worked-solution "The statement $y\\in [-16,\\infty )$ means that $y$ lies between $-16$ and $\\infty ,$ where \n\n- the left endpoint $-16$ *is* included, and\n\n- the right endpoint $\\infty $ is *not* included.\n\nTherefore, the inequality represented by this interval is \n\n$$\n-16\\le y<\\infty .\n$$\n\nHowever, since all numbers are smaller than infinity, it suffices to write \n\n$$\n-16\\le y\n$$\n\nor, equivalently, \n\n$$\ny\\ge -16.\n$$"}] [{:db/id #edb/ref 17592186504681 :knowledge-point/_questions [{:db/id #edb/ref 17592186192630 :knowledge-point/id #uuid "51d228cc-574d-5436-9542-24b5fbb6fba4" :knowledge-point/title "Converting Right-Bounded Intervals to Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1888e81b-f614-5546-8c11-7635a8224be9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z>-26" :db/id #edb/ref 17592186504075} {:answer/id #uuid "656ea7f7-3c61-5faa-93ad-46692819ed68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z<26" :db/id #edb/ref 17592186504206} {:answer/id #uuid "7864bf86-223e-51f0-80d1-c81f8bd370c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z\\ge 26" :db/id #edb/ref 17592186504237} {:answer/id #uuid "b9196218-43f4-5c68-896d-8447f41b509b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z\\le -26" :db/id #edb/ref 17592186504353} {:answer/id #uuid "f22378b9-da0d-5ab4-b419-9b37bf967204" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z\\le 26" :db/id #edb/ref 17592186504451}] :answer-field/correct {:answer/id #uuid "f22378b9-da0d-5ab4-b419-9b37bf967204" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z\\le 26" :db/id #edb/ref 17592186504451} :answer-field/id #uuid "c61d95f8-ddcc-5e61-a389-2bf5488d153d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504573}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ca3bed50-c15f-520c-b7d3-e53cd1fcae8f" :question/math-academy-id "q-154838" :question/problem "The interval notation $z\\in (-\\infty ,26]$ corresponds to the inequality" :question/worked-solution "The statement $z\\in (-\\infty ,26]$ means that $z$ lies between $-\\infty $ and $26,$ where \n\n- the left endpoint $-\\infty $ is *not* included, and\n\n- the right endpoint $26$ *is* included.\n\nTherefore, the inequality represented by this interval is \n\n$$\n-\\infty <z\\le 26.\n$$\n\nHowever, since all numbers are greater than negative infinity, it suffices to write \n\n$$\nz\\le 26.\n$$"}] [{:db/id #edb/ref 17592186504642 :knowledge-point/_questions [{:db/id #edb/ref 17592186192629 :knowledge-point/id #uuid "a9534b7a-2c3b-5b8d-a22b-6ab928b7b268" :knowledge-point/title "Converting Inequalities to Right-Bounded Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dc81733-1724-5007-93d8-73e6a4d641d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,2)" :db/id #edb/ref 17592186504112} {:answer/id #uuid "4710b4a5-1e04-5de0-b8cb-3745fdcbffa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-2)" :db/id #edb/ref 17592186504160} {:answer/id #uuid "c7678492-a4db-5293-886a-50ed4f45f6ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-2,\\infty )" :db/id #edb/ref 17592186504368} {:answer/id #uuid "cbb807c9-e753-5fae-b9a9-3d16aa42052e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-2]" :db/id #edb/ref 17592186504378} {:answer/id #uuid "f342d5e9-ad9c-5011-89b1-b3f78efba918" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-2,\\infty )" :db/id #edb/ref 17592186504454}] :answer-field/correct {:answer/id #uuid "4710b4a5-1e04-5de0-b8cb-3745fdcbffa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-2)" :db/id #edb/ref 17592186504160} :answer-field/id #uuid "252ca47e-4dc4-5484-9ba0-c98ceb6b632d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504495}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7495bbc7-a548-574a-82ac-70b0b5806589" :question/math-academy-id "q-28812" :question/problem "The inequality $x<-2$ can be expressed in interval notation as" :question/worked-solution "The inequality $x<-2$ corresponds to all numbers less than $-2.$ A number line for this interval is shown below:\n\n$$\n\n$$\n\n![](images/d1/d142ec418d86ccfce8f701ca19384d599ed2b5f7072d5ae84dcb3796baa73261.png)\n\n$$\n\n$$\n\nFrom the segment on the number line, we have the following:\n\n- There is no left endpoint - it continues forever. So, we write the interval with negative infinity as the left endpoint, not included.\n\n- The right endpoint $-2$ is *not* included in the interval.\n\nTherefore, using interval notation, we represent $x<-2$ as\n\n$$\nx\\in (-\\infty ,-2).\n$$"}]}
