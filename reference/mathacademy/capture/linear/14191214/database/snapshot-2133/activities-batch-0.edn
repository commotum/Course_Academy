#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186193415} :activity/id #uuid "74626dd3-01bc-5e8e-bddc-8cf09a386483" :activity/scope {:db/id #edb/ref 17592186050301 :topic/id #uuid "3e441d83-3649-5eed-b4b6-8e6fa7f31a51" :topic/math-academy-id 4028} :activity/steps [{:db/id #edb/ref 17592186193415 :step/content {:db/id #edb/ref 17592186193939 :tutorial/content "Consider the following inequality: \n\n$$\nx > 0\n$$\n\nWe can represent this inequality using a number line as follows:\n\n![](images/79/79664d125db14d5b8534d592d232839659a6d0efbd527379207b50d71f9e7454.png)\n\nHow do we represent this inequality using interval notation?\n\nNote the following:\n\n- The left endpoint $x=0$ is *not* included. Therefore, we use a parenthesis $($ for this endpoint.\n\n- The interval continues forever in the positive direction. To denote this, we must introduce the **infinity** symbol $\\infty.$ Infinity is not a number but a concept that means *larger than any number*.\n\n- We use a right parenthesis $)$ in conjunction with the $\\infty$ symbol.\n\nTherefore, we can express the inequality $x > 0$ in interval notation as follows:\n\n$$\nx \\in (0, \\infty)\n$$\n\n**Watch Out!** Whenever $\\infty$ appears in an interval, it is *always* associated with a right parenthesis. Infinity is *never* associated with a bracket, even if the other endpoint is." :tutorial/id #uuid "2382411e-5830-5103-a1c5-7731a19a02db" :tutorial/math-academy-id 8680 :tutorial/title "Introduction"} :step/id #uuid "cfc23afb-3275-5aa4-8551-ad457e052853" :step/math-academy-id 138214 :step/next {:db/id #edb/ref 17592186193416}} {:db/id #edb/ref 17592186193416 :step/content {:db/id #edb/ref 17592186192627 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192581 :question/id #uuid "e6c81f79-c86d-5964-8b88-5bfa3f489d75" :question/math-academy-id "e-13937"} :knowledge-point/id #uuid "90cbd355-34ae-5c9a-aba6-3351c09933e2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049162}] :knowledge-point/questions [{:db/id #edb/ref 17592186192954} {:db/id #edb/ref 17592186192955} {:db/id #edb/ref 17592186504649} {:db/id #edb/ref 17592186504660}] :knowledge-point/title "Converting Inequalities to Left-Bounded Intervals"} :step/id #uuid "b6ff5815-196a-5d29-b7d7-47da1222d847" :step/math-academy-id 138215 :step/next {:db/id #edb/ref 17592186193417}} {:db/id #edb/ref 17592186193417 :step/content {:db/id #edb/ref 17592186192628 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192582 :question/id #uuid "16206aac-d66a-5473-b49d-36b688ddf73e" :question/math-academy-id "e-13940"} :knowledge-point/id #uuid "b8faaee6-bcba-508b-bd4c-51f0add67fa1" :knowledge-point/questions [{:db/id #edb/ref 17592186192956} {:db/id #edb/ref 17592186193235} {:db/id #edb/ref 17592186504602} {:db/id #edb/ref 17592186504697}] :knowledge-point/title "Converting Left-Bounded Intervals to Inequalities"} :step/id #uuid "1d914c92-1db9-5e9a-993d-b58a38efc2a6" :step/math-academy-id 138218 :step/next {:db/id #edb/ref 17592186193418}} {:db/id #edb/ref 17592186193418 :step/content {:db/id #edb/ref 17592186193940 :tutorial/content "Now, consider the following inequality: \n\n$$\nx \\lt 0\n$$\n\nWe can represent this inequality using a number line as follows:\n\n![](images/52/52be4b1ae3d32f2d3bb1dbf9f4faa1f288cff5736870064533b958ac89a76dad.png)\n\nTo represent this inequality using interval notation, we note the following:\n\n- The right endpoint $x=0$ is *not* included. Therefore, we use a parenthesis $)$ for this endpoint.\n\n- The interval continues forever in the negative direction. To denote this, we use the **negative infinity** symbol $-\\infty.$ We use a left parenthesis $($ in conjunction with the negative infinity symbol.\n\nTherefore, we can express the inequality $x < 0$ in interval notation as follows:\n\n$$\nx \\in (-\\infty, 0)\n$$" :tutorial/id #uuid "e67284cc-a073-575e-8931-37272b3ac7c7" :tutorial/math-academy-id 8684 :tutorial/title "Right-Bounded Intervals"} :step/id #uuid "a2838cba-9d83-53b3-9980-b5a3b45a255c" :step/math-academy-id 138222 :step/next {:db/id #edb/ref 17592186193419}} {:db/id #edb/ref 17592186193419 :step/content {:db/id #edb/ref 17592186192629 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192583 :question/id #uuid "9c9186ce-dd3e-544a-a76e-626e0667b5b9" :question/math-academy-id "e-13944"} :knowledge-point/id #uuid "a9534b7a-2c3b-5b8d-a22b-6ab928b7b268" :knowledge-point/questions [{:db/id #edb/ref 17592186192950} {:db/id #edb/ref 17592186192953} {:db/id #edb/ref 17592186504605} {:db/id #edb/ref 17592186504642}] :knowledge-point/title "Converting Inequalities to Right-Bounded Intervals"} :step/id #uuid "5cb7be3f-91f3-563e-aa1c-295a1578ae18" :step/math-academy-id 138223 :step/next {:db/id #edb/ref 17592186193420}} {:db/id #edb/ref 17592186193420 :step/content {:db/id #edb/ref 17592186192630 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192584 :question/id #uuid "5ede0c02-193c-57ee-96d4-77bab7a74b19" :question/math-academy-id "e-13947"} :knowledge-point/id #uuid "51d228cc-574d-5436-9542-24b5fbb6fba4" :knowledge-point/questions [{:db/id #edb/ref 17592186193247} {:db/id #edb/ref 17592186193303} {:db/id #edb/ref 17592186504640} {:db/id #edb/ref 17592186504681}] :knowledge-point/title "Converting Right-Bounded Intervals to Inequalities"} :step/id #uuid "73749def-1eb5-502d-aba7-94ee3fc03a7a" :step/math-academy-id 138226}] :activity/title "Unbounded Intervals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186192906}]}
