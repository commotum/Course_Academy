#{[{:db/id #edb/ref 17592186192581 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186192627 :knowledge-point/id #uuid "90cbd355-34ae-5c9a-aba6-3351c09933e2" :knowledge-point/title "Converting Inequalities to Left-Bounded Intervals"}] :question/id #uuid "e6c81f79-c86d-5964-8b88-5bfa3f489d75" :question/math-academy-id "e-13937" :question/problem "Express the inequality $x \\geq 1$ in interval notation." :question/worked-solution "The inequality\n\n$$\nx \\geq 1\n$$\n\ncorresponds to all numbers greater than or equal to $1$. A number line for this inequality is shown below:\n\n![](images/82/829c0bd7c365ef7e5b1d3bee70a632b34cd644349a7528b688abdfd57575a1ab.png)\n\nFrom the segment on the number line, we have the following:\n\n- The left endpoint $1$ *is* included in the interval.\n- There is no right endpoint - it continues forever. So, we write the interval with infinity as the right endpoint, not included.\n\nTherefore, using interval notation, we represent\n\n$$\nx \\geq 1\n$$\n\nas\n\n$$\nx \\in [1,\\infty)\n$$"}] [{:db/id #edb/ref 17592186192582 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186192628 :knowledge-point/id #uuid "b8faaee6-bcba-508b-bd4c-51f0add67fa1" :knowledge-point/title "Converting Left-Bounded Intervals to Inequalities"}] :question/id #uuid "16206aac-d66a-5473-b49d-36b688ddf73e" :question/math-academy-id "e-13940" :question/problem "What inequality corresponds the interval $x\\in\\left[5, \\infty\\right)$?" :question/worked-solution "The statement\n\n$$\nx\\in\\left[5, \\infty\\right)\n$$\n\nmeans that $x$ lies between $5$ and $\\infty$, where\n\n- the left endpoint $5$ *is* included, and\n- the right endpoint $\\infty$ is *not* included.\n\nTherefore, the inequality represented by this interval is\n\n$$\n5 \\leq x < \\infty\n$$\n\nHowever, since all numbers are smaller than infinity, it suffices to write\n\n$$\n5 \\leq x\n$$\n\nor, equivalently,\n\n$$\nx \\geq 5\n$$"}] [{:db/id #edb/ref 17592186192583 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186192629 :knowledge-point/id #uuid "a9534b7a-2c3b-5b8d-a22b-6ab928b7b268" :knowledge-point/title "Converting Inequalities to Right-Bounded Intervals"}] :question/id #uuid "9c9186ce-dd3e-544a-a76e-626e0667b5b9" :question/math-academy-id "e-13944" :question/problem "Express the inequality $x \\le 1$ in interval notation." :question/worked-solution "The inequality\n\n$$\nx \\leq 1\n$$\n\ncorresponds to all numbers less than or equal to $1$. A number line for this interval is shown below:\n\n![](images/b5/b506caa666e4715b3f153459b8ec7f650ff53e97401ec9887fe6c294fb680887.png)\n\nFrom the segment on the number line, we have the following:\n\n- There is no left endpoint - it continues forever. So, we write the interval with negative infinity as the left endpoint, not included.\n- The right endpoint $1$ *is* included in the interval.\n\nTherefore, using interval notation, we represent\n\n$$\nx \\leq 1\n$$\n\nas\n\n$$\nx\\in(-\\infty, 1]\n$$"}] [{:db/id #edb/ref 17592186192584 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186192630 :knowledge-point/id #uuid "51d228cc-574d-5436-9542-24b5fbb6fba4" :knowledge-point/title "Converting Right-Bounded Intervals to Inequalities"}] :question/id #uuid "5ede0c02-193c-57ee-96d4-77bab7a74b19" :question/math-academy-id "e-13947" :question/problem "What inequality corresponds to the interval $x\\in\\left(-\\infty, 9\\right)$?" :question/worked-solution "The statement\n\n$$\nx \\in \\left(-\\infty, 9\\right)\n$$\n\nmeans that $x$ lies between $-\\infty$ and $9$, where\n\n- the left endpoint $-\\infty$ is *not* included, and\n- the right endpoint $9$ is *not* included.\n\nTherefore, the inequality represented by this interval is\n$-\\infty < x < 9$.\n\nHowever, since all numbers are greater than negative infinity, it suffices to write\n$x < 9$."}] [{:db/id #edb/ref 17592186192953 :knowledge-point/_questions [{:db/id #edb/ref 17592186192629 :knowledge-point/id #uuid "a9534b7a-2c3b-5b8d-a22b-6ab928b7b268" :knowledge-point/title "Converting Inequalities to Right-Bounded Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9a6e13e-1788-5e2c-ba54-3293844ad358" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x ∈ [- 7, ∞)" :db/id #edb/ref 17592186189605} {:answer/id #uuid "de3a6d07-a4d9-5462-b5f0-01f694904016" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x ∈ (-7, ∞)" :db/id #edb/ref 17592186189606} {:answer/id #uuid "e97674b8-57df-538e-b33d-7bf6692694d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x ∈ [7, ∞)" :db/id #edb/ref 17592186189607} {:answer/id #uuid "588756b6-4f3d-57c9-91df-6bf3d4fa198b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x ∈ (- ∞,-7]" :db/id #edb/ref 17592186189608} {:answer/id #uuid "6687831c-bcee-5bff-a6d0-c0fd9620c78d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x ∈ (- ∞,-7)" :db/id #edb/ref 17592186189609}] :answer-field/id #uuid "b3e24798-ddae-5831-867f-7145c0a63d64" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186189604}] :question/id #uuid "8ef3c4ea-a031-5477-bdfa-9d17b8ca3563" :question/math-academy-id "q-1241" :question/problem "The inequality $x < - 7$ can be expressed in interval notation as"}]}
