#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186563772} :activity/id #uuid "893cd585-763a-5ad4-9659-5052de0c1e02" :activity/scope {:db/id #edb/ref 17592186050987 :topic/id #uuid "7734519e-e666-5361-81f3-89b86b5bc28d" :topic/math-academy-id 37} :activity/steps [{:db/id #edb/ref 17592186563772 :step/content {:db/id #edb/ref 17592186563742 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16ba1e29-25ac-579d-9cfe-24448c56edab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186562995} {:answer/id #uuid "a0bf2b88-34c6-53e4-a455-89e06f7f9a7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186563306} {:answer/id #uuid "db467dc8-4b26-512d-821f-e3c4973e9fd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[3]{6}" :db/id #edb/ref 17592186563426} {:answer/id #uuid "fbdaaac8-b49f-51b4-b323-7ea59a4fdd9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{\\sqrt[3]{2}}" :db/id #edb/ref 17592186563510} {:answer/id #uuid "ff7f4802-e1a5-55e2-9352-05637b9f8392" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186563516}] :answer-field/correct {:db/id #edb/ref 17592186563516} :answer-field/id #uuid "ddff0f96-aeb7-5490-8d56-4c8b9d0de231" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563630}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d591e3b7-0993-5fb9-b7f0-ff97c33bf559" :question/math-academy-id "q-100250" :question/problem "Find ${lim}_{x\\to 2}\\frac{3x}{\\sqrt[3]{2{x}^{4}-5}}.$" :question/worked-solution "Applying the quotient rule, we get\n\n$$\n{lim}_{x\\to 2}\\frac{3x}{\\sqrt[3]{2{x}^{4}-5}}=\\frac{{lim}_{x\\to 2}3x}{{lim}_{x\\to 2}\\sqrt[3]{2{x}^{4}-5}}\n$$\n\nWe calculate the limits of the numerator and denominator, separately.\n\nFor the numerator, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}3x & =3{lim}_{x\\to 2}x \\\\  & =3\\cdot 2 \\\\  & =6\\,.\\end{aligned}\n$$\n\nApplying the root rule in the denominator, we have\n \n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\sqrt[3]{2{x}^{4}-5} & =\\sqrt[3]{{lim}_{x\\to 2}(2{x}^{4}-5)} \\\\  & =\\sqrt[3]{2(2)^{4}-5)} \\\\  & =\\sqrt[3]{27} \\\\  & =3\\,.\\end{aligned}\n$$\n\nConsequently,\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{3x}{\\sqrt[3]{2{x}^{4}-5}} & =\\frac{6}{3}=2\\,.\\end{aligned}\n$$"} :step/id #uuid "2e1eff63-f8c6-5d02-9662-7565ab1c3899" :step/next {:db/id #edb/ref 17592186563794}} {:db/id #edb/ref 17592186563787 :step/content {:db/id #edb/ref 17592186563660 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d434ed0-8529-5bae-a087-2963bb7442d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186562969}] :answer-field/correct {:db/id #edb/ref 17592186562969} :answer-field/id #uuid "32d33a71-45d3-5a70-b6f2-f587f0b3ec0b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186563550}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2b9acb7e-8235-5df0-907d-863119079541" :question/math-academy-id "q-338390" :question/problem "Find the **exact** value of the limit.\n\n${lim}_{t\\to -1}(\\sqrt[7]{(2t+1)^{7}}-\\sqrt[3]{({t}^{2}+t+1)^{6}})=$\n{{field-1}}" :question/worked-solution "Applying the sum and root rules, we get\n\n \n\n$$\n\\begin{aligned}{lim}_{t\\to -1}(\\sqrt[7]{(2t+1)^{7}}-\\sqrt[3]{({t}^{2}+t+1)^{6}}) & ={lim}_{t\\to -1}\\sqrt[7]{(2t+1)^{7}}-{lim}_{t\\to -1}\\sqrt[3]{({t}^{2}+t+1)^{6}} \\\\  & =\\sqrt[7]{{({lim}_{t\\to -1}(2t+1))}^{7}}-\\sqrt[3]{{({lim}_{t\\to -1}({t}^{2}+t+1))}^{6}} \\\\  & =\\sqrt[7]{(2(-1)+1)^{7}}-\\sqrt[3]{(((-1)^{2}+(-1)+1))^{6}} \\\\  & =\\sqrt[7]{(-2+1)^{7}}-\\sqrt[3]{((1-1+1))^{6}} \\\\  & =\\sqrt[7]{(-1)^{7}}-\\sqrt[3]{(1)^{6}} \\\\  & =\\sqrt[7]{-1}-\\sqrt[3]{1} \\\\  & =-1-1 \\\\  & =-2.\\end{aligned}\n$$"} :step/id #uuid "75c9d97b-2b75-5de2-b1d4-d07fb1dfbf30"} {:db/id #edb/ref 17592186563794 :step/content {:db/id #edb/ref 17592186563676 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "066cb984-e17a-5fea-af4c-48188475d862" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186562952}] :answer-field/correct {:db/id #edb/ref 17592186562952} :answer-field/id #uuid "817fc64f-fe17-5ab1-8ab5-8f8ebfd722a2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186563582}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "41ad1c03-af11-5517-b3f9-c73f27dc13ff" :question/math-academy-id "q-338364" :question/problem "![](images/94/94027c25ef78ae46d0deb4b577339daf878efd71b71029a9575f9c8ed9096e2c.png)\n\nIf the figure above shows the graph of the function $f(x),$ then\n\n${lim}_{x\\to \\,2}(x-1)^{2}\\,(f(x)-2)^{3}=$\n{{field-1}}" :question/worked-solution "From the graph, we get that ${lim}_{x\\to \\,2}f(x)=3.$\n\nFrom the product rule, we have\n\n$$\n{lim}_{x\\to \\,2}(x-1)^{2}\\,(f(x)-2)^{3}={lim}_{x\\to \\,2}(x-1)^{2}\\cdot {lim}_{x\\to \\,2}(f(x)-2)^{3}.\n$$\n\nWe calculate the limits of each factor, separately.\n\nApplying the power rule, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,2}(x-1)^{2} & ={({lim}_{x\\to \\,2}(x-1))}^{2} \\\\  & =(2-1)^{2} \\\\  & ={1}^{2} \\\\  & =1\\,,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,2}(f(x)-2)^{3} & ={({lim}_{x\\to \\,2}(f(x)-2))}^{3} \\\\  & =(3-2)^{3} \\\\  & ={1}^{3} \\\\  & =1\\,.\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,2}(x-1)^{2}\\,(f(x)-2)^{3} & =(1)\\cdot (1) \\\\  & =1.\\end{aligned}\n$$"} :step/id #uuid "9a7d063a-cc3c-5001-8da3-bc7d18a9ea75" :step/next {:db/id #edb/ref 17592186563787}}] :activity/title "The Power and Root Rules for Limits" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186562932}]}
