#{[{:db/id #edb/ref 17592186105481 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105704 :knowledge-point/id #uuid "7e7047fd-14f2-5325-8959-f24fa670f453" :knowledge-point/title "Rationalizing a Denominator"}] :question/id #uuid "72b4f2ac-747d-500b-9839-f557502cbbec" :question/math-academy-id "e-14638" :question/problem "Find a fraction that is equivalent to $\\dfrac {3}{\\sqrt{5}}$ that does not contain a radical in the denominator." :question/worked-solution "To remove the radical $\\sqrt{5}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{5}$ and simplify:\n\n$$\n\\begin{aligned}\n\\frac{3}{\\sqrt{5}} &=  \\\\\n\\frac{3}{\\sqrt{5}} \\cdot \\frac{\\sqrt{5}}{\\sqrt{5}} &=  \\\\\n(3\\sqrt{5})/((\\sqrt{5})^{2}) &=  \\\\\n&= \\frac{3\\sqrt{5}}{5}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105482 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105705 :knowledge-point/id #uuid "2d0b2497-9533-5fa9-9895-8a02a2b68c86" :knowledge-point/title "Rationalizing a Denominator When Simplification Is Needed"}] :question/id #uuid "8eb62a34-5745-5978-915b-f8648acc2501" :question/math-academy-id "e-14639" :question/problem "Find a fraction that is equivalent to $\\dfrac {15}{2\\sqrt{5}}$ that does not contain a radical in the denominator." :question/worked-solution "To remove the radical $\\sqrt{5}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{5}$ and simplify:\n\n$$\n\\begin{aligned}\n\\frac{15}{2\\sqrt{5}} &=  \\\\\n\\frac{15}{2\\sqrt{5}} \\cdot \\frac{\\sqrt{5}}{\\sqrt{5}} &=  \\\\\n(15\\sqrt{5})/(2(\\sqrt{5})^{2}) &=  \\\\\n\\frac{15\\sqrt{5}}{2 \\cdot 5} &=  \\\\\n\\frac{15\\sqrt{5}}{10} &=  \\\\\n&= \\frac{3\\sqrt{5}}{2}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105483 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105706 :knowledge-point/id #uuid "649ee093-c7ba-5832-9ffb-6d39a351573b" :knowledge-point/title "Fractions With Radicals in the Numerator and Denominator"}] :question/id #uuid "1d652168-a82e-53cb-93fd-3cc734df4d5f" :question/math-academy-id "e-14640" :question/problem "Find a fraction that is equivalent to $\\dfrac {\\sqrt{3}}{\\sqrt{2}}$ that does not contain a radical in the denominator." :question/worked-solution "To remove the radical $\\sqrt{2}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{2}$ and simplify:\n\n$$\n\\begin{aligned}\n\\frac{\\sqrt{3}}{\\sqrt{2}} &=  \\\\\n\\frac{\\sqrt{3}}{\\sqrt{2}} \\cdot \\frac{\\sqrt{2}}{\\sqrt{2}} &=  \\\\\n(\\sqrt{3} \\cdot \\sqrt{2})/((\\sqrt{2})^{2}) &=  \\\\\n&= \\frac{\\sqrt{3} \\cdot \\sqrt{2}}{2}\n\\end{aligned}\n$$\n\nNow, we use the product rule to simplify the numerator:\n\n$$\n\\begin{aligned}\n\\frac{\\sqrt{3} \\cdot \\sqrt{2}}{2} &=  \\\\\n\\frac{\\sqrt{3 \\cdot 2}}{2} &=  \\\\\n&= \\frac{\\sqrt{6}}{2}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105484 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105707 :knowledge-point/id #uuid "fea54643-f0c5-5d61-b385-eb984b2f329f" :knowledge-point/title "Cases Where Further Simplification Needed"}] :question/id #uuid "f32d71e2-5ea2-5677-b75c-4de18998d504" :question/math-academy-id "e-14641" :question/problem "Find a fraction that is equivalent to $\\dfrac {\\sqrt{5}}{\\sqrt{8}}$ that does not contain a radical in the denominator." :question/worked-solution "To remove the radical $\\sqrt{8}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{8}$ and simplify:\n\n$$\n\\begin{aligned}\n\\frac{\\sqrt{5}}{\\sqrt{8}} &=  \\\\\n\\frac{\\sqrt{5}}{\\sqrt{8}} \\cdot \\frac{\\sqrt{8}}{\\sqrt{8}} &=  \\\\\n(\\sqrt{5} \\cdot \\sqrt{8})/((\\sqrt{8})^{2}) &=  \\\\\n&= \\frac{\\sqrt{5} \\cdot \\sqrt{8}}{8}\n\\end{aligned}\n$$\n\nNext, we notice that $8$ has a perfect square factor $(4)$. Therefore, we can rewrite $\\sqrt{8}$ as follows:\n\n$$\n\\begin{aligned}\n\\sqrt{8} &=  \\\\\n\\sqrt{4 \\cdot 2} &=  \\\\\n\\sqrt{4} \\cdot \\sqrt{2} &=  \\\\\n&= 2\\sqrt{2}\n\\end{aligned}\n$$\n\nFinally, we simplify our original fraction as follows:\n\n$$\n\\begin{aligned}\n\\frac{\\sqrt{5} \\cdot \\sqrt{8}}{8} &=  \\\\\n\\frac{\\sqrt{5} \\cdot 2\\sqrt{2}}{8} &=  \\\\\n\\frac{2 \\cdot \\sqrt{5} \\cdot \\sqrt{2}}{8} &=  \\\\\n\\frac{\\sqrt{5} \\cdot \\sqrt{2}}{4} &=  \\\\\n\\frac{\\sqrt{5 \\cdot 2}}{4} &=  \\\\\n&= \\frac{\\sqrt{10}}{4}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106175 :knowledge-point/_questions [{:db/id #edb/ref 17592186105707 :knowledge-point/id #uuid "fea54643-f0c5-5d61-b385-eb984b2f329f" :knowledge-point/title "Cases Where Further Simplification Needed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1346af9-1d45-5b9b-9bf1-e43bbf7898bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{12}}{3}" :db/id #edb/ref 17592186102927} {:answer/id #uuid "c3405336-e4c4-5f11-97fd-40d6614a69c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{3}" :db/id #edb/ref 17592186102928} {:answer/id #uuid "e2bdd923-7c7f-59e4-b7d7-9b624b23b1a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{10}" :db/id #edb/ref 17592186102929} {:answer/id #uuid "25d5ac82-e752-5c3b-a0ec-dea1984d2e5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{6}}{10}" :db/id #edb/ref 17592186102930} {:answer/id #uuid "6f8f13e0-6b12-5d71-ac97-2c63a2794b7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{6}}{3}" :db/id #edb/ref 17592186102931}] :answer-field/id #uuid "4a6375b7-e51c-5cdd-90ba-55977aa2d6ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102926}] :question/id #uuid "d92c7d66-