t{2}\\cdot \\sqrt{7}}{7} & = \\\\ \\frac{\\sqrt{2\\cdot 7}}{7} & = \\\\ \\frac{\\sqrt{14}}{7} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485565 :knowledge-point/_questions [{:db/id #edb/ref 17592186105704 :knowledge-point/id #uuid "7e7047fd-14f2-5325-8959-f24fa670f453" :knowledge-point/title "Rationalizing a Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "434da3af-7fa0-5d0d-a654-44fb07e9ab54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{19}" :db/id #edb/ref 17592186484963} {:answer/id #uuid "51af9948-ec0f-5e4a-8822-48dac8698c6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{13}}{13}" :db/id #edb/ref 17592186484995} {:answer/id #uuid "a70bf489-59ff-5a5c-a982-86836a76afb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6\\sqrt{13}}{13}" :db/id #edb/ref 17592186485179} {:answer/id #uuid "da1097e4-58f2-5451-bca0-1353ad387c81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6\\sqrt{6}}{13}" :db/id #edb/ref 17592186485275} {:answer/id #uuid "e9cf44e1-ef05-5e96-a33f-2d93a5fd1480" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6\\sqrt{13}}{19}" :db/id #edb/ref 17592186485314}] :answer-field/correct {:answer/id #uuid "a70bf489-59ff-5a5c-a982-86836a76afb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6\\sqrt{13}}{13}" :db/id #edb/ref 17592186485179} :answer-field/id #uuid "8f1fe427-f208-5905-b459-e17ca82b3a3d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485425}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a64a909b-05fd-57b7-b6a0-ceee0bbc9acd" :question/math-academy-id "q-99624" :question/problem "$\\frac{6}{\\sqrt{13}}=$" :question/worked-solution "To remove the radical $\\sqrt{13}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{13}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{6}{\\sqrt{13}} & = \\\\ \\frac{6}{\\sqrt{13}}\\cdot \\frac{\\sqrt{13}}{\\sqrt{13}} & = \\\\ \\frac{6\\sqrt{13}}{(\\sqrt{13})^{2}} & = \\\\ \\frac{6\\sqrt{13}}{13}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485585 :knowledge-point/_questions [{:db/id #edb/ref 17592186105706 :knowledge-point/id #uuid "649ee093-c7ba-5832-9ffb-6d39a351573b" :knowledge-point/title "Fractions With Radicals in the Numerator and Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "042b1b97-adf6-559c-aee7-f638bcb993a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{7}" :db/id #edb/ref 17592186484825} {:answer/id #uuid "2f1f2703-5367-5c21-9190-e63102f56cf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\sqrt{21}}{3}" :db/id #edb/ref 17592186484915} {:answer/id #uuid "49291e93-d649-55d2-b573-9b986e710430" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{21}}{3}" :db/id #edb/ref 17592186484976} {:answer/id #uuid "c70e80f3-3635-5335-b184-577286a23d45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{3}" :db/id #edb/ref 17592186485244} {:answer/id #uuid "ea8f5845-ec9c-5e33-a9c3-c45aec206f83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{21}" :db/id #edb/ref 17592186485315}] :answer-field/correct {:answer/id #uuid "49291e93-d649-55d2-b573-9b986e710430" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{21}}{3}" :db/id #edb/ref 17592186484976} :answer-field/id #uuid "f98bd79a-0814-5c23-84d8-a87462865c4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485475}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "deb54481-2dc5-5793-afb9-1c365b9534d3" :question/math-academy-id "q-99629" :question/problem "$\\frac{\\sqrt{7}}{\\sqrt{3}}=$" :question/worked-solution "To remove the radical $\\sqrt{3}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{3}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{7}}{\\sqrt{3}} & = \\\\ \\frac{\\sqrt{7}}{\\sqrt{3}}\\cdot \\frac{\\sqrt{3}}{\\sqrt{3}} & = \\\\ \\frac{\\sqrt{7}\\cdot \\sqrt{3}}{(\\sqrt{3})^{2}} & = \\\\ \\frac{\\sqrt{7}\\cdot \\sqrt{3}}{3} & \\end{aligned}\n$$\n\nNow, we use the product rule to simplify the numerator:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{7}\\cdot \\sqrt{3}}{3} & = \\\\ \\frac{\\sqrt{7\\cdot 3}}{3} & = \\\\ \\frac{\\sqrt{21}}{3} & \\end{aligned}\n$$"}]}
