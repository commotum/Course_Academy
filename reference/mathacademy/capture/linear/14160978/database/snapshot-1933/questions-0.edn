#{[{:db/id #edb/ref 17592186105481 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105704 :knowledge-point/id #uuid "7e7047fd-14f2-5325-8959-f24fa670f453" :knowledge-point/title "Rationalizing a Denominator"}] :question/id #uuid "72b4f2ac-747d-500b-9839-f557502cbbec" :question/math-academy-id "e-14638" :question/problem "Find a fraction that is equivalent to $\\dfrac {3}{\\sqrt{5}}$ that does not contain a radical in the denominator." :question/worked-solution "To remove the radical $\\sqrt{5}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{5}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{3}{\\sqrt{5}} & = \\\\ \\frac{3}{\\sqrt{5}}\\cdot \\frac{\\sqrt{5}}{\\sqrt{5}} & = \\\\ \\frac{3\\sqrt{5}}{(\\sqrt{5})^{2}} & = \\\\ \\frac{3\\sqrt{5}}{5} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105482 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105705 :knowledge-point/id #uuid "2d0b2497-9533-5fa9-9895-8a02a2b68c86" :knowledge-point/title "Rationalizing a Denominator When Simplification Is Needed"}] :question/id #uuid "8eb62a34-5745-5978-915b-f8648acc2501" :question/math-academy-id "e-14639" :question/problem "Find a fraction that is equivalent to $\\dfrac {15}{2\\sqrt{5}}$ that does not contain a radical in the denominator." :question/worked-solution "To remove the radical $\\sqrt{5}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{5}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{15}{2\\sqrt{5}} & = \\\\ \\frac{15}{2\\sqrt{5}}\\cdot \\frac{\\sqrt{5}}{\\sqrt{5}} & = \\\\ \\frac{15\\sqrt{5}}{2(\\sqrt{5})^{2}} & = \\\\ \\frac{15\\sqrt{5}}{2\\cdot 5} & = \\\\ \\frac{15\\sqrt{5}}{10} & = \\\\ \\frac{3\\sqrt{5}}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105483 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105706 :knowledge-point/id #uuid "649ee093-c7ba-5832-9ffb-6d39a351573b" :knowledge-point/title "Fractions With Radicals in the Numerator and Denominator"}] :question/id #uuid "1d652168-a82e-53cb-93fd-3cc734df4d5f" :question/math-academy-id "e-14640" :question/problem "Find a fraction that is equivalent to $\\dfrac {\\sqrt{3}}{\\sqrt{2}}$ that does not contain a radical in the denominator." :question/worked-solution "To remove the radical $\\sqrt{2}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{2}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3}}{\\sqrt{2}} & = \\\\ \\frac{\\sqrt{3}}{\\sqrt{2}}\\cdot \\frac{\\sqrt{2}}{\\sqrt{2}} & = \\\\ \\frac{\\sqrt{3}\\cdot \\sqrt{2}}{(\\sqrt{2})^{2}} & = \\\\ \\frac{\\sqrt{3}\\cdot \\sqrt{2}}{2} & \\end{aligned}\n$$\n\nNow, we use the product rule to simplify the numerator:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3}\\cdot \\sqrt{2}}{2} & = \\\\ \\frac{\\sqrt{3\\cdot 2}}{2} & = \\\\ \\frac{\\sqrt{6}}{2} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105484 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105707 :knowledge-point/id #uuid "fea54643-f0c5-5d61-b385-eb984b2f329f" :knowledge-point/title "Cases Where Further Simplification Is Needed"}] :question/id #uuid "f32d71e2-5ea2-5677-b75c-4de18998d504" :question/math-academy-id "e-14641" :question/problem "Find a fraction that is equivalent to $\\dfrac {\\sqrt{5}}{\\sqrt{8}}$ that does not contain a radical in the denominator." :question/worked-solution "To remove the radical $\\sqrt{8}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{8}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{5}}{\\sqrt{8}} & = \\\\ \\frac{\\sqrt{5}}{\\sqrt{8}}\\cdot \\frac{\\sqrt{8}}{\\sqrt{8}} & = \\\\ \\frac{\\sqrt{5}\\cdot \\sqrt{8}}{(\\sqrt{8})^{2}} & = \\\\ \\frac{\\sqrt{5}\\cdot \\sqrt{8}}{8} & \\end{aligned}\n$$\n\nNext, we notice that $8$ has a perfect square factor $(4).$ Therefore, we can rewrite $\\sqrt{8}$ as follows:\n\n$$\n\\begin{aligned}\\sqrt{8} & = \\\\ \\sqrt{4\\cdot 2} & = \\\\ \\sqrt{4}\\cdot \\sqrt{2} & = \\\\ 2\\sqrt{2} & \\end{aligned}\n$$\n\nFinally, we simplify our original fraction as follows:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{5}\\cdot \\sqrt{8}}{8} & = \\\\ \\frac{\\sqrt{5}\\cdot 2\\sqrt{2}}{8} & = \\\\ \\frac{2\\cdot \\sqrt{5}\\cdot \\sqrt{2}}{8} & = \\\\ \\frac{\\sqrt{5}\\cdot \\sqrt{2}}{4} & = \\\\ \\frac{\\sqrt{5\\cdot 2}}{4} & = \\\\ \\frac{\\sqrt{10}}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106175 :knowledge-point/_questions [{:db/id #edb/ref 17592186105707 :knowledge-point/id #uuid "fea54643-f0c5-5d61-b385-eb984b2f329f" :knowledge-point/title "Cases Where Further Simplification Is Needed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1346af9-1d45-5b9b-9bf1-e43bbf7898bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{12}}{3}" :db/id #edb/ref 17592186102927} {:answer/id #uuid "c3405336-e4c4-5f11-97fd-40d6614a69c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{3}" :db/id #edb/ref 17592186102928} {:answer/id #uuid "e2bdd923-7c7f-59e4-b7d7-9b624b23b1a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{10}" :db/id #edb/ref 17592186102929} {:answer/id #uuid "25d5ac82-e752-5c3b-a0ec-dea1984d2e5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{6}}{10}" :db/id #edb/ref 17592186102930} {:answer/id #uuid "6f8f13e0-6b12-5d71-ac97-2c63a2794b7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{6}}{3}" :db/id #edb/ref 17592186102931}] :answer-field/correct {:answer/id #uuid "6f8f13e0-6b12-5d71-ac97-2c63a2794b7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{6}}{3}" :db/id #edb/ref 17592186102931} :answer-field/id #uuid "4a6375b7-e51c-5cdd-90ba-55977aa2d6ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102926}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d92c7d66-2cb8-54a2-9c73-50848dc4995d" :question/math-academy-id "q-212808" :question/problem "$\\frac{\\sqrt{8}}{\\sqrt{3}}=$" :question/worked-solution "To remove the radical $\\sqrt{3}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{3}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{8}}{\\sqrt{3}} & = \\\\ \\frac{\\sqrt{8}}{\\sqrt{3}}\\cdot \\frac{\\sqrt{3}}{\\sqrt{3}} & = \\\\ \\frac{\\sqrt{8}\\cdot \\sqrt{3}}{(\\sqrt{3})^{2}} & = \\\\ \\frac{\\sqrt{8}\\cdot \\sqrt{3}}{3} & \\end{aligned}\n$$\n\nNext, we notice that $8$ has a perfect square factor $(4).$ Therefore, we can rewrite $\\sqrt{8}$ as follows:\n\n$$\n\\begin{aligned}\\sqrt{8} & = \\\\ \\sqrt{4\\cdot 2} & = \\\\ \\sqrt{4}\\cdot \\sqrt{2} & = \\\\ 2\\sqrt{2} & \\end{aligned}\n$$\n\nFinally, we simplify our original fraction as follows:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{8}\\cdot \\sqrt{3}}{3} & = \\\\ \\frac{2\\sqrt{2}\\cdot \\sqrt{3}}{3} & = \\\\ \\frac{2\\sqrt{2\\cdot 3}}{3} & = \\\\ \\frac{2\\sqrt{6}}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106176 :knowledge-point/_questions [{:db/id #edb/ref 17592186105707 :knowledge-point/id #uuid "fea54643-f0c5-5d61-b385-eb984b2f329f" :knowledge-point/title "Cases Where Further Simplification Is Needed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92f3eacd-aaf4-5330-8caf-bf8b30868926" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10}}{4}" :db/id #edb/ref 17592186102933} {:answer/id #uuid "97464bf4-9f30-548d-86f1-d1e7088e8880" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{4}" :db/id #edb/ref 17592186102934} {:answer/id #uuid "aa89569f-79bd-5842-94f5-0254ab2711cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10}}{2}" :db/id #edb/ref 17592186102935} {:answer/id #uuid "c34fccc5-82c3-5723-b49a-790674140921" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{3}" :db/id #edb/ref 17592186102936} {:answer/id #uuid "4ac76ce6-0d48-5e74-8a3c-49e6b2d2667e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{9}" :db/id #edb/ref 17592186102937}] :answer-field/correct {:answer/id #uuid "97464bf4-9f30-548d-86f1-d1e7088e8880" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{4}" :db/id #edb/ref 17592186102934} :answer-field/id #uuid "de74956f-f6ce-50dd-9d94-ca7fb0918b99" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102932}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c8d7c600-47ec-5201-854a-97382b174870" :question/math-academy-id "q-212809" :question/problem "$\\frac{\\sqrt{3}}{\\sqrt{8}}=$" :question/worked-solution "To remove the radical $\\sqrt{8}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{8}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3}}{\\sqrt{8}} & = \\\\ \\frac{\\sqrt{3}}{\\sqrt{8}}\\cdot \\frac{\\sqrt{8}}{\\sqrt{8}} & = \\\\ \\frac{\\sqrt{3}\\cdot \\sqrt{8}}{(\\sqrt{8})^{2}} & = \\\\ \\frac{\\sqrt{3}\\cdot \\sqrt{8}}{8} & \\end{aligned}\n$$\n\nNext, we notice that $8$ has a perfect square factor $(4).$ Therefore, we can rewrite $\\sqrt{8}$ as follows:\n\n$$\n\\begin{aligned}\\sqrt{8} & = \\\\ \\sqrt{4\\cdot 2} & = \\\\ \\sqrt{4}\\cdot \\sqrt{2} & = \\\\ 2\\sqrt{2} & \\end{aligned}\n$$\n\nFinally, we simplify our original fraction as follows:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3}\\cdot \\sqrt{8}}{8} & = \\\\ \\frac{\\sqrt{3}\\cdot 2\\sqrt{2}}{8} & = \\\\ \\frac{2\\cdot \\sqrt{3}\\cdot \\sqrt{2}}{8} & = \\\\ \\frac{\\sqrt{3}\\cdot \\sqrt{2}}{4} & = \\\\ \\frac{\\sqrt{3\\cdot 2}}{4} & = \\\\ \\frac{\\sqrt{6}}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485541 :knowledge-point/_questions [{:db/id #edb/ref 17592186105706 :knowledge-point/id #uuid "649ee093-c7ba-5832-9ffb-6d39a351573b" :knowledge-point/title "Fractions With Radicals in the Numerator and Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "345f5bfc-41f6-5f56-8e7f-360d75f818bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{3}" :db/id #edb/ref 17592186484927} {:answer/id #uuid "56f50180-a7e4-5a28-b023-07cf58f2b323" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{9}" :db/id #edb/ref 17592186485014} {:answer/id #uuid "6c1b2818-d887-5177-b85a-26738407f7be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{2}" :db/id #edb/ref 17592186485050} {:answer/id #uuid "7db8904e-ed60-51dc-86e9-b75d6a4fd533" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{9}" :db/id #edb/ref 17592186485092} {:answer/id #uuid "fa8b4c4c-e3b9-5ca8-85ef-9c187ca62865" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{6}" :db/id #edb/ref 17592186485353}] :answer-field/correct {:answer/id #uuid "56f50180-a7e4-5a28-b023-07cf58f2b323" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{9}" :db/id #edb/ref 17592186485014} :answer-field/id #uuid "2350c721-070c-5247-bade-91592e032f95" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485381}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "70917dc8-1a43-5c37-8280-8659e1c78b60" :question/math-academy-id "q-212913" :question/problem "$\\frac{\\sqrt{2}}{3\\sqrt{3}}=$" :question/worked-solution "To remove the radical $\\sqrt{3}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{3}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{2}}{3\\sqrt{3}} & = \\\\ \\frac{\\sqrt{2}}{3\\sqrt{3}}\\cdot \\frac{\\sqrt{3}}{\\sqrt{3}} & = \\\\ \\frac{\\sqrt{2}\\cdot \\sqrt{3}}{3\\cdot (\\sqrt{3})^{2}} & = \\\\ \\frac{\\sqrt{2}\\cdot \\sqrt{3}}{3\\cdot 3} & = \\\\ \\frac{\\sqrt{2}\\cdot \\sqrt{3}}{9}\\end{aligned}\n$$\n\nNow, we use the product rule to simplify the numerator:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{2}\\cdot \\sqrt{3}}{9} & = \\\\ \\frac{\\sqrt{2\\cdot 3}}{9} & = \\\\ \\frac{\\sqrt{6}}{9} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485573 :knowledge-point/_questions [{:db/id #edb/ref 17592186105707 :knowledge-point/id #uuid "fea54643-f0c5-5d61-b385-eb984b2f329f" :knowledge-point/title "Cases Where Further Simplification Is Needed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "224545ba-26f7-5316-81be-067cbbabb927" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10}}{2}" :db/id #edb/ref 17592186484882} {:answer/id #uuid "34bc50aa-c243-52a5-824d-c7eb5489c515" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{2}" :db/id #edb/ref 17592186484929} {:answer/id #uuid "95572b10-05b0-5990-8a00-0db90e625610" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186485138} {:answer/id #uuid "d8fe7281-679d-5b48-bbf3-31ebcfb49f43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{2}}{2}" :db/id #edb/ref 17592186485272} {:answer/id #uuid "ef0bc3c0-3c7e-5bb3-b7b5-05ea1ecdb51c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{10}}{2}" :db/id #edb/ref 17592186485328}] :answer-field/correct {:answer/id #uuid "ef0bc3c0-3c7e-5bb3-b7b5-05ea1ecdb51c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{10}}{2}" :db/id #edb/ref 17592186485328} :answer-field/id #uuid "f1d543d6-08df-55d3-9489-c58386a70208" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485472}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b78114a3-4df5-565e-b851-3da12ef84e72" :question/math-academy-id "q-212957" :question/problem "$\\frac{\\sqrt{45}}{\\sqrt{2}}=$" :question/worked-solution "To remove the radical $\\sqrt{2}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{2}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{45}}{\\sqrt{2}} & = \\\\ \\frac{\\sqrt{45}}{\\sqrt{2}}\\cdot \\frac{\\sqrt{2}}{\\sqrt{2}} & = \\\\ \\frac{\\sqrt{45}\\cdot \\sqrt{2}}{(\\sqrt{2})^{2}} & = \\\\ \\frac{\\sqrt{45}\\cdot \\sqrt{2}}{2} & \\end{aligned}\n$$\n\nNext, we notice that $45$ has a perfect square factor $(9).$ Therefore, we can rewrite $\\sqrt{45}$ as follows:\n\n$$\n\\begin{aligned}\\sqrt{45} & = \\\\ \\sqrt{9\\cdot 5} & = \\\\ \\sqrt{9}\\cdot \\sqrt{5} & = \\\\ 3\\sqrt{5} & \\end{aligned}\n$$\n\nFinally, we simplify our original fraction as follows:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{45}\\cdot \\sqrt{2}}{2} & = \\\\ \\frac{3\\sqrt{5}\\cdot \\sqrt{2}}{2} & = \\\\ \\frac{3\\sqrt{5\\cdot 2}}{2} & = \\\\ \\frac{3\\sqrt{10}}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485496 :knowledge-point/_questions [{:db/id #edb/ref 17592186105707 :knowledge-point/id #uuid "fea54643-f0c5-5d61-b385-eb984b2f329f" :knowledge-point/title "Cases Where Further Simplification Is Needed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08834aad-855d-5f34-a2a9-88ed02914db0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{27}" :db/id #edb/ref 17592186484831} {:answer/id #uuid "293577e5-ec0c-5386-8f6a-ae3dd3b5a516" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{9}" :db/id #edb/ref 17592186484896} {:answer/id #uuid "c3a892be-98c8-518b-878d-988ded593924" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{9}" :db/id #edb/ref 17592186485235} {:answer/id #uuid "c3b6e228-4f64-52aa-aa6f-451fa1f7180f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{27}" :db/id #edb/ref 17592186485236} {:answer/id #uuid "ee2f8dbe-b7d6-5ec4-b856-e83b6f6604fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{15}}{9}" :db/id #edb/ref 17592186485322}] :answer-field/correct {:answer/id #uuid "ee2f8dbe-b7d6-5ec4-b856-e83b6f6604fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{15}}{9}" :db/id #edb/ref 17592186485322} :answer-field/id #uuid "91476299-4b29-5a42-b053-5f639a6f9a67" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485428}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0f188433-9891-58cb-8279-ce3757720a45" :question/math-academy-id "q-212962" :question/problem "$\\frac{\\sqrt{5}}{\\sqrt{27}}=$" :question/worked-solution "To remove the radical $\\sqrt{27}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{27}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{5}}{\\sqrt{27}} & = \\\\ \\frac{\\sqrt{5}}{\\sqrt{27}}\\cdot \\frac{\\sqrt{27}}{\\sqrt{27}} & = \\\\ \\frac{\\sqrt{5}\\cdot \\sqrt{27}}{(\\sqrt{27})^{2}} & = \\\\ \\frac{\\sqrt{5}\\cdot \\sqrt{27}}{27} & \\end{aligned}\n$$\n\nNext, we notice that $27$ has a perfect square factor $(9).$ Therefore, we can rewrite $\\sqrt{27}$ as follows:\n\n$$\n\\begin{aligned}\\sqrt{27} & = \\\\ \\sqrt{9\\cdot 3} & = \\\\ \\sqrt{9}\\cdot \\sqrt{3} & = \\\\ 3\\sqrt{3} & \\end{aligned}\n$$\n\nFinally, we simplify our original fraction as follows:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{5}\\cdot \\sqrt{27}}{27} & = \\\\ \\frac{\\sqrt{5}\\cdot 3\\sqrt{3}}{27} & = \\\\ \\frac{3\\cdot \\sqrt{5}\\cdot \\sqrt{3}}{27} & = \\\\ \\frac{\\sqrt{5}\\cdot \\sqrt{3}}{9} & = \\\\ \\frac{\\sqrt{5\\cdot 3}}{9} & = \\\\ \\frac{\\sqrt{15}}{9}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485527 :knowledge-point/_questions [{:db/id #edb/ref 17592186105704 :knowledge-point/id #uuid "7e7047fd-14f2-5325-8959-f24fa670f453" :knowledge-point/title "Rationalizing a Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ab51a2b-ff73-58de-ad0a-cd66bce378a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{7}}{7}" :db/id #edb/ref 17592186484835} {:answer/id #uuid "78c453c0-711b-5768-8ab2-a124de54801c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{14}" :db/id #edb/ref 17592186485077} {:answer/id #uuid "88bb840a-c599-5eed-b971-f454770a6101" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}-1}{7}" :db/id #edb/ref 17592186485116} {:answer/id #uuid "8cf2cbe1-74fd-51c1-9768-385fe9fb9282" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{49}" :db/id #edb/ref 17592186485123} {:answer/id #uuid "f071350b-76b7-57dc-9875-9ccc8404b