#{[{:db/id #edb/ref 17592186237874 :knowledge-point/_questions [{:db/id #edb/ref 17592186059863 :knowledge-point/id #uuid "852449ca-b4df-5142-9540-bb503d5b7b62" :knowledge-point/title "Differentiating a Negative Power Function Using the Constant Multiple Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "140ff256-58cb-520e-bd9f-ea7c8a886af9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2\\sqrt{{x}^{5}}}" :db/id #edb/ref 17592186235938 :task-item/_responses [{:db/id #edb/ref 17592186502852}]} {:answer/id #uuid "1b82390d-5224-5735-9b05-52d62582a7a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x}}" :db/id #edb/ref 17592186235987} {:answer/id #uuid "42c2e22e-7c41-5aba-866b-c2bfb66a3484" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3\\sqrt{{x}^{5}}}" :db/id #edb/ref 17592186236246} {:answer/id #uuid "76520e43-a300-5719-9281-b069c04cc15c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3\\sqrt{x}}" :db/id #edb/ref 17592186236558} {:answer/id #uuid "8f7c3eb2-612e-5bea-9351-f3a4af8fd436" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{{x}^{3}}}" :db/id #edb/ref 17592186236726}] :answer-field/correct {:answer/id #uuid "140ff256-58cb-520e-bd9f-ea7c8a886af9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2\\sqrt{{x}^{5}}}" :db/id #edb/ref 17592186235938} :answer-field/id #uuid "fbea9dd8-14a2-537f-a32b-13a92d5ed3d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237769}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ec04a0d1-192f-5dcf-aa4b-20bf3669c6e0" :question/math-academy-id "q-102192" :question/problem "If $y=\\frac{1}{3\\sqrt{{x}^{3}}},$ find $\\frac{dy}{dx}.$" :question/worked-solution "We first rewrite the function as\n\n$$\ny=\\frac{1}{3\\sqrt{{x}^{3}}}=\\frac{1}{3}{x}^{-3/2}.\n$$\n\nThen, we apply the constant multiple and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{3}{x}^{-3/2}) \\\\  & =\\frac{1}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-3/2}) \\\\  & =\\frac{1}{3}\\cdot (-\\frac{3}{2}){x}^{(-\\frac{3}{2}-1)} \\\\  & =-\\frac{1}{2}{x}^{-5/2} \\\\  & =-\\frac{1}{2\\sqrt{{x}^{5}}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186535979 :knowledge-point/_questions [{:db/id #edb/ref 17592186059865 :knowledge-point/id #uuid "f8e49a0c-9575-5bd0-af4e-6463495e56b3" :knowledge-point/title "Differentiating a Sum of Functions With Constant Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11aebb25-3c41-52e1-bf66-1dcd7ee2ce0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14{x}^{6}-\\frac{2}{{x}^{3}}-2" :db/id #edb/ref 17592186535466} {:answer/id #uuid "3e200482-d133-5eb7-8136-1d3336aff1e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14{x}^{6}+\\frac{2}{{x}^{3}}+2" :db/id #edb/ref 17592186535528} {:answer/id #uuid "a80acf4a-b6f9-58b9-ac0e-e6ed94b44fb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14{x}^{6}-\\frac{2}{{x}^{3}}" :db/id #edb/ref 17592186535696} {:answer/id #uuid "a849b7f1-4748-5906-8130-819ebcc7baa6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7{x}^{6}-\\frac{2}{{x}^{3}}+2" :db/id #edb/ref 17592186535697} {:answer/id #uuid "cc1c08e7-f8dc-506c-9813-764d2dd4e5df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14{x}^{6}-\\frac{2}{{x}^{3}}+2" :db/id #edb/ref 17592186535742}] :answer-field/correct {:answer/id #uuid "cc1c08e7-f8dc-506c-9813-764d2dd4e5df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14{x}^{6}-\\frac{2}{{x}^{3}}+2" :db/id #edb/ref 17592186535742} :answer-field/id #uuid "4419ee0e-8651-52b9-9b46-c0466ee66f3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535856}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a746a92c-9180-5bad-bfc6-5ca557baf9cb" :question/math-academy-id "q-10292" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=2{x}^{7}+\\frac{1}{{x}^{2}}+2x-2.$" :question/worked-solution "Here, we apply the addition, constant multiple, and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{7}+\\frac{1}{{x}^{2}}+2x-2) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{7})+\\frac{\\text{d}}{\\text{d}x}({x}^{-2})+\\frac{\\text{d}}{\\text{d}x}(2x)-\\frac{\\text{d}}{\\text{d}x}(2) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{7})+\\frac{\\text{d}}{\\text{d}x}({x}^{-2})+2\\cdot \\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(2) \\\\  & =2\\cdot 7{x}^{(7-1)}+(-2){x}^{(-2-1)}+2\\cdot 1-0 \\\\  & =14{x}^{6}-2{x}^{-3}+2 \\\\  & =14{x}^{6}-\\frac{2}{{x}^{3}}+2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186535994 :knowledge-point/_questions [{:db/id #edb/ref 17592186059865 :knowledge-point/id #uuid "f8e49a0c-9575-5bd0-af4e-6463495e56b3" :knowledge-point/title "Differentiating a Sum of Functions With Constant Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "215a3196-aa1e-53fe-ba9a-dd584d06fa02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14{x}^{6}-24x+\\frac{5\\sqrt[4]{x}}{4}" :db/id #edb/ref 17592186535484} {:answer/id #uuid "29372cbb-de9f-5045-bc68-a6f3e039aa5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{6}-24x+\\frac{5}{4\\sqrt[3]{x}}" :db/id #edb/ref 17592186535498} {:answer/id #uuid "8e201c30-afed-5567-a27a-5f1d97078f77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14{x}^{6}+24x+\\frac{5{x}^{-\\frac{1}{4}}}{4}" :db/id #edb/ref 17592186535662} {:answer/id #uuid "cc7fe356-6709-56ff-968f-0b948652e8e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14{x}^{6}+22x-\\frac{5{x}^{\\frac{1}{4}}}{4}" :db/id #edb/ref 17592186535743} {:answer/id #uuid "e3f7bb4e-6f66-5b0b-ba5e-25005bb49ba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14{x}^{6}-12{x}^{2}+\\frac{5{x}^{\\frac{1}{2}}}{4}" :db/id #edb/ref 17592186535785}] :answer-field/correct {:answer/id #uuid "215a3196-aa1e-53fe-ba9a-dd584d06fa02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14{x}^{6}-24x+\\frac{5\\sqrt[4]{x}}{4}" :db/id #edb/ref 17592186535484} :answer-field/id #uuid "ba01c00d-e4ab-58b9-976c-4280882e9d75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535901}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cd92c8db-d853-53b3-99d2-6ad9bcebe052" :question/math-academy-id "q-1861" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=-4+2{x}^{7}-12{x}^{2}+{x}^{5/4}.$" :question/worked-solution "Here, we apply the addition, constant multiple, and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-4+2{x}^{7}-12{x}^{2}+{x}^{5/4}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(-4)+\\frac{\\text{d}}{\\text{d}x}(2{x}^{7})-\\frac{\\text{d}}{\\text{d}x}(12{x}^{2})+\\frac{\\text{d}}{\\text{d}x}({x}^{5/4}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(-4)+2\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{7})-12\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}({x}^{5/4}) \\\\  & =0+2\\cdot 7{x}^{(7-1)}-12\\cdot 2{x}^{(2-1)}+\\frac{5}{4}\\cdot {x}^{(\\frac{5}{4}-1)} \\\\  & =14{x}^{6}-24x+\\frac{5}{4}{x}^{1/4} \\\\  & =14{x}^{6}-24x+\\frac{5\\sqrt[4]{x}}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186535966 :knowledge-point/_questions [{:db/id #edb/ref 17592186059864 :knowledge-point/id #uuid "d3469bdd-a201-5219-a734-ed3caa6b039a" :knowledge-point/title "Differentiating a Sum of Functions Without Constant Factors Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f7c7324-2c11-5c83-acfa-b2ee47b3214b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{x}^{7}-3{x}^{2}+\\frac{2}{{x}^{3}}" :db/id #edb/ref 17592186535483} {:answer/id #uuid "628bae58-14c7-519d-8c7b-b62c7c8633da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{x}^{7}-3{x}^{2}-\\frac{3}{{x}^{3}}" :db/id #edb/ref 17592186535589} {:answer/id #uuid "cd3b37bf-ff7e-534a-a633-94c74472b5b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7{x}^{7}-3{x}^{2}-\\frac{2}{{x}^{3}}" :db/id #edb/ref 17592186535745} {:answer/id #uuid "db9820bc-9141-5706-b4b9-696ff0f4d463" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{x}^{7}-3{x}^{2}-\\frac{2}{{x}^{3}}" :db/id #edb/ref 17592186535770} {:answer/id #uuid "fdc03597-2e55-5dbe-b2dc-cac7ff614227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{x}^{7}-2{x}^{2}-\\frac{2}{{x}^{3}}" :db/id #edb/ref 17592186535828}] :answer-field/correct {:answer/id #uuid "db9820bc-9141-5706-b4b9-696ff0f4d463" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{x}^{7}-3{x}^{2}-\\frac{2}{{x}^{3}}" :db/id #edb/ref 17592186535770} :answer-field/id #uuid "86ad7852-6087-5de6-850f-cd1888a6eb84" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535880}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8a7a18a3-9c4b-5644-bbba-c016ec6ec070" :question/math-academy-id "q-70507" :question/problem "Find ${f}^{′}(x)$ for  $f(x)={x}^{8}-{x}^{3}+\\frac{1}{{x}^{2}}.$" :question/worked-solution "The function $f(x)$ is the sum of three power functions. So, we apply the sum rule, and we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{8}-{x}^{3}+\\frac{1}{{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{8})-\\frac{\\text{d}}{\\text{d}x}({x}^{3})+\\frac{\\text{d}}{\\text{d}x}({x}^{-2}) \\\\  & =8{x}^{(8-1)}-3{x}^{(3-1)}+(-2){x}^{-2-1} \\\\  & =8{x}^{7}-3{x}^{2}-2{x}^{-3} \\\\  & =8{x}^{7}-3{x}^{2}-\\frac{2}{{x}^{3}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186535945 :knowledge-point/_questions [{:db/id #edb/ref 17592186059864 :knowledge-point/id #uuid "d3469bdd-a201-5219-a734-ed3caa6b039a" :knowledge-point/title "Differentiating a Sum of Functions Without Constant Factors Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49ef83ba-2eda-583f-b227-7dc00e66db76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+\\frac{1}{\\sqrt{x}}-\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186535543} {:answer/id #uuid "50a9d952-ca58-515d-b1b3-d5444dbbbd57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-\\frac{1}{2\\sqrt{x}}+\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186535557} {:answer/id #uuid "63aaf731-d747-572e-8b0f-86051724c920" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+\\frac{1}{2\\sqrt{x}}-\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186535592} {:answer/id #uuid "79a69091-2708-57af-a95c-cea22cfae627" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+\\frac{1}{\\sqrt{x}}+\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186535623} {:answer/id #uuid "87845c36-7288-53ed-a176-4fdc76ecaa99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+\\frac{1}{2\\sqrt{x}}+\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186535650}] :answer-field/correct {:answer/id #uuid "87845c36-7288-53ed-a176-4fdc76ecaa99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+\\frac{1}{2\\sqrt{x}}+\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186535650} :answer-field/id #uuid "af40c564-a593-533d-9007-1735d6d363e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535894}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "41b5b51f-ba4d-5684-ad06-c34aebd809fa" :question/math-academy-id "q-70510" :question/problem "Find ${f}^{′}(x)$ for  $f(x)={x}^{2}+\\sqrt{x}-\\frac{1}{x}.$" :question/worked-solution "The function $f(x)$ is the sum of three power functions. So, we apply the sum rule, and we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}+\\sqrt{x}-\\frac{1}{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}({x}^{1/2})-\\frac{\\text{d}}{\\text{d}x}({x}^{-1}) \\\\  & =2{x}^{(2-1)}+\\frac{1}{2}{x}^{1/2-1}-(-1){x}^{(-1-1)} \\\\  & =2x+\\frac{1}{2}{x}^{-1/2}+{x}^{-2} \\\\  & =2x+\\frac{1}{2\\sqrt{x}}+\\frac{1}{{x}^{2}}.\\end{aligned}\n$$"}]}
