#{[{:db/id #edb/ref 17592186237874 :knowledge-point/_questions [{:db/id #edb/ref 17592186059863 :knowledge-point/id #uuid "852449ca-b4df-5142-9540-bb503d5b7b62" :knowledge-point/title "Differentiating a Negative Power Function Using the Constant Multiple Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "140ff256-58cb-520e-bd9f-ea7c8a886af9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2\\sqrt{{x}^{5}}}" :db/id #edb/ref 17592186235938 :task-item/_responses [{:db/id #edb/ref 17592186502852}]} {:answer/id #uuid "1b82390d-5224-5735-9b05-52d62582a7a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x}}" :db/id #edb/ref 17592186235987} {:answer/id #uuid "42c2e22e-7c41-5aba-866b-c2bfb66a3484" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3\\sqrt{{x}^{5}}}" :db/id #edb/ref 17592186236246} {:answer/id #uuid "76520e43-a300-5719-9281-b069c04cc15c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3\\sqrt{x}}" :db/id #edb/ref 17592186236558} {:answer/id #uuid "8f7c3eb2-612e-5bea-9351-f3a4af8fd436" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{{x}^{3}}}" :db/id #edb/ref 17592186236726}] :answer-field/correct {:answer/id #uuid "140ff256-58cb-520e-bd9f-ea7c8a886af9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2\\sqrt{{x}^{5}}}" :db/id #edb/ref 17592186235938} :answer-field/id #uuid "fbea9dd8-14a2-537f-a32b-13a92d5ed3d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237769}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ec04a0d1-192f-5dcf-aa4b-20bf3669c6e0" :question/math-academy-id "q-102192" :question/problem "If $y=\\frac{1}{3\\sqrt{{x}^{3}}},$ find $\\frac{dy}{dx}.$" :question/worked-solution "We first rewrite the function as\n\n$$\ny=\\frac{1}{3\\sqrt{{x}^{3}}}=\\frac{1}{3}{x}^{-3/2}.\n$$\n\nThen, we apply the constant multiple and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{3}{x}^{-3/2}) \\\\  & =\\frac{1}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-3/2}) \\\\  & =\\frac{1}{3}\\cdot (-\\frac{3}{2}){x}^{(-\\frac{3}{2}-1)} \\\\  & =-\\frac{1}{2}{x}^{-5/2} \\\\  & =-\\frac{1}{2\\sqrt{{x}^{5}}}\\end{aligned}\n$$"}]}
