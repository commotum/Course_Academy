#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186562568} :activity/id #uuid "160751ec-aa7e-5a05-957b-e3cae6283690" :activity/scope {:db/id #edb/ref 17592186049931 :topic/id #uuid "1f6ee093-7e77-5fea-be72-a47ed3862b7a" :topic/math-academy-id 133} :activity/steps [{:db/id #edb/ref 17592186562556 :step/content {:db/id #edb/ref 17592186562487 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03edd520-2d8a-5304-bab2-d26ecd618e4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "u=2" :db/id #edb/ref 17592186561593} {:answer/id #uuid "2fb68bc0-1d7a-5f48-89b9-cc0d4de995b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "u=-3,2" :db/id #edb/ref 17592186561708} {:answer/id #uuid "306a0eb7-d657-5734-a843-ce10d5c8d558" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "u=-3,-\\frac{1}{2}" :db/id #edb/ref 17592186561709} {:answer/id #uuid "80801ef1-0330-5778-8494-9cc535ea3566" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "u=-\\frac{1}{2}" :db/id #edb/ref 17592186561903} {:answer/id #uuid "9d930647-e99f-599d-83de-1dfa90c26c77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "u=-3" :db/id #edb/ref 17592186561971}] :answer-field/correct {:db/id #edb/ref 17592186561593} :answer-field/id #uuid "79108aad-c42b-57e7-8cd3-4a21d370addc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186562302}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bdc209cb-0420-5821-949d-4d1c662e04c2" :question/math-academy-id "q-24751" :question/problem "Solve $f(u)=0$ where $f(u)=\\frac{6{u}^{2}+6u-36}{3{u}^{2}+9u}.$" :question/worked-solution "First, we factor the numerator and denominator and cancel any common factors, as follows:\n\n$$\n\\begin{aligned}f(u) & =\\frac{6{u}^{2}+6u-36}{3{u}^{2}+9u} \\\\  & =\\frac{6({u}^{2}+u-6)}{3u(u+3)} \\\\  & =\\frac{6(u+3)(u-2)}{3u(u+3)} \\\\  & =\\frac{2\\cdot \\cancel{3(u+3)}(u-2)}{u\\cdot \\cancel{3(u+3)}} \\\\  & =\\frac{2(u-2)}{u}\\end{aligned}\n$$\n\nNow, we set the numerator equal to zero and solve for $u:$\n\n$$\n\\begin{aligned}2(u-2) & =0\\,⟹\\,u=2\\end{aligned}\n$$\n\nTherefore, the solution to $f(u)=0$ is $u=2.$"} :step/id #uuid "8225f958-6907-55a2-87a7-beaf1d7a5cd5" :step/next {:db/id #edb/ref 17592186562592}} {:db/id #edb/ref 17592186562568 :step/content {:db/id #edb/ref 17592186055162 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bfe5796-8d7c-5939-bfd7-7630045898fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=-5,1" :db/id #edb/ref 17592186561659} {:answer/id #uuid "23680efc-ed62-58c3-81ad-6db5b3887072" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=-2,-1" :db/id #edb/ref 17592186561677} {:answer/id #uuid "2fa3dcff-2a62-52aa-8643-c454d9cae8b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=-2" :db/id #edb/ref 17592186561707} {:answer/id #uuid "7395031c-ba77-5eee-a64a-3480f58187a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=1" :db/id #edb/ref 17592186561869} {:answer/id #uuid "73a6bbee-d501-5ef4-858c-ab3bff68963d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=-5" :db/id #edb/ref 17592186561870}] :answer-field/correct {:db/id #edb/ref 17592186561869} :answer-field/id #uuid "13931555-bff4-56fe-95de-fbb9171fc93b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186052301}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e5098d3a-4817-5f77-ac96-9211b5cb09b9" :question/math-academy-id "q-24659" :question/problem "Find the roots of $g(z)=\\frac{{z}^{3}+5{z}^{2}-z-5}{{z}^{3}+6{z}^{2}+5z}.$" :question/worked-solution "The roots of $g(z)$ are the solutions to the equation $g(z)=0.$ In our case, we have\n\n$$\n\\frac{{z}^{3}+5{z}^{2}-z-5}{{z}^{3}+6{z}^{2}+5z}=0.\n$$\n\nFirst, we factor the numerator and denominator and cancel any common factors, as follows:\n\n$$\n\\begin{aligned}g(z) & =\\frac{{z}^{3}+5{z}^{2}-z-5}{{z}^{3}+6{z}^{2}+5z} \\\\  & =\\frac{{z}^{2}(z+5)-(z+5)}{z({z}^{2}+6z+5)} \\\\  & =\\frac{({z}^{2}-1)(z+5)}{z(z+1)(z+5)} \\\\  & =\\frac{(z+1)(z-1)(z+5)}{z(z+1)(z+5)} \\\\  & =\\frac{(z-1)\\cancel{(z+1)(z+5)}}{z\\cancel{(z+1)(z+5)}} &  \\\\  & =\\frac{z-1}{z}\\end{aligned}\n$$\n\nNow, we set the numerator equal to zero and solve for $z:$\n\n$$\n\\begin{aligned}z-1=0\\,⟹\\,z=1\\end{aligned}\n$$\n\nTherefore, the solution to $g(z)=0$ is $z=1.$"} :step/id #uuid "bb3b734c-c58b-56b8-b550-f52bad4497fe" :step/next {:db/id #edb/ref 17592186562556}} {:db/id #edb/ref 17592186562592 :step/content {:db/id #edb/ref 17592186562444 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b5cd153-42b8-5bd6-a18f-8582a64b496a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h=-6" :db/id #edb/ref 17592186561807} {:answer/id #uuid "85e2edb2-a2b9-5f19-a907-276b2ad76eca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h=-3,\\,0" :db/id #edb/ref 17592186561917} {:answer/id #uuid "98f87aaa-f0ac-5dbe-9bbb-7debc8206252" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No real roots" :db/id #edb/ref 17592186561962} {:answer/id #uuid "a092c7e6-c899-5761-8a60-1ef5cb6c18ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h=1,2" :db/id #edb/ref 17592186561980} {:answer/id #uuid "d1eae01a-a822-543e-b070-de653252b491" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h=-5" :db/id #edb/ref 17592186562110}] :answer-field/correct {:db/id #edb/ref 17592186561962} :answer-field/id #uuid "ae519442-efbc-59f7-9c86-1ccd80d4bcda" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186562334}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "717167d3-5022-5ef5-94d0-b4fbd3628130" :question/math-academy-id "q-25305" :question/problem "Find the roots of $f(h)=\\frac{3{h}^{2}+18}{{h}^{2}+10h+25}.$" :question/worked-solution "The roots of $f(h)$ are the solutions to the equation $f(h)=0.$ In our case, we have\n\n$$\n\\frac{3{h}^{2}+18}{{h}^{2}+10h+25}=0.\n$$\n\nFirst, we factor $f(h),$ as follows:\n\n$$\n\\begin{aligned}f(h) & =\\frac{3{h}^{2}+18}{{h}^{2}+10h+25} \\\\  & =\\frac{3({h}^{2}+6)}{(h+5)^{2}}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we set the numerator equal to zero and solve for $h:$\n\n$$\n3({h}^{2}+6)=0\n$$\n\nSince ${h}^{2}+6>0$ for all $h,$ there is no real solution to $f(h)=0.$ Therefore, $f(h)$ has no real roots."} :step/id #uuid "fda652b0-dc8e-5347-a849-96c8bb6a4121"}] :activity/title "Roots of Rational Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186561561}]}
