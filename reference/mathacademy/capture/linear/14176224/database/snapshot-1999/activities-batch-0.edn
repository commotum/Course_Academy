#{[{:activity/first-step {:db/id #edb/ref 17592186111733} :activity/id #uuid "9857734b-5bab-54f4-a580-a7385aea30f3" :activity/scope {:db/id #edb/ref 17592186048174 :topic/id #uuid "85adbb4a-1472-583d-a6f0-528ebb0b39cc" :topic/math-academy-id 1437} :activity/steps [{:db/id #edb/ref 17592186111609 :step/content {:db/id #edb/ref 17592186110670 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110291 :question/id #uuid "60df6f7a-5257-5081-ba0c-0e9499a15f23" :question/math-academy-id "e-10588"} :knowledge-point/id #uuid "5ac4127f-1253-5aee-b524-84e5c6b2bc64" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673} {:db/id #edb/ref 17592186050452} {:db/id #edb/ref 17592186050494}] :knowledge-point/questions [{:db/id #edb/ref 17592186111241} {:db/id #edb/ref 17592186111279} {:db/id #edb/ref 17592186233215}] :knowledge-point/title "Calculating Angles From Right, Straight, and Full Angles Using Algebra"} :step/id #uuid "9d2f5fba-20ef-5cac-9659-5aee4c02e5a5" :step/math-academy-id 40025 :step/next {:db/id #edb/ref 17592186111742}} {:db/id #edb/ref 17592186111733 :step/content {:db/id #edb/ref 17592186111840 :tutorial/content "When solving problems with angles, it is helpful to remember the following classifications:\n\n- a **null** angle has a measure of $0^\\circ$,\n- an **acute** angle has a measure between $0^\\circ$ and $90^\\circ$,\n- a **right** angle has a measure of $90^\\circ$,\n- an **obtuse** angle has a measure between $90^\\circ$ and $180^\\circ$,\n- a **straight** angle has a measure of $180^\\circ$,\n- a **reflex** angle has a measure between $180^\\circ$ and $360^\\circ$, and\n- a **full** angle has a measure of $360^\\circ$.\n\nIt is also helpful to remember that when two lines meet at a point, the opposite angles are called **vertical angles**. Vertical angles are congruent, and consequently they have the same measure." :tutorial/id #uuid "282e8601-d3f4-5c34-a96b-a071a96de244" :tutorial/math-academy-id 2182 :tutorial/title "Introduction"} :step/id #uuid "d8e313bb-3f6b-5512-9eaa-d26017f922aa" :step/math-academy-id 8758 :step/next {:db/id #edb/ref 17592186111743}} {:db/id #edb/ref 17592186111742 :step/content {:db/id #edb/ref 17592186110759 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110387 :question/id #uuid "826ef015-53ba-5889-8749-170a656c35f9" :question/math-academy-id "e-2590"} :knowledge-point/id #uuid "9d62f753-a3e0-5c7e-919d-3f878c1d8e93" :knowledge-point/questions [{:db/id #edb/ref 17592186111245} {:db/id #edb/ref 17592186111246}] :knowledge-point/title "Finding the Measure of Unknown Angles on a Diagram"} :step/id #uuid "d8bbc417-4a3f-577b-991f-4a7306fb343e" :step/math-academy-id 8768} {:db/id #edb/ref 17592186111743 :step/content {:db/id #edb/ref 17592186110760 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110390 :question/id #uuid "6438b232-f40a-54b0-a599-a1d6aa4151d2" :question/math-academy-id "e-2599"} :knowledge-point/id #uuid "f64be210-e966-5be7-b7b4-cbf859793e76" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048723} {:db/id #edb/ref 17592186050016} {:db/id #edb/ref 17592186050889}] :knowledge-point/questions [{:db/id #edb/ref 17592186111247} {:db/id #edb/ref 17592186111248}] :knowledge-point/title "Identifying Angle Types From a Diagram"} :step/id #uuid "8ad48197-e2e5-58b1-af58-7632d0bd7fe9" :step/math-academy-id 8772 :step/next {:db/id #edb/ref 17592186111744}} {:db/id #edb/ref 17592186111744 :step/content {:db/id #edb/ref 17592186110761 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110391 :question/id #uuid "15470df7-8d18-5427-9488-f3f10df13952" :question/math-academy-id "e-2601"} :knowledge-point/id #uuid "fea607a9-7512-5062-b4ae-c53e0f653efd" :knowledge-point/questions [{:db/id #edb/ref 17592186111249} {:db/id #edb/ref 17592186111250}] :knowledge-point/title "Identifying an Angle Type From a Description"} :step/id #uuid "1a60a9ec-5f67-5382-8520-b964b945c556" :step/math-academy-id 8773 :step/next {:db/id #edb/ref 175921861