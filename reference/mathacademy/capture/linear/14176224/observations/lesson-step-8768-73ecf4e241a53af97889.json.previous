L463 519Q447 492 400 412L310 260L413 259Q516 259 516 260Z\"></path>\n<path stroke-width=\"1\" id=\"E1-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E1-MJMAIN-2220\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMATHI-45\" x=\"722\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMATHI-4F\" x=\"1487\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMATHI-41\" x=\"2250\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-2E\" x=\"3001\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p><br></p>\n<div id=\"graphic-0dedb3faf4277792f61ed915e3c725d1\" class=\"graphic\"><img src=\"/graphics/0dedb3faf4277792f61ed915e3c725d1\"></div>\n\n<p><br></p>\n\n            </div>     \n\n            <div class=\"explanationHeader\">EXPLANATION</div>\n\n            <div class=\"exampleExplanation\">\n                <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n         