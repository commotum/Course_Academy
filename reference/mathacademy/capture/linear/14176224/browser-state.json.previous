i><mi>B</mi><mi>O</mi><mi>C</mi><mo>+</mo><mi>m</mi><mi mathvariant=\"normal\">∠</mi><mi>B</mi><mi>O</mi><mi>C</mi><mo>+</mo><mn>2</mn><mi>m</mi><mi mathvariant=\"normal\">∠</mi><mi>B</mi><mi>O</mi><mi>C</mi><mo>+</mo><mi>m</mi><mi mathvariant=\"normal\">∠</mi><mi>B</mi><mi>O</mi><mi>C</mi></mtd><mtd><mi></mi><mo>=</mo><msup><mn>180</mn><mo>∘</mo></msup></mtd></mtr><mtr><mtd><mn>6</mn><mi>m</mi><mi mathvariant=\"normal\">∠</mi><mi>B</mi><mi>O</mi><mi>C</mi></mtd><mtd><mi></mi><mo>=</mo><msup><mn>180</mn><mo>∘</mo></msup></mtd></mtr><mtr><mtd><mi>m</mi><mi mathvariant=\"normal\">∠</mi><mi>B</mi><mi>O</mi><mi>C</mi></mtd><mtd><mi></mi><mo>=</mo><msup><mn>30</mn><mo>∘</mo></msup></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
