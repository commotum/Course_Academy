#{[{:activity/first-step {:db/id #edb/ref 17592186055665} :activity/id #uuid "40577614-a645-5158-87b0-7de3abacb744" :activity/scope {:db/id #edb/ref 17592186048714 :topic/id #uuid "b7fe06e7-3f98-52b2-a1fd-cb5abc5211b1" :topic/math-academy-id 94} :activity/steps [{:db/id #edb/ref 17592186055665 :step/content {:db/id #edb/ref 17592186055944 :tutorial/content "A **linear equation** in the variables $x$ and $y$ is an equation that involves just these two variables, possibly with some constants. There should be no powers on any of the variables and the variables can't be multiplied together.\n\nFor example, the following are linear equations:\n\n$$\ny = x + 4, \\qquad y = -3x, \\qquad 5y = 6x,\\qquad 2x + 3y = 9\n$$\n\nOn the other hand, the following are *not* linear equations:\n\n$$\ny = x^2 - 2x, \\qquad y^2 =-4x + 2, \\qquad y = 2xy\n$$\n\nA **solution** of a linear equation is an **ordered pair** $(x,y)$ that makes the equation true.\n\nFor instance, the ordered pair $(3, 7)$ is a solution to the equation $y = 3x - 2$ because if we replace $x$ with $3$ and $y$ with $7$, we get\n\n$$\n\\begin{aligned}\ny &= 3x - 2 \\\\\n(7) &= 3(3) - 2 \\\\\n7 &= 9 - 2 \\\\\n7 &= 7✓\n\\end{aligned}\n$$\n\nThe above is a true statement, so $(3, 7)$ is a solution to the equation $y = 3x - 2$.\n\n**Important**: A linear equation in two variables has an infinite number of solutions, not just one!" :tutorial/id #uuid "c51c3f80-5dd0-5f6e-a939-4d11e9f42c71" :tutorial/math-academy-id 1434 :tutorial/title "Introduction"} :step/id #uuid "211a44d5-a58c-5fbe-a3cf-ed18f6b84304" :step/math-academy-id 3240 :step/next {:db/id #edb/ref 17592186055667}} {:db/id #edb/ref 17592186055666 :step/content {:db/id #edb/ref 17592186054692 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054600 :question/id #uuid "6ad1a495-0d7f-56b8-9c58-7b36a8871f58" :question/math-academy-id "e-980"} :knowledge-point/id #uuid "ab1cee02-754b-5431-b20a-cca551442193" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673}] :knowledge-point/questions [{:db/id #edb/ref 17592186055121} {:db/id #edb/ref 17592186055293}] :knowledge-point/title "Finding a Missing Coordinate in a Solution"} :step/id #uuid "8fa56433-7106-5c17-8d75-6ca7cadc10b0" :step/math-academy-id 3245} {:db/id #edb/ref 17592186055667 :step/content {:db/id #edb/ref 17592186054693 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054601 :question/id #uuid "067ce3f7-236f-5422-8f42-251f2619f6ad" :question/math-academy-id "e-981"} :knowledge-point/id #uuid "1fe6fbb4-545d-5db8-9042-2c5fac1add72" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050414} {:db/id #edb/ref 17592186050517}] :knowledge-point/questions [{:db/id #edb/ref 17592186055294} {:db/id #edb/ref 17592186055295}] :knowledge-point/title "Identifying a Solution to a Given Equation"} :step/id #uuid "4872dcd8-76b2-552b-a339-e8d14824b690" :step/math-academy-id 3248 :step/next {:db/id #edb/ref 17592186055666}}] :activity/title "Two-Variable Linear Equations and Their Solutions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054934}]}
