#{[{:db/id #edb/ref 17592186054600 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054692 :knowledge-point/id #uuid "ab1cee02-754b-5431-b20a-cca551442193" :knowledge-point/title "Finding a Missing Coordinate in a Solution"}] :question/id #uuid "6ad1a495-0d7f-56b8-9c58-7b36a8871f58" :question/math-academy-id "e-980" :question/problem "A solution to the linear equation $y-5x=2$ is the ordered pair $(2,k).$ What is the value of $k?$" :question/worked-solution "Since $(2,k)$ is a solution to the linear equation $y-5x=2,$ the equation must turn into a true statement if we substitute $2$ and $k$ for $x$ and $y.$ So, we replace $x$ with $2$ and $y$ with $k,$ as follows:\n\n$$\n\\begin{aligned}y-5x & =2 \\\\ (k)-5(2) & =2 \\\\ k-10 & =2\\end{aligned}\n$$\n\nThen, we solve for $k\\mathbin{:}$\n\n$$\n\\begin{aligned}k-10 & =2 \\\\ k & =12\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054601 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054693 :knowledge-point/id #uuid "1fe6fbb4-545d-5db8-9042-2c5fac1add72" :knowledge-point/title "Identifying a Solution to a Given Equation"}] :question/id #uuid "067ce3f7-236f-5422-8f42-251f2619f6ad" :question/math-academy-id "e-981" :question/problem "Which of the given points is a solution to $y=-2x+1?$\n\n![](images/b9/b921dae09304534b2176dbc7a74c75c4ab36c76c67edb6b97cbe358bc703c6b5.png)" :question/worked-solution "The plotted points correspond to the $xy$-pairs $A(-1, 3)$ and $B(2,-4).$ To check whether each point is a solution to the equation, we substitute it into the equation and see if it results in a true statement.\n\nFirst, we substitute $A(-1,3)$ into the equation:\n\n$$\n\\begin{aligned}y & =-2x+1 \\\\ (3) & =-2(-1)+1 \\\\ 3 & =3\\,✓\\end{aligned}\n$$\n\nThe result is a true statement, so $A(-1,3)$ is a solution to the equation.\n\nNext, we substitute $B(2,-4)$ into the equation:\n\n$$\n\\begin{aligned}y & =-2x+1 \\\\ (-4) & =-2(2)+1 \\\\ -4 & =-4+1 \\\\ -4 & =-3\\,\\times \\end{aligned}\n$$\n\nThe result is a false statement, so $B(2,-4)$ is *not* solution to the equation.\n\nTherefore, only $A(-1,3)$ is a solution to the equation."}] [{:db/id #edb/ref 17592186490301 :knowledge-point/_questions [{:db/id #edb/ref 17592186054692 :knowledge-point/id #uuid "ab1cee02-754b-5431-b20a-cca551442193" :knowledge-point/title "Finding a Missing Coordinate in a Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "067c44d3-8150-574c-a44d-e208db72c5ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186489528} {:answer/id #uuid "0cf455f0-1f2c-5ba3-aa35-ee30c16a38d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186489542} {:answer/id #uuid "b5e0a9bf-0018-5d22-b9fb-a05f84f821e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186489913} {:answer/id #uuid "cce19abc-3226-57b7-802f-3d71ca5373e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186489968} {:answer/id #uuid "d9217400-cdfc-5a2e-97b5-b0d1c59e8d48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186489993}] :answer-field/correct {:answer/id #uuid "067c44d3-8150-574c-a44d-e208db72c5ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186489528} :answer-field/id #uuid "2df45d58-6a1d-5cd7-baed-6c5a3a222eac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490095}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c3d050d6-291f-571b-896c-061ed6a76fc9" :question/math-academy-id "q-109037" :question/problem "A solution to the linear equation $y=4x-11$ is the ordered pair $(2,h).$ What is the value of $h?$" :question/worked-solution "Since $(2,h)$ is a solution to the linear equation $y=4x-11,$ the equation must turn into a true statement if we substitute $2$ and $h$ for $x$ and $y.$ So, we replace $x$ with $2$ and $y$ with $h,$ as follows:\n\n$$\n\\begin{aligned}y & =4x-11 \\\\ (h) & =4(2)-11 \\\\ h & =8-11 \\\\ h & =-3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186490226 :knowledge-point/_questions [{:db/id #edb/ref 17592186054692 :knowledge-point/id #uuid "ab1cee02-754b-5431-b20a-cca551442193" :knowledge-point/title "Finding a Missing Coordinate in a Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53db5663-0069-566e-9fc8-115a3b399587" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186489712} {:answer/id #uuid "58e11586-8d67-518d-a843-9027adadcf30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186489728} {:answer/id #uuid "b33cb1ad-4e00-521b-87c0-9aa857e66b3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186489906} {:answer/id #uuid "cd7e07b4-1c10-5f17-80e6-3214dee79832" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186489971} {:answer/id #uuid "e28cbb48-ea6e-54a8-858c-bd88e8434742" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186490008}] :answer-field/correct {:answer/id #uuid "e28cbb48-ea6e-54a8-858c-bd88e8434742" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186490008} :answer-field/id #uuid "9856d1a4-8c16-5b8c-a1d3-d2714ffaf3a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490159}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2b330576-64ef-57a2-934f-fa47fcfddd05" :question/math-academy-id "q-44421" :question/problem "A solution to the linear equation $3x-4y=2$ is the ordered pair $(-2,k).$ What is the value of $k?$" :question/worked-solution "Since $(-2,k)$ is a solution to the linear equation $3x-4y=2,$ the equation must turn into a true statement if we substitute $-2$ and $k$ for $x$ and $y.$ So, we replace $x$ with $-2$ and $y$ with $k,$ as follows:\n\n$$\n\\begin{aligned}3x-4y & =2 \\\\ 3(-2)-4(k) & =2 \\\\ -6-4k & =2 \\\\ -4k & =8 \\\\ k & =-2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186490262 :knowledge-point/_questions [{:db/id #edb/ref 17592186054693 :knowledge-point/id #uuid "1fe6fbb4-545d-5db8-9042-2c5fac1add72" :knowledge-point/title "Identifying a Solution to a Given Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21bd3c5d-172a-5398-96d2-3281455e0c23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186489591} {:answer/id #uuid "56338ef8-5dae-5fe2-b44c-d6d6be5007f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186489717} {:answer/id #uuid "88c554ae-2efb-5db6-a9c9-65801f7efdb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186489829} {:answer/id #uuid "a1f71324-2f7e-573d-ad3a-2c9b16b1da3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186489874} {:answer/id #uuid "a799586f-31b9-5a05-a6cd-524dc32c8bf1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186489883}] :answer-field/correct {:answer/id #uuid "a1f71324-2f7e-573d-ad3a-2c9b16b1da3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186489874} :answer-field/id #uuid "be452970-7789-5eff-8788-2f246dfcea73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490177}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6e011359-1ec4-59a5-9ee5-39dc3634d579" :question/math-academy-id "q-44433" :question/problem "Which of the following ordered pairs is a solution to $y=-\\frac{x}{6}?$\n\nI. $(-18,-3)$\n\nII. $(6,1)$\n\nIII. $(12,-2)$" :question/worked-solution "To check whether each point is a solution to the equation, we substitute it into the equation and see if it results in a true statement.\n\nFirst, we substitute $(-18,-3)$ into the equation:\n\n$$\n\\begin{aligned}y & =-\\frac{x}{6} \\\\ (-3) & =-\\frac{(-18)}{6} \\\\ -3 & =3\\,\\times \\end{aligned}\n$$\n\nThe result is a false statement, so $(-18,-3)$ is *not* a solution to the equation.\n\nNext, we substitute $(6,1)$ into the equation:\n\n$$\n\\begin{aligned}y & =-\\frac{x}{6} \\\\ (1) & =-\\frac{6}{6} \\\\ 1 & =-1\\,\\times \\end{aligned}\n$$\n\nThe result is again a false statement, so $(6,1)$ is also *not* a solution to the equation.\n\nFinally, we substitute $(12,-2)$ into the equation:\n\n$$\n\\begin{aligned}y & =-\\frac{x}{6} \\\\ (-2) & =-\\frac{12}{6} \\\\ -2 & =-2\\,✓\\end{aligned}\n$$\n\nThe result is a true statement, so $(12,-2)$ is a solution to the equation.\n\nSo, out of the three ordered pairs given, the only pair that is a solution to the equation is III $(12,-2).$"}] [{:db/id #edb/ref 17592186490213 :knowledge-point/_questions [{:db/id #edb/ref 17592186054693 :knowledge-point/id #uuid "1fe6fbb4-545d-5db8-9042-2c5fac1add72" :knowledge-point/title "Identifying a Solution to a Given Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44e97b6c-2103-5102-9faa-5aca41fc66f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186489674} {:answer/id #uuid "702e74e5-9f57-53de-953b-d80198dd18ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186489777} {:answer/id #uuid "9886ec6c-45f3-5247-ade4-767bba35097f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186489854} {:answer/id #uuid "e6a5f06f-62e9-5982-84f3-513bfda69851" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186490015} {:answer/id #uuid "fe65337d-52f9-51bc-9db9-c7c11a12af42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186490071}] :answer-field/correct {:answer/id #uuid "702e74e5-9f57-53de-953b-d80198dd18ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186489777} :answer-field/id #uuid "4739ce09-2032-5914-8c63-7e80cf023353" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490114}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "04603f4d-d37d-5464-90af-2ef30e760b2c" :question/math-academy-id "q-71678" :question/problem "Which of the following ordered pairs is a solution to $y=2x-3?$\n\nI. $(-2,-7)$\n\nII. $(0,3)$\n\nIII. $(2,4)$" :question/worked-solution "To check whether each point is a solution to the equation, we substitute it into the equation and see if it results in a true statement.\n\nFirst, we substitute $(-2,-7)$ into the equation:\n\n$$\n\\begin{aligned}y & =2x-3 \\\\ (-7) & =2(-2)-3 \\\\ -7 & =-4-3 \\\\ -7 & =-7\\,✓\\end{aligned}\n$$\n\nThe result is a true statement, so $(-2,-7)$ is a solution to the equation.\n\nNext, we substitute $(0,3)$ into the equation:\n\n$$\n\\begin{aligned}y & =2x-3 \\\\ (3) & =2(0)-3 \\\\ 3 & =-3\\,\\times \\end{aligned}\n$$\n\nThe result is a false statement, so $(0,3)$ is *not* a solution to the equation.\n\nFinally, we substitute $(2,4)$ into the equation:\n\n$$\n\\begin{aligned}y & =2x-3 \\\\ (4) & =2(2)-3 \\\\ 4 & =4-3 \\\\ 4 & =1\\,\\times \\end{aligned}\n$$\n\nThe result is again a false statement, so $(2,4)$ is also *not* a solution to the equation.\n\nSo, out of the three ordered pairs given, the only pair that is a solution to the equation is I $(-2,-7).$"}]}
