/ref 17592186489674 #edb/ref 17592186045417] [17592186490114 #edb/ref 1075 #edb/ref 17592186489777 #edb/ref 17592186045417] [17592186490114 #edb/ref 1075 #edb/ref 17592186489854 #edb/ref 17592186045417] [17592186490114 #edb/ref 1075 #edb/ref 17592186490015 #edb/ref 17592186045417] [17592186490114 #edb/ref 1075 #edb/ref 17592186490071 #edb/ref 17592186045417] [17592186490114 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186490114 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186490114 #edb/ref 1078 #edb/ref 17592186489777 #edb/ref 17592186045417] [17592186490114 #edb/ref 1079 #uuid "4739ce09-2032-5914-8c63-7e80cf023353" #edb/ref 17592186045417] [17592186490159 #edb/ref 1075 #edb/ref 17592186489712 #edb/ref 17592186045417] [17592186490159 #edb/ref 1075 #edb/ref 17592186489728 #edb/ref 17592186045417] [17592186490159 #edb/ref 1075 #edb/ref 17592186489906 #edb/ref 17592186045417] [17592186490159 #edb/ref 1075 #edb/ref 17592186489971 #edb/ref 17592186045417] [17592186490159 #edb/ref 1075 #edb/ref 17592186490008 #edb/ref 17592186045417] [17592186490159 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186490159 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186490159 #edb/ref 1078 #edb/ref 17592186490008 #edb/ref 17592186045417] [17592186490159 #edb/ref 1079 #uuid "9856d1a4-8c16-5b8c-a1d3-d2714ffaf3a8" #edb/ref 17592186045417] [17592186490177 #edb/ref 1075 #edb/ref 17592186489591 #edb/ref 17592186045417] [17592186490177 #edb/ref 1075 #edb/ref 17592186489717 #edb/ref 17592186045417] [17592186490177 #edb/ref 1075 #edb/ref 17592186489829 #edb/ref 17592186045417] [17592186490177 #edb/ref 1075 #edb/ref 17592186489874 #edb/ref 17592186045417] [17592186490177 #edb/ref 1075 #edb/ref 17592186489883 #edb/ref 17592186045417] [17592186490177 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186490177 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186490177 #edb/ref 1078 #edb/ref 17592186489874 #edb/ref 17592186045417] [17592186490177 #edb/ref 1079 #uuid "be452970-7789-5eff-8788-2f246dfcea73" #edb/ref 17592186045417] [17592186490213 #edb/ref 1068 #edb/ref 17592186490114 #edb/ref 17592186045417] [17592186490213 #edb/ref 1069 "q-71678" #edb/ref 17592186045417] [17592186490213 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186490213 #edb/ref 1071 "Which of the following ordered pairs is a solution to $y=2x-3?$\n\nI. $(-2,-7)$\n\nII. $(0,3)$\n\nIII. $(2,4)$" #edb/ref 17592186045417] [17592186490213 #edb/ref 1072 #uuid "04603f4d-d37d-5464-90af-2ef30e760b2c" #edb/ref 17592186045417] [17592186490213 #edb/ref 1074 "To check whether each point is a solution to the equation, we substitute it into the equation and see if it results in a true statement.\n\nFirst, we substitute $(-2,-7)$ into the equation:\n\n$$\n\\begin{aligned}y & =2x-3 \\\\ (-7) & =2(-2)-3 \\\\ -7 & =-4-3 \\\\ -7 & =-7\\,✓\\end{aligned}\n$$\n\nThe result is a true statement, so $(-2,-7)$ is a solution to the equation.\n\nNext, we substitute $(0,3)$ into the equation:\n\n$$\n\\begin{aligned}y & =2x-3 \\\\ (3) & =2(0)-3 \\\\ 3 & =-3\\,\\times \\end{aligned}\n$$\n\nThe result is a false statement, so $(0,3)$ is *not* a solution to the equation.\n\nFinally, we substitute $(2,4)$ into the equation:\n\n$$\n\\begin{aligned}y & =2x-3 \\\\ (4) & =2(2)-3 \\\\ 4 & =4-3 \\\\ 4 & =1\\,\\times \\end{aligned}\n$$\n\nThe result is again a false statement, so $(2,4)$ is also *not* a solution to the equation.\n\nSo, out of the three ordered pairs given, the only pair that is a solution to the equation is I $(-2,-7).$" #edb/ref 17592186045417] [17592186490226 #edb/ref 1068 #edb/ref 17592186490159 #edb/ref 17592186045417] [17592186490226 #edb/ref 1069 "q-44421" #edb/ref 17592186045417] [17592186490226 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186490226 #edb/ref 1071 "A solution to the linear equation $3x-4y=2$ is the ordered pair $(-2,k).$ What is the value of $k?$" #edb/ref 17592186045417] [17592186490226 #edb/ref 1072 #uuid "2b330576-64ef-57a2-934f-fa47fcfddd05" #edb/ref 17592186045417] [17592186490226 #edb/ref 1074 "Since $(-2,k)$ is a solution to the linear equation $3x-4y=2,$ the equation must turn into a true statement if we substitute $-2$ and $k$ for $x$ and $y.$ So, we replace $x$ with $-2$ and $y$ with $k,$ as follows:\n\n$$\n\\begin{aligned}3x-4y & =2 \\\\ 3(-2)-4(k) & =2 \\\\ -6-4k & =2 \\\\ -4k & =8 \\\\ k & =-2\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186490262 #edb/ref 1068 #edb/ref 17592186490177 #edb/ref 17592186045417] [17592186490262 #edb/ref 1069 "q-44433" #edb/ref 17592186045417] [17592186490262 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186490262 #edb/ref 1071 "Which of the following ordered pairs is a solution to $y=-\\frac{x}{6}?$\n\nI. $(-18,-3)$\n\nII. $(6,1)$\n\nIII. $(12,-2)$" #edb/ref 17592186045417] [17592186490262 #edb/ref 1072 #uuid "6e011359-1ec4-59a5-9ee5-39dc3634d579" #edb/ref 17592186045417] [17592186490262 #edb/ref 1074 "To check whether each point is a solution to the equation, we substitute it into the equation and see if it results in a true statement.\n\nFirst, we substitute $(-18,-3)$ into the equation:\n\n$$\n\\begin{aligned}y & =-\\frac{x}{6} \\\\ (-3) & =-\\frac{(-18)}{6} \\\\ -3 & =3\\,\\times \\end{aligned}\n$$\n\nThe result is a false statement, so $(-18,-3)$ is *not* a solution to the equation.\n\nNext, we substitute $(6,1)$ into the equation:\n\n$$\n\\begin{aligned}y & =-\\frac{x}{6} \\\\ (1) & =-\\frac{6}{6} \\\\ 1 & =-1\\,\\times \\end{aligned}\n$$\n\nThe result is again a false statement, so $(6,1)$ is also *not* a solution to the equation.\n\nFinally, we substitute $(12,-2)$ into the equation:\n\n$$\n\\begin{aligned}y & =-\\frac{x}{6} \\\\ (-2) & =-\\frac{12}{6} \\\\ -2 & =-2\\,✓\\end{aligned}\n$$\n\nThe result is a true statement, so $(12,-2)$ is a solution to the equation.\n\nSo, out of the three ordered pairs given, the only pair that is a solution to the equation is III $(12,-2).$" #edb/ref 17592186045417] [17592186490301 #edb/ref 1068 #edb/ref 17592186490095 #edb/ref 17592186045417] [17592186490301 #edb/ref 1069 "q-109037" #edb/ref 17592186045417] [17592186490301 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186490301 #edb/ref 1071 "A solution to the linear equation $y=4x-11$ is the ordered pair $(2,h).$ What is the value of $h?$" #edb/ref 17592186045417] [17592186490301 #edb/ref 1072 #uuid "c3d050d6-291f-571b-896c-061ed6a76fc9" #edb/ref 17592186045417] [17592186490301 #edb/ref 1074 "Since $(2,h)$ is a solution to the linear equation $y=4x-11,$ the equation must turn into a true statement if we substitute $2$ and $h$ for $x$ and $y.$ So, we replace $x$ with $2$ and $y$ with $h,$ as follows:\n\n$$\n\\begin{aligned}y & =4x-11 \\\\ (h) & =4(2)-11 \\\\ h & =8-11 \\\\ h & =-3\\end{aligned}\n$$" #edb/ref 17592186045417]}
