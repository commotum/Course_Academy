#{[{:db/id #edb/ref 17592186073563 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073881 :knowledge-point/id #uuid "48f71a07-2bd3-5164-a227-b82d56c0abc7" :knowledge-point/title "Using a Ratio to Compute a Denominator"}] :question/id #uuid "913c1995-fe26-5359-8298-e3b8379e39d8" :question/math-academy-id "e-2277" :question/problem "Adam has a cedar tree and willow tree in his garden. The ratio of the height of the cedar tree to the height of a willow tree is $8:5.$ If the height of the cedar tree is $24$ meters, what is the height of the willow tree?" :question/worked-solution "We start with the ratio ${\\color{blue}8}:{\\color{red}5}$ and write it as a fraction:\n\n$$\n\\dfrac{{\\color{blue}8}}{{\\color{red}5}}\n$$\n\nIn this fraction, the numerator represents the height of the   cedar tree and the denominator represents the height of the  willow tree.\n\nWe can make a numerator of $24$ by multiplying the numerator and denominator by $3$:\n\n$$\n\\dfrac{{\\color{blue}8}\\times 3}{{\\color{red}5}\\times 3} = \\dfrac{{\\color{blue}24}}{{\\color{red}15}}\n$$\n\nTherefore, if the height of the cedar tree is $24$ meters, the height of the willow tree is $15$ meters."}] [{:db/id #edb/ref 17592186073564 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073882 :knowledge-point/id #uuid "d710628f-14e0-5587-90d1-564a5e0ead19" :knowledge-point/title "Using a Ratio to Compute a Numerator"}] :question/id #uuid "2eeba279-cd91-55c7-b423-a14edb255ebb" :question/math-academy-id "e-2278" :question/problem "The ratio of sand to crushed stone in concrete is $\\dfrac{3}{2}.$ If Daniel has $80$ kilograms of crushed stone available to make concrete, what amount of sand should he use?" :question/worked-solution "We are given that the ratio of sand to crushed stone in concrete is $\\dfrac{3}{2}.$ \n\nIn this fraction, the numerator represents the amount of sand and the denominator represents the amount of crushed stone.\n\nWe can make a denominator of $80$ by multiplying the numerator and denominator by $40\\mathbin{:}$\n\n$$\n\\dfrac{{\\color{blue}3}\\times 40}{{\\color{red}2}\\times 40} = \\dfrac{{\\color{blue}120}}{{\\color{red}80}}\n$$\n\nTherefore, for $80$ kilograms of crushed stone, Daniel must use $120$ kilograms of sand."}] [{:db/id #edb/ref 17592186490235 :knowledge-point/_questions [{:db/id #edb/ref 17592186073882 :knowledge-point/id #uuid "d710628f-14e0-5587-90d1-564a5e0ead19" :knowledge-point/title "Using a Ratio to Compute a Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00ea9969-143b-5d82-8308-78472d749663" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186489516} {:answer/id #uuid "42bac3d2-6074-51d7-a785-2d4d396435e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186489668} {:answer/id #uuid "4ec82291-8ad2-5012-9943-f4982692d756" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186489701} {:answer/id #uuid "c6023bed-d787-542d-b6c5-a662eeb68513" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186489943} {:answer/id #uuid "e4bf3b23-46d3-5e64-8a4c-1960f1e8f67f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186490012}] :answer-field/correct {:answer/id #uuid "42bac3d2-6074-51d7-a785-2d4d396435e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186489668} :answer-field/id #uuid "e5c43b1e-0107-5054-a334-26f92d083760" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490195}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "34bd5498-60c5-56d4-9f94-63016d557040" :question/math-academy-id "q-147042" :question/problem "The ratio of T-shirts to pairs of jeans in David's closet is $\\frac{5}{2}.$ If David has $4$ pairs of jeans in his closet, how many T-shirts does David have?" :question/worked-solution "The ratio of T-shirts to pairs of jeans in David's closet is $\\frac{5}{2}.$\n\nIn this fraction, the numerator represents the number of T-shirts and the denominator represents the number of pairs of jeans.\n\nWe can make a denominator of $4$ by multiplying the numerator and denominator by $2$:\n\n$$\n\\frac{5\\times 2}{2\\times 2}=\\frac{10}{4}\n$$\n\nTherefore, David has $10$ T-shirts in his closet."}] [{:db/id #edb/ref 17592186490246 :knowledge-point/_questions [{:db/id #edb/ref 17592186073882 :knowledge-point/id #uuid "d710628f-14e0-5587-90d1-564a5e0ead19" :knowledge-point/title "Using a Ratio to Compute a Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16808e05-3101-5cfc-8fed-add05e727788" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186489563} {:answer/id #uuid "1da45d8a-6a82-51be-b61b-765f9dfd5e36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186489586} {:answer/id #uuid "27e725b2-a1d9-58c5-885d-662a5b0457e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186489605} {:answer/id #uuid "49161eab-92bb-5d1b-8cdc-86af95320bb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186489685} {:answer/id #uuid "56826d19-14f1-50b2-8905-418eb236e355" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186489718}] :answer-field/correct {:answer/id #uuid "16808e05-3101-5cfc-8fed-add05e727788" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186489563} :answer-field/id #uuid "f5233b41-f23f-5e4f-b8ad-e6c6136880ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490203}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4cce5310-2253-544b-a45b-5b307f4192ed" :question/math-academy-id "q-147047" :question/problem "Sophie is baking a pie. The recipe for the pie dough states that the ratio of sugar to melted butter is $\\frac{3}{2}.$ If she decides to use $4$ cups of melted butter, how many cups of sugar does she need to use?" :question/worked-solution "We are given that the ratio of sugar to melted butter is $\\frac{3}{2}.$\n\nIn this fraction, the numerator represents the number of cups of sugar and the denominator represents the number of cups of melted butter.\n\nWe can make a denominator of $4$ by multiplying the numerator and denominator by $2$:\n\n$$\n\\frac{3\\times 2}{2\\times 2}=\\frac{6}{4}\n$$\n\nTherefore, for $4$ cups of melted butter, Sophie must use $6$ cups of sugar."}] [{:db/id #edb/ref 17592186490296 :knowledge-point/_questions [{:db/id #edb/ref 17592186073881 :knowledge-point/id #uuid "48f71a07-2bd3-5164-a227-b82d56c0abc7" :knowledge-point/title "Using a Ratio to Compute a Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33f4d7f9-6ff2-568a-9031-8fd2bd5573e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186489631} {:answer/id #uuid "3d34d00c-fa58-5181-af8a-14174d80eefd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186489654} {:answer/id #uuid "57c8725d-c196-52c3-b69d-90a08cc21396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186489724} {:answer/id #uuid "5e646964-d2b1-5506-ab26-40f144105c1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186489740} {:answer/id #uuid "8f77cbd4-c41a-5a41-91f6-297781ff2b82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186489840}] :answer-field/correct {:answer/id #uuid "3d34d00c-fa58-5181-af8a-14174d80eefd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186489654} :answer-field/id #uuid "1247e2dc-2998-585b-8060-dacb4eae3f3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490083}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bad4ad2c-65e9-50c0-a0af-a1c173627efa" :question/math-academy-id "q-60149" :question/problem "There are $60$ peaches in Sophia's store. The ratio of peaches to pears is $6:5.$ How many pears are there in Sophia's store?" :question/worked-solution "We start with the ratio $6:5$ and write it as a fraction:\n\n$$\n\\frac{6}{5}\n$$\n\nIn this fraction, the numerator represents the number of peaches and the denominator represents the number of pears.\n\nWe can make a numerator of $60$ by multiplying the numerator and denominator by $10$:\n\n$$\n\\frac{6\\times 10}{5\\times 10}=\\frac{60}{50}\n$$\n\nTherefore, there are $50$ pears in Sophia's store."}] [{:db/id #edb/ref 17592186490299 :knowledge-point/_questions [{:db/id #edb/ref 17592186073881 :knowledge-point/id #uuid "48f71a07-2bd3-5164-a227-b82d56c0abc7" :knowledge-point/title "Using a Ratio to Compute a Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eb7bebc-75f0-5757-9e6a-5d7b9908d477" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186489547} {:answer/id #uuid "66bcfbbc-d270-5b34-81b6-d9415ac2cfe0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186489757} {:answer/id #uuid "6954abd4-3414-55e5-a56a-f7af8cf2d213" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186489768} {:answer/id #uuid "8c87e2d1-9905-55f6-9540-ada0f504eaf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186489833} {:answer/id #uuid "8db65988-4f85-5444-b7a4-a6e93cdb3f85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186489834}] :answer-field/correct {:answer/id #uuid "6954abd4-3414-55e5-a56a-f7af8cf2d213" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186489768} :answer-field/id #uuid "2eb1723d-2257-5fd9-9e08-adc5fefc137a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490097}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bdac105a-b535-5e32-bc94-795efb94b947" :question/math-academy-id "q-60307" :question/problem "To prepare a homemade nasal spray, the ratio of salt (in grams) to cups of water is $\\frac{5}{2}.$ If Eliza wants to make a nasal spray with $15$ grams of salt, how many cups of water should she use?" :question/worked-solution "We are given that the ratio of salt (in grams) to cups of water is $\\frac{5}{2}.$\n\nIn this fraction, the numerator represents the amount of salt and the denominator represents the number of cups of water.\n\nWe can make a numerator of $15$ by multiplying the numerator and denominator by $3$:\n\n$$\n\\frac{5\\times 3}{2\\times 3}=\\frac{15}{6}\n$$\n\nTherefore, for $15$ grams of salt, Eliza must use $6$ cups of water."}]}
