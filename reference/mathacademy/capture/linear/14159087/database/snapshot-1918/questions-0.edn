#{[{:db/id #edb/ref 17592186483402 :knowledge-point/_questions [{:db/id #edb/ref 17592186171933 :knowledge-point/id #uuid "b483f9f7-47a9-5725-b1f1-fe0ea39a7e96" :knowledge-point/title "Determining if a Number Is Divisible by 6"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12afe4b3-21c1-5226-88fa-1a4798e15712" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186482843} {:answer/id #uuid "2feba7be-006f-5377-a598-baf491efcc41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186482897} {:answer/id #uuid "d4078e9e-cf26-5341-9d23-42f6201b2a76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186483169} {:answer/id #uuid "f188ef76-ca50-506c-82c0-30d85353b6d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186483216} {:answer/id #uuid "f9c0a5c0-452d-5300-bcce-eff988f09d98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186483233}] :answer-field/correct {:answer/id #uuid "f9c0a5c0-452d-5300-bcce-eff988f09d98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186483233} :answer-field/id #uuid "39f46cce-e058-5bf2-9268-00ee8313197f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483260}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bb148c29-2fa3-5a15-9be6-3a95df07f188" :question/math-academy-id "q-132399" :question/problem "Which digits, when inserted into the blank, make the number $35\\,832\\,4◻2$ divisible by $6?$\n\nI. $6$\n\nII. $7$\n\nIII. $9$" :question/worked-solution "A number is divisible by $6$ if it is divisible by both $2$ and $3.$ Remember that to determine whether a number is divisible by $3,$ we check whether the sum of the digits is divisible by $3.$\n\nFor the given number, the sum of the digits is\n\n$$\n3+5+8+3+2+4+◻+2=27+◻.\n$$\n\nNow, let's consider each of the given digits we can substitute into the blank.\n\n- If we substitute $6$ into the blank, we get $35\\,832\\,462,$ which is divisible by $2.$ Then the sum of the digits is $27+6=33,$ which is divisible by $3,$ so the number is also divisible by $3.$ Therefore, the number is divisible by $6.$\n\n- If we substitute $7$ into the blank, we get $35\\,832\\,472,$ which is divisible by $2.$ However, it is not divisible by $3$ because the sum of the digits is $27+7=34,$ which is not divisible by $3.$ So, the number is *not* divisible by $6$ either.\n\n- If we substitute $9$ into the blank, we get $35\\,832\\,492,$ which is divisible by $2.$ Then the sum of the digits is $27+9=36,$ which is divisible by $3,$ so the number is also divisible by $3.$ Therefore, the number is divisible by $6.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186483410 :knowledge-point/_questions [{:db/id #edb/ref 17592186171933 :knowledge-point/id #uuid "b483f9f7-47a9-5725-b1f1-fe0ea39a7e96" :knowledge-point/title "Determining if a Number Is Divisible by 6"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02938ac2-a904-589b-95cf-e1e584154abd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186482814} {:answer/id #uuid "1e295efd-cfd7-5826-8bdb-23fabf9e7f01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186482869} {:answer/id #uuid "291773ce-54e7-5de8-a209-c43955975d44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #ed