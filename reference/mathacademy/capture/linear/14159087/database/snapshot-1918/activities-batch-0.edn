17592186432792} {:db/id #edb/ref 17592186432793} {:db/id #edb/ref 17592186432794}] :knowledge-point/title "Determining if a Number Is Divisible by 3 or 9"} :step/id #uuid "b30e2ba3-941c-5d16-b861-02db07423b35" :step/math-academy-id 172669 :step/next {:db/id #edb/ref 17592186172718}} {:db/id #edb/ref 17592186172718 :step/content {:db/id #edb/ref 17592186173304 :tutorial/content "We have the following rule for determining if a number is divisible by $6{:}$\n\n*A number is divisible by $6$ if it is divisible by both $2$ and $3.$*\n\nFor example, let's determine if the following number is divisible by $6{:}$\n\n$$\n353,856\n$$\n\nTo check whether this number is divisible by $6,$ we need to check that it's divisible by *both* $2$ *and* $3{:}$\n\n- Notice that the last digit of $353,85{\\color{blue}{6}}$ is ${\\color{blue}{6}}.$ Since ${\\color{blue}{6}}$ is even, $353,856$ is divisible by $2.\\quad{\\color{green}{\\checkmark}}$\n\n- We now check for divisibility by $3.$ The sum of the digits is\n\n$$\n3+5+3+8+5+6 = 30.\n$$\n\nSince $30$ is divisible by $3,$ we have that $353,856$ is divisible by $3.\\quad{\\color{green}{\\checkmark}}$\n\nSo, since $353,856$ is divisible by *both* $2$ *and* $3,$ we conclude that it is divisible by $6.$\n\nLet's see another example." :tutorial/id #uuid "955bbb9e-e7e0-552d-9ecf-ef5efd79239a" :tutorial/math-academy-id 9441 :tutorial/title "Divisibility by 6"} :step/id #uuid "96c70f43-c735-5619-a8c7-49afb6e904cd" :step/math-academy-id 172672 :step/next {:db/id #edb/ref 17592186172719}} {:db/id #edb/ref 17592186172719 :step/content {:db/id #edb/ref 17592186171933 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171757 :question/id #uuid "2d40d35a-54e1-5d01-9e0f-345a290336ef" :question/math-academy-id "e-15013"} :knowledge-point/id #uuid "b483f9f7-47a9-5725-b1f1-fe0ea39a7e96" :knowledge-point/questions [{:db/id #edb/ref 17592186172311} {:db/id #edb/ref 17592186172603} {:db/id #edb/ref 17592186432783} {:db/id #edb/ref 17592186432785} {:db/id #edb/ref 17592186432786} {:db/id #edb/ref 17592186432789} {:db/id #edb/ref 17592186432791} {:db/id #edb/ref 17592186483402} {:db/id #edb/ref 17592186483410}] :knowledge-point/title "Determining if a Number Is Divisible by 6"} :step/id #uuid "46310e8f-1f56-5e58-9836-71090df92551" :step/math-academy-id 172673 :step/next {:db/id #edb/ref 17592186172720}} {:db/id #edb/ref 17592186172720 :step/content {:db/id #edb/ref 17592186173300 :tutorial/content "The rule for dividing by $7$ is the trickiest rule of the ones we've studied.\n\n*To check if a number is divisible by $7,$ we double the last digit, subtract the result from the remaining digits, and then check if the difference is divisible by $7.$*\n\nFor example, let's check if the following number is divisible by $7{:}$\n\n$$\n46{\\color{red}{2}}\n$$\n\nThe last digit is ${\\color{red}{2}}.$ If we double this digit, we get $2\\cdot {\\color{red}{2}} =  {\\color{blue}{4}}.$ Then, if we subtract ${\\color{blue}{4}}$ from the remaining digits, we get\n\n$$\n46 - {\\color{blue}{4}} = 42.\n$$\n\nNow, since $42$ is divisible by $7,$ we conclude that $462$ is divisible by $7.$\n\nLet's see some more examples." :tutorial/id #uuid "a5cdfa6e-09a2-5600-9083-a424aaf3d959" :tutorial/math-academy-id 9391 :tutorial/title "Divisibility by 7"} :step/id #uuid "8c02867b-43a4-5116-88da-bc7736bfb7a5" :step/math-academy-id 172676 :step/next {:db/id #edb/ref 17592186172721}} {:db/id #edb/ref 17592186172721 :step/content {:db/id #edb/ref 17592186171934 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171758 :question/id #uuid "dadf214d-16d0-5dbb-aa89-89f4f8e7c79f" :question/math-academy-id "e-15014"} :knowledge-point/id #uuid "cb0ae539-5348-5a2c-b226-c009ce6d6094" :knowledge-point/questions [{:db/id #edb/ref 17592186172454} {:db/id #edb/ref 17592186172604} {:db/id #edb/ref 17592186432784} {:db/id #edb/ref 17592186432787} {:db/id #edb/ref 17592186432790} {:db/id #edb/ref 17592186432795} {:db/id #edb/ref 17592186432796}] :knowledge-point/title "Determining if a Number Is Divisible by 7"} :step/id #uuid "777acec7-1e70-587a-80c0-746fd1cdb9e4" :step/math-academy-id 172677}] :activity/title "Divisibility of Integers by 3, 9, 6, and 7" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186172213}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186483449} :activity/id #uuid "12fb99b1-6cf8-5a19-b791-8128678b255e" :activity/scope {:db/id #edb/ref 17592186050318 :topic/id #uuid "3f7c8941-2bc1-5431-84b6-f34e556ea057" :topic/math-academy-id 3543} :activity/steps [{:db/id #edb/ref 17592186483449 :step/content {:db/id #edb/ref 17592186483402 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12afe4b3-21c1-5226-88fa-1a4798e15712" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186482843} {:answer/id #uuid "2feba7be-006f-5377-a598-baf491efcc41" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186482897} {:answer/id #uuid "d4078e9e-cf26-5341-9d23-42f6201b2a76" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186483169} {:answer/id #uuid "f188ef76-ca50-506c-82c0-30d85353b6d5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186483216} {:answer/id #uuid "f9c0a5c0-452d-5300-bcce-eff988f09d98" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186483233}] :answer-field/correct {:db/id #edb/ref 17592186483233} :answer-field/id #uuid "39f46cce-e058-5bf2-9268-00ee8313197f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186483260}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bb148c29-2fa3-5a15-9be6-3a95df07f188" :question/math-academy-id "q-132399" :question/problem "Which digits, when inserted into the blank, make the number $35\\,832\\,4◻2$ divisible by $6?$\n\nI. $6$\n\nII. $7$\n\nIII. $9$" :question/worked-solution "A number is divisible by $6$ if it is divisible by both $2$ and $3.$ Remember that to determine whether a number is divisible by $3,$ we check whether the sum of the digits is divisible by $3.$\n\nFor the given number, the sum of the digits is\n\n$$\n3+5+8+3+2+4+◻+2=27+◻.\n$$\n\nNow, let's consider each of the given digits we can substitute into the blank.\n\n- If we substitute $6$ into the blank, we get $35\\,832\\,462,$ which is divisible by $2.$ Then the sum of the digits is $27+6=33,$ which is divisible by $3,$ so the number is also divisible by $3.$ Therefore, the number is divisible by $6.$\n\n- If we substitute $7$ into the blank, we get $35\\,832\\,472,$ which is divisible by $2.$ However, it is not divisible by $3$ because the sum of the digits is $27+7=34,$ which is not divisible by $3.$ So, the number is *not* divisible by $6$ either.\n\n- If we substitute $9$ into the blank, we get $35\\,832\\,492,$ which is divisible by $2.$ Then the sum of the digits is $27+9=36,$ which is divisible by $3,$ so the number is also divisible by $3.$ Therefore, the number is divisible by $6.$\n\nTherefore, the correct answer is \"I and III only.\""} :step/id #uuid "2d9e737d-3beb-558d-b409-89e4144e50cb" :step/next {:db/id #edb/ref 17592186483467}} {:db/id #edb/ref 17592186483467 :step/content {:db/id #edb/ref 17592186483410 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02938ac2-a904-589b-95cf-e1e584154abd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186482814} {:answer/id #uuid "1e295efd-cfd7-5826-8bdb-23fabf9e7f01" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186482869} {:answer/id #uuid "291773ce-54e7-5de8-a209-c43955975d44" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186482884} {:answer/id #uuid "4185b1db-1e91-57f5-b0ed-f446a3cc2f83" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186482923} {:answer/id #uuid "65401151-5ed3-53b1-8618-d2d6f6d8473e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186482989}] :answer-field/correct {:db/id #edb/ref 17592186482869} :answer-field/id #uuid "6f364f54-37f9-5c16-b23e-1b97b8dd9c4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186483283}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c4adaad6-9b04-5b58-a83e-194edc0437bb" :question/math-academy-id "q-132400" :question/problem "Which digits, when inserted into the blank, make the number $11\\,521\\,6◻6$ divisible by $6?$\n\nI. $3$\n\nII. $7$\n\nIII. $9$" :question/worked-solution "A number is divisible by $6$ if it is divisible by both $2$ and $3.$ Remember that to determine whether a number is divisible by $3,$ we check whether the sum of the digits is divisible by $3.$\n\nFor the given number, the sum of the digits is\n\n$$\n1+1+5+2+1+6+◻+6=22+◻.\n$$\n\nNow, let's consider each of the given digits we can substitute into the blank.\n\n- If we substitute $3$ into the blank, we get $11\\,521\\,636,$ which is divisible by $2.$ However, it is not divisible by $3$ because the sum of the digits is $22+3=25,$ which is not divisible by $3.$ So, the number is *not* divisible by $6$ either.\n\n- If we substitute $7$ into the blank, we get $11\\,521\\,676,$ which is divisible by $2.$ However, it is not divisible by $3$ because the sum of the digits is $22+7=29,$ which is not divisible by $3.$ So, the number is *not* divisible by $6$ either.\n\n- If we substitute $9$ into the blank, we get $11\\,521\\,696,$ which is divisible by $2.$ However, it is not divisible by $3$ because the sum of the digits is $22+9=31,$ which is not divisible by $3.$ So, the number is *not* divisible by $6$ either.\n\nTherefore, the correct answer is \"None.\""} :step/id #uuid "6d652c62-b3a3-5b32-af56-3ba9c69395ee" :step/next {:db/id #edb/ref 17592186483503}} {:db/id #edb/ref 17592186483503 :step/content {:db/id #edb/ref 17592186172311 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ca7235df-ed54-56b4-a96a-f4dd62411d9e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186168730} {:answer/id #uuid "09345208-4c96-5ff8-aad9-4dc79f7055c4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186168731} {:answer/id #uuid "3f01a342-66a4-565d-8547-c05a295e8ace" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186168732} {:answer/id #uuid "48110931-110b-5b28-8961-d5731a2dc0ad" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186168733} {:answer/id #uuid "4b893675-cde8-51e7-879a-c1367e13459f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186168734}] :answer-field/correct {:db/id #edb/ref 17592186168734} :answer-field/id #uuid "c4005020-e950-5306-a22c-5bc62b40c40b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186168729}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c81002d7-9f3e-57b8-8938-1545e4037d2f" :question/math-academy-id "q-132404" :question/problem "Which digits, when inserted into the blank, make the number $66\\,333\\,9◻0$ divisible by $6?$\n\nI. $0$\n\nII. $3$\n\nIII. $9$" :question/worked-solution "A number is divisible by $6$ if it is divisible by both $2$ and $3.$ Remember that to determine whether a number is divisible by $3,$ we check whether the sum of the digits is divisible by $3.$\n\nFor the given number, the sum of the digits is\n\n$$\n6+6+3+3+3+9+◻+0=30+◻.\n$$\n\nNow, let's consider each of the given digits we can substitute into the blank.\n\n- If we substitute $0$ into the blank, we get $66\\,333\\,900,$ which is divisible by $2.$ Then the sum of the digits is $30+0=30,$ which is divisible by $3,$ so the number is also divisible by $3.$ Therefore, the number is divisible by $6.$\n\n- If we substitute $3$ into the blank, we get $66\\,333\\,930,$ which is divisible by $2.$ Then the sum of the digits is $30+3=33,$ which is divisible by $3,$ so the number is also divisible by $3.$ Therefore, the number is divisible by $6.$\n\n- If we substitute $9$ into the blank, we get $66\\,333\\,990,$ which is divisible by $2.$ Then the sum of the digits is $30+9=39,$ which is divisible by $3,$ so the number is also divisible by $3.$ Therefore, the number is divisible by $6.$\n\nTherefore, the correct answer is \"I, II, and III.\""} :step/id #uuid "e6219abf-feda-5f67-92ad-2d82ceb7152e"}] :activity/title "Divisibility of Integers by 3, 9, 6, and 7" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186482798}]}
