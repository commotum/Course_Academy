17592186432792} {:db/id #edb/ref 17592186432793} {:db/id #edb/ref 17592186432794}] :knowledge-point/title "Determining if a Number Is Divisible by 3 or 9"} :step/id #uuid "b30e2ba3-941c-5d16-b861-02db07423b35" :step/math-academy-id 172669 :step/next {:db/id #edb/ref 17592186172718}} {:db/id #edb/ref 17592186172718 :step/content {:db/id #edb/ref 17592186173304 :tutorial/content "We have the following rule for determining if a number is divisible by $6{:}$\n\n*A number is divisible by $6$ if it is divisible by both $2$ and $3.$*\n\nFor example, let's determine if the following number is divisible by $6{:}$\n\n$$\n353,856\n$$\n\nTo check whether this number is divisible by $6,$ we need to check that it's divisible by *both* $2$ *and* $3{:}$\n\n- Notice that the last digit of $353,85{\\color{blue}{6}}$ is ${\\color{blue}{6}}.$ Since ${\\color{blue}{6}}$ is even, $353,856$ is divisible by $2.\\quad{\\color{green}{\\checkmark}}$\n\n- We now check for divisibility by $3.$ The sum of the digits is\n\n$$\n3+5+3+8+5+6 = 30.\n$$\n\nSince $30$ is divisible by $3,$ we have that $353,856$ is divisible by $3.\\quad{\\color{green}{\\checkmark}}$\n\nSo, since $353,856$ is divisible by *both* $2$ *and* $3,$ we conclude that it is divisible by $6.$\n\nLet's see another example." :tutorial/id #uuid "955bbb9e-e7e0-552d-9ecf-ef5efd79239a" :tutorial/math-academy-id 9441 :tutorial/title "Divisibility by 6"} :step/id #uuid "96c70f43-c735-5619-a8c7-49afb6e904cd" :step/math-academy-id 172672 :step/next {:db/id #edb/ref 17592186172719}} {:db/id #edb/ref 17592186172719 :step/content {:db/id #edb/ref 17592186171933 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171757 :question/id #uuid "2d40d35a-54e1-5d01-9e0f-345a290336ef" :question/math-academy-id "e-15013"} :knowledge-point/id #uuid "b483f9f7-47a9-5725-b1f1-fe0ea39a7e96" :knowledge-point/questions [{:db/id #edb/ref 17592186172311} {:db/id #edb/ref 17592186172603} {:db/id #edb/ref 17592186432783} {:db/id #edb/ref 17592186432785} {:db/id #edb/ref 17592186432786} {:db/id #edb/ref 17592186432789} {:db/id #edb/ref 17592186432791}] :knowledge-point/title "Determining if a Number Is Divisible by 6"} :step/id #uuid "46310e8f-1f56-5e58-9836-71090df92551" :step/math-academy-id 172673 :step/next {:db/id #edb/ref 17592186172720}} {:db/id #edb/ref 17592186172720 :step/content {:db/id #edb/ref 17592186173300 :tutorial/content "The rule for dividing by $7$ is the trickiest rule of the ones we've studied.\n\n*To check if a number is divisible by $7,$ we double the last digit, subtract the result from the remaining digits, and then check if the difference is divisible by $7.$*\n\nFor example, let's check if the following number is divisible by $7{:}$\n\n$$\n46{\\color{red}{2}}\n$$\n\nThe last digit is ${\\color{red}{2}}.$ If we double this digit, we get $2\\cdot {\\color{red}{2}} =  {\\color{blue}{4}}.$ Then, if we subtract ${\\color{blue}{4}}$ from the remaining digits, we get\n\n$$\n46 - {\\color{blue}{4}} = 42.\n$$\n\nNow, since $42$ is divisible by $7,$ we conclude that $462$ is divisible by $7.$\n\nLet's see some more examples." :tutorial/id #uuid "a5cdfa6e-09a2-5600-9083-a424aaf3d959" :tutorial/math-academy-id 9391 :tutorial/title "Divisibility by 7"} :step/id #uuid "8c02867b-43a4-5116-88da-bc7736bfb7a5" :step/math-academy-id 172676 :step/next {:db/id #edb/ref 17592186172721}} {:db/id #edb/ref 17592186172721 :step/content {:db/id #edb/ref 17592186171934 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171758 :question/id #uuid "dadf214d-16d0-5dbb-aa89-89f4f8e7c79f" :question/math-academy-id "e-15014"} :knowledge-point/id #uuid "cb0ae539-5348-5a2c-b226-c009ce6d6094" :knowledge-point/questions [{:db/id #edb/ref 17592186172454} {:db/id #edb/ref 17592186172604} {:db/id #edb/ref 17592186432784} {:db/id #edb/ref 17592186432787} {:db/id #edb/ref 17592186432790} {:db/id #edb/ref 17592186432795} {:db/id #edb/ref 17592186432796}] :knowledge-point/title "Determining if a Number Is Divisible by 7"} :step/id #uuid "777acec7-1e70-587a-80c0-746fd1cdb9e4" :step/math-academy-id 172677}] :activity/title "Divisibility of Integers by 3, 9, 6, and 7" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186172213}]}
