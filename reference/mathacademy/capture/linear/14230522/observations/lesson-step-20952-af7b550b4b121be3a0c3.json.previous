IN-29\" x=\"12816\" y=\"0\"></use>\n <use xlink:href=\"#E30-MJMAIN-28\" x=\"13205\" y=\"0\"></use>\n <use xlink:href=\"#E30-MJMAIN-32\" x=\"13595\" y=\"0\"></use>\n <use xlink:href=\"#E30-MJMATHI-78\" x=\"14095\" y=\"0\"></use>\n <use xlink:href=\"#E30-MJMAIN-2212\" x=\"14890\" y=\"0\"></use>\n <use xlink:href=\"#E30-MJMAIN-31\" x=\"15891\" y=\"0\"></use>\n <use xlink:href=\"#E30-MJMAIN-29\" x=\"16391\" y=\"0\"></use>\n <use xlink:href=\"#E30-MJMAIN-28\" x=\"16781\" y=\"0\"></use>\n <use xlink:href=\"#E30-MJMATHI-78\" x=\"17170\" y=\"0\"></use>\n <use xlink:href=\"#E30-MJMAIN-2B\" x=\"17965\" y=\"0\"></use>\n <use xlink:href=\"#E30-MJMAIN-34\" x=\"18966\" y=\"0\"></use>\n <use xlink:href=\"#E30-MJMAIN-29\" x=\"19466\" y=\"0\"></use>\n <use xlink:href=\"#E30-MJMAIN-2E\" x=\"19856\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p>We can now equate each factor to <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.162ex\" height=\"2.176ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -791.3 500.5 936.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-31-Title\">\n<title id=\"MathJax-SVG-31-Title\">0</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E31-MJMAIN-30\" d=\"M96 585Q152 666 249 666Q297 666 345 640T423 548Q460 465 460 320Q460 165 417 83Q397 41 362 16T301 -15T250 -22Q224 -22 198 -16T137 16T82 83Q39 165 39 320Q39 494 96 585ZM321 597Q291 629 250 629Q208 629 178 597Q153 571 145 525T137 333Q137 175 145 125T181 46Q209 16 250 16Q290 16 318 46Q347 76 354 130T362 333Q362 478 354 524T321 597Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E31-MJMAIN-30\" x=\"0\" y=\"0\"></use>\n</g>\n</svg></span> and solve for <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.33ex\" height=\"1.676ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -576.1 572.5 721.6\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-32-Title\">\n<title id=\"MathJax-SVG-32-Title\">x</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E32-MJMATHI-78\" d=\"M52 289Q59 331 106 386T222 442Q257 442 286 424T329 379Q371 442 430 442Q467 442 494 420T522 361Q522 332 508 314T481 292T458 288Q439 288 427 299T415 328Q415 374 465 391Q454 404 425 404Q412 404 406 402Q368 386 350 336Q290 115 290 78Q290 50 306 38T341 26Q378 26 414 59T463 140Q466 150 469 151T485 153H489Q504 153 504 145Q504 144 502 134Q486 77 440 33T333 -11Q263 -11 227 52Q186 -10 133 -10H127Q78 -10 57 16T35 71Q35 103 54 123T99 143Q142 143 142 101Q142 81 130 66T107 46T94 41L91 40Q91 39 97 36T113 29T132 26Q168 26 194 71Q203 87 217 139T245 247T261 313Q266 340 266 352Q266 380 251 392T217 404Q177 404 142 372T93 290Q91 281 88 280T72 278H58Q52 284 52 289Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E32-MJMATHI-78\" x=\"0\" y=\"0\"></use>\n</g>\n</svg></span> to find the three roots:</p>\n<p><span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"47.274ex\" height=\"8.176ex\" style=\"vertical-align: -3.288ex; margin-bottom: -0.217ex;\" viewBox=\"0 -2011.3 20354 3520.2\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-33-Title\">\n<title id=\"MathJax-SVG-33-Title\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"1\" style=\"font-size: 113.1%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 20.102em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-bottom: 0.15em;\"><mjx-