#{[{:db/id #edb/ref 17592186573318 :knowledge-point/_questions [{:db/id #edb/ref 17592186059653 :knowledge-point/id #uuid "f372d875-4de9-5ed1-86a6-80ceeddd3fe7" :knowledge-point/title "Calculating the Length of a Triangle's Side Using the Law of Cosines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bba957a-99fe-5340-a47d-f10e2d2b6869" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.72" :db/id #edb/ref 17592186572855} {:answer/id #uuid "8be15e53-3455-5adc-9a97-477c9964ac51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12.43" :db/id #edb/ref 17592186573004} {:answer/id #uuid "bdb54cb1-4cdf-5e1b-86e5-3c1797fc5bf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.91" :db/id #edb/ref 17592186573065} {:answer/id #uuid "e6bcf4ed-a6f1-5dad-93c0-7edac4fd7cfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10.01" :db/id #edb/ref 17592186573118} {:answer/id #uuid "f46016ce-d644-5ff1-b8c1-c24047295c26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.69" :db/id #edb/ref 17592186573134}] :answer-field/correct {:answer/id #uuid "f46016ce-d644-5ff1-b8c1-c24047295c26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.69" :db/id #edb/ref 17592186573134} :answer-field/id #uuid "e61d7995-875b-5a12-bc2c-d4a1dc9575fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573237}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "edd7453d-0827-54b9-87f7-014fa66cf7ec" :question/math-academy-id "q-14506" :question/problem "A triangle has sides $j$, $k$, and $l.$ The sides $j$ and $l$ have lengths $4$ and $7$, respectively. If the angle $K$ between $j$ and $l$ has a measure of ${121}^{∘}$, what is the length of side $k?$ Round your answer to two decimal places." :question/worked-solution "The following triangle illustrates the information given.\n\n![](images/1f/1fde3029f6a50388ebd342dc4d15e9787567461b651c24cd6bd6843521b0465d.png)\n\nThe Law of Cosines states that\n\n$$\n{k}^{2}={j}^{2}+{l}^{2}-2jl\\operatorname{cos}⁡K.\n$$\n\nHere, we have\n\n$$\nm∠K={121}^{∘},\\,j=4,\\,l=7.\n$$\n\nSubstituting the numbers into the formula gives\n\n$$\n\\begin{aligned}{k}^{2} & ={4}^{2}+{7}^{2}-2(4)(7)\\operatorname{cos}⁡{121}^{∘} \\\\  & =16+49-56\\operatorname{cos}⁡{121}^{∘} \\\\  & =65-56(-0.515\\,03…) \\\\  & =65+28.842\\,13 \\\\  & =93.842\\,13\\end{aligned}\n$$\n\nrounded to $5$ decimal places. \n\nTaking the square root gives\n\n$$\nk=\\sqrt{93.842\\,13}=9.69\n$$\n\nrounded to two decimal places."}] [{:db/id #edb/ref 17592186060316 :knowledge-point/_questions [{:db/id #edb/ref 17592186059654 :knowledge-point/id #uuid "8da5ae4c-c94c-5a8c-ba62-5df6e500008a" :knowledge-point/title "Calculating the Measure of an Angle in a Triangle Using the Law of Cosines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc94e018-ff1c-54a4-ad53-58d72fb46ced" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40.62^{∘}" :db/id #edb/ref 17592186058519} {:answer/id #uuid "e9a71e64-a915-5b68-8c12-ba28c3cc8ce8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "44.42^{∘}" :db/id #edb/ref 17592186058520} {:answer/id #uuid "1815a363-18a5-5d2d-80fe-3dc0a386322e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "39.38^{∘}" :db/id #edb/ref 17592186058521} {:answer/id #uuid "27214cfc-8510-5a14-b0c9-3c4177cbf56f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "41.63^{∘}" :db/id #edb/ref 17592186058522} {:answer/id #uuid "38dcd079-bdf0-5063-bde9-c2d72e34058b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "44.53^{∘}" :db/id #edb/ref 17592186058523}] :answer-field/id #uuid "8a66371c-5e30-50a2-b4c7-0a01de25c766" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058518}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0a1ec4ee-60c9-5336-ad34-95ed5dc973af" :question/math-academy-id "q-6404" :question/problem "![](images/e2/e2ba81c227223d872727ceec1e6b097b69d3f4b47cd9f7190ab984c2124c1bf5.png)\n\nFor the triangle above, find $m∠A$ in degrees rounded to two decimal places.\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true}] [{:db/id #edb/ref 17592186573274 :knowledge-point/_questions [{:db/id #edb/ref 17592186059654 :knowledge-point/id #uuid "8da5ae4c-c94c-5a8c-ba62-5df6e500008a" :knowledge-point/title "Calculating the Measure of an Angle in a Triangle Using the Law of Cosines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f7d18b7-8669-51a0-8612-923a2719727c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{21.20}^{∘}" :db/id #edb/ref 17592186572858} {:answer/id #uuid "6437eb0c-5020-559e-bd70-319aee5ba937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{17.89}^{∘}" :db/id #edb/ref 17592186572946} {:answer/id #uuid "c646cdc4-684d-54a1-8714-3eeef1e84d61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{18.19}^{∘}" :db/id #edb/ref 17592186573074} {:answer/id #uuid "c9b37447-949a-5c58-9208-515eaa569613" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{16.43}^{∘}" :db/id #edb/ref 17592186573078} {:answer/id #uuid "d4bc5f15-b8d5-57ea-919a-885ac1bd4741" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{20.36}^{∘}" :db/id #edb/ref 17592186573095}] :answer-field/correct {:answer/id #uuid "c646cdc4-684d-54a1-8714-3eeef1e84d61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{18.19}^{∘}" :db/id #edb/ref 17592186573074} :answer-field/id #uuid "fe46b4b1-2f2f-5fb3-9e1d-afbfc19fa446" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573248}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5021d5eb-c519-52ae-b30c-1049345fdc26" :question/math-academy-id "q-6423" :question/problem "A triangle has sides $m$, $n$, and $o.$ The sides $m$, $n$, and $o$ are of lengths  $2$, $5$, and $6$, respectively. What is the measure of the angle between the sides $n$ and $o?$ Round your answer to two decimal places." :question/worked-solution "The following triangle illustrates the information given.\n\n![](images/26/26f2041aec84bb0086e2f08c2ba3a19331895951782b7fda153858643a8a5dd4.png)\n\nWe use the Law of Cosines to solve for angle $M:$\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡M & =\\frac{{o}^{2}+{n}^{2}-{m}^{2}}{2no}.\\end{aligned}\n$$\n\n \nHere, we have\n\n$$\nm=2,\\,n=5,\\,o=6.\n$$\n\nThis gives \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡M & =\\frac{{6}^{2}+{5}^{2}-{2}^{2}}{2(5)(6)} \\\\  & =\\frac{36+25-4}{60} \\\\  & =\\frac{57}{60}.\\end{aligned}\n$$\n\n \nTherefore,\n\n$$\n\\begin{aligned}m∠M & =\\operatorname{arccos}⁡(\\frac{57}{60}) \\\\  & ={18.19}^{∘}\\end{aligned}\n$$\n\nrounded to two decimal places."}]}
