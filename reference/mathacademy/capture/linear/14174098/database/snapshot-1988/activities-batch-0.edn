#{[{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186180332} :activity/id #uuid "dbe3fe78-cdde-54f2-83c4-33d9a9c37637" :activity/scope {:db/id #edb/ref 17592186049734 :topic/id #uuid "0f38dc01-8b15-5428-9965-6c74ccac2918" :topic/math-academy-id 3752} :activity/steps [{:db/id #edb/ref 17592186180332 :step/content {:db/id #edb/ref 17592186180781 :tutorial/content "When solving a multivariable equation for a particular variable, we sometimes have to factor some terms in the equation to reach the solution.\n\nFor example, let's solve the following equation for the variable $d\\mathbin{:}$\n\n$$\n2cd - 3d = 5\n$$\n\nFirst, we factor out $d$ in the expression on the left-hand side. This gives\n\n$$\nd(2c-3) = 5.\n$$\n\nThen, we divide both sides of the equation by $(2c-3)$ to isolate $d\\mathbin{:}$\n\n$$\n\\begin{aligned}d(2c-3) & =5 \\\\ \\frac{d(2c-3)}{2c-3} & =\\frac{5}{2c-3} \\\\ \\frac{d\\cancel{(2c-3)}}{\\cancel{2c-3}} & =\\frac{5}{2c-3} \\\\ d & =\\frac{5}{2c-3}\\end{aligned}\n$$\n\n**Note:** This result assumes that $2c-3\\neq 0.$" :tutorial/id #uuid "46409ede-9b62-5196-b665-c5ba29062b0d" :tutorial/math-academy-id 8665 :tutorial/title "Introduction"} :step/id #uuid "3089dcee-65bb-5662-9c1b-2bc3b1fd5a0d" :step/math-academy-id 952850 :step/next {:db/id #edb/ref 17592186180333}} {:db/id #edb/ref 17592186180333 :step/content {:db/id #edb/ref 17592186179639 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179467 :question/id #uuid "ae7ee9c8-3162-564e-a3f2-f235b60527f7" :question/math-academy-id "e-13903"} :knowledge-point/id #uuid "eade8768-b97c-5e90-ad02-255b9e8f8dae" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048649} {:db/id #edb/ref 17592186050843} {:db/id #edb/ref 17592186051079}] :knowledge-point/questions [{:db/id #edb/ref 17592186180062} {:db/id #edb/ref 17592186180119} {:db/id #edb/ref 17592186488221} {:db/id #edb/ref 17592186488249}] :knowledge-point/title "Solving Linear Equations by Factoring"} :step/id #uuid "3b5ddf75-036b-5e27-b8bd-3c9f15c022b4" :step/math-academy-id 952851 :step/next {:db/id #edb/ref 17592186180334}} {:db/id #edb/ref 17592186180334 :step/content {:db/id #edb/ref 17592186179640 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179469 :question/id #uuid "7f0aa09d-c765-5ab5-ac89-3fb4ce168d90" :question/math-academy-id "e-13905"} :knowledge-point/id #uuid "3fc2b01b-a60c-53a7-837e-1c6d9a941e98" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049181}] :knowledge-point/questions [{:db/id #edb/ref 17592186180135} {:db/id #edb/ref 17592186180230} {:db/id #edb/ref 17592186488179} {:db/id #edb/ref 17592186488267} {:db/id #edb/ref 17592186492851} {:db/id #edb/ref 17592186492857} {:db/id #edb/ref 17592186492921}] :knowledge-point/title "Solving Linear Equations With Variables on Both Sides"} :step/id #uuid "73aa52b5-b1eb-5d43-851b-e4c810c2ef00" :step/math-academy-id 952855 :step/next {:db/id #edb/ref 17592186180335}} {:db/id #edb/ref 17592186180335 :step/content {:db/id #edb/ref 17592186179641 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179471 :question/id #uuid "f9e1e805-32a3-5d25-8b09-36707350ab61" :question/math-academy-id "e-13907"} :knowledge-point/id #uuid "b201f4cd-b39c-5ca5-9565-0618859cd15a" :knowledge-point/questions [{:db/id #edb/ref 17592186180120} {:db/id #edb/ref 17592186180136} {:db/id #edb/ref 17592186233426} {:db/id #edb/ref 17592186488213} {:db/id #edb/ref 17592186488231} {:db/id #edb/ref 17592186492870}] :knowledge-point/title "Solving Linear Equations Using Cross Multiplication"} :step/id #uuid "8792ecc7-4ffa-5de3-b84a-5c51e5d91d42" :step/math-academy-id 952859}] :activity/title "Solving Linear Equations With Unknown Coefficients by Factoring" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179895}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186492991} :activity/id #uuid "b35e3a1b-0166-5516-8aa0-8b1121392270" :activity/scope {:db/id #edb/ref 17592186049734 :topic/id #uuid "0f38dc01-8b15-5428-9965-6c74ccac2918" :topic/math-academy-id 3752} :activity/steps [{:db/id #edb/ref 17592186492942 :step/content {:db/id #edb/ref 17592186492921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b902175b-6032-5abd-b89d-ba04a4e007bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5q-8}" :db/id #edb/ref 17592186492588}] :answer-field/correct {:db/id #edb/ref 17592186492588} :answer-field/id #uuid "2f144f7c-581f-5a2e-8b69-cd844d062564" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186492721}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f0804f3e-fd28-56db-8f75-05c9b0dc9357" :question/math-academy-id "q-215770" :question/problem "If $5pq=1+8p,$ then $p=${{field-1}}." :question/worked-solution "We need to isolate all terms with $p$ on one side of the equation. To do this, we subtract $8p$ from both sides:\n\n$$\n\\begin{aligned}5pq & =1+8p \\\\ 5pq-8p & =1+8p-8p \\\\ 5pq-8p & =1\\end{aligned}\n$$\n\nNotice that all terms containing $p$ are on the left-hand side, and all terms independent of $p$ are on the right-hand side.\n\nNext, we factor out $p$ in the expression on the left-hand side.\n\n$$\n\\begin{aligned}5pq-8p & =1 \\\\ (5q-8)p & =1\\end{aligned}\n$$\n\nFinally, we divide both sides by $(5q-8)$ to isolate $p:$\n\n$$\n\\begin{aligned}(5q-8)p & =1 \\\\ \\frac{(5q-8)p}{5q-8} & =\\frac{1}{5q-8} \\\\ \\frac{\\cancel{(5q-8)}p}{\\cancel{5q-8}} & =\\frac{1}{5q-8} \\\\ p & =\\frac{1}{5q-8}\\end{aligned}\n$$\n\n**Note:** This result assumes that $5q-8\\ne 0.$"} :step/id #uuid "393d58c8-b803-5dd1-8f8b-d2a9adb7e4fd" :step/next {:db/id #edb/ref 17592186492999}} {:db/id #edb/ref 17592186492974 :step/content {:db/id #edb/ref 17592186492851 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16558bc4-6554-5913-bf18-952e26ae16e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{f+7}{11f-4}" :db/id #edb/ref 17592186492258} {:answer/id #uuid "27236521-7973-56f9-87e0-9e36f16e6909" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{f-11}{7f-4}" :db/id #edb/ref 17592186492296} {:answer/id #uuid "272872da-d0aa-5122-b591-cb63db2b1fd4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{f+11}{7f-4}" :db/id #edb/ref 17592186492297} {:answer/id #uuid "4bd79e1c-2bd0-5b12-8d18-2f49a2dfbe20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{f-7}{11f-4}" :db/id #edb/ref 17592186492364} {:answer/id #uuid "c87c5036-7ee4-5a07-b18a-2234e9e8e8d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7f}{11f-4}" :db/id #edb/ref 17592186492617}] :answer-field/correct {:db/id #edb/ref 17592186492364} :answer-field/id #uuid "ef959e6c-abd2-51af-b36c-77958fb6ba0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492808}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3e267a47-5572-5324-88e0-0916a71d377e" :question/math-academy-id "q-133848" :question/problem "If $11fg+7=f+4g,$ then $g=$" :question/worked-solution "We need to isolate all terms with $g$ on one side of the equation. To do this, we start by subtracting $7$ from both sides: \n\n$$\n\\begin{aligned}11fg+7 & =f+4g \\\\ 11fg+7-7 & =f+4g-7 \\\\ 11fg & =f+4g-7\\end{aligned}\n$$\n\nNext, we subtract $4g$ from both sides of the equation:\n\n$$\n\\begin{aligned}11fg & =f+4g-7 \\\\ 11fg-4g & =f+4g-7-4g \\\\ 11fg-4g & =f-7\\end{aligned}\n$$\n\nNotice that all terms containing $g$ are on the left-hand side, and all terms independent of $g$ are on the right-hand side.\n\nThen, we factor out $g$ in the expression on the left-hand side.\n\n$$\n\\begin{aligned}11fg-4g & =f-7 \\\\ g(11f-4) & =f-7\\end{aligned}\n$$\n\nFinally, we divide both sides by $(11f-4)$ to isolate $g:$\n\n$$\n\\begin{aligned}g(11f-4) & =f-7 \\\\ \\frac{g(11f-4)}{11f-4} & =\\frac{f-7}{11f-4} \\\\ \\frac{g\\cancel{(11f-4)}}{\\cancel{11f-4}} & =\\frac{f-7}{11f-4} \\\\ g & =\\frac{f-7}{11f-4}\\end{aligned}\n$$\n\n**Note:** This result assumes that $11f-4\\ne 0.$"} :step/id #uuid "a17be8bf-d2ce-5f25-87af-9e999ef8b896" :step/next {:db/id #edb/ref 17592186492942}} {:db/id #edb/ref 17592186492991 :step/content {:db/id #edb/ref 17592186492857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "014429d8-b013-59f0-9ef9-dceaaf7c1a8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{2g-3}" :db/id #edb/ref 17592186492224} {:answer/id #uuid "37e76a90-f6df-5aa4-9537-258eef7d84ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2g+1}{3}" :db/id #edb/ref 17592186492336} {:answer/id #uuid "43633fbd-1329-596c-93e7-dc24c7abbb5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3g+2}" :db/id #edb/ref 17592186492352} {:answer/id #uuid "57feefc7-e907-5471-a117-f1cad8eea4eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3g+2}{2}" :db/id #edb/ref 17592186492385} {:answer/id #uuid "de9c99ca-2c92-5c32-84c7-e35e8e18c3ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3g+2}" :db/id #edb/ref 17592186492651}] :answer-field/correct {:db/id #edb/ref 17592186492651} :answer-field/id #uuid "6205bf4c-4b47-54d9-8d23-7d84c77677a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492745}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4e9751ba-f740-5aab-b93b-fcf4271231ee" :question/math-academy-id "q-101832" :question/problem "If $1-3fg=2f-1,$ then $f=$" :question/worked-solution "We need to isolate all terms with $f$ on one side of the equation. To do this, we start by subtracting $1$ from both sides: \n\n$$\n\\begin{aligned}1-3fg & =2f-1 \\\\ 1-3fg-1 & =2f-1-1 \\\\ -3fg & =2f-2\\end{aligned}\n$$\n\nNext, we subtract $2f$ from both sides of the equation:\n\n$$\n\\begin{aligned}-3fg & =2f-2 \\\\ -3fg-2f & =2f-2-2f \\\\ -3fg-2f & =-2\\end{aligned}\n$$\n\nNotice that all terms containing $f$ are on the left-hand side, and all terms independent of $f$ are on the right-hand side.\n\nNext, we factor out $f$ in the expression on the left-hand side.\n\n$$\n\\begin{aligned}-3fg-2f & =-2 \\\\ f(-3g-2) & =-2\\end{aligned}\n$$\n\nFinally, we divide both sides by $(-3g-2)$ to isolate $f:$\n\n$$\n\\begin{aligned}f(-3g-2) & =-2 \\\\ \\frac{f(-3g-2)}{-3g-2} & =\\frac{-2}{-3g-2} \\\\ \\frac{f\\cancel{(-3g-2)}}{\\cancel{-3g-2}} & =\\frac{-2}{-(3g+2)} \\\\ f & =\\frac{2}{3g+2}\\end{aligned}\n$$\n\n**Note:** This result assumes that $3g+2\\ne 0.$"} :step/id #uuid "c1b90b91-ff5b-52bb-aa5d-786d8f31778b" :step/next {:db/id #edb/ref 17592186492974}} {:db/id #edb/ref 17592186492999 :step/content {:db/id #edb/ref 17592186492870 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35f1e89f-7b21-5fb2-aeee-c538c33cdaff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{12p+15}" :db/id #edb/ref 17592186492331}] :answer-field/correct {:db/id #edb/ref 17592186492331} :answer-field/id #uuid "b2ac98ce-4a52-56e4-b996-e489a99ca79a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186492776}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7040b2b2-59d1-533f-a002-d851f289f8ef" :question/math-academy-id "q-215794" :question/problem "If $\\frac{4pq+5}{5}=\\frac{4-3q}{3},$ then $q=${{field-1}}." :question/worked-solution "We need to isolate all terms with $q$ on one side of the equation. To do this, we first cross-multiply:\n\n$$\n\\begin{aligned}\\frac{4pq+5}{5} & =\\frac{4-3q}{3} \\\\ 3\\cdot (4pq+5) & =5\\cdot (4-3q) \\\\ 12pq+15 & =20-15q\\end{aligned}\n$$\n\nNext, we add $15q$ to both sides of the equation:\n\n$$\n\\begin{aligned}12pq+15 & =20-15q \\\\ 12pq+15+15q & =20-15q+15q \\\\ 12pq+15+15q & =20\\end{aligned}\n$$\n\nThen, we subtract $15$ from both sides of the equation:\n\n$$\n\\begin{aligned}12pq+15+15q & =20 \\\\ 12pq+15+15q-15 & =20-15 \\\\ 12pq+15q & =5\\end{aligned}\n$$\n\nNotice that all terms containing $q$ are on the left-hand side, and all terms independent of $q$ are on the right-hand side.\n\nThen, we factor out $q$ from the left-hand side:\n\n$$\n\\begin{aligned}12pq+15q & =5 \\\\ (12p+15)q & =5\\end{aligned}\n$$\n\nFinally, we divide both sides by $(12p+15)$ to isolate $q:$\n\n$$\n\\begin{aligned}(12p+15)q & =5 \\\\ \\frac{(12p+15)q}{12p+15} & =\\frac{5}{12p+15} \\\\ \\frac{\\cancel{(12p+15)}q}{\\cancel{12p+15}} & =\\frac{5}{12p+15} \\\\ q & =\\frac{5}{12p+15}\\end{aligned}\n$$\n\n**Note:** This result assumes that $12p+15\\ne 0.$"} :step/id #uuid "e1e772cc-8c6c-589d-97d1-c78fa38dd9e0"}] :activity/title "Solving Linear Equations With Unknown Coefficients by Factoring" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186492213}]}
