#{[{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186180332} :activity/id #uuid "dbe3fe78-cdde-54f2-83c4-33d9a9c37637" :activity/scope {:db/id #edb/ref 17592186049734 :topic/id #uuid "0f38dc01-8b15-5428-9965-6c74ccac2918" :topic/math-academy-id 3752} :activity/steps [{:db/id #edb/ref 17592186180332 :step/content {:db/id #edb/ref 17592186180781 :tutorial/content "When solving a multivariable equation for a particular variable, we sometimes have to factor some terms in the equation to reach the solution.\n\nFor example, let's solve the following equation for the variable $d\\mathbin{:}$\n\n$$\n2cd - 3d = 5\n$$\n\nFirst, we factor out $d$ in the expression on the left-hand side. This gives\n\n$$\nd(2c-3) = 5.\n$$\n\nThen, we divide both sides of the equation by $(2c-3)$ to isolate $d\\mathbin{:}$\n\n$$\n\\begin{aligned}d(2c-3) & =5 \\\\ \\frac{d(2c-3)}{2c-3} & =\\frac{5}{2c-3} \\\\ \\frac{d\\cancel{(2c-3)}}{\\cancel{2c-3}} & =\\frac{5}{2c-3} \\\\ d & =\\frac{5}{2c-3}\\end{aligned}\n$$\n\n**Note:** This result assumes that $2c-3\\neq 0.$" :tutorial/id #uuid "46409ede-9b62-5196-b665-c5ba29062b0d" :tutorial/math-academy-id 8665 :tutorial/title "Introduction"} :step/id #uuid "3089dcee-65bb-5662-9c1b-2bc3b1fd5a0d" :step/math-academy-id 952850 :step/next {:db/id #edb/ref 17592186180333}} {:db/id #edb/ref 17592186180333 :step/content {:db/id #edb/ref 17592186179639 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179467 :question/id #uuid "ae7ee9c8-3162-564e-a3f2-f235b60527f7" :question/math-academy-id "e-13903"} :knowledge-point/id #uuid "eade8768-b97c-5e90-ad02-255b9e8f8dae" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048649} {:db/id #edb/ref 17592186050843} {:db/id #edb/ref 17592186051079}] :knowledge-point/questions [{:db/id #edb/ref 17592186180062} {:db/id #edb/ref 17592186180119} {:db/id #edb/ref 17592186488221} {:db/id #edb/ref 17592186488249}] :knowledge-point/title "Solving Linear Equations by Factoring"} :ste