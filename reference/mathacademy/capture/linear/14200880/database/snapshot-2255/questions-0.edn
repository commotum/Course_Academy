#{[{:db/id #edb/ref 17592186064064 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064189 :knowledge-point/id #uuid "44341f33-035e-5e4a-9955-2590a9770f3a" :knowledge-point/title "Evaluating Logarithms Using the Definition"}] :question/id #uuid "4b2df191-5a85-5600-b055-63d8a84ddcc5" :question/math-academy-id "e-3983" :question/problem "Evaluate $\\log_{2} \\left(2^{5} \\right)$." :question/worked-solution "The logarithm reverses the action of the exponent. The idea is that the log of a power of the base equals the power itself:\n\n$$\n\\log_b(b^x) = x\n$$\n\nIn our case, we have $b=2$ and $x=5$. Therefore,\n\n$$\n\\log_{2}\\left(2^{5}\\right) = 5\n$$"}] [{:db/id #edb/ref 17592186064065 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064190 :knowledge-point/id #uuid "cdcbbc8b-3510-5b4a-913b-5b69f997d434" :knowledge-point/title "Evaluating Special Values of Logarithms"}] :question/id #uuid "1c2d7a63-4d9c-55a5-809a-5c1f84531a6f" :question/math-academy-id "e-3984" :question/problem "Find the value of $\\log_{8}{8}$." :question/worked-solution "We have the general rule that\n\n$$\n\\log_n n = 1\n$$\n\nIn our case, $n=8$. Therefore,\n\n$$\n\\log_{8}{8} =1\n$$"}] [{:db/id #edb/ref 17592186064066 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064191 :knowledge-point/id #uuid "79a0909f-afba-56f6-a5a0-082403b04be3" :knowledge-point/title "Evaluating the Logarithm of a Fraction or Root"}] :question/id #uuid "8310cf45-a98c-589a-8df6-b707171095b5" :question/math-academy-id "e-3985" :question/problem "Evaluate $\\log_{2} \\left(\\dfrac 1 {8} \\right)$." :question/worked-solution "First, we rewrite\n\n$$\n\\dfrac{1}{8}\n$$\n\nas a power of $2$ (the base of the logarithm) as follows:\n\n$$\n\\dfrac{1}{8} = \\dfrac{1}{2^3} = 2^{-3}\n$$\n\nTherefore, we have\n\n$$\n\\log_{2} \\left(\\dfrac 1 {8} \\right)= \\log_{2} (2^{-3})\n$$\n\nNow we can proceed as usual. The log of a power of the base equals the power itself:\n\n$$\n\\log_b(b^x) = x\n$$\n\nIn our case, we have $b=2$ and $x=-3$. Therefore,\n\n$$\n\\log_{2}(2^{-3})= -3\n$$"}] [{:db/id #edb/ref 17592186064067 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064192 :knowledge-point/id #uuid "cc1c6931-cc04-5014-9bf6-5ebc5dc07728" :knowledge-point/title "Evaluating Logarithms Using Exponents"}] :question/id #uuid "d137aa5c-f148-5a6f-bbda-0d88557f8ea9" :question/math-academy-id "e-3987" :question/problem "Find the value of $\\log_{3}{9}$." :question/worked-solution "First, we rewrite $9$ as a power of $3$ (the base of the logarithm) as follows:\n\n$$\n9 = 3^2\n$$\n\nTherefore, we have\n\n$$\n\\log_{3}{9} = \\log_{3}(3^2)\n$$\n\nNow we can proceed as usual. The log of a power of the base equals the power itself:\n\n$$\n\\log_b(b^x) = x\n$$\n\nIn our case, we have $b = 3$ and $x = 2$. Therefore,\n\n$$\n\\log_{3}(3^2) = 2\n$$"}] [{:db/id #edb/ref 17592186064638 :knowledge-point/_questions [{:db/id #edb/ref 17592186064190 :knowledge-point/id #uuid "cdcbbc8b-3510-5b4a-913b-5b69f997d434" :knowledge-point/title "Evaluating Special Values of Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "baa4c6ed-0656-52a9-b84d-6c0586bbf1ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186061886} {:answer/id #uuid "ce9731c6-1cd0-51f2-951f-91af70d3b2f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186061887} {:answer/id #uuid "d41dcfb3-71c0-5308-ad84-d40f6585c83c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186061888} {:answer/id #uuid "0bb0f941-5f6e-52b5-9643-7b85a074122a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186061889} {:answer/id #uuid "17dc2606-aa3d-56e0-99c4-8ce2f7b9c915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186061890}] :answer-field/id #uuid "e4fb3bc1-1f84-543d-b0c9-f3618bab9b3e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186061885}] :question/id #uuid "5d5f2f26-ac35-577f-8f70-a5c17a0b97f4" :question/math-academy-id "q-24416" :question/problem "What is $\\log_{4} 1$?"}]}
