{:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186517965}] :answer-field/correct {:answer/id #uuid "e12d5b5f-3854-5910-856f-c7def5deed84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186517912} :answer-field/id #uuid "9fd820ef-fff2-5f6c-af98-72bbd3c74b3d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186518049}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c67b84ce-63b0-5172-a4ca-d019c33deb20" :question/math-academy-id "q-108074" :question/problem "${log}_{2}⁡(256)=$" :question/worked-solution "First, we rewrite $256$ as a power of $2$ (the base of the logarithm) as follows:\n\n$$\n256={2}^{8}\n$$\n\nTherefore, we have:\n\n$$\n{log}_{2}⁡256={log}_{2}⁡({2}^{8})\n$$\n\nThe logarithm reverses the action of the exponent. The principle is:\n\n$$\n{log}_{b}⁡({b}^{x})=x\n$$\n\nIn our case, we have $b=2$ and $x=8.$ Therefore:\n\n$$\n{log}_{2}⁡({2}^{8})=8\n$$"}] [{:db/id #edb/ref 17592186518217 :knowledge-point/_questions [{:db/id #edb/ref 17592186064190 :knowledge-point/id #uuid "cdcbbc8b-3510-5b4a-913b-5b69f997d434" :knowledge-point/title "Evaluating Special Values of Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cf4a4a3-14bc-51ba-a37c-be18c84ace28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186517540} {:answer/id #uuid "6cde5cd2-e2e9-5557-835f-19622e863fd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186517694} {:answer/id #uuid "b4d68802-c015-562c-b0cc-e6654c19cc99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186517829} {:answer/id #uuid "b9c6d849-d0b