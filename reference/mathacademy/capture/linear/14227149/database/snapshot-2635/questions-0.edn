#{[{:db/id #edb/ref 17592186244126 :knowledge-point/_questions [{:db/id #edb/ref 17592186092382 :knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "462f21c8-a32c-5cda-84b7-37744e22718b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=16x-8" :db/id #edb/ref 17592186241815} {:answer/id #uuid "4b650713-54c4-53ad-9158-64cadb27ca27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-2" :db/id #edb/ref 17592186241859} {:answer/id #uuid "5726209a-7467-583c-a028-1f93390b638f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=16x-12" :db/id #edb/ref 17592186241970} {:answer/id #uuid "a96129cb-4819-5b81-9f60-2fc2160dba34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-13" :db/id #edb/ref 17592186242665} {:answer/id #uuid "dda5ca10-115e-5cb5-bc36-7f1acf094d5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x-12" :db/id #edb/ref 17592186243151}] :answer-field/correct {:answer/id #uuid "462f21c8-a32c-5cda-84b7-37744e22718b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=16x-8" :db/id #edb/ref 17592186241815} :answer-field/id #uuid "ae01ef85-57dd-5226-8116-895f71485c74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243751}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d0e5b8a4-9dc2-5fdd-9f7d-f9d1860644a8" :question/math-academy-id "q-10835" :question/problem "Find the equation of the tangent to the curve  $y=2{x}^{2}+8x$ at the point $(2,24).$" :question/worked-solution "Let $f(x)=2{x}^{2}+8x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}+8x)=4x+8.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(2)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(2)=4(2)+8=16\\,.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=16$ and the coordinates of our point $(2,24),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(24) & =16(x-2) \\\\ y & =16x-32+24 \\\\ y & =16x-8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186546983 :knowledge-point/_questions [{:db/id #edb/ref 17592186092383 :knowledge-point/id #uuid "84c8ba29-95c9-5494-be0b-9b67bee6e45c" :knowledge-point/title "Determining where a Tangent Line Intersects an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3668cf4b-8050-5a96-996b-c27c89d6fa21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186546368}] :answer-field/correct {:answer/id #uuid "3668cf4b-8050-5a96-996b-c27c89d6fa21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186546368} :answer-field/id #uuid "a0bed702-55a8-5fce-ad62-782cfcd3d3f5" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186546897} {:answer-field/choices [{:answer/id #uuid "b6894baa-e048-55ba-9e2f-c9d22cb15c27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186546662}] :answer-field/correct {:answer/id #uuid "b6894baa-e048-55ba-9e2f-c9d22cb15c27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186546662} :answer-field/id #uuid "fc3c6a28-5baf-5cae-a10f-967bb181d649" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186546955}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2c14c3ab-0147-5311-bdf2-26e728ddcd5d" :question/math-academy-id "q-304084" :question/problem "Find where the tangent to the curve $y=\\frac{2}{x}+x$ at the point  $(2,3)$ intersects the $x$-axis.\n\nThe tangent intersects the $x$-axis at\n$($\n{{field-1}}$,$\n{{field-2}} $).$" :question/worked-solution "Let $f(x)=\\frac{2}{x}+x.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{x}+x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{x})+\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{-1})+\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =-2{x}^{-2}+1 \\\\  & =-\\frac{2}{{x}^{2}}+1.\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m & ={f}^{′}(2) \\\\  & =-\\frac{2}{{2}^{2}}+1 \\\\  & =-\\frac{2}{4}+1 \\\\  & =-\\frac{1}{2}+1 \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-3 & =\\frac{1}{2}(x-2) \\\\ y & =\\frac{1}{2}x-1+3 \\\\ y & =\\frac{1}{2}x+2.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $x$-axis, we set $y=0$ and solve:\n\n$$\n\\begin{aligned}\\frac{1}{2}x+2 & =0 \\\\ \\frac{1}{2}x & =-2 \\\\ x & =-2\\cdot 2 \\\\ x & =-4\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(-4,0).$"}] [{:db/id #edb/ref 17592186547002 :knowledge-point/_questions [{:db/id #edb/ref 17592186092383 :knowledge-point/id #uuid "84c8ba29-95c9-5494-be0b-9b67bee6e45c" :knowledge-point/title "Determining where a Tangent Line Intersects an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42fbe54a-78e8-5015-9ce0-c43783605f0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-\\frac{6}{5})" :db/id #edb/ref 17592186546401} {:answer/id #uuid "69ddeca3-09f2-58ab-9d78-98c1cd90a178" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6,0)" :db/id #edb/ref 17592186546482} {:answer/id #uuid "6ba59fb1-af14-5b7b-abe3-1d96725a92c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{6}{5},0)" :db/id #edb/ref 17592186546488} {:answer/id #uuid "9ebd227f-5bff-5ee9-8bd2-a6190e5a4b4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{3}{5},0)" :db/id #edb/ref 17592186546605} {:answer/id #uuid "cc873da9-faeb-5c9f-918f-a7d548331962" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{1}{5},0)" :db/id #edb/ref 17592186546705}] :answer-field/correct {:answer/id #uuid "6ba59fb1-af14-5b7b-abe3-1d96725a92c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{6}{5},0)" :db/id #edb/ref 17592186546488} :answer-field/id #uuid "4e5755c3-35f7-5f3d-a001-f80f16bfbe50" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186546859}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4e139db0-1707-5607-ac19-864fb4bd55f1" :question/math-academy-id "q-70515" :question/problem "Find where the tangent to the curve $y={x}^{5}+2$ at the point $(-1,1)$ intersects the $x$-axis." :question/worked-solution "Let $f(x)={x}^{5}+2.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{5}+2)=5{x}^{4}\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m={f}^{′}(-1)=5(-1)^{4}=5.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =5(x+1) \\\\ y & =5x+5+1 \\\\ y & =5x+6.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $x$-axis, we set $y=0$ and solve:\n\n$$\n\\begin{aligned}0 & =5x+6 \\\\ x & =-\\frac{6}{5}\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(-\\frac{6}{5},0).$"}]}
