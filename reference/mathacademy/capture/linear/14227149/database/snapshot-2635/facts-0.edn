592186547140 #edb/ref 17592186045417] [17592186546243 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186546243 #edb/ref 1045 "Calculating the Equation of a Tangent Line Using Differentiation" #edb/ref 17592186045417] [17592186546243 #edb/ref 1046 #edb/ref 17592186547125 #edb/ref 17592186045417] [17592186546243 #edb/ref 1048 #edb/ref 17592186046647 #edb/ref 17592186045417] [17592186546243 #edb/ref 1049 #edb/ref 17592186050644 #edb/ref 17592186045417] [17592186546243 #edb/ref 1053 #uuid "70f11865-cb63-5f90-bb94-c66ab6be8368" #edb/ref 17592186045417] [17592186546368 #edb/ref 1080 "0" #edb/ref 17592186045417] [17592186546368 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186546368 #edb/ref 1083 #uuid "3668cf4b-8050-5a96-996b-c27c89d6fa21" #edb/ref 17592186045417] [17592186546401 #edb/ref 1080 "(0,-\\frac{6}{5})" #edb/ref 17592186045417] [17592186546401 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186546401 #edb/ref 1083 #uuid "42fbe54a-78e8-5015-9ce0-c43783605f0e" #edb/ref 17592186045417] [17592186546482 #edb/ref 1080 "(-6,0)" #edb/ref 17592186045417] [17592186546482 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186546482 #edb/ref 1083 #uuid "69ddeca3-09f2-58ab-9d78-98c1cd90a178" #edb/ref 17592186045417] [17592186546488 #edb/ref 1080 "(-\\frac{6}{5},0)" #edb/ref 17592186045417] [17592186546488 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186546488 #edb/ref 1083 #uuid "6ba59fb1-af14-5b7b-abe3-1d96725a92c6" #edb/ref 17592186045417] [17592186546605 #edb/ref 1080 "(-\\frac{3}{5},0)" #edb/ref 17592186045417] [17592186546605 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186546605 #edb/ref 1083 #uuid "9ebd227f-5bff-5ee9-8bd2-a6190e5a4b4a" #edb/ref 17592186045417] [17592186546662 #edb/ref 1080 "-4" #edb/ref 17592186045417] [17592186546662 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186546662 #edb/ref 1083 #uuid "b6894baa-e048-55ba-9e2f-c9d22cb15c27" #edb/ref 17592186045417] [17592186546705 #edb/ref 1080 "(-\\frac{1}{5},0)" #edb/ref 17592186045417] [17592186546705 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186546705 #edb/ref 1083 #uuid "cc873da9-faeb-5c9f-918f-a7d548331962" #edb/ref 17592186045417] [17592186546859 #edb/ref 1075 #edb/ref 17592186546401 #edb/ref 17592186045417] [17592186546859 #edb/ref 1075 #edb/ref 17592186546482 #edb/ref 17592186045417] [17592186546859 #edb/ref 1075 #edb/ref 17592186546488 #edb/ref 17592186045417] [17592186546859 #edb/ref 1075 #edb/ref 17592186546605 #edb/ref 17592186045417] [17592186546859 #edb/ref 1075 #edb/ref 17592186546705 #edb/ref 17592186045417] [17592186546859 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186546859 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186546859 #edb/ref 1078 #edb/ref 17592186546488 #edb/ref 17592186045417] [17592186546859 #edb/ref 1079 #uuid "4e5755c3-35f7-5f3d-a001-f80f16bfbe50" #edb/ref 17592186045417] [17592186546897 #edb/ref 1075 #edb/ref 17592186546368 #edb/ref 17592186045417] [17592186546897 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186546897 #edb/ref 1077 "field-2" #edb/ref 17592186045417] [17592186546897 #edb/ref 1078 #edb/ref 17592186546368 #edb/ref 17592186045417] [17592186546897 #edb/ref 1079 #uuid "a0bed702-55a8-5fce-ad62-782cfcd3d3f5" #edb/ref 17592186045417] [17592186546955 #edb/ref 1075 #edb/ref 17592186546662 #edb/ref 17592186045417] [17592186546955 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186546955 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186546955 #edb/ref 1078 #edb/ref 17592186546662 #edb/ref 17592186045417] [17592186546955 #edb/ref 1079 #uuid "fc3c6a28-5baf-5cae-a10f-967bb181d649" #edb/ref 17592186045417] [17592186546983 #edb/ref 1068 #edb/ref 17592186546897 #edb/ref 17592186045417] [17592186546983 #edb/ref 1068 #edb/ref 17592186546955 #edb/ref 17592186045417] [17592186546983 #edb/ref 1069 "q-304084" #edb/ref 17592186045417] [17592186546983 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186546983 #edb/ref 1071 "Find where the tangent to the curve $y=\\frac{2}{x}+x$ at the point  $(2,3)$ intersects the $x$-axis.\n\nThe tangent intersects the $x$-axis at\n$($\n{{field-1}}$,$\n{{field-2}} $).$" #edb/ref 17592186045417] [17592186546983 #edb/ref 1072 #uuid "2c14c3ab-0147-5311-bdf2-26e728ddcd5d" #edb/ref 17592186045417] [17592186546983 #edb/ref 1074 "Let $f(x)=\\frac{2}{x}+x.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{x}+x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{x})+\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{-1})+\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =-2{x}^{-2}+1 \\\\  & =-\\frac{2}{{x}^{2}}+1.\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m & ={f}^{′}(2) \\\\  & =-\\frac{2}{{2}^{2}}+1 \\\\  & =-\\frac{2}{4}+1 \\\\  & =-\\frac{1}{2}+1 \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-3 & =\\frac{1}{2}(x-2) \\\\ y & =\\frac{1}{2}x-1+3 \\\\ y & =\\frac{1}{2}x+2.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $x$-axis, we set $y=0$ and solve:\n\n$$\n\\begin{aligned}\\frac{1}{2}x+2 & =0 \\\\ \\frac{1}{2}x & =-2 \\\\ x & =-2\\cdot 2 \\\\ x & =-4\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(-4,0).$" #edb/ref 17592186045417] [17592186547002 #edb/ref 1068 #edb/ref 17592186546859 #edb/ref 17592186045417] [17592186547002 #edb/ref 1069 "q-70515" #edb/ref 17592186045417] [17592186547002 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186547002 #edb/ref 1071 "Find where the tangent to the curve $y={x}^{5}+2$ at the point $(-1,1)$ intersects the $x$-axis." #edb/ref 17592186045417] [17592186547002 #edb/ref 1072 #uuid "4e139db0-1707-5607-ac19-864fb4bd55f1" #edb/ref 17592186045417] [17592186547002 #edb/ref 1074 "Let $f(x)={x}^{5}+2.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{5}+2)=5{x}^{4}\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m={f}^{′}(-1)=5(-1)^{4}=5.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =5(x+1) \\\\ y & =5x+5+1 \\\\ y & =5x+6.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $x$-axis, we set $y=0$ and solve:\n\n$$\n\\begin{aligned}0 & =5x+6 \\\\ x & =-\\frac{6}{5}\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(-\\frac{6}{5},0).$" #edb/ref 17592186045417] [17592186547125 #edb/ref 1058 #edb/ref 17592186547126 #edb/ref 17592186045417] [17592186547125 #edb/ref 1062 #uuid "8e022878-16c2-5957-b74e-008a82b54dcb" #edb/ref 17592186045417] [17592186547125 #edb/ref 1063 #edb/ref 17592186244126 #edb/ref 17592186045417] [17592186547126 #edb/ref 1058 #edb/ref 17592186547140 #edb/ref 17592186045417] [17592186547126 #edb/ref 1062 #uuid "8f0e1de1-445c-5ef0-8ebc-283d32ff2db4" #edb/ref 17592186045417] [17592186547126 #edb/ref 1063 #edb/ref 17592186547002 #edb/ref 17592186045417] [17592186547140 #edb/ref 1062 #uuid "b17b54ae-3884-5315-bfe6-1b6dd906db79" #edb/ref 17592186045417] [17592186547140 #edb/ref 1063 #edb/ref 17592186546983 #edb/ref 17592186045417]}
