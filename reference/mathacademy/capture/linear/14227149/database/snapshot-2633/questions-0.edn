#{[{:db/id #edb/ref 17592186244126 :knowledge-point/_questions [{:db/id #edb/ref 17592186092382 :knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "462f21c8-a32c-5cda-84b7-37744e22718b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=16x-8" :db/id #edb/ref 17592186241815} {:answer/id #uuid "4b650713-54c4-53ad-9158-64cadb27ca27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-2" :db/id #edb/ref 17592186241859} {:answer/id #uuid "5726209a-7467-583c-a028-1f93390b638f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=16x-12" :db/id #edb/ref 17592186241970} {:answer/id #uuid "a96129cb-4819-5b81-9f60-2fc2160dba34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-13" :db/id #edb/ref 17592186242665} {:answer/id #uuid "dda5ca10-115e-5cb5-bc36-7f1acf094d5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x-12" :db/id #edb/ref 17592186243151}] :answer-field/correct {:answer/id #uuid "462f21c8-a32c-5cda-84b7-37744e22718b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=16x-8" :db/id #edb/ref 17592186241815} :answer-field/id #uuid "ae01ef85-57dd-5226-8116-895f71485c74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243751}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d0e5b8a4-9dc2-5fdd-9f7d-f9d1860644a8" :question/math-academy-id "q-10835" :question/problem "Find the equation of the tangent to the curve  $y=2{x}^{2}+8x$ at the point $(2,24).$" :question/worked-solution "Let $f(x)=2{x}^{2}+8x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}+8x)=4x+8.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(2)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(2)=4(2)+8=16\\,.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=16$ and the coordinates of our point $(2,24),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(24) & =16(x-2) \\\\ y & =16x-32+24 \\\\ y & =16x-8.\\end{aligned}\n$$"}]}
