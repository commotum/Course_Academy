#{[{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186176635} :activity/id #uuid "a22648a9-1107-5fad-945a-32867ab1ed64" :activity/scope {:db/id #edb/ref 17592186050473 :topic/id #uuid "4c6d2580-78c9-5782-9c3a-465dcd055b32" :topic/math-academy-id 3562} :activity/steps [{:db/id #edb/ref 17592186176635 :step/content {:db/id #edb/ref 17592186177095 :tutorial/content "To find the slope of a line that is perpendicular to a given line $y=mx+b,$ we can just take the **negative reciprocal** of the given slope $m.$ So, the slope of the perpendicular line would be $-\\dfrac{1}{m}.$\n\nFor example, consider the line $y = 3x + 1,$ which has a slope of $m=3.$ The negative reciprocal of $3$ is $-\\dfrac{1}{3}.$ So, any line with a slope of $-\\dfrac{1}{3}$ will be perpendicular to the given line, because\n\n$$\n3 \\cdot \\left( -\\dfrac{1}{3} \\right) = -1.\n$$\n\nTo illustrate, some lines with a slope of $-\\dfrac{1}{3}$ are plotted below. We can see that they are all perpendicular to the given line $y=3x+1.$\n\n![](images/e2/e2772aa0cbe3e736e1129b52c59d3a7c36759a0ccf7b7a6b409cce09b2b22497.png)" :tutorial/id #uuid "6cd38c68-76bd-504d-9df9-754982a28e7b" :tutorial/math-academy-id 8898 :tutorial/title "Introduction"} :step/id #uuid "d4aef397-7640-5bbe-b8aa-810faa204997" :step/math-academy-id 192118 :step/next {:db/id #edb/ref 17592186176636}} {:db/id #edb/ref 17592186176636 :step/content {:db/id #edb/ref 17592186175922 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175735 :question/id #uuid "ca9ba6cf-860f-5868-b91f-1dff84406f22" :question/math-academy-id "e-14357"} :knowledge-point/id #uuid "ae4289af-e251-514c-981e-5c6d21992ad3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048357} {:db/id #edb/ref 17592186050635}] :knowledge-point/questions [{:db/id #edb/ref 17592186176416} {:db/id #edb/ref 17592186176491} {:db/id #edb/ref 17592186290494} {:db/id #edb/ref 17592186290496} {:db/id #edb/ref 17592186290497} {:db/id #edb/ref 17592186329753} {:db/id #edb/ref 17592186329757}] :knowledge-point/title "Finding the Equation of a Perpendicular Line"} :step/id #uuid "2ec449a2-61ef-5a93-9b47-c003c1e9d16a" :step/math-academy-id 192119 :step/next {:db/id #edb/ref 17592186176637}} {:db/id #edb/ref 17592186176637 :step/content {:db/id #edb/ref 17592186175923 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175737 :question/id #uuid "ca9ec8da-5f74-53dc-afa7-e6cc965fcc95" :question/math-academy-id "e-14363"} :knowledge-point/id #uuid "44b9b212-27c4-5d6d-a221-cd85c25fc956" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049061}] :knowledge-point/question-generator {:db/id #edb/ref 17592186490397} :knowledge-point/questions [{:db/id #edb/ref 17592186176418} {:db/id #edb/ref 17592186176429} {:db/id #edb/ref 17592186235495} {:db/id #edb/ref 17592186238007} {:db/id #edb/ref 17592186238010} {:db/id #edb/ref 17592186290316} {:db/id #edb/ref 17592186290460} {:db/id #edb/ref 17592186290495} {:db/id #edb/ref 17592186290498} {:db/id #edb/ref 17592186290499} {:db/id #edb/ref 17592186339134} {:db/id #edb/ref 17592186341834} {:db/id #edb/ref 17592186490396} {:db/id #edb/ref 17592186524010} {:db/id #edb/ref 17592186525046}] :knowledge-point/title "Finding the Equation of a Line Perpendicular to a Line Through Two Points"} :step/id #uuid "964f0117-372f-5362-ae3b-b45651947dbe" :step/math-academy-id 192123 :step/next {:db/id #edb/ref 17592186176638}} {:db/id #edb/ref 17592186176638 :step/content {:db/id #edb/ref 17592186175924 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175741 :question/id #uuid "49cee7e9-29a5-5e1e-bc13-7dbabaaea405" :question/math-academy-id "e-14730"} :knowledge-point/id #uuid "c52fd5dd-780e-5dab-805f-561383873dd4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049201}] :knowledge-point/question-generator {:db/id #edb/ref 17592186481563} :knowledge-point/questions [{:db/id #edb/ref 17592186176417} {:db/id #edb/ref 17592186176432} {:db/id #edb/ref 17592186238009} {:db/id #edb/ref 17592186290470} {:db/id #edb/ref 17592186290500} {:db/id #edb/ref 17592186290501} {:db/id #edb/ref 17592186290502} {:db/id #edb/ref 17592186292541} {:db/id #edb/ref 17592186341836} {:db/id #edb/ref 17592186481551} {:db/id #edb/ref 17592186481556} {:db/id #edb/ref 17592186481560}] :knowledge-point/title "Finding the Equation of a Line Perpendicular to a Line in Standard Form"} :step/id #uuid "54ebaf71-e1f2-548d-a8b8-baebf7d035a6" :step/math-academy-id 192126}] :activity/title "Finding Equations of Perpendicular Lines" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186176113}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186525078} :activity/id #uuid "dce5a6b1-8e80-58c8-af08-9ef023487bbb" :activity/scope {:db/id #edb/ref 17592186050473 :topic/id #uuid "4c6d2580-78c9-5782-9c3a-465dcd055b32" :topic/math-academy-id 3562} :activity/steps [{:db/id #edb/ref 17592186525078 :step/content {:db/id #edb/ref 17592186238009 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08fb0cd4-c595-52e2-b7b8-f5921f1664ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x+y=-4" :db/id #edb/ref 17592186235858} {:answer/id #uuid "339a3f8d-ec60-53c0-b70c-2ad1dcb8beef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-2y=-10" :db/id #edb/ref 17592186236143} {:answer/id #uuid "bf918fbb-8ce0-57e4-ba33-761c02c1700f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+2y=2" :db/id #edb/ref 17592186237036} {:answer/id #uuid "cd49d0d7-034b-5674-9bb1-76d06ca38e03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-2y=-6" :db/id #edb/ref 17592186237119} {:answer/id #uuid "f90a028f-fc8e-54be-b155-96319e83f2b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x+2y=-2" :db/id #edb/ref 17592186237390}] :answer-field/correct {:db/id #edb/ref 17592186237390} :answer-field/id #uuid "be8d6f01-6ff4-56d4-9645-4daf3987bc75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237683}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5c2cb582-f805-50f4-ae14-8678782b90fa" :question/math-academy-id "q-103449" :question/problem "Find the equation of the line that passes through the point $(-2,2)$ and is perpendicular to the line passing through the points $(1,-1)$ and $(4,1).$" :question/worked-solution "Perpendicular lines have slopes which are negative reciprocals of each other.\n\nFirst, let's find the slope ${m}_{1}$ of the line passing through the points $(1,-1)$ and $(4,1):$\n\n$$\n\\begin{aligned}{m}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{1-(-1)}{4-1} \\\\  & =\\frac{1+1}{4-1} \\\\  & =\\frac{2}{3}\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm\\cdot (\\frac{2}{3})=-1\\,⇒\\,m=-\\frac{3}{2}.\n$$\n\nWe know that the line passes through the point $(-2,2).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-2 & =-\\frac{3}{2}(x-(-2)) \\\\ y-2 & =-\\frac{3}{2}(x+2) \\\\ y-2 & =-\\frac{3}{2}x-3 \\\\ y & =-\\frac{3}{2}x-1\\end{aligned}\n$$\n\nHowever, we want to write the equation in standard form. So, we will bring the $x$ term to the left-hand side and multiply both sides of the equation by $2:$\n\n$$\n\\begin{aligned}y & =-\\frac{3}{2}x-1 \\\\ \\frac{3}{2}x+y & =-1 \\\\ 2\\cdot (\\frac{3}{2}x+y) & =2\\cdot (-1) \\\\ 3x+2y & =-2\\end{aligned}\n$$"} :step/id #uuid "1eab4d5a-96a8-544b-91f1-6e63e881567a" :step/next {:db/id #edb/ref 17592186525114}} {:db/id #edb/ref 17592186525114 :step/content {:db/id #edb/ref 17592186176417 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ccac27b1-4d1c-5479-8665-d033a45d1913" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-8" :db/id #edb/ref 17592186524721}] :answer-field/correct {:db/id #edb/ref 17592186524721} :answer-field/id #uuid "c97302ea-f8e7-5c70-95e0-5cc0b820ce24" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186174740}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a0a733e1-bbed-5414-830d-e413ae5ce0e3" :question/math-academy-id "q-214033" :question/problem "What is the equation of the line that passes through the point $(1,-5)$ and is perpendicular to $x+3y=12?$\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we write the equation $x+3y=12$ in its slope-intercept form, as follows:\n\n$$\n\\begin{aligned}x+3y & =12 \\\\ 3y & =-x+12 \\\\ y & =-\\frac{1}{3}x+4\\end{aligned}\n$$\n\nSince perpendicular lines have slopes that are negative reciprocals of each other, the slope of the new line should be the negative reciprocal of the slope of the given line $y=-\\frac{1}{3}x+4.$ The given line has a slope of $-\\frac{1}{3},$ so our perpendicular line must have a slope of $3.$\n\nOur perpendicular line must have the slope $m=3$ and pass through the point $({x}_{1},{y}_{1})=(1,-5).$ Using point-slope form and simplifying, we obtain the equation of the line in slope-intercept form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-5) & =3(x-1) \\\\ y+5 & =3x-3 \\\\ y & =3x-8\\end{aligned}\n$$"} :step/id #uuid "91ab80b6-9654-58b5-aeba-94ac364e8346" :step/next {:db/id #edb/ref 17592186525147}} {:db/id #edb/ref 17592186525147 :step/content {:db/id #edb/ref 17592186525046 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cba90753-0239-53f3-8288-4708dc4bd2d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6x+23" :db/id #edb/ref 17592186524719}] :answer-field/correct {:db/id #edb/ref 17592186524719} :answer-field/id #uuid "618796c9-d723-5e11-9f71-2d4878c12e36" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186524880}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d79473d6-bc2e-50df-aa4f-f2c7866c75c4" :question/math-academy-id "q-237034" :question/problem "Find the equation of the line that passes through the point $(4,-1)$ and is perpendicular to the line passing through the points $(2,3)$ and $(-4,2).$\n\n$y=$\n{{field-1}}" :question/worked-solution "Perpendicular lines have slopes that are negative reciprocals of each other.\n\nFirst, let's find the slope ${m}_{1}$ of the line passing through the points $(2,3)$ and $(-4,2):$\n\n$$\n\\begin{aligned}{m}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{2-3}{-4-2} \\\\  & =\\frac{(-1)}{(-6)} \\\\  & =\\frac{1}{6}\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm\\cdot (\\frac{1}{6})=-1\\,⇒\\,m=-6.\n$$\n\nWe know that the line passes through the point $(4,-1).$ Using point-slope form and simplifying, we obtain the equation of the line in slope-intercept form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-1) & =-6(x-4) \\\\ y+1 & =-6x+24 \\\\ y & =-6x+23\\end{aligned}\n$$"} :step/id #uuid "f8031d83-20ce-5562-9e78-310af75e7f3b"}] :activity/title "Finding Equations of Perpendicular Lines" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186524373}]}
