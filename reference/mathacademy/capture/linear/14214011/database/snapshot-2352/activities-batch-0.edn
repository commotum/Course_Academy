#{[{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186176635} :activity/id #uuid "a22648a9-1107-5fad-945a-32867ab1ed64" :activity/scope {:db/id #edb/ref 17592186050473 :topic/id #uuid "4c6d2580-78c9-5782-9c3a-465dcd055b32" :topic/math-academy-id 3562} :activity/steps [{:db/id #edb/ref 17592186176635 :step/content {:db/id #edb/ref 17592186177095 :tutorial/content "To find the slope of a line that is perpendicular to a given line $y=mx+b,$ we can just take the **negative reciprocal** of the given slope $m.$ So, the slope of the perpendicular line would be $-\\dfrac{1}{m}.$\n\nFor example, consider the line $y = 3x + 1,$ which has a slope of $m=3.$ The negative reciprocal of $3$ is $-\\dfrac{1}{3}.$ So, any line with a slope of $-\\dfrac{1}{3}$ will be perpendicular to the given line, because\n\n$$\n3 \\cdot \\left( -\\dfrac{1}{3} \\right) = -1.\n$$\n\nTo illustrate, some lines with a slope of $-\\dfrac{1}{3}$ are plotted below. We can see that they are all perpendicular to the given line $y=3x+1.$\n\n![](images/e2/e2772aa0cbe3e736e1129b52c59d3a7c36759a0ccf7b7a6b409cce09b2b22497.png)" :tutorial/id #uuid "6cd38c68-76bd-504d-9df9-754982a28e7b" :tutorial/math-academy-id 8898 :tutorial/title "Introduction"} :step/id #uuid "d4aef397-7640-5bbe-b8aa-810faa204997" :step/math-academy-id 192118 :step/next {:db/id #edb/ref 17592186176636}} {:db/id #edb/ref 17592186176636 :step/content {:db/id #edb/ref 17592186175922 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175735 :question/id #uuid "ca9ba6cf-860f-5868-b91f-1dff84406f22" :question/math-academy-id "e-14357"} :knowledge-point/id #uuid "ae4289af-e251-514c-981e-5c6d21992ad3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048357} {:db/id #edb/ref 17592186050635}] :knowledge-point/questions [{:db/id #edb/ref 17592186176416} {:db/id #edb/ref 17592186176491} {:db/id #edb/ref 17592186290494} {:db/id #edb/ref 17592186290496} {:db/id #edb/ref 17592186290497} {:db/id #edb/ref 17592