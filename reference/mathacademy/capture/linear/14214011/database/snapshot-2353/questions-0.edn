#{[{:db/id #edb/ref 17592186238009 :knowledge-point/_questions [{:db/id #edb/ref 17592186175924 :knowledge-point/id #uuid "c52fd5dd-780e-5dab-805f-561383873dd4" :knowledge-point/title "Finding the Equation of a Line Perpendicular to a Line in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08fb0cd4-c595-52e2-b7b8-f5921f1664ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+y=-4" :db/id #edb/ref 17592186235858} {:answer/id #uuid "339a3f8d-ec60-53c0-b70c-2ad1dcb8beef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-2y=-10" :db/id #edb/ref 17592186236143} {:answer/id #uuid "bf918fbb-8ce0-57e4-ba33-761c02c1700f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2y=2" :db/id #edb/ref 17592186237036} {:answer/id #uuid "cd49d0d7-034b-5674-9bb1-76d06ca38e03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-2y=-6" :db/id #edb/ref 17592186237119} {:answer/id #uuid "f90a028f-fc8e-54be-b155-96319e83f2b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+2y=-2" :db/id #edb/ref 17592186237390}] :answer-field/correct {:answer/id #uuid "f90a028f-fc8e-54be-b155-96319e83f2b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+2y=-2" :db/id #edb/ref 17592186237390} :answer-field/id #uuid "be8d6f01-6ff4-56d4-9645-4daf3987bc75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237683}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5c2cb582-f805-50f4-ae14-8678782b90fa" :question/math-academy-id "q-103449" :question/problem "Find the equation of the line that passes through the point $(-2,2)$ and is perpendicular to the line passing through the points $(1,-1)$ and $(4,1).$" :question/worked-solution "Perpendicular lines have slopes which are negative reciprocals of each other.\n\nFirst, let's find the slope ${m}_{1}$ of the line passing through the points $(1,-1)$ and $(4,1):$\n\n$$\n\\begin{aligned}{m}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{1-(-1)}{4-1} \\\\  & =\\frac{1+1}{4-1} \\\\  & =\\frac{2}{3}\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm\\cdot (\\frac{2}{3})=-1\\,⇒\\,m=-\\frac{3}{2}.\n$$\n\nWe know that the line passes through the point $(-2,2).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-2 & =-\\frac{3}{2}(x-(-2)) \\\\ y-2 & =-\\frac{3}{2}(x+2) \\\\ y-2 & =-\\frac{3}{2}x-3 \\\\ y & =-\\frac{3}{2}x-1\\end{aligned}\n$$\n\nHowever, we want to write the equation in standard form. So, we will bring the $x$ term to the left-hand side and multiply both sides of the equation by $2:$\n\n$$\n\\begin{aligned}y & =-\\frac{3}{2}x-1 \\\\ \\frac{3}{2}x+y & =-1 \\\\ 2\\cdot (\\frac{3}{2}x+y) & =2\\cdot (-1) \\\\ 3x+2y & =-2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186176417 :knowledge-point/_questions [{:db/id #edb/ref 17592186175924 :knowledge-point/id #uuid "c52fd5dd-780e-5dab-805f-561383873dd4" :knowledge-point/title "Finding the Equation of a Line Perpendicular to a Line in Standard Form"}] :question/answer-fields [{:answer-field/id #uuid "c97302ea-f8e7-5c70-95e0-5cc0b820ce24" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186174740}] :question/id #uuid "a0a733e1-bbed-5414-830d-e413ae5ce0e3" :question/math-academy-id "q-214033" :question/problem "What is the equation of the line that passes through the point $(1,-5)$ and is perpendicular to $x + 3y = 12$?$y =$\n{{field-1}}"}]}
