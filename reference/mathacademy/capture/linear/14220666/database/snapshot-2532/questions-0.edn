#{[{:db/id #edb/ref 17592186128970 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186129152 :knowledge-point/id #uuid "2d61f93a-1acd-584c-a901-458b3cb1921e" :knowledge-point/title "Identifying Properties of the Square Root Function"}] :question/id #uuid "6b031a4c-79e9-51a7-92a9-8bfde77cca3d" :question/math-academy-id "e-5868" :question/problem "Which of the following statements are true regarding the function $f(x) =\\sqrt{x}?$\n\nI. $f(x)$ is always positive.\n\nII. The range of $f(x)$ is $(-\\infty,0)\\cup (0,\\infty).$\n\nIII. $f(x) \\rightarrow \\infty$ as $x \\rightarrow \\infty$" :question/worked-solution "Let's start by recalling the graph of $y=\\sqrt x.$\n\n![](images/f8/f8825f71f4d3565b28198b3a4de5424693adfead87a509f38ffecfbccb9fcd01.png)\n\nNow, let's examine each statement in turn.\n\n- Statement I is false since $f(0)=0 \\not\\gt 0.$\n\n- Statement II is false since the range of $f(x)$ is $[0,\\infty).$\n\n- Statement III is true. Indeed, $f(x) \\rightarrow \\infty$ as $x \\rightarrow \\infty.$"}] [{:db/id #edb/ref 17592186128971 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186129153 :knowledge-point/id #uuid "359b7012-75e5-5ffc-8722-9292d3f8241a" :knowledge-point/title "Identifying the Graph of the Square Root Function"}] :question/id #uuid "1d895d45-a722-57fd-b429-616cf944a9c2" :question/math-academy-id "e-5869" :question/problem "Which of the following could be the graph of $y = \\sqrt{x}$?\n\n![](images/76/7646aec895e67700f9ddaaa52dabb4d01edb12165add5fbc1a5b464df1a26e52.png)" :question/worked-solution "Let's recall some of the basic properties of $y=\\sqrt x{:}$\n\n- The point $(0,0)$ lies on the graph.\n\n- Its domain is $x\\in [0,\\infty).$\n\n- Its range is $y\\in [0,\\infty).$\n\n- The function is increasing over its entire domain.\n\n- As $x \\rightarrow \\infty,$ we have $y\\rightarrow \\infty,$ though the function increases more slowly as $x$ gets large.\n\nOf the given options, only graph II has all of the above properties.\n\nTherefore, the correct answer is only II."}] [{:db/id #edb/ref 17592186532654 :knowledge-point/_questions [{:db/id #edb/ref 17592186129153 :knowledge-point/id #uuid "359b7012-75e5-5ffc-8722-9292d3f8241a" :knowledge-point/title "Identifying the Graph of the Square Root Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16aabd13-9f25-55f2-94cd-eef26792b4a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the given functions is the graph of $y=\\sqrt{x}$" :db/id #edb/ref 17592186531977} {:answer/id #uuid "56286bb0-3805-550e-a429-f2ebc31c912b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV only" :db/id #edb/ref 17592186532122} {:answer/id #uuid "942918c4-468b-5f0b-abfa-42482f89f311" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186532270} {:answer/id #uuid "e3700dee-e94d-5006-be1c-e817b9ecee24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186532418} {:answer/id #uuid "f117c591-83e0-575b-b3d6-0ba013f899e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186532454}] :answer-field/correct {:answer/id #uuid "f117c591-83e0-575b-b3d6-0ba013f899e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186532454} :answer-field/id #uuid "c3500379-6a8e-53c3-8126-dfaf0c74ce0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186532586}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4f653225-d77d-586c-90af-460ddba800f1" :question/math-academy-id "q-103612" :question/problem "![](images/5d/5d88a8e80d3008450a3e807750ee0f02c9b733eca5407d7dda416ce43303ba18.png)\n\nWhich of the above could be the graph of $y=\\sqrt{x}?$" :question/worked-solution "Let's recall some of the basic properties of $y=\\sqrt{x}.$\n\n- The point $(0,0)$ lies on the graph\n\n- Its domain is $x\\in [0,\\infty )$\n\n- Its range is $y\\in [0,\\infty )$\n\n- The function is increasing over its entire domain.\n\n- As $x\\to \\infty $, we have $y\\to \\infty ,$ though it does so slowly\n\nOf the given options, only graph III has all of the above properties. Therefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186532635 :knowledge-point/_questions [{:db/id #edb/ref 17592186129153 :knowledge-point/id #uuid "359b7012-75e5-5ffc-8722-9292d3f8241a" :knowledge-point/title "Identifying the Graph of the Square Root Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07e8a5c2-6928-5951-89ad-12fdcaaff1e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the given functions is the graph of $y=\\sqrt{x}$" :db/id #edb/ref 17592186531951} {:answer/id #uuid "61965896-9ca7-566e-8b10-7912fe172307" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186532150} {:answer/id #uuid "a3797683-6e07-5f6f-a326-b1bf5d221fbc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV only" :db/id #edb/ref 17592186532301} {:answer/id #uuid "f31c787c-aac9-5106-af87-d156f8c85354" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186532459} {:answer/id #uuid "fc790b2c-493c-59f5-9ba7-680583e7f01d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186532486}] :answer-field/correct {:answer/id #uuid "07e8a5c2-6928-5951-89ad-12fdcaaff1e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the given functions is the graph of $y=\\sqrt{x}$" :db/id #edb/ref 17592186531951} :answer-field/id #uuid "6f7b6939-8c77-5f6f-9a80-02e48e4bab3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186532545}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2ac1ab3d-25c7-532c-bff1-4864fc864532" :question/math-academy-id "q-103617" :question/problem "![](images/00/00b1f319a2ac35014f0db9fc37d03069328752bc6f2f5b8369e7f8cac6bb23d0.png)\n\nWhich of the above could be the graph of $y=\\sqrt{x}?$" :question/worked-solution "Let's recall some of the basic properties of $y=\\sqrt{x}.$\n\n- The point $(0,0)$ lies on the graph\n\n- Its domain is $x\\in [0,\\infty )$\n\n- Its range is $y\\in [0,\\infty )$\n\n- The function is increasing over its entire domain.\n\n- As $x\\to \\infty $, we have $y\\to \\infty ,$ though it does so slowly\n\nNone of the given options have all of the above properties. Therefore, none of the given functions is the graph of $y=\\sqrt{x}.$"}] [{:db/id #edb/ref 17592186129747 :knowledge-point/_questions [{:db/id #edb/ref 17592186129152 :knowledge-point/id #uuid "2d61f93a-1acd-584c-a901-458b3cb1921e" :knowledge-point/title "Identifying Properties of the Square Root Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9c0ccb8-a278-5328-b645-62a7a48db0aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186127964} {:answer/id #uuid "10071b0c-c795-5fa0-9e7b-993b2f409d79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186127965} {:answer/id #uuid "1ed336eb-ccb3-52b9-932b-90fcd546d0b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186127966} {:answer/id #uuid "3a2cf1e6-30cb-5eba-96f8-e11d18a981a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186127967} {:answer/id #uuid "5e1df19b-a443-5566-9480-6184a9898630" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186127968}] :answer-field/correct {:answer/id #uuid "a9c0ccb8-a278-5328-b645-62a7a48db0aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186127964} :answer-field/id #uuid "e5d6c25b-5295-596d-8a00-48978721711b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186127963}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ed8fdb90-e5e8-5fdc-b4ca-aa9bb4f0a24a" :question/math-academy-id "q-39552" :question/problem "Which of the following statements are true regarding the function $f(x)=\\sqrt{x}?$\n\nI. The point $(1,2)$ lies on the graph of $y=f(x)$\n\nII. The domain of $f(x)$ is $x\\in [0,\\infty )$\n\nIII. The graph of $f(x)$ lies in the second quadrant" :question/worked-solution "Let's start by recalling the graph of $y=\\sqrt{x}.$\n\n![](images/f8/f8825f71f4d3565b28198b3a4de5424693adfead87a509f38ffecfbccb9fcd01.png)\n\nNow, let's examine each statement in turn.\n\n- Statement I is false since $f(1)=\\sqrt{1}=1\\ne 2.$\n\n- Statement II is true. Indeed, $f(x)=\\sqrt{x}$ is defined for $x\\in [0,\\infty ).$\n\n- Statement III is false since the graph of $f(x)$ lies in the first quadrant.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186532637 :knowledge-point/_questions [{:db/id #edb/ref 17592186129152 :knowledge-point/id #uuid "2d61f93a-1acd-584c-a901-458b3cb1921e" :knowledge-point/title "Identifying Properties of the Square Root Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e3d87a2-8760-5f0f-916c-e4a3f5cb6b20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186532102} {:answer/id #uuid "63ddf929-b194-573f-a0a6-4e5769f96516" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186532154} {:answer/id #uuid "7a70cbd2-63c4-5c03-a2d4-de215207d4ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186532205} {:answer/id #uuid "902f594a-181d-520f-a1f9-bd315d9947b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186532261} {:answer/id #uuid "beffdb55-5558-5125-8a6c-7a5b7f6df530" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186532343}] :answer-field/correct {:answer/id #uuid "beffdb55-5558-5125-8a6c-7a5b7f6df530" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186532343} :answer-field/id #uuid "9ddc9a67-b8a9-5f6a-95f8-025303a9f3ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186532567}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3728e5e1-e988-5755-b263-7b61d69b65af" :question/math-academy-id "q-89863" :question/problem "Which of the following statements are true regarding the function $f(x)=\\sqrt{x}?$\n\nI. The point $(0,0)$ lies on the graph of $y=f(x)$\n\nII. The domain of $f(x)$ is $x\\in (-\\infty ,\\infty )$\n\nIII. The graph of $f(x)$ lies in the fourth quadrant" :question/worked-solution "Let's start by recalling the graph of $y=\\sqrt{x}.$\n\n![](images/6d/6dc32799c53b03cb53d692054cc44910d252367ebf102c53472d4e4d2fe78684.png)\n\nNow, let's examine each statement in turn.\n\n- Statement I is true. Indeed, $f(0)=\\sqrt{0}=0.$\n\n- Statement II is false since $f(x)=\\sqrt{x}$ is defined for $x\\in [0,\\infty ).$\n\n- Statement III is false, since the graph of $f(x)$ lies in the first quadrant.\n\nTherefore, the correct answer is \"I only.\""}]}
