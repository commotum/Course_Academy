db/ident :answer.type/text} :answer/value "The net of III consists of $3$ triangles and $1$ rectangle" :db/id #edb/ref 17592186565684} {:answer/id #uuid "0846f24f-af1c-550d-846b-c843285d05d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The net of I consists of $3$ triangles and $3$ rectangles" :db/id #edb/ref 17592186565691} {:answer/id #uuid "17a62515-2813-570a-b292-f8afb7187b49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The net of III consists of triangles only" :db/id #edb/ref 17592186565719} {:answer/id #uuid "5b4cd130-6656-5a33-82ce-e42176017efc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The net of II consists of $3$ triangles and $1$ rectangle" :db/id #edb/ref 17592186565827} {:answer/id #uuid "8f54a780-f831-5e78-92bd-ab9e1d509ecc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The net of II consists of triangles only" :db/id #edb/ref 17592186565906}] :answer-field/correct {:answer/id #uuid "8f54a780-f831-5e78-92bd-ab9e1d509ecc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The net of II consists of triangles only" :db/id #edb/ref 17592186565906} :answer-field/id #uuid "86416a88-fdc4-572d-9486-d8ebc941a794" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186566161}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "776cd40d-1c79-55ee-9771-1ee0329ddc24" :question/math-academy-id "q-61779" :question/problem "![](images/56/5683cb4560a5715654c795d94f4123c79a758e281ef40b92cccb379482506c2c.png)\n\nWhich of the statements is true about the solids depicted above?" :question/worked-solution "Let's sketch the nets of each solid.\n\n![](images/27/277d5aa8a8116d230bf000ef7d8e94a071acbf499a49b9d8b911a4e89cfaf18a.png)\n\n \n\nAs we can see, the correct answer is:\n\n$\\,$ *\"The net of II consists of triangles only\"*\n\nOther statements are false. \n\n- *\"The net of III consists of triangles only\"* is false since the net of III has one rectangle (the base of the solid).\n\n- *\"The net of I consists of $3$ triangles and $3$ rectangles\"* is not true because the net of I contains only $2$ triangles (the base and the top of the solid).\n\n- *\"The net of III consists of $3$ triangles and $1$ rectangle\"* is false since the net of III has $4$ triangles (the side faces).\n\n- *\"The net of II consists of $3$ triangles and $1$ rectangle\"* is not true because the net of II does not contain rectangles."}] [{:db/id #edb/ref 17592186147920 :knowledge-point/_questions [{:db/id #edb/ref 17592186147619 :knowledge-point/id #uuid "8fe3ef90-285d-5dfa-b540-1a6c6826ecbe" :knowledge-point/title "Identifying the Net of a Polyhedron"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf21374c-be77-5833-b079-b33b9eae0c0a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e2/e2fdedf34ea61cf9542ebaa5c4b7bbff8ae648c3e5e4ec2a645d045469a1e1a8.png" :db/id #edb/ref 17592186145275} {:answer/id #uuid "27515621-d84d-5ea0-add3-f2c61da51deb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/74/74d7dda34e809c6833cce4ab5b234b6a2f135bcab84175ba0ec0a80520d4ae59.png" :db/id #edb/ref 17592186145276} {:answer/id #uuid "2e80c0c8-ff46-55ab-8692-69d4eaa7ba90" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d6/d6510353162c42e6609479f21719e54a67094d7acaff4295d3bf8bd772859441.png" :db/id #edb/ref 17592186145277} {:answer/id #uuid "2fa3f056-aa8c-5a4b-b366-1bf5bec00904" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c6/c603092d3d64352abf3746123afd04c58be06c56d917c6e53123fab8ea4d1d17.png" :db/id #edb