estions [{:db/id #edb/ref 17592186147921} {:db/id #edb/ref 17592186147937} {:db/id #edb/ref 17592186566253} {:db/id #edb/ref 17592186566275}] :knowledge-point/title "Identifying Nets That Do Not Correspond to a Particular Polyhedron"} :step/id #uuid "9d7fe619-6a02-57fa-a2e3-c200bd9025a2" :step/math-academy-id 9283 :step/next {:db/id #edb/ref 17592186148602}} {:db/id #edb/ref 17592186148602 :step/content {:db/id #edb/ref 17592186147621 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147303 :question/id #uuid "1b29a574-ac81-53cf-8dd7-3030e1f9bef3" :question/math-academy-id "e-2773"} :knowledge-point/id #uuid "21ee2869-b51d-5bb3-82dc-7c8d48f229b7" :knowledge-point/questions [{:db/id #edb/ref 17592186147930} {:db/id #edb/ref 17592186147931} {:db/id #edb/ref 17592186566247}] :knowledge-point/title "Identifying True Statements Given Some Polyhedra Nets"} :step/id #uuid "dcf088a9-eb92-5351-972f-238a435f0a9d" :step/math-academy-id 9289} {:db/id #edb/ref 17592186148631 :step/content {:db/id #edb/ref 17592186148725 :tutorial/content "We can represent $3$-dimensional shapes in $2$-dimensions using **nets**.\nTo make a polyhedron net, we take its faces and lay them out as if they were lying flat and open.\n\nBelow, we have the net of a polyhedron, but which one?\n\n![](images/a9/a9484094d29f4f74d383d7f669d71be291f7cf9906ed59a377dea71c95f7be66.png)\n\nWe can get back the original polyhedron by folding the net along its edges to form a solid shape. The way we fold the net is shown below:\n\n![](images/67/6797f9f6e1203167e4ebaaec0179c6309ac2fe2f908ef8ec36a5866e2890b974.png)\n\nAs a result, we get a cube:\n\n![](images/df/dfaec291ab1abf049146d58975c22461df721c82739ab672f47f91a47a19a9eb.png)" :tutorial/id #uuid "d764b3fc-d40c-537b-b042-70913f5f0beb" :tutorial/math-academy-id 2279 :tutorial/title "Introduction"} :step/id #uuid "d677461b-4e95-5621-a7e7-f7ac3bc2f9a4" :step/math-academy-id 9505 :step/next {:db/id #edb/ref 17592186148597}}] :activity/title "Nets of Polyhedrons" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186147668}]}
