a8c-5a4b-b366-1bf5bec00904" #edb/ref 17592186045417] [17592186145279 #edb/ref 1080 "images/3c/3c435d5a4c009a5fd21ace2b4490e3c03b4917b939c3359de7887183f9ec6826.png" #edb/ref 17592186045417] [17592186145279 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186145279 #edb/ref 1083 #uuid "62a41259-4d8b-5b78-a6d2-dfd5120634c8" #edb/ref 17592186045417] [17592186145334 #edb/ref 1075 #edb/ref 17592186145335 #edb/ref 17592186045417] [17592186145334 #edb/ref 1075 #edb/ref 17592186145336 #edb/ref 17592186045417] [17592186145334 #edb/ref 1075 #edb/ref 17592186145337 #edb/ref 17592186045417] [17592186145334 #edb/ref 1075 #edb/ref 17592186145338 #edb/ref 17592186045417] [17592186145334 #edb/ref 1075 #edb/ref 17592186145339 #edb/ref 17592186045417] [17592186145334 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186145334 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186145334 #edb/ref 1078 #edb/ref 17592186145336 #edb/ref 17592186045417] [17592186145334 #edb/ref 1079 #uuid "f2aa6e5e-3ae3-581f-b215-9e0c97daafb7" #edb/ref 17592186045417] [17592186145335 #edb/ref 1080 "The net of I has one triangle" #edb/ref 17592186045417] [17592186145335 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186145335 #edb/ref 1083 #uuid "148d3330-6d52-5631-907b-fb5df88fab5c" #edb/ref 17592186045417] [17592186145336 #edb/ref 1080 "The net of III consists of $1$ rectangle and $4$ triangles" #edb/ref 17592186045417] [17592186145336 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186145336 #edb/ref 1083 #uuid "2e11605e-4783-57fc-9634-274375ee0f6d" #edb/ref 17592186045417] [17592186145337 #edb/ref 1080 "The net of I consists of exactly $8$ squares" #edb/ref 17592186045417] [17592186145337 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186145337 #edb/ref 1083 #uuid "34b41d98-02a9-50af-b7b9-0af8b6e916d5" #edb/ref 17592186045417] [17592186145338 #edb/ref 1080 "The net of II consists of triangles only" #edb/ref 17592186045417] [17592186145338 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186145338 #edb/ref 1083 #uuid "59a72f6c-00a9-5e57-893e-f1d95b81d935" #edb/ref 17592186045417] [17592186145339 #edb/ref 1080 "The net of III consists of $4$ triangles and $2$ rectangles" #edb/ref 17592186045417] [17592186145339 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186145339 #edb/ref 1083 #uuid "6a9efeff-e4a2-58d6-9979-631509c2e7b8" #edb/ref 17592186045417] [17592186147295 #edb/ref 1069 "e-2759" #edb/ref 17592186045417] [17592186147295 #edb/ref 1071 "The net of which polyhedron is shown below?\n\n![](images/96/96e7889a74d2d5bd35634ec022d3c9020d23fd7292b3bd7c05f8722860389645.png)" #edb/ref 17592186045417] [17592186147295 #edb/ref 1072 #uuid "8bca178c-5495-5205-b213-c75b8a4df3de" #edb/ref 17592186045417] [17592186147295 #edb/ref 1074 "We fold the net along its edges to form a solid shape, as shown below.\n\n![](images/98/98ee3216b37bdce0081dd4daad1895cace7998a03d41c183184d07f6afaac126.png)\n\nAs a result, we get a triangular pyramid:\n\n![](images/32/32bdc8f811ca46a184307fa5521cb145cb0add8a0b4ee2bfae25add881561475.png)" #edb/ref 17592186045417] [17592186147297 #edb/ref 1069 "e-2761" #edb/ref 17592186045417] [17592186147297 #edb/ref 1071 "![](images/f2/f233556f9055563f3956eea7eaf9744fb20993084f4c3eeb5e2e35d730d8d2aa.png)\n\n \n\nWhich of the nets above is the net of a rectangular prism?" #edb/ref 17592186045417] [17592186147297 #edb/ref 1072 #uuid "4501bf84-de3a-581f-b717-10996a285921" #edb/ref 17592186045417] [17592186147297 #edb/ref 1074 "![](images/5f/5fc1630e4e44bf68f833004ab975e406b8734fe062849484165310e093d14155.png)\n\n \n\nIf we were to fold the net above along its edges, then we'd get a rectangular prism, as shown below: \n\n![](images/c2/c2f6985ca8cd95a71409936ede80c6f257e863bd459fe5a27178a04ea3edb88c.png)\n\n  \n\nNotice that the other two nets have triangular faces, so they cannot be the nets of a rectangular prism. \n\nTherefore, the correct answer is I." #edb/ref 17592186045417] [17592186147300 #edb/ref 1069 "e-2766" #edb/ref 17592186045417] [17592186147300 #edb/ref 1071 "![](images/84/84f39f9d765a61db544fdddc7ee79859ab4a54c2e6f0e5018512723ca0dfcfd9.png)\n\n \n\nWhich of the nets above is **not** the net of a pyramid?" #edb/ref 17592186045417] [17592186147300 #edb/ref 1072 #uuid "1e23f3ac-bcec-5070-b135-b2285d326bc4" #edb/ref 17592186045417] [17592186147300 #edb/ref 1074 "![](images/72/72462d252e84e20d567ccd10c2be12a6496f442f08d6e6baa609c5fb74f6fcc5.png)\n\n     \n\nIf we were to fold the net above along its edges, then we'd get a triangular prism, as shown below: \n\n![](images/8e/8e77623f767c9cea456b787a09465397a4360915c547911a55927d8f7c9b4885.png)\n\n \n\nNotice that the other two nets give us pyramids. Therefore,  the correct answer is I." #edb/ref 17592186045417] [17592186147303 #edb/ref 1069 "e-2773" #edb/ref 17592186045417] [17592186147303 #edb/ref 1071 "![](images/e4/e427a98c2953792d799190b7fc20a7dbf12ce014655316e21fb809e0abc9cdc5.png)\n\nWhich of the statements is true about the solids shown above?\n\nI. The net of solid I consists of triangles only.\n\nII. The net of solid II consists of $4$ triangles and $2$ rectangles.\n\nIII. The net of solid III consists of triangles only." #edb/ref 17592186045417] [17592186147303 #edb/ref 1072 #uuid "1b29a574-ac81-53cf-8dd7-3030e1f9bef3" #edb/ref 17592186045417] [17592186147303 #edb/ref 1074 "Let's sketch the net of each solid.\n\n![](images/02/023f11b6924e6cf7318f54f5acdf910b1f688ee8ac40ec8f3b3ab7cd9c13c8df.png)\n\n \n\nNow, let's go through the statements one by one.\n\n- Statement I is false because the net of solid I consists of rectangles.\n\n- Statement II is false because the net of solid II consists of $2$ triangles and $3$ rectangles.\n\n- Statement III is true.\n\nTherefore, the correct answer is \"III only.\"" #edb/ref 17592186045417] [17592186147616 #edb/ref 1037 #edb/ref 17592186048313 #edb/ref 17592186045417] [175