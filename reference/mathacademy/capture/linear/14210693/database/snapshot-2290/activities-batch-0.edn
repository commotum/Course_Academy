#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186084113} :activity/id #uuid "a7f69bc4-d282-5858-b60f-7ff64c7183a4" :activity/scope {:db/id #edb/ref 17592186050268 :topic/id #uuid "3b17848f-b951-5bb1-9d98-97165056391a" :topic/math-academy-id 775} :activity/steps [{:db/id #edb/ref 17592186084113 :step/content {:db/id #edb/ref 17592186084446 :tutorial/content "Given a collection of $n$ objects, there are $n!$ ways to arrange those objects in a sequence.\n\n- For example, suppose we have $n=2$ objects: $A$ and $B.$ Then there are $2!=2 \\cdot 1 = 2$ arrangements:\n\n$$\n\\underbrace{A,B}_{1\\text{st way}}, \\quad \\underbrace{B,A}_{2\\text{nd way}}\n$$\n\n- Likewise, suppose we have $n=3$ objects: $A,$ $B,$ and $C.$ Then there are $3!=3 \\cdot 2 \\cdot 1 = 6$ arrangements:\n\n$$\n\\underbrace{A,B,C}_{1\\text{st way}},\\quad\n\\underbrace{A,C,B}_{2\\text{nd way}}, \\quad \n\\underbrace{B,A,C}_{3\\text{rd way}}, \\quad \n\\underbrace{B,C,A}_{4\\text{th way}}, \\quad \n\\underbrace{C,A,B}_{5\\text{th way}},\\quad \n\\underbrace{C,B,A}_{6\\text{th way}}\n$$\n\nThis pattern extends to any number of objects." :tutorial/id #uuid "0753e8b5-a022-5644-84fc-f43f1dcf6761" :tutorial/math-academy-id 3680 :tutorial/title "Introduction"} :step/id #uuid "c7acf227-0405-52eb-b5a9-6874c264b053" :step/math-academy-id 20565 :step/next {:db/id #edb/ref 17592186084114}} {:db/id #edb/ref 17592186084114 :step/content {:db/id #edb/ref 17592186083219 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083019 :question/id #uuid "d39c9a9a-e44b-5673-b930-25576c8a54a3" :question/math-academy-id "e-5671"} :knowledge-point/id #uuid "74677256-e307-5d49-b7e0-c3f4e79cf818" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049300} {:db/id #edb/ref 17592186049341}] :knowledge-point/questions [{:db/id #edb/ref 17592186083602} {:db/id #edb/ref 17592186083844} {:db/id #edb/ref 17592186237956} {:db/id #edb/ref 17592186237957} {:db/id #edb/ref 17592186284784} {:db/id #edb/ref 17592186287966} {:db/id #edb/ref 17592186332929} {:db/id #edb/ref 17592186335791} {:db/id #edb/ref 17592186335799} {:db/id #edb/ref 17592186392656} {:db/id #edb/ref 17592186395905}] :knowledge-point/title "Calculating the Number of Ways That N Objects Can Be Arranged"} :step/id #uuid "55717602-2643-55f3-9ba3-f1359bfa5ed3" :step/math-academy-id 20566 :step/next {:db/id #edb/ref 17592186084115}} {:db/id #edb/ref 17592186084115 :step/content {:db/id #edb/ref 17592186084447 :tutorial/content "The mathematical name for an arrangement is a **permutation**. With a permutation, *the order matters*. This means that for the letters $A,B,C,D,E$, the permutation\n\n$$\nA,B,C,D,E\n$$\n\n    is different from\n\n$$\nE,D,C,B,A.\n$$" :tutorial/id #uuid "29dee738-c115-51e6-b129-3ddb6d812d68" :tutorial/math-academy-id 3681 :tutorial/title "Permutations"} :step/id #uuid "c5ef9564-d57a-578d-92b9-ae3aee5d0a39" :step/math-academy-id 20567 :step/next {:db/id #edb/ref 17592186084116}} {:db/id #edb/ref 17592186084116 :step/content {:db/id #edb/ref 17592186083220 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083020 :question/id #uuid "0b1ea0d9-4329-562d-b83a-3a6870536a39" :question/math-academy-id "e-5672"} :knowledge-point/id #uuid "e49e2595-62a1-595a-8df9-99541bccbdf5" :knowledge-point/questions [{:db/id #edb/ref 17592186083603} {:db/id #edb/ref 17592186083809} {:db/id #edb/ref 17592186235558} {:db/id #edb/ref 17592186237958} {:db/id #edb/ref 17592186237959} {:db/id #edb/ref 17592186237960} {:db/id #edb/ref 17592186287965} {:db/id #edb/ref 17592186335792} {:db/id #edb/ref 17592186335803} {:db/id #edb/ref 17592186335826} {:db/id #edb/ref 17592186335828} {:db/id #edb/ref 17592186354520} {:db/id #edb/ref 17592186354531}] :knowledge-point/title "Calculating Permutations"} :step/id #uuid "12763dad-dbd5-5f26-bc50-389926344c0e" :step/math-academy-id 20568}] :activity/title "Ordering Objects" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083458}]}
