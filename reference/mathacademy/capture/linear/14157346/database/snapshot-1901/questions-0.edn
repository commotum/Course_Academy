#{[{:db/id #edb/ref 17592186059422 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059871 :knowledge-point/id #uuid "997d255f-89af-5563-b10f-eecaae62d8c0" :knowledge-point/title "Applying the Power Rule for Exponents With Integer Bases"}] :question/id #uuid "3625f2a9-3103-551e-b350-b0c83d9b241f" :question/math-academy-id "e-13039" :question/problem "Express $5(5^2) \\times 5^4$ as a base raised to a single exponent." :question/worked-solution "First, we write\n\n$$\n5(5^2) = 5^1 \\times 5^2.\n$$\n\nSo our expression can be written as\n\n$$\n5^1 \\times 5^2 \\times 5^4\n$$\n\nTo multiply powers of the same base, we simply add the exponents:\n\n$$\n5^1 \\times 5^2 \\times 5^4 = 5^{1+2+4} = 5^7\n$$"}] [{:db/id #edb/ref 17592186059423 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059872 :knowledge-point/id #uuid "0aa91f9b-e324-557c-9a6b-fb3389bbeaf8" :knowledge-point/title "Applying the Product Rule for Exponents With Fractional or Decimal Bases"}] :question/id #uuid "edac9b20-71bf-544e-8e28-833c376097d5" :question/math-academy-id "e-13040" :question/problem "Express $\\left(\\dfrac{1}{3}\\right)^2\\times \\left(\\dfrac{1}{3}\\right)^2$ as a base raised to a single exponent." :question/worked-solution "To multiply powers of the same base, we add the exponents:\n\n$$\n\\left(\\dfrac{1}{3}\\right)^2\\times \\left(\\dfrac{1}{3}\\right)^2 =  \\left(\\dfrac{1}{3}\\right)^{2+2} =  \\left(\\dfrac{1}{3}\\right)^4\n$$"}] [{:db/id #edb/ref 17592186059424 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059873 :knowledge-point/id #uuid "908d5434-7533-5d33-bc0d-99f4cc9dd44b" :knowledge-point/title "Evaluating Products with Negative Exponents Using the Product Rule"}] :question/id #uuid "81027692-8570-59a6-a6f9-b31211baa681" :question/math-academy-id "e-13041" :question/problem "Evaluate $2^2\\times 2^{-5}.$" :question/worked-solution "To multiply powers of the same base, we add the exponents:\n\n$$\n2^2\\times 2^{-5} =2^{2+(-5)} = 2^{-3}\n$$\n\nTo evaluate $2^{-3},$ we find the reciprocal of the base $(2)$ and then raise that reciprocal to the same power but with the opposite sign:\n\n$$\n2^{-3}  = \\left(\\dfrac{1}{2}\\right)^3 =\\dfrac{1}{2} \\times \\dfrac{1}{2} \\times \\dfrac{1}{2} = \\dfrac{1}{8}\n$$"}] [{:db/id #edb/ref 17592186480650 :knowledge-point/_questions [{:db/id #edb/ref 17592186059871 :knowledge-point/id #uuid "997d255f-89af-5563-b10f-eecaae62d8c0" :knowledge-point/title "Applying the Power Rule for Exponents With Integer Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e6532bc-4b83-5e34-b0a1-4dd68107a4b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{9}" :db/id #edb/ref 17592186480161} {:answer/id #uuid "7166dd22-1374-5ecf-804d-95aab19b1a62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{-2}" :db/id #edb/ref 17592186480296} {:answer/id #uuid "7a300419-b828-5baa-9150-b4d2f6df3840" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{-1}" :db/id #edb/ref 17592186480312} {:answer/id #uuid "99db8c98-3844-5678-92df-54922c697c78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{20}" :db/id #edb/ref 17592186480365} {:answer/id #uuid "f3c8637e-65d7-5e97-aebf-69559da7d6f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{10}" :db/id #edb/ref 17592186480512}] :answer-field/correct {:answer/id #uuid "f3c8637e-65d7-5e97-aebf-69559da7d6f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{10}" :db/id #edb/ref 17592186480512} :answer-field/id #uuid "2bfe1a7a-be63-5382-86e8-a78b28725895" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186480548}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "353b78e0-100e-5425-97b3-923c0bd8ad1a" :question/math-academy-id "q-100312" :question/problem "${3}^{4}\\times 3({3}^{5})=$" :question/worked-solution "First, we write\n\n$$\n3({3}^{5})={3}^{1}\\times {3}^{5}.\n$$\n\nSo our expression can be written as\n\n$$\n{3}^{4}\\times {3}^{1}\\times {3}^{5}.\n$$\n\nTo multiply powers of the same base, we simply add the exponents:\n\n$$\n{3}^{4}\\times {3}^{1}\\times {3}^{5}={3}^{4+1+5}={3}^{10}\n$$"}] [{:db/id #edb/ref 17592186480678 :knowledge-point/_questions [{:db/id #edb/ref 17592186059873 :knowledge-point/id #uuid "908d5434-7533-5d33-bc0d-99f4cc9dd44b" :knowledge-point/title "Evaluating Products with Negative Exponents Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b1d0bba-a1da-5243-9c9b-11bf413194b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186480204}] :answer-field/correct {:answer/id #uuid "3b1d0bba-a1da-5243-9c9b-11bf413194b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186480204} :answer-field/id #uuid "50df2db3-7cd5-5db4-9261-95bd3ad3d338" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186480556}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9f94c748-cc3f-548a-899d-563289a823a1" :question/math-academy-id "q-185302" :question/problem "Evaluate the following:\n\n${9}^{7}\\times {9}^{-7}=$\n{{field-1}}" :question/worked-solution "To multiply powers of the same base, we add the exponents:\n\n$$\n{9}^{7}\\times {9}^{-7}={9}^{7-7}={9}^{0}\n$$\n\nAny number raised to the power of zero is equal to $1.$ So, \n\n$$\n{9}^{0}=1.\n$$"}] [{:db/id #edb/ref 17592186480635 :knowledge-point/_questions [{:db/id #edb/ref 17592186059873 :knowledge-point/id #uuid "908d5434-7533-5d33-bc0d-99f4cc9dd44b" :knowledge-point/title "Evaluating Products with Negative Exponents Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40a24c23-247d-5712-9a28-a78576688a6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{81}" :db/id #edb/ref 17592186480217}] :answer-field/correct {:answer/id #uuid "40a24c23-247d-5712-9a28-a78576688a6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{81}" :db/id #edb/ref 17592186480217} :answer-field/id #uuid "e83883fd-0df1-5652-851f-22e92beb519e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186480615}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0c468631-3494-5a5c-8263-59a9e6ef38aa" :question/math-academy-id "q-185312" :question/problem "Expressed as a fraction in its simplest form, ${9}^{-5}\\times {9}^{3}=${{field-1}}." :question/worked-solution "To multiply powers of the same base, we add the exponents:\n\n$$\n{9}^{-5}\\times {9}^{3}={9}^{-5+3}={9}^{-2}\n$$\n\nTo evaluate ${9}^{-2},$ we find the reciprocal of the base $(9)$ and then raise that reciprocal to the same power but with the opposite sign:\n\n$$\n{9}^{-2}={(\\frac{1}{9})}^{2}=\\frac{1}{9}\\times \\frac{1}{9}=\\frac{1}{81}\n$$"}] [{:db/id #edb/ref 17592186480648 :knowledge-point/_questions [{:db/id #edb/ref 17592186059871 :knowledge-point/id #uuid "997d255f-89af-5563-b10f-eecaae62d8c0" :knowledge-point/title "Applying the Power Rule for Exponents With Integer Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e96ace4-0fe6-5351-92ac-3f7507ef6f08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{9}" :db/id #edb/ref 17592186480139} {:answer/id #uuid "6dc8ee66-cded-543e-8fb4-753cc