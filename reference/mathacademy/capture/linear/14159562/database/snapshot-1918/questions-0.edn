\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186483415 :knowledge-point/_questions [{:db/id #edb/ref 17592186064248 :knowledge-point/id #uuid "8cfe2121-66f0-53fa-b744-041fe830bf13" :knowledge-point/title "Factoring Trinomials With Negative Constants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "906a0b55-204a-56a6-a903-6f001989e184" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186483062}] :answer-field/correct {:answer/id #uuid "906a0b55-204a-56a6-a903-6f001989e184" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186483062} :answer-field/id #uuid "15fd5e31-0a26-515f-9010-378807b928a9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186483247} {:answer-field/choices [{:answer/id #uuid "236446a4-7281-5c03-903f-c5084de03781" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186482875}] :answer-field/correct {:answer/id #uuid "236446a4-7281-5c03-903f-c5084de03781" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186482875} :answer-field/id #uuid "6d81b9e9-cd19-5eec-9e3c-c8f9eb596d52" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186483281} {:answer-field/choices [{:answer/id #uuid "18be1f63-741d-5018-91f5-2810be8a6b0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186482859}] :answer-field/correct {:answer/id #uuid "18be1f63-741d-5018-91f5-2810be8a6b0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186482859} :answer-field/id #uuid "8b2c159e-029b-5def-beed-5f2e79c867bd" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186483295}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d54b0636-ad05-55a6-91c9-9613b500f9d1" :question/math-academy-id "q-224935" :question/problem "Factor the following quadratic expression.\n\n$5{b}^{2}-34b-7=(b\\,-$\n{{field-1}}$)($\n{{field-2}}$b\\,+$\n{{field-3}}$)$" :question/worked-solution "We must factor the quadratic expression\n\n$$\n5{b}^{2}-34b-7.\n$$\n\nFirst, we find two numbers that \n\n- multiply to the product of the quadratic coefficient and the constant ($5\\times -7=-35$), and\n\n- add to the linear coefficient ($-34$).\n\nFirst, we find the factor pairs of $-35:$\n\n$$\n(1,-35),\\,(-1,35),\\,(5,-7),\\,(-5,7)\n$$\n\nNotice the numbers in the factor pair $(1,-35)$ add to $-34:$ \n\n$$\n1+(-35)=-34\\,✓\n$$\n\nThen, rewrite the linear term as $b-35b,$ and factor the result by grouping:\n\n$$\n\\begin{aligned}5{b}^{2}-34b-7 & = \\\\ 5{b}^{2}+b-35b-7 & = \\\\ (5{b}^{2}+b)-(35b+7) & = \\\\ b(5b+1)-7(5b+1) & = \\\\ (b-7)(5b+1) & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186483365 :knowledge-point/_questions [{:db/id #edb/ref 17592186064248 :knowledge-point/id #uuid "8cfe2121-66f0-53fa-b744-041fe830bf13" :knowledge-point/title "Factoring Trinomials With Negative Constants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d31edaf-e68f-5896-886f-ba0c8884747c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5h-3)(h+3)" :db/id #edb/ref 17592186483031} {:answer/id #uuid "83ff1739-d53c-5c8a-bb8e-be1d8a7c3c55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5h+3)(h-3)" :db/id #edb/ref 17592186483042} {:answer/id #uuid "e66b9ced-ce85-5b70-a931-a9180edc99f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5h+3)(h-1)" :db/id #edb/ref 17592186483202} {:answer/id #uuid "f1e12de1-9652-519c-a92a-edcd7c96464d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5h+1)(h-3)" :db/id #edb/ref 17592186483218} {:answer/id #uuid "f61fabd3-a06c-5ead-8f35-37c1f39d63e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5h+1)(h-9)" :db/id #edb/ref 17592186483227}] :answer-field/correct {:answer/id #uuid "83ff1739-d53c-5c8a-bb8e-be1d8a7c3c55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5h+3)(h-3)" :db/id #edb/ref 17592186483042} :answer-field/id #uuid "37c5d472-7e62-5f47-b3dc-73ce05638ddc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483258}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "433698fd-3b83-5c8a-9280-a485202f8699" :question/math-academy-id "q-52254" :question/problem "Factor $5{h}^{2}-12h-9.$" :question/worked-solution "We must factor the quadratic expression\n\n$$\n5{h}^{2}-12h-9.\n$$\n\nFirst, we find two numbers that \n\n- multiply to the product of the quadratic coefficient and the constant ($5\\times -9=-45$), and\n\n- add to the linear coefficient ($-12$).\n\nThe factor pairs of $-45$ are\n\n$$\n(1,-45),\\,\\,(-1,45),\\,\\,(3,-15),\\,\\,(-3,15),\\,\\,(5,-9),\\,\\,(-5,9).\n$$\n\nNotice the numbers in the factor pair $(3,-15)$ add to $-12:$ \n\n$$\n3-15=-12\\,✓\n$$\n\nThen, rewrite the linear term as $3h-15h,$ and factor the result by grouping:\n\n$$\n\\begin{aligned}5{h}^{2}-12h-9 & = \\\\ 5{h}^{2}+3h-15h-9 & = \\\\ 5{h}^{2}-15h+3h-9 & = \\\\ (5{h}^{2}-15h)+(3h-9) & = \\\\ 5h(h-3)+3(h-3) & = \\\\ (5h+3)(h-3) & \\end{aligned}\n$$"}]}
