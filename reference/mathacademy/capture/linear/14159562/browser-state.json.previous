 0.3em\"><mtr><mtd><mn>5</mn><msup><mi>h</mi><mn>2</mn></msup><mo>−</mo><mn>12</mn><mi>h</mi><mo>−</mo><mn>9</mn></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mn>5</mn><msup><mi>h</mi><mn>2</mn></msup><mo>+</mo><mn>3</mn><mi>h</mi><mo>−</mo><mn>15</mn><mi>h</mi><mo>−</mo><mn>9</mn></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mn>5</mn><msup><mi>h</mi><mn>2</mn></msup><mo>−</mo><mn>15</mn><mi>h</mi><mo>+</mo><mn>3</mn><mi>h</mi><mo>−</mo><mn>9</mn></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mo stretchy=\"false\">(</mo><mn>5</mn><msup><mi>h</mi><mn>2</mn></msup><mo>−</mo><mn>15</mn><mi>h</mi><mo stretchy=\"false\">)</mo><mo>+</mo><mo stretchy=\"false\">(</mo><mn>3</mn><mi>h</mi><mo>−</mo><mn>9</mn><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mn>5</mn><mi>h</mi><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>h</mi><mo>−</mo><mn>3</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>+</mo><mn>3</mn><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>h</mi><mo>−</mo><mn>3</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>5</mn><mi>h</mi><mo>+</mo><mn>3</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>h</mi><mo>−</mo><mn>3</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd><mtd></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
