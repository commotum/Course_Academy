 0.8em 0.3em\"><mtr><mtd><mn>5</mn><msup><mi>b</mi><mn>2</mn></msup><mo>−</mo><mn>34</mn><mi>b</mi><mo>−</mo><mn>7</mn></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mn>5</mn><msup><mi>b</mi><mn>2</mn></msup><mo>+</mo><mi>b</mi><mo>−</mo><mn>35</mn><mi>b</mi><mo>−</mo><mn>7</mn></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mo stretchy=\"false\">(</mo><mn>5</mn><msup><mi>b</mi><mn>2</mn></msup><mo>+</mo><mi>b</mi><mo stretchy=\"false\">)</mo><mo>−</mo><mo stretchy=\"false\">(</mo><mn>35</mn><mi>b</mi><mo>+</mo><mn>7</mn><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mi>b</mi><mo stretchy=\"false\">(</mo><mn>5</mn><mi>b</mi><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>−</mo><mn>7</mn><mo stretchy=\"false\">(</mo><mn>5</mn><mi>b</mi><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mo stretchy=\"false\">(</mo><mi>b</mi><mo>−</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>7</mn></mpadded></mstyle><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>5</mn></mpadded></mstyle><mi>b</mi><mo>+</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>1</mn></mpadded></mstyle><mo stretchy=\"false\">)</mo></mtd><mtd></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
