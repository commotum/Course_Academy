ww.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.8em 0.8em 0.3em\"><mtr><mtd><mn>6</mn><msup><mi>w</mi><mn>2</mn></msup><mo>+</mo><mn>19</mn><mi>w</mi><mo>+</mo><mn>10</mn></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mn>6</mn><msup><mi>w</mi><mn>2</mn></msup><mo>+</mo><mn>4</mn><mi>w</mi><mo>+</mo><mn>15</mn><mi>w</mi><mo>+</mo><mn>10</mn></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mo stretchy=\"false\">(</mo><mn>6</mn><msup><mi>w</mi><mn>2</mn></msup><mo>+</mo><mn>4</mn><mi>w</mi><mo stretchy=\"false\">)</mo><mo>+</mo><mo stretchy=\"false\">(</mo><mn>15</mn><mi>w</mi><mo>+</mo><mn>10</mn><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mn>2</mn><mi>w</mi><mo stretchy=\"false\">(</mo><mn>3</mn><mi>w</mi><mo>+</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mn>5</mn><mo stretchy=\"false\">(</mo><mn>3</mn><mi>w</mi><mo>+</mo><mn>2</mn><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mo stretchy=\"false\">(</mo><mn>3</mn><mi>w</mi><mo>+</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>2</mn><mi>w</mi><mo>+</mo><mn>5</mn><mo stretchy=\"false\">)</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
