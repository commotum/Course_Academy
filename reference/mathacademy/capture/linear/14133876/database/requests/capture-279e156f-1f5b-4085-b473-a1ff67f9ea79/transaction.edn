[[:db/retract 17592186104482 :answer-field/choices 17592186104483] [:db/retract 17592186104482 :answer-field/choices 17592186104484] [:db/retract 17592186104482 :answer-field/choices 17592186104485] [:db/retract 17592186104482 :answer-field/choices 17592186104486] [:db/retract 17592186104482 :answer-field/choices 17592186104487] {:db/id 17592186105754 :knowledge-point/questions ["question-7a745219-e4a4-5d69-8265-b49ccdb551aa" "question-6ae251f0-0967-5241-8e82-3151db4af77f" "question-7f6d64ec-6b4a-5abd-975e-7e05ae02001c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105491 :question/worked-solution "The given figure is a polygon with $7$ sides: $\\overline{AB},\\, \\overline{BC},\\, \\overline{CD},\\, \\overline{DE},\\, \\overline{EF},\\, \\overline{FG},$ and $\\overline{GA}.$\n\nBecause it has $7$ sides, it is a heptagon." :db/ensure [:question/validate]} {:db/id 17592186105755 :knowledge-point/questions ["question-03503bc3-0ad5-5a76-9dbc-7ac5f9a8c27c" "question-38b673e3-7e2b-5e4c-9038-6069f5ae0732" "question-3b69d757-53e7-5048-9a43-28ea1c4545d4" "question-571d0bc8-b8a3-5a5f-a4a1-96e03d46b474"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105494 :question/worked-solution "A polygon is **convex** if it has no internal angle larger than $180^\\circ.$ In plain words, a convex polygon has no angles pointing inwards. Otherwise, the polygon is called **concave**.\n\nA polygon is **simple** if its boundary does not intersect itself. Otherwise, the polygon is called **complex**.\n\nIn our case, the polygon is \n\n- $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{simple}}$ since the boundary doesn't intersect itself, and\n\n- $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{concave}}$ since it has an angle pointing inwards." :db/ensure [:question/validate]} {:db/id 17592186105756 :knowledge-point/questions ["question-52827c1b-73af-5f05-9c14-74a05d62263e" "question-bca3b306-feba-55c4-8402-85511b1704d2" "question-7d6611e1-798d-5d69-a078-8e2760f4023e" "question-3fa4192b-aff0-50e1-b9c8-83eee32d904d" "question-dd3ebc93-bf89-529b-97c7-60c59d0406c6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105492 :question/problem "Which vertex/vertices are adjacent to $A?$\n\n![](images/75/7571f72435ee7eacc74abfabf0da76d3b5da621a28884cf3cf17e253917d4828.png)" :question/worked-solution "$A$ is the endpoint of the sides $\\overline{AB}$ and $\\overline{GA}.$ Therefore, the vertices $B$ and $G$ are adjacent to $A.$" :db/ensure [:question/validate]} {:db/id 17592186105757 :knowledge-point/questions ["question-22db0dc8-b0cf-577e-b0b1-dc2cf03f5876" "question-688c82f3-42f6-5fe7-994b-b325cfd9eb38" "question-b3f2064e-89fd-57bf-9cbf-30cae7770c78" "question-9808b081-0611-54e0-8956-702438c9b60b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105493 :question/worked-solution "The segment $\\overline{BD}$ joins two non-adjacent vertices of the polygon. Therefore, $\\overline{BD}$ is a diagonal.\n\nThe point $A$ is an endpoint of the sides $\\overline{AB}$ and $\\overline{FA}.$ Hence, $A$ is a vertex." :db/ensure [:question/validate]} {:db/id "question-7a745219-e4a4-5d69-8265-b49ccdb551aa" :question/id #uuid "7a745219-e4a4-5d69-8265-b49ccdb551aa" :question/math-academy-id "q-117893" :question/problem "![](images/73/7386c2df6c4cc58faf2f6900b07ccd914ca5cf36d6ee33dc82e7ecfbaf622c52.png)\n\nWhat type of polygon is the figure shown above?" :question/worked-solution "The given figure is not a polygon because it contains a curve from vertex $A$ to vertex $D.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f60ac8d1-14dc-556d-8879-dcdd3ca6e927"] :db/ensure [:question/validate]} {:db/id "answer-field-f60ac8d1-14dc-556d-8879-dcdd3ca6e927" :answer-field/id #uuid "f60ac8d1-14dc-556d-8879-dcdd3ca6e927" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-19a70177-629a-598d-83d2-82d9bb6a9db1" :answer-field/choices ["answer-349569f0-9441-5341-922f-65d8019