er/type :answer.type/text :answer/value "$\\overset{―}{AB}$ and $\\overset{―}{CD}$" :db/ensure [:answer/validate]} {:db/id "answer-0f172ff4-b9f2-5351-bdfd-09f6036ebd62" :answer/id #uuid "0f172ff4-b9f2-5351-bdfd-09f6036ebd62" :answer/type :answer.type/text :answer/value "$\\overset{―}{BC}$ and $\\overset{―}{AF}$" :db/ensure [:answer/validate]} {:db/id "answer-3a749281-1cff-5ac0-8364-84c262625e80" :answer/id #uuid "3a749281-1cff-5ac0-8364-84c262625e80" :answer/type :answer.type/text :answer/value "$\\overset{―}{CD}$ and $\\overset{―}{EF}$" :db/ensure [:answer/validate]} {:db/id "answer-c503f58b-66e3-54ea-b9f7-79f35115c03f" :answer/id #uuid "c503f58b-66e3-54ea-b9f7-79f35115c03f" :answer/type :answer.type/text :answer/value "$\\overset{―}{DE}$ and $\\overset{―}{AF}$" :db/ensure [:answer/validate]} {:db/id "answer-9d4b8675-c28d-5542-85d6-22902dc04417" :answer/id #uuid "9d4b8675-c28d-5542-85d6-22902dc04417" :answer/type :answer.type/text :answer/value "$\\overset{―}{EF}$ and $\\overset{―}{BC}$" :db/ensure [:answer/validate]} {:db/id "question-22db0dc8-b0cf-577e-b0b1-dc2cf03f5876" :question/id #uuid "22db0dc8-b0cf-577e-b0b1-dc2cf03f5876" :question/math-academy-id "q-164612" :question/problem "![](images/b4/b4938a34e77b51f87f9536e8edee7661388e0f055012a292cdd90305a7f43ebd.png)\n\nWhat are the elements $\\overset{―}{CD}$ and $F$ for the polygon above?" :question/worked-solution "The segment $\\overset{―}{CD}$ joins two adjacent vertices of the polygon. Therefore, $\\overset{―}{CD}$ is a side. \n\nThe point $F$ is an endpoint of the sides $\\overset{―}{EF}$ and $\\overset{―}{FA}.$ Hence, $F$ is a vertex." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4bb81aa3-5134-5c48-8715-368568a73c23"] :db/ensure [:question/validate]} {:db/id "answer-field-4bb81aa3-5134-5c48-8715-368568a73c23" :answer-field/id #uuid "4bb81aa3-5134-5c48-8715-368568a73c23" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correc