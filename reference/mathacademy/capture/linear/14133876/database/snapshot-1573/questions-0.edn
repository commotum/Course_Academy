92186105755 :knowledge-point/id #uuid "0d25a77b-7977-50b2-b375-51b8539bc9b9" :knowledge-point/title "Determining the Type of a Polygon"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69a70e12-f1f1-50fe-b28d-fce9a2fd7b40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "complex" :db/id #edb/ref 17592186442647} {:answer/id #uuid "c1c33462-57a0-5f14-b239-7d37acbd2e71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "simple" :db/id #edb/ref 17592186442669}] :answer-field/correct {:answer/id #uuid "c1c33462-57a0-5f14-b239-7d37acbd2e71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "simple" :db/id #edb/ref 17592186442669} :answer-field/id #uuid "7f27319a-5365-5f36-8160-bc826e9c1137" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186442707} {:answer-field/choices [{:answer/id #uuid "6a609550-db12-5188-addc-8806182f30df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "concave" :db/id #edb/ref 17592186442648} {:answer/id #uuid "ee25ef95-d4e1-5792-b8e1-c0bd47a4202a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "convex" :db/id #edb/ref 17592186442685}] :answer-field/correct {:answer/id #uuid "ee25ef95-d4e1-5792-b8e1-c0bd47a4202a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "convex" :db/id #edb/ref 17592186442685} :answer-field/id #uuid "a193ce18-3add-572b-b252-fdc88ca7bc0c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186442709}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "38b673e3-7e2b-5e4c-9038-6069f5ae0732" :question/math-academy-id "q-237200" :question/problem "![](images/e0/e021f3eca686f2f0027331655bd95cdde82ecb1fe6a54af0e4cded5fc3660787.png)\n\nConstruct the correct description for the above polygon.\n\n$\\,$ The polygon is {{field-1}} and {{field-2}}." :question/worked-solution "A polygon is **convex** if it has no internal angle larger than ${180}^{∘}.$ In plain words, a convex polygon has no angles pointing inwards. Otherwise, the polygon is called **concave**.\n\nA polygon is **simple** if its boundary does not intersect itself. Otherwise, the polygon is called **complex**.\n\nIn our case, the polygon is \n\n- $\\text{simple}$ since the boundary doesn't intersect itself, and\n\n- $\\text{convex}$ since it has no angles pointing inwards."}] [{:db/id #edb/ref 17592186442719 :knowledge-point/_questions [{:db/id #edb/ref 17592186105755 :knowledge-point/id #uuid "0d25a77b-7977-50b2-b375-51b8539bc9b9" :knowledge-point/title "Determining the Type of a Polygon"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "412021b5-9636-5fb4-941a-93bc54bdcd11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "concave" :db/id #edb/ref 17592186442635} {:answer/id #uuid "fccb142f-823b-5006-9ec2-7ff512772011" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "convex" :db/id #edb/ref 17592186442693}] :answer-field/correct {:answer/id #uuid "412021b5-9636-5fb4-941a-93bc54bdcd11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "concave" :db/id #edb/ref 17592186442635} :answer-field/id #uuid "8d6ca8d5-12ba-5eee-83c8-7cfccd929dda" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186442708} {:answer-field/choices [{:answer/id #uuid "4b7d1542-b0d4-570c-9a12-efa5d83836f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "simple" :db/id #edb/ref 17592186442637} {:answer/id #uuid "d533038