9 :knowledge-point/_questions [{:db/id #edb/ref 17592186105757 :knowledge-point/id #uuid "1ed0dc2a-7c76-5fee-9aa8-aad529cf1952" :knowledge-point/title "Identifying Parts of a Polygon"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dfad3b8-82ab-5de4-8e98-222d1152b2c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\overset{―}{BC}$ and $\\overset{―}{DF}$ are both diagonals" :db/id #edb/ref 17592186442627} {:answer/id #uuid "32da3b54-b750-5887-b04f-86b7ef454ce8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\overset{―}{BC}$ is a side and $\\overset{―}{DF}$ is a diagonal" :db/id #edb/ref 17592186442630} {:answer/id #uuid "5f349821-bdfc-55ec-a987-32576027742f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\overset{―}{BC}$ is a diagonal and $\\overset{―}{DF}$ is a vertex" :db/id #edb/ref 17592186442642} {:answer/id #uuid "982fc555-abad-5f37-97a2-a48637da23fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\overset{―}{BC}$ is a diagonal and $\\overset{―}{DF}$ is a side" :db/id #edb/ref 17592186442658} {:answer/id #uuid "bb02e2b0-9f14-5741-8d89-64ad6c2f7574" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\overset{―}{BC}$ and $\\overset{―}{BF}$ are both sides" :db/id #edb/ref 17592186442668}] :answer-field/correct {:answer/id #uuid "32da3b54-b750-5887-b04f-86b7ef454ce8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\overset{―}{BC}$ is a side and $\\overset{―}{DF}$ is a diagonal" :db/id #edb/ref 17592186442630} :answer-field/id #uuid "4ca7cd59-aef1-56ab-a2be-27bd5a477ef2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442703}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b3f2064e-89fd-57bf-9cbf-30cae7770c78" :question/math-academy-id "q-117973" :question/problem "![](images/c2/c268f171428feb3373b8c36f21fa7d9dfc25d2624bb313ffab272fca5459a727.png)\n\nWhat are the elements $\\overset{―}{BC}$ and $\\overset{―}{DF}$ for the polygon above?" :question/worked-solution "The segment $\\overset{―}{BC}$ joins two adjacent vertices. Thus, $\\overset{―}{BC}$ is a side of the polygon.\n\nThe segment $\\overset{―}{DF}$ joins two non-adjacent vertices. Therefore, $\\overset{―}{DF}$ is a diagonal."}] [{:db/id #edb/ref 17592186442728 :knowledge-point/_questions [{:db/id #edb/ref 17592186105757 :knowledge-point/id #uuid "1ed0dc2a-7c76-5fee-9aa8-aad529cf1952" :knowledge-point/title "Identifying Parts of a Polygon"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f5d5aff-dad6-5ecb-be8f-94ad8daa507d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186442628} {:answer/id #uuid "32035f88-4386-5a0e-9a90-12c39c00ba8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186442629} {:answer/id #uuid "3e85c536-ba38-5d8c-901f-4e5bc71b071f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186442633} {:answer/id #uuid "c43ab6a2-7a17-5b0a-be28-eb7ab27a2b15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186442670} {:answer/id #uuid "da974571-d34d-56c4-bd1e-d81c82ad54dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186442677}] :answer-field/correct {:answer/id #uuid "da974571-d34d-56c4-bd1e-d81c82ad54dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186442677} :answer-field/id #uuid "692fd744-03c7-5427-919b-245ddf334c3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442705}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9808b081-0611-54e0-8956-702438c9b60b" :question/math-academy-id "q-164607" :question/problem "How many diagonals does a pentagon $ABCDE$ have?" :question/worked-solution "Diagonals join non-adjacent vertices.\n\nAs we can see from the diagram below, the diagonals of the pentagon are $\\overset{―}{AC},$ $\\overset{―}{AD},$ $\\overset{―}{BD},$ $\\overset{―}{BE}$ and $\\overset{―}{CE}.$\n\n![](images/b3/b3956aebca9c5cf83a42b72de049d3a2c2e91604e336ae3d1d62ba2d8e22d315.png)\n\nTherefore, the pentagon $ABCDE$ has $5$ diagonals."}] [{:db/id #edb/ref 17592186442717 :knowledge-point/_questions [{:db/id #edb/ref 17592186105757 :knowledge-point/id #uuid "1ed0dc2a-7c76-5fee-9aa8-aad529cf1952" :knowledge-point/title "Identifying Parts of a Polygon"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01a07b11-7e9a-5be9-bf1d-a9ddd09ad102" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\overset{―}{CD}$ is a diagonal and $F$ is a vertex" :db/id #edb/ref 17592186442616} {:answer/id #uuid "62f2d0bc-0626-5017-bffc-91f36c5e72c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\overset{―}{CD}$ is a side and $F$ is a vertex" :db/id #edb/ref 17592186442643} {:answer/id #uuid "ddbb161a-7ee7-5e54-8dea-b18c420594e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\overset{―}{CD}$ is a vertex and $F$ is a diagonal" :db/id #edb/ref 17592186442678} {:answer/id #uuid "e6c90957-714c-5157-8207-75afc56046b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\overset{―}{CD}$ is a side and $F$ is a diagonal" :db/id #edb/ref 17592186442679} {:answer/id #uuid "f3f55a31-76f8-511e-8611-3e96c3439423" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\overset{―}{CD}$ is a vertex and $F$ is a side" :db/id #edb/ref 17592186442687}] :answer-field/correct {:answer/id #uuid "62f2d0bc-0626-5017-bffc-91f36c5e72c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\overset{―}{CD}$ is a side and $F$ is a vertex" :db/id #edb/ref 17592186442643} :answer-field/id #uuid "4bb81aa3-5134-5c48-8715-368568a73c23" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442702}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "22db0dc8-b0cf-577e-b0b1-dc2cf03f5876" :question/math-academy-id "q-164612" :question/problem "![](images/b4/b4938a34e77b51f87f9536e8edee7661388e0f055012a292cdd90305a7f43ebd.png)\n\nWhat are the elements $\\overset{―}{CD}$ and $F$ for the polygon above?" :question/worked-solution "The segment $\\overset{―}{CD}$ joins two adjacent vertices of the polygon. Therefore, $\\overset{―}{CD}$ is a side. \n\nThe point $F$ is an endpoint of the sides $\\overset{―}{EF}$ and $\\overset{―}{FA}.$ Hence, $F$ is a vertex."}] [{:db/id #edb/ref 17592186106192 :knowledge-point/_questions [{:db/id #edb/ref 17592186105754 :knowledge-point/id #uuid "b9fd1d3c-8479-5b35-abbc-9664cea2e1a8" :knowledge-point/title "Identifying a Polygon"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd5966c6-04b7-53bf-80f3-783493ca6ab6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hexagon" :db/id #edb/ref 17592186103029} {:answer/id #uuid "00c1dab6-1937-5e76-896a-59a1a8eedf2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A nonagon" :db/id #edb/ref 17592186103030} {:answer/id #uuid "0829ba2c-c204-5c5a-9156-02fc706488dd" :answer/ty