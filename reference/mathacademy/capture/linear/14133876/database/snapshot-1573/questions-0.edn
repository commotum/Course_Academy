#{[{:db/id #edb/ref 17592186105491 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105754 :knowledge-point/id #uuid "b9fd1d3c-8479-5b35-abbc-9664cea2e1a8" :knowledge-point/title "Identifying a Polygon"}] :question/id #uuid "3f0d9dbb-448f-5e1e-b06c-4b6a3a674b09" :question/math-academy-id "e-15616" :question/problem "What type of polygon is the figure shown below?\n\n![](images/59/59d2d41ccd2c4c7f4c465a4d02acd531c62aefce2667c71e73ff4041aac1573d.png)" :question/worked-solution "The given figure is a polygon with $7$ sides: $\\overline{AB},\\, \\overline{BC},\\, \\overline{CD},\\, \\overline{DE},\\, \\overline{EF},\\, \\overline{FG},$ and $\\overline{GA}.$\n\nBecause it has $7$ sides, it is a heptagon."}] [{:db/id #edb/ref 17592186105492 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105756 :knowledge-point/id #uuid "61c58110-9813-5588-81d2-5735718589aa" :knowledge-point/title "Finding Adjacent Vertices and Sides"}] :question/id #uuid "e72f5a3b-8085-54dc-a09a-121925ef509c" :question/math-academy-id "e-15617" :question/problem "Which vertex/vertices are adjacent to $A?$\n\n![](images/75/7571f72435ee7eacc74abfabf0da76d3b5da621a28884cf3cf17e253917d4828.png)" :question/worked-solution "$A$ is the endpoint of the sides $\\overline{AB}$ and $\\overline{GA}.$ Therefore, the vertices $B$ and $G$ are adjacent to $A.$"}] [{:db/id #edb/ref 17592186105493 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105757 :knowledge-point/id #uuid "1ed0dc2a-7c76-5fee-9aa8-aad529cf1952" :knowledge-point/title "Identifying Parts of a Polygon"}] :question/id #uuid "33bf6630-1558-50b9-8823-0bd58d0787af" :question/math-academy-id "e-15618" :question/problem "What are the elements $\\overline{BD}$ and $A$ for the polygon below?\n\n![](images/51/514a59a0729844bf0424c67046667dcde5df6ecd7b9785a575fc4c2755bfaf28.png)" :question/worked-solution "The segment $\\overline{BD}$ joins two non-adjacent vertices of the polygon. Therefore, $\\overline{BD}$ is a diagonal.\n\nThe point $A$ is an endpoint of the sides $\\overline{AB}$ and $\\overline{FA}.$ Hence, $A$ is a vertex."}] [{:db/id #edb/ref 17592186105494 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105755 :knowledge-point/id #uuid "0d25a77b-7977-50b2-b375-51b8539bc9b9" :knowledge-point/title "Determining the Type of a Polygon"}] :question/id #uuid "d56604cb-e46a-5d52-94c4-dea5e8c0df3b" :question/math-academy-id "e-15623" :question/problem "![](images/58/58750f7e4f747cd7be9f991316169c52a807647c42c7550ae869ac7505841c83.png)\n\nIs the polygon shown above (a) simple or complex, and (b) convex or concave?" :question/worked-solution "A polygon is **convex** if it has no internal angle larger than $180^\\circ.$ In plain words, a convex polygon has no angles pointing inwards. Otherwise, the polygon is called **concave**.\n\nA polygon is **simple** if its boundary does not intersect itself. Otherwise, the polygon is called **complex**.\n\nIn our case, the polygon is \n\n- $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{simple}}$ since the boundary doesn't intersect itself, and\n\n- $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{concave}}$ since it has an angle pointing inwards."}] [{:db/id #edb/ref 17592186442725 :knowledge-point/_questions [{:db/id #edb/ref 17592186105754 :knowledge-point/id #uuid "b9fd1d3c-8479-5b35-abbc-9664cea2e1a8" :knowledge-point/title "Identifying a Polygon"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19a70177-629a-598d-83d2-82d9bb6a9db1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The figure is not a polygon" :db/id #edb/ref 17592186442624} {:answer/id #uuid "349569f0-9441-5341-922f-65d8019d65d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hexagon" :db/id #edb/ref 17592186442631} {:answer/id #uuid "993fbbcf-c5bf-5e72-9f3c-5f573839cf9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A quadrilateral" :db/id #edb/ref 17592186442659} {:answer/id #uuid "d8714206-9c77-522e-84e0-316b52e09685" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186442676} {:answer/id #uuid "ead24ed2-024f-5377-869e-27bf8fa023da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A pentagon" :db/id #edb/ref 17592186442683}] :answer-field/correct {:answer/id #uuid "19a70177-629a-598d-83d2-82d9bb6a9db1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The figure is not a polygon" :db/id #edb/ref 17592186442624} :answer-field/id #uuid "f60ac8d1-14dc-556d-8879-dcdd3ca6e927" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442714}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7a745219-e4a4-5d69-8265-b49ccdb551aa" :question/math-academy-id "q-117893" :question/problem "![](images/73/7386c2df6c4cc58faf2f6900b07ccd914ca5cf36d6ee33dc82e7ecfbaf622c52.png)\n\nWhat type of polygon is the figure shown above?" :question/worked-solution "The given figure is not a polygon because it contains a curve from vertex $A$ to vertex $D.$"}] [{:db/id #edb/ref 17592186442724 :knowledge-point/_questions [{:db/id #edb/ref 17592186105754 :knowledge-point/id #uuid "b9fd1d3c-8479-5b35-abbc-9664cea2e1a8" :knowledge-point/title "Identifying a Polygon"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a22efd5-9dd2-5623-9872-98455e93af2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A pentagon" :db/id #edb/ref 17592186442639} {:answer/id #uuid "a1132eed-8fde-5b1a-9733-99051dcf7357" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The figure is not a polygon" :db/id #edb/ref 17592186442664} {:answer/id #u