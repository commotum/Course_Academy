#{[{:db/id #edb/ref 17592186105491 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105754 :knowledge-point/id #uuid "b9fd1d3c-8479-5b35-abbc-9664cea2e1a8" :knowledge-point/title "Identifying a Polygon"}] :question/id #uuid "3f0d9dbb-448f-5e1e-b06c-4b6a3a674b09" :question/math-academy-id "e-15616" :question/problem "What type of polygon is the figure shown below?\n\n![](images/59/59d2d41ccd2c4c7f4c465a4d02acd531c62aefce2667c71e73ff4041aac1573d.png)" :question/worked-solution "The given figure is a polygon with $7$ sides: $\\overline{AB},\\, \\overline{BC},\\, \\overline{CD},\\, \\overline{DE},\\, \\overline{EF},\\, \\overline{FG}$, and $\\overline{GA}$.\n\nBecause it has $7$ sides, it is a heptagon."}] [{:db/id #edb/ref 17592186105492 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105756 :knowledge-point/id #uuid "61c58110-9813-5588-81d2-5735718589aa" :knowledge-point/title "Finding Adjacent Vertices and Sides"}] :question/id #uuid "e72f5a3b-8085-54dc-a09a-121925ef509c" :question/math-academy-id "e-15617" :question/problem "Which vertex/vertices are adjacent to $A$?\n\n![](images/75/7571f72435ee7eacc74abfabf0da76d3b5da621a28884cf3cf17e253917d4828.png)" :question/worked-solution "$A$ is the endpoint of the sides $\\overline{AB}$ and $\\overline{GA}$. Therefore, the vertices $B$ and $G$ are adjacent to $A$."}] [{:db/id #edb/ref 17592186105493 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105757 :knowledge-point/id #uuid "1ed0dc2a-7c76-5fee-9aa8-aad529cf1952" :knowledge-point/title "Identifying Parts of a Polygon"}] :question/id #uuid "33bf6630-1558-50b9-8823-0bd58d0787af" :question/math-academy-id "e-15618" :question/problem "What are the elements $\\overline{BD}$ and $A$ for the polygon below?\n\n![](images/51/514a59a0729844bf0424c67046667dcde5df6ecd7b9785a575fc4c2755bfaf28.png)" :question/worked-solution "The segment $\\overline{BD}$ joins two non-adjacent vertices of the polygon. Therefore, $\\overline{BD}$ is a diagonal.\n\nThe point $A$ is an endpoint of the sides $\\overline{AB}$ and $\\overline{FA}$. Hence, $A$ is a vertex."}] [{:db/id #edb/ref 17592186105494 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105755 :knowledge-point/id #uuid "0d25a77b-7977-50b2-b375-51b8539bc9b9" :knowledge-point/title "Determining the Type of a Polygon"}] :question/id #uuid "d56604cb-e46a-5d52-94c4-dea5e8c0df3b" :question/math-academy-id "e-15623" :question/problem "![](images/58/58750f7e4f747cd7be9f991316169c52a807647c42c7550ae869ac7505841c83.png)\n\nIs the polygon shown above (a) simple or complex, and (b) convex or concave?" :question/worked-solution "A polygon is **convex** if it has no internal angle larger than $180^\\circ$. In plain words, a convex polygon has no angles pointing inwards. Otherwise, the polygon is called **concave**.\n\nA polygon is **simple** if its boundary does not intersect itself. Otherwise, the polygon is called **complex**.\n\nIn our case, the polygon is\n\n- $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{simple}}$ since the boundary doesn't intersect itself, and\n- $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{concave}}$ since it has an angle pointing inwards."}] [{:db/id #edb/ref 17592186106192 :knowledge-point/_questions [{:db/id #edb/ref 17592186105754 :knowledge-point/id #uuid "b9fd1d3c-8479-5b35-abbc-9664cea2e1a8" :knowledge-point/title "Identifying a Polygon"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd5966c6-04b7-53bf-80f3-783493ca6ab6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hexagon" :db/id #edb/ref 17592186103029} {:answer/id #uuid "00c1dab6-1937-5e76-896a-59a1a8eedf2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A nonagon" :db/id #edb/ref 17592186103030} {:answer/id #uuid "0829ba2c-c204-5c5a-9156-02fc706488dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An octagon" :db/id #edb/ref 17592186103031} {:answer/id #uuid "08affddc-b231-5ade-872d-668e3ba36e81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A pentagon" :db/id #edb/ref 17592186103032} {:answer/id #uuid "7575698f-39ee-55bc-9ad5-778c461d1aa0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A decagon" :db/id #edb/ref 17592186103033}] :answer-field/id #uuid "6cc6809e-9622-5ba8-a548-9bd06456290d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186103028}] :question/id #uuid "cee70071-8675-59b5-af1f-a6a92931cfa4" :question/math-academy-id "q-21986" :question/problem "![](images/b3/b3596bf3c9146472a2e00fd751c3eac66dce6d11c821ca0860d3e67e4bccb871.png)\n\nWhat type of polygon is the figure shown above?"}] [{:db/id #edb/ref 17592186106195 :knowledge-point/_questions [{:db/id #edb/ref 17592186105754 :knowledge-point/id #uuid "b9fd1d3c-8479-5b35-abbc-9664cea2e1a8" :knowledge-point/title "Identifying a Polygon"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "894535e1-f8ae-5083-b33e-9001cb347b18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A heptagon" :db/id #edb/ref 17592186103047} {:answer/id #uuid "98b3dfde-18aa-5021-a9c2-0d97ad7da214" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hexagon" :db/id #edb/ref 17592186103048} {:answer/id #uuid "a6f85294-2f7f-5f12-9f7d-0cef37457624" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A pentagon" :db/id #edb/ref 17592186103049} {:answer/id #uuid "b4a86614-db32-5009-bcda-b18cfee7a48e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The figure is not a polygon" :db/id #edb/ref 17592186103050} {:answer/id #uuid "c9e6cf9d-4f90-54e0-a074-c52e05126ec6" :answer/type {:db/id #edb/ref 17592186045499 :db/i