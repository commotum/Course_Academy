b/ref 17592186045417] [17592186046673 #edb/ref 1004 #edb/ref 17592186046629 #edb/ref 17592186045417] [17592186046673 #edb/ref 1004 #edb/ref 17592186046630 #edb/ref 17592186045417] [17592186046673 #edb/ref 1004 #edb/ref 17592186046631 #edb/ref 17592186045417] [17592186046673 #edb/ref 1005 #edb/ref 17592186046688 #edb/ref 17592186045417] [17592186046673 #edb/ref 1005 #edb/ref 17592186046706 #edb/ref 17592186045417] [17592186046673 #edb/ref 1005 #edb/ref 17592186046800 #edb/ref 17592186045417] [17592186046673 #edb/ref 1005 #edb/ref 17592186046920 #edb/ref 17592186045417] [17592186046673 #edb/ref 1005 #edb/ref 17592186046937 #edb/ref 17592186045417] [17592186046673 #edb/ref 1005 #edb/ref 17592186046961 #edb/ref 17592186045417] [17592186046673 #edb/ref 1005 #edb/ref 17592186046979 #edb/ref 17592186045417] [17592186046673 #edb/ref 1007 "Methods of Proof" #edb/ref 17592186045417] [17592186046673 #edb/ref 1008 "This course introduces students to proof-writing essentials, bridging the gap between pure problem-solving and constructing formal mathematical arguments. Students will formalize their understanding of logic, sets, and functions while delving into new concepts such as congruence, relations, and cardinality.\nThis course serves as ideal preparation for students wishing to pursue undergraduate studies in formal mathematical disciplines, including Discrete Mathematics, Abstract Algebra, and Real Analysis.\nThe prerequisite for Methods of Proof is single-variable calculus, which would be satisfied by completion of either Calculus II, AP Calculus BC, or Mathematical Foundations III." #edb/ref 17592186045417] [17592186046673 #edb/ref 1009 "Students begin by mastering the basics of logic and logical operations, including statements, predicates, connectives, logical laws, logical equivalence, conditional and biconditional statements, quantifiers, inference, and formal and informal language. By solidifying their grasp of these logical fundamentals, students will have a secure underpinning that enables them to embark on their journey into proof-writing confidently.\nA robust knowledge of set theory is another cornerstone of mathematical proof-writing. Students will extend and formalize their understanding of sets and learn to translate between logical and set operations. By the end of the course, students will appreciate how set theory provides a comprehensive toolkit for proving mathematical results.\nAfter mastering these fundamentals, students will explore various proof-writing techniques, including direct proof, proof by cases, proof by contrapositive, proof by contradiction, disproof, and mathematical induction. The course emphasizes proving concepts related to parity, divisibility, congruence, sequences, functions, set identities, and relations. Students will have multiple opportunities to test and refine their proof construction and comprehension skills throughout the course and in varied contexts\nThis challenging yet engaging course helps students with strong mathematical foundations build a solid base for further progression into advanced undergraduate courses." #edb/ref 17592186045417] [17592186046673 #edb/ref 1012 76 #edb/ref 17592186045417] [17592186046673 #edb/ref 1013 "MOP" #edb/ref 17592186045417] [17592186046673 #edb/ref 1014 #uuid "53322b4c-7036-5cde-89d2-8e430f49ef2b" #edb/ref 17592186045417] [17592186048141 #edb/ref 1027 #edb/ref 17592186048196 #edb/ref 17592186045417] [17592186048141 #edb/ref 1027 #edb/ref 17592186048541 #edb/ref 17592186045417] [17592186048141 #edb/ref 1027 #edb/ref 17592186049094 #edb/ref 17592186045417] [17592186048141 #edb/ref 1027 #edb/ref 17592186050689 #edb/ref 17592186045417] [17592186048141 #edb/ref 1028 #edb/ref 17592186152166 #edb/ref 17592186045417] [17592186048141 #edb/ref 1028 #edb/ref 17592186152191 #edb/ref 17592186045417] [17592186048141 #edb/ref 1028 #edb/ref 17592186152223 #edb/ref 17592186045417] [17592186048141 #edb/ref 1031 "The Euclidean Algorithm" #edb/ref 17592186045417] [17592186048141 #edb/ref 1033 2676 #edb/ref 17592186045417] [17592186048141 #edb/ref 1035 #uuid "82ca0e31-666b-5e06-8d65-c724c2ffa4fb" #edb/ref 17592186045417] [17592186049024 #edb/ref 1028 #edb/ref 17592186161972 #edb/ref 17592186045417] [17592186049024 #edb/ref 1028 #edb/ref 17592186161973 #edb/ref 17592186045417] [17592186049024 #edb/ref 1028 #edb/ref 17592186161974 #edb/ref 17592186045417] [17592186049024 #edb/ref 1028 #edb/ref 17592186161975 #edb/ref 17592186045417] [17592186049024 #edb/ref 1031 "Linear Diophantine Equations" #edb/ref 17592186045417] [17592186049024 #edb/ref 1033 3082 #edb/ref 17592186045417] [17592186049024 #edb/ref 1035 #uuid "d4915fbb-3ba0-55bd-ad16-ce672a3ac557" #edb/ref 17592186045417] [17592186049094 #edb/ref 1027 #edb/ref 17592186049024 #edb/ref 17592186045417] [17592186049094 #edb/ref 1027 #edb/ref 17592186050558 #edb/ref 17592186045417] [17592186049094 #edb/ref 1027 #edb/ref 17592186050670 #edb/ref 17592186045417] [17592186049094 #edb/ref 1028 #edb/ref 17592186152163 #edb/ref 17592186045417] [17592186049094 #edb/ref 1028 #edb/ref 17592186152184 #edb/ref 17592186045417] [17592186049094 #edb/ref 1031 "The Extended Euclidean Algorithm" #edb/ref 17592186045417] [17592186049094 #edb/ref 1033 2677 #edb/ref 17592186045417] [17592186049094 #edb/ref 1035 #uuid "da0d77f1-bb5a-5589-bc40-e34367567aeb" #edb/ref 17592186045417] [17592186050558 #edb/ref 1027 #edb/ref 17592186048577 #edb/ref 17592186045417] [17592186050558 #edb/ref 1027 #edb/ref 17592186049978 #edb/ref 17592186045417] [17592186050558 #edb/ref 1028 #edb/ref 17592186198309 #edb/ref 17592186045417] [17592186050558 #edb/ref 1028 #edb/ref 17592186198310 #edb/ref 17592186045417] [17592186050558 #edb/ref 1028 #edb/ref 17592186198311 #edb/ref 17592186045417] [17592186050558 #edb/ref 1031 "Properties of Integer Divisibility" #edb/ref 17592186045417] [17592186050558 #edb/ref 1033 4433 #edb/ref 17592186045417] [17592186050558 #edb/ref 1035 #uuid "537a9014-df39-5285-bcbe-727d2aec6910" #edb/ref 17592186045417] [17592186050670 #edb/ref 1027 #edb/ref 17592186048603 #edb/ref 17592186045417] [17592186050670 #edb/ref 1027 #edb/ref 17592186048767 #edb/ref 17592186045417] [17592186050670 #edb/ref 1028 #edb/ref 17592186203912 #edb/ref 17592186045417] [17592186050670 #edb/ref 1028 #edb/ref 17592186203913 #edb/ref 17592186045417] [17592186050670 #edb/ref 1028 #edb/ref 17592186203914 #edb/ref 17592186045417] [17592186050670 #edb/ref 1031 "Multiplicative Inverses Modulo N" #edb/ref 17592186045417] [17592186050670 #edb/ref 1033 4818 #edb/ref 17592186045417] [17592186050670 #edb/ref 1035 #uuid "5da1bf0d-a741-59f5-981a-d9099d93b347" #edb/ref 17592186045417] [17592186151954 #edb/ref 1069 "e-6496" #edb/ref 17592186045417] [17592186151954 #edb/ref 1071 "Using the extended Euclidean algorithm, compute integers $u$ and $v$ such that $36u + 19v = \\text{gcd}(36,19).$ What is the value of $u+v?$" #edb/ref 17592186045417] [17592186151954 #edb/ref 1072 #uuid "df4647c2-73f7-57eb-b013-68d7f170266a" #edb/ref 17592186045417] [17592186151954 #edb/ref 1074 "We will use the extended Euclidean algorithm. First, we apply the forward reduction:\n\n$$\n\\begin{aligned}\\begin{aligned}36 & = & 19\\cdot 1 & + & 17 \\\\  & ↙ &  & ↙ &  \\\\ 19 & = & 17\\cdot 1 & + & 2 \\\\  & ↙ &  & ↙ &  \\\\ 17 & = & 2\\cdot 8 & + & 1\\end{aligned}\\end{aligned}\n$$\n\nAs a result, $\\text{gcd}(19,36) =1.$\n\nSolving for the remainders (the rightmost terms) in the equations above, up to (and including) the equation where the greatest common divisor appeared as a remainder, we get\n\n$$\n\\begin{aligned}17 & =36-19\\cdot 1 \\\\ 2 & =19-17 \\\\ 1 & =17-2\\cdot 8.\\end{aligned}\n$$\n\nThen, we back-substitute:\n\n$$\n\\begin{aligned}1 & =17-2\\cdot 8 \\\\  & =17-(19-17)\\cdot 8 \\\\  & =17\\cdot 9-19\\cdot 8 \\\\  & =[36-19]\\cdot 9-19\\cdot 8 \\\\  & =36\\cdot 9-19\\cdot 17 \\\\  & =36\\cdot 9+19\\cdot (-17)\\end{aligned}\n$$\n\nTherefore, $u=9,v=-17,$ and we can write\n\n$$\n1 = 36\\cdot \\bbox[2pt, lightgray]{9}  + 19\\cdot (\\bbox[2pt, lightgray]{-17}) .\n$$\n\nFinally, \n\n$$\nu+v=9+(-17)=-8.\n$$" #edb/ref 17592186045417] [17592186151981 #edb/ref 1069 "e-6763" #edb/ref 17592186045417] [17592186151981 #edb/ref 1071 "Using the extended Euclidean algorithm, compute integers $u$ and $v$ such that $30u + 8v = \\text{gcd}(30,8).$ What is the value of $u+v?$" #edb/ref 17592186045417] [17592186151981 #edb/ref 1072 #uuid "ed22bd9f-4dc9-528f-890f-2a81c4d353cd" #edb/ref 17592186045417] [17592186151981 #edb/ref 1074 "We will use the extended Euclidean algorithm. First, we apply the forward reduction:\n\n$$\n\\begin{aligned}\\begin{aligned}30 & = & 8\\cdot 3 & + & 6 \\\\  & ↙ &  & ↙ &  \\\\ 8 & = & 6\\cdot 1 & + & 2 \\\\  & ↙ &  & ↙ &  \\\\ 6 & = & 2\\cdot 3 & + & 0\\end{aligned}\\end{aligned}\n$$\n\nAs a result, $\\text{gcd}(30,8) =2.$\n\nSolving for the remainders (the rightmost terms) in the equations above, up to (and including) the equation where the greatest common divisor appeared as a remainder, we get\n\n$$\n\\begin{aligned}6 & =30-8\\cdot 3 \\\\ 2 & =8-6.\\end{aligned}\n$$\n\nThen, we back-substitute:\n\n$$\n\\begin{aligned}2 & =8-6 \\\\  & =8-(30-8\\cdot 3) \\\\  & =8\\cdot 4-30 \\\\  & =30\\cdot (-1)+8\\cdot 4\\end{aligned}\n$$\n\nTherefore, $u=-1$ and $v=4.$\n\nFinally, \n\n$$\nu+v=(-1)+4=3.\n$$" #edb/ref 17592186045417] [17592186152163 #edb/ref 1038 #edb/ref 17592186152752 #edb/ref 17592186045417] [17592186152163 #edb/ref 1038 #edb/ref 17592186152768 #edb/ref 17592186045417] [17592186152163 #edb/ref 1038 #edb/ref 17592186410992 #edb/ref 17592186045417] [17592186152163 #edb/ref 1038 #edb/ref 17592186410994 #edb/ref 17592186045417] [17592186152163 #edb/ref 1038 #edb/ref 17592186410995 #edb/ref 17592186045417] [17592186152163 #edb/ref 1038 #edb/ref 17592186410997 #edb/ref 17592186045417] [17592186152163 #edb/ref 1039 "Applying the Extended Euclidean Algorithm When the Two Numbers are Coprime" #edb/ref 17592186045417] [17592186152163 #edb/ref 1041 #edb/ref 17592186151954 #edb/ref 17592186045417] [17592186152163 #edb/ref 1042 #uuid "b6c5f369-1196-5ace-9450-815a4ee2cc8f" #edb/ref 17592186045417] [17592186152184 #edb/ref 1037 #edb/ref 17592186048141 #edb/ref 17592186045417] [17592186152184 #edb/ref 1038 #edb/ref 17592186152769 #edb/ref 17592186045417] [17592186152184 #edb/ref 1038 #edb/ref 17592186152791 #edb/ref 17592186045417] [17592186152184 #edb/ref 1038 #edb/ref 17592186410993 #edb/ref 17592186045417] [17592186152184 #edb/ref 1038 #edb/ref 17592186410996 #edb/ref 17592186045417] [17592186152184 #edb/ref 1039 "Applying the Extended Euclidean Algorithm When the Two Numbers are Not Coprime" #edb/ref 17592186045417] [17592186152184 #edb/ref 1041 #edb/ref 17592186151981 #edb/ref 17592186045417] [17592186152184 #edb/ref 1042 #uuid "4caf9fc6-9247-5807-84de-208b731116e7" #edb/ref 17592186045417] [17592186152344 #edb/ref 1043 #edb/ref 17592186153027 #edb/ref 17592186045417] [17592186152344 #edb/ref 1043 #edb/ref 17592186153065 #edb/ref 17592186045417] [17592186152344 #edb/ref 1043 #edb/ref 17592186153071 #edb/ref 17592186045417] [17592186152344 #edb/ref 1043 #edb/ref 17592186153099 #edb/ref 17592186045417] [17592186152344 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186152344 #edb/ref 1045 "The Extended Euclidean Algorithm" #edb/ref 17592186045417] [17592186152344 #edb/ref 1046 #edb/ref 17592186153071 #edb/ref 17592186045417] [17592186152344 #edb/ref 1049 #edb/ref 17592186049094 #edb/ref 17592186045417] [17592186152344 #edb/ref 1050 720.0 #edb/ref 17592186045417] [17592186152344 #edb/ref 1053 #uuid "79d375df-4e87-5b44-81dc-23c2a98b6b63" #edb/ref 17592186045417] [17592186152752 #edb/ref 1068 #edb/ref 17592186410985 #edb/ref 17592186045417] [17592186152752 #edb/ref 1069 "q-76861" #edb/ref 17592186045417] [17592186152752 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186152752 #edb/ref 1071 "Using the extended Euclidean algorithm, compute integers $u$ and $v$ such that $43u+17v=\\text{gcd}(43,17).$ What is the value of $u+v?$" #edb/ref 17592186045417] [17592186152752 #edb/ref 1072 #uuid "ed1e5e71-2e8a-56a4-872d-0a29ad0e0a2a" #edb/ref 17592186045417] [17592186152752 #edb/ref 1074 "We will use the extended Euclidean algorithm. First, we apply the forward reduction:\n\n$$\n\\begin{aligned}\\begin{aligned}43 & = & 17\\cdot 2 & + & 9 \\\\  & ↙ &  & ↙ &  \\\\ 17 & = & 9\\cdot 1 & + & 8 \\\\  & ↙ &  & ↙ &  \\\\ 9 & = & 8\\cdot 1 & + & 1\\end{aligned}\\end{aligned}\n$$\n\nAs a result, $\\text{gcd}(17,43)=1.$\n\nSolving for the remainders (the rightmost terms) in the equations above, we get\n\n$$\n\\begin{aligned}9 & =43-17\\cdot 2 \\\\ 8 & =17-9 \\\\ 1 & =9-8.\\end{aligned}\n$$\n\nThen, we back-substitute:\n\n$$\n\\begin{aligned}1 & =9-8 \\\\  & =9-(17-9) \\\\  & =9\\cdot 2-17 \\\\  & =[43-17\\cdot 2]\\cdot 2-17 \\\\  & =43\\cdot 2-17\\cdot 5 \\\\  & =43\\cdot 2+17\\cdot (-5)\\end{aligned}\n$$\n\nTherefore, $u=2$ and $v=-5.$\n\nFinally, \n\n$$\nu+v=2+(-5)=-3.\n$$" #edb/ref 17592186045417] [17592186152791 #edb/ref 1068 #edb/ref 17592186410991 #edb/ref 17592186045417] [17592186152791 #edb/ref 1069 "q-78470" #edb/ref 17592186045417] [17592186152791 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186152791 #edb/ref 1071 "Using the extended Euclidean algorithm, compute integers $u$ and $v$ such that $28u+16v=\\text{gcd}(28,16).$ What is the value of $u+v?$" #edb/ref 17592186045417] [17592186152791 #edb/ref 1072 #uuid "29de6c34-4477-5dd6-9882-390e0598c400" #edb/ref 17592186045417] [17592186152791 #edb/ref 1074 "We will use the extended Euclidean algorithm. First, we apply the forward reduction:\n\n$$\n\\begin{aligned}\\begin{aligned}28 & = & 16\\cdot 1 & + & 12 \\\\  & ↙ &  & ↙ &  \\\\ 16 & = & 12\\cdot 1 & + & 4 \\\\  & ↙ &  & ↙ &  \\\\ 12 & = & 4\\cdot 3 & + & 0\\end{aligned}\\end{aligned}\n$$\n\nAs a result, $\\text{gcd}(16,28)=4.$\n\nSolving for the remainders (the rightmost terms) in the equations above, we get\n\n$$\n\\begin{aligned}12 & =28-16 \\\\ 4 & =16-12.\\end{aligned}\n$$\n\nThen, we back-substitute:\n\n$$\n\\begin{aligned}4 & =16-12 \\\\  & =16-(28-16) \\\\  & =16\\cdot 2-28 \\\\  & =28\\cdot (-1)+16\\cdot 2\\end{aligned}\n$$\n\nTherefore, $u=-1$ and $v=2.$\n\nFinally, \n\n$$\nu+v=(-1)+2=1.\n$$" #edb/ref 17592186045417] [17592186153027 #edb/ref 1061 183906 #edb/ref 17592186045417] [17592186153027 #edb/ref 1062 #uuid "7e080049-7b49-599a-b9dd-9f6cd03fa661" #edb/ref 17592186045417] [17592186153027 #edb/ref 1063 #edb/ref 17592186153483 #edb/ref 17592186045417] [17592186153065 #edb/ref 1058 #edb/ref 17592186153027 #edb/ref 17592186045417] [17592186153065 #edb/ref 1061 23950 #edb/ref 17592186045417] [17592186153065 #edb/ref 1062 #uuid "a1c1eb96-adce-53a7-848d-bf42b0fb27f8" #edb/ref 17592186045417] [17592186153065 #edb/ref 1063 #edb/ref 17592186152163 #edb/ref 17592186045417] [17592186153071 #edb/ref 1058 #edb/ref 17592186153099 #edb/ref 17592186045417] [17592186153071 #edb/ref 1061 24052 #edb/ref 17592186045417] [17592186153071 #edb/ref 1062 #uuid "0dca946f-169d-57e2-88ac-167fa4ed7275" #edb/ref 17592186045417] [17592186153071 #edb/ref 1063 #edb/ref 17592186153360 #edb/ref 17592186045417] [17592186153099 #edb/ref 1058 #edb/ref 17592186153065 #edb/ref 17592186045417] [17592186153099 #edb/ref 1061 24976 #edb/ref 17592186045417] [17592186153099 #edb/ref 1062 #uuid "85cccd96-f97c-5a7c-b7a5-e3abb690a42e" #edb/ref 17592186045417] [17592186153099 #edb/ref 1063 #edb/ref 17592186152184 #edb/ref 17592186045417] [17592186153360 #edb/ref 1064 "For any two integers $a$ and $b,$ there exist integers $u$ and $v$ such that \n\n$$\nau+bv= \\textrm{gcd}(a,b).\n$$\n\nThis is known as **Bézout's identity**. \n\nTo find the integers $u$ and $v,$ we can use the **extended Euclidean algorithm**, which involves the following three steps:\n\n- Carry out the Euclidean algorithm to find $\\textrm{gcd}(a,b).$\n\n- Solve for the remainder at each step, up to (and including) the step where the greatest common divisor appeared as a remainder.\n\n- Back-substitute the remainders to reach the equation $au+bv= \\textrm{gcd}(a,b).$\n\nFor example, let's use the extended Euclidean algorithm to find integers $u$ and $v$ such that\n\n$$\n48u+18v= \\textrm{gcd}(48,18).\n$$\n\n- **Step 1:** First, we carry out the Euclidean algorithm to find $\\textrm{gcd}(48,18).$\n\n$$\n\\begin{aligned}\\begin{aligned}48 & = & 18\\cdot 2 & + & 12 \\\\  & ↙ &  & ↙ &  \\\\ 18 & = & 12\\cdot 1 & + & 6 \\\\  & ↙ &  & ↙ &  \\\\ 12 & = & 6\\cdot 2 & + & 0\\end{aligned}\\end{aligned}\n$$\n\nSo, we find that $\\text{gcd}(48,18) =6.$\n\n- **Step 2:** We solve for the remainder (the rightmost term) at each step, up to (and including) the step where the greatest common divisor appeared as an integer.\n\n$$\n\\begin{aligned}12 & =48-18\\cdot 2 \\\\ 6 & =18-12\\end{aligned}\n$$\n\n- **Step 3:** Finally, we back-substitute the remainders to reach the equation $48u+18v= 6.$\n\n$$\n\\begin{aligned}6 & =18-12 \\\\  & =18-(48-18\\cdot 2) \\\\  & =18-48+18\\cdot 2 \\\\  & =(18+18\\cdot 2)-48 \\\\  & =18\\cdot 3-48 \\\\  & =48\\cdot (-1)+18\\cdot (3)\\end{aligned}\n$$\n\nTherefore, $u=-1$ and $v=3.$" #edb/ref 17592186045417] [17592186153360 #edb/ref 1065 4024 #edb/ref 17592186045417] [17592186153360 #edb/ref 1066 #uuid "6f364b85-4d93-5a09-a174-dea640e1c448" #edb/ref 17592186045417] [17592186153360 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186153483 #edb/ref 1064 "Throughout this lesson we've made use of **Bézout's identity**, which states that for any two integers $a$ and $b,$ there exist integers $u$ and $v$ such that \n\n$$\nau+bv= \\textrm{gcd}(a,b).\n$$\n\nIt can also be shown that any integer combination of $a$ and $b$ is also a multiple of $\\textrm{gcd}(a,b).$ In other words, for *any* integers $u'$ and $v',$ we have\n\n$$\n\\textrm{gcd}(a,b) \\mid (au'+bv')\n$$\n\nMoreover, the set of integers \n\n$$\n\\big\\{  au'+bv' \\,:\\, u', v' \\in\\mathbb Z \\big \\}\n$$\n\ncontains *all* the multiples of $\\textrm{gcd}(a,b).$\n\nWe'll make use of these results in future lessons." #edb/ref 17592186045417] [17592186153483 #edb/ref 1065 9653 #edb/ref 17592186045417] [17592186153483 #edb/ref 1066 #uuid "9505be6e-ec53-5537-bf81-d4b7b197c384" #edb/ref 17592186045417] [17592186153483 #edb/ref 1067 "Final Remarks" #edb/ref 17592186045417] [17592186410944 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186410944 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186410944 #edb/ref 1083 #uuid "020f98df-ce27-5f83-a183-d790fdb0efb4" #edb/ref 17592186045417] [17592186410945 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186410945 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186410945 #edb/ref 1083 #uuid "025792a9-1418-5ed0-bd75-63fdf48048ad" #edb/ref 17592186045417] [17592186410946 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186410946 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186410946 #edb/ref 1083 #uuid "047f5cfa-c319-5769-a5d9-38ab5eac2e3f" #edb/ref 17592186045417] [17592186410947 #edb/ref 1080 "15" #edb/ref 17592186045417] [17592186410947 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186410947 #edb/ref 1083 #uuid "130c9d5f-a494-5201-9007-5c05a96b42e6" #edb/ref 17592186045417] [17592186410948 #edb/ref 1080 "-5" #edb/ref 17592186045417] [17592186410948 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186410948 #edb/ref 1083 #uuid "26070e7e-e2f2-538f-a981-409b7228a780" #edb/ref 17592186045417] [17592186410949 #edb/ref 1080 "-13" #edb/ref 17592186045417] [17592186410949 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186410949 #edb/ref 1083 #uuid "2709c658-cd3e-5e8b-b07f-16cf2388e15a" #edb/ref 17592186045417] [17592186410950 #edb/ref 1080 "-7" #edb/ref 17592186045417] [17592186410950 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186410950 #edb/ref 1083 #uuid "3132dcdb-547b-5f5a-85ac-f3d9b7acfe30" #edb/ref 17592186045417] [17592186410951 #ed