#{[{:db/id #edb/ref 17592186068517 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068889 :knowledge-point/id #uuid "10e3bbad-8260-56ae-b32d-0ee6f65d9404" :knowledge-point/title "Identifying Irreducible Rational Expressions"}] :question/id #uuid "dd115134-c197-57af-9e2c-fc15bd37e1fb" :question/math-academy-id "e-1522" :question/problem "What is $\\dfrac{x+2}{2x}$ reduced to lowest terms?" :question/worked-solution "The numerator and denominator have no common factors, so the expression can not be reduced. The expression\n\n$$\n\\dfrac{x+2}{2x}\n$$\n\nis already in lowest terms."}] [{:db/id #edb/ref 17592186068518 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068896 :knowledge-point/id #uuid "5343e220-8195-54a9-9cb2-8c188f97ece8" :knowledge-point/title "Simplifying Rational Expressions With Common Constant Factors"}] :question/id #uuid "9c3000e9-ed61-52d5-a2eb-c2cc75f4f843" :question/math-academy-id "e-1549" :question/problem "What is $\\dfrac {2x + 4} {2}$ reduced to lowest terms?" :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\n\\frac{2x + 4}{2} &= (2(x + 2))/(2) \\\\\n&= (2(x + 2))/(2 \\cdot 1) \\\\\n&= \\frac{x + 2}{1} \\\\\n&= x + 2\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068653 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068805 :knowledge-point/id #uuid "6a17d9d6-cd3a-554e-98d2-7e9536950bd0" :knowledge-point/title "Simplifying Rational Expressions With Common Factors"}] :question/id #uuid "3df1f00a-3a87-5db7-83c5-d47dce633bf9" :question/math-academy-id "e-843" :question/problem "Simplify the expression $\\dfrac {6y + 2} {3xy + x}$." :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\require{cancel} \\begin{aligned} \\dfrac {6y + 2} {3xy + x} &= \\dfrac {6y + 2} {x(3y + 1)} \\\\[5pt] &=\\dfrac {2(3y + 1)} {x(3y + 1)} \\\\[5pt] &=\\dfrac {2\\cancel{(3y + 1)}} {x \\cancel{(3y + 1)}} \\\\[5pt] &=\\dfrac {2} {x} \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068654 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068806 :knowledge-point/id #uuid "33c4c1eb-cee9-5b99-aa69-e8a6936f4ddb" :knowledge-point/title "Simplifying Rational Expressions With Longer Numerators and Denominators"}] :question/id #uuid "2504deea-3845-539a-b6d7-5c5ba7f7d042" :question/math-academy-id "e-844" :question/problem "Simplify $\\dfrac{5c + 10p - 20}{5p+15}$." :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\n\\frac{5c + 10p - 20}{5p + 15} &= (5(c + 2p - 4))/(5(p + 3)) \\\\\n&= (5(c + 2p - 4))/(5(p + 3)) \\\\\n&= \\frac{c + 2p - 4}{p + 3}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069326 :knowledge-point/_questions [{:db/id #edb/ref 17592186068806 :knowledge-point/id #uuid "33c4c1eb-cee9-5b99-aa69-e8a6936f4ddb" :knowledge-point/title "Simplifying Rational Expressions With Longer Numerators and Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f3610d0-82c7-59af-9408-a5df7cdd626f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186067127} {:answer/id #uuid "a396de35-a7aa-569e-970d-e89616f08c55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{ab - 4 + 5x}{5x + 4 - ab}" :db/id #edb/ref 17592186067128} {:answer/id #uuid "bbf62e80-bc68-55a9-b11c-6bac29a707dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2ab - 4 + 5x}{5x + 4 - ab}" :db/id #edb/ref 17592186067129} {:answer/id #uuid "ea225e04-b701-519d-9b4a-20fd1dddf2f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{ab - 2 + 5x}{5x + 2 - ab}" :db/id #edb/ref 17592186067130} {:answer/id #uuid "56418ee9-aab1-5d70-812e-9f03fd5a09e6" :answer/t