#{[{:db/id #edb/ref 17592186068517 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068889 :knowledge-point/id #uuid "10e3bbad-8260-56ae-b32d-0ee6f65d9404" :knowledge-point/title "Identifying Irreducible Rational Expressions"}] :question/id #uuid "dd115134-c197-57af-9e2c-fc15bd37e1fb" :question/math-academy-id "e-1522" :question/problem "What is $\\dfrac{x+2}{2x}$ reduced to lowest terms?" :question/worked-solution "The numerator and denominator have no common factors, so the expression can not be reduced. The expression \n\n$$\n\\dfrac{x+2}{2x}\n$$\n\n is already in lowest terms."}] [{:db/id #edb/ref 17592186068518 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068896 :knowledge-point/id #uuid "5343e220-8195-54a9-9cb2-8c188f97ece8" :knowledge-point/title "Simplifying Rational Expressions With Common Constant Factors"}] :question/id #uuid "9c3000e9-ed61-52d5-a2eb-c2cc75f4f843" :question/math-academy-id "e-1549" :question/problem "What is $\\dfrac {2x + 4} {2}$ reduced to lowest terms?" :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{2x+4}{2} & =\\frac{2(x+2)}{2} \\\\  & =\\frac{\\cancel{2}(x+2)}{\\cancel{2}\\cdot 1} \\\\  & =\\frac{x+2}{1} \\\\  & =x+2\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068653 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068805 :knowledge-point/id #uuid "6a17d9d6-cd3a-554e-98d2-7e9536950bd0" :knowledge-point/title "Simplifying Rational Expressions With Common Factors"}] :question/id #uuid "3df1f00a-3a87-5db7-83c5-d47dce633bf9" :question/math-academy-id "e-843" :question/problem "Simplify the expression $\\dfrac {6y + 2} {3xy + x}.$" :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\require{cancel}\n    \\eqalign{\n        \\dfrac {6y + 2} {3xy + x} &= \\dfrac {6y + 2} {x(3y + 1)} \\[5pt] \n        &=\\dfrac {2(3y + 1)} {x(3y + 1)} \\[5pt] \n        &=\\dfrac {2\\cancel{(3y + 1)} } {x \\cancel{(3y + 1)} } \\[5pt] \n        &=\\dfrac {2 } {x}\n    }\n$$"}] [{:db/id #edb/ref 17592186068654 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068806 :knowledge-point/id #uuid "33c4c1eb-cee9-5b99-aa69-e8a6936f4ddb" :knowledge-point/title "Simplifying Rational Expressions With Longer Numerators and Denominators"}] :question/id #uuid "2504deea-3845-539a-b6d7-5c5ba7f7d042" :question/math-academy-id "e-844" :question/problem "Simplify $\\dfrac{5c + 10p - 20}{5p+15}.$" :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n![](images/82/82b6ffda3164ec24147f28968a08f6d96bf64a2ec9aaf261f673c171dd1b1f40.svg)"}] [{:db/id #edb/ref 17592186480705 :knowledge-point/_questions [{:db/id #edb/ref 17592186068806 :knowledge-point/id #uuid "33c4c1eb-cee9-5b99-aa69-e8a6936f4ddb" :knowledge-point/title "Simplifying Rational Expressions With Longer Numerators and Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "434793c2-4c94-53a2-b3ee-72e68985a91b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-y+z}{5x-2z}" :db/id #edb/ref 17592186480223} {:answer/id #uuid "7b216b75-fc7c-518c-ad4c-36aba7cfb903" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5x-4y+z}{x-10z}" :db/id #edb/ref 17592186480314} {:answer/id #uuid "94ac5a7e-57b4-59ca-a495-cb030e027654" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-4y+z}{5x-10z}" :db/id #edb/ref 17592186480355} {:answer/id #uuid "aefa408c-720b-5bcc-a11e-8eec1419eb4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-y+z}{x-10z}" :db/id #edb/ref 17592186480405} {:answer/id #uuid "fd917c7a-ca93-523a-8d76-378ca14e5dfa" :answer/type {:db/id #edb/ref 175921860454