swer/value "2" :db/id #edb/ref 17592186067131} {:answer/id #uuid "34035bcc-ec0a-5a23-b0ee-87681ba4b93c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2ab-4+5x}{5x+4-ab}" :db/id #edb/ref 17592186480194} {:answer/id #uuid "7f499868-62a6-5e2f-89a0-0e07bb868c5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{ab-4+5x}{5x+4-ab}" :db/id #edb/ref 17592186480320} {:answer/id #uuid "cdfcff50-b6ec-570d-b23a-b25c7e356ff2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{ab-2+5x}{5x+2-ab}" :db/id #edb/ref 17592186480453}] :answer-field/correct {:answer/id #uuid "34035bcc-ec0a-5a23-b0ee-87681ba4b93c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2ab-4+5x}{5x+4-ab}" :db/id #edb/ref 17592186480194} :answer-field/id #uuid "feddab2c-3e80-5f6e-b21f-d2154451ceed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067126}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0a2dccaf-b1df-5708-a2e8-224ad657563a" :question/math-academy-id "q-41531" :question/problem "What is $\\frac{4ab-8+10x}{10x+8-2ab}$ reduced to its lowest terms?" :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\\frac{4ab-8+10x}{10x+8-2ab} & =\\frac{2(2ab-4+5x)}{2(5x+4-ab)} \\\\  & =\\frac{\\cancel{2}(2ab-4+5x)}{\\cancel{2}(5x+4-ab)} \\\\  & =\\frac{2ab-4+5x}{5x+4-ab}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186480645 :knowledge-point/_questions [{:db/id #edb/ref 17592186068805 :knowledge-point/id #uuid "6a17d9d6-cd3a-554e-98d2-7e9536950bd0" :knowledge-point/title "Simplifying Rational Expressions With Common Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uui