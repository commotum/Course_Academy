mmon.\n\n$$\n\\begin{aligned}\\frac{-4x+12}{3x-9} & =\\frac{-4(x-3)}{3(x-3)} \\\\  & =\\frac{-4\\cancel{(x-3)}}{3\\cancel{(x-3)}} \\\\  & =\\frac{-4}{3} \\\\  & =-\\frac{4}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069448 :knowledge-point/_questions [{:db/id #edb/ref 17592186068806 :knowledge-point/id #uuid "33c4c1eb-cee9-5b99-aa69-e8a6936f4ddb" :knowledge-point/title "Simplifying Rational Expressions With Longer Numerators and Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08f063aa-dc47-5edd-b3a5-1bf53dc6bc74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-b+5}{4b}" :db/id #edb/ref 17592186480127} {:answer/id #uuid "48a0a8ce-775f-557b-81a4-0e554ec7f541" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-4b+12}{20b}" :db/id #edb/ref 17592186480232} {:answer/id #uuid "48bc3c23-85b9-50d1-956f-75f7bad23407" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2a-b}{5b+2a}" :db/id #edb/ref 17592186480234} {:answer/id #uuid "9850e71e-ae25-5498-92cb-45193bf4d0c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2a+b-3}{5b-2a}" :db/id #edb/ref 17592186480361} {:answer/id #uuid "cef04d51-1635-5c15-8379-a61f7fa6b3e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2a-b+3}{5b+2a}" :db/id #edb/ref 17592186480459}] :answer-field/correct {:answer/id #uuid "cef04d51-1635-5c15-8379-a61f7fa6b3e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2a-b+3}{5b+2a}" :db/id #edb/ref 17592186480459} :answer-field/id #uuid "cff4074f-a20d-5947-b184-d220fa1100e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067858}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b52d4679-2ea8-5c78-b6e9-5e0952730137" :question/math-academy-id "q-57786" :question/problem "What is $\\frac{8a-4b+12}{20b+8a}$ reduced to its lowest terms?" :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\\frac{8a-4b+12}{20b+8a} & =\\frac{4(2a-b+3)}{4(5b+2a)} \\\\  & =\\frac{\\cancel{4}(2a-b+3)}{\\cancel{4}(5b+2a)} \\\\  & =\\frac{2a-b+3}{5b+2a}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186480685 :knowledge-point/_questions [{:db/id #edb/ref 17592186068889 :knowledge-point/id #uuid "10e3bbad-8260-56ae-b32d-0ee6f65d9404" :knowledge-point/title "Identifying Irreducible Rational Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04c8d53a-b5de-590b-ae2a-e5fb1dab6575" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-3}{7}" :db/id #edb/ref 17592186480118} {:answer/id #uuid "2da0627b-88a0-57c5-90e2-fd43bf2eb76c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5x+15}{7}" :db/id #edb/ref 17592186480183} {:answer/id #uuid "98b9cf1e-edfb-5a06-89ad-3883f2d39504" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+3}{2}" :db/id #edb/ref 17592186480362} {:answer/id #uuid "b3c8a364-a040-5b5e-8373-922911ef1c8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5x-15}{7}" :db/id #edb/ref 17592186480414} {:answer/id #uuid "c21e7762-0217-5fa6-978c-5e51b5f2a296" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+3}{7}" :db/id #edb/ref 17592186480433}] :answer-field/correct {:answer/id #uuid "2da0627b-88a0-57c5-90e2-fd43bf2eb76c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5x+15}{7}" :db/id #edb/ref 17592186480183} :answer-field/id #uuid "13f69c53-a9c3-5780-90af-406244f9484c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186480540}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b05961ea-7cec-59e4-8ae8-a6a605cc8a04" :question/math-academy-id "q-67296" :question/problem "$\\frac{5x+15}{7}=$" :question/worked-solution "The numerator and denominator have no common factors, so the expression can not be reduced. The expression \n\n$$\n\\frac{5x+15}{7}\n$$\n\n is already in lowest terms."}] [{:db/id #edb/ref 17592186480706 :knowledge-point/_questions [{:db/id #edb/ref 17592186068896 :knowledge-point/id #uuid "5343e220-8195-54a9-9cb2-8c188f97ece8" :knowledge-point/title "Simplifying Rational Expressions With Common Constant Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e9acd40-95b3-5aff-9205-34fd236fb525" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-3z}{2x+5z}" :db/id #edb/ref 17592186480185} {:answer/id #uuid "5720b5f6-2ce4-552c-a9cd-ca60386adebd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3z-x}{5z-2x}" :db/id #edb/ref 17592186480258} {:answer/id #uuid "777af3fd-32dc-59e7-b4bf-4bc7221fcd10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x+z}{5x-2z}" :db/id #edb/ref 17592186480305} {:answer/id #uuid "b1ab9072-682f-5a10-af55-512c22ddbc0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x-5z}{3x+z}" :db/id #edb/ref 17592186480410} {:answer/id #uuid "c6348dd8-c736-5d3a-a836-87968c06994b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+3z}{2x-5z}" :db/id #edb/ref 17592186480442}] :answer-field/correct {:answer/id #uuid "c6348dd8-c736-5d3a-a836-87968c06994b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+3z}{2x-5z}" :db/id #edb/ref 17592186480442} :answer-field/id #uuid "ef3cc7d5-745e-5237-ae37-a71278b0a918" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186480618}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f547ee15-afb9-5d4d-aac5-f9873224d21b" :question/math-academy-id "q-75356" :question/problem "What is $\\frac{3x+9z}{6x-15z}$ reduced to its lowest terms?" :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\\frac{3x+9z}{6x-15z} & =\\frac{3(x+3z)}{3(2x-5z)} \\\\  & =\\frac{\\cancel{3}\\cdot (x+3z)}{\\cancel{3}\\cdot (2x-5z)} \\\\  & =\\frac{x+3z}{2x-5z}\\end{aligned}\n$$"}]}
