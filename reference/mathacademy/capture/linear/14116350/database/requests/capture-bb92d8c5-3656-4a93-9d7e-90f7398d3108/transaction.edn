/validate]} {:db/id "answer-80e5b503-c1f3-55be-8dcc-bddf5095cdd8" :answer/id #uuid "80e5b503-c1f3-55be-8dcc-bddf5095cdd8" :answer/type :answer.type/math :answer/value "¬P∨¬Q" :db/ensure [:answer/validate]} {:db/id 17592186152052 :knowledge-point/questions ["question-bc8abf72-5929-5991-bf8d-19db968b0381" "question-e5ae3f5a-c838-553b-8c0d-d176aea1d388"] :db/ensure [:knowledge-point/validate]} {:db/id "question-bc8abf72-5929-5991-bf8d-19db968b0381" :question/id #uuid "bc8abf72-5929-5991-bf8d-19db968b0381" :question/math-academy-id "q-81400" :question/problem "$10$ is **not** divisible by $3$ or $4.$\n\nExpress the compound statement above in symbolic form given the following:\n\n- $P:10\\text{ is divisible by }3$\n\n- $Q:10\\text{ is divisible by }4$" :question/worked-solution "The given sentence is the negation of the following sentence: \n\n$10$ is divisible by $3$ or $4$, \n\nwhich can be expressed symbolically as $P∨Q.$\n\nThe negation is represented by the symbol \"$¬$\". \n\nTherefore, the given sentence is expressed symbolically as $¬(P∨Q).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-81e17c23-e75b-5224-95d3-5b0d550456c4"] :db/ensure [:question/validate]} {:db/id "answer-field-81e17c23-e75b-5224-95d3-5b0d550456c4" :answer-field/id #uuid "81e17c23-e75b-5224-95d3-5b0d550456c4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9beb2485-dd7e-565f-bf11-7179015d4947" :answer-field/choices ["answer-7371329d-96b6-51ea-bfe7-14de7b40abf6" "answer-9beb2485-dd7e-565f-bf11-7179015d4947" "answer-964b4c56-2ede-5a41-8d97-6bcfd3830f9d" "answer-cd5a65eb-c2e8-56a1-b5c7-79f43616d6f7" "answer-5cf34be5-c594-5496-aa61-41f145440bc7"] :db/ensure [:answer-field/validate]} {:db/id "answer-7371329d-96b6-51ea-bfe7-14de7b40abf6" :answer/id #uuid "7371329d-96b6-51ea-bfe7-14de7b40abf6" :answer/type :answer.type/math :answer/value "¬(P∧Q)" :db/ensure [:answer/validate]} {:db/id "answer-9beb2485-dd7e