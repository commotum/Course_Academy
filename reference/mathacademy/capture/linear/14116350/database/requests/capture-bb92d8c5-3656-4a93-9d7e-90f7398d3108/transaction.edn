-93c8-58ea-848f-ec99ae31061f" "answer-bf299fda-072c-544f-b29f-e8fcc1aa3744" "answer-72bcfa5c-5b94-5b39-8907-f5e55b173ceb"] :db/ensure [:answer-field/validate]} {:db/id "answer-b3a7f504-4ca7-5894-b89f-b544a051e640" :answer/id #uuid "b3a7f504-4ca7-5894-b89f-b544a051e640" :answer/type :answer.type/math :answer/value "P∧¬Q" :db/ensure [:answer/validate]} {:db/id "answer-29224407-55cf-551f-b649-9fde0ff90969" :answer/id #uuid "29224407-55cf-551f-b649-9fde0ff90969" :answer/type :answer.type/math :answer/value "P∨¬Q" :db/ensure [:answer/validate]} {:db/id "answer-70bc8ea3-93c8-58ea-848f-ec99ae31061f" :answer/id #uuid "70bc8ea3-93c8-58ea-848f-ec99ae31061f" :answer/type :answer.type/math :answer/value "¬(P∧Q)" :db/ensure [:answer/validate]} {:db/id "answer-bf299fda-072c-544f-b29f-e8fcc1aa3744" :answer/id #uuid "bf299fda-072c-544f-b29f-e8fcc1aa3744" :answer/type :answer.type/math :answer/value "¬(P∨Q)" :db/ensure [:answer/validate]} {:db/id "answer-72bcfa5c-5b94-5b39-8907-f5e55b173ceb" :answer/id #uuid "72bcfa5c-5b94-5b39-8907-f5e55b173ceb" :answer/type :answer.type/math :answer/value "¬P∨Q" :db/ensure [:answer/validate]} {:db/id 17592186152053 :knowledge-point/questions ["question-f8845516-a376-50cc-8625-12673b114608" "question-594bcd16-11e5-554c-954b-51c8f4ae33f3"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f8845516-a376-50cc-8625-12673b114608" :question/id #uuid "f8845516-a376-50cc-8625-12673b114608" :question/math-academy-id "q-182350" :question/problem "Find the missing values in the following truth table:" :question/worked-solution "First, we add a column for $¬B,$ where the truth values are opposite to the corresponding values in the column for $B.$ \n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,¬B\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n\nThen, we add a column for $A∧¬B.$ Remember that $A∧¬B$ is true if both $A$ and $¬B$ are true.\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,¬B\\,$ | $\\,A∧¬B\\,$ |\n| --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e14512f5-568b-572f-88e5-8b63aa118ca8" "answer-field-5660f069-31c9-5611-ada9-3b00eeb9abf2" "answer-field-7deb5fe1-b953-59ea-8d33-11d1bf079ff6" "answer-field-9689e0cd-e889-5811-9b2c-26c58d6abd6c"] :db/ensure [:question/validate]} {:db/id "answer-field-e14512f5-568b-572f-88e5-8b63aa118ca8" :answer-field/id #uuid "e14512f5-568b-572f-88e5-8b63aa118ca8" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-844e1f82-b2f7-50b6-a9e7-d4d1243f25fd" :answer-field/choices ["answer-844e1f82-b2f7-50b6-a9e7-d4d1243f25fd" "answer-68f75dcd-4b71-5caa-9634-a7a3ad02f645"] :db/ensure [:answer-field/validate]} {:db/id "answer-844e1f82-b2f7-50b6-a9e7-d4d1243f25fd" :answer/id #uuid "844e1f82-b2f7-50b6-a9e7-d4d1243f25fd" :answer/type :answer.type/math :answer/value "\\text{F}" :db/ensure [:answer/validate]} {:db/id "answer-68f75dcd-4b71-5caa-9634-a7a3ad02f645" :answer/id #uuid "68f75dcd-4b71-5caa-9634-a7a3ad02f645" :answer/type :answer.type/math :answer/value "\\text{T}" :db/ensure [:answer/validate]} {:db/id "answer-field-5660f069-31c9-5611-ada9-3b00eeb9abf2" :answer-field/id #uuid "5660f069-31c9-5611-ada9-3b00eeb9abf2" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-4633fe49-2c21-5720-a63c-558f45288fa2" :answer-field/choices ["answer-4a01d36c-4604-5b36-b3e3-00487d979e7f" "answer-4633fe49-2c21-5720-a63c-558f45288fa2"] :db/ensure [:answer-field/validate]} {:db/id "answer-4a01d36c-4604-5b36-b3e3-00487d979e7f" :answer/id #uuid "4a01d36c-4604-5b36-b3e3-00487d979e7