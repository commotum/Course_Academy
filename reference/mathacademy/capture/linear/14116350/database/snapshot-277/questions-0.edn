ficulty/easy} :question/id #uuid "f8845516-a376-50cc-8625-12673b114608" :question/math-academy-id "q-182350" :question/problem "Find the missing values in the following truth table:" :question/worked-solution "First, we add a column for $¬B,$ where the truth values are opposite to the corresponding values in the column for $B.$ \n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,¬B\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n\nThen, we add a column for $A∧¬B.$ Remember that $A∧¬B$ is true if both $A$ and $¬B$ are true.\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,¬B\\,$ | $\\,A∧¬B\\,$ |\n| --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |"}] [{:db/id #edb/ref 17592186410105 :knowledge-point/_questions [{:db/id #edb/ref 17592186152053 :knowledge-point/id #uuid "7c49d316-3552-5ace-a749-5070b64230c3" :knowledge-point/title "Completing a Truth Table for a Compound Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02a760ee-5936-56b4-bcc6-367c6cb4e864" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{F}" :db/id #edb/ref 17592186410063} {:answer/id #uuid "e236a867-6c27-5383-a8c6-c14b93397b44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186410090}] :answer-field/correct {:answer/id #uuid "e236a867-6c27-5383-a8c6-c14b93397b44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186410090} :answer-field/id #uuid "2fc94c3d-55a6-52a8-befa-23370d9ac2eb" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592