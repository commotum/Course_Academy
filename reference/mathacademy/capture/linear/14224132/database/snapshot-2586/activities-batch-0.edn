id #edb/ref 17592186493649} :answer-field/id #uuid "9835cbdd-388b-5e16-b9cf-513cf59b6548" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493851}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b22eb3b6-cc16-5099-ad8a-ae5922dfb11c" :question/math-academy-id "q-71378" :question/problem "Find the value of $\\sqrt[3]{7}\\cdot \\sqrt[3]{7}\\cdot \\sqrt[3]{7}.$" :question/worked-solution "First, we re-write the product using the cube:\n\n$$\n\\sqrt[3]{7}\\cdot \\sqrt[3]{7}\\cdot \\sqrt[3]{7}={(\\sqrt[3]{7})}^{3}.\n$$\n\nNow, we use that  the cube and the cube root cancel each other out. So, we have\n\n$$\n{(\\sqrt[3]{7})}^{3}=7.\n$$"} :step/id #uuid "3f477ff4-7ce6-533a-ba7c-94a7e1f09e6a" :step/next {:db/id #edb/ref 17592186494052}} {:db/id #edb/ref 17592186494000 :step/content {:db/id #edb/ref 17592186493925 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b2b486d-73e3-5ec6-ac68-69994e7b68cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-21" :db/id #edb/ref 17592186493438} {:answer/id #uuid "7ef8257f-9e98-5812-8092-de6ad2de950f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-63" :db/id #edb/ref 17592186493588} {:answer/id #uuid "82375256-a2e8-5f09-bbdb-698569d7440e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{13}" :db/id #edb/ref 17592186493598} {:answer/id #uuid "dc1212ea-cefa-5846-b0f6-b439fb9f4d0f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "63" :db/id #edb/ref 17592186493738} {:answer/id #uuid "dea1e379-3ea9-5bfb-aa61-5c45fab0e235" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186493742}] :answer-field/correct {:db/id #edb/ref 17592186493738} :answer-field/id #uuid "5d2d8695-caf2-581c-88dd-a821907a2ca2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493828}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4deafee5-88fa-505b-aa31-a2f75bd8228c" :question/math-academy-id "q-99298" :question/problem "Find the value of $\\sqrt[3]{63}\\cdot \\sqrt[3]{63}\\cdot \\sqrt[3]{63}.$" :question/worked-solution "First, we re-write the product using the cube:\n\n$$\n\\sqrt[3]{63}\\cdot \\sqrt[3]{63}\\cdot \\sqrt[3]{63}={(\\sqrt[3]{63})}^{3}.\n$$\n\nNow, recall that the cube and the cube root cancel each other out. So, we have\n\n$$\n{(\\sqrt[3]{63})}^{3}=63.\n$$"} :step/id #uuid "4cea7910-a3ab-51ed-a99d-fd7466fa173f"} {:db/id #edb/ref 17592186494052 :step/content {:db/id #edb/ref 17592186493906 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04b743d6-3d45-5c16-9c07-a408d2c7eef3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "59" :db/id #edb/ref 17592186493397} {:answer/id #uuid "510244b4-7b79-5b19-a98a-8dcbe14d1360" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "29" :db/id #edb/ref 17592186493520} {:answer/id #uuid "5e5fd0fd-7397-5a1f-9dc5-cad1c0b445ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "118" :db/id #edb/ref 17592186493535} {:answer/id #uuid "67186bb8-029a-5f75-a298-3dc073abede1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186493543} {:answer/id #uuid "f2190a5a-b47f-5733-bcf0-346a805a9263" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-59" :db/id #edb/ref 17592186493782}] :answer-field/correct {:db/id #edb/ref 17592186493397} :answer-field/id #uuid "60ec26c5-95dc-5c18-88f5-73306142deda" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493829}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2cb38511-839e-5fac-b7d9-ebdb7da5b4d2" :question/math-academy-id "q-99284" :question/problem "Find the value of $\\sqrt{59}\\cdot \\sqrt{59}.$" :question/worked-solution "First, we re-write the expression as a square:\n\n$$\n\\sqrt{59}\\cdot \\sqrt{59}={(\\sqrt{59})}^{2}.\n$$\n\nNow, recall that the square and the square root cancel each other out. So, we have\n\n$$\n{(\\sqrt{59})}^{2}=59.\n$$"} :step/id #uuid "ba7083de-c51b-5782-9d2c-3fe2e15ed9b0" :step/next {:db/id #edb/ref 17592186494000}}] :activity/title "Simplifying Expressions With Surds" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186493370}] [{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186074893} :activity/id #uuid "48334486-8ae7-5572-8e8f-b176d6318f35" :activity/scope {:db/id #edb/ref 17592186050138 :topic/id #uuid "2fda426e-c98b-5b36-800a-304f9ce90e0d" :topic/math-academy-id 554} :activity/steps [{:db/id #edb/ref 17592186074893 :step/content {:db/id #edb/ref 17592186075038 :tutorial/content "Let's take a look at the following equivalent ratios:\n\n![](images/6c/6cda61e0fbd0d9695644a29f0c6fa3478eae84cf253623da7f4b544f35873472.svg)\n\nWe can place the equivalent ratios in a **ratio table**, such as the one below. In a ratio table, each row represents a ratio.\n\n| ${\\color{blue}5}$ | ${\\color{red}10}$ |\n| --- | --- |\n| ${\\color{blue}10}$ | $\\bbox[3pt,Gainsboro]{\\color{red}\\textrm{?}}$ |\n| ${\\color{blue}20}$ | ${\\color{red}40}$ |\n\nOne number is missing. Let's figure out what it is.\n\nWe start with the ratio ${\\color{blue}5}:{\\color{red}10},$ which is the first ratio in the table. Writing this ratio as a fraction, we have\n\n$$\n\\dfrac{{\\color{blue}5}}{{\\color{red}10}}.\n$$\n\nThe numerator represents the left-hand entry (${\\color{blue}5}$), and the denominator represents the right-hand entry (${\\color{red}10}$).\n\nTo find the missing number, we need to make a numerator of ${\\color{blue}10}.$ We can do this by multiplying the numerator and denominator by $2$:\n\n$$\n\\begin{aligned}\\frac{5\\times 2}{10\\times 2} & =\\frac{10}{20}\\end{aligned}\n$$\n\nWe now add this to our ratio table:\n\n| ${\\color{blue}5}$ | ${\\color{red}10}$ |\n| --- | --- |\n| ${\\color{blue}10}$ | $\\bbox[3pt,Gainsboro]{\\color{red}20}$ |\n| ${\\color{blue}20}$ | ${\\color{red}40}$ |\n\nSo, the missing number is $\\color{red}20.$" :tutorial/id #uuid "ca7b3d51-7281-5705-bed5-276f34939c25" :tutorial/math-academy-id 8357 :tutorial/title "Introduction"} :step/id #uuid "ac8583b6-39eb-5a51-9b51-c3c4ebec13fa" :step/math-academy-id 81656 :step/next {:db/id #edb/ref 17592186074894}} {:db/id #edb/ref 17592186074894 :step/content {:db/id #edb/ref 17592186073894 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073453 :question/id #uuid "8e2f5bec-3573-5f1d-9870-41ac26b1ddf2" :question/math-academy-id "e-13342"} :knowledge-point/id #uuid "b9357cc9-e383-5d88-9741-f49f6fbcca99" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049733} {:db/id #edb/ref 17592186050481}] :knowledge-point/questions [{:db/id #edb/ref 17592186074048} {:db/id #edb/ref 17592186074049} {:db/id #edb/ref 17592186455472} {:db/id #edb/ref 17592186455473}] :knowledge-point/title "Filling a Ratio Table by Multiplying: Missing Denominators"} :step/id #uuid "f054590d-449e-5753-b1fc-569c01699cad" :step/math-academy-id 81657 :step/next {:db/id #edb/ref 17592186074895}} {:db/id #edb/ref 17592186074895 :step/content {:db/id #edb/ref 17592186073895 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073455 :question/id #uuid "e2ada4db-c1f0-53b0-9af7-ee2712ae75ef" :question/math-academy-id "e-13409"} :knowledge-point/id #uuid "6e3287b0-2ecb-5d83-9596-7943d68f8884" :knowledge-point/questions [{:db/id #edb/ref 17592186074024} {:db/id #edb/ref 17592186074384} {:db/id #edb/ref 17592186455446} {:db/id #edb/ref 17592186455501} {:db/id #edb/ref 17592186538941}] :knowledge-point/title "Filling a Ratio Table by Multiplying: Missing Numerators"} :step/id #uuid "aab5d8f4-9d49-5c7f-9619-01557ca3969b" :step/math-academy-id 81660 :step/next {:db/id #edb/ref 17592186074896}} {:db/id #edb/ref 17592186074896 :step/content {:db/id #edb/ref 17592186073896 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073454 :question/id #uuid "11fac5c9-ca4a-54a6-9f38-3c675411673e" :question/math-academy-id "e-13343"} :knowledge-point/id #uuid "60021495-9d2a-58a5-9321-bb16013bbba7" :knowledge-point/questions [{:db/id #edb/ref 17592186073996} {:db/id #edb/ref 17592186074050} {:db/id #edb/ref 17592186455439} {:db/id #edb/ref 17592186455465} {:db/id #edb/ref 17592186533991}] :knowledge-point/title "Filling a Ratio Table by Multiplying and Dividing"} :step/id #uuid "bd74231b-139c-5091-8fd3-66103c7f1329" :step/math-academy-id 81663 :step/next {:db/id #edb/ref 17592186074897}} {:db/id #edb/ref 17592186074897 :step/content {:db/id #edb/ref 17592186073897 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073456 :question/id #uuid "f1a6757d-3e68-5263-a6c7-d03c73391848" :question/math-academy-id "e-13410"} :knowledge-point/id #uuid "84a526bf-9d98-54e1-a54e-cd625bbaea49" :knowledge-point/questions [{:db/id #edb/ref 17592186074385} {:db/id #edb/ref 17592186074398} {:db/id #edb/ref 17592186455467} {:db/id #edb/ref 17592186455502}] :knowledge-point/title "Word Problems"} :step/id #uuid "b13509a4-8a23-5240-a77b-f79cb3691c99" :step/math-academy-id 81666}] :activity/title "Ratio Tables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073973}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186139326} :activity/id #uuid "7b28ec1f-d603-58bd-8b19-a4b5ae532d10" :activity/scope {:db/id #edb/ref 17592186050315 :topic/id #uuid "3f453bac-6f10-55b6-9795-7cf9ac76659e" :topic/math-academy-id 2240} :activity/steps [{:db/id #edb/ref 17592186139305 :step/content {:db/id #edb/ref 17592186138394 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138299 :question/id #uuid "571f96ea-2c3c-55e6-b776-9009301d8d9e" :question/math-academy-id "e-4778"} :knowledge-point/id #uuid "638d891b-f2c9-505e-99a6-9c15fbf6df5a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050358} {:db/id #edb/ref 17592186050404}] :knowledge-point/questions [{:db/id #edb/ref 17592186139157} {:db/id #edb/ref 17592186139158} {:db/id #edb/ref 17592186476939} {:db/id #edb/ref 17592186476956} {:db/id #edb/ref 17592186536855}] :knowledge-point/title "Separating a Square Root Into a Quotient of Two Square Roots"} :step/id #uuid "be8f78e1-4021-5706-815d-35b712aee1e1" :step/math-academy-id 17374 :step/next {:db/id #edb/ref 17592186139306}} {:db/id #edb/ref 17592186139306 :step/content {:db/id #edb/ref 17592186138395 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138300 :question/id #uuid "96cf1739-aa80-574d-900e-3ff75517cfe9" :question/math-academy-id "e-4779"} :knowledge-point/id #uuid "afa8c578-f074-5c70-a6d8-7ad3fb059961" :knowledge-point/questions [{:db/id #edb/ref 17592186139155} {:db/id #edb/ref 17592186139156} {:db/id #edb/ref 17592186476901} {:db/id #edb/ref 17592186476934} {:db/id #edb/ref 17592186476952} {:db/id #edb/ref 17592186476965} {:db/id #edb/ref 17592186539012}] :knowledge-point/title "Writing a Quotient of Two Square Roots as a Single Square Root"} :step/id #uuid "16b49c7f-043e-5aeb-9d10-cd74f7f3ddf8" :step/math-academy-id 17375 :step/next {:db/id #edb/ref 17592186139307}} {:db/id #edb/ref 17592186139307 :step/content {:db/id #edb/ref 17592186138396 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138301 :question/id #uuid "f0bfcf6d-08a2-5dc4-b66c-814445c05e76" :question/math-academy-id "e-4780"} :knowledge-point/id #uuid "6d8f0211-cd1a-5a01-9422-2e3e475599ed" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048770}] :knowledge-point/questions [{:db/id #edb/ref 17592186139159} {:db/id #edb/ref 17592186139160} {:db/id #edb/ref 17592186476878} {:db/id #edb/ref 17592186476917}] :knowledge-point/title "The Quotient Rule With Cube Roots"} :step/id #uuid "c1d5b8d5-8593-5e6a-84da-d4aaea527af8" :step/math-academy-id 17376} {:db/id #edb/ref 17592186139326 :step/content {:db/id #edb/ref 17592186139644 :tutorial/content "To divide square roots, we simply divide the numbers under the root. This is called the **quotient rule for radicals**.\n\nTo demonstrate, let's simplify the expression $\\dfrac{ \\sqrt{10} }{ \\sqrt{2} }$ by applying the quotient rule:\n\n$$\n\\dfrac{ \\sqrt{10} }{ \\sqrt{2} } = \\sqrt{ \\dfrac{10}{2} } = \\sqrt{5}\n$$\n\nThe quotient rule also works for cube roots. For example,\n\n$$\n\\dfrac{ \\sqrt[3]{10} }{ \\sqrt[3]{2} } = \\sqrt[3]{ \\dfrac{10}{2} } = \\sqrt[3]{5}\n$$\n\nIn general, the quotient rule works for any quotient of $n$th roots. So for any $n,$ we have\n\n$$\n\\dfrac{ \\sqrt[n]{10} }{ \\sqrt[n]{2} } = \\sqrt[n]{ \\dfrac{10}{2} } = \\sqrt[n]{5}.\n$$\n\n**Watch out!** We cannot use the quotient rule when we have the quotient of different radicals, such as square roots and cube roots. For example, the expression $\\dfrac{ \\sqrt{10} }{ \\sqrt[3]{5} }$ cannot be simplified because the radicals $\\sqrt{\\phantom{x}}$ and $\\sqrt[3]{\\phantom{x}}$ are different." :tutorial/id #uuid "6ea49118-4345-575a-a14f-9aedade211d4" :tutorial/math-academy-id 3297 :tutorial/title "Introduction"} :step/id #uuid "7e0565a6-cf26-5e4b-8bc5-c3de10c211d9" :step/math-academy-id 18177 :step/next {:db/id #edb/ref 17592186139305}}] :activity/title "The Quotient Rule for Radicals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186138594}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055883} :activity/id #uuid "105911a6-a8fa-5b40-bf5e-8a3845e590dc" :activity/scope {:db/id #edb/ref 17592186050613 :topic/id #uuid "58d4d7b7-4b91-5e3c-ba04-7522d5cfa8f6" :topic/math-academy-id 40} :activity/steps [{:db/id #edb/ref 17592186055883 :step/content {:db/id #edb/ref 17592186056009 :tutorial/content "Let's suppose that we want to solve an equation like \n\n$$\n\\dfrac x 6 = 4.\n$$\n\nFor this, we can use the **multiplication principle.** The multiplication principle tells us that multiplying (or dividing) both sides of an equation by the same number does not change its solution.\n\nIn this case, the variable $x$ is being *divided* by $6.$ To isolate $x$, we can perform the *opposite* operation, which is *multiplying* by $6$. So, we multiply both sides of the equation by $6.$\n\n$$\n\\eqalign{\n\t\t\\dfrac x 6 \t\t\t\t\t&= 4 \\[5pt]\n\t\t{\\color{blue}{6}} \\cdot \\dfrac x 6  \t&= {\\color{blue}{6}}\\cdot 4\\[5pt]\n\t\t\\dfrac{6x}{6}\t\t\t&=24\\[5pt]\n\t}\n$$\n\n \n\nNow, we can cancel a common factor of $6$ from both the numerator and denominator.\n\n$$\n\\eqalign{\n\t\t\\dfrac{6x}{6}\t\t\t&=24 \\\n\t\t\\dfrac{ \\cancel{6} x}{\\cancel{6} }\t\t\t&=24 \\\n\t\tx\t\t\t\t&=24\n\t}\n$$\n\n \n\nThus, our solution is $x=24.$ Let's check that this solution is correct by plugging it back into the original equation:\n\n$$\n\\eqalign{\n    \t\t\\dfrac x 6 &=4 \\[5pt]\n    \t\t\\dfrac{24}{6} &=4 \\[5pt]\n\t\t4 &= 4 \\; {\\color{green}{\\checkmark}}\n\t}\n$$" :tutorial/id #uuid "66f28923-eb93-5bc0-b870-b4316258a3c8" :tutorial/math-academy-id 8052 :tutorial/title "Introduction"} :step/id #uuid "85cdcdec-1c60-5ac5-8e3f-e25e47c0bb28" :step/math-academy-id 72101 :step/next {:db/id #edb/ref 17592186055884}} {:db/id #edb/ref 17592186055884 :step/content {:db/id #edb/ref 17592186054834 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054381 :question/id #uuid "c64cd16e-2f9d-5564-8d04-eddcad2c5d01" :question/math-academy-id "e-12859"} :knowledge-point/id #uuid "4007f63e-0a99-57ca-a1f6-190b21f02ecc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050414} {:db/id #edb/ref 17592186050599}] :knowledge-point/questions [{:db/id #edb/ref 17592186055151} {:db/id #edb/ref 17592186055443} {:db/id #edb/ref 17592186479855} {:db/id #edb/ref 17592186479893}] :knowledge-point/title "Linear Equations Requiring Multiplication by a Positive Integer"} :step/id #uuid "036eee4c-d08b-5bac-82ff-0d8314f256ca" :step/math-academy-id 72102 :step/next {:db/id #edb/ref 17592186055885}} {:db/id #edb/ref 17592186055885 :step/content {:db/id #edb/ref 17592186054835 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054388 :question/id #uuid "cbce1708-81ba-5d37-ae21-fc8d94ebbc2f" :question/math-academy-id "e-12894"} :knowledge-point/id #uuid "b765f7b2-639a-5519-9170-02a4fcb0f8fe" :knowledge-point/questions [{:db/id #edb/ref 17592186054940} {:db/id #edb/ref 17592186055290} {:db/id #edb/ref 17592186479828} {:db/id #edb/ref 17592186479865}] :knowledge-point/title "Cases Where the Variable Is on the Right-Hand Side"} :step/id #uuid "f810611a-c93d-5ca0-8ad1-26bd885d89c1" :step/math-academy-id 72105 :step/next {:db/id #edb/ref 17592186055886}} {:db/id #edb/ref 17592186055886 :step/content {:db/id #edb/ref 17592186056010 :tutorial/content "In order to remove a negative sign from our variable, we can multiply both sides by $-1$. This way, the two negatives will cancel out to form a positive. \n\nFor example, suppose that we have the equation\n\n$$\n-x = 3\n$$\n\nWe can isolate $x$ by multiplying both sides of the equation by $-1,$ as follows:\n\n$$\n\\begin{aligned}-x & =3 \\\\ (-1)\\cdot (-x) & =(-1)\\cdot 3 \\\\ x & =-3\\end{aligned}\n$$\n\nTherefore, the solution to the equation is $x=-3.$ Let's check to see that this works by substituting our solution back into the original equation.\n\n$$\n\\begin{aligned}-x & =3 \\\\ -(-3) & =3 \\\\ 3 & =3\\,✓\\end{aligned}\n$$" :tutorial/id #uuid "7de479d1-5bb2-5cc9-9fdc-117a02790cab" :tutorial/math-academy-id 8053 :tutorial/title "Removing a Negative Sign from a Variable"} :step/id #uuid "91e35f06-1502-52eb-91c6-d755a826ebfc" :step/math-academy-id 72108 :step/next {:db/id #edb/ref 17592186055887}} {:db/id #edb/ref 17592186055887 :step/content {:db/id #edb/ref 17592186054836 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054382 :question/id #uuid "5fe35108-2fa8-563e-862e-ad27d4ed5334" :question/math-academy-id "e-12860"} :knowledge-point/id #uuid "712bc4c6-aeaf-5081-9e64-791027b38963" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049349}] :knowledge-point/questions [{:db/id #edb/ref 17592186055291} {:db/id #edb/ref 17592186055420} {:db/id #edb/ref 17592186479831} {:db/id #edb/ref 17592186479882} {:db/id #edb/ref 17592186538937}] :knowledge-point/title "Linear Equations Requiring Multiplication by a Negative Integer"} :step/id #uuid "fe58020e-d340-5fac-88b2-1c50209326d9" :step/math-academy-id 72109 :step/next {:db/id #edb/ref 17592186055888}} {:db/id #edb/ref 17592186055888 :step/content {:db/id #edb/ref 17592186056011 :tutorial/content "To solve an equation like $7x = 21$, we again need to look at what's happening to the variable and ask ourselves what the opposite operation is.\n\nIn this case, the variable $x$ is being *multiplied* by $7.$ To isolate $x$, we can perform the *opposite* operation, which is *dividing* by $7$. So, we divide both sides of the equation by $7.$\n\n$$\n\\eqalign{\n\t\t7x &= 21 \\[5pt]\n\t\t\\dfrac{7x}{{\\color{blue}7}} &=\\dfrac{21}{{\\color{blue}7}}\n\t}\n$$\n\n \n\nNow, we can cancel a common factor of $7$ from both the numerator and denominator.\n\n$$\n\\eqalign{\n\t\t\\dfrac{7x}{{\\color{blue}7}} &=\\dfrac{21}{{\\color{blue}7}}\\[5pt]\n\t\t\\dfrac{\\cancel{7}x}{\\cancel{\\color{blue}7}} &=3 \\[5pt]\n\t\tx &=3\n\t}\n$$\n\n \n\nLet's check that our answer is correct by plugging it back into the original equation:\n\n$$\n\\eqalign{\n    \t\t7x &=21 \\[5pt]\n    \t\t7(3) &=21 \\[5pt]\n\t\t21 &= 21 \\; {\\color{green}{\\checkmark}}\n\t}\n$$\n\n**Note:** If there is a negative coefficient on a variable, we can get rid of it by dividing, like we do with positive coefficients. For example:\n\n$$\n\\begin{aligned}-2y & =10 \\\\ \\frac{-2y}{-2} & =\\frac{10}{-2} \\\\ \\frac{\\cancel{-2}y}{\\cancel{-2}} & =-5 \\\\ y & =-5\\end{aligned}\n$$" :tutorial/id #uuid "1a74f63d-cfcc-5a3f-899c-6b15cfa2247f" :tutorial/math-academy-id 8054 :tutorial/title "Using the Multiplication Principle to Divide"} :step/id #uuid "afb3bda0-823e-547e-bb19-4e9d28f09976" :step/math-academy-id 72112 :step/next {:db/id #edb/ref 17592186055889}} {:db/id #edb/ref 17592186055889 :step/content {:db/id #edb/ref 17592186054837 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054383 :question/id #uuid "68865bc2-e4e2-53d9-9988-4fa962e04746" :question/math-academy-id "e-12861"} :knowledge-point/id #uuid "e153c18d-6f3e-5fef-a006-c5597cd88bc9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050719}] :knowledge-point/questions [{:db/id #edb/ref 17592186055033} {:db/id #edb/ref 17592186055274} {:db/id #edb/ref 17592186479844} {:db/id #edb/ref 17592186479891}] :knowledge-point/title "Linear Equations Requiring Division"} :step/id #uuid "1b859cff-8545-5c6f-9fc0-22c30fff2c3b" :step/math-academy-id 72113}] :activity/title "Solving One-Step Multiplication and Division Equations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054901}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186101701} :activity/id #uuid "c33f4447-9a4b-5add-a4c9-995ef344ed21" :activity/scope {:db/id #edb/ref 17592186050697 :topic/id #uuid "5faccef4-6874-58a8-9306-2498a05448ef" :topic/math-academy-id 1224} :activity/steps [{:db/id #edb/ref 17592186101697 :step/content {:db/id #edb/ref 17592186100884 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100706 :question/id #uuid "d5f71763-77dd-5758-bf77-a927b42bae5e" :question/math-academy-id "e-4651"} :knowledge-point/id #uuid "da02158c-c59e-5639-9d0c-625c0ff285e0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050668}] :knowledge-point/questions [{:db/id #edb/ref 17592186101506} {:db/id #edb/ref 17592186101518} {:db/id #edb/ref 17592186481361} {:db/id #edb/ref 17592186481435} {:db/id #edb/ref 17592186538973}] :knowledge-point/title "Applying the Power Rule With Positive Integer Exponents"} :step/id #uuid "e66d16bb-63ca-5f42-9fb6-5c998c1c1dfb" :step/math-academy-id 17013 :step/next {:db/id #edb/ref 17592186101813}} {:db/id #edb/ref 17592186101698 :step/content {:db/id #edb/ref 17592186100885 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100707 :question/id #uuid "0cdd6749-d069-5500-8cec-e581ff67c389" :question/math-academy-id "e-4652"} :knowledge-point/id #uuid "78d619d2-620e-539c-b9e2-89a7bb832722" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050495}] :knowledge-point/questions [{:db/id #edb/ref 17592186101508} {:db/id #edb/ref 17592186101520} {:db/id #edb/ref 17592186481384} {:db/id #edb/ref 17592186481386} {:db/id #edb/ref 17592186490267} {:db/id #edb/ref 17592186490305}] :knowledge-point/title "Applying the Power Rule With Negative Integer Exponents and Formatting the Result"} :step/id #uuid "c7c9ea1d-6c99-509e-a3c4-2bed9dd181b6" :step/math-academy-id 17014} {:db/id #edb/ref 17592186101701 :step/content {:db/id #edb/ref 17592186101969 :tutorial/content "To raise a power to another power, we multiply the exponents. This is the **power rule for exponents**. \n\nTo demonstrate, let's simplify the expression $\\left( 3^5\\right)^4$ by applying the power rule:\n\n$$\n\\left( 3^5\\right)^4 = 3^{5\\cdot 4} = 3^{20}\n$$\n\n**Note:** The power rule for exponents is just a quicker alternative to using repeated multiplication, as follows:\n\n$$\n\\begin{aligned}{({3}^{5})}^{4} & = \\\\ {{{3}^{5}\\times {3}^{5}\\times {3}^{5}\\times {3}^{5}}_{⏟}}_{4\\text{ copies}} & = \\\\ {3}^{5+5+5+5} & = \\\\ {3}^{5\\cdot 4} & = \\\\ {3}^{20}\\end{aligned}\n$$" :tutorial/id #uuid "77fdb9f8-30b1-5d1a-bc9d-feb500358913" :tutorial/math-academy-id 3270 :tutorial/title "Introduction"} :step/id #uuid "189dcb57-8b33-5690-bfb8-3d4a2e5f4099" :step/math-academy-id 17994 :step/next {:db/id #edb/ref 17592186101697}} {:db/id #edb/ref 17592186101813 :step/content {:db/id #edb/ref 17592186100960 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100802 :question/id #uuid "4ede067b-672d-5366-928f-45f42e3aec19" :question/math-academy-id "e-9982"} :knowledge-point/id #uuid "ce6cafca-522d-5949-b5d2-4d13060bf7a8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049349}] :knowledge-point/questions [{:db/id #edb/ref 17592186101100} {:db/id #edb/ref 17592186101519} {:db/id #edb/ref 17592186481387} {:db/id #edb/ref 17592186481426} {:db/id #edb/ref 17592186490276}] :knowledge-point/title "Applying the Power Rule With Negative Integer Exponents"} :step/id #uuid "191b9302-8a78-5f1f-9a30-3a6369c726fd" :step/math-academy-id 37597 :step/next {:db/id #edb/ref 17592186101698}}] :activity/title "The Power Rule for Exponents" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186101076}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186490341} :activity/id #uuid "091fddbe-ab7c-51fb-bdea-75d771ea6a5f" :activity/scope {:db/id #edb/ref 17592186050697 :topic/id #uuid "5faccef4-6874-58a8-9306-2498a05448ef" :topic/math-academy-id 1224} :activity/steps [{:db/id #edb/ref 17592186490340 :step/content {:db/id #edb/ref 17592186490305 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c40c928-474e-5fcd-96e6-d0ce3aef77a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "256" :db/id #edb/ref 17592186489692} {:answer/id #uuid "68e74ddf-5b48-58b7-a653-55ecc87fcc23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{64}" :db/id #edb/ref 17592186489766} {:answer/id #uuid "9d3ad9ee-c476-5e5a-a69b-52fd8a0b2b1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{256}" :db/id #edb/ref 17592186489865} {:answer/id #uuid "b94c40cc-5cbd-5681-955d-1efa9075e827" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186489923} {:answer/id #uuid "caa97124-d2a3-5455-acf8-11d5f0b9b929" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186489957}] :answer-field/correct {:db/id #edb/ref 17592186489692} :answer-field/id #uuid "d9514d09-69aa-5aee-8c9d-3e1f675180bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490188}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d02b196c-7964-5a35-ad18-39ecb861ac94" :question/math-academy-id "q-100388" :question/problem "${({(\\frac{1}{2})}^{2})}^{-4}=$" :question/worked-solution "To raise a power to another power, we simply multiply the exponents:\n\n$$\n{({(\\frac{1}{2})}^{2})}^{-4}={(\\frac{1}{2})}^{2\\cdot (-4)}={(\\frac{1}{2})}^{-8}\n$$\n\nTo evaluate ${(\\frac{1}{2})}^{-8},$ we find the reciprocal of the base $\\frac{1}{2}$ and then raise that reciprocal to the same power but with the opposite sign:\n\n$$\n{(\\frac{1}{2})}^{-8}={2}^{8}=256\n$$"} :step/id #uuid "1d161361-c4ef-544c-9c41-fd9074b5fa81" :step/next {:db/id #edb/ref 17592186490362}} {:db/id #edb/ref 17592186490341 :step/content {:db/id #edb/ref 17592186490267 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "278d6804-ad2c-5ac9-91da-3ca3b0cbce26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{27}" :db/id #edb/ref 17592186489603} {:answer/id #uuid "3611d283-6e25-5dfb-a7c1-0f1ff407d90f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "27" :db/id #edb/ref 17592186489637} {:answer/id #uuid "573bfd75-87ea-5d70-bdde-ef0ae1843642" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186489721} {:answer/id #uuid "9f868f94-e3de-577d-92ae-da3eee235b05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "81" :db/id #edb/ref 17592186489870} {:answer/id #uuid "a8c08e11-f0f2-5824-87af-6581abace820" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{81}" :db/id #edb/ref 17592186489886}] :answer-field/correct {:db/id #edb/ref 17592186489870} :answer-field/id #uuid "8fa31cc5-aeb2-5e41-85d6-b3e606e5acfa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490156}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "79c1f428-3f0c-56d7-8ace-b8cfe3cf2061" :question/math-academy-id "q-68375" :question/problem "${({3}^{-1})}^{-4}=$" :question/worked-solution "To raise a power to another power, we simply multiply the exponents and evaluate:\n\n$$\n{({3}^{-1})}^{-4}={3}^{(-1)\\cdot (-4)}={3}^{4}=81\n$$"} :step/id #uuid "243a0607-354b-5e54-9ae1-54b0c3abe028" :step/next {:db/id #edb/ref 17592186490340}} {:db/id #edb/ref 17592186490362 :step/content {:db/id #edb/ref 17592186490276 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34d16f9e-d2cd-5b44-a4c0-add6f7687996" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{9}^{12}" :db/id #edb/ref 17592186489632} {:answer/id #uuid "4f31c31f-2b4b-5d8f-8a51-982f370660e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{9}^{-7}" :db/id #edb/ref 17592186489702} {:answer/id #uuid "686a2273-2853-5f5d-8366-8009f3d02fa4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{9}^{-1}" :db/id #edb/ref 17592186489764} {:answer/id #uuid "7e7cf3b8-2ba4-5a59-b901-ba6c46527100" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{9}^{7}" :db/id #edb/ref 17592186489800} {:answer/id #uuid "8ee6a70b-b616-56be-8bcf-73082f37284e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{9}^{-12}" :db/id #edb/ref 17592186489839}] :answer-field/correct {:db/id #edb/ref 17592186489839} :answer-field/id #uuid "f14a87c0-d612-5439-9dd2-088dab25a966" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490201}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "978d0300-c7f9-5a68-9e89-1cdeb54f80bf" :question/math-academy-id "q-141293" :question/problem "${({9}^{-4})}^{3}=$" :question/worked-solution "To raise a power to another power, we simply multiply the exponents:\n\n$$\n{({9}^{-4})}^{3}={9}^{(-4)\\cdot 3}={9}^{-12}\n$$"} :step/id #uuid "7debbce3-5913-5b36-9d69-98ef3aba1e4d"}] :activity/title "The Power Rule for Exponents" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186489500}]}
