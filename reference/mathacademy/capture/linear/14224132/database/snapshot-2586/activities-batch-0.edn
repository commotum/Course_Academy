 96} :activity/steps [{:db/id #edb/ref 17592186492973 :step/content {:db/id #edb/ref 17592186492867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dab20d8-435c-5874-9820-b9c7777aa63b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186492238} {:answer/id #uuid "23606116-0c3d-57f4-9d18-6b22a6023384" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186492290} {:answer/id #uuid "a1fdf384-9dc0-54c1-8ead-ad298d903b8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186492542} {:answer/id #uuid "cabd6727-7e51-5b45-af79-5c74ca0fead2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186492621} {:answer/id #uuid "fb1e9546-e023-51f6-b4d3-475e7aee4ad8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186492700}] :answer-field/correct {:db/id #edb/ref 17592186492238} :answer-field/id #uuid "cc5e42ce-3f11-5ff2-b5ec-1401d70485f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492787}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "63dd321a-10a4-552c-a65d-35ddf70e7775" :question/math-academy-id "q-61447" :question/problem "If $x=-2$ then $|x+3|-|3x-1|+x=$" :question/worked-solution "We substitute $x=-2$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|x+3|-|3x-1|+x & = \\\\ |-2+3|-|3(-2)-1|+(-2) & = \\\\ |1|-|-6-1|-2 & = \\\\ |1|-|-7|-2 & = \\\\ 1-7-2 & = \\\\ -8 & \\end{aligned}\n$$"} :step/id #uuid "99842b79-76db-5fb3-bbaf-66d05b3bbff6" :step/next {:db/id #edb/ref 17592186492988}} {:db/id #edb/ref 17592186492988 :step/content {:db/id #edb/ref 17592186492854 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d45f977-a56a-5280-89d6-5518e60df5dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186492275} {:answer/id #uuid "59218a65-4882-5870-b7c8-86f2679e51b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186492393} {:answer/id #uuid "9f2ed906-57e2-5ab3-bd06-a081c49eed93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "41" :db/id #edb/ref 17592186492529} {:answer/id #uuid "a1b41a41-e6b5-57fd-8c0d-4ddb0799752c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186492540} {:answer/id #uuid "b55f6a79-05b0-5b79-92d7-0fdbb4341b3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "29" :db/id #edb/ref 17592186492581}] :answer-field/correct {:db/id #edb/ref 17592186492540} :answer-field/id #uuid "eb93eac8-5e68-5a3c-9c7e-30e76a8c37ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492807}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "42db367f-fca9-5107-a4d2-7795dc6e4fc0" :question/math-academy-id "q-103235" :question/problem "Evaluate $|{x}^{2}|-2|x|+6$ for $x=-5.$" :question/worked-solution "We substitute $x=-5$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|{x}^{2}|-2|x|+6 & = \\\\ |(-5)^{2}|-2|-5|+6 & = \\\\ |25|-2(5)+6 & = \\\\ 25-10+6 & = \\\\ 21 & \\end{aligned}\n$$"} :step/id #uuid "b5660f48-4d6b-5934-ad67-9281c24d90f3"} {:db/id #edb/ref 17592186493004 :step/content {:db/id #edb/ref 17592186492855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fde7be7-c167-5669-9a0e-b5b44e3f124c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186492280} {:answer/id #uuid "54f5373f-0023-5804-abbc-0d46f9f86a86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186492378} {:answer/id #uuid "693a8a82-a0bc-5675-8d14-e1888aae079e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186492426} {:answer/id #uuid "b3421362-8e23-5e85-ae83-5b52d5e44df5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186492575} {:answer/id #uuid "e01edf29-ecf9-53cc-bc5d-84c6e77d2648" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-14" :db/id #edb/ref 17592186492652}] :answer-field/correct {:db/id #edb/ref 17592186492652} :answer-field/id #uuid "cef39244-d4ac-5c09-b904-ef69c6554e61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492789}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "46b75057-d4db-5536-a016-1c597f33ff13" :question/math-academy-id "q-25403" :question/problem "If $x=-9$ then $-|x-12|+7=$" :question/worked-solution "We substitute $x=-9$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}-|x-12|+7 & = \\\\ -|-9-12|+7 & = \\\\ -|-21|+7 & = \\\\ -21+7 & = \\\\ -14\\end{aligned}\n$$"} :step/id #uuid "f304f3f8-e188-5590-8410-c6b111d1b2ca" :step/next {:db/id #edb/ref 17592186492973}}] :activity/title "Absolute Value Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186492217}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186539090} :activity/id #uuid "e6236cb7-b333-595b-87b9-895ea4f220f1" :activity/scope {:db/id #edb/ref 17592186049844 :topic/id #uuid "181a217b-aefb-5b16-abf7-81644bd30ca2" :topic/math-academy-id 96} :activity/steps [{:db/id #edb/ref 17592186539042 :step/content {:db/id #edb/ref 17592186539026 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f530b9-512a-59c4-b8dc-f3b975a5f9af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186538250}] :answer-field/correct {:db/id #edb/ref 17592186538250} :answer-field/id #uuid "259bb8b7-b747-5b79-8d8c-16284cc398a3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186538821}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f4d3cdfc-97df-54f6-9ee5-ecd71be4d0bd" :question/math-academy-id "q-215802" :question/problem "If $x=2,$ then $|x+1{|}^{2}-|x-1{|}^{3}+2=${{field-1}}." :question/worked-solution "We substitute $x=2$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|x+1{|}^{2}-|x-1{|}^{3}+2 & = \\\\ |2+1{|}^{2}-|2-1{|}^{3}+2 & = \\\\ |3{|}^{2}-|1{|}^{3}+2 & = \\\\ {3}^{2}-{1}^{3}+2 & = \\\\ 9-1+2 & = \\\\ 10 & \\end{aligned}\n$$"} :step/id #uuid "1b023f9e-0298-554e-be5a-bf787e7e1d6c" :step/next {:db/id #edb/ref 17592186539052}} {:db/id #edb/ref 17592186539052 :step/content {:db/id #edb/ref 17592186538971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da4845bf-1401-512a-8c52-28302042301c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186538733}] :answer-field/correct {:db/id #edb/ref 17592186538733} :answer-field/id #uuid "ea38a251-ab23-5c87-abfe-28a8670ee8a6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186538912}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6a42fde9-ed9b-5e9d-86c6-940fc99b7d25" :question/math-academy-id "q-215803" :question/problem "If $y=0,$ then $|2y+3{|}^{3}-|y+2|=${{field-1}}." :question/worked-solution "We substitute $y=0$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|2y+3{|}^{3}-|y+2| & = \\\\ |2(0)+3{|}^{3}-|0+2| & = \\\\ |0+3{|}^{3}-|0+2| & = \\\\ |3{|}^{3}-|2| & = \\\\ {3}^{3}-2 & = \\\\ 27-2 & = \\\\ 25 & \\end{aligned}\n$$"} :step/id #uuid "3291a708-b56a-592b-9ee3-bf5079c19589"} {:db/id #edb/ref 17592186539084 :step/content {:db/id #edb/ref 17592186538949 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b62c904-4d93-5e91-8fcd-3d63b312cd13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186538293} {:answer/id #uuid "543e9569-ebcc-52ee-b615-3c6d09b84d55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186538415} {:answer/id #uuid "5cb9b356-5932-53cb-a1f6-0aeb3ef4cb11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186538431} {:answer/id #uuid "d1540b6d-345a-5120-8ab5-0582cc400a53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186538717} {:answer/id #uuid "e404cb10-11b0-59fe-9d87-fdcbd419c82f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186538752}] :answer-field/correct {:db/id #edb/ref 17592186538431} :answer-field/id #uuid "52c1e553-d74d-59fd-a539-db479dc23184" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538846}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3e848dbc-438d-5d9d-8de6-41c96328b31b" :question/math-academy-id "q-131806" :question/problem "If $x=2$ then $|3-{2}^{x}|+4=$" :question/worked-solution "We substitute $x=2$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|3-{2}^{x}|+4 & = \\\\ |3-{2}^{2}|+4 & = \\\\ |3-4|+4 & = \\\\ |-1|+4 & = \\\\ 1+4 & = \\\\ 5\\end{aligned}\n$$"} :step/id #uuid "a08163e8-a307-5f7d-8731-fa1cbf7422a3" :step/next {:db/id #edb/ref 17592186539103}} {:db/id #edb/ref 17592186539090 :step/content {:db/id #edb/ref 17592186538969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18a638e8-6cda-5be6-a77d-f20d9d4443b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186538288} {:answer/id #uuid "18f4ba97-b8dc-5324-888d-a39a7e05bc49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186538290} {:answer/id #uuid "310cbe50-de0c-523d-89e2-0bff3267c529" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186538331} {:answer/id #uuid "3cdc4bb2-5d9e-5596-97e3-5781ff5e4c86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186538357} {:answer/id #uuid "a07da073-1567-54b2-ab82-80e4aeed8938" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186538615}] :answer-field/correct {:db/id #edb/ref 17592186538290} :answer-field/id #uuid "e60f0809-006d-5d59-8100-1de6658c3ea0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538911}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "68630caf-af8f-50ee-bc03-18c9657f8cb4" :question/math-academy-id "q-103238" :question/problem "Evaluate $|x-5|-|3-x|+2$ for $x=8.$" :question/worked-solution "We substitute $x=8$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|x-5|-|3-x|+2 & = \\\\ |8-5|-|3-8|+2 & = \\\\ |3|-|-5|+2 & = \\\\ 3-5+2 & = \\\\ 0 & \\end{aligned}\n$$"} :step/id #uuid "b0b38d0b-0e33-50a6-903b-f2396119b21a" :step/next {:db/id #edb/ref 17592186539084}} {:db/id #edb/ref 17592186539103 :step/content {:db/id #edb/ref 17592186539001 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24a75248-37a5-5151-b8cb-0f5575576d3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186538306}] :answer-field/correct {:db/id #edb/ref 17592186538306} :answer-field/id #uuid "4149acf6-bd2b-5cdb-9109-58f31fcedb99" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186538836}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b8991b67-f1ef-53f9-975f-0551777dc4d1" :question/math-academy-id "q-212313" :question/problem "If $x=1,$ then $3-|{2}^{-x}-\\frac{5}{2}|=${{field-1}}." :question/worked-solution "We substitute $x=1$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}3-|{2}^{-x}-\\frac{5}{2}| & = \\\\ 3-|{2}^{-1}-\\frac{5}{2}| & = \\\\ 3-|\\frac{1}{2}-\\frac{5}{2}| & = \\\\ 3-|-2| & = \\\\ 3-2 & = \\\\ 1\\end{aligned}\n$$"} :step/id #uuid "d775aea7-e108-5ef4-9f6e-296230133d2c" :step/next {:db/id #edb/ref 17592186539042}}] :activity/title "Absolute Value Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186538231}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186129942} :activity/id #uuid "7f8b0621-460a-5fd0-a97f-1010b71e6fd3" :activity/scope {:db/id #edb/ref 17592186049861 :topic/id #uuid "195298b7-de92-5cff-8e4c-30e6040a95db" :topic/math-academy-id 2012} :activity/steps [{:db/id #edb/ref 17592186129935 :step/content {:db/id #edb/ref 17592186129110 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128922 :question/id #uuid "5c179a8e-55f3-5be7-8e97-b54287ea23e3" :question/math-academy-id "e-4668"} :knowledge-point/id #uuid "8aab5653-c3ec-5b4e-b56f-53393955d641" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049714}] :knowledge-point/questions [{:db/id #edb/ref 17592186129826} {:db/id #edb/ref 17592186129830} {:db/id #edb/ref 17592186479057} {:db/id #edb/ref 17592186479143}] :knowledge-point/title "Applying the Power of Product Rule"} :step/id #uuid "fcae326c-6edf-5bae-84ae-a001e5da8818" :step/math-academy-id 17139 :step/next {:db/id #edb/ref 17592186129936}} {:db/id #edb/ref 17592186129936 :step/content {:db/id #edb/ref 17592186129111 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128923 :question/id #uuid "ee165665-5cf3-5343-bae6-9080a887fcd6" :question/math-academy-id "e-4669"} :knowledge-point/id #uuid "525486fb-d976-57a5-b6bd-c33f19177a3f" :knowledge-point/questions [{:db/id #edb/ref 17592186129827} {:db/id #edb/ref 17592186129828} {:db/id #edb/ref 17592186479058} {:db/id #edb/ref 17592186479098} {:db/id #edb/ref 17592186539005}] :knowledge-point/title "Applying the Power of Product Rule to Expressions with Fractions"} :step/id #uuid "56deb814-d1c1-54cd-97bd-ffe38566dc3e" :step/math-academy-id 17140 :step/next {:db/id #edb/ref 17592186129937}} {:db/id #edb/ref 17592186129937 :step/content {:db/id #edb/ref 17592186129112 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128924 :question/id #uuid "10d598e9-cbcf-5681-b500-b046e2ec27ca" :question/math-academy-id "e-4670"} :knowledge-point/id #uuid "a47a8902-eb6f-5d07-8e91-36796d1c6295" :knowledge-point/questions [{:db/id #edb/ref 17592186129829} {:db/id #edb/ref 17592186129831} {:db/id #edb/ref 17592186479137} {:db/id #edb/ref 17592186536867}] :knowledge-point/title "Applying the Power of Product Rule to Expressions with Negative Numbers"} :step/id #uuid "824f067a-aafa-5691-a971-7a05644aa56b" :step/math-academy-id 17141} {:db/id #edb/ref 17592186129942 :step/content {:db/id #edb/ref 17592186130340 :tutorial/content "To raise the product of two numbers to a power, we can raise each number to that power, and then multiply. This is the **power of product rule for exponents**. \n\nTo demonstrate, let's simplify the expression $(5 \\times 3)^4$ by applying the power of product rule:\n\n$$\n(5\\times 3)^4=5^4\\times 3^4\n$$\n\n**Note:** The power of product rule for exponents is really just a quicker alternative to using repeated multiplication, as follows:\n\n$$\n\\begin{aligned}(5\\times 3)^{4} & = \\\\ {{(5\\times 3)\\times (5\\times 3)\\times (5\\times 3)\\times (5\\times 3)}_{⏟}}_{4\\text{ copies}} & = \\\\ {{(5\\times 5\\times 5\\times 5)}_{⏟}}_{4\\text{ copies}}\\times {{(3\\times 3\\times 3\\times 3)}_{⏟}}_{4\\text{ copies}} & = \\\\ {5}^{4}\\times {3}^{4}\\end{aligned}\n$$" :tutorial/id #uuid "79b0e407-5948-563e-a8af-5dbcd3ab59f3" :tutorial/math-academy-id 3272 :tutorial/title "Introduction"} :step/id #uuid "308748b1-5bd7-5b3a-94ef-bd3c9df25cfe" :step/math-academy-id 17996 :step/next {:db/id #edb/ref 17592186129935}}] :activity/title "The Power of Product Rule for Exponents" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186129355}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074901} :activity/id #uuid "71a6f31c-0bb8-5061-8779-9e3b7984d66e" :activity/scope {:db/id #edb/ref 17592186049868 :topic/id #uuid "19c222a3-03e5-5eb1-b6c2-e026705f9eda" :topic/math-academy-id 573} :activity/steps [{:db/id #edb/ref 17592186074898 :step/content {:db/id #edb/ref 17592186073898 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073587 :question/id #uuid "fb5d2269-5350-5d79-9414-1a25caa48d8c" :question/math-academy-id "e-2647"} :knowledge-point/id #uuid "1d9b6948-92f4-58b3-8c06-fae61765dc57" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049688} {:db/id #edb/ref 17592186050517}] :knowledge-point/questions [{:db/id #edb/ref 17592186074463} {:db/id #edb/ref 17592186074466} {:db/id #edb/ref 17592186441866} {:db/id #edb/ref 17592186441867} {:db/id #edb/ref 17592186441869} {:db/id #edb/ref 17592186441871} {:db/id #edb/ref 17592186538992}] :knowledge-point/title "Finding the Horizontal Distance Between Two Points"} :step/id #uuid "123d2929-5563-5b7e-8588-e7734bb4eb42" :step/math-academy-id 8890 :step/next {:db/id #edb/ref 17592186074899}} {:db/id #edb/ref 17592186074899 :step/content {:db/id #edb/ref 17592186073899 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073588 :question/id #uuid "1250785a-1ae3-5218-925a-0eac01281f3f" :question/math-academy-id "e-2648"} :knowledge-point/id #uuid "f0708cd3-0608-5d57-ac14-4c16ef362473" :knowledge-point/questions [{:db/id #edb/ref 17592186074465} {:db/id #edb/ref 17592186074467} {:db/id #edb/ref 17592186441863} {:db/id #edb/ref 17592186441864} {:db/id #edb/ref 17592186441872} {:db/id #edb/ref 17592186441873} {:db/id #edb/ref 17592186495146} {:db/id #edb/ref 17592186495173} {:db/id #edb/ref 17592186525009} {:db/id #edb/ref 17592186527128} {:db/id #edb/ref 17592186527138}] :knowledge-point/title "Finding the Vertical Distance Between Two Points"} :step/id #uuid "f954535e-e2c6-5a01-85b8-f90fdccafc1b" :step/math-academy-id 8891 :step/next {:db/id #edb/ref 17592186074902}} {:db/id #edb/ref 17592186074900 :step/content {:db/id #edb/ref 17592186073900 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073589 :question/id #uuid "e05457af-60c5-519f-935e-db465fc76efa" :question/math-academy-id "e-2649"} :knowledge-point/id #uuid "83bbdad9-c2a5-5caa-a4e9-2a0c904c605b" :knowledge-point/questions [{:db/id #edb/ref 17592186074468} {:db/id #edb/ref 17592186074469} {:db/id #edb/ref 17592186441865} {:db/id #edb/ref 17592186441868} {:db/id #edb/ref 17592186441870} {:db/id #edb/ref 17592186495116} {:db/id #edb/ref 17592186527153} {:db/id #edb/ref 17592186527168} {:db/id #edb/ref 17592186531593}] :knowledge-point/title "Finding the Distance Between Two Points: Crossing the Axis"} :step/id #uuid "3a335606-3bdb-5535-8956-9a3ababd7eb1" :step/math-academy-id 8892} {:db/id #edb/ref 17592186074901 :step/content {:db/id #edb/ref 17592186074978 :tutorial/content "The distance between two points in the coordinate plane is the number of units between them. Let's explore two methods for calculating the horizontal distance between two points with the points $(1,1)$ and $(5,1).$\n\n**Method 1** \n\nThe distance between two points is the length of the line segment that connects them.\n\nFirst, we plot the given points in the coordinate plane.\n\n![](images/19/196c50295e8d8a95084c31226fb9319ede7b70603d894b6939e4615df583c29c.png)\n\nFrom the diagram, we see that the length of the segment is $4$ units, so the distance equals $4.$\n\n![](images/4b/4b531e29616f3e8d7ea0c65761e59cfea224b9c0e756c68b7647c7271dc09493.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $y$-axis and then subtracting.\n\n![](images/6d/6d5c6760e15098dc381e639cd806b6410f2fa6d9049d11d5467427635c9872b6.png)\n\nThe point $({\\color{blue}{1}},1)$ is at a distance of $\\color{blue}{1}$ from the $y$-axis, and the point $({\\color{red}{5}},1)$ is at a distance of $\\color{red}{5}$ from the $y$-axis. Therefore, the distance between the two points is ${\\color{red}{5}} - {\\color{blue}{1}} = 4.$" :tutorial/id #uuid "aeee8d0d-20f6-5700-8c35-c66e0eef8daa" :tutorial/math-academy-id 2199 :tutorial/title "Introduction"} :step/id #uuid "1961bdcc-cea7-5d78-88c1-4f69e1dab833" :step/math-academy-id 8895 :step/next {:db/id #edb/ref 17592186074898}} {:db/id #edb/ref 17592186074902 :step/content {:db/id #edb/ref 17592186074979 :tutorial/content "When we want to find the distance between two points in different quadrants, method 1 works exactly the same, but method 2 is slightly different.\n\nWe can find the distance between the two points by finding the distance of each point from the $y$-axis for a horizontal distance, or $x$-axis for a vertical distance, and then *adding*. \n\nSo, what's the distance between $(-3,2)$ and $(1,2)?$\n\n**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/e0/e0fec8fca43b421b62efc3d6d892563c80beaab3c2816be47aa7563868555268.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $4$ units, so the distance equals $4.$\n\n![](images/dd/ddc1e6cec323fe245ff2a115a587e773d408dc0115ba5002c02ac1d238620c63.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $y$-axis and then adding.\n\n![](images/0b/0bbb91fc8c0e7ad577261dcdbc8e7aaa16a44e8be2e937e2d6870aae58af4ccf.png)\n\nThe point $({\\color{blue}{1}},2)$ is at a distance of $\\color{blue}{1}$ from the $y$-axis, and the point $({\\color{red}{-3}},2)$ is at a distance of $\\color{red}{3}$ from the $y$-axis. Therefore, the distance between the two points is ${\\color{red}{3}} + {\\color{blue}{1}} = 4.$" :tutorial/id #uuid "a1233efd-87e1-5707-9b70-24c24ed47418" :tutorial/math-academy-id 2204 :tutorial/title "The Distance Between Two Points in Different Quadrants"} :step/id #uuid "d97c5e30-e125-5cba-9973-1e1898eca20e" :step/math-academy-id 8947 :step/next {:db/id #edb/ref 17592186074900}}] :activity/title "Distances Between Points in the Coordinate Plane" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073991}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186495267} :activity/id #uuid "4ad6406f-28ca-5b57-94e6-4b4cc6fef04e" :activity/scope {:db/id #edb/ref 17592186049868 :topic/id #uuid "19c222a3-03e5-5eb1-b6c2-e026705f9eda" :topic/math-academy-id 573} :activity/steps [{:db/id #edb/ref 17592186495237 :step/content {:db/id #edb/ref 17592186495116 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bdc2701-e79a-5b33-86a6-ef27722a55d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186494506} {:answer/id #uuid "6822bf50-caeb-554f-938f-a5cc8683af71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186494526} {:answer/id #uuid "80300fbe-d90a-591a-928d-9196db5a2240" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186494596} {:answer/id #uuid "b85c490c-92e9-5030-a0f6-291132b15fa4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186494748} {:answer/id #uuid "dceb000c-8083-5f83-9e97-ae002b6b6ba1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186494841}] :answer-field/correct {:db/id #edb/ref 17592186494506} :answer-field/id #uuid "7a673c29-4fae-58d2-bcf6-86accdee64d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494972}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "95857c13-ed71-5f23-a1a7-f058676d3273" :question/math-academy-id "q-161670" :question/problem "What is the distance between the points $(-1,5)$  and $(3,5)?$" :question/worked-solution "**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/74/74dfce8c8444a841f9f742d70204d82b22157bf5b955bb2691eb0cdefe62fb75.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $4$ units, so the distance equals $4.$\n\n![](images/4d/4df0d2515a43236634f934879d6a4d8926cc09163f79216ce288e07e2ba28e72.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $y$-axis and then adding.\n\n![](images/aa/aaf091301a2b004e80bef49a2893eed00f0a28693d8799ee366ed47425869a9c.png)\n\nThe point $(-1,5)$ is at a distance of $1$ from the $y$-axis, and the point $(3,5)$ is at a distance of $3$ from the $y$-axis. Therefore, the distance between the two points is $1+3=4.$"} :step/id #uuid "a89caa7f-1651-5452-aad2-2238b199389e"} {:db/id #edb/ref 17592186495257 :step/content {:db/id #edb/ref 17592186495173 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42efa052-c9ab-54d8-9f6d-f34afac5ba39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186494453} {:answer/id #uuid "6ec87af5-64e1-5fd2-bd75-166d861e724a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186494553} {:answer/id #uuid "70a17d06-9360-5c19-9fa3-a5b4fb34974f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186494559} {:answer/id #uuid "c731f4ef-fe9c-53df-889c-769685b74d4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186494787} {:answer/id #uuid "ea8a321d-e3fc-594f-880d-2f2880f86d49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186494873}] :answer-field/correct {:db/id #edb/ref 17592186494553} :answer-field/id #uuid "7857e68d-f576-5073-be69-923b7ef4e7c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494970}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fce25e13-2247-5592-b858-9038960a704e" :question/math-academy-id "q-61243" :question/problem "What is the distance between the points $(-5,-2)$  and $(-5,-9)?$" :question/worked-solution "**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/35/353bedad7a1692dea35f8b6adf30b7b461458c7852b4123a3fc865e1b23370a6.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $7$ units, so the distance equals $7.$\n\n![](images/e3/e3516729d7662a3b4438a3d3085da3428605d026ba3387a71afeb085e2bd3e73.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $x$-axis and then subtracting.\n\n![](images/f8/f8c5583d14d4e5ca50df3ce906254446c402177734f352169d794de2bb7dea5c.png)\n\nThe point $(-5,-2)$ is at a distance of $2$ from the $x$-axis, and the point $(-5,-9)$ is at a distance of $9$ from the $x$-axis. Therefore, the distance between the two points is $9-2=7.$"} :step/id #uuid "d5842dc7-b1b5-522c-8151-6d2e56afbed8" :step/next {:db/id #edb/ref 17592186495237}} {:db/id #edb/ref 17592186495267 :step/content {:db/id #edb/ref 17592186495146 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4844ffa7-9148-54b8-9e72-b30c1cb0c11e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186494463} {:answer/id #uuid "800b7dfe-1222-53bf-82a3-9afc3077f999" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186494595} {:answer/id #uuid "b32d799a-1971-505f-9d44-6d88dea78839" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186494736} {:answer/id #uuid "cde81723-b01c-5413-aefe-9f6e7a2f5589" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186494806} {:answer/id #uuid "ee3d1b5c-cd0f-5511-8f83-2c24cef83452" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186494883}] :answer-field/correct {:db/id #edb/ref 17592186494736} :answer-field/id #uuid "ce35d819-2898-51ad-bcff-556e53b6cc07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186495016}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d345ec95-0d6e-5d8e-a681-8aa64a38a770" :question/math-academy-id "q-61238" :question/problem "What is the distance between the points $(-2,2)$  and $(-2,7)?$" :question/worked-solution "**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/39/39ac0f7718d7ee4ca8ed96b43c4f5ff9b644e0a3f7b5e2629052468b36ccf687.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $5$ units, so the distance equals $5.$\n\n![](images/59/5995f7494a28a33cc4bdeef51d7d4cc0a85ee8e3219d8630d366c50345629d54.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $x$-axis and then subtracting.\n\n![](images/1c/1cb541f6fcbb93b30a8f154763b0daa60e3b76142db1001ce804a2a68ba79247.png)\n\nThe point $(-2,7)$ is at a distance of $7$ from the $x$-axis, and the point $(-2,2)$ is at a distance of $2$ from the $x$-axis. Therefore, the distance between the two points is $7-2=5.$"} :step/id #uuid "ef3e2ccc-1312-5209-8ec4-fde9203f2c0d" :step/next {:db/id #edb/ref 17592186495257}}] :activity/title "Distances Between Points in the Coordinate Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186494305}] [{:activity/course {:db/id #edb/ref 17592186046647} 