/ref 17592186048594 :topic/id #uuid "acd6ee8f-99a9-566d-947a-0a7133b158e6" :topic/math-academy-id 121} :activity/steps [{:db/id #edb/ref 17592186489297 :step/content {:db/id #edb/ref 17592186489213 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16272320-c6ad-5fc2-84e3-d7dcf4eeabd8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186488519} {:answer/id #uuid "6dbec972-4ca4-5309-baad-353d47f0c0b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186488685} {:answer/id #uuid "bbb71dd0-6c77-5513-a284-fd4648420655" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186488847} {:answer/id #uuid "bce6cc9a-4320-5572-bbb9-66f3fdcad111" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186488853} {:answer/id #uuid "e7b1499b-0be4-535d-b32e-31dd5753c545" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{32}" :db/id #edb/ref 17592186488954}] :answer-field/correct {:db/id #edb/ref 17592186488847} :answer-field/id #uuid "82dc6c2e-5b62-5fbc-aec5-c5800d42bb69" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489087}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4b607318-28df-51c2-9737-62f37f3092a8" :question/math-academy-id "q-68934" :question/problem "Evaluate $(-3)\\times ((-8)^{2}\\times \\frac{3}{64}).$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, consider the expression inside the parentheses:\n\n$$\n\\begin{aligned}(-8)^{2}\\times \\frac{3}{64}\\end{aligned}\n$$\n\nApplying PEMDAS to this expression, we obtain:\n\n$$\n\\begin{aligned}(-8)^{2}\\times \\frac{3}{64} & = \\\\ 64\\times \\frac{3}{64} & = \\\\ \\frac{64}{1}\\times \\frac{3}{64} & = \\\\ \\frac{64\\times 3}{1\\times 64} & = \\\\ \\frac{\\cancel{64}\\times 3}{1\\times \\cancel{64}} & = \\\\ 3\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}(-3)\\times ((-8)^{2}\\times \\frac{3}{64}) & = \\\\ (-3)\\times 3 & = \\\\ -9\\end{aligned}\n$$"} :step/id #uuid "03c2edcd-575d-58ce-886d-f19883074feb" :step/next {:db/id #edb/ref 17592186489348}} {:db/id #edb/ref 17592186489299 :step/content {:db/id #edb/ref 17592186489199 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a21ccfb8-977e-519c-b897-7af24b809a54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "64" :db/id #edb/ref 17592186488789}] :answer-field/correct {:db/id #edb/ref 17592186488789} :answer-field/id #uuid "b9b18399-62b8-5129-8be3-3c30ac27453f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186489120}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2d3046f2-721a-5576-97d9-83326a5bfbf0" :question/math-academy-id "q-184056" :question/problem "$(32+(-4)\\times 7)^{3}=${{field-1}}" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe begin by performing the operations inside the parentheses. So, first we multiply $(-4)$ by $7$:\n\n$$\n\\begin{aligned}(32+(-4)\\times 7)^{3} & =(32+(-28))^{3}\\end{aligned}\n$$\n\n \n\nThen, we add the numbers inside the parentheses: \n\n$$\n\\begin{aligned}(32+(-28))^{3} & ={4}^{3}\\end{aligned}\n$$\n\nFinally, we compute the exponent:\n\n$$\n\\begin{aligned}{4}^{3}=64\\end{aligned}\n$$"} :step/id #uuid "11b7515f-341c-51bb-9088-1fd8218d06f4"} {:db/id #edb/ref 17592186489327 :step/content {:db/id #edb/ref 17592186489218 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a709506-d82a-59b7-a2b1-cc2efb6ccd0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{6}{5}" :db/id #edb/ref 17592186488527} {:answer/id #uuid "27225eb8-4e94-5553-b530-1190a04b98a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{5}{6}" :db/id #edb/ref 17592186488552} {:answer/id #uuid "5b6eb62b-0638-56b2-a12d-831896cfe037" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186488646} {:answer/id #uuid "b2519c59-5675-54f8-9c49-fb9bd709992d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-120" :db/id #edb/ref 17592186488827} {:answer/id #uuid "fb6ce3ab-bbde-5378-b4f8-47c8bd713822" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{120}" :db/id #edb/ref 17592186489005}] :answer-field/correct {:db/id #edb/ref 17592186488552} :answer-field/id #uuid "eb165dbd-4e64-57b9-b591-6886c0a643cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489153}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "50989de1-e6f3-5831-87a9-51e32375a2a1" :question/math-academy-id "q-68926" :question/problem "Calculate $(\\frac{2}{5}\\times {(-5)}^{2})÷({(-2)}^{5}-(-20)).$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, we consider the expressions inside each of the parentheses. The first one is.\n\n$$\n\\begin{aligned}\\frac{2}{5}\\times {(-5)}^{2}.\\end{aligned}\n$$\n\nApplying PEMDAS to this expression, we obtain:\n\n$$\n\\begin{aligned}\\frac{2}{5}\\times {(-5)}^{2} & = \\\\ \\frac{2}{5}\\times 25 & = \\\\ \\frac{2}{5}\\times \\frac{25}{1} & = \\\\ \\frac{2\\times 25}{5\\times 1} & = \\\\ \\frac{50}{5} & = \\\\ 10\\end{aligned}\n$$\n\nThe expression inside the second parentheses is.\n\n$$\n\\begin{aligned}{(-2)}^{5}-(-20).\\end{aligned}\n$$\n\nApplying PEMDAS to this expression, we obtain:\n\n$$\n\\begin{aligned}{(-2)}^{5}-(-20) & = \\\\ (-32)+20 & = \\\\ -12\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}(\\frac{2}{5}\\times {(-5)}^{2})÷({(-2)}^{5}-(-20)) & = \\\\ 10÷(-12) & = \\\\ \\frac{10}{(-12)} & = \\\\ -\\frac{10}{12} & = \\\\ -\\frac{5}{6}\\end{aligned}\n$$"} :step/id #uuid "721cbfa0-5e23-5864-b656-268c3fc3ca8a" :step/next {:db/id #edb/ref 17592186489297}} {:db/id #edb/ref 17592186489348 :step/content {:db/id #edb/ref 17592186489277 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "042bf7aa-f453-554b-8c1c-4d25f3ca6aa5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "26" :db/id #edb/ref 17592186488477} {:answer/id #uuid "1b0bb6ea-6daf-5ae5-9f0e-14955e246f6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186488530} {:answer/id #uuid "9a1ba0f8-6ded-5608-9ea4-cca507a00bf1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "84" :db/id #edb/ref 17592186488779} {:answer/id #uuid "c3d17bdb-b305-55ba-bee9-78cc57d72ba3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36" :db/id #edb/ref 17592186488866} {:answer/id #uuid "ebc3ccd7-e674-5b7b-9d26-1f88b6ffce11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "28" :db/id #edb/ref 17592186488966}] :answer-field/correct {:db/id #edb/ref 17592186488966} :answer-field/id #uuid "0bc44f8c-0d27-582d-86af-3b517235127d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489026}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dff097a9-6d33-544e-9f71-468162e0a004" :question/math-academy-id "q-100137" :question/problem "Find the value of $3+(-2+7)^{2}.$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe begin by performing the operations inside the parentheses. So, first we add $(-2)$ to $7$:\n\n$$\n\\begin{aligned}3+(-2+7)^{2} & =3+{5}^{2}\\end{aligned}\n$$\n\n \n\nThen, we compute the exponent:\n\n$$\n\\begin{aligned}3+{5}^{2} & =3+25\\end{aligned}\n$$\n\nFinally, we add the numbers: \n\n$$\n\\begin{aligned}3+25=28\\end{aligned}\n$$"} :step/id #uuid "9e957131-4874-5e4b-ad84-6fb1f2a5f82c" :step/next {:db/id #edb/ref 17592186489299}}] :activity/title "Evaluating Expressions With Positive Integer Exponents" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186488456}] [{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186134987} :activity/id #uuid "f2735cce-723e-58b4-93fb-cea13e3ee05e" :activity/scope {:db/id #edb/ref 17592186048938 :topic/id #uuid "cd61cb00-4988-54d1-a596-e98a1a9c15ab" :topic/math-academy-id 2183} :activity/steps [{:db/id #edb/ref 17592186134987 :step/content {:db/id #edb/ref 17592186135171 :tutorial/content "A **rational expression** is, roughly speaking, an algebraic expression that's in the form of a fraction, or contains fractions.\n\nTo evaluate a rational expression like $\\dfrac 6 x$ for $x=2,$ all we need to do is replace $x$ with $2$ in the above expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{6}{x}=\\frac{6}{2}=3\\end{aligned}\n$$" :tutorial/id #uuid "12656f01-d648-56e1-9a11-2f5bb03056ec" :tutorial/math-academy-id 8008 :tutorial/title "Introduction"} :step/id #uuid "4e087006-b2f0-5042-9384-ccede2e9afb9" :step/math-academy-id 76947 :step/next {:db/id #edb/ref 17592186134988}} {:db/id #edb/ref 17592186134988 :step/content {:db/id #edb/ref 17592186133962 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133492 :question/id #uuid "e2e06b2a-d740-5280-addb-2796864dd5a8" :question/math-academy-id "e-12768"} :knowledge-point/id #uuid "00f73402-88ee-5e43-8e45-dbdd0a361521" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050078} {:db/id #edb/ref 17592186050127}] :knowledge-point/questions [{:db/id #edb/ref 17592186134348} {:db/id #edb/ref 17592186134349} {:db/id #edb/ref 17592186479871} {:db/id #edb/ref 17592186479900}] :knowledge-point/title "Evaluating a Single Fraction"} :step/id #uuid "12a83cc7-e8f9-5b87-bc18-7e038bdde9ae" :step/math-academy-id 76948 :step/next {:db/id #edb/ref 17592186134989}} {:db/id #edb/ref 17592186134989 :step/content {:db/id #edb/ref 17592186133963 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133494 :question/id #uuid "74f72809-7c28-5fc8-9e0e-b5542b5ffe4d" :question/math-academy-id "e-12770"} :knowledge-point/id #uuid "75725a2d-2a8d-563f-99f1-8d071c2ff0c9" :knowledge-point/questions [{:db/id #edb/ref 17592186134350} {:db/id #edb/ref 17592186134489} {:db/id #edb/ref 17592186234263} {:db/id #edb/ref 17592186479857} {:db/id #edb/ref 17592186495145} {:db/id #edb/ref 17592186495162}] :knowledge-point/title "Evaluating Expressions With Parentheses"} :step/id #uuid "cf4589be-5618-5a10-9c3c-90369c5af6cd" :step/math-academy-id 76952 :step/next {:db/id #edb/ref 17592186134990}} {:db/id #edb/ref 17592186134990 :step/content {:db/id #edb/ref 17592186133964 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133493 :question/id #uuid "378a718e-c6cb-5b85-adc3-22ff4bd7bc9b" :question/math-academy-id "e-12769"} :knowledge-point/id #uuid "de683deb-e208-59ef-9110-7523dd22ce2a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050131}] :knowledge-point/questions [{:db/id #edb/ref 17592186134165} {:db/id #edb/ref 17592186134166} {:db/id #edb/ref 17592186479874} {:db/id #edb/ref 17592186479897} {:db/id #edb/ref 17592186495056} {:db/id #edb/ref 17592186538948}] :knowledge-point/title "Evaluating a Sum or Difference"} :step/id #uuid "c05db175-4da5-59d1-8b53-4d6d15035664" :step/math-academy-id 76956 :step/next {:db/id #edb/ref 17592186134991}} {:db/id #edb/ref 17592186134991 :step/content {:db/id #edb/ref 17592186133965 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133495 :question/id #uuid "4e54a97f-16af-57c7-ab4e-c6f12e83306f" :question/math-academy-id "e-12771"} :knowledge-point/id #uuid "21b84055-253e-50a0-b57f-d288d466bc02" :knowledge-point/questions [{:db/id #edb/ref 17592186134351} {:db/id #edb/ref 17592186134480} {:db/id #edb/ref 17592186479838} {:db/id #edb/ref 17592186479890} {:db/id #edb/ref 17592186495065} {:db/id #edb/ref 17592186495109}] :knowledge-point/title "Evaluating Expressions With Multiple Variables"} :step/id #uuid "2e1b159e-e30d-5188-9fe3-8c0f008f8a43" :step/math-academy-id 76960}] :activity/title "Evaluating Rational Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186134036}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186495216} :activity/id #uuid "6aa5b166-dd8e-5ca2-8b7d-1419def83709" :activity/scope {:db/id #edb/ref 17592186048938 :topic/id #uuid "cd61cb00-4988-54d1-a596-e98a1a9c15ab" :topic/math-academy-id 2183} :activity/steps [{:db/id #edb/ref 17592186495187 :step/content {:db/id #edb/ref 17592186495065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a193d30-2678-5290-8227-48f94178684b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186494501} {:answer/id #uuid "71b0bb4d-c696-553e-85b2-c82a397e838c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186494561} {:answer/id #uuid "ada5c571-4b79-5699-bf57-b91b3d06e08b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186494721} {:answer/id #uuid "d7b1df03-83f7-505b-93fd-e466c959a197" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186494828} {:answer/id #uuid "e10238d5-b4fc-50dd-852e-f9c92340056d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186494852}] :answer-field/correct {:db/id #edb/ref 17592186494721} :answer-field/id #uuid "eab9a6ff-5e82-586a-84ee-0529550dee14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186495032}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1ae15419-ea90-5da7-9981-972449aabeb9" :question/math-academy-id "q-70122" :question/problem "Evaluate $\\frac{2m}{n+4}-\\frac{m-2}{2n}$ if $m=4$ and $n=1$ ." :question/worked-solution "We replace $m$ with $4$ and $n$ with $1$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{2m}{n+4}-\\frac{m-2}{2n} & = \\\\ \\frac{2(4)}{1+4}-\\frac{4-2}{2(1)} & = \\\\ \\frac{8}{5}-\\frac{2}{2} & = \\\\ \\frac{8}{5}-1 & = \\\\ \\frac{8}{5}-\\frac{5}{5} & = \\\\ \\frac{8-5}{5} & = \\\\ \\frac{3}{5}\\end{aligned}\n$$"} :step/id #uuid "21d43eb5-2713-5f23-bd3a-faf668d76610" :step/next {:db/id #edb/ref 17592186495192}} {:db/id #edb/ref 17592186495192 :step/content {:db/id #edb/ref 17592186495056 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03fe396d-fe54-5331-9b0d-89cca76e8a83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{10}" :db/id #edb/ref 17592186494325} {:answer/id #uuid "28e4f656-f65d-5411-8d23-3582c6860ee1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{10}" :db/id #edb/ref 17592186494395} {:answer/id #uuid "7e76872b-704c-5f0c-a9ff-08c0e8fdc198" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{7}" :db/id #edb/ref 17592186494593} {:answer/id #uuid "93ee67a5-c7ed-59bc-a55b-a2b9816ca144" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{17}{10}" :db/id #edb/ref 17592186494657} {:answer/id #uuid "a652b819-cc60-593b-be0f-164896bc2a59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{10}{17}" :db/id #edb/ref 17592186494698}] :answer-field/correct {:db/id #edb/ref 17592186494657} :answer-field/id #uuid "df747204-bd95-5057-9f83-9ee058a01322" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186495026}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0f15a926-c445-59e0-9b0e-24fb3d26db90" :question/math-academy-id "q-99830" :question/problem "Evaluate $\\frac{8}{x}+\\frac{2}{4x}$ for $x=-5.$" :question/worked-solution "We replace $x$ with $-5$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{8}{x}+\\frac{2}{4x} & = \\\\ \\frac{8}{(-5)}+\\frac{2}{4\\cdot (-5)} & = \\\\ -\\frac{8}{5}+(-\\frac{2}{20}) & = \\\\ -\\frac{8}{5}-\\frac{1}{10} & = \\\\ -\\frac{16}{10}-\\frac{1}{10} & = \\\\ \\frac{-16-1}{10} & = \\\\ -\\frac{17}{10}\\end{aligned}\n$$"} :step/id #uuid "280ac367-40c7-558a-b5e2-c35117deba67" :step/next {:db/id #edb/ref 17592186495263}} {:db/id #edb/ref 17592186495216 :step/content {:db/id #edb/ref 17592186495145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e3dbef9-dc90-5521-aad3-0e986ff0a9c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186494374} {:answer/id #uuid "2f95e908-cc3c-52a0-b192-0d0710737e7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186494411} {:answer/id #uuid "8afd3cea-dcab-580e-a906-ca6e1b3ef1ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186494632} {:answer/id #uuid "c99f603d-0d8c-5cad-a745-389ae3790563" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186494793} {:answer/id #uuid "fc53b599-5c2a-51eb-849a-b5560be90857" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186494912}] :answer-field/correct {:db/id #edb/ref 17592186494793} :answer-field/id #uuid "ae640502-6ec1-5965-8f84-422b9cf2d36f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494999}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cd9fe40e-bc91-5a44-83a1-8324033e7c36" :question/math-academy-id "q-41396" :question/problem "Evaluate $\\frac{4p-1}{2(2p+2)}$ for $p=4.$" :question/worked-solution "We replace $p$ with $4$ in the above expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{4p-1}{2(2p+2)} & = \\\\ \\frac{4(4)-1}{2(2(4)+2)} & = \\\\ \\frac{15}{2(8+2)} & = \\\\ \\frac{15}{20} & = \\\\ \\frac{3}{4}\\end{aligned}\n$$"} :step/id #uuid "7b236cf6-b776-533a-a5d8-6899df32a482" :step/next {:db/id #edb/ref 17592186495242}} {:db/id #edb/ref 17592186495242 :step/content {:db/id #edb/ref 17592186495162 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16d21786-f17d-5f51-b039-3a8847d6393b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186494363} {:answer/id #uuid "3624078e-face-5369-96cf-5bd66283c3d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186494430} {:answer/id #uuid "506d0e3d-76e7-56a6-8950-11ce3311fb87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186494480} {:answer/id #uuid "80029657-b251-5c82-b8aa-9552f47c932e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{7}" :db/id #edb/ref 17592186494594} {:answer/id #uuid "899713f6-4503-506c-8e51-5d19404c5088" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186494624}] :answer-field/correct {:db/id #edb/ref 17592186494480} :answer-field/id #uuid "ecea4696-381b-5caf-8ad2-71fa9ec32665" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186495033}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ea15f44d-2e1d-56cb-9675-b5eb8b0bd610" :question/math-academy-id "q-51597" :question/problem "Evaluate $\\frac{p+9}{2(3-p)}$ for $p=-5.$" :question/worked-solution "We replace $p$ with $-5$ in the above expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{p+9}{2(3-p)} & = \\\\ \\frac{(-5)+9}{2(3-(-5))} & = \\\\ \\frac{4}{2(8)} & = \\\\ \\frac{4}{16} & = \\\\ \\frac{1}{4} & \\end{aligned}\n$$"} :step/id #uuid "b33d30b4-f26c-5283-a113-5d791c204f7d" :step/next {:db/id #edb/ref 17592186495187}} {:db/id #edb/ref 17592186495263 :step/content {:db/id #edb/ref 17592186495109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90b1e99c-00a5-5d5c-9c07-a9ac4425d78b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186494647}] :answer-field/correct {:db/id #edb/ref 17592186494647} :answer-field/id #uuid "390cda6c-7afa-531f-b8d2-8d4ab6b358f0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186494941}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8ab342b9-3bac-54fe-9ede-058c11e77bac" :question/math-academy-id "q-175902" :question/problem "If $p=-2$ and $q=6,$ then $\\frac{2q-3}{4}+\\frac{4}{4-2p}=${{field-1}}." :question/worked-solution "Replacing $p$ with $-2$ and $q$ with $6$ in the expression, we get the following:\n\n$$\n\\begin{aligned}\\frac{2q-3}{4}+\\frac{4}{4-2p} & = \\\\ \\frac{2(6)-3}{4}+\\frac{4}{4-2(-2)} & = \\\\ \\frac{12-3}{4}+\\frac{4}{4+4} & = \\\\ \\frac{9}{4}+\\frac{4}{8} & = \\\\ \\frac{18}{8}+\\frac{4}{8} & = \\\\ \\frac{18+4}{8} & = \\\\ \\frac{22}{8} & = \\\\ \\frac{11}{4}\\end{aligned}\n$$"} :step/id #uuid "e3763ce7-1ebb-58a6-9246-c04907a1a3c3"}] :activity/title "Evaluating Rational Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186494306}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186111763} :activity/id #uuid "cceda887-69b2-551b-ab27-e3d019c77f5a" :activity/scope {:db/id #edb/ref 17592186049068 :topic/id #uuid "d78ca6bb-945f-51db-a4af-fc777024df22" :topic/math-academy-id 1459} :activity/steps [{:db/id #edb/ref 17592186111598 :step/content {:db/id #edb/ref 17592186111900 :tutorial/content "We can organize all mentioned types of quadrilaterals into the following hierarchy diagram:\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nEach shape below another is a specific type of the one above it. For example, every square is a rectangle, and every rectangle is a parallelogram. This means every square is also a parallelogram." :tutorial/id #uuid "d9d3be2f-753b-5a4b-9f26-20b34ab8f89a" :tutorial/math-academy-id 5931 :tutorial/title "Classifying Quadrilaterals"} :step/id #uuid "eab37537-55a4-56e5-9fd6-7ee823f295bb" :step/math-academy-id 36207 :step/next {:db/id #edb/ref 17592186111765}} {:db/id #edb/ref 17592186111763 :step/content {:db/id #edb/ref 17592186111845 :tutorial/content "There are lots of different types of quadrilaterals. Let's look at some examples.\n\n- A **trapezoid** is a quadrilateral with exactly ![](images/95/95836ae470c61ab15bfb67d6f0c92d2ad8d03d400b04473e81e58de3ee44bf32.svg) pair of opposite sides that are parallel to each other. \nThe parallel sides are called the **bases**. The other two sides are called the **legs**.\n\n![](images/9f/9fa09c46a2119d35c796065a696954931e20062fd5b3677a5484bef92bc2b0d8.png)\n\n- An **isosceles trapezoid** is a  trapezoid with congruent legs.\n\n![](images/b6/b6b2b2012c1d724f9da8b23551ec4f978f190d86875d7db7a3074635d7f40c02.png)\n\n- A **parallelogram** is a quadrilateral with ![](images/f5/f5f3224583db57b9cfe323c8489ef5e5271000002b5ea253eb98fd067a858b2d.svg) pairs of parallel sides.\n\n \n\n![](images/5d/5d0f383f3510f54b415a7ab99ef52fb30270924f97b8afec59534a96cd3edcef.png)\n\n Opposite sides and opposite angles of a parallelogram are always congruent. Moreover, if a quadrilateral has ![](images/f5/f5f3224583db57b9cfe323c8489ef5e5271000002b5ea253eb98fd067a858b2d.svg) pairs of opposite congruent sides or  ![](images/f5/f5f3224583db57b9cfe323c8489ef5e5271000002b5ea253eb98fd067a858b2d.svg) pairs of opposite congruent angles, it is always a parallelogram.\n\n![](images/39/39ccf26333785f9ef47eed68a96bc40005a6ba025fdb6e250beefe14f10b043d.png)\n\n- A **rectangle** is a parallelogram where all angles are right.\n\n \n\n![](images/55/55a16e0ba93bf1f01d576cca558805aaea9631d1fa8e43b149509d4f8eb4c834.png)\n\n A rectangle where all sides are congruent is a **square**.\n\n![](images/a0/a04b2a0e86be8b085c5e3fc906d5aa66dfea45c033d52cd4746031202a7d427d.png)\n\n- A **rhombus** is a parallelogram where all sides are congruent. The opposite angles of a rhombus are also congruent.\n\n![](images/d3/d3588d7cbe8f285198df3909df3c03fdec04f53a3f75769e46a0ab4283fa27b3.png)\n\n A rhombus where all angles are congruent is a **square**.\n\n \n\n![](images/94/941872050d5407bcd9cb532e318276adccff802230ed854a2d292666fc0096fc.png)\n\n- A **kite** is a quadrilateral with two pairs of congruent sides that are adjacent to each other.\n\n![](images/11/116e323d81ee190c0f69b4d7cdcefe9f0952da883b0d6d3c6d4036119794baa7.png)" :tutorial/id #uuid "06a11fa2-5911-52f5-9a6d-1028e49b44dd" :tutorial/math-academy-id 2262 :tutorial/title "Introduction"} :step/id #uuid "04c2712b-f67a-5317-b34e-8936b6acdd9c" :step/math-academy-id 9452 :step/next {:db/id #edb/ref 17592186111598}} {:db/id #edb/ref 17592186111765 :step/content {:db/id #edb/ref 17592186110776 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110405 :question/id #uuid "515ab620-8513-55cc-8c88-61c0ad27aff2" :question/math-academy-id "e-2833"} :knowledge-point/id #uuid "00889b75-3745-52f6-9157-912846482689" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048723} {:db/id #edb/ref 17592186049584}] :knowledge-point/questions [{:db/id #edb/ref 17592186111260} {:db/id #edb/ref 17592186111261} {:db/id #edb/ref 17592186446849} {:db/id #edb/ref 17592186446853} {:db/id #edb/ref 17592186536886}] :knowledge-point/title "Describing a Quadrilateral"} :step/id #uuid "4f398499-a037-5d65-8f25-ecbcfa7534c2" :step/math-academy-id 9454 :step/next {:db/id #edb/ref 17592186111767}} {:db/id #edb/ref 17592186111767 :step/content {:db/id #edb/ref 17592186110777 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110406 :question/id #uuid "ee3a028c-93df-5e5a-bc06-4c286a5e1839" :question/math-academy-id "e-2834"} :knowledge-point/id #uuid "c81cf5ed-8dd7-5174-b8e9-faf63bf0a278" :knowledge-point/questions [{:db/id #edb/ref 17592186111263} {:db/id #edb/ref 17592186111264} {:db/id #edb/ref 17592186446851} {:db/id #edb/ref 17592186446852} {:db/id #edb/ref 17592186506540} {:db/id #edb/ref 17592186531582} {:db/id #edb/ref 17592186539025}] :knowledge-point/title "Identifying a Quadrilateral"} :step/id #uuid "14f9869d-2b87-58dd-a3bd-3dfd6047425b" :step/math-academy-id 9459 :step/next {:db/id #edb/ref 17592186111768}} {:db/id #edb/ref 17592186111768 :step/content {:db/id #edb/ref 17592186110778 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110408 :question/id #uuid "a7b82dde-36fc-582e-9ed6-fbfcfbf8b47c" :question/math-academy-id "e-2839"} :knowledge-point/id #uuid "34ed7bcd-3c06-592e-906c-5010e80370db" :knowledge-point/questions [{:db/id #edb/ref 17592186111262} {:db/id #edb/ref 17592186111266} {:db/id #edb/ref 17592186446850} {:db/id #edb/ref 17592186506515} {:db/id #edb/ref 17592186506571} {:db/id #edb/ref 17592186536811} {:db/id #edb/ref 17592186536834}] :knowledge-point/title "Identifying True Statements About Quadrilaterals"} :step/id #uuid "615b803e-ca7c-56d1-9167-9829ed84b5c5" :step/math-academy-id 9460}] :activity/title "Classifying Quadrilaterals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110831}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186506608} :activity/id #uuid "0fada08e-9ee8-50a7-a281-27eecc4451e2" :activity/scope {:db/id #edb/ref 17592186049068 :topic/id #uuid "d78ca6bb-945f-51db-a4af-fc777024df22" :topic/math-academy-id 1459} :activity/steps [{:db/id #edb/ref 17592186506608 :step/content {:db/id #edb/ref 17592186506515 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04cd6f91-4830-5fb2-a760-6d1458397aff" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186505925} {:answer/id #uuid "3cb14bc8-1566-5a66-a92e-6847a87ef3a0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186506011} {:answer/id #uuid "40c8a717-049b-5524-b555-5e7634dfb774" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186506019} {:answer/id #uuid "6b6d04c0-fedf-5f99-93ce-81d660f42b3b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186506097} {:answer/id #uuid "9f2a5be0-7fd3-5d96-a0c9-2797fdcde248" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186506194}] :answer-field/correct {:db/id #edb/ref 17592186506011} :answer-field/id #uuid "b73d6aaf-8b71-5986-9a72-f3f8cba064c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186506464}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "16005fe9-c0e8-5807-8dbf-172a83d89558" :question/math-academy-id "q-53062" :question/problem "Which of the following statements are true?\n\nI. A square is sometimes not a rectangle.\n\nII. A rectangle is always a quadrilateral.\n\nIII. A square is never a rhombus." :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nLet's now look at each statement in turn.\n\n- Statement I is false. In a rectangle, its four angles are right angles. The same is true for a square. A square is a specific type of rectangle, where the four angles are right angles and the four sides are congruent.\n\n- Statement II is true. A rectangle is always a quadrilateral because it has four sides.\n\n- Statement III is false. A rhombus is a parallelogram where all sides are congruent. A square is a specific type of rhombus, where the four angles are right angles and the four sides are congruent.\n\nIn conclusion, only statement II is true."} :step/id #uuid "1472f937-314f-5429-8263-e1a67f2a5b4d" :step/next {:db/id #edb/ref 17592186506644}} {:db/id #edb/ref 17592186506644 :step/content {:db/id #edb/ref 17592186506571 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "015f0057-b143-57ad-8fa5-2978f72ea3dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186505914} {:answer/id #uuid "1afb074a-342e-57b7-b473-fffc06924988" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186505957} {:answer/id #uuid "555289bb-109d-55d5-955e-bed2ff4c8443" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186506057} {:answer/id #uuid "92f03582-9a2a-59ce-8ac4-d6529d374b33" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186506160} {:answer/id #uuid "e905ed52-46a6-5b4b-9ca4-e3a4bea9ebdc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186506337}] :answer-field/correct {:db/id #edb/ref 17592186506160} :answer-field/id #uuid "38a2df37-5f07-59b3-9c74-e390691ea42b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186506405}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "978998ae-c2d1-5709-a415-cc49252cea0c" :question/math-academy-id "q-53063" :question/problem "Which of the following statements are true?\n\nI. A parallelogram is sometimes a rectangle.\n\nII. A kite is never a quadrilateral.\n\nIII. A square is always a trapezoid." :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nLet's now look at each statement in turn.\n\n- Statement I is true. A parallelogram is a rectangle when all the angles are right.\n\n- Statement II is false. A kite is always a quadrilateral because it has four sides.\n\n- Statement III is false. A trapezoid has only $1$ pair of opposite sides that are parallel. However, in a square, $2$ pairs of opposite sides are parallel, and so doesn't fit the definition of a trapezoid.\n\nIn conclusion, only statement I is true."} :step/id #uuid "a7b19881-e4d4-5ce2-a2db-ec80491290b8" :step/next {:db/id #edb/ref 17592186506648}} {:db/id #edb/ref 17592186506648 :step/content {:db/id #edb/ref 17592186506540 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c5ff65a-e0ad-54f7-95cd-72299fae692b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186506101} {:answer/id #uuid "ab8a2580-e988-59db-b88f-bdf851f5dff2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$R$ only" :db/id #edb/ref 17592186506224} {:answer/id #uuid "dabfe65d-e001-5f6f-8eae-84c4f049a38c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$S$ only" :db/id #edb/ref 17592186506304} {:answer/id #uuid "f6b01984-7aec-5b99-b309-32e1700f88cf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$Q$ only" :db/id #edb/ref 17592186506364} {:answer/id #uuid "faa76e22-ab2a-5e2f-b51a-88f71d4a4169" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$P$ only" :db/id #edb/ref 17592186506371}] :answer-field/correct {:db/id #edb/ref 17592186506364} :answer-field/id #uuid "7c39ae96-03b7-5d75-924b-50c66d2fd7a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186506435}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4ee12482-99b3-5022-8d03-b6e6abfce44f" :question/math-academy-id "q-74591" :question/problem "![](images/e3/e3708d7723606224e201147b432250dd759022fd7ed275dabebf51935d68d8f8.png)\n\nWhich of the figures above is a rhombus?" :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nRemember that a rhombus is a parallelogram where all sides are congruent.\n\nWith that in mind, let's look at each shape in turn.\n\n- The shape $P$ is a rectangle. The sides are not all congruent, so it is not a rhombus.\n\n- The shape $Q$ is a square. All its sides are congruent and the opposite sides are parallel, so it is a rhombus.\n\n- The shape $R$ is a trapezoid. Since it has only one pair of parallel sides, it is not a rhombus.\n\n- The shape $S$ is an isosceles trapezoid.  Since it has only one pair of parallel sides, it is not a rhombus.\n\nTherefore, shape $Q$ is a rhombus. The shapes $P,$ $R,$ and $S$ are not rhombuses."} :step/id #uuid "b98f15bb-0b73-5666-9f9e-51644b2b10be"}] :activity/title "Classifying Quadrilaterals" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186505900}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186536948} :activity/id #uuid "5011f029-40b3-50ae-adc7-c8594e763c6a" :activity/scope {:db/id #edb/ref 17592186049068 :topic/id #uuid "d78ca6bb-945f-51db-a4af-fc777024df22" :topic/math-academy-id 1459} :activity/steps [{:db/id #edb/ref 17592186536917 :step/content {:db/id #edb/ref 17592186111263 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8113f0c1-13bf-5ab2-9884-6d72597b1b88" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$Q$ and $S$ only" :db/id #edb/ref 17592186109304} {:answer/id #uuid "8a8d835d-c354-5c3b-ad6e-6b19f2da5a27" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$R$ only" :db/id #edb/ref 17592186109305} {:answer/id #uuid "bee1b7de-ab86-59bc-81ce-c2ecde07ae92" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186109306} {:answer/id #uuid "2aa8a596-87e0-598e-9105-9841f4e811d8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$P$ only" :db/id #edb/ref 17592186109307} {:answer/id #uuid "44b7bf2b-d86f-5d31-82a9-bbadefe43231" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186109308}] :answer-field/correct {:db/id #edb/ref 17592186109308} :answer-field/id #uuid "e044e866-6811-5b05-95ac-6974da60d777" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186109303}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5b35d665-09e4-54b3-8c80-68318024b0ef" :question/math-academy-id "q-53035" :question/problem "![](images/70/702edb8e1ea4a79ea12e891ed3874c36ff3e6628c9cb000753f74ca7bc35ec74.png)\n\nWhich of the figures above is a parallelogram?" :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nRemember that a parallelogram is a quadrilateral with $2$ pairs of parallel sides.\n\nWith that in mind, let's look at each shape in turn.\n\n- The shape $P$ is a rectangle. Therefore, its opposite sides are parallel, so it is a parallelogram.\n\n- The shape $Q$ is a kite. It has a pair of opposite sides that are not parallel, therefore, it is not a parallelogram.\n\n- The shape $R$ is a rhombus. Since the opposite sides of a rhombus are parallel, it is a parallelogram.\n\n- The shape $S$ is a trapezoid. It has only one pair of parallel sides, therefore, it is not a parallelogram.\n\nTherefore, shapes $P$ and $R$ are parallelograms. The shapes $Q$ and $S$ are not parallelograms."} :step/id #uuid "2cfe7fe6-dfad-5186-856c-597f87ad3a5e"} {:db/id #edb/ref 17592186536937 :step/content {:db/id #edb/ref 17592186536834 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48305576-11d5-5617-960a-a3990bcb7dca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186536394} {:answer/id #uuid "5af8d66e-d7ec-5f20-b9b6-13fb2ff0d05e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186536443} {:answer/id #uuid "bfbf47b7-c34e-5794-aa4d-102f253c4306" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186536584} {:answer/id #uuid "f2464b38-1ef3-59d6-af91-e21eb614b53f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186536670} {:answer/id #uuid "f5b0cf17-65c2-51ce-89a4-44437b972a52" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186536677}] :answer-field/correct {:db/id #edb/ref 17592186536443} :answer-field/id #uuid "ec71a978-52b7-54a3-b5fa-ef72f160c9d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536797}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "55788c3c-c1d0-5ef8-8ff4-5e5fd3b4c618" :question/math-academy-id "q-53012" :question/problem "![](images/4e/4e20dca5a916c43e93dd94b92ff4c1949a111537a8cb2e45b9ca0be7e2300f40.png)\n\nWhich of the following statements are true regarding the square above?\n\nI. $AB=BC=CD=AD.$\n\nII. $m∠ABC=m∠ADC.$\n\nIII. $\\overset{―}{AD}$ is parallel to $\\overset{―}{BC}.$" :question/worked-solution "Let's look at each statement in turn.\n\n- Statement I is true. A square is a rectangle where all sides are congruent, hence $AB=BC=CD=AD.$\n\n- Statement II is true. The angles in a square are all right. Therefore, $m∠ABC={90}^{∘}=m∠ADC.$\n\n- Statement III is true. Opposite sides of a square are parallel, and $\\overset{―}{AD}$ is opposite $\\overset{―}{BC},$ therefore $\\overset{―}{AD}$ is parallel to $\\overset{―}{BC}.$\n\nIn conclusion, statements I, II, and III are true."} :step/id #uuid "6b24c0db-50fd-51da-9580-556fff1c0632" :step/next {:db/id #edb/ref 17592186536917}} {:db/id #edb/ref 17592186536948 :step/content {:db/id #edb/ref 17592186536811 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24387f91-25bf-5714-8675-ef415eba960e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186536337} {:answer/id #uuid "28dbcf41-1538-5429-b8d5-50fbfa182de1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186536344} {:answer/id #uuid "8d7da163-a580-5e50-a38f-f8e138ef74c7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186536510} {:answer/id #uuid "edec2c50-c3f2-5ae9-9a96-0ba69435f615" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186536661} {:answer/id #uuid "f02da5b5-90ef-5511-90c7-04d4ca4bf833" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186536664}] :answer-field/correct {:db/id #edb/ref 17592186536510} :answer-field/id #uuid "6a514638-3f19-527b-a1de-1e926b7c8285" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536750}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "13987c3a-59aa-55ed-8fe6-1cb169d96b89" :question/math-academy-id "q-53009" :question/problem "![](images/1b/1b0dd854ae2edb38245466049806c7e93bb4b704a03284905d968869fa1b4146.png)\n\nWhich of the following statements are true regarding the kite above?\n\nI. $AB=AD.$\n\nII. The kite has a pair of congruent opposite angles.\n\nIII. $AB=BC=CD=AD.$" :question/worked-solution "Let's look at each statement in turn.\n\n- Statement I is true. A kite is a quadrilateral with two pairs of congruent sides that are adjacent to each other. In the figure, we can see that $AB=AD.$\n\n- Statement II is true. A kite always has a pair of congruent opposite angles.\n\n- Statement III is false. A kite is a quadrilateral with two pairs of congruent sides that are adjacent to each other. However, not all sides are congruent, for instance, $AB\\ne BC.$\n\nIn conclusion, statements I and II are true."} :step/id #uuid "866cff26-8806-5fb7-acaa-154a2dd5266d" :step/next {:db/id #edb/ref 17592186536937}}] :activity/title "Classifying Quadrilaterals" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186536273}] [{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186069730} :activity/id #uuid "74c085db-a02d-55d0-a9c6-2ff188739b10" :activity/scope {:db/id #edb/ref 17592186049181 :topic/id #uuid "e176f8f6-a3bc-5ea6-89d2-2202d9d89fd7" :topic/math-academy-id 423} :activity/steps [{:db/id #edb/ref 17592186069730 :step/content {:db/id #edb/ref 17592186069927 :tutorial/content "To simplify a rational expression, we cancel out the largest common factor from the numerator and denominator. To do this, we sometimes need to factor the numerator and denominator before canceling.\n\nFor example, suppose that we wish to simplify $\\dfrac {4x - 12} {10x + 4}.$ To do this, we factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\eqalign{\n\t\t\\dfrac {4x - 12} {10x + 4}\n\t\t&=\\dfrac {4(x - 3)} {2(5x + 2)}\\[5pt]\n&=\\dfrac {2 \\cdot 2 \\cdot (x - 3)} {2(5x + 2)}\\[5pt]\t\t\n\t\t&=\\dfrac {\\cancel{2} \\cdot 2(x - 3)} {\\cancel{2}(5x + 2)}\\[5pt]\t\n\t\t&=\\dfrac {2(x - 3)} {5x + 2}\n\t}\n$$" :tutorial/id #uuid "332f534f-811e-5c03-8393-560134dd4ea8" :tutorial/math-academy-id 1370 :tutorial/title "Introduction"} :step/id #uuid "818bd86a-fb35-5a26-8a36-9ee10c0aa1c5" :step/math-academy-id 2850 :step/next {:db/id #edb/ref 17592186069869}} {:db/id #edb/ref 17592186069731 :step/content {:db/id #edb/ref 17592186068805 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068653 :question/id #uuid "3df1f00a-3a87-5db7-83c5-d47dce633bf9" :question/math-academy-id "e-843"} :knowledge-point/id #uuid "6a17d9d6-cd3a-554e-98d2-7e9536950bd0" :knowledge-point/questions [{:db/id #edb/ref 17592186069273} {:db/id #edb/ref 17592186069446} {:db/id #edb/ref 17592186480645} {:db/id #edb/ref 17592186480703} {:db/id #edb/ref 17592186502073} {:db/id #edb/ref 17592186502106} {:db/id #edb/ref 17592186538931}] :knowledge-point/title "Simpli