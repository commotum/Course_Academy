a507c5" #edb/ref 17592186045417] [17592186538902 #edb/ref 1075 #edb/ref 17592186538325 #edb/ref 17592186045417] [17592186538902 #edb/ref 1075 #edb/ref 17592186538447 #edb/ref 17592186045417] [17592186538902 #edb/ref 1075 #edb/ref 17592186538564 #edb/ref 17592186045417] [17592186538902 #edb/ref 1075 #edb/ref 17592186538702 #edb/ref 17592186045417] [17592186538902 #edb/ref 1075 #edb/ref 17592186538792 #edb/ref 17592186045417] [17592186538902 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186538902 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186538902 #edb/ref 1078 #edb/ref 17592186538792 #edb/ref 17592186045417] [17592186538902 #edb/ref 1079 #uuid "d3e29b2d-1ff0-5f42-aa69-6c73bafc3de3" #edb/ref 17592186045417] [17592186538911 #edb/ref 1075 #edb/ref 17592186538288 #edb/ref 17592186045417] [17592186538911 #edb/ref 1075 #edb/ref 17592186538290 #edb/ref 17592186045417] [17592186538911 #edb/ref 1075 #edb/ref 17592186538331 #edb/ref 17592186045417] [17592186538911 #edb/ref 1075 #edb/ref 17592186538357 #edb/ref 17592186045417] [17592186538911 #edb/ref 1075 #edb/ref 17592186538615 #edb/ref 17592186045417] [17592186538911 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186538911 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186538911 #edb/ref 1078 #edb/ref 17592186538290 #edb/ref 17592186045417] [17592186538911 #edb/ref 1079 #uuid "e60f0809-006d-5d59-8100-1de6658c3ea0" #edb/ref 17592186045417] [17592186538912 #edb/ref 1075 #edb/ref 17592186538733 #edb/ref 17592186045417] [17592186538912 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186538912 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186538912 #edb/ref 1078 #edb/ref 17592186538733 #edb/ref 17592186045417] [17592186538912 #edb/ref 1079 #uuid "ea38a251-ab23-5c87-abfe-28a8670ee8a6" #edb/ref 17592186045417] [17592186538924 #edb/ref 1075 #edb/ref 17592186538746 #edb/ref 17592186045417] [17592186538924 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186538924 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186538924 #edb/ref 1078 #edb/ref 17592186538746 #edb/ref 17592186045417] [17592186538924 #edb/ref 1079 #uuid "ffbb06e8-1787-59c8-b541-824a6fbe128b" #edb/ref 17592186045417] [17592186538925 #edb/ref 1068 #edb/ref 17592186538888 #edb/ref 17592186045417] [17592186538925 #edb/ref 1069 "q-52025" #edb/ref 17592186045417] [17592186538925 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186538925 #edb/ref 1071 "Evaluate $|4y+6{|}^{3}$ for $y=-2.$" #edb/ref 17592186045417] [17592186538925 #edb/ref 1072 #uuid "00b7055c-6f6b-518a-86a9-ac2dadfdf918" #edb/ref 17592186045417] [17592186538925 #edb/ref 1074 "We substitute $y=-2$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|4y+6{|}^{3} & = \\\\ |4(-2)+6{|}^{3} & = \\\\ |-8+6{|}^{3} & = \\\\ |-2{|}^{3} & = \\\\ {2}^{3} & = \\\\ 8\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186538930 #edb/ref 1068 #edb/ref 17592186538834 #edb/ref 17592186045417] [17592186538930 #edb/ref 1069 "q-2893" #edb/ref 17592186045417] [17592186538930 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186538930 #edb/ref 1071 "${z}^{4}\\cdot {z}^{3}=$" #edb/ref 17592186045417] [17592186538930 #edb/ref 1072 #uuid "16bce723-03c6-53a5-b2a1-c812d455c8ee" #edb/ref 17592186045417] [17592186538930 #edb/ref 1074 "We add the exponents, as follows:\n\n$$\n\\begin{aligned}{z}^{4}\\cdot {z}^{3} & = \\\\ {z}^{4+3} & = \\\\ {z}^{7}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186538931 #edb/ref 1068 #edb/ref 17592186538902 #edb/ref 17592186045417] [17592186538931 #edb/ref 1069 "q-100082" #edb/ref 17592186045417] [17592186538931 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186538931 #edb/ref 1071 "$\\frac{ab+3b}{5a+15}=$" #edb/ref 17592186045417] [17592186538931 #edb/ref 1072 #uuid "1a5f882d-4cbf-515d-b127-b49f03d6e601" #edb/ref 17592186045417] [17592186538931 #edb/ref 1074 "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\\frac{ab+3b}{5a+15} & =\\frac{b(a+3)}{5(a+3)} \\\\  & =\\frac{b\\cancel{(a+3)}}{5\\cancel{(a+3)}} \\\\  & =\\frac{b}{5}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186538937 #edb/ref 1068 #edb/ref 17592186538924 #edb/ref 17592186045417] [17592186538937 #edb/ref 1069 "q-175591" #edb/ref 17592186045417] [17592186538937 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186538937 #edb/ref 1071 "If $-\\frac{x}{12}=-\\frac{1}{6},$ then $x=${{field-1}}." #edb/ref 17592186045417] [17592186538937 #edb/ref 1072 #uuid "2c9f2909-7e69-5612-95f1-1f03b540b4de" #edb/ref 17592186045417] [17592186538937 #edb/ref 1074 "First, let's remove the negative sign from the variable. To do this, we multiply both sides of the equation by $-1.$\n\n$$\n\\begin{aligned}-\\frac{x}{12} & =-\\frac{1}{6} \\\\ (-1)\\cdot (-\\frac{x}{12}) & =(-1)\\cdot (-\\frac{1}{6}) \\\\ \\frac{x}{12} & =\\frac{1}{6}\\end{aligned}\n$$\n\nIn the equation above, $x$ is being divided by $12.$ To isolate $x$, we can perform the opposite operation, which is *multiplying* by $12.$ So, we multiply both sides of the equation by $12$ and simplify.\n\n$$\n\\begin{aligned}\\frac{x}{12} & =\\frac{1}{6} \\\\ 12\\cdot \\frac{x}{12} & =12\\cdot \\frac{1}{6} \\\\ \\frac{12x}{12} & =\\frac{12}{6} \\\\ \\frac{\\cancel{12}x}{\\cancel{12}} & =2 \\\\ x & =2\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186538938 #edb/ref 1068 #edb/ref 17592186538887 #edb/ref 17592186045417] [17592186538938 #edb/ref 1069 "q-144246" #edb/ref 17592186045417] [17592186538938 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186538938 #edb/ref 1071 "Simplify the expression $-6q-(q-9).$" #edb/ref 17592186045417] [17592186538938 #edb/ref 1072 #uuid "2eb696c5-dbcf-5ba0-8d82-82e64e6ac266" #edb/ref 17592186045417] [17592186538938 #edb/ref 1074 "First, we remove the parentheses by distributing the negative sign. This gives\n\n$$\n-6q-q+9\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}-6q-q+9 & = \\\\ (-6q-q)+9 & = \\\\ -7q+9 & \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186538941 #edb/ref 1068 #edb/ref 17592186538858 #edb/ref 17592186045417] [17592186538941 #edb/ref 1068 #edb/ref 17592186538882 #edb/ref 17592186045417] [17592186538941 #edb/ref 1069 "q-186859" #edb/ref 17592186045417] [17592186538941 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186538941 #edb/ref 1071 "Complete the ratio table below.\n\n| $7$ | $2$ |\n| --- | --- |\n| {{field-1}} | $6$ |\n| {{field-2}} | $20$ |" #edb/ref 17592186045417] [17592186538941 #edb/ref 1072 #uuid "321e819d-21c6-5c8d-a9d3-36abfa3818e4" #edb/ref 17592186045417] [17592186538941 #edb/ref 1074 "We start with the ratio $7:2$ and write it as a fraction:\n\n$$\n\\frac{7}{2}\n$$\n\nSo the numerator represents the left-hand entry ($7$), and the denominator represents the right-hand entry ($2$).\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n- To create a denominator of $6,$ we multiply the numerator and denominator of our fraction by $3:$\n\n$$\n\\frac{7\\times 3}{2\\times 3}=\\frac{21}{6}\n$$\n\n- To create a denominator of $20,$ we multiply the numerator and denominator of our fraction by $10:$\n\n$$\n\\frac{7\\times 10}{2\\times 10}=\\frac{70}{20}\n$$\n\nFinally, we fill in the ratio table:\n\n| $7$ | $2$ |\n| --- | --- |\n| $21$ | $6$ |\n| $70$ | $20$ |\n\n$$\n\n$$" #edb/ref 17592186045417] [17592186538948 #edb/ref 1068 #edb/ref 17592186538881 #edb/ref 17592186045417] [17592186538948 #edb/ref 1069 "q-175877" #edb/ref 17592186045417] [17592186538948 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186538948 #edb/ref 1071 "If $r=1,$ then $\\frac{7r}{15}+\\frac{6}{5r}=${{field-1}}." #edb/ref 17592186045417] [17592186538948 #edb/ref 1072 #uuid "3d20e092-7a52-54cf-904a-8aa79d562ce0" #edb/ref 17592186045417] [17592186538948 #edb/ref 1074 "We replace $r$ with $1$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{7r}{15}+\\frac{6}{5r} & = \\\\ \\frac{7\\cdot 1}{15}+\\frac{6}{5\\cdot 1} & = \\\\ \\frac{7}{15}+\\frac{6}{5} & = \\\\ \\frac{7}{15}+\\frac{18}{15} & = \\\\ \\frac{7+18}{15} & = \\\\ \\frac{25}{15} & = \\\\ \\frac{5}{3}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186538958 #edb/ref 1068 #edb/ref 17592186538827 #edb/ref 17592186045417] [17592186538958 #edb/ref 1069 "q-218724" #edb/ref 17592186045417] [17592186538958 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186538958 #edb/ref 1071 "The dimensions of a package in the shape of a rectangular solid are $0.9\\,\\text{m}\\times 0.9\\,\\text{m}\\times 1.2\\,\\text{m},$ where each dimension was measured to the nearest $0.1\\,\\text{m}.$ Rounded to the nearest tenth of a cubic meter, what is the upper bound for the volume of the package?\n\nTo the nearest tenth of a cubic meter, the upper bound for the volume of the package is\n{{field-1}}${\\text{m}}^{3}.$" #edb/ref 17592186045417] [17592186538958 #edb/ref 1072 #uuid "559e7325-1f2d-5d6d-99bc-9f9ffa4b9d3b" #edb/ref 17592186045417] [17592186538958 #edb/ref 1074 "Each dimension is given to the nearest $0.1\\,\\text{m}.$ So, the greatest possible error of these measurements is\n\n$$\n\\frac{0.1\\,\\text{m}}{2}=0.05\\,\\text{m}.\n$$\n\nWe wish to find the *upper bound* for the volume of the package. Therefore, we require the *upper bound* of each dimension.\n\nThe upper bounds for each dimension are as follows:\n\n$$\n\\begin{aligned} & 0.9\\,\\text{m}+0.05\\,\\text{m}=0.95\\,\\text{m} \\\\  & 0.9\\,\\text{m}+0.05\\,\\text{m}=0.95\\,\\text{m} \\\\  & 1.2\\,\\text{m}+0.05\\,\\text{m}=1.25\\,\\text{m}\\end{aligned}\n$$\n\nSo, the upper bound for the volume of the package is\n\n$$\n\\begin{aligned}V & =0.95\\,\\text{m}\\times 0.95\\,\\text{m}\\times 1.25\\,\\text{m} \\\\  & =1.128\\,125\\,{\\text{m}}^{3} \\\\  & ≈1.1\\,{\\text{m}}^{3},\\end{aligned}\n$$\n\nrounded to the nearest tenth of a cubic meter." #edb/ref 17592186045417] [17592186538966 #edb/ref 1068 #edb/ref 17592186538812 #edb/ref 17592186045417] [17592186538966 #edb/ref 1069 "q-68483" #edb/ref 17592186045417] [17592186538966 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186538966 #edb/ref 1071 "Sophia and Charlie decide to go to the sea to study some marine species. While Charlie dives $14.2$ meters below sea level, Sophia waits for him in the boat, $2.5$ meters above sea level. How many meters above Charlie is Sophia?" #edb/ref 17592186045417] [17592186538966 #edb/ref 1072 #uuid "65afe218-5b40-51ad-8f32-78468d52b1c6" #edb/ref 17592186045417] [17592186538966 #edb/ref 1074 "To determine the distance between Charlie and Sophia, we must calculate the difference between Sophia's location and Charlie's location. This gives\n\n$$\n2.5-(-14.2)=2.5+14.2=16.7\\,\\text{m}.\n$$\n\nThus, Sophia is located $16.7\\,\\text{m}$ above Charlie." #edb/ref 17592186045417] [17592186538973 #edb/ref 1068 #edb/ref 17592186538840 #edb/ref 17592186045417] [17592186538973 #edb/ref 1069 "q-100380" #edb/ref 17592186045417] [17592186538973 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186538973 #edb/ref 1071 "${({5}^{2})}^{8}=$" #edb/ref 17592186045417] [17592186538973 #edb/ref 1072 #uuid "6ff4ab80-f137-5311-afce-bd7745588b1f" #edb/ref 17592186045417] [17592186538973 #edb/ref 1074 "To raise a power to another power, we simply multiply the exponents:\n\n$$\n{({5}^{2})}^{8}={5}^{2\\cdot 8}={5}^{16}\n$$" #edb/ref 17592186045417] [17592186538992 #edb/ref 1068 #edb/ref 17592186538884 #edb/ref 17592186045417] [17592186538992 #edb/ref 1069 "q-160305" #edb/ref 17592186045417] [17592186538992 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186538992 #edb/ref 1071 "What is the distance between the points $(1,-3)$  and $(5,-3)?$" #edb/ref 17592186045417] [17592186538992 #edb/ref 1072 #uuid "a94dc93f-684c-5299-b244-16888ab7a25a" #edb/ref 17592186045417] [17592186538992 #edb/ref 1074 "**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/b3/b3a34b10cf329cea0e80959562484c07316a582d55395f8bf7aa951d2aca8567.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $4$ units, so the distance equals $4.$\n\n![](images/15/15afca52169a74eb433654bc992cc3d19e191a92704d7d845d0c49071800052e.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $y$-axis and then subtracting.\n\n![](images/72/7298280773fb08b221742571e76ba5f422a77a2e70abd4b94085d602a196e8a7.png)\n\nThe point $(1,-3)$ is at a distance of $1$ from the $y$-axis, and the point $(5,-3)$ is at a distance of $5$ from the $y$-axis. Therefore, the distance between the two points is $5-1=4.$" #edb/ref 17592186045417] [17592186538994 #edb/ref 1068 #edb/ref 17592186538838 #edb/ref 17592186045417] [17592186538994 #edb/ref 1069 "q-147015" #edb/ref 17592186045417] [17592186538994 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186538994 #edb/ref 1071 "On a field trip to a theme park, $150$ students out of $500$ rode a roller coaster. What percentage of students rode a roller coaster?" #edb/ref 17592186045417] [17592186538994 #edb/ref 1072 #uuid "aa408be7-da1f-5fc4-a78a-e723f9d79c8a" #edb/ref 17592186045417] [17592186538994 #edb/ref 1074 "We're given a part and a whole, and we must find a percentage. So, we can use the following formula:\n\n$$\n\\text{percentage}=\\text{part}÷\\text{whole}\n$$\n\nIn this case, \n\n- the part is the number of students who rode a roller coaster, which is $150,$ and\n\n- the whole is the total number of students, which is $500.$\n\nSubstituting our numbers into the above formula, we get\n\n$$\n\\text{percentage}=150÷500=\\frac{150}{500}.\n$$\n\nTo write this as a percentage, we create an equivalent fraction with $100$ as the denominator:\n\n$$\n\\frac{150}{500}=\\frac{150÷5}{500÷5}=\\frac{30}{100}\n$$\n\nNow we can write this fraction as a percentage:\n\n$$\n\\frac{30}{100}=30%\n$$\n\nTherefore, $30%$ of the students rode a roller coaster." #edb/ref 17592186045417] [17592186539005 #edb/ref 1068 #edb/ref 17592186538847 #edb/ref 17592186045417] [17592186539005 #edb/ref 1069 "q-68615" #edb/ref 17592186045417] [17592186539005 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186539005 #edb/ref 1071 "${(\\frac{4}{7}\\times \\frac{1}{5})}^{5}=$" #edb/ref 17592186045417] [17592186539005 #edb/ref 1072 #uuid "c32986e7-9010-5588-b701-72ad7388c062" #edb/ref 17592186045417] [17592186539005 #edb/ref 1074 "To raise the product of two numbers to the power of $5$, we can raise each number to the power of $5,$ and then multiply:\n\n$$\n{(\\frac{4}{7}\\times \\frac{1}{5})}^{4}={(\\frac{4}{7})}^{5}\\times {(\\frac{1}{5})}^{5}\n$$" #edb/ref 17592186045417] [17592186539012 #edb/ref 1068 #edb/ref 17592186538895 #edb/ref 17592186045417] [17592186539012 #edb/ref 1069 "q-152350" #edb/ref 17592186045417] [17592186539012 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186539012 #edb/ref 1071 "Evaluate $\\frac{\\sqrt{20}}{\\sqrt{5}}.$" #edb/ref 17592186045417] [17592186539012 #edb/ref 1072 #uuid "d1265e4c-79e5-5207-9e53-54ea1660d1ab" #edb/ref 17592186045417] [17592186539012 #edb/ref 1074 "A quotient of square roots of two positive numbers is equal to the square root of the quotient of the numbers. Therefore,\n\n$$\n\\frac{\\sqrt{20}}{\\sqrt{5}}=\\sqrt{\\frac{20}{5}}=\\sqrt{4}=2\n$$" #edb/ref 17592186045417] [17592186539025 #edb/ref 1068 #edb/ref 17592186538898 #edb/ref 17592186045417] [17592186539025 #edb/ref 1069 "q-74588" #edb/ref 17592186045417] [17592186539025 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186539025 #edb/ref 1071 "![](images/cb/cb0fa52f4f74145ee88e73f3f4c62d96d6b8261533844b4c8021d30cae8e41d0.png)\n\nWhich of the figures above is a rectangle?" #edb/ref 17592186045417] [17592186539025 #edb/ref 1072 #uuid "ee602985-c91d-54be-9eef-bda0850e7e34" #edb/ref 17592186045417] [17592186539025 #edb/ref 1074 "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nRemember that a rectangle is a quadrilateral where all angles are right and has two pairs of parallel sides.\n\nWith that in mind, let's look at each shape in turn.\n\n- The shape $P$ is an isosceles trapezoid. It has only one pair of parallel sides, not two, therefore, it is not a rectangle.\n\n- The shape $Q$ is a parallelogram. It has no right angles, therefore, it is not a rectangle.\n\n- The shape $R$ is a rhombus. Since it has no right angles, it is not a rectangle.\n\n- The shape $S$ is a rectangle since all its angles are right.\n\nTherefore, shape $S$ is a rectangle. The shapes $P,$ $Q,$ and $R$ are not rectangles." #edb/ref 17592186045417] [17592186539031 #edb/ref 1058 #edb/ref 17592186539091 #edb/ref 17592186045417] [17592186539031 #edb/ref 1062 #uuid "01dc4746-89eb-5dc8-baea-bd277e869037" #edb/ref 17592186045417] [17592186539031 #edb/ref 1063 #edb/ref 17592186539005 #edb/ref 17592186045417] [17592186539034 #edb/ref 1058 #edb/ref 17592186539063 #edb/ref 17592186045417] [17592186539034 #edb/ref 1062 #uuid "09947836-eee9-565c-a198-41a647f0a018" #edb/ref 17592186045417] [17592186539034 #edb/ref 1063 #edb/ref 17592186180196 #edb/ref 17592186045417] [17592186539039 #edb/ref 1058 #edb/ref 17592186539085 #edb/ref 17592186045417] [17592186539039 #edb/ref 1062 #uuid "172148fe-3677-57da-8f6c-98b28a4c7cad" #edb/ref 17592186045417] [17592186539039 #edb/ref 1063 #edb/ref 17592186538958 #edb/ref 17592186045417] [17592186539042 #edb/ref 1058 #edb/ref 17592186539052 #edb/ref 17592186045417] [17592186539042 #edb/ref 1062 #uuid "1b023f9e-0298-554e-be5a-bf787