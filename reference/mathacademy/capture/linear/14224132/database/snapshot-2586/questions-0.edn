#{[{:db/id #edb/ref 17592186538931 :knowledge-point/_questions [{:db/id #edb/ref 17592186068805 :knowledge-point/id #uuid "6a17d9d6-cd3a-554e-98d2-7e9536950bd0" :knowledge-point/title "Simplifying Rational Expressions With Common Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ce13ca6-d5e6-5b02-ab83-62b67c2cdc93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{b+1}{5}" :db/id #edb/ref 17592186538325} {:answer/id #uuid "619ad907-0a2a-5821-9c37-e4029921ecaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5b" :db/id #edb/ref 17592186538447} {:answer/id #uuid "8dd81113-32ec-576c-9e41-04155f79e7cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b" :db/id #edb/ref 17592186538564} {:answer/id #uuid "c9e73284-4757-5b87-9887-ae2ae7a64acb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{b}{2}" :db/id #edb/ref 17592186538702} {:answer/id #uuid "f68b0f15-04cc-531c-b14c-bf199686b9c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{b}{5}" :db/id #edb/ref 17592186538792}] :answer-field/correct {:answer/id #uuid "f68b0f15-04cc-531c-b14c-bf199686b9c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{b}{5}" :db/id #edb/ref 17592186538792} :answer-field/id #uuid "d3e29b2d-1ff0-5f42-aa69-6c73bafc3de3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538902}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1a5f882d-4cbf-515d-b127-b49f03d6e601" :question/math-academy-id "q-100082" :question/problem "$\\frac{ab+3b}{5a+15}=$" :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\\frac{ab+3b}{5a+15} & =\\frac{b(a+3)}{5(a+3)} \\\\  & =\\frac{b\\cancel{(a+3)}}{5\\cancel{(a+3)}} \\\\  & =\\frac{b}{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538973 :knowledge-point/_questions [{:db/id #edb/ref 17592186100884 :knowledge-point/id #uuid "da02158c-c59e-5639-9d0c-625c0ff285e0" :knowledge-point/title "Applying the Power Rule With Positive Integer Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f022127-d74b-55a7-8f4c-f8623a061707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5}^{4}" :db/id #edb/ref 17592186538400} {:answer/id #uuid "66d0e1b8-9de0-50bc-8350-6ec16a899b0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5}^{-6}" :db/id #edb/ref 17592186538461} {:answer/id #uuid "7ea689a6-5d05-5a18-970a-aa6ffffe514a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5}^{16}" :db/id #edb/ref 17592186538521} {:answer/id #uuid "88a4255a-384a-5ba3-a4d1-abf9e134d73c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5}^{1/4}" :db/id #edb/ref 17592186538549} {:answer/id #uuid "f21b257e-8b46-5f90-97c2-a38980068b7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5}^{6}" :db/id #edb/ref 17592186538779}] :answer-field/correct {:answer/id #uuid "7ea689a6-5d05-5a18-970a-aa6ffffe514a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5}^{16}" :db/id #edb/ref 17592186538521} :answer-field/id #uuid "484bbd2f-f0f3-595b-80b3-5e018f4704f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538840}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6ff4ab80-f137-5311-afce-bd7745588b1f" :question/math-academy-id "q-100380" :question/problem "${({5}^{2})}^{8}=$" :question/worked-solution "To raise a power to another power, we simply multiply the exponents:\n\n$$\n{({5}^{2})}^{8}={5}^{2\\cdot 8}={5}^{16}\n$$"}] [{:db/id #edb/ref 17592186538938 :knowledge-point/_questions [{:db/id #edb/ref 17592186188374 :knowledge-point/id #uuid "b93a6e36-3ec9-5451-92c0-a534f2776cf1" :knowledge-point/title "Distributing the Negative Sign Before Simplifying: Negative Terms in Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06a93b05-ba04-5b12-b9af-ad0b8b110e94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6q-9" :db/id #edb/ref 17592186538248} {:answer/id #uuid "adf2da43-a52a-5c4e-a6cc-d107314f80ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7q-9" :db/id #edb/ref 17592186538643} {:answer/id #uuid "b3413e8a-2ffd-566c-9eeb-e2b5771ed2a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7q+9" :db/id #edb/ref 17592186538651} {:answer/id #uuid "e6f8dd87-eed3-5563-a9b9-ebac8afe85be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5q-9" :db/id #edb/ref 17592186538758} {:answer/id #uuid "fc2542d6-6523-51ba-a6d9-3c06637ea467" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5q+9" :db/id #edb/ref 17592186538801}] :answer-field/correct {:answer/id #uuid "b3413e8a-2ffd-566c-9eeb-e2b5771ed2a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7q+9" :db/id #edb/ref 17592186538651} :answer-field/id #uuid "ac226765-7bac-59c7-b218-c5a2ec7022c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538887}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2eb696c5-dbcf-5ba0-8d82-82e64e6ac266" :question/math-academy-id "q-144246" :question/problem "Simplify the expression $-6q-(q-9).$" :question/worked-solution "First, we remove the parentheses by distributing the negative sign. This gives\n\n$$\n-6q-q+9\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}-6q-q+9 & = \\\\ (-6q-q)+9 & = \\\\ -7q+9 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538994 :knowledge-point/_questions [{:db/id #edb/ref 17592186179819 :knowledge-point/id #uuid "ddf13639-8d18-5909-a26d-aeda1e011ac0" :knowledge-point/title "Finding a Missing Percent Given Two Numbers Without Simplification"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "636f630e-1585-5d67-9b3a-b428c2059647" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3%" :db/id #edb/ref 17592186538453} {:answer/id #uuid "8bba908b-7b88-591d-9f27-10a6d6474d41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30%" :db/id #edb/ref 17592186538559} {:answer/id #uuid "a4fdf384-ba3c-5858-811d-9e8ebbd7a9d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15%" :db/id #edb/ref 17592186538623} {:answer/id #uuid "b9bd8e18-0ed8-549b-baca-f19c0ee012e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5%" :db/id #edb/ref 17592186538666} {:answer/id #uuid "d4c09eab-8139-5090-a8f7-d565e4fcf770" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50%" :db/id #edb/ref 17592186538725}] :answer-field/correct {:answer/id #uuid "8bba908b-7b88-591d-9f27-10a6d6474d41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30%" :db/id #edb/ref 17592186538559} :answer-field/id #uuid "41e9ad24-438d-57bd-ba9c-a67eeb3fb7b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538838}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aa408be7-da1f-5fc4-a78a-e723f9d79c8a" :question/math-academy-id "q-147015" :question/problem "On a field trip to a theme park, $150$ students out of $500$ rode a roller coaster. What percentage of students rode a roller coaster?" :question/worked-solution "We're given a part and a whole, and we must find a percentage. So, we can use the following formula:\n\n$$\n\\text{percentage}=\\text{part}÷\\text{whole}\n$$\n\nIn this case, \n\n- the part is the number of students who rode a roller coaster, which is $150,$ and\n\n- the whole is the total number of students, which is $500.$\n\nSubstituting our numbers into the above formula, we get\n\n$$\n\\text{percentage}=150÷500=\\frac{150}{500}.\n$$\n\nTo write this as a percentage, we create an equivalent fraction with $100$ as the denominator:\n\n$$\n\\frac{150}{500}=\\frac{150÷5}{500÷5}=\\frac{30}{100}\n$$\n\nNow we can write this fraction as a percentage:\n\n$$\n\\frac{30}{100}=30%\n$$\n\nTherefore, $30%$ of the students rode a roller coaster."}] [{:db/id #edb/ref 17592186539012 :knowledge-point/_questions [{:db/id #edb/ref 17592186138395 :knowledge-point/id #uuid "afa8c578-f074-5c70-a6d8-7ad3fb059961" :knowledge-point/title "Writing a Quotient of Two Square Roots as a Single Square Root"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "214f06c9-269c-5297-8072-2fc4c14d1161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186538302} {:answer/id #uuid "92f7dcf3-bce8-5e12-9d2d-664d1ee3e079" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186538578} {:answer/id #uuid "bb25796f-9522-5605-a975-c954e0e74db7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186538671} {:answer/id #uuid "c5935f44-9284-5e50-ad97-9e76e3d58d51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186538692} {:answer/id #uuid "dc5cd460-758d-5cb8-9c18-0dd8dd19996a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186538738}] :answer-field/correct {:answer/id #uuid "214f06c9-269c-5297-8072-2fc4c14d1161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186538302} :answer-field/id #uuid "ba64d127-ec18-5cc5-bddf-f9699c0c0733" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538895}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d1265e4c-79e5-5207-9e53-54ea1660d1ab" :question/math-academy-id "q-152350" :question/problem "Evaluate $\\frac{\\sqrt{20}}{\\sqrt{5}}.$" :question/worked-solution "A quotient of square roots of two positive numbers is equal to the square root of the quotient of the numbers. Therefore,\n\n$$\n\\frac{\\sqrt{20}}{\\sqrt{5}}=\\sqrt{\\frac{20}{5}}=\\sqrt{4}=2\n$$"}] [{:db/id #edb/ref 17592186538992 :knowledge-point/_questions [{:db/id #edb/ref 17592186073898 :knowledge-point/id #uuid "1d9b6948-92f4-58b3-8c06-fae61765dc57" :knowledge-point/title "Finding the Horizontal Distance Between Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "061081df-b561-5c2b-a708-36f7986d4b73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186538247} {:answer/id #uuid "0c893fd0-6f85-52b1-b076-b8fc122a706c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186538263} {:answer/id #uuid "79fbcb7d-ca45-560f-bbc1-ad45a7ac1165" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186538510} {:answer/id #uuid "bbccc7c4-2626-5ed7-bf9f-6d5b1ca3e586" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186538674} {:answer/id #uuid "d9b8ad62-7088-5547-8eb6-36cbe9e7385c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186538731}] :answer-field/correct {:answer/id #uuid "0c893fd0-6f85-52b1-b076-b8fc122a706c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186538263} :answer-field/id #uuid "9ff2eb55-30cd-5edc-8e06-8e29569ebd8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538884}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a94dc93f-684c-5299-b244-16888ab7a25a" :question/math-academy-id "q-160305" :question/problem "What is the distance between the points $(1,-3)$  and $(5,-3)?$" :question/worked-solution "**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/b3/b3a34b10cf329cea0e80959562484c07316a582d55395f8bf7aa951d2aca8567.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $4$ units, so the distance equals $4.$\n\n![](images/15/15afca52169a74eb433654bc992cc3d19e191a92704d7d845d0c49071800052e.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $y$-axis and then subtracting.\n\n![](images/72/7298280773fb08b221742571e76ba5f422a77a2e70abd4b94085d602a196e8a7.png)\n\nThe point $(1,-3)$ is at a distance of $1$ from the $y$-axis, and the point $(5,-3)$ is at a distance of $5$ from the $y$-axis. Therefore, the distance between the two points is $5-1=4.$"}] [{:db/id #edb/ref 17592186538937 :knowledge-point/_questions [{:db/id #edb/ref 17592186054836 :knowledge-point/id #uuid "712bc4c6-aeaf-5081-9e64-791027b38963" :knowledge-point/title "Linear Equations Requiring Multiplication by a Negative Integer"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e08ccbd4-8902-537c-bf90-b675fffaa98d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186538746}] :answer-field/correct {:answer/id #uuid "e08ccbd4-8902-537c-bf90-b675fffaa98d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186538746} :answer-field/id #uuid "ffbb06e8-1787-59c8-b541-824a6fbe128b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186538924}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2c9f2909-7e69-5612-95f1-1f03b540b4de" :question/math-academy-id "q-175591" :question/problem "If $-\\frac{x}{12}=-\\frac{1}{6},$ then $x=${{field-1}}." :question/worked-solution "First, let's remove the negative sign from the variable. To do this, we multiply both sides of the equation by $-1.$\n\n$$\n\\begin{aligned}-\\frac{x}{12} & =-\\frac{1}{6} \\\\ (-1)\\cdot (-\\frac{x}{12}) & =(-1)\\cdot (-\\frac{1}{6}) \\\\ \\frac{x}{12} & =\\frac{1}{6}\\end{aligned}\n$$\n\nIn the equation above, $x$ is being divided by $12.$ To isolate $x$, we can perform the opposite operation, which is *multiplying* by $12.$ So, we multiply both sides of the equation by $12$ and simplify.\n\n$$\n\\begin{aligned}\\frac{x}{12} & =\\frac{1}{6} \\\\ 12\\cdot \\frac{x}{12} & =12\\cdot \\frac{1}{6} \\\\ \\frac{12x}{12} & =\\frac{12}{6} \\\\ \\frac{\\cancel{12}x}{\\cancel{12}} & =2 \\\\ x & =2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538948 :knowledge-point/_questions [{:db/id #edb/ref 17592186133964 :knowledge-point/id #uuid "de683deb-e208-59ef-9110-7523dd22ce2a" :knowledge-point/title "Evaluating a Sum or Difference"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "768779f2-cfcd-52c5-945b-acc0d08b63b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186538500}] :answer-field/correct {:answer/id #uuid "768779f2-cfcd-52c5-945b-acc0d08b63b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186538500} :answer-field/id #uuid "97a23528-f8a8-5a73-9c66-2133c045b42e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186538881}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3d20e092-7a52-54cf-904a-8aa79d562ce0" :question/math-academy-id "q-175877" :question/problem "If $r=1,$ then $\\frac{7r}{15}+\\frac{6}{5r}=${{field-1}}." :question/worked-solution "We replace $r$ with $1$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{7r}{15}+\\frac{6}{5r} & = \\\\ \\frac{7\\cdot 1}{15}+\\frac{6}{5\\cdot 1} & = \\\\ \\frac{7}{15}+\\frac{6}{5} & = \\\\ \\frac{7}{15}+\\frac{18}{15} & = \\\\ \\frac{7+18}{15} & = \\\\ \\frac{25}{15} & = \\\\ \\frac{5}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538941 :knowledge-point/_questions [{:db/id #edb/ref 17592186073895 :knowledge-point/id #uuid "6e3287b0-2ecb-5d83-9596-7943d68f8884" :knowledge-point/title "Filling a Ratio Table by Multiplying: Missing Numerators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "463db585-bf6f-5e0d-931b-df42f52effc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186538376}] :answer-field/correct {:answer/id #uuid "463db585-bf6f-5e0d-931b-df42f52effc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186538376} :answer-field/id #uuid "66177e54-eef7-56db-8506-df97e08453b7" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186538858} {:answer-field/choices [{:answer/id #uuid "96ef42ad-1530-5d58-820a-ff5c2f14ae67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186538589}] :answer-field/correct {:answer/id #uuid "96ef42ad-1530-5d58-820a-ff5c2f14ae67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186538589} :answer-field/id #uuid "9dd4ab96-7951-5e84-ab6e-c18317468cbb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186538882}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "321e819d-21c6-5c8d-a9d3-36abfa3818e4" :question/math-academy-id "q-186859" :question/problem "Complete the ratio table below.\n\n| $7$ | $2$ |\n| --- | --- |\n| {{field-1}} | $6$ |\n| {{field-2}} | $20$ |" :question/worked-solution "We start with the ratio $7:2$ and write it as a fraction:\n\n$$\n\\frac{7}{2}\n$$\n\nSo the numerator represents the left-hand entry ($7$), and the denominator represents the right-hand entry ($2$).\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n- To create a denominator of $6,$ we multiply the numerator and denominator of our fraction by $3:$\n\n$$\n\\frac{7\\times 3}{2\\times 3}=\\frac{21}{6}\n$$\n\n- To create a denominator of $20,$ we multiply the numerator and denominator of our fraction by $10:$\n\n$$\n\\frac{7\\times 10}{2\\times 10}=\\frac{70}{20}\n$$\n\nFinally, we fill in the ratio table:\n\n| $7$ | $2$ |\n| --- | --- |\n| $21$ | $6$ |\n| $70$ | $20$ |\n\n$$\n\n$$"}] [{:db/id #edb/ref 17592186538958 :knowledge-point/_questions [{:db/id #edb/ref 17592186138389 :knowledge-point/id #uuid "29217571-4597-5bbe-aecd-0d9a1d1aa1c1" :knowledge-point/title "Bounding Areas and Volumes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e8198dd-99e8-5974-9e10-f4ef8ff6411d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.1" :db/id #edb/ref 17592186538360}] :answer-field/correct {:answer/id #uuid "3e8198dd-99e8-5974-9e10-f4ef8ff6411d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.1" :db/id #edb/ref 17592186538360} :answer-field/id #uuid "2db24a1f-2dcc-5861-b3c8-b74405c19baa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186538827}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "559e7325-1f2d-5d6d-99bc-9f9ffa4b9d3b" :question/math-academy-id "q-218724" :question/problem "The dimensions of a package in the shape of a rectangular solid are $0.9\\,\\text{m}\\times 0.9\\,\\text{m}\\times 1.2\\,\\text{m},$ where each dimension was measured to the nearest $0.1\\,\\text{m}.$ Rounded to the nearest tenth of a cubic meter, what is the upper bound for the volume of the package?\n\nTo the nearest tenth of a cubic meter, the upper bound for the volume of the package is\n{{field-1}}${\\text{m}}^{3}.$" :question/worked-solution "Each dimension is given to the nearest $0.1\\,\\text{m}.$ So, the greatest possible error of these measurements is\n\n$$\n\\frac{0.1\\,\\text{m}}{2}=0.05\\,\\text{m}.\n$$\n\nWe wish to find the *upper bound* for the volume of the package. Therefore, we require the *upper bound* of each dimension.\n\nThe upper bounds for each dimension are as follows:\n\n$$\n\\begin{aligned} & 0.9\\,\\text{m}+0.05\\,\\text{m}=0.95\\,\\text{m} \\\\  & 0.9\\,\\text{m}+0.05\\,\\text{m}=0.95\\,\\text{m} \\\\  & 1.2\\,\\text{m}+0.05\\,\\text{m}=1.25\\,\\text{m}\\end{aligned}\n$$\n\nSo, the upper bound for the volume of the package is\n\n$$\n\\begin{aligned}V & =0.95\\,\\text{m}\\times 0.95\\,\\text{m}\\times 1.25\\,\\text{m} \\\\  & =1.128\\,125\\,{\\text{m}}^{3} \\\\  & ≈1.1\\,{\\text{m}}^{3},\\end{aligned}\n$$\n\nrounded to the nearest tenth of a cubic meter."}] [{:db/id #edb/ref 17592186538930 :knowledge-point/_questions [{:db/id #edb/ref 17592186054704 :knowledge-point/id #uuid "2253ac13-3eee-5385-b774-8340a57b468e" :knowledge-point/title "Using the Product Rule with Two Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3845d877-6bd4-5d91-90a1-af898b1484f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{8}" :db/id #edb/ref 17592186538348} {:answer/id #uuid "6117f495-7121-52e2-8094-cb58ab6a31c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{12}" :db/id #edb/ref 17592186538445} {:answer/id #uuid "7872b3f6-c2d7-5cae-9ed4-21e7de27441c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{7}" :db/id #edb/ref 17592186538505} {:answer/id #uuid "a2cd87da-b89d-562c-81bd-4756e6c1e055" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{z}^{12}}" :db/id #edb/ref 17592186538619} {:answer/id #uuid "b9de8e18-f770-596b-8f87-37d29419a8d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{z}^{7}}" :db/id #edb/ref 17592186538668}] :answer-field/correct {:answer/id #uuid "7872b3f6-c2d7-5cae-9ed4-21e7de27441c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{7}" :db/id #edb/ref 17592186538505} :answer-field/id #uuid "3b9fc6f8-b371-50fb-914d-71a4829c2da7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538834}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "16bce723-03c6-53a5-b2a1-c812d455c8ee" :question/math-academy-id "q-2893" :question/problem "${z}^{4}\\cdot {z}^{3}=$" :question/worked-solution "We add the exponents, as follows:\n\n$$\n\\begin{aligned}{z}^{4}\\cdot {z}^{3} & = \\\\ {z}^{4+3} & = \\\\ {z}^{7}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186180196 :knowledge-point/_questions [{:db/id #edb/ref 17592186179808 :knowledge-point/id #uuid "d7450aff-4876-5522-b0d6-8abb41b45799" :knowledge-point/title "Simplifying Expressions Containing Square Root Surds"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f24ac7c-d545-5f8f-8ab4-e001f44e5d25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186178721} {:answer/id #uuid "1697916d-04a7-5927-b549-9b41576aa948" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186178722} {:answer/id #uuid "37667bb2-d570-5cc1-8a08-21c257e3c558" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186178723} {:answer/id #uuid "3809cf2c-906f-5d23-b661-f94c9613ea55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186178724} {:answer/id #uuid "43d6ac53-8e2d-502b-acb1-6d10b3a5e43d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186178725}] :answer-field/correct {:answer/id #uuid "3809cf2c-906f-5d23-b661-f94c9613ea55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186178724} :answer-field/id #uuid "1c7a255b-8fbd-55cd-be4c-153c5fe41cd4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186178720}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1d92da08-8917-5c11-931f-ed827ad0de00" :question/math-academy-id "q-43320" :question/problem "Find the value of $\\sqrt{6}\\cdot \\sqrt{6}.$" :question/worked-solution "First, we re-write the expression as a square:\n\n$$\n\\sqrt{6}\\cdot \\sqrt{6}={(\\sqrt{6})}^{2}.\n$$\n\nThe square and the square root cancel each other out. So, we have\n\n$$\n{(\\sqrt{6})}^{2}=6.\n$$"}] [{:db/id #edb/ref 17592186538925 :knowledge-point/_questions [{:db/id #edb/ref 17592186054626 :knowledge-point/id #uuid "2a5017c8-1933-515c-980a-c4b6a8a46334" :knowledge-point/title "Evaluating an Expression With One Absolute Value"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75a73616-ab8e-5249-82f7-799217148a45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186538496} {:answer/id #uuid "814754b2-feec-5136-8547-cfc2e665b61d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186538528} {:answer/id #uuid "856f9595-dbf4-559e-9f4d-df0237a10ae6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186538540} {:answer/id #uuid "a4f58672-871b-5f7b-8d92-49cac8f25855" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186538622} {:answer/id #uuid "e39af841-1c95-5377-adaa-4d5f09e4348c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186538751}] :answer-field/correct {:answer/id #uuid "814754b2-feec-5136-8547-cfc2e665b61d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186538528} :answer-field/id #uuid "b02a4e9f-a6b5-5fbf-a084-8bd7198a24e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538888}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "00b7055c-6f6b-518a-86a9-ac2dadfdf918" :question/math-academy-id "q-52025" :question/problem "Evaluate $|4y+6{|}^{3}$ for $y=-2.$" :question/worked-solution "We substitute $y=-2$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|4y+6{|}^{3} & = \\\\ |4(-2)+6{|}^{3} & = \\\\ |-8+6{|}^{3} & = \\\\ |-2{|}^{3} & = \\\\ {2}^{3} & = \\\\ 8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538966 :knowledge-point/_questions [{:db/id #edb/ref 17592186096678 :knowledge-point/id #uuid "1ff8566a-bc65-50a8-bd72-354631883152" :knowledge-point/title "Subtracting a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "005a8c2d-2986-5382-a9a7-8d0925088970" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16.7\\,\\text{m}" :db/id #edb/ref 17592186538235} {:answer/id #uuid "4938059d-e5e9-5e0a-bafb-c6bde99e4272" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17.3\\,\\text{m}" :db/id #edb/ref 17592186538384} {:answer/id #uuid "4ed3f262-549e-5f94-906f-e38321fcff36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11.7\\,\\text{m}" :db/id #edb/ref 17592186538398} {:answer/id #uuid "59591069-9f03-5eff-82cf-fc8067fe4232" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14.5\\,\\text{m}" :db/id #edb/ref 17592186538423} {:answer/id #uuid "ed677ee1-ade4-5373-be60-21612e095897" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13.3\\,\\text{m}" :db/id #edb/ref 17592186538775}] :answer-field/correct {:answer/id #uuid "005a8c2d-2986-5382-a9a7-8d0925088970" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16.7\\,\\text{m}" :db/id #edb/ref 17592186538235} :answer-field/id #uuid "17ceb33e-7e12-5ea8-88a3-31715bc9a70f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538812}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "65afe218-5b40-51ad-8f32-78468d52b1c6" :question/math-academy-id "q-68483" :question/problem "Sophia and Charlie decide to go to the sea to study some marine species. While Charlie dives $14.2$ meters below sea level, Sophia waits for him in the boat, $2.5$ meters above sea level. How many meters above Charlie is Sophia?" :question/worked-solution "To determine the distance between Charlie and Sophia, we must calculate the difference between Sophia's location and Charlie's location. This gives\n\n$$\n2.5-(-14.2)=2.5+14.2=16.7\\,\\text{m}.\n$$\n\nThus, Sophia is located $16.7\\,\\text{m}$ above Charlie."}] [{:db/id #edb/ref 17592186539005 :knowledge-point/_questions [{:db/id #edb/ref 17592186129111 :knowledge-point/id #uuid "525486fb-d976-57a5-b6bd-c33f19177a3f" :knowledge-point/title "Applying the Power of Product Rule to Expressions with Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46ee4abf-f8a1-5118-9471-a54db96f45a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{7}\\times {(\\frac{1}{5})}^{5}" :db/id #edb/ref 17592186538378} {:answer/id #uuid "69e93b7b-b1d1-5cb1-973f-7ccaf1e39a29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{4}^{5}}{7\\times 5}" :db/id #edb/ref 17592186538469} {:answer/id #uuid "cb92c9ab-11a4-5e5d-bb15-e3eb6dedabbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{4}{7})}^{5}\\times \\frac{1}{5}" :db/id #edb/ref 17592186538706} {:answer/id #uuid "d0058a23-5040-59e0-a92d-9b29b1549ea3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{4}{7})}^{5}\\times {(\\frac{1}{5})}^{5}" :db/id #edb/ref 17592186538715} {:answer/id #uuid "d6feceb1-2fa4-5151-ba55-921a2c546541" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{{7}^{5}\\times {5}^{5}}" :db/id #edb/ref 17592186538729}] :answer-field/correct {:answer/id #uuid "d0058a23-5040-59e0-a92d-9b29b1549ea3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{4}{7})}^{5}\\times {(\\frac{1}{5})}^{5}" :db/id #edb/ref 17592186538715} :answer-field/id #uuid "544faafb-45af-51f7-9886-1c44cb2fbaea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538847}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c32986e7-9010-5588-b701-72ad7388c062" :question/math-academy-id "q-68615" :question/problem "${(\\frac{4}{7}\\times \\frac{1}{5})}^{5}=$" :question/worked-solution "To raise the product of two numbers to the power of $5$, we can raise each number to the power of $5,$ and then multiply:\n\n$$\n{(\\frac{4}{7}\\times \\frac{1}{5})}^{4}={(\\frac{4}{7})}^{5}\\times {(\\frac{1}{5})}^{5}\n$$"}] [{:db/id #edb/ref 17592186055465 :knowledge-point/_questions [{:db/id #edb/ref 17592186054608 :knowledge-point/id #uuid "4cc66e18-1adb-5bec-a6c6-f434ebf4ed13" :knowledge-point/title "Evaluating Expressions With Exponents Inside Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bbf1f72-06b0-520d-bcce-fe7a87516e0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{24}" :db/id #edb/ref 17592186054028} {:answer/id #uuid "2ed13fb1-485e-541f-8244-edff58a9edcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186054029} {:answer/id #uuid "402ab3f3-62da-5651-83a1-94331abbd494" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186054030} {:answer/id #uuid "5d896cad-d52b-57a0-9b03-cd6b8039620e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{24}" :db/id #edb/ref 17592186054031} {:answer/id #uuid "601b00f5-8338-5dfb-9271-e19b674aab25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186054032}] :answer-field/correct {:answer/id #uuid "5d896cad-d52b-57a0-9b03-cd6b8039620e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{24}" :db/id #edb/ref 17592186054031} :answer-field/id #uuid "adf83468-7688-50ec-b222-9820046725f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186054027}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a406bc65-b6be-5e0c-9457-9bc53f06a1e8" :question/math-academy-id "q-68933" :question/problem "Evaluate $(-\\frac{1}{3})÷((-4)^{3}÷8).$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, consider the expression inside the parentheses:\n\n$$\n\\begin{aligned}(-4)^{3}÷8\\end{aligned}\n$$\n\nApplying PEMDAS to this expression, we obtain:\n\n$$\n\\begin{aligned}(-4)^{3}÷8 & = \\\\ (-64)÷8 & = \\\\ \\frac{(-64)}{8} & = \\\\ -8\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}(-\\frac{1}{3})÷((-4)^{3}÷8) & = \\\\ (-\\frac{1}{3})÷(-8) & = \\\\ (-\\frac{1}{3})\\times (-\\frac{1}{8}) & = \\\\ \\frac{1\\times 1}{3\\times 8} & = \\\\ \\frac{1}{24}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539025 :knowledge-point/_questions [{:db/id #edb/ref 17592186110777 :knowledge-point/id #uuid "c81cf5ed-8dd7-5174-b8e9-faf63bf0a278" :knowledge-point/title "Identifying a Quadrilateral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2787cafa-a6f3-58c4-b71c-39cfde6628a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ only" :db/id #edb/ref 17592186538312} {:answer/id #uuid "3c8a3747-978e-5a04-88f7-efa162deb1c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $S$ only" :db/id #edb/ref 17592186538356} {:answer/id #uuid "7def0cb6-38af-5e1c-b013-868d0d71acb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $Q$ only" :db/id #edb/ref 17592186538520} {:answer/id #uuid "8806f6ae-2cc6-53d6-ac93-06345cc19aaa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ only" :db/id #edb/ref 17592186538546} {:answer/id #uuid "a5c84333-4a31-51e6-83f2-46286a208fb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ only" :db/id #edb/ref 17592186538628}] :answer-field/correct {:answer/id #uuid "8806f6ae-2cc6-53d6-ac93-06345cc19aaa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ only" :db/id #edb/ref 17592186538546} :answer-field/id #uuid "c19895f8-96a3-5287-94da-9de297a507c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538898}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ee602985-c91d-54be-9eef-bda0850e7e34" :question/math-academy-id "q-74588" :question/problem "![](images/cb/cb0fa52f4f74145ee88e73f3f4c62d96d6b8261533844b4c8021d30cae8e41d0.png)\n\nWhich of the figures above is a rectangle?" :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nRemember that a rectangle is a quadrilateral where all angles are right and has two pairs of parallel sides.\n\nWith that in mind, let's look at each shape in turn.\n\n- The shape $P$ is an isosceles trapezoid. It has only one pair of parallel sides, not two, therefore, it is not a rectangle.\n\n- The shape $Q$ is a parallelogram. It has no right angles, therefore, it is not a rectangle.\n\n- The shape $R$ is a rhombus. Since it has no right angles, it is not a rectangle.\n\n- The shape $S$ is a rectangle since all its angles are right.\n\nTherefore, shape $S$ is a rectangle. The shapes $P,$ $Q,$ and $R$ are not rectangles."}]}
