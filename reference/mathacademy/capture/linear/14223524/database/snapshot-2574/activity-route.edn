#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186536923} :activity/id #uuid "eb79a318-5511-5bc9-8fb1-da2775c300ce" :activity/scope {:db/id #edb/ref 17592186048470 :topic/id #uuid "a249df7c-110c-5944-a303-74505130a629" :topic/math-academy-id 28} :activity/steps [{:db/id #edb/ref 17592186536923 :step/content {:db/id #edb/ref 17592186055516 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83ff33ee-caa6-51d8-958d-bfcfda022a62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186054334} {:answer/id #uuid "ac037dd2-aa67-5dda-91e5-2a864d1cc729" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186054335} {:answer/id #uuid "c8f7a19d-57a8-550f-b117-e9656ddde586" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186054336} {:answer/id #uuid "d8bc585d-ed81-566c-b6a6-a612bcdd6c87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186054337} {:answer/id #uuid "05d90b4d-f42c-59f3-afaf-50adcb8c8df2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186054338}] :answer-field/correct {:db/id #edb/ref 17592186054334} :answer-field/id #uuid "15a9598e-3841-5a8c-b408-bd666ace4326" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186054333}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2013c32c-5fa6-5fa3-be49-a548908a8a84" :question/math-academy-id "q-957" :question/problem "Calculate ${log}_{9}⁡(27)$ without using a calculator." :question/worked-solution "We use the change of base formula:\n\n$$\n{log}_{a}⁡X=\\frac{{log}_{b}⁡X}{{log}_{b}⁡a}\n$$\n\nIn our case, $a=9,$ and $X=27.$ Since both $a$ and $X$ are powers of $3,$ we set $b=3.$ So, we have:\n\n$$\n\\begin{aligned}{log}_{9}⁡(27) & =\\frac{{log}_{3}⁡(27)}{{log}_{3}⁡(9)} \\\\  & =\\frac{{log}_{3}⁡({3}^{3})}{{log}_{3}⁡({3}^{2})} \\\\  & =\\frac{3}{2}\\end{aligned}\n$$"} :step/id #uuid "409e70f3-f977-5ff5-a585-4d5c522e0865" :step/next {:db/id #edb/ref 17592186536927}} {:db/id #edb/ref 17592186536927 :step/content {:db/id #edb/ref 17592186536891 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08d743ce-fa5c-525f-8823-17339a57955f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.88" :db/id #edb/ref 17592186536298} {:answer/id #uuid "2a34da52-d120-5dcc-93a2-7d72465b9e80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.35" :db/id #edb/ref 17592186536347} {:answer/id #uuid "57f3fce6-97f1-54f3-9d05-c42e5d7d1c65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.28" :db/id #edb/ref 17592186536439} {:answer/id #uuid "79abcb54-0989-52b4-ab9d-387cf2aef302" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.63" :db/id #edb/ref 17592186536486} {:answer/id #uuid "7d80df60-47c8-599f-a716-04722fc55d5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.48" :db/id #edb/ref 17592186536492}] :answer-field/correct {:db/id #edb/ref 17592186536439} :answer-field/id #uuid "b6dad051-9aa8-5418-a3f1-657be400f97d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536776}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "da9958bc-8f70-50e7-9f99-fa451b16875b" :question/math-academy-id "q-100672" :question/problem "Use a calculator to evaluate ${log}_{7}⁡(12)$ rounded to $2$ decimal places." :question/worked-solution "Let's calculate ${log}_{7}⁡(12)$ by changing the base $7$ to the common logarithm (base $10$).\n\nWe use the change of base formula:\n\n$$\n{log}_{a}⁡X=\\frac{{log}_{b}⁡X}{{log}_{b}⁡a}\n$$\n\nIn our case, $a=7,$ $X=12,$ $b=10.$ So, we have\n\n$$\n\\begin{aligned}{log}_{7}⁡(12) & =\\frac{{log}_{10}⁡(12)}{{log}_{10}⁡(7)} \\\\  & =\\frac{\\operatorname{log}⁡(12)}{\\operatorname{log}⁡(7)} \\\\  & ≈\\frac{1.079\\,18}{0.845\\,10} \\\\  & ≈1.28\\end{aligned}\n$$"} :step/id #uuid "5211543f-481e-5068-88ce-29a7dad1cf34" :step/next {:db/id #edb/ref 17592186536960}} {:db/id #edb/ref 17592186536960 :step/content {:db/id #edb/ref 17592186536896 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23897a01-3104-53af-ae5c-e8c22b2f28ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186536335} {:answer/id #uuid "4cde3fc2-93fa-5b19-a0da-c6b974156e8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186536411} {:answer/id #uuid "7a564c7d-cc32-50b9-b0d1-9b64ae3f4ac0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186536489} {:answer/id #uuid "87d2482c-4c9c-5bd0-9062-e840a46ef7d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186536505} {:answer/id #uuid "ed54b21e-804e-52cf-85a5-0db316e72703" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186536660}] :answer-field/correct {:db/id #edb/ref 17592186536411} :answer-field/id #uuid "15f3278f-b153-5a85-8c35-53f0388ef9ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536707}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f38bc0fe-199e-5ced-bb28-b4453873ecf1" :question/math-academy-id "q-100679" :question/problem "Calculate ${log}_{36}⁡(216)$ without using a calculator." :question/worked-solution "We use the change of base formula:\n\n$$\n{log}_{a}⁡X=\\frac{{log}_{b}⁡X}{{log}_{b}⁡a}\n$$\n\nIn our case, $a=36,$ and $X=216.$ Since both $a$ and $X$ are powers of $6,$ we set $b=6.$ So, we have:\n\n$$\n\\begin{aligned}{log}_{36}⁡(216) & =\\frac{{log}_{6}⁡(216)}{{log}_{6}⁡(36)} \\\\  & =\\frac{{log}_{6}⁡({6}^{3})}{{log}_{6}⁡({6}^{2})} \\\\  & =\\frac{3}{2}\\end{aligned}\n$$"} :step/id #uuid "affa6b9a-f43e-533b-b8e7-69b223dcfdc8"}] :activity/title "The Change of Base Formula for Logarithms" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186536284}]}
