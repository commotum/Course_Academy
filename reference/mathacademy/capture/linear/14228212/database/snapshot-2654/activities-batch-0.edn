#{[{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186101702} :activity/id #uuid "40df638a-5935-51ad-9df2-3b9723b349d4" :activity/scope {:db/id #edb/ref 17592186050085 :topic/id #uuid "2c0b4af5-6010-5e83-8fcc-56c647d1ade5" :topic/math-academy-id 1254} :activity/steps [{:db/id #edb/ref 17592186101702 :step/content {:db/id #edb/ref 17592186101971 :tutorial/content "Now that we're familiar with graph translations, reflections, and stretches, it's time to combine these transformations. \n\nWe start by considering a general transformation of the form\n\n$$\ny = af\\left(b(x+c)\\right)+d\n$$\n\nLike the order of operations in arithmetic, the order in which transformations are applied matters. In general, the order *must* be as follows:\n\n1\\. Horizontal stretch\n\n2\\. Horizontal translation\n\n3\\. Vertical stretch\n\n4\\. Vertical translation\n\nIf that seems like a lot to take in, we have the following rule of thumb that can help us to remember the order in which to apply the transformations:\n\n- We start by performing the transformations *inside* the argument of $f.$ This means we first deal with the $b(x+c)$ part. So, we *first* carry out the horizontal stretch, *followed by* the horizontal translation.\n\n- Then, we perform the transformations *outside* the argument of $f.$ So, we *first* carry out the vertical stretch, *followed by* the vertical translation.\n\nFinally, note that not every transformation will necessarily be present. In this lesson, we will consider a maximum of two graph transformations." :tutorial/id #uuid "a2fc2824-fd51-5bc6-8c19-7bbf7b92a6c9" :tutorial/math-academy-id 3287 :tutorial/title "Introduction"} :step/id #uuid "f02fd6ea-5c46-55f5-9d51-710cd19982f3" :step/math-academy-id 18036 :step/next {:db/id #edb/ref 17592186101703}} {:db/id #edb/ref 17592186101703 :step/content {:db/id #edb/ref 17592186100886 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100710 :question/id #uuid "34af9714-5109-59b7-90cb-a85c52399759" :question/math-academy-id "e-4986"} :knowledge-point/id #uuid "a4aee0a3-1694-5a48-a21d-afd11f01889f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050491} {:db/id #edb/ref 17592186050647}] :knowledge-point/questions [{:db/id #edb/ref 17592186101554} {:db/id #edb/ref 17592186101558} {:db/id #edb/ref 17592186526012} {:db/id #edb/ref 17592186526028} {:db/id #edb/ref 17592186526059} {:db/id #edb/ref 17592186526075}] :knowledge-point/title "Graph Transformations Containing Vertical Translations and Stretches Only"} :step/id #uuid "c2637b06-adc7-5f6c-ab42-81d268f6ca36" :step/math-academy-id 18042 :step/next {:db/id #edb/ref 17592186101790}} {:db/id #edb/ref 17592186101790 :step/content {:db/id #edb/ref 17592186100946 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100785 :question/id #uuid "7a7bda91-9647-57d1-b0d7-ad384d4a9753" :question/math-academy-id "e-7606"} :knowledge-point/id #uuid "23014f0a-c381-5997-9f41-2734d3102280" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048419} {:db/id #edb/ref 17592186050676}] :knowledge-point/questions [{:db/id #edb/ref 17592186101555} {:db/id #edb/ref 17592186101560} {:db/id #edb/ref 17592186525983} {:db/id #edb/ref 17592186526052} {:db/id #edb/ref 17592186549951} {:db/id #edb/ref 17592186549982}] :knowledge-point/title "Graph Transformations Containing Horizontal Translations and Stretches Only"} :step/id #uuid "e7e0bc94-abcd-5c9f-a249-7336ba40a910" :step/math-academy-id 28363 :step/next {:db/id #edb/ref 17592186101791}} {:db/id #edb/ref 17592186101791 :step/content {:db/id #edb/ref 17592186100947 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100786 :question/id #uuid "385bad53-d336-5749-8a77-c28dbfc4d963" :question/math-academy-id "e-7608"} :knowledge-point/id #uuid "8fb2265f-df80-53ac-bcab-90c7925a4e86" :knowledge-point/questions [{:db/id #edb/ref 17592186101556} {:db/id #edb/ref 17592186101559} {:db/id #edb/ref 17592186525992} {:db/id #edb/ref 17592186525993} {:db/id #edb/ref 17592186526013} {:db/id #edb/ref 17592186526053} {:db/id #edb/ref 17592186526095}] :knowledge-point/title "Graphing Transformations Containing Horizontal and Vertical Stretches Only"} :step/id #uuid "afa9332b-0f0d-5501-8df9-55ac3c4c1b85" :step/math-academy-id 28366 :step/next {:db/id #edb/ref 17592186101792}} {:db/id #edb/ref 17592186101792 :step/content {:db/id #edb/ref 17592186100948 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100787 :question/id #uuid "8b4eb466-41d1-5882-981e-0dca1dac1c32" :question/math-academy-id "e-7612"} :knowledge-point/id #uuid "2456098c-d6ed-5d85-a1a1-69ad54f02216" :knowledge-point/questions [{:db/id #edb/ref 17592186101557} {:db/id #edb/ref 17592186101561} {:db/id #edb/ref 17592186526021} {:db/id #edb/ref 17592186526055}] :knowledge-point/title "Other Cases of Graphing Transformations Containing Two Operations"} :step/id #uuid "b161a90e-98d0-5966-b844-cad482286850" :step/math-academy-id 28377}] :activity/title "Combining Graph Transformations: Two Operations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186101093}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186550027} :activity/id #uuid "d24b7158-f960-57fe-bd31-a6935529e708" :activity/scope {:db/id #edb/ref 17592186050085 :topic/id #uuid "2c0b4af5-6010-5e83-8fcc-56c647d1ade5" :topic/math-academy-id 1254} :activity/steps [{:db/id #edb/ref 17592186550027 :step/content {:db/id #edb/ref 17592186549982 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40e5f0af-4b75-5a30-a17d-4417edb56708" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/34/343546800fc6ecd2945048933101bbbc19a73d4ac7e6a676a2cf46f9be70adf8.png" :db/id #edb/ref 17592186549447} {:answer/id #uuid "b7b9f146-90ab-5464-a6ea-34df9c5dba5b" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/fa/fa8eef8fc185109d90dcc6c17f9684db06050d9b2cf63560186c45e8ce0ac204.png" :db/id #edb/ref 17592186549660} {:answer/id #uuid "bcef57bc-48c4-5725-b238-e1b4e144afb3" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/6c/6cf121bb9b724d0367eab935b03dd51f46fa0c279906c06a9bdfc96e6c79f369.png" :db/id #edb/ref 17592186549670} {:answer/id #uuid "d376679e-80e4-5df5-aa72-5c8effe9d4b7" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/62/624f7a53993bd26396aaa597669f2c3f44a03baf92e5c5da87a7f17ea5a83d4a.png" :db/id #edb/ref 17592186549706} {:answer/id #uuid "f5e48cb0-af41-59b9-8d6c-47bcc06eafa9" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/77/77c4c913c552c4560b4f22a6ac07726adb6a4d99450db3862412ea96a11f1d2a.png" :db/id #edb/ref 17592186549776}] :answer-field/correct {:db/id #edb/ref 17592186549776} :answer-field/id #uuid "b75424f3-f13f-5b3f-a284-ab8eea9d099c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549890}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9683153e-7324-5fb1-80ce-172326e0407d" :question/math-academy-id "q-87243" :question/problem "![](images/fa/fa8eef8fc185109d90dcc6c17f9684db06050d9b2cf63560186c45e8ce0ac204.png)\n\nThe diagram above shows the function $y=f(x).$ Which of the following gives the graph of $y=f(3(x+2))?$" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches, followed by vertical translations.\n\nTo plot $y=f(3(x+2)),$ we apply the following steps:\n\n- Take the curve $y=f(x).$\n\n- Stretch it by a scale factor of $\\frac{1}{(3)}=\\frac{1}{3}$ parallel to the $x$-axis to get the graph of $y=f(3x).$\n\n![](images/30/3027f0943e238d63996c8d1ff36d36b14bb60c18957168f7e54bb0a7ddcd9d33.png)\n\n  \n\n- Then, translate it left by $2$ units to get the graph of $y=f(3(x+2)).$\n\n![](images/e3/e3e552a5bacd539ee409a69be7e69cddc4e4e2404bcc4adc5173e980e8c8ca93.png)"} :step/id #uuid "0b8293c3-52d1-5621-abf8-52fde1e15572" :step/next {:db/id #edb/ref 17592186550071}} {:db/id #edb/ref 17592186550071 :step/content {:db/id #edb/ref 17592186101561 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed4684d7-a002-5d0f-8072-d94ae42ee8e3" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/5a/5ad16a2f9655a7b5093982232690bc38d4fc0346a6ef1ec87c6a38ca9cde6638.png" :db/id #edb/ref 17592186100528} {:answer/id #uuid "f0b00cf3-8b5a-5ddd-8f24-6ddfa56dc7f4" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b8/b8ee64cb95b4b1fc77d115a56af7a79fda6c427e62ab4334d597dee32f0ac419.png" :db/id #edb/ref 17592186100529} {:answer/id #uuid "f46bf28b-71ea-5d53-9017-2c5420ebed58" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f6/f6431296009c2402c3c68525b6c91ef3acf0a23f17f60da090245a4c0d80c5e4.png" :db/id #edb/ref 17592186100530} {:answer/id #uuid "2f241988-02a7-5777-8a1b-af5a4178938a" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/c3/c36e02e5cb3bca13f925d573fecffcc90a51640f59277a4e2bb19100c9bfaaf9.png" :db/id #edb/ref 17592186100531} {:answer/id #uuid "49c7afda-ac43-5e35-b266-a4db1104bafa" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/c8/c88f736a74ea652cb4c983cf89de154b941be5e95c4d3aec90c8e23ec8582c4e.png" :db/id #edb/ref 17592186100532}] :answer-field/correct {:db/id #edb/ref 17592186100531} :answer-field/id #uuid "844b2263-316a-5f28-9a0b-ddd501f1be63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186100527}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6558b28c-23d6-588b-be4c-cd7343ce1c10" :question/math-academy-id "q-87276" :question/problem "![](images/64/642590d3e04de8365075f79f7954c5123019326b1f4addc618a9a2f54a09e881.png)\n\nThe diagram above shows the function $y=f(x).$ Which of the following gives the graph of $y=f(x-1)+3?$" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches, followed by vertical translations.\n\nTo plot $y=f(x-1)+3,$ we apply the following steps:\n\n- Take the curve $y=f(x).$\n\n- Translate it right by $1$ unit to get the graph of $y=f(x-1).$\n\n![](images/da/da5e6848776232c4f4429c8b3c5e3fdaaae2e9a99a180dfe409893e97d407036.png)\n\n- Then, translate it up by $3$ units to get the graph of $y=f(x-1)+3.$\n\n![](images/81/8188a686d0f9c579f44601645667c0209a39b6500864eb9479147940ef1ebb26.png)"} :step/id #uuid "7d9227a6-c2b7-5b74-9e9f-8551f850121c" :step/next {:db/id #edb/ref 17592186550117}} {:db/id #edb/ref 17592186550117 :step/content {:db/id #edb/ref 17592186549951 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03bfc5d5-8208-5f39-8039-f35d61e04db4" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/df/dfe8088aa2f2b09841223574c813c9197c29134eb9503e1697e852cd7184514f.png" :db/id #edb/ref 17592186549323} {:answer/id #uuid "2063484c-96a8-5c06-bd28-f076ec33f08c" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/1a/1a832c774aeb07399060817149462c2e11c3313d5ad14816a8b6092abfef702b.png" :db/id #edb/ref 17592186549380} {:answer/id #uuid "8cbcc19b-28b6-5bd8-8f5c-4c8722e65c0d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a9/a917739154143a16c1c5d76948d0392ce7376be034a9ca6e162cfd829594c2a7.png" :db/id #edb/ref 17592186549585} {:answer/id #uuid "d7d03033-d79c-5acc-9d9a-2046cbf19feb" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/1e/1ee5948af075803bbab3e22ce9d22532cd8aa4e73679c01a93205e45311aa25c.png" :db/id #edb/ref 17592186549716} {:answer/id #uuid "fd9599ea-f6e5-5373-b3ba-146eb8b30782" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a4/a4dd99ebd96ecf960998264b8defb7b9f27bd1c411aa2cea6d257c5182ac7fc1.png" :db/id #edb/ref 17592186549794}] :answer-field/correct {:db/id #edb/ref 17592186549380} :answer-field/id #uuid "fa09890c-3a44-50c2-b038-e436dbd0b29c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549920}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "311d3c6d-fd7c-5156-9816-24d4c0a4cb73" :question/math-academy-id "q-112634" :question/problem "![](images/ec/ec193bb78fbfb43cec5266622ef0bef14e6aad5798687ae9c7cc7233e69078cb.png)\n\nThe diagram above shows the function $y=f(x).$ Which of the following gives the graph of $y=f(3(x-5))?$" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches, followed by vertical translations.\n\nTo plot $y=f(3(x-5)),$ we apply the following steps:\n\n- Take the curve $y=f(x).$\n\n- Stretch it by a scale factor of $\\frac{1}{(3)}=\\frac{1}{3}$ parallel to the $x$-axis to get the graph of $y=f(3x).$\n\n![](images/c4/c41d06f741882e3993ebe8eb7eab5c42c362d3c11b9b8ad1e4fed983498c95d0.png)\n\n- Then, translate it right by $5$ units to get the graph of $y=f(3(x-5)).$\n\n![](images/47/47bf38d228b4337b870baf777c53fbab43743f155f4a23aa6d0e2bd1f5bc45ad.png)"} :step/id #uuid "f7d4e6ad-eb99-5709-b8bf-9064ece78df6"}] :activity/title "Combining Graph Transformations: Two Operations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186549315}]}
