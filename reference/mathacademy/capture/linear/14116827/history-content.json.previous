 y=\"0\"></use>\n<g transform=\"translate(9230,0)\">\n <use xlink:href=\"#E12-MJMAIN-32\"></use>\n <use xlink:href=\"#E12-MJMAIN-39\" x=\"500\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E12-MJMAIN-29\" x=\"10231\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-2B\" x=\"10843\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-35\" x=\"11844\" y=\"0\"></use>\n</g>\n<g transform=\"translate(0,1826)\">\n <use xlink:href=\"#E12-MJMAIN-2261\" x=\"277\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-32\" x=\"1334\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-28\" x=\"1834\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-33\" x=\"2224\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-29\" x=\"2724\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-2B\" x=\"3336\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-30\" x=\"4337\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-28\" x=\"4837\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-32\" x=\"5227\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-29\" x=\"5727\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-2B\" x=\"6339\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-31\" x=\"7339\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-28\" x=\"7840\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-31\" x=\"8229\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-29\" x=\"8730\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-2B\" x=\"9342\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-35\" x=\"10342\" y=\"0\"></use>\n</g>\n<g transform=\"translate(0,-25)\">\n <use xlink:href=\"#E12-MJMAIN-2261\" x=\"277\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-36\" x=\"1334\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-2B\" x=\"2056\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-30\" x=\"3057\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-2B\" x=\"3780\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-31\" x=\"4780\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-2B\" x=\"5503\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-35\" x=\"6504\" y=\"0\"></use>\n</g>\n<g transform=\"translate(0,-1876)\">\n <use xlink:href=\"#E12-MJMAIN-2261\" x=\"277\" y=\"0\"></use>\n<g transform=\"translate(1334,0)\">\n <use xlink:href=\"#E12-MJMAIN-31\"></use>\n <use xlink:href=\"#E12-MJMAIN-32\" x=\"500\" y=\"0\"></use>\n</g>\n</g>\n<g transform=\"translate(0,-3727)\">\n <use xlink:href=\"#E12-MJMAIN-2261\" x=\"277\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-35\" x=\"1334\" y=\"0\"></use>\n</g>\n</g>\n<g transform=\"translate(14857,0)\">\n<g transform=\"translate(0,1826)\">\n <use xlink:href=\"#E12-MJMAIN-28\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(389,0)\">\n <use xlink:href=\"#E12-MJMAIN-6D\"></use>\n <use xlink:href=\"#E12-MJMAIN-6F\" x=\"833\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-64\" x=\"1334\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E12-MJMAIN-37\" x=\"2446\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-29\" x=\"2947\" y=\"0\"></use>\n</g>\n<g transform=\"translate(0,-25)\">\n <use xlink:href=\"#E12-MJMAIN-28\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(389,0)\">\n <use xlink:href=\"#E12-MJMAIN-6D\"></use>\n <use xlink:href=\"#E12-MJMAIN-6F\" x=\"833\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-64\" x=\"1334\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E12-MJMAIN-37\" x=\"2446\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-29\" x=\"2947\" y=\"0\"></use>\n</g>\n<g transform=\"translate(0,-1876)\">\n <use xlink:href=\"#E12-MJMAIN-28\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(389,0)\">\n <use xlink:href=\"#E12-MJMAIN-6D\"></use>\n <use xlink:href=\"#E12-MJMAIN-6F\" x=\"833\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-64\" x=\"1334\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E12-MJMAIN-37\" x=\"2446\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-29\" x=\"2947\" y=\"0\"></use>\n</g>\n<g transform=\"translate(0,-3727)\">\n <use xlink:href=\"#E12-MJMAIN-28\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(389,0)\">\n <use xlink:href=\"#E12-MJMAIN-6D\"></use>\n <use xlink:href=\"#E12-MJMAIN-6F\" x=\"833\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-64\" x=\"1334\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E12-MJMAIN-37\" x=\"2446\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMAIN-29\" x=\"2947\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n<p>Hence, the day of the week is the same as the date <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.162ex\" height=\"2.176ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -791.3 500.5 936.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-13-Title\">\n<title id=\"MathJax-SVG-13-Title\">5</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E13-MJMAIN-35\" d=\"M164 157Q164 133 148 117T109 101H102Q148 22 224 22Q294 22 326 82Q345 115 345 210Q345 313 318 349Q292 382 260 382H254Q176 382 136 314Q132 307 129 306T114 304Q97 304 95 310Q93 314 93 485V614Q93 664 98 664Q100 666 102 666Q103 666 123 658T178 642T253 634Q324 634 389 662Q397 666 402 666Q410 666 410 648V635Q328 538 205 538Q174 538 149 544L139 546V374Q158 388 169 396T205 412T256 420Q337 420 393 355T449 201Q449 109 385 44T229 -22Q148 -22 99 32T50 154Q50 178 61 192T84 210T107 214Q132 214 148 197T164 157Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E13-MJMAIN-35\" x=\"0\" y=\"0\"></use>\n</g>\n</svg></span> days after January 1st, 1896, namely Monday.</p>\n\n            </div>           \n        </div>",
