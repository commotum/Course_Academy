></use>\n <use xlink:href=\"#E10-MJMAIN-2212\" x=\"15719\" y=\"0\"></use>\n <use xlink:href=\"#E10-MJMATHI-62\" x=\"16720\" y=\"0\"></use>\n <use xlink:href=\"#E10-MJMAIN-29\" x=\"17149\" y=\"0\"></use>\n <use xlink:href=\"#E10-MJMAIN-27FA\" x=\"19817\" y=\"0\"></use>\n <use xlink:href=\"#E10-MJMATHI-61\" x=\"23953\" y=\"0\"></use>\n <use xlink:href=\"#E10-MJMAIN-2212\" x=\"24705\" y=\"0\"></use>\n <use xlink:href=\"#E10-MJMATHI-62\" x=\"25705\" y=\"0\"></use>\n <use xlink:href=\"#E10-MJMAIN-3D\" x=\"26413\" y=\"0\"></use>\n <use xlink:href=\"#E10-MJMATHI-6B\" x=\"27469\" y=\"0\"></use>\n <use xlink:href=\"#E10-MJMATHI-6E\" x=\"27990\" y=\"0\"></use>\n <use xlink:href=\"#E10-MJMAIN-2C\" x=\"28591\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p>where <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"6.249ex\" height=\"2.176ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -791.3 2690.6 936.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-11-Title\">\n<title id=\"MathJax-SVG-11-Title\">k\\in\\mathbb Z.</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E11-MJMATHI-6B\" d=\"M121 647Q121 657 125 670T137 683Q138 683 209 688T282 694Q294 694 294 686Q294 679 244 477Q194 279 194 272Q213 282 223 291Q247 309 292 354T362 415Q402 442 438 442Q468 442 485 423T503 369Q503 344 496 327T477 302T456 291T438 288Q418 288 406 299T394 328Q394 353 410 369T442 390L458 393Q446 405 434 405H430Q398 402 367 380T294 316T228 255Q230 254 243 252T267 246T293 238T320 224T342 206T359 180T365 147Q365 130 360 106T354 66Q354 26 381 26Q429 26 459 145Q461 153 479 153H483Q499 153 499 144Q499 139 496 130Q455 -11 378 -11Q333 -11 305 15T277 90Q277 108 280 121T283 145Q283 167 269 183T234 206T200 217T182 220H180Q168 178 159 139T145 81T136 44T129 20T122 7T111 -2Q98 -11 83 -11Q66 -11 57 -1T48 16Q48 26 85 176T158 471L195 616Q196 629 188 632T149 637H144Q134 637 131 637T124 640T121 647Z\"></path>\n<path stroke-widt