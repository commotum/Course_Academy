#{[{:db/id #edb/ref 17592186152482 :knowledge-point/_questions [{:db/id #edb/ref 17592186152058 :knowledge-point/id #uuid "d2755c3f-e76f-5cf9-a498-333e7e98ea8d" :knowledge-point/title "Using the Addition and Subtraction Properties"} {:db/id #edb/ref 17592186152060 :knowledge-point/id #uuid "7faa3c23-fa98-5c95-9c09-f0d489dbd472" :knowledge-point/title "Simplifying Congruences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18713113-2b94-57e2-8357-e9ce34b2ae30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186410589} {:answer/id #uuid "1d657fb4-9478-55fe-b9df-f986e75a7456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186410591} {:answer/id #uuid "2502acb8-ea55-50ee-af02-180727671cde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186410594} {:answer/id #uuid "3a3727e0-913c-55e1-a4c8-ee04973b5961" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "29" :db/id #edb/ref 17592186410605} {:answer/id #uuid "9871872a-ffa5-55e4-84a9-0f801d56b2c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186410641}] :answer-field/correct {:answer/id #uuid "9871872a-ffa5-55e4-84a9-0f801d56b2c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186410641} :answer-field/id #uuid "8cd1fe34-1104-5712-89af-0f4b1cbab870" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186410699}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "377cc34d-059f-576f-b5b5-be44b9210515" :question/math-academy-id "q-212950" :question/problem "Given that $a≡b\\,(\\text{mod}\\,13),$ construct a statement that also must be true:" :question/worked-solution "When we add zero to both sides of a congruence modulo $n$, we can form an equivalent congruence by writing zero as an integer multiple of $n.$ This works because every integer multiple of $n$ is congruent to zero modulo $n.$\n\nThis gives rise to the following facts:\n\n$$\n\\begin{aligned}a≡b\\,⟺\\,a≡b+kn\\,(\\text{mod}\\,n) \\\\ a≡b\\,⟺\\,a+kn≡b\\,(\\text{mod}\\,n)\\end{aligned}\n$$\n\nSo, we can add a multiple of the modulus $13$ to one side of the congruence. Notice that \n\n$$\n-26=(-2)\\cdot 13.\n$$\n\nTherefore, we obtain the following:\n\n$$\na≡b\\,⟺\\,a-26≡b\\,(\\text{mod}\\,13)\n$$"}] [{:db/id #edb/ref 17592186410714 :knowledge-point/_questions [{:db/id #edb/ref 17592186152058 :knowledge-point/id #uuid "d2755c3f-e76f-5cf9-a498-333e7e98ea8d" :knowledge-point/title "Using the Addition and Subtraction Properties"} {:db/id #edb/ref 17592186152060 :knowledge-point/id #uuid "7faa3c23-fa98-5c95-9c09-f0d489dbd472" :knowledge-point/title "Simplifying Congruences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ea93020-b73c-51c8-92b7-9b07d3bc82c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186410585} {:answer/id #uuid "680ce3bf-ee06-5817-91b5-bdfc17943e16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186410627} {:answer/id #uuid "82caf35d-0e19-5485-aae6-652a04bac176" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186410635} {:answer/id #uuid "9ffbd37e-9a23-5f00-b373-e65f94d2e33d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186410645} {:answer/id #uuid "e201c92d-f1aa-50d9-8ac8-da22772174db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186410667}] :answer-field/correct {:answer/id #uuid "9ffbd37e-9a23-5f00-b373-e65f94d2e33d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186410645} :answer-field/id #uuid "f75f83ea-8131-580b-8fa9-3a2ff784fb28" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186410707}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5f92504f-2a88-577a-b7ee-007131f73594" :question/math-academy-id "q-212951" :question/problem "Given that $a≡b\\,(\\text{mod}\\,15),$ construct a statement that also must be true:" :question/worked-solution "When we add zero to both sides of a congruence modulo $n$, we can form an equivalent congruence by writing zero as an integer multiple of $n.$ This works because every integer multiple of $n$ is congruent to zero modulo $n.$\n\nThis gives rise to the following facts:\n\n$$\n\\begin{aligned}a≡b\\,⟺\\,a≡b+kn\\,(\\text{mod}\\,n) \\\\ a≡b\\,⟺\\,a+kn≡b\\,(\\text{mod}\\,n)\\end{aligned}\n$$\n\nSo, we can add a multiple of the modulus $15$ to one side of the congruence. Notice that \n\n$$\n-45=(-3)\\cdot 15.\n$$\n\nTherefore, we obtain the following:\n\n$$\na≡b\\,⟺\\,a-45≡b\\,(\\text{mod}\\,15)\n$$"}]}
