d #uuid "59b957c3-92b5-5dad-a281-2719f1dc4a77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Saturday" :db/id #edb/ref 17592186149465}] :answer-field/id #uuid "eda67795-6345-5de5-9844-da7b8759050c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186149460}] :question/id #uuid "35bbfc39-ec46-5081-a039-066e5953ba2a" :question/math-academy-id "q-212904" :question/problem "You're given that January 1st, 2000, was a Saturday. Use congruences to determine the day of the week on November 4th, 2000.\n\n*Hint: The year 2000 was a leap year since it's an end-of-century year (multiple of $100$) and divisible by $400$.*"}] [{:db/id #edb/ref 17592186152482 :knowledge-point/_questions [{:db/id #edb/ref 17592186152060 :knowledge-point/id #uuid "7faa3c23-fa98-5c95-9c09-f0d489dbd472" :knowledge-point/title "Simplifying Congruences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b44de035-58e1-5eb8-92dd-a18a56c36a8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186149467} {:answer/id #uuid "c3dbc02d-0f10-54f5-aeba-5829dfd2d363" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186149468} {:answer/id #uuid "09be6607-9c22-57b3-860a-32fd2013bf94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186149469} {:answer/id #uuid "1d109989-cc02-5443-b267-57ad7dbbd99d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186149470} {:answer/id #uuid "2a761f17-fd2b-564e-b49f-cb7dd3903ea2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "29" :db/id #edb/ref 17592186149471}] :answer-field/id #uuid "72867f63-f38c-5ece-872a-38a9a8259d67" :answer-field/ke