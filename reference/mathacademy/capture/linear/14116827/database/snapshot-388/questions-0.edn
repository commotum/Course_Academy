"25" :db/id #edb/ref 17592186410591} {:answer/id #uuid "2502acb8-ea55-50ee-af02-180727671cde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186410594} {:answer/id #uuid "3a3727e0-913c-55e1-a4c8-ee04973b5961" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "29" :db/id #edb/ref 17592186410605} {:answer/id #uuid "9871872a-ffa5-55e4-84a9-0f801d56b2c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186410641}] :answer-field/correct {:answer/id #uuid "9871872a-ffa5-55e4-84a9-0f801d56b2c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186410641} :answer-field/id #uuid "8cd1fe34-1104-5712-89af-0f4b1cbab870" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186410699}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "377cc34d-059f-576f-b5b5-be44b9210515" :question/math-academy-id "q-212950" :question/problem "Given that $a≡b\\,(\\text{mod}\\,13),$ construct a statement that also must be true:" :question/worked-solution "When we add zero to both sides of a congruence modulo $n$, we can form an equivalent congruence by writing zero as an integer multiple of $n.$ This works because every integer multiple of $n$ is congruent to zero modulo $n.$\n\nThis gives rise to the following facts:\n\n$$\n\\begin{aligned}a≡b\\,⟺\\,a≡b+kn\\,(\\text{mod}\\,n) \\\\ a≡b\\,⟺\\,a+kn≡b\\,(\\text{mod}\\,n)\\end{aligned}\n$$\n\nSo, we can add a multiple of the modulus $13$ to one side of the congruence. Notice that \n\n$$\n-26=(-2)\\cdot 13.\n$$\n\nTherefore, we obtain the following:\n\n$$\na≡b\\,⟺\\,a-26≡b\\,(\\text{mod}\\,13)\n$$"}] [{:db/id #edb/ref 17592186410714 :knowledge-point/_questions [{:db/id #edb/ref 17592186152058 :knowledge-point/id #uuid "d2755c3f-e76f-5cf9-a498-333e7e98ea8d" :knowledge-point/title "Using the Addition and Subtraction Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ea93020-b73c-51c8-92b7-9b07d3bc82c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186410585} {:answer/id #uuid "680ce3bf-ee06-5817-91b5-bdfc17943e16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186410627} {:answer/id #uuid "82caf35d-0e19-5485-aae6-652a04bac176" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186410635} {:answer/id #uuid "9ffbd37e-9a23-5f00-b373-e65f94d2e33d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186410645} {:answer/id #uuid "e201c92d-f1aa-50d9-8ac8-da22772174db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186410667}] :answer-field/correct {:answer/id #uuid "9ffbd37e-9a23-5f00-b373-e65f94d2e33d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186410645} :answer-field/id #uuid "f75f83ea-8131-580b-8fa9-3a2ff784fb28" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186410707}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5f92504f-2a88-577a-b7ee-007131f73594" :question/math-academy-id "q-212951" :question/problem "Given that $a≡b\\,(\\text{mod}\\,15),$ construct a statement that also must be true:" :question/worked-solution "When we add zero to both sides of a congruence modulo $n$, we can form an equivalent congruence by writing zero as an integer multiple of $n.$ This works because every integer multiple of $n$ is congruent to zero modulo $n.$\n\nThis gives rise to the following facts:\n\n$$\n\\begin{aligned}a≡b\\,⟺\\,a≡b+kn\\,(\\text{mod}\\,n) \\\\ a≡b\\,⟺\\,a+kn≡b\\,(\\text{mod}\\,n)\\end{aligned}\n$$\n\nSo, we can add a multiple of the modulus $15$ to one side of the congruence. Notice that \n\n$$\n-45=(-3)\\cdot 15.\n$$\n\nTherefore, we obtain the following:\n\n$$\na≡b\\,⟺\\,a-45≡b\\,(\\text{mod}\\,15)\n$$"}] [{:db/id #edb/ref 17592186410713 :knowledge-point/_questions [{:db/id #edb/ref 17592186152061 :knowledge-point/id #uuid "ea9b0644-090a-52a4-bc21-18fee98acbd3" :knowledge-point/title "Date Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cf2b520-553b-53a7-88f5-8915ae76af14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Wednesday" :db/id #edb/ref 17592186410590} {:answer/id #uuid "359bf237-b12e-5567-ab3b-fdf8b157a4f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Saturday" :db/id #edb/ref 17592186410600} {:answer/id #uuid "625f2cc4-7141-5b58-891f-19fd378aa8fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Monday" :db/id #edb/ref 17592186410623} {:answer/id #uuid "f7a5232b-17c7-57b3-9855-7a1be167543c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Friday" :db/id #edb/ref 17592186410678} {:answer/id #uuid "f85803f7-5e70-5e5a-9e50-5864a6a6194a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Sunday" :db/id #edb/ref 17592186410680}] :answer-field/correct {:answer/id #uuid "f7a5232b-17c7-57b3-9855-7a1be167543c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Friday" :db/id #edb/ref 17592186410678} :answer-field/id #uuid "34ae9d51-f1ea-544e-a179-f5f86690c686" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410687}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "50be2be7-4190-59bf-9880-ce7373f52df0" :question/math-academy-id "q-213211" :question/problem "Jacopo Peri's Euridice, modern opera's earliest known, fully surviving work, was first performed in Florence on October 6th, 1600. Given that January 1st, 1600, was a Saturday, use congruences to determine the day of the week on which the opera was first performed.\n\n*Hint: The year 1600 was a leap year since it's an end-of-century year (multiple of $100$) and divisible by $400.$*" :question/worked-solution "We can solve this problem using modular arithmetic.\n\nFirst, we note the number of complete months between January 1st, 1600, and October 1st, 1600. \n\n- There were $5$ months with $31$ days (January, March, May, July, and August).\n\n- There were $3$ months with $30$ days (April, June, and September).\n\n- There was $1$ month with $29$ days (February).\n\nTherefore, the number of days $d$ between January 1st and October 6th is given by\n\n$$\nd=\\overset{\\text{days to October 1st}}{\\overset{⏞}{31(5)+30(3)+29(1)}}+5.\n$$\n\nNow, note that\n\n$$\n31≡3,\\,30≡2,\\,29≡1,\\,5≡5,\\,(\\text{mod}\\,7).\n$$\n\nTherefore, writing the number $d$ modulo $7,$ we get the following:\n\n$$\n\\begin{aligned}d & =5(31)+3(30)+1(29)+5 \\\\  & ≡5(3)+3(2)+(1)+5\\, & (\\text{mod}\\,7) \\\\  & ≡15+6+1+5\\, & (\\text{mod}\\,7) \\\\  & ≡1+6+1+5\\, & (\\text{mod}\\,7) \\\\  & ≡13\\, & (\\text{mod}\\,7) \\\\  & ≡6\\, & (\\text{mod}\\,7)\\end{aligned}\n$$\n\nHence, the day of the week is the same as the date 6 days after January 1st, 1600, namely Friday."}] [{:db/id #edb/ref 17592186410716 :knowledge-point/_questions [{:db/id #edb/ref 17592186152061 :knowledge-point/id #uuid "ea9b0644-090a-52a4-bc21-18fee98acbd3" :knowledge-point/title "Date Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45e002a6-05ef-5373-af42-302884d63b31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Thursday" :db/id #edb/ref 17592186410611} {:answer/id #uuid "6f70c49a-6289-5d97-a367-f807a502fdf0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Tuesday" :db/id #edb/ref 17592186410630} {:answer/id #uuid "74bba275-65d4-5278-9134-c9bd06a4c526" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Monday" :db/id #edb/ref 17592186410631} {:answer/id #uuid "a8c9b75b-8faf-584e-8656-ef50fe441a42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Wednesday" :db/id #edb/ref 17592186410649} {:answer/id #uuid "cbd3be64-1f58-5b89-a253-861edb8875ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Friday" :db/id #edb/ref 17592186410661}] :answer-field/correct {:answer/id #uuid "6f70c49a-6289-5d97-a367-f807a502fdf0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Tuesday" :db/id #edb/ref 17592186410630} :answer-field/id #uuid "44b86fd1-f11f-540e-b60d-259357d02f7d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410690}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "700ec10d-3e3a-58fc-aadf-2fee69932797" :question/math-academy-id "q-213291" :question/problem "A parodic holiday, International Talk Like a Pirate Day, was celebrated for the first time on September 19th, 1995. Given that January 1st, 1995, was a Sunday, use congruences to determine on which day of the week this holiday was celebrated for the first time.\n\n*Hint: The year 1995 was not a leap year since it is not divisible by $4.$*" :question/worked-solution "We can solve this problem using modular arithmetic.\n\nFirst, we note the number of complete months between January 1st, 1995, and September 1st, 1995. \n\n- There were $5$ months with $31$ days (January, March, May, July,  and  August).\n\n- There were $2$ months with $30$ days (April and  June).\n\n- There was $1$ month with $28$ days (February).\n\nTherefore, the number of days $d$ between January 1st and September 19th is given by\n\n$$\nd=\\overset{\\text{days to September 1st}}{\\overset{⏞}{31(5)+30(2)+28(1)}}+18.\n$$\n\nNow, note that\n\n$$\n31≡3,\\,30≡2,\\,28≡0,\\,18≡4\\,(\\text{mod}\\,7).\n$$\n\nTherefore, writing the number $d$ modulo $7,$ we get the following:\n\n$$\n\\begin{aligned}d & =5(31)+2(30)+1(28)+18 \\\\  & ≡5(3)+2(2)+1(0)+4\\, & (\\text{mod}\\,7) \\\\  & ≡15+4+0+4\\, & (\\text{mod}\\,7) \\\\  & ≡1+4+0+4\\, & (\\text{mod}\\,7) \\\\  & ≡9\\, & (\\text{mod}\\,7) \\\\  & ≡2\\, & (\\text{mod}\\,7)\\end{aligned}\n$$\n\nHence, the day of the week is the same as the date $2$ days after January 1st, 1995, namely Tuesday."}] [{:db/id #edb/ref 17592186410718 :knowledge-point/_questions [{:db/id #edb/ref 17592186152061 :knowledge-point/id #uuid "ea9b0644-090a-52a4-bc21-18fee98acbd3" :knowledge-point/title "Date Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "485aae5f-9fa1-5352-9371-7cde147454d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Sunday" :db/id #edb/ref 17592186410613} {:answer/id #uuid "80321ec8-0f4c-52e6-8a67-51591491b806" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Monday" :db/id #edb/ref 17592186410633} {:answer/id #uuid "b197d0a7-64fc-585e-9aa8-af38ec324fb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Wednesday" :db/id #edb/ref 17592186410650} {:answer/id #uuid "fa1fd099-2e36-5b19-9d40-66a2ef4a93c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Tuesday" :db/id #edb/ref 17592186410682} {:answer/id #uuid "fe06c8b2-bc20-5496-ad69-4309b87d0aab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Thursday" :db/id #edb/ref 17592186410683}] :answer-field/correct {:answer/id #uuid "fa1fd099-2e36-5b19-9d40-66a2ef4a93c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Tuesday" :db/id #edb/ref 17592186410682} :answer-field/id #uuid "3d016934-cf4f-5b52-99e0-61cacbf8d0d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410688}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "83693413-601d-53f0-b546-e5ed9a2ee614" :question/math-academy-id "q-213292" :question/problem "On November 16th, 1700, Spain's King Charles II died. Given that January 1st, 1700, was a Friday, use congruences to determine on which day of the week Charles II died.\n\n*Hint: The year 1700 was not a leap year since it's an end-of-century year (multiple of $100$) and is not divisible by $400.$*" :question/worked-solution "We can solve this problem using modular arithmetic.\n\nFirst, we note the number of complete months between January 1st, 1700, and November 1st, 1700. \n\n- There were $6$ months with $31$ days (January, March, May, July, August, and October).\n\n- There were $3$ months with $30$ days (April, June, and September).\n\n- There was $1$ month with $28$ days (February).\n\nTherefore, the number of days $d$ between January 1st and November 16th is given by\n\n$$\nd=\\overset{\\text{days to November 1st}}{\\overset{⏞}{31(6)+30(3)+28(1)}}+15.\n$$\n\nNow, note that\n\n$$\n31≡3,\\,30≡2,\\,28≡0,\\,15≡1\\,(\\text{mod}\\,7).\n$$\n\nTherefore, writing the number $d$ modulo $7,$ we get the following:\n\n$$\n\\begin{aligned}d & =6(31)+3(30)+1(28)+15 \\\\  & ≡6(3)+3(2)+(0)+1\\, & (\\text{mod}\\,7) \\\\  & ≡18+6+0+1\\, & (\\text{mod}\\,7) \\\\  & ≡4+6+0+1\\, & (\\text{mod}\\,7) \\\\  & ≡11\\, & (\\text{mod}\\,7) \\\\  & ≡4\\, & (\\text{mod}\\,7)\\end{aligned}\n$$\n\nHence, the day of the week is the same as the date $4$ days after January 1st, 1700, namely Tuesday."}] [{:db/id #edb/ref 17592186410723 :knowledge-point/_questions [{:db/id #edb/ref 17592186152061 :knowledge-point/id #uuid "ea9b0644-090a-52a4-bc21-18fee98acbd3" :knowledge-point/title "Date Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0435df86-3781-513b-a46f-906712e96176" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Saturday" :db/id #edb/ref 17592186410580} {:answer/id #uuid "4e6d9cbb-8c21-5758-abb5-f5e2a3269156" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Tuesday" :db/id #edb/ref 17592186410617} {:answer/id #uuid "6337ab72-5ce7-599b-9621-a448e14bf720" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Monday" :db/id #edb/ref 17592186410624} {:answer/id #uuid "69b30bc0-14ba-54bc-a56c-7790688ad638" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Sunday" :db/id #edb/ref 17592186410628} {:answer/id #uuid "ef77d4b9-b779-526e-a114-59633d5da258" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Thursday" :db/id #edb/ref 17592186410675}] :answer-field/correct {:answer/id #uuid "0435df86-3781-513b-a46f-906712e96176" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Saturday" :db/id #edb/ref 17592186410580} :answer-field/id #uuid "6264c938-98d7-59e0-8745-3f11336fceb7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410694}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f453d5f9-efe9-5d81-aae2-3ab414bd5f85" :question/math-academy-id "q-213293" :question/problem "Christmas in 2100 will be celebrated, as usual, on December 25th. Given that January 1st, 2100, is a Friday, use congruences to determine the day of the week on which Christmas will be celebrated in 2100.\n\n*Hint: The year 2100 is not a leap year since it's an end-of-century year (multiple of $100$) and is not divisible by $400.$*" :question/worked-solution "We can solve this problem using modular arithmetic.\n\nFirst, we note the number of complete months between January 1st, 2100, and December 1st, 2100. \n\n- There are $6$ months with $31$ days (January, March, May, July, August, and October).\n\n- There are $4$ months with $30$ days (April, June, September, and November).\n\n- There is $1$ month with $28$ days (February).\n\nTherefore, the number of days $d$ between January 1st and December 25th is given by\n\n$$\nd=\\overset{\\text{days to December 1st}}{\\overset{⏞}{31(6)+30(4)+28(1)}}+24.\n$$\n\nNow, note that\n\n$$\n31≡3,\\,30≡2,\\,28≡0,\\,24≡3\\,(\\text{mod}\\,7).\n$$\n\nTherefore, writing the number $d$ modulo $7,$ we get the following:\n\n$$\n\\begin{aligned}d & =6(31)+4(30)+1(28)+24 \\\\  & ≡6(3)+4(2)+(0)+3\\, & (\\text{mod}\\,7) \\\\  & ≡18+8+0+3\\, & (\\text{mod}\\,7) \\\\  & ≡4+1+0+3\\, & (\\text{mod}\\,7) \\\\  & ≡8\\, & (\\text{mod}\\,7) \\\\  & ≡1\\, & (\\text{mod}\\,7)\\end{aligned}\n$$\n\nHence, the day of the week is the same as the date $1$ day after January 1st, 2100, namely Saturday."}] [{:db/id #edb/ref 17592186410717 :knowledge-point/_questions [{:db/id #edb/ref 17592186152060 :knowledge-point/id #uuid "7faa3c23-fa98-5c95-9c09-f0d489dbd472" :knowledge-point/title "Simplifying Congruences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11771110-3806-54e3-a052-d7cb39b48fc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x≡5\\,(\\text{mod}\\,11)" :db/id #edb/ref 17592186410586} {:answer/id #uuid "6130bea6-e153-597b-a976-04ba16161ccf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x≡3\\,(\\text{mod}\\,11)" :db/id #edb/ref 17592186410622} {:answer/id #uuid "65c87c87-940c-5fe9-85d0-d07bcbc79886" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x≡2\\,(\\text{mod}\\,11)" :db/id #edb/ref 17592186410626} {:answer/id #uuid "74c83fb2-0003-50f0-85fe-daa92f7603a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x≡9\\,(\\text{mod}\\,11)" :db/id #edb/ref 17592186410632} {:answer/id #uuid "9f6ff12a-77da-5cff-beb6-c7fb418f3147" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x≡7\\,(\\text{mod}\\,11)" :db/id #edb/ref 17592186410644}] :answer-field/correct {:answer/id #uuid "65c87c87-940c-5fe9-85d0-d07bcbc79886" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x≡2\\,(\\text{mod}\\,11)" :db/id #edb/ref 17592186410626} :answer-field/id #uuid "24d24caf-30f7-5551-a3d0-554479ace0e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410685}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "77cbdd5d-15bd-5f9e-950f-9243376a199b" :question/math-academy-id "q-79656" :question/problem "Which of the following is equivalent to $x≡35\\,(\\text{mod}\\,11)?$" :question/worked-solution "When we add zero to both sides of a congruence modulo $n$, we can form an equivalent congruence by writing zero as an integer multiple of $n.$ This works because every integer multiple of $n$ is congruent to zero modulo $n.$\n\nIn our case, we add zero to both sides of the congruence and then use the fact that  $11\\cdot (-3)≡0\\,(\\text{mod}\\,11)$ to rewrite the right-hand side, as follows:\n\n$$\n\\begin{aligned}x+0 & ≡35+0\\, & (\\text{mod}\\,11) \\\\ x & ≡35+0\\, & (\\text{mod}\\,11) \\\\  & ≡35+11\\cdot (-3)\\, & (\\text{mod}\\,11) \\\\  & ≡35-33\\, & (\\text{mod}\\,11) \\\\  & ≡2\\, & (\\text{mod}\\,11)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186410711 :knowledge-point/_questions [{:db/id #edb/ref 17592186152058 :knowledge-point/id #uuid "d2755c3f-e76f-5cf9-a498-333e7e98ea8d" :knowledge-point/title "Using the Addition and Subtraction Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c4f9473-abce-522a-8bca-48ad3793f293" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x≡11\\,(\\text{mod}\\,5)" :db/id #edb/ref 17592186410599} {:answer/id #uuid "42ff318e-e994-50d1-bf94-2696290ab970" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x≡11\\,(\\text{mod}\\,15)" :db/id #edb/ref 17592186410610} {:answer/id #uuid "81471d19-b8e8-5c4f-adc4-d7f45564b1e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x≡5\\,(\\text{mod}\\,4)" :db/id #edb/ref 17592186410634} {:answer/id #uuid "c0c81f46-8655-5936-ad36-f43d525b2632" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x≡4\\,(\\text{mod}\\,10)" :db/id #edb/ref 17592186410657} {:answer/id #uuid "f7b9b840-81ea-525f-848f-6a73e584494c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x≡6\\,(\\text{mod}\\,15)" :db/id #edb/ref 17592186410679}] :answer-field/correct {:answer/id #uuid "f7b9b840-81ea-525f-848f-6a73e584494c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x≡6\\,(\\text{mod}\\,15)" :db/id #edb/ref 17592186410679} :answer-field/id #uuid "921948e6-4b81-53f0-b19f-76fb55d28b4e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410700}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "23919475-35c0-5151-a80d-eb2f21c5c2a9" :question/math-academy-id "q-79667" :question/problem "Which of the following is equivalent to $x+5≡11\\,(\\text{mod}\\,15)?$" :question/worked-solution "The addition property of congruences states that\n\n$$\na≡b\\,⟺\\,a+c≡b+c\\,(\\text{mod}\\,n).\n$$\n\nSimilarly, the subtraction property states that\n\n$$\na≡b\\,⟺\\,a-c≡b-c\\,(\\text{mod}\\,n).\n$$\n\nWe use the subtraction property to subtract $5$ from both sides of the given congruence, as follows:\n\n$$\n\\begin{aligned}x+5 & ≡11\\, & (\\text{mod}\\,15) \\\\ x+5-5 & ≡11-5\\, & (\\text{mod}\\,15) \\\\ x & ≡6\\, & (\\text{mod}\\,15)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186410715 :knowledge-point/_questions [{:db/id #edb/ref 17592186152059 :knowledge-point/id #uuid "489ba3cf-c7da-5766-9638-2b5c5429d04c" :knowledge-point/title "Identifying Integers That Are Congruent to Zero Modulo N"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09245c92-930e-5f0d-9d1f-efcbe7d45bf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186410581} {:answer/id #uuid "0a659048-5bd4-5f99-9f41-4dcb9c78e3e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-84" :db/id #edb/ref 17592186410582} {:answer/id #uuid "1fa5f3a4-adf7-58c3-b075-de7d7b496c72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-40" :db/id #edb/ref 17592186410592} {:answer/id #uuid "477d2d41-3b01-5f96-9359-1e22f47d5b8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-96" :db/id #edb/ref 17592186410612} {:answer/id #uuid "511e3ece-b1ca-50d5-a0c8-f7b853acbdf7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "44" :db/id #edb/ref 17592186410618}] :answer-field/correct {:answer/id #uuid "0a659048-5bd4-5f99-9f41-4dcb9c78e3e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-84" :db/id #edb/ref 17592186410582} :answer-field/id #uuid "68cf371f-9717-5edb-92f6-5993a4fc7b4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410696}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6d54f83a-3712-59c6-b238-0e2bb4334321" :question/math-academy-id "q-79692" :question/problem "Which of the following is congruent to $0$ modulo $14?$" :question/worked-solution "First, recall that \n\n$$\na≡0\\,(\\text{mod}\\,n)\\,⟺\\,a=kn,\n$$\n\nwhere $k\\in Z.$ In other words, when $a$ is divided by $n,$ there is no remainder. This means that any integer multiple of $14$ is congruent to $0$ modulo $14.$\n\nTherefore, since $14\\,|\\,(-84),$ we obtain\n\n$$\n-84≡(-6)\\cdot 14≡(-6)\\cdot 0≡0\\,(\\text{mod}\\,14).\n$$\n\nNone of the other options are multiples of $14.$"}] [{:db/id #edb/ref 17592186410721 :knowledge-point/_questions [{:db/id #edb/ref 17592186152059 :knowledge-point/id #uuid "489ba3cf-c7da-5766-9638-2b5c5429d04c" :knowledge-point/title "Identifying Integers That Are Congruent to Zero Modulo N"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d3842dd-fbdf-59ec-a53a-44baad664fb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186410616} {:answer/id #uuid "89490175-146d-532d-8f68-493b93815c29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "62" :db/id #edb/ref 17592186410637} {:answer/id #uuid "a71abade-3bbd-59bd-ae4b-682c7da3ce96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186410648} {:answer/id #uuid "b6542486-eb68-5ede-b9c6-a6800c1b48be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186410651} {:answer/id #uuid "d7407095-7271-5a85-b624-8d937c6a68b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186410664}] :answer-field/correct {:answer/id #uuid "a71abade-3bbd-59bd-ae4b-682c7da3ce96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186410648} :answer-field/id #uuid "3da627ac-6ece-5e61-b584-128e542daafa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410689}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c78b30a9-b100-5475-8a11-aa23c310f873" :question/math-academy-id "q-79693" :question/problem "Which of the following is congruent to $0$ modulo $4?$" :question/worked-solution "First, recall that \n\n$$\na≡0\\,(\\text{mod}\\,n)\\,⟺\\,a=kn,\n$$\n\nwhere $k\\in Z.$ In other words, when $a$ is divided by $n,$ there is no remainder. This means that any integer multiple of $4$ is congruent to $0$ modulo $4.$\n\nTherefore, since $4\\,|\\,52,$ we obtain\n\n$$\n52≡13\\cdot 4≡13\\cdot 0≡0\\,(\\text{mod}\\,4).\n$$\n\nNone of the other options are multiples of $4.$"}] [{:db/id #edb/ref 17592186410712 :knowledge-point/_questions [{:db/id #edb/ref 17592186152059 :knowledge-point/id #uuid "489ba3cf-c7da-5766-9638-2b5c5429d04c" :knowledge-point/title "Identifying Integers That Are Congruent to Zero Modulo N"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35b43e3a-2682-543e-af75-81e03ac3fd70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-35" :db/id #edb/ref 17592186410601} {:answer/id #uuid "3d760f0e-a05f-5ea8-8540-e476ce0d1fa4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186410607} {:answer/id #uuid "572f2823-d978-5e43-bc01-bf4131aaf0e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186410620} {:answer/id #uuid "643fb83e-73bf-55aa-aa50-7d21a7839b8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186410625} {:answer/id #uuid "e841eb27-2ba6-5d57-96d0-00c04250bf76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-51" :db/id #edb/ref 17592186410671}] :answer-field/correct {:answer/id #uuid "e841eb27-2ba6-5d57-96d0-00c04250bf76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-51" :db/id #edb/ref 17592186410671} :answer-field/id #uuid "b0cbc6a9-d6ad-5825-87ad-9f60b699d5e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410702}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3911df9a-6841-59e6-b534-6e8a3aa2e9ba" :question/math-academy-id "q-79694" :question/problem "Which of the following is congruent to $0$ modulo $17?$" :question/worked-solution "First, recall that \n\n$$\na≡0\\,(\\text{mod}\\,n)\\,⟺\\,a=kn,\n$$\n\nwhere $k\\in Z.$ In other words, when $a$ is divided by $n,$ there is no remainder. This means that any integer multiple of $17$ is congruent to $0$ modulo $17.$\n\nTherefore, since $17\\,|\\,(-51),$ we obtain\n\n$$\n-51≡(-3)\\cdot 17≡(-3)\\cdot 0≡0\\,(\\text{mod}\\,17).\n$$\n\nNone of the other options are multiples of $17.$"}]}
