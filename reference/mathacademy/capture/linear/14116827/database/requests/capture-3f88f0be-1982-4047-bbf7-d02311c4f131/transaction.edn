n$$\na≡b\\,⟺\\,a-5≡b-5\\,(\\text{mod}\\,17)\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0d7e3fad-6724-5c43-b6eb-73cfa97ef92a" "answer-field-5631a52a-eea1-553b-8ea9-965041d3baea"] :db/ensure [:question/validate]} {:db/id "answer-field-0d7e3fad-6724-5c43-b6eb-73cfa97ef92a" :answer-field/id #uuid "0d7e3fad-6724-5c43-b6eb-73cfa97ef92a" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-c04d9f18-25b5-5492-8862-decdc10db9c7" :answer-field/choices ["answer-8f2ecd93-2921-562c-9e0e-f0397011c921" "answer-c04d9f18-25b5-5492-8862-decdc10db9c7" "answer-9855d97a-e15b-5f14-a6b8-16fbdf3817c0"] :db/ensure [:answer-field/validate]} {:db/id "answer-8f2ecd93-2921-562c-9e0e-f0397011c921" :answer/id #uuid "8f2ecd93-2921-562c-9e0e-f0397011c921" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-c04d9f18-25b5-5492-8862-decdc10db9c7" :answer/id #uuid "c04d9f18-25b5-5492-8862-decdc10db9c7" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-9855d97a-e15b-5f14-a6b8-16fbdf3817c0" :answer/id #uuid "9855d97a-e15b-5f14-a6b8-16fbdf3817c0" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-field-5631a52a-eea1-553b-8ea9-965041d3baea" :answer-field/id #uuid "5631a52a-eea1-553b-8ea9-965041d3baea" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-ca619114-e789-5449-b148-49917c943cf3" :answer-field/choices ["answer-ca619114-e789-5449-b148-49917c943cf3" "answer-42be19e1-f6b1-5fa6-badc-cbe9d0c765cc" "answer-eb7ffc49-ca43-564b-b1fc-0707eeef1ef4"] :db/ensure [:answer-field/validate]} {:db/id "answer-ca619114-e789-5449-b148-49917c943cf3" :answer/id #uuid "ca619114-e789-5449-b148-49917c943cf3" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-42be19e1-f6b1-5fa6-badc-cbe9d0c765cc" :answer/id #uuid "42be19e1-f6b1-5fa6-badc-cbe9d0c765cc" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-eb7ffc49-ca43-564b-b1fc-0707eeef1ef4" :answer/id #uuid "eb7ffc49-ca43-564b-b1fc-0707eeef1ef4" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "question-f913a8a8-9a07-5f52-8a63-48e2094f05b2" :question/id #uuid "f913a8a8-9a07-5f52-8a63-48e2094f05b2" :question/math-academy-id "q-212938" :question/problem "Given that $a≡b\\,(\\text{mod}\\,7),$ construct a statement that also must be true:" :question/worked-solution "The addition property of congruences states that\n\n$$\na≡b\\,⟺\\,a+c≡b+c\\,(\\text{mod}\\,n).\n$$\n\nTherefore, we can add the same integer to both sides of a congruence, keeping the modulus unchanged:\n\n$$\na≡b\\,⟺\\,a+1≡b+1\\,(\\text{mod}\\,7)\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2e48cdcd-8b74-562f-9634-c4bc88e76046" "answer-field-556c480c-d0ac-5601-9e8c-53aaa6a759b0"] :db/ensure [:question/validate]} {:db/id "answer-field-2e48cdcd-8b74-562f-9634-c4bc88e76046" :answer-field/id #uuid "2e48cdcd-8b74-562f-9634-c4bc88e76046" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-d58b22c9-67f2-5e11-806d-b43ed8dabaec" :answer-field/choices ["answer-d58b22c9-67f2-5e11-806d-b43ed8dabaec" "answer-0dd74d72-98fd-5356-b52c-46cdaa8786a3" "answer-f9997762-58ee-54b6-bfde-531bd2973ecf"] :db/ensure [:answer-field/validate]} {:db/id "answer-d58b22c9-67f2-5e11-806d-b43ed8dabaec" :answer/id #uuid "d58b22c9-67f2-5e11-806d-b43ed8dabaec" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-0dd74d72-98fd-5356-b52c-46cdaa8786a3" :answer/id #uuid "0dd74d72-98fd-5356-b52c-46cdaa8786a3" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-f9997762-58ee-54b6-bfde-531bd2973ecf" :answer/id #uuid "f9997762-58ee-54b