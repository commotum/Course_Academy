#{[{:activity/first-step {:db/id #edb/ref 17592186065239} :activity/id #uuid "c9abc5e8-7b1c-5f9f-b127-db76daab3fd6" :activity/scope {:db/id #edb/ref 17592186049843 :topic/id #uuid "18188755-d27b-5ea0-8e93-047aeb60e2d7" :topic/math-academy-id 376} :activity/steps [{:db/id #edb/ref 17592186065166 :step/content {:db/id #edb/ref 17592186064279 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064122 :question/id #uuid "d71c8752-131c-5c82-b642-dee1d03484f4" :question/math-academy-id "e-6737"} :knowledge-point/id #uuid "3bb1eda0-9577-59e7-9c6c-b85966fbb7e4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048159} {:db/id #edb/ref 17592186050358}] :knowledge-point/questions [{:db/id #edb/ref 17592186064495} {:db/id #edb/ref 17592186064700}] :knowledge-point/title "Expressing the Square Root of a Perfect Square Using Absolute Value"} :step/id #uuid "90ca222a-d123-5386-9588-6d8292b8a140" :step/math-academy-id 24828 :step/next {:db/id #edb/ref 17592186065201}} {:db/id #edb/ref 17592186065201 :step/content {:db/id #edb/ref 17592186064305 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064141 :question/id #uuid "6bf774f8-aaa7-5a8e-9fb5-1ed1356b87ae" :question/math-academy-id "e-9639"} :knowledge-point/id #uuid "4a48a060-871e-5c31-b1c0-7c4ed10eb259" :knowledge-point/questions [{:db/id #edb/ref 17592186064496} {:db/id #edb/ref 17592186064704}] :knowledge-point/title "Simplifying the Square Root of a Perfect Square With Multiple Variables"} :step/id #uuid "741a6139-aa26-54b7-8036-ade246aa12a8" :step/math-academy-id 36121 :step/next {:db/id #edb/ref 17592186065240}} {:db/id #edb/ref 17592186065239 :step/content {:db/id #edb/ref 17592186065343 :tutorial/content "When simplifying an algebraic expression involving square roots, it's useful to remember that\n\n$$\n\\sqrt{x^2} = \\mid x \\mid\n$$\n\nIt's tempting to think that $\\sqrt{x^2}$ is equivalent to $x$, but that's not true because $\\sqrt{x^2}$ is always non-negative, even if $x$ is negative.\n\nTo illustrate, let's evaluate $\\sqrt{x^2}$ for a couple of different values of $x$:\n\n$$\n\\begin{aligned}\n\\sqrt{4^{2}} &= \\sqrt{16} = 4 \\\\\n\\sqrt{(-4)^{2}} &= \\sqrt{16} = 4\n\\end{aligned}\n$$\n\nIn both cases, using absolute value gives the correct result:\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}\\sqrt{4^{2}} = & 4 & &= 4 & ✓ \\\\ \\sqrt{(-4)^{2}} = & -4 & |= 4 & ✓\\end{bmatrix}\n\\end{aligned}\n$$" :tutorial/id #uuid "4e09a82d-1598-56ed-9888-9a1bfa380f55" :tutorial/math-academy-id 1604 :tutorial/title "Introduction"} :step/id #uuid "89060a03-576a-52b0-8345-c548845df17b" :step/math-academy-id 4284 :step/next {:db/id #edb/ref 17592186065166}} {:db/id #edb/ref 17592186065240 :step/content {:db/id #edb/ref 17592186064330 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063968 :question/id #uuid "62a47fad-0c27-5e6d-a21f-8b298ac11159" :question/math-academy-id "e-1355"} :knowledge-point/id #uuid "c0d0fdb7-9849-5aca-b494-3b013b2eb035" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049253}] :knowledge-point/questions [{:db/id #edb/ref 17592186064494} {:db/id #edb/ref 17592186064903} {:db/id #edb/ref 17592186233381}] :knowledge-point/title "Simplifying a Square Root of a Perfect Square Containing a Fraction"} :step/id #uuid "5eab9871-4247-51fe-85ce-5a836f6d3bc4" :step/math-academy-id 4291}] :activity/title "The Square Root of a Perfect Square With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064461}]}
