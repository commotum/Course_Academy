-c class=\"mjx-c210E TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D458 TEX-I\"></mjx-c></mjx-mi><mjx-msup><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-script style=\"vertical-align: 0.289em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup></mjx-box></mjx-sqrt></mjx-msqrt><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.8em 0.8em 0.3em\"><mtr><mtd><msqrt><mn>49</mn><msup><mi>h</mi><mn>2</mn></msup><msup><mi>k</mi><mn>2</mn></msup></msqrt></mtd><mtd><mi></mi><mo>=</mo><msqrt><msup><mn>7</mn><mn>2</mn></msup><mo>⋅</mo><msup><mi>h</mi><mn>2</mn></msup><mo>⋅</mo><msup><mi>k</mi><mn>2</mn></msup></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msqrt><mn>7</mn><mo>⋅</mo><mn>7</mn><mo>⋅</mo><mi>h</mi><mo>⋅</mo><mi>h</mi><mo>⋅</mo><mi>k</mi><mo>⋅</mo><mi>k</mi></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msqrt><mn>7</mn><mo>⋅</mo><mi>h</mi><mo>⋅</mo><mi>k</mi><mo>⋅</mo><mn>7</mn><mo>⋅</mo><mi>h</mi><mo>⋅</mo><mi>k</mi></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msqrt><mo stretchy=\"false\">(</mo><mn>7</mn><mi>h</mi><mi>k</mi><mo stretchy=\"false\">)</mo><mo>⋅</mo><mo stretchy=\"false\">(</mo><mn>7</mn><mi>h</mi><mi>k</mi><mo stretchy=\"false\">)</mo></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msqrt><mo stretchy=\"false\">(</mo><mn>7</mn><mi>h</mi><mi>k</mi><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></msqrt></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Then, we take the absolute value of the squared quantity and simplify using the rules of absolute value:</p>\n<p><mjx-container class=\"MathJax CtxtMenu_A