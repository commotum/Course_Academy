xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow><mi>a</mi></mfrac></mstyle><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>2</mn><mo>+</mo><mn>2</mn></mrow><mn>1</mn></mfrac></mstyle><mo>=</mo><mn>4.</mn></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
