#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186486474} :activity/id #uuid "7e4b88a3-5d2d-5fd8-b226-94be09e3ceb9" :activity/scope {:db/id #edb/ref 17592186408186 :topic/id #uuid "67b4251f-708a-567e-be2f-62ab6bc1a315" :topic/math-academy-id 7005} :activity/steps [{:db/id #edb/ref 17592186486468 :step/content {:db/id #edb/ref 17592186486351 :knowledge-point/canonical-example {:db/id #edb/ref 17592186486367 :question/id #uuid "2ce7e093-c668-5ab6-b343-b49f04300b13" :question/math-academy-id "e-22712"} :knowledge-point/id #uuid "fdab7649-2d4d-5516-bf04-cfe674bbd3f8" :knowledge-point/questions [{:db/id #edb/ref 17592186486365} {:db/id #edb/ref 17592186486454}] :knowledge-point/title "Identifying an Additive Inverse"} :step/id #uuid "160c60e9-5ab9-50b5-945e-8198d95f11e8" :step/math-academy-id 621965 :step/next {:db/id #edb/ref 17592186486500}} {:db/id #edb/ref 17592186486474 :step/content {:db/id #edb/ref 17592186486524 :tutorial/content "On a number line, a number and its *additive inverse* are at the same distance from zero but on opposite sides. Remember that the distance of a number from zero is given by its *absolute value*.\n\nFor instance, the only two numbers that are at a distance of $4$ from zero are $4$ and $-4.$ So, $-4$ is the additive inverse of $4$ (and vice versa).\n\n![](images/c0/c0ac86b7f6b42079f164e07e9c0f7c8e35589c1eb8b1fe8762094ff1a59d0d5c.png)" :tutorial/id #uuid "d29afdb4-83a8-5d44-85aa-588cb62c58d8" :tutorial/math-academy-id 15163 :tutorial/title "Introduction"} :step/id #uuid "31b8f5ad-d1ac-5b65-a264-059708293d82" :step/math-academy-id 621964 :step/next {:db/id #edb/ref 17592186486468}} {:db/id #edb/ref 17592186486476 :step/content {:db/id #edb/ref 17592186486350 :knowledge-point/canonical-example {:db/id #edb/ref 17592186486449 :question/id #uuid "d5c1d845-4926-5b71-9aaf-b7f1a7983af3" :question/math-academy-id "e-22722"} :knowledge-point/id #uuid "dcbb661f-40e5-5926-8387-8720b43e57de" :knowledge-point/questions [{:db/id #edb/ref 17592186486377} {:db/id #edb/ref 17592186486390} {:db/id #edb/ref 17592186486429} {:db/id #edb/ref 17592186486462}] :knowledge-point/title "Interpreting Addition Using Absolute Value"} :step/id #uuid "44f3d1e3-06b3-5448-ac19-3aaeecc7c475" :step/math-academy-id 621975} {:db/id #edb/ref 17592186486496 :step/content {:db/id #edb/ref 17592186486525 :tutorial/content "Now, let $p=6$ and $q=-9.$ What point on the number line corresponds to $p+q?$\n\nThe value of $p+q$ is the number located a distance $|q|$ from $p$ on the number line, \n\n- moving to the *right* if $q$ is *positive*, and\n\n- moving to the *left* if $q$ is *negative*.\n\nIn our situation:\n\n- We start at $p = 6$ on the number line.\n\n- Here, $q = -9$, so the distance we move is $|q| = 9.$\n\n- Because $q$ is *negative*, we move $9$ units to the *left* from $6.$\n\n![](images/26/265469a65efa2ae63d794ee2ad0eeb79c6754ab18a7bec3791b8ba05007a744e.png)\n\nThis point corresponds to the number\n\n$$\n6 + (-9) = -3.\n$$" :tutorial/id #uuid "e93c19c4-c6b0-531d-b9a0-f2a16df8a410" :tutorial/math-academy-id 15173 :tutorial/title "Addition and Absolute Values on the Number Line"} :step/id #uuid "903b1e70-5068-5da3-8e39-2277b886461a" :step/math-academy-id 621974 :step/next {:db/id #edb/ref 17592186486476}} {:db/id #edb/ref 17592186486498 :step/content {:db/id #edb/ref 17592186486349 :knowledge-point/canonical-example {:db/id #edb/ref 17592186486432 :question/id #uuid "b716c849-40fa-5f39-a344-ee1a0ebde20d" :question/math-academy-id "e-22721"} :knowledge-point/id #uuid "056c4886-b3e9-575a-b584-1840a577d04e" :knowledge-point/questions [{:db/id #edb/ref 17592186486426} {:db/id #edb/ref 17592186486442} {:db/id #edb/ref 17592186486455}] :knowledge-point/title "Adding Opposite Quantities"} :step/id #uuid "93b60de0-a7f7-5e60-b050-2b523dabb82e" :step/math-academy-id 621970 :step/next {:db/id #edb/ref 17592186486496}} {:db/id #edb/ref 17592186486500 :step/content {:db/id #edb/ref 17592186486526 :tutorial/content "Suppose that a bank account had an *initial balance* of $\\[math]0.$ During the day, there was a *withdrawal* of $\\[/math]80.$ Then there was a *deposit* of $\\[math]80$ later.  \n\nWhat is the resulting amount in the account?\n\nIn our situation:\n\n- During the day, the account had a *withdrawal of* $\\[/math]80,$ which is a change of $-\\[math]80.$\n\n- Later, the account had a *deposit of* $\\[/math]80,$ which is a change of $+\\[math]80.$\n\nThese two changes are *opposite quantities*. When opposite quantities combine, they make $0{:}$\n\n$$\n-80 + 80 = 0\n$$\n\nTherefore, the balance returns to its original value of $\\[/math]0.$" :tutorial/id #uuid "f0d64651-a1e2-53b0-889b-8b5a7d8cddd6" :tutorial/math-academy-id 15172 :tutorial/title "Opposite Quantities Combine to Zero"} :step/id #uuid "9f48a277-1ef5-5804-98e6-8970d7e2ee30" :step/math-academy-id 621969 :step/next {:db/id #edb/ref 17592186486498}}] :activity/title "Interpreting Additive Opposites and Addition Using Absolute Value" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186485757}]}
