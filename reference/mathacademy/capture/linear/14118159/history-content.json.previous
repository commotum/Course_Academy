21 647Z\"></path>\n<path stroke-width=\"1\" id=\"E21-MJMAIN-2B\" d=\"M56 237T56 250T70 270H369V420L370 570Q380 583 389 583Q402 583 409 568V270H707Q722 262 722 250T707 230H409V-68Q401 -82 391 -82H389H387Q375 -82 369 -68V230H70Q56 237 56 250Z\"></path>\n<path stroke-width=\"1\" id=\"E21-MJMAIN-31\" d=\"M213 578L200 573Q186 568 160 563T102 556H83V602H102Q149 604 189 617T245 641T273 663Q275 666 285 666Q294 666 302 660V361L303 61Q310 54 315 52T339 48T401 46H427V0H416Q395 3 257 3Q121 3 100 0H88V46H114Q136 46 152 46T177 47T193 50T201 52T207 57T213 61V578Z\"></path>\n<path stroke-width=\"1\" id=\"E21-MJMAIN-29\" d=\"M60 749L64 750Q69 750 74 750H86L114 726Q208 641 251 514T294 250Q294 182 284 119T261 12T224 -76T186 -143T145 -194T113 -227T90 -246Q87 -249 86 -250H74Q66 -250 63 -250T58 -247T55 -238Q56 -237 66 -225Q221 -64 221 250T66 725Q56 737 55 738Q55 746 60 749Z\"></path>\n<path stroke-width=\"1\" id=\"E21-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E21-MJMATHI-50\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E21-MJMAIN-28\" x=\"751\" y=\"0\"></use>\n <use xlink:href=\"#E21-MJMATHI-6B\" x=\"1141\" y=\"0\"></use>\n <use xlink:href=\"#E21-MJMAIN-2B\" x=\"1884\" y=\"0\"></use>\n <use xlink:href=\"#E21-MJMAIN-31\" x=\"2885\" y=\"0\"></use>\n <use xlink:href=\"#E21-MJMAIN-29\" x=\"3385\" y=\"0\"></use>\n <use xlink:href=\"#E21-MJMAIN-2E\" x=\"3775\" y=\"0\"></use>\n</g>\n</svg></span> This is the first part of the so-called <strong>inductive step</strong>.</p>\n<blockquote>\n<p><strong>Inductive Step</strong>: We're required to prove that\n<span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"36.661ex\" height=\"3.176ex\" style=\"vertical-align: -0.838ex;\" viewBox=\"0 -1006.6 15784.5 1367.4\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-22-Title\">\n<title id=\"MathJax-SVG-22-Title\">\n(k+1)^2 &gt; 2(k+1)+2 . \\qquad\\qquad (\\ast)\n</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E22-MJMAIN-28\" d=\"M94 250Q94 319 104 381T127 488T164 576T202 643T244 695T277 729T302 750H315H319Q333 750 333 741Q333 738 316 720T275 667T226 581T184 443T167 250T184 58T225 -81T274 -167T316 -220T333 -241Q333 -250 318 -250H315H302L274 -226Q180 -141 137 -14T94 250Z\"></path>\n<path stroke-width=\"1\" id=\"E22-MJMATHI-6B\" d=\"M121 647Q121 657 125 670T137 683Q138 683 209 688T282 694Q294 694 294 686Q294 679 244 477Q194 279 194 272Q213 282 223 291Q247 309 292 354T362 415Q402 442 438 442Q468 442 485 423T503 369Q503 344 496 327T477 302T456 291T438 288Q418 288 406 299T394 328Q394 353 410 369T442 390L458 393Q446 405 434 405H430Q398 402 367 380T294 316T228 255Q230 254 243 252T267 246T293 238T320 224T342 206T359 180T365 147Q365 130 360 106T354 66Q354 26 381 26Q429 26 459 145Q461 153 479 153H483Q499 153 499 144Q499 139 496 130Q455 -11 378 -11Q333 -11 305 15T277 90Q277 108 280 121T283 145Q283 167 269 183T234 206T200 217T182 220H180Q168 178 159 139T145 81T136 44T129 20T122 7T111 -2Q98 -11 83 -11Q66 -11 57 -1T48 16Q48 26 85 176T158 471L195 616Q196 629 188 632T149 637H144Q134 637 131 637T124 640T121 647Z\"></path>\n<path stroke-width=\"1\" id=\"E22-MJMAIN-2B\" d=\"M56 237T56 250T70 270H369V420L370 570Q380 583 389 583Q402 583 409 568V270H707Q722 262 722 250T707 230H409V-68Q401 -82 391 -82H389H387Q375 -82 369 -68V230H70Q56 237 56 250Z\"></path>\n<path stroke-width=\"1\" id=\"E22-MJMAIN-31\" d=\"M213 578L200 573Q186 568 160 563T102 556H83V602H102Q149 604 189 617T245 641T273 663Q275 666 285 666Q294 666 302 660V361L303 61Q310 54 315 52T339 48T401 46H427V0H416Q395 3 257 3Q121 3 100 0H88V46H114Q136 46 152 46T177 47T193 50T201 52T207 57T213 61V578Z\"></path>\n<path stroke-width=\"1\" id=\"E22-MJMAIN-29\" d=\"M60 749L64 750Q69 750 74 750H86L114 726Q208 641 251 514T294 250Q294 182 284 119T261 12T224 -76T186 -143T145 -194T113 -227T90 -246Q87 -249 86 -250H74Q66 -250 63 -250T58 -247T55 -238Q56 -237 66 -225Q221 -64 221 250T66 725Q56 737 55 738Q55 746 60 749Z\"></path>\n<path stroke-width=\"1\" id=\"E22-MJMAIN-32\" d=\"M109 429Q82 429 66 447T50 491Q50 562 103 614T235 666Q326 666 387 610T449 465Q449 422 429 383T381 315T301 241Q265 210 201 149L142 93L218 92Q375 92 385 97Q392 99 409 186V189H449V186Q448 183 436 95T421 3V0H50V19V31Q50 38 56 46T86 81Q115 113 136 137Q145 147 170 174T204 211T233 244T261 278T284 308T305 340T320 369T333 401T340 431T343 464Q343 527 309 573T212 619Q179 619 154 602T119 569T109 550Q109 549 114 549Q132 549 151 535T170 489Q170 464 154 447T109 429Z\"></path>\n<path stroke-width=\"1\" id=\"E22-MJMAIN-3E\" d=\"M84 520Q84 528 88 533T96 539L99 540Q106 540 253 471T544 334L687 265Q694 260 694 250T687 235Q685 233 395 96L107 -40H101Q83 -38 83 -20Q83 -19 83 -17Q82 -10 98 -1Q117 9 248 71Q326 108 378 132L626 250L378 368Q90 504 86 509Q84 513 84 520Z\"></path>\n<path stroke-width=\"1\" id=\"E22-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n<path stroke-width=\"1\" id=\"E22-MJMAIN-2217\" d=\"M229 286Q216 420 216 436Q216 454 240 464Q241 464 245 464T251 465Q263 464 273 456T283 436Q283 419 277 356T270 286L328 328Q384 369 389 372T399 375Q412 375 423 365T435 338Q435 325 425 315Q420 312 357 282T289 250L355 219L425 184Q434 175 434 161Q434 146 425 136T401 125Q393 125 383 131T328 171L270 213Q283 79 283 63Q283 53 276 44T250 35Q231 35 224 44T216 63Q216 80 222 143T229 213L171 171Q115 130 110 127Q106 124 100 124Q87 124 76 134T64 161Q64 166 64 169T67 175T72 181T81 188T94 195T113 204T138 215T170 230T210 250L74 315Q65 324 65 338Q65 353 74 363T98 374Q106 374 116 368T171 328L229 286Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E22-MJMAIN-28\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E22-MJMATHI-6B\" x=\"389\" y=\"0\"></use>\n <use xlink:href=\"#E22-MJMAIN-2B\" x=\"1133\" y=\"0\"></use>\n <use xlink:href=\"#E22-MJMAIN-31\" x=\"2133\" y=\"0\"></use>\n<g transform=\"translate(2634,0)\">\n <use xlink:href=\"#E22-MJMAIN-29\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E22-MJMAIN-32\" x=\"550\" y=\"583\"></use>\n</g>\n <use xlink:href=\"#E22-MJMAIN-3E\" x=\"3755\" y=\"0\"></use>\n <use xlink:href=\"#E22-MJMAIN-32\" x=\"4811\" y=\"0\"></use>\n <use xlink:href=\"#E22-MJMAIN-28\" x=\"5312\" y=\"0\"></use>\n <use xlink:href=\"#E22-MJMATHI-6B\" x=\"5701\" y=\"0\"></use>\n <use xlink:href=\"#E22-MJMAIN-2B\" x=\"6445\" y=\"0\"></use>\n <use xlink:href=\"#E22-MJMAIN-31\" x=\"7446\" y=\"0\"></use>\n <use xlink:href=\"#E22-MJMAIN-29\" x=\"7946\" y=\"0\"></use>\n <use xlink:href=\"#E22-MJMAIN-2B\" x=\"8558\" y=\"0\"></use>\n <use xlink:href=\"#E22-MJMAIN-32\" x=\"9559\" y=\"0\"></use>\n <use xlink:href=\"#E22-MJMAIN-2E\" x=\"10059\" y=\"0\"></use>\n <use xlink:href=\"#E22-MJMAIN-28\" x=\"14504\" y=\"0\"></use>\n <use xlink:href=\"#E22-MJMAIN-2217\" x=\"14894\" y=\"0\"></use>\n <use xlink:href=\"#E22-MJMAIN-29\" x=\"15394\" y=\"0\"></use>\n</g>\n</svg></span></p>\n</blockquote>\n<p>The idea is to rewrite the left-hand side of <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"2.972ex\" height=\"2.843ex\" style=\"vertical-align: -0.838ex;\" viewBox=\"0 -863.1 1279.5 1223.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-23-Title\">\n<title id=\"MathJax-SVG-23-Title\">(\\ast)</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E23-MJMAIN-28\" d=\"M94 250Q94 319 104 381T127 488T164 576T202 643T244 695T277 729T302 750H315H319Q333 750 333 741Q333 738 316 720T275 667T226 581T184 443T167 250T184 58T225 -81T274 -167T316 -220T333 -241Q333 -250 318 -250H315H302L274 -226Q180 -141 137 -14T94 250Z\"></path>\n<path stroke-width=\"1\" id=\"E23-MJMAIN-2217\" d=\"M229 286Q216 420 216 436Q216 454 240 464Q241 464 245 464T251 465Q263 464 273 456T283 436Q283 419 277 356T270 286L328 328Q384 369 389 372T399 375Q412 375 423 365T435 338Q435 325 425 315Q420 312 357 282T289 250L355 219L425 184Q434 175 434 161Q434 146 425 136T401 125Q393 125 383 131T328 171L270 213Q283 79 283 63Q283 53 276 44T250 35Q231 35 224 44T216 63Q216 80 222 143T229 213L171 171Q115 130 110 127Q106 124 100 124Q87 124 76 134T64 161Q64 166 64 169T67 175T72 181T81 188T94 195T113 204T138 215T170 230T210 250L74 315Q65 324 65 338Q65 353 74 363T98 374Q106 374 116 368T171 328L229 286Z\"></path>\n<path stroke-width=\"1\" id=\"E23-MJMAIN-29\" d=\"M60 749L64 750Q69 750 74 750H86L114 726Q208 641 251 514T294 250Q294 182 284 119T261 12T224 -76T186 -143T145 -194T113 -227T90 -246Q87 -249 86 -250H74Q66 -250 63 -250T58 -247T55 -238Q56 -237 66 -225Q221 -64 221 250T66 725Q56 737 55 738Q55 746 60 749Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E23-MJMAIN-28\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E23-MJMAIN-2217\" x=\"389\" y=\"0\"></use>\n <use xlink:href=\"#E23-MJMAIN-29\" x=\"890\" y=\"0\"></use>\n</g>\n</svg></span> <em>using the inductive hypothesis</em> and apply algebraic techniques to show that this is greater than the right-hand side. We do this as follows:</p>\n<blockquote>\n<p>We write\n<span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"24.057ex\" height=\"3.176ex\" style=\"vertical-align: -1.005ex;\" viewBox=\"0 -934.9 10357.8 1367.4\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-24-Title\">\n<title id=\"MathJax-SVG-24-Title\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"15\" style=\"font-size: 113.1%; position: relative;\"><mjx-math d