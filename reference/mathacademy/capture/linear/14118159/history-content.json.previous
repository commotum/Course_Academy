ath xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi><mo>=</mo><mn>1</mn></math></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></div><div class=\"selectListOption\" style=\"height: 22px;\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"367\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3E\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"727\" jax=\"CHTML\" style=\"font-size: 119.6%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3E\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi><mo>&gt;</mo><mn>1</mn></math></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></div><div class=\"selectListOption\" style=\"height: 22px;\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"368\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2265\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"728\" jax=\"CHTML\" style=\"font-size: 119.6%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2265\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi><mo>≥</mo><mn>3</mn></math></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></div></div></div>.</span></div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyEasy\">E</div><span class=\"answerCreated\">Sun, Oct 11th @ 6:49 AM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 3:16</span><span class=\"answerResult\"><span style=\"color: green;\">Full Credit</span></span></div></div>"
