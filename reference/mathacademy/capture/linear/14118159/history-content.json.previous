0 222 143T229 213L171 171Q115 130 110 127Q106 124 100 124Q87 124 76 134T64 161Q64 166 64 169T67 175T72 181T81 188T94 195T113 204T138 215T170 230T210 250L74 315Q65 324 65 338Q65 353 74 363T98 374Q106 374 116 368T171 328L229 286Z\"></path>\n<path stroke-width=\"1\" id=\"E21-MJMAIN-29\" d=\"M60 749L64 750Q69 750 74 750H86L114 726Q208 641 251 514T294 250Q294 182 284 119T261 12T224 -76T186 -143T145 -194T113 -227T90 -246Q87 -249 86 -250H74Q66 -250 63 -250T58 -247T55 -238Q56 -237 66 -225Q221 -64 221 250T66 725Q56 737 55 738Q55 746 60 749Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E21-MJMAIN-32\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(500,412)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E21-MJMATHI-6B\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E21-MJMAIN-2B\" x=\"521\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E21-MJMAIN-31\" x=\"1300\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E21-MJMAIN-2B\" x=\"2095\" y=\"0\"></use>\n <use xlink:href=\"#E21-MJMAIN-31\" x=\"3096\" y=\"0\"></use>\n <use xlink:href=\"#E21-MJMAIN-2264\" x=\"3874\" y=\"0\"></use>\n<g transform=\"translate(4931,0)\">\n <use xlink:href=\"#E21-MJMAIN-33\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(500,412)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E21-MJMATHI-6B\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E21-MJMAIN-2B\" x=\"521\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E21-MJMAIN-31\" x=\"1300\" y=\"0\"></use>\n</g>\n</g>\n <use xlink:href=\"#E21-MJMAIN-2E\" x=\"6804\" y=\"0\"></use>\n <use xlink:href=\"#E21-MJMAIN-28\" x=\"11249\" y=\"0\"></use>\n <use xlink:href=\"#E21-MJMAIN-2217\" x=\"11639\" y=\"0\"></use>\n <use xlink:href=\"#E21-MJMAIN-29\" x=\"12139\" y=\"0\"></use>\n</g>\n</svg></span></p>\n</blockquote>\n<p>The idea is to rewrite the left-hand side of <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"2.972ex\" height=\"2.843ex\" style=\"vertical-align: -0.838ex;\" viewBox=\"0 -863.1 1279.5 1223.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-22-Title\">\n<title id=\"MathJax-SVG-22-Title\">(\\ast)</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E22-MJMAIN-28\" d=\"M94 250Q94 319 104 381T127 488T164 576T202 643T244 695T277 729T302 750H315H319Q333 750 333 741Q333 738 316 720T275 667T226 581T184 443T167 250T184 58T225 -81T274 -167T316 -220T333 -241Q333 -250 318 -250H315H302L274 -226Q180 -141 137 -14T94 250Z\"></path>\n<path stroke-width=\"1\" id=\"E22-MJMAIN-2217\" d=\"M229 286Q216 420 216 436Q216 454 240 464Q241 464 245 464T251 465Q263 464 273 456T283 436Q283 419 277 356T270 286L328 328Q384 369 389 372T399 375Q412 375 423 365T435 338Q435 325 425 315Q420 312 357 282T289 250L355 219L425 184Q434 175 434 161Q434 146 425 136T401 125Q393 125 383 131T328 171L270 213Q283 79 283 63Q283 53 276 44T250 35Q231 35 224 44T216 63Q216 80 222 143T229 213L171 171Q115 130 110 127Q106 124 100 124Q87 124 76 134T64 161Q64 166 64 169T67 175T72 181T81 188T94 195T113 204T138 215T170 230T210 250L74 315Q65 324 65 338Q65 353 74 363T98 374Q106 374 116 368T171 328L229 286Z\"></path>\n<path stroke-width=\"1\" id=\"E22-MJMAIN-29\" d=\"M60 749L64 750Q69 750 74 750H86L114 726Q208 641 251 514T294 250Q294 182 284 119T261 12T224 -76T186 -143T145 -194T113 -227T90 -246Q87 -249 86 -250H74Q66 -250 63 -250T58 -247T55 -238Q56 -237 66 -225Q221 -64 221 250T66 725Q56 737 55 738Q55 746 60 749Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E22-MJMAIN-28\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E22-MJMAIN-2217\" x=\"389\" y=\"0\"></use>\n <use xlink:href=\"#E22-MJMAIN-29\" x=\"890\" y=\"0\"></use>\n</g>\n</svg></span> <em>using the inductive hypothesis</em> and apply algebraic techniques to show that this is less than or equal to the right-hand side. We do this as follows:</p>\n<blockquote>\n<p>We write\n<span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"24.197ex\" height=\"12.176ex\" style=\"vertical-align: -5.505ex;\" viewBox=\"0 -2872.4 10418.1 5242.4\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-23-Title\">\n<title id=\"MathJax-SVG-23-Title\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"19\" style=\"font-size: 113.1%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 10.037em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-bottom: 0.4em;\"><mjx-msup><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-script style=\"vertical-align: 0.413em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D458 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-texatom></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"text-align: left; padding-left: 0px; padding-bottom: 0.4em;\"><mjx-mi class=\"mjx-n\"></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-msup space=\"4\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-script style=\"vertical-align: 0.413em;\"><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D458 TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-msup><