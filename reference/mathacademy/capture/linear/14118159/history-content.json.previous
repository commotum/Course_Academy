      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14118159/observations/lesson-step-182507-6497f7c9a13b82be5204.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14118159/observations/lesson-step-182507-6497f7c9a13b82be5204.png",
