B\" stroke-width=\"1\"></path>\n<path d=\"M56 237T56 250T70 270H369V420L370 570Q380 583 389 583Q402 583 409 568V270H707Q722 262 722 250T707 230H409V-68Q401 -82 391 -82H389H387Q375 -82 369 -68V230H70Q56 237 56 250Z\" id=\"E18-MJMAIN-2B\" stroke-width=\"1\"></path>\n<path d=\"M213 578L200 573Q186 568 160 563T102 556H83V602H102Q149 604 189 617T245 641T273 663Q275 666 285 666Q294 666 302 660V361L303 61Q310 54 315 52T339 48T401 46H427V0H416Q395 3 257 3Q121 3 100 0H88V46H114Q136 46 152 46T177 47T193 50T201 52T207 57T213 61V578Z\" id=\"E18-MJMAIN-31\" stroke-width=\"1\"></path>\n<path d=\"M60 749L64 750Q69 750 74 750H86L114 726Q208 641 251 514T294 250Q294 182 284 119T261 12T224 -76T186 -143T145 -194T113 -227T90 -246Q87 -249 86 -250H74Q66 -250 63 -250T58 -247T55 -238Q56 -237 66 -225Q221 -64 221 250T66 725Q56 737 55 738Q55 746 60 749Z\" id=\"E18-MJMAIN-29\" stroke-width=\"1\"></path>\n<path d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\" id=\"E18-MJMAIN-2E\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E18-MJMATHI-50\" y=\"0\"></use>\n<use x=\"751\" xlink:href=\"#E18-MJMAIN-28\" y=\"0\"></use>\n<use x=\"1141\" xlink:href=\"#E18-MJMATHI-6B\" y=\"0\"></use>\n<use x=\"1884\" xlink:href=\"#E18-MJMAIN-2B\" y=\"0\"></use>\n<use x=\"2885\" xlink:href=\"#E18-MJMAIN-31\" y=\"0\"></use>\n<use x=\"3385\" xlink:href=\"#E18-MJMAIN-29\" y=\"0\"></use>\n<use x=\"3775\" xlink:href=\"#E18-MJMAIN-2E\" y=\"0\"></use>\n</g>\n</svg></span> This is the first part of the so-called <strong>inductive step</strong>.</p>\n<blockquote>\n<p><strong>Inductive Step</strong>: We're required to prove that\n<span class=\"mjpage mjpage__block\"><svg aria-labelledby=\"MathJax-SVG-19-Title\" focusable=\"false\" height=\"3.176ex\" role=\"img\" style=\"vertical-align: -0.838ex;\" viewbox=\"0 -1006.6 24166.2 1367.4\" width=\"56.128ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-19-Title\">\n(k+1)^2+ 3(k+1) &gt; 2(k+1)-1 = 2k+1 \\qquad\\qquad (\\ast)\n</title>\n<defs aria-hidden=\"true\">\n<path d=\"M94 250Q94 319 104 381T127 488T164 576T202 643T244 695T277 729T302 750H315H319Q333 750 333 741Q333 738 316 720T275 667T226 581T184 443T167 250T184 58T225 -81T274 -167T316 -220T333 -241Q333 -250 318 -250H315H302L274 -226Q180 -141 137 -14T94 250Z\" id=\"E19-MJMAIN-28\" stroke-width=\"1\"></path>\n<path d=\"M121 647Q121 657 125 670T137 683Q138 683 209 688T282 694Q294 694 294 686Q294 679 244 477Q194 279 194 272Q213 282 223 291Q247 309 292 354T362 415Q402 442 438 442Q468 442 485 423T503 369Q503 344 496 327T477 302T456 291T438 288Q418 288 406 299T394 328Q394 353 410 369T442 390L458 393Q446 405 434 405H430Q398 402 367 380T294 316T228 255Q230 254 243 252T267 246T293 238T320 224T342 206T359 180T365 147Q365 130 360 106T354 66Q354 26 381 26Q429 26 459 145Q461 153 479 153H483Q499 153 499 144Q499 139 496 130Q455 -11 378 -11Q333 -11 305 15T277 90Q277 108 280 121T283 145Q283 167 269 183T234 206T200 217T182 220H180Q168 178 159 139T145 81T136 44T129 20T122 7T111 -2Q98 -11 83 -11Q66 -11 57 -1T48 16Q48 26 85 176T158 471L195 616Q196 629 188 632T149 637H144Q134 637 131 637T124 640T121 647Z\" id=\"E19-MJMATHI-6B\" stroke-width=\"1\"></path>\n<path d=\"M56 237T56 250T70 270H369V420L370 570Q380 583 389 583Q402 583 409 568V270H707Q722 262 722 250T707 230H409V-68Q401 -82 391 -82H389H387Q375 -82 369 -68V230H70Q56 237 56 250Z\" id=\"E19-MJMAIN-2B\" stroke-width=\"1\"></path>\n<path d=\"M213 578L200 573Q186 568 160 563T102 556H83V602H102Q149 604 189 617T245 641T273 663Q275 666 285 666Q294 666 302 660V361L303 61Q310 54 315 52T339 48T401 46H427V0H416Q395 3 257 3Q121 3 100 0H88V46H114Q136 46 152 46T177 47T193 50T201 52T207 57T213 61V578Z\" id=\"E19-MJMAIN-31\" stroke-width=\"1\"></path>\n<path d=\"M60 749L64 750Q69 750 74 750H86L114 726Q208 641 251 514T294 250Q294 182 284 119T261 12T224 -76T186 -143T145 -194T113 -227T90 -246Q87 -249 86 -250H74Q66 -250 63 -250T58 -247T55 -238Q56 -237 66 -225Q221 -64 221 250T66 725Q56 737 55 738Q55 746 60 749Z\" id=\"E19-MJMAIN-29\" stroke-width=\"1\"></path>\n<path d=\"M109 429Q82 429 66 447T50 491Q50 562 103 614T235 666Q326 666 387 610T449 465Q449 422 429 383T381 315T301 241Q265 210 201 149L142 93L218 92Q375 92 385 97Q392 99 409 186V189H449V186Q448 183 436 95T421 3V0H50V19V31Q50 38 56 46T86 81Q115 113 136 137Q145 147 170 174T204 211T233 244T261 278T284 308T305 340T320 369T333 401T340 431T343 464Q343 527 309 573T212 619Q179 619 154 602T119 569T109 550Q109 549 114 549Q132 549 151 535T170 489Q170 464 154 447T109 429Z\" id=\"E19-MJMAIN-32\" stroke-width=\"1\"></path>\n<path d=\"M127 463Q100 463 85 480T69 524Q69 579 117 622T233 665Q268 665 277 664Q351 652 390 611T430 522Q430 470 396 421T302 350L299 348Q299 347 308 345T337 336T375 315Q457 262 457 175Q457 96 395 37T238 -22Q158 -22 100 21T42 130Q42 158 60 175T105 193Q133 193 151 175T169 130Q169 119 166 110T159 94T148 82T136 74T126 70T118 67L114 66Q165 21 238 21Q293 21 321 74Q338 107 338 175V195Q338 290 274 322Q259 328 213 329L171 330L168 332Q166 335 166 348Q166 366 174 366Q202 366 232 371Q266 376 294 413T322 525V533Q322 590 287 612Q265 626 240 626Q208 626 181 615T143 592T132 580H135Q138 579 143 578T153 573T165 566T175 555T183 540T186 520Q186 498 172 481T127 463Z\" id=\"E19-MJMAIN-33\" stroke-width=\"1\"></path>\n<path d=\"M84 520Q84 528 88 533T96 539L99 540Q106 540 253 471T544 334L687 265Q694 260 694 250T687 235Q685 233 395 96L107 -40H101Q83 -38 83 -20Q83 -19 83 -17Q82 -10 98 -1Q117 9 248 71Q326 108 378 132L626 250L378 368Q90 504 86 509Q84 513 84 520Z\" id=\"E19-MJMAIN-3E\" stroke-width=\"1\"></path>\n<path d=\"M84 237T84 250T98 270H679Q694 262 694 250T679 230H98Q84 237 84 250Z\" id=\"E19-MJMAIN-2212\" stroke-width=\"1\"></path>\n<path d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\" id=\"E19-MJMAIN-3D\" stroke-width=\"1\"></path>\n<path d=\"M229 286Q216 420 216 436Q216 454 240 464Q241 464 245 464T251 465Q263 464 273 456T283 436Q283 419 277 356T270 286L328 328Q384 369 389 372T399 375Q412 375 423 365T435 338Q435 325 425 315Q420 312 357 282T289 250L355 219L425 184Q434 175 434 161Q434 146 425 136T401 125Q393 125 383 131T328 171L270 213Q283 79 283 63Q283 53 276 44T250 35Q231 35 224 44T216 63Q216 80 222 143T229 213L171 171Q115 130 110 127Q106 124 100 124Q87 124 76 134T64 161Q64 166 64 169T67 175T72 181T81 188T94 195T113 204T138 215T170 230T210 250L74 315Q65 324 65 338Q65 353 74 363T98 374Q106 374 116 368T171 328L229 286Z\" id=\"E19-MJMAIN-2217\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E19-MJMAIN-28\" y=\"0\"></use>\n<use x=\"389\" xlink:href=\"#E19-MJMATHI-6B\" y=\"0\"></use>\n<use x=\"1133\" xlink:href=\"#E19-MJMAIN-2B\" y=\"0\"></use>\n<use x=\"2133\" xlink:href=\"#E19-MJMAIN-31\" y=\"0\"></use>\n<g transform=\"translate(2634,0)\">\n<use x=\"0\" xlink:href=\"#E19-MJMAIN-29\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"550\" xlink:href=\"#E19-MJMAIN-32\" y=\"583\"></use>\n</g>\n<use x=\"3700\" xlink:href=\"#E19-MJMAIN-2B\" y=\"0\"></use>\n<use x=\"4700\" xlink:href=\"#E19-MJMAIN-33\" y=\"0\"></use>\n<use x=\"5201\" xlink:href=\"#E19-MJMAIN-28\" y=\"0\"></use>\n<use x=\"5590\" xlink:href=\"#E19-MJMATHI-6B\" y=\"0\"></use>\n<use x=\"6334\" xlink:href=\"#E19-MJMAIN-2B\" y=\"0\"></use>\n<use x=\"7335\" xlink:href=\"#E19-MJMAIN-31\" y=\"0\"></use>\n<use x=\"7835\" xlink:href=\"#E19-MJMAIN-29\" y=\"0\"></use>\n<use x=\"8503\" xlink:href=\"#E19-MJMAIN-3E\" y=\"0\"></use>\n<use x=\"9559\" xlink:href=\"#E19-MJMAIN-32\" y=\"0\"></use>\n<use x=\"10059\" xlink:href=\"#E19-MJMAIN-28\" y=\"0\"></use>\n<use x=\"10449\" xlink:href=\"#E19-MJMATHI-6B\" y=\"0\"></use>\n<use x=\"11193\" xlink:href=\"#E19-MJMAIN-2B\" y=\"0\"></use>\n<use x=\"12193\" xlink:href=\"#E19-MJMAIN-31\" y=\"0\"></use>\n<use x=\"12694\" xlink:href=\"#E19-MJMAIN-29\" y=\"0\"></use>\n<use x=\"13305\" xlink:href=\"#E19-MJMAIN-2212\" y=\"0\"></use>\n<use x=\"14306\" xlink:href=\"#E19-MJMAIN-31\" y=\"0\"></use>\n<use x=\"15084\" xlink:href=\"#E19-MJMAIN-3D\" y=\"0\"></use>\n<use x=\"16141\" xlink:href=\"#E19-MJMAIN-32\" y=\"0\"></use>\n<use x=\"16641\" xlink:href=\"#E19-MJMATHI-6B\" y=\"0\"></use>\n<use x=\"17385\" xlink:href=\"#E19-MJMAIN-2B\" y=\"0\"></use>\n<use x=\"18386\" xlink:href=\"#E19-MJMAIN-31\" y=\"0\"></use>\n<use x=\"22886\" xlink:href=\"#E19-MJMAIN-28\" y=\"0\"></use>\n<use x=\"23276\" xlink:href=\"#E19-MJMAIN-2217\" y=\"0\"></use>\n<use x=\"23776\" xlink:href=\"#E19-MJMAIN-29\" y=\"0\"></use>\n</g>\n</svg></span></p>\n</blockquote>\n<p>The idea is to rewrite the left-hand side of <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-20-Title\" focusable=\"false\" height=\"2.843ex\" role=\"img\" style=\"vertical-align: -0.838ex;\" viewbox=\"0 -863.1 1279.5 1223.9\" width=\"2.972ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-20-Title\">(\\ast)</title>\n<defs aria-hidden=\"true\">\n<path d=\"M94 250Q94 319 104 381T127 488T164 576T202 643T244 695T277 729T302 750H315H319Q333 750 333 741Q333 738 316 720T275 667T226 581T184 443T167 250T184 58T225 -81T274 -167T316 -220T333 -241Q333 -250 318 -250H315H302L274 -226Q180 -141 137 -14T94 250Z\" id=\"E20-MJMAIN-28\" stroke-width=\"1\"></path>\n<path d=\"M229 286Q216 420 216 436Q216 454 240 464Q241 464 245 464T251 465Q263 464 273 456T283 436Q283 419 277 356T270 286L328 328Q384 369 389 372T399 375Q412 375 423 365T435 338Q435 325 425 315Q420 312 357 282T289 250L355 219L425 184Q434 175 434 161Q434 146 425 136T401 125Q393 125 383 131T328 171L270 213Q283 79 283 63Q283 53 276 44T250 35Q231 35 224 44T216 63Q216 80 222 143T229 213L171 171Q115 130 110 127Q106 124 100 124Q87 124 76 134T64 161Q64 166 64 169T67 175T72 181T81 188T94 195T113 204T138 215T170 230T210 250L74 315Q65 324 65 338Q65 353 74 363T98 374Q106 374 116 368T171 328L229 286Z\" id=\"E20-MJMAIN-2217\" stroke-width=\"1\"></path>\n<path d=\"M60 749L64 750Q69 750 74 750H86L114 726Q208 641 251 514T294 250Q294 182 284 119T261 12T224 -76T186 -143T145 -194T113 -227T90 -246Q87 -249 86 -250H74Q66 -250 63 -250T58 -247T55 -238Q56 -237 66 -225Q221 -64 221 250T66 725Q56 737 55 738Q55 746 60 749Z\" id=\"E20-MJMAIN-29\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E20-MJMAIN-28\" y=\"0\"></use>\n<use x=\"389\" xlink:href=\"#E20-MJMAIN-2217\" y=\"0\"></use>\n<use x=\"890\" xlink:href=\"#E20-MJMAIN-29\" y=\"0\"></use>\n</g>\n</svg></span> <em>using the inductive hypothesis</em> and apply algebraic techniques to show that this is greater than the right-hand side. We do this as follows:</p>\n<blockquote>\n<p>We write\n<span class=\"mjpage mjpage__block\"><svg aria-labelledby=\"MathJax-SVG-21-Title\" focusable=\"false\" height=\"7.509ex\" role=\"img\" style=\"vertical-align: -3.171ex;\" viewbox=\"0 -1867.7 18795 3233.2\" width=\"43.653ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-21-Title\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"3\" display=\"true\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\" display=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 18.425em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-bottom: 0.4em;\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D458 TEX-I\"></mjx-c></mjx-mi