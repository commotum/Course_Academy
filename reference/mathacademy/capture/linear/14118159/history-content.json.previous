ef=\"#E24-MJMATHI-6B\" y=\"446\"></use>\n</g>\n</g>\n</g>\n<use x=\"4656\" xlink:href=\"#E24-MJMAIN-2B\" y=\"0\"></use>\n<g transform=\"translate(5656,0)\">\n<use x=\"0\" xlink:href=\"#E24-MJMAIN-33\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"707\" xlink:href=\"#E24-MJMATHI-6B\" y=\"583\"></use>\n</g>\n</g>\n<g transform=\"translate(0,-1659)\">\n<use x=\"277\" xlink:href=\"#E24-MJMAIN-3C\" y=\"0\"></use>\n<use x=\"1334\" xlink:href=\"#E24-MJMAIN-32\" y=\"0\"></use>\n<use x=\"2056\" xlink:href=\"#E24-MJMAIN-22C5\" y=\"0\"></use>\n<g transform=\"translate(2557,0)\">\n<use x=\"0\" xlink:href=\"#E24-MJMAIN-33\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"707\" xlink:href=\"#E24-MJMATHI-6B\" y=\"583\"></use>\n</g>\n<use x=\"3748\" xlink:href=\"#E24-MJMAIN-2B\" y=\"0\"></use>\n<g transform=\"translate(4749,0)\">\n<use x=\"0\" xlink:href=\"#E24-MJMAIN-33\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"707\" xlink:href=\"#E24-MJMATHI-6B\" y=\"583\"></use>\n</g>\n</g>\n<g transform=\"translate(0,-3563)\">\n<use x=\"277\" xlink:href=\"#E24-MJMAIN-3D\" y=\"0\"></use>\n<use x=\"1334\" xlink:href=\"#E24-MJMAIN-33\" y=\"0\"></use>\n<use x=\"2056\" xlink:href=\"#E24-MJMAIN-22C5\" y=\"0\"></use>\n<g transform=\"translate(2557,0)\">\n<use x=\"0\" xlink:href=\"#E24-MJMAIN-33\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"707\" xlink:href=\"#E24-MJMATHI-6B\" y=\"583\"></use>\n</g>\n</g>\n<g transform=\"translate(0,-5467)\">\n<use x=\"277\" xlink:href=\"#E24-MJMAIN-3D\" y=\"0\"></use>\n<g transform=\"translate(1334,0)\">\n<use x=\"0\" xlink:href=\"#E24-MJMAIN-33\" y=\"0\"></use>\n<g transform=\"translate(500,412)\">\n<use transform=\"scale(0.707)\" x=\"0\" xlink:href=\"#E24-MJMATHI-6B\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"521\" xlink:href=\"#E24-MJMAIN-2B\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"1300\" xlink:href=\"#E24-MJMAIN-31\" y=\"0\"></use>\n</g>\n</g>\n<use x=\"3207\" xlink:href=\"#E24-MJMAIN-2C\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span>\nas required.</p>\n</blockquote>\n<p>Since we've shown that the left-hand side of <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-25-Title\" focusable=\"false\" height=\"2.843ex\" role=\"img\" style=\"vertical-align: -0.838ex;\" viewbox=\"0 -863.1 1279.5 1223.9\" width=\"2.972ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-25-Title\">(\\ast)</title>\n<defs aria-hidden=\"true\">\n<path d=\"M94 250Q94 319 104 381T127 488T164 576T202 643T244 695T277 729T302 750H315H319Q333 750 333 741Q333 738 316 720T275 667T226 581T184 443T167 250T184 58T225 -81T274 -167T316 -220T333 -241Q333 -250 318 -250H315H302L274 -226Q180 -141 137 -14T94 250Z\" id=\"E25-MJMAIN-28\" stroke-width=\"1\"></path>\n<path d=\"M229 286Q216 420 216 436Q216 454 240 464Q241 464 245 464T251 465Q263 464 273 456T283 436Q283 419 277 356T270 286L328 328Q384 369 389 372T399 375Q412 375 423 365T435 338Q435 325 425 315Q420 312 357 282T289 250L355 219L425 184Q434 175 434 161Q434 146 425 136T401 125Q393 125 383 131T328 171L270 213Q283 79 283 63Q283 53 276 44T250 35Q231 35 224 44T216 63Q216 80 222 143T229 213L171 171Q115 130 110 127Q106 124 100 124Q87 124 76 134T64 161Q64 166 64 169T67 175T72 181T81 188T94 195T113 204T138 215T170 230T210 250L74 315Q65 324 65 338Q65 353 74 363T98 374Q106 374 116 368T171 328L229 286Z\" id=\"E25-MJMAIN-2217\" stroke-width=\"1\"></path>\n<path d=\"M60 749L64 750Q69 750 74 750H86L114 726Q208 641 251 514T294 250Q294 182 284 119T261 12T224 -76T186 -143T145 -194T113 -227T90 -246Q87 -249 86 -250H74Q66 -250 63 -250T58 -247T55 -238Q56 -237 66 -225Q221 -64 221 250T66 725Q56 737 55 738Q55 746 60 749Z\" id=\"E25-MJMAIN-29\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E25-MJMAIN-28\" y=\"0\"></use>\n<use x=\"389\" xlink:href=\"#E25-MJMAIN-2217\" y=\"0\"></use>\n<use x=\"890\" xlink:href=\"#E25-MJMAIN-29\" y=\"0\"></use>\n</g>\n</svg></span> is less than or equal to the right-hand side, our proof is complete. So, let's write down our conclusion. </p>\n<blockquote>\n<p>Therefore, by the principle of induction, <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-26-Title\" focusable=\"false\" height=\"2.343ex\" role=\"img\" style=\"vertical-align: -0.505ex;\" viewbox=\"0 -791.3 5107.7 1008.6\" width=\"11.863ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-26-Title\">2^n +1 \\leq 3^n</title>\n<defs aria-hidden=\"true\">\n<path d=\"M109 429Q82 429 66 447T50 491Q50 562 103 614T235 666Q326 666 387 610T449 465Q449 422 429 383T381 315T301 241Q265 210 201 149L142 93L218 92Q375 92 385 97Q392 99 409 186V189H449V186Q448 183 436 95T421 3V0H50V19V31Q50 38 56 46T86 81Q115 113 136 137Q145 147 170 174T204 211T233 244T261 278T284 308T305 340T320 369T333 401T340 431T343 464Q343 527 309 573T212 619Q179 619 154 602T119 569T109 550Q109 549 114 549Q132 549 151 535T170 489Q170 464 154 447T109 429Z\" id=\"E26-MJMAIN-32\" stroke-width=\"1\"></path>\n<path d=\"M21 287Q22 293 24 303T36 341T56 388T89 425T135 442Q171 442 195 424T225 390T231 369Q231 367 232 367L243 378Q304 442 382 442Q436 442 469 415T503 336T465 179T427 52Q427 26 444 26Q450 26 453 27Q482 32 505 65T540 145Q542 153 560 153Q580 153 580 145Q580 144 576 130Q568 101 554 73T508 17T439 -10Q392 -10 371 17T350 73Q350 92 386 193T423 345Q423 404 379 404H374Q288 404 229 303L222 291L189 157Q156 26 151 16Q138 -11 108 -11Q95 -11 87 -5T76 7T74 17Q74 30 112 180T152 343Q153 348 153 366Q153 405 129 405Q91 405 66 305Q60 285 60 284Q58 278 41 278H27Q21 284 21 287Z\" id=\"E26-MJMATHI-6E\" stroke-width=\"1\"></path>\n<path d=\"M56 237T56 250T70 270H369V420L370 570Q380 583 389 583Q402 583 409 568V270H707Q722 262 722 250T707 230H409V-68Q401 -82 391 -82H389H387Q375 -82 369 -68V230H70Q56 237 56 250Z\" id=\"E26-MJMAIN-2B\" stroke-width=\