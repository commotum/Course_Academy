5V195Q338 290 274 322Q259 328 213 329L171 330L168 332Q166 335 166 348Q166 366 174 366Q202 366 232 371Q266 376 294 413T322 525V533Q322 590 287 612Q265 626 240 626Q208 626 181 615T143 592T132 580H135Q138 579 143 578T153 573T165 566T175 555T183 540T186 520Q186 498 172 481T127 463Z\" id=\"E13-MJMAIN-33\" stroke-width=\"1\"></path>\n<path d=\"M78 35T78 60T94 103T137 121Q165 121 187 96T210 8Q210 -27 201 -60T180 -117T154 -158T130 -185T117 -194Q113 -194 104 -185T95 -172Q95 -168 106 -156T131 -126T157 -76T173 -3V9L172 8Q170 7 167 6T161 3T152 1T140 0Q113 0 96 17Z\" id=\"E13-MJMAIN-2C\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E13-MJMATHI-6E\" y=\"0\"></use>\n<use x=\"878\" xlink:href=\"#E13-MJMAIN-3D\" y=\"0\"></use>\n<g transform=\"translate(1934,0)\">\n<rect fill=\"Gainsboro\" height=\"1434\" stroke=\"none\" width=\"2956\" x=\"0\" y=\"-439\"></rect>\n<g>\n<g transform=\"translate(300,0)\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<use xlink:href=\"#E13-MJMATHI-6B\"></use>\n</g>\n<g fill=\"blue\" stroke=\"blue\" transform=\"translate(799,0)\">\n<use xlink:href=\"#E13-MJMAIN-2265\"></use>\n</g>\n<g fill=\"blue\" stroke=\"blue\" transform=\"translate(1855,0)\">\n<use xlink:href=\"#E13-MJMAIN-33\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n<use x=\"4890\" xlink:href=\"#E13-MJMAIN-2C\" y=\"0\"></use>\n</g>\n</svg></span> we have\n<span class=\"mjpage mjpage__block\"><svg aria-labelledby=\"MathJax-SVG-14-Title\" focusable=\"false\" height=\"4.009ex\" role=\"img\" style=\"vertical-align: -1.005ex;\" viewbox=\"0 -1293.7 4525.3 1726.2\" width=\"10.51ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-14-Title\">\n\\bbox[3pt,Gainsboro]{\\color{blue}2^k}  &gt; \\bbox[3pt,Gainsboro]{\\color{blue}2k}\n</title>\n<defs aria-hidden=\"true\">\n<path d=\"M109 429Q82 429 66 447T50 491Q50 562 103 614T235 666Q326 666 387 610T449 465Q449 422 429 383T381 315T301 241Q265 210 201 149L142 93L218 92Q375 92 385 97Q392 99 409 186V189H449V186Q448 183 436 95T421 3V0H50V19V31Q50 38 56 46T86 81Q115 113 136 137Q145 147 170 174T204 211T233 244T261 278T284 308T305 340T320 369T333 401T340 431T343 464Q343 527 309 573T212 619Q179 619 154 602T119 569T109 550Q109 549 114 549Q132 549 151 535T170 489Q170 464 154 447T109 429Z\" id=\"E14-MJMAIN-32\" stroke-width=\"1\"></path>\n<path d=\"M121 647Q121 657 125 670T137 683Q138 683 209 688T282 694Q294 694 294 686Q294 679 244 477Q194 279 194 272Q213 282 223 291Q247 309 292 354T362 415Q402 442 438 442Q468 442 485 423T503 369Q503 344 496 327T477 302T456 291T438 288Q418 288 406 299T394 328Q394 353 410 369T442 390L458 393Q446 405 434 405H430Q398 402 367 380T294 316T228 255Q230 254 243 252T267 246T293 238T320 224T342 206T359 180T365 147Q365 130 360 106T354 66Q354 26 381 26Q429 26 459 145Q461 153 479 153H483Q499 153 499 144Q499 139 496 130Q455 -11 378 -11Q333 -11 305 15T277 90Q277 108 280 121T283 145Q283 167 269 183T234 206T200 217T182 220H180Q168 178 159 139T145 81T136 44T129 20T122 7T111 -2Q98 -11 83 -11Q66 -11 57 -1T48 16Q48 26 85 176T158 471L195 616Q196 629 188 632T149 637H144Q134 637 131 637T124 640T121 647Z\" id=\"E14-MJMATHI-6B\" stroke-width=\"1\"></path>\n<path d=\"M84 520Q84 528 88 533T96 539L99 540Q106 540 253 471T544 334L687 265Q694 260 694 250T687 235Q685 233 395 96L107 -40H101Q83 -38 83 -20Q83 -19 83 -17Q82 -10 98 -1Q117 9 248 71Q326 108 378 132L626 250L378 368Q90 504 86 509Q84 513 84 520Z\" id=\"E14-MJMAIN-3E\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<rect fill=\"Gainsboro\" height=\"1505\" stroke=\"none\" width=\"1569\" x=\"0\" y=\"-301\"></rect>\n<g>\n<g transform=\"translate(300,0)\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<use xlink:href=\"#E14-MJMAIN-32\"></use>\n</g>\n<g fill=\"blue\" stroke=\"blue\" transform=\"translate(500,412)\">\n<use transform=\"scale(0.707)\" xlink:href=\"#E14-MJMATHI-6B\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n<use x=\"1847\" xlink:href=\"#E14-MJMAIN-3E\" y=\"0\"></use>\n<g transform=\"translate(2903,0)\">\n<rect fill=\"Gainsboro\" height=\"1307\" stroke=\"none\" width=\"1622\" x=\"0\" y=\"-312\"></rect>\n<g>\n<g transform=\"translate(300,0)\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<use xlink:href=\"#E14-MJMAIN-32\"></use>\n</g>\n<g fill=\"blue\" stroke=\"blue\" transform=\"translate(500,0)\">\n<use xlink:href=\"#E14-MJMATHI-6B\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n</blockquote>\n<p>Then, we move on to the <strong>inductive step</strong>: We must show that <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-15-Title\" focusable=\"false\" height=\"2.843ex\" role=\"img\" style=\"vertical-align: -0.838ex;\" viewbox=\"0 -863.1 7662 1223.9\" width=\"17.796ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-15-Title\">P(k) \\Rightarrow P(k+1).</title>\n<defs aria-hidden=\"true\">\n<path d=\"M287 628Q287 635 230 637Q206 637 199 638T192 648Q192 649 194 659Q200 679 203 681T397 683Q587 682 600 680Q664 669 707 631T751 530Q751 453 685 389Q616 321 507 303Q500 302 402 301H307L277 182Q247 66 247 59Q247 55 248 54T255 50T272 48T305 46H336Q342 37 342 35Q342 19 335 5Q330 0 319 0Q316 0 282 1T182 2Q120 2 87 2T51 1Q33 1 33 11Q33 13 36 25Q40 41 44 43T67 46Q94 46 127 49Q141 52 146 61Q149 65 218 339T287 628ZM645 554Q645 567 643 575T634 597T609 619T560 635Q553 636 480 637Q463 637 445 637T416 636T404 636Q391 635 386 627Q384 621 367 550T332 412T314 344Q314 342 395 342H407H430Q542 342 590 392Q617 419 631 471T645 554Z\" id=\"