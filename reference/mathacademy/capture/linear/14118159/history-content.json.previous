6979\" xlink:href=\"#E25-MJMAIN-31\" y=\"0\"></use>\n</g>\n<g transform=\"translate(0,688)\">\n<use x=\"277\" xlink:href=\"#E25-MJMAIN-3E\" y=\"0\"></use>\n<use x=\"1334\" xlink:href=\"#E25-MJMAIN-32\" y=\"0\"></use>\n<use x=\"1834\" xlink:href=\"#E25-MJMATHI-6B\" y=\"0\"></use>\n<use x=\"2578\" xlink:href=\"#E25-MJMAIN-2B\" y=\"0\"></use>\n<use x=\"3579\" xlink:href=\"#E25-MJMAIN-32\" y=\"0\"></use>\n<use x=\"4301\" xlink:href=\"#E25-MJMAIN-2B\" y=\"0\"></use>\n<use x=\"5302\" xlink:href=\"#E25-MJMAIN-32\" y=\"0\"></use>\n<use x=\"5802\" xlink:href=\"#E25-MJMATHI-6B\" y=\"0\"></use>\n<use x=\"6546\" xlink:href=\"#E25-MJMAIN-2B\" y=\"0\"></use>\n<use x=\"7547\" xlink:href=\"#E25-MJMAIN-31\" y=\"0\"></use>\n</g>\n<g transform=\"translate(0,-1112)\">\n<use x=\"277\" xlink:href=\"#E25-MJMAIN-3D\" y=\"0\"></use>\n<use x=\"1334\" xlink:href=\"#E25-MJMAIN-32\" y=\"0\"></use>\n<use x=\"1834\" xlink:href=\"#E25-MJMATHI-6B\" y=\"0\"></use>\n<use x=\"2578\" xlink:href=\"#E25-MJMAIN-2B\" y=\"0\"></use>\n<use x=\"3579\" xlink:href=\"#E25-MJMAIN-32\" y=\"0\"></use>\n<use x=\"4301\" xlink:href=\"#E25-MJMAIN-2B\" y=\"0\"></use>\n<g transform=\"translate(5302,0)\">\n<g transform=\"translate(318,0)\">\n<use x=\"0\" xlink:href=\"#E25-MJMAIN-32\" y=\"0\"></use>\n<use x=\"500\" xlink:href=\"#E25-MJMATHI-6B\" y=\"0\"></use>\n</g>\n<g transform=\"translate(0,-526)\">\n<use x=\"23\" xlink:href=\"#E25-MJSZ4-E152\" y=\"0\"></use>\n<g transform=\"translate(390,0)\">\n<use xlink:href=\"#E25-MJSZ4-E151\"></use>\n<use x=\"450\" xlink:href=\"#E25-MJSZ4-E150\" y=\"0\"></use>\n</g>\n<use x=\"1207\" xlink:href=\"#E25-MJSZ4-E153\" y=\"0\"></use>\n</g>\n<g transform=\"translate(376,-1379)\">\n<use transform=\"scale(0.707)\" x=\"0\" xlink:href=\"#E25-MJMAIN-3E\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"778\" xlink:href=\"#E25-MJMAIN-31\" y=\"0\"></use>\n</g>\n</g>\n<use x=\"7182\" xlink:href=\"#E25-MJMAIN-2B\" y=\"0\"></use>\n<use x=\"8183\" xlink:href=\"#E25-MJMAIN-31\" y=\"0\"></use>\n</g>\n<g transform=\"translate(0,-4219)\">\n<use x=\"277\" xlink:href=\"#E25-MJMAIN-3E\" y=\"0\"></use>\n<use x=\"1334\" xlink:href=\"#E25-MJMAIN-32\" y=\"0\"></use>\n<use x=\"1834\" xlink:href=\"#E25-MJMAIN-28\" y=\"0\"></use>\n<use x=\"2224\" xlink:href=\"#E25-MJMATHI-6B\" y=\"0\"></use>\n<use x=\"2967\" xlink:href=\"#E25-MJMAIN-2B\" y=\"0\"></use>\n<use x=\"3968\" xlink:href=\"#E25-MJMAIN-31\" y=\"0\"></use>\n<use x=\"4469\" xlink:href=\"#E25-MJMAIN-29\" y=\"0\"></use>\n<use x=\"5080\" xlink:href=\"#E25-MJMAIN-2B\" y=\"0\"></use>\n<use x=\"6081\" xlink:href=\"#E25-MJMAIN-32\" y=\"0\"></use>\n<use x=\"6581\" xlink:href=\"#E25-MJMAIN-2C\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span>\nas required.</p>\n</blockquote>\n<p>Since we've shown that the left-hand side of <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-26-Title\" focusable=\"false\" height=\"2.843ex\" role=\"img\" style=\"vertical-align: -0.838ex;\" viewbox=\"0 -863.1 1279.5 1223.9\" width=\"2.972ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-26-Title\">(\\ast)</title>\n<defs aria-hidden=\"true\">\n<path d=\"M94 250Q94 319 104 381T127 488T164 576T202 643T244 695T277 729T302 750H315H319Q333 750 333 741Q333 738 316 720T275 667T226 581T184 443T167 250T184 58T225 -81T274 -167T316 -220T333 -241Q333 -250 318 -250H315H302L274 -226Q180 -141 137 -14T94 250Z\" id=\"E26-MJMAIN-28\" stroke-width=\"1\"></path>\n<path d=\"M229 286Q216 420 216 436Q216 454 240 464Q241 464 245 464T251 465Q263 464 273 456T283 436Q283 419 277 356T270 286L328 328Q384 369 389 372T399 375Q412 375 423 365T435 338Q435 325 425 315Q420 312 357 282T289 250L355 219L425 184Q434 175 434 161Q434 146 425 136T401 125Q393 125 383 131T328 171L270 213Q283 79 283 63Q283 53 276 44T250 35Q231 35 224 44T216 63Q216 80 222 143T229 213L171 171Q115 130 110 127Q106 124 100 124Q87 124 76 134T64 161Q64 166 64 169T67 175T72 181T81 188T94 195T113 204T138 215T170 230T210 250L74 315Q65 324 65 338Q65 353 74 363T98 374Q106 374 116 368T171 328L229 286Z\" id=\"E26-MJMAIN-2217\" stroke-width=\"1\"></path>\n<path d=\"M60 749L64 750Q69 750 74 750H86L114 726Q208 641 251 514T294 250Q294 182 284 119T261 12T224 -76T186 -143T145 -194T113 -227T90 -246Q87 -249 86 -250H74Q66 -250 63 -250T58 -247T55 -238Q56 -237 66 -225Q221 -64 221 250T66 725Q56 737 55 738Q55 746 60 749Z\" id=\"E26-MJMAIN-29\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E26-MJMAIN-28\" y=\"0\"></use>\n<use x=\"389\" xlink:href=\"#E26-MJMAIN-2217\" y=\"0\"></use>\n<use x=\"890\" xlink:href=\"#E26-MJMAIN-29\" y=\"0\"></use>\n</g>\n</svg></span> is greater than the right-hand side, our proof is complete. So, let's write down our conclusion. </p>\n<blockquote>\n<p>Therefore, by the principle of induction, <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-27-Title\" focusable=\"false\" height=\"2.676ex\" role=\"img\" style=\"vertical-align: -0.505ex;\" viewbox=\"0 -934.9 5212.9 1152.1\" width=\"12.107ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-27-Title\">n^2 &gt; 2n+2</title>\n<defs aria-hidden=\"true\">\n<path d=\"M21 287Q22 293 24 303T36 341T56 388T89 425T135 442Q171 442 195 424T225 390T231 369Q231 367 232 367L243 378Q304 442 382 442Q436 442 469 415T503 336T465 179T427 52Q427 26 444 26Q450 26 453 27Q482 32 505 65T540 145Q542 153 560 153Q580 153 580 145Q580 144 576 130Q568 101 554 73T508 17T439 -10Q392 -10 371 17T350 73Q350 92 386 193T423 345Q423 404 379 404H374Q288 404 229 303L222 291L189 157Q156 26 151 16Q138 -11 108 -11Q95 -11 87 -5T76 7T74 17Q74 30 112 180T152 343Q153 348 153 366Q153 405 129 405Q91 405 66 305Q60 285 60 284Q58 278 41 278H27Q21 284 21 287Z\" id=\"E27-MJMATHI-6E\" stroke-width=\"1\"></path>\n<path d=\"M109 429Q82 429 66 447T50 491Q50 562 103 614T235 666Q326 666 387 610T449 465Q449 422 429 383T381 315T301 241Q265 210 201 149L142 93L218 92Q375 92 385 97Q392 99 409 186V189H449V186Q448 183 436 95T421 3V0H50V19V31Q50 38 56 46T86 81Q115 113 136 137Q145 147 170 174T204 211T233 244T261 278T284 308T305 340T320 369T333 401T340 431T343 464Q343 527 309 573T212 619Q179 619 154 602T119 569T109 550Q109 549 114 549Q132 549 151 535T170 489Q170 464 154 447T109 429Z\" id=\"E27-MJMAIN-32\" stroke-width=\"1\"></path>\n<path d=\"M84 520Q84 528 88 533T96 539L99 540Q106 540 253 471T544 334L687 265Q694 260 694 250T687 235Q685 233 395 96L107 -40H101Q83 -38 83 -20Q83 -19 83 -17Q82 -10 98 -1Q117 9 248 71Q326 108 378 132L626 250L378 368Q90 504 86 509Q84 513 84 520Z\" id=\"E27-MJMAIN-3E\" stroke-width=\"1\"></path>\n<path d=\"M56 237T56 250T70 270H369V420L370 570Q380 583 389 583Q402 583 409 568V270H707Q722 262 722 250T707 230H409V-68Q401 -82 391 -82H389H387Q375 -82 369 -68V230H70Q56 237 56 250Z\" id=\"E27-MJMAIN-2B\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E27-MJMATHI-6E\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"849\" xlink:href=\"#E27-MJMAIN-32\" y=\"513\"></use>\n<use x=\"1332\" xlink:href=\"#E27-MJMAIN-3E\" y=\"0\"></use>\n<use x=\"2388\" xlink:href=\"#E27-MJMAIN-32\" y=\"0\"></use>\n<use x=\"2888\" xlink:href=\"#E27-MJMATHI-6E\" y=\"0\"></use>\n<use x=\"3711\" xlink:href=\"#E27-MJMAIN-2B\" y=\"0\"></use>\n<use x=\"4712\" xlink:href=\"#E27-MJMAIN-32\" y=\"0\"></use>\n</g>\n</svg></span> for all <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-28-Title\" focusable=\"false\" height=\"2.343ex\" role=\"img\" style=\"vertical-align: -0.505ex;\" viewbox=\"0 -791.3 2713.6 1008.6\" width=\"6.302ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-28-Title\">n \\geq 3.</title>\n<defs aria-hidden=\"true\">\n<path d=\"M21 287Q22 293 24 303T36 341T56 388T89 425T135 442Q171 442 195 424T225 390T231 369Q231 367 232 367L243 378Q304 442 382 442Q436 442 469 415T503 336T465 179T427 52Q427 26 444 26Q450 26 453 27Q482 32 505 65T540 145Q542 153 560 153Q580 153 580 145Q580 144 576 130Q568 101 554 73T508 17T439 -10Q392 -10 371 17T350 73Q350 92 386 193T423 345Q423 404 379 404H374Q288 404 229 303L222 291L189 157Q156 26 151 16Q138 -11 108 -11Q95 -11 87 -5T76 7T74 17Q74 30 112 180T152 343Q153 348 153 366Q153 405 129 405Q91 405 66 305Q60 285 60 284Q58 278 41 278H27Q21 284 21 287Z\" id=\"E28-MJMATHI-6E\" stroke-width=\"1\"></path>\n<path d=\"M83 616Q83 624 89 630T99 636Q107 636 253 568T543 431T687 361Q694 356 694 346T687 331Q685 329 395 192L107 56H101Q83 58 83 76Q83 77 83 79Q82 86 98 95Q117 105 248 167Q326 204 378 228L626 346L360 472Q291 505 200 548Q112 589 98 597T83 616ZM84 -118Q84 -108 99 -98H678Q694 -104 694 -118Q694 -130 679 -138H98Q84 -131 84 -118Z\" id=\"E28-MJMAIN-2265\" stroke-width=\"1\"></path>\n<path d=\"M127 463Q100 463 85 480T69 524Q69 579 117 622T233 665Q268 665 277 664Q351 652 390 611T430 522Q430 470 396 421T302 350L299 348Q299 347 308 345T337 336T375 315Q457 262 457 175Q457 96 395 37T238 -22Q158 -22 100 21T42 130Q42 158 60 175T105 193Q133 193 151 175T169 130Q169 119 166 110T159 94T148 82T136 74T126 70T118 67L114 66Q165 21 238 21Q293 21 321 74Q338 107 338 175V195Q338 290 274 322Q259 328 213 329L171 330L168 332Q166 335 166 348Q166 366 174 366Q202 366 232 371Q266 376 294 413T322 525V533Q322 590 287 612Q265 626 240 626Q208 626 181 615T143 592T132 580H135Q138 579 143 578T153 573T165 566T175 555T183 540T186 520Q186 498 172 481T127 463Z\" id=\"E28-MJMAIN-33\" stroke-width=\"1\"></path>\n<path d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\" id=\"E28-MJMAIN-2E\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E28-MJMATHI-6E\" y=\"0\"></use>\n<use x=\"878\" xlink:href=\"#E28-MJMAIN-2265\" y=\"0\"></use>\n<g transform=\"translate(1934,0)\">\n<use xlink:href=\"#E28-MJMAIN-33\"></use>\n<use x=\"500\" xlink:href=\"#E28-MJMAIN-2E\" y=\"0\"></use>\n</g>\n</g>\n</svg></span></p>\n</blockquote>\n</div>\n</div>"
