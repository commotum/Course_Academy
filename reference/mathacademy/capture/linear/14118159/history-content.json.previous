=\"#E17-MJMAIN-2B\"></use>\n</g>\n<g fill=\"blue\" stroke=\"blue\" transform=\"translate(919,0)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E17-MJMAIN-31\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E17-MJMAIN-3E\" x=\"2751\" y=\"0\"></use>\n<g transform=\"translate(3807,0)\">\n<rect fill=\"Gainsboro\" stroke=\"none\" width=\"4124\" height=\"1602\" x=\"0\" y=\"-551\"></rect>\n<g>\n<g transform=\"translate(300,0)\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n <use xlink:href=\"#E17-MJMAIN-32\"></use>\n</g>\n<g fill=\"blue\" stroke=\"blue\" transform=\"translate(500,0)\">\n <use xlink:href=\"#E17-MJMAIN-28\"></use>\n</g>\n<g fill=\"blue\" stroke=\"blue\" transform=\"translate(890,0)\">\n <use xlink:href=\"#E17-MJMATHI-6B\"></use>\n</g>\n<g fill=\"blue\" stroke=\"blue\" transform=\"translate(1633,0)\">\n <use xlink:href=\"#E17-MJMAIN-2B\"></use>\n</g>\n<g fill=\"blue\" stroke=\"blue\" transform=\"translate(2634,0)\">\n <use xlink:href=\"#E17-MJMAIN-31\"></use>\n</g>\n<g fill=\"blue\" stroke=\"blue\" transform=\"translate(3134,0)\">\n <use xlink:href=\"#E17-MJMAIN-29\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E17-MJMAIN-2E\" x=\"7932\" y=\"0\"></use>\n</g>\n</svg></span></p>\n</blockquote>\n<p>The inductive step is where most of the work lies. The idea is to rewrite the left-hand side of this inequality using the inductive hypothesis and apply algebraic techniques to show that this is greater than the right-hand side.</p>\n<p>Once we've shown that <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"17.796ex\" height=\"2.843ex\" style=\"vertical-align: -0.838ex;\" viewBox=\"0 -863.1 7662 1223.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-18-Title\">\n<title id=\"MathJax-SVG-18-Title\">P(k) \\Rightarrow P(k+1),</title>\n<defs aria-hidden=\"true\">\n<path stroke-w