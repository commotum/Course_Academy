8b7e672dfba" "answer-eae433ac-c679-50ec-b005-c3526bf636ae" "answer-f5afaeb0-79ee-5062-9e48-1015a614fee6" "answer-97cc4034-69aa-5684-8f6c-508a37a56861"] :db/ensure [:answer-field/validate]} {:db/id "answer-de0c18bd-9479-5dc6-b684-28b7e672dfba" :answer/id #uuid "de0c18bd-9479-5dc6-b684-28b7e672dfba" :answer/type :answer.type/math :answer/value "n=1" :db/ensure [:answer/validate]} {:db/id "answer-eae433ac-c679-50ec-b005-c3526bf636ae" :answer/id #uuid "eae433ac-c679-50ec-b005-c3526bf636ae" :answer/type :answer.type/math :answer/value "n>1" :db/ensure [:answer/validate]} {:db/id "answer-f5afaeb0-79ee-5062-9e48-1015a614fee6" :answer/id #uuid "f5afaeb0-79ee-5062-9e48-1015a614fee6" :answer/type :answer.type/math :answer/value "n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-97cc4034-69aa-5684-8f6c-508a37a56861" :answer/id #uuid "97cc4034-69aa-5684-8f6c-508a37a56861" :answer/type :answer.type/math :answer/value "n\\ge 2" :db/ensure [:answer/validate]} {:db/id 17592186092616 :question/problem "Use mathematical induction to prove that $6(n+1)<{n}^{3}$ for $n\\ge 3,n\\in N.$\n\nWe proceed using induction on $n.$\n\n**Base Case**: We first prove that our statement is true for the base case $n=\\,${{field-1}}.\n\nFor the left-hand side, we have\n\n$$\n\\begin{aligned}{{field-2}}={{field-3}}\\end{aligned}\n$$\n\nwhich is\n{{field-4}}\nthe right-hand side.\nThus, our statement is {{field-5}} for $n=3.$\n\n**Inductive Hypothesis**: We assume that for some $n=$ {{field-6}}, we have\n\n$$\n{{field-7}}<{{field-8}}.\n$$\n\n**Inductive Step**: To prove $P(k+1),$ we write\n\n$$\n\\begin{aligned}6(k+2) & ={{field-9}}.\\end{aligned}\n$$\n\nBy the inductive hypothesis, we have\n\n$$\n\\begin{aligned}6(k+1)+6 & <{{field-10}} \\\\  & ={{field-11}} \\\\  & <{{field-12}}\\end{aligned}\n$$\n\n$$\n\\begin{aligned} & ={{field-13}},\\end{aligned}\n$$\n\nas required.\n\nTherefore, by the principle of induction, $6(n+1)<{n}^{3}$ is true for all\n{{field-14}}." :question/worked-solution "A variant of the principle of induction states the following: Let ${n}_{0}$ be an integer. Suppose we have a sequence of mathematical statements $P({n}_{0}),P({n}_{0}+1),P({n}_{0}+2),…,$ where\n\n- $P({n}_{0})$ is true, and\n\n- $P(k)⇒P(k+1)$ for every integer $k\\ge {n}_{0}.$\n\nThen, $P(n)$ is true for every integer $n\\ge {n}_{0}.$\n\nIn this case, the general statement $P(n)$ we're required to prove is the following:\n\n$$\n6(n+1)<{n}^{3}\\,\\text{for}\\,n\\ge 3.\n$$\n\nWe start by proving the so-called base case, $P(3).$ To do this, we substitute $n=3$ into both the left-hand side and right-hand side and show that the left-hand side is less than the right-hand side:\n\nWe proceed using induction on $n.$\n\n**Base Case**: We first prove our statement is true for the base case $n=3.$\nFor the left-hand side, we have\n\n$$\n\\begin{aligned}6(3+1)=24,\\end{aligned}\n$$\n\nand for the right-hand side, we have\n\n$$\n\\begin{aligned}{3}^{3}=27,\\end{aligned}\n$$\n\nThus, our statement is true for $n=3.$\n\nNext, we state our inductive hypothesis. Here, we assume that the given statement is true for some $n=k\\ge 3.$ \n\n**Inductive Hypothesis**: We assume that for some $n=k\\ge 3,$ we have\n\n$$\n6(k+1)<{k}^{3}.\n$$\n\nWe must show that $P(k)⇒P(k+1).$ Let's start by writing down $P(k+1).$ This is the first part of the so-called **inductive step**.\n\n**Inductive Step**: We're required to prove that\n\n$$\n6((k+1)+1)=6k+2<(k+1)^{3}.\\,\\,(∗)\n$$\n\nThe idea is to rewrite the left-hand side of $(∗)$ *using the inductive hypothesis* and apply algebraic techniques to show that this is less than the right-hand side. We do this as follows:\n\nWe write\n\n$$\n\\begin{aligned}6k+2 & =6(k+1)+6.\\end{aligned}\n$$\n\nBy the inductive hypothesis, we have\n\n$$\n\\begin{aligned}{{6(k+1)}_{⏟}}_{<{k}^{3}}+6 & <{k}^{3}+6 \\\\  & ={k}^{3}+{{5}_{⏟}}_{<3{k}^{2}+3k}+1 \\\\  & <{k}^{3}+3{k}^{2}+3k+1 \\\\  & =(k+1)^{3},\\end{aligned}\n$$\n\nas required.\n\nSince we've shown that the left-hand side of $(∗)$ is less than the right-hand side, our proof is complete. So, let's write down our conclusion. \n\nTherefore, by the principle of induction, $6(n+1)<{n}^{3}$ for all $n\\ge 3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-eb18aca5-2599-5953-850a-6c238aa579a5" "answer-field-4e31450a-29a9-556d-8c72-4515245acf6a" "answer-field-c0adae27-4bc6-5d43-887d-ab7ae94287b2" "answer-field-99cf002a-aec9-54ec-a7a9-5a7fa1adc046" "answer-field-1cfb3ca7-1d7a-5f1b-9977-0950695555b6" "answer-field-1070182f-615e-5c0b-958a-984b7b567d74" "answer-field-5b09d17d-fab4-5942-aa1d-f25b623d50be" "answer-field-f8f64acc-2d69-52fd-8d6b-98d6c837fb6b" "answer-field-3b06450e-1106-561c-9b62-a91a003e80ff"] :db/ensure [:question/validate]} {:db/id 17592186089974 :answer-field/correct 17592186089976 :db/ensure [:answer-field/validate]} {:db/id 17592186089970 :answer-field/correct "answer-0de84a96-bbe2-5f23-a28d-110ed31a2f8e" :answer-field/choices ["answer-0de84a96-bbe2-5f23-a28d-110ed31a2f8e" "answer-cb3cb1aa-3859-506e-8f7b-8fd2ebb70a48"] :db/ensure [:answer-field/validate]} {:db/id "answer-0de84a96-bbe2-5f23-a28d-110ed31a2f8e" :answer/id #uuid "0de84a96-bbe2-5f23-a28d-110ed31a2f8e" :answer/type :answer.type/math :answer/value "6(3+1)" :db/ensure [:answer/validate]} {:db/id "answer-cb3cb1aa-3859-506e-8f7b-8fd2ebb70a48" :answer/id #uuid "cb3cb1aa-3859-506e-8f7b-8fd2ebb70a48" :answer/type :answer.type/math :answer/value "{6}^{2}" :db/ensure [:answer/validate]} {:db/id 17592186089978 :answer-field/correct 17592186089980 :db/ensure [:answer-field/validate]} {:db/id 17592186089982 :answer-field/correct 17592186089983 :db/ensure [:answer-field/validate]} {:db/id 17592186089967 :answer-field/correct 17592186089969 :db/ensure [:answer-field/validate]} {:db/id "answer-field-eb18aca5-2599-5953-850a-6c238aa579a5" :answer-field/id #uuid "eb18aca5-2599-5953-850a-6c238aa579a5" :answer-field/key "field-6" :answer-field/type :answer-field.type/select :answer-field/