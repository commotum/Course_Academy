  "html": "<div id=\"step-e4461\" class=\"step\" style=\"display: block;\">\n    \n                 \n                <div class=\"example\">\n                    <div class=\"stepHeader\">\n                        <div class=\"stepName\"><span class=\"stepType\">Example:</span> Computing a Constant of Proportionality or Unit Rate</div>       \n                        <div class=\"helpButton\" stepid=\"e4461\">?</div>\n                    </div>\n            \n                    <div class=\"exampleQuestion\">\n                        <p>The graph below shows a proportional relationship. What is the constant of proportionality?</p>\n<div id=\"graphic-da44fcc445ef360b7d827dc6ce54487c\" class=\"graphic\"><img src=\"/graphics/da44fcc445ef360b7d827dc6ce54487c\"></div>\n\n                    </div>     \n            \n                    <div class=\"exampleExplanationHeader\">EXPLANATION</div>\n            \n                    <div class=\"exampleExplanation\">\n                        <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                