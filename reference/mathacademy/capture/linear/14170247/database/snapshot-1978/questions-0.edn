#{[{:db/id #edb/ref 17592186100593 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186101007 :knowledge-point/id #uuid "0e3833c1-4ec5-5681-ae69-6a9cceece871" :knowledge-point/title "Identifying the Slope and Y-Intercept From the Equation of a Line"}] :question/id #uuid "95fc8e7d-776c-5d09-9140-a83dc575ac79" :question/math-academy-id "e-12851" :question/problem "What are the slope and $y$-intercept of the line $y=2x-9?$" :question/worked-solution "The equation is in slope-intercept form $y={\\color{red}{m}}x+{\\color{blue}{b}},$ where $\\color{red}{m}$ is the slope and $\\color{blue}{b}$ is the $y$-intercept.\n\nFor the equation $y=2x-9,$ we see that the slope is ${\\color{red}{m=2}}$ and the $y$-intercept is ${\\color{blue}{b=-9}}.$"}] [{:db/id #edb/ref 17592186100594 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186101008 :knowledge-point/id #uuid "d8e10b2d-cad1-5d50-b9fc-917c3367f814" :knowledge-point/title "Finding the Equation of a Graphed Line (Positive Slope)"}] :question/id #uuid "36e13cef-f61a-53e2-8f0e-9ff567dc6fb6" :question/math-academy-id "e-12852" :question/problem "![](images/46/46a04d55edd836050d30a0d4d52c4c441619babd79f93f3540f61a5f437a1ea7.png)\n\nThe line shown above passes through the points $(0,-2)$ and $(2,2).$" :question/worked-solution "We will write the equation of the line in the slope-intercept form $y=mx+b.$ So, we need to work out the slope $m$ and the $y$-intercept $b.$\n\nFrom the graph, we see that the line intercepts the $y$-axis at $(0,-2).$ So, the $y$-intercept is $b = -2.$\n\nWe can calculate the slope of the line by choosing two points on the line and applying the slope formula. The line passes through the points $(0,-2)$ and $(2,2),$ so we calculate its slope as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{2-(-2)}{2-0} \\\\  & =\\frac{4}{2} \\\\  & =2\\end{aligned}\n$$\n\nSubstituting the slope $m = 2$ and the $y$-intercept $b = -2$ into the slope-intercept form $y = mx + b,$ we obtain the equation of the line:\n\n$$\ny = 2x - 2.\n$$"}] [{:db/id #edb/ref 17592186100595 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186101010 :knowledge-point/id #uuid "4762cb71-f6b6-5d32-8d0b-a457db66ff97" :knowledge-point/title "Finding the Equation of a Line That Passes Through Two Points: Y-Intercept Given"}] :question/id #uuid "8351e1cb-c602-5968-be5a-9c337ad977de" :question/math-academy-id "e-12853" :question/problem "Calculate the equation of the straight line that passes through the points $(0,8)$ and $(3,2).$" :question/worked-solution "We will write the equation of the line in the slope-intercept form $y=mx+b.$ So, we need to work out the slope $m$ and the $y$-intercept $b.$\n\nFirst, we calculate the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{2-8}{3-0} \\\\  & =\\frac{-6}{3} \\\\  & =-2\\end{aligned}\n$$\n\nThe coordinates of the $y$-intercept are always $(0,{\\color{blue}{b}}).$ We know that the line passes through the point $(0,{\\color{blue}{8}}),$ so the $y$-intercept is $b={\\color{blue}{8}}.$ \n\nSubstituting the slope $m=-2$ and the $y$-intercept $b=8$ into the slope-intercept formula $y=mx+b,$ we reach\n\n$$\ny=-2x+8.\n$$"}] [{:db/id #edb/ref 17592186100617 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186101009 :knowledge-point/id #uuid "8ac060cb-0c76-5050-9156-e5f17ad26fbb" :knowledge-point/title "Finding the Equation of a Graphed Line (Negative Slope)"}] :question/id #uuid "206b8f86-4184-50fa-9999-08700d10dc4f" :question/math-academy-id "e-20867" :question/problem "Find the equation of the line shown below.\n\n![](images/42/4298ec9c12555fd5e87265617ee274ef0fa859decd3ccd9473dfe8f778492df0.png)" :question/worked-solution "We will write the equation of the line in the slope-intercept form $y=mx+b.$ So, we need to work out the slope $m$ and the $y$-intercept $b.$\n\nFrom the graph, we see that the line intercepts the $y$-axis at $(0,2).$ So, the $y$-intercept is $b=2.$\n\nWe can calculate the slope of the line by choosing two points on the line and applying the slope formula. The line passes through the points $(0,2)$ and $(6,0),$ so we calculate its slope as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{0-2}{6-0} \\\\  & =\\frac{-2}{6} \\\\  & =-\\frac{1}{3}\\end{aligned}\n$$\n\nSubstituting the slope $m=-\\dfrac{1}{3}$ and the $y$-intercept $b=2$ into the slope-intercept form $y=mx+b,$ we obtain the equation of the line:\n\n$$\ny=-\\dfrac{1}{3}x+2\n$$"}] [{:db/id #edb/ref 17592186101522 :knowledge-point/_questions [{:db/id #edb/ref 17592186101010 :knowledge-point/id #uuid "4762cb71-f6b6-5d32-8d0b-a457db66ff97" :knowledge-point/title "Finding the Equation of a Line That Passes Through Two Points: Y-Intercept Given"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dcbacd08-2696-5b2e-a705-ec30b5fed93d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = 3x + 10" :db/id #edb/ref 17592186100294} {:answer/id #uuid "e06e3d82-67da-5dfc-b49c-b35f1b076b23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = 2x + 10" :db/id #edb/ref 17592186100295} {:answer/id #uuid "1dbca0d5-b800-54f5-9143-b96830c7f4cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = 4x + 10" :db/id #edb/ref 17592186100296} {:answer/id #uuid "25eaa6c3-8938-564d-9551-bad3bc3feca8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = 4x + 26" :db/id #edb/ref 17592186100297} {:answer/id #uuid "65371a77-67fa-54f0-8953-e5c8a7ffac47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = 3x + 26" :db/id #edb/ref 17592186100298}] :answer-field/id #uuid "f85d5513-b0e5-547b-9aab-8a3c4a7560ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186100293}] :question/id #uuid "51cb6080-077c-56de-a53e-403e56ffa583" :question/math-academy-id "q-6900" :question/problem "Find the equation of the line that passes through the points $(0, 10)$ and $(4, 26)$."}]}
