#{[17592186045463 #edb/ref 10 :activity.type/lesson #edb/ref 17592186045416] [17592186045464 #edb/ref 10 :activity.type/review #edb/ref 17592186045416] [17592186045487 #edb/ref 10 :question.difficulty/moderate #edb/ref 17592186045416] [17592186045493 #edb/ref 10 :answer-field.type/radio #edb/ref 17592186045416] [17592186045499 #edb/ref 10 :answer.type/math #edb/ref 17592186045416] [17592186046679 #edb/ref 1003 #edb/ref 17592186046652 #edb/ref 17592186045585] [17592186046679 #edb/ref 1004 #edb/ref 17592186046590 #edb/ref 17592186045585] [17592186046679 #edb/ref 1004 #edb/ref 17592186046591 #edb/ref 17592186045585] [17592186046679 #edb/ref 1004 #edb/ref 17592186046592 #edb/ref 17592186045585] [17592186046679 #edb/ref 1004 #edb/ref 17592186046593 #edb/ref 17592186045585] [17592186046679 #edb/ref 1004 #edb/ref 17592186046594 #edb/ref 17592186045585] [17592186046679 #edb/ref 1004 #edb/ref 17592186046595 #edb/ref 17592186045585] [17592186046679 #edb/ref 1004 #edb/ref 17592186046596 #edb/ref 17592186045585] [17592186046679 #edb/ref 1004 #edb/ref 17592186046597 #edb/ref 17592186045585] [17592186046679 #edb/ref 1004 #edb/ref 17592186046598 #edb/ref 17592186045585] [17592186046679 #edb/ref 1004 #edb/ref 17592186046599 #edb/ref 17592186045585] [17592186046679 #edb/ref 1004 #edb/ref 17592186046600 #edb/ref 17592186045585] [17592186046679 #edb/ref 1004 #edb/ref 17592186046601 #edb/ref 17592186045585] [17592186046679 #edb/ref 1004 #edb/ref 17592186046602 #edb/ref 17592186045585] [17592186046679 #edb/ref 1004 #edb/ref 17592186046603 #edb/ref 17592186045585] [17592186046679 #edb/ref 1004 #edb/ref 17592186046604 #edb/ref 17592186045585] [17592186046679 #edb/ref 1004 #edb/ref 17592186046605 #edb/ref 17592186045585] [17592186046679 #edb/ref 1004 #edb/ref 17592186046606 #edb/ref 17592186045585] [17592186046679 #edb/ref 1004 #edb/ref 17592186046607 #edb/ref 17592186045585] [17592186046679 #edb/ref 1004 #edb/ref 17592186046608 #edb/ref 17592186045585] [17592186046679 #edb/ref 1004 #edb/r