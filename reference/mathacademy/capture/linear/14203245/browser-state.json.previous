lass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><msup><mn>38</mn><mo>∘</mo></msup><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>18</mn><mo stretchy=\"false\">(</mo><mn>0.788</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mn>01</mn><mo>…</mo><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>14.184</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mn>19</mn><mo>…</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>≈</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>14</mn></mpadded></mstyle><mo>,</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container>\nrounded to the nearest integer.</p>\n</div></div>",
