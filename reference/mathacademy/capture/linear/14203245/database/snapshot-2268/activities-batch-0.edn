#{[{:activity/first-step {:db/id #edb/ref 17592186079491} :activity/id #uuid "ffb9cf3f-a2e6-5e5c-9682-1c0e291f5434" :activity/scope {:db/id #edb/ref 17592186048410 :topic/id #uuid "9ca16548-fcfe-5fe8-900f-8d09baee1021" :topic/math-academy-id 629} :activity/steps [{:db/id #edb/ref 17592186079491 :step/content {:db/id #edb/ref 17592186079639 :tutorial/content "Trigonometric ratios can be used to solve for a missing side of a right triangle if one side is known along with the measure of an acute angle. However, the question of which ratio to use depends on what side is given and what side is unknown.\n\n![](images/8b/8b123fed4a9a42ceb69f3a6ff68ed89f27ae42294137f0cd12a9232d329d77b0.png)\n\nIn the triangle above, we are given an angle\n\n$$\n\\theta = 42^\\circ\n$$\n\nand the length of the hypotenuse is given but the length of the side opposite is unknown.\n\nSo, we need to choose the trigonometric ratio that relates the opposite side to the hypotenuse. This is sine, and now we can just set up the ratio, as follows:\n\n$$\n\\begin{aligned}\n\\sin 42^{∘} &= \\frac{opposite}{hypotenuse} \\\\\n&= \\frac{x}{8}\n\\end{aligned}\n$$\n\nNow, we simply solve for the unknown value $x$, as follows:\n\n$$\n\\begin{aligned}\n\\sin 42^{∘} &= \\frac{x}{8} \\\\\nx &= 8\\sin 42^{∘} \\\\\n&= 8(0.66913...) \\\\\n&= 5.35304... \\\\\n&\\approx 5.4\n\\end{aligned}\n$$\n\nrounded to the nearest tenth.\n\nNote that we used a calculator to evaluate $\\sin(42^\\circ)$." :tutorial/id #uuid "e320c0f6-5f85-56c6-a082-c880c7e97433" :tutorial/math-academy-id 2449 :tutorial/title "Introduction"} :step/id #uuid "d9cbed7d-509a-59f0-97ea-b1d35e68ec34" :step/math-academy-id 456177 :step/next {:db/id #edb/ref 17592186079492}} {:db/id #edb/ref 17592186079492 :step/content {:db/id #edb/ref 17592186078551 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078257 :question/id #uuid "b4f8dd38-d62d-5940-b936-48f68e0693b8" :question/math-academy-id "e-3249"} :knowledge-point/id #uuid "04354ab1-c6ec-534e-bb57-267f326c15fc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048438} {:db/id #edb/ref 17592186049915}] :knowledge-point/questions [{:db/id #edb/ref 17592186078816} {:db/id #edb/ref 17592186078829} {:db/id #edb/ref 17592186079115}] :knowledge-point/title "Calculating an Unknown Side Length Using Sine"} :step/id #uuid "98edd011-945b-5796-8b62-c13b85ef2542" :step/math-academy-id 456178 :step/next {:db/id #edb/ref 17592186079493}} {:db/id #edb/ref 17592186079493 :step/content {:db/id #edb/ref 17592186078552 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078256 :question/id #uuid "17e8ec56-6fda-5294-b27c-9b3e312a5f75" :question/math-academy-id "e-3248"} :knowledge-point/id #uuid "9afe0d46-84e7-5937-9b42-170097a72493" :knowledge-point/questions [{:db/id #edb/ref 17592186078727} {:db/id #edb/ref 17592186078830} {:db/id #edb/ref 17592186079116}] :knowledge-point/title "Calculating an Unknown Side Length Using Cosine"} :step/id #uuid "58045faf-9a82-5f92-abc0-84d7e97bab68" :step/math-academy-id 456182 :step/next {:db/id #edb/ref 17592186079494}} {:db/id #edb/ref 17592186079494 :step/content {:db/id #edb/ref 17592186078553 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078258 :question/id #uuid "a74a938e-94a4-5a91-aced-4955dc8dfbf8" :question/math-academy-id "e-3250"} :knowledge-point/id #uuid "54289a8c-57cd-50b6-8b94-8628b2bc27be" :knowledge-point/questions [{:db/id #edb/ref 17592186078725} {:db/id #edb/ref 17592186078954} {:db/id #edb/ref 17592186079112}] :knowledge-point/title "Calculating an Unknown Side Length Using Tangent"} :step/id #uuid "537be7b4-9e58-5792-804e-96fda2b10d68" :step/math-academy-id 456186}] :activity/title "Calculating Side Lengths of Right Triangles Using Trigonometry" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078654}]}
