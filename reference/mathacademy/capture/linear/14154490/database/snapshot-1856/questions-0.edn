#{[{:db/id #edb/ref 17592186105599 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105742 :knowledge-point/id #uuid "bbc7c6e8-63c7-5ac4-9b65-f12c006b3fde" :knowledge-point/title "Applying the Power of Quotient Rule"}] :question/id #uuid "3ef53b20-3e82-5cd0-a1df-bd679ea8c650" :question/math-academy-id "e-4671" :question/problem "Express $\\left(\\dfrac{3}{4}\\right)^2$ as the quotient of two powers." :question/worked-solution "To raise the fraction to the power of $2$, we must raise both the numerator and the denominator to the power of $2$:\n\n$$\n\\left(\\dfrac{3}{4}\\right)^2=\\dfrac{3^2}{4^2}\n$$"}] [{:db/id #edb/ref 17592186105600 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105743 :knowledge-point/id #uuid "d87a38cc-5ca0-534e-8fa1-0a6e68d65706" :knowledge-point/title "Evaluating Powers of Fractions Using Power of Quotient Rule"}] :question/id #uuid "0debd4b6-66bd-5c00-8f0c-db39f5d848bc" :question/math-academy-id "e-4672" :question/problem "Evaluate $\\left(\\dfrac{4}{5}\\right)^3$." :question/worked-solution "To raise the fraction to the power of $3$, we must raise both the numerator and the denominator to the power of $3$:\n\n$$\n\\left(\\dfrac{4}{5}\\right)^3=\\dfrac{4^3}{5^3}\n$$\n\nNow, computing $4^3=64$ and $5^3=125$, we get\n\n$$\n\\dfrac{4^3}{5^3}= \\dfrac{64}{125}\n$$"}] [{:db/id #edb/ref 17592186105601 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105744 :knowledge-point/id #uuid "46cd136a-cc20-51e1-ac90-f8d9b787c5b3" :knowledge-point/title "Evaluating Powers of Negative Fractions Using the Power of Quotient Rule"}] :question/id #uuid "80cde83c-b7fb-5ad7-bc3e-528e47151da4" :question/math-academy-id "e-4673" :question/problem "Evaluate $\\left(-\\dfrac{3}{2}\\right)^3$." :question/worked-solution "First, notice that\n\n$$\n-\\dfrac{3}{2}=\\dfrac{(-3)}{2}\n$$\n\nTo raise the fraction to the power of $3$, we must raise both the numerator and the denominator to the power of $3$:\n\n$$\n\\left(-\\dfrac{3}{2}\\right)^3=\\left(\\dfrac{(-3)}{2}\\right)^3=\\dfrac{(-3)^3}{2^3}\n$$\n\nNow, computing $(-3)^3=-27$ and $2^3=8$, we get\n\n$$\n\\dfrac{(-3)^3}{2^3}= \\dfrac{-27}{8}=-\\dfrac{27}{8}\n$$"}] [{:db/id #edb/ref 17592186106469 :knowledge-point/_questions [{:db/id #edb/ref 17592186105742 :knowledge-point/id #uuid "bbc7c6e8-63c7-5ac4-9b65-f12c006b3fde" :knowledge-point/title "Applying the Power of Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b358e447-f1de-5dec-828f-1655ba8181dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 \\div (11 \\cdot 3)" :db/id #edb/ref 17592186104963} {:answer/id #uuid "d299947e-3567-54b1-a03a-3c24f5b92fbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4^{3} \\div 11" :db/id #edb/ref 17592186104964} {:answer/id #uuid "f2351657-92f5-5246-8ba3-edb15734d2ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 \\div (11 + 3)" :db/id #edb/ref 17592186104965} {:answer/id #uuid "18d1c353-4eb5-54c8-b659-08b5f9054710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4^{3} \\div 11^{3}" :db/id #edb/ref 17592186104966} {:answer/id #uuid "53fb43f0-05c0-595d-92b8-4e2380d39a38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 \\div 11^{3}" :db/id #edb/ref 17592186104967}] :answer-field/id #uuid "8d2c2aa3-8702-5076-b4af-0d144f8f130b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186104962}] :question/id #uuid "e832f2f3-7f90-5d28-a9f6-d7271980437d" :question/math-academy-id "q-68453" :question/problem "What is $(4 \\div 11)^{3}$?"}] [{:db/id #edb/ref 17592186106472 :knowledge-point/_questions [{:db/id #edb/ref 17592186105743 :knowledge-point/id #uuid "d87a38cc-5ca0-534e-8fa1-0a6e68d65706" :knowledge-point/title "Evaluating Powers o