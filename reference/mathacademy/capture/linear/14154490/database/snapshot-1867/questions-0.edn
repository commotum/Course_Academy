/ident :answer.type/math} :answer/value "\\frac{16}{9}" :db/id #edb/ref 17592186104981} :answer-field/id #uuid "680fd35a-01fa-5436-bfb0-fd59f22ed734" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186104980}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "19d50236-91d2-5a2a-a9cb-16ff563fb6a3" :question/math-academy-id "q-68464" :question/problem "$6{(\\frac{2}{3})}^{3}=$" :question/worked-solution "To raise the fraction to the power of $3$, we must raise both the numerator and the denominator to the power of $3.$ So we have\n\n$$\n{(\\frac{2}{3})}^{3}=\\frac{{2}^{3}}{{3}^{3}}=\\frac{8}{27}.\n$$\n\nTherefore,\n\n$$\n6{(\\frac{2}{3})}^{3}=6\\cdot \\frac{8}{27}=\\frac{48}{27}.\n$$\n\nFinally, we simplify:\n\n$$\n\\frac{48}{27}=\\frac{16\\cdot 3}{9\\cdot 3}=\\frac{16}{9}\n$$"}] [{:db/id #edb/ref 17592186478377 :knowledge-point/_questions [{:db/id #edb/ref 17592186105742 :knowledge-point/id #uuid "bbc7c6e8-63c7-5ac4-9b65-f12c006b3fde" :knowledge-point/title "Applying the Power of Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c15f13d-1a16-5c95-9e63-a025d06941c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{5}^{9}}{8}" :db/id #edb/ref 17592186477847} {:answer/id #uuid "4099f3b8-7f0d-5b35-8997-4f0b3a4acde2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{5}^{9}}{{8}^{9}}" :db/id #edb/ref 17592186477855} {:answer/id #uuid "4cc6185f-d7aa-5405-83c3-7fac9a8908b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{{8}^{9}}" :db/id #edb/ref 17592186477894} {:answer/id #uuid "7f298647-e439-546f-864b-f193ab4ab820" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{45}{17}" :db/id #edb/ref 17592186