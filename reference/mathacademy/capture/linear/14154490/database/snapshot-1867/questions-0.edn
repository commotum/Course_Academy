#{[{:db/id #edb/ref 17592186105599 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105742 :knowledge-point/id #uuid "bbc7c6e8-63c7-5ac4-9b65-f12c006b3fde" :knowledge-point/title "Applying the Power of Quotient Rule"}] :question/id #uuid "3ef53b20-3e82-5cd0-a1df-bd679ea8c650" :question/math-academy-id "e-4671" :question/problem "Express $\\left(\\dfrac{3}{4}\\right)^2$ as the quotient of two powers." :question/worked-solution "To raise the fraction to the power of $2,$ we must raise both the numerator and the denominator to the power of $2\\mathbin{:}$\n\n$$\n\\left(\\dfrac{3}{4}\\right)^2=\\dfrac{3^2}{4^2}\n$$"}] [{:db/id #edb/ref 17592186105600 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105743 :knowledge-point/id #uuid "d87a38cc-5ca0-534e-8fa1-0a6e68d65706" :knowledge-point/title "Evaluating Powers of Fractions Using Power of Quotient Rule"}] :question/id #uuid "0debd4b6-66bd-5c00-8f0c-db39f5d848bc" :question/math-academy-id "e-4672" :question/problem "Evaluate $\\left(\\dfrac{4}{5}\\right)^3.$" :question/worked-solution "To raise the fraction to the power of $3,$ we must raise both the numerator and the denominator to the power of $3\\mathbin{:}$\n\n$$\n\\left(\\dfrac{4}{5}\\right)^3=\\dfrac{4^3}{5^3}\n$$\n\nNow, computing $4^3=64$ and $5^3=125,$ we get\n\n$$\n\\dfrac{4^3}{5^3}= \\dfrac{64}{125} .\n$$"}] [{:db/id #edb/ref 17592186105601 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105744 :knowledge-point/id #uuid "46cd136a-cc20-51e1-ac90-f8d9b787c5b3" :knowledge-point/title "Evaluating Powers of Negative Fractions Using the Power of Quotient Rule"}] :question/id #uuid "80cde83c-b7fb-5ad7-bc3e-528e47151da4" :question/math-academy-id "e-4673" :question/problem "Evaluate $\\left(-\\dfrac{3}{2}\\right)^3.$" :question/worked-solution "First, notice that $-\\dfrac{3}{2}=\\dfrac{(-3)}{2}.$\n\nTo raise the fraction to the power of $3$, we must raise both the numerator and the denominator to the power of $3\\mathbin{:}$\n\n$$\n\\left(-\\dfrac{3}{2}\\right)^3=\\left(\\dfrac{(-3)}{2}\\right)^3=\\dfrac{(-3)^3}{2^3}\n$$\n\nNow, computing $(-3)^3=-27$ and $2^3=8,$ we get\n\n$$\n\\dfrac{(-3)^3}{2^3}= \\dfrac{-27}{8}=-\\dfrac{27}{8} .\n$$"}] [{:db/id #edb/ref 17592186478425 :knowledge-point/_questions [{:db/id #edb/ref 17592186105744 :knowledge-point/id #uuid "46cd136a-cc20-51e1-ac90-f8d9b787c5b3" :knowledge-point/title "Evaluating Powers of Negative Fractions Using the Power of Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0121dc9f-f4ba-543e-9e16-3d9b6fe1f2a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{81}" :db/id #edb/ref 17592186477736} {:answer/id #uuid "10ba064e-c1cf-57d4-b274-3fafc2166501" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{49}" :db/id #edb/ref 17592186477762} {:answer/id #uuid "34a89f7c-c815-5245-9061-5e0aead4e0ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{49}" :db/id #edb/ref 17592186477837} {:answer/id #uuid "787f0bb1-f1c5-5506-860f-10619b165b4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{27}" :db/id #edb/ref 17592186477986} {:answer/id #uuid "9b443017-e9bc-5d69-9dc5-6ad57c4e19e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{81}" :db/id #edb/ref 17592186478035}] :answer-field/correct {:answer/id #uuid "9b443017-e9bc-5d69-9dc5-6ad57c4e19e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{81}" :db/id #edb/ref 17592186478035} :answer-field/id #uuid "0628df36-e9ef-5bb2-8a41-30942c618c0f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478246}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8b7a90d0-eb05-5b06-9c08-22e60340af71" :question/math-academy-id "q-100747" :question/problem "${(-\\frac{1}{9})}^{2}=$" :question/worked-solution "First, notice that $-\\frac{1}{9}=\\frac{(-1)}{9}.$\n\nTo raise the fraction to the power of $2$, we must raise both the numerator and the denominator to the power of $2:$\n\n$$\n{(-\\frac{1}{9})}^{2}={(\\frac{(-1)}{9})}^{2}=\\frac{(-1)^{2}}{{9}^{2}}\n$$\n\nNow, using $(-1)^{2}=1$ and ${9}^{2}=81,$ we get\n\n$$\n\\frac{(-1)^{2}}{{9}^{2}}=\\frac{1}{81}.\n$$"}] [{:db/id #edb/ref 17592186106469 :knowledge-point/_questions [{:db/id #edb/ref 17592186105742 :knowledge-point/id #uuid "bbc7c6e8-63c7-5ac4-9b65-f12c006b3fde" :knowledge-point/title "Applying the Power of Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3018a01c-04a0-599b-baac-30334da8d41b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4÷(11+3)" :db/id #edb/ref 17592186477823} {:answer/id #uuid "3e01d295-32fb-593d-9a0e-39b76a6587cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4÷(11\\times 3)" :db/id #edb/ref 17592186477850} {:answer/id #uuid "50ac579b-582f-56a6-a415-8615dd66509f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4÷{11}^{3}" :db/id #edb/ref 17592186477900} {:answer/id #uuid "a11ece18-45a4-5caf-9be8-1eaf66eb3d67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{4}^{3}÷{11}^{3}" :db/id #edb/ref 17592186478045} {:answer/id #uuid "b17deb2f-1c68-5ccd-962c-d33e49c2a24a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{4}^{3}÷11" :db/id #edb/ref 17592186478082}] :answer-field/correct {:answer/id #uuid "a11ece18-45a4-5caf-9be8-1eaf66eb3d67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{4}^{3}÷{11}^{3}" :db/id #edb/ref 17592186478045} :answer-