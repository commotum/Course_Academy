db/ref 17592186050076 #edb/ref 17592186045417] [17592186051029 #edb/ref 1027 #edb/ref 17592186050108 #edb/ref 17592186045417] [17592186051029 #edb/ref 1027 #edb/ref 17592186050232 #edb/ref 17592186045417] [17592186051029 #edb/ref 1027 #edb/ref 17592186050291 #edb/ref 17592186045417] [17592186051029 #edb/ref 1027 #edb/ref 17592186050507 #edb/ref 17592186045417] [17592186051029 #edb/ref 1027 #edb/ref 17592186050577 #edb/ref 17592186045417] [17592186051029 #edb/ref 1027 #edb/ref 17592186050977 #edb/ref 17592186045417] [17592186051029 #edb/ref 1028 #edb/ref 17592186064360 #edb/ref 17592186045417] [17592186051029 #edb/ref 1028 #edb/ref 17592186064361 #edb/ref 17592186045417] [17592186051029 #edb/ref 1028 #edb/ref 17592186064362 #edb/ref 17592186045417] [17592186051029 #edb/ref 1031 "Fractions of Fractions" #edb/ref 17592186045417] [17592186051029 #edb/ref 1033 323 #edb/ref 17592186045417] [17592186051029 #edb/ref 1035 #uuid "7b7f598a-21a7-593a-99a2-ef8e0258c820" #edb/ref 17592186045417] [17592186107635 #edb/ref 1075 #edb/ref 17592186540674 #edb/ref 17592186045417] [17592186107635 #edb/ref 1075 #edb/ref 17592186540690 #edb/ref 17592186045417] [17592186107635 #edb/ref 1075 #edb/ref 17592186540712 #edb/ref 17592186045417] [17592186107635 #edb/ref 1075 #edb/ref 17592186540713 #edb/ref 17592186045417] [17592186107635 #edb/ref 1075 #edb/ref 17592186540747 #edb/ref 17592186045417] [17592186107635 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186107635 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186107635 #edb/ref 1078 #edb/ref 17592186540747 #edb/ref 17592186045417] [17592186107635 #edb/ref 1079 #uuid "857a3db1-21fe-550d-bd38-13dc7189256d" #edb/ref 17592186045417] [17592186110456 #edb/ref 1069 "e-3480" #edb/ref 17592186045417] [17592186110456 #edb/ref 1071 "The point $A$ is located in the first quadrant and lies on the unit circle. The $y$-coordinate of $A$ is $\\dfrac{5}{9}.$ What is the $x$-coordinate of $A?$" #edb/ref 17592186045417] [17592186110456 #edb/ref 1072 #uuid "42313322-7535-5969-ad84-958449e48c1b" #edb/ref 17592186045417] [17592186110456 #edb/ref 1074 "Since the point $A$ lies on the unit circle, it must satisfy the Pythagorean theorem: \n\n$$\nx^2+y^2=1 .\n$$\n\nSubstituting $y=\\dfrac{5}{9}$ into the above and solving for $x$ gives\n\n$$\n\\eqalign{\n\t\tx^2+y^2&=1\\[5pt]\n\t        x^2+\\left(\\dfrac{5}{9}\\right)^2&=1\\[5pt]\n\t\tx^2+\\left(\\dfrac{25}{81}\\right)&=1\\[5pt]\n\t\tx^2&= 1-\\dfrac{25}{81}\\[5pt]\n\t\tx^2&= \\dfrac{56}{81}\\[5pt]\n\t\tx&= \\sqrt{\\dfrac{56}{81}}\\[5pt]\n\t        x&= \\pm \\dfrac{2\\sqrt{14}}{9}.\n}\n$$\n\nSince $A$ lies in the first quadrant, $x$ must be positive. So, we select the positive answer. \n\nTherefore, our final answer is $x=\\dfrac{2\\sqrt{14}}{9}.$" #edb/ref 17592186045417] [17592186110457 #edb/ref 1069 "e-3482" #edb/ref 17592186045417] [17592186110457 #edb/ref 1071 "![](images/aa/aad0b38f5afb88c13039ac577a927e232d84905de40297ed824c966795ce7bb4.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\dfrac{2}{3},$ use the Pythagorean identity to find $\\sin\\theta.$" #edb/ref 17592186045417] [17592186110457 #edb/ref 1072 #uuid "02c747c2-0eda-5c53-8e43-829f878dd278" #edb/ref 17592186045417] [17592186110457 #edb/ref 1074 "Any point $(x,y)$ on the unit circle is related to the central angle $\\theta$ as follows:\n\n$$\nx = \\cos\\theta, \\qquad y = \\sin\\theta.\n$$\n\nWe're given that $x=\\dfrac{2}{3}$ at the point $P.$ Therefore, we have\n\n$$\n\\cos\\theta = \\dfrac{2}{3}.\n$$\n\nWe can use the Pythagorean identity to find $\\sin\\theta\\mathbin{:}$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\cos\\theta = \\dfrac{2}{3}$ gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{2}{3})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{4}{9}} \\\\  & =\\pm \\sqrt{\\frac{5}{9}} \\\\  & =\\pm \\frac{\\sqrt{5}}{3}.\\end{aligned}\n$$\n\nFinally, we select the positive answer since $\\sin\\theta$ is positive in the first quadrant. \n\nSo our final answer is $\\sin\\theta = \\dfrac{\\sqrt 5}{3}.$" #edb/ref 17592186045417] [17592186110458 #edb/ref 1069 "e-3484" #edb/ref 17592186045417] [17592186110458 #edb/ref 1071 "![](images/e5/e50848432dd18a4a5dc64d4e5a5cfb8b3e14e9fed6231774dd83ead5552cd463.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\dfrac{2\\sqrt 6}{7},$ use the Pythagorean identity to find $\\csc\\theta.$" #edb/ref 17592186045417] [17592186110458 #edb/ref 1072 #uuid "bbf71023-510c-54af-9d0c-4df6744e3007" #edb/ref 17592186045417] [17592186110458 #edb/ref 1074 "Again, any point $(x,y)$ on the unit circle is related to the central angle $\\theta$ as follows:\n\n$$\nx = \\cos\\theta, \\qquad y = \\sin\\theta.\n$$\n\nWe're given that $x=\\dfrac{2\\sqrt 6}{7}$ at the point $P.$ Therefore, we have\n\n$$\n\\cos\\theta = \\dfrac{2\\sqrt 6}{7}.\n$$\n\nWe can use the Pythagorean identity to find $\\sin\\theta\\mathbin{:}$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\cos\\theta = \\dfrac{2\\sqrt 6}{7}$ gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{2\\sqrt{6}}{7})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{24}{49}} \\\\  & =\\pm \\sqrt{\\frac{25}{49}} \\\\  & =\\pm \\frac{5}{7}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\sin\\theta$ is positive in the first quadrant. So, $\\sin\\theta = \\dfrac{5}{7}.$\n\nFinally, knowing that $\\csc\\theta = \\dfrac{1}{\\sin\\theta},$ we have\n\n$$\n\\csc\\theta = \\dfrac{1}{\\left(\\dfrac{5}{7}\\right)} = \\dfrac{7}{5}.\n$$" #edb/ref 17592186045417] [17592186110459 #edb/ref 1069 "e-3485" #edb/ref 17592186045417] [17592186110459 #edb/ref 1071 "![](images/e6/e666ddc8a8eda452abd833e963446c96de5d34dfbf76e9c92564e85a48080524.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\dfrac{4}{5},$ what is $\\tan\\theta?$" #edb/ref 17592186045417] [17592186110459 #edb/ref 1072 #uuid "ba6cc6a0-dbb8-58d2-9d02-c76310028d4e" #edb/ref 17592186045417] [17592186110459 #edb/ref 1074 "We're given that $x=\\dfrac{4}{5}$ at the point $P.$ Therefore, we have\n\n$$\n\\cos\\theta = \\dfrac{4}{5}.\n$$\n\nWe can use the Pythagorean identity to find $\\sin\\theta\\mathbin{:}$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\cos\\theta = \\dfrac{4}{5}$ gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{4}{5})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{16}{25}} \\\\  & =\\pm \\sqrt{\\frac{9}{25}} \\\\  & =\\pm \\frac{3}{5}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\sin\\theta$ is positive in the first quadrant. Therefore $\\sin\\theta = \\dfrac{3}{5}.$\n\nUsing the fact that\n\n$$\n\\tan\\theta = \\dfrac{\\sin\\theta}{\\cos\\theta},\n$$\n\nwe finally get\n\n$$\n\\tan\\theta = \\dfrac{\\left(\\dfrac{3}{5}\\right)}{\\left(\\dfrac{4}{5}\\right)} = \\dfrac {3}{4}.\n$$" #edb/ref 17592186045417] [17592186110754 #edb/ref 1037 #edb/ref 17592186049224 #edb/ref 17592186045417] [17592186110754 #edb/ref 1038 #edb/ref 17592186110987 #edb/ref 17592186045417] [17592186110754 #edb/ref 1038 #edb/ref 17592186111340 #edb/ref 17592186045417] [17592186110754 #edb/ref 1038 #edb/ref 17592186259693 #edb/ref 17592186045417] [17592186110754 #edb/ref 1038 #edb/ref 17592186259694 #edb/ref 17592186045417] [17592186110754 #edb/ref 1038 #edb/ref 17592186259695 #edb/ref 17592186045417] [17592186110754 #edb/ref 1038 #edb/ref 17592186290449 #e