n$$"} :step/id #uuid "ad914d59-631f-5b15-8d69-7505a90e3736" :step/next {:db/id #edb/ref 17592186502179}}] :activity/title "Combining the Rules of Exponents" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186501456}]}
