ref 17592186110618 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110508 :question/id #uuid "43141ab7-5ebf-5175-a512-e04f6646978d" :question/math-academy-id "e-4752"} :knowledge-point/id #uuid "376ceac4-b0bb-5178-81e9-38e724cceaee" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049081} {:db/id #edb/ref 17592186050668}] :knowledge-point/questions [{:db/id #edb/ref 17592186111376} {:db/id #edb/ref 17592186111377} {:db/id #edb/ref 17592186486360} {:db/id #edb/ref 17592186486448}] :knowledge-point/title "Combining the Product and Quotient Rules of Exponents"} :step/id #uuid "99b9d947-8b7b-5e8a-a9e4-9d2b3a2979a2" :step/math-academy-id 17336 :step/next {:db/id #edb/ref 17592186111523}} {:db/id #edb/ref 17592186111531 :step/content {:db/id #edb/ref 17592186111884 :tutorial/content "Let's recap some of the rules for exponents.\n\n- **Product rule**: to multiply powers of the same base, add the exponents.\n\n- **Quotient rule**: to divide powers of the same base, subtract the exponents.\n\n- **Power rule**: to raise a power to another power, multiply the exponents.\n\n- **Power of product rule**: to raise the product of two numbers to a power, raise each number to that power, and then multiply.\n\n- **Power of quotient rule**: to raise a fraction to a power, raise both the numerator and the denominator to that power.\n\nWe can use a combination of these rules to simplify expressions containing exponents. Let's see an example of this." :tutorial/id #uuid "7c442391-b257-5c16-9fe0-292a45e3c172" :tutorial/math-academy-id 3275 :tutorial/title "Introduction"} :step/id #uuid "8150e1a1-0f41-5dc7-a1db-5e474331d638" :step/math-academy-id 17999 :step/next {:db/id #edb/ref 17592186111525}}] :activity/title "Combining the Rules of Exponents" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110829}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186502198} :activity/id #uuid "890e7c6c-adee-5d25-828e-7834d97d256f" :activity/scope {:db/id #edb/ref 17592186049059 :topic/id #uuid "d690f7fb-8ed3-54e1-86b0-fda3f8281846" :topic/math-academy-id 1457} :activity/steps [{:db/id #edb/ref 17592186502168 :step/content {:db/id #edb/ref 17592186111380 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41468d21-4c10-5a19-948e-44ada7c0a123" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{6}^{3}}{{4}^{6}}" :db/id #edb/ref 17592186501587} {:answer/id #uuid "7eba4019-7fbd-5be5-9b6f-4d896804f8bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6}^{3}\\cdot {4}^{6}" :db/id #edb/ref 17592186501704} {:answer/id #uuid "91298573-6a3f-5b5b-86e7-0b49355cfd98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{{4}^{12}}" :db/id #edb/ref 17592186501742} {:answer/id #uuid "9dbea38b-7606-5fb6-b9c6-c107413a84d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{{4}^{6}}" :db/id #edb/ref 17592186501762} {:answer/id #uuid "d404240e-f93e-5c72-adcb-8512850b4fd1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{6}^{3}}{{4}^{5}}" :db/id #edb/ref 17592186501886}] :answer-field/correct {:db/id #edb/ref 17592186501587} :answer-field/id #uuid "f75d50b2-6f5a-5bce-9e0b-522b9985c2e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186110005}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a4eaff0b-1470-58ee-9066-30ef9be58837" :question/math-academy-id "q-68964" :question/problem "${(\\frac{6}{{4}^{2}})}^{3}=$" :question/worked-solution "First, we apply the power of quotient rule for exponents:\n\n$$\n{(\\frac{6}{{4}^{2}})}^{3}=\\frac{{6}^{3}}{{({4}^{2})}^{3}}\n$$\n\nTo simplify the denominator, we use the power rule for exponents:\n\n$$\n\\begin{aligned}\\frac{{6}^{3}}{{({4}^{2})}^{3}} & =\\frac{{6}^{3}}{{4}^{2\\cdot 3}} \\\\  & =\\frac{{6}^{3}}{{4}^{6}}\\end{aligned}\n$$"} :step/id #uuid "102a9be1-877b-502d-8f9a-b0b5673f06b0" :step/next {:db/id #edb/ref 17592186502173}} {:db/id #edb/ref 17592186502173 :step/content {:db/id #edb/ref 17592186502124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3611b83a-05fd-57c0-964f-6cdb6a750d10" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6}^{8}\\cdot {8}^{8}" :db/id #edb/ref 17592186501565} {:answer/id #uuid "74a93e7b-8e23-5952-a163-17d5bb75323b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6}^{3}\\cdot {8}^{8}" :db/id #edb/ref 17592186501680} {:answer/id #uuid "a8011c4e-cb58-515e-9fe0-ab3c788f1478" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6}^{8}\\cdot {8}^{3}" :db/id #edb/ref 17592186501793} {:answer/id #uuid "cf81bb58-a87f-5a0e-91a5-9f5976da0085" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6}^{2}\\cdot {8}^{3}" :db/id #edb/ref 17592186501878} {:answer/id #uuid "d2f55899-6b14-567d-959e-9963101cb1f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6}^{3}\\cdot {8}^{3}" :db/id #edb/ref 17592186501885}] :answer-field/correct {:db/id #edb/ref 17592186501793} :answer-field/id #uuid "11312e6f-7278-523b-b492-30e222c5f5a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186501980}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8bec425d-e327-5350-ad55-2bf5d8347c9a" :question/math-academy-id "q-100757" :question/problem "${(6\\cdot 8)}^{3}\\cdot {6}^{5}=$" :question/worked-solution "First, we rewrite the second factor using the power of product rule:\n\n$$\n{(6\\cdot 8)}^{3}\\cdot {6}^{5}={6}^{3}\\cdot {8}^{3}\\cdot {6}^{5}\n$$\n\nFinally, we apply the product rule for exponents, and simplify:\n\n$$\n\\begin{aligned}{6}^{3}\\cdot {8}^{3}\\cdot {6}^{5} & ={6}^{3}\\cdot {6}^{5}\\cdot {8}^{3} \\\\  & ={6}^{3+5}\\cdot {8}^{3} \\\\  & ={6}^{8}\\cdot {8}^{3}\\end{aligned}\n$$"} :step/id #uuid "2d32c85e-20d0-5fd2-a609-287a06932ccb"} {:db/id #edb/ref 17592186502179 :step/content {:db/id #edb/ref 17592186502113 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d4c53a1-b239-5b29-8440-f632e3a00d66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{4}\\cdot {3}^{7}" :db/id #edb/ref 17592186501546} {:answer/id #uuid "6fa97fff-f307-512a-a0df-4801533ea472" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\cdot {3}^{2}" :db/id #edb/ref 17592186501671} {:answer/id #uuid "84236fbb-6291-5f93-81e2-cd38a8816289" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{7}\\cdot {3}^{4}" :db/id #edb/ref 17592186501719} {:answer/id #uuid "c6a0ea31-2173-5c5d-9e00-40527e7cf292" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{12}\\cdot {3}^{2}" :db/id #edb/ref 17592186501862} {:answer/id #uuid "fb321c56-57a3-55ec-b817-8c07ac7ecf7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{3}\\cdot {5}^{4}" :db/id #edb/ref 17592186501965}] :answer-field/correct {:db/id #edb/ref 17592186501719} :answer-field/id #uuid "88004d56-effe-5e83-a749-a2b7c08b3fa4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502022}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6ef8e162-2bcb-5b53-83cc-147de68407b1" :question/math-academy-id "q-68952" :question/problem "${2}^{3}\\cdot {(3\\cdot 2)}^{4}=$" :question/worked-solution "First, we rewrite the second factor using the power of product rule:\n\n$$\n{2}^{3}\\cdot {(3\\cdot 2)}^{4}={2}^{3}\\cdot {3}^{4}\\cdot {2}^{4}\n$$\n\nFinally, we apply the product rule for exponents, and simplify:\n\n$$\n\\begin{aligned}{2}^{3}\\cdot {3}^{4}\\cdot {2}^{4} & ={2}^{3}\\cdot {2}^{4}\\cdot {3}^{4} \\\\  & ={2}^{3+4}\\cdot {3}^{4} \\\\  & ={2}^{7}\\cdot {3}^{4}\\end{aligned}\n$$"} :step/id #uuid "49308f5f-8de3-5dbe-bf1a-8b336864e19e" :step/next {:db/id #edb/ref 17592186502168}} {:db/id #edb/ref 17592186502198 :step/content {:db/id #edb/ref 17592186502081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a73b112-23d9-5ce7-b7f6-9cc9b1ea6ba3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{7}\\cdot {3}^{-2}" :db/id #edb/ref 17592186501541} {:answer/id #uuid "5173cabb-209f-59b0-bb30-f3195ff21e04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{7}\\cdot {3}^{3}" :db/id #edb/ref 17592186501614} {:answer/id #uuid "6b8cacfb-384f-5813-911b-4115a5b7ba6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{7}\\cdot {3}^{2}" :db/id #edb/ref 17592186501667} {:answer/id #uuid "8d016a81-6b30-515f-b97d-3efba5f2f640" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{7}\\cdot 3" :db/id #edb/ref 17592186501737} {:answer/id #uuid "f91702ba-eae7-53c8-b6a7-9bd48502b51b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{7}" :db/id #edb/ref 17592186501961}] :answer-field/correct {:db/id #edb/ref 17592186501667} :answer-field/id #uuid "bf72de5c-8edd-59cf-9c2b-dc6c69c9659d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502043}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "22282018-2ca4-523a-8e4c-90a2c94b5770" :question/math-academy-id "q-68493" :question/problem "${(\\frac{2}{3})}^{7}\\cdot {3}^{9}=$" :question/worked-solution "First, we rewrite the first factor using the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{2}{3})}^{7}\\cdot {3}^{9}=\\frac{{2}^{7}}{{3}^{7}}\\cdot {3}^{9}\\end{aligned}\n$$\n\nNext, we rewrite the fractional part of our expression as follows:\n\n$$\n\\frac{{2}^{7}}{{3}^{7}}\\cdot {3}^{9}={2}^{7}\\cdot \\frac{{3}^{9}}{{3}^{7}}\n$$\n\nFinally, we simplify using the quotient rule for exponents:\n\n$$\n{2}^{7}\\cdot \\frac{{3}^{9}}{{3}^{7}}={2}^{7}\\cdot {3}^{9-7}={2}^{7}\\cdot {3}^{2}\n$$"} :step/id #uuid "ad914d59-631f-5b15-8d69-7505a90e3736" :step/next {:db/id #edb/ref 17592186502179}}] :activity/title "Combining the Rules of Exponents" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186501456}]}
