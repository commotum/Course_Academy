#{[{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186410146} :activity/id #uuid "894f8871-df27-5432-8273-79e87d1dc068" :activity/scope {:db/id #edb/ref 17592186049552 :topic/id #uuid "fec793da-c490-5883-8ef3-12fbd0ff56e1" :topic/math-academy-id 2791} :activity/steps [{:db/id #edb/ref 17592186410146 :step/content {:db/id #edb/ref 17592186410142 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29f9e9a8-acf7-56b9-9960-2cbe3a46c2a6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There exists $i\\in Z$ such that $5∣i.$" :db/id #edb/ref 17592186410114} {:answer/id #uuid "321e31d8-c886-5941-ae25-4240bbb508be" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There exists $i\\in Z$ such that $5∤i.$" :db/id #edb/ref 17592186410115} {:answer/id #uuid "59888688-cf22-51cc-9fbe-28615559de4f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None of the listed" :db/id #edb/ref 17592186410123} {:answer/id #uuid "846635d0-43bd-5c1e-aad9-f8614f81020b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For all $i\\in Z,$ $5∣i.$" :db/id #edb/ref 17592186410128} {:answer/id #uuid "9ecf36dc-e0ba-5908-96c8-ed866e4b2b75" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For all $i\\in Z,$ $5∤i.$" :db/id #edb/ref 17592186410131}] :answer-field/correct {:db/id #edb/ref 17592186410114} :answer-field/id #uuid "1a1d23f2-86cc-5a43-ad48-df426171ab05" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410136}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4e77b832-cd26-598b-a9cd-768bdf101358" :question/math-academy-id "q-183455" :question/problem "Negate the following statement:\n\n$\\,$ For all $i\\in Z,$ $5∤i.$\n\n*Hint: Recall that $a∣b$ means \"$a$ divides $b.$\"*" :question/worked-solution "If we denote\n\n$$\nP(i):5∣i,\n$$\n\nour statement can be written as\n\n$$\n∀i\\in Z,\\,¬P(i).\n$$\n\nNegating this, we obtain\n\n$$\n\\begin{aligned}¬(∀i\\in Z,\\,¬P(i)) & ≡∃i\\in Z,\\,¬¬P(i) \\\\  & ≡∃i\\in Z,\\,\\text{ }P(i).\\end{aligned}\n$$\n\nFinally, $∃i\\in Z,\\,P(i)$ reads as follows:\n\n$\\,$ **There exists** $i\\in Z$ such that $5∣i.$"} :step/id #uuid "572c75d6-a924-55fc-82ec-9c67ff02ed45" :step/next {:db/id #edb/ref 17592186410150}} {:db/id #edb/ref 17592186410147 :step/content {:db/id #edb/ref 17592186410143 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d27b4f1-4010-5f2d-a415-92176340a182" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There exists $k\\in Z$ such that $2k$ is not even." :db/id #edb/ref 17592186410118} {:answer/id #uuid "4c4dfbe5-97a5-50aa-a40f-1414bdfbd455" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For all $k\\in Z,$ $2k$ is not even." :db/id #edb/ref 17592186410122} {:answer/id #uuid "8d3dc0c0-bf2c-54cd-9809-125cf9be042b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None of the listed." :db/id #edb/ref 17592186410129} {:answer/id #uuid "d2a530e2-fae5-5975-af00-86861b170c9d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For all $k\\in Z,$ $2k$ is even." :db/id #edb/ref 17592186410134} {:answer/id #uuid "e8a52516-436b-5bd7-a39f-f1990b4cc0fd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There exists $k\\in Z$ such that $2k$ is even." :db/id #edb/ref 17592186410135}] :answer-field/correct {:db/id #edb/ref 17592186410134} :answer-field/id #uuid "a038f0d4-34cb-521f-89be-3859465a2114" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410138}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "798a00fa-243f-50df-8297-ecf784686589" :question/math-academy-id "q-216686" :question/problem "Negate the following statement:\n\n$\\,$ There exists $k\\in Z$ such that $2k$ is not even." :question/worked-solution "If we denote\n\n$$\nP(k):2k\\text{ is even},\n$$\n\nour statement can be written as\n\n$$\n∃k\\in Z,\\,¬P(k).\n$$\n\nNegating this, we obtain\n\n$$\n\\begin{aligned}¬(∃k\\in Z,\\,¬P(k)) & ≡∀k\\in Z,\\,¬¬P(k) \\\\  & ≡∀k\\in Z,\\,P(k).\\end{aligned}\n$$\n\nFinally, $∀k\\in Z,\\,P(k)$ reads as follows:\n\n$\\,$ **For all** $k\\in Z,$ $2k$ is even."} :step/id #uuid "8695aa81-39f5-5e81-8b64-009141aabaf1"} {:db/id #edb/ref 17592186410148 :step/content {:db/id #edb/ref 17592186410144 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17e49909-3507-5580-943d-286759dd3c72" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "All rational numbers are proper fractions." :db/id #edb/ref 17592186410111} {:answer/id #uuid "3f9e815f-a702-5472-ae0a-664589aeb164" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "All rational numbers are not proper fractions." :db/id #edb/ref 17592186410119} {:answer/id #uuid "401e5e96-f94c-5f3b-9c08-dfc54196c291" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Some rational numbers are not proper fractions." :db/id #edb/ref 17592186410120} {:answer/id #uuid "72b76584-0a79-5013-9010-9e565d577099" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Some rational numbers are proper fractions." :db/id #edb/ref 17592186410127} {:answer/id #uuid "9f968828-8126-5609-8734-f89404875683" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None of the listed" :db/id #edb/ref 17592186410132}] :answer-field/correct {:db/id #edb/ref 17592186410111} :answer-field/id #uuid "54cd8eb8-4350-5d38-9526-de55f16c63d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410137}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b61a6bc3-02ad-503d-9726-3870de55612a" :question/math-academy-id "q-183651" :question/problem "Negate the following statement: \n\n$\\,$ Some rational numbers are not proper fractions." :question/worked-solution "The given statement can be re-phrased as follows:\n\n$\\,$ There exists $x\\in Q$ such that $x$ is not a proper fraction.\n\nIntroducing the existential quantifier, we get the following:\n\n$\\,$ $∃x\\in Q,\\,x\\text{ is not a proper fraction}.$\n\nNegating this, we obtain\n\n$$\n\\begin{aligned}¬(∃x\\in Q,\\,x\\text{ is not a proper fraction}) & ≡∀x\\in Q,\\,¬(x\\text{ is not a proper fraction}) \\\\  & ≡∀x\\in Q,\\,x\\text{ is a proper fraction}\\end{aligned}\n$$\n\nwhich reads \n\n$\\,$ For all $x\\in Q,$ $x\\text{ is a proper fraction}.$\n\nor simply\n\n$\\,$ All rational numbers are proper fractions."} :step/id #uuid "e053a657-a0c4-5b0c-be02-023521cbea13" :step/next {:db/id #edb/ref 17592186410149}} {:db/id #edb/ref 17592186410149 :step/content {:db/id #edb/ref 17592186410145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25b9afc4-148f-5c71-8511-e46ca1e987c9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For all $m\\in N,$ $m$ is odd." :db/id #edb/ref 17592186410113} {:answer/id #uuid "3ce9128f-5377-56ee-920f-b7ab48ecc8f2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None of the listed." :db/id #edb/ref 17592186410117} {:answer/id #uuid "60188a81-7597-5502-b7d3-b21f7efe67e2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There exists $m\\in N$ such that $3m+1$ is odd." :db/id #edb/ref 17592186410124} {:answer/id #uuid "717466a3-482b-5b78-832a-f3993143c94b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There exists $m\\in N$ such that $3m+1$ is not odd." :db/id #edb/ref 17592186410126} {:answer/id #uuid "a9e42e20-34f7-5639-b41e-d4a2e24a21c6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For all $m\\in N,$ $m$ is not odd." :db/id #edb/ref 17592186410133}] :answer-field/correct {:db/id #edb/ref 17592186410124} :answer-field/id #uuid "f7c5ef5b-7a80-5ac2-99a7-b5d9b6b74e69" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410140}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c83b3bea-4b77-5cec-bbd2-330b49e09c81" :question/math-academy-id "q-216590" :question/problem "Negate the following statement:\n\n$\\,$ For all $m\\in N,$ $3m+1$ is not odd." :question/worked-solution "If we denote\n\n$$\nP(m):3m+1\\text{ is odd},\n$$\n\nour statement can be written as\n\n$$\n∀m\\in N,\\,¬P(m).\n$$\n\nNegating this, we obtain\n\n$$\n\\begin{aligned}¬(∀m\\in N,\\,¬P(m)) & ≡∃m\\in N,\\,¬¬P(m) \\\\  & ≡∃m\\in N,\\,P(m).\\end{aligned}\n$$\n\nFinally, $∃m\\in N,\\,P(m)$ reads as follows:\n\n$\\,$ **There exists** $m\\in N$ such that $3m+1$ is odd."} :step/id #uuid "e973016a-86f0-5ff0-b7fb-787bf770612e" :step/next {:db/id #edb/ref 17592186410147}} {:db/id #edb/ref 17592186410150 :step/content {:db/id #edb/ref 17592186410141 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "251a042a-d8c4-506c-af57-a854707853ba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "At least one prime number is even." :db/id #edb/ref 17592186410112} {:answer/id #uuid "3c45df10-d57c-50a6-a771-4be55ec10faa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Every prime number is even." :db/id #edb/ref 17592186410116} {:answer/id #uuid "418005b2-29df-534e-be9b-4ebcd2a4e0a0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None of the listed" :db/id #edb/ref 17592186410121} {:answer/id #uuid "66acba5e-e759-57f7-ba26-fcd18beb17b3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "At least one prime number is odd." :db/id #edb/ref 17592186410125} {:answer/id #uuid "927517ce-f64f-517e-8127-f452cd455459" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Every prime number is odd." :db/id #edb/ref 17592186410130}] :answer-field/correct {:db/id #edb/ref 17592186410130} :answer-field/id #uuid "c5ddecd2-3447-559e-ad3a-01957e0b66df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410139}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1b470ce3-7367-5e3f-ae84-b975432e9387" :question/math-academy-id "q-183471" :question/problem "Negate the following statement: \n\n$\\,$ At least one prime number is even." :question/worked-solution "Let $P$ be the set of all prime numbers. The given statement can be re-phrased as follows:\n\n$\\,$ There exists $p\\in P$ such that $p$ is even.\n\nIntroducing the existential quantifier, we get the following:\n\n$\\,$ $∃p\\in P,\\,p\\text{ is even}.$\n\nNegating this, we obtain\n\n$$\n\\begin{aligned}¬(∃p\\in P,\\,p\\text{ is even}) & ≡∀p\\in P,\\,¬(p\\text{ is even}) \\\\  & ≡∀p\\in P,\\,p\\text{ is odd}\\end{aligned}\n$$\n\nwhich reads \n\n$\\,$ For all $p\\in P,$ $p$ is odd.\n\nor simply\n\n$\\,$ Every prime number is odd."} :step/id #uuid "f94ff61b-9b2f-5d75-b6b3-db067a45dad0" :step/next {:db/id #edb/ref 17592186410148}}] :activity/title "Negating Quantified Statements" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186410110}]}
