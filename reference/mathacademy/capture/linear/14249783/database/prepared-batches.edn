[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186115330 :knowledge-point/questions ["question-586758ad-b0a5-531e-b46a-bdc8f3f5617e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-586758ad-b0a5-531e-b46a-bdc8f3f5617e" :question/id #uuid "586758ad-b0a5-531e-b46a-bdc8f3f5617e" :question/math-academy-id "q-93034" :question/problem "Find the domain of $h(x)=\\sqrt[3]{-x-5}+7.$" :question/worked-solution "The domain of $y=\\sqrt[3]{x}$ is\n$x\\in (-\\infty ,\\infty ).$\n\nTransformations do not change this interval. Therefore, the domain of $h(x)$ is $x\\in (-\\infty ,\\infty ).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bdfbe9cc-d10f-546a-ae0e-e1474b7f55ea"] :db/ensure [:question/validate]} {:db/id "answer-field-bdfbe9cc-d10f-546a-ae0e-e1474b7f55ea" :answer-field/id #uuid "bdfbe9cc-d10f-546a-ae0e-e1474b7f55ea" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-32dff668-6e85-5887-aa82-74cffacd267a" :answer-field/choices ["answer-b36b6cd7-06da-5a52-9dcc-6f8d57cdbbbd" "answer-1a3e85fe-2334-5a38-931b-c6c141d8347d" "answer-1fc7d446-c329-5e31-8f6c-0aaacbc905ed" "answer-32dff668-6e85-5887-aa82-74cffacd267a" "answer-5e3f8063-098a-51d0-abac-40f0c38c4085"] :db/ensure [:answer-field/validate]} {:db/id "answer-b36b6cd7-06da-5a52-9dcc-6f8d57cdbbbd" :answer/id #uuid "b36b6cd7-06da-5a52-9dcc-6f8d57cdbbbd" :answer/type :answer.type/math :answer/value "x\\in (-5,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-1a3e85fe-2334-5a38-931b-c6c141d8347d" :answer/id #uuid "1a3e85fe-2334-5a38-931b-c6c141d8347d" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-5)" :db/ensure [:answer/validate]} {:db/id "answer-1fc7d446-c329-5e31-8f6c-0aaacbc905ed" :answer/id #uuid "1fc7d446-c329-5e31-8f6c-0aaacbc905ed" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,5)" :db/ensure [:answer/validate]} {:db/id "answer-32dff668-6e85-5887-aa82-74cffacd267a" :answer/id #uuid "32dff668-6e85-5887-aa82-74cffacd267a" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-5e3f8063-098a-51d0-abac-40f0c38c4085" :answer/id #uuid "5e3f8063-098a-51d0-abac-40f0c38c4085" :answer/type :answer.type/math :answer/value "x\\in (0,\\infty )" :db/ensure [:answer/validate]} {:db/id 17592186115314 :knowledge-point/questions ["question-54e659be-f31e-5f00-888e-77687d0dffe4" "question-7823b972-423e-5466-806b-703ca14c80f8"] :db/ensure [:knowledge-point/validate]} {:db/id "question-54e659be-f31e-5f00-888e-77687d0dffe4" :question/id #uuid "54e659be-f31e-5f00-888e-77687d0dffe4" :question/math-academy-id "q-93048" :question/problem "Find the domain of $q(x)=2\\sqrt[4]{x+3}-2.$" :question/worked-solution "The domain of $y=\\sqrt[4]{x}$ is\n\n$$\nx\\ge 0.\n$$\n\nTo find the domain of $q(x)=2\\sqrt[4]{x+3}-2,$ we replace $x$ with $x+3$ in the above inequality. This gives\n\n$$\nx+3\\ge 0.\n$$\n\nSolving this inequality, we get\n\n$$\n\\begin{aligned}x+3 & \\ge 0 \\\\ x & \\ge -3\\end{aligned}\n$$\n\nTherefore, the domain of $y=q(x)$ is $x\\in [-3,\\infty ).$\n\nWe can also see that this is true from the graph of the function. The graph of $y=q(x)$ is shown below.\n\n![](images/97/977b12dd8bd88d2b79285ef07d89f9958194fc84f340d7930c5b40122f8896d2.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-229676b2-2ee0-5238-ae2a-c792f196f8eb"] :db/ensure [:question/validate]} {:db/id "answer-field-229676b2-2ee0-5238-ae2a-c792f196f8eb" :answer-field/id #uuid "229676b2-2ee0-5238-ae2a-c792f196f8eb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-45eb3e1e-5bf8-5fa5-8798-ad8e5416e175" :answer-field/choices ["answer-c4a84016-a105-56d3-be93-bb62a2c31e28" "answer-2a96d10d-da6d-5545-aa04-dba500589752" "answer-29de12d5-e988-519a-b0a4-78f0306fc661" "answer-45eb3e1e-5bf8-5fa5-8798-ad8e5416e175" "answer-0bec1894-d269-5eae-a947-8368616dd1ed"] :db/ensure [:answer-field/validate]} {:db/id "answer-c4a84016-a105-56d3-be93-bb62a2c31e28" :answer/id #uuid "c4a84016-a105-56d3-be93-bb62a2c31e28" :answer/type :answer.type/math :answer/value "x\\in (\\infty ,-3]" :db/ensure [:answer/validate]} {:db/id "answer-2a96d10d-da6d-5545-aa04-dba500589752" :answer/id #uuid "2a96d10d-da6d-5545-aa04-dba500589752" :answer/type :answer.type/math :answer/value "x\\in (\\infty ,3]" :db/ensure [:answer/validate]} {:db/id "answer-29de12d5-e988-519a-b0a4-78f0306fc661" :answer/id #uuid "29de12d5-e988-519a-b0a4-78f0306fc661" :answer/type :answer.type/math :answer/value "x\\in [-3,3]" :db/ensure [:answer/validate]} {:db/id "answer-45eb3e1e-5bf8-5fa5-8798-ad8e5416e175" :answer/id #uuid "45eb3e1e-5bf8-5fa5-8798-ad8e5416e175" :answer/type :answer.type/math :answer/value "x\\in [-3,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-0bec1894-d269-5eae-a947-8368616dd1ed" :answer/id #uuid "0bec1894-d269-5eae-a947-8368616dd1ed" :answer/type :answer.type/math :answer/value "x\\in [3,\\infty )" :db/ensure [:answer/validate]} {:db/id "question-7823b972-423e-5466-806b-703ca14c80f8" :question/id #uuid "7823b972-423e-5466-806b-703ca14c80f8" :question/math-academy-id "q-98631" :question/problem "Find the domain of $s(x)=\\sqrt[6]{2x-4}+1.$" :question/worked-solution "The domain of $y=\\sqrt[6]{x}$ is\n\n$$\nx\\ge 0.\n$$\n\nTo find the domain of $s(x)=\\sqrt[6]{2x-4}+1,$ we replace $x$ with $2x-4$ in the above inequality. This gives\n\n$$\n2x-4\\ge 0.\n$$\n\nSolving this inequality, we get\n\n$$\n\\begin{aligned}2x-4 & \\ge 0 \\\\ 2x & \\ge 4 \\\\ x & \\ge 2\\end{aligned}\n$$\n\nTherefore, the domain of $y=s(x)$ is $x\\in [2,\\infty ).$ \n\nWe can also see that this is true from the graph of the function. The graph of $y=s(x)$ is shown below.\n\n![](images/c3/c340fbe03170ab0dcd2ba0a7c7c32ed6712f96b0eaa944cde2dc40a232e3e32e.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c0e0