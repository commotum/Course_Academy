#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186570083} :activity/id #uuid "1eda6e9d-2f1f-582d-8538-7a3500046562" :activity/scope {:db/id #edb/ref 17592186050850 :topic/id #uuid "6bcb4fdf-14db-5859-bc2c-c769917007f1" :topic/math-academy-id 1600} :activity/steps [{:db/id #edb/ref 17592186570083 :step/content {:db/id #edb/ref 17592186569994 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a3e85fe-2334-5a38-931b-c6c141d8347d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-\\infty ,-5)" :db/id #edb/ref 17592186569484} {:answer/id #uuid "1fc7d446-c329-5e31-8f6c-0aaacbc905ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-\\infty ,5)" :db/id #edb/ref 17592186569488} {:answer/id #uuid "32dff668-6e85-5887-aa82-74cffacd267a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186569517} {:answer/id #uuid "5e3f8063-098a-51d0-abac-40f0c38c4085" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (0,\\infty )" :db/id #edb/ref 17592186569585} {:answer/id #uuid "b36b6cd7-06da-5a52-9dcc-6f8d57cdbbbd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-5,\\infty )" :db/id #edb/ref 17592186569728}] :answer-field/correct {:db/id #edb/ref 17592186569517} :answer-field/id #uuid "bdfbe9cc-d10f-546a-ae0e-e1474b7f55ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186569917}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "586758ad-b0a5-531e-b46a-bdc8f3f5617e" :question/math-academy-id "q-93034" :question/problem "Find the domain of $h(x)=\\sqrt[3]{-x-5}+7.$" :question/worked-solution "The domain of $y=\\sqrt[3]{x}$ is\n$x\\in (-\\infty ,\\infty ).$\n\nTransformations do not change this interval. Therefore, the domain of $h(x)$ is $x\\in (-\\infty ,\\infty ).$"} :step/id #uuid "bcae993d-62d5-5c88-b2b7-59fce28429cb" :step/next {:db/id #edb/ref 17592186570084}} {:db/id #edb/ref 17592186570084 :step/content {:db/id #edb/ref 17592186569989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bec1894-d269-5eae-a947-8368616dd1ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in [3,\\infty )" :db/id #edb/ref 17592186569463} {:answer/id #uuid "29de12d5-e988-519a-b0a4-78f0306fc661" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in [-3,3]" :db/id #edb/ref 17592186569499} {:answer/id #uuid "2a96d10d-da6d-5545-aa04-dba500589752" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (\\infty ,3]" :db/id #edb/ref 17592186569504} {:answer/id #uuid "45eb3e1e-5bf8-5fa5-8798-ad8e5416e175" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in [-3,\\infty )" :db/id #edb/ref 17592186569540} {:answer/id #uuid "c4a84016-a105-56d3-be93-bb62a2c31e28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (\\infty ,-3]" :db/id #edb/ref 17592186569753}] :answer-field/correct {:db/id #edb/ref 17592186569540} :answer-field/id #uuid "229676b2-2ee0-5238-ae2a-c792f196f8eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186569857}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "54e659be-f31e-5f00-888e-77687d0dffe4" :question/math-academy-id "q-93048" :question/problem "Find the domain of $q(x)=2\\sqrt[4]{x+3}-2.$" :question/worked-solution "The domain of $y=\\sqrt[4]{x}$ is\n\n$$\nx\\ge 0.\n$$\n\nTo find the domain of $q(x)=2\\sqrt[4]{x+3}-2,$ we replace $x$ with $x+3$ in the above inequality. This gives\n\n$$\nx+3\\ge 0.\n$$\n\nSolving this inequality, we get\n\n$$\n\\begin{aligned}x+3 & \\ge 0 \\\\ x & \\ge -3\\end{aligned}\n$$\n\nTherefore, the domain of $y=q(x)$ is $x\\in [-3,\\infty ).$\n\nWe can also see that this is true from the graph of the function. The graph of $y=q(x)$ is shown below.\n\n![](images/97/977b12dd8bd88d2b79285ef07d89f9958194fc84f340d7930c5b40122f8896d2.png)"} :step/id #uuid "bd23dc98-fd69-51c9-9a58-e91f7d687301" :step/next {:db/id #edb/ref 17592186570099}} {:db/id #edb/ref 17592186570099 :step/content {:db/id #edb/ref 17592186570001 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "037fd035-ab0e-5bed-9f2a-d0934fa82574" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in [2,\\infty )" :db/id #edb/ref 17592186569450} {:answer/id #uuid "6fc57805-d59e-554a-a8df-6378c378a54d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-\\infty ,-2]" :db/id #edb/ref 17592186569625} {:answer/id #uuid "83ea8867-972b-5a55-a003-4a969418a652" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186569660} {:answer/id #uuid "9f27a8ae-d48c-5273-8f21-4484bcd3f317" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-\\infty ,2]" :db/id #edb/ref 17592186569696} {:answer/id #uuid "d98d7ed4-b084-5a6e-a7ed-fc234b26f788" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in [-2,\\infty )" :db/id #edb/ref 17592186569786}] :answer-field/correct {:db/id #edb/ref 17592186569450} :answer-field/id #uuid "c0e0985b-75bc-5d5f-8b91-eb1bc0518ee9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186569920}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7823b972-423e-5466-806b-703ca14c80f8" :question/math-academy-id "q-98631" :question/problem "Find the domain of $s(x)=\\sqrt[6]{2x-4}+1.$" :question/worked-solution "The domain of $y=\\sqrt[6]{x}$ is\n\n$$\nx\\ge 0.\n$$\n\nTo find the domain of $s(x)=\\sqrt[6]{2x-4}+1,$ we replace $x$ with $2x-4$ in the above inequality. This gives\n\n$$\n2x-4\\ge 0.\n$$\n\nSolving this inequality, we get\n\n$$\n\\begin{aligned}2x-4 & \\ge 0 \\\\ 2x & \\ge 4 \\\\ x & \\ge 2\\end{aligned}\n$$\n\nTherefore, the domain of $y=s(x)$ is $x\\in [2,\\infty ).$ \n\nWe can also see that this is true from the graph of the function. The graph of $y=s(x)$ is shown below.\n\n![](images/c3/c340fbe03170ab0dcd2ba0a7c7c32ed6712f96b0eaa944cde2dc40a232e3e32e.png)"} :step/id #uuid "f926380d-bcec-5620-97b8-60ae87728a01"}] :activity/title "The Domain of a Transformed Radical Function" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186569435}]}
