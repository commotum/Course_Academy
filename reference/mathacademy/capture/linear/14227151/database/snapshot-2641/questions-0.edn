#{[{:db/id #edb/ref 17592186547981 :knowledge-point/_questions [{:db/id #edb/ref 17592186054798 :knowledge-point/id #uuid "7f806240-4d0c-5c85-b338-51b52df8ece9" :knowledge-point/title "Solving a Radical Equation With an Additional Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2de55bb9-4e8d-5f06-b11e-556b8e8249ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4,\\,3" :db/id #edb/ref 17592186547408} {:answer/id #uuid "36d4014c-9f06-558b-b2b4-ea6a2f47a4db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3,\\,4" :db/id #edb/ref 17592186547430} {:answer/id #uuid "59872150-fbec-5d48-9fe6-1b9b9e554ed6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3,\\,4" :db/id #edb/ref 17592186547513} {:answer/id #uuid "6ad116cc-f346-5585-9c55-b508e61fb4e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The equation has no solution" :db/id #edb/ref 17592186547552} {:answer/id #uuid "7e01fe28-888e-5714-9470-03041ce8461b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4,\\,-3" :db/id #edb/ref 17592186547587}] :answer-field/correct {:answer/id #uuid "6ad116cc-f346-5585-9c55-b508e61fb4e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The equation has no solution" :db/id #edb/ref 17592186547552} :answer-field/id #uuid "3de2b104-d32f-5800-a490-24878cd6ff1e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547873}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1938b4fe-a4da-5df4-945e-a4ba43cb2798" :question/math-academy-id "q-39686" :question/problem "Solve $\\sqrt{-3x-8}=x+2.$" :question/worked-solution "To solve the equation $\\sqrt{-3x-8}=x+2,$ we raise both sides to the power of $2.$  This allows us to get rid of the radical, and gives us a quadratic equation that is easier to solve:\n\n$$\n\\begin{aligned}\\sqrt{-3x-8} & =x+2 \\\\ {(\\sqrt{-3x-8})}^{2} & =(x+2)^{2} \\\\ -3x-8 & ={x}^{2}+4x+4 \\\\ {x}^{2}+7x+12 & =0 \\\\ ({x}^{2}+4x)+(3x+12) & =0 \\\\ x(x+4)+3(x+4) & =0 \\\\ (x+3)(x+4) & =0 \\\\ x & =-4,\\,-3\\end{aligned}\n$$\n\nRemember that in square root equations, we should always check the obtained value(s) to ensure that they are actually solutions of the original equation.\n\n- First, we check whether the obtained value $x=-4$ is a solution of the original equation:\n\n$$\n\\begin{aligned}\\sqrt{-3(-4)-8} & \\overset{?}{=}-4+2 \\\\ \\sqrt{4} & \\overset{?}{=}-2 \\\\ 2 & \\ne -2\\,\\times \\end{aligned}\n$$\n\nThe value $x=-4$ does *not* satisfy the original equation, so we discard it.\n\n- Second, we check whether the obtained value $x=-3$ is a solution of the original equation:\n\n$$\n\\begin{aligned}\\sqrt{-3(-3)-8} & \\overset{?}{=}-3+2 \\\\ \\sqrt{1} & \\overset{?}{=}-1 \\\\ 1 & \\ne -1\\,\\times \\end{aligned}\n$$\n\nThe value $x=-3$ does *not* satisfy the original equation, so we discard it.\n\nTherefore, there is no solution to $\\sqrt{-3x-8}=x+2x.$"}] [{:db/id #edb/ref 17592186548068 :knowledge-point/_questions [{:db/id #edb/ref 17592186054798 :knowledge-point/id #uuid "7f806240-4d0c-5c85-b338-51b52df8ece9" :knowledge-point/title "Solving a Radical Equation With an Additional Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11994bd3-02cd-5d54-9e80-6bf4d1f9a271" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-5,\\,-2" :db/id #edb/ref 17592186547353} {:answer/id #uuid "518703a7-6d82-5deb-9823-04f8892b81fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-5,\\,-4" :db/id #edb/ref 17592186547501} {:answer/id #uuid "8376cf8b-1e0a-59fe-afd5-0011348cb1b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2,\\,5" :db/id #edb/ref 17592186547597} {:answer/id #uuid "a89eae67-e29c-52cf-a4df-72219d50f3d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2,\\,5" :db/id #edb/ref 17592186547686} {:answer/id #uuid "b80abb0f-80c8-5d96-a7c3-66cc53eb5542" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-5,\\,2" :db/id #edb/ref 17592186547713}] :answer-field/correct {:answer/id #uuid "a89eae67-e29c-52cf-a4df-72219d50f3d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2,\\,5" :db/id #edb/ref 17592186547686} :answer-field/id #uuid "d572b8ad-f569-5f9c-bd00-4b949d1c4e59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547951}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e49f42fb-4ed5-5c34-8e9e-f41f753d3cfd" :question/math-academy-id "q-39754" :question/problem "Solve $\\sqrt{5x-9}=x-1.$" :question/worked-solution "To solve the equation $\\sqrt{5x-9}=x-1,$ we raise both sides to the power of $2.$  This allows us to get rid of the radical, and gives us a quadratic equation that is easier to solve:\n\n$$\n\\begin{aligned}\\sqrt{5x-9} & =x-1 \\\\ {(\\sqrt{5x-9})}^{2} & =(x-1)^{2} \\\\ 5x-9 & ={x}^{2}-2x+1 \\\\ {x}^{2}-7x+10 & =0 \\\\ ({x}^{2}-2x)+(-5x+10) & =0 \\\\ x(x-2)-5(x-2) & =0 \\\\ (x-5)(x-2) & =0 \\\\ x & =2,\\,5\\end{aligned}\n$$\n\nRemember that in square root equations, we should always check the obtained value(s) to ensure that they are actually solutions of the original equation.\n\n- First, we check whether the obtained value $x=2$ is a solution of the original equation:\n\n$$\n\\begin{aligned}\\sqrt{5(2)-9} & \\overset{?}{=}2-1 \\\\ \\sqrt{1} & \\overset{?}{=}1 \\\\ 1 & =1\\,✓\\end{aligned}\n$$\n\nIndeed, the value $x=2$ does satisfy the original equation.\n\n- Second, we check whether the obtained value $x=5$ is a solution of the original equation:\n\n$$\n\\begin{aligned}\\sqrt{5(5)-9} & \\overset{?}{=}5-1 \\\\ \\sqrt{16} & \\overset{?}{=}4 \\\\ 4 & =4\\,✓\\end{aligned}\n$$\n\nIndeed, the value $x=5$ does satisfy the original equation.\n\nTherefore, the solutions of $\\sqrt{5x-9}=x-1$  are $x=2,\\,5.$"}] [{:db/id #edb/ref 17592186055252 :knowledge-point/_questions [{:db/id #edb/ref 17592186054795 :knowledge-point/id #uuid "d1c429c4-17f9-5874-952f-2ae118e180d3" :knowledge-point/title "Solving a Radical Equation With an Isolated Radical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2aaa916-a1f2-5a60-9a45-d8d24134d648" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The equation has no real solution" :db/id #edb/ref 17592186052753} {:answer/id #uuid "0ef944fe-b546-5c3c-bb66-e324e8c66a3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2" :db/id #edb/ref 17592186547348} {:answer/id #uuid "8610145b-97d5-54e0-93c8-3885eba86069" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4" :db/id #edb/ref 17592186547604} {:answer/id #uuid "9b5ca04f-34a5-587c-b744-86213c713a80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{3}" :db/id #edb/ref 17592186547657} {:answer/id #uuid "a8fb8a27-2cb4-5bca-b2c7-af9e02db982d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{2}{3}" :db/id #edb/ref 17592186547688}] :answer-field/correct {:answer/id #uuid "a8fb8a27-2cb4-5bca-b2c7-af9e02db982d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{2}{3}" :db/id #edb/ref 17592186547688} :answer-field/id #uuid "6db1ca0c-24ea-50bb-aa50-3a7d8e46c64f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186052749}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e98c0c0b-7009-559f-859a-1e49b934344f" :question/math-academy-id "q-39821" :question/problem "Solve $\\sqrt{2-3x}=2.$" :question/worked-solution "Squaring both sides of the equation, we get\n\n$$\n\\begin{aligned}\\sqrt{2-3x} & =2 \\\\ {(\\sqrt{2-3x})}^{2} & ={2}^{2} \\\\ 2-3x & =4 \\\\ 3x & =-2 \\\\ x & =-\\frac{2}{3}.\\end{aligned}\n$$\n\nLet's check the result by plugging it into the original equation:\n\n$$\n\\begin{aligned}\\sqrt{2-3(-\\frac{2}{3})} & \\overset{?}{=}2 \\\\ \\sqrt{2-\\cancel{3}(-\\frac{2}{\\cancel{3}})} & \\overset{?}{=}2 \\\\ \\sqrt{2-(-2)} & \\overset{?}{=}2 \\\\ \\sqrt{2+2} & \\overset{?}{=}2 \\\\ \\sqrt{4} & \\overset{?}{=}2 \\\\ 2 & =2\\,\\,✓\\end{aligned}\n$$\n\nThe value $x=-\\frac{2}{3}$ satisfies the original equation, so we can accept it as a solution.\n\nTherefore, the solution to $\\sqrt{2-3x}=2$  is $x=-\\frac{2}{3}.$"}]}
