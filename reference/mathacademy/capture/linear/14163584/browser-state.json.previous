jx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"3pt\"><mtr><mtd><mi>m</mi><mi mathvariant=\"normal\">∠</mi><mrow data-mjx-texclass=\"ORD\"><mi>A</mi></mrow></mtd><mtd><mi></mi><mo>=</mo><msup><mn>30</mn><mo>∘</mo></msup><mo>+</mo><msup><mn>50</mn><mo>∘</mo></msup><mo>=</mo><msup><mn>80</mn><mo>∘</mo></msup><mo>,</mo></mtd></mtr><mtr><mtd><mi>m</mi><mi mathvariant=\"normal\">∠</mi><mrow data-mjx-texclass=\"ORD\"><mi>B</mi></mrow></mtd><mtd><mi></mi><mo>=</mo><msup><mn>30</mn><mo>∘</mo></msup><mo>+</mo><msup><mn>40</mn><mo>∘</mo></msup><mo>=</mo><msup><mn>70</mn><mo>∘</mo></msup><mo>,</mo></mtd></mtr><mtr><mtd><mi>m</mi><mi mathvariant=\"normal\">∠</mi><mrow data-mjx-texclass=\"ORD\"><mi>C</mi></mrow></mtd><mtd><mi></mi><mo>=</mo><msup><mn>30</mn><mo>∘</mo></msup><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>So, <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"49\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D434 TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D435 TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D436 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mi>B</mi><mi>C</mi></math></mjx-assistive-mml></mjx-container> is an acute triangle because all three angles are acute.</p>\n</div></div>",
