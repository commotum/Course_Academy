#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186116390} :activity/id #uuid "e244395f-15ed-5f0d-a0d8-1d032e7f6961" :activity/scope {:db/id #edb/ref 17592186050410 :topic/id #uuid "46ce73a1-ea0d-553e-b5fc-67d8d59a64f8" :topic/math-academy-id 1601} :activity/steps [{:db/id #edb/ref 17592186116095 :step/content {:db/id #edb/ref 17592186115224 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115054 :question/id #uuid "9c478978-dbb7-53c7-b076-c763b4d89c19" :question/math-academy-id "e-4268"} :knowledge-point/id #uuid "676e3d29-f6fa-5fe4-aae4-e9c0e974ee74" :knowledge-point/questions [{:db/id #edb/ref 17592186115898} {:db/id #edb/ref 17592186115899} {:db/id #edb/ref 17592186488207} {:db/id #edb/ref 17592186488224}] :knowledge-point/title "Ordering the Angles of a Triangle by Size Given the Sides"} :step/id #uuid "da9b45ae-e6d0-5a16-9c2a-a707a86b6bbf" :step/math-academy-id 15670} {:db/id #edb/ref 17592186116390 :step/content {:db/id #edb/ref 17592186116446 :tutorial/content "Triangles can be classified by sides or by angles.\n\nFirst, let's consider the classifications by sides. We have three groups of triangles:\n\n- **Equilateral** triangles, where all sides have the same length.\n\n- **Isosceles** triangles, where only two sides are congruent. The congruent sides are called the **legs** of the triangle, and the third side is called the **base**.\n\n- **Scalene** triangles, where all sides have different measures.\n\n![](images/dc/dc38034d6c202b5168fc8184511a839eb41af206eb733e71e5f5c2fa970c0e33.png)" :tutorial/id #uuid "04b4a44f-3943-5a08-9132-ec500b7ff786" :tutorial/math-academy-id 2224 :tutorial/title "Introduction"} :step/id #uuid "2105e8d3-69ba-53f8-b170-b27097df9c59" :step/math-academy-id 9127 :step/next {:db/id #edb/ref 17592186116392}} {:db/id #edb/ref 17592186116391 :step/content {:db/id #edb/ref 17592186115406 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114982 :question/id #uuid "7dd8ef62-3aaf-5db9-9d85-6953f0520e8d" :question/math-academy-id "e-2713"} :knowledge-point/id #uuid "4b19a236-cd8f-52be-9ed2-24581059f7f4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049584}] :knowledge-point/questions [{:db/id #edb/ref 17592186115539} {:db/id #edb/ref 17592186115911} {:db/id #edb/ref 17592186488191} {:db/id #edb/ref 17592186488211}] :knowledge-point/title "Classifying a Triangle Based on Its Sides"} :step/id #uuid "b726def9-901b-503a-8593-201dafc3ad42" :step/math-academy-id 9133 :step/next {:db/id #edb/ref 17592186116393}} {:db/id #edb/ref 17592186116392 :step/content {:db/id #edb/ref 17592186116447 :tutorial/content "Now, let's consider classifying triangles by angles. We have three groups of triangles.\n\n- In an **acute** triangle, all three angles are acute.\n\n- A triangle with a right angle is called a **right** triangle.\n\n- A triangle with an obtuse angle is called an **obtuse** triangle.\n\n![](images/f1/f1c28d1f4b1ec7a93f1778e63be3727aa227e8eea5320eb7d5579c697e709429.png)" :tutorial/id #uuid "c58ae206-f2dc-54ff-8d30-951635f040c4" :tutorial/math-academy-id 2228 :tutorial/title "Classifying Triangles Based on Angles"} :step/id #uuid "93db5f60-a5c9-58e2-9ec2-2983e7914914" :step/math-academy-id 9135 :step/next {:db/id #edb/ref 17592186116391}} {:db/id #edb/ref 17592186116393 :step/content {:db/id #edb/ref 17592186115407 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114983 :question/id #uuid "503325cd-6b72-5216-999f-6601f54aa1b1" :question/math-academy-id "e-2716"} :knowledge-point/id #uuid "391481e0-3bd2-570f-8948-5618d8eb40c4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049949}] :knowledge-point/questions [{:db/id #edb/ref 17592186115540} {:db/id #edb/ref 17592186115639} {:db/id #edb/ref 17592186488232}] :knowledge-point/title "Classifying a Triangle Based on Its Angles"} :step/id #uuid "3f9f27e3-19a0-5fd1-8583-922e58bff6de" :step/math-academy-id 9136 :step/next {:db/id #edb/ref 17592186116394}} {:db/id #edb/ref 17592186116394 :step/content {:db/id #edb/ref 17592186116448 :tutorial/content "Consider the following scalene triangle, where $AB=5$, $BC=7,$ and $AC=6$ units, respectively.\n\n![](images/57/57be69075640f742ffe6c004515485c4f479347f3b8b523272778948935048df.png)\n\nLooking at the angles, it's hard to tell which angle is the largest.\n\nHowever, since we know the sides, there is a simple rule that we can use to determine the relative size of the angles:\n\nLonger sides are opposite to larger angles and vice versa.\n\nApplying this rule to $\\triangle{ABC}$ depicted above, the longest side is $\\overline{BC}.$ Therefore, the largest angle is the angle opposite to $\\overline{BC},$ which is $\\color{red}\\angle{A}.$\n\n![](images/82/82d9ac6d61f285f3557d2dd0dda826803ffae306c5f9a927a422b3b953f262f4.png)\n\nSimilarly,\n\n- the mid-sized side ($\\overline{AC}$) is opposite to the mid-sized angle ($\\angle B$), and\n\n- the shortest side ($\\overline{AB}$) is opposite to the smallest angle ($\\angle C$).\n\nSo, from least to greatest, the angles of the triangle are ordered as follows:\n\n$$\nm\\angle{C} < m\\angle{B} < m\\angle{A}\n$$\n\n**Note:** This rule works in reverse too. If you know the biggest angle of a triangle, the longest side is always opposite to this angle." :tutorial/id #uuid "d464a407-72e1-515b-876a-cb5b0dd3b06f" :tutorial/math-academy-id 2229 :tutorial/title "Relationships Between Sides and Interior Angles of a Triangle"} :step/id #uuid "a22f2d5b-d95d-5243-8574-99ba246bfda2" :step/math-academy-id 9141 :step/next {:db/id #edb/ref 17592186116395}} {:db/id #edb/ref 17592186116395 :step/content {:db/id #edb/ref 17592186115408 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114984 :question/id #uuid "cbac3c76-7a3e-5a86-8e03-667874fe97f9" :question/math-academy-id "e-2719"} :knowledge-point/id #uuid "3360e34f-afe6-5f9e-be39-91e2d51ba353" :knowledge-point/questions [{:db/id #edb/ref 17592186115897} {:db/id #edb/ref 17592186115900} {:db/id #edb/ref 17592186488212}] :knowledge-point/title "Ordering the Sides of a Triangle by Size Given the Interior Angles"} :step/id #uuid "0db57a5e-6e16-5eaa-adcb-b67a00c827c4" :step/math-academy-id 9148 :step/next {:db/id #edb/ref 17592186116095}}] :activity/title "Classifying Triangles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115429}]}
