#{[{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186419585} :activity/id #uuid "830795dd-db9f-5aef-8ed9-a82f03b7bd1a" :activity/scope {:db/id #edb/ref 17592186049903 :topic/id #uuid "1cfff0a4-a88a-5e9d-8bad-9c1429faff51" :topic/math-academy-id 1960} :activity/steps [{:db/id #edb/ref 17592186419584 :step/content {:db/id #edb/ref 17592186419580 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19000333-c03d-58cd-bb96-adf67e2fb6c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186419552} {:answer/id #uuid "244d93d2-8121-51bc-8e96-aa2ac19ce6b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186419554} {:answer/id #uuid "976c2b45-35ab-56ac-a3e7-15a5ac6660c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186419568} {:answer/id #uuid "a0d3097e-28c9-5153-abed-3949a0a1f1ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186419569} {:answer/id #uuid "f94f206b-887d-51e2-9c05-298e3a299a93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186419573}] :answer-field/correct {:db/id #edb/ref 17592186419554} :answer-field/id #uuid "6c83c874-69fc-5829-8d75-f28fa19db372" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186419576}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "63f7892f-01e8-58a2-8307-26e6eb1dacb9" :question/math-academy-id "q-140051" :question/problem "Consider the linear transformation $T:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}-x-2y-2z \\\\ -z \\\\ x+2y+3z\\end{aligned}]$ and the vector $\\,u=[\\begin{aligned}-6 \\\\ k \\\\ 0\\end{aligned}].$ Find the value of $\\,k\\,$ such that $\\,u\\in \\text{Ker}(T).$" :question/worked-solution "A vector $u$ belongs to the kernel of a linear transformation $T$ if $T(u)=0.$ \n\nSo, we need to solve the following equation:\n\n$$\n\\begin{aligned}T(u) & =0 \\\\ [\\begin{aligned}-(-6)-2\\cdot k-2\\cdot 0 \\\\ -0 \\\\ -6+2\\cdot k+3\\cdot 0\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}6-2k \\\\ 0 \\\\ -6+2k\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we get the system\n\n$$\n{\\begin{aligned}6-2k=0 \\\\ -6+2k=0.\\end{aligned}\n$$\n\nThe solution to these two equations is $k=3.$"} :step/id #uuid "3d23af43-be13-585f-9055-f003ed10a6af" :step/next {:db/id #edb/ref 17592186419586}} {:db/id #edb/ref 17592186419585 :step/content {:db/id #edb/ref 17592186419583 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4739298e-dd01-59ef-8f47-4cfcbbec131c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]}" :db/id #edb/ref 17592186419557} {:answer/id #uuid "5aa80b1b-5014-541e-8bd9-63ec94952621" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{[\\begin{aligned}0 \\\\ -3 \\\\ 0\\end{aligned}]}" :db/id #edb/ref 17592186419561} {:answer/id #uuid "6e8db4f5-b391-5b49-be86-ab71fcf3e51b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]}" :db/id #edb/ref 17592186419564} {:answer/id #uuid "6f36da26-8b60-5dc1-a7b6-0a44692d0408" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]}" :db/id #edb/ref 17592186419565} {:answer/id #uuid "d37bbbe8-9321-5bfc-8871-f43a0b11a511" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]}" :db/id #edb/ref 17592186419570}] :answer-field/correct {:db/id #edb/ref 17592186419565} :answer-field/id #uuid "68bd28ba-c540-5d5a-aa98-7f8eddeaa4c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186419575}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f93ed602-5802-58b3-b8ce-1b9e0f1d7153" :question/math-academy-id "q-38686" :question/problem "Find a basis of $\\,\\text{Ker}(T)$ given that $T:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}2x-y \\\\ 5x-3y \\\\ x+3y\\end{aligned}].$" :question/worked-solution "Finding the kernel of $\\,T\\,$ is equivalent to finding the null space of the standard matrix of $\\,T.$\n\nFor the given linear transformation, the standard matrix is $T=[\\begin{aligned}2 & -1 & 0 \\\\ 5 & -3 & 0 \\\\ 1 & 3 & 0\\end{aligned}].$\n\nSetting $x=[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}],$ we then need to solve the equation $Tx=0.$ First, we reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =[\\begin{aligned}2 & -1 & 0 \\\\ 5 & -3 & 0 \\\\ 1 & 3 & 0\\end{aligned}] & {R}_{3} & ↔{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 0 \\\\ 5 & -3 & 0 \\\\ 2 & -1 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-5){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 0 \\\\ 0 & -18 & 0 \\\\ 2 & -1 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 0 \\\\ 0 & -18 & 0 \\\\ 0 & -7 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+(-\\frac{7}{18}){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 3 & 0 \\\\ 0 & -18 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$ and $y$, and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$\n\nFrom the second equation, we get $y=0.$ Substituting this into the first equation, we have $x=0.$ \n\nTherefore, if $x\\in \\text{Ker}(T),$ then \n\n$$\nx=[\\begin{aligned}0 \\\\ 0 \\\\ z\\end{aligned}]=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]z,\\,z\\in R.\n$$\n\nThis implies that $B={[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]}$ is a basis of $\\text{Ker}(T).$"} :step/id #uuid "acaaf24c-b820-5d27-9cad-c26f7f900e0e" :step/next {:db/id #edb/ref 17592186419587}} {:db/id #edb/ref 17592186419586 :step/content {:db/id #edb/ref 17592186419579 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fe092bb-bdb8-550c-a7aa-700202769f6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{[\\begin{aligned}-2y+z \\\\ y \\\\ z\\end{aligned}]\\,:\\,y,z\\in R}." :db/id #edb/ref 17592186419555} {:answer/id #uuid "34464ede-fe32-54e3-8700-7eae73a44d76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{[\\begin{aligned}-4z \\\\ y \\\\ 2z\\end{aligned}]\\,:\\,z\\in R}" :db/id #edb/ref 17592186419556} {:answer/id #uuid "5e442e08-651b-596c-a28f-613f716517a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]}" :db/id #edb/ref 17592186419562} {:answer/id #uuid "87b1ab8b-53cc-5796-820a-719dc0cbb1d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{[\\begin{aligned}x \\\\ y \\\\ 4x+2y\\end{aligned}]\\,:\\,x,y\\in R}" :db/id #edb/ref 17592186419567} {:answer/id #uuid "f2706581-c2a4-529c-8a29-695dc8229666" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{[\\begin{aligned}x \\\\ 4x+2z \\\\ z\\end{aligned}]\\,:\\,x,y\\in R}" :db/id #edb/ref 17592186419572}] :answer-field/correct {:db/id #edb/ref 17592186419555} :answer-field/id #uuid "07ed2ad4-a2fd-5d04-be73-f4b3ba6ae7db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186419574}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "32b7b7cc-73cb-5678-9200-bd4242fb8265" :question/math-academy-id "q-140056" :question/problem "Consider the linear transformation $T:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}2x+4y-2z \\\\ -3x-6y+3z \\\\ 4x+8y-4z\\end{aligned}].$ Find $\\,\\text{Ker}(T).$" :question/worked-solution "Finding the kernel of $T$ is equivalent to finding the null space of the standard matrix of $T.$\n\nFror the given linear transformation, the standard matrix is $T=[\\begin{aligned}2 & 4 & -2 \\\\ -3 & -6 & 3 \\\\ 4 & 8 & -4\\end{aligned}].$ \n\nSetting $x=[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}],$ we then need to solve the equation $Tx=0.$ First, we find reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =[\\begin{aligned}2 & 4 & -2 \\\\ -3 & -6 & 3 \\\\ 4 & 8 & -4\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(\\frac{3}{2}){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}2 & 4 & -2 \\\\ 0 & 0 & 0 \\\\ 4 & 8 & -4\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+(-2){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}2 & 4 & -2 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$, and we have two free variables, $y,$ and $z.$ That means we need to find $x$ in terms of $y$ and $z.$ \n\nFrom the first equation, we get \n\n$$\nx=-2y+z.\n$$\n\n  \n\nTherefore, the kernel of the linear transformation $\\,T$ is ${[\\begin{aligned}-2y+z \\\\ y \\\\ z\\end{aligned}]\\,:\\,y,z\\in R}.$"} :step/id #uuid "e5b6668f-23d9-5bd7-ab9f-9383a9c47d8d"} {:db/id #edb/ref 17592186419587 :step/content {:db/id #edb/ref 17592186419582 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "002e3086-b98b-552c-addc-3f03c123250a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186419549} {:answer/id #uuid "074dbe6b-ac14-5305-9b21-791a127cd1b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186419550} {:answer/id #uuid "54b40f38-942c-56c1-a0a6-462a9318f8c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186419560} {:answer/id #uuid "7ab3c7ac-b751-5ee8-8682-76fba4b200e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186419566} {:answer/id #uuid "e26456a4-5ad0-5391-b8ab-b6896539894e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186419571}] :answer-field/correct {:db/id #edb/ref 17592186419571} :answer-field/id #uuid "c1c315ae-a887-5ed7-90f8-efa5df25967c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186419577}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f1fb1c9c-0f88-5161-9527-cc60a53751f9" :question/math-academy-id "q-80666" :question/problem "Consider the linear transformation $T:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}-2x-14y \\\\ 3x+21y\\end{aligned}]$ and the vector $\\,u=[\\begin{aligned}7 \\\\ k\\end{aligned}].$ Find the value of $\\,k\\,$ such that $\\,u\\in \\text{Ker}(T).$" :question/worked-solution "A vector $u$ belongs to the kernel of a linear transformation $T$ if $T(u)=0.$ \n\nSo, we need to solve the following equation:\n\n$$\n\\begin{aligned}T(u) & =0 \\\\ [\\begin{aligned}-2\\cdot 7-14\\cdot k \\\\ 3\\cdot 7+21\\cdot k\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}-14-14k \\\\ 21+21k\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we get the system\n\n$$\n{\\begin{aligned}-14-14k=0 \\\\ 21+21k=0.\\end{aligned}\n$$\n\nThe solution to both of these equations is $k=-1.$"} :step/id #uuid "f4e671bf-aca9-5c31-b460-2f7da409a479" :step/next {:db/id #edb/ref 17592186419588}} {:db/id #edb/ref 17592186419588 :step/content {:db/id #edb/ref 17592186419581 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0db9202e-b598-5f25-bdc3-0d228cf73e32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186419551} {:answer/id #uuid "1dbe2ca8-db59-5a94-82d9-cb88aa1ffaad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186419553} {:answer/id #uuid "49892ac2-f3e6-5f71-9f0d-4dbe950589af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186419558} {:answer/id #uuid "4cb35d88-ee52-5c7a-aa5d-66486183461e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186419559} {:answer/id #uuid "61f70cb9-9bba-514c-809f-dad55c0c90bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186419563}] :answer-field/correct {:db/id #edb/ref 17592186419553} :answer-field/id #uuid "e00646f1-87a0-5a44-9d32-d7268a416e97" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186419578}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aeb22a13-5f92-563c-bd00-38953af464b9" :question/math-academy-id "q-81393" :question/problem "Given the linear transformation $T:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}9y-3x+6z \\\\ 3y-x+2z \\\\ 6x-12z-18y\\end{aligned}],$ find $\\text{nullity}(T).$" :question/worked-solution "First, we write down the standard matrix of $T:$\n\n$$\nT=[\\begin{aligned}-3 & 9 & 6 \\\\ -1 & 3 & 2 \\\\ 6 & -18 & -12\\end{aligned}]\n$$\n\nRecall that $\\text{nullity}(T)=\\text{nullity}(T)=\\text{dim}(\\text{Null}(T)).$\n\nIn order to find $\\text{dim}(\\text{Null}(T)),$ we reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =[\\begin{aligned}-3 & 9 & 6 \\\\ -1 & 3 & 2 \\\\ 6 & -18 & -12\\end{aligned}] & {R}_{2} & :={R}_{2}+(-\\frac{1}{3}){R}_{1} \\\\  & ∼[\\begin{aligned}-3 & 9 & 6 \\\\ 0 & 0 & 0 \\\\ 6 & -18 & -12\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼[\\begin{aligned}-3 & 9 & 6 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nThe reduced matrix above has $2$ non-pivot columns (the $2$nd and $3$rd ones). Therefore, \n\n$$\n\\text{nullity}(T)=\\text{dim}(\\text{Null}(T))=2.\n$$"} :step/id #uuid "fa869ace-3a7c-544c-91f1-9f8e4eedf28f" :step/next {:db/id #edb/ref 17592186419584}}] :activity/title "The Kernel of a Linear Transformation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186419548}]}
