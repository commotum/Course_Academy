#{[{:activity/first-step {:db/id #edb/ref 17592186125397} :activity/id #uuid "b2027039-9734-5db5-aca4-967ce9b8912e" :activity/scope {:db/id #edb/ref 17592186049903 :topic/id #uuid "1cfff0a4-a88a-5e9d-8bad-9c1429faff51" :topic/math-academy-id 1960} :activity/steps [{:db/id #edb/ref 17592186125397 :step/content {:db/id #edb/ref 17592186125782 :tutorial/content "The **kernel** of a linear transformation is the set of vectors that map to the zero vector. We define it formally as follows:\n\n> *For a linear transformation $\\mathbf{T}$, the **kernel** of $\\mathbf{T}$ is the set of all the vectors $\\mathbf{u}$ such that $\\mathbf{T}(\\mathbf{u})=\\mathbf{0}.$ We can write this as*\n> \n> \n> $$\n> \\textrm{Ker}(\\mathbf{T}) = \\left\\{ \\;\\mathbf{u} \\;| \\; \\mathbf{T}(\\mathbf{u}) = \\mathbf{0} \\right\\}.\n> $$\n\nThe diagram below shows the kernel of a linear transformation $\\mathbf{T}: V \\rightarrow V$ in a vector space $V$.\n\n![](images/05/05f8c544d55c6bb07e4063150e586f8b4a7c51a352c2ff8ddda8c4cd5047dd93.png)\n\nNotice that, because of linearity, the zero vector is always in the kernel of a linear transformation: \n\n$$\n\\mathbf{T}(\\mathbf{0})=\\mathbf{T}(0\\cdot\\mathbf{v})=0\\cdot\\mathbf{T}(\\mathbf{v})= \\mathbf 0\n$$\n\nfor any vector $\\mathbf{v}$." :tutorial/id #uuid "50e4315c-9517-5360-820c-0b5ac6318f72" :tutorial/math-academy-id 3529 :tutorial/title "Introduction"} :step/id #uuid "ce1c8772-3f18-536d-9a24-286e7fb6cdcd" :step/math-academy-id 20011 :step/next {:db/id #edb/ref 17592186125447}} {:db/id #edb/ref 17592186125398 :step/content {:db/id #edb/ref 17592186124516 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124325 :question/id #uuid "87580982-1d5a-5f68-b9c8-df77b4da0196" :question/math-academy-id "e-5439"} :knowledge-point/id #uuid "a60cd4e9-d478-52ef-871e-fb08ff3d68a5" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048181} {:db/id #edb/ref 17592186048203}] :knowledge-point/questions [{:db/id #edb/ref 17592186125105} {:db/id #edb/ref 17592186125138} {:db/id #edb/ref 17592186272014} {:db/id #edb/ref 17592186323943} {:db/id #edb/ref 17592186323944} {:db/id #edb/ref 17592186398814}] :knowledge-point/title "Finding the Kernel of a Linear Transformation"} :step/id #uuid "33a79ad4-40f8-519e-9527-22ea73a00c60" :step/math-academy-id 20012 :step/next {:db/id #edb/ref 17592186125491}} {:db/id #edb/ref 17592186125399 :step/content {:db/id #edb/ref 17592186124517 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124326 :question/id #uuid "f3694e9e-804f-55f0-9fb1-a78caec29224" :question/math-academy-id "e-5440"} :knowledge-point/id #uuid "15d2fde0-af1d-5e87-be58-806b9d444144" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050996}] :knowledge-point/questions [{:db/id #edb/ref 17592186125134} {:db/id #edb/ref 17592186125135} {:db/id #edb/ref 17592186326813} {:db/id #edb/ref 17592186348440} {:db/id #edb/ref 17592186351303} {:db/id #edb/ref 17592186351304} {:db/id #edb/ref 17592186364968} {:db/id #edb/ref 17592186366078}] :knowledge-point/title "Finding the Nullity of a Linear Transformation"} :step/id #uuid "efa48e6d-73c8-530e-950a-58d259466cc6" :step/math-academy-id 20013} {:db/id #edb/ref 17592186125400 :step/content {:db/id #edb/ref 17592186124518 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124327 :question/id #uuid "fc0725a9-354c-5e01-a924-12c0d2723ba3" :question/math-academy-id "e-5441"} :knowledge-point/id #uuid "5d9208e7-9ee2-5220-9d62-6259432913d9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673}] :knowledge-point/questions [{:db/id #edb/ref 17592186125104} {:db/id #edb/ref 17592186125107} {:db/id #edb/ref 17592186272002} {:db/id #edb/ref 17592186351301} {:db/id #edb/ref 17592186351302} {:db/id #edb/ref 17592186366358} {:db/id #edb/ref 17592186394037}] :knowledge-point/title "Calculating a Component of a Vector in the Kernel of a Linear Transformation"} :step/id #uuid "ff0148ea-ac0d-5e4b-bb4f-d79994d37847" :step/math-academy-id 20014 :step/next {:db/id #edb/ref 17592186125489}} {:db/id #edb/ref 17592186125447 :step/content {:db/id #edb/ref 17592186124546 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124355 :question/id #uuid "5ba5ded2-bfca-5e53-9056-8aede726505f" :question/math-academy-id "e-5616"} :knowledge-point/id #uuid "9af17e52-688b-5b75-8902-65be7464d50b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048652} {:db/id #edb/ref 17592186050173}] :knowledge-point/questions [{:db/id #edb/ref 17592186125103} {:db/id #edb/ref 17592186125136} {:db/id #edb/ref 17592186272001} {:db/id #edb/ref 17592186323931} {:db/id #edb/ref 17592186323947} {:db/id #edb/ref 17592186402709} {:db/id #edb/ref 17592186404177}] :knowledge-point/title "Determining Whether Given Vectors Belong to the Kernel of a Linear Transformation"} :step/id #uuid "c3641ddd-fe03-5d00-8409-c7bae029f435" :step/math-academy-id 20406 :step/next {:db/id #edb/ref 17592186125400}} {:db/id #edb/ref 17592186125489 :step/content {:db/id #edb/ref 17592186125818 :tutorial/content "We know how to determine whether a given vector is in the kernel of a linear transformation. But how do we find the kernel of a linear transformation?\n\nFirst, remember that if $T$ is the standard matrix of $\\mathbf{T},$ then \n\n$$\n\\textrm{Ker}(\\mathbf{T}) = \\textrm{Null}(T) = \\left\\{ \\;\\mathbf{x} \\;|\\; T\\mathbf{x}=\\mathbf{0} \\right\\}.\n$$\n\nTherefore, to find all the vectors in the kernel of a linear transformation, we just need to find the null space of the corresponding standard matrix. We can do this by solving the matrix equation $T\\mathbf{x}=\\mathbf{0}.$" :tutorial/id #uuid "d40c6e54-14ec-5f9e-a7be-84f54568e9cf" :tutorial/math-academy-id 4275 :tutorial/title "Finding the Kernel of a Linear Transformation"} :step/id #uuid "c2658336-bd8d-573d-850f-e69a58c8a2f4" :step/math-academy-id 25965 :step/next {:db/id #edb/ref 17592186125398}} {:db/id #edb/ref 17592186125491 :step/content {:db/id #edb/ref 17592186125820 :tutorial/content "The **nullity** of a linear transformation $\\mathbf{T}$ is the dimension of its kernel. This means that\n\n$$\n\\text{nullity}(\\mathbf{T}) = \\dim(\\textrm{Ker}(\\mathbf{T})) = \\text{nullity}(T).\n$$\n\nTo compute the dimension of the kernel of $\\mathbf{T},$ we just have to reduce the matrix $T$ to row echelon form and count the number of  non-pivot columns." :tutorial/id #uuid "6246b2bd-c065-5a41-af65-109b316ca6e2" :tutorial/math-academy-id 4313 :tutorial/title "The Nullity of a Linear Transformation"} :step/id #uuid "f7d4bb63-d535-509c-9941-b7ed106acb1b" :step/math-academy-id 26214 :step/next {:db/id #edb/ref 17592186125399}}] :activity/title "The Kernel of a Linear Transformation" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186124745}]}
