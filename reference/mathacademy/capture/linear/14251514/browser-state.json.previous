><mn>2</mn><mo stretchy=\"false\">(</mo><mo>−</mo><mn>5</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mo>−</mo><mn>1</mn></mrow></msup><mo>+</mo><mn>2</mn><mo stretchy=\"false\">(</mo><mo>−</mo><mn>5</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>3</mn><mo>−</mo><mn>1</mn></mrow></msup><mo>+</mo><mn>2</mn><mo stretchy=\"false\">(</mo><mo>−</mo><mn>5</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>4</mn><mo>−</mo><mn>1</mn></mrow></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><mo stretchy=\"false\">(</mo><mo>−</mo><mn>5</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow></msup><mo>+</mo><mn>2</mn><mo stretchy=\"false\">(</mo><mo>−</mo><mn>5</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>2</mn></mrow></msup><mo>+</mo><mn>2</mn><mo stretchy=\"false\">(</mo><mo>−</mo><mn>5</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>3</mn></mrow></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><mo stretchy=\"false\">(</mo><mo>−</mo><mn>5</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mn>2</mn><mo stretchy=\"false\">(</mo><mn>25</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mn>2</mn><mo stretchy=\"false\">(</mo><mo>−</mo><mn>125</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>10</mn><mo>+</mo><mn>50</mn><mo>−</mo><mn>250</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>210.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
