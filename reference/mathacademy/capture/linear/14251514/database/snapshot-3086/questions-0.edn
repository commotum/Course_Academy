#{[{:db/id #edb/ref 17592186572165 :knowledge-point/_questions [{:db/id #edb/ref 17592186078570 :knowledge-point/id #uuid "dc0a5e10-c402-54cb-80e6-ba4fcc3e9df4" :knowledge-point/title "Evaluating Expressions Written in Sigma Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d15c8e5-09a1-5c60-b3ea-77e8a25be021" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{16}" :db/id #edb/ref 17592186571677}] :answer-field/correct {:answer/id #uuid "4d15c8e5-09a1-5c60-b3ea-77e8a25be021" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{16}" :db/id #edb/ref 17592186571677} :answer-field/id #uuid "f4f62d70-89e9-5c8b-bb17-0a8ab8049b70" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572098}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ad12bb7f-1602-5240-b7ed-1965d82aeb70" :question/math-academy-id "q-251038" :question/problem "Evaluate ${\\sum }_{a=1}^{3}a{(\\frac{1}{2})}^{a+1}=${{field-1}}" :question/worked-solution "The sum takes integer values of $a$ from $1$ to $3.$ So, computing the terms for $a=1,2,3$ and then adding them, we get\n\n$$\n\\begin{aligned}{\\sum }_{a=1}^{3}a{(\\frac{1}{2})}^{a+1} & =1{(\\frac{1}{2})}^{1+1}+2{(\\frac{1}{2})}^{2+1}+3{(\\frac{1}{2})}^{3+1} \\\\  & =1{(\\frac{1}{2})}^{2}+2{(\\frac{1}{2})}^{3}+3{(\\frac{1}{2})}^{4} \\\\  & =1\\cdot \\frac{1}{4}+2\\cdot \\frac{1}{8}+3\\cdot \\frac{1}{16} \\\\  & =\\frac{1}{4}+\\frac{2}{8}+\\frac{3}{16} \\\\  & =\\frac{(1\\cdot 4)+(2\\cdot 2)+3}{16} \\\\  & =\\frac{4+4+3}{16} \\\\  & =\\frac{11}{16}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186572139 :knowledge-point/_questions [{:db/id #edb/ref 17592186078571 :knowledge-point/id #uuid "50fb047f-8c8d-56a6-9093-29a68cd89a90" :knowledge-point/title "Writing Sums Using Sigma Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49b1973e-9eb4-55c9-a657-9947ff404a18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186571669}] :answer-field/correct {:answer/id #uuid "49b1973e-9eb4-55c9-a657-9947ff404a18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186571669} :answer-field/id #uuid "7d65b861-3214-55db-a706-f67ab70138bb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572038} {:answer-field/choices [{:answer/id #uuid "5100e460-e16d-5b88-9740-8e34d7ba337f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11n" :db/id #edb/ref 17592186571685}] :answer-field/correct {:answer/id #uuid "5100e460-e16d-5b88-9740-8e34d7ba337f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11n" :db/id #edb/ref 17592186571685} :answer-field/id #uuid "84ebc9f1-94c0-5625-836c-e75e15dbd698" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572041}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6876cab6-19a3-5946-803c-f05451437328" :question/math-academy-id "q-251042" :question/problem "Express $S=11+22+33+⋯+242+253$ using sigma notation.\n\n|  | {{field-1}} |  |  |  |\n| --- | --- | --- | --- | --- |\n| $\\,\\,\\,\\,S=$ | $\\sum$ | {{field-2}} |  |  |\n|  | $\\,\\,\\,\\,\\,{}^{n=1}$ |  |  | $\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,$ |" :question/worked-solution "Notice that the terms of the corresponding sequence\n\n$$\n11,\\,22,\\,33,\\,…,\\,242,\\,253.\n$$\n\nare multiples of $11.$ Since $253÷11=23,$ there are $23$ terms in total. \n\nTherefore, the $n$th term of the sequence has the form\n\n$$\n{a}_{n}=11n,\n$$\n\nwhere $n$ ranges from $n=1$ to $n=23.$ Indeed:\n\n$$\n\\begin{aligned}{a}_{1} & =11(1)=11 \\\\ {a}_{2} & =11(2)=22 \\\\ {a}_{3} & =11(3)=33 \\\\  & \\,\\,⋮ \\\\ {a}_{22} & =11(22)=242 \\\\ {a}_{23} & =11(23)=253\\end{aligned}\n$$\n\nTherefore,\n\n$$\nS=11+22+33+⋯+242+253={\\sum }_{n=1}^{23}11n.\n$$"}] [{:db/id #edb/ref 17592186079085 :knowledge-point/_questions [{:db/id #edb/ref 17592186078570 :knowledge-point/id #uuid "dc0a5e10-c402-54cb-80e6-ba4fcc3e9df4" :knowledge-point/title "Evaluating Expressions Written in Sigma Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9032873f-fe5d-5309-bac7-712c0d88b5ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-250" :db/id #edb/ref 17592186077289} {:answer/id #uuid "c60ceba7-699f-571e-817b-ece2f4df4352" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-240" :db/id #edb/ref 17592186077290} {:answer/id #uuid "246973d7-bb62-56eb-9b26-700acd58ccbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186077291} {:answer/id #uuid "323389cc-80e7-53ea-a581-e810d8c59202" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "250" :db/id #edb/ref 17592186077292} {:answer/id #uuid "3b569f1e-eee3-5d52-9856-0e1ca7b0e969" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-210" :db/id #edb/ref 17592186077293}] :answer-field/id #uuid "70dd458e-1df0-509c-91b0-2540cafd3cdc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186077288}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c75723a5-ce8a-5816-b08a-4d21e00c089f" :question/math-academy-id "q-5323" :question/problem "Evaluate $∑_(k = 2)^(4)2(-5)^{k - 1}$."}] [{:db/id #edb/ref 17592186572159 :knowledge-point/_questions [{:db/id #edb/ref 17592186078570 :knowledge-point/id #uuid "dc0a5e10-c402-54cb-80e6-ba4fcc3e9df4" :knowledge-point/title "Evaluating Expressions Written in Sigma Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b3dbf76-1828-5ac3-95d4-ae11a90e9d96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{3}" :db/id #edb/ref 17592186571671} {:answer/id #uuid "6ae29c52-d0a4-57f9-b779-c3d0dd5e9cde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{3}" :db/id #edb/ref 17592186571719} {:answer/id #uuid "8d9a9678-e9d3-58bc-9368-2b227c8f92dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{19}{3}" :db/id #edb/ref 17592186571784} {:answer/id #uuid "a5a5870f-6363-5e60-9102-9a8718114824" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{3}" :db/id #edb/ref 17592186571826} {:answer/id #uuid "aa89a132-2370-5d8b-adb7-ea45dff6e069" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23}{3}" :db/id #edb/ref 17592186571830}] :answer-field/correct {:answer/id #uuid "8d9a9678-e9d3-58bc-9368-2b227c8f92dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{19}{3}" :db/id #edb/ref 17592186571784} :answer-field/id #uuid "a3df603d-e9b9-56c6-b6d3-afe5a79147ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572056}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9b0b4f87-d00c-5a8b-9552-578050192860" :question/math-academy-id "q-6452" :question/problem "Evaluate ${\\sum }_{n=1}^{4}\\frac{3n+2}{6}.$" :question/worked-solution "The sum takes integer values of $n$ from $1$ to $4.$ So, computing the terms for $n=1,2,3,4$ and then adding them, we get\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{4}\\frac{3n+2}{6} & =(\\frac{3(1)+2}{6})+(\\frac{3(2)+2}{6})+(\\frac{3(3)+2}{6})+(\\frac{3(4)+2}{6}) \\\\  & =(\\frac{3+2}{6})+(\\frac{6+2}{6})+(\\frac{9+2}{6})+(\\frac{12+2}{6}) \\\\  & =\\frac{5}{6}+\\frac{8}{6}+\\frac{11}{6}+\\frac{14}{6} \\\\  & =\\frac{5+8+11+14}{6} \\\\  & =\\frac{38}{6} \\\\  & =\\frac{\\cancel{2}\\cdot 19}{\\cancel{2}\\cdot 3} \\\\  & =\\frac{19}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186572147 :knowledge-point/_questions [{:db/id #edb/ref 17592186078571 :knowledge-point/id #uuid "50fb047f-8c8d-56a6-9093-29a68cd89a90" :knowledge-point/title "Writing Sums Using Sigma Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1859af70-b4a9-5ac8-b15e-557877154d5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{30}(5n+5)" :db/id #edb/ref 17592186571582} {:answer/id #uuid "1b08921a-836f-5184-98c7-2e517870fcd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{30}5n" :db/id #edb/ref 17592186571584} {:answer/id #uuid "8d8a2540-b313-56d6-b25c-ba6befc7e70b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{30}(n+5)" :db/id #edb/ref 17592186571783} {:answer/id #uuid "be6eb5a1-d8e7-51d4-9b0a-cc8a3f0aa34f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{40}5n" :db/id #edb/ref 17592186571878} {:answer/id #uuid "fc737954-5e02-5429-9035-eeedbb65ef53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{30}(5n-5)" :db/id #edb/ref 17592186571972}] :answer-field/correct {:answer/id #uuid "1b08921a-836f-5184-98c7-2e517870fcd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{30}5n" :db/id #edb/ref 17592186571584} :answer-field/id #uuid "99bb45d1-f62a-5cde-a64e-61cf34c79c49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572052}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7ef08379-b59b-5715-b5e6-571eb4f00b67" :question/math-academy-id "q-66994" :question/problem "Express $S=5+10+15+⋯+145+150$ in sigma notation." :question/worked-solution "Notice that the terms of the corresponding sequence\n\n$$\n5,\\,10,\\,15,\\,…,\\,145,\\,150.\n$$\n\n are multiples of $5,$ and since $150÷5=30,$ there are $30$ terms in total. \n\nTherefore, the $n$th term of the sequence has the form\n\n$$\n{a}_{n}=5n,\n$$\n\nwhere $n$ ranges from $n=1$ to $n=30.$ Indeed: \n\n$$\n\\begin{aligned}{a}_{1} & =5(1)=5 \\\\ {a}_{2} & =5(2)=10 \\\\ {a}_{3} & =5(3)=15 \\\\  & \\,\\,⋮ \\\\ {a}_{29} & =5(29)=145 \\\\ {a}_{30} & =5(30)=150\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S &=5+10+15+⋯+145+150={\\sum }_{n=1}^{30}5n.\\end{aligned}\n$$"}]}
