103124" :question/problem "A company initially had $40\\,320$ followers on a social media platform. If the number of followers declines by $\\frac{1}{8}$ every month after some bad publicity, which expression gives approximately the number of followers after $4$ months?" :question/worked-solution "If the number of followers reduces by $\\frac{1}{8}$ every month, then $\\frac{7}{8}$ of the followers remains every month.\n\nTherefore:\n\n- After $1$ month, there will be $40\\,320\\cdot (\\frac{7}{8})$ followers.\n\n- After $2$ months, there will be $40\\,320\\cdot {(\\frac{7}{8})}^{2}$ followers.\n\n- After $3$ months, there will be approximately $40\\,320\\cdot {(\\frac{7}{8})}^{3}$ followers.\n\n- After $4$ months, there will be approximately $40\\,320\\cdot {(\\frac{7}{8})}^{4}$ followers."}] [{:db/id #edb/ref 17592186060314 :knowledge-point/_questions [{:db/id #edb/ref 17592186059870 :knowledge-point/id #uuid "162c9121-ff80-59f5-85e1-cdeb2729bfc6" :knowledge-point/title "Creating an Exponential Decay Expression From a Decay Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "295b4554-e6e4-5572-8988-a41fbe42755b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\cdot {(\\frac{5}{6})}^{3}" :db/id #edb/ref 17592186538319} {:answer/id #uuid "88b25360-062c-5962-ab67-7d166e829582" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{12}^{3}\\cdot (\\frac{5}{6})" :db/id #edb/ref 17592186538550} {:answer/id #uuid "b9d2273f-c214-550e-bdff-c833b0e8605d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\cdot {(\\frac{1}{6})}^{3}" :db/id #edb/ref 17592186538667} {:answer/id #uuid "dc51588c-9b81-533c-b74d-397e014ebe49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{12}^{3}\\cdot (\\frac{1}{6})" :db/id #edb/ref 17592186538737} {:answer/id #uuid "f34187bf-602c-5b72-80aa-ab6dacc13343" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\cdot {(\\frac{7}{6})}^{3}" :db/id #edb/ref 17592186538782}] :answer-field/correct {:answer/id #uuid "295b4554-e6e4-5572-8988-a41fbe42755b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\cdot {(\\frac{5}{6})}^{3}" :db/id #edb/ref 17592186538319} :answer-field/id #uuid "707254ef-77ca-5349-acbb-38802e8305d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058506}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3d28d168-3d53-5315-aa0b-8d22162ffbb7" :question/math-academy-id "q-61858" :question/problem "Owen enrolled in an online course that has $12$ topics. He completed $\\frac{1}{6}$ of the remaining topics every week. Which expression gives approximately  the number of topics that were incomplete after $3$ weeks?" :question/worked-solution "If the number of incomplete topics decreased by $\\frac{1}{6}$ every week, then every week $\\frac{5}{6}$ of the topics remained incomplete.\n\nTherefore:\n\n- After $1$ week, $12\\cdot (\\frac{5}{6})$ topics were incomplete.\n\n- After $2$ weeks, approximately  $12\\cdot {(\\frac{5}{6})}^{2}$ topics were incomplete.\n\n- After $3$ weeks, approximately $12\\cdot {(\\frac{5}{6})}^{3}$ topics were incomplete."}] [{:db/id #edb/ref 17592186538979 :knowledge-point/_questions [{:db/id #edb/ref 17592186059869 :knowledge-point/id #uuid "1b701fb5-7676-5c5f-8a80-b86d2dec0548" :knowledge-point/title "Creating an Exponential Decay Expression From a Decay Rate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59df4646-b50a-5d4b-ae72-4abb4bbc5af9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "400\\cdot (1.02)^{3}" :db/id #edb/ref 17592186538425} {:answer/id #uuid "619431ae-e9db-5a4b-a7fd-782b989a642c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "400\\cdot (0.98)^{3}" :db/id #edb/ref 17592186538446} {:answer/id #uuid "710e9657-f231-554c-92fe-ec46ef48fb0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "400\\cdot (0.8)^{3}" :db/id #edb/ref 17592186538483} {:answer/id #uuid "8473525f-1815-5c36-af56-1eb153bd55e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "400\\cdot (0.02)^{3}" :db/id #edb/ref 17592186538537} {:answer/id #uuid "c59cd770-bed2-5f0d-a3f9-575cb42f709d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{400}^{3}\\cdot (0.98)" :db/id #edb/ref 17592186538693}] :answer-field/correct {:answer/id #uuid "619431ae-e9db-5a4b-a7fd-782b989a642c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "400\\cdot (0.98)^{3}" :db/id #edb/ref 17592186538446} :answer-field/id #uuid "a5c3df3d-549f-5a8b-98e2-1cf655414971" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538885}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "85541785-a1f8-5b45-843e-637ba62e4e83" :question/math-academy-id "q-61871" :question/problem "Elena has $400$ TVs in her store. She expects that the number of TVs will decrease by $2%$ daily due to sales. Approximately how many TVs will be in her store after $3$ days?" :question/worked-solution "The number $2%$ (expressed as a decimal) is equal to $0.02.$ Therefore, a decrease of $0.02%$ corresponds to multiplication by a factor of:\n\n$$\n1-0.02=0.98\n$$\n\nTherefore:\n\n- After $1$ day, there will be $400\\cdot (0.98)$ TVs remaining.\n\n- After $2$ days, there will be approximately $400\\cdot (0.98)^{2}$ TVs remaining.\n\n- After $3$ days, there will be approximately $400\\cdot (0.98)^{3}$ TVs remaining."}] [{:db/id #edb/ref 17592186538929 :knowledge-point/_questions [{:db/id #edb/ref 17592186059870 :knowledge-point/id #uuid "162c9121-ff80-59f5-85e1-cdeb2729bfc6" :knowledge-point/title "Creating an Exponential Decay Expression From a Decay Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03ad4804-5d67-5f61-a2ef-fb8a13a792b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64\\cdot {(\\frac{1}{2})}^{6}" :db/id #edb/ref 17592186538241} {:answer/id #uuid "3957d0a7-b17e-59fa-ba9f-5a550a649663" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64\\cdot {(\\frac{3}{2})}^{6}" :db/id #edb/ref 17592186538351} {:answer/id #uuid "775ad280-4252-584a-9cd3-1acf0234c161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{64}^{6}\\cdot (\\frac{3}{2})" :db/id #edb/ref 17592186538502} {:answer/id #uuid "b41a5b18-1ac7-5ab7-a7f0-296fa3f34e5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{64}^{6}\\cdot (\\frac{1}{2})" :db/id #edb/ref 17592186538652} {:answer/id #uuid "ef88dff2-c156-5cd2-98da-be865d390a62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64\\cdot {(2)}^{6}" :db/id #edb/ref 17592186538777}] :answer-field/correct {:answer/id #uuid "03ad4804-5d67-5f61-a2ef-fb8a13a792b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64\\cdot {(\\frac{1}{2})}^{6}" :db/id #edb/ref 17592186538241} :answer-field/id #uuid "b0410c69-ce09-548b-ba42-743ef4a478a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538889}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "11af995c-4c5e-50de-8182-ca4e90fd1ecf" :question/math-academy-id "q-61965" :question/problem "A soccer tournament began with $64$ teams. The number of teams reduced by $\\frac{1}{2}$ after every round. How many teams remained after $6$ rounds?" :question/worked-solution "There were $64$ initially, and this number decreased by $\\frac{1}{2}$ every round. \n\nTherefore:\n\n- After $1$ round, there were $64\\cdot (\\frac{1}{2})$ teams remaining.\n\n- After $2$ rounds, there were $64\\cdot {(\\frac{1}{2})}^{2}$ teams remaining.\n\n- After $3$ rounds, there were $64\\cdot {(\\frac{1}{2})}^{3}$ teams  remaining.\n\n- $…$\n\nRepeating this pattern, we see that there were $64\\cdot {(\\frac{1}{2})}^{6}$ teams remaining after $6$ rounds."}] [{:db/id #edb/ref 17592186538950 :knowledge-point/_questions [{:db/id #edb/ref 17592186059869 :knowledge-point/id #uuid "1b701fb5-7676-5c5f-8a80-b86d2dec0548" :knowledge-point/title "Creating an Exponential Decay Expression From a Decay Rate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c04ac1a-82ca-5e7d-960c-ce0d5428e163" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(11\\,000\\cdot 0.98)}^{10}" :db/id #edb/ref 17592186538261} {:answer/id #uuid "7270ac70-c515-5aab-a7ed-575aca39f8d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11\\,000\\cdot (0.98)^{10}" :db/id #edb/ref 17592186538491} {:answer/id #uuid "c506aa54-db09-523c-a6d5-40e5d1db4949" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11\\,{000}^{10}\\cdot 0.98" :db/id #edb/ref 17592186538689} {:answer/id #uuid "ef4db2b8-73eb-5c7d-a88b-f43140375b3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11\\,000+{0.98}^{10}" :db/id #edb/ref 17592186538776} {:answer/id #uuid "f4ca33f2-3d2b-5209-a730-c75645d73f9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11\\,{000}^{10}+{0.98}^{10}" :db/id #edb/ref 17592186538788}] :answer-field/correct {:answer/id #uuid "7270ac70-c515-5aab-a7ed-575aca39f8d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11\\,000\\cdot (0.98)^{10}" :db/id #edb/ref 17592186538491} :answer-field/id #uuid "7b4efd19-31d2-5e38-bf06-a602e93463a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538866}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3f3966bd-9f89-5978-a943-b86356ea0f72" :question/math-academy-id "q-63873" :question/problem "A park is estimated to have $11\\,000$ rabbits. If their population decreases by $2%$ every year, what will the population of rabbits be approximately in ten years?" :question/worked-solution "The number $2%$ (expressed as a decimal) is equal to $0.02.$ Therefore, a decrease of $2%$ corresponds to multiplication by a factor of:\n\n$$\n1-0.02=0.98\n$$\n\nTherefore:\n\n- After $1$ year, there will be $11\\,000\\cdot (0.98)$ rabbits.\n\n- After $2$ years, there will be approximately $11\\,000\\cdot (0.98)^{2}$ rabbits.\n\n- After $3$ years, there will be approximately $11\\,000\\cdot (0.98)^{3}$ rabbits.\n\n- $…$\n\nRepeating this pattern, we see that there will be approximately $11\\,000\\cdot (0.98)^{10}$ rabbits in $10$ years."}]}
