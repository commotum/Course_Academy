#{[{:db/id #edb/ref 17592186500376 :knowledge-point/_questions [{:db/id #edb/ref 17592186147415 :knowledge-point/id #uuid "40344731-b251-5ba9-8e05-775144455c95" :knowledge-point/title "Squaring a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41d5f79a-7cdd-5989-a575-2e2a2e47857b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{289}{16}" :db/id #edb/ref 17592186499777}] :answer-field/correct {:answer/id #uuid "41d5f79a-7cdd-5989-a575-2e2a2e47857b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{289}{16}" :db/id #edb/ref 17592186499777} :answer-field/id #uuid "d025d04b-35c6-550c-86ed-3b8dbfd3c675" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186500265}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f6918689-3a92-5cad-ac6b-0de2903bcad0" :question/math-academy-id "q-166811" :question/problem "Expressed as an improper fraction, the exact area of ​​each wall is$\\,${{field-1}}\n${\\text{m}}^{2}.$" :question/worked-solution "The exact area of  ​each wall is ${(\\frac{17}{4})}^{2}\\,{\\text{m}}^{2}.$\n\nWriting ${(\\frac{17}{4})}^{2}$ with multiplication signs, we get\n\n$$\n\\begin{aligned}{(\\frac{17}{4})}^{2} & ={{\\frac{17}{4}\\times \\frac{17}{4}}_{⏟}}_{2\\text{ times}} \\\\  & =\\frac{17\\times 17}{4\\times 4} \\\\  & =\\frac{289}{16}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{(\\frac{17}{4})}^{2}=\\frac{289}{16}.\n$$"}] [{:db/id #edb/ref 17592186500383 :knowledge-point/_questions [{:db/id #edb/ref 17592186054858 :knowledge-point/id #uuid "ef1ed47e-ac17-5e98-8f3c-ea15497f7ff7" :knowledge-point/title "Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e007f3b1-168c-589c-8cea-ade69fdb7fd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16.25" :db/id #edb/ref 17592186500118}] :answer-field/correct {:answer/id #uuid "e007f3b1-168c-589c-8cea-ade69fdb7fd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16.25" :db/id #edb/ref 17592186500118} :answer-field/id #uuid "0bb22797-4508-5dc5-b37f-a510cbbdc4f8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186500185}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ff821477-1720-563f-b73b-9b643857f797" :question/math-academy-id "q-166812" :question/problem "To improve the paint's grip on the wall surface, Mike must dissolve $6.5$ grams of a particular additive in each liter of paint. How much additive is needed if Mike plans to use $2.5$ liters of paint?\n\nExpressed as a decimal, Mike must dissolve$\\,$\n{{field-1}}\n$\\,$grams of additive in $2.5$ liters of paint." :question/worked-solution "To determine the amount of additive that Mike must dissolve in $2.5$ liters of paint, we must multiply $6.5$ by $2.5.$\n\nWe proceed by multiplying the two numbers just as we would with whole numbers.\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  &  & \\,\\,\\,\\,\\,\\begin{aligned}\\boxed{1} \\\\ \\boxed{2}\\end{aligned}\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{4}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  &  & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,.5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,.5\\,\\,\\,\\, \\\\  &  &  & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\,1\\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\,1\\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $1$ decimal place in $6.5$ and there is $1$ decimal place in $2.5.$\nTherefore, their product will have $1+1=2$ decimal places.\n\nSo, we take our value of $1625$ and add a decimal point to make a number with $2$ decimal places.\n\n$$\n16\\,\\overset{↓}{.}\\,\\,\\,{{25}_{⏟}}_{2\\text{ digits}}\n$$\n\nHence, $6.5\\times 2.5=16.25.$\n\nWe conclude that Mike must use $16.25$ grams of additive."}] [{:db/id #edb/ref 17592186500332 :knowledge-point/_questions [{:db/id #edb/ref 17592186138368 :knowledge-point/id #uuid "28d5aa07-8c26-5964-bb34-a500d8e0a9e9" :knowledge-point/title "Adding Numbers With One and Two Decimal Places"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "947b69ff-cffc-5c2b-8520-98f7dfd675ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.82" :db/id #edb/ref 17592186499944}] :answer-field/correct {:answer/id #uuid "947b69ff-cffc-5c2b-8520-98f7dfd675ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.82" :db/id #edb/ref 17592186499944} :answer-field/id #uuid "2f909fff-11ff-5d20-9b2f-e687e1ff76cf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186500203}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9d00a784-7b71-55f9-8814-6e64a549eeb5" :question/math-academy-id "q-166813" :question/problem "During the first day of painting, Mike uses $1.5$ liters of paint in the morning and $1.32$ liters in the afternoon. How much paint did Mike use that day?\n\nExpressed as a decimal,  Mike used$\\,$\n{{field-1}}\n$\\,$liters of paint." :question/worked-solution "To determine how much paint Mike used, we need to calculate the sum $1.5+1.32.$\n\nThere is $1$ decimal place in $1.5$ and $2$ decimal places in $1.32.$\n\nTo add the numbers, they both need to have the same number of decimals. Hence, we rewrite the first number so that it has $2$ decimal places:\n\n$$\n1.5=1.50\n$$\n\nNext, we line up the decimal points:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, \\\\  &  &  & \\,\\,\\,\\,.\\,\\,\\,\\, &  & \\end{aligned}\n$$\n\nFinally, we proceed by adding the two numbers just as we would with whole numbers:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\,\\begin{aligned} \\\\ \\end{aligned}\\,\\,\\,\\, &  &  \\\\  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\,\\end{aligned}\n$$\n\nTherefore, Mike used $2.82$ liters of paint."}] [{:db/id #edb/ref 17592186500292 :knowledge-point/_questions [{:db/id #edb/ref 17592186054862 :knowledge-point/id #uuid "f5d09700-00bd-5c67-93cf-f99c574732d7" :knowledge-point/title "Subtracting Decimals: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2922c2b-c90a-5c1a-9164-bc221a99c879" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.96" :db/id #edb/ref 17592186500010}] :answer-field/correct {:answer/id #uuid "b2922c2b-c90a-5c1a-9164-bc221a99c879" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.96" :db/id #edb/ref 17592186500010} :answer-field/id #uuid "15294031-e669-5c62-8748-549d11c4708e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186500192}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1da853e5-1005-5ae3-a2f4-0c314ac52689" :question/math-academy-id "q-166814" :question/problem "All the paint used on Mike's first day came from one can containing $3.78$ liters of paint. How much paint was left in the can after Mike's first day? Express your answer as a decimal.\n\nThere are\n{{field-1}}\nliters of paint were left over." :question/worked-solution "From part 3, we know that Mike has used $2.82$ liters from the first can of paint.\n\nTo determine the amount of paint left in the first can, we need to calculate $3.78-2.82.$\n\nFirst, we line up the decimal points:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\ \\,\\,\\,\\,-\\,\\,\\,\\, &  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, \\\\  &  &  & \\,\\,\\,\\,.\\,\\,\\,\\, &  & \\end{aligned}\n$$\n\nNext, we proceed by subtracting the two numbers just as we would with whole numbers:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\,\\,\\begin{aligned} \\\\ 2\\end{aligned}\\,\\,\\,\\, &  & \\,\\,\\,\\,\\,\\begin{aligned} \\\\ 17\\end{aligned}\\,\\,\\,\\, &  \\\\  &  & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\ \\,\\,\\,\\,-\\,\\,\\,\\, &  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\,\\end{aligned}\n$$\n\nTherefore, $0.96$ liters of paint were left over."}] [{:db/id #edb/ref 17592186500288 :knowledge-point/_questions [{:db/id #edb/ref 17592186073705 :knowledge-point/id #uuid "cb42b265-bcf6-58ef-aa08-489dec5d1104" :knowledge-point/title "Converting the Result to a Mixed Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93939cfc-7735-587d-9f9b-25710f4c3ff2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\frac{1}{2}" :db/id #edb/ref 17592186499943}] :answer-field/correct {:answer/id #uuid "93939cfc-7735-587d-9f9b-25710f4c3ff2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\frac{1}{2}" :db/id #edb/ref 17592186499943} :answer-field/id #uuid "98b040f0-50eb-5875-a15e-8411bb429f3c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186500241}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "17da2d52-c4a5-548d-8d46-a96ea5055bec" :question/math-academy-id "q-166815" :question/problem "To complete his work, Mike has $4\\,\\frac{4}{5}$ liters of paint. Of this amount, he uses $3\\,\\frac{3}{10}$ liters. How much paint did Mike have left over when he finished? Express your answer as a mixed number in its lowest terms.\n\nMike had$\\,$\n{{field-1}}\n$\\,$liters of paint left." :question/worked-solution "After finishing, Mike had $(4\\,\\frac{4}{5}-3\\,\\frac{3}{10})$ liters of paint left.\n\nWriting $4\\,\\frac{4}{5}$ as an improper fraction, we have\n\n$$\n4\\,\\frac{4}{5}=\\frac{4\\times 5+4}{5}=\\frac{24}{5}.\n$$\n\nWriting $3\\,\\frac{3}{10}$ as an improper fraction, we have\n\n$$\n3\\,\\frac{3}{10}=\\frac{3\\times 10+3}{10}=\\frac{33}{10}.\n$$\n\nTherefore, our problem now is to work out the following:\n\n$$\n\\frac{24}{5}-\\frac{33}{10}\n$$\n\nTo subtract two fractions with unlike denominators, we need to express each fraction as an equivalent fraction with a common denominator.\n\nIn this question, we can make a common denominator of $10.$\n\nTo put $\\frac{24}{5}$ over a denominator of $10,$ we multiply the numerator and denominator by $2:$\n\n$$\n\\frac{24}{5}=\\frac{24\\times 2}{5\\times 2}=\\frac{48}{10}\n$$\n\nWe can now subtract the fractions. We keep the denominator the same, and we subtract the numerators:\n\n$$\n\\frac{48}{10}-\\frac{33}{10}=\\frac{15}{10}\n$$\n\nSimplifying, we have\n\n$$\n\\frac{15}{10}=\\frac{15÷5}{10÷5}=\\frac{3}{2}.\n$$\n\nFinally, we convert back to a mixed number:\n\n$$\n\\frac{3}{2}=1\\,\\text{R}\\,1=1\\,\\frac{1}{2}\n$$\n\nTherefore, Mike had $1\\,\\frac{1}{2}$ liters of paint left."}] [{:db/id #edb/ref 17592186500333 :knowledge-point/_questions [{:db/id #edb/ref 17592186073676 :knowledge-point/id #uuid "e27e3a75-779a-5817-a2ae-27b58cbac913" :knowledge-point/title "Rounding to the Nearest Whole Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f71d0525-5c1a-5770-b1cf-5cb7a58670d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186500164}] :answer-field/correct {:answer/id #uuid "f71d0525-5c1a-5770-b1cf-5cb7a58670d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186500164} :answer-field/id #uuid "76af0406-4163-5088-bfc0-7205edc129df" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186500229}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a137dddd-e843-51d0-beae-620ba6ee763a" :question/math-academy-id "q-166816" :question/problem "To complete another job, Mike bought $4$ identical cans of paint, paying a total of $$95.64.$ Estimate the price of each can of paint by rounding the amount of money to the nearest dollar.\n\nThe approximate price of each can of paint is $\n{{field-1}}." :question/worked-solution "To estimate the price of each can of paint, we need to find an approximation for $95.64÷4.$\n\nSo, we round the dividend to the nearest whole number:\n\n$$\n95.64\\to 96\n$$\n\nNow, we divide $96$ by $4$ as usual:\n\n$$\n96÷4=24\n$$\n\nTherefore, the approximate price of each can of paint is $$24.$"}]}
