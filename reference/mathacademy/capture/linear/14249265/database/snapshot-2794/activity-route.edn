#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186567128} :activity/id #uuid "87d8762a-b78f-5957-a3f1-b99d2f2a0beb" :activity/scope {:db/id #edb/ref 17592186050429 :topic/id #uuid "486a09f3-45ae-5574-b216-0a329beb1dea" :topic/math-academy-id 757} :activity/steps [{:db/id #edb/ref 17592186567128 :step/content {:db/id #edb/ref 17592186269103 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1482f361-3b1e-543f-870b-a26dcf92d2ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186266319} {:answer/id #uuid "2870d2f6-a4e4-5d62-a218-0e3e5a8a8827" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186266504} {:answer/id #uuid "447ea00c-4d69-5351-8ae6-7fb524a5e59a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186266757} {:answer/id #uuid "ab240971-126a-51ed-95e8-caf2152e97e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186267690} {:answer/id #uuid "fda09780-5082-5dc7-9e43-74a04e529440" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186268378}] :answer-field/correct {:db/id #edb/ref 17592186268378} :answer-field/id #uuid "466acc84-20e7-58f4-bf70-73eea0fa85ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268526}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "54404730-020a-547b-8cd2-8751476ed4d0" :question/math-academy-id "q-13613" :question/problem "According to the rational roots theorem, which of the following **cannot** be a root of the polynomial $f(x)=3{x}^{3}+10{x}^{2}-23x+10?$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $10$ and the leading coefficient is $3.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }10}{\\text{factor of }3}.\n$$\n\nOf the given answer choices, only $3$ does not take the above form. The value $3$ can be interpreted as a fraction $\\frac{3}{1},$ and the numerator $(3)$ is not a factor of $10.$"} :step/id #uuid "55b7f72e-b0f4-574a-91f9-2bad8d33b8cf" :step/next {:db/id #edb/ref 17592186567145}} {:db/id #edb/ref 17592186567132 :step/content {:db/id #edb/ref 17592186233159 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "116a1c0a-8d8a-52c5-bb0e-aebac47230dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186566398} {:answer/id #uuid "14307e29-051b-5457-8ef8-81f93128ec5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186566402} {:answer/id #uuid "6cfaab4f-47b7-5613-8a23-80f4bfed322c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186566566} {:answer/id #uuid "d5e6e60c-4f38-527c-836e-9de6357722e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186566789} {:answer/id #uuid "fd1e7e16-6655-59d1-a541-e0286346607d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186566870}] :answer-field/correct {:db/id #edb/ref 17592186566789} :answer-field/id #uuid "707261a6-3005-5fdd-8637-a87bd78e3dff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566930}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2e699eb5-f71e-5205-9046-7d6b4f7a426f" :question/math-academy-id "q-112878" :question/problem "According to the rational roots theorem, which of the following **cannot** be a root of the polynomial $f(x)={x}^{5}-5{x}^{3}+6?$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $6$ and the leading coefficient is $1.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }6}{\\text{factor of }1}.\n$$\n\nOf the given answer choices, only $4$ does not take the above form. The value $4$ can be interpreted as a fraction $\\frac{4}{1},$ and the numerator $(4)$ is not a factor of $6.$"} :step/id #uuid "763d9828-9fd6-53f4-89e5-bbdd76715afd"} {:db/id #edb/ref 17592186567145 :step/content {:db/id #edb/ref 17592186234452 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19199503-6a7e-5f9f-a197-b117e0b7750b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186433638} {:answer/id #uuid "b9344a36-f4c2-5ee5-8b24-5bc73e0761f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186433652} {:answer/id #uuid "bd738110-2730-510b-a6fe-9f8c39d2690d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186433653} {:answer/id #uuid "d02dc8b0-f719-5d72-b3c5-684102a1c360" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186433657} {:answer/id #uuid "e264283e-cf89-55ac-b653-81b2eaae1082" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186433661}] :answer-field/correct {:db/id #edb/ref 17592186433652} :answer-field/id #uuid "479e5fb2-a0db-5547-90a9-3251c9634117" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186433666}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "38a31983-df9c-53f1-81ab-91f00755216b" :question/math-academy-id "q-83863" :question/problem "Given that the polynomial $f(x)={x}^{3}+{x}^{2}-10x+8$ has one of its roots in the interval $(-5,-1),$ find the sum of the distinct real roots of $f(x).$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $8$ and the leading coefficient is $1.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }8}{\\text{factor of }1}.\n$$\n\nTherefore, the possible rational roots are as follows:\n\n$$\n\\pm 1,\\pm 2,\\pm 4,\\pm 8\n$$\n\nOf these roots, the only roots in the interval $(-5,-1),$ are $-4$ and $-2.$\n\nNow, let's use synthetic division to test whether $(x+4)$ is a factor of $f(x).$ We get the following:\n\n|  | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- |\n| $-4$ | $1$ | $1$ | $-10$ | $8$ |\n|  | $↓$ | $-4$ | $12$ | $-8$ |\n|  | $1$ | $-3$ | $2$ | $0$ |\n\nSince the highest-degree factor is now a quadratic, we can continue factoring using the usual methods:\n\n$$\n\\begin{aligned}f(x) & =(x+4)({x}^{2}-3x+2) \\\\  & =(x+4)(x-1)(x-2)\\end{aligned}\n$$\n\nSetting the factors equal to $0,$ we find the roots $x=-4,1,2.$ Summing these roots, we get\n\n$$\n-4+1+2=-1.\n$$"} :step/id #uuid "c6ee5914-160c-5b72-9798-5fee5e47a2e6" :step/next {:db/id #edb/ref 17592186567132}}] :activity/title "The Rational Roots Theorem" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186566355}]}
