#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186153033} :activity/id #uuid "e1e5c1d4-ae13-5c28-8065-9304d1a284b4" :activity/scope {:db/id #edb/ref 17592186049405 :topic/id #uuid "f1d3d82f-ded9-5313-ae8c-e1f0314a651b" :topic/math-academy-id 2553} :activity/steps [{:db/id #edb/ref 17592186153033 :step/content {:db/id #edb/ref 17592186153438 :tutorial/content "Two variables, $x$ and $y,$ are said to have a **proportional relationship** if their ratio is constant. That is, for any $(x,y)$ pair, we have\n\n$$\nk = \\dfrac{y}{x}\n$$\n\nwhere $k$ is a fixed number called the **constant of proportionality** or **constant of variation.**\n\nAs a concrete example, let's consider the table below. \n\n| $x$ | $y$ |\n| --- | --- |\n| $1$ | $2$ |\n| $2$ | $4$ |\n| $4$ | $8$ |\n\nDo $x$ and $y$ have a proportional relationship?\n\nTo determine whether $x$ and $y$ have a proportional relationship, we first add a new $\\dfrac yx$ column:\n\n| $x$ | $y$ | $\\dfrac{y}{x}$ |\n| --- | --- | --- |\n| $1$ | $2$ |  |\n| $2$ | $4$ |  |\n| $4$ | $8$ |  |\n\nNext, we compute $\\dfrac yx$ for each row:\n\n| $x$ | $y$ | $\\dfrac{y}{x}$ |\n| --- | --- | --- |\n| $1$ | $2$ | $2\\div 1 = {\\color{blue}{2}}$ |\n| $2$ | $4$ | $4\\div 2 = {\\color{blue}{2}}$ |\n| $4$ | $8$ | $8\\div 4 = {\\color{blue}{2}}$ |\n\nSince all the entries in the third column have the same value, this table does indeed represent a proportional relationship. In this case, the constant of proportionality $k = {\\color{blue}{2}}.$" :tutorial/id #uuid "935405f7-2fd3-5fb6-a9ef-e3d74aa721b6" :tutorial/math-academy-id 8207 :tutorial/title "Introduction"} :step/id #uuid "8723b6ec-51b3-591f-8a78-8d66a882e2c0" :step/math-academy-id 186936 :step/next {:db/id #edb/ref 17592186153034}} {:db/id #edb/ref 17592186153034 :step/content {:db/id #edb/ref 17592186152142 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151827 :question/id #uuid "5676578d-255c-51e8-a64f-60e273dabb90" :question/math-academy-id "e-13125"} :knowledge-point/id #uuid "2f15be3c-52df-59c0-82a7-d48736082795" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050138}] :knowledge-point/questions [{:db/id #edb/ref 17592186152520} {:db/id #edb/ref 17592186152668} {:db/id #edb/ref 17592186497368} {:db/id #edb/ref 17592186497381} {:db/id #edb/ref 17592186497409}] :knowledge-point/title "Computing a Constant of Proportionality"} :step/id #uuid "86063632-706f-5896-a287-131371bbfac1" :step/math-academy-id 186937 :step/next {:db/id #edb/ref 17592186153035}} {:db/id #edb/ref 17592186153035 :step/content {:db/id #edb/ref 17592186152143 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151828 :question/id #uuid "6bbbe009-2488-5442-83e9-98606ca5e78b" :question/math-academy-id "e-13126"} :knowledge-point/id #uuid "a19a2e0a-2271-567a-bd59-12ccbac62ba5" :knowledge-point/questions [{:db/id #edb/ref 17592186152662} {:db/id #edb/ref 17592186152669} {:db/id #edb/ref 17592186497328}] :knowledge-point/title "Determining Whether a Table Represents a Proportional Relationship"} :step/id #uuid "174d042b-40fb-57f2-912b-20fe1548d308" :step/math-academy-id 186940 :step/next {:db/id #edb/ref 17592186153036}} {:db/id #edb/ref 17592186153036 :step/content {:db/id #edb/ref 17592186153439 :tutorial/content "When the variables $x$ and $y$ form a proportional relationship, the ratio of any $(x,y)$ pair is constant:\n\n$$\n\\dfrac y x = k\n$$\n\nUsing the relationship between multiplication and division, we can rewrite this equation above as follows:\n\n$$\ny = kx\n$$" :tutorial/id #uuid "d635aed4-07fa-5ffc-a25c-f9d760dbed7f" :tutorial/math-academy-id 8208 :tutorial/title "Finding the Equation of a Proportional Relationship"} :step/id #uuid "387c9c18-edb6-507f-8ae3-d5a4d7a375b6" :step/math-academy-id 186944 :step/next {:db/id #edb/ref 17592186153037}} {:db/id #edb/ref 17592186153037 :step/content {:db/id #edb/ref 17592186152144 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151829 :question/id #uuid "1c57db95-1fdb-5ea4-894e-0f137b3ef795" :question/math-academy-id "e-13127"} :knowledge-point/id #uuid "48d2a1f5-e39d-523c-81ed-09426a8045f0" :knowledge-point/questions [{:db/id #edb/ref 17592186152521} {:db/id #edb/ref 17592186152522} {:db/id #edb/ref 17592186497383}] :knowledge-point/title "Finding a Proportional Relationship Equation"} :step/id #uuid "4a43a0a6-a976-52ad-b7ac-89aca2144fe1" :step/math-academy-id 186945 :step/next {:db/id #edb/ref 17592186153038}} {:db/id #edb/ref 17592186153038 :step/content {:db/id #edb/ref 17592186152145 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151830 :question/id #uuid "198d2eae-92a5-57bd-a165-eae20c9a7078" :question/math-academy-id "e-13128"} :knowledge-point/id #uuid "bea5c8e3-3a8e-58a6-b289-84137c2b60cf" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050127} {:db/id #edb/ref 17592186050195} {:db/id #edb/ref 17592186050599}] :knowledge-point/questions [{:db/id #edb/ref 17592186152663} {:db/id #edb/ref 17592186152869} {:db/id #edb/ref 17592186497331} {:db/id #edb/ref 17592186497349} {:db/id #edb/ref 17592186497374}] :knowledge-point/title "Interpreting Data From Proportional Relationships"} :step/id #uuid "faaa86eb-acf9-5373-90c9-af1a462a10aa" :step/math-academy-id 186948}] :activity/title "Understanding Proportional Relationships Using Tables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186152311}]}
