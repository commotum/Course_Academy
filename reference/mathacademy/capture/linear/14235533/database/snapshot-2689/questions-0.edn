#{[{:db/id #edb/ref 17592186555844 :knowledge-point/_questions [{:db/id #edb/ref 17592186110782 :knowledge-point/id #uuid "c9f0fffa-aef8-5f2e-af1b-32d67dd954a1" :knowledge-point/title "Finding the Measure of a Diagonal of a Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cd64979-6e41-5feb-9763-12b70161a8db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,m" :db/id #edb/ref 17592186555099} {:answer/id #uuid "73e7f063-2389-5ce2-b5d8-4354922bf5d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,m" :db/id #edb/ref 17592186555261} {:answer/id #uuid "768762c7-e409-5b41-8927-e05be0bd5283" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7.5\\,m" :db/id #edb/ref 17592186555271} {:answer/id #uuid "d3dddf3d-1092-572e-9d02-c926c7039d94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,m" :db/id #edb/ref 17592186555501} {:answer/id #uuid "fafaa12b-38a2-5687-86e2-c0e87e67bbb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,m" :db/id #edb/ref 17592186555619}] :answer-field/correct {:answer/id #uuid "fafaa12b-38a2-5687-86e2-c0e87e67bbb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,m" :db/id #edb/ref 17592186555619} :answer-field/id #uuid "5786cd11-3148-5ae6-b45b-9cd70b618e71" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555679}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a8ecca8c-4ba9-51a9-9a23-0b141e2831c4" :question/math-academy-id "q-129308" :question/problem "![](images/c8/c897e2e9b209470f24964b5c00d4e79e4f056a2cbcab4e1e1a1651e949291537.png)\n\nIn a square above, $PO=2.5\\,m.$ Find $QS.$" :question/worked-solution "The diagonals of a square are equal and bisect each other. So we have\n\n$$\n\\begin{aligned}QS & =PR \\\\  & =2PO \\\\  & =2\\cdot 2.5\\,m \\\\  & =5\\,m.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186555824 :knowledge-point/_questions [{:db/id #edb/ref 17592186110783 :knowledge-point/id #uuid "0730375d-ba61-5f0a-85f3-23c9535f7a38" :knowledge-point/title "Finding the Value of a Variable That Makes a Given Quadrilateral a Rectangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46724bfe-a2b9-5992-bb9e-b42ddd06cc26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186555151} {:answer/id #uuid "4a0dcc81-1ecd-57bc-9357-ff2f778c95e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186555159} {:answer/id #uuid "4d248db1-d0cc-5479-b350-a7ff11f897d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186555172} {:answer/id #uuid "64df6060-c12a-5501-9bc1-f7cebcffdda2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186555228} {:answer/id #uuid "d9659e3b-cc3b-57e6-9d57-cf48990885e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186555526}] :answer-field/correct {:answer/id #uuid "d9659e3b-cc3b-57e6-9d57-cf48990885e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186555526} :answer-field/id #uuid "2fe3cb9b-6905-5041-9d17-a4bc0c8f8821" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555661}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7693917f-3fc9-5b3a-9850-3e604834da65" :question/math-academy-id "q-129313" :question/problem "![](images/b6/b68ede517afc0d8fd6ce6a110ed261a805a3218d6afee3caaed88c73d6e3763e.png)\n\nFor which value of $t$ is the rectangle above also a square?" :question/worked-solution "If $PQRS$ is a square, then $m∠RSQ={45}^{∘}.$ Now,  we have\n\n$$\n\\begin{aligned}m∠RSQ & ={45}^{∘} \\\\ (6t+3)^{∘} & ={45}^{∘} \\\\ 6t & =42 \\\\ t & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186111289 :knowledge-point/_questions [{:db/id #edb/ref 17592186110781 :knowledge-point/id #uuid "6ff69d0d-cc28-5528-be82-d874fbecb064" :knowledge-point/title "Finding the Measures of the Sides of a Rectangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45862696-e078-5e44-908a-932757756e30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,cm" :db/id #edb/ref 17592186555148} {:answer/id #uuid "819ae118-95dd-5f4e-9632-632e6a720f7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,cm" :db/id #edb/ref 17592186555298} {:answer/id #uuid "8ef276f9-82e0-540a-a7aa-3df3cd37ef1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,cm" :db/id #edb/ref 17592186555334} {:answer/id #uuid "8fefaa4b-1f74-555a-813d-ef2559bd86ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,cm" :db/id #edb/ref 17592186555338} {:answer/id #uuid "e06896fa-1962-56fe-8a72-6a43c2652c9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\,cm" :db/id #edb/ref 17592186555549}] :answer-field/correct {:answer/id #uuid "8ef276f9-82e0-540a-a7aa-3df3cd37ef1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,cm" :db/id #edb/ref 17592186555334} :answer-field/id #uuid "70684b2a-2966-5011-9ad1-15416961e171" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186109459}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5f784438-719a-5234-978d-6979ac003590" :question/math-academy-id "q-53290" :question/problem "![](images/27/2772e28367d49fcf0e2503b7cdd5d5aae5ea217b7060b288f9fb6e149ee25f57.png)\n\nThe perimeter of the rectangle $LMNP$ above equals $22\\,cm.$ What is the length of $\\overset{―}{NP}?$" :question/worked-solution "The opposite sides of a rectangle are congruent, so we have\n\n$$\nPL=MN=3\\,cm.\n$$\n\nFor the same reason, we also have\n\n$$\nNP=LM.\n$$\n\nNow, since the perimeter is $p=22\\,\\text{cm},$ we have\n\n$$\n\\begin{aligned}p & =LM+MN+NP+PL \\\\ 22 & =2NP+2PL \\\\ 22 & =2NP+6 \\\\ 16 & =2NP \\\\ 8 & =NP\\,.\\end{aligned}\n$$\n\nTherefore, $NP=8\\,\\text{cm}.$"}] [{:db/id #edb/ref 17592186111291 :knowledge-point/_questions [{:db/id #edb/ref 17592186110783 :knowledge-point/id #uuid "0730375d-ba61-5f0a-85f3-23c9535f7a38" :knowledge-point/title "Finding the Value of a Variable That Makes a Given Quadrilateral a Rectangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "802ce892-3795-5858-93b0-3483a3ab3c4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186109472} {:answer/id #uuid "2d085668-9fc8-5018-b051-ab45c9ca5356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186109473} {:answer/id #uuid "65184fef-41f3-533e-93f5-330c6ccf3c4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186109474} {:answer/id #uuid "6aaecefa-6e02-5806-9d28-933be0d3c237" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186109475} {:answer/id #uuid "6e0e3187-2629-50a2-a77c-48119ce4aded" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186109476}] :answer-field/correct {:answer/id #uuid "6aaecefa-6e02-5806-9d28-933be0d3c237" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186109475} :answer-field/id #uuid "52aa9f7d-e45e-5b08-8e15-ff4b08960ac1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186109471}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3b8f0d65-4e71-5ab1-a60d-763912ae5001" :question/math-academy-id "q-53299" :question/problem "![](images/1d/1d66d31fed706f880a9795b54111d66498151f9b4406b6d7a48e11dfff3a1eeb.png)\n\nFor which value of $t$ is the rectangle above also a square?" :question/worked-solution "If $PQRS$ is a square, then $m∠QSP={45}^{∘}.$ Now,  we have\n\n$$\n\\begin{aligned}m∠QSP & ={45}^{∘} \\\\ (2t+7)^{∘} & ={45}^{∘} \\\\ 2t & =38 \\\\ t & =19.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186111292 :knowledge-point/_questions [{:db/id #edb/ref 17592186110782 :knowledge-point/id #uuid "c9f0fffa-aef8-5f2e-af1b-32d67dd954a1" :knowledge-point/title "Finding the Measure of a Diagonal of a Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86375367-a91a-58af-b9b9-c25b2769c970" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,mm" :db/id #edb/ref 17592186555311} {:answer/id #uuid "8e69bf76-adcd-5423-bdf5-ebc4e9bca2fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,mm" :db/id #edb/ref 17592186555332} {:answer/id #uuid "a612b194-ad13-5f18-8c42-e680666dd5f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,mm" :db/id #edb/ref 17592186555397} {:answer/id #uuid "ab0051b0-2deb-5281-b8f1-683298088071" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,mm" :db/id #edb/ref 17592186555410} {:answer/id #uuid "fb5ccb6f-35e3-5aaa-9b9d-aa15fc253253" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15\\,mm" :db/id #edb/ref 17592186555621}] :answer-field/correct {:answer/id #uuid "86375367-a91a-58af-b9b9-c25b2769c970" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,mm" :db/id #edb/ref 17592186555311} :answer-field/id #uuid "c4a5a188-41a4-5b12-930f-0356e9394e0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186109477}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "edf030ed-b6b9-5315-a9c6-c9ad7d40039b" :question/math-academy-id "q-53300" :question/problem "![](images/5b/5b2ade26c577b7362460f55397024e3b321a54d769fe1c412f79f38b17f40806.png)\n\nIn a square above, $PO=5\\,mm.$ Find $QS.$" :question/worked-solution "The diagonals of a square are equal and bisect each other. So we have\n\n$$\n\\begin{aligned}QS & =PR \\\\  & =2PO \\\\  & =2\\cdot 5\\,mm \\\\  & =10\\,mm.\\end{aligned}\n$$"}]}
