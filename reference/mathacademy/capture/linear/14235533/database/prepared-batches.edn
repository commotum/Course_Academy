[{"source" ":org/Math-Academy" "forms" [[:db/retract 17592186109459 :answer-field/choices 17592186109460] [:db/retract 17592186109459 :answer-field/choices 17592186109461] [:db/retract 17592186109459 :answer-field/choices 17592186109462] [:db/retract 17592186109459 :answer-field/choices 17592186109463] [:db/retract 17592186109459 :answer-field/choices 17592186109464] [:db/retract 17592186109477 :answer-field/choices 17592186109478] [:db/retract 17592186109477 :answer-field/choices 17592186109479] [:db/retract 17592186109477 :answer-field/choices 17592186109480] [:db/retract 17592186109477 :answer-field/choices 17592186109481] [:db/retract 17592186109477 :answer-field/choices 17592186109482] {:db/id 17592186111289 :question/problem "![](images/27/2772e28367d49fcf0e2503b7cdd5d5aae5ea217b7060b288f9fb6e149ee25f57.png)\n\nThe perimeter of the rectangle $LMNP$ above equals $22\\,cm.$ What is the length of $\\overset{―}{NP}?$" :question/worked-solution "The opposite sides of a rectangle are congruent, so we have\n\n$$\nPL=MN=3\\,cm.\n$$\n\nFor the same reason, we also have\n\n$$\nNP=LM.\n$$\n\nNow, since the perimeter is $p=22\\,\\text{cm},$ we have\n\n$$\n\\begin{aligned}p & =LM+MN+NP+PL \\\\ 22 & =2NP+2PL \\\\ 22 & =2NP+6 \\\\ 16 & =2NP \\\\ 8 & =NP\\,.\\end{aligned}\n$$\n\nTherefore, $NP=8\\,\\text{cm}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186109459 :answer-field/correct "answer-8ef276f9-82e0-540a-a7aa-3df3cd37ef1d" :answer-field/choices ["answer-45862696-e078-5e44-908a-932757756e30" "answer-819ae118-95dd-5f4e-9632-632e6a720f7e" "answer-8fefaa4b-1f74-555a-813d-ef2559bd86ef" "answer-8ef276f9-82e0-540a-a7aa-3df3cd37ef1d" "answer-e06896fa-1962-56fe-8a72-6a43c2652c9c"] :db/ensure [:answer-field/validate]} {:db/id "answer-45862696-e078-5e44-908a-932757756e30" :answer/id #uuid "45862696-e078-5e44-908a-932757756e30" :answer/type :answer.type/math :answer/value "10\\,cm" :db/ensure [:answer/validate]} {:db/id "answer-819ae118-95dd-5f4e-9632-632e6a720f7e" :answer/id #uuid "819ae118-95dd-5f4e-9632-632e6a720f7e" :answer/type :answer.type/math :answer/value "6\\,cm" :db/ensure [:answer/validate]} {:db/id "answer-8fefaa4b-1f74-555a-813d-ef2559bd86ef" :answer/id #uuid "8fefaa4b-1f74-555a-813d-ef2559bd86ef" :answer/type :answer.type/math :answer/value "7\\,cm" :db/ensure [:answer/validate]} {:db/id "answer-8ef276f9-82e0-540a-a7aa-3df3cd37ef1d" :answer/id #uuid "8ef276f9-82e0-540a-a7aa-3df3cd37ef1d" :answer/type :answer.type/math :answer/value "8\\,cm" :db/ensure [:answer/validate]} {:db/id "answer-e06896fa-1962-56fe-8a72-6a43c2652c9c" :answer/id #uuid "e06896fa-1962-56fe-8a72-6a43c2652c9c" :answer/type :answer.type/math :answer/value "9\\,cm" :db/ensure [:answer/validate]} {:db/id 17592186110783 :knowledge-point/questions ["question-7693917f-3fc9-5b3a-9850-3e604834da65"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186111291 :question/worked-solution "If $PQRS$ is a square, then $m∠QSP={45}^{∘}.$ Now,  we have\n\n$$\n\\begin{aligned}m∠QSP & ={45}^{∘} \\\\ (2t+7)^{∘} & ={45}^{∘} \\\\ 2t & =38 \\\\ t & =19.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186109471 :answer-field/correct 17592186109475 :db/ensure [:answer-field/validate]} {:db/id 17592186110782 :knowledge-point/questions ["question-a8ecca8c-4ba9-51a9-9a23-0b141e2831c4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186111292 :question/problem "![](images/5b/5b2ade26c577b7362460f55397024e3b321a54d769fe1c412f79f38b17f40806.png)\n\nIn a square above, $PO=5\\,mm.$ Find $QS.$" :question/worked-solution "The diagonals of a square are equal and bisect each other. So we have\n\n$$\n\\begin{aligned}QS & =PR \\\\  & =2PO \\\\  & =2\\cdot 5\\,mm \\\\  & =10\\,mm.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186109477 :answer-field/correct "answer-86375367-a91a-58af-b9b9-c25b2769c970" :answer-f