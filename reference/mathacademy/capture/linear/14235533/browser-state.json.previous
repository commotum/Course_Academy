+</mo><mi>N</mi><mi>P</mi><mo>+</mo><mi>P</mi><mi>L</mi></mtd></mtr><mtr><mtd><mn>22</mn></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><mi>N</mi><mi>P</mi><mo>+</mo><mn>2</mn><mi>P</mi><mi>L</mi></mtd></mtr><mtr><mtd><mn>22</mn></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><mi>N</mi><mi>P</mi><mo>+</mo><mn>6</mn></mtd></mtr><mtr><mtd><mn>16</mn></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><mi>N</mi><mi>P</mi></mtd></mtr><mtr><mtd><mn>8</mn></mtd><mtd><mi></mi><mo>=</mo><mi>N</mi><mi>P</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Therefore, <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"12\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D441 TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D443 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c38\"></mjx-c></mjx-mn><mjx-mstyle><mjx-mspace style=\"width: 0.167em;\"></mjx-mspace></mjx-mstyle><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c63\"></mjx-c><mjx-c class=\"mjx-c6D\"></mjx-c></mjx-mtext><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>N</mi><mi>P</mi><mo>=</mo><mn>8</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>cm</mtext><mo>.</mo></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
