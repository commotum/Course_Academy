#{[{:activity/first-step {:db/id #edb/ref 17592186079531} :activity/id #uuid "2828ce66-5563-59d5-8c3e-194de1b4bc11" :activity/scope {:db/id #edb/ref 17592186048760 :topic/id #uuid "bc360b9e-12dd-5337-833b-984ed3eed6ff" :topic/math-academy-id 651} :activity/steps [{:db/id #edb/ref 17592186079531 :step/content {:db/id #edb/ref 17592186079717 :tutorial/content "Whenever we have a fraction in an equation, we apply the multiplication principle to get rid of it. For example, consider the equation below:\n\n$$\n\\dfrac{2x+12}{3} =6\n$$\n\nSince the opposite of dividing by $3$ is multiplying by $3$, we apply the multiplication principle and multiply both sides of the equation by $3$:\n\n$$\n\\require{cancel} \\begin{aligned} \\dfrac{2x+12}{3} &=6 \\\\ 3 \\cdot \\left(\\dfrac{2x+12}{3}\\right) &= 3 \\cdot 6\\ \\cancel{3} \\cdot \\left(\\dfrac{2x+12}{\\cancel{3}}\\right) &= 18 \\\\ 2x+12 &= 18 \\end{aligned}\n$$\n\nThe process of removing the fraction is called **clearing the rational expression**. We now have an equation that we can solve using the usual methods:\n\n$$\n\\begin{aligned} 2x+12 &= 18 \\\\ 2x+12-12 &=18-12 \\\\ 2x &=6 \\ \\dfrac{2x}{2} &=\\dfrac{6}{2} \\\\ x &=3 \\end{aligned}\n$$" :tutorial/id #uuid "addac451-9882-5c9f-8aa9-adc3fbd177e6" :tutorial/math-academy-id 8050 :tutorial/title "Introduction"} :step/id #uuid "354b4bf1-8360-5dc0-abda-b916470adda6" :step/math-academy-id 52855 :step/next {:db/id #edb/ref 17592186079532}} {:db/id #edb/ref 17592186079532 :step/content {:db/id #edb/ref 17592186078577 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078164 :question/id #uuid "7adb1612-0903-5a50-b5cd-75ebf1d0dd4a" :question/math-academy-id "e-12854"} :knowledge-point/id #uuid "d21b4ce3-d80e-5894-92ce-668e64d91649" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673}] :knowledge-point/questions [{:db/id #edb/ref 17592186078865} {:db/id #edb/ref 17592186078915}] :knowledge-point/title "Clearing a Rational Expression With a Variable on On