#{[{:db/id #edb/ref 17592186059465 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059637 :knowledge-point/id #uuid "4cc0e4fc-64ca-5c1b-abbe-357e930af7a4" :knowledge-point/title "Relating the Length of the Hypotenuse to the Length Of the Shortest Side"}] :question/id #uuid "b5f19406-37c2-569e-9c9e-b99e00234f91" :question/math-academy-id "e-3084" :question/problem "What is the length of the hypotenuse in a $30^\\circ$-$60^\\circ$-$90^\\circ$ triangle if the side opposite the $30^\\circ$ angle has a length of $6\\,\\textrm{cm}$?" :question/worked-solution "Let's refer to our standard $30^\\circ$-$60^\\circ$-$90^\\circ$ triangle.\n\n![](images/5f/5fe1cd7975f1537bead1f9560816dafe5e8f3ec0db3e683e2bd3e00c4ac54506.png)\n\nIn any $30^\\circ$-$60^\\circ$-$90^\\circ$ triangle, the hypotenuse is twice the length of the shorter leg.\n\nThe leg opposite the $30^\\circ$ angle is the shorter leg of the triangle. So here, the shorter leg has length\n\n$$\nx=6\\, \\text{cm}\n$$\n\nSo here, the length of the hypotenuse must be\n\n$$\n2 \\cdot 6 = 12\\,\\textrm{cm}\n$$"}] [{:db/id #edb/ref 17592186059467 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059639 :knowledge-point/id #uuid "26db86bd-122c-5d1b-9684-9444897d1c44" :knowledge-point/title "Relating the Length of the Shorter Leg to the Length of the Longer Leg"}] :question/id #uuid "f399fe29-f767-5ea5-bc2b-0d47c0e8fbaf" :question/math-academy-id "e-3086" :question/problem "In the triangle below, what is the length of the shorter leg?\n\n![](images/ae/aeb29243195210194a1f114fdf5146bcbd418180c957d5a1c88c3f1055a5c5c9.png)" :question/worked-solution "Let's refer to our standard $30^\\circ$-$60^\\circ$-$90^\\circ$ triangle.\n\n![](images/58/58993cc083d8561501ea9db70c6d4d886fadc4d4ac3455a1a58de1fe5ceb6e77.png)\n\nSince this is a $30^\\circ$-$60^\\circ$-$90^\\circ$ triangle, the length of the longer leg is $\\sqrt{3}$ times that of the shorter leg.\n\nHere, the longer leg has length $2$, and the shorter leg has length $x$, so we have\n\n$$\n\\begin{aligned}\n2 &= \\sqrt{3}x \\\\\nx &= \\frac{2}{\\sqrt{3}}\n\\end{aligned}\n$$\n\nTo remove the radical from the denominator, we can multiply the numerator and denominator by the radical:\n\n$$\n\\begin{aligned}\nx &= \\frac{2}{\\sqrt{3}} = \\frac{2 \\cdot \\sqrt{3}}{\\sqrt{3} \\cdot \\sqrt{3}} = \\frac{2\\sqrt{3}}{3}\n\\end{aligned}\n$$\n\nSo, the length of the shorter leg is\n\n$$\n\\dfrac{2 \\sqrt{3}}{3}\n$$"}] [{:db/id #edb/ref 17592186059468 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059640 :knowledge-point/id #uuid "ca6bd1cf-98e8-5fc8-b605-dd4d24ac8f6c" :knowledge-point/title "Relating the Length of the Hypotenuse to the Length Of the Longer Leg"}] :question/id #uuid "40a94955-95e0-5945-9a84-d51b8c691bce" :question/math-academy-id "e-3088" :question/problem "What is the length of the longer leg in a $30^\\circ$-$60^\\circ$-$90^\\circ$ triangle if the hypotenuse has a length of $6$?" :question/worked-solution "Let's refer to our standard $30^\\circ$-$60^\\circ$-$90^\\circ$ triangle.\n\n![](images/9f/9f62659af506661e1343caef0afa5f2072298879f17dcf8a44ab610f51f1e30f.png)\n\nSince the hypotenuse has a length of $6$, we have\n\n$$\n\\begin{aligned}\n2x &= 6 \\\\\nx &= 3\n\\end{aligned}\n$$\n\nNow that we know $x$, we can calculate the length of the longer leg as follows:\n\n$$\n\\sqrt{3}x = \\sqrt{3} \\cdot 3 = 3\\sqrt{3}\n$$\n\nTherefore, the longer leg has a length of $3 \\sqrt{3}$."}] [{:db/id #edb/ref 17592186060292 :knowledge-point/_questions [{:db/id #edb/ref 17592186059639 :knowledge-point/id #uuid "26db86bd-122c-5d1b-9684-9444897d1c44" :knowledge-point/title "Relating the Length of the Shorter Leg to the Length of the Longer Leg"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a13dd3d7-7d4b-511c-98b3-1fb34b586586" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186058375} {:answer/id #uuid "ad099d01-153c-5da1-8c13-70001e79259f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186058376} {:answer/id #uuid "28172104-fbc6-5edb-abf9-2de83a2f54e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\sqrt{3}" :db/id #edb/ref 17592186058377} {:answer/id #uuid "50e5b6ea-3ad1-5a85-a909-971d765bf4f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{3}" :db/id #edb/ref 17592186058378} {:answer/id #uuid "78dfb064-626f-5875-83b6-9a0b25999591" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{2}" :db/id #edb/ref 17592186058379}] :answer-field/id #uuid "a32854f4-ad0c-55ab-8184-cc97f0f66b55" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058374}] :question/id #uuid "696e1f33-11e8-591d-a151-94309c4bb3e3" :question/math-academy-id "q-53472" :question/problem "![](images/9a/9aef509e210c6d64da56119083ba36d9cc1f4e9b4533cf68285806a5606881cb.png)\n\nIn the triangle above, what is the length of $AC^(―)$?"}]}
