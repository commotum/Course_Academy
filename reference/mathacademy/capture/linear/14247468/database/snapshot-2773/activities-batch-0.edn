#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186097645} :activity/id #uuid "c27cf182-1590-5ed4-8477-d79b1bd9bde1" :activity/scope {:db/id #edb/ref 17592186048125 :topic/id #uuid "81314287-afbf-59c9-8f15-bfd1f541a423" :topic/math-academy-id 1144} :activity/steps [{:db/id #edb/ref 17592186097645 :step/content {:db/id #edb/ref 17592186097875 :tutorial/content "The volume of a cylinder with radius $r$ and height $h$ is given by the formula\n\n$$\nV = \\pi r^2h.\n$$\n\nLet's use this formula to calculate the volume of the cylinder below:\n\n![](images/be/bef69292f30200f32b78a41f9c0b7585fe35da964ce7f35a594f6d127812e790.png)\n\nFor this cylinder, the radius $r = 3\\,\\textrm{cm}$ and the height $h = 5\\,\\textrm{cm}.$ Substituting these values into the formula for $V,$ we get\n\n$$\nV = \\pi (3)^2 (5) = 45\\pi\\,\\textrm{cm}^3.\n$$\n\nWe often express the volume of a cylinder as a multiple of $\\pi.$ However, we can also use a calculator to get a numerical approximation for the volume. This gives\n\n$$\nV\\approx 141.37\\,\\textrm{cm}^3,\n$$\n\nrounded to two decimal places." :tutorial/id #uuid "2d173a26-f457-5488-8569-accc2b83be5a" :tutorial/math-academy-id 4349 :tutorial/title "Introduction"} :step/id #uuid "881699f7-827b-5199-9a9a-6d197501e914" :step/math-academy-id 26440 :step/next {:db/id #edb/ref 17592186097647}} {:db/id #edb/ref 17592186097646 :step/content {:db/id #edb/ref 17592186096753 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096558 :question/id #uuid "e61b5943-210d-5ef3-9c71-5780762b0163" :question/math-academy-id "e-7182"} :knowledge-point/id #uuid "fbcc16b7-dd31-55ce-ba1e-02b87263453c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048187} {:db/id #edb/ref 17592186049066}] :knowledge-point/questions [{:db/id #edb/ref 17592186097222} {:db/id #edb/ref 17592186097376} {:db/id #edb/ref 17592186233249} {:db/id #edb/ref 17592186553513}] :knowledge-point/title "Finding a Dimension of a Cylinder Given Its Volume"} :step/id #uuid "1a1ff713-9cf8-594a-8be0-cdf72cb19692" :step/math-academy-id 26442 :step/next {:db/id #edb/ref 17592186097648}} {:db/id #edb/ref 17592186097647 :step/content {:db/id #edb/ref 17592186096754 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096559 :question/id #uuid "edf5a890-3d4f-5917-b6a5-b1e3ff055fa3" :question/math-academy-id "e-7185"} :knowledge-point/id #uuid "fdf7b0cd-95b8-5cc6-94c4-768ec04c973a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049225} {:db/id #edb/ref 17592186050089}] :knowledge-point/questions [{:db/id #edb/ref 17592186097052} {:db/id #edb/ref 17592186097375} {:db/id #edb/ref 17592186553526} {:db/id #edb/ref 17592186553544} {:db/id #edb/ref 17592186553573}] :knowledge-point/title "Finding the Volume of a Cylinder"} :step/id #uuid "0f8ea361-f4bc-5170-939b-ac85add4d7fb" :step/math-academy-id 26446 :step/next {:db/id #edb/ref 17592186097646}} {:db/id #edb/ref 17592186097648 :step/content {:db/id #edb/ref 17592186096755 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096560 :question/id #uuid "af065541-e7e0-5f34-a566-40de5b546f0d" :question/math-academy-id "e-7217"} :knowledge-point/id #uuid "234b3cbc-1b13-50fc-9bec-e2149cfb2ba7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048274} {:db/id #edb/ref 17592186048891} {:db/id #edb/ref 17592186050481}] :knowledge-point/questions [{:db/id #edb/ref 17592186097374} {:db/id #edb/ref 17592186097377} {:db/id #edb/ref 17592186553510} {:db/id #edb/ref 17592186553512}] :knowledge-point/title "Finding an Expression for a Dimension of a Cylinder Given a Proportion"} :step/id #uuid "3d77ebe8-e513-50dc-85a1-b33a196f2cc7" :step/math-academy-id 26683 :step/next {:db/id #edb/ref 17592186097688}} {:db/id #edb/ref 17592186097688 :step/content {:db/id #edb/ref 17592186097888 :tutorial/content "Recall that the volume $V$ of a cylinder of radius $r$ and height $h$ is given by\n\n$$\nV = \\pi r^2 h.\n$$\n\nThis formula is very intuitive, which makes it easier to remember. \n\nNotice that the base of the cylinder is a circle of radius $r.$ Therefore, the area of a circular base is given by \n\n$$\nA = \\pi r^2.\n$$\n\nLet's label this area on a diagram.\n\n![](images/76/76c1c3179f73ee8464c187d539cebb2692b02763167a21a83857126620338154.png)\n\nTherefore, to compute the volume of the cylinder, we simply multiply the area of the base by the height:\n\n$$\n\\begin{aligned}V & =A\\cdot h \\\\  & =\\pi {r}^{2}\\cdot h \\\\  & =\\pi {r}^{2}h\\end{aligned}\n$$" :tutorial/id #uuid "e89cda8c-0ca8-5ec3-acf2-7d550c6001d4" :tutorial/math-academy-id 5422 :tutorial/title "Intuition Behind the Formula"} :step/id #uuid "a638bdd5-b0d1-5fae-b983-2531eca4174c" :step/math-academy-id 33801}] :activity/title "Volumes of Cylinders" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186096912}]}
