#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186097645} :activity/id #uuid "c27cf182-1590-5ed4-8477-d79b1bd9bde1" :activity/scope {:db/id #edb/ref 17592186048125 :topic/id #uuid "81314287-afbf-59c9-8f15-bfd1f541a423" :topic/math-academy-id 1144} :activity/steps [{:db/id #edb/ref 17592186097645 :step/content {:db/id #edb/ref 17592186097875 :tutorial/content "The volume of a cylinder with radius $r$ and height $h$ is given by the formula\n\n$$\nV = \\pi r^2h.\n$$\n\nLet's use this formula to calculate the volume of the cylinder below:\n\n![](images/be/bef69292f30200f32b78a41f9c0b7585fe35da964ce7f35a594f6d127812e790.png)\n\nFor this cylinder, the radius $r = 3\\,\\textrm{cm}$ and the height $h = 5\\,\\textrm{cm}.$ Substituting these values into the formula for $V,$ we get\n\n$$\nV = \\pi (3)^2 (5) = 45\\pi\\,\\textrm{cm}^3.\n$$\n\nWe often express the volume of a cylinder as a multiple of $\\pi.$ However, we can also use a calculator to get a numerical approximation for the volume. This gives\n\n$$\nV\\approx 141.37\\,\\textrm{cm}^3,\n$$\n\nrounded to two decimal places." :tutorial/id #uuid "2d173a26-f457-5488-8569-accc2b83be5a" :tutorial/math-academy-id 4349 :tutorial/title "Introduction"} :step/id #uuid "881699f7-827b-5199-9a9a-6d197501e914" :step/math-academy-id 26440 :step/next {:db/id #edb/ref 17592186097647}} {:db/id #edb/ref 17592186097646 :step/content {:db/id #edb/ref 17592186096753 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096558 :question/id #uuid "e61b5943-210d-5ef3-9c71-5780762b0163" :question/math-academy-id "e-7182"} :knowledge-point/id #uuid "fbcc16b7-dd31-55ce-ba1e-02b87263453c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048187} {:db/id #edb/ref 17592186049066}] :knowledge-point/questions [{:db/id #edb/ref 17592186097222} {:db/id #edb/ref 17592186097376} {:db/id #edb/ref 17592186233249} {:db/id #edb/ref 17592186553513} {:db/id #edb/ref 17592186565437}] :knowledge-point/title "Finding a Dimension of a Cylinder Given Its Volume"} :step/id #uuid "1a1ff713-9cf8-594a-8be0-cdf72cb19692" :step/math-academy-id 26442 :step/next {:db/id #edb/ref 17592186097648}} {:db/id #edb/ref 17592186097647 :step/content {:db/id #edb/ref 17592186096754 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096559 :question/id #uuid "edf5a890-3d4f-5917-b6a5-b1e3ff055fa3" :question/math-academy-id "e-7185"} :knowledge-point/id #uuid "fdf7b0cd-95b8-5cc6-94c4-768ec04c973a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049225} {:db/id #edb/ref 17592186050089}] :knowledge-point/questions [{:db/id #edb/ref 17592186097052} {:db/id #edb/ref 17592186097375} {:db/id #edb/ref 17592186553526} {:db/id #edb/ref 17592186553544} {:db/id #edb/ref 17592186553573}] :knowledge-point/title "Finding the Volume of a Cylinder"} :step/id #uuid "0f8ea361-f4bc-5170-939b-ac85add4d7fb" :step/math-academy-id 26446 :step/next {:db/id #edb/ref 17592186097646}} {:db/id #edb/ref 17592186097648 :step/content {:db/id #edb/ref 17592186096755 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096560 :question/id #uuid "af065541-e7e0-5f34-a566-40de5b546f0d" :question/math-academy-id "e-7217"} :knowledge-point/id #uuid "234b3cbc-1b13-50fc-9bec-e2149cfb2ba7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048274} {:db/id #edb/ref 17592186048891} {:db/id #edb/ref 17592186050481}] :knowledge-point/questions [{:db/id #edb/ref 17592186097374} {:db/id #edb/ref 17592186097377} {:db/id #edb/ref 17592186553510} {:db/id #edb/ref 17592186553512} {:db/id #edb/ref 17592186565457} {:db/id #edb/ref 17592186565482}] :knowledge-point/title "Finding an Expression for a Dimension of a Cylinder Given a Proportion"} :step/id #uuid "3d77ebe8-e513-50dc-85a1-b33a196f2cc7" :step/math-academy-id 26683 :step/next {:db/id #edb/ref 17592186097688}} {:db/id #edb/ref 17592186097688 :step/content {:db/id #edb/ref 17592186097888 :tutorial/content "Recall that the volume $V$ of a cylinder of radius $r$ and height $h$ is given by\n\n$$\nV = \\pi r^2 h.\n$$\n\nThis formula is very intuitive, which makes it easier to remember. \n\nNotice that the base of the cylinder is a circle of radius $r.$ Therefore, the area of a circular base is given by \n\n$$\nA = \\pi r^2.\n$$\n\nLet's label this area on a diagram.\n\n![](images/76/76c1c3179f73ee8464c187d539cebb2692b02763167a21a83857126620338154.png)\n\nTherefore, to compute the volume of the cylinder, we simply multiply the area of the base by the height:\n\n$$\n\\begin{aligned}V & =A\\cdot h \\\\  & =\\pi {r}^{2}\\cdot h \\\\  & =\\pi {r}^{2}h\\end{aligned}\n$$" :tutorial/id #uuid "e89cda8c-0ca8-5ec3-acf2-7d550c6001d4" :tutorial/math-academy-id 5422 :tutorial/title "Intuition Behind the Formula"} :step/id #uuid "a638bdd5-b0d1-5fae-b983-2531eca4174c" :step/math-academy-id 33801}] :activity/title "Volumes of Cylinders" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186096912}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186565521} :activity/id #uuid "42bed486-179b-5d59-a8d9-0bbf928cd95a" :activity/scope {:db/id #edb/ref 17592186048125 :topic/id #uuid "81314287-afbf-59c9-8f15-bfd1f541a423" :topic/math-academy-id 1144} :activity/steps [{:db/id #edb/ref 17592186565509 :step/content {:db/id #edb/ref 17592186565482 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0406e5ab-8732-5f42-9dc0-2ef98837edfc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h=\\sqrt[3]{\\frac{V}{9\\pi }}" :db/id #edb/ref 17592186564946} {:answer/id #uuid "515340d0-d9cf-5eb4-ac80-59dfc5346185" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h=\\sqrt[3]{\\frac{V}{3\\pi }}" :db/id #edb/ref 17592186565055} {:answer/id #uuid "81410aa3-599c-5b7e-a1db-6dce30fb6236" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h=\\sqrt[3]{9\\pi V}" :db/id #edb/ref 17592186565138} {:answer/id #uuid "9d33a1a2-0563-576d-b3d4-649b89c427fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h=\\sqrt[3]{\\frac{9V}{\\pi }}" :db/id #edb/ref 17592186565180} {:answer/id #uuid "d5d09076-162e-5ae2-8e86-9ff98030f326" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h=\\sqrt[3]{\\frac{3V}{\\pi }}" :db/id #edb/ref 17592186565255}] :answer-field/correct {:db/id #edb/ref 17592186565180} :answer-field/id #uuid "bb9d811f-3a95-59ec-9157-3f2c0587bc0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186565380}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f5dc2452-94d3-5570-b907-2fef94df0654" :question/math-academy-id "q-82238" :question/problem "Find an expression for the height $h$ of a cylinder in terms of its volume $V$ given that the ratio of the radius of the base to the height of the cylinder is $\\frac{1}{3}.$" :question/worked-solution "Using the fact that the ratio of the radius $r$ of the base to the height $h$ is $\\frac{1}{3},$ we have that\n\n$$\n\\begin{aligned}\\frac{r}{h} & =\\frac{1}{3}.\\end{aligned}\n$$\n\nOur goal is to express $h$ in terms of $V.$ Therefore, we need to isolate $r$ in the above equation, which we do using cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{r}{h} & =\\frac{1}{3} \\\\ 3r & =h \\\\ r & =\\frac{h}{3}\\end{aligned}\n$$\n\nThe volume of a cylinder with radius $r$ and height $h$ is given by\n\n$$\nV=\\pi {r}^{2}h.\n$$\n\nTherefore, substituting $r=\\frac{h}{3}$ into the formula, we get\n\n$$\n\\begin{aligned}V & =\\pi {r}^{2}h \\\\ V & =\\pi {(\\frac{h}{3})}^{2}\\cdot h \\\\ V & =\\pi \\cdot \\frac{{h}^{2}}{9}\\cdot h \\\\ V & =\\frac{\\pi {h}^{3}}{9} \\\\ {h}^{3} & =\\frac{9V}{\\pi } \\\\ h & =\\sqrt[3]{\\frac{9V}{\\pi }}.\\end{aligned}\n$$"} :step/id #uuid "61c0bf1f-cc04-57ab-bfd5-8623e720630d"} {:db/id #edb/ref 17592186565521 :step/content {:db/id #edb/ref 17592186565437 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f05222b-ffc2-508d-b319-7b3440be97a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\,\\text{m}" :db/id #edb/ref 17592186565030} {:answer/id #uuid "521b3deb-98a0-5aac-88d4-88a41b70ad08" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16\\,\\text{m}" :db/id #edb/ref 17592186565056} {:answer/id #uuid "9c9189d0-29f7-57e1-8870-d9a3b7c5dec5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\,\\text{m}" :db/id #edb/ref 17592186565178} {:answer/id #uuid "a12b3df0-bdc0-5e40-9e2a-234f91f81889" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\,\\text{m}" :db/id #edb/ref 17592186565183} {:answer/id #uuid "ef173a09-7b32-5954-b935-8bfb00ab0876" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\,\\text{m}" :db/id #edb/ref 17592186565299}] :answer-field/correct {:db/id #edb/ref 17592186565030} :answer-field/id #uuid "e0b91d38-c85a-5ca6-b1d0-07bdd6a02bc7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186565395}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5eb29534-af26-5796-a547-b3d37b08dcde" :question/math-academy-id "q-81915" :question/problem "![](images/8f/8f4a991a9da8b339bf2af1085787ba18227ee0926b1c280d8f3173f86c0713c8.png)\n\nCalculate the height $h$ of the cylinder above given that its volume is $32\\pi \\,{\\text{m}}^{3}$ and its radius is $2\\,\\text{m}.$" :question/worked-solution "The volume of a cylinder with radius $r$ and height $h$ is given by\n\n$$\nV=\\pi {r}^{2}h.\n$$\n\nSubstituting $V=32\\pi \\,{\\text{m}}^{3}$ and $r=2\\,\\text{m}$ into the formula and solving for $r,$ we get\n\n$$\n\\begin{aligned}V & =\\pi {r}^{2}h \\\\ 32\\pi  & =\\pi (2)^{2}h \\\\ 4\\pi h & =32\\pi  \\\\ h & =8\\,\\text{m}.\\end{aligned}\n$$"} :step/id #uuid "9822215a-42a3-56a6-a0a6-dc2017d21772" :step/next {:db/id #edb/ref 17592186565525}} {:db/id #edb/ref 17592186565525 :step/content {:db/id #edb/ref 17592186565457 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11f8333c-e93a-5108-b3b7-ab45006d5420" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "V=49\\pi {r}^{3}" :db/id #edb/ref 17592186564967} {:answer/id #uuid "212bb867-70af-5f7b-a414-5e31d4b0b6db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "V=7\\pi {r}^{3}" :db/id #edb/ref 17592186564988} {:answer/id #uuid "5ec30d2a-cfae-520d-91ee-dc9d7ec9d2f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "V=\\frac{\\pi {r}^{3}}{7}" :db/id #edb/ref 17592186565083} {:answer/id #uuid "88cce9ed-686f-55ba-94f1-65f657182f53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "V=\\frac{\\pi {r}^{3}}{49}" :db/id #edb/ref 17592186565151} {:answer/id #uuid "9673114b-bd22-5fb9-ad53-02a14467bfd5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "V=\\frac{\\pi {r}^{3}}{14}" :db/id #edb/ref 17592186565164}] :answer-field/correct {:db/id #edb/ref 17592186565083} :answer-field/id #uuid "c832f4c5-f92a-5365-ab96-cf109440464a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186565384}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b2ff9ba6-9b7a-53dd-94e6-0ac24157cb77" :question/math-academy-id "q-82230" :question/problem "Find an expression for the volume $V$ of a cylinder in terms of $r$ given that $\\frac{r}{h}=7,$ where $r$ is the radius of the base and $h$ is the height of the cylinder." :question/worked-solution "Our goal is to express $V$ in terms of $r.$ Therefore, we need to isolate $h$ in the above equation:\n\n$$\n\\begin{aligned}\\frac{r}{h} & =7 \\\\ r & =7h \\\\ \\frac{r}{7} & =h \\\\ h & =\\frac{r}{7}\\end{aligned}\n$$\n\nThe volume of a cylinder with radius $r$ and height $h$ is given by\n\n$$\nV=\\pi {r}^{2}h.\n$$\n\nTherefore, substituting $h=\\frac{r}{7}$ into the formula, we get\n\n$$\n\\begin{aligned}V & =\\pi {r}^{2}h \\\\  & =\\pi {r}^{2}\\cdot \\frac{r}{7} \\\\  & =\\frac{\\pi {r}^{3}}{7}.\\end{aligned}\n$$"} :step/id #uuid "b52b85e5-1c03-5db8-95e2-91e3dfb13d95" :step/next {:db/id #edb/ref 17592186565509}}] :activity/title "Volumes of Cylinders" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186564927}]}
