#{[{:db/id #edb/ref 17592186565437 :knowledge-point/_questions [{:db/id #edb/ref 17592186096753 :knowledge-point/id #uuid "fbcc16b7-dd31-55ce-ba1e-02b87263453c" :knowledge-point/title "Finding a Dimension of a Cylinder Given Its Volume"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f05222b-ffc2-508d-b319-7b3440be97a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\text{m}" :db/id #edb/ref 17592186565030} {:answer/id #uuid "521b3deb-98a0-5aac-88d4-88a41b70ad08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\,\\text{m}" :db/id #edb/ref 17592186565056} {:answer/id #uuid "9c9189d0-29f7-57e1-8870-d9a3b7c5dec5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\text{m}" :db/id #edb/ref 17592186565178} {:answer/id #uuid "a12b3df0-bdc0-5e40-9e2a-234f91f81889" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,\\text{m}" :db/id #edb/ref 17592186565183} {:answer/id #uuid "ef173a09-7b32-5954-b935-8bfb00ab0876" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,\\text{m}" :db/id #edb/ref 17592186565299}] :answer-field/correct {:answer/id #uuid "3f05222b-ffc2-508d-b319-7b3440be97a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\text{m}" :db/id #edb/ref 17592186565030} :answer-field/id #uuid "e0b91d38-c85a-5ca6-b1d0-07bdd6a02bc7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186565395}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5eb29534-af26-5796-a547-b3d37b08dcde" :question/math-academy-id "q-81915" :question/problem "![](images/8f/8f4a991a9da8b339bf2af1085787ba18227ee0926b1c280d8f3173f86c0713c8.png)\n\nCalculate the height $h$ of the cylinder above given that its volume is $32\\pi \\,{\\text{m}}^{3}$ and its radius is $2\\,\\text{m}.$" :question/worked-solution "The volume of a cylinder with radius $r$ and height $h$ is given by\n\n$$\nV=\\pi {r}^{2}h.\n$$\n\nSubstituting $V=32\\pi \\,{\\text{m}}^{3}$ and $r=2\\,\\text{m}$ into the formula and solving for $r,$ we get\n\n$$\n\\begin{aligned}V & =\\pi {r}^{2}h \\\\ 32\\pi  & =\\pi (2)^{2}h \\\\ 4\\pi h & =32\\pi  \\\\ h & =8\\,\\text{m}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186565457 :knowledge-point/_questions [{:db/id #edb/ref 17592186096755 :knowledge-point/id #uuid "234b3cbc-1b13-50fc-9bec-e2149cfb2ba7" :knowledge-point/title "Finding an Expression for a Dimension of a Cylinder Given a Proportion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11f8333c-e93a-5108-b3b7-ab45006d5420" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "V=49\\pi {r}^{3}" :db/id #edb/ref 17592186564967} {:answer/id #uuid "212bb867-70af-5f7b-a414-5e31d4b0b6db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "V=7\\pi {r}^{3}" :db/id #edb/ref 17592186564988} {:answer/id #uuid "5ec30d2a-cfae-520d-91ee-dc9d7ec9d2f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "V=\\frac{\\pi {r}^{3}}{7}" :db/id #edb/ref 17592186565083} {:answer/id #uuid "88cce9ed-686f-55ba-94f1-65f657182f53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "V=\\frac{\\pi {r}^{3}}{49}" :db/id #edb/ref 17592186565151} {:answer/id #uuid "9673114b-bd22-5fb9-ad53-02a14467bfd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "V=\\frac{\\pi {r}^{3}}{14}" :db/id #edb/ref 17592186565164}] :answer-field/correct {:answer/id #uuid "5ec30d2a-cfae-520d-91ee-dc9d7ec9d2f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "V=\\frac{\\pi {r}^{3}}{7}" :db/id #edb/ref 17592186565083} :answer-field/id #uuid "c832f4c5-f92a-5365-ab96-cf109440464a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186565384}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b2ff9ba6-9b7a-53dd-94e6-0ac24157cb77" :question/math-academy-id "q-82230" :question/problem "Find an expression for the volume $V$ of a cylinder in terms of $r$ given that $\\frac{r}{h}=7,$ where $r$ is the radius of the base and $h$ is the height of the cylinder." :question/worked-solution "Our goal is to express $V$ in terms of $r.$ Therefore, we need to isolate $h$ in the above equation:\n\n$$\n\\begin{aligned}\\frac{r}{h} & =7 \\\\ r & =7h \\\\ \\frac{r}{7} & =h \\\\ h & =\\frac{r}{7}\\end{aligned}\n$$\n\nThe volume of a cylinder with radius $r$ and height $h$ is given by\n\n$$\nV=\\pi {r}^{2}h.\n$$\n\nTherefore, substituting $h=\\frac{r}{7}$ into the formula, we get\n\n$$\n\\begin{aligned}V & =\\pi {r}^{2}h \\\\  & =\\pi {r}^{2}\\cdot \\frac{r}{7} \\\\  & =\\frac{\\pi {r}^{3}}{7}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186565482 :knowledge-point/_questions [{:db/id #edb/ref 17592186096755 :knowledge-point/id #uuid "234b3cbc-1b13-50fc-9bec-e2149cfb2ba7" :knowledge-point/title "Finding an Expression for a Dimension of a Cylinder Given a Proportion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0406e5ab-8732-5f42-9dc0-2ef98837edfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "h=\\sqrt[3]{\\frac{V}{9\\pi }}" :db/id #edb/ref 17592186564946} {:answer/id #uuid "515340d0-d9cf-5eb4-ac80-59dfc5346185" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "h=\\sqrt[3]{\\frac{V}{3\\pi }}" :db/id #edb/ref 17592186565055} {:answer/id #uuid "81410aa3-599c-5b7e-a1db-6dce30fb6236" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "h=\\sqrt[3]{9\\pi V}" :db/id #edb/ref 17592186565138} {:answer/id #uuid "9d33a1a2-0563-576d-b3d4-649b89c427fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "h=\\sqrt[3]{\\frac{9V}{\\pi }}" :db/id #edb/ref 17592186565180} {:answer/id #uuid "d5d09076-162e-5ae2-8e86-9ff98030f326" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "h=\\sqrt[3]{\\frac{3V}{\\pi }}" :db/id #edb/ref 17592186565255}] :answer-field/correct {:answer/id #uuid "9d33a1a2-0563-576d-b3d4-649b89c427fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "h=\\sqrt[3]{\\frac{9V}{\\pi }}" :db/id #edb/ref 17592186565180} :answer-field/id #uuid "bb9d811f-3a95-59ec-9157-3f2c0587bc0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186565380}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f5dc2452-94d3-5570-b907-2fef94df0654" :question/math-academy-id "q-82238" :question/problem "Find an expression for the height $h$ of a cylinder in terms of its volume $V$ given that the ratio of the radius of the base to the height of the cylinder is $\\frac{1}{3}.$" :question/worked-solution "Using the fact that the ratio of the radius $r$ of the base to the height $h$ is $\\frac{1}{3},$ we have that\n\n$$\n\\begin{aligned}\\frac{r}{h} & =\\frac{1}{3}.\\end{aligned}\n$$\n\nOur goal is to express $h$ in terms of $V.$ Therefore, we need to isolate $r$ in the above equation, which we do using cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{r}{h} & =\\frac{1}{3} \\\\ 3r & =h \\\\ r & =\\frac{h}{3}\\end{aligned}\n$$\n\nThe volume of a cylinder with radius $r$ and height $h$ is given by\n\n$$\nV=\\pi {r}^{2}h.\n$$\n\nTherefore, substituting $r=\\frac{h}{3}$ into the formula, we get\n\n$$\n\\begin{aligned}V & =\\pi {r}^{2}h \\\\ V & =\\pi {(\\frac{h}{3})}^{2}\\cdot h \\\\ V & =\\pi \\cdot \\frac{{h}^{2}}{9}\\cdot h \\\\ V & =\\frac{\\pi {h}^{3}}{9} \\\\ {h}^{3} & =\\frac{9V}{\\pi } \\\\ h & =\\sqrt[3]{\\frac{9V}{\\pi }}.\\end{aligned}\n$$"}]}
