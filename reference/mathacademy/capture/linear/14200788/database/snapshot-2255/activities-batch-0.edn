#{[{:activity/first-step {:db/id #edb/ref 17592186060836} :activity/id #uuid "4f0dd3e9-7208-5dd4-9870-cd437ed9ebc7" :activity/scope {:db/id #edb/ref 17592186048932 :topic/id #uuid "cd2e9db4-6727-5887-90bc-20eb0a0bf6d2" :topic/math-academy-id 278} :activity/steps [{:db/id #edb/ref 17592186060836 :step/content {:db/id #edb/ref 17592186060949 :tutorial/content "The **constant multiple rule** states that if a function $f(x)$ is multiplied by a *constant* factor $k$, then in order to differentiate $kf(x)$ we can take the derivative of $f(x)$ and then multiply by $k$ afterwards:\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}\\left(k f(x)\\right) = k \\dfrac{\\textrm d}{\\textrm d x}\\left(f(x)\\right)\n$$\n\nFor example, to differentiate $y=6x^2$, we compute\n\n$$\n\\begin{aligned}\n\\frac{dy}{dx} &= \\frac{d}{dx}(6x^{2}) \\\\\n&= 6 \\cdot \\frac{d}{dx}(x^{2}) \\\\\n&= 6 \\cdot 2x \\\\\n&= 12x\n\\end{aligned}\n$$" :tutorial/id #uuid "882aa12a-1be9-5fa0-8b2f-2a42007270f7" :tutorial/math-academy-id 345 :tutorial/title "Introduction"} :step/id #uuid "774ab8dd-74f7-5649-bbaf-2c137913eac6" :step/math-academy-id 638 :step/next {:db/id #edb/ref 17592186060837}} {:db/id #edb/ref 17592186060837 :step/content {:db/id #edb/ref 17592186059862 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059441 :question/id #uuid "e52f80d1-431d-51a0-9c51-950dc1a91065" :question/math-academy-id "e-138"} :knowledge-point/id #uuid "ffc1d505-17e4-5b0f-9150-506f9edb3350" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048593}] :knowledge-point/question-generator {:db/id #edb/ref 17592186494276} :knowledge-point/questions [{:db/id #edb/ref 17592186060005} {:db/id #edb/ref 17592186060260} {:db/id #edb/ref 17592186233069} {:db/id #edb/ref 17592186233469} {:db/id #edb/ref 17592186235441} {:db/id #edb/ref 17592186494230} {:db/id #edb/ref 17592186494234} {:db/id #edb/ref 17592186494247} {:db/id #edb/ref 17592186494248} {:db/id #edb/ref 17592186494249} {:db/id #edb/ref 17592186494253} {:db/id #edb/ref 17592186494266} {:db/id #edb/ref 17592186494268} {:db/id #edb/ref 17592186494273} {:db/id #edb/ref 17592186494274}] :knowledge-point/title "Differentiating a Power Function Using the Constant Multiple Rule"} :step/id #uuid "83c1a05d-5319-54e1-9720-469dfe66522a" :step/math-academy-id 639 :step/next {:db/id #edb/ref 17592186060838}} {:db/id #edb/ref 17592186060838 :step/content {:db/id #edb/ref 17592186059863 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059442 :question/id #uuid "2385b6c3-1f86-59fe-96bf-d42ed5cd1b56" :question/math-academy-id "e-139"} :knowledge-point/id #uuid "852449ca-b4df-5142-9540-bb503d5b7b62" :knowledge-point/questions [{:db/id #edb/ref 17592186059974} {:db/id #edb/ref 17592186059975} {:db/id #edb/ref 17592186233064} {:db/id #edb/ref 17592186233891} {:db/id #edb/ref 17592186234277} {:db/id #edb/ref 17592186237874} {:db/id #edb/ref 17592186244047}] :knowledge-point/title "Differentiating a Negative Power Function Using the Constant Multiple Rule"} :step/id #uuid "421e2979-c6df-5963-97d9-12da0c317f27" :step/math-academy-id 642 :step/next {:db/id #edb/ref 17592186060839}} {:db/id #edb/ref 17592186060839 :step/content {:db/id #edb/ref 17592186060950 :tutorial/content "The **sum rule** states that to differentiate the sum of two functions, we can take the sum of their respective derivatives:\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(u(x) + v(x)) = \\dfrac{\\textrm d u}{\\textrm d x} + \\dfrac{\\textrm d v}{\\textrm d x}\n$$\n\nThe sum rule also applies to differences:\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(u(x) - v(x)) = \\dfrac{\\textrm d u}{\\textrm d x} - \\dfrac{\\textrm d v}{\\textrm d x}\n$$\n\nAs an example, let's calculate the derivative of the function\n\n$$\ny = x^2 + x\n$$\n\nWe can apply the sum rule to find\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d x}\n$$\n\nas follows:\n\n$$\n\\begin{aligned}\n\\frac{dy}{dx} &= \\frac{d}{dx}(x^{2} + x) \\\\\n&= \\frac{d}{dx}(x^{2}) + \\frac{d}{dx}(x) \\\\\n&= 2x + 1\n\\end{aligned}\n$$" :tutorial/id #uuid "f81bca0f-c3d3-5653-b4d5-17a0d2af8863" :tutorial/math-academy-id 348 :tutorial/title "The Sum Rule for Differentiation"} :step/id #uuid "51156115-46da-5b79-ab31-debdece8bd51" :step/math-academy-id 644 :step/next {:db/id #edb/ref 17592186060840}} {:db/id #edb/ref 17592186060840 :step/content {:db/id #edb/ref 17592186059864 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059443 :question/id #uuid "72830b06-6333-5b61-8257-3967312bd178" :question/math-academy-id "e-140"} :knowledge-point/id #uuid "d3469bdd-a201-5219-a734-ed3caa6b039a" :knowledge-point/question-generator {:db/id #edb/ref 17592186494298} :knowledge-point/questions [{:db/id #edb/ref 17592186059964} {:db/id #edb/ref 17592186060176} {:db/id #edb/ref 17592186234278} {:db/id #edb/ref 17592186234279} {:db/id #edb/ref 17592186314784} {:db/id #edb/ref 17592186494285} {:db/id #edb/ref 17592186494290} {:db/id #edb/ref 17592186494292}] :knowledge-point/title "Differentiating a Sum of Functions Without Constant Factors Using the Sum Rule"} :step/id #uuid "3e6bf63f-d0ed-582b-bfaa-01d712a200e3" :step/math-academy-id 645 :step/next {:db/id #edb/ref 17592186060841}} {:db/id #edb/ref 17592186060841 :step/content {:db/id #edb/ref 17592186059865 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059444 :question/id #uuid "acfa9025-f984-5b09-9e24-f72707ad67ac" :question/math-academy-id "e-141"} :knowledge-point/id #uuid "f8e49a0c-9575-5bd0-af4e-6463495e56b3" :knowledge-point/questions [{:db/id #edb/ref 17592186060174} {:db/id #edb/ref 17592186060175} {:db/id #edb/ref 17592186233095} {:db/id #edb/ref 17592186233096} {:db/id #edb/ref 17592186233600} {:db/id #edb/ref 17592186235359} {:db/id #edb/ref 17592186287872}] :knowledge-point/title "Differentiating a Sum of Functions With Constant Factors"} :step/id #uuid "23703e57-9d17-5cfe-bffc-b6497f55dc01" :step/math-academy-id 647}] :activity/title "The Sum and Constant Multiple Rules for Differentiation" :activity/type {:db/id #edb/r