#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186518301} :activity/id #uuid "9c473583-05b6-5bc0-af16-b14fdc8c8a09" :activity/scope {:db/id #edb/ref 17592186048932 :topic/id #uuid "cd2e9db4-6727-5887-90bc-20eb0a0bf6d2" :topic/math-academy-id 278} :activity/steps [{:db/id #edb/ref 17592186518237 :step/content {:db/id #edb/ref 17592186518174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d7cab94-65b2-5228-8549-f3ba7717c36b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{11}x" :db/id #edb/ref 17592186517638} {:answer/id #uuid "608c8c54-3777-5d49-8def-13401921a806" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}{x}^{8}" :db/id #edb/ref 17592186517665} {:answer/id #uuid "ad22bea0-0514-5968-a849-0f45c5a43d08" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9{x}^{9}" :db/id #edb/ref 17592186517812} {:answer/id #uuid "d7ba16ff-9f57-54e5-b32e-9e736a76872d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{99}{{x}^{10}}" :db/id #edb/ref 17592186517898} {:answer/id #uuid "e52d4e72-b1f6-5c83-8f92-b5cb335afcc1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{99}{{x}^{11}}" :db/id #edb/ref 17592186517922}] :answer-field/correct {:db/id #edb/ref 17592186517898} :answer-field/id #uuid "d47a598d-d2c7-5bab-9e38-017b0c639aa7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518073}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8ce73f5e-c8df-5814-9aaf-e78dee12c64a" :question/math-academy-id "q-10741" :question/problem "If $y=\\frac{11}{{x}^{9}},$ find $\\frac{dy}{dx}.$" :question/worked-solution "We first rewrite the function as\n\n$$\ny=\\frac{11}{{x}^{9}}=11{x}^{-9}.\n$$\n\nThen, we apply the constant multiple and power rules:\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{\\text{d}}{\\text{d}x}(11{x}^{-9}) \\\\  & =11\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-9}) \\\\  & =11\\cdot (-9){x}^{-9-1} \\\\  & =-99{x}^{-10} \\\\  & =-\\frac{99}{{x}^{10}}\\end{aligned}\n$$"} :step/id #uuid "32d6371f-33f3-5561-8be1-2fca80b1c7d8"} {:db/id #edb/ref 17592186518290 :step/content {:db/id #edb/ref 17592186518215 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40f7c195-a751-5b71-9a87-0de1ab89d81e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12{x}^{3}-\\frac{21}{{x}^{5}}-12" :db/id #edb/ref 17592186517615} {:answer/id #uuid "43bd9732-3c9a-5769-9c00-bbcb2a48446f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12{x}^{3}-\\frac{28}{{x}^{5}}-12" :db/id #edb/ref 17592186517620} {:answer/id #uuid "cf947bc2-e090-5053-8204-9ff869376488" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12{x}^{3}+\\frac{28}{{x}^{5}}-12" :db/id #edb/ref 17592186517880} {:answer/id #uuid "e3d435a4-9bec-54a8-9486-d0e6717fcf24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24{x}^{3}-\\frac{28}{{x}^{3}}-12" :db/id #edb/ref 17592186517917} {:answer/id #uuid "f2405522-cc9c-5a15-9cc7-6150b213efad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{x}^{3}+\\frac{21}{{x}^{3}}-12" :db/id #edb/ref 17592186517952}] :answer-field/correct {:db/id #edb/ref 17592186517620} :answer-field/id #uuid "059dbd28-656a-59be-8ed5-e0971d025a8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186517971}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ec8a3447-04a1-55a0-a68b-6b9044cae34d" :question/math-academy-id "q-1866" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=3{x}^{4}+\\frac{7}{{x}^{4}}-12x.$" :question/worked-solution "Here, we apply the addition, constant multiple, and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{4}+\\frac{7}{{x}^{4}}-12x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{4})+\\frac{\\text{d}}{\\text{d}x}(7{x}^{-4})-\\frac{\\text{d}}{\\text{d}x}(12x) \\\\  & =3\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{4})+7\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-4})-12\\cdot \\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =3\\cdot 4{x}^{(4-1)}+7\\cdot (-4){x}^{(-4-1)}-12\\cdot 1 \\\\  & =12{x}^{3}-28{x}^{-5}-12 \\\\  & =12{x}^{3}-\\frac{28}{{x}^{5}}-12\\end{aligned}\n$$"} :step/id #uuid "be80f772-d8ad-5602-ac15-4417e513dab9" :step/next {:db/id #edb/ref 17592186518237}} {:db/id #edb/ref 17592186518301 :step/content {:db/id #edb/ref 17592186060174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5446db9d-f32b-503a-98c3-71bd4b13a940" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{{x}^{3}}-\\frac{9{x}^{1/4}}{4}" :db/id #edb/ref 17592186285562} {:answer/id #uuid "72b849ec-c73e-51c6-8bd6-7d57955bf8d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{{x}^{3}}-\\frac{9}{4\\sqrt[3]{x}}" :db/id #edb/ref 17592186285843} {:answer/id #uuid "93d4bb13-717f-50aa-afa5-f6147b1c9f75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{{x}^{2}}-9{x}^{3}" :db/id #edb/ref 17592186286135} {:answer/id #uuid "a7da2020-89e3-5d5f-bbdb-6fb669e629c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{{x}^{3}}+\\frac{9{x}^{-1/4}}{4}" :db/id #edb/ref 17592186286320} {:answer/id #uuid "e9029ff2-9352-53d1-a4ea-86df802fa96d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{{x}^{3}}-\\frac{9}{4\\sqrt[4]{x}}" :db/id #edb/ref 17592186286919}] :answer-field/correct {:db/id #edb/ref 17592186286919} :answer-field/id #uuid "8320dfd3-7a24-5485-a9b9-30a0c49ac165" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287423}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "76292ca7-955e-5da2-801e-cf1602a2e16d" :question/math-academy-id "q-1856" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{2}{{x}^{2}}-3{x}^{3/4}.$" :question/worked-solution "Here, we apply the addition, constant multiple, and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{{x}^{2}}-3{x}^{3/4}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{-2})-\\frac{\\text{d}}{\\text{d}x}(3{x}^{3/4}) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-2})-3\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{3/4}) \\\\  & =2\\cdot (-2){x}^{(-2-1)}-3\\cdot \\frac{3}{4}{x}^{(3/4-1)} \\\\  & =-4{x}^{-3}-\\frac{9}{4}{x}^{-1/4} \\\\  & =-\\frac{4}{{x}^{3}}-\\frac{9}{4\\sqrt[4]{x}}\\end{aligned}\n$$"} :step/id #uuid "d808f43f-f58c-5105-bd8a-c0ad332d774e" :step/next {:db/id #edb/ref 17592186518290}}] :activity/title "The Sum and Constant Multiple Rules for Differentiation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186517489}]}
