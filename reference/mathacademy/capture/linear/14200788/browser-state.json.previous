><mo>−</mo><mn>4</mn><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mrow></msup><mo>−</mo><mn>12</mn><mo>⋅</mo><mn>1</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>12</mn><msup><mi>x</mi><mn>3</mn></msup><mo>−</mo><mn>28</mn><msup><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>5</mn></mrow></msup><mo>−</mo><mn>12</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>12</mn><msup><mi>x</mi><mn>3</mn></msup><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>28</mn><msup><mi>x</mi><mn>5</mn></msup></mfrac></mstyle><mo>−</mo><mn>12</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
