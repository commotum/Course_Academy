#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186069821} :activity/id #uuid "d137e3de-dddb-541d-85b8-80566c42f679" :activity/scope {:db/id #edb/ref 17592186049620 :topic/id #uuid "05bca830-b640-52a7-acad-fecb81ab227c" :topic/math-academy-id 453} :activity/steps [{:db/id #edb/ref 17592186069712 :step/content {:db/id #edb/ref 17592186069980 :tutorial/content "Adding a value to ![](images/2e/2eb046be7e52e5a72d29a1333f9cf483411f0a8d6d897fe53014cc1952c6f759.svg) will **translate** (shift) the parabola up or down the ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-axis. For instance, adding ![](images/f5/f5f3224583db57b9cfe323c8489ef5e5271000002b5ea253eb98fd067a858b2d.svg) to ![](images/2e/2eb046be7e52e5a72d29a1333f9cf483411f0a8d6d897fe53014cc1952c6f759.svg) will move each point on the parabola ![](images/f5/f5f3224583db57b9cfe323c8489ef5e5271000002b5ea253eb98fd067a858b2d.svg) units up.\n\n![](images/2a/2a233fc5fe21dd3ffd460ab3fa343ac3c4587bca17fd958343309bc723a2cda5.png)\n\nOn the other hand, subtracting ![](images/6c/6cb44f25e489afb06ec62d2e95c4d235ece77eb36e2327b856264d2fb8b22c21.svg) will move each point of the parabola ![](images/6c/6cb44f25e489afb06ec62d2e95c4d235ece77eb36e2327b856264d2fb8b22c21.svg) units down.\n\n![](images/5b/5bcc36e857503b3faf90d1cbb58750150dc7849a0f2a0b3c58b77319ffff1224.png)\n\nIn general, the graph of ![](images/00/00abc9adb93347077819fc66fecc1e7eef09e68fc6f8e94a76e27c8eb70b13a0.svg) looks like the standard parabola ![](images/2e/2eb046be7e52e5a72d29a1333f9cf483411f0a8d6d897fe53014cc1952c6f759.svg) but translated ![](images/8d/8dc6f7e80ecaac9fa07890ce1881dd51de319597ae8b1dce821aa03c1f3eff06.svg) units up. The vertex of ![](images/00/00abc9adb93347077819fc66fecc1e7eef09e68fc6f8e94a76e27c8eb70b13a0.svg) is located at ![](images/e8/e8c4c8598a8228afb25cbf13c034e2fe234393f9b9c0dfde8be1726b4fc79a8e.svg)" :tutorial/id #uuid "82fdbf6d-9723-58e6-ba17-37a663d4fe1c" :tutorial/math-academy-id 4230 :tutorial/title "Vertical Translations of a Parabola"} :step/id #uuid "ce6687a3-902e-52e3-8470-8f99683a6a40" :step/math-academy-id 25667 :step/next {:db/id #edb/ref 17592186069894}} {:db/id #edb/ref 17592186069821 :step/content {:db/id #edb/ref 17592186069949 :tutorial/content "Suppose that we want to plot the curve $y=x^2.$ We start by making a table of values.\n\n| **$x$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $y=x^2$ | $9$ | $4$ | $1$ | $0$ | $1$ | $4$ | $9$ |\n\nWe can now plot the graph using the $(x,y)$ values in our table.\n\n![](images/57/576148f61e683e58c508b212221c103d9ef9914f549afabfec92a04ec778a268.png)\n\nThis curve's shape is known as a **parabola**, and the **minimum point** at $(0,0)$ is known as the **vertex** of the parabola." :tutorial/id #uuid "98e8af90-38c4-57f6-a494-cc5214d10c9b" :tutorial/math-academy-id 1633 :tutorial/title "Introduction"} :step/id #uuid "0b9be9bb-e4b2-59d9-9072-421ffe40dccb" :step/math-academy-id 4515 :step/next {:db/id #edb/ref 17592186069712}} {:db/id #edb/ref 17592186069822 :step/content {:db/id #edb/ref 17592186068865 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068503 :question/id #uuid "9c2447fb-d21a-553f-bc38-243ef63696ec" :question/math-academy-id "e-1445"} :knowledge-point/id #uuid "36e2e343-4403-51b2-965f-168bbe606112" :knowledge-point/questions [{:db/id #edb/ref 17592186069164} {:db/id #edb/ref 17592186069293} {:db/id #edb/ref 17592186529145} {:db/id #edb/ref 17592186529153} {:db/id #edb/ref 17592186559807}] :knowledge-point/title "Graphing a Combination of Horizontal and Vertical Translations"} :step/id #uuid "16f0fc68-7b8e-5e99-a4d6-be490c7fb9ec" :step/math-academy-id 4522} {:db/id #edb/ref 17592186069894 :step/content {:db/id #edb/ref 17592186068913 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068525 :question/id #uuid "8106f0ee-a91b-5535-bc05-fe874dc661f2" :question/math-academy-id "e-1793"} :knowledge-point/id #uuid "55cd6345-30ba-5ecf-8123-8e8d624e794f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048652} {:db/id #edb/ref 17592186050790}] :knowledge-point/questions [{:db/id #edb/ref 17592186069223} {:db/id #edb/ref 17592186069292} {:db/id #edb/ref 17592186529188} {:db/id #edb/ref 17592186529190} {:db/id #edb/ref 17592186559881}] :knowledge-point/title "Graphing a Vertical Translation of a Parabola"} :step/id #uuid "5c2c704c-b908-5a31-bcb0-a757c6f3697d" :step/math-academy-id 6158 :step/next {:db/id #edb/ref 17592186069897}} {:db/id #edb/ref 17592186069895 :step/content {:db/id #edb/ref 17592186068914 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068526 :question/id #uuid "a301e57f-0f6f-5078-a2fb-7c39fef91f3d" :question/math-academy-id "e-1794"} :knowledge-point/id #uuid "ac1b2aa5-e238-55c5-a515-7b688bc5a960" :knowledge-point/questions [{:db/id #edb/ref 17592186069165} {:db/id #edb/ref 17592186069291} {:db/id #edb/ref 17592186529100} {:db/id #edb/ref 17592186529189}] :knowledge-point/title "Graphing a Horizontal Translation of a Parabola"} :step/id #uuid "aa879443-6ff0-53c7-88ac-da0db59d17a6" :step/math-academy-id 6159 :step/next {:db/id #edb/ref 17592186069896}} {:db/id #edb/ref 17592186069896 :step/content {:db/id #edb/ref 17592186069952 :tutorial/content "Horizontal and vertical translations can be combined. It does not matter which we do first.\n\nIn general, the graph of $y=(x-h)^2+k$ is a translation of the standard parabola $y=x^2$ by\n\n- $h$ units right, and\n\n- $k$ units up.\n\nThe vertex of $y=(x-h)^2+k$ is located at $(h,k).$" :tutorial/id #uuid "b17f43fa-0d9e-5d24-b900-72a6dececdad" :tutorial/math-academy-id 1853 :tutorial/title "Combinations of Horizontal and Vertical Translations"} :step/id #uuid "7b713819-4a19-57c4-9270-3799e69d5f61" :step/math-academy-id 6160 :step/next {:db/id #edb/ref 17592186069822}} {:db/id #edb/ref 17592186069897 :step/content {:db/id #edb/ref 17592186069953 :tutorial/content "The graph of  ![](images/78/7816c015ff36e92e579c157d0d1e074270678c48b06f0c2d37d920311224d5e5.svg) looks like the standard parabola ![](images/2e/2eb046be7e52e5a72d29a1333f9cf483411f0a8d6d897fe53014cc1952c6f759.svg), but shifted ![](images/6c/6cb44f25e489afb06ec62d2e95c4d235ece77eb36e2327b856264d2fb8b22c21.svg) units to the *right* along the ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg)-axis. \n\n![](images/a4/a48db73aadd4192f244676c3cb54c6849ca284acf1adbf29d6245baa5a07afcb.png)\n\nSimilarly, the graph of ![](images/ce/ce16aa1f1cc35aaeae8aba5c19c0ebf1e9ea43e9624f0c6c18b42f7bfa21c304.svg) looks like the standard ![](images/2e/2eb046be7e52e5a72d29a1333f9cf483411f0a8d6d897fe53014cc1952c6f759.svg) parabola after it's been shifted ![](images/f5/f5f3224583db57b9cfe323c8489ef5e5271000002b5ea253eb98fd067a858b2d.svg) units to the *left*:\n\n![](images/9c/9c33ae042e23cee23f96a35f31afbb3f80fb1dfece702b26c2a1aded17885861.png)\n\nIn general, the graph of ![](images/4b/4b00aba256457d4efcd4f517482795d922665890adf0c2f0c0991527b5c1edfb.svg) looks like the standard parabola ![](images/2e/2eb046be7e52e5a72d29a1333f9cf483411f0a8d6d897fe53014cc1952c6f759.svg) but translated ![](images/99/994427fe929fdf538d7c1be792e6fa4b85697f0921161bf5ddf0e639864c9f27.svg) units right. The vertex of ![](images/4b/4b00aba256457d4efcd4f517482795d922665890adf0c2f0c0991527b5c1edfb.svg) is located at ![](images/ef/efb3fb22e5e729a56d75a55b8e4b43e7ebf0cb77a3798550afdf9e05ac3a1525.svg)\n\n**Watch Out!** It's easy to confuse the translations.\n\n- For ![](images/78/7816c015ff36e92e579c157d0d1e074270678c48b06f0c2d37d920311224d5e5.svg), we subtract ![](images/6c/6cb44f25e489afb06ec62d2e95c4d235ece77eb36e2327b856264d2fb8b22c21.svg) from ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg) inside the parentheses, and the parabola moves to the right, *not* to the left (even though it seems like it should be the other way around).\n\n- Likewise, for ![](images/ce/ce16aa1f1cc35aaeae8aba5c19c0ebf1e9ea43e9624f0c6c18b42f7bfa21c304.svg), we add ![](images/f5/f5f3224583db57b9cfe323c8489ef5e5271000002b5ea253eb98fd067a858b2d.svg) to ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg) inside the parentheses, and the parabola moves to the left, *not* to the right." :tutorial/id #uuid "5e424d1b-91e1-5860-b0c9-5ca519476af7" :tutorial/math-academy-id 1854 :tutorial/title "Horizontal Translations of a Parabola"} :step/id #uuid "fa4f9a55-e5d6-50e4-a705-d8fcd6cacddb" :step/math-academy-id 6164 :step/next {:db/id #edb/ref 17592186069895}}] :activity/title "Graphing Elementary Quadratic Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068980}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186559956} :activity/id #uuid "a503263b-892b-55b8-b8f0-5e26b9407309" :activity/scope {:db/id #edb/ref 17592186049620 :topic/id #uuid "05bca830-b640-52a7-acad-fecb81ab227c" :topic/math-academy-id 453} :activity/steps [{:db/id #edb/ref 17592186559918 :step/content {:db/id #edb/ref 17592186559807 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fbd013f-2293-5e77-8c84-75f43f728035" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-5,3)" :db/id #edb/ref 17592186559053} {:answer/id #uuid "3444194b-8678-5a19-ae45-7bbdb47a4449" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-3,-5)" :db/id #edb/ref 17592186559147} {:answer/id #uuid "4e01fe47-5f9d-5e9e-8d83-1c0184b6b57d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-5,-3)" :db/id #edb/ref 17592186559217} {:answer/id #uuid "5d141526-53c1-5e1d-98c5-1d888938debb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(5,-3)" :db/id #edb/ref 17592186559255} {:answer/id #uuid "8faeb4a2-e9b2-5b4b-8ad9-10364ef9120a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,-5)" :db/id #edb/ref 17592186559373}] :answer-field/correct {:db/id #edb/ref 17592186559053} :answer-field/id #uuid "4503f107-42ae-5b4a-9180-c8d66e223760" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559677}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "52805580-1159-55ea-b90b-d6e5fe978449" :question/math-academy-id "q-44125" :question/problem "What are the coordinates of the minimum point of the function $y=(x+5)^{2}+3?$" :question/worked-solution "Remember that the graph of $y=(x-h)^{2}+k$ is a translation of the standard parabola $y={x}^{2}$ by\n\n- $h$ units right, and\n\n- $k$ units up.\n\nThe vertex of $y=(x-h)^{2}+k$ is located at $(h,k).$\n\nHere, the parabola is translated $5$ units *left*, so we have $h=-5.$ The parabola is also translated $3$ units *up*, so we have $k=3.$ \n\n![](images/25/25221241ae83ee4bf78c712ea70d8e4cabea2cb569f59be3122412bbb2cae886.png)\n\nThe vertex is located at $(-5,3),$ and these are the coordinates of the minimum point."} :step/id #uuid "3eba1d14-5e59-5593-ae5f-1e6a34da31f5" :step/next {:db/id #edb/ref 17592186559937}} {:db/id #edb/ref 17592186559937 :step/content {:db/id #edb/ref 17592186559881 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "628b4d1f-e37b-58c0-8900-4e0915047ca9" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/34/3498d6d4b1d62c7c45b397335ebc7159c8e4eb8546bc368a558f30bdc5301847.png" :db/id #edb/ref 17592186559263} {:answer/id #uuid "97edee4a-01af-5d30-871f-ce2a7eaf7c0c" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/c6/c6e9f0867c9b5c04ed1390b01ece62d1fb33673e1e17373a92b2b2d576aeae05.png" :db/id #edb/ref 17592186559397} {:answer/id #uuid "99d2292b-7969-5f6e-b4be-489782f9c227" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/23/23f6df1a9903286f7159a50fe9ff5839b3a99394d54f5f263f0d7850b6ff92b6.png" :db/id #edb/ref 17592186559404} {:answer/id #uuid "f3fa6b7b-ab5b-56c3-962c-b8150a7fa208" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/c0/c0c34b26cc2bf965517f37f3ab1e64a55b93b1313d7de9a2fe41b3157fd68dd2.png" :db/id #edb/ref 17592186559613} {:answer/id #uuid "f857a790-7014-5955-9907-0170f0550108" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b0/b0d3e1033e38655f6dbe32901c1016520ba6bc0de566c85176ec74530066966f.png" :db/id #edb/ref 17592186559628}] :answer-field/correct {:db/id #edb/ref 17592186559397} :answer-field/id #uuid "83e97490-9261-5f62-9721-770ba25c97fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559716}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "efac71ed-19b4-5792-ad4d-1b9a5a0c61f5" :question/math-academy-id "q-105993" :question/problem "Which of the following is the graph of $y={x}^{2}+2?$" :question/worked-solution "In general, the graph of $y={x}^{2}+k$ looks like the standard parabola $y={x}^{2}$ but translated $k$ units up. The vertex of $y={x}^{2}+k$ is located at $(0,k).$\n\nIn the given function $y={x}^{2}+2,$ we have $k=2.$\n\nTherefore, the given curve is the parabola $y={x}^{2}$ after being translated $2$ units *up*. The vertex is located at $(0,2).$\n\n![](images/c6/c6e9f0867c9b5c04ed1390b01ece62d1fb33673e1e17373a92b2b2d576aeae05.png)"} :step/id #uuid "625a33d7-26f2-57a4-b96c-ea3ad102fd72"} {:db/id #edb/ref 17592186559956 :step/content {:db/id #edb/ref 17592186069165 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a802073f-fdbb-54fa-996c-bbb025926fab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,-1)" :db/id #edb/ref 17592186066225} {:answer/id #uuid "10433957-955f-515d-b219-a3e5e64ab10a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,0)" :db/id #edb/ref 17592186559056} {:answer/id #uuid "5b55fd87-be25-53e2-b4ea-5f79b56d3f15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,0)" :db/id #edb/ref 17592186559252} {:answer/id #uuid "99afc4ff-5081-5382-8d76-a429936c66c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,0)" :db/id #edb/ref 17592186559402} {:answer/id #uuid "e9788314-4bac-5767-9414-934b60b27a81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,1)" :db/id #edb/ref 17592186559587}] :answer-field/correct {:db/id #edb/ref 17592186559402} :answer-field/id #uuid "838c9bee-ebca-5796-9f1c-01d743ad7933" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186066223}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d0077cc6-e1c8-569c-ae47-d28b3d25ed61" :question/math-academy-id "q-23217" :question/problem "What are the coordinates of the minimum point of the function $y=(x-1)^{2}?$" :question/worked-solution "In general, the graph of $y=(x-h)^{2}$ looks like the standard parabola $y={x}^{2}$ but translated $h$ units right. The vertex of $y=(x-h)^{2}$ is located at $(h,0).$\n\nFor the given function $y=(x-1)^{2},$ we have $h=1.$\n\nTherefore, the given curve is the parabola $y={x}^{2}$ after being translated $1$ unit *right*. \n\n![](images/90/9038cd5affa57a94334ab4af4d8a41bd1702f8f2664c0ae5b30ff9e74b6bfe90.png)\n\nThe vertex is located at $(1,0),$ and these are the coordinates of the minimum point."} :step/id #uuid "9a92d698-ec86-5778-ba91-fdbd7435c43c" :step/next {:db/id #edb/ref 17592186559918}}] :activity/title "Graphing Elementary Quadratic Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186559007}]}
