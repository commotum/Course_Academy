93 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559716}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "efac71ed-19b4-5792-ad4d-1b9a5a0c61f5" :question/math-academy-id "q-105993" :question/problem "Which of the following is the graph of $y={x}^{2}+2?$" :question/worked-solution "In general, the graph of $y={x}^{2}+k$ looks like the standard parabola $y={x}^{2}$ but translated $k$ units up. The vertex of $y={x}^{2}+k$ is located at $(0,k).$\n\nIn the given function $y={x}^{2}+2,$ we have $k=2.$\n\nTherefore, the given curve is the parabola $y={x}^{2}$ after being translated $2$ units *up*. The vertex is located at $(0,2).$\n\n![](images/c6/c6e9f0867c9b5c04ed1390b01ece62d1fb33673e1e17373a92b2b2d576aeae05.png)"}] [{:db/id #edb/ref 17592186069165 :knowledge-point/_questions [{:db/id #edb/ref 17592186068914 :knowledge-point/id #uuid "ac1b2aa5-e238-55c5-a515-7b688bc5a960" :knowledge-point/title "Graphing a Horizontal Translation of a Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a802073f-fdbb-54fa-996c-bbb025926fab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-1)" :db/id #edb/ref 17592186066225} {:answer/id #uuid "10433957-955f-515d-b219-a3e5e64ab10a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186559056} {:answer/id #uuid "5b55fd87-be25-53e2-b4ea-5f79b56d3f15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,0)" :db/id #edb/ref 17592186559252} {:answer/id #uuid "99afc4ff-5081-5382-8d76-a429936c66c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186559402} {:answer/id #uuid "e9788314-4bac-5767-9414-934b60b27a81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,1)" :db/id #edb/ref 17592186559587}] :answer-field/correct {:answer/id #uuid "99afc4ff-5081-5382-8d76-a429936c66c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186559402} :answer-field/id #uuid "838c9bee-ebca-5796-9f1c-01d743ad7933" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066223}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d0077cc6-e1c8-569c-ae47-d28b3d25ed61" :question/math-academy-id "q-23217" :question/problem "What are the coordinates of the minimum point of the function $y=(x-1)^{2}?$" :question/worked-solution "In general, the graph of $y=(x-h)^{2}$ looks like the standard parabola $y={x}^{2}$ but translated $h$ units right. The vertex of $y=(x-h)^{2}$ is located at $(h,0).$\n\nFor the given function $y=(x-1)^{2},$ we have $h=1.$\n\nTherefore, the given curve is the parabola $y={x}^{2}$ after being translated $1$ unit *right*. \n\n![](images/90/9038cd5affa57a94334ab4af4d8a41bd1702f8f2664c0ae5b30ff9e74b6bfe90.png)\n\nThe vertex is located at $(1,0),$ and these are the coordinates of the minimum point."}] [{:db/id #edb/ref 17592186559807 :knowledge-point/_questions [{:db/id #edb/ref 17592186068865 :knowledge-point/id #uuid "36e2e343-4403-51b2-965f-168bbe606112" :knowledge-point/title "Graphing a Combination of Horizontal and Vertical Translations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fbd013f-2293-5e77-8c84-75f43f728035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,3)" :db/id #edb/ref 17592186559053} {:answer/id #uuid "3444194b-8678-5a19-ae45-7bbdb47a4449" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-5)" :db/id #edb/ref 17592186559147} {:answer/id #uuid "4e01fe47-5f9d-5e9e-8d83-1c0184b6b57d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,-3)" :db/id #edb/ref 17592186559217} {:answer/id #uuid "5d141526-53c1-5e1d-98c5-1d888938debb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,-3)" :db/id #edb/ref 17592186559255} {:answer/id #uuid "8faeb4a2-e9b2-5b4b-8ad9-10364ef9120a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-5)" :db/id #edb/ref 17592186559373}] :answer-field/correct {:answer/id #uuid "0fbd013f-2293-5e77-8c84-75f43f728035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,3)" :db/id #edb/ref 17592186559053} :answer-field/id #uuid "4503f107-42ae-5b4a-9180-c8d66e223760" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559677}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "52805580-1159-55ea-b90b-d6e5fe978449" :question/math-academy-id "q-44125" :question/problem "What are the coordinates of the minimum point of the function $y=(x+5)^{2}+3?$" :question/worked-solution "Remember that the graph of $y=(x-h)^{2}+k$ is a translation of the standard parabola $y={x}^{2}$ by\n\n- $h$ units right, and\n\n- $k$ units up.\n\nThe vertex of $y=(x-h)^{2}+k$ is located at $(h,k).$\n\nHere, the parabola is translated $5$ units *left*, so we have $h=-5.$ The parabola is also translated $3$ units *up*, so we have $k=3.$ \n\n![](images/25/25221241ae83ee4bf78c712ea70d8e4cabea2cb569f59be3122412bbb2cae886.png)\n\nThe vertex is located at $(-5,3),$ and these are the coordinates of the minimum point."}]}
