c{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\ & =e^{u}\\cdot (-3{x}^{2}-4x) \\\\ & =(-3{x}^{2}-4x)e^{u} \\\\ & =\\left(- 3 x^{2} - 4 x\\right) e^{- x^{3} - 2 x^{2} + 1}.\\end{aligned}\n$$\n\nFinally, to find the slope $m$ of the tangent to the curve at $x=-2$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}m=\\frac{\\text{d}y}{\\text{d}x}|_{x=-2} & =(-3{x}^{2}-4x)e^{-{x}^{3}-2{x}^{2}+1}|_{x=-2} \\\\ & =(-3(-2)^{2}-4(-2))e^{-(-2)^{3}-2(-2)^{2}+1} \\\\ & =-4\\cdot e^{1} \\\\ & =- 4 e.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186534168 #edb/ref 1068 #edb/ref 17592186534164 #edb/ref 17592186045443] [17592186534168 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045443] [17592186534168 #edb/ref 1071 "Find the slope $m$ of the tangent to the curve $y=e^{-{x}^{4}+3{x}^{2}+4}$ at the point where $x=-2.$\n\n$m=$\n{{field-1}}" #edb/ref 17592186045443] [17592186534168 #edb/ref 1072 #uuid "50ee9513-e646-50a4-ac90-7dd2ba8b0b7a" #edb/ref 17592186045443] [17592186534168 #edb/ref 1074 "First, we express $y$ as the composite function\n\n$$\ny=e^{u},\\,u=-{x}^{4}+3{x}^{2}+4.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=e^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-4{x}^{3}+6x.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\ & =e^{u}\\cdot (-4{x}^{3}+6x) \\\\ & =(-4{x}^{3}+6x)e^{u} \\\\ & =\\left(- 4 x^{3} + 6 x\\right) e^{- x^{4} + 3 x^{2} + 4}.\\end{aligned}\n$$\n\nFinally, to find the slope $m$ of the tangent to the curve at $x=-2$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}m=\\frac{\\text{d}y}{\\text{d}x}|_{x=-2} & =(-4{x}^{3}+6x)e^{-{x}^{4}+3{x}^{2}+4}|_{x=-2} \\\\ & =(-4(-2)^{3}+6(-2))e^{-(-2)^{4}+3(-2)^{2}+4} \\\\ & =20\\cdot e^{0} \\\\ & =20.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186534173 #edb/ref 1068 #edb/ref 17592186534170 #edb/ref 17592186045443] [17592186534173 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045443] [17592186534173 #edb/ref 1071 "Find the slope $m$ of the tangent to the curve $y=e^{-2{x}^{3}+3{x}^{2}-4}$ at the point where $x=2.$\n\n$m=$\n{{field-1}}" #edb/ref 17592186045443] [17592186534173 #edb/ref 1072 #uuid "a9053d53-838d-5e57-a71a-28c1ae22fb94" #edb/ref 17592186045443] [17592186534173 #edb/ref 1074 "First, we express $y$ as the composite function\n\n$$\ny=e^{u},\\,u=-2{x}^{3}+3{x}^{2}-4.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=e^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-6{x}^{2}+6x.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\ & =e^{u}\\cdot (-6{x}^{2}+6x) \\\\ & =(-6{x}^{2}+6x)e^{u} \\\\ & =\\left(- 6 x^{2} + 6 x\\right) e^{- 2 x^{3} + 3 x^{2} - 4}.\\end{aligned}\n$$\n\nFinally, to find the slope $m$ of the tangent to the curve at $x=2$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}m=\\frac{\\text{d}y}{\\text{d}x}|_{x=2} & =(-6{x}^{2}+6x)e^{-2{x}^{3}+3{x}^{2}-4}|_{x=2} \\\\ & =(-6(2)^{2}+6(2))e^{-2(2)^{3}+3(2)^{2}-4} \\\\ & =-12\\cdot e^{-8} \\\\ & =- \\frac{12}{e^{8}}.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186534177 #edb/ref 1168 "generate/scratch/17592186092263.py" #edb/ref 17592186045443] [17592186534177 #edb/ref 1169 #uuid "c2d7a76c-5607-5777-aed3-5f05373fc7bb" #edb/ref 17592186045443] [17592186536061 #edb/ref 1068 #edb/ref 17592186536066 #edb/ref 17592186045443] [17592186536061 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045443] [17592186536061 #edb/ref 1071 "If a curve $C$ is given by $y=(3 x^{2} + x - 1)\\cdot (\\ln{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=e^{2}$.\n\nSlope $=$ {{field-1}}" #edb/ref 17592186045443] [17592186536061 #edb/ref 1072 #uuid "025970ae-87f8-5c12-8836-70b62439e2c5" #edb/ref 17592186045443] [17592186536061 #edb/ref 1074 "We differentiate using the product rule. Let $u(x)=3 x^{2} + x - 1$ and $v(x)=\\ln{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=6 x + 1,\\quad v'(x)=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(3 x^{2} + x - 1)\\cdot (\\frac{1}{x})+(\\ln{\\left(x \\right)})\\cdot (6 x + 1) \\\\ &=\\frac{6 x^{2} \\ln{\\left(x \\right)} + 3 x^{2} + x \\ln{\\left(x \\right)} + x - 1}{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=e^{2}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=e^{2}} &=(3 (e^{2})^{2} + (e^{2}) - 1)\\cdot (\\frac{1}{(e^{2})})+(\\ln{\\left((e^{2}) \\right)})\\cdot (6 (e^{2}) + 1) \\\\ &=(-1 + e^{2} + 3 e^{4})\\cdot (e^{-2})+(2)\\cdot (1 + 6 e^{2}) \\\\ &=- \\frac{1}{e^{2}} + 3 + 15 e^{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $- \\frac{1}{e^{2}} + 3 + 15 e^{2}.$" #edb/ref 17592186045443] [17592186536065 #edb/ref 1068 #edb/ref 17592186536079 #edb/ref 17592186045443] [17592186536065 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186536065 #edb/ref 1071 "If a curve $C$ is given by $y=(4 e^{x})\\cdot (x + 1)$, calculate the slope of the tangent line to the curve at the point where $x=0$." #edb/ref 17592186045443] [17592186536065 #edb/ref 1072 #uuid "11508a06-1238-59d6-9f30-ce054ca95db7" #edb/ref 17592186045443] [17592186536065 #edb/ref 1074 "We differentiate using the product rule. Let $u(x)=4 e^{x}$ and $v(x)=x + 1.$ Then, we have\n\n$$\nu'(x)=4 e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(4 e^{x})\\cdot (1)+(x + 1)\\cdot (4 e^{x}) \\\\ &=4 \\left(x + 2\\right) e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=(4 e^{(0)})\\cdot (1)+((0) + 1)\\cdot (4 e^{(0)}) \\\\ &=(4)\\cdot (1)+(1)\\cdot (4) \\\\ &=8.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $8.$" #edb/ref 17592186045443] [17592186536069 #edb/ref 1068 #edb/ref 17592186536092 #edb/ref 17592186045443] [17592186536069 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045443] [17592186536069 #edb/ref 1071 "If a curve $C$ is given by $y=(- x^{2} - x - 1)\\cdot (\\sin{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=\\frac{\\pi}{4}$.\n\nSlope $=$ {{field-1}}" #edb/ref 17592186045443] [17592186536069 #edb/ref 1072 #uuid "33ab5b35-dd61-5afa-9e50-76ac2177002e" #edb/ref 17592186045443] [17592186536069 #edb/ref 1074 "We differentiate using the product rule. Let $u(x)=- x^{2} - x - 1$ and $v(x)=\\sin{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=- 2 x - 1,\\quad v'(x)=\\cos{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- x^{2} - x - 1)\\cdot (\\cos{\\left(x \\right)})+(\\sin{\\left(x \\right)})\\cdot (- 2 x - 1) \\\\ &=- x^{2} \\cos{\\left(x \\right)} - 2 x \\sin{\\left(x \\right)} - x \\cos{\\left(x \\right)} - \\sin{\\left(x \\right)} - \\cos{\\left(x \\right)}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{\\pi}{4}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\frac{\\pi}{4}} &=(- (\\frac{\\pi}{4})^{2} - (\\frac{\\pi}{4}) - 1)\\cdot (\\cos{\\left((\\frac{\\pi}{4}) \\right)})+(\\sin{\\left((\\frac{\\pi}{4}) \\right)})\\cdot (- 2 (\\frac{\\pi}{4}) - 1) \\\\ &=(-1 - \\frac{\\pi}{4} - \\frac{\\pi^{2}}{16})\\cdot (\\frac{\\sqrt{2}}{2})+(\\frac{\\sqrt{2}}{2})\\cdot (- \\frac{\\pi}{2} - 1) \\\\ &=\\frac{\\sqrt{2} \\left(- 12 \\pi - 32 - \\pi^{2}\\right)}{32}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $\\frac{\\sqrt{2} \\left(- 12 \\pi - 32 - \\pi^{2}\\right)}{32}.$" #edb/ref 17592186045443] [17592186536071 #edb/ref 1068 #edb/ref 17592186536076 #edb/ref 17592186045443] [17592186536071 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186536071 #edb/ref 1071 "If a curve $C$ is given by $y=(- e^{x})\\cdot (x + 3)$, calculate the slope of the tangent line to the curve at the point where $x=0$." #edb/ref 17592186045443] [17592186536071 #edb/ref 1072 #uuid "3897814a-55c8-55e3-8f23-2d1a17edc389" #edb/ref 17592186045443] [17592186536071 #edb/ref 1074 "We differentiate using the product rule. Let $u(x)=- e^{x}$ and $v(x)=x + 3.$ Then, we have\n\n$$\nu'(x)=- e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- e^{x})\\cdot (1)+(x + 3)\\cdot (- e^{x}) \\\\ &=- \\left(x + 4\\right) e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=(- e^{(0)})\\cdot (1)+((0) + 3)\\cdot (- e^{(0)}) \\\\ &=(-1)\\cdot (1)+(3)\\cdot (-1) \\\\ &=-4.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-4.$" #edb/ref 17592186045443] [17592186536074 #edb/ref 1068 #edb/ref 17592186536083 #edb/ref 17592186045443] [17592186536074 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186536074 #edb/ref 1071 "If a curve $C$ is given by $y=(- 4 e^{x})\\cdot (x + 1)$, calculate the slope of the tangent line to the curve at the point where $x=0$.\n\nSlope $=$ {{field-1}}" #edb/ref 17592186045443] [17592186536074 #edb/ref 1072 #uuid "3be093e9-a88a-5893-84f7-f2f4d4e8fb03" #edb/ref 17592186045443] [17592186536074 #edb/ref 1074 "We differentiate using the product rule. Let $u(x)=- 4 e^{x}$ and $v(x)=x + 1.$ Then, we have\n\n$$\nu'(x)=- 4 e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- 4 e^{x})\\cdot (1)+(x + 1)\\cdot (- 4 e^{x}) \\\\ &=- 4 \\left(x + 2\\right) e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=(- 4 e^{(0)})\\cdot (1)+((0) + 1)\\cdot (- 4 e^{(0)}) \\\\ &=(-4)\\cdot (1)+(1)\\cdot (-4) \\\\ &=-8.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-8.$" #edb/ref 17592186045443] [17592186536075 #edb/ref 1068 #edb/ref 17592186536082 #edb/ref 17592186045443] [17592186536075 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045443] [17592186536075 #edb/ref 1071 "If a curve $C$ is given by $y=(- x^{2} - 2 x + 2)\\cdot (\\ln{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=e^{2}$.\n\nSlope $=$ {{field-1}}" #edb/ref 17592186045443] [17592186536075 #edb/ref 1072 #uuid "3cc06495-0e47-5717-9700-118ad0cf690b" #edb/ref 17592186045443] [17592186536075 #edb/ref 1074 "We differentiate using the product rule. Let $u(x)=- x^{2} - 2 x + 2$ and $v(x)=\\ln{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=- 2 x - 2,\\quad v'(x)=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- x^{2} - 2 x + 2)\\cdot (\\frac{1}{x})+(\\ln{\\left(x \\right)})\\cdot (- 2 x - 2) \\\\ &=- \\frac{2 x^{2} \\ln{\\left(x \\right)} + x^{2} + 2 x \\ln{\\left(x \\right)} + 2 x - 2}{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=e^{2}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=e^{2}} &=(- (e^{2})^{2} - 2 (e^{2}) + 2)\\cdot (\\frac{1}{(e^{2})})+(\\ln{\\left((e^{2}) \\right)})\\cdot (- 2 (e^{2}) - 2) \\\\ &=(- e^{4} - 2 e^{2} + 2)\\cdot (e^{-2})+(2)\\cdot (- 2 e^{2} - 2) \\\\ &=- 5 e^{2} - 6 + \\frac{2}{e^{2}}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $- 5 e^{2} - 6 + \\frac{2}{e^{2}}.$" #edb/ref 17592186045443] [17592186536077 #edb/ref 1068 #edb/ref 17592186536070 #edb/ref 17592186045443] [17592186536077 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045443] [17592186536077 #edb/ref 1071 "If a curve $C$ is given by $y=(- 3 x^{2} + 3 x - 4)\\cdot (\\ln{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=e$.\n\nSlope $=$ {{field-1}}" #edb/ref 17592186045443] [17592186536077 #edb/ref 1072 #uuid "45e8eff6-7be8-5e2f-8927-eac30ddd0bc6" #edb/ref 17592186045443] [17592186536077 #edb/ref 1074 "We differentiate using the product rule. Let $u(x)=- 3 x^{2} + 3 x - 4$ and $v(x)=\\ln{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=3 - 6 x,\\quad v'(x)=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- 3 x^{2} + 3 x - 4)\\cdot (\\frac{1}{x})+(\\ln{\\left(x \\right)})\\cdot (3 - 6 x) \\\\ &=- \\frac{6 x^{2} \\ln{\\left(x \\right)} + 3 x^{2} - 3 x \\ln{\\left(x \\right)} - 3 x + 4}{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=e$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=e} &=(- 3 (e)^{2} + 3 (e) - 4)\\cdot (\\frac{1}{(e)})+(\\ln{\\left((e) \\right)})\\cdot (3 - 6 (e)) \\\\ &=(- 3 e^{2} - 4 + 3 e)\\cdot (e^{-1})+(1)\\cdot (3 - 6 e) \\\\ &=- 9 e - \\frac{4}{e} + 6.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $- 9 e - \\frac{4}{e} + 6.$" #edb/ref 17592186045443] [17592186536087 #edb/ref 1068 #edb/ref 17592186536067 #edb/ref 17592186045443] [17592186536087 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045443] [17592186536087 #edb/ref 1071 "If a curve $C$ is given by $y=(- x^{2} - 3 x - 4)\\cdot (\\cos{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=\\frac{3 \\pi}{4}$.\n\nSlope $=$ {{field-1}}" #edb/ref 17592186045443] [17592186536087 #edb/ref 1072 #uuid "89a63571-dce9-5ef0-8359-7d12fffc0179" #edb/ref 17592186045443] [17592186536087 #edb/ref 1074 "We differentiate using the product rule. Let $u(x)=- x^{2} - 3 x - 4$ and $v(x)=\\cos{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=- 2 x - 3,\\quad v'(x)=- \\sin{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- x^{2} - 3 x - 4)\\cdot (- \\sin{\\left(x \\right)})+(\\cos{\\left(x \\right)})\\cdot (- 2 x - 3) \\\\ &=x^{2} \\sin{\\left(x \\right)} + 3 x \\sin{\\left(x \\right)} - 2 x \\cos{\\left(x \\right)} + 4 \\sin{\\left(x \\right)} - 3 \\cos{\\left(x \\right)}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{3 \\pi}{4}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\frac{3 \\pi}{4}} &=(- (\\frac{3 \\pi}{4})^{2} - 3 (\\frac{3 \\pi}{4}) - 4)\\cdot (- \\sin{\\left((\\frac{3 \\pi}{4}) \\right)})+(\\cos{\\left((\\frac{3 \\pi}{4}) \\right)})\\cdot (- 2 (\\frac{3 \\pi}{4}) - 3) \\\\ &=(- \\frac{9 \\pi}{4} - \\frac{9 \\pi^{2}}{16} - 4)\\cdot (- \\frac{\\sqrt{2}}{2})+(- \\frac{\\sqrt{2}}{2})\\cdot (- \\frac{3 \\pi}{2} - 3) \\\\ &=\\frac{\\sqrt{2} \\left(9 \\pi^{2} + 112 + 60 \\pi\\right)}{32}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $\\frac{\\sqrt{2} \\left(9 \\pi^{2} + 112 + 60 \\pi\\right)}{32}.$" #edb/ref 17592186045443] [17592186536090 #edb/ref 1068 #edb/ref 17592186536089 #edb/ref 17592186045443] [17592186536090 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186536090 #edb/ref 1071 "If a curve $C$ is given by $y=(3 e^{x})\\cdot (x + 2)$, calculate the slope of the tangent line to the curve at the point where $x=0$.\n\nSlope $=$ {{field-1}}" #edb/ref 17592186045443] [17592186536090 #edb/ref 1072 #uuid "92e053cc-163c-5fb4-9084-c721d7a398e6" #edb/ref 17592186045443] [17592186536090 #edb/ref 1074 "We differentiate using the product rule. Let $u(x)=3 e^{x}$ and $v(x)=x + 2.$ Then, we have\n\n$$\nu'(x)=3 e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(3 e^{x})\\cdot (1)+(x + 2)\\cdot (3 e^{x}) \\\\ &=3 \\left(x + 3\\right) e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=(3 e^{(0)})\\cdot (1)+((0) + 2)\\cdot (3 e^{(0)}) \\\\ &=(3)\\cdot (1)+(2)\\cdot (3) \\\\ &=9.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $9.$" #edb/ref 17592186045443] [17592186536098 #edb/ref 1068 #edb/ref 17592186536080 #edb/ref 17592186045443] [17592186536098 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186536098 #edb/ref 1071 "If a curve $C$ is given by $y=(- 3 e^{x})\\cdot (x + 1)$, calculate the slope of the tangent line to the curve at the point where $x=0$.\n\nSlope $=$ {{field-1}}" #edb/ref 17592186045443] [17592186536098 #edb/ref 1072 #uuid "fad32388-6506-515e-9fd4-68888763cf2f" #edb/ref 17592186045443] [17592186536098 #edb/ref 1074 "We differentiate using the product rule. Let $u(x)=- 3 e^{x}$ and $v(x)=x + 1.$ Then, we have\n\n$$\nu'(x)=- 3 e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- 3 e^{x})\\cdot (1)+(x + 1)\\cdot (- 3 e^{x}) \\\\ &=- 3 \\left(x + 2\\right) e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=(- 3 e^{(0)})\\cdot (1)+((0) + 1)\\cdot (- 3 e^{(0)}) \\\\ &=(-3)\\cdot (1)+(1)\\cdot (-3) \\\\ &=-6.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-6.$" #edb/ref 17592186045443] [17592186536099 #edb/ref 1168 "generate/scratch/17592186096619.py" #edb/ref 17592186045443] [17592186536099 #edb/ref 1169 #uuid "45cc5958-d828-5815-b6f0-943020caeb66" #edb/ref 17592186045443] [17592186546025 #edb/ref 1068 #edb/ref 17592186546070 #edb/ref 17592186045443] [17592186546025 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186546025 #edb/ref 1071 "Given that $y=-4{e}^{-5-x},$ find $\\frac{\\text{d}y}{\\text{d}x}$\n{{field-1}}" #edb/ref 17592186045443] [17592186546025 #edb/ref 1072 #uuid "05c06d18-760a-55d8-8f2d-5ce452eb9a43" #edb/ref 17592186045443] [17592186546025 #edb/ref 1074 "First, we express $y$ as the composite function\n\n$$\ny=-4{e}^{u},\\,u=-5-x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-4{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-1.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-4{e}^{u}\\cdot (-1) \\\\  & =4{e}^{u} \\\\  & =4{e}^{-5-x}.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186546033 #edb/ref 1068 #edb/ref 17592186546024 #edb/ref 17592186045443] [17592186546033 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045443] [17592186546033 #edb/ref 1071 "Calculate ${f}^{'}(x)$ if $f(x)={x}^{5}-{e}^{4-5x}.$\n{{field-1}}" #edb/ref 17592186045443] [17592186546033 #edb/ref 1072 #uuid "3b4c3b4f-ee6c-5156-ab65-2225d5039897" #edb/ref 17592186045443] [17592186546033 #edb/ref 1074 "First, we express $y={e}^{4-5x}$ as the composite function\n\n$$\ny={e}^{u},\\,u=4-5x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-5.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (-5) \\\\  & =-5{e}^{u} \\\\  & =-5{e}^{4-5x}.\\end{aligned}\n$$\n\nFinally, using the sum rule of differentiation, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({x}^{5}-{e}^{4-5x}) \\\\  & =5{x}^{4}-(-5{e}^{4-5x}) \\\\  & =5({x}^{4}+{e}^{4-5x}).\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186546037 #edb/ref 1068 #edb/ref 17592186546023 #edb/ref 17592186045443] [17592186546037 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045443] [17592186546037 #edb/ref 1071 "Calculate ${f}^{′}(x)$ if $f(x)=2x+{e}^{4x-6}.$\n\n${f}^{′}(x)=$\n{{field-1}}" #edb/ref 17592186045443] [17592186546037 #edb/ref 1072 #uuid "46c70445-c7fa-5e96-b9db-24423c65d9d2" #edb/ref 17592186045443] [17592186546037 #edb/ref 1074 "First, we express $y={e}^{4x-6}$ as the composite function\n\n$$\ny={e}^{u},\\,u=4x-6.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=4.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot 4 \\\\  & =4{e}^{u} \\\\  & =4{e}^{4x-6}.\\end{aligned}\n$$\n\nFinally, using the sum rule of differentiation, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2x+{e}^{4x-6}) \\\\  & =2+4{e}^{4x-6} \\\\  & =4{e}^{4x-6}+2.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186546039 #edb/ref 1068 #edb/ref 17592186546076 #edb/ref 17592186045443] [17592186546039 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045443] [17592186546039 #edb/ref 1071 "Find the equation of the tangent to the curve $y=3{e}^{-4x-6}+6$ at the point where $x=- \\frac{7}{4}.$" #edb/ref 17592186045443] [17592186546039 #edb/ref 1072 #uuid "52a84e58-ee14-59cb-b2fc-5dc806f58a59" #edb/ref 17592186045443] [17592186546039 #edb/ref 1074 "First, we express $y$ as the composite function\n\n$$\ny=3{e}^{u}+6,\\,u=-4x-6.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=3{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-4.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =3{e}^{u}\\cdot (-4) \\\\  & =-12{e}^{u} \\\\  & =-12{e}^{-4x-6}.\\end{aligned}\n$$\n\nNow, to find the slope of the tangent to the curve at $x=- \\frac{7}{4}$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{x=- \\frac{7}{4}} & =-12{e}^{-4x-6}{|}_{x=- \\frac{7}{4}} \\\\ & =-12{e}^{(-4)(- \\frac{7}{4})-6} \\\\ & =- 12 e.\\end{aligned}\n$$\n\nAlso, the $y$-value of the point on the curve where $x=x_1=- \\frac{7}{4}$ is\n\n$$\n\\begin{aligned}y_1 & =(3{e}^{-4x-6}+6){|}_{x=- \\frac{7}{4}} \\\\ & =3{e}^{(-4)(- \\frac{7}{4})-6}+6 \\\\ & =6 + 3 e.\\end{aligned}\n$$\n\nFinally, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-y_1 & =m(x-x_1) \\\\ y-(6 + 3 e) & =(- 12 e)(x-(- \\frac{7}{4})) \\\\ y-(6 + 3 e) & =- 12 e x-(21 e) \\\\ y & =- 12 e x - 18 e + 6.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186546047 #edb/ref 1068 #edb/ref 17592186546056 #edb/ref 17592186045443] [17592186546047 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045443] [17592186546047 #edb/ref 1071 "Find the equation of the tangent to the curve $y=-2{e}^{-3x+2}+3$ at the point where $x=\\frac{1}{3}.$" #edb/ref 17592186045443] [17592186546047 #edb/ref 1072 #uuid "7fd12a30-30af-5a77-a4c8-bf313d7546d2" #edb/ref 17592186045443] [17592186546047 #edb/ref 1074 "First, we express $y$ as the composite function\n\n$$\ny=-2{e}^{u}+3,\\,u=-3x+2.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-2{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-3.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-2{e}^{u}\\cdot (-3) \\\\  & =6{e}^{u} \\\\  & =6{e}^{-3x+2}.\\end{aligned}\n$$\n\nNow, to find the slope of the tangent to the curve at $x=\\frac{1}{3}$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{x=\\frac{1}{3}} & =6{e}^{-3x+2}{|}_{x=\\frac{1}{3}} \\\\ & =6{e}^{(-3)(\\frac{1}{3})+2} \\\\ & =6 e.\\end{aligned}\n$$\n\nAlso, the $y$-value of the point on the curve where $x=x_1=\\frac{1}{3}$ is\n\n$$\n\\begin{aligned}y_1 & =(-2{e}^{-3x+2}+3){|}_{x=\\frac{1}{3}} \\\\ & =-2{e}^{(-3)(\\frac{1}{3})+2}+3 \\\\ & =3 - 2 e.\\end{aligned}\n$$\n\nFinally, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-y_1 & =m(x-x_1) \\\\ y-(3 - 2 e) & =(6 e)(x-(\\frac{1}{3})) \\\\ y-(3 - 2 e) & =6 e x-(2 e) \\\\ y & =6 e x - 4 e + 3.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186546052 #edb/ref 1068 #edb/ref 17592186546030 #edb/ref 17592186045443] [17592186546052 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186546052 #edb/ref 1071 "Given that $f(x) = e^{-4x}$, find $\\frac{df}{dx}$." #edb/ref 17592186045443] [17592186546052 #edb/ref 1072 #uuid "9f144a62-dd63-5191-a104-7945db3746f9" #edb/ref 17592186045443] [17592186546052 #edb/ref 1074 "First, we express $f$ as the composite function\n\n$$\nf={e}^{u},\\,u=-4x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-4.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (-4) \\\\  & =-4{e}^{u} \\\\  & =-4{e}^{-4x}.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186546058 #edb/ref 1068 #edb/ref 17592186546036 #edb/ref 17592186045443] [17592186546058 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045443] [17592186546058 #edb/ref 1071 "Find the equation of the tangent to the curve $y=5{e}^{6x-4}+1$ at the point where $x=\\frac{5}{6}.$" #edb/ref 17592186045443] [17592186546058 #edb/ref 1072 #uuid "b32ededd-4f82-5701-b090-5a6b3fd40512" #edb/ref 17592186045443] [17592186546058 #edb/ref 1074 "First, we express $y$ as the composite function\n\n$$\ny=5{e}^{u}+1,\\,u=6x-4.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=5{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=6.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =5{e}^{u}\\cdot 6 \\\\  & =30{e}^{u} \\\\  & =30{e}^{6x-4}.\\end{aligned}\n$$\n\nNow, to find the slope of the tangent to the curve at $x=\\frac{5}{6}$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{x=\\frac{5}{6}} & =30{e}^{6x-4}{|}_{x=\\frac{5}{6}} \\\\ & =30{e}^{(6)(\\frac{5}{6})-4} \\\\ & =30 e.\\end{aligned}\n$$\n\nAlso, the $y$-value of the point on the curve where $x=x_1=\\frac{5}{6}$ is\n\n$$\n\\begin{aligned}y_1 & =(5{e}^{6x-4}+1){|}_{x=\\frac{5}{6}} \\\\ & =5{e}^{(6)(\\frac{5}{6})-4}+1 \\\\ & =1 + 5 e.\\end{aligned}\n$$\n\nFinally, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-y_1 & =m(x-x_1) \\\\ y-(1 + 5 e) & =(30 e)(x-(\\frac{5}{6})) \\\\ y-(1 + 5 e) & =30 e x-(25 e) \\\\ y & =30 e x - 20 e + 1.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186546062 #edb/ref 1068 #edb/ref 17592186546061 #edb/ref 17592186045443] [17592186546062 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045443] [17592186546062 #edb/ref 1071 "Find the equation of the tangent to the curve $y=-4{e}^{3x-5}-3$ at the point where $x=2.$" #edb/ref 17592186045443] [17592186546062 #edb/ref 1072 #uuid "c6bcf79b-eac1-52f9-ad10-1945c83effb0" #edb/ref 17592186045443] [17592186546062 #edb/ref 1074 "First, we express $y$ as the composite function\n\n$$\ny=-4{e}^{u}-3,\\,u=3x-5.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-4{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=3.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-4{e}^{u}\\cdot 3 \\\\  & =-12{e}^{u} \\\\  & =-12{e}^{3x-5}.\\end{aligned}\n$$\n\nNow, to find the slope of the tangent to the curve at $x=2$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{x=2} & =-12{e}^{3x-5}{|}_{x=2} \\\\ & =-12{e}^{(3)(2)-5} \\\\ & =- 12 e.\\end{aligned}\n$$\n\nAlso, the $y$-value of the point on the curve where $x=x_1=2$ is\n\n$$\n\\begin{aligned}y_1 & =(-4{e}^{3x-5}-3){|}_{x=2} \\\\ & =-4{e}^{(3)(2)-5}-3 \\\\ & =- 4 e - 3.\\end{aligned}\n$$\n\nFinally, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-y_1 & =m(x-x_1) \\\\ y-(- 4 e - 3) & =(- 12 e)(x-(2)) \\\\ y-(- 4 e - 3) & =- 12 e x-(- 24 e) \\\\ y & =- 12 e x - 3 + 20 e.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186546066 #edb/ref 1068 #edb/ref 17592186546071 #edb/ref 17592186045443] [17592186546066 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045443] [17592186546066 #edb/ref 1071 "Find the equation of the tangent to the curve $y=-2{e}^{2x-5}-3$ at the point where $x=3.$" #edb/ref 17592186045443] [17592186546066 #edb/ref 1072 #uuid "d323abf4-feef-5783-8c9c-89b3cff14f40" #edb/ref 17592186045443] [17592186546066 #edb/ref 1074 "First, we express $y$ as the composite function\n\n$$\ny=-2{e}^{u}-3,\\,u=2x-5.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-2{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=2.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-2{e}^{u}\\cdot 2 \\\\  & =-4{e}^{u} \\\\  & =-4{e}^{2x-5}.\\end{aligned}\n$$\n\nNow, to find the slope of the tangent to the curve at $x=3$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{x=3} & =-4{e}^{2x-5}{|}_{x=3} \\\\ & =-4{e}^{(2)(3)-5} \\\\ & =- 4 e.\\end{aligned}\n$$\n\nAlso, the $y$-value of the point on the curve where $x=x_1=3$ is\n\n$$\n\\begin{aligned}y_1 & =(-2{e}^{2x-5}-3){|}_{x=3} \\\\ & =-2{e}^{(2)(3)-5}-3 \\\\ & =- 2 e - 3.\\end{aligned}\n$$\n\nFinally, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-y_1 & =m(x-x_1) \\\\ y-(- 2 e - 3) & =(- 4 e)(x-(3)) \\\\ y-(- 2 e - 3) & =- 4 e x-(- 12 e) \\\\ y & =- 4 e x - 3 + 10 e.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186546072 #edb/ref 1068 #edb/ref 17592186546068 #edb/ref 17592186045443] [17592186546072 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186546072 #edb/ref 1071 "Given that $f(x) = e^{4x + 7}$, find $\\frac{df}{dx}$." #edb/ref 17592186045443] [17592186546072 #edb/ref 1072 #uuid "e1a53e4b-cb95-5fd7-83e2-0c854f6893c1" #edb/ref 17592186045443] [17592186546072 #edb/ref 1074 "First, we express $f$ as the composite function\n\n$$\nf={e}^{u},\\,u=4x+7.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=4.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot 4 \\\\  & =4{e}^{u} \\\\  & =4{e}^{4x+7}.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186546080 #edb/ref 1168 "generate/scratch/17592186092260.py" #edb/ref 17592186045443] [17592186546080 #edb/ref 1169 #uuid "3215cc89-d684-55a6-9e02-7322856a1556" #edb/ref 17592186045443] [17592186546252 #edb/ref 1043 #edb/ref 17592186547100 #edb/ref 17592186045417] [17592186546252 #edb/ref 1043 #edb/ref 17592186547118 #edb/ref 17592186045417] [17592186546252 #edb/ref 1043 #edb/ref 17592186547159 #edb/ref 17592186045417] [17592186546252 #edb/ref 1044 #edb/ref 17592186045464 #ed