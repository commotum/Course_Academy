}}{\\text{d}x}(\\operatorname{tan}⁡x)={sec}^{2}⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}{y}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2x-\\operatorname{tan}⁡x) \\\\  & =2-{sec}^{2}⁡x.\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi }{4},$ we get\n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{4}) & =2-{sec}^{2}⁡(\\frac{\\pi }{4}) \\\\  & =2-(\\sqrt{2})^{2} \\\\  & =2-2 \\\\  & =0.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186483528 #edb/ref 1068 #edb/ref 17592186483536 #edb/ref 17592186045443] [17592186483528 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186483528 #edb/ref 1071 "Find ${f}^{′}(x)$ if $f(x)=\\sqrt{x}+2tan⁡x.$\n\n${f}^{′}(x)=$\n{{field-1}}" #edb/ref 17592186045443] [17592186483528 #edb/ref 1072 #uuid "16f98c04-c89a-5e4f-bf27-ed015bececed" #edb/ref 17592186045443] [17592186483528 #edb/ref 1074 "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ Applying these formulas, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}+2tan⁡x) \\\\  & =1\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+2\\frac{\\text{d}}{\\text{d}x}(tan⁡x) \\\\  & =1(\\frac{1}{2\\sqrt{x}})+2({sec}^{2}⁡x) \\\\  & =\\frac{\\frac{1}{2}}{\\sqrt{x}}+2{sec}^{2}⁡x.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186483538 #edb/ref 1068 #edb/ref 17592186483537 #edb/ref 17592186045443] [17592186483538 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186483538 #edb/ref 1071 "Find ${f}^{′}(x)$ if $f(x)=\\sqrt{x}+3tan⁡x.$\n\n${f}^{′}(x)=$\n{{field-1}}" #edb/ref 17592186045443] [17592186483538 #edb/ref 1072 #uuid "ec85ab69-3759-5a26-ad41-7f26f7d7092f" #edb/ref 17592186045443] [17592186483538 #edb/ref 1074 "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ Applying these formulas, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}+3tan⁡x) \\\\  & =1\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+3\\frac{\\text{d}}{\\text{d}x}(tan⁡x) \\\\  & =1(\\frac{1}{2\\sqrt{x}})+3({sec}^{2}⁡x) \\\\  & =\\frac{\\frac{1}{2}}{\\sqrt{x}}+3{sec}^{2}⁡x.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186483539 #edb/ref 1168 "generate/scratch/17592186059676.py" #edb/ref 17592186045443] [17592186483539 #edb/ref 1169 #uuid "0b99f9c0-8919-547c-a6d7-86a2865bf32a" #edb/ref 17592186045443] [17592186484409 #edb/ref 1068 #edb/ref 17592186484408 #edb/ref 17592186045443] [17592186484409 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045443] [17592186484409 #edb/ref 1071 "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=3\\left(\\frac{{x}^{8}}{4}+x-\\frac{4}{\\sqrt{x}}\\right).$\n\n$\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=$\n{{field-1}}" #edb/ref 17592186045443] [17592186484409 #edb/ref 1072 #uuid "37315e0b-7879-5b79-8d31-f3ffb31ff99f" #edb/ref 17592186045443] [17592186484409 #edb/ref 1074 "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3\\left(\\frac{{x}^{8}}{4}+x-\\frac{4}{\\sqrt{x}}\\right)) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3\\left(\\frac{{x}^{8}}{4}+x-4{x}^{-1/2}\\right)) \\\\  & =3\\left(8\\cdot \\frac{{x}^{7}}{4}+1-(-\\frac{1}{2})\\cdot 4{x}^{-3/2}\\right) \\\\  & =3\\left(2{x}^{7}+1+2{x}^{-3/2}\\right).\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(3\\left(2{x}^{7}+1+2{x}^{-3/2}\\right)) \\\\  & =3\\left(7\\cdot 2{x}^{6}+0+(-\\frac{3}{2})\\cdot 2{x}^{-5/2}\\right) \\\\  & =3\\left(14{x}^{6}-3{x}^{-5/2}\\right) \\\\  & =3\\left(14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}\\right).\\end{aligned}\n$$" #edb/ref 17592186045443]}
