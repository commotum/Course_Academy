i>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo>−</mo><mn>3</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mtext>d</mtext><mrow><mtext>d</mtext><mi>x</mi></mrow></mfrac></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>−</mo><mn>3</mn><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mtext>d</mtext><mrow><mtext>d</mtext><mi>x</mi></mrow></mfrac></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><mo stretchy=\"false\">(</mo><mo>−</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo stretchy=\"false\">)</mo><mo>−</mo><mn>3</mn><mo stretchy=\"false\">(</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>2</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo>−</mo><mn>3</mn><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>             \n\n                           \n                    </div>",
