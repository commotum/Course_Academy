          "input_html": "<div class=\"matheditor-wrapper-answer\" style=\"min-width: 100px; margin-left: 5px; margin-right: 5px;\">\n                                             \n                                        <div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"9\"><span mathquill-command-id=\"69\" class=\"\">−</span><span class=\"mq-fraction mq-non-leaf\" mathquill-command-id=\"71\"><span class=\"mq-numerator\" mathquill-block-id=\"73\"><span mathquill-command-id=\"72\">3</span></span><span class=\"mq-denominator\" mathquill-block-id=\"78\"><var mathquill-command-id=\"75\" class=\"mq-operator-name\">s</var><var mathquill-command-id=\"76\" class=\"mq-operator-name\">i</var><var mathquill-command-id=\"77\" class=\"mq-operator-name\">n</var><span class=\"mq-supsub mq-non-leaf mq-sup-only\" mathquill-command-id=\"79\"><span class=\"mq-sup\" mathquill-block-id=\"81\"><span mathquill-command-id=\"80\">2</span></span></span><var mathquill-command-id=\"83\">x</var></span><span style=\"display:inline-block;width:0\">​</span></span></span></div></div>",
          "rendered_text": "−3sin2x​",
