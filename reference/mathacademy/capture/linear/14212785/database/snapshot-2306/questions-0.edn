#{[{:db/id #edb/ref 17592186091951 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186092382 :knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/id #uuid "2f5afc63-6988-5676-b170-5826e659a5fd" :question/math-academy-id "e-144" :question/problem "Find the equation of the tangent to the curve $y = 2x^3 - 2x$ at the point $(1,0).$" :question/worked-solution "Let $f(x) = 2x^3 - 2x.$ Computing the derivative $f'(x)$ gives\n\n$$\nf'(x)  = 6x^2-2.\n$$\n\nWe then compute $f'(1)$, which gives\n\n$$\nf'(1)  = 6(1)^2-2 = 4.\n$$\n\nFinally, we use the point-slope form with $m=4$ and the coordinates of our point $(1,0),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-0 & =4(x-1) \\\\ y & =4x-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186091952 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186092383 :knowledge-point/id #uuid "84c8ba29-95c9-5494-be0b-9b67bee6e45c" :knowledge-point/title "Determining where a Tangent Line Intersects an Axis"}] :question/id #uuid "e248bb90-ba83-5e3f-938b-2c8be7d6eb7a" :question/math-academy-id "e-146" :question/problem "Find where the tangent to the curve $y=4\\sqrt{x}+4x$ at the point $(1,8)$ intersects the $x$-axis." :question/worked-solution "Let $f(x)=4\\sqrt{x}+4x.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4\\sqrt{x}+4x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{x}^{1/2}+4x) \\\\  & =2{x}^{-1/2}+4\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\nm=f'(1) = 2(1)^{-1/2}+4 = 6.\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-8 & =6(x-1) \\\\ y & =6x-6+8 \\\\ y & =6x+2.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $x$-axis, we set $y=0$ and solve:\n\n$$\n\\begin{aligned}0 & =6x+2 \\\\ x & =-\\frac{1}{3}\\end{aligned}\n$$\n\nTherefore, the point of intersection is $\\left(-\\dfrac 1 3, 0\\right).$"}] [{:db/id #edb/ref 17592186092505 :knowledge-point/_questions [{:db/id #edb/ref 17592186092383 :knowledge-point/id #uuid "84c8ba29-95c9-5494-be0b-9b67bee6e45c" :knowledge-point/title "Determining where a Tangent Line Intersects an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34ceb6d1-9f92-5a12-a620-1703269e2fea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(10,0)" :db/id #edb/ref 17592186241642} {:answer/id #uuid "757fd2b2-e67b-5b73-9960-69177e752366" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,7)" :db/id #edb/ref 17592186242224} {:answer/id #uuid "a8be58b9-3641-56b3-b019-b90b2aeec263" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-10)" :db/id #edb/ref 17592186242661} {:answer/id #uuid "b3fb07a2-de66-5a8e-85f1-f9637a4db061" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-7,0)" :db/id #edb/ref 17592186242752} {:answer/id #uuid "d09a2270-6b9d-566d-955f-7ca56a000f84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,10)" :db/id #edb/ref 17592186243019}] :answer-field/correct {:answer/id #uuid "d09a2270-6b9d-566d-955f-7ca56a000f84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,10)" :db/id #edb/ref 17592186243019} :answer-field/id #uuid "894232d0-aa75-55b0-8b57-14b37f42a79f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243697}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b75358e5-0e2f-554f-8ca2-4e81d5f869f0" :question/math-academy-id "q-10831" :question/problem "Find where the tangent to the curve  $y=\\frac{5}{x}-2x$ at the point $(1,3)$ intersects the $y$-axis." :question/worked-solution "Let $f(x)=\\frac{5}{x}-2x.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{5}{x}-2x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(5{x}^{-1}-2x) \\\\  & =-5{x}^{-2}-2\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m={f}^{′}(1)=-5(1{)}^{-2}-2=-7.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(3) & =-7(x-1) \\\\ y & =-7x+7+3 \\\\ y & =-7x+10.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $x$-axis, we set $x=0$ and solve:\n\n$$\n\\begin{aligned}y & =-7(0)+10 \\\\ y & =10\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(0,10).$"}] [{:db/id #edb/ref 17592186244130 :knowledge-point/_questions [{:db/id #edb/ref 17592186092382 :knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "748ad103-47d7-54bd-b443-632c57c8e9a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186242215} {:answer/id #uuid "799ee3bc-dfca-510e-a47e-2798dc153aad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=9x" :db/id #edb/ref 17592186242252} {:answer/id #uuid "89381a2f-8eb7-5360-9a54-f2019ea37a2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-9" :db/id #edb/ref 17592186242387} {:answer/id #uuid "9a5d73c8-4cd6-5c27-8738-bda84fae71b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-9x" :db/id #edb/ref 17592186242528} {:answer/id #uuid "cf2facc4-edc5-55d0-8918-89250d81d554" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=9" :db/id #edb/ref 17592186243007}] :answer-field/correct {:answer/id #uuid "89381a2f-8eb7-5360-9a54-f2019ea37a2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-9" :db/id #edb/ref 17592186242387} :answer-field/id #uuid "b6c47791-5d33-5c21-ab34-809782a452e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243762}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "59f7c071-253d-534f-b5b0-303aefe3edb7" :question/math-academy-id "q-10841" :question/problem "Find the equation of the tangent to the curve $y={x}^{2}-6x$ at the point $(3,-9).$" :question/worked-solution "Let $f(x)={x}^{2}-6x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}({x}^{2}-6x)=2x-6.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(3)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(3)=2(3)-6=0.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=0$ and the coordinates of our point $(3,-9),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-9) & =0(x-3) \\\\ y & =-9.\\end{aligned}\n$$"}]}
