tyle=\"true\" columnalign=\"right left\"><mtr><mtd><mn>4</mn><mi>x</mi></mtd><mtd><mo>=</mo><mn>24</mn></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>4</mn><mi>x</mi></mrow><mn>4</mn></mfrac></mstyle></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>24</mn><mn>4</mn></mfrac></mstyle></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><menclose notation=\"updiagonalstrike\"><mn>4</mn></menclose><mi>x</mi></mrow><menclose notation=\"updiagonalstrike\"><mn>4</mn></menclose></mfrac></mstyle></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>24</mn><mn>4</mn></mfrac></mstyle></mtd></mtr><mtr><mtd><mi>x</mi></mtd><mtd><mo>=</mo><mn>6</mn></mtd></mtr></mtable></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
