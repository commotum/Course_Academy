      "input_html": "<div class=\"matheditor-wrapper-answer\" style=\"min-width: 60px; margin-left: 5px; margin-right: 5px;\">\n                                             \n                                        <div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"7\"><var mathquill-command-id=\"39\">x</var><span mathquill-command-id=\"41\" class=\"mq-binary-operator\">+</span><span mathquill-command-id=\"43\">2</span></span></div></div>",
