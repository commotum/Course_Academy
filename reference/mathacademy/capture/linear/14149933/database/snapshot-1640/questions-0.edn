#{[{:db/id #edb/ref 17592186059420 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059860 :knowledge-point/id #uuid "b5865455-213b-5f5e-9366-420907a81259" :knowledge-point/title "Finding the Inequality Represented by a Number Line"}] :question/id #uuid "b8a1258e-e69c-528c-be89-3ed5510cdf38" :question/math-academy-id "e-13029" :question/problem "What inequality corresponds to the red colored graph shown in the number line below?\n\n![](images/39/399512ad3596d2d055849d631cfbe45859a74de5e5604fb0da55aadc62a421c9.png)" :question/worked-solution "The red arrow indicates that $x$ should consist of all the values greater than $2.$ In addition, the filled red circle at $2$ implies that $x$ can be equal to $2.$\n\nTherefore, the highlighted region represents the numbers that are greater than or equal to $2.$ This corresponds the inequality $x \\geq 2.$"}] [{:db/id #edb/ref 17592186059421 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059861 :knowledge-point/id #uuid "21897f76-0c26-5314-a029-3089042bad26" :knowledge-point/title "Constructing the Number Line for a Given Inequality"}] :question/id #uuid "878239be-ff00-592c-85b0-7aa12d232749" :question/math-academy-id "e-13030" :question/problem "Represent $x < -1$ on a number line." :question/worked-solution "The symbol \"$<$\" means \"less than.\"  So, the inequality $x < -1$ represents the numbers that are less than $-1.$\n\nOn a number line, the numbers less than $-1$ are the numbers that are left of  $-1.$ So, we should draw an arrow going to the left of $-1.$\n\nHowever, the number $-1$ itself is not less than $-1,$ so we should not include it in our representation. To exclude $-1,$ we draw an empty circle around $-1.$\n\n![](images/57/57499770d310c5f0912e62ec160accd878a1c169c22ce894a48102a39769d209.png)"}] [{:db/id #edb/ref 17592186445438 :knowledge-point/_questions [{:db/id #edb/ref 17592186059861 :knowledge-point/id #uuid "21897f76-0c26-5314-a029-3089042bad26" :knowledge-point/title "Constructing the Number Line for a Given Inequality"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "518cc0ee-f3ef-5b49-9cc1-af890503125a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ac/ace7c5f6f12ea43f2c857f77a8f2a27e29ee46bb0d8a40abb9ee7fe2804d088c.png" :db/id #edb/ref 17592186445418} {:answer/id #uuid "8d83664b-c1de-56c3-97b8-f6113599bfb3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c1/c11b5e702a30706efc3c54a37ee4edb13c79dede4449498e28bec490c8cac714.png" :db/id #edb/ref 17592186445422} {:answer/id #uuid "d0039b13-9699-5e99-9548-adebc1066904" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1d/1de4a8653a87bc3f166020f6b2ce0cd13d239d2446c6d2bf141acd9eaba56fc4.png" :db/id #edb/ref 17592186445427} {:answer/id #uuid "d345cdfa-fc39-58c4-aa9e-14cc36c32d16" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c7/c77a1235f58c03b599b3d8e82c615d08a1ea751bd0dbd96ad489371e334634b4.png" :db/id #edb/ref 17592186445428} {:answer/id #uuid "dedec72c-dffd-5937-a006-8a4e721db1cb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e6/e61a41ec6751ead8b7d07f16a2a9a3f5f60db1c8054fbbdb97d615e09eddf925.png" :db/id #edb/ref 17592186445430}] :answer-field/correct {:answer/id #uuid "518cc0ee-f3ef-5b49-9cc1-af890503125a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ac/ace7c5f6f12ea43f2c857f77a8f2a27e29ee46bb0d8a40abb9ee7fe2804d088c.png" :db/id #edb/ref 17592186445418} :answer-field/id #uuid "c86e3a50-f5a0-5f51-9766-7d6322a7f67f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186445437}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4aba1af7-62ea-5370-b694-eeeca26ff323" :question/math-academy-id "q-159897" :question/problem "Which of the following number lines represents the inequality $x\\le 1?$" :question/worked-solution "The condition $x\\le 1$ implies that $x$ can be any value that is **less than or equal to ** $1.$\n\n To represent this on a number line:\n\n- We draw a **closed** circle at $x=1.$\n\n- Then, we draw an arrow starting from $1$ and going to the **left**.\n\n![](images/ac/ace7c5f6f12ea43f2c857f77a8f2a27e29ee46bb0d8a40abb9ee7fe2804d088c.png)"}] [{:db/id #edb/ref 17592186445441 :knowledge-point/_questions [{:db/id #edb/ref 17592186059860 :knowledge-point/id #uuid "b5865455-213b-5f5e-9366-420907a81259" :knowledge-point/title "Finding the Inequality Represented by a Number Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4daef84b-9d44-50b1-b06d-8a58f39bddb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186445417}] :answer-field/correct {:answer/id #uuid "4daef84b-9d44-50b1-b06d-8a58f39bddb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186445417} :answer-field/id #uuid "093c30e9-b532-5373-aabb-e18531090e46" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186445433} {:answer-field/choices [{:answer/id #uuid "f6acbac1-576a-598a-8776-b459e210e1bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186445431}] :answer-field/correct {:answer/id #uuid "f6acbac1-576a-598a-8776-b459e210e1bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186445431} :answer-field/id #uuid "79961808-da22-5c7f-b70c-526ad6844ebe" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186445436}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fefc49e3-51bb-5025-a3fc-1cd10413d3c9" :question/math-academy-id "q-180940" :question/problem "![](images/ec/ecf0167d85a696d7a5e937f46269e00a8c83ed8b7f9ff00c50056ef137615396.png)\n\nThe inequality corresponding to the highlighted region shown above is $x${{field-1}}{{field-2}}." :question/worked-solution "There is an **open** circle at $x=3,$ and the red arrow starts from $3$ and goes to the **left**. This indicates that $x$ should consist of all the values **less than** $3.$\n\nTherefore, the highlighted region represents $x<3.$"}] [{:db/id #edb/ref 17592186445440 :knowledge-point/_questions [{:db/id #edb/ref 17592186059861 :knowledge-point/id #uuid "21897f76-0c26-5314-a029-3089042bad26" :knowledge-point/title "Constructing the Number Line for a Given Inequality"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14d67ee5-d33a-5d03-9c17-863ce01f16a6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e1/e152243e795775e186b350970a4ce8a7aa43da3871b5e4c8bec32337d43a9d34.png" :db/id #edb/ref 17592186445416} {:answer/id #uuid "60118aa4-9442-5c1f-af97-1dd2130f756f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/27/27253fe281bb83ae27ae871c9f4e34d1987397c1da9164d24324ad5030fdda8c.png" :db/id #edb/ref 17592186445421} {:answer/id #uuid "b20c076e-5339-5305-b8e4-ce30e44c2b12" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/43/431d651d05f9f27ea869f87a041c4c7bafb16d518311b45a225d869212bb00f8.png" :db/id #edb/ref 17592186445423} {:answer/id #uuid "ca6899af-15da-5372-bbe1-b9fc5e8abfa7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/22/228c60ebd08d4d68a79e3dc901e1656f09bf59e87cf8e4a8d85a1d3f04f2e588.png" :db/id #edb/ref 17592186445426} {:answer/id #uuid "f6dc6901-a71a-5dd6-a1f7-5c50dce1e41a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4b/4be757012411ef309bb4c224d874ce97741efe174395566eca760d0b37766df3.png" :db/id #edb/ref 17592186445432}] :answer-field/correct {:answer/id #uuid "f6dc6901-a71a-5dd6-a1f7-5c50dce1e41a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4b/4be757012411ef309bb4c224d874ce97741efe174395566eca760d0b37766df3.png" :db/id #edb/ref 17592186445432} :answer-field/id #uuid "3883b179-6a02-5cd3-bfb1-426acb09e0f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186445434}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ad34d57a-2da7-5bc1-bca7-8df6d9c603f3" :question/math-academy-id "q-25850" :question/problem "Which of the following number lines represents the inequality $x\\ge -2?$" :question/worked-solution "The condition $x\\ge -2$ implies that $x$ can be any value that is **greater than or equal to** $-2.$\n\n To represent this on a number line:\n\n- We draw a **closed** circle at $x=-2.$\n\n- Then, we draw an arrow starting from $-2$ and going to the **right**.\n\n![](images/4b/4be757012411ef309bb4c224d874ce97741efe174395566eca760d0b37766df3.png)"}] [{:db/id #edb/ref 17592186445439 :knowledge-point/_questions [{:db/id #edb/ref 17592186059860 :knowledge-point/id #uuid "b5865455-213b-5f5e-9366-420907a81259" :knowledge-point/title "Finding the Inequality Represented by a Number Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55323248-3f3f-5c01-b13c-0f2eee3bcd29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 4" :db/id #edb/ref 17592186445419} {:answer/id #uuid "5b508564-fac8-5144-9767-cea4258afaef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident 