#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186060833} :activity/id #uuid "21d6e8f7-8d4a-5f6e-8df2-8ad898df0910" :activity/scope {:db/id #edb/ref 17592186050519 :topic/id #uuid "50225243-6d83-5aa6-a6f4-fff184fce3db" :topic/math-academy-id 178} :activity/steps [{:db/id #edb/ref 17592186060833 :step/content {:db/id #edb/ref 17592186060988 :tutorial/content "An **inequality** is a mathematical statement that represents a set of numbers on the number line. For example, the set of numbers that are greater than or equal to $0$ can also be represented by the inequality\n\n$$\nx \\; {\\color{red}\\geq} \\; 0\n$$\n\nHere, the sign ${\\color{red}\\geq}$ means \"greater than or equal to.\" So the above statement in words is \"$x$ is greater than or equal to zero.\" For example,\n\n- the numbers $0,$ $1,$ and $7.321$ all satisfy the inequality, while\n\n- the numbers $-0.01,$ $-8,$ and $-123$ do not.\n\nWe can represent this inequality visually using a number line. To do so, we first plot the number zero as a red dot on the number line. The rest of the numbers that are greater than or equal to $0$ lie to the right of $0,$ so we represent them using a red line that extends to the right of $0\\mathbin{:}$\n\n![](images/b6/b6e9b825a43d1305fc151797351319d1e8f53f7d0dec24a10096a91bc4482855.png)\n\nIn general, there are four types of inequalities:\n\n$\\ge\\quad$ *greater than or equal* - this is represented by a filled circle $\\Large\\color{red}\\bullet$ and an arrow that goes to the right $\\Large\\color{red}\\boldsymbol{\\rightarrow}$\n\n$>\\quad$ *greater than* - this is represented by an empty circle $\\Large\\color{red}\\circ$ and an arrow that goes to the right $\\Large\\color{red}\\boldsymbol{\\rightarrow}$\n\n$\\le\\quad$ *less than or equal* - this is represented by a filled circle $\\Large\\color{red}\\bullet$ and an arrow that goes to the left $\\Large\\color{red}\\boldsymbol{\\leftarrow}$\n\n$<\\quad$ *less than* - this is represented by an empty circle $\\Large\\color{red}\\circ$  and an arrow that goes to the left $\\Large\\color{red}\\boldsymbol{\\leftarrow}$" :tutorial/id #uuid "091c554a-47dd-599b-a624-a1b0dc2abe0f" :tutorial/math-academy-id 8149 :tutorial/title "Introduction"} :step/id #uuid "9ebfdd60-c0a9-5201-b185-9cd0518e33c9" :step/math-academy-id 53327 :step/next {:db/id #edb/ref 17592186060834}} {:db/id #edb/ref 17592186060834 :step/content {:db/id #edb/ref 17592186059860 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059420 :question/id #uuid "b8a1258e-e69c-528c-be89-3ed5510cdf38" :question/math-academy-id "e-13029"} :knowledge-point/id #uuid "b5865455-213b-5f5e-9366-420907a81259" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049429} {:db/id #edb/ref 17592186050602} {:db/id #edb/ref 17592186050618}] :knowledge-point/questions [{:db/id #edb/ref 17592186060251} {:db/id #edb/ref 17592186060309} {:db/id #edb/ref 17592186444090} {:db/id #edb/ref 17592186444091} {:db/id #edb/ref 17592186444092} {:db/id #edb/ref 17592186444093} {:db/id #edb/ref 17592186445439} {:db/id #edb/ref 17592186445441}] :knowledge-point/title "Finding the Inequality Represented by a Number Line"} :step/id #uuid "8931ab5a-30fc-57c4-ac45-fc3bfff6b11d" :step/math-academy-id 53331 :step/next {:db/id #edb/ref 17592186060835}} {:db/id #edb/ref 17592186060835 :step/content {:db/id #edb/ref 17592186059861 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059421 :question/id #uuid "878239be-ff00-592c-85b0-7aa12d232749" :question/math-academy-id "e-13030"} :knowledge-point/id #uuid "21897f76-0c26-5314-a029-3089042bad26" :knowledge-point/questions [{:db/id #edb/ref 17592186060253} {:db/id #edb/ref 17592186060254} {:db/id #edb/ref 17592186445438} {:db/id #edb/ref 17592186445440}] :knowledge-point/title "Constructing the Number Line for a Given Inequality"} :step/id #uuid "f36135bb-ef92-5a59-8a06-abf924134d5c" :step/math-academy-id 53342}] :activity/title "Inequalities" :activity/type {:db/id 