#{[{:activity/expected-seconds 900.0 :activity/first-step {:db/id #edb/ref 17592186079509} :activity/id #uuid "8560c2d0-d837-56e0-950c-db576aea6153" :activity/scope {:db/id #edb/ref 17592186048166 :topic/id #uuid "84e2509e-1fbc-5c17-a4bf-5c3aa6194b5d" :topic/math-academy-id 685} :activity/steps [{:db/id #edb/ref 17592186079313 :step/content {:db/id #edb/ref 17592186078436 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078306 :question/id #uuid "d7c0ca60-1915-5484-913a-835a1f8fa320" :question/math-academy-id "e-4240"} :knowledge-point/id #uuid "90216c0e-e4a5-5933-86e0-58d218939e29" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048142}] :knowledge-point/questions [{:db/id #edb/ref 17592186079063} {:db/id #edb/ref 17592186079157} {:db/id #edb/ref 17592186234162} {:db/id #edb/ref 17592186557242} {:db/id #edb/ref 17592186557291} {:db/id #edb/ref 17592186571427} {:db/id #edb/ref 17592186571452}] :knowledge-point/title "Finding the Index of a Term Given the Recursive Formula"} :step/id #uuid "a9588d2a-14e4-52e1-b197-e06616dcb6e5" :step/math-academy-id 15490 :step/next {:db/id #edb/ref 17592186079511}} {:db/id #edb/ref 17592186079314 :step/content {:db/id #edb/ref 17592186078437 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078307 :question/id #uuid "2da03f9b-c474-5b07-b4e8-bdf1dc3c2fd8" :question/math-academy-id "e-4241"} :knowledge-point/id #uuid "a82355f8-4b86-55c8-8686-1e4ea82e4464" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050511}] :knowledge-point/questions [{:db/id #edb/ref 17592186079155} {:db/id #edb/ref 17592186079156} {:db/id #edb/ref 17592186557277}] :knowledge-point/title "Finding the Index of a Term Given the First Term and the Common Ratio"} :step/id #uuid "23a88b1d-eef3-5987-a6c3-5e388244d80e" :step/math-academy-id 15491 :step/next {:db/id #edb/ref 17592186079510}} {:db/id #edb/ref 17592186079509 :step/content {:db/id #edb/ref 17592186079627 :tutorial/content "In addition to using the formula \n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1}\\end{aligned}\n$$\n\nto compute the terms of a geometric sequence, we can also use it to compute the index of a desired term in a geometric sequence.\n\nTo illustrate, suppose we're given the geometric sequence \n\n$$\n3, \\: 6, \\: 12, \\: \\ldots, \\:96, \\ldots\n$$\n\nthat has the first term $a_1=3$ and the common ratio $r=2$. What index gives the term $96?$ In other words, what value of $n$ gives $a_n=96?$\n\nWe can construct the formula for the $n$th term, as follows:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\  & =3\\cdot {2}^{n-1}\\end{aligned}\n$$\n\nNow, to find the value of $n$ that gives $a_n=96$, we can use the formula for the $n$th term, as follows:\n\n$$\n\\begin{aligned}{a}_{n} & =3\\cdot {2}^{n-1} \\\\ 96 & =3\\cdot {2}^{n-1} \\\\ 32 & ={2}^{n-1} \\\\ {2}^{5} & ={2}^{n-1}\\end{aligned}\n$$\n\n    \n\nEquating the exponents gives:\n\n$$\n5 = n - 1\\quad \\Longrightarrow \\quad n = 6\n$$\n\nTherefore, $96$ is the $6$th term of the sequence." :tutorial/id #uuid "77450737-c02f-5751-b70b-0b387def70eb" :tutorial/math-academy-id 1672 :tutorial/title "Introduction"} :step/id #uuid "fbfa3bf3-20c5-5d4d-a7dd-74222bd4805e" :step/math-academy-id 4734 :step/next {:db/id #edb/ref 17592186079314}} {:db/id #edb/ref 17592186079510 :step/content {:db/id #edb/ref 17592186078564 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078205 :question/id #uuid "426f52d9-ad0e-5ef3-a545-78315ea02c0e" :question/math-academy-id "e-1514"} :knowledge-point/id #uuid "d47c0304-a438-5444-9add-5e4f61acbbcd" :knowledge-point/questions [{:db/id #edb/ref 17592186079113} {:db/id #edb/ref 17592186079126} {:db/id #edb/ref 17592186557226} {:db/id #edb/ref 17592186557239}] :knowledge-point/title "Finding the Index of a Term Given the First Term and Another Term"} :step/id #uuid "a4bf9b19-3f3a-5399-8f55-c85f6684f07d" :step/math-academy-id 4735 :step/next {:db/id #edb/ref 17592186079313}} {:db/id #edb/ref 17592186079511 :step/content {:db/id #edb/ref 17592186078565 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078206 :question/id #uuid "e3fed3e8-9bc6-558d-a426-96006871a20d" :question/math-academy-id "e-1516"} :knowledge-point/id #uuid "aaa87d67-d9df-5bbb-b98e-00d72d16fe7f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049083}] :knowledge-point/questions [{:db/id #edb/ref 17592186078895} {:db/id #edb/ref 17592186079114} {:db/id #edb/ref 17592186557274} {:db/id #edb/ref 17592186571403}] :knowledge-point/title "Finding the Index of a Particular Term When the First Term is Unknown"} :step/id #uuid "a73a35bf-c363-53aa-a8e5-abf04854ae43" :step/math-academy-id 4741}] :activity/title "Determining Indexes of Terms in Geometric Sequences" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078698}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186571476} :activity/id #uuid "dc604786-5b5a-59db-9b96-1cd461412ced" :activity/scope {:db/id #edb/ref 17592186048166 :topic/id #uuid "84e2509e-1fbc-5c17-a4bf-5c3aa6194b5d" :topic/math-academy-id 685} :activity/steps [{:db/id #edb/ref 17592186571472 :step/content {:db/id #edb/ref 17592186571427 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aae7201-0fed-53fc-a560-be8854d1fa86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186570930} {:answer/id #uuid "619a7f6a-6521-5fab-8631-a66510798252" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186571041} {:answer/id #uuid "688648e4-8fd7-5010-8190-cf083062eac1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186571053} {:answer/id #uuid "9306cacc-8d60-5b87-8b47-e67068d937e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186571120} {:answer/id #uuid "c7619aae-7b10-5fbe-b77e-14e4e7134260" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186571200}] :answer-field/correct {:db/id #edb/ref 17592186570930} :answer-field/id #uuid "00ed5582-4e3e-5fcb-9fc3-a83454376310" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571281}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "96ea02ed-6d88-5b00-815c-f8be25c4ea42" :question/math-academy-id "q-63978" :question/problem "What is the index of the term $640$ for the geometric sequence below?\n\n$$\nf(n+1)=4f(n),\\,f(1)=10,\\,n\\ge 1\n$$" :question/worked-solution "This geometric sequence is given as a recurrence relation, i.e.,\n\n$$\nf(n+1)=r\\cdot f(n).\n$$\n\nTherefore:\n\n$$\nf(1)=10,\\,r=4.\n$$\n\nWe're interested in finding $n$ such that $f(n)=640.$ Using the formula for the $n$th term, we get:\n\n$$\n\\begin{aligned}f(n) & =f(1)\\cdot {r}^{n-1} \\\\ 640 & =10\\cdot {4}^{n-1} \\\\ \\frac{640}{10} & ={4}^{n-1} \\\\ 64 & ={4}^{n-1} \\\\ {4}^{3} & ={4}^{n-1}\\end{aligned}\n$$\n\nEquating the exponents gives:\n\n$$\n3=n-1\\,⟹\\,n=4\n$$\n\nTherefore, $640$ is the $4$th term of the sequence."} :step/id #uuid "3307c13a-e410-5797-bae2-964bbd06f381" :step/next {:db/id #edb/ref 17592186571479}} {:db/id #edb/ref 17592186571476 :step/content {:db/id #edb/ref 17592186571452 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b2662e2-28f0-51b7-9fa7-ba07f2de0f16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186570956} {:answer/id #uuid "40996b84-32b7-51ec-905b-ddfdf12f19b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186570987} {:answer/id #uuid "56e179c3-86b2-5a02-b674-d9a1a939689c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186571024} {:answer/id #uuid "96927bba-3ed8-5280-a942-2dfccd2e993b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186571129} {:answer/id #uuid "9d6146d2-2330-51c3-80dd-b7396e3f5dd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186571135}] :answer-field/correct {:db/id #edb/ref 17592186571024} :answer-field/id #uuid "2e19b73d-cabe-517c-9e65-72cddd518722" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571302}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f76581a2-daa4-550c-b579-94540f5aa5ee" :question/math-academy-id "q-63977" :question/problem "What is the index of the term $96$ for the geometric sequence below?\n\n$$\n{a}_{n+1}=4{a}_{n},\\,{a}_{1}=6,\\,n\\ge 1\n$$" :question/worked-solution "This geometric sequence is given as a recurrence relation, i.e.,\n\n$$\n{a}_{n+1}=r\\cdot {a}_{n}.\n$$\n\nTherefore, \n\n$$\n{a}_{1}=6,\\,r=4.\n$$\n\nWe're interested in finding $n$ such that ${a}_{n}=96.$ Using the formula for the $n$th term, we get:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\ 96 & =6\\cdot {4}^{n-1} \\\\ \\frac{96}{6} & ={4}^{n-1} \\\\ 16 & ={4}^{n-1} \\\\ {4}^{2} & ={4}^{n-1}\\end{aligned}\n$$\n\nEquating the exponents gives:\n\n$$\n2=n-1\\,⟹\\,n=3\n$$\n\nTherefore, $96$ is the $3$rd term of the sequence."} :step/id #uuid "363e47b6-be82-5847-8a91-cf53d2810b28" :step/next {:db/id #edb/ref 17592186571472}} {:db/id #edb/ref 17592186571479 :step/content {:db/id #edb/ref 17592186571403 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bd4e7d8-50eb-5592-9e14-57d4fe27d0e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186570957} {:answer/id #uuid "55180673-cfac-5260-9318-f71da80eff56" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186571019} {:answer/id #uuid "8a8e13ad-2f9f-5475-93f3-c68d44d1735f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186571104} {:answer/id #uuid "b70adf20-ddef-58f0-b112-4b95fcd85d6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186571173} {:answer/id #uuid "d2c9e500-94c8-5652-86b9-f435bc1248ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186571214}] :answer-field/correct {:db/id #edb/ref 17592186571214} :answer-field/id #uuid "4c632047-5477-54e3-8a2f-d791ae58065c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571313}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5f336a0d-d13a-5e94-83e6-97790680d0c6" :question/math-academy-id "q-67482" :question/problem "Given that a geometric sequence has the $4$th term ${a}_{4}=250$ and the common ratio $r=5$, what is the index of the term $1\\,250?$" :question/worked-solution "Since we are given that ${a}_{4}=250$, we can use the formula for the $n$th term to solve for ${a}_{1}$, as follows:\n\n$$\n\\begin{aligned}{a}_{4} & ={a}_{1}\\cdot {r}^{4-1} \\\\ 250 & ={a}_{1}\\cdot {5}^{4-1} \\\\ 250 & ={a}_{1}\\cdot {5}^{3} \\\\ \\frac{250}{125} & ={a}_{1} \\\\ {a}_{1} & =2\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is\n\n$$\n\\begin{aligned}{a}_{n} &=2\\cdot {5}^{n-1}.\\end{aligned}\n$$\n\nNow, we solve for the value of $n$ that gives ${a}_{n}=1\\,250,$ as follows:\n\n$$\n\\begin{aligned}1\\,250 & =2\\cdot {5}^{n-1} \\\\ \\frac{1\\,250}{2} & ={5}^{n-1} \\\\ 625 & ={5}^{n-1} \\\\ {5}^{4} & ={5}^{n-1}\\end{aligned}\n$$\n\nEquating the exponents gives:\n\n$$\n4=n-1\\,⟹\\,n=5\n$$"} :step/id #uuid "4fe4491e-9367-5fca-9253-ee67c678e77a"}] :activity/title "Determining Indexes of Terms in Geometric Sequences" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186570891}]}
