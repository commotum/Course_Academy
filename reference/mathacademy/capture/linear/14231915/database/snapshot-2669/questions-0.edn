#{[{:db/id #edb/ref 17592186552523 :knowledge-point/_questions [{:db/id #edb/ref 17592186100953 :knowledge-point/id #uuid "b0159149-010c-5bef-a28d-85c4c43f0586" :knowledge-point/title "Applying the Quotient Rule to Compute a Limit Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "001cfea2-3243-502b-b681-07c2629016e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186551666} {:answer/id #uuid "66e43f57-628e-574d-bee1-02e70161c111" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186551905} {:answer/id #uuid "9439c322-08c4-5fa6-bac1-93c4c63c5670" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186552024} {:answer/id #uuid "c8b0522c-e278-5eeb-8757-ae6ef8f633e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186552144} {:answer/id #uuid "df91c407-dea9-56f7-b110-9a3515844db4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186552185}] :answer-field/correct {:answer/id #uuid "66e43f57-628e-574d-bee1-02e70161c111" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186551905} :answer-field/id #uuid "da132908-34e5-5c70-9173-d7d64df32ee0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552379}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f41c0540-27ef-5b47-a626-2808486f0487" :question/math-academy-id "q-100081" :question/problem "![](images/ea/ea804b5eb5c4af6aace19a66008dfbf9b130f1e1e38c2d8d9d811e9cad4c413c.png)\n\nFind ${lim}_{x\\to 0}\\frac{({x}^{2}-1)}{f(x)}$ for the function $f(x)$ plotted above." :question/worked-solution "We find from the graph that ${lim}_{x\\to 0}f(x)$ does not exist, therefore\n \n\n$$\n{lim}_{x\\to 0}\\frac{({x}^{2}-1)}{f(x)}=\\frac{{lim}_{x\\to 0}({x}^{2}-1)}{{lim}_{x\\to 0}f(x)}=\\text{DNE}.\n$$"}] [{:db/id #edb/ref 17592186552420 :knowledge-point/_questions [{:db/id #edb/ref 17592186100952 :knowledge-point/id #uuid "0a649e49-73c7-5470-8361-2002da74f234" :knowledge-point/title "Applying the Quotient Rule to Compute a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fbba08c-67df-5ead-8409-25f8358c6ec5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186551854}] :answer-field/correct {:answer/id #uuid "4fbba08c-67df-5ead-8409-25f8358c6ec5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186551854} :answer-field/id #uuid "8b424413-3cc6-545c-affb-ca63eecbfa1f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186552335}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "23394483-7f6f-560b-bb8e-2bc28d2cef6c" :question/math-academy-id "q-300754" :question/problem "${lim}_{x\\to -5}\\frac{4x}{x+1}=${{field-1}}" :question/worked-solution "Applying the quotient rule for limits, we get\n\n$$\n\\begin{aligned}{lim}_{x\\to -5}\\frac{4x}{x+1} & =\\frac{{lim}_{x\\to -5}4x}{{lim}_{x\\to -5}(x+1)} \\\\  & =\\frac{4(-5)}{-5+1} \\\\  & =\\frac{-20}{-4} \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552511 :knowledge-point/_questions [{:db/id #edb/ref 17592186100952 :knowledge-point/id #uuid "0a649e49-73c7-5470-8361-2002da74f234" :knowledge-point/title "Applying the Quotient Rule to Compute a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "683e1f83-d5f2-5e5b-a5ae-2e14582f49ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186551908}] :answer-field/correct {:answer/id #uuid "683e1f83-d5f2-5e5b-a5ae-2e14582f49ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186551908} :answer-field/id #uuid "38969d03-7d07-5623-8a2e-c4b68014d499" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186552284}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d97c91f1-911f-5cfb-8ef6-5119b61716cb" :question/math-academy-id "q-337820" :question/problem "${lim}_{x\\to -1}\\frac{{x}^{2}-4}{1-{x}^{3}}=${{field-1}}" :question/worked-solution "Applying the quotient rule for limits, we get\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}\\frac{{x}^{2}-4}{1-{x}^{3}} & =\\frac{{lim}_{x\\to -1}({x}^{2}-4)}{{lim}_{x\\to -1}(1-{x}^{3})} \\\\  & =\\frac{(-1)^{2}-4}{1-(-1)^{3}} \\\\  & =-\\frac{3}{2}.\\end{aligned}\n$$"}]}
