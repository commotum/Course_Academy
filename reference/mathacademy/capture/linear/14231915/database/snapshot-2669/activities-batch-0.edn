#{[{:activity/first-step {:db/id #edb/ref 17592186101796} :activity/id #uuid "af8776aa-b3ed-5305-95b5-bf42623f4ed3" :activity/scope {:db/id #edb/ref 17592186049226 :topic/id #uuid "e4f7b310-649d-511b-ae6e-709dcea1f6cd" :topic/math-academy-id 1246} :activity/steps [{:db/id #edb/ref 17592186101602 :step/content {:db/id #edb/ref 17592186100823 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100658 :question/id #uuid "0f441b48-b977-538c-82af-aa40ed4076d2" :question/math-academy-id "e-3561"} :knowledge-point/id #uuid "23567a86-8e1e-5b94-bac6-09c79cdb42c9" :knowledge-point/questions [{:db/id #edb/ref 17592186101387} {:db/id #edb/ref 17592186101388} {:db/id #edb/ref 17592186521544} {:db/id #edb/ref 17592186521555}] :knowledge-point/title "Applying the Product Rule to Compute a Limit Given a Graph"} :step/id #uuid "2408ea61-ca9b-52c5-ae47-17af57a34e64" :step/math-academy-id 12001 :step/next {:db/id #edb/ref 17592186101797}} {:db/id #edb/ref 17592186101603 :step/content {:db/id #edb/ref 17592186100824 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100659 :question/id #uuid "7a24a8e0-768e-541c-aff1-cad6f977da87" :question/math-academy-id "e-3562"} :knowledge-point/id #uuid "5feb914d-efad-5d89-85a9-db99befc9928" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050653}] :knowledge-point/questions [{:db/id #edb/ref 17592186101385} {:db/id #edb/ref 17592186101386} {:db/id #edb/ref 17592186233420} {:db/id #edb/ref 17592186235427}] :knowledge-point/title "Applying the Product Rule to Compute a Limit"} :step/id #uuid "a3d559f2-c362-56ee-804c-080f88071508" :step/math-academy-id 12002 :step/next {:db/id #edb/ref 17592186101602}} {:db/id #edb/ref 17592186101796 :step/content {:db/id #edb/ref 17592186101928 :tutorial/content "The **product rule** states that the limit of the product of two functions equals the product of the limits.\n\nMore precisely, if\n\n$$\n\\lim_\\limits{x\\rightarrow \\, a}f(x)=L\n$$\n\nand\n\n$$\n\\lim_\\limits{x\\rightarrow \\, a}g(x)=K\n$$\n\nthen\n\n$$\n\\begin{aligned}\nlim_(x → a)(f(x) \\cdot g(x)) &= lim_(x → a)f(x) \\cdot lim_(x → a)g(x) \\\\\n&= L \\cdot K\n\\end{aligned}\n$$\n\nFor example, we can evaluate\n\n$$\n\\lim_\\limits{x \\rightarrow \\,2} \\left[ (x^2 +2x +3)(x^3-2x-1) \\right]\n$$\n\nby evaluating the limit of each polynomial separately, and then multiplying the results together:\n\n$$\n\\begin{aligned}\nlim_(x → 2)[(x^{2} + 2x + 3)(x^{3} - 2x - 1)] &= lim_(x → 2)(x^{2} + 2x + 3) \\cdot lim_(x → 2)(x^{3} - 2x - 1) \\\\\n&= (2^{2} + 2 \\cdot 2 + 3) \\cdot (2^{3} - 2 \\cdot 2 - 1) \\\\\n&= (4 + 4 + 3) \\cdot (8 - 4 - 1) \\\\\n&= (11) \\cdot (3) \\\\\n&= 33\n\\end{aligned}\n$$" :tutorial/id #uuid "c7f68019-2904-5740-87e6-e66d189cb771" :tutorial/math-academy-id 175 :tutorial/title "Introduction"} :step/id #uuid "55b6421a-40da-531f-9d53-41329827a526" :step/math-academy-id 333 :step/next {:db/id #edb/ref 17592186101603}} {:db/id #edb/ref 17592186101797 :step/content {:db/id #edb/ref 17592186101929 :tutorial/content "The **quotient rule** states that the limit of the quotient of two functions equals the quotient of the limits (provided that the limit of the denominator is not zero).\n\nMore precisely, if\n\n$$\n\\lim_\\limits{x\\rightarrow a}f(x)=L\n$$\n\nand\n\n$$\n\\lim_\\limits{x\\rightarrow a}g(x)= K \\neq 0\n$$\n\n, then\n\n$$\n\\lim_\\limits{x\\rightarrow a} \\dfrac{f(x)}{g(x)} = \\dfrac{\\lim_\\limits{x\\rightarrow a}f(x)}{\\lim_\\limits{x\\rightarrow a}g(x)}=\\dfrac{L}{K}\n$$\n\nFor example, we can evaluate\n\n$$\n\\lim_\\limits{x \\rightarrow \\,2} \\dfrac{x^2+4x}{x+1}\n$$\n\nby evaluating the limits of the numerator and denominator separately, and then dividing the results:\n\n$$\n\\begin{aligned}\nlim_(x → 2)\\frac{x^{2} + 4x}{x + 1} &= (lim_(x → 2)(x^{2} + 4x))/(lim_(x → 2)(x + 1)) \\\\\n&= \\frac{2^{2} + 4 \\cdot 2}{2 + 1} \\\\\n&= \\frac{12}{3} \\\\\n&= 4\n\\end{aligned}\n$$" :tutorial/id #uuid "46d526ad-25bf-58f5-88e0-695b4ff6d430" :tutorial/math-academy-id 178 :tutorial/title "The Quotient Rule for Limits"} :step/id #uuid "67532783-b8e9-5de2-9ca2-19a49fbf6ec4" :step/math-academy-id 339 :step/next {:db/id #edb/ref 17592186101798}} {:db/id #edb/ref 17592186101798 :step/content {:db/id #edb/ref 17592186100952 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100620 :question/id #uuid "04538f07-6e4c-547e-be0c-8b62025e19ff" :question/math-academy-id "e-28"} :knowledge-point/id #uuid "0a649e49-73c7-5470-8361-2002da74f234" :knowledge-point/questions [{:db/id #edb/ref 17592186101389} {:db/id #edb/ref 17592186101419} {:db/id #edb/ref 17592186235468} {:db/id #edb/ref 17592186552420} {:db/id #edb/ref 17592186552511}] :knowledge-point/title "Applying the Quotient Rule to Compute a Limit"} :step/id #uuid "e8f2b1af-f0df-5d06-b349-280fb90373de" :step/math-academy-id 340 :step/next {:db/id #edb/ref 17592186101799}} {:db/id #edb/ref 17592186101799 :step/content {:db/id #edb/ref 17592186100953 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100621 :question/id #uuid "71b3f83c-33e6-5043-9215-7db7b4b12497" :question/math-academy-id "e-29"} :knowledge-point/id #uuid "b0159149-010c-5bef-a28d-85c4c43f0586" :knowledge-point/questions [{:db/id #edb/ref 17592186101241} {:db/id #edb/ref 17592186101242} {:db/id #edb/ref 17592186235507} {:db/id #edb/ref 17592186512873} {:db/id #edb/ref 17592186521537} {:db/id #edb/ref 17592186552523}] :knowledge-point/title "Applying the Quotient Rule to Compute a Limit Given a Graph"} :step/id #uuid "1da33225-c9cd-5fd9-8576-b2d8fdce7dcf" :step/math-academy-id 342}] :activity/title "The Product and Quotient Rules for Limits" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186101087}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186521608} :activity/id #uuid "8e49eaa1-6e20-5177-b734-5660533a859b" :activity/scope {:db/id #edb/ref 17592186049226 :topic/id #uuid "e4f7b310-649d-511b-ae6e-709dcea1f6cd" :topic/math-academy-id 1246} :activity/steps [{:db/id #edb/ref 17592186521608 :step/content {:db/id #edb/ref 17592186521555 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19197229-5d48-5afc-abfd-66d923c6020f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186520820} {:answer/id #uuid "39d9a121-2cea-54a4-be8c-879ad88faecb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186520891} {:answer/id #uuid "8646dd0f-8b2b-546d-837a-0eb10eef94e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186521070} {:answer/id #uuid "da80b901-76be-5b81-adc9-6cd165130508" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186521252} {:answer/id #uuid "ebf35fc4-0777-595a-b312-adcad1105f1c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186521287}] :answer-field/correct {:db/id #edb/ref 17592186521287} :answer-field/id #uuid "9379bdb2-a24f-536a-8f21-7af1b41bfabf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186521399}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d82dc916-4a3b-544e-8c9e-9820eeb6151d" :question/math-academy-id "q-100057" :question/problem "![](images/6d/6dd62794ee072530cd2b6c8028101b58ae617d6757d29f79de90d1a439f6529b.png)\n\nFind ${lim}_{x\\to 1}\\frac{(6x-1)f(x)}{5}$ for the function $f(x)$ plotted above." :question/worked-solution "We find from the graph that ${lim}_{x\\to 1}f(x)=2.$ So we calculate\n \n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{(6x-1)f(x)}{5} & =\\frac{1}{5}(6\\cdot {lim}_{x\\to 1}x-1)\\cdot {lim}_{x\\to 1}f(x) \\\\  & =\\frac{1}{5}(6(1)-1)(2) \\\\  & =\\frac{10}{5} \\\\  & =2\\,.\\end{aligned}\n$$"} :step/id #uuid "661325a7-b965-509f-ad3e-d886d2af7b21" :step/next {:db/id #edb/ref 17592186521651}} {:db/id #edb/ref 17592186521628 :step/content {:db/id #edb/ref 17592186521544 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae6f200f-ddfc-5978-9499-832c6010156c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "66" :db/id #edb/ref 17592186521155}] :answer-field/correct {:db/id #edb/ref 17592186521155} :answer-field/id #uuid "696cc972-ece8-5b53-8faf-f9002d4c084b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186521374}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bacd5fdb-8e88-5e6c-8872-876eba96fadd" :question/math-academy-id "q-300738" :question/problem "![](images/b5/b563936f37e82c3f6a422f80b448a7902a656a2749a7abced6c7bb9225ecf2bc.png)\n\nIf the figure above shows the graph of $f(x),$ then\n\n${lim}_{x\\to -4}(2{x}^{2}+1)f(x)=$\n{{field-1}}." :question/worked-solution "From the graph, we get that ${lim}_{x\\to -4}f(x)=2.$ So, applying the product rule, we have\n \n\n$$\n\\begin{aligned}{lim}_{x\\to -4}(2{x}^{2}+1)f(x) & ={lim}_{x\\to -4}(2{x}^{2}+1)\\cdot {lim}_{x\\to -4}f(x) \\\\  & =(2\\cdot (-4)^{2}+1)\\cdot (2) \\\\  & =66\\,.\\end{aligned}\n$$"} :step/id #uuid "a83fb1c7-539b-570e-8e59-c06ea48e47e1"} {:db/id #edb/ref 17592186521651 :step/content {:db/id #edb/ref 17592186521537 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4660fdd8-5261-5c4e-bc67-7363b74699d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186520920} {:answer/id #uuid "71617208-0858-502e-bb7b-40761d03d4d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186521018} {:answer/id #uuid "90bb2958-b97e-5235-b2bd-23dc8aa76027" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186521093} {:answer/id #uuid "a2416292-adfa-5246-a3d7-f18168238265" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186521128} {:answer/id #uuid "bcd4397a-616a-58ad-bf05-1dd4260c9cec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186521186}] :answer-field/correct {:db/id #edb/ref 17592186521093} :answer-field/id #uuid "9a6654db-527e-57c6-a150-229af646b191" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186521402}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a5e8422b-8be3-5e23-8b9e-af4b866bbaf9" :question/math-academy-id "q-100100" :question/problem "![](images/3c/3cc4f4447ee6fb212222b28c7e4c31cca435c542e3d2f25ae3f3331a3b98da2b.png)\n\nThe figure above shows the graphs of $y=f(x)$ and $y=g(x).$ Evaluate ${lim}_{x\\to \\,2}\\frac{f(x)+2g(x)}{1+xg(x)}.$" :question/worked-solution "Using the quotient rule, we have\n\n$$\n{lim}_{x\\to \\,2}\\frac{f(x)+2g(x)}{1+xg(x)}=\\frac{{lim}_{x\\to \\,2}(f(x)+2g(x))}{{lim}_{x\\to \\,2}(1+xg(x))}.\n$$\n\nWe find from the graph that  ${lim}_{x\\to \\,2}f(x)=6$  and ${lim}_{x\\to \\,2}g(x)=2.$ Calculating the limits of the numerator and denominator separately, we have\n\n$$\n{lim}_{x\\to \\,2}(f(x)+2g(x))=6+2(2)=10\n$$\n\nand\n\n$$\n{lim}_{x\\to \\,2}(1+xg(x))=1+2(2)=5.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,2}\\frac{f(x)+2g(x)}{1+xg(x)}=\\frac{10}{5}=2.\\end{aligned}\n$$"} :step/id #uuid "e9b4f224-2dd0-5bdc-bfd2-a9d142fc0bad" :step/next {:db/id #edb/ref 17592186521628}}] :activity/title "The Product and Quotient Rules for Limits" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186520754}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186552621} :activity/id #uuid "0b919ae5-7f21-5720-9292-e5c3ef85a8c2" :activity/scope {:db/id #edb/ref 17592186049226 :topic/id #uuid "e4f7b310-649d-511b-ae6e-709dcea1f6cd" :topic/math-academy-id 1246} :activity/steps [{:db/id #edb/ref 17592186552531 :step/content {:db/id #edb/ref 17592186552420 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fbba08c-67df-5ead-8409-25f8358c6ec5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186551854}] :answer-field/correct {:db/id #edb/ref 17592186551854} :answer-field/id #uuid "8b424413-3cc6-545c-affb-ca63eecbfa1f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186552335}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "23394483-7f6f-560b-bb8e-2bc28d2cef6c" :question/math-academy-id "q-300754" :question/problem "${lim}_{x\\to -5}\\frac{4x}{x+1}=${{field-1}}" :question/worked-solution "Applying the quotient rule for limits, we get\n\n$$\n\\begin{aligned}{lim}_{x\\to -5}\\frac{4x}{x+1} & =\\frac{{lim}_{x\\to -5}4x}{{lim}_{x\\to -5}(x+1)} \\\\  & =\\frac{4(-5)}{-5+1} \\\\  & =\\frac{-20}{-4} \\\\  & =5.\\end{aligned}\n$$"} :step/id #uuid "065eaab1-7627-57b9-9ca3-6d0fd8d28eef" :step/next {:db/id #edb/ref 17592186552599}} {:db/id #edb/ref 17592186552599 :step/content {:db/id #edb/ref 17592186552511 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "683e1f83-d5f2-5e5b-a5ae-2e14582f49ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186551908}] :answer-field/correct {:db/id #edb/ref 17592186551908} :answer-field/id #uuid "38969d03-7d07-5623-8a2e-c4b68014d499" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186552284}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d97c91f1-911f-5cfb-8ef6-5119b61716cb" :question/math-academy-id "q-337820" :question/problem "${lim}_{x\\to -1}\\frac{{x}^{2}-4}{1-{x}^{3}}=${{field-1}}" :question/worked-solution "Applying the quotient rule for limits, we get\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}\\frac{{x}^{2}-4}{1-{x}^{3}} & =\\frac{{lim}_{x\\to -1}({x}^{2}-4)}{{lim}_{x\\to -1}(1-{x}^{3})} \\\\  & =\\frac{(-1)^{2}-4}{1-(-1)^{3}} \\\\  & =-\\frac{3}{2}.\\end{aligned}\n$$"} :step/id #uuid "be062c35-6f02-540a-b7eb-cdb1e9f78627"} {:db/id #edb/ref 17592186552621 :step/content {:db/id #edb/ref 17592186552523 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "001cfea2-3243-502b-b681-07c2629016e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186551666} {:answer/id #uuid "66e43f57-628e-574d-bee1-02e70161c111" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186551905} {:answer/id #uuid "9439c322-08c4-5fa6-bac1-93c4c63c5670" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186552024} {:answer/id #uuid "c8b0522c-e278-5eeb-8757-ae6ef8f633e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186552144} {:answer/id #uuid "df91c407-dea9-56f7-b110-9a3515844db4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186552185}] :answer-field/correct {:db/id #edb/ref 17592186551905} :answer-field/id #uuid "da132908-34e5-5c70-9173-d7d64df32ee0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186552379}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f41c0540-27ef-5b47-a626-2808486f0487" :question/math-academy-id "q-100081" :question/problem "![](images/ea/ea804b5eb5c4af6aace19a66008dfbf9b130f1e1e38c2d8d9d811e9cad4c413c.png)\n\nFind ${lim}_{x\\to 0}\\frac{({x}^{2}-1)}{f(x)}$ for the function $f(x)$ plotted above." :question/worked-solution "We find from the graph that ${lim}_{x\\to 0}f(x)$ does not exist, therefore\n \n\n$$\n{lim}_{x\\to 0}\\frac{({x}^{2}-1)}{f(x)}=\\frac{{lim}_{x\\to 0}({x}^{2}-1)}{{lim}_{x\\to 0}f(x)}=\\text{DNE}.\n$$"} :step/id #uuid "fd89298a-27b4-57ea-9111-dc596a8d593d" :step/next {:db/id #edb/ref 17592186552531}}] :activity/title "The Product and Quotient Rules for Limits" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186551646}]}
