#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186552621} :activity/id #uuid "0b919ae5-7f21-5720-9292-e5c3ef85a8c2" :activity/scope {:db/id #edb/ref 17592186049226 :topic/id #uuid "e4f7b310-649d-511b-ae6e-709dcea1f6cd" :topic/math-academy-id 1246} :activity/steps [{:db/id #edb/ref 17592186552531 :step/content {:db/id #edb/ref 17592186552420 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fbba08c-67df-5ead-8409-25f8358c6ec5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186551854}] :answer-field/correct {:db/id #edb/ref 17592186551854} :answer-field/id #uuid "8b424413-3cc6-545c-affb-ca63eecbfa1f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186552335}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "23394483-7f6f-560b-bb8e-2bc28d2cef6c" :question/math-academy-id "q-300754" :question/problem "${lim}_{x\\to -5}\\frac{4x}{x+1}=${{field-1}}" :question/worked-solution "Applying the quotient rule for limits, we get\n\n$$\n\\begin{aligned}{lim}_{x\\to -5}\\frac{4x}{x+1} & =\\frac{{lim}_{x\\to -5}4x}{{lim}_{x\\to -5}(x+1)} \\\\  & =\\frac{4(-5)}{-5+1} \\\\  & =\\frac{-20}{-4} \\\\  & =5.\\end{aligned}\n$$"} :step/id #uuid "065eaab1-7627-57b9-9ca3-6d0fd8d28eef" :step/next {:db/id #edb/ref 17592186552599}} {:db/id #edb/ref 17592186552599 :step/content {:db/id #edb/ref 17592186552511 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "683e1f83-d5f2-5e5b-a5ae-2e14582f49ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186551908}] :answer-field/correct {:db/id #edb/ref 17592186551908} :answer-field/id #uuid "38969d03-7d07-5623-8a2e-c4b68014d499" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186552284}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d97c91f1-911f-5cfb-8ef6-5119b61716cb" :question/math-academy-id "q-337820" :question/problem "${lim}_{x\\to -1}\\frac{{x}^{2}-4}{1-{x}^{3}}=${{field-1}}" :question/worked-solution "Applying the quotient rule for limits, we get\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}\\frac{{x}^{2}-4}{1-{x}^{3}} & =\\frac{{lim}_{x\\to -1}({x}^{2}-4)}{{lim}_{x\\to -1}(1-{x}^{3})} \\\\  & =\\frac{(-1)^{2}-4}{1-(-1)^{3}} \\\\  & =-\\frac{3}{2}.\\end{aligned}\n$$"} :step/id #uuid "be062c35-6f02-540a-b7eb-cdb1e9f78627"} {:db/id #edb/ref 17592186552621 :step/content {:db/id #edb/ref 17592186552523 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "001cfea2-3243-502b-b681-07c2629016e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186551666} {:answer/id #uuid "66e43f57-628e-574d-bee1-02e70161c111" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186551905} {:answer/id #uuid "9439c322-08c4-5fa6-bac1-93c4c63c5670" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186552024} {:answer/id #uuid "c8b0522c-e278-5eeb-8757-ae6ef8f633e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186552144} {:answer/id #uuid "df91c407-dea9-56f7-b110-9a3515844db4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186552185}] :answer-field/correct {:db/id #edb/ref 17592186551905} :answer-field/id #uuid "da132908-34e5-5c70-9173-d7d64df32ee0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186552379}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f41c0540-27ef-5b47-a626-2808486f0487" :question/math-academy-id "q-100081" :question/problem "![](images/ea/ea804b5eb5c4af6aace19a66008dfbf9b130f1e1e38c2d8d9d811e9cad4c413c.png)\n\nFind ${lim}_{x\\to 0}\\frac{({x}^{2}-1)}{f(x)}$ for the function $f(x)$ plotted above." :question/worked-solution "We find from the graph that ${lim}_{x\\to 0}f(x)$ does not exist, therefore\n \n\n$$\n{lim}_{x\\to 0}\\frac{({x}^{2}-1)}{f(x)}=\\frac{{lim}_{x\\to 0}({x}^{2}-1)}{{lim}_{x\\to 0}f(x)}=\\text{DNE}.\n$$"} :step/id #uuid "fd89298a-27b4-57ea-9111-dc596a8d593d" :step/next {:db/id #edb/ref 17592186552531}}] :activity/title "The Product and Quotient Rules for Limits" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186551646}]}
