:db/ident :answer.type/math} :answer/value "(1,1)" :db/id #edb/ref 17592186575074} {:answer/id #uuid "4f20dcdd-e642-5844-8b02-166600b6c2e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-1)" :db/id #edb/ref 17592186575083} {:answer/id #uuid "8f6cb8d7-7aae-5539-8ff7-d15820c1d709" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,1)" :db/id #edb/ref 17592186575195} {:answer/id #uuid "bbe4a972-90eb-5f47-b61f-d94a3c696e0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,1)" :db/id #edb/ref 17592186575285}] :answer-field/correct {:answer/id #uuid "8f6cb8d7-7aae-5539-8ff7-d15820c1d709" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,1)" :db/id #edb/ref 17592186575195} :answer-field/id #uuid "70884a80-03f4-56de-8e4c-1d5cee316b31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575463}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "05fcb668-c7a9-5251-bb06-4685eeabb241" :question/math-academy-id "q-26412" :question/problem "The point $Q$ with coordinates $(1,1)$ lies on the curve $y=f(x).$ Which of the following points must lie on $y=f(-x)?$" :question/worked-solution "The transformation $y=f(-x)$ reflects the curve $y=f(x)$ in the $y$-axis.\n\nFirst, notice that the point $P(1,1)$ lies $1$ unit to the *right* from the $y$-axis. So, under the action of the transformation, this point will be reflected $1$ unit to the *left* from the $y$-axis.\n\n![](images/e3/e39b804eef0617e89d43808793c844f1223a427493e8b6554cc7ad25477f7ddc.png)\n\nWe conclude that the point $(-1,1)$ must lie on the graph of $y=f(-x).$"}]}
