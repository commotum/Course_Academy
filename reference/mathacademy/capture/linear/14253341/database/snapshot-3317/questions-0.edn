7592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575426}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "96a48954-07a7-579b-872e-b1d2125e9254" :question/math-academy-id "q-16701" :question/problem "![](images/5d/5dee325f7573921b78c49390ed758bb03198f72d228b1b70d7a1026822ce8940.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following is the graph of $y=f(-x)?$" :question/worked-solution "To obtain the graph of $y=f(-x)$ from $y=f(x)$, we need to reflect the graph over the $y$-axis. The resulting graph is shown below.\n\n![](images/5b/5bc873a8b2794adeb1e54dd5f177b95da8644fcf3af5db5865adbe3869cc0693.png)"}] [{:db/id #edb/ref 17592186575594 :knowledge-point/_questions [{:db/id #edb/ref 17592186115262 :knowledge-point/id #uuid "8ecd0f74-19c3-5770-b376-4d945320f06f" :knowledge-point/title "Sketching the Graph of a Horizontally Reflected Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "123a28e5-2596-5414-b107-e737a6c9809e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/12/1231e74f71e3bf8172629eaae42d529f2a9acda1135745f42a069bfbe16240c5.png" :db/id #edb/ref 17592186574980} {:answer/id #uuid "282b3e8e-b2ea-5612-81d3-66d069d00206" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/83/83ee04eb14ca3ab7e62f12dcc3fffdb7713ad9807476f6c5dd9fa3f5555dfb86.png" :db/id #edb/ref 17592186575010} {:answer/id #uuid "81d34127-327b-5935-b521-8e7cbdfc81ac" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/35/352b02aa03514ee0d5fc5a988ad78efeac32bd850be61bacc6ee7991b5ecae5a.png" :db/id #edb/ref 17592186575181} {:answer/id #uuid "df3a02bf-a38f-51f2-afbe-92469956aaef" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/76/76c556f6f364169491ce1caaf3b4a9400ecaa2f5905c6f3feaf12e7ee0e5a1d