#{[{:db/id #edb/ref 17592186176330 :knowledge-point/_questions [{:db/id #edb/ref 17592186176031 :knowledge-point/id #uuid "534de76f-d4bc-55b5-858e-2b594f63b7bc" :knowledge-point/title "Calculating Distance Given Speed and Time"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "525b1435-446e-5cc8-b37a-149995820d54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$450$ meters" :db/id #edb/ref 17592186266880} {:answer/id #uuid "66e533d2-4c01-51d3-8d6a-bc619964e5c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$100$ meters" :db/id #edb/ref 17592186267058} {:answer/id #uuid "9ac08d0f-968e-5d01-a884-a9815baeb075" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$475$ meters" :db/id #edb/ref 17592186267542} {:answer/id #uuid "badac45f-a62d-5f10-a7fc-f10e5130889c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$525$ meters" :db/id #edb/ref 17592186267820} {:answer/id #uuid "e4807d87-8bd0-535b-b462-cacbb2f06a4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$95$ meters" :db/id #edb/ref 17592186268163}] :answer-field/correct {:answer/id #uuid "9ac08d0f-968e-5d01-a884-a9815baeb075" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$475$ meters" :db/id #edb/ref 17592186267542} :answer-field/id #uuid "94bfc4c7-03c0-5588-b13f-c2f5df334ad4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268666}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "09b93451-12f0-5b32-9bbf-d323d2f03aae" :question/math-academy-id "q-133999" :question/problem "It takes a particular person $2$ minutes to walk $190$ meters. Find the distance this person covers in $5$ minutes." :question/worked-solution "Speed is a special unit rate applied to moving objects. It is defined as *the distance traveled per unit of time*:\n\n$$\n\\text{speed}=\\frac{\\text{distance}}{\\text{time}}\n$$\n\nTo find the speed in meters per minute, we divide the number of meters, $190,$ by the number of minutes, $2.$ This gives,\n\n$$\n\\begin{aligned}\\frac{190}{2} & =190÷2 \\\\  & =95.\\end{aligned}\n$$\n\nSo, the speed of the person is $95$ meters per minute. \n\nTo find the distance covered in $5$ minutes, we multiply the speed by $5.$ This gives\n\n$$\n\\begin{aligned}\\text{distance} & =\\text{speed}\\times \\text{time} \\\\  & =95\\times 5 \\\\  & =475.\\end{aligned}\n$$\n\nTherefore, the person can cover $475$ meters in $5$ minutes."}] [{:db/id #edb/ref 17592186138830 :knowledge-point/_questions [{:db/id #edb/ref 17592186138560 :knowledge-point/id #uuid "c2c48d15-4749-5c47-bc97-a5584216cf2e" :knowledge-point/title "Calculating the Value of an Unknown Quantity Using Collinearity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c338da01-40d0-533e-b821-77604def14ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186135929} {:answer/id #uuid "db1d49dd-bc18-5fe3-91a1-3431242f9048" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186135930} {:answer/id #uuid "e830039a-2929-5789-8fe0-f754442da840" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186135931} {:answer/id #uuid "07ff6d86-3f68-577c-9d28-e060610f49ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186135932} {:answer/id #uuid "58e63d00-a251-5db0-abf7-53ffa4376722" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186135933}] :answer-field/id #uuid "374553a7-81ee-5a81-93c7-e95