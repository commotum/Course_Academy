s "answer-edbe36c3-a177-5880-8f06-3e428a4c8d4a"] ["answer-field-0164330c-13ad-5c34-8a92-9c663242c3e8" :answer-field/choices "answer-49703cc4-994a-5bf9-b7e9-098365af9c02"] ["answer-field-0164330c-13ad-5c34-8a92-9c663242c3e8" :answer-field/choices "answer-f1b4cc3c-3632-59a9-b0af-fab5fb549bdb"] ["question-78772149-6410-5606-9ad3-23c6e01f9b0e" :question/answer-fields "answer-field-0164330c-13ad-5c34-8a92-9c663242c3e8"] [17592186115408 :knowledge-point/questions "question-78772149-6410-5606-9ad3-23c6e01f9b0e"] ["question-093f60b7-b595-5220-994a-63101bc04a42" :question/id #uuid "093f60b7-b595-5220-994a-63101bc04a42"] ["question-093f60b7-b595-5220-994a-63101bc04a42" :question/math-academy-id "q-171160"] ["question-093f60b7-b595-5220-994a-63101bc04a42" :question/problem "The lowest common denominator of $\\frac{5}{7}$ and $\\frac{1}{2}$ is{{field-1}}."] ["question-093f60b7-b595-5220-994a-63101bc04a42" :question/worked-solution "To find the lowest common denominator of two fractions, we first find the prime factorization of both denominators. \n\nSince the denominators $7$ and $2$ are prime numbers, they are already represented by their respective prime factorizations. \n\nNow, we write down each prime factor, and we raise each factor to the highest power given in either factorization:\n\n- the highest power of $7$ is $1$\n\n- the highest power of $2$ is also $1$\n\nTherefore, the lowest common denominator is ${7}^{1}\\cdot {2}^{1}=14.$"] ["question-093f60b7-b595-5220-994a-63101bc04a42" :question/difficulty :question.difficulty/easy] ["answer-field-56ea52af-12b6-5644-b4a6-ed05e7a0427f" :answer-field/id #uuid "56ea52af-12b6-5644-b4a6-ed05e7a0427f"] ["answer-0fc56540-d358-50d3-b73a-c0b1425f94b5" :answer/id #uuid "0fc56540-d358-50d3-b73a-c0b1425f94b5"] ["answer-0fc56540-d358-50d3-b73a-c0b1425f94b5" :answer/type :answer.type/math] ["answer-0fc56540-d358-50d3-b73a-c0b1425f94b5" :answer/value "14"] ["answer-field-56ea52af-12b6-5644-b4a6-ed05e7a0427f" :answer-field/key "field-1"] [