stion-e8061560-b60f-50e8-a1e6-e8fcd0b1f879" :step/next "step-af473a3b-d261-5719-88fc-cd279c0b70e5" :db/ensure [:step/validate]} {:db/id "step-af473a3b-d261-5719-88fc-cd279c0b70e5" :step/id #uuid "af473a3b-d261-5719-88fc-cd279c0b70e5" :step/content "question-01d6b59b-be2b-52a2-b7cf-129c1864b658" :step/next "step-1945aad4-ec78-547d-9bd0-70ae80932ccf" :db/ensure [:step/validate]} {:db/id "step-1945aad4-ec78-547d-9bd0-70ae80932ccf" :step/id #uuid "1945aad4-ec78-547d-9bd0-70ae80932ccf" :step/content "question-d77788ff-b482-51d4-bdb1-79e3cff6db85" :step/next "step-e047b69d-3db6-52d0-bf3d-6c688a3ce9c0" :db/ensure [:step/validate]} {:db/id "step-e047b69d-3db6-52d0-bf3d-6c688a3ce9c0" :step/id #uuid "e047b69d-3db6-52d0-bf3d-6c688a3ce9c0" :step/content "question-78772149-6410-5606-9ad3-23c6e01f9b0e" :step/next "step-ed5c5991-e25b-5506-8cce-f164e5317337" :db/ensure [:step/validate]} {:db/id "step-ed5c5991-e25b-5506-8cce-f164e5317337" :step/id #uuid "ed5c5991-e25b-5506-8cce-f164e5317337" :step/content "question-093f60b7-b595-5220-994a-63101bc04a42" :db/ensure [:step/validate]}] "assertions" [["question-d64cbb84-4920-5e00-a5fb-dd325fcf710c" :question/id #uuid "d64cbb84-4920-5e00-a5fb-dd325fcf710c"] ["question-d64cbb84-4920-5e00-a5fb-dd325fcf710c" :question/math-academy-id "q-60981"] ["question-d64cbb84-4920-5e00-a5fb-dd325fcf710c" :question/problem "If $\\,\\boxed{}\\times 40%=32,$ then $\\,\\boxed{}=$"] ["question-d64cbb84-4920-5e00-a5fb-dd325fcf710c" :question/worked-solution "The part is $32,$ the percentage is $40%,$ and we need to find the whole.\n\nTo do this, we can use the following formula:\n\n$$\n\\text{whole}=\\text{part}÷\\text{percentage}\n$$\n\nBefore we can substitute our numbers into the formula, we need to express $40%$ as a fraction:\n\n$$\n\\frac{40}{100}=\\frac{40÷20}{100÷20}=\\frac{2}{5}\n$$\n\nWe can now substitute our numbers into the formula, as follows:\n\n$$\n\\begin{aligned}\\text{whole} & =32÷40% \\\\  & =32÷\\frac{2}{5} \\\\  & =32\\times \\frac{5}{2} \\\\  & =\\frac{32}{2}\\times 5 \\\\  & =16\\times 5 \\\\  & =80\\end{aligned}\n$$"] ["question-d64cbb84-4920-5e00-a5fb-dd325fcf710c" :question/difficulty :question.difficulty/moderate] ["answer-field-bcf715fb-fd7f-5fbf-bbe8-06f12ca3c63d" :answer-field/id #uuid "bcf715fb-fd7f-5fbf-bbe8-06f12ca3c63d"] ["answer-f43fb12c-ca5e-5bb9-a117-52a4220abfd0" :answer/id #uuid "f43fb12c-ca5e-5bb9-a117-52a4220abfd0"] ["answer-f43fb12c-ca5e-5bb9-a117-52a4220abfd0" :answer/type :answer.type/math] ["answer-f43fb12c-ca5e-5bb9-a117-52a4220abfd0" :answer/value "60"] ["answer-7408b52e-5e63-584d-aca1-f327f1bffed4" :answer/id #uuid "7408b52e-5e63-584d-aca1-f327f1bffed4"] ["answer-7408b52e-5e63-584d-aca1-f327f1bffed4" :answer/type :answer.type/math] ["answer-7408b52e-5e63-584d-aca1-f327f1bffed4" :answer/value "68"] ["answer-99f37d1a-01b6-5eb6-896e-d89a1c5d9202" :answer/id #uuid "99f37d1a-01b6-5eb6-896e-d89a1c5d9202"] ["answer-99f37d1a-01b6-5eb6-896e-d89a1c5d9202" :answer/type :answer.type/math] ["answer-99f37d1a-01b6-5eb6-896e-d89a1c5d9202" :answer/value "76"] ["answer-4fbab777-784f-5143-ac9a-4ea8efece70e" :answer/id #uuid "4fbab777-784f-5143-ac9a-4ea8efece70e"] ["answer-4fbab777-784f-5143-ac9a-4ea8efece70e" :answer/type :answer.type/math] ["answer-4fbab777-784f-5143-ac9a-4ea8efece70e" :answer/value "80"] ["answer-03e9cf25-ab69-52a6-934c-62bdcbd01856" :answer/id #uuid "03e9cf25-ab69-52a6-934c-62bdcbd01856"] ["answer-03e9cf25-ab69-52a6-934c-62bdcbd01856" :answer/type :answer.type/math] ["answer-03e9cf25-ab69-52a6-934c-62bdcbd01856" :answer/value "84"] ["answer-field-bcf715fb-fd7f-5fbf-bbe8-06f12ca3c63d" :answer-field/key "selection"] ["answer-field-bcf715fb-fd7f-5fbf-bbe8-06f12ca3c63d" :answer-field/type :answer-field.type/radio] ["answer-field-bcf715fb-fd7f-5fbf-bbe8-06f12ca3c63d" :answer-field/correct "answer-4fbab777-784f-5143-ac9a-4ea8efece70e"] ["answer-field-bcf715fb-fd7f-5fbf-bbe8-06f12ca3c63d" :answer-field/choices "answer-f43fb12c-ca5e-5bb9-a117-52a4220abfd0"] ["answer-field-bcf715fb-fd7f-5fbf-bbe8-06f12ca3c63d" :answer-field/choices "answer-7408b52e-5e63-584d-aca1-f327f1bffed4"] ["answer-field-bcf715fb-fd7f-5fbf-bbe8-06f12ca3c63d" :answer-field/choices "answer-99f37d1a-01b6-5eb6-896e-d89a1c5d9202"] ["answer-field-bcf715fb-fd7f-5fbf-bbe8-06f12ca3c63d" :answer-field/choices "answer-4fbab777-784f-5143-ac9a-4ea8efece70e"] ["answer-field-bcf715fb-fd7f-5fbf-bbe8-06f12ca3c63d" :answer-field/choices "answer-03e9cf25-ab69-52a6-934c-62bdcbd01856"] ["question-d64cbb84-4920-5e00-a5fb-dd325fcf710c" :question/answer-fields "answer-field-bcf715fb-fd7f-5fbf-bbe8-06f12ca3c63d"] [17592186147575 :knowledge-point/questions "question-d64cbb84-4920-5e00-a5fb-dd325fcf710c"] [17592186138830 :question/problem "![](images/a3/a3495fce9e81ae42fd279c91c964d7780daa1736c8a0c600dd2810a40f4ccbe8.png)\n\nGiven the diagram shown above, what is the value of $x?$"] [17592186138830 :question/worked-solution "By the segment addition postulate, we have\n\n$$\nAD=AB+BC+CD.\n$$\n\nTo solve for $x,$ we can substitute the given information\n\n$$\nAD=17,\\,AB=x-2,\\,BC=9,\\,CD=2x-5,\n$$\n\n \n\nand then solve the resulting equation:\n\n$$\n\\begin{aligned}AD & =AB+BC+CD \\\\ 17 & =(x-2)+9+(2x-5) \\\\ 17 & =3x+2 \\\\ 3x & =15 \\\\ x & =5\\end{aligned}\n$$"] [17592186138830 :question/difficulty :question.difficulty/moderate] [17592186135928 :answer-field/correct 17592186135929] ["question-a1a77f56-694e-539a-a24b-49a13b3865ca" :question/id #uuid "a1a77f56-694e-539a-a24b-49a13b3865ca"] ["question-a1a77f56-694e-539a-a24b-49a13b3865ca" :question/math-academy-id "q-5926"] ["question-a1a77f56-694e-539a-a24b-49a13b3865ca" :question/problem "![](images/c3/c3a31aad745cafe59f0c15e56dd48bf9350e46c08e148b843a6904145934e46b.png)\n\nSolve for $x$ given the figure above."] ["question-a1a77f56-694e-539a-a24b-49a13b3865ca" :question/worked-solution "Since the two angles are supplementary, the sum of their measures is equal to ${180}^{∘}.$ Therefore:\n\n$$\n\\begin{aligned}{48}^{∘}+(x+{42}^{∘}) & ={180}^{∘} \\\\ x+{90}^{∘} & ={180}^{∘} \\\\ x & ={90}^{∘}\\end{aligned}\n$$"] ["question-a1a77f56-694e-539a-a24b-49a13b3865ca" :question/difficulty :question.difficulty/easy] ["answer-field-f15dd0ad-8bf1-5e1c-8d76-6465ccbd4d24" :answer-field/id #uuid "f15dd0ad-8bf1-5e1c-8d76-6465ccbd4d24"] ["answer-a3917857-9aaa-5c34-bf67-fac980d43439" :answer/id #uuid "a3917857-9aaa-5c34-bf67-fac980d43439"] ["answer-a3917857-9aaa-5c34-bf67-fac980d43439" :answer/type :answer.type/math] ["answer-a3917857-9aaa-5c34-bf67-fac980d43439" :answer/value "{80}^{∘}"] ["answer-42be2e85-427d-5ed0-b65f-e28375ab57c1" :answer/id #uuid "42be2e85-427d-5ed0-b65f-e28375ab57c1"] ["answer-42be2e85-427d-5ed0-b65f-e28375ab57c1" :answer/type :answer.type/math] ["answer-42be2e85-427d-5ed0-b65f-e28375ab57c1" :answer/value "{87}^{∘}"] ["answer-640dc449-205d-57f4-9327-7faa378ccea1" :answer/id #uuid "640dc449-205d-57f4-9327-7faa378ccea1"] ["answer-640dc449-205d-57f4-9327-7faa378ccea1" :answer/type :answer.type/math] ["answer-640dc449-205d-57f4-9327-7faa378ccea1" :answer/value "{90}^{∘}"] ["answer-3f982969-e29b-5dcb-b520-dd0b13eb6833" :answer/id #uuid "3f982969-e29b-5dcb-b520-dd0b13eb6833"] ["answer-3f982969-e29b-5dcb-b520-dd0b13eb6833" :answer/type :answer.type/math] ["answer-3f982969-e29b-5dcb-b520-dd0b13eb6833" :answer/value "{92}^{∘}"] ["answer-c6250ade-5d8e-5049-bd28-9494165c15e0" :answer/id #uuid "c6250ade-5d8e-5049-bd28-9494165c15e0"] ["answer-c6250ade-5d8e-5049-bd28-9494165c15e0" :answer/type :answer.type/math] ["answer-c6250ade-5d8e-5049-bd28-9494165c15e0" :answer/value "{96}^{∘}"] ["answer-field-f15dd0ad-8bf1-5e1c-8d76-6465ccbd4d24" :answer-field/key "selection"] ["answer-field-f15dd0ad-8bf1-5e1c-8d76-6465ccbd4d24" :answer-field/type :answer-field.type/radio] ["answer-field-f15dd0ad-8bf1-5e1c-8d76-6465ccbd4d24" :answer-field/correct "answer-640dc449-205d-57f4-9327-7faa378ccea1"] ["answer-field-f15dd0ad-8bf1-5e1c-8d76-6465ccbd4d24" :answer-field/choices "answer-a3917857-9aaa-5c34-bf67-fac980d43439"] ["answer-f