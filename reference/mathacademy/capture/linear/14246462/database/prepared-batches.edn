8 & =k\\end{aligned}\n$$\n\nSo, the inverse variation is given by \n\n$$\ny=\\frac{8}{x}.\n$$\n\nFinally, substituting the value of $x=\\frac{4}{5}$ into this equation gives\n\n$$\n\\begin{aligned}y & =\\frac{8}{(\\frac{4}{5})} \\\\  & =8÷\\frac{4}{5} \\\\  & =8\\cdot \\frac{5}{4} \\\\  & =\\frac{40}{4} \\\\  & =10.\\end{aligned}\n$$"] ["question-dfc98e96-f028-5cd6-8e89-3ae59a19563f" :question/difficulty :question.difficulty/hard] ["answer-field-47ecb024-2722-561f-8432-d98acd72fb24" :answer-field/id #uuid "47ecb024-2722-561f-8432-d98acd72fb24"] ["answer-27489401-06a5-55b9-b5cd-4c561edb32eb" :answer/id #uuid "27489401-06a5-55b9-b5cd-4c561edb32eb"] ["answer-27489401-06a5-55b9-b5cd-4c561edb32eb" :answer/type :answer.type/math] ["answer-27489401-06a5-55b9-b5cd-4c561edb32eb" :answer/value "10"] ["answer-1e456658-a42b-5e79-b5ed-3a3fe1823913" :answer/id #uuid "1e456658-a42b-5e79-b5ed-3a3fe1823913"] ["answer-1e456658-a42b-5e79-b5ed-3a3fe1823913" :answer/type :answer.type/math] ["answer-1e456658-a42b-5e79-b5ed-3a3fe1823913" :answer/value "4"] ["answer-aaf57b44-4131-58a8-9c32-4175e4939bf5" :answer/id #uuid "aaf57b44-4131-58a8-9c32-4175e4939bf5"] ["answer-aaf57b44-4131-58a8-9c32-4175e4939bf5" :answer/type :answer.type/math] ["answer-aaf57b44-4131-58a8-9c32-4175e4939bf5" :answer/value "8"] ["answer-5f4845bc-6bd1-523b-9b3b-cd826c584ce3" :answer/id #uuid "5f4845bc-6bd1-523b-9b3b-cd826c584ce3"] ["answer-5f4845bc-6bd1-523b-9b3b-cd826c584ce3" :answer/type :answer.type/math] ["answer-5f4845bc-6bd1-523b-9b3b-cd826c584ce3" :answer/value "\\frac{5}{2}"] ["answer-3934a817-e1ce-57d9-a908-f6163578ca88" :answer/id #uuid "3934a817-e1ce-57d9-a908-f6163578ca88"] ["answer-3934a817-e1ce-57d9-a908-f6163578ca88" :answer/type :answer.type/math] ["answer-3934a817-e1ce-57d9-a908-f6163578ca88" :answer/value "\\frac{5}{4}"] ["answer-field-47ecb024-2722-561f-8432-d98acd72fb24" :answer-field/key "selection"] ["answer-field-47ecb024-2722-561f-8432-d98acd72fb24" :answer-field/type :answer-field.type/radio] ["answer-field-47ecb024-2722-561f-8432-d98acd72fb24" :answer-field/correct "answer-27489401-06a5-55b9-b5cd-4c561edb32eb"] ["answer-field-47ecb024-2722-561f-8432-d98acd72fb24" :answer-field/choices "answer-27489401-06a5-55b9-b5cd-4c561edb32eb"] ["answer-field-47ecb024-2722-561f-8432-d98acd72fb24" :answer-field/choices "answer-1e456658-a42b-5e79-b5ed-3a3fe1823913"] ["answer-field-47ecb024-2722-561f-8432-d98acd72fb24" :answer-field/choices "answer-aaf57b44-4131-58a8-9c32-4175e4939bf5"] ["answer-field-47ecb024-2722-561f-8432-d98acd72fb24" :answer-field/choices "answer-5f4845bc-6bd1-523b-9b3b-cd826c584ce3"] ["answer-field-47ecb024-2722-561f-8432-d98acd72fb24" :answer-field/choices "answer-3934a817-e1ce-57d9-a908-f6163578ca88"] ["question-dfc98e96-f028-5cd6-8e89-3ae59a19563f" :question/answer-fields "answer-field-47ecb024-2722-561f-8432-d98acd72fb24"] [17592186138414 :knowledge-point/questions "question-dfc98e96-f028-5cd6-8e89-3ae59a19563f"] ["question-e8061560-b60f-50e8-a1e6-e8fcd0b1f879" :question/id #uuid "e8061560-b60f-50e8-a1e6-e8fcd0b1f879"] ["question-e8061560-b60f-50e8-a1e6-e8fcd0b1f879" :question/math-academy-id "q-215145"] ["question-e8061560-b60f-50e8-a1e6-e8fcd0b1f879" :question/problem "Solve for $y$ where $-\\frac{1}{2y+7}=\\frac{4}{5y-2}.$\n\n$y=$\n{{field-1}}"] ["question-e8061560-b60f-50e8-a1e6-e8fcd0b1f879" :question/worked-solution "First, note that $y=-\\frac{7}{2}$ and $y=\\frac{2}{5}$ cannot be solutions since division by $0$ is undefined.\n\nTo solve the equation, we move the negative sign onto the numerator of the fraction and then apply cross-multiplication:\n\n$$\n\\begin{aligned}-\\frac{1}{2y+7} & =\\frac{4}{5y-2} \\\\ \\frac{-1}{2y+7} & =\\frac{4}{5y-2} \\\\ (-1)\\cdot (5y-2) & =(2y+7)\\cdot 4 \\\\ -5y+2 & =8y+28\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}-5y+2 & =8y+28 \\\\ -5y+2+5y & =8y+28+5y \\\\ 2 & =13y+28 \\\\ 2-28 & =13y+28-28 \\\\ -26 & =13y \\\\ \\frac{-26}{13} & =\\frac{13y}{13} \\\\ -2 & =y\\end{aligned}\n$$\n\nSince $y=-2$ is different from $y=-\\frac{7}{2}$ and $y=\\frac{2}{5},$ we can accept it as a solution. Thus, the solution is $y=-2.$"] ["question-e8061560-b60f-50e8-a1e6-e8fcd0b1f879" :question/difficulty :question.difficulty/moderate] ["answer-field-4382b096-445d-57f5-877e-794cba2c5eef" :answer-field/id #uuid "4382b096-445d-57f5-877e-794cba2c5eef"] ["answer-034dcf22-431a-57bb-93c4-4c3872d74663" :answer/id #uuid "034dcf22-431a-57bb-93c4-4c3872d74663"] ["answer-034dcf22-431a-57bb-93c4-4c3872d74663" :answer/type :answer.type/math] ["answer-034dcf22-431a-57bb-93c4-4c3872d74663" :answer/value "-2"] ["answer-field-4382b096-445d-57f5-877e-794cba2c5eef" :answer-field/key "field-1"] ["answer-field-4382b096-445d-57f5-877e-794cba2c5eef" :answer-field/type :answer-field.type/blank] ["answer-field-4382b096-445d-57f5-877e-794cba2c5eef" :answer-field/correct "answer-034dcf22-431a-57bb-93c4-4c3872d74663"] ["answer-field-4382b096-445d-57f5-877e-794cba2c5eef" :answer-field/choices "answer-034dcf22-431a-57bb-93c4-4c3872d74663"] ["question-e8061560-b60f-50e8-a1e6-e8fcd0b1f879" :question/answer-fields "answer-field-4382b096-445d-57f5-877e-794cba2c5eef"] [17592186175908 :knowledge-point/questions "question-e8061560-b60f-50e8-a1e6-e8fcd0b1f879"] ["question-01d6b59b-be2b-52a2-b7cf-129c1864b658" :question/id #uuid "01d6b59b-be2b-52a2-b7cf-129c1864b658"] ["question-01d6b59b-be2b-52a2-b7cf-129c1864b658" :question/math-academy-id "q-128962"] ["question-01d6b59b-be2b-52a2-b7cf-129c1864b658" :question/problem "What is the slope of the line $4x-2y=15?$"] ["question-01d6b59b-be2b-52a2-b7cf-129c1864b658" :question/worked-solution "We can find the slope of the line if we can express its equation in slope-intercept form. To do this, we solve for $y,$ as follows:\n\n$$\n\\begin{aligned}4x-2y & =15 \\\\ -2y & =-4x+15 \\\\ 2y & =4x-15 \\\\ \\frac{2y}{2} & =\\frac{4x-15}{2} \\\\ y & =\\frac{4x}{2}-\\frac{15}{2} \\\\ y & =2x-\\frac{15}{2}\\end{aligned}\n$$\n\nFrom the slope-intercept equation, we can tell that the slope of the line is $m=2.$"] ["question-01d6b59b-be2b-52a2-b7cf-129c1864b658" :question/difficulty :question.difficulty/easy] ["answer-field-ce1122d2-a474-5255-b4e6-fa64c2b26aea" :answer-field/id #uuid "ce1122d2-a474-5255-b4e6-fa64c2b26aea"] ["answer-3eb7519d-f9a4-537d-ad00-b8770df7304f" :answer/id #uuid "3eb7519d-f9a4-537d-ad00-b8770df7304f"] ["answer-3eb7519d-f9a4-537d-ad00-b8770df7304f" :answer/type :answer.type/math] ["answer-3eb7519d-f9a4-537d-ad00-b8770df7304f" :answer/value "-7"] ["answer-6a1392cc-72c9-552a-91a5-492a4e1eb7eb" :answer/id #uuid "6a1392cc-72c9-552a-91a5-492a4e1eb7eb"] ["answer-6a1392cc-72c9-552a-91a5-492a4e1eb7eb" :answer/type :answer.type/math] ["answer-6a1392cc-72c9-552a-91a5-492a4e1eb7eb" :answer/value "-\\frac{1}{2}"] ["answer-39431c77-c03d-5db8-a706-f5e48e50720a" :answer/id #uuid "39431c77-c03d-5db8-a706-f5e48e50720a"] ["answer-39431c77-c03d-5db8-a706-f5e48e50720a" :answer/type :answer.type/math] ["answer-39431c77-c03d-5db8-a706-f5e48e50720a" :answer/value "2"] ["answer-2919f4fb-39e3-5189-a03f-6a9b46e59de7" :answer/id #uuid "2919f4fb-39e3-5189-a03f-6a9b46e59de7"] ["answer-2919f4fb-39e3-5189-a03f-6a9b46e59de7" :answer/type :answer.type/math] ["answer-2919f4fb-39e3-5189-a03f-6a9b46e59de7" :answer/value "\\frac{1}{2}"] ["answer-20d4b032-41eb-5439-8faf-8ee167214cea" :answer/id #uuid "20d4b032-41eb-5439-8faf-8ee167214cea"] ["answer-20d4b032-41eb-5439-8faf-8ee167214cea" :answer/type :answer.type/math] ["answer-20d4b032-41eb-5439-8faf-8ee167214cea" :answer/value "\\frac{7}{2}"] ["answer-field-ce1122d2-a474-5255-b4e6-fa64c2b26aea" :answer-field/key "selection"] ["answer-field-ce1122d2-a474-5255-b4e6-fa64c2b26aea" :answer-field/type :answer-field.type/radio] ["answer-field-ce1122d2-a474-5255-b4e6-fa64c2b26aea" :answer-field/correct "answer-39431c77-c03d-5db8-a706-f5e48e50720a"] ["answer-field-ce1122d2-a474-5255-b4e6-fa64c2b26aea" :answer-field/choices "answer-3eb7519d-f9a4-537d-ad00-b8770df7304f"] ["answer-field-ce1122d2-a474-5255-b4e6-fa64c2b26aea" :answer-field/choices "answer-6a1392cc-72c9-552a-91a5-492a4e1eb7eb"] ["answer-field-ce1122d2-a474-5255-b4e6-fa64c2b26aea" :answer-field/choices "answer-39431c77-c03d-5db8-a706-f5e48e50720a"] ["answer-field-ce1122d2-a474-5255-b4e6-fa64c2b26aea" :answer-field/choices "answer-2919f4fb-39e3-5189-a03f-6a9b46e59de7"] ["answer-field-ce1122d2-a474-5255-b4e6-fa64c2b26aea" :answer-field/choices "answer-20d4b032-41eb-5439-8faf-8ee167214cea"] ["question-01d6b59b-be2b-52a2-b7cf-129c1864b658" :question/answer-fields "answer-field-ce1122d2-a474-5255-b4e6-fa64c2b26aea"] [17592186179631 :knowledge-point/questions "question-01d6b59b-be2b-52a2-b7cf-129c1864b658"] ["question-d77788ff-b482-51d4-bdb1-79e3cff6db85" :question/id #uuid "d77788ff-b482-51d4-bdb1-79e3cff6db85"] ["question-d77788ff-b482-51d4-bdb1-79e3cff6db85" :question/math-academy-id "q-45552"] ["question-d77788ff-b482-51d4-bdb1-79e3cff6db85" :question/problem "A particular nature reserve started with $100$ rabbits. The number of rabbits is expected to increase sixfold each decade. What equation should we solve to determine the number of decades it will take for the rabbit population to increase to $129\\,600?$"] ["question-d77788ff-b482-51d4-bdb1-79e3cff6db85" :question/worked-solution "We know that the number of rabbits increases sixfold every decade. So the number of rabbits, which we'll call $y(t),$ grows exponentially with a growth factor of $6.$\n\nThe formula for exponential growth (in terms of a growth factor $b$) is\n\n$$\ny(t)=a{b}^{t}.\n$$\n\nFrom the given information, we have the following:\n\n- $a=100$ is the initial number of rabbits.\n\n- $b=6$ is the growth factor.\n\n- $t$ is the time, in decades, since the opening of the nature reserve.\n\nTherefore, the expression for $y(t)$ is\n\n$$\ny(t)=100\\cdot {6}^{t}.\n$$\n\nSo, to find the time it takes for the population to increase to $129\\,600,$ we would need to solve the equation\n\n$$\n\\begin{aligned}y(t) & =129\\,600 \\\\ 100\\cdot {6}^{t} & =129\\,600.\\end{aligned}\n$$"] ["question-d77788ff-b482-51d4-bdb1-79e3cff6db85" :question/difficulty :question.difficulty/easy] ["answer-field-b02529c2-774f-55c7-8d9d-1da2afa19817" :answer-field/id #uuid "b02529c2-774f-55c7-8d9d-1da2afa19817"] ["answer-d42bbc30-223b-58ce-9507-9ce6ff98b241" :answer/id #uuid "d42bbc30-223b-58ce-9507-9ce6ff98b241"] ["answer-d42bbc30-223b-58ce-9507-9ce6ff98b241" :answer/type :answer.type/math] ["answer-d42bbc30-223b-58ce-9507-9ce6ff98b241" :answer/value "100\\cdot {6}^{t}=129\\,600"] ["answer-85769fdc-2105-525f-b464-59ed6e084869" :answer/id #uuid "85769fdc-2105-525f-b464-59ed6e084869"] ["answer-85769fdc-2105-525f-b464-59ed6e084869" :answer/type :answer.type/math] ["answer-85769fdc-2105-525f-b464-59ed6e084869" :answer/value "129\\,600\\cdot {6}^{t}=100"] ["answer-f005e8d6-8f28-556d-88bf-034ab9368e21" :answer/id #uuid "f005e8d6-8f28-556d-88bf-034ab9368e21"] ["answer-f005e8d6-8f28-556d-88bf-034ab9368e21" :answer/type :answer.type/math] ["answer-f005e8d6-8f28-556d-88bf-034ab9368e21" :answer/value "6\\cdot {100}^{t}=129\\,600"] ["answer-7c79c38a-0867-5379-a53c-7ca4269e7eef" :answer/id #uuid "7c79c38a-0867-5379-a53c-7ca4269e7eef"] ["answer-7c79c38a-0867-5379-a53c-7ca4269e7eef" :answer/type :answer.type/math] ["answer-7c79c38a-0867-5379-a53c-7ca4269e7eef" :answer/value "{100}^{t}=129\\,600"] ["answer-b77e0798-376f-5ae6-bb3f-a714331eeca1" :answer/id #uuid "b77e0798-376f-5ae6-bb3f-a714331eeca1"] ["answer-b77e0798-376f-5ae6-bb3f-a714331eeca1" :answer/type :answer.type/math] ["answer-b77e0798-376f-5ae6-bb3f-a714331eeca1" :answer/value "{6}^{t}=129\\,600"] ["answer-field-b02529c2-774f-55c7-8d9d-1da2afa19817" :answer-field/key "selection"] ["answer-field-b02529c2-774f-55c7-8d9d-1da2afa19817" :answer-field/type :answer-field.type/radio] ["answer-field-b02529c2-774f-55c7-8d9d-1da2afa19817" :answer-field/correct "answer-d42bbc30-223b-58ce-9507-9ce6ff98b241"] ["answer-field-b02529c2-774f-55c7-8d9d-1da2afa