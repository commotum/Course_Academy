edge-point/questions "question-3cdee882-c7e4-5094-92c4-9cde591d4ea6"] ["question-b024a1aa-681f-5f33-860b-bc65702c1e19" :question/id #uuid "b024a1aa-681f-5f33-860b-bc65702c1e19"] ["question-b024a1aa-681f-5f33-860b-bc65702c1e19" :question/math-academy-id "q-111439"] ["question-b024a1aa-681f-5f33-860b-bc65702c1e19" :question/problem "Find all of the real solutions to the equation $(x-3)^{4}=-16.$"] ["question-b024a1aa-681f-5f33-860b-bc65702c1e19" :question/worked-solution "Notice that $(x-3)^{4}\\ge 0$ for all values of $x$ because the exponent ($4$) is even. This expression can never be negative. \n\nTherefore, there are no real solutions to this equation."] ["question-b024a1aa-681f-5f33-860b-bc65702c1e19" :question/difficulty :question.difficulty/moderate] ["answer-field-ed337ad5-38b5-500f-9d10-ecd8816c9737" :answer-field/id #uuid "ed337ad5-38b5-500f-9d10-ecd8816c9737"] ["answer-7b92c85e-104a-5064-8305-943449567082" :answer/id #uuid "7b92c85e-104a-5064-8305-943449567082"] ["answer-7b92c85e-104a-5064-8305-943449567082" :answer/type :answer.type/math] ["answer-7b92c85e-104a-5064-8305-943449567082" :answer/value "\\pm 2"] ["answer-eb7d4e73-767a-50c3-bf1a-830bdd14c11f" :answer/id #uuid "eb7d4e73-767a-50c3-bf1a-830bdd14c11f"] ["answer-eb7d4e73-767a-50c3-bf1a-830bdd14c11f" :answer/type :answer.type/math] ["answer-eb7d4e73-767a-50c3-bf1a-830bdd14c11f" :answer/value "\\pm 4"] ["answer-2bed00fa-efb8-5c12-adfd-d23dd1427391" :answer/id #uuid "2bed00fa-efb8-5c12-adfd-d23dd1427391"] ["answer-2bed00fa-efb8-5c12-adfd-d23dd1427391" :answer/type :answer.type/text] ["answer-2bed00fa-efb8-5c12-adfd-d23dd1427391" :answer/value "$-1$ and $7$"] ["answer-da4c22fc-fba0-5c21-9052-a20bc9a784c8" :answer/id #uuid "da4c22fc-fba0-5c21-9052-a20bc9a784c8"] ["answer-da4c22fc-fba0-5c21-9052-a20bc9a784c8" :answer/type :answer.type/text] ["answer-da4c22fc-fba0-5c21-9052-a20bc9a784c8" :answer/value "$1$ and $5$"] ["answer-6ae61634-b5f8-59eb-a055-c867fddb17f2" :answer/id #uuid "6ae61634-b5f8-59eb-a055-c8