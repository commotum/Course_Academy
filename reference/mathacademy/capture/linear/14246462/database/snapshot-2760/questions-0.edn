#{[{:db/id #edb/ref 17592186564518 :knowledge-point/_questions [{:db/id #edb/ref 17592186115311 :knowledge-point/id #uuid "23e661ed-3a7b-598a-a7b1-fd5011fe4fb8" :knowledge-point/title "Solving Equations Containing an Expression Raised to an Even Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bed00fa-efb8-5c12-adfd-d23dd1427391" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-1$ and $7$" :db/id #edb/ref 17592186564038} {:answer/id #uuid "6ae61634-b5f8-59eb-a055-c867fddb17f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no real solutions" :db/id #edb/ref 17592186564137} {:answer/id #uuid "7b92c85e-104a-5064-8305-943449567082" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 2" :db/id #edb/ref 17592186564156} {:answer/id #uuid "da4c22fc-fba0-5c21-9052-a20bc9a784c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$ and $5$" :db/id #edb/ref 17592186564315} {:answer/id #uuid "eb7d4e73-767a-50c3-bf1a-830bdd14c11f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 4" :db/id #edb/ref 17592186564347}] :answer-field/correct {:answer/id #uuid "6ae61634-b5f8-59eb-a055-c867fddb17f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no real solutions" :db/id #edb/ref 17592186564137} :answer-field/id #uuid "ed337ad5-38b5-500f-9d10-ecd8816c9737" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564454}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b024a1aa-681f-5f33-860b-bc65702c1e19" :question/math-academy-id "q-111439" :question/problem "Find all of the real solutions to the equation $(x-3)^{4}=-16.$" :question/worked-solution "Notice that $(x-3)^{4}\\ge 0$ for all values of $x$ because the exponent ($4$) is even. This expression can never be negative. \n\nTherefore, there are no real solutions to this equation."}] [{:db/id #edb/ref 17592186564530 :knowledge-point/_questions [{:db/id #edb/ref 17592186138414 :knowledge-point/id #uuid "8e239c25-66f9-5ea7-ba3c-5599966cd89b" :knowledge-point/title "Finding a Second Data Point Given Another Data Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e456658-a42b-5e79-b5ed-3a3fe1823913" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186564009} {:answer/id #uuid "27489401-06a5-55b9-b5cd-4c561edb32eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186564028} {:answer/id #uuid "3934a817-e1ce-57d9-a908-f6163578ca88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186564066} {:answer/id #uuid "5f4845bc-6bd1-523b-9b3b-cd826c584ce3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186564116} {:answer/id #uuid "aaf57b44-4131-58a8-9c32-4175e4939bf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186564228}] :answer-field/correct {:answer/id #uuid "27489401-06a5-55b9-b5cd-4c561edb32eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186564028} :answer-field/id #uuid "47ecb024-2722-561f-8432-d98acd72fb24" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564393}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "dfc98e96-f028-5cd6-8e89-3ae59a19563f" :question/math-academy-id "q-115562" :question/problem "If $y$ varies inversely with $x$ and $y=2$ when $x=4,$ find the value of $y$ when $x=\\frac{4}{5}.$" :question/worked-solution "Since $y$ varies inversely with $x,$ we use the equation\n\n$$\ny=\\frac{k}{x}.\n$$\n\nWe are told that $y=2$ when $x=4.$ We substitute this data into the equation to find $k:$\n\n$$\n\\begin{aligned}2 & =\\frac{k}{4} \\\\ 2\\cdot 4 & =k \\\\ 8 & =k\\end{aligned}\n$$\n\nSo, the inverse variation is given by \n\n$$\ny=\\frac{8}{x}.\n$$\n\nFinally, substituting the value of $x=\\frac{4}{5}$ into this equation gives\n\n$$\n\\begin{aligned}y & =\\frac{8}{(\\frac{4}{5})} \\\\  & =8÷\\frac{4}{5} \\\\  & =8\\cdot \\frac{5}{4} \\\\  & =\\frac{40}{4} \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186564496 :knowledge-point/_questions [{:db/id #edb/ref 17592186115408 :knowledge-point/id #uuid "3360e34f-afe6-5f9e-be39-91e2d51ba353" :knowledge-point/title "Ordering the Sides of a Triangle by Size Given the Interior Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49703cc4-994a-5bf9-b7e9-098365af9c02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{LM},\\,\\overset{―}{KL},\\,\\overset{―}{KM}" :db/id #edb/ref 17592186564091} {:answer/id #uuid "7c6f8b80-48df-5fe6-9951-feb321cc6ba0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{KM},\\,\\overset{―}{KL},\\,\\overset{―}{LM}" :db/id #edb/ref 17592186564159} {:answer/id #uuid "a03c9b16-8051-5e6e-8791-1b01a8902b5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{KL},\\,\\overset{―}{KM},\\,\\overset{―}{LM}" :db/id #edb/ref 17592186564211} {:answer/id #uuid "edbe36c3-a177-5880-8f06-3e428a4c8d4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{KM},\\,\\overset{―}{LM},\\,\\overset{―}{KL}" :db/id #edb/ref 17592186564351} {:answer/id #uuid "f1b4cc3c-3632-59a9-b0af-fab5fb549bdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{LM},\\,\\overset{―}{KM},\\,\\overset{―}{KL}" :db/id #edb/ref 17592186564361}] :answer-field/correct {:answer/id #uuid "f1b4cc3c-3632-59a9-b0af-fab5fb549bdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{LM},\\,\\overset{―}{KM},\\,\\overset{―}{KL}" :db/id #edb/ref 17592186564361} :answer-field/id #uuid "0164330c-13ad-5c34-8a92-9c663242c3e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564378}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "78772149-6410-5606-9ad3-23c6e01f9b0e" :question/math-academy-id "q-117944" :question/problem "![](images/f2/f2dc2ed0562e3d93888ab025195ada5da5ef9bf5312d6215dfb83253c81f9be7.png)\n\nOrder the sides of $△KLM$ above from the shortest to the longest." :question/worked-solution "Since $∠K$ is the smallest angle, its opposite side $\\overset{―}{LM}$ is the shortest side of the triangle.\n\nSince $∠M$ is the largest angle, its opposite side $\\overset{―}{KL}$ must be the longest side of the triangle. \n\nSo, we have\n\n$$\nLM<KM<KL\n$$\n\nand therefore the required order is\n\n$$\n\\overset{―}{LM},\\,\\overset{―}{KM},\\,\\overset{―}{KL}.\n$$"}] [{:db/id #edb/ref 17592186564464 :knowledge-point/_questions [{:db/id #edb/ref 17592186179631 :knowledge-point/id #uuid "48f52c24-cd5a-5701-8ec2-1d833e87a25f" :knowledge-point/title "Finding the Slope of a Line Given Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20d4b032-41eb-5439-8faf-8ee167214cea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186564014} {:answer/id #uuid "2919f4fb-39e3-5189-a03f-6a9b46e59de7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186564032} {:answer/id #uuid "39431c77-c03d-5db8-a706-f5e48e50720a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186564067} {:answer/id #uuid "3eb7519d-f9a4-537d-ad00-b8770df7304f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186564074} {:answer/id #uuid "6a1392cc-72c9-552a-91a5-492a4e1eb7eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186564135}] :answer-field/correct {:answer/id #uuid "39431c77-c03d-5db8-a706-f5e48e50720a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186564067} :answer-field/id #uuid "ce1122d2-a474-5255-b4e6-fa64c2b26aea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564442}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "01d6b59b-be2b-52a2-b7cf-129c1864b658" :question/math-academy-id "q-128962" :question/problem "What is the slope of the line $4x-2y=15?$" :question/worked-solution "We can find the slope of the line if we can express its equation in slope-intercept form. To do this, we solve for $y,$ as follows:\n\n$$\n\\begin{aligned}4x-2y & =15 \\\\ -2y & =-4x+15 \\\\ 2y & =4x-15 \\\\ \\frac{2y}{2} & =\\frac{4x-15}{2} \\\\ y & =\\frac{4x}{2}-\\frac{15}{2} \\\\ y & =2x-\\frac{15}{2}\\end{aligned}\n$$\n\nFrom the slope-intercept equation, we can tell that the slope of the line is $m=2.$"}] [{:db/id #edb/ref 17592186176330 :knowledge-point/_questions [{:db/id #edb/ref 17592186176031 :knowledge-point/id #uuid "534de76f-d4bc-55b5-858e-2b594f63b7bc" :knowledge-point/title "Calculating Distance Given Speed and Time"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "525b1435-446e-5cc8-b37a-149995820d54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$450$ meters" :db/id #edb/ref 17592186266880} {:answer/id #uuid "66e533d2-4c01-51d3-8d6a-bc619964e5c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$100$ meters" :db/id #edb/ref 17592186267058} {:answer/id #uuid "9ac08d0f-968e-5d01-a884-a9815baeb075" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$475$ meters" :db/id #edb/ref 17592186267542} {:answer/id #uuid "badac45f-a62d-5f10-a7fc-f10e5130889c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$525$ meters" :db/id #edb/ref 17592186267820} {:answer/id #uuid "e4807d87-8bd0-535b-b462-cacbb2f06a4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$95$ meters" :db/id #edb/ref 17592186268163}] :answer-field/correct {:answer/id #uuid "9ac08d0f-968e-5d01-a884-a9815baeb075" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$475$ meters" :db/id #edb/ref 17592186267542} :answer-field/id #uuid "94bfc4c7-03c0-5588-b13f-c2f5df334ad4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268666}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "09b93451-12f0-5b32-9bbf-d323d2f03aae" :question/math-academy-id "q-133999" :question/problem "It takes a particular person $2$ minutes to walk $190$ meters. Find the distance this person covers in $5$ minutes." :question/worked-solution "Speed is a special unit rate applied to moving objects. It is defined as *the distance traveled per unit of time*:\n\n$$\n\\text{speed}=\\frac{\\text{distance}}{\\text{time}}\n$$\n\nTo find the speed in meters per minute, we divide the number of meters, $190,$ by the number of minutes, $2.$ This gives,\n\n$$\n\\begin{aligned}\\frac{190}{2} & =190÷2 \\\\  & =95.\\end{aligned}\n$$\n\nSo, the speed of the person is $95$ meters per minute. \n\nTo find the distance covered in $5$ minutes, we multiply the speed by $5.$ This gives\n\n$$\n\\begin{aligned}\\text{distance} & =\\text{speed}\\times \\text{time} \\\\  & =95\\times 5 \\\\  & =475.\\end{aligned}\n$$\n\nTherefore, the person can cover $475$ meters in $5$ minutes."}] [{:db/id #edb/ref 17592186564482 :knowledge-point/_questions [{:db/id #edb/ref 17592186129108 :knowledge-point/id #uuid "578132af-f322-5a68-9771-72e1954622ad" :knowledge-point/title "Finding the Roots of a Function Given a Mapping Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "491a4c71-5fdc-56c2-8fae-cd8a5438662b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)$ has no roots" :db/id #edb/ref 17592186564090} {:answer/id #uuid "bee91cba-2f60-53b4-8260-df36b392dd26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186564260} {:answer/id #uuid "c323cd02-6f11-5b93-8f07-e4d3047852c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0,1$ and $4$" :db/id #edb/ref 17592186564269} {:answer/id #uuid "fa586a76-640b-54ff-9c72-afa240ba7b86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ and $1$" :db/id #edb/ref 17592186564370} {:answer/id #uuid "fb462dfb-9442-515e-b89b-ef1366481882" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $3$" :db/id #edb/ref 17592186564372}] :answer-field/correct {:answer/id #uuid "491a4c71-5fdc-56c2-8fae-cd8a5438662b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)$ has no roots" :db/id #edb/ref 17592186564090} :answer-field/id #uuid "73aaa492-1989-5edc-b375-a2b4ff1dbf0f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564411}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3cdee882-c7e4-5094-92c4-9cde591d4ea6" :question/math-academy-id "q-166673" :question/problem "![](images/34/34054404a184f9480abec1692e343f7ffbae4664c9c906e744f07cc082b0ebde.png)\n\nWhat are the roots of the function $f(x)$ defined by the mapping diagram shown above?" :question/worked-solution "The roots of the function are the values of $x$ such that $f(x)=0.$ In the given mapping diagram, we see that there is no value of $x$ that gives an output of zero. \n\nTherefore, the function $f(x)$ has no roots."}] [{:db/id #edb/ref 17592186564466 :knowledge-point/_questions [{:db/id #edb/ref 17592186083331 :knowledge-point/id #uuid "c28dd57d-e6e5-5704-94a4-5f9bfb37f383" :knowledge-point/title "Finding the Lowest Common Denominator of Two Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fc56540-d358-50d3-b73a-c0b1425f94b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186563992}] :answer-field/correct {:answer/id #uuid "0fc56540-d358-50d3-b73a-c0b1425f94b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186563992} :answer-field/id #uuid "56ea52af-12b6-5644-b4a6-ed05e7a0427f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186564400}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "093f60b7-b595-5220-994a-63101bc04a42" :question/math-academy-id "q-171160" :question/problem "The lowest common denominator of $\\frac{5}{7}$ and $\\frac{1}{2}$ is{{field-1}}." :question/worked-solution "To find the lowest common denominator of two fractions, we first find the prime factorization of both denominators. \n\nSince the denominators $7$ and $2$ are prime numbers, they are already represented by their respective prime factorizations. \n\nNow, we write down each prime factor, and we raise each factor to the highest power given in either factorization:\n\n- the highest power of $7$ is $1$\n\n- the highest power of $2$ is also $1$\n\nTherefore, the lowest common denominator is ${7}^{1}\\cdot {2}^{1}=14.$"}] [{:db/id #edb/ref 17592186564535 :knowledge-point/_questions [{:db/id #edb/ref 17592186175908 :knowledge-point/id #uuid "208596d0-1a45-57b2-afa5-d17e99218e38" :knowledge-point/title "Solving Rational Equations Containing Binomials in Both Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "034dcf22-431a-57bb-93c4-4c3872d74663" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186563973}] :answer-field/correct {:answer/id #uuid "034dcf22-431a-57bb-93c4-4c3872d74663" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186563973} :answer-field/id #uuid "4382b096-445d-57f5-877e-794cba2c5eef" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186564391}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e8061560-b60f-50e8-a1e6-e8fcd0b1f879" :question/math-academy-id "q-215145" :question/problem "Solve for $y$ where $-\\frac{1}{2y+7}=\\frac{4}{5y-2}.$\n\n$y=$\n{{field-1}}" :question/worked-solution "First, note that $y=-\\frac{7}{2}$ and $y=\\frac{2}{5}$ cannot be solutions since division by $0$ is undefined.\n\nTo solve the equation, we move the negative sign onto the numerator of the fraction and then apply cross-multiplication:\n\n$$\n\\begin{aligned}-\\frac{1}{2y+7} & =\\frac{4}{5y-2} \\\\ \\frac{-1}{2y+7} & =\\frac{4}{5y-2} \\\\ (-1)\\cdot (5y-2) & =(2y+7)\\cdot 4 \\\\ -5y+2 & =8y+28\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}-5y+2 & =8y+28 \\\\ -5y+2+5y & =8y+28+5y \\\\ 2 & =13y+28 \\\\ 2-28 & =13y+28-28 \\\\ -26 & =13y \\\\ \\frac{-26}{13} & =\\frac{13y}{13} \\\\ -2 & =y\\end{aligned}\n$$\n\nSince $y=-2$ is different from $y=-\\frac{7}{2}$ and $y=\\frac{2}{5},$ we can accept it as a solution. Thus, the solution is $y=-2.$"}] [{:db/id #edb/ref 17592186564528 :knowledge-point/_questions [{:db/id #edb/ref 17592186147422 :knowledge-point/id #uuid "363026fc-b4ac-5b35-8825-717a113df12b" :knowledge-point/title "Creating a Model and Solving for an Unknown Time"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c79c38a-0867-5379-a53c-7ca4269e7eef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{100}^{t}=129\\,600" :db/id #edb/ref 17592186564160} {:answer/id #uuid "85769fdc-2105-525f-b464-59ed6e084869" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "129\\,600\\cdot {6}^{t}=100" :db/id #edb/ref 17592186564175} {:answer/id #uuid "b77e0798-376f-5ae6-bb3f-a714331eeca1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{t}=129\\,600" :db/id #edb/ref 17592186564251} {:answer/id #uuid "d42bbc30-223b-58ce-9507-9ce6ff98b241" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100\\cdot {6}^{t}=129\\,600" :db/id #edb/ref 17592186564303} {:answer/id #uuid "f005e8d6-8f28-556d-88bf-034ab9368e21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\cdot {100}^{t}=129\\,600" :db/id #edb/ref 17592186564354}] :answer-field/correct {:answer/id #uuid "d42bbc30-223b-58ce-9507-9ce6ff98b241" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100\\cdot {6}^{t}=129\\,600" :db/id #edb/ref 17592186564303} :answer-field/id #uuid "b02529c2-774f-55c7-8d9d-1da2afa19817" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564432}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d77788ff-b482-51d4-bdb1-79e3cff6db85" :question/math-academy-id "q-45552" :question/problem "A particular nature reserve started with $100$ rabbits. The number of rabbits is expected to increase sixfold each decade. What equation should we solve to determine the number of decades it will take for the rabbit population to increase to $129\\,600?$" :question/worked-solution "We know that the number of rabbits increases sixfold every decade. So the number of rabbits, which we'll call $y(t),$ grows exponentially with a growth factor of $6.$\n\nThe formula for exponential growth (in terms of a growth factor $b$) is\n\n$$\ny(t)=a{b}^{t}.\n$$\n\nFrom the given information, we have the following:\n\n- $a=100$ is the initial number of rabbits.\n\n- $b=6$ is the growth factor.\n\n- $t$ is the time, in decades, since the opening of the nature reserve.\n\nTherefore, the expression for $y(t)$ is\n\n$$\ny(t)=100\\cdot {6}^{t}.\n$$\n\nSo, to find the time it takes for the population to increase to $129\\,600,$ we would need to solve the equation\n\n$$\n\\begin{aligned}y(t) & =129\\,600 \\\\ 100\\cdot {6}^{t} & =129\\,600.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186138830 :knowledge-point/_questions [{:db/id #edb/ref 17592186138560 :knowledge-point/id #uuid "c2c48d15-4749-5c47-bc97-a5584216cf2e" :knowledge-point/title "Calculating the Value of an Unknown Quantity Using Collinearity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c338da01-40d0-533e-b821-77604def14ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186135929} {:answer/id #uuid "db1d49dd-bc18-5fe3-91a1-3431242f9048" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186135930} {:answer/id #uuid "e830039a-2929-5789-8fe0-f754442da840" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186135931} {:answer/id #uuid "07ff6d86-3f68-577c-9d28-e060610f49ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186135932} {:answer/id #uuid "58e63d00-a251-5db0-abf7-53ffa4376722" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186135933}] :answer-field/correct {:answer/id #uuid "c338da01-40d0-533e-b821-77604def14ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186135929} :answer-field/id #uuid "374553a7-81ee-5a81-93c7-e95f618cabbd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186135928}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aace78ee-bd90-5541-b619-9e09742ab949" :question/math-academy-id "q-52730" :question/problem "![](images/a3/a3495fce9e81ae42fd279c91c964d7780daa1736c8a0c600dd2810a40f4ccbe8.png)\n\nGiven the diagram shown above, what is the value of $x?$" :question/worked-solution "By the segment addition postulate, we have\n\n$$\nAD=AB+BC+CD.\n$$\n\nTo solve for $x,$ we can substitute the given information\n\n$$\nAD=17,\\,AB=x-2,\\,BC=9,\\,CD=2x-5,\n$$\n\n \n\nand then solve the resulting equation:\n\n$$\n\\begin{aligned}AD & =AB+BC+CD \\\\ 17 & =(x-2)+9+(2x-5) \\\\ 17 & =3x+2 \\\\ 3x & =15 \\\\ x & =5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186564513 :knowledge-point/_questions [{:db/id #edb/ref 17592186110630 :knowledge-point/id #uuid "9e6e34d9-29a2-55ed-9d28-258cbfd91600" :knowledge-point/title "Finding an Unknown Quantity Using Supplementary Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f982969-e29b-5dcb-b520-dd0b13eb6833" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{92}^{∘}" :db/id #edb/ref 17592186564076} {:answer/id #uuid "42be2e85-427d-5ed0-b65f-e28375ab57c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{87}^{∘}" :db/id #edb/ref 17592186564081} {:answer/id #uuid "640dc449-205d-57f4-9327-7faa378ccea1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{90}^{∘}" :db/id #edb/ref 17592186564126} {:answer/id #uuid "a3917857-9aaa-5c34-bf67-fac980d43439" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{80}^{∘}" :db/id #edb/ref 17592186564219} {:answer/id #uuid "c6250ade-5d8e-5049-bd28-9494165c15e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{96}^{∘}" :db/id #edb/ref 17592186564277}] :answer-field/correct {:answer/id #uuid "640dc449-205d-57f4-9327-7faa378ccea1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{90}^{∘}" :db/id #edb/ref 17592186564126} :answer-field/id #uuid "f15dd0ad-8bf1-5e1c-8d76-6465ccbd4d24" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564459}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a1a77f56-694e-539a-a24b-49a13b3865ca" :question/math-academy-id "q-5926" :question/problem "![](images/c3/c3a31aad745cafe59f0c15e56dd48bf9350e46c08e148b843a6904145934e46b.png)\n\nSolve for $x$ given the figure above." :question/worked-solution "Since the two angles are supplementary, the sum of their measures is equal to ${180}^{∘}.$ Therefore:\n\n$$\n\\begin{aligned}{48}^{∘}+(x+{42}^{∘}) & ={180}^{∘} \\\\ x+{90}^{∘} & ={180}^{∘} \\\\ x & ={90}^{∘}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186564526 :knowledge-point/_questions [{:db/id #edb/ref 17592186147575 :knowledge-point/id #uuid "bb8b97e4-704c-5b13-97c7-6eb97aca392f" :knowledge-point/title "Finding a Total Given a Part and a Multiple of Ten Percent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03e9cf25-ab69-52a6-934c-62bdcbd01856" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186563975} {:answer/id #uuid "4fbab777-784f-5143-ac9a-4ea8efece70e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186564096} {:answer/id #uuid "7408b52e-5e63-584d-aca1-f327f1bffed4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186564143} {:answer/id #uuid "99f37d1a-01b6-5eb6-896e-d89a1c5d9202" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "76" :db/id #edb/ref 17592186564206} {:answer/id #uuid "f43fb12c-ca5e-5bb9-a117-52a4220abfd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186564364}] :answer-field/correct {:answer/id #uuid "4fbab777-784f-5143-ac9a-4ea8efece70e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186564096} :answer-field/id #uuid "bcf715fb-fd7f-5fbf-bbe8-06f12ca3c63d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564434}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d64cbb84-4920-5e00-a5fb-dd325fcf710c" :question/math-academy-id "q-60981" :question/problem "If $\\,\\boxed{}\\times 40%=32,$ then $\\,\\boxed{}=$" :question/worked-solution "The part is $32,$ the percentage is $40%,$ and we need to find the whole.\n\nTo do this, we can use the following formula:\n\n$$\n\\text{whole}=\\text{part}÷\\text{percentage}\n$$\n\nBefore we can substitute our numbers into the formula, we need to express $40%$ as a fraction:\n\n$$\n\\frac{40}{100}=\\frac{40÷20}{100÷20}=\\frac{2}{5}\n$$\n\nWe can now substitute our numbers into the formula, as follows:\n\n$$\n\\begin{aligned}\\text{whole} & =32÷40% \\\\  & =32÷\\frac{2}{5} \\\\  & =32\\times \\frac{5}{2} \\\\  & =\\frac{32}{2}\\times 5 \\\\  & =16\\times 5 \\\\  & =80\\end{aligned}\n$$"}]}
