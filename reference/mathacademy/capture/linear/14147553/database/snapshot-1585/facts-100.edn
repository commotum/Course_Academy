c-8687-6111e219fb1f" #edb/ref 17592186045417] [17592186443085 #edb/ref 1074 "To work out ${13}^{2},$ we multiply $13$ by itself:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $13\\times 13=169.$" #edb/ref 17592186045417] [17592186443086 #edb/ref 1068 #edb/ref 17592186443067 #edb/ref 17592186045417] [17592186443086 #edb/ref 1069 "q-185204" #edb/ref 17592186045417] [17592186443086 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186443086 #edb/ref 1071 "Expressed as a decimal in its simplest form, $(5.3)^{2}=${{field-1}}." #edb/ref 17592186045417] [17592186443086 #edb/ref 1072 #uuid "c5bedd10-8ffa-5ad9-bdb2-5aa9ca8ef32b" #edb/ref 17592186045417] [17592186443086 #edb/ref 1074 "We need to calculate the product of $5.3$ with itself:\n\n$$\n{5.3}^{2}=(5.3)\\cdot (5.3)\n$$\n\nFirst, we ignore the decimal points and multiply as if both numbers were whole numbers:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{1} \\\\ \\boxed{}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $53\\times 53=2\\,809.$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $1$ decimal place in the first factor ($5.3$) and $1$ decimal place in the second factor ($5.3$), so their product will have $1+1=2$ decimal places.\n\nWe take our value of $2\\,809$ and insert a decimal point to make a number with $2$ decimal places:\n\n$$\n28\\,\\overset{↓}{.}\\,\\,\\,{{09}_{⏟}}_{2\\text{ digits}}\n$$\n\nTherefore, ${5.3}^{2}=28.09\\,.$" #edb/ref 17592186045417] [17592186443087 #edb/ref 1068 #edb/ref 17592186443070 #edb/ref 17592186045417] [17592186443087 #edb/ref 1069 "q-185196" #edb/ref 17592186045417] [17592186443087 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186443087 #edb/ref 1071 "Expressed as a decimal in its simplest form, $(-0.3)^{2}=${{field-1}}." #edb/ref 17592186045417] [17592186443087 #edb/ref 1072 #uuid "e04ccdd3-f28d-58f9-a502-15fb5e93205e" #edb/ref 17592186045417] [17592186443087 #edb/ref 1074 "We need to calculate the product of $-0.3$ with itself:\n\n$$\n(-0.3)^{2}=(-0.3)\\cdot (-0.3)=(0.3)\\cdot (0.3)\n$$\n\nFirst, we ignore the decimal points and multiply as if both numbers were whole numbers:\n\n$$\n3\\times 3=9.\n$$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $1$ decimal place in the first factor ($0.3$) and $1$ decimal place in the second factor ($0.3$), so their product will have $1+1=2$ decimal places.\n\nWe take our value of $9$ and insert a decimal point to make a number with $2$ decimal places:\n\n$$\n0\\,\\overset{↓}{.}\\,\\,\\,{{09}_{⏟}}_{2\\text{ digits}}\n$$\n\nTherefore, $(-0.3)^{2}=0.09\\,.$" #edb/ref 17592186045417] [17592186443088 #edb/ref 1068 #edb/ref 17592186443069 #edb/ref 17592186045417] [17592186443088 #edb/ref 1069 "q-104519" #edb/ref 17592186045417] [17592186443088 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186443088 #edb/ref 1071 "${25}^{2}=$" #edb/ref 17592186045417] [17592186443088 #edb/ref 1072 #uuid "e84b722e-1f7b-5e51-918b-729f6c73a9a8" #edb/ref 17592186045417] [17592186443088 #edb/ref 1074 "To work out \n${25}^{2},$\n we multiply \n$25$\n by itself:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{1} \\\\ \\boxed{2}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $25\\times 25=625.$" #edb/ref 17592186045417] [17592186443089 #edb/ref 1068 #edb/ref 17592186443066 #edb/ref 17592186045417] [17592186443089 #edb/ref 1069 "q-69409" #edb/ref 17592186045417] [17592186443089 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186443089 #edb/ref 1071 "${1.6}^{2}=$" #edb/ref 17592186045417] [17592186443089 #edb/ref 1072 #uuid "f176b794-be06-5dbc-b5c3-35aaeec4668c" #edb/ref 17592186045417] [17592186443089 #edb/ref 1074 "We need to calculate the product of $1.6$ with itself:\n\n$$\n{1.6}^{2}=(1.6)\\cdot (1.6)\n$$\n\nFirst, we ignore the decimal points and multiply as if both numbers were whole numbers:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{3}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $16\\times 16=256.$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $1$ decimal place in the first factor ($1.6$) and $1$ decimal place in the second factor ($1.6$), so their product will have $1+1=2$ decimal places.\n\nWe take our value of $256$ and insert a decimal point to make a number with $2$ decimal places:\n\n$$\n2\\,\\overset{↓}{.}\\,\\,\\,{{56}_{⏟}}_{2\\text{ digits}}\n$$\n\nTherefore, ${1.6}^{2}=2.56\\,.$" #edb/ref 17592186045417] [17592186443090 #edb/ref 1068 #edb/ref 17592186443057 #edb/ref 17592186045417] [17592186443090 #edb/ref 1069 "q-99691" #edb/ref 17592186045417] [17592186443090 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186443090 #edb/ref 1071 "$(-14)^{2}=$" #edb/ref 17592186045417] [17592186443090 #edb/ref 1072 #uuid "f5d1c8d9-881c-5cab-bdcb-86d5598dd1ea" #edb/ref 17592186045417] [17592186443090 #edb/ref 1074 "Since the product of two negative numbers gives a positive number, we have\n\n$$\n(-14)^{2}=(-14)\\cdot (-14)=14\\cdot 14\n$$\n\nNext, we calculate $14\\cdot 14:$\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{1}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n(-14)^{2}={14}^{2}=196.\n$$" #edb/ref 17592186045417] [17592186443091 #edb/ref 1068 #edb/ref 17592186443065 #edb/ref 17592186045417] [17592186443091 #edb/ref 1069 "q-185191" #edb/ref 17592186045417] [17592186443091 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186443091 #edb/ref 1071 "Expressed as an improper fraction or mixed number, ${(-\\frac{9}{2})}^{2}=${{field-1}}." #edb/ref 17592186045417] [17592186443091 #edb/ref 1072 #uuid "fa89591c-42d2-57e3-bfd4-69e840192bd4" #edb/ref 17592186045417] [17592186443091 #edb/ref 1074 "To work out ${(-\\frac{9}{2})}^{2},$ we multiply $-\\frac{9}{2}$ by itself:\n\n$$\n\\begin{aligned}{(-\\frac{9}{2})}^{2} & = \\\\ (-\\frac{9}{2})\\cdot (-\\frac{9}{2}) & = \\\\ \\frac{9\\cdot 9}{2\\cdot 2} & = \\\\ \\frac{81}{4} & \\end{aligned}\n$$" #edb/ref 17592186045417]}
