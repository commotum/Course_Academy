aa8-700fcff510ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.56" :db/id #edb/ref 17592186443040} {:answer/id #uuid "e8b00607-3d6c-5a89-bdc6-d6456d75846e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.42" :db/id #edb/ref 17592186443046}] :answer-field/correct {:answer/id #uuid "b840462d-8d97-5643-baa8-700fcff510ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.56" :db/id #edb/ref 17592186443040} :answer-field/id #uuid "8fcffc96-726d-51dd-89e9-859a58d88bc6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186443066}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f176b794-be06-5dbc-b5c3-35aaeec4668c" :question/math-academy-id "q-69409" :question/problem "${1.6}^{2}=$" :question/worked-solution "We need to calculate the product of $1.6$ with itself:\n\n$$\n{1.6}^{2}=(1.6)\\cdot (1.6)\n$$\n\nFirst, we ignore the decimal points and multiply as if both numbers were whole numbers:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{3}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $16\\times 16=256.$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $1$ decimal place in the first factor ($1.6$) and $1$ decimal place in the second factor ($1.6$), so their product will have $1+1=2$ decimal places.\n\nWe take our value of $256$ and insert a decimal point to make a number with $2$ decimal places:\n\n$$\n2\\,\\overset{↓}{.}\\,\\,\\,{{56}_{⏟}}_{2\\text{ digits}}\n$$\n\nTherefore, ${1.6}^{2}=2.56\\,.$"}] [{:db/id #edb/ref 17592186443074 :knowledge-point/_questions [{:db/id #edb/ref 17592186133735 :knowledge-point/id #uuid "eece577d-72b8-5a0d-89fd-1cfa63bf73fb" :knowledge-point/title "Squaring Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42d591b4-d764-52d6-9e16-49f5294c1578" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186443007} {:answer/id #uuid "5b97aa23-0558-53e3-9324-837b7050bbe4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186443012} {:answer/id #uuid "9728859a-c15e-5dc3-a344-4259f582a45b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{64}" :db/id #edb/ref 17592186443031} {:answer/id #uuid "b215cc2b-86c4-55da-9ade-5f0237fc0547" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{60}" :db/id #edb/ref 17592186443039} {:answer/id #uuid "f404782b-a810-50bd-a8e7-bc664934684b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186443050}] :answer-field/correct {:answer/id #uuid "9728859a-c15e-5dc3-a344-4259f582a45b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{64}" :db/id #edb/ref 17592186443031} :answer-field/id #uuid "5e742786-62ca-50d3-994f-9b3898b59bb6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/r