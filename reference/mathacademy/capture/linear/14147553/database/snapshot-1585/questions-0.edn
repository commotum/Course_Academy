] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "668fdcb5-56eb-5d4c-8344-17b223fde624" :question/math-academy-id "q-185174" :question/problem "Expressed as a fraction, ${(-\\frac{3}{4})}^{2}=${{field-1}}." :question/worked-solution "To work out ${(-\\frac{3}{4})}^{2},$ we multiply $-\\frac{3}{4}$ by itself:\n\n$$\n\\begin{aligned}{(-\\frac{3}{4})}^{2} & =(-\\frac{3}{4})\\cdot (-\\frac{3}{4}) \\\\  & =\\frac{3\\cdot 3}{4\\cdot 4} \\\\  & =\\frac{9}{16}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186443076 :knowledge-point/_questions [{:db/id #edb/ref 17592186133736 :knowledge-point/id #uuid "46e8fb12-e59a-5aba-a9e8-2f872a89b915" :knowledge-point/title "Squaring Negative Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc3e59fe-fbeb-561a-9571-4860f2729517" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{81}{49}" :db/id #edb/ref 17592186443042}] :answer-field/correct {:answer/id #uuid "cc3e59fe-fbeb-561a-9571-4860f2729517" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{81}{49}" :db/id #edb/ref 17592186443042} :answer-field/id #uuid "72380fe8-b5f4-5ca0-9fd3-c403c8836a0a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186443060}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "397f8e4c-8a02-58fc-a48a-6b5a482557f8" :question/math-academy-id "q-185186" :question/problem "Expressed as an improper fraction or mixed number, ${(-\\frac{9}{7})}^{2}=${{field-1}}." :question/worked-solution "To work out ${(-\\frac{9}{7})}^{2},$ we multiply $-\\frac{9}{7}$ by itself:\n\n$$\n\\begin{aligned}{(-\\frac{9}{7})}^{2} & = \\\\ (-\\frac{9}{7})\\cdot (-\\frac{9}{7}) & = \\\\ \\frac{9\\cdot 9}{7\\cdot 7} & = \\\\ \\frac{81}{49} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186443079 :knowledge-point/_questions [{:db/id #edb/ref 17592186133735 :knowledge-point/id #uuid "eece577d-72b8-5a0d-89fd-1cfa63bf73fb" :knowledge-point/title "Squaring Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ea65150-bd2b-5bdf-a7ab-a51b52c79e58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186443005}] :answer-field/correct {:answer/id #uuid "3ea65150-bd2b-5bdf-a7ab-a51b52c79e58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186443005} :answer-field/id #uuid "a80481f5-39ce-5ee2-b253-1792bec0a57d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186443068}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5df64b77-ebca-5b73-8314-1b0b4f096670" :question/math-academy-id "q-185190" :question/problem "Expressed as an improper fraction or mixed number, ${(\\frac{3}{2})}^{2}=${{field-1}}." :question/worked-solution "To work out ${(\\frac{3}{2})}^{2},$ we multiply $\\frac{3}{2}$ by itself:\n\n$$\n{(\\frac{3}{2})}^{2}=\\frac{3}{2}\\cdot \\frac{3}{2}=\\frac{9}{4}\n$$"}] [{:db/id #edb/ref 17592186443091 :knowledge-point/_questions [{:db/id #edb/ref 17592186133736 :knowledge-point/id #uuid "46e8fb12-e59a-5aba-a9e8-2f872a89b915" :knowledge-point/title "Squaring Negative Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1532522-099e-56ec-9764-1cc17c4b430e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{81}{4}" :db/id #edb/ref 17592186443037}] :answer-field/correct {:answer/id #uuid "b1532522-099e-56ec-9764-1cc17c4b430e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{81}{4}" :db/id #edb/ref 17592186443037} :answer-field/id #uuid "8014c3df-88df-588f-9988-d74a862c708c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186443065}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fa89591c-42d2-57e3-bfd4-69e840192bd4" :question/math-academy-id "q-185191" :question/problem "Expressed as an improper fraction or mixed number, ${(-\\frac{9}{2})}^{2}=${{field-1}}." :question/worked-solution "To work out ${(-\\frac{9}{2})}^{2},$ we multiply $-\\frac{9}{2}$ by itself:\n\n$$\n\\begin{aligned}{(-\\frac{9}{2})}^{2} & = \\\\ (-\\frac{9}{2})\\cdot (-\\frac{9}{2}) & = \\\\ \\frac{9\\cdot 9}{2\\cdot 2} & = \\\\ \\frac{81}{4} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186443087 :knowledge-point/_questions [{:db/id #edb/ref 17592186133737 :knowledge-point/id #uuid "c28f4ffc-5168-5e71-9d77-ae313dd462ad" :knowledge-point/title "Calculating the Square of a Decimal"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "382ab701-ec1b-571c-9078-66310f103b5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.09" :db/id #edb/ref 17592186443003}] :answer-field/correct {:answer/id #uuid "382ab701-ec1b-571c-9078-66310f103b5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.09" :db/id #edb/ref 17592186443003} :answer-field/id #uuid "c316753b-96b3-5e65-8e5d-5fdec3bbcfd0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186443070}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e04ccdd3-f28d-58f9-a502-15fb5e93205e" :question/math-academy-id "q-185196" :question/problem "Expressed as a decimal in its simplest form, $(-0.3)^{2}=${{field-1}}." :question/worked-solution "We need to calculate the product of $-0.3$ with itself:\n\n$$\n(-0.3)^{2}=(-0.3)\\cdot (-0.3)=(0.3)\\cdot (0.3)\n$$\n\nFirst, we ignore the decimal points and multiply as if both numbers were whole numbers:\n\n$$\n3\\times 3=9.\n$$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $1$ decimal place in the first factor ($0.3$) and $1$ decimal place in the second factor ($0.3$), so their product will have $1+1=2$ decimal places.\n\nWe take our value of $9$ and insert a decimal point to make a number with $2$ decimal places:\n\n$$\n0\\,\\overset{↓}{.}\\,\\,\\,{{09}_{⏟}}_{2\\text{ digits}}\n$$\n\nTherefore, $(-0.3)^{2}=0.09\\,.$"}] [{:db/id #edb/ref 17592186443086 :knowledge-point/_questions [{:db/id #edb/ref 17592186133737 :knowledge-point/id #uuid "c28f4ffc-5168-5e71-9d77-ae313dd462ad" :knowledge-point/title "Calculating the Square of a Decimal"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ebb2e927-316a-5479-8921-68cb685d1107" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28.09" :db/id #edb/ref 17592186443048}] :answer-field/correct {:answer/id #uuid "ebb2e927-316a-5479-8921-68cb685d1107" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28.09" :db/id #edb/ref 17592186443048} :answer-field/id #uuid "9d0c6a72-5c4b-569d-8557-e438dfaa81e8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186443067}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c5bedd10-8ffa-5ad9-bdb2-5aa9ca8ef32b" :question/math-academy-id "q-185204" :question/problem "Expressed as a decimal in its simplest form, $(5.3)^{2}=${{field-1}}." :question/worked-solution "We need to calculate the product of $5.3$ with itself:\n\n$$\n{5.3}^{2}=(5.3)\\cdot (5.3)\n$$\n\nFirst, we ignore the decimal points and multiply as if both numbers were whole numbers:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{1} \\\\ \\boxed{}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $53\\times 53=2\\,809.$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $1$ decimal place in the first factor ($5.3$) and $1$ decimal place in the second factor ($5.3$), so their product will have $1+1=2$ decimal places.\n\nWe take our value of $2\\,809$ and insert a decimal point to make a number with $2$ decimal places:\n\n$$\n28\\,\\overset{↓}{.}\\,\\,\\,{{09}_{⏟}}_{2\\text{ digits}}\n$$\n\nTherefore, ${5.3}^{2}=28.09\\,.$"}] [{:db/id #edb/ref 17592186443077 :knowledge-point/_questions [{:db/id #edb/ref 17592186133734 :knowledge-point/id #uuid "a6f6a3fd-67df-5671-aa5d-08471b2ce1fb" :knowledge-point/title "Squaring Positive Whole Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24b98a59-a026-5f28-a1d2-56316d669c6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186443001} {:answer/id #uuid "38cea8c2-e314-556b-bffb-69e3e5ecdc93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186443004} {:answer/id #uuid "76eedab9-2214-5edc-a259-fb95ed2bd905" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :