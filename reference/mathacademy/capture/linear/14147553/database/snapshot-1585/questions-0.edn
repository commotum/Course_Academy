uuid "d90a87cb-27d7-58cc-bcb2-fedd8c803b5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "256" :db/id #edb/ref 17592186443045} {:answer/id #uuid "f387657e-c19c-508d-bc12-1bb030523224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-196" :db/id #edb/ref 17592186443049}] :answer-field/correct {:answer/id #uuid "1e55ed20-0f49-5180-9a2e-e5d01e849230" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "196" :db/id #edb/ref 17592186442998} :answer-field/id #uuid "60d476c8-e088-547a-90fb-077d050bf5a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186443057}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f5d1c8d9-881c-5cab-bdcb-86d5598dd1ea" :question/math-academy-id "q-99691" :question/problem "$(-14)^{2}=$" :question/worked-solution "Since the product of two negative numbers gives a positive number, we have\n\n$$\n(-14)^{2}=(-14)\\cdot (-14)=14\\cdot 14\n$$\n\nNext, we calculate $14\\cdot 14:$\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{1}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n(-14)^{2}={14}^{2}=196.\n$$"}]}
