#{[{:db/id #edb/ref 17592186133507 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133734 :knowledge-point/id #uuid "a6f6a3fd-67df-5671-aa5d-08471b2ce1fb" :knowledge-point/title "Squaring Positive Whole Numbers"}] :question/id #uuid "62c086b3-028f-528b-acd5-7bdc204dcb23" :question/math-academy-id "e-12960" :question/problem "Calculate the value of $7^2.$" :question/worked-solution "To work out $7^2,$ we multiply $7$ by itself:\n\n$$\n7^2 = 7 \\cdot 7 = 49\n$$"}] [{:db/id #edb/ref 17592186133508 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133735 :knowledge-point/id #uuid "eece577d-72b8-5a0d-89fd-1cfa63bf73fb" :knowledge-point/title "Squaring Fractions"}] :question/id #uuid "4a393145-3e63-532b-a288-775fbc7acd15" :question/math-academy-id "e-12961" :question/problem "Find the square of $\\dfrac{1}{2}.$" :question/worked-solution "To work out $\\left(\\dfrac 1 2\\right)^2,$ we multiply $\\dfrac 1 2$ by itself:\n\n$$\n\\left(\\dfrac 1 2\\right)^2 = \\dfrac 1 2 \\cdot \\dfrac 1 2 = \\dfrac 1 4\n$$"}] [{:db/id #edb/ref 17592186133509 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133736 :knowledge-point/id #uuid "46e8fb12-e59a-5aba-a9e8-2f872a89b915" :knowledge-point/title "Squaring Negative Numbers"}] :question/id #uuid "55e8797b-62bd-5515-81a5-e1c13249c1cd" :question/math-academy-id "e-12962" :question/problem "What is the value of $(-4)^2?$" :question/worked-solution "To work out $(-4)^2,$ we multiply $-4$ by itself:\n\n$$\n(-4)^2 = (-4) \\cdot (-4) = 16\n$$"}] [{:db/id #edb/ref 17592186133510 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133737 :knowledge-point/id #uuid "c28f4ffc-5168-5e71-9d77-ae313dd462ad" :knowledge-point/title "Calculating the Square of a Decimal"}] :question/id #uuid "c07254e9-d6a6-55b1-bab7-4fe453c8cc69" :question/math-academy-id "e-12964" :question/problem "What is the square of $-2.5?$" :question/worked-solution "We need to calculate the product of $(-2.5)$ with itself:\n\n$$\n(-2.5)^2 = (-2.5)\\cdot (-2.5) = (2.5)\\cdot (2.5)\n$$\n\nFirst, we ignore the decimal points and multiply as if both numbers were whole numbers:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{\\text{[math]\\color{blue}1[/math]}} \\\\ \\boxed{\\text{[math]\\color{blue}2[/math]}}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $25 \\times 25 =   625.$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $\\color{blue}1$ decimal place in the first factor ($2.5$) and $\\color{blue}1$ decimal place in the second factor ($2.5$), so their product will have ${\\color{blue}{1}} + {\\color{blue}{1}} = 2$ decimal places.\n\nWe take our value of $625$ and insert a decimal point to make a number with $2$ decimal places:\n\n![](images/9f/9f3292917fa7500519b6e0fe1232b414189b00601d56107fc2643990e814c09f.svg)\n\nTherefore, $(-2.5)^2 = 6.25\\,.$"}] [{:db/id #edb/ref 17592186443088 :knowledge-point/_questions [{:db/id #edb/ref 17592186133734 :knowledge-point/id #uuid "a6f6a3fd-67df-5671-aa5d-08471b2ce1fb" :knowledge-point/title "Squaring Positive Whole Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20de766e-2ced-57ee-9c14-3ed78964bac3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186442999} {:answer/id #uuid "56bf350f-603d-5ac8-972b-900c30f8f84e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "585" :db/id #edb/ref 17592186443011} {:answer/id #uuid "6d86f7b2-81df-5df2-bfed-21a28745c62a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "675" :db/id #edb/ref 17592186443017} {:answer/id #uuid "8ca2000c-416b-52fb-8823-6131d2f79842" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "625" :db/id #edb/ref 17592186443028} {:answer/id #uuid "ccb9e185-0326-5b24-9a0d-36e3366cef87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "925" :db/id #edb/ref 17592186443043}] :answer-field/correct {:answer/id #uuid "8ca2000c-416b-52fb-8823-6131d2f79842" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "625" :db/id #edb/ref 17592186443028} :answer-field/id #uuid "b04c32ac-f031-535a-92ae-281451e2d922" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186443069}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e84b722e-1f7b-5e51-918b-729f6c73a9a8" :question/math-academy-id "q-104519" :question/problem "${25}^{2}=$" :question/worked-solution "To work out \n${25}^{2},$\n we multiply \n$25$\n by itself:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{1} \\\\ \\boxed{2}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $25\\times 25=625.$"}] [{:db/id #edb/ref 17592186443075 :knowledge-point/_questions [{:db/id #edb/ref 17592186133737 :knowledge-point/id #uuid "c28f4ffc-5168-5e71-9d77-ae313dd462ad" :knowledge-point/title "Calculating the Square of a Decimal"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2447b23c-518a-583f-94a7-4b1dc6ebfd02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10.24" :db/id #edb/ref 17592186443000} {:answer/id #uuid "64f6dd86-cc7d-5d80-b8e5-879b012c649d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.4" :db/id #edb/ref 17592186443015} {:answer/id #uuid "7fe427d5-a320-59d9-867c-71f5d00edbef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10.24" :db/id #edb/ref 17592186443022} {:answer/id #uuid "85877040-083d-56d8-9695-f3c5224bf53b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10.04" :db/id #edb/ref 17592186443026} {:answer/id #uuid "9e740911-a953-5ae2-bda7-47f9775a596a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6.4" :db/id #edb/ref 17592186443034}] :answer-field/correct {:answer/id #uuid "2447b23c-518a-583f-94a7-4b1dc6ebfd02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10.24" :db/id #edb/ref 17592186443000} :answer-field/id #uuid "7efa277c-8af9-5a93-b5aa-5d04f07f829a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186443064}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "28d7dd84-346e-5b73-9ead-af1c62abb54d" :question/math-academy-id "q-104534" :question/problem "$(-3.2)^{2}=$" :question/worked-solution "We need to calculate the product of $-3.2$ with itself:\n\n$$\n(-3.2)^{2}=(-3.2)\\cdot (-3.2)=(3.2)\\cdot (3.2)\n$$\n\nFirst, we ignore the decimal points and multiply as if both numbers were whole numbers:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $32\\times 32=1\\,024.$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $1$ decimal place in the first factor ($3.2$) and $1$ decimal place in the second factor ($3.2$), so their product will have $1+1=2$ decimal places.\n\nWe take our value of $1\\,024$ and insert a decimal point to make a number with $2$ decimal places:\n\n$$\n10\\,\\overset{↓}{.}\\,\\,\\,{{24}_{⏟}}_{2\\text{ digits}}\n$$\n\nTherefore, ${3.2}^{2}=10.24.$"}] [{:db/id #edb/ref 17592186443078 :knowledge-point/_questions [{:db/id #edb/ref 17592186133737 :knowledge-point/id #uuid "c28f4ffc-5168-5e71-9d77-ae313dd462ad" :knowledge-point/title "Calculating the Square of a Decimal"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bf41ab3-6854-52f9-af7b-9e645e613508" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.96" :db/id #edb/ref 17592186443002}] :answer-field/correct {:answer/id #uuid "2bf41ab3-6854-52f9-af7b-9e645e613508" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.96" :db/id #edb/ref 17592186443002} :answer-field/id #uuid "7c7bab6b-4259-5022-a929-b79ac90b204a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186443063}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "58bd0ac9-9ea6-5ce8-9fc3-fc8a73b17344" :question/math-academy-id "q-171165" :question/problem "Expressed as a decimal in its simplest form, $(-1.4)^{2}=${{field-1}}." :question/worked-solution "We need to calculate the product of $(-1.4)$ with itself:\n\n$$\n(-1.4)^{2}=(-1.4)\\cdot (-1.4)=(1.4)\\cdot (1.4)\n$$\n\nFirst, we ignore the decimal points and multiply as if both numbers were whole numbers:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{1}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $14\\times 14=196.$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $1$ decimal place in the first factor ($1.4$) and $1$ decimal place in the second factor ($1.4$), so their product will have $1+1=2$ decimal places.\n\nWe take our value of $196$ and insert a decimal point to make a number with $2$ decimal places:\n\n$$\n1\\,\\overset{↓}{.}\\,\\,\\,{{96}_{⏟}}_{2\\text{ digits}}\n$$\n\nTherefore, $(-1.4)^{2}=1.96\\,.$"}] [{:db/id #edb/ref 17592186443083 :knowledge-point/_questions [{:db/id #edb/ref 17592186133734 :knowledge-point/id #uuid "a6f6a3fd-67df-5671-aa5d-08471b2ce1fb" :knowledge-point/title "Squaring Positive Whole Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cff0f44b-89c9-56db-8c2f-8696408a68a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49" :db/id #edb/ref 17592186443044}] :answer-field/correct {:answer/id #uuid "cff0f44b-89c9-56db-8c2f-8696408a68a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49" :db/id #edb/ref 17592186443044} :answer-field/id #uuid "2ec9c3e4-e460-5926-9803-da9b081f112f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186443053}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "92b0451f-5a0f-52d2-ba64-98d0de8b76eb" :question/math-academy-id "q-185072" :question/problem "${7}^{2}=${{field-1}}" :question/worked-solution "To work out ${7}^{2},$ we multiply $7$ by itself:\n\n$$\n{7}^{2}=7\\cdot 7=49\n$$"}] [{:db/id #edb/ref 17592186443082 :knowledge-point/_questions [{:db/id #edb/ref 17592186133735 :knowledge-point/id #uuid "eece577d-72b8-5a0d-89fd-1cfa63bf73fb" :knowledge-point/title "Squaring Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41733580-3df2-5744-9f80-a49dec5a053c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{121}" :db/id #edb/ref 17592186443006}] :answer-field/correct {:answer/id #uuid "41733580-3df2-5744-9f80-a49dec5a053c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{121}" :db/id #edb/ref 17592186443006} :answer-field/id #uuid "72a259c8-1862-5958-be0c-d198aafada7d" :answer-field/key