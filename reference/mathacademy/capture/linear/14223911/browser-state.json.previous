>e</mi><mn>3</mn></msup></mtd></mtr><mtr><mtd><mn>2</mn><mi>x</mi></mtd><mtd><mi></mi><mo>=</mo><msup><mi>e</mi><mn>3</mn></msup><mo>+</mo><mn>4</mn></mtd></mtr><mtr><mtd><mi>x</mi></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><msup><mi>e</mi><mn>3</mn></msup><mo>+</mo><mn>4</mn></mrow><mn>2</mn></mfrac></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
