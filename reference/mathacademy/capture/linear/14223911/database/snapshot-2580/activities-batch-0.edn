#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186111508} :activity/id #uuid "5fbb27e3-c74f-5f9c-91d3-ed4d700e940a" :activity/scope {:db/id #edb/ref 17592186048741 :topic/id #uuid "ba61133e-2980-52f4-ab73-d0df517adbd4" :topic/math-academy-id 1551} :activity/steps [{:db/id #edb/ref 17592186111508 :step/content {:db/id #edb/ref 17592186111882 :tutorial/content "To solve logarithmic equations containing the natural logarithm $(\\ln),$ we can use the same method as usual: first isolate the logarithm, and then exponentiate both sides of the equation using the same base as the logarithm.\n\nThe key is to remember that the base of the natural logarithm is $e.$\n\nTo demonstrate, let's solve for $x$ in the equation $\\ln x = 2.$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The logarithm is a natural logarithm, which means its base is $e.$ So, we use a base of $e$ for the exponentiation as well:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡x & =2 \\\\ {e}^{\\operatorname{ln}⁡x} & ={e}^{2}\\end{aligned}\n$$\n\nSince exponentiation is the inverse function of the logarithm, we know that $e^{\\ln x} = x.$ \n\nTherefore, we get\n\n$$\n\\begin{aligned}x & ={e}^{2}.\\end{aligned}\n$$\n\nSo, the solution is $x=e^2.$" :tutorial/id #uuid "7e032551-9488-5bc5-858a-2197849a42cf" :tutorial/math-academy-id 2821 :tutorial/title "Introduction"} :step/id #uuid "c10874f0-296d-50d3-83ba-2cd2a1d44b40" :step/math-academy-id 14892 :step/next {:db/id #edb/ref 17592186111509}} {:db/id #edb/ref 17592186111509 :step/content {:db/id #edb/ref 17592186110606 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110503 :question/id #uuid "44c87021-177d-5f5c-b1f9-47eb08f107a6" :question/math-academy-id "e-4146"} :knowledge-point/id #uuid "8dec21a9-eec8-5e39-9af6-5ba355a11c5b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049589} {:db/id #edb/ref 17592186049944}] :knowledge-point/questions [{:db/id #edb/ref 17592186110937} {:db/id #edb/ref 17592186110938} {:db/id #edb/ref 17592186233034} {:db/id #edb/ref 17592186233608}] :knowledge-point/title "Solving Natural Logarithmic Equations"} :step/id #uuid "ea3b28d0-0f37-51bc-a6fb-d393b2b79ad1" :step/math-academy-id 14893 :step/next {:db/id #edb/ref 17592186111510}} {:db/id #edb/ref 17592186111510 :step/content {:db/id #edb/ref 17592186110607 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110504 :question/id #uuid "0cfb7d21-6ca4-55a3-a46a-7a765ed1b866" :question/math-academy-id "e-4147"} :knowledge-point/id #uuid "0ae88a0b-9927-573b-a072-d0aa1861a9cd" :knowledge-point/questions [{:db/id #edb/ref 17592186111396} {:db/id #edb/ref 17592186111397} {:db/id #edb/ref 17592186233040} {:db/id #edb/ref 17592186233041} {:db/id #edb/ref 17592186526005} {:db/id #edb/ref 17592186526009} {:db/id #edb/ref 17592186537883} {:db/id #edb/ref 17592186537966} {:db/id #edb/ref 17592186537983}] :knowledge-point/title "Solving Natural Logarithmic Equations by First Rearranging the Equation"} :step/id #uuid "058a0098-7255-5e3e-b964-0184ef644aac" :step/math-academy-id 14894 :step/next {:db/id #edb/ref 17592186111511}} {:db/id #edb/ref 17592186111511 :step/content {:db/id #edb/ref 17592186110608 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110505 :question/id #uuid "85f82353-2436-5e48-984a-5e671ee54024" :question/math-academy-id "e-4148"} :knowledge-point/id #uuid "b8c27840-76fa-5c01-98cc-587dc063f19c" :knowledge-point/questions [{:db/id #edb/ref 17592186110882} {:db/id #edb/ref 17592186111369} {:db/id #edb/ref 17592186234259} {:db/id #edb/ref 17592186234262} {:db/id #edb/ref 17592186526100} {:db/id #edb/ref 17592186537941} {:db/id #edb/ref 17592186537958}] :knowledge-point/title "Solving Natural Logarithmic Equations by Combining Logarithmic Terms"} :step/id #uuid "c426a6eb-4605-5f13-aa69-71a65b92078c" :step/math-academy-id 14895}] :activity/title "Solving Logarithmic Equations Containing the Natural Logarithm" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110881}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186538005} :activity/id #uuid "41c20f80-b3b2-5088-bf8c-59a72906730d" :activity/scope {:db/id #edb/ref 17592186048741 :topic/id #uuid "ba61133e-2980-52f4-ab73-d0df517adbd4" :topic/math-academy-id 1551} :activity/steps [{:db/id #edb/ref 17592186537993 :step/content {:db/id #edb/ref 17592186537958 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f7862de-d6b2-526e-b206-39720ffd01fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{{e}^{2}}" :db/id #edb/ref 17592186537295} {:answer/id #uuid "236406ba-3828-526b-b8fd-cb0f5cdb7e72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{3}" :db/id #edb/ref 17592186537305} {:answer/id #uuid "5147f178-8ec1-5bea-a9a5-601c6745cf81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{{e}^{3}}" :db/id #edb/ref 17592186537399} {:answer/id #uuid "ad0979f9-9199-570a-87cc-396dfa37d480" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{{e}^{2}}" :db/id #edb/ref 17592186537556} {:answer/id #uuid "c8a05064-e15b-5c40-9806-46b42919a4eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e" :db/id #edb/ref 17592186537620}] :answer-field/correct {:db/id #edb/ref 17592186537399} :answer-field/id #uuid "9602e175-11e5-59b1-b720-16f8e03a65be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537824}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b08ed48d-cd63-5608-bd95-a1073f0e3d2b" :question/math-academy-id "q-100751" :question/problem "If $\\operatorname{ln}⁡x=9-5\\operatorname{ln}⁡x$, then what is the value of  $x?$" :question/worked-solution "First, we simplify our equation by collecting the like logarithmic terms, and isolating the logarithm, as follows:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡x & =9-5\\operatorname{ln}⁡x \\\\ \\operatorname{ln}⁡x+5\\operatorname{ln}⁡x & =9 \\\\ (1+5)\\operatorname{ln}⁡x & =9 \\\\ 6\\operatorname{ln}⁡x & =9 \\\\ \\operatorname{ln}⁡x & =\\frac{3}{2}\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The logarithm is a natural logarithm, which means its base is $e.$ So, we use a base of $e$ for the exponentiation as well:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡x & =\\frac{3}{2} \\\\ {e}^{\\operatorname{ln}⁡x} & ={e}^{3/2}\\end{aligned}\n$$\n\nSince exponentiation is the inverse function of the logarithm, we get ${e}^{\\operatorname{ln}⁡x}=x.$ \n\nTherefore, \n\n$$\n\\begin{aligned}x & ={e}^{3/2} \\\\ x & =\\sqrt{{e}^{3}}.\\end{aligned}\n$$"} :step/id #uuid "00083c00-24dc-506e-a324-73b019d6c818" :step/next {:db/id #edb/ref 17592186537997}} {:db/id #edb/ref 17592186537994 :step/content {:db/id #edb/ref 17592186537883 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03cb6034-c7f0-53cf-a5c7-f386c1a926a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{e}^{3}+1}{4}" :db/id #edb/ref 17592186537234} {:answer/id #uuid "423c0019-e126-5d75-a32d-16e3969d0e8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4-{e}^{3}}{3}" :db/id #edb/ref 17592186537367} {:answer/id #uuid "46b90bb8-0fc7-5c5c-bad2-2fb0c93cdf89" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{e}^{3}+4}{2}" :db/id #edb/ref 17592186537375} {:answer/id #uuid "a4210421-e445-52ec-9f6c-78182e46d202" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{e}^{3}-2}{4}" :db/id #edb/ref 17592186537538} {:answer/id #uuid "d7e54fd4-d7c6-5ca2-b825-fe7894787dd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2-{e}^{3}}{3}" :db/id #edb/ref 17592186537658}] :answer-field/correct {:db/id #edb/ref 17592186537375} :answer-field/id #uuid "3106eed6-8bd8-551a-ae54-4cf6a337b987" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537774}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "062c010f-c635-5129-83e7-3b14e937de12" :question/math-academy-id "q-79392" :question/problem "Find the exact solution to $3\\operatorname{ln}⁡(2x-4)-1=8.$" :question/worked-solution "First, we rearrange our equation to isolate the logarithmic term, as follows:\n\n$$\n\\begin{aligned}3\\operatorname{ln}⁡(2x-4)-1 & =8 \\\\ 3\\operatorname{ln}⁡(2x-4) & =9 \\\\ \\operatorname{ln}⁡(2x-4) & =3\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The logarithm is a natural logarithm, which means its base is $e.$ So, we use a base of $e$ for the exponentiation as well:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(2x-4) & =3 \\\\ {e}^{\\operatorname{ln}⁡(2x-4)} & ={e}^{3}\\end{aligned}\n$$\n\nSince exponentiation is the inverse function of the logarithm, we get ${e}^{\\operatorname{ln}⁡(2x-4)}=2x-4.$ \n\nTherefore, \n\n$$\n\\begin{aligned}2x-4 & ={e}^{3} \\\\ 2x & ={e}^{3}+4 \\\\ x & =\\frac{{e}^{3}+4}{2}.\\end{aligned}\n$$"} :step/id #uuid "013f2eef-7094-5b40-95fe-1315ad5661d1" :step/next {:db/id #edb/ref 17592186537993}} {:db/id #edb/ref 17592186537997 :step/content {:db/id #edb/ref 17592186537983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "146cac5a-4870-5181-a369-791a7c7c4c11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e" :db/id #edb/ref 17592186537270} {:answer/id #uuid "39668388-df55-5c1b-9911-4aa95c56cdd9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{e}" :db/id #edb/ref 17592186537348} {:answer/id #uuid "a316d92a-a701-5e92-bd9c-d1bddecf5a6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{{e}^{2}}" :db/id #edb/ref 17592186537536} {:answer/id #uuid "e0c503b8-3b2b-5c25-9b53-fa466c49ee04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186537682} {:answer/id #uuid "ec9c5137-c2c7-55cc-b9a1-73b832be0821" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{2}" :db/id #edb/ref 17592186537713}] :answer-field/correct {:db/id #edb/ref 17592186537682} :answer-field/id #uuid "665803db-21ed-53a8-9497-9d47247879f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537799}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e999e0ab-2ba5-58ed-8052-a9586c979824" :question/math-academy-id "q-110775" :question/problem "If $3\\operatorname{ln}⁡x+3=3,$ what is the value of $x?$" :question/worked-solution "First, we rearrange our equation to isolate the logarithmic term, as follows:\n\n$$\n\\begin{aligned}3\\operatorname{ln}⁡x+3 & =3 \\\\ 3\\operatorname{ln}⁡x & =0 \\\\ \\operatorname{ln}⁡x & =0\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The logarithm is a natural logarithm, which means its base is $e.$ So, we use a base of $e$ for the exponentiation as well:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡x & =0 \\\\ {e}^{\\operatorname{ln}⁡x} & ={e}^{0}\\end{aligned}\n$$\n\nSince exponentiation is the inverse function of the logarithm, we get ${e}^{\\operatorname{ln}⁡x}=x.$ \n\nTherefore, \n\n$$\nx={e}^{0}=1.\n$$"} :step/id #uuid "17f79400-9491-54ee-b554-54208170f405"} {:db/id #edb/ref 17592186538005 :step/content {:db/id #edb/ref 17592186537966 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4819ad5b-9efa-59de-9c5c-40a63dadea1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{{e}^{3}}{2}" :db/id #edb/ref 17592186537380} {:answer/id #uuid "485ce7f6-d535-5e25-8131-84e8b304bdd0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{2-{e}^{5}}{5}" :db/id #edb/ref 17592186537381} {:answer/id #uuid "819a7a90-d083-5d62-b2d3-fb97bead1c45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{{e}^{5}}{4}" :db/id #edb/ref 17592186537480} {:answer/id #uuid "d13a84a6-bc8d-5087-a25f-d140018a6241" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{{e}^{15}}{2}" :db/id #edb/ref 17592186537636} {:answer/id #uuid "eda2fd74-1804-5bf0-a2e8-9ade861ff1b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{15-{e}^{5}}{2}" :db/id #edb/ref 17592186537717}] :answer-field/correct {:db/id #edb/ref 17592186537380} :answer-field/id #uuid "e95ab9e0-e927-517c-a06b-b2eb56a8f8a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537869}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c0394c3f-264a-5afa-ba91-982051eae5c0" :question/math-academy-id "q-19176" :question/problem "Find the exact solution to $5\\operatorname{ln}⁡(2x)=15.$" :question/worked-solution "First, we rearrange our equation to isolate the logarithmic term, as follows:\n\n$$\n\\begin{aligned}5\\operatorname{ln}⁡(2x) & =15 \\\\ \\operatorname{ln}⁡(2x) & =\\frac{15}{5} \\\\ \\operatorname{ln}⁡(2x) & =3\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The logarithm is a natural logarithm, which means its base is $e.$ So, we use a base of $e$ for the exponentiation as well:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(2x) & =3 \\\\ {e}^{\\operatorname{ln}⁡(2x)} & ={e}^{3}\\end{aligned}\n$$\n\nSince exponentiation is the inverse function of the logarithm, we get ${e}^{\\operatorname{ln}⁡(2x)}=2x.$ \n\nTherefore, \n\n$$\n\\begin{aligned}2x & ={e}^{3} \\\\ x & =\\frac{{e}^{3}}{2}.\\end{aligned}\n$$"} :step/id #uuid "3142a03a-104a-5f55-930a-5477fde300ba" :step/next {:db/id #edb/ref 17592186538063}} {:db/id #edb/ref 17592186538063 :step/content {:db/id #edb/ref 17592186537941 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09c558eb-fd0d-5210-be98-00e719c69f54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{e}^{2}}{4}" :db/id #edb/ref 17592186537240} {:answer/id #uuid "53886b5d-6f70-5e43-94e2-1e5c1874216b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{4}" :db/id #edb/ref 17592186537403} {:answer/id #uuid "5ac81716-290f-5f5e-ba9c-4a78de5c2654" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{e}" :db/id #edb/ref 17592186537412} {:answer/id #uuid "d2fd44e1-bc2d-5988-aa65-9c881a641c2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[3]{e}" :db/id #edb/ref 17592186537642} {:answer/id #uuid "f7a62d43-c981-536a-8470-beb381af763b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{e}^{20}}{5}" :db/id #edb/ref 17592186537736}] :answer-field/correct {:db/id #edb/ref 17592186537403} :answer-field/id #uuid "9c3ba825-9890-578d-9db6-d3a5c2724c7e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537829}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9bdc2bf5-cb58-518d-9b62-85ffcb2b1edc" :question/math-academy-id "q-70040" :question/problem "If $2\\operatorname{ln}⁡x+3\\operatorname{ln}⁡x=20$, then what is the value of  $x?$" :question/worked-solution "First, we simplify our equation by collecting the like logarithmic terms, and isolating the logarithm, as follows:\n\n$$\n\\begin{aligned}2\\operatorname{ln}⁡x+3\\operatorname{ln}⁡x & =20 \\\\ (2+3)\\operatorname{ln}⁡x & =20 \\\\ 5\\operatorname{ln}⁡x & =20 \\\\ \\operatorname{ln}⁡x & =\\frac{20}{5} \\\\ \\operatorname{ln}⁡x & =4.\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The logarithm is a natural logarithm, which means its base is $e.$ So, we use a base of $e$ for the exponentiation as well:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡x & =4 \\\\ {e}^{\\operatorname{ln}⁡x} & ={e}^{4}\\end{aligned}\n$$\n\nSince exponentiation is the inverse function of the logarithm, we get ${e}^{\\operatorname{ln}⁡x}=x.$ \n\nTherefore, $x={e}^{4}.$"} :step/id #uuid "e9fb026a-3bec-5018-a15c-ff7fb93b10fd" :step/next {:db/id #edb/ref 17592186537994}}] :activity/title "Solving Logarithmic Equations Containing the Natural Logarithm" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186537210}]}
