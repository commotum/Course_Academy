045417] [17592186559602 #edb/ref 1080 "-62" #edb/ref 17592186045417] [17592186559602 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186559602 #edb/ref 1083 #uuid "f0abb498-6f9d-58b7-99be-b0bcc10995cc" #edb/ref 17592186045417] [17592186559645 #edb/ref 1075 #edb/ref 17592186559391 #edb/ref 17592186045417] [17592186559645 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186559645 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186559645 #edb/ref 1078 #edb/ref 17592186559391 #edb/ref 17592186045417] [17592186559645 #edb/ref 1079 #uuid "0bac2356-e89d-5b9a-9d4b-f566c2759495" #edb/ref 17592186045417] [17592186559708 #edb/ref 1075 #edb/ref 17592186559032 #edb/ref 17592186045417] [17592186559708 #edb/ref 1075 #edb/ref 17592186559060 #edb/ref 17592186045417] [17592186559708 #edb/ref 1075 #edb/ref 17592186559225 #edb/ref 17592186045417] [17592186559708 #edb/ref 1075 #edb/ref 17592186559474 #edb/ref 17592186045417] [17592186559708 #edb/ref 1075 #edb/ref 17592186559602 #edb/ref 17592186045417] [17592186559708 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186559708 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186559708 #edb/ref 1078 #edb/ref 17592186559602 #edb/ref 17592186045417] [17592186559708 #edb/ref 1079 #uuid "7219bea5-8ca7-51f2-9ec4-6aea1bd10dc8" #edb/ref 17592186045417] [17592186559811 #edb/ref 1068 #edb/ref 17592186559708 #edb/ref 17592186045417] [17592186559811 #edb/ref 1069 "q-115600" #edb/ref 17592186045417] [17592186559811 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186559811 #edb/ref 1071 "Let $b$ be directly proportional to $g.$ Given that $b=98$ when $g=-7$, find the value of $b$ when $g=\\frac{31}{7}.$" #edb/ref 17592186045417] [17592186559811 #edb/ref 1072 #uuid "5ce15c8c-b8c7-513a-aedc-297e6604d6a3" #edb/ref 17592186045417] [17592186559811 #edb/ref 1074 "Since $b$ varies directly with $g,$ we use the equation\n\n$$\nb=kg.\n$$\n\nWe are told that $b=98$ when $g=-7.$ We substitute this data into the equation to find $k:$\n\n$$\n\\begin{aligned}98 & =k\\cdot (-7) \\\\ \\frac{98}{(-7)} & =k \\\\ -14 & =k\\end{aligned}\n$$\n\nSo, the direct variation equation is given by\n\n$$\nb=-14g.\n$$\n\nFinally, substituting the value of $g=\\frac{31}{7}$ into this equation gives\n\n$$\n\\begin{aligned}b & =-14\\cdot \\frac{31}{7} \\\\  & =-2\\cdot 31 \\\\  & =-62.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186559849 #edb/ref 1068 #edb/ref 17592186559645 #edb/ref 17592186045417] [17592186559849 #edb/ref 1069 "q-170877" #edb/ref 17592186045417] [17592186559849 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186559849 #edb/ref 1071 "Suppose $v$ is directly proportional to $u.$ Given that $v=-12$ when $u=3$, find the value of $v$ when $u=5.${{field-1}}." #edb/ref 17592186045417] [17592186559849 #edb/ref 1072 #uuid "b590fcf1-ec20-533b-be69-95e4b245f98f" #edb/ref 17592186045417] [17592186559849 #edb/ref 1074 "Since $v$ varies directly with $u,$ we use the equation\n\n$$\nv=ku.\n$$\n\nWe are told that $v=-12$ when $u=3.$ We substitute this data into the equation to find $k:$\n\n$$\n\\begin{aligned}-12 & =k\\cdot 3 \\\\ \\frac{(-12)}{3} & =k \\\\ -4 & =k\\end{aligned}\n$$\n\nSo, the direct variation equation is given by\n\n$$\nv=-4u.\n$$\n\nFinally, substituting the value of $u=5$ into this equation gives\n\n$$\n\\begin{aligned}v & =-4\\cdot 5=-20.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186559921 #edb/ref 1058 #edb/ref 17592186559970 #edb/ref 17592186045417] [17592186559921 #edb/ref 1062 #uuid "47b80ac9-74af-5bd8-9d8e-2a4389248412" #edb/ref 17592186045417] [17592186559921 #edb/ref 1063 #edb/ref 17592186152666 #edb/ref 17592186045417] [17592186559929 #edb/ref 1062 #uuid "5272e248-00bc-5399-9b74-6540dfa2cf52" #edb/ref 17592186045417] [17592186559929 #edb/ref 1063 #edb/ref 17592186559849 #edb/ref 17592186045417] [17592186559970 #edb/ref 1058 #edb/ref 17592186559929 #edb/ref 17592186045417] [17592186559970 #edb/ref 1062 #uuid "c8307780-4519-5f2b-8645-dac88fec372c" #edb/ref 17592186045417] [17592186559970 #edb/ref 1063 #edb/ref 17592186559811 #edb/ref 17592186045417]}
