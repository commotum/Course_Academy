#{[{:db/id #edb/ref 17592186559811 :knowledge-point/_questions [{:db/id #edb/ref 17592186152272 :knowledge-point/id #uuid "3f29a835-91e3-51e3-a016-e13d296b7654" :knowledge-point/title "Solving for an Unknown Amount"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "084c23f6-d996-50e5-a433-1f7029a87dd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-31" :db/id #edb/ref 17592186559032} {:answer/id #uuid "139bd3a5-a604-5f9b-9ae1-5ed234a6ade6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "31" :db/id #edb/ref 17592186559060} {:answer/id #uuid "52dc2da6-2a46-5aa0-a09e-218bf0c62453" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186559225} {:answer/id #uuid "b784a9d6-44a1-5356-9039-0276f2c60082" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "62" :db/id #edb/ref 17592186559474} {:answer/id #uuid "f0abb498-6f9d-58b7-99be-b0bcc10995cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-62" :db/id #edb/ref 17592186559602}] :answer-field/correct {:answer/id #uuid "f0abb498-6f9d-58b7-99be-b0bcc10995cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-62" :db/id #edb/ref 17592186559602} :answer-field/id #uuid "7219bea5-8ca7-51f2-9ec4-6aea1bd10dc8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559708}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5ce15c8c-b8c7-513a-aedc-297e6604d6a3" :question/math-academy-id "q-115600" :question/problem "Let $b$ be directly proportional to $g.$ Given that $b=98$ when $g=-7$, find the value of $b$ when $g=\\frac{31}{7}.$" :question/worked-solution "Since $b$ varies directly with $g,$ we use the equation\n\n$$\nb=kg.\n$$\n\nWe are told that $b=98$ when $g=-7.$ We substitute this data into the equation to find $k:$\n\n$$\n\\begin{aligned}98 & =k\\cdot (-7) \\\\ \\frac{98}{(-7)} & =k \\\\ -14 & =k\\end{aligned}\n$$\n\nSo, the direct variation equation is given by\n\n$$\nb=-14g.\n$$\n\nFinally, substituting the value of $g=\\frac{31}{7}$ into this equation gives\n\n$$\n\\begin{aligned}b & =-14\\cdot \\frac{31}{7} \\\\  & =-2\\cdot 31 \\\\  & =-62.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186559849 :knowledge-point/_questions [{:db/id #edb/ref 17592186152272 :knowledge-point/id #uuid "3f29a835-91e3-51e3-a016-e13d296b7654" :knowledge-point/title "Solving for an Unknown Amount"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9625a562-0617-5d9b-abc5-16cb402a5d88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186559391}] :answer-field/correct {:answer/id #uuid "9625a562-0617-5d9b-abc5-16cb402a5d88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186559391} :answer-field/id #uuid "0bac2356-e89d-5b9a-9d4b-f566c2759495" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186559645}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b590fcf1-ec20-533b-be69-95e4b245f98f" :question/math-academy-id "q-170877" :question/problem "Suppose $v$ is directly proportional to $u.$ Given that $v=-12$ when $u=3$, find the value of $v$ when $u=5.${{field-1}}." :question/worked-solution "Since $v$ varies directly with $u,$ we use the equation\n\n$$\nv=ku.\n$$\n\nWe are told that $v=-12$ when $u=3.$ We substitute this data into the equation to find $k:$\n\n$$\n\\begin{aligned}-12 & =k\\cdot 3 \\\\ \\frac{(-12)}{3} & =k \\\\ -4 & =k\\end{aligned}\n$$\n\nSo, the direct variation equation is given by\n\n$$\nv=-4u.\n$$\n\nFinally, substituting the value of $u=5$ into this equation gives\n\n$$\n\\begin{aligned}v & =-4\\cdot 5=-20.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186152666 :knowledge-point/_questions [{:db/id #edb/ref 17592186152271 :knowledge-point/id #uuid "2a9d0449-2b61-5979-bd5c-94c33c8899c2" :knowledge-point/title "Identifying the Equation of a Proportional Relationship"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "103709a2-22c6-5949-b0cd-dcd0a6b21cb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=900x" :db/id #edb/ref 17592186559055} {:answer/id #uuid "28206bbb-1d0c-5761-98a7-04bf422d3d59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{225}{x}" :db/id #edb/ref 17592186559116} {:answer/id #uuid "43b4ca6f-6da3-5d02-ad82-9a4ba6031881" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{225}" :db/id #edb/ref 17592186559192} {:answer/id #uuid "6f2f078c-1c25-5c7c-888a-0e00bc4cb766" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=450x" :db/id #edb/ref 17592186559291} {:answer/id #uuid "7f6e8d8b-8c88-56a9-9d7a-dfc845a80f68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=225x" :db/id #edb/ref 17592186559332}] :answer-field/correct {:answer/id #uuid "7f6e8d8b-8c88-56a9-9d7a-dfc845a80f68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=225x" :db/id #edb/ref 17592186559332} :answer-field/id #uuid "f68181be-98c9-5512-b756-2bae65bbe2ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186150503}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2352802a-045d-530a-8500-09dde40a2d51" :question/math-academy-id "q-68126" :question/problem "Jordan wants to paint the outside of his home. Using $2$ gallons of paint, he was able to paint $450$ square feet of the surface. There is a proportional relationship between the volume of paint $x$ (in gallons) that Jordan uses and the area $y$ (in square feet) he paints. What is the equation that represents the relationship between $x$ and $y?$" :question/worked-solution "Every proportional relationship takes the form $y=kx,$ where $k$ is the constant of proportionality.\n\nWe are told that Jordan painted $y=450$ square feet using $x=2$ gallons of paint.\n\nWe can find the constant of proportionality by computing the ratio of the $y$-value to the $x$-value, as follows:\n\n$$\nk=\\frac{y}{x}=\\frac{450}{2}=225\n$$\n\nTherefore, the equation is\n\n$$\ny=225x.\n$$"}]}
