      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14215685/observations/step-q87483-69fee15001a6cc353a7e.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14215685/observations/step-q87483-69fee15001a6cc353a7e.png",
      "source_url": "https://mathacademy.com/tasks/14215685/topics/634/lesson",
