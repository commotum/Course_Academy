      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14215685/observations/step-q113470-8ed4fc105e73fe02e012.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14215685/observations/step-q113470-8ed4fc105e73fe02e012.png",
      "source_url": "https://mathacademy.com/tasks/14215685/topics/634/lesson",
      "captured_at": 1792010377.7891166,
      "math_academy_id": "q-113470",
      "topic_id": "634",
      "sequence_position": null,
      "source_step": {
