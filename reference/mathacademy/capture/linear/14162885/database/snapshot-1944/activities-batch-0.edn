#{[{:activity/first-step {:db/id #edb/ref 17592186079368} :activity/id #uuid "b56ff108-291d-5d19-aeb2-d9b3b68e1a5d" :activity/scope {:db/id #edb/ref 17592186048406 :topic/id #uuid "9c6680ce-b054-5a2f-878e-d9e635500c51" :topic/math-academy-id 657} :activity/steps [{:db/id #edb/ref 17592186079368 :step/content {:db/id #edb/ref 17592186079723 :tutorial/content "The **degree** of a polynomial is the value of the largest exponent of the variable.\n\nFor example, consider the polynomial\n$7x +2x^{{\\color{blue}{3}}} -4 +x^2$.\nThe degree of the polynomial is ${\\color{blue}3}$ since this is the value of the largest exponent." :tutorial/id #uuid "13b3a7c8-0ad6-57f3-858f-9c57bd52466b" :tutorial/math-academy-id 8862 :tutorial/title "Introduction"} :step/id #uuid "9baac957-519c-5119-8cb7-1079530f47e1" :step/math-academy-id 192491 :step/next {:db/id #edb/ref 17592186079369}} {:db/id #edb/ref 17592186079369 :step/content {:db/id #edb/ref 17592186078472 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078176 :question/id #uuid "2d2a155b-89cd-5783-b90b-1c65c023b4d3" :question/math-academy-id "e-14289"} :knowledge-point/id #uuid "aa19126a-830f-5a11-a12b-2e150a520ecf" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050396}] :knowledge-point/questions [{:db/id #edb/ref 17592186078718} {:db/id #edb/ref 17592186078774} {:db/id #edb/ref 17592186079060} {:db/id #edb/ref 17592186459272} {:db/id #edb/ref 17592186480636} {:db/id #edb/ref 17592186487312}] :knowledge-point/title "Identifying the Degree of a Polynomial"} :step/id #uuid "0c07d7c7-4bb4-5e84-9a5b-3d92a2515f80" :step/math-academy-id 192492 :step/next {:db/id #edb/ref 17592186079370}} {:db/id #edb/ref 17592186079370 :step/content {:db/id #edb/ref 17592186079724 :tutorial/content "Let's go back to our polynomial\n$7x +{\\color{blue}{2x^3}} {\\color{red}{-4}} +x^2$.\n\nNote the following definitions:\n\n- The term with the largest power of $x$, which is ${\\color{blue}{2x^3}}$, is called the **leading term**.\n- The coefficient of the leading term, ${\\color{blue}{2}}$, is called the **leading coefficient**.\n- The term ${\\color{red}{-4}}$ is called the **constant term** because it has no variable.\n\nFor some polynomials, the constant term is zero. For example:\n\n$$\n3x^3-2x+x\n$$" :tutorial/id #uuid "ccaae2e9-4779-5a96-856c-6b1cf1af2b1d" :tutorial/math-academy-id 8865 :tutorial/title "Leading Terms, Leading Coefficients, and Constant Terms"} :step/id #uuid "c4f8cb45-4abb-5e72-9f6c-c3aa0b09aa92" :step/math-academy-id 192496 :step/next {:db/id #edb/ref 17592186079371}} {:db/id #edb/ref 17592186079371 :step/content {:db/id #edb/ref 17592186078473 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078177 :question/id #uuid "03d8be55-6272-5db5-bb16-76bc483ff746" :question/math-academy-id "e-14294"} :knowledge-point/id #uuid "373af58f-6ece-5d03-936b-616f3afeda4a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049018}] :knowledge-point/questions [{:db/id #edb/ref 17592186078719} {:db/id #edb/ref 17592186078775} {:db/id #edb/ref 17592186078925}] :knowledge-point/title "Identifying Leading Terms, Leading Coefficients, and Constant Terms"} :step/id #uuid "2082646b-8e4c-59f6-b715-7b33dbb9d8b8" :step/math-academy-id 192497 :step/next {:db/id #edb/ref 17592186079372}} {:db/id #edb/ref 17592186079372 :step/content {:db/id #edb/ref 17592186079725 :tutorial/content "Each type of polynomial of degree between $0$ and $5$ has a specific name:\n\n| Degree | Name | Example |\n| --- | ---: | ---: |\n| $0$ | Constant | $7$ |\n| $1$ | Linear | $3x + 2$ |\n| $2$ | Quadratic | $2x^2 - 6x + 1$ |\n| $3$ | Cubic | $x^3 + 4x^2 + 9x$ |\n| $4$ | Quartic | $3x^4 - 5x^2$ |\n| $5$ | Quintic | $7x^5 + 3x^4 - x^4 + x - 6$ |" :tutorial/id #uuid "31a59582-6741-5e01-a77f-90fdff1b8ea3" :tutorial/math-academy-id 8869 :tutorial/title "Names of Polynomials Based on Their Degree"} :step/id #uuid "abeee5ec-a795-5a60-9277-dcc559d6afe4" :step/math-academy-id 192501 :step/next {:db/id #edb/ref 17592186079373}} {:db/id #edb/ref 17592186079373 :step/content {:db/id #edb/ref 17592186078474 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078178 :question/id #uuid "8dd5ce3a-38ee-5ea5-95b5-5fbba86e4a3c" :question/math-academy-id "e-14298"} :knowledge-point/id #uuid "ff8c1a66-fb63-5c0d-839b-72320212ca24" :knowledge-point/questions [{:db/id #edb/ref 17592186078854} {:db/id #edb/ref 17592186078959} {:db/id #edb/ref 17592186079064}] :knowledge-point/title "Classifying Polynomials According to Their Degree"} :step/id #uuid "cc81c593-3ec2-5424-8458-b006dd1a4adb" :step/math-academy-id 192502}] :activity/title "The Degree of a Polynomial" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078678}] [{:activity/first-step {:db/id #edb/ref 17592186055787} :activity/id #uuid "c92749c4-4aff-5706-a8e8-46b1a5867d8f" :activity/scope {:db/id #edb/ref 17592186048524 :topic/id #uuid "a6b1981e-1258-53df-8262-f14fa4fe97b1" :topic/math-academy-id 81} :activity/steps [{:db/id #edb/ref 17592186055787 :step/content {:db/id #edb/ref 17592186056067 :tutorial/content "Suppose that we have the two polynomials $6x^2 + x +1$ and $2x^2 - 3x + 6$, and we want to add them. To do that, we put a plus sign between the two, collect like terms, and then simplify:\n\n$$\n\\begin{aligned}\n(6x^{2} + x + 1) + (2x^{2} - 3x + 6) &=  \\\\\n6x^{2} + x + 1 + 2x^{2} - 3x + 6 &=  \\\\\n6x^{2} + 2x^{2}_(⏟)_(x^{2}terms) + x - 3x^(⏞)^(xterms) + 1 + 6_(⏟)_(constants) &=  \\\\\n(6 + 2)x^{2} + (1 - 3)x + 7 &=  \\\\\n&= 8x^{2} - 2x + 7\n\\end{aligned}\n$$" :tutorial/id #uuid "f6745611-70da-526a-9a6c-143b072c13c2" :tutorial/math-academy-id 8873 :tutorial/title "Introduction"} :step/id #uuid "7baea5d5-f521-54dc-aa2f-ff6e04e9e58c" :step/math-academy-id 521385 :step/next {:db/id #edb/ref 17592186055788}} {:db/id #edb/ref 17592186055788 :step/content {:db/id #edb/ref 17592186054773 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054472 :question/id #uuid "c14b3658-bbe4-53f8-a0b6-377b2586f099" :question/math-academy-id "e-14305"} :knowledge-point/id #uuid "e4a8dbbc-4d43-53de-97fa-59eb5c78d8b7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049538}] :knowledge-point/questions [{:db/id #edb/ref 17592186054962} {:db/id #edb/ref 17592186055146} {:db/id #edb/ref 17592186055299}] :knowledge-point/title "Adding Polynomials"} :step/id #uuid "46ff7c1c-0ad5-5a99-a07f-4743ea906700" :step/math-academy-id 521386 :step/next {:db/id #edb/ref 17592186055789}} {:db/id #edb/ref 17592186055789 :step/content {:db/id #edb/ref 17592186054774 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054473 :question/id #uuid "c2e54fec-23da-515b-994b-8fa0601b5a9d" :question/math-academy-id "e-14307"} :knowledge-point/id #uuid "ad65c6c8-d57c-520e-9e2d-c1dc59979e19" :knowledge-point/questions [{:db/id #edb/ref 17592186055106} {:db/id #edb/ref 17592186055111} {:db/id #edb/ref 17592186055441} {:db/id #edb/ref 17592186484207} {:db/id #edb/ref 17592186484257}] :knowledge-point/title "Adding Polynomials Expressed as Functions"} :step/id #uuid "d2d2808c-5375-5c39-8d76-ed44abc7a434" :step/math-academy-id 521390 :step/next {:db/id #edb/ref 17592186055790}} {:db/id #edb/ref 17592186055790 :step/content {:db/id #edb/ref 17592186056068 :tutorial/content "Suppose that we want to *subtract* the polynomial $2x^2 + x$ from the polynomial $6x^2 - 3x +1$. To do that, we start by putting a minus sign between the two:\n\n$$\n(6x^2 - 3x +1) - (2x^2 + x)\n$$\n\nHere, we need to remember to distribute the minus sign. Once we've done that, we can collect like terms and then simplify as usual:\n\n$$\n\\begin{aligned}\n(6x^{2} - 3x + 1) - (2x^{2} + x) &=  \\\\\n6x^{2} - 3x + 1 - 2x^{2} - x &=  \\\\\n6x^{2} - 2x^{2} - 3x - x + 1 &=  \\\\\n(6 - 2)x^{2} + (-3 - 1)x + 1 &=  \\\\\n&= 4x^{2} - 4x + 1\n\\end{aligned}\n$$" :tutorial/id #uuid "90da9a1a-3727-51e9-ad38-7db8b7ed3e20" :tutorial/math-academy-id 8875 :tutorial/title "The Difference of Two Polynomials"} :step/id #uuid "a0375f2a-c27c-50dc-b2aa-7d86343e6e08" :step/math-academy-id 521394 :step/next {:db/id #edb/ref 17592186055791}} {:db/id #edb/ref 17592186055791 :step/content {:db/id #edb/ref 17592186054775 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054474 :question/id #uuid "4d680b83-1789-5786-92a5-313073b253c4" :question/math-academy-id "e-14310"} :knowledge-point/id #uuid "aa0b0b8a-3d45-5602-a842-a1b7f50ffcea" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049939}] :knowledge-point/questions [{:db/id #edb/ref 17592186055112} {:db/id #edb/ref 17592186055472} {:db/id #edb/ref 17592186055485} {:db/id #edb/ref 17592186459268} {:db/id #edb/ref 17592186480638} {:db/id #edb/ref 17592186484273} {:db/id #edb/ref 17592186487384}] :knowledge-point/title "Subtracting Polynomials"} :step/id #uuid "015841f6-ea30-5123-b4ff-814780c357f9" :step/math-academy-id 521395 :step/next {:db/id #edb/ref 17592186055792}} {:db/id #edb/ref 17592186055792 :step/content {:db/id #edb/ref 17592186054776 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054475 :question/id #uuid "4c4aa55e-a77c-58c5-a3f7-74a7cf57eb48" :question/math-academy-id "e-14315"} :knowledge-point/id #uuid "abd67412-213b-5019-94ca-c4fb8bb39fc1" :knowledge-point/questions [{:db/id #edb/ref 17592186054963} {:db/id #edb/ref 17592186055107} {:db/id #edb/ref 17592186055147}] :knowledge-point/title "Subtracting Polynomials Expressed as Functions"} :step/id #uuid "7c7ca7d9-ecb0-5c71-a008-51cd9a46b417" :step/math-academy-id 521399}] :activity/title "Adding and Subtracting Polynomials" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054925}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186484322} :activity/id #uuid "73266ed4-30cb-5847-ac3d-ab851cbca830" :activity/scope {:db/id #edb/ref 17592186048524 :topic/id #uuid "a6b1981e-1258-53df-8262-f14fa4fe97b1" :topic/math-academy-id 81} :activity/steps [{:db/id #edb/ref 17592186484308 :step/content {:db/id #edb/ref 17592186484207 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2c0111b-77f9-5dd6-b35b-60f59cc17ed0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y^{4}+5y^{2}-4" :db/id #edb/ref 17592186483951}] :answer-field/correct {:db/id #edb/ref 17592186483951} :answer-field/id #uuid "a8ce49c6-f3b3-587c-9376-29dad2462846" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186484166}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3049a347-62dd-59fc-b924-9cdaded3eea2" :question/math-academy-id "q-236407" :question/problem "Given that $f(y)={y}^{4}+3{y}^{2}-1$ and $g(y)=2{y}^{2}-3,$ write $f(y)+g(y)$ in **standard form**.\n\n$f(y)+g(y)=$\n{{field-1}}" :question/worked-solution "We put a plus sign between the two polynomials, collect like terms, and then simplify:\n\n$$\n\\begin{aligned}f(y)+g(y) & = \\\\ ({y}^{4}+3{y}^{2}-1)+(2{y}^{2}-3) & = \\\\ {y}^{4}+3{y}^{2}-1+2{y}^{2}-3 & = \\\\ {y}^{4}+(3+2){y}^{2}+(-1-3) & = \\\\ {y}^{4}+5{y}^{2}-4\\end{aligned}\n$$"} :step/id #uuid "1820fa64-0ab6-516c-bd75-2c95420c5d15"} {:db/id #edb/ref 17592186484322 :step/content {:db/id #edb/ref 17592186484257 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e5d516a-08ba-570d-8dc1-5319b30942d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{x}^{2}-2x" :db/id #edb/ref 17592186483863} {:answer/id #uuid "c5101782-6ba9-51e4-a135-77437e019f9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{x}^{2}+x-1" :db/id #edb/ref 17592186483956} {:answer/id #uuid "ce9eb22e-586f-5330-b915-b57b472e6c22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{x}^{2}-x" :db/id #edb/ref 17592186483983} {:answer/id #uuid "d4bbd9a1-0041-563d-a914-532f0f7cd1d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{x}^{2}+x" :db/id #edb/ref 17592186483992} {:answer/id #uuid "eb97ed63-c199-57e5-8df5-f83c4126e6c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{x}^{2}-2x-1" :db/id #edb/ref 17592186484032}] :answer-field/correct {:db/id #edb/ref 17592186483992} :answer-field/id #uuid "8a7113b0-a58d-57b5-a47a-af43596f7853" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186484152}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a1334155-0338-53af-b4b4-aaee0097bc49" :question/math-academy-id "q-52149" :question/problem "If  $f(x)={x}^{2}+2x-1$ and $g(x)={x}^{2}-x+1,$ then $f(x)+g(x)=$" :question/worked-solution "We put a plus sign between the two polynomials, collect like terms, and then simplify:\n\n$$\n\\begin{aligned}f(x)+g(x) & = \\\\ ({x}^{2}+2x-1)+({x}^{2}-x+1) & = \\\\ {x}^{2}+2x-1+{x}^{2}-x+1 & = \\\\ (1+1){x}^{2}+(2-1)x+(-1+1) & = \\\\ 2{x}^{2}+x\\end{aligned}\n$$"} :step/id #uuid "5580cfdb-be1b-5915-8303-3905df0f17cf" :step/next {:db/id #edb/ref 17592186484333}} {:db/id #edb/ref 17592186484333 :step/content {:db/id #edb/ref 17592186484273 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bb8c115-71c8-52fc-b134-d94686e4b9e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{v}^{5}-5{v}^{4}-5{v}^{3}" :db/id #edb/ref 17592186483816} {:answer/id #uuid "93e1a070-0be2-5ba6-acb7-6112439ed3d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{v}^{5}-5{v}^{4}-7" :db/id #edb/ref 17592186483872} {:answer/id #uuid "97882e12-c84e-5545-b61c-5cf076b14de5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{v}^{5}-5{v}^{3}-7" :db/id #edb/ref 17592186483878} {:answer/id #uuid "e68ebbcb-b8dd-5936-97df-68e5e5d343b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{v}^{4}-5{v}^{3}-5{v}^{2}-7" :db/id #edb/ref 17592186484022} {:answer/id #uuid "ead2d76a-2ace-5594-bd49-b9029b20e0a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{v}^{5}-5{v}^{4}-5{v}^{3}-7" :db/id #edb/ref 17592186484031}] :answer-field/correct {:db/id #edb/ref 17592186484031} :answer-field/id #uuid "ba315b4a-2ca2-5618-87fb-ec19567b9bbd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186484174}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c4fbb5a3-d0b3-5e9d-9d9e-30b9caacb035" :question/math-academy-id "q-111161" :question/problem "Subtract $5{v}^{4}+6{v}^{3}+9$ from $2{v}^{5}+{v}^{3}+2.$" :question/worked-solution "We put a minus sign between the two polynomials, distribute it over the second polynomial, collect like terms, and then simplify:\n\n$$\n\\begin{aligned}(2{v}^{5}+{v}^{3}+2)-(5{v}^{4}+6{v}^{3}+9) & = \\\\ 2{v}^{5}+{v}^{3}+2-5{v}^{4}-6{v}^{3}-9 & = \\\\ 2{v}^{5}-5{v}^{4}+(1-6){v}^{3}+(2-9) & = \\\\ 2{v}^{5}-5{v}^{4}-5{v}^{3}-7 & \\end{aligned}\n$$"} :step/id #uuid "8b9562fb-ac19-51ea-8cfe-33ad4b3a7610" :step/next {:db/id #edb/ref 17592186484308}}] :activity/title "Adding and Subtracting Polynomials" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186483559}] [{:activity/first-step {:db/id #edb/ref 17592186148518} :activity/id #uuid "3176a165-92bf-54c7-a633-b86e48288ee9" :activity/scope {:db/id #edb/ref 17592186048650 :topic/id #uuid "b227b0cb-b6cd-53a5-8a0d-c105c56b3477" :topic/math-academy-id 2465} :activity/steps [{:db/id #edb/ref 17592186148518 :step/content {:db/id #edb/ref 17592186148685 :tutorial/content "A scientist models the number of bacteria in a Petri dish using the function\n\n$$\ny(t) = 1\\,500 \\cdot 3^t\n$$\n\nHere, $y(t)$ gives the number of bacteria in the dish, and $t$ gives the number of days since the start of an experiment.\n\nWithout being given any more information, what can we deduce about the number of bacteria?\n\nThe first thing to notice is that the function above is an exponential growth function:\n\n$$\ny(t) = a \\cdot b^t\n$$\n\nComparing the function that the scientist is using with the general expression above, we can deduce the following:\n\n- $a=1\\,500$ represents the initial value. This tells us the number of bacteria at the start of the experiment.\n- $b = 3$ is the growth factor. This tells us that the number of bacteria increases by a factor of $3$ every day.\n- $t =$ is the time since the start of the observations, in days.\n\nIn this lesson, we'll get practice at interpreting the various parts of an exponential growth expression or function. The trick is to compare a given expression with\n\n$$\ny(t) = a\\cdot b^t\n$$" :tutorial/id #uuid "8371d43f-8a30-5681-87ef-fdaf05292068" :tutorial/math-academy-id 1938 :tutorial/title "Introduction"} :step/id #uuid "967e18a0-db67-52b9-a220-f5574fed735f" :step/math-academy-id 6881 :step/next {:db/id #edb/ref 17592186148520}} {:db/id #edb/ref 17592186148519 :step/content {:db/id #edb/ref 17592186147563 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147200 :question/id #uuid "1bec8657-1367-54e6-a6e3-942d1dcbe76a" :question/math-academy-id "e-1990"} :knowledge-point/id #uuid "373d4839-72d8-57df-bc72-c3312629e29e" :knowledge-point/questions [{:db/id #edb/ref 17592186147816} {:db/id #edb/ref 17592186147817} {:db/id #edb/ref 17592186459209} {:db/id #edb/ref 17592186480704} {:db/id #edb/ref 17592186487303}] :knowledge-point/title "Interpreting the Output of an Exponential Function"} :step/id #uuid "b015487b-7797-5d8c-8f27-79859901fce3" :step/math-academy-id 6883 :step/next {:db/id #edb/ref 17592186148531}} {:db/id #edb/ref 17592186148520 :step/content {:db/id #edb/ref 17592186147564 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147201 :question/id #uuid "af8404c1-6ca6-5d05-89c9-80de4c0e0fda" :question/math-academy-id "e-1991"} :knowledge-point/id #uuid "630c2d01-a650-582e-95ec-0156b1afa26d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048302}] :knowledge-point/questions [{:db/id #edb/ref 17592186147806} {:db/id #edb/ref 17592186147807}] :knowledge-point/title "Interpreting an Exponential Growth Expression"} :step/id #uuid "179e36f6-9acf-5f57-8fbd-951081caee77" :step/math-academy-id 6884 :step/next {:db/id #edb/ref 17592186148521}} {:db/id #edb/ref 17592186148521 :step/content {:db/id #edb/ref 17592186147565 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147202 :question/id #uuid "d3ba93df-8786-58c5-84cf-6427d5642459" :question/math-academy-id "e-1992"} :knowledge-point/id #uuid "8595b94a-f888-5cfb-b210-61970e15824c" :knowledge-point/questions [{:db/id #edb/ref 17592186147808} {:db/id #edb/ref 17592186147809}] :knowledge-point/title "Interpreting the Exponential Part of an Expression"} :step/id #uuid "e7eadd18-d952-5c8a-b3d9-ba0467187ca6" :step/math-academy-id 6885 :step/next {:db/id #edb/ref 17592186148519}} {:db/id #edb/ref 17592186148531 :step/content {:db/id #edb/ref 17592186147572 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147209 :question/id #uuid "768a334f-5b8f-5ff3-bf08-1230fe3674b9" :question/math-academy-id "e-2074"} :knowledge-point/id #uuid "934bce73-93c8-55ec-af95-13709d2887c0" :knowledge-point/questions [{:db/id #edb/ref 17592186148109} {:db/id #edb/ref 17592186148110}] :knowledge-point/title "Interpreting the Growth Rate In an Exponential Expression"} :step/id #uuid "d6a2e9ff-cef4-5f1e-a5c7-31c47383e32f" :step/math-academy-id 7126}] :activity/title "Interpreting Exponential Growth" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186147665}] [{:activity/first-step {:db/id #edb/ref 17592186065236} :activity/id #uuid "ee2f5838-c8a6-5332-932d-ba9cbf1432c8" :activity/scope {:db/id #edb/ref 17592186048928 :topic/id #uuid "ccd0b2ba-3714-5783-a6c4-70021ded19c3" :topic/math-academy-id 370} :activity/steps [{:db/id #edb/ref 17592186065236 :step/content {:db/id #edb/ref 17592186065342 :tutorial/content "Let's remind ourselves of the difference of squares formula:\n\n$$\na^2-b^2 = (a+b)(a-b)\n$$\n\nWe can use this formula to factor the difference of two squared monomials.\n\nFor example, suppose that we want to factor the expression\n\n$$\nx^2 - 4\n$$\n\nThis expression is a difference of squares:\n\n$$\n\\begin{aligned}\nx^{2} - 4 &=  \\\\\n&= x^{2} - 2^{2}\n\\end{aligned}\n$$\n\nSo, we can factor the expression using the difference of squares formula with $a=x$ and $b=2$, as follows:\n\n$$\n\\begin{aligned}\nx^{2} - 4 &=  \\\\\nx^{2} - 2^{2} &=  \\\\\n&= (x + 2)(x - 2)\n\\end{aligned}\n$$" :tutorial/id #uuid "3f50b677-50fc-5584-82de-7ad393d19d72" :tutorial/math-academy-id 1599 :tutorial/title "Introduction"} :step/id #uuid "7189e486-f5a6-5ce7-9803-33bcfde7853b" :step/math-academy-id 4247 :step/next {:db/id #edb/ref 17592186065237}} {:db/id #edb/ref 17592186065237 :step/content {:db/id #edb/ref 17592186064328 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063963 :question/id #uuid "f1636f93-d678-581d-85a7-0ff93023fed9" :question/math-academy-id "e-1336"} :knowledge-point/id #uuid "20900ac7-ad4e-5895-8d95-d66b0e5f7360" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049943}] :knowledge-point/questions [{:db/id #edb/ref 17592186064681} {:db/id #edb/ref 17592186064691} {:db/id #edb/ref 17592186459295} {:db/id #edb/ref 17592186480664} {:db/id #edb/ref 17592186485546} {:db/id #edb/ref 17592186487343}] :knowledge-point/title "Factoring a Difference of Squares"} :step/id #uuid "2eef60d7-4f61-5c7d-9567-f51ed8b11f15" :step/math-academy-id 4251 :step/next {:db/id #edb/ref 17592186065238}} {:db/id #edb/ref 17592186065238 :step/content {:db/id #edb/ref 17592186064329 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063964 :question/id #uuid "ad7944d4-426e-56df-85da-8771d50f7122" :question/math-academy-id "e-1337"} :knowledge-point/id #uuid "7f0b9133-daf8-5f04-8fa1-c8c3210c4487" :knowledge-point/questions [{:db/id #edb/ref 17592186064686} {:db/id #edb/ref 17592186064693}] :knowledge-point/title "Factoring a Difference of Squares with Leading Coefficients"} :step/id #uuid "4a5bc7eb-2f38-57fd-aa79-d756ce9b911a" :step/math-academy-id 4253 :step/next {:db/id #edb/ref 17592186065244}} {:db/id #edb/ref 17592186065244 :step/content {:db/id #edb/ref 17592186064333 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064005 :question/id #uuid "d8b425b2-eb7b-5cef-b85d-56a67a421d6b" :question/math-academy-id "e-1594"} :knowledge-point/id #uuid "a0704d84-0901-5f01-9535-d7254ca11e57" :knowledge-point/questions [{:db/id #edb/ref 17592186064696} {:db/id #edb/ref 17592186064697}] :knowledge-point/title "Factoring a Difference of Squares Whose Terms Have a Common Factor"} :step/id #uuid "7340bbad-5958-55e7-b40d-7c0a123bd84b" :step/math-academy-id 5061 :step/next {:db/id #edb/ref 17592186065254}} {:db/id #edb/ref 17592186065254 :step/content {:db/id #edb/ref 17592186064339 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064006 :question/id #uuid "c4a15443-e2a4-5bda-ab14-8fb427ec6ca4" :question/math-academy-id "e-1784"} :knowledge-point/id #uuid "8aa1c2ce-6229-5af9-b9b3-870a7e661143" :knowledge-point/questions [{:db/id #edb/ref 17592186064692} {:db/id #edb/ref 17592186064694}] :knowledge-point/title "Factoring a Difference of Squares Containing More Than One Variable"} :step/id #uuid "fb8aebaa-3368-514b-bf57-1953890130b9" :step/math-academy-id 6061}] :activity/title "Factoring Differences of Squares" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064456}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186485603} :activity/id #uuid "85c2e892-b9bc-5813-82ef-08b9292dfe81" :activity/scope {:db/id #edb/ref 17592186048928 :topic/id #uuid "ccd0b2ba-3714-5783-a6c4-70021ded19c3" :topic/math-academy-id 370} :activity/steps [{:db/id #edb/ref 17592186485603 :step/content {:db/id #edb/ref 17592186064686 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24bb8047-0ff3-5b85-aee9-2e6ac88d6e1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2a-3)(2a-3)" :db/id #edb/ref 17592186484885} {:answer/id #uuid "28b71172-7a45-5d09-98d1-64ccf6b8bfda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4a-9)(4a-9)" :db/id #edb/ref 17592186484892} {:answer/id #uuid "51172389-9c15-5caa-bf7e-b95637b65d2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4a-9)(4a+9)" :db/id #edb/ref 17592186484992} {:answer/id #uuid "73e7769f-fc92-5de8-8c10-550b71e31703" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2a-3)(2a+3)" :db/id #edb/ref 17592186485066} {:answer/id #uuid "9035e54c-8039-5816-9bcf-cf8e910bf09e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4a+9)(4a+9)" :db/id #edb/ref 17592186485131}] :answer-field/correct {:db/id #edb/ref 17592186484992} :answer-field/id #uuid "ed8d0e1b-a803-5935-b215-5114cd1136b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186062173}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0f566ff8-5109-5c5a-864e-7810af0e53ff" :question/math-academy-id "q-2761" :question/problem "Factor the expression $16{a}^{2}-81.$" :question/worked-solution "First, we write the expression as a difference of squares:\n\n$$\n\\begin{aligned}16{a}^{2}-81 & =(4a)^{2}-{9}^{2}\\end{aligned}\n$$\n\nThen, we factor the expression using the difference of squares formula:\n\n$$\n\\begin{aligned}(4a)^{2}-{9}^{2} & =(4a+9)(4a-9)\\end{aligned}\n$$"} :step/id #uuid "13e0558d-c68a-56fe-97cc-a967ca46bd21" :step/next {:db/id #edb/ref 17592186485625}} {:db/id #edb/ref 17592186485607 :step/content {:db/id #edb/ref 17592186485546 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "206acbc9-87db-578e-b3b2-16b30eb642bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9-x)(9+x)" :db/id #edb/ref 17592186484877} {:answer/id #uuid "39335b45-13f8-58f6-bd9b-9a97b1c75cc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9-x)^{2}" :db/id #edb/ref 17592186484937} {:answer/id #uuid "64dfcde6-8a80-5dd4-b6fd-951b6b011f44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9+x)^{2}" :db/id #edb/ref 17592186485036} {:answer/id #uuid "6faf371b-64f9-55f0-8fd0-2ade74e5df26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x-9)(x+9)" :db/id #edb/ref 17592186485056} {:answer/id #uuid "8e7eccde-081c-5f5d-be03-c306f58839d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(18-x)(18+x)" :db/id #edb/ref 17592186485125}] :answer-field/correct {:db/id #edb/ref 17592186484877} :answer-field/id #uuid "8cab9527-ddd1-529a-ae51-224da9fcc4cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186485423}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7a010f5a-cc94-5c4d-81d2-4c21165ae9ab" :question/math-academy-id "q-44102" :question/problem "$81-{x}^{2}=$" :question/worked-solution "First, we write the expression as a difference of squares:\n\n$$\n81-{x}^{2}={9}^{2}-{x}^{2}\n$$\n\nThen, we factor the expression using the difference of squares formula:\n\n$$\n{9}^{2}-{x}^{2}=(9-x)(9+x)\n$$"} :step/id #uuid "2738148b-cedf-57d8-ae04-d09d72e66898"} {:db/id #edb/ref 17592186485625 :step/content {:db/id #edb/ref 17592186064692 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58d24321-d687-5666-b444-c67333ddf888" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2e-4f)(2e+4f)" :db/id #edb/ref 17592186485017} {:answer/id #uuid "883f814c-6c18-5941-967b-2ebea351df17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2e-4f)(2e-4f)" :db/id #edb/ref 17592186485113} {:answer/id #uuid "a2d7f83e-938d-58ce-b03e-2aa0fbe0f394" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(e-2f)(e+2f)" :db/id #edb/ref 17592186485171} {:answer/id #uuid "b13e591a-bf5d-5ccb-bebd-477bcfb2fa24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2e+4f)(2e+4f)" :db/id #edb/ref 17592186485202} {:answer/id #uuid "fdc225a0-8ce8-5951-977f-0f5267f0a478" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(e-2f)(e-2f)" :db/id #edb/ref 17592186485360}] :answer-field/correct {:db/id #edb/ref 17592186485017} :answer-field/id #uuid "2bdfff3f-3f1d-5467-b903-2b86371c55b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186062209}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0ca5943c-81c0-5244-b701-34175b2232ae" :question/math-academy-id "q-2833" :question/problem "Express $4{e}^{2}-16{f}^{2}$ as a product of two binomials." :question/worked-solution "We factor the expression using the difference of squares formula:\n\n$$\n\\begin{aligned}4{e}^{2}-16{f}^{2} & = \\\\ (2e)^{2}-(4f)^{2} & = \\\\ (2e-4f)(2e+4f) & \\end{aligned}\n$$"} :step/id #uuid "8a3fd681-fb58-5e69-96b1-2127582ffe4f" :step/next {:db/id #edb/ref 17592186485607}}] :activity/title "Factoring Differences of Squares" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186484810}] [{:activity/first-step {:db/id #edb/ref 17592186055608} :activity/id #uuid "581ada9e-b8f9-5513-9a35-8ae3af36139e" :activity/scope {:db/id #edb/ref 17592186049074 :topic/id #uuid "d85c70bd-27ec-54bb-a459-275d176f6b8b" :topic/math-academy-id 89} :activity/steps [{:db/id #edb/ref 17592186055608 :step/content {:db/id #edb/ref 17592186056069 :tutorial/content "Let's think about how to factor the following trinomial:\n\n$$\nx^2 + 7x + 12\n$$\n\nThis trinomial is neither a perfect square nor a difference of squares. In such cases, the factoring process requires a little trial and error.\n\nWe can factor this trinomial in four steps:\n\n- **Step 1:** Find the factor pairs of the constant term $(12)$:The factor pairs of $12$ are\n$(1, 12), (2, 6), (3, 4)$.\n- **Step 2:** Determine which of these factor pairs add up to the coefficient of the linear term $(7)$:\n$\\begin{bmatrix}1 + 12|= 13 & \\cdot \\\\ 2 + 6|= 8 & \\cdot \\\\ 3 + 4|= 7 & ✓\\end{bmatrix}$\n- **Step 3:** Using the factor pair identified in the previous step, write the linear term as $7x=3x+4x$:\n$x^{2} + 7x + 12|=; x^{2} + 3x + 4x_(⏟)_(7x) + 12$\n- **Step 4:** Factor the first two terms and the last two terms separately and then factor the expression completely:\n$x^{2} + 3x + 4x + 12|=; (x^{2} + 3x) + (4x + 12)|=; x(x + 3) + 4(x + 3)|=; (x + 4)(x + 3)$\n\nAnd we're done!\n\nBefore we continue, note the following:\n\n- The process carried out in step 4 is sometimes called **factoring by grouping.** This is because we group two sets of terms and factor them individually before factoring the entire expression.\n- We can check that our answer is correct by multiplying out the factors:\n$(x + 4)(x + 3)|= x(x + 3) + 4(x + 3); = x^{2} + 3x + 4x + 12; = x^{2} + 7x + 12✓$" :tutorial/id #uuid "90a8aa34-4549-57c2-bdc2-24cc962cd306" :tutorial/math-academy-id 8891 :tutorial/title "Introduction"} :step/id #uuid "add682be-a6dd-51b0-a261-ba8a3f84b958" :step/math-academy-id 178072 :step/next {:db/id #edb/ref 17592186055609}} {:db/id #edb/ref 17592186055609 :step/content {:db/id #edb/ref 17592186054658 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054476 :question/id #uuid "1e0116a2-6f90-5b57-97c1-6a64b45c9cef" :question/math-academy-id "e-14343"} :knowledge-point/id #uuid "3c9ba00d-9171-5732-8539-2e2943cce58e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048351} {:db/id #edb/ref 17592186051017}] :knowledge-point/questions [{:db/id #edb/ref 17592186055108} {:db/id #edb/ref 17592186055495} {:db/id #edb/ref 17592186055497} {:db/id #edb/ref 17592186233563} {:db/id #edb/ref 17592186233570} {:db/id #edb/ref 17592186233577}] :knowledge-point/title "Factoring Trinomials With Positive Coefficients"} :step/id #uuid "072ef290-5a3e-575d-a0fd-7d8084343f23" :step/math-academy-id 178073 :step/next {:db/id #edb/ref 17592186055610}} {:db/id #edb/ref 17592186055610 :step/content {:db/id #edb/ref 17592186056070 :tutorial/content "Let's now consider the following trinomial:\n\n$$\nx^2 - 2x - 8\n$$\n\nNotice that the constant term $(-8)$ is *negative*. So, when writing down our factor pairs, one number will always be positive, and the other will always be negative.\n\nSo, first, we write down all factor pairs of $-8{:}$\n\n$$\n(1,-8), (-1, 8), (2,-4), (-2, 4)\n$$\n\nNow, we find which factor pair adds up to the coefficient of the linear term $(-2)$:\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}1 + (-8) &= -7 & \\cdot \\\\ (-1) + 8|= 7 & \\cdot \\\\ 2 + (-4)|=-2 & ✓ \\\\ (-2) + 4|= 2 & \\cdot\\end{bmatrix}\n\\end{aligned}\n$$\n\nUsing the factor pair identified above, write the linear term as\n\n$$\n-2x = 2x-4x\n$$\n\n$$\n\\begin{aligned}\nx^{2} - 2x - 8 &=  \\\\\n&= x^{2} + 2x - 4x - 8\n\\end{aligned}\n$$\n\nFinally, we factor the first two terms and the last two terms separately, and then factor the expression completely:\n\n$$\n\\begin{aligned}\nx^{2} + 2x - 4x - 8 &=  \\\\\n(x^{2} + 2x) + (-4x - 8) &=  \\\\\nx(x + 2) - 4(x + 2) &=  \\\\\n&= (x - 4)(x + 2)\n\\end{aligned}\n$$\n\nLet's see another example." :tutorial/id #uuid "3b5a5752-232b-5714-b74a-1e50c4210b83" :tutorial/math-academy-id 8894 :tutorial/title "Trinomials With Negative Constants"} :step/id #uuid "232a2780-b6bf-56f2-b607-6b8d27ae3f25" :step/math-academy-id 178077 :step/next {:db/id #edb/ref 17592186055611}} {:db/id #edb/ref 17592186055611 :step/content {:db/id #edb/ref 17592186054659 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054478 :question/id #uuid "41c3e610-0259-59db-9494-3af6f47c7360" :question/math-academy-id "e-14350"} :knowledge-point/id #uuid "ac258511-5028-5fc8-9843-99309b36a38e" :knowledge-point/questions [{:db/id #edb/ref 17592186055130} {:db/id #edb/ref 17592186055229} {:db/id #edb/ref 17592186055231} {:db/id #edb/ref 17592186459240} {:db/id #edb/ref 17592186480700} {:db/id #edb/ref 17592186487383}] :knowledge-point/title "Factoring Trinomials With Negative Constants"} :step/id #uuid "47e26748-840d-518f-8679-595bc9b0406d" :step/math-academy-id 178078 :step/next {:db/id #edb/ref 17592186055612}} {:db/id #edb/ref 17592186055612 :step/content {:db/id #edb/ref 17592186056076 :tutorial/content "Remember that to factor a quadratic expression, we must find a factor pair of the constant term that adds to the coefficient of the linear term.\n\nWith that in mind, let's factor the following trinomial:\n\n$$\nx^2 - 7x+12\n$$\n\nNotice that,\n\n- the constant term $(12)$ is *positive*, while\n- the coefficient of the linear term $(-7)$ is *negative*.\n\nSince the constant is *positive* and the coefficient of the linear term is *negative*, we must first consider the *negative* factor pairs of the constant term $(12)$. These are as follows:\n\n$$\n(-1,-12),\\qquad (-2,-6),\\qquad (-3,-4)\n$$\n\nFor each pair, their *product* is positive, and their *sum* is negative, which is what we want.\n\nNow, we find which factor pair adds up to the coefficient of the linear term $(-7)$:\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}(-1) + (-12) &= -13 & \\cdot \\\\ (-2) + (-6)|=-8 & \\cdot \\\\ (-3) + (-4)|=-7 & ✓\\end{bmatrix}\n\\end{aligned}\n$$\n\nUsing the factor pair identified in the previous step, write the linear term as\n\n$$\n-7x = -3x - 4x\n$$\n\n$$\n\\begin{aligned}\nx^{2} - 7x + 12 &=  \\\\\n&= x^{2} - 3x - 4x + 12\n\\end{aligned}\n$$\n\nNext, we factor the first two terms and the last two terms separately:\n\n$$\n\\begin{aligned}\nx^{2} - 3x - 4x + 12 &=  \\\\\n(x^{2} - 3x) + (-4x + 12) &=  \\\\\n&= x(x - 3) + 4(-x + 3)\n\\end{aligned}\n$$\n\nNow, to get a *common* factor in both terms, we take an additional factor of $-1$ from the second term:\n\n$$\nx(x - 3) - 4(x - 3)\n$$\n\nNow that we have a common factor of $(x-3)$, we factor the expression fully in the usual way:\n\n$$\n\\begin{aligned}\nx(x - 3) - 4(x - 3) &=  \\\\\n&= (x - 3)(x - 4)\n\\end{aligned}\n$$" :tutorial/id #uuid "25f481d5-38d8-5f35-95fc-dd74f97d0394" :tutorial/math-academy-id 9504 :tutorial/title "Trinomials With Negative Linear Coefficients and Positive Constants"} :step/id #uuid "47589875-8a7f-5cea-a2cf-0da701bb35ac" :step/math-academy-id 178082 :step/next {:db/id #edb/ref 17592186055613}} {:db/id #edb/ref 17592186055613 :step/content {:db/id #edb/ref 17592186054660 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054477 :question/id #uuid "f51ebe90-e58a-5712-84b8-4367ed18d58e" :question/math-academy-id "e-14346"} :knowledge-point/id #uuid "65a95770-9419-5a8f-b264-58cca3e3c0db" :knowledge-point/questions [{:db/id #edb/ref 17592186055109} {:db/id #edb/ref 17592186055131} {:db/id #edb/ref 17592186055496}] :knowledge-point/title "Factoring Trinomials With Negative Linear Coefficients and Positive Constants"} :step/id #uuid "87945626-63e1-5990-b1f8-6d13138cf85c" :step/math-academy-id 178083}] :activity/title "Factoring Trinomials" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054931}] [{:activity/first-step {:db/id #edb/ref 17592186069543} :activity/id #uuid "bf2edb5d-ba82-59e5-8293-ed68021af1ea" :activity/scope {:db/id #edb/ref 17592186049224 :topic/id #uuid "e4d4205c-47d1-5b87-81bd-c01b64870d2b" :topic/math-academy-id 433} :activity/steps [{:db/id #edb/ref 17592186069543 :step/content {:db/id #edb/ref 17592186069955 :tutorial/content "The **Pythagorean theorem**, also known as Pythagoras' theorem, is an important theorem related to right-angled triangles. Let's consider the right triangle depicted below.\n\n![](images/53/5351dc4269f0b0d04a8c94aa939cc32b333471752f009e5775c829896e63afdd.png)\n\nThe theorem can be written as\n\n$$\nc^{2} = a^{2} + b^{2}\n$$\n\nwhere\n\n- $\\color{red}c$ is the length of the longest side, which is called the **hypotenuse**, and\n- $\\color{blue}a$ and $\\color{blue}b$ are the lengths of the two other sides, which are called the **legs**." :tutorial/id #uuid "3906cd78-408a-5d9b-80d1-8e5892cb9cb1" :tutorial/math-academy-id 2378 :tutorial/title "Introduction"} :step/id #uuid "d159d6b3-8d4c-5cb7-b994-7c62f80c0558" :step/math-academy-id 10409 :step/next {:db/id #edb/ref 17592186069544}} {:db/id #edb/ref 17592186069544 :step/content {:db/id #edb/ref 17592186068678 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068539 :question/id #uuid "856c3429-0e56-5123-b2bc-76e3f252b404" :question/math-academy-id "e-3072"} :knowledge-point/id #uuid "b6db510b-5976-5c90-8e02-b9f61ff3327b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048187} {:db/id #edb/ref 17592186048868}] :knowledge-point/questions [{:db/id #edb/ref 17592186069295} {:db/id #edb/ref 17592186069296}] :knowledge-point/title "Finding the Length of the Hypotenuse of a Given Right Triangle"} :step/id #uuid "250f28c9-e9bf-5949-8505-fc35334043dd" :step/math-academy-id 10410 :step/next {:db/id #edb/ref 17592186069545}} {:db/id #edb/ref 17592186069545 :step/content {:db/id #edb/ref 17592186068679 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068540 :question/id #uuid "9c6ba1f6-f462-5e47-9731-a906732a46cb" :question/math-academy-id "e-3073"} :knowledge-point/id #uuid "42cc9880-912e-5dce-9b93-e6af88a411c4" :knowledge-point/questions [{:db/id #edb/ref 17592186069428} {:db/id #edb/ref 17592186069429} {:db/id #edb/ref 17592186459302} {:db/id #edb/ref 17592186480701} {:db/id #edb/ref 17592186487374}] :knowledge-point/title "Finding the Length of the Hypotenuse Given the Length of the Legs of a Right Triangle"} :step/id #uuid "134b7f42-bc95-57d8-908c-8372da83cad4" :step/math-academy-id 10411 :step/next {:db/id #edb/ref 17592186069546}} {:db/id #edb/ref 17592186069546 :step/content {:db/id #edb/ref 17592186068680 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068541 :question/id #uuid "83f7c86a-a646-5f19-bd80-2df7d218a8ea" :question/math-academy-id "e-3074"} :knowledge-point/id #uuid "91a6a152-8dd3-5439-9d49-096c5284fcd4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048274}] :knowledge-point/questions [{:db/id #edb/ref 17592186069297} {:db/id #edb/ref 17592186069300}] :knowledge-point/title "Determining the Length of a Leg Given a Right Triangle"} :step/id #uuid "f2534b51-1cec-58f8-8ea0-10c382e1a685" :step/math-academy-id 10412}] :activity/title "The Pythagorean Theorem" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068964}] [{:activity/first-step {:db/id #edb/ref 17592186079457} :activity/id #uuid "45c505a4-630e-59ff-9596-9a36627fb33e" :activity/scope {:db/id #edb/ref 17592186050396 :topic/id #uuid "457136ef-67f9-50bb-b078-34de9c6b59a9" :topic/math-academy-id 655} :activity/steps [{:db/id #edb/ref 17592186079457 :step/content {:db/id #edb/ref 17592186079621 :tutorial/content "A **polynomial term** is a term where the variable contains a non-negative integer power. (The non-negative integers consist of the numbers $0$, $1$, $2$, $3$, and so on.)\n\nSome examples of polynomial terms include\n\n$$\nx^2, \\qquad \\dfrac 1 3 x^6,\\qquad x, \\qquad 1\n$$\n\nLet's go through each one:\n\n- $x^{\\color{blue}2}$ is a polynomial term because the power of the variable is ${\\color{blue}2}$, a non-negative integer.\n- $\\dfrac{1}{3} x^{\\color{blue}6}$ is a polynomial term because the power of the variable is ${\\color{blue}6}$, which is also a non-negative integer. The coefficient of $\\dfrac 1 3$ isn't important.\n- $x$ is a polynomial term because it can be thought of as $x^{\\color{blue}1}$. So the power of the variable is ${\\color{blue}1}$, which is a non-negative integer.\n- Finally, $1$ is a polynomial term because it can be expressed as $1\\cdot x^{\\color{blue}0}$. So the power of the variable is ${\\color{blue}0}$, which is a non-negative integer.\n\nOn the other hand, the following expressions are *not* polynomial terms because their powers are not non-negative integers:\n\n$$\n4x^{-2}, \\qquad x^{1/3}, \\qquad {\\sqrt{\\color{black}x}}, \\qquad {\\dfrac{\\color{black}1}{x^3}}\n$$\n\nTo see why, let's go through each one:\n\n- $4x^{\\color{red}-2}$ is not a polynomial term because the power of the variable is ${\\color{red}-2}$, which is negative.\n- $x^{\\color{red}1/3}$ is not a polynomial term because the power of the variable is ${\\color{red}1/3}$, which is not an integer.\n- $\\sqrt x$ is not a polynomial term because it can be written as $x^{\\color{red}1/2}$. So the power of the variable is ${\\color{red}1/2}$, which is not an integer.\n- Finally, $\\dfrac 1 {x^3}$ is not a polynomial term because it can be written as $x^{-\\color{red}3}$. So the power of the variable is ${\\color{red}-3}$, which is negative." :tutorial/id #uuid "a11e9fb3-6fe1-547c-996f-fb83d15a47d0" :tutorial/math-academy-id 1578 :tutorial/title "Introduction"} :step/id #uuid "0500aa37-469a-53bd-a5da-8fbb0fe569cc" :step/math-academy-id 4106 :step/next {:db/id #edb/ref 17592186079458}} {:db/id #edb/ref 17592186079458 :step/content {:db/id #edb/ref 17592186078529 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078153 :question/id #uuid "0690af9e-ae28-50a0-b2fd-0a9c3baaec3e" :question/math-academy-id "e-1280"} :knowledge-point/id #uuid "c12f648d-f276-5123-b6aa-b222ad108825" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049089} {:db/id #edb/ref 17592186050495}] :knowledge-point/questions [{:db/id #edb/ref 17592186079068} {:db/id #edb/ref 17592186079149}] :knowledge-point/title "Identifying Polynomial Terms"} :step/id #uuid "ad32752d-72d3-5211-adbf-f50f0a51075b" :step/math-academy-id 4107 :step/next {:db/id #edb/ref 17592186079459}} {:db/id #edb/ref 17592186079459 :step/content {:db/id #edb/ref 17592186079622 :tutorial/content "A **polynomial** is a sum of polynomial terms, such as\n$x^2 -5x +3, \\qquad x^3 + x^2 - 9x, \\qquad 4x^4 -2x^2, \\qquad 3x^6 - 2x^3+x^2-1$." :tutorial/id #uuid "2b356365-33dd-5603-8027-95f09e3184a7" :tutorial/math-academy-id 1579 :tutorial/title "Polynomials"} :step/id #uuid "a43ff34d-c027-5df2-820c-70b022c83dc9" :step/math-academy-id 4109 :step/next {:db/id #edb/ref 17592186079460}} {:db/id #edb/ref 17592186079460 :step/content {:db/id #edb/ref 17592186078530 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078155 :question/id #uuid "f6c0be28-9441-513e-83c5-866292fd307a" :question/math-academy-id "e-1282"} :knowledge-point/id #uuid "df8ab577-24c5-5ac4-a9de-9ecc7dfb6653" :knowledge-point/questions [{:db/id #edb/ref 17592186078922} {:db/id #edb/ref 17592186079069}] :knowledge-point/title "Identifying Polynomials"} :step/id #uuid "2556eb4e-afab-5ae3-8996-7aa3b8f721fc" :step/math-academy-id 4112 :step/next {:db/id #edb/ref 17592186079461}} {:db/id #edb/ref 17592186079461 :step/content {:db/id #edb/ref 17592186079623 :tutorial/content "To **evaluate** a polynomial at a specific value of $x$, we substitute the value of $x$ into the polynomial and simplify.\n\nFor example, to evaluate the polynomial $2x^2+3$ at $x=5$, we substitute $x=5$ into the expression and simplify:\n\n$$\n\\begin{aligned}\n2x^{2} + 3 &=  \\\\\n2(5)^{2} + 3 &=  \\\\\n2(25) + 3 &=  \\\\\n50 + 3 &=  \\\\\n&= 53\n\\end{aligned}\n$$" :tutorial/id #uuid "d8de8488-40d3-593a-a8a1-9193eb94f8e8" :tutorial/math-academy-id 1580 :tutorial/title "Evaluating Polynomials"} :step/id #uuid "64a56fd4-dcbc-5271-8a10-da5817638249" :step/math-academy-id 4114 :step/next {:db/id #edb/ref 17592186079462}} {:db/id #edb/ref 17592186079462 :step/content {:db/id #edb/ref 17592186078531 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078162 :question/id #uuid "5242547e-f74d-541d-8c3b-def606b70cb1" :question/math-academy-id "e-1283"} :knowledge-point/id #uuid "a0f7a2ec-3d90-5930-bcc0-d51b8111dbe7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048652}] :knowledge-point/questions [{:db/id #edb/ref 17592186078853} {:db/id #edb/ref 17592186079150} {:db/id #edb/ref 17592186459300} {:db/id #edb/ref 17592186480647} {:db/id #edb/ref 17592186487324}] :knowledge-point/title "Evaluating a Polynomial"} :step/id #uuid "f4dd171c-5f47-5387-8772-afefbec23a35" :step/math-academy-id 4115 :step/next {:db/id #edb/ref 17592186079463}} {:db/id #edb/ref 17592186079463 :step/content {:db/id #edb/ref 17592186078532 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078163 :question/id #uuid "7dc04a57-3d13-5482-93c2-db2cee4ca41a" :question/math-academy-id "e-1284"} :knowledge-point/id #uuid "3b2229bd-c425-5e53-b8cf-56f3f9f3f539" :knowledge-point/questions [{:db/id #edb/ref 17592186078927} {:db/id #edb/ref 17592186079151} {:db/id #edb/ref 17592186233558} {:db/id #edb/ref 17592186233565} {:db/id #edb/ref 17592186233572} {:db/id #edb/ref 17592186485499} {:db/id #edb/ref 17592186485579}] :knowledge-point/title "Evaluating a Polynomial Using Function Notation"} :step/id #uuid "666b2e7a-bdbf-55bd-a1ea-25b21b4d56f8" :step/math-academy-id 4117}] :activity/title "Introduction to Polynomials" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078677}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186485641} :activity/id #uuid "c520d89b-b214-53fa-952a-5cdaa5d839b2" :activity/scope {:db/id #edb/ref 17592186050396 :topic/id #uuid "457136ef-67f9-50bb-b078-34de9c6b59a9" :topic/math-academy-id 655} :activity/steps [{:db/id #edb/ref 17592186485634 :step/content {:db/id #edb/ref 17592186485579 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33703d26-72cd-5cc0-aca3-ff27ce58c3a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "28" :db/id #edb/ref 17592186484926} {:answer/id #uuid "4a0251a2-5a6f-5f2e-a8d7-4946c3bfa1a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186484979} {:answer/id #uuid "4a178c66-540d-5353-b5cb-382e367946e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "27" :db/id #edb/ref 17592186484980} {:answer/id #uuid "7976dd35-fda1-58e9-9f8c-a10bdfaee619" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186485080} {:answer/id #uuid "d27f363a-0795-5e28-96ae-acdc39887ec9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30" :db/id #edb/ref 17592186485260}] :answer-field/correct {:db/id #edb/ref 17592186484926} :answer-field/id #uuid "39e37d12-a990-5afb-9a51-3025326ee005" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186485391}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c90c9cf4-1ba5-5ca6-8d2b-ccc36ce67160" :question/math-academy-id "q-52131" :question/problem "Given the polynomial $f(x)=3{x}^{2}+1,$ $f(3)=$" :question/worked-solution "We substitute $x=x$ into the expression for $f(x)$ and simplify: \n\n$$\n\\begin{aligned}f(x) & =3{x}^{2}+1 \\\\ f(3) & =3(3)^{2}+1 \\\\  & =27+1 \\\\  & =28\\end{aligned}\n$$\n\nTherefore, $f(3)=28.$"} :step/id #uuid "c2d7fc25-7c71-5f9a-b230-683a6fe78e3a" :step/next {:db/id #edb/ref 17592186485644}} {:db/id #edb/ref 17592186485641 :step/content {:db/id #edb/ref 17592186078853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d49c7bc-c10c-5365-bdcf-53015828e98b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186075902} {:answer/id #uuid "d4ce4605-76fb-5b21-b5ed-7fb4b116e814" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186075903} {:answer/id #uuid "f885dbbc-c1d7-5f2c-8a5d-4b57aad4d071" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-19" :db/id #edb/ref 17592186075904} {:answer/id #uuid "3bffe3f8-7623-5e82-8b00-0282c3071997" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-16" :db/id #edb/ref 17592186075905} {:answer/id #uuid "551c4823-47ff-5e04-8c66-bc8ba9ac8296" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-13" :db/id #edb/ref 17592186075906}] :answer-field/correct {:db/id #edb/ref 17592186075904} :answer-field/id #uuid "4215e270-50a3-50bb-b7ed-bf7f3eb3d7b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186075901}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cb6fcbdf-91d2-5cfa-a995-0b092c5eba28" :question/math-academy-id "q-30334" :question/problem "Evaluate the polynomial $-2{x}^{3}-3$ at $x=2.$" :question/worked-solution "To evaluate, we substitute $x=2$ into the polynomial and simplify: \n\n$$\n\\begin{aligned}-2{x}^{3}-3 & = \\\\ -2(2)^{3}-3 & = \\\\ -2(8)-3 & = \\\\ -19\\end{aligned}\n$$"} :step/id #uuid "f1b78880-72cd-5e06-98fa-ff71eb1c6e50" :step/next {:db/id #edb/ref 17592186485634}} {:db/id #edb/ref 17592186485644 :step/content {:db/id #edb/ref 17592186485499 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bf881b2-13e8-5a22-ae7e-ec683fc8ab04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186484906} {:answer/id #uuid "51fefe0c-6917-5f99-be00-78bf52de691d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186484997} {:answer/id #uuid "57e8cf6d-8d35-5805-8a29-824f9a26363b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186485015} {:answer/id #uuid "60d844b9-8ae4-59d2-a8d1-c0bdccdc4cff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186485032} {:answer/id #uuid "84297f1f-e6e8-5683-af04-f7b713873948" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186485101}] :answer-field/correct {:db/id #edb/ref 17592186484906} :answer-field/id #uuid "8f6bd22d-0ba9-56fb-9f12-08c0ea8052b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186485426}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "14cc1a32-5526-5826-8d11-3b9752e2a607" :question/math-academy-id "q-74463" :question/problem "Given the polynomial $g(x)={x}^{4}+3{x}^{3}+{x}^{2}-4x,$ $g(1)=$" :question/worked-solution "We substitute $x=1$ into the expression for $g(x)$ and simplify: \n\n$$\n\\begin{aligned}g(x) & ={x}^{4}+3{x}^{3}+{x}^{2}-4x \\\\ g(1) & ={1}^{4}+3\\cdot {1}^{3}+{1}^{2}-4\\cdot 1 \\\\  & =1+3+1-4 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, $g(1)=1.$"} :step/id #uuid "fb3db9c8-817f-5352-8d1f-22e473869755"}] :activity/title "Introduction to Polynomials" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186484811}] [{:activity/first-step {:db/id #edb/ref 17592186111536} :activity/id #uuid "f15731b1-3f94-5cda-9865-241f1ae29ba5" :activity/scope {:db/id #edb/ref 17592186050886 :topic/id #uuid "6e409d61-3310-5c51-abad-da7413b800ab" :topic/math-academy-id 1499} :activity/steps [{:db/id #edb/ref 17592186111536 :step/content {:db/id #edb/ref 17592186111914 :tutorial/content "A biologist is experimenting with bacteria stored in a Petri dish. She observes that the number of bacteria in the dish *triples* every hour. If there were $100$ bacteria initially, can she determine how many bacteria will be present after $3$ hours?\n\nStarting with $100$ bacteria, she knows that this number *triples* after one hour. Remember that tripling means to multiply by a factor of $3$.\n\nTo get the number of bacteria after one hour, we multiply the initial amount by $3$:\n\n$$\n\\color{blue}{100\\cdot 3}\n$$\n\nAfter another hour ($2$ hours in total), the number above triples again. So to get the total number of bacteria after $2$ hours, we multiply the amount above by $3$:\n\n$$\n({\\color{blue}{100\\cdot 3}})\\cdot 3 = {\\color{red}{100 \\cdot 3^2}}\n$$\n\nAnd after another hour ($3$ hours total), the number above triples once again:\n\n$$\n({\\color{red}{100 \\cdot 3^2}})\\cdot 3 = 100 \\cdot 3^3\n$$\n\nIf we evaluate the above expression, we get\n\n$$\n100 \\cdot 3^3 = 100\\cdot 27 = 2\\,700\n$$\n\nSo after $3$ hours, there will be $2\\,700$ bacteria in the Petri dish.\n\nThis is an example of **exponential growth**. The number of bacteria triples over a time interval of $1$ hour, every hour. The total number of bacteria grows very rapidly, as we can see from the chart below.\n\n![](images/bf/bf039743a936cab0ca74708584fc3670202588d15fc63a4257ad1a737047da2d.png)" :tutorial/id #uuid "60dc9833-8054-5a01-9e29-d592d2e4498a" :tutorial/math-academy-id 8841 :tutorial/title "Introduction"} :step/id #uuid "868a0a9f-3d0c-5548-b4c4-a2688c08805c" :step/math-academy-id 193608 :step/next {:db/id #edb/ref 17592186111537}} {:db/id #edb/ref 17592186111537 :step/content {:db/id #edb/ref 17592186110625 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110331 :question/id #uuid "27d792f0-b574-531e-9907-80891a464ece" :question/math-academy-id "e-14250"} :knowledge-point/id #uuid "affac6f0-da94-5545-a49c-e1e306bcd918" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049714}] :knowledge-point/questions [{:db/id #edb/ref 17592186110943} {:db/id #edb/ref 17592186111060} {:db/id #edb/ref 17592186111207}] :knowledge-point/title "Creating an Exponential Growth Expression"} :step/id #uuid "cc23439c-f454-5e68-a5a0-22cdf9bf2e0f" :step/math-academy-id 193609 :step/next {:db/id #edb/ref 17592186111538}} {:db/id #edb/ref 17592186111538 :step/content {:db/id #edb/ref 17592186110626 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110332 :question/id #uuid "139799dc-8baf-5e41-9241-23e2ede77162" :question/math-academy-id "e-14254"} :knowledge-point/id #uuid "dcd3e634-d64c-57dc-9d4c-8f7f67c731ab" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048502} {:db/id #edb/ref 17592186050415} {:db/id #edb/ref 17592186050436} {:db/id #edb/ref 17592186050625}] :knowledge-point/questions [{:db/id #edb/ref 17592186110944} {:db/id #edb/ref 17592186111203} {:db/id #edb/ref 17592186459303} {:db/id #edb/ref 17592186480651} {:db/id #edb/ref 17592186487334}] :knowledge-point/title "Creating an Exponential Growth Expression Using Percentage Growth"} :step/id #uuid "8da3c630-d870-51f5-bf19-afa5e49a3cbb" :step/math-academy-id 193613}] :activity/title "Creating Exponential Growth Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110858}] [{:activity/first-step {:db/id #edb/ref 17592186065228} :activity/id #uuid "28a8e191-2419-5067-b551-a263baa08308" :activity/scope {:db/id #edb/ref 17592186051017 :topic/id #uuid "7a611e07-341d-5ee4-914f-fa436e11a160" :topic/math-academy-id 353} :activity/steps [{:db/id #edb/ref 17592186065228 :step/content {:db/id #edb/ref 17592186065340 :tutorial/content "To factor a polynomial expression like $2a^2+6a$, we follow the three steps below:\n\n1. First, we find the greatest common factor (or $\\textrm{GCF}$) of both terms. In this case,\n$\\textrm{GCF}(2a^2,6a) = 2a$.\n2. Then, we rewrite each term in the original expression as a product with the $\\textrm{GCF}$:\n$2a^{2} + 6a|=; (2a \\cdot a) + (2a \\cdot 3)$\n3. Finally, we write the $\\textrm{GCF}$ outside the parentheses and keep the remaining terms inside:\n$(2a \\cdot a) + (2a \\cdot 3)|=; 2a(a + 3)$\n\nTherefore, the factored form of $2a^2+6a$ is $2a(a+3)$.\n\nWe can check that we factored correctly by multiplying it out:\n\n$$\n\\begin{aligned}\n2a(a + 3) &=  \\\\\n2a \\cdot a + 2a \\cdot 3 &=  \\\\\n&= 2a^{2} + 6a \\mid ✓\n\\end{aligned}\n$$" :tutorial/id #uuid "f84c09f1-b24a-50f1-a8c4-24b8d857bca2" :tutorial/math-academy-id 1595 :tutorial/title "Introduction"} :step/id #uuid "79b200d6-ffc5-573e-9352-08bd5b609ca7" :step/math-academy-id 4216 :step/next {:db/id #edb/ref 17592186065257}} {:db/id #edb/ref 17592186065229 :step/content {:db/id #edb/ref 17592186064322 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063953 :question/id #uuid "e0ffd89f-c43e-578d-a2b0-da1229a4ef0f" :question/math-academy-id "e-1323"} :knowledge-point/id #uuid "12fed420-dbc6-57b4-8b3b-a13d441a51df" :knowledge-point/questions [{:db/id #edb/ref 17592186064684} {:db/id #edb/ref 17592186064720}] :knowledge-point/title "Factoring a Monomial out of a B