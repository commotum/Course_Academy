cb4-a0f7-416d8b9e63fc" #edb/ref 17592186045417] [17592186487233 #edb/ref 1075 #edb/ref 17592186486885 #edb/ref 17592186045417] [17592186487233 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186487233 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186487233 #edb/ref 1078 #edb/ref 17592186486885 #edb/ref 17592186045417] [17592186487233 #edb/ref 1079 #uuid "a418d9f4-5901-559b-bb52-77f13f8ff2aa" #edb/ref 17592186045417] [17592186487235 #edb/ref 1075 #edb/ref 17592186487042 #edb/ref 17592186045417] [17592186487235 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186487235 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186487235 #edb/ref 1078 #edb/ref 17592186487042 #edb/ref 17592186045417] [17592186487235 #edb/ref 1079 #uuid "a4ed4ce8-2f0b-590b-a0e9-c44d682353ac" #edb/ref 17592186045417] [17592186487239 #edb/ref 1075 #edb/ref 17592186486693 #edb/ref 17592186045417] [17592186487239 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186487239 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186487239 #edb/ref 1078 #edb/ref 17592186486693 #edb/ref 17592186045417] [17592186487239 #edb/ref 1079 #uuid "ae84797d-d8ce-5c37-8e3b-a77fc43d526c" #edb/ref 17592186045417] [17592186487256 #edb/ref 1075 #edb/ref 17592186487034 #edb/ref 17592186045417] [17592186487256 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186487256 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186487256 #edb/ref 1078 #edb/ref 17592186487034 #edb/ref 17592186045417] [17592186487256 #edb/ref 1079 #uuid "d3e7f01e-bff3-56f8-870d-85b97052a7da" #edb/ref 17592186045417] [17592186487267 #edb/ref 1075 #edb/ref 17592186486945 #edb/ref 17592186045417] [17592186487267 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186487267 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186487267 #edb/ref 1078 #edb/ref 17592186486945 #edb/ref 17592186045417] [17592186487267 #edb/ref 1079 #uuid "e7cb5d96-36e5-5198-87e5-6213f99e66e0" #edb/ref 17592186045417] [17592186487286 #edb/ref 1088 #edb/ref 17592186048406 #edb/ref 17592186045417] [17592186487286 #edb/ref 1088 #edb/ref 17592186048524 #edb/ref 17592186045417] [17592186487286 #edb/ref 1088 #edb/ref 17592186048650 #edb/ref 17592186045417] [17592186487286 #edb/ref 1088 #edb/ref 17592186048928 #edb/ref 17592186045417] [17592186487286 #edb/ref 1088 #edb/ref 17592186049074 #edb/ref 17592186045417] [17592186487286 #edb/ref 1088 #edb/ref 17592186049224 #edb/ref 17592186045417] [17592186487286 #edb/ref 1088 #edb/ref 17592186050396 #edb/ref 17592186045417] [17592186487286 #edb/ref 1088 #edb/ref 17592186050886 #edb/ref 17592186045417] [17592186487286 #edb/ref 1088 #edb/ref 17592186051017 #edb/ref 17592186045417] [17592186487286 #edb/ref 1089 #edb/ref 17592186487287 #edb/ref 17592186045417] [17592186487286 #edb/ref 1090 #uuid "76e5ce36-199d-57f8-8c5c-34ed5ab99437" #edb/ref 17592186045417] [17592186487287 #edb/ref 1084 #edb/ref 17592186487408 #edb/ref 17592186045417] [17592186487287 #edb/ref 1084 #edb/ref 17592186487410 #edb/ref 17592186045417] [17592186487287 #edb/ref 1084 #edb/ref 17592186487427 #edb/ref 17592186045417] [17592186487287 #edb/ref 1084 #edb/ref 17592186487439 #edb/ref 17592186045417] [17592186487287 #edb/ref 1084 #edb/ref 17592186487446 #edb/ref 17592186045417] [17592186487287 #edb/ref 1084 #edb/ref 17592186487448 #edb/ref 17592186045417] [17592186487287 #edb/ref 1084 #edb/ref 17592186487449 #edb/ref 17592186045417] [17592186487287 #edb/ref 1084 #edb/ref 17592186487450 #edb/ref 17592186045417] [17592186487287 #edb/ref 1084 #edb/ref 17592186487452 #edb/ref 17592186045417] [17592186487287 #edb/ref 1085 "![](images/f8/f82a8a9f2c830772788bd5c49bf39cd7a5ada93bcab1f81fa08f247c6020d33c.png)\n\nPaul owns a rectangular plot of land, as shown above. The area of the plot is $3{x}^{2}+15x$ square yards, and its width is $x+5$ yards, where $x>10$ is a fixed constant." #edb/ref 17592186045417] [17592186487287 #edb/ref 1086 #uuid "51a2d6a6-b60f-50cd-97ea-595fbb919894" #edb/ref 17592186045417] [17592186487287 #edb/ref 1087 #edb/ref 17592186487449 #edb/ref 17592186045417] [17592186487303 #edb/ref 1068 #edb/ref 17592186487235 #edb/ref 17592186045417] [17592186487303 #edb/ref 1069 "q-133799" #edb/ref 17592186045417] [17592186487303 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186487303 #edb/ref 1071 "The value $V(t)$ of Paul's plot of land, in thousands of dollars, can be modeled by the function $V(t)=400\\cdot (1.1)^{t},$ where $t$ is the time in years since he bought the land. What is the growth in the value of the plot over the first two years? Round your answer to the nearest thousand dollars.\n\nPaul's land grew in value by\n{{field-1}}\n thousand dollars over the first two years." #edb/ref 17592186045417] [17592186487303 #edb/ref 1072 #uuid "2064e26a-7656-5c06-9eb5-86690541ec19" #edb/ref 17592186045417] [17592186487303 #edb/ref 1074 "To find the growth in the value over the first two years, we need to find the value after $2$ years and then subtract the initial cost:\n\n$$\nV(2)-V(0)\n$$\n\nIn the previous part, we were given the initial value of the land:\n\n$$\n\\begin{aligned}V(0) & =400\\end{aligned}\n$$\n\nNext, we find $V(2),$ the value of the land after $2$ years:\n\n$$\n\\begin{aligned}V(2) & =400\\cdot (1.1)^{(2)} \\\\  & =400\\cdot (1.21) \\\\  & =484\\end{aligned}\n$$\n\nTherefore, the growth in the first two years is\n\n$$\n\\begin{aligned}V(2)-V(0) & =484-400 \\\\  & =84.\\end{aligned}\n$$\n\nTherefore, the growth in the value of the land over the first two years was $84$ thousand dollars." #edb/ref 17592186045417] [17592186487312 #edb/ref 1068 #edb/ref 17592186487256 #edb/ref 17592186045417] [17592186487312 #edb/ref 1069 "q-133795" #edb/ref 17592186045417] [17592186487312 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186487312 #edb/ref 1071 "What is the degree of the polynomial that represents the area of Karol's plot of land?\n\nDegree $\\,=$\n{{field-1}}" #edb/ref 17592186045417] [17592186487312 #edb/ref 1072 #uuid "309a6ab7-981e-5132-839c-89444347093a" #edb/ref 17592186045417] [17592186487312 #edb/ref 1074 "The polynomial \n\n$$\n{x}^{2}+2x-8\n$$\n\ncan be written as\n\n$$\n{x}^{2}+2{x}^{1}-8{x}^{0}.\n$$\n\nSo, it has the exponents $2,$ $1,$ and $0.$ The degree is the largest of these exponents, which is $2.$" #edb/ref 17592186045417] [17592186487324 #edb/ref 1068 #edb/ref 17592186487233 #edb/ref 17592186045417] [17592186487324 #edb/ref 1069 "q-133796" #edb/ref 17592186045417] [17592186487324 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186487324 #edb/ref 1071 "If $x=20\\,\\text{yd},$ what is the area of Karol's land plot?\n\nArea $\\,=$\n{{field-1}}\n${\\text{yd}}^{2}$" #edb/ref 17592186045417] [17592186487324 #edb/ref 1072 #uuid "4b044a91-329e-59b9-adc9-5aa3764882b6" #edb/ref 17592186045417] [17592186487324 #edb/ref 1074 "To find the area, we have to evaluate the polynomial ${x}^{2}+2x-8$ at $x=20.$\n\nSo, we substitute $x=20$ into the polynomial and simplify: \n\n$$\n\\begin{aligned}{x}^{2}+2x-8 & = \\\\ (20)^{2}+2(20)-8 & = \\\\ 400+40-8 & = \\\\ 432\\end{aligned}\n$$\n\nTherefore, the area is $432\\,{\\text{yd}}^{2}.$" #edb/ref 17592186045417] [17592186487334 #edb/ref 1068 #edb/ref 17592186487267 #edb/ref 17592186045417] [17592186487334 #edb/ref 1069 "q-133798" #edb/ref 17592186045417] [17592186487334 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186487334 #edb/ref 1071 "Paul purchased his land for $400$ thousand dollars. The value of the land increases by $10%$ each year. How much will Paul's plot be worth after $5$ years? Round your answer to the nearest thousand dollars.\n\nAfter $5$ years, the land will be worth approximately \n{{field-1}}\n thousand dollars." #edb/ref 17592186045417] [17592186487334 #edb/ref 1072 #uuid "5c2f07e7-1da9-5f1b-b117-db8d520999a1" #edb/ref 17592186045417] [17592186487334 #edb/ref 1074 "The land initially costs $400$ thousand, which increases at a rate of $10%$ per year.\n\n$10%$ as a decimal is $0.1.$ Therefore, an increase of $10%$ corresponds to multiplication by a factor of\n\n$$\n1+0.1=1.1.\n$$\n\nTherefore, we have:\n\n* After $1$ year, the value will be $400\\cdot (1.1)$ thousand dollars\n\n* After $2$ years, the value will be $400\\cdot (1.1)^{2}$ thousand dollars\n\n* After $3$ years, the value will be $400\\cdot (1.1)^{3}$ thousand dollars\n\n* After $4$ years, the value will be $400\\cdot (1.1)^{4}$ thousand dollars\n\n* After $5$ years, the value will be $400\\cdot (1.1)^{5}$ thousand dollars \n\nEvaluating the expression for the value after $5$ years, we get the following:\n\n$$\n400\\cdot (1.1)^{5}=644.204≈644,\n$$\n\nrounded to the nearest integer.\n\nTherefore, after $5$ years, the land will be worth approximately $644$ thousand dollars." #edb/ref 17592186045417] [17592186487343 #edb/ref 1068 #edb/ref 17592186487181 #edb/ref 17592186045417] [17592186487343 #edb/ref 1069 "q-133792" #edb/ref 17592186045417] [17592186487343 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186487343 #edb/ref 1071 "![](images/e6/e69bcccc2f30199fd64a9479c623c107610760686c744466736b30995cc4654e.png)\n\nMary is Paul's neighbor. She has a plot of land whose area is ${x}^{2}-25$ square yards and whose width is $x+5$ yards, as depicted above. What is the length of Mary's plot in terms of $x?$\n\nMary's plot has a length of\n{{field-1}}\nyards." #edb/ref 17592186045417] [17592186487343 #edb/ref 1072 #uuid "77006e45-cf97-549c-aab3-71cabbd06eba" #edb/ref 17592186045417] [17592186487343 #edb/ref 1074 "To find the length of Mary's plot of land, we need to factor the expression ${x}^{2}-25.$\n\nFirst, we write the expression as a difference of squares:\n\n$$\n{x}^{2}-25={x}^{2}-{5}^{2}\n$$\n\nThen, we factor the expression using the difference of squares formula:\n\n$$\n{x}^{2}-25=(x+5)(x-5)\n$$\n\nAs a result, we conclude that the length of the plot must be $x-5$ yards.\n\n![](images/1d/1d05c236e65fb4011152735b09dd7668bd6a36b119319a95ec1f3064bd13db4a.png)" #edb/ref 17592186045417] [17592186487374 #edb/ref 1068 #edb/ref 17592186487148 #edb/ref 17592186045417] [17592186487374 #edb/ref 1069 "q-133797" #edb/ref 17592186045417] [17592186487374 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186487374 #edb/ref 1071 "![](images/60/60e3ad251f3b7eed158489e287b072ee133955841c812da26f37538a539f9cd7.png)\n\nWhen $x=20\\,\\text{yd},$ the dimensions of Karol's plot of land are $24\\,\\text{yd}$ and $18\\text{yd}.$ A water pipe goes diagonally from one corner to the opposite, as shown above. Find the **exact** length of the pipe.\n\nThe length of the pipe is \n{{field-1}}\nyards." #edb/ref 17592186045417] [17592186487374 #edb/ref 1072 #uuid "bb8e2d93-f5db-5ed4-9595-24f5393bca59" #edb/ref 17592186045417] [17592186487374 #edb/ref 1074 "First, notice that we have a right triangle with legs $a=24\\,\\text{yd}$  and $b=18\\,\\text{yd}.$\n\n![](images/35/35dff3715d9e7e06f7c15a3b80c0171820f71e1998695550a7672377d981ee76.png)\n\nLet $c$ be the length of the hypotenuse. Then, according to the Pythagorean theorem, we obtain\n\n$$\n\\begin{aligned}{c}^{2} & ={a}^{2}+{b}^{2} \\\\ c & =\\sqrt{{a}^{2}+{b}^{2}}.\\end{aligned}\n$$\n\nSubstituting the values for $a$ and $b$ gives\n\n$$\n\\begin{aligned}c & =\\sqrt{{24}^{2}+{18}^{2}} \\\\  & =\\sqrt{576+324} \\\\  & =\\sqrt{900} \\\\  & =30\\,\\text{yd}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186487379 #edb/ref 1068 #edb/ref 17592186487239 #edb/ref 17592186045417] [17592186487379 #edb/ref 1069 "q-133791" #edb/ref 17592186045417] [17592186487379 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186487379 #edb/ref 1071 "Expressed as a polynomial in terms of $x,$ the length of Paul's plot of land is{{field-1}}\nyards." #edb/ref 17592186045417] [17592186487379 #edb/ref 1072 #uuid "c5c07663-c2ba-5968-924a-8ce6b0b341c8" #edb/ref 17592186045417] [17592186487379 #edb/ref 1074 "The width of the plot is $x+5$ yards, and its area is $3{x}^{2}+15x$ square yards. Since the $\\text{area}=\\text{length}\\times \\text{width},$ we factor the expression for the area to find the length.\n\nFirst, we find the $\\text{GCF}$ of the two terms:\n\n$$\n\\text{GCF}(3{x}^{2},15x)=3x\n$$\n\nThen, we rewrite each term in the original expression as a product with the $\\text{GCF}:$\n\n$$\n\\begin{aligned}3{x}^{2}+15x & = \\\\ (3x\\cdot x)+(3x\\cdot 5)\\end{aligned}\n$$\n\nNext, we write the $\\text{GCF}$ outside the parentheses and keep the remaining terms inside:\n\n$$\n\\begin{aligned}(3x\\cdot x)+(3x\\cdot 5) & = \\\\ 3x(x+5)\\end{aligned}\n$$\n\nAs a result, we conclude that the length of the plot must be $3x$ yards.\n\n![](images/13/13d17ee1a2e1157f7cf0afa191f2c4096c7c6dea6086f0b3aafd48af159aeb1a.png)" #edb/ref 17592186045417] [17592186487383 #edb/ref 1068 #edb/ref 17592186487159 #edb/ref 17592186045417] [17592186487383 #edb/ref 1069 "q-133794" #edb/ref 17592186045417] [17592186487383 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186487383 #edb/ref 1071 "![](images/7a/7ad6be914ed14fb22276982edeab75c9726c56e57e32760371db7936b8091468.png)\n\nPaul's neighbor to the south, Karol, has a land plot of area ${x}^{2}+2x-8$ square yards, as shown in the picture. Given that the length of Karol's plot of land is $x+4$ yards, what is the width of the plot in terms of $x?$\n\nKarol's plot width is\n{{field-1}}\nyards." #edb/ref 17592186045417] [17592186487383 #edb/ref 1072 #uuid "cbff1985-d682-5038-ad53-7d9761aafbae" #edb/ref 17592186045417] [17592186487383 #edb/ref 1074 "To find the required width, we need to factor the expression ${x}^{2}+2x-8.$\n\nFirst, we find the factor pairs of the constant term $(-8).$ The constant term is negative, so that means one of the factors is negative, and the other is positive:\n\n$$\n\\begin{aligned}1 & \\times (-8) \\\\ (-1) & \\times 8 \\\\ 2 & \\times (-4) \\\\ (-2) & \\times 4\\end{aligned}\n$$\n\nNow, we find which factor pair adds up to the coefficient of the linear term $3:$\n\n$$\n\\begin{aligned}1+(-8) & =-7 & \\times  \\\\ -1+8 & =7 & \\times  \\\\ 2+(-4) & =-2 & \\times  \\\\ -2+4 & =2 & ✓\\end{aligned}\n$$\n\nUsing the factor pair identified above, write the linear term as $2x=4x-2x:$\n\n$$\n\\begin{aligned}{x}^{2}+2x-8 & ={x}^{2}+4x-2x-8\\end{aligned}\n$$\n\nFinally, we factor the first two terms and the last two terms separately, and then factor the expression completely:\n\n$$\n\\begin{aligned}{x}^{2}+4x-2x-8 & = \\\\ ({x}^{2}+4x)+(-2x-8) & = \\\\ x(x+4)-2(x+4) & = \\\\ (x-2)(x+4)\\end{aligned}\n$$\n\nAs a result, we conclude that the width must be $x-2$ yards. \n\n![](images/b7/b7bff7b60f02cab37aef8f40d7b303627aedcc37995afc4ffbc2fe756110673a.png)" #edb/ref 17592186045417] [17592186487384 #edb/ref 1068 #edb/ref 17592186487157 #edb/ref 17592186045417] [17592186487384 #edb/ref 1069 "q-133793" #edb/ref 17592186045417] [17592186487384 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186487384 #edb/ref 1071 "![](images/c5/c57074e325bd05bdfd076a8f07b50b15c18099fc37bcace725201237d8034a1c.png)\n\nA utility pole is located on the edge of Paul's land, as shown above. The distance from the right edge of Paul's plot to the pole is $2x-4$ yards. Find the distance to the pole from the left edge as a function of $x.$\n\nThe required distance is \n{{field-1}}\nyards." #edb/ref 17592186045417] [17592186487384 #edb/ref 1072 #uuid "cfee4982-2b49-58b3-8a10-a19a8ff05ec4" #edb/ref 17592186045417] [17592186487384 #edb/ref 1074 "In part 1, we found that the length of Paul's plot is $3x$ yards.\n\nTo find the required distance, we need to subtract polynomials $3x$ and $2x-4:$\n\nWe put a minus sign between the two polynomials, distribute it over the second polynomial, collect like terms, and then simplify:\n\n$$\n\\begin{aligned}(3x)-(2x-4) & = \\\\ 3x-2x+4 & = \\\\ (3-2)x+4 & = \\\\ x+4\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186487408 #edb/ref 1058 #edb/ref 17592186487427 #edb/ref 17592186045417] [17592186487408 #edb/ref 1062 #uuid "05319ee0-3f80-50c8-bc7c-953e1146c0d0" #edb/ref 17592186045417] [17592186487408 #edb/ref 1063 #edb/ref 17592186487324 #edb/ref 17592186045417] [17592186487410 #edb/ref 1058 #edb/ref 17592186487408 #edb/ref 17592186045417] [17592186487410 #edb/ref 1062 #uuid "117ee75c-7c36-545e-9458-12a962def7e5" #edb/ref 17592186045417] [17592186487410 #edb/ref 1063 #edb/ref 17592186487312 #edb/ref 17592186045417] [17592186487427 #edb/ref 1058 #edb/ref 17592186487448 #edb/ref 17592186045417] [17592186487427 #edb/ref 1062 #uuid "62dfc50c-c538-518d-ba11-ac9ba2dc3489" #edb/ref 17592186045417] [17592186487427 #edb/ref 1063 #edb/ref 17592186487374 #edb/ref 17592186045417] [17592186487437 #edb/ref 1062 #uuid "ae5abc43-6379-596a-a59d-29306630faff" #edb/ref 17592186045417] [17592186487437 #edb/ref 1063 #edb/ref 17592186487286 #edb/ref 17592186045417] [17592186487439 #edb/ref 1058 #edb/ref 17592186487450 #edb/ref 17592186045417] [17592186487439 #edb/ref 1062 #uuid "c5ba4b12-0c9f-5215-9975-193d618dbe01" #edb/ref 17592186045417] [17592186487439 #edb/ref 1063 #edb/ref 17592186487343 #edb/ref 17592186045417] [17592186487446 #edb/ref 1062 #uuid "dc8fb9b8-33f5-5877-a384-d88c2595d85d" #edb/ref 17592186045417] [17592186487446 #edb/ref 1063 #edb/ref 17592186487303 #edb/ref 17592186045417] [17592186487448 #edb/ref 1058 #edb/ref 17592186487446 #edb/ref 17592186045417] [17592186487448 #edb/ref 1062 #uuid "e141519e-223d-5342-a346-5ddd00872fea" #edb/ref 17592186045417] [17592186487448 #edb/ref 1063 #edb/ref 17592186487334 #edb/ref 17592186045417] [17592186487449 #edb/ref 1058 #edb/ref 17592186487439 #edb/ref 17592186045417] [17592186487449 #edb/ref 1062 #uuid "eb340cf3-9a4b-59bd-b525-3c3b48bd8800" #edb/ref 17592186045417] [17592186487449 #edb/ref 1063 #edb/ref 17592186487379 #edb/ref 17592186045417] [17592186487450 #edb/ref 1058 #edb/ref 17592186487452 #edb/ref 17592186045417] [17592186487450 #edb/ref 1062 #uuid "ef1526ea-3dfa-5b70-b0db-89647a50d659" #edb/ref 17592186045417] [17592186487450 #edb/ref 1063 #edb/ref 17592186487384 #edb/ref 17592186045417] [17592186487452 #edb/ref 1058 #edb/ref 17592186487410 #edb/ref 17592186045417] [17592186487452 #edb/ref 1062 #uuid "f1af217f-8994-58dc-9df8-0632ec3ed68f" #edb/ref 17592186045417] [17592186487452 #edb/ref 1063 #edb/ref 17592186487383 #edb/ref 17592186045417]}
