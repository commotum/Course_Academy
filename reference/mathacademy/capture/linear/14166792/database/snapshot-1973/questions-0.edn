#{[{:db/id #edb/ref 17592186491149 :knowledge-point/_questions [{:db/id #edb/ref 17592186054839 :knowledge-point/id #uuid "f915db41-a929-5ff0-b571-9ab3a1d510e5" :knowledge-point/title "Evaluating Linear Expressions Containing Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "abfc1b8e-9de5-5538-aee2-de9cac0e9509" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186490853}] :answer-field/correct {:answer/id #uuid "abfc1b8e-9de5-5538-aee2-de9cac0e9509" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186490853} :answer-field/id #uuid "ae77bf12-3e74-5cbf-b87a-cc3a8d30f6a1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186491071}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5b99e56c-ad94-54d0-842e-fa2fe1eccf19" :question/math-academy-id "q-179537" :question/problem "If $v=8,$ then $2-\\frac{v}{5}=${{field-1}}." :question/worked-solution "Replacing $v$ with $8$ in the expression, we get\n\n$$\n\\begin{aligned}2-\\frac{v}{5} & = \\\\ 2-\\frac{8}{5} & = \\\\ \\frac{2\\cdot 5-8}{5} & = \\\\ \\frac{2}{5} & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186491166 :knowledge-point/_questions [{:db/id #edb/ref 17592186054840 :knowledge-point/id #uuid "e5dcee75-1c40-5885-81e2-960bee2dd3a8" :knowledge-point/title "Evaluating Expressions of a Single Variable with Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3a3f7b6-e8b6-5e89-888c-8054c2bbbae3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186490846}] :answer-field/correct {:answer/id #uuid "a3a3f7b6-e8b6-5e89-888c-8054c2bbbae3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186490846} :answer-field/id #uuid "73f6cac1-03ce-521d-a9ba-b9024d58d2b5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186491047}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "79ba2bde-8132-53b1-8d2a-2c8fb0089fe0" :question/math-academy-id "q-180248" :question/problem "If $h=5,$ then $3(h-8)+11=${{field-1}}." :question/worked-solution "We replace $h$ with $5$ in the expression and evaluate the parentheses first:\n\n$$\n\\begin{aligned}3(h-8)+11 & = \\\\ 3(5-8)+11 & = \\\\ 3(-3)+11 & = \\\\ -9+11 & = \\\\ 2 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186055289 :knowledge-point/_questions [{:db/id #edb/ref 17592186054839 :knowledge-point/id #uuid "f915db41-a929-5ff0-b571-9ab3a1d510e5" :knowledge-point/title "Evaluating Linear Expressions Containing Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f91b176-7a76-531d-bf78-d71efd4387f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186052972} {:answer/id #uuid "b92e5659-9a39-53ea-9213-d39f1ed36e56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186052973} {:answer/id #uuid "f3b6aae1-a2f8-5c78-ab69-05c5e8cd91a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186052974} {:answer/id #uuid "11d98231-154d-5aa8-a2a4-915b69036b58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186052975} {:answer/id #uuid "12a6ca44-5064-5ec7-bec7-d128f6981b6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186052976}] :answer-field/correct {:answer/id #uuid "12a6ca44-5064-5ec7-bec7-d128f6981b6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186052976} :answer-field/id #uuid "176da1dd-e17f-5c3d-aaf3-4fabcd678809" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186052971}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "74548fba-87bb-5bd8-bd8a-1a1dbe7d1130" :question/math-academy-id "q-44272" :question/problem "Evaluate $3-\\frac{m}{3}$ for $m=6.$" :question/worked-solution "Replacing $m$ with $6$ in the expression, we get\n\n$$\n\\begin{aligned}3-\\frac{m}{3} & = \\\\ 3-\\frac{6}{3} & = \\\\ 3-2 & = \\\\ 1.\\end{aligned}\n$$"}]}
