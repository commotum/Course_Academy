#{[{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186106627} :activity/id #uuid "5207c8f6-7d65-5c9f-8bbb-af66fdcc9b1d" :activity/scope {:db/id #edb/ref 17592186049027 :topic/id #uuid "d4a5e636-5453-5120-957b-34a9e32197ae" :topic/math-academy-id 1403} :activity/steps [{:db/id #edb/ref 17592186106627 :step/content {:db/id #edb/ref 17592186107043 :tutorial/content "Remember that longer sides in a triangle are opposite to larger angles, and vice versa. But what if two (or more) sides have the same length?\n\nAs you might have guessed, if two sides have the same length, then the opposite angles have the same measure. And vice-versa: if two angles have the same measure, then the opposite sides have the same length.\n\nSo, we obtain the following important properties of isosceles and equilateral triangles:\n\n- A triangle is **equilateral** if and only if all of its angles are of $60^\\circ.$\n\n![](images/ad/ad56532db83ae54eeabf04d5a182a850bed14d9d0a65518b8048c3c0c112c371.png)\n\n- A triangle is **isosceles** if and only if it has two congruent angles.\n\n![](images/2b/2b5d6779527eae10e108ffcdc80745f63f3f38e41474673990bf74c83d2e6a64.png)\n\n**Note:** The statement above encompasses two theorems:\n\n- The **isosceles triangle theorem**:\n\n*If a triangle is isosceles, then the base angles are congruent.*\n\n- The **converse isosceles triangle theorem**: \n\n*If two angles in a triangle have the same measure, then the triangle must be isosceles.*" :tutorial/id #uuid "87d68609-ccd1-5ebd-b129-2c6993e05b75" :tutorial/math-academy-id 2227 :tutorial/title "Introduction"} :step/id #uuid "5440fe87-c485-5fa7-ab27-be4de4746fa1" :step/math-academy-id 164419 :step/next {:db/id #edb/ref 17592186106628}} {:db/id #edb/ref 17592186106628 :step/content {:db/id #edb/ref 17592186105738 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105525 :question/id #uuid "df6c46c7-a65c-578c-a9b3-e75de73c527a" :question/math-academy-id "e-2718"} :knowledge-point/id #uuid "02d46a44-0f02-5491-8e71-2eb22ad50ff9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049949}] :knowledge-point/questions [{:db/id #edb/ref 17592186106166} {:db/id #edb/ref 17592186106170} {:db/id #edb/ref 17592186505752} {:db/id #edb/ref 17592186505835} {:db/id #edb/ref 17592186511516}] :knowledge-point/title "Calculating the Measure of an Angle Using the Isosceles Triangle Theorem"} :step/id #uuid "6c37fcdd-4a4f-5fa4-b419-cdfb144ce00e" :step/math-academy-id 164420 :step/next {:db/id #edb/ref 17592186106629}} {:db/id #edb/ref 17592186106629 :step/content {:db/id #edb/ref 17592186105739 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105526 :question/id #uuid "c7ae19b8-aee0-5a64-b7c8-61f3ce75272c" :question/math-academy-id "e-2721"} :knowledge-point/id #uuid "0690d62b-432c-5d1e-96f2-b43393f6efa9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048764} {:db/id #edb/ref 17592186050410}] :knowledge-point/questions [{:db/id #edb/ref 17592186106167} {:db/id #edb/ref 17592186106171} {:db/id #edb/ref 17592186505731} {:db/id #edb/ref 17592186505815} {:db/id #edb/ref 17592186565452}] :knowledge-point/title "Calculating the Measure of an Angle in an Isosceles Triangle Given an Exterior Angle"} :step/id #uuid "52480c3c-c289-5e97-b7aa-1a5401a73156" :step/math-academy-id 164423 :step/next {:db/id #edb/ref 17592186106630}} {:db/id #edb/ref 17592186106630 :step/content {:db/id #edb/ref 17592186105740 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105584 :question/id #uuid "d9e953e1-5af0-55eb-a861-af6f4ed9b720" :question/math-academy-id "e-4269"} :knowledge-point/id #uuid "c9c2b7ee-d32b-550b-b110-81d04d750c98" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048213}] :knowledge-point/questions [{:db/id #edb/ref 17592186106165} {:db/id #edb/ref 17592186106169} {:db/id #edb/ref 17592186505797} {:db/id #edb/ref 17592186505818}] :knowledge-point/title "Solving for a Variable Given Unknown Lengths in an Isosceles Triangle"} :step/id #uuid "b5d08f57-ce6b-5494-a967-38442f05a2c6" :step/math-academy-id 164426 :step/next {:db/id #edb/ref 17592186106631}} {:db/id #edb/ref 17592186106631 :step/content {:db/id #edb/ref 17592186105741 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105527 :question/id #uuid "e44e7e25-f65b-5f40-9aef-cbe55bfd1b53" :question/math-academy-id "e-2726"} :knowledge-point/id #uuid "0044ba61-80c8-57cf-80dc-8a17cf980a84" :knowledge-point/questions [{:db/id #edb/ref 17592186106168} {:db/id #edb/ref 17592186106391} {:db/id #edb/ref 17592186505742} {:db/id #edb/ref 17592186505837} {:db/id #edb/ref 17592186565454} {:db/id #edb/ref 17592186565459}] :knowledge-point/title "Finding the Measure of an Angle Given Multiple Triangles"} :step/id #uuid "ec111c1e-1c82-5a70-b2f1-5dfba6037c19" :step/math-academy-id 164429}] :activity/title "The Isosceles Triangle Theorem" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186106021}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186565535} :activity/id #uuid "7731ce61-1f9a-51e4-a49c-996258564f67" :activity/scope {:db/id #edb/ref 17592186049027 :topic/id #uuid "d4a5e636-5453-5120-957b-34a9e32197ae" :topic/math-academy-id 1403} :activity/steps [{:db/id #edb/ref 17592186565501 :step/content {:db/id #edb/ref 17592186565454 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03661a97-3f4c-57e9-943b-6740f23533e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{67}^{∘}" :db/id #edb/ref 17592186564944} {:answer/id #uuid "24b2b15c-24e2-57bc-9b13-a06cbd4eb16e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{69}^{∘}" :db/id #edb/ref 17592186564994} {:answer/id #uuid "7335ea22-0c13-5b37-8b47-351229d967ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{73}^{∘}" :db/id #edb/ref 17592186565114} {:answer/id #uuid "7c88601f-7ff0-5a6b-af0b-a77dbae473cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{72}^{∘}" :db/id #edb/ref 17592186565128} {:answer/id #uuid "aa458a18-ad45-591e-ab81-1483b9bbc230" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{70}^{∘}" :db/id #edb/ref 17592186565192}] :answer-field/correct {:db/id #edb/ref 17592186565192} :answer-field/id #uuid "ddd44795-8d4c-547b-9853-d23d19571f47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186565394}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ae1938a1-58ee-571b-a544-d365ce409563" :question/math-academy-id "q-21232" :question/problem "![](images/19/19ca38571817d9de8c92de17d5121c33ac1494848766033792dc9586c95fa475.png)\n\nIn the isosceles triangle $△ABC$  with base $\\overset{―}{AB}$, point $E$ lies on the side $\\overset{―}{BC}$, $\\overset{―}{AE}=\\overset{―}{EC}$ and $m∠EAC={40}^{∘}.$ What is the measure of $∠B?$" :question/worked-solution "First, notice that $△ABC$ is an isosceles triangle with base $\\overset{―}{AB}.$ Consequently,  the base angles must have equal measure:\n\n$$\nm∠BAC=m∠B\n$$\n\nAlso, since $△CEA$ is an isosceles triangle, we have:\n\n$$\nm∠C=m∠EAC={40}^{∘}\n$$\n\nFinally, we calculate $m∠B$ using the fact that the interior angles of $△ABC$ sum to ${180}^{∘}:$\n\n$$\n\\begin{aligned}m∠BAC+m∠B+m∠C & ={180}^{∘} \\\\ m∠B+m∠B+{40}^{∘} & ={180}^{∘} \\\\ 2m∠B & ={140}^{∘} \\\\ m∠B & ={70}^{∘}\\end{aligned}\n$$"} :step/id #uuid "3970f23e-0d4b-58af-b62e-7ed9157998d2" :step/next {:db/id #edb/ref 17592186565505}} {:db/id #edb/ref 17592186565505 :step/content {:db/id #edb/ref 17592186565452 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46ca1c05-5190-5ad2-8c5c-d591894996c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{107}^{∘}" :db/id #edb/ref 17592186565039} {:answer/id #uuid "5274cb9d-d489-5332-8ddc-d0bf62c38087" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{108}^{∘}" :db/id #edb/ref 17592186565058} {:answer/id #uuid "bfa840cd-3123-510e-bf31-113dff14f21e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{112}^{∘}" :db/id #edb/ref 17592186565228} {:answer/id #uuid "f6ebedab-b10c-56a0-8c29-72fe32d8a4eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{113}^{∘}" :db/id #edb/ref 17592186565312} {:answer/id #uuid "f81ae10f-b2ec-5eff-a612-29b4fa814574" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{110}^{∘}" :db/id #edb/ref 17592186565315}] :answer-field/correct {:db/id #edb/ref 17592186565315} :answer-field/id #uuid "2517a418-b87f-54f2-b710-d15c568a3534" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186565338}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a323077c-5cf0-5ef0-a051-240e1171e494" :question/math-academy-id "q-52972" :question/problem "![](images/37/372ac1135e480bcd843f02b05bdeae42d462fccaced8151e4a355d6263d7be64.png)\n\nFind the value of $z$ in the triangle shown above." :question/worked-solution "First, from the diagram, notice that $∠CAB$ and $∠BAD$ are supplementary. Therefore,\n\n$$\n\\begin{aligned}m∠CAB+m∠BAD & ={180}^{∘} \\\\ m∠CAB+z & ={180}^{∘} \\\\ m∠CAB & ={180}^{∘}-z.\\end{aligned}\n$$\n\nSince $△ABC$ is an isosceles triangle where $\\overset{―}{AB}≅\\overset{―}{BC}$, the base angles must be equal:\n\n$$\nm∠C=m∠CAB.\n$$\n\nFinally, since the interior angles of any triangle sum to ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠CAB+m∠C+m∠B & ={180}^{∘} \\\\ 2m∠CAB+m∠B & ={180}^{∘} \\\\ 2({180}^{∘}-z)+{40}^{∘} & ={180}^{∘} \\\\ {360}^{∘}-2z+{40}^{∘} & ={180}^{∘} \\\\ 2z & ={220}^{∘} \\\\ z & ={110}^{∘}.\\end{aligned}\n$$"} :step/id #uuid "547a136f-0f45-5073-888d-a69eb3373469"} {:db/id #edb/ref 17592186565535 :step/content {:db/id #edb/ref 17592186565459 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7af2094e-5a9c-5576-ab4c-588a0176acd0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{32}^{∘}" :db/id #edb/ref 17592186565125} {:answer/id #uuid "7f5c018b-da77-51b3-94a3-4a719e2c22a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{29}^{∘}" :db/id #edb/ref 17592186565132} {:answer/id #uuid "8be640ca-b6bd-59dc-98b9-bc210f8e3e6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{27}^{∘}" :db/id #edb/ref 17592186565154} {:answer/id #uuid "a51bdf43-9f1b-54de-9f2e-2698aa8af185" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186565189} {:answer/id #uuid "b7b5d134-db45-5c5c-a672-02898c3558d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{34}^{∘}" :db/id #edb/ref 17592186565213}] :answer-field/correct {:db/id #edb/ref 17592186565189} :answer-field/id #uuid "a9b88805-312e-50ff-a48f-9a2d91e7b91d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186565373}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b85bf70e-60cf-531c-93a8-54cd5e2b47c0" :question/math-academy-id "q-21222" :question/problem "![](images/c6/c62f51c2b029d6b1e24e7f30603c5f34ab5d70d96ed84c5c74de15d4e2e6358e.png)\n\nWhat is the measure of $∠D?$" :question/worked-solution "First, notice that $△ABC$ is an equilateral triangle. Consequently, all of the interior angles must be equal to ${60}^{∘}:$ \n\n$$\nm∠A=m∠B=m∠ABC={60}^{∘}\n$$\n\nAlso, since $△CDB$ is an isosceles triangle, the base angles must have equal measure:\n\n$$\nm∠CBD=m∠D\n$$\n\nNotice also that $∠ACB$ and $∠DCB$ are supplementary, therefore, we obtain\n\n$$\n\\begin{aligned}m∠ACB+m∠DCB & ={180}^{∘} \\\\ {60}^{∘}+m∠DCB & ={180}^{∘} \\\\ m∠DCB & ={120}^{∘}.\\end{aligned}\n$$\n\n Finally, we calculate $m∠D$ using the fact that the interior angles of a triangle sum to ${180}^{∘}:$\n\n$$\n\\begin{aligned}m∠D+m∠DCB+m∠CBD & ={180}^{∘} \\\\ m∠D+{120}^{∘}+m∠D & ={180}^{∘} \\\\ 2m∠D & ={60}^{∘} \\\\ m∠D & ={30}^{∘}\\end{aligned}\n$$"} :step/id #uuid "d4131835-327a-579d-bd13-775bb94299f0" :step/next {:db/id #edb/ref 17592186565501}}] :activity/title "The Isosceles Triangle Theorem" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186564931}]}
