13-b9b0-8f30387b49a6" 13194139536086 17592186045417 true] [17592186565408 1075 17592186564999 13194139536086 17592186045417 true] [17592186565408 1075 17592186565015 13194139536086 17592186045417 true] [17592186565408 1075 17592186565024 13194139536086 17592186045417 true] [17592186565408 1075 17592186565161 13194139536086 17592186045417 true] [17592186565408 1075 17592186565162 13194139536086 17592186045417 true] [17592186565408 1076 17592186045493 13194139536086 17592186045417 true] [17592186565408 1077 "selection" 13194139536086 17592186045417 true] [17592186565408 1078 17592186564999 13194139536086 17592186045417 true] [17592186565408 1079 #uuid "f4183e30-864f-59d2-a111-26fabe8674fe" 13194139536086 17592186045417 true] [17592186565409 1068 17592186565377 13194139536086 17592186045417 true] [17592186565409 1069 "q-99351" 13194139536086 17592186045417 true] [17592186565409 1070 17592186045486 13194139536086 17592186045417 true] [17592186565409 1071 "Compute ${lim}_{x\\to {0}^{+}}(-\\frac{9}{5{x}^{8}}).$" 13194139536086 17592186045417 true] [17592186565409 1072 #uuid "0443135d-0cff-565f-8ee8-219a9e567bef" 13194139536086 17592186045417 true] [17592186565409 1074 "First, we rewrite the limit using the algebra of limits, as follows:\n\n$$\n{lim}_{x\\to {0}^{+}}(-\\frac{9}{5{x}^{8}})=-\\frac{9}{5}\\cdot {lim}_{x\\to {0}^{+}}\\frac{1}{{x}^{8}}\n$$\n\nNow, we recall the graph of the function $y=\\frac{1}{{x}^{8}}:$\n\n![](images/ae/aeeed013b57f5fd8a554ca6613bf9e3fa9419ae2e0fd5920397c5b9cb0dd88fb.png)\n\nFrom the graph, we see that\n\n$$\n{lim}_{x\\to {0}^{+}}\\frac{1}{{x}^{8}}=\\infty .\n$$\n\nFinally, the negative factor of $-\\frac{9}{5}$ changes the sign of the limit. Therefore, we conclude that\n\n$$\n-\\frac{9}{5}\\cdot {lim}_{x\\to {0}^{+}}\\frac{1}{{x}^{8}}=-\\infty .\n$$" 13194139536086 17592186045417 true] [17592186565410 1068 17592186565358 13194139536086 17592186045417 true] [17592186565410 1069 "q-122991" 13194139536086 17592186045417 true] [17592186565410 1070 17592186045486 13194139536086 17592186045417 true] [17592186565410 1071 "Let $P=\\{{x}_{0},{x}_{1},…,{x}_{m}\\}$ be a partition of the interval $[1,3].$ If $Δ{x}_{i}={x}_{i}-{x}_{i-1},$ calculate ${\\sum }_{i=1}^{m}5({x}_{i}+{x}_{i-1})Δ{x}_{i}.$" 13194139536086 17592186045417 true] [17592186565410 1072 #uuid "05eaf340-4492-5bdf-bad0-8c07f4ea4867" 13194139536086 17592186045417 true] [17592186565410 1074 "Using the constant multiple rule, we can write the summation as\n\n$$\n{\\sum }_{i=1}^{m}5({x}_{i}+{x}_{i-1})Δ{x}_{i}=5{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i}.\n$$\n\nWe can simplify the summation as follows:\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i} & =({x}_{1}+{x}_{0})Δ{x}_{1}+({x}_{2}+{x}_{1})Δ{x}_{2}+⋯+({x}_{m}+{x}_{m-1})Δ{x}_{m} \\\\  & =({x}_{1}+{x}_{0})({x}_{1}-{x}_{0})+({x}_{2}+{x}_{1})({x}_{2}-{x}_{1})+⋯+({x}_{m}+{x}_{m-1})({x}_{m}-{x}_{m-1}) \\\\  & =({x}_{1}^{2}-{x}_{0}^{2})+({x}_{2}^{2}-{x}_{1}^{2})+⋯+({x}_{m}^{2}-{x}_{m-1}^{2}) \\\\  & =(\\cancel{{x}_{1}^{2}}-{x}_{0}^{2})+(\\cancel{{x}_{2}^{2}}-\\cancel{{x}_{1}^{2}})+⋯+({x}_{m}^{2}-\\cancel{{x}_{m-1}^{2}}) \\\\  & =-{x}_{0}^{2}+{x}_{m}^{2} \\\\  & ={x}_{m}^{2}-{x}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${x}_{0}=1$ and ${x}_{m}=3$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i} & ={x}_{m}^{2}-{x}_{0}^{2} \\\\  & ={3}^{2}-{1}^{2} \\\\  & =8.\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n5{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i}=5\\cdot 8=40.\n$$" 13194139536086 17592186045417 true] [17592186565411 1068 17592186565365 13194139536086 17592186045417 true] [17592186565411 1069 "q-334164" 13194139536086 17592186045417 true] [17592186565411 1070 17592186045485 13194139536086 17592186045417 true] [17592186565411 1071 "Evaluate the following limit:\n\n${lim}_{x\\to \\infty }(\\frac{-3}{{x}^{8}})=$\n{{field-1}}" 13194139536086 17592186045417 true] [17592186565411 1072 #uuid "0883765a-f056-556c-bee6-eafc65b5e91c" 13194139536086 17592186045417 true] [17592186565411 1074 "First, we use the algebra of limits to pull out the constant factor of $-3:$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{-3}{{x}^{8}} & ={lim}_{x\\to \\infty }[-3\\cdot \\frac{1}{{x}^{8}}] \\\\  & =-3\\cdot {lim}_{x\\to \\infty }\\frac{1}{{x}^{8}}\\end{aligned}\n$$\n\nNow, using the fact that\n\n$$\n{lim}_{x\\to \\infty }(\\frac{1}{{x}^{8}})=0,\n$$\n\nwe can evaluate our limit as follows:\n\n$$\n-3\\cdot {lim}_{x\\to \\infty }\\frac{1}{{x}^{8}}=-3\\cdot 0=0\n$$" 13194139536086 17592186045417 true] [17592186565412 1068 17592186565407 13194139536086 17592186045417 true] [17592186565412 1069 "q-300983" 13194139536086 17592186045417 true] [17592186565412 1070 17592186045486 13194139536086 17592186045417 true] [17592186565412 1071 "![](images/64/6469991ee6751110f55ce6462c4c3f2e406d8b61fabcb6c2d2cc1515ec12dd2c.png)\n\nIf the figure above shows the graph of $g(x),$ then\n\n${lim}_{x\\to -\\infty }\\frac{g(x)}{{x}^{3}-2{x}^{2}-7}=$\n\n {{field-1}}." 13194139536086 17592186045417 true] [17592186565412 1072 #uuid "0f04e402-41a0-5006-8eb9-65c2d82f6e13" 13194139536086 17592186045417 true] [17592186565412 1074 "From the diagram, ${lim}_{x\\to -\\infty }g(x)=-2.$\n\nNow, rewrite the target limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\frac{g(x)}{{x}^{3}-2{x}^{2}-7} & ={lim}_{x\\to -\\infty }g(x)\\cdot {lim}_{x\\to -\\infty }\\frac{1}{{x}^{3}-2{x}^{2}-7}\\end{aligned}\n$$\n\nFor any non-constant polynomial $P(x),$ we have\n\n$$\n{lim}_{x\\to \\pm \\infty }(\\frac{1}{P(x)})=0.\n$$\n\nTherefore, since ${x}^{3}$ is a non-constant polynomial, we have\n\n$$\n{lim}_{x\\to \\infty }\\frac{1}{{x}^{3}-2{x}^{2}-7}=0.\n$$\n\nFinally, we can evaluate the original limit as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }g(x)\\cdot {lim}_{x\\to \\infty }\\frac{1}{{x}^{3}-2{x}^{2}-7}=-2\\cdot 0=0\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565413 1068 17592186565367 13194139536086 17592186045417 true] [17592186565413 1069 "q-105766" 13194139536086 17592186045417 true] [17592186565413 1070 17592186045487 13194139536086 17592186045417 true] [17592186565413 1071 "Let $f(x,y,z)$ be a function that is differentiable at each point on the line segment $\\overset{―}{AB},$ where $a=⟨1,0,4⟩$ and $b=⟨2,-1,3⟩$ are the position vectors of $A$ and $B,$ respectively. If $f(a)=5$ and $f(b)=8,$ then what is missing from the statement below?\n\n*The mean value theorem states that there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that $\\text{_______________}\\,.$ *" 13194139536086 17592186045417 true] [17592186565413 1072 #uuid "14bd3999-4f71-5f69-b9ed-e9c986ba9f80" 13194139536086 17592186045417 true] [17592186565413 1074 "The mean value theorem states that if $f(x,y,z)$ is differentiable at each point on the line segment $\\overset{―}{AB},$ then there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that\n\n$$\nf(b)-f(a)=∇f(c)·(b-a).\n$$\n\nIn our case, we have \n\n$$\n\\begin{aligned}f(b)-f(a) & =∇f(c)\\cdot (b-a) \\\\ 8-5 & =⟨{f}_{x}(c),{f}_{y}(c),{f}_{z}(c)⟩\\cdot (⟨2,-1,3⟩-⟨1,0,4⟩) \\\\ 3 & =⟨{f}_{x}(c),{f}_{y}(c),{f}_{z}(c)⟩\\cdot ⟨1,-1,-1⟩ \\\\ 3 & ={f}_{x}(c)-{f}_{y}(c)-{f}_{z}(c).\\end{aligned}\n$$\n\nTherefore, the complete sentence is as follows:\n\n*The mean value theorem states that there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that ${f}_{x}(c)-{f}_{y}(c)-{f}_{z}(c)=3.$ *" 13194139536086 17592186045417 true] [17592186565414 1068 17592186565348 13194139536086 17592186045417 true] [17592186565414 1069 "q-73216" 13194139536086 17592186045417 true] [17592186565414 1070 17592186045487 13194139536086 17592186045417 true] [17592186565414 1071 "What is the trace in the $yz$-plane of the ellipsoid $\\frac{{x}^{2}}{8}+\\frac{(y+1)^{2}}{6}+\\frac{(z-1)^{2}}{12}=1?$" 13194139536086 17592186045417 true] [17592186565414 1072 #uuid "15b3432d-8b0c-5d62-a84d-7dadd72f7ac7" 13194139536086 17592186045417 true] [17592186565414 1074 "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the ellipsoid:\n\n$$\n\\begin{aligned}\\frac{{0}^{2}}{8}+\\frac{(y+1)^{2}}{6}+\\frac{(z-1)^{2}}{12}=1 \\\\ \\frac{(y+1)^{2}}{6}+\\frac{(z-1)^{2}}{12}=1 \\\\ \\frac{(y+1)^{2}}{(\\sqrt{6})^{2}}+\\frac{(z-1)^{2}}{(2\\sqrt{3})^{2}}=1\\end{aligned}\n$$\n\nThis gives us the equation of the ellipse with semi-axes $\\sqrt{6}$ and $2\\sqrt{3},$ centered at $(-1,1)$ in the $yz$-plane." 13194139536086 17592186045417 true] [17592186565415 1068 17592186565368 13194139536086 17592186045417 true] [17592186565415 1069 "q-36453" 13194139536086 17592186045417 true] [17592186565415 1070 17592186045487 13194139536086 17592186045417 true] [17592186565415 1071 "${lim}_{x\\to 0}\\frac{7}{3x}=$" 13194139536086 17592186045417 true] [17592186565415 1072 #uuid "1b8c4518-97e5-5ab3-a859-e015cbefbbce" 13194139536086 17592186045417 true] [17592186565415 1074 "First, we rewrite the limit using the algebra of limits,  as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{7}{3x} & =\\frac{7}{3}\\cdot {lim}_{x\\to 0}\\frac{1}{x}\\end{aligned}\n$$\n\nNow, recall the fact that\n\n$$\n{lim}_{x\\to {0}^{-}}(\\frac{1}{x})=-\\infty ,\\,{lim}_{x\\to {0}^{+}}(\\frac{1}{x})=\\infty .\n$$\n\nWe conclude that\n\n$$\n{lim}_{x\\to 0}(\\frac{1}{x})=\\text{DNE}.\n$$\n\nTherefore, \n\n$$\n\\frac{7}{3}\\cdot {lim}_{x\\to 0}\\frac{1}{x}=\\text{DNE}.\n$$" 13194139536086 17592186045417 true] [17592186565416 1068 17592186565391 13194139536086 17592186045417 true] [17592186565416 1069 "q-128449" 13194139536086 17592186045417 true] [17592186565416 1070 17592186045485 13194139536086 17592186045417 true] [17592186565416 1071 "Determine the equation of the level curve that passes through the point $P(0,1)$ for the function $f(x,y)=\\frac{3x+2}{1-3y}.$" 13194139536086 17592186045417 true] [17592186565416 1072 #uuid "240c650f-50a8-531d-9d84-394b65ab5cda" 13194139536086 17592186045417 true] [17592186565416 1074 "First, we find the value of the function at $P:$\n\n$$\n\\begin{aligned}f(0,1) & =\\frac{3(0)+2}{1-3(1)} \\\\  & =\\frac{0+2}{1-3} \\\\  & =\\frac{2}{(-2)} \\\\  & =-1\\end{aligned}\n$$\n\nHence, the level curve that passes through $P(0,1)$ is the $-1$-level curve.\n\nRecall that the level curves for the function $f(x,y)$ are given by the equation\n\n$$\nf(x,y)=c.\n$$\n\nIn our case, we're interested in $c=-1.$ So, we have\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ \\frac{3x+2}{1-3y} & =-1 \\\\ 3x+2 & =-(1-3y) \\\\ 3x+2 & =3y-1 \\\\ 3y & =3x+3 \\\\ y & =x+1\\end{aligned}\n$$\n\nTherefore, the level curve that passes through $P(0,1)$ is the line $y=x+1.$" 13194139536086 17592186045417 true] [17592186565417 1068 17592186565406 13194139536086 17592186045417 true] [17592186565417 1069 "q-118850" 13194139536086 17592186045417 true] [17592186565417 1070 17592186045485 13194139536086 17592186045417 true] [17592186565417 1071 "![](images/0a/0a2f45da66edebc2c565b36472648c76421a33513fb51c6a26e79e7a551b526e.png)\n\nDetermine the height of the rectangular solid above given that its volume is $90\\,{\\text{ft}}^{3}.$" 13194139536086 17592186045417 true] [17592186565417 1072 #uuid "2a4cb01f-06d4-5935-8045-405f9fc7f7c5" 13194139536086 17592186045417 true] [17592186565417 1074 "We can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV=lwh,\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting\n\n$$\nV=90,\\,l=3,\\,w=5\n$$\n\ninto the formula, we obtain the following:\n\n$$\n\\begin{aligned}90 & =3\\cdot 5\\cdot h \\\\ 90 & =15h \\\\ h & =6\\end{aligned}\n$$\n\nTherefore, the height is $6\\,\\text{ft}.$" 13194139536086 17592186045417 true] [17592186565418 1068 17592186565404 13194139536086 17592186045417 true] [17592186565418 1069 "q-118848" 13194139536086 17592186045417 true] [17592186565418 1070 17592186045485 13194139536086 17592186045417 true] [17592186565418 1071 "![](images/c3/c38953be7964fa371aaf82b20318aa87f9cc2641ada73c9f2778eeed61713450.png)\n\nDetermine the length of the rectangular solid above given that its volume is $105\\,{\\text{cm}}^{3}.$" 13194139536086 17592186045417 true] [17592186565418 1072 #uuid "2bf849af-f99e-5349-b3c0-22dba12fdf42" 13194139536086 17592186045417 true] [17592186565418 1074 "We can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV=lwh,\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting \n\n$$\nV=105,\\,w=5,\\,h=7\n$$\n\ninto the formula, we obtain the following\n\n$$\n\\begin{aligned}105 & =l\\cdot 5\\cdot 7 \\\\ 105 & =35l \\\\ l & =3\\end{aligned}\n$$\n\nTherefore, the length is $3\\,\\text{cm}.$" 13194139536086 17592186045417 true] [17592186565419 1068 17592186565398 13194139536086 17592186045417 true] [17592186565419 1069 "q-122951" 13194139536086 17592186045417 true] [17592186565419 1070 17592186045486 13194139536086 17592186045417 true] [17592186565419 1071 "![](images/8a/8a418e8e8e84133cb672d312f5dde246876a0f261c97d739b62b7e5ced437764.png)\n\nConsider the partition of the rectangular region $R$ shown above and the positive function $f(x,y)$ defined on $R.$ Which of the following gives an expression for the lower Riemann sum of $f$ with respect to this partition.\n\n*Hint: ${m}_{ij}$ denotes the minimum value of $f$ on the subregion ${R}_{ij}$*" 13194139536086 17592186045417 true] [17592186565419 1072 #uuid "2ca84db7-67f2-5f23-9873-fa001c3f6805" 13194139536086 17592186045417 true] [17592186565419 1074 "To calculate the lower Riemann sum $L$ with respect to the given partition, we compute the sum of the volumes of $4$ rectangular solids, one for each ${R}_{ij}.$\n\nThe volume of the rectangular solid corresponding to each subregion ${R}_{ij}$ is given by\n\n$$\n{m}_{ij}\\cdot \\text{Area}({R}_{ij}).\n$$\n\nwhere ${m}_{ij}$ denotes the minimum value of $f$ on the subregion ${R}_{ij}.$ We pick the *minimum* value of $f$ because we're finding the *lower* sum.\n\nSo in our case, we have\n\n$$\nL={m}_{11}\\cdot \\text{Area}({R}_{11})+{m}_{21}\\cdot \\text{Area}({R}_{21})+{m}_{12}\\cdot \\text{Area}({R}_{12})+{m}_{13}\\cdot \\text{Area}({R}_{13}).\n$$\n\nNow, notice that\n\n$$\n\\text{Area}({R}_{11})=\\text{Area}({R}_{12})=\\text{Area}({R}_{13})=1,\n$$\n\nand\n\n$$\n\\text{Area}({R}_{21})=3.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}L & ={m}_{11}+3\\cdot {m}_{21}+{m}_{12}+{m}_{13} \\\\  & ={m}_{11}+3{m}_{21}+{m}_{12}+{m}_{13}.\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565420 1068 17592186565402 13194139536086 17592186045417 true] [17592186565420 1069 "q-95029" 13194139536086 17592186045417 true] [17592186565420 1070 17592186045487 13194139536086 17592186045417 true] [17592186565420 1071 "Consider the following polynomials:\n\n$$\n{p}_{1}(t)=-1-t+2{t}^{2},\\,{p}_{2}(t)=t-{t}^{2},\\,q(t)=3-3t.\n$$\n\nIf $B=\\{{p}_{1}(t),{p}_{2}(t)\\}$ is a basis of $\\text{Span}\\{{p}_{1}(t),{p}_{2}(t)\\},$ and $[q(t)]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" 13194139536086 17592186045417 true] [17592186565420 1072 #uuid "2d45985d-1bef-55fa-a31c-73d51b4f78be" 13194139536086 17592186045417 true] [17592186565420 1074 "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{p}_{1}(t)+{x}_{2}{p}_{2}(t)=q(t)\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}(-1-t+2{t}^{2})+{x}_{2}(t-{t}^{2}) & =3-3t \\\\ -{x}_{1}+(-{x}_{1}+{x}_{2})t+(2{x}_{1}-{x}_{2}){t}^{2} & =3-3t.\\end{aligned}\n$$\n\nEquating the coefficients of $t$, we obtain\n\n$$\n\\{\\begin{aligned}-{x}_{1}=3 \\\\ -{x}_{1}+{x}_{2}=-3 \\\\ 2{x}_{1}-{x}_{2}=0.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}-1 & 0 & 3 \\\\ -1 & 1 & -3 \\\\ 2 & -1 & 0\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}-1 & 0 & 3 \\\\ -1 & 1 & -3 \\\\ 2 & -1 & 0\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-1){R}_{1} \\\\ {R}_{3}:={R}_{3}+2{R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}-1 & 0 & 3 \\\\ 0 & 1 & -6 \\\\ 0 & -1 & 6\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+{R}_{2}\\end{aligned} \\\\ ∼ & [\\begin{aligned}-1 & 0 & 3 \\\\ 0 & 1 & -6 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}-{x}_{1}=3 \\\\ {x}_{2}=-6.\\end{aligned}\n$$\n\nFrom the first and second equations, we get ${x}_{1}=-3$ and ${x}_{2}=-6.$ \n\nTherefore, $[q(t)]_{B}=[\\begin{aligned}-3 \\\\ -6\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=-3+(-6)=-9.$" 13194139536086 17592186045417 true] [17592186565421 1068 17592186565388 13194139536086 17592186045417 true] [17592186565421 1069 "q-106779" 13194139536086 17592186045417 true] [17592186565421 1070 17592186045487 13194139536086 17592186045417 true] [17592186565421 1071 "Consider the following matrices:\n\n$$\n{B}_{1}=[\\begin{aligned}1 & -1 \\\\ 0 & 1\\end{aligned}],\\,{B}_{2}=[\\begin{aligned}0 & 1 \\\\ 0 & -1\\end{aligned}],\\,A=[\\begin{aligned}6 & -2 \\\\ 0 & 2\\end{aligned}]\n$$\n\nIf $B=\\{{B}_{1},{B}_{2}\\}$ is a basis of $\\text{Span}\\{{B}_{1},{B}_{2}\\},$ and $[A]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" 13194139536086 17592186045417 true] [17592186565421 1072 #uuid "2e84799f-e1a6-5cc6-b626-825322837015" 13194139536086 17592186045417 true] [17592186565421 1074 "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{B}_{1}+{x}_{2}{B}_{2}=A.\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}1 & -1 \\\\ 0 & 1\\end{aligned}]+{x}_{2}[\\begin{aligned}0 & 1 \\\\ 0 & -1\\end{aligned}] & =[\\begin{aligned}-6 & -2 \\\\ 0 & 2\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1} & -{x}_{1}+{x}_{2} \\\\ 0 & {x}_{1}-{x}_{2}\\end{aligned}] & =[\\begin{aligned}6 & -2 \\\\ 0 & 2\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding entries, we obtain\n\n$$\n\\{\\begin{aligned}{x}_{1}=6 \\\\ -{x}_{1}+{x}_{2}=-2 \\\\ {x}_{1}-{x}_{2}=2.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}1 & 0 & 6 \\\\ -1 & 1 & -2 \\\\ 1 & -1 & 2\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}1 & 0 & 6 \\\\ -1 & 1 & -2 \\\\ 1 & -1 & 2\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+{R}_{1} \\\\ {R}_{3}:={R}_{3}+(-1){R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}1 & 0 & 6 \\\\ 0 & 1 & 4 \\\\ 0 & -1 & -4\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}{x}_{1}=6 \\\\ {x}_{2}=4 \\\\ -{x}_{2}=-4.\\end{aligned}\n$$\n\n \nFrom the second and third equations, we get ${x}_{2}=4.$ From the first equation, we get  ${x}_{1}=6.$\n\nTherefore, $[A]_{B}=[\\begin{aligned}6 \\\\ 4\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=6+4=10.$" 13194139536086 17592186045417 true] [17592186565422 1068 17592186565334 13194139536086 17592186045417 true] [17592186565422 1069 "q-334297" 13194139536086 17592186045417 true] [17592186565422 1070 17592186045485 13194139536086 17592186045417 true] [17592186565422 1071 "Evaluate the following limit:\n\n${lim}_{x\\to 0}\\frac{1}{{x}^{6}}=$\n{{field-1}}" 13194139536086 17592186045417 true] [17592186565422 1072 #uuid "2f421385-b333-57a6-99f9-5c22d85a1c43" 13194139536086 17592186045417 true] [17592186565422 1074 "We recall the graph of the function $y=\\frac{1}{{x}^{6}}:$\n\n![](images/ff/ffedd1b83fa2d80b924b0d2f68a3100236347e3222ec171bc60b299579a7af4e.png)\n\nFrom the graph, we see that\n\n$$\n{lim}_{x\\to {0}^{-}}\\frac{1}{{x}^{6}}=\\infty ,\\,{lim}_{x\\to {0}^{+}}\\frac{1}{{x}^{6}}=\\infty ,\n$$\n\nand therefore\n\n$$\n{lim}_{x\\to 0}\\frac{1}{{x}^{6}}=\\infty .\n$$" 13194139536086 17592186045417 true] [17592186565423 1068 17592186565378 13194139536086 17592186045417 true] [17592186565423 1069 "q-75038" 13194139536086 17592186045417 true] [17592186565423 1070 17592186045487 13194139536086 17592186045417 true] [17592186565423 1071 "Let $R=[0,2]\\times [0,2]$ be a region in the $xy$-plane, and let $f(x,y)=4-x-y.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{0,1,2\\},\\,{P}_{2}=\\{0,1,2\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the lower Riemann sum $L(f,P).$" 13194139536086 17592186045417 true] [17592186565423 1072 #uuid "38c907cd-2c27-580b-8563-70cc82b39b8b" 13194139536086 17592186045417 true] [17592186565423 1074 "First, let's draw the region $R$ and the partition $P.$\n\n![](images/3c/3cac974f7352243bfbe008ad8af58ae8222709f81f434070383cc759a46747c7.png)\n\nThe lower Riemann sum $L(f,P)$ is given by\n\n$$\nL(f,P)={m}_{11}\\cdot \\text{Area}({R}_{11})+{m}_{21}\\cdot \\text{Area}({R}_{21})+{m}_{12}\\cdot \\text{Area}({R}_{12})+{m}_{22}\\cdot \\text{Area}({R}_{22})\n$$\n\nwhere ${m}_{ij}$ is the minimum value of $f$ in each subregion ${R}_{ij}.$ We pick the *minimum* value of $f$ because we're finding the *lower* sum.\n\nTaking into account the fact that $\\text{Area}({R}_{ij})=1$ for all $4$ subregions, the formula for $L(f,P)$ reduces to\n\n$$\nL(f,P)={m}_{11}+{m}_{21}+{m}_{12}+{m}_{22}.\n$$\n\nNow, notice that\n\n- $f(x,y)=4-x-y$ decreases as $x$ increases, and\n\n- $f(x,y)=4-x-y$ decreases as $y$ increases.\n\n![](images/0f/0fefe892c74e8d391e56ee822f83e7e0fe0110593c9d6a4b93b8cfe1e558ab16.png)\n\nAs a result, the *minimum* value of $f$ in each subregion is attained when we have the *largest* possible $x$ and the *largest* possible $y.$ This is the value at the *top right corner* of each subregion.\n\n![](images/fe/fe872f1f1b0307760dcdba6ac6f6be20f197662ac250ab46dc77fa472295906f.png)\n\nHence:\n\n$$\n\\begin{aligned}{m}_{11} & =f(1,1)=2 \\\\ {m}_{21} & =f(2,1)=1 \\\\ {m}_{12} & =f(1,2)=1 \\\\ {m}_{22} & =f(2,2)=0\\end{aligned}\n$$\n\nFinally,\n\n$$\nL(f,P)=2+1+1+0=4.\n$$" 13194139536086 17592186045417 true] [17592186565424 1068 17592186565331 13194139536086 17592186045417 true] [17592186565424 1069 "q-74961" 13194139536086 17592186045417 true] [17592186565424 1070 17592186045486 13194139536086 17592186045417 true] [17592186565424 1071 "${lim}_{x\\to (3,1,2)}\\,\\frac{y-x+z}{\\sqrt{x-z}-\\sqrt{y}}=$" 13194139536086 17592186045417 true] [17592186565424 1072 #uuid "3e84a1e0-ab07-582e-a187-ce57adaa478b" 13194139536086 17592186045417 true] [17592186565424 1074 "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n{lim}_{x\\to (3,1,2)}\\,\\frac{y-x+z}{\\sqrt{x-z}-\\sqrt{y}}=\\frac{1-3+2}{\\sqrt{3-2}-\\sqrt{1}}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (3,1,2)}\\,\\frac{y-x+z}{\\sqrt{x-z}-\\sqrt{y}} & ={lim}_{x\\to (3,1,2)}\\,\\frac{(y-x+z)(\\sqrt{x-z}+\\sqrt{y})}{(\\sqrt{x-z}-\\sqrt{y})(\\sqrt{x-z}+\\sqrt{y})} \\\\  & ={lim}_{x\\to (3,1,2)}\\,\\frac{(y-x+z)(\\sqrt{x-z}+y)}{{(\\sqrt{x-z})}^{2}-{(\\sqrt{y})}^{2}} \\\\  & ={lim}_{x\\to (3,1,2)}\\,\\frac{(y-x+z)(\\sqrt{x-z}+y)}{x-z-y} \\\\  & ={lim}_{x\\to (3,1,2)}\\,\\frac{-(x-z-y)(\\sqrt{x-z}+y)}{x-z-y} \\\\  & ={lim}_{x\\to (3,1,2)}-(\\sqrt{x-z}+y)\\end{aligned}\n$$\n\n \n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}{lim}_{x\\to (3,1,2)}-(\\sqrt{x-z}+y) & =-(\\sqrt{3-2}+1) \\\\  & =-(1+1) \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $-2.$" 13194139536086 17592186045417 true] [17592186565425 1068 17592186565372 13194139536086 17592186045417 true] [17592186565425 1069 "q-74967" 13194139536086 17592186045417 true] [17592186565425 1070 17592186045486 13194139536086 17592186045417 true] [17592186565425 1071 "${lim}_{x\\to (0,0)}\\,\\frac{2{y}^{2}}{2{x}^{2}-{y}^{2}}=$" 13194139536086 17592186045417 true] [17592186565425 1072 #uuid "416deefa-43e7-520e-bca5-f8da057711d0" 13194139536086 17592186045417 true] [17592186565425 1074 "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0}:$\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{y}^{2}}{2{x}^{2}-{y}^{2}}=\\frac{2\\cdot {0}^{2}}{2\\cdot {0}^{2}-{0}^{2}}=\\frac{0}{0}\n$$\n\nHowever, the function cannot be simplified by canceling common factors in the numerator and denominator:\n\nLet's attempt to evaluate the limit approaching $(0,0)$ from different paths.\n\n- Taking $x\\to (0,0)$ along the path $y=x,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=x}\\,\\frac{2{y}^{2}}{2{x}^{2}-{y}^{2}} & ={lim}_{x\\to 0}\\,\\frac{2{x}^{2}}{2{x}^{2}-{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\,\\frac{2{x}^{2}}{{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\,2 \\\\  & =2.\\end{aligned}\n$$\n\n- Taking $x\\to (0,0)$ along the line $y=0$ (the $x$-axis),  we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=0}\\,\\frac{2{y}^{2}}{2{x}^{2}-{y}^{2}} & ={lim}_{x\\to 0}\\,\\frac{2\\cdot {0}^{2}}{2{x}^{2}-{0}^{2}} \\\\  & ={lim}_{x\\to 0}\\,0 \\\\  & =0.\\end{aligned}\n$$\n\nBecause the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{y}^{2}}{2{x}^{2}-{y}^{2}}=\\text{DNE}\n$$" 13194139536086 17592186045417 true] [17592186565426 1068 17592186565360 13194139536086 17592186045417 true] [17592186565426 1069 "q-154925" 13194139536086 17592186045417 true] [17592186565426 1070 17592186045487 13194139536086 17592186045417 true] [17592186565426 1071 "Solve the inequality $3a-7>\\frac{8a+5}{4}.$" 13194139536086 17592186045417 true] [17592186565426 1072 #uuid "4a18f4a9-430a-58c6-95f9-9ffd1a99116a" 13194139536086 17592186045417 true] [17592186565426 1074 "First, we clear the rational expression by multiplying both sides by $4:$\n\n$$\n\\begin{aligned}3a-7 & >\\frac{8a+5}{4} \\\\ 4\\cdot (3a-7) & >4\\cdot (\\frac{8a+5}{4}) \\\\ 4\\cdot (3a-7) & >\\cancel{4}\\cdot (\\frac{8a+5}{\\cancel{4}}) \\\\ 4\\cdot (3a-7) & >8a+5 \\\\ 12a-28 & >8a+5\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles:\n\n$$\n\\begin{aligned}12a-28 & >8a+5 \\\\ 12a-28-8a & >8a+5-8a \\\\ 4a-28 & >5 \\\\ 4a-28+28 & >5+28 \\\\ 4a & >33 \\\\ \\frac{4a}{4} & >\\frac{33}{4} \\\\ a & >\\frac{33}{4}\\end{aligned}\n$$\n\nTherefore, the solution is $a>\\frac{33}{4}.$" 13194139536086 17592186045417 true] [17592186565427 1068 17592186565333 13194139536086 17592186045417 true] [17592186565427 1069 "q-79501" 13194139536086 17592186045417 true] [17592186565427 1070 17592186045485 13194139536086 17592186045417 true] [17592186565427 1071 "Which of the following statements are true?\n\nI. ${y}^{″}+3{y}^{′}+7y=0$ represents an oscillator undergoing light damping.\n\nII. ${y}^{″}+6{y}^{′}+3y=0$ represents an oscillator undergoing critical damping.\n\nIII. ${y}^{″}+4{y}^{′}+12y=0$ represents an oscillator undergoing heavy damping." 13194139536086 17592186045417 true] [17592186565427 1072 #uuid "4be05fa7-5d88-5239-abf6-50f8cd96f574" 13194139536086 17592186045417 true] [17592186565427 1074 "Remember that, given the equation of a damped harmonic oscillator, the type of damping depends on the discriminant of the characteristic equation:\n\n- $D>0$ leads to heavy damping,\n\n- $D=0$ leads to critical damping, and\n\n- $D<0$ leads to light damping.\n\nWith that in mind, let's inspect each equation.\n\n- The differential equation ${y}^{″}+3{y}^{′}+7y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+3\\lambda +7=0\n$$\n\nThe discriminant of this quadratic equation is:\n\n$$\n\\begin{aligned}D={3}^{2}-4(1)(7) & =-19<0\\end{aligned}\n$$\n\nThus, the given equation represents light damping, and so statement I is correct.\n\n- The differential equation ${y}^{″}+6{y}^{′}+3y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is:\n\n$$\n{\\lambda }^{2}+6\\lambda +3=0\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={6}^{2}-4(1)(3) & =24>0\\end{aligned}\n$$\n\nThus, the given equation represents heavy damping, and so statement II is false.\n\n- The differential equation ${y}^{″}+4{y}^{′}+12y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is:\n\n$$\n{\\lambda }^{2}+4\\lambda +12=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={4}^{2}-4(1)(12) & =-32<0\\end{aligned}\n$$\n\nThus, the given equation represents light damping, and so statement III is false.\n\nIn conclusion, the correct answer is \"I only\"." 13194139536086 17592186045417 true] [17592186565428 1068 17592186565363 13194139536086 17592186045417 true] [17592186565428 1069 "q-71206" 13194139536086 17592186045417 true] [17592186565428 1070 17592186045485 13194139536086 17592186045417 true] [17592186565428 1071 "Find the equation of the level curve that passes through the point $H(\\sqrt{3},5)$ for the function $f(x,y)=\\frac{6}{y-{x}^{2}}.$" 13194139536086 17592186045417 true] [17592186565428 1072 #uuid "4f8639b5-fe7e-594e-a639-5523842bd2ae" 13194139536086 17592186045417 true] [17592186565428 1074 "First, we find the value of the function at $H$:\n\n$$\n\\begin{aligned}f(\\sqrt{3},5) & =\\frac{6}{5-(\\sqrt{3})^{2}}=3\\end{aligned}\n$$\n\nHence, the level curve that passes through $H(\\sqrt{3},5)$ is the $3$-level curve.\n\nRecall that the level curves for the function $f(x,y)$ are given by the equation\n\n$$\nf(x,y)=c.\n$$\n\nIn our case, we're interested in $c=3.$ So, we have:\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ \\frac{6}{y-{x}^{2}} & =3 \\\\ 2 & =y-{x}^{2} \\\\ y & ={x}^{2}+2\\end{aligned}\n$$\n\nTherefore, the level curve that passes through $H(\\sqrt{3},5)$ is the parabola $y={x}^{2}+2.$" 13194139536086 17592186045417 true] [17592186565429 1068 17592186565355 13194139536086 17592186045417 true] [17592186565429 1069 "q-71219" 13194139536086 17592186045417 true] [17592186565429 1070 17592186045485 13194139536086 17592186045417 true] [17592186565429 1071 "Find the equation of the level curve that passes through the point $F(\\sqrt{7},1)$ for the function $f(x,y)=\\frac{12y}{{x}^{2}-{y}^{2}}.$" 13194139536086 17592186045417 true] [17592186565429 1072 #uuid "54914efc-dfc4-51a5-a306-07132cb10e69" 13194139536086 17592186045417 true] [17592186565429 1074 "First, we find the value of the function at $F$:\n\n$$\n\\begin{aligned}f(\\sqrt{7},1) & =\\frac{12(1)}{(\\sqrt{7})^{2}-{1}^{2}}=2\\end{aligned}\n$$\n\nHence, the level curve that passes through $F(\\sqrt{7},1)$ is the $2$-level curve.\n\nRecall that the level curves for the function $f(x,y)$ are given by the equation\n\n$$\nf(x,y)=c.\n$$\n\nIn our case, we're interested in $c=2.$ So, we have:\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ \\frac{12y}{{x}^{2}-{y}^{2}} & =2 \\\\ 6y & ={x}^{2}-{y}^{2} \\\\ -{x}^{2}+{y}^{2}+6y & =0 \\\\ -{x}^{2}+{y}^{2}+6y+9 & =9 \\\\ -{x}^{2}+(y+3)^{2} & =9\\end{aligned}\n$$\n\nTherefore, the level curve that passes through $F(\\sqrt{7},1)$ is the hyperbola $-{x}^{2}+(y+3)^{2}=9.$" 13194139536086 17592186045417 true] [17592186565430 1068 17592186565342 13194139536086 17592186045417 true] [17592186565430 1069 "q-75235" 13194139536086 17592186045417 true] [17592186565430 1070 17592186045486 13194139536086 17592186045417 true] [17592186565430 1071 "Let $R=[0,4]\\times [0,4]$ be a region in the $xy$-plane, and let $f(x,y)=x+y+1.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{0,2,4\\},\\,{P}_{2}=\\{0,2,4\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the lower Riemann sum $L(f,P).$" 13194139536086 17592186045417 true] [17592186565430 1072 #uuid "559bc70c-78ac-5c05-9067-d915f9f4b231" 13194139536086 17592186045417 true] [17592186565430 1074 "First, let's draw the region $R$ and the partition $P.$\n\n![](images/29/293e79685a3f4da205d986bcf4331e4b4f43c0a48fe183d27f93aaee6bb17b99.png)\n\nThe lower sum $L(f,P)$ is given by\n\n$$\nL(f,P)={m}_{11}\\cdot \\text{Area}({R}_{11})+{m}_{21}\\cdot \\text{Area}({R}_{21})+{m}_{12}\\cdot \\text{Area}({R}_{12})+{m}_{22}\\cdot \\text{Area}({R}_{22})\n$$\n\nwhere ${m}_{ij}$ is the *minimum* value of $f$ in each subregion ${R}_{ij}.$ We pick the *minimum* value of $f$ because we're finding the *lower* sum.\n\nTaking into account the fact that $\\text{Area}({R}_{ij})=4$ for all $4$ subregions, the formula for $L(f,P)$ reduces to\n\n$$\nL(f,P)=4{m}_{11}+4{m}_{21}+4{m}_{12}+4{m}_{22}.\n$$\n\nNow, notice that\n\n- $f(x,y)=x+y+1$ increases as $x$ increases, and\n\n- $f(x,y)=x+y+1$ increases as $y$ increases.\n\n![](images/12/12df172e3a2f60a8b123937600d5774508ac8cb204696414690490be8d9e2c32.png)\n\nAs a result, the *minimum* value of $f$ in each subregion is attained when we have the *smallest* possible $x$ and the *smallest* possible $y.$ This is the value at the *bottom left corner* of each subregion.\n\n![](images/b5/b5e72e970d512740cc0d5de9e2d5739d71fb0c90e750c9874042ff4fa5230db9.png)\n\nHence:\n\n$$\n\\begin{aligned}{m}_{11} & =f(0,0)=1 \\\\ {m}_{21} & =f(2,0)=3 \\\\ {m}_{12} & =f(0,2)=3 \\\\ {m}_{22} & =f(2,2)=5\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}L(f,P) & =4\\cdot 1+4\\cdot 3+4\\cdot 3+4\\cdot 5 \\\\  & =48.\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565431 1068 17592186565346 13194139536086 17592186045417 true] [17592186565431 1069 "q-94322" 13194139536086 17592186045417 true] [17592186565431 1070 17592186045485 13194139536086 17592186045417 true] [17592186565431 1071 "A particle of mass $4\\,\\text{kg}$ is attached to a massless spring. The spring constant associated with the spring is $k=4\\,{\\text{kg/s}}^{2}.$  The particle is also subject to a resistive force that's proportional to the particle's velocity, and has a damping coefficient $c=2\\,\\text{kg/s}.$  The position of the particle is $y(t)$ (measured in meters), and $t>0$ is the time in seconds.  If the particle moves with damped harmonic motion, what is the governing equation?" 13194139536086 17592186045417 true] [17592186565431 1072 #uuid "56b1314a-ceaf-5db3-a203-e533e79bae7a" 13194139536086 17592186045417 true] [17592186565431 1074 "The equation of damped harmonic motion is\n\n$$\nm{y}^{″}=-c{y}^{′}-ky.\n$$\n\nSubstituting our values for $m,$ $k$ and $c$ gives\n\n$$\n4{y}^{″}=-2{y}^{′}-4y.\n$$\n\nRearranging the above equation, we get\n\n$$\n{y}^{″}+\\frac{1}{2}{y}^{′}+y=0.\n$$" 13194139536086 17592186045417 true] [17592186565432 1068 17592186565405 13194139536086 17592186045417 true] [17592186565432 1069 "q-74968" 13194139536086 17592186045417 true] [17592186565432 1070 17592186045486 13194139536086 17592186045417 true] [17592186565432 1071 "${lim}_{x\\to (0,0)}\\,\\frac{xy}{2{x}^{2}+3{y}^{2}}=$" 13194139536086 17592186045417 true] [17592186565432 1072 #uuid "585a757a-6bf9-546a-9bf9-80289d848f80" 13194139536086 17592186045417 true] [17592186565432 1074 "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0}:$\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{xy}{2{x}^{2}+3{y}^{2}}=\\frac{0\\cdot 0}{2\\cdot {0}^{2}+3\\cdot {0}^{2}}=\\frac{0}{0}\n$$\n\nHowever, the function cannot be simplified by canceling common factors in the numerator and denominator:\n\nLet's attempt to evaluate the limit approaching $(0,0)$ from different paths.\n\n- Taking $x\\to (0,0)$ along the path $y=x,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=x}\\,\\frac{xy}{2{x}^{2}+3{y}^{2}} & ={lim}_{x\\to 0}\\,\\frac{{x}^{2}}{2{x}^{2}+3{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\,\\frac{{x}^{2}}{5{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\,\\frac{1}{5} \\\\  & =\\frac{1}{5}.\\end{aligned}\n$$\n\n- Taking $x\\to (0,0)$ along the line $y=-x$,  we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=-x}\\,\\frac{xy}{2{x}^{2}+3{y}^{2}} & ={lim}_{x\\to 0}\\,\\frac{-{x}^{2}}{2{x}^{2}+3{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\,\\frac{-{x}^{2}}{5{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\,(-\\frac{1}{5}) \\\\  & =-\\frac{1}{5}.\\end{aligned}\n$$\n\nBecause the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{xy}{2{x}^{2}+3{y}^{2}}=\\text{DNE}\n$$" 13194139536086 17592186045417 true] [17592186565433 1068 17592186565396 13194139536086 17592186045417 true] [17592186565433 1069 "q-94303" 13194139536086 17592186045417 true] [17592186565433 1070 17592186045485 13194139536086 17592186045417 true] [17592186565433 1071 "Which of the following statements are true?\n\nI. ${y}^{″}+4{y}^{′}+y=0$ represents an oscillator undergoing light damping\n\nII. ${y}^{″}+4{y}^{′}+4y=0$ represents an oscillator undergoing critical damping\n\nIII. ${y}^{″}+3{y}^{′}+3y=0$ represents an oscillator undergoing heavy damping" 13194139536086 17592186045417 true] [17592186565433 1072 #uuid "5b04f6fb-738e-5fda-ac4b-d00fe6581051" 13194139536086 17592186045417 true] [17592186565433 1074 "Remember that, given the equation of a damped harmonic oscillator, the type of damping depends on the discriminant of the characteristic equation:\n\n- $D>0$ leads to heavy damping,\n\n- $D=0$ leads to critical damping, and\n\n- $D<0$ leads to light damping.\n\nWith that in mind, let's inspect each equation.\n\n- The differential equation ${y}^{″}+4{y}^{′}+y$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+4\\lambda +1=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={4}^{2}-4(1)(1) & =12>0.\\end{aligned}\n$$\n\nThus, the given equation represents heavy damping, and so statement I is false.\n\n- The differential equation ${y}^{″}+4{y}^{′}+4y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+4\\lambda +4=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={4}^{2}-4(1)(4) & =0.\\end{aligned}\n$$\n\nThus, the given equation represents critical damping, and so statement II is true.\n\n- The differential equation ${y}^{″}+3{y}^{′}+3y$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+3\\lambda +3=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={3}^{2}-4(1)(3) & =-3<0.\\end{aligned}\n$$\n\nThus, the given equation represents light damping, and so statement III is false.\n\nIn conclusion, the correct answer is \"II only\"." 13194139536086 17592186045417 true] [17592186565434 1068 17592186565351 13194139536086 17592186045417 true] [17592186565434 1069 "q-106075" 13194139536086 17592186045417 true] [17592186565434 1070 17592186045487 13194139536086 17592186045417 true] [17592186565434 1071 "Find a point that satisfies the mean value theorem for $f(x,y)={x}^{2}+y$ on the line segment $\\overset{―}{AB},$ where the position vectors of $A$ and $B$ are $a=⟨0,1⟩$ and $b=⟨1,3⟩,$ respectively." 13194139536086 17592186045417 true] [17592186565434 1072 #uuid "5c3d7252-78a8-50a4-b514-2643c3b47ad3" 13194139536086 17592186045417 true] [17592186565434 1074 "The mean value theorem states that if $f(x,y)$ is differentiable at each point on the line segment $\\overset{―}{AB},$ then there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that\n\n$$\nf(b)-f(a)=∇f(c)·(b-a).\n$$\n\nNotice that the function $f(x,y)={x}^{2}+y$ is differentiable at each point on the line segment $\\overset{―}{AB}.$ So, we can apply the mean value theorem.\n\nSubstituting $a=⟨0,1⟩$ and $b=⟨1,3⟩$ into the above expression, we get\n\n$$\n\\begin{aligned}f(1,3)-f(0,1) & =∇f(c)\\cdot (⟨1,3⟩-⟨0,1⟩) \\\\ ({1}^{2}+3)-({0}^{2}+1) & =∇f(c)\\cdot ⟨1,2⟩ \\\\ 3 & =∇f(c)\\cdot ⟨1,2⟩.\\end{aligned}\n$$\n\nComputing $∇f$ and evaluating at $c=⟨{c}_{1},{c}_{2}⟩,$ we get \n\n$$\n\\begin{aligned}∇f & =⟨2x,1⟩, \\\\ ∇f(c) & =⟨2{c}_{1},1⟩.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}3 & =∇f⟨c⟩\\cdot ⟨1,2⟩ \\\\ 3 & =⟨2{c}_{1},1⟩\\cdot ⟨1,2⟩ \\\\ 3 & =2{c}_{1}+2 \\\\ 1 & =2{c}_{1} \\\\ {c}_{1} & =\\frac{1}{2}.\\end{aligned}\n$$\n\nNow, we use the fact that $C$ lies on $\\overset{―}{AB}.$ So, let's first find the equation of the line.\n\n$$\n\\begin{aligned}\\frac{y-{y}_{a}}{{y}_{b}-{y}_{a}} & =\\frac{x-{x}_{a}}{{x}_{b}-{x}_{a}} \\\\ \\frac{y-1}{3-1} & =\\frac{x-0}{1-0} \\\\ \\frac{y-1}{2} & =x \\\\ y & =2x+1.\\end{aligned}\n$$\n\nSince $c=⟨{c}_{1},{c}_{2}⟩$ satisfies the equation of the line, we have\n\n$$\n\\begin{aligned}{c}_{2} & =2{c}_{1}+1.\\end{aligned}\n$$\n\nFinally, taking into account that ${c}_{1}=\\frac{1}{2},$ we obtain that ${c}_{2}=2\\cdot \\frac{1}{2}+1=2.$ So, the point $C$ that satisfies the mean value theorem is $(\\frac{1}{2},2).$" 13194139536086 17592186045417 true] [17592186565435 1068 17592186565356 13194139536086 17592186045417 true] [17592186565435 1068 17592186565393 13194139536086 17592186045417 true] [17592186565435 1069 "q-181417" 13194139536086 17592186045417 true] [17592186565435 1070 17592186045487 13194139536086 17592186045417 true] [17592186565435 1071 "Find the solution to the inequality $\\frac{x+6}{4}>\\frac{2x}{3}.$\n\nThe solution is $x$\n{{field-1}}{{field-2}}." 13194139536086 17592186045417 true] [17592186565435 1072 #uuid "5cd68e49-7c20-564f-9257-0043b16b7cd5" 13194139536086 17592186045417 true] [17592186565435 1074 "First, we clear the rational expressions by multiplying both sides of the inequality by the lowest common positive multiple of the denominators:\n\n$$\n\\begin{aligned}\\frac{x+6}{4} & >\\frac{2x}{3} \\\\ 12\\cdot (\\frac{x+6}{4}) & >12\\cdot (\\frac{2x}{3}) \\\\ 3\\cdot (x+6) & >4\\cdot 2x \\\\ 3x+18 & >8x\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles. \n\nRemember, when we divide an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}3x+18 & >8x \\\\ 3x+18-8x & >8x-8x \\\\ 18-5x & >0 \\\\ 18-5x-18 & >0-18 \\\\ -5x & >-18 \\\\ \\frac{-5x}{-5} & \\,\\,<\\,\\,\\frac{-18}{-5} \\\\ x & <\\frac{18}{5}\\end{aligned}\n$$\n\nTherefore, the solution is $x<\\frac{18}{5}.$" 13194139536086 17592186045417 true] [17592186565436 1068 17592186565353 13194139536086 17592186045417 true] [17592186565436 1069 "q-103610" 13194139536086 17592186045417 true] [17592186565436 1070 17592186045485 13194139536086 17592186045417 true] [17592186565436 1071 "![](images/1f/1f7a49cdcbca9c5488c7e607f68aa161de67d9b1ff7c654afe6dafaafc3f18f4.png)\n\nWhich of the above could be the graph of $y=\\sqrt{x}?$" 13194139536086 17592186045417 true] [17592186565436 1072 #uuid "5e519634-3084-59a8-9ded-27e7f0393295" 13194139536086 17592186045417 true] [17592186565436 1074 "Let's recall some of the basic properties of $y=\\sqrt{x}.$\n\n- The point $(0,0)$ lies on the graph\n\n- Its domain is $x\\in [0,\\infty )$\n\n- Its range is $y\\in [0,\\infty )$\n\n- The function is increasing over its entire domain.\n\n- As $x\\to \\infty $, we have $y\\to \\infty ,$ though it does so slowly\n\nNone of the given options have all of the above properties. Therefore, none of the given functions is the graph of $y=\\sqrt{x}.$" 13194139536086 17592186045417 true] [17592186565437 1068 17592186565395 13194139536086 17592186045417 true] [17592186565437 1069 "q-81915" 13194139536086 17592186045417 true] [17592186565437 1070 17592186045485 13194139536086 17592186045417 true] [17592186565437 1071 "![](images/8f/8f4a991a9da8b339bf2af1085787ba18227ee0926b1c280d8f3173f86c0713c8.png)\n\nCalculate the height $h$ of the cylinder above given that its volume is $32\\pi \\,{\\text{m}}^{3}$ and its radius is $2\\,\\text{m}.$" 13194139536086 17592186045417 true] [17592186565437 1072 #uuid "5eb29534-af26-5796-a547-b3d37b08dcde" 13194139536086 17592186045417 true] [17592186565437 1074 "The volume of a cylinder with radius $r$ and height $h$ is given by\n\n$$\nV=\\pi {r}^{2}h.\n$$\n\nSubstituting $V=32\\pi \\,{\\text{m}}^{3}$ and $r=2\\,\\text{m}$ into the formula and solving for $r,$ we get\n\n$$\n\\begin{aligned}V & =\\pi {r}^{2}h \\\\ 32\\pi  & =\\pi (2)^{2}h \\\\ 4\\pi h & =32\\pi  \\\\ h & =8\\,\\text{m}.\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565438 1068 17592186565401 13194139536086 17592186045417 true] [17592186565438 1069 "q-129324" 13194139536086 17592186045417 true] [17592186565438 1070 17592186045485 13194139536086 17592186045417 true] [17592186565438 1071 "Determine ${lim}_{x\\to (-2,0)}(2x-y+3).$" 13194139536086 17592186045417 true] [17592186565438 1072 #uuid "6491bac7-604f-53bc-80e6-378575a48cb4" 13194139536086 17592186045417 true] [17592186565438 1074 "Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=2x-y+3.\n$$\n\nThe function $f(x,y)$ is continuous for all values of $x$ and $y.$ So, we can calculate the limit by substituting $(-2,0)$ into the function:\n\n$$\n\\begin{aligned}{lim}_{x\\to (-2,0)}(2x-y+3) & =2(-2)-0+3 \\\\  & =-4-0+3 \\\\  & =-1\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565439 1068 17592186565381 13194139536086 17592186045417 true] [17592186565439 1069 "q-161635" 13194139536086 17592186045417 true] [17592186565439 1070 17592186045486 13194139536086 17592186045417 true] [17592186565439 1071 "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,{x}^{2}+(y+2)^{2}\\le 4,\\,x\\ge 0,\\,0\\le z\\le \\sqrt{{x}^{2}+{y}^{2}}\\},\n$$\n\nthen ${∭}_{R}z({x}^{2}-{y}^{2})\\,\\text{d}V=$" 13194139536086 17592186045417 true] [17592186565439 1072 #uuid "66285a95-784c-5363-bee3-101afc12cafb" 13194139536086 17592186045417 true] [17592186565439 1074 "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/2f/2f36451290eda3db5221e1a5fdbc1647bbedafa97cd47e22d5523d457c4cb83e.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $2$ whose axis passes through the point $(0,-2)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z=\\sqrt{{x}^{2}+{y}^{2}}=r.$\n\nWith that in mind, let's now write the ${x}^{2}+(y+2)^{2}=4$ in polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+(y+2)^{2} & =4 \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta +2)^{2} & =4 \\\\ {r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta +4r\\operatorname{sin}⁡\\theta +4 & =4 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+4r\\operatorname{sin}⁡\\theta  & =0 \\\\ {r}^{2}+4r\\operatorname{sin}⁡\\theta  & =0 \\\\ r(r+4\\operatorname{sin}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=-4\\operatorname{sin}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le -4\\operatorname{sin}⁡\\theta ,\\,\\frac{3\\pi }{2}\\le \\theta \\le 2\\pi ,\\,0\\le z\\le r\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}z({x}^{2}-{y}^{2})\\,\\text{d}V & ={∭}_{Δ}z({(r\\operatorname{cos}⁡\\theta )}^{2}-{(r\\operatorname{sin}⁡\\theta )}^{2})\\cdot r\\,dz\\,dr\\,d\\theta  \\\\  & ={∭}_{Δ}{r}^{3}z({cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta )\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{3\\pi /2}^{2\\pi }{\\int }_{0}^{-4\\operatorname{sin}⁡\\theta }{\\int }_{0}^{r}{r}^{3}z\\operatorname{cos}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565440 1068 17592186565376 13194139536086 17592186045417 true] [17592186565440 1069 "q-161614" 13194139536086 17592186045417 true] [17592186565440 1070 17592186045487 13194139536086 17592186045417 true] [17592186565440 1071 "The region $R$ is enclosed inside the cylinder ${x}^{2}+{y}^{2}=4$ for $y\\le 0,$ between the surfaces $z=0$ and $z={x}^{2}+{y}^{2}+9.$ Express the following triple integral in cylindrical polar coordinates. \n\n$$\n{∭}_{R}\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}+1}}\\,\\text{d}V\n$$" 13194139536086 17592186045417 true] [17592186565440 1072 #uuid "6699d568-4112-5bd7-abf4-a27c0cbde6ce" 13194139536086 17592186045417 true] [17592186565440 1074 "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/35/350b2dc98a09957c17f1ab629e21021c30fcccd9443068c722fe7565f04dcbfe.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $2$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z={x}^{2}+{y}^{2}+9={r}^{2}+9.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 2,\\,\\pi \\le \\theta \\le 2\\pi ,\\,0\\le z\\le {r}^{2}+9\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}+1}}\\,\\text{d}V & ={∭}_{Δ}\\frac{1}{\\sqrt{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}+1}}\\cdot r\\,dz\\,dr\\,d\\theta  \\\\  & ={∭}_{Δ}\\frac{r}{\\sqrt{{r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta +1}}\\,dz\\,dr\\,d\\theta  \\\\  & ={∭}_{Δ}\\frac{r}{\\sqrt{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+1}}\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{2}{\\int }_{0}^{{r}^{2}+9}\\frac{r}{\\sqrt{{r}^{2}+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565441 1068 17592186565329 13194139536086 17592186045417 true] [17592186565441 1069 "q-122978" 13194139536086 17592186045417 true] [17592186565441 1070 17592186045487 13194139536086 17592186045417 true] [17592186565441 1071 "Let $P=\\{{y}_{0},{y}_{1},…,{y}_{n}\\}$ be a partition of the interval $[-8,-1].$ If $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ calculate ${\\sum }_{j=1}^{n}6Δ{y}_{j}.$" 13194139536086 17592186045417 true] [17592186565441 1072 #uuid "6f562602-9739-513b-8ce5-9ee1b6ec86ba" 13194139536086 17592186045417 true] [17592186565441 1074 "First, we take the factor $6$ outside the summation:\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}6Δ{y}_{j}=6{\\sum }_{j=1}^{n}Δ{y}_{j}\\end{aligned}\n$$\n\nNote that ${\\sum }_{j=1}^{n}Δ{y}_{j}$ is just the length of the interval $[-8,-1],$ because\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}Δ{y}_{j} & =({y}_{1}-{y}_{0})+({y}_{2}-{y}_{1})+({y}_{3}-{y}_{2})+⋯+({y}_{n}-{y}_{n-1}) \\\\  & =(\\cancel{{y}_{1}}-{y}_{0})+(\\cancel{{y}_{2}}-\\cancel{{y}_{1}})+(\\cancel{{y}_{3}}-\\cancel{{y}_{2}})+⋯+({y}_{n}-\\cancel{{y}_{n-1}}) \\\\  & =-{y}_{0}+{y}_{n} \\\\  & ={y}_{n}-{y}_{0} \\\\  & =(-1)-(-8) \\\\  & =8-1 \\\\  & =7.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n6{\\sum }_{j=1}^{n}Δ{y}_{j}=6\\cdot 7=42.\n$$" 13194139536086 17592186045417 true] [17592186565442 1068 17592186565341 13194139536086 17592186045417 true] [17592186565442 1069 "q-122939" 13194139536086 17592186045417 true] [17592186565442 1070 17592186045485 13194139536086 17592186045417 true] [17592186565442 1071 "Which of the following are partitions of the real interval $[3,9]?$\n\nI. $\\{3,5,8,9\\}$\n\nII. $3<4<6<7<8$\n\nIII. $\\{1,3,4,8,9\\}$" 13194139536086 17592186045417 true] [17592186565442 1072 #uuid "7147d280-b22a-57e1-b370-a9886ed9abe3" 13194139536086 17592186045417 true] [17592186565442 1074 "A partition $P$ of a closed interval $[a,b]$ is a finite sequence of real numbers taken from $[a,b]$ such that\n\n$$\na={x}_{0}<{x}_{1}<{x}_{2}<…<{x}_{n}=b\\,.\n$$\n\nWe can express $P$ using set notation as\n\n$$\nP=\\{{x}_{0},{x}_{1},…,{x}_{n}\\}.\n$$\n\n \n\nWith that in mind, let's consider each statement:\n\n- Statement I is a partition of $[3,9].$\n\n- Statement II is not a partition of $[3,9]$  since it does not include the right endpoint $b=9.$\n\n- Statement III is not a partition of $[3,9]$ since $1$ does not belong to $[3,9].$\n\nTherefore, the correct answer is \"I only.\"" 13194139536086 17592186045417 true] [17592186565443 1068 17592186565389 13194139536086 17592186045417 true] [17592186565443 1069 "q-46970" 13194139536086 17592186045417 true] [17592186565443 1070 17592186045485 13194139536086 17592186045417 true] [17592186565443 1071 "Compute ${lim}_{x\\to {0}^{+}}\\,\\frac{9}{12{x}^{4}}.$" 13194139536086 17592186045417 true] [17592186565443 1072 #uuid "7a8882e4-c45a-5dc1-b53b-97925de4eb41" 13194139536086 17592186045417 true] [17592186565443 1074 "First, we simplify the limit:\n\n$$\n{lim}_{x\\to {0}^{+}}\\frac{9}{12{x}^{4}}={lim}_{x\\to {0}^{+}}\\frac{3}{4{x}^{4}}\n$$\n\nThen, we use the algebra of limits to pull out the constant factor of $\\frac{3}{4}:$\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}\\frac{3}{4{x}^{4}} & ={lim}_{x\\to {0}^{+}}\\frac{3}{4}\\cdot \\frac{1}{{x}^{4}} \\\\  & =\\frac{3}{4}\\cdot {lim}_{x\\to {0}^{+}}\\frac{1}{{x}^{4}}\\end{aligned}\n$$\n\nWe recall the graph of the function $y=\\frac{1}{{x}^{4}}$\n\n![](images/fa/fa92c457186fbdf71552ec79c782af7983e6fa09009e7f0efdd02b8f74e3ab98.png)\n\nFrom the graph, we see that\n\n$$\n{lim}_{x\\to ({0}^{+})}\\frac{1}{{x}^{4}}=\\infty \n$$\n\nThe positive factor of $\\frac{3}{4}$ does not change the sign of the limit. Therefore, we conclude that\n\n$$\n\\frac{3}{4}\\cdot {lim}_{x\\to {0}^{+}}\\frac{1}{{x}^{4}}=\\infty .\n$$" 13194139536086 17592186045417 true] [17592186565444 1068 17592186565400 13194139536086 17592186045417 true] [17592186565444 1069 "q-334193" 13194139536086 17592186045417 true] [17592186565444 1070 17592186045487 13194139536086 17592186045417 true] [17592186565444 1071 "Evaluate the following limit:\n\n${lim}_{x\\to -\\infty }\\frac{-4}{({x}^{2}-3)^{3}}=$\n{{field-1}}" 13194139536086 17592186045417 true] [17592186565444 1072 #uuid "8006767d-6578-52a2-aa78-8300e8ed36b3" 13194139536086 17592186045417 true] [17592186565444 1074 "First, we rewrite our limit using the algebra of limits, as follows:\n\n$$\n{lim}_{x\\to -\\infty }\\frac{-4}{({x}^{2}-3)^{3}}=-4\\cdot {lim}_{x\\to -\\infty }\\frac{1}{({x}^{2}-3)^{3}}\n$$\n\nFor any non-constant polynomial $P(x),$ we have\n\n$$\n{lim}_{x\\to \\pm \\infty }(\\frac{1}{P(x)})=0.\n$$\n\nTherefore, since $({x}^{2}-3)^{3}$ is a non-constant polynomial, we have\n\n$$\n{lim}_{x\\to -\\infty }\\frac{1}{({x}^{2}-3)^{3}}=0.\n$$\n\nFinally, we can evaluate the original limit as follows:\n\n$$\n-4\\cdot {lim}_{x\\to -\\infty }\\frac{1}{({x}^{2}-3)^{3}}=-4\\cdot 0=0\n$$" 13194139536086 17592186045417 true] [17592186565445 1068 17592186565375 13194139536086 17592186045417 true] [17592186565445 1069 "q-106782" 13194139536086 17592186045417 true] [17592186565445 1070 17592186045487 13194139536086 17592186045417 true] [17592186565445 1071 "Consider the following polynomials:\n\n$$\n{p}_{1}(t)=2-t,\\,{p}_{2}(t)=3-2{t}^{2},\\,q(t)=3t-4{t}^{2}.\n$$\n\nIf $B=\\{{p}_{1}(t),{p}_{2}(t)\\}$ is a basis of $\\text{Span}\\{{p}_{1}(t),{p}_{2}(t)\\},$ and $[q(t)]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" 13194139536086 17592186045417 true] [17592186565445 1072 #uuid "881394e4-d1e2-502e-8f1c-cafafb97686c" 13194139536086 17592186045417 true] [17592186565445 1074 "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{p}_{1}(t)+{x}_{2}{p}_{2}(t)=q(t)\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}(2-t)+{x}_{2}(3-2{t}^{2}) & =3t-4{t}^{2} \\\\ (2{x}_{1}+3{x}_{2})-{x}_{1}t-2{x}_{2}{t}^{2} & =3t-4{t}^{2}.\\end{aligned}\n$$\n\nEquating the coefficients of $t$, we obtain\n\n$$\n\\{\\begin{aligned}2{x}_{1}+3{x}_{2}=0 \\\\ -{x}_{1}=3 \\\\ -2{x}_{2}=-4.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}2 & 3 & 0 \\\\ -1 & 0 & 3 \\\\ 0 & -2 & -4\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}2 & 3 & 0 \\\\ -1 & 0 & 3 \\\\ 0 & -2 & -4\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\ ∼ & [\\begin{aligned}-1 & 0 & 3 \\\\ 2 & 3 & 0 \\\\ 0 & -2 & -4\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\ ∼ & [\\begin{aligned}-1 & 0 & 3 \\\\ 0 & 3 & 6 \\\\ 0 & -2 & -4\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}-{x}_{1}=3 \\\\ 3{x}_{2}=6 \\\\ -2{x}_{2}=-4.\\end{aligned}\n$$\n\nFrom the second and third equations we get ${x}_{2}=2.$ From the  first equation, we obtain ${x}_{1}=-3.$\n\nTherefore, $[q(t)]_{B}=[\\begin{aligned}-3 \\\\ 2\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=-3+2=-1.$" 13194139536086 17592186045417 true] [17592186565446 1068 17592186565387 13194139536086 17592186045417 true] [17592186565446 1069 "q-177452" 13194139536086 17592186045417 true] [17592186565446 1070 17592186045485 13194139536086 17592186045417 true] [17592186565446 1071 "$\\sqrt{5}$ is rational, **or** $3|12$ **and** $3|18.$\n\nExpress the compound statement above in symbolic form given the following notations:\n\n- $P:\\sqrt{5}\\text{ is rational}$\n\n- $Q:3|12$\n\n- $R:3|18\\text{ }$" 13194139536086 17592186045417 true] [17592186565446 1072 #uuid "9036632e-a4e5-591e-b6d4-bd5830e984df" 13194139536086 17592186045417 true] [17592186565446 1074 "The word \"and\" is represented by the symbol \"$∧$\", while the word \"or\" is represented by the symbol \"$∨$\".\n\nNote that this sentence consists of two parts:\n\n- **Part 1:** $\\sqrt{5}$ is rational. This corresponds to $P.$\n\n- **Part 2:** $3|12$ and $3|18.$ This corresponds to\n\n$$\n{{3|12}_{⏟}}_{Q}\\,{{\\text{and}}_{⏟}}_{∧}\\,{{3|18}_{⏟}}_{R},\n$$\n\nthat is, $Q∧R.$\n\nSo, we can express the sentence as\n\n$$\n{{\\sqrt{5}\\text{ is rational}}_{⏟}}_{P}\\,{{\\text{or}}_{⏟}}_{∨}\\,{{3|12\\text{ and }3|18}_{⏟}}_{Q\\,∧\\,R},\n$$\n\nthat is, $P∨(Q∧R).$" 13194139536086 17592186045417 true] [17592186565447 1068 17592186565379 13194139536086 17592186045417 true] [17592186565447 1069 "q-305776" 13194139536086 17592186045417 true] [17592186565447 1070 17592186045486 13194139536086 17592186045417 true] [17592186565447 1071 "Evaluate the following limit:\n\n${lim}_{x\\to {5}^{-}}(-\\frac{9}{4(x-5)^{6}})=$\n{{field-1}}" 13194139536086 17592186045417 true] [17592186565447 1072 #uuid "940dd7e5-a02e-5ae8-8d31-37203bbfab5d" 13194139536086 17592186045417 true] [17592186565447 1074 "First, we rewrite the limit using the algebra of limits, as follows:\n\n$$\n{lim}_{x\\to {5}^{-}}(-\\frac{9}{4(x-5)^{6}})\\,=\\,-\\frac{9}{4}\\,\\cdot \\,{lim}_{x\\to {5}^{-}}\\frac{1}{(x-5)^{6}}.\n$$\n\nNow, we can sketch the graph of $y=\\frac{1}{(x-5)^{6}}$ as follows:\n\n1\\. Take the graph of $y=\\frac{1}{{x}^{6}}.$\n\n2\\. Translate it to the right by $5$ units. This gives $y=\\frac{1}{(x-5)^{6}},$ as shown below.\n\n![](images/57/574b270248f2acc2a2eb3403f5626e420f5f16abc6e9e01dcb147df83e5806b5.png)\n\nFrom the graph, we see that\n\n$$\n{lim}_{x\\to {5}^{-}}\\frac{1}{(x-5)^{6}}=\\infty .\n$$\n\nFinally, the negative factor of $-\\frac{9}{4}$ changes the sign of the limit. Therefore, we conclude that\n\n$$\n-\\frac{9}{4}\\cdot {lim}_{x\\to {5}^{-}}\\frac{1}{(x-5)^{6}}=-\\infty .\n$$" 13194139536086 17592186045417 true] [17592186565448 1068 17592186565336 13194139536086 17592186045417 true] [17592186565448 1069 "q-342816" 13194139536086 17592186045417 true] [17592186565448 1070 17592186045486 13194139536086 17592186045417 true] [17592186565448 1071 "Consider the following initial value problem:\n\n$$\n\\frac{\\text{d}y}{\\text{d}t}-3y={u}_{\\pi /4}(t)\\cdot cos\\,(4t-\\pi )\\,,\\,y(0)=1,\n$$\n\nwhere ${u}_{\\pi /4}(t)=u\\,(t-\\frac{\\pi }{4})$ is the unit step function.\n\nYou're given that the Laplace transform $Y(s)=L\\{y(t)\\}$ is\n\n$$\nY(s)=\\frac{1}{s-3}+\\frac{s\\,{e}^{-\\pi s/4}}{({s}^{2}+16)(s-3)}\n$$\n\nand that the solution to the initial value problem can be expressed as \n\n$$\ny(t)={e}^{3t}+\\frac{1}{25}u\\,(t-\\frac{\\pi }{4})\\cdot g(t).\n$$\n\nFind the function $g(t).$ \n\nHint: You may make use of the following results:\n\n$$\nL\\{\\operatorname{sin}⁡\\omega t\\}=\\frac{\\omega }{{s}^{2}+{\\omega }^{2}},\\,L\\{\\operatorname{cos}⁡\\omega t\\}=\\frac{s}{{s}^{2}+{\\omega }^{2}},\\,s>0.\n$$" 13194139536086 17592186045417 true] [17592186565448 1072 #uuid "9876167b-d3d3-5f4c-9305-b455d21b66dc" 13194139536086 17592186045417 true] [17592186565448 1074 "To solve the initial value problem, we need to compute the inverse Laplace transform of $Y(s).$\n\nTo find the inverse transform, we first ignore the exponential term ${e}^{-\\pi s/4}$ (which corresponds to a time shift) and focus on the rational function part:\n\n$$\nF(s)=\\frac{s}{({s}^{2}+16)(s-3)}.\n$$\n\nWe'll solve this in three steps.\n\n**Step 1.** Partial fraction decomposition\n\nSince the denominator contains a linear factor $(s-3)$ and an irreducible quadratic factor $({s}^{2}+16),$ the decomposition takes the form\n\n$$\n\\frac{s}{({s}^{2}+16)(s-3)}=\\frac{A}{s-3}+\\frac{Bs+C}{{s}^{2}+16}.\n$$\n\nTo find the constants, we clear the denominators:\n\n$$\ns=A({s}^{2}+16)+(Bs+C)(s-3).\n$$\n\nNow, we find the constants $A,B,$ and $C.$\n\n- Setting $s=3,$ we have\n\n$$\n3=A({3}^{2}+16)+0\\,⟹\\,25A=3\\,⟹\\,A=\\frac{3}{25}.\n$$\n\n- Comparing the coefficients of ${s}^{2},$ we have\n\n$$\n0=A+B\\,⟹\\,B=-A=-\\frac{3}{25}.\n$$\n\n- Comparing the constant terms, we have\n\n$$\n0=16A-3C\\,⟹\\,0=16\\,(\\frac{3}{25})-3C\\,⟹\\,C=\\frac{16}{25}.\n$$\n\nThus, we can rewrite $F(s)$ as\n\n$$\nF(s)=\\frac{1}{25}(\\frac{3}{s-3}-3\\cdot \\frac{s}{{s}^{2}+16}+4\\cdot \\frac{4}{{s}^{2}+16}).\n$$\n\n**Step 2.** Finding the Inverse of the base function\n\nWe find the inverse transform $f(t)={L}^{-1}\\{F(s)\\}$ using standard transforms:\n\n$$\n\\begin{aligned}f(t) & =\\frac{1}{25}(3\\cdot {L}^{-1}\\{\\frac{1}{s-3}\\}-3\\cdot {L}^{-1}\\{\\frac{s}{{s}^{2}+16}\\}+4\\cdot {L}^{-1}\\{\\frac{4}{{s}^{2}+16}\\}) \\\\  & =\\frac{1}{25}(3{e}^{3t}-3\\operatorname{cos}⁡(4t)+4\\operatorname{sin}⁡(4t))\\end{aligned}\n$$\n\n**Step 3.** Applying the time-shifting property\n\nFinally, we address the ${e}^{-\\pi s/4}$ term. By the second shifting theorem, we have\n\n$$\n{e}^{-as}\\cdot F(s)=L\\{u(t-a)\\cdot f(t-a)\\}.\n$$\n\nTaking the inverse Laplace transform gives\n\n$$\n{L}^{-1}\\{{e}^{-as}F(s)\\}=u(t-a)\\cdot f(t-a).\n$$\n\nIn our case, $a=\\frac{\\pi }{4}.$ Therefore, we shift $f(t)$ by replacing every instance of $t$ with $(t-\\frac{\\pi }{4}):$\n\n$$\n\\begin{aligned}y(t) & =u\\,(t-\\frac{\\pi }{4})f\\,(t-\\frac{\\pi }{4}) \\\\  & =u\\,(t-\\frac{\\pi }{4})\\cdot \\frac{1}{25}[3{e}^{3(t-\\pi /4)}-3\\operatorname{cos}⁡(4\\,(t-\\frac{\\pi }{4}))+4\\operatorname{sin}⁡(4\\,(t-\\frac{\\pi }{4}))].\\end{aligned}\n$$\n\nUsing the trigonometric identities $cos\\,(4\\,(t-\\frac{\\pi }{4}))=-\\operatorname{cos}⁡(4t)$ and $sin\\,(4\\,(t-\\frac{\\pi }{4}))=-\\operatorname{sin}⁡(4t),$ we simplify:\n\n$$\n\\begin{aligned}y(t) & =u\\,(t-\\frac{\\pi }{4})\\cdot \\frac{1}{25}(3{e}^{3(t-\\pi /4)}+3\\operatorname{cos}⁡(4t)-4\\operatorname{sin}⁡(4t)) \\\\  & =\\frac{1}{25}\\,u\\,(t-\\frac{\\pi }{4})(3{e}^{3(t-\\pi /4)}+3\\operatorname{cos}⁡(4t)-4\\operatorname{sin}⁡(4t)).\\end{aligned}\n$$\n\nComparing this to the second term of the form given in the problem statement $y(t)={e}^{3t}+\\frac{1}{25}u\\,(t-\\frac{\\pi }{4})\\cdot g(t),$ we identify $g(t)$ as\n\n$$\ng(t)=3{e}^{3(t-\\pi /4)}+3\\operatorname{cos}⁡(4t)-4\\operatorname{sin}⁡(4t).\n$$" 13194139536086 17592186045417 true] [17592186565449 1068 17592186565352 13194139536086 17592186045417 true] [17592186565449 1069 "q-339978" 13194139536086 17592186045417 true] [17592186565449 1070 17592186045487 13194139536086 17592186045417 true] [17592186565449 1071 "Given that $y=-3\\operatorname{ln}⁡x+{10}^{x}-1$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$ \n{{field-1}}" 13194139536086 17592186045417 true] [17592186565449 1072 #uuid "a201ee06-61a2-5773-8a24-56af686eb568" 13194139536086 17592186045417 true] [17592186565449 1074 "Taking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-3\\operatorname{ln}⁡x+{10}^{x}-1) \\\\  & =-3(\\frac{1}{x})+{10}^{x}\\operatorname{ln}⁡(10) \\\\  & =-\\frac{3}{x}+{10}^{x}\\operatorname{ln}⁡(10).\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565450 1068 17592186565328 13194139536086 17592186045417 true] [17592186565450 1068 17592186565350 13194139536086 17592186045417 true] [17592186565450 1069 "q-181376" 13194139536086 17592186045417 true] [17592186565450 1070 17592186045486 13194139536086 17592186045417 true] [17592186565450 1071 "Find the solution to the inequality $\\frac{3-5z}{8}\\le 6-2z.$\n\nThe solution is $z$\n{{field-1}}{{field-2}}." 13194139536086 17592186045417 true] [17592186565450 1072 #uuid "a275c58b-24cd-59ec-af04-d47c2cd4c395" 13194139536086 17592186045417 true] [17592186565450 1074 "First, we clear the rational expression by multiplying both sides by $8:$\n\n$$\n\\begin{aligned}\\frac{3-5z}{8} & \\le 6-2z \\\\ 8\\cdot (\\frac{3-5z}{8}) & \\le 8\\cdot (6-2z) \\\\ \\cancel{8}\\cdot (\\frac{3-5z}{\\cancel{8}}) & \\le 8\\cdot (6-2z) \\\\ 3-5z & \\le 48-16z\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles:\n\n$$\n\\begin{aligned}3-5z & \\le 48-16z \\\\ 3-5z+16z & \\le 48-16z+16z \\\\ 3+11z & \\le 48 \\\\ 3+11z-3 & \\le 48-3 \\\\ 11z & \\le 45 \\\\ \\frac{11z}{11} & \\le \\frac{45}{11} \\\\ z & \\le \\frac{45}{11}\\end{aligned}\n$$\n\nTherefore, the solution is $z\\le \\frac{45}{11}.$" 13194139536086 17592186045417 true] [17592186565451 1068 17592186565386 13194139536086 17592186045417 true] [17592186565451 1069 "q-127094" 13194139536086 17592186045417 true] [17592186565451 1070 17592186045486 13194139536086 17592186045417 true] [17592186565451 1071 "Let $X$ be a random variable with the probability density function shown below. What are the modes of $X?$\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{6}(\\operatorname{cos}⁡(\\pi x)+2), & 0\\le x\\le 3 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565451 1072 #uuid "a321d767-b173-540f-8a02-df4dc515c060" 13194139536086 17592186045417 true] [17592186565451 1074 "The modes of a random variable $X$ with probability density function $f(x)$ are the values of $x$ at the global maxima of $f(x).$\n\nTo find the global maxima of $f(x),$ we find the critical points of $f(x)$ and then apply the candidates test.\n\nFirst, we find the critical points.\n\n- The piece of $f(x)$ defined on $0\\le x\\le 3$ is $f(x)=\\frac{1}{6}(\\operatorname{cos}⁡(\\pi x)+2).$ Taking the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =-\\frac{1}{6}\\pi \\operatorname{sin}⁡(\\pi x),\\end{aligned}\n$$\n\nand solving ${f}^{′}(x)=0,$ we get\n\n$$\n-\\frac{1}{6}\\pi \\operatorname{sin}⁡(\\pi x)=0\\,⟹\\,\\pi x=0+k\\pi \\,⟹\\,x=k,\n$$\n\nwhere $k$ is any integer.\nAmong these critical points, only four lie within the interval $[0,3].$ These are $x=0,1,2,3,$ so we keep them all.\n\n- The derivative doesn't exist at the endpoints $x=0,3.$ So, these are critical points as well, but they are included above.\n\nNow, we evaluate $f(x)$ at the critical points $x=0,1,2,3:$\n\n$$\n\\begin{aligned}f(0) & =\\frac{1}{6}(\\operatorname{cos}⁡(\\pi (0))+2)=\\frac{1}{2} \\\\ f(1) & =\\frac{1}{6}(\\operatorname{cos}⁡(\\pi (1))+2)=\\frac{1}{6} \\\\ f(2) & =\\frac{1}{6}(\\operatorname{cos}⁡(\\pi (2))+2)=\\frac{1}{2} \\\\ f(3) & =\\frac{1}{6}(\\operatorname{cos}⁡(\\pi (3))+2)=\\frac{1}{6}\\end{aligned}\n$$\n\nFinally, we compare all of the values above. The largest values are\n\n$$\nf(0)=f(2)=\\frac{1}{2}.\n$$\n\nTherefore, the modes of $X$ are $0$ and $2.$" 13194139536086 17592186045417 true] [17592186565452 1068 17592186565338 13194139536086 17592186045417 true] [17592186565452 1069 "q-52972" 13194139536086 17592186045417 true] [17592186565452 1070 17592186045485 13194139536086 17592186045417 true] [17592186565452 1071 "![](images/37/372ac1135e480bcd843f02b05bdeae42d462fccaced8151e4a355d6263d7be64.png)\n\nFind the value of $z$ in the triangle shown above." 13194139536086 17592186045417 true] [17592186565452 1072 #uuid "a323077c-5cf0-5ef0-a051-240e1171e494" 13194139536086 17592186045417 true] [17592186565452 1074 "First, from the diagram, notice that $∠CAB$ and $∠BAD$ are supplementary. Therefore,\n\n$$\n\\begin{aligned}m∠CAB+m∠BAD & ={180}^{∘} \\\\ m∠CAB+z & ={180}^{∘} \\\\ m∠CAB & ={180}^{∘}-z.\\end{aligned}\n$$\n\nSince $△ABC$ is an isosceles triangle where $\\overset{―}{AB}≅\\overset{―}{BC}$, the base angles must be equal:\n\n$$\nm∠C=m∠CAB.\n$$\n\nFinally, since the interior angles of any triangle sum to ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠CAB+m∠C+m∠B & ={180}^{∘} \\\\ 2m∠CAB+m∠B & ={180}^{∘} \\\\ 2({180}^{∘}-z)+{40}^{∘} & ={180}^{∘} \\\\ {360}^{∘}-2z+{40}^{∘} & ={180}^{∘} \\\\ 2z & ={220}^{∘} \\\\ z & ={110}^{∘}.\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565453 1068 17592186565385 13194139536086 17592186045417 true] [17592186565453 1069 "q-122987" 13194139536086 17592186045417 true] [17592186565453 1070 17592186045487 13194139536086 17592186045417 true] [17592186565453 1071 "Let $P=\\{{x}_{0},{x}_{1},…,{x}_{m}\\}$ be a partition of the interval $[3,8].$ If $Δ{x}_{i}={x}_{i}-{x}_{i-1},$ calculate ${\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i}.$" 13194139536086 17592186045417 true] [17592186565453 1072 #uuid "a66dfc35-4f40-599b-91f5-fb79cdcce84b" 13194139536086 17592186045417 true] [17592186565453 1074 "We can simplify the given summation as follows:\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i} & =({x}_{1}+{x}_{0})Δ{x}_{1}+({x}_{2}+{x}_{1})Δ{x}_{2}+⋯+({x}_{m}+{x}_{m-1})Δ{x}_{n} \\\\  & =({x}_{1}+{x}_{0})({x}_{1}-{x}_{0})+({x}_{2}+{x}_{1})({x}_{2}-{x}_{1})+⋯+({x}_{m}+{x}_{m-1})({x}_{m}-{x}_{m-1}) \\\\  & =({x}_{1}^{2}-{x}_{0}^{2})+({x}_{2}^{2}-{x}_{1}^{2})+⋯+({x}_{m}^{2}-{x}_{m-1}^{2}) \\\\  & =(\\cancel{{x}_{1}^{2}}-{x}_{0}^{2})+(\\cancel{{x}_{2}^{2}}-\\cancel{{x}_{1}^{2}})+⋯+({x}_{m}^{2}-\\cancel{{x}_{m-1}^{2}}) \\\\  & =-{x}_{0}^{2}+{x}_{m}^{2} \\\\  & ={x}_{m}^{2}-{x}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${x}_{0}=3$ and ${x}_{m}=8$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i} & ={x}_{m}^{2}-{x}_{0}^{2} \\\\  & ={8}^{2}-{3}^{2} \\\\  & =55.\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565454 1068 17592186565394 13194139536086 17592186045417 true] [17592186565454 1069 "q-21232" 13194139536086 17592186045417 true] [17592186565454 1070 17592186045486 13194139536086 17592186045417 true] [17592186565454 1071 "![](images/19/19ca38571817d9de8c92de17d5121c33ac1494848766033792dc9586c95fa475.png)\n\nIn the isosceles triangle $△ABC$  with base $\\overset{―}{AB}$, point $E$ lies on the side $\\overset{―}{BC}$, $\\overset{―}{AE}=\\overset{―}{EC}$ and $m∠EAC={40}^{∘}.$ What is the measure of $∠B?$" 13194139536086 17592186045417 true] [17592186565454 1072 #uuid "ae1938a1-58ee-571b-a544-d365ce409563" 13194139536086 17592186045417 true] [17592186565454 1074 "First, notice that $△ABC$ is an isosceles triangle with base $\\overset{―}{AB}.$ Consequently,  the base angles must have equal measure:\n\n$$\nm∠BAC=m∠B\n$$\n\nAlso, since $△CEA$ is an isosceles triangle, we have:\n\n$$\nm∠C=m∠EAC={40}^{∘}\n$$\n\nFinally, we calculate $m∠B$ using the fact that the interior angles of $△ABC$ sum to ${180}^{∘}:$\n\n$$\n\\begin{aligned}m∠BAC+m∠B+m∠C & ={180}^{∘} \\\\ m∠B+m∠B+{40}^{∘} & ={180}^{∘} \\\\ 2m∠B & ={140}^{∘} \\\\ m∠B & ={70}^{∘}\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565455 1068 17592186565349 13194139536086 17592186045417 true] [17592186565455 1069 "q-75231" 13194139536086 17592186045417 true] [17592186565455 1070 17592186045487 13194139536086 17592186045417 true] [17592186565455 1071 "Let $R=[0,1]\\times [1,3]$ be a region in the $xy$-plane, and let $f(x,y)=3x+y.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{0,1\\},\\,{P}_{2}=\\{1,2,3\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the lower Riemann sum $L(f,P).$" 13194139536086 17592186045417 true] [17592186565455 1072 #uuid "aebb283d-a6dd-5621-b2da-04fb6f0be9f3" 13194139536086 17592186045417 true] [17592186565455 1074 "First, let's draw the region $R$ and the partition $P.$\n\n![](images/c2/c2c33fe367e36506f949f1f76d84ccb2b3ff74ea3a4456e57982f489978225b3.png)\n\nThe lower sum $L(f,P)$ is given by\n\n$$\nL(f,P)={m}_{11}\\cdot \\text{Area}({R}_{11})+{m}_{12}\\cdot \\text{Area}({R}_{12})\n$$\n\nwhere ${m}_{ij}$ is the *minimum* value of $f$ in each subregion ${R}_{ij}.$ We pick the *minimum* value of $f$ because we're finding the *lower* sum.\n\nTaking into account the fact that $\\text{Area}({R}_{ij})=1$ for all $2$ subregions, the formula for $L(f,P)$ reduces to\n\n$$\nL(f,P)={m}_{11}+{m}_{12}.\n$$\n\nNow, notice that\n\n- $f(x,y)=3x+y$ increases as $x$ increases, and\n\n- $f(x,y)=3x+y$ increases as $y$ increases.\n\n![](images/3b/3bdc77445e75c7c74d6e242f9eb469687aa34384e7399b05607dfaa4a81ae596.png)\n\nAs a result, the *minimum* value of $f$ in each subregion is attained when we have the *smallest* possible $x$ and the *smallest* possible $y.$ This is the value at the *bottom left corner* of each subregion.\n\n![](images/ac/acded82358333752ba407673edf543262ee0b36166014c3de54d9beef9218a26.png)\n\nHence:\n\n$$\n\\begin{aligned}{m}_{11} & =f(0,1)=1 \\\\ {m}_{12} & =f(0,2)=2\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}L(f,P) & =1+2 \\\\  & =3.\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565456 1068 17592186565335 13194139536086 17592186045417 true] [17592186565456 1068 17592186565366 13194139536086 17592186045417 true] [17592186565456 1068 17592186565382 13194139536086 17592186045417 true] [17592186565456 1069 "q-178163" 13194139536086 17592186045417 true] [17592186565456 1070 17592186045485 13194139536086 17592186045417 true] [17592186565456 1071 "$$\n{{0\\text{ is even}}_{⏟}}_{P}\\,{{\\text{or}}_{⏟}}_{∨}\\,{{\\overset{Q}{\\overset{⏞}{\\{1,2\\}\\cap \\{1\\}=\\{1,2\\}}}\\,\\overset{∨}{\\overset{⏞}{\\text{or}}}\\,\\overset{R}{\\overset{⏞}{\\frac{2}{3}\\text{ is irrational}}}}_{⏟}}_{Q\\,∨\\,R}\n$$\n\nFor the compound statement above, we have that\n\n$\\,$ $P$ is {{field-1}},\n$\\,$ $Q∨R$ is {{field-2}},\n$\\,$ $P∨(Q∨R)$ is {{field-3}}." 13194139536086 17592186045417 true] [17592186565456 1072 #uuid "b08d6228-4d71-56ec-903b-067eaa383489" 13194139536086 17592186045417 true] [17592186565456 1074 "First, let's recall the following facts about the \"and\" $(∧)$ and \"or\" $(∨)$ logical connectives:\n\n- The statement $A∧B$ is true if *both* $A$ and $B$ are true.\n\n- The statement $A∨B$ is true if either $A$ is true, or $B$ is true, or *both* $A$ and $B$ are true.\n\nIn our case, $P$ is true, $Q$ is false, and $R$ is false. Therefore, $Q∨R$ is false, but the result is true:\n\n$$\n\\begin{aligned}P∨(Q∨R) & ≡\\text{true}∨\\overset{\\text{false}}{\\overset{⏞}{(\\text{false}∨\\text{false})}} \\\\  & ≡\\text{true}∨\\text{false} \\\\  & ≡\\text{true}\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565457 1068 17592186565384 13194139536086 17592186045417 true] [17592186565457 1069 "q-82230" 13194139536086 17592186045417 true] [17592186565457 1070 17592186045487 13194139536086 17592186045417 true] [17592186565457 1071 "Find an expression for the volume $V$ of a cylinder in terms of $r$ given that $\\frac{r}{h}=7,$ where $r$ is the radius of the base and $h$ is the height of the cylinder." 13194139536086 17592186045417 true] [17592186565457 1072 #uuid "b2ff9ba6-9b7a-53dd-94e6-0ac24157cb77" 13194139536086 17592186045417 true] [17592186565457 1074 "Our goal is to express $V$ in terms of $r.$ Therefore, we need to isolate $h$ in the above equation:\n\n$$\n\\begin{aligned}\\frac{r}{h} & =7 \\\\ r & =7h \\\\ \\frac{r}{7} & =h \\\\ h & =\\frac{r}{7}\\end{aligned}\n$$\n\nThe volume of a cylinder with radius $r$ and height $h$ is given by\n\n$$\nV=\\pi {r}^{2}h.\n$$\n\nTherefore, substituting $h=\\frac{r}{7}$ into the formula, we get\n\n$$\n\\begin{aligned}V & =\\pi {r}^{2}h \\\\  & =\\pi {r}^{2}\\cdot \\frac{r}{7} \\\\  & =\\frac{\\pi {r}^{3}}{7}.\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565458 1068 17592186565374 13194139536086 17592186045417 true] [17592186565458 1069 "q-70487" 13194139536086 17592186045417 true] [17592186565458 1070 17592186045485 13194139536086 17592186045417 true] [17592186565458 1071 "What is the trace in the $xz$-plane of the sphere ${x}^{2}+{y}^{2}+(z-1)^{2}=2?$" 13194139536086 17592186045417 true] [17592186565458 1072 #uuid "b46dd9b0-6a80-5531-9884-f4687e775cb2" 13194139536086 17592186045417 true] [17592186565458 1074 "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the sphere:\n\n$$\n\\begin{aligned}{x}^{2}+(0)^{2}+(z-1)^{2}=2 \\\\ {x}^{2}+(z-1)^{2}=2\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565459 1068 17592186565373 13194139536086 17592186045417 true] [17592186565459 1069 "q-21222" 13194139536086 17592186045417 true] [17592186565459 1070 17592186045487 13194139536086 17592186045417 true] [17592186565459 1071 "![](images/c6/c62f51c2b029d6b1e24e7f30603c5f34ab5d70d96ed84c5c74de15d4e2e6358e.png)\n\nWhat is the measure of $∠D?$" 13194139536086 17592186045417 true] [17592186565459 1072 #uuid "b85bf70e-60cf-531c-93a8-54cd5e2b47c0" 13194139536086 17592186045417 true] [17592186565459 1074 "First, notice that $△ABC$ is an equilateral triangle. Consequently, all of the interior angles must be equal to ${60}^{∘}:$ \n\n$$\nm∠A=m∠B=m∠ABC={60}^{∘}\n$$\n\nAlso, since $△CDB$ is an isosceles triangle, the base angles must have equal measure:\n\n$$\nm∠CBD=m∠D\n$$\n\nNotice also that $∠ACB$ and $∠DCB$ are supplementary, therefore, we obtain\n\n$$\n\\begin{aligned}m∠ACB+m∠DCB & ={180}^{∘} \\\\ {60}^{∘}+m∠DCB & ={180}^{∘} \\\\ m∠DCB & ={120}^{∘}.\\end{aligned}\n$$\n\n Finally, we calculate $m∠D$ using the fact that the interior angles of a triangle sum to ${180}^{∘}:$\n\n$$\n\\begin{aligned}m∠D+m∠DCB+m∠CBD & ={180}^{∘} \\\\ m∠D+{120}^{∘}+m∠D & ={180}^{∘} \\\\ 2m∠D & ={60}^{∘} \\\\ m∠D & ={30}^{∘}\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565460 1068 17592186565408 13194139536086 17592186045417 true] [17592186565460 1069 "q-64729" 13194139536086 17592186045417 true] [17592186565460 1070 17592186045487 13194139536086 17592186045417 true] [17592186565460 1071 "Given the ellipse $\\frac{(x-2)^{2}}{10}+\\frac{(y+1)^{2}}{10}+\\frac{(z-1)^{2}}{2}=1$, find its intercepts with the $y$-axis." 13194139536086 17592186045417 true] [17592186565460 1072 #uuid "be1595d6-b16a-5715-995c-d3645afe8a1e" 13194139536086 17592186045417 true] [17592186565460 1074 "To find the $y$-intercepts, we plug $x=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(0-2)^{2}}{10}+\\frac{(y+1)^{2}}{10}+\\frac{(0-1)^{2}}{2} & =1 \\\\ \\frac{2}{5}+\\frac{(y+1)^{2}}{10}+\\frac{1}{2} & =1 \\\\ \\frac{(y+1)^{2}}{10} & =\\frac{1}{10} \\\\ (y+1)^{2} & =1 \\\\ y+1 & =\\pm 1 \\\\ y & =-1\\pm 1\\end{aligned}\n$$\n\nHence, we get the solutions $y=-2$ and $y=0.$\n\nTherefore, the intercepts with the $y$-axis are $(0,-2,0)$ and $(0,0,0).$" 13194139536086 17592186045417 true] [17592186565461 1068 17592186565339 13194139536086 17592186045417 true] [17592186565461 1069 "q-105767" 13194139536086 17592186045417 true] [17592186565461 1070 17592186045487 13194139536086 17592186045417 true] [17592186565461 1071 "Let $f(x,y,z)$ be a function that is differentiable at each point on the line segment $\\overset{―}{AB},$ where $a=⟨-1,-2,4⟩$ and $b=⟨3,-2,-5⟩$ are the position vectors of $A$ and $B,$ respectively. If $f(a)=-3$ and $f(b)=4,$ then what is missing from the statement below?\n\n*The mean value theorem states that there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that $\\text{_______________}\\,.$ *" 13194139536086 17592186045417 true] [17592186565461 1072 #uuid "bf45d7d2-b32a-596a-b136-67ab888373db" 13194139536086 17592186045417 true] [17592186565461 1074 "The mean value theorem states that if $f(x,y,z)$ is differentiable at each point on the line segment $\\overset{―}{AB},$ then there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that\n\n$$\nf(b)-f(a)=∇f(c)·(b-a).\n$$\n\nIn our case, we have \n\n$$\n\\begin{aligned}f(b)-f(a) & =∇f(c)\\cdot (b-a) \\\\ 4-(-3) & =⟨{f}_{x}(c),{f}_{y}(c),{f}_{z}(c)⟩\\cdot (⟨3,-2,-5⟩-⟨-1,-2,4⟩) \\\\ 7 & =⟨{f}_{x}(c),{f}_{y}(c),{f}_{z}(c)⟩\\cdot ⟨4,0,-9⟩ \\\\ 7 & =4{f}_{x}(c)-9{f}_{z}(c).\\end{aligned}\n$$\n\nTherefore, the complete sentence is as follows:\n\n*The mean value theorem states that there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that $4{f}_{x}(c)-9{f}_{z}(c)=7.$ *" 13194139536086 17592186045417 true] [17592186565462 1068 17592186565354 13194139536086 17592186045417 true] [17592186565462 1069 "q-122873" 13194139536086 17592186045417 true] [17592186565462 1070 17592186045485 13194139536086 17592186045417 true] [17592186565462 1071 "![](images/c6/c6ed4ab6e979f6df3cba0b2afc442dec11667b7b81027cd692e01f1106ee53fa.png)\n\nConsider the partition of the rectangular region $R$ shown above and the positive function $f(x,y)$ defined on $R.$ Which of the following gives an expression for the lower Riemann sum of $f$ with respect to this partition.\n\n*Hint: ${m}_{ij}$ denotes the minimum value of $f$ on the subregion ${R}_{ij}$*" 13194139536086 17592186045417 true] [17592186565462 1072 #uuid "bfe6201a-0cdf-54aa-a233-33c1bb74e932" 13194139536086 17592186045417 true] [17592186565462 1074 "To calculate the lower Riemann sum $L$ with respect to the given partition, we compute the sum of the volumes of $3$ rectangular solids, one for each ${R}_{ij}.$\n\nThe volume of the rectangular solid corresponding to each subregion ${R}_{ij}$ is given by\n\n$$\n{m}_{ij}\\cdot \\text{Area}({R}_{ij}).\n$$\n\nwhere ${m}_{ij}$ denotes the minimum value of $f$ on the subregion ${R}_{ij}.$ We pick the *minimum* value of $f$ because we're finding the *lower* sum.\n\nSo in our case, we have\n\n$$\nL={m}_{11}\\cdot \\text{Area}({R}_{11})+{m}_{21}\\cdot \\text{Area}({R}_{21})+{m}_{31}\\cdot \\text{Area}({R}_{31}).\n$$\n\nNotice that\n\n$$\n\\text{Area}({R}_{11})=\\text{Area}({R}_{21})=\\text{Area}({R}_{31})=2.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}L & =2\\cdot {m}_{11}+2\\cdot {m}_{21}+2\\cdot {m}_{31} \\\\  & =2({m}_{11}+{m}_{21}+{m}_{31}).\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565463 1068 17592186565371 13194139536086 17592186045417 true] [17592186565463 1069 "q-129347" 13194139536086 17592186045417 true] [17592186565463 1070 17592186045487 13194139536086 17592186045417 true] [17592186565463 1071 "Determine ${lim}_{x\\to (9,1,3)}\\frac{x-{y}^{2}{z}^{2}}{\\sqrt{x}-yz}.$" 13194139536086 17592186045417 true] [17592186565463 1072 #uuid "cbddc293-6a3c-5b64-88ba-c447f360dc9b" 13194139536086 17592186045417 true] [17592186565463 1074 "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\begin{aligned}{lim}_{x\\to (9,1,3)}\\frac{x-{y}^{2}{z}^{2}}{\\sqrt{x}-yz} & =\\frac{9-({1}^{2})({3}^{2})}{\\sqrt{9}-1(3)} \\\\  & =\\frac{9-9}{3-3} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (9,1,3)}\\frac{x-{y}^{2}{z}^{2}}{\\sqrt{x}-yz} & ={lim}_{x\\to (9,1,3)}\\frac{(x-{y}^{2}{z}^{2})(\\sqrt{x}+yz)}{(\\sqrt{x}-yz)(\\sqrt{x}+yz)} \\\\  & ={lim}_{x\\to (9,1,3)}\\frac{(x-{y}^{2}{z}^{2})(\\sqrt{x}+yz)}{x-{y}^{2}{z}^{2}} \\\\  & ={lim}_{x\\to (9,1,3)}\\frac{\\cancel{(x-{y}^{2}{z}^{2})}(\\sqrt{x}+yz)}{\\cancel{x-{y}^{2}{z}^{2}}} \\\\  & ={lim}_{x\\to (9,1,3)}(\\sqrt{x}+yz)\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}{lim}_{x\\to (9,1,3)}(\\sqrt{x}+yz) & =\\sqrt{9}+1(3) \\\\  & =3+3 \\\\  & =6\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $6.$" 13194139536086 17592186045417 true] [17592186565464 1068 17592186565337 13194139536086 17592186045417 true] [17592186565464 1069 "q-122970" 13194139536086 17592186045417 true] [17592186565464 1070 17592186045485 13194139536086 17592186045417 true] [17592186565464 1071 "Let $P=\\{{z}_{0},{z}_{1},…,{z}_{q}\\}$ be a partition of the interval $[-1,5].$ If $Δ{z}_{k}={z}_{k}-{z}_{k-1},$ calculate ${\\sum }_{k=1}^{q}Δ{z}_{k}.$" 13194139536086 17592186045417 true] [17592186565464 1072 #uuid "cc3f1bc7-f9c3-504a-985e-91fc4c5b8f28" 13194139536086 17592186045417 true] [17592186565464 1074 "Note that ${\\sum }_{k=1}^{q}Δ{z}_{k}$ is just the length of the interval $[-1,5],$ because\n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}Δ{z}_{k} & =({z}_{1}-{z}_{0})+({z}_{2}-{z}_{1})+({z}_{3}-{z}_{2})+⋯+({z}_{q}-{z}_{q-1}) \\\\  & =(\\cancel{{z}_{1}}-{z}_{0})+(\\cancel{{z}_{2}}-\\cancel{{z}_{1}})+(\\cancel{{z}_{3}}-\\cancel{{z}_{2}})+⋯+({z}_{q}-\\cancel{{z}_{q-1}}) \\\\  & =-{z}_{0}+{z}_{q} \\\\  & ={z}_{q}-{z}_{0} \\\\  & =5-(-1) \\\\  & =6.\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565465 1068 17592186565340 13194139536086 17592186045417 true] [17592186565465 1069 "q-129057" 13194139536086 17592186045417 true] [17592186565465 1070 17592186045487 13194139536086 17592186045417 true] [17592186565465 1071 "The level curves of the function $f(x,y)=\\frac{2{x}^{2}+{y}^{2}-1}{{y}^{2}+1}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nI. $c=0$ gives an ellipse\n\nII. $c=1$ gives a circle\n\nIII. $c=2$ gives a hyperbola" 13194139536086 17592186045417 true] [17592186565465 1072 #uuid "cdadd58a-68d8-50fc-902f-9f8e63435f08" 13194139536086 17592186045417 true] [17592186565465 1074 "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\frac{2{x}^{2}+{y}^{2}-1}{{y}^{2}+1} & =c \\\\ 2{x}^{2}+{y}^{2}-1 & =c({y}^{2}+1) \\\\ 2{x}^{2}+(1-c){y}^{2} & =c+1\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=0,$ the level curve is $2{x}^{2}+{y}^{2}=1,$ which is an ellipse. So, I is true.\n\n- If $c=1,$ the level curves are $x=\\pm 1,$ which consists of two lines. So, II is false.\n\n- If $c=2,$ the level curve is $2{x}^{2}-{y}^{2}=3,$ which is a hyperbola. So, III is true.\n\nSo, the correct answer is \"I and III only\"." 13194139536086 17592186045417 true] [17592186565466 1068 17592186565332 13194139536086 17592186045417 true] [17592186565466 1069 "q-342800" 13194139536086 17592186045417 true] [17592186565466 1070 17592186045486 13194139536086 17592186045417 true] [17592186565466 1071 "Consider the following initial value problem:\n\n$$\n\\frac{\\text{d}y}{\\text{d}t}+2y={u}_{\\pi /3}(t)\\cdot cos\\,(3t-\\pi )\\,,\\,y(0)=-1,\n$$\n\nwhere ${u}_{\\pi /3}(t)=u\\,(t-\\frac{\\pi }{3})$ is the unit step function.\n\nYou're given that the Laplace transform $Y(s)=L\\{y(t)\\}$ is\n\n$$\nY(s)=-\\frac{1}{s+2}+\\frac{s\\,{e}^{-\\pi s/3}}{({s}^{2}+9)(s+2)}\n$$\n\nand that the solution to the initial value problem can be expressed as \n\n$$\ny(t)=-{e}^{-2t}-\\frac{1}{13}u\\,(t-\\frac{\\pi }{3})\\cdot g(t).\n$$\n\nFind the function $g(t).$ \n\nHint: You may make use of the following results:\n\n$$\nL\\{\\operatorname{sin}⁡\\omega t\\}=\\frac{\\omega }{{s}^{2}+{\\omega }^{2}},\\,L\\{\\operatorname{cos}⁡\\omega t\\}=\\frac{s}{{s}^{2}+{\\omega }^{2}},\\,s>0.\n$$" 13194139536086 17592186045417 true] [17592186565466 1072 #uuid "d1348d32-c72c-5639-a597-5810a3541a7f" 13194139536086 17592186045417 true] [17592186565466 1074 "To find the function $g(t),$ we need to compute the inverse Laplace transform of the term containing the time delay in $Y(s).$\n\nWe focus on the term with the exponential ${e}^{-\\pi s/3}$ (which corresponds to the step function in the time domain) and identify the rational function part:\n\n$$\nF(s)=\\frac{s}{({s}^{2}+9)(s+2)}.\n$$\n\nWe'll solve this in three steps.\n\n**Step 1.** Partial fraction decomposition\n\nSince the denominator contains a linear factor $(s+2)$ and an irreducible quadratic factor $({s}^{2}+9),$ the decomposition takes the form\n\n$$\n\\frac{s}{({s}^{2}+9)(s+2)}=\\frac{A}{s+2}+\\frac{Bs+C}{{s}^{2}+9}.\n$$\n\nTo find the constants, we clear the denominators:\n\n$$\ns=A({s}^{2}+9)+(Bs+C)(s+2).\n$$\n\nNow, we find the constants $A,B,$ and $C.$\n\n- Setting $s=-2,$ we have\n\n$$\n-2=A((-2)^{2}+9)+0\\,⟹\\,13A=-2\\,⟹\\,A=-\\frac{2}{13}.\n$$\n\n- Comparing the coefficients of ${s}^{2},$ we have\n\n$$\n0=A+B\\,⟹\\,B=-A=\\frac{2}{13}.\n$$\n\n- Comparing the constant terms, we have\n\n$$\n0=9A+2C\\,⟹\\,0=9\\,(-\\frac{2}{13})+2C\\,⟹\\,C=\\frac{9}{13}.\n$$\n\nThus, we can rewrite $F(s)$ as\n\n$$\nF(s)=\\frac{1}{13}(-\\frac{2}{s+2}+\\frac{2s+9}{{s}^{2}+9})=\\frac{1}{13}(-2\\cdot \\frac{1}{s+2}+2\\cdot \\frac{s}{{s}^{2}+9}+3\\cdot \\frac{3}{{s}^{2}+9}).\n$$\n\n**Step 2.** Finding the Inverse of the base function\n\nWe find the inverse transform $f(t)={L}^{-1}\\{F(s)\\}$ using standard transforms:\n\n$$\n\\begin{aligned}f(t) & =\\frac{1}{13}(-2\\cdot {L}^{-1}\\{\\frac{1}{s+2}\\}+2\\cdot {L}^{-1}\\{\\frac{s}{{s}^{2}+9}\\}+3\\cdot {L}^{-1}\\{\\frac{3}{{s}^{2}+9}\\}) \\\\  & =\\frac{1}{13}(-2{e}^{-2t}+2\\operatorname{cos}⁡(3t)+3\\operatorname{sin}⁡(3t))\\end{aligned}\n$$\n\n**Step 3.** Applying the time-shifting property\n\nFinally, we address the ${e}^{-\\pi s/3}$ term. By the second shifting theorem, we have\n\n$$\n{e}^{-as}\\cdot F(s)=L\\{u(t-a)\\cdot f(t-a)\\}.\n$$\n\nTaking the inverse Laplace transform gives\n\n$$\n{L}^{-1}\\{{e}^{-as}F(s)\\}=u(t-a)\\cdot f(t-a).\n$$\n\nIn our case, $a=\\frac{\\pi }{3}.$ Therefore, we shift $f(t)$ by replacing every instance of $t$ with $(t-\\frac{\\pi }{3}):$\n\n$$\n\\begin{aligned}y(t) & =u\\,(t-\\frac{\\pi }{3})f\\,(t-\\frac{\\pi }{3}) \\\\  & =u\\,(t-\\frac{\\pi }{3})\\cdot \\frac{1}{13}[-2{e}^{-2(t-\\pi /3)}+2\\operatorname{cos}⁡(3\\,(t-\\frac{\\pi }{3}))+3\\operatorname{sin}⁡(3\\,(t-\\frac{\\pi }{3}))].\\end{aligned}\n$$\n\nUsing the trigonometric identities $\\operatorname{cos}⁡(3(t-\\pi /3))=-\\operatorname{cos}⁡(3t)$ and $\\operatorname{sin}⁡(3(t-\\pi /3))=-\\operatorname{sin}⁡(3t),$ we simplify:\n\n$$\n\\begin{aligned}y(t) & =u\\,(t-\\frac{\\pi }{3})\\cdot \\frac{1}{13}(-2{e}^{-2(t-\\pi /3)}-2\\operatorname{cos}⁡(3t)-3\\operatorname{sin}⁡(3t)) \\\\  & =-\\frac{1}{13}\\,u\\,(t-\\frac{\\pi }{3})(2{e}^{-(t-\\pi /2)}+2\\operatorname{cos}⁡(3t)+3\\operatorname{sin}⁡(3t)).\\end{aligned}\n$$\n\nComparing this to the second term of the form given in the problem statement $y(t)=-{e}^{-2t}-\\frac{1}{13}u\\,(t-\\frac{\\pi }{3})\\cdot g(t),$ we identify $g(t)$ as\n\n$$\ng(t)=2{e}^{-2(t-\\pi /3)}+2\\operatorname{cos}⁡(3t)+3\\operatorname{sin}⁡(3t).\n$$" 13194139536086 17592186045417 true] [17592186565467 1068 17592186565364 13194139536086 17592186045417 true] [17592186565467 1069 "q-340023" 13194139536086 17592186045417 true] [17592186565467 1070 17592186045485 13194139536086 17592186045417 true] [17592186565467 1071 "Given the function $y=-3\\operatorname{ln}⁡x+4{e}^{x},$ the slope of the tangent line at $x=1$ is{{field-1}}." 13194139536086 17592186045417 true] [17592186565467 1072 #uuid "d2ff517e-a169-5a1c-9487-46b4246b351b" 13194139536086 17592186045417 true] [17592186565467 1074 "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-3\\operatorname{ln}⁡x+4{e}^{x}) \\\\  & =-3\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x)+4\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =-3\\cdot \\frac{1}{x}+4{e}^{x} \\\\  & =-\\frac{3}{x}+4{e}^{x}\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(-\\frac{3}{x}+4{e}^{x})|}_{x=1} \\\\  & =-\\frac{3}{1}+4{e}^{1} \\\\  & =-3+4e\\,.\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565468 1068 17592186565383 13194139536086 17592186045417 true] [17592186565468 1069 "q-89862" 13194139536086 17592186045417 true] [17592186565468 1070 17592186045485 13194139536086 17592186045417 true] [17592186565468 1071 "![](images/c5/c5b42df6ce8884f482ef982d5bb74ff6fd10fe0b69c6c3f6d8cbd2bc1f11336a.png)\n\nWhich of the above could be the graph of $y=\\sqrt{x}?$" 13194139536086 17592186045417 true] [17592186565468 1072 #uuid "d38f76f8-d0d4-57e2-9294-46487229e4bf" 13194139536086 17592186045417 true] [17592186565468 1074 "Let's recall some of the basic properties of $y=\\sqrt{x}.$\n\n- The point $(0,0)$ lies on the graph\n\n- Its domain is $x\\in [0,\\infty )$\n\n- Its range is $y\\in [0,\\infty )$\n\n- The function is increasing over its entire domain.\n\n- As $x\\to \\infty $, we have $y\\to \\infty ,$ though it does so slowly\n\nOf the given options, only graph III has all of the above properties. Therefore, the correct answer is \"III only.\"" 13194139536086 17592186045417 true] [17592186565469 1068 17592186565369 13194139536086 17592186045417 true] [17592186565469 1069 "q-250933" 13194139536086 17592186045417 true] [17592186565469 1070 17592186045485 13194139536086 17592186045417 true] [17592186565469 1071 "Find the common ratio of the geometric sequence whose fifth term is $7$ and whose tenth term is $-224.$\n\n$r=$\n{{field-1}}" 13194139536086 17592186045417 true] [17592186565469 1072 #uuid "d3bc0664-ca47-5557-b277-90c0fa7c4b0b" 13194139536086 17592186045417 true] [17592186565469 1074 "To find the common ratio $r$ of a geometric sequence given two terms ${a}_{m}$ and ${a}_{n},$ we use the formula\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}.\n$$\n\nIn this case, we're given ${a}_{10}=-224$ and ${a}_{5}=7.$ Substituting $n=10$ and $m=5$ into the formula, we have\n\n$$\n\\begin{aligned}{r}^{10-5} & =\\frac{{a}_{10}}{{a}_{5}} \\\\ {r}^{5} & =\\frac{(-224)}{7} \\\\ {r}^{5} & =-32.\\end{aligned}\n$$\n\nFinally, by solving the equation for $r,$ we get\n\n$$\n\\begin{aligned}{r}^{5} & =-32 \\\\ {r}^{5} & =(-2)^{5} \\\\ r & =-2.\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565470 1068 17592186565345 13194139536086 17592186045417 true] [17592186565470 1069 "q-122974" 13194139536086 17592186045417 true] [17592186565470 1070 17592186045487 13194139536086 17592186045417 true] [17592186565470 1071 "Let $P=\\{{y}_{0},{y}_{1},…,{y}_{n}\\}$ be a partition of the interval $[5,14].$ If $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ calculate ${\\sum }_{j=1}^{n}-2Δ{y}_{j}.$" 13194139536086 17592186045417 true] [17592186565470 1072 #uuid "d8715c2d-ca5b-51c2-9a33-2dfd408c50a1" 13194139536086 17592186045417 true] [17592186565470 1074 "First, we take the factor $(-2)$ outside the summation:\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}-2Δ{y}_{j}=-2{\\sum }_{j=1}^{n}Δ{y}_{j}\\end{aligned}\n$$\n\nNote that ${\\sum }_{j=1}^{n}Δ{y}_{j}$ is just the length of the interval $[5,14],$ because\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}Δ{y}_{j} & =({y}_{1}-{y}_{0})+({y}_{2}-{y}_{1})+({y}_{3}-{y}_{2})+⋯+({y}_{n}-{y}_{n-1}) \\\\  & =(\\cancel{{y}_{1}}-{y}_{0})+(\\cancel{{y}_{2}}-\\cancel{{y}_{1}})+(\\cancel{{y}_{3}}-\\cancel{{y}_{2}})+⋯+({y}_{n}-\\cancel{{y}_{n-1}}) \\\\  & =-{y}_{0}+{y}_{n} \\\\  & ={y}_{n}-{y}_{0} \\\\  & =14-5 \\\\  & =9.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n-2{\\sum }_{j=1}^{n}Δ{y}_{j}=(-2)\\cdot 9=-18.\n$$" 13194139536086 17592186045417 true] [17592186565471 1068 17592186565399 13194139536086 17592186045417 true] [17592186565471 1069 "q-156054" 13194139536086 17592186045417 true] [17592186565471 1070 17592186045486 13194139536086 17592186045417 true] [17592186565471 1071 "Solve the inequality $\\frac{3z+1}{2}>\\frac{-28+6z}{7}.$" 13194139536086 17592186045417 true] [17592186565471 1072 #uuid "dc1245c0-95c3-5566-8f75-3345f8116530" 13194139536086 17592186045417 true] [17592186565471 1074 "First, we clear the rational expressions by multiplying both sides of the inequality by the lowest common positive multiple of the denominators:\n\n$$\n\\begin{aligned}\\frac{3z+1}{2} & >\\frac{-28+6z}{7} \\\\ 14\\cdot (\\frac{3z+1}{2}) & >14\\cdot (\\frac{-28+6z}{7}) \\\\ 7\\cdot (3z+1) & >2\\cdot (-28+6z) \\\\ 21z+7 & >-56+12z\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles:\n\n$$\n\\begin{aligned}21z+7 & >-56+12z \\\\ 21z+7-12z & >-56+12z-12z \\\\ 9z+7 & >-56 \\\\ 9z+7-7 & >-56-7 \\\\ 9z & >-63 \\\\ \\frac{9z}{9} & >\\frac{-63}{9} \\\\ z & >-7\\end{aligned}\n$$\n\nTherefore, the solution is $z>-7.$" 13194139536086 17592186045417 true] [17592186565472 1068 17592186565327 13194139536086 17592186045417 true] [17592186565472 1069 "q-122990" 13194139536086 17592186045417 true] [17592186565472 1070 17592186045486 13194139536086 17592186045417 true] [17592186565472 1071 "Let $P=\\{{y}_{0},{y}_{1},…,{y}_{n}\\}$ be a partition of the interval $[1,5].$ If $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ calculate ${\\sum }_{j=1}^{n}3({y}_{j}+{y}_{j-1})Δ{y}_{j}.$" 13194139536086 17592186045417 true] [17592186565472 1072 #uuid "dc9a0f07-fee9-5b1d-8ce4-fb565f5e676a" 13194139536086 17592186045417 true] [17592186565472 1074 "Using the constant multiple rule, we can write the summation as\n\n$$\n{\\sum }_{j=1}^{n}3({y}_{j}+{y}_{j-1})Δ{y}_{j}=3{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j}.\n$$\n\nWe can simplify the summation as follows:\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j} & =({y}_{1}+{y}_{0})Δ{y}_{1}+({y}_{2}+{y}_{1})Δ{y}_{2}+⋯+({y}_{n}+{y}_{n-1})Δ{y}_{n} \\\\  & =({y}_{1}+{y}_{0})({y}_{1}-{y}_{0})+({y}_{2}+{y}_{1})({y}_{2}-{y}_{1})+⋯+({y}_{n}+{y}_{n-1})({y}_{n}-{y}_{n-1}) \\\\  & =({y}_{1}^{2}-{y}_{0}^{2})+({y}_{2}^{2}-{y}_{1}^{2})+⋯+({y}_{n}^{2}-{y}_{n-1}^{2}) \\\\  & =(\\cancel{{y}_{1}^{2}}-{y}_{0}^{2})+(\\cancel{{y}_{2}^{2}}-\\cancel{{y}_{1}^{2}})+⋯+({y}_{n}^{2}-\\cancel{{y}_{n-1}^{2}}) \\\\  & =-{y}_{0}^{2}+{y}_{n}^{2} \\\\  & ={y}_{n}^{2}-{y}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${y}_{0}=1$ and ${y}_{n}=5$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j} & ={y}_{n}^{2}-{y}_{0}^{2} \\\\  & ={5}^{2}-{1}^{2} \\\\  & =24.\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n3{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j}=3\\cdot 24=72.\n$$" 13194139536086 17592186045417 true] [17592186565473 1068 17592186565357 13194139536086 17592186045417 true] [17592186565473 1069 "q-39641" 13194139536086 17592186045417 true] [17592186565473 1070 17592186045485 13194139536086 17592186045417 true] [17592186565473 1071 "![](images/0c/0cf50074bd5b43815dd03e88db20086dcdefb42f4e01d30e37be014fa80d772f.png)\n\nWhich of the above could be the graph of $y=\\sqrt{x}?$" 13194139536086 17592186045417 true] [17592186565473 1072 #uuid "dcd7f2f3-3373-5879-b2c8-71cda166f322" 13194139536086 17592186045417 true] [17592186565473 1074 "Let's recall some of the basic properties of $y=\\sqrt{x}.$\n\n- The point $(0,0)$ lies on the graph\n\n- Its domain is $x\\in [0,\\infty )$\n\n- Its range is $y\\in [0,\\infty )$\n\n- The function is increasing over its entire domain.\n\n- As $x\\to \\infty $, we have $y\\to \\infty ,$ though it does so slowly\n\nOf the given options, only graph II has all of the above properties. Therefore, the correct answer is \"II only.\"" 13194139536086 17592186045417 true] [17592186565474 1068 17592186565344 13194139536086 17592186045417 true] [17592186565474 1069 "q-17382" 13194139536086 17592186045417 true] [17592186565474 1070 17592186045485 13194139536086 17592186045417 true] [17592186565474 1071 "Given that $y=3\\operatorname{ln}⁡x+2{e}^{x}$, find the slope of the tangent at $x=1.$" 13194139536086 17592186045417 true] [17592186565474 1072 #uuid "de4c520d-e939-5935-ab41-475d00b0a086" 13194139536086 17592186045417 true] [17592186565474 1074 "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{3}{x}+2{e}^{x}\\,.\n$$\n\nTherefore, the slope  of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{3}{x}+2{e}^{x})|}_{x=1} \\\\  & =\\frac{3}{1}+2{e}^{1} \\\\  & =3+2e\\,.\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565475 1068 17592186565330 13194139536086 17592186045417 true] [17592186565475 1069 "q-71945" 13194139536086 17592186045417 true] [17592186565475 1070 17592186045487 13194139536086 17592186045417 true] [17592186565475 1071 "What is the radius of the sphere ${x}^{2}-6x+{y}^{2}+{z}^{2}=17?$" 13194139536086 17592186045417 true] [17592186565475 1072 #uuid "e09cfecd-e23b-5baa-8f4c-7e2b5c69c1a9" 13194139536086 17592186045417 true] [17592186565475 1074 "Remember that the equation of a sphere centered at $({x}_{0},{y}_{0},{z}_{0})$ with radius $r>0$ is given by\n\n$$\n(x-{x}_{0})^{2}+(y-{y}_{0})^{2}+(z-{z}_{0})^{2}={r}^{2}.\n$$\n\nBy completing the square for the variable $x$, we have:\n\n$$\n\\begin{aligned}{x}^{2}-6x+{y}^{2}+{z}^{2} & =17 \\\\ ({x}^{2}-6x+9)+{y}^{2}+{z}^{2} & =17+9 \\\\ (x-3)^{2}+{y}^{2}+{z}^{2} & =26\\end{aligned}\n$$\n\nNow, we can write our equation as\n\n$$\n(x-3)^{2}+{y}^{2}+{z}^{2}=(\\sqrt{26})^{2},\n$$\n\nwhich gives us a radius of $\\sqrt{26}.$" 13194139536086 17592186045417 true] [17592186565476 1068 17592186565392 13194139536086 17592186045417 true] [17592186565476 1069 "q-334233" 13194139536086 17592186045417 true] [17592186565476 1070 17592186045485 13194139536086 17592186045417 true] [17592186565476 1071 "Evaluate the following limit:\n\n${lim}_{x\\to {0}^{-}}(\\frac{7}{9{x}^{7}})=$\n{{field-1}}" 13194139536086 17592186045417 true] [17592186565476 1072 #uuid "e3e8207e-9140-5f5f-bfa7-ab83fc0d1420" 13194139536086 17592186045417 true] [17592186565476 1074 "First, we rewrite the limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{-}}(\\frac{7}{9{x}^{7}}) & =\\frac{7}{9}\\cdot {lim}_{x\\to {0}^{-}}\\frac{1}{{x}^{7}}\\end{aligned}\n$$\n\nNow, recall the fact that\n\n$$\n{lim}_{x\\to {0}^{-}}\\frac{1}{{x}^{7}}=-\\infty .\n$$\n\nThe positive factor of $\\frac{7}{9}$ does not change the sign of the limit. Therefore, we conclude that\n\n$$\n\\frac{7}{9}\\cdot {lim}_{x\\to {0}^{-}}\\frac{1}{{x}^{7}}=-\\infty .\n$$" 13194139536086 17592186045417 true] [17592186565477 1068 17592186565390 13194139536086 17592186045417 true] [17592186565477 1069 "q-65138" 13194139536086 17592186045417 true] [17592186565477 1070 17592186045486 13194139536086 17592186045417 true] [17592186565477 1071 "${lim}_{(x,y)\\to (-1,1)}\\frac{2{x}^{2}+3xy+{y}^{2}}{{x}^{3}+xy+{x}^{2}y+{y}^{2}}=$" 13194139536086 17592186045417 true] [17592186565477 1072 #uuid "ec0d423c-ac59-5358-a37f-88f2016b24ef" 13194139536086 17592186045417 true] [17592186565477 1074 "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n{lim}_{(x,y)\\to (-1,1)}\\frac{2{x}^{2}+3xy+{y}^{2}}{{x}^{3}+xy+{x}^{2}y+{y}^{2}}=\\frac{2\\cdot (-1)^{2}+3\\cdot (-1)\\cdot 1+{1}^{2}}{(-1)^{3}+(-1)\\cdot 1+(-1)^{2}\\cdot 1+{1}^{2}}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by factoring the numerator and denominator and then canceling common factors:\n\n$$\n\\begin{aligned}{lim}_{(x,y)\\to (-1,1)}\\frac{2{x}^{2}+3xy+{y}^{2}}{{x}^{3}+xy+{x}^{2}y+{y}^{2}} & ={lim}_{(x,y)\\to (-1,1)}\\frac{2{x}^{2}+2xy+xy+{y}^{2}}{{x}^{2}(x+y)+y(x+y)} \\\\  & ={lim}_{(x,y)\\to (-1,1)}\\frac{2x(x+y)+y(x+y)}{({x}^{2}+y)(x+y)} \\\\  & ={lim}_{(x,y)\\to (-1,1)}\\frac{(2x+y)(x+y)}{({x}^{2}+y)(x+y)} \\\\  & ={lim}_{(x,y)\\to (-1,1)}\\frac{2x+y}{{x}^{2}+y}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}{lim}_{(x,y)\\to (-1,1)}\\frac{2x+y}{{x}^{2}+y} & =\\frac{2(-1)+(1)}{(-1)^{2}+1} \\\\  & =-\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $-\\frac{1}{2}.$" 13194139536086 17592186045417 true] [17592186565478 1068 17592186565343 13194139536086 17592186045417 true] [17592186565478 1069 "q-95018" 13194139536086 17592186045417 true] [17592186565478 1070 17592186045487 13194139536086 17592186045417 true] [17592186565478 1071 "Consider the following matrices:\n\n$$\n{B}_{1}=[\\begin{aligned}0 & 6 \\\\ -3 & 3\\end{aligned}],\\,{B}_{2}=[\\begin{aligned}0 & 9 \\\\ -6 & 0\\end{aligned}],\\,A=[\\begin{aligned}0 & 8 \\\\ -5 & 1\\end{aligned}]\n$$\n\nIf $B=\\{{B}_{1},{B}_{2}\\}$ is a basis of $\\text{Span}\\{{B}_{1},{B}_{2}\\},$ and $[A]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" 13194139536086 17592186045417 true] [17592186565478 1072 #uuid "edf4a097-cde0-5ac1-86d1-cd429ba599d0" 13194139536086 17592186045417 true] [17592186565478 1074 "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{B}_{1}+{x}_{2}{B}_{2}=A.\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}0 & 6 \\\\ -3 & 3\\end{aligned}]+{x}_{2}[\\begin{aligned}0 & 9 \\\\ -6 & 0\\end{aligned}] & =[\\begin{aligned}0 & 8 \\\\ -5 & 1\\end{aligned}] \\\\ [\\begin{aligned}0 & 6{x}_{1}+9{x}_{2} \\\\ -3{x}_{1}-6{x}_{2} & 3{x}_{1}\\end{aligned}] & =[\\begin{aligned}0 & 8 \\\\ -5 & 1\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding entries, we obtain\n\n$$\n\\{\\begin{aligned}6{x}_{1}+9{x}_{2}=8 \\\\ -3{x}_{1}-6{x}_{2}=-5 \\\\ 3{x}_{1}=1.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}6 & 9 & 8 \\\\ -3 & -6 & -5 \\\\ 3 & 0 & 1\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}6 & 9 & 8 \\\\ -3 & -6 & -5 \\\\ 3 & 0 & 1\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(\\frac{1}{2}){R}_{1} \\\\ {R}_{3}:={R}_{3}+(-\\frac{1}{2}){R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}6 & 9 & 8 \\\\ 0 & -\\frac{3}{2} & -1 \\\\ 0 & -\\frac{9}{2} & -3\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}6{x}_{1}+9{x}_{2}=8 \\\\ -\\frac{3}{2}{x}_{2}=-1 \\\\ -\\frac{9}{2}{x}_{2}=-3.\\end{aligned}\n$$\n\nFrom the second and third equations, we get ${x}_{2}=\\frac{2}{3}.$ From the first equation, we get \n\n$$\n\\begin{aligned}6{x}_{1}+9\\cdot \\frac{2}{3} & =8 \\\\ 6{x}_{1} & =2 \\\\ {x}_{1} & =\\frac{1}{3}.\\end{aligned}\n$$\n\n \n\nTherefore, $[A]_{B}=[\\begin{aligned}\\frac{1}{3} \\\\ \\frac{2}{3}\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=\\frac{1}{3}+\\frac{2}{3}=1.$" 13194139536086 17592186045417 true] [17592186565479 1068 17592186565347 13194139536086 17592186045417 true] [17592186565479 1069 "q-250939" 13194139536086 17592186045417 true] [17592186565479 1070 17592186045487 13194139536086 17592186045417 true] [17592186565479 1071 "Find the common ratio of the geometric sequence whose sixth term is $-15$ and whose ninth term is $-\\frac{3}{25}.$\n\n$r=$\n{{field-1}}" 13194139536086 17592186045417 true] [17592186565479 1072 #uuid "efae9349-6eb8-5183-b15e-8510c6f912ab" 13194139536086 17592186045417 true] [17592186565479 1074 "To find the common ratio $r$ of a geometric sequence given two terms ${a}_{m}$ and ${a}_{n},$ we use the formula\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}.\n$$\n\nIn this case, we're given ${a}_{9}=-\\frac{3}{25}$ and ${a}_{6}=-15.$ Substituting $n=9$ and $m=6$ into the formula, we have\n\n$$\n\\begin{aligned}{r}^{9-6} & =\\frac{{a}_{9}}{{a}_{6}} \\\\ {r}^{3} & =\\frac{(-\\frac{3}{25})}{(-15)} \\\\ {r}^{3} & =\\frac{1}{125}.\\end{aligned}\n$$\n\nFinally, by solving the equation for $r,$ we get\n\n$$\n\\begin{aligned}{r}^{3} & =\\frac{1}{125} \\\\ {r}^{3} & ={(\\frac{1}{5})}^{3} \\\\ r & =\\frac{1}{5}.\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565480 1068 17592186565361 13194139536086 17592186045417 true] [17592186565480 1069 "q-122927" 13194139536086 17592186045417 true] [17592186565480 1070 17592186045485 13194139536086 17592186045417 true] [17592186565480 1071 "Which of the following are partitions of the real interval $[0,9]?$\n\nI. $1<5<9$\n\nII. $0<5<7<9<10$\n\nIII. $\\{0,1,2,6,8,9\\}$" 13194139536086 17592186045417 true] [17592186565480 1072 #uuid "f1be0d7b-0db0-5190-8f45-38feec497f84" 13194139536086 17592186045417 true] [17592186565480 1074 "A partition $P$ of a closed interval $[a,b]$ is a finite sequence of real numbers taken from $[a,b]$ such that\n\n$$\na={x}_{0}<{x}_{1}<{x}_{2}<…<{x}_{n}=b\\,.\n$$\n\nWe can express $P$ using set notation as\n\n$$\nP=\\{{x}_{0},{x}_{1},…,{x}_{n}\\}.\n$$\n\n \n\nWith that in mind, let's consider each statement:\n\n- Statement I is not a partition of $[0,9]$ since it does not include the left endpoint $a=0.$\n\n- Statement II is not a partition of $[0,9]$ since $10$ does not belong to $[0,9].$\n\n- Statement III is a partition of $[0,9].$\n\nTherefore, the correct answer is \"III only.\"" 13194139536086 17592186045417 true] [17592186565481 1068 17592186565397 13194139536086 17592186045417 true] [17592186565481 1069 "q-342538" 13194139536086 17592186045417 true] [17592186565481 1070 17592186045485 13194139536086 17592186045417 true] [17592186565481 1071 "Find the Laplace transform $Y(s)=L\\{y(t)\\}$ if \n\n$$\n{y}^{′}+2y=5{u}_{3}(t)\\cdot {e}^{2t-6}\\,,\\,y(0)=5,\n$$\n\nwhere ${u}_{3}(t)=u(t-3)$ is the unit step function.\n\n$Y(s)=\\frac{5}{s+2}\\,+\\,$\n{{field-1}},$\\,s>2$" 13194139536086 17592186045417 true] [17592186565481 1072 #uuid "f427f52d-d8d0-506f-a966-8597af9a76fe" 13194139536086 17592186045417 true] [17592186565481 1074 "First, we take the Laplace transform of both sides and use the addition and scalar multiplication properties of the Laplace transform:\n\n$$\n\\begin{aligned}L\\{{y}^{′}+2y\\} & =L\\{5{u}_{3}(t)\\cdot {e}^{2t-6}\\} \\\\ L\\{{y}^{′}\\}+2L\\{y\\} & =L\\{5{u}_{3}(t)\\cdot {e}^{2t-6}\\}\\end{aligned}\n$$\n\nTo calculate $L\\{{y}^{′}\\},$ we use the formula for the Laplace transform of a derivative and the initial condition $y(0)=5:$\n\n$$\nL\\{{y}^{′}\\}=sY(s)-y(0)=sY(s)-5\n$$\n\nTo find the transform of the right-hand side, we note that the term \n\n$$\n5{u}_{3}(t)\\cdot {e}^{2t-6}\n$$\n\nis in the form $u(t-a)\\cdot f(t)$ where $a=3$ and $f(t)=5{e}^{2t-6}.$\n\nNow, recall that the second shifting theorem (time-shifting property) states\n\n$$\nL\\{u(t-a)\\cdot f(t)\\}={e}^{-as}\\cdot L\\{f(t+a)\\}.\n$$\n\n  \n\nSo, by the second shifting theorem, we have\n\n$$\n\\begin{aligned}L\\{5u(t-3)\\cdot {e}^{2t-6}\\} & ={e}^{-3s}\\cdot L\\{5{e}^{2(t+3)-6}\\} \\\\  & ={e}^{-3s}\\cdot L\\{5{e}^{2t}\\} \\\\  & ={e}^{-3s}\\cdot \\frac{5}{s-2} \\\\  & =\\frac{5{e}^{-3s}}{s-2}.\\end{aligned}\n$$\n\nFinally, we substitute these back into our transformed differential equation:\n\n$$\n\\begin{aligned}L\\{{y}^{′}\\}+2L\\{y\\} & =L\\{5{u}_{3}(t){e}^{2t-6}\\} \\\\ (sY(s)-5)+2Y(s) & =\\frac{5{e}^{-3s}}{s-2} \\\\ (s+2)Y(s)-5 & =\\frac{5{e}^{-3s}}{s-2} \\\\ (s+2)Y(s) & =5+\\frac{5{e}^{-3s}}{s-2} \\\\ Y(s) & =\\frac{5}{s+2}+\\frac{5{e}^{-3s}}{(s-2)(s+2)}\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565482 1068 17592186565380 13194139536086 17592186045417 true] [17592186565482 1069 "q-82238" 13194139536086 17592186045417 true] [17592186565482 1070 17592186045486 13194139536086 17592186045417 true] [17592186565482 1071 "Find an expression for the height $h$ of a cylinder in terms of its volume $V$ given that the ratio of the radius of the base to the height of the cylinder is $\\frac{1}{3}.$" 13194139536086 17592186045417 true] [17592186565482 1072 #uuid "f5dc2452-94d3-5570-b907-2fef94df0654" 13194139536086 17592186045417 true] [17592186565482 1074 "Using the fact that the ratio of the radius $r$ of the base to the height $h$ is $\\frac{1}{3},$ we have that\n\n$$\n\\begin{aligned}\\frac{r}{h} & =\\frac{1}{3}.\\end{aligned}\n$$\n\nOur goal is to express $h$ in terms of $V.$ Therefore, we need to isolate $r$ in the above equation, which we do using cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{r}{h} & =\\frac{1}{3} \\\\ 3r & =h \\\\ r & =\\frac{h}{3}\\end{aligned}\n$$\n\nThe volume of a cylinder with radius $r$ and height $h$ is given by\n\n$$\nV=\\pi {r}^{2}h.\n$$\n\nTherefore, substituting $r=\\frac{h}{3}$ into the formula, we get\n\n$$\n\\begin{aligned}V & =\\pi {r}^{2}h \\\\ V & =\\pi {(\\frac{h}{3})}^{2}\\cdot h \\\\ V & =\\pi \\cdot \\frac{{h}^{2}}{9}\\cdot h \\\\ V & =\\frac{\\pi {h}^{3}}{9} \\\\ {h}^{3} & =\\frac{9V}{\\pi } \\\\ h & =\\sqrt[3]{\\frac{9V}{\\pi }}.\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565483 1068 17592186565403 13194139536086 17592186045417 true] [17592186565483 1069 "q-64028" 13194139536086 17592186045417 true] [17592186565483 1070 17592186045485 13194139536086 17592186045417 true] [17592186565483 1071 "Find the common ratio of the geometric sequence whose fourth term is $8$ and whose seventh term is $216.$" 13194139536086 17592186045417 true] [17592186565483 1072 #uuid "f97bc019-bf9e-5a95-8fff-fb6e975b8716" 13194139536086 17592186045417 true] [17592186565483 1074 "To find the common ratio $r$ of a geometric sequence given two terms ${a}_{m}$ and ${a}_{n},$ we use the formula\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}.\n$$\n\nIn this case, we're given ${a}_{7}=216$ and ${a}_{4}=8.$ Substituting $n=7$ and $m=4$ into the formula, we have\n\n$$\n\\begin{aligned}{r}^{7-4} & =\\frac{{a}_{7}}{{a}_{4}} \\\\ {r}^{3} & =\\frac{216}{8} \\\\ {r}^{3} & =27.\\end{aligned}\n$$\n\nFinally, by solving the equation for $r,$ we get\n\n$$\n\\begin{aligned}{r}^{3} & =27 \\\\ {r}^{3} & ={3}^{3} \\\\ r & =3.\\end{aligned}\n$$" 13194139536086 17592186045417 true] [17592186565484 1068 17592186565362 13194139536086 17592186045417 true] [17592186565484 1069 "q-334180" 13194139536086 17592186045417 true] [17592186565484 1070 17592186045486 13194139536086 17592186045417 true] [17592186565484 1071 "![](images/d7/d7f1d5de28c6479a2e9b8b33a6da25a4091b71b58f6dc0c535ef390c4cb97799.png)\n\nIf the figure above shows the graph of $g(x),$ then\n\n${lim}_{x\\to -\\infty }\\frac{g(x)}{{x}^{2}}=$\n {{field-1}}." 13194139536086 17592186045417 true] [17592186565484 1072 #uuid "fc61e8f1-0b37-52d2-8620-d0e767062e04" 13194139536086 17592186045417 true] [17592186565484 1074 "Applying the product rule, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\frac{g(x)}{{x}^{2}} & ={lim}_{x\\to -\\infty }(g(x)\\cdot \\frac{1}{{x}^{2}}) \\\\  & ={lim}_{x\\to -\\infty }g(x)\\cdot {lim}_{x\\to -\\infty }\\frac{1}{{x}^{2}}.\\end{aligned}\n$$\n\nFrom the graph, we get that ${lim}_{x\\to -\\infty }g(x)=-2.$ Therefore, the above becomes:\n\n$$\n{lim}_{x\\to -\\infty }\\frac{g(x)}{{x}^{2}}=-2\\cdot {lim}_{x\\to -\\infty }\\frac{1}{{x}^{2}}\n$$\n\nNow, using the fact that\n\n$$\n{lim}_{x\\to -\\infty }(\\frac{1}{{x}^{2}})=0,\n$$\n\nwe can evaluate our limit as follows:\n\n$$\n-2\\cdot {lim}_{x\\to -\\infty }\\frac{1}{{x}^{2}}=-2\\cdot 0=0\n$$\n\nTherefore, we conclude that\n\n$$\n{lim}_{x\\to -\\infty }\\frac{g(x)}{{x}^{2}}=0.\n$$" 13194139536086 17592186045417 true] [17592186565485 1068 17592186565370 13194139536086 17592186045417 true] [17592186565485 1069 "q-78081" 13194139536086 17592186045417 true] [17592186565485 1070 17592186045485 13194139536086 17592186045417 true] [17592186565485 1071 "${lim}_{x\\to -\\infty }(-\\frac{7}{{x}^{5}})=$" 13194139536086 17592186045417 true] [17592186565485 1072 #uuid "fdb51987-aeea-5d6d-9fcd-a012fef3d69f" 13194139536086 17592186045417 true] [17592186565485 1074 "First, we use the algebra of limits to pull out the constant factor of $-7:$\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }(-\\frac{7}{{x}^{5}}) & ={lim}_{x\\to -\\infty }(-7\\cdot \\frac{1}{{x}^{5}}) \\\\  & =-7\\cdot {lim}_{x\\to -\\infty }\\frac{1}{{x}^{5}}\\end{aligned}\n$$\n\nNow, using the fact that\n\n$$\n{lim}_{x\\to -\\infty }\\frac{1}{{x}^{5}}=0,\n$$\n\nwe can evaluate our limit as follows:\n\n$$\n-7\\cdot {lim}_{x\\to -\\infty }\\frac{1}{{x}^{5}}=-7\\cdot 0=0\n$$" 13194139536086 17592186045417 true] [17592186565486 1068 17592186565359 13194139536086 17592186045417 true] [17592186565486 1069 "q-109835" 13194139536086 17592186045417 true] [17592186565486 1070 17592186045487 13194139536086 17592186045417 true] [17592186565486 1071 "Suppose that a matrix $D$ has characteristic polynomial $p(\\lambda )=(\\lambda +e)^{4}(\\lambda -\\pi )^{3}(\\lambda -1)^{5},$ the nullity of $(D+eI)^{3}$ equals $3,$ and the nullity of $(D+eI)^{4}$ equals $4.$ If a basis of ${R}^{12}$ consists of linearly independent generalized eigenvectors of $D,$ how many of these are generalized eigenvectors of rank $4$ corresponding to the eigenvalue $\\lambda =-e?$" 13194139536086 17592186045417 true] [17592186565486 1072 #uuid "fe770e3a-7d81-54be-9346-77bf6627bbf9" 13194139536086 17592186045417 true] [17592186565486 1074 "For the given matrix $D$ with eigenvalue $\\lambda =-e,$ a generalized eigenvector of rank $4$ is a vector $v$ such that \n\n$$\n(D+eI)^{4}v=0\\,\\text{and}\\,(D+eI)^{3}v\\ne 0.\n$$\n\nNotice the following:\n\n- We are given that $\\text{Null}(D+eI)^{3}$ has dimension $3.$ This means that the solutions to $(D+eI)^{3}v=0$ form a subspace of dimension $3.$\n\n- We are given that $\\text{Null}(D+eI)^{4}$ has dimension $4.$ This means that the solutions to $(D+eI)^{4}v=0$ form a subspace of dimension $4.$\n\nNow, since $\\text{Null}(D+eI)^{3}$ is a subspace of dimension $2$ in $\\text{Null}(D+eI)^{4}$, which is a subspace of dimension $4,$ our basis can contain only $1$ vector that lies in $\\text{Null}(D+eI)^{4}$ but does not lie in $\\text{Null}(D+eI)^{3}.$\n\nTherefore, there will be \n\n$$\n\\text{nullity}(D+eI)^{4}-\\text{nullity}(D+eI)^{3}=4-3=1\n$$\n\n generalized eigenvector of rank $4$ corresponding to the eigenvalue $\\lambda =-e.$" 13194139536086 17592186045417 true] [17592186565487 1058 17592186565516 13194139536086 17592186045417 true] [17592186565487 1062 #uuid "0273e10d-6704-5bf2-969f-e05c1abc5298" 13194139536086 17592186045417 true] [17592186565487 1063 17592186565446 13194139536086 17592186045417 true] [17592186565488 1058 17592186565510 13194139536086 17592186045417 true] [17592186565488 1062 #uuid "0dcdb20b-ebe0-5c21-b7b8-023e7ee38c1e" 13194139536086 17592186045417 true] [17592186565488 1063 17592186565481 13194139536086 17592186045417 true] [17592186565489 1058 17592186565540 13194139536086 17592186045417 true] [17592186565489 1062 #uuid "1866355e-5a27-511e-8e09-7bbdcb7e2ecf" 13194139536086 17592186045417 true] [17592186565489 1063 17592186204598 13194139536086 17592186045417 true] [17592186565490 1062 #uuid "19ff9675-2577-5ff5-a7b4-7a7e7b5cf512" 13194139536086 17592186045417 true] [17592186565490 1063 17592186565433 13194139536086 17592186045417 true] [17592186565491 1062 #uuid "1a0b64b5-8ad7-595a-ad6a-e5e032ce3417" 13194139536086 17592186045417 true] [17592186565491 1063 17592186357733 13194139536086 17592186045417 true] [17592186565492 1058 17592186565503 13194139536086 17592186045417 true] [17592186565492 1062 #uuid "1b47d971-0728-5dcd-be3c-7a4a0a60c7ae" 13194139536086 17592186045417 true] [17592186565492 1063 17592186565483 13194139536086 17592186045417 true] [17592186565493 1058 17592186565515 13194139536086 17592186045417 true] [17592186565493 1062 #uuid "1d6993b8-0e14-54e1-8ab0-bf5e5194170c" 13194139536086 17592186045417 true] [17592186565493 1063 17592186565449 13194139536086 17592186045417 true] [17592186565494 1062 #uuid "1e550813-b681-51bf-a08c-df578a80df5c" 13194139536086 17592186045417 true] [17592186565494 1063 17592186565479 13194139536086 17592186045417 true] [17592