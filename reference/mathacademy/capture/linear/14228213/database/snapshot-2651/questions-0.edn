9dc50544bfa9f1e21970a595c9e61bab4feb67de708b416378a.png)"}] [{:db/id #edb/ref 17592186299579 :knowledge-point/_questions [{:db/id #edb/ref 17592186115369 :knowledge-point/id #uuid "623f4440-ba1a-58ce-9ff2-ccdf591a0d30" :knowledge-point/title "Vertical Reflections of Exponential Decay Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eb47a05-41c7-5eca-ae67-a13bdd7efa56" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/28/28f40459196870b3458b35fb6de68bdba555350c9c7d0e39a067e62fbd628f5d.png" :db/id #edb/ref 17592186297621} {:answer/id #uuid "5f99b2cc-40d6-5bb1-9b8d-ec086d49247f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c0/c0014871af9ecd09b53f8c0bf03d38a26b7200c3004b3e71cb8a8376270f6f66.png" :db/id #edb/ref 17592186297955} {:answer/id #uuid "aa78daf2-6ef7-5085-88f2-31874e1dd9ff" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7a/7a47d0091b2abf6c361c71ac8601700135addbf6f588f31d44f2183ca4229941.png" :db/id #edb/ref 17592186298295} {:answer/id #uuid "ad1a4f6c-4e2a-5535-b53a-fecf35d9359e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f4/f41701c2788f0fdfd39c04a952798fe3b135303e7c75b6a1d192de486c97f261.png" :db/id #edb/ref 17592186298305} {:answer/id #uuid "d9ed0007-9649-5b86-a714-d326b8b19fa5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/25/2585bea4c102fdd732e6b677b09e9758fb5fac2affe408a6dc41cfa69c1154c3.png" :db/id #edb/ref 17592186298487}] :answer-field/correct {:answer/id #uuid "5f99b2cc-40d6-5bb1-9b8d-ec086d49247f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c0/c0014871af9ecd09b53f8c0bf03d38a26b7200c3004b3e71cb8a8376270f6f66.png" :db/id #edb/ref 17592186297955} :answer-field/id #uuid "89fc1caf-cb30-58db-b6c2-dcf48b28d7d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299099}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f5a2bf88-da34-5e50-afc7-6bfeb2513dfb" :question/math-academy-id "q-317294" :question/problem "Which of the following is the graph of $y=-{(\\frac{1}{5})}^{x}+4?$" :question/worked-solution "To plot the given function, we follow these steps:\n\n- We take the curve $y={(\\frac{1}{5})}^{x}.$\n\n![](images/d6/d67114a9865ca54cdf14798e779cfa9c00e71598ba652d6fccdcf686f86e20ef.png)\n\n \n\n- Reflect it on the $x$-axis to give $y=-{(\\frac{1}{5})}^{x}.$ The $y$-intercept moves from $(0,1)$ to $(0,-1)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/d6/d6dcae76f7fe89188ef449c817f7e7af48c25763077d1daee9626d2f26b1a78a.png)\n\n- Then, vertically shift it by $4$ units up to give $y=-{(\\frac{1}{5})}^{x}+4.$ The point $(0,-1)$ moves to $(0,3)$ and the horizontal asymptote moves from $y=0$ to $y=4.$\n\n![](images/52/529dfc1ef1bc6f0ff58addca6cf27c5039a6cf18c5a307c06a153a3d56040ede.png)"}]}
