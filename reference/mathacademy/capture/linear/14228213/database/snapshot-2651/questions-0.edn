186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296972}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c43cf071-5431-5b97-8520-fa4327a185d9" :question/math-academy-id "q-28594" :question/problem "Which of the following is the graph of $y=-{5}^{x}-3?$" :question/worked-solution "To plot the given function, we follow these steps:\n\n- We take the curve $y={5}^{x}.$\n\n![](images/e8/e85f2f0f042f85b5f7c8162b744a5c9d4688a93faf4ccddbad82ca1a9db47f93.png)\n\n- Reflect it on the $x$-axis to give $y=-{5}^{x}.$ The $y$-intercept moves from $(0,1)$ to $(0,-1)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/97/971d4cf0310cced68f72be500d65fff26163a7e2bd5cee005e25e92ca3fb931e.png)\n\n- Then, vertically shift it by $3$ units down to give $y=-{5}^{x}-3.$ The point $(0,-1)$ moves to $(0,-4)$ and the horizontal asymptote moves from $y=0$ to $y=-3.$\n\n![](images/8d/8d4dd11693eda60dc0ed7eb041bdb94c90757f6bb75be3523ce77d01d28534de.png)"}] [{:db/id #edb/ref 17592186299577 :knowledge-point/_questions [{:db/id #edb/ref 17592186115368 :knowledge-point/id #uuid "0f61a7c3-82e6-5f90-8a95-4a79078fd542" :knowledge-point/title "Vertical Reflections of Exponential Growth Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1abcd177-9d88-53b0-a3d1-df1165f91de3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c6/c66a8111377cb868b6e032db70ccb9d196878783426d192bff2866dd6fd732f0.png" :db/id #edb/ref 17592186297669} {:answer/id #uuid "b10255e5-5a33-50eb-b961-18765b8e3679" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/22/22a3ecfad7924f3a43dad98a10eb74f15170a0a6c2209c10e9e100bb2ebfcf22.png" :db/id #edb/ref 17592186298324} {:answer/id #uuid "bd142c73-5a0f-5588-a6f6-b643c45b1c25" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f8/f8d310