              "type": "text",
              "value": "II and IV only",
              "html": "II and IV only"
            },
            {
              "option": "d",
              "dom_id": "questionWidget-choiceLetterCircle-72963-d",
              "type": "text",
              "value": "II only",
              "html": "II only"
