08b17ca939cf6382fd45ee.png)"}] [{:db/id #edb/ref 17592186083674 :knowledge-point/_questions [{:db/id #edb/ref 17592186083166 :knowledge-point/id #uuid "8d887d9f-b9c4-54b3-a53e-691989bda962" :knowledge-point/title "Classifying Odd Functions Graphically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4f58ee5-0c36-56ee-9bd7-5331eac75033" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III and IV only" :db/id #edb/ref 17592186080976} {:answer/id #uuid "c353ceba-981d-58bc-95fb-a85a4e6c5554" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186080977} {:answer/id #uuid "fff7af82-2425-574c-bda3-d8fd8a75f3c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186080978} {:answer/id #uuid "08cbbf4d-ea7a-56f2-87fa-ab9db45db4ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, III, and IV only" :db/id #edb/ref 17592186080979} {:answer/id #uuid "40b0685d-6564-51cf-9721-c6c8cad9d40f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III only" :db/id #edb/ref 17592186080980}] :answer-field/correct {:answer/id #uuid "40b0685d-6564-51cf-9721-c6c8cad9d40f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III only" :db/id #edb/ref 17592186080980} :answer-field/id #uuid "3dcd9337-742e-5c39-9083-01813135fd97" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186080975}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f0f88a98-a327-50e8-b4f1-ca167776d9e7" :question/math-academy-id "q-36558" :question/problem "![](images/92/92436599a8df12b4121e293adc861075d0bc8c7b31628922a7c2d8e2dad1cfef.png)\n\nWhich of the above could be graphs of odd functions?" :question/worked-solution "Recall that the graph of an odd function must have rotational symmetry of order $2$ about the origin.\n\n- Graph IV does not have rotational symmetry of order $2$ about the origin. So, it is **not** an odd function.\n\n- On the other hand, graphs I, II, and III do have rotational symmetry about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that graphs I, II, and III show odd functions.\n\n![](images/22/22c2e88d2e50c722c272e1a10902c58387f0ef00146be4838791c3258badaa5b.png)\n\nTherefore, the correct answer is \"I, II and III only.\""}] [{:db/id #edb/ref 17592186519544 :knowledge-point/_questions [{:db/id #edb/ref 17592186083167 :knowledge-point/id #uuid "8bff4063-9e51-53fa-ab55-e68540e6f587" :knowledge-point/title "Evaluating an Expression Given the Table for an Even or Odd Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "119f1040-3710-5672-b493-ba5c96708717" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186519018} {:answer/id #uuid "3e9ffd7e-17ec-599c-af2f-95e3c60efaf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186519092} {:answer/id #uuid "6989fa89-797b-5c6f-a8d2-ac0000cbb978" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186519147} {:answer/id #uuid "eb4046c3-ab5d-5ffa-87fb-f9c34cb27f83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186519377} {:answer/id #uuid "f9ca8d58-45d6-5f71-a92b-85b4c5c22358" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186519407}] :answer-field/correct {:answer/id #uuid "f9ca8d58-45d6-5f71-a92b-85b4c5c22358" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186519407} :answer-field/id #uuid "a568d026-0c3b-531f-bd83-e4f2456ac0a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519474}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5e293714-80a3-5b8a-84fe-6e44867ed437" :question/math-academy-id "q-36586" :question/problem "The table below defines the function $f(x).$ Given that $f(x)$ is an even function, find the value of $a+b.$\n\n| **$x$** | $-123$ | $-71$ | $-29$ | $29$ | $71$ | $123$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $8$ | $a+12$ | $-4$ | $-4$ | $20$ | $b-2$ |" :question/worked-solution "Since $f(x)$ is an even function, we must have that $f(-x)=f(x).$ \n\nUsing the fact that $f(-71)=f(71),$ we obtain\n\n$$\n\\begin{aligned}f(-71) & =f(71) \\\\ a+12 & =20 \\\\ a & =8.\\end{aligned}\n$$\n\nUsing the fact that $f(-123)=f(123),$ we obtain\n\n$$\n\\begin{aligned}f(-123) & =f(123) \\\\ 8 & =b-2 \\\\ 10 & =b.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b=8+10=18.\n$$"}] [{:db/id #edb/ref 17592186519555 :knowledge-point/_questions [{:db/id #edb/ref 17592186083167 :knowledge-point/id #uuid "8bff4063-9e51-53fa-ab55-e68540e6f587" :knowledge-point/title "Evaluating an Expression Given the Table for an Even or Odd Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18d309e6-06f8-5d84-b32a-1c804a507684" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Neither even nor odd" :db/id #edb/ref 17592186519028} {:answer/id #uuid "32480297-6081-525d-b10e-f53e130d2a40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Both even and odd" :db/id #edb/ref 17592186519072} {:answer/id #uuid "3cac6090-a432-588e-af02-30c09efe0e52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Even" :db/id #edb/ref 17592186519087} {:answer/id #uuid "d9ea1fbe-8d98-574a-b9c8-5c7b1c5ecf66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Odd" :db/id #edb/ref 17592186519350} {:answer/id #uuid "e3033bcd-b5f6-55c5-8c7c-4ea71cd81aee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "It's not a function" :db/id #edb/ref 17592186519367}] :answer-field/correct {:answer/id #uuid "18d309e6-06f8-5d84-b32a-1c804a507684" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Neither even nor odd" :db/id #edb/ref 17592186519028} :answer-field/id #uuid "3725c026-4151-56dc-ac44-063c90fed33e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519431}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7d2fbf06-bec2-5ef7-8e27-5ab81fcb62b5" :question/math-academy-id "q-5891" :question/problem "The table below defines the function $f(x).$ Is the function even, odd, or neither?\n\n| **$x$** | $-99$ | $-52$ | $-8$ | $8$ | $52$ | $99$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $150$ | $70$ | $0$ | $-11$ | $-92$ | $-180$ |" :question/worked-solution "Recall that\n\n- a function is even if $f(-x)=f(x)$ for all $x$ in the domain of $f$\n\n- a function is odd if $f(-x)=-f(x)$ for all $x$ in the domain of $f$\n\nFirst, we have\n\n$$\nf(-99)=150\\ne f(99).\n$$\n\nThis means that $f(-x)\\ne f(x)$ at least for some values of $x$ in the domain of the function. So, the function is not even.\n\nNext, we have\n\n$$\nf(-99)=150\\ne -f(99).\n$$\n\nThis means that $f(-x)\\ne -f(x)$ at least for some values of $x$ in the domain of the function. So, the function is not odd.\n\nHence, the function is neither even nor odd."}] [{:db/id #edb/ref 17592186519539 :knowledge-point/_questions [{:db/id #edb/ref 17592186083185 :knowledge-point/id #uuid "4fa847d9-f0bf-57fb-92b2-27c8a7cdb3b1" :knowledge-point/title "Classifying Even and Odd Functions Using the Algebraic Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cc3320c-6e94-54cf-9a84-428614bcfb8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Both even and odd" :db/id #edb/ref 17592186519112} {:answer/id #uuid "59a3c750-83c0-5d30-820f-b7efc0e1c7ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Even" :db/id #edb/ref 17592186519126} {:answer/id #uuid "6c4aedc1-de2e-563b-bc86-c5f3754b635f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "It's not a function" :db/id #edb/ref 17592186519153} {:answer/id #uuid "ec8e7c5f-4fb1-51ee-b472-bb37d19d9123" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Neither even nor odd" :db/id #edb/ref 17592186519379} {:answer/id #uuid "fa90b234-64ec-5d9a-af2f-f22c3ff06543" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Odd" :db/id #edb/ref 17592186519408}] :answer-field/correct {:answer/id #uuid "ec8e7c5f-4fb1-51ee-b472-bb37d19d9123" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Neither even nor odd" :db/id #edb/ref 17592186519379} :answer-field/id #uuid "c2e66a1c-7b15-548e-aa71-1a2d943218a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519490}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5272ce70-1353-5fba-a94b-5e92203eee02" :question/math-academy-id "q-6694" :question/problem "Is the function $f(x)=-2x-5$ even, odd, or neither?" :question/worked-solution "Recall that\n\n- a function is even if $f(-x)=f(x)$ for all $x$\n\n- a function is odd if $f(-x)=-f(x)$ for all $x$\n\nComputing $f(-x)$ for the given function and comparing it to $f(x),$ we have\n\n$$\n\\begin{aligned}f(-x) & =-2(-x)-5 \\\\  & =2x-5\\end{aligned}\n$$\n\nSince $f(-x)\\ne f(x),$ the function is not even. \n\nLastly, we compute $-f(x)$ and get\n\n$$\n\\begin{aligned}-f(x) & =-(-2x-5) \\\\  & =2x+5\\end{aligned}\n$$\n\nSince $f(-x)\\ne -f(x)$, the function is not odd. \n\nTherefore, the function is neither even nor odd."}] [{:db/id #edb/ref 17592186519538 :knowledge-point/_questions [{:db/id #edb/ref 17592186083185 :knowledge-point/id #uuid "4fa847d9-f0bf-57fb-92b2-27c8a7cdb3b1" :knowledge-point/title "Classifying Even and Odd Functions Using the Algebraic Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a05357a-79f8-5623-ae5b-fe675d744c37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Even" :db/id #edb/ref 17592186519008} {:answer/id #uuid "2362db08-1cbb-5e66-a81c-afb2a5cd191b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Neither even nor odd" :db/id #edb/ref 17592186519049} {:answer/id #uuid "7ee771c2-bd33-567e-a5e8-070cb0549c8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Odd" :db/id #edb/ref 17592186519193} {:answer/id #uuid "c1d9cb46-fbf1-56d0-b3b8-7026d5f7ef3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "It's not a function" :db/id #edb/ref 17592186519312} {:answer/id #uuid "dafffe06-6133-5a84-a06a-81c865b54413" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Both even and odd" :db/id #edb/ref 17592186519353}] :answer-field/correct {:answer/id #uuid "2362db08-1cbb-5e66-a81c-afb2a5cd191b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Neither even nor odd" :db/id #edb/ref 17592186519049} :answer-field/id #uuid "f8e9e694-aced-5daf-bf38-411472cb712e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519509}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "49d7ac71-7387-5bcd-8351-170b2eb2bef2" :question/math-academy-id "q-6695" :question/problem "Is the function $f(x)=3{x}^{3}+x-6$ even, odd, or neither?" :question/worked-solution "Recall that\n\n- a function is even if $f(-x)=f(x)$ for all $x$\n\n- a function is odd if $f(-x)=-f(x)$ for all $x$\n\nComputing $f(-x)$ for the given function and comparing it to $f(x),$ we have\n\n$$\n\\begin{aligned}f(-x) & =3(-x)^{3}+(-x)-6 \\\\  & =-3{x}^{3}-x-6\\end{aligned}\n$$\n\nSince $f(-x)\\ne f(x),$ the function is not even. \n\nLastly, we compute $-f(x)$ and get\n\n$$\n\\begin{aligned}-f(x) & =-(3{x}^{3}+x-6) \\\\  & =-3{x}^{3}-x+6\\end{aligned}\n$$\n\nSince $f(-x)\\ne -f(x)$, the function is not odd. \n\nTherefore, the function is neither even nor odd."}] [{:db/id #edb/ref 17592186519556 :knowledge-point/_questions [{:db/id #edb/ref 17592186083184 :knowledge-point/id #uuid "eb0d0f84-a628-5605-a75f-f4f5459e047c" :knowledge-point/title "Classifying Even Functions Graphically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03a07a2f-66e8-5cfb-826e-bc64ecd6867a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/83/83210d5ce0fa4cfb434c6169f98ae890b2e1ae28bd693f56307c47339e9d1b0c.png" :db/id #edb/ref 17592186518992} {:answer/id #uuid "18f41f27-4cc7-59d9-a413-1ce0cac0eb7f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/21/21b4d9693c6a11a00fa4336dbae09b9d42b816e254b59cf8fbe92f1ed61bd8de.png" :db/id #edb/ref 17592186519031} {:answer/id #uuid "3b91e35f-bcbf-51d7-a570-bc519c79030f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5a/5a0afb22b0441a57edf20395766e889c32958cffeb6c0ba2e1a3b1e3b18a34e0.png" :db/id #edb/ref 17592186519085} {:answer/id #uuid "88eebad6-0421-54fa-b98a-37b348c32bb3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4d/4d01b5a19c0e5348ba465eb04ab83f775a1f280bf35623591db5893627e2d57b.png" :db/id #edb/ref 17592186519210} {:answer/id #uuid "97fa5752-3e92-5fb8-96fa-96443b5af740" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d6/d696874ca59c83b7fb7e31d1c62c6951234e5c06861da6c7954841211b723711.png" :db/id #edb/ref 17592186519241}] :answer-field/correct {:answer/id #uuid "88eebad6-0421-54fa-b98a-37b348c32bb3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4d/4d01b5a19c0e5348ba465eb04ab83f775a1f280bf35623591db5893627e2d57b.png" :db/id #edb/ref 17592186519210} :answer-field/id #uuid "f7391110-537f-5619-a54f-d794f8f0a740" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519508}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7ddac438-ed03-5ef8-ae58-2b427cb03c98" :question/math-academy-id "q-71844" :question/problem "![](images/01/019a969103cb8aca2da4e752240079e90bc1d19e47bdadedfb0a447a3a100367.png)\n\nThe figure above shows part of the graph of $y=f(x)$ which is defined on the interval $x\\in [-4,4].$ Given that $f(x)$ is even, which of the following gives the complete graph of $y=f(x)?$" :question/worked-solution "Recall that the graph of an even function must be symmetric about the $y$-axis.\n\nSo, we can obtain the missing part of the graph by reflecting the given part over the $y$-axis. \n\nTherefore, the complete graph of the function is shown below.\n\n![](images/dc/dcb80b98841bd0c5f08b5ebc8f15abae62dfbe9a4ba0f3a922ea3e482318a96a.png)"}] [{:db/id #edb/ref 17592186519604 :knowledge-point/_questions [{:db/id #edb/ref 17592186083166 :knowledge-point/id #uuid "8d887d9f-b9c4-54b3-a53e-691989bda962" :knowledge-point/title "Classifying Odd Functions Graphically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0323c57c-4737-5776-a48b-663f00324e5c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6b/6bb4d9bc6dac1c33f20a26d775c8fffaa214da65f042c59a6eb3e1326f2debf7.png" :db/id #edb/ref 17592186518990} {:answer/id #uuid "476684d3-fe84-5a11-bdab-1051e8d6a949" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/80/80e8f54a1467c5cb03028d5c540ce0be3af1cc25e1f12228322888eddac692d9.png" :db/id #edb/ref 17592186519103} {:answer/id #uuid "65ac4265-e089-5534-b3ff-9d32858ff41c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/85/850b99f4c14f71ed3c1a3407b8f4930c1b8b90b7586d535c2c77902b93d073a1.png" :db/id #edb/ref 17592186519141} {:answer/id #uuid "97dadd18-d342-598d-9140-94f782a72306" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d7/d7354f0d40e7a17672280657b5ed2c79881f6b64f519dd2327ed83b172f5cd57.png" :db/id #edb/ref 17592186519240} {:answer/id #uuid "d2de1212-6756-5fad-9478-03f4ae2fc81e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d3/d3422a4edce57be47e66820a8260ae04ac429676c90ecd830d8445c8f44f2c22.png" :db/id #edb/ref 17592186519337}] :answer-field/correct {:answer/id #uuid "65ac4265-e089-5534-b3ff-9d32858ff41c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/85/850b99f4c14f71ed3c1a3407b8f4930c1b8b90b7586d535c2c77902b93d073a1.png" :db/id #edb/ref 17592186519141} :answer-field/id #uuid "80d781b4-9a7c-5b28-97c5-a2f91ee969c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519457}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f7f794d6-627b-530b-9219-5208601d87a7" :question/math-academy-id "q-72360" :question/problem "![](images/ad/adcf36236abe7d2e691f8341857c9ef19b12821d7e952de0521d1877f510f326.png)\n\nThe figure above shows part of the graph of $y=f(x)$ which is defined on the interval $x\\in [-2,2].$ Given that $f(x)$ is odd, which of the following gives the complete graph of $y=f(x)?$" :question/worked-solution "Recall that the graph of an odd function must have rotational symmetry of order $2$ about the origin.\n\nSo, we can obtain the missing part of the graph by rotating the given part ${180}^{∘}$ over the origin. \n\nTherefore, the complete graph of the function is shown below.\n\n![](images/f0/f096c9cb18025c79f62fc1a8d700fc920e8cfb2c71040a0c03cc2da8b8346c20.png)"}] [{:db/id #edb/ref 17592186519549 :knowledge-point/_questions [{:db/id #edb/ref 17592186083166 :knowledge-point/id #uuid "8d887d9f-b9c4-54b3-a53e-691989bda962" :knowledge-point/title "Classifying Odd Functions Graphically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d11e356-54df-59ee-a30e-b36afe7a1b88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186519089} {:answer/id #uuid "82059948-380b-59bf-a396-766dbcf6d531" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186519196} {:answer/id #uuid "89b6bbd5-a137-55f7-90db-2bca78c087ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, III, and IV" :db/id #edb/ref 17592186519214} {:answer/id #uuid "bf92eb2f-009e-5bb3-9f3e-21b46e51c97e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186519307} {:answer/id #uuid "d4bb60ab-ba68-5f4e-a482-4ba63a56d8d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186519341}] :answer-field/correct {:answer/id #uuid "82059948-380b-59bf-a396-766dbcf6d531" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186519196} :answer-field/id #uuid "1a9643a0-c55b-5494-90b4-8d6f6ec0d7dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519423}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6c5eea4e-4b84-5cc7-8353-9e67cf3ab163" :question/math-academy-id "q-72963" :question/problem "![](images/da/da6aa84a7b37d9b776f88a7e3b6eb4cf70c303c3c0c463abd313c51bfa0781a2.png)\n\nWhich of the above could be graphs of odd functions?" :question/worked-solution "Recall that the graph of an odd function must have rotational symmetry of order $2$ about the origin.\n\n- Graphs I, III, and IV do not have rotational symmetry of order $2$ about the origin. So, they are **not** odd functions.\n\n- On the other hand, graph II does have rotational symmetry about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that graph II shows an odd function.\n\n![](images/34/348ca99660cff1d4db774d39b543aa7cb79cf0a1787f11046e9b8a4d72fd83e7.png)\n\nTherefore, the correct answer is \"II only.\""}]}
