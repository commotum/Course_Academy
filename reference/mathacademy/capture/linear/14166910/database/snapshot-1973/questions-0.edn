 number $(19)$ by a negative one $(-6).$ So the result will be negative:\n\n$$\n19÷(-6)=-\\boxed{}\n$$\n\nNow, to compute the number that goes in the box, we divide $19$ by $-6$ without any signs: $19÷6=3\\,\\frac{1}{6}.$ Therefore,  we get\n\n$$\n19÷(-6)=-3\\,\\frac{1}{6}.\n$$"}] [{:db/id #edb/ref 17592186491118 :knowledge-point/_questions [{:db/id #edb/ref 17592186064358 :knowledge-point/id #uuid "7de4234d-932f-537c-9eae-746e1711cccd" :knowledge-point/title "Dividing a Positive Number by a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17caec73-9eb6-523a-86fb-b27f98488576" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186490559} {:answer/id #uuid "47bce39b-7e6b-582c-8a7b-066f77808d00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186490645} {:answer/id #uuid "8e4ef98f-abc5-5e98-8041-a38342b8599d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186490796} {:answer/id #uuid "de147237-ad5d-5f58-b44f-b0ef595e5120" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186490931} {:answer/id #uuid "eb05b152-3028-51fb-96ca-91a12c391753" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186490957}] :answer-field/correct {:answer/id #uuid "de147237-ad5d-5f58-b44f-b0ef595e5120" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186490931} :answer-field/id #uuid "c6d0c77a-4046-5f98-9521-dbb913fd4bed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491082}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "12419829-aad3-59c5-99f9-c3ca68b0aa45" :question/math-academy-id "q-75665" :question/problem "$22÷(-11)=$" :question/worked-solution "We have to divide a positive number $(22)$ by a negative one $(-11).$ So the result will be negative:\n\n$$\n22÷(-11)=-\\boxed{}\n$$\n\nNow, to compute the number that goes in the box, we divide $22$ by $11$ without any signs: $22÷11=2.$ Therefore,  we get\n\n$$\n22÷(-11)=-2.\n$$"}] [{:db/id #edb/ref 17592186491216 :knowledge-point/_questions [{:db/id #edb/ref 17592186064359 :knowledge-point/id #uuid "b85ef92b-d5fb-5927-aa68-60e72d0b3e72" :knowledge-point/title "Dividing a Negative Number by a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08c411ff-06f1-50ae-9d29-1123f1bab60d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186490526} {:answer/id #uuid "5bc6dc80-cdb9-5185-ba72-5b0da18b7582" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186490683} {:answer/id #uuid "8249b61b-93f1-54d1-854b-9e287db3d2d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186490773} {:answer/id #uuid "89708e45-ac37-5535-8af3-daf84400d218" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186490784} {:answer/id #uuid "d2880e74-af73-5a7f-8818-28f2c30eaf89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186490906}] :answer-field/correct {:answer/id #uuid "8249b61b-93f1-54d1-854b-9e287db3d2d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186490773} :answer-field/id #uuid "de86693b-0da8-5680-a7f2-4ee5874a75ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #