#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186069739} :activity/id #uuid "4207750e-9221-5674-acec-1d120f06d3d3" :activity/scope {:db/id #edb/ref 17592186050229 :topic/id #uuid "37df2ecc-fe37-586e-8075-7eb42347c2ba" :topic/math-academy-id 458} :activity/steps [{:db/id #edb/ref 17592186069707 :step/content {:db/id #edb/ref 17592186068787 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068631 :question/id #uuid "489ef834-7015-5592-a5f5-b0daa3bc9f7b" :question/math-academy-id "e-6278"} :knowledge-point/id #uuid "b6619614-04df-5a22-afa8-77a41b016330" :knowledge-point/questions [{:db/id #edb/ref 17592186069353} {:db/id #edb/ref 17592186069354} {:db/id #edb/ref 17592186505758} {:db/id #edb/ref 17592186505808}] :knowledge-point/title "Expressing a Union of Overlapping Intervals Given Graphically"} :step/id #uuid "d06f5800-1be7-5609-b455-6c1d38707d7d" :step/math-academy-id 23592 :step/next {:db/id #edb/ref 17592186069883}} {:db/id #edb/ref 17592186069739 :step/content {:db/id #edb/ref 17592186069934 :tutorial/content "Suppose we want to represent the following number line graph using interval notation:\n\n![](images/0b/0bf5e420e2929032c11964e15d710014fb34d559aa065428b9d57fff14d10eb0.png)\n\nThis number line consists of the interval $(-3, -1)$ as well as the interval $(1, 3).$\n\nTo express the combination of these two intervals, we create a **union of intervals** using the **union sign** $\\cup$ as follows: \n\n$$\n(-3, -1) \\cup (1, 3)\n$$" :tutorial/id #uuid "3a3780a2-b10d-5640-a797-ea56e4eee1af" :tutorial/math-academy-id 1422 :tutorial/title "Introduction"} :step/id #uuid "b0fb12dd-e8a8-5a10-9f60-f1d994766e86" :step/math-academy-id 3167 :step/next {:db/id #edb/ref 17592186069740}} {:db/id #edb/ref 17592186069740 :step/content {:db/id #edb/ref 17592186068811 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068666 :question/id #uuid "d0e51ce4-7f83-545e-9c3c-b79bf58d0eab" :question/math-academy-id "e-952"} :knowledge-point/id #uuid "eee95dd4-7d0c-5c18-bcb0-9b033e0cb509" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049162}] :knowledge-point/questions [{:db/id #edb/ref 17592186069028} {:db/id #edb/ref 17592186069449} {:db/id #edb/ref 17592186505743} {:db/id #edb/ref 17592186505781}] :knowledge-point/title "Expressing an Inequality as a Union of Intervals"} :step/id #uuid "325b8527-c92b-5ecd-b56e-5c14cc0b6cf5" :step/math-academy-id 3168 :step/next {:db/id #edb/ref 17592186069741}} {:db/id #edb/ref 17592186069741 :step/content {:db/id #edb/ref 17592186068812 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068667 :question/id #uuid "c575830c-0100-5cec-a3f8-70e29cba3b54" :question/math-academy-id "e-954"} :knowledge-point/id #uuid "1300ab0b-313f-5489-a836-79cf200082f6" :knowledge-point/questions [{:db/id #edb/ref 17592186069202} {:db/id #edb/ref 17592186069325} {:db/id #edb/ref 17592186505747} {:db/id #edb/ref 17592186505816}] :knowledge-point/title "Expressing a Union of Non-Overlapping Intervals as an Inequality"} :step/id #uuid "655fb4ff-9084-5ff0-9f76-e5c230ef695e" :step/math-academy-id 3172 :step/next {:db/id #edb/ref 17592186069884}} {:db/id #edb/ref 17592186069883 :step/content {:db/id #edb/ref 17592186068906 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068521 :question/id #uuid "9cf4daed-1d80-5a74-90dc-b0b1da0ce6b9" :question/math-academy-id "e-1695"} :knowledge-point/id #uuid "5a74d2eb-fe22-5c2d-b31f-9446f8f080d3" :knowledge-point/questions [{:db/id #edb/ref 17592186069194} {:db/id #edb/ref 17592186069450} {:db/id #edb/ref 17592186505839}] :knowledge-point/title "Expressing a Union of Overlapping Intervals"} :step/id #uuid "5832944b-422f-5154-8451-6dc2929473ea" :step/math-academy-id 5562} {:db/id #edb/ref 17592186069884 :step/content {:db/id #edb/ref 17592186069950 :tutorial/content "Sometimes, the union of two intervals can simplify into a single interval. For example, consider the union\n\n$$\n(-3,2) \\cup (0,4).\n$$\n\nIf we plot these two intervals on number lines, we get the following:\n\n![](images/4a/4aafe0cdf9f5b27d99538bbaacbf567ded823189399e518f2ead7381da35e84c.png)\n\n![](images/4a/4a26c3aa30f2aab862b31624ba08e3a575fee511e46f89abf62c26aa38dd811f.png)\n\nThe union of the two intervals consists of all the points which are contained within at least one of the intervals. So, to graph the union of the two intervals, we take the graphs of the individual intervals and lay them on top of each other.\n\nThe resulting graph is as follows:\n\n![](images/83/835f7e883cf1aba1945f9cecab382ddc163e1c2413895c8b2f8d1d61ae81d1a0.png)\n\nThis graph represents the interval $(-3,4).$ So, the union $(-3,2) \\cup (0,4)$ simplifies to the interval $(-3,4).$" :tutorial/id #uuid "a4af4ad6-6c9c-552b-8ab9-8cb92744e7c6" :tutorial/math-academy-id 1798 :tutorial/title "The Union of Overlapping Intervals"} :step/id #uuid "423acfad-41bd-5f38-909c-92b01da8da23" :step/math-academy-id 5564 :step/next {:db/id #edb/ref 17592186069707}}] :activity/title "Unions of Intervals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068985}]}
