#{[{:db/id #edb/ref 17592186054390 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054666 :knowledge-point/id #uuid "b57ffad1-b83f-5ebb-b0fe-928566ffe8b6" :knowledge-point/title "Finding the Equation of a Horizontal Line"}] :question/id #uuid "ff34ddfb-7ea8-505a-8a4f-7898d7f5c3c0" :question/math-academy-id "e-12902" :question/problem "Identify the equation that corresponds to the graph below.\n\n![](images/43/438de2ca2258d658868c730115b7d30d99aa46193accd6478f7400486b8db1f5.png)" :question/worked-solution "The graph is a horizontal line where the $y$-value of every point is $-1$. Consequently, its equation is $y = -1$."}] [{:db/id #edb/ref 17592186054391 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054668 :knowledge-point/id #uuid "9b84d144-1a2b-5007-817e-20a5d6446515" :knowledge-point/title "Identifying a Horizontal or Vertical Line"}] :question/id #uuid "1af37b2d-2400-5e55-b7b6-6d9652204f4c" :question/math-academy-id "e-12903" :question/problem "![](images/45/45ba98becc788f2c39f7e03b13b021beebce36e8cf3c8f50299bdfba041dfff4.png)\n\nWhich of the plots above shows the following lines?\n\n- $x=-1$\n- $y=-1$" :question/worked-solution "- On the line $x=-1$, every point has an $x$-coordinate of $-1$. Therefore, graph II represents this equation.\n- On the line $y=-1$, every point has an $y$-coordinate of $-1$. Therefore, graph III represents this equation."}] [{:db/id #edb/ref 17592186054392 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054669 :knowledge-point/id #uuid "bf635847-145c-5da5-927e-8196e809324e" :knowledge-point/title "Points Associated With Horizontal and Vertical Lines"}] :question/id #uuid "03ebd3ab-aa4d-5bf4-9079-62cde6da307d" :question/math-academy-id "e-12904" :question/problem "A horizontal line in the $xy$-plane passes through the point $(-2,4)$. What is the equation of the line? Does the point $(4,-2)$ lie on that line?" :question/worked-solution "Since the horizontal line passes through $(-2,4)$, every point on the line has a $y$-coordinate of $4$. So, the equation of that line is $y=4$.\n\nThe $y$-coordinate of the point $(4,-2)$ is $-2$, but all points on the line $y=4$ have a $y$-coordinate of $4$. So, the point $(4,-2)$ is not on the line.\n\n![](images/0f/0fa994fe8d3da1428d803aa0c6d6c1470eab0fd23e24cd0edd67bb213efec068.png)"}] [{:db/id #edb/ref 17592186054491 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054667 :knowledge-point/id #uuid "1f626489-1967-542a-8782-35596cffc7a4" :knowledge-point/title "Finding the Equation of a Vertical Line"}] :question/id #uuid "fa11d81b-2154-584a-9fd0-ce4399fd3a93" :question/math-academy-id "e-15644" :question/problem "Identify the equation in **standard form** that corresponds to the graph below.\n\n![](images/f0/f06745bbdea9d8554e5c9d4b4cfa842156348db728233a99fb00b5137bd12c91.png)" :question/worked-solution "The graph is a vertical line where the $x$-value of every point is $1$. Consequently, its equation is $x=1$."}] [{:db/id #edb/ref 17592186055423 :knowledge-point/_questions [{:db/id #edb/ref 17592186054666 :knowledge-point/id #uuid "b57ffad1-b83f-5ebb-b0fe-928566ffe8b6" :knowledge-point/title "Finding the Equation of a Horizontal Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "983548f4-cbe8-5f13-830f-00ca3dfce1d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = x - 2" :db/id #edb/ref 17592186053776} {:answer/id #uuid "bb82c791-9052-5ae0-b8f9-de245f5540cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y =-2" :db/id #edb/ref 17592186053777} {:answer/id #uuid "c5531799-1189-5b0f-a2cc-975efca48f1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x =-2" :db/id #edb/ref 17592186053778} {:answer/id #uuid "234f1412-967c-54eb-8b54-5c3c170e1632" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = 2" :db/id #edb/ref 17592