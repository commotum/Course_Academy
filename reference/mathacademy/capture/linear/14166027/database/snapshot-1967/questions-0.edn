#{[{:db/id #edb/ref 17592186054390 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054666 :knowledge-point/id #uuid "b57ffad1-b83f-5ebb-b0fe-928566ffe8b6" :knowledge-point/title "Finding the Equation of a Horizontal Line"}] :question/id #uuid "ff34ddfb-7ea8-505a-8a4f-7898d7f5c3c0" :question/math-academy-id "e-12902" :question/problem "Identify the equation that corresponds to the graph below.\n\n![](images/43/438de2ca2258d658868c730115b7d30d99aa46193accd6478f7400486b8db1f5.png)" :question/worked-solution "The graph is a horizontal line where the $y$-value of every point is $-1.$ Consequently, its equation is $y = -1.$"}] [{:db/id #edb/ref 17592186054391 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054668 :knowledge-point/id #uuid "9b84d144-1a2b-5007-817e-20a5d6446515" :knowledge-point/title "Identifying a Horizontal or Vertical Line"}] :question/id #uuid "1af37b2d-2400-5e55-b7b6-6d9652204f4c" :question/math-academy-id "e-12903" :question/problem "![](images/45/45ba98becc788f2c39f7e03b13b021beebce36e8cf3c8f50299bdfba041dfff4.png)\n\nWhich of the plots above shows the following lines?\n\n- $x=-1$\n\n- $y=-1$" :question/worked-solution "- On the line $x=-1,$ every point has an $x$-coordinate of $-1.$ Therefore, graph II represents this equation.\n\n- On the line $y=-1,$ every point has an $y$-coordinate of $-1.$ Therefore, graph III represents this equation."}] [{:db/id #edb/ref 17592186054392 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054669 :knowledge-point/id #uuid "bf635847-145c-5da5-927e-8196e809324e" :knowledge-point/title "Points Associated With Horizontal and Vertical Lines"}] :question/id #uuid "03ebd3ab-aa4d-5bf4-9079-62cde6da307d" :question/math-academy-id "e-12904" :question/problem "A horizontal line in the $xy$-plane passes through the point $(- 2,4).$ What is the equation of the line? Does the point $(4,-2)$ lie on that line?" :question/worked-solution "Since the horizontal line passes through $(-2,4)$, every point on the line has a $y$-coordinate of $4.$ So, the equation of that line is $y=4.$\n\nThe $y$-coordinate of the point $(4,-2)$ is $-2,$ but all points on the line $y=4$ have a $y$-coordinate of $4.$ So, the point $(4,-2)$ is not on the line.\n\n![](images/0f/0fa994fe8d3da1428d803aa0c6d6c1470eab0fd23e24cd0edd67bb213efec068.png)"}] [{:db/id #edb/ref 17592186054491 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054667 :knowledge-point/id #uuid "1f626489-1967-542a-8782-35596cffc7a4" :knowledge-point/title "Finding the Equation of a Vertical Line"}] :question/id #uuid "fa11d81b-2154-584a-9fd0-ce4399fd3a93" :question/math-academy-id "e-15644" :question/problem "Identify the equation in **standard form** that corresponds to the graph below.\n\n![](images/f0/f06745bbdea9d8554e5c9d4b4cfa842156348db728233a99fb00b5137bd12c91.png)" :question/worked-solution "The graph is a vertical line where the $x$-value of every point is $1.$ Consequently, its equation is $x=1.$"}] [{:db/id #edb/ref 17592186490253 :knowledge-point/_questions [{:db/id #edb/ref 17592186054668 :knowledge-point/id #uuid "9b84d144-1a2b-5007-817e-20a5d6446515" :knowledge-point/title "Identifying a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bc8e839-7e91-521c-b633-48289cbb7181" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/00/00b0a9c54b56b91417cb89752b39b1d5969ca631cc56da84815a0bb5d4cbead3.png" :db/id #edb/ref 17592186489541} {:answer/id #uuid "1ad2f4b9-6eb7-564a-9f7b-a205733d0de8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c5/c5eae02d54bf108bd88a4677dcaf52ea0fe8a0f61c77439886dd6635ab7e744d.png" :db/id #edb/ref 17592186489575} {:answer/id #uuid "721305ad-9cc2-54b8-b794-08a770da1ba4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d0/d0aacfab25d895aeab649b133a6acd9e4f23c6fca1bbc7975fbae