#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055621} :activity/id #uuid "4fd2aaf3-6b86-52c0-bd25-cdccd740e574" :activity/scope {:db/id #edb/ref 17592186050763 :topic/id #uuid "64c4dbd5-509e-506d-ad70-5a35f835770e" :topic/math-academy-id 97} :activity/steps [{:db/id #edb/ref 17592186055621 :step/content {:db/id #edb/ref 17592186056014 :tutorial/content "Suppose that we wish to find the equation of the **horizontal line** that passes through the point $(0,3)$, as shown below:\n\n![](images/37/379af2ba930fa537f1fbdda5b4b5cc91e355a46e90918cdc56bbce66f3502d7b.png)\n\nNotice that for *any* $x$-value on the line, the $y$-value is always $\\color{red}3.$ \n\n![](images/ff/ff5ec246a558fc981ba5f0b0085ce3663ac6ab837121f31a5d44de6adb91cb90.png)\n\nTherefore, the equation of the line is $y=3.$\n\n**Note**: When writing the equation of a horizontal line, we always put the variable $y$ on the left side and the constant on the right side." :tutorial/id #uuid "8d036bf9-1cb2-59e4-a418-b586ec35d56e" :tutorial/math-academy-id 8070 :tutorial/title "Introduction"} :step/id #uuid "4925b445-d5c7-5a6b-a5f1-da050fb02303" :step/math-academy-id 191798 :step/next {:db/id #edb/ref 17592186055622}} {:db/id #edb/ref 17592186055622 :step/content {:db/id #edb/ref 17592186054666 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054390 :question/id #uuid "ff34ddfb-7ea8-505a-8a4f-7898d7f5c3c0" :question/math-academy-id "e-12902"} :knowledge-point/id #uuid "b57ffad1-b83f-5ebb-b0fe-928566ffe8b6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050517} {:db/id #edb/ref 17592186050790}] :knowledge-point/questions [{:db/id #edb/ref 17592186055063} {:db/id #edb/ref 17592186055423} {:db/id #edb/ref 17592186490260} {:db/id #edb/ref 17592186490295} {:db/id #edb/ref 17592186490307}] :knowledge-point/title "Finding the Equation of a Horizontal Line"} :step/id #uuid "2922d040-74f4-5896-83b7-35b38603c224" :step/math-academy-id 191799 :step/next {:db/id #edb/ref 17592186055623}} {:db/id #edb/ref 17592186055623 :step/content {:db/id #edb/ref 17592186056015 :tutorial/content "Suppose that we want to find the equation of the **vertical line** that passes through the point $(-4,0)$, as shown below:\n\n![](images/06/065dfc149c1624bbe2c6fd51085c48b5e60c1d37d248d073dd1374d08e65b5af.png)\n\nNotice that for *any* $y$-value on the line, the $x$-value is always $\\color{red}-4.$ \n\n![](images/01/01d24274cc3d2b5a7899cc1aa8cee4aef4fb02ddb45acd27629a57d6af41a398.png)\n\nTherefore, the equation of this vertical line is $x=-4.$\n\n**Note**: When writing the equation of a vertical line, we always put the variable $x$ on the left side and the constant on the right side." :tutorial/id #uuid "fcdbdf94-22ce-5781-9f56-42dc93763172" :tutorial/math-academy-id 8071 :tutorial/title "Vertical Lines"} :step/id #uuid "3e8762cd-7d9e-50f2-bb1b-c07fd53a30c1" :step/math-academy-id 191802 :step/next {:db/id #edb/ref 17592186055624}} {:db/id #edb/ref 17592186055624 :step/content {:db/id #edb/ref 17592186054667 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054491 :question/id #uuid "fa11d81b-2154-584a-9fd0-ce4399fd3a93" :question/math-academy-id "e-15644"} :knowledge-point/id #uuid "1f626489-1967-542a-8782-35596cffc7a4" :knowledge-point/questions [{:db/id #edb/ref 17592186055045} {:db/id #edb/ref 17592186055424} {:db/id #edb/ref 17592186490306} {:db/id #edb/ref 17592186490308}] :knowledge-point/title "Finding the Equation of a Vertical Line"} :step/id #uuid "95b8d112-1200-5651-b046-ddd819995d89" :step/math-academy-id 191803 :step/next {:db/id #edb/ref 17592186055625}} {:db/id #edb/ref 17592186055625 :step/content {:db/id #edb/ref 17592186054668 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054391 :question/id #uuid "1af37b2d-2400-5e55-b7b6-6d9652204f4c" :question/math-academy-id "e-12903"} :knowledge-point/id #uuid "9b84d144-1a2b-5007-817e-20a5d6446515" :knowledge-point/questions [{:db/id #edb/ref 17592186055129} {:db/id #edb/ref 17592186055428} {:db/id #edb/ref 17592186490250} {:db/id #edb/ref 17592186490253}] :knowledge-point/title "Identifying a Horizontal or Vertical Line"} :step/id #uuid "f599f285-d643-5707-ac7a-89a8993f9002" :step/math-academy-id 191806 :step/next {:db/id #edb/ref 17592186055626}} {:db/id #edb/ref 17592186055626 :step/content {:db/id #edb/ref 17592186054669 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054392 :question/id #uuid "03ebd3ab-aa4d-5bf4-9079-62cde6da307d" :question/math-academy-id "e-12904"} :knowledge-point/id #uuid "bf635847-145c-5da5-927e-8196e809324e" :knowledge-point/questions [{:db/id #edb/ref 17592186055054} {:db/id #edb/ref 17592186055068} {:db/id #edb/ref 17592186055292} {:db/id #edb/ref 17592186235488} {:db/id #edb/ref 17592186490251} {:db/id #edb/ref 17592186490265}] :knowledge-point/title "Points Associated With Horizontal and Vertical Lines"} :step/id #uuid "30da6f5a-53a7-5a1c-9b14-200b76e84b56" :step/math-academy-id 191809}] :activity/title "Horizontal and Vertical Lines" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054937}]}
