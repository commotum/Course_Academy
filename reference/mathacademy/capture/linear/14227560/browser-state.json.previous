jx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo stretchy=\"false\">(</mo><mtext>T</mtext><mn>4</mn><mo stretchy=\"false\">)</mo><mo accent=\"false\" stretchy=\"false\">→</mo><mo stretchy=\"false\">(</mo><mtext>T</mtext><mn>2</mn><mo stretchy=\"false\">)</mo><mo accent=\"false\" stretchy=\"false\">→</mo><mo stretchy=\"false\">(</mo><mtext>T</mtext><mn>3</mn><mo stretchy=\"false\">)</mo><mo>.</mo></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
