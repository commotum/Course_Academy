#{[{:db/id #edb/ref 17592186549039 :knowledge-point/_questions [{:db/id #edb/ref 17592186078510 :knowledge-point/id #uuid "2c2387a4-202d-528a-b0ca-3f87d5a06ea3" :knowledge-point/title "Determining the Correct Order of Transformations Given a Transformed Function Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b94df81-13c9-5d2e-8eb9-88bce32c5d26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\text{T}4)\\to (\\text{T}3)\\to (\\text{T}1)" :db/id #edb/ref 17592186548402} {:answer/id #uuid "5e6a4c4d-e439-579f-b03d-3f49d6e8866e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\text{T}2)\\to (\\text{T}4)\\to (\\text{T}1)" :db/id #edb/ref 17592186548528} {:answer/id #uuid "5f43e829-377d-588f-b3f4-35d2ad572442" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\text{T}3)\\to (\\text{T}4)\\to (\\text{T}1)" :db/id #edb/ref 17592186548530} {:answer/id #uuid "a56f0fc4-5c0f-5083-b821-55e535ad2c60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\text{T}1)\\to (\\text{T}4)\\to (\\text{T}2)" :db/id #edb/ref 17592186548681} {:answer/id #uuid "c075a111-f868-5188-9ba9-3a5f5292a779" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\text{T}1)\\to (\\text{T}3)\\to (\\text{T}4)" :db/id #edb/ref 17592186548736}] :answer-field/correct {:answer/id #uuid "5e6a4c4d-e439-579f-b03d-3f49d6e8866e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\text{T}2)\\to (\\text{T}4)\\to (\\text{T}1)" :db/id #edb/ref 17592186548528} :answer-field/id #uuid "1db9c8b6-c498-58eb-a73c-ab6c2a805e78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186548878}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a9454265-8028-5150-af82-6933624c324f" :question/math-academy-id "q-112955" :question/problem "The graph of $y=3f(5x-15),$ can be obtained from the graph of $y=f(x)$ by applying **some** of the following transformations:\n\n- $(\\text{T}1)$ - Stretch by a scale factor of $3$ parallel to the $y$-axis\n\n- $(\\text{T}2)$ - Stretch by a scale factor of $0.2$ parallel to the $x$-axis\n\n- $(\\text{T}3)$ - Stretch by a scale factor of $5$ parallel to the $x$-axis\n\n- $(\\text{T}4)$ - Translate right by $3$ units\n\nWhich of the following could be a possible ordering of the appropriate transformations?" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches, followed by vertical translations.\n\nFirst, let's factor out the coefficient next to the $x$ inside the function:\n\n$$\ny=3f(5x-15)=3f(5(x-3))\n$$\n\nTo get $y=3f(5(x-3)),$ we could apply the following steps:\n\n- Take the curve $y=f(x).$\n\n- Apply transformation $(\\text{T}2).$ Stretch $y=f(x)$ by a scale factor of $\\frac{1}{5}=0.2$ parallel to the $x$-axis to get the graph of \n\n$$\ny=f(5x).\n$$\n\n- Apply transformation $(\\text{T}4).$ Translate $y=f(5x)$ right by $3$ units to get the graph of \n\n$$\ny=f(5(x-3)).\n$$\n\n- Apply transformation $(\\text{T}1).$ Stretch $y=f(5(x-3))$ by a scale factor of $3$ parallel to the $y$-axis to get the graph of \n\n$$\ny=3f(5(x-3)).\n$$\n\nTherefore, a possible order of transformations is\n\n$\\,$ $(\\text{T}2)\\to (\\text{T}4)\\to (\\text{T}1).$"}] [{:db/id #edb/ref 17592186549005 :knowledge-point/_questions [{:db/id #edb/ref 17592186078510 :knowledge-point/id #uuid "2c2387a4-202d-528a-b0ca-3f87d5a06ea3" :knowledge-point/title "Determining the Correct Order of Transformations Given a Transformed Function Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0db0e1b6-b15e-5702-b4eb-23afbb278ad9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\text{T}4)\\to (\\text{T}3)\\to (\\text{T}2)\\to (\\text{T}1)" :db/id #edb/ref 17592186548385} {:answer/id #uuid "3ead96e5-9ccc-55be-bf55-9fff19987ddf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\text{T}4)\\to (\\text{T}3)\\to (\\text{T}5)" :db/id #edb/ref 17592186548474} {:answer/id #uuid "84c6764a-4bfc-516a-86e1-dea5f1cc141f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\text{T}4)\\to (\\text{T}5)\\to (\\text{T}3)" :db/id #edb/ref 17592186548611} {:answer/id #uuid "9130b0d1-296f-54fe-866a-5d9499a8522f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\text{T}4)\\to (\\text{T}3)\\to (\\text{T}1)\\to (\\text{T}2)" :db/id #edb/ref 17592186548639} {:answer/id #uuid "b047744c-b2e2-51d7-b12c-1fa93bce8cb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\text{T}3)\\to (\\text{T}4)\\to (\\text{T}2)\\to (\\text{T}1)" :db/id #edb/ref 17592186548702}] :answer-field/correct {:answer/id #uuid "0db0e1b6-b15e-5702-b4eb-23afbb278ad9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\text{T}4)\\to (\\text{T}3)\\to (\\text{T}2)\\to (\\text{T}1)" :db/id #edb/ref 17592186548385} :answer-field/id #uuid "014d1aa7-6876-598e-b36b-73f23d2e7df3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186548865}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "56fcd68f-be15-5bdd-9b31-95eea95afa89" :question/math-academy-id "q-87046" :question/problem "The graph of $y=7f(2x-2)+5,$ can be obtained from the graph of $y=f(x)$ by applying **some** of the following transformations:\n\n- $(\\text{T}1)$ - Translate up by $5$ units\n\n- $(\\text{T}2)$ - Stretch by a scale factor of $7$ parallel to the $y$-axis\n\n- $(\\text{T}3)$ - Translate right by $1$ unit\n\n- $(\\text{T}4)$ - Stretch by a scale factor of $0.5$ parallel to the $x$-axis\n\n- $(\\text{T}5)$ - Translate right by $2$ units\n\nWhich of the following could be a possible ordering of the appropriate transformations?" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches, followed by vertical translations.\n\nFirst, let's factor out the coefficient next to the $x$ inside the function:\n\n$$\ny=7f(2x-2)+5=7f(2(x-1))+5\n$$\n\nTo get $y=7f(2(x-1))+5,$ we could apply the following steps:\n\n- Take the curve $y=f(x).$\n\n- Apply transformation $(\\text{T}4).$ Stretch $y=f(x)$ by a scale factor of $\\frac{1}{2}=0.5$ parallel to the $x$-axis to get the graph of \n\n$$\ny=f(2x).\n$$\n\n- Apply transformation $(\\text{T}3).$ Translate $y=f(2x)$ right by $1$ unit to get the graph of \n\n$$\ny=f(2(x-1)).\n$$\n\n- Apply transformation $(\\text{T}2).$ Stretch $y=f(2(x-1))$ by a scale factor of $7$ parallel to the $y$-axis to get the graph of \n\n$$\ny=7f(2(x-1)).\n$$\n\n- Apply transformation $(\\text{T}1).$ Translate $y=7f(2(x-1))$ up by $5$ units to get the graph of \n\n$$\ny=7f(2(x-1))+5.\n$$\n\nTherefore, a possible order of transformations is\n\n$\\,$ $(\\text{T}4)\\to (\\text{T}3)\\to (\\text{T}2)\\to (\\text{T}1).$"}] [{:db/id #edb/ref 17592186079219 :knowledge-point/_questions [{:db/id #edb/ref 17592186078510 :knowledge-point/id #uuid "2c2387a4-202d-528a-b0ca-3f87d5a06ea3" :knowledge-point/title "Determining the Correct Order of Transformations Given a Transformed Function Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16989c60-1053-533b-9f14-b9ea3d24df0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\text{T}4)\\to (\\text{T}2)\\to (\\text{T}3)" :db/id #edb/ref 17592186548396} {:answer/id #uuid "3df56a22-be89-53fc-a186-949e5208a495" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\text{T}3)\\to (\\text{T}2)\\to (\\text{T}4)" :db/id #edb/ref 17592186548472} {:answer/id #uuid "c2f27536-7f52-5f15-81d2-99bca9257fa6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\text{T}2)\\to (\\text{T}4)\\to (\\text{T}1)" :db/id #edb/ref 17592186548743} {:answer/id #uuid "e587188b-268f-535d-aee2-c34d70d9f812" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\text{T}4)\\to (\\text{T}2)\\to (\\text{T}1)" :db/id #edb/ref 17592186548803} {:answer/id #uuid "fa5d3062-3532-5d26-b4cb-17046684e70f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\text{T}1)\\to (\\text{T}2)\\to (\\text{T}4)" :db/id #edb/ref 17592186548857}] :answer-field/correct {:answer/id #uuid "16989c60-1053-533b-9f14-b9ea3d24df0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\text{T}4)\\to (\\text{T}2)\\to (\\text{T}3)" :db/id #edb/ref 17592186548396} :answer-field/id #uuid "ab07e844-c0d5-5c67-88f0-da904b950fef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186078092}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0e1845bd-ab9c-5876-9015-5e45dd5e00ef" :question/math-academy-id "q-87488" :question/problem "The graph of $y=4f(2x)-3,$ can be obtained from the graph of $y=f(x)$ by applying **some** of the following transformations:\n\n- $(\\text{T}1)$ - Translate up by $3$ units\n\n- $(\\text{T}2)$ - Stretch by a scale factor of $4$ parallel to the $y$-axis\n\n- $(\\text{T}3)$ - Translate down by $3$ units\n\n- $(\\text{T}4)$ - Stretch by a scale factor of $0.5$ parallel to the $x$-axis\n\nWhich of the following could be a possible ordering of the appropriate transformations?" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches, followed by vertical translations.\n\nTo get $y=4f(2x)-3,$ we could apply the following steps:\n\n- Take the curve $y=f(x).$\n\n- Apply transformation $(\\text{T}4).$ Stretch $y=f(x)$ by a scale factor of $\\frac{1}{2}=0.5$ parallel to the $x$-axis to get the graph of \n\n$$\ny=f(2x).\n$$\n\n- Apply transformation $(\\text{T}2).$ Stretch $y=f(2x)$ by a scale factor of $4$ parallel to the $y$-axis to get the graph of \n\n$$\ny=4f(2x).\n$$\n\n- Apply transformation $(\\text{T}3).$ Translate $y=4f(2x)$ down by $3$ units to get the graph of \n\n$$\ny=4f(2x)-3.\n$$\n\nTherefore, a possible order of transformations is\n\n$\\,$ $(\\text{T}4)\\to (\\text{T}2)\\to (\\text{T}3).$"}]}
