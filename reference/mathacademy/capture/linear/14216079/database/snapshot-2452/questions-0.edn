ld.type/radio} :db/id #edb/ref 17592186527112}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "818b8208-c98b-5ec3-a330-6bbba9ff0a1a" :question/math-academy-id "q-69733" :question/problem "Which of the following is the graph of $y=-(x-3)^{3}?$" :question/worked-solution "Since we have $-3$ inside the brackets, we translate the graph of $y=-{x}^{3}$ by $3$ units to the *right*. \n\nSo, the graph of $y=-(x-3)^{3}$ looks as follows:\n\n![](images/e4/e4afdd5a6c2b466b9447f7c9c0d0e4c885f17aa219e557bf9589bff88aeea0ae.png)"}]}
