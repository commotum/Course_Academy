#{[{:db/id #edb/ref 17592186115096 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115267 :knowledge-point/id #uuid "e509fc70-f78c-5daa-bf55-e23ed6a2b046" :knowledge-point/title "Identifying a Graph of an Elementary Cubic Function"}] :question/id #uuid "4868c33a-6977-573e-ad7a-bd219fa3a200" :question/math-academy-id "e-5046" :question/problem "Which of the following plots is the graph of $y = -x^3$?\n\n![](images/ba/babbe4306b4a068c96f9dc820af3b02a6e25d5779928108f3d783dc0684fdf27.png)" :question/worked-solution "First, remember that for $x>0$, the graph of $y=-x^3$ decreases very rapidly as we increase $x$. We say that $y \\rightarrow -\\infty$ as $x \\rightarrow \\infty$. The only graphs that exhibit this decreasing property are III and IV.\n\nNow, we need to choose between graphs III and IV. To do this, let's evaluate $y=-x^3$ at some value of $x$, say $x=1$. Substituting $x=1$ into the function, we get\n\n$$\ny = -(1)^3 = -1\n$$\n\nso the correct graph must pass through the point $(1,-1)$. Only graph III satisfies this criterion.\n\nTherefore, graph III corresponds to the graph of $y=-x^3$."}] [{:db/id #edb/ref 17592186115097 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115268 :knowledge-point/id #uuid "40093136-bd98-5ca4-838e-58e47b317950" :knowledge-point/title "Graphing Vertical Translations of Elementary Cubic Functions"}] :question/id #uuid "16ea2f1f-3e5e-547d-8172-02fbe49c2ce7" :question/math-academy-id "e-5047" :question/problem "Sketch the graph of $y=x^3+2$." :question/worked-solution "Since we have\n\n$$\ny=x^3{\\color{blue}\\,+\\,2}\n$$\n\nwe need to translate the graph of $y=x^3$ *up* by $\\color{blue}2$ units.\n\nSo, the graph of\n\n$$\ny=x^3+2\n$$\n\nlooks as follows:\n\n![](images/54/54030b86feaed3fd9b3e818654dae831f4456159d6ae32f5e3619b6f0e1369a7.png)"}] [{:db/id #edb/ref 17592186115098 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115269 :knowledge-point/id #uuid "b8acb08f-56b0-5a1b-b503-ba70e1cf88e6" :knowledge-point/title "Graphing Horizontal Translations of Elementary Cubic Functions"}] :question/id #uuid "59505e8f-fe13-5096-9186-b1ea1a095432" :question/math-academy-id "e-5048" :question/problem "Sketch the graph of $y=(x-2)^3$." :question/worked-solution "Since we have $\\color{blue}-2$ inside the brackets, we translate the graph of $y=x^3$ by $\\color{blue}2$ units to the *right*.\n\nSo, the graph of $y=(x-2)^3$ looks as follows:\n\n![](images/82/82978268bdfe405201f3b5e3e8927c81c3379bcf2933a34e15b6ba304cbd770d.png)"}] [{:db/id #edb/ref 17592186115099 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115270 :knowledge-point/id #uuid "6f1cf641-888f-576c-b9c3-0bdf62a00fb8" :knowledge-point/title "Combining Horizontal and Vertical Translations of Elementary Cubic Functions"}] :question/id #uuid "07f7ddf8-109e-5cc4-b089-16e03f3f2915" :question/math-academy-id "e-5054" :question/problem "Plot the graph of $y=-(x+1)^3-3$." :question/worked-solution "The given function can be obtained by translating $y=-x^3$ both horizontally and vertically.\n\nWe have two translations:\n\n- the $\\color{red}+1$ inside the parentheses means a horizontal translation of $1$ unit to the *left*, and\n- the $\\color{blue}-3$ outside the parentheses means a vertical translation of $3$ units *down*.\n\nSo, the new graph looks as follows:\n\n![](images/b5/b5f3fac4f76321abdd825c6e7d5ab5b60916149bbffc7a94a8bd3e932c17d8ea.png)"}] [{:db/id #edb/ref 17592186115930 :knowledge-point/_questions [{:db/id #edb/ref 17592186115269 :knowledge-point/id #uuid "b8acb08f-56b0-5a1b-b503-ba70e1cf88e6" :knowledge-point/title "Graphing Horizontal Translations of Elementary Cubic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d6da47f-91b4-5093-a930-85df803b436e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = (x + 1)^{3} + 1" :db/id #edb/ref 17592186114518} {:answer/id #uuid "a017f0c0-2eda-5163-852c-3a68c8386456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = x^{3} - 1" :db/id #edb/ref 17592186114519} {:answer/id #uuid "a845c7ac-4933-5af8-9dd7-d43ce925485b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = (x + 1)^{3}" :db/id #edb/ref 17592186114520} {:answer/id #uuid "ba5c9fa9-7dfc-5d83-8ed0-a4bec892b657" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = (x - 1)^{3}" :db/id #edb/ref 17592186114521} {:answer/id #uuid "2c8db9df-a8c0-5332-959f-58ed2c46c22f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = x^{3} + 1" :db/id #edb/ref 17592186114522}] :answer-field/id #uuid "3f98ffef-14c8-5933-a045-a10b6f9d9b19" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186114517}] :question/id #uuid "92488220-68fc-5f69-b251-46eba62a932c" :question/math-academy-id "q-6639" :question/problem "![](images/b7/b71c0bba1fff92996920e7d62a9e2b33feecd53f24edbbc309799b69e7cc79e2.png)\n\nWhat's the equation of the above curve?"}]}
