    "q-175713": {
      "dom_id": "step-q175713",
      "name": "Question 12",
      "problem": "Which of the following is equivalent to the expression $\\frac{1}{3}b+2a?$",
      "worked_solution": "The expression $\\frac{1}{3}b+2a$ has two terms: $\\frac{1}{3}b$ and $2a.$ \n\nThe order in which we combine the terms doesn't matter. Therefore, we can also write this expression as \n\n$$\n2a+\\frac{1}{3}b.\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-175713-a",
