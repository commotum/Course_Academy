/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186444237}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b5e57428-bc9d-562d-b78a-679c20ebb4df" :question/math-academy-id "q-43970" :question/problem "What's the third term of the expression $\\frac{3}{2}+\\frac{2x}{7}-1.3z-6y?$" :question/worked-solution "We put an addition symbol $(+)$ between each part and separate using parentheses:\n\n$$\n(\\frac{3}{2})+(\\frac{2x}{7})+(-1.3z)+(-6y)\n$$\n\nCounting off the terms:\n\n- the first term is $\\frac{3}{2},$\n\n- the second term is $\\frac{2x}{7},$\n\n- the third term is $-1.3z,$ and\n\n- the fourth term is $-6y.$\n\nIn particular, we are interested in the third term. The third term is $-1.3z.$"}] [{:db/id #edb/ref 17592186078914 :knowledge-point/_questions [{:db/id #edb/ref 17592186078615 :knowledge-point/id #uuid "48f63068-6837-522f-9268-efe63f9c2649" :knowledge-point/title "Equivalent Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22ddd719-e1ba-5276-ae7c-263dda5aa3b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+\\frac{5}{2}+z+\\frac{3}{2}x" :db/id #edb/ref 17592186444186} {:answer/id #uuid "5d165dc6-3eca-5638-b1bf-326216f2b83c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z+4x+2y" :db/id #edb/ref 17592186444196} {:answer/id #uuid "640428b8-1900-50ac-97c7-af250557e759" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y+4+6z+x" :db/id #edb/ref 17592186444199} {:answer/id #uuid "835311f0-0bd8-53f0-8bbb-c23df8b44216" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y+\\frac{5}{2}+6z+\\frac{3}{2}x" :db/id #edb/ref 17592186444204} {:answer/id #uuid "d3a029dd-9b34-57a5-9e78-ba4a2ccd2de8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answe