#{[{:db/id #edb/ref 17592186078158 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078613 :knowledge-point/id #uuid "ffb52c1b-a540-5255-8c13-a37940a0d6ec" :knowledge-point/title "Listing the Terms of a Linear Expression"}] :question/id #uuid "65cb74a2-b55a-58e7-951d-2e0c09662f68" :question/math-academy-id "e-12823" :question/problem "List all terms of the expression $3x + 2y - 4x.$" :question/worked-solution "We put an addition symbol $(+)$ between each part and separate using parentheses:\n\n$$\n(3x) + (2y) + (-4x)\n$$\n\nSo, the expression has three terms: $3x$, $2y$, and $-4x.$"}] [{:db/id #edb/ref 17592186078159 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078614 :knowledge-point/id #uuid "da99f266-f47f-5fda-8b91-2161c7e48a94" :knowledge-point/title "Identifying Particular Terms of an Expression"}] :question/id #uuid "4370fda3-97e7-5fc5-9459-4176f5922431" :question/math-academy-id "e-12824" :question/problem "What is the fourth term of the expression $2t + 5s - \\dfrac{1}{2}s + 8t?$" :question/worked-solution "We put an addition symbol $(+)$ between each part and separate using parentheses:\n\n$$\n(2t) + (5s) + \\left( -\\dfrac{1}{2} s \\right) + (8t)\n$$\n\nCounting off the terms:\n\n- the first term is $2t,$\n\n- the second term is $5s,$\n\n- the third term is $-\\dfrac{1}{2}s,$ and\n\n- the fourth term is $8t.$\n\nIn particular, we are interested in the fourth term. The fourth term is $8t.$"}] [{:db/id #edb/ref 17592186078160 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078615 :knowledge-point/id #uuid "48f63068-6837-522f-9268-efe63f9c2649" :knowledge-point/title "Equivalent Expressions"}] :question/id #uuid "b8e3ac42-7ade-5b31-8388-1e1061ad3f33" :question/math-academy-id "e-12825" :question/problem "Write down an expression that is equivalent to $9-\\dfrac{1}{2}x+3y.$" :question/worked-solution "The expression $9-\\dfrac{1}{2}x+3y$ has three terms: $9,$ $-\\dfrac{1}{2}x,$ and $3y.$\n\nIt doesn't matter in what order we write the terms. For example, one equivalent expression is:\n\n$$\n-\\dfrac{1}{2}x + 3y +9\n$$\n\nAnother equivalent expression is:\n\n$$\n3y - \\dfrac{1}{2}x + 9\n$$"}] [{:db/id #edb/ref 17592186444256 :knowledge-point/_questions [{:db/id #edb/ref 17592186078615 :knowledge-point/id #uuid "48f63068-6837-522f-9268-efe63f9c2649" :knowledge-point/title "Equivalent Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e84dddb-d804-515b-a803-77a49401d1e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186444202}] :answer-field/correct {:answer/id #uuid "7e84dddb-d804-515b-a803-77a49401d1e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186444202} :answer-field/id #uuid "0149a4f3-0b2c-56eb-9c88-527e935c10dd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444229} {:answer-field/choices [{:answer/id #uuid "16f37291-1ec4-5e47-99cf-f941f84c6dd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186444183}] :answer-field/correct {:answer/id #uuid "16f37291-1ec4-5e47-99cf-f941f84c6dd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186444183} :answer-field/id #uuid "0dd86268-2d7e-50d4-98e5-af440778405e" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444230} {:answer-field/choices [{:answer/id #uuid "4e913cf6-f448-5144-bb3e-8750cb53f991" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186444192}] :answer-field/correct {:answer/id #uuid "4e913cf6-f448-5144-bb3e-8750cb53f991" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.t