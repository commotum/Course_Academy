ular Terms of an Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43143215-ba80-5020-84b6-d06ef8fb9278" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15h" :db/id #edb/ref 17592186444190}] :answer-field/correct {:answer/id #uuid "43143215-ba80-5020-84b6-d06ef8fb9278" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15h" :db/id #edb/ref 17592186444190} :answer-field/id #uuid "413e8725-6a30-59b9-96e3-950ff83c23e0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444233}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2552e69b-2f31-5809-a616-04be2e921486" :question/math-academy-id "q-176824" :question/problem "The third term of the expression $6f-2g-15h$ is{{field-1}}." :question/worked-solution "We put an addition symbol $(+)$ between each part and separate using parentheses:\n\n$$\n(6f)+(-2g)+(-15h)\n$$\n\nCounting off the terms:\n\n- the first term is $6f,$\n\n- the second term is $-2g,$\n\n- the third term is $-15h.$\n\nIn particular, we are interested in the third term. The third term is $-15h.$"}] [{:db/id #edb/ref 17592186444250 :knowledge-point/_questions [{:db/id #edb/ref 17592186078614 :knowledge-point/id #uuid "da99f266-f47f-5fda-8b91-2161c7e48a94" :knowledge-point/title "Identifying Particular Terms of an Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ff438b4-2223-5126-afe7-5a144d34b774" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10x" :db/id #edb/ref 17592186444188}] :answer-field/correct {:answer/id #uuid "2ff438b4-2223-5126-afe7-5a144d34b774" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10x" :db/id #edb/ref 17592186444188} :answer-field/id #uuid "93684eda-4c21-5c50-a3d0-4a1bcef8a5c2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444239}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "53c72840-d479-512c-a2f9-7b59b04f5d7d" :question/math-academy-id "q-176829" :question/problem "The fourth term of the expression $7u-2v-0.3w+10x$ is{{field-1}}." :question/worked-solution "We put an addition symbol $(+)$ between each part and separate using parentheses:\n\n$$\n(7u)+(-2v)+(-0.3w)+(10x)\n$$\n\nCounting off the terms:\n\n- the first term is $7u,$\n\n- the second term is $-2v,$\n\n- the third term is $-0.3w,$ and\n\n- the fourth term is $10x.$\n\nIn particular, we are interested in the fourth term. The fourth term is $10x.$"}] [{:db/id #edb/ref 17592186444249 :knowledge-point/_questions [{:db/id #edb/ref 17592186078614 :knowledge-point/id #uuid "da99f266-f47f-5fda-8b91-2161c7e48a94" :knowledge-point/title "Identifying Particular Terms of an Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b22e6da-e6a8-537b-8f51-6e282c9f5b0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}b" :db/id #edb/ref 17592186444178}] :answer-field/correct {:answer/id #uuid "0b22e6da-e6a8-537b-8f51-6e282c9f5b0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}b" :db/id #edb/ref 17592186444178} :answer-field/id #uuid "58153d1d-dbec-5b34-8b24-7685bcb0cb22" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444235}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4cf8dfa1-a016-55ee-948f-099f977c00ae" :question/math-academy-id "q-176831" :question/problem "The third term of the expression $8-\\frac{3}{4}a-\\frac{4}{5}b+2c$ is{{field-1}}." :question/worked-solution "We put an addition symbol $(+)$ between each part and separate using parentheses:\n\n$$\n(8)+(-\\frac{3}{4}a)+(-\\frac{4}{5}b)+(2c)\n$$\n\nCounting off the terms:\n\n- the first term is $8,$\n\n- the second term is $-\\frac{3}{4}a,$\n\n- the third term is $-\\frac{4}{5}b,$ and\n\n- the fourth term is $2c.$\n\nIn particular, we are interested in the third term. The third term is $-\\frac{4}{5}b.$"}] [{:db/id #edb/ref 17592186444253 :knowledge-point/_questions [{:db/id #edb/ref 17592186078615 :knowledge-point/id #uuid "48f63068-6837-522f-9268-efe63f9c2649" :knowledge-point/title "Equivalent Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c35a9517-7fe7-5593-9ef5-67430fa53d2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186444218}] :answer-field/correct {:answer/id #uuid "c35a9517-7fe7-5593-9ef5-67430fa53d2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186444218} :answer-field/id #uuid "472cde22-93c2-5545-9698-e14f4b892f9a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444234} {:answer-field/choices [{:answer/id #uuid "b942be4e-84a6-57ae-993d-c5ce7f403434" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186444216}] :answer-field/correct {:answer/id #uuid "b942be4e-84a6-57ae-993d-c5ce7f403434" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186444216} :answer-field/id #uuid "583bb0ab-76b5-55bc-9441-2b768b6ea99c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444236}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/id