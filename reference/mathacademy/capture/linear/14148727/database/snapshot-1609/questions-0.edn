068-6837-522f-9268-efe63f9c2649" :knowledge-point/title "Equivalent Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e42d32a-6390-5b42-bec4-b9f3c127dcc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3q-5r+2p" :db/id #edb/ref 17592186444197} {:answer/id #uuid "b068afa5-c631-53c9-8399-867562897299" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3q-5r-2p" :db/id #edb/ref 17592186444213} {:answer/id #uuid "d2c23110-d962-5165-8c83-25cab933568c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5r+3q-2p" :db/id #edb/ref 17592186444219} {:answer/id #uuid "e187b55a-4985-58ef-a904-d6e3e1d3c302" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3q-5r+2p" :db/id #edb/ref 17592186444225} {:answer/id #uuid "feeae1fb-1838-5a55-ad24-4915117c9d1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5r+3q+2p" :db/id #edb/ref 17592186444228}] :answer-field/correct {:answer/id #uuid "b068afa5-c631-53c9-8399-867562897299" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3q-5r-2p" :db/id #edb/ref 17592186444213} :answer-field/id #uuid "96f4a152-2e64-5c9b-89d6-bc53f411ae85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186444240}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3e6d4984-6930-5fe6-93df-11f6e79d298e" :question/math-academy-id "q-67054" :question/problem "Which of the following is equivalent to the expression $-2p+3q-5r?$" :question/worked-solution "The expression $-2p+3q-5r$ has three terms:  $-2p$, $3q$, and $-5r.$ \n\nThe order in which we combine the terms doesn't matter. Therefore, we can also write this expression as \n\n$$\n3q-5r-2p.\n$$"}]