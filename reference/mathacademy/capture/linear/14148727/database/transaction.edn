ield/type :answer-field.type/radio :answer-field/correct "answer-1ba8212d-1417-5836-ac85-8fa2036125e9" :answer-field/choices ["answer-ea3a30fc-60c0-5b16-ba39-09a556333855" "answer-8c727f8f-ea35-5779-aad9-9f2f625fb3ad" "answer-24a11ac0-819e-525f-8170-3eda18b72390" "answer-1ba8212d-1417-5836-ac85-8fa2036125e9" "answer-16d0b275-f33e-56d5-ae71-e9f81383541e"] :db/ensure [:answer-field/validate]} {:db/id "answer-ea3a30fc-60c0-5b16-ba39-09a556333855" :answer/id #uuid "ea3a30fc-60c0-5b16-ba39-09a556333855" :answer/type :answer.type/text :answer/value "$-5$ and $l$" :db/ensure [:answer/validate]} {:db/id "answer-8c727f8f-ea35-5779-aad9-9f2f625fb3ad" :answer/id #uuid "8c727f8f-ea35-5779-aad9-9f2f625fb3ad" :answer/type :answer.type/text :answer/value "$7$ and $-5$" :db/ensure [:answer/validate]} {:db/id "answer-24a11ac0-819e-525f-8170-3eda18b72390" :answer/id #uuid "24a11ac0-819e-525f-8170-3eda18b72390" :answer/type :answer.type/text :answer/value "$7,k$ and $l$" :db/ensure [:answer/validate]} {:db/id "answer-1ba8212d-1417-5836-ac85-8fa2036125e9" :answer/id #uuid "1ba8212d-1417-5836-ac85-8fa2036125e9" :answer/type :answer.type/text :answer/value "$7k$ and $-5l$" :db/ensure [:answer/validate]} {:db/id "answer-16d0b275-f33e-56d5-ae71-e9f81383541e" :answer/id #uuid "16d0b275-f33e-56d5-ae71-e9f81383541e" :answer/type :answer.type/text :answer/value "$k$ and $l$" :db/ensure [:answer/validate]} {:db/id "question-53c72840-d479-512c-a2f9-7b59b04f5d7d" :question/id #uuid "53c72840-d479-512c-a2f9-7b59b04f5d7d" :question/math-academy-id "q-176829" :question/problem "The fourth term of the expression $7u-2v-0.3w+10x$ is{{field-1}}." :question/worked-solution "We put an addition symbol $(+)$ between each part and separate using parentheses:\n\n$$\n(7u)+(-2v)+(-0.3w)+(10x)\n$$\n\nCounting off the terms:\n\n- the first term is $7u,$\n\n- the second term is $-2v,$\n\n- the third term is $-0.3w,$ and\n\n- the fourth term is $10x.$\n\nIn particular, we are interested in the fourth term. The fourth term is $10x.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-93684eda-4c21-5c50-a3d0-4a1bcef8a5c2"] :db/ensure [:question/validate]} {:db/id "answer-field-93684eda-4c21-5c50-a3d0-4a1bcef8a5c2" :answer-field/id #uuid "93684eda-4c21-5c50-a3d0-4a1bcef8a5c2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2ff438b4-2223-5126-afe7-5a144d34b774" :answer-field/choices ["answer-2ff438b4-2223-5126-afe7-5a144d34b774"] :db/ensure [:answer-field/validate]} {:db/id "answer-2ff438b4-2223-5126-afe7-5a144d34b774" :answer/id #uuid "2ff438b4-2223-5126-afe7-5a144d34b774" :answer/type :answer.type/math :answer/value "10x" :db/ensure [:answer/validate]} {:db/id "question-4cf8dfa1-a016-55ee-948f-099f977c00ae" :question/id #uuid "4cf8dfa1-a016-55ee-948f-099f977c00ae" :question/math-academy-id "q-176831" :question/problem "The third term of the expression $8-\\frac{3}{4}a-\\frac{4}{5}b+2c$ is{{field-1}}." :question/worked-solution "We put an addition symbol $(+)$ between each part and separate using parentheses:\n\n$$\n(8)+(-\\frac{3}{4}a)+(-\\frac{4}{5}b)+(2c)\n$$\n\nCounting off the terms:\n\n- the first term is $8,$\n\n- the second term is $-\\frac{3}{4}a,$\n\n- the third term is $-\\frac{4}{5}b,$ and\n\n- the fourth term is $2c.$\n\nIn particular, we are interested in the third term. The third term is $-\\frac{4}{5}b.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-58153d1d-dbec-5b34-8b24-7685bcb0cb22"] :db/ensure [:question/validate]} {:db/id "answer-field-58153d1d-dbec-5b34-8b24-7685bcb0cb22" :answer-field/id #uuid "58153d1d-dbec-5b34-8b24-7685bcb0cb22" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0b22e6da-e6a8-537b-8f51-6e282c9f5b0f" :answer-field/choices ["answer-0b22e6da-e6a8-537b-8f51-6e282c9f5b0f"] :db/ensure [:answer-field/validate]} {:db/id "answer-0b22e6da-e6a8-537b-8f51-6e282c9f5