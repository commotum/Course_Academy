#{[{:activity/first-step {:db/id #edb/ref 17592186193595} :activity/id #uuid "7dce8769-8b8a-5a22-ae68-4462efb5a5ce" :activity/scope {:db/id #edb/ref 17592186049376 :topic/id #uuid "eff92a43-1983-58ce-8999-65db419a98c7" :topic/math-academy-id 4019} :activity/steps [{:db/id #edb/ref 17592186193595 :step/content {:db/id #edb/ref 17592186193857 :tutorial/content "Suppose we have a pair of parallel lines cut by a transversal.\n\n**Alternate interior angles** are the pairs of angles on *alternate* (opposite) sides of the transversal and are *interior* to (inside of) the parallel lines. These pairs of angles always have equal measure.\n\n![](images/b0/b06ff1e3d55ee09f95a1234ab4aa340d825f05971957ae8a88ff408c256c82a4.png)\n\n**Alternate external angles** are the pairs of angles on *alternate* (opposite) sides of the transversal and are *exterior* to (outside of) the parallel lines. These pairs of angles always have equal measure.\n\n![](images/4d/4d4765d2f5e49794336d2bf35705da9fa7885ce0a619dcd3a117d28cfe66645e.png)" :tutorial/id #uuid "17eba692-165e-58c9-96a3-8aed2c660530" :tutorial/math-academy-id 6723 :tutorial/title "Introduction"} :step/id #uuid "5f6b707c-1a02-5a01-96da-00e64ed94944" :step/math-academy-id 40678 :step/next {:db/id #edb/ref 17592186193596}} {:db/id #edb/ref 17592186193596 :step/content {:db/id #edb/ref 17592186192742 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192460 :question/id #uuid "273e5c07-6f92-5019-8268-bc3af728c530" :question/math-academy-id "e-10737"} :knowledge-point/id #uuid "d4b0977a-6bcb-5d7f-bec8-b10bff6d7e23" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048213} {:db/id #edb/ref 17592186049587}] :knowledge-point/questions [{:db/id #edb/ref 17592186193186} {:db/id #edb/ref 17592186193351} {:db/id #edb/ref 17592186511550}] :knowledge-point/title "Finding Alternate Interior Angles"} :step/id #uuid "8bd1113e-49e3-508c-a22f-dfa0fdd69bae" :step/math-academy-id 40680 :step/next {:db/id #edb/ref 17592186193673}} {:db/i