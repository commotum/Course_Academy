#{[{:db/id #edb/ref 17592186329907 :knowledge-point/_questions [{:db/id #edb/ref 17592186064153 :knowledge-point/id #uuid "2451a654-2255-5867-871d-54340dfeff81" :knowledge-point/title "Interpreting the Derivative of a Function in a Given Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0be07498-8050-537a-b25e-fd95bab4699a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The distance traveled increased by $10$ meters during the first $30$ seconds" :db/id #edb/ref 17592186327037} {:answer/id #uuid "51437d5b-5e6c-5066-b244-e7e818095097" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The distance traveled increased at a constant rate of $3$ meters per second" :db/id #edb/ref 17592186327641} {:answer/id #uuid "7aadd70b-53c1-50fb-bc02-b723b6f3ea3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$30$ seconds after the start of the journey, the distance traveled decreased at a rate of $10$ meters per second" :db/id #edb/ref 17592186327987} {:answer/id #uuid "aaa8d265-16ad-5285-82fb-8aa43f6dd27f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$30$ seconds after the start of the journey, the car traveled $10$ meters." :db/id #edb/ref 17592186328410} {:answer/id #uuid "dc11c238-8417-5632-881c-cdb922cfb484" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$30$ seconds after the start of the journey, the distance traveled increased at a rate of $10$ meters per second" :db/id #edb/ref 17592186328858}] :answer-field/correct {:answer/id #uuid "dc11c238-8417-5632-881c-cdb922cfb484" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$30$ seconds after the start of the journey, the distance traveled increased at a rate of $10$ meters per second" :db/id #edb/ref 17592186328858} :answer-field/id #uuid "ffcaa0c5-cbb7-57a1-b1e2-92acc3accb1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329631}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ce5be28b-4511-5653-9464-457a2f9e4167" :question/math-academy-id "q-48688" :question/problem "The function $x(t)$ models the number of meters traveled by a car, $t$ seconds after it sets off on a journey. What is the best interpretation of ${x}^{′}(30)=10?$" :question/worked-solution "The function ${x}^{′}(t)$ represents the rate at which the number of meters is changing at the moment $t$ seconds after starting its journey.\n\nTherefore, ${x}^{′}(30)=10$ means:\n\n$\\,$ *$30$ seconds after the start of the journey, the distance traveled increased at a rate of $10$ meters per second*"}] [{:db/id #edb/ref 17592186064839 :knowledge-point/_questions [{:db/id #edb/ref 17592186064154 :knowledge-point/id #uuid "c7df31c9-b27a-5ce2-93c8-178ba96da000" :knowledge-point/title "Determining a Rate of Change"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0471e9db-ae74-5721-881f-6766ec471aab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$55$ crocodiles per year" :db/id #edb/ref 17592186063092} {:answer/id #uuid "0cb451c9-624d-5aea-a847-0a716186f298" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$40$ crocodiles per year" :db/id #edb/ref 17592186063093} {:answer/id #uuid "19b1cbfa-5dc1-50c7-b795-45e8078bcfc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-6$ crocodiles per year" :db/id #edb/ref 17592186063094} {:answer/id #uuid "1b66f55e-690d-507d-9f15-da5db4e9d4d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$77$ crocodiles per year" :db/id #edb/ref 17592186063095} {:answer/id #uuid "20cf6a46-231f-5311-8a1f-d91f99078953" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$66$ crocodiles per year" :db/id #edb/ref 17592186063096}] :answer-field/id #uuid "68d15ded-f5ea-533d-bc58-1b30eba5bad8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186063091}] :question/id #uuid "7cc5ee70-2b10-5325-a2dc-cd7c11e6d8be" :question/math-academy-id "q-48935" :question/problem "The birth rate of crocodiles in a river is modeled by $B(t) = 6 \\cdot e^{0.25t}$ crocodiles per year, while the rate of death is modeled by $D(t) = 4 \\cdot e^{0.25t}$ crocodiles per year, where $t$ represents the number of years since the year $2000$.\n\nWhat was the rate of change of the crocodile population in $2012$? Round your answer to the nearest integer.\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true}]}
