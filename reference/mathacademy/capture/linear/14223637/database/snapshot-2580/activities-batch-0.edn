#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055618} :activity/id #uuid "a163662d-b871-5e67-90b7-3c408d42da30" :activity/scope {:db/id #edb/ref 17592186049330 :topic/id #uuid "ec62124a-ba1a-5287-92fd-a64e499120c1" :topic/math-academy-id 101} :activity/steps [{:db/id #edb/ref 17592186055618 :step/content {:db/id #edb/ref 17592186055982 :tutorial/content "Suppose we want to solve the following system of equations:\n![](images/01/01eee66dd39797b90503716f097ff604a4f339d8ea0a25ceef9b8ea7a0898ab4.svg)\n\nTo solve systems of equations *graphically*, we first draw each of the equations in the same coordinate system. Then, the solution of the system is given by the common points where the lines intersect.\n\nLet's see how this method works for the system above. To plot the functions given by the equations, we first rewrite them by making ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg) the subject in each equation.\n![](images/c7/c7778dd2c82032ef68ad8221a990abe1b2bafb4e36a7a0e2640a43856be58c5a.svg) \n\nThen, we draw the lines in the same coordinate system:\n\n![](images/47/47fb02cf8bb4668b24034302fd4265ec5261f4d244cd9d9d599afeffd91d2424.png)\n\nThe lines intersect at the point ![](images/d8/d87c68d6226f4bb9ecf52ab576a5ac45c83fbb02c83edd1af04ac235dd518467.svg), which is the solution to our system.\n\n![](images/b3/b3b95135ad9a758f891280b15e8bd6f6165bf9f47a76a1c99280af02dad78911.png)\n\nWe can also use the graphical method to solve systems of equations where the corresponding functions are not straight lines. These types of systems are called **nonlinear systems**. Let's consider such an example." :tutorial/id #uuid "e7d63cd6-92ea-5bb3-adc8-f9d09bf2d24d" :tutorial/math-academy-id 3407 :tutorial/title "Introduction"} :step/id #uuid "8d314c2a-668c-507d-a140-8f47f8422fff" :step/math-academy-id 19145 :step/next {:db/id #edb/ref 17592186055619}} {:db/id #edb/ref 17592186055619 :step/content {:db/id #edb/ref 17592186054664 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054561 :question/id #uuid "e8d3ec4c-5ab2-5bd1-9e8f-32d3526a7ca7" :question/math-academy-id "e-5204"} :knowledge-point/id #uuid "2812e564-d5a3-58f6-a679-f8d3d20c042e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048678} {:db/id #edb/ref 17592186048838}] :knowledge-point/questions [{:db/id #edb/ref 17592186054991} {:db/id #edb/ref 17592186054992} {:db/id #edb/ref 17592186508924} {:db/id #edb/ref 17592186508938} {:db/id #edb/ref 17592186509000} {:db/id #edb/ref 17592186537980}] :knowledge-point/title "Solving Systems of Equations Containing Quadratic Functions"} :step/id #uuid "487c6fc8-1141-5f82-85ea-4e560f81130f" :step/math-academy-id 19148 :step/next {:db/id #edb/ref 17592186055620}} {:db/id #edb/ref 17592186055620 :step/content {:db/id #edb/ref 17592186054665 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054562 :question/id #uuid "fced2a80-0cad-5405-b0bb-c12e4a7cce06" :question/math-academy-id "e-5205"} :knowledge-point/id #uuid "bd4dde78-84d1-5b33-a41a-9f10b24131b6" :knowledge-point/questions [{:db/id #edb/ref 17592186055258} {:db/id #edb/ref 17592186055259} {:db/id #edb/ref 17592186508941} {:db/id #edb/ref 17592186508942} {:db/id #edb/ref 17592186537893}] :knowledge-point/title "Solving System of Equations Graphically"} :step/id #uuid "74edc604-916f-54b2-899e-637369c1a92d" :step/math-academy-id 19149}] :activity/title "Solving Systems of Nonlinear Equations Using Graphs" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054864}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186538021} :activity/id #uuid "18cfbf29-0714-53c4-bf61-75276fdf84b2" :activity/scope {:db/id #edb/ref 17592186049330 :topic/id #uuid "ec62124a-ba1a-5287-92fd-a64e499120c1" :topic/math-academy-id 101} :activity/steps [{:db/id #edb/ref 17592186538002 :step/content {:db/id #edb/ref 17592186537893 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01a5189d-540f-5143-b180-eea39c520ccb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-1,1)$ and $(2,1)$" :db/id #edb/ref 17592186537228} {:answer/id #uuid "1b84224c-2aef-5acf-9174-2e514405a489" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-1,0)$ and $(0,1)$" :db/id #edb/ref 17592186537285} {:answer/id #uuid "1d898613-60f0-545a-a43b-ab2df0a31df5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(1,-1)$ and $(1,2)$" :db/id #edb/ref 17592186537292} {:answer/id #uuid "7cc2dfcf-d574-5c58-9c7c-5fd06dbeeee6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,2)$ and $(1,-1)$" :db/id #edb/ref 17592186537473} {:answer/id #uuid "aab67e8e-c1fd-5b7a-a619-a599bce9e1a3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-2,0)$ and $(-1,-1)$" :db/id #edb/ref 17592186537552}] :answer-field/correct {:db/id #edb/ref 17592186537228} :answer-field/id #uuid "8c0ebced-cf33-5e38-93fa-adaeaf32a0f9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537816}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1ecf42ce-06ef-5bfd-b762-67d3f1697496" :question/math-academy-id "q-40946" :question/problem "![](images/e1/e1892e632e2485b17400ba9d2a9372bf164e20812c3b6fe4f9b03ab1348fab7d.png)\n\nUsing the graphical method, find the solutions $(x,y)$ of the following system of equations:\n\n$$\n\\{\\begin{aligned}y=f(x) \\\\ y=g(x)\\end{aligned}\n$$" :question/worked-solution "The solutions $(x,y)$ of the system correspond to the intersection points of the two curves.\n\n![](images/8d/8dfab4aa640e596227bd6a6a09af36264f6bce9bc0906a69ea433d6e6a3db78d.png)\n\nFrom the graph, the curves intersect at \n\n$\\,$ $(-1,1)\\,$ and $\\,(2,1).$ \n\nTherefore, these are the solutions of the corresponding system."} :step/id #uuid "2d2a8d38-4a66-5619-979f-ca1ea501fd0f" :step/next {:db/id #edb/ref 17592186538061}} {:db/id #edb/ref 17592186538021 :step/content {:db/id #edb/ref 17592186054992 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0144b8df-ea7b-5d97-a90d-b6a729498469" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,1)$ and $(-1,-2)$" :db/id #edb/ref 17592186537226} {:answer/id #uuid "0d132648-29c9-5efd-8dd9-74bc9443ede2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,1)$ and $(1,2)$" :db/id #edb/ref 17592186537249} {:answer/id #uuid "2d56859a-7919-5fa1-b36a-db3eb7b258c0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-1,0)$ and $(2,1)$" :db/id #edb/ref 17592186537324} {:answer/id #uuid "9de3af1d-692f-5053-99f2-3783795f8e29" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-1,4)$ only" :db/id #edb/ref 17592186537523} {:answer/id #uuid "dabcb025-40e7-5f2c-ae63-f8732b21b6f5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(1,0)$ only" :db/id #edb/ref 17592186537666}] :answer-field/correct {:db/id #edb/ref 17592186537249} :answer-field/id #uuid "1f34e030-e9d1-56f0-806f-3268b6a34932" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186051482}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8c76a9c4-fcd2-5048-9771-c38b93693e80" :question/math-academy-id "q-12329" :question/problem "![](images/ae/aee38b4fa46a403ee9517fc5a087434c8205b6553a4ebefa43be74ba7babfbc0.png)\n\nUsing the graphical method, find the solutions $(x,y)$ of the following system of equations:\n\n$$\n\\{\\begin{aligned}y=x+1 \\\\ y={x}^{2}+1\\end{aligned}\n$$" :question/worked-solution "The solutions $(x,y)$ of the system correspond to the intersection points of the two curves.\n\n![](images/56/563850386ee40e291a04911a2216614bda567ffbb8cfce1a7713400900d2701c.png)\n\nFrom the graph, the curves intersect at \n\n$\\,$ $(0,1)\\,$ and $\\,(1,2).$ \n\nTherefore, these are the solutions of the corresponding system."} :step/id #uuid "504ad451-e9ae-5979-b879-13ec6623b2ca" :step/next {:db/id #edb/ref 17592186538002}} {:db/id #edb/ref 17592186538061 :step/content {:db/id #edb/ref 17592186537980 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f5bbd1a-b6f0-537f-a093-4b3d1be271cf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(2,1)$ and $(-1,2)$" :db/id #edb/ref 17592186537393} {:answer/id #uuid "57e6a003-f73c-515c-a06f-ba516c1963bd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-2,-3)$ and $(1,2)$" :db/id #edb/ref 17592186537409} {:answer/id #uuid "6d485cb2-89c5-5022-b5b4-533fc087f5b9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-2,3)$ and $(1,0)$" :db/id #edb/ref 17592186537441} {:answer/id #uuid "8cc80659-76af-5a9d-b845-d8d0123dc768" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(1,3)$ and $(1,0)$" :db/id #edb/ref 17592186537496} {:answer/id #uuid "b7fdda5c-b3a2-5a24-9521-9f6e08ac1fa7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-2,-1)$ and $(-1,0)$" :db/id #edb/ref 17592186537586}] :answer-field/correct {:db/id #edb/ref 17592186537441} :answer-field/id #uuid "f66e49fb-db34-54b1-8488-6385f866a2fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537875}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e75342f3-2efc-5d3d-a3c3-d44c19646c04" :question/math-academy-id "q-78292" :question/problem "![](images/e6/e6831eff5d8feb87ebba8e7d449d98fbe72c3ed4df01d8374d4866e8e3456ddc.png)\n\nUsing the graphical method, find the solutions $(x,y)$ of the following system of equations:\n\n$$\n\\{\\begin{aligned}y=-x+1 \\\\ y={x}^{2}-1\\end{aligned}\n$$" :question/worked-solution "The solutions $(x,y)$ of the system correspond to the intersection points of the two curves.\n\n![](images/e1/e1ebbb0ce147dc986dd4d47539f055407c9b870af2ada9629520c4fa1d9aef33.png)\n\nFrom the graph, the curves intersect at \n\n$\\,$ $(-2,3)\\,$ and $\\,(1,0).$ \n\nTherefore, these are the solutions of the corresponding system."} :step/id #uuid "e6565653-a052-5dc4-ab06-3fb284893e9e"}] :activity/title "Solving Systems of Nonlinear Equations Using Graphs" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186537207}]}
