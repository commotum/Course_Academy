#{[{:activity/first-step {:db/id #edb/ref 17592186060565} :activity/id #uuid "49ad5fef-36f7-53a5-9400-a38064d1f445" :activity/scope {:db/id #edb/ref 17592186048378 :topic/id #uuid "9a6ced87-ea51-55d6-b162-fa59131bd20f" :topic/math-academy-id 230} :activity/steps [{:db/id #edb/ref 17592186060565 :step/content {:db/id #edb/ref 17592186060982 :tutorial/content "**De Morgan's laws** for logic tell us how to distribute a negation over a conjunction or disjunction.\n\n- De Morgan's law for conjunctions states that $$\\neg ( A \\land B) \\equiv \\neg A \\lor \\neg B.$$\n- De Morgan's law for disjunctions states that $$\\neg ( A \\lor B) \\equiv \\neg A \\land \\neg B.$$\n\nIntuitively, you can think that the negation \"flips\" the conjunction into a disjunction, and vice versa.\n\nTo prove that these laws hold, we can construct truth tables:\n\n- The following truth table shows that $\\neg ( A \\land B) \\equiv \\neg A \\lor \\neg B{:}$\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\, \\neg ( A \\land B) \\,$ | $\\, \\neg A \\lor \\neg B \\,$ |\n| --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\color{blue} \\textrm F$ | $\\color{blue} \\textrm F$ |\n| $\\textrm T$ | $\\textrm F$ | $\\color{blue} \\textrm T$ | $\\color{blue} \\textrm T$ |\n| $\\textrm F$ | $\\textrm T$ | $\\color{blue} \\textrm T$ | $\\color{blue} \\textrm T$ |\n| $\\textrm F$ | $\\textrm F$ | $\\color{blue} \\textrm T$ | $\\color{blue} \\textrm T$ |\n\n- The following truth table shows that $\\neg ( A \\lor B) \\equiv \\neg A \\land \\neg B{:}$\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\, \\neg ( A \\lor B) \\,$ | $\\, \\neg A \\land \\neg B \\,$ |\n| --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\color{blue} \\textrm F$ | $\\color{blue} \\textrm F$ |\n| $\\textrm T$ | $\\textrm F$ | $\\color{blue} \\textrm F$ | $\\color{blue} \\textrm F$ |\n| $\\textrm F$ | $\\textrm T$ | $\\color{blue} \\textrm F$ | $\\color{blue} \\textrm F$ |\n| $\\textrm F$ | $\\textrm F$ | $\\color{blue} \\textrm T$ | $\\color{blue} \\textrm T$ |" :tutorial/id #uuid "11eb79a8-713f-5d33-bb4e-af361254bcc9" :tutorial/math-academy-id 7973 :tutorial/title "Introduction"} :step/id #uuid "395fc7fe-3175-579c-a510-019d03a347ea" :step/math-academy-id 154012 :step/next {:db/id #edb/ref 17592186060566}} {:db/id #edb/ref 17592186060566 :step/content {:db/id #edb/ref 17592186059696 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059403 :question/id #uuid "fc8d6c59-5351-5ca1-95e1-fa1470799bbc" :question/math-academy-id "e-12694"} :knowledge-point/id #uuid "d9de08e2-7bf6-5ab5-bb90-7f2896dda1dc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048349} {:db/id #edb/ref 17592186048778}] :knowledge-point/questions [{:db/id #edb/ref 17592186060105} {:db/id #edb/ref 17592186060108} {:db/id #edb/ref 17592186376254} {:db/id #edb/ref 17592186376261} {:db/id #edb/ref 17592186401695} {:db/id #edb/ref 17592186401702}] :knowledge-point/title "Negating a Sentence Containing a Conjunction"} :step/id #uuid "73c107a6-14f7-5621-8623-0041277016c2" :step/math-academy-id 154013 :step/next {:db/id #edb/ref 17592186060567}} {:db/id #edb/ref 17592186060567 :step/content {:db/id #edb/ref 17592186059697 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059404 :question/id #uuid "4d1dc931-6a8c-53fc-abc7-369df54b0912" :question/math-academy-id "e-12695"} :knowledge-point/id #uuid "fe5bd766-d624-54e3-945e-7ae37b83886a" :knowledge-point/questions [{:db/id #edb/ref 17592186060106} {:db/id #edb/ref 17592186060107} {:db/id #edb/ref 17592186376374} {:db/id #edb/ref 17592186376381} {:db/id #edb/ref 17592186401709}] :knowledge-point/title "Negating a Sentence Containing a Disjunction"} :step/id #uuid "4ace0250-c3fc-5767-9fc3-6986b4f949f3" :step/math-academy-id 154016 :step/next {:db/id #edb/ref 17592186060568}} {:db/id #edb/ref 17592186060568 :step/content {:db/id #edb/ref 17592186059698 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059405 :question/id #uuid "a3430492-73ee-5c65-92cf-7059bb63b5a4" :question/math-academy-id "e-12696"} :knowledge-point/id #uuid "d9c85b7b-1326-5f25-aa21-ab115680582d" :knowledge-point/questions [{:db/id #edb/ref 17592186060409} {:db/id #edb/ref 17592186060410} {:db/id #edb/ref 17592186060416} {:db/id #edb/ref 17592186375993} {:db/id #edb/ref 17592186376007} {:db/id #edb/ref 17592186377858} {:db/id #edb/ref 17592186394331}] :knowledge-point/title "Simplifying a Statement Using De Morgan's Laws"} :step/id #uuid "3496d4e6-81b6-582f-b540-a1b948281c36" :step/math-academy-id 154019}] :activity/title "De Morgan's Laws for Logic" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186059911}]}
