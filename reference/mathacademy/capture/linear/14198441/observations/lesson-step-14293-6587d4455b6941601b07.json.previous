{
  "dom_id": "step-14293",
  "name": "Example: \n                    Adding Complex Numbers",
  "problem": "Evaluate $(4 + 3\\,\\textrm{i}) + (1 + 5\\,\\textrm{i}).$",
  "worked_solution": "To add complex numbers, we just add the real parts and add the imaginary parts separately.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(4+3\\,\\text{i})+(1+5\\,\\text{i}) & =(4+3\\,\\text{i})+(1+5\\,\\text{i}) \\\\  & =(4+1)+(3+5)\\,\\text{i} \\\\  & =5+8\\,\\text{i}.\\end{aligned}\n$$",
  "calculator_instructions": "",
  "fields": [],
  "problem_field_keys": [],
  "answer_fields_complete": null,
  "result": null,
  "proof_feedback": null,
