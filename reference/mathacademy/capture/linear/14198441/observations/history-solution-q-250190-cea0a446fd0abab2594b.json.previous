{
  "dom_id": "questionExplanation-250190",
  "name": null,
  "problem": "",
  "worked_solution": "Given the complex number $a+b\\,\\text{i},$ $a$ represents its real part while $b$ represents its imaginary part.\n\nTo add or subtract complex numbers, we add or subtract their real parts, and we add or subtract their imaginary parts.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(6-4\\,\\text{i})-3 & =(6-4\\,\\text{i})+(-3+0\\,\\text{i}) \\\\  & =(6-3)+(-4+0)\\,\\text{i} \\\\  & =3+(-4)\\,\\text{i} \\\\  & =3-4\\,\\text{i}.\\end{aligned}\n$$",
  "calculator_instructions": "",
  "fields": [],
  "problem_field_keys": [],
  "answer_fields_complete": null,
  "result": null,
  "proof_feedback": null,
