#{[{:db/id #edb/ref 17592186054529 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054618 :knowledge-point/id #uuid "07f13e54-35a5-5eca-a35a-292e26c6c2da" :knowledge-point/title "Adding Complex Numbers"}] :question/id #uuid "f6b5bac8-9d99-50d8-91a9-c4d74cc67845" :question/math-academy-id "e-4036" :question/problem "Evaluate $(4 + 3\\,\\textrm{i}) + (1 + 5\\,\\textrm{i})$." :question/worked-solution "To add complex numbers, we just add the real parts and add the imaginary parts separately.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}\n(4 + 3\\textrm{i}) + (1 + 5\\textrm{i}) &= (4 + 3\\textrm{i}) + (1 + 5\\textrm{i}) \\\\\n&= (4 + 1) + (3 + 5)\\textrm{i} \\\\\n&= 5 + 8\\textrm{i}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054530 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054619 :knowledge-point/id #uuid "51cc4831-5d5f-5410-abd7-cb7bbc6dfa64" :knowledge-point/title "Subtracting Complex Numbers"}] :question/id #uuid "27ea592a-9ca6-5c04-8cdd-2e5a54443d89" :question/math-academy-id "e-4037" :question/problem "Find the value of $(5 + 4\\,\\textrm{i}) - (1 + 2\\,\\textrm{i})$." :question/worked-solution "To subtract complex numbers, we just subtract the real parts and subtract the imaginary parts separately.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}\n(5 + 4\\textrm{i}) - (1 + 2\\textrm{i}) &= (5 + 4\\textrm{i}) - (1 + 2\\textrm{i}) \\\\\n&= (5 - 1) + (4 - 2)\\textrm{i} \\\\\n&= 4 + 2\\textrm{i}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054531 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054620 :knowledge-point/id #uuid "8246fcfc-c7fb-51e8-826a-ed4e88665706" :knowledge-point/title "Adding and Subtracting Complex Numbers Written in Nonstandard Form"}] :question/id #uuid "649f45a2-291d-5a39-95f1-fce18eb87a92" :question/math-academy-id "e-4038" :question/problem "Evaluate $\\left(\\dfrac{1}{2} + \\sqrt{-9} \\right) + (3 - \\sqrt{-16})$." :question/worked-solution "First, we simplify the two complex numbers:\n\n$$\n\\begin{aligned}\n(\\frac{1}{2} + \\sqrt{-9}) + (3 - \\sqrt{-16}) &= (\\frac{1}{2} + 3\\textrm{i}) + (3 - 4\\textrm{i})\n\\end{aligned}\n$$\n\nTo add these two complex numbers, we just add the real parts and add the imaginary parts separately:\n\n$$\n\\begin{aligned}\n(\\frac{1}{2} + 3\\textrm{i}) + (3 - 4\\textrm{i}) &= (\\frac{1}{2} + 3) + (3 + (-4))\\textrm{i} \\\\\n&= (\\frac{1}{2} + 3) + (3 - 4)\\textrm{i} \\\\\n&= \\frac{7}{2} - 1\\textrm{i} \\\\\n&= \\frac{7}{2} - \\textrm{i}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054532 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054621 :knowledge-point/id #uuid "182eba72-4c11-5e90-8533-77cf3cd86f4c" :knowledge-point/title "Adding Purely Imaginary Numbers"}] :question/id #uuid "90553ebc-846c-5cac-8402-8370e5619e3e" :question/math-academy-id "e-4039" :question/problem "Find the value of $5\\,\\textrm{i} - 8\\,\\textrm{i}$." :question/worked-solution "To subtract two complex numbers, we just subtract the real parts and subtract the imaginary parts separately.\n\nIn this case, $5\\,\\textrm{i}$ and $8\\,\\textrm{i}$ are purely imaginary numbers. Therefore, we only need to subtract their imaginary parts, as follows:\n\n$$\n\\begin{aligned}\n5\\textrm{i} - 8\\textrm{i} = (5 - 8)\\textrm{i} &= -3\\textrm{i}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186055454 :knowledge-point/_questions [{:db/id #edb/ref 17592186054621 :knowledge-point/id #uuid "182eba72-4c11-5e90-8533-77cf3cd86f4c" :knowledge-point/title "Adding Purely Imaginary Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80a9a071-f262-5d97-93cc-f07f63feb49a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\textrm{i}" :db/id #edb/ref 17592186053962} {:answer/id #uuid "a9533e5e-fe2e-51a3-8834-6db2c6097d93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\textrm{i}" :db/id #edb/ref 17592186053963} {:answer/id #uuid "f0bc64da-7bbe-543c-ae7c-85ccc33dc045" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\textrm{i}" :db/id #edb/ref 17592186053964} {:answer/id #uuid "15d2f8a1-bb4d-5fc7-86a7-86ac6157b685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\textrm{i}" :db/id #edb/ref 17592186053965} {:answer/id #uuid "602c47b5-0a5d-592e-a1b0-373a585bbf15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\textrm{i}" :db/id #edb/ref 17592186053966}] :answer-field/id #uuid "8c8a5bd8-03fc-5a74-b861-d63c11fa8d61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186053961}] :question/id #uuid "364e62b3-17d8-5120-8d1a-de45f9f1ea81" :question/math-academy-id "q-66351" :question/problem "What is $-5\\textrm{i} + \\textrm{i}$?"}]}
