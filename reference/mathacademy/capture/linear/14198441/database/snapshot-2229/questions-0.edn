#{[{:db/id #edb/ref 17592186054529 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054618 :knowledge-point/id #uuid "07f13e54-35a5-5eca-a35a-292e26c6c2da" :knowledge-point/title "Adding Complex Numbers"}] :question/id #uuid "f6b5bac8-9d99-50d8-91a9-c4d74cc67845" :question/math-academy-id "e-4036" :question/problem "Evaluate $(4 + 3\\,\\textrm{i}) + (1 + 5\\,\\textrm{i}).$" :question/worked-solution "To add complex numbers, we just add the real parts and add the imaginary parts separately.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(4+3\\,\\text{i})+(1+5\\,\\text{i}) & =(4+3\\,\\text{i})+(1+5\\,\\text{i}) \\\\  & =(4+1)+(3+5)\\,\\text{i} \\\\  & =5+8\\,\\text{i}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054530 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054619 :knowledge-point/id #uuid "51cc4831-5d5f-5410-abd7-cb7bbc6dfa64" :knowledge-point/title "Subtracting Complex Numbers"}] :question/id #uuid "27ea592a-9ca6-5c04-8cdd-2e5a54443d89" :question/math-academy-id "e-4037" :question/problem "Find the value of $(5 + 4\\,\\textrm{i}) - (1 + 2\\,\\textrm{i}).$" :question/worked-solution "To subtract complex numbers, we just subtract the real parts and subtract the imaginary parts separately.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(5+4\\,\\text{i})-(1+2\\,\\text{i}) & =(5+4\\,\\text{i})-(1+2\\,\\text{i}) \\\\  & =(5-1)+(4-2)\\,\\text{i} \\\\  & =4+2\\,\\text{i}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054531 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054620 :knowledge-point/id #uuid "8246fcfc-c7fb-51e8-826a-ed4e88665706" :knowledge-point/title "Adding and Subtracting Complex Numbers Written in Nonstandard Form"}] :question/id #uuid "649f45a2-291d-5a39-95f1-fce18eb87a92" :question/math-academy-id "e-4038" :question/problem "Evaluate $\\left( \\dfrac{1}{2} + \\sqrt{-9} \\right) + (3 - \\sqrt{-16}).$" :question/worked-solution "First, we simplify the two complex numbers:\n\n$$\n\\begin{aligned}(\\frac{1}{2}+\\sqrt{-9})+(3-\\sqrt{-16}) & =(\\frac{1}{2}+3\\,\\text{i})+(3-4\\,\\text{i})\\end{aligned}\n$$\n\nTo add these two complex numbers, we just add the real parts and add the imaginary parts separately:\n\n$$\n\\begin{aligned}(\\frac{1}{2}+3\\,\\text{i})+(3-4\\,\\text{i}) & =(\\frac{1}{2}+3)+(3+(-4))\\,\\text{i} \\\\  & =(\\frac{1}{2}+3)+(3-4)\\,\\text{i} \\\\  & =\\frac{7}{2}-1\\,\\text{i} \\\\  & =\\frac{7}{2}-\\,\\text{i}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054532 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054621 :knowledge-point/id #uuid "182eba72-4c11-5e90-8533-77cf3cd86f4c" :knowledge-point/title "Adding Purely Imaginary Numbers"}] :question/id #uuid "90553ebc-846c-5cac-8402-8370e5619e3e" :question/math-academy-id "e-4039" :question/problem "Find the value of $5\\,\\textrm{i} - 8\\,\\textrm{i}.$" :question/worked-solution "To subtract two complex numbers, we just subtract the real parts and subtract the imaginary parts separately.\n\nIn this case, $5\\,\\textrm{i}$ and $8\\,\\textrm{i}$ are purely imaginary numbers. Therefore, we only need to subtract their imaginary parts, as follows:\n\n$$\n\\begin{aligned}5\\,\\text{i}-8\\,\\text{i}=(5-8)\\,\\text{i} & =-3\\,\\text{i}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514427 :knowledge-point/_questions [{:db/id #edb/ref 17592186054618 :knowledge-point/id #uuid "07f13e54-35a5-5eca-a35a-292e26c6c2da" :knowledge-point/title "Adding Complex Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a18b95fe-6c98-57a7-ae2f-3ca24bd943f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25\\,\\text{i}" :db/id #edb/ref 17592186513949} {:answer/id #uuid "b57a245e-1093-5bc9-8e37-21d433d0a2b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13+12\\,\\text{i}" :db/id #edb/ref 17592186514006} {:answer/id #uuid "b70564fd-c28e-5650-b029-277da150c18d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12+\\text{i}" :db/id #edb/ref 17592186514013} {:answer/id #uuid "bb29e39b-0710-5aa3-9857-73dbb8cd6550" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12-13\\,\\text{i}" :db/id #edb/ref 17592186514029} {:answer/id #uuid "d317ed69-e388-54da-8c7e-91d2b243ec5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12+13\\,\\text{i}" :db/id #edb/ref 17592186514086}] :answer-field/correct {:answer/id #uuid "d317ed69-e388-54da-8c7e-91d2b243ec5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12+13\\,\\text{i}" :db/id #edb/ref 17592186514086} :answer-field/id #uuid "45188644-8b02-5716-ad9f-533d5c1afabc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514257}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7b28b38e-826f-526f-9fc1-5f33d99b85c5" :question/math-academy-id "q-112858" :question/problem "$(7+10\\,\\text{i})+(5+3\\,\\text{i})=$" :question/worked-solution "Given the complex number $a+b\\,\\text{i},$ $a$ represents its real part while $b$ represents its imaginary part.\n\nTo add or subtract complex numbers, we add or subtract their real parts, and we add or subtract their imaginary parts.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(7+10\\,\\text{i})+(5+3\\,\\text{i}) & =(7+5)+(10+3)\\,\\text{i} \\\\  & =12+13\\,\\text{i}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514395 :knowledge-point/_questions [{:db/id #edb/ref 17592186054618 :knowledge-point/id #uuid "07f13e54-35a5-5eca-a35a-292e26c6c2da" :knowledge-point/title "Adding Complex Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db45de76-ba75-5058-9e59-6db68de8b937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+3i" :db/id #edb/ref 17592186514106}] :answer-field/correct {:answer/id #uuid "db45de76-ba75-5058-9e59-6db68de8b937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+3i" :db/id #edb/ref 17592186514106} :answer-field/id #uuid "ef3ea9f3-b4bf-5f8d-8b1d-d64fc9e0274e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514342}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "43125a76-2814-5690-9f8b-34c658dd4ad3" :question/math-academy-id "q-218423" :question/problem "Evaluate the following expression. Use $i$ to denote the imaginary unit.\n\n$(-5+12\\,\\text{i})+(6-9\\,\\text{i})=$\n{{field-1}}" :question/worked-solution "Given the complex number $a+b\\,\\text{i},$ $a$ represents its real part while $b$ represents its imaginary part.\n\nTo add or subtract complex numbers, we add or subtract their real parts, and we add or subtract their imaginary parts.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(-5+12\\,\\text{i})+(6-9\\,\\text{i}) & =(-5+6)+(12+(-9))\\,\\text{i} \\\\  & =(-5+6)+(12-9)\\,\\text{i} \\\\  & =1+3\\,\\text{i}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514394 :knowledge-point/_questions [{:db/id #edb/ref 17592186054620 :knowledge-point/id #uuid "8246fcfc-c7fb-51e8-826a-ed4e88665706" :knowledge-point/title "Adding and Subtracting Complex Numbers Written in Nonstandard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a89be58-04f8-549a-99ab-01a52f4fea1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186513892}] :answer-field/correct {:answer/id #uuid "8a89be58-04f8-549a-99ab-01a52f4fea1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186513892} :answer-field/id #uuid "3b37a3b1-6734-5517-b9b6-09a79f9d9a30" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514250} {:answer-field/choices [{:answer/id #uuid "5f4e0111-628c-57f0-a84a-ba72cd5d67ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186513788}] :answer-field/correct {:answer/id #uuid "5f4e0111-628c-57f0-a84a-ba72cd5d67ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186513788} :answer-field/id #uuid "dc4447ed-0309-5781-8693-3c34c1c2934f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514327}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "40969b77-0e08-50d1-86b5-46f58976876a" :question/math-academy-id "q-218434" :question/problem "Expressed as a complex number,\n\n$(1+\\sqrt{-45})-(-5+\\sqrt{-20})=$\n{{field-1}}$+\\,$\n{{field-2}}$\\text{i}.$" :question/worked-solution "Given the complex number $a+b\\,\\text{i},$ $a$ represents its real part while $b$ represents its imaginary part.\n\nTo add or subtract complex numbers, we add or subtract their real parts, and we add or subtract their imaginary parts.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(1+\\sqrt{-45})-(-5+\\sqrt{-20}) & =(1+\\sqrt{9\\cdot 5}\\,\\text{i})-(-5+\\sqrt{4\\cdot 5}\\,\\text{i}) \\\\  & =(1+3\\sqrt{5}\\,\\text{i})-(-5+2\\sqrt{5}\\,\\text{i}) \\\\  & =(1-(-5))+(3\\sqrt{5}-2\\sqrt{5})\\,\\text{i} \\\\  & =(1+5)+\\sqrt{5}\\,\\text{i} \\\\  & =6+\\sqrt{5}\\,\\text{i}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514450 :knowledge-point/_questions [{:db/id #edb/ref 17592186054619 :knowledge-point/id #uuid "51cc4831-5d5f-5410-abd7-cb7bbc6dfa64" :knowledge-point/title "Subtracting Complex Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27132c15-48bb-519a-8433-8ad00beff0ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3-4i" :db/id #edb/ref 17592186513641}] :answer-field/correct {:answer/id #uuid "27132c15-48bb-519a-8433-8ad00beff0ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3-4i" :db/id #edb/ref 17592186513641} :answer-field/id #uuid "84cfae3d-dc49-5af3-9269-cc5969182764" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514291}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a8e5bfd0-3749-5d98-b80f-2065e3b9d3d1" :question/math-academy-id "q-250190" :question/problem "Evaluate the following expression. Use $i$ to denote the imaginary unit.\n\n$(6-4\\,\\text{i})-3=$\n{{field-1}}" :question/worked-solution "Given the complex number $a+b\\,\\text{i},$ $a$ represents its real part while $b$ represents its imaginary part.\n\nTo add or subtract complex numbers, we add or subtract their real parts, and we add or subtract their imaginary parts.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(6-4\\,\\text{i})-3 & =(6-4\\,\\text{i})+(-3+0\\,\\text{i}) \\\\  & =(6-3)+(-4+0)\\,\\text{i} \\\\  & =3+(-4)\\,\\text{i} \\\\  & =3-4\\,\\text{i}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514413 :knowledge-point/_questions [{:db/id #edb/ref 17592186054620 :knowledge-point/id #uuid "8246fcfc-c7fb-51e8-826a-ed4e88665706" :knowledge-point/title "Adding and Subtracting Complex Numbers Written in Nonstandard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3843c03-98c7-58c6-b801-92ef6cb7f0e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186513952}] :answer-field/correct {:answer/id #uuid "a3843c03-98c7-58c6-b801-92ef6cb7f0e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186513952} :answer-field/id #uuid "1916ec5a-aa89-555d-8e86-4d02c1b34da1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514225} {:answer-field/choices [{:answer/id #uuid "922ac4ed-7347-5845-ad77-375c590794f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\sqrt{5}" :db/id #edb/ref 17592186513911}] :answer-field/correct {:answer/id #uuid "922ac4ed-7347-5845-ad77-375c590794f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\sqrt{5}" :db/id #edb/ref 17592186513911} :answer-field/id #uuid "fca53e00-b552-516f-9262-d39536b24fc1" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514352}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "683bbf9d-fe44-596b-9cba-6b07323bd6d5" :question/math-academy-id "q-250273" :question/problem "Expressed as a complex number,\n\n$(11-\\sqrt{-80})-(6+\\sqrt{-125})=$\n{{field-1}}$-\\,$\n{{field-2}}$\\text{i}.$" :question/worked-solution "Given the complex number $a+b\\,\\text{i},$ $a$ represents its real part while $b$ represents its imaginary part.\n\nTo add or subtract complex numbers, we add or subtract their real parts, and we add or subtract their imaginary parts.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(11-\\sqrt{-80})-(6+\\sqrt{-125}) & =(11-\\sqrt{16\\cdot 5}\\,\\text{i})-(6+\\sqrt{25\\cdot 5}\\,\\text{i}) \\\\  & =(11-4\\sqrt{5}\\,\\text{i})-(6+5\\sqrt{5}\\,\\text{i}) \\\\  & =(11-6)+(-4\\sqrt{5}-5\\sqrt{5})\\,\\text{i} \\\\  & =5-9\\sqrt{5}\\,\\text{i}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514379 :knowledge-point/_questions [{:db/id #edb/ref 17592186054621 :knowledge-point/id #uuid "182eba72-4c11-5e90-8533-77cf3cd86f4c" :knowledge-point/title "Adding Purely Imaginary Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "499d2470-ca75-5036-b798-09ddfbde9645" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-13i" :db/id #edb/ref 17592186513731}] :answer-field/correct {:answer/id #uuid "499d2470-ca75-5036-b798-09ddfbde9645" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-13i" :db/id #edb/ref 17592186513731} :answer-field/id #uuid "12c79ce4-e236-5b81-a2c2-6e089ea4d1fc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514218}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "246ccde2-7d9b-5b08-9b39-f9d20f01227f" :question/math-academy-id "q-250309" :question/problem "Evaluate the following expression. Use $i$ to denote the imaginary unit.\n\n$-5\\,\\text{i}-8\\,\\text{i}=$\n{{field-1}}" :question/worked-solution "To add or subtract complex numbers, we add or subtract their real parts, and we add or subtract their imaginary parts.\n\nIn this case, $-5\\,\\text{i}$ and $8\\,\\text{i}$ are purely imaginary numbers. Therefore, we only need to add their imaginary parts, as follows:\n\n$$\n-5\\,\\text{i}-8\\,\\text{i}=(-5-8)\\,\\text{i}=-13\\,\\text{i}\n$$"}] [{:db/id #edb/ref 17592186514473 :knowledge-point/_questions [{:db/id #edb/ref 17592186054619 :knowledge-point/id #uuid "51cc4831-5d5f-5410-abd7-cb7bbc6dfa64" :knowledge-point/title "Subtracting Complex Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ff78c2c-d893-5e71-a551-f6f4b8bd257b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3-12\\,\\text{i}" :db/id #edb/ref 17592186513570} {:answer/id #uuid "2c5f3c09-13bd-51a0-b193-7c0def637ec4" :answer/type {:db/id #