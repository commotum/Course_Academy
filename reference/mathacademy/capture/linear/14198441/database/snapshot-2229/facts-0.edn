7592186053961 #edb/ref 1079 #uuid "8c8a5bd8-03fc-5a74-b861-d63c11fa8d61" #edb/ref 17592186045417] [17592186054529 #edb/ref 1069 "e-4036" #edb/ref 17592186045417] [17592186054529 #edb/ref 1071 "Evaluate $(4 + 3\\,\\textrm{i}) + (1 + 5\\,\\textrm{i}).$" #edb/ref 17592186045417] [17592186054529 #edb/ref 1072 #uuid "f6b5bac8-9d99-50d8-91a9-c4d74cc67845" #edb/ref 17592186045417] [17592186054529 #edb/ref 1074 "To add complex numbers, we just add the real parts and add the imaginary parts separately.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(4+3\\,\\text{i})+(1+5\\,\\text{i}) & =(4+3\\,\\text{i})+(1+5\\,\\text{i}) \\\\  & =(4+1)+(3+5)\\,\\text{i} \\\\  & =5+8\\,\\text{i}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186054530 #edb/ref 1069 "e-4037" #edb/ref 17592186045417] [17592186054530 #edb/ref 1071 "Find the value of $(5 + 4\\,\\textrm{i}) - (1 + 2\\,\\textrm{i}).$" #edb/ref 17592186045417] [17592186054530 #edb/ref 1072 #uuid "27ea592a-9ca6-5c04-8cdd-2e5a54443d89" #edb/ref 17592186045417] [17592186054530 #edb/ref 1074 "To subtract complex numbers, we just subtract the real parts and subtract the imaginary parts separately.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(5+4\\,\\text{i})-(1+2\\,\\text{i}) & =(5+4\\,\\text{i})-(1+2\\,\\text{i}) \\\\  & =(5-1)+(4-2)\\,\\text{i} \\\\  & =4+2\\,\\text{i}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186054531 #edb/ref 1069 "e-4038" #edb/ref 17592186045417] [17592186054531 #edb/ref 1071 "Evaluate $\\left( \\dfrac{1}{2} + \\sqrt{-9} \\right) + (3 - \\sqrt{-16}).$" #edb/ref 17592186045417] [17592186054531 #edb/ref 1072 #uuid "649f45a2-291d-5a39-95f1-fce18eb87a92" #edb/ref 17592186045417] [17592186054531 #edb/ref 1074 "First, we simplify the two complex numbers:\n\n$$\n\\begin{aligned}(\\frac{1}{2}+\\sqrt{-9})+(3-\\sqrt{-16}) & =(\\frac{1}{2}+3\\,\\text{i})+(3-4\\,\\text{i})\\end{aligned}\n$$\n\nTo add these two complex numbers, we just add the real parts and add the imaginary parts separately:\n\n$$\n\\begin{aligned}(\\frac{1}{2}+3\\,\\text{i})+(3-4\\,\\text{i}) & =(\\frac{1}{2}+3)+(3+(-4))\\,\\text{i} \\\\  & =(\\frac{1}{2}+3)+(3-4)\\,\\text{i} \\\\  & =\\frac{7}{2}-1\\,\\text{i} \\\\  & =\\frac{7}{2}-\\,\\text{i}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186054532 #edb/ref 1069 "e-4039" #edb/ref 17592186045417] [17592186054532 #edb/ref 1071 "Find the value of $5\\,\\textrm{i} - 8\\,\\textrm{i}.$" #edb/ref 17592186045417] [17592186054532 #edb/ref 1072 #uuid "90553ebc-846c-5cac-8402-8370e5619e3e" #edb/ref 17592186045417] [17592186054532 #edb/ref 1074 "To subtract two complex numbers, we just subtract the real parts and subtract the imaginary parts separately.\n\nIn this case, $5\\,\\textrm{i}$ and $8\\,\\textrm{i}$ are purely imaginary numbers. Therefore, we only need to subtract their imaginary parts, as follows:\n\n$$\n\\begin{aligned}5\\,\\text{i}-8\\,\\text{i}=(5-8)\\,\\text{i} & =-3\\,\\text{i}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186054618 #edb/ref 1037 #edb/ref 17592186049565 #edb/ref 17592186045417] [17592186054618 #edb/ref 1037 #edb/ref 17592186050452 #edb/ref 17592186045417] [17592186054618 #edb/ref 1038 #edb/ref 17592186054974 #edb/ref 17592186045417] [17592186054618 #edb/ref 1038 #edb/ref 17592186055426 #edb/ref 17592186045417] [17592186054618 #edb/ref 1038 #edb/ref 17592186514395 #edb/ref 17592186045417] [17592186054618 #edb/ref 1038 #edb/ref 17592186514427 #edb/ref 17592186045417] [17592186054618 #edb/ref 1039 "Adding Complex Numbers" #edb/ref 17592186045417] [17592186054618 #edb/ref 1041 #edb/ref 17592186054529 #edb/ref 17592186045417] [17592186054618 #edb/ref 1042 #uuid "07f13e54-35a5-5eca-a35a-292e26c6c2da" #edb/ref 17592186045417] [17592186054619 #edb/ref 1037 #edb/ref 17592186049939 #edb/ref 17592186045417] [17592186054619 #edb/ref 1038 #edb/ref 17592186054986 #edb/ref 17592186045417] [17592186054619 #edb/ref 1038 #edb/ref 17592186055427 #edb/ref 17592186045417] [17592186054619 #edb/ref 1038 #edb/ref 175921865144