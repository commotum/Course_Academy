9 #edb/ref 1071 "Evaluate the following expression. Use $i$ to denote the imaginary unit.\n\n$-5\\,\\text{i}-8\\,\\text{i}=$\n{{field-1}}" #edb/ref 17592186045417] [17592186514379 #edb/ref 1072 #uuid "246ccde2-7d9b-5b08-9b39-f9d20f01227f" #edb/ref 17592186045417] [17592186514379 #edb/ref 1074 "To add or subtract complex numbers, we add or subtract their real parts, and we add or subtract their imaginary parts.\n\nIn this case, $-5\\,\\text{i}$ and $8\\,\\text{i}$ are purely imaginary numbers. Therefore, we only need to add their imaginary parts, as follows:\n\n$$\n-5\\,\\text{i}-8\\,\\text{i}=(-5-8)\\,\\text{i}=-13\\,\\text{i}\n$$" #edb/ref 17592186045417] [17592186514394 #edb/ref 1068 #edb/ref 17592186514250 #edb/ref 17592186045417] [17592186514394 #edb/ref 1068 #edb/ref 17592186514327 #edb/ref 17592186045417] [17592186514394 #edb/ref 1069 "q-218434" #edb/ref 17592186045417] [17592186514394 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186514394 #edb/ref 1071 "Expressed as a complex number,\n\n$(1+\\sqrt{-45})-(-5+\\sqrt{-20})=$\n{{field-1}}$+\\,$\n{{field-2}}$\\text{i}.$" #edb/ref 17592186045417] [17592186514394 #edb/ref 1072 #uuid "40969b77-0e08-50d1-86b5-46f58976876a" #edb/ref 17592186045417] [17592186514394 #edb/ref 1074 "Given the complex number $a+b\\,\\text{i},$ $a$ represents its real part while $b$ represents its imaginary part.\n\nTo add or subtract complex numbers, we add or subtract their real parts, and we add or subtract their imaginary parts.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(1+\\sqrt{-45})-(-5+\\sqrt{-20}) & =(1+\\sqrt{9\\cdot 5}\\,\\text{i})-(-5+\\sqrt{4\\cdot 5}\\,\\text{i}) \\\\  & =(1+3\\sqrt{5}\\,\\text{i})-(-5+2\\sqrt{5}\\,\\text{i}) \\\\  & =(1-(-5))+(3\\sqrt{5}-2\\sqrt{5})\\,\\text{i} \\\\  & =(1+5)+\\sqrt{5}\\,\\text{i} \\\\  & =6+\\sqrt{5}\\,\\text{i}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186514395 #edb/ref 1068 #edb/ref 17592186514342 #edb/ref 17592186045417] [17592186514395 #edb/ref 1069 "q-218423" #edb/ref 17592186045417] [17592186514395 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186514395 #edb/ref 1071 "Evaluate the following expression. Use $i$ to denote the imaginary unit.\n\n$(-5+12\\,\\text{i})+(6-9\\,\\text{i})=$\n{{field-1}}" #edb/ref 17592186045417] [17592186514395 #edb/ref 1072 #uuid "43125a76-2814-5690-9f8b-34c658dd4ad3" #edb/ref 17592186045417] [17592186514395 #edb/ref 1074 "Given the complex number $a+b\\,\\text{i},$ $a$ represents its real part while $b$ represents its imaginary part.\n\nTo add or subtract complex numbers, we add or subtract their real parts, and we add or subtract their imaginary parts.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(-5+12\\,\\text{i})+(6-9\\,\\text{i}) & =(-5+6)+(12+(-9))\\,\\text{i} \\\\  & =(-5+6)+(12-9)\\,\\text{i} \\\\  & =1+3\\,\\text{i}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186514413 #edb/ref 1068 #edb/ref 17592186514225 #edb/ref 17592186045417] [17592186514413 #edb/ref 1068 #edb/ref 17592186514352 #edb/ref 17592186045417] [17592186514413 #edb/ref 1069 "q-250273" #edb/ref 17592186045417] [17592186514413 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186514413 #edb/ref 1071 "Expressed as a complex number,\n\n$(11-\\sqrt{-80})-(6+\\sqrt{-125})=$\n{{field-1}}$-\\,$\n{{field-2}}$\\text{i}.$" #edb/ref 17592186045417] [17592186514413 #edb/ref 1072 #uuid "683bbf9d-fe44-596b-9cba-6b07323bd6d5" #edb/ref 17592186045417] [17592186514413 #edb/ref 1074 "Given the complex number $a+b\\,\\text{i},$ $a$ represents its real part while $b$ represents its imaginary part.\n\nTo add or subtract complex numbers, we add or subtract their real parts, and we add or subtract their imaginary parts.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(11-\\sqrt{-80})-(6+\\sqrt{-125}) & =(11-\\sqrt{16\\cdot 5}\\,\\text{i})-(6+\\sqrt{25\\cdot 5}\\,\\text{i}) \\\\  & =(11-4\\sqrt{5}\\,\\text{i})-(6+5\\sqrt{5}\\,\\text{i}) \\\\  & =(11-6)+(-4\\sqrt{5}-5\\sqrt{5})\\,\\text{i} \\\\  & =5-9\\sqrt{5}\\,\\text{i}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186514427 #edb/ref 1068 #edb/ref 17592186514257 #edb/ref 17592186045417] [17592186514427 #edb/ref 1069 "q-112858" #edb/ref 17592186045417] [17592186514427 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186514427 #edb/ref 1071 "$(7+10\\,\\text{i})+(5+3\\,\\text{i})=$" #edb/ref 17592186045417] [17592186514427 #edb/ref 1072 #uuid "7b28b38e-826f-526f-9fc1-5f33d99b85c5" #edb/ref 17592186045417] [17592186514427 #edb/ref 1074 "Given the complex number $a+b\\,\\text{i},$ $a$ represents its real part while $b$ represents its imaginary part.\n\nTo add or subtract complex numbers, we add or subtract their real parts, and we add or subtract their imaginary parts.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(7+10\\,\\text{i})+(5+3\\,\\text{i}) & =(7+5)+(10+3)\\,\\text{i} \\\\  & =12+13\\,\\text{i}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186514450 #edb/ref 1068 #edb/ref 17592186514291 #edb/ref 17592186045417] [17592186514450 #edb/ref 1069 "q-250190" #edb/ref 17592186045417] [17592186514450 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186514450 #edb/ref 1071 "Evaluate the following expression. Use $i$ to denote the imaginary unit.\n\n$(6-4\\,\\text{i})-3=$\n{{field-1}}" #edb/ref 17592186045417] [17592186514450 #edb/ref 1072 #uuid "a8e5bfd0-3749-5d98-b80f-2065e3b9d3d1" #edb/ref 17592186045417] [17592186514450 #edb/ref 1074 "Given the complex number $a+b\\,\\text{i},$ $a$ represents its real part while $b$ represents its imaginary part.\n\nTo add or subtract complex numbers, we add or subtract their real parts, and we add or subtract their imaginary parts.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(6-4\\,\\text{i})-3 & =(6-4\\,\\text{i})+(-3+0\\,\\text{i}) \\\\  & =(6-3)+(-4+0)\\,\\text{i} \\\\  & =3+(-4)\\,\\text{i} \\\\  & =3-4\\,\\text{i}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186514457 #edb/ref 1068 #edb/ref 17592186514316 #edb/ref 17592186045417] [17592186514457 #edb/ref 1069 "q-618" #edb/ref 17592186045417] [17592186514457 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186514457 #edb/ref 1071 "$(8-\\sqrt{-4})-(-7+\\sqrt{-49})=$" #edb/ref 17592186045417] [17592186514457 #edb/ref 1072 #uuid "bbd97f04-776a-53ed-8d9f-1d2d316080bc" #edb/ref 17592186045417] [17592186514457 #edb/ref 1074 "Given the complex number $a+b\\,\\text{i},$ $a$ represents its real part while $b$ represents its imaginary part.\n\nTo add or subtract complex numbers, we add or subtract their real parts, and we add or subtract their imaginary parts.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(8-\\sqrt{-4})-(-7+\\sqrt{-49}) & =(8-2\\,\\text{i})-(-7+7\\,\\text{i}) \\\\  & =(8-(-7))+(-2-7)\\,\\text{i} \\\\  & =(8+7)-9\\,\\text{i} \\\\  & =15-9\\,\\text{i}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186514473 #edb/ref 1068 #edb/ref 17592186514308 #edb/ref 17592186045417] [17592186514473 #edb/ref 1069 "q-597" #edb/ref 17592186045417] [17592186514473 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186514473 #edb/ref 1071 "$(9+8\\,\\text{i})-(6+4\\,\\text{i})=$" #edb/ref 17592186045417] [17592186514473 #edb/ref 1072 #uuid "ef858a39-0a28-52af-9941-ce2f2a8713ef" #edb/ref 17592186045417] [17592186514473 #edb/ref 1074 "Given the complex number $a+b\\,\\text{i},$ $a$ represents its real part while $b$ represents its imaginary part.\n\nTo add or subtract complex numbers, we add or subtract their real parts, and we add or subtract their imaginary parts.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(9+8\\,\\text{i})-(6+4\\,\\text{i}) & =(9-6)+(8-4)\\,\\text{i} \\\\  & =3+4\\,\\text{i}.\\end{aligned}\n$$" #edb/ref 17592186045417]}
