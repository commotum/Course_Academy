    "q-66351": {
      "dom_id": "step-q66351",
      "name": "Question 9",
      "problem": "$-5\\,\\text{i}+\\text{i}=$",
      "worked_solution": "To add or subtract complex numbers, we add or subtract their real parts, and we add or subtract their imaginary parts.\n\nIn this case, $-5\\,\\text{i}$ and $\\text{i}$ are purely imaginary numbers. Therefore, we only need to add their imaginary parts, as follows:\n\n$$\n\\begin{aligned}-5\\,\\text{i}+\\text{i} & =-5\\,\\text{i}+1\\,\\text{i}=(-5+1)\\,\\text{i}=-4\\,\\text{i}\\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-66351-a",
