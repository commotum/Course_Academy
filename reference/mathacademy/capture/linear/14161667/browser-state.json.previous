=\"false\">(</mo><mo>−</mo><mn>2</mn><mi>x</mi><msup><mo stretchy=\"false\">)</mo><mn>3</mn></msup></mrow><msup><mn>5</mn><mn>3</mn></msup></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mn>3</mn><mn>2</mn></msup><mrow><msup><mn>4</mn><mn>2</mn></msup><msup><mi>x</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><msup><mo stretchy=\"false\">)</mo><mn>3</mn></msup><msup><mi>x</mi><mn>3</mn></msup></mrow><msup><mn>5</mn><mn>3</mn></msup></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>9</mn><mrow><mn>16</mn><msup><mi>x</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo>−</mo><mn>8</mn><msup><mi>x</mi><mn>3</mn></msup></mrow><mn>125</mn></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo>−</mo><mn>8</mn><mo>⋅</mo><mn>9</mn><msup><mi>x</mi><mn>3</mn></msup></mrow><mrow><mn>16</mn><mo>⋅</mo><mn>125</mn><msup><mi>x</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Finally, we apply the quotient rule and simplify:</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"44\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 5.727em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-bottom: 0.4em;\"><mjx-mstyle><mjx-mfrac><mjx-frac type=\"d\"><mjx-num><mjx-nstrut type=\"d\"></mjx-nstrut><mjx-mrow><mjx-mo class=\"mjx-n\"><mjx-c class