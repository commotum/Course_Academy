  "live_records": {
    "q-51811": {
      "dom_id": "step-q51811",
      "name": "Question 1",
      "problem": "Which of the following is equivalent to ${(\\frac{wt}{2})}^{4}?$",
      "worked_solution": "First, we apply the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{wt}{2})}^{4}=\\frac{(wt)^{4}}{{2}^{4}}\\end{aligned}\n$$\n\nThen, we apply the power of product rule:\n\n$$\n\\begin{aligned}\\frac{(wt)^{4}}{{2}^{4}}=\\frac{{w}^{4}{t}^{4}}{16}\\end{aligned}\n$$",
      "calculator_instructions": "",
