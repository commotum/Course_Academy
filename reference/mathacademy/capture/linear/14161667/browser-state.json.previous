 columnalign=\"right\" columnspacing=\"\" rowspacing=\"3pt\"><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo stretchy=\"false\">(</mo><mi>w</mi><mi>t</mi><msup><mo stretchy=\"false\">)</mo><mn>4</mn></msup></mrow><msup><mn>2</mn><mn>4</mn></msup></mfrac></mstyle><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><msup><mi>w</mi><mn>4</mn></msup><msup><mi>t</mi><mn>4</mn></msup></mrow><mn>16</mn></mfrac></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
