ident :answer-field.type/radio} :db/id #edb/ref 17592186493838}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0ada8c79-b2a0-5a2c-836a-ac533831ba5c" :question/math-academy-id "q-51810" :question/problem "${(\\frac{3wt}{8})}^{2}=$" :question/worked-solution "First, we apply the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{3wt}{8})}^{2}=\\frac{(3wt)^{2}}{{8}^{2}}\\end{aligned}\n$$\n\nThen, we apply the power of product rule:\n\n$$\n\\begin{aligned}\\frac{(3wt)^{2}}{{8}^{2}} & = \\\\ \\frac{{3}^{2}{w}^{2}{t}^{2}}{{8}^{2}} & = \\\\ \\frac{9{w}^{2}{t}^{2}}{64}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493897 :knowledge-point/_questions [{:db/id #edb/ref 17592186110659 :knowledge-point/id #uuid "95f11186-e295-5091-93c3-07072b0c18eb" :knowledge-point/title "Using the Power of Quotient Rule with One Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc8f9b65-2c81-5b98-b118-1c5ba0a1575c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{w{t}^{4}}{16}" :db/id #edb/ref 17592186493701} {:answer/id #uuid "da04446e-ee47-5f61-b14d-4d21c44d682c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{w}^{4}{t}^{4}}{8}" :db/id #edb/ref 17592186493731} {:answer/id #uuid "e4f48316-1ccd-51df-9650-8fc2b23a63cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{w}^{4}{t}^{4}}{16}" :db/id #edb/ref 17592186493755} {:answer/id #uuid "ed43c60b-0204-50f4-9b2a-36acab6d2adc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{w{t}^{4}}{8}" :db/id #edb/ref 17592186493769} {:answer/id #uuid "f73f0d60-406c-5725-9667-6ef7590867ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{w}^{4}{t}^{4}}{2}" :db/id #edb/ref 17592186493791}] :answer-field/correct {:answer/id #uuid "e4f48316-1ccd-51df-9650-8fc2b23a63cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{w}^{4}{t}^{4}}{16}" :db/id #edb/ref 17592186493755} :answer-field/id #uuid "b6f50fe2-5ffa-5708-971c-1bb1bfe98ebd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493868}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "194005bc-f62b-59e9-a404-19d959ce797e" :question/math-academy-id "q-51811" :question/problem "Which of the following is equivalent to ${(\\frac{wt}{2})}^{4}?$" :question/worked-solution "First, we apply the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{wt}{2})}^{4}=\\frac{(wt)^{4}}{{2}^{4}}\\end{aligned}\n$$\n\nThen, we apply the power of product rule:\n\n$$\n\\begin{aligned}\\frac{(wt)^{4}}{{2}^{4}}=\\frac{{w}^{4}{t}^{4}}{16}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493895 :knowledge-point/_questions [{:db/id #edb/ref 17592186110660 :knowledge-point/id #uuid "422bde20-bd83-5a20-b708-734b585ac256" :knowledge-point/title "Using the Power of Quotient Rule with Two Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05f097c2-d349-566d-b1a7-de1e08a5e932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{s}^{2}}{{t}^{4}}" :db/id #edb/ref 17592186493399} {:answer/id #uuid "5835df03-1013-5074-bc17-921ef4066c19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{s}^{2}}{2{t}^{4}}" :db/id #edb/ref 17592186493526} {:answer/id #uuid "77d79dfc-932a-53e0-932b-d5746983cdec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{s}^{4}}{4{t}^{2}}" :db/id #edb/ref 17592186493571} {:answer/id #uuid "81552270-b895-5d9c-aa3e-247dcc5c61c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8{s}^{4}}{{t}^{2}}" :db/id #edb/ref 17592186493594} {:answer/id #uuid "d19d7351-db8e-5855-b293-25857ae699e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{s}^{4}}{{t}^{2}}" :db/id #edb/ref 17592186493724}] :answer-field/correct {:answer/id #uuid "d19d7351-db8e-5855-b293-25857ae699e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{s}^{4}}{{t}^{2}}" :db/id #edb/ref 17592186493724} :answer-field/id #uuid "b1dcbc3c-c562-52fc-969a-fd133bdc4cdc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493863}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "12eb7643-9611-58a5-926c-4abbb115bd9f" :question/math-academy-id "q-72635" :question/problem "${(\\frac{s}{2})}^{4}{(\\frac{4}{t})}^{2}=$" :question/worked-solution "We apply the power of quotient rule and simplify:\n\n$$\n\\begin{aligned}{(\\frac{s}{2})}^{4}{(\\frac{4}{t})}^{2} & = \\\\ \\frac{{s}^{4}}{{2}^{4}}\\cdot \\frac{{4}^{2}}{{t}^{2}} & = \\\\ \\frac{{s}^{4}}{16}\\cdot \\frac{16}{{t}^{2}} & = \\\\ \\frac{16{s}^{4}}{16{t}^{2}} & = \\\\ \\frac{{s}^{4}}{{t}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493905 :knowledge-point/_questions [{:db/id #edb/ref 17592186110660 :knowledge-point/id #uuid "422bde20-bd83-5a20-b708-734b585ac256" :knowledge-point/title "Using the Power of Quotient Rule with Two Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b428a97-41e2-590a-aace-24167e2b3de2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{125}{9{x}^{2}}" :db/id #edb/ref 17592186493409} {:answer/id #uuid "4fe68738-1add-5c51-b2f9-83c9eca8db5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{250}{3}" :db/id #edb/ref 17592186493519} {:answer/id #uuid "7fee2a5e-fafd-50c8-b51c-2713c379fc2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9x}{250}" :db/id #edb/ref 17592186493591} {:answer/id #uuid "ad881ae7-fad5-5cfc-afce-bd920e92937c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9x}{125}" :db/id #edb/ref 17592186493665} {:answer/id #uuid "f31e6fee-19f2-52ae-9c5f-033e7ed7a3be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{125{x}^{2}}" :db/id #edb/ref 17592186493784}] :answer-field/correct {:answer/id #uuid "7fee2a5e-fafd-50c8-b51c-2713c379fc2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9x}{250}" :db/id #edb/ref 17592186493591} :answer-field/id #uuid "55b1ecfe-bba9-59e4-a0d9-5e7720e663f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493824}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2b75a1b6-f44a-5a5a-8342-d11fe3f5f88d" :question/math-academy-id "q-72638" :question/problem "${(\\frac{3}{4x})}^{2}{(\\frac{-2x}{5})}^{3}=$" :question/worked-solution "First, we apply the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{3}{4x})}^{2}{(\\frac{-2x}{5})}^{3}=\\frac{{3}^{2}}{(4x)^{2}}\\cdot \\frac{(-2x)^{3}}{{5}^{3}}\\end{aligned}\n$$\n\nNext, we apply the power of product rule and multiply:\n\n$$\n\\begin{aligned}\\frac{{3}^{2}}{(4x)^{2}}\\cdot \\frac{(-2x)^{3}}{{5}^{3}} & = \\\\ \\frac{{3}^{2}}{{4}^{2}{x}^{2}}\\cdot \\frac{(-2)^{3}{x}^{3}}{{5}^{3}} & = \\\\ \\frac{9}{16{x}^{2}}\\cdot \\frac{-8{x}^{3}}{125} & = \\\\ \\frac{-8\\cdot 9{x}^{3}}{16\\cdot 125{x}^{2}}\\end{aligned}\n$$\n\nFinally, we apply the quotient rule and simplify:\n\n$$\n\\begin{aligned}\\frac{-8\\cdot 9{x}^{3}}{16\\cdot 125{x}^{2}} & = \\\\ -\\frac{9{x}^{3-2}}{2\\cdot 125} & = \\\\ -\\frac{9x}{250}\\end{aligned}\n$$"}]}
