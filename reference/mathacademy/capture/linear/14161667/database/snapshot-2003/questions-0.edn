#{[{:db/id #edb/ref 17592186110297 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110659 :knowledge-point/id #uuid "95f11186-e295-5091-93c3-07072b0c18eb" :knowledge-point/title "Using the Power of Quotient Rule with One Fraction"}] :question/id #uuid "dc436197-3170-5ed7-a8f8-2092dd72da21" :question/math-academy-id "e-1085" :question/problem "Calculate $\\left(\\dfrac{2x}{3}\\right)^4.$" :question/worked-solution "First, we apply the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{2x}{3})}^{4}=\\frac{(2x)^{4}}{{3}^{4}}\\end{aligned}\n$$\n\nThen, we apply the power rule and simplify:\n\n$$\n\\begin{aligned}\\frac{(2x)^{4}}{{3}^{4}} & = \\\\ \\frac{{2}^{4}{x}^{4}}{{3}^{4}} & = \\\\ \\frac{16{x}^{4}}{81} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186110298 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110660 :knowledge-point/id #uuid "422bde20-bd83-5a20-b708-734b585ac256" :knowledge-point/title "Using the Power of Quotient Rule with Two Fractions"}] :question/id #uuid "7d8ea34f-b406-5bc8-9c00-de65d72e9d6d" :question/math-academy-id "e-1086" :question/problem "Simplify $\\left(\\dfrac{y}{2}\\right)^3 \\left(\\dfrac{2y}{3}\\right)^2.$" :question/worked-solution "First, we apply the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{y}{2})}^{3}{(\\frac{2y}{3})}^{2}=\\frac{{y}^{3}}{{2}^{3}}\\cdot \\frac{(2y)^{2}}{{3}^{2}}\\end{aligned}\n$$\n\nNext, we apply the power rule:\n\n$$\n\\begin{aligned}\\frac{{y}^{3}}{{2}^{3}}\\cdot \\frac{(2y)^{2}}{{3}^{2}} & = \\\\ \\frac{{y}^{3}}{8}\\cdot \\frac{{2}^{2}{y}^{2}}{9} & = \\\\ \\frac{{y}^{3}}{8}\\cdot \\frac{4{y}^{2}}{9}\\end{aligned}\n$$\n\nFinally, we apply the product rule and simplify:\n\n$$\n\\begin{aligned}\\frac{{y}^{3}}{8}\\cdot \\frac{4{y}^{2}}{9} & = \\\\ \\frac{4{y}^{(3+2)}}{72} & = \\\\ \\frac{4{y}^{5}}{72} & = \\\\ \\frac{{y}^{5}}{18}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493913 :knowledge-point/_questions [{:db/id #edb/ref 17592186110660 :knowledge-point/id #uuid "422bde20-bd83-5a20-b708-734b585ac256" :knowledge-point/title "Using the Power of Quotient Rule with Two Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0306dc06-62f4-5b7e-b879-3f9511d72369" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{a}^{3}{c}^{3}}{{b}^{3}{d}^{3}}" :db/id #edb/ref 17592186493395} {:answer/id #uuid "4223f171-c54d-5992-b8eb-283452e403f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{a}^{3}{c}^{2}}{{b}^{3}{d}^{2}}" :db/id #edb/ref 17592186493503} {:answer/id #uuid "5bdac1e5-fa32-5ec5-b843-e3fd6cca8bcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{a}^{2}{c}^{2}}{{b}^{2}{d}^{2}}" :db/id #edb/ref 17592186493532} {:answer/id #uuid "a25282c7-8210-5ec4-8b82-539d7cd1e52c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{a}^{3}{d}^{2}}{{b}^{3}{c}^{2}}" :db/id #edb/ref 17592186493648} {:answer/id #uuid "d98dcd18-7738-5d61-a167-5958e7f35e79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{a}^{3}{c}^{2}}{{b}^{3}{d}^{2}}" :db/id #edb/ref 17592186493729}] :answer-field/correct {:answer/id #uuid "4223f171-c54d-5992-b8eb-283452e403f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{a}^{3}{c}^{2}}{{b}^{3}{d}^{2}}" :db/id #edb/ref 17592186493503} :answer-field/id #uuid "b9c9de44-c1c6-51ff-85d8-62b2b5e04b65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493869}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3cbc76cf-73cd-53cf-89d7-15a5f1f46f2b" :question/math-academy-id "q-22532" :question/problem "${(-\\frac{a}{b})}^{3}{(\\frac{c}{d})}^{2}=$" :question/worked-solution "We 