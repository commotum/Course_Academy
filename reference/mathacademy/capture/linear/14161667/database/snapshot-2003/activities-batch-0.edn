#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186111591} :activity/id #uuid "f40ffb7e-1747-5f74-b124-0acd55b121f3" :activity/scope {:db/id #edb/ref 17592186050672 :topic/id #uuid "5dd12522-3288-519e-ab0e-5facb1a9d356" :topic/math-academy-id 1428} :activity/steps [{:db/id #edb/ref 17592186111591 :step/content {:db/id #edb/ref 17592186111823 :tutorial/content "The **power of quotient rule** states that if we want to raise the quotient $\\dfrac{x}{y}$ to some power $n,$ we must raise the numerator and denominator to the power $n$ as follows:\n\n$$\n\\left(\\dfrac{x}{y}\\right)^n=\\dfrac{x^n}{y^n}\n$$\n\nFor example,\n\n$$\n\\left(\\dfrac{x}{y}\\right)^4=\\dfrac{x^4}{y^4}.\n$$\n\nTo see why the power of quotient rule is true, let's take the above example and work it out again the long way. We get the same result:\n\n$$\n\\begin{aligned}{(\\frac{x}{y})}^{4} & = \\\\ \\frac{x}{y}\\cdot \\frac{x}{y}\\cdot \\frac{x}{y}\\cdot \\frac{x}{y} & = \\\\ \\frac{x\\cdot x\\cdot x\\cdot x}{y\\cdot y\\cdot y\\cdot y} & = \\\\ \\frac{{x}^{4}}{{y}^{4}}\\end{aligned}\n$$\n\nThe power of quotient rule is just a shortcut for the process above." :tutorial/id #uuid "9aedc7af-544c-5314-a986-2cd6ce64479b" :tutorial/math-academy-id 1484 :tutorial/title "Introduction"} :step/id #uuid "9b35013c-5ff4-5a7c-99fa-9b6c887c8c75" :step/math-academy-id 3552 :step/next {:db/id #edb/ref 17592186111592}} {:db/id #edb/ref 17592186111592 :step/content {:db/id #edb/ref 17592186110659 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110297 :question/id #uuid "dc436197-3170-5ed7-a8f8-2092dd72da21" :question/math-academy-id "e-1085"} :knowledge-point/id #uuid "95f11186-e295-5091-93c3-07072b0c18eb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048683} {:db/id #edb/ref 17592186051009}] :knowledge-point/questions [{:db/id #edb/ref 17592186110979} {:db/id #edb/ref 17592186110980} {:db/id #edb/ref 17592186493893} {:db/id #edb/ref 17592186493897}] :knowledge-point/title "Using the Power of Quotient Rule with One Fraction"} :step/id #uuid "8fb38c77-55f0-5928-8c35-70c3ff0de790" :step/math-academy-id 3553 :step/next {:db/id #edb/ref 17592186111593}} {:db/id #edb/ref 17592186111593 :step/content {:db/id #edb/ref 17592186110660 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110298 :question/id #uuid "7d8ea34f-b406-5bc8-9c00-de65d72e9d6d" :question/math-academy-id "e-1086"} :knowledge-point/id #uuid "422bde20-bd83-5a20-b708-734b585ac256" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049253} {:db/id #edb/ref 17592186049729} {:db/id #edb/ref 17592186050802}] :knowledge-point/questions [{:db/id #edb/ref 17592186110981} {:db/id #edb/ref 17592186111332} {:db/id #edb/ref 17592186493895} {:db/id #edb/ref 17592186493905} {:db/id #edb/ref 17592186493913}] :knowledge-point/title "Using the Power of Quotient Rule with Two Fractions"} :step/id #uuid "d9b9bca6-86d4-5640-8cb5-7659bf64aa00" :step/math-academy-id 3556}] :activity/title "The Power of Quotient Rule With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110819}]}
