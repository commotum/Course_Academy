#{[{:db/id #edb/ref 17592186100600 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186101011 :knowledge-point/id #uuid "133c88b2-3a8e-5364-9f1c-548da0a1d446" :knowledge-point/title "Expressions With Integer Bases"}] :question/id #uuid "20a3ff12-b7fa-590f-a32e-c2b922324a3d" :question/math-academy-id "e-13042" :question/problem "Express $\\dfrac{(-5)^{7}}{(-5)^3}$ as a base raised to a single exponent." :question/worked-solution "First, we write the fraction as a division:\n\n$$\n\\dfrac{(-5)^{7}}{(-5)^3} = (-5)^{7} \\div (-5)^3\n$$\n\nNow, to divide powers of the same base, we simply subtract the exponents:\n\n$$\n(-5)^{7} \\div (-5)^3 = (-5)^{7-3} = (-5)^{4}\n$$"}] [{:db/id #edb/ref 17592186100601 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186101012 :knowledge-point/id #uuid "291f5ac8-b454-5a90-aa93-855c503b53fb" :knowledge-point/title "Expressions With Fractional Bases"}] :question/id #uuid "482947e3-a48c-5196-b46c-29aa03ddb57e" :question/math-academy-id "e-13043" :question/problem "Express $\\left(\\dfrac{1}{2}\\right)^4 \\div \\left(\\dfrac{1}{2}\\right)^2$ as a base raised to a single exponent." :question/worked-solution "To divide powers of the same base, we simply subtract the exponents:\n\n$$\n\\left(\\dfrac{1}{2}\\right)^4 \\div \\left(\\dfrac{1}{2}\\right)^2 = \\left(\\dfrac{1}{2}\\right)^{4-2}= \\left(\\dfrac{1}{2}\\right)^{2}\n$$"}] [{:db/id #edb/ref 17592186100602 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186101013 :knowledge-point/id #uuid "bca6f620-a846-5b3f-8fc8-db886cc8982c" :knowledge-point/title "Exponents With Decimal Bases"}] :question/id #uuid "3c2c32f1-4e6d-5363-9145-5834c59e7fd9" :question/math-academy-id "e-13044" :question/problem "Express $\\dfrac{0.2^5}{0.2^2}$ as a base raised to a single exponent." :question/worked-solution "First, we write the fraction as a division:\n\n$$\n\\dfrac{0.2^5}{0.2^2} = 0.2^5 \\div 0.2^2\n$$\n\nNow, to divide powers of the same base, we simply subtract the exponents:\n\n$$\n0.2^{5} \\div 0.2^{2} = 0.2^{5 - 2} = 0.2^{3}\n$$"}] [{:db/id #edb/ref 17592186100603 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186101014 :knowledge-point/id #uuid "549e9c1b-869e-5d96-a6fd-6684375d6e73" :knowledge-point/title "Evaluating Products with Negative Exponents"}] :question/id #uuid "b3008b70-810e-54b3-8e0b-b09dab969587" :question/math-academy-id "e-13046" :question/problem "Simplify $\\dfrac{2^3}{2^5}$." :question/worked-solution "To divide powers of the same base, we subtract the exponents:\n\n$$\n\\dfrac{2^3}{2^5} = 2^{3-5} = 2^{-2}\n$$\n\nTo evaluate $2^{-2}$, we find the reciprocal of the base $(2)$ and then raise that reciprocal to the same power but with the opposite sign:\n\n$$\n2^{-2} = \\left(\\dfrac{1}{2}\\right)^2 =\\dfrac{1}{2} \\times \\dfrac{1}{2} = \\dfrac{1}{4}\n$$"}] [{:db/id #edb/ref 17592186101512 :knowledge-point/_questions [{:db/id #edb/ref 17592186101012 :knowledge-point/id #uuid "291f5ac8-b454-5a90-aa93-855c503b53fb" :knowledge-point/title "Expressions With Fractional Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a17a503c-2f76-5ce8-8982-6b7f152e638d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{2})^{3}" :db/id #edb/ref 17592186100234} {:answer/id #uuid "d4af3ab7-eca9-50dc-8def-9c843cfe5c68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186100235} {:answer/id #uuid "150d7842-67b2-510a-a884-d1b934fd52bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{4})^{10}" :db/id #edb/ref 17592186100236} {:answer/id #uuid "38e06114-181f-52a4-a93c-b5eeb4cdf3e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{2})^{7}" :db/id #edb/ref 17592186100237} {:answer/id #uuid "4cc6ce99-a186-507b-9a58-d114c7d9b7a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{2})^{10}" :db/id #edb/ref 17592186100238}] :answer-field/id #uuid "084ba66e-aab2-52d2-be7c-915a64fbca75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186100233}] :question/id #uuid "5cbf6b15-5da1-5b9b-844a-a35b63cf7c10" :question/math-academy-id "q-68338" :question/problem "What is $(\\frac{1}{2})^{5} \\div (\\frac{1}{2})^{2}$?"}]}
