#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186101891} :activity/id #uuid "3a6c5464-4745-5574-b9b6-bc8bf2d3168d" :activity/scope {:db/id #edb/ref 17592186049081 :topic/id #uuid "d8fdcd5f-6dc8-5e77-8e2a-2ea4a2b0a545" :topic/math-academy-id 1223} :activity/steps [{:db/id #edb/ref 17592186101891 :step/content {:db/id #edb/ref 17592186102023 :tutorial/content "To divide powers of the same base, we simply *subtract* the exponents. This is known as the **quotient rule for exponents**. For instance, in the expression \n\n$$\n{\\color{blue}3}^5 \\div {\\color{blue}3}^2,\n$$\n\nboth powers have the same base $({\\color{blue}3})$. Therefore, we can simplify this expression by subtracting the exponents:\n\n$$\n{\\color{blue}3}^5 \\div {\\color{blue}3}^2 = {\\color{blue}3}^{5-2} = {\\color{blue}3}^3.\n$$\n\n**Note:** The quotient rule for exponents is really just a quicker alternative to the following process:\n\n$$\n\\begin{aligned}{3}^{5}÷{3}^{2} & = \\\\ {3}^{3+2}÷{3}^{2} & = \\\\ {3}^{3}\\times {{{3}^{2}÷{3}^{2}}_{⏟}}_{=1} & = \\\\ {3}^{3}\\times 1 & = \\\\ {3}^{3}\\end{aligned}\n$$" :tutorial/id #uuid "4547d33f-6904-539f-b917-599af56aac3b" :tutorial/math-academy-id 8158 :tutorial/title "Introduction"} :step/id #uuid "6b94b979-4e11-52b1-8a9b-15e04e81e4d9" :step/math-academy-id 53732 :step/next {:db/id #edb/ref 17592186101892}} {:db/id #edb/ref 17592186101892 :step/content {:db/id #edb/ref 17592186101011 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100600 :question/id #uuid "20a3ff12-b7fa-590f-a32e-c2b922324a3d" :question/math-academy-id "e-13042"} :knowledge-point/id #uuid "133c88b2-3a8e-5364-9f1c-548da0a1d446" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049626} {:db/id #edb/ref 17592186049714}] :knowledge-point/questions [{:db/id #edb/ref 17592186101510} {:db/id #edb/ref 17592186101511} {:db/id #edb/ref 17592186485576} {:db/id #edb/ref 17592186485591}] :knowledge-point/title "Expressions With Integer Bases"} :step/id #uuid "057713d1-a263-5f53-8bd3-f2d0b39203fc" :step/math-academy-id 53733 :step/next {:db/id #edb/ref 17592186101893}} {:db/id #edb/ref 17592186101893 :step/content {:db/id #edb/ref 17592186101012 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100601 :question/id #uuid "482947e3-a48c-5196-b46c-29aa03ddb57e" :question/math-academy-id "e-13043"} :knowledge-point/id #uuid "291f5ac8-b454-5a90-aa93-855c503b53fb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048911}] :knowledge-point/questions [{:db/id #edb/ref 17592186101512} {:db/id #edb/ref 17592186101513} {:db/id #edb/ref 17592186485522}] :knowledge-point/title "Expressions With Fractional Bases"} :step/id #uuid "9a3ab364-3da0-504d-840e-b9d167aff58d" :step/math-academy-id 53736 :step/next {:db/id #edb/ref 17592186101894}} {:db/id #edb/ref 17592186101894 :step/content {:db/id #edb/ref 17592186101013 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100602 :question/id #uuid "3c2c32f1-4e6d-5363-9145-5834c59e7fd9" :question/math-academy-id "e-13044"} :knowledge-point/id #uuid "bca6f620-a846-5b3f-8fc8-db886cc8982c" :knowledge-point/questions [{:db/id #edb/ref 17592186101514} {:db/id #edb/ref 17592186101515} {:db/id #edb/ref 17592186485508} {:db/id #edb/ref 17592186485513}] :knowledge-point/title "Exponents With Decimal Bases"} :step/id #uuid "ae0d5088-a5b4-5790-b32c-9a5a347afd37" :step/math-academy-id 53740 :step/next {:db/id #edb/ref 17592186101895}} {:db/id #edb/ref 17592186101895 :step/content {:db/id #edb/ref 17592186102024 :tutorial/content "We can use the quotient rule for exponents with negative exponents too. For example, to simplify $3^{-5}\\div 3^{-3},$ we subtract the exponents:\n\n$$\n3^{-5} \\div 3^{-3} = 3^{-5-(-3)} = 3^{-2}\n$$\n\nNow, to evaluate $3^{-2},$ we find the reciprocal of the base $(3)$ and then raise that reciprocal to the same power but with the opposite sign:\n\n$$\n3^{-2}  = \\left(\\dfrac{1}{3}\\right)^2 =\\dfrac{1}{3} \\times \\dfrac{1}{3} = \\dfrac{1}{9}\n$$" :tutorial/id #uuid "b127450f-67ae-5232-a082-2242758636fd" :tutorial/math-academy-id 8160 :tutorial/title "The Quotient Rule With Negative Exponents"} :step/id #uuid "022268b4-8f60-5abf-8aa9-00bc872f3753" :step/math-academy-id 53743 :step/next {:db/id #edb/ref 17592186101896}} {:db/id #edb/ref 17592186101896 :step/content {:db/id #edb/ref 17592186101014 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100603 :question/id #uuid "b3008b70-810e-54b3-8e0b-b09dab969587" :question/math-academy-id "e-13046"} :knowledge-point/id #uuid "549e9c1b-869e-5d96-a6fd-6684375d6e73" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048549} {:db/id #edb/ref 17592186050495}] :knowledge-point/questions [{:db/id #edb/ref 17592186101516} {:db/id #edb/ref 17592186101517} {:db/id #edb/ref 17592186485492} {:db/id #edb/ref 17592186485521} {:db/id #edb/ref 17592186485528} {:db/id #edb/ref 17592186485584}] :knowledge-point/title "Evaluating Products with Negative Exponents"} :step/id #uuid "0ae0dbda-f758-51e1-9667-fa2b080a2a6b" :step/math-academy-id 53747}] :activity/title "The Quotient Rule for Exponents" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186101075}]}
