5498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186484883} {:answer/id #uuid "498857fc-e205-5e8c-81b2-ebd5d66bdab3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186484977} {:answer/id #uuid "93fb7776-9234-5fcb-afe2-3a9bab6c861b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{32}" :db/id #edb/ref 17592186485137} {:answer/id #uuid "e4e0737a-c55a-53f1-8296-8cbdb2042a88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186485299}] :answer-field/correct {:answer/id #uuid "17e736bb-dd08-51b3-851b-0424dd8b1e5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186484864} :answer-field/id #uuid "688e485a-87e1-5e22-8ef5-920c7f1b5542" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485408}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "dade69e9-73ae-574b-b21e-ceb9971eb952" :question/math-academy-id "q-68357" :question/problem "${2}^{-9}÷{2}^{-5}=$" :question/worked-solution "To divide powers of the same base, we simply subtract the exponents:\n\n$$\n{2}^{-9}÷{2}^{-5}={2}^{(-9)-(-5)}={2}^{-4}\n$$\n\nTo evaluate ${2}^{-4},$ we find the reciprocal of the base $(2)$ and then raise that reciprocal to the same power but with the opposite sign:\n\n$$\n{2}^{-4}={(\\frac{1}{2})}^{4}=\\frac{1}{2}\\times \\frac{1}{2}\\times \\frac{1}{2}\\times \\frac{1}{2}=\\frac{1}{16}\n$$"}] [{:db/id #edb/ref 17592186485576 :knowledge-point/_questions [{:db/id #edb/ref 17592186101011 :knowledge-point/id #uuid "133c88b2-3a8e-5364-9f1c-548da0a1d446" :knowledge-point/title "Expressions With Integer Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "208aacc2-c2ef-5d30-936c-23fe5a01dc2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2)^{-4}" :db/id #edb/ref 17592186484878} {:answer/id #uuid "78ac69d7-4fb4-53e8-a972-8043fbc99ff2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2)^{10}" :db/id #edb/ref 17592186485076} {:answer/id #uuid "90cd3496-62c8-51c2-9150-37d7cc7d75c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{2}^{-4}" :db/id #edb/ref 17592186485134} {:answer/id #uuid "bbf75fb3-e091-53e6-a734-b0c3fdb293a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2)^{4}" :db/id #edb/ref 17592186485221} {:answer/id #uuid "e9414fda-ce3b-5c86-a7a8-657ac7bbb3c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{2}^{4}" :db/id #edb/ref 17592186485310}] :answer-field/correct {:answer/id #uuid "bbf75fb3-e091-53e6-a734-b0c3fdb293a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2)^{4}" :db/id #edb/ref 17592186485221} :answer-field/id #uuid "adb1e5ef-6744-5273-b11f-b1e143338675" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485442}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ba0bf3ae-2fd6-52ea-bcad-b5d5a3e42790" :question/math-academy-id "q-72644" :question/problem "$(-2)^{7}\\cdot \\frac{1}{(-2)^{3}}=$" :question/worked-solution "First, we write the fraction as a division:\n\n$$\n\\begin{aligned}(-2)^{7}\\cdot \\frac{1}{(-2)^{3}} & =\\frac{(-2)^{7}}{(-2)^{3}} \\\\  & =(-2)^{7}÷(-2)^{3}\\end{aligned}\n$$\n\nNow, to divide powers of the same base, we simply subtract the exponents:\n\n$$\n\\begin{aligned}(-2)^{7}÷(-2)^{3} & =(-2)^{7-3} \\\\  & =(-2)^{4}\\end{aligned}\n$$"}]}
