#{[{:db/id #edb/ref 17592186100600 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186101011 :knowledge-point/id #uuid "133c88b2-3a8e-5364-9f1c-548da0a1d446" :knowledge-point/title "Expressions With Integer Bases"}] :question/id #uuid "20a3ff12-b7fa-590f-a32e-c2b922324a3d" :question/math-academy-id "e-13042" :question/problem "Express $\\dfrac{(-5)^{7}}{(-5)^3}$ as a base raised to a single exponent." :question/worked-solution "First, we write the fraction as a division:\n\n$$\n\\dfrac{(-5)^{7}}{(-5)^3} = (-5)^{7} \\div (-5)^3\n$$\n\nNow, to divide powers of the same base, we simply subtract the exponents:\n\n$$\n(-5)^{7} \\div (-5)^3 = (-5)^{7-3} = (-5)^{4}\n$$"}] [{:db/id #edb/ref 17592186100601 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186101012 :knowledge-point/id #uuid "291f5ac8-b454-5a90-aa93-855c503b53fb" :knowledge-point/title "Expressions With Fractional Bases"}] :question/id #uuid "482947e3-a48c-5196-b46c-29aa03ddb57e" :question/math-academy-id "e-13043" :question/problem "Express $\\left(\\dfrac{1}{2}\\right)^4 \\div \\left(\\dfrac{1}{2}\\right)^2$ as a base raised to a single exponent." :question/worked-solution "To divide powers of the same base, we simply subtract the exponents:\n\n$$\n\\left(\\dfrac{1}{2}\\right)^4 \\div \\left(\\dfrac{1}{2}\\right)^2 = \\left(\\dfrac{1}{2}\\right)^{4-2}= \\left(\\dfrac{1}{2}\\right)^{2}\n$$"}] [{:db/id #edb/ref 17592186100602 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186101013 :knowledge-point/id #uuid "bca6f620-a846-5b3f-8fc8-db886cc8982c" :knowledge-point/title "Exponents With Decimal Bases"}] :question/id #uuid "3c2c32f1-4e6d-5363-9145-5834c59e7fd9" :question/math-academy-id "e-13044" :question/problem "Express $\\dfrac{0.2^5}{0.2^2}$ as a base raised to a single exponent." :question/worked-solution "First, we write the fraction as a division:\n\n$$\n\\dfrac{0.2^5}{0.2^2} = 0.2^5 \\div 0.2^2\n$$\n\nNow, to divide powers of the same base, we simply subtract the exponents:\n\n$$\n\\begin{aligned}{0.2}^{5}÷{0.2}^{2}={0.2}^{5-2}={0.2}^{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186100603 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186101014 :knowledge-point/id #uuid "549e9c1b-869e-5d96-a6fd-6684375d6e73" :knowledge-point/title "Evaluating Products with Negative Exponents"}] :question/id #uuid "b3008b70-810e-54b3-8e0b-b09dab969587" :question/math-academy-id "e-13046" :question/problem "Simplify $\\dfrac{2^3}{2^5}.$" :question/worked-solution "To divide powers of the same base, we subtract the exponents:\n\n$$\n\\dfrac{2^3}{2^5} = 2^{3-5} = 2^{-2}\n$$\n\nTo evaluate $2^{-2},$ we find the reciprocal of the base $(2)$ and then raise that reciprocal to the same power but with the opposite sign:\n\n$$\n2^{-2}  = \\left(\\dfrac{1}{2}\\right)^2 =\\dfrac{1}{2} \\times \\dfrac{1}{2} = \\dfrac{1}{4}\n$$"}] [{:db/id #edb/ref 17592186485513 :knowledge-point/_questions [{:db/id #edb/ref 17592186101013 :knowledge-point/id #uuid "bca6f620-a846-5b3f-8fc8-db886cc8982c" :knowledge-point/title "Exponents With Decimal Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "128c0a38-e684-5745-984c-b55990ba8da2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0.01}^{2}" :db/id #edb/ref 17592186484853} {:answer/id #uuid "47a3b626-320b-56e8-91a8-0c9fd9d1af96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0.01}^{-2}" :db/id #edb/ref 17592186484971} {:answer/id #uuid "9b5b4740-07d1-5fa3-b3af-3343d1bc13a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186485155} {:answer/id #uuid "aed9babb-208b-5a77-bc14-20439075838b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0.01}^{3/4}" :db/id #edb/ref 17592186485197} {:answer/id #uuid "dca00683-6888-55fd-8e20-ae0ad7a5b748" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0.01}^{4/3}" :db/id #edb/ref 17592186485280}] :answer-field/correct {:answer/id #uuid "47a3b626-320b-56e8-91a8-0c9fd9d1af96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0.01}^{-2}" :db/id #edb/ref 17592186484971} :answer-field/id #uuid "6a43851d-f1ae-55ee-ba67-6621c9a66941" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485409}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "34da0315-7401-50d5-a9e5-7e5606f6c11f" :question/math-academy-id "q-100343" :question/problem "$\\frac{{0.01}^{6}}{{0.01}^{8}}=$" :question/worked-solution "First, we write the fraction as a division:\n\n$$\n\\frac{{0.01}^{6}}{{0.01}^{8}}={0.01}^{6}÷{0.01}^{8}\n$$\n\nTo divide powers of the same base, we simply subtract the exponents:\n\n$$\n\\begin{aligned}{0.01}^{6}÷{0.01}^{8} & ={0.01}^{6-8} \\\\  & ={0.01}^{-2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485508 :knowledge-point/_questions [{:db/id #edb/ref 17592186101013 :knowledge-point/id #uuid "bca6f620-a846-5b3f-8fc8-db886cc8982c" :knowledge-point/title "Exponents With Decimal Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30ea2d6c-7c11-5f7c-874c-f4b3457ccf93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1.8)^{1/3}" :db/id #edb/ref 17592186484918} {:answer/id #uuid "3c20fe87-9e83-5a3d-bc8c-effaad0460c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1.8)^{-6}" :db/id #edb/ref 17592186484942} {:answer/id #uuid "3d22ad08-96ec-5e51-9149-8db92710a911" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1.8)^{3}" :db/id #edb/ref 17592186484947} {:answer/id #uuid "52022faa-3ca5-5103-ba34-8439fbd3265c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :ans