387}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4c73aa99-debd-5794-8ba7-65ccf58c6b12" :question/math-academy-id "q-185293" :question/problem "Expressed as a fraction in its simplest form, $\\frac{{2}^{-2}}{{2}^{2}}=${{field-1}}." :question/worked-solution "To divide powers of the same base, we simply subtract the exponents:\n\n$$\n\\frac{{2}^{-2}}{{2}^{2}}={2}^{-2-2}={2}^{-4}\n$$\n\nTo evaluate ${2}^{-4},$ we find the reciprocal of the base $(2)$ and then raise that reciprocal to the same power but with the opposite sign:\n\n$$\n{2}^{-4}={(\\frac{1}{2})}^{4}=\\frac{1}{2}\\times \\frac{1}{2}\\times \\frac{1}{2}\\times \\frac{1}{2}=\\frac{1}{16}\n$$"}] [{:db/id #edb/ref 17592186485521 :knowledge-point/_questions [{:db/id #edb/ref 17592186101014 :knowledge-point/id #uuid "549e9c1b-869e-5d96-a6fd-6684375d6e73" :knowledge-point/title "Evaluating Products with Negative Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3482c303-6fca-5901-852b-e619c98458ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186484928} {:answer/id #uuid "3afa9deb-885c-52d6-a45d-127298fe4d1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{25}" :db/id #edb/ref 17592186484939} {:answer/id #uuid "9ab0bb7b-86d9-51bf-88ed-98a433ac44e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{125}" :db/id #edb/ref 17592186485153} {:answer/id #uuid "c18dd5a4-0919-5101-8048-855d479f3615" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186485232} {:answer/id #uuid "cdb1a1ec-60f2-58e1-a6d5-c32687beed48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186485254}] :answer-field/correct {:answer/id #uuid "3afa9deb-885c-52d6-a45d-127298fe4d1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{25}" :db/id #edb/ref 17592186484939} :answer-field/id #uuid "0acca603-a05b-5f68-b892-8a15125bba86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485369}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3f475ee2-0efc-5b85-a0eb-323e7d9761d6" :question/math-academy-id "q-68123" :question/problem "$\\frac{{5}^{4}}{{5}^{6}}=$" :question/worked-solution "To divide powers of the same base, we simply subtract the exponents:\n\n$$\n\\frac{{5}^{4}}{{5}^{6}}={5}^{4-6}={5}^{-2}\n$$\n\nTo evaluate ${5}^{-2},$ we find the reciprocal of the base $(5)$ and then raise that reciprocal to the same power but with the opposite sign:\n\n$$\n{5}^{-2}={(\\frac{1}{5})}^{2}=\\frac{1}{5}\\times \\frac{1}{5}=\\frac{1}{25}\n$$"}] [{:db/id #edb/ref 17592186485522 :knowledge-point/_questions [{:db/id #edb/ref 17592186101012 :knowledge-point/id #uuid "291f5ac8-b454-5a90-aa93-855c503b53fb" :knowledge-point/title "Expressions With Fractional Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3015b7a6-c0f9-518d-80e1-3ad4073920c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{1}{3})}^{5}" :db/id #edb/ref 17592186484916} {:answer/id #uuid "37359fec-b9c5-5e56-a08a-2dd6874bec52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{7/2}" :db/id #edb/ref 17592186484935} {:answer/id #uuid "8f16abf5-43d8-5585-b9e0-8edabab42d82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{5}" :db/id #edb/ref 17592186485127} {:answer/id #uuid "9d35e1ca-c8e4-55e2-bfb7-c257c1dc0f72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\fr