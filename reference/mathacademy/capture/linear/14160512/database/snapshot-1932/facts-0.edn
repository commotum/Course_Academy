c-8def-9c843cfe5c68" #edb/ref 17592186045417] [17592186100236 #edb/ref 1080 "(\\frac{1}{4})^{10}" #edb/ref 17592186045417] [17592186100236 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186100236 #edb/ref 1083 #uuid "150d7842-67b2-510a-a884-d1b934fd52bc" #edb/ref 17592186045417] [17592186100237 #edb/ref 1080 "(\\frac{1}{2})^{7}" #edb/ref 17592186045417] [17592186100237 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186100237 #edb/ref 1083 #uuid "38e06114-181f-52a4-a93c-b5eeb4cdf3e9" #edb/ref 17592186045417] [17592186100238 #edb/ref 1080 "(\\frac{1}{2})^{10}" #edb/ref 17592186045417] [17592186100238 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186100238 #edb/ref 1083 #uuid "4cc6ce99-a186-507b-9a58-d114c7d9b7a5" #edb/ref 17592186045417] [17592186100600 #edb/ref 1069 "e-13042" #edb/ref 17592186045417] [17592186100600 #edb/ref 1071 "Express $\\dfrac{(-5)^{7}}{(-5)^3}$ as a base raised to a single exponent." #edb/ref 17592186045417] [17592186100600 #edb/ref 1072 #uuid "20a3ff12-b7fa-590f-a32e-c2b922324a3d" #edb/ref 17592186045417] [17592186100600 #edb/ref 1074 "First, we write the fraction as a division:\n\n$$\n\\dfrac{(-5)^{7}}{(-5)^3} = (-5)^{7} \\div (-5)^3\n$$\n\nNow, to divide powers of the same base, we simply subtract the exponents:\n\n$$\n(-5)^{7} \\div (-5)^3 = (-5)^{7-3} = (-5)^{4}\n$$" #edb/ref 17592186045417] [17592186100601 #edb/ref 1069 "e-13043" #edb/ref 17592186045417] [17592186100601 #edb/ref 1071 "Express $\\left(\\dfrac{1}{2}\\right)^4 \\div \\left(\\dfrac{1}{2}\\right)^2$ as a base raised to a single exponent." #edb/ref 17592186045417] [17592186100601 #edb/ref 1072 #uuid "482947e3-a48c-5196-b46c-29aa03ddb57e" #edb/ref 17592186045417] [17592186100601 #edb/ref 1074 "To divide powers of the same base, we simply subtract the exponents:\n\n$$\n\\left(\\dfrac{1}{2}\\right)^4 \\div \\left(\\dfrac{1}{2}\\right)^2 = \\left(\\dfrac{1}{2}\\right)^{4-2}= \\left(\\dfrac{1}{2}\\right)^{2}\n$$" #edb/ref 17592186045417] [17592186100602 #edb/ref 1069 "e-13044" #edb/ref 17592186045417] [17592186100602 #edb/ref 1071 "Express $\\dfrac{0.2^5}{0.2^2}$ as a base raised to a single exponent." #edb/ref 17592186045417] [17592186100602 #edb/ref 1072 #uuid "3c2c32f1-4e6d-5363-9145-5834c59e7fd9" #edb/ref 17592186045417] [17592186100602 #edb/ref 1074 "First, we write the fraction as a division:\n\n$$\n\\dfrac{0.2^5}{0.2^2} = 0.2^5 \\div 0.2^2\n$$\n\nNow, to divide powers of the same base, we simply subtract the exponents:\n\n$$\n0.2^{5} \\div 0.2^{2} = 0.2^{5 - 2} = 0.2^{3}\n$$" #edb/ref 17592186045417] [17592186100603 #edb/ref 1069 "e-13046" #edb/ref 17592186045417] [17592186100603 #edb/ref 1071 "Simplify $\\dfrac{2^3}{2^5}$." #edb/ref 17592186045417] [17592186100603 #edb/ref 1072 #uuid "b3008b70-810e-54b3-8e0b-b09dab969587" #edb/ref 17592186045417] [17592186100603 #edb/ref 1074 "To divide powers of the same base, we subtract the exponents:\n\n$$\n\\dfrac{2^3}{2^5} = 2^{3-5} = 2^{-2}\n$$\n\nTo evaluate $2^{-2}$, we find the reciprocal of the base $(2)$ and then raise that reciprocal to the same power but with the opposite sign:\n\n$$\n2^{-2} = \\left(\\dfrac{1}{2}\\right)^2 =\\dfrac{1}{2} \\times \\dfrac{1}{2} = \\dfrac{1}{4}\n$$" #edb/ref 17592186045417] [17592186101011 #edb/ref 1037 #edb/ref 17592186049626 #edb/ref 17592186045417] [17592186101011 #edb/ref 1037 #edb/ref 17592186049714 #edb/ref 17592186045417] [17592186101011 #edb/ref 1038 #edb/ref 17592186101510 #edb/ref 17592186045417] [17592186101011 #edb/ref 1038 #edb/ref 17592186101511 #edb/ref 17592186045417] [17592186101011 #edb/ref 1039 "Expressions With Integer Bases" #edb/ref 17592186045417] [17592186101011 #edb/ref 1041 #edb/ref 17592186100600 #edb/ref 17592186045417] [17592186101011 #edb/ref 1042 #uuid "133c88b2-3a8e-5364-9f1c-548da0a1d446" #edb/ref 17592186045417] [17592186101012 #edb/ref 1037 #edb/ref 17592186048911 #edb/ref 17592186045417] [17592186101012 #edb/ref 1038 #edb/ref 17592186101512 #edb/ref 1759218