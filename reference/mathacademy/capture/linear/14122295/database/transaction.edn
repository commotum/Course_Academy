[[:db/retract 17592186159960 :answer-field/choices 17592186159961] [:db/retract 17592186159960 :answer-field/choices 17592186159962] {:db/id 17592186161918 :knowledge-point/questions ["question-3ba4131d-53a4-5793-b374-0ddb7648dbe7" "question-8eb0e9a4-7a3a-5999-9897-bbedb74b2220"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186162463 :question/problem "Select the correct options in the reasoning below.\n\nThe notation $3∤8$ means {{field-1}}. It is equivalent to the statement that {{field-2}}{{field-3}} $k,$ we have {{field-4}}." :question/worked-solution "The notation $a∤b$ means $a$ does not divides $b.$ So, $3∤8$ means $3\\text{ doesn't divide }8.$\n\nAccording to the definition of integer divisibility, the fact that $a$ does not divide $b$ means that for any integer $k,$ we have that \n\n$$\nb\\ne ak.\n$$\n\n \n\nTherefore, $3∤8$ is equivalent to the statement that $\\text{for any}$ $\\text{integer}$ $k,$ we have $8\\ne 3k.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186159963 :answer-field/correct 17592186159967 :db/ensure [:answer-field/validate]} {:db/id 17592186159971 :answer-field/correct 17592186159972 :db/ensure [:answer-field/validate]} {:db/id 17592186159968 :answer-field/correct 17592186159970 :db/ensure [:answer-field/validate]} {:db/id 17592186159960 :answer-field/correct "answer-fffbac0e-c4c6-5d59-944a-159706b6a50e" :answer-field/choices ["answer-9f5ffca2-7ea1-5e32-a6c7-f75863c241c4" "answer-fffbac0e-c4c6-5d59-944a-159706b6a50e"] :db/ensure [:answer-field/validate]} {:db/id "answer-9f5ffca2-7ea1-5e32-a6c7-f75863c241c4" :answer/id #uuid "9f5ffca2-7ea1-5e32-a6c7-f75863c241c4" :answer/type :answer.type/math :answer/value "3\\ne 8k" :db/ensure [:answer/validate]} {:db/id "answer-fffbac0e-c4c6-5d59-944a-159706b6a50e" :answer/id #uuid "fffbac0e-c4c6-5d59-944a-159706b6a50e" :answer/type :answer.type/math :answer/value "8\\ne 3k" :db/ensure [:answer/validate]} {:db/id "question-3ba4131d-53a4-5793-b374-0ddb7648dbe7" :question/id #uuid "3ba4131d-53a4-5793-b374-0ddb7648dbe7" :question/math-academy-id "q-221919" :question/problem "Select the correct options in the reasoning below.\n\nThe notation $4∤7$ means {{field-1}}. It is equivalent to the statement that {{field-2}}{{field-3}} $k,$ we have {{field-4}}." :question/worked-solution "The notation $a∤b$ means $a$ does not divides $b.$ So, $4∤7$ means $4\\text{ doesn't divide }7.$\n\nAccording to the definition of integer divisibility, the fact that $a$ does not divide $b$ means that for any integer $k,$ we have that \n\n$$\nb\\ne ak.\n$$\n\n \n\nTherefore, $4∤7$ is equivalent to the statement that $\\text{for any}$ $\\text{integer}$ $k,$ we have $7\\ne 4k.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-50931817-e6d2-526a-9d19-3fd348a17b6f" "answer-field-3bb66747-f402-55c7-97a0-078351c09cf9" "answer-field-a9fbadd7-ea82-5ee9-999c-5f7ce1dbfacd" "answer-field-470166d0-f0ae-54b0-8849-4316112da7cd"] :db/ensure [:question/validate]} {:db/id "answer-field-50931817-e6d2-526a-9d19-3fd348a17b6f" :answer-field/id #uuid "50931817-e6d2-526a-9d19-3fd348a17b6f" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-f53b5a69-5003-5e86-812b-c9cc0087e241" :answer-field/choices ["answer-cad3fed6-e275-52c7-b695-5dc05fc49fe1" "answer-f53b5a69-5003-5e86-812b-c9cc0087e241" "answer-74adfba4-a612-51c0-b39d-230fa366846e" "answer-0e80c981-b97a-5513-91b8-2faa41d87131"] :db/ensure [:answer-field/validate]} {:db/id "answer-cad3fed6-e275-52c7-b695-5dc05fc49fe1" :answer/id #uuid "cad3fed6-e275-52c7-b695-5dc05fc49fe1" :answer/type :answer.type/text :answer/value "$4$ divides $7$" :db/ensure [:answer/validate]} {:db/id "answer-f53b5a69-5003-5e86-812b-c9cc0087e241" :answer/id #uuid "f53b5a69-5003-5e86-812b-c9cc0087e241" :answer/type :answer.type/text :answer/value "$4$ doesn't divide $7$" :db/ensure [:answer/validate]} {:db/id "answer-74adfba4-a612-51c0-b39d-230