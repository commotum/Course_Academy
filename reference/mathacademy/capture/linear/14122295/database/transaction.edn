answer/validate]} {:db/id "answer-field-86c1c1a6-4f28-5638-98a4-e9f66e6b2f5b" :answer-field/id #uuid "86c1c1a6-4f28-5638-98a4-e9f66e6b2f5b" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "answer-ceb705f8-2cf2-5cd5-8909-e0963c4dd06c" :answer-field/choices ["answer-ceb705f8-2cf2-5cd5-8909-e0963c4dd06c" "answer-be5ef2c7-2272-5e37-bcf6-3b2933a58f72"] :db/ensure [:answer-field/validate]} {:db/id "answer-ceb705f8-2cf2-5cd5-8909-e0963c4dd06c" :answer/id #uuid "ceb705f8-2cf2-5cd5-8909-e0963c4dd06c" :answer/type :answer.type/text :answer/value "integer" :db/ensure [:answer/validate]} {:db/id "answer-be5ef2c7-2272-5e37-bcf6-3b2933a58f72" :answer/id #uuid "be5ef2c7-2272-5e37-bcf6-3b2933a58f72" :answer/type :answer.type/text :answer/value "number" :db/ensure [:answer/validate]} {:db/id "answer-field-4f369213-a908-5088-8d6a-24a0cf25566a" :answer-field/id #uuid "4f369213-a908-5088-8d6a-24a0cf25566a" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/correct "answer-0ee48430-dc13-56f9-afff-d440154c4f60" :answer-field/choices ["answer-7b471fe6-1334-5113-82e7-d375b39128c4" "answer-0ee48430-dc13-56f9-afff-d440154c4f60"] :db/ensure [:answer-field/validate]} {:db/id "answer-7b471fe6-1334-5113-82e7-d375b39128c4" :answer/id #uuid "7b471fe6-1334-5113-82e7-d375b39128c4" :answer/type :answer.type/math :answer/value "5\\ne 6k" :db/ensure [:answer/validate]} {:db/id "answer-0ee48430-dc13-56f9-afff-d440154c4f60" :answer/id #uuid "0ee48430-dc13-56f9-afff-d440154c4f60" :answer/type :answer.type/math :answer/value "6\\ne 5k" :db/ensure [:answer/validate]} {:db/id 17592186161919 :knowledge-point/questions ["question-48fbd1ea-16f2-572a-98a1-c1983af51b24" "question-63936aa1-e722-5014-a82a-6fe76f4b851d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-48fbd1ea-16f2-572a-98a1-c1983af51b24" :question/id #uuid "48fbd1ea-16f2-572a-98a1-c1983af51b24" :question/math-academy-id "q-221923" :question/problem "Which of the following statements must be true for any integers $x$ and $y?$\n\n- $3∣(14x+21y)$\n- $7∣(14x+21y)$\n- $4∣(14x+21y)$" :question/worked-solution "The notation $a∣b$ means $a$ divides $b.$\n\nAccording to the definition of integer divisibility, the fact that $a$ divides $b$ means that there exists an integer $k$ such that \n\n$$\nb=ak.\n$$\n\n \n\nWith that in mind, let's examine our statement in turn.\n\n- Statement I is false. For example, if $x=1$ and $y=0,$ we have $14(1)+21(0)=14,$ which is not divisible by $3.$\n\n- Statement II is true. Notice that \n\n$$\n14x+21y=7(2x+3y).\n$$\n\nSince $x$ and $y$ are integers, $2x+3y$ must be an integer, too. So, $7∣(14x+21y).$\n\n- Statement III is false. For example, if $x=1$ and $y=0,$ we have $14(1)+21(0)=14,$ which is not divisible by $4.$\n\nTherefore, the correct answer is \"II only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-96a743b7-fda2-51fe-bfdd-1a87d90bbfe6"] :db/ensure [:question/validate]} {:db/id "answer-field-96a743b7-fda2-51fe-bfdd-1a87d90bbfe6" :answer-field/id #uuid "96a743b7-fda2-51fe-bfdd-1a87d90bbfe6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e34f1333-ff13-539f-98a3-6487bacbdcd1" :answer-field/choices ["answer-afaa078f-f8ba-5d53-96fa-429e2e0695f6" "answer-60887104-df4a-53c7-a034-7138745e6c35" "answer-75e38757-7df1-5cf4-b8a8-25b31d2f0338" "answer-e34f1333-ff13-539f-98a3-6487bacbdcd1" "answer-17d5b6db-f2d7-57e8-a2a5-1d92b46e0512"] :db/ensure [:answer-field/validate]} {:db/id "answer-afaa078f-f8ba-5d53-96fa-429e2e0695f6" :answer/id #uuid "afaa078f-f8ba-5d53-96fa-429e2e0695f6" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-60887104-df4a-53c7-a034-7138745e6c35" :answer/id #uuid "60887104-df4a-53c7-a034-7138745e6c35" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-75e38757-7df1-5cf4-b8a8-25b31d2f0338" :answer/id #uuid "75e38757-7df1-5cf4-b8a8-25b31d2f0338" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-e34f1333-ff13-539f-98a3-6487bacbdcd1" :answer/id #uuid "e34f1333-ff13-539f-98a3-6487bacbdcd1" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-17d5b6db-f2d7-57e8-a2a5-1d92b46e0512" :answer/id #uuid "17d5b6db-f2d7-57e8-a2a5-1d92b46e0512" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-63936aa1-e722-5014-a82a-6fe76f4b851d" :question/id #uuid "63936aa1-e722-5014-a82a-6fe76f4b851d" :question/math-academy-id "q-221929" :question/problem "Which of the following statements must be true for any integers $x$ and $y?$\n\n- $2$ divides $(6x-18y)$\n- $3$ divides $(6x-18y)$\n- $5$ divides $(6x-18y)$" :question/worked-solution "The notation $a∣b$ means $a$ divides $b.$\n\nAccording to the definition of integer divisibility, the fact that $a$ divides $b$ means that there exists an integer $k$ such that \n\n$$\nb=ak.\n$$\n\n \nWith that in mind, let's examine our statement in turn.\n\n- Statement I is true. Notice that \n\n$$\n6x-18y=2(3x-9y).\n$$\n\nSince $x$ and $y$ are integers, $3x-9y$ must be an integer, too. So, $2$ divides $(6x-18y).$\n\n- Statement II is true. Notice that \n\n$$\n6x-18y=3(2x-6y).\n$$\n\nSince $x$ and $y$ are integers, $2x-6y$ must be an integer, too. So, $3$ divides $(6x-18y).$\n\n- Statement III is false. For example, if $x=2$ and $y=1,$ we have $6(2)-18(1)=-6,$ which is not divisible by $5.$\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-39c81008-53e2-57d5-9021-9e6bc5fda77a"] :db/ensure [:question/validate]} {:db/id "answer-field-39c81008-53e2-57d5-9021-9e6bc5fda77a" :answer-field/id #uuid "39c81008-53e2-57d5-9021-9e6bc5fda77a" :answer-field/key "selection" :answer-field/type 