id "a9fbadd7-ea82-5ee9-999c-5f7ce1dbfacd" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186420067}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3ba4131d-53a4-5793-b374-0ddb7648dbe7" :question/math-academy-id "q-221919" :question/problem "Select the correct options in the reasoning below.\n\nThe notation $4∤7$ means {{field-1}}. It is equivalent to the statement that {{field-2}}{{field-3}} $k,$ we have {{field-4}}." :question/worked-solution "The notation $a∤b$ means $a$ does not divides $b.$ So, $4∤7$ means $4\\text{ doesn't divide }7.$\n\nAccording to the definition of integer divisibility, the fact that $a$ does not divide $b$ means that for any integer $k,$ we have that \n\n$$\nb\\ne ak.\n$$\n\n \n\nTherefore, $4∤7$ is equivalent to the statement that $\\text{for any}$ $\\text{integer}$ $k,$ we have $7\\ne 4k.$"} :step/id #uuid "6200d2fa-ec68-5795-8705-de7c6137e85c" :step/next {:db/id #edb/ref 17592186420077}} {:db/id #edb/ref 17592186420076 :step/content {:db/id #edb/ref 17592186162463 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f5ffca2-7ea1-5e32-a6c7-f75863c241c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\ne 8k" :db/id #edb/ref 17592186420045} {:answer/id #uuid "fffbac0e-c4c6-5d59-944a-159706b6a50e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\ne 3k" :db/id #edb/ref 17592186420059}] :answer-field/correct {:db/id #edb/ref 17592186420059} :answer-field/id #uuid "c605a0bc-e647-59f3-953d-f7439bb8bf37" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186159960} {:answer-field/choices [{:answer/id #uuid "e00d2eb6-95ea-5fc9-8c9a-3179c8cfd2dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8$ divides $3$" :db/id #edb/ref 17592186159964} {:answer/id #uuid "171bd694-28ac-5dc9-bc5a-8b8e4d0ba7dd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ divides $8$" :db/id #edb/ref 17592186159965} {:answer/id #uuid "269a593b-0687-5d62-8338-2585e94e9e85" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8$ doesn't divide $3$" :db/id #edb/ref 17592186159966} {:answer/id #uuid "44986bd1-e934-5ed1-9606-e78a8c316f39" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ doesn't divide $8$" :db/id #edb/ref 17592186159967}] :answer-field/correct {:db/id #edb/ref 17592186159967} :answer-field/id #uuid "5ea61ba7-a4ed-5454-a5f1-9bc4f77ac2de" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186159963} {:answer-field/choices [{:answer/id #uuid "090120d0-2fe4-5827-bbc7-7d76287a64b7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "number" :db/id #edb/ref 17592186159969} {:answer/id #uuid "3ba91192-aac7-5f98-bf34-e31d90e49d87" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "integer" :db/id #edb/ref 17592186159970}] :answer-field/correct {:db/id #edb/ref 17592186159970} :answer-field/id #uuid "8f41b4b8-864f-5883-b066-0f91d4ff0fa8" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186159968} {:answer-field/choices [{:answer/id #uuid "274ab90d-34ba-5ca3-a3fc-aab97e5814ae" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "for any" :db/id #edb/ref 17592186159972} {:answer/id #uuid "66c7bd7b-b307-5ada-88e9-b2813c416464" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "for some" :db/id #edb/ref 17592186159973}] :answer-field/correct {:db/id #edb/ref 17592186159972} :answer-field/id #uuid "709e62d0-c9de-55b6-968c-0f823f82609d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186159971}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "116c50e1-51bc-58dd-a9dc-8ed9be12bea8" :question/math-academy-id "q-221873" :question/problem "Select the correct options in the reasoning below.\n\nThe notation $3∤8$ means {{field-1}}. It is equivalent to the statement that {{field-2}}{{field-3}} $k,$ we have {{field-4}}." :question/worked-solution "The notation $a∤b$ means $a$ does not divides $b.$ So, $3∤8$ means $3\\text{ doesn't divide }8.$\n\nAccording to the definition of integer divisibility, the fact that $a$ does not divide $b$ means that for any integer $k,$ we have that \n\n$$\nb\\ne ak.\n$$\n\n \n\nTherefore, $3∤8$ is equivalent to the statement that $\\text{for any}$ $\\text{integer}$ $k,$ we have $8\\ne 3k.$"} :step/id #uuid "8f90a01d-2bf3-5e73-ae54-8cf83cc03dfb" :step/next {:db/id #edb/ref 17592186420075}} {:db/id #edb/ref 17592186420077 :step/content {:db/id #edb/ref 17592186420073 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ee48430-dc13-56f9-afff-d440154c4f60" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\ne 5k" :db/id #edb/ref 17592186420030} {:answer/id #uuid "7b471fe6-1334-5113-82e7-d375b39128c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\ne 6k" :db/id #edb/ref 17592186420039}] :answer-field/correct {:db/id #edb/ref 17592186420030} :answer-field/id #uuid "4f369213-a908-5088-8d6a-24a0cf25566a" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186420063} {:answer-field/choices [{:answer/id #uuid "be5ef2c7-2272-5e37-bcf6-3b2933a58f72" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "number" :db/id #edb/ref 17592186420050} {:answer/id #uuid "ceb705f8-2cf2-5cd5-8909-e0963c4dd06c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "integer" :db/id #edb/ref 17592186420053}] :answer-field/correct {:db/id #edb/ref 17592186420053} :answer-field/id #uuid "86c1c1a6-4f28-5638-98a4-e9f66e6b2f5b" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186420065} {:answer-field/choices [{:answer/id #uuid "28361710-34ba-59ce-b434-53dba37859c0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$6$ doesn't divide $5$" :db/id #edb/ref 17592186420033} {:answer/id #uuid "a27129dd-f79a-512a-8a07-7522fd386960" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$6$ divides $5$" :db/id #edb/ref 17592186420047} {:answer/id #uuid "db02e2cd-0674-54ac-9026-4691883716de" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5$ divides $6$" :db/id #edb/ref 17592186420055} {:answer/id #uuid "f42f46a3-3d86-5883-8166-5a8c5660c5bf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5$ doesn't divide $6$" :db/id #edb/ref 17592186420057}] :answer-field/correct {:db/id #edb/ref 17592186420057} :answer-field/id #uuid "f06f4411-1ba0-55d0-b599-72a83087bfcd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186420068} {:answer-field/choices [{:answer/id #uuid "2faf54bf-f0f4-5f6a-ba0d-fb8c4f36a6dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "for any" :db/id #edb/ref 17592186420034} {:answer/id #uuid "b39b7cd8-90e9-51e8-b9f4-44a803b1ea54" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "for some" :db/id #edb/ref 17592186420049}] :answer-field/correct {:db/id #edb/ref 17592186420034} :answer-field/id #uuid "f07d0427-ca84-53ef-b241-840f24e28d37" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186420069}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8eb0e9a4-7a3a-5999-9897-bbedb74b2220" :question/math-academy-id "q-221920" :question/problem "Select the correct options in the reasoning below.\n\nThe notation $5∤6$ means {{field-1}}. It is equivalent to the statement that {{field-2}}{{field-3}} $k,$ we have {{field-4}}." :question/worked-solution "The notation $a∤b$ means $a$ does not divides $b.$ So, $5∤6$ means $5\\text{ doesn't divide }6.$\n\nAccording to the definition of integer divisibility, the fact that $a$ does not divide $b$ means that for any integer $k,$ we have that \n\n$$\nb\\ne ak.\n$$\n\n \n\nTherefore, $5∤6$ is equivalent to the statement that $\\text{for any}$ $\\text{integer}$ $k,$ we have $6\\ne 5k.$"} :step/id #uuid "9fa38660-d8a3-5241-9915-730f9151df80" :step/next {:db/id #edb/ref 17592186420074}} {:db/id #edb/ref 17592186420078 :step/content {:db/id #edb/ref 17592186420072 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1da65dc0-01b4-5b68-9fb5-2b24392ab3e7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186420032} {:answer/id #uuid "7d0c5418-7d81-5d69-80db-f47bba1fe715" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186420040} {:answer/id #uuid "81fb3c0b-8063-5f9d-b742-0b572de22bc0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186420042} {:answer/id #uuid "8e5ebb79-57bf-59e0-84ab-0b8b6661babd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186420044} {:answer/id #uuid "cfef5e04-f733-5d5c-8a6b-71ad9b16f171" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186420054}] :answer-field/correct {:db/id #edb/ref 17592186420054} :answer-field/id #uuid "39c81008-53e2-57d5-9021-9e6bc5fda77a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186420060}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "63936aa1-e722-5014-a82a-6fe76f4b851d" :question/math-academy-id "q-221929" :question/problem "Which of the following statements must be true for any integers $x$ and $y?$\n\n- $2$ divides $(6x-18y)$\n- $3$ divides $(6x-18y)$\n- $5$ divides $(6x-18y)$" :question/worked-solution "The notation $a∣b$ means $a$ divides $b.$\n\nAccording to the definition of integer divisibility, the fact that $a$ divides $b$ means that there exists an integer $k$ such that \n\n$$\nb=ak.\n$$\n\n \nWith that in mind, let's examine our statement in turn.\n\n- Statement I is true. Notice that \n\n$$\n6x-18y=2(3x-9y).\n$$\n\nSince $x$ and $y$ are integers, $3x-9y$ must be an integer, too. So, $2$ divides $(6x-18y).$\n\n- Statement II is true. Notice that \n\n$$\n6x-18y=3(2x-6y).\n$$\n\nSince $x$ and $y$ are integers, $2x-6y$ must be an integer, too. So, $3$ divides $(6x-18y).$\n\n- Statement III is false. For example, if $x=2$ and $y=1,$ we have $6(2)-18(1)=-6,$ which is not divisible by $5.$\n\nTherefore, the correct answer is \"I and II only.\""} :step/id #uuid "d7173f03-42ea-5a77-a52b-599bcf37ac02"}] :activity/title "Integer Divisibility" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186420027}]}
