#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186162734} :activity/id #uuid "9610f5eb-4c2a-5356-ab60-5e12da9a7560" :activity/scope {:db/id #edb/ref 17592186048604 :topic/id #uuid "ade9d1d5-3224-5403-9c8b-f3e5be0db3c5" :topic/math-academy-id 3080} :activity/steps [{:db/id #edb/ref 17592186162734 :step/content {:db/id #edb/ref 17592186163367 :tutorial/content "Suppose $a$ and $b$ are integers where $a\\neq 0.$ We say that $\\boldsymbol a$ **divides** $\\boldsymbol b$ and write \n\n$$\na\\mid b\n$$\n\nif there exists an integer $k$ such that\n\n$$\nb = ka.\n$$\n\nWe can write this more formally as follows:\n\n$$\na\\mid b \\qquad \\Leftrightarrow\\qquad \\exists k \\in \\mathbb Z, b = ka\n$$\n\nFor example, $2\\mid 8$ because there exists an integer ${\\color{blue}{k}} = {\\color{blue}{4}}$ such that\n\n$$\n8 = {\\color{blue}{4}}\\cdot 2.\n$$" :tutorial/id #uuid "100e1a89-de92-5d1a-86ba-bcd72190ae6d" :tutorial/math-academy-id 9351 :tutorial/title "Introduction"} :step/id #uuid "b0fa360f-9e02-5a70-b17f-90340c91003c" :step/math-academy-id 162161 :step/next {:db/id #edb/ref 17592186162735}} {:db/id #edb/ref 17592186162735 :step/content {:db/id #edb/ref 17592186161917 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161720 :question/id #uuid "ada57336-8fdb-584d-b03c-7b7e31cbf55a" :question/math-academy-id "e-14981"} :knowledge-point/id #uuid "d0e960a4-872c-55c0-8439-60426671f5cf" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050878}] :knowledge-point/questions [{:db/id #edb/ref 17592186162465} {:db/id #edb/ref 17592186162466} {:db/id #edb/ref 17592186407494} {:db/id #edb/ref 17592186407502} {:db/id #edb/ref 17592186407503} {:db/id #edb/ref 17592186407504}] :knowledge-point/title "Stating the Definition of Integer Divisibility"} :step/id #uuid "3902c14b-dd71-5c37-bd20-4fb2177d36a2" :step/math-academy-id 162162 :step/next {:db/id #edb/ref 17592186162738}} {:db/id #edb/ref 17592186162736 :step/content {:db/id #edb/ref 17592186161918 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161721 :question/id #uuid "1df938d2-db9c-5335-9f54-e44c40659992" :question/math-academy-id "e-14982"} :knowledge-point/id #uuid "05d3b242-3ecd-54d6-a763-925e2baada2c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049552}] :knowledge-point/questions [{:db/id #edb/ref 17592186162463} {:db/id #edb/ref 17592186162467} {:db/id #edb/ref 17592186407493} {:db/id #edb/ref 17592186407495} {:db/id #edb/ref 17592186407496} {:db/id #edb/ref 17592186407497} {:db/id #edb/ref 17592186407501} {:db/id #edb/ref 17592186420070} {:db/id #edb/ref 17592186420073}] :knowledge-point/title "Stating the Definition of Non-Divisibility"} :step/id #uuid "3ae5e0bc-75a2-5dd9-b814-d4bdb58d123f" :step/math-academy-id 162166 :step/next {:db/id #edb/ref 17592186162737}} {:db/id #edb/ref 17592186162737 :step/content {:db/id #edb/ref 17592186161919 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161722 :question/id #uuid "2b06423e-99a9-5ac2-a413-93aa71ac4fbe" :question/math-academy-id "e-14983"} :knowledge-point/id #uuid "559e653a-2ab9-54a8-84e3-02bf106a8f47" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051079}] :knowledge-point/questions [{:db/id #edb/ref 17592186162464} {:db/id #edb/ref 17592186162468} {:db/id #edb/ref 17592186407498} {:db/id #edb/ref 17592186407499} {:db/id #edb/ref 17592186407500} {:db/id #edb/ref 17592186407505} {:db/id #edb/ref 17592186420071} {:db/id #edb/ref 17592186420072}] :knowledge-point/title "Inferring Divisibility in Algebraic Expressions"} :step/id #uuid "d795623f-e963-5223-922d-0146dbda23bb" :step/math-academy-id 162169} {:db/id #edb/ref 17592186162738 :step/content {:db/id #edb/ref 17592186163368 :tutorial/content "We have the following definition of integer divisibility. \n\n$$\na\\mid b \\qquad \\Leftrightarrow\\qquad \\exists k \\in \\mathbb Z, b = ka\n$$\n\nIf $a$ **does not divide** $b,$ we write $a\\not\\mid b.$ Therefore, by negating the two statements above, we get the following equivalence:\n\n$$\n\\begin{aligned}¬(a∣b)\\, & ⇔\\,¬(∃k\\in Z,b=ka) \\\\ a∤b\\, & ⇔\\,∀k\\in Z,b\\ne ka\\end{aligned}\n$$\n\nThus, $a\\not\\mid b$ means that $b \\neq ak$ *for all* integers $k.$\n\nFor example, $3\\not \\mid 8$ because there does not exist an integer ${\\color{red}{k_2}}$ such that\n\n$$\n8 = {\\color{red}{k_2}}\\cdot 3.\n$$" :tutorial/id #uuid "1a06989c-367e-5d20-840c-e5ab34c82911" :tutorial/math-academy-id 9355 :tutorial/title "Non-Divisibility"} :step/id #uuid "7cc84b4a-0d80-572a-b21b-ca0aa54f80ff" :step/math-academy-id 162181 :step/next {:db/id #edb/ref 17592186162736}}] :activity/title "Integer Divisibility" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186162207}] [{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186420076} :activity/id #uuid "3f8a0c05-783a-5bb8-ba35-0cfc1728bfdc" :activity/scope {:db/id #edb/ref 17592186048604 :topic/id #uuid "ade9d1d5-3224-5403-9c8b-f3e5be0db3c5" :topic/math-academy-id 3080} :activity/steps [{:db/id #edb/ref 17592186420074 :step/content {:db/id #edb/ref 17592186420071 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17d5b6db-f2d7-57e8-a2a5-1d92b46e0512" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186420031} {:answer/id #uuid "60887104-df4a-53c7-a034-7138745e6c35" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186420036} {:answer/id #uuid "75e38757-7df1-5cf4-b8a8-25b31d2f0338" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186420038} {:answer/id #uuid "afaa078f-f8ba-5d53-96fa-429e2e0695f6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186420048} {:answer/id #uuid "e34f1333-ff13-539f-98a3-6487bacbdcd1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186420056}] :answer-field/correct {:db/id #edb/ref 17592186420056} :answer-field/id #uuid "96a743b7-fda2-51fe-bfdd-1a87d90bbfe6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186420066}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "48fbd1ea-16f2-572a-98a1-c1983af51b24" :question/math-academy-id "q-221923" :question/problem "Which of the following statements must be true for any integers $x$ and $y?$\n\n- $3∣(14x+21y)$\n- $7∣(14x+21y)$\n- $4∣(14x+21y)$" :question/worked-solution "The notation $a∣b$ means $a$ divides $b.$\n\nAccording to the definition of integer divisibility, the fact that $a$ divides $b$ means that there exists an integer $k$ such that \n\n$$\nb=ak.\n$$\n\n \n\nWith that in mind, let's examine our statement in turn.\n\n- Statement I is false. For example, if $x=1$ and $y=0,$ we have $14(1)+21(0)=14,$ which is not divisible by $3.$\n\n- Statement II is true. Notice that \n\n$$\n14x+21y=7(2x+3y).\n$$\n\nSince $x$ and $y$ are integers, $2x+3y$ must be an integer, too. So, $7∣(14x+21y).$\n\n- Statement III is false. For example, if $x=1$ and $y=0,$ we have $14(1)+21(0)=14,$ which is not divisible by $4.$\n\nTherefore, the correct answer is \"II only.\""} :step/id #uuid "56eb53ba-c780-5a71-a330-07b5e88ca9a3" :step/next {:db/id #edb/ref 17592186420078}} {:db/id #edb/ref 17592186420075 :step/content {:db/id #edb/ref 17592186420070 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c6cecab-b539-59d3-83dc-06106b4873ed" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "for any" :db/id #edb/ref 17592186420028} {:answer/id #uuid "89f5d55a-e6d0-59e8-ab4e-9aac90d5e94f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "for some" :db/id #edb/ref 17592186420043}] :answer-field/correct {:db/id #edb/ref 17592186420028} :answer-field/id #uuid "3bb66747-f402-55c7-97a0-078351c09cf9" :answer-field/key "field-2" :answer-fie