/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "116c50e1-51bc-58dd-a9dc-8ed9be12bea8" :question/math-academy-id "q-221873" :question/problem "Select the correct options in the reasoning below.\n\nThe notation $3∤8$ means {{field-1}}. It is equivalent to the statement that {{field-2}}{{field-3}} $k,$ we have {{field-4}}." :question/worked-solution "The notation $a∤b$ means $a$ does not divides $b.$ So, $3∤8$ means $3\\text{ doesn't divide }8.$\n\nAccording to the definition of integer divisibility, the fact that $a$ does not divide $b$ means that for any integer $k,$ we have that \n\n$$\nb\\ne ak.\n$$\n\n \n\nTherefore, $3∤8$ is equivalent to the statement that $\\text{for any}$ $\\text{integer}$ $k,$ we have $8\\ne 3k.$"}] [{:db/id #edb/ref 17592186420070 :knowledge-point/_questions [{:db/id #edb/ref 17592186161918 :knowledge-point/id #uuid "05d3b242-3ecd-54d6-a763-925e2baada2c" :knowledge-point/title "Stating the Definition of Non-Divisibility"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c6cecab-b539-59d3-83dc-06106b4873ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "for any" :db/id #edb/ref 17592186420028} {:answer/id #uuid "89f5d55a-e6d0-59e8-ab4e-9aac90d5e94f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "for some" :db/id #edb/ref 17592186420043}] :answer-field/correct {:answer/id #uuid "0c6cecab-b539-59d3-83dc-06106b4873ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "for any" :db/id #edb/ref 17592186420028} :answer-field/id #uuid "3bb66747-f402-55c7-97a0-078351c09cf9" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186420061} {:answer-field/choices [{:answer/id #uuid "80fd488d-e240-52bb-b757-c25f30185b59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/va