#{[{:activity/first-step {:db/id #edb/ref 17592186120588} :activity/id #uuid "a1420d3a-15f6-5a48-8abd-1c63acae3d69" :activity/scope {:db/id #edb/ref 17592186049407 :topic/id #uuid "f1e03cee-ef99-5d00-a73c-6d65d6b68b14" :topic/math-academy-id 1848} :activity/steps [{:db/id #edb/ref 17592186120584 :step/content {:db/id #edb/ref 17592186119751 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119567 :question/id #uuid "927b97a7-437e-5c46-b83d-1e8d2d62007e" :question/math-academy-id "e-3155"} :knowledge-point/id #uuid "24d0f296-256c-5da4-8992-e2112dfe99b6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048587} {:db/id #edb/ref 17592186050517}] :knowledge-point/questions [{:db/id #edb/ref 17592186120489} {:db/id #edb/ref 17592186120493}] :knowledge-point/title "Representing Angles in the Coordinate Plane With the Unit Circle"} :step/id #uuid "3ccb485c-5163-55c9-925d-e843ae0e9b1e" :step/math-academy-id 10716 :step/next {:db/id #edb/ref 17592186120585}} {:db/id #edb/ref 17592186120585 :step/content {:db/id #edb/ref 17592186119752 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119568 :question/id #uuid "02cd545d-7fde-520b-924e-5ff4f8e4244b" :question/math-academy-id "e-3156"} :knowledge-point/id #uuid "6435eb94-76f8-5e46-b005-03451ab6eba2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050053}] :knowledge-point/questions [{:db/id #edb/ref 17592186120490} {:db/id #edb/ref 17592186120491}] :knowledge-point/title "Representing Angles in Radians in the Coordinate Plane With the Unit Circle"} :step/id #uuid "233228e9-30e5-5f8d-9ef2-3ab6bbe1665a" :step/math-academy-id 10717 :step/next {:db/id #edb/ref 17592186120587}} {:db/id #edb/ref 17592186120586 :step/content {:db/id #edb/ref 17592186119753 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119569 :question/id #uuid "50e22612-2f22-5c48-a2da-a6a0580375a5" :question/math-academy-id "e-3157"} :knowledge-point/id #uuid "50de296d-56a1-5166-aa7d-42de027a33bc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049794} {:db/id #edb/ref 17592186050847}] :knowledge-point/questions [{:db/id #edb/ref 17592186120317} {:db/id #edb/ref 17592186120319} {:db/id #edb/ref 17592186233937} {:db/id #edb/ref 17592186512902}] :knowledge-point/title "Using Trigonometry to Find an Angle in the Coordinate Plane"} :step/id #uuid "ccdf0b34-4b6d-556e-854b-ad4fe1251a2b" :step/math-academy-id 10718} {:db/id #edb/ref 17592186120587 :step/content {:db/id #edb/ref 17592186121003 :tutorial/content "The unit circle turns out to be a really useful tool to help us to understand the trigonometric functions. However, sometimes, we'd like to represent an angle in the coordinate plane without reference to the unit circle.\n\nThankfully, the standard way that we represent angles in the coordinate plane without reference to the unit circle is pretty much the same as with the unit circle!\n\nFor example, the angles $45^\\circ, 135^\\circ, 225^\\circ$, and $315^\\circ$ can be represented in the coordinate plane as follows:\n\n![](images/31/317690d0489b8a5f5cd9e360c9d5894a539908b00ffc50ae0b70bfe03708162b.png)" :tutorial/id #uuid "365c6b7d-1c9d-5476-a76c-1ae37c55c79d" :tutorial/math-academy-id 2410 :tutorial/title "Representing Angles in the Coordinate Plane"} :step/id #uuid "89777c8f-a2e8-5a31-80c5-4f9068dc913b" :step/math-academy-id 10720 :step/next {:db/id #edb/ref 17592186120589}} {:db/id #edb/ref 17592186120588 :step/content {:db/id #edb/ref 17592186121004 :tutorial/content "The **unit circle** is a circle of radius $1$ centered at the origin in the coordinate plane.\n\n![](images/13/138322240b05231ce56ca195a06724da8a1c05ec4701ac1d9d49cadc9129c8c0.png)\n\nThe unit circle is an essential tool for understanding trigonometry.\n\nSuppose that we want to construct an angle $\\theta$ in the coordinate plane. There is a standard way in which we do this.\n\n- First, we draw the unit circle.\n- Then, we represent $\\theta$ as a central angle of the unit circle. The angle has its vertex at the origin, its initial side lies on the positive $x$-axis, and it rotates such that a positive angle is measured counter-clockwise.\n\nFor example, we represent the angles\n\n$$\n\\theta = 45^\\circ, 135^\\circ, 225^\\circ\n$$\n\nand $315^\\circ$ as follows:\n\n![](images/1d/1d4419633933ba2b5874873f625ca9016d42c2dc9a685c9db3619daf8512fde5.png)" :tutorial/id #uuid "e10ff02b-0d3a-58a5-813d-2072db6f706f" :tutorial/math-academy-id 2411 :tutorial/title "Introduction"} :step/id #uuid "7a8a6a1b-9549-51bb-b895-d289b410b7c1" :step/math-academy-id 10728 :step/next {:db/id #edb/ref 17592186120584}} {:db/id #edb/ref 17592186120589 :step/content {:db/id #edb/ref 17592186119754 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119570 :question/id #uuid "98f445f6-806d-5169-81f9-183b93e5bb94" :question/math-academy-id "e-3161"} :knowledge-point/id #uuid "04ac62a3-1302-5011-937b-9fb20cb7fe95" :knowledge-point/questions [{:db/id #edb/ref 17592186120315} {:db/id #edb/ref 17592186120337}] :knowledge-point/title "Representing Angles in the Coordinate Plane"} :step/id #uuid "05ddd3b3-6529-5e19-bcb5-8d016c5bee75" :step/math-academy-id 10750 :step/next {:db/id #edb/ref 17592186120586}}] :activity/title "Angles in the Coordinate Plane" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186120042}]}
