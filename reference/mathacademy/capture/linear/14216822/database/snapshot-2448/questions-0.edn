#{[{:db/id #edb/ref 17592186119567 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119751 :knowledge-point/id #uuid "24d0f296-256c-5da4-8992-e2112dfe99b6" :knowledge-point/title "Representing Angles in the Coordinate Plane With the Unit Circle"}] :question/id #uuid "927b97a7-437e-5c46-b83d-1e8d2d62007e" :question/math-academy-id "e-3155" :question/problem "Construct a unit circle in the coordinate plane with a central angle of $105^\\circ$ in the standard position." :question/worked-solution "Recall that:\n\n- A unit circle has a radius of $1$ and is centered at the origin in the coordinate plane.\n- An angle in the standard position has its initial side on the positive $x$-axis, its vertex at the origin, and it rotates such that a positive angle is measured counter-clockwise.\n\nTherefore, the correct diagram is as follows:\n\n![](images/46/46e41d84cb00ea2a95f3d1c94e75863707fddf78ea7117de1ed415b71e66f2f1.png)"}] [{:db/id #edb/ref 17592186119568 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119752 :knowledge-point/id #uuid "6435eb94-76f8-5e46-b005-03451ab6eba2" :knowledge-point/title "Representing Angles in Radians in the Coordinate Plane With the Unit Circle"}] :question/id #uuid "02cd545d-7fde-520b-924e-5ff4f8e4244b" :question/math-academy-id "e-3156" :question/problem "Construct a unit circle in the coordinate plane with a central angle of $\\dfrac{2\\pi}{5}$ in the standard position." :question/worked-solution "To help us to visualize the angle, we first convert the measure of the angle into degrees.\n\nTo convert the measure of an angle in radians to an equivalent measure in degrees, we multiply the measure in radians by\n\n$$\n\\dfrac{180^\\circ}{\\pi}\n$$\n\nThis gives\n\n$$\n\\left(\\dfrac{2\\pi} 5\\right) \\cdot \\left(\\dfrac {180^\\circ} {\\pi}\\right) = 72^\\circ\n$$\n\nTherefore,\n\n$$\n\\dfrac{2\\pi}{5}\n$$\n\nis equivalent to $72^\\circ$.\n\nThen, we recall that:\n\n- A unit circle has a radius of $1$ and is centered at the origin in the coordinate plane.\n- An angle in the standard position has its initial side on the positive $x$-axis, its vertex at the origin, and it rotates such that a positive angle is measured counter-clockwise.\n\nTherefore, the correct diagram is as follows:\n\n![](images/64/6479f08add76d919644c8eba7df6bb1d273fd1de808d4af58876a6a5da539fcb.png)"}] [{:db/id #edb/ref 17592186119569 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119753 :knowledge-point/id #uuid "50de296d-56a1-5166-aa7d-42de027a33bc" :knowledge-point/title "Using Trigonometry to Find an Angle in the Coordinate Plane"}] :question/id #uuid "50e22612-2f22-5c48-a2da-a6a0580375a5" :question/math-academy-id "e-3157" :question/problem "![](images/f0/f0347081906740a955f8a192baa53c65536b110df9adc6021288c43767c9ac2f.png)\n\nGiven that the point $A$ has coordinates $(\\sqrt 3, 1)$, calculate the angle $\\theta$." :question/worked-solution "First, we can form a triangle by creating a vertical line from $A$ to the $x$-axis.\n\n![](images/3e/3e5ebde9ee4132e0bd64cb2aaf2a3763abc2b0de1a798e87ed4ee652ca360078.png)\n\nUsing the tangent ratio, we have\n\n$$\n\\tan\\theta = \\dfrac{1}{\\sqrt 3} = \\dfrac{\\sqrt 3}{3}\n$$\n\nFinally, using the inverse tangent, we get\n\n$$\n\\theta = \\arctan{\\left(\\dfrac{\\sqrt 3}{3} \\right)} = 30^\\circ\n$$"}] [{:db/id #edb/ref 17592186119570 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119754 :knowledge-point/id #uuid "04ac62a3-1302-5011-937b-9fb20cb7fe95" :knowledge-point/title "Representing Angles in the Coordinate Plane"}] :question/id #uuid "98f445f6-806d-5169-81f9-183b93e5bb94" :question/math-academy-id "e-3161" :question/problem "How is the angle $150^\\circ$ normally represented in the coordinate plane?" :question/worked-solution "First, we recall that:\n\n- An angle in the standard position has its initial side on the positive $x$-axis, and its vertex is at the origin.\n- It rotates such that a positive angle is measured counter-clockwise.\n\nTherefore, the correct diagram is as follows:\n\n![](images/1d/1dcf96192164d9e1845207773d4fe9596ff3fd0d5fa7e83984260004e8bc32aa.png)"}] [{:db/id #edb/ref 17592186120317 :knowledge-point/_questions [{:db/id #edb/ref 17592186119753 :knowledge-point/id #uuid "50de296d-56a1-5166-aa7d-42de027a33bc" :knowledge-point/title "Using Trigonometry to Find an Angle in the Coordinate Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d01636fc-21ec-56cf-b161-11f80455b55d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "55^{∘}" :db/id #edb/ref 17592186118042} {:answer/id #uuid "e0cf1c2f-19c8-5302-8397-ef818ed0d694" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60^{∘}" :db/id #edb/ref 17592186118043} {:answer/id #uuid "e8382340-ef29-5e26-a393-66690e150710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "62^{∘}" :db/id #edb/ref 17592186118044} {:answer/id #uuid "02e58d03-f760-511e-8e54-a6d8a9b43913" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50^{∘}" :db/id #edb/ref 17592186118045} {:answer/id #uuid "12439412-30d6-5809-9095-063d9bc74f53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "65^{∘}" :db/id #edb/ref 17592186118046}] :answer-field/id #uuid "116b0a49-5e8a-5bd3-8573-7f0ffe6f1626" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118041}] :question/id #uuid "6b5c3cfe-f2c4-5a54-b666-7bc318db7b5f" :question/math-academy-id "q-34270" :question/problem "![](images/fb/fb2876d08dc2aa17b42d137b6d1a486447995e7d52edd37846e9c040265dc1bc.png)\n\nGiven that the point $A$ has coordinates $(1, \\sqrt{3})$, calculate the angle $θ$."}] [{:db/id #edb/ref 17592186120337 :knowledge-point/_questions [{:db/id #edb/ref 17592186119754 :knowledge-point/id #uuid "04ac62a3-1302-