#{[{:db/id #edb/ref 17592186119567 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119751 :knowledge-point/id #uuid "24d0f296-256c-5da4-8992-e2112dfe99b6" :knowledge-point/title "Representing Angles in the Coordinate Plane With the Unit Circle"}] :question/id #uuid "927b97a7-437e-5c46-b83d-1e8d2d62007e" :question/math-academy-id "e-3155" :question/problem "Construct a unit circle in the coordinate plane with a central angle of $105^\\circ$ in the standard position." :question/worked-solution "Recall that:\n\n- A unit circle has a radius of $1$ and is centered at the origin in the coordinate plane.\n\n- An angle in the standard position has its initial side on the positive $x$-axis, its vertex at the origin, and it rotates such that a positive angle is measured counter-clockwise.\n\nTherefore, the correct diagram is as follows:\n\n![](images/46/46e41d84cb00ea2a95f3d1c94e75863707fddf78ea7117de1ed415b71e66f2f1.png)"}] [{:db/id #edb/ref 17592186119568 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119752 :knowledge-point/id #uuid "6435eb94-76f8-5e46-b005-03451ab6eba2" :knowledge-point/title "Representing Angles in Radians in the Coordinate Plane With the Unit Circle"}] :question/id #uuid "02cd545d-7fde-520b-924e-5ff4f8e4244b" :question/math-academy-id "e-3156" :question/problem "Construct a unit circle in the coordinate plane with a central angle of $\\dfrac{2\\pi}{5}$ in the standard position." :question/worked-solution "To help us to visualize the angle, we first convert the measure of the angle into degrees. \n\nTo convert the measure of an angle in radians to an equivalent measure in degrees, we multiply the measure in radians by $\\dfrac{180^\\circ}{\\pi}.$ This gives\n\n$$\n\\left(\\dfrac{2\\pi} 5\\right) \\cdot \\left(\\dfrac {180^\\circ} {\\pi}\\right) = \n\t72^\\circ.\n$$\n\nTherefore,  $\\dfrac{2\\pi}{5}$ is equivalent to $72^\\circ.$ \n\nThen, we recall that:\n\n- A unit circle has a radius of $1$ and is centered at the origin in the coordinate plane.\n\n- An angle in the standard position has its initial side on the positive $x$-axis, its vertex at the origin, and it rotates such that a positive angle is measured counter-clockwise.\n\nTherefore, the correct diagram is as follows:\n\n![](images/64/6479f08add76d919644c8eba7df6bb1d273fd1de808d4af58876a6a5da539fcb.png)"}] [{:db/id #edb/ref 17592186119569 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119753 :knowledge-point/id #uuid "50de296d-56a1-5166-aa7d-42de027a33bc" :knowledge-point/title "Using Trigonometry to Find an Angle in the Coordinate Plane"}] :question/id #uuid "50e22612-2f22-5c48-a2da-a6a0580375a5" :question/math-academy-id "e-3157" :question/problem "![](images/f0/f0347081906740a955f8a192baa53c65536b110df9adc6021288c43767c9ac2f.png)\n\nGiven that the point $A$ has coordinates $(\\sqrt 3, 1),$ calculate the angle $\\theta.$" :question/worked-solution "First, we can form a triangle by creating a vertical line from $A$ to the $x$-axis.\n\n![](images/3e/3e5ebde9ee4132e0bd64cb2aaf2a3763abc2b0de1a798e87ed4ee652ca360078.png)\n\nUsing the tangent ratio, we have\n\n$$\n\\tan\\theta = \\dfrac{1}{\\sqrt 3} = \\dfrac{\\sqrt 3}{3}.\n$$\n\nFinally, using the inverse tangent, we get\n\n$$\n\\theta = \\arctan{\\left( \\dfrac{\\sqrt 3}{3} \\right)} = 30^\\circ.\n$$"}] [{:db/id #edb/ref 17592186119570 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119754 :knowledge-point/id #uuid "04ac62a3-1302-5011-937b-9fb20cb7fe95" :knowledge-point/title "Representing Angles in the Coordinate Plane"}] :question/id #uuid "98f445f6-806d-5169-81f9-183b93e5bb94" :question/math-academy-id "e-3161" :question/problem "How is the angle $150^\\circ$ normally represented in the coordinate plane?" :question/worked-solution "First, we recall that:\n\n- An angle in the standard position has its initial side on the positive $x$-axis, and its vertex is at the origin.\n\n- It rotates such that a positive angle is measured counter-clockwise.\n\nTherefore, the correct diagram is as follows:\n\n![](images/1d/1dcf96192164d9e1845207773d4fe9596ff3fd0d5fa7e83984260004e8bc32aa.png)"}] [{:db/id #edb/ref 17592186527127 :knowledge-point/_questions [{:db/id #edb/ref 17592186119752 :knowledge-point/id #uuid "6435eb94-76f8-5e46-b005-03451ab6eba2" :knowledge-point/title "Representing Angles in Radians in the Coordinate Plane With the Unit Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31759e3d-c825-5447-bb62-62dc40ca4e9d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/50/50db86bd273e9e20ae705890103b067a1f664ed912fcb6efe9083db1060625c8.png" :db/id #edb/ref 17592186526599} {:answer/id #uuid "67b29a88-29cb-58f9-8069-b85a03c112ee" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9a/9a4300f10da578d54cda15c5ff69b433c462843671879194bfd79c3754f6cb5b.png" :db/id #edb/ref 17592186526707} {:answer/id #uuid "d63732c6-b997-5b18-9b93-6fe4ec0fd927" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c1/c17f3162b8aae5a7ef077122de5e9eb0c8f2ce5763115940e602b695ad0da85e.png" :db/id #edb/ref 17592186526916} {:answer/id #uuid "e7c8fd91-21e4-51ad-b080-aaae59a800e9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/20/20723072cad71ae40384b63840898d2239c916081995b8101be8a2f9980bb834.png" :db/id #edb/ref 17592186526960} {:answer/id #uuid "f292085d-a5a2-50ac-9e18-2090bc014589" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8f/8f8e5f15260cbff980164f132a380ad539785d77a92ce3be1d1f3f50e7101b5c.png" :db/id #edb/ref 17592186526981}] :answer-field/correct {:answer/id #uuid "31759e3d-c825-5447-bb62-62dc40ca4e9d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/50/50db86bd273e9e20ae705890103b067a1f664ed912fcb6efe9083db1060625c8.png" :db/id #edb/ref 17592186526599} :answer-field/id #uuid "41456bc4-a176-526b-b41f-6dfca212c1d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186527044}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "093fd520-21d8-5c0d-89e8-fac985077f71" :question/math-academy-id "q-123618" :question/problem "Which of the following diagrams shows a unit circle in the coordinate plane with a central angle of $\\frac{13\\pi }{9}$ in the standard position?" :question/worked-solution "To help us to visualize the angle, we first convert the measure of the angle into degrees. \n\nTo convert the measure of an angle in radians to an equivalent measure in degrees, we multiply the measure in radians by $\\frac{{180}^{∘}}{\\pi }.$ This gives\n\n$$\n(\\frac{13\\pi }{9})\\cdot (\\frac{{180}^{∘}}{\\pi })={260}^{∘}.\n$$\n\nTherefore,  $\\frac{13\\pi }{9}$ is equivalent to ${260}^{∘}.$\n\nThen, recall that:\n\n- A unit circle has a radius of $1$ and is centered at the origin in the coordinate plane.\n\n- An angle in the standard position has its initial side on the positive $x$-axis and its vertex is at the origin.\n\n- A positive angle has a rotation that is measured counter-clockwise.\n\nTherefore, the correct diagram is as follows:\n\n![](images/50/50db86bd273e9e20ae705890103b067a1f664ed912fcb6efe9083db1060625c8.png)"}] [{:db/id #edb/ref 17592186527194 :knowledge-point/_questions [{:db/id #edb/ref 17592186119754 :knowledge-point/id #uuid "04ac62a3-1302-5011-937b-9fb20cb7fe95" :knowledge-point/title "Representing Angles in the Coordinate Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29f88466-b1dd-5a68-bd79-de41dccc7e7c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8d/8dcf6f13dc4ccc01d7b638b9b2b7c37d6c77a8dfc857c88ce831c591dc07a71b.png" :db/id #edb/ref 17592186526591} {: