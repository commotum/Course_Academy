463 TEX-I\"></mjx-c></mjx-mi></mjx-mrow></mjx-box></mjx-sqrt></mjx-mroot></mjx-den></mjx-row></mjx-dtable></mjx-dbox></mjx-frac></mjx-mfrac></mjx-mstyle></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mroot><mrow><mn>3</mn><mi>v</mi></mrow><mn>3</mn></mroot></mfrac></mstyle></math></mjx-assistive-mml></mjx-container></td></tr></tbody></table><div class=\"questionWidget-buttonBar\"><div class=\"questionWidget-submitButton disabledButton\" style=\"display: none;\">Submit</div></div><div class=\"questionWidget-spinnerFrame\"><div class=\"questionWidget-spinner\" style=\"display: block;\"></div></div><div class=\"questionWidget-result\"><div class=\"questionWidget-correctIncorrectIcon\"><img src=\"/img/correct-answer.svg\"></div><div class=\"questionWidget-correctText\">Correct</div></div><div class=\"questionWidget-explanationHeader\">EXPLANATION</div><div class=\"questionWidget-explanation\"><p>Remember that in general, a negative exponent can be converted to a positive exponent if we take the reciprocal. Here, we have:</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"75\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D463 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.413em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-texatom texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2F\"></mjx-c></mjx-mo></mjx-texatom><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn></mjx-texatom></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mstyle space=\"4\"><mjx-mfrac><mjx-frac type=\"d\"><mjx-num><mjx-nstrut type=\"d\"></mjx-nstrut><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-num><mjx-dbox><mjx-dtable><mjx-line type=\"d\"></mjx-line><mjx-row><mjx-den><mjx-dstrut type=\"d\"></mjx-dstrut><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D463 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.289em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-texatom texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2F\"></mjx-c></mjx-mo></mjx-texatom><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn></mjx-texatom></mjx-script></mjx-msup></mjx-den></mjx-row></mjx-dtable></mjx-dbox></mjx-frac></mjx-mfrac></mjx-mstyle></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><msup><mi>v</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>1</mn><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>3</mn></mrow></msup><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><msup><mi>v</mi><mrow data-mjx-texclass=\"ORD\"><mn>1</mn><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>3</mn></mrow></msup></mfrac></mstyle></math></mjx-assistive-mml></mjx-container></p>\n<p>Now, we can proceed as usual to convert the fractional exponent to a radical:</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"76\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mstyle><mjx-mfrac><mjx-frac type=\"d\"><mjx-num><mjx-nstrut type=\"d\"></mjx-nstrut><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-num><mjx-dbox><mjx-dtable><mjx-li