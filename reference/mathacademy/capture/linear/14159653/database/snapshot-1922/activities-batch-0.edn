#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186069751} :activity/id #uuid "cccce902-b3cc-5def-b4dd-8212d272d0fc" :activity/scope {:db/id #edb/ref 17592186050894 :topic/id #uuid "6f21843d-1a34-53a0-a3e5-e5b85146fb25" :topic/math-academy-id 380} :activity/steps [{:db/id #edb/ref 17592186069751 :step/content {:db/id #edb/ref 17592186069937 :tutorial/content "A radical expression like $\\sqrt{{\\color{black}x}}$ can also be written using a fractional exponent as $x^{1/2}.$ They mean the same thing.\n\nSimilarly,\n\n- a cube root such as $\\sqrt[{\\color{blue}3\\!\\phantom{p}}]{x}$ is equivalent to $x^{1/\\color{blue}{3}},$\n\n- a tenth root $\\sqrt[{\\color{blue}10\\!\\phantom{p}}]{x}$ is equivalent to $x^{1/\\color{blue}{10}},$\n\nand so on. In general, we have the following formula:\n\n$$\n\\sqrt[n]{x} = x^{1/n}\n$$" :tutorial/id #uuid "a261c9ab-28f0-59c3-ae99-985dc03258d0" :tutorial/math-academy-id 1475 :tutorial/title "Introduction"} :step/id #uuid "3e166ad5-7eaf-5c09-b0e8-453bb6131e54" :step/math-academy-id 3500 :step/next {:db/id #edb/ref 17592186069752}} {:db/id #edb/ref 17592186069752 :step/content {:db/id #edb/ref 17592186068818 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068437 :question/id #uuid "9d956f2f-da17-5f0a-9eee-d1a8d1aeab0d" :question/math-academy-id "e-1064"} :knowledge-point/id #uuid "8f568f1f-5c73-5080-893c-f0bde7e44270" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049089} {:db/id #edb/ref 17592186051009}] :knowledge-point/questions [{:db/id #edb/ref 17592186069266} {:db/id #edb/ref 17592186069355} {:db/id #edb/ref 17592186484209} {:db/id #edb/ref 17592186484261}] :knowledge-point/title "Converting a Fractional Exponent to a Radical"} :step/id #uuid "3032e04b-8a8c-560a-a76a-876ce6998f52" :step/math-academy-id 3503 :step/next {:db/id #edb/ref 17592186069753}} {:db/id #edb/ref 17592186069753 :step/content {:db/id #edb/ref 17592186068819 :knowledge-point/canonical-example {:db/id #ed