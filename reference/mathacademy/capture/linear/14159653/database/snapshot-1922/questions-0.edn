#{[{:db/id #edb/ref 17592186068437 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068818 :knowledge-point/id #uuid "8f568f1f-5c73-5080-893c-f0bde7e44270" :knowledge-point/title "Converting a Fractional Exponent to a Radical"}] :question/id #uuid "9d956f2f-da17-5f0a-9eee-d1a8d1aeab0d" :question/math-academy-id "e-1064" :question/problem "Write $(2a)^{1/3}$ using radical notation." :question/worked-solution "In general, the fractional exponent $x^{1/n}$ can also be written as the $n$th root $\\sqrt[n]{x}.$ In this particular case, $n=3,$ $x=2a,$ and we have\n\n$$\n(2a)^{1/3} = \\sqrt[3]{2a}\n$$"}] [{:db/id #edb/ref 17592186068438 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068819 :knowledge-point/id #uuid "b87f622b-5a30-5cb8-88f5-6b91450deb07" :knowledge-point/title "Converting a Radical to a Fractional Exponent"}] :question/id #uuid "96c1a35f-ee50-5546-bc26-cff2a4e43df8" :question/math-academy-id "e-1065" :question/problem "Write $\\sqrt[4]{2y}$ using power notation." :question/worked-solution "In general, the $n$th root $\\sqrt[n]{x}$ can also be written using a fractional exponent as $x^{1/n}.$ In this particular case, $n=4,$ $x=2y,$ and we have\n\n$$\n\\sqrt[4]{2y} = (2y)^{1/4}\n$$"}] [{:db/id #edb/ref 17592186068440 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068820 :knowledge-point/id #uuid "938b058c-9b0b-5a42-8ef7-21c11f93acc9" :knowledge-point/title "Converting a Negative Fractional Exponent to a Radical"}] :question/id #uuid "2b4f5483-d272-5605-a7cc-9c9f11653707" :question/math-academy-id "e-1066" :question/problem "Write $x^{-1/2}$ using radical notation." :question/worked-solution "Remember that, in general, a negative exponent can be converted to a positive exponent if we take the reciprocal. Here, we have\n\n$$\nx^{-1/2} = \\dfrac{1}{x^{1/2}}.\n$$\n\nNow, we can proceed as usual to convert the fractional exponent to a radical\n\n$$\n\\dfrac{1}{x^{1/2}} = \\dfrac{1}{\\sqrt{x}}.\n$$\n\n \n\nTherefore, we have\n\n$$\nx^{-1/2} =  \\dfrac{1}{\\sqrt{x}}.\n$$"}] [{:db/id #edb/ref 17592186068441 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068821 :knowledge-point/id #uuid "6f25ee9f-2ff0-5f02-8b6e-166aa7c1bb8a" :knowledge-point/title "Converting a Radical to a Negative Fractional Exponent"}] :question/id #uuid "6cb6f11f-cdf8-5082-8ccf-2052d15fb876" :question/math-academy-id "e-1067" :question/problem "Express $\\dfrac{1}{\\sqrt[3\\phantom{|}]{2y}}$ using power notation." :question/worked-solution "First, we convert the radical to a fractional exponent:\n\n$$\n\\dfrac{1}{\\sqrt[3\\phantom{|}]{2y}} = \\dfrac{1}{(2y)^{1/3}}\n$$\n\n \n\nThen, we take the reciprocal and convert the exponent to a negative exponent:\n\n$$\n\\dfrac{1}{(2y)^{1/3}} = (2y)^{-1/3}\n$$\n\n \n\nTherefore, we have:\n\n$$\n\\dfrac{1}{\\sqrt[3\\phantom{|}]{2y}} = (2y)^{-1/3}\n$$"}] [{:db/id #edb/ref 17592186484218 :knowledge-point/_questions [{:db/id #edb/ref 17592186068819 :knowledge-point/id #uuid "b87f622b-5a30-5cb8-88f5-6b91450deb07" :knowledge-point/title "Converting a Radical to a Fractional Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "470e2430-3918-5574-9a80-f7670d875331" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186483696} {:answer/id #uuid "4c9e36b8-8bf9-5d3b-b3a3-047c5d4b8206" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186483709} {:answer/id #uuid "66fef71c-1c95-5ec8-bea3-0c0c21ff9b2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186483767} {:answer/id #uuid "9dcd6360-86e3-5a10-a49c-1c1a63f3a037" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186483892} {:answer/id #uuid "f3255014-448d-5074-8f1d-d51b0c23cdac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186484056}] :answer-field/correct {:answer/id #uuid "4c9e36b8-8bf9-5d3b-b3a3-047c5d4b8206" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186483709} :answer-field/id #uuid "118cd066-a7c2-54b2-a279-e574ebce0b40" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186484089}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4de24564-b425-5826-93e9-0754fb5ac312" :question/math-academy-id "q-2953" :question/problem "Given that $\\sqrt[4]{u}={u}^{n},$ what is $n?$" :question/worked-solution "In general, the $n$th root $\\sqrt[n]{x}$ can also be written using a fractional exponent as ${x}^{1/n}.$ In this particular case, $n=4,$ $x=u,$ and we have:\n\n$$\n\\sqrt[4]{u}={u}^{1/4}\n$$\n\nTherefore, ${u}^{n}={u}^{1/4},$ so $n=\\frac{1}{4}.$"}] [{:db/id #edb/ref 17592186484261 :knowledge-point/_questions [{:db/id #edb/ref 17592186068818 :knowledge-point/id #uuid "8f568f1f-5c73-5080-893c-f0bde7e44270" :knowledge-point/title "Converting a Fractional Exponent to a Radical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a9bce1e-a34f-5f5d-8aac-f77651f087c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{q}^{3}}" :db/id #edb/ref 17592186483676} {:answer/id #uuid "4b196de5-948a-58ea-8149-3e9c9c740cf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3q}" :db/id #edb/ref 17592186483703} {:answer/id #uuid "75262d5e-746f-539c-af9d-2ba0e1a5ce64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{q}" :db/id #edb/ref 17592186483803} {:answer/id #uuid "940544bb-0d8d-5db9-a060-b203e9e25828" :answer/type {:db/id #edb/ref 1759218604549