#{[{:db/id #edb/ref 17592186068437 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068818 :knowledge-point/id #uuid "8f568f1f-5c73-5080-893c-f0bde7e44270" :knowledge-point/title "Converting a Fractional Exponent to a Radical"}] :question/id #uuid "9d956f2f-da17-5f0a-9eee-d1a8d1aeab0d" :question/math-academy-id "e-1064" :question/problem "Write $(2a)^{1/3}$ using radical notation." :question/worked-solution "In general, the fractional exponent $x^{1/n}$ can also be written as the $n$th root $\\sqrt[n]{x}$. In this particular case, $n=3$, $x=2a$, and we have\n\n$$\n(2a)^{1/3} = \\sqrt[3]{2a}\n$$"}] [{:db/id #edb/ref 17592186068438 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068819 :knowledge-point/id #uuid "b87f622b-5a30-5cb8-88f5-6b91450deb07" :knowledge-point/title "Converting a Radical to a Fractional Exponent"}] :question/id #uuid "96c1a35f-ee50-5546-bc26-cff2a4e43df8" :question/math-academy-id "e-1065" :question/problem "Write $\\sqrt[4]{2y}$ using power notation." :question/worked-solution "In general, the $n$th root $\\sqrt[n]{x}$ can also be written using a fractional exponent as $x^{1/n}$. In this particular case, $n=4$, $x=2y$, and we have\n\n$$\n\\sqrt[4]{2y} = (2y)^{1/4}\n$$"}] [{:db/id #edb/ref 17592186068440 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068820 :knowledge-point/id #uuid "938b058c-9b0b-5a42-8ef7-21c11f93acc9" :knowledge-point/title "Converting a Negative Fractional Exponent to a Radical"}] :question/id #uuid "2b4f5483-d272-5605-a7cc-9c9f11653707" :question/math-academy-id "e-1066" :question/problem "Write $x^{-1/2}$ using radical notation." :question/worked-solution "Remember that, in general, a negative exponent can be converted to a positive exponent if we take the reciprocal. Here, we have\n\n$$\nx^{-1/2} = \\dfrac{1}{x^{1/2}}\n$$\n\nNow, we can proceed as usual to convert the fractional exponent to a radical\n\n$$\n\\dfrac{1}{x^{1/2}} = \\dfrac{1}{\\sqrt{x}}\n$$\n\nTherefore, we have\n\n$$\nx^{-1/2} = \\dfrac{1}{\\sqrt{x}}\n$$"}] [{:db/id #edb/ref 17592186068441 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068821 :knowledge-point/id #uuid "6f25ee9f-2ff0-5f02-8b6e-166aa7c1bb8a" :knowledge-point/title "Converting a Radical to a Negative Fractional Exponent"}] :question/id #uuid "6cb6f11f-cdf8-5082-8ccf-2052d15fb876" :question/math-academy-id "e-1067" :question/problem "Express $\\dfrac{1}{\\sqrt[3\\phantom{\\mid}]{2y}}$ using power notation." :question/worked-solution "First, we convert the radical to a fractional exponent:\n\n$$\n\\dfrac{1}{\\sqrt[3\\phantom{\\mid}]{2y}} = \\dfrac{1}{(2y)^{1/3}}\n$$\n\nThen, we take the reciprocal and convert the exponent to a negative exponent:\n\n$$\n\\dfrac{1}{(2y)^{1/3}} = (2y)^{-1/3}\n$$\n\nTherefore, we have:\n\n$$\n\\dfrac{1}{\\sqrt[3\\phantom{\\mid}]{2y}} = (2y)^{-1/3}\n$$"}] [{:db/id #edb/ref 17592186069459 :knowledge-point/_questions [{:db/id #edb/ref 17592186068820 :knowledge-point/id #uuid "938b058c-9b0b-5a42-8ef7-21c11f93acc9" :knowledge-point/title "Converting a Negative Fractional Exponent to a Radical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "899c435f-72c7-5afe-b3b4-e353188e90bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{\\sqrt[3 \\mid]{k}}" :db/id #edb/ref 17592186067925} {:answer/id #uuid "ded74e7e-6a5a-51a2-ba34-86bab9496637" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5\\sqrt[3 \\mid]{k}}" :db/id #edb/ref 17592186067926} {:answer/id #uuid "3d044f8b-7189-5c03-b5a6-25b0c99a4b68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt[3 \\mid]{5k}}" :db/id #edb/ref 17592186067927} {:answer/id #uuid "6546f9c8-d52d-5ffd-9e03-0105cf754635" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3 \\mid]{5k}" :db/id #edb/ref 17592186067928} {:answer/id #uuid "7a167714-0fab-51e5-889f-1955dd7dde48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3\\sqrt{k}}" :db/id #edb/ref 17592186067929}] :answer-field/id #uuid "e0f3f146-a1db-5130-a033-9f2145c46273" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067924}] :question/id #uuid "874e0e5d-1955-54ec-9b68-2ef62d277db8" :question/math-academy-id "q-60563" :question/problem "What is $(5k)^{-1/3}$?"}]}
