{3}} & = \\\\ \\frac{(-2)^{3}{x}^{3}}{125} & = \\\\ -\\frac{8{x}^{3}}{125}\\end{aligned}\n$$"} :step/id #uuid "28fd1bcd-2fe9-55e9-85ea-0661511252c1" :step/next {:db/id #edb/ref 17592186553672}} {:db/id #edb/ref 17592186553624 :step/content {:db/id #edb/ref 17592186553590 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1723e9e6-e3d4-5c92-884a-480d4b3096da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{3}^{4}}{{2}^{4}}" :db/id #edb/ref 17592186552908} {:answer/id #uuid "31d7b2f4-f18a-559c-ace0-d916afe65784" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186552965} {:answer/id #uuid "3e978287-ff14-526a-8959-0da6c17344b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{3}^{4}" :db/id #edb/ref 17592186552992} {:answer/id #uuid "7fc4dfa5-2ae6-59d3-b3af-d745124b5bd1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{2}^{4}}{{3}^{4}}" :db/id #edb/ref 17592186553127} {:answer/id #uuid "b2772045-ea3b-5d01-b1ee-fe20dc09c641" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{4}" :db/id #edb/ref 17592186553227}] :answer-field/correct {:db/id #edb/ref 17592186552908} :answer-field/id #uuid "6f62a198-63f6-5ace-982e-2254c7cebad3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186553427}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fc247476-de74-5773-8d25-47f3b046cb55" :question/math-academy-id "q-299" :question/problem "${(\\frac{3}{2})}^{4}=$" :question/worked-solution "We apply the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{3}{2})}^{4}=\\frac{{3}^{4}}{{2}^{4}}\\end{aligned}\n$$"} :step/id #uuid "5a36885b-76aa-5356-b939-a179350d8158" :step/next {:db/id #edb/ref 17592186553609}} {:db/id #edb/ref 17592186553672 :step/content {:db/id #edb/ref 17592186553503 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "100858d8-fbb8-53d1-94ff-