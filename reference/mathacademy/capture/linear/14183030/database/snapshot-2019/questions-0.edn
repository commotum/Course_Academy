#{[{:db/id #edb/ref 17592186068542 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068681 :knowledge-point/id #uuid "62bb3b79-407f-511b-913d-f47b3ea6d822" :knowledge-point/title "Calculating the Circumference of a Circle Given the Diameter"}] :question/id #uuid "ba3d3abd-4b93-5705-8fcb-cb88b58dad2f" :question/math-academy-id "e-3178" :question/problem "What is the circumference $C$ of a circle with a diameter of $d=10$?\n\n![](images/b1/b1ebd81fca9688b5688dc916d6be62bad14853f55a8e66c5c7af469dd4032ec4.png)" :question/worked-solution "We use the formula $C=\\pi d$ and get\n\n$$\n\\begin{aligned}\nC &= πd \\\\\n&= π \\cdot 10 \\\\\n&= 10π\n\\end{aligned}\n$$\n\nThis is the exact answer. If we want an approximate answer, say rounded to three decimal places, we can use the approximation\n\n$$\n\\pi\\approx 3.14\\,159\n$$\n\nand we get\n\n$$\n\\begin{aligned}\nC &= 10 \\cdot π \\\\\n&\\approx 10 \\cdot 3.14159 \\\\\n&\\approx 31.416\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068543 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068682 :knowledge-point/id #uuid "27538979-a350-50d2-9c55-cebf0bd7e78b" :knowledge-point/title "Calculating the Circumference of a Circle Given the Radius"}] :question/id #uuid "d26dfc25-605c-5d73-80bc-15801b20beb5" :question/math-academy-id "e-3179" :question/problem "What is the circumference $C$ of a circle with a radius of $6$?\n\n![](images/3c/3c21021529285f488ca794a442e5826a033ed2a4c6f4fad53ab9e8fdc84d35ee.png)" :question/worked-solution "We use the formula $C=2\\pi r$ to get\n\n$$\n\\begin{aligned}\nC &= 2πr \\\\\n&= 2π \\cdot 6 \\\\\n&= 12π\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068544 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068683 :knowledge-point/id #uuid "09b24ba2-e9c9-5839-81df-09720bc9c7d8" :knowledge-point/title "Finding the Radius or Diameter of a Circle Given the Circumference"}] :question/id #uuid "af77eddf-8816-5b03-a53d-0f29f1f1a1b3" :question/math-academy-id "e-3180" :question/problem "What is the radius $r$ of a circle with a circumference of $C=17\\pi$?\n\n![](images/69/697cc9ca06bcfe46d84dfab74e0f6ae83f4342607ea4af138b111606c16e8a03.png)" :question/worked-solution "We use the formula for the circumference $C=2\\pi r$ and solve for $r$. So, we have\n\n$$\n\\begin{aligned}\nC &= 2πr \\\\\n17π &= 2πr \\\\\nr &= \\frac{17π}{2π} \\\\\n&= \\frac{17}{2} \\\\\n&= 8.5\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068545 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068684 :knowledge-point/id #uuid "89403c66-caac-5f6b-bacd-9f2a74525198" :knowledge-point/title "Calculating the Circumference of a Circle: Word Problem"}] :question/id #uuid "e18e4cc8-8ecb-53e9-8b12-c9cb5b926aa7" :question/math-academy-id "e-3182" :question/problem "Carol has to wrap a rope around a circular column whose diameter is $20\\,\\textrm{cm}$. What length of the rope will wrap the column perfectly?" :question/worked-solution "The length of the rope needed to wrap around the column is its circumference.\n\nThe formula for the circumference of a circle is $C = \\pi d$, where\n\n$$\nd=20\\,\\textrm{cm}\n$$\n\nis the diameter.\n\nTherefore, we have\n\n$$\nC = \\pi\\cdot 20 = 20\\pi \\,\\textrm{cm}\n$$"}] [{:db/id #edb/ref 17592186069430 :knowledge-point/_questions [{:db/id #edb/ref 17592186068684 :knowledge-point/id #uuid "89403c66-caac-5f6b-bacd-9f2a74525198" :knowledge-point/title "Calculating the Circumference of a Circle: Word Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "832ce314-f7ed-5a3d-b2cc-77d4f142ee1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15πm" :db/id #edb/ref 17592186067751} {:answer/id #uuid "bba157f1-37c1-5cc9-911d-4c2b9608936c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30m" :db/id #edb/ref 17592186067752} {:answer/id #uuid "074facbb-7709-5911-957b-7633a21b9e5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "πm" :db/id #edb/ref 17592186067753} {:answer/id #uuid "7328fc4a-7c42-5867-bef2-333336e35176" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60πm" :db/id #edb/ref 17592186067754} {:answer/id #uuid "74f01cf0-3efc-5eec-9a0d-637bc2117bb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30πm" :db/id #edb/ref 17592186067755}] :answer-field/id #uuid "6cc22b08-f4a6-5ada-8fe7-444636f12ecd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067750}] :question/id #uuid "21f64099-6f70-52f4-bd49-e0e0761a9208" :question/math-academy-id "q-53553" :question/problem "![](images/ad/ad42b4bd62bf64e1ac086a60ace286b3e6d1c136f423d2ae6aabf6339cea9071.png)\n\nWhat length of fence is needed to border a circular plot of land with a diameter of $30m$?"}]}
