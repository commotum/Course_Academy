3 #edb/ref 17592186045417] [17592186050613 #edb/ref 1027 #edb/ref 17592186049405 #edb/ref 17592186045417] [17592186050613 #edb/ref 1027 #edb/ref 17592186049874 #edb/ref 17592186045417] [17592186050613 #edb/ref 1027 #edb/ref 17592186049878 #edb/ref 17592186045417] [17592186050613 #edb/ref 1027 #edb/ref 17592186049986 #edb/ref 17592186045417] [17592186050613 #edb/ref 1027 #edb/ref 17592186050093 #edb/ref 17592186045417] [17592186050613 #edb/ref 1027 #edb/ref 17592186050893 #edb/ref 17592186045417] [17592186050613 #edb/ref 1027 #edb/ref 17592186050979 #edb/ref 17592186045417] [17592186050613 #edb/ref 1028 #edb/ref 17592186054834 #edb/ref 17592186045417] [17592186050613 #edb/ref 1028 #edb/ref 17592186054835 #edb/ref 17592186045417] [17592186050613 #edb/ref 1028 #edb/ref 17592186054836 #edb/ref 17592186045417] [17592186050613 #edb/ref 1028 #edb/ref 17592186054837 #edb/ref 17592186045417] [17592186050613 #edb/ref 1031 "Solving One-Step Multiplication and Division Equations" #edb/ref 17592186045417] [17592186050613 #edb/ref 1033 40 #edb/ref 17592186045417] [17592186050613 #edb/ref 1035 #uuid "58d4d7b7-4b91-5e3c-ba04-7522d5cfa8f6" #edb/ref 17592186045417] [17592186067750 #edb/ref 1075 #edb/ref 17592186496969 #edb/ref 17592186045417] [17592186067750 #edb/ref 1075 #edb/ref 17592186496972 #edb/ref 17592186045417] [17592186067750 #edb/ref 1075 #edb/ref 17592186497095 #edb/ref 17592186045417] [17592186067750 #edb/ref 1075 #edb/ref 17592186497147 #edb/ref 17592186045417] [17592186067750 #edb/ref 1075 #edb/ref 17592186497182 #edb/ref 17592186045417] [17592186067750 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186067750 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186067750 #edb/ref 1078 #edb/ref 17592186496969 #edb/ref 17592186045417] [17592186067750 #edb/ref 1079 #uuid "6cc22b08-f4a6-5ada-8fe7-444636f12ecd" #edb/ref 17592186045417] [17592186068542 #edb/ref 1069 "e-3178" #edb/ref 17592186045417] [17592186068542 #edb/ref 1071 "What is the circumference $C$ of a circle with a diameter of $d=10?$ \n\n![](images/b1/b1ebd81fca9688b5688dc916d6be62bad14853f55a8e66c5c7af469dd4032ec4.png)" #edb/ref 17592186045417] [17592186068542 #edb/ref 1072 #uuid "ba3d3abd-4b93-5705-8fcb-cb88b58dad2f" #edb/ref 17592186045417] [17592186068542 #edb/ref 1074 "We use the formula $C=\\pi d$ and get\n\n$$\n\\begin{aligned}C & =\\pi d \\\\  & =\\pi \\cdot 10 \\\\  & =10\\pi .\\end{aligned}\n$$\n\nThis is the exact answer. If we want an approximate answer, say rounded to three decimal places, we can use the approximation $\\pi\\approx 3.14\\,159,$ and we get\n\n$$\n\\begin{aligned}C & =10\\cdot \\pi  \\\\  & ≈10\\cdot 3.14\\,159 \\\\  & ≈31.416.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186068543 #edb/ref 1069 "e-3179" #edb/ref 17592186045417] [17592186068543 #edb/ref 1071 "What is the circumference $C$ of a circle with a radius of $6?$\n\n![](images/3c/3c21021529285f488ca794a442e5826a033ed2a4c6f4fad53ab9e8fdc84d35ee.png)" #edb/ref 17592186045417] [17592186068543 #edb/ref 1072 #uuid "d26dfc25-605c-5d73-80bc-15801b20beb5" #edb/ref 17592186045417] [17592186068543 #edb/ref 1074 "We use the formula $C=2\\pi r$ to get\n\n$$\n\\begin{aligned}C & =2\\pi r \\\\  & =2\\pi \\cdot 6 \\\\  & =12\\pi .\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186068544 #edb/ref 1069 "e-3180" #edb/ref 17592186045417] [17592186068544 #edb/ref 1071 "What is the radius $r$ of a circle with a circumference of $C=17\\pi?$\n\n![](images/69/697cc9ca06bcfe46d84dfab74e0f6ae83f4342607ea4af138b111606c16e8a03.png)" #edb/ref 17592186045417] [17592186068544 #edb/ref 1072 #uuid "af77eddf-8816-5b03-a53d-0f29f1f1a1b3" #edb/ref 17592186045417] [17592186068544 #edb/ref 1074 "We use the formula for the circumference $C=2\\pi r$ and solve for $r.$ So, we have\n\n$$\n\\begin{aligned}C & =2\\pi r \\\\ 17\\pi  & =2\\pi r \\\\ r & =\\frac{17\\pi }{2\\pi } \\\\  & =\\frac{17}{2} \\\\  & =8.5.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186068545 #edb/ref 1069 "e-3182" #edb/ref 17592186045417] [17592186068545 #edb/ref 1071 "Carol has to wrap a rope around a circular column whose diameter is $20\\,\\textrm{cm}.$ What length of the rope will wrap the column perfectly?" #edb/ref 17592186045417] [17592186068545 #edb/ref 1072 #uuid "e18e4cc8-8ecb-53e9-8b12-c9cb5b926aa7" #edb/ref 17592186045417] [17592186068545 #edb/ref 1074 "The length of the rope needed to wrap around the column is its circumference.\n\nThe formula for the circumference of a circle is $C = \\pi d$, where $d=20\\,\\textrm{cm}$ is the diameter. \n\nTherefore, we have\n\n$$\nC = \\pi\\cdot 20 = 20\\pi \\,\\textrm{cm}.\n$$" #edb/ref 17592186045417] [17592186068681 #edb/ref 1037 #edb/ref 17592186048438 #edb/ref 17592186045417] [17592186068681 #edb/ref 1037 #edb/ref 17592186049856 #edb/ref 17592186045417] [17592186068681 #edb/ref 1038 #edb/ref 17592186069254 #edb/ref 17592186045417] [17592186068681 #edb/ref 1038 #edb/ref 17592186069255 #edb/ref 17592186045417] [17592186068681 #edb/ref 1038 #edb/ref 17592186497391 #edb/ref 17592186045417] [17592186068681 #edb/ref 1038 #edb/ref 17592186497396 #edb/ref 17592186045417] [17592186068681 #edb/ref 1039 "Calculating the Circumference of a Circle Given the Diameter" #edb/ref 17592186045417] [17592186068681 #edb/ref 1041 #edb/ref 17592186068542 #edb/ref 17592186045417] [17592186068681 #edb/ref 1042 #uuid "62bb3b79-407f-511b-913d-f47b3ea6d822" #edb/ref 17592186045417] [17592186068682 #edb/ref 1038 #edb/ref 17592186069256 #edb/ref 17592186045417] [17592186068682 #edb/ref 1038 #edb/ref 17592186069257 #edb/ref 17592186045417] [17592186068682 #edb/ref 1038 #edb/ref 17592186497332 #edb/ref 17592186045417] [17592186068682 #edb/ref 1038 #edb/ref 17592186497335 #edb/ref 17592186045417] [17592186068682 #edb/ref 1039 "Calculating the Circumference of a Circle Given the Radius" #edb/ref 17592186045417] [17592186068682 #edb/ref 1041 #edb/ref 17592186068543 #edb/ref 17592186045417] [17592186068682 #edb/ref 1042 #uuid "27538979-a350-50d2-9c55-cebf0bd