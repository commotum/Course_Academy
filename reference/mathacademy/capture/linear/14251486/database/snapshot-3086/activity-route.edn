#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186572261} :activity/id #uuid "7d8c6889-f3ae-58cb-b3ca-0eb7b18e98a4" :activity/scope {:db/id #edb/ref 17592186049603 :topic/id #uuid "03d5463d-8db1-5e89-8946-23139052e041" :topic/math-academy-id 1100} :activity/steps [{:db/id #edb/ref 17592186572215 :step/content {:db/id #edb/ref 17592186572191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64a42ea5-cb0d-54c7-b3b7-fd35361140e1" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/25/25b5c9f9f5f517b7a3f2f1d5e70e6d7b0183d9ab651838fe735b0f378d7f141a.png" :db/id #edb/ref 17592186571711} {:answer/id #uuid "76ed3423-8abf-5493-8cd1-018a985dcee0" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b5/b5a6d499f13d14643ce47f7decd46d739278c40431412c9cc1862c4dd4e61f55.png" :db/id #edb/ref 17592186571741} {:answer/id #uuid "a7e2846a-fd9c-51da-a226-b4a0df2d034a" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/26/26c4988a765a67f300428ef7e921df05bcac4f165c71f65a2ba7471d324452a8.png" :db/id #edb/ref 17592186571828} {:answer/id #uuid "af573cc2-d740-58f5-a9b3-14514a40675a" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/de/de3ea7300a64b5cb83b6c06a07ed673a29a025123fc955283e13bcdcff8c0a84.png" :db/id #edb/ref 17592186571842} {:answer/id #uuid "c7a268df-28db-5d13-ab80-d2d03b65eb80" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/44/44c890a2ab9f5c3ed67deecee95c76bc663010e3331da48c14d9504c242aeb2a.png" :db/id #edb/ref 17592186571894}] :answer-field/correct {:db/id #edb/ref 17592186571842} :answer-field/id #uuid "c506eaa0-7955-591f-814f-18652414f794" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186572076}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e294440f-b12e-5095-aeac-cd3f942d43e6" :question/math-academy-id "q-69856" :question/problem "![](images/32/3247a3ba0e4434860318ef697e29f7d377cfb0eb08135bb5d3e147516b2a5505.png)\n\nConsider the vector $\\overset{\\to }{CD},$ shown above. Which of the following could be $\\overset{\\to }{CD}+\\overset{\\to }{DC}?$" :question/worked-solution "According to the triangle law of addition, the resultant is the vector that goes from the tail of $\\overset{\\to }{CD}$ to the head of $\\overset{\\to }{DC}.$ Therefore, we obtain a new vector for which the tail and head is the same point, the tail of $\\overset{\\to }{CD}.$ \n\nThat vector is called the zero vector, and we write\n\n$$\n\\overset{\\to }{CD}+\\overset{\\to }{DC}=0.\n$$\n\nThe corresponding graph is shown below.\n\n![](images/8e/8e51db7c2e9eff46679a185b82a477d65842d43d1dd71289f3e6bab1a7a503de.png)"} :step/id #uuid "28439026-9df7-5022-8efd-98cccd4a8a55"} {:db/id #edb/ref 17592186572261 :step/content {:db/id #edb/ref 17592186097335 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2e99f4a-91f0-5666-986c-d96a19fd2379" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/eb/eb42f18a8d83b77a18b8e796c55cb834b4288bebfd028bd89bfe58bda39252af.png" :db/id #edb/ref 17592186095935} {:answer/id #uuid "a610a33f-18cd-5e82-8634-239c2bde6252" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/24/24cf5282bb402e4c3a3320fdfbf37e6c866692e8c646d558738c289a999d3a36.png" :db/id #edb/ref 17592186095936} {:answer/id #uuid "dee44144-6f77-53e4-9c87-f3521ff5b169" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a9/a91fc49b59add56f76c2eab2def379db811cc7787ee3f809e0cb3f7c70d838df.png" :db/id #edb/ref 17592186095937} {:answer/id #uuid "696c6af9-a8b4-5aee-9b9c-615b7c7c0075" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a8/a85b7f11192f871932665f91542787d8857dcdc22f98771a8df0f4c713058e17.png" :db/id #edb/ref 17592186095938} {:answer/id #uuid "71c2fdc3-b767-5c37-8a7c-a0da3a6be94e" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/de/de4539966254b47c26b16233b26d32ad14453c296fb2692ab4bc147620c46174.png" :db/id #edb/ref 17592186095939}] :answer-field/id #uuid "65c0f080-99fe-57f2-a719-d49f2825bb86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186095934}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "91930512-85f3-5da9-9a83-797480e4b3d5" :question/math-academy-id "q-69448" :question/problem "![](images/44/44612517750f797998e4d7ec8d535cd2149c04e756255b3edf90f7a756463420.png)\n\nConsider the diagram shown above. Which of the following could be $-a$?"} :step/id #uuid "aacc10c9-f5e2-59c8-9018-6674e86ff34b" :step/next {:db/id #edb/ref 17592186572278}} {:db/id #edb/ref 17592186572278 :step/content {:db/id #edb/ref 17592186572157 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02d17fb1-db0e-56fc-9024-2583fa21dae5" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f7/f7e357b3b9b74f27dc253bf611729dd188b632df511ba1f10c33e4bde313d8ec.png" :db/id #edb/ref 17592186571541} {:answer/id #uuid "2cadde5b-64c5-5e69-87ce-17b7c4c4079d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/26/26bd490f6fbd3d3d9dab6a9653ed4e8043b5d266eeddd13255a30a6c2d10da0a.png" :db/id #edb/ref 17592186571614} {:answer/id #uuid "3be231ec-2961-59f0-9c62-a8218e52a1f6" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/23/238fe7bdb6d394bed88fd0442050da14977f0391e7650ef36d7a94e998446106.png" :db/id #edb/ref 17592186571648} {:answer/id #uuid "e103853e-2bf0-5610-8cac-ea008ed6f26f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/10/107791ab54cddf8f42b83c349d450d961f4334757f5a525e707f25382529ee02.png" :db/id #edb/ref 17592186571942} {:answer/id #uuid "ee7107e0-b805-55a6-95df-0517737a0181" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/56/56e29d1e52f2c84cf6581f9b46d4b5216f53a9c44d15b2c0c1b21d2d1f57b0b3.png" :db/id #edb/ref 17592186571957}] :answer-field/correct {:db/id #edb/ref 17592186571648} :answer-field/id #uuid "b9df1b13-c754-54c2-9e96-913d5093b7bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186572072}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9756da76-54ed-58bb-84a5-fe67fc16acc7" :question/math-academy-id "q-69508" :question/problem "![](images/b6/b6200095c8fc6c8267fcb1511fcb1ffee896c23ece3a899b76bf3a8701e65440.png)\n\nThe diagram shows the vectors $a$ and $b.$  Which of the following diagrams illustrates the vector subtraction $a-b.$" :question/worked-solution "We interpret the subtraction\n$a-b$\nas the addition\n\n$$\na+(-b),\n$$\n\nwhere $-b$ is the vector that has the same magnitude as $b$ but goes in the direction *opposite* of $b.$\n\nFinally, we use the triangle law to add the vectors $a$ and $-b:$ \n\n- We can start $a$ from an arbitrary point on the plane.\n\n- Next, we draw the vector that is equal to $-b$ and has its tail placed at the head of $a.$\n\n- Now, according to the triangle law of addition, the resultant is the vector that goes from the tail of $\\text{a}$ to the head of $-\\text{b}$, as shown below.\n\n![](images/6f/6fe262898a31d393dc0e1046fbbcbb0a1c9d7c3fb00aed0a982bff5029fcd2a1.png)"} :step/id #uuid "f75a3ecc-4d92-58be-9d26-61d0b71eab9f" :step/next {:db/id #edb/ref 17592186572215}}] :activity/title "The Triangle Law for the Addition of Two Vectors" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186571527}]}
