a-14c6ece3d1fc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-1$ or $11$" :db/id #edb/ref 17592186492456} {:answer/id #uuid "c0ed8913-7141-5fed-a6ed-846233cc1d57" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$11$ only" :db/id #edb/ref 17592186492602} {:answer/id #uuid "f02f7135-1784-56eb-88e1-1c8c91546081" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$ or $5$" :db/id #edb/ref 17592186492682}] :answer-field/correct {:db/id #edb/ref 17592186492456} :answer-field/id #uuid "51aef6b7-5dcd-5253-a886-fdee125552e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492736}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b25ca648-9cf3-58f7-bad1-6cf2e59324cf" :question/math-academy-id "q-154645" :question/problem "If $|5-x|=6,$ then $x=$" :question/worked-solution "Either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nSo, we set up the two corresponding equations and solve them independently:\n\n- If $|5-x|=5-x,$ we obtain:\n\n$$\n\\begin{aligned}|5-x| & =6 \\\\ 5-x & =6 \\\\ -x & =1 \\\\ x & =-1\\end{aligned}\n$$\n\n- If $|5-x|=-(5-x),$ we obtain:\n\n$$\n\\begin{aligned}|5-x| & =6 \\\\ -(5-x) & =6 \\\\ -5+x & =6 \\\\ x & =11\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-1$ and $x=11.$"} :step/id #uuid "a1c53633-2063-5148-ab3a-e83f6501d22e"} {:db/id #edb/ref 17592186492987 :step/content {:db/id #edb/ref 17592186492905 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0701c6fb-b8b0-5030-bb54-6715655e1d6e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-\\frac{2}{7}$ or $2$" :db/id #edb/ref 17592186492232} {:answer/id #uuid "591e63f9-b0da-50e5-9f5f-c6dc29186793" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-2$ or $-\\frac{2}{7}$" :db/id #edb/ref 17592186492392} {:answer/id #uuid "8f3a1f6d-cc83-5713-9c86-11f797705b67" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\frac{2}{7}$ or $2$" :db/id #edb/ref 17592186492500} {:answer/id #uuid "a4bff5c8-756d-5c90-a938-61faf60d9476" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-2$ or $\\frac{7}{2}$" :db/id #edb/ref 17592186492550} {:answer/id #uuid "b716a5c1-2bda-5fe2-a26b-d8a2524741b3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ or $\\frac{7}{2}$" :db/id #edb/ref 17592186492586}] :answer-field/correct {:db/id #edb/ref 17592186492586} :answer-field/id #uuid "dac4219c-b92c-5d85-9814-6729d48e7233" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492795}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bf001cda-9f10-546a-97c2-0d9313d65e00" :question/math-academy-id "q-15254" :question/problem "If $|11-4x|=3,$ then $x=$" :question/worked-solution "Either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nSo, we set up the two corresponding equations and solve them independently:\n\n- If $|11-4x|=11-4x,$ we obtain:\n\n$$\n\\begin{aligned}|11-4x| & =3 \\\\ 11-4x & =3 \\\\ -4x & =-8 \\\\ \\frac{-4x}{-4} & =\\frac{-8}{-4} \\\\ x & =2\\end{aligned}\n$$\n\n- If $|11-4x|=-(11-4x),$ we obtain:\n\n$$\n\\begin{aligned}|11-4x| & =3 \\\\ -(11-4x) & =3 \\\\ -11+4x & =3 \\\\ 4x & =14 \\\\ \\frac{4x}{4} & =\\frac{14}{4} \\\\ x & =\\frac{7}{2}\\end{aligned}\n$$\n\nTherefore, the solutions are $x=2$ and $x=\\frac{7}{2}.$"} :step/id #uuid "b16ab395-e781-5b4b-970d-5cc8a7610c9e" :step/next {:db/id #edb/ref 17592186493001}} {:db/id #edb/ref 17592186493001 :step/content {:db/id #edb/ref 17592186492915 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "589f4d35-5413-5d87-83c1-4a59ecc9ebd0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\frac{9}{5}$ or $3$" :db/id #edb/ref 17592186492388} {:answer/id #uuid "9d463002-439b-562b-9798-0df675319b5b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-1$ or $3$" :db/id #edb/ref 17592186492523} {:answer/id #uuid "b557add2-f5fc-5a0c-ad04-8a1c5f8ba3b7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-3$ or $\\frac{9}{5}$" :db/id #edb/ref 17592186492580} {:answer/id #uuid "cc661ccb-9cb1-5767-b7fa-3f7b29153ffc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$ or $3$" :db/id #edb/ref 17592186492623} {:answer/id #uuid "e68b697d-110c-5bd9-88a6-6ccd86dd44e7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-3$ or $-\\frac{9}{5}$" :db/id #edb/ref 17592186492664}] :answer-field/correct {:db/id #edb/ref 17592186492388} :answer-field/id #uuid "ffecce80-4a83-596b-bd4c-c3a2d3d4cfc9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492819}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dc058aee-cd4e-56a4-b735-dc759e998e0e" :question/math-academy-id "q-15257" :question/problem "If $|5x-12|=3,$ then $x=$" :question/worked-solution "Either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nSo, we set up the two corresponding equations and solve them independently:\n\n- If $|5x-12|=5x-12,$ we obtain:\n\n$$\n\\begin{aligned}|5x-12| & =3 \\\\ 5x-12 & =3 \\\\ 5x & =15 \\\\ \\frac{5x}{5} & =\\frac{15}{5} \\\\ x & =3\\end{aligned}\n$$\n\n- If $|5x-12|=-(5x-12),$ we obtain:\n\n$$\n\\begin{aligned}|5x-12| & =3 \\\\ -(5x-12) & =3 \\\\ -5x+12 & =3 \\\\ -5x & =-9 \\\\ \\frac{-5x}{-5} & =\\frac{-9}{-5} \\\\ x & =\\frac{9}{5}\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\frac{9}{5}$ and $x=3.$"} :step/id #uuid "e83a3e23-66a2-56f7-b2eb-d3f3cc24ff4f" :step/next {:db/id #edb/ref 17592186492975}}] :activity/title "Absolute Value Equations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186492222}] [{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186079531} :activity/id #uuid "2828ce66-5563-59d5-8c3e-194de1b4bc11" :activity/scope {:db/id #edb/ref 17592186048760 :topic/id #uuid "bc360b9e-12dd-5337-833b-984ed3eed6ff" :topic/math-academy-id 651} :activity/steps [{:db/id #edb/ref 17592186079531 :step/content {:db/id #edb/ref 17592186079717 :tutorial/content "Whenever we have a fraction in an equation, we apply the multiplication principle to get rid of it. For example, consider the equation below:\n\n$$\n\\dfrac{2x+12}{3} =6\n$$\n\nSince the opposite of dividing by $3$ is multiplying by $3$, we apply the multiplication principle and multiply both sides of the equation by $3$:\n\n$$\n\\require{cancel}\n\t\\eqalign{\n\t\t\\dfrac{2x+12}{3} &=6\\\n\t\t3 \\cdot \\left(\\dfrac{2x+12}{3}\\right) &= 3 \\cdot 6\\\t\n\t\t\\cancel{3} \\cdot \\left(\\dfrac{2x+12}{\\cancel{3}}\\right) &= 18 \\\t\n\t\t2x+12 &= 18\n\t}\n$$\n\nThe process of removing the fraction is called **clearing the rational expression**. We now have an equation that we can solve using the usual methods:\n\n$$\n\\eqalign{\n\t\t2x+12 &= 18\\\n\t\t2x+12-12 &=18-12 \\   \n\t\t2x &=6 \\   \n\t\t\\dfrac{2x}{2} &=\\dfrac{6}{2} \\\n\t\tx &=3\n\t}\n$$" :tutorial/id #uuid "addac451-9882-5c9f-8aa9-adc3fbd177e6" :tutorial/math-academy-id 8050 :tutorial/title "Introduction"} :step/id #uuid "354b4bf1-8360-5dc0-abda-b916470adda6" :step/math-academy-id 52855 :step/next {:db/id #edb/ref 17592186079532}} {:db/id #edb/ref 17592186079532 :step/content {:db/id #edb/ref 17592186078577 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078164 :question/id #uuid "7adb1612-0903-5a50-b5cd-75ebf1d0dd4a" :question/math-academy-id "e-12854"} :knowledge-point/id #uuid "d21b4ce3-d80e-5894-92ce-668e64d91649" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673}] :knowledge-point/questions [{:db/id #edb/ref 17592186078865} {:db/id #edb/ref 17592186078915} {:db/id #edb/ref 17592186487304} {:db/id #edb/ref 17592186487358}] :knowledge-point/title "Clearing a Rational Expression With a Variable on One Side"} :step/id #uuid "7b71965b-0dae-52f0-a849-f9e2309d6ddf" :step/math-academy-id 52856 :step/next {:db/id #edb/ref 17592186079533}} {:db/id #edb/ref 17592186079533 :step/content {:db/id #edb/ref 17592186078578 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078165 :question/id #uuid "c176f07d-e4ee-5f8a-8b7c-7b1c62898bd8" :question/math-academy-id "e-12855"} :knowledge-point/id #uuid "d31a29c9-e053-557b-8f5a-3dd49b340144" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048213}] :knowledge-point/questions [{:db/id #edb/ref 17592186078918} {:db/id #edb/ref 17592186079136} {:db/id #edb/ref 17592186487314} {:db/id #edb/ref 17592186487341} {:db/id #edb/ref 17592186487348} {:db/id #edb/ref 17592186496333}] :knowledge-point/title "Clearing a Rational Expression With a Variable on Both Sides"} :step/id #uuid "bd68dd5d-809b-5311-add4-86314ea0eb08" :step/math-academy-id 52859 :step/next {:db/id #edb/ref 17592186079534}} {:db/id #edb/ref 17592186079534 :step/content {:db/id #edb/ref 17592186078579 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078166 :question/id #uuid "31f9d893-26fd-5b2e-9730-57c5e6cc0615" :question/math-academy-id "e-12857"} :knowledge-point/id #uuid "f9d60309-32e0-535d-b5fa-ef55787336c8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050908}] :knowledge-point/questions [{:db/id #edb/ref 17592186078863} {:db/id #edb/ref 17592186079137} {:db/id #edb/ref 17592186487309} {:db/id #edb/ref 17592186487331} {:db/id #edb/ref 17592186496271} {:db/id #edb/ref 17592186496277}] :knowledge-point/title "Clearing a Rational Expression With Binomials on Both Sides"} :step/id #uuid "a52df58b-60ee-552e-9c9c-b36e2f232a47" :step/math-academy-id 52862 :step/next {:db/id #edb/ref 17592186079535}} {:db/id #edb/ref 17592186079535 :step/content {:db/id #edb/ref 17592186078580 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078167 :question/id #uuid "de18238b-ec8a-525d-b886-b869aa736d56" :question/math-academy-id "e-12858"} :knowledge-point/id #uuid "9f22f7b2-16a9-5742-9bef-c26d774c85de" :knowledge-point/questions [{:db/id #edb/ref 17592186078862} {:db/id #edb/ref 17592186079138} {:db/id #edb/ref 17592186487340} {:db/id #edb/ref 17592186487373} {:db/id #edb/ref 17592186496249}] :knowledge-point/title "Clearing a Rational Expression That Includes a Factored Expression"} :step/id #uuid "9eb577ed-c7b6-51c4-bfa2-a112f328da1b" :step/math-academy-id 52865}] :activity/title "Solving Linear Equations by Clearing a Rational Expression" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078673}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186496358} :activity/id #uuid "d553d002-0e4d-5513-9db5-e6d5e807e0c2" :activity/scope {:db/id #edb/ref 17592186048760 :topic/id #uuid "bc360b9e-12dd-5337-833b-984ed3eed6ff" :topic/math-academy-id 651} :activity/steps [{:db/id #edb/ref 17592186496350 :step/content {:db/id #edb/ref 17592186078918 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d10803c-dc1c-51df-b6d9-3387aaeb47cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{5}" :db/id #edb/ref 17592186495650} {:answer/id #uuid "53f63b04-ee5f-56b2-8bfc-7edc1aa13c63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=5" :db/id #edb/ref 17592186495700} {:answer/id #uuid "5c693399-2537-5d16-bc08-d75a0b068d68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2" :db/id #edb/ref 17592186495722} {:answer/id #uuid "698c317a-d46e-576c-8db8-e08affaa9755" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{6}" :db/id #edb/ref 17592186495744} {:answer/id #uuid "ed96295d-5ba0-5de6-8e42-1e7af9fedd21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{2}" :db/id #edb/ref 17592186496031}] :answer-field/correct {:db/id #edb/ref 17592186496031} :answer-field/id #uuid "77ddb2f4-a245-56c0-8428-a28384aa5396" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186076286}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "15d287cc-b41b-5ff3-a7dc-97c2e50422d7" :question/math-academy-id "q-44320" :question/problem "Solve the equation $\\frac{8y+5}{3}=6y.$" :question/worked-solution "First, we clear the rational expression by multiplying the equation through by $3$:\n\n$$\n\\begin{aligned}\\frac{8y+5}{3} & =6y \\\\ 3(\\frac{8y+5}{3}) & =3\\cdot 6y \\\\ \\cancel{3}\\cdot (\\frac{8y+5}{\\cancel{3}}) & =18y \\\\ 8y+5 & =18y\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}8y+5 & =18y \\\\ 8y+5-8y & =18y-8y \\\\ 5 & =10y \\\\ \\frac{5}{10} & =\\frac{10y}{10} \\\\ \\frac{1}{2} & =y\\end{aligned}\n$$\n\nThus, $y=\\frac{1}{2}.$"} :step/id #uuid "6028f492-ba55-501f-87da-d15709c17c82" :step/next {:db/id #edb/ref 17592186496374}} {:db/id #edb/ref 17592186496357 :step/content {:db/id #edb/ref 17592186496271 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86a95d46-89a3-5b06-8221-b59e68bab013" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h=\\frac{8}{5}" :db/id #edb/ref 17592186495801} {:answer/id #uuid "bfd1647f-a339-5240-b787-f6c0d05abdbb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h=-\\frac{7}{5}" :db/id #edb/ref 17592186495931} {:answer/id #uuid "e273f529-d3a2-5eba-a46e-b61afe82fb5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h=\\frac{6}{5}" :db/id #edb/ref 17592186496011} {:answer/id #uuid "f9adebf3-6330-575d-845f-896e038bb897" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h=2" :db/id #edb/ref 17592186496054} {:answer/id #uuid "f9eecf5b-4431-5988-ac24-8ec51e2c687c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h=-1" :db/id #edb/ref 17592186496057}] :answer-field/correct {:db/id #edb/ref 17592186495801} :answer-field/id #uuid "14966880-3ea7-59e7-a17e-fec0ac900176" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496083}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6bdf897b-5216-5fe0-b918-3faeb980f813" :question/math-academy-id "q-104472" :question/problem "Solve for $h$ where $\\frac{3h-4}{2}=2-h.$" :question/worked-solution "First, we clear the rational expression by multiplying both sides by $2.$ We must make sure that all of the terms on the right-hand side are multiplied by $2:$\n\n$$\n\\begin{aligned}\\frac{3h-4}{2} & =2-h \\\\ 2\\cdot (\\frac{3h-4}{2}) & =2\\cdot (2-h) \\\\ \\cancel{2}\\cdot (\\frac{3h-4}{\\cancel{2}}) & =2\\cdot 2-2\\cdot h \\\\ 3h-4 & =4-2h\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}3h-4 & =4-2h \\\\ 3h-4+2h & =4-2h+2h \\\\ 5h-4 & =4 \\\\ 5h-4+4 & =4+4 \\\\ 5h & =8 \\\\ \\frac{5h}{5} & =\\frac{8}{5} \\\\ h & =\\frac{8}{5}\\end{aligned}\n$$"} :step/id #uuid "7206ffec-4e93-51d5-9045-454b39491a19" :step/next {:db/id #edb/ref 17592186496387}} {:db/id #edb/ref 17592186496358 :step/content {:db/id #edb/ref 17592186496277 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "290bfc84-e444-5079-8d18-8f0f58f4d969" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{11}{25}" :db/id #edb/ref 17592186495600} {:answer/id #uuid "37c0081c-72ea-53b5-830f-01d721471189" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{22}{45}" :db/id #edb/ref 17592186495642} {:answer/id #uuid "95839550-f140-5f9e-a1e5-8aa2c82702bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{45}{11}" :db/id #edb/ref 17592186495842} {:answer/id #uuid "aaf85b04-9f5b-52ba-8d31-f3f78566da82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{25}{11}" :db/id #edb/ref 17592186495892} {:answer/id #uuid "b62f4a13-9b15-5386-ab05-2a22a1b14183" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{45}{22}" :db/id #edb/ref 17592186495918}] :answer-field/correct {:db/id #edb/ref 17592186495892} :answer-field/id #uuid "e82146a9-b8b1-5e83-aeec-05796f3d090e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496203}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7e49ab95-b651-5531-ac5c-90e4392b7705" :question/math-academy-id "q-31686" :question/problem "Solve for $x$ where $\\frac{5-x}{3}=7x-15.$" :question/worked-solution "First, we clear the rational expression by multiplying the equation through by $7$:\n\n$$\n\\begin{aligned}\\frac{5-x}{3} & =7x-15 \\\\ 3(\\frac{5-x}{3}) & =3(7x-15) \\\\ \\cancel{3}(\\frac{5-x}{\\cancel{3}}) & =21x-45 \\\\ 5-x & =21x-45\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}5-x & =21x-45 \\\\ 5-x+x & =21x-45+x \\\\ 5 & =22x-45 \\\\ 5+45 & =22x-45+45 \\\\ 50 & =22x \\\\ \\frac{50}{22} & =\\frac{22x}{22} \\\\ \\frac{25}{11} & =\\frac{\\cancel{22}x}{\\cancel{22}} \\\\ x & =\\frac{25}{11}\\end{aligned}\n$$"} :step/id #uuid "799a2f4f-2697-5ff1-b785-172536801285" :step/next {:db/id #edb/ref 17592186496350}} {:db/id #edb/ref 17592186496374 :step/content {:db/id #edb/ref 17592186496333 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fb757b8-2149-526a-af68-c96954680eb4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=-3" :db/id #edb/ref 17592186495548} {:answer/id #uuid "7d66aa7f-6693-5615-970b-c7da91b05cd5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=\\frac{1}{3}" :db/id #edb/ref 17592186495778} {:answer/id #uuid "9c952b49-23cd-5299-ab3b-0fd0ba05087c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=\\frac{1}{6}" :db/id #edb/ref 17592186495857} {:answer/id #uuid "9ee350b8-cb7d-5d53-877e-b380e44154a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=-\\frac{1}{3}" :db/id #edb/ref 17592186495865} {:answer/id #uuid "a4d94021-52b3-52e5-909c-4f0d63cad22c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=-\\frac{1}{6}" :db/id #edb/ref 17592186495880}] :answer-field/correct {:db/id #edb/ref 17592186495865} :answer-field/id #uuid "3de57bae-a1f3-5ae4-b2cb-ef29b2469101" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496099}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fcf291ca-08c9-536b-b233-ba6182878dc7" :question/math-academy-id "q-44329" :question/problem "Solve for $t$ where $-2t=\\frac{4-6t}{9}.$" :question/worked-solution "First, we clear the rational expression by multiplying the equation through by $9$:\n\n$$\n\\begin{aligned}-2t & =\\frac{4-6t}{9} \\\\ \\frac{4-6t}{9} & =-2t \\\\ 9(\\frac{4-6t}{9}) & =9(-2t) \\\\ \\cancel{9}(\\frac{4-6t}{\\cancel{9}}) & =-18t \\\\ 4-6t & =-18t\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}4-6t & =-18t \\\\ 4-6t+6t & =-18t+6t \\\\ 4 & =-12t \\\\ -12t & =4 \\\\ \\frac{-12t}{-12} & =\\frac{4}{-12} \\\\ \\frac{\\cancel{-12}t}{\\cancel{-12}} & =-\\frac{1}{3} \\\\ t & =-\\frac{1}{3}\\end{aligned}\n$$"} :step/id #uuid "aff5c2ca-053d-5601-be33-a76726d11b9c" :step/next {:db/id #edb/ref 17592186496357}} {:db/id #edb/ref 17592186496387 :step/content {:db/id #edb/ref 17592186496249 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2188e8eb-24f6-567f-b4a0-82bd8c14ebf9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{10}{9}" :db/id #edb/ref 17592186495582}] :answer-field/correct {:db/id #edb/ref 17592186495582} :answer-field/id #uuid "28157b7f-c2b1-5be6-a604-5bd03e2ba7ef" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186496092}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "470fa283-2b00-51e0-9a35-7c42b40fff42" :question/math-academy-id "q-171600" :question/problem "If $\\frac{3k-2}{6}=-(k+2),$ then $k=${{field-1}}." :question/worked-solution "First, we clear the rational expression by multiplying the equation through by $6$:\n\n$$\n\\begin{aligned}\\frac{3k-2}{6} & =-(k+2) \\\\ 6\\cdot (\\frac{3k-2}{6}) & =6\\cdot (-(k+2)) \\\\ \\cancel{6}\\cdot (\\frac{3k-2}{\\cancel{6}}) & =-6(k+2) \\\\ 3k-2 & =-6k-12\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}3k-2 & =-6k-12 \\\\ 3k-2+6k & =-6k-12+6k \\\\ 9k-2 & =-12 \\\\ 9k-2+2 & =-12+2 \\\\ 9k & =-10 \\\\ \\frac{9k}{9} & =\\frac{-10}{9} \\\\ k & =-\\frac{10}{9}\\end{aligned}\n$$"} :step/id #uuid "ebdfcf53-3aab-5152-8a64-f64e55ec050a"}] :activity/title "Solving Linear Equations by Clearing a Rational Expression" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186495506}] [{:activity/first-step {:db/id #edb/ref 17592186065236} :activity/id #uuid "ee2f5838-c8a6-5332-932d-ba9cbf1432c8" :activity/scope {:db/id #edb/ref 17592186048928 :topic/id #uuid "ccd0b2ba-3714-5783-a6c4-70021ded19c3" :topic/math-academy-id 370} :activity/steps [{:db/id #edb/ref 17592186065236 :step/content {:db/id #edb/ref 17592186065342 :tutorial/content "Let's remind ourselves of the difference of squares formula:\n\n$$\na^2-b^2 = (a+b)(a-b)\n$$\n\nWe can use this formula to factor the difference of two squared monomials.\n\nFor example, suppose that we want to factor the expression\n\n$$\nx^2 - 4\n$$\n\nThis expression is a difference of squares:\n\n$$\n\\begin{aligned}\nx^{2} - 4 &=  \\\\\n&= x^{2} - 2^{2}\n\\end{aligned}\n$$\n\nSo, we can factor the expression using the difference of squares formula with $a=x$ and $b=2$, as follows:\n\n$$\n\\begin{aligned}\nx^{2} - 4 &=  \\\\\nx^{2} - 2^{2} &=  \\\\\n&= (x + 2)(x - 2)\n\\end{aligned}\n$$" :tutorial/id #uuid "3f50b677-50fc-5584-82de-7ad393d19d72" :tutorial/math-academy-id 1599 :tutorial/title "Introduction"} :step/id #uuid "7189e486-f5a6-5ce7-9803-33bcfde7853b" :step/math-academy-id 4247 :step/next {:db/id #edb/ref 17592186065237}} {:db/id #edb/ref 17592186065237 :step/content {:db/id #edb/ref 17592186064328 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063963 :question/id #uuid "f1636f93-d678-581d-85a7-0ff93023fed9" :question/math-academy-id "e-1336"} :knowledge-point/id #uuid "20900ac7-ad4e-5895-8d95-d66b0e5f7360" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049943}] :knowledge-point/questions [{:db/id #edb/ref 17592186064681} {:db/id #edb/ref 17592186064691} {:db/id #edb/ref 17592186459295} {:db/id #edb/ref 17592186480664} {:db/id #edb/ref 17592186485546} {:db/id #edb/ref 17592186487343} {:db/id #edb/ref 17592186491126} {:db/id #edb/ref 17592186498495}] :knowledge-point/title "Factoring a Difference of Squares"} :step/id #uuid "2eef60d7-4f61-5c7d-9567-f51ed8b11f15" :step/math-academy-id 4251 :step/next {:db/id #edb/ref 17592186065238}} {:db/id #edb/ref 17592186065238 :step/content {:db/id #edb/ref 17592186064329 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063964 :question/id #uuid "ad7944d4-426e-56df-85da-8771d50f7122" :question/math-academy-id "e-1337"} :knowledge-point/id #uuid "7f0b9133-daf8-5f04-8fa1-c8c3210c4487" :knowledge-point/questions [{:db/id #edb/ref 17592186064686} {:db/id #edb/ref 17592186064693}] :knowledge-point/title "Factoring a Difference of Squares with Leading Coefficients"} :step/id #uuid "4a5bc7eb-2f38-57fd-aa79-d756ce9b911a" :step/math-academy-id 4253 :step/next {:db/id #edb/ref 17592186065244}} {:db/id #edb/ref 17592186065244 :step/content {:db/id #edb/ref 17592186064333 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064005 :question/id #uuid "d8b425b2-eb7b-5cef-b85d-56a67a421d6b" :question/math-academy-id "e-1594"} 