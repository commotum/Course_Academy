ue "(4a-9)(4a+9)" :db/id #edb/ref 17592186484992} {:answer/id #uuid "73e7769f-fc92-5de8-8c10-550b71e31703" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2a-3)(2a+3)" :db/id #edb/ref 17592186485066} {:answer/id #uuid "9035e54c-8039-5816-9bcf-cf8e910bf09e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4a+9)(4a+9)" :db/id #edb/ref 17592186485131}] :answer-field/correct {:db/id #edb/ref 17592186484992} :answer-field/id #uuid "ed8d0e1b-a803-5935-b215-5114cd1136b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186062173}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0f566ff8-5109-5c5a-864e-7810af0e53ff" :question/math-academy-id "q-2761" :question/problem "Factor the expression $16{a}^{2}-81.$" :question/worked-solution "First, we write the expression as a difference of squares:\n\n$$\n\\begin{aligned}16{a}^{2}-81 & =(4a)^{2}-{9}^{2}\\end{aligned}\n$$\n\nThen, we factor the expression using the difference of squares formula:\n\n$$\n\\begin{aligned}(4a)^{2}-{9}^{2} & =(4a+9)(4a-9)\\end{aligned}\n$$"} :step/id #uuid "13e0558d-c68a-56fe-97cc-a967ca46bd21" :step/next {:db/id #edb/ref 17592186485625}} {:db/id #edb/ref 17592186485607 :step/content {:db/id #edb/ref 17592186485546 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "206acbc9-87db-578e-b3b2-16b30eb642bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9-x)(9+x)" :db/id #edb/ref 17592186484877} {:answer/id #uuid "39335b45-13f8-58f6-bd9b-9a97b1c75cc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9-x)^{2}" :db/id #edb/ref 17592186484937} {:answer/id #uuid "64dfcde6-8a80-5dd4-b6fd-951b6b011f44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9+x)^{2}" :db/id #edb/ref 17592186485036} {:answer/id #uuid "6faf371b-64f9-55f0-8fd0-2ade74e5df26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x-9)(x+9)" :db/id #edb/ref 17592186485056} {:answer/id #uuid "8e7eccde-081c-5f5d-be03-c306f58839d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(18-x)(18+x)" :db/id #edb/ref 17592186485125}] :answer-field/correct {:db/id #edb/ref 17592186484877} :answer-field/id #uuid "8cab9527-ddd1-529a-ae51-224da9fcc4cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186485423}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7a010f5a-cc94-5c4d-81d2-4c21165ae9ab" :question/math-academy-id "q-44102" :question/problem "$81-{x}^{2}=$" :question/worked-solution "First, we write the expression as a difference of squares:\n\n$$\n81-{x}^{2}={9}^{2}-{x}^{2}\n$$\n\nThen, we factor the expression using the difference of squares formula:\n\n$$\n{9}^{2}-{x}^{2}=(9-x)(9+x)\n$$"} :step/id #uuid "2738148b-cedf-57d8-ae04-d09d72e66898"} {:db/id #edb/ref 17592186485625 :step/content {:db/id #edb/ref 17592186064692 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58d24321-d687-5666-b444-c67333ddf888" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2e-4f)(2e+4f)" :db/id #edb/ref 17592186485017} {:answer/id #uuid "883f814c-6c18-5941-967b-2ebea351df17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2e-4f)(2e-4f)" :db/id #edb/ref 17592186485113} {:answer/id #uuid "a2d7f83e-938d-58ce-b03e-2aa0fbe0f394" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(e-2f)(e+2f)" :db/id #edb/ref 17592186485171} {:answer/id #uuid "b13e591a-bf5d-5ccb-bebd-477bcfb2fa24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2e+4f)(2e+4f)" :db/id #edb/ref 17592186485202} {:answer/id #uuid "fdc225a0-8ce8-5951-977f-0f5267f0a478" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(e-2f)(e-2f)" :db/id #edb/ref 17592186485360}] :answer-field/correct {:db/id #edb/ref 17592186485017} :answer-field/id #uuid "2bdfff3f-3f1d-5467-b903-2b86371c55b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186062209}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0ca5943c-81c0-5244-b701-34175b2232ae" :question/math-academy-id "q-2833" :question/problem "Express $4{e}^{2}-16{f}^{2}$ as a product of two binomials." :question/worked-solution "We factor the expression using the difference of squares formula:\n\n$$\n\\begin{aligned}4{e}^{2}-16{f}^{2} & = \\\\ (2e)^{2}-(4f)^{2} & = \\\\ (2e-4f)(2e+4f) & \\end{aligned}\n$$"} :step/id #uuid "8a3fd681-fb58-5e69-96b1-2127582ffe4f" :step/next {:db/id #edb/ref 17592186485607}}] :activity/title "Factoring Differences of Squares" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186484810}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186111531} :activity/id #uuid "812cb5a9-d9bb-5df5-bcad-60b2e4bca49c" :activity/scope {:db/id #edb/ref 17592186049059 :topic/id #uuid "d690f7fb-8ed3-54e1-86b0-fda3f8281846" :topic/math-academy-id 1457} :activity/steps [{:db/id #edb/ref 17592186111523 :step/content {:db/id #edb/ref 17592186110616 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110506 :question/id #uuid "17173a8a-f28b-5456-8dbb-eb80d6d3cb1c" :question/math-academy-id "e-4713"} :knowledge-point/id #uuid "bd2dc211-25cb-5975-a665-f1f6ffd52488" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048683} {:db/id #edb/ref 17592186049861} {:db/id #edb/ref 17592186050927}] :knowledge-point/questions [{:db/id #edb/ref 17592186111375} {:db/id #edb/ref 17592186111378} {:db/id #edb/ref 17592186234249} {:db/id #edb/ref 17592186486366} {:db/id #edb/ref 17592186486371} {:db/id #edb/ref 17592186486431} {:db/id #edb/ref 17592186502081} {:db/id #edb/ref 17592186502113} {:db/id #edb/ref 17592186502124}] :knowledge-point/title "Combining Various Product and Quotient Rules of Exponents"} :step/id #uuid "e1f34a4c-5543-5841-9a26-631425dd8218" :step/math-academy-id 17217 :step/next {:db/id #edb/ref 17592186111524}} {:db/id #edb/ref 17592186111524 :step/content {:db/id #edb/ref 17592186110617 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110507 :question/id #uuid "f145655c-ed98-578d-b7ab-7b18bfbfa107" :question/math-academy-id "e-4714"} :knowledge-point/id #uuid "aaba81d3-d555-5dc8-a904-f0f7e9520225" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050697}] :knowledge-point/questions [{:db/id #edb/ref 17592186111379} {:db/id #edb/ref 17592186111380} {:db/id #edb/ref 17592186486461}] :knowledge-point/title "Combining the Power Rule of Exponents With Other Rules"} :step/id #uuid "869d7516-5f01-5ae5-8aa5-fa957c225b74" :step/math-academy-id 17218} {:db/id #edb/ref 17592186111525 :step/content {:db/id #edb/ref 17592186110618 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110508 :question/id #uuid "43141ab7-5ebf-5175-a512-e04f6646978d" :question/math-academy-id "e-4752"} :knowledge-point/id #uuid "376ceac4-b0bb-5178-81e9-38e724cceaee" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049081} {:db/id #edb/ref 17592186050668}] :knowledge-point/questions [{:db/id #edb/ref 17592186111376} {:db/id #edb/ref 17592186111377} {:db/id #edb/ref 17592186486360} {:db/id #edb/ref 17592186486448}] :knowledge-point/title "Combining the Product and Quotient Rules of Exponents"} :step/id #uuid "99b9d947-8b7b-5e8a-a9e4-9d2b3a2979a2" :step/math-academy-id 17336 :step/next {:db/id #edb/ref 17592186111523}} {:db/id #edb/ref 17592186111531 :step/content {:db/id #edb/ref 17592186111884 :tutorial/content "Let's recap some of the rules for exponents.\n\n- **Product rule**: to multiply powers of the same base, add the exponents.\n\n- **Quotient rule**: to divide powers of the same base, subtract the exponents.\n\n- **Power rule**: to raise a power to another power, multiply the exponents.\n\n- **Power of product rule**: to raise the product of two numbers to a power, raise each number to that power, and then multiply.\n\n- **Power of quotient rule**: to raise a fraction to a power, raise both the numerator and the denominator to that power.\n\nWe can use a combination of these rules to simplify expressions containing exponents. Let's see an example of this." :tutorial/id #uuid "7c442391-b257-5c16-9fe0-292a45e3c172" :tutorial/math-academy-id 3275 :tutorial/title "Introduction"} :step/id #uuid "8150e1a1-0f41-5dc7-a1db-5e474331d638" :step/math-academy-id 17999 :step/next {:db/id #edb/ref 17592186111525}}] :activity/title "Combining the Rules of Exponents" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110829}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186502198} :activity/id #uuid "890e7c6c-adee-5d25-828e-7834d97d256f" :activity/scope {:db/id #edb/ref 17592186049059 :topic/id #uuid "d690f7fb-8ed3-54e1-86b0-fda3f8281846" :topic/math-academy-id 1457} :activity/steps [{:db/id #edb/ref 17592186502168 :step/content {:db/id #edb/ref 17592186111380 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41468d21-4c10-5a19-948e-44ada7c0a123" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{6}^{3}}{{4}^{6}}" :db/id #edb/ref 17592186501587} {:answer/id #uuid "7eba4019-7fbd-5be5-9b6f-4d896804f8bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6}^{3}\\cdot {4}^{6}" :db/id #edb/ref 17592186501704} {:answer/id #uuid "91298573-6a3f-5b5b-86e7-0b49355cfd98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{{4}^{12}}" :db/id #edb/ref 17592186501742} {:answer/id #uuid "9dbea38b-7606-5fb6-b9c6-c107413a84d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{{4}^{6}}" :db/id #edb/ref 17592186501762} {:answer/id #uuid "d404240e-f93e-5c72-adcb-8512850b4fd1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{6}^{3}}{{4}^{5}}" :db/id #edb/ref 17592186501886}] :answer-field/correct {:db/id #edb/ref 17592186501587} :answer-field/id #uuid "f75d50b2-6f5a-5bce-9e0b-522b9985c2e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186110005}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a4eaff0b-1470-58ee-9066-30ef9be58837" :question/math-academy-id "q-68964" :question/problem "${(\\frac{6}{{4}^{2}})}^{3}=$" :question/worked-solution "First, we apply the power of quotient rule for exponents:\n\n$$\n{(\\frac{6}{{4}^{2}})}^{3}=\\frac{{6}^{3}}{{({4}^{2})}^{3}}\n$$\n\nTo simplify the denominator, we use the power rule for exponents:\n\n$$\n\\begin{aligned}\\frac{{6}^{3}}{{({4}^{2})}^{3}} & =\\frac{{6}^{3}}{{4}^{2\\cdot 3}} \\\\  & =\\frac{{6}^{3}}{{4}^{6}}\\end{aligned}\n$$"} :step/id #uuid "102a9be1-877b-502d-8f9a-b0b5673f06b0" :step/next {:db/id #edb/ref 17592186502173}} {:db/id #edb/ref 17592186502173 :step/content {:db/id #edb/ref 17592186502124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3611b83a-05fd-57c0-964f-6cdb6a750d10" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6}^{8}\\cdot {8}^{8}" :db/id #edb/ref 17592186501565} {:answer/id #uuid "74a93e7b-8e23-5952-a163-17d5bb75323b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6}^{3}\\cdot {8}^{8}" :db/id #edb/ref 17592186501680} {:answer/id #uuid "a8011c4e-cb58-515e-9fe0-ab3c788f1478" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6}^{8}\\cdot {8}^{3}" :db/id #edb/ref 17592186501793} {:answer/id #uuid "cf81bb58-a87f-5a0e-91a5-9f5976da0085" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6}^{2}\\cdot {8}^{3}" :db/id #edb/ref 17592186501878} {:answer/id #uuid "d2f55899-6b14-567d-959e-9963101cb1f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6}^{3}\\cdot {8}^{3}" :db/id #edb/ref 17592186501885}] :answer-field/correct {:db/id #edb/ref 17592186501793} :answer-field/id #uuid "11312e6f-7278-523b-b492-30e222c5f5a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186501980}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8bec425d-e327-5350-ad55-2bf5d8347c9a" :question/math-academy-id "q-100757" :question/problem "${(6\\cdot 8)}^{3}\\cdot {6}^{5}=$" :question/worked-solution "First, we rewrite the second factor using the power of product rule:\n\n$$\n{(6\\cdot 8)}^{3}\\cdot {6}^{5}={6}^{3}\\cdot {8}^{3}\\cdot {6}^{5}\n$$\n\nFinally, we apply the product rule for exponents, and simplify:\n\n$$\n\\begin{aligned}{6}^{3}\\cdot {8}^{3}\\cdot {6}^{5} & ={6}^{3}\\cdot {6}^{5}\\cdot {8}^{3} \\\\  & ={6}^{3+5}\\cdot {8}^{3} \\\\  & ={6}^{8}\\cdot {8}^{3}\\end{aligned}\n$$"} :step/id #uuid "2d32c85e-20d0-5fd2-a609-287a06932ccb"} {:db/id #edb/ref 17592186502179 :step/content {:db/id #edb/ref 17592186502113 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d4c53a1-b239-5b29-8440-f632e3a00d66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{4}\\cdot {3}^{7}" :db/id #edb/ref 17592186501546} {:answer/id #uuid "6fa97fff-f307-512a-a0df-4801533ea472" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\cdot {3}^{2}" :db/id #edb/ref 17592186501671} {:answer/id #uuid "84236fbb-6291-5f93-81e2-cd38a8816289" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{7}\\cdot {3}^{4}" :db/id #edb/ref 17592186501719} {:answer/id #uuid "c6a0ea31-2173-5c5d-9e00-40527e7cf292" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{12}\\cdot {3}^{2}" :db/id #edb/ref 17592186501862} {:answer/id #uuid "fb321c56-57a3-55ec-b817-8c07ac7ecf7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{3}\\cdot {5}^{4}" :db/id #edb/ref 17592186501965}] :answer-field/correct {:db/id #edb/ref 17592186501719} :answer-field/id #uuid "88004d56-effe-5e83-a749-a2b7c08b3fa4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502022}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6ef8e162-2bcb-5b53-83cc-147de68407b1" :question/math-academy-id "q-68952" :question/problem "${2}^{3}\\cdot {(3\\cdot 2)}^{4}=$" :question/worked-solution "First, we rewrite the second factor using the power of product rule:\n\n$$\n{2}^{3}\\cdot {(3\\cdot 2)}^{4}={2}^{3}\\cdot {3}^{4}\\cdot {2}^{4}\n$$\n\nFinally, we apply the product rule for exponents, and simplify:\n\n$$\n\\begin{aligned}{2}^{3}\\cdot {3}^{4}\\cdot {2}^{4} & ={2}^{3}\\cdot {2}^{4}\\cdot {3}^{4} \\\\  & ={2}^{3+4}\\cdot {3}^{4} \\\\  & ={2}^{7}\\cdot {3}^{4}\\end{aligned}\n$$"} :step/id #uuid "49308f5f-8de3-5dbe-bf1a-8b336864e19e" :step/next {:db/id #edb/ref 17592186502168}} {:db/id #edb/ref 17592186502198 :step/content {:db/id #edb/ref 17592186502081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a73b112-23d9-5ce7-b7f6-9cc9b1ea6ba3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{7}\\cdot {3}^{-2}" :db/id #edb/ref 17592186501541} {:answer/id #uuid "5173cabb-209f-59b0-bb30-f3195ff21e04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{7}\\cdot {3}^{3}" :db/id #edb/ref 17592186501614} {:answer/id #uuid "6b8cacfb-384f-5813-911b-4115a5b7ba6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{7}\\cdot {3}^{2}" :db/id #edb/ref 17592186501667} {:answer/id #uuid "8d016a81-6b30-515f-b97d-3efba5f2f640" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{7}\\cdot 3" :db/id #edb/ref 17592186501737} {:answer/id #uuid "f91702ba-eae7-53c8-b6a7-9bd48502b51b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{7}" :db/id #edb/ref 17592186501961}] :answer-field/correct {:db/id #edb/ref 17592186501667} :answer-field/id #uuid "bf72de5c-8edd-59cf-9c2b-dc6c69c9659d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502043}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "22282018-2ca4-523a-8e4c-90a2c94b5770" :question/math-academy-id "q-68493" :question/problem "${(\\frac{2}{3})}^{7}\\cdot {3}^{9}=$" :question/worked-solution "First, we rewrite the first factor using the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{2}{3})}^{7}\\cdot {3}^{9}=\\frac{{2}^{7}}{{3}^{7}}\\cdot {3}^{9}\\end{aligned}\n$$\n\nNext, we rewrite the fractional part of our expression as follows:\n\n$$\n\\frac{{2}^{7}}{{3}^{7}}\\cdot {3}^{9}={2}^{7}\\cdot \\frac{{3}^{9}}{{3}^{7}}\n$$\n\nFinally, we simplify using the quotient rule for exponents:\n\n$$\n{2}^{7}\\cdot \\frac{{3}^{9}}{{3}^{7}}={2}^{7}\\cdot {3}^{9-7}={2}^{7}\\cdot {3}^{2}\n$$"} :step/id #uuid "ad914d59-631f-5b15-8d69-7505a90e3736" :step/next {:db/id #edb/ref 17592186502179}}] :activity/title "Combining the Rules of Exponents" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186501456}] [{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186065162} :activity/id #uuid "0c7c191d-53bd-5ae5-94c5-4eed4a0e0009" :activity/scope {:db/id #edb/ref 17592186049500 :topic/id #uuid "f967432c-0e8a-553d-8497-053cde92d843" :topic/math-academy-id 361} :activity/steps [{:db/id #edb/ref 17592186065162 :step/content {:db/id #edb/ref 17592186065375 :tutorial/content "To multiply a binomial and a trinomial, we take each term of the binomial and multiply it by every term in the trinomial. Then, we simplify by collecting like terms.\n\nFor example, to multiply $({\\color{blue}{x}} + {\\color{red}{3}})$ and $(x^2 + 2x+4),$ we multiply ${\\color{blue}{x}}$ and $(x^2 + 2x+4),$ and then we add this to the product of ${\\color{red}{3}}$ and $(x^2 + 2x+4).$ \n\n$$\n\\begin{aligned}(x+3)({x}^{2}+2x+4) & = \\\\ x({x}^{2}+2x+4)+3({x}^{2}+2x+4) & = \\\\ {x}^{3}+2{x}^{2}+4x+3{x}^{2}+6x+12\\end{aligned}\n$$\n\nThen, we group the like terms and simplify:\n\n$$\n\\begin{aligned}{x}^{3}+2{x}^{2}+4x+3{x}^{2}+6x+12 & = \\\\ {x}^{3}+2{x}^{2}+3{x}^{2}+4x+6x+12 & = \\\\ {x}^{3}+5{x}^{2}+10x+12\\end{aligned}\n$$" :tutorial/id #uuid "abdf5593-94a7-5f4c-a2ec-ca378d5b0034" :tutorial/math-academy-id 4089 :tutorial/title "Introduction"} :step/id #uuid "1805ec56-b520-54eb-bdc6-f80e213e4e8e" :step/math-academy-id 24547 :step/next {:db/id #edb/ref 17592186065163}} {:db/id #edb/ref 17592186065163 :step/content {:db/id #edb/ref 17592186064276 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064119 :question/id #uuid "5aa1e9b2-a6d3-507d-8530-9cbba2fc2162" :question/math-academy-id "e-6707"} :knowledge-point/id #uuid "43f97f24-06a1-50cc-9c73-48bc491c632f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050818}] :knowledge-point/questions [{:db/id #edb/ref 17592186064957} {:db/id #edb/ref 17592186064958} {:db/id #edb/ref 17592186233791} {:db/id #edb/ref 17592186234404} {:db/id #edb/ref 17592186483405}] :knowledge-point/title "Multiplying a Binomial and a Quadratic Trinomial"} :step/id #uuid "3ba36e49-21df-5a7b-a5eb-2a39da5e23fa" :step/math-academy-id 24548 :step/next {:db/id #edb/ref 17592186065164}} {:db/id #edb/ref 17592186065164 :step/content {:db/id #edb/ref 17592186064277 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064120 :question/id #uuid "55f28c00-cfe7-507e-830f-f7d993d16687" :question/math-academy-id "e-6710"} :knowledge-point/id #uuid "f7019d52-33a1-5968-9a93-2f2f06fbb0d6" :knowledge-point/questions [{:db/id #edb/ref 17592186064677} {:db/id #edb/ref 17592186064959} {:db/id #edb/ref 17592186233141} {:db/id #edb/ref 17592186234405} {:db/id #edb/ref 17592186483417} {:db/id #edb/ref 17592186483427} {:db/id #edb/ref 17592186493900} {:db/id #edb/ref 17592186493963}] :knowledge-point/title "Multiplying Trinomials"} :step/id #uuid "28e7da43-48d0-58cf-b2d4-a4737212e95c" :step/math-academy-id 24563 :step/next {:db/id #edb/ref 17592186065165}} {:db/id #edb/ref 17592186065165 :step/content {:db/id #edb/ref 17592186064278 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064121 :question/id #uuid "9e77dab4-4e8b-51df-a070-1a42fcdbf212" :question/math-academy-id "e-6711"} :knowledge-point/id #uuid "09357892-5d4b-5346-99b0-9babc7b0d574" :knowledge-point/questions [{:db/id #edb/ref 17592186064736} {:db/id #edb/ref 17592186064737} {:db/id #edb/ref 17592186233706} {:db/id #edb/ref 17592186233790} {:db/id #edb/ref 17592186483375} {:db/id #edb/ref 17592186483394}] :knowledge-point/title "Multiplying Binomials and Trinomials Containing More Than One Variable"} :step/id #uuid "09d4e779-1be2-5451-af22-a6a22455d666" :step/math-academy-id 24564}] :activity/title "Multiplying Polynomials" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064448}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186493976} :activity/id #uuid "7d34f865-13dc-53b8-9562-0158bac35795" :activity/scope {:db/id #edb/ref 17592186049500 :topic/id #uuid "f967432c-0e8a-553d-8497-053cde92d843" :topic/math-academy-id 361} :activity/steps [{:db/id #edb/ref 17592186493976 :step/content {:db/id #edb/ref 17592186064736 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a73230d7-2608-5fda-9bd9-d380d1b68a15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186062474} {:answer/id #uuid "1b5c7bcc-d988-51a2-9faf-29f8684be33d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-15" :db/id #edb/ref 17592186062475} {:answer/id #uuid "51aa5b57-b075-512f-8ab1-4f61456e288d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186062476} {:answer/id #uuid "54e07f76-634a-50b0-88d5-295949f8771b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186062477} {:answer/id #uuid "62156e2a-34ce-55e9-88d2-edcd5c90f59d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186062478}] :answer-field/correct {:db/id #edb/ref 17592186062477} :answer-field/id #uuid "13a25c94-9e58-52b2-9281-07182838de44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186062473}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aa8dfac6-2e07-5a12-91bc-c7ca479ccc66" :question/math-academy-id "q-31382" :question/problem "What is the coefficient of ${x}^{2}y$ in the product $(x-y)({x}^{2}+6xy-9{y}^{2})?$" :question/worked-solution "We distribute all three terms of the binomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(x-y)({x}^{2}+6xy-9{y}^{2}) & = \\\\ x({x}^{2}+6xy-9{y}^{2})+(-y)({x}^{2}+6xy-9{y}^{2}) & = \\\\ {x}^{3}+6{x}^{2}y-9x{y}^{2}-{x}^{2}y-6x{y}^{2}+9{y}^{3} & = \\\\ {x}^{3}+5{x}^{2}y-15x{y}^{2}+9{y}^{3}\\end{aligned}\n$$\n\nTherefore, the coefficient of ${x}^{2}y$ is $5.$"} :step/id #uuid "01cd63b9-1bc2-5c63-877d-2c84f5a29f2f" :step/next {:db/id #edb/ref 17592186494043}} {:db/id #edb/ref 17592186494038 :step/content {:db/id #edb/ref 17592186493900 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6186a0e8-15ad-5f04-9514-03a897bd46d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186493536} {:answer/id #uuid "79daec01-1bd7-52c2-9729-762b7fa0a1f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186493575} {:answer/id #uuid "7bcf2e2e-64a8-5b8a-80c5-fd2e2740d5d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186493579} {:answer/id #uuid "89b4a778-8744-54f1-9b64-0291ebefd5aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186493606} {:answer/id #uuid "db0402ea-ca02-5133-8b2b-0f9106ee55f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186493735}] :answer-field/correct {:db/id #edb/ref 17592186493536} :answer-field/id #uuid "fb22af84-6e18-5551-a3f1-bbcb3eb8cfb6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493889}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "222f2e72-f895-5b79-8f06-000077812dd5" :question/math-academy-id "q-78171" :question/problem "Given that  $({t}^{2}+t+2)({t}^{2}+2t+1)={t}^{4}+a{t}^{3}+b{t}^{2}+ct+2,$ calculate $a+b+c.$" :question/worked-solution "We distribute all three terms of the trinomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}({t}^{2}+t+2)({t}^{2}+2t+1) & = \\\\ {t}^{2}({t}^{2}+2t+1)+t({t}^{2}+2t+1)+2({t}^{2}+2t+1) & = \\\\ {t}^{4}+2{t}^{3}+{t}^{2}+{t}^{3}+2{t}^{2}+t+2{t}^{2}+4t+2 & = \\\\ {t}^{4}+3{t}^{3}+5{t}^{2}+5t+2 & \\end{aligned}\n$$\n\nTherefore, $a=3,$ $b=5,$ and $c=5.$ So, \n\n$$\na+b+c=3+5+5=13.\n$$"} :step/id #uuid "97cc7e1e-8c02-52bb-8813-52ea962add8a"} {:db/id #edb/ref 17592186494043 :step/content {:db/id #edb/ref 17592186493963 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1509f49e-da21-5888-a3e2-156f6abd8874" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186493429} {:answer/id #uuid "39d6163e-8a28-5dea-acdf-43f43b916822" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186493487} {:answer/id #uuid "45f89047-5bab-5a07-8abc-c0436c6ee8a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186493509} {:answer/id #uuid "e27c97bd-9bdc-5a82-9295-1903f7e28d23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186493750} {:answer/id #uuid "e8b629bc-bc84-51ab-bcdf-5cf5e9435232" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186493763}] :answer-field/correct {:db/id #edb/ref 17592186493750} :answer-field/id #uuid "d4c94381-cca8-57b8-bdf5-3cd85a1f90d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493877}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d9aae8a4-653e-5752-9c3b-a882c899846f" :question/math-academy-id "q-78170" :question/problem "Given that  $({p}^{2}+p+1)({p}^{2}+3p+1)={p}^{4}+a{p}^{3}+b{p}^{2}+cp+1,$ calculate $a+b+c.$" :question/worked-solution "We distribute all three terms of the trinomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}({p}^{2}+p+1)({p}^{2}+3p+1) & = \\\\ {p}^{2}({p}^{2}+3p+1)+p({p}^{2}+3p+1)+1({p}^{2}+3p+1) & = \\\\ {p}^{4}+3{p}^{3}+{p}^{2}+{p}^{3}+3{p}^{2}+p+{p}^{2}+3p+1 & = \\\\ {p}^{4}+4{p}^{3}+5{p}^{2}+4p+1\\end{aligned}\n$$\n\nTherefore, $a=4,$ $b=5,$ and $c=4.$ So, \n\n$$\na+b+c=4+5+4=13.\n$$"} :step/id #uuid "9f30599b-eb03-56eb-8b41-df7c06969977" :step/next {:db/id #edb/ref 17592186494038}}] :activity/title "Multiplying Polynomials" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186493378}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074751} :activity/id #uuid "17691de4-8d73-56a0-9388-fcd801f22dd1" :activity/scope {:db/id #edb/ref 17592186050341 :topic/id #uuid "4116a9b1-1ae1-5c46-ab2a-fcbda7bb3a26" :topic/math-academy-id 484} :activity/steps [{:db/id #edb/ref 17592186074725 :step/content {:db/id #edb/ref 17592186073788 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073663 :question/id #uuid "e5202e06-b6a8-5d74-a395-fe7c56b8e9bb" :question/math-academy-id "e-9728"} :knowledge-point/id #uuid "1a31c2b6-585a-5715-98f8-4b82605f4c22" :knowledge-point/questions [{:db/id #edb/ref 17592186074003} {:db/id #edb/ref 17592186074004} {:db/id #edb/ref 17592186233430} {:db/id #edb/ref 17592186485534} {:db/id #edb/ref 17592186485537}] :knowledge-point/title "Simplifying Expressions Containing Cube Roots"} :step/id #uuid "74aa14ec-4817-573b-816c-aa9e7cef4458" :step/math-academy-id 36487} {:db/id #edb/ref 17592186074726 :step/content {:db/id #edb/ref 17592186073789 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073664 :question/id #uuid "c1f1d037-45a6-5e72-a735-0c0512290120" :question/math-academy-id "e-9729"} :knowledge-point/id #uuid "622cd109-3764-5f32-8205-046be4b57c54" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049923}] :knowledge-point/questions [{:db/id #edb/ref 17592186074001} {:db/id #edb/ref 17592186074002} {:db/id #edb/ref 17592186485544} {:db/id #edb/ref 17592186485566}] :knowledge-point/title "Simplifying Square Root Expressions Using the Product Rule for Radicals"} :step/id #uuid "b782d57f-6faa-597a-9408-0b6fc960adfb" :step/math-academy-id 36491 :step/next {:db/id #edb/ref 17592186074728}} {:db/id #edb/ref 17592186074727 :step/content {:db/id #edb/ref 17592186075012 :tutorial/content "Recall that the product rule for radicals states that\n\n$$\n\\sqrt{a\\cdot b} = \\sqrt{a}\\cdot \\sqrt{b}\n$$\n\nwhere $a$ and $b$ are nonnegative numbers. \n\nWe can use the product rule for radicals to simplify some expressions. Let's see an example." :tutorial/id #uuid "4af2af2e-0f81-5094-adf6-2ede72a493d2" :tutorial/math-academy-id 5995 :tutorial/title "The Product Rule for Radicals"} :step/id #uuid "d050b8f3-0cc1-593c-8200-076f5b4f824f" :step/math-academy-id 36619 :step/next {:db/id #edb/ref 17592186074726}} {:db/id #edb/ref 17592186074728 :step/content {:db/id #edb/ref 17592186075013 :tutorial/content "We can simplify cube root expressions in the same way as with square roots.\n\nFor example, consider the following expression:\n\n$$\n4\\sqrt[3]2 - 6\\sqrt[3] 2\n$$\n\nWe can simplify our expression by combining the two radicals, as follows:\n\n$$\n\\begin{aligned}4\\sqrt[3]{2}-6\\sqrt[3]{2} & = \\\\ (4-6)\\sqrt[3]{2} & = \\\\ -2\\sqrt[3]{2} & \\end{aligned}\n$$\n\n \n\nAs with square roots, we *cannot* combine terms when the numbers under the radical are different. For example, the expression\n\n$$\n3\\sqrt[3] 2 + \\sqrt[3] 5\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt[3] 2$ and $\\sqrt[3] 5.$\n\nFinally, it is not possible to combine square root and cube root terms -- not even if the numbers under the radical symbol are the same! For example, the expression\n\n$$\n4\\sqrt 2 + \\sqrt[3] 2\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt 2$ and $\\sqrt[3] 2.$" :tutorial/id #uuid "32078f96-6eaf-57d2-bc71-8af8495d5d6f" :tutorial/math-academy-id 5996 :tutorial/title "Simplifying Expressions With Cube Roots"} :step/id #uuid "f9fded71-c2d5-5d66-9f13-5b0253efd6ff" :step/math-academy-id 36620 :step/next {:db/id #edb/ref 17592186074725}} {:db/id #edb/ref 17592186074751 :step/content {:db/id #edb/ref 17592186074948 :tutorial/content "When dealing with sums of square roots, we can combine any terms with the same number under the square root symbol $\\sqrt{\\phantom 0}.$\n\nFor example, consider the following expression:\n\n$$\n2\\sqrt 5 + 4\\sqrt 5\n$$\n\nRemember that $2\\sqrt 5$ and $4\\sqrt 5$ mean $2\\cdot\\sqrt 5$ and $4\\cdot\\sqrt 5,$ respectively. \n\nWe can simplify our expression by combining the two radicals, as follows:\n\n$$\n\\begin{aligned}2\\sqrt{5}+4\\sqrt{5} & = \\\\ (2+4)\\sqrt{5} & = \\\\ 6\\sqrt{5} & \\end{aligned}\n$$\n\n \n\nSimilarly,\n\n$$\n\\begin{aligned}2\\sqrt{7}-\\sqrt{7} & = \\\\ 2\\sqrt{7}-1\\cdot \\sqrt{7} & = \\\\ (2-1)\\sqrt{7} & = \\\\ 1\\cdot \\sqrt{7} & = \\\\ \\sqrt{7}. & \\end{aligned}\n$$\n\n \n\nHowever, we *cannot* combine terms when the numbers under the radical are different. For example, the expression\n\n$$\n2\\sqrt 3 + \\sqrt 5\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt 3$ and $\\sqrt 5.$" :tutorial/id #uuid "9aa49408-30d5-57b5-8dff-ec1744f9fc6e" :tutorial/math-academy-id 1609 :tutorial/title "Introduction"} :step/id #uuid "38f3ace0-f394-598e-8dad-37fefda9d86e" :step/math-academy-id 4327 :step/next {:db/id #edb/ref 17592186074752}} {:db/id #edb/ref 17592186074752 :step/content {:db/id #edb/ref 17592186073806 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073464 :question/id #uuid "cf793c45-6c89-50c8-bb28-d066d2b8342a" :question/math-academy-id "e-1370"} :knowledge-point/id #uuid "2d8a8280-5248-57e4-a5ed-14e281f3db77" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050404}] :knowledge-point/questions [{:db/id #edb/ref 17592186074147} {:db/id #edb/ref 17592186074186} {:db/id #edb/ref 17592186485495} {:db/id #edb/ref 17592186485554}] :knowledge-point/title "Simplifying Square Root Expressions"} :step/id #uuid "459089fc-d278-5487-bc0b-e4cd6237c142" :step/math-academy-id 4328 :step/next {:db/id #edb/ref 17592186074727}}] :activity/title "Adding and Subtracting Radicals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073921}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186069704} :activity/id #uuid "5d42bb12-b3dd-51d8-b182-d11c5610f66c" :activity/scope {:db/id #edb/ref 17592186050361 :topic/id #uuid "42d6df97-82bc-5c46-b6ad-8dc1bac71005" :topic/math-academy-id 387} :activity/steps [{:db/id #edb/ref 17592186069701 :step/content {:db/id #edb/ref 17592186068782 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068624 :question/id #uuid "bd57c7f2-87b5-55a0-9237-1ef814f59898" :question/math-academy-id "e-6136"} :knowledge-point/id #uuid "a0e5b503-a393-58ef-bbcd-5c6d65257f53" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050127} {:db/id #edb/ref 17592186050519}] :knowledge-point/questions [{:db/id #edb/ref 17592186069463} {:db/id #edb/ref 17592186069466} {:db/id #edb/ref 17592186484205} {:db/id #edb/ref 17592186484237} {:db/id #edb/ref 17592186484269}] :knowledge-point/title "Identifying Values that Satisfy a Given Inequality"} :step/id #uuid "7a12041b-cf05-5ef7-861a-4a41e851ccce" :step/math-academy-id 22846 :step/next {:db/id #edb/ref 17592186069705}} {:db/id #edb/ref 17592186069702 :step/content {:db/id #edb/ref 17592186068783 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068625 :question/id #uuid "74587421-d1ad-550e-a30d-4d4768588d4f" :question/math-academy-id "e-6137"} :knowledge-point/id #uuid "09fdde75-121e-5378-bad1-1ab564375d41" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049051}] :knowledge-point/questions [{:db/id #edb/ref 17592186069470} {:db/id #edb/ref 17592186069471} {:db/id #edb/ref 17592186484222}] :knowledge-point/title "Identifying Values that Satisfy a Given Compound Inequality"} :step/id #uuid "6e5127b1-8f72-5af1-9af8-0a68620f1c8f" :step/math-academy-id 22847 :step/next {:db/id #edb/ref 17592186069703}} {:db/id #edb/ref 17592186069703 :step/content {:db/id #edb/ref 17592186068784 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068626 :question/id #uuid "fb564b00-2d04-556a-a662-7b92e21ec3d3" :question/math-academy-id "e-6138"} :knowledge-point/id #uuid "cd07be8d-2eba-5e4e-ba42-72470fd12120" :knowledge-point/questions [{:db/id #edb/ref 17592186069472} {:db/id #edb/ref 17592186069512} {:db/id #edb/ref 17592186484221} {:db/id #edb/ref 17592186484268} {:db/id #edb/ref 17592186484274} {:db/id #edb/ref 17592186484290}] :knowledge-point/title "Identifying Inequalities that are Satisfied by a Given Value"} :step/id #uuid "d2c8d513-b9f7-5e4d-b550-a588fb3a8ef1" :step/math-academy-id 22848} {:db/id #edb/ref 17592186069704 :step/content {:db/id #edb/ref 17592186069979 :tutorial/content "We can find which values satisfy an inequality by trial and error, which involves substituting a number for the variable and checking to see if we get a true statement.\n\nFor example, which of the following values of $y$ satisfy the inequality $y - 1 > 3\\,?$\n\nI. $y=6$\n\nII. $y=2$\n\nIII. $y=3$\n\nLet's go through the possibilities one at a time.\n\n- Substituting the value ${\\color{blue}y}={\\color{blue}6}$ into the given equation, we get:\n\n$$\n\\begin{aligned}y-1 & >3 \\\\ 6-1 & >3 \\\\ 5 & >3\\,✓\\end{aligned}\n$$\n\nThis is a **true** statement, so $y=6$ **satisfies** this inequality.\n\n- Substituting the value ${\\color{blue}y}={\\color{blue}2}$ into the given equation, we get:\n\n$$\n\\begin{aligned}y-1 & >3 \\\\ 2-1 & >3 \\\\ 1 & >3\\,\\times \\end{aligned}\n$$\n\nThis is a **false** statement, so $y=2$ **does not satisfy** this inequality.\n\n- Substituting the value ${\\color{blue}y}={\\color{blue}3}$ into the given equation, we get:\n\n$$\n\\begin{aligned}y-1 & >3 \\\\ 3-1 & >3 \\\\ 2 & >3\\,\\times \\end{aligned}\n$$\n\nThis is a **false** statement, so $y=3$ **does not satisfy** this inequality.\n\nTherefore, only I satisfies the inequality." :tutorial/id #uuid "c8259a9f-33bd-5c3f-9005-695f9474fbab" :tutorial/math-academy-id 3879 :tutorial/title "Introduction"} :step/id #uuid "d80f89b1-82f3-5c21-ae3e-13d7fbef2b51" :step/math-academy-id 22849 :step/next {:db/id #edb/ref 17592186069701}} {:db/id #edb/ref 17592186069705 :step/content {:db/id #edb/ref 17592186068785 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068627 :question/id #uuid "73bc0b43-f3a9-5a4b-a49f-833cdf1f493f" :question/math-academy-id "e-6139"} :knowledge-point/id #uuid "9c472f18-da99-5969-acdf-1a7b53465494" :knowledge-point/questions [{:db/id #edb/ref 17592186069462} {:db/id #edb/ref 17592186069465} {:db/id #edb/ref 17592186484216} {:db/id #edb/ref 17592186484242} {:db/id #edb/ref 17592186544801}] :knowledge-point/title "Identifying Values that Satisfy a Given Inequality with Fractions"} :step/id #uuid "a64fa200-0d99-5bad-916e-7cbe9afb1166" :step/math-academy-id 22850 :step/next {:db/id #edb/ref 17592186069702}}] :activity/title "Verifying Solutions of Linear Inequalities" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068934}] [{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186230113} :activity/id #uuid "72a697c0-6ee2-52bc-82b4-b77c00f05069" :activity/scope {:db/id #edb/ref 17592186050625 :topic/id #uuid "59db5455-7d67-57c4-8cb4-9c457475eed5" :topic/math-academy-id 6642} :activity/steps [{:db/id #edb/ref 17592186230113 :step/content {:db/id #edb/ref 17592186230167 :tutorial/content "In many real-world situations, such as in retail or finance, it is necessary to apply multiple percentages in succession.\n\nTo do so, we perform one percentage calculation and then apply another percentage to the *result* of the previous calculation.\nThis means each new percentage is based on a *new amount*, not on the original number.\n\nTo demonstrate, let's find $40\\%$ of $150,$ and then $25\\%$ of the result.\n\nFirst, we find $40\\%$ of $150{:}$\n\n$$\n\\begin{aligned}40%\\times 150 & =\\frac{40}{100}\\times 150 \\\\  & =0.4\\times 150 \\\\  & =60\\end{aligned}\n$$\n\nSo, after the first step, the result is $60.$\nThen, we find $25\\%$ of the result:\n\n$$\n\\begin{aligned}25%\\times 60 & =\\frac{25}{100}\\times 60 \\\\  & =0.25\\times 60 \\\\  & =15\\end{aligned}\n$$\n\nTherefore, after applying both percentages in succession, the final answer is $15.$" :tutorial/id #uuid "81602213-1c20-5c8a-86ba-be4dd5c94554" :tutorial/math-academy-id 14335 :tutorial/title "Introduction"} :step/id #uuid "6e6a90ca-fd31-5cbd-a1b4-0385b456029a" :step/math-academy-id 615754 :step/next {:db/id #edb/ref 17592186230114}} {:db/id #edb/ref 17592186230114 :step/content {:db/id #edb/ref 17592186229193 :knowledge-point/canonical-example {:db/id #edb/ref 17592186228884 :question/id #uuid "91ca6940-1bc7-583b-8bac-81d7da934167" :question/math-academy-id "e-21463"} :knowledge-point/id #uuid "ec0d62dd-5b51-5286-b382-776412570561" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050030} {:db/id #edb/ref 17592186050716}] :knowledge-point/questions [{:db/id #edb/ref 17592186229608} {:db/id #edb/ref 17592186229612} {:db/id #edb/ref 17592186486434} {:db/id #edb/ref 17592186486452}] :knowledge-point/title "Applying Subsequent Percentages"} :step/id #uuid "b793c54c-3bb6-5cc0-a0c0-48969b4d982c" :step/math-academy-id 615756 :step/next {:db/id #edb/ref 17592186230115}} {:db/id #edb/ref 17592186230115 :step/content {:db/id #edb/ref 17592186229194 :knowledge-point/canonical-example {:db/id #edb/ref 17592186228882 :question/id #uuid "97d0ab51-97cd-5781-be30-4d70adc5d214" :question/math-academy-id "e-21458"} :knowledge-point/id #uuid "3852a0f9-f1ac-5a3f-9883-8dd2ee03e332" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049467}] :knowledge-point/questions [{:db/id #edb/ref 17592186229609} {:db/id #edb/ref 17592186229617} {:db/id #edb/ref 17592186486368} {:db/id #edb/ref 17592186486404} {:db/id #edb/ref 17592186489176} {:db/id #edb/ref 17592186489268}] :knowledge-point/title "Applying Subsequent Percentages in Real-World Situations"} :step/id #uuid "c03e2806-a10c-543b-9b5f-7884c7db45f1" :step/math-academy-id 615760 :step/next {:db/id #edb/ref 17592186230116}} {:db/id #edb/ref 17592186230116 :step/content {:db/id #edb/ref 17592186230171 :tutorial/content "When percentages are applied in succession, it is useful to represent their combined effect as a single percentage of the original amount. \n\nThis means that, instead of applying one percentage and then another, we can multiply their decimal multipliers to find an overall multiplier (or percentage) for the total change. \n\nFor example, suppose that a city’s library membership rose to $150\\%$ of the previous year’s total. Of these members, $40\\%$ borrowed digital books. What percentage of last year’s members borrowed digital books?\n\nFirst, let $x$ be the number of members in the previous year.\n\nWe're told that membership rose to $150\\%$ of the previous year’s total. Thus, the new number of members is \n\n$$\n1.5x.\n$$\n\nWe are also told that of those members, $40\\%$ borrowed digital books. So, the number of members who borrowed digital books is\n\n$$\n0.4(1.5x) = 0.6x.\n$$\n\nThe expression $0.6x$ represents $60\\%$ of $x.$ Therefore, $60\\%$ of last year’s members borrowed digital books." :tutorial/id #uuid "7bc4fcd7-c5b4-530f-8d3e-668da5241ab4" :tutorial/math-academy-id 14343 :tutorial/title "Subsequent Percentage Applications as a Single Percentage"} :step/id #uuid "80cd6820-e776-5d8b-80df-989f1f917a46" :step/math-academy-id 615763 :step/next {:db/id #edb/ref 17592186230117}} {:db/id #edb/ref 17592186230117 :step/content {:db/id #edb/ref 17592186229195 :knowledge-point/canonical-example {:db/id #edb/ref 17592186228877 :question/id #uuid "4f528740-2fa6-5441-ab8b-86ce294dbf75" :question/math-academy-id "e-21447"} :knowledge-point/id #uuid "d35c9f72-a876-5fc0-8ab4-741c37cb3775" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049194} {:db/id #edb/ref 17592186051009}] :knowledge-point/questions [{:db/id #edb/ref 17592186229594} {:db/id #edb/ref 17592186229613} {:db/id #edb/ref 17592186486374} {:db/id #edb/ref 17592186486403} {:db/id #edb/ref 17592186489225} {:db/id #edb/ref 17592186489291}] :knowledge-point/title "Expressing Subsequent Percentages as a Single Percentage"} :step/id #uuid "dbf3edd7-461c-5d9e-b8a3-744c45503bf4" :step/math-academy-id 615764}] :activity/title "Applying Percentages in Succession" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186229243}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186489377} :activity/id #uuid "c74fe8fe-ab17-5021-aa6e-cba45f79c1ff" :activity/scope {:db/id #edb/ref 17592186050625 :topic/id #uuid "59db5455-7d67-57c4-8cb4-9c457475eed5" :topic/math-academy-id 6642} :activity/steps [{:db/id #edb/ref 17592186489306 :step/content {:db/id #edb/ref 17592186489176 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d814d78-c63a-5ab2-ad13-3b9219c8d97c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186488502}] :answer-field/correct {:db/id #edb/ref 17592186488502} :answer-field/id #uuid "7a897728-e4f7-5404-b951-a57ef68ace56" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186489083}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0a83854e-3aa1-59c0-86af-4b09c747a5fc" :question/math-academy-id "q-327532" :question/problem "A chemist increased the concentration of a lab solution to $125%$ of its original level. An additional reagent then increased that new concentration by $20%.$ If the original concentration was $80$ units, how many additional units were added solely by the reagent?\n\nThe reagent added \n{{field-1}}\nadditional units to the concentration." :question/worked-solution "First, the new concentration is $125%$ of the original $(80$ units$):$\n\n$$\n\\begin{aligned}125%\\times 80 & =\\frac{125}{100}\\times 80 \\\\  & =1.25\\times 80 \\\\  & =100\\end{aligned}\n$$\n\nSo, the new concentration is $100$ units. Then, the increase due to the reagent is $20%$ of this amount:\n\n$$\n\\begin{aligned}20%\\times 100 & =\\frac{20}{100}\\times 100 \\\\  & =0.2\\times 100 \\\\  & =20\\end{aligned}\n$$\n\nTherefore, the reagent added $20$ additional units to the concentration."} :step/id #uuid "2953197d-53f0-53b5-ae5a-55d33ffe4638" :step/next {:db/id #edb/ref 17592186489309}} {:db/id #edb/ref 17592186489309 :step/content {:db/id #edb/ref 17592186489268 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd4fe015-c4ea-5dd1-9dd5-eccb94b29510" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186488888}] :answer-field/correct {:db/id #edb/ref 17592186488888} :answer-field/id #uuid "6d38fd3a-1929-5eb8-b057-98cae4f07a49" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186489069}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ce7e59b5-3648-5abc-999d-9cb3832d5475" :question/math-academy-id "q-327544" :question/problem "An event organizer raised a ticket’s price to $160%$ of its original cost. A tax of $10%$ was applied to the marked-up price. If the ticket originally cost $$75,$ what is the tax?\n\nThe tax on the ticket is $$$  \n{{field-1}}." :question/worked-solution "First, the marked-up price is $160%$ of the original cost $($75):$\n\n$$\n\\begin{aligned}160%\\times 75 & =\\frac{160}{100}\\times 75 \\\\  & =1.6\\times 75 \\\\  & =120\\end{aligned}\n$$\n\nSo, the marked-up price of the ticket is $$120.$ Then, the tax is $10%$ of this price:\n\n$$\n\\begin{aligned}10%\\times 120 & =\\frac{10}{100}\\times 120 \\\\  & =0.1\\times 120 \\\\  & =12\\end{aligned}\n$$\n\nTherefore, the tax on the ticket is $$12.$"} :step/id #uuid "350b7139-1fab-56d4-86bf-e150f9c15fcd"} {:db/id #edb/ref 17592186489340 :step/content {:db/id #edb/ref 17592186229609 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be31978a-e66c-5914-a793-35965a56b7fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "27" :db/id #edb/ref 17592186488856}] :answer-field/correct {:db/id #edb/ref 17592186488856} :answer-field/id #uuid "40d930ab-9b4f-5758-a9bc-0cebb8f98bdd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186227997}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "74e717f6-68d5-5182-b3f0-a00b3d34de61" :question/math-academy-id "q-326900" :question/problem "A store marked up the price of a jacket to $150%$ of its original cost. The tax on the jacket is $30%$ of its marked-up price.\nIf the jacket originally cost $$60,$ what is the tax on the jacket?\n\nThe tax on the jacket is $$$\n{{field-1}}." :question/requires-calculator true :question/worked-solution "First, the marked-up price is $150%$ of the original cost $($60):$\n\n$$\n\\begin{aligned}150%\\times 60 & =\\frac{150}{100}\\times 60 \\\\  & =1.5\\times 60 \\\\  & =90\\end{aligned}\n$$\n\nSo, the marked-up price of the jacket is $$90.$\nThen, the tax is $30%$ of this price:\n\n$$\n\\begin{aligned}30%\\times 90 & =\\frac{30}{100}\\times 90 \\\\  & =0.3\\times 90 \\\\  & =27\\end{aligned}\n$$\n\nTherefore, the tax on the jacket is $$27.$"} :step/id #uuid "9110eb6a-2e93-51c7-a5d3-f3d5f6f274b2" :step/next {:db/id #edb/ref 17592186489306}} {:db/id #edb/ref 17592186489360 :step/content {:db/id #edb/ref 17592186489225 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "260423ca-c450-564c-9729-9051afdbdb30" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "35%" :db/id #edb/ref 17592186488550} {:answer/id #uuid "4be72f5e-d8f1-550b-b61f-4fa75e6788eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30%" :db/id #edb/ref 17592186488617} {:answer/id #uuid "a33ca1d2-8570-5b69-8b96-022db448b553" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40%" :db/id #edb/ref 17592186488795} {:answer/id #uuid "e2fbfada-c622-57dd-ad25-59b2dadc7979" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50%" :db/id #edb/ref 17592186488943} {:answer/id #uuid "e81179df-8a40-5429-9632-3ec632cd68d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "60%" :db/id #edb/ref 17592186488956}] :answer-field/correct {:db/id #edb/ref 17592186488617} :answer-field/id #uuid "2eb59fef-3913-52e0-b381-93b8afe722d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489042}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "61eb5e2e-fcaa-52d1-ac70-97110690d4d7" :question/math-academy-id "q-326465" :question/problem "According to a recent report, $60%$ of tablet owners said they used their tablets regularly. Of those, $50%$ said they used them primarily for drawing. What percentage of all tablet owners used tablets primarily for drawing?" :question/worked-solution "Let $x$ be the total number of tablet owners.\n\nWe're told that $60%$ of tablet owners used their tablets regularly. Thus, the number of tablet owners who use them regularly is $0.6x.$\n\nWe are also told that of those owners, $50%$ used them for drawing. So, the number of tablet owners who used tablets primarily for drawing is\n\n$$\n0.50(0.6x)=0.30x.\n$$\n\nThe expression $0.30x$ represents $30%$ of $x.$ Therefore, $30%$ of all tablet owners used tablets primarily for drawing."} :step/id #uuid "c1786767-df2d-5dac-97ac-8e1b734195a6" :step/next {:db/id #edb/ref 17592186489340}} {:db/id #edb/ref 17592186489377 :step/content {:db/id #edb/ref 17592186489291 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e949d25-1381-5079-b809-094d27a97f04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30%" :db/id #edb/ref 17592186488687} {:answer/id #uuid "b199cd17-c18e-5be7-a027-a7f522f133b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "45%" :db/id #edb/ref 17592186488824} {:answer/id #uuid "c8f27be0-083f-5731-b1fd-e01f4f406ebf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20%" :db/id #edb/ref 17592186488881} {:answer/id #uuid "d6e51400-072c-5b9e-8e97-35b9e1b59817" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25%" :db/id #edb/ref 17592186488913} {:answer/id #uuid "e420f7a2-62fb-57ef-956f-b0875cfcffa9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15%" :db/id #edb/ref 17592186488946}] :answer-field/correct {:db/id #edb/ref 17592186488946} :answer-field/id #uuid "8c5934ba-d051-5992-8338-41334a774b4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489092}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f7253d28-4651-534c-8fab-305435de6a5d" :question/math-academy-id "q-326461" :question/problem "In an online study, $60%$ of participants reported enjoying painting. Of those, $25%$ said they preferred painting landscapes. What percentage of all participants preferred landscape painting?" :question/worked-solution "Let $x$ be the total number of participants.\n\nWe're told that $60%$ of participants enjoy painting. Thus, the number of participants who enjoy painting is $0.6x.$\n\nWe are also told that of those participants, $25%$ preferred landscapes. So, the number of participants who preferred landscape painting is\n\n$$\n0.25(0.6x)=0.15x.\n$$\n\nThe expression $0.15x$ represents $15%$ of $x.$ Therefore, $15%$ of all participants preferred landscape painting."} :step/id #uuid "e843ada6-b68d-519e-b765-5a7d5f01b61e" :step/next {:db/id #edb/ref 17592186489360}}] :activity/title "Applying Percentages in Succession" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186488463}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186106814} :activity/id #uuid "5616fc0b-edd6-562d-b17b-956a73aff3f8" :activity/scope {:db/id #edb/ref 17592186050802 :topic/id #uuid "68088430-21e6-5111-bf94-00596620d05f" :topic/math-academy-id 1331} :activity/steps [{:db/id #edb/ref 17592186106814 :step/content {:db/id #edb/ref 17592186107037 :tutorial/content "The **power of product rule** states that if we want to raise the product $xy$ to some power $n$, we must raise each factor to the power $n$ and then multiply:\n\n$$\n(xy)^n=x^n y^n\n$$\n\nFor example,\n\n$$\n(xy)^4=x^4y^4.\n$$\n\nTo see why the power of product rule is true, let's take the above example and work it out again the long way, changing the order of factors in the multiplication. We get the same result:\n\n$$\n\\begin{aligned}(xy)^{4} & = \\\\ (xy)(xy)(xy)(xy) & = \\\\ (x\\cdot x\\cdot x\\cdot x)(y\\cdot y\\cdot y\\cdot y) & = \\\\ {x}^{4}{y}^{4}\\end{aligned}\n$$\n\nThe power of product rule is just a shortcut for the process above." :tutorial/id #uuid "7aabbc0f-a3ca-5f05-b6ae-d7551b16ae1a" :tutorial/math-academy-id 1482 :tutorial/title "Introduction"} :step/id #uuid "139aab34-d09f-505c-96f5-208298444874" :step/math-academy-id 3541 :step/next {:db/id #edb/ref 17592186106815}} {:db/id #edb/ref 17592186106815 :step/content {:db/id #edb/ref 17592186105850 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105441 :question/id #uuid "ac7cb5c7-c6f1-5418-92ea-025b88681439" :question/math-academy-id "e-1081"} :knowledge-point/id #uuid "8b4ce383-37b4-5d5a-80ef-3886605bd56f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049861} {:db/id #edb/ref 17592186051009}] :knowledge-point/questions [{:db/id #edb/ref 17592186106200} {:db/id #edb/ref 17592186106201} {:db/id #edb/ref 17592186485549} {:db/id #edb/ref 17592186485555}] :knowledge-point/title "Using the Power of Product Rule with a Positive Power"} :step/id #uuid "7305de37-518a-5a4e-903e-40552a4f9962" :step/math-academy-id 3542 :step/next {:db/id #edb/ref 17592186106816}} {:db/id #edb/ref 17592186106816 :step/content {:db/id #edb/ref 17592186105851 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105442 :question/id #uuid "c5803e29-de29-5394-8eb7-9a0c3beea3f4" :question/math-academy-id "e-1082"} :knowledge-point/id #uuid "85159201-5cf2-53da-91bf-ba7ef462a4fa" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050208}] :knowledge-point/questions [{:db/id #edb/ref 17592186106276} {:db/id #edb/ref 17592186106385} {:db/id #edb/ref 17592186485582} {:db/id #edb/ref 17592186499514}] :knowledge-point/title "Using the Power of Product Rule with a Negative Power"} :step/id #uuid "196b5dd3-ef4e-520a-aadd-9e763e63db72" :step/math-academy-id 3545 :step/next {:db/id #edb/ref 17592186106817}} {:db/id #edb/ref 17592186106817 :step/content {:db/id #edb/ref 17592186105852 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105443 :question/id #uuid "8a0ae6fe-6ba8-58bb-8835-a3e1546b0999" :question/math-academy-id "e-1083"} :knowledge-point/id #uuid "ae5f5e65-7642-5ca1-bf84-013dbd3c7ae4" :knowledge-point/questions [{:db/id #edb/ref 17592186106250} {:db/id #edb/ref 17592186106284} {:db/id #edb/ref 17592186485515} {:db/id #edb/ref 17592186485540} {:db/id #edb/ref 17592186499505} {:db/id #edb/ref 17592186499517}] :knowledge-point/title "Using the Power of Product Rule with Three Factors"} :step/id #uuid "b5b6259b-d42d-5bce-bbd7-530a36ded592" :step/math-academy-id 3548}] :activity/title "The Power of Product Rule With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186105977}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186499631} :activity/id #uuid "da36029c-d9f2-59ef-b122-0fe6af0f1259" :activity/scope {:db/id #edb/ref 17592186050802 :topic/id #uuid "68088430-21e6-5111-bf94-00596620d05f" :topic/math-academy-id 1331} :activity/steps [{:db/id #edb/ref 17592186499611 :step/content {:db/id #edb/ref 17592186499505 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07ea1924-7617-55bc-a41d-f3f63731e352" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3{v}^{2/5}}{{u}^{4}}" :db/id #edb/ref 17592186498743} {:answer/id #uuid "18c1e186-f60e-5c4e-8d46-814f50c709af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{27}^{-1}{u}^{-4}{v}^{2/5}" :db/id #edb/ref 17592186498782} {:answer/id #uuid "6f4d5935-7560-51ee-b28a-e74d36717445" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27{v}^{2/5}}{{u}^{4}}" :db/id #edb/ref 17592186498977} {:answer/id #uuid "98eaecfe-aa7c-56ba-90d9-9617e401d57e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{v}^{2/5}}{9{u}^{4}}" :db/id #edb/ref 17592186499056} {:answer/id #uuid "ab1a011f-e1bb-5e3f-807a-a03812cc1855" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{v}^{2/5}}{{9}^{-1}{u}^{-4}}" :db/id #edb/ref 17592186499104}] :answer-field/correct {:db/id #edb/ref 17592186499056} :answer-field/id #uuid "f70e860c-0687-51a2-b8e1-d1ade86eee91" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186499429}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "86ce32ac-6d75-5ef7-8ed3-9dc3f527e973" :question/math-academy-id "q-3928" :question/problem "${(27{u}^{6}{v}^{-3/5})}^{-2/3}=$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}{(27{u}^{6}{v}^{-3/5})}^{-2/3} & = \\\\ {({3}^{3}{u}^{6}{v}^{-3/5})}^{-2/3} & = \\\\ {({3}^{3})}^{-2/3}\\cdot {({u}^{6})}^{-2/3}\\cdot {({v}^{-3/5})}^{-2/3} & = \\\\ {3}^{3\\cdot (-2/3)}\\cdot {u}^{6\\cdot (-2/3)}\\cdot {v}^{(-3/5)\\cdot (-2/3)} & = \\\\ {3}^{-6/3}\\cdot {u}^{-12/3}\\cdot {v}^{6/15} & = \\\\ {3}^{-2}\\cdot {u}^{-4}\\cdot {v}^{2/5} & = \\\\ \\frac{{v}^{2/5}}{{3}^{2}{u}^{4}} & = \\\\ \\frac{{v}^{2/5}}{9{u}^{4}} & \\end{aligned}\n$$"} :step/id #uuid "ac43d0d9-d00d-529e-b6d7-32ae72bc24d9" :step/next {:db/id #edb/ref 17592186499615}} {:db/id #edb/ref 17592186499615 :step/content {:db/id #edb/ref 17592186499514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "190ab1b2-874e-5bb3-a0ed-b02168022ef8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{49}{{x}^{3}}" :db/id #edb/ref 17592186498784} {:answer/id #uuid "56bb8639-a83b-5c9f-bd37-2d2900c18393" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{{x}^{3}}" :db/id #edb/ref 17592186498927} {:answer/id #uuid "5d92a4cf-c350-5c03-8652-d25b59a9ea08" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "49{x}^{10}" :db/id #edb/ref 17592186498944} {:answer/id #uuid "a35a3d2b-2936-57a9-91bf-b88b9ea4ee2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{49}{{x}^{10}}" :db/id #edb/ref 17592186499083} {:answer/id #uuid "de2b212e-5da9-515f-8bd1-2141c6761d88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{{x}^{10}}" :db/id #edb/ref 17592186499224}] :answer-field/correct {:db/id #edb/ref 17592186499083} :answer-field/id #uuid "bcd19327-ff40-5dae-b2cf-088be8eeca6b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186499399}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "997d06ae-bfea-5bdd-ad34-25a8461aee43" :question/math-academy-id "q-72553" :question/problem "Which of the following is equivalent to ${(7{x}^{-5})}^{2}?$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}{(7{x}^{-5})}^{2} & = \\\\ {7}^{2}{({x}^{-5})}^{2} & = \\\\ 49\\cdot {x}^{-5\\cdot 2} & = \\\\ 49{x}^{-10} \\\\ \\frac{49}{{x}^{10}}\\end{aligned}\n$$"} :step/id #uuid "b7a760a1-c69c-5443-b629-d0a8e1e4e722"} {:db/id #edb/ref 17592186499631 :step/content {:db/id #edb/ref 17592186499517 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01a0d9e9-f16f-5e35-91eb-3bd865760ce9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{-{x}^{8}{y}^{-3}}{6}" :db/id #edb/ref 17592186498733} {:answer/id #uuid "45914d4a-b895-5bc8-a1de-5a3d97104256" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{6}{y}^{-3}}{6}" :db/id #edb/ref 17592186498891} {:answer/id #uuid "49c8eea6-1485-5196-a051-14e2a91ed557" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{6}{y}^{-3}}{8}" :db/id #edb/ref 17592186498901} {:answer/id #uuid "d3a6ab37-02d3-5559-97f9-826e50636e02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{8}{y}^{3}}{6}" :db/id #edb/ref 17592186499201} {:answer/id #uuid "e19915ad-81b9-58ed-9cd8-716103a6d691" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{-{x}^{6}{y}^{-3}}{8}" :db/id #edb/ref 17592186499236}] :answer-field/correct {:db/id #edb/ref 17592186498901} :answer-field/id #uuid "010a4b8c-41ba-5ff0-99c3-e6f5f3685048" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186499307}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9d191fc2-9ac2-5981-97ca-4426376145b0" :question/math-academy-id "q-816" :question/problem "${(2{x}^{-2}y)}^{-3}=$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}(2{x}^{-2}y)^{-3} & = \\\\ {2}^{-3}{({