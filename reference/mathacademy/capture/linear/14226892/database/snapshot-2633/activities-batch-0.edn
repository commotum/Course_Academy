#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186069797} :activity/id #uuid "f64241dc-95fe-569e-8afc-913a546e0d46" :activity/scope {:db/id #edb/ref 17592186048170 :topic/id #uuid "8555552a-fb5f-5455-9150-c473e5580702" :topic/math-academy-id 381} :activity/steps [{:db/id #edb/ref 17592186069719 :step/content {:db/id #edb/ref 17592186068796 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068639 :question/id #uuid "ca60143b-d02c-5497-a134-56444304c2fa" :question/math-academy-id "e-7223"} :knowledge-point/id #uuid "3979b4ea-910f-5037-b8e8-b0297f31c47c" :knowledge-point/questions [{:db/id #edb/ref 17592186069425} {:db/id #edb/ref 17592186069427} {:db/id #edb/ref 17592186484264} {:db/id #edb/ref 17592186499503}] :knowledge-point/title "Finding Cube Roots of Terms Containing Binomials"} :step/id #uuid "20d6dd44-7fc6-52a1-a076-27ddb6da9696" :step/math-academy-id 26723 :step/next {:db/id #edb/ref 17592186069799}} {:db/id #edb/ref 17592186069797 :step/content {:db/id #edb/ref 17592186069942 :tutorial/content "To find the **cube root** of a number $x$, we must ask ourselves, \"what number *cubed* equals $x$?\"\n\nFor example, the cube root of $8$ is $2$ since \n\n$$\n2^3 = 2 \\cdot 2 \\cdot 2 = 8,\n$$\n\nand the cube root of $-8$ is $-2$ since\n\n$$\n(-2)^3 = (-2) \\cdot (-2) \\cdot (-2) = -8.\n$$\n\nIn general, the cube root of $x^3$ is $x.$\n\nLike the square root, the cube root is signified by a radical symbol, but it also has a little $3$ next to it, i.e., $\\sqrt[3\\!\\phantom{p}]{\\phantom{2}}.$ Using this notation, we can express the above statements mathematically:\n\n- \"The cube root of $8$ is $2$\" can be expressed as $\\sqrt[3]{8}=2.$\n\n- \"The cube root of $-8$ is $-2$\" can be expressed as  $\\sqrt[3]{-8}=-2.$\n\n- \"The cube root of $x^3$ is $x$\" can be expressed as  $\\sqrt[3]{x^3}=x.$\n\n**Note:** For square roots, we have $\\sqrt{x^2} = |x|,$ but for cube roots, we have $\\sqrt[3]{x^3} = x.$ No absolute value is needed for cube roots, because\n\n- the cube root of a positive number is a positive number, and\n\n- the cube root of a negative number is a negative number." :tutorial/id #uuid "ad1bc727-9054-5115-83f0-a82aa24dc35e" :tutorial/math-academy-id 1605 :tutorial/title "Introduction"} :step/id #uuid "7e24a880-f9da-5e1e-b0bf-5bb2128d72a1" :step/math-academy-id 4295 :step/next {:db/id #edb/ref 17592186069798}} {:db/id #edb/ref 17592186069798 :step/content {:db/id #edb/ref 17592186068850 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068467 :question/id #uuid "2ca53a08-7b11-552c-983f-96e7a392156c" :question/math-academy-id "e-1357"} :knowledge-point/id #uuid "942732a6-ca14-5b61-b8fb-ab9ef81610cf" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049843}] :knowledge-point/questions [{:db/id #edb/ref 17592186069210} {:db/id #edb/ref 17592186069418} {:db/id #edb/ref 17592186484217} {:db/id #edb/ref 17592186484252}] :knowledge-point/title "Finding the Cube Root of a Monomial"} :step/id #uuid "eea06921-8121-51a7-86ad-15824cc00550" :step/math-academy-id 4296 :step/next {:db/id #edb/ref 17592186069719}} {:db/id #edb/ref 17592186069799 :step/content {:db/id #edb/ref 17592186068851 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068468 :question/id #uuid "c52719a7-544b-5844-b716-9b9d2999c028" :question/math-academy-id "e-1358"} :knowledge-point/id #uuid "11c07788-b01d-5788-b2f1-0a027ea53cb2" :knowledge-point/questions [{:db/id #edb/ref 17592186069424} {:db/id #edb/ref 17592186069426} {:db/id #edb/ref 17592186484266} {:db/id #edb/ref 17592186484297} {:db/id #edb/ref 17592186499461}] :knowledge-point/title "Finding the Cube Root of a Fraction"} :step/id #uuid "f7015e37-4cd2-5ffb-814e-264ca9a0b345" :step/math-academy-id 4299}] :activity/title "The Cube Root of a Perfect Cube With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068929}] [{:activity/course {:db/id #edb/ref 