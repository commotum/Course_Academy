uuid "ffc8fe30-0773-5c9d-a4ea-6cd4800ca4ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x{y}^{2}" :db/id #edb/ref 17592186546828}] :answer-field/correct {:db/id #edb/ref 17592186546828} :answer-field/id #uuid "5b8b0c81-e44c-5873-920a-d3c2fc32ba8c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186546866}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a6e80d96-0744-50cd-8c8b-fc119a85cde3" :question/math-academy-id "q-2968" :question/problem "$\\sqrt[3]{8{x}^{3}{y}^{6}}=$" :question/worked-solution "We write the term under the radical as a perfect cube, and simplify:\n\n$$\n\\begin{aligned}\\sqrt[3]{8{x}^{3}{y}^{6}} & = \\\\ \\sqrt[3]{2x{y}^{2}\\cdot 2x{y}^{2}\\cdot 2x{y}^{2}} & = \\\\ \\sqrt[3]{{(2x{y}^{2})}^{3}} & = \\\\ 2x{y}^{2}\\end{aligned}\n$$"} :step/id #uuid "e6cbfae9-f092-5eee-be9e-b29e4a731442" :step/next {:db/id #edb/ref 17592186547086}}] :activity/title "Quiz 13" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186546242}]}
