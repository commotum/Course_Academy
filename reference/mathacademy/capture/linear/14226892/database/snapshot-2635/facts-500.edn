17] [17592186546909 #edb/ref 1075 #edb/ref 17592186546506 #edb/ref 17592186045417] [17592186546909 #edb/ref 1075 #edb/ref 17592186546595 #edb/ref 17592186045417] [17592186546909 #edb/ref 1075 #edb/ref 17592186546620 #edb/ref 17592186045417] [17592186546909 #edb/ref 1075 #edb/ref 17592186546739 #edb/ref 17592186045417] [17592186546909 #edb/ref 1075 #edb/ref 17592186546744 #edb/ref 17592186045417] [17592186546909 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186546909 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186546909 #edb/ref 1078 #edb/ref 17592186546744 #edb/ref 17592186045417] [17592186546909 #edb/ref 1079 #uuid "a847d1b0-a797-5a54-9b9a-b76dbf9897f0" #edb/ref 17592186045417] [17592186546934 #edb/ref 1075 #edb/ref 17592186546330 #edb/ref 17592186045417] [17592186546934 #edb/ref 1075 #edb/ref 17592186546387 #edb/ref 17592186045417] [17592186546934 #edb/ref 1075 #edb/ref 17592186546519 #edb/ref 17592186045417] [17592186546934 #edb/ref 1075 #edb/ref 17592186546541 #edb/ref 17592186045417] [17592186546934 #edb/ref 1075 #edb/ref 17592186546571 #edb/ref 17592186045417] [17592186546934 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186546934 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186546934 #edb/ref 1078 #edb/ref 17592186546571 #edb/ref 17592186045417] [17592186546934 #edb/ref 1079 #uuid "d2cd7973-c8ad-58ba-89e0-21d8e56fd509" #edb/ref 17592186045417] [17592186546946 #edb/ref 1075 #edb/ref 17592186546410 #edb/ref 17592186045417] [17592186546946 #edb/ref 1075 #edb/ref 17592186546518 #edb/ref 17592186045417] [17592186546946 #edb/ref 1075 #edb/ref 17592186546568 #edb/ref 17592186045417] [17592186546946 #edb/ref 1075 #edb/ref 17592186546671 #edb/ref 17592186045417] [17592186546946 #edb/ref 1075 #edb/ref 17592186546702 #edb/ref 17592186045417] [17592186546946 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186546946 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186546946 #edb/ref 1078 #edb/ref 17592186546671 #edb/ref 17592186045417] [17592186546946 #edb/ref 1079 #uuid "eb3663af-daa1-5e49-a20e-d8dc066d5ffe" #edb/ref 17592186045417] [17592186546948 #edb/ref 1075 #edb/ref 17592186546626 #edb/ref 17592186045417] [17592186546948 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186546948 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186546948 #edb/ref 1078 #edb/ref 17592186546626 #edb/ref 17592186045417] [17592186546948 #edb/ref 1079 #uuid "ecbd6582-13a5-5dd4-8f0c-314a10cf5dbb" #edb/ref 17592186045417] [17592186546965 #edb/ref 1068 #edb/ref 17592186546829 #edb/ref 17592186045417] [17592186546965 #edb/ref 1069 "q-80009" #edb/ref 17592186045417] [17592186546965 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186546965 #edb/ref 1071 "Factor $\\frac{{s}^{2}}{4}-\\frac{1}{36}.$" #edb/ref 17592186045417] [17592186546965 #edb/ref 1072 #uuid "0e4d35de-1496-58dd-acc4-9d6da8717950" #edb/ref 17592186045417] [17592186546965 #edb/ref 1074 "Before we start our normal process of factoring, notice that all of the terms have a common factor of $\\frac{1}{4}.$ Therefore, we can simplify the expression by factoring out $\\frac{1}{4},$ as follows:\n\n$$\n\\frac{{s}^{2}}{4}-\\frac{1}{36}=\\frac{1}{4}({s}^{2}-\\frac{1}{9})\n$$\n\nNow, let's factor the expression inside parentheses using the difference of squares formula:\n\n$$\n\\begin{aligned}{s}^{2}-\\frac{1}{9} & = \\\\ {s}^{2}-{(\\frac{1}{3})}^{2} & = \\\\ (s-\\frac{1}{3})(s+\\frac{1}{3})\\end{aligned}\n$$\n\nTherefore, our original expression factors as follows:\n\n$$\n\\frac{{s}^{2}}{4}-\\frac{1}{36}=\\frac{1}{4}(s-\\frac{1}{3})(s+\\frac{1}{3})\n$$" #edb/ref 17592186045417] [17592186547009 #edb/ref 1068 #edb/ref 17592186546844 #edb/ref 17592186045417] [17592186547009 #edb/ref 1069 "q-15255" #edb/ref 17592186045417] [17592186547009 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186547009 #edb/ref 1071 "If $|6x+1|=7,$ then $x=$" #edb/ref 17592186045417] [17592186547009 #edb/ref 1072 #uuid "5cc362bd-9ac6-5268-99be-c1ee05140ba5" #edb/ref 17592186045417] [17592186547009 #edb/ref 1074 "Either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nSo, we set up the two corresponding equations and solve them independently:\n\n- If $|6x+1|=6x+1,$ we obtain:\n\n$$\n\\begin{aligned}|6x+1| & =7 \\\\ 6x+1 & =7 \\\\ 6x & =6 \\\\ \\frac{6x}{6} & =\\frac{6}{6} \\\\ x & =1\\end{aligned}\n$$\n\n- If $|6x+1|=-(6x+1),$ we obtain:\n\n$$\n\\begin{aligned}|6x+1| & =7 \\\\ -(6x+1) & =7 \\\\ -6x-1 & =7 \\\\ -6x & =8 \\\\ \\frac{-6x}{-6} & =\\frac{8}{-6} \\\\ x & =-\\frac{4}{3}\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-\\frac{4}{3}$ and $x=1.$" #edb/ref 17592186045417] [17592186547022 #edb/ref 1068 #edb/ref 17592186546882 #edb/ref 17592186045417] [17592186547022 #edb/ref 1069 "q-100966" #edb/ref 17592186045417] [17592186547022 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186547022 #edb/ref 1071 "${4}^{8}\\cdot {(4\\cdot 3)}^{7}=$" #edb/ref 17592186045417] [17592186547022 #edb/ref 1072 #uuid "7abf9e52-11fe-5f3b-b0b9-36cef1ac7576" #edb/ref 17592186045417] [17592186547022 #edb/ref 1074 "First, we rewrite the second factor using the power of product rule:\n\n$$\n{4}^{8}\\cdot {(4\\cdot 3)}^{7}={4}^{8}\\cdot {4}^{7}\\cdot {3}^{7}\n$$\n\nFinally, we apply the product rule for exponents, and simplify:\n\n$$\n{4}^{8}\\cdot {4}^{7}\\cdot {3}^{7}={4}^{8+7}\\cdot {3}^{7}={4}^{15}\\cdot {3}^{7}\n$$" #edb/ref 17592186045417] [17592186547026 #edb/ref 1068 #edb/ref 17592186546840 #edb/ref 17592186045417] [17592186547026 #edb/ref 1069 "q-2683" #edb/ref 17592186045417] [17592186547026 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186547026 #edb/ref 1071 "${(2{x}^{2})}^{4}=$" #edb/ref 17592186045417] [17592186547026 #edb/ref 1072 #uuid "85974f7c-3580-5a6c-8874-1948623d22ef" #edb/ref 17592186045417] [17592186547026 #edb/ref 1074 "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}{(2{x}^{2})}^{4} & = \\\\ {2}^{4}{({x}^{2})}^{4} & = \\\\ {2}^{4}{x}^{2\\cdot 4} & = \\\\ 16{x}^{8} & \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186547031 #edb/ref 1068 #edb/ref 17592186546934 #edb/ref 17592186045417] [17592186547031 #edb/ref 1069 "q-101899" #edb/ref 17592186045417] [17592186547031 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186547031 #edb/ref 1071 "Which of the following values of $x$ satisfy the inequality $\\frac{x}{5}>2\\,?$\n\nI. $x=30$\n\nII. $x=15$\n\nIII. $x=10$" #edb/ref 17592186045417] [17592186547031 #edb/ref 1072 #uuid "895db0ca-e5a4-5d21-a8cf-89c7d272a0e6" #edb/ref 17592186045417] [17592186547031 #edb/ref 1074 "We substitute each value into the given inequality and check to see if the resulting statement is true or false.\n\n- We substitute the value $x=30$ into the given inequality. We get:\n\n$$\n\\begin{aligned}\\frac{x}{5} & >2 \\\\ \\frac{30}{5} & >2 \\\\ 6 & >2\\,✓\\end{aligned}\n$$\n\nSo, substituting $x=30$ into the inequality leads to a **true** statement. \n\nTherefore, $x=30$ **satisfies** this inequality.\n\n- We substitute the value $x=15$ into the given inequality. We get:\n\n$$\n\\begin{aligned}\\frac{x}{5} & >2 \\\\ \\frac{15}{5} & >2 \\\\ 3 & >2\\,✓\\end{aligned}\n$$\n\nSo, substituting $x=15$ into the inequality leads to a **true** statement. \n\nTherefore, $x=15$ **satisfies** this inequality.\n\n- We substitute the value $x=10$ into the given inequality. We get:\n\n$$\n\\begin{aligned}\\frac{x}{5} & >2 \\\\ \\frac{10}{5} & >2 \\\\ 2 & >2\\,\\times \\end{aligned}\n$$\n\nSo, substituting $x=10$ into the inequality leads to a **false** statement. \n\nTherefore, $x=10$ **does not satisfy** this inequality." #edb/ref 17592186045417] [17592186547039 #edb/ref 1068 #edb/ref 17592186546866 #edb/ref 17592186045417] [17592186547039 #edb/ref 1069 "q-2968" #edb/ref 17592186045417] [17592186547039 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186547039 #edb/ref 1071 "$\\sqrt[3]{8{x}^{3}{y}^{6}}=$" #edb/ref 17592186045417] [17592186547039 #edb/ref 1072 #uuid "a6e80d96-0744-50cd-8c8b-fc119a85cde3" #edb/ref 17592186045417] [17592186547039 #edb/ref 1074 "We write the term under the radical as a perfect cube, and simplify:\n\n$$\n\\begin{aligned}\\sqrt[3]{8{x}^{3}{y}^{6}} & = \\\\ \\sqrt[3]{2x{y}^{2}\\cdot 2x{y}^{2}\\cdot 2x{y}^{2}} & = \\\\ \\sqrt[3]{{(2x{y}^{2})}^{3}} & = \\\\ 2x{y}^{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186547040 #edb/ref 1068 #edb/ref 17592186546878 #edb/ref 17592186045417] [17592186547040 #edb/ref 1069 "q-78166" #edb/ref 17592186045417] [17592186547040 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186547040 #edb/ref 1071 "Which of the following is equivalent to $(q+1)({q}^{2}+7q+2)?$" #edb/ref 17592186045417] [17592186547040 #edb/ref 1072 #uuid "a8e3a91e-2825-5391-a044-c55db4444bb3" #edb/ref 17592186045417] [17592186547040 #edb/ref 1074 "We distribute both terms of the binomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(q+1)({q}^{2}+7q+2) & = \\\\ q({q}^{2}+7q+2)+1({q}^{2}+7q+2) & = \\\\ {q}^{3}+7{q}^{2}+2q+{q}^{2}+7q+2 & = \\\\ {q}^{3}+8{q}^{2}+9q+2\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186547052 #edb/ref 1068 #edb/ref 17592186546862 #edb/ref 17592186045417] [17592186547052 #edb/ref 1069 "q-175691" #edb/ref 17592186045417] [17592186547052 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186547052 #edb/ref 1071 "If $k=\\frac{21-3k}{4},$ then $k=${{field-1}}." #edb/ref 17592186045417] [17592186547052 #edb/ref 1072 #uuid "c7c751ec-42d9-5e30-a955-bbbf2b18ef36" #edb/ref 17592186045417] [17592186547052 #edb/ref 1074 "First, we clear the rational expression by multiplying the equation through by $4$:\n\n$$\n\\begin{aligned}k & =\\frac{21-3k}{4} \\\\ \\frac{21-3k}{4} & =k \\\\ 4(\\frac{21-3k}{4}) & =4\\cdot k \\\\ \\cancel{4}(\\frac{21-3k}{\\cancel{4}}) & =4k \\\\ 21-3k & =4k\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}21-3k & =4k \\\\ 21-3k+3k & =4k+3k \\\\ 21 & =7k \\\\ \\frac{21}{7} & =\\frac{7k}{7} \\\\ 3 & =\\frac{\\cancel{7}k}{\\cancel{7}} \\\\ 3 & =k\\end{aligned}\n$$\n\nThus, $k=3.$" #edb/ref 17592186045417] [17592186547055 #edb/ref 1068 #edb/ref 17592186546909 #edb/ref 17592186045417] [17592186547055 #edb/ref 1069 "q-327578" #edb/ref 17592186045417] [17592186547055 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186547055 #edb/ref 1071 "Museum attendance increased to $120%$ of last year’s total. Of those visitors, $90%$ also attended the art exhibit. What percentage of last year’s total attended the art exhibit?" #edb/ref 17592186045417] [17592186547055 #edb/ref 1072 #uuid "d087556b-949f-5317-94fd-7ed1bb1bb119" #edb/ref 17592186045417] [17592186547055 #edb/ref 1074 "Let $x$ be the number of visitors last year.\n\nWe're told that attendance increased to $120%$ of last year’s total. Thus, the new number of visitors is $1.2x.$\n\nWe are also told that of those visitors, $90%$ attended the art exhibit. So, the number of visitors who attended the art exhibit is\n\n$$\n0.9(1.2x)=1.08x.\n$$\n\nThe expression $1.08x$ represents $108%$ of $x.$ Therefore, $108%$ of last year’s total attended the art exhibit." #edb/ref 17592186045417] [17592186547069 #edb/ref 1068 #edb/ref 17592186546948 #edb/ref 17592186045417] [17592186547069 #edb/ref 1069 "q-218571" #edb/ref 17592186045417] [17592186547069 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186547069 #edb/ref 1071 "If $81{a}^{2}=16,$ then $a=${{field-1}}." #edb/ref 17592186045417] [17592186547069 #edb/ref 1072 #uuid "e7a7bc64-476c-516f-9ef3-e891c084febe" #edb/ref 17592186045417] [17592186547069 #edb/ref 1074 "First, we isolate the ${a}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}81{a}^{2} & =16 \\\\ {a}^{2} & =\\frac{16}{81}\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{a}^{2}} & =\\sqrt{\\frac{16}{81}} \\\\ |a| & =\\frac{\\sqrt{16}}{\\sqrt{81}} \\\\ |a| & =\\frac{4}{9} \\\\ a & =\\pm \\frac{4}{9}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186547071 #edb/ref 1068 #edb/ref 17592186546946 #edb/ref 17592186045417] [17592186547071 #edb/ref 1069 "q-134557" #edb/ref 17592186045417] [17592186547071 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186547071 #edb/ref 1071 "$5\\sqrt[3]{7}+3\\sqrt[3]{7}=$" #edb/ref 17592186045417] [17592186547071 #edb/ref 1072 #uuid "ea5d88b4-44af-57bd-9e77-32e6ed1711e4" #edb/ref 17592186045417] [17592186547071 #edb/ref 1074 "We can combine the two $\\sqrt[3]{7}$ terms together, as follows:\n\n$$\n\\begin{aligned}5\\sqrt[3]{7}+3\\sqrt[3]{7} & = \\\\ (5+3)\\sqrt[3]{7} & = \\\\ 8\\sqrt[3]{7} & \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186547086 #edb/ref 1058 #edb/ref 17592186547109 #edb/ref 17592186045417] [17592186547086 #edb/ref 1062 #uuid "0258decb-d7ba-5bf4-9551-9788a51c3985" #edb/ref 17592186045417] [17592186547086 #edb/ref 1063 #edb/ref 17592186546965 #edb/ref 17592186045417] [17592186547095 #edb/ref 1058 #edb/ref 17592186547160 #edb/ref 17592186045417] [17592186547095 #edb/ref 1062 #uuid "2162e5b3-3e3d-50a6-a556-bdd42418577f" #edb/ref 17592186045417] [17592186547095 #edb/ref 1063 #edb/ref 17592186547031 #edb/ref 17592186045417] [17592186547104 #edb/ref 1058 #edb/ref 17592186547165 #edb/ref 17592186045417] [17592186547104 #edb/ref 1062 #uuid "30f74018-0e5e-5998-9921-62dfacf4dc96" #edb/ref 17592186045417] [17592186547104 #edb/ref 1063 #edb/ref 17592186547040 #edb/ref 17592186045417] [17592186547109 #edb/ref 1058 #edb/ref 17592186547163 #edb/ref 17592186045417] [17592186547109 #edb/ref 1062 #uuid "49eae33d-37c8-532e-9c92-2ce045176d20" #edb/re