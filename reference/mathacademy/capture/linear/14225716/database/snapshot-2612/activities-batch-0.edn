#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186079481} :activity/id #uuid "4960cdfa-d390-5442-92c7-a1f66e19c7c3" :activity/scope {:db/id #edb/ref 17592186050977 :topic/id #uuid "769cbed7-04cc-53d4-b34b-5d8b81d1dc47" :topic/math-academy-id 679} :activity/steps [{:db/id #edb/ref 17592186079481 :step/content {:db/id #edb/ref 17592186079625 :tutorial/content "Consider the following sequence:\n\n$$\n1,\\quad\\:\\: 3,\\quad\\:\\: 9,\\quad\\:\\: 27,\\quad\\:\\: 81,\\quad\\:\\: \\ldots\n$$\n\nNotice that each term is ${\\color{blue}3}$ times the previous term:\n\n![](images/9a/9a3af8dd763aa0ab6b176a3a9d711ead4d029e2cebef823f906403be5fc38786.png)\n\nA sequence like the one above, where each term is found by multiplying the previous term by a fixed constant, is called a **geometric sequence**. \n\nThis fixed constant is called the **common ratio**, and is denoted by $r.$ In this particular case, the common ratio is $r={\\color{blue}3}.$" :tutorial/id #uuid "406573ab-cd46-52f5-9dca-f559f83bb0af" :tutorial/math-academy-id 1667 :tutorial/title "Introduction"} :step/id #uuid "cf776b20-4406-571f-8848-138b411690db" :step/math-academy-id 455928 :step/next {:db/id #edb/ref 17592186079482}} {:db/id #edb/ref 17592186079482 :step/content {:db/id #edb/ref 17592186078544 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078199 :question/id #uuid "4d69af5a-1ec2-53b7-ad94-b292c6beaf47" :question/math-academy-id "e-1502"} :knowledge-point/id #uuid "06ab388a-b152-58aa-9764-ba4f8cabdf11" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050652} {:db/id #edb/ref 17592186051029}] :knowledge-point/questions [{:db/id #edb/ref 17592186078827} {:db/id #edb/ref 17592186079084} {:db/id #edb/ref 17592186520471} {:db/id #edb/ref 17592186520495}] :knowledge-point/title "Computing the Common Ratio"} :step/id #uuid "2aa6c9b2-aad7-5fff-90a2-f6b185f5af3b" :step/math-academy-id 455929 :step/next {:db/id #edb/ref 17592186079483}} {:db/id #edb/ref 1759218