stion-2bd15f40-e989-5300-b551-e3144c2c681f" :step/next "step-9ae72dc1-5078-5d82-be01-f7792b13240d" :db/ensure [:step/validate]} {:db/id "step-9ae72dc1-5078-5d82-be01-f7792b13240d" :step/id #uuid "9ae72dc1-5078-5d82-be01-f7792b13240d" :step/content "question-f3b5ac18-7c76-53e4-b7d2-3ac62a11ea93" :step/next "step-81e79889-743f-59f0-9539-c3b093bde922" :db/ensure [:step/validate]} {:db/id "step-81e79889-743f-59f0-9539-c3b093bde922" :step/id #uuid "81e79889-743f-59f0-9539-c3b093bde922" :step/content "question-11621803-c2eb-5773-8ffe-0f4ac7a22e24" :step/next "step-3bd1460f-6ae9-5676-898d-888ea5061574" :db/ensure [:step/validate]} {:db/id "step-3bd1460f-6ae9-5676-898d-888ea5061574" :step/id #uuid "3bd1460f-6ae9-5676-898d-888ea5061574" :step/content "question-2b6ddb3f-4ad3-5b3b-b8b2-23791ddb8dd3" :step/next "step-5f3aa8b7-683b-56c0-84cb-8c6e18e218bb" :db/ensure [:step/validate]} {:db/id "step-5f3aa8b7-683b-56c0-84cb-8c6e18e218bb" :step/id #uuid "5f3aa8b7-683b-56c0-84cb-8c6e18e218bb" :step/content "question-737200e6-c3ef-51a6-b724-78dcb92c8633" :step/next "step-2a7599e0-d833-5e8d-955f-489466bc1e3b" :db/ensure [:step/validate]} {:db/id "step-2a7599e0-d833-5e8d-955f-489466bc1e3b" :step/id #uuid "2a7599e0-d833-5e8d-955f-489466bc1e3b" :step/content "question-c76e6329-2e41-5111-9e2f-17e316c25286" :db/ensure [:step/validate]}] "assertions" [["question-545ece5b-8e3c-584b-b6c7-99fcc1c7f1e4" :question/id #uuid "545ece5b-8e3c-584b-b6c7-99fcc1c7f1e4"] ["question-545ece5b-8e3c-584b-b6c7-99fcc1c7f1e4" :question/math-academy-id "q-223771"] ["question-545ece5b-8e3c-584b-b6c7-99fcc1c7f1e4" :question/problem "Which of the following numbers are rational?\n\nI. $0.1222$\n\nII. $1.3\\overset{―}{4}$\n\nIII. $1.981354…$"] ["question-545ece5b-8e3c-584b-b6c7-99fcc1c7f1e4" :question/worked-solution "Let's examine each of our numbers in turn.\n\n- $0.1222$ is a rational number because it can be expressed as a ratio of two integers:\n\n$$\n0.1222=\\frac{1\\,222}{10\\,000}\n$$\n\n- $1.3\\overset{―}{4}$ is a rational number. The notation $\\overset{―}{4}$ tells us that the digit $4$ after the decimal point repeats indefinitely.\n\n$$\n1.3\\overset{―}{4}=1.34444444444…\n$$\n\nAny decimal with repeating digits can be represented as a ratio of two integers. In this case,\n\n$$\n1.3\\overset{―}{4}=\\frac{121}{90}.\n$$\n\n- $1.981354…$ is not a rational number. The notation \"$…$\" tells us that digits after the decimal point extend forever. However, there are no repeating digits.\n\nTherefore, the correct answer is \"I and II only.\""] ["question-545ece5b-8e3c-584b-b6c7-99fcc1c7f1e4" :question/difficulty :question.difficulty/hard] ["answer-field-bcc79105-671c-5be0-a88d-c239f34d4061" :answer-field/id #uuid "bcc79105-671c-5be0-a88d-c239f34d4061"] ["answer-25a5696c-a26b-502d-be4e-0afdfd7f51f8" :answer/id #uuid "25a5696c-a26b-502d-be4e-0afdfd7f51f8"] ["answer-25a5696c-a26b-502d-be4e-0afdfd7f51f8" :answer/type :answer.type/text] ["answer-25a5696c-a26b-502d-be4e-0afdfd7f51f8" :answer/value "I and II only"] ["answer-e29ca0b9-8013-5e7c-88ee-a18445c629ff" :answer/id #uuid "e29ca0b9-8013-5e7c-88ee-a18445c629ff"] ["answer-e29ca0b9-8013-5e7c-88ee-a18445c629ff" :answer/type :answer.type/text] ["answer-e29ca0b9-8013-5e7c-88ee-a18445c629ff" :answer/value "I and III only"] ["answer-fd529219-bbce-5ad9-9500-b1576186d994" :answer/id #uuid "fd529219-bbce-5ad9-9500-b1576186d994"] ["answer-fd529219-bbce-5ad9-9500-b1576186d994" :answer/type :answer.type/text] ["answer-fd529219-bbce-5ad9-9500-b1576186d994" :answer/value "I only"] ["answer-1d6bfadd-7df2-5a71-bdb1-030ca706906d" :answer/id #uuid "1d6bfadd-7df2-5a71-bdb1-030ca706906d"] ["answer-1d6bfadd-7df2-5a71-bdb1-030ca706906d" :answer/type :answer.type/text] ["answer-1d6bfadd-7df2-5a71-bdb1-030ca706906d" :answer/value "II and III only"] ["answer-fe3331e6-1d14-5f24-9a05-99b572f9ab12" :answer/id #uuid "fe3331e6-1d14-5f24-9a05-99b572f9ab12"] ["answer-fe3331e6-1d14-5f24-9a05-99b572f9ab12" :answer/type :answer.type/text] ["answer-fe3331e6-1d14-5