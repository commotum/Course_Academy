-9fb1-56b1-93d9-c578bcbe7781"] ["question-2b6ddb3f-4ad3-5b3b-b8b2-23791ddb8dd3" :question/answer-fields "answer-field-18ef1367-2b1e-5456-9cb2-9b7234a263ce"] [17592186115336 :knowledge-point/questions "question-2b6ddb3f-4ad3-5b3b-b8b2-23791ddb8dd3"] ["question-737200e6-c3ef-51a6-b724-78dcb92c8633" :question/id #uuid "737200e6-c3ef-51a6-b724-78dcb92c8633"] ["question-737200e6-c3ef-51a6-b724-78dcb92c8633" :question/math-academy-id "q-28880"] ["question-737200e6-c3ef-51a6-b724-78dcb92c8633" :question/problem "Given the inequalities, $x<3$ and $x>-1$, express their common set of solutions as an interval."] ["question-737200e6-c3ef-51a6-b724-78dcb92c8633" :question/worked-solution "We start by sketching the solutions to the two inequalities separately:\n\n![](images/16/166ce99c0ceedf97d38066b544b5dc6ff7ca63296572d952536193a83a410d94.png)\n\n![](images/b5/b5a0212c7df84c064e5b49f878c47f824631bf9585bf20a7a48ce8ddc1b4a646.png)\n\nThe common set of values consists of the values that are in both intervals. So, it can be graphed by finding where the two intervals overlap:\n\n![](images/25/25313fabbd318c3c1fdc5e63b0d20ac44b5a4c951f70232dbefaaa2d82db4045.png)\n\nTherefore, the common set of values is\n$(-1,3).$"] ["question-737200e6-c3ef-51a6-b724-78dcb92c8633" :question/difficulty :question.difficulty/moderate] ["answer-field-c748d70c-8464-5ad6-b8fa-7ac841e67513" :answer-field/id #uuid "c748d70c-8464-5ad6-b8fa-7ac841e67513"] ["answer-6a9dba03-5fa7-5118-ad22-05a191e7c70e" :answer/id #uuid "6a9dba03-5fa7-5118-ad22-05a191e7c70e"] ["answer-6a9dba03-5fa7-5118-ad22-05a191e7c70e" :answer/type :answer.type/math] ["answer-6a9dba03-5fa7-5118-ad22-05a191e7c70e" :answer/value "(-1,3)"] ["answer-317f62a7-f15c-5b8e-a3a7-6ef60ab56f79" :answer/id #uuid "317f62a7-f15c-5b8e-a3a7-6ef60ab56f79"] ["answer-317f62a7-f15c-5b8e-a3a7-6ef60ab56f79" :answer/type :answer.type/math] ["answer-317f62a7-f15c-5b8e-a3a7-6ef60ab56f79" :answer/value "(-1,3]"] ["answer-dc21a884-c07c-5990-ba2f-65cfe89ba621" :answer/id