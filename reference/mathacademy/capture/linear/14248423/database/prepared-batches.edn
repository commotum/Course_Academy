603-c310e6c136e8" :answer/value "$(-\\infty ,0)$  only"] ["answer-8cda3b06-fc65-539f-a0fe-5a74cf66c1f1" :answer/id #uuid "8cda3b06-fc65-539f-a0fe-5a74cf66c1f1"] ["answer-8cda3b06-fc65-539f-a0fe-5a74cf66c1f1" :answer/type :answer.type/text] ["answer-8cda3b06-fc65-539f-a0fe-5a74cf66c1f1" :answer/value "$(-\\infty ,0)$ and $(1,\\infty )$"] ["answer-063a7b7f-b47f-5420-8652-88b2a645f008" :answer/id #uuid "063a7b7f-b47f-5420-8652-88b2a645f008"] ["answer-063a7b7f-b47f-5420-8652-88b2a645f008" :answer/type :answer.type/text] ["answer-063a7b7f-b47f-5420-8652-88b2a645f008" :answer/value "$(-\\infty ,1)$  only"] ["answer-548e25f6-f4e6-533b-b1ed-f0e56a335f22" :answer/id #uuid "548e25f6-f4e6-533b-b1ed-f0e56a335f22"] ["answer-548e25f6-f4e6-533b-b1ed-f0e56a335f22" :answer/type :answer.type/text] ["answer-548e25f6-f4e6-533b-b1ed-f0e56a335f22" :answer/value "$(0,\\infty )$  only"] ["answer-5fa45410-4390-591e-b4d0-2cfa50c312c3" :answer/id #uuid "5fa45410-4390-591e-b4d0-2cfa50c312c3"] ["answer-5fa45410-4390-591e-b4d0-2cfa50c312c3" :answer/type :answer.type/text] ["answer-5fa45410-4390-591e-b4d0-2cfa50c312c3" :answer/value "$(1,\\infty )$   only"] [17592186112872 :answer-field/correct "answer-8cda3b06-fc65-539f-a0fe-5a74cf66c1f1"] [17592186112872 :answer-field/choices "answer-1ad65148-e01b-5814-8603-c310e6c136e8"] [17592186112872 :answer-field/choices "answer-8cda3b06-fc65-539f-a0fe-5a74cf66c1f1"] [17592186112872 :answer-field/choices "answer-063a7b7f-b47f-5420-8652-88b2a645f008"] [17592186112872 :answer-field/choices "answer-548e25f6-f4e6-533b-b1ed-f0e56a335f22"] [17592186112872 :answer-field/choices "answer-5fa45410-4390-591e-b4d0-2cfa50c312c3"] ["question-ef0090d7-e552-5522-8456-ce718437e171" :question/id #uuid "ef0090d7-e552-5522-8456-ce718437e171"] ["question-ef0090d7-e552-5522-8456-ce718437e171" :question/math-academy-id "q-120407"] ["question-ef0090d7-e552-5522-8456-ce718437e171" :question/problem "The time, in hours, it takes to empty a pool varies inversely with the rate of pumping, in gallons per hour ($\\text{gph}$). If it takes $5$ hours to empty the pool at a rate of $200\\,\\text{gph},$ what is the constant of variation?"] ["question-ef0090d7-e552-5522-8456-ce718437e171" :question/worked-solution "The time $t$ is inversely proportional to the rate of pumping $r,$ so we have\n\n$$\nt=\\frac{k}{r},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that it takes $5$ hours to empty the pool at a rate of $200\\,\\text{gph}.$  We can use this information to solve for $k$ as follows:\n\n$$\n\\begin{aligned}5 & =\\frac{k}{200} \\\\ 5\\cdot 200 & =k \\\\ 1\\,000 & =k\\end{aligned}\n$$\n\nTherefore, our final answer is $k=1\\,000.$"] ["question-ef0090d7-e552-5522-8456-ce718437e171" :question/difficulty :question.difficulty/moderate] ["answer-field-deb9d83a-08d5-565b-aa43-4570ecfc8e23" :answer-field/id #uuid "deb9d83a-08d5-565b-aa43-4570ecfc8e23"] ["answer-72a5b4a1-8899-5c56-bdf0-2ccfcab5d58d" :answer/id #uuid "72a5b4a1-8899-5c56-bdf0-2ccfcab5d58d"] ["answer-72a5b4a1-8899-5c56-bdf0-2ccfcab5d58d" :answer/type :answer.type/math] ["answer-72a5b4a1-8899-5c56-bdf0-2ccfcab5d58d" :answer/value "0.025"] ["answer-c3da19e8-a0a3-53c5-9a36-500ef3112bce" :answer/id #uuid "c3da19e8-a0a3-53c5-9a36-500ef3112bce"] ["answer-c3da19e8-a0a3-53c5-9a36-500ef3112bce" :answer/type :answer.type/math] ["answer-c3da19e8-a0a3-53c5-9a36-500ef3112bce" :answer/value "10\\,000"] ["answer-72de3c79-c429-510b-a5a0-9e53f9ea6288" :answer/id #uuid "72de3c79-c429-510b-a5a0-9e53f9ea6288"] ["answer-72de3c79-c429-510b-a5a0-9e53f9ea6288" :answer/type :answer.type/math] ["answer-72de3c79-c429-510b-a5a0-9e53f9ea6288" :answer/value "1\\,000"] ["answer-8e03c3b2-9b01-57f9-a12b-2c9cdfdf3dd7" :answer/id #uuid "8e03c3b2-9b01-57f9-a12b-2c9cdfdf3dd7"] ["answer-8e03c3b2-9b01-57f9-a12b-2c9cdfdf3dd7" :answer/type :answer.type/math] ["answer-8e03c3b2-9b01-57f9-a12b-2c9cdfdf3dd7" :answer/value "4"] ["answer-17a716a6-7e4d-54fc-b13f-a601c3ca82e5" :answer/id #uuid "17a716a6-7e4d-54fc-b13f-a601c3ca82e5"] ["answer-17a716a6-7e4d-54fc-b13f-a601c3ca82e5" :answer/type :answer.type/math] ["answer-17a716a6-7e4d-54fc-b13f-a601c3ca82e5" :answer/value "40"] ["answer-field-deb9d83a-08d5-565b-aa43-4570ecfc8e23" :answer-field/key "selection"] ["answer-field-deb9d83a-08d5-565b-aa43-4570ecfc8e23" :answer-field/type :answer-field.type/radio] ["answer-field-deb9d83a-08d5-565b-aa43-4570ecfc8e23" :answer-field/correct "answer-72de3c79-c429-510b-a5a0-9e53f9ea6288"] ["answer-field-deb9d83a-08d5-565b-aa43-4570ecfc8e23" :answer-field/choices "answer-72a5b4a1-8899-5c56-bdf0-2ccfcab5d58d"] ["answer-field-deb9d83a-08d5-565b-aa43-4570ecfc8e23" :answer-field/choices "answer-c3da19e8-a0a3-53c5-9a36-500ef3112bce"] ["answer-field-deb9d83a-08d5-565b-aa43-4570ecfc8e23" :answer-field/choices "answer-72de3c79-c429-510b-a5a0-9e53f9ea6288"] ["answer-field-deb9d83a-08d5-565b-aa43-4570ecfc8e23" :answer-field/choices "answer-8e03c3b2-9b01-57f9-a12b-2c9cdfdf3dd7"] ["answer-field-deb9d83a-08d5-565b-aa43-4570ecfc8e23" :answer-field/choices "answer-17a716a6-7e4d-54fc-b13f-a601c3ca82e5"] ["question-ef0090d7-e552-5522-8456-ce718437e171" :question/answer-fields "answer-field-deb9d83a-08d5-565b-aa43-4570ecfc8e23"] [17592186176015 :knowledge-point/questions "question-ef0090d7-e552-5522-8456-ce718437e171"] ["question-1a0b67f9-e70a-56fd-9ed9-04486a79a002" :question/id #uuid "1a0b67f9-e70a-56fd-9ed9-04486a79a002"] ["question-1a0b67f9-e70a-56fd-9ed9-04486a79a002" :question/math-academy-id "q-80174"] ["question-1a0b67f9-e70a-56fd-9ed9-04486a79a002" :question/problem "Factor $100+40y-5{y}^{2}.$"] ["question-1a0b67f9-e70a-56fd-9ed9-04486a79a002" :question/worked-solution "First, notice that we can factor out a $(-5)$ from each of the terms:\n\n$$\n\\begin{aligned}100+40y-5{y}^{2} & =-5({y}^{2}-8y-20) & \\end{aligned}\n$$\n\nNow, we just need to factor the polynomial ${y}^{2}-8y-20$ in parentheses.\n\nWe start by listing the factor pairs of the constant term $(-20).$ The constant term is negative, so that means one of the factors is negative and the other is positive:\n\n$$\n\\begin{aligned}1 & \\times (-20) \\\\ (-1) & \\times 20 \\\\ 2 & \\times (-10) \\\\ (-2) & \\times 10 \\\\ 4 & \\times (-5) \\\\ (-4) & \\times 5\\end{aligned}\n$$\n\nNow, we find which factor pair adds up to the coefficient of the linear term $(-8):$\n\n$$\n\\begin{aligned}1+(-20) & =-19 & \\times  \\\\ -1+20 & =19 & \\times  \\\\ 2+(-10) & =-8 & ✓ \\\\ -2+10 & =8 & \\times  \\\\ 4+(-5) & =-1 & \\times  \\\\ -4+5 & =1 & \\times \\end{aligned}\n$$\n\nUsing the factor pair identified above, we write the linear term as $-8y=2y-10y$ and then factor:\n\n$$\n\\begin{aligned}-5({y}^{2}-8y-20) & = \\\\ -5({y}^{2}+2y-10y-20) & = \\\\ -5(({y}^{2}+2y)+(-10y-20)) & = \\\\ -5(y(y+2)-10(y+2)) & = \\\\ -5(y-10)(y+2) & \\end{aligned}\n$$"] ["question-1a0b67f9-e70a-56fd-9ed9-04486a79a002" :question/difficulty :question.difficulty/hard] ["answer-field-20bcd852-4da7-5c86-b1b8-f77067a480cd" :answer-field/id #uuid "20bcd852-4da7-5c86-b1b8-f77067a480cd"] ["answer-70f8bc63-9032-59d6-94c7-44731a339417" :answer/id #uuid "70f8bc63-9032-59d6-94c7-44731a339417"] ["answer-70f8bc63-9032-59d6-94c7-44731a339417" :answer/type :answer.type/math] ["answer-70f8bc63-9032-59d6-94c7-44731a339417" :answer/value "(y-20)(5y+1)"] ["answer-602c6570-8eef-570f-ab39-c5dfd88147f7" :answer/id #uuid "602c6570-8eef-570f-ab39-c5dfd88147f7"] ["answer-602c6570-8eef-570f-ab39-c5dfd88147f7" :answer/type :answer.type/math] ["answer-602c6570-8eef-570f-ab39-c5dfd88147f7" :answer/value "-5(y+10)(y-2)"] ["answer-5c8b5761-5505-52d5-b16d-9caf40cd8a5e" :answer/id #uuid "5c8b5761-5505-52d5-b16d-9caf40cd8a5e"] ["answer-5c8b5761-5505-52d5-b16d-9caf40cd8a5e" :answer/type :answer.type/math] ["answer-5c8b5761-5505-52d5-b16d-9caf40cd8a5e" :answer/value "-5(y+5)(y+4)"] ["answer-f19b6b7f-625a-51d8-8fa2-fba6b9225227" :answer/id #uuid "f19b6b7f-625a-51d8-8fa2-fba6b9225227"] ["answer-f19b6b7f-625a-51d8-8fa2-fba6b9225227" :answer/type :answer.type/math] ["answer-f19b6b7f-625a-51d8-8fa2-fba6b9225227" :answer/value "-5(y-10)(y+2)"] ["answer-8e79ff6b-683b-5305-8568-90663d207d42" :answer/id #uuid "8e79ff6b-683b-5305-8568-90663d207d42"] ["answer-8e79ff6b-683b-5305-8568-90663d207d42" :answer/type :answer.type/math] ["answer-8e79ff6b-683b-5305-8568-90663d207d42" :answer/value "5(y-5)(y-4)"] ["answer-field-20bcd852-4da7-5c86-b1b8-f77067a480cd" :answer-field/key "selection"] ["answer-field-20bcd852-4da7-5c86-b1b8-f77067a480cd" :answer-field/type :answer-field.type/radio] ["answer-field-20bcd852-4da7-5c86-b1b8-f77067a480cd" :answer-field/correct "answer-f19b6b7f-625a-51d8-8fa2-fba6b9225227"] ["answer-field-20bcd852-4da7-5c86-b1b8-f77067a480cd" :answer-field/choices "answer-70f8bc63-9032-59d6-94c7-44731a339417"] ["answer-field-20bcd852-4da7-5c86-b1b8-f77067a480cd" :answer-field/choices "answer-602c6570-8eef-570f-ab39-c5dfd88147f7"] ["answer-field-20bcd852-4da7-5c86-b1b8-f77067a480cd" :answer-field/choices "answer-5c8b5761-5505-52d5-b16d-9caf40cd8a5e"] ["answer-field-20bcd852-4da7-5c86-b1b8-f77067a480cd" :answer-field/choices "answer-f19b6b7f-625a-51d8-8fa2-fba6b9225227"] ["answer-field-20bcd852-4da7-5c86-b1b8-f77067a480cd" :answer-field/choices "answer-8e79ff6b-683b-5305-8568-90663d207d42"] ["question-1a0b67f9-e70a-56fd-9ed9-04486a79a002" :question/answer-fields "answer-field-20bcd852-4da7-5c86-b1b8-f77067a480cd"] [17592186175949 :knowledge-point/questions "question-1a0b67f9-e70a-56fd-9ed9-04486a79a002"] ["question-2bd15f40-e989-5300-b551-e3144c2c681f" :question/id #uuid "2bd15f40-e989-5300-b551-e3144c2c681f"] ["question-2bd15f40-e989-5300-b551-e3144c2c681f" :question/math-academy-id "q-142027"] ["question-2bd15f40-e989-5300-b551-e3144c2c681f" :question/problem "Simplify $\\sqrt{288a}.$"] ["question-2bd15f40-e989-5300-b551-e3144c2c681f" :question/worked-solution "We first write $288a$ as the product $144\\cdot 2a$ which contains a perfect square $(144):$ \n\n$$\n\\begin{aligned}\\sqrt{288a} & = \\\\ \\sqrt{144\\cdot 2a} & \\end{aligned}\n$$\n\nThen, we can separate the product into two separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{144\\cdot 2a} & = \\\\ \\sqrt{(12)^{2}\\cdot 2a} & = \\\\ \\sqrt{(12)^{2}}\\cdot \\sqrt{2a} & \\end{aligned}\n$$\n\nFinally, we simplify the radical containing the perfect square:\n\n$$\n\\begin{aligned}\\sqrt{(12)^{2}}\\cdot \\sqrt{2a} & = \\\\ |12|\\cdot \\sqrt{2a} & = \\\\ 12\\sqrt{2a} & \\end{aligned}\n$$"] ["question-2bd15f40-e989-5300-b551-e3144c2c681f" :question/difficulty :question.difficulty/easy] ["answer-field-a2b7404d-e71d-5caa-9f77-0a7e4942005f" :answer-field/id #uuid "a2b7404d-e71d-5caa-9f77-0a7e4942005f"] ["answer-23f5d581-b735-5062-a71e-32bc76f94353" :answer/id #uuid "23f5d581-b735-5062-a71e-32bc76f94353"] ["answer-23f5d581-b735-5062-a71e-32bc76f94353" :answer/type :answer.type/math] ["answer-23f5d581-b735-5062-a71e-32bc76f94353" :answer/value "12\\sqrt{2a}"] ["answer-08f452c3-9f2c-5647-b7af-c22e41c80791" :answer/id #uuid "08f452c3-9f2c-5647-b7af-c22e41c80791"] ["answer-08f452c3-9f2c-5647-b7af-c22e41c80791" :answer/type :answer.type/math] ["answer-08f452c3-9f2c-5647-b7af-c22e41c80791" :answer/value "12a\\sqrt{2}"] ["answer-7466ed08-97c1-557f-bae6-81e174a0f8e7" :answer/id #uuid "7466ed08-97c1-557f-bae6-81e174a0f8e7"] ["answer-7466ed08-97c1-557f-bae6-81e174a0f8e7" :answer/type :answer.type/math] ["answer-7466ed08-97c1-557f-bae6-81e174a0f8e7" :answer/value "144\\sqrt{a}"] ["answer-b7101c8e-c2e8-549e-861f-eeb818e4fc44" :answer/id #uuid "b7101c8e-c2e8-549e-861f-eeb818e4fc44"] ["answer-b7101c8e-c2e8-549e-861f-eeb818e4fc44" :answer/type :answer.type/math] ["answer-b7101c8e-c2e8-549e-861f-eeb818e4fc44" :answer/value "24\\sqrt{a}"] ["answer-a76e354b-19c7-5276-987d-f27f82fdd8ad" :answer/id #uuid "a76e354b-19c7-5276-987d-f27f82fdd8ad"] ["answer-a76e354b-19c7-5276-987d-f27f82fdd8ad" :answer/type :answer.type/math] ["answer-a76e354b-19c7-5276-987d-f27f82fdd8ad" :answer/value "2\\sqrt{12a}"] ["answer-field-a2b7404d-e71d-5caa-9f77-0a7e4942005f" :answer-field/key "selection"] ["answer-field-a2b7404d-e71d-5caa-9f77-0a7e4942005f" :answer-field/type :answer-field.type/radio] ["answer-field-a2b7404d-e71d-5caa-9f77-0a7e4942005f" :answer-field/correct "answer-23f5d581-b735-5062-a71e-32bc76f94353"] ["answer-field-a2b7404d-e71d-5caa-9f77-0a7e4942005f" :answer-field/choices "answer-23f5d581-b735-5062-a71e-32bc76f94353"] ["answer-field-a2b7404d-e71d-5caa-9f77-0a7e4942005f" :answer-field/choices "answer-08f452c3-9f2c-5647-b7af-c22e41c80791"] ["answer-field-a2b7404d-e71d-5caa-9f77-0a7e4942005f" :answer-field/choices "answer-7466ed08-97c1-557f-bae6-81e174a0f8e7"] ["answer-field-a2b7404d-e71d-5caa-9f77-0a7e4942005f" :answer-field/choices "answer-b7101c8e-c2e8-549e-861f-eeb818e4fc44"] ["answer-field-a2b7404d-e71d-5caa-9f77-0a7e4942005f" :answer-field/choices "answer-a76e354b-19c7-5276-987d-f27f82fdd8ad"] ["question-2bd15f40-e989-5300-b551-e3144c2c681f" :question/answer-fields "answer-field-a2b7404d-e71d-5caa-9f77-0a7e4942005f"] [17592186068828 :knowledge-point/questions "question-2bd15f40-e989-5300-b551-e3144c2c681f"] ["question-f3b5ac18-7c76-53e4-b7d2-3ac62a11ea93" :question/id #uuid "f3b5ac18-7c76-53e4-b7d2-3ac62a11ea93"] ["question-f3b5ac18-7c76-53e4-b7d2-3ac62a11ea93" :question/math-academy-id "q-223197"] ["question-f3b5ac18-7c76-53e4-b7d2-3ac62a11ea93" :question/problem "![](images/c5/c543b90535e3b252954ffb9e935f3f05a71d302f1f69a5212b467c826c9d8697.png)\n\nGiven the quadrilateral above, we have $x=${{field-1}}\n${}^{∘}.$"] ["question-f3b5ac18-7c76-53e4-b7d2-3ac62a11ea93" :question/worked-solution "Since the sum of the exterior angles of a polygon is ${360}^{∘}$, we have\n\n$$\n\\begin{aligned}5x+(6x+{30}^{∘})+(5x+{30}^{∘})+4x & ={360}^{∘} \\\\ 20x+{60}^{∘} & ={360}^{∘} \\\\ 20x & ={300}^{∘} \\\\ x & ={15}^{∘}.\\end{aligned}\n$$"] ["question-f3b5ac18-7c76-53e4-b7d2-3ac62a11ea93" :question/difficulty :question.difficulty/easy] ["answer-field-68f65a3c-aa44-5a53-857d-09108a8b580f" :answer-field/id #uuid "68f65a3c-aa44-5a53-857d-09108a8b580f"] ["answer-c93084f1-f47b-56e6-bf6d-5ad197d70732" :answer/id #uuid "c93084f1-f47b-56e6-bf6d-5ad197d70732"] ["answer-c93084f1-f47b-56e6-bf6d-5ad197d70732" :answer/type :answer.type/math] ["answer-c93084f1-f47b-56e6-bf6d-5ad197d70732" :answer/value "15"] ["answer-field-68f65a3c-aa44-5a53-857d-09108a8b580f" :answer-field/key "field-1"] ["answer-field-68f65a3c-aa44-5a53-857d-09108a8b580f" :answer-field/type :answer-field.type/blank] ["answer-field-68f65a3c-aa44-5a53-857d-09108a8b580f" :answer-field/correct "answer-c93084f1-f47b-56e6-bf6d-5ad197d70732"] ["answer-field-68f65a3c-aa44-5a53-857d-09108a8b580f" :answer-field/choices "answer-c93084f1-f47b-56e6-bf6d-5ad197d70732"] ["question-f3b5ac18-7c76-53e4-b7d2-3ac62a11ea93" :question/answer-fields "answer-field-68f65a3c-aa44-5a53-857d-09108a8b580f"] [17592186105751 :knowledge-point/questions "question-f3b5ac18-7c76-53e4-b7d2-3ac62a11ea93"] ["question-11621803-c2eb-5773-8ffe-0f4ac7a22e24" :question/id #uuid "11621803-c2eb-5773-8ffe-0f4ac7a22e24"] ["question-11621803-c2eb-5773-8ffe-0f4ac7a22e24" :question/math-academy-id "q-141985"] ["question-11621803-c2eb-5773-8ffe-0f4ac7a22e24" :question/problem "${x}^{2}y\\cdot {({x}^{3}y)}^{2}=$"] ["question-11621803-c2eb-5773-8ffe-0f4ac7a22e24" :question/worked-solution "We start by using the power of product rule:\n\n$$\n\\begin{aligned}{x}^{2}y\\cdot {({x}^{3}y)}^{2}={x}^{2}y\\cdot ({x}^{3})^{2}\\cdot {y}^{2} & \\end{aligned}\n$$\n\nThen, we use the power rule:\n\n$$\n\\begin{aligned}{x}^{2}y\\cdot ({x}^{3})^{2}\\cdot {y}^{2} & = \\\\ {x}^{2}y\\cdot {x}^{3\\cdot 2}\\cdot {y}^{2} & = \\\\ {x}^{2}y\\cdot {x}^{6}\\cdot {y}^{2} & \\end{aligned}\n$$\n\nFinally, we use the product rule:\n\n$$\n\\begin{aligned}{x}^{2}y\\cdot {x}^{6}\\cdot {y}^{2} & = \\\\ ({x}^{2}\\cdot {x}^{6})\\cdot (y\\cdot {y}^{2}) & = \\\\ {x}^{2+6}\\cdot {y}^{1+2} & = \\\\ {x}^{8}\\cdot {y}^{3} & = \\\\ {x}^{8}{y}^{3} & \\end{aligned}\n$$"] ["question-11621803-c2eb-5773-8ffe-0f4ac7a22e24" :question/difficulty :question.difficulty/moderate] ["answer-field-30f3163e-b6a0-5c37-924e-1f4431be9678" :answer-field/id #uuid "30f3163e-b6a0-5c37-924e-1f4431be9678"] ["answer-6eb87bf4-b704-5e70-b4f3-5261c9ecd7a4" :answer/id #uuid "6eb87bf4-b704-5e70-b4f3-5261c9ecd7a4"] ["answer-6eb87bf4-b704-5e70-b4f3-5261c9ecd7a4" :answer/type :answer.type/math] ["answer-6eb87bf4-b704-5e70-b4f3-5261c9ecd7a4" :answer/value "{x}^{10}{y}^{4}"] ["answer-16d4aa1a-69ae-5b4c-a5e7-5285bd50e819" :answer/id #uuid "16d4aa1a-69ae-5b4c-a5e7-5285bd50e819"] ["answer-16d4aa1a-69ae-5b4c-a5e7-5285bd50e819" :answer/type :answer.type/math] ["answer-16d4aa1a-69ae-5b4c-a5e7-5285bd50e819" :answer/value "{x}^{11}{y}^{2}"] ["answer-dfe2668c-035e-5e9f-aaa8-412ae410941d" :answer/id #uuid "dfe2668c-035e-5e9f-aaa8-412ae410941d"] ["answer-dfe2668c-035e-5e9f-aaa8-412ae410941d" :answer/type :answer.type/math] ["answer-dfe2668c-035e-5e9f-aaa8-412ae410941d" :answer/value "{x}^{5}{y}^{3}"] ["answer-d44100e7-af02-52ab-9908-f002db669ae1" :answer/id #uuid "d44100e7-af02-52ab-9908-f002db669ae1"] ["answer-d44100e7-af02-52ab-9908-f002db669ae1" :answer/type :answer.type/math] ["answer-d44100e7-af02-52ab-9908-f002db669ae1" :answer/value "{x}^{6}{y}^{3}"] ["answer-cb228a61-3f9d-5659-ae9c-8dfd49bbaa74" :answer/id #uuid "cb228a61-3f9d-5659-ae9c-8dfd49bbaa74"] ["answer-cb228a61-3f9d-5659-ae9c-8dfd49bbaa74" :answer/type :answer.type/math] ["answer-cb228a61-3f9d-5659-ae9c-8dfd49bbaa74" :answer/value "{x}^{8}{y}^{3}"] ["answer-field-30f3163e-b6a0-5c37-924e-1f4431be9678" :answer-field/key "selection"] ["answer-field-30f3163e-b6a0-5c37-924e-1f4431be9678" :answer-field/type :answer-field.type/radio] ["answer-field-30f3163e-b6a0-5c37-924e-1f4431be9678" :answer-field/correct "answer-cb228a61-3f9d-5659-ae9c-8dfd49bbaa74"] ["answer-field-30f3163e-b6a0-5c37-924e-1f4431be9678" :answer-field/choices "answer-6eb87bf4-b704-5e70-b4f3-5261c9ecd7a4"] ["answer-field-30f3163e-b6a0-5c37-924e-1f4431be9678" :answer-field/choices "answer-16d4aa1a-69ae-5b4c-a5e7-5285bd50e819"] ["answer-field-30f3163e-b6a0-5c37-924e-1f4431be9678" :answer-field/choices "answer-dfe2668c-035e-5e9f-aaa8-412ae410941d"] ["answer-field-30f3163e-b6a0-5c37-924e-1f4431be9678" :answer-field/choices "answer-d44100e7-af02-52ab-9908-f002db669ae1"] ["answer-field-30f3163e-b6a0-5c37-924e-1f4431be9678" :answer-field/choices "answer-cb228a61-3f9d-5659-ae9c-8dfd49bbaa74"] ["question-11621803-c2eb-5773-8ffe-0f4ac7a22e24" :question/answer-fields "answer-field-30f3163e-b6a0-5c37-924e-1f4431be9678"] [17592186110661 :knowledge-point/questions "question-11621803-c2eb-5773-8ffe-0f4ac7a22e24"] ["question-2b6ddb3f-4ad3-5b3b-b8b2-23791ddb8dd3" :question/id #uuid "2b6ddb3f-4ad3-5b3b-b8b2-23791ddb8dd3"] ["question-2b6ddb3f-4ad3-5b3b-b8b2-23791ddb8dd3" :question/math-academy-id "q-166605"] ["question-2b6ddb3f-4ad3-5b3b-b8b2-23791ddb8dd3" :question/problem "![](images/06/06616bd59152ad40f051177a319b6a54c4e6df2c60ba04bc6056fa3ceea98c03.png)\n\nConsider $△PQR$ shown above. The line segment $\\overset{―}{QH}$ is the altitude corresponding to $\\overset{―}{PR}.$ If $m∠QRP={155}^{∘},$ calculate $m∠RQH.$"] ["question-2b6ddb3f-4ad3-5b3b-b8b2-23791ddb8dd3" :question/worked-solution "Since the straight angle must have a measure of ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠QRP+m∠HRQ & ={180}^{∘} \\\\ {155}^{∘}+m∠HRQ & ={180}^{∘} \\\\ m∠HRQ & ={25}^{∘}.\\end{aligned}\n$$\n\nNote that $△QHR$ is a right triangle. Since its interior angles must sum to ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠RQH+m∠HRQ+m∠QHR & ={180}^{∘} \\\\ m∠RQH+{25}^{∘}+{90}^{∘} & ={180}^{∘} \\\\ m∠RQH+{115}^{∘} & ={180}^{∘} \\\\ m∠RQH & ={65}^{∘}.\\end{aligned}\n$$"] ["question-2b6ddb3f-4ad3-5b3b-b8b2-23791ddb8dd3" :question/difficulty :question.difficulty/easy] ["answer-field-18ef1367-2b1e-5456-9cb2-9b7234a263ce" :answer-field/id #uuid "18ef1367-2b1e-5456-9cb2-9b7234a263ce"] ["answer-c430c6a4-1994-5032-b37e-9d863f70d745" :answer/id #uuid "c430c6a4-1994-5032-b37e-9d863f70d745"] ["answer-c430c6a4-1994-5032-b37e-9d863f70d745" :answer/type