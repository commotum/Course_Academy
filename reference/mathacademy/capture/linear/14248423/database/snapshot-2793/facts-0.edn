$" #edb/ref 17592186045417] [17592186069943 #edb/ref 1065 1606 #edb/ref 17592186045417] [17592186069943 #edb/ref 1066 #uuid "169256a7-1898-59b1-a7a9-f8cb8b713d51" #edb/ref 17592186045417] [17592186069943 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186105749 #edb/ref 1037 #edb/ref 17592186048201 #edb/ref 17592186045417] [17592186105749 #edb/ref 1038 #edb/ref 17592186106212 #edb/ref 17592186045417] [17592186105749 #edb/ref 1038 #edb/ref 17592186106393 #edb/ref 17592186045417] [17592186105749 #edb/ref 1038 #edb/ref 17592186506537 #edb/ref 17592186045417] [17592186105749 #edb/ref 1038 #edb/ref 17592186506538 #edb/ref 17592186045417] [17592186105749 #edb/ref 1039 "Identifying Exterior Angles" #edb/ref 17592186045417] [17592186105749 #edb/ref 1041 #edb/ref 17592186105471 #edb/ref 17592186045417] [17592186105749 #edb/ref 1042 #uuid "9846ca00-8305-56a8-a14d-7aa2488c0016" #edb/ref 17592186045417] [17592186105750 #edb/ref 1037 #edb/ref 17592186048725 #edb/ref 17592186045417] [17592186105750 #edb/ref 1038 #edb/ref 17592186106033 #edb/ref 17592186045417] [17592186105750 #edb/ref 1038 #edb/ref 17592186106077 #edb/ref 17592186045417] [17592186105750 #edb/ref 1038 #edb/ref 17592186506512 #edb/ref 17592186045417] [17592186105750 #edb/ref 1038 #edb/ref 17592186518119 #edb/ref 17592186045417] [17592186105750 #edb/ref 1039 "Calculating Exterior Angles" #edb/ref 17592186045417] [17592186105750 #edb/ref 1041 #edb/ref 17592186105472 #edb/ref 17592186045417] [17592186105750 #edb/ref 1042 #uuid "5de9bf2f-b11c-5af0-a569-5f25aebae227" #edb/ref 17592186045417] [17592186105751 #edb/ref 1037 #edb/ref 17592186048673 #edb/ref 17592186045417] [17592186105751 #edb/ref 1037 #edb/ref 17592186050452 #edb/ref 17592186045417] [17592186105751 #edb/ref 1038 #edb/ref 17592186106199 #edb/ref 17592186045417] [17592186105751 #edb/ref 1038 #edb/ref 17592186106390 #edb/ref 17592186045417] [17592186105751 #edb/ref 1038 #edb/ref 17592186506556 #edb/ref 17592186045417] [17592186105751 #edb/ref 1038