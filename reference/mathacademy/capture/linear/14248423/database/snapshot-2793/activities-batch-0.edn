#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186116396} :activity/id #uuid "3186d920-ff1f-5f36-a31d-2756c7f5f4f9" :activity/scope {:db/id #edb/ref 17592186048472 :topic/id #uuid "a26cd4f5-8420-5521-8401-af794c94636b" :topic/math-academy-id 1644} :activity/steps [{:db/id #edb/ref 17592186116268 :step/content {:db/id #edb/ref 17592186115336 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115160 :question/id #uuid "43c770ec-d353-5e9e-b44e-f06417dab2ab" :question/math-academy-id "e-9731"} :knowledge-point/id #uuid "6a916099-a237-5612-b7f1-3679b7ff069d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048723} {:db/id #edb/ref 17592186049949} {:db/id #edb/ref 17592186050410}] :knowledge-point/questions [{:db/id #edb/ref 17592186115491} {:db/id #edb/ref 17592186115655} {:db/id #edb/ref 17592186253502} {:db/id #edb/ref 17592186253503} {:db/id #edb/ref 17592186269004} {:db/id #edb/ref 17592186294980} {:db/id #edb/ref 17592186500347}] :knowledge-point/title "Calculating an Unknown Angle"} :step/id #uuid "9cedeba2-5a6c-5062-880b-beb7fa0aa70f" :step/math-academy-id 36502} {:db/id #edb/ref 17592186116396 :step/content {:db/id #edb/ref 17592186116449 :tutorial/content "Consider $\\triangle ABC$ shown below. \n\n![](images/6f/6fdb9a8337d16f1ef1910989b3df92844c5393c33108f98ae7993cc939bed0b3.png)\n\nNow, let's draw a line segment that \n\n- runs from $\\color{blue}C$ to the line ${\\color{red}\\overset{\\longleftrightarrow}{AB}},$ and\n\n- is *perpendicular* to ${\\color{red}\\overset{\\longleftrightarrow}{AB}}.$\n\nThis line segment is the dashed segment shown below:\n\n![](images/4a/4a7ee2771c9b0c60dbb07c43b0439e822ea9b2c261ac41af9b44fec72b9f2a91.png)\n\nFinally, let's label the other endpoint of our segment ${\\color{blue}{H}}.$\n\n![](images/75/758eab533719220515460b6677054438a9ac0e2701d1a5267b973e526f63bd90.png)\n\nNote the following:\n\n- The line segment ${\\color{blue}\\overline{CH}}$ is called the **height** (or **altitude**) *corresponding to* ${\\color{red}\\overset{\\longleftrightarrow}{AB}}.$\n\n- The line $\\overset{\\longleftrightarrow}{AB}$ is called the **base** of the altitude ${\\color{blue}\\overline{CH}}.$\n\nAs we'll soon discover, the heights and their corresponding bases are important attributes of triangles." :tutorial/id #uuid "bdb9bfbd-b830-51f0-8712-5d34f83f2812" :tutorial/math-academy-id 2232 :tutorial/title "Introduction"} :step/id #uuid "4231f520-72fe-5c14-8733-25cc76a6e65e" :step/math-academy-id 9151 :step/next {:db/id #edb/ref 17592186116397}} {:db/id #edb/ref 17592186116397 :step/content {:db/id #edb/ref 17592186115409 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114985 :question/id #uuid "972fe403-9a15-5d10-8f9f-f5c93eb586ff" :question/math-academy-id "e-2725"} :knowledge-point/id #uuid "f7e817a0-edcf-54ca-ba4c-ffe91af04675" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050357}] :knowledge-point/questions [{:db/id #edb/ref 17592186115646} {:db/id #edb/ref 17592186115952} {:db/id #edb/ref 17592186253495} {:db/id #edb/ref 17592186253496} {:db/id #edb/ref 17592186294864} {:db/id #edb/ref 17592186386882} {:db/id #edb/ref 17592186393737} {:db/id #edb/ref 17592186500371}] :knowledge-point/title "Finding a Height of a Triangle"} :step/id #uuid "52e4c58c-e58e-5223-98e5-cc31383de47c" :step/math-academy-id 9154 :step/next {:db/id #edb/ref 17592186116398}} {:db/id #edb/ref 17592186116398 :step/content {:db/id #edb/ref 17592186116450 :tutorial/content "We can draw exactly three heights (or altitudes) in any triangle. However, sometimes the height lies outside the triangle.\n\nTo demonstrate, consider $\\triangle{ABC}$ below.\n\n![](images/df/df1ac2c1074305f8ead506d9aeb8c3927ad51ae5949b45976f1971b52d402ee5.png)\n\nThe height corresponding to $\\overline{BC}$ is a line segment that \n\n- runs from the opposite vertex $A$ to the line $\\overset{\\longleftrightarrow}{BC},$ and\n\n- is perpendicular to $\\overset{\\longleftrightarrow}{BC}.$\n\nIn this case, it's impossible to draw a perpendicular from $A$ to the *segment* $\\overline{BC}.$ However, we can first *extend* the line segment $\\overline{BC}$ as follows:\n\n![](images/26/26bf9eb8af1e9b71c263c08cae5797d5c911410985cdc01213ac2c295f7b8d46.png)\n\nNow, we draw the perpendicular from $A$ to $\\overset{\\longleftrightarrow}{BC}.$ This gives the height $\\overline{AH}{:}$\n\n![](images/89/894686fce1393ebcf998be6885020627c9f3cde5916adfec67234f15f8895826.png)" :tutorial/id #uuid "4031d801-f4b8-543f-ad4d-9ef60d513427" :tutorial/math-academy-id 2236 :tutorial/title "Case of Extended Bases"} :step/id #uuid "b9f034d0-1d0e-54ea-83b8-ad683048d5c5" :step/math-academy-id 9158 :step/next {:db/id #edb/ref 17592186116399}} {:db/id #edb/ref 17592186116399 :step/content {:db/id #edb/ref 17592186115410 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114986 :question/id #uuid "2e6213d0-702f-5795-a99a-0051790c4e6d" :question/math-academy-id "e-2730"} :knowledge-point/id #uuid "6a76efbd-cefd-5aa0-953e-8ab50bec7ae0" :knowledge-point/questions [{:db/id #edb/ref 17592186115647} {:db/id #edb/ref 17592186115648} {:db/id #edb/ref 17592186253497} {:db/id #edb/ref 17592186335937} {:db/id #edb/ref 17592186392742} {:db/id #edb/ref 17592186392952} {:db/id #edb/ref 17592186500367} {:db/id #edb/ref 17592186564510} {:db/id #edb/ref 17592186564516}] :knowledge-point/title "Finding a Height Corresponding to an Extended Base"} :step/id #uuid "25c91feb-798e-5857-9090-3b36088bc71b" :step/math-academy-id 9160 :step/next {:db/id #edb/ref 17592186116268}}] :activity/title "Heights of Triangles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115444}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186564569} :activity/id #uuid "b344a744-3440-50e5-9d6c-33f6246db0c2" :activity/scope {:db/id #edb/ref 17592186048472 :topic/id #uuid "a26cd4f5-8420-5521-8401-af794c94636b" :topic/math-academy-id 1644} :activity/steps [{:db/id #edb/ref 17592186564569 :step/content {:db/id #edb/ref 17592186294980 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "250975f6-1855-51d4-855b-4756eab86379" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186293090} {:answer/id #uuid "74682fc2-217c-57f5-ab98-c931310e5466" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{18}^{∘}" :db/id #edb/ref 17592186293411} {:answer/id #uuid "7d0ac39b-3059-5c95-9035-fede9601ced2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{15}^{∘}" :db/id #edb/ref 17592186293433} {:answer/id #uuid "c8f82474-ac34-5dcf-9935-8a82efc05435" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{20}^{∘}" :db/id #edb/ref 17592186293712} {:answer/id #uuid "e390ae5f-9602-5bc0-bd7b-333ec91cd6ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{25}^{∘}" :db/id #edb/ref 17592186293825}] :answer-field/correct {:db/id #edb/ref 17592186293712} :answer-field/id #uuid "5dff0f5f-38be-5491-8c48-4be6dc5f48b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186294264}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "94753d7f-95e4-5b39-9c21-ede7ecea7547" :question/math-academy-id "q-27832" :question/problem "![](images/66/6665784a8ce048fd26fbd97038346e8e6fdf6800d645ea0488f1c18986f5864b.png)\n\nConsider the triangle $△ABC$ shown above. The line segment $\\overset{―}{CH}$ is the altitude corresponding to $\\overset{―}{AB}.$ If $m∠BAC={110}^{∘},$ calculate $m∠HCA.$" :question/worked-solution "Since the straight angle must have a measure of ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠HAC+m∠BAC & ={180}^{∘} \\\\ m∠HAC+{110}^{∘} & ={180}^{∘} \\\\ m∠HAC & ={70}^{∘}.\\end{aligned}\n$$\n\nNote that $△ACH$ is a right triangle. Since its interior angles must sum to ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠HCA+m∠HAC+m∠AHC & ={180}^{∘} \\\\ m∠HCA+{70}^{∘}+{90}^{∘} & ={180}^{∘} \\\\ m∠HCA+{160}^{∘} & ={180}^{∘} \\\\ m∠HCA & ={20}^{∘}.\\end{aligned}\n$$"} :step/id #uuid "85fdfdf6-5023-58b6-a609-0e7f25680884" :step/next {:db/id #edb/ref 17592186564593}} {:db/id #edb/ref 17592186564579 :step/content {:db/id #edb/ref 17592186564516 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c137d98-33bd-5cfc-8f63-359ad6471b1e" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/0b/0bc641736877902ac9272906ed276d36d475ef8060c3c00f0814d9881c3a2153.png" :db/id #edb/ref 17592186564157} {:answer/id #uuid "aead06b8-c27b-5d22-b1e5-e50e94418aa7" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b0/b06b43ef5a57621be16e22eeaf3e60f76fc9203752af363ada5e6ab5081cfa19.png" :db/id #edb/ref 17592186564237} {:answer/id #uuid "af7cf62f-39bf-5878-a434-74498dd8362d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/d5/d5cd2b3c3dbc4a9231a8738bea83a51bb731e94ef971864ac9174edcc7f1a3ba.png" :db/id #edb/ref 17592186564240} {:answer/id #uuid "c9c9dd0c-f5d7-5a25-8f7a-404b4d4b1521" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/2e/2e48106e4aedb44faef00060f6af9632bd0c8e62eb8d06f12606c2a476bacac3.png" :db/id #edb/ref 17592186564284} {:answer/id #uuid "e7e35b9d-a5b5-58b5-ad4a-c12b98096c07" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/c7/c7b37d825464a35ef515d3cd7ce388025a1c93e07ae80246344d4785360d5d9e.png" :db/id #edb/ref 17592186564333}] :answer-field/correct {:db/id #edb/ref 17592186564284} :answer-field/id #uuid "678739dc-dd99-5411-8aaf-f8c9ecc011df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186564406}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a800f321-defb-572d-a55b-71be8add2663" :question/math-academy-id "q-118707" :question/problem "![](images/81/812bde152b84abaf518f6e9b09c43824786c724eac768d83e4d53615d69e1693.png)\n\nGiven $△PQR$ shown above, which of the following diagrams represents the height corresponding to $\\overset{―}{PQ}?$" :question/worked-solution "The height (or altitude) corresponding to $\\overset{―}{PQ}$ is a line segment that \n\n- runs from the opposite vertex $R$ to the line $\\overset{⟷}{PQ},$ and\n\n- is perpendicular to $\\overset{⟷}{PQ}.$\n\nTo draw the height, we proceed as follows:\n\n- Extend the line segment $\\overset{―}{PQ}.$\n\n![](images/26/265ee40283911b754264224b3b0f349b24cae377373941304865b336a53c7b8e.png)\n\n- Draw the perpendicular from $R$ to $\\overset{⟷}{PQ}.$\n\n![](images/2e/2e48106e4aedb44faef00060f6af9632bd0c8e62eb8d06f12606c2a476bacac3.png)"} :step/id #uuid "af027b92-4026-580f-8e12-1889fa5766ab"} {:db/id #edb/ref 17592186564593 :step/content {:db/id #edb/ref 17592186564510 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09d7bbb4-3bc2-51db-bc57-a7edc95b5b12" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/aa/aa3254d24cd0d21a8a78009c8c07591e34ab46fa0449fc27e179d5a32ac70a17.png" :db/id #edb/ref 17592186563984} {:answer/id #uuid "749fefbd-6ad9-5a5f-8a13-394b61b686ee" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/83/832934fe55d335ac380a03c3baf8e9aaf08127349b1fdb42d20bb990a8416674.png" :db/id #edb/ref 17592186564144} {:answer/id #uuid "bf16add8-dafb-5323-b37a-182bc79bf8e8" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b9/b96c5fd6b4bce6744402275432a85e8ee4c31f32fd2f5dbfde593626e5bbff3a.png" :db/id #edb/ref 17592186564261} {:answer/id #uuid "c4ee513f-9682-5bc9-85b8-9ce4afe58e11" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/6d/6db153bb43ae3a25eecb7f9dad30b5631137ca81b51480c72d4228d0a7b007bb.png" :db/id #edb/ref 17592186564273} {:answer/id #uuid "e22f0b89-ef15-50d8-9928-9838ddb470b7" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/01/01a61d38b1586958f887a12389d435faa70fc0988616e3dc4304860f49e96919.png" :db/id #edb/ref 17592186564324}] :answer-field/correct {:db/id #edb/ref 17592186563984} :answer-field/id #uuid "7bb3a80b-5e49-595e-8543-da11372ae2a4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186564413}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "97cef597-7bfc-539c-89dd-d586cabec0a9" :question/math-academy-id "q-118706" :question/problem "![](images/1b/1b3636b4a0534a8794c7b7955aa16d8bb90d98dcdaebbc40311c2e13e971e7af.png)\n\nGiven $△PQR$ shown above, which of the following diagrams represents the height corresponding to $\\overset{―}{PR}?$" :question/worked-solution "The height (or altitude) corresponding to $\\overset{―}{PR}$ is a line segment that \n\n- runs from the opposite vertex $Q$ to the line $\\overset{⟷}{PR},$ and\n\n- is perpendicular to $\\overset{⟷}{PR}.$\n\nTo draw the height, we proceed as follows:\n\n- Extend the line segment $\\overset{―}{PR}.$\n\n![](images/94/94e65bdbb5e82c72b97f69ab2da1b16e2efe8399a83e78a2721d1e74eaa9b8b4.png)\n\n- Draw the perpendicular from $Q$ to $\\overset{⟷}{PR}.$\n\n![](images/aa/aa3254d24cd0d21a8a78009c8c07591e34ab46fa0449fc27e179d5a32ac70a17.png)"} :step/id #uuid "ede84000-89a5-5f8c-b530-b23f7c1c76f7" :step/next {:db/id #edb/ref 17592186564579}}] :activity/title "Heights of Triangles" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186563966}] [{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186176918} :activity/id #uuid "4afc24dd-0109-5622-989e-7e2ca31e311d" :activity/scope {:db/id #edb/ref 17592186049023 :topic/id #uuid "d48953c1-0284-552d-8c62-2e8502548973" :topic/math-academy-id 3577} :activity/steps [{:db/id #edb/ref 17592186176675 :step/content {:db/id #edb/ref 17592186175949 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175797 :question/id #uuid "1c852599-e08e-5b54-be2b-700c3f8f47f2" :question/math-academy-id "e-6931"} :knowledge-point/id #uuid "2d960485-d99c-555f-abb6-8e4d0564913e" :knowledge-point/questions [{:db/id #edb/ref 17592186176463} {:db/id #edb/ref 17592186176573} {:db/id #edb/ref 17592186233823} {:db/id #edb/ref 17592186500345}] :knowledge-point/title "Factoring a Trinomial With a Negative Quadratic Term"} :step/id #uuid "a3a92aca-9db7-5c85-bff4-92c8a5b8ea08" :step/math-academy-id 25611} {:db/id #edb/ref 17592186176883 :step/content {:db/id #edb/ref 17592186176064 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175725 :question/id #uuid "2ed3f2e8-2d0e-59e0-a9dc-1856245b768c" :question/math-academy-id "e-1343"} :knowledge-point/id #uuid "41472e46-65d2-579b-85b7-309749ed3a5f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049074} {:db/id #edb/ref 17592186050526}] :knowledge-point/questions [{:db/id #edb/ref 17592186176456} {:db/id #edb/ref 17592186176457} {:db/id #edb/ref 17592186500312} {:db/id #edb/ref 17592186500320}] :knowledge-point/title "Factoring a Trinomial Whose Terms Have a Common Factor"} :step/id #uuid "1445b874-9aa3-5b17-b1f5-d21b64581d54" :step/math-academy-id 4262 :step/next {:db/id #edb/ref 17592186176675}} {:db/id #edb/ref 17592186176918 :step/content {:db/id #edb/ref 17592186176965 :tutorial/content "Suppose we want to factor the polynomial \n\n$$\n8x^2 + 24x + 16.\n$$\n\nAt first glance, it looks tricky because the coefficients are rather large! \n\nHowever, notice that all the terms have a common factor of $8.$ If we first factor out an $8$ from each of the terms, then we can cut the factoring down to something more manageable:\n\n$$\n\\eqalign{\n\t\t8x^2 + 24x + 16 &= \\[5pt]\n\t\t8(x^2 + 3x + 2)\n\t}\n$$\n\nNow, we need to factor the polynomial $x^2 + 3x + 2$ in the parentheses.\n\nThe constant term $(2)$ has a single factor pair, namely\n\n$$\n(1, 2).\n$$\n\n \n\nNotice that the numbers in this factor pair indeed sum to the linear term's coefficient $(1+2=3).$ \n\nSo, we can write the linear term as $3x=x+2x$ and factor as usual:\n\n$$\n\\begin{aligned}{x}^{2}+3x+2 & = \\\\ {x}^{2}+x+2x+2 & = \\\\ ({x}^{2}+x)+(2x+2) & = \\\\ x(x+1)+2(x+1) & = \\\\ (x+2)(x+1)\\end{aligned}\n$$\n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}8{x}^{2}+24x+16 & = \\\\ 8({x}^{2}+3x+2) & = \\\\ 8(x+2)(x+1) & \\end{aligned}\n$$" :tutorial/id #uuid "7336a5d6-0b38-5ba4-b278-aaac6a402ece" :tutorial/math-academy-id 1722 :tutorial/title "Introduction"} :step/id #uuid "5ed6467d-dfe0-510d-a23b-700569abb8d5" :step/math-academy-id 5062 :step/next {:db/id #edb/ref 17592186176883}}] :activity/title "Factoring Trinomials Using Common Factors" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186176126}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186111594} :activity/id #uuid "7fe1fb12-e10b-5870-8007-02f1eb2f68f4" :activity/scope {:db/id #edb/ref 17592186049252 :topic/id #uuid "e6cf27ef-361e-5cae-8ab4-96194d52b166" :topic/math-academy-id 1417} :activity/steps [{:db/id #edb/ref 17592186111594 :step/content {:db/id #edb/ref 17592186111824 :tutorial/content "Sometimes, we might need to use more than one rule of exponents to simplify an expression. First, let's remind ourselves of all of the rules of exponents.\n\n- Radicals as fractional exponents: $\\sqrt[n]{x} = x^{1/n}$\n\n- The product rule: $a^n \\cdot a^m = a^{n+m}$\n\n- The quotient rule: $\\dfrac{a^n}{a^m} = a^{n-m}$\n\n- The power rule: $\\left( a^m \\right)^n = a^{mn}$\n\n- The power of product rule: $(ab)^n = a^nb^n$\n\n- The power of quotient rule: $\\left(\\dfrac a b \\right)^n = \\dfrac{a^n}{b^n}$\n\nAs an example, let's simplify the following expression:\n\n$$\n\\left(u^2 v\\right)^3\n$$\n\nWe start by using the power of product rule:\n\n$$\n\\begin{aligned}{({u}^{2}v)}^{3}={({u}^{2})}^{3}\\cdot {v}^{3}\\end{aligned}\n$$\n\nThen, we use the power rule:\n\n$$\n\\begin{aligned}{({u}^{2})}^{3}\\cdot {v}^{3} & = \\\\ {u}^{(2\\cdot 3)}\\cdot {v}^{3} & = \\\\ {u}^{6}\\cdot {v}^{3} & = \\\\ {u}^{6}{v}^{3}\\end{aligned}\n$$" :tutorial/id #uuid "13b1c64a-c868-5824-919e-c3a665bb4a96" :tutorial/math-academy-id 1485 :tutorial/title "Introduction"} :step/id #uuid "ff971efe-57b1-5d6a-a9d6-53728830ae56" :step/math-academy-id 3561 :step/next {:db/id #edb/ref 17592186111595}} {:db/id #edb/ref 17592186111595 :step/content {:db/id #edb/ref 17592186110661 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110299 :question/id #uuid "ee3fd0ee-77a9-5ebb-9bc9-c7439f5946b4" :question/math-academy-id "e-1088"} :knowledge-point/id #uuid "854edbd5-3aef-5c6b-bb79-967aa241beb2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049729} {:db/id #edb/ref 17592186050208} {:db/id #edb/ref 17592186050802}] :knowledge-point/questions [{:db/id #edb/ref 17592186110915} {:db/id #edb/ref 17592186111165} {:db/id #edb/ref 17592186499508}] :knowledge-point/title "Combining the Rules of Exponents Without Fractions"} :step/id #uuid "a787c3de-89d7-50ac-b1ff-50a2fb31a2ab" :step/math-academy-id 3562 :step/next {:db/id #edb/ref 17592186111596}} {:db/id #edb/ref 17592186111596 :step/content {:db/id #edb/ref 17592186110662 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110300 :question/id #uuid "d8aca072-8ed5-5d49-8d4e-8bcc96a27ddb" :question/math-academy-id "e-1089"} :knowledge-point/id #uuid "736c1b75-fe60-5f0a-b426-a19f3edaaa2b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048180} {:db/id #edb/ref 17592186050672}] :knowledge-point/questions [{:db/id #edb/ref 17592186111086} {:db/id #edb/ref 17592186111192} {:db/id #edb/ref 17592186499549} {:db/id #edb/ref 17592186549971} {:db/id #edb/ref 17592186549985} {:db/id #edb/ref 17592186549990}] :knowledge-point/title "Combining the Rules of Exponents With Fractions"} :step/id #uuid "8884d25c-0665-5e4b-b13b-866ef3ec66f7" :step/math-academy-id 3565 :step/next {:db/id #edb/ref 17592186111601}} {:db/id #edb/ref 17592186111597 :step/content {:db/id #edb/ref 17592186110663 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110301 :question/id #uuid "cf539049-76f2-56c0-a890-00c2d767c0a8" :question/math-academy-id "e-1091"} :knowledge-point/id #uuid "014ea973-359e-53f5-9151-adc85e08bd3f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049089}] :knowledge-point/questions [{:db/id #edb/ref 17592186111333} {:db/id #edb/ref 17592186111391} {:db/id #edb/ref 17592186499483} {:db/id #edb/ref 17592186499500} {:db/id #edb/ref 17592186499524}] :knowledge-point/title "Combining the Rules of Exponents With Radicals"} :step/id #uuid "73248b69-f18a-503e-b712-b3f56ae6841a" :step/math-academy-id 3569} {:db/id #edb/ref 17592186111601 :step/content {:db/id #edb/ref 17592186111904 :tutorial/content "To simplify the expression $x\\cdot \\sqrt[3]{x^2},$ we first rewrite the radical as a fractional exponent:\n\n$$\nx \\cdot \\sqrt[3]{x^2} = x \\cdot \\left( x^2 \\right)^{1/3}\n$$\n\nNow, we apply the power rule for exponents:\n\n$$\nx \\cdot \\left( x^2 \\right)^{1/3} = x \\cdot x^{2(1/3)} = x \\cdot x^{2/3}\n$$\n\nThen, we apply the product rule:\n\n$$\n\\begin{aligned}x\\cdot {x}^{2/3} & = \\\\ {x}^{1+2/3} & = \\\\ {x}^{5/3} & \\end{aligned}\n$$\n\nFinally, we express the result as a radical:\n\n$$\nx^{5/3} = \\sqrt[3]{x^5}\n$$\n\nNotice that, by combining the radicals as fractional exponents and power rules, we get the following formula:\n\n$$\n\\sqrt[n]{x^m} = x^{m/n}\n$$" :tutorial/id #uuid "91debf57-af23-518b-b432-ea04beccc17a" :tutorial/math-academy-id 6221 :tutorial/title "Rules of Exponents and Radicals"} :step/id #uuid "d8d59c7e-2b45-5493-a09c-f4211a690c16" :step/math-academy-id 37772 :step/next {:db/id #edb/ref 17592186111597}}] :activity/title "Combining the Rules of Exponents With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110813}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186550045} :activity/id #uuid "635a428f-cdf1-5972-bb3d-42ad8fc88328" :activity/scope {:db/id #edb/ref 17592186049252 :topic/id #uuid "e6cf27ef-361e-5cae-8ab4-96194d52b166" :topic/math-academy-id 1417} :activity/steps [{:db/id #edb/ref 17592186550042 :step/content {:db/id #edb/ref 17592186549990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12c046f7-1d2c-5c08-94f0-b15b0633518f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186549346} {:answer/id #uuid "17eac886-4e63-5300-aa99-dd71380871fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186549363} {:answer/id #uuid "91bde951-cb8f-577a-896b-ce42dc1b9fb7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186549601} {:answer/id #uuid "9b468f4f-c3de-5872-a718-b96e20c9f9a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186549615} {:answer/id #uuid "d8927f65-02e1-588d-9e78-6fe1b24c1d71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186549717}] :answer-field/correct {:db/id #edb/ref 17592186549601} :answer-field/id #uuid "6938548d-d593-5818-8e31-5db0d3b2686a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549845}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "af8fd3b0-1f7d-5ae6-bdf4-ff12a7c85e49" :question/math-academy-id "q-22308" :question/problem "If $\\frac{{y}^{2}\\cdot {y}^{13}}{{y}^{12}}={y}^{n},$ then $n=$" :question/worked-solution "We start by using the product rule in the numerator:\n\n$$\n\\begin{aligned}\\frac{{y}^{2}\\cdot {y}^{13}}{{y}^{12}} & ={y}^{n} \\\\ \\frac{{y}^{2+13}}{{y}^{12}} & ={y}^{n} \\\\ \\frac{{y}^{15}}{{y}^{12}} & ={y}^{n}\\end{aligned}\n$$\n\nThen, we apply the quotient rule:\n\n$$\n\\begin{aligned}\\frac{{y}^{15}}{{y}^{12}} & ={y}^{n} \\\\ {y}^{15+(-12)} & ={y}^{n} \\\\ {y}^{3} & ={y}^{n}\\end{aligned}\n$$\n\nFinally, since both sides of the equation share the same base ($y$), we can equate the exponents:\n\n$$\n\\begin{aligned}{y}^{3} & ={y}^{n} \\\\ 3 & =n\\end{aligned}\n$$\n\nHence, $n=3.$"} :step/id #uuid "385d5250-b237-518e-a161-9e072c92d0c6"} {:db/id #edb/ref 17592186550045 :step/content {:db/id #edb/ref 17592186549985 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3010ad72-5935-55f4-a972-2133c2f9cacc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9{y}^{2}}{{x}^{3}}" :db/id #edb/ref 17592186549420} {:answer/id #uuid "8d3af29e-c891-5b3d-91d7-0ee584444542" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27{y}^{2}}{{x}^{4}}" :db/id #edb/ref 17592186549589} {:answer/id #uuid "bd4ed26e-84c6-586f-98a0-82989e8a7dde" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27{y}^{3}}{{x}^{4}}" :db/id #edb/ref 17592186549674} {:answer/id #uuid "cc14420e-7afe-5666-ae48-76b590082c86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27{y}^{3}}{{x}^{6}}" :db/id #edb/ref 17592186549698} {:answer/id #uuid "e785e421-4990-562e-bcc2-6b724b6ea31d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9{y}^{3}}{{x}^{6}}" :db/id #edb/ref 17592186549741}] :answer-field/correct {:db/id #edb/ref 17592186549698} :answer-field/id #uuid "34e11030-4cbc-51ae-ad3e-605289271154" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549826}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9cb24353-5541-5833-aaa7-2a27c3864cfb" :question/math-academy-id "q-424" :question/problem "${(\\frac{3y}{{x}^{2}})}^{3}=$" :question/worked-solution "We start by using the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{3y}{{x}^{2}})}^{3} & = \\\\ \\frac{(3y)^{3}}{{({x}^{2})}^{3}} & \\end{aligned}\n$$\n\nThen, we apply the power of product rule in the numerator and the power rule in the denominator:\n\n$$\n\\begin{aligned}\\frac{(3y)^{3}}{{({x}^{2})}^{3}} & = \\\\ \\frac{{3}^{3}{y}^{3}}{{x}^{2\\cdot 3}} & = \\\\ \\frac{27{y}^{3}}{{x}^{6}} & \\end{aligned}\n$$"} :step/id #uuid "3c44dfa5-7694-5da4-b5f0-5c65abf3a30f" :step/next {:db/id #edb/ref 17592186550076}} {:db/id #edb/ref 17592186550076 :step/content {:db/id #edb/ref 17592186549971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16185a8f-1aed-53a4-8147-fb86611335ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9{a}^{4}{b}^{5}{c}^{8}" :db/id #edb/ref 17592186549356} {:answer/id #uuid "1ca2d046-b650-55fd-a1d2-c96295731924" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9{a}^{8}{b}^{5}{c}^{4}" :db/id #edb/ref 17592186549372} {:answer/id #uuid "28dcf52a-fdfa-5969-9364-91741721e814" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9{a}^{4}{b}^{8}{c}^{5}" :db/id #edb/ref 17592186549402} {:answer/id #uuid "8eb267c2-4d81-510b-a0ac-9f51187c8d5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9{a}^{5}{b}^{4}{c}^{8}" :db/id #edb/ref 17592186549594} {:answer/id #uuid "c5129a7e-e66a-5aca-be73-9cc77c8b5f12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}^{4}{b}^{5}{c}^{8}" :db/id #edb/ref 17592186549682}] :answer-field/correct {:db/id #edb/ref 17592186549356} :answer-field/id #uuid "f0743b1d-d7b4-5ff8-9fc5-8af0138bd88a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549914}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "759e1619-eead-5907-8f58-8d6fbf13ba52" :question/math-academy-id "q-2648" :question/problem "If $x=\\frac{81{a}^{8}}{{b}^{2}{c}^{3}}$ and $y=\\frac{{b}^{7}{c}^{11}}{9{a}^{4}},$ then $xy=$" :question/worked-solution "First, we substitute for $x$ and $y:$\n\n$$\n\\begin{aligned}xy & =(\\frac{81{a}^{8}}{{b}^{2}{c}^{3}})\\cdot (\\frac{{b}^{7}{c}^{11}}{9{a}^{4}}) \\\\  & =\\frac{81{a}^{8}{b}^{7}{c}^{11}}{9{a}^{4}{b}^{2}{c}^{3}}\\end{aligned}\n$$\n\nThen, we separate the fraction, group the three variables separately, and apply the quotient rule:\n\n$$\n\\begin{aligned}\\frac{81{a}^{8}{b}^{7}{c}^{11}}{9{a}^{4}{b}^{2}{c}^{3}} & = \\\\ \\frac{81}{9}\\cdot \\frac{{a}^{8}}{{a}^{4}}\\cdot \\frac{{b}^{7}}{{b}^{2}}\\cdot \\frac{{c}^{11}}{{c}^{3}} & = \\\\ \\frac{81}{9}\\cdot {a}^{(8-4)}\\cdot {b}^{(7-2)}\\cdot {c}^{(11-3)} & = \\\\ 9{a}^{4}{b}^{5}{c}^{8} & \\end{aligned}\n$$"} :step/id #uuid "8b33002d-aae0-5d21-b694-3794848906a8" :step/next {:db/id #edb/ref 17592186550042}}] :activity/title "Combining the Rules of Exponents With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186549306}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186065011} :activity/id #uuid "1279e2e9-86d7-5a4e-b13a-2eb99b4a0896" :activity/scope {:db/id #edb/ref 17592186049270 :topic/id #uuid "e8c80d1f-e431-5719-bd9e-4793fa8d0ec3" :topic/math-academy-id 347} :activity/steps [{:db/id #edb/ref 17592186065011 :step/content {:db/id #edb/ref 17592186065436 :tutorial/content "The **intersection** of two intervals is their set of common values, and is denoted by the intersection symbol $\\cap.$\n\nFor example, the intersection of the two intervals $(-\\infty, 2]$ and $[-1,\\infty)$ is denoted\n\n$$\n(-\\infty, 2] \\cap [-1,\\infty)\n$$\n\nand corresponds to the set of values that are in both intervals $(-\\infty, 2]$ and $[-1,\\infty).$\n\nTo represent the intersection on a number line, we can start by sketching the two intervals separately:\n\n![](images/a0/a0b486ac0f981fc5a0161c5eabba9ec257bd0a03e5f0e27397f6fe8e81eb39a5.png)\n\n![](images/8a/8a98f83055b49c14ed08fff658ace9527c5134879a66245aff02e446d44a5c87.png)\n\nThe intersection $(-\\infty, 2] \\cap [-1,\\infty)$ represents the values that are in both intervals. So, it can be graphed by finding where the two intervals overlap:\n\n![](images/f7/f7a5126928d43be82d3e4a167b52b34d8ed4ec33e94b991ecb8486caf3e3d4a9.png)\n\nTherefore, the intersection of the intervals is ${\\color{blue}[-1,2]}.$ Symbolically, we write\n\n$$\n{\\color{red}(-\\infty,2]} \\cap {\\color{red}[-1,\\infty)} = {\\color{blue}[-1,2]}.\n$$" :tutorial/id #uuid "db563ec9-015b-505d-a764-ade8484216bb" :tutorial/math-academy-id 8683 :tutorial/title "Introduction"} :step/id #uuid "25c811fa-dac2-5b24-9196-30d8ad83117a" :step/math-academy-id 137735 :step/next {:db/id #edb/ref 17592186065012}} {:db/id #edb/ref 17592186065012 :step/content {:db/id #edb/ref 17592186064173 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063972 :question/id #uuid "02afcfcd-c405-5add-a291-75e6db923e3f" :question/math-academy-id "e-13943"} :knowledge-point/id #uuid "630a6635-aac0-5627-82c8-8072b74dd8f3" :knowledge-point/questions [{:db/id #edb/ref 17592186064785} {:db/id #edb/ref 17592186064786} {:db/id #edb/ref 17592186505737} {:db/id #edb/ref 17592186505795}] :knowledge-point/title "Finding the Intersection of Two Intervals Given Graphically"} :step/id #uuid "3c6a47f3-3abf-50de-bc3b-75b0a83b5b99" :step/math-academy-id 137736 :step/next {:db/id #edb/ref 17592186065013}} {:db/id #edb/ref 17592186065013 :step/content {:db/id #edb/ref 17592186064174 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063974 :question/id #uuid "669f96c6-1505-5b02-88aa-c99af18b24d7" :question/math-academy-id "e-13950"} :knowledge-point/id #uuid "4c60e9f3-3322-57c7-85da-e65ea232ef9e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049051} {:db/id #edb/ref 17592186049162}] :knowledge-point/questions [{:db/id #edb/ref 17592186064569} {:db/id #edb/ref 17592186064579} {:db/id #edb/ref 17592186064580} {:db/id #edb/ref 17592186233632} {:db/id #edb/ref 17592186505741} {:db/id #edb/ref 17592186505800}] :knowledge-point/title "Finding the Intersection of Two Intervals"} :step/id #uuid "4c7e66ea-96f0-5fde-bd3f-901111962d77" :step/math-academy-id 137739 :step/next {:db/id #edb/ref 17592186065014}} {:db/id #edb/ref 17592186065014 :step/content {:db/id #edb/ref 17592186064175 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063976 :question/id #uuid "5aa36af9-33b3-58a4-b1ce-297f170faa44" :question/math-academy-id "e-13954"} :knowledge-point/id #uuid "85687901-9285-5cd2-a5f2-24299bd7d3d5" :knowledge-point/questions [{:db/id #edb/ref 17592186064469} {:db/id #edb/ref 17592186064671} {:db/id #edb/ref 17592186233055} {:db/id #edb/ref 17592186233056} {:db/id #edb/ref 17592186505732}] :knowledge-point/title "Finding the Intersection of Two Intervals Given as Inequalities"} :step/id #uuid "6e57c103-8d13-5e55-be9f-a4dad982695b" :step/math-academy-id 137743 :step/next {:db/id #edb/ref 17592186065015}} {:db/id #edb/ref 17592186065015 :step/content {:db/id #edb/ref 17592186064176 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063977 :question/id #uuid "db91e510-bd32-5272-be39-c5015758c81b" :question/math-academy-id "e-13958"} :knowledge-point/id #uuid "d916584b-c94e-557f-a438-f0464c1cea87" :knowledge-point/questions [{:db/id #edb/ref 17592186064669} {:db/id #edb/ref 17592186064702} {:db/id #edb/ref 17592186233057} {:db/id #edb/ref 17592186233684} {:db/id #edb/ref 17592186233748}] :knowledge-point/title "Finding the Intersection of Three Intervals"} :step/id #uuid "d5f87f40-fa8d-5965-8ce9-9b655b869b92" :step/math-academy-id 137746}] :activity/title "Intersections of Intervals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064438}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186180636} :activity/id #uuid "d591686e-75aa-506f-aade-856d6dea793a" :activity/scope {:db/id #edb/ref 17592186049495 :topic/id #uuid "f9324acf-7bff-528d-bb24-b67ba475ce6a" :topic/math-academy-id 3746} :activity/steps [{:db/id #edb/ref 17592186180636 :step/content {:db/id #edb/ref 17592186180660 :tutorial/content "Sometimes, we can use ratios to find quantities that aren't explicitly given in the ratio.\n\nFor instance, suppose that the ratio of boys to girls in the fifth grade is $3: 4.$ If there are $15$ boys, how many students are there in total?\n\nNotice that the \"total number of students\" doesn't appear in the ratio. However, we can find the number of students by adding the total number of boys and the number of girls.\n\nWe start with the ratio ${\\color{blue}3}:{\\color{red}4}$ and write it as a fraction:\n\n$$\n\\dfrac{{\\color{blue}3}}{{\\color{red}4}}\n$$\n\nIn this fraction, the numerator represents the number of boys and the denominator represents the number of girls.\n\nWe know that there are $15$ boys, so we want to make a numerator of $15.$ We can do this by multiplying the numerator and denominator by $5\\mathbin{:}$\n\n$$\n\\dfrac{{\\color{blue}3}\\times 5}{{\\color{red}4}\\times 5} = \\dfrac{{\\color{blue}15}}{{\\color{red}20}}\n$$\n\nTherefore, since there are $15$ boys in the fifth grade, there must also be $20$ girls. So the total number of students is \n\n$$\n{\\color{blue}15} + {\\color{red}20} = 35\\,.\n$$" :tutorial/id #uuid "ca3cabae-8ebe-5879-b608-9d0ebdb233fb" :tutorial/math-academy-id 2051 :tutorial/title "Introduction"} :step/id #uuid "a4a7f682-c223-50f1-a3eb-6b1f79aad9b0" :step/math-academy-id 637169 :step/next {:db/id #edb/ref 17592186180637}} {:db/id #edb/ref 17592186180637 :step/content {:db/id #edb/ref 17592186179817 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179494 :question/id #uuid "02ae40ba-a02c-5025-9597-1968322f2421" :question/math-academy-id "e-2279"} :knowledge-point/id #uuid "0e44aa33-0aca-5cb2-8c89-6391240beed8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050174}] :knowledge-point/questions [{:db/id #edb/ref 17592186180232} {:db/id #edb/ref 17592186180234} {:db/id #edb/ref 17592186275168} {:db/id #edb/ref 17592186275170} {:db/id #edb/ref 17592186332959} {:db/id #edb/ref 17592186332960} {:db/id #edb/ref 17592186504610} {:db/id #edb/ref 17592186504645} {:db/id #edb/ref 17592186516820}] :knowledge-point/title "Calculating an Amount Given a Ratio"} :step/id #uuid "91f76525-9d6e-5ea9-a6a3-b6249f246583" :step/math-academy-id 637170 :step/next {:db/id #edb/ref 17592186180638}} {:db/id #edb/ref 17592186180638 :step/content {:db/id #edb/ref 17592186179818 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179495 :question/id #uuid "4aeb615e-16a1-5170-be5e-fe0f63a5d895" :question/math-academy-id "e-2280"} :knowledge-point/id #uuid "b5406de3-483e-56c2-b9c6-73de6769552e" :knowledge-point/questions [{:db/id #edb/ref 17592186180233} {:db/id #edb/ref 17592186180235} {:db/id #edb/ref 17592186275169} {:db/id #edb/ref 17592186275171} {:db/id #edb/ref 17592186275172} {:db/id #edb/ref 17592186357529} {:db/id #edb/ref 17592186504652} {:db/id #edb/ref 17592186516845}] :knowledge-point/title "Calculating an Amount Given a Ratio as a Fraction"} :step/id #uuid "5f14a9d9-61a5-5432-ad78-2673e2e5e50e" :step/math-academy-id 637173}] :activity/title "Further Reasoning With Equivalent Ratios" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179889}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186516890} :activity/id #uuid "23866e55-455f-5349-a24f-744eddf74337" :activity/scope {:db/id #edb/ref 17592186049495 :topic/id #uuid "f9324acf-7bff-528d-bb24-b67ba475ce6a" :topic/math-academy-id 3746} :activity/steps [{:db/id #edb/ref 17592186516890 :step/content {:db/id #edb/ref 17592186180233 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19618e12-debd-5b4e-9bf1-429e65d1a0bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186330167} {:answer/id #uuid "5a4d2098-760f-5acc-84b4-40651c95e415" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186330758} {:answer/id #uuid "5bdcbebb-943f-5a2c-92b4-c3828824f1a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186330771} {:answer/id #uuid "7d4abe4a-1493-5b17-9061-c2a59e27d5ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186331053} {:answer/id #uuid "fdf4ef6e-5e9b-5fbd-8000-7085f8f93e23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186332185}] :answer-field/correct {:db/id #edb/ref 17592186331053} :answer-field/id #uuid "cecfd35c-e905-59a9-a911-bac01e2f48fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186332560}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9aff327a-3ab5-5bdb-b2ab-437fac7b7394" :question/math-academy-id "q-59895" :question/problem "There are $15$ students in a class, and $\\frac{2}{5}$ of them wear glasses. How many students **do not** wear glasses?" :question/worked-solution "We are given that the ratio of students who wear glasses to the total number of students is $\\frac{2}{5}.$ \n\nIn this fraction, the numerator represents the number of students who wear glasses, and the denominator represents the total number of students.\n\nWe can make a denominator of $15$ by multiplying the numerator and denominator by $3:$\n\n$$\n\\frac{2\\times 3}{5\\times 3}=\\frac{6}{15}\n$$\n\nTherefore, there are $6$ students who wear glasses. \n\nSo the number of students who don't wear glasses is\n\n$$\n15-6=9.\n$$"} :step/id #uuid "351d27f8-ae58-54cf-867a-22cc22f2bf67" :step/next {:db/id #edb/ref 17592186516985}} {:db/id #edb/ref 17592186516960 :step/content {:db/id #edb/ref 17592186516820 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29fbf3dc-a47e-54b1-bcf8-7e68c453ce58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30" :db/id #edb/ref 17592186516198} {:answer/id #uuid "33b33412-cf90-51cd-bf23-bd54dfd122f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186516220} {:answer/id #uuid "635a14ed-c473-5b21-9e9c-024325325da0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "35" :db/id #edb/ref 17592186516327} {:answer/id #uuid "d4530301-1e8c-5fda-aec9-3766286b1b3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "45" :db/id #edb/ref 17592186516559} {:answer/id #uuid "eddc115b-1150-555f-bd2f-52f8639641ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40" :db/id #edb/ref 17592186516604}] :answer-field/correct {:db/id #edb/ref 17592186516604} :answer-field/id #uuid "d304b13f-6fc1-5cd7-bca3-7aa0d027956e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516747}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7dd5c31e-e5f0-51dc-a3ec-12e73e8808ee" :question/math-academy-id "q-147064" :question/problem "The ratio of sheep to goats in Manuel's herd is $3:1.$\nIf Manuel has $30$ sheep, how many animals are in the herd in total?" :question/worked-solution "We start with the ratio $3:1$ and write it as a fraction:\n\n$$\n\\frac{3}{1}\n$$\n\nIn this fraction, the numerator represents the number of sheep, and the denominator represents the number of goats.\n\nWe can make a numerator of $30$ by multiplying the numerator and denominator by $10:$\n\n$$\n\\frac{3\\times 10}{1\\times 10}=\\frac{30}{10}\n$$\n\nTherefore, Manuel has $30$ sheep and $10$ goats. So, the total number of animals in the herd is \n\n$$\n30+10=40.\n$$"} :step/id #uuid "c440cbf8-556c-5d78-8335-881bde443fbb"} {:db/id #edb/ref 17592186516985 :step/content {:db/id #edb/ref 17592186516845 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f71bb97-ece8-546e-a7a7-8359437ebda2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186516320} {:answer/id #uuid "701eba46-6034-5191-b8c0-f4010b286be4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186516363} {:answer/id #uuid "70b5c337-134d-5b23-8234-a694bfeab0ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186516365} {:answer/id #uuid "bff2951a-541e-5f2c-b035-f5b17ef671ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186516519} {:answer/id #uuid "dc72bee6-483f-5536-ad4b-5f542ab698ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186516577}] :answer-field/correct {:db/id #edb/ref 17592186516365} :answer-field/id #uuid "c50e1709-fb35-5c84-a6d5-30b4b5bd93b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516741}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "bea17d69-eb40-57fe-baa2-90eb85105abf" :question/math-academy-id "q-60197" :question/problem "In an electronics store, the ratio of the number of cell phones to the total number of gadgets sold (cell phones and computers) is $\\frac{8}{11}.$ If $16$ cell phones were sold in a week, how many computers were sold?" :question/worked-solution "We are given that the ratio of the number of cell phones sold to the number of gadgets (cell phones and computers) sold is $\\frac{8}{11}.$\n\nIn this fraction, the numerator represents the number of cell phones sold and the denominator represents the number of cell phones and computers sold.\n\nWe can make a numerator of $16$ by multiplying the numerator and denominator by $2:$\n\n$$\n\\frac{8\\times 2}{11\\times 2}=\\frac{16}{22}\n$$\n\nTherefore, the number of cell phones and computers sold that week was $22.$ Of this amount, the number of computers sold was\n\n$$\n22-16=6.\n$$"} :step/id #uuid "fe452996-f813-52b6-bce9-784c946d6846" :step/next {:db/id #edb/ref 17592186516960}}] :activity/title "Further Reasoning With Equivalent Ratios" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186516089}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186116269} :activity/id #uuid "4e5fdcac-beed-5892-9efc-a06702cb9554" :activity/scope {:db/id #edb/ref 17592186049573 :topic/id #uuid "0121d20c-296f-54b7-b81e-a0ffc6a703bc" :topic/math-academy-id 1628} :activity/steps [{:db/id #edb/ref 17592186116269 :step/content {:db/id #edb/ref 17592186116429 :tutorial/content "A function ![](images/93/93f888a1ee0b7da5e29f442f803f1c0eaf73ad02f5eaa97e85bb8a35d607015b.svg) is **strictly increasing** if its ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-value always rises as we increase the ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg)-value. No section of the graph is allowed to be flat.\n\n![](images/f6/f6136545f441473a1c873f7d3296e8d96c23357825ac442ce83ce313f2d74199.png)\n\nOn the other hand, a function ![](images/93/93f888a1ee0b7da5e29f442f803f1c0eaf73ad02f5eaa97e85bb8a35d607015b.svg) is **increasing** if its ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-value *never falls* as we increase the ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg)-value. \n\n**Watch Out!** Increasing functions, like the one below, are allowed to have flat sections.\n\n![](images/b9/b979741f27906322c7ff290ae37bb5214c0c88d30e504fe18569c1f957e3d72e.png)" :tutorial/id #uuid "75e3de1d-9fd6-536a-b21e-7d6434297ce7" :tutorial/math-academy-id 1500 :tutorial/title "Introduction"} :step/id #uuid "19fed9b9-c6e2-5a36-8640-f67f71f20577" :step/math-academy-id 3655 :step/next {:db/id #edb/ref 17592186116270}} {:db/id #edb/ref 17592186116270 :step/content {:db/id #edb/ref 17592186115337 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114915 :question/id #uuid "514bbf6e-7eb5-5158-ac3f-5cb1f88d72d4" :question/math-academy-id "e-1122"} :knowledge-point/id #uuid "b898eab7-cbfc-5ce5-b03a-ed59d875416a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048652} {:db/id #edb/ref 17592186049162}] :knowledge-point/questions [{:db/id #edb/ref 17592186115651} {:db/id #edb/ref 17592186115656} {:db/id #edb/ref 17592186506560} {:db/id #edb/ref 17592186506565}] :knowledge-point/title "Identifying Intervals on Which a Function is Increasing"} :step/id #uuid "878c51c5-4761-5147-9a81-447753be3f73" :step/math-academy-id 3656 :step/next {:db/id #edb/ref 17592186116271}} {:db/id #edb/ref 17592186116271 :step/content {:db/id #edb/ref 17592186116430 :tutorial/content "A function $f(x)$ is **strictly decreasing** if its $y$-value always *falls* as we increase the $x$-value. No section of the graph is allowed to be flat.\n\n![](images/b8/b8a2d54cedc84f159a61bfccc11bdab9adc73eb54b694dd1167802998f4d39d3.png)\n\nOn the other hand, a function $f(x)$ is **decreasing** if its $y$-value *never rises* as we increase the $x$-value. Decreasing functions are allowed to have flat sections.\n\n![](images/4f/4f91b34a57ac42ba82e937c78c74bcb26677e1d6fbf8ed40865f6db73b1cf613.png)" :tutorial/id #uuid "81ea8002-60eb-5227-bbdd-bc329f9f3f89" :tutorial/math-academy-id 1501 :tutorial/title "Decreasing and Strictly Decreasing Functions"} :step/id #uuid "16a2910f-29b2-5b2e-9ad5-d70273d4a38d" :step/math-academy-id 3660 :step/next {:db/id #edb/ref 17592186116272}} {:db/id #edb/ref 17592186116272 :step/content {:db/id #edb/ref 17592186115338 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114916 :question/id #uuid "35bfc06f-0bc4-55b4-a037-49166721c3d5" :question/math-academy-id "e-1123"} :knowledge-point/id #uuid "badbc067-8e47-51ed-9a8c-40725fec2b49" :knowledge-point/questions [{:db/id #edb/ref 17592186115652} {:db/id #edb/ref 17592186115657} {:db/id #edb/ref 17592186506510} {:db/id #edb/ref 17592186506533} {:db/id #edb/ref 17592186506555} {:db/id #edb/ref 17592186506569}] :knowledge-point/title "Identifying Intervals on Which a Function is Decreasing"} :step/id #uuid "7450e4ef-df70-5ca4-8c6d-12844e5fe1ad" :step/math-academy-id 3661}] :activity/title "Increasing and Decreasing Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115437}] [{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186176837} :activity/id #uuid "b9035507-8754-5ae2-a1ef-580b9406be50" :activity/scope {:db/id #edb/ref 17592186049746 :topic/id #uuid "109cf37d-ad54-5b53-ba64-1f478bc5ca24" :topic/math-academy-id 3664} :activity/steps [{:db/id #edb/ref 17592186176786 :step/content {:db/id #edb/ref 17592186176014 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175867 :question/id #uuid "d3520d29-1ecb-5bb0-9c1c-c530fa681853" :question/math-academy-id "e-9316"} :knowledge-point/id #uuid "31bf2725-d2ba-53a8-bbdf-0fd7cd643aca" :knowledge-point/questions [{:db/id #edb/ref 17592186176290} {:db/id #edb/ref 17592186176539} {:db/id #edb/ref 17592186500309} {:db/id #edb/ref 17592186500331} {:db/id #edb/ref 17592186559774} {:db/id #edb/ref 17592186559783} {:db/id #edb/ref 17592186559886}] :knowledge-point/title "Modeling with Inverse Square Laws"} :step/id #uuid "d5420dd5-0691-5226-8163-3d5f81ffc20f" :step/math-academy-id 34865} {:db/id #edb/ref 17592186176787 :step/content {:db/id #edb/ref 17592186176015 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175868 :question/id #uuid "c5c908e5-aa2b-5ba3-bf6c-dfa6fc49c386" :question/math-academy-id "e-9318"} :knowledge-point/id #uuid "920b0639-5f8d-5b4a-b688-4326d14c2a86" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049092} {:db/id #edb/ref 17592186049369}] :knowledge-point/questions [{:db/id #edb/ref 17592186176291} {:db/id #edb/ref 17592186176514} {:db/id #edb/ref 17592186500290} {:db/id #edb/ref 17592186500337}] :knowledge-point/title "Calculating a Constant of Variation"} :step/id #uuid "9bec95a6-c4cf-5bb2-9b8d-d3c10163aa97" :step/math-academy-id 34868 :step/next {:db/id #edb/ref 17592186176917}} {:db/id #edb/ref 17592186176791 :step/content {:db/id #edb/ref 17592186177027 :tutorial/content "![](images/a2/a2bbedb8a024b6cd75c333e2c0cf025558b71eafeb7215d9c7dbf2fbd678230a.png)\n\nIt is known that the gravitational force $F,$ measured in newtons, that the earth exerts on the moon varies inversely with the **square** of the distance $r,$ in kilometers, between their centers.\n\nAccording to this information, the equation that relates $F$ and $r$ is\n\n$$\nF = \\dfrac{k}{r^2},\n$$\n\nwhere $k$ is a constant of variation. This type of relationship is called an **inverse square law**.\n\nAs it turns out, many important physical laws take the form of an inverse square law. Let's see another example." :tutorial/id #uuid "6e6cc0ce-3bd6-5947-b049-60a63924bd23" :tutorial/math-academy-id 5696 :tutorial/title "Inverse Square Laws"} :step/id #uuid "3b1ff76e-dab3-5822-9f2b-e01a3ba037bd" :step/math-academy-id 34964 :step/next {:db/id #edb/ref 17592186176786}} {:db/id #edb/ref 17592186176837 :step/content {:db/id #edb/ref 17592186176961 :tutorial/content "When an object moves at a constant speed $v,$ the distance $d$ that it travels and the time $t$ are related by the equation\n\n$$\nd = vt.\n$$\n\nSuppose that we want to know how long it takes for an object to travel a *fixed* distance. We start by rewriting the above equation for $t\\mathbin :$\n\n$$\n\\begin{aligned}t & =\\frac{d}{v}\\end{aligned}\n$$\n\nSince $d$ is fixed (i.e. constant), it follows that the time $t$ varies inversely with the velocity $v,$ and $d$ is the constant of variation. \n\nIntuitively, the fact that this is an inverse variation makes sense. The larger the speed of our object, the smaller the time it takes to cover a fixed distance, and vice-versa.\n\nSuppose we're told that an object takes $t=10$ seconds to cover a particular distance when traveling with a speed of $v=5$ meters per second. Then, we can solve for $d$ as follows:\n\n$$\n\\begin{aligned}t & =\\frac{d}{v} \\\\ 10 & =\\frac{d}{5} \\\\ 10\\cdot 5 & =d \\\\ 50 & =d\\end{aligned}\n$$\n\nTherefore, we have the inverse variation equation\n\n$$\nt = \\dfrac{50}{v}.\n$$\n\nWe can now use this equation to find the amount of time the object takes to cover the same fixed distance for different speeds." :tutorial/id #uuid "d738193b-1de7-58d9-b145-0f84d66d9c3b" :tutorial/math-academy-id 1512 :tutorial/title "Introduction"} :step/id #uuid "7f194aeb-30f4-5e7e-8022-d36f14b0c127" :step/math-academy-id 3737 :step/next {:db/id #edb/ref 17592186176787}} {:db/id #edb/ref 17592186176917 :step/content {:db/id #edb/ref 17592186176078 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175745 :question/id #uuid "231b7b37-4fdc-5535-a73f-7fb743091311" :question/math-academy-id "e-1581"} :knowledge-point/id #uuid "91394e22-dc2a-5304-b9aa-80302de38fb1" :knowledge-point/questions [{:db/id #edb/ref 17592186176294} {:db/id #edb/ref 17592186176513} {:db/id #edb/ref 17592186500343} {:db/id #edb/ref 17592186500361} {:db/id #edb/ref 17592186559835} {:db/id #edb/ref 17592186559859}] :knowledge-point/title "Modeling With Inverse Variation"} :step/id #uuid "14b0e70f-af6c-594e-b86d-ef230d231ad1" :step/math-academy-id 4995 :step/next {:db/id #edb/ref 17592186176791}}] :activity/title "Modeling With Inverse Variation" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186176168}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186559957} :activity/id #uuid "f61c7a57-02b3-5f4f-b843-60cea6ec4bde" :activity/scope {:db/id #edb/ref 17592186049746 :topic/id #uuid "109cf37d-ad54-5b53-ba64-1f478bc5ca24" :topic/math-academy-id 3664} :activity/steps [{:db/id #edb/ref 17592186559911 :step/content {:db/id #edb/ref 17592186559835 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f96646a-20b2-54f6-ac4d-afa9fbd983c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30\\,min" :db/id #edb/ref 17592186559049} {:answer/id #uuid "331be38b-9e6c-5e90-9477-39943ce1f0a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13\\,min" :db/id #edb/ref 17592186559145} {:answer/id #uuid "65a769b0-ef43-5a92-8d94-9f93a82f87e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20\\,min" :db/id #edb/ref 17592186559267} {:answer/id #uuid "dfdce043-b80d-5e59-9eaf-4eed1add27d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25\\,min" :db/id #edb/ref 17592186559568} {:answer/id #uuid "ef253e76-101f-5feb-aebb-cc60e77dcb17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15\\,min" :db/id #edb/ref 17592186559595}] :answer-field/correct {:db/id #edb/ref 17592186559595} :answer-field/id #uuid "fb3d5956-200b-5c5c-9bbb-4da333869f74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559769}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "99714685-f61c-5dfd-b220-40d2fda79ac5" :question/math-academy-id "q-120409" :question/problem "The time $t$, in minutes ($min$), it takes for an ice cream to melt is inversely proportional to the environment's temperature $T,$ in degrees Celsius (${}^{∘}C$). If it takes $10\\,min$ for an ice cream to melt at  ${30}^{∘}C,$ how much time it takes for the ice cream to melt at ${20}^{∘}C?$" :question/worked-solution "The time of melting $t$ is inversely proportional to the temperature $T,$ so we have\n\n$$\nt=\\frac{k}{T},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that it takes $10\\,min$ for an ice cream to melt at ${30}^{∘}C.$ We can use this information to solve for $k$ as follows:\n\n$$\n\\begin{aligned}10 & =\\frac{k}{30} \\\\ 10\\cdot 30 & =k \\\\ 300 & =k\\end{aligned}\n$$\n\nWe now have the equation\n\n$$\nt=\\frac{300}{T}.\n$$\n\nWe can use this equation to find the time it takes for the ice cream to melt at ${20}^{∘}C,$ as follows:\n\n$$\nt=\\frac{300}{20}=15\n$$\n\nTherefore, the time it takes for the ice cream to melt when $T={20}^{∘}C$ is $t=15\\,min.$"} :step/id #uuid "2c17c573-86f7-52cc-9a73-40fbc246029e"} {:db/id #edb/ref 17592186559916 :step/content {:db/id #edb/ref 17592186559886 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7837106-1589-57d2-b906-4c9c68e0e446" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "I=\\frac{525}{{d}^{2}}" :db/id #edb/ref 17592186559438} {:answer/id #uuid "d1c463c3-c064-5991-b54e-dd3508c5031c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "I=\\frac{526}{{d}^{2}}" :db/id #edb/ref 17592186559531} {:answer/id #uuid "f1b921b1-ed1b-5178-8c66-9eaae69ad95c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "I=\\frac{572}{{d}^{2}}" :db/id #edb/ref 17592186559605} {:answer/id #uuid "f3366ca9-4710-56bf-af0a-6fb29a726281" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "I=\\frac{539}{{d}^{2}}" :db/id #edb/ref 17592186559608} {:answer/id #uuid "f5e5ce6b-2d1b-5bed-83b2-dcc16add4837" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "I=\\frac{576}{{d}^{2}}" :db/id #edb/ref 17592186559621}] :answer-field/correct {:db/id #edb/ref 17592186559621} :answer-field/id #uuid "9d87431e-d6a3-5dbb-a0b5-cd9dae356e8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559732}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f5ab26d2-91d7-599f-b642-d61eec8ddc94" :question/math-academy-id "q-116315" :question/problem "The intensity $I$ of light, measured in $\\text{lux},$ is inversely proportional to the **square** of the distance $d,$ measured in meters, between the light source and the object being illuminated. A device that measures the light intensity is $12$ meters away from the light source and registers $4$ $\\text{lux}.$  What equation gives the relationship between $I$ and $d?$" :question/worked-solution "Since the intensity $I$ is inversely proportional to the square of the distance $d,$ we must have\n\n$$\nI=\\frac{k}{{d}^{2}},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that $I=4\\,\\text{lux}$ when $d=12\\,\\text{m}.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}4 & =\\frac{k}{{12}^{2}} \\\\ 4 & =\\frac{k}{144} \\\\ 4\\cdot 144 & =k \\\\ 576 & =k\\end{aligned}\n$$\n\nTherefore, our inverse variation equation is\n\n$$\nI=\\frac{576}{{d}^{2}}.\n$$"} :step/id #uuid "3811cab8-bfed-5a2b-a00d-bd53f4bc212a" :step/next {:db/id #edb/ref 17592186559936}} {:db/id #edb/ref 17592186559931 :step/content {:db/id #edb/ref 17592186559783 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55d8ec15-bec9-5145-b56e-63807063355c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "I=\\frac{2\\,850}{{d}^{2}}" :db/id #edb/ref 17592186559236} {:answer/id #uuid "57c4c63f-2fb5-5791-a8d2-3e2f8df27b27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "I=\\frac{2\\,050}{{d}^{2}}" :db/id #edb/ref 17592186559243} {:answer/id #uuid "9060ad28-322c-5fd6-a579-21223cdc86b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "I=\\frac{2\\,350}{{d}^{2}}" :db/id #edb/ref 17592186559375} {:answer/id #uuid "eeb4a91f-d653-5fd6-98e4-36fe04cd33cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "I=\\frac{1\\,630}{{d}^{2}}" :db/id #edb/ref 17592186559593} {:answer/id #uuid "fa966bfa-a7f5-5c04-be74-6a02a6f44a11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "I=\\frac{1\\,850}{{d}^{2}}" :db/id #edb/ref 17592186559632}] :answer-field/correct {:db/id #edb/ref 17592186559243} :answer-field/id #uuid "247bcca9-98a8-5db3-bb40-72912974c475" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559661}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1ed2e1e9-66f4-55a8-9c62-03d8b636c4ac" :question/math-academy-id "q-116337" :question/problem "The intensity of radiation $I,$ in milliroentgen/hour ($\\text{mR}/\\text{h}$), spreading out from an X-ray device is inversely proportional to the **square** of the distance $d,$ measured in meters, between the device and the object being radiated. If a device that measures the radiation intensity registers $82\\,\\text{mR}/\\text{h}$ at a distance of $5\\,\\text{m}.$ What equation gives the relationship between $I$ and $d?$" :question/worked-solution "Since the intensity $I$ is inversely proportional to the square of the distance $d,$ we must have\n\n$$\nI=\\frac{k}{{d}^{2}},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that $82\\,\\text{mR}/\\text{h}$ when $d=5\\,\\text{m}.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}82 & =\\frac{k}{{5}^{2}} \\\\ 82 & =\\frac{k}{25} \\\\ 82\\cdot 25 & =k \\\\ 2\\,050 & =k\\end{aligned}\n$$\n\nTherefore, our inverse variation equation is\n\n$$\nI=\\frac{2\\,050}{{d}^{2}}.\n$$"} :step/id #uuid "55e23826-9116-5685-8d98-1930337eae6d" :step/next {:db/id #edb/ref 17592186559911}} {:db/id #edb/ref 17592186559936 :step/content {:db/id #edb/ref 17592186559774 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f8017c5-3642-5551-85b5-caf0dc92835a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "I=\\frac{5.4}{{r}^{2}}" :db/id #edb/ref 17592186559138} {:answer/id #uuid "4847e4fc-ab7b-5fed-acce-013c3bfb352e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "I=\\frac{6.7}{{r}^{2}}" :db/id #edb/ref 17592186559204} {:answer/id #uuid "84571adf-8d7e-51a8-aab6-154b6d0b6347" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "I=\\frac{6.3}{{r}^{2}}" :db/id #edb/ref 17592186559348} {:answer/id #uuid "c9aa16ec-6b8c-5aca-9762-25ee61f4aec4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "I=\\frac{5.8}{{r}^{2}}" :db/id #edb/ref 17592186559508} {:answer/id #uuid "efc38971-1f12-5920-bd35-8861d39777a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "I=\\frac{4.8}{{r}^{2}}" :db/id #edb/ref 17592186559597}] :answer-field/correct {:db/id #edb/ref 17592186559138} :answer-field/id #uuid "bbbea0b5-e068-501a-85b9-14ebd116cadd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559742}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "04117d3f-552c-54f2-b117-fd9ff4546b57" :question/math-academy-id "q-116321" :question/problem "The irradiance $I,$ in $W/{m}^{2},$ of a lamp placed in the center of a spherical chamber varies inversely with the **square** of the radius $r$ of the spherical chamber, measured in meters. It is known that the irradiance is $0.6\\,W/{m}^{2}$ when the radius of the chamber is $3\\,m.$ What equation gives the relationship between $I$ and $r?$" :question/worked-solution "Since the irradiance $I$ is inversely proportional to the square of the radius of the spherical chamber, $r$, we must have\n\n$$\nI=\\frac{k}{{r}^{2}},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that $I=0.6\\,W/{m}^{2}$ when $r=3\\,\\text{m}.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}0.6 & =\\frac{k}{{3}^{2}} \\\\ 0.6 & =\\frac{k}{9} \\\\ 0.6\\cdot 9 & =k \\\\ 5.4 & =k\\end{aligned}\n$$\n\nTherefore, our inverse variation equation is\n\n$$\nI=\\frac{5.4}{{r}^{2}}.\n$$"} :step/id #uuid "6195b08a-b671-5086-8dde-dbc84452e8ba" :step/next {:db/id #edb/ref 17592186559931}} {:db/id #edb/ref 17592186559957 :step/content {:db/id #edb/ref 17592186559859 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "361e105c-8058-5ba1-9a25-7614fd9ff325" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\,\\text{MPa}" :db/id #edb/ref 17592186559151} {:answer/id #uuid "56b0dd7b-330f-52d2-a1ec-732c410bb6b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3.8\\,\\text{MPa}" :db/id #edb/ref 17592186559238} {:answer/id #uuid "ad0ab94e-ac52-57ec-8d6d-3a909eaf246b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\,\\text{MPa}" :db/id #edb/ref 17592186559450} {:answer/id #uuid "bf7be9cd-c53f-5c97-8fcf-87c050464c14" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.5\\,\\text{MPa}" :db/id #edb/ref 17592186559487} {:answer/id #uuid "d0d2f2e3-319f-50d1-9b74-972ccee98498" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.8\\,\\text{MPa}" :db/id #edb/ref 17592186559523}] :answer-field/correct {:db/id #edb/ref 17592186559151} :answer-field/id #uuid "877db9e7-19c4-5bae-a15a-39d1105acc5d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559721}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cb89cc75-091f-5263-a465-e0004e0e6c85" :question/math-academy-id "q-52004" :question/problem "For a fixed temperature, the pressure $P$ of a gas varies inversely with the volume $V$ that it occupies. When $V=3\\,{\\text{m}}^{3},$ the pressure is $P=2$ megapascal ($\\text{MPa}$). What will be the pressure if the gas is compressed to a container with volume $V=2\\,{\\text{m}}^{3}?$" :question/worked-solution "The pressure $P$ is inversely proportional to the volume $V,$ so we have\n\n$$\nP=\\frac{k}{V},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that when the volume is $V=3\\,{\\text{m}}^{3},$ the pressure is $P=2$ megapascal ($\\text{MPa}$). We can use this information to solve for $k$ as follows:\n\n$$\n\\begin{aligned}2 & =\\frac{k}{3} \\\\ 2\\cdot 3 & =k \\\\ 6 & =k\\end{aligned}\n$$\n\nWe now have the equation\n\n$$\nP=\\frac{6}{V}.\n$$\n\nWe can use this equation to find the pressure when the volume is $V=2\\,{\\text{m}}^{3},$ as follows:\n\n$$\nP=\\frac{6}{2}=3\n$$\n\nTherefore, the pressure of the gas when $V=2\\,{\\text{m}}^{3}$ is $3\\,\\text{MPa}.$"} :step/id #uuid "ac02dbdc-cd9f-55e1-8008-da2bd4772a77" :step/next {:db/id #edb/ref 17592186559916}}] :activity/title "Modeling With Inverse Variation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186559014}] [{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186069800} :activity/id #uuid "180009fa-7306-5958-952a-a560c9c25ac0" :activity/scope {:db/id #edb/ref 17592186050496 :topic/id #uuid "4dc7f0d4-7695-5efd-99c0-299924cc9d4b" :topic/math-academy-id 389} :activity/steps [{:db/id #edb/ref 17592186069762 :step/content {:db/id #edb/ref 17592186068826 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068676 :question/id #uuid "ce2e3248-96e3-5d69-9a16-1a62e0ce0eeb" :question/math-academy-id "e-9980"} :knowledge-point/id #uuid "f2471751-7e5c-5823-9f63-76d14f927db2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049861}] :knowledge-point/questions [{:db/id #edb/ref 17592186069057} {:db/id #edb/ref 17592186069259} {:db/id #edb/ref 17592186233457} {:db/id #edb/ref 17592186501215} {:db/id #edb/ref 17592186501222}] :knowledge-point/title "Simplifying a Radical Expression That Is Not a Perfect Square With Larger Powers"} :step/id #uuid "3a8b2793-a5c0-588d-81b2-ae26ae1802aa" :step/math-academy-id 37585 :step/next {:db/id #edb/ref 17592186069801}} {:db/id #edb/ref 17592186069764 :step/content {:db/id #edb/ref 17592186068828 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068432 :question/id #uuid "a474788c-5b2b-570d-84bf-2c9575ac4f54" :question/math-academy-id "e-10022"} :knowledge-point/id #uuid "3674f343-59bc-5420-9dca-44102b11aba6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049843} {:db/id #edb/ref 17592186049923}] :knowledge-point/questions [{:db/id #edb/ref 17592186069056} {:db/id #edb/ref 17592186069206} {:db/id #edb/ref 17592186501139} {:db/id #edb/ref 17592186501216}] :knowledge-point/title "Simplifying a Radical Expression That Is Not a Perfect Square"} :step/id #uuid "444844cf-a75f-58b6-bbc1-b9439090e46c" :step/math-academy-id 37757 :step/next {:db/id #edb/ref 17592186069762}} {:db/id #edb/ref 17592186069800 :step/content {:db/id #edb/ref 17592186069943 :tutorial/content "The **product rule for radicals** states that the square root of a product equals the product of the square roots:\n\n$$\n\\eqalign{\n\t\t\\sqrt{ab} &=\\sqrt{a} \\cdot \\sqrt{b}\n\t}\n$$\n\nWe can use the product rule to rewrite the square roots of algebraic expressions.\n\nAs an example, let's suppose we want to simplify the following expression:\n\n$$\n\\sqrt{32y}\n$$\n\nFirst, we rewrite $32y$ as the product $16 \\cdot 2y,$ which contains a perfect square $(16){:}$ \n\n$$\n\\eqalign{\n\t\\sqrt{32y}&=\\[5pt]\n\t\\sqrt{16 \\cdot 2y}&=\\[5pt]\n\t\\sqrt{4^2 \\cdot 2y}&\n\n\t}\n$$\n\nThen, we separate the product into two separate radicals using the product rule:\n\n$$\n\\eqalign{\n        \\sqrt{4^2\\cdot 2y}&=\\[3pt]\n        \\sqrt{4^2}\\cdot \\sqrt{2y}&\n\t}\n$$\n\nFinally, we simplify the radical containing the perfect square:\n\n$$\n\\eqalign{\n        \\sqrt{4^2}\\cdot \\sqrt{2y}&=\\[3pt]\n        |4|\\cdot \\sqrt{2y}&=\\[3pt]\n\n\t4\\sqrt{2y}&\n\t}\n$$" :tutorial/id #uuid "169256a7-1898-59b1-a7a9-f8cb8b713d51" :tutorial/math-academy-id 1606 :tutorial/title "Introduction"} :step/id #uuid "bfc154dc-32b4-5e94-a701-30a255009a40" :step/math-academy-id 4304 :step/next {:db/id #edb/ref 17592186069764}} {:db/id #edb/ref 17592186069801 :step/content {:db/id #edb/ref 17592186068852 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068469 :question/id #uuid "969be012-a830-564e-a355-00a4f1985ae8" :question/math-academy-id "e-1363"} :knowledge-point/id #uuid "4df00200-f680-53f3-9b49-700b9ac14204" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050890}] :knowledge-point/questions [{:db/id #edb/ref 17592186069224} {:db/id #edb/ref 17592186069225} {:db/id #edb/ref 17592186501143} {:db/id #edb/ref 17592186554540} {:db/id #edb/ref 17592186554586} {:db/id #edb/ref 17592186554641}] :knowledge-point/title "Simplifying a Radical Expression That Is Not a Perfect Square With Domain Restrictions"} :step/id #uuid "16267a67-a93b-562b-88e6-0963346b1bfb" :step/math-academy-id 4311}] :activity/title "Simplifying Square Root Expressions Using the Product Rule" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068936}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186554671} :activity/id #uuid "18d4c92e-e0a8-5b92-a68e-b9cd79663667" :activity/scope {:db/id #edb/ref 17592186050496 :topic/id #uuid "4dc7f0d4-7695-5efd-99c0-299924cc9d4b" :topic/math-academy-id 389} :activity/steps [{:db/id #edb/ref 17592186554671 :step/content {:db/id #edb/ref 17592186554540 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0431e39d-71d1-5768-88be-409ca33f6c7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{y}^{2}\\sqrt{5}" :db/id #edb/ref 17592186553875} {:answer/id #uuid "369e7a6b-727f-5c71-8be5-8892046afcfb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3y\\sqrt{5}" :db/id #edb/ref 17592186553967} {:answer/id #uuid "78a5d1c0-2297-5d46-9446-2060429a75d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15y" :db/id #edb/ref 17592186554112} {:answer/id #uuid "889645be-9d28-546a-9122-d1ad0f6e84d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5y\\sqrt{3}" :db/id #edb/ref 17592186554155} {:answer/id #uuid "d1a5b4b0-a22e-503c-b26d-aee6391ea028" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{5y}" :db/id #edb/ref 17592186554325}] :answer-field/correct {:db/id #edb/ref 17592186553967} :answer-field/id #uuid "391f389b-05b6-594c-95d0-cca64d0e6b52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186554452}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "09d71431-cc0e-5153-8350-c0a86eafb77b" :question/math-academy-id "q-3047" :question/problem "Simplify $\\sqrt{45{y}^{2}}$ given that $y\\ge 0.$" :question/worked-solution "We first write $45{y}^{2}$ as the product $9{y}^{2}\\cdot 5$ which contains a perfect square $(9{y}^{2}).$ Then, we can separate the product into two separate radicals, one of which can be simplified:\n\n$$\n\\begin{aligned}\\sqrt{45{y}^{2}} & = \\\\ \\sqrt{9{y}^{2}\\cdot 5} & = \\\\ \\sqrt{(3y)^{2}\\cdot 5} & = \\\\ \\sqrt{(3y)^{2}}\\cdot \\sqrt{5} & = \\\\ |3y|\\cdot \\sqrt{5} & = \\\\ |3|\\cdot |y|\\cdot \\sqrt{5} & = \\\\ 3\\cdot |y|\\cdot \\sqrt{5}\\end{aligned}\n$$\n\nSince $y\\ge 0,$ we have $|y|=y,$ and we can simplify further. Therefore, our final answer is\n\n$$\n\\begin{aligned}3\\cdot |y|\\cdot \\sqrt{5} & = \\\\ 3\\cdot y\\cdot \\sqrt{5} & = \\\\ 3y\\sqrt{5}.\\end{aligned}\n$$"} :step/id #uuid "4793c529-2358-59fb-98fc-407d9b60139f" :step/next {:db/id #edb/ref 17592186554727}} {:db/id #edb/ref 17592186554704 :step/content {:db/id #edb/ref 17592186554641 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c8d00de-5cfb-5d7d-b6ce-1a3fcf580c19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{n}^{2}\\sqrt{5n}" :db/id #edb/ref 17592186553951} {:answer/id #uuid "493f354b-b71f-58ef-b5af-c43b305893c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2n\\sqrt{5n}" :db/id #edb/ref 17592186554009} {:answer/id #uuid "8a439d62-6628-5381-a609-99d4cc463d9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5n\\sqrt{2n}" :db/id #edb/ref 17592186554162} {:answer/id #uuid "c8dc9bd6-1c8a-5517-9d4e-a5d506cda766" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{n}^{2}\\sqrt{2n}" :db/id #edb/ref 17592186554312} {:answer/id #uuid "ddeb1d91-9f54-55f6-b72d-fd60d991fa39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{n}^{2}\\sqrt{5n}" :db/id #edb/ref 17592186554353}] :answer-field/correct {:db/id #edb/ref 17592186553951} :answer-field/id #uuid "5f773159-8463-5e37-81f8-8746b86bfcf3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186554468}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f380d0a4-2ab4-5ffd-9f65-88568a9b06d4" :question/math-academy-id "q-33483" :question/problem "Simplify $\\sqrt{20{n}^{5}}.$" :question/worked-solution "We first write $20{n}^{5}$ as the product $4{n}^{4}\\cdot 5n$ which contains a perfect square $(4{n}^{4}).$ Then, we can separate the product into two separate radicals, one of which can be simplified:\n\n$$\n\\begin{aligned}\\sqrt{20{n}^{5}} & = \\\\ \\sqrt{4{n}^{4}\\cdot 5n} & = \\\\ \\sqrt{(2{n}^{2})^{2}\\cdot 5n} & = \\\\ \\sqrt{(2{n}^{2})^{2}}\\cdot \\sqrt{5n} & = \\\\ |2{n}^{2}|\\cdot \\sqrt{5n} & = \\\\ |2|\\cdot |{n}^{2}|\\cdot \\sqrt{5n} & = \\\\ 2\\cdot |{n}^{2}|\\cdot \\sqrt{5n}\\end{aligned}\n$$\n\nA squared number is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have\n\n$$\n\\begin{aligned}2\\cdot |{n}^{2}|\\cdot \\sqrt{5n} & = \\\\ 2\\cdot {n}^{2}\\cdot \\sqrt{5n} & = \\\\ 2{n}^{2}\\sqrt{5n}.\\end{aligned}\n$$"} :step/id #uuid "9070e2ab-f493-5ae1-ae96-aa294b03d716"} {:db/id #edb/ref 17592186554727 :step/content {:db/id #edb/ref 17592186554586 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ac23f07-19eb-5a0a-91fe-2143e303a9c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{a}^{3}{b}^{4}\\sqrt{2a}" :db/id #edb/ref 17592186553890} {:answer/id #uuid "8a26477d-d557-5b83-8ec1-5e390a04ff66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{b}^{4}\\sqrt{2a}" :db/id #edb/ref 17592186554161} {:answer/id #uuid "c3fbfc23-489f-58fe-b8ff-e2ebc4569716" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{b}^{3}\\sqrt{2a}" :db/id #edb/ref 17592186554295} {:answer/id #uuid "cec1e7d9-d8c0-5441-9601-896e2db22b3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8a{b}^{4}\\sqrt{a}" :db/id #edb/ref 17592186554321} {:answer/id #uuid "e7e84788-8981-5728-a6a0-aba9de9a572d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{a}^{2}{b}^{4}\\sqrt{2}" :db/id #edb/ref 17592186554371}] :answer-field/correct {:db/id #edb/ref 17592186553890} :answer-field/id #uuid "aef36574-d26a-51ae-8adf-50d31d43f76c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186554498}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "758c8bb2-c32e-5b6a-b65e-f02ce4ad0d8b" :question/math-academy-id "q-29342" :question/problem "Simplify $\\sqrt{32{a}^{7}{b}^{8}}$ given that $a\\ge 0.$" :question/worked-solution "We first write $32{a}^{7}{b}^{8}$ as the product $16{a}^{6}{b}^{8}\\cdot 2a$ which contains a perfect square $(16{a}^{6}{b}^{8}).$ Then, we separate the product into two separate radicals, one of which can be simplified:\n\n$$\n\\begin{aligned}\\sqrt{32{a}^{7}{b}^{8}} & = \\\\ \\sqrt{16{a}^{6}{b}^{8}\\cdot 2a} & = \\\\ \\sqrt{(4{a}^{3}{b}^{4})^{2}\\cdot 2a} & = \\\\ \\sqrt{(4{a}^{3}{b}^{4})^{2}}\\cdot \\sqrt{2a} & = \\\\ |4{a}^{3}{b}^{4}|\\cdot \\sqrt{2a} & = \\\\ |4|\\cdot |{a}^{3}|\\cdot |{b}^{4}|\\cdot \\sqrt{2a} & = \\\\ 4\\cdot |{a}^{3}|\\cdot |{b}^{4}|\\cdot \\sqrt{2a}\\end{aligned}\n$$\n\nA number raised to the power of four is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have that $|{b}^{4}|={b}^{4}$ and $|{a}^{3}|={a}^{3}.$ Therefore, our final answer is\n\n$$\n\\begin{aligned}4\\cdot |{a}^{3}|\\cdot |{b}^{4}|\\cdot \\sqrt{2a} & = \\\\ 4\\cdot {a}^{3}\\cdot {b}^{4}\\cdot \\sqrt{2a} & = \\\\ 4{a}^{3}{b}^{4}\\sqrt{2a}.\\end{aligned}\n$$"} :step/id #uuid "b80055f6-9aac-5f82-8760-3f10697f55c5" :step/next {:db/id #edb/ref 17592186554704}}] :activity/title "Simplifying Square Root Expressions Using the Product Rule" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186553842}] [{:activity/expected-seconds 900.0 :activity/first-step {:db/id #edb/ref 17592186106643} :activity/id #uuid "e068c66e-c6f9-5b98-88d1-321d4bd52ecb" :activity/scope {:db/id #edb/ref 17592186050650 :topic/id #uuid "5c5917ee-8504-5c4f-8c53-d54f4a7e936f" :topic/math-academy-id 1321} :activity/steps [{:db/id #edb/ref 17592186106643 :step/content {:db/id #edb/ref 17592186107162 :tutorial/content "Consider the polygon $ABCD$, where the side $\\overline{AB}$ is extended beyond the vertex $B.$\n\n![](images/fa/fa23c036920e2c506c38f1e7be8a498c0a349ef145e8c444201665345bc648e4.png)\n\nWe call $\\color{blue}\\angle{CBE}$ the **exterior angle** of the vertex $B$.\n\nGiven a polygon's vertex, the interior and exterior angles are supplementary. So, for the vertex $B,$ we have:\n\n$$\n\\underbrace{\\color{YellowOrange}m\\angle{ABC}}_{\\large\\text{Interior}} \\:+\\: \\underbrace{\\color{blue}m\\angle{CBE}}_{\\large\\text{Exterior}} = 180^\\circ\n$$\n\nWe have the following theorem:\n\nThe measures of the exterior angles of any simple polygon sum to $360^\\circ.$\n\nWe'll show why this theorem is true at the end of the lesson.\n\nLet's label the exterior angles of our polygon below:\n\n![](images/ac/acc0ac90f27a78e83b6b14651f61ddfe6a87afa56b6e51a1af57f5e74c31689f.png)\n\nAccording to our theorem, these four angles sum to $360^\\circ.$\n\n$$\na+b+c+d = 360^\\circ\n$$" :tutorial/id #uuid "6cb4a5ba-6c28-59e2-ab72-89e4f5f69ae3" :tutorial/math-academy-id 8041 :tutorial/title "Introduction"} :step/id #uuid "4bf926eb-9821-545f-b67e-d2d50c4f61f0" :step/math-academy-id 187128 :step/next {:db/id #edb/ref 17592186106644}} {:db/id #edb/ref 17592186106644 :step/content {:db/id #edb/ref 17592186105749 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105471 :question/id #uuid "0cd03b60-baf3-5689-9f84-5f8be9853a9b" :question/math-academy-id "e-12838"} :knowledge-point/id #uuid "9846ca00-8305-56a8-a14d-7aa2488c0016" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048201}] :knowledge-point/questions [{:db/id #edb/ref 17592186106212} {:db/id #edb/ref 17592186106393} {:db/id #edb/ref 17592186506537} {:db/id #edb/ref 17592186506538}] :knowledge-point/title "Identifying Exterior Angles"} :step/id #uuid "2d241585-6a66-55ed-8dd4-a690566db2a8" :step/math-academy-id 187129 :step/next {:db/id #edb/ref 17592186106645}} {:db/id #edb/ref 17592186106645 :step/content {:db/id #edb/ref 17592186105750 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105472 :question/id #uuid "fbc903e6-45ee-53c5-9d31-0edf8140cacd" :question/math-academy-id "e-12839"} :knowledge-point/id #uuid "5de9bf2f-b11c-5af0-a569-5f25aebae227" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048725}] :knowledge-point/questions [{:db/id #edb/ref 17592186106033} {:db/id #edb/ref 17592186106077} {:db/id #edb/ref 17592186506512} {:db/id #edb/ref 17592186518119}] :knowledge-point/title "Calculating Exterior Angles"} :step/id #uuid "80b138e7-13bc-505c-9c7b-e57531dd484d" :step/math-academy-id 187132 :step/next {:db/id #edb/ref 17592186106646}} {:db/id #edb/ref 17592186106646 :step/content {:db/id #edb/ref 17592186105751 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105473 :question/id #uuid "44ea9915-91ca-5abf-a1ac-bb801069ef24" :question/math-academy-id "e-12879"} :knowledge-point/id #uuid "0794b384-c2ff-5d4a-b325-28077b5b1f96" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673} {:db/id #edb/ref 17592186050452}] :knowledge-point/questions [{:db/id #edb/ref 17592186106199} {:db/id #edb/ref 17592186106390} {:db/id #edb/ref 17592186506556} {:db/id #edb/ref 17592186506557} {:db/id #edb/ref 17592186518185} {:db/id #edb/ref 17592186518209}] :knowledge-point/title "Determining an Unknown Quantity Using Exterior Angles"} :step/id #uuid "c27f1faa-2fca-5dc4-8283-8cf462884593" :step/math-academy-id 187135 :step/next {:db/id #edb/ref 17592186106647}} {:db/id #edb/ref 17592186106647 :step/content {:db/id #edb/ref 17592186105752 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105474 :question/id #uuid "e96a16e9-122f-582c-beb9-22ca0d4d7d68" :question/math-academy-id "e-12880"} :knowledge-point/id #uuid "64712488-234f-5d44-92a9-6a4821f2d304" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050127}] :knowledge-point/questions [{:db/id #edb/ref 17592186106078} {:db/id #edb/ref 17592186106488} {:db/id #edb/ref 17592186506562} {:db/id #edb/ref 17592186518110} {:db/id #edb/ref 17592186518205}] :knowledge-point/title "Calculating an Exterior Angle by Determining an Unknown Quantity"} :step/id #uuid "f65fca30-a9ac-5101-b87a-1c01743c0b0b" :step/math-academy-id 187138 :step/next {:db/id #edb/ref 17592186106648}} {:db/id #edb/ref 17592186106648 :step/content {:db/id #edb/ref 17592186107163 :tutorial/content "Why do the exterior angles of a polygon always sum to $360^\\circ?$\n\nSuppose we have an $n$-sided polygon. Then, we have the following:\n\n- There are $n$ pairs of interior-exterior angles, each pair being supplementary (i.e., their measures add to $180^\\circ).$\n\n- Therefore, the sum of the measures of *all* interior-exterior pairs equals ${\\color{blue}n\\cdot 180^\\circ}.$\n\n- In a previous lesson, we saw that the sum of the *interior* angles equals ${\\color{red}{(n-2)\\cdot 180^\\circ}}.$\n\nTherefore, to get the sum of the *exterior* angles, we subtract ${\\color{red}{(n-2)\\cdot 180^\\circ}}$ from ${\\color{blue}n\\cdot 180^\\circ}$ as follows:\n\n$$\n\\begin{aligned}\\text{Sum of Exterior Angles} & =n\\cdot {180}^{∘}-(n-2)\\cdot {180}^{∘} \\\\  & =n\\cdot {180}^{∘}-n\\cdot {180}^{∘}+2\\cdot {180}^{∘} \\\\  & =\\cancel{n\\cdot {180}^{∘}}-\\cancel{n\\cdot {180}^{∘}}+2\\cdot {180}^{∘} \\\\  & =2\\cdot {180}^{∘} \\\\  & ={360}^{∘}\\end{aligned}\n$$\n\nThis proves that the sum of the exterior angles of a (simple) polygon equals $360^\\circ.$" :tutorial/id #uuid "fb5a1532-47ec-5455-96c8-49187460e543" :tutorial/math-academy-id 8042 :tutorial/title "Proving the Theorem"} :step/id #uuid "ee786271-6101-5bf4-9d57-2fe763770d7a" :step/math-academy-id 187141}] :activity/title "Exterior Angles of Polygons" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186105975}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186518231} :activity/id #uuid "4642b563-78a1-574f-85b9-bdf648e97e49" :activity/scope {:db/id #edb/ref 17592186050650 :topic/id #uuid "5c5917ee-8504-5c4f-8c53-d54f4a7e936f" :topic/math-academy-id 1321} :activity/steps [{:db/id #edb/ref 17592186518227 :step/content {:db/id #edb/ref 17592186518119 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6318460b-5678-5646-a910-82e6cf183480" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "77" :db/id #edb/ref 17592186517670}] :answer-field/correct {:db/id #edb/ref 17592186517670} :answer-field/id #uuid "5cb61399-54db-53c5-9e53-bf360481e48d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186518018}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2ac19296-c890-536b-9e9a-47b0cd74c840" :question/math-academy-id "q-223356" :question/problem "![](images/9e/9e40dfd3842ec7a7b5de16d7938988e86209960ae9cba510bbac004b0bb73d94.png)\n\nFor the pentagon above, the measure of the exterior angle of $∠B$ is{{field-1}}\n${}^{∘}.$" :question/worked-solution "Let us call $x$ the exterior angle of $∠B.$ Since the sum of the exterior angles of a polygon is ${360}^{∘}$, we have\n\n$$\n\\begin{aligned}{58}^{∘}+x+{65}^{∘}+{63}^{∘}+{97}^{∘} & ={360}^{∘} \\\\ x+{283}^{∘} & ={360}^{∘} \\\\ x & ={77}^{∘}.\\end{aligned}\n$$"} :step/id #uuid "0e3febc6-ffc1-5247-a54a-b79a2b1756e7"} {:db/id #edb/ref 17592186518231 :step/content {:db/id #edb/ref 17592186518185 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95de501c-c29d-5cbf-9a79-048a79089948" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "26" :db/id #edb/ref 17592186517771}] :answer-field/correct {:db/id #edb/ref 17592186517771} :answer-field/id #uuid "d7ff32db-e290-547d-9167-5bfd000c5b9f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186518076}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b40960a4-3462-5880-9ff6-2c1313bf33f8" :question/math-academy-id "q-171905" :question/problem "![](images/bd/bd6b42e1d48ca0e45ffc9b8910345bea52f1f44f9754f00ac4a4ba034e273bb5.png)\n\nGiven the quadrilateral above, we have $x=${{field-1}}\n${}^{∘}.$" :question/worked-solution "Since the sum of the exterior angles of a polygon is ${360}^{∘}$, we have\n\n$$\n\\begin{aligned}4x+3x+(2x+{20}^{∘})+(5x-{24}^{∘}) & ={360}^{∘} \\\\ 14x-{4}^{∘} & ={360}^{∘} \\\\ 14x & ={364}^{∘} \\\\ x & ={26}^{∘}.\\end{aligned}\n$$"} :step/id #uuid "22c064e1-9b1b-5de4-87cd-f9e10b1b6ac9" :step/next {:db/id #edb/ref 17592186518280}} {:db/id #edb/ref 17592186518272 :step/content {:db/id #edb/ref 17592186518110 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22a27d61-a734-57ce-a1b9-e6a9d52463e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{155}^{∘}" :db/id #edb/ref 17592186517553} {:answer/id #uuid "9ccb46db-67ff-50b8-8b68-b38569111f19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{168}^{∘}" :db/id #edb/ref 17592186517791} {:answer/id #uuid "aefd51f3-7fe9-58df-9f1a-21094a7ee66a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{152}^{∘}" :db/id #edb/ref 17592186517818} {:answer/id #uuid "df4121c9-1388-5799-80fd-0cbb19b668e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{173}^{∘}" :db/id #edb/ref 17592186517909} {:answer/id #uuid "eb7972ee-be19-5bae-a8dd-d693c56fe478" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{163}^{∘}" :db/id #edb/ref 17592186517936}] :answer-field/correct {:db/id #edb/ref 17592186517553} :answer-field/id #uuid "b89379c4-d191-53ca-8ac5-ec0071d31fd7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518057}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "143c348d-4bc6-5a45-bf95-01d78dce959f" :question/math-academy-id "q-223201" :question/problem "![](images/33/33c1016cb2353e5332a5e04e8f377d4fa7d76e1b569a3532a45c5a068cc6d255.png)\n\nFor the quadrilateral above, determine the measure of the exterior angle of $∠C.$" :question/worked-solution "Since the sum of the exterior angles of a polygon is ${360}^{∘},$ we have\n\n$$\n\\begin{aligned}(6x+{23}^{∘})+(17x-{4}^{∘})+(21x+{8}^{∘})+(4x-{3}^{∘}) & ={360}^{∘} \\\\ 48x+{24}^{∘} & ={360}^{∘} \\\\ 48x & ={336}^{∘} \\\\ x & ={7}^{∘}.\\end{aligned}\n$$\n\nTherefore, the measure of the exterior angle of $∠C$ equals\n\n$$\n\\begin{aligned}21x+{8}^{∘} & =21({7}^{∘})+{8}^{∘} \\\\  & ={147}^{∘}+8 \\\\  & ={155}^{∘}.\\end{aligned}\n$$"} :step/id #uuid "91a10bad-5a62-55ff-aa9b-d76baf287c2f" :step/next {:db/id #edb/ref 17592186518276}} {:db/id #edb/ref 17592186518276 :step/content {:db/id #edb/ref 17592186518205 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b680264-dfb5-59a3-bcc8-c4eaa88b0281" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "90" :db/id #edb/ref 17592186517512}] :answer-field/correct {:db/id #edb/ref 17592186517512} :answer-field/id #uuid "b7c212c7-8e24-558b-a30f-86787ad1fb45" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186518055}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "da26be71-f6d6-5898-b94d-3e43f1a50c61" :question/math-academy-id "q-223237" :question/problem "![](images/4c/4c8bc8341b9619e9fddb151b02d2d859fab801fe35114de6b2ce6d09045fff11.png)\n\nFor the quadrilateral above, the measure of the exterior angle of $∠C$ is{{field-1}}\n${}^{∘}.$" :question/worked-solution "Note that the measure of the exterior angle at $B$ is ${180}^{∘}-(4x+{18}^{∘})={162}^{∘}-4x.$\n\nSince the sum of the exterior angles of a polygon is ${360}^{∘}$, we have\n\n$$\n\\begin{aligned}(5x+{15}^{∘})+({162}^{∘}-4x)+(4x-{2}^{∘})+(3x+{1}^{∘}) & ={360}^{∘} \\\\ 8x+{176}^{∘} & ={360}^{∘} \\\\ 8x & ={184}^{∘} \\\\ x & ={23}^{∘}.\\end{aligned}\n$$\n\nTherefore, the measure of the exterior angle of $∠C$ equals\n\n$$\n\\begin{aligned}4x-{2}^{∘} & =4({23}^{∘})-{2}^{∘} \\\\  & ={92}^{∘}-{2}^{∘} \\\\  & ={90}^{∘}.\\end{aligned}\n$$"} :step/id #uuid "98d8757a-5405-536c-b667-673b49141522" :step/next {:db/id #edb/ref 17592186518227}} {:db/id #edb/ref 17592186518280 :step/content {:db/id #edb/ref 17592186518209 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e08b8587-2673-5d67-85be-e9c69a264b9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "60" :db/id #edb/ref 17592186517910}] :answer-field/correct {:db/id #edb/ref 17592186517910} :answer-field/id #uuid "525a4469-4e3e-58b4-bc94-04e70a60046c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186518009}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e54967a4-313f-5425-b80c-928ee57bb212" :question/math-academy-id "q-223198" :question/problem "![](images/a9/a92c3df4f9d410b1a7620cf43b04fda1ce7312cebd8c6077a0b0411ecc78ad73.png)\n\nGiven the quadrilateral above, we have $x=${{field-1}}\n${}^{∘}.$" :question/worked-solution "Since the sum of the exterior angles of a polygon is ${360}^{∘}$, we have\n\n$$\n\\begin{aligned}x+2x+(x+{10}^{∘})+(2x-{10}^{∘}) & ={360}^{∘} \\\\ 6x & ={360}^{∘} \\\\ x & ={60}^{∘}.\\end{aligned}\n$$"} :step/id #uuid "a5175f00-0d37-5905-a6f9-12c953f10f27" :step/next {:db/id #edb/ref 17592186518272}}] :activity/title "Exterior Angles of Polygons" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186517484}] [{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186489345} :activity/id #uuid "f5d315b3-1937-5219-9b02-93324c4b74bb" :activity/scope {:db/id #edb/ref 17592186408188 :topic/id #uuid "24a28f9b-1f4f-5349-9353-6e0a556259c4" :topic/math-academy-id 7011} :activity/steps [{:db/id #edb/ref 17592186489298 :step/content {:db/id #edb/ref 17592186489387 :tutorial/content "It's convenient to use the following special **bar-notation** to indicate decimals that repeat indefinitely:\n\n$$\n0.\\overline{3} = 0.333\\,333\\ldots\n$$\n\nSome decimals have two or more digits that repeat indefinitely. For example:\n\n$$\n\\begin{aligned}0.\\overset{―}{78} & =0.78\\,78\\,78\\,78… \\\\ 0.\\overset{―}{675} & =0.675\\,675\\,675…\\end{aligned}\n$$\n\nSome repeating decimals have non-repeating digits before the repeating part. For example:\n\n$$\n0.45\\overline{67} = 0.45\\,67\\,67\\,67\\,67\\ldots\n$$" :tutorial/id #uuid "8545445f-23ee-5309-8571-5a1f6a4b253d" :tutorial/math-academy-id 15180 :tutorial/title "Notations for Repeating Decimals"} :step/id #uuid "07766a04-75bc-582b-a3f7-a4d9e94b4bfa" :step/math-academy-id 653256 :step/next {:db/id #edb/ref 17592186489373}} {:db/id #edb/ref 17592186489328 :step/content {:db/id #edb/ref 17592186489169 :knowledge-point/canonical-example {:db/id #edb/ref 17592186489196 :question/id #uuid "2953724f-e9c5-5a58-a253-c1d894297cc0" :question/math-academy-id "e-22734"} :knowledge-point/id #uuid "2ee93f86-38d1-591a-b694-a4f455240d75" :knowledge-point/questions [{:db/id #edb/ref 17592186489200} {:db/id #edb/ref 17592186489282} {:db/id #edb/ref 17592186551315}] :knowledge-point/title "Expressing a Rational Number as a Repeating Decimal Using Long Division"} :step/id #uuid "722917c0-0a2f-564d-92a1-3b8f90e0a367" :step/math-academy-id 653258 :step/next {:db/id #edb/ref 17592186489335}} {:db/id #edb/ref 17592186489335 :step/content {:db/id #edb/ref 17592186489170 :knowledge-point/canonical-example {:db/id #edb/ref 17592186489245 :question/id #uuid "975545b6-bff4-5fab-aaf4-e8ee01507788" :question/math-academy-id "e-22727"} :knowledge-point/id #uuid "4c28dcab-dd12-58c2-88c6-0301dc0f9ce4" :knowledge-point/questions [{:db/id #edb/ref 17592186152676} {:db/id #edb/ref 17592186489222}] :knowledge-point/title "Identifying Rational Decimals"} :step/id #uuid "84e16e8f-676c-575f-83e7-d1a743860017" :step/math-academy-id 653261} {:db/id #edb/ref 17592186489343 :step/content {:db/id #edb/ref 17592186489388 :tutorial/content "Let's consider the following rational number:\n\n$$\n\\dfrac13\n$$\n\nTo find its decimal representation, we divide $1$ by $3$ using long division, as follows:\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" width=\"150\">\n<table align=\"left\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"left\" height=\"20\" width=\"20\"></td>\n<td align=\"left\" colspan=\"4\" height=\"20\" width=\"15\">$\\,\\,0 \\,. 3 {\\:\\phantom{|}} 3 {\\:\\phantom{|}} 3$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\:\\ldots$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\">$3$</td>\n<td align=\"left\" colspan=\"4\" height=\"20\" width=\"15\">$\\!\\require{enclose}\\enclose{longdiv}{1 {\\, . \\,} 0  {\\:\\phantom{|}} 0 {\\:\\phantom{|}} 0}$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\!\\!\\!\\!\\!\\!\\!$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$9$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\!\\!\\!\\!\\!$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$9$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\!\\!\\!\\!\\!$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$9$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\,\\ldots$</td>\n</tr>\n</tbody></table>\n<p></p></td>\n</tr>\n</tbody></table>\n\nNotice that, in this case,\n\n- the long division process never ends, and\n\n- the digit $3$ after the decimal point repeats *forever*.\n\nTherefore,\n\n$$\n\\dfrac13 = 0.333\\,333\\ldots\n$$\n\nThis is an example of a **repeating decimal** - a decimal in which the digits after the decimal point continue forever in a *repeating pattern*." :tutorial/id #uuid "b877953a-1821-5fae-aebf-3ff936971679" :tutorial/math-academy-id 15177 :tutorial/title "Repeating Decimals"} :step/id #uuid "989620d9-34b2-5998-bf43-7b078a5551e7" :step/math-academy-id 653255 :step/next {:db/id #edb/ref 17592186489298}} {:db/id #edb/ref 17592186489345 :step/content {:db/id #edb/ref 17592186489385 :tutorial/content "A rational number can have a decimal representation that either *ends* or *repeats*.\n\nIn this lesson, we will see how to convert rational numbers written as fractions into decimals using *long division*. \nWe begin with examples where the decimal terminates. \n\nLet's convert $\\dfrac{7}{2}$ into a decimal using long division.\n\nTo write the fraction as a decimal, we divide the numerator by the denominator:\n\n$$\n7 \\div 2\n$$\n\nWe proceed using long division as usual, stopping once we obtain a remainder of $0\\mathbin{:}$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" width=\"150\">\n<table align=\"left\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"left\" height=\"20\" width=\"20\"></td>\n<td align=\"left\" colspan=\"2\" height=\"20\" width=\"15\">$\\,\\,3    {\\, . \\,} 5$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\">$2$</td>\n<td align=\"left\" colspan=\"2\" height=\"20\" width=\"15\">$\\!\\require{enclose}\\enclose{longdiv}{7   {\\, . \\,} 0}$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\!\\!\\!\\!\\!\\!\\!$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$6$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\!\\!\\!\\!\\!\\!\\!$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n</tr>\n</tbody></table>\n<p></p></td>\n</tr>\n</tbody></table>\n\nTherefore,\n\n$$\n\\dfrac{7}{2} = 3.5.\n$$" :tutorial/id #uuid "6c539020-aca7-5b8f-a2b0-b72c56336242" :tutorial/math-academy-id 15179 :tutorial/title "Introduction"} :step/id #uuid "9d911030-9a41-5eba-8339-d738949a2899" :step/math-academy-id 653251 :step/next {:db/id #edb/ref 17592186489372}} {:db/id #edb/ref 17592186489372 :step/content {:db/id #edb/ref 17592186489171 :knowledge-point/canonical-example {:db/id #edb/ref 17592186489180 :question/id #uuid "11a8381c-60e6-54f2-ac78-bece2edc403e" :question/math-academy-id "e-22733"} :knowledge-point/id #uuid "9f161693-0317-5b9e-9156-c781f703a4c0" :knowledge-point/questions [{:db/id #edb/ref 17592186489205} {:db/id #edb/ref 17592186489207} {:db/id #edb/ref 17592186489227} {:db/id #edb/ref 17592186489286}] :knowledge-point/title "Expressing a Rational Number as a Finite Decimal Using Long Division"} :step/id #uuid "dd795099-acd6-53fe-9be5-05e82111a5a2" :step/math-academy-id 653252 :step/next {:db/id #edb/ref 17592186489343}} {:db/id #edb/ref 17592186489373 :step/content {:db/id #edb/ref 17592186489386 :tutorial/content "The key takeaway for this lesson is that every repeating decimal is rational! In other words, every repeating decimal can be expressed as a ratio of two integers.\n\nFor example:\n\n$$\n\\begin{aligned}0.\\overset{―}{3} & =\\frac{1}{3} \\\\ 0.\\overset{―}{78} & =\\frac{26}{33} \\\\ 0.333\\overset{―}{67} & =\\frac{16517}{49500}\\end{aligned}\n$$\n\nIn a future lesson, we'll learn how to express a repeating decimal as a fraction. For now, you can verify these results using a calculator." :tutorial/id #uuid "77b1162b-17a9-5251-8efe-31b7034274d5" :tutorial/math-academy-id 15181 :tutorial/title "Any Repeating Decimal is a Rational"} :step/id #uuid "e016072c-e22d-536a-a6ed-5eef7793da16" :step/math-academy-id 653257 :step/next {:db/id #edb/ref 17592186489328}}] :activity/title "Rational Numbers as Finite or Repeating Decimals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186488466}]}
