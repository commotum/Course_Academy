#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186567120} :activity/id #uuid "92800552-5c25-5f27-bb78-349b124d8481" :activity/steps [{:db/id #edb/ref 17592186567119 :step/content {:db/id #edb/ref 17592186567084 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01259f40-25a2-5f78-a2c6-2a4064a25000" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186566362} {:answer/id #uuid "272d75fc-e799-5943-a491-5147b2314566" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186566447} {:answer/id #uuid "4ea822fe-d540-5f52-95cf-b0c6ea76fb31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186566512} {:answer/id #uuid "a9731800-5367-5e28-80f3-4e20f6f073f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186566697} {:answer/id #uuid "b44cf978-f362-5a6b-b58a-dc40ec7cde68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186566719}] :answer-field/correct {:db/id #edb/ref 17592186566447} :answer-field/id #uuid "966de87a-ff5f-5fa4-bf5e-d284c88f29c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566948}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c76e6329-2e41-5111-9e2f-17e316c25286" :question/math-academy-id "q-147068" :question/problem "When a coin was tossed $14$ times, $\\frac{4}{7}$ of the tosses landed heads up. How many times did it come up with tails?" :question/worked-solution "We are given that the ratio of heads to the total number of tosses is $\\frac{4}{7}.$ \n\nIn this fraction, the numerator represents the number of heads, and the denominator represents the total number of tosses.\n\nWe can make a denominator of $14$ by multiplying the numerator and denominator by $2:$\n\n$$\n\\frac{4\\times 2}{7\\times 2}=\\frac{8}{14}\n$$\n\nTherefore, it came up with heads $8$ times. \nSo, the number of tails is\n\n$$\n14-8=6.\n$$"} :step/id #uuid "2a7599e0-d833-5e8d-955f-489466bc1e3b"} {:db/id #edb/ref 17592186567120 :step/content {:db/id #edb/ref 17592186567039 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d6bfadd-7df2-5a71-bdb1-030ca706906d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186566424} {:answer/id #uuid "25a5696c-a26b-502d-be4e-0afdfd7f51f8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186566443} {:answer/id #uuid "e29ca0b9-8013-5e7c-88ee-a18445c629ff" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186566822} {:answer/id #uuid "fd529219-bbce-5ad9-9500-b1576186d994" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186566871} {:answer/id #uuid "fe3331e6-1d14-5f24-9a05-99b572f9ab12" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186566872}] :answer-field/correct {:db/id #edb/ref 17592186566443} :answer-field/id #uuid "bcc79105-671c-5be0-a88d-c239f34d4061" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566965}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "545ece5b-8e3c-584b-b6c7-99fcc1c7f1e4" :question/math-academy-id "q-223771" :question/problem "Which of the following numbers are rational?\n\nI. $0.1222$\n\nII. $1.3\\overset{―}{4}$\n\nIII. $1.981354…$" :question/worked-solution "Let's examine each of our numbers in turn.\n\n- $0.1222$ is a rational number because it can be expressed as a ratio of two integers:\n\n$$\n0.1222=\\frac{1\\,222}{10\\,000}\n$$\n\n- $1.3\\overset{―}{4}$ is a rational number. The notation $\\overset{―}{4}$ tells us that the digit $4$ after the decimal point repeats indefinitely.\n\n$$\n1.3\\overset{―}{4}=1.34444444444…\n$$\n\nAny decimal with repeating digits can be represented as a ratio of two integers. In this case,\n\n$$\n1.3\\overset{―}{4}=\\frac{121}{90}.\n$$\n\n- $1.981354…$ is not a rational number. The notation \"$…$\" tells us that digits after the decimal point extend forever. However, there are no repeating digits.\n\nTherefore, the correct answer is \"I and II only.\""} :step/id #uuid "36eb5e9e-96be-54e1-89dd-a085dd36d242" :step/next {:db/id #edb/ref 17592186567130}} {:db/id #edb/ref 17592186567121 :step/content {:db/id #edb/ref 17592186567028 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e1d21e0-54d6-5074-8014-fd2d69018758" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{50}^{∘}" :db/id #edb/ref 17592186566511} {:answer/id #uuid "6273bcce-aef5-5fd0-bccb-2a0969e9fe22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{60}^{∘}" :db/id #edb/ref 17592186566552} {:answer/id #uuid "8c58649b-4e56-5024-8054-56213d633f42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{35}^{∘}" :db/id #edb/ref 17592186566630} {:answer/id #uuid "c430c6a4-1994-5032-b37e-9d863f70d745" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{25}^{∘}" :db/id #edb/ref 17592186566752} {:answer/id #uuid "e2d7a032-9fb1-56b1-93d9-c578bcbe7781" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{65}^{∘}" :db/id #edb/ref 17592186566823}] :answer-field/correct {:db/id #edb/ref 17592186566823} :answer-field/id #uuid "18ef1367-2b1e-5456-9cb2-9b7234a263ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566888}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2b6ddb3f-4ad3-5b3b-b8b2-23791ddb8dd3" :question/math-academy-id "q-166605" :question/problem "![](images/06/06616bd59152ad40f051177a319b6a54c4e6df2c60ba04bc6056fa3ceea98c03.png)\n\nConsider $△PQR$ shown above. The line segment $\\overset{―}{QH}$ is the altitude corresponding to $\\overset{―}{PR}.$ If $m∠QRP={155}^{∘},$ calculate $m∠RQH.$" :question/worked-solution "Since the straight angle must have a measure of ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠QRP+m∠HRQ & ={180}^{∘} \\\\ {155}^{∘}+m∠HRQ & ={180}^{∘} \\\\ m∠HRQ & ={25}^{∘}.\\end{aligned}\n$$\n\nNote that $△QHR$ is a right triangle. Since its interior angles must sum to ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠RQH+m∠HRQ+m∠QHR & ={180}^{∘} \\\\ m∠RQH+{25}^{∘}+{90}^{∘} & ={180}^{∘} \\\\ m∠RQH+{115}^{∘} & ={180}^{∘} \\\\ m∠RQH & ={65}^{∘}.\\end{aligned}\n$$"} :step/id #uuid "3bd1460f-6ae9-5676-898d-888ea5061574" :step/next {:db/id #edb/ref 17592186567129}} {:db/id #edb/ref 17592186567124 :step/content {:db/id #edb/ref 17592186567102 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17a716a6-7e4d-54fc-b13f-a601c3ca82e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40" :db/id #edb/ref 17592186566409} {:answer/id #uuid "72a5b4a1-8899-5c56-bdf0-2ccfcab5d58d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.025" :db/id #edb/ref 17592186566578} {:answer/id #uuid "72de3c79-c429-510b-a5a0-9e53f9ea6288" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\,000" :db/id #edb/ref 17592186566579} {:answer/id #uuid "8e03c3b2-9b01-57f9-a12b-2c9cdfdf3dd7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186566636} {:answer/id #uuid "c3da19e8-a0a3-53c5-9a36-500ef3112bce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\,000" :db/id #edb/ref 17592186566750}] :answer-field/correct {:db/id #edb/ref 17592186566579} :answer-field/id #uuid "deb9d83a-08d5-565b-aa43-4570ecfc8e23" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566979}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ef0090d7-e552-5522-8456-ce718437e171" :question/math-academy-id "q-120407" :question/problem "The time, in hours, it takes to empty a pool varies inversely with the rate of pumping, in gallons per hour ($\\text{gph}$). If it takes $5$ hours to empty the pool at a rate of $200\\,\\text{gph},$ what is the constant of variation?" :question/worked-solution "The time $t$ is inversely proportional to the rate of pumping $r,$ so we have\n\n$$\nt=\\frac{k}{r},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that it takes $5$ hours to empty the pool at a rate of $200\\,\\text{gph}.$  We can use this information to solve for $k$ as follows:\n\n$$\n\\begin{aligned}5 & =\\frac{k}{200} \\\\ 5\\cdot 200 & =k \\\\ 1\\,000 & =k\\end{aligned}\n$$\n\nTherefore, our final answer is $k=1\\,000.$"} :step/id #uuid "418f2db1-e07a-5516-9167-49c78a8b998b" :step/next {:db/id #edb/ref 17592186567141}} {:db/id #edb/ref 17592186567127 :step/content {:db/id #edb/ref 17592186567029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08f452c3-9f2c-5647-b7af-c22e41c80791" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12a\\sqrt{2}" :db/id #edb/ref 17592186566382} {:answer/id #uuid "23f5d581-b735-5062-a71e-32bc76f94353" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\sqrt{2a}" :db/id #edb/ref 17592186566440} {:answer/id #uuid "7466ed08-97c1-557f-bae6-81e174a0f8e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "144\\sqrt{a}" :db/id #edb/ref 17592186566582} {:answer/id #uuid "a76e354b-19c7-5276-987d-f27f82fdd8ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{12a}" :db/id #edb/ref 17592186566691} {:answer/id #uuid "b7101c8e-c2e8-549e-861f-eeb818e4fc44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24\\sqrt{a}" :db/id #edb/ref 17592186566726}] :answer-field/correct {:db/id #edb/ref 17592186566440} :answer-field/id #uuid "a2b7404d-e71d-5caa-9f77-0a7e4942005f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566954}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2bd15f40-e989-5300-b551-e3144c2c681f" :question/math-academy-id "q-142027" :question/problem "Simplify $\\sqrt{288a}.$" :question/worked-solution "We first write $288a$ as the product $144\\cdot 2a$ which contains a perfect square $(144):$ \n\n$$\n\\begin{aligned}\\sqrt{288a} & = \\\\ \\sqrt{144\\cdot 2a} & \\end{aligned}\n$$\n\nThen, we can separate the product into two separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{144\\cdot 2a} & = \\\\ \\sqrt{(12)^{2}\\cdot 2a} & = \\\\ \\sqrt{(12)^{2}}\\cdot \\sqrt{2a} & \\end{aligned}\n$$\n\nFinally, we simplify the radical containing the perfect square:\n\n$$\n\\begin{aligned}\\sqrt{(12)^{2}}\\cdot \\sqrt{2a} & = \\\\ |12|\\cdot \\sqrt{2a} & = \\\\ 12\\sqrt{2a} & \\end{aligned}\n$$"} :step/id #uuid "51867c20-fe4d-5601-90c2-919610af2ec2" :step/next {:db/id #edb/ref 17592186567137}} {:db/id #edb/ref 17592186567129 :step/content {:db/id #edb/ref 17592186567051 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "317f62a7-f15c-5b8e-a3a7-6ef60ab56f79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,3]" :db/id #edb/ref 17592186566461} {:answer/id #uuid "385b92a8-763a-56eb-879a-8d3a16dd0ef1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-1,3]" :db/id #edb/ref 17592186566479} {:answer/id #uuid "6a9dba03-5fa7-5118-ad22-05a191e7c70e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,3)" :db/id #edb/ref 17592186566564} {:answer/id #uuid "9504a3ef-f3df-5103-bbbd-484f5fa182cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,-3)" :db/id #edb/ref 17592186566656} {:answer/id #uuid "dc21a884-c07c-5990-ba2f-65cfe89ba621" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,-1)" :db/id #edb/ref 17592186566805}] :answer-field/correct {:db/id #edb/ref 17592186566564} :answer-field/id #uuid "c748d70c-8464-5ad6-b8fa-7ac841e67513" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566970}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "737200e6-c3ef-51a6-b724-78dcb92c8633" :question/math-academy-id "q-28880" :question/problem "Given the inequalities, $x<3$ and $x>-1$, express their common set of solutions as an interval." :question/worked-solution "We start by sketching the solutions to the two inequalities separately:\n\n![](images/16/166ce99c0ceedf97d38066b544b5dc6ff7ca63296572d952536193a83a410d94.png)\n\n![](images/b5/b5a0212c7df84c064e5b49f878c47f824631bf9585bf20a7a48ce8ddc1b4a646.png)\n\nThe common set of values consists of the values that are in both intervals. So, it can be graphed by finding where the two intervals overlap:\n\n![](images/25/25313fabbd318c3c1fdc5e63b0d20ac44b5a4c951f70232dbefaaa2d82db4045.png)\n\nTherefore, the common set of values is\n$(-1,3).$"} :step/id #uuid "5f3aa8b7-683b-56c0-84cb-8c6e18e218bb" :step/next {:db/id #edb/ref 17592186567119}} {:db/id #edb/ref 17592186567130 :step/content {:db/id #edb/ref 17592186115651 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "063a7b7f-b47f-5420-8652-88b2a645f008" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-\\infty ,1)$  only" :db/id #edb/ref 17592186566372} {:answer/id #uuid "1ad65148-e01b-5814-8603-c310e6c136e8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-\\infty ,0)$  only" :db/id #edb/ref 17592186566414} {:answer/id #uuid "548e25f6-f4e6-533b-b1ed-f0e56a335f22" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,\\infty )$  only" :db/id #edb/ref 17592186566523} {:answer/id #uuid "5fa45410-4390-591e-b4d0-2cfa50c312c3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(1,\\infty )$   only" :db/id #edb/ref 17592186566543} {:answer/id #uuid "8cda3b06-fc65-539f-a0fe-5a74cf66c1f1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-\\infty ,0)$ and $(1,\\infty )$" :db/id #edb/ref 17592186566632}] :answer-field/correct {:db/id #edb/ref 17592186566632} :answer-field/id #uuid "2c35538e-1693-542a-8c7d-30e1730e59ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186112872}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4ad26873-832f-5e59-b5f4-c1e097ae8239" :question/math-academy-id "q-27692" :question/problem "![](images/ef/ef8e883c83a32ae5ece92686a73ec1c1210d92074d33d4a2e44572add51a88ee.png)\n\nOn which interval(s) is the function $y=f(x)$, shown above, increasing?" :question/worked-solution "If we follow the graph from left to right, we can see that: \n\n- For $x\\in (-\\infty ,0)$ the graph rises\n\n- For $x\\in (0,1)$ the graph falls\n\n- For $x\\in (1,\\infty )$ the graph rises\n\nThe function is increasing on the intervals where it never falls: $(-\\infty ,0)$ and $(1,\\infty ).$"} :step/id #uuid "601c55c1-a8a2-58fb-94a4-7860296c5e15" :step/next {:db/id #edb/ref 17592186567124}} {:db/id #edb/ref 17592186567133 :step/content {:db/id #edb/ref 17592186567016 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16d4aa1a-69ae-5b4c-a5e7-5285bd50e819" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{11}{y}^{2}" :db/id #edb/ref 17592186566408} {:answer/id #uuid "6eb87bf4-b704-5e70-b4f3-5261c9ecd7a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{10}{y}^{4}" :db/id #edb/ref 17592186566571} {:answer/id #uuid "cb228a61-3f9d-5659-ae9c-8dfd49bbaa74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{8}{y}^{3}" :db/id #edb/ref 17592186566764} {:answer/id #uuid "d44100e7-af02-52ab-9908-f002db669ae1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{6}{y}^{3}" :db/id #edb/ref 17592186566783} {:answer/id #uuid "dfe2668c-035e-5e9f-aaa8-412ae410941d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{5}{y}^{3}" :db/id #edb/ref 17592186566813}] :answer-field/correct {:db/id #edb/ref 17592186566764} :answer-field/id #uuid "30f3163e-b6a0-5c37-924e-1f4431be9678" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566899}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "11621803-c2eb-5773-8ffe-0f4ac7a22e24" :question/math-academy-id "q-141985" :question/problem "${x}^{2}y\\cdot {({x}^{3}y)}^{2}=$" :question/worked-solution "We start by using the power of product rule:\n\n$$\n\\begin{aligned}{x}^{2}y\\cdot {({x}^{3}y)}^{2}={x}^{2}y\\cdot ({x}^{3})^{2}\\cdot {y}^{2} & \\end{aligned}\n$$\n\nThen, we use the power rule:\n\n$$\n\\begin{aligned}{x}^{2}y\\cdot ({x}^{3})^{2}\\cdot {y}^{2} & = \\\\ {x}^{2}y\\cdot {x}^{3\\cdot 2}\\cdot {y}^{2} & = \\\\ {x}^{2}y\\cdot {x}^{6}\\cdot {y}^{2} & \\end{aligned}\n$$\n\nFinally, we use the product rule:\n\n$$\n\\begin{aligned}{x}^{2}y\\cdot {x}^{6}\\cdot {y}^{2} & = \\\\ ({x}^{2}\\cdot {x}^{6})\\cdot (y\\cdot {y}^{2}) & = \\\\ {x}^{2+6}\\cdot {y}^{1+2} & = \\\\ {x}^{8}\\cdot {y}^{3} & = \\\\ {x}^{8}{y}^{3} & \\end{aligned}\n$$"} :step/id #uuid "81e79889-743f-59f0-9539-c3b093bde922" :step/next {:db/id #edb/ref 17592186567121}} {:db/id #edb/ref 17592186567137 :step/content {:db/id #edb/ref 17592186567106 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c93084f1-f47b-56e6-bf6d-5ad197d70732" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186566761}] :answer-field/correct {:db/id #edb/ref 17592186566761} :answer-field/id #uuid "68f65a3c-aa44-5a53-857d-09108a8b580f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566923}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f3b5ac18-7c76-53e4-b7d2-3ac62a11ea93" :question/math-academy-id "q-223197" :question/problem "![](images/c5/c543b90535e3b252954ffb9e935f3f05a71d302f1f69a5212b467c826c9d8697.png)\n\nGiven the quadrilateral above, we have $x=${{field-1}}\n${}^{∘}.$" :question/worked-solution "Since the sum of the exterior angles of a polygon is ${360}^{∘}$, we have\n\n$$\n\\begin{aligned}5x+(6x+{30}^{∘})+(5x+{30}^{∘})+4x & ={360}^{∘} \\\\ 20x+{60}^{∘} & ={360}^{∘} \\\\ 20x & ={300}^{∘} \\\\ x & ={15}^{∘}.\\end{aligned}\n$$"} :step/id #uuid "9ae72dc1-5078-5d82-be01-f7792b13240d" :step/next {:db/id #edb/ref 17592186567133}} {:db/id #edb/ref 17592186567141 :step/content {:db/id #edb/ref 17592186567022 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c8b5761-5505-52d5-b16d-9caf40cd8a5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5(y+5)(y+4)" :db/id #edb/ref 17592186566541} {:answer/id #uuid "602c6570-8eef-570f-ab39-c5dfd88147f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5(y+10)(y-2)" :db/id #edb/ref 17592186566545} {:answer/id #uuid "70f8bc63-9032-59d6-94c7-44731a339417" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(y-20)(5y+1)" :db/id #edb/ref 17592186566576} {:answer/id #uuid "8e79ff6b-683b-5305-8568-90663d207d42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5(y-5)(y-4)" :db/id #edb/ref 17592186566639} {:answer/id #uuid "f19b6b7f-625a-51d8-8fa2-fba6b9225227" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5(y-10)(y+2)" :db/id #edb/ref 17592186566849}] :answer-field/correct {:db/id #edb/ref 17592186566849} :answer-field/id #uuid "20bcd852-4da7-5c86-b1b8-f77067a480cd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566892}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1a0b67f9-e70a-56fd-9ed9-04486a79a002" :question/math-academy-id "q-80174" :question/problem "Factor $100+40y-5{y}^{2}.$" :question/worked-solution "First, notice that we can factor out a $(-5)$ from each of the terms:\n\n$$\n\\begin{aligned}100+40y-5{y}^{2} & =-5({y}^{2}-8y-20) & \\end{aligned}\n$$\n\nNow, we just need to factor the polynomial ${y}^{2}-8y-20$ in parentheses.\n\nWe start by listing the factor pairs of the constant term $(-20).$ The constant term is negative, so that means one of the factors is negative and the other is positive:\n\n$$\n\\begin{aligned}1 & \\times (-20) \\\\ (-1) & \\times 20 \\\\ 2 & \\times (-10) \\\\ (-2) & \\times 10 \\\\ 4 & \\times (-5) \\\\ (-4) & \\times 5\\end{aligned}\n$$\n\nNow, we find which factor pair adds up to the coefficient of the linear term $(-8):$\n\n$$\n\\begin{aligned}1+(-20) & =-19 & \\times  \\\\ -1+20 & =19 & \\times  \\\\ 2+(-10) & =-8 & ✓ \\\\ -2+10 & =8 & \\times  \\\\ 4+(-5) & =-1 & \\times  \\\\ -4+5 & =1 & \\times \\end{aligned}\n$$\n\nUsing the factor pair identified above, we write the linear term as $-8y=2y-10y$ and then factor:\n\n$$\n\\begin{aligned}-5({y}^{2}-8y-20) & = \\\\ -5({y}^{2}+2y-10y-20) & = \\\\ -5(({y}^{2}+2y)+(-10y-20)) & = \\\\ -5(y(y+2)-10(y+2)) & = \\\\ -5(y-10)(y+2) & \\end{aligned}\n$$"} :step/id #uuid "a6a18f74-3dbe-5b4f-bddb-728002035d9c" :step/next {:db/id #edb/ref 17592186567127}}] :activity/title "Quiz 22" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186566356}]}
