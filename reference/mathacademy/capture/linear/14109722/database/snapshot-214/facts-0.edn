85] [17592186406979 #edb/ref 1075 #edb/ref 17592186406971 #edb/ref 17592186045585] [17592186406979 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045585] [17592186406979 #edb/ref 1077 "field-4" #edb/ref 17592186045585] [17592186406979 #edb/ref 1079 #edb/ref 17592186406961 #edb/ref 17592186045585] [17592186406979 #edb/ref 1080 #uuid "b4032492-1493-553b-bc31-fe628a9c1050" #edb/ref 17592186045585] [17592186406980 #edb/ref 1068 #edb/ref 17592186406978 #edb/ref 17592186045585] [17592186406980 #edb/ref 1069 "q-103558" #edb/ref 17592186045585] [17592186406980 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045585] [17592186406980 #edb/ref 1071 "Which of the following statements are true?\n\n- **If** $12$ is divisible by $3$, **then** $9$ is divisible by $4.$\n- **If** $5$ is divisible by $2$, **then** $10$ is divisible by $5.$\n- **If** $9$ is divisible by $5$, **then** $6$ is divisible by $3.$" #edb/ref 17592186045585] [17592186406980 #edb/ref 1072 #uuid "55e540af-11e2-5ec3-9b47-ab0da3ac740e" #edb/ref 17592186045585] [17592186406980 #edb/ref 1074 "An implication $A⇒B$ is true *unless* $A$ is true and $B$ is false. In other words, the implication is true unless the \"promise\" is broken.\n\n- Statement I is false. The antecedent \"$12$ is divisible by $3$\" is true, and the consequent \"$9$ is divisible by $4$\" is false. So the promise is broken, and the statement is false.\n\n- Statement II is true. The antecedent \"$5$ is divisible by $2$\" is false, so the promise does not apply. Regardless of the consequent, the promise is *not* broken, and the statement is true.\n\n- Statement III is true. Again, the antecedent \"$9$ is divisible by $5$\" is false, so the promise does not apply. Regardless of the consequent, the promise is *not* broken, and the statement is true.\n\nTherefore, the correct answer is \"II and III only.\"" #edb/ref 17592186045585] [17592186406981 #edb/ref 1068 #edb/ref 17592186406974 #edb/ref 17592186045585] [17592186406981 #edb/ref 1069 "q-82092" #edb/ref 17592186045585] [17592186406981 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045585] [17592186406981 #edb/ref 1071 "Which of the following statements are true?\n\n- **If** $7$ is an even number, **then** $6$ is an odd number.\n- **If** $6$ is an even number, **then** $7$ is an even number.\n- **If** $6$ is an even number, **then** $7$ is an odd number." #edb/ref 17592186045585] [17592186406981 #edb/ref 1072 #uuid "806aafe6-aa9d-53f3-a7d9-19809d388a29" #edb/ref 17592186045585] [17592186406981 #edb/ref 1074 "An implication $A⇒B$ is true *unless* $A$ is true and $B$ is false. In other words, the implication is true unless the \"promise\" is broken.\n\n- Statement I is true. The antecedent \"$7$ is an even number\" is false, so the promise does not apply. Regardless of the consequent, the promise is *not* broken, and the statement is true.\n\n- Statement II is false. The antecedent \"$6$ is an even number\" is true, and the consequent \"$7$ is an even number\" is false. So the promise is broken, and the statement is false.\n\n- Statement III is true. The antecedent \"$6$ is an even number\" is true, and the consequent \"$7$ is an odd number\" is true. So the promise is kept, and the statement is true.\n\nTherefore, the correct answer is \"I and III only.\"" #edb/ref 17592186045585] [17592186406982 #edb/ref 1068 #edb/ref 17592186406975 #edb/ref 17592186045585] [17592186406982 #edb/ref 1068 #edb/ref 17592186406976 #edb/ref 17592186045585] [17592186406982 #edb/ref 1068 #edb/ref 17592186406977 #edb/ref 17592186045585] [17592186406982 #edb/ref 1068 #edb/ref 17592186406979 #edb/ref 17592186045585] [17592186406982 #edb/ref 1069 "q-182663" #edb/ref 17592186045585] [17592186406982 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045585] [17592186406982 #edb/ref 1071 "Find the missing values in the following truth table:" #edb/ref 17592186045585] [17592186406982 #edb/ref 1072 #uuid "e0bd03cd-0c48-596c-b039-0f9c85a18c3a" #edb/ref 17592186045585] 