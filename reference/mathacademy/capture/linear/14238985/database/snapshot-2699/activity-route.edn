#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186557363} :activity/id #uuid "1cce07d5-ff0a-5975-9c9d-622dd75fac73" :activity/scope {:db/id #edb/ref 17592186050497 :topic/id #uuid "4dd99b27-25f2-551e-b641-cafc64c1d0b4" :topic/math-academy-id 393} :activity/steps [{:db/id #edb/ref 17592186557342 :step/content {:db/id #edb/ref 17592186557212 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e649d97-3c0c-5ae6-97b6-48eef0024d2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186556720}] :answer-field/correct {:db/id #edb/ref 17592186556720} :answer-field/id #uuid "787db694-3a04-57ec-b777-dd8675942d0a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186557135} {:answer-field/choices [{:answer/id #uuid "d752f97d-8467-563c-92bd-97f63fec9e41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186556961}] :answer-field/correct {:db/id #edb/ref 17592186556961} :answer-field/id #uuid "826d750e-aa39-5d99-950b-c760b0639352" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186557141}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0d0ef510-de0c-500a-8eb5-ba614cc6f88f" :question/math-academy-id "q-223794" :question/problem "In **ascending order**, the solutions to $4{g}^{2}=\\frac{2g}{5}$ are $g=${{field-1}} and $g=$\n{{field-2}}." :question/worked-solution "First, we move all of the terms to the left-hand side and then factor:\n\n$$\n\\begin{aligned}4{g}^{2} & =\\frac{2g}{5} \\\\ 4{g}^{2}-\\frac{2g}{5} & =0 \\\\ 2g(2g-\\frac{1}{5}) & =0\\end{aligned}\n$$\n\nThen, we apply the zero product rule to get\n\n$$\n2g=0\\,\\text{or}\\,2g-\\frac{1}{5}=0,\n$$\n\nwhich in turn gives\n\n$$\ng=0\\,\\text{or}\\,g=\\frac{1}{10}.\n$$\n\nTherefore, the solutions are $g=0$ and $g=\\frac{1}{10}.$"} :step/id #uuid "13841e88-b264-587e-a3ba-4dee503e95bf"} {:db/id #edb/ref 17592186557352 :step/content {:db/id #edb/ref 17592186557221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a2e1430-36d6-5b83-963c-98bb99139c37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186556803}] :answer-field/correct {:db/id #edb/ref 17592186556803} :answer-field/id #uuid "05999e12-4eba-5df8-ac2d-9476c353c3f2" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186557065} {:answer-field/choices [{:answer/id #uuid "79a0964b-0c41-5a2a-ad72-b76610f13e7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-15" :db/id #edb/ref 17592186556714}] :answer-field/correct {:db/id #edb/ref 17592186556714} :answer-field/id #uuid "16f3cb1b-1270-5e26-afd6-73aa7268dd64" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186557076}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "267a0513-367c-516d-9933-b0be78b78e58" :question/math-academy-id "q-223742" :question/problem "In **ascending order**, the solutions to $\\frac{1}{5}{t}^{2}=-3t$ are $t=${{field-1}} and $t=$\n{{field-2}}." :question/worked-solution "First, we move all of the terms to the left-hand side and then factor:\n\n$$\n\\begin{aligned}\\frac{1}{5}{t}^{2} & =-3t \\\\ \\frac{1}{5}{t}^{2}+3t & =0 \\\\ \\frac{1}{5}t(t+15) & =0\\end{aligned}\n$$\n\nThen, we apply the zero product rule to get\n\n$$\n\\frac{1}{5}t=0\\,\\text{or}\\,t+15=0,\n$$\n\nwhich in turn gives\n\n$$\nt=0\\,\\text{or}\\,t=-15.\n$$\n\nTherefore, the solutions are $t=-15$ and $t=0.$"} :step/id #uuid "3cfceae3-a898-59b0-bb61-c360e1ebdc6f" :step/next {:db/id #edb/ref 17592186557342}} {:db/id #edb/ref 17592186557363 :step/content {:db/id #edb/ref 17592186557223 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cfabe3e-655f-540b-8a36-63763cc30ae3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "w=-\\frac{3}{4},0" :db/id #edb/ref 17592186556525} {:answer/id #uuid "5d60e1ad-63a6-5c33-b083-637a1a7d0ed7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "w=\\frac{1}{4}" :db/id #edb/ref 17592186556639} {:answer/id #uuid "8a73e7b0-535b-5a97-ada6-598e918537fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "w=-\\frac{1}{4},0" :db/id #edb/ref 17592186556760} {:answer/id #uuid "b037a635-819d-5e62-8132-055205497ce7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "w=0,3" :db/id #edb/ref 17592186556862} {:answer/id #uuid "d95d0cde-369b-54c5-bb35-039a85b39a0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "w=-2,0" :db/id #edb/ref 17592186556967}] :answer-field/correct {:db/id #edb/ref 17592186556525} :answer-field/id #uuid "c2c3da63-61c2-5820-b9db-e69f9530157d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557176}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "27e28aad-c990-5820-b03a-4018644801a7" :question/math-academy-id "q-112034" :question/problem "Solve the equation $6{w}^{2}+3w-5=2{w}^{2}-5.$" :question/worked-solution "First, we move all of the terms to the left-hand side and then factor:\n\n$$\n\\begin{aligned}6{w}^{2}+3w-5 & =2{w}^{2}-5 \\\\ 6{w}^{2}+3w-5-(2{w}^{2}-5) & =0 \\\\ 6{w}^{2}+3w-5-2{w}^{2}+5 & =0 \\\\ (6{w}^{2}-2{w}^{2})+3w+(-5+5) & =0 \\\\ 4{w}^{2}+3w & =0 \\\\ w(4w+3) & =0\\end{aligned}\n$$\n\nThen, we apply the zero product rule to get\n\n$$\nw=0\\,\\text{or}\\,4w+3=0,\n$$\n\nwhich in turn gives\n\n$$\nw=0\\,\\text{or}\\,w=-\\frac{3}{4}.\n$$\n\nTherefore, the solutions are $w=-\\frac{3}{4},0.$"} :step/id #uuid "679c8709-10da-518a-990d-837568e38654" :step/next {:db/id #edb/ref 17592186557352}}] :activity/title "Solving Quadratic Equations with No Constant Term" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186556409}]}
