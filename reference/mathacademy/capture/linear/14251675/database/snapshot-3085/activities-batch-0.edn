#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186180329} :activity/id #uuid "77e3ae57-98b5-5d38-9772-30811dbaca9c" :activity/scope {:db/id #edb/ref 17592186049305 :topic/id #uuid "eb169cdb-9ded-599f-b8d4-23b30958ff03" :topic/math-academy-id 3695} :activity/steps [{:db/id #edb/ref 17592186180329 :step/content {:db/id #edb/ref 17592186180786 :tutorial/content "Suppose we have the following arithmetic sequence with first term $a_1 = {\\color{red}4}$ and common difference  $d={\\color{blue}{3}}\\mathbin{:}$\n\n$$\n{\\color{red}{4}},7,10,13,16,\\ldots\n$$\n\nEach term is ${\\color{blue}{3}}$ more than the previous, starting with ${\\color{red}{4}}.$ Therefore, we can express this sequence recursively:\n\n$$\na_{n+1} = a_n + {\\color{blue}{3}}, \\quad a_1 = {\\color{red}{4}}, \\quad n\\geq 1\n$$\n\nWe can also express the sequence using function notation:\n\n$$\nf(n+1) = f(n) + {\\color{blue}{3}}, \\quad f(1) = {\\color{red}{4}}, \\quad n\\geq 1\n$$" :tutorial/id #uuid "b35c0f06-cff3-51a8-97f6-3a4d39086781" :tutorial/math-academy-id 8908 :tutorial/title "Introduction"} :step/id #uuid "7c3d2c30-5670-5fd1-b7ab-ba45846770a7" :step/math-academy-id 145222 :step/next {:db/id #edb/ref 17592186180330}} {:db/id #edb/ref 17592186180330 :step/content {:db/id #edb/ref 17592186179637 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179480 :question/id #uuid "e2410277-5f68-5cf6-a358-635517123015" :question/math-academy-id "e-14378"} :knowledge-point/id #uuid "08661743-d541-5f60-a2de-d536a1953eb6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049579} {:db/id #edb/ref 17592186050380}] :knowledge-point/questions [{:db/id #edb/ref 17592186180129} {:db/id #edb/ref 17592186180201} {:db/id #edb/ref 17592186558509} {:db/id #edb/ref 17592186558526}] :knowledge-point/title "Computing the Terms of an Arithmetic Sequence"} :step/id #uuid "722361bb-fbdd-5022-9a09-ef207ea9aac6" :step/math-academy-id 145223 :step/next {:db/id #edb/ref 175921