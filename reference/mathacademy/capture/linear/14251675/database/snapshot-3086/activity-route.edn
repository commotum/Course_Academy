#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186572227} :activity/id #uuid "407944e4-52ca-56f0-83fc-c87cf24aa58b" :activity/scope {:db/id #edb/ref 17592186049305 :topic/id #uuid "eb169cdb-9ded-599f-b8d4-23b30958ff03" :topic/math-academy-id 3695} :activity/steps [{:db/id #edb/ref 17592186572202 :step/content {:db/id #edb/ref 17592186572175 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1133fb84-1d86-5599-8626-3dfbcda19cfe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186571568} {:answer/id #uuid "35017e41-5503-5fa7-9076-4a71156858ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186571627} {:answer/id #uuid "5eab59bd-0661-590f-8e86-e8fdda52d63b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186571705} {:answer/id #uuid "d5e22c7b-afd4-5159-9d63-bac3cb16fb4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186571920} {:answer/id #uuid "e1e7e3ce-3647-5ac9-97af-4dc27a4847c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186571944}] :answer-field/correct {:db/id #edb/ref 17592186571944} :answer-field/id #uuid "039804cc-15c0-583f-9bed-6e466f2e3dac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571983}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c34eba6d-b083-5402-a6a3-51f96dd8afd1" :question/math-academy-id "q-44936" :question/problem "An arithmetic sequence $f(n)$ is defined by \n\n$$\nf(n+1)=f(n)+5,\\,f(1)=-21,\\,n\\ge 1.\n$$\n\nWhat is the $5$th term of the sequence?" :question/worked-solution "Starting with the first term $f(1)=-21,$ we compute the next terms using the recursive rule until we reach the $5$th term $f(5).$\n\n$$\n\\begin{aligned}f(1) & =-21 \\\\ f(2) & =f(1)+5=-21+5=-16 \\\\ f(3) & =f(2)+5=-16+5=-11 \\\\ f(4) & =f(3)+5=-11+5=-6 \\\\ f(5) & =f(4)+5=-6+5=-1\\end{aligned}\n$$\n\nTherefore, the $5$th term is $f(5)=-1.$"} :step/id #uuid "0116930c-b31e-5584-a742-34ae182ebb06"} {:db/id #edb/ref 17592186572227 :step/content {:db/id #edb/ref 17592186572143 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3df09295-bd93-552d-8d47-b739d81f588e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}_{n+1}={a}_{n}-5,\\,{a}_{1}=3,\\,n\\ge 1." :db/id #edb/ref 17592186571654} {:answer/id #uuid "528ba7ce-ff96-5b5e-89d1-3501f5d660e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}_{n+1}={a}_{n}-5,\\,{a}_{1}=1,\\,n\\ge 1." :db/id #edb/ref 17592186571687} {:answer/id #uuid "8e3029a6-746b-5f77-811f-eb3f747f04c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}_{n+1}={a}_{n}+5,\\,{a}_{1}=1,\\,n\\ge 1." :db/id #edb/ref 17592186571787} {:answer/id #uuid "b3a15c56-4f26-50de-a08a-cd2937b5539e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}_{n+1}={a}_{n}+3,\\,{a}_{1}=3,\\,n\\ge 1." :db/id #edb/ref 17592186571853} {:answer/id #uuid "d822792a-2075-5dc4-9373-c5ded8b829f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}_{n+1}={a}_{n}+5,\\,{a}_{1}=3,\\,n\\ge 1." :db/id #edb/ref 17592186571929}] :answer-field/correct {:db/id #edb/ref 17592186571929} :answer-field/id #uuid "81e22617-8597-54d3-a0f3-fa818ae0b47e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186572040}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "77a7116e-44f5-5bae-b9b5-0fd8797f1149" :question/math-academy-id "q-44930" :question/problem "What is the recursive formula for the following arithmetic sequence?\n\n$$\n3,\\,8,\\,13,\\,…\n$$" :question/worked-solution "The recursive formula for an arithmetic sequence with common difference $d$ is\n\n$$\n{a}_{n+1}={a}_{n}+d.\n$$\n\nIn our case, the common difference is\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =8-3 \\\\  & =5.\\end{aligned}\n$$\n\nConsequently, the recursive formula for this sequence is\n\n$$\n{a}_{n+1}={a}_{n}+5,\\,{a}_{1}=3,\\,n\\ge 1.\n$$"} :step/id #uuid "49e84994-bb21-52c6-9370-87262dbd67fe" :step/next {:db/id #edb/ref 17592186572228}} {:db/id #edb/ref 17592186572228 :step/content {:db/id #edb/ref 17592186572120 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f7e3f53-4bbe-53ff-ba6d-0404d5cc570a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-20" :db/id #edb/ref 17592186571730} {:answer/id #uuid "7e8987c0-762e-5c31-9fd2-5637dab46808" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-27" :db/id #edb/ref 17592186571757} {:answer/id #uuid "8e950abf-407a-5808-9c95-aa34617b48bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-22" :db/id #edb/ref 17592186571790} {:answer/id #uuid "a088e6e8-ec87-5753-b3fe-7d1d986f2aef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186571816} {:answer/id #uuid "d3a81d3c-9440-5594-8109-34775e8239bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-17" :db/id #edb/ref 17592186571917}] :answer-field/correct {:db/id #edb/ref 17592186571917} :answer-field/id #uuid "4496f684-e466-5e2f-8aa6-669d3965ccdf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186572011}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "30339881-8790-5539-bade-6db869718ace" :question/math-academy-id "q-44931" :question/problem "What is the $5$th term of the arithmetic sequence \n\n$$\n{a}_{n+1}={a}_{n}-5,\\,{a}_{1}=3,\\,n\\ge 1?\n$$" :question/worked-solution "Starting with the first term ${a}_{1}=3,$ we compute the next terms using the recursive rule until we reach the $5$th term ${a}_{5}.$\n\n$$\n\\begin{aligned}{a}_{1} & =3 \\\\ {a}_{2} & ={a}_{1}-5=3-5=-2 \\\\ {a}_{3} & ={a}_{2}-5=-2-5=-7 \\\\ {a}_{4} & ={a}_{3}-5=-7-5=-12 \\\\ {a}_{5} & ={a}_{4}-5=-12-5=-17\\end{aligned}\n$$\n\nTherefore, the $5$th term is ${a}_{5}=-17.$"} :step/id #uuid "5070da8e-23b6-5c14-815f-bb2ba265781e" :step/next {:db/id #edb/ref 17592186572202}}] :activity/title "Recursive Formulas for Arithmetic Sequences" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186571522}]}
