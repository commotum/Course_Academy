le=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>4</mn><mo>−</mo><mn>4</mn></mrow><mrow><mn>1</mn><mo>−</mo><mn>0</mn></mrow></mfrac></mstyle><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>0</mn><mn>1</mn></mfrac></mstyle><mo>=</mo><mn>0</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
