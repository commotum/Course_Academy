 to right, the line rises by a positive amount.\n\nTherefore, the slope of the line is positive."}] [{:db/id #edb/ref 17592186491185 :knowledge-point/_questions [{:db/id #edb/ref 17592186068781 :knowledge-point/id #uuid "b15c549c-e56b-5392-a292-e52bc1f58cb0" :knowledge-point/title "Slopes of Horizontal and Vertical Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "678d6038-e825-59c6-9971-c48d2d865e2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186490706} {:answer/id #uuid "6a32989d-8835-56eb-bcbc-90b2a1086778" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The slope is undefined" :db/id #edb/ref 17592186490713} {:answer/id #uuid "7f802149-1074-5318-89ed-42dc0eb547dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{17}" :db/id #edb/ref 17592186490767} {:answer/id #uuid "99a357c6-c0c5-5d3b-b661-3b8b54f72857" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186490828} {:answer/id #uuid "d662cd56-f43e-5893-a18d-fa83a1f38571" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186490916}] :answer-field/correct {:answer/id #uuid "d662cd56-f43e-5893-a18d-fa83a1f38571" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186490916} :answer-field/id #uuid "953d0870-f076-5324-b524-a2108d605059" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491058}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a9a75d95-73e5-5e15-b9cb-e6db140f14c6" :question/math-academy-id "q-12629" :question/problem "Calculate the slope of the line that passes through the points $(3,4)$ and $(2,4).$" :question/worked-solution "We let $({x}_{1},{y}_{1})=(3,4)$ and $({x}_{2},{y}_{2})=(2,4),$ and compute the slope using the formula:\n\n$$\n\\begin{aligned}\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{4-4}{2-3} \\\\  & =\\frac{0}{-1} \\\\  & =0\\end{aligned}\\end{aligned}\n$$\n\nThus, the slope is $m=0.$"}] [{:db/id #edb/ref 17592186491128 :knowledge-point/_questions [{:db/id #edb/ref 17592186068894 :knowledge-point/id #uuid "2db034b8-5119-5cf3-bb6e-e6c79d024177" :knowledge-point/title "Calculating the Slope Given Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f5b2164-de5d-580a-9044-b5a6ace56295" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186490601} {:answer/id #uuid "3eda3d1b-be86-5d59-ba68-d86735eb257a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186490629} {:answer/id #uuid "59c3c247-bf87-5cc9-927f-fae854845a54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186490679} {:answer/id #uuid "996c1ad0-79b6-5ad6-bb02-d19eb924c5e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186490827} {:answer/id #uuid "d7ba74f0-8e9a-56c5-83d1-49d861acc4a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186490921}] :answer-field/correct {:answer/id #uuid "59c3c247-bf87-5cc9-927f-fae854845a54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186490679} :answer-field/id #uuid "c81a4e80-6d0f-54c9-a9b1-a145d88b8558" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491083}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2aed86e1-b290-5c0a-9731-7ce89e296450" :question/math-academy-id "q-12633" :question/problem "What is the slope of a line that passes through the points $(0,3)$ and $(5,6)?$" :question/worked-solution "We let $({x}_{1},{y}_{1})=(0,3)$ and $({x}_{2},{y}_{2})=(5,6),$ and compute the slope using the formula:\n\n$$\n\\begin{aligned}\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{6-3}{5-0} \\\\  & =\\frac{3}{5}\\end{aligned}\\end{aligned}\n$$\n\nThus, the slope is $m=\\frac{3}{5}.$"}] [{:db/id #edb/ref 17592186491205 :knowledge-point/_questions [{:db/id #edb/ref 17592186068893 :knowledge-point/id #uuid "90ce29dd-5214-5ce3-84d0-3f5c304cc7a0" :knowledge-point/title "Calculating the Slope of a Graphed Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "063cb6bd-a8a2-5aa5-95be-42d1d654b497" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186490522} {:answer/id #uuid "0caedf90-341d-52e8-a42d-3d261ab0113f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186490530} {:answer/id #uuid "6b76e92b-c74d-56a1-a29f-b50300fd87eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186490718} {:answer/id #uuid "8fb6c2a4-f6d5-5d7d-a84f-6d0459626d22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186490801} {:answer/id #uuid "ffff2fe5-2627-5cc8-a2de-2858384dd99a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186490996}] :answer-field/correct {:answer/id #uuid "0caedf90-341d-52e8-a42d-3d261ab0113f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186490530} :answer-field/id #uuid "f998fecd-bbe8-5d5d-9d3d-12e2694181ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491108}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e43571cc-c5ba-5976-8130-23aea630ac69" :question/math-academy-id "q-26606" :question/problem "![](images/64/64957c4f5315d4880503aa6572699a675b4c16143ae08e58fb25df37fd69d05d.png)\n\nThe straight line shown above intersects the $y$-axis when $y=3$ and intersects the $x$-axis when $x=-6.$ What is its slope?" :question/worked-solution "Note that the line passes through the points $(0,3)$ and $(-6,0).$ So, we let $({x}_{1},{y}_{1})=(0,3)$ and $({x}_{2},{y}_{2})=(-6,0),$ and compute the slope using the formula:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{0-3}{-6-0} \\\\  & =\\frac{-3}{-6} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the slope of the line is $m=\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186491141 :knowledge-point/_questions [{:db/id #edb/ref 17592186068893 :knowledge-point/id #uuid "90ce29dd-5214-5ce3-84d0-3f5c304cc7a0" :knowledge-point/title "Calculating the Slope of a Graphed Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "104d41c3-0e85-52e1-9ce5-444595605652" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186490543} {:answer/id #uuid "4f3bc186-d96f-5413-afa5-401d93963056" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186490663} {:answer/id #uuid "8f66d13c-71b8-57c5-923e-237f1dcc96ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186490800} {:answer/id #uuid "c534aa13-e3d3-5556-960f-588b6885f1a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186490890} {:answer/id #uuid "f2e31773-4151-5e13-b6f5-e20c2e64929c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186490975}] :answer-field/correct {:answer/id #uuid "8f66d13c-71b8-57c5-923e-237f1dcc96ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186490800} :answer-field/id #uuid "61012383-9b90-523d-b36d-7d0e995b871e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491043}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "46266ffe-395d-5bff-927f-737b6f2fbdfc" :question/math-academy-id "q-26714" :question/problem "![](images/10/10f79e3e129891e51ee47ecd595ab666053cd048688c4a63e8f7edd66cdae6da.png)\n\nGiven that the line above passes through the point $(-4,-1)$ and intersects the $x$-axis when $x=4,$ find the slope of the line." :question/worked-solution "Note that the line passes through the points $(-4,-1)$ and $(4,0).$ So, we let $({x}_{1},{y}_{1})=(-4,-1)$ and $({x}_{2},{y}_{2})=(4,0),$ and compute the slope using the formula:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{0-(-1)}{4-(-4)} \\\\  & =\\frac{1}{8}\\end{aligned}\n$$\n\nTherefore, the slope of the line is $m=\\frac{1}{8}.$"}] [{:db/id #edb/ref 17592186491125 :knowledge-point/_questions [{:db/id #edb/ref 17592186068781 :knowledge-point/id #uuid "b15c549c-e56b-5392-a292-e52bc1f58cb0" :knowledge-point/title "Slopes of Horizontal and Vertical Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02420fbe-3c97-56a5-b26e-c4b3420da8ce" :answer/type {:db/id #edb/ref 17592186045498 :db/iden