e-point/id #uuid "2db034b8-5119-5cf3-bb6e-e6c79d024177" :knowledge-point/title "Calculating the Slope Given Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d02e444-7565-5de9-a078-504b2191fcd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186490624} {:answer/id #uuid "902f202c-a83c-5fd8-9fbf-f740c2241181" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186490802} {:answer/id #uuid "ada2b6cc-8e62-59e3-9964-b9408db65b59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186490856} {:answer/id #uuid "e9b48d10-0c79-5e16-b619-e90a392edcd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186490954} {:answer/id #uuid "fce35e1b-eeb8-5c7a-8c3c-c04d0f68ee8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186490990}] :answer-field/correct {:answer/id #uuid "fce35e1b-eeb8-5c7a-8c3c-c04d0f68ee8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186490990} :answer-field/id #uuid "09a3abf4-2ea3-5b6b-beac-3b3760d7c5cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491004}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "07e2ee89-2122-51d1-b017-410fc7074e1d" :question/math-academy-id "q-44612" :question/problem "Calculate the slope of the line that passes through the points $(-2,-4)$ and $(-8,-6).$" :question/worked-solution "We let $({x}_{1},{y}_{1})=(-2,-4)$ and $({x}_{2},{y}_{2})=(-8,-6),$ and compute the slope using the formula:\n\n$$\n\\begin{aligned}\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{-6-(-4)}{-8-(-2)} \\\\  & =\\frac{-2}{-6} \\\\  & =\\frac{1}{3}\\end{aligned}\\end{aligned}\n$$\n\nThus, the slope is $m=\\frac{1}{3}.$"}] [{:db/id #edb/ref 17592186491143 :knowledge-point/_questions [{:db/id #edb/ref 17592186068895 :knowledge-point/id #uuid "1e9a705e-88d8-58e2-b498-30e3c8e0c26f" :knowledge-point/title "Inferring the Sign of the Slope of a Graphed Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "842ac371-2eeb-5148-8ae5-f593956e4698" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186490779} {:answer/id #uuid "8e1719d7-b4ab-5927-a94f-934e56782bb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Zero" :db/id #edb/ref 17592186490795} {:answer/id #uuid "9c97bf79-0d82-5511-9989-907c444ecd74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Positive" :db/id #edb/ref 17592186490834} {:answer/id #uuid "ad5c83d4-ee9d-5dea-bfb8-e87d6918b756" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Not enough information" :db/id #edb/ref 17592186490854} {:answer/id #uuid "c518d239-bafa-51e4-b438-8d77edd99e18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Negative" :db/id #edb/ref 17592186490889}] :answer-field/correct {:answer/id #uuid "9c97bf79-0d82-5511-9989-907c444ecd74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Positive" :db/id #edb/ref 17592186490834} :answer-field/id #uuid "9ec48b46-05ad-5267-a37c-cfd30ad5f716" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491063}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4ae450be-6c0