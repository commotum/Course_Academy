045498} :answer/value "\\frac{2-\\sqrt{2}}{2}" :db/id #edb/ref 17592186550683} {:answer/id #uuid "7fee911c-477b-55c3-9770-f92077500b94" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186550691} {:answer/id #uuid "9d2f2ca5-e104-5920-9146-0e49e1295162" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186550769} {:answer/id #uuid "a898a109-7268-53b6-8036-8d9cf20ccf01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186550815}] :answer-field/correct {:db/id #edb/ref 17592186550590} :answer-field/id #uuid "edfb1d06-ff84-5a5e-b3ca-4378a3fc65ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186551218}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "da211e88-d789-5f6a-b87d-2366e18b07f4" :question/math-academy-id "q-5991" :question/problem "$1-\\operatorname{sin}⁡{30}^{∘}=$" :question/worked-solution "The angle ${30}^{∘}$ is special, and its sine has the value\n\n$$\n\\operatorname{sin}⁡{30}^{∘}=\\frac{1}{2}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}1-\\operatorname{sin}⁡{30}^{∘} & = \\\\ 1-\\frac{1}{2} & = \\\\ \\frac{1}{2} & .\\end{aligned}\n$$"} :step/id #uuid "5b7dbe22-dc0d-54cb-b4df-f39f966687ed" :step/next {:db/id #edb/ref 17592186551429}} {:db/id #edb/ref 17592186551424 :step/content {:db/id #edb/ref 17592186551324 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8bc9fa93-f40e-5310-8f1c-3a09ec82f709" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186550722}] :answer-field/correct {:db/id #edb/ref 17592186550722} :answer-field/id #uuid "2955e3b5-359a-52c1-ba32-374efd6a1771" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186551088}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aec99370-575e-52b4-9e36-bb43c957f2bf" :question/math-academy-id "q-266852" :question/problem "$\\operatorname{tan}⁡{45}^{∘}+\\operatorname{tan}⁡{0}^{∘}-\\operatorname{sin}⁡{90}^{∘}=${{field-1}}" :question/worked-solution "The angles of ${0}^{∘},$ ${45}^{∘},$ and ${90}^{∘}$ are special, and their trigonometric ratios have values\n\n$$\n\\operatorname{sin}⁡{90}^{∘}=1,\\,\\operatorname{tan}⁡{0}^{∘}=0,\\,\\operatorname{tan}⁡{45}^{∘}=1.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡{45}^{∘}+\\operatorname{tan}⁡{0}^{∘}-\\operatorname{sin}⁡{90}^{∘} & = \\\\ 1+0-1 & = \\\\ 0. & \\end{aligned}\n$$"} :step/id #uuid "8d66e22f-32f8-524d-9151-c3676a742fc5"} {:db/id #edb/ref 17592186551429 :step/content {:db/id #edb/ref 17592186551236 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "420931a7-bfe9-57fd-be28-96ee8c3e7a3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}-1" :db/id #edb/ref 17592186550522} {:answer/id #uuid "52b2408a-7f36-5c00-b12f-5d5d12445119" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186550564} {:answer/id #uuid "7676748a-b3e1-574b-8bbc-7af2c704efdc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}-1}{3}" :db/id #edb/ref 17592186550665} {:answer/id #uuid "847735f3-85e7-556f-ab13-996c4f671091" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186550702} {:answer/id #uuid "8a774edc-0a83-5eff-b7f3-8dd8b4849f1e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186550718}] :answer-field/correct {:db/id #edb/ref 17592186550718} :answer-field/id #uuid "c6a43897-150e-534f-a498-9f892cf924c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186551188}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0f16c2b9-1c8b-50a4-93ab-bbcc2578659f" :question/math-academy-id "q-5994" :question/problem "$3{tan}^{2}⁡{30}^{∘}-\\operatorname{tan}⁡{45}^{∘}=$" :question/worked-solution "The angles ${30}^{∘}$ and ${45}^{∘}$ are special, and their trigonometric ratios have the  values\n\n$$\n\\operatorname{tan}⁡{30}^{∘}=\\frac{\\sqrt{3}}{3},\\,\\operatorname{tan}⁡{45}^{∘}=1.\n$$\n\nAlso, note that ${tan}^{2}⁡{30}^{∘}$ simply means $(\\operatorname{tan}⁡{30}^{∘})^{2}.$\n\nTherefore,\n\n$$\n\\begin{aligned}3{tan}^{2}⁡{30}^{∘}-\\operatorname{tan}⁡{45}^{∘} & = \\\\ 3{(\\operatorname{tan}⁡{30}^{∘})}^{2}-\\operatorname{tan}⁡{45}^{∘} & = \\\\ 3{(\\frac{\\sqrt{3}}{3})}^{2}-1 & = \\\\ 3(\\frac{3}{9})-1 & = \\\\ 1-1 & = \\\\ 0 & .\\end{aligned}\n$$"} :step/id #uuid "9adf5944-13ef-501f-b0c3-0fc0d68be6fd" :step/next {:db/id #edb/ref 17592186551380}}] :activity/title "Special Trigonometric Ratios" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186550357}]}
