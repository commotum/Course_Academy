rname{cos}⁡{60}^{∘}=\\frac{1}{2},\\,\\operatorname{sin}⁡{90}^{∘}=1.\n$$\n\nHence,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡{60}^{∘}+\\operatorname{sin}⁡{90}^{∘} & = \\\\ \\frac{1}{2}+1 & = \\\\ \\frac{3}{2}. & \\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186080782 :answer-field/correct "answer-0808b740-b9a6-53e0-b0ca-072927115f09" :answer-field/choices ["answer-0808b740-b9a6-53e0-b0ca-072927115f09"] :db/ensure [:answer-field/validate]} {:db/id "answer-0808b740-b9a6-53e0-b0ca-072927115f09" :answer/id #uuid "0808b740-b9a6-53e0-b0ca-072927115f09" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "question-aec99370-575e-52b4-9e36-bb43c957f2bf" :question/id #uuid "aec99370-575e-52b4-9e36-bb43c957f2bf" :question/math-academy-id "q-266852" :question/problem "$\\operatorname{tan}⁡{45}^{∘}+\\operatorname{tan}⁡{0}^{∘}-\\operatorname{sin}⁡{90}^{∘}=${{field-1}}" :question/worked-solution "The angles of ${0}^{∘},$ ${45}^{∘},$ and ${90}^{∘}$ are special, and their trigonometric ratios have values\n\n$$\n\\operatorname{sin}⁡{90}^{∘}=1,\\,\\operatorname{tan}⁡{0}^{∘}=0,\\,\\operatorname{tan}⁡{45}^{∘}=1.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡{45}^{∘}+\\operatorname{tan}⁡{0}^{∘}-\\operatorname{sin}⁡{90}^{∘} & = \\\\ 1+0-1 & = \\\\ 0. & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2955e3b5-359a-52c1-ba32-374efd6a1771"] :db/ensure [:question/validate]} {:db/id "answer-field-2955e3b5-359a-52c1-ba32-374efd6a1771" :answer-field/id #uuid "2955e3b5-359a-52c1-ba32-374efd6a1771" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8bc9fa93-f40e-5310-8f1c-3a09ec82f709" :answer-field/choices ["answer-8bc9fa93-f40e-5310-8f1c-3a09ec82f709"] :db/ensure [:answer-field/validate]} {:db/id "answer-8bc9fa93-f40e-5310-8f1c-3a09ec82f709" :answer/id #uuid