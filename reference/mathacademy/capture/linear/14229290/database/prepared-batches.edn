9e71a1f8c744"] ["answer-field-ce869806-ba63-5a18-8a07-5e15d5ad7298" :answer-field/choices "answer-e80bfc0b-e9a2-5c8d-b1f4-256775d3038c"] ["question-602ff191-9fc8-5da7-a56d-e21a1e6c8aee" :question/answer-fields "answer-field-ce869806-ba63-5a18-8a07-5e15d5ad7298"] [17592186083366 :knowledge-point/questions "question-602ff191-9fc8-5da7-a56d-e21a1e6c8aee"] [17592186083631 :question/problem "$\\operatorname{cos}⁡{60}^{∘}+\\operatorname{sin}⁡{90}^{∘}=${{field-1}}"] [17592186083631 :question/worked-solution "The angles of ${60}^{∘}$ and ${90}^{∘}$ are special, and their trigonometric ratios have values\n\n$$\n\\operatorname{cos}⁡{60}^{∘}=\\frac{1}{2},\\,\\operatorname{sin}⁡{90}^{∘}=1.\n$$\n\nHence,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡{60}^{∘}+\\operatorname{sin}⁡{90}^{∘} & = \\\\ \\frac{1}{2}+1 & = \\\\ \\frac{3}{2}. & \\end{aligned}\n$$"] [17592186083631 :question/difficulty :question.difficulty/easy] ["answer-0808b740-b9a6-53e0-b0ca-072927115f09" :answer/id #uuid "0808b740-b9a6-53e0-b0ca-072927115f09"] ["answer-0808b740-b9a6-53e0-b0ca-072927115f09" :answer/type :answer.type/math] ["answer-0808b740-b9a6-53e0-b0ca-072927115f09" :answer/value "\\frac{3}{2}"] [17592186080782 :answer-field/correct "answer-0808b740-b9a6-53e0-b0ca-072927115f09"] [17592186080782 :answer-field/choices "answer-0808b740-b9a6-53e0-b0ca-072927115f09"] ["question-aec99370-575e-52b4-9e36-bb43c957f2bf" :question/id #uuid "aec99370-575e-52b4-9e36-bb43c957f2bf"] ["question-aec99370-575e-52b4-9e36-bb43c957f2bf" :question/math-academy-id "q-266852"] ["question-aec99370-575e-52b4-9e36-bb43c957f2bf" :question/problem "$\\operatorname{tan}⁡{45}^{∘}+\\operatorname{tan}⁡{0}^{∘}-\\operatorname{sin}⁡{90}^{∘}=${{field-1}}"] ["question-aec99370-575e-52b4-9e36-bb43c957f2bf" :question/worked-solution "The angles of ${0}^{∘},$ ${45}^{∘},$ and ${90}^{∘}$ are special, and their trigonometric ratios have values\n\n$$\n\\operatorname{sin}⁡{90}^{∘}=1,\\,\\operatorname{tan}⁡{0}^{∘}=0,\\,\\operatorname{tan}⁡{45}^{∘}=1.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡{45}^{∘}+\\operatorname{tan}⁡{0}^{∘}-\\operatorname{sin}⁡{90}^{∘} & = \\\\ 1+0-1 & = \\\\ 0. & \\end{aligned}\n$$"] ["question-aec99370-575e-52b4-9e36-bb43c957f2bf" :question/difficulty :question.difficulty/moderate] ["answer-field-2955e3b5-359a-52c1-ba32-374efd6a1771" :answer-field/id #uuid "2955e3b5-359a-52c1-ba32-374efd6a1771"] ["answer-8bc9fa93-f40e-5310-8f1c-3a09ec82f709" :answer/id #uuid "8bc9fa93-f40e-5310-8f1c-3a09ec82f709"] ["answer-8bc9fa93-f40e-5310-8f1c-3a09ec82f709" :answer/type :answer.type/math] ["answer-8bc9fa93-f40e-5310-8f1c-3a09ec82f709" :answer/value "0"] ["answer-field-2955e3b5-359a-52c1-ba32-374efd6a1771" :answer-field/key "field-1"] ["answer-field-2955e3b5-359a-52c1-ba32-374efd6a1771" :answer-field/type :answer-field.type/blank] ["answer-field-2955e3b5-359a-52c1-ba32-374efd6a1771" :answer-field/correct "answer-8bc9fa93-f40e-5310-8f1c-3a09ec82f709"] ["answer-field-2955e3b5-359a-52c1-ba32-374efd6a1771" :answer-field/choices "answer-8bc9fa93-f40e-5310-8f1c-3a09ec82f709"] ["question-aec99370-575e-52b4-9e36-bb43c957f2bf" :question/answer-fields "answer-field-2955e3b5-359a-52c1-ba32-374efd6a1771"] [17592186083367 :knowledge-point/questions "question-aec99370-575e-52b4-9e36-bb43c957f2bf"] ["activity-a10d6d36-1f91-5420-9d67-cff0214d8f55" :activity/id #uuid "a10d6d36-1f91-5420-9d67-cff0214d8f55"] ["step-5b7dbe22-dc0d-54cb-b4df-f39f966687ed" :step/id #uuid "5b7dbe22-dc0d-54cb-b4df-f39f966687ed"] ["step-9adf5944-13ef-501f-b0c3-0fc0d68be6fd" :step/id #uuid "9adf5944-13ef-501f-b0c3-0fc0d68be6fd"] ["step-306a8d26-1ef7-5b4b-a318-0b8e137317b1" :step/id #uuid "306a8d26-1ef7-5b4b-a318-0b8e137317b1"] ["step-2d08ae5a-3900-5a4e-830c-45eae619438c" :step/id #uuid "2d08ae5a-3900-5a4e-830c-45eae619438c"] ["step-8d66e22f-32f8-524d-9151-c3676a742fc5" :step/id #uuid "8d66e22f-32f8-524d-9151-c3676a742fc5"] ["step-5b7dbe22-dc0d-54cb-b4df-f39f966687ed" :step/content "question-da211e88-d789-5f6a-b87d-2366e18b07f4"