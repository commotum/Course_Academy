\operatorname{tan}⁡{45}^{∘} & = \\\\ 3{(\\frac{\\sqrt{3}}{3})}^{2}-1 & = \\\\ 3(\\frac{3}{9})-1 & = \\\\ 1-1 & = \\\\ 0 & .\\end{aligned}\n$$"] ["question-0f16c2b9-1c8b-50a4-93ab-bbcc2578659f" :question/difficulty :question.difficulty/hard] ["answer-field-c6a43897-150e-534f-a498-9f892cf924c2" :answer-field/id #uuid "c6a43897-150e-534f-a498-9f892cf924c2"] ["answer-847735f3-85e7-556f-ab13-996c4f671091" :answer/id #uuid "847735f3-85e7-556f-ab13-996c4f671091"] ["answer-847735f3-85e7-556f-ab13-996c4f671091" :answer/type :answer.type/math] ["answer-847735f3-85e7-556f-ab13-996c4f671091" :answer/value "-\\sqrt{3}"] ["answer-8a774edc-0a83-5eff-b7f3-8dd8b4849f1e" :answer/id #uuid "8a774edc-0a83-5eff-b7f3-8dd8b4849f1e"] ["answer-8a774edc-0a83-5eff-b7f3-8dd8b4849f1e" :answer/type :answer.type/math] ["answer-8a774edc-0a83-5eff-b7f3-8dd8b4849f1e" :answer/value "0"] ["answer-52b2408a-7f36-5c00-b12f-5d5d12445119" :answer/id #uuid "52b2408a-7f36-5c00-b12f-5d5d12445119"] ["answer-52b2408a-7f36-5c00-b12f-5d5d12445119" :answer/type :answer.type/math] ["answer-52b2408a-7f36-5c00-b12f-5d5d12445119" :answer/value "2"] ["answer-7676748a-b3e1-574b-8bbc-7af2c704efdc" :answer/id #uuid "7676748a-b3e1-574b-8bbc-7af2c704efdc"] ["answer-7676748a-b3e1-574b-8bbc-7af2c704efdc" :answer/type :answer.type/math] ["answer-7676748a-b3e1-574b-8bbc-7af2c704efdc" :answer/value "\\frac{\\sqrt{3}-1}{3}"] ["answer-420931a7-bfe9-57fd-be28-96ee8c3e7a3a" :answer/id #uuid "420931a7-bfe9-57fd-be28-96ee8c3e7a3a"] ["answer-420931a7-bfe9-57fd-be28-96ee8c3e7a3a" :answer/type :answer.type/math] ["answer-420931a7-bfe9-57fd-be28-96ee8c3e7a3a" :answer/value "\\sqrt{3}-1"] ["answer-field-c6a43897-150e-534f-a498-9f892cf924c2" :answer-field/key "selection"] ["answer-field-c6a43897-150e-534f-a498-9f892cf924c2" :answer-field/type :answer-field.type/radio] ["answer-field-c6a43897-150e-534f-a498-9f892cf924c2" :answer-field/correct "answer-8a774edc-0a83-5eff-b7f3-8dd8b4849f1e"] ["answer-field-c6a43897-150e-534f-a498-9f892cf924c2" :