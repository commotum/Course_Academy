3a895.png)\n\n![](images/81/81f94d814f98021781460cbe7c30470e3021832b40525da36563bb11af9804ad.png)\n\nThe intersection $(-\\infty ,4]\\cap (2,4)$ represents the values that are in both intervals. So, it can be graphed by finding where the two intervals overlap:\n\n![](images/77/772ae637383243d60d40f9bc015c5347b92159b7eccb27cefaa661341176b9d6.png)\n\nThus, $(-\\infty ,4]\\cap (2,4)=(2,4).$ This corresponds to the inequality $2<x<4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a40b13ce-419a-51fa-90e1-54d7c1abd5d3" "answer-field-4305667d-3a58-5875-9689-814a3ecc8986" "answer-field-efe77e00-1a52-5b52-ba41-a1e72bc9367b"] :db/ensure [:question/validate]} {:db/id "answer-field-a40b13ce-419a-51fa-90e1-54d7c1abd5d3" :answer-field/id #uuid "a40b13ce-419a-51fa-90e1-54d7c1abd5d3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6aec283e-3c07-5081-aa5d-febf7b6fb508" :answer-field/choices ["answer-6aec283e-3c07-5081-aa5d-febf7b6fb508"] :db/ensure [:answer-field/validate]} {:db/id "answer-6aec283e-3c07-5081-aa5d-febf7b6fb508" :answer/id #uuid "6aec283e-3c07-5081-aa5d-febf7b6fb508" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-field-4305667d-3a58-5875-9689-814a3ecc8986" :answer-field/id #uuid "4305667d-3a58-5875-9689-814a3ecc8986" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-58ec3812-afbd-5c73-b90c-51b83b621d84" :answer-field/choices ["answer-58ec3812-afbd-5c73-b90c-51b83b621d84"] :db/ensure [:answer-field/validate]} {:db/id "answer-58ec3812-afbd-5c73-b90c-51b83b621d84" :answer/id #uuid "58ec3812-afbd-5c73-b90c-51b83b621d84" :answer/type :answer.type/math :answer/value "<" :db/ensure [:answer/validate]} {:db/id "answer-field-efe77e00-1a52-5b52-ba41-a1e72bc9367b" :answer-field/id #uuid "efe77e00-1a52-5b52-ba41-a1e72bc9367b" :answer-field/key "field-3" :answer-field/type :answer-field.t