s of the values that are in both intervals. So, it can be graphed by finding where the two intervals overlap:\n\n![](images/fd/fdf3410c69cf8559abfb7b223fc175bd1704d6334c8abbceb45240c894514172.png)\n\nTherefore, the common set of values is\n$(2,4).$"] ["question-03c05eb1-a1b5-5135-a57f-9c96b45d2734" :question/difficulty :question.difficulty/easy] ["answer-field-0841ef22-9728-5f83-9df1-d7f2695e1b84" :answer-field/id #uuid "0841ef22-9728-5f83-9df1-d7f2695e1b84"] ["answer-8e1debc3-cbd2-53ac-a834-cf9e096cf727" :answer/id #uuid "8e1debc3-cbd2-53ac-a834-cf9e096cf727"] ["answer-8e1debc3-cbd2-53ac-a834-cf9e096cf727" :answer/type :answer.type/math] ["answer-8e1debc3-cbd2-53ac-a834-cf9e096cf727" :answer/value "(-1,4)"] ["answer-9599db7b-4328-50e9-b14b-8add3aa5bf58" :answer/id #uuid "9599db7b-4328-50e9-b14b-8add3aa5bf58"] ["answer-9599db7b-4328-50e9-b14b-8add3aa5bf58" :answer/type :answer.type/math] ["answer-9599db7b-4328-50e9-b14b-8add3aa5bf58" :answer/value "(-1,\\infty )"] ["answer-371497aa-662c-5dc2-85a5-02ad33faeac9" :answer/id #uuid "371497aa-662c-5dc2-85a5-02ad33faeac9"] ["answer-371497aa-662c-5dc2-85a5-02ad33faeac9" :answer/type :answer.type/math] ["answer-371497aa-662c-5dc2-85a5-02ad33faeac9" :answer/value "(-2,4)"] ["answer-7a0e8014-92a9-5ae3-9b9c-f437f28193fa" :answer/id #uuid "7a0e8014-92a9-5ae3-9b9c-f437f28193fa"] ["answer-7a0e8014-92a9-5ae3-9b9c-f437f28193fa" :answer/type :answer.type/math] ["answer-7a0e8014-92a9-5ae3-9b9c-f437f28193fa" :answer/value "(2,4)"] ["answer-1dfcf5c0-0550-500d-b874-8c0a705e1a2e" :answer/id #uuid "1dfcf5c0-0550-500d-b874-8c0a705e1a2e"] ["answer-1dfcf5c0-0550-500d-b874-8c0a705e1a2e" :answer/type :answer.type/math] ["answer-1dfcf5c0-0550-500d-b874-8c0a705e1a2e" :answer/value "(2,4]"] ["answer-field-0841ef22-9728-5f83-9df1-d7f2695e1b84" :answer-field/key "selection"] ["answer-field-0841ef22-9728-5f83-9df1-d7f2695e1b84" :answer-field/type :answer-field.type/radio] ["answer-field-0841ef22-9728-5f83-9df1-d7f2695e1b84" :answer-field/correct "answer-7a0e8014-92a9-5ae3-9b9c-f437f28193fa"] ["answer-field-0841ef22-9728-5f83-9df1-d7f2695e1b84" :answer-field/choices "answer-8e1debc3-cbd2-53ac-a834-cf9e096cf727"] ["answer-field-0841ef22-9728-5f83-9df1-d7f2695e1b84" :answer-field/choices "answer-9599db7b-4328-50e9-b14b-8add3aa5bf58"] ["answer-field-0841ef22-9728-5f83-9df1-d7f2695e1b84" :answer-field/choices "answer-371497aa-662c-5dc2-85a5-02ad33faeac9"] ["answer-field-0841ef22-9728-5f83-9df1-d7f2695e1b84" :answer-field/choices "answer-7a0e8014-92a9-5ae3-9b9c-f437f28193fa"] ["answer-field-0841ef22-9728-5f83-9df1-d7f2695e1b84" :answer-field/choices "answer-1dfcf5c0-0550-500d-b874-8c0a705e1a2e"] ["question-03c05eb1-a1b5-5135-a57f-9c96b45d2734" :question/answer-fields "answer-field-0841ef22-9728-5f83-9df1-d7f2695e1b84"] [17592186064175 :knowledge-point/questions "question-03c05eb1-a1b5-5135-a57f-9c96b45d2734"] ["question-7a7beadf-3b71-5ed6-8cee-74b01fe2145a" :question/id #uuid "7a7beadf-3b71-5ed6-8cee-74b01fe2145a"] ["question-7a7beadf-3b71-5ed6-8cee-74b01fe2145a" :question/math-academy-id "q-214598"] ["question-7a7beadf-3b71-5ed6-8cee-74b01fe2145a" :question/problem "Find the intersection of intervals $(-\\infty ,4]\\cap (2,4).$ Express the result as an inequality.\n\n{{field-1}}\n\n$<x$\n{{field-2}}{{field-3}}"] ["question-7a7beadf-3b71-5ed6-8cee-74b01fe2145a" :question/worked-solution "We start by sketching the two intervals $(-\\infty ,4]$ and $(2,4)$ separately:\n\n![](images/6e/6ea8f23ba164e820b4ae33f6dbd7e5d70e9dd0b5af052a7ce5ecdcb680d3a895.png)\n\n![](images/81/81f94d814f98021781460cbe7c30470e3021832b40525da36563bb11af9804ad.png)\n\nThe intersection $(-\\infty ,4]\\cap (2,4)$ represents the values that are in both intervals. So, it can be graphed by finding where the two intervals overlap:\n\n![](images/77/772ae637383243d60d40f9bc015c5347b92159b7eccb27cefaa661341176b9d6.png)\n\nThus, $(-\\infty ,4]\\cap (2,4)=(2,4).$ This corresponds to the inequality $2<x<4.$"] ["question-7a7beadf-3b71-5ed6-8cee-74b01fe2145a" :question/difficulty :question.difficulty/easy] ["answer-field-a40b13ce-419a-51fa-90e1-54d7c1abd5d3" :answer-field/id #uuid "a40b13ce-419a-51fa-90e1-54d7c1abd5d3"] ["answer-6aec283e-3c07-5081-aa5d-febf7b6fb508" :answer/id #uuid "6aec283e-3c07-5081-aa5d-febf7b6fb508"] ["answer-6aec283e-3c07-5081-aa5d-febf7b6fb508" :answer/type :answer.type/math] ["answer-6aec283e-3c07-5081-aa5d-febf7b6fb508" :answer/value "2"] ["answer-field-a40b13ce-419a-51fa-90e1-54d7c1abd5d3" :answer-field/key "field-1"] ["answer-field-a40b13ce-419a-51fa-90e1-54d7c1abd5d3" :answer-field/type :answer-field.type/blank] ["answer-field-a40b13ce-419a-51fa-90e1-54d7c1abd5d3" :answer-field/correct "answer-6aec283e-3c07-5081-aa5d-febf7b6fb508"] ["answer-field-a40b13ce-419a-51fa-90e1-54d7c1abd5d3" :answer-field/choices "answer-6aec283e-3c07-5081-aa5d-febf7b6fb508"] ["answer-field-4305667d-3a58-5875-9689-814a3ecc8986" :answer-field/id #uuid "4305667d-3a58-5875-9689-814a3ecc8986"] ["answer-58ec3812-afbd-5c73-b90c-51b83b621d84" :answer/id #uuid "58ec3812-afbd-5c73-b90c-51b83b621d84"] ["answer-58ec3812-afbd-5c73-b90c-51b83b621d84" :answer/type :answer.type/math] ["answer-58ec3812-afbd-5c73-b90c-51b83b621d84" :answer/value "<"] ["answer-field-4305667d-3a58-5875-9689-814a3ecc8986" :answer-field/key "field-2"] ["answer-field-4305667d-3a58-5875-9689-814a3ecc8986" :answer-field/type :answer-field.type/blank] ["answer-field-4305667d-3a58-5875-9689-814a3ecc8986" :answer-field/correct "answer-58ec3812-afbd-5c73-b90c-51b83b621d84"] ["answer-field-4305667d-3a58-5875-9689-814a3ecc8986" :answer-field/choices "answer-58ec3812-afbd-5c73-b90c-51b83b621d84"] ["answer-field-efe77e00-1a52-5b52-ba41-a1e72bc9367b" :answer-field/id #uuid "efe77e00-1a52-5b52-ba41-a1e72bc9367b"] ["answer-67af5bad-d3be-5cd1-adb7-fa7b815b8465" :answer/id #uuid "67af5bad-d3be-5cd1-adb7-fa7b815b8465"] ["answer-67af5bad-d3be-5cd1-adb7-fa7b815b8465" :answer/type :answer.type/math] ["answer-67af5bad-d3be-5cd1-adb7-fa7b815b8465" :answer/value "4"] ["answer