#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186567143} :activity/id #uuid "08961f5b-f314-52af-8176-bbeeae10b22e" :activity/scope {:db/id #edb/ref 17592186049270 :topic/id #uuid "e8c80d1f-e431-5719-bd9e-4793fa8d0ec3" :topic/math-academy-id 347} :activity/steps [{:db/id #edb/ref 17592186567143 :step/content {:db/id #edb/ref 17592186567035 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "648a569e-d6e2-581e-aaf0-c3843ce4953c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x>1" :db/id #edb/ref 17592186566556} {:answer/id #uuid "9ab7a7d4-8d57-556e-a809-860ec8ff4839" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2<x\\le 1" :db/id #edb/ref 17592186566664} {:answer/id #uuid "ad77b642-5d0e-5f8c-a29c-a1e7f5ae4898" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2<x<1" :db/id #edb/ref 17592186566709} {:answer/id #uuid "dfd54e2f-92b2-5044-821d-60b7f0fbe85a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x<2" :db/id #edb/ref 17592186566812} {:answer/id #uuid "e5b8e284-2962-5a81-950b-945c41e9dbf2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge 1" :db/id #edb/ref 17592186566827}] :answer-field/correct {:db/id #edb/ref 17592186566556} :answer-field/id #uuid "c997497d-11b1-5f1f-b96d-9d3ba0bd5017" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566972}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "41aba970-483d-56bd-ae8a-765c80a69d27" :question/math-academy-id "q-28887" :question/problem "Find the intersection of intervals $(-2,\\infty )\\cap (1,\\infty ).$ Express the result as an inequality." :question/worked-solution "We start by sketching the two intervals $(-2,\\infty )$ and $(1,\\infty )$ separately:\n\n![](images/4b/4bd70e5f89643a5d2b19954003435b4c6aeec24c68bb3cd1f6a4e7a98c14f847.png)\n\n![](images/ef/eff58d0bb2d496d608ae1e415f38589c5b9b13efe1f282d172fb5313ba6792ff.png)\n\nThe intersection $(-2,\\infty )\\cap (1,\\infty )$ represents the values that are in both intervals. So, it can be graphed by finding where the two intervals overlap:\n\n![](images/61/6131e16f37e8ec44eae8c085be60a28dd094390e1975bdafe256cdc9e229f3dc.png)\n\nThus, $(-2,\\infty )\\cap (1,\\infty )=(1,\\infty ).$ This corresponds to the inequality $x>1.$"} :step/id #uuid "bc861a89-3878-5857-a936-629ce6d04a38" :step/next {:db/id #edb/ref 17592186567147}} {:db/id #edb/ref 17592186567147 :step/content {:db/id #edb/ref 17592186567010 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dfcf5c0-0550-500d-b874-8c0a705e1a2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,4]" :db/id #edb/ref 17592186566426} {:answer/id #uuid "371497aa-662c-5dc2-85a5-02ad33faeac9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-2,4)" :db/id #edb/ref 17592186566474} {:answer/id #uuid "7a0e8014-92a9-5ae3-9b9c-f437f28193fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,4)" :db/id #edb/ref 17592186566596} {:answer/id #uuid "8e1debc3-cbd2-53ac-a834-cf9e096cf727" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,4)" :db/id #edb/ref 17592186566637} {:answer/id #uuid "9599db7b-4328-50e9-b14b-8add3aa5bf58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,\\infty )" :db/id #edb/ref 17592186566658}] :answer-field/correct {:db/id #edb/ref 17592186566596} :answer-field/id #uuid "0841ef22-9728-5f83-9df1-d7f2695e1b84" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566881}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "03c05eb1-a1b5-5135-a57f-9c96b45d2734" :question/math-academy-id "q-44840" :question/problem "Given the inequalities $-1<x<4$ and $x>2$, express their common set of solutions as an interval." :question/worked-solution "We start by sketching the solutions to the two inequalities separately:\n\n![](images/f9/f9409f298a0f4d1fd06bdac159e8fd7eb034ee577d2c8956730f0cc3919e051a.png)\n\n![](images/f4/f4fd2c61f600408511d967690cf02c95a3d2fa470aa5d7e9176a222d16823d5b.png)\n\nThe common set of values consists of the values that are in both intervals. So, it can be graphed by finding where the two intervals overlap:\n\n![](images/fd/fdf3410c69cf8559abfb7b223fc175bd1704d6334c8abbceb45240c894514172.png)\n\nTherefore, the common set of values is\n$(2,4).$"} :step/id #uuid "c7625faa-1053-58cf-a1fe-1a9cb0cbd666" :step/next {:db/id #edb/ref 17592186567148}} {:db/id #edb/ref 17592186567148 :step/content {:db/id #edb/ref 17592186567054 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58ec3812-afbd-5c73-b90c-51b83b621d84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186566532}] :answer-field/correct {:db/id #edb/ref 17592186566532} :answer-field/id #uuid "4305667d-3a58-5875-9689-814a3ecc8986" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566909} {:answer-field/choices [{:answer/id #uuid "6aec283e-3c07-5081-aa5d-febf7b6fb508" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186566565}] :answer-field/correct {:db/id #edb/ref 17592186566565} :answer-field/id #uuid "a40b13ce-419a-51fa-90e1-54d7c1abd5d3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566957} {:answer-field/choices [{:answer/id #uuid "67af5bad-d3be-5cd1-adb7-fa7b815b8465" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186566560}] :answer-field/correct {:db/id #edb/ref 17592186566560} :answer-field/id #uuid "efe77e00-1a52-5b52-ba41-a1e72bc9367b" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566993}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7a7beadf-3b71-5ed6-8cee-74b01fe2145a" :question/math-academy-id "q-214598" :question/problem "Find the intersection of intervals $(-\\infty ,4]\\cap (2,4).$ Express the result as an inequality.\n\n{{field-1}}\n\n$<x$\n{{field-2}}{{field-3}}" :question/worked-solution "We start by sketching the two intervals $(-\\infty ,4]$ and $(2,4)$ separately:\n\n![](images/6e/6ea8f23ba164e820b4ae33f6dbd7e5d70e9dd0b5af052a7ce5ecdcb680d3a895.png)\n\n![](images/81/81f94d814f98021781460cbe7c30470e3021832b40525da36563bb11af9804ad.png)\n\nThe intersection $(-\\infty ,4]\\cap (2,4)$ represents the values that are in both intervals. So, it can be graphed by finding where the two intervals overlap:\n\n![](images/77/772ae637383243d60d40f9bc015c5347b92159b7eccb27cefaa661341176b9d6.png)\n\nThus, $(-\\infty ,4]\\cap (2,4)=(2,4).$ This corresponds to the inequality $2<x<4.$"} :step/id #uuid "c801bfca-4ee3-51d3-bf92-d0fa094146e1"}] :activity/title "Intersections of Intervals" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186566351}]}
