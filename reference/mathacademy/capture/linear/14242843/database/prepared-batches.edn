question.difficulty/easy :question/answer-fields ["answer-field-5385cd64-eaa0-5383-9862-ec961c5356f1"] :db/ensure [:question/validate]} {:db/id "answer-field-5385cd64-eaa0-5383-9862-ec961c5356f1" :answer-field/id #uuid "5385cd64-eaa0-5383-9862-ec961c5356f1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9f173271-91e1-5ea2-b21f-c2beeb9aca0e" :answer-field/choices ["answer-9f173271-91e1-5ea2-b21f-c2beeb9aca0e" "answer-d946bf11-11c9-5691-b17e-d17b5d30a9cf" "answer-f25f2f8c-33a3-5d70-9d04-894773be002f" "answer-4c39f327-cff0-5908-a96b-7c4c25562bdd" "answer-2fa1e24c-c035-562e-a8a2-07e26ba77f25"] :db/ensure [:answer-field/validate]} {:db/id "answer-9f173271-91e1-5ea2-b21f-c2beeb9aca0e" :answer/id #uuid "9f173271-91e1-5ea2-b21f-c2beeb9aca0e" :answer/type :answer.type/math :answer/value "-2<x<4" :db/ensure [:answer/validate]} {:db/id "answer-d946bf11-11c9-5691-b17e-d17b5d30a9cf" :answer/id #uuid "d946bf11-11c9-5691-b17e-d17b5d30a9cf" :answer/type :answer.type/math :answer/value "-2\\le x\\le 4" :db/ensure [:answer/validate]} {:db/id "answer-f25f2f8c-33a3-5d70-9d04-894773be002f" :answer/id #uuid "f25f2f8c-33a3-5d70-9d04-894773be002f" :answer/type :answer.type/math :answer/value "-3<x<3" :db/ensure [:answer/validate]} {:db/id "answer-4c39f327-cff0-5908-a96b-7c4c25562bdd" :answer/id #uuid "4c39f327-cff0-5908-a96b-7c4c25562bdd" :answer/type :answer.type/math :answer/value "-4\\le x<2" :db/ensure [:answer/validate]} {:db/id "answer-2fa1e24c-c035-562e-a8a2-07e26ba77f25" :answer/id #uuid "2fa1e24c-c035-562e-a8a2-07e26ba77f25" :answer/type :answer.type/math :answer/value "-\\infty <x<\\infty " :db/ensure [:answer/validate]} {:db/id 17592186180264 :question/problem "![](images/cb/cb51a649e28ff8e9c94d5afcc46fece2ef2f355f50d1fa51113c146c4fde1951.png)\n\nFor the function $y=f(x)$ shown above, what is the range of the inverse function ${f}^{-1}(x)?$" :question/worked-solution "First, we recall the following:\n\n- The domain of a function $f(x)$ is the range of its inverse function ${f}^{-1}(x).$\n\n- The range of a function $f(x)$ is the domain of its inverse function ${f}^{-1}(x).$\n\nFrom the graph, we see that the domain of $f(x)$ is:\n\n$$\n-2<x<4\n$$\n\nTherefore, the range of ${f}^{-1}(x)$ is:\n\n$$\n-2<{f}^{-1}(x)<4\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186179128 :answer-field/correct "answer-0eb74d47-5819-51e6-987f-c47594800e7e" :answer-field/choices ["answer-0eb74d47-5819-51e6-987f-c47594800e7e" "answer-84c08631-0c69-50aa-ad0b-25457d685152" "answer-b1e34b36-ae62-52f5-986a-3b72e39715be" "answer-93dd0e20-404e-5267-89e3-a04adfa86c34" "answer-ee173d36-05ed-5aa9-963b-321b4dde6642"] :db/ensure [:answer-field/validate]} {:db/id "answer-0eb74d47-5819-51e6-987f-c47594800e7e" :answer/id #uuid "0eb74d47-5819-51e6-987f-c47594800e7e" :answer/type :answer.type/math :answer/value "-2<{f}^{-1}(x)<4" :db/ensure [:answer/validate]} {:db/id "answer-84c08631-0c69-50aa-ad0b-25457d685152" :answer/id #uuid "84c08631-0c69-50aa-ad0b-25457d685152" :answer/type :answer.type/math :answer/value "-4<{f}^{-1}(x)<4" :db/ensure [:answer/validate]} {:db/id "answer-b1e34b36-ae62-52f5-986a-3b72e39715be" :answer/id #uuid "b1e34b36-ae62-52f5-986a-3b72e39715be" :answer/type :answer.type/math :answer/value "-5<{f}^{-1}(x)<-2" :db/ensure [:answer/validate]} {:db/id "answer-93dd0e20-404e-5267-89e3-a04adfa86c34" :answer/id #uuid "93dd0e20-404e-5267-89e3-a04adfa86c34" :answer/type :answer.type/math :answer/value "-5<{f}^{-1}(x)<-4" :db/ensure [:answer/validate]} {:db/id "answer-ee173d36-05ed-5aa9-963b-321b4dde6642" :answer/id #uuid "ee173d36-05ed-5aa9-963b-321b4dde6642" :answer/type :answer.type/math :answer/value "-5<{f}^{-1}(x)<4" :db/ensure [:answer/validate]} {:db/id "question-8a8a5b01-a34a-5ec4-a40f-b067d49707a5" :question/id #uuid "8a8a5b01-a34a-5ec4-a40f-b067d49707a5" :question/math-academy-id "q-19230" :question/problem "![](images/3d/3d94b4960b926026845ee1949