#{[{:activity/first-step {:db/id #edb/ref 17592186180538} :activity/id #uuid "bb07ba37-9d88-541a-aba3-d78d68a1d5a5" :activity/scope {:db/id #edb/ref 17592186049461 :topic/id #uuid "f727706e-f155-538d-846e-046fd49bd5ae" :topic/math-academy-id 3734} :activity/steps [{:db/id #edb/ref 17592186180538 :step/content {:db/id #edb/ref 17592186180753 :tutorial/content "Consider the function $y=f(x)$ whose graph is shown below.\n\n![](images/c0/c0bd305d326688f49ecf0579ee42217a58a7521be8a410f619cbe26f5c443991.png)\n\nNotice that\n\n- the domain of $f(x)$ is $[1,2]$, and\n- the range of $f(x)$ is $[2,6]$.\n\nRecall that each point $(a,b)$ on the graph of\n\n$$\n{\\color{blue}y=f(x)}\n$$\n\nhas a corresponding point $(b,a)$ on the graph of the inverse function\n\n$$\n{\\color{red}y=f^{-1}(x)}\n$$\n\nThat is to say, the $x$ and $y$ coordinates swap.\n\n![](images/1d/1dd83a834e14f8f3679db1c013f23cce80ec9b2546393cf77ee613140c6b7b5f.png)\n\nNotice that\n\n- the domain of $f^{-1}(x)$ is $[2,6]$, and\n- the range of $f^{-1}(x)$ is $[1,2]$.\n\nIn general:\n\n- The domain of a function ${\\color{blue}f(x)}$ is the range of its inverse function ${\\color{red}f^{-1}(x)}$.\n- The range of a function ${\\color{blue}f(x)}$ is the domain of its inverse function ${\\color{red}f^{-1}(x)}$." :tutorial/id #uuid "acfa1bdd-d0e9-599e-b247-2194ce7890b6" :tutorial/math-academy-id 6760 :tutorial/title "Introduction"} :step/id #uuid "5000041d-1c2d-5af3-b317-27d7d59b886f" :step/math-academy-id 40969 :step/next {:db/id #edb/ref 17592186180539}} {:db/id #edb/ref 17592186180539 :step/content {:db/id #edb/ref 17592186179755 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179422 :question/id #uuid "5c02a325-ceed-525b-b0af-dcc7d082c777" :question/math-academy-id "e-10809"} :knowledge-point/id #uuid "ccfca315-de53-561a-9ae1-18a2124ea24b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048686} {:db/id #edb/ref 17592186049072}] :knowledge-point/questions [{:db/id #edb/ref 17592186180081} {:db/id #edb/ref 17592186180261}] :knowledge-point/title "Finding the Domain of an Inverse Function Using a Graph"} :step/id #uuid "e0247644-618c-5d4a-88dd-8dd0a2429b88" :step/math-academy-id 40970 :step/next {:db/id #edb/ref 17592186180541}} {:db/id #edb/ref 17592186180540 :step/content {:db/id #edb/ref 17592186179756 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179423 :question/id #uuid "3d784815-6930-5b44-b1a4-6cf2d3e2eeb0" :question/math-academy-id "e-10810"} :knowledge-point/id #uuid "8f4acd94-b4a7-59ce-b6cb-3d3310b167fd" :knowledge-point/questions [{:db/id #edb/ref 17592186180168} {:db/id #edb/ref 17592186180263}] :knowledge-point/title "Finding the Domain and Range of an Inverse Function Using a Description"} :step/id #uuid "bdce094c-b531-5496-863a-9836b5e6763b" :step/math-academy-id 40973} {:db/id #edb/ref 17592186180541 :step/content {:db/id #edb/ref 17592186179757 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179424 :question/id #uuid "93801dca-c5a6-5c7e-b10b-1e407332927a" :question/math-academy-id "e-10823"} :knowledge-point/id #uuid "3f9429da-a9d4-5dfc-940a-ef24066a5b65" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049707}] :knowledge-point/questions [{:db/id #edb/ref 17592186180082} {:db/id #edb/ref 17592186180264}] :knowledge-point/title "Finding the Range of an Inverse Function Using a Graph"} :step/id #uuid "d8b889b6-78fb-5a4a-a968-0e44de4cb9af" :step/math-academy-id 41012 :step/next {:db/id #edb/ref 17592186180540}}] :activity/title "Domain and Range of Inverse Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179882}]}
