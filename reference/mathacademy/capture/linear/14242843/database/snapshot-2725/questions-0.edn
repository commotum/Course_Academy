#{[{:db/id #edb/ref 17592186179422 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179755 :knowledge-point/id #uuid "ccfca315-de53-561a-9ae1-18a2124ea24b" :knowledge-point/title "Finding the Domain of an Inverse Function Using a Graph"}] :question/id #uuid "5c02a325-ceed-525b-b0af-dcc7d082c777" :question/math-academy-id "e-10809" :question/problem "For the function $y = f(x)$ shown below, what is the domain of the inverse function $f^{-1}(x)$?\n\n![](images/ad/adf44ae3f3c8cb3bbe1958cca12e559b68d4d95247d087c69cb90425dbc05785.png)" :question/worked-solution "First, we recall the following:\n\n- The domain of a function $f(x)$ is the range of its inverse function $f^{-1}(x)$.\n- The range of a function $f(x)$ is the domain of its inverse function $f^{-1}(x)$.\n\nFrom the graph, we see that the range of $f(x)$ is\n\n$$\n0 \\leq f(x) \\lt 9\n$$\n\nTherefore, the domain of $f^{-1}(x)$ is\n\n$$\n0 \\leq x \\lt 9\n$$"}] [{:db/id #edb/ref 17592186179423 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179756 :knowledge-point/id #uuid "8f4acd94-b4a7-59ce-b6cb-3d3310b167fd" :knowledge-point/title "Finding the Domain and Range of an Inverse Function Using a Description"}] :question/id #uuid "3d784815-6930-5b44-b1a4-6cf2d3e2eeb0" :question/math-academy-id "e-10810" :question/problem "The domain of the function $f(x)$ is $-3\\lt x \\leq 3$ and the range of $f$ is $-2\\leq f(x) \\lt 2$. What is the range of the inverse function $f^{-1}(x)$?" :question/worked-solution "First, we recall the following:\n\n- The domain of a function $f(x)$ is the range of its inverse function $f^{-1}(x)$.\n- The range of a function $f(x)$ is the domain of its inverse function $f^{-1}(x)$.\n\nThe domain of $f(x)$ is\n\n$$\n-3\\lt x \\leq 3\n$$\n\nTherefore, the range of $f^{-1}(x)$ is\n\n$$\n-3\\lt f^{-1}(x) \\leq 3\n$$"}] [{:db/id #edb/ref 17592186179424 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179757 :knowledge-point/id #uuid "3f9429da-a9d4-5dfc-940a-ef24066a5b65" :knowledge-point/title "Finding the Range of an Inverse Function Using a Graph"}] :question/id #uuid "93801dca-c5a6-5c7e-b10b-1e407332927a" :question/math-academy-id "e-10823" :question/problem "![](images/c1/c187a2fdc4c34135836afd2f28af17776cee6408b1e7bf3124d4833ca0529000.png)\n\nFor the function $y = f(x)$ shown above, what is the range of the inverse function $f^{-1}(x)$?" :question/worked-solution "First, we recall the following:\n\n- The domain of a function $f(x)$ is the range of its inverse function $f^{-1}(x)$.\n- The range of a function $f(x)$ is the domain of its inverse function $f^{-1}(x)$.\n\nFrom the graph, we see that the domain of $f(x)$ is\n\n$$\n-1 \\lt x \\lt 4\n$$\n\nTherefore, the range of $f^{-1}(x)$ is\n\n$$\n-1 \\lt f^{-1}(x) \\lt 4\n$$"}] [{:db/id #edb/ref 17592186180264 :knowledge-point/_questions [{:db/id #edb/ref 17592186179757 :knowledge-point/id #uuid "3f9429da-a9d4-5dfc-940a-ef24066a5b65" :knowledge-point/title "Finding the Range of an Inverse Function Using a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9d917f2-8033-5c86-b983-4b2b73f19d5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5 < f^{-1}(x) < - 4" :db/id #edb/ref 17592186179129} {:answer/id #uuid "c827a158-7149-530c-b70b-fdbc77a1cb03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4 < f^{-1}(x) < 4" :db/id #edb/ref 17592186179130} {:answer/id #uuid "d31a7e1a-570d-525b-91cf-2b4e6b241698" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5 < f^{-1}(x) < - 2" :db/id #edb/ref 17592186179131} {:answer/id #uuid "f38f41b6-2eb4-55f7-8313-c3bf4df3efc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5 < f^{-1}(x) < 4" :db/id #edb/ref 17592186179132} {:answer/id #uuid "6c8b482f-d47a-527a-a2b7-a552f21d8b4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2 < f^{-1}(x) < 4" :db/id #edb/ref 17592186179133}] :answer-field/id #uuid "84247c83-2195-5d12-9916-372520a6f89b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186179128}] :question/id #uuid "e6ea0b24-21b7-5bef-8aeb-8e70a3043503" :question/math-academy-id "q-7030" :question/problem "![](images/cb/cb51a649e28ff8e9c94d5afcc46fece2ef2f355f50d1fa51113c146c4fde1951.png)\n\nFor the function $y = f(x)$ shown above, what is the range of the inverse function $f^{-1}(x)$?"}]}
