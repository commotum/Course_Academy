5417] [17592186049352 #edb/ref 1029 #edb/ref 17592186428109 #edb/ref 17592186045436] [17592186049352 #edb/ref 1031 "Calculating Derivatives From Graphs" #edb/ref 17592186045417] [17592186049352 #edb/ref 1033 1117 #edb/ref 17592186045417] [17592186049352 #edb/ref 1034 1.2958652613476669 #edb/ref 17592186045436] [17592186049352 #edb/ref 1035 #uuid "ee0cf1a5-e7d1-5e77-84d9-efd5a5be54f2" #edb/ref 17592186045417] [17592186050400 #edb/ref 1027 #edb/ref 17592186048260 #edb/ref 17592186045417] [17592186050400 #edb/ref 1028 #edb/ref 17592186105862 #edb/ref 17592186045417] [17592186050400 #edb/ref 1028 #edb/ref 17592186105863 #edb/ref 17592186045417] [17592186050400 #edb/ref 1028 #edb/ref 17592186105864 #edb/ref 17592186045417] [17592186050400 #edb/ref 1028 #edb/ref 17592186105865 #edb/ref 17592186045417] [17592186050400 #edb/ref 1031 "Calculating Derivatives From Data Using the Chain Rule" #edb/ref 17592186045417] [17592186050400 #edb/ref 1033 1282 #edb/ref 17592186045417] [17592186050400 #edb/ref 1035 #uuid "45b70174-b66e-5c6c-b00b-00ab595d2c86" #edb/ref 17592186045417] [17592186050961 #edb/ref 1027 #edb/ref 17592186049352 #edb/ref 17592186045417] [17592186050961 #edb/ref 1027 #edb/ref 17592186050400 #edb/ref 17592186045417] [17592186050961 #edb/ref 1028 #edb/ref 17592186100827 #edb/ref 17592186045417] [17592186050961 #edb/ref 1028 #edb/ref 17592186100828 #edb/ref 17592186045417] [17592186050961 #edb/ref 1028 #edb/ref 17592186100919 #edb/ref 17592186045417] [17592186050961 #edb/ref 1028 #edb/ref 17592186100920 #edb/ref 17592186045417] [17592186050961 #edb/ref 1031 "Calculating Derivatives From Data and Tables" #edb/ref 17592186045417] [17592186050961 #edb/ref 1033 1249 #edb/ref 17592186045417] [17592186050961 #edb/ref 1034 0.9686915310449942 #edb/ref 17592186045436] [17592186050961 #edb/ref 1035 #uuid "75a8462b-b2e3-545e-a142-3221dfd27093" #edb/ref 17592186045417] [17592186100662 #edb/ref 1069 "e-3640" #edb/ref 17592186045417] [17592186100662 #edb/ref 1071 "The values of functions $h(x)$ and $z(x)$ and their derivatives at $x=-1$ are given in the table below.\n\n| $x$ | $h(x)$ | $z(x)$ | $h'(x)$ | $z'(x)$ |\n| --- | --- | --- | --- | --- |\n| $-1$ | $-4$ | $2$ | $6$ | $3$ |\n\nCompute $\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(\\dfrac{h(x)}{z(x)}\\right)$ at $x=-1.$" #edb/ref 17592186045417] [17592186100662 #edb/ref 1072 #uuid "0713e68d-2b3e-5010-954f-7891d96bdbbb" #edb/ref 17592186045417] [17592186100662 #edb/ref 1074 "Using the quotient rule, we get\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(\\dfrac{h(x)}{z(x)}\\right) = \\dfrac{h'(x)z(x)-h(x)z'(x)}{(z(x))^2}.\n$$\n\nAt the point where $x=-1$, this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(\\frac{h(x)}{z(x)})|}_{x=-1} & =\\frac{{h}^{′}(-1)z(-1)-h(-1){z}^{′}(-1)}{(z(-1))^{2}} \\\\  & =\\frac{6\\cdot 2-(-4)\\cdot 3}{{2}^{2}} \\\\  & =\\frac{24}{4} \\\\  & =6.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186100663 #edb/ref 1069 "e-3641" #edb/ref 17592186045417] [17592186100663 #edb/ref 1071 "For the functions $f(x)$ and $g(x),$ we have\n\n$$\nf(1)=2, \\quad f'(1)=2, \\quad g(1)=-1, \\quad g'(1)=3.\n$$\n\nIf  $h(x) = \\left( f(x)-1 \\right)\\left(2g(x)+1\\right),$  compute  $h'(1).$" #edb/ref 17592186045417] [17592186100663 #edb/ref 1072 #uuid "787e9681-8009-5ba8-acda-6d8830397d18" #edb/ref 17592186045417] [17592186100663 #edb/ref 1074 "The product rule states that\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}\\Big(uv\\Big) = u \\dfrac{\\textrm d v}{\\textrm d x} +v \\dfrac{\\textrm du}{\\textrm d x}.\n$$\n\nLet $u=f(x)-1$ and $v=2g(x)+1.$ Differentiating each, we get\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = f'(x) \\qquad  \\text{and}\\qquad \\dfrac{\\textrm d v}{\\textrm d x} = 2g'(x).\n$$\n\nSubstituting this into the product rule gives\n\n$$\n\\begin{aligned}{h}^{′}(x) & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =(f(x)-1)\\cdot 2{g}^{′}(x)+(2g(x)+1)\\cdot {f}^{′}(x) \\\\  & =2{g}^{′}(x)(f(x)-1)+{f}^{′}(x)(2g(x)+1).\\end{aligned}\n$$\n\nAt $x=1$, this gives\n\n$$\n\\begin{aligned}{h}^{′}(1) & =2{g}^{′}(1)(f(1)-1)+{f}^{′}(1)(2g(1)+1) \\\\  & =2\\cdot 3\\cdot (2-1)+2\\cdot (2\\cdot (-1)+1) \\\\  & =4.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186100749 #edb/ref 1069 "e-6154" #edb/ref 17592186045417] [17592186100749 #edb/ref 1071 "The values of functions $p(x)$ and $q(x)$ and their derivatives at $x=-3$ are given in the table below.\n\n| $x$ | $p(x)$ | $q(x)$ | $p'(x)$ | $q'(x)$ |\n| --- | --- | --- | --- | --- |\n| $-3$ | $1$ | $8$ | $0$ | $-2$ |\n\nCompute $\\dfrac{\\textrm{d}}{\\textrm{d}x}\\big( p(x) + 5q(x) \\big)$ at $x=-3.$" #edb/ref 17592186045417] [17592186100749 #edb/ref 1072 #uuid "a87386d5-4a1b-539c-aeb9-dd60181baa4f" #edb/ref 17592186045417] [17592186100749 #edb/ref 1074 "Using the sum and constant multiple rules, we get\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left( p(x) + 5q(x) \\right) = p'(x) + 5q'(x).\n$$\n\nAt the point where $x=-3$, this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(p(x)+5q(x))|}_{x=-3} & ={p}^{′}(-3)+5{q}^{′}(-3) \\\\  & =0+5\\cdot (-2) \\\\  & =-10.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186100750 #edb/ref 1069 "e-6155" #edb/ref 17592186045417] [17592186100750 #edb/ref 1071 "The values of functions $f(x)$ and $g(x)$ and their derivatives at $x=0$ are given in the table below.\n\n| $x$ | $f(x)$ | $g(x)$ | $f'(x)$ | $g'(x)$ |\n| --- | --- | --- | --- | --- |\n| $0$ | $1$ | $3$ | $-2$ | $0$ |\n\nCompute $\\dfrac{\\textrm{d}}{\\textrm{d}x}\\big(f(x)g(x)\\big)$ at $x=0.$" #edb/ref 17592186045417] [17592186100750 #edb/ref 1072 #uuid "d1d0a3ec-2a84-580a-968e-53b773510853" #edb/ref 17592186045417] [17592186100750 #edb/ref 1074 "Using the product rule, we get\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}\\big(f(x)g(x)\\big) = f(x)g'(x)+f'(x)g(x).\n$$\n\nAt the point where $x=0$, this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(f(x)g(x))|}_{x=0} & =f(0){g}^{′}(0)+{f}^{′}(0)g(0) \\\\  & =1\\cdot 0+3\\cdot (-2) \\\\  & =-6.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186100827 #edb/ref 1037 #edb/ref 17592186048842 #edb/ref 17592186045417] [17592186100827 #edb/ref 1038 #edb/ref 17592186101218 #edb/ref 17592186045417] [17592186100827 #edb/ref 1038 #edb/ref 17592186101442 #edb/ref 17592186045417] [17592186100827 #edb/ref 1038 #edb/ref 17592186241039 #edb/ref 17592186045417] [17592186100827 #edb/ref 1038 #edb/ref 17592186297327 #edb/ref 17592186045417] [17592186100827 #edb/ref 1038 #edb/ref 17592186315039 #edb/ref 17592186045417] [17592186100827 #edb/ref 1038 #edb/ref 17592186315040 #edb/ref 17592186045417] [17592186100827 #edb/ref 1038 #edb/ref 17592186329930 #edb/ref 17592186045417] [17592186100827 #edb/ref 1038 #edb/ref 17592186329944 #edb/ref 17592186045417] [17592186100827 #edb/ref 1038 #edb/ref 17592186445183 #edb/ref 17592186045417] [17592186100827 #edb/ref 1038 #edb/ref 17592186445189 #edb/ref 17592186045417] [17592186100827 #edb/ref 1038 #edb/ref 17592186573257 #edb/ref 17592186045417] [17592186100827 #edb/ref 1038 #edb/ref 17592186573282 #edb/ref 17592186045417] [17592186100827 #edb/ref 1039 "Computing the Derivative of a Quotient Given the Necessary Data" #edb/ref 17592186045417] [17592186100827 #edb/ref 1041 #edb/ref 17592186100662 #edb/ref 17592186045417] [17592186100827 #edb/ref 1042 #uuid "d2b7d79a-cd1a-583f-be7a-d568bc8e32a3" #edb/ref 17592186045417] [17592186100828 #edb/ref 1038 #edb/ref 17592186101450 #edb/ref 17592186045417] [17592186100828 #edb/ref 1038 #edb/ref 17592186101532 #edb/ref 17592186045417] [17592186100828 #edb/ref 1038 #edb/ref 17592186240930 #edb/ref 17592186045417] [17592186100828 #edb/ref 1038 #edb/ref 17592186241067 #edb/ref 17592186045417] [17592186100828 #edb/ref 1038 #edb/ref 17592186241069 #edb/ref 17592186045417] [17592186100828 #edb/ref 1038 #edb/ref 17592186315099 #edb/ref 17592186045417] [17592186100828 #edb/ref 1038 #edb/ref 17592186315104 #edb/ref 17592186045417] [17592186100828 #edb/ref 1038 #edb/ref 17592186329945 #edb/ref 1759218