#{[{:db/id #edb/ref 17592186054520 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054609 :knowledge-point/id #uuid "add45606-39f6-5a61-9535-867d2950d183" :knowledge-point/title "Using the Constant Factor Rule to Integrate a Power Function"}] :question/id #uuid "578a205e-7879-5f8e-b7b5-a91a134ec5b3" :question/math-academy-id "e-369" :question/problem "Calculate $\\displaystyle \\int \\dfrac{2}{3} x \\,\\textrm d x$." :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\n\\int\\frac{2}{3}xdx &= \\frac{2}{3}\\intxdx \\\\\n&= \\frac{2}{3}(\\frac{x^{1 + 1}}{1 + 1}) + C \\\\\n&= \\frac{2}{3} \\cdot \\frac{x^{2}}{2} + C \\\\\n&= \\frac{1}{3}x^{2} + C\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054521 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054610 :knowledge-point/id #uuid "078c9361-898f-5b9f-889e-c92442f882d9" :knowledge-point/title "Using the Constant Factor Rule to Integrate a Constant Function"}] :question/id #uuid "24fd4536-65aa-5a8f-bb84-9134f26bc125" :question/math-academy-id "e-370" :question/problem "Calculate $\\displaystyle \\int 6 \\,\\textrm d x$." :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\n\\int6dx &= 6\\int1dx \\\\\n&= 6\\intx^{0}dx \\\\\n&= 6 \\cdot \\frac{x^{0 + 1}}{0 + 1} + C \\\\\n&= 6 \\cdot x + C \\\\\n&= 6x + C\n\\end{aligned}\n$$\n\nIn general, we can see that for any constant $k$, we have\n\n$$\n\\displaystyle \\int k \\,\\textrm d x = kx + C\n$$"}] [{:db/id #edb/ref 17592186234301 :knowledge-point/_questions [{:db/id #edb/ref 17592186054609 :knowledge-point/id #uuid "add45606-39f6-5a61-9535-867d2950d183" :knowledge-point/title "Using the Constant Factor Rule to Integrate a Power Function"}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "70a9bc2f-279b-5686-8f3f-46799ea34fe9" :question/math-academy-id "q-71163" :question/problem "Calculate $\\int \\frac{1}{2{y}^{5}}\\,\\text{d}y.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{2{y}^{5}}\\,\\text{d}y & =\\frac{1}{2}\\int {y}^{-5}\\,\\text{d}y \\\\  & =\\frac{1}{2}\\cdot (\\frac{{y}^{-5+1}}{-5+1})+C \\\\  & =\\frac{1}{2}\\cdot (\\frac{{y}^{-4}}{-4})+C \\\\  & =-\\frac{1}{8}\\cdot {y}^{-4}+C \\\\  & =-\\frac{1}{8{y}^{4}}+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338916 :knowledge-point/_questions [{:db/id #edb/ref 17592186054610 :knowledge-point/id #uuid "078c9361-898f-5b9f-889e-c92442f882d9" :knowledge-point/title "Using the Constant Factor Rule to Integrate a Constant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "001e62d1-2a99-51c6-b3b9-39a2871c5529" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{z}^{-1}+C" :db/id #edb/ref 17592186336031} {:answer/id #uuid "1874e218-0874-5b90-bdc6-ab7b613c6f9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3z+C" :db/id #edb/ref 17592186336259} {:answer/id #uuid "1ae0a7ca-e987-5aba-bc01-adb91aeac93b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{z}^{2}}{3}+C" :db/id #edb/ref 17592186336281} {:answer/id #uuid "562b965c-f706-514e-9f20-9ee8390b2df6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{z}^{2}+C" :db/id #edb/ref 17592186336824} {:answer/id #uuid "d0aec59b-6cf9-51e2-b8d9-9c87607474e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}z+C" :db/id #edb/ref 17592186337857}] :answer-field/correct {:answer/id #uuid "d0aec59b-6cf9-51e2-b8d9-9c87607474e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}z+C" :db/id #edb/ref 17592186337857} :answer-field/id #uuid "2351ac24-2a18-599f-b9d7-4aa29d6a7379" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338346}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2c311973-a22e-5771-b6f9-49c886b04156" :question/math-academy-id "q-71215" :question/problem "Calculate $\\int \\frac{1}{3}\\,\\text{d}z.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int \\frac{1}{3}\\,\\text{d}z & =\\frac{1}{3}\\int 1\\,\\text{d}z \\\\  & =\\frac{1}{3}\\int {z}^{0}\\,\\text{d}z \\\\  & =\\frac{1}{3}\\cdot \\frac{{z}^{0+1}}{0+1}+C \\\\  & =\\frac{1}{3}\\cdot z+C \\\\  & =\\frac{1}{3}z+C\\end{aligned}\n$$\n\nIn general, we can see that for any constant $k,$ we have $\\int k\\,\\text{d}x=kx+C.$"}]}
