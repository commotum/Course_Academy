tions [{:db/id #edb/ref 17592186054609 :knowledge-point/id #uuid "add45606-39f6-5a61-9535-867d2950d183" :knowledge-point/title "Using the Constant Factor Rule to Integrate a Power Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23b23d50-ec7e-5283-bb24-57bc04c38817" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3{y}^{5}}+C" :db/id #edb/ref 17592186516178} {:answer/id #uuid "590fc5e9-5d00-592b-afac-117c353a8649" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{y}^{5}+C" :db/id #edb/ref 17592186516301} {:answer/id #uuid "5c964151-5623-5fdc-9ce7-4cfbdba1065e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8}{{y}^{3}}+C" :db/id #edb/ref 17592186516309} {:answer/id #uuid "6bff873d-db16-58c6-828d-9d04047ad325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2{y}^{4}}+C" :db/id #edb/ref 17592186516348} {:answer/id #uuid "9efc680f-55f3-555d-96a2-ae3ddb7269d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{8{y}^{4}}+C" :db/id #edb/ref 17592186516436}] :answer-field/correct {:answer/id #uuid "9efc680f-55f3-555d-96a2-ae3ddb7269d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{8{y}^{4}}+C" :db/id #edb/ref 17592186516436} :answer-field/id #uuid "8b2dd282-7c66-5a9f-93bd-d3e9bb5a8ef8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516717}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "70a9bc2f-279b-5686-8f3f-46799ea34fe9" :question/math-academy-id "q-71163" :question/problem "Calculate $\\int \\frac{1}{2{y}^{5}}\\,\\text{d}y.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{2{y}^{5}}\\,\\text{d}y & =\\frac{1}{2}\\int {y}^{-5}\\,\\text{d}y \\\\  & =\\frac{1}{2}\\cdot (\\frac{{y}^{-5+1}}{-5+1})+C \\\\  & =\\frac{1}{2}\\cdot (\\frac{{y}^{-4}}{-4})+C \\\\  & =-\\frac{1}{8}\\cdot {y}^{-4}+C \\\\  & =-\\frac{1}{8{y}^{4}}+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186516872 :knowledge-point/_questions [{:db/id #edb/ref 17592186054610 :knowledge-point/id #uuid "078c9361-898f-5b9f-889e-c92442f882d9" :knowledge-point/title "Using the Constant Factor Rule to Integrate a Constant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "018a5852-2b19-5946-a5b1-21699845a15e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+C" :db/id #edb/ref 17592186516115} {:answer/id #uuid "03efb655-847a-5bcb-957d-58c75c12c43d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{\\sqrt{2}}+C" :db/id #edb/ref 17592186516121} {:answer/id #uuid "b61f7c74-a68c-57f9-a458-5c56d1c4158f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}x+C" :db/id #edb/ref 17592186516492} {:answer/id #uuid "baa6b3d3-506a-5dae-b764-a83e73f9e8f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}{x}^{2}+C" :db/id #edb/ref 17592186516504} {:answer/id #uuid "e38f07bf-781f-5e6f-94e6-5baf1c776460" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{x}+C" :db/id #edb/ref 17592186516588}] :answer-field/correct {:answer/id #uuid "b61f7c74-a68c-57f9-a458-5c56d1c4158f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}x+C" :db/id #edb/ref 17592186516492} :answer-field/id #uuid "50f1b673-19f5-5164-922c-b2dc053f239a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516680}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ff9e2022-4a53-5fe0-872f-a1ba9a04eeb7" :question/math-academy-id "q-71211" :question/problem "Calculate $\\int \\sqrt{2}\\,\\text{d}x.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int \\sqrt{2}\\,\\text{d}x & =\\sqrt{2}\\int 1\\,\\text{d}x \\\\  & =\\sqrt{2}\\int {x}^{0}\\,\\text{d}x \\\\  & =\\sqrt{2}\\cdot \\frac{{x}^{0+1}}{0+1}+C \\\\  & =\\sqrt{2}\\cdot x+C \\\\  & =\\sqrt{2}x+C\\end{aligned}\n$$\n\nIn general, we can see that for any constant $k,$ we have $\\int k\\,\\text{d}x=kx+C.$"}] [{:db/id #edb/ref 17592186338916 :knowledge-point/_questions [{:db/id #edb/ref 17592186054610 :knowledge-point/id #uuid "078c9361-898f-5b9f-889e-c92442f882d9" :knowledge-point/title "Using the Constant Factor Rule to Integrate a Constant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "001e62d1-2a99-51c6-b3b9-39a2871c5529" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{z}^{-1}+C" :db/id #edb/ref 17592186336031} {:answer/id #uuid "1874e218-0874-5b90-bdc6-ab7b613c6f9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3z+C" :db/id #edb/ref 17592186336259} {:answer/id #uuid "1ae0a7ca-e987-5aba-bc01-adb91aeac93b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{z}^{2}}{3}+C" :db/id #edb/ref 17592186336281} {:answer/id #uuid "562b965c-f706-514e-9f20-9ee8390b2df6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{z}^{2}+C" :db/id #edb/ref 17592186336824} {:answer/id #uuid "d0aec59b-6cf9-51e2-b8d9-9c87607474e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}z+C" :db/id #edb/ref 17592186337857}] :answer-field/correct {:answer/id #uuid "d0aec59b-6cf9-51e2-b8d9-9c87607474e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}z+C" :db/id #edb/ref 17592186337857} :answer-field/id #uuid "2351ac24-2a18-599f-b9d7-4aa29d6a7379" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338346}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2c311973-a22e-5771-b6f9-49c886b04156" :question/math-academy-id "q-71215" :question/problem "Calculate $\\int \\frac{1}{3}\\,\\text{d}z.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int \\frac{1}{3}\\,\\text{d}z & =\\frac{1}{3}\\int 1\\,\\text{d}z \\\\  & =\\frac{1}{3}\\int {z}^{0}\\,\\text{d}z \\\\  & =\\frac{1}{3}\\cdot \\frac{{z}^{0+1}}{0+1}+C \\\\  & =\\frac{1}{3}\\cdot z+C \\\\  & =\\frac{1}{3}z+C\\end{aligned}\n$$\n\nIn general, we can see that for any constant $k,$ we have $\\int k\\,\\text{d}x=kx+C.$"}]}
