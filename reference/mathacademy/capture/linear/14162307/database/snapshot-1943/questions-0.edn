#{[{:db/id #edb/ref 17592186068489 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068709 :knowledge-point/id #uuid "2c402c36-0eaa-5281-a7b3-051a3f65e3f9" :knowledge-point/title "Solving One-Step Absolute Value Equations"}] :question/id #uuid "b5ef1eb1-4603-5d02-8478-94e8de89ad85" :question/math-academy-id "e-14216" :question/problem "Solve the equation $\\left\\vert 7x \\right\\vert = 21$." :question/worked-solution "Either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nSo, we set up the two corresponding equations and solve them independently:\n\n- If $\\mid 7x \\mid = 7x$, we obtain:\n$\\mid 7x \\mid |= 21; 7x|= 21; \\frac{7x}{7}|= \\frac{21}{7}; x|= 3$\n- If $\\mid 7x \\mid = -7x$, we obtain:\n$\\mid 7x \\mid |= 21; - 7x|= 21; \\frac{-7x}{-7}|= \\frac{21}{-7}; x|=-3$\n\nTherefore, the solutions are $x=3$ and $x=-3$. We can write this more compactly as $x = \\pm 3$."}] [{:db/id #edb/ref 17592186068490 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068710 :knowledge-point/id #uuid "3ee2e348-0af1-5e7d-a4b4-f3450ee9c19f" :knowledge-point/title "Solving Two-Step Absolute Value Equations"}] :question/id #uuid "9dd0ea37-1775-577e-9e48-d82a50b28963" :question/math-academy-id "e-14221" :question/problem "Solve the equation $\\mid 2x+9 \\mid = 15$." :question/worked-solution "Either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nSo, we set up the two corresponding equations and solve them independently:\n\n- If $\\mid 2x+9 \\mid = 2x+9$, we obtain:\n$\\mid 2x + 9 \\mid |= 15; 2x + 9|= 15; 2x|= 6; \\frac{2x}{2}|= \\frac{6}{2}; x|= 3$\n- If $\\mid 2x+9 \\mid = -(2x+9)$, we obtain:\n$\\mid 2x + 9 \\mid |= 15; - (2x + 9)|= 15; - 2x - 9|= 15; - 2x|= 24; \\frac{-2x}{-2}|= \\frac{24}{-2}; x|=-12$\n\nTherefore, the solutions are $x=-12$ and $x=3$."}] [{:db/id #edb/ref 17592186068492 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068711 :knowledge-point/id #uuid "61dbfea6-68e8-56b0-aae1-a48fdd8839b1" :knowledge-point/title "Solving Absolute Value Equations With Negative Variable Coefficients"}] :question/id #uuid "9aa175ae-420f-5bef-855b-4f0aadbac062" :question/math-academy-id "e-14225" :question/problem "Solve the equation $\\mid 5-8y \\mid = 11$." :question/worked-solution "Either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nSo, we set up the two corresponding equations and solve them independently:\n\n- If $\\mid 5-8y \\mid = 5-8y$, we obtain:\n$\\mid 5 - 8y \\mid |= 11; 5 - 8y|= 11; - 8y|= 6; \\frac{-8y}{-8}|= \\frac{6}{-8}; y|=-\\frac{3}{4}$\n- If $\\mid 5-8y \\mid = -(5-8y)$, we obtain:\n$\\mid 5 - 8y \\mid |= 11; - (5 - 8y)|= 11; - 5 + 8y|= 11; 8y|= 16; \\frac{8y}{8}|= \\frac{16}{8}; y|= 2$\n\nTherefore, the solutions are\n\n$$\ny=-\\dfrac34\n$$\n\nand $y=2$."}] [{:db/id #edb/ref 17592186068494 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068712 :knowledge-point/id #uuid "3ede7f82-5453-553b-b58e-31d7d9452336" :knowledge-point/title "Solving Two-Step Absolute Value Equations Containing Fractions"}] :question/id #uuid "094b2695-32c7-55dd-b3e1-27afcd3a09c1" :question/math-academy-id "e-14229" :question/problem "Solve the equation $\\left| \\dfrac{7}{2}z-2 \\right| = 3$." :question/worked-solution "Either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nSo, we set up the two corresponding equations and solve them independently:\n\n- If $\\left| \\dfrac{7}{2}z-2 \\right| = \\dfrac{7}{2}z-2$, we obtain:\n$\\mid \\frac{7}{2}z - 2 \\mid |= 3; \\frac{7}{2}z - 2|= 3; \\frac{7}{2}z|= 5$\nMultiplying both sides of the equation by $\\dfrac{2}{7}$ gives\n$\\frac{7}{2}z|= 5; (\\frac{2}{7}) \\cdot (\\frac{7}{2}z)|= (\\frac{2}{7}) \\cdot (5); (\\frac{2}{7}) \\cdot (\\frac{7}{2}z)|= \\frac{10}{7}; z|= \\frac{10}{7}$.\n- If $\\left| \\dfrac{7}{2}z-2 \\right| = -\\left(\\dfrac{7}{2}z-2\\right)$, we obtain:\n$\\mid \\frac{7}{2}z - 2 \\mid |= 3; - (\\frac{7}{2}z - 2)|= 3; - \\frac{7}{2}z + 2|= 3; - \\frac{7}{2}z|= 1$\nMultiplying both sides of the equation by $-\\dfrac{2}{7}$ gives\n$-\\frac{7}{2}z|= 1; (-\\frac{2}{7}) \\cdot (-\\frac{7}{2}z)|= (-\\frac{2}{7}) \\cdot (1); (-\\frac{2}{7}) \\cdot (-\\frac{7}{2}z)|=-\\frac{2}{7}; z|=-\\frac{2}{7}$.\n\nTherefore, the solutions are\n\n$$\nz = -\\dfrac{2}{7}\n$$\n\nand\n\n$$\nz = \\dfrac{10}{7}\n$$"}] [{:db/id #edb/ref 17592186069121 :knowledge-point/_questions [{:db/id #edb/ref 17592186068711 :knowledge-point/id #uuid "61dbfea6-68e8-56b0-aae1-a48fdd8839b1" :knowledge-point/title "Solving Absolute Value Equations With Negative Variable Coefficients"}] :question/answer-fields [{:answer-field/id #uuid "4ca50951-6a1a-53d5-855c-2e3db087646e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186066121} {:answer-field/id #uuid "5086dfc5-6071-577f-ba38-5ff1ad7efb54" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186066122}] :question/id #uuid "6bab2d23-9d8f-5537-a75e-f4e0618915a2" :question/math-academy-id "q-212364" :question/problem "Written in **ascending order**, the solutions to $\\mid 2 - k|= 9$ are $k =$ {{field-1}} and $k =$\n{{field-2}}."}]}
