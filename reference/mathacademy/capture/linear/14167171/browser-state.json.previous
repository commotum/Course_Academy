    "q-69014": {
      "dom_id": "step-q69014",
      "name": "Question 2",
      "problem": "Farhan can buy $2$ slices of pizza for a dollar. If he has $14$ dollars, then how many slices of pizza can he buy?",
      "worked_solution": "The unit rate is $2$ slices per dollar. To find the number of slices Farhan can buy for $14$ dollars, we multiply the unit rate by $14$ dollars and get\n\n$$\n2\\times 14=28.\n$$\n\nTherefore, Farhan can buy $28$ slices for $14$ dollars.",
      "calculator_instructions": "",
