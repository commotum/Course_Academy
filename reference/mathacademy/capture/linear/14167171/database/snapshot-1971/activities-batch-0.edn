e-point/questions [{:db/id #edb/ref 17592186074495} {:db/id #edb/ref 17592186074506}] :knowledge-point/title "Problem Solving Using the Ratio of Two Fractions"} :step/id #uuid "347b63ef-9c0b-5688-8e27-d7df776461a0" :step/math-academy-id 17331} {:db/id #edb/ref 17592186074629 :step/content {:db/id #edb/ref 17592186075005 :tutorial/content "Unit rates can be used to solve many real-world problems in which we are given two quantities and wish to find what happens to one quantity when we vary the other.\n\nFor example, we might know the total cost of a specific number of items and be asked to find the cost for a different number of the same item.\n\nTo solve a problem using unit rates, the first step is to compute the unit rate by dividing the two given quantities. Then, we can use the unit rate to calculate the desired quantity.\n\nLet's see some examples!" :tutorial/id #uuid "fc623ecb-782c-5182-90e7-e8b6720b2780" :tutorial/math-academy-id 3313 :tutorial/title "Introduction"} :step/id #uuid "7987d98c-69c0-57a6-b100-cd3d9e53820b" :step/math-academy-id 18413 :step/next {:db/id #edb/ref 17592186074616}}] :activity/title "Solving Problems Using Unit Rates" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073976}]}
