swer/id #uuid "5e816e39-d02c-5db5-bb2d-047453d59b2b" :answer/type :answer.type/math :answer/value "3a-b" :db/ensure [:answer/validate]} {:db/id "answer-fc2716f5-2b1d-5514-a35d-147757e3e939" :answer/id #uuid "fc2716f5-2b1d-5514-a35d-147757e3e939" :answer/type :answer.type/math :answer/value "3b" :db/ensure [:answer/validate]} {:db/id "answer-a5fa73f6-4a68-5c06-b024-6dc3081af760" :answer/id #uuid "a5fa73f6-4a68-5c06-b024-6dc3081af760" :answer/type :answer.type/math :answer/value "b" :db/ensure [:answer/validate]} {:db/id "question-7905141b-131b-5e75-9f8a-02832316e158" :question/id #uuid "7905141b-131b-5e75-9f8a-02832316e158" :question/math-academy-id "q-178261" :question/problem "$2x+4y+5x-2y-4=${{field-1}}\n$x\\,+$\n{{field-2}}\n$y\\,-$\n{{field-3}}" :question/worked-solution "First, we group the like terms.\n\n$$\n\\begin{aligned}2x+4y+5x-2y-4 & = \\\\ {{2x+5x}_{⏟}}_{x\\text{ terms}}+{{4y-2y}_{⏟}}_{y\\text{ terms}}-4 & \\end{aligned}\n$$\n\nThen, we combine the like terms:\n\n$$\n\\begin{aligned}{2x+5x}_{⏟}\\,+\\,{4y-2y}_{⏟}\\,-\\,4 & = \\\\ (2+5)x+(4-2)y-4 & = \\\\ 7\\,x+2\\,y-4 & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d1e2f42c-3c82-55ed-9f00-993769813d0d" "answer-field-6f9efb7c-58a6-5777-ab43-e926be9df661" "answer-field-62a0af8f-8e02-5c6b-a1a7-8d23d275c577"] :db/ensure [:question/validate]} {:db/id "answer-field-d1e2f42c-3c82-55ed-9f00-993769813d0d" :answer-field/id #uuid "d1e2f42c-3c82-55ed-9f00-993769813d0d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e0586283-fcd6-5baf-8084-46357138e444" :answer-field/choices ["answer-e0586283-fcd6-5baf-8084-46357138e444"] :db/ensure [:answer-field/validate]} {:db/id "answer-e0586283-fcd6-5baf-8084-46357138e444" :answer/id #uuid "e0586283-fcd6-5baf-8084-46357138e444" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-field-6f9efb7c-58a6-5777-ab43-e926be9df661" :answer-field/id #uuid "6f9efb7c-58a6-5777-ab43-e926be9df661" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b8b32b6f-8de9-5ca4-ad9b-1ec1a629ac7c" :answer-field/choices ["answer-b8b32b6f-8de9-5ca4-ad9b-1ec1a629ac7c"] :db/ensure [:answer-field/validate]} {:db/id "answer-b8b32b6f-8de9-5ca4-ad9b-1ec1a629ac7c" :answer/id #uuid "b8b32b6f-8de9-5ca4-ad9b-1ec1a629ac7c" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-field-62a0af8f-8e02-5c6b-a1a7-8d23d275c577" :answer-field/id #uuid "62a0af8f-8e02-5c6b-a1a7-8d23d275c577" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9a80ec14-c5c5-55c2-80b1-e3b7562ca1d3" :answer-field/choices ["answer-9a80ec14-c5c5-55c2-80b1-e3b7562ca1d3"] :db/ensure [:answer-field/validate]} {:db/id "answer-9a80ec14-c5c5-55c2-80b1-e3b7562ca1d3" :answer/id #uuid "9a80ec14-c5c5-55c2-80b1-e3b7562ca1d3" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186056007 :tutorial/content "Remember that two terms are called **like terms** if they have the same variable part. \n\nAn expression with different terms can often be simplified by **collecting like terms**.\n\nFor example, consider the following expression:\n\n$$\n2x+3x\n$$\n\nThe terms $2x$ and $3x$ are like terms because they both have a variable part of $x.$\n\nWhenever we have two or more like terms in an expression, we can combine them into a single term. Here, we can combine the like terms $2x$ and $3x$ into a single term by adding their coefficients:\n\n$$\n\\begin{aligned}2x+3x & = \\\\ (2+3)x & = \\\\ 5x & \\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186054884 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
