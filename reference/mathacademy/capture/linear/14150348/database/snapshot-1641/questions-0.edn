#{[{:db/id #edb/ref 17592186054374 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054788 :knowledge-point/id #uuid "6e3d5ce2-c3a5-5787-88f6-a76b223ece1e" :knowledge-point/title "Simplifying Expressions With Two or Three Terms"}] :question/id #uuid "15e9a793-27b4-5345-bbbf-fdea0fab9b9b" :question/math-academy-id "e-12795" :question/problem "Simplify the expression $2 + 7p - 3p$." :question/worked-solution "We have two like terms, $7p$ and $-3p$.\n\nTo collect these like terms, we combine them into a single term, adding their coefficients:\n\n$$\n\\begin{aligned}\n2 + 7p - 3p &=  \\\\\n2 + (7 - 3)p &=  \\\\\n&= 2 + 4p\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054375 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054789 :knowledge-point/id #uuid "eb8ce725-4a41-544c-b705-743a7ef9635d" :knowledge-point/title "Simplifying Expressions With Four Terms"}] :question/id #uuid "2da17fa4-3fb1-50b9-a317-47c38107ff60" :question/math-academy-id "e-12796" :question/problem "Simplify the expression $5k - 3k + 2k - t$." :question/worked-solution "We have three like terms, $5k, -3k$, and $2k$.\n\nTo collect these like terms, we combine them into a single term, adding their coefficients:\n\n$$\n\\begin{aligned}\n5k - 3k + 2k - t &=  \\\\\n(5 - 3 + 2)k - t &=  \\\\\n&= 4k - t\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054376 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054790 :knowledge-point/id #uuid "342e8283-f3a1-5923-8788-1a489ae058c5" :knowledge-point/title "Rearranging an Expression Before Collecting Like Terms"}] :question/id #uuid "d902668d-ffe0-53bb-a360-2e4e472404f0" :question/math-academy-id "e-12797" :question/problem "Simplify the expression $6a+1-2a$." :question/worked-solution "We rearrange the terms so that the like terms, $6a$ and $-2a$, are together.\n\n$$\n\\begin{aligned} 6a+1-2a \\\\[5pt] &= \\underbrace{6a-2a}_{a \\textrm{terms}}+ 1 & \\end{aligned}\n$$\n\nThen, we combine the like terms:\n\n$$\n\\begin{aligned} \\underbrace{6a-2a}+ 1 \\\\[5pt] &= (6-2)a + 1 \\\\[5pt] &= 4a + 1& \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054377 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054791 :knowledge-point/id #uuid "d7162d23-7674-5319-9f00-ca1a37ecccd3" :knowledge-point/title "Collecting Groups of Like Terms"}] :question/id #uuid "c6e112dd-4c10-5ce6-87a9-6066a366dd33" :question/math-academy-id "e-12798" :question/problem "Simplify the expression $2.5x+2y-x+1.5y$." :question/worked-solution "First, we group the like terms.\n\n$$\n\\begin{aligned} 2.5x+2y-x+1.5y \\\\[5pt] &= \\underbrace{2.5x-x}_{x \\textrm{terms}}+\\underbrace{2y+1.5y}_{y \\textrm{terms}} & \\end{aligned}\n$$\n\nThen, we combine the like terms:\n\n$$\n\\begin{aligned} \\underbrace{2.5x-x}+\\underbrace{2y+1.5y} \\\\[5pt] &= (2.5-1)x + (2+1.5)y \\\\[5pt] &= 1.5x + 3.5y \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186055381 :knowledge-point/_questions [{:db/id #edb/ref 17592186054790 :knowledge-point/id #uuid "342e8283-f3a1-5923-8788-1a489ae058c5" :knowledge-point/title "Rearranging an Expression Before Collecting Like Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "993d8a23-a562-5d21-abca-7be7b7012a99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11x + 5y + 1" :db/id #edb/ref 17592186053524} {:answer/id #uuid "b658da9a-067f-5bd8-9373-2dfdbf4f73e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18x + 2y - 1" :db/id #edb/ref 17592186053525} {:answer/id #uuid "c1b1d306-0065-5976-b54d-914535bfadec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8x - 2y + 1" :db/id #edb/ref 17592186053526} {:answer/id #uuid "138c858a-d97b-5484-b54a-f9a9d7d76ae7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18x - 2y + 1" :db/id #edb/ref 17592186053527} {:answer/id #uuid "6a2f8f22-4ece-55d2-96ae-ff843ae8ab22" :answer/ty