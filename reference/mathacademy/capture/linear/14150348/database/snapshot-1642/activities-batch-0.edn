#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055808} :activity/id #uuid "72b6726f-b68f-5ab6-9c1f-8455335fd490" :activity/scope {:db/id #edb/ref 17592186050452 :topic/id #uuid "4a33a1d4-8dfa-5e25-8ed4-4aa1496ac8a1" :topic/math-academy-id 134} :activity/steps [{:db/id #edb/ref 17592186055808 :step/content {:db/id #edb/ref 17592186056007 :tutorial/content "Remember that two terms are called **like terms** if they have the same variable part. \n\nAn expression with different terms can often be simplified by **collecting like terms**.\n\nFor example, consider the following expression:\n\n$$\n2x+3x\n$$\n\nThe terms $2x$ and $3x$ are like terms because they both have a variable part of $x.$\n\nWhenever we have two or more like terms in an expression, we can combine them into a single term. Here, we can combine the like terms $2x$ and $3x$ into a single term by adding their coefficients:\n\n$$\n\\begin{aligned}2x+3x & = \\\\ (2+3)x & = \\\\ 5x & \\end{aligned}\n$$" :tutorial/id #uuid "bf438600-1106-5d9f-b7c3-6c7c18d3bb77" :tutorial/math-academy-id 8021 :tutorial/title "Introduction"} :step/id #uuid "be184f2e-07fc-5e2d-8b00-c1117788f171" :step/math-academy-id 53080 :step/next {:db/id #edb/ref 17592186055809}} {:db/id #edb/ref 17592186055809 :step/content {:db/id #edb/ref 17592186054788 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054374 :question/id #uuid "15e9a793-27b4-5345-bbbf-fdea0fab9b9b" :question/math-academy-id "e-12795"} :knowledge-point/id #uuid "6e3d5ce2-c3a5-5787-88f6-a76b223ece1e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048546} {:db/id #edb/ref 17592186048549} {:db/id #edb/ref 17592186048911} {:db/id #edb/ref 17592186049264}] :knowledge-point/questions [{:db/id #edb/ref 17592186055026} {:db/id #edb/ref 17592186055218} {:db/id #edb/ref 17592186055394} {:db/id #edb/ref 17592186445530} {:db/id #edb/ref 17592186445536}] :knowledge-point/title "Simplifying Expressions With Two or Three Terms"} 