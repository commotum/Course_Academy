#{[{:db/id #edb/ref 17592186054374 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054788 :knowledge-point/id #uuid "6e3d5ce2-c3a5-5787-88f6-a76b223ece1e" :knowledge-point/title "Simplifying Expressions With Two or Three Terms"}] :question/id #uuid "15e9a793-27b4-5345-bbbf-fdea0fab9b9b" :question/math-academy-id "e-12795" :question/problem "Simplify the expression $2 + 7p - 3p.$" :question/worked-solution "We have two like terms, $7p$ and $-3p.$ \n\nTo collect these like terms, we combine them into a single term, adding their coefficients:\n\n$$\n\\begin{aligned}2+7p-3p & = \\\\ 2+(7-3)p & = \\\\ 2+4p & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054375 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054789 :knowledge-point/id #uuid "eb8ce725-4a41-544c-b705-743a7ef9635d" :knowledge-point/title "Simplifying Expressions With Four Terms"}] :question/id #uuid "2da17fa4-3fb1-50b9-a317-47c38107ff60" :question/math-academy-id "e-12796" :question/problem "Simplify the expression $5k - 3k + 2k - t.$" :question/worked-solution "We have three like terms, $5k, -3k,$ and $2k.$ \n\nTo collect these like terms, we combine them into a single term, adding their coefficients:\n\n$$\n\\begin{aligned}5k-3k+2k-t & = \\\\ (5-3+2)k-t & = \\\\ 4k-t\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054376 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054790 :knowledge-point/id #uuid "342e8283-f3a1-5923-8788-1a489ae058c5" :knowledge-point/title "Rearranging an Expression Before Collecting Like Terms"}] :question/id #uuid "d902668d-ffe0-53bb-a360-2e4e472404f0" :question/math-academy-id "e-12797" :question/problem "Simplify the expression $6a+1-2a.$" :question/worked-solution "We rearrange the terms so that the like terms, $6a$ and $-2a$, are together.\n\n$$\n\\eqalign{\n\t\t6a+1-2a &= \\[5pt]\n\t\t\\underbrace{6a-2a}_{a \\textrm{ terms}}+ 1\t&\n\t}\n$$\n\nThen, we combine the like terms: \n\n$$\n\\eqalign{\n\t\t\\underbrace{6a-2a}+ 1 &= \\[5pt]\n\t\t(6-2)a + 1 &=\\[5pt]\n\t\t4a + 1&\t\t\n\t}\n$$"}] [{:db/id #edb/ref 17592186054377 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054791 :knowledge-point/id #uuid "d7162d23-7674-5319-9f00-ca1a37ecccd3" :knowledge-point/title "Collecting Groups of Like Terms"}] :question/id #uuid "c6e112dd-4c10-5ce6-87a9-6066a366dd33" :question/math-academy-id "e-12798" :question/problem "Simplify the expression $2.5x+2y-x+1.5y.$" :question/worked-solution "First, we group the like terms.\n\n$$\n\\eqalign{\n\t\t2.5x+2y-x+1.5y &= \\[5pt]\n\t\t\\underbrace{2.5x-x}_{x \\textrm{ terms}}+\\underbrace{2y+1.5y}_{y \\textrm{ terms}} &\n\t}\n$$\n\nThen, we combine the like terms:\n\n$$\n\\eqalign{\n\t\t\\underbrace{2.5x-x}+\\underbrace{2y+1.5y} &= \\[5pt]\n\t\t(2.5-1)x + (2+1.5)y &=\\[5pt]\n\t\t1.5x + 3.5y\n\t}\n$$"}] [{:db/id #edb/ref 17592186445530 :knowledge-point/_questions [{:db/id #edb/ref 17592186054788 :knowledge-point/id #uuid "6e3d5ce2-c3a5-5787-88f6-a76b223ece1e" :knowledge-point/title "Simplifying Expressions With Two or Three Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10dd85ba-9c4c-57de-aad3-2bc052a18ad4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9+z" :db/id #edb/ref 17592186445490} {:answer/id #uuid "167d49d5-645c-5ad0-acaf-802868f0f742" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9+2z" :db/id #edb/ref 17592186445491} {:answer/id #uuid "4c0edbc4-5f37-5041-919d-af11c78cf784" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14z" :db/id #edb/ref 17592186445498} {:answer/id #uuid "9ef3cbfb-26e2-5eff-817f-5ab1a49914ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9z" :db/id #edb/ref 17592186445509} {:answer/id #uuid "be348b6b-98a4-5a70-bf00-f018d685e1dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+9z" :db/id #edb/r