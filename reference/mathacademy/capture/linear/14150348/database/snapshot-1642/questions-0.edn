ent :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186445489}] :answer-field/correct {:answer/id #uuid "03020098-2f04-5972-97b6-5ee20b95ec3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186445489} :answer-field/id #uuid "c581f3b2-e175-5b06-baa8-94ffb33fd775" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186445528}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "77366c00-a15b-5f37-b0cb-471f787df0a0" :question/math-academy-id "q-173710" :question/problem "$8a+3b+11a=${{field-1}}\n$a\\,+$\n{{field-2}}\n$b$" :question/worked-solution "We rearrange the terms so that the like terms, $8a$ and $11a$, are together.\n\n$$\n\\begin{aligned}8a+3b+11a & = \\\\ {{8a+11a}_{⏟}}_{a\\text{ terms}}+3b & \\end{aligned}\n$$\n\nThen, we combine the like terms:\n\n$$\n\\begin{aligned}{8a+11a}_{⏟}\\,+\\,3b & = \\\\ (8+11)a+3b & = \\\\ 19\\,a+3\\,b\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186445536 :knowledge-point/_questions [{:db/id #edb/ref 17592186054788 :knowledge-point/id #uuid "6e3d5ce2-c3a5-5787-88f6-a76b223ece1e" :knowledge-point/title "Simplifying Expressions With Two or Three Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92345622-6263-5748-af9a-6054ca162c61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186445507}] :answer-field/correct {:answer/id #uuid "92345622-6263-5748-af9a-6054ca162c61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186445507} :answer-field/id #uuid "4b0ee871-33d8-52d3-b926-0805e9aec8f4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186445518} {:answer-field/choices [{:answer/id #uuid "69fa5f8c-2e43-5681-b75a-c2c34d4e1e7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186445502}] :answer-field/correct {:answer/id #uuid "69fa5f8c-2e43-5681-b75a-c2c34d4e1e7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186445502} :answer-field/id #uuid "8d93596e-85d1-5232-a7ce-d3bb08003b35" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186445523}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "99943b2d-800d-508e-b6fa-b967f1e637ef" :question/math-academy-id "q-178228" :question/problem "$2x+7x+2z=${{field-1}}\n$x\\,+$\n{{field-2}}$z$" :question/worked-solution "We have two like terms, $2x$ and $7x.$ \n\nTo collect these like terms, we combine them into a single term, adding their coefficients:\n\n$$\n\\begin{aligned}2x+7x+2z & = \\\\ (2x+7x)+2z & = \\\\ (2+7)x+2z & = \\\\ 9\\,x+2\\,z\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186445531 :knowledge-point/_questions [{:db/id #edb/ref 17592186054789 :knowledge-point/id #uuid "eb8ce725-4a41-544c-b705-743a7ef9635d" :knowledge-point/title "Simplifying Expressions With Four Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f04544b-e1a8-5faf-acd7-6c230b8c3ba1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186445492}] :answer-field/correct {:answer/id #uuid "1f04544b-e1a8-5faf-acd7-6c230b8c3ba1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186445492} :answer-field/id #uuid "7820eebd-f6ad-57da-890c-6464dcf42c30" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186445521} {:answer-field/