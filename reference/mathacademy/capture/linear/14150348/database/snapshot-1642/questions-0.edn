f3a1-5923-8788-1a489ae058c5" :knowledge-point/title "Rearranging an Expression Before Collecting Like Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cb076d1-905e-50e2-a396-6f6ef860a604" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18x+2y-1" :db/id #edb/ref 17592186445495} {:answer/id #uuid "53d0bab1-9c5e-56e7-acb5-a6ed89ec296e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13x-2y-1" :db/id #edb/ref 17592186445499} {:answer/id #uuid "81a6251e-ccc5-59a9-b49b-305692f48306" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11x+5y+1" :db/id #edb/ref 17592186445505} {:answer/id #uuid "9204982f-c56c-5cf6-8e73-46bede6e1f21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8x-2y+1" :db/id #edb/ref 17592186445506} {:answer/id #uuid "fd9aa503-96ed-5b4e-86cc-b96db3e214bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18x-2y+1" :db/id #edb/ref 17592186445517}] :answer-field/correct {:answer/id #uuid "fd9aa503-96ed-5b4e-86cc-b96db3e214bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18x-2y+1" :db/id #edb/ref 17592186445517} :answer-field/id #uuid "0524c63d-c5cd-5b8d-80be-75cddeeee83b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186053523}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a35d688d-c263-50c4-b62e-c79c29a24f63" :question/math-academy-id "q-563" :question/problem "$13x-2y+5x+1=$" :question/worked-solution "We rearrange the terms so that the like terms, $13x$ and $5x$, are together.\n\n$$\n\\begin{aligned}13x-2y+5x+1 & = \\\\ {{13x+5x}_{⏟}}_{x\\text{ terms}}-2y+1 & \\end{aligned}\n$$\n\nThen, we combine the like terms:\n\n$$\n\\begin{aligned}{13x+5x}_{⏟}-2y+1 & = \\\\ (13+5)x-2y+1 & = \\\\ 18x-2y+1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186445532 :knowledge-point/_questions [{:db/id #edb/ref 17592186054791 :knowledge-point/id #uuid "d7162d23-7674-5319-9f00-ca1a37ecccd3" :knowledge-point/title "Collecting Groups of Like Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33cba437-e760-5519-bdf4-d21f5c0e761d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3a+b" :db/id #edb/ref 17592186445494} {:answer/id #uuid "5e816e39-d02c-5db5-bb2d-047453d59b2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3a-b" :db/id #edb/ref 17592186445500} {:answer/id #uuid "a5fa73f6-4a68-5c06-b024-6dc3081af760" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b" :db/id #edb/ref 17592186445511} {:answer/id #uuid "ef7757a9-ae0e-5f4b-a0b3-c610d16948b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3a+3b" :db/id #edb/ref 17592186445515} {:answer/id #uuid "fc2716f5-2b1d-5514-a35d-147757e3e939" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3b" :db/id #edb/ref 17592186445516}] :answer-field/correct {:answer/id #uuid "33cba437-e760-5519-bdf4-d21f5c0e761d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3a+b" :db/id #edb/ref 17592186445494} :answer-field/id #uuid "78285ed0-6178-5d34-a498-f63bd57059fe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186445522}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "59eaa740-2224-50f3-a29a-b209a5484302" :question/math-academy-id "q-690" :question/problem "$a+2b+2a-b=$" :question/worked-solution "First, we group the like terms.\n\n$$\n\\begin{aligned}a+2b+2a-b & = \\\\ {{a+2a}_{⏟}}_{a\\text{ terms}}+{{2b-b}_{⏟}}_{b\\text{ terms}} & \\end{aligned}\n$$\n\nThen, we combine the like terms:\n\n$$\n\\begin{aligned}{a+2a}_{⏟}+{2b-b}_{⏟} & = \\\\ (1+2)a+(2-1)b & = \\\\ 3a+b\\end{aligned}\n$$"}]}
