td><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mo stretchy=\"false\">(</mo><mn>8</mn><mo>−</mo><mn>6</mn><mo>+</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mi>t</mi><mo>+</mo><mn>5</mn></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mn>4</mn><mi>t</mi><mo>+</mo><mn>5</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
