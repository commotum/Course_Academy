-aba1-39b367c49961" :question/id #uuid "cf599dd3-905a-52d6-aba1-39b367c49961" :question/math-academy-id "q-10729" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=3{x}^{4}+\\frac{4}{{x}^{3}}+12.$" :question/worked-solution "Here, we apply the addition, constant multiple, and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{4}+\\frac{4}{{x}^{3}}+12) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{4})+\\frac{\\text{d}}{\\text{d}x}(4{x}^{-3})+\\frac{\\text{d}}{\\text{d}x}(12) \\\\  & =3\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{4})+4\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-3})+\\frac{\\text{d}}{\\text{d}x}(12) \\\\  & =3\\cdot 4{x}^{(4-1)}+4\\cdot (-3){x}^{(-3-1)}+0 \\\\  & =12{x}^{3}-12{x}^{-4} \\\\  & =12{x}^{3}-\\frac{12}{{x}^{4}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1947ca64-c378-5eaf-88bb-6fa8b0b04f62"] :db/ensure [:question/validate]} {:db/id "answer-field-1947ca64-c378-5eaf-88bb-6fa8b0b04f62" :answer-field/id #uuid "1947ca64-c378-5eaf-88bb-6fa8b0b04f62" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b4161ec8-df10-5639-aeed-ff5b15276588" :answer-field/choices ["answer-520860b5-7e56-5449-9080-6f8047f872aa" "answer-b4161ec8-df10-5639-aeed-ff5b15276588" "answer-be041e10-bb70-5b3b-afab-6f4cde2c6e92" "answer-b68d1b42-de6c-5986-9971-7281fe560230" "answer-ea78f316-486b-58b6-867b-8ea0fecd9188"] :db/ensure [:answer-field/validate]} {:db/id "answer-520860b5-7e56-5449-9080-6f8047f872aa" :answer/id #uuid "520860b5-7e56-5449-9080-6f8047f872aa" :answer/type :answer.type/math :answer/value "12{x}^{3}+\\frac{12}{{x}^{4}}" :db/ensure [:answer/validate]} {:db/id "answer-b4161ec8-df10-5639-aeed-ff5b15276588" :answer/id #uuid "b4161ec8-df10-5639-aeed-ff5b15276588" :answer/type :answer.type/math :answer/value "12{x}^{3}-\\frac{12}{{x}^{4}}" :db/ensure [:answer/validate]} {:db/id "ans