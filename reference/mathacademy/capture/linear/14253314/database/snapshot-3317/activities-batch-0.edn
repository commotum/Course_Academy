ctivity/scope {:db/id #edb/ref 17592186048932 :topic/id #uuid "cd2e9db4-6727-5887-90bc-20eb0a0bf6d2" :topic/math-academy-id 278} :activity/steps [{:db/id #edb/ref 17592186575651 :step/content {:db/id #edb/ref 17592186059964 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "211bb0e5-3c78-5407-abe6-d36a7702b7f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{x}^{3}-\\frac{2}{{x}^{3}}-1" :db/id #edb/ref 17592186236028} {:answer/id #uuid "2b721848-7e95-5033-9e18-09f6e8945fa2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6{x}^{2}-\\frac{2}{{x}^{3}}-1" :db/id #edb/ref 17592186236090} {:answer/id #uuid "32dca761-7920-51b0-b217-36a70a04fd20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{x}^{2}-\\frac{2}{{x}^{3}}+1" :db/id #edb/ref 17592186236137} {:answer/id #uuid "3f86bddf-d4bf-5ed2-9add-a90b0f3b1200" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{x}^{2}+\\frac{2}{{x}^{3}}-1" :db/id #edb/ref 17592186236222} {:answer/id #uuid "ecf3d45d-887f-583c-a917-8a37435d41c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{x}^{2}-\\frac{2}{{x}^{3}}-1" :db/id #edb/ref 17592186237309}] :answer-field/correct {:db/id #edb/ref 17592186237309} :answer-field/id #uuid "49ccb49d-a87a-5cd3-8422-264f873526ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237535}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "723e7a54-cfc4-55b5-8c13-7066946d5c44" :question/math-academy-id "q-10291" :question/problem "Find ${f}^{′}(x)$ for  $f(x)={x}^{3}+\\frac{1}{{x}^{2}}-x.$" :question/worked-solution "The function $f(x)$ is the sum of three power functions. So, we apply the sum rule, and we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{3}+\\frac{1}{{x}^{2}}-x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{3})+\\frac{\\text{d}}{\\text{d}x}({x}^{-2})-\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =3{x}^{(3-1)}+(-2){x}^{(-2-1)}-1 \\\\  & =3{x}^{2}-2{x}^{-3}-1 \\\\  & =3{x}^{2}-\\frac{2}{{x}^{3}}-1.\\end{aligned}\n$$"} :step/id #uuid "5333d22e-d19f-5ca3-9791-2b97ddb2177c" :step/next {:db/id #edb/ref 17592186575653}} {:db/id #edb/ref 17592186575653 :step/content {:db/id #edb/ref 17592186233095 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "380faa34-ff12-5c2b-985e-2ed10aec2dd0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "75{x}^{14}-32{x}^{7}+35{x}^{5}" :db/id #edb/ref 17592186575044} {:answer/id #uuid "3cbfaf6e-59f5-5d74-890e-469bac68f415" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "75{x}^{13}-32{x}^{7}+35{x}^{4}" :db/id #edb/ref 17592186575053} {:answer/id #uuid "a6d922cf-b1ce-5f45-b313-31d7781464c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "75{x}^{14}-32{x}^{7}+35{x}^{4}" :db/id #edb/ref 17592186575241} {:answer/id #uuid "c75af15b-b930-5b18-8047-458120c58d58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "75{x}^{14}-28{x}^{7}+35{x}^{4}" :db/id #edb/ref 17592186575305} {:answer/id #uuid "da040721-f117-50c1-b07d-e4e1b3b8cb75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "75{x}^{14}-32{x}^{7}-35{x}^{4}" :db/id #edb/ref 17592186575339}] :answer-field/correct {:db/id #edb/ref 17592186575241} :answer-field/id #uuid "67ad5e66-9a6f-510f-88e0-2dbf3a4879dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186575459}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cdbca551-456b-5e41-aaad-94467ddd404f" :question/math-academy-id "q-10726" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=5{x}^{15}-4{x}^{8}+7{x}^{5}.$" :question/worked-solution "Here, we apply the addition, constant multiple, and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5{x}^{15}-4{x}^{8}+7{x}^{5}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(5{x}^{15})-\\frac{\\text{d}}{\\text{d}x}(4{x}^{8})+\\frac{\\text{d}}{\\text{d}x}(7{x}^{5}) \\\\  & =5\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{15})-4\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{8})+7\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{5}) \\\\  & =5\\cdot 15{x}^{(15-1)}-4\\cdot 8{x}^{(8-1)}+7\\cdot 5{x}^{(5-1)} \\\\  & =75{x}^{14}-32{x}^{7}+35{x}^{4}\\end{aligned}\n$$"} :step/id #uuid "5b8cdc22-2e56-51ba-83ba-7a593d15afcf" :step/next {:db/id #edb/ref 17592186575686}} {:db/id #edb/ref 17592186575656 :step/content {:db/id #edb/ref 17592186059975 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0bdd2e1-3e5c-5895-821b-af2114df9466" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}x^{5}" :db/id #edb/ref 17592186056209} {:answer/id #uuid "01b32f77-4c06-52d6-b8c5-91bdb5a4cd1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{35}{x^{7}}" :db/id #edb/ref 17592186056210} {:answer/id #uuid "0da96fbb-b525-5f81-8388-0f0d5087bc77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{35}{x^{8}}" :db/id #edb/ref 17592186056211} {:answer/id #uuid "36537ce3-7e8c-5b6d-b1a3-011009faa445" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{35}{x^{8}}" :db/id #edb/ref 17592186056212} {:answer/id #uuid "4f9d7595-532f-50d8-9d11-c65600f238ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{7}x^{7}" :db/id #edb/ref 17592186056213}] :answer-field/id #uuid "634ff9bf-3193-5f60-af14-91e9255daafa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186056208}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "40fae254-060d-5c2e-9572-fbfbe159f41b" :question/math-academy-id "q-10739" :question/problem "If $y =-\\frac{5}{x^{7}}$, find $\\frac{dy}{dx}$."} :step/id #uuid "61acd48b-c578-5bb4-990a-388bf180a7e0"} {:db/id #edb/ref 17592186575686 :step/content {:db/id #edb/ref 17592186575601 :question/answer-fields [{:answer-field/choices 