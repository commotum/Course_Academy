ed}\n$$"} :step/id #uuid "e6696668-438e-5952-87af-a577069217ea" :step/next {:db/id #edb/ref 17592186575656}}] :activity/title "The Sum and Constant Multiple Rules for Differentiation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186574939}]}
