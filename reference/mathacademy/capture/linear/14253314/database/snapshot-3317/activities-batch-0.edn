#{[{:activity/first-step {:db/id #edb/ref 17592186060836} :activity/id #uuid "4f0dd3e9-7208-5dd4-9870-cd437ed9ebc7" :activity/scope {:db/id #edb/ref 17592186048932 :topic/id #uuid "cd2e9db4-6727-5887-90bc-20eb0a0bf6d2" :topic/math-academy-id 278} :activity/steps [{:db/id #edb/ref 17592186060836 :step/content {:db/id #edb/ref 17592186060949 :tutorial/content "The **constant multiple rule** states that if a function $f(x)$ is multiplied by a *constant* factor $k$, then in order to differentiate $kf(x)$ we can take the derivative of $f(x)$ and then multiply by $k$ afterwards:\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}\\left(k f(x)\\right) = k \\dfrac{\\textrm d}{\\textrm d x}\\left(f(x)\\right)\n$$\n\nFor example, to differentiate $y=6x^2$, we compute\n\n$$\n\\begin{aligned}\n\\frac{dy}{dx} &= \\frac{d}{dx}(6x^{2}) \\\\\n&= 6 \\cdot \\frac{d}{dx}(x^{2}) \\\\\n&= 6 \\cdot 2x \\\\\n&= 12x\n\\end{aligned}\n$$" :tutorial/id #uuid "882aa12a-1be9-5fa0-8b2f-2a42007270f7" :tutorial/math-academy-id 345 :tutorial/title "Introduction"} :step/id #uuid "774ab8dd-74f7-5649-bbaf-2c137913eac6" :step/math-academy-id 638 :step/next {:db/id #edb/ref 17592186060837}} {:db/id #edb/ref 17592186060837 :step/content {:db/id #edb/ref 17592186059862 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059441 :question/id #uuid "e52f80d1-431d-51a0-9c51-950dc1a91065" :question/math-academy-id "e-138"} :knowledge-point/id #uuid "ffc1d505-17e4-5b0f-9150-506f9edb3350" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048593}] :knowledge-point/question-generator {:db/id #edb/ref 17592186494276} :knowledge-point/questions [{:db/id #edb/ref 17592186060005} {:db/id #edb/ref 17592186060260} {:db/id #edb/ref 17592186233069} {:db/id #edb/ref 17592186233469} {:db/id #edb/ref 17592186235441} {:db/id #edb/ref 17592186494230} {:db/id #edb/ref 17592186494234} {:db/id #edb/ref 17592186494247} {:db/id #edb/ref 17592186494248} {:db/id #edb/ref 17592186494249} {:db/id #edb/ref 17592186494253} {:db/id #edb/ref 17592186494266} {:db/id #edb/ref 17592186494268} {:db/id #edb/ref 17592186494273} {:db/id #edb/ref 17592186494274}] :knowledge-point/title "Differentiating a Power Function Using the Constant Multiple Rule"} :step/id #uuid "83c1a05d-5319-54e1-9720-469dfe66522a" :step/math-academy-id 639 :step/next {:db/id #edb/ref 17592186060838}} {:db/id #edb/ref 17592186060838 :step/content {:db/id #edb/ref 17592186059863 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059442 :question/id #uuid "2385b6c3-1f86-59fe-96bf-d42ed5cd1b56" :question/math-academy-id "e-139"} :knowledge-point/id #uuid "852449ca-b4df-5142-9540-bb503d5b7b62" :knowledge-point/questions [{:db/id #edb/ref 17592186059974} {:db/id #edb/ref 17592186059975} {:db/id #edb/ref 17592186233064} {:db/id #edb/ref 17592186233891} {:db/id #edb/ref 17592186234277} {:db/id #edb/ref 17592186237874} {:db/id #edb/ref 17592186244047} {:db/id #edb/ref 17592186518174}] :knowledge-point/title "Differentiating a Negative Power Function Using the Constant Multiple Rule"} :step/id #uuid "421e2979-c6df-5963-97d9-12da0c317f27" :step/math-academy-id 642 :step/next {:db/id #edb/ref 17592186060839}} {:db/id #edb/ref 17592186060839 :step/content {:db/id #edb/ref 17592186060950 :tutorial/content "The **sum rule** states that to differentiate the sum of two functions, we can take the sum of their respective derivatives:\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(u(x) + v(x)) = \\dfrac{\\textrm d u}{\\textrm d x} + \\dfrac{\\textrm d v}{\\textrm d x}\n$$\n\nThe sum rule also applies to differences:\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(u(x) - v(x)) = \\dfrac{\\textrm d u}{\\textrm d x} - \\dfrac{\\textrm d v}{\\textrm d x}\n$$\n\nAs an example, let's calculate the derivative of the function\n\n$$\ny = x^2 + x\n$$\n\nWe can apply the sum rule to find\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d x}\n$$\n\nas follows:\n\n$$\n\\begin{aligned}\n\\frac{dy}{dx} &= \\frac{d}{dx}(x^{2} + x) \\\\\n&= \\frac{d}{dx}(x^{2}) + \\frac{d}{dx}(x) \\\\\n&= 2x + 1\n\\end{aligned}\n$$" :tutorial/id #uuid "f81bca0f-c3d3-5653-b4d5-17a0d2af8863" :tutorial/math-academy-id 348 :tutorial/title "The Sum Rule for Differentiation"} :step/id #uuid "51156115-46da-5b79-ab31-debdece8bd51" :step/math-academy-id 644 :step/next {:db/id #edb/ref 17592186060840}} {:db/id #edb/ref 17592186060840 :step/content {:db/id #edb/ref 17592186059864 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059443 :question/id #uuid "72830b06-6333-5b61-8257-3967312bd178" :question/math-academy-id "e-140"} :knowledge-point/id #uuid "d3469bdd-a201-5219-a734-ed3caa6b039a" :knowledge-point/question-generator {:db/id #edb/ref 17592186494298} :knowledge-point/questions [{:db/id #edb/ref 17592186059964} {:db/id #edb/ref 17592186060176} {:db/id #edb/ref 17592186234278} {:db/id #edb/ref 17592186234279} {:db/id #edb/ref 17592186314784} {:db/id #edb/ref 17592186494285} {:db/id #edb/ref 17592186494290} {:db/id #edb/ref 17592186494292} {:db/id #edb/ref 17592186535945} {:db/id #edb/ref 17592186535966}] :knowledge-point/title "Differentiating a Sum of Functions Without Constant Factors Using the Sum Rule"} :step/id #uuid "3e6bf63f-d0ed-582b-bfaa-01d712a200e3" :step/math-academy-id 645 :step/next {:db/id #edb/ref 17592186060841}} {:db/id #edb/ref 17592186060841 :step/content {:db/id #edb/ref 17592186059865 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059444 :question/id #uuid "acfa9025-f984-5b09-9e24-f72707ad67ac" :question/math-academy-id "e-141"} :knowledge-point/id #uuid "f8e49a0c-9575-5bd0-af4e-6463495e56b3" :knowledge-point/questions [{:db/id #edb/ref 17592186060174} {:db/id #edb/ref 17592186060175} {:db/id #edb/ref 17592186233095} {:db/id #edb/ref 17592186233096} {:db/id #edb/ref 17592186233600} {:db/id #edb/ref 17592186235359} {:db/id #edb/ref 17592186287872} {:db/id #edb/ref 17592186518215} {:db/id #edb/ref 17592186535979} {:db/id #edb/ref 17592186535994} {:db/id #edb/ref 17592186575601}] :knowledge-point/title "Differentiating a Sum of Functions With Constant Factors"} :step/id #uuid "23703e57-9d17-5cfe-bffc-b6497f55dc01" :step/math-academy-id 647}] :activity/title "The Sum and Constant Multiple Rules for Differentiation" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186059950}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186518301} :activity/id #uuid "9c473583-05b6-5bc0-af16-b14fdc8c8a09" :activity/scope {:db/id #edb/ref 17592186048932 :topic/id #uuid "cd2e9db4-6727-5887-90bc-20eb0a0bf6d2" :topic/math-academy-id 278} :activity/steps [{:db/id #edb/ref 17592186518237 :step/content {:db/id #edb/ref 17592186518174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d7cab94-65b2-5228-8549-f3ba7717c36b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{11}x" :db/id #edb/ref 17592186517638} {:answer/id #uuid "608c8c54-3777-5d49-8def-13401921a806" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}{x}^{8}" :db/id #edb/ref 17592186517665} {:answer/id #uuid "ad22bea0-0514-5968-a849-0f45c5a43d08" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9{x}^{9}" :db/id #edb/ref 17592186517812} {:answer/id #uuid "d7ba16ff-9f57-54e5-b32e-9e736a76872d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{99}{{x}^{10}}" :db/id #edb/ref 17592186517898} {:answer/id #uuid "e52d4e72-b1f6-5c83-8f92-b5cb335afcc1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{99}{{x}^{11}}" :db/id #edb/ref 17592186517922}] :answer-field/correct {:db/id #edb/ref 17592186517898} :answer-field/id #uuid "d47a598d-d2c7-5bab-9e38-017b0c639aa7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518073}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8ce73f5e-c8df-5814-9aaf-e78dee12c64a" :question/math-academy-id "q-10741" :question/problem "If $y=\\frac{11}{{x}^{9}},$ find $\\frac{dy}{dx}.$" :question/worked-solution "We first rewrite the function as\n\n$$\ny=\\frac{11}{{x}^{9}}=11{x}^{-9}.\n$$\n\nThen, we apply the constant multiple and power rules:\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{\\text{d}}{\\text{d}x}(11{x}^{-9}) \\\\  & =11\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-9}) \\\\  & =11\\cdot (-9){x}^{-9-1} \\\\  & =-99{x}^{-10} \\\\  & =-\\frac{99}{{x}^{10}}\\end{aligned}\n$$"} :step/id #uuid "32d6371f-33f3-5561-8be1-2fca80b1c7d8"} {:db/id #edb/ref 17592186518290 :step/content {:db/id #edb/ref 17592186518215 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40f7c195-a751-5b71-9a87-0de1ab89d81e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12{x}^{3}-\\frac{21}{{x}^{5}}-12" :db/id #edb/ref 17592186517615} {:answer/id #uuid "43bd9732-3c9a-5769-9c00-bbcb2a48446f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12{x}^{3}-\\frac{28}{{x}^{5}}-12" :db/id #edb/ref 17592186517620} {:answer/id #uuid "cf947bc2-e090-5053-8204-9ff869376488" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12{x}^{3}+\\frac{28}{{x}^{5}}-12" :db/id #edb/ref 17592186517880} {:answer/id #uuid "e3d435a4-9bec-54a8-9486-d0e6717fcf24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24{x}^{3}-\\frac{28}{{x}^{3}}-12" :db/id #edb/ref 17592186517917} {:answer/id #uuid "f2405522-cc9c-5a15-9cc7-6150b213efad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{x}^{3}+\\frac{21}{{x}^{3}}-12" :db/id #edb/ref 17592186517952}] :answer-field/correct {:db/id #edb/ref 17592186517620} :answer-field/id #uuid "059dbd28-656a-59be-8ed5-e0971d025a8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186517971}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ec8a3447-04a1-55a0-a68b-6b9044cae34d" :question/math-academy-id "q-1866" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=3{x}^{4}+\\frac{7}{{x}^{4}}-12x.$" :question/worked-solution "Here, we apply the addition, constant multiple, and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{4}+\\frac{7}{{x}^{4}}-12x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{4})+\\frac{\\text{d}}{\\text{d}x}(7{x}^{-4})-\\frac{\\text{d}}{\\text{d}x}(12x) \\\\  & =3\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{4})+7\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-4})-12\\cdot \\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =3\\cdot 4{x}^{(4-1)}+7\\cdot (-4){x}^{(-4-1)}-12\\cdot 1 \\\\  & =12{x}^{3}-28{x}^{-5}-12 \\\\  & =12{x}^{3}-\\frac{28}{{x}^{5}}-12\\end{aligned}\n$$"} :step/id #uuid "be80f772-d8ad-5602-ac15-4417e513dab9" :step/next {:db/id #edb/ref 17592186518237}} {:db/id #edb/ref 17592186518301 :step/content {:db/id #edb/ref 17592186060174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5446db9d-f32b-503a-98c3-71bd4b13a940" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{{x}^{3}}-\\frac{9{x}^{1/4}}{4}" :db/id #edb/ref 17592186285562} {:answer/id #uuid "72b849ec-c73e-51c6-8bd6-7d57955bf8d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{{x}^{3}}-\\frac{9}{4\\sqrt[3]{x}}" :db/id #edb/ref 17592186285843} {:answer/id #uuid "93d4bb13-717f-50aa-afa5-f6147b1c9f75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{{x}^{2}}-9{x}^{3}" :db/id #edb/ref 17592186286135} {:answer/id #uuid "a7da2020-89e3-5d5f-bbdb-6fb669e629c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{{x}^{3}}+\\frac{9{x}^{-1/4}}{4}" :db/id #edb/ref 17592186286320} {:answer/id #uuid "e9029ff2-9352-53d1-a4ea-86df802fa96d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{{x}^{3}}-\\frac{9}{4\\sqrt[4]{x}}" :db/id #edb/ref 17592186286919}] :answer-field/correct {:db/id #edb/ref 17592186286919} :answer-field/id #uuid "8320dfd3-7a24-5485-a9b9-30a0c49ac165" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287423}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "76292ca7-955e-5da2-801e-cf1602a2e16d" :question/math-academy-id "q-1856" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{2}{{x}^{2}}-3{x}^{3/4}.$" :question/worked-solution "Here, we apply the addition, constant multiple, and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{{x}^{2}}-3{x}^{3/4}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{-2})-\\frac{\\text{d}}{\\text{d}x}(3{x}^{3/4}) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-2})-3\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{3/4}) \\\\  & =2\\cdot (-2){x}^{(-2-1)}-3\\cdot \\frac{3}{4}{x}^{(3/4-1)} \\\\  & =-4{x}^{-3}-\\frac{9}{4}{x}^{-1/4} \\\\  & =-\\frac{4}{{x}^{3}}-\\frac{9}{4\\sqrt[4]{x}}\\end{aligned}\n$$"} :step/id #uuid "d808f43f-f58c-5105-bd8a-c0ad332d774e" :step/next {:db/id #edb/ref 17592186518290}}] :activity/title "The Sum and Constant Multiple Rules for Differentiation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186517489}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186536028} :activity/id #uuid "009fb53a-6c15-5331-9b62-5e54cb035cf7" :activity/scope {:db/id #edb/ref 17592186048932 :topic/id #uuid "cd2e9db4-6727-5887-90bc-20eb0a0bf6d2" :topic/math-academy-id 278} :activity/steps [{:db/id #edb/ref 17592186536012 :step/content {:db/id #edb/ref 17592186237874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "140ff256-58cb-520e-bd9f-ea7c8a886af9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2\\sqrt{{x}^{5}}}" :db/id #edb/ref 17592186235938} {:answer/id #uuid "1b82390d-5224-5735-9b05-52d62582a7a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2\\sqrt{x}}" :db/id #edb/ref 17592186235987} {:answer/id #uuid "42c2e22e-7c41-5aba-866b-c2bfb66a3484" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3\\sqrt{{x}^{5}}}" :db/id #edb/ref 17592186236246} {:answer/id #uuid "76520e43-a300-5719-9281-b069c04cc15c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3\\sqrt{x}}" :db/id #edb/ref 17592186236558} {:answer/id #uuid "8f7c3eb2-612e-5bea-9351-f3a4af8fd436" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{{x}^{3}}}" :db/id #edb/ref 17592186236726}] :answer-field/correct {:db/id #edb/ref 17592186235938} :answer-field/id #uuid "fbea9dd8-14a2-537f-a32b-13a92d5ed3d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237769}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ec04a0d1-192f-5dcf-aa4b-20bf3669c6e0" :question/math-academy-id "q-102192" :question/problem "If $y=\\frac{1}{3\\sqrt{{x}^{3}}},$ find $\\frac{dy}{dx}.$" :question/worked-solution "We first rewrite the function as\n\n$$\ny=\\frac{1}{3\\sqrt{{x}^{3}}}=\\frac{1}{3}{x}^{-3/2}.\n$$\n\nThen, we apply the constant multiple and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{3}{x}^{-3/2}) \\\\  & =\\frac{1}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-3/2}) \\\\  & =\\frac{1}{3}\\cdot (-\\frac{3}{2}){x}^{(-\\frac{3}{2}-1)} \\\\  & =-\\frac{1}{2}{x}^{-5/2} \\\\  & =-\\frac{1}{2\\sqrt{{x}^{5}}}\\end{aligned}\n$$"} :step/id #uuid "1ffd320b-d38b-57d0-b097-7c3039e0ec50"} {:db/id #edb/ref 17592186536028 :step/content {:db/id #edb/ref 17592186535994 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "215a3196-aa1e-53fe-ba9a-dd584d06fa02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14{x}^{6}-24x+\\frac{5\\sqrt[4]{x}}{4}" :db/id #edb/ref 17592186535484} {:answer/id #uuid "29372cbb-de9f-5045-bc68-a6f3e039aa5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{x}^{6}-24x+\\frac{5}{4\\sqrt[3]{x}}" :db/id #edb/ref 17592186535498} {:answer/id #uuid "8e201c30-afed-5567-a27a-5f1d97078f77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14{x}^{6}+24x+\\frac{5{x}^{-\\frac{1}{4}}}{4}" :db/id #edb/ref 17592186535662} {:answer/id #uuid "cc7fe356-6709-56ff-968f-0b948652e8e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14{x}^{6}+22x-\\frac{5{x}^{\\frac{1}{4}}}{4}" :db/id #edb/ref 17592186535743} {:answer/id #uuid "e3f7bb4e-6f66-5b0b-ba5e-25005bb49ba2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14{x}^{6}-12{x}^{2}+\\frac{5{x}^{\\frac{1}{2}}}{4}" :db/id #edb/ref 17592186535785}] :answer-field/correct {:db/id #edb/ref 17592186535484} :answer-field/id #uuid "ba01c00d-e4ab-58b9-976c-4280882e9d75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186535901}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cd92c8db-d853-53b3-99d2-6ad9bcebe052" :question/math-academy-id "q-1861" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=-4+2{x}^{7}-12{x}^{2}+{x}^{5/4}.$" :question/worked-solution "Here, we apply the addition, constant multiple, and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-4+2{x}^{7}-12{x}^{2}+{x}^{5/4}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(-4)+\\frac{\\text{d}}{\\text{d}x}(2{x}^{7})-\\frac{\\text{d}}{\\text{d}x}(12{x}^{2})+\\frac{\\text{d}}{\\text{d}x}({x}^{5/4}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(-4)+2\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{7})-12\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}({x}^{5/4}) \\\\  & =0+2\\cdot 7{x}^{(7-1)}-12\\cdot 2{x}^{(2-1)}+\\frac{5}{4}\\cdot {x}^{(\\frac{5}{4}-1)} \\\\  & =14{x}^{6}-24x+\\frac{5}{4}{x}^{1/4} \\\\  & =14{x}^{6}-24x+\\frac{5\\sqrt[4]{x}}{4}\\end{aligned}\n$$"} :step/id #uuid "737e356a-65b8-553f-997b-0d69f97cecb2" :step/next {:db/id #edb/ref 17592186536049}} {:db/id #edb/ref 17592186536033 :step/content {:db/id #edb/ref 17592186535966 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f7c7324-2c11-5c83-acfa-b2ee47b3214b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8{x}^{7}-3{x}^{2}+\\frac{2}{{x}^{3}}" :db/id #edb/ref 17592186535483} {:answer/id #uuid "628bae58-14c7-519d-8c7b-b62c7c8633da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8{x}^{7}-3{x}^{2}-\\frac{3}{{x}^{3}}" :db/id #edb/ref 17592186535589} {:answer/id #uuid "cd3b37bf-ff7e-534a-a633-94c74472b5b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7{x}^{7}-3{x}^{2}-\\frac{2}{{x}^{3}}" :db/id #edb/ref 17592186535745} {:answer/id #uuid "db9820bc-9141-5706-b4b9-696ff0f4d463" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8{x}^{7}-3{x}^{2}-\\frac{2}{{x}^{3}}" :db/id #edb/ref 17592186535770} {:answer/id #uuid "fdc03597-2e55-5dbe-b2dc-cac7ff614227" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8{x}^{7}-2{x}^{2}-\\frac{2}{{x}^{3}}" :db/id #edb/ref 17592186535828}] :answer-field/correct {:db/id #edb/ref 17592186535770} :answer-field/id #uuid "86ad7852-6087-5de6-850f-cd1888a6eb84" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186535880}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8a7a18a3-9c4b-5644-bbba-c016ec6ec070" :question/math-academy-id "q-70507" :question/problem "Find ${f}^{′}(x)$ for  $f(x)={x}^{8}-{x}^{3}+\\frac{1}{{x}^{2}}.$" :question/worked-solution "The function $f(x)$ is the sum of three power functions. So, we apply the sum rule, and we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{8}-{x}^{3}+\\frac{1}{{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{8})-\\frac{\\text{d}}{\\text{d}x}({x}^{3})+\\frac{\\text{d}}{\\text{d}x}({x}^{-2}) \\\\  & =8{x}^{(8-1)}-3{x}^{(3-1)}+(-2){x}^{-2-1} \\\\  & =8{x}^{7}-3{x}^{2}-2{x}^{-3} \\\\  & =8{x}^{7}-3{x}^{2}-\\frac{2}{{x}^{3}}.\\end{aligned}\n$$"} :step/id #uuid "86e0a8b7-a787-51e5-aa42-402c11774f72" :step/next {:db/id #edb/ref 17592186536038}} {:db/id #edb/ref 17592186536038 :step/content {:db/id #edb/ref 17592186535945 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49ef83ba-2eda-583f-b227-7dc00e66db76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+\\frac{1}{\\sqrt{x}}-\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186535543} {:answer/id #uuid "50a9d952-ca58-515d-b1b3-d5444dbbbd57" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x-\\frac{1}{2\\sqrt{x}}+\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186535557} {:answer/id #uuid "63aaf731-d747-572e-8b0f-86051724c920" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+\\frac{1}{2\\sqrt{x}}-\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186535592} {:answer/id #uuid "79a69091-2708-57af-a95c-cea22cfae627" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+\\frac{1}{\\sqrt{x}}+\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186535623} {:answer/id #uuid "87845c36-7288-53ed-a176-4fdc76ecaa99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+\\frac{1}{2\\sqrt{x}}+\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186535650}] :answer-field/correct {:db/id #edb/ref 17592186535650} :answer-field/id #uuid "af40c564-a593-533d-9007-1735d6d363e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186535894}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "41b5b51f-ba4d-5684-ad06-c34aebd809fa" :question/math-academy-id "q-70510" :question/problem "Find ${f}^{′}(x)$ for  $f(x)={x}^{2}+\\sqrt{x}-\\frac{1}{x}.$" :question/worked-solution "The function $f(x)$ is the sum of three power functions. So, we apply the sum rule, and we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}+\\sqrt{x}-\\frac{1}{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}({x}^{1/2})-\\frac{\\text{d}}{\\text{d}x}({x}^{-1}) \\\\  & =2{x}^{(2-1)}+\\frac{1}{2}{x}^{1/2-1}-(-1){x}^{(-1-1)} \\\\  & =2x+\\frac{1}{2}{x}^{-1/2}+{x}^{-2} \\\\  & =2x+\\frac{1}{2\\sqrt{x}}+\\frac{1}{{x}^{2}}.\\end{aligned}\n$$"} :step/id #uuid "a7e099d1-ddb9-56ee-bd14-9204b7666fdc" :step/next {:db/id #edb/ref 17592186536012}} {:db/id #edb/ref 17592186536049 :step/content {:db/id #edb/ref 17592186535979 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11aebb25-3c41-52e1-bf66-1dcd7ee2ce0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14{x}^{6}-\\frac{2}{{x}^{3}}-2" :db/id #edb/ref 17592186535466} {:answer/id #uuid "3e200482-d133-5eb7-8136-1d3336aff1e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14{x}^{6}+\\frac{2}{{x}^{3}}+2" :db/id #edb/ref 17592186535528} {:answer/id #uuid "a80acf4a-b6f9-58b9-ac0e-e6ed94b44fb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14{x}^{6}-\\frac{2}{{x}^{3}}" :db/id #edb/ref 17592186535696} {:answer/id #uuid "a849b7f1-4748-5906-8130-819ebcc7baa6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7{x}^{6}-\\frac{2}{{x}^{3}}+2" :db/id #edb/ref 17592186535697} {:answer/id #uuid "cc1c08e7-f8dc-506c-9813-764d2dd4e5df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14{x}^{6}-\\frac{2}{{x}^{3}}+2" :db/id #edb/ref 17592186535742}] :answer-field/correct {:db/id #edb/ref 17592186535742} :answer-field/id #uuid "4419ee0e-8651-52b9-9b46-c0466ee66f3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186535856}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a746a92c-9180-5bad-bfc6-5ca557baf9cb" :question/math-academy-id "q-10292" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=2{x}^{7}+\\frac{1}{{x}^{2}}+2x-2.$" :question/worked-solution "Here, we apply the addition, constant multiple, and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{7}+\\frac{1}{{x}^{2}}+2x-2) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{7})+\\frac{\\text{d}}{\\text{d}x}({x}^{-2})+\\frac{\\text{d}}{\\text{d}x}(2x)-\\frac{\\text{d}}{\\text{d}x}(2) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{7})+\\frac{\\text{d}}{\\text{d}x}({x}^{-2})+2\\cdot \\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(2) \\\\  & =2\\cdot 7{x}^{(7-1)}+(-2){x}^{(-2-1)}+2\\cdot 1-0 \\\\  & =14{x}^{6}-2{x}^{-3}+2 \\\\  & =14{x}^{6}-\\frac{2}{{x}^{3}}+2\\end{aligned}\n$$"} :step/id #uuid "f660f8c9-d53b-5752-bc6d-8207382ee6a0" :step/next {:db/id #edb/ref 17592186536033}}] :activity/title "The Sum and Constant Multiple Rules for Differentiation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186535425}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/expected-seconds 270.0 :activity/first-step {:db/id #edb/ref 17592186569103} :activity/id #uuid "d7836bce-8ad1-42a3-a8f5-6663139345c8" :activity/scope {:db/id #edb/ref 17592186048932 :topic/id #uuid "cd2e9db4-6727-5887-90bc-20eb0a0bf6d2" :topic/math-academy-id 278} :activity/steps [{:db/id #edb/ref 17592186569103 :step/content {:db/id #edb/ref 17592186494268 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38c9f0a0-5dd0-51b3-9962-ec4ef67ecbf1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "17x^{5}" :db/id #edb/ref 17592186494233} {:answer/id #uuid "4d41ebae-1de7-5ada-9662-398883f7232f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "330x^{4}" :db/id #edb/ref 17592186494237} {:answer/id #uuid "572e21bb-bda7-51b3-b440-dd50f8ac9b1c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11x^{7}}{6}" :db/id #edb/ref 17592186494240} {:answer/id #uuid "670527a0-c07b-5803-8457-28f66c9e97e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "66x^{6}" :db/id #edb/ref 17592186494244} {:answer/