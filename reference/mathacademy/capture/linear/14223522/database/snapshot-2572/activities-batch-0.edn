#{[{:activity/first-step {:db/id #edb/ref 17592186074907} :activity/id #uuid "8c1c7900-f03a-561c-8ea1-4c36f0a4a28b" :activity/scope {:db/id #edb/ref 17592186048906 :topic/id #uuid "cb5f4251-e56e-5612-a19a-b98c9b2d1546" :topic/math-academy-id 483} :activity/steps [{:db/id #edb/ref 17592186074714 :step/content {:db/id #edb/ref 17592186073779 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073648 :question/id #uuid "14fc5fcd-4aaa-5c46-a991-4703ceb0434c" :question/math-academy-id "e-7747"} :knowledge-point/id #uuid "9322724c-215a-5a91-a478-e91abe4038da" :knowledge-point/questions [{:db/id #edb/ref 17592186074178} {:db/id #edb/ref 17592186074181}] :knowledge-point/title "Determining the Image of a Polygon Under the Action of Multiple Transformations"} :step/id #uuid "383137fb-a667-5ee2-9f6a-b48d1e2491f3" :step/math-academy-id 28860 :step/next {:db/id #edb/ref 17592186074909}} {:db/id #edb/ref 17592186074716 :step/content {:db/id #edb/ref 17592186073781 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073650 :question/id #uuid "0f05c408-7ea2-58d2-a8e3-663f819747d1" :question/math-academy-id "e-7793"} :knowledge-point/id #uuid "1614303a-a067-5879-9ba6-2e7505109136" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050093} {:db/id #edb/ref 17592186050103} {:db/id #edb/ref 17592186050589}] :knowledge-point/questions [{:db/id #edb/ref 17592186074177} {:db/id #edb/ref 17592186074516}] :knowledge-point/title "Determining the Image of a Point Given a Sequence of Transformations"} :step/id #uuid "f68143db-5755-5d7a-98c2-1bc3df7dd0bc" :step/math-academy-id 29004 :step/next {:db/id #edb/ref 17592186074908}} {:db/id #edb/ref 17592186074907 :step/content {:db/id #edb/ref 17592186074980 :tutorial/content "We can combine transformations by applying them in turn.\n\nFor example, suppose that the segment $\\overline{AB}$ below is dilated with center $O$ and a scale factor $2$, and then shifted $3$ units down. What is the resulting segment?\n\n![](images/f7/f739b4363c116dcd1e1139a5111373e0f3f16557a7d4b9a58a0b12d0957dd4e4.png)\n\nLet's apply the transformations in turn.\n\n- Dilating with center $O$ and scale factor $2$ gives the segment $\\overline{A'B'}$, shown below:\n\n![](images/c0/c0a9c59e085f982d851d624cce09e37e27a6554e4de308f512246880d87c6ab6.png)\n\n- Next, we take $\\overline{A'B'}$ and shift it by $3$ units down. This gives the segment $\\overline{A''B''}$:\n\n![](images/a7/a78807d3f1fb43f3773671f7c4f5696dd3779ae9ce1d8da797377c3574170a92.png)" :tutorial/id #uuid "db9037b0-2293-5cfb-82a7-3ceb49e7f1c2" :tutorial/math-academy-id 2286 :tutorial/title "Introduction"} :step/id #uuid "54890655-2246-5ea0-b6c5-dd777056aa9e" :step/math-academy-id 9530 :step/next {:db/id #edb/ref 17592186074716}} {:db/id #edb/ref 17592186074908 :step/content {:db/id #edb/ref 17592186073904 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073590 :question/id #uuid "6b45326c-ce13-5d2f-84df-b3698b46ea68" :question/math-academy-id "e-2888"} :knowledge-point/id #uuid "1b09eb59-3ad5-5cde-8503-3c28c9e5c546" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048208} {:db/id #edb/ref 17592186049034}] :knowledge-point/questions [{:db/id #edb/ref 17592186074171} {:db/id #edb/ref 17592186074179}] :knowledge-point/title "Applying Multiple Transformations to a Point Using Functions"} :step/id #uuid "36d25884-66b5-5b7e-a637-4f934d7082a6" :step/math-academy-id 9531 :step/next {:db/id #edb/ref 17592186074714}} {:db/id #edb/ref 17592186074909 :step/content {:db/id #edb/ref 17592186073905 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073591 :question/id #uuid "b45dae26-7996-5544-9884-d604bac62993" :question/math-academy-id "e-2893"} :knowledge-point/id #uuid "d4308331-fea0-51e1-b1c9-a3e8e122e09e" :knowledge-point/questions [{:db/id #edb/ref 17592186074180} {:db/id #edb/ref 17592186074182}] :knowledge-point/title "Determining Parameters Given a Point and Its Image Under Multiple Transformations"} :step/id #uuid "ec82e4