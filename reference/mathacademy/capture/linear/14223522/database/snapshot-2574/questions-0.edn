831d-5a29033970e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(10,-21)" :db/id #edb/ref 17592186536483} {:answer/id #uuid "e4fd129a-3897-566f-b017-d5935d9fe3c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-10,-21)" :db/id #edb/ref 17592186536644} {:answer/id #uuid "fa18dc99-0972-5734-8b7c-acec22695fad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-21,10)" :db/id #edb/ref 17592186536683}] :answer-field/correct {:answer/id #uuid "76be68a4-09fd-5e88-831d-5a29033970e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(10,-21)" :db/id #edb/ref 17592186536483} :answer-field/id #uuid "a4faa69a-a341-53a6-a6fc-1d912a96ca49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536768}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5d698685-38f5-5e4a-b709-e155fb9c6b96" :question/math-academy-id "q-14379" :question/problem "The point $P(-21,17)$ is acted on by a shift of $7$ units down followed by reflection across the line $y=x.$ What is the image of $P$ under this transformation?" :question/worked-solution "Let's recall the functional representations of our two transformations:\n\n- A shift of $7$ units down can be represented by the function \n\n$$\n(x,y)↦(x,y-7).\n$$\n\n- A reflection across the line $y=x$ can be represented by the function\n\n$$\n(x,y)↦(y,x).\n$$\n\nLet's apply the given transformations to the point $P$ using our functions:\n\nFirst, we apply the shift. The image of the point $(-21,17)$ under the shift is\n\n$$\n(-21,17)↦(-21,17-7)=(-21,10).\n$$\n\n \n\nThen, we apply the reflection. The image of the point $(-21,10)$ under the reflection is\n\n$$\n(-21,10)↦(10,-21).\n$$\n\nTherefore, the resulting point is $(10,-21).$"}] [{:db/id #edb/ref 17592186536869 :knowledge-point/_questions [{:db/id #edb/ref 17592186073904 :knowledge-point/id #uuid "1b09eb59-3ad5-5cde-8503-3c28c9e5c546" :knowledge-point/title "Applying Multiple Transformations to a Point Using Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d6aa5e1-96ad-5af2-b67a-d52b21a1d422" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,-3)" :db/id #edb/ref 17592186536380} {:answer/id #uuid "a4e5ce62-ea3a-5f89-be1a-a44d806e3912" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-4)" :db/id #edb/ref 17592186536549} {:answer/id #uuid "d1814799-e689-53a9-80c0-138645ff6068" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-3)" :db/id #edb/ref 17592186536614} {:answer/id #uuid "e044b7d5-8486-58d6-b3fe-085072e21840" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186536630} {:answer/id #uuid "ea7eef76-ed62-5f78-aa7d-5f5fcde472d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186536653}] :answer-field/correct {:answer/id #uuid "e044b7d5-8486-58d6-b3fe-085072e21840" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186536630} :answer-field/id #uuid "4699a690-a8bd-5581-b11e-7163244e6dcf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536727}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "abee8b7a-4a45-595d-8f90-0e0bbc3678c1" :question/math-academy-id "q-4056" :question/problem "The point $Q(-3,1)$ is shifted $2$ units up, reflected across the $y$-axis, and then shifted $1$ unit to the left. What is the resulting point?" :question/worked-solution "Let's recall the functional representations of our three transformations:\n\n- A shift of $2$ units up can be represented by the function \n\n$$\n(x,y)↦(x,y+2).\n$$\n\n- A reflection in the $y$-axis can be represented by the function \n\n$$\n(x,y)↦(-x,y).\n$$\n\n- A shift of $1$ unit to the left can be represented by the function \n\n$$\n(x,y)↦(x-1,y).\n$$\n\nLet's apply the given transformations to the point $Q$ using our functions:\n\nFirst, we apply the shift. The image of the point $(-3,1)$ under the shift is\n\n$$\n(-3,1)↦(-3,1+2)=(-3,3).\n$$\n\n \n\nThen, we apply the reflection. The image of the point $(-3,3)$ under the reflection is\n\n$$\n(-3,3)↦(3,3).\n$$\n\nFinally, we apply the second shift by $1$ unit to the left. The image of the point $(3,3)$ under the shift is\n\n$$\n(3,3)↦(3-1,3)=(2,3).\n$$\n\n \n\nTherefore, the resulting point is $(2,3).$"}] [{:db/id #edb/ref 17592186536860 :knowledge-point/_questions [{:db/id #edb/ref 17592186073781 :knowledge-point/id #uuid "1614303a-a067-5879-9ba6-2e7505109136" :knowledge-point/title "Determining the Image of a Point Given a Sequence of Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6aadaa4c-8a18-5f9e-b277-fc20046c319b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "E" :db/id #edb/ref 17592186536464} {:answer/id #uuid "a891e785-ad3f-5780-a789-64e4bb808822" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A" :db/id #edb/ref 17592186536551} {:answer/id #uuid "a9741633-dd63-54e4-85b5-212a2fef0ea6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B" :db/id #edb/ref 17592186536553} {:answer/id #uuid "c07101b6-519b-5a88-8551-6533b9ad2d56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186536586} {:answer/id #uuid "ca607ac2-38c8-5add-80ca-99f8ed882fc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D" :db/id #edb/ref 17592186536602}] :answer-field/correct {:answer/id #uuid "c07101b6-519b-5a88-8551-6533b9ad2d56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186536586} :answer-field/id #uuid "05a6f705-a8ca-5027-8e1e-7ed16ea6ea53" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536700}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9094ec48-ee4f-5d76-adf5-7427a959082d" :question/math-academy-id "q-45198" :question/problem "![](images/77/776278c72c3569eb4ee7bb48c8c544d4731be0378c942256699f5350a15d4b53.png)\n\nThe point $P$ shown above is reflected across the $x$-axis and then translated $3$ units to the left.  Which of the given points is the image of $P$ under this sequence of transformations?" :question/worked-solution "Let's apply the given transformations.\n\n- Reflecting the point $P$ across the $x$-axis gives the point $F,$ as shown below:\n\n![](images/78/782b4ca00a0c7e091873aaafbcc439b9f63b209bd878da3393c81848f2c8f375.png)\n\n- Shifting the point $F$ to the left by $3$ units gives the point $C,$ as shown below:\n\n![](images/f4/f40099c0f59f3e07fbe505a102a7b7f513dcb8bc36e5abb1382ee8e7b003b9f9.png)\n\nTherefore, the correct answer is $C.$"}] [{:db/id #edb/ref 17592186536876 :knowledge-point/_questions [{:db/id #edb/ref 17592186073779 :knowledge-point/id #uuid "9322724c-215a-5a91-a478-e91abe4038da" :knowledge-point/title "Determining the Image of a Polygon Under the Action of Multiple Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "312fd943-62ef-53c2-b313-da36d45d89e5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c7/c7eaf1716770856a4b7d2a3d0807549a3b9f817bbe21964d9422828ed3c2547e.png" :db/id #edb/ref 17592186536359} {:answer/id #uuid "abd23b07-665a-59bb-8627-3240c8ed9f90" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3b/3bd25c202d906dae5f53dfbd30be1d6f9d8b5bbc6c61b9a8a26e571e27a6ddd2.png" :db/id #edb/ref 17592186536561} {:answer/id #uuid "ae72b90a-d62a-530c-aaac-ad9a74686997" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e3/e308232592029843b1f6fabb90bb4b88e5a855b2604edbb22d715ecf8c1cba65.png" :db/id #edb/ref 17592186536566} {:answer/id #uuid "c8e07797-9d73-5c48-b6ea-b26cfa64c25a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/db/db878d3e03049d5d91e2e6dc264bbe1ba7fb09e40c3473d07c3be92f0804a105.png" :db/id #edb/ref 17592186536599} {:answer/id #uuid "f42f892e-b71b-500f-873c-319029234d5e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/31/31e41a2dcde8e8bcb161e19f7cd48c7d64dcac847d7b4ab8ac413689e6a2fca2.png" :db/id #edb/ref 17592186536675}] :answer-field/correct {:answer/id #uuid "c8e07797-9d73-5c48-b6ea-b26cfa64c25a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/db/db878d3e03049d5d91e2e6dc264bbe1ba7fb09e40c3473d07c3be92f0804a105.png" :db/id #edb/ref 17592186536599} :answer-field/id #uuid "8281b0e2-57f7-5cba-af09-5e8369c12a2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536756}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ba81a168-e077-501b-a6b1-f0f2d8fe936c" :question/math-academy-id "q-45446" :question/problem "![](images/28/28c680b8b528eb436ec1f4ed94bb49393110bc1275e077b9ee170704172024a7.png)\n\nThe polygon shown above is transformed subsequently by functions $R(x,y)↦(-x,y)$ and $S(x,y)↦(2x,y).$ What is the resulting polygon?" :question/worked-solution "Let's apply the given transformation.\n\n- Applying the transformation $R(x,y)↦(-x,y)$ gives the following:\n\n![](images/4c/4c4bde053743bf3c28e1299320df662b37b3567e2acc2199c6b4cd3cd2e19832.png)\n\n- Next, we take the last result and apply the second transformation, $S(x,y)↦(2x,y).$ This gives the following:\n\n![](images/d9/d93b8b94d99bbf6690e76cea0a13d0a91470cf003c892107e977ff89d016c9b6.png)"}] [{:db/id #edb/ref 17592186074182 :knowledge-point/_questions [{:db/id #edb/ref 17592186073905 :knowledge-point/id #uuid "d4308331-fea0-51e1-b1c9-a3e8e122e09e" :knowledge-point/title "Determining Parameters Given a Point and Its Image Under Multiple Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7aea80f-6189-5af2-ad5c-553fcd0b7648" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186071331} {:answer/id #uuid "d041f878-cc2e-5e8d-99cd-7ed031b8f58d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186071332} {:answer/id #uuid "e4c07830-a0f8-565b-b930-84aaacab6872" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186071333} {:answer/id #uuid "1fa7056b-65cd-5aa8-a4e9-c2084ebb4fbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186071334} {:answer/id #uuid "397ccfcd-63d3-5ec2-a7c8-86def1a900b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186071335}] :answer-field/correct {:answer/id #uuid "397ccfcd-63d3-5ec2-a7c8-86def1a900b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186071335} :answer-field/id #uuid "9dc1305d-85f7-5630-a8ca-d5b6d718e2e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186071330}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ab548145-2293-5c74-bbe9-e3daa039a6ad" :question/math-academy-id "q-45464" :question/problem "The point $P(-5,-2)$ is rotated ${270}^{∘}$ counterclockwise about the origin $O$ and then translated according to the function $(x,y)↦(x+p,y+q).$ If the image of $P$ under this sequence of transformations is $(2,-9),$ then $p+q=$" :question/worked-solution "Let's apply the given transformations.\n\nA rotation of ${270}^{∘}$ counterclockwise about $O$ can be represented by \n\n$$\n(x,y)↦(y,-x).\n$$\n\nApplying this to the point $P,$ we get\n\n$$\n(-5,-2)↦(-2,5).\n$$\n\nNow, applying the translation to $(-2,5),$ we get\n\n$$\n(-2,5)↦(-2+p,5+q).\n$$\n\n \n\nSince the resulting point is $(2,-9),$ by equating the $x$- and $y$-coordinates, we obtain\n\n$$\n\\begin{aligned}\\{\\begin{aligned}-2+p=2 \\\\ 5+q=-9\\end{aligned}\\,⟹\\,\\{\\begin{aligned}p=4 \\\\ q=-14.\\end{aligned}\\end{aligned}\n$$\n\nFinally, \n\n$$\np-q=4+(-14)=-10.\n$$"}] [{:db/id #edb/ref 17592186536843 :knowledge-point/_questions [{:db/id #edb/ref 17592186073905 :knowledge-point/id #uuid "d4308331-fea0-51e1-b1c9-a3e8e122e09e" :knowledge-point/title "Determining Parameters Given a Point and Its Image Under Multiple Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15c607d4-a926-5be5-9a79-37c070202dbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186536318} {:answer/id #uuid "3f1012f6-ac99-5e4e-a9f6-7a1a7f4d837b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186536381} {:answer/id #uuid "4dff97b4-92fa-577d-9da9-9c6d62f99972" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186536413} {:answer/id #uuid "9648dece-0d06-5613-b589-cdd0fc59e342" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186536524} {:answer/id #uuid "ced0514e-753d-5d75-af21-617042730647" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186536608}] :answer-field/correct {:answer/id #uuid "15c607d4-a926-5be5-9a79-37c070202dbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186536318} :answer-field/id #uuid "b39c4d94-12fb-5a15-b6bb-bc1e15c955c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536773}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "76343f99-bb5f-5787-863a-2557d071c09b" :question/math-academy-id "q-88408" :question/problem "The point $P(2,3)$ is rotated ${90}^{∘}$ counterclockwise about the origin $O$ and then translated according to the function $(x,y)↦(x-p,y+q).$ If the image of $P$ under this sequence of transformations is $(-1,5),$ then $p+q=$" :question/worked-solution "Let's apply the given transformations.\n\nA rotation of ${90}^{∘}$ counterclockwise about $O$ can be represented by \n\n$$\n(x,y)↦(-y,x).\n$$\n\nApplying this to the point $P,$ we get\n\n$$\n(2,3)↦(-3,2).\n$$\n\nNow, applying the translation to $(-3,2),$ we get\n\n$$\n(-3,2)↦(-3-p,2+q).\n$$\n\n \n\nSince the resulting point is $(-1,5),$ by equating the $x$- and $y$-coordinates, we obtain\n\n$$\n\\begin{aligned}\\{\\begin{aligned}-3-p=-1 \\\\ 2+q=5\\end{aligned}\\,⟹\\,\\{\\begin{aligned}p=-2 \\\\ q=3.\\end{aligned}\\end{aligned}\n$$\n\nFinally, \n\n$$\np+q=(-2)+3=1.\n$$"}] [{:db/id #edb/ref 17592186536815 :knowledge-point/_questions [{:db/id #edb/ref 17592186073781 :knowledge-point/id #uuid "1614303a-a067-5879-9ba6-2e7505109136" :knowledge-point/title "Determining the Image of a Point Given a Sequence of Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "041cf703-252a-5a82-af4d-e39fe9281f89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B" :db/id #edb/ref 17592186536291} {:answer/id #uuid "0f05675a-7366-5451-836b-a7a34485b9da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186536308} {:answer/id #uuid "1ea52371-3342-5c52-8943-370aaad27a07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D" :db/id #edb/ref 17592186536327} {:answer/id #uuid "334cd414-155f-577b-83d1-656c2d080e14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "E" :db/id #edb/ref 17592186536364} {:answer/id #uuid "d97b8e24-3a52-5890-8f94-f5afee62f73f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A" :db/id #edb/ref 17592186536625}] :answer-field/correct {:answer/id #uuid "d97b8e24-3a52-5890-8f94-f5afee62f73f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A" :db/id #edb/ref 17592186536625} :answer-field/id #uuid "4c49559e-e9c1-5193-b92b-63cd7b8e9ab9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536734}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "15f86877-8327-59b3-8e4f-e39de73201de" :question/math-academy-id "q-88425" :question/problem "![](images/b5/b5c8ba4573ac7894a8381c68e3b3cc1e2d2fc09114544ab20fa64f4eeaf160e1.png)\n\nThe point $P$ shown above is translated $3$ units up and then rotated by ${90}^{∘}$ clockwise around the origin. Which of the given points is the image of $P$ under this sequence of transformations?" :question/worked-solution "Let's apply the given transformations.\n\n- Shifting the point $P$ up by $3$ units gives the point $B,$ as shown below:\n\n![](images/c1/c10724408ddac65c229ad123a326ba325d7bbff8786783cb8e62ea83dea3c05f.png)\n\n- Rotating the point $B$ by ${90}^{∘}$ clockwise around the origin gives the point $A,$ as shown below:\n\n![](images/8c/8c48755414a501410c9c4908e1cf333feac85d37b876ebe49348343ad5126789.png)\n\nTherefore, the correct answer is $A.$"}]}
