#{[{:db/id #edb/ref 17592186233078 :knowledge-point/_questions [{:db/id #edb/ref 17592186064257 :knowledge-point/id #uuid "724bdf2f-c9f0-564e-ae33-c64d44c582ef" :knowledge-point/title "Splitting a Rational Expression With Two Terms in the Numerator"}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5277b0dd-a1ab-523e-8996-74d7092ca199" :question/math-academy-id "q-103615" :question/problem "Which of the following is equivalent to $\\frac{18x-6}{3}?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in individual terms, we get\n\n$$\n\\begin{aligned}\\frac{18x-6}{3} & = \\\\ \\frac{18x}{3}-\\frac{6}{3} & = \\\\ \\frac{18}{3}\\cdot x-\\frac{6}{3} & = \\\\ 6\\cdot x-2 & = \\\\ 6x-2. & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186533990 :knowledge-point/_questions [{:db/id #edb/ref 17592186054711 :knowledge-point/id #uuid "3b8feb96-7432-5fe7-a6c7-b2d8ebe7e766" :knowledge-point/title "Categorizing a Polynomial by Its Degree and Number of Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00d2ca87-06b5-5f73-a7a2-0d924de094ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "quadratic monomial" :db/id #edb/ref 17592186533130} {:answer/id #uuid "1be57fd3-5b10-52bd-9852-c6f7411b7f55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "linear binomial" :db/id #edb/ref 17592186533205} {:answer/id #uuid "28fabcc4-4d05-51ac-a912-143729df6bdf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "linear monomial" :db/id #edb/ref 17592186533243} {:answer/id #uuid "3b8222ef-3b82-5715-9c8a-28e90a679db9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "cubic monomial" :db/id #edb/ref 17592186533279} {:answer/id #uuid "8b0e746a-0ea4-5fe0-96a8-19184993385d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "quartic trinomial" :db/id #edb/ref 17592186533474}] :answer-field/correct {:answer/id #uuid "28fabcc4-4d05-51ac-a912-143729df6bdf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "linear monomial" :db/id #edb/ref 17592186533243} :answer-field/id #uuid "f60f859d-bc35-5505-9e52-c51c8f4b4755" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186533960}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "320d3413-9845-54f4-9740-6e67695ad26e" :question/math-academy-id "q-111226" :question/problem "Classify the polynomial $-\\frac{2t}{5}$ according to its degree and the number of terms." :question/worked-solution "The polynomial $-\\frac{2t}{5}$ has only one term, so it is a monomial.\n\nAlso, its degree is $1,$ so it is a linear.\n\nTherefore, the polynomial is a linear monomial."}] [{:db/id #edb/ref 17592186533988 :knowledge-point/_questions [{:db/id #edb/ref 17592186073820 :knowledge-point/id #uuid "d7d26bc9-6f89-5da4-b8a9-6be6f4280f81" :knowledge-point/title "Finding the Additive Inverse of a Positive Integer"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f33fa7f-86a4-5672-82f4-90c12943702f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186533214}] :answer-field/correct {:answer/id #uuid "1f33fa7f-86a4-5672-82f4-90c12943702f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186533214} :answer-field/id #uuid "3c6617d4-5306-575e-8610-98ba6a3acfd0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186533830}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2c77dd09-2d15-50f1-838b-9b9dd6ed6be5" :question/math-academy-id "q-178541" :question/problem "The additive inverse of $30$ is{{field-1}}." :question/worked-solution "To find the additive inverse of the number $30$, we change its sign by placing a minus symbol $(-)$ in front of it. So, we obtain \n\n$$\n-\\,(30)=-30.\n$$\n\nTo check our work, we simply add the inverse to the original number. If we're correct, we should get zero.\n\n$$\n30+(-30)=30-30=0\\,✓\n$$"}] [{:db/id #edb/ref 17592186534083 :knowledge-point/_questions [{:db/id #edb/ref 17592186138537 :knowledge-point/id #uuid "32daa2fb-e5fa-5e44-b6f2-5d815d9145af" :knowledge-point/title "Identifying \"Or\" Inequalities Given on Number Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f884cbed-e942-5458-b509-5ef52cf124ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186533748}] :answer-field/correct {:answer/id #uuid "f884cbed-e942-5458-b509-5ef52cf124ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186533748} :answer-field/id #uuid "846433e8-6e1d-515f-aa50-49417beb1847" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186533880} {:answer-field/choices [{:answer/id #uuid "e6772599-5098-5df2-a83a-02ac5400c6dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186533707}] :answer-field/correct {:answer/id #uuid "e6772599-5098-5df2-a83a-02ac5400c6dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186533707} :answer-field/id #uuid "9ef4eccd-b77f-5147-9424-093fafb1f473" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186533900}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e4c36616-a95f-51f2-89f5-60b31bb5cb88" :question/math-academy-id "q-181316" :question/problem "![](images/c4/c4b96cbe8ea09940b84c1d9d03fc55bdb82c61388bfb66d99cc7c6abd847a1fd.png)\n\nThe inequality corresponding to the highlighted region shown above is $x${{field-1}}\n$-3\\text{ or }x$\n{{field-2}}$1.$" :question/worked-solution "The red rays contain all values less than $-3,$ or greater than $1.$ In addition, \n\n- the closed circle at $-3$ implies that $x$ can be equal to $-3,$ and\n\n- the open circle at $1$ implies that $x$ cannot be equal to $1.$\n\nTherefore, the highlighted region represents $x\\le -3$ or $x>1.$"}] [{:db/id #edb/ref 17592186533980 :knowledge-point/_questions [{:db/id #edb/ref 17592186119960 :knowledge-point/id #uuid "4b9e5026-ab54-5f35-a8da-b647c0f68c1e" :knowledge-point/title "Finding the Cube Root of a Negative Perfect Cube"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e088514-199a-567e-82fa-8f6660eeb0c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186533402}] :answer-field/correct {:answer/id #uuid "6e088514-199a-567e-82fa-8f6660eeb0c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186533402} :answer-field/id #uuid "f6d9b3c0-3abe-5e9b-971f-c0fb9407dba7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186533961}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "15f99678-56db-56d3-a971-804057202f02" :question/math-academy-id "q-186161" :question/problem "Evaluate the following:\n\n$\\sqrt[3]{-1,000}=$\n{{field-1}}" :question/worked-solution "First, notice that the number $-1,000$ is a perfect cube.\n\nSo, to determine the value of $\\sqrt[3]{-1,000},$ we express $-1,000$ as a perfect cube:\n\n$$\n\\begin{aligned}\\sqrt[3]{-1,000} & = \\\\ \\sqrt[3]{(-10)\\cdot (-10)\\cdot (-10)} & = \\\\ \\sqrt[3]{(-10)^{3}} & = \\\\ -10 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186533991 :knowledge-point/_questions [{:db/id #edb/ref 17592186073896 :knowledge-point/id #uuid "60021495-9d2a-58a5-9321-bb16013bbba7" :knowledge-point/title "Filling a Ratio Table by Multiplying and Dividing"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01f11c58-0e5c-5a4e-97bf-ac4e376a8081" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186533133}] :answer-field/correct {:answer/id #uuid "01f11c58-0e5c-5a4e-97bf-ac4e376a8081" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186533133} :answer-field/id #uuid "15e10b26-4030-53ed-ab51-362142804b18" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186533795} {:answer-field/choices [{:answer/id #uuid "d44df9e2-b2da-59ea-baa5-21bdd925757e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186533657}] :answer-field/correct {:answer/id #uuid "d44df9e2-b2da-59ea-baa5-21bdd925757e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186533657} :answer-field/id #uuid "3a436e5e-a9bf-5f9f-964b-11b2e975c97d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186533829}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "35308452-763c-5cea-932c-69c3b89da098" :question/math-academy-id "q-187260" :question/problem "Complete the ratio table below.\n\n| $2$ | {{field-1}} |\n| --- | --- |\n| $4$ | $6$ |\n| {{field-2}} | $18$ |" :question/worked-solution "We start with the ratio $4:6$ and write it as a fraction:\n\n$$\n\\frac{4}{6}\n$$\n\nSo the numerator represents the left-hand entry ($4$), and the denominator represents the right-hand entry ($6$).\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n- To create a numerator of $2,$ we divide the numerator and denominator of our fraction by $2:$\n\n$$\n\\begin{aligned}\\frac{4÷2}{6÷2}=\\frac{2}{3}\\end{aligned}\n$$\n\n- To create a denominator of $18,$ we multiply the numerator and denominator of the previous fraction by $6:$\n\n$$\n\\begin{aligned}\\frac{2\\times 6}{3\\times 6} & =\\frac{12}{18}\\end{aligned}\n$$\n\nFinally, we fill in the ratio table:\n\n| $2$ | $3$ |\n| --- | --- |\n| $4$ | $6$ |\n| $12$ | $18$ |\n\n$$\n\n$$"}] [{:db/id #edb/ref 17592186534011 :knowledge-point/_questions [{:db/id #edb/ref 17592186152296 :knowledge-point/id #uuid "f90ea994-79f2-5409-bf96-306803b4ef01" :knowledge-point/title "Applying a Percentage Increase: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52d40fbd-2937-5786-bc51-a9470c22a888" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "38,\\,500" :db/id #edb/ref 17592186533337} {:answer/id #uuid "93e57907-9f82-5abe-8706-9554411efdb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "39,\\,000" :db/id #edb/ref 17592186533495} {:answer/id #uuid "ae391f5f-e535-5747-b4b8-4b5ea2b48a2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "37,\\,800" :db/id #edb/ref 17592186533557} {:answer/id #uuid "def4830e-58b5-51ac-bf9e-18e4e7963563" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "37,\\,000" :db/id #edb/ref 17592186533687} {:answer/id #uuid "f30845c8-394b-56c3-81cf-79bedea33af1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36,\\,500" :db/id #edb/ref 17592186533737}] :answer-field/correct {:answer/id #uuid "ae391f5f-e535-5747-b4b8-4b5ea2b48a2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "37,\\,800" :db/id #edb/ref 17592186533557} :answer-field/id #uuid "44d37873-44a7-53bb-92db-059de13aaea6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186533835}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5e32c9fa-0237-548e-8a15-6b3954405e5d" :question/math-academy-id "q-326521" :question/problem "There were approximately $28,\\,000$ factory jobs in the city in $2020.$  Economic forecasts predict that this number will grow by $35%$ by the year $2030.$  Which of the following is closest to the projected number of factory jobs in $2030?$" :question/worked-solution "To find the projected number of jobs in $2030,$ we apply a $35%$ increase to the $2020$ figure.\n\nIncreasing by $35%$ means that we must apply a new percentage of\n\n$$\n100%+35%=135%.\n$$\n\nWe begin by converting the percentage to a decimal:\n\n$$\n135%=\\frac{135}{100}=1.35\n$$\n\nFinally, we compute the new value by multiplying the original amount by $1.35:$\n\n$$\n28,\\,000\\times 1.35=37,\\,800\n$$\n\nTherefore, the projected number of factory jobs in $2030$ is $37,\\,800.$"}] [{:db/id #edb/ref 17592186534064 :knowledge-point/_questions [{:db/id #edb/ref 17592186054688 :knowledge-point/id #uuid "01ac1e8c-128c-5c13-b845-105092ae74d6" :knowledge-point/title "Finding the Greatest Common Factor of Two Variable Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d096e1f-d403-5074-b33d-861d3208db29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5z" :db/id #edb/ref 17592186533171} {:answer/id #uuid "3f424f7c-b371-573b-b654-2484dcfec880" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10z" :db/id #edb/ref 17592186533287} {:answer/id #uuid "68029331-733e-5701-95a2-1ae8b399e78e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186533384} {:answer/id #uuid "93e76787-2539-53ca-946b-f238f8a4eaa2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z" :db/id #edb/ref 17592186533496} {:answer/id #uuid "ae3ddc69-bfec-56c2-ab78-f46921b4a9bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186533558}] :answer-field/correct {:answer/id #uuid "0d096e1f-d403-5074-b33d-861d3208db29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5z" :db/id #edb/ref 17592186533171} :answer-field/id #uuid "39625f50-3002-571f-898f-be2df7b96b67" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186533827}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c5f9c923-65fd-50b8-8fc2-266d6f6aaf68" :question/math-academy-id "q-359057" :question/problem "Find the greatest common factor of the terms $25z$ and $10z.$" :question/worked-solution "To find the GCF, we list the factors of the coefficients and identify any common variable factors in the expressions.\n\nThe factors of $25$ are\n\n$$\n1,\\,5,\\,25.\n$$\n\nThe factors of $10$ are\n\n$$\n1,\\,2,\\,5,\\,10.\n$$\n\nThe common factors of $25$ and $10$ are\n\n$$\n1,\\,5.\n$$\n\nThe greatest of these common factors is $5.$\n\nNow we look at the variable factors. Both $25z$ and $10z$ contain $z.$\n\nThus, the greatest common factor of $25z$ and $10z$ is $5z.$"}] [{:db/id #edb/ref 17592186534056 :knowledge-point/_questions [{:db/id #edb/ref 17592186073885 :knowledge-point/id #uuid "309e24a1-6c8c-5705-beca-001fed696acc" :knowledge-point/title "Determining a Ratio From a Graph: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40f230c7-cc08-501f-871e-4e5e7ab14dfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4:1" :db/id #edb/ref 17592186533290} {:answer/id #uuid "5e6fc0dd-5148-5e39-a2ad-eec06de00b38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3:1" :db/id #edb/ref 17592186533357} {:answer/id #uuid "740f6103-8614-52d1-9118-629ed12e15e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1:4" :db/id #edb/ref 17592186533415} {:answer/id #uuid "dbe3e1e4-034c-5deb-928b-54a12e7789ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4:3" :db/id #edb/ref 17592186533676} {:answer/id #uuid "eec5ef68-1664-57b4-92d4-0ce802cf7911" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1:3" :db/id #edb/ref 17592186533724}] :answer-field/correct {:answer/id #uuid "40f230c7-cc08-501f-871e-4e5e7ab14dfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4:1" :db/id #edb/ref 17592186533290} :answer-field/id #uuid "0ffde6de-d8c6-5fc9-81ca-8ebe53a5d344" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186533786}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bad718eb-7fd4-52e5-a648-56b0a89dfa07" :question/math-academy-id "q-93111" :question/problem "![](images/2c/2c4f090ff980be893416857fde0665bce955cee19f6a9dd7634039cbbcc641b6.png)\n\nAlex is making concrete using crushed stone and cement. The amount of cement he needs for a given amount of crushed stone is shown above. What is the ratio of crushed stone to cement in its simplest form?" :question/worked-solution "One of the points belonging to the graph is $(60,15).$ Let's write the ratio $60:15$ as a fraction:\n\n$$\n\\frac{60}{15}\n$$\n\nWe can simplify this fraction by dividing both the numerator and the denominator by $15:$\n\n$$\n\\frac{60÷15}{15÷15}=\\frac{4}{1}\n$$\n\nSo the ratio of crushed stone to cement is $4:1.$"}]}
