#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186545893} :activity/id #uuid "cb755fe1-f021-5168-bebe-a89f6fa1d42e" :activity/steps [{:db/id #edb/ref 17592186545891 :step/content {:db/id #edb/ref 17592186533991 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01f11c58-0e5c-5a4e-97bf-ac4e376a8081" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186533133}] :answer-field/correct {:db/id #edb/ref 17592186533133} :answer-field/id #uuid "15e10b26-4030-53ed-ab51-362142804b18" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186533795} {:answer-field/choices [{:answer/id #uuid "d44df9e2-b2da-59ea-baa5-21bdd925757e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186533657}] :answer-field/correct {:db/id #edb/ref 17592186533657} :answer-field/id #uuid "3a436e5e-a9bf-5f9f-964b-11b2e975c97d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186533829}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "35308452-763c-5cea-932c-69c3b89da098" :question/math-academy-id "q-187260" :question/problem "Complete the ratio table below.\n\n| $2$ | {{field-1}} |\n| --- | --- |\n| $4$ | $6$ |\n| {{field-2}} | $18$ |" :question/worked-solution "We start with the ratio $4:6$ and write it as a fraction:\n\n$$\n\\frac{4}{6}\n$$\n\nSo the numerator represents the left-hand entry ($4$), and the denominator represents the right-hand entry ($6$).\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n- To create a numerator of $2,$ we divide the numerator and denominator of our fraction by $2:$\n\n$$\n\\begin{aligned}\\frac{4÷2}{6÷2}=\\frac{2}{3}\\end{aligned}\n$$\n\n- To create a denominator of $18,$ we multiply the numerator and denominator of the previous fraction by $6:$\n\n$$\n\\begin{aligned}\\frac{2\\times 6}{3\\times 6} & =\\frac{12}{18}\\end{aligned}\n$$\n\nFinally, we fill in the ratio table:\n\n| $2$ | $3$ |\n| --- | --- |\n| $4$ | $6$ |\n| $12$ | $18$ |\n\n$$\n\n$$"} :step/id #uuid "1353d738-7b7f-55db-a226-b3f2ae72c15a" :step/next {:db/id #edb/ref 17592186545912}} {:db/id #edb/ref 17592186545893 :step/content {:db/id #edb/ref 17592186534064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d096e1f-d403-5074-b33d-861d3208db29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5z" :db/id #edb/ref 17592186533171} {:answer/id #uuid "3f424f7c-b371-573b-b654-2484dcfec880" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10z" :db/id #edb/ref 17592186533287} {:answer/id #uuid "68029331-733e-5701-95a2-1ae8b399e78e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186533384} {:answer/id #uuid "93e76787-2539-53ca-946b-f238f8a4eaa2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z" :db/id #edb/ref 17592186533496} {:answer/id #uuid "ae3ddc69-bfec-56c2-ab78-f46921b4a9bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186533558}] :answer-field/correct {:db/id #edb/ref 17592186533171} :answer-field/id #uuid "39625f50-3002-571f-898f-be2df7b96b67" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186533827}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c5f9c923-65fd-50b8-8fc2-266d6f6aaf68" :question/math-academy-id "q-359057" :question/problem "Find the greatest common factor of the terms $25z$ and $10z.$" :question/worked-solution "To find the GCF, we list the factors of the coefficients and identify any common variable factors in the expressions.\n\nThe factors of $25$ are\n\n$$\n1,\\,5,\\,25.\n$$\n\nThe factors of $10$ are\n\n$$\n1,\\,2,\\,5,\\,10.\n$$\n\nThe common factors of $25$ and $10$ are\n\n$$\n1,\\,5.\n$$\n\nThe greatest of these common factors is $5.$\n\nNow we look at the variable factors. Both $25z$ and $10z$ contain $z.$\n\nThus, the greatest common factor of $25z$ and $10z$ is $5z.$"} :step/id #uuid "153eb166-3531-50fe-8719-936a417e97c1" :step/next {:db/id #edb/ref 17592186545986}} {:db/id #edb/ref 17592186545899 :step/content {:db/id #edb/ref 17592186545821 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04640621-f02a-52d2-815f-5bc639b2de01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186545209} {:answer/id #uuid "20b16185-d12a-5e60-bcb5-5871047f9569" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186545264} {:answer/id #uuid "5682a8f0-9627-5c70-87ea-7d47bc48f253" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186545360} {:answer/id #uuid "6ec6fdb1-0f32-56ac-9952-f5cc890af556" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186545408} {:answer/id #uuid "c7ea6629-a518-5ad2-a4e0-fa65bbb22766" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186545563}] :answer-field/correct {:db/id #edb/ref 17592186545209} :answer-field/id #uuid "add93cc1-1ee0-532a-8ce2-54ed8f5fbdab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545756}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5eb05574-37e3-55ae-bfb9-7d07106c577c" :question/math-academy-id "q-160571" :question/problem "What is the distance between the points $(-3,-2)$  and $(-3,-7)?$" :question/worked-solution "**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/fa/fa516432771fd242ed51ba8548dd04ca88991fc14992be811a53f8e124b9ff7d.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $5$ units, so the distance equals $5.$\n\n![](images/99/999cdc70474e5b928b28d611d4c66fb3eeea5716f516af41574712337cb6f9e9.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $x$-axis and then subtracting.\n\n![](images/91/91bd9f4cd88e966b796f97184eee8aa791e2f20301ff700906ded4d4731eaaf7.png)\n\nThe point $(-3,-7)$ is at a distance of $7$ from the $x$-axis, and the point $(-3,-2)$ is at a distance of $2$ from the $x$-axis. Therefore, the distance between the two points is $7-2=5.$"} :step/id #uuid "21de48e5-badc-5642-bc90-55cfd546dad3" :step/next {:db/id #edb/ref 17592186545991}} {:db/id #edb/ref 17592186545912 :step/content {:db/id #edb/ref 17592186545853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40233085-95c2-5cd9-83db-c4b484942aa7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186545321} {:answer/id #uuid "49f5ad18-2cdd-5025-9251-13908c923f88" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186545339} {:answer/id #uuid "80a9f806-ee3b-59bc-a294-0cbd78970b1b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186545435} {:answer/id #uuid "98e55936-6fd1-5e13-ac02-4fb7e44e75f1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186545475} {:answer/id #uuid "f96a3832-d587-5a04-ae3d-7c25d92f958f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186545657}] :answer-field/correct {:db/id #edb/ref 17592186545435} :answer-field/id #uuid "7e001f08-93a9-56c4-8f18-23859cf513f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545729}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bc7ca1bb-54ce-5dca-bfc4-11a992a5eb47" :question/math-academy-id "q-113970" :question/problem "![](images/76/76d3a2d884ab6df8d6b6b97be5d5bac91ab30976ba0a6ef8aacc5f3a30eead6c.png)\n\nConsider the figure shown above. Which of the following triplets of points are collinear?\n\nI. $M,T,N$\n\nII. $S,T,O$\n\nIII. $P,Q,N$" :question/worked-solution "- $M,T,N$ are collinear since there is a straight line that passes through all of them.\n\n![](images/a3/a3574ff790eadbc561d842f7c2b485d055a76f5781da76afbd7fb39e45e7ccf0.png)\n\n- $S,T,O$ are collinear since there is a straight line that passes through all of them.\n\n![](images/4c/4ca9c5bbfc7c0f95a5bc03e6e84102eb362cba63d937a184089584a7c2ad58bf.png)\n\n- $P,Q,N$ are **not** collinear since we can't draw a straight line that passes through all of them.\n\n![](images/6b/6b5e9a5c1e1fa271c93667c35c117b197cec3d5a25e5ac311e77f0021663163d.png)\n\nTherefore, the correct answer is \"I and II only.\""} :step/id #uuid "3c88f808-ff66-53e1-a160-06238f17f29e" :step/next {:db/id #edb/ref 17592186546014}} {:db/id #edb/ref 17592186545920 :step/content {:db/id #edb/ref 17592186533980 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e088514-199a-567e-82fa-8f6660eeb0c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186533402}] :answer-field/correct {:db/id #edb/ref 17592186533402} :answer-field/id #uuid "f6d9b3c0-3abe-5e9b-971f-c0fb9407dba7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186533961}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "15f99678-56db-56d3-a971-804057202f02" :question/math-academy-id "q-186161" :question/problem "Evaluate the following:\n\n$\\sqrt[3]{-1,000}=$\n{{field-1}}" :question/worked-solution "First, notice that the number $-1,000$ is a perfect cube.\n\nSo, to determine the value of $\\sqrt[3]{-1,000},$ we express $-1,000$ as a perfect cube:\n\n$$\n\\begin{aligned}\\sqrt[3]{-1,000} & = \\\\ \\sqrt[3]{(-10)\\cdot (-10)\\cdot (-10)} & = \\\\ \\sqrt[3]{(-10)^{3}} & = \\\\ -10 & \\end{aligned}\n$$"} :step/id #uuid "4cbcf276-c0b8-51a7-83b0-92eb1e62729b" :step/next {:db/id #edb/ref 17592186545954}} {:db/id #edb/ref 17592186545922 :step/content {:db/id #edb/ref 17592186533988 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f33fa7f-86a4-5672-82f4-90c12943702f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-30" :db/id #edb/ref 17592186533214}] :answer-field/correct {:db/id #edb/ref 17592186533214} :answer-field/id #uuid "3c6617d4-5306-575e-8610-98ba6a3acfd0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186533830}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2c77dd09-2d15-50f1-838b-9b9dd6ed6be5" :question/math-academy-id "q-178541" :question/problem "The additive inverse of $30$ is{{field-1}}." :question/worked-solution "To find the additive inverse of the number $30$, we change its sign by placing a minus symbol $(-)$ in front of it. So, we obtain \n\n$$\n-\\,(30)=-30.\n$$\n\nTo check our work, we simply add the inverse to the original number. If we're correct, we should get zero.\n\n$$\n30+(-30)=30-30=0\\,✓\n$$"} :step/id #uuid "50f48358-eab5-595d-8a85-505c73305e38" :step/next {:db/id #edb/ref 17592186545920}} {:db/id #edb/ref 17592186545929 :step/content {:db/id #edb/ref 17592186545801 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a7dce17-7be1-56eb-a50a-a76695d8a7f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186545253} {:answer/id #uuid "2302e26d-bd2a-5b1a-8f7a-69798b8f6993" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186545273} {:answer/id #uuid "5341034a-5c70-550f-94f0-6292fdc42b66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186545355} {:answer/id #uuid "a7772d20-a081-52a3-96c2-6ccd8c426e27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "100" :db/id #edb/ref 17592186545508} {:answer/id #uuid "c6a11e57-9c69-5b62-be44-f709d7198d5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{100}" :db/id #edb/ref 17592186545557}] :answer-field/correct {:db/id #edb/ref 17592186545273} :answer-field/id #uuid "e6aa17b9-5d07-5942-b17f-d9ecdeadf17f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545779}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "13009f1d-d35d-5b85-be9b-7aed8c27ac84" :question/math-academy-id "q-43203" :question/problem "${0}^{100}=$" :question/worked-solution "The expression ${0}^{100}$ means $0$ multiplied by itself $100$ times. So, since $0$ times any number is $0$,  we have ${0}^{100}=0.$"} :step/id #uuid "5e2312dc-1f31-5a00-91bb-f7fe108e7029" :step/next {:db/id #edb/ref 17592186545990}} {:db/id #edb/ref 17592186545954 :step/content {:db/id #edb/ref 17592186534083 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f884cbed-e942-5458-b509-5ef52cf124ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value ">" :db/id #edb/ref 17592186533748}] :answer-field/correct {:db/id #edb/ref 17592186533748} :answer-field/id #uuid "846433e8-6e1d-515f-aa50-49417beb1847" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186533880} {:answer-field/choices [{:answer/id #uuid "e6772599-5098-5df2-a83a-02ac5400c6dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le" :db/id #edb/ref 17592186533707}] :answer-field/correct {:db/id #edb/ref 17592186533707} :answer-field/id #uuid "9ef4eccd-b77f-5147-9424-093fafb1f473" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186533900}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e4c36616-a95f-51f2-89f5-60b31bb5cb88" :question/math-academy-id "q-181316" :question/problem "![](images/c4/c4b96cbe8ea09940b84c1d9d03fc55bdb82c61388bfb66d99cc7c6abd847a1fd.png)\n\nThe inequality corresponding to the highlighted region shown above is $x${{field-1}}\n$-3\\text{ or }x$\n{{field-2}}$1.$" :question/worked-solution "The red rays contain all values less than $-3,$ or greater than $1.$ In addition, \n\n- the closed circle at $-3$ implies that $x$ can be equal to $-3,$ and\n\n- the open circle at $1$ implies that $x$ cannot be equal to $1.$\n\nTherefore, the highlighted region represents $x\\le -3$ or $x>1.$"} :step/id #uuid "99b610af-c9ed-5f8d-85f4-6023075cc1f2" :step/next {:db/id #edb/ref 17592186545929}} {:db/id #edb/ref 17592186545963 :step/content {:db/id #edb/ref 17592186533990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00d2ca87-06b5-5f73-a7a2-0d924de094ee" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "quadratic monomial" :db/id #edb/ref 17592186533130} {:answer/id #uuid "1be57fd3-5b10-52bd-9852-c6f7411b7f55" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "linear binomial" :db/id #edb/ref 17592186533205} {:answer/id #uuid "28fabcc4-4d05-51ac-a912-143729df6bdf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "linear monomial" :db/id #edb/ref 17592186533243} {:answer/id #uuid "3b8222ef-3b82-5715-9c8a-28e90a679db9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "cubic monomial" :db/id #edb/ref 17592186533279} {:answer/id #uuid "8b0e746a-0ea4-5fe0-96a8-19184993385d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "quartic trinomial" :db/id #edb/ref 17592186533474}] :answer-field/correct {:db/id #edb/ref 17592186533243} :answer-field/id #uuid "f60f859d-bc35-5505-9e52-c51c8f4b4755" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186533960}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "320d3413-9845-54f4-9740-6e67695ad26e" :question/math-academy-id "q-111226" :question/problem "Classify the polynomial $-\\frac{2t}{5}$ according to its degree and the number of terms." :question/worked-solution "The polynomial $-\\frac{2t}{5}$ has only one term, so it is a monomial.\n\nAlso, its degree is $1,$ so it is a linear.\n\nTherefore, the polynomial is a linear monomial."} :step/id #uuid "aa815306-5c99-5767-8735-586771e9b3e1" :step/next {:db/id #edb/ref 17592186545979}} {:db/id #edb/ref 17592186545979 :step/content {:db/id #edb/ref 17592186534056 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40f230c7-cc08-501f-871e-4e5e7ab14dfc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4:1" :db/id #edb/ref 17592186533290} {:answer/id #uuid "5e6fc0dd-5148-5e39-a2ad-eec06de00b38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3:1" :db/id #edb/ref 17592186533357} {:answer/id #uuid "740f6103-8614-52d1-9118-629ed12e15e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1:4" :db/id #edb/ref 17592186533415} {:answer/id #uuid "dbe3e1e4-034c-5deb-928b-54a12e7789ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4:3" :db/id #edb/ref 17592186533676} {:answer/id #uuid "eec5ef68-1664-57b4-92d4-0ce802cf7911" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1:3" :db/id #edb/ref 17592186533724}] :answer-field/correct {:db/id #edb/ref 17592186533290} :answer-field/id #uuid "0ffde6de-d8c6-5fc9-81ca-8ebe53a5d344" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186533786}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "bad718eb-7fd4-52e5-a648-56b0a89dfa07" :question/math-academy-id "q-93111" :question/problem "![](images/2c/2c4f090ff980be893416857fde0665bce955cee19f6a9dd7634039cbbcc641b6.png)\n\nAlex is making concrete using crushed stone and cement. The amount of cement he needs for a given amount of crushed stone is shown above. What is the ratio of crushed stone to cement in its simplest form?" :question/worked-solution "One of the points belonging to the graph is $(60,15).$ Let's write the ratio $60:15$ as a fraction:\n\n$$\n\\frac{60}{15}\n$$\n\nWe can simplify this fraction by dividing both the numerator and the denominator by $15:$\n\n$$\n\\frac{60÷15}{15÷15}=\\frac{4}{1}\n$$\n\nSo the ratio of crushed stone to cement is $4:1.$"} :step/id #uuid "c4ab8172-166b-55dc-b93d-118d53c74a30" :step/next {:db/id #edb/ref 17592186545922}} {:db/id #edb/ref 17592186545980 :step/content {:db/id #edb/ref 17592186545809 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "216d110f-847a-5b69-9e31-8e3a0ce8d7a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186545267} {:answer/id #uuid "39470c07-8ce8-5c68-bb18-be40a100cd55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "125" :db/id #edb/ref 17592186545314} {:answer/id #uuid "83167b0c-ba8f-53d2-ade9-b0960c1f0490" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "65" :db/id #edb/ref 17592186545445} {:answer/id #uuid "9b8e4b50-8864-5871-ac63-0f3f0ede7b14" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "625" :db/id #edb/ref 17592186545480} {:answer/id #uuid "facb0487-8351-5966-9021-68a9b16352cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186545663}] :answer-field/correct {:db/id #edb/ref 17592186545480} :answer-field/id #uuid "87a7fad8-7a4a-5590-aee9-fef36d2bdf2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545734}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2b01d068-301b-53f3-a201-6640d9320d3d" :question/math-academy-id "q-99141" :question/problem "What is $\\sqrt{{(-625)}^{2}}?$" :question/worked-solution "Remember that by definition, the square root is always zero or positive, never negative.\n\nSo, the square root comes out to\n\n$$\n\\sqrt{(-625)^{2}}=\\sqrt{{625}^{2}}=625.\n$$"} :step/id #uuid "c5e9f69e-0437-592f-9c7b-28a70bb26371"} {:db/id #edb/ref 17592186545986 :step/content {:db/id #edb/ref 17592186534011 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52d40fbd-2937-5786-bc51-a9470c22a888" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "38,\\,500" :db/id #edb/ref 17592186533337} {:answer/id #uuid "93e57907-9f82-5abe-8706-9554411efdb2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "39,\\,000" :db/id #edb/ref 17592186533495} {:answer/id #uuid "ae391f5f-e535-5747-b4b8-4b5ea2b48a2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "37,\\,800" :db/id #edb/ref 17592186533557} {:answer/id #uuid "def4830e-58b5-51ac-bf9e-18e4e7963563" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "37,\\,000" :db/id #edb/ref 17592186533687} {:answer/id #uuid "f30845c8-394b-56c3-81cf-79bedea33af1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36,\\,500" :db/id #edb/ref 17592186533737}] :answer-field/correct {:db/id #edb/ref 17592186533557} :answer-field/id #uuid "44d37873-44a7-53bb-92db-059de13aaea6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186533835}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5e32c9fa-0237-548e-8a15-6b3954405e5d" :question/math-academy-id "q-326521" :question/problem "There were approximately $28,\\,000$ factory jobs in the city in $2020.$  Economic forecasts predict that this number will grow by $35%$ by the year $2030.$  Which of the following is closest to the projected number of factory jobs in $2030?$" :question/worked-solution "To find the projected number of jobs in $2030,$ we apply a $35%$ increase to the $2020$ figure.\n\nIncreasing by $35%$ means that we must apply a new percentage of\n\n$$\n100%+35%=135%.\n$$\n\nWe begin by converting the percentage to a decimal:\n\n$$\n135%=\\frac{135}{100}=1.35\n$$\n\nFinally, we compute the new value by multiplying the original amount by $1.35:$\n\n$$\n28,\\,000\\times 1.35=37,\\,800\n$$\n\nTherefore, the projected number of factory jobs in $2030$ is $37,\\,800.$"} :step/id #uuid "c8ebb790-d811-58d4-adb7-c074b9eb0f35" :step/next {:db/id #edb/ref 17592186545963}} {:db/id #edb/ref 17592186545990 :step/content {:db/id #edb/ref 17592186545834 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b4c0eac-fa86-5d0f-ad29-b94003d62802" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186545291} {:answer/id #uuid "420c0d71-22fb-505e-a0b4-2f90923da981" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$Q$ only" :db/id #edb/ref 17592186545322} {:answer/id #uuid "80c55bb3-f653-5ace-a8e5-59f8dbbafd16" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$R$ and $S$ only" :db/id #edb/ref 17592186545436} {:answer/id #uuid "9e42fe38-c8a4-5465-9eb5-cccda24add7f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$P$ only" :db/id #edb/ref 17592186545490} {:answer/id #uuid "a5d573c3-b1be-58e8-aa91-45870582e400" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$P$, $Q$ and $S$ only" :db/id #edb/ref 17592186545504}] :answer-field/correct {:db/id #edb/ref 17592186545291} :answer-field/id #uuid "6b40255b-02ed-5f18-a9b0-bc40a8de74f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545718}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8e575533-586b-5027-be32-c520f60008c9" :question/math-academy-id "q-53034" :question/problem "![](images/cd/cd63e1c0cc60e53240ad8e064add8bd7c4d2abb1971de69a10b8f414b9c92fc8.png)\n\nWhich of the figures above is a square?" :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nRemember that a square is a quadrilateral where all angles are right and all sides are congruent.\n\nWith that in mind, let's look at each shape in turn.\n\n- The shape $P$ is a rhombus. Its four sides are congruent, however, it has no right angle. Therefore, it is not a square.\n\n- The shape $Q$ is a trapezoid. The sides are not all congruent, so it is not a square.\n\n- The shape $R$ is a kite. Since the sides are not all congruent, it is not a square.\n\n- The shape $S$ is an isosceles trapezoid. It has sides that are not congruent, therefore, it is not a square.\n\nTherefore, none of the shapes is a square."} :step/id #uuid "d0c8c0a6-568d-54ea-a85b-3d20545386a2" :step/next {:db/id #edb/ref 17592186545996}} {:db/id #edb/ref 17592186545991 :step/content {:db/id #edb/ref 17592186545863 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63aa871a-93a5-5c36-9c9a-76ba1c274a73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-18" :db/id #edb/ref 17592186545388} {:answer/id #uuid "749083c7-26de-5ae7-bf3e-e7630c8e5ed6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186545419} {:answer/id #uuid "84f2df2e-c8e4-5015-bf0d-98a941c09f94" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186545451} {:answer/id #uuid "bb8ca89a-2ce8-591a-84d7-697b0563c5b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186545540} {:answer/id #uuid "df698356-11c2-5c0e-8f6e-0864adcd0f5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186545612}] :answer-field/correct {:db/id #edb/ref 17592186545612} :answer-field/id #uuid "0459262a-2257-5a6c-8f05-5a7eb2664614" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545676}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d99374cc-b8d8-56af-8d1d-9419fba84ed0" :question/math-academy-id "q-162123" :question/problem "What is the missing part of the expression below?\n\n$$\n-\\frac{9}{2}=\\frac{\\bbox[1pt,border:1pt solid black]{\\phantom{A}}}{2}\n$$" :question/worked-solution "A negative number can be obtained if we divide two numbers, one of which is positive and the other negative.\n\nSo, given a negative fraction, we have the following equivalent notations:\n\n$$\n-\\frac{9}{2}=\\frac{-9}{2}=\\frac{9}{-2}\n$$\n\nIn our case, we see that the denominator on the right-hand side is positive $(2).$ Therefore, the missing numerator must be $(-9):$\n\n$$\n-\\frac{9}{2}=\\frac{-9}{2}\n$$"} :step/id #uuid "d0d4f92c-c34a-5a51-b6fc-212e77de1ce9" :step/next {:db/id #edb/ref 17592186545891}} {:db/id #edb/ref 17592186545995 :step/content {:db/id #edb/ref 17592186545797 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18a2d47a-16f9-5f20-965d-a5f641df63a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4w+2" :db/id #edb/ref 17592186545246} {:answer/id #uuid "598d8397-1bcc-55e6-83d4-fd23a9fcb0a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4w-2" :db/id #edb/ref 17592186545372} {:answer/id #uuid "5a360901-ef6f-58c6-a8a1-0c7767bb6cd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2w-2" :db/id #edb/ref 17592186545373} {:answer/id #uuid "aabbc28d-6e91-53a6-a84c-7c716a82a12e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "w-2" :db/id #edb/ref 17592186545514} {:answer/id #uuid "d825af07-747a-5ab9-93a0-29fe92242bb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2w+2" :db/id #edb/ref 17592186545595}] :answer-field/correct {:db/id #edb/ref 17592186545595} :answer-field/id #uuid "85b82977-148c-568c-9d3c-62ddc142d73e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545733}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0943c573-bd9d-551a-bfee-908fd709f4d5" :question/math-academy-id "q-144238" :question/problem "Simplify the expression $3w-(w-2).$" :question/worked-solution "First, we remove the parentheses by distributing the negative sign. This gives\n\n$$\n3w-w+2\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}3w-w+2 & = \\\\ (3w-w)+2 & = \\\\ 2w+2 & \\end{aligned}\n$$"} :step/id #uuid "d981ac4c-dd89-5315-961e-a29612d31d43" :step/next {:db/id #edb/ref 17592186545980}} {:db/id #edb/ref 17592186545996 :step/content {:db/id #edb/ref 17592186233078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "262707e8-a17c-59ce-971e-969d38b738cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6x-3" :db/id #edb/ref 17592186545282} {:answer/id #uuid "5239f06a-9c88-5796-bad4-dd01e0598425" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18x-2" :db/id #edb/ref 17592186545351} {:answer/id #uuid "80d1efc3-9f36-58cd-8661-fa04801b6e5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9x-3" :db/id #edb/ref 17592186545437} {:answer/id #uuid "828b3fdb-edff-5b38-88e4-936da5ad6e9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-6" :db/id #edb/ref 17592186545444} {:answer/id #uuid "9bdf722e-820e-5637-ba90-106a58a4e7cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6x-2" :db/id #edb/ref 17592186545484}] :answer-field/correct {:db/id #edb/ref 17592186545484} :answer-field/id #uuid "54fc702b-edd1-54aa-8ad1-69534578dde9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545708}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5277b0dd-a1ab-523e-8996-74d7092ca199" :question/math-academy-id "q-103615" :question/problem "Which of the following is equivalent to $\\frac{18x-6}{3}?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in individual terms, we get\n\n$$\n\\begin{aligned}\\frac{18x-6}{3} & = \\\\ \\frac{18x}{3}-\\frac{6}{3} & = \\\\ \\frac{18}{3}\\cdot x-\\frac{6}{3} & = \\\\ 6\\cdot x-2 & = \\\\ 6x-2. & \\end{aligned}\n$$"} :step/id #uuid "db4ba12d-7196-5d9c-bad4-7610c63e9b11" :step/next {:db/id #edb/ref 17592186545899}} {:db/id #edb/ref 17592186546014 :step/content {:db/id #edb/ref 17592186545824 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "357ea24f-fa4c-5790-b1a5-9e394835b87e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "85%" :db/id #edb/ref 17592186545308} {:answer/id #uuid "5e15333f-ca67-51f6-8a8d-94a10e15cd8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "75%" :db/id #edb/ref 17592186545379} {:answer/id #uuid "aa5270cf-8c99-5258-865a-b4060d413346" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "80%" :db/id #edb/ref 17592186545513} {:answer/id #uuid "be3b0c24-e0bc-506c-9198-80272d7ce629" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "70%" :db/id #edb/ref 17592186545547} {:answer/id #uuid "d0e81f18-8cc4-5e74-904b-b57c090b0e0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "60%" :db/id #edb/ref 17592186545578}] :answer-field/correct {:db/id #edb/ref 17592186545547} :answer-field/id #uuid "50ca2ce7-e417-59bb-aca3-04e72dab4b49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545705}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "65844bd9-30e0-51e9-84e5-199c9f665392" :question/math-academy-id "q-93124" :question/problem "A tank with a capacity of $2\\,000$ liters is filled with $1\\,400$ liters of water. What percentage of the tank is filled with water?" :question/worked-solution "We're given a part and a whole, and we must find a percentage. So, we can use the following formula:\n\n$$\n\\text{percentage}=\\text{part}÷\\text{whole}\n$$\n\nIn this case, \n\n- the part is the amount of water, which is $1\\,400$ liters, and\n\n- the whole is the capacity of the tank, which is $2\\,000$ liters.\n\nSubstituting our numbers into the above formula, we get\n\n$$\n\\text{percentage}=1\\,400÷2\\,000=\\frac{14}{20}.\n$$\n\nTo write this as a percentage, we create an equivalent fraction with $100$ as the denominator:\n\n$$\n\\frac{14}{20}=\\frac{14\\times 5}{20\\times 5}=\\frac{70}{100}\n$$\n\nNow we can write this fraction as a percentage:\n\n$$\n\\frac{70}{100}=70%\n$$\n\nTherefore, $70%$ of the tank is filled with water."} :step/id #uuid "f5328551-d2f3-58a1-bf37-31e8f30f1b2c" :step/next {:db/id #edb/ref 17592186545995}}] :activity/title "Quiz 8" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186545194}]}
