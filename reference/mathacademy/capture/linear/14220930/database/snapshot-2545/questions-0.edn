#{[{:db/id #edb/ref 17592186233078 :knowledge-point/_questions [{:db/id #edb/ref 17592186064257 :knowledge-point/id #uuid "724bdf2f-c9f0-564e-ae33-c64d44c582ef" :knowledge-point/title "Splitting a Rational Expression With Two Terms in the Numerator"}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5277b0dd-a1ab-523e-8996-74d7092ca199" :question/math-academy-id "q-103615" :question/problem "Which of the following is equivalent to $\\frac{18x-6}{3}?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in individual terms, we get\n\n$$\n\\begin{aligned}\\frac{18x-6}{3} & = \\\\ \\frac{18x}{3}-\\frac{6}{3} & = \\\\ \\frac{18}{3}\\cdot x-\\frac{6}{3} & = \\\\ 6\\cdot x-2 & = \\\\ 6x-2. & \\end{aligned}\n$$"}]}
