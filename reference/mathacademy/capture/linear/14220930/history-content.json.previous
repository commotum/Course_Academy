      "raw_html": "<div class=\"question\" id=\"question-187260\"><div class=\"questionHeader\"><span class=\"questionNumber\">13.</span><a class=\"questionKP\" href=\"/topics/554#13343\">Filling a Ratio Table by Multiplying and Dividing</a><span class=\"helpButton\" questionid=\"187260\">?</span></div><div class=\"questionText\">Complete the ratio table below.<table align=\"center\" cellpadding=\"5\" font-size=\"inherit\" rules=\"all\" style=\"border: 1px solid black\" width=\"120px\">\n<tbody><tr height=\"40px\">\n<td style=\"text-align:center\" width=\"50%\"> <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"99\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math></mjx-assistive-mml></mjx-container> </td>\n<td style=\"text-align:center\" width=\"50%\">\n<div ;=\"\" class=\"freeResponseTextbox\" id=\"freeResponseTextbox-1\" style=\"min-width:21px;\n                                        margin-left:2px;\n                                        margin-right:2px;\n                                        background:;\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"100\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"></math></mjx-assistive-mml></mjx-container></div>\n</td>\n</tr>\n<tr height=\"40px\">\n<td style=\"text-align:center\" width=\"50%\"> <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"101\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\">