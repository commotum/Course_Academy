    {
      "dom_id": "question-99141",
      "name": null,
      "problem": "What is $\\sqrt{{(-625)}^{2}}?$",
      "worked_solution": "Remember that by definition, the square root is always zero or positive, never negative.\n\nSo, the square root comes out to\n\n$$\n\\sqrt{(-625)^{2}}=\\sqrt{{625}^{2}}=625.\n$$",
      "calculator_instructions": "",
      "fields": [],
      "problem_field_keys": [],
      "answer_fields_complete": null,
