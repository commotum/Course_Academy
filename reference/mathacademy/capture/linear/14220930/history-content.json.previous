    {
      "dom_id": "question-43203",
      "name": null,
      "problem": "${0}^{100}=$",
      "worked_solution": "The expression ${0}^{100}$ means $0$ multiplied by itself $100$ times. So, since $0$ times any number is $0$,  we have ${0}^{100}=0.$",
