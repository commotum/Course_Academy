#{[{:db/id #edb/ref 17592186087494 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087689 :knowledge-point/id #uuid "4d8c6c93-9d15-5482-8130-25bb9cabf008" :knowledge-point/title "Finding Exact Solutions to Exponential Equations Using the Natural Logarithm"}] :question/id #uuid "5e22ac55-3e84-5cb4-8231-5f882da9240e" :question/math-academy-id "e-4103" :question/problem "What is the value of $x$ if $e^{x - 3}=2^5?$" :question/worked-solution "First, we take the natural logarithm $\\left(\\ln\\right)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{e}^{x-3} & ={2}^{5} \\\\ \\operatorname{ln}⁡({e}^{x-3}) & =\\operatorname{ln}⁡({2}^{5})\\end{aligned}\n$$\n\nNow, we use the fact that $\\ln \\left( e^a \\right) = a$ to simplify the left-hand side. This gives\n\n$$\nx-3 = \\ln \\left( 2^5 \\right).\n$$\n\nFinally, we solve for $x$ and rewrite the right-hand side using the power law of logarithms, as follows:\n\n$$\n\\begin{aligned}x-3 & =\\operatorname{ln}⁡({2}^{5}) \\\\ x & =\\operatorname{ln}⁡({2}^{5})+3 \\\\ x & =5\\operatorname{ln}⁡(2)+3\\end{aligned}\n$$\n\nTherefore, the solution is $x=5\\ln (2) + 3.$"}] [{:db/id #edb/ref 17592186087495 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087690 :knowledge-point/id #uuid "765ef63a-e3f0-503b-876d-3b4776b2cafe" :knowledge-point/title "Finding Approximate Solutions to Exponential Equations Using the Natural Logarithm"}] :question/id #uuid "ccf59ef2-a5dd-5a56-9af8-1878376dea16" :question/math-academy-id "e-4104" :question/problem "Find the solution to the equation $e^{2-4x} = 2$ rounded to $3$ decimal places." :question/worked-solution "First, we take the natural logarithm $(\\ln)$ of both sides of the equation and solve for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}{e}^{2-4x} & =2 \\\\ \\operatorname{ln}⁡({e}^{2-4x}) & =\\operatorname{ln}⁡(2) \\\\ 2-4x & =\\operatorname{ln}⁡(2) \\\\ -4x & =\\operatorname{ln}⁡(2)-2 \\\\ x & =\\frac{1}{2}-\\frac{\\operatorname{ln}⁡(2)}{4}\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nx  \\approx 0.327\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186087496 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087691 :knowledge-point/id #uuid "10095048-0db6-5b4e-889f-303f07449367" :knowledge-point/title "Finding Solutions to Exponential Equations when Rearrangement is Required"}] :question/id #uuid "12eedc57-11a6-540c-bdc9-bf5df777de60" :question/math-academy-id "e-4105" :question/problem "Given that $e^{x+1} + 1 = 3,$ what is the value of $x$?" :question/worked-solution "First, we isolate the exponential, as follows:\n\n$$\n\\begin{aligned}{e}^{x+1}+1 & =3 \\\\ {e}^{x+1} & =2\\end{aligned}\n$$\n\nThen, we find the natural logarithm $\\left(\\ln\\right)$ of both sides of the equation and solve for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}{e}^{x+1} & =2 \\\\ \\operatorname{ln}⁡({e}^{x+1}) & =\\operatorname{ln}⁡(2) \\\\ x+1 & =\\operatorname{ln}⁡(2) \\\\ x & =\\operatorname{ln}⁡(2)-1\\end{aligned}\n$$\n\nTherefore, the solution is $x =\\ln\\left(2\\right) -1.$"}] [{:db/id #edb/ref 17592186547056 :knowledge-point/_questions [{:db/id #edb/ref 17592186087689 :knowledge-point/id #uuid "4d8c6c93-9d15-5482-8130-25bb9cabf008" :knowledge-point/title "Finding Exact Solutions to Exponential Equations Using the Natural Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02492c1c-263a-53d5-a2ab-a44b808ad394" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3-\\frac{1}{14}\\operatorname{ln}⁡(7)" :db/id #edb/ref 17592186546257} {:answer/id #uuid "110732bb-df28-569e-8e30-9e1291e4a0dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5+\\frac{1}{7}\\operatorname{ln}⁡(4)" :db/id #edb/ref 17592186546284} {:answer/id #uuid "13714b98-7f8c-58e4-884c-b96dd8f0deff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5-\\frac{1}{4}\\operatorname{ln}⁡(7)" :db/id #edb/ref 17592186546292} {:answer/id #uuid "4066d5e8-82e4-5526-876f-28005ec446fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5-\\frac{1}{4}\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186546398} {:answer/id #uuid "e39eb702-bd3e-5d40-bf2a-84989610b7f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5+\\frac{1}{2}\\operatorname{ln}⁡(7)" :db/id #edb/ref 17592186546758}] :answer-field/correct {:answer/id #uuid "13714b98-7f8c-58e4-884c-b96dd8f0deff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5-\\frac{1}{4}\\operatorname{ln}⁡(7)" :db/id #edb/ref 17592186546292} :answer-field/id #uuid "a12fa105-d919-568d-aa42-9d5dd1b4d2a4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186546898}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d0fb4c30-2477-5421-b3da-f8a97304168e" :question/math-academy-id "q-100276" :question/problem "What is the value of $y$ if ${e}^{5-y}=\\sqrt[4]{7}?$" :question/worked-solution "First, we find the natural logarithm $(ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{e}^{5-y} & =\\sqrt[4]{7} \\\\ \\operatorname{ln}⁡({e}^{5-y}) & =\\operatorname{ln}⁡(\\sqrt[4]{7})\\end{aligned}\n$$\n\nNow, we use the fact that $\\operatorname{ln}⁡({e}^{a})=a$ to simplify the left-hand side. This gives:\n\n$$\n5-y=\\operatorname{ln}⁡(\\sqrt[4]{7})\n$$\n\nNext, we write $\\sqrt[4]{7}$ as ${7}^{1/4}.$ So, we get:\n\n$$\n5-y=\\operatorname{ln}⁡({7}^{1/4})\n$$\n\nFinally, we rewrite the right-hand side using power law of logarithms and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}5-y & =\\operatorname{ln}⁡({7}^{1/4}) \\\\ 5-y & =\\frac{1}{4}\\operatorname{ln}⁡(7) \\\\ -y & =\\frac{1}{4}\\operatorname{ln}⁡(7)-5 \\\\ y & =5-\\frac{1}{4}\\operatorname{ln}⁡(7)\\end{aligned}\n$$\n\nTherefore, the solution is $y=5-\\frac{1}{4}\\operatorname{ln}⁡(7).$"}] [{:db/id #edb/ref 17592186546961 :knowledge-point/_questions [{:db/id #edb/ref 17592186087689 :knowledge-point/id #uuid "4d8c6c93-9d15-5482-8130-25bb9cabf008" :knowledge-point/title "Finding Exact Solutions to Exponential Equations Using the Natural Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "143cf35a-845a-521f-9117-ce3541756c04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=7-\\frac{1}{10}\\operatorname{ln}⁡(7)" :db/id #edb/ref 17592186546293} {:answer/id #uuid "63b2ed40-cb9c-56e8-a73c-1fb3a500de4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=10+\\frac{1}{7}\\operatorname{ln}⁡(10)" :db/id #edb/ref 17592186546470} {:answer/id #uuid "7f8797e5-9480-5a81-814e-1bfb99aec85f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=7-\\frac{1}{7}\\operatorname{ln}⁡(10)" :db/id #edb/ref 17592186546536} {:answer/id #uuid "de0f44c4-a8d6-56ea-afc9-b58f1f9e5239" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1-\\frac{1}{10}\\operatorname{ln}⁡(7)" :db/id #edb/ref 17592186546741} {:answer/id #uuid "e7d5168f-0f24-5fcf-8392-ea9fd185e22d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1+\\frac{1}{7}\\operatorname{ln}⁡(10)" :db/id #edb/ref 17592186546770}] :answer-field/correct {:answer/id #uuid "7f8797e5-9480-5a81-814e-1bfb99aec85f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=7-\\frac{1}{7}\\operatorname{ln}⁡(10)" :db/id #edb/ref 17592186546536} :answer-field/id #uuid "4636930a-45e4-5386-a94d-82184908cb41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186546855}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "06bb1232-0a8a-5e1c-9d8b-cb06e8535b98" :question/math-academy-id "q-100280" :question/problem "What is the value of $y$ if ${e}^{7-y}=\\sqrt[7]{10}?$" :question/worked-solution "First, we find the natural logarithm $(ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{e}^{7-y} & =\\sqrt[7]{10} \\\\ \\operatorname{ln}⁡({e}^{7-y}) & =\\operatorname{ln}⁡(\\sqrt[7]{10})\\end{aligned}\n$$\n\nNow, we use the fact that $\\operatorname{ln}⁡({e}^{a})=a$ to simplify the left-hand side. This gives:\n\n$$\n7-y=\\operatorname{ln}⁡(\\sqrt[7]{10})\n$$\n\nNext, we write $\\sqrt[7]{10}$ as ${10}^{1/7}.$ So, we get:\n\n$$\n7-y=\\operatorname{ln}⁡({10}^{1/7})\n$$\n\nFinally, we rewrite the right-hand side using power law of logarithms and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}7-y & =\\operatorname{ln}⁡({10}^{1/7}) \\\\ 7-y & =\\frac{1}{7}\\operatorname{ln}⁡(10) \\\\ -y & =\\frac{1}{7}\\operatorname{ln}⁡(10)-7 \\\\ y & =7-\\frac{1}{7}\\operatorname{ln}⁡(10)\\end{aligned}\n$$\n\nTherefore, the solution is $y=7-\\frac{1}{7}\\operatorname{ln}⁡(10).$"}] [{:db/id #edb/ref 17592186547019 :knowledge-point/_questions [{:db/id #edb/ref 17592186087691 :knowledge-point/id #uuid "10095048-0db6-5b4e-889f-303f07449367" :knowledge-point/title "Finding Solutions to Exponential Equations when Rearrangement is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb1f6c74-977a-5e56-9576-efd63930e6eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8.318" :db/id #edb/ref 17592186546668}] :answer-field/correct {:answer/id #uuid "bb1f6c74-977a-5e56-9576-efd63930e6eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8.318" :db/id #edb/ref 17592186546668} :answer-field/id #uuid "eca758fe-2328-5a7b-bbea-03982c4511de" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186546947}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "75357678-4591-5397-a921-c421db4eafd8" :question/math-academy-id "q-263174" :question/problem "If ${e}^{-y/4}+6=14,$ then $y≈${{field-1}}, rounded to $3$ decimal places." :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}{e}^{-y/4}+6 & =14 \\\\ {e}^{-y/4} & =14-6 \\\\ {e}^{-y/4} & =8\\end{aligned}\n$$\n\nThen, we find the natural logarithm $(ln)$ of both sides of the equation and solve for $y:$\n\n$$\n\\begin{aligned}{e}^{-y/4} & =8 \\\\ \\operatorname{ln}⁡({e}^{-y/4}) & =\\operatorname{ln}⁡(8) \\\\ -\\frac{y}{4} & =\\operatorname{ln}⁡(8) \\\\ y & =-4\\operatorname{ln}⁡(8)\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\ny≈-8.318\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186088254 :knowledge-point/_questions [{:db/id #edb/ref 17592186087690 :knowledge-point/id #uuid "765ef63a-e3f0-503b-876d-3b4776b2cafe" :knowledge-point/title "Finding Approximate Solutions to Exponential Equations Using the Natural Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cbb39e3d-7c00-5ffd-b219-385bdbb65fb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.151" :db/id #edb/ref 17592186086179} {:answer/id #uuid "3c550fd6-0c84-5822-b466-66a312508be5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.946" :db/id #edb/ref 17592186086180} {:answer/id #uuid "40a3f90a-5606-5f21-9444-7efba36a199f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.845" :db/id #edb/ref 17592186086181} {:answer/id #uuid "6683b2b6-bc11-5d63-9a9c-82de11e77232" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.321" :db/id #edb/ref 17592186086182} {:answer/id #uuid "7f117552-88ca-5863-8469-88b09dabfb56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.856" :db/id #edb/ref 17592186086183}] :answer-field/correct {:answer/id #uuid "3c550fd6-0c84-5822-b466-66a312508be5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.946" :db/id #edb/ref 17592186086180} :answer-field/id #uuid "e61fb05b-bb1f-57bd-a3ae-f9d4180ef892" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086178}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "70d22aee-cf89-5d3c-9988-c197ae387fe1" :question/math-academy-id "q-66592" :question/problem "Find the solution to the equation ${e}^{y}=7$ rounded to $3$ decimal places." :question/requires-calculator true :question/worked-solution "First, we take $ln$ of both sides of the equation and solve for $y$:\n\n$$\n\\begin{aligned}{e}^{y} & =7 \\\\ \\operatorname{ln}⁡({e}^{y}) & =\\operatorname{ln}⁡(7) \\\\ y & =\\operatorname{ln}⁡(7)\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\ny≈1.946\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186088263 :knowledge-point/_questions [{:db/id #edb/ref 17592186087691 :knowledge-point/id #uuid "10095048-0db6-5b4e-889f-303f07449367" :knowledge-point/title "Finding Solutions to Exponential Equations when Rearrangement is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ef21aaa-a98c-5600-9672-541ca98aef94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}(\\operatorname{ln}⁡(2)-1)" :db/id #edb/ref 17592186546351} {:answer/id #uuid "580287e1-1d45-5eca-b8b6-cc34b9325864" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(3)-2" :db/id #edb/ref 17592186546444} {:answer/id #uuid "622b0641-4ef0-581a-ade7-929cc34e7006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\operatorname{ln}⁡(4)-1)" :db/id #edb/ref 17592186546463} {:answer/id #uuid "88dc0570-e1a8-54e1-af1d-0cdf02ce7424" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(\\operatorname{ln}⁡(4)+1)" :db/id #edb/ref 17592186546553} {:answer/id #uuid "a99e14d4-0433-552e-a606-7b1626a1695e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}(1-\\operatorname{ln}⁡(4))" :db/id #edb/ref 17592186546631}] :answer-field/correct {:answer/id #uuid "622b0641-4ef0-581a-ade7-929cc34e7006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\operatorname{ln}⁡(4)-1)" :db/id #edb/ref 17592186546463} :answer-field/id #uuid "78e69158-c06d-564e-b789-ce6a0691bb72" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086232}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4eca039f-43fe-568b-a212-c61f9bbcb6e3" :question/math-academy-id "q-66908" :question/problem "Given that ${e}^{2w+1}+2=6,$ then $w=$" :question/requires-calculator true :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}{e}^{2w+1}+2=6 \\\\ {e}^{2w+1} & =4\\end{aligned}\n$$\n\nThen, we find the natural logarithm $(ln)$ of both sides of the equation and solve for $w:$\n\n$$\n\\begin{aligned}{e}^{2w+1} & =4 \\\\ \\operatorname{ln}⁡({e}^{2w+1}) & =\\operatorname{ln}⁡(4) \\\\ 2w+1 & =\\operatorname{ln}⁡(4) \\\\ 2w & =\\operatorname{ln}⁡(4)-1 \\\\ w & =\\frac{1}{2}(\\operatorname{ln}⁡(4)-1)\\end{aligned}\n$$\n\nTherefore, the solution is $w=\\frac{1}{2}(\\operatorname{ln}⁡(4)-1).$"}] [{:db/id #edb/ref 17592186547080 :knowledge-point/_questions [{:db/id #edb/ref 17592186087690 :knowledge-point/id #uuid "765ef63a-e3f0-503b-876d-3b4776b2cafe" :knowledge-point/title "Finding Approximate Solutions to Exponential Equations Using the Natural Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d665a89-fc05-5872-ba27-4c8fa8029d46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.999" :db/id #edb/ref 17592186546315} {:answer/id #uuid "3fecd1f5-af33-5396-80e7-3689af6f722a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.621" :db/id #edb/ref 17592186546397} {:answer/id #uuid "92c8baf4-bb7e-5294-9aec-2efc06c33fa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.609" :db/id #edb/ref 17592186546574} {:answer/id #uuid "9e9947ad-7da2-5fe7-9bcd-60a5f447363f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.431" :db/id #edb/ref 17592186546604} {:answer/id #uuid "edca6055-61c2-5b86-810c-f75687fd6620" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.699" :db/id #edb/ref 17592186546785}] :answer-field/correct {:answer/id #uuid "92c8baf4-bb7e-5294-9aec-2efc06c33fa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.609" :db/id #edb/ref 17592186546574} :answer-field/id #uuid "dffe3c5c-ed39-5c84-b167-5dd49aa3722c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186546937}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f830d198-6965-5666-82fb-312c594f3381" :question/math-academy-id "q-66937" :question/problem "Find the solution to the equation ${e}^{z}=5$ rounded to $3$ decimal places." :question/worked-solution "First, we take $ln$ of both sides of the equation and solve for $z$:\n\n$$\n\\begin{aligned}{e}^{z} & =5 \\\\ \\operatorname{ln}⁡({e}^{z}) & =\\operatorname{ln}⁡(5) \\\\ z & =\\operatorname{ln}⁡(5)\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nz≈1.609\n$$\n\nrounded to $3$ decimal places."}]}
