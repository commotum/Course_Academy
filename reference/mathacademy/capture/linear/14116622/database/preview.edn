da ) \\\\ -\\text{Im}(\\lambda ) & \\text{Re}(\\lambda )\\end{aligned}]=[\\begin{aligned}-7 & -6 \\\\ 6 & -7\\end{aligned}]=C.\n$$\n\nNext, we can find the real and imaginary parts of our eigenvector:\n\n$$\n\\begin{aligned}v & =[\\begin{aligned}1+2\\text{i} \\\\ 3\\end{aligned}]={{[\\begin{aligned}1 \\\\ 3\\end{aligned}]}_{⏟}}_{\\text{Re}(v)}+\\text{i}{{[\\begin{aligned}2 \\\\ 0\\end{aligned}]}_{⏟}}_{\\text{Im}(v)}\\end{aligned}\n$$\n\nFinally, we can now construct $P:$ \n\n$$\n\\begin{aligned}P & =[\\begin{aligned}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{aligned}]=[\\begin{aligned}1 & 2 \\\\ 3 & 0\\end{aligned}].\\end{aligned}\n$$" 13194139534121 17592186045417 true] [17592186410830 1043 #edb/ref 17592186410858 13194139534121 17592186045417 true] [17592186410830 1043 #edb/ref 17592186410859 13194139534121 17592186045417 true] [17592186410830 1043 #edb/ref 17592186410860 13194139534121 17592186045417 true] [17592186410830 1043 #edb/ref 17592186410861 13194139534121 17592186045417 true] [17592186410830 1044 #edb/ref 17592186045464 13194139534121 17592186045417 true] [17592186410830 1045 "Reducing Real 2x2 Matrices to Rotation-Scaling Form" 13194139534121 17592186045417 true] [17592186410830 1046 #edb/ref 17592186410860 13194139534121 17592186045417 true] [17592186410830 1048 #edb/ref 17592186046673 13194139534121 17592186045417 true] [17592186410830 1049 #edb/ref 17592186048584 13194139534121 17592186045417 true] [17592186410830 1053 #uuid "5f5420bc-3099-5b53-8e6a-d43b1a5bffb0" 13194139534121 17592186045417 true] [17592186410831 1080 "[\\begin{aligned}-2 & 1 \\\\ 3 & 0\\end{aligned}]" 13194139534121 17592186045417 true] [17592186410831 1082 #edb/ref 17592186045498 13194139534121 17592186045417 true] [17592186410831 1083 #uuid "03ce9065-737f-5539-9ccc-e2b738124790" 13194139534121 17592186045417 true] [17592186410832 1080 "[\\begin{aligned}-1 & 0 \\\\ 2 & 1\\end{aligned}]" 13194139534121 17592186045417 true] [17592186410832 1082 #edb/ref 17592186045498