#{[{:db/id #edb/ref 17592186565469 :knowledge-point/_questions [{:db/id #edb/ref 17592186147462 :knowledge-point/id #uuid "631bc93f-4596-526f-9652-f35137b60883" :knowledge-point/title "Finding the Common Ratio Using a Formula Given Two Non-Consecutive Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ed3028e-ba87-52ad-ae62-bf4a8940254b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186565181}] :answer-field/correct {:answer/id #uuid "9ed3028e-ba87-52ad-ae62-bf4a8940254b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186565181} :answer-field/id #uuid "a19bdd09-342c-5cf6-98d6-201c1aaf72dc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186565369}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d3bc0664-ca47-5557-b277-90c0fa7c4b0b" :question/math-academy-id "q-250933" :question/problem "Find the common ratio of the geometric sequence whose fifth term is $7$ and whose tenth term is $-224.$\n\n$r=$\n{{field-1}}" :question/worked-solution "To find the common ratio $r$ of a geometric sequence given two terms ${a}_{m}$ and ${a}_{n},$ we use the formula\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}.\n$$\n\nIn this case, we're given ${a}_{10}=-224$ and ${a}_{5}=7.$ Substituting $n=10$ and $m=5$ into the formula, we have\n\n$$\n\\begin{aligned}{r}^{10-5} & =\\frac{{a}_{10}}{{a}_{5}} \\\\ {r}^{5} & =\\frac{(-224)}{7} \\\\ {r}^{5} & =-32.\\end{aligned}\n$$\n\nFinally, by solving the equation for $r,$ we get\n\n$$\n\\begin{aligned}{r}^{5} & =-32 \\\\ {r}^{5} & =(-2)^{5} \\\\ r & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186565479 :knowledge-point/_questions [{:db/id #edb/ref 17592186147462 :knowledge-point/id #uuid "631bc93f-4596-526f-9652-f35137b60883" :knowledge-point/title "Finding the Common Ratio Using a Formula Given Two Non-Consecutive Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8674d049-595e-5d07-a71e-5822b43b9d36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186565148}] :answer-field/correct {:answer/id #uuid "8674d049-595e-5d07-a71e-5822b43b9d36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186565148} :answer-field/id #uuid "48a7ef4a-dd0b-5d40-ac05-a0608f5b503d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186565347}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "efae9349-6eb8-5183-b15e-8510c6f912ab" :question/math-academy-id "q-250939" :question/problem "Find the common ratio of the geometric sequence whose sixth term is $-15$ and whose ninth term is $-\\frac{3}{25}.$\n\n$r=$\n{{field-1}}" :question/worked-solution "To find the common ratio $r$ of a geometric sequence given two terms ${a}_{m}$ and ${a}_{n},$ we use the formula\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}.\n$$\n\nIn this case, we're given ${a}_{9}=-\\frac{3}{25}$ and ${a}_{6}=-15.$ Substituting $n=9$ and $m=6$ into the formula, we have\n\n$$\n\\begin{aligned}{r}^{9-6} & =\\frac{{a}_{9}}{{a}_{6}} \\\\ {r}^{3} & =\\frac{(-\\frac{3}{25})}{(-15)} \\\\ {r}^{3} & =\\frac{1}{125}.\\end{aligned}\n$$\n\nFinally, by solving the equation for $r,$ we get\n\n$$\n\\begin{aligned}{r}^{3} & =\\frac{1}{125} \\\\ {r}^{3} & ={(\\frac{1}{5})}^{3} \\\\ r & =\\frac{1}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186565483 :knowledge-point/_questions [{:db/id #edb/ref 17592186147462 :knowledge-point/id #uuid "631bc93f-4596-526f-9652-f35137b60883" :knowledge-point/title "Finding the Common Ratio Using a Formula Given Two Non-Consecutive Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18ea77fd-c466-5c19-8b78-e55b99ea7fbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186564978} {:answer/id #uuid "31a77208-9897-5980-990c-d8cb0c4f2dc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186565011} {:answer/id #uuid "7236f903-d1df-5216-92d2-77e4d79341ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186565112} {:answer/id #uuid "7f835048-d27c-5354-a28a-6a4708cc3972" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186565133} {:answer/id #uuid "d32eb0f8-d90b-5fd2-b720-1d025deb37b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186565249}] :answer-field/correct {:answer/id #uuid "7236f903-d1df-5216-92d2-77e4d79341ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186565112} :answer-field/id #uuid "ef08cdfa-d03c-5a27-9c04-3a7bd62647af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186565403}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f97bc019-bf9e-5a95-8fff-fb6e975b8716" :question/math-academy-id "q-64028" :question/problem "Find the common ratio of the geometric sequence whose fourth term is $8$ and whose seventh term is $216.$" :question/worked-solution "To find the common ratio $r$ of a geometric sequence given two terms ${a}_{m}$ and ${a}_{n},$ we use the formula\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}.\n$$\n\nIn this case, we're given ${a}_{7}=216$ and ${a}_{4}=8.$ Substituting $n=7$ and $m=4$ into the formula, we have\n\n$$\n\\begin{aligned}{r}^{7-4} & =\\frac{{a}_{7}}{{a}_{4}} \\\\ {r}^{3} & =\\frac{216}{8} \\\\ {r}^{3} & =27.\\end{aligned}\n$$\n\nFinally, by solving the equation for $r,$ we get\n\n$$\n\\begin{aligned}{r}^{3} & =27 \\\\ {r}^{3} & ={3}^{3} \\\\ r & =3.\\end{aligned}\n$$"}]}
