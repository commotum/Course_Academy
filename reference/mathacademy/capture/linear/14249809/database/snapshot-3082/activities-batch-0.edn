#{[{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186111749} :activity/id #uuid "04bc8b7b-7ea5-55c8-ab74-1bade2a9232e" :activity/scope {:db/id #edb/ref 17592186048161 :topic/id #uuid "83f358e7-8e72-5df7-83a1-5f295f525040" :topic/math-academy-id 1508} :activity/steps [{:db/id #edb/ref 17592186111749 :step/content {:db/id #edb/ref 17592186111842 :tutorial/content "An angle **bisector** is a line that divides an angle into two equal parts. \n\nFor example, in the diagram below, $\\overset{\\longrightarrow}{AC}$ is the bisector of the angle $\\angle BAD.$\n\n![](images/3b/3bf65e915f4fc26b8d87199f46ea0bc514195d857890983d31aa2d73eb38a811.png)\n\nThe resulting angles $\\angle BAC$ and $\\angle CAD$ are congruent (they have the same measure)." :tutorial/id #uuid "525bd6d2-3c4c-53fb-aaa5-dab5eee2cf13" :tutorial/math-academy-id 2190 :tutorial/title "Introduction"} :step/id #uuid "9e612b0f-54c0-5291-8cff-8d993deb2e7f" :step/math-academy-id 8793 :step/next {:db/id #edb/ref 17592186111751}} {:db/id #edb/ref 17592186111751 :step/content {:db/id #edb/ref 17592186110766 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110395 :question/id #uuid "9612e5aa-af83-5ea5-8bf2-302834e1926a" :question/math-academy-id "e-2615"} :knowledge-point/id #uuid "d3162bc9-a06e-50d9-aaab-628438daa9fe" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050164}] :knowledge-point/questions [{:db/id #edb/ref 17592186111091} {:db/id #edb/ref 17592186111092} {:db/id #edb/ref 17592186508042} {:db/id #edb/ref 17592186508067}] :knowledge-point/title "Using the Property of a Bisection"} :step/id #uuid "1c31f48e-d74f-5249-95de-5e7c8f5d2f46" :step/math-academy-id 8800 :step/next {:db/id #edb/ref 17592186111752}} {:db/id #edb/ref 17592186111752 :step/content {:db/id #edb/ref 17592186110767 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110397 :question/id #uuid "ec3e6d87-e38e-5aa6-b064-f3c15a51a836" :question/math-academy-id "e-2621"} :knowledge-point/id #uuid "2051959e-cd96-5318-8b36-518756991988" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048764} {:db/id #edb/ref 17592186050494}] :knowledge-point/questions [{:db/id #edb/ref 17592186111281} {:db/id #edb/ref 17592186111282} {:db/id #edb/ref 17592186508085} {:db/id #edb/ref 17592186508096} {:db/id #edb/ref 17592186555860}] :knowledge-point/title "Calculating an Unknown Angle Given an Angle Bisector, an Angle Measurement, and a Straight Angle"} :step/id #uuid "1cba6c91-319e-5bf4-8c35-5b263b37e85b" :step/math-academy-id 8803 :step/next {:db/id #edb/ref 17592186111754}} {:db/id #edb/ref 17592186111754 :step/content {:db/id #edb/ref 17592186110769 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110398 :question/id #uuid "f4304d42-1b4c-5ade-86d2-8ed44a952fc8" :question/math-academy-id "e-2624"} :knowledge-point/id #uuid "f6849b30-c5a6-53ba-8517-92c9526ce308" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048174}] :knowledge-point/questions [{:db/id #edb/ref 17592186111280} {:db/id #edb/ref 17592186111283} {:db/id #edb/ref 17592186233239} {:db/id #edb/ref 17592186508081} {:db/id #edb/ref 17592186508111}] :knowledge-point/title "Calculating an Unknown Angle Given an Angle Bisector and Two Angle Measurements"} :step/id #uuid "f83db2f5-c826-55f5-93f5-fdf2beac3d1a" :step/math-academy-id 8810 :step/next {:db/id #edb/ref 17592186111755}} {:db/id #edb/ref 17592186111755 :step/content {:db/id #edb/ref 17592186110770 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110399 :question/id #uuid "b3dbb627-0262-5fdd-ae6b-ba669e4fac6f" :question/math-academy-id "e-2628"} :knowledge-point/id #uuid "6720ccef-3a50-59f0-a1e3-6158ef29ab4e" :knowledge-point/questions [{:db/id #edb/ref 17592186111090} {:db/id #edb/ref 17592186111253} {:db/id #edb/ref 17592186508092} {:db/id #edb/ref 17592186508099} {:db/id #edb/ref 17592186555840}] :knowledge-point/title "Calculating an Unknown Angle Given Two Angle Bisectors"} :step/id #uuid "35f9cbf1-c876-520b-ae7a-9a137685a526" :step/math-academy-id 8815}] :activity/title "Angle Bisectors" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110863}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186555905} :activity/id #uuid "b24ba955-8712-5b3f-a039-0cb09319a85f" :activity/scope {:db/id #edb/ref 17592186048161 :topic/id #uuid "83f358e7-8e72-5df7-83a1-5f295f525040" :topic/math-academy-id 1508} :activity/steps [{:db/id #edb/ref 17592186555882 :step/content {:db/id #edb/ref 17592186111282 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58d5e5f5-dd58-5582-8b38-6a124bf6d737" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{53.5}^{∘}" :db/id #edb/ref 17592186555195} {:answer/id #uuid "8fce95cb-be82-56d7-af85-f23763b2574a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{73}^{∘}" :db/id #edb/ref 17592186555337} {:answer/id #uuid "92508f56-9787-5b76-a9fe-11533bf721df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{34}^{∘}" :db/id #edb/ref 17592186555343} {:answer/id #uuid "df095c91-6c8f-5d26-856c-40dc63831c93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{19.5}^{∘}" :db/id #edb/ref 17592186555542} {:answer/id #uuid "ff189e12-57b2-5448-9e85-6d8ad358c87d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{56}^{∘}" :db/id #edb/ref 17592186555636}] :answer-field/correct {:db/id #edb/ref 17592186555343} :answer-field/id #uuid "506f779b-ad82-5788-8675-e84a84d29448" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186109417}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b480f75d-e164-59ad-88b9-01f4d48bb8eb" :question/math-academy-id "q-53225" :question/problem "![](images/0e/0e112d00ddcb34c30a490d1a71e3e0b4a2c698707e3890666ac4e299c3ca37cd.png)\n\nIn the figure above, $∠BOA$ is a straight angle,  and $\\overset{\\to }{OD}$ is the bisector of $∠COA.$ If $m∠BOD={107}^{∘},$ find $m∠BOC.$" :question/worked-solution "![](images/2d/2d75ac364d71d8dd6cf35cfe7f8966b603c3cbee0bc5adff5f7dadf7468bab4c.png)\n\nSince the angles $∠DOA$ and $∠BOD$ are supplementary, we have \n\n$$\n\\begin{aligned}m∠DOA & ={180}^{∘}-m∠BOD \\\\  & ={180}^{∘}-{107}^{∘} \\\\  & ={73}^{∘}.\\end{aligned}\n$$\n\nThe bisector of an angle divides the angle into two congruent angles. Therefore,\n\n$$\nm∠DOA=m∠COD={73}^{∘}.\n$$\n\nFinally, by the angle addition postulate, we have\n\n$$\n\\begin{aligned}m∠BOC & =m∠BOD-m∠COD \\\\  & ={107}^{∘}-{73}^{∘} \\\\  & ={34}^{∘}.\\end{aligned}\n$$"} :step/id #uuid "14d7f20f-27ec-5422-97bb-c3ce632077cb" :step/next {:db/id #edb/ref 17592186555913}} {:db/id #edb/ref 17592186555905 :step/content {:db/id #edb/ref 17592186555840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d776491-c1ab-5501-82d2-91e21a03ca6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{10}^{∘}" :db/id #edb/ref 17592186555133} {:answer/id #uuid "6a5c6c0b-7e8a-5766-9d6d-58dc5b683669" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{8}^{∘}" :db/id #edb/ref 17592186555241} {:answer/id #uuid "a58b1640-8c7c-556f-8206-addcb17809a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{12}^{∘}" :db/id #edb/ref 17592186555396} {:answer/id #uuid "c105109e-b039-5a38-a13d-3f87e2d4f160" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{18}^{∘}" :db/id #edb/ref 17592186555464} {:answer/id #uuid "d6a53a49-98a0-54d5-93a8-aa0a17c35392" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{15}^{∘}" :db/id #edb/ref 17592186555511}] :answer-field/correct {:db/id #edb/ref 17592186555133} :answer-field/id #uuid "c6259dee-47bb-5440-9bda-09df267863c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555733}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9de433c9-b3da-5c7d-a414-05618ea3bae5" :question/math-academy-id "q-26365" :question/problem "![](images/65/65e89fcd8ae54d3c269c064f7c9f55a81f3a4dd847c4195550c8c2bf4251982f.png)\n\nIn the figure above, $∠BOA$ is a straight angle, $\\overset{\\to }{OD}$ and $\\overset{\\to }{OE}$ are the bisectors of $∠AOC$ and $∠BOC$, respectively. If $m∠DOC=4x$ and $m∠COE=5x$, find the value of $x.$" :question/worked-solution "![](images/77/77adc8fb9c00bd21579a8697f8b11c228e3864e657f2b991be4d09b4c6f5a96d.png)\n\nSince $\\overset{\\to }{OD}$ is the bisector of $∠AOC$, we have \n\n$$\nm∠AOD=m∠DOC=4x.\n$$\n\nSince $\\overset{\\to }{OE}$ is the bisector of $∠BOC$, we have \n\n$$\nm∠EOB=m∠COE=5x.\n$$\n\nNow, by the angle addition postulate, we have:\n\n$$\n\\begin{aligned}m∠AOD+m∠DOC+m∠EOB+m∠COE & ={180}^{∘} \\\\ 4x+4x+5x+5x & ={180}^{∘} \\\\ 18x & ={180}^{∘} \\\\ x & ={10}^{∘}\\end{aligned}\n$$"} :step/id #uuid "54a2e288-2926-57a7-af41-ba3bccd060e4" :step/next {:db/id #edb/ref 17592186555882}} {:db/id #edb/ref 17592186555913 :step/content {:db/id #edb/ref 17592186555860 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6adf9c64-77a8-5ff5-bdf3-534f65b4650e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{119}^{∘}" :db/id #edb/ref 17592186555243} {:answer/id #uuid "9155be22-cd39-56bb-bf04-cbe9e114a3b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{113}^{∘}" :db/id #edb/ref 17592186555342} {:answer/id #uuid "9911e812-959a-52fd-ae15-08a54c3a2ece" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{107}^{∘}" :db/id #edb/ref 17592186555370} {:answer/id #uuid "a52a4974-7051-5d8f-a0eb-e62fe95403da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{122}^{∘}" :db/id #edb/ref 17592186555394} {:answer/id #uuid "c8af1589-4ba3-59d6-8c49-d7530c09dc65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{61}^{∘}" :db/id #edb/ref 17592186555482}] :answer-field/correct {:db/id #edb/ref 17592186555243} :answer-field/id #uuid "38c3c80e-f2de-5e28-b208-78246bebe168" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555665}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "da69f84c-0e57-51e1-a173-b362df890bdd" :question/math-academy-id "q-117152" :question/problem "![](images/18/187b52aa0450e940bd644f9d1ae560a735c7e10e18157ecba910a6a817c11797.png)\n\nIn the figure above, $∠BOA$ is a straight angle,  and $\\overset{\\to }{OC}$ is the bisector of $∠BOD.$ If $m∠DOA={58}^{∘},$ find $m∠COA.$" :question/worked-solution "![](images/9d/9d7c5789c579b9292beb17ad03ae6239083ffa70fe5ec581da33cd488e365344.png)\n\nSince the angles $∠BOD$ and $∠DOA$ are supplementary, we have \n\n$$\n\\begin{aligned}m∠BOD & ={180}^{∘}-m∠DOA \\\\  & ={180}^{∘}-{58}^{∘} \\\\  & ={122}^{∘}.\\end{aligned}\n$$\n\nThe bisector of an angle divides the angle into two congruent angles. Therefore, we get\n\n$$\n\\begin{aligned}m∠COD & =\\frac{m∠BOD}{2} \\\\  & =\\frac{{122}^{∘}}{2} \\\\  & ={61}^{∘}.\\end{aligned}\n$$\n\nFinally, by the angle addition postulate, we have\n\n$$\n\\begin{aligned}m∠COA & =m∠COD+m∠DOA \\\\  & ={61}^{∘}+{58}^{∘} \\\\  & ={119}^{∘}.\\end{aligned}\n$$"} :step/id #uuid "719ab7fe-75c0-50fc-ba0c-c980972ad03d"}] :activity/title "Angle Bisectors" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186554999}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186116396} :activity/id #uuid "3186d920-ff1f-5f36-a31d-2756c7f5f4f9" :activity/scope {:db/id #edb/ref 17592186048472 :topic/id #uuid "a26cd4f5-8420-5521-8401-af794c94636b" :topic/math-academy-id 1644} :activity/steps [{:db/id #edb/ref 17592186116268 :step/content {:db/id #edb/ref 17592186115336 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115160 :question/id #uuid "43c770ec-d353-5e9e-b44e-f06417dab2ab" :question/math-academy-id "e-9731"} :knowledge-point/id #uuid "6a916099-a237-5612-b7f1-3679b7ff069d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048723} {:db/id #edb/ref 17592186049949} {:db/id #edb/ref 17592186050410}] :knowledge-point/questions [{:db/id #edb/ref 17592186115491} {:db/id #edb/ref 17592186115655} {:db/id #edb/ref 17592186253502} {:db/id #edb/ref 17592186253503} {:db/id #edb/ref 17592186269004} {:db/id #edb/ref 17592186294980} {:db/id #edb/ref 17592186500347} {:db/id #edb/ref 17592186567028}] :knowledge-point/title "Calculating an Unknown Angle"} :step/id #uuid "9cedeba2-5a6c-5062-880b-beb7fa0aa70f" :step/math-academy-id 36502} {:db/id #edb/ref 17592186116396 :step/content {:db/id #edb/ref 17592186116449 :tutorial/content "Consider $\\triangle ABC$ shown below. \n\n![](images/6f/6fdb9a8337d16f1ef1910989b3df92844c5393c33108f98ae7993cc939bed0b3.png)\n\nNow, let's draw a line segment that \n\n- runs from $\\color{blue}C$ to the line ${\\color{red}\\overset{\\longleftrightarrow}{AB}},$ and\n\n- is *perpendicular* to ${\\color{red}\\overset{\\longleftrightarrow}{AB}}.$\n\nThis line segment is the dashed segment shown below:\n\n![](images/4a/4a7ee2771c9b0c60dbb07c43b0439e822ea9b2c261ac41af9b44fec72b9f2a91.png)\n\nFinally, let's label the other endpoint of our segment ${\\color{blue}{H}}.$\n\n![](images/75/758eab533719220515460b6677054438a9ac0e2701d1a5267b973e526f63bd90.png)\n\nNote the following:\n\n- The line segment ${\\color{blue}\\overline{CH}}$ is called the **height** (or **altitude**) *corresponding to* ${\\color{red}\\overset{\\longleftrightarrow}{AB}}.$\n\n- The line $\\overset{\\longleftrightarrow}{AB}$ is called the **base** of the altitude ${\\color{blue}\\overline{CH}}.$\n\nAs we'll soon discover, the heights and their corresponding bases are important attributes of triangles." :tutorial/id #uuid "bdb9bfbd-b830-51f0-8712-5d34f83f2812" :tutorial/math-academy-id 2232 :tutorial/title "Introduction"} :step/id #uuid "4231f520-72fe-5c14-8733-25cc76a6e65e" :step/math-academy-id 9151 :step/next {:db/id #edb/ref 17592186116397}} {:db/id #edb/ref 17592186116397 :step/content {:db/id #edb/ref 17592186115409 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114985 :question/id #uuid "972fe403-9a15-5d10-8f9f-f5c93eb586ff" :question/math-academy-id "e-2725"} :knowledge-point/id #uuid "f7e817a0-edcf-54ca-ba4c-ffe91af04675" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050357}] :knowledge-point/questions [{:db/id #edb/ref 17592186115646} {:db/id #edb/ref 17592186115952} {:db/id #edb/ref 17592186253495} {:db/id #edb/ref 17592186253496} {:db/id #edb/ref 17592186294864} {:db/id #edb/ref 17592186386882} {:db/id #edb/ref 17592186393737} {:db/id #edb/ref 17592186500371}] :knowledge-point/title "Finding a Height of a Triangle"} :step/id #uuid "52e4c58c-e58e-5223-98e5-cc31383de47c" :step/math-academy-id 9154 :step/next {:db/id #edb/ref 17592186116398}} {:db/id #edb/ref 17592186116398 :step/content {:db/id #edb/ref 17592186116450 :tutorial/content "We can draw exactly three heights (or altitudes) in any triangle. However, sometimes the height lies outside the triangle.\n\nTo demonstrate, consider $\\triangle{ABC}$ below.\n\n![](images/df/df1ac2c1074305f8ead506d9aeb8c3927ad51ae5949b45976f1971b52d402ee5.png)\n\nThe height corresponding to $\\overline{BC}$ is a line segment that \n\n- runs from the opposite vertex $A$ to the line $\\overset{\\longleftrightarrow}{BC},$ and\n\n- is perpendicular to $\\overset{\\longleftrightarrow}{BC}.$\n\nIn this case, it's impossible to draw a perpendicular from $A$ to the *segment* $\\overline{BC}.$ However, we can first *extend* the line segment $\\overline{BC}$ as follows:\n\n![](images/26/26bf9eb8af1e9b71c263c08cae5797d5c911410985cdc01213ac2c295f7b8d46.png)\n\nNow, we draw the perpendicular from $A$ to $\\overset{\\longleftrightarrow}{BC}.$ This gives the height $\\overline{AH}{:}$\n\n![](images/89/894686fce1393ebcf998be6885020627c9f3cde5916adfec67234f15f8895826.png)" :tutorial/id #uuid "4031d801-f4b8-543f-ad4d-9ef60d513427" :tutorial/math-academy-id 2236 :tutorial/title "Case of Extended Bases"} :step/id #uuid "b9f034d0-1d0e-54ea-83b8-ad683048d5c5" :step/math-academy-id 9158 :step/next {:db/id #edb/ref 17592186116399}} {:db/id #edb/ref 17592186116399 :step/content {:db/id #edb/ref 17592186115410 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114986 :question/id #uuid "2e6213d0-702f-5795-a99a-0051790c4e6d" :question/math-academy-id "e-2730"} :knowledge-point/id #uuid "6a76efbd-cefd-5aa0-953e-8ab50bec7ae0" :knowledge-point/questions [{:db/id #edb/ref 17592186115647} {:db/id #edb/ref 17592186115648} {:db/id #edb/ref 17592186253497} {:db/id #edb/ref 17592186335937} {:db/id #edb/ref 17592186392742} {:db/id #edb/ref 17592186392952} {:db/id #edb/ref 17592186500367} {:db/id #edb/ref 17592186564510} {:db/id #edb/ref 17592186564516} {:db/id #edb/ref 17592186567079}] :knowledge-point/title "Finding a Height Corresponding to an Extended Base"} :step/id #uuid "25c91feb-798e-5857-9090-3b36088bc71b" :step/math-academy-id 9160 :step/next {:db/id #edb/ref 17592186116268}}] :activity/title "Heights of Triangles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115444}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186564569} :activity/id #uuid "b344a744-3440-50e5-9d6c-33f6246db0c2" :activity/scope {:db/id #edb/ref 17592186048472 :topic/id #uuid "a26cd4f5-8420-5521-8401-af794c94636b" :topic/math-academy-id 1644} :activity/steps [{:db/id #edb/ref 17592186564569 :step/content {:db/id #edb/ref 17592186294980 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "250975f6-1855-51d4-855b-4756eab86379" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186293090} {:answer/id #uuid "74682fc2-217c-57f5-ab98-c931310e5466" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{18}^{∘}" :db/id #edb/ref 17592186293411} {:answer/id #uuid "7d0ac39b-3059-5c95-9035-fede9601ced2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{15}^{∘}" :db/id #edb/ref 17592186293433} {:answer/id #uuid "c8f82474-ac34-5dcf-9935-8a82efc05435" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{20}^{∘}" :db/id #edb/ref 17592186293712} {:answer/id #uuid "e390ae5f-9602-5bc0-bd7b-333ec91cd6ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{25}^{∘}" :db/id #edb/ref 17592186293825}] :answer-field/correct {:db/id #edb/ref 17592186293712} :answer-field/id #uuid "5dff0f5f-38be-5491-8c48-4be6dc5f48b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186294264}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "94753d7f-95e4-5b39-9c21-ede7ecea7547" :question/math-academy-id "q-27832" :question/problem "![](images/66/6665784a8ce048fd26fbd97038346e8e6fdf6800d645ea0488f1c18986f5864b.png)\n\nConsider the triangle $△ABC$ shown above. The line segment $\\overset{―}{CH}$ is the altitude corresponding to $\\overset{―}{AB}.$ If $m∠BAC={110}^{∘},$ calculate $m∠HCA.$" :question/worked-solution "Since the straight angle must have a measure of ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠HAC+m∠BAC & ={180}^{∘} \\\\ m∠HAC+{110}^{∘} & ={180}^{∘} \\\\ m∠HAC & ={70}^{∘}.\\end{aligned}\n$$\n\nNote that $△ACH$ is a right triangle. Since its interior angles must sum to ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠HCA+m∠HAC+m∠AHC & ={180}^{∘} \\\\ m∠HCA+{70}^{∘}+{90}^{∘} & ={180}^{∘} \\\\ m∠HCA+{160}^{∘} & ={180}^{∘} \\\\ m∠HCA & ={20}^{∘}.\\end{aligned}\n$$"} :step/id #uuid "85fdfdf6-5023-58b6-a609-0e7f25680884" :step/next {:db/id #edb/ref 17592186564593}} {:db/id #edb/ref 17592186564579 :step/content {:db/id #edb/ref 17592186564516 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c137d98-33bd-5cfc-8f63-359ad6471b1e" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/0b/0bc641736877902ac9272906ed276d36d475ef8060c3c00f0814d9881c3a2153.png" :