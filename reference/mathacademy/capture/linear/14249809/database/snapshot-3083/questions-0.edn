#{[{:db/id #edb/ref 17592186570724 :knowledge-point/_questions [{:db/id #edb/ref 17592186068812 :knowledge-point/id #uuid "1300ab0b-313f-5489-a836-79cf200082f6" :knowledge-point/title "Expressing a Union of Non-Overlapping Intervals as an Inequality"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d13874f-d67d-5517-93e4-99c7f8c4271a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{3}<x$ or $x\\ge 3$" :db/id #edb/ref 17592186570315} {:answer/id #uuid "827893a9-b95b-55f0-915b-1c8e00888102" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}<x<3" :db/id #edb/ref 17592186570354} {:answer/id #uuid "cf0a2046-3b5e-5e61-a994-9e5fdfe11611" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}\\le x<3" :db/id #edb/ref 17592186570484} {:answer/id #uuid "e7509d63-8072-59fc-8112-5bc30af162dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<\\sqrt{3}$ or $x>3$" :db/id #edb/ref 17592186570528} {:answer/id #uuid "ead74f6f-5760-5690-b9af-a1e8a8d7a384" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<\\sqrt{3}$ or $3>x$" :db/id #edb/ref 17592186570534}] :answer-field/correct {:answer/id #uuid "e7509d63-8072-59fc-8112-5bc30af162dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<\\sqrt{3}$ or $x>3$" :db/id #edb/ref 17592186570528} :answer-field/id #uuid "50b72217-0f5e-5d03-bce9-0d904f17a8e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186570610}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "461aef2d-ef91-5bc9-a05c-59153c1a3f67" :question/math-academy-id "q-102118" :question/problem "Express $(-\\infty ,\\sqrt{3})\\cup (3,\\infty )$ as an inequality." :question/worked-solution "First, we graph the two intervals on a number line:\n\n![](images/73/73f3c747217e98926510918c395eb644eb143ba07446a863b3f038aafb3fd19a.png)\n\nThe interval $(-\\infty ,\\sqrt{3})$ can be expressed as the inequality $x<\\sqrt{3}.$\n\nLikewise, the interval $(3,\\infty )$ can be expressed as the inequality $x>3.$\n\nSo, the union of these intervals represents the compound inequality\n\n$$\nx<\\sqrt{3}\\text{ or }x>3.\n$$"}] [{:db/id #edb/ref 17592186570713 :knowledge-point/_questions [{:db/id #edb/ref 17592186068836 :knowledge-point/id #uuid "bc723e84-3051-5e73-ac57-08da7193c368" :knowledge-point/title "Simplifying Radical Expressions With Perfect Squares Under the Radical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "126f825b-54f7-557c-902d-f23f70ba9df9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6|t|" :db/id #edb/ref 17592186570158} {:answer/id #uuid "4631f84e-d5a6-5799-b347-9ad541471ba1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30t" :db/id #edb/ref 17592186570248} {:answer/id #uuid "4c75ccdd-f6c5-5e94-a601-725a713a3f5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6|t|}{5}" :db/id #edb/ref 17592186570258} {:answer/id #uuid "8977733d-92ba-5dd8-ade8-abf7ee937741" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5t" :db/id #edb/ref 17592186570367} {:answer/id #uuid "de74d234-a125-5b01-bbcf-59800aca3ef1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30\\sqrt{t}" :db/id #edb/ref 17592186570515}] :answer-field/correct {:answer/id #uuid "4c75ccdd-f6c5-5e94-a601-725a713a3f5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6|t|}{5}" :db/id #edb/ref 17592186570258} :answer-field/id #uuid "fc9a310b-5a8f-5f99-b66d-f83152a549f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186570694}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2a409742-71a6-54c6-bd19-7151d386a675" :question/math-academy-id "q-162918" :question/problem "$\\sqrt{\\frac{36{t}^{2}}{25}}=$" :question/worked-solution "First, we put the numerator and denominator under separate radicals and then simplify the result:\n\n$$\n\\sqrt{\\frac{36{t}^{2}}{25}}=\\frac{\\sqrt{36{t}^{2}}}{\\sqrt{25}}=\\frac{\\sqrt{36{t}^{2}}}{\\sqrt{{5}^{2}}}=\\frac{\\sqrt{36{t}^{2}}}{5}\n$$\n\nNow, notice that the expression inside the radical is a perfect square. So, we can continue simplifying by writing the expression as this perfect square:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{36{t}^{2}}}{5} & = \\\\ \\frac{\\sqrt{(6t)^{2}}}{5} & = \\\\ \\frac{|6t|}{5} & = \\\\ \\frac{|6|\\cdot |t|}{5} & = \\\\ \\frac{6\\cdot |t|}{5} & = \\\\ \\frac{6|t|}{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570766 :knowledge-point/_questions [{:db/id #edb/ref 17592186175896 :knowledge-point/id #uuid "c1941876-94d1-52d5-9104-7875de691ca0" :knowledge-point/title "Identifying Parts of a Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ec257ea-48f1-5dfe-aaeb-4230e4c826a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The arc $\\overset{⌢}{DCB}$" :db/id #edb/ref 17592186570147} {:answer/id #uuid "55c10b16-1680-5c57-88e4-93515486f043" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The chord $\\overset{―}{CB}$" :db/id #edb/ref 17592186570276} {:answer/id #uuid "97700b88-fc12-5fbd-a0e2-e42edc54e310" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The radius $\\overset{―}{DB}$" :db/id #edb/ref 17592186570391} {:answer/id #uuid "cd15dd19-c02b-5dfa-b6b3-3860f063ad66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The chord $\\overset{―}{DB}$" :db/id #edb/ref 17592186570478} {:answer/id #uuid "d1083e36-8fdd-5bd2-a13d-97a34d959844" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The diameter $\\overset{―}{DB}$" :db/id #edb/ref 17592186570489}] :answer-field/correct {:answer/id #uuid "0ec257ea-48f1-5dfe-aaeb-4230e4c826a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The arc $\\overset{⌢}{DCB}$" :db/id #edb/ref 17592186570147} :answer-field/id #uuid "5dfb2f23-5fb3-5912-a81d-8dc6871d0198" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186570620}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ac232906-fa2f-5902-9534-48663339125f" :question/math-academy-id "q-21134" :question/problem "![](images/f6/f6408a8a100f18484b72e6a21243111c4445240a93f84068486e03290a2f8892.png)\n\nWhat element of the circle is depicted in the diagram above?" :question/worked-solution "The element shown in the diagram is the part of the circle that is enclosed between the points $B$ and $D$ on the circle and passes through the point $C$ on the circle. So, this element represents the arc $\\overset{⌢}{DCB}.$"}] [{:db/id #edb/ref 17592186115648 :knowledge-point/_questions [{:db/id #edb/ref 17592186115410 :knowledge-point/id #uuid "6a76efbd-cefd-5aa0-953e-8ab50bec7ae0" :knowledge-point/title "Finding a Height Corresponding to an Extended Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c772b6b0-85cc-5dde-8c0a-adcec0c6a9a1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/47/47ac7748193ed85f8f1d22ca5880a8dea1d04a75117e48a5ae42b2de25d9e15a.png" :db/id #edb/ref 17592186112855} {:answer/id #uuid "fe9fc7f8-ab0c-5ac6-834c-cc478232bca1" :answer/