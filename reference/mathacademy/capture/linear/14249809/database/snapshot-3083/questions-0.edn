 "1" :db/id #edb/ref 17592186570226} {:answer/id #uuid "5103d28e-3250-582a-a1d3-aaef1d053eb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186570268} {:answer/id #uuid "7f989685-a501-52c8-91ad-94b0ba9a226e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186570349} {:answer/id #uuid "8b54626f-a13a-5186-8fed-3f876265809b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186570371} {:answer/id #uuid "ae6cdbb0-8b45-5733-9a25-c1b2d3d49dab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186570439}] :answer-field/correct {:answer/id #uuid "3ee14911-7081-554f-b8d8-c2399f3e2fea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186570226} :answer-field/id #uuid "591c8064-4806-5fc4-b702-61324eb39f7a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186570617}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "db12ae2f-b0be-5f71-b38b-bd9f3742126a" :question/math-academy-id "q-287666" :question/problem "Consider the equation in the variable $x,$ given by\n\n$$\n2(p-1)x=5\n$$\n\nwhere $p$ is a constant. Given that this equation has no solution, what is the value of $p?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=b\n$$\n\nwhere $a$ and $b$ are constants, and $b\\ne 0.$ If $a=0,$ then the equation has no solution.\n\nNotice that this equation is in the form $ax=b.$ In this case, \n\n$$\na=2(p-1),\\,b=5.\n$$\n\nTherefore, the equation has no solution if\n\n$$\n2(p-1)=0.\n$$\n\nSolving this for $p,$ we get\n\n$$\n\\begin{aligned}2(p-1) & =0 \\\\ \\frac{2(p-1)}{2} & =\\frac{0}{2} \\\\ p-1 & =0 \\\\ p & =1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570704 :knowledge-point/_questions [{:db/id #edb/ref 17592186502068 :knowledge-point/id #uuid "aec0cd94-20e4-5748-b9c1-4de7b1854a8e" :knowledge-point/title "Solving Problems Involving Multiplying Negative Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4000bf26-e332-5326-962b-83435ec584c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{10}{3}{\\,}^{∘}\\text{C}" :db/id #edb/ref 17592186570230} {:answer/id #uuid "405df5c1-8de4-558b-9aaf-0951a214d16d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}{\\,}^{∘}\\text{C}" :db/id #edb/ref 17592186570232} {:answer/id #uuid "441f4327-e461-55f6-a208-71db35e05411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{8}{\\,}^{∘}\\text{C}" :db/id #edb/ref 17592186570242} {:answer/id #uuid "68ece16d-ee10-5137-902b-6a2b5c84b877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}{\\,}^{∘}\\text{C}" :db/id #edb/ref 17592186570308} {:answer/id #uuid "f2138d1e-854f-50fb-afce-07734ffed707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}{\\,}^{∘}\\text{C}" :db/id #edb/ref 17592186570551}] :answer-field/correct {:answer/id #uuid "68ece16d-ee10-5137-902b-6a2b5c84b877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}{\\,}^{∘}\\text{C}" :db/id #edb/ref 17592186570308} :answer-field/id #uuid "765eabd7-3f07-54c5-b885-44c2b986b924" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186570632}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1692e268-919b-5ead-b3e6-7be50cf4ba12" :question/math-academy-id "q-357229" :question/problem "The temperature of a cold room decreases by $\\frac{3}{8}{\\,}^{∘}\\text{C}$ each minute for $\\frac{10}{3}$ minutes. What is the total change in temperature?" :question/worked-solution "The temperature decreases by $\\frac{3}{8}{\\,}^{∘}\\text{C}$ each minute.\n\nSince the temperature decreases, the change each minute is $-\\frac{3}{8}.$\n\nThe change occurs for $\\frac{10}{3}$ minutes, so the total change is\n\n$$\n\\frac{10}{3}\\times (-\\frac{3}{8}).\n$$\n\nEvaluating the product, we get\n\n$$\n\\frac{10}{3}\\times (-\\frac{3}{8})=-\\frac{10\\times 3}{3\\times 8}=-\\frac{10}{8}=-\\frac{5}{4}.\n$$\n\nTherefore, the total change in temperature is $-\\frac{5}{4}{\\,}^{∘}\\text{C}.$"}] [{:db/id #edb/ref 17592186570774 :knowledge-point/_questions [{:db/id #edb/ref 17592186087688 :knowledge-point/id #uuid "43401830-730c-57d7-8831-9a0580042ffe" :knowledge-point/title "Finding Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d1a2852-f517-5d90-b7be-d24e175f9b41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186570286} {:answer/id #uuid "6ffae9ff-6b6e-5388-bf97-8dc654e42f0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186570325} {:answer/id #uuid "e584ece9-087d-5e7b-b826-0e85175c9c44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186570524} {:answer/id #uuid "f2eaee78-411a-511b-8fbf-db72b68e0281" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186570554} {:answer/id #uuid "f78b21b4-650c-520d-9683-83fa3a54718f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186570562}] :answer-field/correct {:answer/id #uuid "6ffae9ff-6b6e-5388-bf97-8dc654e42f0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186570325} :answer-field/id #uuid "d4a445c9-d381-5c2e-b303-52cf74b14cc4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186570678}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cb6eb9c0-dc4b-52b4-82f6-8cb252573f49" :question/math-academy-id "q-44497" :question/problem "For what value of $k$ are the lines $3x+4y=8$ and $kx+4y=-20$ parallel?" :question/worked-solution "For two lines to be parallel, they must have the same slope.\n\n- To find the slope of the line $3x+4y=8,$ we convert to slope-intercept form, as follows:\n\n$$\n\\begin{aligned}3x+4y & =8 \\\\ 4y & =-3x+8 \\\\ y & =-\\frac{3}{4}x+2\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope is $-\\frac{3}{4}.$\n\n- To find the slope of the line $kx+4y=-20,$ we convert to slope-intercept form, as follows:\n\n$$\n\\begin{aligned}kx+4y & =-20 \\\\ 4y & =-kx-20 \\\\ y & =-\\frac{k}{4}x-5\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope is $-\\frac{k}{4}.$\n\nSince the slopes of the two lines must be equal, we must have $-\\frac{k}{4}=-\\frac{3}{4}.$ We solve for $k:$\n\n$$\n\\begin{aligned}-\\frac{k}{4} & =-\\frac{3}{4} \\\\ \\frac{k}{4} & =\\frac{3}{4} \\\\ k & =3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570782 :knowledge-point/_questions [{:db/id #edb/ref 17592186105699 :knowledge-point/id #uuid "372bcfad-79d0-5758-a66b-efeacfb13762" :knowledge-point/title "Finding Exterior Angles With Multiple Polygons"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "138638a6-770e-57c5-8a80-cbf00d10a6a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{90}^{∘}" :db/id #edb/ref 17592186570162} {:answer/id #uuid "2c299815-f6ac-5d78-aa46-c51ec1f84214" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{110}^{∘}" :db/id #edb/ref 17592186570198} {:answer/id #uuid "78db8668-72cc-5dfd-9eea-dd112e17a29b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{120}^{∘}" :db/id #edb/ref 17592186570339} {:answer/id #uuid "a19382a0-cf6f-5da6-94fe-6b417af2e686" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{105}^{∘}" :db/id #edb/ref 17592186570409} {:answer/id #uuid "e66bb389-c035-5fd8-8777-f783cd56f28b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{100}^{∘}" :db/id #edb/ref 17592186570526}] :answer-field/correct {:answer/id #uuid "e66bb389-c035-5fd8-8777-f783cd56f28b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{100}^{∘}" :db/id #edb/ref 17592186570526} :answer-field/id #uuid "5339208d-786c-5398-99e5-c80478b4a3f9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186570613}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e8619f65-a151-5133-8a41-d7413e4c5c11" :question/math-academy-id "q-53020" :question/problem "![](images/d4/d4c1c22e521c157ee7e8d00e4ca545b98d04f56721c58c0b6ec46c2126e4f2ff.png)\n\nThe diagram shows a regular nonagon and a regular hexagon. Find the measure of the shaded angle." :question/worked-solution "The shaded angle is the sum of the measures of exterior angles of a regular nonagon and a regular hexagon.\n\n![](images/a6/a64e0e57966f7b99b6d0f0af843dff25b7a87ed77347643212e04b0f5b8f5cd7.png)\n\nFor any polygon, the exterior angles sum to ${360}^{∘}.$ In a regular nonagon, there are $9$ equivalent exterior angles, so each has a measure of \n\n$$\n\\frac{{360}^{∘}}{9}={40}^{∘}.\n$$\n\nLikewise, in a regular hexagon, there are $6$ equivalent exterior angles, so each has a measure of \n\n$$\n\\frac{{360}^{∘}}{6}={60}^{∘}.\n$$\n\nTherefore, the given angle has the following measure:\n\n$$\n{40}^{∘}+{60}^{∘}={100}^{∘}\n$$"}] [{:db/id #edb/ref 17592186111283 :knowledge-point/_questions [{:db/id #edb/ref 17592186110769 :knowledge-point/id #uuid "f6849b30-c5a6-53ba-8517-92c9526ce308" :knowledge-point/title "Calculating an Unknown Angle Given an Angle Bisector and Two Angle Measurements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8b2c4c8-9218-5197-ac90-bbe2896a07f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60^{∘}" :db/id #edb/ref 17592186109424} {:answer/id #uuid "b8f8ddf0-cb24-5339-a905-b66fc89041c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20^{∘}" :db/id #edb/ref 17592186109425} {:answer/id #uuid "dd0d791a-3358-57e6-b301-d711a6de8e5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100^{∘}" :db/id #edb/ref 17592186109426} {:answer/id #uuid "011de1fe-caac-5c91-b55e-8d6be5fc8c2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40^{∘}" :db/id #edb/ref 17592186109427} {:answer/id #uuid "71b386c4-cecb-5c40-bdf5-d3654ba70e35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80^{∘}" :db/id #edb/ref 17592186109428}] :answer-field/id #uuid "9cb33825-f6b4-5a02-92f8-a5cc94e7944a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186109423}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "aaca9847-9753-58fe-84ab-2f8380363186" :question/math-academy-id "q-53226" :question/problem "![](images/81/814d818ef2a9e33ed774e347d6cc50d2bd984b3e69d14eb5972036cafe883956.png)\n\nIn the figure above, $OD^(→)$ is the bisector of $∠COA$. If $m∠BOA = 140^{∘}$ and $m∠BOD = 80^{∘}$, find $m∠BOC$."}] [{:db/id #edb/ref 17592186234237 :knowledge-point/_questions [{:db/id #edb/ref 17592186059709 :knowledge-point/id #uuid "387a794f-17ea-5ea9-86a1-656a495f62cb" :knowledge-point/title "Solving Rational Equations with Binomials in Both Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f2ea1a6-10d2-55f9-9e1a-8b79ec9790f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{5}" :db/id #edb/ref 17592186570181} {:answer/id #uuid "2e253573-b142-5acf-8a8d-328d4bb8251e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186570203} {:answer/id #uuid "9bf7b9c3-f8f3-5c91-8b55-0252e40b80c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186570400} {:answer/id #uuid "af70ab77-7c59-59b2-95bf-8d3d88b0c70f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186570442} {:answer/id #uuid "e2462a8d-9dc3-538f-b979-1fc867a6f9a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186570519}] :answer-field/correct {:answer/id #uuid "1f2ea1a6-10d2-55f9-9e1a-8b79ec9790f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{5}" :db/id #edb/ref 17592186570181} :answer-field/id #uuid "056c679c-2e61-54c8-b853-453b05e59436" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186570579}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aa75fc9d-104d-5e12-b331-4d8ff3973336" :question/math-academy-id "q-67439" :question/problem "Solve the equation $-\\frac{2}{x+3}=\\frac{8}{x-1}.$" :question/worked-solution "First, we note that\n\n- $x=-3$ cannot be a solution since this would make the denominator on the left-hand side zero\n\n- $x=1$ cannot be a solution since this would make the denominator on the right-hand side zero\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n-\\frac{x+3}{2}=\\frac{x-1}{8}\n$$\n\nNext, we write both fractions using the least common denominator, $8.$ The equation becomes\n\n$$\n-\\frac{4x+12}{8}=\\frac{x-1}{8}.\n$$\n\nWe can now solve this equation with the addition and the multiplication principles:\n\n$$\n\\begin{aligned}(-8)\\cdot \\frac{4x+12}{-8} & =(-8)\\cdot \\frac{x-1}{8} \\\\ 4x+12 & =-x+1 \\\\ 4x+x & =1-12 \\\\ 5x & =-11 \\\\ (\\frac{1}{5})\\cdot (5x) & =(\\frac{1}{5})\\cdot (-11) \\\\ (\\cancel{\\frac{1}{5}})\\cdot (\\cancel{5}x) & =(\\frac{1}{5})\\cdot (-11) \\\\ x & =-\\frac{11}{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570790 :knowledge-point/_questions [{:db/id #edb/ref 17592186129107 :knowledge-point/id #uuid "02e29602-b3c0-5ceb-ab65-710c06a08c1d" :knowledge-point/title "Finding the Roots of a Function Given a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "860b304b-fdef-50c1-a8f9-1d4f7d6c80f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $x$ | $-5$ | $-3$ | $-1$ | $0$ | $1$ | $3$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $g(x)$ | $-5$ | $-5$ | $-5$ | $5$ | $5$ | $5$ | $5$ |" :db/id #edb/ref 17592186570359} {:answer/id #uuid "927cf730-faf8-54b2-8fed-fd747b35d27b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $x$ | $-5$ | $-3$ | $-1$ | $0$ | $1$ | $3$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $g(x)$ | $2$ | $3$ | $1$ | $0$ | $-3$ | $0$ | $2$ |" :db/id #edb/ref 17592186570382} {:answer/id #uuid "9b44e64a-ef11-5643-bba7-4edf2771b18c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $x$ | $-5$ | $-3$ | $-1$ | $0$ | $1$ | $3$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $g(x)$ | $-1$ | $0$ | $2$ | $3$ | $5$ | $2$ | $1$ |" :db/id #edb/ref 17592186570399} {:answer/id #uuid "aface0d3-28ef-5767-b68a-4f300ce0b8e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $x$ | $-5$ | $-3$ | $-1$ | $0$ | $1$ | $3$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $g(x)$ | $5$ | $4$ | $2$ | $1$ | $0$ | $3$ | $-5$ |" :db/id #edb/ref 17592186570443} {:answer/id #uuid "f46e3ec5-e5c2-53d7-b028-583a4e50a3ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $x$ | $-5$ | $-3$ | $-1$ | $0$ | $1$ | $3$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $g(x)$ | $0$ | $1$ | $4$ | $9$ | $5$ | $2$ | $0$ |" :db/id #edb/ref 17592186570557}] :answer-field/correct {:answer/id #uuid "f46e3ec5-e5c2-53d7-b028-583a4e50a3ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $x$ | $-5$ | $-3$ | $-1$ | $0$ | $1$ | $3$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $g(x)$ | $0$ | $1$ | $4$ | $9$ | $5$ | $2$ | $0$ |" :db/id #edb/ref 17592186570557} :answer-field/id #uuid "bb3e3723-e2fb-5d7d-804d-fb8906580c7f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186570669}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fadbbd96-8a4c-5964-b393-9b0639ffb5cd" :question/math-academy-id "q-82671" :question/problem "Which of the following tables describes a function that has $-5$ and $5$ as roots?" :question/worked-solution "The numbers $-5$ and $5$ are roots of $g(x)$ if $g(-5)=0$ and $g(5)=0.$  Of the given tables, only the following table has this property:\n\n| $x$ | $-5$ | $-3$ | $-1$ | $0$ | $1$ | $3$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $g(x)$ | $0$ | $1$ | $4$ | $9$ | $5$ | $2$ | $0$ |"}] [{:db/id #edb/ref 17592186570711 :knowledge-point/_questions [{:db/id #edb/ref 17592186179680 :knowledge-point/id #uuid "f1e9abbc-b0b5-51a6-b23b-a32a027382f3" :knowledge-point/title "Solving Equations Containing an Expression Raised to an Odd Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21bfb5c8-f1b5-5037-ac95-35350afae358" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186570185} {:answer/id #uuid "8e348a7d-563f-55ea-8112-8e81e97af76f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186570373} {:answer/id #uuid "db9bf25d-437b-5c50-b346-6e6a6df8cdff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186570509} {:answer/id #uuid "e4da1d39-17a3-5794-884b-8132e2024b79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186570523} {:answer/id #uuid "f62b1c4e-5723-5c47-8d07-8833ef1bf8b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186570560}] :answer-field/correct {:answer/id #uuid "21bfb5c8-f1b5-5037-ac95-35350afae358" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186570185} :answer-field/id #uuid "5fb51e4b-a7de-5bfc-88df-e0414848a022" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186570623}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2640409b-d45b-5385-980a-142f0264d172" :question/math-academy-id "q-91377" :question/problem "Find the real solution to the equation $7(x+8)^{3}=448.$" :question/worked-solution "We can solve this equation by isolating the $(x+8)^{3}$ term and then taking the $3$rd root of each side.\n\nFirst, let's isolate the $(x+8)^{3}$ term on the left-hand side:\n\n$$\n\\begin{aligned}7(x+8)^{3} & =448 \\\\ (x+8)^{3} & =64\\end{aligned}\n$$\n\nNow, we take the $3$rd root of each side and solve for $x.$ Since $n=3$ is odd, there is only one real solution to this equation:\n\n$$\n\\begin{aligned}(x+8)^{3} & =64 \\\\ \\sqrt[3]{(x+8)^{3}} & =\\sqrt[3]{64} \\\\ x+8 & =\\sqrt[3]{{4}^{3}} \\\\ x+8 & =4 \\\\ x & =-4\\end{aligned}\n$$\n\nTherefore, the solution is $x=-4.$"}]}
