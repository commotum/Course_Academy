33-25cc76a6e65e" #edb/ref 17592186045417] [17592186116396 #edb/ref 1063 #edb/ref 17592186116449 #edb/ref 17592186045417] [17592186116397 #edb/ref 1058 #edb/ref 17592186116398 #edb/ref 17592186045417] [17592186116397 #edb/ref 1061 9154 #edb/ref 17592186045417] [17592186116397 #edb/ref 1062 #uuid "52e4c58c-e58e-5223-98e5-cc31383de47c" #edb/ref 17592186045417] [17592186116397 #edb/ref 1063 #edb/ref 17592186115409 #edb/ref 17592186045417] [17592186116398 #edb/ref 1058 #edb/ref 17592186116399 #edb/ref 17592186045417] [17592186116398 #edb/ref 1061 9158 #edb/ref 17592186045417] [17592186116398 #edb/ref 1062 #uuid "b9f034d0-1d0e-54ea-83b8-ad683048d5c5" #edb/ref 17592186045417] [17592186116398 #edb/ref 1063 #edb/ref 17592186116450 #edb/ref 17592186045417] [17592186116399 #edb/ref 1058 #edb/ref 17592186116268 #edb/ref 17592186045417] [17592186116399 #edb/ref 1061 9160 #edb/ref 17592186045417] [17592186116399 #edb/ref 1062 #uuid "25c91feb-798e-5857-9090-3b36088bc71b" #edb/ref 17592186045417] [17592186116399 #edb/ref 1063 #edb/ref 17592186115410 #edb/ref 17592186045417] [17592186116449 #edb/ref 1064 "Consider $\\triangle ABC$ shown below. \n\n![](images/6f/6fdb9a8337d16f1ef1910989b3df92844c5393c33108f98ae7993cc939bed0b3.png)\n\nNow, let's draw a line segment that \n\n- runs from $\\color{blue}C$ to the line ${\\color{red}\\overset{\\longleftrightarrow}{AB}},$ and\n\n- is *perpendicular* to ${\\color{red}\\overset{\\longleftrightarrow}{AB}}.$\n\nThis line segment is the dashed segment shown below:\n\n![](images/4a/4a7ee2771c9b0c60dbb07c43b0439e822ea9b2c261ac41af9b44fec72b9f2a91.png)\n\nFinally, let's label the other endpoint of our segment ${\\color{blue}{H}}.$\n\n![](images/75/758eab533719220515460b6677054438a9ac0e2701d1a5267b973e526f63bd90.png)\n\nNote the following:\n\n- The line segment ${\\color{blue}\\overline{CH}}$ is called the **height** (or **altitude**) *corresponding to* ${\\color{red}\\overset{\\longleftrightarrow}{AB}}.$\n\n- The line $\\overset{\\longleftrightarrow}{AB}$ is called the **base** of the altitude ${\\color{blue}\\overline{CH}}.$\n\nAs we'll soon discover, the heights and their corresponding bases are important attributes of triangles." #edb/ref 17592186045417] [17592186116449 #edb/ref 1065 2232 #edb/ref 17592186045417] [17592186116449 #edb/ref 1066 #uuid "bdb9bfbd-b830-51f0-8712-5d34f83f2812" #edb/ref 17592186045417] [17592186116449 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186116450 #edb/ref 1064 "We can draw exactly three heights (or altitudes) in any triangle. However, sometimes the height lies outside the triangle.\n\nTo demonstrate, consider $\\triangle{ABC}$ below.\n\n![](images/df/df1ac2c1074305f8ead506d9aeb8c3927ad51ae5949b45976f1971b52d402ee5.png)\n\nThe height corresponding to $\\overline{BC}$ is a line segment that \n\n- runs from the opposite vertex $A$ to the line $\\overset{\\longleftrightarrow}{BC},$ and\n\n- is perpendicular to $\\overset{\\longleftrightarrow}{BC}.$\n\nIn this case, it's impossible to draw a perpendicular from $A$ to the *segment* $\\overline{BC}.$ However, we can first *extend* the line segment $\\overline{BC}$ as follows:\n\n![](images/26/26bf9eb8af1e9b71c263c08cae5797d5c911410985cdc01213ac2c295f7b8d46.png)\n\nNow, we draw the perpendicular from $A$ to $\\overset{\\longleftrightarrow}{BC}.$ This gives the height $\\overline{AH}{:}$\n\n![](images/89/894686fce1393ebcf998be6885020627c9f3cde5916adfec67234f15f8895826.png)" #edb/ref 17592186045417] [17592186116450 #edb/ref 1065 2236 #edb/ref 17592186045417] [17592186116450 #edb/ref 1066 #uuid "4031d801-f4b8-543f-ad4d-9ef60d513427" #edb/ref 17592186045417] [17592186116450 #edb/ref 1067 "Case of Extended Bases" #edb/ref 17592186045417] [17592186129106 #edb/ref 1037 #edb/ref 17592186048838 #edb/ref 17592186045417] [17592186129106 #edb/ref 1038 #edb/ref 17592186129650 #edb/ref 17592186045417] [17592186129106 #edb/ref 1038 #edb/ref 17592186129819 #edb/ref 17592186045417] [17592186129106 #edb/ref 1038 #edb/ref 17592186503