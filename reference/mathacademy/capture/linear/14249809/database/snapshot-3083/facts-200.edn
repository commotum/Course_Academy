6045417] [17592186179891 #edb/ref 1046 #edb/ref 17592186180403 #edb/ref 17592186045417] [17592186179891 #edb/ref 1049 #edb/ref 17592186049066 #edb/ref 17592186045417] [17592186179891 #edb/ref 1050 420.0 #edb/ref 17592186045417] [17592186179891 #edb/ref 1053 #uuid "5af1262a-1c56-58b3-9acb-3b64b5f1eea9" #edb/ref 17592186045417] [17592186180401 #edb/ref 1061 30069 #edb/ref 17592186045417] [17592186180401 #edb/ref 1062 #uuid "52ee7c85-875f-5a5f-af14-c666ff0b02e9" #edb/ref 17592186045417] [17592186180401 #edb/ref 1063 #edb/ref 17592186179680 #edb/ref 17592186045417] [17592186180402 #edb/ref 1058 #edb/ref 17592186180401 #edb/ref 17592186045417] [17592186180402 #edb/ref 1061 30121 #edb/ref 17592186045417] [17592186180402 #edb/ref 1062 #uuid "247ebd22-9eec-58a6-b24f-de774c47432e" #edb/ref 17592186045417] [17592186180402 #edb/ref 1063 #edb/ref 17592186179681 #edb/ref 17592186045417] [17592186180403 #edb/ref 1058 #edb/ref 17592186180402 #edb/ref 17592186045417] [17592186180403 #edb/ref 1061 30129 #edb/ref 17592186045417] [17592186180403 #edb/ref 1062 #uuid "c7f88cee-5451-591c-bcf6-e4c817bdbf06" #edb/ref 17592186045417] [17592186180403 #edb/ref 1063 #edb/ref 17592186180684 #edb/ref 17592186045417] [17592186180684 #edb/ref 1064 "How do we solve an equation with a variable raised to an odd exponent, such as\n\n$$\nx^3 = 125?\n$$\n\nWe can solve this equation by taking the $3$rd root of each side and solving for $x.$ \n\nSince $n=3$ is odd, there will be only one real solution:\n\n$$\n\\begin{aligned}{x}^{3} & =125 \\\\ \\sqrt[3]{{x}^{3}} & =\\sqrt[3]{125} \\\\ x & =\\sqrt[3]{{5}^{3}} \\\\ x & =5\\end{aligned}\n$$\n\nTherefore, the solution is $x=5.$\n\nIn general, we have the following rule of thumb:\n\n*When $n$ is odd, and we take the $n$th root of both sides of $x^n = a,$ we get only one solution:* \n\n$$\nx = \\sqrt[n]{a}\n$$" #edb/ref 17592186045417] [17592186180684 #edb/ref 1065 4834 #edb/ref 17592186045417] [17592186180684 #edb/ref 1066 #uuid "a3deb3f5-8f54-5126-a222-4b93