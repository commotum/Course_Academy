            },
            {
              "option": "b",
              "dom_id": "source-choice-2",
              "type": "math",
              "value": "p=\\pm 2",
              "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"false\"><mi>p</mi><mo>=</mo><mo>±</mo><mn>2</mn></math>"
            },
            {
