#{[{:db/id #edb/ref 17592186171804 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186172139 :knowledge-point/id #uuid "e2c73aa9-da5a-54e0-bd38-b173c3f707e3" :knowledge-point/title "Reflecting a Geometric Figure"}] :question/id #uuid "bfd38997-ac2b-52d0-a7f9-1078ca14cd6d" :question/math-academy-id "e-2881" :question/problem "Reflect the figure shown below across the line $l$.\n\n![](images/65/65fc37670764a572b0cfbbfd4dcd577bafc60e79ff68d5776b13ef54aa346f1e.png)" :question/worked-solution "To reflect a polygon across a line, we\n\n- reflect the vertices of the polygon, and then\n- draw the edges connecting the reflected vertices.\n\nTherefore, reflecting our polygon across the line $l$, we obtain the following result:\n\n![](images/1d/1dc3f898405c7b18b563711f0b0dcdbbcdd5d6c64e004ab3a754cf636abef0ca.png)"}] [{:db/id #edb/ref 17592186171805 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186172140 :knowledge-point/id #uuid "c328605f-900a-55c9-8668-98274d655af3" :knowledge-point/title "Identifying the Line of Reflection"}] :question/id #uuid "6c043675-70d4-53d6-b455-a5d5a2a30d9b" :question/math-academy-id "e-2901" :question/problem "The triangle $\\mathcal{T}$ is mapped to the triangle $\\mathcal{T'}$ under the action of a reflection. What is the equation of the line of reflection?\n\n![](images/1d/1de75f303ced7cfba310e4ef05a964453f7ffd279a9dec0050e9026b58a02ce7.png)" :question/worked-solution "The line of reflection is the perpendicular bisector of the segments joining each point to its image.\n\nTherefore, the line of reflection is\n\n$$\nx = \\dfrac{1}{2}\n$$\n\nas shown below.\n\n![](images/29/29eefc4587dbf48f003f351138d4ec2eaea36e2618c831348e4578ff32782ee8.png)"}] [{:db/id #edb/ref 17592186172545 :knowledge-point/_questions [{:db/id #edb/ref 17592186172139 :knowledge-point/id #uuid "e2c73aa9-da5a-54e0-bd38-b173c3f707e3" :knowledge-point/title "Reflecting a Geometric Figure"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "