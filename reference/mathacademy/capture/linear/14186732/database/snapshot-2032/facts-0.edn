86045417] [17592186105438 #edb/ref 1074 "A pentagon has $n=5$ sides. Therefore, the sum of the interior angles of a pentagon must be \n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={180}^{∘}\\cdot (5-2) \\\\  & ={180}^{∘}\\cdot 3 \\\\  & ={540}^{∘}.\\end{aligned}\n$$\n\nAdding up the internal angles and solving for $x,$ we get\n\n$$\n\\begin{aligned}m∠A+m∠B+m∠C+m∠D+m∠E & ={540}^{∘} \\\\ {120}^{∘}+{110}^{∘}+2x+{90}^{∘}+x+{40}^{∘} & ={540}^{∘} \\\\ 2x+x+{40}^{∘}+{120}^{∘}+{110}^{∘}+{90}^{∘} & ={540}^{∘} \\\\ 3x+{360}^{∘} & ={540}^{∘} \\\\ 3x & ={180}^{∘} \\\\ x & ={60}^{∘}\\,.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186105439 #edb/ref 1069 "e-10638" #edb/ref 17592186045417] [17592186105439 #edb/ref 1071 "The sum of the interior angles of a polygon is $720^\\circ.$ How many sides does it have?" #edb/ref 17592186045417] [17592186105439 #edb/ref 1072 #uuid "7d0dd769-07d8-58c6-a2c8-d6165ca5bb5a" #edb/ref 17592186045417] [17592186105439 #edb/ref 1074 "Remember that the sum of the interior angles of a polygon with $n$ sides is $180^\\circ \\cdot (n-2).$\n\nTo find the number of sides in our polygon, we start by setting up the following equation:\n\n$$\n180^\\circ \\cdot (n-2) = 720^\\circ\n$$\n\nNow, we solve for $n,$ as follows:\n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={720}^{∘} \\\\ n-2 & =\\frac{{720}^{∘}}{{180}^{∘}} \\\\ n-2 & =4 \\\\ n & =6\\end{aligned}\n$$\n\nTherefore, the polygon has $n=6$ sides (it is a hexagon)." #edb/ref 17592186045417] [17592186105440 #edb/ref 1069 "e-10772" #edb/ref 17592186045417] [17592186105440 #edb/ref 1071 "Which of the following could be the interior angles of a quadrilateral?\n\nI. $40^{\\circ}$, $50^{\\circ}$, $100^{\\circ}$, $170^{\\circ}$\n\nII. $20^{\\circ}$, $50^{\\circ}$, $150^{\\circ}$, $140^{\\circ}$\n\nIII. $30^{\\circ}$, $35^{\\circ}$, $140^{\\circ}$, $175^{\\circ}$" #edb/ref 17592186045417] [17592186105440 #edb/ref 1072 #uuid "757aacb7-c988-5f1f-9ae6-c69ebf1399ec" #edb/ref 17592186045417] [17592186105440 #edb/ref 1074 "A quadrilateral has $n=4$ sides. Therefore, the sum of the interior angles of a quadrilateral must be \n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={180}^{∘}\\cdot (4-2) \\\\  & ={180}^{∘}\\cdot 2 \\\\  & ={360}^{∘}.\\end{aligned}\n$$\n\nLet's check this for the above three options:\n\n$$\n\\begin{aligned}{40}^{∘}+{50}^{∘}+{100}^{∘}+{170}^{∘}={360}^{∘}\\,✓ \\\\  &  \\\\ {20}^{∘}+{50}^{∘}+{150}^{∘}+{140}^{∘}={360}^{∘}\\,✓ \\\\  &  \\\\ {30}^{∘}+{35}^{∘}+{140}^{∘}+{175}^{∘}={380}^{∘}\\,X\\end{aligned}\n$$\n\nTherefore, only options I and II could be the angles of a quadrilateral." #edb/ref 17592186045417] [17592186105717 #edb/ref 1037 #edb/ref 17592186049949 #edb/ref 17592186045417] [17592186105717 #edb/ref 1037 #edb/ref 17592186049993 #edb/ref 17592186045417] [17592186105717 #edb/ref 1037 #edb/ref 17592186050127 #edb/ref 17592186045417] [17592186105717 #edb/ref 1038 #edb/ref 17592186106132 #edb/ref 17592186045417] [17592186105717 #edb/ref 1038 #edb/ref 17592186106468 #edb/ref 17592186045417] [17592186105717 #edb/ref 1038 #edb/ref 17592186500366 #edb/ref 17592186045417] [17592186105717 #edb/ref 1039 "Identifying Possible Interior Angles of a Quadrilateral" #edb/ref 17592186045417] [17592186105717 #edb/ref 1041 #edb/ref 17592186105440 #edb/ref 17592186045417] [17592186105717 #edb/ref 1042 #uuid "3d6d5827-91a8-5fd4-85ea-7564e8f5396e" #edb/ref 17592186045417] [17592186105718 #edb/ref 1037 #edb/ref 17592186048673 #edb/ref 17592186045417] [17592186105718 #edb/ref 1037 #edb/ref 17592186050452 #edb/ref 17592186045417] [17592186105718 #edb/ref 1038 #edb/ref 17592186106315 #edb/ref 17592186045417] [17592186105718 #edb/ref 1038 #edb/ref 17592186106317 #edb/ref 17592186045417] [17592186105718 #edb/ref 1038 #edb/ref 17592186500330 #edb/ref 17592186045417] [17592186105718 #edb/ref 1038 #edb/ref 17592186500342 #edb/ref 17592186045417] [17592186105718 #edb/ref 1038 #edb/ref 17592186500365 #edb/ref 17592186045417] [17592186105718 #edb/ref 1038 #edb/ref 17592186500375 #edb/ref 17592186045417] [17592186105718 #edb/ref 1039 "Finding Unknown Quantities in Quadrilaterals and Pentagons" #edb/ref 17592186045417] [17592186105718 #edb/ref 1041 #edb/ref 17592186105438 #edb/ref 17592186045417] [17592186105718 #edb/ref 1042 #uuid "bad93a16-17d4-50ff-89c8-f3d966df5f1a" #edb/ref 17592186045417] [17592186105719 #edb/ref 1037 #edb/ref 17592186048354 #edb/ref 17592186045417] [17592186105719 #edb/ref 1038 #edb/ref 17592186106206 #edb/ref 17592186045417] [17592186105719 #edb/ref 1038 #edb/ref 17592186106207 #edb/ref 17592186045417] [17592186105719 #edb/ref 1038 #edb/ref 17592186500302 #edb/ref 17592186045417] [17592186105719 #edb/ref 1038 #edb/ref 17592186500305 #edb/ref 17592186045417] [17592186105719 #edb/ref 1038 #edb/ref 17592186500348 #edb/ref 17592186045417] [17592186105719 #edb/ref 1039 "Finding the Number of Sides of a Polygon Given the Sum of Its Interior Angles" #edb/ref 17592186045417] [17592186105719 #edb/ref 1041 #edb/ref 17592186105439 #edb/ref 17592186045417] [17592186105719 #edb/ref 1042 #uuid "0b111120-41dd-5a58-bcc5-b0b6fc78b384" #edb/ref 17592186045417] [17592186105973 #edb/ref 1043 #edb/ref 17592186106588 #edb/ref 17592186045417] [17592186105973 #edb/ref 1043 #edb/ref 17592186106589 #edb/ref 17592186045417] [17592186105973 #edb/ref 1043 #edb/ref 17592186106590 #edb/ref 17592186045417] [17592186105973 #edb/ref 1043 #edb/ref 17592186106591 #edb/ref 17592186045417] [17592186105973 #edb/ref 1043 #edb/ref 17592186106592 #edb/ref 17592186045417] [17592186105973 #edb/ref 1043 #edb/ref 17592186106593 #edb/ref 17592186045417] [17592186105973 #edb/ref 1043 #edb/ref 17592186106594 #edb/ref 17592186045417] [17592186105973 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186105973 #edb/ref 1045 "Interior Angles of Polygons" #edb/ref 17592186045417] [17592186105973 #edb/ref 1046 #edb/ref 17592186106588 #edb/ref 17592186045417] [17592186105973 #edb/ref 1049 #edb/ref 17592186049223 #edb/ref 17592186045417] [17592186105973 #edb/ref 1050 660.0 #edb/ref 17592186045417] [17592186105973 #edb/ref 1053 #uuid "2af93617-2850-5d80-8e89-a45566d1d99b" #edb/ref 17592186045417] [17592186106468 #edb/ref 1068 #edb/ref 17592186104956 #edb/ref 17592186045417] [17592186106468 #edb/ref 1069 "q-68022" #edb/ref 17592186045417] [17592186106468 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186106468 #edb/ref 1071 "Which of the following could be the interior angles of a quadrilateral?\n\nI. ${64}^{∘}$, ${73}^{∘}$, ${98}^{∘}$, ${124}^{∘}$\n\nII. ${73}^{∘}$, ${112}^{∘}$, ${93}^{∘}$, ${82}^{∘}$\n\nIII. ${80}^{∘}$, ${140}^{∘}$, ${49}^{∘}$, ${84}^{∘}$" #edb/ref 17592186045417] [17592186106468 #edb/ref 1072 #uuid "402ba7bd-dca2-507f-827e-423295d57d86" #edb/ref 17592186045417] [17592186106468 #edb/ref 1074 "A quadrilateral has $n=4$ sides. Therefore, the sum of the interior angles of a quadrilateral must be \n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={180}^{∘}\\cdot (4-2) \\\\  & ={180}^{∘}\\cdot 2 \\\\  & ={360}^{∘}.\\end{aligned}\n$$\n\nLet's check this for the above three options:\n\n$$\n\\begin{aligned}{64}^{∘}+{73}^{∘}+{98}^{∘}+{124}^{∘}={359}^{∘}\\,X \\\\  &  \\\\ {73}^{∘}+{112}^{∘}+{93}^{∘}+{82}^{∘}={360}^{∘}\\,✓ \\\\  &  \\\\ {80}^{∘}+{140}^{∘}+{49}^{∘}+{84}^{∘}={353}^{∘}\\,X\\end{aligned}\n$$\n\nTherefore, only option II could be the angles of a quadrilateral." #edb/ref 17592186045417] [17592186106588 #edb/ref 1058 #edb/ref 17592186106589 #edb/ref 17592186045417] [17592186106588 #edb/ref 1061 136665 #edb/ref 17592186045417] [17592186106588 #edb/ref 1062 #uuid "6daf0d6e-d3ca-5943-93ac-6a8d0ae04d45" #edb/ref 17592186045417] [17592186106588 #edb/ref 1063 #edb/ref 17592186107137 #edb/ref 17592186045417] [17592186106589 #edb/ref 1058 #edb/ref 17592186106590 #edb/ref 17592186045417] [17592186106589 #edb/ref 1061 136666 #edb/ref 17592186045417] [17592186106589 #edb/ref 1062 #uuid "55ff9455-d9c5-5dfd-b9aa-7d7ad79f0ad7" #edb/ref 17592186045417] [17592186106589 #edb/ref 1063 #edb/ref 17592186107138 #edb/ref 17592186045417] [17592186106590 #edb/ref 1058 #edb/ref 17592186106591 #edb/ref 17592186045417] [17592186106590 #edb/ref 1061 136667 #edb/ref 17592186045417] [17592186106590 #edb/ref 1062 #uuid "93903594-40c4-5f1f-b805-5569c124dd4b" #edb/ref 17592186045417] [17592186106590 #edb/ref 1063 #edb/ref 17592186105717 #edb/ref 17592186045417] [17592186106591 #edb/ref 1058 #edb/ref 17592186106592 #edb/ref 17592186045417] [17592186106591 #edb/ref 1061 136670 #edb/ref 17592186045417] [17592186106591 #edb/ref 1062 #uuid "9d73fd08-d0b3-549f-8356-26bd528a081c" #edb/ref 17592186045417] [17592186106591 #edb/ref 1063 #edb/ref 17592186107139 #edb/ref 17592186045417] [17592186106592 #edb/ref 1058 #edb/ref 17592186106593 #edb/ref 17592186045417] [17592186106592 #edb/ref 1061 136671 #edb/ref 17592186045417] [17592186106592 #edb/ref 1062 #uuid "66ba6652-6516-5c96-9fc2-f1a279bbcdce" #edb/ref 17592186045417] [17592186106592 #edb/ref 1063 #edb/ref 17592186105718 #edb/ref 17592186045417] [17592186106593 #edb/ref 1058 #edb/ref 17592186106594 #edb/ref 17592186045417] [17592186106593 #edb/ref 1061 136674 #edb/ref 17592186045417] [17592186106593 #edb/ref 1062 #uuid "7f2b2f6c-0f00-518c-8edf-15031fffc70c" #edb/ref 17592186045417] [17592186106593 #edb/ref 1063 #edb/ref 17592186105719 #edb/ref 17592186045417] [17592186106594 #edb/ref 1061 136677 #edb/ref 17592186045417] [17592186106594 #edb/ref 1062 #uuid "19ab5e9d-cd9a-5abe-b2d8-a8c2a4b0511a" #edb/ref 17592186045417] [17592186106594 #edb/ref 1063 #edb/ref 17592186107170 #edb/ref 17592186045417] [17592186107137 #edb/ref 1064 "The sum of the interior angles of *any* triangle equals $180^\\circ.$\n\n![](images/fc/fcc21c5e13ab095da35eeca128e3a82a075d649e205aa0e1683b6ab0e4a4cc4c.png)\n\nAs it turns out, there is a general rule for the sum of the interior angles that applies to all polygons:\n\n*The sum of the interior angles of a polygon with $n$ sides equals $180^\\circ \\cdot (n-2).$*\n\nFor example, every triangle has ${\\color{blue}3}$ sides. Let's substitute $n={\\color{blue}3}$ into the formula to check that it works:\n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={180}^{∘}\\cdot (3-2) \\\\  & ={180}^{∘}\\cdot 1 \\\\  & ={180}^{∘}\\,✓\\end{aligned}\n$$\n\nSo, the formula tells us that the sum of the interior angles of a triangle equals $180^\\circ,$ which we know is correct.\n\nLet's see some more examples." #edb/ref 17592186045417] [17592186107137 #edb/ref 1065 6654 #edb/ref 17592186045417] [17592186107137 #edb/ref 1066 #uuid "8edf1574-04d8-5aea-839f-9c03c16e6ab5" #edb/ref 17592186045417] [17592186107137 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186107138 #edb/ref 1064 "The sum of the interior angles of a polygon with $n$ sides equals \n\n$$\n180^\\circ \\cdot (n-2).\n$$\n\nEvery quadrilateral has $n={\\color{blue}4}$ sides. Applying the formula, we get\n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={180}^{∘}\\cdot (4-2) \\\\  & ={180}^{∘}\\cdot 2 \\\\  & ={360}^{∘}.\\end{aligned}\n$$\n\nSo, the formula tells us that the sum of the interior angles of a quadrilateral equals $360^\\circ.$ \n\n![](images/a0/a0d6cd7aa4b4e7aba6451b32087fa6cf86e0f63d2ff70e68328a5ac9d4eddcfc.png)" #edb/ref 17592186045417] [17592186107138 #edb/ref 1065 6688 #edb/ref 17592186045417] [17592186107138 #edb/ref 1066 #uuid "1de6f70b-9797-56cc-b325-b5375efaf06b" #edb/ref 17592186045417] [17592186107138 #edb/ref 1067 "The Sum of the Interior Angles of a Quadrilateral" #edb/ref 17592186045417] [17592186107139 #edb/ref 1064 "The sum of the interior angles of a polygon with $n$ sides equals \n\n$$\n180^\\circ \\cdot (n-2).\n$$\n\nEvery pentagon has $n={\\color{blue}5}$ sides. Applying the formula, we get\n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={180}^{∘}\\cdot (5-2) \\\\  & ={180}^{∘}\\cdot 3 \\\\  & ={540}^{∘}.\\end{aligned}\n$$\n\nSo, the formula tells us that the sum of the interior angles of a pentagon equals $540^\\circ.$ \n\n![](images/8d/8d0478edf5e40b947b06b7b6b0b726999b11ce39dc8af5daaf414f2bd2292647.png)\n\nWe can use the same formula to deduce the sum of the interior angles of hexagons, heptagons, octagons, and so forth." #edb/ref 17592186045417] [17592186107139 #edb/ref 1065 6738 #edb/ref 17592186045417] [17592186107139 #edb/ref 1066 #uuid "573fd3ba-e480-5a75-ba71-1fd15e977637" #edb/ref 17592186045417] [17592186107139 #edb/ref 1067 "The Sum of the Interior Angles of a Pentagon" #edb/ref 17592186045417] [17592186107170 #edb/ref 1064 "We've made use of the following theorem throughout this lesson. \n\n*The sum of the interior angles of a polygon with $n$ sides equals $180^\\circ \\cdot (n-2).$*\n\nThis formula works because any $n$-sided polygon can be split into $n-2$ triangles using diagonals that meet at one fixed vertex of the polygon. \n\nLet's illustrate this for a few different polygons.\n\n| ![](images/20/20aae267ba75bb418e509d548b1519af47b4cf9464d7f8400369c8e77b013aae.png) | **Quadrilateral** \n\nNumber of vertices: $4$ \n\nNumber of triangles: $4 - 2 = {\\color{blue}{2}}$ \n\nSum of interior angles: $180^\\circ \\cdot {\\color{blue}{2}} = 360^\\circ$ |\n| --- | --- |\n| ![](images/20/20551ad9f4661402aef9e501bf9d4c841e671b4277fae78f85d9e9ada9830592.png) | **Pentagon** \n\nNumber of vertices: $5$ \n\nNumber of triangles: $5 - 2 = {\\color{blue}{3}}$ \n\nSum of interior angles: $180^\\circ \\cdot {\\color{blue}{3}} = 540^\\circ$ |\n| ![](images/de/de8ec9be742a40384891de3a682a151e817f6c24d624e0ef505fb98ce6a1e60d.png) | **Hexagon** \n\nNumber of vertices: $6$ \n\nNumber of triangles: $6 - 2 = {\\color{blue}{4}}$ \n\nSum of interior angles: $180^\\circ \\cdot {\\color{blue}{4}} = 720^\\circ$ |\n\nThe sum of the interior angles of each polygon is the same as the sum of the interior angles of the corresponding triangles. \n\nEach triangle has interior angles that sum to $180^\\circ,$ and any $n$-sided polygon can be split into $n-2$ triangles in the manner shown above. Therefore, the sum of the interior angles in an $n$-sided polygon is\n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186107170 #edb/ref 1065 9114 #edb/ref 17592186045417] [17592186107170 #edb/ref 1066 #uuid "211863f5-73c2-57af-83e9-696d21971d5b" #edb/ref 17592186045417] [17592186107170 #edb/ref 1067 "Justification of the Formula" #edb/ref 17592186045417] [17592186499680 #edb/ref 1080 "{80}^{∘}" #edb/ref 17592186045417] [17592186499680 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186499680 #edb/ref 1083 #uuid "0b613f31-e2c5-54ca-8eed-1d150fe3f521" #edb/ref 17592186045417] [17592186499682 #edb/ref 1080 "{90}^{∘}" #edb/ref 17592186045417] [17592186499682 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186499682 #edb/ref 1083 #uuid "0bdd6ddc-e134-5ed6-a34d-22c067bb9953" #edb/ref 17592186045417] [17592186499701 #edb/ref 1080 "{35}^{∘}" #edb/ref 17592186045417] [17592186499701 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186499701 #edb/ref 1083 #uuid "14c882a4-ff2e-52f0-b361-1b4fc56ae096" #edb/ref 17592186045417] [17592186499702 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186499702 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186499702 #edb/ref 1083 #uuid "14fab282-cea6-54d6-9c7b-6abd288a09e4" #edb/ref 17592186045417] [17592186499709 #edb/ref 1080 "III only" #edb/ref 17592186045417] [17592186499709 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186499709 #edb/ref 1083 #uuid "1a7898a6-14af-555e-8c57-5a5e410541d1" #edb/ref 17592186045417] [17592186499712 #edb/ref 1080 "15" #edb/ref 17592186045417] [17592186499712 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186499712 #edb/ref 1083 #uuid "1ab977e1-87f4-5761-86af-f2fe440d0bfd" #edb/ref 17592186045417] [17592186499756 #edb/ref 1080 "{45}^{∘}" #edb/ref 17592186045417] [17592186499756 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186499756 #edb/ref 1083 #uuid "2fa004c3-5d69-511c-9a6f-4fd59bec35fd