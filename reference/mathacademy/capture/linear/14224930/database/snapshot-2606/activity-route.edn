#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186542266} :activity/id #uuid "145d3d35-c099-5702-aef3-70140b3f4e4e" :activity/steps [{:db/id #edb/ref 17592186542230 :step/content {:db/id #edb/ref 17592186542222 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "487f9cd5-aca0-5110-a351-1c3d45518748" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in [0,7]" :db/id #edb/ref 17592186541573} {:answer/id #uuid "60ed0177-10a3-5141-8f0d-6b2603ad36d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (0,7]" :db/id #edb/ref 17592186541621} {:answer/id #uuid "a7f3d4df-e271-59b6-b3ae-010d04a7214b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in [-7,0)" :db/id #edb/ref 17592186541767} {:answer/id #uuid "d20e5b5b-a9db-58d3-92e2-e77645249c59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (0,7)" :db/id #edb/ref 17592186541868} {:answer/id #uuid "eb83e406-5d7f-5868-bb88-3e5884a89c66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in [0,7)" :db/id #edb/ref 17592186541921}] :answer-field/correct {:db/id #edb/ref 17592186541621} :answer-field/id #uuid "2e9148e1-c517-584b-81ce-f179a876160f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186541986}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "eee859cf-032a-5a34-a81e-4f392e60f1ec" :question/math-academy-id "q-102205" :question/problem "The inequality $0<x\\le 7$ can be expressed in interval notation as" :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses $()$ if the endpoints are *not* included.\n\n- Brackets $[]$ if the endpoints *are* included.\n\nFor the given inequality \n\n$$\n0\\,\\,<\\,\\,x\\,\\,\\le \\,\\,7\n$$\n\nwe note the following:\n\n- The left endpoint $0$ is *not* included in the interval. Therefore, we use $(\\,.$\n\n- The right endpoint $7$ *is* included in the interval. Therefore, we use $]\\,.$\n\nTherefore, the corresponding interval is\n\n$$\nx\\in (0,7].\n$$"} :step/id #uuid "016be58b-34c7-56e0-bb25-ce68f3db4b2d" :step/next {:db/id #edb/ref 17592186542236}} {:db/id #edb/ref 17592186542231 :step/content {:db/id #edb/ref 17592186542159 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fab75dc-4f3e-52db-a0cc-5aaa48d05e73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5:2" :db/id #edb/ref 17592186541614} {:answer/id #uuid "6164133d-ab71-544e-b707-ee1cdfd93d9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12:7" :db/id #edb/ref 17592186541622} {:answer/id #uuid "8c43a522-e9ee-5ff5-955f-7fa9936b8815" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5:7" :db/id #edb/ref 17592186541705} {:answer/id #uuid "a2846c32-c82b-5b7d-b57a-377fe83617dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7:5" :db/id #edb/ref 17592186541759} {:answer/id #uuid "c2a8b31e-f9b4-5ed6-bd93-9574693c1c7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4:3" :db/id #edb/ref 17592186541832}] :answer-field/correct {:db/id #edb/ref 17592186541759} :answer-field/id #uuid "fa9c72a6-010c-59fe-8341-86fe3d0c838b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542104}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6ca180bb-426b-5acf-99a3-c4512087f7c5" :question/math-academy-id "q-64174" :question/problem "![](images/2d/2d3fc4b568492c8435f72c28010c21b0c0746e2abe46922fdb942eaba5cf8b05.png)\n\nWhat $x:y$ ratio is shown in the graph above?" :question/worked-solution "We see that the point $(7,5)$ lies on the graph. Let's write the ratio $7:5$ as a fraction:\n\n$$\n\\frac{7}{5}\n$$\n\nWe can not simplify this fraction further. Hence, we can say that the graph shows the ratio $7:5.$"} :step/id #uuid "05c3145b-6657-521b-9f88-78380cc745b3" :step/next {:db/id #edb/ref 17592186542250}} {:db/id #edb/ref 17592186542232 :step/content {:db/id #edb/ref 17592186542147 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f03e8ba-15b1-5ceb-9f37-91bebc4eb5aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186541583} {:answer/id #uuid "63083205-3b2c-5bcd-81e6-ff997c6c0c5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186541628} {:answer/id #uuid "9dd8f733-31e8-5469-a772-f0c2bce876e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186541750} {:answer/id #uuid "c3a6cdb5-bb1f-5d2a-a186-55d7223adb10" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186541833} {:answer/id #uuid "ec996c53-a1e7-585d-b640-0dfebe682167" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186541923}] :answer-field/correct {:db/id #edb/ref 17592186541628} :answer-field/id #uuid "3ef3b252-7a41-5683-98fb-90a69fdfa0b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186541999}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5270a65a-9011-5c4a-8ec5-b8423546a5ab" :question/math-academy-id "q-70119" :question/problem "Evaluate $\\frac{3(2x-4)}{4(5-x)}$ for $x=6.$" :question/worked-solution "We replace $x$ with $6$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{3(2x-4)}{4(5-x)} & = \\\\ \\frac{3(2(6)-4)}{4(5-6)} & = \\\\ \\frac{3(8)}{4(-1)} & = \\\\ \\frac{24}{-4} & = \\\\ -6\\end{aligned}\n$$"} :step/id #uuid "0a65f657-f98a-5a67-89c2-bc016942eb55" :step/next {:db/id #edb/ref 17592186542240}} {:db/id #edb/ref 17592186542236 :step/content {:db/id #edb/ref 17592186542151 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7af24af-4c8d-5f43-b558-8db7ccd96709" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186541939}] :answer-field/correct {:db/id #edb/ref 17592186541939} :answer-field/id #uuid "3f4ee068-a4ba-5955-9803-7974762ed968" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186542000}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "651d48b6-dcdd-5bc2-87b4-a66ffecf04ac" :question/math-academy-id "q-175589" :question/problem "If $\\frac{1}{15}=-\\frac{m}{3},$ then $m=${{field-1}}." :question/worked-solution "First, let's swap the left and right-hand sides so that the variable is on the left-hand side.\n\n$$\n-\\frac{m}{3}=\\frac{1}{15}\n$$\n\nThen, we remove the negative sign from the variable. To do this, we multiply both sides of the equation by $-1.$\n\n$$\n\\begin{aligned}-\\frac{m}{3} & =\\frac{1}{15} \\\\ (-1)\\cdot (-\\frac{m}{3}) & =(-1)\\cdot \\frac{1}{15} \\\\ \\frac{m}{3} & =-\\frac{1}{15}\\end{aligned}\n$$\n\nIn the equation above, $m$ is being divided by $3.$ To isolate $m$, we can perform the opposite operation, which is *multiplying* by $3.$ So, we multiply both sides of the equation by $3$ and simplify.\n\n$$\n\\begin{aligned}\\frac{m}{3} & =-\\frac{1}{15} \\\\ 3\\cdot \\frac{m}{3} & =3\\cdot (-\\frac{1}{15}) \\\\ \\frac{3m}{3} & =-\\frac{3}{15} \\\\ \\frac{\\cancel{3}m}{\\cancel{3}} & =-\\frac{1}{5} \\\\ m & =-\\frac{1}{5}\\end{aligned}\n$$"} :step/id #uuid "13dd978b-1f46-5e2b-91cd-11bd806fc55d" :step/next {:db/id #edb/ref 17592186542231}} {:db/id #edb/ref 17592186542240 :step/content {:db/id #edb/ref 17592186542142 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aa4e6a0-3aeb-559f-96d7-bd92f700b296" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{4}x+2" :db/id #edb/ref 17592186541445} {:answer/id #uuid "b490045f-fa26-53d0-83e1-8ad88e404827" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}x+2" :db/id #edb/ref 17592186541793} {:answer/id #uuid "b7410f52-b281-5541-8a42-cabcaa3e3486" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}x+2" :db/id #edb/ref 17592186541800} {:answer/id #uuid "fdae0bda-2f60-5c1b-bf1e-e3f18a773891" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}x-2" :db/id #edb/ref 17592186541954} {:answer/id #uuid "fe0f995b-cc21-5f36-9851-e5fb6941662d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186541956}] :answer-field/correct {:db/id #edb/ref 17592186541445} :answer-field/id #uuid "41165c67-5f21-5f55-b678-99fd5befca9d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542001}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "49e631ed-e489-57e1-8328-8ad962002fdf" :question/math-academy-id "q-75382" :question/problem "$3+\\frac{3}{2}x-1-\\frac{7}{4}x=$" :question/worked-solution "We collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}3+\\frac{3x}{2}-1-\\frac{7x}{4} & = \\\\ (\\frac{3x}{2}-\\frac{7x}{4})+(3-1) & = \\\\ (\\frac{6}{4}-\\frac{7}{4})x+(3-1) & = \\\\ (\\frac{6-7}{4})x+2 & = \\\\ -\\frac{1}{4}x+2\\end{aligned}\n$$"} :step/id #uuid "238578fd-c90c-54cc-b558-55ce62403117" :step/next {:db/id #edb/ref 17592186542269}} {:db/id #edb/ref 17592186542247 :step/content {:db/id #edb/ref 17592186138753 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be3c585c-88dd-5f80-a36b-2d6e93e57be1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10.255" :db/id #edb/ref 17592186541820}] :answer-field/correct {:db/id #edb/ref 17592186541820} :answer-field/id #uuid "b4e4318f-48a8-53c6-99cd-662866f667a9" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186135517} {:answer-field/choices [{:answer/id #uuid "a1554ed6-8431-5d28-996f-2deb66c4b977" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10.245" :db/id #edb/ref 17592186541757}] :answer-field/correct {:db/id #edb/ref 17592186541757} :answer-field/id #uuid "7ed79917-ae5a-54e2-98a4-9e0cb7ff5a5f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186135518}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aa0fbe16-9c2a-5cfb-9ced-d072cc5a440e" :question/math-academy-id "q-218714" :question/problem "The volume $v$ of acid in a test tube measures $10.25\\,\\text{mL}$ to the nearest hundredth of a milliliter. Determine the upper and lower bounds of this measurement.\n\n{{field-1}}$\\text{mL}$\n$\\,\\le v<$\n{{field-2}}$\\text{mL}$" :question/worked-solution "Our measurement is given to the nearest $0.01\\,\\text{mL}.$ So, the greatest possible error of this measurement is\n\n$$\n\\frac{0.01\\,\\text{mL}}{2}=0.005\\,\\text{mL}.\n$$\n\nTherefore, we can calculate the lower and upper bounds of this measurement as follows:\n\n$$\n\\begin{aligned}\\text{lower bound} & =10.25\\,\\text{mL}-0.005\\,\\text{mL} \\\\  & =10.245\\,\\text{mL} \\\\ \\text{upper bound} & =10.25\\,\\text{mL}+0.005\\,\\text{mL} \\\\  & =10.255\\,\\text{mL}\\end{aligned}\n$$\n\nSince the exact value of $v$ lies between the lower and upper bound, we conclude that\n\n$$\n10.245\\,\\text{mL}\\le v<10.255\\,\\text{mL}.\n$$"} :step/id #uuid "31915826-2175-53bc-9331-33006aaf0069" :step/next {:db/id #edb/ref 17592186542264}} {:db/id #edb/ref 17592186542250 :step/content {:db/id #edb/ref 17592186542120 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ca874c1-4215-5fa3-9f9b-fc5a7fcfea4f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$70.25$" :db/id #edb/ref 17592186541479} {:answer/id #uuid "24b8c98f-8ea6-5177-8cce-121d4ea2ad13" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$71.00$" :db/id #edb/ref 17592186541498} {:answer/id #uuid "52d1a82b-37fe-5eb7-b559-3be5ae2a38d5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$68.96$" :db/id #edb/ref 17592186541591} {:answer/id #uuid "be402325-f576-53ec-ac7a-edffe8a73154" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$69.50$" :db/id #edb/ref 17592186541821} {:answer/id #uuid "e7964137-d215-566b-8387-07ced5b59223" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$66.35$" :db/id #edb/ref 17592186541912}] :answer-field/correct {:db/id #edb/ref 17592186541591} :answer-field/id #uuid "471f8877-1cd7-5a08-8ddd-83f1e22878b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542005}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "16908ce6-e741-598e-9537-76866b0601d0" :question/math-academy-id "q-326520" :question/problem "A backpack costs $$64$ before tax. If a $7.75%$ sales tax is applied, what is the total price after tax?" :question/worked-solution "To find the total price after tax, we apply a $7.75%$ increase to the original price.\n\nIncreasing by $7.75%$ means that we must apply a new percentage of\n\n$$\n100%+7.75%=107.75%=1.0775\n$$\n\nNow, we multiply the original price by $1.0775:$\n\n$$\n64\\times 1.0775=68.96.\n$$\n\nSo, the total price of the backpack after tax is $$68.96.$"} :step/id #uuid "3c693221-729c-566b-98f4-3284a540a9dc" :step/next {:db/id #edb/ref 17592186542247}} {:db/id #edb/ref 17592186542253 :step/content {:db/id #edb/ref 17592186542154 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92a411b8-db16-53b9-9023-1e2885ea56ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-24" :db/id #edb/ref 17592186541724}] :answer-field/correct {:db/id #edb/ref 17592186541724} :answer-field/id #uuid "b6427fee-9638-5bb5-9dd9-2d2aacd365d5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186542049}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "69122235-d824-5d29-8715-1c0104966b58" :question/math-academy-id "q-178632" :question/problem "The additive inverse of $24$ is{{field-1}}." :question/worked-solution "To find the additive inverse of the number $24$, we change its sign by placing a minus symbol $(-)$ in front of it. So, we obtain \n\n$$\n-\\,(24)=-24.\n$$\n\nTo check our work, we simply add the inverse to the original number. If we're correct, we should get zero.\n\n$$\n24+(-24)=24-24=0\\,✓\n$$"} :step/id #uuid "4e37dfac-86f5-5175-88bd-f25e50366f0c"} {:db/id #edb/ref 17592186542264 :step/content {:db/id #edb/ref 17592186542170 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff07cacd-7a6b-524d-9691-0f6ed1e2ea8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "27" :db/id #edb/ref 17592186541959}] :answer-field/correct {:db/id #edb/ref 17592186541959} :answer-field/id #uuid "575678ef-cc64-5787-8f72-c733f23afefd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186542010}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9169a9eb-58fd-54ef-9fd7-4f2515dd156b" :question/math-academy-id "q-215792" :question/problem "If $p=-1,$ then $|4p+1{|}^{3}=${{field-1}}." :question/worked-solution "We substitute $p=-1$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|4p+1{|}^{3} & = \\\\ |4(-1)+1{|}^{3} & = \\\\ |-4+1{|}^{3} & = \\\\ |-3{|}^{3} & = \\\\ (3)^{3} & = \\\\ 27\\end{aligned}\n$$"} :step/id #uuid "79088bd5-79e2-5c98-8986-fdff7cce2c37" :step/next {:db/id #edb/ref 17592186542253}} {:db/id #edb/ref 17592186542266 :step/content {:db/id #edb/ref 17592186542158 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bb75cad-69d3-58ee-902d-2f04ec5f09c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186541447} {:answer/id #uuid "1a557119-a04d-5392-9590-db6f76a17677" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186541476} {:answer/id #uuid "6e41045a-a43e-5e74-a7e6-2a3baefd2866" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-32" :db/id #edb/ref 17592186541644} {:answer/id #uuid "8d699824-ccbe-55f1-8873-b9e9fbb3e86f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186541707} {:answer/id #uuid "9092158c-68be-5a62-8f08-860cc48b4867" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Undefined" :db/id #edb/ref 17592186541717}] :answer-field/correct {:db/id #edb/ref 17592186541476} :answer-field/id #uuid "cccbddba-c813-58ff-9619-9ede97166f31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542063}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6c864496-70bc-5f2d-82d0-559a3bc9072f" :question/math-academy-id "q-100186" :question/problem "Simplify $(-32)^{0}.$" :question/worked-solution "Any number raised to the power of zero is equal to $1.$ So, \n\n$$\n(-32)^{0}=1.\n$$"} :step/id #uuid "812ebbc0-927b-532b-8066-bca58087a68a" :step/next {:db/id #edb/ref 17592186542232}} {:db/id #edb/ref 17592186542269 :step/content {:db/id #edb/ref 17592186134342 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88a5e8d7-e357-5e52-8c8c-4c5f7fb5d892" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\sqrt{3}" :db/id #edb/ref 17592186132092} {:answer/id #uuid "9c9f5491-640f-56a8-87df-1fc6140600e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186132093} {:answer/id #uuid "fe5ea0fb-e4ab-5767-aaa5-bb5679cad6d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9\\sqrt{5}" :db/id #edb/ref 17592186132094} {:answer/id #uuid "ff7e253e-24d5-5827-9610-1e501f132837" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{15}" :db/id #edb/ref 17592186132095} {:answer/id #uuid "093444ce-1ff0-5d8f-9872-23b8691fc333" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186132096}] :answer-field/correct {:db/id #edb/ref 17592186132093} :answer-field/id #uuid "a9d698be-f6f6-573b-bff7-d3067d25c6aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186132091}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aa750f2f-bb5d-50ec-92a0-7178953006ed" :question/math-academy-id "q-41320" :question/problem "Evaluate $\\sqrt{7x-4}$ for $x=7.$" :question/worked-solution "We replace $x$ with $7$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}\\sqrt{7x-4} & = \\\\ \\sqrt{7\\cdot 7-4} & = \\\\ \\sqrt{49-4} & = \\\\ \\sqrt{45}\\end{aligned}\n$$\n\nWe can simplify even further using the product rule:\n\n$$\n\\begin{aligned}\\sqrt{45} & = \\\\ \\sqrt{9\\cdot 5} & = \\\\ \\sqrt{{3}^{2}\\cdot 5} & = \\\\ \\sqrt{{3}^{2}}\\cdot \\sqrt{5} & = \\\\ 3\\sqrt{5}\\end{aligned}\n$$"} :step/id #uuid "876f63bb-bea4-5e01-98fe-b3a500042494" :step/next {:db/id #edb/ref 17592186542280}} {:db/id #edb/ref 17592186542280 :step/content {:db/id #edb/ref 17592186064746 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3688d49a-8533-5c2a-bb88-92312001ffa2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x+6)}^{2}" :db/id #edb/ref 17592186541536} {:answer/id #uuid "3a1ce303-f436-5ddb-8e1d-0041ee4f763d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x+3)^{2}" :db/id #edb/ref 17592186541549} {:answer/id #uuid "5d507733-ce93-5b3b-900f-5ffc45f84dab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x+81)^{2}" :db/id #edb/ref 17592186541610} {:answer/id #uuid "af7a1ec4-cf1a-56ea-b663-65069724d8bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x-9)}^{2}" :db/id #edb/ref 17592186541783} {:answer/id #uuid "b4dc61be-f756-58b1-a8f4-a638c0bed511" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x+9)^{2}" :db/id #edb/ref 17592186541794}] :answer-field/correct {:db/id #edb/ref 17592186541794} :answer-field/id #uuid "f78e93f4-a940-5b7f-9bc8-09ad9c6788ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186062533}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f2a9e840-8160-58f9-9a96-756dab4d778a" :question/math-academy-id "q-31857" :question/problem "Factor ${x}^{2}+18x+81.$" :question/worked-solution "The \"square of a sum\" formula states that\n\n$$\n{x}^{2}+2ax+{a}^{2}=(x+a)^{2}.\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n{x}^{2}+18x+81.\n$$\n\nFirst, we write the constant term as a perfect square:\n\n$$\n\\begin{aligned}{x}^{2}+18x+{9}^{2}\\end{aligned}\n$$\n\nThen, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}{x}^{2}+2\\cdot 9x+{9}^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of sum formula with $a=9.$ This gives\n\n$$\n\\begin{aligned}(x+9)^{2}.\\end{aligned}\n$$"} :step/id #uuid "fdc6fa8c-fa41-52b8-916a-a8f78bbd10d0" :step/next {:db/id #edb/ref 17592186542281}} {:db/id #edb/ref 17592186542281 :step/content {:db/id #edb/ref 17592186542135 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13222a6f-012f-5b93-a152-dcbb407a165a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{3}+12{y}^{2}" :db/id #edb/ref 17592186541460} {:answer/id #uuid "64919853-e1e4-5b77-bdc8-8edcf53889dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{3}+4xy-3{x}^{2}y+12{y}^{2}" :db/id #edb/ref 17592186541630} {:answer/id #uuid "83e3ff62-308c-5bca-b296-5156cbfaf36a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{3}+4xy+3{x}^{2}y+12{y}^{2}" :db/id #edb/ref 17592186541690} {:answer/id #uuid "93caafae-8ef1-5347-b1d8-6a4a383a7b02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{3}+4xy-3{x}^{2}y-12{y}^{2}" :db/id #edb/ref 17592186541728} {:answer/id #uuid "bbda9460-e5ed-5f4f-8e0b-ba7b20413496" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{3}-12{y}^{2}" :db/id #edb/ref 17592186541813}] :answer-field/correct {:db/id #edb/ref 17592186541728} :answer-field/id #uuid "ca8079df-5f8f-5314-942f-74ff8f9992ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542062}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3c104695-c936-5d0f-b4ab-74c8ede24e1a" :question/math-academy-id "q-61969" :question/problem "$(x-3y)({x}^{2}+4y)=$" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(x-3y)({x}^{2}+4y) & = \\\\ x({x}^{2}+4y)-3y({x}^{2}+4y) & = \\\\ {x}^{3}+4xy-3{x}^{2}y-12{y}^{2}\\end{aligned}\n$$\n\nWe cannot simplify the above expression any further because there are no like terms."} :step/id #uuid "ff4cb2b5-d9a6-59ba-963c-0aa10dc966cd" :step/next {:db/id #edb/ref 17592186542230}}] :activity/title "Quiz 11" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186541417}]}
