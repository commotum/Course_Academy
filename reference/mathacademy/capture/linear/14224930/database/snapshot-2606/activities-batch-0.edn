b/id #edb/ref 17592186048868 :topic/id #uuid "c7dda967-adbc-5d28-94d6-a574e5483086" :topic/math-academy-id 2184} :activity/steps [{:db/id #edb/ref 17592186496365 :step/content {:db/id #edb/ref 17592186496293 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "655e9f8a-99c6-542e-bec2-084d448a9418" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186495735} {:answer/id #uuid "83fbce6e-87bb-5e0c-a0c3-6b6e1a2ba629" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186495793} {:answer/id #uuid "972195d4-2903-51a7-83ec-a9b9e22afa04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\sqrt{3}}{3}" :db/id #edb/ref 17592186495848} {:answer/id #uuid "f5c54a6b-f8fc-5a8d-915e-56317c3cbc76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186496045} {:answer/id #uuid "f9d08d61-2fdd-54ec-b10c-73a52d207beb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186496055}] :answer-field/correct {:db/id #edb/ref 17592186495735} :answer-field/id #uuid "644279da-6e68-51b9-8779-34237a1405c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496128}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a33bcbcb-8c75-50ac-adb2-e56b319ae036" :question/math-academy-id "q-110883" :question/problem "Given $h(x)=\\frac{\\sqrt{2x+6}}{\\sqrt{2x-1}},$ find $h(5).$" :question/worked-solution "We replace $x$ with $5$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}h(5) & =\\frac{\\sqrt{2(5)+6}}{\\sqrt{2(5)-1}} \\\\  & =\\frac{\\sqrt{10+6}}{\\sqrt{10-1}} \\\\  & =\\frac{\\sqrt{16}}{\\sqrt{9}} \\\\  & =\\frac{4}{3}\\end{aligned}\n$$"} :step/id #uuid "9521dc72-95fd-5b99-9ee6-2cc815dfa07f" :step/next {:db/id #edb/ref 17592186496383}} {:db/id #edb/ref 17592186496373 :step/content {:db/id #edb/ref 175921