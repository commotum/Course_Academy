 17592186045498} :answer/value "2\\sqrt[3]{6}" :db/id #edb/ref 17592186495570} {:answer/id #uuid "6c922236-31af-5996-9c74-c387180cbf5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\sqrt[3]{3}" :db/id #edb/ref 17592186495749} {:answer/id #uuid "8e8abba6-8d33-582a-b745-99b175925a46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186495822} {:answer/id #uuid "c12064ba-3ce2-5917-bf15-83f64346a24a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186495933} {:answer/id #uuid "d1987438-6c46-55eb-8e91-3ecdd71e97a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt[3]{4}" :db/id #edb/ref 17592186495968}] :answer-field/correct {:db/id #edb/ref 17592186495822} :answer-field/id #uuid "eb373ce3-e8bd-579b-8051-9b912f1cd1ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496205}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c6b5a56c-98c8-5d43-970c-b65710fedbd3" :question/math-academy-id "q-110892" :question/problem "Evaluate $\\sqrt[3]{7r+1}$ at $r=9.$" :question/worked-solution "We replace $r$ with $9$ in the given expression, and simplify as much as possible:\n\n$$\n\\begin{aligned}\\sqrt[3]{7r+1} & = \\\\ \\sqrt[3]{7(9)+1} & = \\\\ \\sqrt[3]{63+1} & = \\\\ \\sqrt[3]{64} & = \\\\ \\sqrt[3]{{4}^{3}} & = \\\\ 4\\end{aligned}\n$$"} :step/id #uuid "d3ae019d-3691-5b62-babc-9366ec2c3c50"} {:db/id #edb/ref 17592186496385 :step/content {:db/id #edb/ref 17592186496257 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dab17f9-ac22-5b75-8783-b52b67743213" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186495616} {:answer/id #uuid "ae36fff1-0086-53b3-8ccf-68ca8561af6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186495901} {:answer/id #uuid "ca4f137d-8bf7-5971-bebc-50b3d830afe7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186495952} {:answer/id #uuid "d8236676-eb79-576e-9082-b3357e3fa004" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186495987} {:answer/id #uuid "e32e104e-2aac-5934-b393-8c62f7b1409a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186496014}] :answer-field/correct {:db/id #edb/ref 17592186496014} :answer-field/id #uuid "0e139fa0-76a4-5594-9a74-4a4f77cb4697" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496078}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "573468a3-fb63-5275-a038-70008c621f95" :question/math-academy-id "q-52512" :question/problem "Given $h(x)=\\frac{\\sqrt{2x+7}}{\\sqrt{x-7}},$ find $h(10).$" :question/worked-solution "We replace $x$ with $10$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}h(10) & =\\frac{\\sqrt{2x+7}}{\\sqrt{x-7}} \\\\  & =\\frac{\\sqrt{2(10)+7}}{\\sqrt{10-7}} \\\\  & =\\frac{\\sqrt{27}}{\\sqrt{3}} \\\\  & =\\sqrt{\\frac{27}{3}} \\\\  & =\\sqrt{9} \\\\  & =3\\end{aligned}\n$$"} :step/id #uuid "e6f4c530-f04a-5bc2-97fa-36f196867ced" :step/next {:db/id #edb/ref 17592186496373}} {:db/id #edb/ref 17592186496388 :step/content {:db/id #edb/ref 17592186496302 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4218e341-ec0e-58d8-ace2-9ffbfc437a65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\sqrt{3}" :db/id #edb/ref 17592186495662} {:answer/id #uuid "4f5cadc9-e3f7-5691-bddf-0c37a865c6eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\sqrt{3}" :db/id #edb/ref 17592186495693} {:answer/id #uuid "990ec7ed-3f19-5a4a-ad58-9fa197948fcb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\sqrt{2}" :db/id #edb/ref 17592186495853} {:answer/id #uuid "f01f2406-67a2-5187-84d4-8c436902d153" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186496036} {:answer/id #uuid "f72c64eb-800b-5870-8d96-1200b7f9c0d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186496049}] :answer-field/correct {:db/id #edb/ref 17592186496036} :answer-field/id #uuid "9748a26e-5f17-5d21-9edf-d14cdccf2bde" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496149}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bbba28e1-c797-5200-af1b-5dd4807a9f53" :question/math-academy-id "q-82110" :question/problem "Evaluate $\\sqrt{x-3}$ for $x=15.$" :question/worked-solution "We replace $x$ with $15$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}\\sqrt{x-3} & = \\\\ \\sqrt{15-3} & = \\\\ \\sqrt{12}\\end{aligned}\n$$\n\nWe can simplify even further using the product rule:\n\n$$\n\\begin{aligned}\\sqrt{12} & = \\\\ \\sqrt{4\\cdot 3} & = \\\\ \\sqrt{{2}^{2}\\cdot 3} & = \\\\ \\sqrt{{2}^{2}}\\cdot \\sqrt{3} & = \\\\ 2\\sqrt{3}\\end{aligned}\n$$"} :step/id #uuid "fa7076ba-9b61-52c4-ac56-c8c93c105064" :step/next {:db/id #edb/ref 17592186496365}}] :activity/title "Evaluating Algebraic Radical Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186495497}] [{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186134987} :activity/id #uuid "f2735cce-723e-58b4-93fb-cea13e3ee05e" :activity/scope {:db/id #edb/ref 17592186048938 :topic/id #uuid "cd61cb00-4988-54d1-a596-e98a1a9c15ab" :topic/math-academy-id 2183} :activity/steps [{:db/id #edb/ref 17592186134987 :step/content {:db/id #edb/ref 17592186135171 :tutorial/content "A **rational expression** is, roughly speaking, an algebraic expression that's in the form of a fraction, or contains fractions.\n\nTo evaluate a rational expression like $\\dfrac 6 x$ for $x=2,$ all we need to do is replace $x$ with $2$ in the above expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{6}{x}=\\frac{6}{2}=3\\end{aligned}\n$$" :tutorial/id #uuid "12656f01-d648-56e1-9a11-2f5bb03056ec" :tutorial/math-academy-id 8008 :tutorial/title "Introduction"} :step/id #uuid "4e087006-b2f0-5042-9384-ccede2e9afb9" :step/math-academy-id 76947 :step/next {:db/id #edb/ref 17592186134988}} {:db/id #edb/ref 17592186134988 :step/content {:db/id #edb/ref 17592186133962 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133492 :question/id #uuid "e2e06b2a-d740-5280-addb-2796864dd5a8" :question/math-academy-id "e-12768"} :knowledge-point/id #uuid "00f73402-88ee-5e43-8e45-dbdd0a361521" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050078} {:db/id #edb/ref 17592186050127}] :knowledge-point/questions [{:db/id #edb/ref 17592186134348} {:db/id #edb/ref 17592186134349} {:db/id #edb/ref 17592186479871} {:db/id #edb/ref 17592186479900}] :knowledge-point/title "Evaluating a Single Fraction"} :step/id #uuid "12a83cc7-e8f9-5b87-bc18-7e038bdde9ae" :step/math-academy-id 76948 :step/next {:db/id #edb/ref 17592186134989}} {:db/id #edb/ref 17592186134989 :step/content {:db/id #edb/ref 17592186133963 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133494 :question/id #uuid "74f72809-7c28-5fc8-9e0e-b5542b5ffe4d" :question/math-academy-id "e-12770"} :knowledge-point/id #uuid "75725a2d-2a8d-563f-99f1-8d071c2ff0c9" :knowledge-point/questions [{:db/id #edb/ref 17592186134350} {:db/id #edb/ref 17592186134489} {:db/id #edb/ref 17592186234263} {:db/id #edb/ref 17592186479857} {:db/id #edb/ref 17592186495145} {:db/id #edb/ref 17592186495162} {:db/id #edb/ref 17592186542147}] :knowledge-point/title "Evaluating Expressions With Parentheses"} :step/id #uuid "cf4589be-5618-5a10-9c3c-90369c5af6cd" :step/math-academy-id 76952 :step/next {:db/id #edb/ref 17592186134990}} {:db/id #edb/ref 17592186134990 :step/content {:db/id #edb/ref 17592186133964 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133493 :question/id #uuid "378a718e-c6cb-5b85-adc3-22ff4bd7bc9b" :question/math-academy-id "e-12769"} :knowledge-point/id #uuid "de683deb-e208-59ef-9110-7523dd22ce2a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050131}] :knowledge-point/questions [{:db/id #edb/ref 17592186134165} {:db/id #edb/ref 17592186134166} {:db/id #edb/ref 17592186479874} {:db/id #edb/ref 17592186479897} {:db/id #edb/ref 17592186495056} {:db/id #edb/ref 17592186538948}] :knowledge-point/title "Evaluating a Sum or Difference"} :step/id #uuid "c05db175-4da5-59d1-8b53-4d6d15035664" :step/math-academy-id 76956 :step/next {:db/id #edb/ref 17592186134991}} {:db/id #edb/ref 17592186134991 :step/content {:db/id #edb/ref 17592186133965 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133495 :question/id #uuid "4e54a97f-16af-57c7-ab4e-c6f12e83306f" :question/math-academy-id "e-12771"} :knowledge-point/id #uuid "21b84055-253e-50a0-b57f-d288d466bc02" :knowledge-point/questions [{:db/id #edb/ref 17592186134351} {:db/id #edb/ref 17592186134480} {:db/id #edb/ref 17592186479838} {:db/id #edb/ref 17592186479890} {:db/id #edb/ref 17592186495065} {:db/id #edb/ref 17592186495109}] :knowledge-point/title "Evaluating Expressions With Multiple Variables"} :step/id #uuid "2e1b159e-e30d-5188-9fe3-8c0f008f8a43" :step/math-academy-id 76960}] :activity/title "Evaluating Rational Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186134036}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186495216} :activity/id #uuid "6aa5b166-dd8e-5ca2-8b7d-1419def83709" :activity/scope {:db/id #edb/ref 17592186048938 :topic/id #uuid "cd61cb00-4988-54d1-a596-e98a1a9c15ab" :topic/math-academy-id 2183} :activity/steps [{:db/id #edb/ref 17592186495187 :step/content {:db/id #edb/ref 17592186495065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a193d30-2678-5290-8227-48f94178684b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186494501} {:answer/id #uuid "71b0bb4d-c696-553e-85b2-c82a397e838c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186494561} {:answer/id #uuid "ada5c571-4b79-5699-bf57-b91b3d06e08b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186494721} {:answer/id #uuid "d7b1df03-83f7-505b-93fd-e466c959a197" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186494828} {:answer/id #uuid "e10238d5-b4fc-50dd-852e-f9c92340056d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186494852}] :answer-field/correct {:db/id #edb/ref 17592186494721} :answer-field/id #uuid "eab9a6ff-5e82-586a-84ee-0529550dee14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186495032}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1ae15419-ea90-5da7-9981-972449aabeb9" :question/math-academy-id "q-70122" :question/problem "Evaluate $\\frac{2m}{n+4}-\\frac{m-2}{2n}$ if $m=4$ and $n=1$ ." :question/worked-solution "We replace $m$ with $4$ and $n$ with $1$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{2m}{n+4}-\\frac{m-2}{2n} & = \\\\ \\frac{2(4)}{1+4}-\\frac{4-2}{2(1)} & = \\\\ \\frac{8}{5}-\\frac{2}{2} & = \\\\ \\frac{8}{5}-1 & = \\\\ \\frac{8}{5}-\\frac{5}{5} & = \\\\ \\frac{8-5}{5} & = \\\\ \\frac{3}{5}\\end{aligned}\n$$"} :step/id #uuid "21d43eb5-2713-5f23-bd3a-faf668d76610" :step/next {:db/id #edb/ref 17592186495192}} {:db/id #edb/ref 17592186495192 :step/content {:db/id #edb/ref 17592186495056 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03fe396d-fe54-5331-9b0d-89cca76e8a83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{10}" :db/id #edb/ref 17592186494325} {:answer/id #uuid "28e4f656-f65d-5411-8d23-3582c6860ee1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{10}" :db/id #edb/ref 17592186494395} {:answer/id #uuid "7e76872b-704c-5f0c-a9ff-08c0e8fdc198" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{7}" :db/id #edb/ref 17592186494593} {:answer/id #uuid "93ee67a5-c7ed-59bc-a55b-a2b9816ca144" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{17}{10}" :db/id #edb/ref 17592186494657} {:answer/id #uuid "a652b819-cc60-593b-be0f-164896bc2a59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{10}{17}" :db/id #edb/ref 17592186494698}] :answer-field/correct {:db/id #edb/ref 17592186494657} :answer-field/id #uuid "df747204-bd95-5057-9f83-9ee058a01322" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186495026}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0f15a926-c445-59e0-9b0e-24fb3d26db90" :question/math-academy-id "q-99830" :question/problem "Evaluate $\\frac{8}{x}+\\frac{2}{4x}$ for $x=-5.$" :question/worked-solution "We replace $x$ with $-5$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{8}{x}+\\frac{2}{4x} & = \\\\ \\frac{8}{(-5)}+\\frac{2}{4\\cdot (-5)} & = \\\\ -\\frac{8}{5}+(-\\frac{2}{20}) & = \\\\ -\\frac{8}{5}-\\frac{1}{10} & = \\\\ -\\frac{16}{10}-\\frac{1}{10} & = \\\\ \\frac{-16-1}{10} & = \\\\ -\\frac{17}{10}\\end{aligned}\n$$"} :step/id #uuid "280ac367-40c7-558a-b5e2-c35117deba67" :step/next {:db/id #edb/ref 17592186495263}} {:db/id #edb/ref 17592186495216 :step/content {:db/id #edb/ref 17592186495145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e3dbef9-dc90-5521-aad3-0e986ff0a9c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186494374} {:answer/id #uuid "2f95e908-cc3c-52a0-b192-0d0710737e7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186494411} {:answer/id #uuid "8afd3cea-dcab-580e-a906-ca6e1b3ef1ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186494632} {:answer/id #uuid "c99f603d-0d8c-5cad-a745-389ae3790563" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186494793} {:answer/id #uuid "fc53b599-5c2a-51eb-849a-b5560be90857" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186494912}] :answer-field/correct {:db/id #edb/ref 17592186494793} :answer-field/id #uuid "ae640502-6ec1-5965-8f84-422b9cf2d36f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494999}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cd9fe40e-bc91-5a44-83a1-8324033e7c36" :question/math-academy-id "q-41396" :question/problem "Evaluate $\\frac{4p-1}{2(2p+2)}$ for $p=4.$" :question/worked-solution "We replace $p$ with $4$ in the above expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{4p-1}{2(2p+2)} & = \\\\ \\frac{4(4)-1}{2(2(4)+2)} & = \\\\ \\frac{15}{2(8+2)} & = \\\\ \\frac{15}{20} & = \\\\ \\frac{3}{4}\\end{aligned}\n$$"} :step/id #uuid "7b236cf6-b776-533a-a5d8-6899df32a482" :step/next {:db/id #edb/ref 17592186495242}} {:db/id #edb/ref 17592186495242 :step/content {:db/id #edb/ref 17592186495162 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16d21786-f17d-5f51-b039-3a8847d6393b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186494363} {:answer/id #uuid "3624078e-face-5369-96cf-5bd66283c3d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186494430} {:answer/id #uuid "506d0e3d-76e7-56a6-8950-11ce3311fb87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186494480} {:answer/id #uuid "80029657-b251-5c82-b8aa-9552f47c932e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{7}" :db/id #edb/ref 17592186494594} {:answer/id #uuid "899713f6-4503-506c-8e51-5d19404c5088" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186494624}] :answer-field/correct {:db/id #edb/ref 17592186494480} :answer-field/id #uuid "ecea4696-381b-5caf-8ad2-71fa9ec32665" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186495033}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ea15f44d-2e1d-56cb-9675-b5eb8b0bd610" :question/math-academy-id "q-51597" :question/problem "Evaluate $\\frac{p+9}{2(3-p)}$ for $p=-5.$" :question/worked-solution "We replace $p$ with $-5$ in the above expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{p+9}{2(3-p)} & = \\\\ \\frac{(-5)+9}{2(3-(-5))} & = \\\\ \\frac{4}{2(8)} & = \\\\ \\frac{4}{16} & = \\\\ \\frac{1}{4} & \\end{aligned}\n$$"} :step/id #uuid "b33d30b4-f26c-5283-a113-5d791c204f7d" :step/next {:db/id #edb/ref 17592186495187}} {:db/id #edb/ref 17592186495263 :step/content {:db/id #edb/ref 17592186495109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90b1e99c-00a5-5d5c-9c07-a9ac4425d78b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186494647}] :answer-field/correct {:db/id #edb/ref 17592186494647} :answer-field/id #uuid "390cda6c-7afa-531f-b8d2-8d4ab6b358f0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186494941}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8ab342b9-3bac-54fe-9ede-058c11e77bac" :question/math-academy-id "q-175902" :question/problem "If $p=-2$ and $q=6,$ then $\\frac{2q-3}{4}+\\frac{4}{4-2p}=${{field-1}}." :question/worked-solution "Replacing $p$ with $-2$ and $q$ with $6$ in the expression, we get the following:\n\n$$\n\\begin{aligned}\\frac{2q-3}{4}+\\frac{4}{4-2p} & = \\\\ \\frac{2(6)-3}{4}+\\frac{4}{4-2(-2)} & = \\\\ \\frac{12-3}{4}+\\frac{4}{4+4} & = \\\\ \\frac{9}{4}+\\frac{4}{8} & = \\\\ \\frac{18}{8}+\\frac{4}{8} & = \\\\ \\frac{18+4}{8} & = \\\\ \\frac{22}{8} & = \\\\ \\frac{11}{4}\\end{aligned}\n$$"} :step/id #uuid "e3763ce7-1ebb-58a6-9246-c04907a1a3c3"}] :activity/title "Evaluating Rational Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186494306}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186065232} :activity/id #uuid "6b61e9db-9682-5425-ad74-a269bcaceb50" :activity/scope {:db/id #edb/ref 17592186049026 :topic/id #uuid "d49a6c77-a56c-5955-b68f-69307587aa23" :topic/math-academy-id 352} :activity/steps [{:db/id #edb/ref 17592186065232 :step/content {:db/id #edb/ref 17592186065341 :tutorial/content "A **perfect square trinomial** is a three-term expression that is the result of squaring a binomial.\n\nFor example, the expression\n\n$$\nx^2 + 6x + 9\n$$\n\nis a perfect square trinomial because it is the result of squaring the binomial $(x+3)$, as shown below:\n\n$$\n\\begin{aligned}(x+3)^{2} & = \\\\ {x}^{2}+2\\cdot 3x+{3}^{2} & = \\\\ {x}^{2}+6x+9 & \\end{aligned}\n$$\n\nTo factor a perfect square trinomial, we have to figure out what binomial it is the square of. We can often do this by relating the perfect square trinomial to the **square of a sum**:\n\n$$\nx^2 + {\\color{red}2}  {\\color{blue}a}x + {\\color{blue}a}^2 = (x + {\\color{blue}a})^2\n$$\n\n \n\nTo illustrate, let's factor the expression $x^2+6x+9$ using the square of sum formula. We perform the following steps:\n\n1\\. Write the constant term as a perfect square:\n\n  $$\n  \\begin{aligned}{x}^{2}+6x+{3}^{2}\\end{aligned}\n  $$\n\n2\\. Factor a $2$ out of the linear term:\n\n  $$\n  \\begin{aligned}{x}^{2}+2\\cdot 3x+{3}^{2}\\end{aligned}\n  $$\n\n3\\. Factor the trinomial using the \"square of a sum formula\". In this case, we have ${\\color{blue}{a}}={\\color{blue}{3}}\\mathbin{:}$\n\n  $$\n  \\begin{aligned}(x+3)^{2}\\end{aligned}\n  $$\n\nThis method works *only* when the trinomial is a perfect square! It will *not* work for every trinomial. We will learn more general methods in the future." :tutorial/id #uuid "c04b9f03-f29f-5feb-8d13-7de9fc378a34" :tutorial/math-academy-id 1596 :tutorial/title "Introduction"} :step/id #uuid "c96b380f-2e0a-5243-a862-5219272b92d7" :step/math-academy-id 4226 :step/next {:db/id #edb/ref 17592186065233}} {:db/id #edb/ref 17592186065233 :step/content {:db/id #edb/ref 17592186064325 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063960 :question/id #uuid "d496f23e-6ef7-5ec2-bb6c-054759a5b033" :question/math-academy-id "e-1327"} :knowledge-point/id #uuid "373d4ad5-ef39-5f03-bba4-d9be901e2587" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049847}] :knowledge-point/questions [{:db/id #edb/ref 17592186064682} {:db/id #edb/ref 17592186064746} {:db/id #edb/ref 17592186482518} {:db/id #edb/ref 17592186482579}] :knowledge-point/title "Factoring a Trinomial Generated by the Square of a Sum"} :step/id #uuid "d98ff5d5-8ca1-5834-941d-13d2afb9da6f" :step/math-academy-id 4227 :step/next {:db/id #edb/ref 17592186065256}} {:db/id #edb/ref 17592186065234 :step/content {:db/id #edb/ref 17592186064326 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063961 :question/id #uuid "29cbd59e-9eff-5439-9551-4520f68707b1" :question/math-academy-id "e-1328"} :knowledge-point/id #uuid "457399ac-1ede-551f-968b-9ef270a67d0b" :knowledge-point/questions [{:db/id #edb/ref 17592186064687} {:db/id #edb/ref 17592186064745} {:db/id #edb/ref 17592186482527} {:db/id #edb/ref 17592186482567} {:db/id #edb/ref 17592186482612} {:db/id #edb/ref 17592186507410} {:db/id #edb/ref 17592186507455}] :knowledge-point/title "Factoring a Trinomial Generated by the Square of a Difference"} :step/id #uuid "1253a4a8-20c7-58c3-9e8e-893e406761f2" :step/math-academy-id 4230 :step/next {:db/id #edb/ref 17592186065235}} {:db/id #edb/ref 17592186065235 :step/content {:db/id #edb/ref 17592186064327 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063962 :question/id #uuid "2fb03f0f-25c2-57a6-9e33-da837af2f339" :question/math-academy-id "e-1329"} :knowledge-point/id #uuid "48f257af-1f00-5cf9-89cd-3d44d21482ec" :knowledge-point/questions [{:db/id #edb/ref 17592186064744} {:db/id #edb/ref 17592186064960} {:db/id #edb/ref 17592186482523} {:db/id #edb/ref 17592186482529} {:db/id #edb/ref 17592186507404} {:db/id #edb/ref 17592186507442} {:db/id #edb/ref 17592186507457}] :knowledge-point/title "Factoring a Trinomial with Fractions"} :step/id #uuid "59f4cd9a-a9f4-5779-b601-96d0642330dd" :step/math-academy-id 4232} {:db/id #edb/ref 17592186065256 :step/content {:db/id #edb/ref 17592186065345 :tutorial/content "Other perfect square trinomials can be factored as the **square of a difference**:\n\n$$\nx^2 - {\\color{red}2}  {\\color{blue}a}x  + {\\color{blue}a}^2 = (x - {\\color{blue}a})^2\n$$\n\n \n\nTo illustrate, let's factor the expression $x^2-10x+25$ using the square of difference formula. We perform the following steps:\n\n1\\. Write the constant term as a perfect square:\n\n  $$\n  \\begin{aligned}{x}^{2}-10x+{5}^{2}\\end{aligned}\n  $$\n\n2\\. Factor a $2$ out of the linear term:\n\n  $$\n  \\begin{aligned}{x}^{2}-2\\cdot 5x+{5}^{2}\\end{aligned}\n  $$\n\n3\\. Factor the trinomial using the square of difference formula. In this case, we have ${\\color{blue}{a}}={\\color{blue}{5}},$ and we get\n\n  $$\n  \\begin{aligned}(x-5)^{2}.\\end{aligned}\n  $$" :tutorial/id #uuid "70396264-e3c3-50d9-94a4-95e8017dbfde" :tutorial/math-academy-id 1855 :tutorial/title "Factoring a Trinomial Generated by the Square of a Difference"} :step/id #uuid "5e99daa1-dbe7-5fe2-bda6-1e302fb1a276" :step/math-academy-id 6169 :step/next {:db/id #edb/ref 17592186065234}}] :activity/title "Factoring Perfect Square Trinomials" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064441}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186507576} :activity/id #uuid "f69f02b5-d258-52b6-bfe5-2cbd30c0d419" :activity/scope {:db/id #edb/ref 17592186049026 :topic/id #uuid "d49a6c77-a56c-5955-b68f-69307587aa23" :topic/math-academy-id 352} :activity/steps [{:db/id #edb/ref 17592186507539 :step/content {:db/id #edb/ref 17592186507455 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ca67fe0-cf38-599e-96f0-f21b24a8ed45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2e+9)^{2}" :db/id #edb/ref 17592186506700} {:answer/id #uuid "1e211f2a-503f-53ec-afa6-8cc382355c12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(e-9)^{2}" :db/id #edb/ref 17592186506739} {:answer/id #uuid "836e756a-76b5-5f29-86b1-a991836e11bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(e-3)^{2}" :db/id #edb/ref 17592186506970} {:answer/id #uuid "c6a4827a-5dc1-5018-8b60-d93186610d52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(e+9)^{2}" :db/id #edb/ref 17592186507110} {:answer/id #uuid "c91d77da-831a-57b5-a1ac-15897539bebc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2e-9)^{2}" :db/id #edb/ref 17592186507117}] :answer-field/correct {:db/id #edb/ref 17592186506739} :answer-field/id #uuid "d8ac7d31-1c83-57d9-9043-68e47336ef2f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186507373}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "85b0de0c-7078-58c3-80c6-e70c35748f20" :question/math-academy-id "q-3001" :question/problem "Factor the expression ${e}^{2}-18e+81.$" :question/worked-solution "The \"square of a difference\" formula states that\n\n$$\n{e}^{2}-2ae+{a}^{2}=(e-a)^{2}.\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n{e}^{2}-18e+81.\n$$\n\nFirst, we write the constant term as a perfect square:\n\n$$\n\\begin{aligned}{e}^{2}-18e+{9}^{2}\\end{aligned}\n$$\n\nThen, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}{e}^{2}-2\\cdot 9e+{9}^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of difference formula with $a=9.$ This gives\n\n$$\n\\begin{aligned}(e-9)^{2}.\\end{aligned}\n$$"} :step/id #uuid "2367216d-f79e-5890-b1c7-ed65906fb24f" :step/next {:db/id #edb/ref 17592186507564}} {:db/id #edb/ref 17592186507555 :step/content {:db/id #edb/ref 17592186507457 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46bfa4c3-af30-5756-82bb-059f1b23c4a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x-\\frac{5}{6})}^{2}" :db/id #edb/ref 17592186506843} {:answer/id #uuid "4850c323-0008-5586-a92c-51d27d9d80e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x-\\frac{25}{6})}^{2}" :db/id #edb/ref 17592186506847} {:answer/id #uuid "9af9ba7a-b83f-5100-8ba8-0c8c301f0339" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x+\\frac{5}{6})}^{2}" :db/id #edb/ref 17592186507013} {:answer/id #uuid "aa4ea64c-142a-5719-b240-6ec5e8ce7a0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x+\\frac{5}{3})}^{2}" :db/id #edb/ref 17592186507054} {:answer/id #uuid "b6500cbd-5e5a-59f1-8c25-13b96afe7d98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x-\\frac{5}{3})}^{2}" :db/id #edb/ref 17592186507080}] :answer-field/correct {:db/id #edb/ref 17592186506843} :answer-field/id #uuid "f20bb066-c188-50d4-908b-5327e0942d6b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186507391}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8c418bae-22aa-5bc3-86d4-82df570c3162" :question/math-academy-id "q-78927" :question/problem "Factor ${x}^{2}-\\frac{5}{3}x+\\frac{25}{36}.$" :question/worked-solution "The \"square of a difference\" formula states that\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a)^{2}.\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n{x}^{2}-\\frac{5}{3}x+\\frac{25}{36}.\n$$\n\nFirst, we write the constant term as a perfect square:\n\n$$\n\\begin{aligned}{x}^{2}-\\frac{5}{3}x+{(\\frac{5}{6})}^{2}\\end{aligned}\n$$\n\nThen, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}{x}^{2}-2\\cdot \\frac{5}{6}x+{(\\frac{5}{6})}^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of difference formula with $a=\\frac{5}{6}.$ This gives\n\n$$\n\\begin{aligned}{(x-\\frac{5}{6})}^{2}.\\end{aligned}\n$$"} :step/id #uuid "5fa30973-6c9b-5f0a-bfce-fb179d74bbe8"} {:db/id #edb/ref 17592186507561 :step/content {:db/id #edb/ref 17592186507442 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31315a0d-2c0e-5f94-a1ff-4b7faeb27a09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x+\\frac{3}{4})}^{2}" :db/id #edb/ref 17592186506794} {:answer/id #uuid "3701d3f2-5410-556e-b0a7-75420b9f36b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x-\\frac{3}{2})}^{2}" :db/id #edb/ref 17592186506810} {:answer/id #uuid "374322ff-4086-5b83-87ee-c3122f61bd52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x+3)}^{2}" :db/id #edb/ref 17592186506811} {:answer/id #uuid "c0be764b-beb0-5776-8b10-64f11f6978bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x-\\frac{3}{4})}^{2}" :db/id #edb/ref 17592186507101} {:answer/id #uuid "d9c7dbd4-3ec1-54d0-8413-03bba2ac8751" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x+\\frac{3}{2})}^{2}" :db/id #edb/ref 17592186507149}] :answer-field/correct {:db/id #edb/ref 17592186506794} :answer-field/id #uuid "8adb6eba-9169-5d39-b01b-4fde7ef436d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186507322}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5e023823-cd56-5877-8c6f-e730b2d09ff6" :question/math-academy-id "q-78924" :question/problem "${x}^{2}+\\frac{3}{2}x+\\frac{9}{16}=$" :question/worked-solution "The \"square of a sum\" formula states that\n\n$$\n{x}^{2}+2ax+{a}^{2}=(x+a)^{2}.\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n{x}^{2}+\\frac{3}{2}x+\\frac{9}{16}.\n$$\n\nFirst, we write the constant term as a perfect square:\n\n$$\n\\begin{aligned}{x}^{2}+\\frac{3}{2}x+{(\\frac{3}{4})}^{2}\\end{aligned}\n$$\n\nThen, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}{x}^{2}+2\\cdot \\frac{3}{4}x+{(\\frac{3}{4})}^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of sum formula with $a=\\frac{3}{4}.$ This gives\n\n$$\n\\begin{aligned}{(x+\\frac{3}{4})}^{2}.\\end{aligned}\n$$"} :step/id #uuid "840aef68-9d30-531e-8a4f-9c7f5eaf1292" :step/next {:db/id #edb/ref 17592186507555}} {:db/id #edb/ref 17592186507564 :step/content {:db/id #edb/ref 17592186507404 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22440f7b-035c-540b-b0e2-3dcd53956334" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x+\\frac{1}{4})}^{2}" :db/id #edb/ref 17592186506747} {:answer/id #uuid "24264748-c5f8-54b5-aa97-cacdbd3e54a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x-\\frac{1}{2})}^{2}" :db/id #edb/ref 17592186506756} {:answer/id #uuid "9798202a-5866-5647-b043-5b3551c6a2a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x+\\frac{1}{2})}^{2}" :db/id #edb/ref 17592186507008} {:answer/id #uuid "baca3216-958b-5e79-b70f-2b61c19055ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x-2)^{2}" :db/id #edb/ref 17592186507089} {:answer/id #uuid "c1195dcf-977f-50d8-932c-4e76e5fdb1c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x-\\frac{1}{4})}^{2}" :db/id #edb/ref 17592186507102}] :answer-field/correct {:db/id #edb/ref 17592186506756} :answer-field/id #uuid "b73f9e06-0243-5c21-9043-a7def06f5f6f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186507358}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "14f47d14-d694-51ea-abc7-d932943c0b1e" :question/math-academy-id "q-44172" :question/problem "Factor ${x}^{2}-x+\\frac{1}{4}.$" :question/worked-solution "The \"square of a difference\" formula states that\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a)^{2}.\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n{x}^{2}-x+\\frac{1}{4}.\n$$\n\nFirst, we write the constant term as a perfect square:\n\n$$\n\\begin{aligned}{x}^{2}-x+{(\\frac{1}{2})}^{2}\\end{aligned}\n$$\n\nThen, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}{x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of difference formula with $a=\\frac{1}{2}.$ This gives\n\n$$\n\\begin{aligned}{(x-\\frac{1}{2})}^{2}.\\end{aligned}\n$$"} :step/id #uuid "893ea4e4-86f8-579b-bce8-6341f6a5776a" :step/next {:db/id #edb/ref 17592186507561}} {:db/id #edb/ref 17592186507576 :step/content {:db/id #edb/ref 17592186507410 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a6cd19d-164d-5b97-a602-10c686dd9873" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2t-7)^{2}" :db/id #edb/ref 17592186506985} {:answer/id #uuid "9df797c2-4cab-5309-a7be-3552ea5721d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(t-12)^{2}" :db/id #edb/ref 17592186507017} {:answer/id #uuid "a42dd5ae-f26b-5919-9491-b0ee466749f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2t-8)^{2}" :db/id #edb/ref 17592186507035} {:answer/id #uuid "cc44d5db-8cdb-56b6-ac5a-21a07d054d54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(t+11)^{2}" :db/id #edb/ref 17592186507123} {:answer/id #uuid "e43e106b-fd87-54fd-9560-b587c9f88927" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(t-11)^{2}" :db/id #edb/ref 17592186507177}] :answer-field/correct {:db/id #edb/ref 17592186507177} :answer-field/id #uuid "6b1d029e-2f62-5e77-9841-4721fc7760f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186507300}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1f9f643d-cb40-58cc-a000-e0bdfa821c71" :question/math-academy-id "q-2831" :question/problem "Factor ${t}^{2}-22t+121.$" :question/worked-solution "The \"square of a difference\" formula states that\n\n$$\n{t}^{2}-2at+{a}^{2}=(t-a)^{2}.\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n{t}^{2}-22t+121.\n$$\n\nFirst, we write the constant term as a perfect square:\n\n$$\n\\begin{aligned}{t}^{2}-22t+{11}^{2}\\end{aligned}\n$$\n\nThen, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}{t}^{2}-2\\cdot 11t+{11}^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of difference formula with $a=11.$ This gives\n\n$$\n\\begin{aligned}(t-11)^{2}.\\end{aligned}\n$$"} :step/id #uuid "cc3b16d6-8646-5e1f-a04f-001ad7825849" :step/next {:db/id #edb/ref 17592186507539}}] :activity/title "Factoring Perfect Square Trinomials" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186506676}] [{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186139486} :activity/id #uuid "63522699-6803-576b-82ed-8d88d13eba2f" :activity/scope {:db/id #edb/ref 17592186049047 :topic/id #uuid "d5a8629a-110d-5d05-beb7-159e81536910" :topic/math-academy-id 2244} :activity/steps [{:db/id #edb/ref 17592186139486 :step/content {:db/id #edb/ref 17592186139661 :tutorial/content "Suppose that we want to simplify the following expression: \n\n$$\n2+\\dfrac{5}{2}x -5 + \\dfrac{7}{2}x.\n$$\n\n  \n\nWe begin by collecting like terms.\n\n$$\n\\begin{aligned}(\\frac{5}{2}x+\\frac{7}{2}x)+(2-5)\\end{aligned}\n$$\n\nThen, we combine the like terms, simplifying the coefficients as much as possible.\n\n$$\n\\begin{aligned}(\\frac{5}{2}x+\\frac{7}{2}x)+(2-5) & = \\\\ (\\frac{5+7}{2})x+(-3) & = \\\\ \\frac{12}{2}x-3 & = \\\\ 6x-3 & .\\end{aligned}\n$$\n\nThus, the simplified expression is $6x-3.$" :tutorial/id #uuid "7ef8a0d2-a9fe-57f8-b3fc-7b69cbb3a818" :tutorial/math-academy-id 8040 :tutorial/title "Introduction"} :step/id #uuid "3cca408f-980b-5a63-a54c-03cd0d86a422" :step/math-academy-id 71207 :step/next {:db/id #edb/ref 17592186139487}} {:db/id #edb/ref 17592186139487 :step/content {:db/id #edb/ref 17592186138510 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138069 :question/id #uuid "e85da1d1-1cf3-547c-86ce-42329475fbdd" :question/math-academy-id "e-12835"} :knowledge-point/id #uuid "54498b47-9a43-5b4d-8bbf-806af5968829" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050311} {:db/id #edb/ref 17592186050452} {:db/id #edb/ref 17592186050833}] :knowledge-point/questions [{:db/id #edb/ref 17592186138716} {:db/id #edb/ref 17592186138809} {:db/id #edb/ref 17592186459206} {:db/id #edb/ref 17592186459226}] :knowledge-point/title "Simplifying Fractions with Like Denominators"} :step/id #uuid "24f9787a-6b3b-581b-a228-064feb6d711c" :step/math-academy-id 71208 :step/next {:db/id #edb/ref 17592186139488}} {:db/id #edb/ref 17592186139488 :step/content {:db/id #edb/ref 17592186138511 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138071 :question/id #uuid "53c1f7ca-bcaa-59e4-9929-0695b67621cb" :question/math-academy-id "e-12837"} :knowledge-point/id #uuid "75d096f5-9834-5e52-a7eb-9aae72398d19" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050131} {:db/id #edb/ref 17592186050637}] :knowledge-point/questions [{:db/id #edb/ref 17592186138816} {:db/id #edb/ref 17592186138817} {:db/id #edb/ref 17592186459205} {:db/id #edb/ref 17592186459293} {:db/id #edb/ref 17592186536857} {:db/id #edb/ref 17592186542142}] :knowledge-point/title "Simplifying Fractions with Unlike Denominators"} :step/id #uuid "aae03f7b-9f94-5281-8d40-eddd120590d8" :step/math-academy-id 71212 :step/next {:db/id #edb/ref 17592186139489}} {:db/id #edb/ref 17592186139489 :step/content {:db/id #edb/ref 17592186138512 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138070 :question/id #uuid "30cf0891-33d3-566c-8286-4c161f84c1dd" :question/math-academy-id "e-12836"} :knowledge-point/id #uuid "dec4e22a-5882-56d9-8e13-b18b4d22efdc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050599} {:db/id #edb/ref 17592186050908}] :knowledge-point/questions [{:db/id #edb/ref 17592186138760} {:db/id #edb/ref 17592186138779}] :knowledge-point/title "Using the Distributive Law With Fractions"} :step/id #uuid "1036460b-f34d-54e4-a730-f0b57e843495" :step/math-academy-id 71216 :step/next {:db/id #edb/ref 17592186139490}} {:db/id #edb/ref 17592186139490 :step/content {:db/id #edb/ref 17592186138513 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138072 :question/id #uuid "957b3102-6eb7-52d3-9299-54ed9bd4718e" :question/math-academy-id "e-12892"} :knowledge-point/id #uuid "e3e39a9d-1f97-54f2-a388-90c71c83b93e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050575}] :knowledge-point/questions [{:db/id #edb/ref 17592186138818} {:db/id #edb/ref 17592186139065} {:db/id #edb/ref 17592186459228} {:db/id #edb/ref 17592186459288}] :knowledge-point/title "Simplifying Expressions Using the Distributive Law"} :step/id #uuid "4e4a8574-0322-564e-8108-20569dba02f5" :step/math-academy-id 71219}] :activity/title "Simplifying Linear Expressions Containing Fractions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186138596}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186060770} :activity/id #uuid "9b6ebd1c-f083-5c13-ba2f-eefcd05878c6" :activity/scope {:db/id #edb/ref 17592186049162 :topic/id #uuid "df4f6208-5d6c-5dc9-bd38-c7d85e32fb73" :topic/math-academy-id 239} :activity/steps [{:db/id #edb/ref 17592186060770 :step/content {:db/id #edb/ref 17592186060969 :tutorial/content "Consider the region below, which represents the inequality $2 < x < 5.$\n\n![](images/fe/feeae0bfa9b29e6f034a3fd33d1e9fbd369840835af2d6588892ee6edc2fa120.png)\n\nWe can represent this inequality using **interval notation** as follows:\n\n$$\n(2,5)\n$$\n\nThe parentheses $(\\phantom{0})$ tell us that the endpoints $x=2$ and $x=5$ are *not* included in this interval.\n\nWhen an interval does not include the endpoints, we say that it is **open**. \n\nMore formally, we can also write\n\n$$\nx\\in (2,5).\n$$\n\nThe symbol $\\in$ means \"lies in\" or \"belongs to.\" So, the above reads, \"*$x$ belongs to the (open) interval $(2,5).$*\"" :tutorial/id #uuid "dbd2ff75-3253-5df6-ac32-55d5e3a95cf5" :tutorial/math-academy-id 6750 :tutorial/title "Introduction"} :step/id #uuid "53a0851d-e1e9-5f13-a1f9-1e0ad720c677" :step/math-academy-id 40878 :step/next {:db/id #edb/ref 17592186060782}} {:db/id #edb/ref 17592186060771 :step/content {:db/id #edb/ref 17592186059826 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059385 :question/id #uuid "9096883e-6dd0-5dd1-8e9c-176775edadba" :question/math-academy-id "e-10785"} :knowledge-point/id #uuid "74f45f69-d8e7-5e79-a1ec-38d8912cbc19" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049051}] :knowledge-point/question-generator {:db/id #edb/ref 17592186502752} :knowledge-point/questions [{:db/id #edb/ref 17592186059959} {:db/id #edb/ref 17592186060310} {:db/id #edb/ref 17592186483356} {:db/id #edb/ref 17592186483411} {:db/id #edb/ref 17592186502734} {:db/id #edb/ref 17592186502744} {:db/id #edb/ref 17592186502749}] :knowledge-point/title "Converting Between Intervals and Inequalities: Open Intervals"} :step/id #uuid "6325c0ca-8510-5c9d-8b87-b9042fe377ed" :step/math-academy-id 40879 :step/next {:db/id #edb/ref 17592186060775}} {:db/id #edb/ref 17592186060772 :step/content {:db/id #edb/ref 17592186060970 :tutorial/content "Some intervals may include one parenthesis and one bracket. \n\nFor example, consider the following interval:\n\n$$\n{\\color{blue}{{\\big[}}} 1,4 {\\color{red}{\\big)}}\n$$\n\nTo express this interval as an inequality, we note the following:\n\n- The left bracket $\\,\\color{blue}[\\,$ tells us that left endpoint $1$ *is* included in the interval. Therefore, we use ${\\color{blue}{\\leq}}$ for this endpoint.\n\n- The right parenthesis $\\,\\color{red})\\,$ tells us that the right endpoint $4$ is *not* included in the interval. Therefore, we use ${\\color{red}{<      }}\\,$ for this endpoint.\n\nTherefore, the inequality that corresponds to the given interval is \n\n$$\n1 \\,\\,{\\color{blue}{\\leq  }}\\,\\,   x \\,\\,{\\color{red}{\\lt}}\\,\\, 4.\n$$\n\nThe interval can be graphed as follows:\n\n![](images/5a/5a67872e8193c2bcc249a9a9006acb916909099e4babdbe5cdfa6d2643c10ad2.png)\n\nIntervals with one bracket and one parenthesis are called **half-open** (or **half-closed**)." :tutorial/id #uuid "633202af-a5bd-58ac-a806-89458305a7a2" :tutorial/math-academy-id 6751 :tutorial/title "Half-Open Intervals"} :step/id #uuid "149280d9-7b92-52c0-ab69-a011aca574b3" :step/math-academy-id 40882 :step/next {:db/id #edb/ref 17592186060773}} {:db/id #edb/ref 17592186060773 :step/content {:db/id #edb/ref 17592186059827 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059386 :question/id #uuid "b828f144-b8b8-5eda-94f1-43cccdcb1aaa" :question/math-academy-id "e-10786"} :knowledge-point/id #uuid "bdf77469-6c2a-5339-b216-3bc5e2316e4d" :knowledge-point/question-generator {:db/id #edb/ref 17592186502628} :knowledge-point/questions [{:db/id #edb/ref 17592186060012} {:db/id #edb/ref 17592186060252} {:db/id #edb/ref 17592186483380} {:db/id #edb/ref 17592186483383} {:db/id #edb/ref 17592186502537} {:db/id #edb/ref 17592186502542} {:db/id #edb/ref 17592186502553} {:db/id #edb/ref 17592186502562} {:db/id #edb/ref 17592186502563} {:db/id #edb/ref 17592186502567} {:db/id #edb/ref 17592186502569} {:db/id #edb/ref 17592186502574} {:db/id #edb/ref 17592186502580} {:db/id #edb/ref 17592186502592} {:db/id #edb/ref 17592186502593} {:db/id #edb/ref 17592186502615} {:db/id #edb/ref 17592186502620} {:db/id #edb/ref 17592186542222}] :knowledge-point/title "Translating Between Half-Open Intervals and Inequalities"} :step/id #uuid "9d9e1551-d8ec-536f-9036-9555d43eae22" :step/math-academy-id 40883 :step/next {:db/id #edb/ref 17592186060774}} {:db/id #edb/ref 17592186060774 :step/content {:db/id #edb/ref 17592186059828 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059387 :question/id #uuid "45d05c7d-e278-552f-a524-926d4a57d870" :question/math-academy-id "e-10787"} :knowledge-point/id #uuid "c8c3e092-d9ff-5dc9-ad1e-f31aa2b226ba" :knowledge-point/question-generator {:db/id #edb/ref 17592186502851} :knowledge-point/questions [{:db/id #edb/ref 17592186060264} {:db/id #edb/ref 17592186060267} {:db/id #edb/ref 17592186483404} {:db/id #edb/ref 17592186483422} {:db/id #edb/ref 17592186502760} {:db/id #edb/ref 17592186502762} {:db/id #edb/ref 17592186502764} {:db/id #edb/ref 17592186502775} {:db/id #edb/ref 17592186502776} {:db/id #edb/ref 17592186502789} {:db/id #edb/ref 17592186502791} {:db/id #edb/ref 17592186502793} {:db/id #edb/ref 17592186502804} {:db/id #edb/ref 17592186502805} {:db/id #edb/ref 17592186502808} {:db/id #edb/ref 17592186502811} {:db/id #edb/ref 17592186502819} {:db/id #edb/ref 17592186502843}] :knowledge-point/title "Translating Between Half-Open Intervals and Number Lines"} :step/id #uuid "6f9b14a3-07a8-5f6b-9c69-4df4a979ee4a" :step/math-academy-id 40887} {:db/id #edb/ref 17592186060775 :step/content {:db/id #edb/ref 17592186059829 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059388 :question/id #uuid "6d4bd0a2-0961-54c1-b781-b470d420d848" :question/math-academy-id "e-10816"} :knowledge-point/id #uuid "2f519fa9-de89-5b00-aa02-312cf8e32cba" :knowledge-point/question-generator {:db/id #edb/ref 17592186502720} :knowledge-point/questions [{:db/id #edb/ref 17592186059958} {:db/id #edb/ref 17592186060311} {:db/id #edb/ref 17592186483384} {:db/id #edb/ref 17592186502629} {:db/id #edb/ref 17592186502634} {:db/id #edb/ref 17592186502645} {:db/id #edb/ref 17592186502663} {:db/id #edb/ref 17592186502670} {:db/id #edb/ref 17592186502690} {:db/id #edb/ref 17592186502691} {:db/id #edb/ref 17592186502698} {:db/id #edb/ref 17592186502699} {:db/id #edb/ref 17592186502701} {:db/id #edb/ref 17592186502713} {:db/id #edb/ref 17592186502715} {:db/id #edb/ref 17592186502718}] :knowledge-point/title "Converting Between Intervals and Inequalities: Closed Intervals"} :step/id #uuid "082973dc-66d1-5d9c-9dc3-ae132f451431" :step/math-academy-id 40993 :step/next {:db/id #edb/ref 17592186060772}} {:db/id #edb/ref 17592186060782 :step/content {:db/id #edb/ref 17592186060973 :tutorial/content "Now consider the region below, which represents the inequality $-3 \\leq x \\leq 1.$\n\n![](images/38/38c5bf5408bbbeb0f63e198e0564a37e8fe6a34d7f2ce340751d8000443123ed.png)\n\nWe express this inequality using interval notation as follows:\n\n$$\n[-3,1]\n$$\n\nThe brackets $[\\phantom{0}]$ tell us that the endpoints $x=-3$ and $x=1$ *are* included in this interval.\n\nWhen an interval includes the endpoints, we say that it is **closed**. \n\nMore formally, we can also write\n\n$$\nx\\in [-3,1].\n$$\n\nThe above reads, \"*$x$ belongs to the (closed) interval $[-3,1].$*\"" :tutorial/id #uuid "27f305da-f09b-53e5-a8b8-a30d29eb0f15" :tutorial/math-academy-id 6821 :tutorial/title "Closed Intervals"} :step/id #uuid "b373d760-0d5d-5ec6-a830-9c562d00e5be" :step/math-academy-id 41408 :step/next {:db/id #edb/ref 17592186060771}}] :activity/title "Interval Notation" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186059917}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074775} :activity/id #uuid "e7d0e915-5cc0-5d0f-b4c6-027cb6220aa3" :activity/scope {:db/id #edb/ref 17592186049463 :topic/id #uuid "f762d717-d0f3-5d60-8a4d-561cc023f344" :topic/math-academy-id 524} :activity/steps [{:db/id #edb/ref 17592186074775 :step/content {:db/id #edb/ref 17592186075029 :tutorial/content "Given a number, its **additive inverse** is the number we need to add to get zero.\nTo find the additive inverse of a number, we change its sign by placing a minus symbol $({\\color{red}{-}})$ in front of it. \n\nFor example, to find the additive inverse of $5,$ we obtain \n\n$$\n{\\color{red}{-}}\\,(5) = -5.\n$$\n\nTo check our work, we add the inverse to the original number. If we're correct, we should get zero.\n\n$$\n5+(-5) = 5-5 = 0 \\quad {\\color{green}\\checkmark}\n$$" :tutorial/id #uuid "21fd73d9-f9b8-5ef8-9e18-9ba21d6d8d79" :tutorial/math-academy-id 15159 :tutorial/title "Introduction"} :step/id #uuid "c1f41837-dee8-5f07-9c9f-5cfaebd69d2e" :step/math-academy-id 620103 :step/next {:db/id #edb/ref 17592186074776}} {:db/id #edb/ref 17592186074776 :step/content {:db/id #edb/ref 17592186073820 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073437 :question/id #uuid "735e0a05-bc90-5b18-b096-d51d9f9c50e3" :question/math-academy-id "e-22709"} :knowledge-point/id #uuid "d7d26bc9-6f89-5da4-b8a9-6be6f4280f81" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050421}] :knowledge-point/questions [{:db/id #edb/ref 17592186074498} {:db/id #edb/ref 17592186074499} {:db/id #edb/ref 17592186445907} {:db/id #edb/ref 17592186445912} {:db/id #edb/ref 17592186533988} {:db/id #edb/ref 17592186542154}] :knowledge-point/title "Finding the Additive Inverse of a Positive Integer"} :step/id #uuid "6255e96d-283e-52d1-815a-3ba256caf351" :step/math-academy-id 620104 :step/next {:db/id #edb/ref 17592186074777}} {:db/id #edb/ref 17592186074777 :step/content {:db/id #edb/ref 17592186075030 :tutorial/content "To find the additive inverse of a negative number, we can use the same process.\n\nFor instance, to find the additive inverse of the number $-3,$ we change its sign by placing a minus symbol $({\\color{red}{-}})$ in front of it.\nSo, we obtain\n\n$$\n{\\color{red}{-}}\\,(-3) = 3.\n$$\n\nAgain, we check our work by adding the inverse to the original number. If we're correct, we should get zero.\n\n$$\n(-3)+3 = -3+3 = 0 \\quad {\\color{green}\\checkmark}\n$$" :tutorial/id #uuid "d30313d5-d29e-5eea-b11c-0619439becb0" :tutorial/math-academy-id 15161 :tutorial/title "Finding the Additive Inverse of a Negative Integer"} :step/id #uuid "29da515a-cf3c-5833-83f4-fdcc7d1ce495" :step/math-academy-id 620107 :step/next {:db/id #edb/ref 17592186074778}} {:db/id #edb/ref 17592186074778 :step/content {:db/id #edb/ref 17592186073821 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073438 :question/id #uuid "de14e5df-9b12-5878-a134-9b02db1d5b5d" :question/math-academy-id "e-22710"} :knowledge-point/id #uuid "b38f30b0-9e05-510f-9ba6-928ab1b8482b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048546}] :knowledge-point/questions [{:db/id #edb/ref 17592186074497} {:db/id #edb/ref 17592186074500} {:db/id #edb/ref 17592186445909} {:db/id #edb/ref 17592186445910} {:db/id #edb/ref 17592186445911} {:db/id #edb/ref 17592186531586}] :knowledge-point/title "Finding the Additive Inverse of a Negative Integer"} :step/id #uuid "d90caf33-37bf-5639-9bbb-33de68320604" :step/math-academy-id 620108 :step/next {:db/id #edb/ref 17592186074779}} {:db/id #edb/ref 17592186074779 :step/content {:db/id #edb/ref 17592186073822 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073439 :question/id #uuid "8b152054-aec8-58f3-9a7a-e435e49fe8c9" :question/math-academy-id "e-22711"} :knowledge-point/id #uuid "b88b2def-7312-5076-9ff3-60319d37f1d6" :knowledge-point/questions [{:db/id #edb/ref 17592186074501} {:db/id #edb/ref 17592186074502} {:db/id #edb/ref 17592186445906} {:db/id #edb/ref 17592186445908}] :knowledge-point/title "Finding the Additive Inverse of a Decimal or Fraction"} :step/id #uuid "0a3e5261-c30f-51be-aebe-8a0790994019" :step/math-academy-id 620111}] :activity/title "Additive Inverses of Numbers" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073944}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055548} :activity/id #uuid "0b4acd9e-f257-5db1-a9ff-f4bc70fb528a" :activity/scope {:db/id #edb/ref 17592186049844 :topic/id #uuid "181a217b-aefb-5b16-abf7-81644bd30ca2" :topic/math-academy-id 96} :activity/steps [{:db/id #edb/ref 17592186055548 :step/content {:db/id #edb/ref 17592186056066 :tutorial/content "Let's take a number, say, $-3.$ We can depict it on a number line as follows:\n\n![](images/de/ded8743284f207bff35eba24617fd4245a69d439ed151d09eed564813f9d72fb.png)\n\nThe *distance* between the number $-3$ and $0$ is known as the **absolute value** of $-3.$ We write it as\n\n$$\n|-3| = {\\color{red}3}.\n$$\n\nSimilarly, $|\\,2\\,|$, the absolute value of the number $2$, is the distance between $2$ and $0$:\n\n![](images/f4/f44fcd05fb0932083d48c8b11892247d8de8fbc46ccf7186fb12843702181aea.png)\n\nWe write $|\\,2\\,| = {\\color{red}2}.$\n\nSo, the absolute value simply \n\n- *removes the minus sign*, if the number is negative, or\n\n- does nothing, if the number is non-negative.\n\nSometimes, we can be asked to evaluate an expression involving the absolute value function, like $|x +1| + 5$ when $x=-3.$ In this case, we evaluate the expression inside the absolute value before simplifying the rest of the expression: \n\n$$\n\\begin{aligned}|x+1|+5 & = \\\\ |(-3)+1|+5 & = \\\\ |-2|+5 & = \\\\ 2+5 & = \\\\ 7 & \\end{aligned}\n$$" :tutorial/id #uuid "3325f9a7-d389-562e-ac1b-4eb26671f84b" :tutorial/math-academy-id 8817 :tutorial/title "Introduction"} :step/id #uuid "2ecbe2d3-3bf6-5c94-9e47-13b35a557d38" :step/math-academy-id 147765 :step/next {:db/id #edb/ref 17592186055549}} {:db/id #edb/ref 17592186055549 :step/content {:db/id #edb/ref 17592186054626 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054470 :question/id #uuid "af2c36f6-7258-56b3-aabc-c0736bdfb6a5" :question/math-academy-id "e-14209"} :knowledge-point/id #uuid "2a5017c8-1933-515c-980a-c4b6a8a46334" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048599} {:db/id #edb/ref 17592186049688} {:db/id #edb/ref 17592186050127}] :knowledge-point/questions [{:db/id #edb/ref 17592186055102} {:db/id #edb/ref 17592186055113} {:db/id #edb/ref 17592186055175} {:db/id #edb/ref 17592186481347} {:db/id #edb/ref 17592186481392} {:db/id #edb/ref 17592186481436} {:db/id #edb/ref 17592186492855} {:db/id #edb/ref 17592186538925} {:db/id #edb/ref 17592186538949} {:db/id #edb/ref 17592186539001} {:db/id #edb/ref 17592186542170}] :knowledge-point/title "Evaluating an Expression With One Absolute Value"} :step/id #uuid "4957b9ec-7c2c-553a-b341-f367fd1d5e59" :step/math-academy-id 147766 :step/next {:db/id #edb/ref 17592186055550}} {:db/id #edb/ref 17592186055550 :step/content {:db/id #edb/ref 17592186054627 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054471 :question/id #uuid "2af15364-dc4d-52c1-a519-02e8568279ae" :question/math-academy-id "e-14212"} :knowledge-point/id #uuid "9d29b448-4fd6-51bc-b2f0-92e3d909f299" :knowledge-point/questions [{:db/id #edb/ref 17592186055103} {:db/id #edb/ref 17592186055104} {:db/id #edb/ref 17592186055114} {:db/id #edb/ref 17592186481358} {:db/id #edb/ref 17592186481394} {:db/id #edb/ref 17592186481409} {:db/id #edb/ref 17592186492854} {:db/id #edb/ref 17592186492867} {:db/id #edb/ref 17592186538969} {:db/id #edb/ref 17592186538971} {:db/id #edb/ref 17592186539026}] :knowledge-point/title "Evaluating an Expression With Two Absolute Values"} :step/id #uuid "ea43903e-13f4-5326-a1ae-670194c48ad9" :step/math-academy-id 147770}] :activity/title "Absolute Value Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054936}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186493004} :activity/id #uuid "d762c7c1-b2fc-50f1-a9fc-7430b3a5a235" :activity/scope {:db/id #edb/ref 17592186049844 :topic/id #uuid "181a217b-aefb-5b16-abf7-81644bd30ca2" :topic/math-academy-id 96} :activity/steps [{:db/id #edb/ref 17592186492973 :step/content {:db/id #edb/ref 17592186492867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dab20d8-435c-5874-9820-b9c7777aa63b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186492238} {:answer/id #uuid "23606116-0c3d-57f4-9d18-6b22a6023384" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186492290} {:answer/id #uuid "a1fdf384-9dc0-54c1-8ead-ad298d903b8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186492542} {:answer/id #uuid "cabd6727-7e51-5b45-af79-5c74ca0fead2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186492621} {:answer/id #uuid "fb1e9546-e023-51f6-b4d3-475e7aee4ad8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186492700}] :answer-field/correct {:db/id #edb/ref 17592186492238} :answer-field/id #uuid "cc5e42ce-3f11-5ff2-b5ec-1401d70485f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492787}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "63dd321a-10a4-552c-a65d-35ddf70e7775" :question/math-academy-id "q-61447" :question/problem "If $x=-2$ then $|x+3|-|3x-1|+x=$" :question/worked-solution "We substitute $x=-2$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|x+3|-|3x-1|+x & = \\\\ |-2+3|-|3(-2)-1|+(-2) & = \\\\ |1|-|-6-1|-2 & = \\\\ |1|-|-7|-2 & = \\\\ 1-7-2 & = \\\\ -8 & \\end{aligned}\n$$"} :step/id #uuid "99842b79-76db-5fb3-bbaf-66d05b3bbff6" :step/next {:db/id #edb/ref 17592186492988}} {:db/id #edb/ref 17592186492988 :step/content {:db/id #edb/ref 17592186492854 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d45f977-a56a-5280-89d6-5518e60df5dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186492275} {:answer/id #uuid "59218a65-4882-5870-b7c8-86f2679e51b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186492393} {:answer/id #uuid "9f2ed906-57e2-5ab3-bd06-a081c49eed93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "41" :db/id #edb/ref 17592186492529} {:answer/id #uuid "a1b41a41-e6b5-57fd-8c0d-4ddb0799752c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186492540} {:answer/id #uuid "b55f6a79-05b0-5b79-92d7-0fdbb4341b3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "29" :db/id #edb/ref 17592186492581}] :answer-field/correct {:db/id #edb/ref 17592186492540} :answer-field/id #uuid "eb93eac8-5e68-5a3c-9c7e-30e76a8c37ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492807}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "42db367f-fca9-5107-a4d2-7795dc6e4fc0" :question/math-academy-id "q-103235" :question/problem "Evaluate $|{x}^{2}|-2|x|+6$ for $x=-5.$" :question/worked-solution "We substitute $x=-5$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|{x}^{2}|-2|x|+6 & = \\\\ |(-5)^{2}|-2|-5|+6 & = \\\\ |25|-2(5)+6 & = \\\\ 25-10+6 & = \\\\ 21 & \\end{aligned}\n$$"} :step/id #uuid "b5660f48-4d6b-5934-ad67-9281c24d90f3"} {:db/id #edb/ref 17592186493004 :step/content {:db/id #edb/ref 17592186492855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fde7be7-c167-5669-9a0e-b5b44e3f124c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186492280} {:answer/id #uuid "54f5373f-0023-5804-abbc-0d46f9f86a86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186492378} {:answer/id #uuid "693a8a82-a0bc-5675-8d14-e1888aae079e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186492426} {:answer/id #uuid "b3421362-8e23-5e85-ae83-5b52d5e44df5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186492575} {:answer/id #uuid "e01edf29-ecf9-53cc-bc5d-84c6e77d2648" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-14" :db/id #edb/ref 17592186492652}] :answer-field/correct {:db/id #edb/ref 17592186492652} :answer-field/id #uuid "cef39244-d4ac-5c09-b904-ef69c6554e61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492789}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "46b75057-d4db-5536-a016-1c597f33ff13" :question/math-academy-id "q-25403" :question/problem "If $x=-9$ then $-|x-12|+7=$" :question/worked-solution "We substitute $x=-9$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}-|x-12|+7 & = \\\\ -|-9-12|+7 & = \\\\ -|-21|+7 & = \\\\ -21+7 & = \\\\ -14\\end{aligned}\n$$"} :step/id #uuid "f304f3f8-e188-5590-8410-c6b111d1b2ca" :step/next {:db/id #edb/ref 17592186492973}}] :activity/title "Absolute Value Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186492217}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186539090} :activity/id #uuid "e6236cb7-b333-595b-87b9-895ea4f220f1" :activity/scope {:db/id #edb/ref 17592186049844 :topic/id #uuid "181a217b-aefb-5b16-abf7-81644bd30ca2" :topic/math-academy-id 96} :activity/steps [{:db/id #edb/ref 17592186539042 :step/content {:db/id #edb/ref 17592186539026 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f530b9-512a-59c4-b8dc-f3b975a5f9af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186538250}] :answer-field/correct {:db/id #edb/ref 17592186538250} :answer-field/id #uuid "259bb8b7-b747-5b79-8d8c-16284cc398a3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186538821}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f4d3cdfc-97df-54f6-9ee5-ecd71be4d0bd" :question/math-academy-id "q-215802" :question/problem "If $x=2,$ then $|x+1{|}^{2}-|x-1{|}^{3}+2=${{field-1}}." :question/worked-solution "We substitute $x=2$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|x+1{|}^{2}-|x-1{|}^{3}+2 & = \\\\ |2+1{|}^{2}-|2-1{|}^{3}+2 & = \\\\ |3{|}^{2}-|1{|}^{3}+2 & = \\\\ {3}^{2}-{1}^{3}+2 & = \\\\ 9-1+2 & = \\\\ 10 & \\end{aligned}\n$$"} :step/id #uuid "1b023f9e-0298-554e-be5a-bf787e7e1d6c" :step/next {:db/id #edb/ref 17592186539052}} {:db/id #edb/ref 17592186539052 :step/content {:db/id #edb/ref 17592186538971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da4845bf-1401-512a-8c52-28302042301c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186538733}] :answer-field/correct {:db/id #edb/ref 17592186538733} :answer-field/id #uuid "ea38a251-ab23-5c87-abfe-28a8670ee8a6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186538912}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6a42fde9-ed9b-5e9d-86c6-940fc99b7d25" :question/math-academy-id "q-215803" :question/problem "If $y=0,$ then $|2y+3{|}^{3}-|y+2|=${{field-1}}." :question/worked-solution "We substitute $y=0$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|2y+3{|}^{3}-|y+2| & = \\\\ |2(0)+3{|}^{3}-|0+2| & = \\\\ |0+3{|}^{3}-|0+2| & = \\\\ |3{|}^{3}-|2| & = \\\\ {3}^{3}-2 & = \\\\ 27-2 & = \\\\ 25 & \\end{aligned}\n$$"} :step/id #uuid "3291a708-b56a-592b-9ee3-bf5079c19589"} {:db/id #edb/ref 17592186539084 :step/content {:db/id #edb/ref 17592186538949 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b62c904-4d93-5e91-8fcd-3d63b312cd13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186538293} {:answer/id #uuid "543e9569-ebcc-52ee-b615-3c6d09b84d55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186538415} {:answer/id #uuid "5cb9b356-5932-53cb-a1f6-0aeb3ef4cb11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186538431} {:answer/id #uuid "d1540b6d-345a-5120-8ab5-0582cc400a53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186538717} {:answer/id #uuid "e404cb10-11b0-59fe-9d87-fdcbd419c82f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186538752}] :answer-field/correct {:db/id #edb/ref 17592186538431} :answer-field/id #uuid "52c1e553-d74d-59fd-a539-db479dc23184" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538846}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3e848dbc-438d-5d9d-8de6-41c96328b31b" :question/math-academy-id "q-131806" :question/problem "If $x=2$ then $|3-{2}^{x}|+4=$" :question/worked-solution "We substitute $x=2$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|3-{2}^{x}|+4 & = \\\\ |3-{2}^{2}|+4 & = \\\\ |3-4|+4 & = \\\\ |-1|+4 & = \\\\ 1+4 & = \\\\ 5\\end{aligned}\n$$"} :step/id #uuid "a08163e8-a307-5f7d-8731-fa1cbf7422a3" :step/next {:db/id #edb/ref 17592186539103}} {:db/id #edb/ref 17592186539090 :step/content {:db/id #edb/ref 17592186538969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18a638e8-6cda-5be6-a77d-f20d9d4443b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186538288} {:answer/id #uuid "18f4ba97-b8dc-5324-888d-a39a7e05bc49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186538290} {:answer/id #uuid "310cbe50-de0c-523d-89e2-0bff3267c529" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186538331} {:answer/id #uuid "3cdc4bb2-5d9e-5596-97e3-5781ff5e4c86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186538357} {:answer/id #uuid "a07da073-1567-54b2-ab82-80e4aeed8938" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186538615}] :answer-field/correct {:db/id #edb/ref 17592186538290} :answer-field/id #uuid "e60f0809-006d-5d59-8100-1de6658c3ea0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538911}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "68630caf-af8f-50ee-bc03-18c9657f8cb4" :question/math-academy-id "q-103238" :question/problem "Evaluate $|x-5|-|3-x|+2$ for $x=8.$" :question/worked-solution "We substitute $x=8$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|x-5|-|3-x|+2 & = \\\\ |8-5|-|3-8|+2 & = \\\\ |3|-|-5|+2 & = \\\\ 3-5+2 & = \\\\ 0 & \\end{aligned}\n$$"} :step/id #uuid "b0b38d0b-0e33-50a6-903b-f2396119b21a" :step/next {:db/id #edb/ref 17592186539084}} {:db/id #edb/ref 17592186539103 :step/content {:db/id #edb/ref 17592186539001 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24a75248-37a5-5151-b8cb-0f5575576d3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186538306}] :answer-field/correct {:db/id #edb/ref 17592186538306} :answer-field/id #uuid "4149acf6-bd2b-5cdb-9109-58f31fcedb99" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186538836}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b8991b67-f1ef-53f9-975f-0551777dc4d1" :question/math-academy-id "q-212313" :question/problem "If $x=1,$ then $3-|{2}^{-x}-\\frac{5}{2}|=${{field-1}}." :question/worked-solution "We substitute $x=1$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}3-|{2}^{-x}-\\frac{5}{2}| & = \\\\ 3-|{2}^{-1}-\\frac{5}{2}| & = \\\\ 3-|\\frac{1}{2}-\\frac{5}{2}| & = \\\\ 3-|-2| & = \\\\ 3-2 & = \\\\ 1\\end{aligned}\n$$"} :step/id #uuid "d775aea7-e108-5ef4-9f6e-296230133d2c" :step/next {:db/id #edb/ref 17592186539042}}] :activity/title "Absolute Value Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186538231}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055883} :activity/id #uuid "105911a6-a8fa-5b40-bf5e-8a3845e590dc" :activity/scope {:db/id #edb/ref 17592186050613 :topic/id #uuid "58d4d7b7-4b91-5e3c-ba04-7522d5cfa8f6" :topic/math-academy-id 40} :activity/steps [{:db/id #edb/ref 17592186055883 :step/content {:db/id #edb/ref 17592186056009 :tutorial/content "Let's suppose that we want to solve an equation like \n\n$$\n\\dfrac x 6 = 4.\n$$\n\nFor this, we can use the **multiplication principle.** The multiplication principle tells us that multiplying (or dividing) both sides of an equation by the same number does not change its solution.\n\nIn this case, the variable $x$ is being *divided* by $6.$ To isolate $x$, we can perform the *opposite* operation, which is *multiplying* by $6$. So, we multiply both sides of the equation by $6.$\n\n$$\n\\eqalign{\n\t\t\\dfrac x 6 \t\t\t\t\t&= 4 \\[5pt]\n\t\t{\\color{blue}{6}} \\cdot \\dfrac x 6  \t&= {\\color{blue}{6}}\\cdot 4\\[5pt]\n\t\t\\dfrac{6x}{6}\t\t\t&=24\\[5pt]\n\t}\n$$\n\n \n\nNow, we can cancel a common factor of $6$ from both the numerator and denominator.\n\n$$\n\\eqalign{\n\t\t\\dfrac{6x}{6}\t\t\t&=24 \\\n\t\t\\dfrac{ \\cancel{6} x}{\\cancel{6} }\t\t\t&=24 \\\n\t\tx\t\t\t\t&=24\n\t}\n$$\n\n \n\nThus, our solution is $x=24.$ Let's check that this solution is correct by plugging it back into the original equation:\n\n$$\n\\eqalign{\n    \t\t\\dfrac x 6 &=4 \\[5pt]\n    \t\t\\dfrac{24}{6} &=4 \\[5pt]\n\t\t4 &= 4 \\; {\\color{green}{\\checkmark}}\n\t}\n$$" :tutorial/id #uuid "66f28923-eb93-5bc0-b870-b4316258a3c8" :tutorial/math-academy-id 8052 :tutorial/title "Introduction"} :step/id #uuid "85cdcdec-1c60-5ac5-8e3f-e25e47c0bb28" :step/math-academy-id 72101 :step/next {:db/id #edb/ref 17592186055884}} {:db/id #edb/ref 17592186055884 :step/content {:db/id #edb/ref 17592186054834 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054381 :question/id #uuid "c64cd16e-2f9d-5564-8d04-eddcad2c5d01" :question/math-academy-id "e-12859"} :knowledge-point/id #uuid "4007f63e-0a99-57ca-a1f6-190b21f02ecc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050414} {:db/id #edb/ref 17592186050599}] :knowledge-point/questions [{:db/id #edb/ref 17592186055151} {:db/id #edb/ref 17592186055443} {:db/id #edb/ref 17592186479855} {:db/id #edb/ref 17592186479893}] :knowledge-point/title "Linear Equations Requiring Multiplication by a Positive Integer"} :step/id #uuid "036eee4c-d08b-5bac-82ff-0d8314f256ca" :step/math-academy-id 72102 :step/next {:db/id #edb/ref 17592186055885}} {:db/id #edb/ref 17592186055885 :step/content {:db/id #edb/ref 17592186054835 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054388 :question/id #uuid "cbce1708-81ba-5d37-ae21-fc8d94ebbc2f" :question/math-academy-id "e-12894"} :knowledge-point/id #uuid "b765f7b2-639a-5519-9170-02a4fcb0f8fe" :knowledge-point/questions [{:db/id #edb/ref 17592186054940} {:db/id #edb/ref 17592186055290} {:db/id #edb/ref 17592186479828} {:db/id #edb/ref 17592186479865}] :knowledge-point/title "Cases Where the Variable Is on the Right-Hand Side"} :step/id #uuid "f810611a-c93d-5ca0-8ad1-26bd885d89c1" :step/math-academy-id 72105 :step/next {:db/id #edb/ref 17592186055886}} {:db/id #edb/ref 17592186055886 :step/content {:db/id #edb/ref 17592186056010 :tutorial/content "In order to remove a negative sign from our variable, we can multiply both sides by $-1$. This way, the two negatives will cancel out to form a positive. \n\nFor example, suppose that we have the equation\n\n$$\n-x = 3\n$$\n\nWe can isolate $x$ by multiplying both sides of the equation by $-1,$ as follows:\n\n$$\n\\begin{aligned}-x & =3 \\\\ (-1)\\cdot (-x) & =(-1)\\cdot 3 \\\\ x & =-3\\end{aligned}\n$$\n\nTherefore, the solution to the equation is $x=-3.$ Let's check to see that this works by substituting our solution back into the original equation.\n\n$$\n\\begin{aligned}-x & =3 \\\\ -(-3) & =3 \\\\ 3 & =3\\,✓\\end{aligned}\n$$" :tutorial/id #uuid "7de479d1-5bb2-5cc9-9fdc-117a02790cab" :tutorial/math-academy-id 8053 :tutorial/title "Removing a Negative Sign from a Variable"} :step/id #uuid "91e35f06-1502-52eb-91c6-d755a826ebfc" :step/math-academy-id 72108 :step/next {:db/id #edb/ref 17592186055887}} {:db/id #edb/ref 17592186055887 :step/content {:db/id #edb/ref 17592186054836 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054382 :question/id #uuid "5fe35108-2fa8-563e-862e-ad27d4ed5334" :question/math-academy-id "e-12860"} :knowledge-point/id #uuid "712bc4c6-aeaf-5081-9e64-791027b38963" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049349}] :knowledge-point/questions [{:db/id #edb/ref 17592186055291} {:db/id #edb/ref 17592186055420} {:db/id #edb/ref 17592186479831} {:db/id #edb/ref 17592186479882} {:db/id #edb/ref 17592186538937} {:db/id #edb/ref 17592186542151}] :knowledge-point/title "Linear Equations Requiring Multiplication by a Negative Integer"} :step/id #uuid "fe58020e-d340-5fac-88b2-1c50209326d9" :step/math-academy-id 72109 :step/next {:db/id #edb/ref 17592186055888}} {:db/id #edb/ref 17592186055888 :step/content {:db/id #edb/ref 17592186056011 :tutorial/content "To solve an equation like $7x = 21$, we again need to look at what's happening to the variable and ask ourselves what the opposite operation is.\n\nIn this case, the variable $x$ is being *multiplied* by $7.$ To isolate $x$, we can perform the *opposite* operation, which is *dividing* by $7$. So, we divide both sides of the equation by $7.$\n\n$$\n\\eqalign{\n\t\t7x &= 21 \\[5pt]\n\t\t\\dfrac{7x}{{\\color{blue}7}} &=\\dfrac{21}{{\\color{blue}7}}\n\t}\n$$\n\n \n\nNow, we can cancel a common factor of $7$ from both the numerator and denominator.\n\n$$\n\\eqalign{\n\t\t\\dfrac{7x}{{\\color{blue}7}} &=\\dfrac{21}{{\\color{blue}7}}\\[5pt]\n\t\t\\dfrac{\\cancel{7}x}{\\cancel{\\color{blue}7}} &=3 \\[5pt]\n\t\tx &=3\n\t}\n$$\n\n \n\nLet's check that our answer is correct by plugging it back into the original equation:\n\n$$\n\\eqalign{\n    \t\t7x &=21 \\[5pt]\n    \t\t7(3) &=21 \\[5pt]\n\t\t21 &= 21 \\; {\\color{green}{\\checkmark}}\n\t}\n$$\n\n**Note:** If there is a negative coefficient on a variable, we can get rid of it by dividing, like we do with positive coefficients. For example:\n\n$$\n\\begin{aligned}-2y & =10 \\\\ \\frac{-2y}{-2} & =\\frac{10}{-2} \\\\ \\frac{\\cancel{-2}y}{\\cancel{-2}} & =-5 \\\\ y & =-5\\end{aligned}\n$$" :tutorial/id #uuid "1a74f63d-cfcc-5a3f-899c-6b15cfa2247f" :tutorial/math-academy-id 8054 :tutorial/title "Using the Multiplication Principle to Divide"} :step/id #uuid "afb3bda0-823e-547e-bb19-4e9d28f09976" :step/math-academy-id 72112 :step/next {:db/id #edb/ref 17592186055889}} {:db/id #edb/ref 17592186055889 :step/content {:db/id #edb/ref 17592186054837 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054383 :question/id #uuid "68865bc2-e4e2-53d9-9988-4fa962e04746" :question/math-academy-id "e-12861"} :knowledge-point/id #uuid "e153c18d-6f3e-5fef-a006-c5597cd88bc9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050719}] :knowledge-point/questions [{:db/id #edb/ref 17592186055033} {:db/id #edb/ref 17592186055274} {:db/id #edb/ref 17592186479844} {:db/id #edb/ref 17592186479891}] :knowledge-point/title "Linear Equations Requiring Division"} :step/id #uuid "1b859cff-8545-5c6f-9fc0-22c30fff2c3b" :step/math-academy-id 72113}] :activity/title "Solving One-Step Multiplication and Division Equations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054901}] [{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186065109} :activity/id #uuid "7e0946df-45c0-5786-9c65-795f6164a618" :activity/scope {:db/id #edb/ref 17592186050818 :topic/id #uuid "68e64e22-0e3c-5eac-8837-c36b21dd36c0" :topic/math-academy-id 371} :activity/steps [{:db/id #edb/ref 17592186065109 :step/content {:db/id #edb/ref 17592186065440 :tutorial/content "When we want to multiply two binomials, we take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\nFor example, to multiply $({\\color{blue}{x}} + {\\color{red}{3}})$ and $(x + 2),$ we multiply ${\\color{blue}{x}}$ and $(x + 2),$ and then we add this to the product of ${\\color{red}{3}}$ and $(x+2)$:\n\n$$\n\\eqalign{\n\t\t({\\color{blue}{x}} + {\\color{red}{3}})(x + 2) &= \\[5pt]\n\t\t{\\color{blue}{x}}(x + 2) + {\\color{red}{3}}(x + 2) &= \\[5pt]\n\t\tx^2 + 2x + 3x + 6 &= \\[5pt]\n\t\tx^2 + 5x + 6\n\t}\n$$" :tutorial/id #uuid "0cea50d1-e4ce-511f-821f-0e5e04b6eca1" :tutorial/math-academy-id 8877 :tutorial/title "Introduction"} :step/id #uuid "034d8161-5ef0-5329-ac71-ca2e17506a54" :step/math-academy-id 171384 :step/next {:db/id #edb/ref 17592186065110}} {:db/id #edb/ref 17592186065110 :step/content {:db/id #edb/ref 17592186064241 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063988 :question/id #uuid "ab6787e7-5b47-51a6-8967-4ede296cc44f" :question/math-academy-id "e-14313"} :knowledge-point/id #uuid "7ff8de23-e4f2-51e1-9390-78ff7edd2176" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048548} {:db/id #edb/ref 17592186049496} {:db/id #edb/ref 17592186049538}] :knowledge-point/questions [{:db/id #edb/ref 17592186064595} {:db/id #edb/ref 17592186064676} {:db/id #edb/ref 17592186481382}] :knowledge-point/title "Multiplying Binomials"} :step/id #uuid "befc51ec-1128-57f9-9017-8b1297e2a304" :step/math-academy-id 171385 :step/next {:db/id #edb/ref 17592186065111}} {:db/id #edb/ref 17592186065111 :step/content {:db/id #edb/ref 17592186064242 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063989 :question/id #uuid "818a9bf5-5ed5-5809-a295-3d332ce98b47" :question/math-academy-id "e-14316"} :knowledge-point/id #uuid "36d4e3a1-9f2e-5434-bfc9-10c29a426e07" :knowledge-point/questions [{:db/id #edb/ref 17592186064578} {:db/id #edb/ref 17592186064927} {:db/id #edb/ref 17592186481344} {:db/id #edb/ref 17592186481390} {:db/id #edb/ref 17592186495055} {:db/id #edb/ref 17592186495155}] :knowledge-point/title "Multiplying Binomials with Leading Coefficients"} :step/id #uuid "cd84d1a6-b898-5206-86c9-b0b4524beab8" :step/math-academy-id 171388 :step/next {:db/id #edb/ref 17592186065112}} {:db/id #edb/ref 17592186065112 :step/content {:db/id #edb/ref 17592186064243 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063990 :question/id #uuid "4e99bb73-42a1-5b11-8463-020f297c5afc" :question/math-academy-id "e-14317"} :knowledge-point/id #uuid "27aef839-e6a9-5c8e-bcd7-a2e9438968b0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048422}] :knowledge-point/questions [{:db/id #edb/ref 17592186064596} {:db/id #edb/ref 17592186064685} {:db/id #edb/ref 17592186481381} {:db/id #edb/ref 17592186495085} {:db/id #edb/ref 17592186542135}] :knowledge-point/title "Multiplying Binomials with Higher Powers and Multiple Variables"} :step/id #uuid "f2afcd5e-f99f-58d4-92e1-abd2be293082" :step/math-academy-id 171391}] :activity/title "Multiplying Binomials" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064457}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186495266} :activity/id #uuid "8721e25f-828d-529f-8d37-00132303e9c8" :activity/scope {:db/id #edb/ref 17592186050818 :topic/id #uuid "68e64e22-0e3c-5eac-8837-c36b21dd36c0" :topic/math-academy-id 371} :activity/steps [{:db/id #edb/ref 17592186495211 :step/content {:db/id #edb/ref 17592186495055 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25e004be-f08e-52db-afcf-7bfb57aca531" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15{w}^{2}+19w-7" :db/id #edb/ref 17592186494390} {:answer/id #uuid "33f29d9f-b7f9-538d-84ef-87f102db7a58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15{w}^{2}-19w-10" :db/id #edb/ref 17592186494421} {:answer/id #uuid "4a1a226c-3b58-5de1-bdd1-09862e44a749" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15{w}^{2}-31w-7" :db/id #edb/ref 17592186494467} {:answer/id #uuid "725a4025-c76c-5f78-bc98-4504976b2a0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15{w}^{2}+19w-10" :db/id #edb/ref 17592186494562} {:answer/id #uuid "c9194380-fd78-526b-86b8-a0353fc773b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15{w}^{2}-31w-10" :db/id #edb/ref 17592186494791}] :answer-field/correct {:db/id #edb/ref 17592186494421} :answer-field/id #uuid "cdeb2f7f-39f3-55df-bda0-3ce7a30bfa82" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186495015}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0944dac9-480d-52ed-acdf-aeb980d5e726" :question/math-academy-id "q-52152" :question/problem "$(5w+2)(3w-5)=$" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(5w+2)(3w-5) & = \\\\ 5w(3w-5)+2(3w-5) & = \\\\ 15{w}^{2}-25w+6w-10 & = \\\\ 15{w}^{2}-19w-10\\end{aligned}\n$$"} :step/id #uuid "6dab3f05-590c-5fd9-986b-e9d3f2e3114c" :step/next {:db/id #edb/ref 17592186495254}} {:db/id #edb/ref 17592186495254 :step/content {:db/id #edb/ref 17592186495155 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c2a21ab-44c4-5643-851b-b4a76932cc75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16y^{2}+42y+5" :db/id #edb/ref 17592186494344}] :answer-field/correct {:db/id #edb/ref 17592186494344} :answer-field/id #uuid "e00f9b37-087b-5f93-99a9-aa065185418d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186495027}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e2cad58f-c472-581c-a16b-711a6072cc50" :question/math-academy-id "q-216712" :question/problem "Expand the following product of binomials. Write your answer in **standard form.**\n\n$(8y+1)(2y+5)=$\n{{field-1}}" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(8y+1)(2y+5) & = \\\\ 8y(2y+5)+1(2y+5) & = \\\\ 16{y}^{2}+40y+2y+5 & = \\\\ 16{y}^{2}+42y+5\\end{aligned}\n$$"} :step/id #uuid "d0ea6c41-f392-560c-af01-cf23e5e44c12"} {:db/id #edb/ref 17592186495266 :step/content {:db/id #edb/ref 17592186495085 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b16ee72-72ca-517a-b1b1-2198b148afbc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{3}+rs-2s{r}^{2}-2{s}^{3}" :db/id #edb/ref 17592186494371} {:answer/id #uuid "6d7ad74c-af73-5446-9052-df37d91b1f6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{3}+r{s}^{2}-2s{r}^{2}-{s}^{3}" :db/id #edb/ref 17592186494544} {:answer/id #uuid "759904a1-8636-537e-9c40-516d7deaa4c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{3}+r{s}^{2}-2s{r}^{2}+2{s}^{3}" :db/id #edb/ref 17592186494568} {:answer/id #uuid "907ffe26-5485-53ae-a1fa-c8f1197ef46e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{3}+r{s}^{2}-2s{r}^{2}-2{s}^{3}" :db/id #edb/ref 17592186494646} {:answer/id #uuid "ad0f2020-3fca-5d25-b5e4-b0d419345bb8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{3}+rs-2s{r}^{2}+{s}^{3}" :db/id #edb/ref 17592186494717}] :answer-field/correct {:db/id #edb/ref 17592186494646} :answer-field/id #uuid "6164af12-a061-5247-be0b-02a0af340dc4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494960}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4f37487a-b4b8-5992-9edf-d3983de67b65" :question/math-academy-id "q-31319" :question/problem "$(r-2s)({r}^{2}+{s}^{2})=$" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(r-2s)({r}^{2}+{s}^{2}) & = \\\\ r({r}^{2}+{s}^{2})+(-2s)({r}^{2}+{s}^{2}) & = \\\\ {r}^{3}+r{s}^{2}-2s{r}^{2}-2{s}^{3}.\\end{aligned}\n$$\n\nWe cannot simplify the above expression any further because there are no like terms."} :step/id #uuid "eb20a321-9a03-525a-8fd7-cf559bae04c2" :step/next {:db/id #edb/ref 17592186495211}}] :activity/title "Multiplying Binomials" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186494307}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074877} :activity/id #uuid "b18f153a-24ae-52c2-833b-f1d51a752952" :activity/scope {:db/id #edb/ref 17592186050948 :topic/id #uuid "7447137e-4148-57e3-9e8c-8ef64742b913" :topic/math-academy-id 561} :activity/steps [{:db/id #edb/ref 17592186074877 :step/content {:db/id #edb/ref 17592186074968 :tutorial/content "Remember that we can place equivalent ratios in a ratio table, like the one below.\n\n| $\\color{blue}x$ | $\\color{red}y$ |\n| --- | --- |\n| $\\color{blue}1$ | $\\color{red}2$ |\n| $\\color{blue}2$ | $\\color{red}4$ |\n| $\\color{blue}4$ | $\\color{red}8$ |\n\nBy setting the values in the left column as $\\color{blue}x$-coordinates and the values in the right column as the corresponding $\\color{red}y$-coordinates, we can graph the points to represent a relationship between the ratios.\n\nIn this case, we have the following ordered pairs: $({\\color{blue}1},{\\color{red}2}),$ $({\\color{blue}2},{\\color{red}4}),$ $({\\color{blue}4},{\\color{red}8}).$\n\nPlotting these points on a coordinate plane, we get the following graph:\n\n![](images/0c/0c4abb8d462730ed9b532feeca1e0a800f5376a978bfc799afb9d9a927ff310d.png)\n\nConnecting the points gives us a straight line! Plotting equivalent ratios will *always* give a straight line. Furthermore, the straight line will *always* pass through the origin $(0,0).$" :tutorial/id #uuid "05d7bd91-e8b4-5ada-936f-6036f766cf23" :tutorial/math-academy-id 2053 :tutorial/title "Introduction"} :step/id #uuid "e3c01e56-883c-55ab-9e6a-10ceb0575884" :step/math-academy-id 7803 :step/next {:db/id #edb/ref 17592186074878}} {:db/id #edb/ref 17592186074878 :step/content {:db/id #edb/ref 17592186073883 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073565 :question/id #uuid "9a740a80-f655-5d20-a839-d9a809d4c6a4" :question/math-academy-id "e-2285"} :knowledge-point/id #uuid "a1c72ed5-ab55-5815-b0a2-9a88eb15d362" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049682} {:db/id #edb/ref 17592186050138}] :knowledge-point/questions [{:db/id #edb/ref 17592186074417} {:db/id #edb/ref 17592186074418} {:db/id #edb/ref 17592186455438} {:db/id #edb/ref 17592186455492}] :knowledge-point/title "Graphing Ratios"} :step/id #uuid "5eafd168-51d7-5307-98d8-6cbe0835f715" :step/math-academy-id 7804 :step/next {:db/id #edb/ref 17592186074879}} {:db/id #edb/ref 17592186074879 :step/content {:db/id #edb/ref 17592186073884 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073566 :question/id #uuid "ce72406a-a57e-53b5-b066-f147e197d317" :question/math-academy-id "e-2287"} :knowledge-point/id #uuid "08c2f97b-d178-59b0-b58f-b273ddc2ec1d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050078}] :knowledge-point/questions [{:db/id #edb/ref 17592186074428} {:db/id #edb/ref 17592186074429} {:db/id #edb/ref 17592186455429} {:db/id #edb/ref 17592186542159}] :knowledge-point/title "Determining a Ratio From a Graph"} :step/id #uuid "7b457667-0972-5621-9729-0ef04c05c3b0" :step/math-academy-id 7807 :step/next {:db/id #edb/ref 17592186074880}} {:db/id #edb/ref 17592186074880 :step/content {:db/id #edb/ref 17592186073885 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073568 :question/id #uuid "a0c6e401-4364-575d-94d2-97108b688d43" :question/math-academy-id "e-2289"} :knowledge-point/id #uuid "309e24a1-6c8c-5705-beca-001fed696acc" :knowledge-point/questions [{:db/id #edb/ref 17592186074397} {:db/id #edb/ref 17592186074430} {:db/id #edb/ref 17592186455440} {:db/id #edb/ref 17592186455455} {:db/id #edb/ref 17592186534056}] :knowledge-point/title "Determining a Ratio From a Graph: Word Problems"} :step/id #uuid "ca8053f2-49d8-5357-8a87-8e0ac9d72e07" :step/math-academy-id 7809}] :activity/title "Graphing Ratios" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073979}]}
