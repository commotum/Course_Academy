 17592186045417] [17592186138596 #edb/ref 1043 #edb/ref 17592186139487 #edb/ref 17592186045417] [17592186138596 #edb/ref 1043 #edb/ref 17592186139488 #edb/ref 17592186045417] [17592186138596 #edb/ref 1043 #edb/ref 17592186139489 #edb/ref 17592186045417] [17592186138596 #edb/ref 1043 #edb/ref 17592186139490 #edb/ref 17592186045417] [17592186138596 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186138596 #edb/ref 1045 "Simplifying Linear Expressions Containing Fractions" #edb/ref 17592186045417] [17592186138596 #edb/ref 1046 #edb/ref 17592186139486 #edb/ref 17592186045417] [17592186138596 #edb/ref 1049 #edb/ref 17592186049047 #edb/ref 17592186045417] [17592186138596 #edb/ref 1050 480.0 #edb/ref 17592186045417] [17592186138596 #edb/ref 1053 #uuid "63522699-6803-576b-82ed-8d88d13eba2f" #edb/ref 17592186045417] [17592186138753 #edb/ref 1068 #edb/ref 17592186135517 #edb/ref 17592186045417] [17592186138753 #edb/ref 1068 #edb/ref 17592186135518 #edb/ref 17592186045417] [17592186138753 #edb/ref 1069 "q-218714" #edb/ref 17592186045417] [17592186138753 #edb/ref 1071 "The volume $v$ of acid in a test tube measures $10.25mL$ to the nearest hundredth of a milliliter. Determine the upper and lower bounds of this measurement. {{field-1}} $mL$\n$\\le v <$\n{{field-2}} $mL$" #edb/ref 17592186045417] [17592186138753 #edb/ref 1072 #uuid "aa0fbe16-9c2a-5cfb-9ced-d072cc5a440e" #edb/ref 17592186045417] [17592186139294 #edb/ref 1058 #edb/ref 17592186139295 #edb/ref 17592186045417] [17592186139294 #edb/ref 1061 165169 #edb/ref 17592186045417] [17592186139294 #edb/ref 1062 #uuid "cc0c262d-dd9e-52a1-a83b-9f1c0fe96262" #edb/ref 17592186045417] [17592186139294 #edb/ref 1063 #edb/ref 17592186139715 #edb/ref 17592186045417] [17592186139295 #edb/ref 1058 #edb/ref 17592186139296 #edb/ref 17592186045417] [17592186139295 #edb/ref 1061 165170 #edb/ref 17592186045417] [17592186139295 #edb/ref 1062 #uuid "66ba1355-ab27-5d81-8157-a359b9801285" #edb/ref 17592186045417] [17592186139295 #edb/ref 1063 #edb/ref 17592186139716 #edb/ref 17592186045417] [17592186139296 #edb/ref 1058 #edb/ref 17592186139297 #edb/ref 17592186045417] [17592186139296 #edb/ref 1061 165171 #edb/ref 17592186045417] [17592186139296 #edb/ref 1062 #uuid "bf5aa060-ae70-531a-8e1c-d165c1d25adb" #edb/ref 17592186045417] [17592186139296 #edb/ref 1063 #edb/ref 17592186138387 #edb/ref 17592186045417] [17592186139297 #edb/ref 1058 #edb/ref 17592186139298 #edb/ref 17592186045417] [17592186139297 #edb/ref 1061 165174 #edb/ref 17592186045417] [17592186139297 #edb/ref 1062 #uuid "7d898aa1-1cb4-5977-87b3-02ae7082146a" #edb/ref 17592186045417] [17592186139297 #edb/ref 1063 #edb/ref 17592186138388 #edb/ref 17592186045417] [17592186139298 #edb/ref 1061 165177 #edb/ref 17592186045417] [17592186139298 #edb/ref 1062 #uuid "761a41b0-39e8-54bb-9403-886bbe9ed521" #edb/ref 17592186045417] [17592186139298 #edb/ref 1063 #edb/ref 17592186138389 #edb/ref 17592186045417] [17592186139486 #edb/ref 1058 #edb/ref 17592186139487 #edb/ref 17592186045417] [17592186139486 #edb/ref 1061 71207 #edb/ref 17592186045417] [17592186139486 #edb/ref 1062 #uuid "3cca408f-980b-5a63-a54c-03cd0d86a422" #edb/ref 17592186045417] [17592186139486 #edb/ref 1063 #edb/ref 17592186139661 #edb/ref 17592186045417] [17592186139487 #edb/ref 1058 #edb/ref 17592186139488 #edb/ref 17592186045417] [17592186139487 #edb/ref 1061 71208 #edb/ref 17592186045417] [17592186139487 #edb/ref 1062 #uuid "24f9787a-6b3b-581b-a228-064feb6d711c" #edb/ref 17592186045417] [17592186139487 #edb/ref 1063 #edb/ref 17592186138510 #edb/ref 17592186045417] [17592186139488 #edb/ref 1058 #edb/ref 17592186139489 #edb/ref 17592186045417] [17592186139488 #edb/ref 1061 71212 #edb/ref 17592186045417] [17592186139488 #edb/ref 1062 #uuid "aae03f7b-9f94-5281-8d40-eddd120590d8" #edb/ref 17592186045417] [17592186139488 #edb/ref 1063 #edb/ref 17592186138511 #edb/ref 17592186045417] [17592186139489 #edb/ref 1058 #edb/ref 17592186139490 #edb/ref 17592186045417] [17592186139489 #edb/ref 1061 71216 #edb/ref 17592186045417] [17592186139489 #edb/ref 1062 #uuid "1036460b-f34d-54e4-a730-f0b57e843495" #edb/ref 17592186045417] [17592186139489 #edb/ref 1063 #edb/ref 17592186138512 #edb/ref 17592186045417] [17592186139490 #edb/ref 1061 71219 #edb/ref 17592186045417] [17592186139490 #edb/ref 1062 #uuid "4e4a8574-0322-564e-8108-20569dba02f5" #edb/ref 17592186045417] [17592186139490 #edb/ref 1063 #edb/ref 17592186138513 #edb/ref 17592186045417] [17592186139661 #edb/ref 1064 "Suppose that we want to simplify the following expression: \n\n$$\n2+\\dfrac{5}{2}x -5 + \\dfrac{7}{2}x.\n$$\n\n  \n\nWe begin by collecting like terms.\n\n$$\n\\begin{aligned}(\\frac{5}{2}x+\\frac{7}{2}x)+(2-5)\\end{aligned}\n$$\n\nThen, we combine the like terms, simplifying the coefficients as much as possible.\n\n$$\n\\begin{aligned}(\\frac{5}{2}x+\\frac{7}{2}x)+(2-5) & = \\\\ (\\frac{5+7}{2})x+(-3) & = \\\\ \\frac{12}{2}x-3 & = \\\\ 6x-3 & .\\end{aligned}\n$$\n\nThus, the simplified expression is $6x-3.$" #edb/ref 17592186045417] [17592186139661 #edb/ref 1065 8040 #edb/ref 17592186045417] [17592186139661 #edb/ref 1066 #uuid "7ef8a0d2-a9fe-57f8-b3fc-7b69cbb3a818" #edb/ref 17592186045417] [17592186139661 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186139715 #edb/ref 1064 "We always introduce **errors** in our measurements whenever we round or approximate numbers. In this lesson, we will explore how to quantify and describe measurement errors.\n\nSuppose that a particular rope measures precisely $48.9\\,\\textrm{cm}.$ Now, imagine we take a meterstick and record a measurement of $50\\,\\textrm{cm}$ *to the nearest $10$ centimeters*. Let's mark this approximation on our meterstick.\n\n![](images/4e/4e5d5ca05f27aa612b3fdcc9430b495870ddf540630857b6227897d6b20c9e89.png)\n\nThe error of a measurement equals the difference between the rounded estimate and the \"true\" value. So, in this example, the error of our approximation equals\n\n$$\n50\\,\\textrm{cm} - 48.9\\,\\textrm{cm} = 1.1\\textrm{cm}.\n$$\n\n  \n\nWe often don't know the \"true\" measurement in practical problems. So, the next best thing is to determine a **lower bound** and an **upper bound** for our measurement:\n\n- The *lower* bound of a measurement is its *smallest* possible value.\n\n- The *upper* bound of a measurement is its *largest* possible value.\n\nLet's figure out the lower and upper bounds of our $50\\,\\textrm{cm}$ approximation:\n\n- The *lower bound* is $45 \\, \\textrm{cm}$ because this is the *smallest* value that gives $50 \\, \\textrm{cm}$ when rounded to the nearest $10\\,\\textrm{cm}.$\n\n![](images/da/da9cd6208cef81c6fe34fbba9b4271fa3ce1f30df69eb3c631ce6fea4f12e3a3.png)\n\n- The *upper bound* is $55 \\, \\textrm{cm}$ because this is (almost) the *largest* value that gives $50 \\, \\textrm{cm}$ when rounded to the nearest $10\\,\\textrm{cm}.$\n\n![](images/23/23a195d88326b587e1864ef04e7b05f74d675f1ddc987baa2cf586af599eb4a9.png)\n\nLet's use the letter $l$ to denote the \"true\" length of the rope. Then, we can combine our lower and upper bound measurements into a single statement, as follows:\n\n$$\n45\\,\\textrm{cm} \\leq l \\lt 55\\,\\textrm{cm}\n$$\n\nNotice that we used a *strict* \"<\" inequality for the upper bound. We cannot include $55\\textrm{cm}$ in our set of values because this number rounds to $60\\,\\textrm{cm},$ not $50\\,\\textrm{cm}$.\n\nWe can visualize the lower and upper bounds on our diagram as follows:\n\n![](images/1f/1fdacb0787e8316a78da1ad65aa177e9a6f29215fa0d53aef88b0eb33326218d.png)" #edb/ref 17592186045417] [17592186139715 #edb/ref 1065 8751 #edb/ref 17592186045417] [17592186139715 #edb/ref 1066 #uuid "d44fcde5-ad8a-596b-a6ac-955ff40b6bd9" #edb/ref 17592186045417] [17592186139715 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186139716 #edb/ref 1064 "So, we've seen how to calculate lower and upper bounds. Before we consider another example, note the following:\n\n- The lower and upper bound depend on our approximation's **degree of accuracy**.\n\n- In the last example, the degree of accuracy was $10\\,\\textrm{cm}$ because the rope was measured to the nearest $10$ centimeters.\n\n- If we change the degree of accuracy, the lower and upper bounds will also change. So, for example, if we measured the rope to the nearest $1\\,\\textrm{cm},$ the lower and upper bounds would be different.\n\n- The **greatest possible error** is the largest amount the \"true\" value can be from the approximation.\n\n- This greatest possible error is always one-half of the degree of accuracy. So, in the last example, the greatest possible error in our measurement was\n\n$$\n\\dfrac{10\\,\\textrm{cm}}{2} = {\\color{blue}{5\\,\\textrm{cm}}}.\n$$\n\nWe can use the greatest possible error to compute the lower and upper bounds quickly:\n\n- To compute the lower bound of an approximation, we *subtract* the greatest possible error from the approximation. So, for the previous example, we have\n\n$$\n\\textrm{lower bound} = 50\\,\\textrm{cm} - {\\color{blue}{5\\,\\textrm{cm}}} = 45\\,\\textrm{cm.}\n$$\n\n- To compute the upper bound of an approximation, we *add* the greatest possible error to the approximation. So, for the previous example, we have\n\n$$\n\\textrm{upper bound} = 50\\,\\textrm{cm} + {\\color{blue}{5\\,\\textrm{cm}}} = 55\\,\\textrm{cm.}\n$$\n\nLet's see another example." #edb/ref 17592186045417] [17592186139716 #edb/ref 1065 8752 #edb/ref 17592186045417] [17592186139716 #edb/ref 1066 #uuid "f1808067-d542-577c-a2d3-085e0fb1df59" #edb/ref 17592186045417] [17592186139716 #edb/ref 1067 "The Greatest Possible Error" #edb/ref 17592186045417] [17592186149800 #edb/ref 1075 #edb/ref 17592186485945 #edb/ref 17592186045417] [17592186149800 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186149800 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186149800 #edb/ref 1078 #edb/ref 17592186485945 #edb/ref 17592186045417] [17592186149800 #edb/ref 1079 #uuid "290d7c72-0a37-54c1-928d-b289c4e12639" #edb/ref 17592186045417] [17592186152295 #edb/ref 1037 #edb/ref 17592186050716 #edb/ref 17592186045417] [17592186152295 #edb/ref 1038 #edb/ref 17592186152552 #edb/ref 17592186045417] [17592186152295 #edb/ref 1038 #edb/ref 17592186152553 #edb/ref 17592186045417] [17592186152295 #edb/ref 1038 #edb/ref 17592186455458 #edb/ref 17592186045417] [17592186152295 #edb/ref 1038 #edb/ref 17592186455469 #edb/ref 17592186045417] [17592186152295 #edb/ref 1039 "Applying a Percentage Increase" #edb/ref 17592186045417] [17592186152295 #edb/ref 1041 #edb/ref 17592186151899 #edb/ref 17592186045417] [17592186152295 #edb/ref 1042 #uuid "125ed0b3-14ad-5af8-8370-ca6f83d93c35" #edb/ref 17592186045417] [17592186152296 #edb/ref 1037 #edb/ref 17592186049467 #edb/ref 17592186045417] [17592186152296 #edb/ref 1038 #edb/ref 17592186152554 #edb/ref 17592186045417] [17592186152296 #edb/ref 1038 #edb/ref 17592186152555 #edb/ref 17592186045417] [17592186152296 #edb/ref 1038 #edb/ref 17592186455451 #edb/ref 17592186045417] [17592186152296 #edb/ref 1038 #edb/ref 17592186455478 #edb/ref 17592186045417] [17592186152296 #edb/ref 1038 #edb/ref 17592186455495 #edb/ref 17592186045417] [17592186152296 #edb/ref 1038 #edb/ref 17592186455498 #edb/ref 17592186045417] [17592186152296 #edb/ref 1038 #edb/ref 17592186486395 #edb/ref 17592186045417] [17592186152296 #edb/ref 1038 #edb/ref 17592186486445 #edb/ref 17592186045417] [17592186152296 #edb/ref 1038 #edb/ref 17592186534011 #edb/ref 17592186045417] [17592186152296 #edb/ref 1039 "Applying a Percentage Increase: Word Problems" #edb/ref 17592186045417] [17592186152296 #edb/ref 1041 #edb/ref 17592186151900 #edb/ref 17592186045417] [17592186152296 #edb/ref 1042 #uuid "f90ea994-79f2-5409-bf96-306803b4ef01" #edb/ref 17592186045417] [17592186152297 #edb/ref 1037 #edb/ref 17592186050618 #edb/ref 17592186045417] [17592186152297 #edb/ref 1038 #edb/ref 17592186152551 #edb/ref 17592186045417] [17592186152297 #edb/ref 1038 #edb/ref 17592186152556 #edb/ref 17592186045417] [17592186152297 #edb/ref 1038 #edb/ref 17592186455476 #edb/ref 17592186045417] [17592186152297 #edb/ref 1038 #edb/ref 17592186455482 #edb/ref 17592186045417] [17592186152297 #edb/ref 1038 #edb/ref 17592186486392 #edb/ref 17592186045417] [17592186152297 #edb/ref 1038 #edb/ref 17592186486423 #edb/ref 17592186045417] [17592186152297 #edb/ref 1038 #edb/ref 17592186536824 #edb/ref 17592186045417] [17592186152297 #edb/ref 1039 "Applying Percentage Increases Greater Than 100%" #edb/ref 17592186045417] [17592186152297 #edb/ref 1041 #edb/ref 17592186151901 #edb/ref 17592186045417] [17592186152297 #edb/ref 1042 #uuid "88d0f4ad-a3f9-5275-b5d5-a9973bf63ebf" #edb/ref 17592186045417] [17592186152298 #edb/ref 1038 #edb/ref 17592186152557 #edb/ref 17592186045417] [17592186152298 #edb/ref 1038 #edb/ref 17592186152558 #edb/ref 17592186045417] [17592186152298 #edb/ref 1038 #edb/ref 17592186455431 #edb/ref 17592186045417] [17592186152298 #edb/ref 1038 #edb/ref 17592186455511 #edb/ref 17592186045417] [17592186152298 #edb/ref 1039 "Solving Word Problems Involving Percentage Increases Greater Than 100%" #edb/ref 17592186045417] [17592186152298 #edb/ref 1041 #edb/ref 17592186151913 #edb/ref 17592186045417] [17592186152298 #edb/ref 1042 #uuid "bbb0103d-d686-575a-8ef8-81640227f4dc" #edb/ref 17592186045417] [17592186152315 #edb/ref 1043 #edb/ref 17592186153298 #edb/ref 17592186045417] [17592186152315 #edb/ref 1043 #edb/ref 17592186153299 #edb/ref 17592186045417] [17592186152315 #edb/ref 1043 #edb/ref 17592186153300 #edb/ref 17592186045417] [17592186152315 #edb/ref 1043 #edb/ref 17592186153301 #edb/ref 17592186045417] [17592186152315 #edb/ref 1043 #edb/ref 17592186153302 #edb/ref 17592186045417] [17592186152315 #edb/ref 1043 #edb/ref 17592186153303 #edb/ref 17592186045417] [17592186152315 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186152315 #edb/ref 1045 "Applying Percentage Increases" #edb/ref 17592186045417] [17592186152315 #edb/ref 1046 #edb/ref 17592186153298 #edb/ref 17592186045417] [17592186152315 #edb/ref 1049 #edb/ref 17592186048502 #edb/ref 17592186045417] [17592186152315 #edb/ref 1050 660.0 #edb/ref 17592186045417] [17592186152315 #edb/ref 1053 #uuid "b42cbc99-dc3a-5ea5-af15-2e43d6dacdce" #edb/ref 17592186045417] [17592186153298 #edb/ref 1058 #edb/ref 17592186153299 #edb/ref 17592186045417] [17592186153298 #edb/ref 1061 615692 #edb/ref 17592186045417] [17592186153298 #edb/ref 1062 #uuid "547ba33b-b6b3-5bae-b2dc-eacefe1e81a4" #edb/ref 17592186045417] [17592186153298 #edb/ref 1063 #edb/ref 17592186153325 #edb/ref 17592186045417] [17592186153299 #edb/ref 1058 #edb/ref 17592186153300 #edb/ref 17592186045417] [17592186153299 #edb/ref 1061 615693 #edb/ref 17592186045417] [17592186153299 #edb/ref 1062 #uuid "a946c7fa-5aee-54d2-b223-0a3b560b3401" #edb/ref 17592186045417] [17592186153299 #edb/ref 1063 #edb/ref 17592186152295 #edb/ref 17592186045417] [17592186153300 #edb/ref 1058 #edb/ref 17592186153301 #edb/ref 17592186045417] [17592186153300 #edb/ref 1061 615696 #edb/ref 17592186045417] [17592186153300 #edb/ref 1062 #uuid "fd57418f-a99a-5c17-9192-9191eca0084b" #edb/ref 17592186045417] [17592186153300 #edb/ref 1063 #edb/ref 17592186152296 #edb/ref 17592186045417] [17592186153301 #edb/ref 1058 #edb/ref 17592186153302 #edb/ref 17592186045417] [17592186153301 #edb/ref 1061 615700 #edb/ref 17592186045417] [17592186153301 #edb/ref 1062 #uuid "a3bd6e9e-9d93-51a6-9a20-5e9292cf93f4" #edb/ref 17592186045417] [17592186153301 #edb/ref 1063 #edb/ref 17592186153340 #edb/ref 17592186045417] [17592186153302 #edb/ref 1058 #edb/ref 17592186153303 #edb/ref 17592186045417] [17592186153302 #edb/ref 1061 615701 #edb/ref 17592186045417] [17592186153302 #edb/ref 1062 #uuid "d9b4f520-6201-594a-907d-e7a899c8d57c" #edb/ref 17592186045417] [17592186153302 #edb/ref 1063 #edb/ref 17592186152297 #edb/ref 17592186045417] [17592186153303 #edb/ref 1061 615704 #edb/ref 17592186045417] [17592186153303 #edb/ref 1062 #uuid "10eca415-b601-5bc8-80c2-c2db5a9c451e" #edb/ref 17592186045417] [17592186153303 #edb/ref 1063 #edb/ref 17592186152298 #edb/ref 17592186045417] [17592186153325 #edb/ref 1064 "Sometimes we need to find a number that is a certain percentage *greater than* a given amount. This corresponds to applying a so-called **percentage increase.**\n\nTo apply a percentage increase, we add the increase to $100\\%,$ convert the result to a decimal multiplier, and then find the product of the multiplier and the original number.\n\nTo demonstrate, let's consider the following problem.\n\nWhat number is $25\\%$ *greater than* $160?$\n\nThe key words here are \"$\\boldsymbol{25\\%}$ **greater than.**\" This means we need to apply a percentage increase, increasing the original number by $25\\%.$\n\nTo find a number $25\\%$ greater than $160,$ we apply a new percentage of\n\n$$\n100\\% + 25\\% = 125\\%.\n$$\n\nThis means that our new number is $125\\%$ of $160.$ \n\nSo, first, we convert this percentage to a decimal:\n\n$$\n125\\% = \\dfrac{125}{100} = 1.25\n$$\n\nTo find a number that is $25\\%$ greater than $160,$ we multiply $160$ by $1.25{:}$\n\n$$\n1.25 \\cdot 160 = 200\n$$\n\nTherefore, the number that is $25\\%$ *greater than* $160$ is $200.$\n\nThis method applies to *any* percentage increase, including those greater than $100\\%{;}$ add the increase to $100\\%$ before converting to a decimal multiplier." #edb/ref 17592186045417] [17592186153325 #edb/ref 1065 14336 #edb/ref 17592186045417] [17592186153325 #edb/ref 1066 #uuid "83dbd64f-3ab9-5239-b54b-ae6d91816248" #edb/ref 17592186045417] [17592186153325 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186153340 #edb/ref 1064 "It's possible to increase a number by $100\\%$ or more. \n\nFor example, what number is $150\\%$ greater than $90?$\n\nTo find a number $150\\%$ *greater than* $90,$ we apply a new percentage of\n\n$$\n100\\% + 150\\% = 250\\%.\n$$\n\nWe begin by converting the percentage to a decimal:\n\n$$\n250\\% = \\dfrac{250}{100} = 2.5\n$$\n\nSo, to find a number that is $150\\%$ greater than $90,$ we multiply $90$ by $2.5:$\n\n$$\n2.5 \\cdot 90 = 225\n$$\n\nTherefore, the number that is $150\\%$ greater than $90$ is $225.$" #edb/ref 17592186045417] [17592186153340 #edb/ref 1065 15090 #edb/ref 17592186045417] [17592186153340 #edb/ref 1066 #uuid "a0514684-2b6b-52ce-9ccb-6d28ed8d4850" #edb/ref 17592186045417] [17592186153340 #edb/ref 1067 "Percentage Increases Greater Than 100%" #edb/ref 17592186045417] [17592186485754 #edb/ref 1043 #edb/ref 17592186486464 #edb/ref 17592186045417] [17592186485754 #edb/ref 1043 #edb/ref 17592186486503 #edb/ref 17592186045417] [17592186485754 #edb/ref 1043 #edb/ref 17592186486504 #edb/ref 17592186045417] [17592186485754 #edb/ref 1043 #edb/ref 17592186486505 #edb/ref 17592186045417] [17592186485754 #edb/ref 1043 #edb/ref 17592186486523 #edb/ref 17592186045417] [17592186485754 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186485754 #edb/ref 1045 "Applying Percentage Increases" #edb/ref 17592186045417] [17592186485754 #edb/ref 1046 #edb/ref 17592186486523 #edb/ref 17592186045417] [17592186485754 #edb/ref 1048 #edb/ref 17592186046648 #edb/ref 17592186045417] [17592186485754 #edb/ref 1049 #edb/ref 17592186048502 #edb/ref 17592186045417] [17592186485754 #edb/ref 1053 #uuid "332f39d2-fe5b-5fe5-bfa7-8da0dfbe5393" #edb/ref 17592186045417] [17592186485764 #edb/ref 1080 "5,\\,000,\\,000" #edb/ref 17592186045417] [17592186485764 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186485764 #edb/ref 1083 #uuid "00e18203-4dbf-5257-84e1-5d825b64f9da" #edb/ref 17592186045417] [17592186485767 #edb/ref 1080 "5,\\,050,\\,000" #edb/ref 17592186045417] [17592186485767 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186485767 #edb/ref 1083 #uuid "01c47803-fa37-5ad4-a822-f030d4115e5a" #edb/ref 17592186045417] [17592186485789 #edb/ref 1080 "$$14.00$" #edb/ref 17592186045417] [17592186485789 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186485789 #edb/ref 1083 #uuid "0d2bf66f-071b-599c-870d-beb08d151c52" #edb/ref 17592186045417] [17592186485824 #edb/ref 1080 "5,\\,075,\\,000" #edb/ref 17592186045417] [17592186485824 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186485824 #edb/ref 1083 #uuid "22fa57f8-4bd0-583b-b691-d351b66f3152" #edb/ref 17592186045417] [17592186485828 #edb/ref 1080 "5,\\,100,\\,000" #edb/ref 17592186045417] [17592186485828 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186485828 #edb/ref 1083 #uuid "26239f53-9cc0-56a7-acb2-66f332c11f19" #edb/ref 17592186045417]}
