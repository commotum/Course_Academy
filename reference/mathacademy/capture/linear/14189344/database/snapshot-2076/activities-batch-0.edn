#{[{:activity/expected-seconds 1440.0 :activity/first-step {:db/id #edb/ref 17592186502186} :activity/id #uuid "33615341-898b-5ad2-95e1-3bdfee51b554" :activity/scope {:db/id #edb/ref 17592186050012 :topic/id #uuid "2616710e-7f3d-5028-b0fe-1ed436c185da" :topic/math-academy-id 1024} :activity/steps [{:db/id #edb/ref 17592186502176 :step/content {:db/id #edb/ref 17592186502066 :knowledge-point/canonical-example {:db/id #edb/ref 17592186502129 :question/id #uuid "9c400da4-eba5-58aa-8ee5-a33269adfa2a" :question/math-academy-id "e-22728"} :knowledge-point/id #uuid "5b6c3c0b-b541-5b1f-810b-d9c4ffa1fe9c" :knowledge-point/questions [{:db/id #edb/ref 17592186502147} {:db/id #edb/ref 17592186502155}] :knowledge-point/title "Solving Problems Involving Dividing Negative Numbers"} :step/id #uuid "3a846be7-1beb-5415-afda-c7dbc9dfc761" :step/math-academy-id 621937} {:db/id #edb/ref 17592186502186 :step/content {:db/id #edb/ref 17592186502216 :tutorial/content "Some real-world situations involve a quantity changing by the same amount repeatedly.\n\nWhen the same change occurs repeatedly, we can represent the total change using multiplication.\n\nFor example, suppose a submarine begins at sea level and descends $2\\,\\text{m}$ each minute for $4$ minutes.\n\nSince descending represents a decrease in elevation, the change each minute is $-2\\,\\text{m}.$\n\nThe total change can be written as repeated subtraction:\n\n![](images/bd/bd6e5218d475c46dd7f0ac578340124954d00fa940c81e32bffa49638b0e79c3.svg)\n\nThis repeated subtraction can also be written using multiplication:\n\n$$\n{\\color{blue}4} \\times (-2)\n$$\n\nEvaluating the product, we get\n\n$$\n4 \\times (-2) = -8.\n$$\n\nTherefore, after $4$ minutes, the submarine's elevation is $-8\\,\\text{m}.$" :tutorial/id #uuid "e61ac714-2900-508a-9e66-9731f70e9997" :tutorial/math-academy-id 15164 :tutorial/title "Introduction"} :step/id #uuid "71ab7d7f-9cc1-5cdf-9b66-2a332d38a8be" :step/math-academy-id 621932 :step/next {:db/id #edb/ref 17592186502187}} {:db/id #edb/ref 17592186502187 :step/content {:db/id #edb/ref 17592186502067 :knowledge-point/canonical-example {:db/id #edb/ref 17592186502160 :question/id #uuid "f100ae8f-6865-5741-a125-4d55e90e2e43" :question/math-academy-id "e-22713"} :knowledge-point/id #uuid "6d7b67c1-aa22-5106-9f09-19e361dc25c0" :knowledge-point/questions [{:db/id #edb/ref 17592186502107} {:db/id #edb/ref 17592186502136}] :knowledge-point/title "Solving Problems Involving Multiplying Negative Numbers"} :step/id #uuid "75f9f2c1-6398-5c11-a04e-b2c1ba8f749f" :step/math-academy-id 621933 :step/next {:db/id #edb/ref 17592186502188}} {:db/id #edb/ref 17592186502188 :step/content {:db/id #edb/ref 17592186502068 :knowledge-point/canonical-example {:db/id #edb/ref 17592186502105 :question/id #uuid "5f3cfae7-b7d6-56b2-a245-6ec44b76e462" :question/math-academy-id "e-22714"} :knowledge-point/id #uuid "aec0cd94-20e4-5748-b9c1-4de7b1854a8e" :knowledge-point/questions [{:db/id #edb/ref 17592186502152} {:db/id #edb/ref 17592186502156}] :knowledge-point/title "Solving Problems Involving Multiplying Negative Fractions"} :step/id #uuid "7899018c-d6d5-5a73-8bba-a499b1170d83" :step/math-academy-id 621941 :step/next {:db/id #edb/ref 17592186502210}} {:db/id #edb/ref 17592186502209 :step/content {:db/id #edb/ref 17592186502215 :tutorial/content "Sometimes we know the total change in a quantity and want to find how much the quantity changes during each equal time period.\n\nIn these situations, we use division.\n\nFor example, suppose a total of $\\[math]24$ is withdrawn from a bank account over $6$ days in equal amounts.\n\nSince money is withdrawn, the total change in the balance is $-\\[/math]24$.\n\nTo find the change each day, we divide the total change by the number of days:\n\n$$\n-24 \\div 6\n$$\n\nEvaluating the quotient, we get\n\n$$\n-24 \\div 6 = -4.\n$$\n\nTherefore, the balance changes by $-\\[math]4$ each day." :tutorial/id #uuid "2472ba13-0b69-56f2-a477-ea1b2a6fc7e3" :tutorial/math-academy-id 15182 :tutorial/title "Solving Problems Using Division of Rational Numbers"} :step/id #uuid "f88bb973-cdd9-5dc3-a6f0-ee3f3807638e" :step/math-academy-id 621978 :step/next {:db/id #edb/ref 17592186502176}} {:db/id #edb/ref 17592186502210 :step/content {:db/id #edb/ref 17592186502069 :knowledge-point/canonical-example {:db/id #edb/ref 17592186502120 :question/id #uuid "7be163d0-2103-5467-9bba-a4090855cc8b" :question/math-academy-id "e-22729"} :knowledge-point/id #uuid "f589fffd-f5c4-590e-9ed1-01c20390700f" :knowledge-point/questions [{:db/id #edb/ref 17592186502092} {:db/id #edb/ref 17592186502119}] :knowledge-point/title "Solving Problems Involving Multiplying Negative Fractions and Mixed Numbers"} :step/id #uuid "f8abbf23-8275-57f4-b19a-767b1595b9d0" :step/math-academy-id 621944 :step/next {:db/id #edb/ref 17592186502209}}] :activity/title "Solving Problems Using Multiplication and Division of Rational Numbers" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186092407}]}
