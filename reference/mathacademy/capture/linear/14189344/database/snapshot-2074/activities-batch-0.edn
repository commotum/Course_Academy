#{[{:activity/first-step {:db/id #edb/ref 17592186093001} :activity/id #uuid "33615341-898b-5ad2-95e1-3bdfee51b554" :activity/scope {:db/id #edb/ref 17592186050012 :topic/id #uuid "2616710e-7f3d-5028-b0fe-1ed436c185da" :topic/math-academy-id 1024} :activity/steps [{:db/id #edb/ref 17592186093000 :step/content {:db/id #edb/ref 17592186092188 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092028 :question/id #uuid "0c43effb-b65a-503b-b56a-aac7d499ba0a" :question/math-academy-id "e-4867"} :knowledge-point/id #uuid "bc5fba78-066d-56fb-b5ac-6733fa0349bd" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048392} {:db/id #edb/ref 17592186049349} {:db/id #edb/ref 17592186050934}] :knowledge-point/questions [{:db/id #edb/ref 17592186092800} {:db/id #edb/ref 17592186092802}] :knowledge-point/title "Multiplying and Dividing Negative Numbers"} :step/id #uuid "841015cd-9b45-5a5b-afd0-7aba1b86813a" :step/math-academy-id 17597 :step/next {:db/id #edb/ref 17592186093178}} {:db/id #edb/ref 17592186093001 :step/content {:db/id #edb/ref 17592186093405 :tutorial/content "We can solve some real-world problems using the four operations on rational numbers.\n\n- We use addition when there is an increase in the data.\n- We use subtraction to find a difference or when there is a decrease in the data.\n- We use multiplication when a quantity is a multiple larger (or higher) than another. In particular, \"double\" means to multiply by $2$, and \"triple\" means to multiply by $3$.\n- We use division when a quantity is a multiple smaller (or lower) than another.\n\nLet's see some examples." :tutorial/id #uuid "f494c1de-c874-5ad7-88e0-40b32e6eaaca" :tutorial/math-academy-id 3264 :tutorial/title "Introduction"} :step/id #uuid "4f607a2c-517d-5476-83c6-2ed225ffaa2d" :step/math-academy-id 17979 :step/next {:db/id #edb/ref 17592186093000}} {:db/id #edb/ref 17592186093008 :step/content {:db/id #edb/ref 17592186092192 :knowledge-point/canonical-example {:db/id #edb/ref 175921860