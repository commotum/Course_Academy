#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186555957} :activity/id #uuid "922fea49-6b8a-58c7-b90e-f0eeab5445ca" :activity/scope {:db/id #edb/ref 17592186050577 :topic/id #uuid "5555aaf2-f73f-5c86-8f74-5c76cb5a6f50" :topic/math-academy-id 1451} :activity/steps [{:db/id #edb/ref 17592186555917 :step/content {:db/id #edb/ref 17592186555801 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ca5d762-c81a-57fc-9843-502e7d1af843" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-\\frac{1}{2}" :db/id #edb/ref 17592186555171} {:answer/id #uuid "74a90c6d-2efa-51c6-a91a-aaf6755d1abb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=2" :db/id #edb/ref 17592186555263} {:answer/id #uuid "b9780710-3705-5098-9242-2c8b7fe1151f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=6" :db/id #edb/ref 17592186555442} {:answer/id #uuid "dccfbbc1-9cf7-51b9-ac74-1a8d552f82e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-6" :db/id #edb/ref 17592186555536} {:answer/id #uuid "ebb0e4ca-74ad-5d0c-b490-4cbfbd48e530" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-1" :db/id #edb/ref 17592186555580}] :answer-field/correct {:db/id #edb/ref 17592186555580} :answer-field/id #uuid "633578f8-1fcc-5369-8160-ab9262e6ed6d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555688}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4f8a844e-8d7a-52ec-932d-abb0df6525f2" :question/math-academy-id "q-106157" :question/problem "Find the axis of symmetry for the parabola $y=-(x-5)(x+7).$" :question/worked-solution "From the equation $y=-(x-5)(x+7),$ we find that the roots of the parabola are ${x}_{1}=5$ and ${x}_{2}=-7.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{5+(-7)}{2} \\\\  & =-1.\\end{aligned}\n$$\n\n \n\nTherefore, the axis of symmetry is $x=-1.$"} :step/id #uuid "7d16b69a-5a84-5d56-969f-c9e96234e18c" :step/next {:db/id #edb/ref 17592186555938}} {:db/id #edb/ref 17592186555938 :step/content {:db/id #edb/ref 17592186555793 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7fb5a3b2-6779-5f18-aee9-35c71d01843c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186555296}] :answer-field/correct {:db/id #edb/ref 17592186555296} :answer-field/id #uuid "ff2d3b83-418c-57aa-abbd-ad23104f3a79" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186555757}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3c9a4b7b-8e3b-5aa3-8825-873abec27dfc" :question/math-academy-id "q-223666" :question/problem "The axis of symmetry of the parabola $y=(x-1)(x-9)$ is $x=${{field-1}}." :question/worked-solution "From the equation $y=(x-1)(x-9),$ we can tell that the roots of the parabola are ${x}_{1}=1$ and ${x}_{2}=9.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{1+9}{2} \\\\  & =\\frac{10}{2} \\\\  & =5\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=5.$"} :step/id #uuid "cd4f8847-652c-5cee-968e-bc3d8b8c3f08"} {:db/id #edb/ref 17592186555957 :step/content {:db/id #edb/ref 17592186555854 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0824024b-c099-527a-8256-d5a6127f2786" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{9}{2}" :db/id #edb/ref 17592186555013} {:answer/id #uuid "2f22d275-c75b-5b64-9666-30863a46ed54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{15}{6}" :db/id #edb/ref 17592186555104} {:answer/id #uuid "4087805a-ed7e-522b-a9a2-c73758870563" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=3" :db/id #edb/ref 17592186555140} {:answer/id #uuid "76e3d3fa-3854-5450-9938-38191ec8e7d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{35}{12}" :db/id #edb/ref 17592186555274} {:answer/id #uuid "f412a256-5361-5b16-a302-db1d43b422fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=2" :db/id #edb/ref 17592186555602}] :answer-field/correct {:db/id #edb/ref 17592186555140} :answer-field/id #uuid "15067fae-69bc-5d5f-83e8-e1ebdc618e5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555649}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c4e9e89a-1628-511a-8a61-3e91affcd33c" :question/math-academy-id "q-106134" :question/problem "![](images/8c/8cd1c9ab91a23fae12dd45078ec44ca55e69da8aa787775d7a9583857a84cb71.png)\n\nThe graph above shows a parabola. The $x$-coordinates of $A$ and $B$ are $\\frac{11}{6}$ and $\\frac{25}{6},$ respectively.  Find the axis of symmetry of the parabola." :question/worked-solution "We're given that the roots of the parabola are \n ${x}_{1}=\\frac{11}{6}$ and ${x}_{2}=\\frac{25}{6}.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(\\frac{11}{6}+\\frac{25}{6})}{2} \\\\  & =\\frac{(\\frac{36}{6})}{2} \\\\  & =\\frac{6}{2} \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=3.$"} :step/id #uuid "fc0ea0dd-6d8e-54af-8a2c-d3dfe94d4d67" :step/next {:db/id #edb/ref 17592186555917}}] :activity/title "The Average of the Roots Formula" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186554996}]}
