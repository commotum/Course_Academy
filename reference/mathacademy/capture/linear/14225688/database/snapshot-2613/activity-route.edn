#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186543677} :activity/id #uuid "cd2e9b70-6a0e-52a0-8281-13d7ee6987ee" :activity/scope {:db/id #edb/ref 17592186049153 :topic/id #uuid "dee5d85f-d1a2-5a07-8454-81879602e674" :topic/math-academy-id 441} :activity/steps [{:db/id #edb/ref 17592186543617 :step/content {:db/id #edb/ref 17592186543523 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06a88805-1323-5ff5-8f48-42543b26f532" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8(\\frac{1}{{t}^{2}}-5)(\\frac{1}{{t}^{4}}+\\frac{5}{{t}^{2}}+25)" :db/id #edb/ref 17592186542653} {:answer/id #uuid "42f98072-159d-5073-bea3-fc772168038c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8(\\frac{1}{{t}^{2}}+5)(\\frac{1}{{t}^{2}}-\\frac{1}{{t}^{2}}+5)" :db/id #edb/ref 17592186542821} {:answer/id #uuid "4903b99d-0682-5a79-8fb4-e2b4b7c0f41f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8(\\frac{1}{t}+5)(\\frac{1}{{t}^{4}}-\\frac{5}{{t}^{2}}+25)" :db/id #edb/ref 17592186542839} {:answer/id #uuid "50b5e943-9ca0-5aed-9175-6b9302edbbc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8(\\frac{1}{t}-5)(\\frac{1}{{t}^{2}}+\\frac{1}{{t}^{2}}+5)" :db/id #edb/ref 17592186542860} {:answer/id #uuid "ee53056d-d85d-50b2-b983-34612d0e6c4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8(\\frac{1}{{t}^{2}}-5)(\\frac{1}{{t}^{4}}-\\frac{1}{{t}^{2}}+5)" :db/id #edb/ref 17592186543247}] :answer-field/correct {:db/id #edb/ref 17592186542653} :answer-field/id #uuid "7b298728-bbf2-5c29-9156-fbe40121077d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543375}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "82176286-a684-5858-a421-cc4a4b4187bd" :question/math-academy-id "q-69640" :question/problem "Factor $\\frac{8}{{t}^{6}}-1000.$" :question/worked-solution "The difference of cubes formula is given by\n\n$$\n{a}^{3}-{b}^{3}=(a-b)({a}^{2}+ab+{b}^{2}).\n$$\n\nNotice that all of the terms have a common factor of $8.$ To simplify the computation, we can factor out the $8,$ as follows:\n\n$$\n\\frac{8}{{t}^{6}}-1000=8(\\frac{1}{{t}^{6}}-125)\n$$\n\nThe expression in parentheses can be written as a difference of cubes:\n\n$$\n8(\\frac{1}{{t}^{6}}-125)=8({(\\frac{1}{{t}^{2}})}^{3}-{5}^{3})\n$$\n\nNow, we factor the expression in parentheses using the difference of cubes formula:\n\n$$\n\\begin{aligned}\\frac{8}{{t}^{6}}-1000 & =8({(\\frac{1}{{t}^{2}})}^{3}-{5}^{3}) \\\\  & =8(\\frac{1}{{t}^{2}}-5)({(\\frac{1}{{t}^{2}})}^{2}+\\frac{1}{{t}^{2}}\\cdot 5+{5}^{2}) \\\\  & =8(\\frac{1}{{t}^{2}}-5)(\\frac{1}{{t}^{4}}+\\frac{5}{{t}^{2}}+25)\\end{aligned}\n$$"} :step/id #uuid "327cbab5-20c5-52bc-9726-24f78d338f9d"} {:db/id #edb/ref 17592186543668 :step/content {:db/id #edb/ref 17592186543591 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66384dc3-aeed-50fd-a06a-ddf8c266eef1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2{x}^{2}+3y)(4{x}^{4}-6{x}^{2}y+9{y}^{2})" :db/id #edb/ref 17592186542913} {:answer/id #uuid "89f89f32-bf9b-503e-9126-2f6e0c9a76d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2x+3y)(4{x}^{4}-3{x}^{2}y+3{y}^{2})" :db/id #edb/ref 17592186543005} {:answer/id #uuid "a7d05e8a-af35-596b-816d-9f0b78413663" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2{x}^{2}-3y)(4{x}^{4}-3{x}^{2}y+9{y}^{2})" :db/id #edb/ref 17592186543081} {:answer/id #uuid "dcec1f73-9359-594e-a38c-ef8b08ea1fca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2{x}^{2}+3y)(2{x}^{4}+6{x}^{2}y+3{y}^{2})" :db/id #edb/ref 17592186543202} {:answer/id #uuid "f80932c6-3e4d-5cf6-8c1e-db1595d5dff2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2x+3y)(2{x}^{4}+6{x}^{2}+3{y}^{2})" :db/id #edb/ref 17592186543276}] :answer-field/correct {:db/id #edb/ref 17592186542913} :answer-field/id #uuid "60bed6b5-bec1-5f6b-a052-99e12b1d3687" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543351}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "faeaf850-1aff-5e10-9fc0-51026df9825a" :question/math-academy-id "q-37550" :question/problem "Factor the expression $8{x}^{6}+27{y}^{3}.$" :question/worked-solution "The sum of cubes formula is given by\n\n$$\n{a}^{3}+{b}^{3}=(a+b)({a}^{2}-ab+{b}^{2}).\n$$\n\nNotice that we can write our expression as a sum of cubes, as follows:\n\n$$\n8{x}^{6}+27{y}^{3}={(2{x}^{2})}^{3}+(3y)^{3}\n$$\n\nNow, we factor our expression using the sum of cubes formula:\n\n$$\n\\begin{aligned}8{x}^{6}+27{y}^{3} & ={(2{x}^{2})}^{3}+(3y)^{3} \\\\  & =(2{x}^{2}+3y)({(2{x}^{2})}^{2}-2{x}^{2}\\cdot 3y+(3y)^{2}) \\\\  & =(2{x}^{2}+3y)(4{x}^{4}-6{x}^{2}y+9{y}^{2})\\end{aligned}\n$$"} :step/id #uuid "e10bbf89-2bab-5c2a-9845-b34b37adb348" :step/next {:db/id #edb/ref 17592186543617}} {:db/id #edb/ref 17592186543677 :step/content {:db/id #edb/ref 17592186543516 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3def5748-f5f8-53b5-b6ea-8e14945dfed5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{1}{9}+z)(\\frac{1}{9}+\\frac{z}{9}+{z}^{2})" :db/id #edb/ref 17592186542809} {:answer/id #uuid "62a351de-d274-575d-b200-5387096347ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{1}{3}+z)(\\frac{1}{3}-\\frac{z}{2}+{z}^{2})" :db/id #edb/ref 17592186542910} {:answer/id #uuid "93a145b7-2cd7-59b3-8ff3-26e918720c2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{1}{9}-z)(\\frac{1}{3}-\\frac{z}{9}+{z}^{2})" :db/id #edb/ref 17592186543026} {:answer/id #uuid "bb2085ff-c8a6-5372-acca-6f59e8fca692" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{1}{3}-z)(\\frac{1}{9}+\\frac{z}{3}+{z}^{2})" :db/id #edb/ref 17592186543132} {:answer/id #uuid "f1b9f62d-cf08-5a64-aeb7-1cab2092352e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{1}{3}+z)(\\frac{1}{9}-\\frac{z}{3}+{z}^{2})" :db/id #edb/ref 17592186543260}] :answer-field/correct {:db/id #edb/ref 17592186543260} :answer-field/id #uuid "b77b7c3f-41cf-5d84-b905-19ea7c30c507" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543427}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "733ab756-eb23-5365-83ae-dfce071139ee" :question/math-academy-id "q-3600" :question/problem "Factor $\\frac{1}{27}+{z}^{3}.$" :question/worked-solution "The sum of cubes formula is given by\n\n$$\n{a}^{3}+{b}^{3}=(a+b)({a}^{2}-ab+{b}^{2}).\n$$\n\nNotice that we can write our expression as a sum of cubes, as follows:\n\n$$\n\\frac{1}{27}+{z}^{3}={(\\frac{1}{3})}^{3}+{z}^{3}\n$$\n\nNow, we factor our expression using the sum of cubes formula:\n\n$$\n\\begin{aligned}\\frac{1}{27}+{z}^{3} & ={(\\frac{1}{3})}^{3}+{z}^{3} \\\\  & =(\\frac{1}{3}+z)({(\\frac{1}{3})}^{2}-\\frac{1}{3}\\cdot z+{z}^{2}) \\\\  & =(\\frac{1}{3}+z)(\\frac{1}{9}-\\frac{z}{3}+{z}^{2})\\end{aligned}\n$$"} :step/id #uuid "fc929762-2aa0-5d2e-bd54-0dbd988def7b" :step/next {:db/id #edb/ref 17592186543668}}] :activity/title "Factoring Sums and Differences of Cubes" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186542627}]}
