#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186111733} :activity/id #uuid "9857734b-5bab-54f4-a580-a7385aea30f3" :activity/scope {:db/id #edb/ref 17592186048174 :topic/id #uuid "85adbb4a-1472-583d-a6f0-528ebb0b39cc" :topic/math-academy-id 1437} :activity/steps [{:db/id #edb/ref 17592186111609 :step/content {:db/id #edb/ref 17592186110670 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110291 :question/id #uuid "60df6f7a-5257-5081-ba0c-0e9499a15f23" :question/math-academy-id "e-10588"} :knowledge-point/id #uuid "5ac4127f-1253-5aee-b524-84e5c6b2bc64" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673} {:db/id #edb/ref 17592186050452} {:db/id #edb/ref 17592186050494}] :knowledge-point/questions [{:db/id #edb/ref 17592186111241} {:db/id #edb/ref 17592186111279} {:db/id #edb/ref 17592186233215} {:db/id #edb/ref 17592186493947} {:db/id #edb/ref 17592186493950}] :knowledge-point/title "Calculating Angles From Right, Straight, and Full Angles Using Algebra"} :step/id #uuid "9d2f5fba-20ef-5cac-9659-5aee4c02e5a5" :step/math-academy-id 40025 :step/next {:db/id #edb/ref 17592186111742}} {:db/id #edb/ref 17592186111733 :step/content {:db/id #edb/ref 17592186111840 :tutorial/content "When solving problems with angles, it is helpful to remember the following classifications:\n\n- a **null** angle has a measure of $0^\\circ,$\n\n- an **acute** angle has a measure between $0^\\circ$ and $90^\\circ,$\n\n- a **right** angle has a measure of $90^\\circ,$\n\n- an **obtuse** angle has a measure between $90^\\circ$ and $180^\\circ,$\n\n- a **straight** angle has a measure of $180^\\circ,$\n\n- a **reflex** angle has a measure between $180^\\circ$ and $360^\\circ,$ and\n\n- a **full** angle has a measure of $360^\\circ.$\n\nIt is also helpful to remember that when two lines meet at a point, the opposite angles are called **vertical angles**. Vertical angles are congruent, and consequently they have the same measure." :tutorial/id #uuid "282e8601-d3f4-5c34-a96b-a071a96de244" :tutorial/math-academy-id 2182 :tutorial/title "Introduction"} :step/id #uuid "d8e313bb-3f6b-5512-9eaa-d26017f922aa" :step/math-academy-id 8758 :step/next {:db/id #edb/ref 17592186111743}} {:db/id #edb/ref 17592186111742 :step/content {:db/id #edb/ref 17592186110759 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110387 :question/id #uuid "826ef015-53ba-5889-8749-170a656c35f9" :question/math-academy-id "e-2590"} :knowledge-point/id #uuid "9d62f753-a3e0-5c7e-919d-3f878c1d8e93" :knowledge-point/questions [{:db/id #edb/ref 17592186111245} {:db/id #edb/ref 17592186111246} {:db/id #edb/ref 17592186493932}] :knowledge-point/title "Finding the Measure of Unknown Angles on a Diagram"} :step/id #uuid "d8bbc417-4a3f-577b-991f-4a7306fb343e" :step/math-academy-id 8768} {:db/id #edb/ref 17592186111743 :step/content {:db/id #edb/ref 17592186110760 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110390 :question/id #uuid "6438b232-f40a-54b0-a599-a1d6aa4151d2" :question/math-academy-id "e-2599"} :knowledge-point/id #uuid "f64be210-e966-5be7-b7b4-cbf859793e76" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048723} {:db/id #edb/ref 17592186050016} {:db/id #edb/ref 17592186050889}] :knowledge-point/questions [{:db/id #edb/ref 17592186111247} {:db/id #edb/ref 17592186111248} {:db/id #edb/ref 17592186493894} {:db/id #edb/ref 17592186493929}] :knowledge-point/title "Identifying Angle Types From a Diagram"} :step/id #uuid "8ad48197-e2e5-58b1-af58-7632d0bd7fe9" :step/math-academy-id 8772 :step/next {:db/id #edb/ref 17592186111744}} {:db/id #edb/ref 17592186111744 :step/content {:db/id #edb/ref 17592186110761 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110391 :question/id #uuid "15470df7-8d18-5427-9488-f3f10df13952" :question/math-academy-id "e-2601"} :knowledge-point/id #uuid "fea607a9-7512-5062-b4ae-c53e0f653efd" :knowledge-point/questions [{:db/id #edb/ref 17592186111249} {:db/id #edb/ref 17592186111250} {:db/id #edb/ref 17592186493951} {:db/id #edb/ref 17592186493953}] :knowledge-point/title "Identifying an Angle Type From a Description"} :step/id #uuid "1a60a9ec-5f67-5382-8520-b964b945c556" :step/math-academy-id 8773 :step/next {:db/id #edb/ref 17592186111609}}] :activity/title "Solving Problems With Angles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110823}] [{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186074657} :activity/id #uuid "7809af08-83ac-5450-986d-2614a3fd22d3" :activity/scope {:db/id #edb/ref 17592186048826 :topic/id #uuid "c375d3cc-e398-5a47-a69f-ddc853431752" :topic/math-academy-id 487} :activity/steps [{:db/id #edb/ref 17592186074657 :step/content {:db/id #edb/ref 17592186075033 :tutorial/content "Suppose that we want to solve, *without* using graphs, the following system of linear equations:\n\n$$\n\\{\\begin{aligned}x+y=4 \\\\ x-2=y\\,\\end{aligned}\n$$\n\nIn order to solve the system without a graph, we will need to combine the equations into a single equation that can be solved using algebraic manipulation.\n\nOne way to combine the equations is called the **substitution method.** To use the substitution method, we substitute for one variable in terms of the other.\n\nFor instance, notice that we can make $y$ the subject of the second equation:\n\n$$\n\\color{red}y=x - 2\n$$\n\nSubstituting this expression for $y$ into the first equation, we get an equation that we can solve for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}x+y & =4 \\\\ x+(x-2) & =4 \\\\ 2x-2 & =4 \\\\ 2x & =6 \\\\ x & =3\\end{aligned}\n$$\n\nSo, the solution must have $x=3.$ But we also need to figure out what $y$ is. We can do this by substituting $x=3$ back into the second equation:\n\n$$\n\\begin{aligned}y & =x-2 \\\\ y & =3-2 \\\\ y & =1\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x = 3$ and $y = 1$, which can be written as $\\left(3, 1\\right).$\n\n**Note:** Whenever we isolate the variable in one equation, we have to substitute it into the *other* equation. We cannot substitute a variable into the same equation it came from, because this will not give us any more information about the variable." :tutorial/id #uuid "e1e8cb2d-3d4e-5cb9-8947-2bd9deb11b89" :tutorial/math-academy-id 8131 :tutorial/title "Introduction"} :step/id #uuid "413b9b90-7693-5568-a868-970271a5a258" :step/math-academy-id 197419 :step/next {:db/id #edb/ref 17592186074658}} {:db/id #edb/ref 17592186074658 :step/content {:db/id #edb/ref 17592186073752 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073445 :question/id #uuid "e9aae52c-65f3-5dff-bc6b-a530f8c7acc1" :question/math-academy-id "e-13009"} :knowledge-point/id #uuid "5e79a91b-c479-53da-9f06-59c082fa4187" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048678} {:db/id #edb/ref 17592186050622}] :knowledge-point/questions [{:db/id #edb/ref 17592186074030} {:db/id #edb/ref 17592186074172} {:db/id #edb/ref 17592186074185} {:db/id #edb/ref 17592186233560} {:db/id #edb/ref 17592186233567} {:db/id #edb/ref 17592186233574} {:db/id #edb/ref 17592186496226} {:db/id #edb/ref 17592186496255}] :knowledge-point/title "Solving a System of Linear Equations Using Substitution"} :step/id #uuid "99e9f36f-648c-5025-bfca-c63f6f77d9b1" :step/math-academy-id 197420 :step/next {:db/id #edb/ref 17592186074659}} {:db/id #edb/ref 17592186074659 :step/content {:db/id #edb/ref 17592186073753 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073446 :question/id #uuid "707504e8-a367-5dc2-a663-371a9dcf7224" :question/math-academy-id "e-13010"} :knowledge-point/id #uuid "b4352698-7af7-5d74-9c3a-0f951c3e6078" :knowledge-point/questions [{:db/id #edb/ref 17592186073997} {:db/id #edb/ref 17592186073998} {:db/id #edb/ref 17592186074047} {:db/id #edb/ref 17592186496252} {:db/id #edb/ref 17592186496314}] :knowledge-point/title "Solving a Challenging System of Linear Equations Using Substitution"} :step/id #uuid "30b3f613-45c5-50c5-bd79-5c12149aea27" :step/math-academy-id 197424}] :activity/title "Solving Systems of Equations by Substitution" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073923}] [{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186111526} :activity/id #uuid "224e6883-ecf1-58d2-8217-7503c15c1910" :activity/scope {:db/id #edb/ref 17592186049846 :topic/id #uuid "1843810f-c12f-5f01-b69f-9484dfe1a88e" :topic/math-academy-id 1413} :activity/steps [{:db/id #edb/ref 17592186111526 :step/content {:db/id #edb/ref 17592186111911 :tutorial/content "If we have rational expressions on both sides of an equation, say,\n\n$$\n\\dfrac{{\\color{red}x-1}}{{\\color{blue}2}} = \\dfrac{{\\color{blue}2x-1}}{{\\color{red}5}},\n$$\n\nthen we can eliminate the rational expressions by applying **cross-multiplication**:\n\n- we cross-multiply the left-hand side numerator $({\\color{red}x-1})$ with the right-hand side denominator $({\\color{red}5}),$ and\n\n- we cross-multiply the left-hand side denominator $({\\color{blue}2})$ with the right-hand side numerator $({\\color{blue}2x-1}).$\n\nDoing this, we get the following equation:\n\n$$\n({\\color{red}x-1}) \\cdot ({\\color{red}5}) = ({\\color{blue}2}) \\cdot ({\\color{blue}2x - 1})\n$$\n\nAfter we've cross-multiplied, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}(x-1)\\cdot 5 & =2\\cdot (2x-1) \\\\ 5x-5 & =4x-2 \\\\ 5x-5+5 & =4x-2+5 \\\\ 5x & =4x+3 \\\\ 5x-4x & =4x+3-4x \\\\ x & =3\\end{aligned}\n$$\n\n**Note:** Cross-multiplication might seem magical, but it is really just a shortcut for multiplying both sides of the equation by each denominator:\n\n$$\n\\begin{aligned}\\frac{x-1}{2} & =\\frac{2x-1}{5} \\\\ 2\\cdot \\frac{x-1}{2} & =2\\cdot \\frac{2x-1}{5} \\\\ \\cancel{2}\\cdot \\frac{x-1}{\\cancel{2}} & =2\\cdot \\frac{2x-1}{5} \\\\ x-1 & =2\\cdot \\frac{2x-1}{5} \\\\ (x-1)\\cdot 5 & =2\\cdot \\frac{2x-1}{5}\\cdot 5 \\\\ (x-1)\\cdot 5 & =2\\cdot \\frac{2x-1}{\\cancel{5}}\\cdot \\cancel{5} \\\\ (x-1)\\cdot (5) & =(2)\\cdot (2x-1)\\end{aligned}\n$$" :tutorial/id #uuid "99ff1453-e12b-518f-94b1-9baf8ee914e6" :tutorial/math-academy-id 8174 :tutorial/title "Introduction"} :step/id #uuid "62154097-0663-58a8-8dfe-b1f260a5583e" :step/math-academy-id 175966 :step/next {:db/id #edb/ref 17592186111527}} {:db/id #edb/ref 17592186111527 :step/content {:db/id #edb/ref 17592186110619 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110320 :question/id #uuid "7df7a073-8131-5732-b353-f89484052e38" :question/math-academy-id "e-13077"} :knowledge-point/id #uuid "3ff2f965-b406-5c9a-bd41-73ccdce951eb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048760}] :knowledge-point/questions [{:db/id #edb/ref 17592186110932} {:db/id #edb/ref 17592186111181} {:db/id #edb/ref 17592186111182} {:db/id #edb/ref 17592186488259} {:db/id #edb/ref 17592186488277}] :knowledge-point/title "Cross-Multiplying with One Binomial"} :step/id #uuid "79e64205-d43a-5719-a973-65d5eb873b04" :step/math-academy-id 175967 :step/next {:db/id #edb/ref 17592186111528}} {:db/id #edb/ref 17592186111528 :step/content {:db/id #edb/ref 17592186110620 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110321 :question/id #uuid "4041cf6f-61b8-5794-9988-436722985bcd" :question/math-academy-id "e-13078"} :knowledge-point/id #uuid "e880edeb-82ad-5943-a846-dc3246e3e3bd" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050908}] :knowledge-point/questions [{:db/id #edb/ref 17592186110933} {:db/id #edb/ref 17592186111155} {:db/id #edb/ref 17592186488196} {:db/id #edb/ref 17592186488233}] :knowledge-point/title "Cross-Multiplying with Two Binomials"} :step/id #uuid "39ea7244-0ca1-52cc-9e51-81973115c977" :step/math-academy-id 175971 :step/next {:db/id #edb/ref 17592186111529}} {:db/id #edb/ref 17592186111529 :step/content {:db/id #edb/ref 17592186111912 :tutorial/content "Consider the following equation:\n\n$$\n\\dfrac{x+1}{2} = -\\dfrac{x}{3}\n$$\n\nEven though one of the fractions is negative, we can still use cross-multiplication. All we have to do is transfer the negative into the numerator of the fraction, and proceed with cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{x+1}{2} & =-\\frac{x}{3} \\\\ \\frac{x+1}{2} & =\\frac{-x}{3} \\\\ (x+1)\\cdot 3 & =2\\cdot (-x)\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}(x+1)\\cdot 3 & =2\\cdot (-x) \\\\ 3x+3 & =-2x \\\\ 3x+3-3x & =-2x-3x \\\\ 3 & =-5x \\\\ \\frac{3}{-5} & =\\frac{-5x}{-5} \\\\ -\\frac{3}{5} & =x\\end{aligned}\n$$\n\nTherefore, $x = -\\dfrac{3}{5}.$" :tutorial/id #uuid "ed67f4e3-4ff1-5900-bda0-c7f4e2b5a652" :tutorial/math-academy-id 8175 :tutorial/title "Cross-Multiplying with a Negative Sign"} :step/id #uuid "a5826411-42a0-5ce0-aa7f-6e0d021d40fa" :step/math-academy-id 175974 :step/next {:db/id #edb/ref 17592186111530}} {:db/id #edb/ref 17592186111530 :step/content {:db/id #edb/ref 17592186110621 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110322 :question/id #uuid "d97adcd5-65ea-5cf7-905a-db954e43904b" :question/math-academy-id "e-13079"} :knowledge-point/id #uuid "59230000-ef0e-56c0-ab06-17676d817d5a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049939}] :knowledge-point/questions [{:db/id #edb/ref 17592186110934} {:db/id #edb/ref 17592186110935} {:db/id #edb/ref 17592186111121} {:db/id #edb/ref 17592186234052} {:db/id #edb/ref 17592186488255} {:db/id #edb/ref 17592186488257}] :knowledge-point/title "Cross-Multiplying with a Negative Sign"} :step/id #uuid "1f42768c-0adb-5fc8-8dd3-b63229bed312" :step/math-academy-id 175975}] :activity/title "Solving Linear Equations Using Cross-Multiplication" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110809}] [{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186176945} :activity/id #uuid "996870da-1d36-50d4-81c0-5fbf61ea73c5" :activity/scope {:db/id #edb/ref 17592186050164 :topic/id #uuid "333ee4a3-8244-5546-a959-8bbd7343369d" :topic/math-academy-id 3554} :activity/steps [{:db/id #edb/ref 17592186176851 :step/content {:db/id #edb/ref 17592186176044 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175692 :question/id #uuid "bea49cf1-02d0-5aa0-9584-f2ea5a2eb30c" :question/math-academy-id "e-10584"} :knowledge-point/id #uuid "bf8d806a-b232-5ddd-ad0b-3af70f244194" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048213} {:db/id #edb/ref 17592186050494}] :knowledge-point/questions [{:db/id #edb/ref 17592186176450} {:db/id #edb/ref 17592186176451} {:db/id #edb/ref 17592186487316}] :knowledge-point/title "Solving Problems Involving Congruent Angles"} :step/id #uuid "057cde94-c55a-5403-a94e-042675ba0ae9" :step/math-academy-id 40007} {:db/id #edb/ref 17592186176945 :step/content {:db/id #edb/ref 17592186176966 :tutorial/content "Two angles are **congruent** if their measures are equal.\n\nFor example, if\n\n$$\nm\\angle X =50^\\circ \\quad \\text{and} \\ \\quad m\\angle Y=50^\\circ,\n$$\n\nthen $\\angle X$ and $\\angle Y$ are congruent. We can express this as \n\n$$\n\\angle X \\cong \\angle Y.\n$$\n\nHowever, if \n\n$$\nm\\angle X =50^\\circ \\quad \\text{and} \\ \\quad m\\angle Z = 110^\\circ,\n$$\n\nthen $\\angle X$ and $\\angle Z$ are *not* congruent, and we write \n\n$$\n\\angle X \\ncong \\angle Z.\n$$\n\nWe represent congruent angles by marking the arcs with the same symbol. For example, three pairs of congruent angles are shown below:\n\n![](images/99/997e53a399f06c3aad8391ace4172b7249890a31abeff4e72605bce607fd3bdb.png)" :tutorial/id #uuid "927a2746-94e0-5f78-985c-38429a67496b" :tutorial/math-academy-id 2184 :tutorial/title "Introduction"} :step/id #uuid "1602c522-d568-5230-b809-f60d5df74e28" :step/math-academy-id 8777 :step/next {:db/id #edb/ref 17592186176946}} {:db/id #edb/ref 17592186176946 :step/content {:db/id #edb/ref 17592186176097 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175761 :question/id #uuid "fbd1b514-35d8-54a1-91c1-168d330811e6" :question/math-academy-id "e-2605"} :knowledge-point/id #uuid "beaec0ce-eca9-5e8c-903a-6bf152b37368" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048587} {:db/id #edb/ref 17592186050512}] :knowledge-point/questions [{:db/id #edb/ref 17592186176517} {:db/id #edb/ref 17592186176518} {:db/id #edb/ref 17592186487330} {:db/id #edb/ref 17592186487404}] :knowledge-point/title "Identifying Congruent Angles Given Measures of Angles"} :step/id #uuid "eaf23fc9-d311-5210-b4e5-83bf29c1cd0f" :step/math-academy-id 8778 :step/next {:db/id #edb/ref 17592186176947}} {:db/id #edb/ref 17592186176947 :step/content {:db/id #edb/ref 17592186176098 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175762 :question/id #uuid "bab99447-be6e-5ac0-906c-a9df9aa7f3f3" :question/math-academy-id "e-2606"} :knowledge-point/id #uuid "7ca5614b-e796-5482-89c9-31410de84c33" :knowledge-point/questions [{:db/id #edb/ref 17592186176515} {:db/id #edb/ref 17592186176516} {:db/id #edb/ref 17592186487320} {:db/id #edb/ref 17592186487394}] :knowledge-point/title "Using Markings to Denote Congruent Angles"} :step/id #uuid "fe14b5e5-3934-58ec-925b-8f9569cfa306" :step/math-academy-id 8780 :step/next {:db/id #edb/ref 17592186176851}}] :activity/title "Congruent Angles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186176105}]}
