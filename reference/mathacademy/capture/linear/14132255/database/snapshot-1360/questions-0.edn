#{[{:db/id #edb/ref 17592186142590 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142805 :knowledge-point/id #uuid "8e58a7d0-dfe1-52dd-9de0-f598aca658df" :knowledge-point/title "Dividing Whole Numbers by Unit Fractions"}] :question/id #uuid "58c82929-55bc-5fcf-b4f1-d685a065efe4" :question/math-academy-id "e-13701" :question/problem "Divide $4 \\div \\dfrac 1 {5} .$" :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nThe reciprocal of $\\dfrac{1}{\\color{blue}5}$ is $\\color{blue}5.$ \n\nSo, we have\n\n$$\n4\\div \\dfrac1{\\color{blue}5} = 4\\times  {\\color{blue}5} =20.\n$$"}] [{:db/id #edb/ref 17592186142591 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142808 :knowledge-point/id #uuid "d6aef2b2-fa3d-5c58-9868-67513adfef9b" :knowledge-point/title "Applying a Strategy (Result Is a Fraction or Mixed Number)"}] :question/id #uuid "906c6d3e-4f1a-58e0-8f21-128bfc754d47" :question/math-academy-id "e-13703" :question/problem "Calculate the value of $2\\div \\dfrac67,$ expressing the result as a mixed number." :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nFirst, we write $2$ as an improper fraction:\n\n$$\n2=\\dfrac{2}{1}\n$$\n\nNext, we note that the reciprocal of $\\dfrac{\\color{blue}6}{\\color{red}7}$ is $\\dfrac{\\color{red}7}{\\color{blue}6}.$ \n\nSo, we have\n\n$$\n2\\div \\dfrac 6 {7} = \n\\dfrac 2 1 \\div \\dfrac{\\color{blue}6}{\\color{red}7} = \\dfrac 2 1 \\times  \\dfrac{\\color{red}7}{\\color{blue}6}.\n$$\n\n \n\nNow, we multiply our fractions. Note that we can simplify the process by swapping the denominators first.\n\n$$\n\\begin{aligned}\\frac{2}{1}\\times \\frac{7}{6} & =\\frac{2}{6}\\times \\frac{7}{1} \\\\  & =\\frac{1}{3}\\times \\frac{7}{1} \\\\  & =\\frac{1\\times 7}{3\\times 1} \\\\  & =\\frac{7}{3}\\end{aligned}\n$$\n\nFinally, we convert our result to a mixed number:\n\n$$\n\\dfrac73 = 2\\,\\textrm{R}\\,1 = 2\\,\\dfrac13\n$$"}] [{:db/id #edb/ref 17592186142592 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142807 :knowledge-point/id #uuid "d2ddc37a-2ee1-50db-adf7-9b15360f8227" :knowledge-point/title "Applying a Strategy (Result Is a Whole Number)"}] :question/id #uuid "42efe817-2f21-57a9-9cfe-5973ac89f1f2" :question/math-academy-id "e-13706" :question/problem "Divide $8\\div \\dfrac 2 5.$" :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nFirst, we write $8$ as an improper fraction:\n\n$$\n8=\\dfrac{8}{1}\n$$\n\nNext, we note that the reciprocal of $\\dfrac{\\color{blue}2}{\\color{red}5}$ is $\\dfrac{\\color{red}5}{\\color{blue}2}.$ \n\nSo, we have\n\n$$\n8\\div \\dfrac 2 5 = \n\n\\dfrac {8} 1 \\div \\dfrac{\\color{blue}2}{\\color{red}5} = \\dfrac {8} 1 \\times  \\dfrac{\\color{red}5}{\\color{blue}2}.\n$$\n\n \n\nNow, we multiply our fractions. Note that we can simplify the process by swapping the denominators first.\n\n$$\n\\begin{aligned}\\frac{8}{1}\\times \\frac{5}{2} & =\\frac{8}{2}\\times \\frac{5}{1} \\\\  & =4\\times 5 \\\\  & =20\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186142593 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142806 :knowledge-point/id #uuid "dd40bd52-0088-5405-b03a-71aa22a2fe49" :knowledge-point/title "Dividing Whole Numbers by Fractions"}] :question/id #uuid "e86212dc-fc03-58a2-9a37-758e85a18073" :question/math-academy-id "e-13708" :question/problem "Calculate the value of $4\\div \\dfrac35,$ expressing the result as a mixed number." :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nFirst, we write $4$ as an improper fraction:\n\n$$\n4=\\dfrac{4}{1}\n$$\n\nNext, we note that the reciprocal of $\\dfrac{\\color{blue}3}{\\color{red}5}$ is $\\dfrac{\\color{red}5}{\\color{blue}3}.$ \n\nSo, we have\n\n$$\n4\\div \\dfrac 3 5 = \n\n\\dfrac 4 1 \\div \\dfrac{\\color{blue}3}{\\color{red}5} = \\dfrac 4 1 \\times  \\dfrac{\\color{red}5}{\\color{blue}3}.\n$$\n\n \n\nNow, we multiply our fractions. \n\n$$\n\\dfrac 4 {1} \\times \\dfrac{5}{3} =  \\dfrac {4\\times 5} {1\\times 3} = \\dfrac{20}{3}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\dfrac{20}{3} =6\\,\\textrm{R} 2 = 6\\,\\dfrac 2 {3}\n$$"}] [{:db/id #edb/ref 17592186143175 :knowledge-point/_questions [{:db/id #edb/ref 17592186142807 :knowledge-point/id #uuid "d2ddc37a-2ee1-50db-adf7-9b15360f8227" :knowledge-point/title "Applying a Strategy (Result Is a Whole Number)"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e41865a1-693f-534b-8947-4f269f3ab305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186432111}] :answer-field/correct {:answer/id #uuid "e41865a1-693f-534b-8947-4f269f3ab305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186432111} :answer-field/id #uuid "aa60e602-52fd-50ab-b1db-03bdd0126e3e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186140337}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d9aee41d-c971-5ee5-9118-fcfbaa5eb455" :question/math-academy-id "q-172166" :question/problem "Expressed as a whole number, $4÷\\frac{4}{5}=${{field-1}}." :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nFirst, we write $4$ as an improper fraction:\n\n$$\n4=\\frac{4}{1}\n$$\n\nNext, we note that the reciprocal of $\\frac{4}{5}$ is $\\frac{5}{4}.$ \n\nSo, we have\n\n$$\n4÷\\frac{4}{5}=\\frac{4}{1}÷\\frac{4}{5}=\\frac{4}{1}\\times \\frac{5}{4}.\n$$\n\n \n\nNow, we multiply our fractions. \n\n$$\n\\frac{4}{1}\\times \\frac{5}{4}=\\frac{4\\times 5}{1\\times 4}=\\frac{20}{4}\n$$\n\nFinally, we simplify:\n\n$$\n20÷4=5\n$$"}] [{:db/id #edb/ref 17592186432144 :knowledge-point/_questions [{:db/id #edb/ref 17592186142805 :knowledge-point/id #uuid "8e58a7d0-dfe1-52dd-9de0-f598aca658df" :knowledge-point/title "Dividing Whole Numbers by Unit Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc5ad03e-5e76-5eb6-916a-fecd96181bea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186432107}] :answer-field/correct {:answer/id #uuid "dc5ad03e-5e76-5eb6-916a-fecd96181bea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186432107} :answer-field/id #uuid "af403f6c-3877-5ab4-a43c-94af1cf2f72a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186432133}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a244bc10-5456-5cfa-b7e5-82b04cb2db0d" :question/math-academy-id "q-211418" :question/problem "Expressed as a whole number, $5÷\\frac{1}{6}=${{field-1}}." :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nThe reciprocal of $\\frac{1}{6}$ is $6.$ \n\nSo, we have\n\n$$\n5÷\\frac{1}{6}=5\\times 6=30.\n$$"}] [{:db/id #edb/ref 17592186432149 :knowledge-point/_questions [{:db/id #edb/ref 17592186142805 :knowledge-point/id #uuid "8e58a7d0-dfe1-52dd-9de0-f598aca658df" :knowledge-point/title "Dividing Whole Numbers by Unit Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8577f141-c770-5fd0-9d7f-8403cacb1c9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186432090}] :answer-field/correct {:answer/id #uuid "8577f141-c770-5fd0-9d7f-8403cacb1c9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186432090} :answer-field/id #uuid "23edf76c-f8e8-5002-816e-829d89d828f2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186432120}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dc8adac5-7f76-509c-90be-c74971a28644" :question/math-academy-id "q-211422" :question/problem "Expressed as a whole number, $7÷\\frac{1}{10}=${{field-1}}." :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nThe reciprocal of $\\frac{1}{10}$ is $10.$ \n\nSo, we have\n\n$$\n7÷\\frac{1}{10}=7\\times 10=70.\n$$"}] [{:db/id #edb/ref 17592186432152 :knowledge-point/_questions [{:db/id #edb/ref 17592186142806 :knowledge-point/id #uuid "dd40bd52-0088-5405-b03a-71aa22a2fe49" :knowledge-point/title "Dividing Whole Numbers by Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd575194-1dd4-57b8-a549-a78b174c3b15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{2}" :db/id #edb/ref 17592186432101}] :answer-field/correct {:answer/id #uuid "bd575194-1dd4-57b8-a549-a78b174c3b15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{2}" :db/id #edb/ref 17592186432101} :answer-field/id #uuid "735fcf85-b12d-574f-b7d9-9f9138a783b0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186432127}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fc7c301b-63d2-5396-9d44-9bc2ca8486a2" :question/math-academy-id "q-211428" :question/problem "Expressed as an improper fraction in its lowest terms, $9÷\\frac{2}{3}=${{field-1}}." :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nFirst, we write $9$ as an improper fraction:\n\n$$\n9=\\frac{9}{1}\n$$\n\nNext, we note that the reciprocal of $\\frac{2}{3}$ is $\\frac{3}{2}.$ \n\nSo, we have\n\n$$\n9÷\\frac{2}{3}=\\frac{9}{1}÷\\frac{2}{3}=\\frac{9}{1}\\times \\frac{3}{2}.\n$$\n\n \n\nNow, we multiply our fractions. \n\n$$\n\\frac{9}{1}\\times \\frac{3}{2}=\\frac{9\\times 3}{1\\times 2}=\\frac{27}{2}\n$$"}] [{:db/id #edb/ref 17592186432141 :knowledge-point/_questions [{:db/id #edb/ref 17592186142806 :knowledge-point/id #uuid "dd40bd52-0088-5405-b03a-71aa22a2fe49" :knowledge-point/title "Dividing Whole Numbers by Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31b24742-b8eb-5afe-be50-bea1277608ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{56}{5}" :db/id #edb/ref 17592186432072}] :answer-field/correct {:answer/id #uuid "31b24742-b8eb-5afe-be50-bea1277608ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{56}{5}" :db/id #edb/ref 17592186432072} :answer-field/id #uuid "7402851b-c554-5386-b883-330712e44e7c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186432128}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "91665a0d-ade7-5cf3-a612-7f96ae529a28" :question/math-academy-id "q-211429" :question/problem "Expressed as an improper fraction in its lowest terms, $8÷\\frac{5}{7}=${{field-1}}." :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nFirst, we write $8$ as an improper fraction:\n\n$$\n8=\\frac{8}{1}\n$$\n\nNext, we note that the reciprocal of $\\frac{5}{7}$ is $\\frac{7}{5}.$ \n\nSo, we have\n\n$$\n8÷\\frac{5}{7}=\\frac{8}{1}÷\\frac{5}{7}=\\frac{8}{1}\\times \\frac{7}{5}.\n$$\n\n \n\nNow, we multiply our fractions. \n\n$$\n\\frac{8}{1}\\times \\frac{7}{5}=\\frac{8\\times 7}{1\\times 5}=\\frac{56}{5}\n$$"}] [{:db/id #edb/ref 17592186432142 :knowledge-point/_questions [{:db/id #edb/ref 17592186142807 :knowledge-point/id #uuid "d2ddc37a-2ee1-50db-adf7-9b15360f8227" :knowledge-point/title "Applying a Strategy (Result Is a Whole Number)"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1d78198-a05d-5ebe-bc81-d0050bb9b711" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186432108}] :answer-field/correct {:answer/id #uuid "e1d78198-a05d-5ebe-bc81-d0050bb9b711" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186432108} :answer-field/id #uuid "f44398f3-65e2-5030-a777-61de82751708" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186432134}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "956a3f23-3712-563b-a380-795700cc20ae" :question/math-academy-id "q-211448" :question/problem "Expressed as a whole number, $6÷\\frac{3}{4}=${{field-1}}." :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nFirst, we write $6$ as an improper fraction:\n\n$$\n6=\\frac{6}{1}\n$$\n\nNext, we note that the reciprocal of $\\frac{3}{4}$ is $\\frac{4}{3}.$ \n\nSo, we have\n\n$$\n6÷\\frac{3}{4}=\\frac{6}{1}÷\\frac{3}{4}=\\frac{6}{1}\\times \\frac{4}{3}.\n$$\n\n \n\nNow, we multiply our fractions. \n\n$$\n\\frac{6}{1}\\times \\frac{4}{3}=\\frac{6\\times 4}{1\\times 3}=\\frac{24}{3}\n$$\n\nFinally, we simplify:\n\n$$\n24÷3=8\n$$"}] [{:db/id #edb/ref 17592186432150 :knowledge-point/_questions [{:db/id #edb/ref 17592186142807 :knowledge-point/id #uuid "d2ddc37a-2ee1-50db-adf7-9b15360f8227" :knowledge-point/title "Applying a Strategy (Result Is a Whole Number)"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cbac1d5e-aa32-595d-aef2-4b642a419a04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186432105}] :answer-field/correct {:answer/id #uuid "cbac1d5e-aa32-595d-aef2-4b642a419a04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186432105} :answer-field/id #uuid "949efed5-cf98-5f5d-b7b8-a1053d135c13" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186432132}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ea504a2d-4bc8-5424-b59c-4de18ccf0fd1" :question/math-academy-id "q-211449" :question/problem "Expressed as a whole number, $7÷\\frac{7}{8}=${{field-1}}." :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nFirst, we write $7$ as an improper fraction:\n\n$$\n7=\\frac{7}{1}\n$$\n\nNext, we note that the reciprocal of $\\frac{7}{8}$ is $\\frac{8}{7}.$ \n\nSo, we have\n\n$$\n7÷\\frac{7}{8}=\\frac{7}{1}÷\\frac{7}{8}=\\frac{7}{1}\\times \\frac{8}{7}.\n$$\n\n \n\nNow, we multiply our fractions. \n\n$$\n\\frac{7}{1}\\times \\frac{8}{7}=\\frac{7\\times 8}{1\\times 7}=\\frac{56}{7}\n$$\n\nFinally, we simplify:\n\n$$\n56÷7=8\n$$"}] [{:db/id #edb/ref 17592186143239 :knowledge-point/_questions [{:db/id #edb/ref 17592186142808 :knowledge-point/id #uuid "d6aef2b2-fa3d-5c58-9868-67513adfef9b" :knowledge-point/title "Applying a Strategy (Result Is a Fraction or Mixed Number)"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71d7cab0-fe11-5561-bc9e-de01894e92fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{33}{4}" :db/id #edb/ref 17592186432085}] :answer-field/correct {:answer/id #uuid "71d7cab0-fe11-5561-bc9e-de01894e92fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{33}{4}" :db/id #edb/ref 17592186432085} :answer-field/id #uuid "b6f9a33d-04a4-5d2b-8124-142680a07eda" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186140485}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bbef853b-3fbd-53f0-9694-3b9398710671" :question/math-academy-id "q-211463" :question/problem "Expressed as an improper fraction in its lowest terms, $6÷\\frac{8}{11}=${{field-1}}." :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nFirst, we write $6$ as an improper fraction:\n\n$$\n6=\\frac{6}{1}\n$$\n\nNext, we note that the reciprocal of $\\frac{8}{11}$ is $\\frac{11}{8}.$ \n\nSo, we have\n\n$$\n6÷\\frac{8}{11}=\\frac{6}{1}÷\\frac{8}{11}=\\frac{6}{1}\\times \\frac{11}{8}.\n$$\n\n \n\nNow, we multiply our fractions. Note that we can simplify the process by swapping the denominators first.\n\n$$\n\\begin{aligned}\\frac{6}{1}\\times \\frac{11}{8} & =\\frac{6}{8}\\times \\frac{11}{1} \\\\  & =\\frac{3}{4}\\times 11 \\\\  & =\\frac{33}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186432151 :knowledge-point/_questions [{:db/id #edb/ref 17592186142808 :knowledge-point/id #uuid "d6aef2b2-fa3d-5c58-9868-67513adfef9b" :knowledge-point/title "Applying a Strategy (Result Is a Fraction or Mixed Number)"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "927932fb-f7cb-572a-91af-71f6e7ecd4c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186432092}] :answer-field/correct {:answer/id #uuid "927932fb-f7cb-572a-91af-71f6e7ecd4c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186432092} :answer-field/id #uuid "7c5ee2cf-2973-5656-bf9f-53588d2c806c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186432130}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f41233c3-116b-5b5c-aed9-7d13e659c7e0" :question/math-academy-id "q-211468" :question/problem "Expressed as an improper fraction in its lowest terms, $2÷\\frac{8}{9}=${{field-1}}." :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nFirst, we write $2$ as an improper fraction:\n\n$$\n2=\\frac{2}{1}\n$$\n\nNext, we note that the reciprocal of $\\frac{8}{9}$ is $\\frac{9}{8}.$ \n\nSo, we have\n\n$$\n2÷\\frac{8}{9}=\\frac{2}{1}÷\\frac{8}{9}=\\frac{2}{1}\\times \\frac{9}{8}.\n$$\n\n \n\nNow, we multiply our fractions. Note that we can simplify the process by swapping the denominators first.\n\n$$\n\\begin{aligned}\\frac{2}{1}\\times \\frac{9}{8} & =\\frac{2}{8}\\times \\frac{9}{1} \\\\  & =\\frac{1}{4}\\times 9 \\\\  & =\\frac{9}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186143240 :knowledge-point/_questions [{:db/id #edb/ref 17592186142808 :knowledge-point/id #uuid "d6aef2b2-fa3d-5c58-9868-67513adfef9b" :knowledge-point/title "Applying a Strategy (Result Is a Fraction or Mixed Number)"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33e34223-307e-5cf9-a09a-64998b582c67" :answer/type {:db/id #edb/ref 1759