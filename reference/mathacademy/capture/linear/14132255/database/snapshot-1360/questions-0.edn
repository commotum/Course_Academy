r/value "2\\,\\frac{3}{7}" :db/id #edb/ref 17592186432102} {:answer/id #uuid "c5ca0f2f-d3f2-5741-ac7a-b2c6b09bec88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\frac{4}{5}" :db/id #edb/ref 17592186432103} {:answer/id #uuid "dac55e1f-5cb5-5ca4-b511-ac67a7c6370b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\frac{2}{5}" :db/id #edb/ref 17592186432106} {:answer/id #uuid "e33124e1-d663-5ef1-a1bd-a40b9a688c5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\frac{3}{5}" :db/id #edb/ref 17592186432110} {:answer/id #uuid "e49984f9-85a4-5e6c-a22c-ecbbf5f9c108" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\frac{2}{7}" :db/id #edb/ref 17592186432112}] :answer-field/correct {:answer/id #uuid "e33124e1-d663-5ef1-a1bd-a40b9a688c5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\frac{3}{5}" :db/id #edb/ref 17592186432110} :answer-field/id #uuid "415c6e27-5b66-57cf-be91-15cfb1997b57" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432124}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "44133494-469d-5dbd-8472-1b49df14681b" :question/math-academy-id "q-57187" :question/problem "$4÷\\frac{5}{7}=$" :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nFirst, we write $4$ as an improper fraction:\n\n$$\n4=\\frac{4}{1}\n$$\n\nNext, we note that the reciprocal of $\\frac{5}{7}$ is $\\frac{7}{5}.$ \n\nSo, we have\n\n$$\n4÷\\frac{5}{7}=\\frac{4}{1}÷\\frac{5}{7}=\\frac{4}{1}\\times \\frac{7}{5}.\n$$\n\n \n\nNow, we multiply our fractions. \n\n$$\n\\frac{4}{1}\\times \\frac{7}{5}=\\frac{4\\times 7}{1\\times 5}=\\frac{28}{5}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{28}{5}=5\\,\\text{R}3=5\\,\\frac{3}{5}\n$$"}] [{:db/id #edb/ref 17592186432136 :knowledge-point/_questions [{:db/id #edb/ref 17592186142807 :knowledge-point/id #uuid "d2ddc37a-2ee1-50db-adf7-9b15360f8227" :knowledge-point/title "Applying a Strategy (Result Is a Whole Number)"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f3c7abc-99fc-5d21-bc1f-595e78a5f899" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186432069} {:answer/id #uuid "40f49988-1ae2-5ffa-afa9-3d735a4098dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186432078} {:answer/id #uuid "5fcf2d65-fd7a-592a-ae10-f6e9f88946ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186432081} {:answer/id #uuid "8fdd0eb7-1a9c-5a17-b200-1e086abbfaba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186432091} {:answer/id #uuid "e30397ea-4856-569b-b00d-af69d22591ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186432109}] :answer-field/correct {:answer/id #uuid "2f3c7abc-99fc-5d21-bc1f-595e78a5f899" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186432069} :answer-field/id #uuid "10ad5ca4-1c42-5b2c-b00d-6a4d6d99ac69" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432119}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "13ffbc44-e82a-541b-9a69-eaa776d03a61" :question/math-academy-id "q-57343" :question/problem "$6÷\\frac{3}{5}=$" :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nFirst, we write $6$ as an improper fraction:\n\n$$\n6=\\frac{6}{1}\n$$\n\nNext, we note that the reciprocal of $\\frac{3}{5}$ is $\\frac{5}{3}.$ \n\nSo, we have\n\n$$\n6÷\\frac{3}{5}=\\frac{6}{1}÷\\frac{3}{5}=\\frac{6}{1}\\times \\frac{5}{3}.\n$$\n\n \n\nNow, we multiply our fractions. \n\n$$\n\\frac{6}{1}\\times \\frac{5}{3}=\\frac{6\\times 5}{1\\times 3}=\\frac{30}{3}\n$$\n\nFinally, we simplify:\n\n$$\n30÷3=10\n$$"}] [{:db/id #edb/ref 17592186432143 :knowledge-point/_questions [{:db/id #edb/ref 17592186142808 :knowledge-point/id #uuid "d6aef2b2-fa3d-5c58-9868-67513adfef9b" :knowledge-point/title "Applying a Strategy (Result Is a Fraction or Mixed Number)"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "100ceea8-3703-5dff-a1bd-331a1045f8dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186432067} {:answer/id #uuid "39bb3e28-def5-5b95-a7af-a74115ab33c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{2}" :db/id #edb/ref 17592186432076} {:answer/id #uuid "6a1999f7-a8f0-5ab9-9e8f-ce0c4c751313" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186432082} {:answer/id #uuid "9c32f8ea-5595-5a77-aca5-ef2a8d3f316a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{7}" :db/id #edb/ref 17592186432093} {:answer/id #uuid "ec2eab6e-ec9a-5f16-833e-07b634fa0cba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186432117}] :answer-field/correct {:answer/id #uuid "ec2eab6e-ec9a-5f16-833e-07b634fa0cba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186432117} :answer-field/id #uuid "fcae4ef9-b956-5a61-8936-0e4dd16f2526" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432135}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9cccdde7-11a3-5e93-bfcd-4d97bbb04b46" :question/math-academy-id "q-57350" :question/problem "$3÷\\frac{6}{7}=$" :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nFirst, we write $3$ as an improper fraction:\n\n$$\n3=\\frac{3}{1}\n$$\n\nNext, we note that the reciprocal of $\\frac{6}{7}$ is $\\frac{7}{6}.$ \n\nSo, we have\n\n$$\n3÷\\frac{6}{7}=\\frac{3}{1}÷\\frac{6}{7}=\\frac{3}{1}\\times \\frac{7}{6}.\n$$\n\n \n\nNow, we multiply our fractions. Note that we can simplify the process by swapping the denominators first.\n\n$$\n\\begin{aligned}\\frac{3}{1}\\times \\frac{7}{6} & =\\frac{3}{6}\\times \\frac{7}{1} \\\\  & =\\frac{1}{2}\\times 7 \\\\  & =\\frac{7}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186432137 :knowledge-point/_questions [{:db/id #edb/ref 17592186142806 :knowledge-point/id #uuid "dd40bd52-0088-5405-b03a-71aa22a2fe49" :knowledge-point/title "Dividing Whole Numbers by Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aa019e4-5b41-5e9a-a239-497dcfbe3a4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\,\\frac{2}{3}" :db/id #edb/ref 17592186432066} {:answer/id #uuid "6a211b77-223e-5fcd-92c2-6c6c878468b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\frac{1}{3}" :db/id #edb/ref 17592186432083} {:answer/id #uuid "76c6cad6-3497-53a8-9f58-a2e3c5a66275" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\frac{2}{3}" :db/id #edb/ref 17592186432