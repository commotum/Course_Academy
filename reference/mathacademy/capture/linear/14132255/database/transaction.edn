[{:db/id 17592186142805 :knowledge-point/questions ["question-a7fbd498-4734-50fa-a9cf-c0dbc40d78f7" "question-dc8adac5-7f76-509c-90be-c74971a28644" "question-db1eaa4d-4183-55b4-aee6-0caa24787a8d" "question-a244bc10-5456-5cfa-b7e5-82b04cb2db0d" "question-d7c1b797-5892-54ce-98f6-a2cc3c9cc844"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186142590 :question/problem "Divide $4 \\div \\dfrac 1 {5} .$" :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nThe reciprocal of $\\dfrac{1}{\\color{blue}5}$ is $\\color{blue}5.$ \n\nSo, we have\n\n$$\n4\\div \\dfrac1{\\color{blue}5} = 4\\times  {\\color{blue}5} =20.\n$$" :db/ensure [:question/validate]} {:db/id 17592186142806 :knowledge-point/questions ["question-44133494-469d-5dbd-8472-1b49df14681b" "question-91665a0d-ade7-5cf3-a612-7f96ae529a28" "question-fc7c301b-63d2-5396-9d44-9bc2ca8486a2" "question-422627b7-b37a-52a4-aa47-e207326c7814" "question-7c0abb3e-b307-5eda-92d0-4b63963ecd86"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186142593 :question/problem "Calculate the value of $4\\div \\dfrac35,$ expressing the result as a mixed number." :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nFirst, we write $4$ as an improper fraction:\n\n$$\n4=\\dfrac{4}{1}\n$$\n\nNext, we note that the reciprocal of $\\dfrac{\\color{blue}3}{\\color{red}5}$ is $\\dfrac{\\color{red}5}{\\color{blue}3}.$ \n\nSo, we have\n\n$$\n4\\div \\dfrac 3 5 = \n\n\\dfrac 4 1 \\div \\dfrac{\\color{blue}3}{\\color{red}5} = \\dfrac 4 1 \\times  \\dfrac{\\color{red}5}{\\color{blue}3}.\n$$\n\n \n\nNow, we multiply our fractions. \n\n$$\n\\dfrac 4 {1} \\times \\dfrac{5}{3} =  \\dfrac {4\\times 5} {1\\times 3} = \\dfrac{20}{3}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\dfrac{20}{3} =6\\,\\textrm{R} 2 = 6\\,\\dfrac 2 {3}\n$$" :db/ensure [:question/validate]} {:db/id 17592186142807 :knowledge-point/questions ["question-bbc5b4a5-2761-54d1-8014-69daf251db34" "question-13ffbc44-e82a-541b-9a69-eaa776d03a61" "question-ea504a2d-4bc8-5424-b59c-4de18ccf0fd1" "question-956a3f23-3712-563b-a380-795700cc20ae"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186142592 :question/problem "Divide $8\\div \\dfrac 2 5.$" :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nFirst, we write $8$ as an improper fraction:\n\n$$\n8=\\dfrac{8}{1}\n$$\n\nNext, we note that the reciprocal of $\\dfrac{\\color{blue}2}{\\color{red}5}$ is $\\dfrac{\\color{red}5}{\\color{blue}2}.$ \n\nSo, we have\n\n$$\n8\\div \\dfrac 2 5 = \n\n\\dfrac {8} 1 \\div \\dfrac{\\color{blue}2}{\\color{red}5} = \\dfrac {8} 1 \\times  \\dfrac{\\color{red}5}{\\color{blue}2}.\n$$\n\n \n\nNow, we multiply our fractions. Note that we can simplify the process by swapping the denominators first.\n\n$$\n\\begin{aligned}\\frac{8}{1}\\times \\frac{5}{2} & =\\frac{8}{2}\\times \\frac{5}{1} \\\\  & =4\\times 5 \\\\  & =20\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186142808 :knowledge-point/questions ["question-74bacbf6-b03a-5e84-a6aa-342811a3c626" "question-9cccdde7-11a3-5e93-bfcd-4d97bbb04b46" "question-f41233c3-116b-5b5c-aed9-7d13e659c7e0"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186142591 :question/problem "Calculate the value of $2\\div \\dfrac67,$ expressing the result as a mixed number." :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nFirst, we write $2$ as an improper fraction:\n\n$$\n2=\\dfrac{2}{1}\n$$\n\nNext, we note that the reciprocal of $\\dfrac{\\color{blue}6}{\\color{red}7}$ is $\\dfrac{\\color{red}7}{\\color{blue}6}.$ \n\nSo, we have\n\n$$\n2\\div \\dfrac 6 {7} = \n\\dfrac 2 1 \\div \\dfrac{\\color{blue}6}{\\color{red}7} = \\dfrac 2 1 \\times  \\dfrac{\\color{red}7}{\\color{blue}6}.\n$$\n\n \n\nNow, we multiply our fractions. Note that we can simplify the process by swapping the denominators first.\n\n$$\n\\begin{aligned}\\frac{2}{1}\\times \\frac{7}{6} & =\\frac{2}{6}\\times \\frac{7}{1} \\\\  & =\\frac{1}{3}\\times \\frac{7}{1} \\\\  & =\\frac{1\\times 7}{3\\times 1} \\\\  & =\\frac{7}{3}\\end{aligned}\n$$\n\nFinally, we convert our result to a mixed number:\n\n$$\n\\dfrac73 = 2\\,\\textrm{R}\\,1 = 2\\,\\dfrac13\n$$" :db/ensure [:question/validate]} {:db/id "question-a7fbd498-4734-50fa-a9cf-c0dbc40d78f7" :question/id #uuid "a7fbd498-4734-50fa-a9cf-c0dbc40d78f7" :question/math-academy-id "q-70173" :question/problem "$5÷\\frac{1}{12}=$" :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nThe reciprocal of $\\frac{1}{12}$ is $12.$ \n\nSo, we have\n\n$$\n5÷\\frac{1}{12}=5\\times 12=60.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-701e0928-6858-539c-b28b-e652ae6552cb"] :db/ensure [:question/validate]} {:db/id "answer-field-701e0928-6858-539c-b28b-e652ae6552cb" :answer-field/id #uuid "701e0928-6858-539c-b28b-e652ae6552cb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-701c356a-a003-5701-aa31-b447325e50dc" :answer-field/choices ["answer-a1071f4f-b6e0-54c5-ad20-d8dafbe4017a" "answer-e67fba2e-ed2e-5a71-8a7e-3d60ca98dd9b" "answer-701c356a-a003-5701-aa31-b447325e50dc" "answer-e537db1a-59b7-5e29-8170-b3a2ac8c8853" "answer-e4af61a8-2168-566a-9222-0ce2ce935871"] :db/ensure [:answer-field/validate]} {:db/id "answer-a1071f4f-b6e0-54c5-ad20-d8dafbe4017a" :answer/id #uuid "a1071f4f-b6e0-54c5-ad20-d8dafbe4017a" :answer/type :answer.type/math :answer/value "45" :db/ensure [:answer/validate]} {:db/id "answer-e67fba2e-ed2e-5a71-8a7e-3d60ca98dd9b" :answer/id #uuid "e67fba2e-ed2e-