}$ is $\\frac{7}{3}.$ \n\nSo, we have\n\n$$\n8÷\\frac{3}{7}=\\frac{8}{1}÷\\frac{3}{7}=\\frac{8}{1}\\times \\frac{7}{3}.\n$$\n\n \n\nNow, we multiply our fractions. \n\n$$\n\\frac{8}{1}\\times \\frac{7}{3}=\\frac{8\\times 7}{1\\times 3}=\\frac{56}{3}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{56}{3}=18\\,\\text{R}\\,2=18\\,\\frac{2}{3}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-356b0b63-f0d2-53cf-b184-a6872080a447"] :db/ensure [:question/validate]} {:db/id "answer-field-356b0b63-f0d2-53cf-b184-a6872080a447" :answer-field/id #uuid "356b0b63-f0d2-53cf-b184-a6872080a447" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4b18ec12-51a7-5c98-a962-5f0f60fa1879" :answer-field/choices ["answer-36003491-4756-50b6-aeb3-13098eaa6584" "answer-08de6092-acab-5899-8b13-5144aaa9244f" "answer-7b678e0d-e879-5349-a895-326f5db1b9a7" "answer-4b18ec12-51a7-5c98-a962-5f0f60fa1879" "answer-0222a6be-bedb-50f6-b710-2fafdf9c7137"] :db/ensure [:answer-field/validate]} {:db/id "answer-36003491-4756-50b6-aeb3-13098eaa6584" :answer/id #uuid "36003491-4756-50b6-aeb3-13098eaa6584" :answer/type :answer.type/math :answer/value "12\\,\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-08de6092-acab-5899-8b13-5144aaa9244f" :answer/id #uuid "08de6092-acab-5899-8b13-5144aaa9244f" :answer/type :answer.type/math :answer/value "13\\,\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-7b678e0d-e879-5349-a895-326f5db1b9a7" :answer/id #uuid "7b678e0d-e879-5349-a895-326f5db1b9a7" :answer/type :answer.type/math :answer/value "15\\,\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-4b18ec12-51a7-5c98-a962-5f0f60fa1879" :answer/id #uuid "4b18ec12-51a7-5c98-a962-5f0f60fa1879" :answer/type :answer.type/math :answer/value "18\\,\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-0222a6be-bedb-50f6-b710-2fafdf9c7137" :answer/id #uuid