ac{7}{5}=\\frac{4\\times 7}{1\\times 5}=\\frac{28}{5}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{28}{5}=5\\,\\text{R}3=5\\,\\frac{3}{5}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-415c6e27-5b66-57cf-be91-15cfb1997b57"] :db/ensure [:question/validate]} {:db/id "answer-field-415c6e27-5b66-57cf-be91-15cfb1997b57" :answer-field/id #uuid "415c6e27-5b66-57cf-be91-15cfb1997b57" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e33124e1-d663-5ef1-a1bd-a40b9a688c5b" :answer-field/choices ["answer-bf7b2032-5342-56e3-b03e-5f9fcd6b1e43" "answer-c5ca0f2f-d3f2-5741-ac7a-b2c6b09bec88" "answer-dac55e1f-5cb5-5ca4-b511-ac67a7c6370b" "answer-e49984f9-85a4-5e6c-a22c-ecbbf5f9c108" "answer-e33124e1-d663-5ef1-a1bd-a40b9a688c5b"] :db/ensure [:answer-field/validate]} {:db/id "answer-bf7b2032-5342-56e3-b03e-5f9fcd6b1e43" :answer/id #uuid "bf7b2032-5342-56e3-b03e-5f9fcd6b1e43" :answer/type :answer.type/math :answer/value "2\\,\\frac{3}{7}" :db/ensure [:answer/validate]} {:db/id "answer-c5ca0f2f-d3f2-5741-ac7a-b2c6b09bec88" :answer/id #uuid "c5ca0f2f-d3f2-5741-ac7a-b2c6b09bec88" :answer/type :answer.type/math :answer/value "2\\,\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "answer-dac55e1f-5cb5-5ca4-b511-ac67a7c6370b" :answer/id #uuid "dac55e1f-5cb5-5ca4-b511-ac67a7c6370b" :answer/type :answer.type/math :answer/value "3\\,\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "answer-e49984f9-85a4-5e6c-a22c-ecbbf5f9c108" :answer/id #uuid "e49984f9-85a4-5e6c-a22c-ecbbf5f9c108" :answer/type :answer.type/math :answer/value "3\\,\\frac{2}{7}" :db/ensure [:answer/validate]} {:db/id "answer-e33124e1-d663-5ef1-a1bd-a40b9a688c5b" :answer/id #uuid "e33124e1-d663-5ef1-a1bd-a40b9a688c5b" :answer/type :answer.type/math :answer/value "5\\,\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "question-91665a0d-ade7-5cf3-a612-7f96ae529a28" :question/id #uuid "91665a0d-ade7-5cf3-a612-7f96ae529a28" :question/math-academy-id "q-211429" :question/problem "Expressed as an improper fraction in its lowest terms, $8÷\\frac{5}{7}=${{field-1}}." :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nFirst, we write $8$ as an improper fraction:\n\n$$\n8=\\frac{8}{1}\n$$\n\nNext, we note that the reciprocal of $\\frac{5}{7}$ is $\\frac{7}{5}.$ \n\nSo, we have\n\n$$\n8÷\\frac{5}{7}=\\frac{8}{1}÷\\frac{5}{7}=\\frac{8}{1}\\times \\frac{7}{5}.\n$$\n\n \n\nNow, we multiply our fractions. \n\n$$\n\\frac{8}{1}\\times \\frac{7}{5}=\\frac{8\\times 7}{1\\times 5}=\\frac{56}{5}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7402851b-c554-5386-b883-330712e44e7c"] :db/ensure [:question/validate]} {:db/id "answer-field-7402851b-c554-5386-b883-330712e44e7c" :answer-field/id #uuid "7402851b-c554-5386-b883-330712e44e7c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-31b24742-b8eb-5afe-be50-bea1277608ab" :answer-field/choices ["answer-31b24742-b8eb-5afe-be50-bea1277608ab"] :db/ensure [:answer-field/validate]} {:db/id "answer-31b24742-b8eb-5afe-be50-bea1277608ab" :answer/id #uuid "31b24742-b8eb-5afe-be50-bea1277608ab" :answer/type :answer.type/math :answer/value "\\frac{56}{5}" :db/ensure [:answer/validate]} {:db/id "question-fc7c301b-63d2-5396-9d44-9bc2ca8486a2" :question/id #uuid "fc7c301b-63d2-5396-9d44-9bc2ca8486a2" :question/math-academy-id "q-211428" :question/problem "Expressed as an improper fraction in its lowest terms, $9÷\\frac{2}{3}=${{field-1}}." :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nFirst, we write $9$ as an improper fraction:\n\n$$\n9=\\frac{9}{1}\n$$\n\nNext, we note that the reciprocal of $\\frac{2}{3}$ is $\\frac{3}{2}.$ \n\nSo, we have\n\n$$\n9÷\\frac{2}{3}=\\frac{9}{1}÷\\frac{2}{3}=\\frac{9}{1}\\times \\frac{3}{2}.\n$$\n\n \n\nNow, we multiply our fractions. \n\n$$\n\\frac{9}{1}\\times \\frac{3}{2}=\\frac{9\\times 3}{1\\times 2}=\\frac{27}{2}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-735fcf85-b12d-574f-b7d9-9f9138a783b0"] :db/ensure [:question/validate]} {:db/id "answer-field-735fcf85-b12d-574f-b7d9-9f9138a783b0" :answer-field/id #uuid "735fcf85-b12d-574f-b7d9-9f9138a783b0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-bd575194-1dd4-57b8-a549-a78b174c3b15" :answer-field/choices ["answer-bd575194-1dd4-57b8-a549-a78b174c3b15"] :db/ensure [:answer-field/validate]} {:db/id "answer-bd575194-1dd4-57b8-a549-a78b174c3b15" :answer/id #uuid "bd575194-1dd4-57b8-a549-a78b174c3b15" :answer/type :answer.type/math :answer/value "\\frac{27}{2}" :db/ensure [:answer/validate]} {:db/id "question-422627b7-b37a-52a4-aa47-e207326c7814" :question/id #uuid "422627b7-b37a-52a4-aa47-e207326c7814" :question/math-academy-id "q-57353" :question/problem "$7÷\\frac{3}{4}=$" :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nFirst, we write $7$ as an improper fraction:\n\n$$\n7=\\frac{7}{1}\n$$\n\nNext, we note that the reciprocal of $\\frac{3}{4}$ is $\\frac{4}{3}.$ \n\nSo, we have\n\n$$\n7÷\\frac{3}{4}=\\frac{7}{1}÷\\frac{3}{4}=\\frac{7}{1}\\times \\frac{4}{3}.\n$$\n\n \n\nNow, we multiply our fractions. \n\n$$\n\\frac{7}{1}\\times \\frac{4}{3}=\\frac{7\\times 4}{1\\times 3}=\\frac{28}{3}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{28}{3}=9\\,\\text{R}1=9\\,\\frac{1}{3}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-368d1b0c-ac8e-5089-8316-89fef3f70c90"] :db/ensure [:question/validate]} {:db/id "answer-field-368d1b0c-ac8e-5089