#{[{:db/id #edb/ref 17592186142590 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142805 :knowledge-point/id #uuid "8e58a7d0-dfe1-52dd-9de0-f598aca658df" :knowledge-point/title "Dividing Whole Numbers by Unit Fractions"}] :question/id #uuid "58c82929-55bc-5fcf-b4f1-d685a065efe4" :question/math-academy-id "e-13701" :question/problem "Divide $4 \\div \\dfrac 1 {5}$." :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nThe reciprocal of\n\n$$\n\\dfrac{1}{\\color{blue}5}\n$$\n\nis $\\color{blue}5$.\n\nSo, we have\n\n$$\n4\\div \\dfrac1{\\color{blue}5} = 4\\times {\\color{blue}5} =20\n$$"}] [{:db/id #edb/ref 17592186142591 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142808 :knowledge-point/id #uuid "d6aef2b2-fa3d-5c58-9868-67513adfef9b" :knowledge-point/title "Applying a Strategy (Result Is a Fraction or Mixed Number)"}] :question/id #uuid "906c6d3e-4f1a-58e0-8f21-128bfc754d47" :question/math-academy-id "e-13703" :question/problem "Calculate the value of $2\\div \\dfrac67$, expressing the result as a mixed number." :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nFirst, we write $2$ as an improper fraction:\n\n$$\n2=\\dfrac{2}{1}\n$$\n\nNext, we note that the reciprocal of\n\n$$\n\\dfrac{\\color{blue}6}{\\color{red}7}\n$$\n\nis\n\n$$\n\\dfrac{\\color{red}7}{\\color{blue}6}\n$$\n\nSo, we have\n\n$$\n2\\div \\dfrac 6 {7} = \\dfrac 2 1 \\div \\dfrac{\\color{blue}6}{\\color{red}7} = \\dfrac 2 1 \\times \\dfrac{\\color{red}7}{\\color{blue}6}\n$$\n\nNow, we multiply our fractions. Note that we can simplify the process by swapping the denominators first.\n\n$$\n\\begin{aligned}\n\\frac{2}{1} \\cdot \\frac{7}{6} &= \\frac{2}{6} \\cdot \\frac{7}{1} \\\\\n&= \\frac{1}{3} \\cdot \\frac{7}{1} \\\\\n&= \\frac{1 \\cdot 7}{3 \\cdot 1} \\\\\n&= \\frac{7}{3}\n\\end{aligned}\n$$\n\nFinally, we convert our result to a mixed number:\n\n$$\n\\dfrac73 = 2\\,\\textrm{R}\\,1 = 2\\,\\dfrac13\n$$"}] [{:db/id #edb/ref 17592186142592 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142807 :knowledge-point/id #uuid "d2ddc37a-2ee1-50db-adf7-9b15360f8227" :knowledge-point/title "Applying a Strategy (Result Is a Whole Number)"}] :question/id #uuid "42efe817-2f21-57a9-9cfe-5973ac89f1f2" :question/math-academy-id "e-13706" :question/problem "Divide $8\\div \\dfrac 2 5$." :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nFirst, we write $8$ as an improper fraction:\n\n$$\n8=\\dfrac{8}{1}\n$$\n\nNext, we note that the reciprocal of\n\n$$\n\\dfrac{\\color{blue}2}{\\color{red}5}\n$$\n\nis\n\n$$\n\\dfrac{\\color{red}5}{\\color{blue}2}\n$$\n\nSo, we have\n\n$$\n8\\div \\dfrac 2 5 = \\dfrac {8} 1 \\div \\dfrac{\\color{blue}2}{\\color{red}5} = \\dfrac {8} 1 \\times \\dfrac{\\color{red}5}{\\color{blue}2}\n$$\n\nNow, we multiply our fractions. Note that we can simplify the process by swapping the denominators first.\n\n$$\n\\begin{aligned}\n\\frac{8}{1} \\cdot \\frac{5}{2} &= \\frac{8}{2} \\cdot \\frac{5}{1} \\\\\n&= 4 \\cdot 5 \\\\\n&= 20\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186142593 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142806 :knowledge-point/id #uuid "dd40bd52-0088-5405-b03a-71aa22a2fe49" :knowledge-point/title "Dividing Whole Numbers by Fractions"}] :question/id #uuid "e86212dc-fc03-58a2-9a37-758e85a18073" :question/math-academy-id "e-13708" :question/problem "Calculate the value of $4\\div \\dfrac35$, expressing the result as a mixed number." :question/worked-solution "Dividing a whole number by a fraction is equivalent to multiplying the whole number by the reciprocal of the fraction.\n\nFirst, we write $4$ as an improper fraction:\n\n$$\n4=\\dfrac{4}{1}\n$$\n\nNext, we note that the reciprocal of\n\n$$\n\\dfrac{\\color{blue}3}{\\color{red}5}\n$$\n\nis\n\n$$\n\\dfrac{\\color{red}5}{\\color{blue}3}\n$$\n\nSo, we have\n\n$$\n4\\div \\dfrac 3 5 = \\dfrac 4 1 \\div \\dfrac{\\color{blue}3}{\\color{red}5} = \\dfrac 4 1 \\times \\dfrac{\\color{red}5}{\\color{blue}3}\n$$\n\nNow, we multiply our fractions.\n\n$$\n\\dfrac 4 {1} \\times \\dfrac{5}{3} = \\dfrac {4\\times 5} {1\\times 3} = \\dfrac{20}{3}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\dfrac{20}{3} =6\\,\\textrm{R} 2 = 6\\,\\dfrac 2 {3}\n$$"}] [{:db/id #edb/ref 17592186143175 :knowledge-point/_questions [{:db/id #edb/ref 17592186142807 :knowledge-point/id #uuid "d2ddc37a-2ee1-50db-adf7-9b15360f8227" :knowledge-point/title "Applying a Strategy (Result Is a Whole Number)"}] :question/answer-fields [{:answer-field/id #uuid "aa60e602-52fd-50ab-b1db-03bdd0126e3e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186140337}] :question/id #uuid "d9aee41d-c971-5ee5-9118-fcfbaa5eb455" :question/math-academy-id "q-172166" :question/problem "Expressed as a whole number, $4 \\div \\frac{4}{5} =$ {{field-1}}."}] [{:db/id #edb/ref 17592186143239 :knowledge-point/_questions [{:db/id #edb/ref 17592186142808 :knowledge-point/id #uuid "d6aef2b2-fa3d-5c58-9868-67513adfef9b" :knowledge-point/title "Applying a Strategy (Result Is a Fraction or Mixed Number)"}] :question/answer-fields [{:answer-field/id #uuid "b6f9a33d-04a4-5d2b-8124-142680a07eda" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186140485}] :question/id #uuid "bbef853b-3fbd-53f0-9694-3b9398710671" :question/math-academy-id "q-211463" :question/problem "Expressed as an improper fraction in its lowest terms, $6 \\div \\frac{8}{11} =$ {{field-1}}."}] [{:db/id #edb/ref 17592186143240 :knowledge-point/_questions [{:db/id #edb/ref 17592186142808 :knowledge-point/id #uuid "d6aef2b2-fa3d-5c58-9868-67513adfef9b" :knowledge-point/title "Applying a Strategy (Result Is a Fraction or Mixed Number)"}] :question/answer-fields [{:answer-field/id #uuid "95b4461b-b42b-545f-8137-ee5033bde65a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186140486}] :question/id #uuid "7fefc5b5-5413-51d0-87f7-56b53bb025f8" :question/math-academy-id "q-211472" :question/problem "Expressed as a mixed number in its lowest terms, $2 \\div \\frac{6}{7} =$ {{field-1}}."}]}
