\">\n <use xlink:href=\"#E6-MJMAIN-38\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E6-MJMAIN-F7\" x=\"722\" y=\"0\"></use>\n<g transform=\"translate(1723,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"620\" height=\"60\" x=\"0\" y=\"220\"></rect>\n <use xlink:href=\"#E6-MJMAIN-34\" x=\"60\" y=\"676\"></use>\n <use xlink:href=\"#E6-MJMAIN-35\" x=\"60\" y=\"-687\"></use>\n</g>\n</g>\n <use xlink:href=\"#E6-MJMAIN-3D\" x=\"2861\" y=\"0\"></use>\n<g transform=\"translate(3918,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"620\" height=\"60\" x=\"0\" y=\"220\"></rect>\n <use xlink:href=\"#E6-MJMAIN-38\" x=\"60\" y=\"676\"></use>\n <use xlink:href=\"#E6-MJMAIN-31\" x=\"60\" y=\"-687\"></use>\n</g>\n</g>\n <use xlink:href=\"#E6-MJMAIN-F7\" x=\"5000\" y=\"0\"></use>\n<g transform=\"translate(6001,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"620\" height=\"60\" x=\"0\" y=\"220\"></rect>\n<g fill=\"blue\" stroke=\"blue\" transform=\"translate(60,676)\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n <use xlink:href=\"#E6-MJMAIN-34\"></use>\n</g>\n</g>\n</g>\n<g fill=\"red\" stroke=\"red\" transform=\"translate(60,-687)\">\n<g fill=\"red\" stroke=\"red\">\n<g fill=\"red\" stroke=\"red\">\n <use xlink:href=\"#E6-MJMAIN-35\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E6-MJMAIN-3D\" x=\"7139\" y=\"0\"></use>\n<g transform=\"translate(8196,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"620\" height=\"60\" x=\"0\" y=\"220\"></rect>\n <use xlink:href=\"#E6-MJMAIN-38\" x=\"60\" y=\"676\"></use>\n <use xlink:href=\"#E6-MJMAIN-31\" x=\"60\" y=\"-687\"></use>\n</g>\n</g>\n <use xlink:href=\"#E6-MJMAIN-D7\" x=\"9278\" y=\"0\"></use>\n<g transform=\"translate(10279,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"620\" height=\"60\" x=\"0\" y=\"220\"></rect>\n<g fill=\"red\" stroke=\"red\" transform=\"translate(60,676)\"