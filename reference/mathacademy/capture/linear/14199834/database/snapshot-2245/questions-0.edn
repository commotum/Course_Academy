#{[{:db/id #edb/ref 17592186284760 :knowledge-point/_questions [{:db/id #edb/ref 17592186059790 :knowledge-point/id #uuid "57bae420-d529-5b9d-a306-37127c523be6" :knowledge-point/title "Applying the Rule of Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0adf79cf-fb4e-5181-93de-3cd6649b8b99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186281790} {:answer/id #uuid "4d9a26a0-ce05-55c8-b8a8-2ddc2ef5688f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186282357} {:answer/id #uuid "a9b657b6-d4d7-508f-b524-a99926d87e24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186283160} {:answer/id #uuid "be7cae95-0706-5ece-9e44-aa41b23b9e7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "180" :db/id #edb/ref 17592186283344} {:answer/id #uuid "e0f7cda8-8682-58d7-86e3-0349e1eff0a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "270" :db/id #edb/ref 17592186283648}] :answer-field/correct {:answer/id #uuid "be7cae95-0706-5ece-9e44-aa41b23b9e7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "180" :db/id #edb/ref 17592186283344} :answer-field/id #uuid "93f9b23d-5e2c-559c-bd46-f52adfff9425" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284188}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6fa4f884-6148-57e2-a52b-f22c4cab0eec" :question/math-academy-id "q-1780" :question/problem "Suppose you have $5$ shirts, $4$ pants, and $9$ ties. How many outfits can be made consisting of a shirt, pants, and a tie?" :question/worked-solution "Using the **rule of product**, we have\n\n$$\n\\begin{aligned}\\text{Number of outfits} & =\\text{Number of shirts} \\\\  & \\times \\text{Number of pants} \\\\  & \\times \\text{Number of ties} \\\\  & =5\\times 4\\times 9 \\\\  & =180.\\end{aligned}\n$$\n\nTherefore, $180$ different outfits can be made consisting of a shirt, pants, and a tie."}] [{:db/id #edb/ref 17592186233597 :knowledge-point/_questions [{:db/id #edb/ref 17592186059791 :knowledge-point/id #uuid "f302298b-bae3-563f-9238-eb5f3280c556" :knowledge-point/title "Applying the Rules of Sum and Product With Letter and Digits"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f221c0d-8d18-556d-967b-ef20c8762f48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "568\\,790" :db/id #edb/ref 17592186516274} {:answer/id #uuid "58df81f9-61ee-55b5-a761-6a54a4094e00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "208\\,202" :db/id #edb/ref 17592186516300} {:answer/id #uuid "59ba4028-2b80-5af3-ac2b-01f602c3611d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "320\\,770" :db/id #edb/ref 17592186516304} {:answer/id #uuid "9bb47f58-6a91-54e3-954c-27e73a96817b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "602\\,932" :db/id #edb/ref 17592186516431} {:answer/id #uuid "dc42dad7-db91-5334-8620-482d96189bf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "456\\,976" :db/id #edb/ref 17592186516574}] :answer-field/correct {:answer/id #uuid "dc42dad7-db91-5334-8620-482d96189bf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "456\\,976" :db/id #edb/ref 17592186516574} :answer-field/id #uuid "ab698d9c-d622-5d59-a488-1fc15477a037" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516732}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7bbc5e96-3ab3-50c0-9025-23a59e68d33c" :question/math-academy-id "q-1805" :question/problem "A word consists of $4$ letters, as shown below:\n\n| Letter | Letter | Letter | Letter |\n| --- | --- | --- | --- |\n\nHere, each \"Letter\" can be any capital from A-Z ($26$ in total). How many possible words are there?" :question/worked-solution "For each letter, there is a total of $26$ possibilities.\n\nUsing the **rule of product**, we have\n\n$$\n\\begin{aligned}\\text{Number of words} & =\\text{Number of options in the first slot} \\\\  & \\times \\text{Number of options in the second slot} \\\\  & \\times \\text{Number of options in the third slot} \\\\  & \\times \\text{Number of options in the fourth slot} \\\\  & =26\\times 26\\times 26\\times 26 \\\\  & ={26}^{4} \\\\  & =456\\,976.\\end{aligned}\n$$\n\nSo, there are $456\\,976$ possible words."}] [{:db/id #edb/ref 17592186332931 :knowledge-point/_questions [{:db/id #edb/ref 17592186059790 :knowledge-point/id #uuid "57bae420-d529-5b9d-a306-37127c523be6" :knowledge-point/title "Applying the Rule of Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "588b5441-e2f1-542f-a052-c13d597f28d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186330739} {:answer/id #uuid "67949f5f-f253-5c16-98b2-002b159b74c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186330880} {:answer/id #uuid "8c9ecdc4-d787-5bc9-9482-9746937a76e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186331198} {:answer/id #uuid "a00f90f7-6a77-5d0e-a2ab-c1bf77740553" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186331388} {:answer/id #uuid "ccfe8316-33e3-5252-8fed-bc53d93a249c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "130" :db/id #edb/ref 17592186331766}] :answer-field/correct {:answer/id #uuid "8c9ecdc4-d787-5bc9-9482-9746937a76e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186331198} :answer-field/id #uuid "6e5c51e8-7db9-5d07-b477-86e235e2a03e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332403}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "55c939e5-f687-543f-b774-320200e3562e" :question/math-academy-id "q-5552" :question/problem "John has $3$ pants, $5$ shirts, and $6$ pairs of socks.\nIf John wears one pair of pants, one shirt, and one matching pair of socks, how many different combinations of outfits can he wear?" :question/worked-solution "Using the **rule of product**, we have\n\n$$\n\\begin{aligned}\\text{Number of outfits} & =\\text{Number of pants} \\\\  & \\times \\text{Number of shirts} \\\\  & \\times \\text{Number of pairs of socks} \\\\  & =3\\times 5\\times 6 \\\\  & =90.\\end{aligned}\n$$\n\nTherefore, John can dress in $90$ different ways."}]}
