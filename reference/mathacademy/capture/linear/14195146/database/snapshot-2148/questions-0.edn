#{[{:db/id #edb/ref 17592186105534 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105930 :knowledge-point/id #uuid "305f1d10-f98a-5849-a566-549265b3508d" :knowledge-point/title "Calculating the Area of a Square From a Diagram"}] :question/id #uuid "f7dc8ebd-817d-5709-99a5-f21dc726c2d0" :question/math-academy-id "e-2936" :question/problem "What is the area of the square shown below?\n\n![](images/53/53ab7a043ebbe03245fd0f8e1bf6438897a30d91654b6e51194205e4c302c07f.png)" :question/worked-solution "The area of a square with sides of length $a$ is given by\n\n$$\n\\mathcal{A} = a^2\n$$\n\nNote that each side of a grid cell measures $3\\,\\textrm{ft}$, and each side of the shaded square covers $4$ grid cells. So, the length of each side of the shaded square is\n\n$$\na = 3 \\times 4 = 12 \\, \\textrm{ft}\n$$\n\nTherefore, the area of the shaded square is\n\n$$\n\\begin{aligned}\nA &= a^{2} = 12^{2} = 144ft^{2}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105537 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105932 :knowledge-point/id #uuid "b8e574a9-a37d-512f-aa4d-543ad1a3de84" :knowledge-point/title "Calculating the Area of a Rectangle From a Diagram"}] :question/id #uuid "cf89adb1-3344-5ed4-b2e0-48506af917bc" :question/math-academy-id "e-2940" :question/problem "A cinema has a rectangular hall whose dimensions are shown in the figure below. What is the area of the hall?\n\n![](images/e7/e7263eb3d75ecb243301c2d6c5712dd77232b97b6839123febec3260b389b2e6.png)" :question/worked-solution "The area of a rectangle is given by\n\n$$\n\\mathcal{A} = a \\cdot b\n$$\n\nwhere $a$ and $b$ are the lengths of the sides.\n\nFrom the figure, we obtain that\n\n$$\na = 4.5\\,\\mathrm{m}, \\qquad b = 6\\,\\mathrm{m}\n$$\n\nTherefore, the area of the hall is\n\n$$\n\\begin{aligned}\nA &= a \\cdot b = 4.5 \\cdot 6 = 27m^{2}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105538 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105935 :knowledge-point/id #uuid "c0726a51-b1a9-5755-a19b-0cc68f96b875" :knowledge-point/title "Calculating the Length of a Side of a Rectangle Given Another Side and Its Area"}] :question/id #uuid "022da369-7dfd-5865-8e72-4317203ad11e" :question/math-academy-id "e-2941" :question/problem "The area of the rectangular field shown below is $2\\,400\\,\\textrm{m}^2$. What is the value of $x$?\n\n![](images/94/9419ae4a3099216109bff99906e5d1724a8f01f61e48e22edc62c0e1b62a1bef.png)" :question/worked-solution "The area of a rectangle is given by\n\n$$\n\\mathcal{A} = a \\cdot b\n$$\n\nwhere $a$ and $b$ are the lengths of the sides.\n\nFrom the figure, we obtain that\n\n$$\n\\mathcal{A} = 2\\,400\\mathrm{m}^2, \\qquad a = 60\\,\\mathrm{m}, \\qquad b=x\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nA &= a \\cdot b \\\\\n2400 &= 60 \\cdot x \\\\\nx &= \\frac{2400}{60} \\\\\nx &= 40m\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105671 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105838 :knowledge-point/id #uuid "85c79564-93e7-5054-9534-71dc8dc54f7b" :knowledge-point/title "Calculating the Area of a Rectangle or a Square Given Its Perimeter"}] :question/id #uuid "08cf33de-c71e-55bb-8906-112075c06a37" :question/math-academy-id "e-7691" :question/problem "Find the area of the rectangle $ABCD$ if its perimeter is $40$ and ${BC} = 12$." :question/worked-solution "We can find the length of ${AB}$ by using the formula for the perimeter, as follows:\n\n$$\n\\begin{aligned}\np &= AB + BC + CD + DA \\\\\np &= 2AB + 2BC \\\\\n40 &= 2AB + 2(12) \\\\\n40 &= 2AB + 24 \\\\\n2AB &= 16 \\\\\nAB &= 8\n\\end{aligned}\n$$\n\nTherefore, the area of the rectangle $ABCD$ is\n\n$$\n\\begin{aligned}\nA &= AB \\cdot BC \\\\\n&= 8 \\cdot 12 \\\\\n&= 96\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106416 :knowledge-point/_questions [{:db/id #edb/ref 17592186105935 :knowledge-point/id #uuid "c0726a51-b1a9-5755-a19b-0cc68f96b875" :knowledge-point/title "Calculating the Length of a Side of a Rectangle Given Another Side and Its Area"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93e527b0-2bf3-54a5-b426-ce2db70bfcda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30yd" :db/id #edb/ref 17592186104645} {:answer/id #uuid "b5824ac9-b253-5d61-a72f-03f4ab1b6cb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15yd^{2}" :db/id #edb/ref 17592186104646} {:answer/id #uuid "bd6c2a3a-91d5-5a6d-b6ab-137512bea2b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "500yd" :db/id #edb/ref 17592186104647} {:answer/id #uuid "e42c544a-d7ee-5e22-9fc0-9397724c210f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20yd" :db/id #edb/ref 17592186104648} {:answer/id #uuid "7221319a-1f89-594b-ad8f-1b012fe3d95f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25yd" :db/id #edb/ref 17592186104649}] :answer-field/id #uuid "2dfd1944-ce2e-5b28-a2cd-855b60691175" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186104644}] :question/id #uuid "b96e524d-8067-5f5c-9997-cc35f0bb446f" :question/math-academy-id "q-53269" :question/problem "![](images/91/91a554b467201b7507b531dcc0b6e1d5d9970d3e6d6554878644a31e5e38d9fa.png)\n\nThe area of the rectangular field shown above is $500yd^{2}$. What is the value of $x$?"}]}
