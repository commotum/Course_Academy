#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186130284} :activity/id #uuid "acf531f3-0cde-565d-8aa6-4d76a1de1ef0" :activity/scope {:db/id #edb/ref 17592186048599 :topic/id #uuid "ad3dc03a-62fe-5e03-bb38-d788728fe7b0" :topic/math-academy-id 1987} :activity/steps [{:db/id #edb/ref 17592186130284 :step/content {:db/id #edb/ref 17592186130481 :tutorial/content "As we know already, to evaluate numerical expressions with a mix of different operations, we follow the order of operations (PEMDAS).\n\nThe same rules apply to numerical expressions with zero and negative exponents. To demonstrate, let's compute the value of\n\n$$\n(-3)^0 +2^2 \\div 2.\n$$\n\nTo evaluate the given expression, we use PEMDAS.\n\nNotice that $\\left(-3\\right)^{0}=1.$ So, we obtain\n\n$$\n\\begin{aligned}{(-3)}^{0}+{2}^{2}÷2 & = \\\\ 1+{2}^{2}÷2 & = \\\\ 1+4÷2 & = \\\\ 1+2 & = \\\\ 3 & .\\end{aligned}\n$$" :tutorial/id #uuid "e2d29fa0-8bcb-537b-bed9-91a9ff109764" :tutorial/math-academy-id 8061 :tutorial/title "Introduction"} :step/id #uuid "32a4a3c3-8cf8-5f85-9674-14a9a3dced4b" :step/math-academy-id 54570 :step/next {:db/id #edb/ref 17592186130285}} {:db/id #edb/ref 17592186130285 :step/content {:db/id #edb/ref 17592186129308 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128870 :question/id #uuid "e2f973d4-5d1e-5e35-84d3-277d1069d6f7" :question/math-academy-id "e-12873"} :knowledge-point/id #uuid "72c96e3f-e296-52c6-9c78-1b926625fe29" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048262} {:db/id #edb/ref 17592186048594}] :knowledge-point/questions [{:db/id #edb/ref 17592186129400} {:db/id #edb/ref 17592186129557} {:db/id #edb/ref 17592186481340} {:db/id #edb/ref 17592186481380} {:db/id #edb/ref 17592186481395} {:db/id #edb/ref 17592186481413}] :knowledge-point/title "Evaluating Expressions With Zero Exponents"} :step/id #uuid "c6823b52-f5d1-5aa5-81ad-e750bc27c1f0" :step/math-academy-id 54571 :step/next {:db/id #edb/ref 17592186130286}}