#{[{:db/id #edb/ref 17592186490236 :knowledge-point/_questions [{:db/id #edb/ref 17592186129310 :knowledge-point/id #uuid "222a5d13-74e9-5f1b-81d5-f38a6b80870c" :knowledge-point/title "Evaluating Expressions With Both Zero and Negative Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90c61a4c-acb5-5943-83c3-2a9169499652" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{125}" :db/id #edb/ref 17592186489842}] :answer-field/correct {:answer/id #uuid "90c61a4c-acb5-5943-83c3-2a9169499652" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{125}" :db/id #edb/ref 17592186489842} :answer-field/id #uuid "3292a063-82f7-566f-97f5-25f4fc63cbef" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186490100}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "355c3927-42d5-52b6-8af5-1388530c1ab2" :question/math-academy-id "q-171378" :question/problem "$(-1+7.35)^{0}\\times {5}^{-3}=${{field-1}}" :question/worked-solution "To evaluate the given expression, we use PEMDAS.\n\nFirst, we compute the expression inside the parentheses:\n\n$$\n(-1+7.35)^{0}\\times {5}^{-3}=(6.35)^{0}\\times {5}^{-3}\n$$\n\nNext, notice that $(6.35)^{0}=1.$ So, we obtain:\n\n$$\n\\begin{aligned}(6.35)^{0}\\times {5}^{-3} & = \\\\ 1\\times {5}^{-3} & = \\\\ {5}^{-3}\\end{aligned}\n$$\n\nFinally, \n\n$$\n{5}^{-3}=\\frac{1}{{5}^{3}}=\\frac{1}{125}.\n$$"}] [{:db/id #edb/ref 17592186490256 :knowledge-point/_questions [{:db/id #edb/ref 17592186129309 :knowledge-point/id #uuid "97e3c93e-ceff-5bdb-905f-0c245aa0d362" :knowledge-point/title "Evaluating Expressions With Negative Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a76c1ed-9c9a-5884-8b85-3040e0c60944" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{10}" :db/id #edb/ref 17592186489795}] :answer-field/correct {:answer/id #uuid "7a76c1ed-9c9a-5884-8b85-3040e0c60944" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{10}" :db/id #edb/ref 17592186489795} :answer-field/id #uuid "370651de-97e9-5350-9a2a-8b5e0ff4246c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186490104}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5fe451b2-edf1-59c7-ba6b-aec83b3dbee5" :question/math-academy-id "q-175956" :question/problem "${2}^{-3}\\times (\\frac{8}{5}+4)=${{field-1}}" :question/worked-solution "To evaluate the given expression, we use PEMDAS.\n\nNotice that ${2}^{-3}=\\frac{1}{{2}^{3}}.$ So, we obtain:\n\n$$\n\\begin{aligned}{2}^{-3}\\times (\\frac{8}{5}+4) & = \\\\ \\frac{1}{{2}^{3}}\\times (\\frac{8}{5}+4) & = \\\\ \\frac{1}{8}\\times (\\frac{8}{5}+4) & = \\\\ \\frac{1}{8}\\times \\frac{8+20}{5} & = \\\\ \\frac{1}{8}\\times \\frac{28}{5} & = \\\\ \\frac{1\\times 28}{8\\times 5} & = \\\\ \\frac{1\\times 4\\times 7}{2\\times 4\\times 5} & = \\\\ \\frac{1\\times \\cancel{4}\\times 7}{2\\times \\cancel{4}\\times 5} & = \\\\ \\frac{7}{10}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186490224 :knowledge-point/_questions [{:db/id #edb/ref 17592186129309 :knowledge-point/id #uuid "97e3c93e-ceff-5bdb-905f-0c245aa0d362" :knowledge-point/title "Evaluating Expressions With Negative Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "545f6b34-8b08-5486-9f0e-2cc84dac10e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186489714} {:answer/id #uuid "5923c943-f43e-5441-819c-fc4c38287552" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186489731} {:answer/id #uuid "7575186d-b230-5c3f-951f-24397f6e911d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186489787} {:answer/id #uuid "b71f29a1-8d1a-5479-ac04-69c1694fac07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186489917} {:answer/id #uuid "c44f6e25-54af-5112-a2ff-488411a644f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186489938}] :answer-field/correct {:answer/id #uuid "b71f29a1-8d1a-5479-ac04-69c1694fac07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186489917} :answer-field/id #uuid "7a5fd354-5df8-5dcc-bf17-82ac638ded50" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490142}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "27f65119-9cfd-5858-830b-dc487011110a" :question/math-academy-id "q-69345" :question/problem "Calculate $\\frac{5}{8}\\times 3-(8-10)^{-3}.$" :question/worked-solution "To evaluate the given expression, we use PEMDAS.\n\nFirst, we compute the expression inside the parentheses:\n\n$$\n\\frac{5}{8}\\times 3-(8-10)^{-3}=\\frac{5}{8}\\times 3-(-2)^{-3}\n$$\n\nNext, notice that $(-2)^{-3}=\\frac{1}{(-2)^{3}}=-\\frac{1}{8}.$ So, we obtain:\n\n$$\n\\begin{aligned}\\frac{5}{8}\\times 3-(-2)^{-3} & = \\\\ \\frac{5}{8}\\times 3-(-\\frac{1}{8}) & = \\\\ \\frac{5}{8}\\times \\frac{3}{1}+\\frac{1}{8} & = \\\\ \\frac{5\\times 3}{8\\times 1}+\\frac{1}{8} & = \\\\ \\frac{15}{8}+\\frac{1}{8} & = \\\\ \\frac{15+1}{8} & = \\\\ \\frac{16}{8} & = \\\\ 2\\end{aligned}\n$$"}]}
