e5-0050-5d32-96ef-b82f6090aca6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186415351}] :answer-field/correct {:answer/id #uuid "bcf0d6e5-0050-5d32-96ef-b82f6090aca6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186415351} :answer-field/id #uuid "535f82cf-e072-52a9-bc9d-96b1ca0648ea" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186415369}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "57513638-55f0-5e26-b8a8-dbc4daee54c1" :question/math-academy-id "q-213382" :question/problem "Expressed as a nonnegative integer smaller than $22,$ the additive inverse of $14$ modulo $22$ is{{field-1}}." :question/worked-solution "The additive inverse of $14$ modulo $22$ is the integer $0\\le x<22$ such that\n\n$$\nx+14≡0\\,(\\text{mod}\\,22).\n$$\n\nNotice that $-14+14≡0,$ so $x≡-14\\,(\\text{mod}\\,22).$ To write this in the required form, we use the following sequence of congruences:\n\n$$\n\\begin{aligned}x & ≡-14 & \\,(\\text{mod}\\,22) \\\\  & ≡0-14 & \\,(\\text{mod}\\,22) \\\\  & ≡22-14 & \\,(\\text{mod}\\,22) \\\\  & ≡8 & \\,(\\text{mod}\\,22)\\end{aligned}\n$$\n\nTherefore, the additive inverse of the element $14$ modulo $22$ is $8.$\n\nWe can verify this result as follows:\n\n$$\n8+14≡22≡0\\,\\,✓\\,(\\text{mod}\\,22)\n$$\n\n**Note:** The additive inverse of $a$ modulo $n$ is simply the residue of $-a$ modulo $n,$ i.e. $-a\\,\\text{mod}\\,n.$"}] [{:db/id #edb/ref 17592186415386 :knowledge-point/_questions [{:db/id #edb/ref 17592186152063 :knowledge-point/id #uuid "5513a4ce-730e-56fd-ac8c-8ee1b002abfc" :knowledge-point/title "Finding the Additive Inverse of a Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30bf074a-227f-5233-8f62-fd5916eafb8a" :answer/type {:db