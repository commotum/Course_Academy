#{[{:activity/first-step {:db/id #edb/ref 17592186153138} :activity/id #uuid "f3693137-83df-50ce-b9df-4844eb6a3b95" :activity/scope {:db/id #edb/ref 17592186048734 :topic/id #uuid "b9097aa5-fdae-57ad-857d-bc6b8b5b10e3" :topic/math-academy-id 2788} :activity/steps [{:db/id #edb/ref 17592186153136 :step/content {:db/id #edb/ref 17592186152207 :knowledge-point/canonical-example {:db/id #edb/ref 17592186152015 :question/id #uuid "9267c780-b443-58cb-bd1f-6d44d34caf02" :question/math-academy-id "e-7212"} :knowledge-point/id #uuid "29c77146-872d-5120-9ce7-9a71f156a045" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048905} {:db/id #edb/ref 17592186049697} {:db/id #edb/ref 17592186051039}] :knowledge-point/questions [{:db/id #edb/ref 17592186152841} {:db/id #edb/ref 17592186152842} {:db/id #edb/ref 17592186373476} {:db/id #edb/ref 17592186373504} {:db/id #edb/ref 17592186375466} {:db/id #edb/ref 17592186375473} {:db/id #edb/ref 17592186375480} {:db/id #edb/ref 17592186407201} {:db/id #edb/ref 17592186407204}] :knowledge-point/title "Finding the Complement of a Union"} :step/id #uuid "7a08f22c-b7bc-5e1e-9190-e2abe659a937" :step/math-academy-id 26657 :step/next {:db/id #edb/ref 17592186153137}} {:db/id #edb/ref 17592186153137 :step/content {:db/id #edb/ref 17592186152208 :knowledge-point/canonical-example {:db/id #edb/ref 17592186152016 :question/id #uuid "18f20297-1f8c-5306-9e94-ddfb914a5e83" :question/math-academy-id "e-7213"} :knowledge-point/id #uuid "be98b214-0860-51c6-930b-756af86ec330" :knowledge-point/questions [{:db/id #edb/ref 17592186152843} {:db/id #edb/ref 17592186152844} {:db/id #edb/ref 17592186373483} {:db/id #edb/ref 17592186373490} {:db/id #edb/ref 17592186373511} {:db/id #edb/ref 17592186375487} {:db/id #edb/ref 17592186375494} {:db/id #edb/ref 17592186407200} {:db/id #edb/ref 17592186407202} {:db/id #edb/ref 17592186407203}] :knowledge-point/title "Finding the Complement of an Intersection"} :step/id #uuid "71f338d8-0b25-55b4-8e2d-8edc82c4cf14" :step/math-academy-id 26658} {:db/id #edb/ref 17592186153138 :step/content {:db/id #edb/ref 17592186153401 :tutorial/content "**De Morgan's laws** for sets tell us alternative ways to represent the complement of a union or intersection.\n\n- De Morgan's law for unions states that $$\\overline{A \\cup B} \\equiv \\overline{A} \\cap \\overline{B}.$$\n- De Morgan's law for intersections states that $$\\overline{A \\cap B} \\equiv \\overline{A} \\cup \\overline{B}.$$\n\nIntuitively, you can think that the complement \"flips\" the union into an intersection and vice versa.\n\nTo demonstrate De Morgan's laws, consider the sets $A = \\{ 1,2,3 \\}$ and $B = \\{ 3,4 \\}$ in the universe $U = \\{ 1,2,3,4,5,6 \\}.$\n\n- Computing $\\overline{A \\cup B},$ we have $$\\begin{aligned}\\overset{―}{A\\cup B} & =\\overset{―}{{1,2,3}\\cup {3,4}} \\\\ & =\\overset{―}{{1,2,3,4}} \\\\ & ={5,6}.\\end{aligned}$$ Computing $\\overline{A} \\cap \\overline{B},$ we have $$\\begin{aligned}\\overset{―}{A}\\cap \\overset{―}{B} & =\\overset{―}{{1,2,3}}\\cap \\overset{―}{{3,4}} \\\\ & ={4,5,6}\\cap {1,2,5,6} \\\\ & ={5,6}.\\end{aligned}$$ So, we have that $\\overline{A \\cup B} = \\overline{A} \\cap \\overline{B}. \\quad \\color{green}\\checkmark$\n- Computing $\\overline{A \\cap B},$ we have $$\\begin{aligned}\\overset{―}{A\\cap B} & =\\overset{―}{{1,2,3}\\cap {3,4}} \\\\ & =\\overset{―}{{3}} \\\\ & ={1,2,4,5,6}.\\end{aligned}$$ Computing $\\overline{A} \\cup \\overline{B},$ we have $$\\begin{aligned}\\overset{―}{A}\\cup \\overset{―}{B} & =\\overset{―}{{1,2,3}}\\cup \\overset{―}{{3,4}} \\\\ & ={4,5,6}\\cup {1,2,5,6} \\\\ & ={1,2,4,5,6}.\\end{aligned}$$ So, we have that $\\overline{A \\cap B} = \\overline{A} \\cup \\overline{B}. \\quad \\color{green}\\checkmark$" :tutorial/id #uuid "df8a49e7-15bf-53b1-9af3-754dbf9fc0e8" :tutorial/math-academy-id 4366 :tutorial/title "Introduction"} :step/id #uuid "1f2c991b-1f17-5ca9-b2bb-adab88ae5d59" :step/math-academy-id 26659 :step/next {:db/id #edb/ref 17592186153139}} {:db/id #edb/ref 17592186153139 :step/content {:db/id #edb/ref 17592186153402 :tutorial/content "For the sets $A = \\{ 1,2,3 \\}$ and $B = \\{ 3,4 \\}$ in the universe $U = \\{ 1,2,3,4,5,6 \\},$ the region $\\overline{A \\cup B} = \\overline{A} \\cap \\overline{B}$ is shown below:\n\n![](images/36/367abce6d3386da347ab0eae5cb2d60110c3c642f7a679b6b8b8070e417fc10c.png)\n\nLikewise, the region $\\overline{A \\cap B} = \\overline{A} \\cup \\overline{B}$ is shown below:\n\n![](images/b0/b0a876470b3d2bd455395667f4d0221f73ee7c16dbbb20027a114c356638bc2d.png)" :tutorial/id #uuid "3dc144c9-c8b9-50c4-a923-43e5b8574041" :tutorial/math-academy-id 4367 :tutorial/title "Venn Diagram Representations of De Morgan's Laws"} :step/id #uuid "a0df9dac-82ec-5e01-9bea-92f979e60ec8" :step/math-academy-id 26660 :step/next {:db/id #edb/ref 17592186153136}}] :activity/title "De Morgan's Laws for Sets" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186152378}] [{:activity/course {:db/id #edb/ref 17592186046679} :activity/first-step {:db/id #edb/ref 17592186407206} :activity/id #uuid "540e2ac7-dc1c-5404-b9af-0d79f6e30007" :activity/scope {:db/id #edb/ref 17592186048734 :topic/id #uuid "b9097aa5-fdae-57ad-857d-bc6b8b5b10e3" :topic/math-academy-id 2788} :activity/steps [{:db/id #edb/ref 17592186407205 :step/content {:db/id #edb/ref 17592186407203 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0110ec0d-8688-5278-a786-1d8dda409b47" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "{3,5,7,12}" :db/id #edb/ref 17592186407170} {:answer/id #uuid "081fe163-bcf9-5045-9e8d-d0d8d5c296c2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "{2,5,12}" :db/id #edb/ref 17592186407173} {:answer/id #uuid "341cba87-fefd-5370-9d35-f000e47b3b81" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "{3,7}" :db/id #edb/ref 17592186407176} {:answer/id #uuid "4e61c10e-c743-5fa4-bfe6-69261eda6967" :answer/type 