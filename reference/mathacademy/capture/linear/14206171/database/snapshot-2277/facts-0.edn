86520099 #edb/ref 17592186045417] [17592186520373 #edb/ref 1075 #edb/ref 17592186520138 #edb/ref 17592186045417] [17592186520373 #edb/ref 1075 #edb/ref 17592186520329 #edb/ref 17592186045417] [17592186520373 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186520373 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186520373 #edb/ref 1078 #edb/ref 17592186520138 #edb/ref 17592186045417] [17592186520373 #edb/ref 1079 #uuid "140d3701-ba23-5c26-9cf9-6d695b5d1f47" #edb/ref 17592186045417] [17592186520375 #edb/ref 1075 #edb/ref 17592186520047 #edb/ref 17592186045417] [17592186520375 #edb/ref 1075 #edb/ref 17592186520085 #edb/ref 17592186045417] [17592186520375 #edb/ref 1075 #edb/ref 17592186520279 #edb/ref 17592186045417] [17592186520375 #edb/ref 1075 #edb/ref 17592186520316 #edb/ref 17592186045417] [17592186520375 #edb/ref 1075 #edb/ref 17592186520361 #edb/ref 17592186045417] [17592186520375 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186520375 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186520375 #edb/ref 1078 #edb/ref 17592186520316 #edb/ref 17592186045417] [17592186520375 #edb/ref 1079 #uuid "26e0a8d8-3d22-5a55-a37b-cb46b000140b" #edb/ref 17592186045417] [17592186520390 #edb/ref 1075 #edb/ref 17592186520015 #edb/ref 17592186045417] [17592186520390 #edb/ref 1075 #edb/ref 17592186520061 #edb/ref 17592186045417] [17592186520390 #edb/ref 1075 #edb/ref 17592186520107 #edb/ref 17592186045417] [17592186520390 #edb/ref 1075 #edb/ref 17592186520194 #edb/ref 17592186045417] [17592186520390 #edb/ref 1075 #edb/ref 17592186520312 #edb/ref 17592186045417] [17592186520390 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186520390 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186520390 #edb/ref 1078 #edb/ref 17592186520107 #edb/ref 17592186045417] [17592186520390 #edb/ref 1079 #uuid "4fdf64b2-7dfc-5534-bdd0-a30466c74ca2" #edb/ref 17592186045417] [17592186520447 #edb/ref 1068 #edb/ref 17592186520373 #edb/ref 17592186045417] [17592186520447 #edb/ref 1069 "q-101950" #edb/ref 17592186045417] [17592186520447 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186520447 #edb/ref 1071 "Find the instantaneous rate of change of $f(x)=5{x}^{2}$ at the point $x=1$ by computing the limit of a difference quotient." #edb/ref 17592186045417] [17592186520447 #edb/ref 1072 #uuid "01c94ce2-04ad-5708-8ba5-8bfca9809325" #edb/ref 17592186045417] [17592186520447 #edb/ref 1074 "*Method 1:*\n\nBy the definition, we have\n\n$$\n{f}^{′}(1)={lim}_{h\\to 0}\\frac{f(1+h)-f(1)}{h}.\n$$\n\nApplying this to $f(x)=5{x}^{2}$, we get\n\n$$\n\\begin{aligned}{f}^{′}(1) & ={lim}_{h\\to 0}(\\frac{5(1+h)^{2}-5(1)^{2}}{h}) \\\\  & ={lim}_{h\\to 0}(\\frac{5+10h+5{h}^{2}-5}{h}) \\\\  & ={lim}_{h\\to 0}(\\frac{10h+5{h}^{2}}{h}) \\\\  & ={lim}_{h\\to 0}(10+5h) \\\\  & =10+(0) \\\\  & =10.\\end{aligned}\n$$\n\n \n\n*Method 2:*\n\nBy the definition, we have\n\n$$\n{f}^{′}(1)={lim}_{x\\to 1}\\frac{f(x)-f(1)}{x-1}.\n$$\n\nApplying this to $f(x)=5{x}^{2}$, we get\n\n$$\n\\begin{aligned}{f}^{′}(1) & ={lim}_{x\\to 1}(\\frac{5{x}^{2}-5(1)^{2}}{x-1}) \\\\  & ={lim}_{x\\to 1}(\\frac{5({x}^{2}-1)}{x-1}) \\\\  & ={lim}_{x\\to 1}(\\frac{5(x-1)(x+1)}{x-1}) \\\\  & ={lim}_{x\\to 1}5(x+1) \\\\  & =5(1+1) \\\\  & =10.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186520476 #edb/ref 1068 #edb/ref 17592186520375 #edb/ref 17592186045417] [17592186520476 #edb/ref 1069 "q-47887" #edb/ref 17592186045417] [17592186520476 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186520476 #edb/ref 1071 "Given that $f(x)={x}^{2}$, the instantaneous rate of change ${f}^{′}(-1)$ can be computed using the limit of a difference quotient. The first few steps of this calculation are shown below:\n\n$$\n\\begin{aligned}{f}^{′}(-1) & ={lim}_{h\\to 0}\\frac{f(-1+h)-f(-1)}{h} \\\\  & ={lim}_{h\\to 0}\\frac{(-1+h)^{2}-(-1)^{2}}{h} \\\\  & =…\\end{aligned}\n$$\n\nFinish the calculation, and hence find ${f}^{′}(-1).$" #edb/ref 17592186045417] [17592186520476 #edb/ref 1072 #uuid "7fa38cf7-46e9-5719-8fa2-6633394b103a" #edb/ref 17592186045417] [17592186520476 #edb/ref 1074 "By proceeding with the remaining calculations we get\n\n$$\n\\begin{aligned}{f}^{′}(-1) & ={lim}_{h\\to 0}\\frac{f(-1+h)-f(-1)}{h} \\\\  & ={lim}_{h\\to 0}\\frac{(-1+h)^{2}-(-1)^{2}}{h} \\\\  & ={lim}_{h\\to 0}\\frac{1-2h+{h}^{2}-1}{h} \\\\  & ={lim}_{h\\to 0}\\frac{h(-2+h)}{h} \\\\  & ={lim}_{h\\to 0}(-2+h) \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, ${f}^{′}(-1)=-2.$" #edb/ref 17592186045417] [17592186520482 #edb/ref 1068 #edb/ref 17592186520390 #edb/ref 17592186045417] [17592186520482 #edb/ref 1069 "q-47870" #edb/ref 17592186045417] [17592186520482 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186520482 #edb/ref 1071 "Given that $f(x)=3{x}^{2}$, what is ${f}^{′}(2)$ according to the definition?" #edb/ref 17592186045417] [17592186520482 #edb/ref 1072 #uuid "864d30c1-9b9e-5747-9ebf-06a4c172035c" #edb/ref 17592186045417] [17592186520482 #edb/ref 1074 "The definition of ${f}^{′}(2)$ is\n\n$$\n{lim}_{x\\to 2}(\\frac{f(x)-f(a)}{x-a}).\n$$\n\nLet $a=2.$ Then, we get\n\n$$\n{lim}_{x\\to 2}(\\frac{3{x}^{2}-3(2)^{2}}{x-2}).\n$$" #edb/ref 17592186045417] [17592186520537 #edb/ref 1058 #edb/ref 17592186520593 #edb/ref 17592186045417] [17592186520537 #edb/ref 1062 #uuid "2b61f38b-94db-5d5a-b982-f179ca27382b" #edb/ref 17592186045417] [17592186520537 #edb/ref 1063 #edb/ref 17592186520476 #edb/ref 17592186045417] [17592186520540 #edb/ref 1058 #edb/ref 17592186520537 #edb/ref 17592186045417] [17592186520540 #edb/ref 1062 #uuid "3af6a943-98b1-5bd0-aab5-0234441f6c41" #edb/ref 17592186045417] [17592186520540 #edb/ref 1063 #edb/ref 17592186520482 #edb/ref 17592186045417] [17592186520593 #edb/ref 1062 #uuid "a2d1e0d7-fe00-50a9-bcc0-d71842a58b46" #edb/ref 17592186045417] [17592186520593 #edb/ref 1063 #edb/ref 17592186520447 #edb/ref 17592186045417]}
