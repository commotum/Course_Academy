#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186520540} :activity/id #uuid "a116c91c-02cc-5bc2-b27d-28406f69f493" :activity/scope {:db/id #edb/ref 17592186049362 :topic/id #uuid "eefa1995-be29-5c63-a8ec-6c5199131e6e" :topic/math-academy-id 337} :activity/steps [{:db/id #edb/ref 17592186520537 :step/content {:db/id #edb/ref 17592186520476 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "274df812-d124-5f50-84ac-b7aa8d336139" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{′}(-1)=-1" :db/id #edb/ref 17592186520047} {:answer/id #uuid "428ea4b9-5f3f-5c17-8bf2-2a02357d0d8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{′}(-1)=1" :db/id #edb/ref 17592186520085} {:answer/id #uuid "cd9f2d30-713a-5a24-ab5c-b09f90073991" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{′}(-1)=0" :db/id #edb/ref 17592186520279} {:answer/id #uuid "e0c75f0b-aea6-5e09-82a2-6259cf035e05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{′}(-1)=-2" :db/id #edb/ref 17592186520316} {:answer/id #uuid "fb249616-4f0b-5854-ba69-96ad9991479c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{′}(-1)=-\\frac{1}{2}" :db/id #edb/ref 17592186520361}] :answer-field/correct {:db/id #edb/ref 17592186520316} :answer-field/id #uuid "26e0a8d8-3d22-5a55-a37b-cb46b000140b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186520375}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7fa38cf7-46e9-5719-8fa2-6633394b103a" :question/math-academy-id "q-47887" :question/problem "Given that $f(x)={x}^{2}$, the instantaneous rate of change ${f}^{′}(-1)$ can be computed using the limit of a difference quotient. The first few steps of this calculation are shown below:\n\n$$\n\\begin{aligned}{f}^{′}(-1) & ={lim}_{h\\to 0}\\frac{f(-1+h)-f(-1)}{h} \\\\  & ={lim}_{h\\to 0}\\frac{(-1+h)^{2}-(-1)^{2}}{h} \\\\  & =…\\end{aligned}\n$$\n\nFinish the calculation, and hence find ${f}^{′}(-1).$" :question/worked-solution "By proceeding with the remaining calculations we get\n\n$$\n\\begin{aligned}{f}^{′}(-1) & ={lim}_{h\\to 0}\\frac{f(-1+h)-f(-1)}{h} \\\\  & ={lim}_{h\\to 0}\\frac{(-1+h)^{2}-(-1)^{2}}{h} \\\\  & ={lim}_{h\\to 0}\\frac{1-2h+{h}^{2}-1}{h} \\\\  & ={lim}_{h\\to 0}\\frac{h(-2+h)}{h} \\\\  & ={lim}_{h\\to 0}(-2+h) \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, ${f}^{′}(-1)=-2.$"} :step/id #uuid "2b61f38b-94db-5d5a-b982-f179ca27382b" :step/next {:db/id #edb/ref 17592186520593}} {:db/id #edb/ref 17592186520540 :step/content {:db/id #edb/ref 17592186520482 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12cc6b99-6aa4-5495-b69d-7c177d70318b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{x\\to 2}(\\frac{3{x}^{2}+3(2)^{2}}{x-2})" :db/id #edb/ref 17592186520015} {:answer/id #uuid "2ef965a1-569c-55ee-955d-a534fc912f4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{x\\to 2}(\\frac{3{x}^{2}-3(2)^{2}}{{x}^{2}})" :db/id #edb/ref 17592186520061} {:answer/id #uuid "4b9b3af5-c3c8-599f-a61a-22160b2775b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{x\\to 2}(\\frac{3{x}^{2}-3(2)^{2}}{x-2})" :db/id #edb/ref 17592186520107} {:answer/id #uuid "896cf965-91e5-5f59-949b-28482f31bce3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{x\\to 2}(\\frac{3{x}^{2}-3(2)^{2}}{x+2})" :db/id #edb/ref 17592186520194} {:answer/id #uuid "dddc1051-6963-51f0-a801-9b25da83d366" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{lim}_{x\\to 2}(\\frac{3{x}^{2}-3(2)^{2}}{{2}^{2}})" :db/id #edb/ref 17592186520312}] :answer-field/correct {:db/id #edb/ref 17592186520107} :answer-field/id #uuid "4fdf64b2-7dfc-5534-bdd0-a30466c74ca2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186520390}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "864d30c1-9b9e-5747-9ebf-06a4c172035c" :question/math-academy-id "q-47870" :question/problem "Given that $f(x)=3{x}^{2}$, what is ${f}^{′}(2)$ according to the definition?" :question/worked-solution "The definition of ${f}^{′}(2)$ is\n\n$$\n{lim}_{x\\to 2}(\\frac{f(x)-f(a)}{x-a}).\n$$\n\nLet $a=2.$ Then, we get\n\n$$\n{lim}_{x\\to 2}(\\frac{3{x}^{2}-3(2)^{2}}{x-2}).\n$$"} :step/id #uuid "3af6a943-98b1-5bd0-aab5-0234441f6c41" :step/next {:db/id #edb/ref 17592186520537}} {:db/id #edb/ref 17592186520593 :step/content {:db/id #edb/ref 17592186520447 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fbcae67-db75-584e-abdf-39bdb2826748" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{′}(1)=5" :db/id #edb/ref 17592186520011} {:answer/id #uuid "16929637-3274-5e13-ac66-9758de4de287" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{′}(1)=4" :db/id #edb/ref 17592186520023} {:answer/id #uuid "478dcde0-ffcc-5e5b-9556-15d26a321acd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{′}(1)=-4" :db/id #edb/ref 17592186520099} {:answer/id #uuid "5ed5baec-393d-5e5f-af72-0e15849dbfe0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{′}(1)=10" :db/id #edb/ref 17592186520138} {:answer/id #uuid "e70f5fff-9528-5097-9f8b-f32c917cacb4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{′}(1)=-5" :db/id #edb/ref 17592186520329}] :answer-field/correct {:db/id #edb/ref 17592186520138} :answer-field/id #uuid "140d3701-ba23-5c26-9cf9-6d695b5d1f47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186520373}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "01c94ce2-04ad-5708-8ba5-8bfca9809325" :question/math-academy-id "q-101950" :question/problem "Find the instantaneous rate of change of $f(x)=5{x}^{2}$ at the point $x=1$ by computing the limit of a difference quotient." :question/worked-solution "*Method 1:*\n\nBy the definition, we have\n\n$$\n{f}^{′}(1)={lim}_{h\\to 0}\\frac{f(1+h)-f(1)}{h}.\n$$\n\nApplying this to $f(x)=5{x}^{2}$, we get\n\n$$\n\\begin{aligned}{f}^{′}(1) & ={lim}_{h\\to 0}(\\frac{5(1+h)^{2}-5(1)^{2}}{h}) \\\\  & ={lim}_{h\\to 0}(\\frac{5+10h+5{h}^{2}-5}{h}) \\\\  & ={lim}_{h\\to 0}(\\frac{10h+5{h}^{2}}{h}) \\\\  & ={lim}_{h\\to 0}(10+5h) \\\\  & =10+(0) \\\\  & =10.\\end{aligned}\n$$\n\n \n\n*Method 2:*\n\nBy the definition, we have\n\n$$\n{f}^{′}(1)={lim}_{x\\to 1}\\frac{f(x)-f(1)}{x-1}.\n$$\n\nApplying this to $f(x)=5{x}^{2}$, we get\n\n$$\n\\begin{aligned}{f}^{′}(1) & ={lim}_{x\\to 1}(\\frac{5{x}^{2}-5(1)^{2}}{x-1}) \\\\  & ={lim}_{x\\to 1}(\\frac{5({x}^{2}-1)}{x-1}) \\\\  & ={lim}_{x\\to 1}(\\frac{5(x-1)(x+1)}{x-1}) \\\\  & ={lim}_{x\\to 1}5(x+1) \\\\  & =5(1+1) \\\\  & =10.\\end{aligned}\n$$"} :step/id #uuid "a2d1e0d7-fe00-50a9-bcc0-d71842a58b46"}] :activity/title "The Instantaneous Rate of Change of a Function at a Point" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186519992}]}
