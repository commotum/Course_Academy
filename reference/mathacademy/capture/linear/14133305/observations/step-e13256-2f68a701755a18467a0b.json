  "answer_fields_complete": null,
  "result": null,
  "proof_feedback": null,
  "html": "<div id=\"step-e13256\" class=\"step\" style=\"display: block;\">\n    \n                 \n                <div class=\"example\">\n                    <div class=\"stepHeader\">\n                        <div class=\"stepName\"><span class=\"stepType\">Example:</span> Finding a Ratio</div>       \n                        <div class=\"helpButton\" stepid=\"e13256\">?</div>\n                    </div>\n            \n                    <div class=\"exampleQuestion\">\n                        <p>What ratio describes the number of pentagons to the total number of shapes?</p>\n<div id=\"graphic-57a7d34db0cf8d05f31d91d7f5b7141a\" class=\"graphic\"><img src=\"/graphics/57a7d34db0cf8d05f31d91d7f5b7141a\"></div>\n                    </div>     \n            \n                    <div class=\"exampleExplanationHeader\">EXPLANATION</div>\n            \n                    <div class=\"exampleExplanation\">\n                        <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                            float: none;\n                           