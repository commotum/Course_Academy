d "question-1f1c065d-26db-5359-ab36-7049627505ee" :question/id #uuid "1f1c065d-26db-5359-ab36-7049627505ee" :question/math-academy-id "q-60097" :question/problem "The ratio of dogs to the total number of pets in a veterinary clinic is $2:5.$ What is the meaning of this ratio?" :question/worked-solution "If the ratio of dogs to total pets is $2:5,$ it means that there are $2$ dogs for every $5$ pets in the clinic.\n\nAnother way of writing this is to say that \"out of every $5$ pets in the clinic, $2$ of them are dogs.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-dd5dd299-b1df-587a-bad1-66672246bf54"] :db/ensure [:question/validate]} {:db/id "answer-field-dd5dd299-b1df-587a-bad1-66672246bf54" :answer-field/id #uuid "dd5dd299-b1df-587a-bad1-66672246bf54" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3437aa90-0467-599a-ba5b-16b5032b85c7" :answer-field/choices ["answer-670bc32c-3548-5d3c-ba46-eeaf72fd0957" "answer-3437aa90-0467-599a-ba5b-16b5032b85c7" "answer-6e5f2c14-ef82-5b06-8ef5-9bf8c2a41046" "answer-40c41acd-05cb-5cc5-901e-4aaf18f12186" "answer-e74a4df7-7a20-5e5e-917b-f1fb88083abc"] :db/ensure [:answer-field/validate]} {:db/id "answer-670bc32c-3548-5d3c-ba46-eeaf72fd0957" :answer/id #uuid "670bc32c-3548-5d3c-ba46-eeaf72fd0957" :answer/type :answer.type/text :answer/value "Out of every $2$ pets in the clinic, $5$ of them are dogs" :db/ensure [:answer/validate]} {:db/id "answer-3437aa90-0467-599a-ba5b-16b5032b85c7" :answer/id #uuid "3437aa90-0467-599a-ba5b-16b5032b85c7" :answer/type :answer.type/text :answer/value "Out of every $5$ pets in the clinic, $2$ of them are dogs" :db/ensure [:answer/validate]} {:db/id "answer-6e5f2c14-ef82-5b06-8ef5-9bf8c2a41046" :answer/id #uuid "6e5f2c14-ef82-5b06-8ef5-9bf8c2a41046" :answer/type :answer.type/text :answer/value "The clinic has exactly $2$ dogs" :db/ensure [:answer/validate]} {:db/id "answer-40c41acd-05cb-5cc5-901e-4aaf18f12186" :answer/id #uuid "40c41acd-05cb-5cc5-901e-4aaf18f12186" :answer/type :answer.type/text :answer/value "The clinic has exactly $5$ pets" :db/ensure [:answer/validate]} {:db/id "answer-e74a4df7-7a20-5e5e-917b-f1fb88083abc" :answer/id #uuid "e74a4df7-7a20-5e5e-917b-f1fb88083abc" :answer/type :answer.type/text :answer/value "The clinic has exactly $7$ pets" :db/ensure [:answer/validate]} {:db/id "question-c0762ea5-0707-5974-8961-e278eb0de7ad" :question/id #uuid "c0762ea5-0707-5974-8961-e278eb0de7ad" :question/math-academy-id "q-59597" :question/problem "The ratio of chocolate chip cookies to total cookies in a bakeshop is $8:10.$ What is the meaning of this ratio?" :question/worked-solution "If the ratio of chocolate chip cookies to total cookies is $8:10,$ it means that there are $8$ chocolate chip cookies for every $10$ cookies in total.\n\nAnother way of writing this is to say that \"out of every $10$ cookies in the shop, $8$ of them are chocolate chip.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-59e2fc98-eca9-5369-9168-fe5b453a609a"] :db/ensure [:question/validate]} {:db/id "answer-field-59e2fc98-eca9-5369-9168-fe5b453a609a" :answer-field/id #uuid "59e2fc98-eca9-5369-9168-fe5b453a609a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-540ed119-e478-5792-9adf-6adfed6ac187" :answer-field/choices ["answer-540ed119-e478-5792-9adf-6adfed6ac187" "answer-5ad07733-1716-589e-b10a-53665a139277" "answer-5c905ade-e7ac-5ae7-9d2c-e7448ba6d1cd" "answer-f512f987-c103-5ab1-bb27-54f2f61b0873" "answer-8cc09902-ffb8-5ba0-b50b-e1df45508762"] :db/ensure [:answer-field/validate]} {:db/id "answer-540ed119-e478-5792-9adf-6adfed6ac187" :answer/id #uuid "540ed119-e478-5792-9adf-6adfed6ac187" :answer/type :answer.type/text :answer/value "Out of every $10$ cookies in the shop, $8$ of them are chocolate chip." :db/ensure [:answer/validate]} {:db/id "answer-5ad07733-1716-589e-b10a-53665a139277" :answer/id #uuid "5ad07733-1716-589e-b10a-53665a139277" :answer/type :answer.type/text :answer/value "Out of every $8$ cookies in the shop, $10$ of them are chocolate chip." :db/ensure [:answer/validate]} {:db/id "answer-5c905ade-e7ac-5ae7-9d2c-e7448ba6d1cd" :answer/id #uuid "5c905ade-e7ac-5ae7-9d2c-e7448ba6d1cd" :answer/type :answer.type/text :answer/value "The bakeshop has exactly $10$ chocolate chip cookies." :db/ensure [:answer/validate]} {:db/id "answer-f512f987-c103-5ab1-bb27-54f2f61b0873" :answer/id #uuid "f512f987-c103-5ab1-bb27-54f2f61b0873" :answer/type :answer.type/text :answer/value "The bakeshop has exactly $18$ cookies." :db/ensure [:answer/validate]} {:db/id "answer-8cc09902-ffb8-5ba0-b50b-e1df45508762" :answer/id #uuid "8cc09902-ffb8-5ba0-b50b-e1df45508762" :answer/type :answer.type/text :answer/value "The bakeshop has exactly $2$ sugar-coated cookies." :db/ensure [:answer/validate]} {:db/id 17592186075037 :tutorial/content "A **ratio** is a mathematical statement that expresses the relative sizes of two quantities.\n\nAs an example, let's look at the triangles and circles below. \n\n![](images/48/4865786ce55e0ec3fc1747ece4ea962425a3f83b2a45c7980f52719522318c82.png)\n\nWe can express the ratio of the number of circles to the number of triangles as follows:\n\n$$\n{\\color{blue}{\\textrm{number of circles}}} : {\\color{red}{\\textrm{number of triangles}}}\n$$\n\nTo find this ratio, we start by counting the number of occurrences of each shape:\n\n- First, we count the number of circles. There are $\\color{blue}5$ circles.\n\n- Next, we count the number of triangles. There are $\\color{red}2$ triangles.\n\nTherefore, the ratio of circles to triangles is ${\\color{blue}5}:{\\color{red}2}.$\n\nWe can describe this ratio in words as follows:\n\n*The ratio of circles to triangles is  ${\\color{blue}5}:{\\color{red}2}$ because there are ${\\color{blue}5}$ circles *for every* ${\\color{red}{2}}$ triangles.*" :db/ensure [:tutorial/validate]} {:db/id 17592186073954 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
