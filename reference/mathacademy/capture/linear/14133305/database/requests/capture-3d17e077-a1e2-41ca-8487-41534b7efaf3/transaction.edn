es}:\\text{number of hexagons}\n$$\n\nTo find this ratio, we start by counting the number of occurrences of each shape:\n\n- First, we count the number of triangles. There are $2$ triangles.\n\n- Next, we count the number of hexagons. There are $3$ hexagons.\n\nTherefore, the ratio of triangles to hexagons is $2:3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8bfb0685-209d-51d0-a308-fdff2aa4a1b4"] :db/ensure [:question/validate]} {:db/id "answer-field-8bfb0685-209d-51d0-a308-fdff2aa4a1b4" :answer-field/id #uuid "8bfb0685-209d-51d0-a308-fdff2aa4a1b4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-99282de8-8d77-589a-a7c6-b6b9108e6f96" :answer-field/choices ["answer-c38c972a-e116-5133-91a2-b9dcbb1d676e" "answer-99282de8-8d77-589a-a7c6-b6b9108e6f96" "answer-484586d9-70ee-5024-80ae-ccaf354fb3ca" "answer-7c82b4c0-84bd-5405-80d1-8091a3ce8076" "answer-ddd8a023-c330-50bb-b688-f4cfb0c2eca9"] :db/ensure [:answer-field/validate]} {:db/id "answer-c38c972a-e116-5133-91a2-b9dcbb1d676e" :answer/id #uuid "c38c972a-e116-5133-91a2-b9dcbb1d676e" :answer/type :answer.type/math :answer/value "1:3" :db/ensure [:answer/validate]} {:db/id "answer-99282de8-8d77-589a-a7c6-b6b9108e6f96" :answer/id #uuid "99282de8-8d77-589a-a7c6-b6b9108e6f96" :answer/type :answer.type/math :answer/value "2:3" :db/ensure [:answer/validate]} {:db/id "answer-484586d9-70ee-5024-80ae-ccaf354fb3ca" :answer/id #uuid "484586d9-70ee-5024-80ae-ccaf354fb3ca" :answer/type :answer.type/math :answer/value "2:5" :db/ensure [:answer/validate]} {:db/id "answer-7c82b4c0-84bd-5405-80d1-8091a3ce8076" :answer/id #uuid "7c82b4c0-84bd-5405-80d1-8091a3ce8076" :answer/type :answer.type/math :answer/value "2:7" :db/ensure [:answer/validate]} {:db/id "answer-ddd8a023-c330-50bb-b688-f4cfb0c2eca9" :answer/id #uuid "ddd8a023-c330-50bb-b688-f4cfb0c2eca9" :answer/type :answer.type/math :answer/value "3:2" :db/ensure [:answer/validate]} {:db/id "question-fa02dad0-56c6-5504-ac96-8894e78cb09f" :question/id #uuid "fa02dad0-56c6-5504-ac96-8894e78cb09f" :question/math-academy-id "q-101429" :question/problem "![](images/38/382d511b0797e5b5800bfabc45ab83be7c57439cfe8a4e76da7cfce7f6888661.png)\n\nWhat ratio describes the number of circles to pentagons?" :question/worked-solution "We can express the ratio of the number of circles to the number of pentagons as follows:\n\n$$\n\\text{number of circles}:\\text{number of pentagons}\n$$\n\nTo find this ratio, we start by counting the number of occurrences of each shape:\n\n- First, we count the number of circles. There are $2$ circles.\n\n- Next, we count the number of pentagons. There are $2$ pentagons.\n\nTherefore, the ratio of circles to pentagons is $2:2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c3386acb-31fe-5741-8b3b-68c45b559858"] :db/ensure [:question/validate]} {:db/id "answer-field-c3386acb-31fe-5741-8b3b-68c45b559858" :answer-field/id #uuid "c3386acb-31fe-5741-8b3b-68c45b559858" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f0fb652a-8887-5e4b-ae46-8a28e64e495b" :answer-field/choices ["answer-25dc957c-4c55-55c5-8e0b-4fa70c2cb1c2" "answer-f0fb652a-8887-5e4b-ae46-8a28e64e495b" "answer-8bcf4156-e274-5ae9-b874-c7fe4d81b9dc" "answer-8973c614-3ce5-5be3-b379-8b3c32bbb81d" "answer-b8a8be99-a75d-5e29-9fd7-d64cc0850dae"] :db/ensure [:answer-field/validate]} {:db/id "answer-25dc957c-4c55-55c5-8e0b-4fa70c2cb1c2" :answer/id #uuid "25dc957c-4c55-55c5-8e0b-4fa70c2cb1c2" :answer/type :answer.type/math :answer/value "1:4" :db/ensure [:answer/validate]} {:db/id "answer-f0fb652a-8887-5e4b-ae46-8a28e64e495b" :answer/id #uuid "f0fb652a-8887-5e4b-ae46-8a28e64e495b" :answer/type :answer.type/math :answer/value "2:2" :db/ensure [:answer/validate]} {:db/id "answer-8bcf4156-e274-5ae9-b874-c7fe4d81b9dc" :answer/id #uuid "8bcf4156-e274-5ae9-b874-c7fe4d81b9dc" :answer/type :answer.type/math :answer/value "2:3" :db/ensure [:answer/validate]} {:db/id "answer-8973c614-3ce5-5be3-b379-8b3c32bbb81d" :answer/id #uuid "8973c614-3ce5-5be3-b379-8b3c32bbb81d" :answer/type :answer.type/math :answer/value "2:4" :db/ensure [:answer/validate]} {:db/id "answer-b8a8be99-a75d-5e29-9fd7-d64cc0850dae" :answer/id #uuid "b8a8be99-a75d-5e29-9fd7-d64cc0850dae" :answer/type :answer.type/math :answer/value "3:2" :db/ensure [:answer/validate]} {:db/id "question-e473c68b-cf42-5029-bb25-6a6af2c13e5a" :question/id #uuid "e473c68b-cf42-5029-bb25-6a6af2c13e5a" :question/math-academy-id "q-235951" :question/problem "A study group contains $5$ freshmen, $4$ sophomores, and $3$ juniors. What ratio describes the number of freshmen to the total number of students?\n\nThe required ratio is{{field-1}}\n$:$\n{{field-2}}" :question/worked-solution "We can express the ratio of the number of freshmen to the total number of students as follows:\n\n$$\n\\text{number of freshmen}:\\text{total number of students}\n$$\n\nWe compute our ratio as follows:\n\n- First, we count the number of freshmen. There are $5$ freshmen.\n\n- Next, we count the total number of students. There are $5+4+3=12$ students.\n\nTherefore, the ratio of freshmen to the total number of students is $5:12.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-527131fb-44ca-5325-8aca-82b493559eb2" "answer-field-1895d3c9-f621-5af3-853c-714b8c6c27c9"] :db/ensure [:question/validate]} {:db/id "answer-field-527131fb-44ca-5325-8aca-82b493559eb2" :answer-field/id #uuid "527131fb-44ca-5325-8aca-82b493559eb2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-83467b35-3621-505b-9ace-db58b87b47e8" :answer-field/choices ["answer-83467b35-3621-505b-9ace-db58b87b47e8"] :db/ensure [:answer-field/validate]} {:db/id "answer-83467b35-3621-505b-9ace-db58b87b47e8" :answer/id #uuid "83467b35-3621-505b-9ace-db58b87b47e8" :answer/type :answer.type/math :an