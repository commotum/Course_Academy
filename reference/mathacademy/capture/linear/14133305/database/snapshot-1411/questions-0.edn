/ref 17592186434187 :knowledge-point/_questions [{:db/id #edb/ref 17592186073737 :knowledge-point/id #uuid "9edb7c90-39fa-5396-b00e-04a0627d0581" :knowledge-point/title "Interpreting Ratios"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "540ed119-e478-5792-9adf-6adfed6ac187" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Out of every $10$ cookies in the shop, $8$ of them are chocolate chip." :db/id #edb/ref 17592186434116} {:answer/id #uuid "5ad07733-1716-589e-b10a-53665a139277" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Out of every $8$ cookies in the shop, $10$ of them are chocolate chip." :db/id #edb/ref 17592186434117} {:answer/id #uuid "5c905ade-e7ac-5ae7-9d2c-e7448ba6d1cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The bakeshop has exactly $10$ chocolate chip cookies." :db/id #edb/ref 17592186434118} {:answer/id #uuid "8cc09902-ffb8-5ba0-b50b-e1df45508762" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The bakeshop has exactly $2$ sugar-coated cookies." :db/id #edb/ref 17592186434132} {:answer/id #uuid "f512f987-c103-5ab1-bb27-54f2f61b0873" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The bakeshop has exactly $18$ cookies." :db/id #edb/ref 17592186434158}] :answer-field/correct {:answer/id #uuid "540ed119-e478-5792-9adf-6adfed6ac187" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Out of every $10$ cookies in the shop, $8$ of them are chocolate chip." :db/id #edb/ref 17592186434116} :answer-field/id #uuid "59e2fc98-eca9-5369-9168-fe5b453a609a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186434164}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c0762ea5-0707-5974-8961-e278eb0de7ad" :question/math-academy-id "q-59597" :question/problem "The ratio of chocolate chip cookies to total cookies in a bakeshop is $8:10.$ What is the meaning of this ratio?" :question/worked-solution "If the ratio of chocolate chip cookies to total cookies is $8:10,$ it means that there are $8$ chocolate chip cookies for every $10$ cookies in total.\n\nAnother way of writing this is to say that \"out of every $10$ cookies in the shop, $8$ of them are chocolate chip.\""}] [{:db/id #edb/ref 17592186074402 :knowledge-point/_questions [{:db/id #edb/ref 17592186073737 :knowledge-point/id #uuid "9edb7c90-39fa-5396-b00e-04a0627d0581" :knowledge-point/title "Interpreting Ratios"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd340739-993e-5646-a6ea-9ee601ff5acf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are exactly $2$ male members and exactly $3$ female members" :db/id #edb/ref 17592186072651} {:answer/id #uuid "d844845d-7db2-527f-a1d5-581d6686c16b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are $2$ male members for every $5$ female members" :db/id #edb/ref 17592186072652} {:answer/id #uuid "e4612e89-991b-5682-ae83-c9c45029bd4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are $3$ male members for every $2$ female members" :db/id #edb/ref 17592186072653} {:answer/id #uuid "56d367f8-2c2c-58a4-b513-183d9fe3438b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are exactly $3$ male members and exactly $2$ female members" :db/id #edb/ref 17592186072654} {:answer/id #uuid "5f36f2c7-0744-5fb3-8453-baef888d7f3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are $2$ male members for every $3$ female members" :db/id #edb/ref 17592186072655}] :answer-field/corr