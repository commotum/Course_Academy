#{[{:db/id #edb/ref 17592186073450 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073735 :knowledge-point/id #uuid "0be25cd8-4333-5e00-91e9-7e1256281814" :knowledge-point/title "Finding a Ratio"}] :question/id #uuid "c4235bf2-0c2b-5c2d-be8d-779a8e5fb38f" :question/math-academy-id "e-13256" :question/problem "What ratio describes the number of pentagons to the total number of shapes?\n\n![](images/0f/0fff5dd90ce40b76128001c25b41cf8f34a2b4f63c44717823ba0bdcc98ef224.png)" :question/worked-solution "We can express the ratio of the number of pentagons to the total number of shapes as follows:\n\n$$\n\\textrm{number of pentagons}: \\textrm{total number of shapes}\n$$\n\nTo find this ratio, we start by counting the number of occurrences of each shape:\n\n- First, we count the number of pentagons. There are $3$ pentagons.\n- Next, we count the total number of shapes. There are $6$ shapes.\n\nTherefore, the ratio of pentagons to total shapes is $3:6$."}] [{:db/id #edb/ref 17592186073451 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073736 :knowledge-point/id #uuid "acde6034-9007-5777-a79c-5f99ead9154a" :knowledge-point/title "Word Problems"}] :question/id #uuid "76442c46-6958-556f-a895-027a3ce7427b" :question/math-academy-id "e-13257" :question/problem "A merchant has $8$ black crates and $5$ green crates. What ratio describes the number of green crates to the total number of crates?" :question/worked-solution "We can express the ratio of the number of green crates to the total number of crates as follows:\n\n$$\n\\textrm{number of green crates}: \\textrm{total number of crates}\n$$\n\nWe compute our ratio as follows:\n\n- First, we count the number of green crates. There are $5$ green crates.\n- Next, we count the total number of crates. There are $8+5 = 13$ crates.\n\nTherefore, the ratio of green crates to total crates is $5:13$."}] [{:db/id #edb/ref 17592186073452 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073737 :knowledge-point/id #uuid "9edb7c90-39fa-5396-b00e-04a0627d0581" :knowledge-point/title "Interpreting Ratios"}] :question/id #uuid "34ec50f1-1873-510d-8693-49f93bae1df8" :question/math-academy-id "e-13258" :question/problem "The ratio of red marbles to blue marbles in a bag is $7:8$. What is the meaning of this ratio?" :question/worked-solution "If the ratio of red marbles to blue marbles is ${\\color{red}{7}}:{\\color{blue}{8}}$, it means that there are ${\\color{red}{7}}$ red marbles for every ${\\color{blue}{8}}$ blue marbles."}] [{:db/id #edb/ref 17592186074402 :knowledge-point/_questions [{:db/id #edb/ref 17592186073737 :knowledge-point/id #uuid "9edb7c90-39fa-5396-b00e-04a0627d0581" :knowledge-point/title "Interpreting Ratios"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd340739-993e-5646-a6ea-9ee601ff5acf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are exactly $2$ male members and exactly $3$ female members" :db/id #edb/ref 17592186072651} {:answer/id #uuid "d844845d-7db2-527f-a1d5-581d6686c16b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are $2$ male members for every $5$ female members" :db/id #edb/ref 17592186072652} {:answer/id #uuid "e4612e89-991b-5682-ae83-c9c45029bd4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are $3$ male members for every $2$ female members" :db/id #edb/ref 17592186072653} {:answer/id #uuid "56d367f8-2c2c-58a4-b513-183d9fe3438b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are exactly $3$ male members and exactly $2$ female members" :db/id #edb/ref 17592186072654} {:answer/id #uuid "5f36f2c7-0744-5fb3-8453-baef888d7f3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are $2$ male members for every $3$ female members" :db/id #edb/ref 17592186072655}] :answer-field/id #uuid "abb08e94-171f-5a46-890c-cb2c4848e118" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186072650}] :question/id #uuid "6cd5b8a6-9fde-5a1d-8425-5a7cfba25b44" :question/math-academy-id "q-60087" :question/problem "The ratio of male to the female members of a chess club is $2: 3$. What is the meaning of this ratio?"}]}
