6045417 true] [17592186424970 1074 "Let's look at each one in turn.\n\nI. $\\sqrt{z}$ is an algebraic expression, not a variable.\n\nII. $z$ is a variable because it's a single letter by itself.\n\nIII. $z+y$ is an algebraic expression, not a variable.\n\nSo, only choice II represents a variable." 13194139534541 17592186045417 true] [17592186424971 1068 #edb/ref 17592186424963 13194139534541 17592186045417 true] [17592186424971 1069 "q-184105" 13194139534541 17592186045417 true] [17592186424971 1070 #edb/ref 17592186045485 13194139534541 17592186045417 true] [17592186424971 1071 "Translate the following phrase into an algebraic expression: \"Nine more than a number.\"\n\nUse the letter $x$ to represent the unknown number.\n\n{{field-1}}" 13194139534541 17592186045417 true] [17592186424971 1072 #uuid "15f66f1a-f552-5aa5-b162-3574ee933cd2" 13194139534541 17592186045417 true] [17592186424971 1074 "If we denote our number by $x$, then the phrase \"nine more than a number\" can be written as\n\n$$\nx+9.\n$$" 13194139534541 17592186045417 true] [17592186424972 1068 #edb/ref 17592186424967 13194139534541 17592186045417 true] [17592186424972 1069 "q-108488" 13194139534541 17592186045417 true] [17592186424972 1070 #edb/ref 17592186045485 13194139534541 17592186045417 true] [17592186424972 1071 "Translate the following phrase into an algebraic expression: \"Twenty-five more than a number.\"" 13194139534541 17592186045417 true] [17592186424972 1072 #uuid "45774186-e405-50e3-9083-00b3a8647ac3" 13194139534541 17592186045417 true] [17592186424972 1074 "If we denote our number by $a$, then the phrase \"twenty-five more than a number\" can be written as\n\n$$\na+25.\n$$" 13194139534541 17592186045417 true] [17592186424973 1068 #edb/ref 17592186424966 13194139534541 17592186045417 true] [17592186424973 1069 "q-184139" 13194139534541 17592186045417 true] [17592186424973 1070 #edb/ref 17592186045485 13194139534541 17592186045417 true] [17592186424973 1071 "Translate the following phrase into an algebraic expression: \"Twenty-five fewer than a number.\"\n\nUse the letter $n$ to represent the unknown number.\n\n{{field-1}}" 13194139534541 17592186045417 true] [17592186424973 1072 #uuid "49b8ccfc-8c8f-513c-976c-7189fb53e754" 13194139534541 17592186045417 true] [17592186424973 1074 "If we denote our number by $n,$ then the phrase \"twenty-five fewer than a number\" can be written as \n\n$$\nn-25.\n$$" 13194139534541 17592186045417 true] [17592186424974 1068 #edb/ref 17592186424958 13194139534541 17592186045417 true] [17592186424974 1069 "q-75552" 13194139534541 17592186045417 true] [17592186424974 1070 #edb/ref 17592186045485 13194139534541 17592186045417 true] [17592186424974 1071 "Which of the following is a variable?\n\nI. $3$\n\nII. $1-x$\n\nIII. $y$" 13194139534541 17592186045417 true] [17592186424974 1072 #uuid "4bbee0aa-5b29-5213-8656-a4a447aaa279" 13194139534541 17592186045417 true] [17592186424974 1074 "Let's look at each one in turn.\n\nI. $3$ is a number, not a variable.\n\nII. $1-x$ is an algebraic expression, not a variable.\n\nIII. $y$ is a variable because it's a single letter by itself.\n\nSo, only choice III represents a variable." 13194139534541 17592186045417 true] [17592186424975 1068 #edb/ref 17592186424960 13194139534541 17592186045417 true] [17592186424975 1069 "q-67035" 13194139534541 17592186045417 true] [17592186424975 1070 #edb/ref 17592186045485 13194139534541 17592186045417 true] [17592186424975 1071 "Translate the following phrase into an algebraic expression: \"$6$ less than a number.\"" 13194139534541 17592186045417 true] [17592186424975 1072 #uuid "520b5e2e-79aa-5a86-9767-c7601ba41ffe" 13194139534541 17592186045417 true] [17592186424975 1074 "If we denote our number by $x$, then the phrase  \"$6$ less than a number\" can be written as\n\n$$\nx-6.\n$$" 13194139534541 17592186045417 true] [17592186424976 1068 #edb/ref 17592186424962 13194139534541 17592186045417 true] [17592186424976 1069 "q-184110" 13194139534541 17592186045417 true] [17592186424976 1070 #edb/ref 17592186045485 13194139534541 17592186045417 true] [17592186424976 1071 "Translate the following phrase into an algebraic expression: \"Thirteen more than a number.\"\n\nUse the letter $z$ to represent the unknown number.\n\n{{field-1}}" 13194139534541 17592186045417 true] [17592186424976 1072 #uuid "605024d8-c1ee-55c7-9942-81ccf153161b" 13194139534541 17592186045417 true] [17592186424976 1074 "If we denote our number by $z$, then the phrase \"thirteen more than a number\" can be written as\n\n$$\nz+13.\n$$" 13194139534541 17592186045417 true] [17592186424977 1068 #edb/ref 17592186424959 13194139534541 17592186045417 true] [17592186424977 1069 "q-184140" 13194139534541 17592186045417 true] [17592186424977 1070 #edb/ref 17592186045487 13194139534541 17592186045417 true] [17592186424977 1071 "Carl's house is $9$ miles closer to school than Beth's house. If the distance from Beth's house to school is $d$ miles, then the distance from Carl's house to school is{{field-1}}miles." 13194139534541 17592186045417 true] [17592186424977 1072 #uuid "a26167a2-2a64-57a1-8bc2-6bd8a04d1786" 13194139534541 17592186045417 true] [17592186424977 1074 "We know the distance from Beth's house to school is $d$ miles, and the distance from Carl's house to school is $9$ miles less than that from Beth's house. Therefore, the distance from Carl's house to school is $d-9$ miles." 13194139534541 17592186045417 true] [17592186424978 1068 #edb/ref 17592186424965 13194139534541 17592186045417 true] [17592186424978 1069 "q-108356" 13194139534541 17592186045417 true] [17592186424978 1070 #edb/ref 17592186045487 13194139534541 17592186045417 true] [17592186424978 1071 "How many distinct variables are there in the algebraic expression $y+2w+z-2wx+5?$" 13194139534541 17592186045417 true] [17592186424978 1072 #uuid "b81b7456-a2b2-5074-8d35-61b208d56683" 13194139534541 17592186045417 true] [17592186424978 1074 "The expression contains a total of four variables, $w,x,y,$ and $z.$" 13194139534541 17592186045417 true] [17592186424979 1068 #edb/ref 17592186424964 13194139534541 17592186045417 true] [17592186424979 1069 "q-67033" 13194139534541 17592186045417 true] [17592186424979 1070 #edb/ref 17592186045485 13194139534541 17592186045417 true] [17592186424979 1071 "Translate the following phrase into an algebraic expression: \"One more than a number.\"" 13194139534541 17592186045417 true] [17592186424979 1072 #uuid "f08382ab-8492-5563-871a-83c2011eac57" 13194139534541 17592186045417 true] [17592186424979 1074 "If we denote our number by $a$, then the phrase \"one more than a number\" can be written as\n\n$$\na+1\n$$" 13194139534541 17592186045417 true] [17592186424980 1068 #edb/ref 17592186424968 13194139534541 17592186045417 true] [17592186424980 1069 "q-108493" 13194139534541 17592186045417 true] [17592186424980 1070 #edb/ref 17592186045485 13194139534541 17592186045417 true] [17592186424980 1071 "Translate the following phrase into an algebraic expression: \"$35$ less than a number.\"" 13194139534541 17592186045417 true] [17592186424980 1072 #uuid "f5c73352-21c9-5c19-bb4b-0d12d53e07e3" 13194139534541 17592186045417 true] [17592186424980 1074 "If we denote our number by $q$, then the phrase can be written as\n\n$$\nq-35.\n$$" 13194139534541 17592186045417 true] [17592186424981 1068 #edb/ref 17592186424969 13194139534541 17592186045417 true] [17592186424981 1069 "q-67034" 13194139534541 17592186045417 true] [17592186424981 1070 #edb/ref 17592186045485 13194139534541 17592186045417 true] [17592186424981 1071 "Translate the following phrase into an algebraic expression: \"Fifteen more than a number.\"" 13194139534541 17592186045417 true] [17592186424981 1072 #uuid "f967a99f-911e-59b2-80e7-a5ba0f5de422" 13194139534541 17592186045417 true] [17592186424981 1074 "If we denote our number by $x$, then the phrase \"fifteen more than a number\" can be written as\n\n$$\nx+15\n$$" 13194139534541 17592186045417 true] [17592186424982 106