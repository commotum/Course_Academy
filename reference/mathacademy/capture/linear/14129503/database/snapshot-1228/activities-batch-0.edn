#{[{:activity/first-step {:db/id #edb/ref 17592186055825} :activity/id #uuid "604975a3-93f4-5972-a157-950937a51eea" :activity/scope {:db/id #edb/ref 17592186050618 :topic/id #uuid "598e4586-378e-5300-9abe-bbb9ded2ad77" :topic/math-academy-id 63} :activity/steps [{:db/id #edb/ref 17592186055825 :step/content {:db/id #edb/ref 17592186056032 :tutorial/content "A **variable** is any letter or symbol that can be replaced by a number. For example, the letters\n$x, \\quad y, \\quad z, \\quad a, \\quad b, \\quad c, \\quad k, \\quad m,\\quad n,\\quad p, \\quad q,\\quad r, \\quad \\ldots$\n\nare commonly used as variables. But in general, we can use any letter we like.\n\nAn **algebraic expression** is a combination of variables with mathematical operations, like addition $(+)$, subtraction $(-)$, multiplication $(\\times)$, and division $(\\div)$. So\n$x+2,\\qquad 6-y,\\qquad 2\\times p + 1,\\qquad q\\div r$,\nare all examples of algebraic expressions." :tutorial/id #uuid "232cd5fe-049f-512d-8d7c-ad600a7e6a81" :tutorial/math-academy-id 8165 :tutorial/title "Introduction"} :step/id #uuid "56c96a42-70b1-5c3d-baeb-d0e31a2f412b" :step/math-academy-id 53778 :step/next {:db/id #edb/ref 17592186055826}} {:db/id #edb/ref 17592186055826 :step/content {:db/id #edb/ref 17592186054799 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054421 :question/id #uuid "61ebe3c8-1241-59f1-9d60-704d520c53fb" :question/math-academy-id "e-13055"} :knowledge-point/id #uuid "ef650886-8d46-583e-bad0-1429ba496479" :knowledge-point/questions [{:db/id #edb/ref 17592186055373} {:db/id #edb/ref 17592186055390}] :knowledge-point/title "Identifying Variables"} :step/id #uuid "31658058-879c-5f54-87bd-336129b73d45" :step/math-academy-id 53779 :step/next {:db/id #edb/ref 17592186055827}} {:db/id #edb/ref 17592186055827 :step/content {:db/id #edb/ref 17592186054800 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054422 :question/id #uuid "ee12fc6a-91b2-5855-96a8-c28bd6652ae5" :question/math-