#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186564574} :activity/id #uuid "d340a7ac-67ef-5612-b337-ffb063b5d526" :activity/scope {:db/id #edb/ref 17592186049112 :topic/id #uuid "db763a5a-0f9c-54a8-b982-f5ada5dd8c49" :topic/math-academy-id 490} :activity/steps [{:db/id #edb/ref 17592186564560 :step/content {:db/id #edb/ref 17592186074218 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c819c9f3-95c3-5c1b-b646-7f55355732e6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186071547} {:answer/id #uuid "d105ad22-7cfc-5fce-984e-2495aa5bffbf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186071548} {:answer/id #uuid "2cf4eee9-8b07-538a-a5df-7ec577f4167d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186071549} {:answer/id #uuid "2f48553e-a77f-569b-855c-f635f913cc25" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186071550} {:answer/id #uuid "5842e401-d8d0-56be-85e6-2b2ee7829509" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186071551}] :answer-field/correct {:db/id #edb/ref 17592186071548} :answer-field/id #uuid "631cce7e-de79-5d0d-ac1a-43d36e34fce8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186071546}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3e32b4ac-79f1-5405-9e5b-031cfee73d29" :question/math-academy-id "q-53668" :question/problem "Given that $△ABC∼△{A}^{′}{B}^{′}{C}^{′},$ $AB=4\\,cm$ and $BC=6\\,cm,$\nwhich of the following could be the values of ${A}^{′}{B}^{′}$ and ${B}^{′}{C}^{′}?$\n\nI. ${A}^{′}{B}^{′}=16\\,cm,\\,{B}^{′}{C}^{′}=24\\,cm$\n\nII. ${A}^{′}{B}^{′}=20\\,cm,\\,{B}^{′}{C}^{′}=30\\,cm$\n\nIII. ${A}^{′}{B}^{′}=32\\,cm,\\,{B}^{′}{C}^{′}=42\\,cm$" :question/worked-solution "For similar polygons, the ratios of lengths of the corresponding sides should be the same.\n\n- Let's check for this in option I:\n\n$$\n\\begin{aligned}\\frac{AB}{{A}^{′}{B}^{′}} & =\\frac{4}{16}=\\frac{1}{4}, \\\\ \\frac{BC}{{B}^{′}{C}^{′}} & =\\frac{6}{24}=\\frac{1}{4}\\,.\\end{aligned}\n$$\n\nSo, option I does give possible values of ${A}^{′}{B}^{′}$ and ${B}^{′}{C}^{′}.$\n\n- For option II, we have\n\n$$\n\\begin{aligned}\\frac{AB}{{A}^{′}{B}^{′}} & =\\frac{4}{20}=\\frac{1}{5}, \\\\ \\frac{BC}{{B}^{′}{C}^{′}} & =\\frac{6}{30}=\\frac{1}{5}\\,.\\end{aligned}\n$$\n\nSo, option II does give possible values of ${A}^{′}{B}^{′}$ and ${B}^{′}{C}^{′}.$\n\n- For option III, we have\n\n$$\n\\begin{aligned}\\frac{AB}{{A}^{′}{B}^{′}} & =\\frac{4}{32}=\\frac{1}{8}, \\\\ \\frac{BC}{{B}^{′}{C}^{′}} & =\\frac{6}{42}=\\frac{1}{7}\\,.\\end{aligned}\n$$\n\nSo, option III does not give possible values of ${A}^{′}{B}^{′}$ and ${B}^{′}{C}^{′}.$\n\nTherefore, the correct answer is \"I and II only.\""} :step/id #uuid "4f04fdc1-79b6-5d81-b085-c044626bc257" :step/next {:db/id #edb/ref 17592186564578}} {:db/id #edb/ref 17592186564574 :step/content {:db/id #edb/ref 17592186564503 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0560459a-bce6-5338-82e7-960929cfc752" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "EABCD∼XYUVW" :db/id #edb/ref 17592186563979} {:answer/id #uuid "3d8bb24e-348f-5983-913d-51ca2226f57e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "EABCD∼YUVXW" :db/id #edb/ref 17592186564073} {:answer/id #uuid "e831d608-ab95-5cb5-bd60-e9a515a2274f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "ABCDE∼UVWXY" :db/id #edb/ref 17592186564334} {:answer/id #uuid "f074f9a2-1f24-594d-a3e3-1978813ac002" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "ABCDE∼UYXWV" :db/id #edb/ref 17592186564358} {:answer/id #uuid "f496cc6b-a69d-5e9f-b778-efe587c3fac0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "ABCDE∼YUVWX" :db/id #edb/ref 17592186564365}] :answer-field/correct {:db/id #edb/ref 17592186564334} :answer-field/id #uuid "3086ccfe-34d4-5016-955b-04dc749a45e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186564386}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "889c45f8-a956-5ef6-ac2b-6cd191ad30dc" :question/math-academy-id "q-53664" :question/problem "![](images/01/01b6ade0a9b4945c0381848092e9b2289f823c49b2c5c138a29187e7f541787c.png)\n\nThe two pentagons shown above are similar. What is the correct similarity statement?" :question/worked-solution "Since, \n\n$$\n\\begin{aligned}∠A≅∠U,\\,∠B≅∠V,\\,∠C≅∠W,\\,∠D≅∠X,\\,∠E≅∠Y,\\end{aligned}\n$$\n\nwe conclude that \n\n- $A$ corresponds to $U,$\n\n- $B$ corresponds to $V,$\n\n- $C$ corresponds to $W,$\n\n- $D$ corresponds to $X,$\n\n- $E$ corresponds to $Y.$\n\nTherefore, $ABCDE∼UVWXY.$"} :step/id #uuid "9a482e98-3882-5312-9956-5490d87f2d07" :step/next {:db/id #edb/ref 17592186564560}} {:db/id #edb/ref 17592186564578 :step/content {:db/id #edb/ref 17592186564489 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c8c637f-7506-5929-a813-aedf842eb2f5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$R$ only" :db/id #edb/ref 17592186564069} {:answer/id #uuid "54e63c6d-254e-54cc-8466-5d5bf3d74155" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$M$ only" :db/id #edb/ref 17592186564105} {:answer/id #uuid "5bdfd74e-ff63-5abb-9563-5fa157d583fd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$K$ only" :db/id #edb/ref 17592186564114} {:answer/id #uuid "8419996f-9e9b-515d-b6eb-d75dfba8906e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$M$ and $R$ only" :db/id #edb/ref 17592186564173} {:answer/id #uuid "c0715756-6c47-5bbc-ac2f-30e9b24661cd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$K$ and $M$ only" :db/id #edb/ref 17592186564265}] :answer-field/correct {:db/id #edb/ref 17592186564105} :answer-field/id #uuid "865551b8-c0d8-5cf9-868e-7a602dfa6e44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186564416}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5a648c7b-b62d-5742-8e25-e411a6e50067" :question/math-academy-id "q-88002" :question/problem "![](images/99/99212835e0eec95ac4ebd0c7d0fd49e1bb7e1a392f53251aa49510ac8ef5b65d.png)\n\nWhich of the above quadrilaterals are similar to $T$ (other than $T$ itself)?" :question/worked-solution "First, notice that $T$ is a right trapezoid with one pair of parallel opposite sides.\n\nWith that in mind, let's examine each of the given polygons.\n\n- $K$ is *not* similar to $T.$ The polygon $K$ is a right trapezoid, and the corresponding angles are congruent, but the ratios of the lengths of the corresponding sides are not the same: \n\n$$\n\\frac{7}{14}\\ne \\frac{6}{6}\n$$\n\n- $R$ is *not* similar to $T$ because $R$ is not a trapezoid (it's a rectangle since it has $2$ pairs of opposite parallel sides, and $2$ pairs of right angles).\n\n- $M$ is similar to $T.$ Indeed, $M$ is a right trapezoid. Furthermore, the corresponding angles are congruent, and the ratios of the lengths of the corresponding sides are the same:\n\n$$\n\\frac{7}{14}=\\frac{3}{6}\n$$\n\nTherefore, the correct answer is \"$M$ only\"."} :step/id #uuid "a8d4dd43-e6fc-58cb-b0ab-de5e3f09f025"}] :activity/title "Similarity and Similar Polygons" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186563968}]}
