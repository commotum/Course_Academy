592186077654 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186077654 #edb/ref 1079 #uuid "41d9b076-e24e-5725-bd8f-2293f79ac91a" #edb/ref 17592186045417] [17592186077655 #edb/ref 1080 "Not enough information" #edb/ref 17592186045417] [17592186077655 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186077655 #edb/ref 1083 #uuid "9cad4dd8-ca6d-55ab-9dc5-081de80e69a7" #edb/ref 17592186045417] [17592186077656 #edb/ref 1080 "No, since there is at least one output with more than one input" #edb/ref 17592186045417] [17592186077656 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186077656 #edb/ref 1083 #uuid "001094b5-522b-5aff-87d8-cdfd551294ec" #edb/ref 17592186045417] [17592186077657 #edb/ref 1080 "Yes, since each input is assigned to exactly one output" #edb/ref 17592186045417] [17592186077657 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186077657 #edb/ref 1083 #uuid "3024a1e1-3c8f-5f6d-ab79-bde1c13d5709" #edb/ref 17592186045417] [17592186077658 #edb/ref 1080 "Yes, since each output is related to at least one input" #edb/ref 17592186045417] [17592186077658 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186077658 #edb/ref 1083 #uuid "4cd5fdb7-c2a9-539d-b5b1-60da0e4d051a" #edb/ref 17592186045417] [17592186077659 #edb/ref 1080 "No, since both sets have different numbers of elements" #edb/ref 17592186045417] [17592186077659 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186077659 #edb/ref 1083 #uuid "6008c3f2-d2aa-5fd1-96b6-5ae4ce87bd88" #edb/ref 17592186045417] [17592186078527 #edb/ref 1037 #edb/ref 17592186048652 #edb/ref 17592186045417] [17592186078527 #edb/ref 1038 #edb/ref 17592186079146 #edb/ref 17592186045417] [17592186078527 #edb/ref 1038 #edb/ref 17592186079180 #edb/ref 17592186045417] [17592186078527 #edb/ref 1038 #edb/ref 17592186492031 #edb/ref 17592186045417] [17592186078527 #edb/ref 1038 #edb/ref 17592186492044 #edb/ref 17592186045417] [17592186078527 #edb/ref 1039 "Determining if a Rule Given by a Mapping Diagram Is a Function" #edb/ref 17592186045417] [17592186078527 #edb/ref 1041 #edb/ref 17592186078142 #edb/ref 17592186045417] [17592186078527 #edb/ref 1042 #uuid "3cc2167e-d318-54d5-8b67-47afbc65f530" #edb/ref 17592186045417] [17592186078528 #edb/ref 1038 #edb/ref 17592186078878 #edb/ref 17592186045417] [17592186078528 #edb/ref 1038 #edb/ref 17592186078955 #edb/ref 17592186045417] [17592186078528 #edb/ref 1038 #edb/ref 17592186492012 #edb/ref 17592186045417] [17592186078528 #edb/ref 1039 "Determining if a Rule Given by a Table Is a Function" #edb/ref 17592186045417] [17592186078528 #edb/ref 1041 #edb/ref 17592186078381 #edb/ref 17592186045417] [17592186078528 #edb/ref 1042 #uuid "b869d240-38f8-52c8-bb87-110d7ac616b8" #edb/ref 17592186045417] [17592186078655 #edb/ref 1043 #edb/ref 17592186079450 #edb/ref 17592186045417] [17592186078655 #edb/ref 1043 #edb/ref 17592186079451 #edb/ref 17592186045417] [17592186078655 #edb/ref 1043 #edb/ref 17592186079452 #edb/ref 17592186045417] [17592186078655 #edb/ref 1043 #edb/ref 17592186079453 #edb/ref 17592186045417] [17592186078655 #edb/ref 1043 #edb/ref 17592186079454 #edb/ref 17592186045417] [17592186078655 #edb/ref 1043 #edb/ref 17592186079455 #edb/ref 17592186045417] [17592186078655 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186078655 #edb/ref 1045 "Visual Representations of Functions" #edb/ref 17592186045417] [17592186078655 #edb/ref 1046 #edb/ref 17592186079450 #edb/ref 17592186045417] [17592186078655 #edb/ref 1049 #edb/ref 17592186050566 #edb/ref 17592186045417] [17592186078655 #edb/ref 1050 420.0 #edb/ref 17592186045417] [17592186078655 #edb/ref 1053 #uuid "fa63b04f-e0ce-592f-b214-495b5c1b67a9" #edb/ref 17592186045417] [17592186079146 #edb/ref 1068 #edb/ref 17592186077654 #edb/ref 17592186045417] [17592186079146 #edb/ref 1069 "q-60621" #edb/ref 17592186045417] [17592186079146 #edb/ref 1071 "![](images/aa/aaba52792efd52cae40bed740b50f3f92f54e0f13436c16ffc8358ff8200cd76.png)\n\nIs the above rule a function?" #edb/ref 17592186045417] [17592186079146 #edb/ref 1072 #uuid "77dee980-a89b-544a-9fab-994ab35aaa5f" #edb/ref 17592186045417] [17592186079450 #edb/ref 1058 #edb/ref 17592186079452 #edb/ref 17592186045417] [17592186079450 #edb/ref 1061 3581 #edb/ref 17592186045417] [17592186079450 #edb/ref 1062 #uuid "93acbf1d-7504-5269-982c-7785e36bfa3d" #edb/ref 17592186045417] [17592186079450 #edb/ref 1063 #edb/ref 17592186079616 #edb/ref 17592186045417] [17592186079451 #edb/ref 1058 #edb/ref 17592186079454 #edb/ref 17592186045417] [17592186079451 #edb/ref 1061 3585 #edb/ref 17592186045417] [17592186079451 #edb/ref 1062 #uuid "953349df-46b8-543b-a772-87c3e0ffd977" #edb/ref 17592186045417] [17592186079451 #edb/ref 1063 #edb/ref 17592186078527 #edb/ref 17592186045417] [17592186079452 #edb/ref 1058 #edb/ref 17592186079455 #edb/ref 17592186045417] [17592186079452 #edb/ref 1061 36150 #edb/ref 17592186045417] [17592186079452 #edb/ref 1062 #uuid "4034d183-7b91-5f03-a1ca-b71ce2a3ea8c" #edb/ref 17592186045417] [17592186079452 #edb/ref 1063 #edb/ref 17592186079694 #edb/ref 17592186045417] [17592186079453 #edb/ref 1061 37242 #edb/ref 17592186045417] [17592186079453 #edb/ref 1062 #uuid "d65897aa-199d-5bb6-a05a-f5877fe63002" #edb/ref 17592186045417] [17592186079453 #edb/ref 1063 #edb/ref 17592186078528 #edb/ref 17592186045417] [17592186079454 #edb/ref 1058 #edb/ref 17592186079453 #edb/ref 17592186045417] [17592186079454 #edb/ref 1061 37341 #edb/ref 17592186045417] [17592186079454 #edb/ref 1062 #uuid "53c16c15-06ad-566b-bb58-7baf803dbf46" #edb/ref 17592186045417] [17592186079454 #edb/ref 1063 #edb/ref 17592186079695 #edb/ref 17592186045417] [17592186079455 #edb/ref 1058 #edb/ref 17592186079451 #edb/ref 17592186045417] [17592186079455 #edb/ref 1061 37364 #edb/ref 17592186045417] [17592186079455 #edb/ref 1062 #uuid "e2bd4f1a-fe61-532e-a324-4c924a280b8e" #edb/ref 17592186045417] [17592186079455 #edb/ref 1063 #edb/ref 17592186079696 #edb/ref 17592186045417] [17592186079616 #edb/ref 1064 "A **function** is a rule where *every* input value is assigned *precisely one* output value. \n\nAs an example, let's consider the rule defined by\n\n$$\nf(x) = x+3\n$$\n\nwhere $x$ can be any number from the **set** $\\{1,2,3,4\\}.$ A set is a collection of numbers we can use in our rule. \n\nLet's calculate the possible values of $f(x)\\mathbin{:}$\n\n$$\n\\begin{aligned}f(1) & =1+3=4 \\\\ f(2) & =2+3=5 \\\\ f(3) & =3+3=6 \\\\ f(4) & =4+3=7\\end{aligned}\n$$\n\nWe can represent this rule using a **mapping diagram**, like the one shown below.\n\n![](images/47/4714001592222932934cb7edd5852542a2e990e6680daad85e2db88b9c7cef47.png)\n\nThis rule *is* a function because *every* input is mapped to *precisely one* output." #edb/ref 17592186045417] [17592186079616 #edb/ref 1065 1488 #edb/ref 17592186045417] [17592186079616 #edb/ref 1066 #uuid "88ebc343-41ab-500a-8668-451bbf36ec8a" #edb/ref 17592186045417] [17592186079616 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186079694 #edb/ref 1064 "Now let's consider the rule given by the following mapping diagram:\n\n![](images/b0/b02a511f8043bb7e39df2de082befa267f795948ea6c1cc1ef38eb9df4a8cb1d.png)\n\nThis rule is *not* a function because *at least one* input is assigned to *more than one* output. In this case, the input $x=1$ is mapped to *both* $2$ and $-2.$\n\nFinally, let's consider the rule given by the following mapping diagram:\n\n![](images/be/bea4ee8835a6111e105670863edede9450ad26dbfbea631454d5c8d6cd76a6a1.png)\n\nThis rule is *not* a function because *at least one* input is not assigned to an output. In this case, the input $0$ is not assigned an output." #edb/ref 17592186045417] [17592186079694 #edb/ref 1065 5913 #edb/ref 17592186045417] [17592186079694 #edb/ref 1066 #uuid "f58c4e80-86e3-5b65-99a3-2a16208231e4" #edb/ref 17592186045417] [17592186079694 #edb/ref 1067 "Examples of Rules That Are Not Functions" #edb/ref 17592186045417] [17592186079695 #edb/ref 1064 "When a rule is represented as a table, we have a function if and only if all values in the *first row* are *distinct* (i.e., different).\n\nLet's consider some examples.\n\nThe rule defined by the following table is a function. Notice that all values in the first row are distinct. Every input value is assigned to exactly one output value.\n\n| **$x$** | $1$ | $2$ | $3$ | $4$ | $5$ | $6$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $-2$ | $2$ | $0$ | $7$ | $3$ | $0$ |\n\n \n\nOn the other hand, the rule defined by the following table is *not* a function. Notice that the first row contains the value $\\color{red}3$ twice. The input value $3$ is assigned to two output values ($0$ and $-1$).\n\n| **$x$** | $1$ | $2$ | $\\color{red}3$ | $4$ | $\\color{red}3$ | $6$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $-2$ | $2$ | $0$ | $7$ | $-1$ | $5$ |" #edb/ref 17592186045417] [17592186079695 #edb/ref 1065 6156 #edb/ref 17592186045417] [17592186079695 #edb/ref 1066 #uuid "f5d2e3d4-e985-565a-81f8-c8b8e93dc73d" #edb/ref 17592186045417] [17592186079695 #edb/ref 1067 "Rules Represented Using Tables" #edb/ref 17592186045417] [17592186079696 #edb/ref 1064 "So, we must remember that a rule is a function if and only if *every* input is mapped to *precisely one* output.\n\nIn particular, a rule is *not* a function in the following cases:\n\n- An input value is not assigned an output value. For example, the following situation is *not allowed* for functions (an input value with no arrow from it):\n\n![](images/bb/bb53865d210d631d78e5ce48aa96ecff99da8995936a085c789c3471ffb9e6a0.png)\n\n \n\n- An input value is assigned to more than one output value. For example, the following situation is *not allowed* for functions (an input value with more than one arrow from it):\n\n![](images/18/18831dc73e561faa69748fed111eb7e1024d35849fb6624594ae08d8c35301ee.png)" #edb/ref 17592186045417] [17592186079696 #edb/ref 1065 6161 #edb/ref 17592186045417] [17592186079696 #edb/ref 1066 #uuid "f92a951f-7b57-51b4-b130-bf0d4c0da4a5" #edb/ref 17592186045417] [17592186079696 #edb/ref 1067 "A Summary" #edb/ref 17592186045417]}
