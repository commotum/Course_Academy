#{[{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186415731} :activity/id #uuid "36db9557-7fc9-54f4-b4b6-8955e9493228" :activity/scope {:db/id #edb/ref 17592186048828 :topic/id #uuid "c3f4792c-c754-5f17-936f-e303d32dc1ec" :topic/math-academy-id 2153} :activity/steps [{:db/id #edb/ref 17592186415729 :step/content {:db/id #edb/ref 17592186415725 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "156086d0-2503-5c82-b028-91f343b7e73a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{21}{2}" :db/id #edb/ref 17592186415696} {:answer/id #uuid "30993290-d1c5-5870-ade3-eeb4ef4124af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186415698} {:answer/id #uuid "bbf1b2bf-a5c0-5171-bd8e-1223180f520f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186415711} {:answer/id #uuid "cde50d2f-fb95-5eb5-a443-01a9d2980ec8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186415713} {:answer/id #uuid "e9471462-224a-5e7a-ba24-d583af04b7a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186415718}] :answer-field/correct {:db/id #edb/ref 17592186415718} :answer-field/id #uuid "c5e9506e-b81e-5d67-9fbe-3864d1e26d41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415724}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "57d8c35b-1147-5bd3-8316-990de4c7a33b" :question/math-academy-id "q-74179" :question/problem "Given that $‖2u+3v‖=31$ and $‖u‖=5$, find the smallest possible value of $‖v‖.$" :question/worked-solution "Using the triangle inequality, we have that\n\n$$\n\\begin{aligned}‖2u+3v‖ & \\le ‖2u‖+‖3v‖.\\end{aligned}\n$$\n\nSimplifying and substituting in the given information, we get\n\n$$\n\\begin{aligned}‖2u+3v‖ & \\le 2‖u‖+3‖v‖ \\\\ 31 & \\le 2\\cdot 5+3‖v‖ \\\\ 31 & \\le 10+3‖v‖ \\\\ 21 & \\le 3‖v‖ \\\\ 7 & \\le ‖v‖.\\end{aligned}\n$$\n\nTherefore, the smallest possible value of $‖v‖$ is $7.$"} :step/id #uuid "4ee84374-5b1a-56bf-89ad-16da75d560fc"} {:db/id #edb/ref 17592186415730 :step/content {:db/id #edb/ref 17592186415727 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ce74aab-bfca-5322-bae2-2d0da51bd7a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186415700} {:answer/id #uuid "5672893c-0ee3-5eb9-a528-dd0e6cf6bce4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186415701} {:answer/id #uuid "d998751a-66ca-5f1e-baf9-a846a0ec5a21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186415714} {:answer/id #uuid "e31f19b4-72f1-5830-b3c0-f253b81951e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{12}{5}" :db/id #edb/ref 17592186415715} {:answer/id #uuid "e728592a-1c6f-5b05-9a2b-8013e45c8132" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{12}{7}" :db/id #edb/ref 17592186415717}] :answer-field/correct {:db/id #edb/ref 17592186415714} :answer-field/id #uuid "817282ef-3ada-5b89-8e68-36b04c516eb8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415722}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "af610309-e1d2-5541-8807-9bdfd83d138d" :question/math-academy-id "q-40199" :question/problem "If $|u\\cdot v|+‖u+v‖=17$ and $‖v‖=5$, then what is the smallest possible value of $‖u‖?$" :question/worked-solution "First, using the Cauchy-Schwarz inequality, simplifying, and substituting in the given information, we obtain\n\n$$\n\\begin{aligned}17 & =|u\\cdot v|+‖u+v‖ \\\\  & \\le ‖u‖\\cdot ‖v‖+‖u+v‖ \\\\  & =‖u‖\\cdot (5)+‖u+v‖ \\\\  & =5‖u‖+‖u+v‖.\\end{aligned}\n$$\n\nNext, using the triangle inequality, simplifying, and substituting in the given information, we have \n\n$$\n\\begin{aligned}5‖u‖+‖u+v‖ & \\le 5‖u‖+(‖u‖+‖v‖) \\\\  & =5‖u‖+(‖u‖+5) \\\\  & =6‖u‖+5.\\end{aligned}\n$$\n\nCombining the two inequalities, we get \n\n$$\n\\begin{aligned}17 & \\le 6‖u‖+5 \\\\ 12 & \\le 6‖u‖ \\\\ 2 & \\le ‖u‖.\\end{aligned}\n$$\n\nTherefore, the smallest possible value of $‖u‖$ is $2.$"} :step/id #uuid "9092880c-4d43-5d7f-b7bc-995e69b8d061" :step/next {:db/id #edb/ref 17592186415732}} {:db/id #edb/ref 17592186415731 :step/content {:db/id #edb/ref 17592186134219 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b6d3fde-771a-5115-b2e4-d45e5fbe262e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{17}{3}" :db/id #edb/ref 17592186415705} {:answer/id #uuid "99829528-d3d5-5097-917b-aac01855699f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{3}" :db/id #edb/ref 17592186415706} {:answer/id #uuid "9d5f4ab9-c551-5ee0-9d59-ad6b54f393b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186415707} {:answer/id #uuid "a818705f-7c78-5f96-b94c-90a190f0f06e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186415709} {:answer/id #uuid "bc9122b1-4a81-53c9-a84c-89c4f22de887" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186415712}] :answer-field/correct {:db/id #edb/ref 17592186415709} :answer-field/id #uuid "10d79a40-cdd8-57c4-b317-1711316d1f71" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415720}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "370f5c5a-3732-5d0b-980d-6b2fd70c961d" :question/math-academy-id "q-39437" :question/problem "If $|u\\cdot v|+‖u+v‖=14$ and $‖v‖=3$, then what is the smallest possible value of $‖u‖?$" :question/worked-solution "First, using the Cauchy-Schwarz inequality, simplifying, and substituting in the given information, we obtain\n\n$$\n\\begin{aligned}14 & =|u\\cdot v|+‖u+v‖ \\\\  & \\le ‖u‖\\cdot ‖v‖+‖u+v‖ \\\\  & =‖u‖\\cdot (3)+‖u+v‖ \\\\  & =3‖u‖+‖u+v‖.\\end{aligned}\n$$\n\nNext, using the triangle inequality, simplifying, and substituting in the given information, we have \n\n$$\n\\begin{aligned}3‖u‖+‖u+v‖ & \\le 3‖u‖+(‖u‖+‖v‖) \\\\  & =3‖u‖+(‖u‖+3) \\\\  & =4‖u‖+3.\\end{aligned}\n$$\n\nCombining the two inequalities, we get \n\n$$\n\\begin{aligned}14 & \\le 4‖u‖+3 \\\\ 11 & \\le 4‖u‖ \\\\ \\frac{11}{4} & \\le ‖u‖.\\end{aligned}\n$$\n\nTherefore, the smallest possible value of $‖u‖$ is $\\frac{11}{4}.$"} :step/id #uuid "a0ea2d0d-888f-5508-a231-99df6c592b2b" :step/next {:db/id #edb/ref 17592186415730}} {:db/id #edb/ref 17592186415732 :step/content {:db/id #edb/ref 17592186415728 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19b0761b-6b59-56aa-955b-fc84ef2adb53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\sqrt{3}" :db/id #edb/ref 17592186415697} {:answer/id #uuid "7603c20c-8d26-5763-917e-039357d1aaf8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186415703} {:answer/id #uuid "76b300e3-7eb8-59cf-83e5-d73fb173e6f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186415704} {:answer/id #uuid "e6f5526b-510a-5eee-b6fc-77fab010b251" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186415716} {:answer/id #uuid "f917a248-fc9b-5f9b-b632-e746048e9ee5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186415719}] :answer-field/correct {:db/id #edb/ref 17592186415697} :answer-field/id #uuid "841f2b8b-2201-5d6d-a34e-f4f2958c19ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415723}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c2d432f4-839e-5c1d-a878-2fb57ff814c5" :question/math-academy-id "q-74107" :question/problem "Let $u$ and $v$ be vectors such that $‖u‖=5$ and $‖\\sqrt{3}u+\\sqrt{2}v‖=15.$  If $u$ is orthogonal to $v$, find $‖v‖.$" :question/worked-solution "Since $u$ is orthogonal to $v,$ we also have that $\\sqrt{3}u$ is orthogonal to $\\sqrt{2}v.$ So, the Pythagorean theorem states that\n\n$$\n\\begin{aligned}‖\\sqrt{3}u+\\sqrt{2}v{‖}^{2} & =‖\\sqrt{3}u{‖}^{2}+‖\\sqrt{2}v{‖}^{2}.\\end{aligned}\n$$\n\nSimplifying and substituting in the given information, we get\n\n$$\n\\begin{aligned}‖\\sqrt{3}u+\\sqrt{2}v{‖}^{2} & =(\\sqrt{3}‖u‖)^{2}+(\\sqrt{2}‖v‖)^{2} \\\\ ‖\\sqrt{3}u+\\sqrt{2}v{‖}^{2} & =3‖u{‖}^{2}+2‖v{‖}^{2} \\\\ (15)^{2} & =3(5)^{2}+2‖v{‖}^{2} \\\\ 225 & =3\\cdot 25+2‖v{‖}^{2} \\\\ 225 & =75+2‖v{‖}^{2} \\\\ 150 & =2‖v{‖}^{2} \\\\ ‖v{‖}^{2} & =75\\end{aligned}\n$$\n\nTherefore, $‖v‖=5\\sqrt{3}.$"} :step/id #uuid "e9eecb7f-c678-5544-bfe8-e4de69d13094" :step/next {:db/id #edb/ref 17592186415733}} {:db/id #edb/ref 17592186415733 :step/content {:db/id #edb/ref 17592186415726 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a64e9ae-c382-510a-a1db-13e227111d61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186415695} {:answer/id #uuid "4290378e-dc77-5e96-b2d8-66972b700390" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186415699} {:answer/id #uuid "6ac9354d-f9ff-556a-857c-a28d79056375" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186415702} {:answer/id #uuid "a0e2928d-de00-514f-87ce-7432c8b5a8be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186415708} {:answer/id #uuid "bbc1096f-912c-5109-b070-6c0e654028ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186415710}] :answer-field/correct {:db/id #edb/ref 17592186415710} :answer-field/id #uuid "703d1b2a-427a-5cdd-91e4-dce607a061a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415721}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a8db01df-3c54-5aa4-9e56-66901823f72a" :question/math-academy-id "q-74178" :question/problem "Given that $‖2u+v‖=14$ and $‖u‖=3$, find the smallest possible value of $‖v‖.$" :question/worked-solution "Using the triangle inequality, we have that\n\n$$\n\\begin{aligned}‖2u+v‖ & \\le 2‖u‖+‖v‖.\\end{aligned}\n$$\n\nSimplifying and substituting in the given information, we get\n\n$$\n\\begin{aligned}‖2u+v‖ & \\le 2‖u‖+‖v‖ \\\\ 14 & \\le 2\\cdot 3+‖v‖ \\\\ 14 & \\le 6+‖v‖ \\\\ 8 & \\le ‖v‖.\\end{aligned}\n$$\n\nTherefore, the smallest possible value of $‖v‖$ is $8.$"} :step/id #uuid "edaf3e74-ae4d-5291-8b76-a12e971c33f4" :step/next {:db/id #edb/ref 17592186415729}}] :activity/title "The Pythagorean Theorem and the Triangle Inequality" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186415694}]}
