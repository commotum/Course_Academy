t: 0px; padding-top: 0.4em;\"><mjx-mi class=\"mjx-n\"></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2264\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c37\"></mjx-c></mjx-mn><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.8em 0.3em\"><mtr><mtd><mo>−</mo><mn>7</mn><mi>t</mi><mo>+</mo><mn>2</mn></mtd><mtd><mi></mi><mo>≤</mo><mo>−</mo><mn>5</mn></mtd></mtr><mtr><mtd><mo>−</mo><mn>7</mn><mi>t</mi><mo>+</mo><mn>2</mn><mo>−</mo><mn>2</mn></mtd><mtd><mi></mi><mo>≤</mo><mo>−</mo><mn>5</mn><mo>−</mo><mn>2</mn></mtd></mtr><mtr><mtd><mo>−</mo><mn>7</mn><mi>t</mi><mo>+</mo><mn>0</mn></mtd><mtd><mi></mi><mo>≤</mo><mo>−</mo><mn>7</mn></mtd></mtr><mtr><mtd><mo>−</mo><mn>7</mn><mi>t</mi></mtd><mtd><mi></mi><mo>≤</mo><mo>−</mo><mn>7</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Then, we apply the multiplication principle, dividing both sides by <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"34\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c37\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>−</mo><mn>7.</mn></math></mjx-assistive-mml></mjx-container> </p>\n<p>Remember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n<mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\