#{[{:activity/first-step {:db/id #edb/ref 17592186055602} :activity/id #uuid "d26484f6-2f5d-5b6e-8df4-eb33b5788fd7" :activity/scope {:db/id #edb/ref 17592186048673 :topic/id #uuid "b3c9ca33-97a8-546e-af44-a9a7a7a71eb5" :topic/math-academy-id 66} :activity/steps [{:db/id #edb/ref 17592186055602 :step/content {:db/id #edb/ref 17592186056012 :tutorial/content "To solve an equation like\n\n$$\n2x+4 =10\n$$\n\n, we need to apply both the addition and multiplication principles.\n\nFirst, we apply the addition principle, subtracting $4$ from both sides:\n\n$$\n\\begin{aligned} 2x+4{\\color{red}\\:-\\:4} &=10{\\color{red}\\:-\\:4} \\\\ 2x+0&=6 \\\\ 2x &=6 \\end{aligned}\n$$\n\nSecond, we apply the multiplication principle, dividing both sides by $2$:\n\n$$\n\\require{cancel} \\begin{aligned} \\dfrac{2x}{\\color{red}2} &=\\dfrac{6}{\\color{red}2}\\ \\dfrac{\\cancel{2}x}{\\cancel{\\color{red}2}} &= 3 \\\\ x &=3 \\end{aligned}\n$$\n\nSo $x=3$ is our solution. Let's plug this back into the original equation, to be sure that it's correct.\n\n$$\n\\begin{aligned}\n2x + 4 &= 10 \\\\\n2 \\cdot 3 + 4 &= 10 \\\\\n6 + 4 &= 10 \\\\\n10 &= 10✓\n\\end{aligned}\n$$\n\n**Note:** When solving these types of equations, we always apply the addition principle first, and the multiplication principle second." :tutorial/id #uuid "f8f52cdf-9de7-5b27-addc-4bc35612fa15" :tutorial/math-academy-id 8055 :tutorial/title "Introduction"} :step/id #uuid "362ed182-60db-5089-b1e6-79bd2e6be30b" :step/math-academy-id 175799 :step/next {:db/id #edb/ref 17592186055603}} {:db/id #edb/ref 17592186055603 :step/content {:db/id #edb/ref 17592186054654 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054384 :question/id #uuid "8955a3ce-a161-5dc5-8ec0-c357a0403b46" :question/math-academy-id "e-12862"} :knowledge-point/id #uuid "b170bf27-76bc-5558-9133-e81a4760072f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048725} {:db/id #edb/ref 17592186050613}] :knowledge-point/questions [{:db/id #edb/ref 17592186054941} {:db/id #edb/ref 17592186055056} {:db/id #edb/ref 17592186055227}] :knowledge-point/title "Solving Linear Equations that Involve Multiplication"} :step/id #uuid "80f9fb5b-00db-570c-a6f4-98191654603b" :step/math-academy-id 175800 :step/next {:db/id #edb/ref 17592186055604}} {:db/id #edb/ref 17592186055604 :step/content {:db/id #edb/ref 17592186054655 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054385 :question/id #uuid "074b5213-4f4e-5d1b-a5c4-8b5403901b4d" :question/math-academy-id "e-12863"} :knowledge-point/id #uuid "52c2b31a-9b7a-52cb-9fa7-111de8bc53ea" :knowledge-point/questions [{:db/id #edb/ref 17592186055057} {:db/id #edb/ref 17592186055058} {:db/id #edb/ref 17592186055059} {:db/id #edb/ref 17592186055279}] :knowledge-point/title "Solving Linear Equations while Keeping the Variable on the Right-Hand Side"} :step/id #uuid "14f3a665-daa8-52a3-ae20-e94b27c5c513" :step/math-academy-id 175804 :step/next {:db/id #edb/ref 17592186055605}} {:db/id #edb/ref 17592186055605 :step/content {:db/id #edb/ref 17592186056013 :tutorial/content "Solving equations with both the addition and multiplication principles can be a lot of work. There are often many steps to write down. However, we don't have to write down all of the steps.\n\nFor example, when using the multiplication principle to solve\n\n$$\n\\dfrac{y}{2} = 5\n$$\n\nthe set of full steps are as follows:\n\n$$\n\\begin{aligned}\n\\frac{y}{2} &= 5 \\\\\n2 \\cdot \\frac{y}{2} &= 2 \\cdot 5 \\\\\n\\frac{2y}{2} &= 10 \\\\\n\\frac{2y}{2} &= 10 \\\\\ny &= 10\n\\end{aligned}\n$$\n\nHowever, if we cancel out the $2$'s to indicate that they disappear, then we can skip writing down several of the steps.\n\n$$\n\\begin{aligned}\n\\frac{y}{2} &= 5 \\\\\n2 \\cdot \\frac{y}{2} &= 2 \\cdot 5 \\\\\ny &= 10\n\\end{aligned}\n$$" :tutorial/id #uuid "f3b97f5f-3831-50b9-bb82-d4f1b7b6f8c0" :tutorial/math-academy-id 8056 :tutorial/title "Cancellation Notation"} :step/id #uuid "3130b1e1-9a50-5105-90e9-828c84b859a6" :step/math-academy-id 175809 :step/next {:db/id #edb/ref 17592186055606}} {:db/id #edb/ref 17592186055606 :step/content {:db/id #edb/ref 17592186054656 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054386 :question/id #uuid "1f5b9030-a5de-5ac2-95c4-2fbaf638cdab" :question/math-academy-id "e-12864"} :knowledge-point/id #uuid "ac53e171-0a02-5b74-8a3a-465dbecda9d7" :knowledge-point/questions [{:db/id #edb/ref 17592186055178} {:db/id #edb/ref 17592186055273}] :knowledge-point/title "Solving Linear Equations that Involve Division"} :step/id #uuid "827a7c9f-0805-5567-b393-4e871523a84e" :step/math-academy-id 175810 :step/next {:db/id #edb/ref 17592186055607}} {:db/id #edb/ref 17592186055607 :step/content {:db/id #edb/ref 17592186054657 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054387 :question/id #uuid "6ed7ae7f-2591-5747-9fa0-933260aaaebf" :question/math-academy-id "e-12866"} :knowledge-point/id #uuid "82077653-3463-5132-b0a9-8376fdb47319" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050637}] :knowledge-point/questions [{:db/id #edb/ref 17592186055179} {:db/id #edb/ref 17592186055421}] :knowledge-point/title "Solving Linear Equations that Involve Fractions"} :step/id #uuid "df8a8dfe-a623-5ae2-b654-42325ba5b869" :step/math-academy-id 175813}] :activity/title "Solving Two-Step Equations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054918}]}
