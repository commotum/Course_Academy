f 17592186045417] [17592186486302 #edb/ref 1079 #uuid "990fc942-5942-5a32-a9d4-3cfed01570f8" #edb/ref 17592186045417] [17592186486310 #edb/ref 1075 #edb/ref 17592186486106 #edb/ref 17592186045417] [17592186486310 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186486310 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186486310 #edb/ref 1078 #edb/ref 17592186486106 #edb/ref 17592186045417] [17592186486310 #edb/ref 1079 #uuid "ada292af-bf5d-5b1f-b7aa-b319a67479c5" #edb/ref 17592186045417] [17592186486326 #edb/ref 1075 #edb/ref 17592186486061 #edb/ref 17592186045417] [17592186486326 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186486326 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186486326 #edb/ref 1078 #edb/ref 17592186486061 #edb/ref 17592186045417] [17592186486326 #edb/ref 1079 #uuid "d71f5583-5918-5550-9ce3-fae2e571455e" #edb/ref 17592186045417] [17592186486386 #edb/ref 1068 #edb/ref 17592186486250 #edb/ref 17592186045417] [17592186486386 #edb/ref 1069 "q-175704" #edb/ref 17592186045417] [17592186486386 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186486386 #edb/ref 1071 "If $23=3+5x,$ then $x=${{field-1}}." #edb/ref 17592186045417] [17592186486386 #edb/ref 1072 #uuid "5a23d8ac-15ec-5a10-9024-19b8ee7d9529" #edb/ref 17592186045417] [17592186486386 #edb/ref 1074 "To save time, we will keep the variable on the right-hand side as we solve. First, we rewrite the right-hand side by placing the term containing the variable first:\n\n$$\n\\begin{aligned}23 & =3+5x \\\\ 23 & =5x+3\\end{aligned}\n$$\n\nNext, we apply the addition principle, subtracting $3$ from both sides:\n\n$$\n\\begin{aligned}23 & =5x+3 \\\\ 23-3 & =5x+3-3 \\\\ 20 & =5x+0 \\\\ 20 & =5x\\end{aligned}\n$$\n\nNext, we apply the multiplication principle, dividing both sides by $5:$\n\n$$\n\\begin{aligned}20 & =5x \\\\ \\frac{20}{5} & =\\frac{5x}{5} \\\\ 4 & =\\frac{\\cancel{5}x}{\\cancel{5}} \\\\ 4 & =x\\end{aligned}\n$$\n\nSince $4=x,$ we conclude that the solution is $x=4.$" #edb/ref 17592186045417] [17592186486391 #edb/ref 1068 #edb/ref 17592186486247 #edb/ref 17592186045417] [17592186486391 #edb/ref 1069 "q-177723" #edb/ref 17592186045417] [17592186486391 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186486391 #edb/ref 1071 "If $-x+9=7$, then $x=${{field-1}}." #edb/ref 17592186045417] [17592186486391 #edb/ref 1072 #uuid "601f830e-c315-59b5-a69c-03f1a29eaaa7" #edb/ref 17592186045417] [17592186486391 #edb/ref 1074 "First, we apply the addition principle, subtracting $9$ from both sides:\n\n$$\n\\begin{aligned}-x+9 & =7 \\\\ -x+9-9 & =7-9 \\\\ -x+0 & =-2 \\\\ -x & =-2\\end{aligned}\n$$\n\nSecond, we apply the multiplication principle. We multiply by $-1$ to get rid of the negative sign.\n\n$$\n\\begin{aligned}-x & =-2 \\\\ (-1)\\cdot (-x) & =(-1)\\cdot (-2) \\\\ x & =2\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186486394 #edb/ref 1068 #edb/ref 17592186486310 #edb/ref 17592186045417] [17592186486394 #edb/ref 1069 "q-177743" #edb/ref 17592186045417] [17592186486394 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186486394 #edb/ref 1071 "If $\\frac{1}{7}x-5=-4,$ then $x=${{field-1}}." #edb/ref 17592186045417] [17592186486394 #edb/ref 1072 #uuid "6c613ffa-a60b-5471-88b3-f5e630584f18" #edb/ref 17592186045417] [17592186486394 #edb/ref 1074 "First, we apply the addition principle, adding $5$ to both sides:\n\n$$\n\\begin{aligned}\\frac{1}{7}x-5 & =-4 \\\\ \\frac{1}{7}x-5+5 & =-4+5 \\\\ \\frac{1}{7}x+0 & =1 \\\\ \\frac{1}{7}x & =1\\end{aligned}\n$$\n\nSecond, we apply the multiplication principle, multiplying both sides by $7:$\n\n$$\n\\begin{aligned}\\frac{1}{7}x & =1 \\\\ \\cancel{7}\\cdot \\frac{1}{\\cancel{7}}x & =7\\cdot 1 \\\\ x & =7\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186486396 #edb/ref 1068 #edb/ref 17592186486326 #edb/ref 17592186045417] [17592186486396 #edb/ref 1069 "q-175715" #edb/ref 17592186045417] [17592186486396 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186486396 #edb/ref 1071 "If $\\frac{x}{2}-3=-\\frac{1}{3},$ then $x=${{field-1}}." #edb/ref 17592186045417] [17592186486396 #edb/ref 1072 #uuid "70ef95c9-ed21-5658-8a26-f0325d14f5de" #edb/ref 17592186045417] [17592186486396 #edb/ref 1074 "First, we apply the addition principle, adding $3$ to both sides of the equation:\n\n$$\n\\begin{aligned}\\frac{x}{2}-3 & =-\\frac{1}{3} \\\\ \\frac{x}{2}-3+3 & =-\\frac{1}{3}+3 \\\\ \\frac{x}{2}+0 & =-\\frac{1}{3}+\\frac{9}{3} \\\\ \\frac{x}{2} & =\\frac{8}{3}\\end{aligned}\n$$\n\nThen, we apply the multiplication principle, multiplying both sides of the equation by $2:$\n\n$$\n\\begin{aligned}\\frac{x}{2} & =\\frac{8}{3} \\\\ \\cancel{2}\\cdot \\frac{x}{\\cancel{2}} & =2\\cdot \\frac{8}{3} \\\\ x & =\\frac{16}{3}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186486398 #edb/ref 1068 #edb/ref 17592186486302 #edb/ref 17592186045417] [17592186486398 #edb/ref 1069 "q-175711" #edb/ref 17592186045417] [17592186486398 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186486398 #edb/ref 1071 "If $\\frac{1}{2}x-3=7,$ then $x=${{field-1}}." #edb/ref 17592186045417] [17592186486398 #edb/ref 1072 #uuid "72bfe419-b757-596f-a22c-c1bac378d986" #edb/ref 17592186045417] [17592186486398 #edb/ref 1074 "First, we apply the addition principle, adding $3$ to both sides:\n\n$$\n\\begin{aligned}\\frac{1}{2}x-3 & =7 \\\\ \\frac{1}{2}x-3+3 & =7+3 \\\\ \\frac{1}{2}x+0 & =10 \\\\ \\frac{1}{2}x & =10\\end{aligned}\n$$\n\nSecond, we apply the multiplication principle, multiplying both sides by $2:$\n\n$$\n\\begin{aligned}\\frac{1}{2}x & =10 \\\\ \\cancel{2}\\cdot \\frac{1}{\\cancel{2}}x & =2\\cdot 10 \\\\ x & =20\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186486411 #edb/ref 1068 #edb/ref 17592186486246 #edb/ref 17592186045417] [17592186486411 #edb/ref 1069 "q-175701" #edb/ref 17592186045417] [17592186486411 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186486411 #edb/ref 1071 "If $-2y-6=10$, then $y=${{field-1}}." #edb/ref 17592186045417] [17592186486411 #edb/ref 1072 #uuid "8eb9e3bf-e422-579f-aaa8-f647ba12c4ce" #edb/ref 17592186045417] [17592186486411 #edb/ref 1074 "First, we apply the addition principle, adding $6$ to both sides:\n\n$$\n\\begin{aligned}-2y-6 & =10 \\\\ -2y-6+6 & =10+6 \\\\ -2y+0 & =16 \\\\ -2y & =16\\end{aligned}\n$$\n\nSecond, we apply the multiplication principle, dividing both sides by $-2:$\n\n$$\n\\begin{aligned}-2y & =16 \\\\ \\frac{-2y}{-2} & =\\frac{16}{-2} \\\\ \\frac{\\cancel{-2}y}{\\cancel{-2}} & =-8 \\\\ y & =-8\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186486417 #edb/ref 1068 #edb/ref 17592186486300 #edb/ref 17592186045417] [17592186486417 #edb/ref 1069 "q-58208" #edb/ref 17592186045417] [17592186486417 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186486417 #edb/ref 1071 "Solve for $y$ where $16=3y+1.$" #edb/ref 17592186045417] [17592186486417 #edb/ref 1072 #uuid "981f6277-663e-5d5c-beb0-98c4f0b0b4d5" #edb/ref 17592186045417] [17592186486417 #edb/ref 1074 "To save time, we will keep the variable on the right-hand side as we solve. First, we apply the addition principle, subtracting $1$ from both sides:\n\n$$\n\\begin{aligned}16 & =3y+1 \\\\ 16-1 & =3y+1-1 \\\\ 15 & =3y+0 \\\\ 15 & =3y\\end{aligned}\n$$\n\nSecond, we apply the multiplication principle, dividing both sides by $3:$\n\n$$\n\\begin{aligned}15 & =3y \\\\ \\frac{15}{3} & =\\frac{3y}{3} \\\\ 5 & =\\frac{\\cancel{3}y}{\\cancel{3}} \\\\ 5 & =y\\end{aligned}\n$$\n\nSince $5=y,$ we conclude that the solution is $y=5.$" #edb/ref 17592186045417]}
