#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186106548} :activity/id #uuid "53739364-ab76-5f6a-9987-a1e5894cdc33" :activity/scope {:db/id #edb/ref 17592186049856 :topic/id #uuid "18feb129-7dac-5ab9-b065-23e4f689ee98" :topic/math-academy-id 1404} :activity/steps [{:db/id #edb/ref 17592186106548 :step/content {:db/id #edb/ref 17592186107061 :tutorial/content "Let $O$ be a point on the plane. Let's consider all the points on the plane whose distance to $O$ is equal to $5\\,\\textrm{cm}.$\n\n![](images/ba/ba0fc787b4469b0322fa46fa072d58ae163e24dea284f3e5507306e9b30dfbf3.png)\n\nThe collection of all such points defines a geometrical shape which is called a **circle**. \n\n- The point $O$ is called the **center** of the circle.\n\n- The distance from $O$ to any point on the circle is called the **radius**.\n\nIn our diagram above, the radius is $r={\\color{black}5\\,\\textrm{cm}}.$" :tutorial/id #uuid "a53c8e3d-2c5a-558c-912f-f2e051ef7b41" :tutorial/math-academy-id 2417 :tutorial/title "Introduction"} :step/id #uuid "9812b925-7461-5557-92e8-1ff7d3367b95" :step/math-academy-id 10836 :step/next {:db/id #edb/ref 17592186106550}} {:db/id #edb/ref 17592186106549 :step/content {:db/id #edb/ref 17592186105693 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105557 :question/id #uuid "2b2211b8-cc3f-5dd6-9dc0-1dc1a7f69513" :question/math-academy-id "e-3166"} :knowledge-point/id #uuid "82c825b9-fc36-510c-982e-e4596ab2ce24" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050519}] :knowledge-point/questions [{:db/id #edb/ref 17592186106160} {:db/id #edb/ref 17592186106161} {:db/id #edb/ref 17592186497339} {:db/id #edb/ref 17592186497367}] :knowledge-point/title "Identifying True Statements About the Distance to a Circle's Center"} :step/id #uuid "16717d1c-e42a-524b-915d-835d1e83173b" :step/math-academy-id 10837 :step/next {:db/id #edb/ref 17592186106551}} {:db/id #edb/ref 17592186106550 :step/content {:db/id #edb/ref 17592186105694 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105558 :question/id #uuid "9e6ebec8-4c08-5bc9-8a8c-4c6cedb2bd8e" :question/math-academy-id "e-3167"} :knowledge-point/id #uuid "8fa963eb-82a7-56cb-a8b8-f9291adec2d0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050505}] :knowledge-point/questions [{:db/id #edb/ref 17592186106162} {:db/id #edb/ref 17592186106163} {:db/id #edb/ref 17592186497369} {:db/id #edb/ref 17592186497412}] :knowledge-point/title "Calculating the Length of a Line Segment With Endpoints on a Circle and Passing Through the Center"} :step/id #uuid "432ff13e-3f9e-5ca8-8549-971f7f9795b1" :step/math-academy-id 10838 :step/next {:db/id #edb/ref 17592186106549}} {:db/id #edb/ref 17592186106551 :step/content {:db/id #edb/ref 17592186107062 :tutorial/content "There are three important line segments associated with a circle:\n\n- A **radius** is any line segment that connects a point on the circle with the center (left-hand diagram).\n\n- A **chord** is any line segment whose endpoints lie on the circle (middle diagram).\n\n- A **diameter** is any chord that passes through the center of the circle (right-hand diagram). The diameter is the longest chord and its measure is twice the radius of the circle:\n\n$$\nd = 2r.\n$$\n\n![](images/7f/7f12a9db3210054e64397e26c87fd57ce4e55ff5dc9a2ed0d3b0ce3a8f9c2e65.png)" :tutorial/id #uuid "bcbdf407-5fe9-57d7-9359-167f8fbf21b0" :tutorial/math-academy-id 2418 :tutorial/title "Chords and Diameters"} :step/id #uuid "7fb8225e-7462-53e8-804b-4a3bdd2a3605" :step/math-academy-id 10839 :step/next {:db/id #edb/ref 17592186106552}} {:db/id #edb/ref 17592186106552 :step/content {:db/id #edb/ref 17592186105695 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105559 :question/id #uuid "cb990fba-991a-58c8-a404-54353183903c" :question/math-academy-id "e-3168"} :knowledge-point/id #uuid "2401d489-0970-54a8-a70d-9e8613458f54" :knowledge-point/questions [{:db/id #edb/ref 17592186106421} {:db/id #edb/ref 17592186106422} {:db/id #edb/ref 17592186497398}] :knowledge-point/title "Identifying True Statements About Line Segments Associated with a Circle"} :step/id #uuid "7ea7aa1c-cdcf-5530-838a-3d3d9f236858" :step/math-academy-id 10840}] :activity/title "Circles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186106022}]}
