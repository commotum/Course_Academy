#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186543665} :activity/id #uuid "3569f6ba-b87a-5a2f-8057-ba70663084b5" :activity/scope {:db/id #edb/ref 17592186050711 :topic/id #uuid "608cf86b-83ea-5cc3-a6a8-222e7fa44e21" :topic/math-academy-id 332} :activity/steps [{:db/id #edb/ref 17592186543646 :step/content {:db/id #edb/ref 17592186543476 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5794d662-7689-53db-beb1-12960e04eb76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-1" :db/id #edb/ref 17592186542878} {:answer/id #uuid "9baf83f0-5754-547b-8165-594f9fd2fc98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=1" :db/id #edb/ref 17592186543048} {:answer/id #uuid "a7446308-87a4-557c-81d1-2285139a39b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{1}{2}" :db/id #edb/ref 17592186543079} {:answer/id #uuid "f094f3a8-968e-548f-a10e-1ed224acebba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=0" :db/id #edb/ref 17592186543255} {:answer/id #uuid "fb519e52-9aba-525a-a842-402c8e22792e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-\\frac{1}{2}" :db/id #edb/ref 17592186543282}] :answer-field/correct {:db/id #edb/ref 17592186543079} :answer-field/id #uuid "094ecf41-887a-52fa-b0d5-b36a3c36a651" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543297}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0be8176c-dc51-5ee3-ab7e-f7738c95222f" :question/math-academy-id "q-102233" :question/problem "Find the $x$-coordinate of the point on the curve $y=2{x}^{2}-2$ whose tangent has a slope of $2.$" :question/worked-solution "Let $f(x)=2{x}^{2}-2.$ The slope of the tangent at the point $x$ is equal to ${f}^{′}(x).$ Computing the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}-2) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}({x}^{2})-2\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =2\\cdot 2x-0 \\\\  & =4x.\\end{aligned}\n$$\n\nWe now set ${f}^{′}(x)=2$ and solve for $x:$\n\n$$\n\\begin{aligned}4x & =2 \\\\ x & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the slope of the tangent is equal to $2$ at the point where $x=\\frac{1}{2}.$"} :step/id #uuid "87574386-7278-5570-801f-5b8e5dcb3e31" :step/next {:db/id #edb/ref 17592186543671}} {:db/id #edb/ref 17592186543665 :step/content {:db/id #edb/ref 17592186338791 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14183076-e4e9-584e-85d9-0fab9fcaf7c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186336222} {:answer/id #uuid "416a71dd-2646-5a15-8c7b-e8a83a098192" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186336647} {:answer/id #uuid "52ec3a1a-c5fa-5960-b678-90f06671ff4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{13}{2}" :db/id #edb/ref 17592186336797} {:answer/id #uuid "977a6ce2-aa5c-58cc-90c8-0039b34bef55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{13}{2}" :db/id #edb/ref 17592186337415} {:answer/id #uuid "b8fe1893-7cc5-52a3-9333-bf2bf2cd5d48" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186337672}] :answer-field/correct {:db/id #edb/ref 17592186337415} :answer-field/id #uuid "fa4297b1-164a-5f37-8ca3-7680334615bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338719}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d3a3c2de-1ea3-53e2-8e76-3b3c148c99ef" :question/math-academy-id "q-70535" :question/problem "What is the slope of the tangent to the curve $y={x}^{2}-3x+6\\sqrt{x}$ at the point $(4,16)?$" :question/worked-solution "This time, we'll use $\\frac{\\text{d}y}{\\text{d}x}$ notation. First, we compute the derivative, which gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}-3x+6\\sqrt{x}) \\\\  & =2\\cdot x-3+\\frac{1}{2}\\cdot 6{x}^{-1/2} \\\\  & =2x-3+3{x}^{-1/2}.\\end{aligned}\n$$\n\nEvaluating at $x=4$ gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=4} & =2(4)-3+3(4)^{-1/2} \\\\  & =8-3+\\frac{3}{2} \\\\  & =\\frac{13}{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent to the curve is $\\frac{13}{2}.$"} :step/id #uuid "cdb8e701-19ba-5bf1-ba79-29323210d65f" :step/next {:db/id #edb/ref 17592186543646}} {:db/id #edb/ref 17592186543671 :step/content {:db/id #edb/ref 17592186543488 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a824279-061f-59cf-8233-230d9112721b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=1" :db/id #edb/ref 17592186542662} {:answer/id #uuid "299aeade-76b6-5ac3-aa72-60ecdf13731f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-2" :db/id #edb/ref 17592186542750} {:answer/id #uuid "4320d5f8-7a4f-596c-be19-d15d507a9187" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=0" :db/id #edb/ref 17592186542822} {:answer/id #uuid "9983f911-3be7-5a6a-8784-20b49fb6c9e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-1" :db/id #edb/ref 17592186543040} {:answer/id #uuid "a7d765ac-42fd-591b-b679-f617197ee035" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=2" :db/id #edb/ref 17592186543082}] :answer-field/correct {:db/id #edb/ref 17592186542750} :answer-field/id #uuid "1a6aec05-611b-57f6-bad9-be06a48060a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543305}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2d253a70-5faa-50fb-9a2a-215f206560d5" :question/math-academy-id "q-102235" :question/problem "Find the $x$-coordinate of the point on the curve $y={x}^{2}+2x+1$ whose tangent has a slope of $-2.$" :question/worked-solution "Let $f(x)={x}^{2}+2x+1.$ The slope of the tangent at the point $x$ is equal to ${f}^{′}(x).$ Computing the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}+2x+1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})+2\\frac{\\text{d}}{\\text{d}x}(x)+\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =2x+2\\cdot 1+0 \\\\  & =2x+2.\\end{aligned}\n$$\n\nWe now set ${f}^{′}(x)=-2$ and solve for $x:$\n\n$$\n\\begin{aligned}2x+2 & =-2 \\\\ 2x & =-2-2 \\\\ 2x & =-4 \\\\ x & =-2\\end{aligned}\n$$\n\nTherefore, the slope of the tangent is equal to $-2$ at the point where $x=-2.$"} :step/id #uuid "ea9c14e4-8840-532c-b073-86c61c6e8b49"}] :activity/title "Calculating the Slope of a Tangent Line Using Differentiation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186542617}]}
