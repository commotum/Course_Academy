#{[{:db/id #edb/ref 17592186338791 :knowledge-point/_questions [{:db/id #edb/ref 17592186064343 :knowledge-point/id #uuid "3ca13570-d504-53e6-8e02-0f1e85047a3e" :knowledge-point/title "Calculating the Slope of a Tangent Line of a Curve With Fractional Powers at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14183076-e4e9-584e-85d9-0fab9fcaf7c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186336222} {:answer/id #uuid "416a71dd-2646-5a15-8c7b-e8a83a098192" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186336647} {:answer/id #uuid "52ec3a1a-c5fa-5960-b678-90f06671ff4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{13}{2}" :db/id #edb/ref 17592186336797} {:answer/id #uuid "977a6ce2-aa5c-58cc-90c8-0039b34bef55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{2}" :db/id #edb/ref 17592186337415} {:answer/id #uuid "b8fe1893-7cc5-52a3-9333-bf2bf2cd5d48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186337672}] :answer-field/correct {:answer/id #uuid "977a6ce2-aa5c-58cc-90c8-0039b34bef55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{2}" :db/id #edb/ref 17592186337415} :answer-field/id #uuid "fa4297b1-164a-5f37-8ca3-7680334615bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338719}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d3a3c2de-1ea3-53e2-8e76-3b3c148c99ef" :question/math-academy-id "q-70535" :question/problem "What is the slope of the tangent to the curve $y={x}^{2}-3x+6\\sqrt{x}$ at the point $(4,16)?$" :question/worked-solution "This time, we'll use $\\frac{\\text{d}y}{\\text{d}x}$ notation. First, we compute the derivative, which gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}-3x+6\\sqrt{x}) \\\\  & =2\\cdot x-3+\\frac{1}{2}\\cdot 6{x}^{-1/2} \\\\  & =2x-3+3{x}^{-1/2}.\\end{aligned}\n$$\n\nEvaluating at $x=4$ gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=4} & =2(4)-3+3(4{)}^{-1/2} \\\\  & =8-3+\\frac{3}{2} \\\\  & =\\frac{13}{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent to the curve is $\\frac{13}{2}.$"}]}
