      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14193272/observations/step-q37783-0387be5134f395d9af10.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14193272/observations/step-q37783-0387be5134f395d9af10.png",
      "source_url": "https://mathacademy.com/tasks/14193272/topics/1888/lesson",
      "captured_at": 1791941389.2706258,
      "math_academy_id": "q-37783",
