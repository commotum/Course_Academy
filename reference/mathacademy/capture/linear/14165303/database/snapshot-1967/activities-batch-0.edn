#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186065097} :activity/id #uuid "0292b7a3-d5c9-54a7-ba7c-938624bcc457" :activity/scope {:db/id #edb/ref 17592186049847 :topic/id #uuid "18636612-788d-519b-97ca-16774367f5ac" :topic/math-academy-id 360} :activity/steps [{:db/id #edb/ref 17592186065097 :step/content {:db/id #edb/ref 17592186065441 :tutorial/content "When we want to calculate the **square of a binomial**, like\n\n$$\n(a+b)^2,\n$$\n\nthere's a formula that we can use instead of working out the product $(a+b)(a+b)$ manually. The formula is\n\n$$\n(a + b)^2 = a^2 + 2ab + b^2.\n$$\n\nIt might be helpful to remember this as *\"the square of the first term, plus the square of the second term, plus twice the product.\"*\n\nSuppose we need to calculate the square $(x+3)^2.$ In this case, we have $a= x$ and $b=3.$ We substitute into the formula and simplify:\n\n$$\n\\begin{aligned}(x+3)^{2} & = \\\\ (x)^{2}+2(x)(3)+(3)^{2} & = \\\\ {x}^{2}+6x+9 & \\end{aligned}\n$$\n\nWe can check that the formula gives the correct result by working out the multiplication manually:\n\n$$\n\\eqalign{\n\t\t(x + 3)^2 &= \\[3pt]\n\t\t(x + 3)(x + 3) &= \\[3pt]\n\t\tx(x + 3) + 3(x + 3) &= \\[3pt]\n\t\tx^2 + 3x + 3x + 9 &= \\[3pt]\n\t\tx^2 + 6x + 9 &\\, {\\color{green}{\\checkmark}}\n\t}\n$$\n\nSo we get the same result! But by using the formula, we save a lot of time and effort." :tutorial/id #uuid "0266d886-b5db-53fe-bc51-f6486beb6eef" :tutorial/math-academy-id 8878 :tutorial/title "Introduction"} :step/id #uuid "ee3a0134-3957-5b1c-b05a-a30af1c8709d" :step/math-academy-id 170779 :step/next {:db/id #edb/ref 17592186065098}} {:db/id #edb/ref 17592186065098 :step/content {:db/id #edb/ref 17592186064232 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063991 :question/id #uuid "70f19ea4-d0b8-537a-8ae4-06a236cf37cf" :question/math-academy-id "e-14318"} :knowledge-point/id #uuid "288c08af-0583-5588-b767-4254544cf70c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050818}] :knowledge-point/questions [{:db/id #edb/ref 17592186064590} {:db/id #edb/ref 17592186064678} {:db/id #edb/ref 17592186064749} {:db/id #edb/ref 17592186482538} {:db/id #edb/ref 17592186482578}] :knowledge-point/title "Squaring Linear Binomials"} :step/id #uuid "39924b31-d2c9-5359-be1b-3c04f7ad4699" :step/math-academy-id 170780 :step/next {:db/id #edb/ref 17592186065099}} {:db/id #edb/ref 17592186065099 :step/content {:db/id #edb/ref 17592186064233 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063992 :question/id #uuid "c1a6df9e-b1e8-51c8-b5df-4cc624e14193" :question/math-academy-id "e-14319"} :knowledge-point/id #uuid "63291c46-6a0f-5e7c-ab0a-acba80fe58f3" :knowledge-point/questions [{:db/id #edb/ref 17592186064592} {:db/id #edb/ref 17592186064593} {:db/id #edb/ref 17592186064729} {:db/id #edb/ref 17592186482519} {:db/id #edb/ref 17592186482545} {:db/id #edb/ref 17592186482593} {:db/id #edb/ref 17592186482604} {:db/id #edb/ref 17592186490286} {:db/id #edb/ref 17592186490303}] :knowledge-point/title "Squaring Nonlinear Binomials"} :step/id #uuid "9b092f72-50ae-5b82-96c3-f01cc623e041" :step/math-academy-id 170784 :step/next {:db/id #edb/ref 17592186065100}} {:db/id #edb/ref 17592186065100 :step/content {:db/id #edb/ref 17592186065442 :tutorial/content "So far, we've been using the formula for the square of a binomial involving addition:\n\n$$\n(a + b)^2 = a^2 + 2ab + b^2\n$$\n\nThere is also a similar formula that we can use to compute the square of a binomial involving subtraction. The formula is\n\n$$\n(a - b)^2 = a^2 - 2ab + b^2.\n$$\n\nFor example, to compute the square $(x-3)^2,$ we can substitute $a=x$ and $b=3$ into the formula and simplify:\n\n$$\n\\begin{aligned}(x-3)^{2} & = \\\\ (x)^{2}-2(x)(3)+(3)^{2} & = \\\\ {x}^{2}-6x+9 & \\end{aligned}\n$$\n\nWe can check that the formula gives the correct result by working out the multiplication manually:\n\n$$\n\\eqalign{\n\t\t(x - 3)^2 &= \\\n\t\t(x - 3)(x - 3) &= \\\n\t\tx(x - 3) - 3(x - 3) &= \\\n\t\tx^2 - 3x - 3x + 9 &= \\\n\t\tx^2 - 6x + 9 &\\, {\\color{green}{\\checkmark}}\n\t}\n$$\n\nAgain, we get the same result." :tutorial/id #uuid "e42b96f5-ca3b-588b-8931-106b975bd0ac" :tutorial/math-academy-id 8879 :tutorial/title "Binomials With Subtraction"} :step/id #uuid "13d60779-951a-5265-8019-e1ca3444406c" :step/math-academy-id 170788 :step/next {:db/id #edb/ref 17592186065101}} {:db/id #edb/ref 17592186065101 :step/content {:db/id #edb/ref 17592186064234 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063993 :question/id #uuid "487f1c4c-63c9-51cf-9a0e-7d9bc0a4c7c7" :question/math-academy-id "e-14320"} :knowledge-point/id #uuid "afd30bc7-dce9-5e03-a213-2b9695e39091" :knowledge-point/questions [{:db/id #edb/ref 17592186064591} {:db/id #edb/ref 17592186064594} {:db/id #edb/ref 17592186064679} {:db/id #edb/ref 17592186482554} {:db/id #edb/ref 17592186482594} {:db/id #edb/ref 17592186490227}] :knowledge-point/title "Squaring Binomials With Subtraction"} :step/id #uuid "2fb2e377-ee0a-5a7e-a9fc-c5e5d9b5786a" :step/math-academy-id 170789}] :activity/title "Squaring Binomials" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064447}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186490377} :activity/id #uuid "2067b6ed-7ec5-593e-ba9b-4ee8e220676e" :activity/scope {:db/id #edb/ref 17592186049847 :topic/id #uuid "18636612-788d-519b-97ca-16774367f5ac" :topic/math-academy-id 360} :activity/steps [{:db/id #edb/ref 17592186490339 :step/content {:db/id #edb/ref 17592186490286 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d65759d-e36d-5045-acc5-db2984da989f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{9}+{x}^{2}" :db/id #edb/ref 17592186489544} {:answer/id #uuid "174ed3f2-66bc-5124-aa00-570861734082" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{9}+\\frac{1}{3}{x}^{2}+{x}^{2}" :db/id #edb/ref 17592186489567} {:answer/id #uuid "84c7c962-da54-5750-9444-176e8e186f3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{9}+\\frac{2}{3}{x}^{2}+{x}^{4}" :db/id #edb/ref 17592186489819} {:answer/id #uuid "ea56582c-7d40-5467-bb1c-047ef74db56a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{9}+{x}^{4}" :db/id #edb/ref 17592186490023} {:answer/id #uuid "f2c7773c-a23f-5f60-a9f6-ea4c2e71ce2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{9}+\\frac{2}{3}{x}^{2}+{x}^{2}" :db/id #edb/ref 17592186490037}] :answer-field/correct {:db/id #edb/ref 17592186489819} :answer-field/id #uuid "1248bc9c-da8e-5444-ae7b-ffd4127ab86f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490084}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a62d676a-9c38-5dd1-a066-72e04e4e8a97" :question/math-academy-id "q-33095" :question/problem "${(\\frac{1}{3}+{x}^{2})}^{2}=$" :question/worked-solution "We will use the following formula:\n\n$$\n(a+b)^{2}={a}^{2}+2ab+{b}^{2}\n$$\n\nSubstituting $a=\\frac{1}{3}$ and $b={x}^{2},$ we have\n\n$$\n\\begin{aligned}{(\\frac{1}{3}+{x}^{2})}^{2} & = \\\\ {(\\frac{1}{3})}^{2}+2(\\frac{1}{3})({x}^{2})+{({x}^{2})}^{2} & = \\\\ \\frac{1}{9}+\\frac{2}{3}{x}^{2}+{x}^{4}.\\end{aligned}\n$$"} :step/id #uuid "1a9645f9-f395-5430-af2e-ac99c6e17870" :step/next {:db/id #edb/ref 17592186490350}} {:db/id #edb/ref 17592186490350 :step/content {:db/id #edb/ref 17592186490227 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68f6dbdb-d583-5244-98af-d51948d327ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{a}^{2}-4a{b}^{2}+{b}^{4}" :db/id #edb/ref 17592186489767} {:answer/id #uuid "823a99ee-ed71-595d-979e-7d9efe2268fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{a}^{2}+{b}^{4}" :db/id #edb/ref 17592186489812} {:answer/id #uuid "8ebe3a75-ff92-5c14-947a-6c9b06c84f8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{a}^{2}-{b}^{4}" :db/id #edb/ref 17592186489837} {:answer/id #uuid "d24981a6-c6ea-5260-94b3-3a43009f92cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{a}^{2}-2a{b}^{2}-{b}^{4}" :db/id #edb/ref 17592186489979} {:answer/id #uuid "f2c12960-665c-559d-b833-9b56dd740b5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{a}^{2}+4a{b}^{2}+{b}^{4}" :db/id #edb/ref 17592186490036}] :answer-field/correct {:db/id #edb/ref 17592186489767} :answer-field/id #uuid "ec200471-10b2-5681-96c2-657a58983bc0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490200}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2be683e9-4308-5a65-9d13-a50367058c8f" :question/math-academy-id "q-33114" :question/problem "${(2a-{b}^{2})}^{2}=$" :question/worked-solution "We will use the following formula:\n\n$$\n(x-y)^{2}={x}^{2}-2xy+{y}^{2}\n$$\n\nSubstituting $x=2a$ and $y={b}^{2},$ we have\n\n$$\n\\begin{aligned}{(2a-{b}^{2})}^{2} & = \\\\ (2a)^{2}-2(2a)({b}^{2})+{({b}^{2})}^{2} & = \\\\ 4{a}^{2}-4a{b}^{2}+{b}^{4}.\\end{aligned}\n$$"} :step/id #uuid "4146d3be-051f-5fcc-ae2f-3ac52db899e7"} {:db/id #edb/ref 17592186490377 :step/content {:db/id #edb/ref 17592186490303 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d91b24d-4cf0-5621-b56a-13fa12f96cc0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9+6{w}^{3}+2{w}^{6}" :db/id #edb/ref 17592186489615} {:answer/id #uuid "30e198a1-9cd9-532e-b734-b7de40702f8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9+12{w}^{3}+2{w}^{6}" :db/id #edb/ref 17592186489623} {:answer/id #uuid "46ec2942-f6fe-5960-a870-5c13e581e7b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9+12{w}^{3}+4{w}^{6}" :db/id #edb/ref 17592186489678} {:answer/id #uuid "6598702c-b178-5390-8d47-dc145c750494" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9+12{w}^{3}+2{w}^{5}" :db/id #edb/ref 17592186489753} {:answer/id #uuid "b72d3e86-d7b2-5212-a462-13f5e6b36f94" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9+4{w}^{6}" :db/id #edb/ref 17592186489918}] :answer-field/correct {:db/id #edb/ref 17592186489678} :answer-field/id #uuid "c012204b-f827-5e31-922c-3c631ad51cc6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490178}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c9bc34bd-c944-573e-9a8a-bd4bb9a0f491" :question/math-academy-id "q-31551" :question/problem "${(3+2{w}^{3})}^{2}=$" :question/worked-solution "We will use the following formula:\n\n$$\n(a+b)^{2}={a}^{2}+2ab+{b}^{2}\n$$\n\nSubstituting $a=3$ and $b=2{w}^{3},$ we have\n\n$$\n\\begin{aligned}(3+2{w}^{3})^{2} & = \\\\ {3}^{2}+2(3)(2{w}^{3})+(2{w}^{3})^{2} & = \\\\ 9+12{w}^{3}+4{w}^{6}.\\end{aligned}\n$$"} :step/id #uuid "b9dd9bf4-659c-5cef-a140-f5ba0f516f13" :step/next {:db/id #edb/ref 17592186490339}}] :activity/title "Squaring Binomials" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186489501}]}
