#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186158115} :activity/id #uuid "cbd46609-5d47-5083-b486-16099bcde13c" :activity/scope {:db/id #edb/ref 17592186048899 :topic/id #uuid "ca591370-8b5d-5bfa-ab22-1b8f70f72499" :topic/math-academy-id 2826} :activity/steps [{:db/id #edb/ref 17592186158109 :step/content {:db/id #edb/ref 17592186157280 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157084 :question/id #uuid "99f04ab6-00a0-5ccc-a328-49a85547c4c1" :question/math-academy-id "e-7153"} :knowledge-point/id #uuid "65d40bd9-4d35-5e07-a767-8b2ae6ba559a" :knowledge-point/questions [{:db/id #edb/ref 17592186157566} {:db/id #edb/ref 17592186157567} {:db/id #edb/ref 17592186233059} {:db/id #edb/ref 17592186234421} {:db/id #edb/ref 17592186554566} {:db/id #edb/ref 17592186554627}] :knowledge-point/title "Finding a Union of Sets Without a Venn Diagram"} :step/id #uuid "bc81ca8c-1879-57e6-9bfa-ce1dd02a9f8c" :step/math-academy-id 26353 :step/next {:db/id #edb/ref 17592186158110}} {:db/id #edb/ref 17592186158110 :step/content {:db/id #edb/ref 17592186157281 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157085 :question/id #uuid "6a3a434d-5fe4-53cd-ba34-4d10db5c85fe" :question/math-academy-id "e-7154"} :knowledge-point/id #uuid "03cc876e-66d5-51af-ad8d-6c20bc599609" :knowledge-point/questions [{:db/id #edb/ref 17592186157765} {:db/id #edb/ref 17592186157788} {:db/id #edb/ref 17592186233063} {:db/id #edb/ref 17592186234433} {:db/id #edb/ref 17592186554618}] :knowledge-point/title "Finding Unions of Sets Given Verbally"} :step/id #uuid "a5467cae-8abd-5d16-9ef4-3e30adc5d3b0" :step/math-academy-id 26354} {:db/id #edb/ref 17592186158115 :step/content {:db/id #edb/ref 17592186158472 :tutorial/content "The **union** of two sets ![](images/32/3207697e43e4f88223ad85c16964c3103a50c0c999a4ca14417695158d45526b.svg) and ![](images/65/65ada9c919fe5c4bee19fb4cafff28ed46a36bf6fc90b4cecf70e0fa02386ce0.svg) denoted ![](images/18/18271071563c5a2bcf483504921bb3fad4cbeedba4ca812bb20ef7ba96f637b7.svg) is the set of all elements belonging to either ![](images/32/3207697e43e4f88223ad85c16964c3103a50c0c999a4ca14417695158d45526b.svg) or ![](images/65/65ada9c919fe5c4bee19fb4cafff28ed46a36bf6fc90b4cecf70e0fa02386ce0.svg) or both.\n\nFor example, consider the sets ![](images/32/3228232fb4c16493d5268b308ede8727a84c20297d9b216a74db7b537011c704.svg) and ![](images/4d/4d576c7a3682975f73724c0fbddaf962449049968b852a28434102128ffa8a96.svg) We can represent these sets using a Venn diagram, as follows:\n\n![](images/83/8351db4817ac8b0d2991fe8ef09ee1f2583c84cb772114ef0614a0ef96c96389.png)\n\nThe union ![](images/58/58a13b2e88b95997772105b179139f2bb67105050519a451c17b838337cb4632.svg) consists of all the elements that are in ![](images/32/3207697e43e4f88223ad85c16964c3103a50c0c999a4ca14417695158d45526b.svg) or ![](images/65/65ada9c919fe5c4bee19fb4cafff28ed46a36bf6fc90b4cecf70e0fa02386ce0.svg) or both. To represent ![](images/18/18271071563c5a2bcf483504921bb3fad4cbeedba4ca812bb20ef7ba96f637b7.svg) we will shade in all the area that is contained within either ![](images/32/3207697e43e4f88223ad85c16964c3103a50c0c999a4ca14417695158d45526b.svg) or ![](images/65/65ada9c919fe5c4bee19fb4cafff28ed46a36bf6fc90b4cecf70e0fa02386ce0.svg) or both.\n\n![](images/e9/e912fe53d530ac47245c916bd16f1758df487ded32da88abfab253ed1ee0cc63.png)\n\nThe elements ![](images/0e/0e9479f799610ac47cadcc6890bb35f5336c08c9e2827384fd299138b7e4c558.svg) are in either ![](images/32/3207697e43e4f88223ad85c16964c3103a50c0c999a4ca14417695158d45526b.svg) or ![](images/65/65ada9c919fe5c4bee19fb4cafff28ed46a36bf6fc90b4cecf70e0fa02386ce0.svg) or both. Therefore, the union of ![](images/32/3207697e43e4f88223ad85c16964c3103a50c0c999a4ca14417695158d45526b.svg) and ![](images/75/7533ad047439b7d799dd7afee5d6a7bc9f4404fbadb8c3f27ef6d3952119ff6b.svg) is\n\n![](images/dc/dc7e001d55359f56770a3cdd382a7318d77cbb12b260141399192d14953b4146.svg)\n\nNotice that ![](images/a7/a77a353782459b753313d80235712695d65dc4a44d8d357aa41add6729f81d8f.svg) belongs to both ![](images/32/3207697e43e4f88223ad85c16964c3103a50c0c999a4ca14417695158d45526b.svg) and ![](images/65/65ada9c919fe5c4bee19fb4cafff28ed46a36bf6fc90b4cecf70e0fa02386ce0.svg) but we list it only once in ![](images/bb/bbb285be6a3e138649aa4a514c34823a6b39d094dca3427eb34eb4a326854fcf.svg) In a set, each distinct element is written only once." :tutorial/id #uuid "7d7d339f-bbdd-5e0c-9913-c3e6cdc13958" :tutorial/math-academy-id 4331 :tutorial/title "Introduction"} :step/id #uuid "cb58bb7c-83ec-5c28-97f8-f0bbb8d177aa" :step/math-academy-id 26362 :step/next {:db/id #edb/ref 17592186158124}} {:db/id #edb/ref 17592186158124 :step/content {:db/id #edb/ref 17592186157291 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157095 :question/id #uuid "3de58ae0-eb3a-5faf-a404-0347d64d4979" :question/math-academy-id "e-7171"} :knowledge-point/id #uuid "37248a2e-6deb-5b4c-af42-51c358f21110" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049065}] :knowledge-point/questions [{:db/id #edb/ref 17592186157804} {:db/id #edb/ref 17592186157805} {:db/id #edb/ref 17592186233058} {:db/id #edb/ref 17592186234432} {:db/id #edb/ref 17592186554617}] :knowledge-point/title "Finding a Union of Sets Using a Venn Diagram"} :step/id #uuid "dddb7100-0567-5656-8491-fb90b50c309a" :step/math-academy-id 26376 :step/next {:db/id #edb/ref 17592186158127}} {:db/id #edb/ref 17592186158127 :step/content {:db/id #edb/ref 17592186158478 :tutorial/content "Although Venn diagrams can be useful to visualize unions, we do not have to draw a Venn diagram every time we wish to compute a union.\n\nFor example, let's again consider the sets $A = \\{ a,b,c \\}$ and $B = \\{ b, d, e \\}.$ This time, we will compute the union $A \\cup B$ without using a Venn diagram. We just need to find all the elements that are in either $A$ or $B,$ or both.\n\nSo, we will start with the elements of $A,$ and then go through the elements of $B$ to look for any elements that we do not already have. Remember that we are looking for elements that we do *not* already have in $A.$\n\n- For the element $b \\in B,$ we have $b \\in A. \\quad \\color{red}\\times$\n\n- For the element $d \\in B,$ we have $d \\not \\in A. \\quad \\color{green}\\checkmark$\n\n- For the element $e \\in B,$ we have $e \\not \\in A. \\quad \\color{green}\\checkmark$\n\nSo, to get the union, we need to take the elements of $A$ and also include $d$ and $e.$\n\nTherefore, the union of $A$ and $B$ is\n\n$$\nA \\cup B = \\{ a,b,c,d,e \\}.\n$$" :tutorial/id #uuid "387bbd7c-3300-588c-9e61-54dda9490e81" :tutorial/math-academy-id 4338 :tutorial/title "Unions Without Venn Diagrams"} :step/id #uuid "1b8eae72-5bc4-59c4-9a2d-4ed1e29eec02" :step/math-academy-id 26380 :step/next {:db/id #edb/ref 17592186158109}}] :activity/title "The Union of Sets" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186157483}]}
