#{[{:db/id #edb/ref 17592186412006 :knowledge-point/_questions [{:db/id #edb/ref 17592186152075 :knowledge-point/id #uuid "a07c5ec7-8199-53c7-9738-80e360d03b38" :knowledge-point/title "Finding an Unknown Modulus"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19c37123-a096-5bf6-b2a7-5752505e1833" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186411976} {:answer/id #uuid "26490cf8-9eff-5b3a-b0d3-8c64c57d3157" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186411978} {:answer/id #uuid "2c364ca7-bc65-5525-9cbb-b33295254414" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186411979} {:answer/id #uuid "5825c4b0-9c95-5b01-bd68-b59a82484df9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186411983} {:answer/id #uuid "c31f3f15-6b9f-50fc-afb7-ae7ee0f2806d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186411992}] :answer-field/correct {:answer/id #uuid "26490cf8-9eff-5b3a-b0d3-8c64c57d3157" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186411978} :answer-field/id #uuid "bfebcc4f-6a0a-526a-a3ca-b56faab77eef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412001}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8e4ac9e6-575d-537d-b731-f3556414b8f1" :question/math-academy-id "q-103492" :question/problem "Given that $15≡7\\,(\\text{mod}\\,n)$, which of the following could be the value of $n?$\n\n- $n=2$\n- $n=4$\n- $n=6$" :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWe have $a-b=15-7=8.$\n\nWith that in mind, let's analyze each statement in turn.\n\n- Note that $2∣8$ because $8÷2=4,$ and there is no remainder. Therefore, the statement is true when $n=2.$\n\n- Note that $4∣8$ because $8÷4=2,$ and there is no remainder. Therefore, the statement is true when $n=4.$\n\n- Note that $6∤8.$ Therefore, the statement is false when $n=6.$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186412005 :knowledge-point/_questions [{:db/id #edb/ref 17592186152074 :knowledge-point/id #uuid "2eebe007-8a95-578d-b553-e37a7bd8a327" :knowledge-point/title "Identifying Congruent Negative Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "201680a8-0a59-5bce-a9ae-f880f0cff9e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-3$ and $4$ only" :db/id #edb/ref 17592186411977} {:answer/id #uuid "39adc475-8403-58e0-87b4-fe53d25dd955" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-3$ and $1$ only" :db/id #edb/ref 17592186411980} {:answer/id #uuid "602567b1-d2c1-533e-8d42-56bb523113a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-1$ only" :db/id #edb/ref 17592186411986} {:answer/id #uuid "aa888775-3331-519b-97a0-76892c220ef0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ only" :db/id #edb/ref 17592186411990} {:answer/id #uuid "ef6360b1-a5a9-5d6c-8d12-cc03dda67a4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-1$ and $4$ only" :db/id #edb/ref 17592186411996}] :answer-field/correct {:answer/id #uuid "201680a8-0a59-5bce-a9ae-f880f0cff9e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-3$ and $4$ only" :db/id #edb/ref 17592186411977} :answer-field/id #uuid "c48ac98a-7a6f-5c83-b51b-ba509e7cd46c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412002}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8064b1f0-dca7-55dd-9b4b-ceb82032583b" :question/math-academy-id "q-212506" :question/problem "Consider the following congruence.\n\n$$\n-10≡\\,(\\text{mod}\\,7)\n$$\n\nWhich of the following values gives a true statement when inserted into the blank space?\n\n- $-3$\n- $-1$\n- $4$" :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWith that in mind, let's analyze each case in turn.\n\n- Case I gives a true statement. Indeed, $7∣(-10-(-3)).$ There is no remainder:\n\n$$\n(-10-(-3))÷7=-7÷7=-1\n$$\n\n- Case II gives a false statement because $7∤(-10-(-1)).$ Notice that $-10-(-1)=-9,$ which is not divisible by $7.$\n\n- Case III gives a true statement. Indeed, $7∣(-10-4).$ There is no remainder:\n\n$$\n(-10-4)÷7=-14÷7=-2\n$$\n\nTherefore, the correct answer is \"$-3$ and $4$ only.\""}] [{:db/id #edb/ref 17592186412003 :knowledge-point/_questions [{:db/id #edb/ref 17592186152074 :knowledge-point/id #uuid "2eebe007-8a95-578d-b553-e37a7bd8a327" :knowledge-point/title "Identifying Congruent Negative Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "049f4ac8-2f43-56ba-807d-c430d4c6142d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ and $11$ only" :db/id #edb/ref 17592186411973} {:answer/id #uuid "5bb235c1-6392-5452-b3b6-8a0a91023250" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$11$ only" :db/id #edb/ref 17592186411984} {:answer/id #uuid "8a4f902f-327e-5d1b-9446-578f9e40cd0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ only" :db/id #edb/ref 17592186411988} {:answer/id #uuid "baa4441d-d871-57d2-980c-afb58db8960c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-8$ only" :db/id #edb/ref 17592186411991} {:answer/id #uuid "cc841dbd-ba57-51f3-a5a9-ce00002c35e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-8$ and $5$ only" :db/id #edb/ref 17592186411993}] :answer-field/correct {:answer/id #uuid "8a4f902f-327e-5d1b-9446-578f9e40cd0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ only" :db/id #edb/ref 17592186411988} :answer-field/id #uuid "b9037e4d-7729-575a-9011-573815defbea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412000}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "163bd7b9-110a-543a-ae84-a607fb568a3f" :question/math-academy-id "q-212514" :question/problem "Consider the following congruence.\n\n$$\n-11≡\\,(\\text{mod}\\,8)\n$$\n\nWhich of the following values gives a true statement when inserted into the blank space?\n\n- $-8$\n- $5$\n- $11$" :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWith that in mind, let's analyze each case in turn.\n\n- Case I gives a false statement because $8∤(-11-(-8)).$ Notice that $-11-(-8)=-3,$ which is not divisible by $8.$\n\n- Case II gives a true statement. Indeed, $8∣(-11-5).$ There is no remainder:\n\n$$\n(-11-5)÷8=-16÷8=-2\n$$\n\n- Case III gives a false statement because $8∤(-11-11).$ Notice that $-11-11=-22,$ which is not divisible by $8.$\n\nTherefore, the correct answer is \"$5$ only.\""}] [{:db/id #edb/ref 17592186412007 :knowledge-point/_questions [{:db/id #edb/ref 17592186152075 :knowledge-point/id #uuid "a07c5ec7-8199-53c7-9738-80e360d03b38" :knowledge-point/title "Finding an Unknown Modulus"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07424979-9774-53c4-849f-0c08fd54fc62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186411974} {:answer/id #uuid "08bd5615-539e-5361-90d4-ed7d60cee26d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186411975} {:answer/id #uuid "7bdc657a-27b5-5e42-929a-143a6d8eadb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186411987} {:answer/id #uuid "8ba8fc9a-b908-579d-8f19-6c7445fb911f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186411989} {:answer/id #uuid "eb35e354-c87a-5af4-b949-2eb9feda22c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186411995}] :answer-field/correct {:answer/id #uuid "08bd5615-539e-5361-90d4-ed7d60cee26d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186411975} :answer-field/id #uuid "5a66d7e4-64aa-595c-8772-a5f8626e54fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411998}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bd2ee89b-0850-5297-a810-7e54facce40b" :question/math-academy-id "q-212522" :question/problem "Given that $-7≡-3\\,(\\text{mod}\\,n),$ which of the following could be the value of $n?$\n\n- $n=2$\n- $n=3$\n- $n=7$" :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWe have $a-b=-7-(-3)=-4.$\n\nWith that in mind, let's analyze each statement in turn.\n\n- Note that $2∣(-4)$ because $(-4)÷2=-2,$ and there is no remainder. Therefore, the statement is true when $n=2.$\n\n- Note that $3∤(-4).$ Therefore, the statement is false when $n=3.$\n\n- Note that $7∤(-4).$ Therefore, the statement is false when $n=7.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186412004 :knowledge-point/_questions [{:db/id #edb/ref 17592186152075 :knowledge-point/id #uuid "a07c5ec7-8199-53c7-9738-80e360d03b38" :knowledge-point/title "Finding an Unknown Modulus"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "431e7942-0839-55b7-a404-74d95db870c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186411981} {:answer/id #uuid "4687ae48-3f94-52e2-9dea-bc272c1082bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186411982} {:answer/id #uuid "5d69edd9-6b87-5ce4-a237-f6f2f7e1d07c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186411985} {:answer/id #uuid "cde51bb4-f6f6-5104-86ea-3da2a88dc7a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186411994} {:answer/id #uuid "f8eb5ef4-1688-5731-842c-a125cdee48be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186411997}] :answer-field/correct {:answer/id #uuid "cde51bb4-f6f6-5104-86ea-3da2a88dc7a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186411994} :answer-field/id #uuid "99f36666-4b80-55b9-8c5c-1ce4a6ba661d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411999}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "40dd9397-7325-5b4d-9df5-fd6f72af0a3c" :question/math-academy-id "q-76978" :question/problem "Given that $7≡19\\,(\\text{mod}\\,n),$ which of the following could be the value of $n?$\n\n- $n=5$\n- $n=6$\n- $n=7$" :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWe have $a-b=7-19=-12.$\n\nWith that in mind, let's analyze each statement in turn.\n\n- Note that $5∤(-12).$ Therefore, the statement is false when $n=5.$\n\n- Note that $6∣(-12)$ because $(-12)÷6=-2,$ and there is no remainder. Therefore, the statement is true when $n=6.$\n\n- Note that $7∤(-12).$ Therefore, the statement is false when $n=7.$\n\nTherefore, the correct answer is \"II only.\""}]}
