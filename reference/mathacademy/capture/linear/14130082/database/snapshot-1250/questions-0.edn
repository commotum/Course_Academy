f9258b98fb60.png)"}] [{:db/id #edb/ref 17592186074420 :knowledge-point/_questions [{:db/id #edb/ref 17592186073687 :knowledge-point/id #uuid "16e2265e-5c75-538f-91a1-9120d2f77c9e" :knowledge-point/title "Multiplying a Fraction by a Unit Fraction Using a Model"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3492c6e-0cf3-5ffe-b75c-9c4617fd3274" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{12}" :db/id #edb/ref 17592186072759} {:answer/id #uuid "df482a0e-f324-5349-b382-8fe5574bc67a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186072760} {:answer/id #uuid "f9903a21-0217-58f2-8d63-41d105a30c08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186072761} {:answer/id #uuid "223379f8-ee6a-5c47-8bd1-f452e3187e1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{4}" :db/id #edb/ref 17592186072762} {:answer/id #uuid "712639d1-5da2-5392-8851-f92f6c470e4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186072763}] :answer-field/correct {:answer/id #uuid "a3492c6e-0cf3-5ffe-b75c-9c4617fd3274" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{12}" :db/id #edb/ref 17592186072759} :answer-field/id #uuid "66fc3948-4f7b-51cd-b723-f43fedc0d1be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186072758}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d8028372-de90-5318-b125-be12ab64e3cc" :question/math-academy-id "q-60224" :question/problem "![](images/7d/7d2474d5fd25cbb23c534e4d8f67726177988a49f9c0e271b91b0ff677dabd41.png)\n\nUse the model above to calculate $\\frac{2}{3}\\times \\frac{1}{4}.$" :question/worked-solution "Since we need to multiply by $\\frac{1}{4}$, we split the whole into $4$ equal parts horizontally.\n\n![](images/41/416c66bc1591d9215bd5e74c975f6e17992ae0d3456262091d48910b9d89abc9.png)\n\nFrom the picture on the right, we obtain that the shaded part represents $\\frac{2}{12}$ of the whole.\n\nTherefore,\n\n$$\n\\frac{2}{3}\\times \\frac{1}{4}=\\frac{2}{12}.\n$$"}] [{:db/id #edb/ref 17592186425829 :knowledge-point/_questions [{:db/id #edb/ref 17592186073687 :knowledge-point/id #uuid "16e2265e-5c75-538f-91a1-9120d2f77c9e" :knowledge-point/title "Multiplying a Fraction by a Unit Fraction Using a Model"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15321b92-66dd-5be5-aeba-0321bfb68de6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186425789} {:answer/id #uuid "a1f76a54-7b84-55e5-85d6-2f2641897d2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186425801} {:answer/id #uuid "b3ccd621-328f-52d1-b0a5-229fe95a49be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{12}" :db/id #edb/ref 17592186425805} {:answer/id #uuid "b6a17329-a593-5b33-9648-7fdc0bcc4009" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{4}" :db/id #edb/ref 17592186425806} {:answer/id #uuid "e388c151-72a9-5f49-b673-7acdc8cfea3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186425814}] :answer-field/correct {:answer/id #uuid "b3ccd621-328f-52d1-b0a5-229fe95a49be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{12}" :db/id #edb/ref 17592186425805} :answer-field/id #uuid "9bf9904d-ff91-59ca-838c-990a934ab97e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425825}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8fb4c868-ce54-5c7d-ab79-c96f1e73ab38" :question/math-academy-id "q-60226" :question/problem "![](images/0e/0e8213704b9b6ba8e507ec59a09d5e6fe1450e21fa3e1f26eca15876a5807fdc.png)\n\nUse the model above to calculate $\\frac{2}{4}\\times \\frac{1}{3}.$" :question/worked-solution "Since we need to multiply by $\\frac{1}{3}$, we split the whole into $3$ equal parts horizontally.\n\n![](images/37/37d524644c009517608455822101750eb532cc8858fee1b96516d30e3fa1fe15.png)\n\nFrom the picture on the right, we obtain that the shaded part represents $\\frac{2}{12}$ of the whole.\n\nTherefore,\n\n$$\n\\frac{2}{4}\\times \\frac{1}{3}=\\frac{2}{12}.\n$$"}]}
