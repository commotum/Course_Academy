  "html": "<div id=\"step-q117988\" class=\"step questionWidget\" style=\"display: block;\"><div class=\"questionWidget-header\"><div class=\"questionWidget-title\">Question 3</div><div class=\"questionWidget-helpButton\">?</div></div><div class=\"questionWidget-graphic\"><img src=\"/graphics/q-117988\"></div><div class=\"questionWidget-text\"><p>Determine the lateral surface area of the cylinder above.</p>\n</div><table class=\"questionWidget-choicesTable\"><tbody><tr><td class=\"questionWidget-choiceLetter\"><div id=\"questionWidget-choiceLetterCircle-117988-a\" class=\"questionWidget-choiceLetterCircle\">a</div></td><td class=\"questionWidget-choiceText\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"29\" style=\"font-size: 119.6%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c33\"></mjx-c><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D70B TEX-I\"></mjx-c></mjx-mi><mjx-mstyle><mjx-mspace style=\"width: 0.222em;\"></mjx-mspace></mjx-mstyle><mjx-msup><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c6D\"></mjx-c><mjx-c class=\"mjx-c6D\"></mjx-c></mjx-mtext><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>30</mn><mi>π</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><msup><mtext>mm</mtext><mn>2</mn></msup></math></mjx-assistive-mml></mjx-container></td></tr><tr><td class=\"questionWidget-choiceLetter\"><div id=\"questionWidget-choiceLetterCircle-117988-b\" class=\"questionWidget-choiceLetterCircle\">b</div></td><td class=\"questionWidget-choiceText\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"30\" style=\"f