:answer-field.type/radio} :db/id #edb/ref 17592186527893}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "735fa5c9-8ac9-5976-8041-9e59cf3d3694" :question/math-academy-id "q-113810" :question/problem "The point $P$ with coordinates $(3,-2)$ lies on the curve $y=f(x).$ Which point must lie on $y=-f(x)?$" :question/worked-solution "The transformation $y=-f(x)$ reflects the curve $y=f(x)$ in the $x$-axis.\n\nFirst, notice that the point $P(3,-2)$ lies $2$ units *below* the $x$-axis. So, under the action of the transformation, this point will be reflected $2$ units *above* the $x$-axis.\n\n![](images/c2/c20856218b6f5f18c9a3465027a8f1a64a67f2c0d8ef3bd97fba5236f7b81bab.png)\n\nWe conclude that the point $(3,2)$ must lie on the graph of $y=-f(x).$"}] [{:db/id #edb/ref 17592186527978 :knowledge-point/_questions [{:db/id #edb/ref 17592186096685 :knowledge-point/id #uuid "ef0d732d-f50b-5179-9a77-1378a84173ac" :knowledge-point/title "Sketching the Graph of a Vertically Reflected Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22b4a29d-4b82-55eb-b244-575d5f66388b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/78/780496a7ee571c2fd65d966a2ac7fa2bd7de368cf0360fdcfb73282c3d875dab.png" :db/id #edb/ref 17592186527385} {:answer/id #uuid "5df7b6dd-8a2e-5078-9fef-978dfb5bce76" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ac/ac6955f0b40714819735faa6d53f96d8ef7ad25dbaa8f215b3235c6a1e7623f4.png" :db/id #edb/ref 17592186527486} {:answer/id #uuid "ad86032b-ea6b-5504-a76e-7e8a01871045" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/df/df87a5e649dcdc49cce7ad49676b8be226c9d5e5dd3b39e049e20081c1815821.png" :db/id #edb/ref 17592186527663} {:answer/id #uuid "b813e341-0f96-5d39-9849-dc8fcc93b71e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answ