#{[{:db/id #edb/ref 17592186115143 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115314 :knowledge-point/id #uuid "a4a8d54a-c034-5646-b804-0dc96f6c21d0" :knowledge-point/title "Finding the Domain of a Transformed Radical Function With an Even Index"}] :question/id #uuid "bfa03caf-a95c-5ba3-aa94-94698481226d" :question/math-academy-id "e-8141" :question/problem "Find the domain of $g(x) = -2\\sqrt[6]{x+1}-2.$" :question/worked-solution "The domain of $y = \\sqrt[6]{x}$ is\n\n$$\nx \\ge 0.\n$$\n\nTo find the domain of $g(x) =  -2\\sqrt[6]{x+1}-2,$ we replace $x$ with $x+1$ in the above inequality. This gives\n\n$$\n{x+1} \\ge 0.\n$$\n\nSolving this inequality, we get\n\n$$\n\\begin{aligned}x+1 & \\ge 0 \\\\ x & \\ge -1\\end{aligned}\n$$\n\nTherefore, the domain of $y = g(x)$ is $x \\in [-1, \\infty).$ \n\nWe can also see that this is true from the graph of the function. The graph of $y=g(x)$ is shown below.\n\n![](images/7e/7eeaa091e1a1417efa5800abe3fd937c78957123c425c5a0d2ef239ca4994732.png)"}] [{:db/id #edb/ref 17592186115149 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115330 :knowledge-point/id #uuid "d78b6269-6217-5e55-a551-aeb079c111cd" :knowledge-point/title "Finding the Domain of a Transformed Radical Function With an Odd Index"}] :question/id #uuid "6c380798-9b3a-5d9d-96dc-d858d737e577" :question/math-academy-id "e-8720" :question/problem "Find the domain of $f(x) = -4\\sqrt[9]{-x-5} +10.$" :question/worked-solution "The domain of $y = \\sqrt[9]{x}$ is\n$x \\in (-\\infty,\\infty).$\n\nTransformations do not change this interval. Therefore, the domain of $f(x)$ is $x \\in (-\\infty,\\infty).$"}] [{:db/id #edb/ref 17592186558534 :knowledge-point/_questions [{:db/id #edb/ref 17592186115314 :knowledge-point/id #uuid "a4a8d54a-c034-5646-b804-0dc96f6c21d0" :knowledge-point/title "Finding the Domain of a Transformed Radical Function With an Even Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20830856-dd64-505e-9bac-b19cd9da9f46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,\\frac{1}{2}]" :db/id #edb/ref 17592186557936} {:answer/id #uuid "31648ea3-bede-5f95-a63a-3b889794c336" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-8,\\infty )" :db/id #edb/ref 17592186557968} {:answer/id #uuid "4ddb34ce-cd00-5218-a021-318ddf3a6cc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-\\frac{1}{2},\\infty )" :db/id #edb/ref 17592186558014} {:answer/id #uuid "d649e49a-fbd1-5378-80f3-dbec4a526e9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [\\frac{1}{2},\\infty )" :db/id #edb/ref 17592186558290} {:answer/id #uuid "ee95daf9-4c83-52e6-8748-40abc0d1c4fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-\\frac{1}{2}]" :db/id #edb/ref 17592186558341}] :answer-field/correct {:answer/id #uuid "4ddb34ce-cd00-5218-a021-318ddf3a6cc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-\\frac{1}{2},\\infty )" :db/id #edb/ref 17592186558014} :answer-field/id #uuid "1338427f-bb64-5c5f-b40b-56adf1cfde46" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558370}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "895d7f63-090f-522e-92d1-9735ed3523b6" :question/math-academy-id "q-115816" :question/problem "Find the domain of $t(x)=-5\\sqrt[6]{6x+3}-8.$" :question/worked-solution "The domain of $y=\\sqrt[6]{x}$ is\n\n$$\nx\\ge 0.\n$$\n\nTo find the domain of $t(x)=-5\\sqrt[6]{6x+3}-8,$ we replace $x$ with $6x+3$ in the above inequality. This gives\n\n$$\n6x+3\\ge 0.\n$$\n\nSolving this inequality, we get\n\n$$\n\\begin{aligned}6x+3 & \\ge 0 \\\\ 6x & \\ge -3 \\\\ x & \\ge -\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the domain of $y=t(x)$ is $x\\in [-\\frac{1}{2},\\infty )\\,.$\n\nWe can also see that this is true from the graph of the function. The graph of $y=t(x)$ is shown below.\n\n![](images/74/7407b43998fe6c0f0d4e3151d0c46b4495796bc147754bdd0187517e2f783e86.png)"}] [{:db/id #edb/ref 17592186558518 :knowledge-point/_questions [{:db/id #edb/ref 17592186115330 :knowledge-point/id #uuid "d78b6269-6217-5e55-a551-aeb079c111cd" :knowledge-point/title "Finding the Domain of a Transformed Radical Function With an Odd Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9b3d302-8586-594b-869c-add0ff7360f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186558239}] :answer-field/correct {:answer/id #uuid "b9b3d302-8586-594b-869c-add0ff7360f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186558239} :answer-field/id #uuid "51c599df-a8bf-562c-b111-abdc860883c1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186558393} {:answer-field/choices [{:answer/id #uuid "04c79d26-2ab5-5105-b377-4dfcbcc76684" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186557878}] :answer-field/correct {:answer/id #uuid "04c79d26-2ab5-5105-b377-4dfcbcc76684" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186557878} :answer-field/id #uuid "f89897e9-a732-544c-9e88-66b63d970f64" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186558474}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5f390a