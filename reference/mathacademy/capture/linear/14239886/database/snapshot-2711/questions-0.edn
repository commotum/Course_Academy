stion.difficulty/easy} :question/id #uuid "74e96b23-9826-5563-b261-02a13170ade4" :question/math-academy-id "q-276517" :question/problem "Find the domain of $t(x)=5\\sqrt[9]{12-7x}-2.$\n\n$x\\in ($\n{{field-1}},\n\n{{field-2}} $).$" :question/worked-solution "The domain of $y=\\sqrt[9]{x}$ is\n$x\\in (-\\infty ,\\infty ).$\n\nTransformations do not change this interval. Therefore, the domain of $t(x)$ is $x\\in (-\\infty ,\\infty ).$"}] [{:db/id #edb/ref 17592186115988 :knowledge-point/_questions [{:db/id #edb/ref 17592186115314 :knowledge-point/id #uuid "a4a8d54a-c034-5646-b804-0dc96f6c21d0" :knowledge-point/title "Finding the Domain of a Transformed Radical Function With an Even Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93dafbd0-e49a-51ea-9bb0-afc4c0d9f013" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [1,\\infty )" :db/id #edb/ref 17592186558156} {:answer/id #uuid "c1d6b23f-9976-597d-8969-7c27cfcebcff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,0]" :db/id #edb/ref 17592186558256} {:answer/id #uuid "cefa8c60-3819-55ee-8b59-698596d0636b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [2,\\infty )" :db/id #edb/ref 17592186558278} {:answer/id #uuid "e2bf51a6-51a6-5c41-969b-9ca4c871ea87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,2)" :db/id #edb/ref 17592186558320} {:answer/id #uuid "f96df448-0f7b-5ccb-8fd9-21207ca491f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-2,\\infty )" :db/id #edb/ref 17592186558356}] :answer-field/correct {:answer/id #uuid "cefa8c60-3819-55ee-8b59-698596d0636b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [2,\\infty )" :db/id #edb/ref 17592186558278} :answer-field/id #uuid "e40b10cf-2e70-5bbd-9fd3-d58911e802ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186114865}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ff97f1ab-e635-52ba-aeb0-0953318962bc" :question/math-academy-id "q-93047" :question/problem "Find the domain of $n(x)=-2\\sqrt[4]{x-2}-1.$" :question/worked-solution "The domain of $y=\\sqrt[4]{x}$ is\n\n$$\nx\\ge 0.\n$$\n\nTo find the domain of $n(x)=-2\\sqrt[4]{x-2}-1,$ we replace $x$ with $x-2$ in the above inequality. This gives\n\n$$\nx-2\\ge 0.\n$$\n\nSolving this inequality, we get\n\n$$\n\\begin{aligned}x-2 & \\ge 0 \\\\ x & \\ge 2\\end{aligned}\n$$\n\nTherefore, the domain of $y=n(x)$ is $x\\in [2,\\infty ).$\n\nWe can also see that this is true from the graph of the function. The graph of $y=n(x)$ is shown below.\n\n![](images/b9/b9d1df320fa9d2664365c6990df105456cfd6614209e1421224b1202b777f0cb.png)"}]}
