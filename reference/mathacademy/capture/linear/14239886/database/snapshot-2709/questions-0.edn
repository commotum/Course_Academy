#{[{:db/id #edb/ref 17592186115143 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115314 :knowledge-point/id #uuid "a4a8d54a-c034-5646-b804-0dc96f6c21d0" :knowledge-point/title "Finding the Domain of a Transformed Radical Function With an Even Index"}] :question/id #uuid "bfa03caf-a95c-5ba3-aa94-94698481226d" :question/math-academy-id "e-8141" :question/problem "Find the domain of $g(x) = -2\\sqrt[6]{x+1}-2$." :question/worked-solution "The domain of\n\n$$\ny = \\sqrt[6]{x}\n$$\n\nis\n\n$$\nx \\ge 0\n$$\n\nTo find the domain of\n\n$$\ng(x) = -2\\sqrt[6]{x+1}-2\n$$\n\nwe replace $x$ with $x+1$ in the above inequality. This gives\n\n$$\n{x+1} \\ge 0\n$$\n\nSolving this inequality, we get\n\n$$\n\\begin{bmatrix}x + 1 & \\ge 0 \\\\ x & \\ge - 1\\end{bmatrix}\n$$\n\nTherefore, the domain of $y = g(x)$ is $x \\in [-1, \\infty)$.\n\nWe can also see that this is true from the graph of the function. The graph of $y=g(x)$ is shown below.\n\n![](images/7e/7eeaa091e1a1417efa5800abe3fd937c78957123c425c5a0d2ef239ca4994732.png)"}] [{:db/id #edb/ref 17592186115149 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115330 :knowledge-point/id #uuid "d78b6269-6217-5e55-a551-aeb079c111cd" :knowledge-point/title "Finding the Domain of a Transformed Radical Function With an Odd Index"}] :question/id #uuid "6c380798-9b3a-5d9d-96dc-d858d737e577" :question/math-academy-id "e-8720" :question/problem "Find the domain of $f(x) = -4\\sqrt[9]{-x-5} +10$." :question/worked-solution "The domain of\n\n$$\ny = \\sqrt[9]{x}\n$$\n\nis\n$x \\in (-\\infty,\\infty)$.\n\nTransformations do not change this interval. Therefore, the domain of $f(x)$ is $x \\in (-\\infty,\\infty)$."}] [{:db/id #edb/ref 17592186115988 :knowledge-point/_questions [{:db/id #edb/ref 17592186115314 :knowledge-point/id #uuid "a4a8d54a-c034-5646-b804-0dc96f6c21d0" :knowledge-point/title "Finding the Domain of a Transformed Radical Function With an Even Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac57fa26-69f8-56ba-ac26-a5bb886cf14d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x ∈ (- ∞, 2)" :db/id #edb/ref 17592186114866} {:answer/id #uuid "e2f8981b-e545-55fc-96ef-8617fc800a55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x ∈ [2, ∞)" :db/id #edb/ref 17592186114867} {:answer/id #uuid "033757d9-2971-5687-a63f-e5be86bad779" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x ∈ (- ∞, 0]" :db/id #edb/ref 17592186114868} {:answer/id #uuid "53cd856b-89e0-5d64-8be3-d820188baf50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x ∈ [- 2, ∞)" :db/id #edb/ref 17592186114869} {:answer/id #uuid "5a3edd4c-5b46-5e91-9bbd-5a52f897f323" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x ∈ [1, ∞)" :db/id #edb/ref 17592186114870}] :answer-field/id #uuid "e40b10cf-2e70-5bbd-9fd3-d58911e802ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186114865}] :question/id #uuid "ff97f1ab-e635-52ba-aeb0-0953318962bc" :question/math-academy-id "q-93047" :question/problem "Find the domain of $n(x) =-2\\sqrt[4]{x - 2} - 1$."}]}
