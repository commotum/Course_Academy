#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186551403} :activity/id #uuid "87369fa2-1336-5ef5-ab81-fdcbdb07cf83" :activity/scope {:db/id #edb/ref 17592186051061 :topic/id #uuid "7de546e1-10a1-5134-abfc-9fe21121e7cb" :topic/math-academy-id 728} :activity/steps [{:db/id #edb/ref 17592186551384 :step/content {:db/id #edb/ref 17592186551260 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15c18ebe-c675-5bcf-b34d-fee9f38573de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{x}^{3}+9{x}^{2}+15x+25+\\frac{100}{3x-5}" :db/id #edb/ref 17592186550415} {:answer/id #uuid "5afbc067-5499-538e-a8b6-7c624c3edc2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{x}^{3}+9{x}^{2}-15x-50+\\frac{100}{3x-5}" :db/id #edb/ref 17592186550591} {:answer/id #uuid "62a672e0-4667-5d14-94ed-8c58ba311d8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{x}^{3}+5{x}^{2}-9x+2-\\frac{100}{3x-5}" :db/id #edb/ref 17592186550605} {:answer/id #uuid "af6c1d59-c605-55b7-98a8-43b605decc44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{x}^{3}-{x}^{2}+5x+25-\\frac{100}{3x-5}" :db/id #edb/ref 17592186550845} {:answer/id #uuid "d952f828-349f-5d26-a20c-bf66dfa362fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{x}^{3}-7{x}^{2}+9x+21+\\frac{100}{3x-5}" :db/id #edb/ref 17592186550955}] :answer-field/correct {:db/id #edb/ref 17592186550415} :answer-field/id #uuid "a916e5ab-d2bf-5c35-99df-efcacc3f8e56" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186551167}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "343c6002-3a70-5903-a244-0acddb5859ce" :question/math-academy-id "q-73818" :question/problem "$\\frac{9{x}^{4}+12{x}^{3}-25}{3x-5}=$" :question/worked-solution "We can calculate $\\frac{9{x}^{4}+12{x}^{3}-25}{3x-5}$ using synthetic division.\n\nFor synthetic division to work, we need the coefficient of $x$ in the denominator to be equal to $1.$ So first, we factor the denominator:\n\n$$\n\\begin{aligned}\\frac{9{x}^{4}+12{x}^{3}-25}{3x-5} & =\\frac{9{x}^{4}+12{x}^{3}-25}{3(x-\\frac{5}{3})} \\\\  & =\\frac{1}{3}\\cdot \\frac{9{x}^{4}+12{x}^{3}-25}{(x-\\frac{5}{3})}\\end{aligned}\n$$\n\nCarrying out the synthetic division process on $\\frac{9{x}^{4}+12{x}^{3}-25}{(x-\\frac{5}{3})}$, we arrive at the following:\n\n$$\n\\begin{aligned} & {x}^{4} & {x}^{3} & {x}^{2} & {x}^{1} & {x}^{0} \\\\ \\frac{5}{3} & 9 & 12 & 0 & 0 & -25 \\\\  & ↓ & 15 & 45 & 75 & 125 \\\\  & 9 & 27 & 45 & 75 & 100\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{1}{3}\\cdot \\frac{9{x}^{4}+12{x}^{3}-25}{(x-\\frac{5}{3})} & =\\frac{1}{3}(9{x}^{3}+27{x}^{2}+45x+75+\\frac{100}{(x-\\frac{5}{3})}) \\\\  & =3{x}^{3}+9{x}^{2}+15x+25+\\frac{100}{3x-5}.\\end{aligned}\n$$\n\nSo, our final result is\n\n$$\n\\frac{9{x}^{4}+12{x}^{3}-25}{3x-5}=3{x}^{3}+9{x}^{2}+15x+25+\\frac{100}{3x-5}.\n$$"} :step/id #uuid "340e3ed6-35e3-5d45-bca2-83d91ae792ee"} {:db/id #edb/ref 17592186551386 :step/content {:db/id #edb/ref 17592186551300 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c1bd531-0de7-525b-8300-8cc89c022598" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{x}^{3}+{x}^{2}+1-\\frac{3}{x+4}" :db/id #edb/ref 17592186550401} {:answer/id #uuid "23683e8c-85ff-58cb-b908-b24a1cd95133" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{x}^{3}-3{x}^{2}+21+\\frac{3}{x+4}" :db/id #edb/ref 17592186550448} {:answer/id #uuid "30488cbf-33f4-5e0f-959a-d6e3b556522f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{x}^{3}+5{x}^{2}+12+\\frac{3}{x+4}" :db/id #edb/ref 17592186550485} {:answer/id #uuid "afba8a58-1017-5f18-bf57-fd6a18b0ee20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{x}^{3}+12{x}^{2}-6-\\frac{3}{x+4}" :db/id #edb/ref 17592186550847} {:answer/id #uuid "d659d2fd-291e-5be2-ad56-cfd41202f459" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{x}^{3}+7{x}^{2}+4-\\frac{3}{x+4}" :db/id #edb/ref 17592186550947}] :answer-field/correct {:db/id #edb/ref 17592186550401} :answer-field/id #uuid "23231c31-724d-51d7-aa6f-f7ca2083833d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186551082}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "84195c6c-e13d-58c7-8f62-b8364f00b637" :question/math-academy-id "q-18577" :question/problem "$\\frac{-{x}^{4}-3{x}^{3}+4{x}^{2}+x+1}{x+4}=$" :question/worked-solution "We can calculate $\\frac{-{x}^{4}-3{x}^{3}+4{x}^{2}+x+1}{x+4}$ using synthetic division.\n\nCarrying out the synthetic division process, we arrive at the following:\n\n$$\n\\begin{aligned} & {x}^{4} & {x}^{3} & {x}^{2} & {x}^{1} & {x}^{0} \\\\ -4 & -1 & -3 & 4 & 1 & 1 \\\\  & ↓ & 4 & -4 & 0 & -4 \\\\  & -1 & 1 & 0 & 1 & -3\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{-{x}^{4}-3{x}^{3}+4{x}^{2}+x+1}{x+4}=-{x}^{3}+{x}^{2}+1-\\frac{3}{x+4}.\\end{aligned}\n$$"} :step/id #uuid "34f2531b-3118-5542-84d9-9e90e68fa910" :step/next {:db/id #edb/ref 17592186551384}} {:db/id #edb/ref 17592186551403 :step/content {:db/id #edb/ref 17592186551308 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "169f6f65-5871-519b-a5b5-58af3670b1d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{x}^{3}-x+9-\\frac{4}{x+3}" :db/id #edb/ref 17592186550416} {:answer/id #uuid "1d1d54fd-b5da-555c-97be-008df659bd4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{x}^{3}+2x-12+\\frac{4}{x+3}" :db/id #edb/ref 17592186550430} {:answer/id #uuid "8260834a-79a3-569a-85ef-7bdd27d16f5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{x}^{3}+5x+1+\\frac{4}{x+3}" :db/id #edb/ref 17592186550697} {:answer/id #uuid "96603170-09ef-5253-abcf-4c72c537b471" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{x}^{3}+9x-1+\\frac{4}{x+3}" :db/id #edb/ref 17592186550750} {:answer/id #uuid "b6ca52e5-4fd3-53ba-8842-120a1f358cc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{x}^{3}+10x+11-\\frac{4}{x+3}" :db/id #edb/ref 17592186550866}] :answer-field/correct {:db/id #edb/ref 17592186550697} :answer-field/id #uuid "711a21ce-a7d7-5796-93ec-6bc218a77acc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186551129}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8ccbfa58-d595-551b-aac0-8c85b253cfbe" :question/math-academy-id "q-18548" :question/problem "$\\frac{4{x}^{4}+12{x}^{3}+5{x}^{2}+16x+7}{x+3}=$" :question/worked-solution "We can calculate $\\frac{4{x}^{4}+12{x}^{3}+5{x}^{2}+16x+7}{x+3}$ using synthetic division.\n\nCarrying out the synthetic division process, we arrive at the following:\n\n$$\n\\begin{aligned} & {x}^{4} & {x}^{3} & {x}^{2} & {x}^{1} & {x}^{0} \\\\ -3 & 4 & 12 & 5 & 16 & 7 \\\\  & ↓ & -12 & 0 & -15 & -3 \\\\  & 4 & 0 & 5 & 1 & 4\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{4{x}^{4}+12{x}^{3}+5{x}^{2}+16x+7}{x+3}=4{x}^{3}+5x+1+\\frac{4}{x+3}.\\end{aligned}\n$$"} :step/id #uuid "5996360f-63a5-5e3f-a0ef-bac173ffcb52" :step/next {:db/id #edb/ref 17592186551386}}] :activity/title "Dividing Polynomials Using Synthetic Division" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186550353}]}
