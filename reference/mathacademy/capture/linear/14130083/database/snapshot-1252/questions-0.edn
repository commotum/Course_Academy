#{[{:db/id #edb/ref 17592186073469 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073901 :knowledge-point/id #uuid "86c1c87e-1069-52cb-9b60-0c1d9439685c" :knowledge-point/title "Dividing a Whole Number by a Unit Fraction When the Denominator has One Digit"}] :question/id #uuid "469cedf6-ef5d-5dcd-902e-418b6f19e347" :question/math-academy-id "e-13723" :question/problem "Divide $14 \\div \\dfrac{1}{3}$." :question/worked-solution "To divide a whole number by a unit fraction, we multiply the whole number by the fraction's denominator:\n\n$$\n14 \\div \\dfrac{1}{3} = 14 \\times 3 = 42\n$$"}] [{:db/id #edb/ref 17592186073470 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073902 :knowledge-point/id #uuid "2b882300-206f-5ecd-934b-bdf754ad1264" :knowledge-point/title "Dividing a Whole Number by a Unit Fraction When the Denominator has Two Digits"}] :question/id #uuid "a09cb492-4d6a-54ee-884e-fc3ce58bf997" :question/math-academy-id "e-13724" :question/problem "What is the value of $5 \\div \\dfrac{1}{15}$?" :question/worked-solution "To divide a whole number by a unit fraction, we multiply the whole number by the fraction's denominator:\n\n$$\n5 \\div \\dfrac{1}{15} = 5 \\times 15 = 75\n$$"}] [{:db/id #edb/ref 17592186073471 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073903 :knowledge-point/id #uuid "d271bad8-9fd9-5026-a5b1-794acae68937" :knowledge-point/title "Dividing Whole Numbers by Unit Fractions: Word Problems"}] :question/id #uuid "bdc09ee6-a719-5dad-b85e-acb7cdc92458" :question/math-academy-id "e-13725" :question/problem "Johnny has $5$ kilograms of wheat flour with which he wants to make some pizzas. If each pizza needs $\\dfrac{1}{10}$ of a kilogram of wheat flour, how many pizzas can Johnny make?" :question/worked-solution "To determine the number of pizzas that Johnny can make, we divide the amount of wheat flour by the amount of wheat flour each pizza needs.\n\n$$\n5 \\div \\dfrac{1}{10}\n$$\n\nTo divide a whole number by a unit fraction, we multiply the whole number by the fraction's denominator:\n\n$$\n5 \\div \\dfrac{1}{10} = 5 \\times 10 = 50\n$$\n\nTherefore, Johnny can make $50$ pizzas."}] [{:db/id #edb/ref 17592186074278 :knowledge-point/_questions [{:db/id #edb/ref 17592186073901 :knowledge-point/id #uuid "86c1c87e-1069-52cb-9b60-0c1d9439685c" :knowledge-point/title "Dividing a Whole Number by a Unit Fraction When the Denominator has One Digit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2dae040-2aa7-5f1e-94e1-17ec73891956" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186071907} {:answer/id #uuid "db32379a-2e1b-5502-aa35-66b2421d5a86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186071908} {:answer/id #uuid "152d2b89-2e94-5e50-b0ec-2b515a9d364d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186071909} {:answer/id #uuid "3975bf41-2f43-5347-9e05-b3d5df5acdbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{48}" :db/id #edb/ref 17592186071910} {:answer/id #uuid "733c26c9-ec43-5f1f-8c48-8bdc5075cb12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186071911}] :answer-field/id #uuid "347a2e40-487e-571a-a355-c2189818a3af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186071906}] :question/id #uuid "24188be4-f897-5d88-93bf-d94aa3a18852" :question/math-academy-id "q-58251" :question/problem "What is $16 \\div \\frac{1}{3}$?"}]}
