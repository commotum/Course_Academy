[{:db/id 17592186073901 :knowledge-point/questions ["question-1bab1581-b2bd-52e0-83f2-5075b791c4ca"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073469 :question/problem "Divide $14 \\div \\dfrac{1}{3}.$" :db/ensure [:question/validate]} {:db/id 17592186073902 :knowledge-point/questions ["question-a5e99d83-f97d-57a4-a855-63b227f2207d" "question-8649b551-d58d-5fb1-8035-60d54f85b3da"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073470 :question/problem "What is the value of $5 \\div \\dfrac{1}{15} ?$" :db/ensure [:question/validate]} {:db/id 17592186073903 :knowledge-point/questions ["question-658aec27-aa81-5ab9-b28b-831905d10df3" "question-9eecca9a-1e86-596b-8354-5ed75fe894c7"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073471 :question/worked-solution "To determine the number of pizzas that Johnny can make, we divide the amount of wheat flour by the amount of wheat flour each pizza needs.\n\n$$\n5 \\div  \\dfrac{1}{10}\n$$\n\nTo divide a whole number by a unit fraction, we multiply the whole number by the fraction's denominator:\n\n$$\n5 \\div  \\dfrac{1}{10} = 5 \\times 10 = 50\n$$\n\nTherefore, Johnny can make $50$ pizzas." :db/ensure [:question/validate]} {:db/id 17592186074278 :question/problem "$16÷\\frac{1}{3}=$" :question/worked-solution "To divide a whole number by a unit fraction, we multiply the whole number by the fraction's denominator:\n\n$$\n16÷\\frac{1}{3}=16\\times 3=48\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186071906 :answer-field/correct 17592186071911 :db/ensure [:answer-field/validate]} {:db/id "question-1bab1581-b2bd-52e0-83f2-5075b791c4ca" :question/id #uuid "1bab1581-b2bd-52e0-83f2-5075b791c4ca" :question/math-academy-id "q-196227" :question/problem "$5÷\\frac{1}{6}=${{field-1}}" :question/worked-solution "To divide a whole number by a unit fraction, we multiply the whole number by the fraction's denominator:\n\n$$\n5÷\\frac{1}{6}=5\\times 6=30\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a59fb75a-43e0-5d25-8062-6c690b2fa79f"] :db/ensure [:question/validate]} {:db/id "answer-field-a59fb75a-43e0-5d25-8062-6c690b2fa79f" :answer-field/id #uuid "a59fb75a-43e0-5d25-8062-6c690b2fa79f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-bf0fdc4b-847e-5394-a9fc-b9a31b04db0d" :answer-field/choices ["answer-bf0fdc4b-847e-5394-a9fc-b9a31b04db0d"] :db/ensure [:answer-field/validate]} {:db/id "answer-bf0fdc4b-847e-5394-a9fc-b9a31b04db0d" :answer/id #uuid "bf0fdc4b-847e-5394-a9fc-b9a31b04db0d" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "question-a5e99d83-f97d-57a4-a855-63b227f2207d" :question/id #uuid "a5e99d83-f97d-57a4-a855-63b227f2207d" :question/math-academy-id "q-137495" :question/problem "$5÷\\frac{1}{24}=$" :question/worked-solution "To divide a whole number by a unit fraction, we multiply the whole number by the fraction's denominator:\n\n$$\n5÷\\frac{1}{24}=5\\times 24=120\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-92fba68d-563f-5c5b-9418-13bb06c5d231"] :db/ensure [:question/validate]} {:db/id "answer-field-92fba68d-563f-5c5b-9418-13bb06c5d231" :answer-field/id #uuid "92fba68d-563f-5c5b-9418-13bb06c5d231" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bf1008fe-64a5-5936-9660-e23556601188" :answer-field/choices ["answer-bf1008fe-64a5-5936-9660-e23556601188" "answer-6d708983-0677-54bf-8711-cbf9acd99f7e" "answer-dd95461c-c885-5141-8450-a1aedd4d8d6d" "answer-62d66d5d-7d6d-5649-9e5a-503dce3696a1" "answer-d1103087-6014-53f3-921e-fa7566acf3a2"] :db/ensure [:answer-field/validate]} {:db/id "answer-bf1008fe-64a5-5936-9660-e23556601188" :answer/id #uuid "bf1008fe-64a5-5936-9660-e23556601188" :answer/type :answer.type/math :answer/value "120" :db/ensure [:answer/validate]} {: