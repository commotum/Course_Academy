ion/math-academy-id "q-196250" :question/problem "Harvey orders $4$ pizzas for a party. If each pizza is cut so that a slice is $\\frac{1}{8}$ of a pizza, how many slices are there in total?" :question/worked-solution "To find the total number of slices of pizza, we have to divide the number of pizzas by the size of each slice:\n\n$$\n4÷\\frac{1}{8}\n$$\n\nTo divide a whole number by a unit fraction, we multiply the whole number by the fraction's denominator:\n\n$$\n4÷\\frac{1}{8}=4\\times 8=32\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7f533200-5025-59e2-8b6d-a085add13468"] :db/ensure [:question/validate]} {:db/id "answer-field-7f533200-5025-59e2-8b6d-a085add13468" :answer-field/id #uuid "7f533200-5025-59e2-8b6d-a085add13468" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e77dc6f6-3280-5351-b024-ca28dab19047" :answer-field/choices ["answer-e8908587-4e30-56e9-9cdf-60cf20d44173" "answer-afe6d79e-8672-5b47-bbd6-924009c0b142" "answer-577e8faf-139d-561b-aef0-a88343187fcf" "answer-e77dc6f6-3280-5351-b024-ca28dab19047" "answer-659f4f50-73ed-595f-a228-e7d7e8896f73"] :db/ensure [:answer-field/validate]} {:db/id "answer-e8908587-4e30-56e9-9cdf-60cf20d44173" :answer/id #uuid "e8908587-4e30-56e9-9cdf-60cf20d44173" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-afe6d79e-8672-5b47-bbd6-924009c0b142" :answer/id #uuid "afe6d79e-8672-5b47-bbd6-924009c0b142" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "answer-577e8faf-139d-561b-aef0-a88343187fcf" :answer/id #uuid "577e8faf-139d-561b-aef0-a88343187fcf" :answer/type :answer.type/math :answer/value "28" :db/ensure [:answer/validate]} {:db/id "answer-e77dc6f6-3280-5351-b024-ca28dab19047" :answer/id #uuid "e77dc6f6-3280-5351-b024-ca28dab19047" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "answer-659f4f50-73ed-595f-a228-e7d7e8896f73" :answer/id #uuid "659f4f50-73ed-595f-a228-e7d7e8896f73" :answer/type :answer.type/math :answer/value "36" :db/ensure [:answer/validate]} {:db/id "question-9eecca9a-1e86-596b-8354-5ed75fe894c7" :question/id #uuid "9eecca9a-1e86-596b-8354-5ed75fe894c7" :question/math-academy-id "q-91805" :question/problem "Matt wants to distribute $5$ liters of white paint into containers, each having a capacity of $\\frac{1}{5}$ of a liter. How many containers will Matt need?" :question/worked-solution "To determine how many containers Matt will need, we need to divide the amount of paint by the capacity of each container:\n\n$$\n5÷\\frac{1}{5}\n$$\n\nTo divide a whole number by a unit fraction, we multiply the whole number by the fraction's denominator:\n\n$$\n5÷\\frac{1}{5}=5\\times 5=25\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cf8bc3b5-ccef-5f9f-8945-a3356cc439f6"] :db/ensure [:question/validate]} {:db/id "answer-field-cf8bc3b5-ccef-5f9f-8945-a3356cc439f6" :answer-field/id #uuid "cf8bc3b5-ccef-5f9f-8945-a3356cc439f6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-34d8e8e9-2283-5b7a-889d-76444cff35c7" :answer-field/choices ["answer-c40d620f-0974-5d69-8347-d429c46061a6" "answer-b853d495-302b-560c-aa05-9c426f79fbfd" "answer-34d8e8e9-2283-5b7a-889d-76444cff35c7" "answer-b9bedf34-357d-5694-acce-df05be2a52cb" "answer-b085d043-008c-5cc6-802d-d14f429992f9"] :db/ensure [:answer-field/validate]} {:db/id "answer-c40d620f-0974-5d69-8347-d429c46061a6" :answer/id #uuid "c40d620f-0974-5d69-8347-d429c46061a6" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-b853d495-302b-560c-aa05-9c426f79fbfd" :answer/id #uuid "b853d495-302b-560c-aa05-9c426f79fbfd" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-34d8e8e9-2283-5b7a-889d-76444cff35c7" :answer/id #uuid "34d8e8e9-2283-5b7a-889d-76444cff35c7" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "answer-b9bedf34-357d-5694-acce-df05be2a52cb" :answer/id #uuid "b9bedf34-357d-5694-acce-df05be2a52cb" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "answer-b085d043-008c-5cc6-802d-d14f429992f9" :answer/id #uuid "b085d043-008c-5cc6-802d-d14f429992f9" :answer/type :answer.type/math :answer/value "35" :db/ensure [:answer/validate]} {:db/id 17592186075046 :tutorial/content "To divide a whole number by a unit fraction, we can multiply the whole number by the fraction's denominator.\n\nSo, to divide $2 \\div \\dfrac{1}{\\color{blue}5},$ we multiply the $2$ by ${\\color{blue}5}\\!:$\n\n$$\n2 \\div \\dfrac{1}{\\color{blue}5} = 2 \\times {\\color{blue}5} = 10\n$$\n\nAnd that's the answer! Notice that this method does the same job as the fraction model method we used before:\n\n![](images/5f/5f2eb6ab39ea67466d7a42a8809b8a039a84f9a20a13cca3659d81f669a772a5.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186073953 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
