#{[{:db/id #edb/ref 17592186073469 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073901 :knowledge-point/id #uuid "86c1c87e-1069-52cb-9b60-0c1d9439685c" :knowledge-point/title "Dividing a Whole Number by a Unit Fraction When the Denominator has One Digit"}] :question/id #uuid "469cedf6-ef5d-5dcd-902e-418b6f19e347" :question/math-academy-id "e-13723" :question/problem "Divide $14 \\div \\dfrac{1}{3}.$" :question/worked-solution "To divide a whole number by a unit fraction, we multiply the whole number by the fraction's denominator:\n\n$$\n14 \\div \\dfrac{1}{3} = 14 \\times 3 = 42\n$$"}] [{:db/id #edb/ref 17592186073470 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073902 :knowledge-point/id #uuid "2b882300-206f-5ecd-934b-bdf754ad1264" :knowledge-point/title "Dividing a Whole Number by a Unit Fraction When the Denominator has Two Digits"}] :question/id #uuid "a09cb492-4d6a-54ee-884e-fc3ce58bf997" :question/math-academy-id "e-13724" :question/problem "What is the value of $5 \\div \\dfrac{1}{15} ?$" :question/worked-solution "To divide a whole number by a unit fraction, we multiply the whole number by the fraction's denominator:\n\n$$\n5 \\div \\dfrac{1}{15} = 5 \\times 15 = 75\n$$"}] [{:db/id #edb/ref 17592186073471 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073903 :knowledge-point/id #uuid "d271bad8-9fd9-5026-a5b1-794acae68937" :knowledge-point/title "Dividing Whole Numbers by Unit Fractions: Word Problems"}] :question/id #uuid "bdc09ee6-a719-5dad-b85e-acb7cdc92458" :question/math-academy-id "e-13725" :question/problem "Johnny has $5$ kilograms of wheat flour with which he wants to make some pizzas. If each pizza needs $\\dfrac{1}{10}$ of a kilogram of wheat flour, how many pizzas can Johnny make?" :question/worked-solution "To determine the number of pizzas that Johnny can make, we divide the amount of wheat flour by the amount of wheat flour each pizza needs.\n\n$$\n5 \\div  \\dfrac{1}{10}\n$$\n\nTo divide a whole number by a unit fraction, we multiply the whole number by the fraction's denominator:\n\n$$\n5 \\div  \\dfrac{1}{10} = 5 \\times 10 = 50\n$$\n\nTherefore, Johnny can make $50$ pizzas."}] [{:db/id #edb/ref 17592186425909 :knowledge-point/_questions [{:db/id #edb/ref 17592186073902 :knowledge-point/id #uuid "2b882300-206f-5ecd-934b-bdf754ad1264" :knowledge-point/title "Dividing a Whole Number by a Unit Fraction When the Denominator has Two Digits"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62d66d5d-7d6d-5649-9e5a-503dce3696a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{24}{5}" :db/id #edb/ref 17592186425885} {:answer/id #uuid "6d708983-0677-54bf-8711-cbf9acd99f7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "29" :db/id #edb/ref 17592186425887} {:answer/id #uuid "bf1008fe-64a5-5936-9660-e23556601188" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186425893} {:answer/id #uuid "d1103087-6014-53f3-921e-fa7566acf3a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{24}" :db/id #edb/ref 17592186425895} {:answer/id #uuid "dd95461c-c885-5141-8450-a1aedd4d8d6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186425896}] :answer-field/correct {:answer/id #uuid "bf1008fe-64a5-5936-9660-e23556601188" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186425893} :answer-field/id #uuid "92fba68d-563f-5c5b-9418-13bb06c5d231" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425902}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a5e99d83-f97d-57a4-a855-63b227f2