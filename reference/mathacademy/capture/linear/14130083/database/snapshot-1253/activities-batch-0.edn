#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074903} :activity/id #uuid "b8b9ca72-6ee3-5fad-a697-5a0ef1a4574c" :activity/scope {:db/id #edb/ref 17592186049526 :topic/id #uuid "fc49e19b-1ab9-5364-ac0b-4d9b5ebd9a23" :topic/math-academy-id 533} :activity/steps [{:db/id #edb/ref 17592186074903 :step/content {:db/id #edb/ref 17592186075046 :tutorial/content "To divide a whole number by a unit fraction, we can multiply the whole number by the fraction's denominator.\n\nSo, to divide $2 \\div \\dfrac{1}{\\color{blue}5},$ we multiply the $2$ by ${\\color{blue}5}\\!:$\n\n$$\n2 \\div \\dfrac{1}{\\color{blue}5} = 2 \\times {\\color{blue}5} = 10\n$$\n\nAnd that's the answer! Notice that this method does the same job as the fraction model method we used before:\n\n![](images/5f/5f2eb6ab39ea67466d7a42a8809b8a039a84f9a20a13cca3659d81f669a772a5.png)" :tutorial/id #uuid "058743c7-e03e-521c-92ce-c1a5fd00663f" :tutorial/math-academy-id 8572 :tutorial/title "Introduction"} :step/id #uuid "65c45801-df02-5e24-9d1c-d20654b36c65" :step/math-academy-id 93403 :step/next {:db/id #edb/ref 17592186074904}} {:db/id #edb/ref 17592186074904 :step/content {:db/id #edb/ref 17592186073901 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073469 :question/id #uuid "469cedf6-ef5d-5dcd-902e-418b6f19e347" :question/math-academy-id "e-13723"} :knowledge-point/id #uuid "86c1c87e-1069-52cb-9b60-0c1d9439685c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050665}] :knowledge-point/questions [{:db/id #edb/ref 17592186074277} {:db/id #edb/ref 17592186074278} {:db/id #edb/ref 17592186425905}] :knowledge-point/title "Dividing a Whole Number by a Unit Fraction When the Denominator has One Digit"} :step/id #uuid "300cdd9f-b0a5-526a-907d-3323aed6cfc9" :step/math-academy-id 93404 :step/next {:db/id #edb/ref 17592186074905}} {:db/id #edb/ref 17592186074905 :step/content {:db/id #edb/ref 17592186073902 :knowledge-point/canonical-example {:db/id #edb/ref 175