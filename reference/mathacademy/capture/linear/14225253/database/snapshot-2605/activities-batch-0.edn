#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186069552} :activity/id #uuid "a71fc11d-26f8-54c9-8cba-9f88ebf49ad8" :activity/scope {:db/id #edb/ref 17592186050734 :topic/id #uuid "6256411f-5caf-56bd-8434-2969fbc3f5f1" :topic/math-academy-id 388} :activity/steps [{:db/id #edb/ref 17592186069552 :step/content {:db/id #edb/ref 17592186070018 :tutorial/content "Suppose that we wish to solve the compound inequality \n\n$$\n4 \\le x + 2 \\le 8.\n$$\n\nTo solve the compound inequality, we apply the usual operations to the middle of the inequality to isolate $x.$ Keep in mind that whatever we do to the middle, we also need to do to *both* the left-hand *and* right-hand sides.\n\nHere, we can isolate $x$ by subtracting $2\\mathbin{:}$\n\n$$\n\\eqalign{\n\t4 & \\le x + 2 \\le 8 \\[5pt]\n\t4 \\,{\\color{red}-}\\, {\\color{red}{2}} &\\le x + 2 \\,{\\color{red}-}\\, {\\color{red}{2}} \\le 8 \\,{\\color{red}-}\\, {\\color{red}{2}} \\[5pt]\n\t2 &\\le x \\le 6\n}\n$$\n\nTherefore, the solution is $2 \\le x \\le 6.$" :tutorial/id #uuid "6d8fae47-5e67-5793-a585-d3781d5c4555" :tutorial/math-academy-id 8677 :tutorial/title "Introduction"} :step/id #uuid "83b17106-05a3-58df-89b9-4510e4dbee9f" :step/math-academy-id 108821 :step/next {:db/id #edb/ref 17592186069553}} {:db/id #edb/ref 17592186069553 :step/content {:db/id #edb/ref 17592186068685 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068472 :question/id #uuid "0901e241-519b-50ee-ab5f-50b2f631e948" :question/math-academy-id "e-13932"} :knowledge-point/id #uuid "7229f1d0-4ba7-50ff-b5be-5697c886a175" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048312} {:db/id #edb/ref 17592186049051}] :knowledge-point/questions [{:db/id #edb/ref 17592186069227} {:db/id #edb/ref 17592186069464} {:db/id #edb/ref 17592186290304} {:db/id #edb/ref 17592186290305} {:db/id #edb/ref 17592186297226} {:db/id #edb/ref 17592186297299} {:db/id #edb/ref 17592186342101} {:db/id #edb/ref 17592186507422}] 