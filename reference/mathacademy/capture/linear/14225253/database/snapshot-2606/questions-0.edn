#{[{:db/id #edb/ref 17592186069226 :knowledge-point/_questions [{:db/id #edb/ref 17592186068686 :knowledge-point/id #uuid "5930113e-6971-59c9-810a-97fd25bc4f89" :knowledge-point/title "Compound Inequalities That Require Flipping the Inequality Sign"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21b88ace-9390-57a4-b822-7e9f4d518606" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{3}<x<\\frac{17}{3}" :db/id #edb/ref 17592186541494} {:answer/id #uuid "2624632d-58c6-55cc-a5ce-f1a07f1948b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-13<x<17" :db/id #edb/ref 17592186541500} {:answer/id #uuid "60c48b0d-8516-5c9c-b0c0-ca3b48e4e6eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{17}{3}<x<-\\frac{13}{3}" :db/id #edb/ref 17592186541620} {:answer/id #uuid "709295a7-9d6f-5c26-b22c-811e6b3cb1a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{17}{3}<x<\\frac{13}{3}" :db/id #edb/ref 17592186541651} {:answer/id #uuid "f1a50cfa-4654-50d6-90c0-f285448b821d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13<x<17" :db/id #edb/ref 17592186541931}] :answer-field/correct {:answer/id #uuid "21b88ace-9390-57a4-b822-7e9f4d518606" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{3}<x<\\frac{17}{3}" :db/id #edb/ref 17592186541494} :answer-field/id #uuid "c27cbefd-6954-5311-a2c3-8fc6b2f31576" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066534}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "793dd364-450f-5a57-9269-620a4ed6531f" :question/math-academy-id "q-3063" :question/problem "Solve the inequality $-9<-3x+8<-5.$" :question/worked-solution "We isolate $x$ by applying the addition and multiplication principles, as usual. \n\nFirst, we apply the addition principle:\n\n$$\n\\begin{aligned}-9 & <-3x+8<-5 \\\\ -9-8 & <-3x+8-8<-5-8 \\\\ -17 & <-3x<-13\\end{aligned}\n$$\n\nThen, we divide by $-3.$ Note that since we are dividing by a negative number, we need to flip the inequality signs.\n\n$$\n\\begin{aligned}-17 & <-3x<-13 \\\\ \\frac{-17}{-3} & >\\frac{-3x}{-3}>\\frac{-13}{-3} \\\\ \\frac{17}{3} & >x>\\frac{13}{3}\\end{aligned}\n$$\n\n \n\nThe solution can be written as $\\frac{17}{3}>x>\\frac{13}{3}$, but this is somewhat difficult to read because the larger number is on the left rather than the right. So, we will rewrite the solution by reversing the order of the numbers: \n\n$$\n\\frac{13}{3}<x<\\frac{17}{3}\n$$"}] [{:db/id #edb/ref 17592186069351 :knowledge-point/_questions [{:db/id #edb/ref 17592186068687 :knowledge-point/id #uuid "b3ff37f0-6e45-5da4-ac87-1b93c8df3e80" :knowledge-point/title "Representing Solutions of Compound Inequalities on Number Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9110478c-a991-53de-9d31-a7f629a5ad37" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1a/1a309b8253794909323ba60425c22767a428033b1a9ae7ce406cbff737dc285e.png" :db/id #edb/ref 17592186067277} {:answer/id #uuid "a09f76aa-8712-561f-8788-30d2c2a1e487" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b5/b55856fc8211d51c63e00e050ee0b17678208a6c7fd2b106fc2e9a37f43c1fec.png" :db/id #edb/ref 17592186067278} {:answer/id #uuid "a91c2028-f8bd-59fe-afdf-6077c2a88594" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e8/e825e9ccefdbbc09785b5fc1c877d3f8dc039740f4e2d5ad84243dafead1ce19.png" :db/id #edb/ref 17592186067279} {:answer/id #uuid "060ef09e-7f48-5ab1-9c2e-4bea9ff49fa6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/76/76b6a19b3104f122989479a681709af3ca0bf8c05c59f76dc2c7707643980398.png" :db/id #edb/ref 17592186067280} {:answer/id #uuid "44440598-321a-51a4-9930-c9e22cfd29d4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/30/3092ffa9f2feead2598880f35fd7960266b755b10534728a56a5dfd0d49c1054.png" :db/id #edb/ref 17592186067281}] :answer-field/correct {:answer/id #uuid "060ef09e-7f48-5ab1-9c2e-4bea9ff49fa6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/76/76b6a19b3104f122989479a681709af3ca0bf8c05c59f76dc2c7707643980398.png" :db/id #edb/ref 17592186067280} :answer-field/id #uuid "950294dc-00bb-558f-ba1d-e7ce2be43e02" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067276}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a50fbeb7-374f-57aa-97cb-71f55ec85260" :question/math-academy-id "q-44745" :question/problem "Which of the following number lines gives the solution to $-3\\le 2x-1\\le 5?$" :question/worked-solution "We isolate $x$  by applying the addition and multiplication principles, as usual.\n\n$$\n\\begin{aligned}-3 & \\le 2x-1\\le 5 \\\\ -3+1 & \\le 2x-1+1\\le 5+1 \\\\ -2 & \\le 2x\\le 6 \\\\ \\frac{-2}{2} & \\le \\frac{2x}{2}\\le \\frac{6}{2} \\\\ -1 & \\le x\\le 3\\end{aligned}\n$$\n\nWe can represent this solution using a number line, as follows. \n\n![](images/76/76b6a19b3104f122989479a681709af3ca0bf8c05c59f76dc2c7707643980398.png)"}] [{:db/id #edb/ref 17592186069352 :knowledge-point/_questions [{:db/id #edb/ref 17592186068687 :knowledge-point/id #uuid "b3ff37f0-6e45-5da4-ac87-1b93c8df3e80" :knowledge-point/title "Representing Solutions of Compound Inequalities on Number Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93615638-cbb7-575b-b00d-202bb80ca84a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c2/c2d44907a96db2c56e169dd101eaa12fb30708071ff9f89bace604a5debc0a11.png" :db/id #edb/ref 17592186067283} {:answer/id #uuid "a9367703-0297-550c-a9e0-af792bc9e4c2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c4/c4f4ab05b534287dc75765b83dc23cbdfe42044aeddea220510668fbc6b8b51c.png" :db/id #edb/ref 17592186067284} {:answer/id #uuid "e6acad9f-7677-51ae-a16e-82c2a29fec7b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ec/ec2388438d6e5e5d0b48aba6933a4f21d2ed6bc9680d205a01529fd51d1be3d1.png" :db/id #edb/ref 17592186067285} {:answer/id #uuid "fa34fae2-0e28-5995-859c-524ffeeb539b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1d/1d5c3ba6ce6cf5dc1cd628b7ecc9e2c1226df58ab52b140b8fb800057a867b90.png" :db/id #edb/ref 17592186067286} {:answer/id #uuid "fc684b81-529b-5570-87fd-3dbad8f8cd38" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c5/c5e7b54c1556558d66fd6f62d40c4b1c92351546f257b86c8b024019375fce78.png" :db/id #edb/ref 17592186067287}] :answer-field/correct {:answer/id #uuid "a9367703-0297-550c-a9e0-af792bc9e4c2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c4/c4f4ab05b534287dc75765b83dc23cbdfe42044aeddea220510668fbc6b8b51c.png" :db/id #edb/ref 17592186067284} :answer-field/id #uuid "f4bf358a-d06e-5e6d-a366-ff3bf78482b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067282}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bc79035c-5b95-5816-b7f8-1b0d00701572" :question/math-academy-id "q-44758" :question/problem "Which of the following number lines gives the solution to $-5\\le -2x+3\\le 5?$" :question/worked-solution "We isolate $x$ by applying the addition and multiplication principles, as usual. \n\nFirst, we apply the addition principle:\n\n$$\n\\begin{aligned}-5 & \\le -2x+3\\le 5 \\\\ -5-3 & \\le -2x+3-3\\le 5-3 \\\\ -8 & \\le -2x\\le 2\\end{aligned}\n$$\n\nThen, we divide by $-2.$ Note that since we are dividing by a negative number, we need to flip the inequality signs. \n\n$$\n\\begin{aligned}-8 & \\le -2x\\le 2 \\\\ \\frac{-8}{-2} & \\ge \\frac{-2x}{-2}\\ge \\frac{2}{-2} \\\\ \\frac{8}{2} & \\ge x\\ge -\\frac{2}{2} \\\\ 4 & \\ge x\\ge -1\\end{aligned}\n$$\n\nThe solution can be written as $4\\ge x\\ge -1$, but this is somewhat difficult to read because the larger number is on the left rather than the right. So, we will rewrite the solution by reversing the order of the numbers: \n\n$$\n-1\\le x\\le 4\n$$\n\nWe can represent this solution using a number line, as follows.\n\n![](images/c4/c4f4ab05b534287dc75765b83dc23cbdfe42044aeddea220510668fbc6b8b51c.png)"}]}
