#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186116396} :activity/id #uuid "3186d920-ff1f-5f36-a31d-2756c7f5f4f9" :activity/scope {:db/id #edb/ref 17592186048472 :topic/id #uuid "a26cd4f5-8420-5521-8401-af794c94636b" :topic/math-academy-id 1644} :activity/steps [{:db/id #edb/ref 17592186116268 :step/content {:db/id #edb/ref 17592186115336 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115160 :question/id #uuid "43c770ec-d353-5e9e-b44e-f06417dab2ab" :question/math-academy-id "e-9731"} :knowledge-point/id #uuid "6a916099-a237-5612-b7f1-3679b7ff069d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048723} {:db/id #edb/ref 17592186049949} {:db/id #edb/ref 17592186050410}] :knowledge-point/questions [{:db/id #edb/ref 17592186115491} {:db/id #edb/ref 17592186115655} {:db/id #edb/ref 17592186253502} {:db/id #edb/ref 17592186253503} {:db/id #edb/ref 17592186269004} {:db/id #edb/ref 17592186294980} {:db/id #edb/ref 17592186500347}] :knowledge-point/title "Calculating an Unknown Angle"} :step/id #uuid "9cedeba2-5a6c-5062-880b-beb7fa0aa70f" :step/math-academy-id 36502} {:db/id #edb/ref 17592186116396 :step/content {:db/id #edb/ref 17592186116449 :tutorial/content "Consider $\\triangle ABC$ shown below. \n\n![](images/6f/6fdb9a8337d16f1ef1910989b3df92844c5393c33108f98ae7993cc939bed0b3.png)\n\nNow, let's draw a line segment that \n\n- runs from $\\color{blue}C$ to the line ${\\color{red}\\overset{\\longleftrightarrow}{AB}},$ and\n\n- is *perpendicular* to ${\\color{red}\\overset{\\longleftrightarrow}{AB}}.$\n\nThis line segment is the dashed segment shown below:\n\n![](images/4a/4a7ee2771c9b0c60dbb07c43b0439e822ea9b2c261ac41af9b44fec72b9f2a91.png)\n\nFinally, let's label the other endpoint of our segment ${\\color{blue}{H}}.$\n\n![](images/75/758eab533719220515460b6677054438a9ac0e2701d1a5267b973e526f63bd90.png)\n\nNote the following:\n\n- The line segment ${\\color{blue}\\overline{CH}}$ is called the **height** (or **altitude**) *corresponding to* ${\\color{red}\\overset{\\longleftrightarrow}{AB}}.$\n\n- The line $\\overset{\\longleftrightarrow}{AB}$ is called the **base** of the altitude ${\\color{blue}\\overline{CH}}.$\n\nAs we'll soon discover, the heights and their corresponding bases are important attributes of triangles." :tutorial/id #uuid "bdb9bfbd-b830-51f0-8712-5d34f83f2812" :tutorial/math-academy-id 2232 :tutorial/title "Introduction"} :step/id #uuid "4231f520-72fe-5c14-8733-25cc76a6e65e" :step/math-academy-id 9151 :step/next {:db/id #edb/ref 17592186116397}} {:db/id #edb/ref 17592186116397 :step/content {:db/id #edb/ref 17592186115409 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114985 :question/id #uuid "972fe403-9a15-5d10-8f9f-f5c93eb586ff" :question/math-academy-id "e-2725"} :knowledge-point/id #uuid "f7e817a0-edcf-54ca-ba4c-ffe91af04675" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050357}] :knowledge-point/questions [{:db/id #edb/ref 17592186115646} {:db/id #edb/ref 17592186115952} {:db/id #edb/ref 17592186253495} {:db/id #edb/ref 17592186253496} {:db/id #edb/ref 17592186294864} {:db/id #edb/ref 17592186386882} {:db/id #edb/ref 17592186393737} {:db/id #edb/ref 17592186500371}] :knowledge-point/title "Finding a Height of a Triangle"} :step/id #uuid "52e4c58c-e58e-5223-98e5-cc31383de47c" :step/math-academy-id 9154 :step/next {:db/id #edb/ref 17592186116398}} {:db/id #edb/ref 17592186116398 :step/content {:db/id #edb/ref 17592186116450 :tutorial/content "We can draw exactly three heights (or altitudes) in any triangle. However, sometimes the height lies outside the triangle.\n\nTo demonstrate, consider $\\triangle{ABC}$ below.\n\n![](images/df/df1ac2c1074305f8ead506d9aeb8c3927ad51ae5949b45976f1971b52d402ee5.png)\n\nThe height corresponding to $\\overline{BC}$ is a line segment that \n\n- runs from the opposite vertex $A$ to the line $\\overset{\\longleftrightarrow}{BC},$ and\n\n- is perpendicular to $\\overset{\\longleftrightarrow}{BC}.$\n\nIn this case, it's impossible to draw a perpendicular from $A$ to the *segment* $\\overline{BC}.$ However, we can first *extend* the line segment $\\overline{BC}$ as follows:\n\n![](images/26/26bf9eb8af1e9b71c263c08cae5797d5c911410985cdc01213ac2c295f7b8d46.png)\n\nNow, we draw the perpendicular from $A$ to $\\overset{\\longleftrightarrow}{BC}.$ This gives the height $\\overline{AH}{:}$\n\n![](images/89/894686fce1393ebcf998be6885020627c9f3cde5916adfec67234f15f8895826.png)" :tutorial/id #uuid "4031d801-f4b8-543f-ad4d-9ef60d513427" :tutorial/math-academy-id 2236 :tutorial/title "Case of Extended Bases"} :step/id #uuid "b9f034d0-1d0e-54ea-83b8-ad683048d5c5" :step/math-academy-id 9158 :step/next {:db/id #edb/ref 17592186116399}} {:db/id #edb/ref 17592186116399 :step/content {:db/id #edb/ref 17592186115410 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114986 :question/id #uuid "2e6213d0-702f-5795-a99a-0051790c4e6d" :question/math-academy-id "e-2730"} :knowledge-point/id #uuid "6a76efbd-cefd-5aa0-953e-8ab50bec7ae0" :knowledge-point/questions [{:db/id #edb/ref 17592186115647} {:db/id #edb/ref 17592186115648} {:db/id #edb/ref 17592186253497} {:db/id #edb/ref 17592186335937} {:db/id #edb/ref 17592186392742} {:db/id #edb/ref 17592186392952} {:db/id #edb/ref 17592186500367}] :knowledge-point/title "Finding a Height Corresponding to an Extended Base"} :step/id #uuid "25c91feb-798e-5857-9090-3b36088bc71b" :step/math-academy-id 9160 :step/next {:db/id #edb/ref 17592186116268}}] :activity/title "Heights of Triangles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115444}]}
