sure [:answer/validate]} {:db/id "answer-a6d82e2b-0ecc-526b-9eb6-a44795cb542a" :answer/id #uuid "a6d82e2b-0ecc-526b-9eb6-a44795cb542a" :answer/type :answer.type/math :answer/value "\\frac{9}{8}" :db/ensure [:answer/validate]} {:db/id "question-6fbf46e4-e331-5a14-bc02-52e16b8368d7" :question/id #uuid "6fbf46e4-e331-5a14-bc02-52e16b8368d7" :question/math-academy-id "q-91610" :question/problem "$\\frac{5}{3}\\times \\frac{1}{10}=$" :question/worked-solution "To multiply two fractions, we multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{5}{3}\\times \\frac{1}{10}=\\frac{5\\times 1}{3\\times 10}=\\frac{5}{30}\n$$\n\nWe reduce this fraction to its simplest form by dividing the numerator and denominator by $5:$\n\n$$\n\\frac{5}{30}=\\frac{5÷5}{30÷5}=\\frac{1}{6}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-84ce97d9-42c8-5a08-a2c0-220b53589fb0"] :db/ensure [:question/validate]} {:db/id "answer-field-84ce97d9-42c8-5a08-a2c0-220b53589fb0" :answer-field/id #uuid "84ce97d9-42c8-5a08-a2c0-220b53589fb0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-30f67a32-ba23-59fb-a6ce-1dc06c34fd71" :answer-field/choices ["answer-08d6b300-e2c2-5024-b124-93fe05fafccd" "answer-33228a6f-5775-55b2-bf66-7802da89edd1" "answer-30f67a32-ba23-59fb-a6ce-1dc06c34fd71" "answer-12b34826-79e4-5cc8-8988-fd4ca4540056" "answer-ce3a8ef2-dc7f-596a-9ee5-6923023e8306"] :db/ensure [:answer-field/validate]} {:db/id "answer-08d6b300-e2c2-5024-b124-93fe05fafccd" :answer/id #uuid "08d6b300-e2c2-5024-b124-93fe05fafccd" :answer/type :answer.type/math :answer/value "\\frac{1}{15}" :db/ensure [:answer/validate]} {:db/id "answer-33228a6f-5775-55b2-bf66-7802da89edd1" :answer/id #uuid "33228a6f-5775-55b2-bf66-7802da89edd1" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-30f67a32-ba23-59fb-a6ce-1dc06c34fd71" :answer/id #uuid "30f67a32-ba23-59f