#{[{:activity/first-step {:db/id #edb/ref 17592186143666} :activity/id #uuid "cffad18d-56c6-5546-8bee-5c631a66739a" :activity/scope {:db/id #edb/ref 17592186049253 :topic/id #uuid "e6d4682e-e5ec-5a7f-a918-a708b14b5010" :topic/math-academy-id 2378} :activity/steps [{:db/id #edb/ref 17592186143666 :step/content {:db/id #edb/ref 17592186144091 :tutorial/content "To multiply fractions, we multiply the numerators, multiply the denominators, and simplify (if necessary).\n\nFor example, to multiply\n\n$$\n\\dfrac 1 {2} \\times \\dfrac 1 {3}\n$$\n\nwe multiply the numerators and we multiply the denominators:\n\n$$\n\\dfrac{\\color{blue}1}{\\color{red}2} \\times \\dfrac{\\color{blue}1}{\\color{red}3} = \\dfrac {{\\color{blue}1}\\times {\\color{blue}1}} {{\\color{red}2}\\times {\\color{red}3}} = \\dfrac{1}{6}\n$$\n\nNotice that we get the same answer when we use a fraction model.\n\n![](images/6d/6d4a0a382c9624510581d94e5829b2be6907e493aaba20eb471901f061b87820.png)" :tutorial/id #uuid "a71c2faa-d009-5288-8863-51238a73c406" :tutorial/math-academy-id 8927 :tutorial/title "Introduction"} :step/id #uuid "34b8df92-1cb5-5d85-b9c3-c28c62faa4f4" :step/math-academy-id 135462 :step/next {:db/id #edb/ref 17592186143667}} {:db/id #edb/ref 17592186143667 :step/content {:db/id #edb/ref 17592186142795 :knowledge-point/canonical-example {:db/id #edb/ref 17592186142638 :question/id #uuid "cb9425fb-6e26-5706-ada1-105bd2dbf545" :question/math-academy-id "e-14426"} :knowledge-point/id #uuid "919df631-8d1d-59bf-9818-874a52f3bfe0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048962}] :knowledge-point/questions [{:db/id #edb/ref 17592186143269} {:db/id #edb/ref 17592186143286}] :knowledge-point/title "Multiplying Fractions by Unit Fractions"} :step/id #uuid "ad2aa659-63dd-584a-b088-2ba77cc88124" :step/math-academy-id 135463 :step/next {:db/id #edb/ref 17592186143668}} {:db/id #edb/ref 17592186143668 :step/content {:db/id #edb/ref 17592186142796 :knowledge-point/canonical-example {:d