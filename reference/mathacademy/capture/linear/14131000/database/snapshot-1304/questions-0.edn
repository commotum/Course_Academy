#{[{:db/id #edb/ref 17592186142638 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142795 :knowledge-point/id #uuid "919df631-8d1d-59bf-9818-874a52f3bfe0" :knowledge-point/title "Multiplying Fractions by Unit Fractions"}] :question/id #uuid "cb9425fb-6e26-5706-ada1-105bd2dbf545" :question/math-academy-id "e-14426" :question/problem "Find the value of $\\dfrac 3 {7} \\times \\dfrac 1 {4}$." :question/worked-solution "To multiply two fractions, we multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac 3 {7} \\times \\dfrac 1 {4} = \\dfrac {3\\times 1} {7\\times 4} = \\dfrac{3}{28}\n$$"}] [{:db/id #edb/ref 17592186142639 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142796 :knowledge-point/id #uuid "476cf433-d982-5f14-89be-48aea2abaf55" :knowledge-point/title "Multiplying Fractions"}] :question/id #uuid "895012bb-d418-5720-92c1-771fa03ec8b6" :question/math-academy-id "e-14430" :question/problem "Multiply $\\dfrac 2 {9} \\times \\dfrac 4 {5}$." :question/worked-solution "To multiply two fractions, we multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac 2 {9} \\times \\dfrac 4 {5} = \\dfrac {2\\times 4} {9\\times 5} = \\dfrac{8}{45}\n$$"}] [{:db/id #edb/ref 17592186142640 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142797 :knowledge-point/id #uuid "926cd557-6aff-5864-a16b-023793a1e95d" :knowledge-point/title "Multiplying Fractions When Simplification is Needed"}] :question/id #uuid "c749c71d-16bc-5b50-b013-8c049618b073" :question/math-academy-id "e-14431" :question/problem "Multiply $\\dfrac 5 {6} \\times \\dfrac 3 {4}$." :question/worked-solution "To multiply two fractions, we multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac 5 {6} \\times \\dfrac 3 {4} = \\dfrac {5\\times 3} {6\\times 4} = \\dfrac{15}{24}\n$$\n\nWe reduce this fraction to its simplest form by dividing the numerator and denominator by $3$:\n\n$$\n\\dfrac {15} {24} = \\dfrac {15\\div 3} {24\\div 3} = \\dfrac{5}{8}\n$$"}] [{:db/id #edb/ref 17592186143084 :knowledge-point/_questions [{:db/id #edb/ref 17592186142796 :knowledge-point/id #uuid "476cf433-d982-5f14-89be-48aea2abaf55" :knowledge-point/title "Multiplying Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "886dc980-209c-56d7-9a2d-43c5054be038" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{63}{8}" :db/id #edb/ref 17592186139817} {:answer/id #uuid "c29a8bda-420b-5181-8a18-e9d67e9bd293" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{54}{7}" :db/id #edb/ref 17592186139818} {:answer/id #uuid "cb9958ff-51f4-5298-b02b-cbbdd2d59d16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{6}" :db/id #edb/ref 17592186139819} {:answer/id #uuid "0044581f-c087-5a40-87bd-77b7014c8549" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186139820} {:answer/id #uuid "5c354bcd-5dfe-5b54-8b2f-4fcc409fd9c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{24}{9}" :db/id #edb/ref 17592186139821}] :answer-field/id #uuid "2a00fd77-a1be-52fd-ae5d-69d8c767f692" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186139816}] :question/id #uuid "a8ef56ac-5d4b-50c1-b024-31e951d38aea" :question/math-academy-id "q-136702" :question/problem "What is $\\frac{7}{2} \\cdot \\frac{9}{4}$?"}]}
