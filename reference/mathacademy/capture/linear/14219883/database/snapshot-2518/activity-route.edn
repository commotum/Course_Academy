#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186531684} :activity/id #uuid "3a7cc79b-02e8-5c46-8409-33face8b5d86" :activity/scope {:db/id #edb/ref 17592186049355 :topic/id #uuid "ee459d83-61aa-5856-8bac-7a5980791833" :topic/math-academy-id 1131} :activity/steps [{:db/id #edb/ref 17592186531684 :step/content {:db/id #edb/ref 17592186531647 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "522a5cb8-0595-52ba-9fc4-f068d4c71551" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6.5}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531044} {:answer/id #uuid "9f446274-2a06-55e0-8045-82df46c8c668" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5.5}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531210} {:answer/id #uuid "bd2b2c82-d14e-5b84-a678-29528d106c3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5.1}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531265} {:answer/id #uuid "cecbd7c4-4b6e-5c63-af83-fbf23e812e6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5.7}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531293} {:answer/id #uuid "ffb4664a-819a-5fb1-8000-71d73f25fc83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6.1}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531382}] :answer-field/correct {:db/id #edb/ref 17592186531382} :answer-field/id #uuid "36172dc8-5c18-5ef5-9115-2e2f3e7fffef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186531430}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "de213b3e-d398-5228-8036-33cbe3a6bb3b" :question/math-academy-id "q-68888" :question/problem "Jordan did an experiment in his Chemistry class. He heated a liquid whose initial temperature was $-{1.2}^{∘}\\,\\text{C}.$ After several minutes, the temperature of the liquid increased by ${7.3}^{∘}\\,\\text{C}$, at which point he decided to end the experiment. What was the final temperature of the liquid?" :question/worked-solution "To determine the final temperature of the liquid, we add the variation in temperature to the initial temperature of the liquid. This gives\n\n$$\n-{1.2}^{∘}\\,\\text{C}+{7.3}^{∘}\\,\\text{C}={6.1}^{∘}\\,\\text{C}.\n$$\n\nTherefore, the temperature of the liquid at the end of the experiment was ${6.1}^{∘}\\,\\text{C}.$"} :step/id #uuid "4312b0ab-5d64-50e6-af89-0104161e7489" :step/next {:db/id #edb/ref 17592186531721}} {:db/id #edb/ref 17592186531707 :step/content {:db/id #edb/ref 17592186531557 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18077ca4-3183-5672-8449-0b9577e66287" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{20.0}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186530910} {:answer/id #uuid "27359f95-680c-5018-a7ac-5a2779c5560b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{19.4}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186530953} {:answer/id #uuid "6703364e-cb34-54b1-bbee-575941b2ee4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{19.0}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531093} {:answer/id #uuid "74447b91-7282-514f-97dd-a72921fec8a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{18.0}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531121} {:answer/id #uuid "7eaacb5e-d719-5348-ada6-db919d5cf4fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{18.4}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531141}] :answer-field/correct {:db/id #edb/ref 17592186530953} :answer-field/id #uuid "e8439ccf-f19f-54b5-951f-b6eba6db8136" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186531540}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "02fcb6dd-d8d1-548e-be72-9006c65abdf0" :question/math-academy-id "q-72691" :question/problem "Chantelle did an experiment in her Chemistry class. She heated a liquid whose initial temperature was $-{5.3}^{∘}\\,\\text{C}.$ After several minutes, the temperature of the liquid increased by ${24.7}^{∘}\\,\\text{C}$, at which point she decided to end the experiment. What was the final temperature of the liquid?" :question/worked-solution "To determine the final temperature of the liquid, we add the variation in temperature to the initial temperature of the liquid. This gives\n\n$$\n-{5.3}^{∘}\\,\\text{C}+{24.7}^{∘}\\,\\text{C}={19.4}^{∘}\\,\\text{C}.\n$$\n\nTherefore, the temperature of the liquid at the end of the experiment was ${19.4}^{∘}\\,\\text{C}.$"} :step/id #uuid "b3d2d012-a306-590e-b68d-a518598a0966"} {:db/id #edb/ref 17592186531721 :step/content {:db/id #edb/ref 17592186531630 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0233853c-7d57-5992-a3de-9375ae31e3e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{2.9}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186530866} {:answer/id #uuid "11599972-180e-564a-8500-e2e61a9c6541" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{3.7}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186530894} {:answer/id #uuid "11d8cfac-231b-5b5e-a776-de1a254087fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{5.3}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186530897} {:answer/id #uuid "565ce699-4384-5be5-a535-10eb3fabc2a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{5.5}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531053} {:answer/id #uuid "64fa1bca-1096-5716-a7aa-e09d16681a32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{3.4}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531087}] :answer-field/correct {:db/id #edb/ref 17592186530894} :answer-field/id #uuid "89a90e23-11a2-5c55-80c6-c90a2ec355b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186531479}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aab3a1fe-f42d-5861-9d8c-8da472abefec" :question/math-academy-id "q-68925" :question/problem "In Toronto, Canada, the average temperature in November is ${4.9}^{∘}\\,\\text{C}.$ In December, the average temperature decreases by ${5.4}^{∘}\\,\\text{C}$ compared to November. Finally, in January, the average temperature decreases by ${3.2}^{∘}\\,\\text{C}$ compared to the previous month. Determine the average temperature in Toronto in January." :question/worked-solution "First, we must determine the average temperature in Toronto during the month of December. Since we know that the temperature decreases on average by ${5.4}^{∘}\\,\\text{C}$ compared to November, we subtract the variation in temperature from the average temperature in November. This gives\n\n$$\n{4.9}^{∘}\\,\\text{C}-{5.4}^{∘}\\,\\text{C}=-{0.5}^{∘}\\,\\text{C}.\n$$\n\nNow, we must determine the temperature during the month of January. Since we know that the temperature decreases on average by ${3.2}^{∘}\\,\\text{C}$ compared to December, we subtract the variation in temperature from the average temperature in December. This gives\n\n$$\n-{0.5}^{∘}\\,\\text{C}-{3.2}^{∘}\\,\\text{C}=-{3.7}^{∘}\\,\\text{C}.\n$$\n\nTherefore, the average temperature in Toronto in January is $-{3.7}^{∘}\\,\\text{C}.$"} :step/id #uuid "ddd3f114-58f8-562c-960c-b5c342a5bcb5" :step/next {:db/id #edb/ref 17592186531707}}] :activity/title "Solving Problems Using Addition and Subtraction of Rational Numbers" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186530855}]}
