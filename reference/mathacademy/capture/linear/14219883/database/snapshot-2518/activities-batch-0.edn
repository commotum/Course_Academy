 #edb/ref 17592186096465 :question/id #uuid "856921bd-1130-5b5f-8979-55ff188ac9ff" :question/math-academy-id "e-4763"} :knowledge-point/id #uuid "1ff8566a-bc65-50a8-bd72-354631883152" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049626}] :knowledge-point/questions [{:db/id #edb/ref 17592186097327} {:db/id #edb/ref 17592186097328} {:db/id #edb/ref 17592186446302} {:db/id #edb/ref 17592186446307} {:db/id #edb/ref 17592186446308} {:db/id #edb/ref 17592186531559}] :knowledge-point/title "Subtracting a Negative Number"} :step/id #uuid "b2f9b640-68f3-53a2-8b75-4c6d5d6dd4a5" :step/math-academy-id 17353 :step/next {:db/id #edb/ref 17592186097529}} {:db/id #edb/ref 17592186097529 :step/content {:db/id #edb/ref 17592186096679 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096466 :question/id #uuid "a596d16e-8e1b-5c20-8d82-b25e5b746955" :question/math-academy-id "e-4764"} :knowledge-point/id #uuid "3c9e3ef7-2d6f-526e-9ceb-fb21040b639e" :knowledge-point/questions [{:db/id #edb/ref 17592186097333} {:db/id #edb/ref 17592186097334} {:db/id #edb/ref 17592186446304} {:db/id #edb/ref 17592186446306} {:db/id #edb/ref 17592186531630}] :knowledge-point/title "Combining Operations on Negative Numbers"} :step/id #uuid "ba0cdcf3-57a5-532a-a328-3b1526e640a6" :step/math-academy-id 17354} {:db/id #edb/ref 17592186097538 :step/content {:db/id #edb/ref 17592186097845 :tutorial/content "We can solve some real-world problems using addition and subtraction of real numbers.\n\n- We use addition when there is an increase in the data.\n\n- We use subtraction to find a difference, or when there is a decrease in the data.\n\nLet's see some examples." :tutorial/id #uuid "fb231454-f74e-5ee3-a4b4-f0ede88e0eca" :tutorial/math-academy-id 3263 :tutorial/title "Introduction"} :step/id #uuid "5d30e33d-032b-5a2f-8701-d926f3d4c70e" :step/math-academy-id 17961 :step/next {:db/id #edb/ref 17592186097526}}] :activity/title "Solving Problems Using Addition and Subtraction of Rational Numbers" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186096903}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186501297} :activity/id #uuid "6717b18e-0ae6-5129-8fd0-6d170c347d50" :activity/scope {:db/id #edb/ref 17592186049355 :topic/id #uuid "ee459d83-61aa-5856-8bac-7a5980791833" :topic/math-academy-id 1131} :activity/steps [{:db/id #edb/ref 17592186501281 :step/content {:db/id #edb/ref 17592186097334 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43af25d8-92f4-5878-a3dc-1e644c8ce222" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{4.1}^{∘}\\text{C}" :db/id #edb/ref 17592186500598} {:answer/id #uuid "5af32836-d1a7-5d0a-943b-b796a712c9a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5.4}^{∘}\\text{C}" :db/id #edb/ref 17592186500653} {:answer/id #uuid "89cd1393-5088-5478-9c9a-365dbf9b98ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{4.5}^{∘}\\text{C}" :db/id #edb/ref 17592186500756} {:answer/id #uuid "a8e8a032-002e-52f4-b130-3642ea6a8d2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{4.9}^{∘}\\text{C}" :db/id #edb/ref 17592186500816} {:answer/id #uuid "aee93dc4-7161-5dc3-8fb5-fae906b155a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{3.8}^{∘}\\text{C}" :db/id #edb/ref 17592186500833}] :answer-field/correct {:db/id #edb/ref 17592186500653} :answer-field/id #uuid "1e8d554f-b2db-5405-9a00-6a130d18be15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186095928}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8ee7811c-bbf0-5938-a2b2-9a34707608bb" :question/math-academy-id "q-68929" :question/problem "Jennifer is doing a science experiment in her Chemistry class. She takes a liquid with a temperature of ${10.1}^{∘}\\text{C}$ and places it in a refrigerator. After half an hour, she removes the liquid from the refrigerator and places it on a table. She concludes that the temperature decreased by ${12.7}^{∘}\\text{C}.$\n\nAfter half an hour, Jennifer takes the temperature of the liquid again and finds that the temperature increased by ${8}^{∘}\\text{C}.$ What is the final temperature of the liquid?" :question/worked-solution "First of all, we must determine the temperature of the liquid when it was removed from the refrigerator. Since its temperature decreased by ${12.7}^{∘}\\text{C}$ compared to the initial temperature, we must subtract the variation in temperature from the initial temperature. This gives\n\n$$\n{10.1}^{∘}\\text{C}-{12.7}^{∘}\\text{C}=-{2.6}^{∘}\\text{C}.\n$$\n\nNow, we must determine the temperature of the liquid after half an hour had elapsed. Since the temperature of the liquid increased by ${8}^{∘}\\text{C}$ compared to the temperature when it was removed from the refrigerator, we add the variation in temperature to the temperature of the liquid when it was removed from the refrigerator. This gives\n\n$$\n-{2.6}^{∘}\\text{C}+{8}^{∘}\\text{C}={5.4}^{∘}\\text{C}.\n$$\n\nTherefore, the final temperature of the liquid is ${5.4}^{∘}\\text{C}.$"} :step/id #uuid "b210e935-1e45-56a0-b060-d68f4c88d265"} {:db/id #edb/ref 17592186501285 :step/content {:db/id #edb/ref 17592186097332 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b50f720-834e-538d-a417-e00fac3153c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{1.2}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186500555} {:answer/id #uuid "51dca9e2-de80-5c9d-8a95-e67f670877be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{1.3}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186500635} {:answer/id #uuid "775a09e2-42f5-548f-8dd4-b32b4dc2ffac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{1.7}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186500714} {:answer/id #uuid "a5596099-ee8b-5cf9-8adb-ce7fa5b6cd6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{2.3}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186500805} {:answer/id #uuid "e2d3652a-d1a5-5019-9d30-94746544d406" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{2.1}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186500948}] :answer-field/correct {:db/id #edb/ref 17592186500714} :answer-field/id #uuid "03913dbe-158c-5e69-a492-f412ab726635" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186095916}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0f9448c2-f63c-5cfa-ac1b-26b1b5d3b6f6" :question/math-academy-id "q-68889" :question/problem "On a certain day in January, the temperature in New York in the morning was $-{2.4}^{∘}\\,\\text{C}.$ At noon, the temperature registered a slight increase of ${0.7}^{∘}\\,\\text{C}.$ What was the temperature in New York at noon?" :question/worked-solution "To determine the temperature at noon, we add the variation in temperature to the temperature in the morning of that day This gives\n\n$$\n-{2.4}^{∘}\\,\\text{C}+{0.7}^{∘}\\,\\text{C}=-{1.7}^{∘}\\,\\text{C}.\n$$\n\nTherefore, the temperature in New York at noon that day was $-{1.7}^{∘}\\,\\text{C}.$"} :step/id #uuid "b66eda3a-f894-548a-a50a-1339b390ccd6" :step/next {:db/id #edb/ref 17592186501281}} {:db/id #edb/ref 17592186501297 :step/content {:db/id #edb/ref 17592186097327 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43d5adc5-a2eb-531a-b7ea-b5939b327f6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11\\,\\text{m}" :db/id #edb/ref 17592186500599} {:answer/id #uuid "86933486-a8ce-5022-91e0-69867dfc556a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14\\,\\text{m}" :db/id #edb/ref 17592186500748} {:answer/id #uuid "a0f2cce9-f1d9-5104-a5a1-b0915a465a5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15\\,\\text{m}" :db/id #edb/ref 17592186500794} {:answer/id #uuid "bb2d2cd5-3aa6-5d90-8deb-5b7155be97f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\,\\text{m}" :db/id #edb/ref 17592186500856} {:answer/id #uuid "e5cee887-50b6-56ef-81f1-ae790574664e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16\\,\\text{m}" :db/id #edb/ref 17592186500957}] :answer-field/correct {:db/id #edb/ref 17592186500794} :answer-field/id #uuid "813aaeae-688c-5e88-936e-02dac71e1499" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186095886}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "beabbd10-476d-53ed-8111-c1ff6cabe7de" :question/math-academy-id "q-68474" :question/problem "Margaret and Juan like freediving. One day they both went to the sea, and while Juan practiced this extreme sport $13$ meters below sea level, Margaret waited for him in the boat, $2$ meters above sea level. If Juan is below Margaret, how far apart are they from each other?" :question/worked-solution "To determine the distance between Margaret and Juan, we calculate the difference between Margaret's location and Juan's location. This gives\n\n$$\n2-(-13)=2+13=15\\,\\text{m}.\n$$\n\nTherefore, Margaret and Juan are $15\\,\\text{m}$ apart."} :step/id #uuid "f6f16938-eb50-51e6-8e2a-41104a49a9ed" :step/next {:db/id #edb/ref 17592186501285}}] :activity/title "Solving Problems Using Addition and Subtraction of Rational Numbers" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186500463}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186531684} :activity/id #uuid "3a7cc79b-02e8-5c46-8409-33face8b5d86" :activity/scope {:db/id #edb/ref 17592186049355 :topic/id #uuid "ee459d83-61aa-5856-8bac-7a5980791833" :topic/math-academy-id 1131} :activity/steps [{:db/id #edb/ref 17592186531684 :step/content {:db/id #edb/ref 17592186531647 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "522a5cb8-0595-52ba-9fc4-f068d4c71551" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6.5}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531044} {:answer/id #uuid "9f446274-2a06-55e0-8045-82df46c8c668" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5.5}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531210} {:answer/id #uuid "bd2b2c82-d14e-5b84-a678-29528d106c3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5.1}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531265} {:answer/id #uuid "cecbd7c4-4b6e-5c63-af83-fbf23e812e6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5.7}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531293} {:answer/id #uuid "ffb4664a-819a-5fb1-8000-71d73f25fc83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6.1}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531382}] :answer-field/correct {:db/id #edb/ref 17592186531382} :answer-field/id #uuid "36172dc8-5c18-5ef5-9115-2e2f3e7fffef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186531430}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "de213b3e-d398-5228-8036-33cbe3a6bb3b" :question/math-academy-id "q-68888" :question/problem "Jordan did an experiment in his Chemistry class. He heated a liquid whose initial temperature was $-{1.2}^{∘}\\,\\text{C}.$ After several minutes, the temperature of the liquid increased by ${7.3}^{∘}\\,\\text{C}$, at which point he decided to end the experiment. What was the final temperature of the liquid?" :question/worked-solution "To determine the final temperature of the liquid, we add the variation in temperature to the initial temperature of the liquid. This gives\n\n$$\n-{1.2}^{∘}\\,\\text{C}+{7.3}^{∘}\\,\\text{C}={6.1}^{∘}\\,\\text{C}.\n$$\n\nTherefore, the temperature of the liquid at the end of the experiment was ${6.1}^{∘}\\,\\text{C}.$"} :step/id #uuid "4312b0ab-5d64-50e6-af89-0104161e7489" :step/next {:db/id #edb/ref 17592186531721}} {:db/id #edb/ref 17592186531707 :step/content {:db/id #edb/ref 17592186531557 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18077ca4-3183-5672-8449-0b9577e66287" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{20.0}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186530910} {:answer/id #uuid "27359f95-680c-5018-a7ac-5a2779c5560b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{19.4}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186530953} {:answer/id #uuid "6703364e-cb34-54b1-bbee-575941b2ee4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{19.0}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531093} {:answer/id #uuid "74447b91-7282-514f-97dd-a72921fec8a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{18.0}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531121} {:answer/id #uuid "7eaacb5e-d719-5348-ada6-db919d5cf4fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{18.4}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531141}] :answer-field/correct {:db/id #edb/ref 17592186530953} :answer-field/id #uuid "e8439ccf-f19f-54b5-951f-b6eba6db8136" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186531540}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "02fcb6dd-d8d1-548e-be72-9006c65abdf0" :question/math-academy-id "q-72691" :question/problem "Chantelle did an experiment in her Chemistry class. She heated a liquid whose initial temperature was $-{5.3}^{∘}\\,\\text{C}.$ After several minutes, the temperature of the liquid increased by ${24.7}^{∘}\\,\\text{C}$, at which point she decided to end the experiment. What was the final temperature of the liquid?" :question/worked-solution "To determine the final temperature of the liquid, we add the variation in temperature to the initial temperature of the liquid. This gives\n\n$$\n-{5.3}^{∘}\\,\\text{C}+{24.7}^{∘}\\,\\text{C}={19.4}^{∘}\\,\\text{C}.\n$$\n\nTherefore, the temperature of the liquid at the end of the experiment was ${19.4}^{∘}\\,\\text{C}.$"} :step/id #uuid "b3d2d012-a306-590e-b68d-a518598a0966"} {:db/id #edb/ref 17592186531721 :step/content {:db/id #edb/ref 17592186531630 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0233853c-7d57-5992-a3de-9375ae31e3e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{2.9}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186530866} {:answer/id #uuid "11599972-180e-564a-8500-e2e61a9c6541" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{3.7}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186530894} {:answer/id #uuid "11d8cfac-231b-5b5e-a776-de1a254087fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{5.3}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186530897} {:answer/id #uuid "565ce699-4384-5be5-a535-10eb3fabc2a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{5.5}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531053} {:answer/id #uuid "64fa1bca-1096-5716-a7aa-e09d16681a32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{3.4}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531087}] :answer-field/correct {:db/id #edb/ref 17592186530894} :answer-field/id #uuid "89a90e23-11a2-5c55-80c6-c90a2ec355b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186531479}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aab3a1fe-f42d-5861-9d8c-8da472abefec" :question/math-academy-id "q-68925" :question/problem "In Toronto, Canada, the average temperature in November is ${4.9}^{∘}\\,\\text{C}.$ In December, the average temperature decreases by ${5.4}^{∘}\\,\\text{C}$ compared to November. Finally, in January, the average temperature decreases by ${3.2}^{∘}\\,\\text{C}$ compared to the previous month. Determine the average temperature in Toronto in January." :question/worked-solution "First, we must determine the average temperature in Toronto during the month of December. Since we know that the temperature decreases on average by ${5.4}^{∘}\\,\\text{C}$ compared to November, we subtract the variation in temperature from the average temperature in November. This gives\n\n$$\n{4.9}^{∘}\\,\\text{C}-{5.4}^{∘}\\,\\text{C}=-{0.5}^{∘}\\,\\text{C}.\n$$\n\nNow, we must determine the temperature during the month of January. Since we know that the temperature decreases on average by ${3.2}^{∘}\\,\\text{C}$ compared to December, we subtract the variation in temperature from the average temperature in December. This gives\n\n$$\n-{0.5}^{∘}\\,\\text{C}-{3.2}^{∘}\\,\\text{C}=-{3.7}^{∘}\\,\\text{C}.\n$$\n\nTherefore, the average temperature in Toronto in January is $-{3.7}^{∘}\\,\\text{C}.$"} :step/id #uuid "ddd3f114-58f8-562c-960c-b5c342a5bcb5" :step/next {:db/id #edb/ref 17592186531707}}] :activity/title "Solving Problems Using Addition and Subtraction of Rational Numbers" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186530855}]}
