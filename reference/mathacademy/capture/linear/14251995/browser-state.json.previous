      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14251995/observations/step-q120273-9eb049731589871e9b0c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14251995/observations/step-q120273-9eb049731589871e9b0c.png",
      "source_url": "https://mathacademy.com/tasks/14251995/topics/1106/lesson",
      "captured_at": 1792134000.6095357,
      "math_academy_id": "q-120273",
