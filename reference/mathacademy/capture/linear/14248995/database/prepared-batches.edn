[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186179817 :knowledge-point/questions ["question-26aa6167-d445-5a62-a697-315c80098811"] :db/ensure [:knowledge-point/validate]} {:db/id "question-26aa6167-d445-5a62-a697-315c80098811" :question/id #uuid "26aa6167-d445-5a62-a697-315c80098811" :question/math-academy-id "q-60142" :question/problem "An animal shelter houses only dogs and cats. The ratio of dogs to cats is $4:3.$ If there are $32$ dogs, what is the total number of animals in the shelter?" :question/worked-solution "We start with the ratio $4:3$ and write it as a fraction:\n\n$$\n\\frac{4}{3}\n$$\n\nIn this fraction, the numerator represents the number of dogs and the denominator represents the number of cats.\n\nWe can make a numerator of $32$ by multiplying the numerator and denominator by $8:$\n\n$$\n\\frac{4\\times 8}{3\\times 8}=\\frac{32}{24}\n$$\n\nTherefore, there are $32$ dogs and $24$ cats. So the total number of animals in the animal shelter is\n\n$$\n32+24=56.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f573bee3-51b2-5b6f-b283-d4ab5524dc98"] :db/ensure [:question/validate]} {:db/id "answer-field-f573bee3-51b2-5b6f-b283-d4ab5524dc98" :answer-field/id #uuid "f573bee3-51b2-5b6f-b283-d4ab5524dc98" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-61d78eef-0ef1-51d8-8f56-e304ece40893" :answer-field/choices ["answer-e8840b2e-dee6-5081-a059-47e9916237a9" "answer-86f960f4-d56e-5a35-94bf-96e675c7f1ad" "answer-3ae5b0a4-8499-5310-9fc9-89eb76077c76" "answer-61d78eef-0ef1-51d8-8f56-e304ece40893" "answer-7f4f278b-c6db-535e-ae2f-8c165187f9c4"] :db/ensure [:answer-field/validate]} {:db/id "answer-e8840b2e-dee6-5081-a059-47e9916237a9" :answer/id #uuid "e8840b2e-dee6-5081-a059-47e9916237a9" :answer/type :answer.type/math :answer/value "45" :db/ensure [:answer/validate]} {:db/id "answer-86f960f4-d56e-5a35-94bf-96e675c7f1ad" :answer/id #uuid "86f960f4-d56e-5a35-9