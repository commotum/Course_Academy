#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186567151} :activity/id #uuid "31327c94-86dc-5676-811e-1fced1bc3805" :activity/scope {:db/id #edb/ref 17592186049495 :topic/id #uuid "f9324acf-7bff-528d-bb24-b67ba475ce6a" :topic/math-academy-id 3746} :activity/steps [{:db/id #edb/ref 17592186567117 :step/content {:db/id #edb/ref 17592186567027 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ae5b0a4-8499-5310-9fc9-89eb76077c76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50" :db/id #edb/ref 17592186566483} {:answer/id #uuid "61d78eef-0ef1-51d8-8f56-e304ece40893" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "56" :db/id #edb/ref 17592186566549} {:answer/id #uuid "7f4f278b-c6db-535e-ae2f-8c165187f9c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "60" :db/id #edb/ref 17592186566606} {:answer/id #uuid "86f960f4-d56e-5a35-94bf-96e675c7f1ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "48" :db/id #edb/ref 17592186566618} {:answer/id #uuid "e8840b2e-dee6-5081-a059-47e9916237a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "45" :db/id #edb/ref 17592186566835}] :answer-field/correct {:db/id #edb/ref 17592186566549} :answer-field/id #uuid "f573bee3-51b2-5b6f-b283-d4ab5524dc98" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566999}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "26aa6167-d445-5a62-a697-315c80098811" :question/math-academy-id "q-60142" :question/problem "An animal shelter houses only dogs and cats. The ratio of dogs to cats is $4:3.$ If there are $32$ dogs, what is the total number of animals in the shelter?" :question/worked-solution "We start with the ratio $4:3$ and write it as a fraction:\n\n$$\n\\frac{4}{3}\n$$\n\nIn this fraction, the numerator represents the number of dogs and the denominator represents the number of cats.\n\nWe can make a numerator of $32$ by multiplying the numerator and denominator by $8:$\n\n$$\n\\frac{4\\times 8}{3\\times 8}=\\frac{32}{24}\n$$\n\nTherefore, there are $32$ dogs and $24$ cats. So the total number of animals in the animal shelter is\n\n$$\n32+24=56.\n$$"} :step/id #uuid "23c11523-25f4-517f-9af8-e0e0997771bb"} {:db/id #edb/ref 17592186567125 :step/content {:db/id #edb/ref 17592186332959 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2017ff24-0581-50a6-a0e4-897c730b1b05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "58" :db/id #edb/ref 17592186330223} {:answer/id #uuid "39e19669-c003-5b81-804b-0508b1684a64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "62" :db/id #edb/ref 17592186330469} {:answer/id #uuid "7301049a-cded-5985-8144-7a673af44c49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "66" :db/id #edb/ref 17592186330985} {:answer/id #uuid "8b8cf9cd-ccd6-560f-bcac-033dc77df751" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "70" :db/id #edb/ref 17592186331190} {:answer/id #uuid "c1b091f7-dcf4-5b11-8f44-fd1a1d60d02a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "55" :db/id #edb/ref 17592186331671}] :answer-field/correct {:db/id #edb/ref 17592186331671} :answer-field/id #uuid "dfe8cef3-8694-5862-a34e-cf2a94036fcd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186332596}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "46da9d15-27a6-531e-bac7-0a77b34580ce" :question/math-academy-id "q-60139" :question/problem "One day, $20$ adults and some children attended a music festival at Beethoven Park. If the ratio of adults to children was $4:7$, how many people attended the park that day?" :question/worked-solution "We start with the ratio $4:7$ and write it as a fraction:\n\n$$\n\\frac{4}{7}\n$$\n\nIn this fraction, the numerator represents the number of adults and the denominator represents the number of children.\n\nWe can make a numerator of $20$ by multiplying the numerator and denominator by $5:$\n\n$$\n\\frac{4\\times 5}{7\\times 5}=\\frac{20}{35}\n$$\n\nTherefore, $20$ adults and $35$ children attended that day. Thus, the total number of people who went to the park that day was\n\n$$\n20+35=55.\n$$"} :step/id #uuid "43965199-ae00-5566-87af-7df0f51980f8" :step/next {:db/id #edb/ref 17592186567117}} {:db/id #edb/ref 17592186567151 :step/content {:db/id #edb/ref 17592186180232 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ec7672a-1d0f-5d71-b116-7db8117aafa0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186330944} {:answer/id #uuid "81a88acf-af5c-553e-a384-8980c215f9e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186331098} {:answer/id #uuid "cfa9c985-6a3b-5722-9594-ce42ea188b54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186331788} {:answer/id #uuid "d4679159-09b6-5c1f-b452-67fa2f2362ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186331834} {:answer/id #uuid "f6b14486-1576-5997-825e-fcc3df8ad4a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186332115}] :answer-field/correct {:db/id #edb/ref 17592186330944} :answer-field/id #uuid "bc59fb8d-0cba-5bea-9780-04e655ab0928" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186332530}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b6604770-26c5-5386-84c1-792391047167" :question/math-academy-id "q-59887" :question/problem "The ratio of girls to boys in a chess club is $2:1.$ If there are $10$ girls, then how many members does the club have in total?" :question/worked-solution "We start with the ratio $2:1$ and write it as a fraction:\n\n$$\n\\frac{2}{1}\n$$\n\nIn this fraction, the numerator represents the number of girls, and the denominator represents the number of boys.\n\nWe can make a numerator of $10$ by multiplying the numerator and denominator by $5:$\n\n$$\n\\frac{2\\times 5}{1\\times 5}=\\frac{10}{5}\n$$\n\nTherefore, there are $10$ girls and $5$ boys in the club. So the total number of members is \n\n$$\n10+5=15.\n$$"} :step/id #uuid "e1f65a0e-623f-5ed6-b0e3-dbdf6d12bc49" :step/next {:db/id #edb/ref 17592186567125}}] :activity/title "Further Reasoning With Equivalent Ratios" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186566352}]}
