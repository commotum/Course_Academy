            {
              "option": "c",
              "dom_id": "questionWidget-choiceLetterCircle-31702-c",
              "type": "text",
              "value": "Yes, since each input is assigned to exactly one output",
              "html": "Yes, since each input is assigned to exactly one output"
            },
            {
