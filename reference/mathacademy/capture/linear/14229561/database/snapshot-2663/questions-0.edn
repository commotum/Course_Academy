#{[{:db/id #edb/ref 17592186551276 :knowledge-point/_questions [{:db/id #edb/ref 17592186064153 :knowledge-point/id #uuid "2451a654-2255-5867-871d-54340dfeff81" :knowledge-point/title "Interpreting the Derivative of a Function in a Given Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "238c54f7-d986-578c-91b7-ed7dde682958" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "For the first $500$ items produced, the cost per item constantly increased at a rate of $0.01$ dollars per item" :db/id #edb/ref 17592186550451} {:answer/id #uuid "5e540d2c-3631-53f7-a48c-010c116aa1a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "When the factory produces $500$ items per day, the cost per item is $5$ dollars" :db/id #edb/ref 17592186550595} {:answer/id #uuid "5f045299-9859-5bcd-9090-37b7c1825618" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "For every $500$ items produced, the cost per item increases by $0.01$ dollars" :db/id #edb/ref 17592186550598} {:answer/id #uuid "61078945-1d60-5c18-b427-796b3050ba43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "When the factory produces $500$ items per day, the cost per item is $0.01$ dollars" :db/id #edb/ref 17592186550603} {:answer/id #uuid "a0a04c05-0651-5009-91b0-6e14c1c0f1fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "When the factory produces $500$ items per day, the cost per item increases at a rate of $0.01$ dollars per item" :db/id #edb/ref 17592186550783}] :answer-field/correct {:answer/id #uuid "a0a04c05-0651-5009-91b0-6e14c1c0f1fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "When the factory produces $500$ items per day, the cost per item increases at a rate of $0.01$ dollars per item" :db/id #edb/ref 17592186550783} :answer-field/id #uuid "43e5e2b2-a362-5eae-bdb3-072556508ad1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551106}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4fdd627b-10f3-56fb-8e8b-56c0cb38ac41" :question/math-academy-id "q-112093" :question/problem "In a factory, the cost of producing an item depends on the number of items produced per day. The function $U(x)$ models the cost, in dollars, to produce an item if the factory is producing $x$ items per day. What is the best interpretation of ${U}^{′}(500)=0.01?$" :question/worked-solution "The function ${U}^{′}(x)$ represents the rate at which the cost changes when the factory produces $x$ items per day. \n\nTherefore, ${U}^{′}(500)=0.01$ means:\n\n$\\,$ *When the factory produces $500$ items per day, the cost per item increases at a rate of $0.01$ dollars per item*"}] [{:db/id #edb/ref 17592186329911 :knowledge-point/_questions [{:db/id #edb/ref 17592186064153 :knowledge-point/id #uuid "2451a654-2255-5867-871d-54340dfeff81" :knowledge-point/title "Interpreting the Derivative of a Function in a Given Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "224a9606-2cff-583a-a5a5-2ad7bd61c0d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ hours after launching, the number of visitors decreased at a rate of $1\\,500$ visitors per hour" :db/id #edb/ref 17592186327231} {:answer/id #uuid "2805d6d9-2178-5b35-a75a-b51a961ecf7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ hours after launching, the number of visitors increased by a total of $1\\,500$ visitors" :db/id #edb/ref 17592186327275} {:answer/id #uuid "2d5469b6-041f-5e92-a4a1-d055f18d58b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ hours after launching, the number of visitors increased at a rate of $1\\,500$ visitors per hour" :db/id #edb/ref 17592186327334} {:answer/id #uuid "63be821f-e737-542f-b20e-fcd904ca356a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ hours after launching, the number of visitors increased at a constant rate of $150$ visitors per hour" :db/id #edb/ref 17592186327801} {:answer/id #uuid "9571fdf5-f5e6-5c7d-844e-6c82e23412aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ hours after launching, the number of visitors decreased by a total of $1\\,500$ visitors" :db/id #edb/ref 17592186328236}] :answer-field/correct {:answer/id #uuid "2d5469b6-041f-5e92-a4a1-d055f18d58b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ hours after launching, the number of visitors increased at a rate of $1\\,500$ visitors per hour" :db/id #edb/ref 17592186327334} :answer-field/id #uuid "b67658e3-d1f9-53fe-9d3e-ca9f1907b2b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329503}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d89bcd84-b867-5262-b6e7-a8266afa7fe2" :question/math-academy-id "q-48709" :question/problem "The function $V(t)$ models the number of visitors, in thousands, to a new website, $t$ hours after the website's launch. What is the best interpretation of the statement below?\n\n$\\,$ *The slope of the tangent line to the graph of $V(t)$ at $t=10$ is equal to $1.5.$*" :question/worked-solution "The slope of the line tangent to the graph of $V(t)$ at $t=10$ gives the derivative of $V(t)$ at $t=10.$ So, we have that\n\n$$\n{V}^{′}(10)=1.5.\n$$\n\nWe can interpret the above statement as\n\n$\\,$ *$10$ hours after launching, the number of visitors increased at a rate of $1\\,500$ visitors per hour.*"}] [{:db/id #edb/ref 17592186551314 :knowledge-point/_questions [{:db/id #edb/ref 17592186064272 :knowledge-point/id #uuid "fa38f112-466c-50e9-ac08-be72b6f53782" :knowledge-point/title "Relating a Derivative to a Rate of Change"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b410e34-af3e-5a01-933c-fbe6349f45e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{W}^{′}(t)=r(t)" :db/id #edb/ref 17592186550426} {:answer/id #uuid "33d00ba0-1a85-58f1-8992-73d818d55ac7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{W}^{′}(t)=\\frac{1}{r(t)}" :db/id #edb/ref 17592186550492} {:answer/id #uuid "7481abc5-b42c-5b1f-8b53-c6646dad9e85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "W(t)=r(t)" :db/id #edb/ref 17592186550662} {:answer/id #uuid "9b37480b-e617-5540-824f-b3833f4eb298" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "W(t)=\\frac{1}{{r}^{′}(t)}" :db/id #edb/ref 17592186550762} {:answer/id #uuid "a85f2065-b5b6-5ad1-8dd5-e1cb912ecdde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "W(t)={r}^{′}(t)" :db/id #edb/ref 17592186550814}] :answer-field/correct {:answer/id #uuid "1b410e34-af3e-5a01-933c-fbe6349f45e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{W}^{′}(t)=r(t)" :db/id #edb/ref 17592186550426} :answer-field/id #uuid "cc125dcb-0e32-5fe9-99db-6daa9af7ad33" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551192}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "99da720f-6132-59c4-9760-cafcb4cb789a" :question/math-academy-id "q-72106" :question/problem "Joseph is measuring the weight gain of his pet puppy by recording the following two numbers for different values of $t,$ where $t$ is the time, in days, since he started his observations:\n\n- $W(t)$ - The puppy's weight, in kilograms\n\n- $r(t)$ - the rate at which the puppy's weight is increasing.\n\nWhat is the relationship between $W(t)$ and $r(t)?$" :question/worked-solution "The function $W(t)$ gives the weight of the puppy after $t$ days. Then,\n\n$$\n{W}^{′}(t)=\\frac{\\text{d}W(t)}{\\text{d}t}=\\frac{\\text{Change in }W}{\\text{Change in }t}.\n$$\n\nThus, ${W}^{′}(t)$ gives the rate at which the weight of the puppy increases at time $t$, which is the same as $r(t).$ Therefore, the relationship between $W(t)$ and $r(t)$ is ${W}^{′}(t)=r(t).$"}]}
