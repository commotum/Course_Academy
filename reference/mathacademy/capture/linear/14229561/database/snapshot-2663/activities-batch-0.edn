f 17592186517229} {:db/id #edb/ref 17592186517230} {:db/id #edb/ref 17592186517238}] :knowledge-point/title "Determining the Units of a Derivative"} :step/id #uuid "591c3dff-1506-54a5-a8fe-829db67c140d" :step/math-academy-id 22692 :step/next {:db/id #edb/ref 17592186064980}} {:db/id #edb/ref 17592186065156 :step/content {:db/id #edb/ref 17592186064272 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064115 :question/id #uuid "0f4baedc-a28a-5b45-97d7-d7e1196b21c2" :question/math-academy-id "e-6113"} :knowledge-point/id #uuid "fa38f112-466c-50e9-ac08-be72b6f53782" :knowledge-point/question-generator {:db/id #edb/ref 17592186517320} :knowledge-point/questions [{:db/id #edb/ref 17592186064837} {:db/id #edb/ref 17592186064947} {:db/id #edb/ref 17592186233149} {:db/id #edb/ref 17592186234105} {:db/id #edb/ref 17592186234317} {:db/id #edb/ref 17592186247283} {:db/id #edb/ref 17592186247284} {:db/id #edb/ref 17592186247285} {:db/id #edb/ref 17592186339060} {:db/id #edb/ref 17592186517311} {:db/id #edb/ref 17592186517312} {:db/id #edb/ref 17592186551314}] :knowledge-point/title "Relating a Derivative to a Rate of Change"} :step/id #uuid "90f0715b-ebb7-53b3-8e60-ab2cec7bd6e6" :step/math-academy-id 22693}] :activity/title "Interpreting the Meaning of the Derivative in Context" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064399}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186515668} :activity/id #uuid "3bdd210c-9c04-5e69-a3ac-cdfe8109d5df" :activity/scope {:db/id #edb/ref 17592186048835 :topic/id #uuid "c490676a-a400-5088-9414-891ef037ec40" :topic/math-academy-id 296} :activity/steps [{:db/id #edb/ref 17592186515629 :step/content {:db/id #edb/ref 17592186515612 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1071b292-1c48-516f-adc9-50669f444bd1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "At $10$ degrees Celsius, the resistivity of the wire decreases at a rate of $0.01$ units per degree" :db/id #edb/ref 17592186514908} {:answer/id #uuid "55c40cb2-7242-57e4-a518-1d8459f9122c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "At $10$ degrees Celsius, the resistivity of the wire is $0.01$ units less than its value at ${0}^{∘}$" :db/id #edb/ref 17592186515064} {:answer/id #uuid "e35b0b0f-5813-594b-9eea-774b722ff5ab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "At $10$ degrees Celsius, the resistivity of the wire is $0.01$ units" :db/id #edb/ref 17592186515346} {:answer/id #uuid "e4b5bf6c-a912-5724-a3ac-e6ee153cd77d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "At $10$ degrees Celsius, the resistivity of the wire increases at a rate of $0.01$ units per degree" :db/id #edb/ref 17592186515351} {:answer/id #uuid "f895225b-6973-503a-8662-72877ccbd1b2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For each interval of $10$ degrees Celsius, the resistivity of the wire decreases by $0.01$ units" :db/id #edb/ref 17592186515395}] :answer-field/correct {:db/id #edb/ref 17592186514908} :answer-field/id #uuid "7b611e52-ac20-5642-b35b-9cb7a57a497c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186515456}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e7907942-0453-56fa-81c8-7f3d98729c3f" :question/math-academy-id "q-112104" :question/problem "The electrical resistivity of a copper wire varies with the temperature. The function $R(T)$ gives the resistivity of a wire at a temperature of $T$ degrees Celsius. What is the best interpretation of ${R}^{′}(10)=-0.01?$" :question/worked-solution "The function ${R}^{′}(T)$ represents the rate at which the resistivity of the wire is decreasing at $T$ degrees Celsius.\n\nTherefore, since it is negative, ${R}^{′}(10)=-0.01$ means:\n\n$\\,$ *At $10$ degrees Celsius, the resistivity of the wire decreases at a rate of $0.01$ units per degree.*"} :step/id #uuid "0e00795a-bf92-5c91-9599-9b3a42d17f2e"} {:db/id #edb/ref 17592186515633 :step/content {:db/id #edb/ref 17592186064839 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0471e9db-ae74-5721-881f-6766ec471aab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$55$ crocodiles per year" :db/id #edb/ref 17592186063092} {:answer/id #uuid "0cb451c9-624d-5aea-a847-0a716186f298" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$40$ crocodiles per year" :db/id #edb/ref 17592186063093} {:answer/id #uuid "19b1cbfa-5dc1-50c7-b795-45e8078bcfc5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-6$ crocodiles per year" :db/id #edb/ref 17592186063094} {:answer/id #uuid "1b66f55e-690d-507d-9f15-da5db4e9d4d2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$77$ crocodiles per year" :db/id #edb/ref 17592186063095} {:answer/id #uuid "20cf6a46-231f-5311-8a1f-d91f99078953" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$66$ crocodiles per year" :db/id #edb/ref 17592186063096}] :answer-field/correct {:db/id #edb/ref 17592186063093} :answer-field/id #uuid "68d15ded-f5ea-533d-bc58-1b30eba5bad8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186063091}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7cc5ee70-2b10-5325-a2dc-cd7c11e6d8be" :question/math-academy-id "q-48935" :question/problem "The birth rate of crocodiles in a river is modeled by $B(t)=6\\cdot {e}^{0.25t}$ crocodiles per year, while the rate of death is modeled by $D(t)=4\\cdot {e}^{0.25t}$ crocodiles per year, where $t$ represents the number of years since the year $2000.$  \n\nWhat was the rate of change of the crocodile population in $2012?$ Round your answer to the nearest integer." :question/requires-calculator true :question/worked-solution "The rate of change in the crocodile population $t$ years since $2000$ is equal to the birth rate minus the death rate, that is\n\n$$\nB(t)-D(t).\n$$\n\nSince $2012$ is $12$ years after $2000$, we have $t=12.$ Substituting $t=12,$ the rate of change of the crocodile population in the river  in $2012$ was\n\n$$\n\\begin{aligned}B(12)-D(12) & =6\\cdot {e}^{0.25(12)}-4\\cdot {e}^{0.25(12)} \\\\  & =6{e}^{3}-4{e}^{3} \\\\  & =2{e}^{3} \\\\  & ≈40.\\end{aligned}\n$$\n\nTherefore, the rate of change of the crocodile population in the river in $2012$ is approximately $40$ crocodiles per year."} :step/id #uuid "15d5622f-a373-5ea6-99ae-45dd9cf87f84" :step/next {:db/id #edb/ref 17592186515629}} {:db/id #edb/ref 17592186515668 :step/content {:db/id #edb/ref 17592186329907 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0be07498-8050-537a-b25e-fd95bab4699a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The distance traveled increased by $10$ meters during the first $30$ seconds" :db/id #edb/ref 17592186327037} {:answer/id #uuid "51437d5b-5e6c-5066-b244-e7e818095097" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The distance traveled increased at a constant rate of $3$ meters per second" :db/id #edb/ref 17592186327641} {:answer/id #uuid "7aadd70b-53c1-50fb-bc02-b723b6f3ea3c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$30$ seconds after the start of the journey, the distance traveled decreased at a rate of $10$ meters per second" :db/id #edb/ref 17592186327987} {:answer/id #uuid "aaa8d265-16ad-5285-82fb-8aa43f6dd27f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$30$ seconds after the start of the journey, the car traveled $10$ meters." :db/id #edb/ref 17592186328410} {:answer/id #uuid "dc11c238-8417-5632-881c-cdb922cfb484" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$30$ seconds after the start of the journey, the distance traveled increased at a rate of $10$ meters per second" :db/id #edb/ref 17592186328858}] :answer-field/correct {:db/id #edb/ref 17592186328858} :answer-field/id #uuid "ffcaa0c5-cbb7-57a1-b1e2-92acc3accb1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186329631}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ce5be28b-4511-5653-9464-457a2f9e4167" :question/math-academy-id "q-48688" :question/problem "The function $x(t)$ models the number of meters traveled by a car, $t$ seconds after it sets off on a journey. What is the best interpretation of ${x}^{′}(30)=10?$" :question/worked-solution "The function ${x}^{′}(t)$ represents the rate at which the number of meters is changing at the moment $t$ seconds after starting its journey.\n\nTherefore, ${x}^{′}(30)=10$ means:\n\n$\\,$ *$30$ seconds after the start of the journey, the distance traveled increased at a rate of $10$ meters per second*"} :step/id #uuid "90ed548d-7b9f-5b06-a9d7-d32c049ddb79" :step/next {:db/id #edb/ref 17592186515633}}] :activity/title "Interpreting the Meaning of the Derivative in Context" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186514856}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186551433} :activity/id #uuid "57956ceb-a050-5fd1-9c8a-9b26480f8fc1" :activity/scope {:db/id #edb/ref 17592186048835 :topic/id #uuid "c490676a-a400-5088-9414-891ef037ec40" :topic/math-academy-id 296} :activity/steps [{:db/id #edb/ref 17592186551363 :step/content {:db/id #edb/ref 17592186551314 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b410e34-af3e-5a01-933c-fbe6349f45e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{W}^{′}(t)=r(t)" :db/id #edb/ref 17592186550426} {:answer/id #uuid "33d00ba0-1a85-58f1-8992-73d818d55ac7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{W}^{′}(t)=\\frac{1}{r(t)}" :db/id #edb/ref 17592186550492} {:answer/id #uuid "7481abc5-b42c-5b1f-8b53-c6646dad9e85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "W(t)=r(t)" :db/id #edb/ref 17592186550662} {:answer/id #uuid "9b37480b-e617-5540-824f-b3833f4eb298" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "W(t)=\\frac{1}{{r}^{′}(t)}" :db/id #edb/ref 17592186550762} {:answer/id #uuid "a85f2065-b5b6-5ad1-8dd5-e1cb912ecdde" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "W(t)={r}^{′}(t)" :db/id #edb/ref 17592186550814}] :answer-field/correct {:db/id #edb/ref 17592186550426} :answer-field/id #uuid "cc125dcb-0e32-5fe9-99db-6daa9af7ad33" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186551192}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "99da720f-6132-59c4-9760-cafcb4cb789a" :question/math-academy-id "q-72106" :question/problem "Joseph is measuring the weight gain of his pet puppy by recording the following two numbers for different values of $t,$ where $t$ is the time, in days, since he started his observations:\n\n- $W(t)$ - The puppy's weight, in kilograms\n\n- $r(t)$ - the rate at which the puppy's weight is increasing.\n\nWhat is the relationship between $W(t)$ and $r(t)?$" :question/worked-solution "The function $W(t)$ gives the weight of the puppy after $t$ days. Then,\n\n$$\n{W}^{′}(t)=\\frac{\\text{d}W(t)}{\\text{d}t}=\\frac{\\text{Change in }W}{\\text{Change in }t}.\n$$\n\nThus, ${W}^{′}(t)$ gives the rate at which the weight of the puppy increases at time $t$, which is the same as $r(t).$ Therefore, the relationship between $W(t)$ and $r(t)$ is ${W}^{′}(t)=r(t).$"} :step/id #uuid "07f8cfdb-1228-53ea-a11d-e93a63c8a9d5" :step/next {:db/id #edb/ref 17592186551418}} {:db/id #edb/ref 17592186551418 :step/content {:db/id #edb/ref 17592186551276 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "238c54f7-d986-578c-91b7-ed7dde682958" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For the first $500$ items produced, the cost per item constantly increased at a rate of $0.01$ dollars per item" :db/id #edb/ref 17592186550451} {:answer/id #uuid "5e540d2c-3631-53f7-a48c-010c116aa1a3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "When the factory produces $500$ items per day, the cost per item is $5$ dollars" :db/id #edb/ref 17592186550595} {:answer/id #uuid "5f045299-9859-5bcd-9090-37b7c1825618" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For every $500$ items produced, the cost per item increases by $0.01$ dollars" :db/id #edb/ref 17592186550598} {:answer/id #uuid "61078945-1d60-5c18-b427-796b3050ba43" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "When the factory produces $500$ items per day, the cost per item is $0.01$ dollars" :db/id #edb/ref 17592186550603} {:answer/id #uuid "a0a04c05-0651-5009-91b0-6e14c1c0f1fb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "When the factory produces $500$ items per day, the cost per item increases at a rate of $0.01$ dollars per item" :db/id #edb/ref 17592186550783}] :answer-field/correct {:db/id #edb/ref 17592186550783} :answer-field/id #uuid "43e5e2b2-a362-5eae-bdb3-072556508ad1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186551106}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4fdd627b-10f3-56fb-8e8b-56c0cb38ac41" :question/math-academy-id "q-112093" :question/problem "In a factory, the cost of producing an item depends on the number of items produced per day. The function $U(x)$ models the cost, in dollars, to produce an item if the factory is producing $x$ items per day. What is the best interpretation of ${U}^{′}(500)=0.01?$" :question/worked-solution "The function ${U}^{′}(x)$ represents the rate at which the cost changes when the factory produces $x$ items per day. \n\nTherefore, ${U}^{′}(500)=0.01$ means:\n\n$\\,$ *When the factory produces $500$ items per day, the cost per item increases at a rate of $0.01$ dollars per item*"} :step/id #uuid "833fadcd-bbd6-5042-880a-037df6a6b074"} {:db/id #edb/ref 17592186551433 :step/content {:db/id #edb/ref 17592186329911 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "224a9606-2cff-583a-a5a5-2ad7bd61c0d6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$10$ hours after launching, the number of visitors decreased at a rate of $1\\,500$ visitors per hour" :db/id #edb/ref 17592186327231} {:answer/id #uuid "2805d6d9-2178-5b35-a75a-b51a961ecf7b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$10$ hours after launching, the number of visitors increased by a total of $1\\,500$ visitors" :db/id #edb/ref 17592186327275} {:answer/id #uuid "2d5469b6-041f-5e92-a4a1-d055f18d58b6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$10$ hours after launching, the number of visitors increased at a rate of $1\\,500$ visitors per hour" :db/id #edb/ref 17592186327334} {:answer/id #uuid "63be821f-e737-542f-b20e-fcd904ca356a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$10$ hours after launching, the number of visitors increased at a constant rate of $150$ visitors per hour" :db/id #edb/ref 17592186327801} {:answer/id #uuid "9571fdf5-f5e6-5c7d-844e-6c82e23412aa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$10$ hours after launching, the number of visitors decreased by a total of $1\\,500$ visitors" :db/id #edb/ref 17592186328236}] :answer-field/correct {:db/id #edb/ref 17592186327334} :answer-field/id #uuid "b67658e3-d1f9-53fe-9d3e-ca9f1907b2b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186329503}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d89bcd84-b867-5262-b6e7-a8266afa7fe2" :question/math-academy-id "q-48709" :question/problem "The function $V(t)$ models the number of visitors, in thousands, to a new website, $t$ hours after the website's launch. What is the best interpretation of the statement below?\n\n$\\,$ *The slope of the tangent line to the graph of $V(t)$ at $t=10$ is equal to $1.5.$*" :question/worked-solution "The slope of the line tangent to the graph of $V(t)$ at $t=10$ gives the derivative of $V(t)$ at $t=10.$ So, we have that\n\n$$\n{V}^{′}(10)=1.5.\n$$\n\nWe can interpret the above statement as\n\n$\\,$ *$10$ hours after launching, the number of visitors increased at a rate of $1\\,500$ visitors per hour.*"} :step/id #uuid "a7ac6ece-a433-5e83-bad9-de6b76cd1d2a" :step/next {:db/id #edb/ref 17592186551363}}] :activity/title "Interpreting the Meaning of the Derivative in Context" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186550349}]}
