#{[{:db/id #edb/ref 17592186329911 :knowledge-point/_questions [{:db/id #edb/ref 17592186064153 :knowledge-point/id #uuid "2451a654-2255-5867-871d-54340dfeff81" :knowledge-point/title "Interpreting the Derivative of a Function in a Given Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "224a9606-2cff-583a-a5a5-2ad7bd61c0d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ hours after launching, the number of visitors decreased at a rate of $1\\,500$ visitors per hour" :db/id #edb/ref 17592186327231} {:answer/id #uuid "2805d6d9-2178-5b35-a75a-b51a961ecf7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ hours after launching, the number of visitors increased by a total of $1\\,500$ visitors" :db/id #edb/ref 17592186327275} {:answer/id #uuid "2d5469b6-041f-5e92-a4a1-d055f18d58b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ hours after launching, the number of visitors increased at a rate of $1\\,500$ visitors per hour" :db/id #edb/ref 17592186327334} {:answer/id #uuid "63be821f-e737-542f-b20e-fcd904ca356a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ hours after launching, the number of visitors increased at a constant rate of $150$ visitors per hour" :db/id #edb/ref 17592186327801} {:answer/id #uuid "9571fdf5-f5e6-5c7d-844e-6c82e23412aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ hours after launching, the number of visitors decreased by a total of $1\\,500$ visitors" :db/id #edb/ref 17592186328236}] :answer-field/correct {:answer/id #uuid "2d5469b6-041f-5e92-a4a1-d055f18d58b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ hours after launching, the number of visitors increased at a rate of $1\\,500$ visitors per hour" :db/id #edb/ref 17592186327334} :answer-field/id #uuid "b67658e3-d1f9-53fe-9d3e-ca9f1907b2b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329503}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d89bcd84-b867-5262-b6e7-a8266afa7fe2" :question/math-academy-id "q-48709" :question/problem "The function $V(t)$ models the number of visitors, in thousands, to a new website, $t$ hours after the website's launch. What is the best interpretation of the statement below?\n\n$\\,$ *The slope of the tangent line to the graph of $V(t)$ at $t=10$ is equal to $1.5.$*" :question/worked-solution "The slope of the line tangent to the graph of $V(t)$ at $t=10$ gives the derivative of $V(t)$ at $t=10.$ So, we have that\n\n$$\n{V}^{′}(10)=1.5.\n$$\n\nWe can interpret the above statement as\n\n$\\,$ *$10$ hours after launching, the number of visitors increased at a rate of $1\\,500$ visitors per hour.*"}]}
