              "value": "{W}^{′}(t)=\\frac{1}{r(t)}",
              "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"false\"><msup><mi>W</mi><mo data-mjx-alternate=\"1\">′</mo></msup><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mrow><mi>r</mi><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo></mrow></mfrac></mstyle></math>"
