#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186552584} :activity/id #uuid "e0b82c9f-d695-577c-9c14-8e632f759242" :activity/scope {:db/id #edb/ref 17592186048267 :topic/id #uuid "8dee6cdf-6bc7-52db-8873-a393c17a11e1" :topic/math-academy-id 384} :activity/steps [{:db/id #edb/ref 17592186552545 :step/content {:db/id #edb/ref 17592186552406 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ad87764-6044-5767-902d-f845c340fce7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-3$ or $12$" :db/id #edb/ref 17592186551881} {:answer/id #uuid "7236c074-3016-5112-a3b9-0ad8989ea929" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-12$ or $-3$" :db/id #edb/ref 17592186551936} {:answer/id #uuid "9133a202-35d2-56e1-8e7d-2d811e679fd8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-18$ or $3$" :db/id #edb/ref 17592186552019} {:answer/id #uuid "b0458107-3a29-5b00-817a-03a49afcbbfc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$12$ or $18$" :db/id #edb/ref 17592186552090} {:answer/id #uuid "e42a61a8-e821-58ec-be90-1c90c3e1e586" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$6$ or $18$" :db/id #edb/ref 17592186552193}] :answer-field/correct {:db/id #edb/ref 17592186551881} :answer-field/id #uuid "e7cd6986-58f2-5df8-9623-61bd4f8f7c74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186552386}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0fd09d79-cd92-571a-b908-4f0df92196ae" :question/math-academy-id "q-154703" :question/problem "If $|3-\\frac{2}{3}y|=5,$ then $y=$" :question/worked-solution "Either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nSo, we set up the two corresponding equations and solve them independently:\n\n- If $|3-\\frac{2}{3}y|=3-\\frac{2}{3}y,$ we obtain:\n\n$$\n\\begin{aligned}|3-\\frac{2}{3}y| & =5 \\\\ 3-\\frac{2}{3}y & =5 \\\\ -\\frac{2}{3}y & =2\\end{aligned}\n$$\n\nMultiplying both sides of the equation by $-\\frac{3}{2}$ gives\n\n$$\n\\begin{aligned}-\\frac{2}{3}y & =2 \\\\ (-\\frac{3}{2})\\cdot (-\\frac{2}{3}y) & =(-\\frac{3}{2})\\cdot (2) \\\\ (\\cancel{-\\frac{3}{2}})\\cdot (\\cancel{-\\frac{2}{3}}y) & =-\\frac{6}{2} \\\\ y & =-3.\\end{aligned}\n$$\n\n- If $|3-\\frac{2}{3}y|=-(3-\\frac{2}{3}y),$ we obtain:\n\n$$\n\\begin{aligned}|3-\\frac{2}{3}y| & =5 \\\\ -(3-\\frac{2}{3}y) & =5 \\\\ -3+\\frac{2}{3}y & =5 \\\\ \\frac{2}{3}y & =8\\end{aligned}\n$$\n\nMultiplying both sides of the equation by $\\frac{3}{2}$ gives\n\n$$\n\\begin{aligned}\\frac{2}{3}y & =8 \\\\ (\\frac{3}{2})\\cdot (\\frac{2}{3}y) & =(\\frac{3}{2})\\cdot (8) \\\\ (\\cancel{\\frac{3}{2}})\\cdot (\\cancel{\\frac{2}{3}}y) & =\\frac{24}{2} \\\\ y & =12.\\end{aligned}\n$$\n\nTherefore, the solutions are $y=-3$ and $y=12.$"} :step/id #uuid "2681db7c-ff74-52ae-b2fb-ee80f155348c" :step/next {:db/id #edb/ref 17592186552587}} {:db/id #edb/ref 17592186552584 :step/content {:db/id #edb/ref 17592186552475 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "057a12b0-d4bc-55a8-9eee-258d1a00e98b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-\\frac{2}{3}$ or $\\frac{13}{3}$" :db/id #edb/ref 17592186551674} {:answer/id #uuid "23f8c6a8-ae4e-54ef-88f9-fe179de5f44d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-1$ or $\\frac{3}{2}$" :db/id #edb/ref 17592186551745} {:answer/id #uuid "e1ed2067-bb69-58be-ba14-334cd4747618" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-1$ or $\\frac{13}{2}$" :db/id #edb/ref 17592186552189} {:answer/id #uuid "efc542f6-65a8-5ed6-9840-e880355816ce" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\frac{3}{2}$ or $\\frac{11}{2}$" :db/id #edb/ref 17592186552226} {:answer/id #uuid "fc9c7d02-30df-5e21-a713-ce0444cf2812" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\frac{3}{2}$ or $\\frac{13}{2}$" :db/id #edb/ref 17592186552251}] :answer-field/correct {:db/id #edb/ref 17592186552251} :answer-field/id #uuid "4000b40a-b454-50f7-9046-7cb530cbcdff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186552288}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8ff91a7b-d943-550d-955e-e036467fba09" :question/math-academy-id "q-112200" :question/problem "If $|8-2x|=5,$ then $x=$" :question/worked-solution "Either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nSo, we set up the two corresponding equations and solve them independently:\n\n- If $|8-2x|=8-2x,$ we obtain:\n\n$$\n\\begin{aligned}|8-2x| & =5 \\\\ 8-2x & =5 \\\\ -2x & =-3 \\\\ \\frac{-2x}{-2} & =\\frac{-3}{-2} \\\\ x & =\\frac{3}{2}\\end{aligned}\n$$\n\n- If $|8-2x|=-(8-2x),$ we obtain:\n\n$$\n\\begin{aligned}|8-2x| & =5 \\\\ -(8-2x) & =5 \\\\ -8+2x & =5 \\\\ 2x & =13 \\\\ \\frac{2x}{2} & =\\frac{13}{2} \\\\ x & =\\frac{13}{2}\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\frac{3}{2}$ and $x=\\frac{13}{2}.$"} :step/id #uuid "95f6f89f-3826-5c24-91ad-1310088d28de" :step/next {:db/id #edb/ref 17592186552545}} {:db/id #edb/ref 17592186552587 :step/content {:db/id #edb/ref 17592186552472 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a250bff-7cf2-5b8c-a70c-561cb671e351" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186551762}] :answer-field/correct {:db/id #edb/ref 17592186551762} :answer-field/id #uuid "0ccce716-e2da-5a85-b47b-a94871a52a3a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186552263} {:answer-field/choices [{:answer/id #uuid "86409c3b-54a1-5d16-aabc-60ec0b435025" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{5}" :db/id #edb/ref 17592186551987}] :answer-field/correct {:db/id #edb/ref 17592186551987} :answer-field/id #uuid "6808506c-1a45-5a20-8d53-0017152fbabe" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186552314}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8bfe078d-4df3-523f-8453-0c2505e6812e" :question/math-academy-id "q-215127" :question/problem "Written in **ascending order**, the solutions to $|5y-1|=6$ are $y=${{field-1}} and $y=$\n{{field-2}}." :question/worked-solution "Either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nSo, we set up the two corresponding equations and solve them independently:\n\n- If $|5y-1|=5y-1,$ we obtain:\n\n$$\n\\begin{aligned}|5y-1| & =6 \\\\ 5y-1 & =6 \\\\ 5y & =7 \\\\ \\frac{5y}{5} & =\\frac{7}{5} \\\\ y & =\\frac{7}{5}\\end{aligned}\n$$\n\n- If $|5y-1|=-(5y-1),$ we obtain:\n\n$$\n\\begin{aligned}|5y-1| & =6 \\\\ -(5y-1) & =6 \\\\ -5y+1 & =6 \\\\ -5y & =5 \\\\ \\frac{-5y}{-5} & =\\frac{5}{-5} \\\\ y & =-1\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $y=-1$ and $y=\\frac{7}{5}.$"} :step/id #uuid "99735047-5749-5b1b-8081-cfbe6b269602"}] :activity/title "Absolute Value Equations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186551662}]}
