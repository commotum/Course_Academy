#{[{:db/id #edb/ref 17592186138298 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138386 :knowledge-point/id #uuid "0606514f-fdaf-58b5-af01-e4448bf973ac" :knowledge-point/title "Factoring Using Common Factors and Differences of Squares"}] :question/id #uuid "ebc0888c-bc8b-5f8c-8e2a-667ca1490d37" :question/math-academy-id "e-4362" :question/problem "Factor the expression $x^3 - 4x$." :question/worked-solution "First, notice that all of the terms have a common factor of $x$. To simplify the computation, we can factor out the $x$, as follows:\n\n$$\nx^3 - 4x = x(x^2 - 4)\n$$\n\nNow, we factor the expression $x^2 - 4$ using the difference of squares formula:\n\n$$\nx(x^2 - 4) = x(x+2)(x-2)\n$$"}] [{:db/id #edb/ref 17592186138302 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138409 :knowledge-point/id #uuid "1d645eb4-1466-56bd-bbd0-67d3967bec55" :knowledge-point/title "Factoring Using Common Factors and Perfect Square Trinomials"}] :question/id #uuid "da0223c6-ff03-55da-992c-d8a1ef3f9aff" :question/math-academy-id "e-4999" :question/problem "Factor the expression $x^3 - 6x^2 + 9x$." :question/worked-solution "First, notice that all of the terms have a common factor of $x$. To simplify the computation, we can factor out the $x$, as follows:\n\n$$\nx^3 - 6x^2 + 9x = x(x^2 - 6x + 9)\n$$\n\nThe expression $x^2 - 6x + 9$ is a perfect square trinomial that can be factored as follows:\n\n$$\n\\begin{aligned}\nx(x^{2} - 6x + 9) &=  \\\\\nx(x^{2} - 6x + 3^{2}) &=  \\\\\nx(x^{2} - 2 \\cdot 3x + 3^{2}) &=  \\\\\n&= x(x - 3)^{2}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186138303 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138410 :knowledge-point/id #uuid "d02438a3-10ca-5fe5-aad7-ec2c728223e6" :knowledge-point/title "Factoring Using Common Factors and Quadratic Factoring"}] :question/id #uuid "007b9b7b-5fab-5e50-9598-fc94a9f6edde" :question/math-academy-id "e-5000" :question/problem "Factor the expression $x^3 + x^2 - 2x$." :question/worked-solution "Note that all of the terms have a common factor of $x$. To simplify the computation, we can factor out the $x$, as follows:\n\n$$\n\\begin{aligned}\nx^{3} + x^{2} - 2x &= x(x^{2} + x - 2)\n\\end{aligned}\n$$\n\nNow, we factor the polynomial $x^2 + x - 2$ as follows:\n\n$$\n\\begin{aligned}\nx(x^{2} + x - 2) &=  \\\\\nx((x^{2} - x) + (2x - 2)) &=  \\\\\nx(x(x - 1) + 2(x - 1)) &=  \\\\\n&= x(x + 2)(x - 1)\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186139166 :knowledge-point/_questions [{:db/id #edb/ref 17592186138410 :knowledge-point/id #uuid "d02438a3-10ca-5fe5-aad7-ec2c728223e6" :knowledge-point/title "Factoring Using Common Factors and Quadratic Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "959589e7-fa82-5571-87ea-1a6caabdb6af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(3x - 1)^{2}" :db/id #edb/ref 17592186137945} {:answer/id #uuid "e44429f7-240b-50ab-87b3-badc15f51295" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3x - 1)^{2}(x + 1)" :db/id #edb/ref 17592186137946} {:answer/id #uuid "fe1c9cd7-f5ea-5c54-8d9b-09455983c430" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3x - 1)(x + 1)^{2}" :db/id #edb/ref 17592186137947} {:answer/id #uuid "2a5b4bb8-2ac9-5099-8713-705cb54d36ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(3x + 1)(x - 1)" :db/id #edb/ref 17592186137948} {:answer/id #uuid "3db7b08d-9412-5fa3-a17e-5598114b7562" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(3x - 1)(x + 1)" :db/id #edb/ref 17592186137949}] :answer-field/id #uuid "81a252b4-5456-5662-8e25-2711dd297043" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186137944}] :question/id #uuid "e190f45b-204a-5b29-a95b-506ea9c23984" :question/math-academy-id "q-69249" :question/problem "Factor the expression $3x^{3} + 2x^{2} - x$."}]}
