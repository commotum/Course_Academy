#{[{:db/id #edb/ref 17592186138298 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138386 :knowledge-point/id #uuid "0606514f-fdaf-58b5-af01-e4448bf973ac" :knowledge-point/title "Factoring Using Common Factors and Differences of Squares"}] :question/id #uuid "ebc0888c-bc8b-5f8c-8e2a-667ca1490d37" :question/math-academy-id "e-4362" :question/problem "Factor the expression $x^3 - 4x.$" :question/worked-solution "First, notice that all of the terms have a common factor of $x.$ To simplify the computation, we can factor out the $x,$ as follows:\n\n$$\nx^3 - 4x =\nx(x^2 - 4)\n$$\n\nNow, we factor the expression $x^2 - 4$ using the difference of squares formula:\n\n$$\nx(x^2 - 4) = x(x+2)(x-2)\n$$"}] [{:db/id #edb/ref 17592186138302 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138409 :knowledge-point/id #uuid "1d645eb4-1466-56bd-bbd0-67d3967bec55" :knowledge-point/title "Factoring Using Common Factors and Perfect Square Trinomials"}] :question/id #uuid "da0223c6-ff03-55da-992c-d8a1ef3f9aff" :question/math-academy-id "e-4999" :question/problem "Factor the expression $x^3 - 6x^2 + 9x.$" :question/worked-solution "First, notice that all of the terms have a common factor of $x.$ To simplify the computation, we can factor out the $x,$ as follows:\n\n$$\nx^3 - 6x^2 + 9x = x(x^2 - 6x + 9)\n$$\n\nThe expression $x^2 - 6x + 9$ is a perfect square trinomial that can be factored as follows:\n\n$$\n\\begin{aligned}x({x}^{2}-6x+9) & = \\\\ x({x}^{2}-6x+{3}^{2}) & = \\\\ x({x}^{2}-2\\cdot 3x+{3}^{2}) & = \\\\ x(x-3)^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186138303 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138410 :knowledge-point/id #uuid "d02438a3-10ca-5fe5-aad7-ec2c728223e6" :knowledge-point/title "Factoring Using Common Factors and Quadratic Factoring"}] :question/id #uuid "007b9b7b-5fab-5e50-9598-fc94a9f6edde" :question/math-academy-id "e-5000" :question/problem "Factor the expression $x^3 + x^2 - 2x.$" :question/worked-solution "Note that all of the terms have a common factor of $x.$ To simplify the computation, we can factor out the $x,$ as follows:\n\n$$\n\\begin{aligned}{x}^{3}+{x}^{2}-2x & =x({x}^{2}+x-2)\\end{aligned}\n$$\n\nNow, we factor the polynomial $x^2 + x - 2$ as follows:\n\n$$\n\\begin{aligned}x({x}^{2}+x-2) & = \\\\ x(({x}^{2}-x)+(2x-2)) & = \\\\ x(x(x-1)+2(x-1)) & = \\\\ x(x+2)(x-1)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186530489 :knowledge-point/_questions [{:db/id #edb/ref 17592186138386 :knowledge-point/id #uuid "0606514f-fdaf-58b5-af01-e4448bf973ac" :knowledge-point/title "Factoring Using Common Factors and Differences of Squares"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3487048b-f83b-5ea7-9fa4-5b3911f15b5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{2}(3n-1)" :db/id #edb/ref 17592186529700} {:answer/id #uuid "84f9cceb-b824-59c9-bc95-0e9e765459e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{2}(3n+1)(3n-1)" :db/id #edb/ref 17592186529909} {:answer/id #uuid "89058da7-de22-5c1a-89a4-5a2fa2f7d691" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n(3n+1)(3n-1)" :db/id #edb/ref 17592186529913} {:answer/id #uuid "9044c2ba-d973-5775-b679-1000a32b2258" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{2}(3n+1)^{2}" :db/id #edb/ref 17592186529931} {:answer/id #uuid "92e12dc8-dae9-5034-a85c-9f4ff9be2882" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{4}(3n-1)" :db/id #edb/ref 17592186529938}] :answer-field/correct {:answer/id #uuid "84f9cceb-b824-59c9-bc95-0e9e765459e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{2}(3n+1)(3n-1)" :db/id #edb/ref 17592186529909} :answer-field/id #uuid "7f4b4fdc-b895-5cda-9128-940ddfc9f191" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530316}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8dcc5eab-0d17-5264-bead-34e7ca604fff" :question/math-academy-id "q-111921" :question/problem "Factor the expression $9{n}^{4}-{n}^{2}.$" :question/worked-solution "First, notice that all of the terms have a common factor of ${n}^{2}.$ To simplify the computation, we can factor out the ${n}^{2},$ as follows:\n\n$$\n9{n}^{4}-{n}^{2}={n}^{2}(9{n}^{2}-1)\n$$\n\nNow, we factor the expression $9{n}^{2}-1$ using the difference of squares formula:\n\n$$\n{n}^{2}(9{n}^{2}-1)={n}^{2}((3n)^{2}-{1}^{2})={n}^{2}(3n+1)(3n-1)\n$$"}] [{:db/id #edb/ref 17592186530422 :knowledge-point/_questions [{:db/id #edb/ref 17592186138409 :knowledge-point/id #uuid "1d645eb4-1466-56bd-bbd0-67d3967bec55" :knowledge-point/title "Factoring Using Common Factors and Perfect Square Trinomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b2d79c1-583e-57ab-ba0d-3a6a96d759e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}^{3}(3v+1)^{2}" :db/id #edb/ref 17592186529598} {:answer/id #uuid "5a5d2964-99a6-545a-8648-910786a6eef4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9{v}^{2}(v+1)^{3}" :db/id #edb/ref 17592186529798} {:answer/id #uuid "6412f89c-0a75-5890-ab7c-912727354b37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}^{4}(9v+1)^{2}" :db/id #edb/ref 17592186529825} {:answer/id #uuid "87f1c3b3-86a8-589a-a65c-eff5643f2144" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}^{2}(3v+1)^{3}" :db/id #edb/ref 17592186529911} {:answer/id #uuid "cbabce0e-ca03-5bbc-b320-a0f7030aa165" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{v}^{3}(v+1)^{2}" :db/id #edb/ref 17592186530092}] :answer-field/correct {:answer/id #uuid "0b2d79c1-583e-57ab-ba0d-3a6a96d759e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}^{3}(3v+1)^{2}" :db/id #edb/ref 17592186529598} :answer-field/id #uuid "4260b274-dc71-5d2d-8a2d-3b8ebca986c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530265}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0a134bf3-f015-57aa-8456-af35dcce2abe" :question/math-academy-id "q-111943" :question/problem "Factor the expression $9{v}^{5}+6{v}^{4}+{v}^{3}.$" :question/worked-solution "First, notice that all of the terms have a common factor of ${v}^{3}.$ To simplify the computation, we can factor out the ${v}^{3},$ as follows:\n\n$$\n\\begin{aligned}9{v}^{5}+6{v}^{4}+{v}^{3} & ={v}^{3}(9{v}^{2}+6v+1)\\end{aligned}\n$$\n\nThe expression $9{v}^{2}+6v+1$ is a perfect square trinomial that can be factored as follows:\n\n$$\n\\begin{aligned}{v}^{3}(9{v}^{2}+6v+1) & = \\\\ {v}^{3}((3v)^{2}+6v+{1}^{2}) & = \\\\ {v}^{3}((3v)^{2}+2\\cdot (3v)+{1}^{2}) & = \\\\ {v}^{3}(3v+1)^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186530483 :knowledge-point/_questions [{:db/id #edb/ref 17592186138409 :knowledge-point/id #uuid "1d645eb4-1466-56bd-bbd0-67d3967bec55" :knowledge-point/title "Factoring Using Common Factors and Perfect Square Trinomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "325b0a34-9436-5b91-8a90-04aec48bede2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{y}^{2}(y-3)^{2}" :db/id #edb/ref 17592186529692} {:answer/id #uuid "a538bb6d-1cb1-53f8-a6c2-7b869394a828" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{4}(4y-9)" :db/id #edb/ref 17592186529989} {:answer/id #uuid "b78343b2-2c20-5528-8530-f2d7808f2d1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{y}^{4}(2y-9)" :db/id #edb/ref 17592186530039} {:answer/id #uuid "b8e3cadc-d863-5dc0-a90a-86254a5b7149" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{3}(2y-3)^{3}" :db/id #edb/ref 17592186530045} {:answer/id #uuid "cf10b3b0-95bb-5d06-8e85-6e049fdba136" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}(2y-3)^{2}" :db/id #edb/ref 17592186530100}] :answer-field/correct {:answer/id #uuid "cf10b3b0-95bb-5d06-8e85-6e049fdba136" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}(2y-3)^{2}" :db/id #edb/ref 17592186530100} :answer-field/id #uuid "f6990042-c99e-5c76-82b8-8db0cdb93f3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530401}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "831d09f3-e78e-5131-b5ea-583953555624" :question/math-academy-id "q-111945" :question/problem "Factor the expression $4{y}^{4}-12{y}^{3}+9{y}^{2}.$" :question/worked-solution "First, notice that all of the terms have a common factor of ${y}^{2}.$ To simplify the computation, we can factor out the ${y}^{2},$ as follows:\n\n$$\n\\begin{aligned}4{y}^{4}-12{y}^{3}+9{y}^{2} & ={y}^{2}(4{y}^{2}-12y+9)\\end{aligned}\n$$\n\nThe expression $4{y}^{2}-12y+9$ is a perfect square trinomial that can be factored as follows:\n\n$$\n\\begin{aligned}{y}^{2}(4{y}^{2}-12y+9) & = \\\\ {y}^{2}((2y)^{2}-12y+{3}^{2}) & = \\\\ {y}^{2}((2y)^{2}-2\\cdot 3\\cdot (2y)+{3}^{2}) & = \\\\ {y}^{2}(2y-3)^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186530484 :knowledge-point/_questions [{:db/id #edb/ref 17592186138410 :knowledge-point/id #uuid "d02438a3-10ca-5fe5-aad7-ec2c728223e6" :knowledge-point/title "Factoring Using Common Factors and Quadratic Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bc95d9d-5eae-5413-94e8-4ae447be363d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{z}^{2}(x-3)^{2}" :db/id #edb/ref 17592186529674} {:answer/id #uuid "5782bb0d-e372-53c1-b90a-19572aa795a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{z}^{6}(x+3)^{2}" :db/id #edb/ref 17592186529791} {:answer/id #uuid "5f30cf54-4de4-5ad3-b220-c65719f9f268" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{z}^{6}(x-6)(x+5)" :db/id #edb/ref 17592186529809} {:answer/id #uuid "af157abe-2ee3-5b3a-8429-fdcf83a37545" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{z}^{6}(x-3)(x+5)" :db/id #edb/ref 17592186530016} {:answer/id #uuid "f38c6d92-f72f-53c8-a611-89911c291beb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{z}^{6}(z-6)(z+2)" :db/id #edb/ref 17592186530186}] :answer-field/correct {:answer/id #uuid "af157abe-2ee3-5b3a-8429-fdcf83a37545" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{z}^{6}(x-3)(x+5)" :db/id #edb/ref 17592186530016} :answer-field/id #uuid "c9dda1c7-c633-5b09-b7b0-359b74786c15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530367}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "879afca9-fcee-5d1d-bc32-90b5ad8c970f" :question/math-academy-id "q-44321" :question/problem "The trinomial $4{x}^{2}{z}^{6}+8x{z}^{6}-60{z}^{6}$ is equivalent to" :question/worked-solution "Note that all of the terms have a common factor of $4{z}^{6}.$ To simplify the computation, we can factor out the $4{z}^{6},$ as follows:\n\n$$\n\\begin{aligned}4{x}^{2}{z}^{6}+8x{z}^{6}-60{z}^{6}=(4{z}^{6})\\cdot {x}^{2}+(4{z}^{6})\\cdot 2x-(4{z}^{6})\\cdot 15=4{z}^{6}({x}^{2}+2x-15).\\end{aligned}\n$$\n\nNow, we factor the polynomial ${x}^{2}+2x-15,$ as follows:\n\n$$\n\\begin{aligned}4{z}^{6}({x}^{2}+2x-15) & = \\\\ 4{z}^{6}(({x}^{2}+5x)+(-3x-15)) & = \\\\ 4{z}^{6}(x(x+5)-3(x+5)) & = \\\\ 4{z}^{6}(x-3)(x+5)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186139166 :knowledge-point/_questions [{:db/id #edb/ref 17592186138410 :knowledge-point/id #uuid "d02438a3-10ca-5fe5-aad7-ec2c728223e6" :knowledge-point/title "Factoring Using Common Factors and Quadratic Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e67e45d-eca1-5e1d-ab05-8a2c8d157c1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(3x-1)(x+1)" :db/id #edb/ref 17592186529725} {:answer/id #uuid "47926ffc-d7a1-5797-b730-73328c2c7beb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(3x+1)(x-1)" :db/id #edb/ref 17592186529747} {:answer/id #uuid "73678dff-3f54-569b-89c0-a6eceb3259bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3x-1)^{2}(x+1)" :db/id #edb/ref 17592186529873} {:answer/id #uuid "8e7f324c-5df5-5864-a6e0-aba438969f77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3x-1)(x+1)^{2}" :db/id #edb/ref 17592186529924} {:answer/id #uuid "df8b8d89-7aa9-54b3-a94a-df6ecca6f6f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(3x-1)^{2}" :db/id #edb/ref 17592186530138}] :answer-field/correct {:answer/id #uuid "3e67e45d-eca1-5e1d-ab05-8a2c8d157c1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(3x-1)(x+1)" :db/id #edb/ref 17592186529725} :answer-field/id #uuid "81a252b4-5456-5662-8e25-2711dd297043" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186137944}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e190f45b-204a-5b29-a95b-506ea9c23984" :question/math-academy-id "q-69249" :question/problem "Factor the expression $3{x}^{3}+2{x}^{2}-x.$" :question/worked-solution "Note that all of the terms have a common factor of $x.$ To simplify the computation, we can factor out the $x,$ as follows:\n\n$$\n\\begin{aligned}3{x}^{3}+2{x}^{2}-x & =x(3{x}^{2}+2x-1)\\end{aligned}\n$$\n\nNow, we factor the polynomial $3{x}^{2}+2x-1,$ as follows:\n\n$$\n\\begin{aligned}x(3{x}^{2}+2x-1) & = \\\\ x((3{x}^{2}+3x)+(-x-1)) & = \\\\ x(3x(x+1)-1(x+1)) & = \\\\ x(3x-1)(x+1)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186530528 :knowledge-point/_questions [{:db/id #edb/ref 17592186138386 :knowledge-point/id #uuid "0606514f-fdaf-58b5-af01-e4448bf973ac" :knowledge-point/title "Factoring Using Common Factors and Differences of Squares"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55a3958e-f134-5356-b4d9-896b8feb884b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{3}(3y+1)(3y-1)" :db/id #edb/ref 17592186529785} {:answer/id #uuid "56548ac6-5248-51d6-83e6-b18ee6a8a2c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y(3y+1)(3y-1)" :db/id #edb/ref 17592186529789} {:answer/id #uuid "6d6b29ae-4b35-5388-a885-7900e7ea04e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{3}(3y+1)(y-1)" :db/id #edb/ref 17592186529859} {:answer/id #uuid "9b723648-5fcd-553a-94dd-e5b6e26fe68c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{3}(3y-1)^{2}" :db/id #edb/ref 17592186529963} {:answer/id #uuid "e15bd179-81cb-57d2-b843-a002a3802601" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9{y}^{3}(y+1)(y-1)" :db/id #edb/ref 17592186530144}] :answer-field/correct {:answer/id #uuid "55a3958e-f134-5356-b4d9-896b8feb884b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{3}(3y+1)(3y-1)" :db/id #edb/ref 17592186529785} :answer-field/id #uuid "207387ef-a367-5acd-bb01-a6190914289d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530242}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d4ff2f27-cc03-59a8-bdee-fa30389e7f38" :question/math-academy-id "q-69586" :question/problem "Factor the expression $9{y}^{5}-{y}^{3}.$" :question/worked-solution "First, notice that all of the terms have a common factor of ${y}^{3}.$ To simplify the computation, we can factor out the ${y}^{3},$ as follows:\n\n$$\n9{y}^{5}-{y}^{3}={y}^{3}(9{y}^{2}-1)\n$$\n\nNow, we factor the expression $9{y}^{2}-1$ using the difference of squares formula:\n\n$$\n{y}^{3}(9{y}^{2}-1)={y}^{3}((3y)^{2}-{1}^{2})={y}^{3}(3y+1)(3y-1)\n$$"}]}
