dent :question.difficulty/easy} :question/id #uuid "6658ae40-945d-5a7e-bc48-40968bc45b17" :question/math-academy-id "q-59624" :question/problem "Which model represents the division problem below?\n\n$$\n2÷\\frac{1}{5}=10\n$$" :question/worked-solution "To calculate $2÷\\frac{1}{5}$, we need to divide each of $2$ wholes into $5$ equal parts, as shown below. This gives us the corresponding model for the given division problem.\n\n![](images/24/241c0b93741d3cb837d08cae8f863d3c83e59309296e3f6b97f6154148aa41ed.png)\n\n \n\nWe get $2\\times 5=10$ pieces in total."}] [{:db/id #edb/ref 17592186425715 :knowledge-point/_questions [{:db/id #edb/ref 17592186073722 :knowledge-point/id #uuid "2e33ab8e-736b-5972-af0d-f7eeabda1148" :knowledge-point/title "Identifying the Division Problem Represented by a Model"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2030409d-4de7-5b60-82e1-ea070a92b04d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $3$" :db/id #edb/ref 17592186425685} {:answer/id #uuid "6573b2ed-bdd5-50d2-a3a3-b779cc223e8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$ and $4$" :db/id #edb/ref 17592186425690} {:answer/id #uuid "b18a24df-3c48-5f74-b5b4-2e60241bb1bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $6$" :db/id #edb/ref 17592186425696} {:answer/id #uuid "e4e6c36e-1810-5c18-a8a8-8dc32b1cd6a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $4$" :db/id #edb/ref 17592186425699} {:answer/id #uuid "f2dabce0-e99d-523f-b0b0-aa291d42dcec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$ and $5$" :db/id #edb/ref 17592186425704}] :answer-field/correct {:answer/id #uuid "e4e6c36e-1810-5c18-a8a8-8dc32b1cd6a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $4$" :db/id #edb/ref 17592186425699} :answer-field/id #uuid "875bb280-5fd5-5ed7-9546-d2ffab9d4f2b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425710}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "12733436-3403-5936-b77d-c6356ea8e2b3" :question/math-academy-id "q-59841" :question/problem "![](images/64/6463c24cede2d72af4574e9bc1ed15d09d6257e0a4e3393e52f74eddf874f862.png)\n\nEach of the two shapes in the model above represents one whole. From left to right, what numbers are missing from the division problem below?\n\n$$\n\\boxed{\\,\\,}÷\\frac{1}{2}=\\boxed{\\,\\,}\n$$" :question/worked-solution "In the model, there are $2$ shapes. Each shape consists of $2$ pieces that each represent $\\frac{1}{2}$ of a whole. There are $4$ pieces in total.\n\nThe model tells us that when we divide $2$ wholes into halves, we will be left with $4$ pieces.\n\nHence, the division problem is:\n\n$$\n\\boxed{\\,2\\,}÷\\frac{1}{2}=\\boxed{\\,4\\,}\n$$\n\nTherefore, the missing numbers are $2$ and $4.$"}] [{:db/id #edb/ref 17592186425717 :knowledge-point/_questions [{:db/id #edb/ref 17592186073723 :knowledge-point/id #uuid "79e310e4-b8a2-5327-b4e6-fd71b6783e3a" :knowledge-point/title "Dividing Whole Numbers by Unit Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a81f729d-2453-5e72-965f-0fe0c5d6bc0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186425693} {:answer/id #uuid "a8f3ad67-64ee-515e-8f56-2665acd0fa5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186425694} {:answer/id #uuid "cd3b6376-8e4f-5c46-bf13-517082472202" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186425697} {:answer/id #uuid "e