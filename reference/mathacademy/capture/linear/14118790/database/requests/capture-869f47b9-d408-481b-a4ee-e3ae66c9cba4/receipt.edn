ea-5a99-8c7a-f1ea5fd2dbc6" 13194139534229 17592186045417 true] [17592186415058 1080 "III only" 13194139534229 17592186045417 true] [17592186415058 1082 #edb/ref 17592186045499 13194139534229 17592186045417 true] [17592186415058 1083 #uuid "a66c38ea-8581-5edc-9742-8946b8e3e270" 13194139534229 17592186045417 true] [17592186415059 1080 "I only" 13194139534229 17592186045417 true] [17592186415059 1082 #edb/ref 17592186045499 13194139534229 17592186045417 true] [17592186415059 1083 #uuid "f381c62f-1e63-5006-ba9d-a84a80c6800c" 13194139534229 17592186045417 true] [17592186415060 1075 #edb/ref 17592186415055 13194139534229 17592186045417 true] [17592186415060 1075 #edb/ref 17592186415056 13194139534229 17592186045417 true] [17592186415060 1075 #edb/ref 17592186415057 13194139534229 17592186045417 true] [17592186415060 1075 #edb/ref 17592186415058 13194139534229 17592186045417 true] [17592186415060 1075 #edb/ref 17592186415059 13194139534229 17592186045417 true] [17592186415060 1076 #edb/ref 17592186045493 13194139534229 17592186045417 true] [17592186415060 1077 "selection" 13194139534229 17592186045417 true] [17592186415060 1078 #edb/ref 17592186415056 13194139534229 17592186045417 true] [17592186415060 1079 #uuid "f0e50222-5322-5dc6-95c0-87aed25c41a3" 13194139534229 17592186045417 true] [17592186415061 1068 #edb/ref 17592186415060 13194139534229 17592186045417 true] [17592186415061 1069 "q-35580" 13194139534229 17592186045417 true] [17592186415061 1070 #edb/ref 17592186045486 13194139534229 17592186045417 true] [17592186415061 1071 "Consider a vector space $V$ and vectors ${v}_{1},{v}_{2},{v}_{3},{v}_{4}\\in V.$ Given that ${{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ is linearly dependent and ${{v}_{1},{v}_{3},{v}_{4}}$ is linearly independent, which of the following statements are true?\n\n- ${x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}+{x}_{4}{v}_{4}=0$ has only zero solution ${x}_{1}={x}_{2}={x}_{3}={x}_{4}=0$\n- ${v}_{2}$ is a linear combination of ${v}_{1}$, ${v}_{3}$ and ${v}_{4}$\n- ${v}_{4}$ is a linear combination of ${v}_{1}$ and ${v}_{3}$" 13194139534229 17592186045417 true] [17592186415061 1072 #uuid "0c07b7ca-2c8b-5a74-a857-c6a369e5fb28" 13194139534229 17592186045417 true] [17592186415061 1074 "Let's examine each of the given options in turn.\n\n- Statement I is false. Since ${{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ is a linearly dependent set, we obtain that\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}+{x}_{4}{v}_{4}=0\n$$\n\nhas a non-zero solution.\n\n- Statement II is true. Indeed, solving equation ${x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}+{x}_{4}{v}_{4}=0$ for ${v}_{2},$ we obtain\n\n$$\n{v}_{2}=-\\frac{{x}_{1}}{{x}_{2}}{v}_{1}-\\frac{{x}_{3}}{{x}_{2}}{v}_{3}-\\frac{{x}_{4}}{{x}_{2}}{v}_{4}.\n$$\n\nMoreover, ${x}_{2}$ can't be zero because then\n\n$$\n{x}_{1}{v}_{1}+{x}_{3}{v}_{3}+{x}_{4}{v}_{4}=0\n$$\n\nwill have a non-zero solution and that's a contradiction as ${{v}_{1},{v}_{3},{v}_{4}}$ is linearly independent.\nHence, ${v}_{2}$ is a linear combination of ${v}_{1}$, ${v}_{3}$ and ${v}_{4}.$\n\n- Statement III is false. Since the set ${{v}_{1},{v}_{3},{v}_{4}}$ is linearly independent set, the equation \n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{3}+{x}_{3}{v}_{4}=0\n$$\n\nhas no non-zero solution. Hence, ${v}_{4}$ is not a linear combination of ${v}_{1}$ and ${v}_{3}$\n\nTherefore, the correct answer is \"II only.\"" 13194139534229 17592186045417 true] [17592186415062 1058 #edb/ref 17592186415063 13194139534229 17592186045417 true] [17592186415062 1062 #uuid "194a201e-a484-52b1-85fa-bf0a3ff539e0" 13194139534229 17592186045417 true] [17592186415062 1063 #edb/ref 17592186415061 13194139534229 17592186045417 true] [17592186415063 1058 #edb/ref 17592186415064 13194139534229 17592186045417 true] [17592186415063 1062 #uuid "390603f7-3592-5dc2-9f55-cc90d76600ad" 13194139534229 17592186045417 true] [17592186415063 1063 #edb/ref 17592186329740 13194139534229 17592186045417 true] [17592186415064 1058 #edb/ref 17592186415066 13194139534