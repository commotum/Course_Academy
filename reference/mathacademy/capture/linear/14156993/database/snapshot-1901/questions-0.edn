#{[{:db/id #edb/ref 17592186175716 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186176090 :knowledge-point/id #uuid "66cc300e-ea2a-5a29-b7d7-ca3c91e9c84a" :knowledge-point/title "Raising an Integer to a Negative Power"}] :question/id #uuid "3bb5bbce-4606-5a62-91a0-7f3fe0ce184b" :question/math-academy-id "e-12805" :question/problem "Evaluate $2^{-3}.$" :question/worked-solution "We find the reciprocal of the base $({\\color{blue}{2}}),$ and then raise that reciprocal to the same power but with the *opposite* sign $({{\\color{red}{+3}}}),$ as follows:\n\n$$\n\\begin{aligned}{2}^{-3} & ={(\\frac{1}{2})}^{3} \\\\  & =(\\frac{1}{2})\\times (\\frac{1}{2})\\times (\\frac{1}{2}) \\\\  & =(\\frac{1\\times 1\\times 1}{2\\times 2\\times 2}) \\\\  & =\\frac{1}{8}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186175717 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186176091 :knowledge-point/id #uuid "47675504-c040-5b23-8ef1-73412a6b6f81" :knowledge-point/title "Raising a Fraction to a Negative Power"}] :question/id #uuid "524f9638-a5cc-5506-9ccd-00393c236a68" :question/math-academy-id "e-12806" :question/problem "Calculate the value of $\\left(\\dfrac{1}{4}\\right)^{-2}.$" :question/worked-solution "We find the reciprocal of the base $\\left(\\dfrac 1 4\\right),$ and then raise that reciprocal to the same power but with the *opposite* sign $(+{\\color{blue}2}),$ as follows:\n\n$$\n\\begin{aligned}{(\\frac{1}{4})}^{-2} & =(4)^{2} \\\\  & =4\\cdot 4 \\\\  & =16\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186175718 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186176092 :knowledge-point/id #uuid "8987f52a-5da7-51db-8266-9abc33d3f326" :knowledge-point/title "Expressing a Fraction as a Power With a Negative Exponent"}] :question/id #uuid "5e8e6bb7-5ad4-5898-9745-f78d3f0328b6" :question/math-academy-id "e-12807" :question/problem "Express $\\dfrac {1} {49}$ as a base raised to a negative exponent." :question/worked-solution "First, we write $\\dfrac{1}{49}$ as a base raised to a power:\n\n$$\n\\begin{aligned}\\frac{1}{49} & =\\frac{1\\times 1}{7\\times 7} \\\\  & =\\frac{1}{7}\\times \\frac{1}{7} \\\\  & ={(\\frac{1}{7})}^{2}\\end{aligned}\n$$\n\nNow, we find the reciprocal of the base $\\left(\\dfrac{1}{7}\\right),$ and then raise that reciprocal to the same power but with the *opposite* sign $(-2),$ as follows:\n\n$$\n\\left( \\dfrac{1}{7} \\right)^2 = 7^{-2}\n$$"}] [{:db/id #edb/ref 17592186176317 :knowledge-point/_questions [{:db/id #edb/ref 17592186176092 :knowledge-point/id #uuid "8987f52a-5da7-51db-8266-9abc33d3f326" :knowledge-point/title "Expressing a Fraction as a Power With a Negative Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41f1fafd-d827-531f-8c70-6919b2012ba0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{2}{3})}^{2}" :db/id #edb/ref 17592186480220} {:answer/id #uuid "5c52ccdf-bc66-5508-a679-0e1f1417b58e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{3}{2})}^{-2}" :db/id #edb/ref 17592186480267} {:answer/id #uuid "7c2fd2a0-35b0-5c42-b70a-f84a88d2104e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{2}{3})}^{-2}" :db/id #edb/ref 17592186480315} {:answer/id #uuid "9ddc2f7c-ba78-53a1-9db1-6d1f0654ddad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{(\\frac{2}{3})}^{2}" :db/id #edb/ref 17592186480370} {:answer/id #uuid "fd7d8a12-8d4e-52c1-ba72-0806b3d500b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{(\\frac{2}{3})}^{-2}" :db/id #edb/ref 17592186480524}] :answer-field/correct {:answer/id #uuid "7c2fd2a0-35b0-5c42-b70a-f84a88d2104e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{2}{3})}^{-2}" :db/id #edb/ref 17592186480315} :answer-field/id #uuid "23c0cd21-a7b1-553c-a1a1-