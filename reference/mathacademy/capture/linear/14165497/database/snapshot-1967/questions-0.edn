#{[{:db/id #edb/ref 17592186490320 :knowledge-point/_questions [{:db/id #edb/ref 17592186073739 :knowledge-point/id #uuid "ae17eb3f-f444-5ab3-82fd-6c92b97b0e41" :knowledge-point/title "Simplifying Ratios"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ab0f3fb-4e36-5cb7-9b92-bf6665005eea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2:1" :db/id #edb/ref 17592186489538} {:answer/id #uuid "4b95827d-b1f3-513f-a04b-4e3930a7a8ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2:2" :db/id #edb/ref 17592186489690} {:answer/id #uuid "9a2c18ff-74f1-5d6b-965e-9c4142e35106" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1:4" :db/id #edb/ref 17592186489857} {:answer/id #uuid "a3480f70-f3e4-5b52-9b49-7446ba7d2f81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1:2" :db/id #edb/ref 17592186489878} {:answer/id #uuid "c8575184-e89c-5e39-8b80-accc5525b223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2:6" :db/id #edb/ref 17592186489949}] :answer-field/correct {:answer/id #uuid "a3480f70-f3e4-5b52-9b49-7446ba7d2f81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1:2" :db/id #edb/ref 17592186489878} :answer-field/id #uuid "f2e569b9-68b5-54d0-bd0f-496bb3345979" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490202}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ec0c1b9c-5490-5482-a264-c0fe31855e42" :question/math-academy-id "q-101444" :question/problem "![](images/ed/eda2132e8e050399298b97dc9d36cf27862d6aa4625e7aa870bb4c8fd246e781.png)\n\nWhat ratio describes the number of triangles to the number of pentagons?" :question/worked-solution "We count the number of triangles. We see that there are $2$ triangles.\n\nWe count the number of pentagons. We see that there are $4$ pentagons.\n\nSo the ratio of triangles to pentagons is $2:4.$\n\nWe can simplify this ratio by dividing both numbers in a ratio by $2:$\n\n$$\n\\begin{aligned}\\,\\,2 &  & : & \\,\\,\\,\\, & \\,\\,\\,4 &  \\\\ \\,\\,↓÷\\,\\,2 &  &  &  & \\,\\,\\,↓÷\\,\\,2 &  \\\\ \\,\\,1 &  & : &  & \\,\\,\\,2 & \\end{aligned}\n$$\n\nTherefore, the ratio of triangles to pentagons is $1:2.$"}] [{:db/id #edb/ref 17592186490312 :knowledge-point/_questions [{:db/id #edb/ref 17592186073740 :knowledge-point/id #uuid "d16202af-d3ac-54bc-9c76-25947a7a0b60" :knowledge-point/title "Completing a Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "311f524f-5dec-5e52-ac4c-9fb446367ae9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186489626} {:answer/id #uuid "640e11a1-45f1-5bd9-ba70-d2bd9afff6a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186489750} {:answer/id #uuid "6b8d1a24-f0b3-5957-bac1-4b551d6b4aff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186489770} {:answer/id #uuid "736365bf-c5ec-516a-96d3-5dcf4aad4bc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186489785} {:answer/id #uuid "8790ecbf-d319-56cd-88f6-19ef7c84fee4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186489822}] :answer-field/correct {:answer/id #uuid "311f524f-5dec-5e52-ac4c-9fb446367ae9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186489626} :answer-field/id #uuid "a7379773-3775-53b0-a3c8-4af0a853a08a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490169}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ddf5db22-7c12-5596-b4f6-5a61a8187c11" :question/math-academy-id "q-59828" :question/problem "If $10$ children ate $15$ cakes, what number is missing from the boxes in the statement below?\n\nThe ratio of eaten cakes to children is $3:\\boxed{}\\,$ because there are $3$ eaten cakes for every $\\boxed{}\\,$ children." :question/worked-solution "Since $10$ children can eat $15$ cakes, the ratio of cakes to children is $15:10.$\n\nWe can simplify this ratio by dividing both numbers by $5$:\n\n$$\n\\begin{aligned}\\,\\,15 &  & : & \\,\\,\\,\\, & \\,\\,\\,10 &  \\\\ \\,\\,\\,↓÷\\,\\,5 &  &  &  & \\,\\,\\,\\,↓÷\\,\\,5 &  \\\\ \\,\\,\\,3 &  & : &  & \\,\\,\\,\\,2 & \\end{aligned}\n$$\n\nThat means that $3:2$ is equivalent to $15:10.$ \n\nSo, the complete statement is\n\"The ratio of eaten cakes to children is $3:2\\,$ because there are $3$ cakes for every $2\\,$ children.\"\n\nThe missing number is $2.$"}] [{:db/id #edb/ref 17592186490219 :knowledge-point/_questions [{:db/id #edb/ref 17592186073740 :knowledge-point/id #uuid "d16202af-d3ac-54bc-9c76-25947a7a0b60" :knowledge-point/title "Completing a Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b8636ec-a6ca-5436-8dd7-6da7ca001b95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186489611} {:answer/id #uuid "b6f1e389-8ab5-503e-b205-cc5f0bcc7461" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186489916} {:answer/id #uuid "c459ed53-041f-5cf1-a8ab-49b000eb425c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186489940} {:answer/id #uuid "cd10f7eb-7f59-5705-9648-668ef168f8d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186489970} {:answer/id #uuid "d3ee81e2-8914-5cd6-8aba-c7a5b8a811e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186489984}] :answer-field/correct {:answer/id #uuid "cd10f7eb-7f59-5705-9648-668ef168f8d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186489970} :answer-field/id #uuid "fa08328e-cc55-5205-a1b2-f02f8b69f734" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490207}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1816745e-33d2-5605-bad0-d9ea4d6d5feb" :question/math-academy-id "q-59896" :question/problem "![](images/e6/e6c5263a440942da90d5ed6dc6a87e9e6caa0848dfb23c1a904eb828dfcaaeb1.png)\n\nWhat number is missing from the boxes in the statement below?\n\nThe ratio of rectangles to pentagons is $1:\\boxed{}\\,$ because there is $1$ rectangle for every $\\boxed{}$ pentagons." :question/worked-solution "First, we count the number of rectangles. We see that there are $2$ rectangles.\n\nThen, we count the number of pentagons. We see that there are $2$ pentagons.\n\nSo the ratio of rectangles to pentagons is $2:2.$\n\nWe can simplify this ratio by dividing both numbers by $2$:\n\n$$\n\\begin{aligned}\\,\\,2 &  & : & \\,\\,\\,\\, & \\,\\,\\,2 &  \\\\ \\,\\,↓÷\\,\\,2 &  &  &  & \\,\\,\\,↓÷\\,\\,2 &  \\\\ \\,\\,1 &  & : &  & \\,\\,\\,1 & \\end{aligned}\n$$\n\nThis means that $1:1$ is equivalent to $2:2.$ \n\nSo, the complete statement is\n\"The ratio of rectangles to pentagons is $1:1$ because there is $1$ rectangle for every $1$ pentagon.\""}]}
