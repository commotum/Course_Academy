e=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle style=\"background-color: lightgray;\"><mjx-mpadded><mjx-block style=\"width: 0.835em; margin: 0.167em 0px; position: relative;\"><mjx-rbox style=\"left: 0.167em; top: 0px; max-width: 0.835em;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle mathbackground=\"lightgray\"><mpadded height=\"+3px\" depth=\"+3px\" lspace=\"3px\" width=\"+6px\"><mn>1</mn></mpadded></mstyle></math></mjx-assistive-mml></mjx-container> pentagon.\"</p>\n</div></div>",
