#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186111644} :activity/id #uuid "e9deb9b7-056e-5107-bc5d-5329bb79660b" :activity/scope {:db/id #edb/ref 17592186050375 :topic/id #uuid "442f2129-23ce-53eb-9f85-7f9a3ae22164" :topic/math-academy-id 1473} :activity/steps [{:db/id #edb/ref 17592186111644 :step/content {:db/id #edb/ref 17592186111877 :tutorial/content "We can simplify the addition of two logarithms that share a base using the **product rule** for logarithms.\n\nThe **product rule** states that two logarithms which share a common base $\\color{blue}n$ satisfy\n\n$$\n\\log_{\\color{blue}n}(a) + \\log_{\\color{blue}n}(b) = \\log_{\\color{blue}n}\\left( ab\\right).\n$$\n\nSo, we can use the product rule to rewrite $\\log_{\\color{blue}5}(4) + \\log_{\\color{blue}5}(3)$ as\n\n$$\n\\begin{aligned}{log}_{5}⁡4+{log}_{5}⁡(3) & ={log}_{5}⁡(4\\cdot 3) \\\\  & ={log}_{5}⁡(12).\\end{aligned}\n$$\n\nThe product rule works exactly the same for the natural and common logarithms." :tutorial/id #uuid "a915130a-f6b9-5fec-a625-3d6d987255ac" :tutorial/math-academy-id 2782 :tutorial/title "Introduction"} :step/id #uuid "4804adec-ffac-52d5-9554-90532fefcf46" :step/math-academy-id 455954 :step/next {:db/id #edb/ref 17592186111645}} {:db/id #edb/ref 17592186111645 :step/content {:db/id #edb/ref 17592186110696 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110486 :question/id #uuid "4e63488a-97a0-5b21-ac91-2f0c9a1efa54" :question/math-academy-id "e-4014"} :knowledge-point/id #uuid "0a5bab3a-bddf-54c8-a52f-1358f224c22c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049560}] :knowledge-point/questions [{:db/id #edb/ref 17592186110982} {:db/id #edb/ref 17592186111031} {:db/id #edb/ref 17592186540045}] :knowledge-point/title "Combining Logarithms Using the Product Rule"} :step/id #uuid "da9135a3-0714-5821-9342-7af0dfdc24c1" :step/math-academy-id 455955 :step/next {:db/id #edb/ref 17592186111646}} {:db/id #edb/ref 17592186111646 