 :knowledge-point/_questions [{:db/id #edb/ref 17592186110698 :knowledge-point/id #uuid "d65ce7f4-c4c9-5620-bc55-01017d98272f" :knowledge-point/title "Separating a Logarithm Into Two Logarithms Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30095a16-941c-5ff3-8355-ce843412be95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\operatorname{log}⁡6+9\\operatorname{log}⁡z" :db/id #edb/ref 17592186539570} {:answer/id #uuid "4affeb3e-b42c-5d5b-8cab-c8154d657845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{log}⁡54\\cdot \\operatorname{log}⁡z" :db/id #edb/ref 17592186539613} {:answer/id #uuid "7cee4f51-d29f-5795-bc14-e1d92f5c1eea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{log}⁡54+9\\operatorname{log}⁡z" :db/id #edb/ref 17592186539685} {:answer/id #uuid "98634f48-1f44-519f-baf0-65a1ef368065" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\operatorname{log}⁡6\\cdot \\operatorname{log}⁡z" :db/id #edb/ref 17592186539732} {:answer/id #uuid "d6a95e06-d45a-5718-a707-1fcd0ea8d7e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\operatorname{log}⁡6+\\operatorname{log}⁡z" :db/id #edb/ref 17592186539847}] :answer-field/correct {:answer/id #uuid "30095a16-941c-5ff3-8355-ce843412be95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\operatorname{log}⁡6+9\\operatorname{log}⁡z" :db/id #edb/ref 17592186539570} :answer-field/id #uuid "39b373e2-c023-56ba-ad40-38e2f5029528" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539942}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fbe8f3d1-3c93-5a68-ac60-38c193b6c6b9" :question/math-academy-id "q-47212" :question/problem "$9\\operatorname{log}⁡(6z)=$" :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nUsing the product rule for logarithms and the distributive law, we obtain\n\n$$\n\\begin{aligned}9\\operatorname{log}⁡(6z) & =9(\\operatorname{log}⁡6+\\operatorname{log}⁡z) \\\\  & =9\\operatorname{log}⁡6+9\\operatorname{log}⁡z.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540112 :knowledge-point/_questions [{:db/id #edb/ref 17592186110698 :knowledge-point/id #uuid "d65ce7f4-c4c9-5620-bc55-01017d98272f" :knowledge-point/title "Separating a Logarithm Into Two Logarithms Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "197e74ce-32e5-5a69-87d8-f7fbe61494be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10+\\operatorname{log}⁡({x}^{2})" :db/id #edb/ref 17592186539532} {:answer/id #uuid "2f4c7963-1deb-5a29-86ed-b9412ff17c06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20+\\operatorname{log}⁡x" :db/id #edb/ref 17592186539567} {:answer/id #uuid "882199fc-d098-5e8a-ace9-084eb555a224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{log}⁡2+\\operatorname{log}⁡({x}^{2})" :db/id #edb/ref 17592186539706} {:answer/id #uuid "ac257b80-c474-59a8-895d-20f3d20f523e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+\\operatorname{log}⁡({x}^{2})" :db/id #edb/ref 17592186539772} {:answer/id #uuid "c1f80b35-efbd-55e9-a59e-52dc28ea93ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4+\\operatorname{log}⁡x" :db/id #edb/ref 17592186539815}] :answer-field/correct {:answer/id #uuid "ac257b80-c474-59a8-895d-20f3d20f523e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+\\operatorname{log}⁡({x}^{2})" :db/id #edb/ref 17592186539772} :answer-field/id #uuid "6cb60d82-ebf9-5dcc-8726-85d1f4e43c62" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539962}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fba4c35a-120c-5bd8-b872-2cfc6815a465" :question/math-academy-id "q-66559" :question/problem "$\\operatorname{log}⁡(100{x}^{2})=$" :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nUsing the product rule, the given expression can be rewritten as\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(100{x}^{2})=\\operatorname{log}⁡100+\\operatorname{log}⁡({x}^{2}).\\end{aligned}\n$$\n\nSince $100={10}^{2},$ we have\n\n$$\n\\operatorname{log}⁡100=\\operatorname{log}⁡({10}^{2})=2.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(100{x}^{2}) & =\\operatorname{log}⁡100+\\operatorname{log}⁡({x}^{2}) \\\\  & =2+\\operatorname{log}⁡({x}^{2}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540045 :knowledge-point/_questions [{:db/id #edb/ref 17592186110696 :knowledge-point/id #uuid "0a5bab3a-bddf-54c8-a52f-1358f224c22c" :knowledge-point/title "Combining Logarithms Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6563490e-1ac0-53ef-ab99-05500d25141e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{18}⁡13" :db/id #edb/ref 17592186539646} {:answer/id #uuid "7e056c0f-0002-5d5b-bf81-a67b2f76e5c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{6}⁡13" :db/id #edb/ref 17592186539686} {:answer/id #uuid "a3635b55-e19b-56d9-8c0a-0e8f74d3c21f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{6}⁡48" :db/id #edb/ref 17592186539754} {:answer/id #uuid "e3d4e277-0fc4-529c-ada0-4c7bf18a7cf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{216}⁡48" :db/id #edb/ref 17592186539868} {:answer/id #uuid "f33b67b7-0bd9-5cf2-97c4-bb4c7e0b9a78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{18}⁡48" :db/id #edb/ref 17592186539888}] :answer-field/correct {:answer/id #uuid "a3635b55-e19b-56d9-8c0a-0e8f74d3c21f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{6}⁡48" :db/id #edb/ref 17592186539754} :answer-field/id #uuid "bffb35e1-1e25-5cd4-871a-eb15db9f4c0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539991}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3a84d4a4-1873-5e3e-810d-d5ca7ce87d53" :question/math-academy-id "q-66743" :question/problem "Express ${log}_{6}⁡8+{log}_{6}⁡3+{log}_{6}⁡2$ as a single logarithm." :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nUsing the product rule for logarithms, we can combine the first two terms as follows:\n\n$$\n\\begin{aligned}{log}_{6}⁡8+{log}_{6}⁡3+{log}_{6}⁡2 & ={log}_{6}⁡(8\\cdot 3)+{log}_{6}⁡2 \\\\  & ={log}_{6}⁡24+{log}_{6}⁡2\\end{aligned}\n$$\n\nUsing the product rule for logarithms once more, we obtain\n\n$$\n\\begin{aligned}{log}_{6}⁡24+{log}_{6}⁡2 & ={log}_{6}⁡(24\\cdot 2) \\\\  & ={log}_{6}⁡48.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540052 :knowledge-point/_questions [{:db/id #edb/ref 17592186110697 :knowledge-point/id #uuid "7f507303-8140-5228-8383-c27f2a7518af" :knowledge-point/title "Combining Logarithms With Coefficients Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0db5a639-f3fe-598f-ab82-81a7029de9bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{log}_{6}⁡20" :db/id #edb/ref 17592186539507} {:answer/id #uuid "445c01e6-52e6-54d8-8abe-4213152f1a48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10{log}_{3}⁡20" :db/id #edb/ref 17592186539606} {:answer/id #uuid "82fdc84f-7132-5172-8c03-9226be816ca4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{log}_{6}⁡9" :db/id #edb/ref 17592186539696} {:answer/id #uuid "9457237b-99a1-52c8-b7cd-c0936c7acc0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10{log}_{3}⁡9" :db/id #edb/ref 17592186539725} {:answer/id #uuid "d91f4297-0733-5082-b97e-b9972dff4d1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{log}_{3}⁡20" :db/id #edb/ref 17592186539853}] :answer-field/correct {:answer/id #uuid "d91f4297-0733-5082-b97e-b9972dff4d1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{log}_{3}⁡20" :db/id #edb/ref 17592186539853} :answer-field/id #uuid "03f6e7c1-29f6-526a-acd6-fbd0f2dceb15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539919}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "56e99923-e71e-5783-b293-6f220455cbaa" :question/math-academy-id "q-66752" :question/problem "Express $5{log}_{3}⁡4+5{log}_{3}⁡5$ as a single logarithm." :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nIf we factor the given expression and use the product rule for logarithms, we get\n\n$$\n\\begin{aligned}5{log}_{3}⁡4+5{log}_{3}⁡5 & =5({log}_{3}⁡4+{log}_{3}⁡5) \\\\  & =5{log}_{3}⁡(4\\cdot 5) \\\\  & =5{log}_{3}⁡20.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n5{log}_{3}⁡4+5{log}_{3}⁡5=5{log}_{3}⁡20.\n$$"}] [{:db/id #edb/ref 17592186540092 :knowledge-point/_questions [{:db/id #edb/ref 17592186110698 :knowledge-point/id #uuid "d65ce7f4-c4c9-5620-bc55-01017d98272f" :knowledge-point/title "Separating a Logarithm Into Two Logarithms Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "020e75fa-c086-57b4-9ebf-21542d8c63cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+{log}_{4}⁡({x}^{3})" :db/id #edb/ref 17592186539480} {:answer/id #uuid "19adf85a-9390-59b5-8ea9-1d27f9b2fd10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4+{log}_{4}⁡(2{x}^{3})" :db/id #edb/ref 17592186539534} {:answer/id #uuid "4cdce3f1-a378-50c2-a9e9-17d33b0d500b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+{log}_{4}⁡(2{x}^{3})" :db/id #edb/ref 17592186539617} {:answer/id #uuid "8ccf5773-895e-5f5b-9ed9-deca69d9a7d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{log}_{4}⁡({x}^{3})" :db/id #edb/ref 17592186539717} {:answer/id #uuid "d73b0aa8-1e69-5772-8f5d-4f93250e4de6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{log}_{4}⁡({x}^{3})" :db/id #edb/ref 17592186539848}] :answer-field/correct {:answer/id #uuid "020e75fa-c086-57b4-9ebf-21542d8c63cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+{log}_{4}⁡({x}^{3})" :db/id #edb/ref 17592186539480} :answer-field/id #uuid "089e5ce6-a93c-5b0c-b28e-ebc7a141b727" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539922}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c529b9a8-1cea-5cb5-8b9e-8f76c8202de5" :question/math-academy-id "q-66758" :question/problem "${log}_{4}⁡(16{x}^{3})=$" :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nUsing the product rule, the given expression can be rewritten as\n\n$$\n\\begin{aligned}{log}_{4}⁡(16{x}^{3})={log}_{4}⁡16+{log}_{4}⁡({x}^{3}).\\end{aligned}\n$$\n\nSince $16={4}^{2},$ we have\n\n$$\n{log}_{4}⁡16={log}_{4}⁡({4}^{2})=2.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{log}_{4}⁡(16{x}^{3}) & ={log}_{4}⁡16+{log}_{4}⁡({x}^{3}) \\\\  & =2+{log}_{4}⁡({x}^{3}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540054 :knowledge-point/_questions [{:db/id #edb/ref 17592186110698 :knowledge-point/id #uuid "d65ce7f4-c4c9-5620-bc55-01017d98272f" :knowledge-point/title "Separating a Logarithm Into Two Logarithms Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "472859b6-378d-5a85-9402-f77209b6b266" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3+{log}_{2}⁡(2{x}^{2})" :db/id #edb/ref 17592186539609} {:answer/id #uuid "6c751c3d-6306-5ba4-b5d9-890c50db6015" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡(5{x}^{2})" :db/id #edb/ref 17592186539662} {:answer/id #uuid "cc9395b5-2ba1-5433-9ecd-e4f246ee484e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5+{log}_{2}⁡({x}^{2})" :db/id #edb/ref 17592186539829} {:answer/id #uuid "f213b84e-618e-5486-8267-09711b7b7a84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{log}_{2}⁡({x}^{2})" :db/id #edb/ref 17592186539886} {:answer/id #uuid "f9945c07-0881-5176-8dd2-9c1ee7fffd20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3+{log}_{2}⁡({x}^{2})" :db/id #edb/ref 17592186539901}] :answer-field/correct {:answer/id #uuid "cc9395b5-2ba1-5433-9ecd-e4f246ee484e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "