#{[{:db/id #edb/ref 17592186110486 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110696 :knowledge-point/id #uuid "0a5bab3a-bddf-54c8-a52f-1358f224c22c" :knowledge-point/title "Combining Logarithms Using the Product Rule"}] :question/id #uuid "4e63488a-97a0-5b21-ac91-2f0c9a1efa54" :question/math-academy-id "e-4014" :question/problem "Express $\\log_3(2)+\\log_3(5)$ as a single logarithm." :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n\\log_n a + \\log_n b = \\log_n(ab)\n$$\n\nUsing the product rule for logarithms, the given expression can be rewritten as\n\n$$\n\\begin{aligned}{log}_{3}⁡2+{log}_{3}⁡5 & ={log}_{3}⁡(2\\cdot 5) \\\\  & ={log}_{3}⁡10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186110487 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110697 :knowledge-point/id #uuid "7f507303-8140-5228-8383-c27f2a7518af" :knowledge-point/title "Combining Logarithms With Coefficients Using the Product Rule"}] :question/id #uuid "07d810ce-010c-5a07-8174-f01d9b807a60" :question/math-academy-id "e-4015" :question/problem "Express $3\\log_{5}{7}+3\\log_{5}{3}$ as a single logarithm." :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n\\log_n a + \\log_n b = \\log_n(ab)\n$$\n\nIf we factor the given expression and use the product rule for logarithms, we get\n\n$$\n\\begin{aligned}3{log}_{5}⁡7+3{log}_{5}⁡3 & =3({log}_{5}⁡7+{log}_{5}⁡3) \\\\  & =3{log}_{5}⁡(7\\cdot 3) \\\\  & =3{log}_{5}⁡21.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n3\\log_{5}{7}+3\\log_{5}{3} = 3\\log_{5} 21 .\n$$"}] [{:db/id #edb/ref 17592186110488 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110698 :knowledge-point/id #uuid "d65ce7f4-c4c9-5620-bc55-01017d98272f" :knowledge-point/title "Separating a Logarithm Into Two Logarithms Using the Product Rule"}] :question/id #uuid "679a8e3b-ef6c-565d-ab37-613dedfdf3df" :question/math-academy-id "e-4016" :question/problem "Express $\\ln\\left(x^2 y\\right)$ as a sum of two logarithms." :question/worked-solution "First, let's recall the product rule for natural logarithms:\n\n$$\n\\ln{a} + \\ln{b} = \\ln(ab)\n$$\n\nUsing the product rule, the given expression can be rewritten as\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({x}^{2}y) & =\\operatorname{ln}⁡({x}^{2}\\cdot y) \\\\  & =\\operatorname{ln}⁡({x}^{2})+\\operatorname{ln}⁡y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186110489 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110699 :knowledge-point/id #uuid "45529296-8cf2-5b94-8247-eab648dbacda" :knowledge-point/title "Evaluating an Expression Using the Product Rule"}] :question/id #uuid "39a1c600-8d35-5671-bcb1-62682d750cd3" :question/math-academy-id "e-4018" :question/problem "If $\\log_2(3)=k$ and $\\log_2(x)=p,$ what is the value of $\\log_2(3x)?$" :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n\\log_n a + \\log_n b = \\log_n(ab)\n$$\n\nUsing the product rule, we have\n\n$$\n\\begin{aligned}{log}_{2}⁡(3x) & ={log}_{2}⁡3+{log}_{2}⁡x \\\\  & =k+p.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540076 :knowledge-point/_questions [{:db/id #edb/ref 17592186110697 :knowledge-point/id #uuid "7f507303-8140-5228-8383-c27f2a7518af" :knowledge-point/title "Combining Logarithms With Coefficients Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c7cf433-98e4-521c-8756-1aaa0de20101" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64\\operatorname{log}⁡64" :db/id #edb/ref 17592186539505} {:answer/id #uuid "32ec0506-3bbd-5450-aec5-45053e66e796" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\operatorname{log}⁡14" :db/id #edb/ref 17592186539574} {:answer/id #uuid "3703a9c5-f286-515d-ba66-fc309d04cfa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{log}⁡64" :db/id #edb/ref 17592186539581} {:answer/id #uuid "3ffc69cd-1816-56af-b4a4-2f614d0c6c05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{log}⁡14" :db/id #edb/ref 17592186539594} {:answer/id #uuid "d52273df-2cdc-5121-ae5a-a9b18d565cb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{log}⁡64" :db/id #edb/ref 17592186539841}] :answer-field/correct {:answer/id #uuid "d52273df-2cdc-5121-ae5a-a9b18d565cb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{log}⁡64" :db/id #edb/ref 17592186539841} :answer-field/id #uuid "c885df1b-32ff-5811-ba54-2d8aa2af7d3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539996}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9ea8b2b1-a8ee-55af-9a04-8ea83c2d0aaa" :question/math-academy-id "q-108100" :question/problem "Express $4\\operatorname{log}⁡2+4\\operatorname{log}⁡4+4\\operatorname{log}⁡8$ as a single logarithm." :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nIf we factor the given expression and use the product rule for logarithms, we get\n\n$$\n\\begin{aligned}4\\operatorname{log}⁡2+4\\operatorname{log}⁡4+4\\operatorname{log}⁡8 & =4(\\operatorname{log}⁡2+4\\operatorname{log}⁡4+\\operatorname{log}⁡8) \\\\  & =4\\operatorname{log}⁡(2\\cdot 4\\cdot 8) \\\\  & =4\\operatorname{log}⁡64.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n4\\operatorname{log}⁡2+4\\operatorname{log}⁡4+4\\operatorname{log}⁡8=4\\operatorname{log}⁡64.\n$$"}] [{:db/id #edb/ref 17592186540050 :knowledge-point/_questions [{:db/id #edb/ref 17592186110699 :knowledge-point/id #uuid "45529296-8cf2-5b94-8247-eab648dbacda" :knowledge-point/title "Evaluating an Expression Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cc6b6a6-43be-5279-9c28-d4a15b97a7cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186539635} {:answer/id #uuid "87cbfab1-bb2d-5b42-b1df-3089693d6029" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10x+2y" :db/id #edb/ref 17592186539705} {:answer/id #uuid "8c5e26d6-7fb1-52eb-bd97-ef78fa48ede9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186539716} {:answer/id #uuid "9840868f-b940-5ed2-9e5b-49430536cb5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{10}{y}^{2}" :db/id #edb/ref 17592186539731} {:answer/id #uuid "b1e3d3db-20d4-51c4-9b30-1d9e01636929" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20xy" :db/id #edb/ref 17592186539783}] :answer-field/correct {:answer/id #uuid "5cc6b6a6-43be-5279-9c28-d4a15b97a7cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186539635} :answer-field/id #uuid "36b051f5-bf1c-54e5-8a93-26e5b24b1e4e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539940}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4ea44857-e35f-51f3-a0fe-716b02fb3232" :question/math-academy-id "q-108103" :question/problem "If $\\operatorname{ln}⁡x=10$ and $\\operatorname{ln}⁡y=2$, then $\\operatorname{ln}⁡(xy)=$" :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nUsing the product rule, we have\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(xy) & =\\operatorname{ln}⁡x+\\operatorname{ln}⁡y \\\\  & =10+2 \\\\  & =12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186111031 :knowledge-point/_questions [{:db/id #edb/ref 17592186110696 :knowledge-point/id #uuid "0a5bab3a-bddf-54c8-a52f-1358f224c22c" :knowledge-point/title "Combining Logarithms Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15010333-4fe3-58c3-9b8d-774f22c98a0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{125}⁡48" :db/id #edb/ref 17592186539520} {:answer/id #uuid "34191607-a84f-520a-941b-c61abefe22a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{5}⁡10" :db/id #edb/ref 17592186539576} {:answer/id #uuid "44f711d5-f916-58a0-9fd2-f9692427848c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{15}⁡48" :db/id #edb/ref 17592186539607} {:answer/id #uuid "566a2d36-e8a0-5180-945f-a8d73a39229d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{15}⁡12" :db/id #edb/ref 17592186539627} {:answer/id #uuid "8d50a5b0-9844-5e2c-97e0-9c0453654ffa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{5}⁡48" :db/id #edb/ref 17592186539718}] :answer-field/correct {:answer/id #uuid "8d50a5b0-9844-5e2c-97e0-9c0453654ffa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{5}⁡48" :db/id #edb/ref 17592186539718} :answer-field/id #uuid "1dc7909b-ed18-5a26-b360-ce0bd7c2f4b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186107941}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9cb9b8d4-254b-58ff-bc4a-531da47e017a" :question/math-academy-id "q-24424" :question/problem "Express ${log}_{5}⁡2+{log}_{5}⁡4+{log}_{5}⁡6$ as a single logarithm." :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nUsing the product rule for logarithms, we can combine the first two terms as follows:\n\n$$\n\\begin{aligned}{log}_{5}⁡2+{log}_{5}⁡4+{log}_{5}⁡6 & ={log}_{5}⁡(2\\cdot 4)+{log}_{5}⁡6 \\\\  & ={log}_{5}⁡8+{log}_{5}⁡6\\end{aligned}\n$$\n\nUsing the product rule for logarithms once more, we obtain\n\n$$\n\\begin{aligned}{log}_{5}⁡8+{log}_{5}⁡6 & ={log}_{5}⁡(8\\cdot 6) \\\\  & ={log}_{5}⁡48.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540109 :knowledge-point/_questions [{:db/id #edb/ref 17592186110697 :knowledge-point/id #uuid "7f507303-8140-5228-8383-c27f2a7518af" :knowledge-point/title "Combining Logarithms With Coefficients Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04eea80b-51f5-55aa-bacb-612eb84f806e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t^6" :db/id #edb/ref 17592186539488}] :answer-field/correct {:answer/id #uuid "04eea80b-51f5-55aa-bacb-612eb84f806e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t^6" :db/id #edb/ref 17592186539488} :answer-field/id #uuid "00dd99a1-dae8-5610-99d8-c9c6b36aae72" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186539916}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f62edb2c-be7a-51bc-a4d3-e51bf196542b" :question/math-academy-id "q-250763" :question/problem "Write the following expression as a single logarithm.\n\n$4\\operatorname{log}⁡t+4\\operatorname{log}⁡({t}^{2})+4\\operatorname{log}⁡({t}^{3})=4\\operatorname{log}⁡(${{field-1}}$)$" :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nIf we factor the given expression and use the product rule for logarithms, we get\n\n$$\n\\begin{aligned}4\\operatorname{log}⁡t+4\\operatorname{log}⁡({t}^{2})+4\\operatorname{log}⁡({t}^{3}) & =4(\\operatorname{log}⁡t+\\operatorname{log}⁡({t}^{2})+\\operatorname{log}⁡({t}^{3})) \\\\  & =4\\operatorname{log}⁡(t\\cdot {t}^{2}\\cdot {t}^{3}) \\\\  & =4\\operatorname{log}⁡({t}^{1+2+3}) \\\\  & =4\\operatorname{log}⁡({t}^{6}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540094 :knowledge-point/_questions [{:db/id #edb/ref 17592186110697 :knowledge-point/id #uuid "7f507303-8140-5228-8383-c27f2a7518af" :knowledge-point/title "Combining Logarithms With Coefficients Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d762dc30-ad94-5117-9809-03ee4cc6d7fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p^2q^2" :db/id #edb/ref 17592186539849}] :answer-field/correct {:answer/id #uuid "d762dc30-ad94-5117-9809-03ee4cc6d7fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p^2q^2" :db/id #edb/ref 17592186539849} :answer-field/id #uuid "f88f9804-ffdf-554f-8671-c239c2d469a6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540019}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c7c12aa8-de03-59c9-ab5d-5e64e226cea3" :question/math-academy-id "q-250764" :question/problem "Write the following expression as a single logarithm.\n\n$5\\operatorname{ln}⁡p+5\\operatorname{ln}⁡q+5\\operatorname{ln}⁡(pq)=5\\operatorname{ln}⁡(${{field-1}}$)$" :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nIf we factor the given expression and use the product rule for logarithms, we get\n\n$$\n\\begin{aligned}5\\operatorname{ln}⁡p+5\\operatorname{ln}⁡q+5\\operatorname{ln}⁡(pq) & =5(\\operatorname{ln}⁡p+\\operatorname{ln}⁡q+\\operatorname{ln}⁡(pq)) \\\\  & =5\\operatorname{ln}⁡(p\\cdot q\\cdot pq) \\\\  & =5\\operatorname{ln}⁡({p}^{2}{q}^{2}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540043 :knowledge-point/_questions [{:db/id #edb/ref 17592186110699 :knowledge-point/id #uuid "45529296-8cf2-5b94-8247-eab648dbacda" :knowledge-point/title "Evaluating an Expression Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "abb28333-7302-5a02-a869-b9a7b366e5a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186539769}] :answer-field/correct {:answer/id #uuid "abb28333-7302-5a02-a869-b9a7b366e5a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186539769} :answer-field/id #uuid "d81436c8-b74d-57b3-bd49-9a96197736a6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540001}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "35a5df48-5462-5c58-bbc0-60fbb99c3f4a" :question/math-academy-id "q-250785" :question/problem "If ${log}_{5}⁡s=4$ and ${log}_{5}⁡t=5,$ then ${log}_{5}⁡(st)=${{field-1}}." :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n{log}_{n}⁡a+{log}_{n}⁡b={log}_{n}⁡(ab)\n$$\n\nUsing the product rule, we have\n\n$$\n\\begin{aligned}{log}_{5}⁡(st) & ={log}_{5}⁡s+{log}_{5}⁡t \\\\  & =4+5 \\\\  & =9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540023 :knowledge-point/_questions [{:db/id #edb/ref 17592186110698 :knowledge-point/id #uuid "d65ce7f4-c4c9-5620-bc55-01017d98272f" :knowledge-point/title "Separating a Logarithm Into Two Logarithms Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03195d80-906e-5fc4-b665-ca11a907a266" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/va