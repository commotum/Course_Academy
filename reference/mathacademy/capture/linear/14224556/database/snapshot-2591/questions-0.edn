#{[{:db/id #edb/ref 17592186110486 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110696 :knowledge-point/id #uuid "0a5bab3a-bddf-54c8-a52f-1358f224c22c" :knowledge-point/title "Combining Logarithms Using the Product Rule"}] :question/id #uuid "4e63488a-97a0-5b21-ac91-2f0c9a1efa54" :question/math-academy-id "e-4014" :question/problem "Express $\\log_3(2)+\\log_3(5)$ as a single logarithm." :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n\\log_n a + \\log_n b = \\log_n(ab)\n$$\n\nUsing the product rule for logarithms, the given expression can be rewritten as\n\n$$\n\\begin{aligned}\n\\log_{3} 2 + \\log_{3} 5 &= \\log_{3} (2 \\cdot 5) \\\\\n&= \\log_{3} 10\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186110487 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110697 :knowledge-point/id #uuid "7f507303-8140-5228-8383-c27f2a7518af" :knowledge-point/title "Combining Logarithms With Coefficients Using the Product Rule"}] :question/id #uuid "07d810ce-010c-5a07-8174-f01d9b807a60" :question/math-academy-id "e-4015" :question/problem "Express $3\\log_{5}{7}+3\\log_{5}{3}$ as a single logarithm." :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n\\log_n a + \\log_n b = \\log_n(ab)\n$$\n\nIf we factor the given expression and use the product rule for logarithms, we get\n\n$$\n\\begin{aligned}\n3\\log_{5} 7 + 3\\log_{5} 3 &= 3(\\log_{5} 7 + \\log_{5} 3) \\\\\n&= 3\\log_{5} (7 \\cdot 3) \\\\\n&= 3\\log_{5} 21\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n3\\log_{5}{7}+3\\log_{5}{3} = 3\\log_{5} 21\n$$"}] [{:db/id #edb/ref 17592186110488 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110698 :knowledge-point/id #uuid "d65ce7f4-c4c9-5620-bc55-01017d98272f" :knowledge-point/title "Separating a Logarithm Into Two Logarithms Using the Product Rule"}] :question/id #uuid "679a8e3b-ef6c-565d-ab37-613dedfdf3df" :question/math-academy-id "e-4016" :question/problem "Express $\\ln\\left(x^2 y\\right)$ as a sum of two logarithms." :question/worked-solution "First, let's recall the product rule for natural logarithms:\n\n$$\n\\ln{a} + \\ln{b} = \\ln(ab)\n$$\n\nUsing the product rule, the given expression can be rewritten as\n\n$$\n\\begin{aligned}\n\\ln (x^{2}y) &= \\ln (x^{2} \\cdot y) \\\\\n&= \\ln (x^{2}) + \\ln y\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186110489 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110699 :knowledge-point/id #uuid "45529296-8cf2-5b94-8247-eab648dbacda" :knowledge-point/title "Evaluating an Expression Using the Product Rule"}] :question/id #uuid "39a1c600-8d35-5671-bcb1-62682d750cd3" :question/math-academy-id "e-4018" :question/problem "If $\\log_2(3)=k$ and $\\log_2(x)=p$, what is the value of $\\log_2(3x)$?" :question/worked-solution "First, let's recall the product rule for logarithms:\n\n$$\n\\log_n a + \\log_n b = \\log_n(ab)\n$$\n\nUsing the product rule, we have\n\n$$\n\\begin{aligned}\n\\log_{2} (3x) &= \\log_{2} 3 + \\log_{2} x \\\\\n&= k + p\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186111031 :knowledge-point/_questions [{:db/id #edb/ref 17592186110696 :knowledge-point/id #uuid "0a5bab3a-bddf-54c8-a52f-1358f224c22c" :knowledge-point/title "Combining Logarithms Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d24b47a7-e7fc-5c9d-b197-a4155e4eb5a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{15} 48" :db/id #edb/ref 17592186107942} {:answer/id #uuid "033f796e-65cb-527a-b376-9874d8dcb2df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{15} 12" :db/id #edb/ref 17592186107943} {:answer/id #uuid "3fe8fecf-db52-5bcd-8b48-8cb7b1c81ebc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{5} 10" :db/id #edb/ref 17592186107944} {:answer/id #uuid "437705ef-eef9-5101-9c39-8b73ffebf345" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{125} 48" :db/id #edb/ref 17592186107945} {:answer/id #uuid "4d5fd34f-e06d-52d1-848c-edf3467c1c09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{5} 48" :db/id #edb/ref 17592186107946}] :answer-field/id #uuid "1dc7909b-ed18-5a26-b360-ce0bd7c2f4b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186107941}] :question/id #uuid "9cb9b8d4-254b-58ff-bc4a-531da47e017a" :question/math-academy-id "q-24424" :question/problem "Express $\\log_{5} 2 + \\log_{5} 4 + \\log_{5} 6$ as a single logarithm."}]}
