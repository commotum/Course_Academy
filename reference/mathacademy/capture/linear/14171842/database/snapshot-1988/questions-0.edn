17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186492323} {:answer/id #uuid "6e36ad10-22c3-50b4-9383-18a95e87dc97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186492432} {:answer/id #uuid "99ba275d-8707-5320-9de4-c017d90c2488" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186492517} {:answer/id #uuid "9b0628ea-a3d4-5616-aabe-45731148c5da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186492520}] :answer-field/correct {:answer/id #uuid "99ba275d-8707-5320-9de4-c017d90c2488" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186492517} :answer-field/id #uuid "bcddaf7a-58f3-59c8-a82c-6fd31004ce54" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492781}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4a0d97f1-ddec-5f2c-85a3-f6fbd2526533" :question/math-academy-id "q-113590" :question/problem "![](images/09/099328ef89899f55ca661575aef3bbbd867164c65515d6e202815d1953922e0a.png)\n\nFor the diagram depicted above, which number corresponds to the point $S$ if $M$ is the midpoint of the line segment $\\overset{―}{RS}?$" :question/worked-solution "The point $R$ corresponds to the number ${x}_{1}=-8$ while the midpoint $M$ corresponds to ${x}_{m}=-5.$\n\nTo find the number ${x}_{2}$ corresponding to the point $S$, we first set up an equation using the midpoint formula:\n\n$$\n\\begin{aligned}{x}_{m} & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\ -5 & =\\frac{-8+{x}_{2}}{2}\\end{aligned}\n$$\n\nNow, we solve for ${x}_{2}:$\n\n$$\n\\begin{aligned}-5 & =\\frac{-8+{x}_{2}}{2} \\\\ 2\\cdot (-5) & =-8+{x}_{2} \\\\ -10 & =-8+{x}_{2} \\\\ -2 & ={x}_{2}\\end{aligned}\n$$\n\nTherefore, the point $S$ corresponds to ${x}_{2}=-2.$\n\n![](images/1d/1db6d041dc8dcbba0e10cbe3dae582bbc2bf8bc1619e93946807c9deae598be3.png)"}] [{:db/id #edb/ref 17592186492904 :knowledge-point/_questions [{:db/id #edb/ref 17592186110745 :knowledge-point/id #uuid "fb88880e-8b94-5223-b3fb-a4d80e795a00" :knowledge-point/title "Using Properties of Midpoints to Calculate an Unknown Value From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11ff7a2d-c9f3-5f78-aaf7-5f09b88c2c56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186492250} {:answer/id #uuid "34f1df00-d87e-5ae4-8b24-dfc6d4ff9d7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186492327} {:answer/id #uuid "6fc42a93-2e14-520f-be6b-0fb6326a43dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186492439} {:answer/id #uuid "95f74121-66dd-5ca2-baa0-e167ba66a61a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186492506} {:answer/id #uuid "a3253501-5c0c-51d4-86c2-c1958740fafb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186492545}] :answer-field/correct {:answer/id #uuid "6fc42a93-2e14-520f-be6b-0fb6326a43dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186492439} :answer-field/id #uuid "d8f14131-0d54-5378-be3f-be66553e0f75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492794}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bc836608-5ef1-5f77-9482-278eadbb421e" :question/math-academy-id "q-52879" :question/problem "![](images/50/508818c87b85ec8720d681895f54c264c8252a9b5f98b8878e53b20ad336dca5.png)\n\nGiven that $M$ is the midpoint of $\\overset{―}{AB}$, what is the value of $x?$" :question/worked-solution "Since $M$ is the midpoint of $\\overset{―}{AB}$, the segment $\\overset{―}{AB}$ is twice the length of the segment $\\overset{―}{AM}.$ So, we have:\n\n$$\n\\begin{aligned}2AM & =AB \\\\ 2(2x+1) & =5x-2 \\\\ 4x+2 & =5x-2\\end{aligned}\n$$\n\nNow, we subtract $4x$ from both sides of the equation:\n\n$$\n\\begin{aligned}4x+2-4x & =5x-2-4x \\\\ 2 & =x-2\\end{aligned}\n$$\n\nNext, we add $2$ to both sides:\n\n$$\n\\begin{aligned}2+2 & =x-2+2 \\\\ 4 & =x \\\\ x & =4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492927 :knowledge-point/_questions [{:db/id #edb/ref 17592186110746 :knowledge-point/id #uuid "c4a4cad5-d0b0-51cb-921f-31a96e8e5eda" :knowledge-point/title "Using Properties of Midpoints to Calculate an Unknown Value From a Description"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55d48370-e935-5a14-8ff7-92fab50ddeb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\text{cm}" :db/id #edb/ref 17592186492380} {:answer/id #uuid "5723d344-ca35-5535-b3c3-1ef54e6f94d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\text{cm}" :db/id #edb/ref 17592186492381} {:answer/id #uuid "7a7f8778-6edf-543d-8cac-0a76611a6bd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{cm}" :db/id #edb/ref 17592186492463} {:answer/id #uuid "8f136b1c-1b02-5c15-802e-11df664f9735" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,\\text{cm}" :db/id #edb/ref 17592186492499} {:answer/id #uuid "c5efffee-2512-5c6d-b408-f7b2a35b6714" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\text{cm}" :db/id #edb/ref 17592186492614}] :answer-field/correct {:answer/id #uuid "8f136b1c-1b02-5c15-802e-11df664f9735" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,\\text{cm}" :db/id #edb/ref 17592186492499} :answer-field/id #uuid "17d904dc-131f-5fe4-a7cc-64ca276dda6a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492712}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd2d1d70-4022-5a1e-92dc-fe5a115ab387" :question/math-academy-id "q-52880" :question/problem "The point $M$ is the midpoint of the line segment $\\overset{―}{PQ}.$ What is the value of $x$ if $MQ=x+3$ centimeters and $PM=3x+1$ centimeters?" :question/worked-solution "We have the following diagram.\n\n![](images/4a/4a7ae067ef93ac29b82bbe49571cf389a78b6c0afefda43651044bfe374a733a.png)\n\nSince $M$ is the midpoint of $\\overset{―}{PQ}$, the two segments $\\overset{―}{PM}$ and $\\overset{―}{MQ}$ have the same length. So, we have:\n\n$$\n\\begin{aligned}PM & =MQ \\\\ 3x+1 & =x+3 \\\\ 3x+1-x & =x+3-x \\\\ 2x+1 & =3 \\\\ 2x+1-1 & =3-1 \\\\ 2x & =2 \\\\ \\frac{2x}{2} & =\\frac{2}{2} \\\\ x & =1\\end{aligned}\n$$\n\nTherefore, $x=1\\,\\text{cm}.$"}] [{:db/id #edb/ref 17592186492865 :knowledge-point/_questions [{:db/id #edb/ref 17592186110747 :knowledge-point/id #uuid "c451d750-c40f-5b3f-9cd2-9eec197809de" :knowledge-point/title "Using the Midpoint Formula to Calculate an Endpoint"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65be47f9-4229-5608-86b2-51fa5c7aba08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186492422} {:answer/id #uuid "9ff87be2-67f8-5d90-b8be-7b2de16f1de9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186492535} {:answer/id #uuid "a91ca7c2-eeb8-55f0-8238-9d0c18bbd335" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186492560} {:answer/id #uuid "d62eecb2-f243-557b-9dbe-ad10491e7107" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186492638} {:answer/id #uuid "f2c4d0d9-c134-5f3f-b8e4-35a0c8698ffa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186492687}] :answer-field/correct {:answer/id #uuid "a91ca7c2-eeb8-55f0-8238-9d0c18bbd335" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186492560} :answer-field/id #uuid "dcddb8da-972e-597a-ba50-73da593fe6f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492797}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "62793849-cba3-52fb-b43b-5d7a22e7880a" :question/math-academy-id "q-53075" :question/problem "![](images/4c/4c0f6df3b2d18d8215d273d6e8b1bad601d1797298f08cd76da6d436672fd63f.png)\n\nFor the diagram depicted above, which number corresponds to the point $S$ if $M$ is the midpoint of the line segment $\\overset{―}{RS}?$" :question/worked-solution "The point $R$ corresponds to the number ${x}_{1}=-1$ while the midpoint $M$ corresponds to ${x}_{m}=2.$ \n\nTo find the number ${x}_{2}$ corresponding to the point $S$, we first set up an equation using the midpoint formula:\n\n$$\n\\begin{aligned}{x}_{m} & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\ 2 & =\\frac{-1+{x}_{2}}{2}\\end{aligned}\n$$\n\nNow, we solve for ${x}_{2}:$\n\n$$\n\\begin{aligned}2 & =\\frac{-1+{x}_{2}}{2} \\\\ 2\\cdot 2 & =-1+{x}_{2} \\\\ 4 & =-1+{x}_{2} \\\\ {x}_{2} & =5\\end{aligned}\n$$\n\nTherefore, the point $S$ corresponds to ${x}_{2}=5.$\n\n![](images/21/217ab059281bcd3a4f42b0601df820893630b3c2393cb5f1d87a7acec0a9522a.png)"}] [{:db/id #edb/ref 