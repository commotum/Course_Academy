#{[{:activity/first-step {:db/id #edb/ref 17592186111719} :activity/id #uuid "01608397-be37-5684-a088-261c3d612344" :activity/scope {:db/id #edb/ref 17592186050476 :topic/id #uuid "4cb923ba-b9fd-54eb-8613-ff3a3ef21278" :topic/math-academy-id 1463} :activity/steps [{:db/id #edb/ref 17592186111427 :step/content {:db/id #edb/ref 17592186111857 :tutorial/content "Let's find the midpoint $M$ of the line segment $\\overline{AB}$ on a number line, if $A$ corresponds to $x_1= 3$ and $B$ corresponds to $x_2=7$, as depicted below.\n\n![](images/11/115797e11eb3e434d5faefe412a8cefea216b6190436d408d199ac31d0da7210.png)\n\nThe midpoint of a line segment splits it into two segments of equal length.\nTo find the number $x_m$ corresponding to $M$, we use the following **midpoint formula**:\n\n$$\n\\begin{aligned}\nx_{m} &= \\frac{x_{1} + x_{2}}{2}\n\\end{aligned}\n$$\n\nSubstituting $x_1=3$ and $x_2=7$, we obtain\n\n$$\n\\begin{aligned}\nx_{m} &= \\frac{3 + 7}{2} \\\\\n&= \\frac{10}{2} \\\\\n&= 5\n\\end{aligned}\n$$\n\nTherefore, the midpoint $M$ corresponds to $x_m=5$.\n\n![](images/fc/fc0a47734756e12ec117db92d8f0273ae564c03ead88ce86eac82005be6feaf4.png)" :tutorial/id #uuid "7b14d3c0-0c84-55bc-be21-3359fbc5f6ec" :tutorial/math-academy-id 2347 :tutorial/title "The Midpoint Formula"} :step/id #uuid "f54758a4-a9bd-55d8-8fe5-726424159290" :step/math-academy-id 10013 :step/next {:db/id #edb/ref 17592186111720}} {:db/id #edb/ref 17592186111719 :step/content {:db/id #edb/ref 17592186111835 :tutorial/content "The **midpoint** of a line segment is the point that splits it into two segments of equal length. For example, $M$ is the midpoint of $\\overline{PQ}$ shown below.\n\n![](images/ed/ede582389ad936b02a6074a3fb6543e730ae955baf9784147f133f9492a35708.png)\n\nThe midpoint splits the line segment into two congruent segments,\n\n$$\n\\overline{PM}\\cong \\overline{QM}\n$$\n\nIn addition, the segment $\\overline{PQ}$ is twice as long as the segments $\\overline{PM}$ and $\\overline{QM}$:\n\n$$\nPQ = 2PM, \\qquad PQ = 2QM\n$$" :tutorial/id #uuid "9e476e67-9dd4-5098-be96-fc805e9e97f9" :tutorial/math-academy-id 2165 :tutorial/title "Introduction"} :step/id #uuid "fb8d8caf-a880-55f9-8ec4-027667c4d158" :step/math-academy-id 8710 :step/next {:db/id #edb/ref 17592186111721}} {:db/id #edb/ref 17592186111720 :step/content {:db/id #edb/ref 17592186110744 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110377 :question/id #uuid "f46e0c53-c110-5990-b3ea-5dd27991cdc9" :question/math-academy-id "e-2557"} :knowledge-point/id #uuid "1f6f3cc2-e0b5-5263-896d-53369438a2f8" :knowledge-point/questions [{:db/id #edb/ref 17592186111268} {:db/id #edb/ref 17592186111271}] :knowledge-point/title "Finding a Midpoint Using the Midpoint Formula"} :step/id #uuid "071ff184-b63f-5999-8a03-a464cb40e4a4" :step/math-academy-id 8711 :step/next {:db/id #edb/ref 17592186111723}} {:db/id #edb/ref 17592186111721 :step/content {:db/id #edb/ref 17592186110745 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110378 :question/id #uuid "7c337d65-54d7-5264-b750-1a7f7bcd07f4" :question/math-academy-id "e-2558"} :knowledge-point/id #uuid "fb88880e-8b94-5223-b3fb-a4d80e795a00" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048213}] :knowledge-point/questions [{:db/id #edb/ref 17592186111272} {:db/id #edb/ref 17592186111273}] :knowledge-point/title "Using Properties of Midpoints to Calculate an Unknown Value From a Diagram"} :step/id #uuid "b8ed3410-17c6-5b4e-801f-204a8559cabe" :step/math-academy-id 8712 :step/next {:db/id #edb/ref 17592186111722}} {:db/id #edb/ref 17592186111722 :step/content {:db/id #edb/ref 17592186110746 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110379 :question/id #uuid "6e321a78-087f-5962-a88c-e61bdc10de9f" :question/math-academy-id "e-2559"} :knowledge-point/id #uuid "c4a4cad5-d0b0-51cb-921f-31a96e8e5eda" :knowledge-point/questions [{:db/id #edb/ref 17592186111267} {:db/id #edb/ref 17592186111270}] :knowledge-point/title "Using Properties of Midpoints to Calculate an Unknown Value From a Description"} :step/id #uuid "143b8bf4-dc04-56fe-9f49-a538e4b75644" :step/math-academy-id 8713 :step/next {:db/id #edb/ref 17592186111427}} {:db/id #edb/ref 17592186111723 :step/content {:db/id #edb/ref 17592186110747 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110380 :question/id #uuid "c79d8054-b4f5-57e3-b816-5ac07ccfa90d" :question/math-academy-id "e-2560"} :knowledge-point/id #uuid "c451d750-c40f-5b3f-9cd2-9eec197809de" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048760}] :knowledge-point/questions [{:db/id #edb/ref 17592186111257} {:db/id #edb/ref 17592186111269}] :knowledge-point/title "Using the Midpoint Formula to Calculate an Endpoint"} :step/id #uuid "45c8bbe7-572c-5f45-8330-89214603ae4d" :step/math-academy-id 8714}] :activity/title "Midpoints" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110835}]}
