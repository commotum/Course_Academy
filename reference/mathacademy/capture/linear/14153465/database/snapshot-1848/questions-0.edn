#{[{:db/id #edb/ref 17592186073539 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073860 :knowledge-point/id #uuid "370fbba1-4dfe-5cd5-b9c5-62daea6159d1" :knowledge-point/title "Multiplying Two Proper Fractions"}] :question/id #uuid "d0b90477-8893-5115-b31b-8d6d26b1c29b" :question/math-academy-id "e-1886" :question/problem "Huck gave $\\dfrac{1}{3}$ of a bag of marbles to his friend Tom. If Tom gave $\\dfrac{6}{7}$ of his share to Jim, what fraction of the original bag did Jim receive?" :question/worked-solution "To find the fraction of the original bag Jim received, we need to multiply $\\dfrac{1}{3}$ by $\\dfrac{6}{7}.$  \n\nTo do that, we multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac{1}{3} \\times \\dfrac{6}{7} =  \\dfrac {1 \\times 6} {3 \\times 7} = \\dfrac{6}{21}\n$$\n\nWe can simplify this fraction by dividing the numerator and denominator by $3\\mathbin{:}$\n\n$$\n\\dfrac{6}{21} = \\dfrac{6 \\div 3}{21 \\div 3} = \\dfrac{2}{7}\n$$\n\nSo, Jim received $\\dfrac{2}{7}$ of the initial bag of marbles."}] [{:db/id #edb/ref 17592186073540 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073861 :knowledge-point/id #uuid "dda2934c-c5e6-50c3-b0c2-cb44becc1207" :knowledge-point/title "Multiplying an Improper Fraction by a Proper Fraction"}] :question/id #uuid "c744f1a9-09f6-5391-8b92-970b252dc51f" :question/math-academy-id "e-1887" :question/problem "Jacob drank $\\dfrac{1}{4}$ of the contents of a pitcher that had been filled with $\\dfrac{8}{3}$ cups of coffee. How many cups of coffee did Jacob drink?" :question/worked-solution "To find out the amount of coffee Jacob drank, we need to calculate $\\dfrac{1}{4} \\times \\dfrac{8}{3}.$\n\nTo do that, we multiply the numerators, and we multiply the denominators: \n\n$$\n\\dfrac{1}{4} \\times \\dfrac{8}{3} =  \\dfrac{1 \\times 8}{4 \\times 3} = \\dfrac{8}{12}\n$$\n\nNext, we simplify:\n\n$$\n\\dfrac{8}{12} = \\dfrac{8 \\div 4}{12\\div 4} =\\dfrac{2}{3}\n$$\n\nSo, Jacob drank $\\dfrac{2}{3}$ cups of coffee."}] [{:db/id #edb/ref 17592186074406 :knowledge-point/_questions [{:db/id #edb/ref 17592186073861 :knowledge-point/id #uuid "dda2934c-c5e6-50c3-b0c2-cb44becc1207" :knowledge-point/title "Multiplying an Improper Fraction by a Proper Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33c36c4c-c2ce-523f-9b14-7b4af4676f9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{14}\\,\\text{kg}" :db/id #edb/ref 17592186476318} {:answer/id #uuid "3b436c0d-9556-51bd-bdf6-8730dc465b64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{10}\\,\\text{kg}" :db/id #edb/ref 17592186476334} {:answer/id #uuid "a8c3ed93-1d54-5b5e-a940-a5fe7be33f78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{7}\\,\\text{kg}" :db/id #edb/ref 17592186476573} {:answer/id #uuid "ab78a61a-b57d-5f64-b410-4a316db01f0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{7}\\,\\text{kg}" :db/id #edb/ref 17592186476582} {:answer/id #uuid "af79ed0b-3b78-52b3-8901-84f81684b3d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{14}\\,\\text{kg}" :db/id #edb/ref 17592186476595}] :answer-field/correct {:answer/id #uuid "a8c3ed93-1d54-5b5e-a940-a5fe7be33f78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{7}\\,\\text{kg}" :db/id #edb/ref 17592186476573} :answer-field/id #uuid "b952146f-9a14-555e-b26e-559201d2b081" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186072674}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ee312891-b3b6-5105-9b24-7f66757ca24b" :question/math-academy-id "q-60123" :question/problem "A bag contained $\\frac{9}{7}\\,\\text{kg}$ of soil. Annie poured $\\frac{1}{3}$ of the bag into a pot. How many kilograms of soil did Annie pour into the pot?" :question/worked-solution "To find out the weight of soil that Annie poured, we need to calculate $\\frac{9}{7}\\times \\frac{1}{3}.$\n\nTo multiply the two numbers, we multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{9}{7}\\times \\frac{1}{3}=\\frac{9\\times 1}{7\\times 3}=\\frac{9}{21}\n$$\n\nNext, we simplify:\n\n$$\n\\frac{9}{21}=\\frac{9÷3}{21÷3}=\\frac{3}{7}\n$$\n\nSo, Annie poured $\\frac{3}{7}\\,\\text{kg}$ of soil into the pot."}] [{:db/id #edb/ref 17592186476946 :knowledge-point/_questions [{:db/id #edb/ref 17592186073860 :knowledge-point/id #uuid "370fbba1-4dfe-5cd5-b9c5-62daea6159d1" :knowledge-point/title "Multiplying Two Proper Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "228aff71-bc77-52ce-986c-9da4f2db821b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186476282} {:answer/id #uuid "2cb2f368-aa4e-5258-909a-4294527b637a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186476304} {:answer/id #uuid "3d79391f-315a-5c4d-b643-db933ba9c3a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186476337} {:answer/id #uuid "928a6c85-5d4b-5286-b68b-8cbe72a428d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186476517} {:answer/id #uuid "b2ad10eb-124b-5a7b-86a5-389b0a2190f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186476605}] :answer-field/correct {:answer/id #uuid "b2ad10eb-124b-5a7b-86a5-389b0a2190f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186476605} :answer-field/id #uuid "318b3543-a658-59b1-9c00-c5747ad07868" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476779}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b3b2fed7-4d5d-5db4-8fc9-4368b3d1f24f" :question/math-academy-id "q-60398" :question/problem "A school is holding a fundraiser and plans to use $\\frac{1}{2}$ of the money raised to build a new library. Of the funds for the library, $\\frac{1}{3}$ will be used to buy books. What fraction of the total money raised will be used to purchase books?" :question/worked-solution "To find out the fraction of the money raised that will go to buy books, we need to multiply $\\frac{1}{2}$ by $\\frac{1}{3}.$\n\nWe multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{1}{2}\\times \\frac{1}{3}=\\frac{1\\times 1}{2\\times 3}=\\frac{1}{6}\n$$\n\nSo,  $\\frac{1}{6}$ of the money raised will be used to buy books."}] [{:db/id #edb/ref 17592186074434 :knowledge-point/_questions [{:db/id #edb/ref 17592186073860 :knowledge-point/id #uuid "370fbba1-4dfe-5cd5-b9c5-62daea6159d1" :knowledge-point/title "Multiplying Two Proper Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a563f2a1-cedc-5306-bce5-905d4233cad4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186072843} {:answer/id #uuid "dd881f57-e83c-5356-b0ee-effccd91f2a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186072844} {:answer/id #uuid "e15aa68d-a8ef-5f2f-8eae-65937c1b721e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186072845} {:answer/id #uuid "30269dc4-f212-5398-b50b-f2559296eb8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{15}" :db/id #edb/ref 17592186072846} {:answer/id #uuid "551253ea-1c88-5277-9a82-c266d6e1f9e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186072847}] :answer-field/correct {:answer/id #uuid "551253ea-1c88-5277-9a82-c266d6e1f9e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186072847} :answer-field/id #uuid "692576f6-0aee-512d-a800-fb4e9293f81d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186072842}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "aaac4474-1c63-5b3a-9a13-1661753c1cf7" :question/math-academy-id "q-60406" :question/problem "In Mrs. Morgan's class, $\\frac{3}{5}$ of the students are girls, and $\\frac{1}{2}$ of the girls like to play soccer. What fraction of the students in the class are girls who like to play soccer?" :question/worked-solution "To find out the fraction of the students in the class who are girls that like to play soccer, we need to multiply $\\frac{3}{5}$ by $\\frac{1}{2}.$\n\nWe multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{3}{5}\\times \\frac{1}{2}=\\frac{3\\times 1}{5\\times 2}=\\frac{3}{10}\n$$\n\nSo, $\\frac{3}{10}$ of all students in the class are girls who like to play soccer."}] [{:db/id #edb/ref 17592186476930 :knowledge-point/_questions [{:db/id #edb/ref 17592186073861 :knowledge-point/id #uuid "dda2934c-c5e6-50c3-b0c2-cb44becc1207" :knowledge-point/title "Multiplying an Improper Fraction by a Proper Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06164859-0383-559e-b446-7c5d7a7d5149" :answer/type {:db/id #edb/ref 17592186045498 :db/ide