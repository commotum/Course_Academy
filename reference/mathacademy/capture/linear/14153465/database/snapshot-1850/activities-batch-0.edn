#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074839} :activity/id #uuid "185c1b45-a390-5c22-b590-018e3601445c" :activity/scope {:db/id #edb/ref 17592186048149 :topic/id #uuid "83751569-5ade-5e78-963c-fd9723bd2c91" :topic/math-academy-id 567} :activity/steps [{:db/id #edb/ref 17592186074839 :step/content {:db/id #edb/ref 17592186074958 :tutorial/content "Fraction multiplication occurs regularly in real-life situations.\n\nFor example, suppose that a bag contains ![](images/bc/bcc2ab102a29294d71449d99af1cf1a88aae88047223f829175086f7a6cd5e10.svg) of flour. If Nancy used ![](images/c0/c0db422914dd04be9adf05af649ec06419e80d8425cd0a85f6105cef7cc447b5.svg) of the bag to make a pie, how much flour did she use to make the pie?\n\nTo find out how much flour Nancy used, we need to multiply ![](images/16/1627bb3010ada55ed941966d38081f1a6c1394c07ca78b94585f8c97e4bbc138.svg) by ![](images/d9/d989525f1462386565e344f7e9a41d48cea1e85148f9f5aba25268f589a8bcbc.svg)\n\nTo multiply these two fractions, we multiply the numerators, and we multiply the denominators:\n![](images/58/58824e95f00448b5c7d509f0781a367506ccf37fa018f2a0ba373c74191f1bb6.svg)\n\nTherefore, Nancy used ![](images/fd/fd1a8efcb6ae625f2259a43e8ffeb93d486d409af6175b6e52380f4ccd488af7.svg) kilograms of flour." :tutorial/id #uuid "a638bc3c-9858-5cb6-a95b-ba0a356c4d1b" :tutorial/math-academy-id 1894 :tutorial/title "Introduction"} :step/id #uuid "486b0619-80b4-5d62-b72f-3e204fc95bd4" :step/math-academy-id 6506 :step/next {:db/id #edb/ref 17592186074840}} {:db/id #edb/ref 17592186074840 :step/content {:db/id #edb/ref 17592186073860 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073539 :question/id #uuid "d0b90477-8893-5115-b31b-8d6d26b1c29b" :question/math-academy-id "e-1886"} :knowledge-point/id #uuid "370fbba1-4dfe-5cd5-b9c5-62daea6159d1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049253}] :knowledge-point/questions [{:db/id #edb/ref 17592186074405} {:db/i