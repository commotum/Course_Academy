#{[{:activity/first-step {:db/id #edb/ref 17592186074839} :activity/id #uuid "185c1b45-a390-5c22-b590-018e3601445c" :activity/scope {:db/id #edb/ref 17592186048149 :topic/id #uuid "83751569-5ade-5e78-963c-fd9723bd2c91" :topic/math-academy-id 567} :activity/steps [{:db/id #edb/ref 17592186074839 :step/content {:db/id #edb/ref 17592186074958 :tutorial/content "Fraction multiplication occurs regularly in real-life situations.\n\nFor example, suppose that a bag contains\n\n$$\n\\dfrac{3}{5}\\,\\text{kg}\n$$\n\nof flour. If Nancy used\n\n$$\n\\dfrac{2}{5}\n$$\n\nof the bag to make a pie, how much flour did she use to make the pie?\n\nTo find out how much flour Nancy used, we need to multiply\n\n$$\n\\dfrac{3}{5}\n$$\n\nby\n\n$$\n\\dfrac{2}{5}\n$$\n\nTo multiply these two fractions, we multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac{3}{5} \\times \\dfrac{2}{5} = \\dfrac{3\\times 2}{5\\times 5} = \\dfrac{6}{25}\n$$\n\nTherefore, Nancy used\n\n$$\n\\dfrac{6}{25}\n$$\n\nkilograms of flour." :tutorial/id #uuid "a638bc3c-9858-5cb6-a95b-ba0a356c4d1b" :tutorial/math-academy-id 1894 :tutorial/title "Introduction"} :step/id #uuid "486b0619-80b4-5d62-b72f-3e204fc95bd4" :step/math-academy-id 6506 :step/next {:db/id #edb/ref 17592186074840}} {:db/id #edb/ref 17592186074840 :step/content {:db/id #edb/ref 17592186073860 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073539 :question/id #uuid "d0b90477-8893-5115-b31b-8d6d26b1c29b" :question/math-academy-id "e-1886"} :knowledge-point/id #uuid "370fbba1-4dfe-5cd5-b9c5-62daea6159d1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049253}] :knowledge-point/questions [{:db/id #edb/ref 17592186074405} {:db/id #edb/ref 17592186074434}] :knowledge-point/title "Multiplying Two Proper Fractions"} :step/id #uuid "92232684-edd5-5924-8534-99904945e3c3" :step/math-academy-id 6507 :step/next {:db/id #edb/ref 17592186074841}} {:db/id #edb/ref 17592186074841 :step/content {:db/id #edb/ref 17592186073861 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073540 :question/id #uuid "c744f1a9-09f6-5391-8b92-970b252dc51f" :question/math-academy-id "e-1887"} :knowledge-point/id #uuid "dda2934c-c5e6-50c3-b0c2-cb44becc1207" :knowledge-point/questions [{:db/id #edb/ref 17592186074406} {:db/id #edb/ref 17592186074439}] :knowledge-point/title "Multiplying an Improper Fraction by a Proper Fraction"} :step/id #uuid "a15fa8d5-6b70-5131-a1e1-f5e73da501e7" :step/math-academy-id 6508}] :activity/title "Multiplying Fractions: Word Problems" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073985}]}
