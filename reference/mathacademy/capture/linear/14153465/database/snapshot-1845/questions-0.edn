#{[{:db/id #edb/ref 17592186073539 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073860 :knowledge-point/id #uuid "370fbba1-4dfe-5cd5-b9c5-62daea6159d1" :knowledge-point/title "Multiplying Two Proper Fractions"}] :question/id #uuid "d0b90477-8893-5115-b31b-8d6d26b1c29b" :question/math-academy-id "e-1886" :question/problem "Huck gave $\\dfrac{1}{3}$ of a bag of marbles to his friend Tom. If Tom gave $\\dfrac{6}{7}$ of his share to Jim, what fraction of the original bag did Jim receive?" :question/worked-solution "To find the fraction of the original bag Jim received, we need to multiply\n\n$$\n\\dfrac{1}{3}\n$$\n\nby\n\n$$\n\\dfrac{6}{7}\n$$\n\nTo do that, we multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac{1}{3} \\times \\dfrac{6}{7} = \\dfrac {1 \\times 6} {3 \\times 7} = \\dfrac{6}{21}\n$$\n\nWe can simplify this fraction by dividing the numerator and denominator by $3$:\n\n$$\n\\dfrac{6}{21} = \\dfrac{6 \\div 3}{21 \\div 3} = \\dfrac{2}{7}\n$$\n\nSo, Jim received\n\n$$\n\\dfrac{2}{7}\n$$\n\nof the initial bag of marbles."}] [{:db/id #edb/ref 17592186073540 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073861 :knowledge-point/id #uuid "dda2934c-c5e6-50c3-b0c2-cb44becc1207" :knowledge-point/title "Multiplying an Improper Fraction by a Proper Fraction"}] :question/id #uuid "c744f1a9-09f6-5391-8b92-970b252dc51f" :question/math-academy-id "e-1887" :question/problem "Jacob drank $\\dfrac{1}{4}$ of the contents of a pitcher that had been filled with $\\dfrac{8}{3}$ cups of coffee. How many cups of coffee did Jacob drink?" :question/worked-solution "To find out the amount of coffee Jacob drank, we need to calculate\n\n$$\n\\dfrac{1}{4} \\times \\dfrac{8}{3}\n$$\n\nTo do that, we multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac{1}{4} \\times \\dfrac{8}{3} = \\dfrac{1 \\times 8}{4 \\times 3} = \\dfrac{8}{12}\n$$\n\nNext, we simplify:\n\n$$\n\\dfrac{8}{12} = \\dfrac{8 \\div 4}{12\\div 4} =\\dfrac{2}{3}\n$$\n\nSo, Jacob drank\n\n$$\n\\dfrac{2}{3}\n$$\n\ncups of coffee."}] [{:db/id #edb/ref 17592186074406 :knowledge-point/_questions [{:db/id #edb/ref 17592186073861 :knowledge-point/id #uuid "dda2934c-c5e6-50c3-b0c2-cb44becc1207" :knowledge-point/title "Multiplying an Improper Fraction by a Proper Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "977b381a-239e-521a-811b-b96a4ab617fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{14}kg" :db/id #edb/ref 17592186072675} {:answer/id #uuid "a2d18bce-2568-53a4-bb33-45555b37d15d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{7}kg" :db/id #edb/ref 17592186072676} {:answer/id #uuid "ca60a23b-abf3-5e90-9acc-48061befe850" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{7}kg" :db/id #edb/ref 17592186072677} {:answer/id #uuid "2113a1b1-6f39-5632-b0d6-5a8efe26f5ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{14}kg" :db/id #edb/ref 17592186072678} {:answer/id #uuid "78d69a41-7aeb-50e0-88cb-13a1038aedaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{10}kg" :db/id #edb/ref 17592186072679}] :answer-field/id #uuid "b952146f-9a14-555e-b26e-559201d2b081" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186072674}] :question/id #uuid "ee312891-b3b6-5105-9b24-7f66757ca24b" :question/math-academy-id "q-60123" :question/problem "A bag contained $\\frac{9}{7}kg$ of soil. Annie poured $\\frac{1}{3}$ of the bag into a pot. How many kilograms of soil did Annie pour into the pot?"}] [{:db/id #edb/ref 17592186074434 :knowledge-point/_questions [{:db/id #edb/ref 17592186073860 :knowledge-point/id #uuid "370fbba1-4dfe-5cd5-b9c5-62daea6159d1" :knowledge-point/titl