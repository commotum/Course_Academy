#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186116328} :activity/id #uuid "bb4f3e3c-1b3b-597d-81c2-00cb699ba234" :activity/scope {:db/id #edb/ref 17592186050955 :topic/id #uuid "754db256-ffbf-5395-b091-88cb18d8b674" :topic/math-academy-id 1682} :activity/steps [{:db/id #edb/ref 17592186116328 :step/content {:db/id #edb/ref 17592186116416 :tutorial/content "To plot the graph of $y=-2(3^x),$ we take the curve $y=2(3^x)$ and reflect it in the $x$-axis, as shown below:\n\n![](images/61/6130842f788070c7e97fe82698b701293af681a6aba3acfce0f4dde269cddbcf.png)\n\nThis transformation is called a **reflection in the $\\boldsymbol{x}$-axis**, and it occurs because the output $y$-values of the function $y=2(3^x)$ are made negative by the transformation.\n\nIf we combine vertical translations with reflection, we get a general form\n\n$$\ny = -a(b^x) + k.\n$$\n\nThis is the equation of a reflected exponential graph $y=-a(b^x)$ that is translated $k$ units up." :tutorial/id #uuid "73a5f011-6c32-5204-b086-8c7c7a7bdead" :tutorial/math-academy-id 14028 :tutorial/title "Introduction"} :step/id #uuid "02f695f9-d31f-5839-85d9-755f167276b9" :step/math-academy-id 516375 :step/next {:db/id #edb/ref 17592186116329}} {:db/id #edb/ref 17592186116329 :step/content {:db/id #edb/ref 17592186115368 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114952 :question/id #uuid "5e2f19a2-f9e3-59dd-83a9-90950b0a55a8" :question/math-academy-id "e-20883"} :knowledge-point/id #uuid "0f61a7c3-82e6-5f90-8a95-4a79078fd542" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049660}] :knowledge-point/questions [{:db/id #edb/ref 17592186115696} {:db/id #edb/ref 17592186115728} {:db/id #edb/ref 17592186299577} {:db/id #edb/ref 17592186299578} {:db/id #edb/ref 17592186299620} {:db/id #edb/ref 17592186299625} {:db/id #edb/ref 17592186390645} {:db/id #edb/ref 17592186390652} {:db/id #edb/ref 17592186390659}] :knowledge-point/title "Vertical Reflections of Expone