5896-baf1-928789c0b1d7" 13194139534136 17592186045417 true] [17592186411608 1080 "90\\,000" 13194139534136 17592186045417 true] [17592186411608 1082 #edb/ref 17592186045498 13194139534136 17592186045417 true] [17592186411608 1083 #uuid "8d2be5c6-2ea1-5fdd-a19b-1ca6e9db49af" 13194139534136 17592186045417 true] [17592186411609 1080 "80\\,000" 13194139534136 17592186045417 true] [17592186411609 1082 #edb/ref 17592186045498 13194139534136 17592186045417 true] [17592186411609 1083 #uuid "c2f0e3cc-f79a-5b7f-a8f4-e19e89af1d2d" 13194139534136 17592186045417 true] [17592186411610 1080 "\\frac{1}{2}" 13194139534136 17592186045417 true] [17592186411610 1082 #edb/ref 17592186045498 13194139534136 17592186045417 true] [17592186411610 1083 #uuid "e6d1b46f-e211-5172-be37-ae8796943205" 13194139534136 17592186045417 true] [17592186411611 1080 "None of the statements are true" 13194139534136 17592186045417 true] [17592186411611 1082 #edb/ref 17592186045499 13194139534136 17592186045417 true] [17592186411611 1083 #uuid "e7535899-b380-5240-8de6-34d4d073db6e" 13194139534136 17592186045417 true] [17592186411612 1075 #edb/ref 17592186411597 13194139534136 17592186045417 true] [17592186411612 1075 #edb/ref 17592186411601 13194139534136 17592186045417 true] [17592186411612 1075 #edb/ref 17592186411602 13194139534136 17592186045417 true] [17592186411612 1075 #edb/ref 17592186411603 13194139534136 17592186045417 true] [17592186411612 1075 #edb/ref 17592186411610 13194139534136 17592186045417 true] [17592186411612 1076 #edb/ref 17592186045493 13194139534136 17592186045417 true] [17592186411612 1077 "selection" 13194139534136 17592186045417 true] [17592186411612 1078 #edb/ref 17592186411601 13194139534136 17592186045417 true] [17592186411612 1079 #uuid "0e744f0f-1893-571c-a245-886e0be7796d" 13194139534136 17592186045417 true] [17592186411613 1075 #edb/ref 17592186411600 13194139534136 17592186045417 true] [17592186411613 1075 #edb/ref 17592186411604 13194139534136 17592186045417 true] [17592186411613 1075 #edb/ref 17592186411606 13194139534136 17592186045417 true] [17592186411613 1075 #edb/ref 17592186411607 13194139534136 17592186045417 true] [17592186411613 1075 #edb/ref 17592186411611 13194139534136 17592186045417 true] [17592186411613 1076 #edb/ref 17592186045493 13194139534136 17592186045417 true] [17592186411613 1077 "selection" 13194139534136 17592186045417 true] [17592186411613 1078 #edb/ref 17592186411604 13194139534136 17592186045417 true] [17592186411613 1079 #uuid "e46cc03c-be0d-5f3c-966b-7d8ddd1839d7" 13194139534136 17592186045417 true] [17592186411614 1075 #edb/ref 17592186411598 13194139534136 17592186045417 true] [17592186411614 1075 #edb/ref 17592186411599 13194139534136 17592186045417 true] [17592186411614 1075 #edb/ref 17592186411605 13194139534136 17592186045417 true] [17592186411614 1075 #edb/ref 17592186411608 13194139534136 17592186045417 true] [17592186411614 1075 #edb/ref 17592186411609 13194139534136 17592186045417 true] [17592186411614 1076 #edb/ref 17592186045493 13194139534136 17592186045417 true] [17592186411614 1077 "selection" 13194139534136 17592186045417 true] [17592186411614 1078 #edb/ref 17592186411609 13194139534136 17592186045417 true] [17592186411614 1079 #uuid "f22ac3a1-3b1b-5c02-9aac-e44227bf9c37" 13194139534136 17592186045417 true] [17592186411615 1068 #edb/ref 17592186411612 13194139534136 17592186045417 true] [17592186411615 1069 "q-135349" 13194139534136 17592186045417 true] [17592186411615 1070 #edb/ref 17592186045487 13194139534136 17592186045417 true] [17592186411615 1071 "$$\nP=[\\begin{aligned}0.1 & 0.4 & 0.5 \\\\ 0.6 & 0.1 & 0.3 \\\\ 0.3 & 0.5 & 0.2\\end{aligned}],\\,q=[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]\n$$\n\nGiven that $q$ is the steady-state vector of the stochastic matrix $P$ shown above, what is the value of $a+b-c?$" 13194139534136 17592186045417 true] [17592186411615 1072 #uuid "15361c81-aace-5a26-b7c5-2e82d38f451f" 13194139534136 17592186045417 true] [17592186411615 1074 "Recall that a steady-state vector of a stochastic matrix $P$ is a stochastic vector $q$ such that \n\n$$\n\\begin{aligned}Pq & =q \\\\ Pq-q & =0 \\\\ Pq-Iq & =0 \\\\ (P-I)q & =0.\\end{aligned}\n$$\n\nComputing $P-I,$ we get\n\n$$\nP-I=[\\begin{aligned}0.1 & 0.4 & 0.5 \\\\ 0.6 & 0.1 & 0.3 \\\\ 0.3 & 0.5 & 0.2\\end{aligned}]-[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-0.9 & 0.4 & 0.5 \\\\ 0.6 & -0.9 & 0.3 \\\\ 0.3 & 0.5 & -0.8\\end{aligned}].\n$$\n\nThe matrix equation $(P-I)q=0$ is equivalent to the system of linear equations with the augmented matrix $M,$ which we reduce to row echelon form using Gaussian elimination as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-0.9 & 0.4 & 0.5 & 0 \\\\ 0.6 & -0.9 & 0.3 & 0 \\\\ 0.3 & 0.5 & -0.8 & 0\\end{aligned}] &  & \\begin{aligned}{R}_{1}:=10{R}_{1} \\\\ {R}_{2}:=10{R}_{2} \\\\ {R}_{3}:=10{R}_{3}\\end{aligned} \\\\  & ∼[\\begin{aligned}-9 & 4 & 5 & 0 \\\\ 6 & -9 & 3 & 0 \\\\ 3 & 5 & -8 & 0\\end{aligned}] &  & \\begin{aligned}{R}_{3}↔{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}3 & 5 & -8 & 0 \\\\ 6 & -9 & 3 & 0 \\\\ -9 & 4 & 5 & 0\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}-2{R}_{1} \\\\ {R}_{3}:={R}_{3}+3{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}3 & 5 & -8 & 0 \\\\ 0 & -19 & 19 & 0 \\\\ 0 & 19 & -19 & 0\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}3 & 5 & -8 & 0 \\\\ 0 & -19 & 19 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has two pivot columns (the $1$st and $2$nd). Thus, ${x}_{3}$ is a free variable. From the second equation, we obtain \n\n$$\n{x}_{2}={x}_{3}.\n$$\n\n \nSubstituting this into the first equation, we obtain\n\n$$\n3{x}_{1}+5{x}_{3}-8{x}_{3}=0\\,⟹\\,{x}_{1}={x}_{3}.\n$$\n\nHence, the general solution is\n\n$$\n[\\begin{aligned}{x}_{3} \\\\ {x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in R.\n$$\n\nSince the steady-state vector must be stochastic, its entries should add up to $1.$ Therefore, we have \n\n$$\n\\begin{aligned}{x}_{3}+{x}_{3}+{x}_{3} & =1 \\\\ 3{x}_{3} & =1 \\\\ {x}_{3} & =\\frac{1}{3}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nq=[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]=[\\begin{aligned}\\frac{1}{3} \\\\ \\frac{1}{3} \\\\ \\frac{1}{3}\\end{aligned}].\n$$\n\nFinally, \n\n$$\na+b-c=\\frac{1}{3}+\\frac{1}{3}-\\frac{1}{3}=\\frac{1}{3}.\n$$" 13194139534136 17592186045417 true] [17592186411616 1068 #edb/ref 17592186411613 13194139534136 17592186045417 true] [17592186411616 1069 "q-135308" 13194139534136 17592186045417 true] [17592186411616 1070 #edb/ref 17592186045485 13194139534136 17592186045417 true] [17592186411616 1071 "$$\nP=[\\begin{aligned}0.3 & 0.8 \\\\ 0.7 & 0.2\\end{aligned}],\\,q=[\\begin{aligned}0.1 \\\\ 0.9\\end{aligned}]\n$$\n\nConsider the stochastic matrix $P$ and vector $q$ shown above. Which of the following statements are true?\n\n- $q$ is a stochastic vector\n- $Pq=q$\n- $q$ is a steady-state vector of $P$" 13194139534136 17592186045417 true] [17592186411616 1072 #uuid "62944003-1237-5928-b405-2159dbe448f0" 13194139534136 17592186045417 true] [17592186411616 1074 "Recall that a steady-state vector of a stochastic matrix $P$ is a stochastic vector $q$ such that $Pq=q.$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed, $q$ is a stochastic vector since its entries are non-negative and add up to $1.$\n\n- Statement II is false. Note that\n\n$$\nPq=[\\begin{aligned}0.3 & 0.8 \\\\ 0.7 & 0.2\\end{aligned}][\\begin{aligned}0.1 \\\\ 0.9\\end{aligned}]=[\\begin{aligned}0.03+0.72 \\\\ 0.07+0.18\\end{aligned}]=[\\begin{aligned}0.75 \\\\ 0.25\\end{aligned}]\\ne q.\n$$\n\n- Statement III is false. Since $Pq\\ne q,$ it is not a steady-state vector of $P.$\n\nTherefore, the correct answer is \"I only.\"" 13194139534136 17592186045417 true] [17592186411617 1068 #edb/ref 17592186411614 13194139534136 17592186045417 true] [17592186411617 1069 "q-135412" 13194139534136 17592186045417 true] [17592186411617 1070 #edb/ref 17592186045487 13194139534136 17592186045417 true] [17592186411617 1071 "A study determines how customers' yearly preferences change between the LB and SB telephone companies. The table below describes the results of this study.\n\n|  |  | From: |  |\n| --- | --- | --- | --- |\n|  |  | **LB** | **SB** |\n| To: | **LB** | $0$ | $0.25$ |\n| **SB** | $1$ | $0.75$ |  |\n\nIt's found that $100%$ of the customers who currently use the LB company will choose the SB company next year, while $25%$ of the customers who currently use the SB company will use the LB company next year.\n\nAssuming that there are $100\\,000$ customers in total and that the given probabilities remain constant over many years, determine the number of customers who will eventually use the SB company." 13194139534136 17592186045417 true] [17592186411617 1072 #uuid "fbc10db1-83ee-5f40-90d1-b581f73d6e92" 13194139534136 17592186045417 true] [17592186411617 1074 "From the table, we get the corresponding stochastic matrix \n\n$$\nP=[\\begin{aligned}0 & 0.25 \\\\ 1 & 0.75\\end{aligned}].\n$$\n\nNow, note that\n\n$$\n{P}^{2}=[\\begin{aligned}0.25 & 0.187\\,5 \\\\ 0.75 & 0.812\\,5\\end{aligned}].\n$$\n\nThe matrix ${P}^{2}$ contains only positive entries. So, the matrix $P$ is regular. As a result, after many years, the distribution will eventually converge to the unique steady-state vector of $P,$ and this convergence does not depend on the initial state.\n\nRecall that a steady-state vector of a stochastic matrix $P$ is a stochastic vector $q$ such that \n\n$$\n\\begin{aligned}Pq=q\\,⟹\\,(P-I)q=0.\\end{aligned}\n$$\n\nComputing $P-I,$ we get\n\n$$\nP-I=[\\begin{aligned}0 & 0.25 \\\\ 1 & 0.75\\end{aligned}]-[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-1 & 0.25 \\\\ 1 & -0.25\\end{aligned}].\n$$\n\nSo, the matrix equation $(P-I)q=0$ is equivalent to the system of linear equations with the augmented matrix $M,$ which we reduce to row echelon form using Gaussian elimination as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-1 & 0.25 & 0 \\\\ 1 & -0.25 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 0.25 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain \n\n$$\n\\begin{aligned}{x}_{1}=\\frac{1}{4}{x}_{2}.\\end{aligned}\n$$\n\nHence, the general solution is\n\n$$\n[\\begin{aligned}\\frac{1}{4}{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nSince the steady-state vector must be stochastic, its entries should add up to $1.$ Therefore, we have \n\n$$\n\\begin{aligned}\\frac{1}{4}{x}_{2}+{x}_{2} & =1 \\\\ \\frac{5}{4}{x}_{2} & =1 \\\\ {x}_{2} & =\\frac{4}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nq=[\\begin{aligned}\\frac{1}{5} \\\\ \\frac{4}{5}\\end{aligned}].\n$$\n\nSo, $\\frac{4}{5}$ of the customers will eventually use the SB company. Therefore, the number of customers who will eventually use this company is\n\n$$\n\\frac{4}{5}\\cdot 100\\,000=80\\,000.\n$$" 13194139534136 17592186045417 true] [17592186411618 1058 #edb/ref 17592186411619 13194139534136 17592186045417 true] [17592186411618 1062 #uuid "2f47d0d7-0048-532c-8ccd-1d7c100cde28" 13194139534136 17592186045417 true] [17592186411618 1063 #edb/ref 17592186411615 13194139534136 17592186045417 true] [17592186411619 1062 #uuid "a72fda11-1a51-5e4f-8796-9dbea4da037a" 13194139534136 17592186045417 true] [17592186411619 1063 #edb/ref 17592186411617 13194139534136 17592186045417 true] [17592186411620 1058 #edb/ref 17592186411618 13194139534136 17592186045417 true] [17592186411620 1062 #uuid "d2495fcf-fbe9-534c-8f3a-89d05a93dce9" 13194139534136 17592186045417 true] [17592186411620 1063 #edb/ref 17592186411616 13194139534136 17592186045417 true]] :edb/tempids {"activity-86878afe-0434-571a-8f3d-da4de43c4751" 17592186411596 "answer-09fa980f-8d16-5c0b-adc6-32aaa0351649"