s \\frac{5}{4} & =\\frac{36}{4}\\times \\frac{5}{5} \\\\  & =9\\times 1 \\\\  & =9\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n3\\,\\frac{1}{5}\\times 1\\,\\frac{1}{4}=9\n$$"}] [{:db/id #edb/ref 17592186435280 :knowledge-point/_questions [{:db/id #edb/ref 17592186142812 :knowledge-point/id #uuid "6340c1e2-bf12-5932-9632-df7b72f499d9" :knowledge-point/title "Expressing the Result as a Mixed Number (Solution Uses a Strategy)"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "493e33fe-8132-5e6e-a80d-d889face0c1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\frac{1}{3}" :db/id #edb/ref 17592186435209} {:answer/id #uuid "69f81008-bbbd-5404-8792-102c13979baf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\frac{2}{3}" :db/id #edb/ref 17592186435216} {:answer/id #uuid "a7eade49-cf6f-5581-a8c1-4db84eee6032" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\frac{1}{12}" :db/id #edb/ref 17592186435230} {:answer/id #uuid "bbddd75c-0fd7-5d60-ba41-85f01339646e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\frac{3}{4}" :db/id #edb/ref 17592186435235} {:answer/id #uuid "dccfb749-c2c2-5f72-ba15-0bad91762e27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\frac{1}{3}" :db/id #edb/ref 17592186435247}] :answer-field/correct {:answer/id #uuid "69f81008-bbbd-5404-8792-102c13979baf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\frac{2}{3}" :db/id #edb/ref 17592186435216} :answer-field/id #uuid "1fa134c3-ef7c-5663-befc-106c5023cf6f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435259}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3cce7163-7034-5329-8f1c-2dea6d81db92" :question/math-academy-id "q-137289" :question/problem "$5\\,\\frac{1}{3}\\times 1\\,\\frac{1}{4}=$" :question/worked-solution "First, we write $5\\,\\frac{1}{3}$ as an improper fraction:\n\n$$\n5\\,\\frac{1}{3}=\\frac{(5\\times 3)+1}{3}=\\frac{16}{3}\n$$\n\nWe also write  $1\\,\\frac{1}{4}$ as an improper fraction:\n\n$$\n1\\,\\frac{1}{4}=\\frac{(1\\times 4)+1}{4}=\\frac{5}{4}\n$$\n\nNow, we can multiply the two numbers. \n\n$$\n\\begin{aligned}\\frac{16}{3}\\times \\frac{5}{4}\\end{aligned}\n$$\n\nWe can simplify this product by swapping the denominators:\n\n$$\n\\begin{aligned}\\frac{16}{3}\\times \\frac{5}{4} & =\\frac{16}{4}\\times \\frac{5}{3} \\\\  & =4\\times \\frac{5}{3} \\\\  & =\\frac{20}{3}\\end{aligned}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{20}{3}=6\\,\\text{R}2=6\\,\\frac{2}{3}\n$$"}] [{:db/id #edb/ref 17592186435276 :knowledge-point/_questions [{:db/id #edb/ref 17592186142812 :knowledge-point/id #uuid "6340c1e2-bf12-5932-9632-df7b72f499d9" :knowledge-point/title "Expressing the Result as a Mixed Number (Solution Uses a Strategy)"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a9d135e-5c64-5722-a79d-9ab99644e1ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\frac{1}{14}" :db/id #edb/ref 17592186435198} {:answer/id #uuid "459aa01e-a1de-59c7-a22e-0c0af77cdc21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\frac{3}{14}" :db/id #edb/ref 17592186435207} {:answer/id #uuid "88bc2fa6-4af5-5fcf-a326-665e84ae8461" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\frac{1}{2}" :db/id #edb/ref 17592186435224} {:answer/id #uuid "9c889a63-ef4c-5a20-98b1-a165ccfce3be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\frac{2}{7}" :db/id #edb/ref 17592186435229} {:answer/id #uuid "f02f9f2b-912a-54fc-af54-7886155ad647" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\frac{3}{7}" :db/id #edb/ref 17592186435250}] :answer-field/correct {:answer/id #uuid "f02f9f2b-912a-54fc-af54-7886155ad647" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\frac{3}{7}" :db/id #edb/ref 17592186435250} :answer-field/id #uuid "3e54fa1d-e140-5aab-8b59-8cf0883aae64" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435263}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "14bd50e2-6db5-5d60-b6e7-3a96bb6d176e" :question/math-academy-id "q-137292" :question/problem "$1\\,\\frac{3}{7}\\times 4\\,\\frac{1}{2}=$" :question/worked-solution "First, we write $1\\,\\frac{3}{7}$ as an improper fraction:\n\n$$\n1\\,\\frac{3}{7}=\\frac{(1\\times 7)+3}{7}=\\frac{10}{7}\n$$\n\nWe also write  $4\\,\\frac{1}{2}$ as an improper fraction:\n\n$$\n4\\,\\frac{1}{2}=\\frac{(4\\times 2)+1}{2}=\\frac{9}{2}\n$$\n\nNow, we can multiply the two numbers. \n\n$$\n\\begin{aligned}\\frac{10}{7}\\times \\frac{9}{2}\\end{aligned}\n$$\n\nWe can simplify this product by swapping the denominators:\n\n$$\n\\begin{aligned}\\frac{10}{7}\\times \\frac{9}{2} & =\\frac{10}{2}\\times \\frac{9}{7} \\\\  & =5\\times \\frac{9}{7} \\\\  & =\\frac{45}{7}\\end{aligned}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{45}{7}=6\\,\\text{R}3=6\\,\\frac{3}{7}\n$$"}] [{:db/id #edb/ref 17592186143171 :knowledge-point/_questions [{:db/id #edb/ref 17592186142811 :knowledge-point/id #uuid "a0261453-d071-5dbf-8d63-39c77ab39c72" :knowledge-point/title "Expressing the Result as a Mixed Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2523a09a-e7f5-567d-a8df-e093f78e4214" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\frac{5}{6}" :db/id #edb/ref 17592186435201}] :answer-field/correct {:answer/id #uuid "2523a09a-e7f5-567d-a8df-e093f78e4214" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\frac{5}{6}" :db/id #edb/ref 17592186435201} :answer-field/id #uuid "f210ec43-c635-5084-a3ae-0f28eb902bdb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186140333}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f22f500c-8689-5ce5-a371-3cafba346f55" :question/math-academy-id "q-171727" :question/problem "Expressed as a mixed number in its lowest terms, $3\\,\\frac{1}{2}\\times 1\\,\\frac{2}{3}=${{field-1}}." :question/worked-solution "First, we write $3\\,\\frac{1}{2}$ as an improper fraction:\n\n$$\n3\\,\\frac{1}{2}=\\frac{(3\\times 2)+1}{2}=\\frac{7}{2}\n$$\n\nWe also write $1\\,\\frac{2}{3}$ as an improper fraction:\n\n$$\n1\\,\\frac{2}{3}=\\frac{(1\\times 3)+2}{3}=\\frac{5}{3}\n$$\n\nNow, we can multiply the two numbers. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{7}{2}\\times \\frac{5}{3}=\\frac{7\\times 5}{2\\times 3}=\\frac{35}{6}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{35}{6}=5\\,\\text{R}5=5\\,\\frac{5}{6}\n$$"}] [{:db/id #edb/ref 17592186435277 :knowledge-point/_questions [{:db/id #edb/ref 17592186142810 :knowledge-point/id #uuid "b8e4d9a7-afea-562f-b013-9c02fbaf3455" :knowledge-point/title "Cases When the Result is a Whole Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75a57edf-1403-56ce-8367-2182b85b33aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186435219}] :answer-field/correct {:answer/id #uuid "75a57edf-1403-56ce-8367-2182b85b33aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186435219} :answer-field/id #uuid "4f9f55b1-511f-5a61-b940-e0adb069a768" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186435265}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "177fabe4-7f4b-5692-9ebe-916f1e142f79" :question/math-academy-id "q-198177" :question/problem "Expressed in its simplest form, $2\\,\\frac{2}{3}\\times 10\\,\\frac{1}{2}=${{field-1}}." :question/worked-solution "First, we write $2\\,\\frac{2}{3}$ as an improper fraction:\n\n$$\n2\\,\\frac{2}{3}=\\frac{(2\\times 3)+2}{3}=\\frac{8}{3}\n$$\n\nWe also write $10\\,\\frac{1}{2}$ as an improper fraction:\n\n$$\n10\\,\\frac{1}{2}=\\frac{(10\\times 2)+1}{2}=\\frac{21}{2}\n$$\n\nNow, we can multiply the two numbers. \n\n$$\n\\begin{aligned}\\frac{8}{3}\\times \\frac{21}{2}\\end{aligned}\n$$\n\nWe can simplify this product by swapping the denominators:\n\n$$\n\\begin{aligned}\\frac{8}{3}\\times \\frac{21}{2} & =\\frac{8}{2}\\times \\frac{21}{3} \\\\  & =4\\times 7 \\\\  & =28\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n2\\,\\frac{2}{3}\\times 10\\,\\frac{1}{2}=28.\n$$"}] [{:db/id #edb/ref 17592186435285 :knowledge-point/_questions [{:db/id #edb/ref 17592186142810 :knowledge-point/id #uuid "b8e4d9a7-afea-562f-b013-9c02fbaf3455" :knowledge-point/title "Cases When the Result is a Whole Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb6e3a7c-f5bb-5c19-92bf-f2431792348f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186435254}] :answer-field/correct {:answer/id #uuid "fb6e3a7c-f5bb-5c19-92bf-f2431792348f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186435254} :answer-field/id #uuid "1f8dff40-29bb-5b9d-acf8-224b4e550daa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186435258}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "99bb9dc4-abe2-5180-ad2c-f6dd7e678c81" :question/math-academy-id "q-198182" :question/problem "Expressed in its simplest form, $2\\,\\frac{4}{7}\\times 1\\,\\frac{1}{6}=${{field-1}}." :question/worked-solution "First, we write $2\\,\\frac{4}{7}$ as an improper fraction:\n\n$$\n2\\,\\frac{4}{7}=\\frac{(2\\times 7)+4}{7}=\\frac{18}{7}\n$$\n\nWe also write $1\\,\\frac{1}{6}$ as an improper fraction:\n\n$$\n1\\,\\frac{1}{6}=\\frac{(1\\times 6)+1}{6}=\\frac{7}{6}\n$$\n\nNow, we can multiply the two numbers. \n\n$$\n\\begin{aligned}\\frac{18}{7}\\times \\frac{7}{6}\\end{aligned}\n$$\n\nWe can simplify this product by swapping the denominators:\n\n$$\n\\begin{aligned}\\frac{18}{7}\\times \\frac{7}{6} & =\\frac{18}{6}\\times \\frac{7}{7} \\\\  & =3\\times 1 \\\\  & =3\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n2\\,\\frac{4}{7}\\times 1\\,\\frac{1}{6}=3.\n$$"}] [{:db/id #edb/ref 17592186435291 :knowledge-point/_questions [{:db/id #edb/ref 17592186142811 :knowledge-point/id #uuid "a0261453-d071-5dbf-8d63-39c77ab39c72" :knowledge-point/title "Expressing the Result as a Mixed Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05569e1f-bb14-59ec-bcd6-2c606fb57af4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\frac{3}{10}" :db/id #edb/ref 17592186435196}] :answer-field/correct {:answer/id #uuid "05569e1f-bb14-59ec-bcd6-2c606fb57af4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\frac{3}{10}" :db/id #edb/ref 17592186435196} :answer-field/id #uuid "44b622e8-8b2c-52e1-8ba7-84c1ac7b004a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186435264}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f0192ebd-c39a-5e07-8c9d-bdc0f4e15605" :question/math-academy-id "q-198185" :question/problem "Expressed as a mixed number in its lowest terms, $1\\,\\frac{4}{5}\\times 3\\,\\frac{1}{2}=${{field-1}}." :question/worked-solution "First, we write $1\\,\\frac{4}{5}$ as an improper fraction:\n\n$$\n1\\,\\frac{4}{5}=\\frac{(1\\times 5)+4}{5}=\\frac{9}{5}\n$$\n\nWe also write $3\\,\\frac{1}{2}$ as an improper fraction:\n\n$$\n3\\,\\frac{1}{2}=\\frac{(3\\times 2)+1}{2}=\\frac{7}{2}\n$$\n\nNow, we can multiply the two numbers. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{9}{5}\\times \\frac{7}{2}=\\frac{9\\times 7}{5\\times 2}=\\frac{63}{10}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{63}{10}=6\\,\\text{R}3=6\\,\\frac{3}{10}\n$$"}] [{:db/id #edb/ref 17592186435284 :knowledge-point/_questions [{:db/id #edb/ref 17592186142811 :knowledge-point/id #uuid "a0261453-d071-5dbf-8d63-39c77ab39c72" :knowledge-point/title "Expressing the Result as a Mixed Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c48234c1-1260-532e-bdfa-059510e4ad00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\frac{5}{12}" :db/id #edb/ref 17592186435238}] :answer-field/correct {:answer/id #uuid "c48234c1-1260-532e-bdfa-059510e4ad00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\frac{5}{12}" :db/id #edb/ref 17592186435238} :answer-field/id #uuid "b1207484-95c9-5d02-ae7f-441dd04d07cf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186435270}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "948afd53-5fc4-5fae-b3e0-fa8392f07e57" :question/math-academy-id "q-198187" :question/problem "Expressed as a mixed number in its lowest terms, $2\\,\\frac{1}{3}\\times 2\\,\\frac{3}{4}=${{field-1}}." :question/worked-solution "First, we write $2\\,\\frac{1}{3}$ as an improper fraction:\n\n$$\n2\\,\\frac{1}{3}=\\frac{(2\\times 3)+1}{3}=\\frac{7}{3}\n$$\n\nWe also write $2\\,\\frac{3}{4}$ as an improper fraction:\n\n$$\n2\\,\\frac{3}{4}=\\frac{(2\\times 4)+3}{4}=\\frac{11}{4}\n$$\n\nNow, we can multiply the two numbers. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{7}{3}\\times \\frac{11}{4}=\\frac{7\\times 11}{3\\times 4}=\\frac{77}{12}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{77}{12}=6\\,\\text{R}5=6\\,\\frac{5}{12}\n$$"}] [{:db/id #edb/ref 17592186435282 :knowledge-point/_questions [{:db/id #edb/ref 17592186142811 :knowledge-point/id #uuid "a0261453-d071-5dbf-8d63-39c77ab39c72" :knowledge-point/title "Expressing the Result as a Mixed Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82e978ac-629a-535a-b92b-2d6464a352b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\frac{3}{8}" :db/id #edb/ref 17592186435223}] :answer-field/correct {:answer/id #uuid "82e978ac-629a-535a-b92b-2d6464a352b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\frac{3}{8}" :db/id #edb/ref 17592186435223} :answer-field/id #uuid "7a4f7c8e-7896-599a-8432-048b6a739afd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186435269}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8325b264-7339-533f-b5e7-72d4a3741a6e" :question/math-academy-id "q-198194" :question/problem "Expressed as a mixed number in its lowest terms, $1\\,\\frac{3}{4}\\times 2\\,\\frac{1}{2}=${{field-1}}." :question/worked-solution "First, we write $1\\,\\frac{3}{4}$ as an improper fraction:\n\n$$\n1\\,\\frac{3}{4}=\\frac{(1\\times 4)+3}{4}=\\frac{7}{4}\n$$\n\nWe also write $2\\,\\frac{1}{2}$ as an improper fraction:\n\n$$\n2\\,\\frac{1}{2}=\\frac{(2\\times 2)+1}{2}=\\frac{5}{2}\n$$\n\nNow, we can multiply the two numbers. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{7}{4}\\times \\frac{5}{2}=\\frac{7\\times 5}{4\\times 2}=\\frac{35}{8}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{35}{8}=4\\,\\text{R}3=4\\,\\frac{3}{8}\n$$"}] [{:db/id #edb/ref 17592186435275 :knowledge-point/_questions [{:db/id #edb/ref 17592186142812 :knowledge-point/id #uuid "6340c1e2-bf12-5932-9632-df7b72f499d9" :knowledge-point/title "Expressing the Result as a Mixed Number (Solution Uses a Strategy)"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc0066eb-ad74-5db0-b589-13ee53cb00f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,\\frac{1}{3}" :db/id #edb/ref 17592186435245}] :answer-field/correct {:answer/id #uuid "dc0066eb-ad74-5db0-b589-13ee53cb00f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,\\frac{1}{3}" :db/id #edb/ref 17592186435245} :answer-field/id #uuid "17775011-3f3e-521f-8d9a-fb94375479ac" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186435257}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "107d23c7-53ab-5ba0-9a97-cca159b8c473" :question/math-academy-id "q-198201" :question/problem "Expressed as a mixed number in its lowest terms, $1\\,\\frac{1}{7}\\times 1\\,\\frac{1}{6}=${{field-1}}." :question/worked-solution "First, we write $1\\,\\frac{1}{7}$ as an improper fraction:\n\n$$\n1\\,\\frac{1}{7}=\\frac{(1\\times 7)+1}{7}=\\frac{8}{7}\n$$\n\nWe also write $1\\,\\frac{1}{6}$ as an improper fraction:\n\n$$\n1\\,\\frac{1}{6}=\\frac{(1\\times 6)+1}{6}=\\frac{7}{6}\n$$\n\nNow, we can multiply the two numbers. \n\n$$\n\\begin{aligned}\\frac{8}{7}\\times \\frac{7}{6}\\end{aligned}\n$$\n\nWe can simplify this product by swapping the denominators:\n\n$$\n\\begin{aligned}\\frac{8}{7}\\times \\frac{7}{6} & =\\frac{8}{6}\\times \\frac{7}{7} \\\\  & =\\frac{8}{6}\\times 1 \\\\  & =\\frac{8}{6}\\end{aligned}\n$$\n\nNext, we write this fraction in its lowest terms:\n\n$$\n\\frac{8}{6}=\\frac{8÷2}{6÷2}=\\frac{4}{3}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{4}{3}=1\\,\\text{R}3=1\\,\\frac{1}{3}\n$$"}] [{:db/id #edb/ref 17592186435290 :knowledge-point/_questions [{:db/id #edb/ref 17592186142812 :knowledge-point/id #uuid "6340c1e2-bf12-5932-9632-df7b72f499d9" :knowledge-point/title "Expressing the Result as a Mixed Number (Solution Uses a Strategy)"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc08969f-5bd9-5e72-8e89-90da8262c843" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\frac{2}{5}" :db/id #edb/ref 17592186435246}] :answer-field/correct {:answer/id #uuid "dc08969f-5bd9-5e72-8e89-90da8262c843" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\frac{2}{5}" :db/id #edb/ref 17592186435246} :answer-field/id #uuid "6fe5cfd0-b156-5874-806b-3a0a226019f9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186435267}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2626f9e-5300-5e18-a1f2-581c7a661b16" :question/math-academy-id "q-198214" :question/problem "Expressed as a mixed number in its lowest terms, $3\\,\\frac{3}{5}\\times 2\\,\\frac{1}{3}=${{field-1}}." :question/worked-solution "First, we write $3\\,\\frac{3}{5}$ as an improper fraction:\n\n$$\n3\\,\\frac{3}{5}=\\frac{(3\\times 5)+3}{5}=\\frac{18}{5}\n$$\n\nWe also write $2\\,\\frac{1}{3}$ as an improper fraction:\n\n$$\n2\\,\\frac{1}{3}=\\frac{(2\\times 3)+1}{3}=\\frac{7}{3}\n$$\n\nNow, we can multiply the two numbers. \n\n$$\n\\begin{aligned}\\frac{18}{5}\\times \\frac{7}{3}\\end{aligned}\n$$\n\nWe can simplify this product by swapping the denominators:\n\n$$\n\\begin{aligned}\\frac{18}{5}\\times \\frac{7}{3} & =\\frac{18}{3}\\times \\frac{7}{5} \\\\  & =6\\times \\frac{7}{5} \\\\  & =\\frac{42}{5}\\end{aligned}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{42}{5}=8\\,\\text{R}2=8\\,\\frac{2}{5}\n$$"}] [{:db/id #edb/ref 17592186435288 :knowledge-point/_questions [{:db/id #edb/ref 17592186142809 :knowledge-point/id #uuid "f481bacc-75b7-525d-8784-9e5138117597" :knowledge-point/title "Expressing the Result as an Improper Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4439ba27-ef63-593e-8a22-d9a840edb673" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186435206} {:answer/id #uuid "51ca6f24-fd38-5631-a70f-1fed4a5df934" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186435211} {:answer/id #uuid "7a915a0f-513b-5fc9-a71f-e578f2edf1f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186435222} {:answer/id #uuid "afa464f5-b1c4-5dc3-a1d9-d0e30709123f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186435234} {:answer/id #uuid "fafdf436-ad85-5cc9-9732-253546e28802" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186435253}] :answer-field/correct {:answer/id #uuid "51ca6f24-fd38-5631-a70f-1fed4a5df934" :