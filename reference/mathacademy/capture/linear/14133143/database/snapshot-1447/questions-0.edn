:\n\n$$\n\\frac{45}{8}=5\\,\\text{R}5=5\\,\\frac{5}{8}\n$$"}] [{:db/id #edb/ref 17592186435283 :knowledge-point/_questions [{:db/id #edb/ref 17592186142812 :knowledge-point/id #uuid "6340c1e2-bf12-5932-9632-df7b72f499d9" :knowledge-point/title "Expressing the Result as a Mixed Number (Solution Uses a Strategy)"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00f80a56-583d-5f51-8b67-5d5f81a6737c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\frac{3}{4}" :db/id #edb/ref 17592186435194} {:answer/id #uuid "8a87e5d3-099b-54d6-a874-fe3ce664ebb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\frac{3}{4}" :db/id #edb/ref 17592186435225} {:answer/id #uuid "90b0eefc-85ce-5d28-bdee-d86ecf473d19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\frac{1}{6}" :db/id #edb/ref 17592186435228} {:answer/id #uuid "ae06a46e-dae9-560e-a353-62ee5dbbdc1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\frac{1}{4}" :db/id #edb/ref 17592186435233} {:answer/id #uuid "d93976bd-1341-5ca9-8e28-f6b509d84f4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\frac{1}{4}" :db/id #edb/ref 17592186435244}] :answer-field/correct {:answer/id #uuid "00f80a56-583d-5f51-8b67-5d5f81a6737c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\frac{3}{4}" :db/id #edb/ref 17592186435194} :answer-field/id #uuid "cc7d59a3-fc09-5b10-beb2-e8114f4a5f9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435271}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "867d7685-55ae-5d57-a541-e247084d254e" :question/math-academy-id "q-57157" :question/problem "$1\\,\\frac{2}{3}\\times 2\\,\\frac{1}{4}=$" :question/worked-solution "First, we write $1\\,\\frac{2}{3}$ as an improper fraction:\n\n$$\n1\\,\\frac{2}{3}=\\frac{(1\\times 3)+2}{3}=\\frac{5}{3}\n$$\n\nWe also write  $2\\,\\frac{1}{4}$ as an improper fraction:\n\n$$\n2\\,\\frac{1}{4}=\\frac{(2\\times 4)+1}{4}=\\frac{9}{4}\n$$\n\nNow, we can multiply the two numbers. \n\n$$\n\\begin{aligned}\\frac{5}{3}\\times \\frac{9}{4}\\end{aligned}\n$$\n\nWe can simplify this product by swapping the denominators:\n\n$$\n\\begin{aligned}\\frac{5}{3}\\times \\frac{9}{4} & =\\frac{5}{4}\\times \\frac{9}{3} \\\\  & =\\frac{5}{4}\\times 3 \\\\  & =\\frac{15}{4}\\end{aligned}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{15}{4}=3\\,\\text{R}3=3\\,\\frac{3}{4}\n$$"}] [{:db/id #edb/ref 17592186435289 :knowledge-point/_questions [{:db/id #edb/ref 17592186142810 :knowledge-point/id #uuid "b8e4d9a7-afea-562f-b013-9c02fbaf3455" :knowledge-point/title "Cases When the Result is a Whole Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b9f058e-bde4-5c76-98aa-e12c4dfb7ab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\frac{1}{6}" :db/id #edb/ref 17592186435199} {:answer/id #uuid "343d9fa0-d0dc-5888-82f2-ab43d28fdd7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\frac{1}{12}" :db/id #edb/ref 17592186435203} {:answer/id #uuid "abf65c6f-6db6-56dc-a2a2-97186384813e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186435231} {:answer/id #uuid "bd4df367-4978-5d14-ac23-c32088561e81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186435236} {:answer/id #uuid "e4073846-35f4-5f17-8172-0c4fe6721753" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186435249}] :ans