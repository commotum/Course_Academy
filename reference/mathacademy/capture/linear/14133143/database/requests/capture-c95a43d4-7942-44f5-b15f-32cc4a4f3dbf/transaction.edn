adb069a768"] :db/ensure [:question/validate]} {:db/id "answer-field-4f9f55b1-511f-5a61-b940-e0adb069a768" :answer-field/id #uuid "4f9f55b1-511f-5a61-b940-e0adb069a768" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-75a57edf-1403-56ce-8367-2182b85b33aa" :answer-field/choices ["answer-75a57edf-1403-56ce-8367-2182b85b33aa"] :db/ensure [:answer-field/validate]} {:db/id "answer-75a57edf-1403-56ce-8367-2182b85b33aa" :answer/id #uuid "75a57edf-1403-56ce-8367-2182b85b33aa" :answer/type :answer.type/math :answer/value "28" :db/ensure [:answer/validate]} {:db/id "question-8325b264-7339-533f-b5e7-72d4a3741a6e" :question/id #uuid "8325b264-7339-533f-b5e7-72d4a3741a6e" :question/math-academy-id "q-198194" :question/problem "Expressed as a mixed number in its lowest terms, $1\\,\\frac{3}{4}\\times 2\\,\\frac{1}{2}=${{field-1}}." :question/worked-solution "First, we write $1\\,\\frac{3}{4}$ as an improper fraction:\n\n$$\n1\\,\\frac{3}{4}=\\frac{(1\\times 4)+3}{4}=\\frac{7}{4}\n$$\n\nWe also write $2\\,\\frac{1}{2}$ as an improper fraction:\n\n$$\n2\\,\\frac{1}{2}=\\frac{(2\\times 2)+1}{2}=\\frac{5}{2}\n$$\n\nNow, we can multiply the two numbers. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{7}{4}\\times \\frac{5}{2}=\\frac{7\\times 5}{4\\times 2}=\\frac{35}{8}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{35}{8}=4\\,\\text{R}3=4\\,\\frac{3}{8}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7a4f7c8e-7896-599a-8432-048b6a739afd"] :db/ensure [:question/validate]} {:db/id "answer-field-7a4f7c8e-7896-599a-8432-048b6a739afd" :answer-field/id #uuid "7a4f7c8e-7896-599a-8432-048b6a739afd" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-82e978ac-629a-535a-b92b-2d6464a352b2" :answer-field/choices ["answer-82e978ac-629a-535a-b92b-2d6464a352b2"] :db/ensure [:answer-field/validate]} {:db/id "answer-82e978ac-629a-535a-b92b-2d6464a352b2" :answer/id #uuid "82e978ac-629a-535a-b92b-2d6464a352b2" :answer/type :answer.type/math :answer/value "4\\,\\frac{3}{8}" :db/ensure [:answer/validate]} {:db/id "question-948afd53-5fc4-5fae-b3e0-fa8392f07e57" :question/id #uuid "948afd53-5fc4-5fae-b3e0-fa8392f07e57" :question/math-academy-id "q-198187" :question/problem "Expressed as a mixed number in its lowest terms, $2\\,\\frac{1}{3}\\times 2\\,\\frac{3}{4}=${{field-1}}." :question/worked-solution "First, we write $2\\,\\frac{1}{3}$ as an improper fraction:\n\n$$\n2\\,\\frac{1}{3}=\\frac{(2\\times 3)+1}{3}=\\frac{7}{3}\n$$\n\nWe also write $2\\,\\frac{3}{4}$ as an improper fraction:\n\n$$\n2\\,\\frac{3}{4}=\\frac{(2\\times 4)+3}{4}=\\frac{11}{4}\n$$\n\nNow, we can multiply the two numbers. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{7}{3}\\times \\frac{11}{4}=\\frac{7\\times 11}{3\\times 4}=\\frac{77}{12}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{77}{12}=6\\,\\text{R}5=6\\,\\frac{5}{12}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b1207484-95c9-5d02-ae7f-441dd04d07cf"] :db/ensure [:question/validate]} {:db/id "answer-field-b1207484-95c9-5d02-ae7f-441dd04d07cf" :answer-field/id #uuid "b1207484-95c9-5d02-ae7f-441dd04d07cf" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c48234c1-1260-532e-bdfa-059510e4ad00" :answer-field/choices ["answer-c48234c1-1260-532e-bdfa-059510e4ad00"] :db/ensure [:answer-field/validate]} {:db/id "answer-c48234c1-1260-532e-bdfa-059510e4ad00" :answer/id #uuid "c48234c1-1260-532e-bdfa-059510e4ad00" :answer/type :answer.type/math :answer/value "6\\frac{5}{12}" :db/ensure [:answer/validate]} {:db/id "question-f0192ebd-c39a-5e07-8c9d-bdc0f4e15605" :question/id #uuid "f0192ebd-c39a-5e07-8c9d-bdc0f4e15605" :question/math-academy-id "q-198185" :question/problem "Expressed as a mixed number in its lowest terms, $1\\,\\frac{4}{5}\\times 3\\,\\frac{1}{2}=${{field-1}}." :question/worked-solution "First, we write $1\\,\\frac{4}{5}$ as an improper fraction:\n\n$$\n1\\,\\frac{4}{5}=\\frac{(1\\times 5)+4}{5}=\\frac{9}{5}\n$$\n\nWe also write $3\\,\\frac{1}{2}$ as an improper fraction:\n\n$$\n3\\,\\frac{1}{2}=\\frac{(3\\times 2)+1}{2}=\\frac{7}{2}\n$$\n\nNow, we can multiply the two numbers. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{9}{5}\\times \\frac{7}{2}=\\frac{9\\times 7}{5\\times 2}=\\frac{63}{10}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{63}{10}=6\\,\\text{R}3=6\\,\\frac{3}{10}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-44b622e8-8b2c-52e1-8ba7-84c1ac7b004a"] :db/ensure [:question/validate]} {:db/id "answer-field-44b622e8-8b2c-52e1-8ba7-84c1ac7b004a" :answer-field/id #uuid "44b622e8-8b2c-52e1-8ba7-84c1ac7b004a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-05569e1f-bb14-59ec-bcd6-2c606fb57af4" :answer-field/choices ["answer-05569e1f-bb14-59ec-bcd6-2c606fb57af4"] :db/ensure [:answer-field/validate]} {:db/id "answer-05569e1f-bb14-59ec-bcd6-2c606fb57af4" :answer/id #uuid "05569e1f-bb14-59ec-bcd6-2c606fb57af4" :answer/type :answer.type/math :answer/value "6\\,\\frac{3}{10}" :db/ensure [:answer/validate]} {:db/id "question-c3d8799e-4d03-502b-a27c-a344247e81c1" :question/id #uuid "c3d8799e-4d03-502b-a27c-a344247e81c1" :question/math-academy-id "q-57150" :question/problem "$4\\,\\frac{1}{2}\\times 1\\,\\frac{1}{4}=$" :question/worked-solution "First, we write $4\\,\\frac{1}{2}$ as an improper fraction:\n\n$$\n4\\,\\frac{1}{2}=\\frac{(4\\times 2)+1}{2}=\\frac{9}{2}\n$$\n\nWe also write  $1\\,\\frac{1}{4}$ as an improper fraction:\n\n$$\n1\\,\\frac{1}{4}=\\frac{(1\\times 4)+1}{4}=\\frac{5}{4}\n$$\n\nNow, we can multiply the two numbers. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{9}{2}\\times \\frac{5}{4}=\\frac{9\\times 5}{2\\times 4}=\\frac{45}{8}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{45}{8}=5\\,\\text{R}5=5\\,\\frac{5}{8}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-710936f1-0572-55d1-ac08-44c59f1e0864"] :db/ensure [:question/validate]} {:db/id "answer-field-710936f1-0572-55d1-ac08-44c59f1e0864" :answer-field/id #uuid "710936f1-0572-55d1-ac08-44c59f1e0864" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-21c2f6e7-3aff-57fe-a4d2-3eefcd7c598a" :answer-field/choices ["answer-f052de27-b71a-535d-a261-ae71615d2330" "answer-6b2ea106-5612-5dde-a0d9-2d009daf40be" "answer-068eb114-5476-50bd-9c1a-03c412307058" "answer-21c2f6e7-3aff-57fe-a4d2-3eefcd7c598a" "answer-902ac2fe-02fc-51fe-9fb2-ea72db3ee889"] :db/ensure [:answer-field/validate]} {:db/id "answer-f052de27-b71a-535d-a261-ae71615d2330" :answer/id #uuid "f052de27-b71a-535d-a261-ae71615d2330" :answer/type :answer.type/math :answer/value "4\\,\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "answer-6b2ea106-5612-5dde-a0d9-2d009daf40be" :answer/id #uuid "6b2ea106-5612-5dde-a0d9-2d009daf40be" :answer/type :answer.type/math :answer/value "4\\,\\frac{5}{8}" :db/ensure [:answer/validate]} {:db/id "answer-068eb114-5476-50bd-9c1a-03c412307058" :answer/id #uuid "068eb114-5476-50bd-9c1a-03c412307058" :answer/type :answer.type/math :answer/value "5\\,\\frac{3}{8}" :db/ensure [:answer/validate]} {:db/id "answer-21c2f6e7-3aff-57fe-a4d2-3eefcd7c598a" :answer/id #uuid "21c2f6e7-3aff-57fe-a4d2-3eefcd7c598a" :answer/type :answer.type/math :answer/value "5\\,\\frac{5}{8}" :db/ensure [:answer/validate]} {:db/id "answer-902ac2fe-02fc-51fe-9fb2-ea72db3ee889" :answer/id #uuid "902ac2fe-02fc-51fe-9fb2-ea72db3ee889" :answer/type :answer.type/math :answer/value "5\\,\\frac{7}{8}" :db/ensure [:answer/validate]} {:db/id 17592186143171 :question/problem "Expressed as a mixed number in its lowest terms, $3\\,\\frac{1}{2}\\times 1\\,\\frac{2}{3}=${{field-1}}." :question/worked-solution "First, we write $3\\,\\frac{1}{2}$ as an improper fraction:\n\n$$\n3\\,\\frac{1}{2}=\\frac{(3\\times 2)+1}{2}=\\frac{7}{2}\n$$\n\nWe also write $1\\,\\frac{2}{3}$ as an improper fraction:\n\n$$\n1\\,\\frac{2}{3}=\\frac{(1\\times 3)+2}{3}=\\frac{5}{3}\n$$\n\nNow, we can multiply the two numbers. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{7}{2}\\times \\frac{5}{3}=\\frac{7\\times 5}{2\\times 3}=\\frac{35}{6}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{35}{6}=5\\,\\text{R}5=5\\,\\frac{5}{6}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186140333 :answer-field/correct "answer-2523a09a-e7f5-567d-a8df-e093f78e4214" :answer-field/choices ["answer-2523a09a-e7f5-567d-a8df-e093f78e4214"] :db/ensure [:answer-field/validate]} {:db/id "answer-2523a09a-e7f5-567d-a8df-e093f78e4214" :answer/id #uuid "2523a09a-e7f5-567d-a8df-e093f78e4214" :answer/type :answer.type/math :answer/value "5\\frac{5}{6}" :db/ensure [:answer/validate]} {:db/id "question-d2626f9e-5300-5e18-a1f2-581c7a661b16" :question/id #uuid "d2626f9e-5300-5e18-a1f2-581c7a661b16" :question/math-academy-id "q-198214" :question/problem "Expressed as a mixed number in its lowest terms, $3\\,\\frac{3}{5}\\times 2\\,\\frac{1}{3}=${{field-1}}." :question/worked-solution "First, we write $3\\,\\frac{3}{5}$ as an improper fraction:\n\n$$\n3\\,\\frac{3}{5}=\\frac{(3\\times 5)+3}{5}=\\frac{18}{5}\n$$\n\nWe also write $2\\,\\frac{1}{3}$ as an improper fraction:\n\n$$\n2\\,\\frac{1}{3}=\\frac{(2\\times 3)+1}{3}=\\frac{7}{3}\n$$\n\nNow, we can multiply the two numbers. \n\n$$\n\\begin{aligned}\\frac{18}{5}\\times \\frac{7}{3}\\end{aligned}\n$$\n\nWe can simplify this product by swapping the denominators:\n\n$$\n\\begin{aligned}\\frac{18}{5}\\times \\frac{7}{3} & =\\frac{18}{3}\\times \\frac{7}{5} \\\\  & =6\\times \\frac{7}{5} \\\\  & =\\frac{42}{5}\\end{aligned}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{42}{5}=8\\,\\text{R}2=8\\,\\frac{2}{5}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6fe5cfd0-b156-5874-806b-3a0a226019f9"] :db/ensure [:question/validate]} {:db/id "answer-field-6fe5cfd0-b156-5874-806b-3a0a226019f9" :answer-field/id #uuid "6fe5cfd0-b156-5874-806b-3a0a226019f9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-dc08969f-5bd9-5e72-8e89-90da8262c843" :answer-field/choices ["answer-dc08969f-5bd9-5e72-8e89-90da8262c843"] :db/ensure [:answer-field/validate]} {:db/id "answer-dc08969f-5bd9-5e72-8e89-90da8262c843" :answer/id #uuid "dc08969f-5bd9-5e72-8e89-90da8262c843" :answer/type :answer.type/math :answer/value "8\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "question-107d23c7-53ab-5ba0-9a97-cca159b8c473" :question/id #uuid "107d23c7-53ab-5ba0-9a97-cca159b8c473" :question/math-academy-id "q-198201" :question/problem "Expressed as a mixed number in its lowest terms, $1\\,\\frac{1}{7}\\times 1\\,\\frac{1}{6}=${{field-1}}." :question/worked-solution "First, we write $1\\,\\frac{1}{7}$ as an improper fraction:\n\n$$\n1\\,\\frac{1}{7}=\\frac{(1\\times 7)+1}{7}=\\frac{8}{7}\n$$\n\nWe also write $1\\,\\frac{1}{6}$ as an improper fraction:\n\n$$\n1\\,\\frac{1}{6}=\\frac{(1\\times 6)+1}{6}=\\frac{7}{6}\n$$\n\nNow, we can multiply the two numbers. \n\n$$\n\\begin{aligned}\\frac{8}{7}\\times \\frac{7}{6}\\end{aligned}\n$$\n\nWe can simplify this product by swapping the denominators:\n\n$$\n\\begin{aligned}\\frac{8}{7}\\times \\frac{7}{6} & =\\frac{8}{6}\\times \\frac{7}{7} \\\\  & =\\frac{8}{6}\\times 1 \\\\  & =\\frac{8}{6}\\end{aligned}\n$$\n\nNext, we write this fraction in its lowest terms:\n\n$$\n\\frac{8}{6}=\\frac{8÷2}{6÷2}=\\frac{4}{3}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{4}{3}=1\\,\\text{R}3=1\\,\\frac{1}{3}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-17775011-3f3e-521f-8d9a-fb94375479ac"] :db/ensure [:question/validate]} {:db/id "answer-field-17775011-3f3e-521f-8d9a-fb94375479ac" :answer-field/id #uuid "17775011-3f3e-521f-8d9a-fb94375479ac" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-dc0066eb-ad74-5db0-b589-13ee53cb00f8" :answer-field/choices ["answer-dc0066eb-ad74-5db0-b589-13ee53cb00f8"] :db/ensure [:answer-field/validate]} {:db/id "answer-dc0066eb-ad74-5db0-b589-13ee53cb00f8" :answer/id #uuid "dc0066eb-ad74-5db0-b589-13ee53cb00f8" :answer/type :answer.type/math :answer/value "1\\,\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "question-3cce7163-7034-5329-8f1c-2dea6d81db92" :question/id #uuid "3cce7163-7034-5329-8f1c-2dea6d81db92" :question/math-academy-id "q-137289" :question/problem "$5\\,\\frac{1}{3}\\times 1\\,\\frac{1}{4}=$" :question/worked-solution "First, we write $5\\,\\frac{1}{3}$ as an improper fraction:\n\n$$\n5\\,\\frac{1}{3}=\\frac{(5\\times 3)+1}{3}=\\frac{16}{3}\n$$\n\nWe also write  $1\\,\\frac{1}{4}$ as an improper fraction:\n\n$$\n1\\,\\frac{1}{4}=\\frac{(1\\times 4)+1}{4}=\\frac{5}{4}\n$$\n\nNow, we can multiply the two numbers. \n\n$$\n\\begin{aligned}\\frac{16}{3}\\times \\frac{5}{4}\\end{aligned}\n$$\n\nWe can simplify this product by swapping the denominators:\n\n$$\n\\begin{aligned}\\frac{16}{3}\\times \\frac{5}{4} & =\\frac{16}{4}\\times \\frac{5}{3} \\\\  & =4\\times \\frac{5}{3} \\\\  & =\\frac{20}{3}\\end{aligned}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{20}{3}=6\\,\\text{R}2=6\\,\\frac{2}{3}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1fa134c3-ef7c-5663-befc-106c5023cf6f"] :db/ensure [:question/va