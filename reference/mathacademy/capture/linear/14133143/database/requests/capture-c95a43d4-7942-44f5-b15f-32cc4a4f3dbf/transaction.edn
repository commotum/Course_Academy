5}{4}\n$$\n\nNow, we can multiply the two numbers. \n\n$$\n\\begin{aligned}\\frac{36}{5}\\times \\frac{5}{4}\\end{aligned}\n$$\n\nWe can simplify this product by swapping the denominators:\n\n$$\n\\begin{aligned}\\frac{36}{5}\\times \\frac{5}{4} & =\\frac{36}{4}\\times \\frac{5}{5} \\\\  & =9\\times 1 \\\\  & =9\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n3\\,\\frac{1}{5}\\times 1\\,\\frac{1}{4}=9\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e2d4bf16-d35e-55e9-a2ba-60cf7bdce8a2"] :db/ensure [:question/validate]} {:db/id "answer-field-e2d4bf16-d35e-55e9-a2ba-60cf7bdce8a2" :answer-field/id #uuid "e2d4bf16-d35e-55e9-a2ba-60cf7bdce8a2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d284d19d-8d2e-50c4-aea4-39e99879235d" :answer-field/choices ["answer-6b0ddc94-a16d-566e-8de9-99bebcebe46b" "answer-64c05297-03e7-5846-8304-55833e212f2d" "answer-353d8aae-d050-5b9d-b826-d034d0303eff" "answer-f3b9b635-57a9-5b43-bf1f-060db24958f8" "answer-d284d19d-8d2e-50c4-aea4-39e99879235d"] :db/ensure [:answer-field/validate]} {:db/id "answer-6b0ddc94-a16d-566e-8de9-99bebcebe46b" :answer/id #uuid "6b0ddc94-a16d-566e-8de9-99bebcebe46b" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "answer-64c05297-03e7-5846-8304-55833e212f2d" :answer/id #uuid "64c05297-03e7-5846-8304-55833e212f2d" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-353d8aae-d050-5b9d-b826-d034d0303eff" :answer/id #uuid "353d8aae-d050-5b9d-b826-d034d0303eff" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-f3b9b635-57a9-5b43-bf1f-060db24958f8" :answer/id #uuid "f3b9b635-57a9-5b43-bf1f-060db24958f8" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-d284d19d-8d2e-50c4-aea4-39e99879235d" :answer/id #uuid "d284d19d-8d2e-50c4-aea4-39e99879235d" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-99bb9dc4-abe2-5180-ad2c-f6dd7e678c81" :question/id #uuid "99bb9dc4-abe2-5180-ad2c-f6dd7e678c81" :question/math-academy-id "q-198182" :question/problem "Expressed in its simplest form, $2\\,\\frac{4}{7}\\times 1\\,\\frac{1}{6}=${{field-1}}." :question/worked-solution "First, we write $2\\,\\frac{4}{7}$ as an improper fraction:\n\n$$\n2\\,\\frac{4}{7}=\\frac{(2\\times 7)+4}{7}=\\frac{18}{7}\n$$\n\nWe also write $1\\,\\frac{1}{6}$ as an improper fraction:\n\n$$\n1\\,\\frac{1}{6}=\\frac{(1\\times 6)+1}{6}=\\frac{7}{6}\n$$\n\nNow, we can multiply the two numbers. \n\n$$\n\\begin{aligned}\\frac{18}{7}\\times \\frac{7}{6}\\end{aligned}\n$$\n\nWe can simplify this product by swapping the denominators:\n\n$$\n\\begin{aligned}\\frac{18}{7}\\times \\frac{7}{6} & =\\frac{18}{6}\\times \\frac{7}{7} \\\\  & =3\\times 1 \\\\  & =3\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n2\\,\\frac{4}{7}\\times 1\\,\\frac{1}{6}=3.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1f8dff40-29bb-5b9d-acf8-224b4e550daa"] :db/ensure [:question/validate]} {:db/id "answer-field-1f8dff40-29bb-5b9d-acf8-224b4e550daa" :answer-field/id #uuid "1f8dff40-29bb-5b9d-acf8-224b4e550daa" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-fb6e3a7c-f5bb-5c19-92bf-f2431792348f" :answer-field/choices ["answer-fb6e3a7c-f5bb-5c19-92bf-f2431792348f"] :db/ensure [:answer-field/validate]} {:db/id "answer-fb6e3a7c-f5bb-5c19-92bf-f2431792348f" :answer/id #uuid "fb6e3a7c-f5bb-5c19-92bf-f2431792348f" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-1c726818-6cc1-5342-8e08-a605c7092b6e" :question/id #uuid "1c726818-6cc1-5342-8e08-a605c7092b6e" :question/math-academy-id "q-137146" :question/problem "$3\\,\\frac{3}{4}\\times 2\\,\\frac{2}{5}=$" :question/worked-solution "First, we write $3\\,\\frac{3}{4}$ as an improper fraction:\n\n$$\n3\\,\\frac{3}{4}=\\frac{(3\\times 4)+3}{4}=\\frac{15}{4}\n$$\n\nWe also write  $2\\,\\frac{2}{5}$ as an improper fraction:\n\n$$\n2\\,\\frac{2}{5}=\\frac{(2\\times 5)+2}{5}=\\frac{12}{5}\n$$\n\nNow, we can multiply the two numbers. \n\n$$\n\\begin{aligned}\\frac{15}{4}\\times \\frac{12}{5}\\end{aligned}\n$$\n\nWe can simplify this product by swapping the denominators:\n\n$$\n\\begin{aligned}\\frac{15}{4}\\times \\frac{12}{5} & =\\frac{15}{5}\\times \\frac{12}{4} \\\\  & =3\\times 3 \\\\  & =9\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n3\\,\\frac{3}{4}\\times 2\\,\\frac{2}{5}=9\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f16b5701-2fae-5a87-8153-42638ff76182"] :db/ensure [:question/validate]} {:db/id "answer-field-f16b5701-2fae-5a87-8153-42638ff76182" :answer-field/id #uuid "f16b5701-2fae-5a87-8153-42638ff76182" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7a09ee43-95ff-5a6c-a6b4-510e5dfabeb1" :answer-field/choices ["answer-5d828a2b-19e5-58d0-9513-5b414f39f910" "answer-ccf292a9-6cc8-53e8-a055-98c268e28607" "answer-2f9fb057-e80a-5f05-8d78-fa3d6f958bc0" "answer-c864b619-b2c2-5a7d-8c96-fced42f904a5" "answer-7a09ee43-95ff-5a6c-a6b4-510e5dfabeb1"] :db/ensure [:answer-field/validate]} {:db/id "answer-5d828a2b-19e5-58d0-9513-5b414f39f910" :answer/id #uuid "5d828a2b-19e5-58d0-9513-5b414f39f910" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-ccf292a9-6cc8-53e8-a055-98c268e28607" :answer/id #uuid "ccf292a9-6cc8-53e8-a055-98c268e28607" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-2f9fb057-e80a-5f05-8d78-fa3d6f958bc0" :answer/id #uuid "2f9fb057-e80a-5f05-8d78-fa3d6f958bc0" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-c864b619-b2c2-5a7d-8c96-fced42f904