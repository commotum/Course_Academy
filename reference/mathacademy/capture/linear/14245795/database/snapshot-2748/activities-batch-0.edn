#{[{:activity/expected-seconds 900.0 :activity/first-step {:db/id #edb/ref 17592186065149} :activity/id #uuid "633bad62-882e-5d8a-8c9d-aa13b14ea6e1" :activity/scope {:db/id #edb/ref 17592186050572 :topic/id #uuid "54b8c8a0-5bff-5a9f-9ca1-b046c38a20d9" :topic/math-academy-id 336} :activity/steps [{:db/id #edb/ref 17592186065149 :step/content {:db/id #edb/ref 17592186065362 :tutorial/content "Consider a curve ![](images/44/44c838deb3fa8e3182fbd9d4a03f964dc2731730559d00328190e9259bf01762.svg) between two points ![](images/3e/3e2237237edc778a26679551fc079de01fa2f06e33c1b0d0ff10dcecfd652dd4.svg) and ![](images/7d/7d4a3afa2b4b35de29b1645ebd729dfba3c3788ea2a6b926766e63e74beda2be.svg) The **average rate of change** of ![](images/44/44c838deb3fa8e3182fbd9d4a03f964dc2731730559d00328190e9259bf01762.svg) on the interval ![](images/8e/8efa43e7c8129d56297418824f9aebeef655e3f4c9cb65e7bf4c0a11f9d19208.svg) is computed as follows:\n\n![](images/51/5140837a34b6942abdc884a0d386209085034eb33c1f5d45517851c83d7d2517.svg)\n\nGeometrically, the average rate of change represents the slope of the **secant line** which passes through ![](images/5b/5b153647416113d95b1b6813579e099ad6b074369406be0f29bd2be28c9b5090.svg) and ![](images/1d/1dee6af8b808414a323d63634c2b5cf071792c7797a9bd60d7dc9d40f6b457bc.svg)\n\n![](images/e9/e9f4b7534020d6f78efc8375da02e347aca305fafee09ed0186d32866f12c058.png)\n\n**Note:** In general, a secant is a line that intersects a curve at two or more distinct points." :tutorial/id #uuid "4e32384d-35c4-578e-b254-9cf90914529e" :tutorial/math-academy-id 312 :tutorial/title "Introduction"} :step/id #uuid "59d271e2-f80e-5c14-bfff-c684c31322e1" :step/math-academy-id 206314 :step/next {:db/id #edb/ref 17592186065150}} {:db/id #edb/ref 17592186065150 :step/content {:db/id #edb/ref 17592186064267 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063929 :question/id #uuid "ac676612-cbb2-5057-a515-501e03414b5a" :question/math-academy-id "e-118"} :knowledge-point/id #uuid "68