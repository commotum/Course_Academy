#{[{:db/id #edb/ref 17592186563733 :knowledge-point/_questions [{:db/id #edb/ref 17592186064268 :knowledge-point/id #uuid "1f7224e3-9c13-51e7-a3f7-0e379f63a861" :knowledge-point/title "Calculating the Average Rate of Change Given a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a593d74-32d6-5a69-a98b-ba5cb32852de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-3" :db/id #edb/ref 17592186562960} {:answer/id #uuid "230851de-2e37-58e2-83a6-08333ab1a503" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-1" :db/id #edb/ref 17592186563023} {:answer/id #uuid "8afbee44-783e-5d4e-ae7f-0733ea8987a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-\\frac{4}{3}" :db/id #edb/ref 17592186563256} {:answer/id #uuid "97893439-7f84-5b6b-8ef2-2103da171047" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-2" :db/id #edb/ref 17592186563286} {:answer/id #uuid "c477754f-139c-565b-8756-f6505de16c44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-\\frac{3}{2}" :db/id #edb/ref 17592186563375}] :answer-field/correct {:answer/id #uuid "c477754f-139c-565b-8756-f6505de16c44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-\\frac{3}{2}" :db/id #edb/ref 17592186563375} :answer-field/id #uuid "ffb11692-b94a-52a8-a712-f1575499549c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563643}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c6acc05f-c544-5e0c-918b-0d7218132aa6" :question/math-academy-id "q-101729" :question/problem "The table below lists values of $f(x)$ at distinct $x$-values. Knowing that the average rate of change of the function $f(x)$ on the interval $[3p,5]$ is $-2,$ find the value of $p.$ \n\n| $x$ | $\\,-10\\,$ | $\\,-7\\,$ | $\\,3p\\,$ | $\\,-2\\,$ | $\\,0\\,$ | $\\,1\\,$ | $\\,5\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\,12\\,$ | $\\,8\\,$ | $\\,11\\,$ | $\\,-2\\,$ | $\\,3\\,$ | $\\,-16\\,$ | $\\,-8\\,$ |" :question/worked-solution "Using the formula for the average rate of change, we get\n\n$$\n\\begin{aligned}\\frac{Δf}{Δx} & =\\frac{f(b)-f(a)}{b-a} \\\\  & =\\frac{f(5)-f(3p)}{5-3p} \\\\  & =\\frac{-8-11}{5-3p} \\\\  & =\\frac{-19}{5-3p}.\\end{aligned}\n$$\n\nNow, we know that $\\frac{Δf}{Δx}=-2$ on the interval $[3p,5].$ Thus, \n\n$$\n\\frac{-19}{5-3p}=-2.\n$$\n\nSolving for $p,$ we have\n\n$$\n\\begin{aligned}\\frac{-19}{5-3p} & =-2 \\\\ -19 & =-2\\cdot (5-3p) \\\\ -19 & =-10+6p \\\\ -19+10 & =6p \\\\ -9 & =6p \\\\ \\frac{-9}{6} & =\\frac{6p}{6} \\\\ -\\frac{3}{2} & =p.\\end{aligned}\n$$\n\nTherefore, we conclude that $p=-\\frac{3}{2}.$"}] [{:db/id #edb/ref 17592186233625 :knowledge-point/_questions [{:db/id #edb/ref 17592186064269 :knowledge-point/id #uuid "8d13310c-2b80-5945-ada3-31d886f1ec48" :knowledge-point/title "Calculating the Average Rate of Change: Word Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17e422ba-8bfb-58cd-bf84-f724e2f172f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$187$ machines per day" :db/id #edb/ref 17592186562999} {:answer/id #uuid "5ec21c0f-0f70-5b8e-9e69-fb68559678cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$78$ machines per day" :db/id #edb/ref 17592186563162} {:answer/id #uuid "6514c1a1-a69c-5ca8-a457-e3ad929c428c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$18$ machines" :db/id #edb/ref 17592186563177} {:answer/id #uuid "6b6ad1a5-6c93-5a76-8a86-f908df99ff88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$178$ machines per day" :db/id #edb/ref 17592186563192} {:answer/id #uuid "cf0102f2-90a7-5523-b0f0-1c458c420558" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1309$ machines per day" :db/id #edb/ref 17592186563400}] :answer-field/correct {:answer/id #uuid "17e422ba-8bfb-58cd-bf84-f724e2f172f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$187$ machines per day" :db/id #edb/ref 17592186562999} :answer-field/id #uuid "3a53d094-3bb9-54ec-b5aa-7a1952045146" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563555}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "102f480c-0b70-562a-8bb4-30ec6a97cacd" :question/math-academy-id "q-21123" :question/problem "The number of machines infected by a computer virus is represented by the function $f(t)=4{t}^{3}-2{t}^{2}+5t+11,$ where $t$ is the time, in days, since the virus was first detected. What is the average rate of growth of $f(t)$ over the first week?" :question/worked-solution "Let $f(t)=4{t}^{3}-2{t}^{2}+5t+11$ be the number of machines infected by the computer virus after $t$ days. To find the average rate of growth of $f(t)$ over the first week, we use the average rate of change formula on the interval $[0,7]$:\n\n$$\n\\begin{aligned}\\frac{Δf}{Δt} & =\\frac{f(b)-f(a)}{b-a} \\\\  & =\\frac{f(7)-f(0)}{7-0} \\\\  & =\\frac{[4(7)^{3}-2(7)^{2}+5(7)+11]-[4(0)^{3}-2(0)^{2}+5(0)+11]}{7} \\\\  & =\\frac{1309}{7} \\\\  & =187\\end{aligned}\n$$\n\nTherefore, the average rate of growth over the first week is $187$ machines per day."}] [{:db/id #edb/ref 17592186234251 :knowledge-point/_questions [{:db/id #edb/ref 17592186064270 :knowledge-point/id #uuid "051b5337-7671-599f-a7f3-c3fb064575cc" :knowledge-point/title "Determining the Interval Over Which the Average Rate of Change is Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07499a9c-8e67-54b9-9395-d93c708bbcef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-1,9]" :db/id #edb/ref 17592186562953} {:answer/id #uuid "239ed64f-b9a3-58e8-a207-a68375ffaf55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-1,6]" :db/id #edb/ref 17592186563024} {:answer/id #uuid "7bdb203c-403b-5c7a-9b7e-0846cc37c78e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-3,0]" :db/id #edb/ref 17592186563216} {:answer/id #uuid "a18f517d-5d7a-5713-a2a7-49bee54b80b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[0,6]" :db/id #edb/ref 17592186563310} {:answer/id #uuid "f1de2945-364c-50aa-8988-3364d0eee183" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-1,4]" :db/id #edb/ref 17592186563486}] :answer-field/correct {:answer/id #uuid "07499a9c-8e67-54b9-9395-d93c708bbcef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-1,9]" :db/id #edb/ref 17592186562953} :answer-field/id #uuid "43e0c3a2-ebf4-5117-acb5-14db58f53c00" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563559}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9defd366-8d4b-5775-94e7-9eeab1aed32c" :question/math-academy-id "q-69674" :question/problem "Find an interval where the average rate of change of $f(x)$ equals $0$ given the following table of values of $f(x):$\n\n| $x$ | $\\,-3\\,$ | $\\,-1\\,$ | $\\,0\\,$ | $\\,2\\,$ | $\\,4\\,$ | $\\,6\\,$ | $\\,9\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\,7\\,$ | $\\,-4\\,$ | $\\,3\\,$ | $\\,-4\\,$ | $\\,1\\,$ | $\\,5\\,$ | $\\,-4\\,$ |" :question/worked-solution "We have $\\frac{Δf}{Δx}=0$ if and only if $Δf=0.$ So\n\n$$\n\\begin{aligned} & Δf=0 \\\\  & f(b)-f(a)=0 \\\\  & f(b)=f(a).\\end{aligned}\n$$\n\nThis means we have to find an interval  $[a,b]$ such that $f(a)=f(b).$\n\nSince $f(-1)=f(9)=-4,$ we conclude that $\\frac{Δf}{Δx}=0$ on the interval $[-1,9].$"}]}
