60} {:db/id #edb/ref 17592186527985}] :knowledge-point/title "Calculating the Average Rate of Change: Word Problem"} :step/id #uuid "295e95a9-3a8e-541c-bdff-bd462fa18b86" :step/math-academy-id 206321 :step/next {:db/id #edb/ref 17592186065153}} {:db/id #edb/ref 17592186065153 :step/content {:db/id #edb/ref 17592186064270 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063932 :question/id #uuid "50e4be08-7e9b-501b-beae-686aa62e96f3" :question/math-academy-id "e-122"} :knowledge-point/id #uuid "051b5337-7671-599f-a7f3-c3fb064575cc" :knowledge-point/questions [{:db/id #edb/ref 17592186064523} {:db/id #edb/ref 17592186064524} {:db/id #edb/ref 17592186234250} {:db/id #edb/ref 17592186234251} {:db/id #edb/ref 17592186527984} {:db/id #edb/ref 17592186527986} {:db/id #edb/ref 17592186544791} {:db/id #edb/ref 17592186544878}] :knowledge-point/title "Determining the Interval Over Which the Average Rate of Change is Zero"} :step/id #uuid "343ddc12-c579-5e1b-8c2d-a42ac8017653" :step/math-academy-id 206324}] :activity/title "The Average Rate of Change of a Function" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064427}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186544927} :activity/id #uuid "9952931b-e374-52ae-a9be-1856f7ea1fba" :activity/scope {:db/id #edb/ref 17592186050572 :topic/id #uuid "54b8c8a0-5bff-5a9f-9ca1-b046c38a20d9" :topic/math-academy-id 336} :activity/steps [{:db/id #edb/ref 17592186544927 :step/content {:db/id #edb/ref 17592186233607 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28b5cb1b-dea4-5ec8-a35c-ed97039896c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=4" :db/id #edb/ref 17592186544180} {:answer/id #uuid "3c355d34-03ba-5d2c-ac1d-9badc14ea417" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=-3" :db/id #edb/ref 17592186544219} {:answer/id #uuid "43c782ab-6da0-58e5-a099-7617877f63a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=5" :db/id #edb/ref 17592186544237} {:answer/id #uuid "6aeb6aec-eb5d-5da0-b2f5-087cac2791ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=-4" :db/id #edb/ref 17592186544320} {:answer/id #uuid "a399bb42-dc31-5744-8a45-e72b876140d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=3" :db/id #edb/ref 17592186544439}] :answer-field/correct {:db/id #edb/ref 17592186544320} :answer-field/id #uuid "67165400-b201-50fa-810c-4b96154a1200" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544699}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4a992d9e-9907-5bc8-acbd-8d0cb970eb93" :question/math-academy-id "q-19160" :question/problem "Consider the following table of values for $f(x).$ Knowing that the average rate of change of the function $f(x)$ on the interval $[-2,3]$ is $3,$ find the value of $p.$ \n\n| $x$ | $\\,-5\\,$ | $\\,-2\\,$ | $\\,0\\,$ | $\\,1\\,$ | $\\,3\\,$ | $\\,5\\,$ | $\\,7\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\,-11\\,$ | $\\,2p-1\\,$ | $\\,-5\\,$ | $\\,4\\,$ | $\\,p+10\\,$ | $\\,7\\,$ | $\\,8\\,$ |" :question/worked-solution "Using the formula for the average rate of change, we get\n\n$$\n\\begin{aligned}\\frac{Δf}{Δx} & =\\frac{f(b)-f(a)}{b-a} \\\\  & =\\frac{f(3)-f(-2)}{3-(-2)} \\\\  & =\\frac{(p+10)-(2p-1)}{3+2} \\\\  & =\\frac{11-p}{5}.\\end{aligned}\n$$\n\nNow, we know that $\\frac{Δf}{Δx}=3$ on the interval $[-2,3].$ Thus, \n\n$$\n\\frac{11-p}{5}=3.\n$$\n\nSolving for $p,$ we have\n\n$$\n\\begin{aligned}\\frac{11-p}{5} & =3 \\\\ 11-p & =15 \\\\ -p & =15-11 \\\\ -p & =4 \\\\ p & =-4.\\end{aligned}\n$$"} :step/id #uuid "52db5357-a58c-5010-8c13-0de7f7895700" :step/next {:db/id #edb/ref 17592186544952}} {:db/id #edb/ref 17592186544952 :step/content {:db/id #edb/ref 17592186544878 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e6ccc69-9f1d-5d1e-a310-05f931d5a099" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There is no such interval" :db/id #edb/ref 17592186544116} {:answer/id #uuid "3d567c88-9f2a-5e56-9977-53ab3e3387aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[4,12]" :db/id #edb/ref 17592186544225} {:answer/id #uuid "43721b7e-538b-5957-8de2-c684dfdc9889" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[6,8]" :db/id #edb/ref 17592186544236} {:answer/id #uuid "6b167927-7e47-5183-89f2-11a8741c549b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[2,10]" :db/id #edb/ref 17592186544322} {:answer/id #uuid "d783a813-ce2c-5f34-b477-df1d5c70b89e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[8,14]" :db/id #edb/ref 17592186544550}] :answer-field/correct {:db/id #edb/ref 17592186544550} :answer-field/id #uuid "b8f59edb-d323-5390-82ef-191a6129749f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544742}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c86d9a3a-c5bd-5503-9489-53c383f2b865" :question/math-academy-id "q-101731" :question/problem "Find an interval where the average rate of change of $f(x)$ equals $0$ given the following table of values of $f(x):$\n\n| $x$ | $\\,2\\,$ | $\\,4\\,$ | $\\,6\\,$ | $\\,8\\,$ | $\\,10\\,$ | $\\,12\\,$ | $\\,14\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\,4\\,$ | $\\,-3\\,$ | $\\,2\\,$ | $\\,6\\,$ | $\\,-4\\,$ | $\\,1\\,$ | $\\,6\\,$ |" :question/worked-solution "We have $\\frac{Δf}{Δx}=0$ if and only if $Δf=0.$ So\n\n$$\n\\begin{aligned} & Δf=0 \\\\  & f(b)-f(a)=0 \\\\  & f(b)=f(a).\\end{aligned}\n$$\n\nThis means we have to find an interval  $[a,b]$ such that $f(a)=f(b).$\n\nSince $f(8)=f(14)=6,$ we conclude that $\\frac{Δf}{Δx}=0$ on the interval $[8,14].$"} :step/id #uuid "8e9f58a5-83f2-5f0f-a9bc-6158da91961d" :step/next {:db/id #edb/ref 17592186544981}} {:db/id #edb/ref 17592186544981 :step/content {:db/id #edb/ref 17592186544791 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e225497-e1ac-5eb6-9cb3-5c89fd6eef24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[0,3]" :db/id #edb/ref 17592186544115} {:answer/id #uuid "17d6b3cd-6f8f-590e-bb5d-743d31b08523" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-1,1]" :db/id #edb/ref 17592186544136} {:answer/id #uuid "4ab88dbb-34ea-5c23-bf26-1597dd63a935" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There is no such interval" :db/id #edb/ref 17592186544248} {:answer/id #uuid "8cc10ac0-f906-557a-b5b7-edf62f818cc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[1,2]" :db/id #edb/ref 17592186544388} {:answer/id #uuid "fb5ad1f9-b7b2-5c15-a53e-1f3a9f44b473" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-2,0]" :db/id #edb/ref 17592186544636}] :answer-field/correct {:db/id #edb/ref 17592186544636} :answer-field/id #uuid "036ab766-0259-55f6-8113-94c9afa97abc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544651}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "14e3fc47-0564-56b4-b83c-8a7fa94d57dd" :question/math-academy-id "q-101733" :question/problem "Find the interval where the average rate of change of $f(x)$ equals $0$ given the following table of values of $f(x):$\n\n| $x$ | $\\,-3\\,$ | $\\,-2\\,$ | $\\,-1\\,$ | $\\,0\\,$ | $\\,1\\,$ | $\\,2\\,$ | $\\,3\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\,2\\,$ | $\\,-1\\,$ | $\\,1\\,$ | $\\,-1\\,$ | $\\,3\\,$ | $\\,4\\,$ | $\\,0\\,$ |" :question/worked-solution "We have $\\frac{Δf}{Δx}=0$ if and only if $Δf=0.$ So\n\n$$\n\\begin{aligned} & Δf=0 \\\\  & f(b)-f(a)=0 \\\\  & f(b)=f(a).\\end{aligned}\n$$\n\nThis means we have to find an interval  $[a,b]$ such that $f(a)=f(b).$\n\nSince $f(-2)=f(0)=-1,$ we conclude that $\\frac{Δf}{Δx}=0$ on the interval $[-2,0].$"} :step/id #uuid "da35fb1b-8325-5c95-8113-934e8ad42985"}] :activity/title "The Average Rate of Change of a Function" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186544079}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186563793} :activity/id #uuid "af71ffd9-d2a7-5da4-8d73-f6984dc9c6d5" :activity/scope {:db/id #edb/ref 17592186050572 :topic/id #uuid "54b8c8a0-5bff-5a9f-9ca1-b046c38a20d9" :topic/math-academy-id 336} :activity/steps [{:db/id #edb/ref 17592186563793 :step/content {:db/id #edb/ref 17592186233625 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17e422ba-8bfb-58cd-bf84-f724e2f172f6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$187$ machines per day" :db/id #edb/ref 17592186562999} {:answer/id #uuid "5ec21c0f-0f70-5b8e-9e69-fb68559678cb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$78$ machines per day" :db/id #edb/ref 17592186563162} {:answer/id #uuid "6514c1a1-a69c-5ca8-a457-e3ad929c428c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$18$ machines" :db/id #edb/ref 17592186563177} {:answer/id #uuid "6b6ad1a5-6c93-5a76-8a86-f908df99ff88" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$178$ machines per day" :db/id #edb/ref 17592186563192} {:answer/id #uuid "cf0102f2-90a7-5523-b0f0-1c458c420558" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1309$ machines per day" :db/id #edb/ref 17592186563400}] :answer-field/correct {:db/id #edb/ref 17592186562999} :answer-field/id #uuid "3a53d094-3bb9-54ec-b5aa-7a1952045146" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563555}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "102f480c-0b70-562a-8bb4-30ec6a97cacd" :question/math-academy-id "q-21123" :question/problem "The number of machines infected by a computer virus is represented by the function $f(t)=4{t}^{3}-2{t}^{2}+5t+11,$ where $t$ is the time, in days, since the virus was first detected. What is the average rate of growth of $f(t)$ over the first week?" :question/worked-solution "Let $f(t)=4{t}^{3}-2{t}^{2}+5t+11$ be the number of machines infected by the computer virus after $t$ days. To find the average rate of growth of $f(t)$ over the first week, we use the average rate of change formula on the interval $[0,7]$:\n\n$$\n\\begin{aligned}\\frac{Δf}{Δt} & =\\frac{f(b)-f(a)}{b-a} \\\\  & =\\frac{f(7)-f(0)}{7-0} \\\\  & =\\frac{[4(7)^{3}-2(7)^{2}+5(7)+11]-[4(0)^{3}-2(0)^{2}+5(0)+11]}{7} \\\\  & =\\frac{1309}{7} \\\\  & =187\\end{aligned}\n$$\n\nTherefore, the average rate of growth over the first week is $187$ machines per day."} :step/id #uuid "94f83715-b9d0-5214-9dc7-59839d65afa8" :step/next {:db/id #edb/ref 17592186563812}} {:db/id #edb/ref 17592186563796 :step/content {:db/id #edb/ref 17592186563733 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a593d74-32d6-5a69-a98b-ba5cb32852de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=-3" :db/id #edb/ref 17592186562960} {:answer/id #uuid "230851de-2e37-58e2-83a6-08333ab1a503" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=-1" :db/id #edb/ref 17592186563023} {:answer/id #uuid "8afbee44-783e-5d4e-ae7f-0733ea8987a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=-\\frac{4}{3}" :db/id #edb/ref 17592186563256} {:answer/id #uuid "97893439-7f84-5b6b-8ef2-2103da171047" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=-2" :db/id #edb/ref 17592186563286} {:answer/id #uuid "c477754f-139c-565b-8756-f6505de16c44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=-\\frac{3}{2}" :db/id #edb/ref 17592186563375}] :answer-field/correct {:db/id #edb/ref 17592186563375} :answer-field/id #uuid "ffb11692-b94a-52a8-a712-f1575499549c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563643}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c6acc05f-c544-5e0c-918b-0d7218132aa6" :question/math-academy-id "q-101729" :question/problem "The table below lists values of $f(x)$ at distinct $x$-values. Knowing that the average rate of change of the function $f(x)$ on the interval $[3p,5]$ is $-2,$ find the value of $p.$ \n\n| $x$ | $\\,-10\\,$ | $\\,-7\\,$ | $\\,3p\\,$ | $\\,-2\\,$ | $\\,0\\,$ | $\\,1\\,$ | $\\,5\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\,12\\,$ | $\\,8\\,$ | $\\,11\\,$ | $\\,-2\\,$ | $\\,3\\,$ | $\\,-16\\,$ | $\\,-8\\,$ |" :question/worked-solution "Using the formula for the average rate of change, we get\n\n$$\n\\begin{aligned}\\frac{Δf}{Δx} & =\\frac{f(b)-f(a)}{b-a} \\\\  & =\\frac{f(5)-f(3p)}{5-3p} \\\\  & =\\frac{-8-11}{5-3p} \\\\  & =\\frac{-19}{5-3p}.\\end{aligned}\n$$\n\nNow, we know that $\\frac{Δf}{Δx}=-2$ on the interval $[3p,5].$ Thus, \n\n$$\n\\frac{-19}{5-3p}=-2.\n$$\n\nSolving for $p,$ we have\n\n$$\n\\begin{aligned}\\frac{-19}{5-3p} & =-2 \\\\ -19 & =-2\\cdot (5-3p) \\\\ -19 & =-10+6p \\\\ -19+10 & =6p \\\\ -9 & =6p \\\\ \\frac{-9}{6} & =\\frac{6p}{6} \\\\ -\\frac{3}{2} & =p.\\end{aligned}\n$$\n\nTherefore, we conclude that $p=-\\frac{3}{2}.$"} :step/id #uuid "9f4a8224-65c7-50bd-92b8-559516e2b29f"} {:db/id #edb/ref 17592186563812 :step/content {:db/id #edb/ref 17592186234251 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07499a9c-8e67-54b9-9395-d93c708bbcef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-1,9]" :db/id #edb/ref 17592186562953} {:answer/id #uuid "239ed64f-b9a3-58e8-a207-a68375ffaf55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-1,6]" :db/id #edb/ref 17592186563024} {:answer/id #uuid "7bdb203c-403b-5c7a-9b7e-0846cc37c78e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-3,0]" :db/id #edb/ref 17592186563216} {:answer/id #uuid "a18f517d-5d7a-5713-a2a7-49bee54b80b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[0,6]" :db/id #edb/ref 17592186563310} {:answer/id #uuid "f1de2945-364c-50aa-8988-3364d0eee183" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-1,4]" :db/id #edb/ref 17592186563486}] :answer-field/correct {:db/id #edb/ref 17592186562953} :answer-field/id #uuid "43e0c3a2-ebf4-5117-acb5-14db58f53c00" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563559}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9defd366-8d4b-5775-94e7-9eeab1aed32c" :question/math-academy-id "q-69674" :question/problem "Find an interval where the average rate of change of $f(x)$ equals $0$ given the following table of values of $f(x):$\n\n| $x$ | $\\,-3\\,$ | $\\,-1\\,$ | $\\,0\\,$ | $\\,2\\,$ | $\\,4\\,$ | $\\,6\\,$ | $\\,9\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\,7\\,$ | $\\,-4\\,$ | $\\,3\\,$ | $\\,-4\\,$ | $\\,1\\,$ | $\\,5\\,$ | $\\,-4\\,$ |" :question/worked-solution "We have $\\frac{Δf}{Δx}=0$ if and only if $Δf=0.$ So\n\n$$\n\\begin{aligned} & Δf=0 \\\\  & f(b)-f(a)=0 \\\\  & f(b)=f(a).\\end{aligned}\n$$\n\nThis means we have to find an interval  $[a,b]$ such that $f(a)=f(b).$\n\nSince $f(-1)=f(9)=-4,$ we conclude that $\\frac{Δf}{Δx}=0$ on the interval $[-1,9].$"} :step/id #uuid "f2c7f57f-4477-5450-97f5-dfadff385e2d" :step/next {:db/id #edb/ref 17592186563796}}] :activity/title "The Average Rate of Change of a Function" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186562935}]}
