#{[{:db/id #edb/ref 17592186567108 :knowledge-point/_questions [{:db/id #edb/ref 17592186124581 :knowledge-point/id #uuid "58b93ad7-d548-58cb-9cc5-0bcd79e28e4c" :knowledge-point/title "Finding the Roots of a Transformed Square Root Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ef544a9-5795-5970-a9a7-c68843ce96fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{31}{9}" :db/id #edb/ref 17592186566457} {:answer/id #uuid "418df96d-c38c-5440-8ee3-1cf5bb3e79e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{2}{3}" :db/id #edb/ref 17592186566494} {:answer/id #uuid "516e1e94-e492-56c7-9b8d-9ba48974ef1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no roots" :db/id #edb/ref 17592186566518} {:answer/id #uuid "6828996a-5d6f-513a-8402-0bb4196db80e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{3}{2}" :db/id #edb/ref 17592186566562} {:answer/id #uuid "b86790ac-be7f-5c15-99f3-dcb8df01ddc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{23}{9}" :db/id #edb/ref 17592186566729}] :answer-field/correct {:answer/id #uuid "516e1e94-e492-56c7-9b8d-9ba48974ef1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no roots" :db/id #edb/ref 17592186566518} :answer-field/id #uuid "3e89b75e-55c7-59cd-994f-918f781f04f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186566907}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f69267eb-2f97-5d5a-a24e-05305c278930" :question/math-academy-id "q-115389" :question/problem "Find the root of $f(x)=3\\sqrt{1-x}+2.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n3\\sqrt{1-x}+2=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}3\\sqrt{1-x}+2 & =0 \\\\ 3\\sqrt{1-x} & =-2 \\\\ \\sqrt{1-x} & =-\\frac{2}{3}\\end{aligned}\n$$\n\nThis equation does not have any solutions since its left-hand side is always nonnegative, while the right-hand side is negative.\n\nTherefore, $f(x)$ has no roots."}] [{:db/id #edb/ref 17592186125149 :knowledge-point/_questions [{:db/id #edb/ref 17592186124550 :knowledge-point/id #uuid "f5e23379-0f5d-5691-b10f-5125325ffa70" :knowledge-point/title "Finding a Transformed Square Root Function Given Some Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9fddb3a-fdaf-54be-90bc-3832f297ecbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186123495} {:answer/id #uuid "2e3cfb12-b53a-5c56-a062-f2e81b982bbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186123496} {:answer/id #uuid "4957773d-db22-5420-a308-9be4e177a3a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186123497} {:answer/id #uuid "5a955389-14d7-50fb-bc2e-0a597c3065de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186123498} {:answer/id #uuid "5b780b4c-c044-5f38-abac-68cc0fd0d816" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186123499}] :answer-field/correct {:answer/id #uuid "4957773d-db22-5420-a308-9be4e177a3a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186123497} :answer-field/id #uuid "cbd9fe82-3cd6-5cc9-9a59-44ad6798b172" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123494}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4c25a94d-aa0f-5265-8f93-b727f1f1fa1d" :question/math-academy-id "q-39533" :question/problem "Let $f(x)=a\\sqrt{x+b}+c.$ Now consider the following properties of $f(x):$\n\n- The domain of $f(x)$ is $x\\in [1,\\infty ).$\n\n- The range is $f(x)\\in [2,\\infty ).$\n\n- The point $(5,4)$ lies on the graph of $y=f(x).$\n\nFind the value of $a+b+c.$" :question/worked-solution "Let's consider each property in turn.\n\n- The domain of $f(x)=a\\sqrt{x+b}+c\\,$ is determined by the following inequality:\n\n$$\n\\begin{aligned}x+b & \\ge 0 \\\\ x & \\ge -b\\end{aligned}\n$$\n\nWe are given that the domain is $x\\in [1,\\infty ),$ which is equivalent to $x\\ge 1.$ Hence, we obtain\n\n$$\n-b=1\\,⟹\\,b=-1.\n$$\n\n- Since the range is unbounded on the right-hand side, we know that $a>0.$ Furthermore, since we are given that the lowest point in the range is $2,$ we must have\n\n$$\n\\begin{aligned}{{a\\sqrt{x-1}}_{⏟}}_{\\ge 0}+c\\ge 2.\\end{aligned}\n$$\n\nThis means that $c=2.$\n\n- Finally, since the point $(5,4)$ lies on the graph of $y=f(x),$ we have\n\n$$\n\\begin{aligned}f(5) & =a\\sqrt{5-1}+2 \\\\ 4 & =2a+2 \\\\ 2a & =2 \\\\ a & =1.\\end{aligned}\n$$\n\nTherefore, our function is $f(x)=\\sqrt{x-1}+2$ and \n\n$$\na+b+c=1+(-1)+2=2.\n$$"}] [{:db/id #edb/ref 17592186125233 :knowledge-point/_questions [{:db/id #edb/ref 17592186124581 :knowledge-point/id #uuid "58b93ad7-d548-58cb-9cc5-0bcd79e28e4c" :knowledge-point/title "Finding the Roots of a Transformed Square Root Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "870ac61d-0246-5a8c-a0d7-22ff7b1d588d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no roots" :db/id #edb/ref 17592186123999} {:answer/id #uuid "06ff5c99-5eac-5b93-bc59-6a518d9f6200" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186566377} {:answer/id #uuid "1fd0680d-4c94-52f3-b5f4-77f860d49bfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm 1" :db/id #edb/ref 17592186566430} {:answer/id #uuid "503704f9-5770-5b3b-abfa-76909c10b9cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3" :db/id #edb/ref 17592186566515} {:answer/id #uuid "8ebe895b-2eb1-5e8e-9132-13a11596663c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=1" :db/id #edb/ref 17592186566641}] :answer-field/correct {:answer/id #uuid "8ebe895b-2eb1-5e8e-9132-13a11596663c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=1" :db/id #edb/ref 17592186566641} :answer-field/id #uuid "5b9e7155-cf6b-5492-ab5e-bf436b1807af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123998}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c5641e99-6917-5a94-83b2-475bc5698fcc" :question/math-academy-id "q-89780" :question/problem "Find the root of $f(x)=\\sqrt{3x+1}-2.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n\\sqrt{3x+1}-2=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt{3x+1}-2 & =0 \\\\ \\sqrt{3x+1} & =2 \\\\ (\\sqrt{3x+1})^{2} & ={2}^{2} \\\\ 3x+1 & =4 \\\\ 3x & =3 \\\\ x & =1\\end{aligned}\n$$\n\nFinally, we must check the answer by substituting it back into the initial equation:\n\n$$\n\\begin{aligned}\\sqrt{3\\cdot 1+1}-2 & =0 \\\\ \\sqrt{4} & =2 \\\\ 2 & =2\\,✓\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=1.$"}]}
