#{[{:db/id #edb/ref 17592186179480 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179637 :knowledge-point/id #uuid "08661743-d541-5f60-a2de-d536a1953eb6" :knowledge-point/title "Computing the Terms of an Arithmetic Sequence"}] :question/id #uuid "e2410277-5f68-5cf6-a358-635517123015" :question/math-academy-id "e-14378" :question/problem "Calculate the fourth term of the sequence\n\n$$\nf(n+1) = f(n) -6, \\quad f(1) = 1, \\quad n\\geq 1.\n$$" :question/worked-solution "Starting with the first term $f(1)=1,$ we compute the next terms using the recursive rule until we reach the fourth term $f(4).$\n\n$$\n\\begin{aligned}f(1) & =1 \\\\ f(2) & =f(1)-6=1-6=-5 \\\\ f(3) & =f(2)-6=-5-6=-11 \\\\ f(4) & =f(3)-6=-11-6=-17\\end{aligned}\n$$\n\nTherefore, the fourth term is $f(4)=-17.$"}] [{:db/id #edb/ref 17592186179481 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179638 :knowledge-point/id #uuid "25aaf48f-f1ca-50a5-8fae-aa4f9508cfba" :knowledge-point/title "Finding a Recursive Formula"}] :question/id #uuid "1fa96efe-9a81-5c09-b172-fd0ca6d6a2e3" :question/math-academy-id "e-14380" :question/problem "What is the recursive formula for the following arithmetic sequence?\n\n$$\n4,\\: 9,\\: 14,\\: \\ldots\n$$" :question/worked-solution "The recursive formula for an arithmetic sequence with common difference $d$ is\n\n$$\na_{n+1} =a_n+d.\n$$\n\nIn our case, the common difference is\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =9-4 \\\\  & =5.\\end{aligned}\n$$\n\nConsequently, the recursive formula for this sequence is\n\n$$\na_{n+1}= a_n + 5, \\quad a_1=4, \\quad n\\geq 1\\,.\n$$"}] [{:db/id #edb/ref 17592186558526 :knowledge-point/_questions [{:db/id #edb/ref 17592186179637 :knowledge-point/id #uuid "08661743-d541-5f60-a2de-d536a1953eb6" :knowledge-point/title "Computing the Terms of an Arithmetic Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b2e8c26-530e-5fd0-8666-be7602cf3004" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "75" :db/id #edb/ref 17592186557960}] :answer-field/correct {:answer/id #uuid "2b2e8c26-530e-5fd0-8666-be7602cf3004" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "75" :db/id #edb/ref 17592186557960} :answer-field/id #uuid "6186c912-af2d-54e8-92ba-7fac27611398" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186558407}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "713cc6c3-9177-55d5-83bc-303e3a63514e" :question/math-academy-id "q-215884" :question/problem "An arithmetic sequence ${a}_{n}$ is defined by \n\n$$\n{a}_{n+1}={a}_{n}+15,\\,{a}_{1}=0,\\,n\\ge 1?\n$$\n\nThe $6$th term of this sequence is{{field-1}}." :question/worked-solution "Starting with the first term ${a}_{1}=0,$ we compute the next terms using the recursive rule until we reach the $6$th term ${a}_{6}.$\n\n$$\n\\begin{aligned}{a}_{1} & =0 \\\\ {a}_{2} & ={a}_{1}+15=0+15=15 \\\\ {a}_{3} & ={a}_{2}+15=15+15=30 \\\\ {a}_{4} & ={a}_{3}+15=30+15=45 \\\\ {a}_{5} & ={a}_{4}+15=45+15=60 \\\\ {a}_{6} & ={a}_{5}+15=60+15=75\\end{aligned}\n$$\n\nTherefore, the $6$th term is ${a}_{6}=75.$"}] [{:db/id #edb/ref 17592186558565 :knowledge-point/_questions [{:db/id #edb/ref 17592186179638 :knowledge-point/id #uuid "25aaf48f-f1ca-50a5-8fae-aa4f9508cfba" :knowledge-point/title "Finding a Recursive Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "298258b3-c8ea-519a-a66b-435f9d2cc9e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n+1}={a}_{n}+4,\\,{a}_{1}=11,\\,n\\ge 1" :db/id #edb/ref 17592186557953} {:answer/id #uuid "4fef15fa-652b-5363-9930-fabb374ecaac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n+1}={a}_{n}-4,\\,{a}_{1}=1,\\,n\\ge 1" :db/id #edb/ref 17592186558018} {:answer/id #uuid "6406b1d7-ba05-5a1f-8497-5eaf1e48e6d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n+1}={a}_{n}-4,\\,{a}_{1}=11,\\,n\\ge 1" :db/id #edb/ref 17592186558058} {:answer/id #uuid "7b0465f0-f748-5d29-b169-88cac2ac08bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n+1}={a}_{n}+4,\\,{a}_{1}=1,\\,n\\ge 1" :db/id #edb/ref 17592186558105} {:answer/id #uuid "b3bd82c0-fa16-56a1-871c-2a6987c72e6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n+1}={a}_{n}+11,\\,{a}_{1}=1,\\,n\\ge 1" :db/id #edb/ref 17592186558222}] :answer-field/correct {:answer/id #uuid "6406b1d7-ba05-5a1f-8497-5eaf1e48e6d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n+1}={a}_{n}-4,\\,{a}_{1}=11,\\,n\\ge 1" :db/id #edb/ref 17592186558058} :answer-field/id #uuid "61159f57-cb89-5224-b75e-6fdcfcb823ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558405}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d05d25db-b298-5134-b608-67b85d063ed0" :question/math-academy-id "q-44928" :question/problem "What is the recursive formula for the following arithmetic sequence?\n\n$$\n11,\\,7,\\,3,\\,…\n$$" :question/worked-solution "The recursive formula for an arithmetic sequence with common difference $d$ is\n\n$$\n{a}_{n+1}={a}_{n}+d.\n$$\n\nIn our case, the common difference is\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =7-11 \\\\  & =-4.\\end{aligned}\n$$\n\nConsequently, the recursive formula for this sequence is\n\n$$\n{a}_{n+1}={a}_{n}-4,\\,{a}_{1}=11,\\,n\\ge 1\\,.\n$$"}] [{:db/id #edb/ref 17592186558509 :knowledge-point/_questions [{:db/id #edb/ref 17592186179637 :knowledge-point/id #uuid "08661743-d541-5f60-a2de-d536a1953eb6" :knowledge-point/title "Computing the Terms of an Arithmetic Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f60d69c-3bea-5850-a3ed-f0ba3361b76b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-17" :db/id #edb/ref 17592186557932} {:answer/id #uuid "59c48053-5d37-5682-ad49-b1549faa800e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186558036} {:answer/id #uuid "e165171f-eef7-5192-9c8c-1bfc9dd4cf11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186558315} {:answer/id #uuid "f54fda74-1ca3-5d2f-9b3d-4f0c7845d39e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186558349} {:answer/id #uuid "f74086ea-f300-5c51-b2d2-332a102e6389" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186558353}] :answer-field/correct {:answer/id #uuid "1f60d69c-3bea-5850-a3ed-f0ba3361b76b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-17" :db/id #edb/ref 17592186557932} :answer-field/id #uuid "4a0881a6-c4d5-5f55-bec9-94814f675ab0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558386}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "400da920-5753-5f4c-8f7e-782c1d5a4a17" :question/math-academy-id "q-44935" :question/problem "An arithmetic sequence $f(n)$ is defined by \n\n$$\nf(n+1)=f(n)-7,\\,f(1)=4,\\,n\\ge 1.\n$$\n\nWhat is the $4$th term of the sequence?" :question/worked-solution "Starting with the first term $f(1)=4,$ we compute the next terms using the recursive rule until we reach the $4$th term $f(4).$\n\n$$\n\\begin{aligned}f(1) & =4 \\\\ f(2) & =f(1)-7=4-7=-3 \\\\ f(3) & =f(2)-7=-3-7=-10 \\\\ f(4) & =f(3)-7=-10-7=-17\\end{aligned}\n$$\n\nTherefore, the $4$th term is $f(4)=-17.$"}] [{:db/id #edb/ref 17592186558521 :knowledge-point/_questions [{:db/id #edb/ref 17592186179638 :knowledge-point/id #uuid "25aaf48f-f1ca-50a5-8fae-aa4f9508cfba" :knowledge-point/title "Finding a Recursive Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1601f3f6-e399-58a2-b3f0-101b44da3d32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n+1}={a}_{n}+2,\\,{a}_{1}=1,\\,n\\ge 1" :db/id #edb/ref 17592186557919} {:answer/id #uuid "221427d8-6165-50b5-a8ad-0471fc16351f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n+1}={a}_{n}-5,\\,{a}_{1}=-5,\\,n\\ge 1" :db/id #edb/ref 17592186557939} {:answer/id #uuid "7faf38a6-4e4d-5d9f-b986-f57d02a359db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n+1}={a}_{n}-3,\\,{a}_{1}=-5,\\,n\\ge 1" :db/id #edb/ref 17592186558114} {:answer/id #uuid "d9933595-6a03-5f07-9b00-2d6c9dd6730b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n+1}={a}_{n}+4,\\,{a}_{1}=-2,\\,n\\ge 1" :db/id #edb/ref 17592186558298} {:answer/id #uuid "f3e79203-77ff-5caa-a098-561da14a7eb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n+1}={a}_{n}+3,\\,{a}_{1}=-5,\\,n\\ge 1" :db/id #edb/ref 17592186558346}] :answer-field/correct {:answer/id #uuid "f3e79203-77ff-5caa-a098-561da14a7eb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n+1}={a}_{n}+3,\\,{a}_{1}=-5,\\,n\\ge 1" :db/id #edb/ref 17592186558346} :answer-field/id #uuid "9a17c515-6f9b-5a26-a5e6-f9910bba6da3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558435}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "654db483-a24c-50a6-ad12-4b6cce747a3d" :question/math-academy-id "q-67194" :question/problem "What is the recursive formula for the following arithmetic sequence?\n\n$$\n-5,\\,-2,\\,1,\\,…\n$$" :question/worked-solution "The recursive formula for an arithmetic sequence with common difference $d$ is\n\n$$\n{a}_{n+1}={a}_{n}+d.\n$$\n\nIn our case, the common difference is\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =-2-(-5) \\\\  & =-2+5 \\\\  & =3.\\end{aligned}\n$$\n\nConsequently, the recursive formula for this sequence is\n\n$$\n{a}_{n+1}={a}_{n}+3,\\,{a}_{1}=-5,\\,n\\ge 1\\,.\n$$"}]}
