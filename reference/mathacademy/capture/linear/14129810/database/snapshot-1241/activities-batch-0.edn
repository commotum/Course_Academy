#{[{:activity/first-step {:db/id #edb/ref 17592186193793} :activity/id #uuid "4d61d371-4b1d-53de-aa5b-4f42cd001c6f" :activity/scope {:db/id #edb/ref 17592186049804 :topic/id #uuid "1536bce1-492f-5bac-a22e-80aecb57bdd7" :topic/math-academy-id 3968} :activity/steps [{:db/id #edb/ref 17592186193793 :step/content {:db/id #edb/ref 17592186193931 :tutorial/content "We can use our knowledge of fraction models to multiply fractions by whole numbers.\n\nFor example, let's consider the following product:\n\n$$\n\\dfrac{3}{10} \\times 2\n$$\n\nWe start by drawing a fraction model for\n\n$$\n\\dfrac{3}{10}{:}\n$$\n\n![](images/74/7441921087fa0748dc0de6843c45c93fd9c492bade22fc8ae31192fd9c943016.png)\n\nMultiplying\n\n$$\n\\dfrac{\\color{red}3}{10}\n$$\n\nby $\\color{blue}2$ means that we need to repeat the fraction $\\color{blue}2$ times.\n\n![](images/88/88ba96e731a6242aecea0a6b059933e128efdf6bbb52f37a0a73e57a004ab96c.png)\n\nNow, we count the number of shaded pieces.\n\nThere are\n\n$$\n{\\color{red}3} \\times {\\color{blue}2} = 6\n$$\n\nshaded pieces in total. Therefore,\n\n$$\n\\dfrac{3}{10} \\times 2 = \\dfrac{6}{10}\n$$" :tutorial/id #uuid "bfe48a90-960a-5004-8a63-a58ea72103ff" :tutorial/math-academy-id 8518 :tutorial/title "Introduction"} :step/id #uuid "87fc1377-7af4-5e22-a70c-aed6997dce8c" :step/math-academy-id 88301 :step/next {:db/id #edb/ref 17592186193794}} {:db/id #edb/ref 17592186193794 :step/content {:db/id #edb/ref 17592186192858 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192568 :question/id #uuid "56936482-95f9-54ff-b006-cd79247947ba" :question/math-academy-id "e-13618"} :knowledge-point/id #uuid "a891eaf9-6a4c-5e87-8aa0-95920347bd4d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050244}] :knowledge-point/questions [{:db/id #edb/ref 17592186193365} {:db/id #edb/ref 17592186193367}] :knowledge-point/title "Representing a Product as a Repeated Addition"} :step/id #uuid "96c0a507-52a5-5363-8641-411d16b13295" :step/math-academy-id 88302 :step/next {:db/id #edb/ref 17592186193795}} {:db/id #edb/ref 17592186193795 :step/content {:db/id #edb/ref 17592186192859 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192569 :question/id #uuid "6a8062c4-e4e5-5045-8b33-7f0afaf76d72" :question/math-academy-id "e-13624"} :knowledge-point/id #uuid "0abaf0f6-4018-54b2-a118-f420a3e0705c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051077}] :knowledge-point/questions [{:db/id #edb/ref 17592186192963} {:db/id #edb/ref 17592186193364}] :knowledge-point/title "Multiplying a Fraction by a Whole Number Using Repeated Addition"} :step/id #uuid "1b181827-1135-5056-b586-5b3139e0ce58" :step/math-academy-id 88305 :step/next {:db/id #edb/ref 17592186193796}} {:db/id #edb/ref 17592186193796 :step/content {:db/id #edb/ref 17592186193932 :tutorial/content "There's another way we can use fraction models to multiply fractions by whole numbers.\n\nTo demonstrate, let's consider the following multiplication problem:\n\n$$\n\\dfrac{2}{9} \\times 4\n$$\n\nWe start by drawing a fraction model to represent\n\n$$\n\\dfrac{2}{9}\n$$\n\n![](images/d3/d3c46b3452b6d5d22a30a9949800d7a69bdacf4135615627881c9dc69c0a5513.png)\n\nNow, rather than repeating our model $4$ times (which would take a long time), we can instead multiply the number of shaded pieces by $4$.\n\nOur model has $2$ shaded pieces. So, the resulting model must have\n\n$$\n2 \\times 4 = 8\n$$\n\nshaded pieces:\n\n![](images/b9/b99a75597e9e06cdd0c267b291ae0d671d670f7a3fc4b9af4555d9b217a0b4ed.png)\n\nTherefore, we conclude that\n\n$$\n\\dfrac{2}{9}\\times 4 = \\dfrac{8}{9}\n$$" :tutorial/id #uuid "dbb3bf95-1b0b-52ea-b1ff-7a7a7c5d11f6" :tutorial/math-academy-id 8524 :tutorial/title "A Faster Method for Multiplying Fractions by Whole Numbers"} :step/id #uuid "c1d11338-8db9-53d5-b934-67da3916921a" :step/math-academy-id 88308 :step/next {:db/id #edb/ref 17592186193797}} {:db/id #edb/ref 17592186193797 :step/content {:db/id #edb/ref 17592186192860 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192570 :question/id #uuid "3c170236-340b-5446-960f-a20b6937c23c" :question/math-academy-id "e-13628"} :knowledge-point/id #uuid "78c0c75e-8a40-5064-a62a-954d8b85c3c1" :knowledge-point/questions [{:db/id #edb/ref 17592186193366} {:db/id #edb/ref 17592186193368}] :knowledge-point/title "Multiplying a Fraction by a Whole Number by Repeating the Shaded Parts"} :step/id #uuid "6ab5f02a-0507-5d82-88b7-8426ecc223d8" :step/math-academy-id 88309}] :activity/title "Multiplying Fractions by Whole Numbers Using Models" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186192881}]}
