186045417] [17592186192114 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186192114 #edb/ref 1083 #uuid "d01de287-3da4-5469-98f2-0d8e6f4a2df3" #edb/ref 17592186045417] [17592186192115 #edb/ref 1080 "\\frac{1}{10}" #edb/ref 17592186045417] [17592186192115 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186192115 #edb/ref 1083 #uuid "e5081161-4b08-5267-9301-fdec6f15675f" #edb/ref 17592186045417] [17592186192116 #edb/ref 1080 "\\frac{2}{10}" #edb/ref 17592186045417] [17592186192116 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186192116 #edb/ref 1083 #uuid "fe688ae7-cf91-59af-8d11-49b92456cba7" #edb/ref 17592186045417] [17592186192135 #edb/ref 1075 #edb/ref 17592186425416 #edb/ref 17592186045417] [17592186192135 #edb/ref 1075 #edb/ref 17592186425418 #edb/ref 17592186045417] [17592186192135 #edb/ref 1075 #edb/ref 17592186425430 #edb/ref 17592186045417] [17592186192135 #edb/ref 1075 #edb/ref 17592186425447 #edb/ref 17592186045417] [17592186192135 #edb/ref 1075 #edb/ref 17592186425456 #edb/ref 17592186045417] [17592186192135 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186192135 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186192135 #edb/ref 1078 #edb/ref 17592186425456 #edb/ref 17592186045417] [17592186192135 #edb/ref 1079 #uuid "3520462c-4bd7-5c5e-8157-9e5b6a52a420" #edb/ref 17592186045417] [17592186192568 #edb/ref 1069 "e-13618" #edb/ref 17592186045417] [17592186192568 #edb/ref 1071 "![](images/cd/cd41e0c4d98c28e41c8e91743c70bbcac3e0b88071d1075e1cd518d2410843fa.png)\n\nConsider the diagram above. Write down this multiplication as a repeated addition of fraction models." #edb/ref 17592186045417] [17592186192568 #edb/ref 1072 #uuid "56936482-95f9-54ff-b006-cd79247947ba" #edb/ref 17592186045417] [17592186192568 #edb/ref 1074 "In the model, we have $\\dfrac{\\color{red}4}{5}$ multiplied by ${\\color{blue}3}.$ This means that we need to make $\\color{blue}3$ copies of the given fraction model.\n\n![](images/2a/2ab193d9bb045165bcfffadae012523f33297548eacbdfd6b3514c791d7fac58.png)\n\n \n\nSo, the missing picture is:\n\n![](images/59/59f5625dce754f49724d16b00e839ec34e473601df4702db51f3973f14fd4c10.png)" #edb/ref 17592186045417] [17592186192569 #edb/ref 1069 "e-13624" #edb/ref 17592186045417] [17592186192569 #edb/ref 1071 "![](images/15/1553e601de2b1664996bb27d49cb09d3baacc72772f9846b45dc45dc9114ff53.png)\n\n \n\nUse the model above to calculate $\\dfrac{5}{6} \\times 3.$" #edb/ref 17592186045417] [17592186192569 #edb/ref 1072 #uuid "6a8062c4-e4e5-5045-8b33-7f0afaf76d72" #edb/ref 17592186045417] [17592186192569 #edb/ref 1074 "Since we need to multiply $\\dfrac{\\color{red}5}{6}$ by $\\color{blue}3$, we repeat the fraction model $\\color{blue}3$ times, as shown below.\n\n![](images/b9/b9443ceedbda3d541b0fc4d69489eead83dc8550710c7b6b3f1f9ed90d1dc97b.png)\n\n \n\nThere are ${\\color{red}5} \\times {\\color{blue}3} = 15$ shaded pieces in total. Therefore:\n\n$$\n\\dfrac{5}{6} \\times 3 = \\dfrac{15}{6}\n$$" #edb/ref 17592186045417] [17592186192570 #edb/ref 1069 "e-13628" #edb/ref 17592186045417] [17592186192570 #edb/ref 1071 "![](images/a7/a7e53c31ac53ee142500771bf19af2995c02ecb6fef9aa37e73402e63fa7d518.png)\n\nWhat number is missing from the multiplication problem above?" #edb/ref 17592186045417] [17592186192570 #edb/ref 1072 #uuid "3c170236-340b-5446-960f-a20b6937c23c" #edb/ref 17592186045417] [17592186192570 #edb/ref 1074 "We have $\\dfrac{3}{7}$ on the left and $\\dfrac{6}{7}$ on the right.\n\n![](images/a7/a7b6a481c90b7372d0b78f7029b3fe8ae9c9c98f484459e1b7697308e3e2ebce.png)\n\nThe shape on the left has $3$ shaded pieces, and the shape on the right has $6$ shaded pieces. So the number of shaded pieces has increased by a factor of ${\\color{blue}2}.$ (That is, the number of shaded pieces has been multiplied by ${\\color{blue}2}.$)\n\nTherefore, the multiplication problem shown is\n\n$$\n\\dfrac{3}{7} \\times {\\color{blue}2} = \\dfrac{6}{7}.\n$$\n\nSo, the missing number is ${\\color{blue}2}.$" #edb/ref 17592186045417] [17592186192858 #edb/ref 1037 #edb/ref 17592186050244 #edb/ref 17592186045417] [17592186192858 #edb/ref 1038 #edb/ref 17592186193365 #edb/ref 17592186045417] [17592186192858 #edb/ref 1038 #edb/ref 17592186193367 #edb/ref 17592186045417] [17592186192858 #edb/ref 1038 #edb/ref 17592186425480 #edb/ref 17592186045417] [17592186192858 #edb/ref 1038 #edb/ref 17592186425481 #edb/ref 17592186045417] [17592186192858 #edb/ref 1038 #edb/ref 17592186425483 #edb/ref 17592186045417] [17592186192858 #edb/ref 1038 #edb/ref 17592186425490 #edb/ref 17592186045417] [17592186192858 #edb/ref 1038 #edb/ref 17592186425491 #edb/ref 17592186045417] [17592186192858 #edb/ref 1039 "Representing a Product as a Repeated Addition" #edb/ref 17592186045417] [17592186192858 #edb/ref 1041 #edb/ref 17592186192568 #edb/ref 17592186045417] [17592186192858 #edb/ref 1042 #uuid "a891eaf9-6a4c-5e87-8aa0-95920347bd4d" #edb/ref 17592186045417] [17592186192859 #edb/ref 1037 #edb/ref 17592186051077 #edb/ref 17592186045417] [17592186192859 #edb/ref 1038 #edb/ref 17592186192963 #edb/ref 17592186045417] [17592186192859 #edb/ref 1038 #edb/ref 17592186193364 #edb/ref 17592186045417] [17592186192859 #edb/ref 1038 #edb/ref 17592186425484 #edb/ref 17592186045417] [17592186192859 #edb/ref 1038 #edb/ref 17592186425485 #edb/ref 17592186045417] [17592186192859 #edb/ref 1038 #edb/ref 17592186425488 #edb/ref 17592186045417] [17592186192859 #edb/ref 1038 #edb/ref 17592186425489 #edb/ref 17592186045417] [17592186192859 #edb/ref 1039 "Multiplying a Fraction by a Whole Number Using Repeated Addition" #edb/ref 17592186045417] [17592186192859 #edb/ref 1041 #edb/ref 17592186192569 #edb/ref 17592186045417] [17592186192859 #edb/ref 1042 #uuid "0abaf0f6-4018-54b2-a118-f420a3e0705c" #edb/ref 17592186045417] [17592186192860 #edb/ref 1038 #edb/ref 17592186193366 #edb/ref 17592186045417] [17592186192860 #edb/ref 1038 #edb/ref 17592186193368 #edb/ref 1759218