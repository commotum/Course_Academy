wer/value "5" :db/id #edb/ref 17592186425458}] :answer-field/correct {:answer/id #uuid "d44a3fac-b8f6-5b5d-a4e7-9dac39fa1ba9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186425458} :answer-field/id #uuid "32b15b93-698f-550b-b456-a9aff2c28c24" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186425468}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "78913182-866b-5f3d-8f18-7227d3ef3784" :question/math-academy-id "q-192936" :question/problem "![](images/3a/3abbb0cdcde927f369bd45181bd232e9a15f3c4f8e73251ca6222ed0c45446fe.png)\n\nThe missing number in the multiplication problem above is{{field-1}}." :question/worked-solution "We have $\\frac{3}{20}$ on the left and $\\frac{15}{20}$ on the right.\n\n![](images/a9/a9d43ba0a45ea09cca23c929380f4c97a7e28ef959f04701236b9696163f26e7.png)\n\nThe shape on the left has $3$ shaded pieces, and the shape on the right has $15$ shaded pieces. So, the number of shaded pieces has increased by a factor of $5.$\n\nTherefore, the multiplication problem shown is\n\n$$\n\\frac{3}{20}\\times 5=\\frac{15}{20}.\n$$\n\nSo, the missing number is $5.$"}] [{:db/id #edb/ref 17592186425482 :knowledge-point/_questions [{:db/id #edb/ref 17592186192860 :knowledge-point/id #uuid "78c0c75e-8a40-5064-a62a-954d8b85c3c1" :knowledge-point/title "Multiplying a Fraction by a Whole Number by Repeating the Shaded Parts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54176c68-b6a7-5a95-9970-71cdf9663e68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186425425}] :answer-field/correct {:answer/id #uuid "54176c68-b6a7-5a95-9970-71cdf9663e68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186425425} 