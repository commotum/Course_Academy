ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186425419} {:answer/id #uuid "9d5748e5-d3f0-5d03-8f1e-4031d0a9f38b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186425444} {:answer/id #uuid "bb86c6e1-36c3-5fde-8ddf-bf5a253a7ec1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186425450} {:answer/id #uuid "eda30e95-760b-5607-9806-b95ad8ceeb77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186425462}] :answer-field/correct {:answer/id #uuid "bb86c6e1-36c3-5fde-8ddf-bf5a253a7ec1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186425450} :answer-field/id #uuid "c9a60462-00c5-5fd9-9a90-f26d13d56232" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425474}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "06318cb8-059d-53d5-b0f4-cd2955ecd05d" :question/math-academy-id "q-150343" :question/problem "![](images/49/4915694d83bd4468b7dfad98c3c5a687d7204830dbfc8242e9f5b32f2fd127df.png)\n\nWhat number is missing from the multiplication problem above?" :question/worked-solution "We have $\\frac{4}{15}$ on the left and $\\frac{12}{15}$ on the right.\n\n![](images/b8/b825a5a1e63a0ac768bb89ca90f7a99c943cda074c336594f48b55cdc2750684.png)\n\nThe shape on the left has $4$ shaded pieces, and the shape on the right has $12$ shaded pieces. So the number of shaded pieces has increased by a factor of $3.$\n\nTherefore, the multiplication problem shown is\n\n$$\n\\frac{4}{15}\\times 3=\\frac{12}{15}.\n$$\n\nSo, the missing number is $3.$"}] [{:db/id #edb/ref 17592186425488 :knowledge-point/_questions [{:db/id #edb/ref 17592186192859 :knowledge-point/id #uuid "0abaf