#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186153196} :activity/id #uuid "a9e96cf9-9aad-5b83-81b1-b9488d698494" :activity/scope {:db/id #edb/ref 17592186048993 :topic/id #uuid "d1b21eb7-a767-5b1f-8e65-566b74a26f39" :topic/math-academy-id 2552} :activity/steps [{:db/id #edb/ref 17592186152982 :step/content {:db/id #edb/ref 17592186152110 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151920 :question/id #uuid "42e81da3-7ea4-5b58-9163-3057df064c21" :question/math-academy-id "e-4460"} :knowledge-point/id #uuid "32650c78-38d5-5530-991d-bf0b8f2198cb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049405} {:db/id #edb/ref 17592186050948}] :knowledge-point/questions [{:db/id #edb/ref 17592186152654} {:db/id #edb/ref 17592186152655} {:db/id #edb/ref 17592186498546} {:db/id #edb/ref 17592186498595}] :knowledge-point/title "Identifying Graphs of Proportional Relationships"} :step/id #uuid "3e1f0c98-c1f6-59bc-8387-51338e8475ab" :step/math-academy-id 16271 :step/next {:db/id #edb/ref 17592186152983}} {:db/id #edb/ref 17592186152983 :step/content {:db/id #edb/ref 17592186152111 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151921 :question/id #uuid "06bdefa1-8b40-5777-9ca0-9f257834833d" :question/math-academy-id "e-4461"} :knowledge-point/id #uuid "d9c2ec6a-e04a-5e97-a91c-3a232e9aa29d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050195} {:db/id #edb/ref 17592186050249}] :knowledge-point/questions [{:db/id #edb/ref 17592186152644} {:db/id #edb/ref 17592186152645} {:db/id #edb/ref 17592186498491} {:db/id #edb/ref 17592186498526} {:db/id #edb/ref 17592186520499}] :knowledge-point/title "Computing a Constant of Proportionality or Unit Rate"} :step/id #uuid "65b0ae62-9c2f-5d32-a1a1-ac39767edaa8" :step/math-academy-id 16272 :step/next {:db/id #edb/ref 17592186153199}} {:db/id #edb/ref 17592186153196 :step/content {:db/id #edb/ref 17592186153338 :tutorial/content "How does a proportional relationship look when we plot it in the $(x,y)$ plane?\n\nTo answer this, let's consider the following proportional relationship:\n\n$$\ny = 2x\n$$\n\nTo plot a graph, we first need a table of values. \n\n| $x$ | $y$ |\n| --- | --- |\n| $0$ |  |\n| $1$ |  |\n| $2$ |  |\n| $3$ |  |\n\nFilling in the $y$-values using the equation $y = 2x,$ we get the following:\n\n| $x$ | $y$ |\n| --- | --- |\n| $0$ | $0$ |\n| $1$ | $2$ |\n| $2$ | $4$ |\n| $3$ | $6$ |\n\nSo, we have the following $(x,y)$ coordinates:\n\n$$\n(0,0), \\quad (1,2),  \\quad (2,4),  \\quad (3,6)\n$$\n\nIf we plot these points in the coordinate plane, we get the following:\n\n![](images/a8/a8cd951c66c67b8f28b791011c7553675b3112029d9ebe4b19769127b5e75bd5.png)\n\nThis leads us to the following important fact:\n\n*The graph of any proportional relationship is a straight line that passes through the origin $(0,0)$.*" :tutorial/id #uuid "becbb429-3b12-59c4-8172-aef250c47df9" :tutorial/math-academy-id 1507 :tutorial/title "Introduction"} :step/id #uuid "1aec00f2-ca4a-5296-be84-e7e83d0f585d" :step/math-academy-id 3709 :step/next {:db/id #edb/ref 17592186152982}} {:db/id #edb/ref 17592186153199 :step/content {:db/id #edb/ref 17592186153339 :tutorial/content "When there is a proportional relationship between $x$ and $y,$ we can express this using the **proportionality symbol** $\\propto,$ as follows:\n\n$$\ny \\propto x\n$$\n\nNote that the following statements are all equivalent:\n\n- $y = kx$\n\n- $y$ **varies directly** with $x$\n\n- $y$ is **directly proportional** to $x$\n\n- $y \\propto x$" :tutorial/id #uuid "503f0382-0b82-583d-898a-bc1dd1aa02d1" :tutorial/math-academy-id 1508 :tutorial/title "Alternative Notations and Terminology"} :step/id #uuid "4dc61433-6c56-58c8-9a95-4614aa5f1bf9" :step/math-academy-id 3712 :step/next {:db/id #edb/ref 17592186153200}} {:db/id #edb/ref 17592186153200 :step/content {:db/id #edb/ref 17592186152241 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151799 :question/id #uuid "1a5e8fef-3361-5d24-9abd-d0474a2cd3ae" :question/math-academy-id "e-1141"} :knowledge-point/id #uuid "5462223e-a206-572a-846a-378621922011" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050613}] :knowledge-point/questions [{:db/id #edb/ref 17592186152609} {:db/id #edb/ref 17592186152868} {:db/id #edb/ref 17592186498511} {:db/id #edb/ref 17592186498547} {:db/id #edb/ref 17592186520477}] :knowledge-point/title "Finding a Direct Variation Equation from a Graph"} :step/id #uuid "e8203c67-93c8-55d2-b5fd-7a7003ecaf79" :step/math-academy-id 3715}] :activity/title "Understanding Proportional Relationships Using Graphs" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186152310}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186520589} :activity/id #uuid "00211bb8-0554-55a4-bda1-bdbf208e3686" :activity/scope {:db/id #edb/ref 17592186048993 :topic/id #uuid "d1b21eb7-a767-5b1f-8e65-566b74a26f39" :topic/math-academy-id 2552} :activity/steps [{:db/id #edb/ref 17592186520541 :step/content {:db/id #edb/ref 17592186520499 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a00323d-f93f-5304-838e-9a2020861786" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\frac{5}{2}$ centimeters per month" :db/id #edb/ref 17592186520051} {:answer/id #uuid "2f593f76-c5a7-50c8-9b17-9fcace1dabaf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\frac{6}{5}$ centimeters per month" :db/id #edb/ref 17592186520063} {:answer/id #uuid "3da9c120-60eb-589b-a9aa-5cbfc90e5257" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ centimeters per month" :db/id #edb/ref 17592186520078} {:answer/id #uuid "9340f66f-9d6d-54b6-808d-a0bf629f8943" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\frac{7}{3}$ centimeters per month" :db/id #edb/ref 17592186520202} {:answer/id #uuid "b27a859b-f70f-5a32-ba4f-97460ef30f9d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\frac{2}{5}$ centimeters per month" :db/id #edb/ref 17592186520239}] :answer-field/correct {:db/id #edb/ref 17592186520051} :answer-field/id #uuid "0752f685-6167-5321-9403-2b36429faec1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186520369}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d5876a38-e0d7-5724-8ef9-3dbbcd7f0e46" :question/math-academy-id "q-163005" :question/problem "![](images/4d/4df58d2f35cc69e8a567a65bc64f24e5da8820e1be5d229979b08fe2c3d1cd8f.png)\n\nThe graph above shows a proportional relationship between the time $x$ (in months) since Mary's baby was born and the number $y$ of centimeters he has grown. What is the baby's unit rate of growth?" :question/worked-solution "The baby's unit rate of growth in centimeters per month is simply the constant of proportionality for the given proportional relationship.\n\nTo compute the constant of proportionality, we first need to choose a point $(x,y)$ on the graph. Here, let's choose the point $(2,5).$\n\n![](images/5b/5bbc6c5b4188c5db894ceebe7d347c901afb428d5d102864a90218ef53420a60.png)\n\nNow, we can find the constant of proportionality by computing the ratio of the $y$-coordinate to the $x$-coordinate, as follows:\n\n$$\nk=\\frac{y}{x}=\\frac{5}{2}\n$$\n\nTherefore, Mary's baby's unit rate of growth is $\\frac{5}{2}$ centimeters per month."} :step/id #uuid "3d3d364f-3ab5-5714-9335-f8bd97fe1c65"} {:db/id #edb/ref 17592186520548 :step/content {:db/id #edb/ref 17592186520477 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dd7620a-2e0a-5048-84e8-580582cc4050" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{3}{2}x" :db/id #edb/ref 17592186520060} {:answer/id #uuid "5c1e780f-72c4-55fe-86bf-f63cbb6742d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{4}x" :db/id #edb/ref 17592186520134} {:answer/id #uuid "67143172-5c75-57e2-9507-5548168537b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{2}{3}x" :db/id #edb/ref 17592186520148} {:answer/id #uuid "8052a59d-160b-523d-93b3-2be518aa22c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{3}x" :db/id #edb/ref 17592186520175} {:answer/id #uuid "faaf0326-bcd6-5fdb-9b82-fb8c891b09c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=3x" :db/id #edb/ref 17592186520359}] :answer-field/correct {:db/id #edb/ref 17592186520175} :answer-field/id #uuid "df70821b-247b-5776-8c45-aa8d80611751" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186520434}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "817c5709-21ea-5c46-9e06-c595f5917c73" :question/math-academy-id "q-68204" :question/problem "![](images/1a/1a5313995e9740a61b455a9c368aca6223a80c8bbea659f06ec2a63c8260747b.png)\n\nKaren decides to walk from her workplace to her house. There is a proportional relationship between the distance $x$ (in kilometers) she covers and the time $y$ (in hours) it takes her to cover that distance.\n\nWhat is the equation for the relationship between $x$ and $y$ shown in the graph above?" :question/worked-solution "Every proportional relationship takes the form $y=kx,$ where $k$ is the constant of proportionality.\n\nTo compute the constant of proportionality, we first need to choose a point $(x,y)$ on the graph. Here, let's choose the point $(3,1).$\n\n![](images/be/bec01f9dc01b340075f09dd459571fe8199116f18a6ab912eb958c7a6f9ee4f2.png)\n\nNow, we can find the constant of proportionality by computing the ratio of the $y$-coordinate to the $x$-coordinate, as follows:\n\n$$\nk=\\frac{y}{x}=\\frac{1}{3}\n$$\n\nTherefore, the equation is\n\n$$\ny=\\frac{1}{3}x.\n$$"} :step/id #uuid "4bbe34c0-1b18-5560-8226-a31de4f5850c" :step/next {:db/id #edb/ref 17592186520541}} {:db/id #edb/ref 17592186520589 :step/content {:db/id #edb/ref 17592186152609 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4acc6262-ca31-5c5f-ac0d-1ae4e682b14c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{x}{4}" :db/id #edb/ref 17592186520105} {:answer/id #uuid "a9466f4c-419a-5b13-82db-f0fde5671554" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2x" :db/id #edb/ref 17592186520223} {:answer/id #uuid "cf4e5346-6676-5c14-868d-660ee8405b0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{x}{2}" :db/id #edb/ref 17592186520283} {:answer/id #uuid "e5402f53-c6f1-5c01-821d-49754b58179c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=8x" :db/id #edb/ref 17592186520325} {:answer/id #uuid "f98ff76b-d478-5a9c-a544-9213463eb301" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=4x" :db/id #edb/ref 17592186520356}] :answer-field/correct {:db/id #edb/ref 17592186520356} :answer-field/id #uuid "8bcc8a79-2736-57a1-bfc2-56ec9e252477" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186150161}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "878ffbea-7b4e-53ce-97b4-dbbab3af9a6a" :question/math-academy-id "q-51829" :question/problem "![](images/81/815e7943ff4f01bf9a89cd6bb1214cf9266c8ae528cfd53e05a7ac56cf1e0e74.png)\n\nThe graph above shows a direct variation between the variables $y$ and $x.$ Which equation describes the relationship between the variables?" :question/worked-solution "Since $y$ varies directly with $x,$ we use the equation\n\n$$\ny=kx.\n$$\n\nNext, we notice there is a point on the graph with $y=8$ and $x=2.$ So, we substitute this data into the equation to find $k:$\n\n$$\n\\begin{aligned}8 & =k\\cdot 2 \\\\ \\frac{8}{2} & =k \\\\ 4 & =k\\end{aligned}\n$$\n\nTherefore, the direct variation equation is given by\n\n$$\ny=4x.\n$$"} :step/id #uuid "96b62d68-1935-5cf6-bfed-287d64594d22" :step/next {:db/id #edb/ref 17592186520548}}] :activity/title "Understanding Proportional Relationships Using Graphs" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186519986}]}
