#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186153196} :activity/id #uuid "a9e96cf9-9aad-5b83-81b1-b9488d698494" :activity/scope {:db/id #edb/ref 17592186048993 :topic/id #uuid "d1b21eb7-a767-5b1f-8e65-566b74a26f39" :topic/math-academy-id 2552} :activity/steps [{:db/id #edb/ref 17592186152982 :step/content {:db/id #edb/ref 17592186152110 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151920 :question/id #uuid "42e81da3-7ea4-5b58-9163-3057df064c21" :question/math-academy-id "e-4460"} :knowledge-point/id #uuid "32650c78-38d5-5530-991d-bf0b8f2198cb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049405} {:db/id #edb/ref 17592186050948}] :knowledge-point/questions [{:db/id #edb/ref 17592186152654} {:db/id #edb/ref 17592186152655} {:db/id #edb/ref 17592186498546} {:db/id #edb/ref 17592186498595}] :knowledge-point/title "Identifying Graphs of Proportional Relationships"} :step/id #uuid "3e1f0c98-c1f6-59bc-8387-51338e8475ab" :step/math-academy-id 16271 :step/next {:db/id #edb/ref 17592186152983}} {:db/id #edb/ref 17592186152983 :step/content {:db/id #edb/ref 17592186152111 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151921 :question/id #uuid "06bdefa1-8b40-5777-9ca0-9f257834833d" :question/math-academy-id "e-4461"} :knowledge-point/id #uuid "d9c2ec6a-e04a-5e97-a91c-3a232e9aa29d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050195} {:db/id #edb/ref 17592186050249}] :knowledge-point/questions [{:db/id #edb/ref 17592186152644} {:db/id #edb/ref 17592186152645} {:db/id #edb/ref 17592186498491} {:db/id #edb/ref 17592186498526}] :knowledge-point/title "Computing a Constant of Proportionality or Unit Rate"} :step/id #uuid "65b0ae62-9c2f-5d32-a1a1-ac39767edaa8" :step/math-academy-id 16272 :step/next {:db/id #edb/ref 17592186153199}} {:db/id #edb/ref 17592186153196 :step/content {:db/id #edb/ref 17592186153338 :tutorial/content "How does a proportional relationship look when we plot it in the $(x,y)$ plane?\n\nTo answer this, let's consider the following proportional relationship:\n\n$$\ny = 2x\n$$\n\nTo plot a graph, we first need a table of values. \n\n| $x$ | $y$ |\n| --- | --- |\n| $0$ |  |\n| $1$ |  |\n| $2$ |  |\n| $3$ |  |\n\nFilling in the $y$-values using the equation $y = 2x,$ we get the following:\n\n| $x$ | $y$ |\n| --- | --- |\n| $0$ | $0$ |\n| $1$ | $2$ |\n| $2$ | $4$ |\n| $3$ | $6$ |\n\nSo, we have the following $(x,y)$ coordinates:\n\n$$\n(0,0), \\quad (1,2),  \\quad (2,4),  \\quad (3,6)\n$$\n\nIf we plot these points in the coordinate plane, we get the following:\n\n![](images/a8/a8cd951c66c67b8f28b791011c7553675b3112029d9ebe4b19769127b5e75bd5.png)\n\nThis leads us to the following important fact:\n\n*The graph of any proportional relationship is a straight line that passes through the origin $(0,0)$.*" :tutorial/id #uuid "becbb429-3b12-59c4-8172-aef250c47df9" :tutorial/math-academy-id 1507 :tutorial/title "Introduction"} :step/id #uuid "1aec00f2-ca4a-5296-be84-e7e83d0f585d" :step/math-academy-id 3709 :step/next {:db/id #edb/ref 17592186152982}} {:db/id #edb/ref 17592186153199 :step/content {:db/id #edb/ref 17592186153339 :tutorial/content "When there is a proportional relationship between $x$ and $y,$ we can express this using the **proportionality symbol** $\\propto,$ as follows:\n\n$$\ny \\propto x\n$$\n\nNote that the following statements are all equivalent:\n\n- $y = kx$\n\n- $y$ **varies directly** with $x$\n\n- $y$ is **directly proportional** to $x$\n\n- $y \\propto x$" :tutorial/id #uuid "503f0382-0b82-583d-898a-bc1dd1aa02d1" :tutorial/math-academy-id 1508 :tutorial/title "Alternative Notations and Terminology"} :step/id #uuid "4dc61433-6c56-58c8-9a95-4614aa5f1bf9" :step/math-academy-id 3712 :step/next {:db/id #edb/ref 17592186153200}} {:db/id #edb/ref 17592186153200 :step/content {:db/id #edb/ref 17592186152241 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151799 :question/id #uuid "1a5e8fef-3361-5d24-9abd-d0474a2cd3ae" :question/math-academy-id "e-1141"} :knowledge-point/id #uuid "5462223e-a206-572a-846a-378621922011" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050613}] :knowledge-point/questions [{:db/id #edb/ref 17592186152609} {:db/id #edb/ref 17592186152868} {:db/id #edb/ref 17592186498511} {:db/id #edb/ref 17592186498547}] :knowledge-point/title "Finding a Direct Variation Equation from a Graph"} :step/id #uuid "e8203c67-93c8-55d2-b5fd-7a7003ecaf79" :step/math-academy-id 3715}] :activity/title "Understanding Proportional Relationships Using Graphs" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186152310}]}
