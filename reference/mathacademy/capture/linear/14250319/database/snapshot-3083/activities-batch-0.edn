186045498} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186570418} {:answer/id #uuid "d6c6fba4-5c9b-57de-b842-54760231e736" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186570499} {:answer/id #uuid "ed5bc282-4f39-5640-8eff-7065cfd84e70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186570538} {:answer/id #uuid "f07c0ec9-664a-551b-8555-328ef64c429c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186570546}] :answer-field/correct {:db/id #edb/ref 17592186570418} :answer-field/id #uuid "2add5a83-e07a-5273-8ef3-d682bebc9cc1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186570596}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f70dd11d-74b0-578f-b3fa-cdba24eab4d5" :question/math-academy-id "q-51499" :question/problem "What is the root of the function $f(x)=\\frac{2x}{5}-3?$" :question/worked-solution "The roots are the solutions to the equation $f(x)=0,$ which we solve as follows:\n\n$$\n\\begin{aligned}f(x) & =0 \\\\ \\frac{2x}{5}-3 & =0 \\\\ \\frac{2x}{5} & =3 \\\\ 2x & =15 \\\\ x & =\\frac{15}{2}\\end{aligned}\n$$\n\nTherefore, the function has the single root $x=\\frac{15}{2}.$"} :step/id #uuid "bca15171-2022-59fa-87ec-9587115d9a5d" :step/next {:db/id #edb/ref 17592186570834}}] :activity/title "The Roots of a Function" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186570119}]}
