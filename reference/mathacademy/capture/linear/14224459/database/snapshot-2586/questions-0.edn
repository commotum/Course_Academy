#{[{:db/id #edb/ref 17592186138698 :knowledge-point/_questions [{:db/id #edb/ref 17592186138388 :knowledge-point/id #uuid "e99cabd4-b713-50e1-83be-f8571b575803" :knowledge-point/title "Finding Bounds When Rounding to a Decimal Place"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16fac51a-9457-5261-b22b-f89d79af0f70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.09\\,\\text{m}\\le h<2.11\\,\\text{m}" :db/id #edb/ref 17592186538282} {:answer/id #uuid "2e710c8a-03cf-5964-8f07-e6abecb91318" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.0\\,\\text{m}\\le h<2.2\\,\\text{m}" :db/id #edb/ref 17592186538329} {:answer/id #uuid "4c4403cc-a3af-50f8-91d2-7e006f9ca2bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.095\\,\\text{m}\\le h<2.105\\,\\text{m}" :db/id #edb/ref 17592186538391} {:answer/id #uuid "61ad7ba7-c6e6-5a77-88a2-8f331b4e6cc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.05\\,\\text{m}\\le h<2.15\\,\\text{m}" :db/id #edb/ref 17592186538448} {:answer/id #uuid "de59b963-7146-502e-8106-8eeb734cdb88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.1\\,\\text{m}\\le h<3.1\\,\\text{m}" :db/id #edb/ref 17592186538742}] :answer-field/correct {:answer/id #uuid "61ad7ba7-c6e6-5a77-88a2-8f331b4e6cc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.05\\,\\text{m}\\le h<2.15\\,\\text{m}" :db/id #edb/ref 17592186538448} :answer-field/id #uuid "7b01a9c5-17a4-5cf7-9eed-2c1fcee823f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186135427}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "66b93aa5-a873-551c-b039-7debf6d7af79" :question/math-academy-id "q-154080" :question/problem "The shoulder height of a moose $h$ measures $2.1\\,\\text{m}$ to the nearest tenth of a meter. Determine the upper and lower bounds of this measurement." :question/worked-solution "Our measurement is given to the nearest $0.1\\,\\text{m}.$ So, the greatest possible error of this measurement is\n\n$$\n\\frac{0.1\\,\\text{m}}{2}=0.05\\,\\text{m}.\n$$\n\nTherefore, we can calculate the lower and upper bounds of this measurement as follows:\n\n$$\n\\begin{aligned}\\text{lower bound} & =2.1\\,\\text{m}-0.05\\,\\text{m} \\\\  & =2.05\\,\\text{m} \\\\ \\text{upper bound} & =2.1\\,\\text{m}+0.05\\,\\text{m} \\\\  & =2.15\\,\\text{m}\\end{aligned}\n$$\n\nSince the exact value of $h$ lies between the lower and upper bound, we conclude that\n\n$$\n2.05\\,\\text{m}\\le h<2.15\\,\\text{m}.\n$$"}] [{:db/id #edb/ref 17592186138737 :knowledge-point/_questions [{:db/id #edb/ref 17592186138389 :knowledge-point/id #uuid "29217571-4597-5bbe-aecd-0d9a1d1aa1c1" :knowledge-point/title "Bounding Areas and Volumes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2acee517-33dc-5f55-a0b3-f02e6c6263fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "29" :db/id #edb/ref 17592186538323}] :answer-field/correct {:answer/id #uuid "2acee517-33dc-5f55-a0b3-f02e6c6263fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "29" :db/id #edb/ref 17592186538323} :answer-field/id #uuid "62968f0c-410e-58a3-b547-3822b3d5961c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186135493}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a0cc887e-fde1-561f-a2a2-0e9220220d6b" :question/math-academy-id "q-210524" :question/problem "The dimensions of a rectangular floor are $12\\,\\text{m}\\times 3\\,\\text{m}$, where each dimension is measured to the nearest $1\\,\\text{m}.$ Rounded to the nearest square meter, what is the smallest possible area of the floor?\n\nTo the nearest square meter, the smallest possible area is\n{{field-1}}${\\text{m}}^{2}.$" :question/requires-calculator true :question/worked-solution "Each dimension is given to the nearest $1\\,\\text{m}.$ So, the greatest possible error of these measurements is\n\n$$\n\\frac{1\\,\\text{m}}{2}=0.5\\,\\text{m}.\n$$\n\nWe wish to find the *smallest* possible area of the container. Therefore, we require the *lower bound* of each dimension.\n\nThe lower bounds for each dimension are as follows:\n\n$$\n\\begin{aligned} & 12\\,\\text{m}-0.5\\,\\text{m}=11.5\\,\\text{m} \\\\  & 3\\,\\text{m}-0.5\\,\\text{m}=2.5\\,\\text{m}\\end{aligned}\n$$\n\nSo, the smallest possible area of the container is\n\n$$\n\\begin{aligned}A & =11.5\\,\\text{m}\\times 2.5\\,\\text{m} \\\\  & =28.75\\,{\\text{m}}^{2} \\\\  & ≈29\\,{\\text{m}}^{2}\\end{aligned}\n$$\n\nrounded to the nearest square meter."}] [{:db/id #edb/ref 17592186539011 :knowledge-point/_questions [{:db/id #edb/ref 17592186138389 :knowledge-point/id #uuid "29217571-4597-5bbe-aecd-0d9a1d1aa1c1" :knowledge-point/title "Bounding Areas and Volumes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "255bade8-0a89-5de2-8a24-9fd1e2100b17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12.3\\,{\\text{m}}^{3}" :db/id #edb/ref 17592186538308} {:answer/id #uuid "31e67d7e-4e60-5f06-8489-9ee7a57c5092" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12.7\\,{\\text{m}}^{3}" :db/id #edb/ref 17592186538335} {:answer/id #uuid "995c6b46-9527-5d81-9c6e-1f7397ab9bcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14.2\\,{\\text{m}}^{3}" :db/id #edb/ref 17592186538593} {:answer/id #uuid "a64f0aa8-5dbd-5dd3-ae18-7c76124f8c7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13.0\\,{\\text{m}}^{3}" :db/id #edb/ref 17592186538631} {:answer/id #uuid "b6fd67f7-1c22-5e81-be9b-2698dfa44075" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13.5\\,{\\text{m}}^{3}" :db/id #edb/ref 17592186538659}] :answer-field/correct {:answer/id #uuid "a64f0aa8-5dbd-5dd3-ae18-7c76124f8c7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13.0\\,{\\text{m}}^{3}" :db/id #edb/ref 17592186538631} :answer-field/id #uuid "278391dd-df9b-5ab8-b856-03ca04c5de44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538823}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cc1f868e-acd2-53b5-a61f-6b065116ee9a" :question/math-academy-id "q-46386" :question/problem "The dimensions of a cubic water tank are $2.4\\,\\text{m}\\times 2.4\\,\\text{m}\\times 2.4\\,\\text{m},$  where each dimension is measured to the nearest $0.1\\,\\text{m}.$ Rounded to the nearest tenth of a cubic meter, what is the smallest possible volume of the tank?" :question/worked-solution "Each dimension is given to the nearest $0.1\\,\\text{m}.$ So, the greatest possible error of these measurements is\n\n$$\n\\frac{0.1\\,\\text{m}}{2}=0.05\\,\\text{m}.\n$$\n\nWe wish to find the *smallest* possible volume of the tank. Therefore, we require the *lower bound* of each dimension.\n\nThe lower bounds for each dimension are as follows:\n\n$$\n\\begin{aligned} & 2.4\\,\\text{m}-0.05\\,\\text{m}=2.35\\,\\text{m} \\\\  & 2.4\\,\\text{m}-0.05\\,\\text{m}=2.35\\,\\text{m} \\\\  & 2.4\\,\\text{m}-0.05\\,\\text{m}=2.35\\,\\text{m}\\end{aligned}\n$$\n\nSo, the smallest possible volume of the tank is\n\n$$\n\\begin{aligned}V & =2.35\\,\\text{m}\\times 2.35\\,\\text{m}\\times 2.35\\,\\text{m} \\\\  & =12.977\\,875\\,{\\text{m}}^{3} \\\\  & ≈13.0\\,{\\text{m}}^{3},\\end{aligned}\n$$\n\nrounded to the nearest tenth of a cubic meter."}]}
