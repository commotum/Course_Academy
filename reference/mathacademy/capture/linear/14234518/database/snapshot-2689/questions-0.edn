#{[{:db/id #edb/ref 17592186096588 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186096779 :knowledge-point/id #uuid "15868ae6-7843-5ae2-9fce-4d7b662f6763" :knowledge-point/title "Finding the Volume of a Sphere Given Its Radius or Diameter"}] :question/id #uuid "012ce1ef-e254-5e9c-992b-e32d1e7c7043" :question/math-academy-id "e-9000" :question/problem "What is the volume of a sphere whose diameter is $18 \\:\\textrm{cm}?$" :question/worked-solution "We can find the volume of a sphere using the formula\n\n$$\nV = \\dfrac 4 3 \\pi r^3 ,\n$$\n\nwhere $r$ is the radius of the sphere.\n\nSubstituting $r=\\dfrac{18}{2}=9\\:\\textrm{cm}$ into the formula, we obtain\n\n$$\nV = \\dfrac 4 3 \\pi \\left(9\\right)^3 \n \t\t= 972\\pi \\:\\textrm{cm}^3.\n$$"}] [{:db/id #edb/ref 17592186096589 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186096780 :knowledge-point/id #uuid "7c5c224a-0c47-548b-a66f-101b03f6a4e2" :knowledge-point/title "Finding the Radius or Diameter of a Sphere Given Its Volume"}] :question/id #uuid "9f6bebf7-6276-5de9-8162-ea15a831f246" :question/math-academy-id "e-9001" :question/problem "What is the radius of a sphere whose volume is $36\\pi\\:\\textrm{in}^3.$\n\n![](images/99/99bb0ea67859fbd109442fcf698427ea43452087b4523b7202a760a2a8b27052.png)" :question/worked-solution "We can find the volume of a sphere using the formula\n\n$$\nV = \\dfrac 4 3 \\pi r^3 ,\n$$\n\nwhere $r$ is the radius of the sphere.\n\nSubstituting $V=36\\pi\\:\\textrm{in}^3$ into the formula, we get\n\n$$\n\\begin{aligned}V & =\\frac{4}{3}\\pi {r}^{3} \\\\ 36\\pi  & =\\frac{4}{3}\\pi {r}^{3} \\\\ 36\\pi \\cdot \\frac{3}{4\\pi } & ={r}^{3} \\\\ {r}^{3} & =27.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nr = \\sqrt[3]{27} = 3\\:\\textrm{in}.\n$$"}] [{:db/id #edb/ref 17592186555790 :knowledge-point/_questions [{:db/id #edb/ref 17592186096779 :knowledge-point/id #uuid "15868ae6-7843-5ae2-9fce-4d7b662f6763" :knowledge-point/title "Finding the Volume of a Sphere Given Its Radius or Diameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11acb6a1-23a6-52fc-a710-b432292606ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{64}{3}\\pi \\,{\\text{mm}}^{3}" :db/id #edb/ref 17592186555033} {:answer/id #uuid "74df0648-bf4f-572c-a54d-d239fb520436" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{256}{3}\\pi \\,{\\text{mm}}^{3}" :db/id #edb/ref 17592186555264} {:answer/id #uuid "95d19992-6d65-5252-a3b7-2b2a7b7164cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{128}{3}\\pi \\,{\\text{mm}}^{3}" :db/id #edb/ref 17592186555358} {:answer/id #uuid "98861c06-a026-5c97-9b2c-712f91cbc5d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{32}{3}\\pi \\,{\\text{mm}}^{3}" :db/id #edb/ref 17592186555366} {:answer/id #uuid "ff43e770-c0bf-5e18-a186-591a4d969f91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{512}{3}\\pi \\,{\\text{mm}}^{3}" :db/id #edb/ref 17592186555637}] :answer-field/correct {:answer/id #uuid "74df0648-bf4f-572c-a54d-d239fb520436" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{256}{3}\\pi \\,{\\text{mm}}^{3}" :db/id #edb/ref 17592186555264} :answer-field/id #uuid "ad2fc1cc-a316-5e6d-8bc2-452c3e6b5a80" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555724}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "38d0237e-b5b0-553b-9c09-746f0f126714" :question/math-academy-id "q-118335" :question/problem "What is the volume of a sphere whose diameter is $8\\,\\text{mm}?$" :question/worked-solution "We can find the volume of a sphere using the formula\n\n$$\nV=\\frac{4}{3}\\pi {r}^{3},\n$$\n\nwhere $r$ is the radius of the sphere.\n\nSubstituting $r=\\frac{8}{2}=4\\,\\text{mm}$ into the formula, we obtain\n\n$$\nV=\\frac{4}{3}\\pi \\cdot {4}^{3}=\\frac{256}{3}\\pi \\,{\\text{mm}}^{3}.\n$$"}] [{:db/id #edb/ref 17592186555814 :knowledge-point/_questions [{:db/id #edb/ref 17592186096779 :knowledge-point/id #uuid "15868ae6-7843-5ae2-9fce-4d7b662f6763" :knowledge-point/title "Finding the Volume of a Sphere Given Its Radius or Diameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "099c1656-84c7-5df0-821f-f75cf5784e5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\pi \\,{\\text{in}}^{3}" :db/id #edb/ref 17592186555017} {:answer/id #uuid "686c604d-c563-5efa-b9cc-180726d509c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi \\,{\\text{in}}^{3}" :db/id #edb/ref 17592186555235} {:answer/id #uuid "6c38ebb2-1986-51cf-b7c3-2fc478c0f7ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\pi \\,{\\text{in}}^{3}" :db/id #edb/ref 17592186555246} {:answer/id #uuid "827ceaff-3ce7-524d-8e5c-0f9eac687cba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\pi \\,{\\text{in}}^{3}" :db/id #edb/ref 17592186555300} {:answer/id #uuid "9321fce5-0af2-5f6c-afe1-f484cc91d30a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,{\\text{in}}^{3}" :db/id #edb/ref 17592186555346}] :answer-field/correct {:answer/id #uuid "827ceaff-3ce7-524d-8e5c-0f9eac687cba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\pi \\,{\\text{in}}^{3}" :db/id #edb/ref 17592186555300} :answer-field/id #uuid "3a96f431-bd90-5911-bb0a-f6f6464b3f82" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 175921865