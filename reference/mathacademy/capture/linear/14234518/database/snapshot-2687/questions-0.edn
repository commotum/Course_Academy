#{[{:db/id #edb/ref 17592186096588 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186096779 :knowledge-point/id #uuid "15868ae6-7843-5ae2-9fce-4d7b662f6763" :knowledge-point/title "Finding the Volume of a Sphere Given Its Radius or Diameter"}] :question/id #uuid "012ce1ef-e254-5e9c-992b-e32d1e7c7043" :question/math-academy-id "e-9000" :question/problem "What is the volume of a sphere whose diameter is $18 \\:\\textrm{cm}$?" :question/worked-solution "We can find the volume of a sphere using the formula\n\n$$\nV = \\dfrac 4 3 \\pi r^3\n$$\n\nwhere $r$ is the radius of the sphere.\n\nSubstituting\n\n$$\nr=\\dfrac{18}{2}=9\\:\\textrm{cm}\n$$\n\ninto the formula, we obtain\n\n$$\nV = \\dfrac 4 3 \\pi \\left(9\\right)^3 = 972\\pi \\:\\textrm{cm}^3\n$$"}] [{:db/id #edb/ref 17592186096589 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186096780 :knowledge-point/id #uuid "7c5c224a-0c47-548b-a66f-101b03f6a4e2" :knowledge-point/title "Finding the Radius or Diameter of a Sphere Given Its Volume"}] :question/id #uuid "9f6bebf7-6276-5de9-8162-ea15a831f246" :question/math-academy-id "e-9001" :question/problem "What is the radius of a sphere whose volume is $36\\pi\\:\\textrm{in}^3$.\n\n![](images/99/99bb0ea67859fbd109442fcf698427ea43452087b4523b7202a760a2a8b27052.png)" :question/worked-solution "We can find the volume of a sphere using the formula\n\n$$\nV = \\dfrac 4 3 \\pi r^3\n$$\n\nwhere $r$ is the radius of the sphere.\n\nSubstituting\n\n$$\nV=36\\pi\\:\\textrm{in}^3\n$$\n\ninto the formula, we get\n\n$$\n\\begin{aligned}\nV &= \\frac{4}{3}πr^{3} \\\\\n36π &= \\frac{4}{3}πr^{3} \\\\\n36π \\cdot \\frac{3}{4π} &= r^{3} \\\\\nr^{3} &= 27\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\nr = \\sqrt[3]{27} = 3\\:\\textrm{in}\n$$"}] [{:db/id #edb/ref 17592186097223 :knowledge-point/_questions [{:db/id #edb/ref 17592186096780 :knowledge-point/id #uuid "7c5c224a-0c47-548b-a66f-101b03f6a4e2" :knowledge-point/title "Finding the Radius or Diameter of a Sphere Given Its Volume"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9266655-4698-5ee5-820a-fb80dcac9c9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt[3]{30}cm" :db/id #edb/ref 17592186095268} {:answer/id #uuid "0e6fb09a-7644-5cfa-a46f-adf49368a2d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt[3]{20}cm" :db/id #edb/ref 17592186095269} {:answer/id #uuid "1aff3e99-7c9a-5d59-a1c2-cc5bd493e9d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{30}cm" :db/id #edb/ref 17592186095270} {:answer/id #uuid "591dbc31-d757-59fb-9bb8-8f991184a252" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{30}cm" :db/id #edb/ref 17592186095271} {:answer/id #uuid "5ef522a1-0775-52d6-826e-a4a83a93e252" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt[3]{6}cm" :db/id #edb/ref 17592186095272}] :answer-field/id #uuid "b209a21d-dff4-5944-8427-d75fa437d847" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095267}] :question/id #uuid "91958ce6-c301-564b-89d6-6edfb21cb5a6" :question/math-academy-id "q-32616" :question/problem "![](images/26/26b1e5acba63b8ee11d35e12bf0c8fd6944b7a466c9eab258ef36f6429e8ec0a.png)\n\nWhat is the radius of a sphere whose volume is $320πcm^{3}$?\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true}]}
