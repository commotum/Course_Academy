#{[{:db/id #edb/ref 17592186235374 :knowledge-point/_questions [{:db/id #edb/ref 17592186068910 :knowledge-point/id #uuid "76450310-bc86-5f3b-9bb8-82206d89c627" :knowledge-point/title "Evaluating Left and Right Limits at an Interior Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d783a990-4a05-579a-a64a-71bc47c77d88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186234882}] :answer-field/correct {:answer/id #uuid "d783a990-4a05-579a-a64a-71bc47c77d88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186234882} :answer-field/id #uuid "292b354f-5949-5559-bb1f-14b8613b9f8f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235014} {:answer-field/choices [{:answer/id #uuid "6422d1d5-fe14-5e79-9cb8-fb5477bfebc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186234701}] :answer-field/correct {:answer/id #uuid "6422d1d5-fe14-5e79-9cb8-fb5477bfebc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186234701} :answer-field/id #uuid "bb1fbde8-7593-54b1-bf69-9329ffc5e89f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235202}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f97091e5-4c8a-5c29-84a6-a20e717682cf" :question/math-academy-id "q-131476" :question/problem "Find ${lim}_{x\\to \\,(-1)^{-}}g(x)$ and ${lim}_{x\\to \\,(-1)^{+}}g(x).$ If a limit does not exist, write \"DNE\" (without the quotation marks).\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        ${lim}_{x\\to \\,(-1)^{-}}g(x)=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                                \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        ${lim}_{x\\to \\,(-1)^{+}}g(x)=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-2}}" :question/worked-solution "As $x$ approaches $-1$ from the left, the function $g(x)$ approaches $2.$ Therefore,\n\n$$\n{lim}_{x\\to \\,(-1)^{-}}g(x)=2.\n$$\n\nLikewise, as $x$ approaches $-1$ from the right, the function $g(x)$ approaches $0.$ Therefore,\n\n$$\n{lim}_{x\\to \\,(-1)^{+}}g(x)=0.\n$$\n\nIn conclusion, we have\n\n$$\n{lim}_{x\\to \\,(-1)^{-}}g(x)=2,\\,{lim}_{x\\to \\,(-1)^{+}}g(x)=0.\n$$"}] [{:db/id #edb/ref 17592186235375 :knowledge-point/_questions [{:db/id #edb/ref 17592186078508 :knowledge-point/id #uuid "5e2b72a2-c486-5a7a-a65e-57e83b78f6cc" :knowledge-point/title "Identifying the Limit at an Interior Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75fe336d-5c33-56b2-bc5d-be427016fb41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "DNE" :db/id #edb/ref 17592186234725}] :answer-field/correct {:answer/id #uuid "75fe336d-5c33-56b2-bc5d-be427016fb41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "DNE" :db/id #edb/ref 17592186234725} :answer-field/id #uuid "392429d6-0f3f-515b-8883-6f99007c67b1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235029}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a23363d4-1539-5b65-9754-68c957b99234" :question/math-academy-id "q-131477" :question/problem "Find ${lim}_{x\\to \\,(-1)}g(x).$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        ${lim}_{x\\to \\,(-1)}g(x)=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}" :question/worked-solution "In part 1, we showed that\n\n$$\n{lim}_{x\\to \\,(-1)^{-}}g(x)=2,\\,{lim}_{x\\to \\,(-1)^{+}}g(x)=0.\n$$\n\nSince ${lim}_{x\\to \\,(-1)^{-}}g(x)\\ne {lim}_{x\\to \\,(-1)^{+}}g(x),$ we conclude that\n\n$$\n{lim}_{x\\to \\,(-1)}g(x)=\\text{DNE}.\n$$"}] [{:db/id #edb/ref 17592186235376 :knowledge-point/_questions [{:db/id #edb/ref 17592186078508 :knowledge-point/id #uuid "5e2b72a2-c486-5a7a-a65e-57e83b78f6cc" :knowledge-point/title "Identifying the Limit at an Interior Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76bbabbc-3019-5d81-8b3f-213da33f8fd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186234728}] :answer-field/correct {:answer/id #uuid "76bbabbc-3019-5d81-8b3f-213da33f8fd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186234728} :answer-field/id #uuid "75165e57-0c4c-57bd-848c-a4f2358f62cf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235107}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1bd1cc7e-1467-5fa9-9364-b08bd7aa89f0" :question/math-academy-id "q-131478" :question/problem "Find ${lim}_{x\\to \\,2}g(x).$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        ${lim}_{x\\to 2}g(x)=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}" :question/worked-solution "From the graph, we see that as we approach $x=2$ from the left, the $y$-value approaches $-1.$ So the left-hand limit is\n\n$$\n{lim}_{x\\to \\,{2}^{-}}g(x)=-1.\n$$\n\nSimilarly, when we approach $x=2$ from the right, the $y$-value again approaches $-1.$ So the right-hand limit is\n\n$$\n{lim}_{x\\to \\,{2}^{+}}g(x)=-1.\n$$\n\n \n\nSince both the left and right-hand limits exist and are equal to $-1,$ we conclude that\n\n \n\n$$\n{lim}_{x\\to \\,2}g(x)=-1.\n$$"}] [{:db/id #edb/ref 17592186235377 :knowledge-point/_questions [{:db/id #edb/ref 17592186124579 :knowledge-point/id #uuid "ea4038bf-34f0-58cc-a7b6-6a4c1890570f" :knowledge-point/title "The Limit at Infinity for an Unbounded Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef5bd10a-79a8-5442-91b9-39af0ff50e08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186234924}] :answer-field/correct {:answer/id #uuid "ef5bd10a-79a8-5442-91b9-39af0ff50e08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186234924} :answer-field/id #uuid "75c5eab3-cb33-52f7-b5a4-b47a28340c0f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235109} {:answer-field/choices [{:answer/id #uuid "c5a0533f-dd5c-5a26-b5b5-9d8465afd965" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186234855}] :answer-field/correct {:answer/id #uuid "c5a0533f-dd5c-5a26-b5b5-9d8465afd965" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186234855} :answer-field/id #uuid "80bd5f62-8b5a-5767-94ef-b34c005d672d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235132}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "47e117ef-6738-5bd8-aeaa-a7a0343ceecf" :question/math-academy-id "q-131479" :question/problem "Find ${lim}_{x\\to -\\infty }g(x)$ and ${lim}_{x\\to \\infty }g(x).$ If a limit does not exist, write \"DNE\" (without the quotation marks).\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        ${lim}_{x\\to -\\infty }g(x)=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                                \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        ${lim}_{x\\to \\infty }g(x)=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-2}}" :question/worked-solution "On the left side of the graph, we see that as the values of $x$ decrease and approach $-\\infty ,$ the graph of the function $g(x)$ moves closer and closer to the horizontal asymptote $y=3.$\n\nConsequently, $g(x)$ approaches the value $3$ as $x$ approaches $-\\infty ,$ and we have\n\n$$\n{lim}_{x\\to -\\infty }g(x)=3.\n$$\n\nOn the right side of the graph, as the values of $x$ increase and approach $\\infty ,$ the graph of the function decrease without bound to $-\\infty .$   Therefore,\n\n$$\n{lim}_{x\\to \\infty }g(x)=-\\infty .\n$$"}] [{:db/id #edb/ref 17592186235378 :knowledge-point/_questions [{:db/id #edb/ref 17592186115326 :knowledge-point/id #uuid "b94d5612-763f-59d8-9a80-7f6e2f18fa6c" :knowledge-point/title "Using the Constant Rule to Compute a Limit Algebraically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c352d39-d527-554d-9b14-6adba59a4088" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186234613}] :answer-field/correct {:answer/id #uuid "2c352d39-d527-554d-9b14-6adba59a4088" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186234613} :answer-field/id #uuid "bc79d7e0-5a0f-5146-ba60-988c17926d11" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235207}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a6ba6327-0941-5856-a970-a0df483bddf5" :question/math-academy-id "q-131480" :question/problem "Given that ${lim}_{x\\to \\,2}Cf(x)=\\frac{4}{3},$ where $C$ is a real constant, what is the value of $C?$\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        $C=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}" :question/worked-solution "From the graph, we see ${lim}_{x\\to \\,2}f(x)=4.$\n\nWe factor the constant out of the limit and evaluate the remaining limit, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}Cf(x) & =\\frac{4}{3} \\\\ C\\cdot {lim}_{x\\to 2}f(x) & =\\frac{4}{3} \\\\ C\\cdot 4 & =\\frac{4}{3} \\\\ C & =\\frac{1}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186235379 :knowledge-point/_questions [{:db/id #edb/ref 17592186124613 :knowledge-point/id #uuid "38e6d549-0d5a-56e3-88b0-0b22dceb2d0d" :knowledge-point/title "Applying the Sum Rule to Compute A Limit Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa3becd3-cf8d-54c6-9963-76a69f204e89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186234806}] :answer-field/correct {:answer/id #uuid "aa3becd3-cf8d-54c6-9963-76a69f204e89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186234806} :answer-field/id #uuid "f14c200e-9c91-5749-9bb3-1645d32282bc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235261}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1547780d-30a4-520c-aff8-9cc9f3435542" :question/math-academy-id "q-131481" :question/problem "Evaluate ${lim}_{x\\to \\,2}(7f(x)+8g(x)-2{x}^{3}).$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        ${lim}_{x\\to \\,2}(7f(x)+8g(x)-2{x}^{3})=$ \n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}" :question/worked-solution "According to the sum and constant multiple rules, we can compute the required limit as follows:\n\n$$\n{lim}_{x\\to \\,2}(7f(x)+8g(x)-2{x}^{3})=7{lim}_{x\\to \\,2}f(x)+8{lim}_{x\\to \\,2}g(x)-2{lim}_{x\\to \\,2}{x}^{3}\n$$\n\n  \n\nThe above equation assumes that ${lim}_{x\\to \\,2}f(x)$ and ${lim}_{x\\to \\,2}g(x)$ both exist.\n\nIn part 5, we found that ${lim}_{x\\to \\,2}f(x)=4,$ and from part 3, we found ${lim}_{x\\to \\,2}g(x)=-1.$ So, we have \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,2}(7f(x)+8g(x)-2{x}^{3}) & =7{lim}_{x\\to \\,2}f(x)+8{lim}_{x\\to \\,2}g(x)-2{lim}_{x\\to \\,2}{x}^{3} \\\\  & =7\\cdot 4+8\\cdot (-1)-2\\cdot {2}^{3} \\\\  & =28-8-16 \\\\  & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186235380 :knowledge-point/_questions [{:db/id #edb/ref 17592186068696 :knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/title "Identifying Points of Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ff24027-3fdc-5274-b661-bd2f4ebfe6b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186234670}] :answer-field/correct {:answer/id #uuid "4ff24027-3fdc-5274-b661-bd2f4ebfe6b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186234670} :answer-field/id #uuid "92af03ee-4c6d-52ee-a1a8-f1828af0e351" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235148}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c961b194-602b-5753-8bf9-ef5e3612c107" :question/math-academy-id "q-131482" :question/problem "What are the points of discontinuity of $f(x)?$\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        The function $f(x)$ is discontinuous at $x=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        ." :question/worked-solution "The point of discontinuity of $f(x)$ is $x=2.$ It is impossible to draw the function in a neighborhood of this point without taking our pencil off of the page."}] [{:db/id #edb/ref 17592186235381 :knowledge-point/_questions [{:db/id #edb/ref 17592186068696 :knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/title "Identifying Points of Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6f759ac-5354-557b-9e19-358bea961914" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186234880}] :answer-field/correct {:answer/id #uuid "d6f759ac-5354-557b-9e19-358bea961914" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186234880} :answer-field/id #uuid "3f1a07be-5651-5b36-a75f-20f4b3e17be3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235034} {:answer-field/choices [{:answer/id #uuid "0cfef3ac-4fb6-5724-ae33-340acf31cc80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186234561}] :answer-field/correct {:answer/id #uuid "0cfef3ac-4fb6-5724-ae33-340acf31cc80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186234561} :answer-field/id #uuid "ff8e9662-b97f-5053-b9e2-6a5f08c8dd0d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235281}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "30c51f0c-7f0a-55e0-9cee-18ad253ce706" :question/math-academy-id "q-131483" :question/problem "**In ascending order**, what are the points of discontinuity of $g(x)?$\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        $g(x)$ is discontinuous at $x=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$\\,$and $x=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-2}}                \n                                    \n                                \n                                    \n                                        \n                                        ." :question/worked-solution "The points of discontinuity of $g(x)$ are $x=-1$ and $x=2.$ It is impossible to draw the function in the neighborhood of these points without taking our pencil off of the page."}]}
