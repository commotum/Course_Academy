#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186139375} :activity/id #uuid "89a1c0b6-a897-5db4-bd62-c855d5db6af2" :activity/scope {:db/id #edb/ref 17592186050363 :topic/id #uuid "42e7a396-f7f5-5ef7-82f9-ae4f6cfc0ca0" :topic/math-academy-id 2233} :activity/steps [{:db/id #edb/ref 17592186139375 :step/content {:db/id #edb/ref 17592186139599 :tutorial/content "We can use unit conversions to convert from one set of units to another.\n\nFor instance, the speed of sound is approximately $0.34$ kilometers per second. What is this in meters per second? We can find out using the following two steps.\n\n** Step 1: Create a conversion formula.**\n\nWe are given the units $\\dfrac{\\textrm{km}}{\\textrm{s}},$ and we want to convert this into $\\dfrac{\\textrm{m}}{\\textrm{s}}.$ To figure out what we need to multiply by, we can set up an equation to help us:\n\n$$\n\\dfrac{\\textrm{km}}{s}\\cdot\\, \\dfrac{?}{?} = \\dfrac{\\textrm{m}}{\\textrm{s}}\n$$\n\nWe want to replace $\\textrm{km}$ with $\\textrm{m}.$ To get rid of $\\textrm{km},$ we can put $\\textrm{km}$ in the denominator so that it cancels out:\n\n$$\n\\require{cancel}\n\\dfrac{\\cancel{\\textrm{km}} }{s}\\cdot \\dfrac{?}{\\cancel{ \\textrm{km} } } = \\dfrac{\\textrm{m}}{\\textrm{s}}\n$$\n\nThen, to introduce $\\textrm{m},$ we can put $\\textrm{m}$ in the numerator:\n\n$$\n\\require{cancel}\n\\dfrac{\\cancel{\\textrm{km}} }{s}\\cdot \\dfrac{\\textrm{m} }{\\cancel{ \\textrm{km} } } = \\dfrac{\\textrm{m}}{\\textrm{s}}\n$$\n\nSo, our conversion formula is\n\n$$\n\\dfrac{\\textrm{km}}{s}\\cdot \\dfrac{\\textrm{m} }{\\textrm{km} } = \\dfrac{\\textrm{m}}{\\textrm{s}}.\n$$\n\n**Step 2: Use the conversion formula.**\n\nNow that we have our conversion formula, we need to determine the correct numbers to use, and apply it.\n\n- The speed that we wish to convert is $0.34 \\, \\dfrac{\\textrm{km}}{\\textrm{s}}.$\n\n- There are $1\\,000$ meters per kilometer.\n\nApplying our conversion formula, we have\n\n$$\n\\begin{aligned}0.34\\,\\frac{\\text{km}}{\\text{s}} & =0.34\\,\\frac{\\text{km}}{\\text{s}}\\cdot 1\\,000\\,\\frac{\\text{m}}{\\text{km}} \\\\  & =(0.34\\cdot 1\\,000)\\,\\frac{\\cancel{\\text{km}}}{\\text{s}}\\cdot \\frac{\\text{m}}{\\cancel{\\text{km}}} \\\\  & =340\\,\\frac{\\text{m}}{\\text{s}}.\\end{aligned}\n$$\n\nThus, the speed of sound is $340$ meters per second." :tutorial/id #uuid "d1f56c71-9cb3-5a5b-881c-bfbad588ca7f" :tutorial/math-academy-id 1404 :tutorial/title "Introduction"} :step/id #uuid "23d7066f-ee02-59e9-ae85-3a1372e71eea" :step/math-academy-id 3049 :step/next {:db/id #edb/ref 17592186139376}} {:db/id #edb/ref 17592186139376 :step/content {:db/id #edb/ref 17592186138442 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138314 :question/id #uuid "638af342-1995-5403-84bd-b6c720cb432d" :question/math-academy-id "e-907"} :knowledge-point/id #uuid "e4b91363-1cac-5495-b29b-c14236bc4de6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049502} {:db/id #edb/ref 17592186049689} {:db/id #edb/ref 17592186050282}] :knowledge-point/questions [{:db/id #edb/ref 17592186138802} {:db/id #edb/ref 17592186139084} {:db/id #edb/ref 17592186516772} {:db/id #edb/ref 17592186516830}] :knowledge-point/title "Performing a Unit Conversion: Converting a Numerator"} :step/id #uuid "48400771-1498-544e-a6cb-80f32c6689d9" :step/math-academy-id 3050 :step/next {:db/id #edb/ref 17592186139377}} {:db/id #edb/ref 17592186139377 :step/content {:db/id #edb/ref 17592186138443 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138315 :question/id #uuid "08aa3547-cb51-5d00-8cb7-3e1a9bd4a695" :question/math-academy-id "e-908"} :knowledge-point/id #uuid "f10e8464-e555-5358-b97f-230933822fa1" :knowledge-point/questions [{:db/id #edb/ref 17592186138798} {:db/id #edb/ref 17592186138799} {:db/id #edb/ref 17592186516803} {:db/id #edb/ref 17592186516809}] :knowledge-point/title "Performing a Unit Conversion: Converting a Denominator"} :step/id #uuid "16237576-82b8-5b51-891e-bf6a4b793259" :step/math-academy-id 3053 :step/next {:db/id #edb/ref 17592186139378}} {:db/id #edb/ref 17592186139378 :step/content {:db/id #edb/ref 17592186138444 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138316 :question/id #uuid "79f9c66b-2e4e-53ad-8146-10a2aa4e730d" :question/math-academy-id "e-909"} :knowledge-point/id #uuid "0b82abac-b8b5-5e9e-bac1-38cc4f4de6c0" :knowledge-point/questions [{:db/id #edb/ref 17592186138800} {:db/id #edb/ref 17592186138828} {:db/id #edb/ref 17592186516861} {:db/id #edb/ref 17592186570698}] :knowledge-point/title "Performing a Unit Conversion: Converting a Numerator and a Denominator"} :step/id #uuid "484759f2-e1e7-5618-9ef3-12349540dbce" :step/math-academy-id 3056}] :activity/title "Converting Between Mixed Units" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186138592}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186570823} :activity/id #uuid "ef420ae4-7719-503c-a864-d39346efd698" :activity/scope {:db/id #edb/ref 17592186050363 :topic/id #uuid "42e7a396-f7f5-5ef7-82f9-ae4f6cfc0ca0" :topic/math-academy-id 2233} :activity/steps [{:db/id #edb/ref 17592186570823 :step/content {:db/id #edb/ref 17592186570698 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fddd4a0-4f7c-55f3-991c-800d86dfbd7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40\\,\\text{km}" :db/id #edb/ref 17592186570206} {:answer/id #uuid "6ed443d5-d3c4-573e-a0a0-2e968d29aec6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "80\\,\\text{km}" :db/id #edb/ref 17592186570321} {:answer/id #uuid "7deb7461-5433-56db-95dd-78442f6e315f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20\\,\\text{km}" :db/id #edb/ref 17592186570345} {:answer/id #uuid "877592ad-d32e-5675-857f-189b5845548a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "100\\,\\text{km}" :db/id #edb/ref 17592186570362} {:answer/id #uuid "946da25e-7b93-5445-8eab-d777e9ef8c7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "60\\,\\text{km}" :db/id #edb/ref 17592186570384}] :answer-field/correct {:db/id #edb/ref 17592186570384} :answer-field/id #uuid "e6520f1e-9ae6-59fe-87c3-d43c3f601aa8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186570685}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0ba5f5a5-9aa0-5b4c-ab5c-6490e52ab690" :question/math-academy-id "q-46125" :question/problem "A car travels at $1\\,000$ meters per minute. In kilometers, how far will the car travel in one hour?" :question/worked-solution "We are given the units $\\frac{\\text{m}}{\\text{min}},$ and we want to convert this into $\\frac{\\text{km}}{\\text{hour}}.$ We're converting two units instead of just one, so we're going to have to multiply by two conversion factors:\n\n$$\n\\frac{\\text{m}}{\\text{min}}\\cdot \\,\\frac{?}{?}\\cdot \\,\\frac{?}{?}=\\frac{\\text{km}}{\\text{hour}}\n$$\n\nOne of the conversion factors should change $\\text{m}$ to $\\text{km}.$\n\n$$\n\\frac{\\cancel{\\text{m}}}{\\text{min}}\\cdot \\frac{\\text{km}}{\\cancel{\\text{m}}}\\cdot \\,\\frac{?}{?}=\\frac{\\text{km}}{\\text{hour}}\n$$\n\nThe other conversion factor should change $\\text{min}$ into $\\text{hour}.$\n\n$$\n\\frac{\\cancel{\\text{m}}}{\\cancel{\\text{min}}}\\cdot \\frac{\\text{km}}{\\cancel{\\text{m}}}\\cdot \\frac{\\cancel{\\text{min}}}{\\text{hour}}=\\frac{\\text{km}}{\\text{hour}}\n$$\n\nSo, our conversion formula is\n\n$$\n\\frac{\\text{m}}{\\text{min}}\\cdot \\frac{\\text{km}}{\\text{m}}\\cdot \\frac{\\text{min}}{\\text{hour}}=\\frac{\\text{km}}{\\text{hour}}.\n$$\n\nNow that we have our conversion formula, we need to determine the correct numbers to use, and apply it.\n\n- The rate given in the problem statement is $1\\,000\\,\\frac{\\text{m}}{\\text{min}}.$\n\n- There are $1\\,000$ meters per kilometer, therefore, there are $\\frac{1}{1\\,000}$ kilometers per meter.\n\n- There are $60$ minutes in one hour.\n\nApplying our conversion formula, we have\n\n$$\n\\begin{aligned}1000\\,\\frac{\\text{m}}{\\text{min}} & =1000\\,\\frac{\\text{m}}{\\text{min}}\\cdot \\frac{1}{1\\,000}\\,\\frac{\\text{km}}{\\text{m}}\\cdot 60\\,\\frac{\\text{min}}{\\text{hour}} \\\\  & =1000\\cdot \\frac{1}{1\\,000}\\cdot 60(\\frac{\\cancel{\\text{m}}}{\\cancel{\\text{min}}}\\cdot \\frac{\\text{km}}{\\cancel{\\text{m}}}\\cdot \\frac{\\cancel{\\text{min}}}{\\text{hour}}) \\\\  & =60\\,\\frac{\\text{km}}{\\text{hour}}.\\end{aligned}\n$$\n\nConsequently, a speed of $1\\,000$ meters per minute is equivalent to $60$ kilometers per hour. Thus, the car will travel $60$ kilometers in one hour."} :step/id #uuid "5c55a2df-38bf-5510-bac1-93d3f0daa4b3" :step/next {:db/id #edb/ref 17592186570864}} {:db/id #edb/ref 17592186570836 :step/content {:db/id #edb/ref 17592186138799 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2215c7f-1708-5157-9abb-894cef5929b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\frac{km}{min}" :db/id #edb/ref 17592186135743} {:answer/id #uuid "e3a096e1-6689-51ac-bc53-c790d26bac06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.2\\frac{km}{min}" :db/id #edb/ref 17592186135744} {:answer/id #uuid "31df004a-a3ed-5955-bce5-b6acc042cbd5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.5\\frac{km}{min}" :db/id #edb/ref 17592186135745} {:answer/id #uuid "5cd4477d-9e72-55a2-92d7-3ffb80fa9a7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20\\frac{km}{min}" :db/id #edb/ref 17592186135746} {:answer/id #uuid "74236084-ad1f-514e-948f-3c515d89674d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\frac{km}{min}" :db/id #edb/ref 17592186135747}] :answer-field/id #uuid "afe6772c-fbe0-563f-a931-dd7005801c12" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186135742}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5e80e844-aeea-5957-8813-6a48149e9acd" :question/math-academy-id "q-46322" :question/problem "The cheetah is considered the fastest land animal. It can achieve a speed of $120$ kilometers per hour. What is this speed in kilometers per minute?\n\n> A calculator is required to answer this question." :question/requires-calculator true} :step/id #uuid "7acf895c-a3e0-53c8-aa06-2cdc7683d477"} {:db/id #edb/ref 17592186570864 :step/content {:db/id #edb/ref 17592186138798 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e08eef7a-81b8-5dc6-8f40-6ffc1cc23a86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "90000kg/min" :db/id #edb/ref 17592186135737} {:answer/id #uuid "239aaa38-36d9-5670-8dc6-88269d983ce7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "600kg/min" :db/id #edb/ref 17592186135738} {:answer/id #uuid "27ba35cc-8875-59d2-8912-653802a64d98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9000kg/min" :db/id #edb/ref 17592186135739} {:answer/id #uuid "3bca59fe-6ac5-56e3-b209-a78c50a41108" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6000kg/min" :db/id #edb/ref 17592186135740} {:answer/id #uuid "59b09fed-9a93-577e-b492-d8cf1819f83a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "900kg/min" :db/id #edb/ref 17592186135741}] :answer-field/id #uuid "d2d10b9c-fa89-5a69-8532-b683a7e3b4d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186135736}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "caebe8e5-ea81-5ade-8b5b-0cc8c14fd9cf" :question/math-academy-id "q-46132" :question/problem "At the start of a launch, a space rocket consumes about $150$ kilograms of fuel per second. How much fuel does it consume per minute?\n\n> A calculator is required to answer this question." :question/requires-calculator true}