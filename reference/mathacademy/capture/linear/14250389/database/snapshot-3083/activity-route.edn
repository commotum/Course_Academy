id #edb/ref 17592186135738} {:answer/id #uuid "27ba35cc-8875-59d2-8912-653802a64d98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9000kg/min" :db/id #edb/ref 17592186135739} {:answer/id #uuid "3bca59fe-6ac5-56e3-b209-a78c50a41108" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6000kg/min" :db/id #edb/ref 17592186135740} {:answer/id #uuid "59b09fed-9a93-577e-b492-d8cf1819f83a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "900kg/min" :db/id #edb/ref 17592186135741}] :answer-field/id #uuid "d2d10b9c-fa89-5a69-8532-b683a7e3b4d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186135736}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "caebe8e5-ea81-5ade-8b5b-0cc8c14fd9cf" :question/math-academy-id "q-46132" :question/problem "At the start of a launch, a space rocket consumes about $150$ kilograms of fuel per second. How much fuel does it consume per minute?\n\n> A calculator is required to answer this question." :question/requires-calculator true} :step/id #uuid "db9d5ebe-41a9-5c9d-9230-ddee2bab7220" :step/next {:db/id #edb/ref 17592186570836}}] :activity/title "Converting Between Mixed Units" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186570118}]}
