#{[{:db/id #edb/ref 17592186068475 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068725 :knowledge-point/id #uuid "f544d0a4-24ce-5078-ad9d-93e733c091e6" :knowledge-point/title "Solving Equations With Integer Solutions"}] :question/id #uuid "fed35802-1128-5cb4-a91b-e98227dcfba8" :question/math-academy-id "e-13966" :question/problem "Solve $2x^2 - 27=5$." :question/worked-solution "First, we isolate the $x^2$ on one side of the equation:\n\n$$\n\\begin{aligned}\n2x^{2} - 27 &= 5 \\\\\n2x^{2} &= 32 \\\\\nx^{2} &= 16\n\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\n\\sqrt{x^{2}} &= \\sqrt{16} \\\\\n\\mid x \\mid &= 4 \\\\\nx &= ± 4\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068476 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068726 :knowledge-point/id #uuid "6c5d24fa-8a65-5c20-bb50-530ca8dcf061" :knowledge-point/title "Solving Equations With Fractional Solutions"}] :question/id #uuid "6145c2d5-5d09-543c-8405-1319277323aa" :question/math-academy-id "e-13968" :question/problem "Solve for $p$ where $4p^2 - 11 = 14$." :question/worked-solution "First, we isolate the $p^2$ on one side of the equation:\n\n$$\n\\begin{aligned}\n4p^{2} - 11 &= 14 \\\\\n4p^{2} &= 25 \\\\\np^{2} &= \\frac{25}{4}\n\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\n\\sqrt{p^{2}} &= \\sqrt{\\frac{25}{4}} \\\\\n\\mid p \\mid &= \\frac{\\sqrt{25}}{\\sqrt{4}} \\\\\n\\mid p \\mid &= \\frac{5}{2} \\\\\np &= ± \\frac{5}{2}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068477 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068727 :knowledge-point/id #uuid "a21c64f2-1b4b-54b3-a8a1-70ca63330e04" :knowledge-point/title "Solving Equations With Radical Solutions"}] :question/id #uuid "9c00e3e1-9337-5380-af51-e7e8c7ae9f48" :question/math-academy-id "e-13970" :question/problem "Find $t$ if $2t^2 = 36$." :question/worked-solution "First, we isolate the $t^2$ on one side of the equation:\n\n$$\n\\begin{aligned} 2t^2 &= 36 \\\\ t^2 &= 18 \\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned} \\sqrt{t^2} &= \\sqrt{18} \\ \\vert t \\vert &= \\sqrt{18} \\ \\vert t \\vert &= \\sqrt{9 \\cdot 2} \\ \\vert t \\vert &= \\sqrt{9} \\cdot \\sqrt{2} \\ \\vert t \\vert &= 3\\sqrt{2} \\\\ t &= \\pm 3\\sqrt{2} \\end{aligned}\n$$"}]}
