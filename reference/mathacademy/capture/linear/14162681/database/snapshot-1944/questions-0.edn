e43f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186487198}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "28369a0e-aba7-51eb-8715-45d32f7550f3" :question/math-academy-id "q-218546" :question/problem "If ${x}^{2}-15=34,$ then $x=${{field-1}}." :question/worked-solution "First, we isolate the ${x}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}{x}^{2}-15 & =34 \\\\ {x}^{2} & =49\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}} & =\\sqrt{49} \\\\ |x| & =7 \\\\ x & =\\pm 7\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186487289 :knowledge-point/_questions [{:db/id #edb/ref 17592186068727 :knowledge-point/id #uuid "a21c64f2-1b4b-54b3-a8a1-70ca63330e04" :knowledge-point/title "Solving Equations With Radical Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "baedb9f1-4e6f-57a3-bfc8-77c1252fcfd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm\\sqrt{5}" :db/id #edb/ref 17592186487004}] :answer-field/correct {:answer/id #uuid "baedb9f1-4e6f-57a3-bfc8-77c1252fcfd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm\\sqrt{5}" :db/id #edb/ref 17592186487004} :answer-field/id #uuid "ac7c4d3b-5e80-5eb1-9dea-f2ec50088d31" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186487237}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "01fa67fa-62b9-56b9-929f-65394494b5c0" :question/math-academy-id "q-218607" :question/problem "Solve the equation $\\frac{{a}^{2}-5}{3}=0.$ Express your final answer in its simplest form.\n\n$a=$\n\n{{field-1}}" :question/worked-solution "First, we isolate the ${a}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}\\frac{{a}^{2}-5}{3} & =0 \\\\ {a}^{2}-5 & =0 \\\\ {a}^{2} & =5\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{a}^{2}} & =\\sqrt{5} \\\\ |a| & =\\sqrt{5} \\\\ a & =\\pm \\sqrt{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186487296 :knowledge-point/_questions [{:db/id #edb/ref 17592186068727 :knowledge-point/id #uuid "a21c64f2-1b4b-54b3-a8a1-70ca63330e04" :knowledge-point/title "Solving Equations With Radical Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27b61df4-5646-56cb-91f4-0bb6021487d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{10}}" :db/id #edb/ref 17592186486671} {:answer/id #uuid "3e71ec7c-99e9-5c6e-be27-a59349af1bde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\frac{1}{\\sqrt{10}}" :db/id #edb/ref 17592186486729} {:answer/id #uuid "7f48a130-1976-51dc-83b9-6407c4ce4f76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\frac{1}{5\\sqrt{2}}" :db/id #edb/ref 17592186486870} {:answer/id #uuid "bc481e31-40b3-5964-9311-39c484a7cb89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\frac{1}{\\sqrt{5}}" :db/id #edb/ref 17592186487007} {:answer/id #uuid "dce8fb30-54cb-57bb-8c12-8f73bf118dd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\frac{1}{2\\sqrt{5}}" :db/id #edb/ref 17592186487074}] :answer-field/correct {:answer/id #uuid "3e71ec7c-99e9-5c6e-be27-a59349af1bde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\frac{1}{\\sqrt{10}}" :db/id #edb/ref 17592186486729} :answer-field/id #uuid "1f6f3673-5cd0-5215-bb2d-129ad6dfc34b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186487147}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "16965fbd-f380-5aaa-bd39-b9dfc41f6cc7" :question/math-academy-id "q-218731" :question/problem "Find $u$ if  ${u}^{2}+\\frac{2}{5}=\\frac{1}{2}.$" :question/worked-solution "First, we isolate the ${u}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}{u}^{2}+\\frac{2}{5} & =\\frac{1}{2} \\\\ {u}^{2} & =\\frac{1}{2}-\\frac{2}{5} \\\\ {u}^{2} & =\\frac{5}{10}-\\frac{4}{10} \\\\ {u}^{2} & =\\frac{1}{10}\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{u}^{2}} & =\\sqrt{\\frac{1}{10}} \\\\ |u| & =\\sqrt{\\frac{1}{10}} \\\\ |u| & =\\frac{\\sqrt{1}}{\\sqrt{10}} \\\\ |u| & =\\frac{1}{\\sqrt{10}} \\\\ u & =\\pm \\frac{1}{\\sqrt{10}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186487318 :knowledge-point/_questions [{:db/id #edb/ref 17592186068727 :knowledge-point/id #uuid "a21c64f2-1b4b-54b3-a8a1-70ca63330e04" :knowledge-point/title "Solving Equations With Radical Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f8e2336-330f-5029-92a7-0d0ab28d6d9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{1}{2\\sqrt{5}}" :db/id #edb/ref 17592186486625} {:answer/id #uuid "17f14f97-f249-5dfb-9c13-79154bbd0395" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{1}{5\\sqrt{2}}" :db/id #edb/ref 17592186486642} {:answer/id #uuid "900fd687-4698-590d-a358-c19d9edd4bd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{2\\sqrt{2}}{5}" :db/id #edb/ref 17592186486912} {:answer/id #uuid "a4fd7934-d968-5053-8705-3ee362f