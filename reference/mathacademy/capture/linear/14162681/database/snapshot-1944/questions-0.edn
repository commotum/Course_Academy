#{[{:db/id #edb/ref 17592186068475 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068725 :knowledge-point/id #uuid "f544d0a4-24ce-5078-ad9d-93e733c091e6" :knowledge-point/title "Solving Equations With Integer Solutions"}] :question/id #uuid "fed35802-1128-5cb4-a91b-e98227dcfba8" :question/math-academy-id "e-13966" :question/problem "Solve $2x^2 - 27=5.$" :question/worked-solution "First, we isolate the $x^2$ on one side of the equation:\n\n$$\n\\begin{aligned}2{x}^{2}-27 & =5 \\\\ 2{x}^{2} & =32 \\\\ {x}^{2} & =16\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}} & =\\sqrt{16} \\\\ |x| & =4 \\\\ x & =\\pm 4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068476 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068726 :knowledge-point/id #uuid "6c5d24fa-8a65-5c20-bb50-530ca8dcf061" :knowledge-point/title "Solving Equations With Fractional Solutions"}] :question/id #uuid "6145c2d5-5d09-543c-8405-1319277323aa" :question/math-academy-id "e-13968" :question/problem "Solve for $p$ where $4p^2 - 11 = 14.$" :question/worked-solution "First, we isolate the $p^2$ on one side of the equation:\n\n$$\n\\begin{aligned}4{p}^{2}-11 & =14 \\\\ 4{p}^{2} & =25 \\\\ {p}^{2} & =\\frac{25}{4}\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{p}^{2}} & =\\sqrt{\\frac{25}{4}} \\\\ |p| & =\\frac{\\sqrt{25}}{\\sqrt{4}} \\\\ |p| & =\\frac{5}{2} \\\\ p & =\\pm \\frac{5}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068477 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068727 :knowledge-point/id #uuid "a21c64f2-1b4b-54b3-a8a1-70ca63330e04" :knowledge-point/title "Solving Equations With Radical Solutions"}] :question/id #uuid "9c00e3e1-9337-5380-af51-e7e8c7ae9f48" :question/math-academy-id "e-13970" :question/problem "Find $t$ if $2t^2 = 36.$" :question/worked-solution "First, we isolate the $t^2$ on one side of the equation:\n\n$$\n\\eqalign{\n\t\t2t^2 &= 36\\\n\t\tt^2 &= 18\n\t}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\eqalign{\t\t\n\t\t\\sqrt{t^2} &= \\sqrt{18} \\\n\t\t\\vert t \\vert &= \\sqrt{18} \\\n\t\t\\vert t \\vert &= \\sqrt{9 \\cdot 2} \\\n\t\t\\vert t \\vert &= \\sqrt{9} \\cdot \\sqrt{2} \\\n\t\t\\vert t \\vert &= 3\\sqrt{2} \\\n\t\tt &= \\pm 3\\sqrt{2}\n\t}\n$$"}] [{:db/id #edb/ref 17592186487346 :knowledge-point/_questions [{:db/id #edb/ref 17592186068726 :knowledge-point/id #uuid "6c5d24fa-8a65-5c20-bb50-530ca8dcf061" :knowledge-point/title "Solving Equations With Fractional Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "299d1d2a-8f5f-5e7c-8e64-5d7529ce14db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=\\pm \\frac{4}{3}" :db/id #edb/ref 17592186486674} {:answer/id #uuid "462526e8-fc43-5cc7-8eb3-ed00147c32a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=\\pm \\frac{9}{4}" :db/id #edb/ref 17592186486744} {:answer/id #uuid "59d659c1-4443-5028-92b3-e12237de32cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=\\pm \\frac{2}{3}" :db/id #edb/ref 17592186486792} {:answer/id #uuid "ce0e0dcf-f962-5de2-a67c-1c7391f31974" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=\\pm \\frac{3}{2}" :db/id #edb/ref 17592186487047} {:answer/id #uuid "d464a780-0bbb-5e84-98b1-7a2792ada102" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=\\pm \\frac{3}{4}" :db/id #edb/ref 17592186487057}] :answer-field/correct {:answer/id #uuid "d464a780-0bbb-5e84-98b1-7a2792ada102" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=\\pm \\frac{3}{4}" :db/id #edb/ref 17592186487057} :answer-field/id #uuid "e030839c-1a8a-53e2-b8c7-88d824a286f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186487263}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8d4e69dd-adb5-5686-b554-16f7f78bb263" :question/math-academy-id "q-111426" :question/problem "Solve for $w$ where $16{w}^{2}=9.$" :question/worked-solution "First, we isolate the ${w}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}16{w}^{2} & =9 \\\\ {w}^{2} & =\\frac{9}{16}\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{w}^{2}} & =\\sqrt{\\frac{9}{16}} \\\\ |w| & =\\frac{\\sqrt{9}}{\\sqrt{16}} \\\\ |w| & =\\frac{3}{4} \\\\ w & =\\pm \\frac{3}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186487406 :knowledge-point/_questions [{:db/id #edb/ref 17592186068727 :knowledge-point/id #uuid "a21c64f2-1b4b-54b3-a8a1-70ca63330e04" :knowledge-point/title "Solving Equations With Radical Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0435fbbd-ecc6-5db3-9a1d-71544f3d68dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b=-\\sqrt{19}" :db/id #edb/ref 17592186486602} {:answer/id #uuid "3dc60bf6-d7b2-51e0-b2ad-ac8898cae6af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b=1,\\pm \\sqrt{19}" :db/id #edb/ref 17592186486725} {:answer/id #uuid "8f209d46-54a1-5839-aa07-ad8dc82a1d18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b=\\pm \\sqrt{19}" :db/id #edb/ref 17592186486910} {:answer/id #uuid "b52f0129-8390-5ff3-a94b-7f331a2c4995" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b=\\sqrt{19}" :db/id #edb/ref 