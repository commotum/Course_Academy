2186050863 #edb/ref 1035 #uuid "6c50a924-e605-53d8-a75a-6a6c8215d2c0" #edb/ref 17592186045417] [17592186068475 #edb/ref 1069 "e-13966" #edb/ref 17592186045417] [17592186068475 #edb/ref 1071 "Solve $2x^2 - 27=5.$" #edb/ref 17592186045417] [17592186068475 #edb/ref 1072 #uuid "fed35802-1128-5cb4-a91b-e98227dcfba8" #edb/ref 17592186045417] [17592186068475 #edb/ref 1074 "First, we isolate the $x^2$ on one side of the equation:\n\n$$\n\\begin{aligned}2{x}^{2}-27 & =5 \\\\ 2{x}^{2} & =32 \\\\ {x}^{2} & =16\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}} & =\\sqrt{16} \\\\ |x| & =4 \\\\ x & =\\pm 4\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186068476 #edb/ref 1069 "e-13968" #edb/ref 17592186045417] [17592186068476 #edb/ref 1071 "Solve for $p$ where $4p^2 - 11 = 14.$" #edb/ref 17592186045417] [17592186068476 #edb/ref 1072 #uuid "6145c2d5-5d09-543c-8405-1319277323aa" #edb/ref 17592186045417] [17592186068476 #edb/ref 1074 "First, we isolate the $p^2$ on one side of the equation:\n\n$$\n\\begin{aligned}4{p}^{2}-11 & =14 \\\\ 4{p}^{2} & =25 \\\\ {p}^{2} & =\\frac{25}{4}\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{p}^{2}} & =\\sqrt{\\frac{25}{4}} \\\\ |p| & =\\frac{\\sqrt{25}}{\\sqrt{4}} \\\\ |p| & =\\frac{5}{2} \\\\ p & =\\pm \\frac{5}{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186068477 #edb/ref 1069 "e-13970" #edb/ref 17592186045417] [17592186068477 #edb/ref 1071 "Find $t$ if $2t^2 = 36.$" #edb/ref 17592186045417] [17592186068477 #edb/ref 1072 #uuid "9c00e3e1-9337-5380-af51-e7e8c7ae9f48" #edb/ref 17592186045417] [17592186068477 #edb/ref 1074 "First, we isolate the $t^2$ on one side of the equation:\n\n$$\n\\eqalign{\n\t\t2t^2 &= 36\\\n\t\tt^2 &= 18\n\t}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\eqalign{\t\t\n\t\t\\sqrt{t^2} &= \\sqrt{18} \\\n\t\t\\vert t \\vert &= \\sqrt{18} \\\n\t\t\\vert t \\vert &= \\sqrt{9 \\cdot 2} \\\n\t\t\\vert t \\vert &= \\sqrt{9} \\cdot \\sqrt{2} \\\n\t\t\\vert t \\vert &= 3\\sqrt{2} \\\n\t\tt &= \\pm 3\\sqrt{2}\n\t}\n$$" #edb/ref 17592186045417] [17592186068725 #edb/ref 1037 #edb/ref 17592186048267 #edb/ref 17592186045417] [17592186068725 #edb/ref 1037 #edb/ref 17592186049843 #edb/ref 17592186045417] [17592186068725 #edb/ref 1038 #edb/ref 17592186069222 #edb/ref 17592186045417] [17592186068725 #edb/ref 1038 #edb/ref 17592186069263 #edb/ref 17592186045417] [17592186068725 #edb/ref 1038 #edb/ref 17592186069340 #edb/ref 17592186045417] [17592186068725 #edb/ref 1038 #edb/ref 17592186487308 #edb/ref 17592186045417] [17592186068725 #edb/ref 1038 #edb/ref 17592186487400 #edb/ref 17592186045417] [17592186068725 #edb/ref 1039 "Solving Equations With Integer Solutions" #edb/ref 17592186045417] [17592186068725 #edb/ref 1041 #edb/ref 17592186068475 #edb/ref 17592186045417] [17592186068725 #edb/ref 1042 #uuid "f544d0a4-24ce-5078-ad9d-93e733c091e6" #edb/ref 17592186045417] [17592186068726 #edb/ref 1037 #edb/ref 17592186050315 #edb/ref 17592186045417] [17592186068726 #edb/ref 1038 #edb/ref 17592186069138 #edb/ref 17592186045417] [17592186068726 #edb/ref 1038 #edb/ref 17592186069173 #edb/ref 17592186045417] [17592186068726 #edb/ref 1038 #edb/ref 17592186069341 #edb/ref 17592186045417] [17592186068726 #edb/ref 1038 #edb/ref 17592186487300 #edb/ref 17592186045417] [17592186068726 #edb/ref 1038 #edb/ref 17592186487346 #edb/ref 17592186045417] [17592186068726 #edb/ref 1039 "Solving Equations With Fractional Solutions" #edb/ref 17592186045417] [17592186068726 #edb/ref 1041 #edb/ref 17592186068476 #edb/ref 17592186045417] [17592186068726 #edb/ref 1042 #uuid "6c5d24fa-8a65-5c20-bb50-530ca8dcf061" #edb/ref 17592186045417] [17592186068727 #edb/ref 1037 #edb/ref 17592186049923 #edb/ref 17592186045417] [1