></mtr><mtr><mtd><mo data-mjx-texclass=\"ORD\" fence=\"false\" stretchy=\"false\">|</mo><mi>t</mi><mo data-mjx-texclass=\"ORD\" fence=\"false\" stretchy=\"false\">|</mo></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>4</mn><mn>3</mn></mfrac></mstyle></mtd></mtr><mtr><mtd><mi>t</mi></mtd><mtd><mi></mi><mo>=</mo><mo>±</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>4</mn><mn>3</mn></mfrac></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
