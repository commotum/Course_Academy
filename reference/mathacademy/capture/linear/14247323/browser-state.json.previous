    "q-51910": {
      "dom_id": "step-q51910",
      "name": "Question 2",
      "problem": "What is the sum of the fifth, sixth, and seventh terms of the following sequence?\n\n$$\n-9,\\,-6,\\,-3,\\,0,\\,6,\\,12,\\,18\n$$",
      "worked_solution": "For this sequence:\n\n- The first term is $-9$\n\n- The second term is $-6$\n\n- The third term is $-3$\n\n- The fourth term is $0$\n\n- The fifth term is $6$\n\n- The sixth term is $12$\n\n- The seventh term is $18$\n\nTherefore, the sum of the fifth, sixth, and seventh terms is \n\n$$\n6+12+18=36.\n$$",
      "calculator_instructions": "",
