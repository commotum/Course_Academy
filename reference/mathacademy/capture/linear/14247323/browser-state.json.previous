  "live_records": {
    "q-262870": {
      "dom_id": "step-q262870",
      "name": "Question 1",
      "problem": "What are the second and last terms of the following sequence? \n\n$$\n7,\\,14,\\,21,\\,28,\\,35,\\,42\n$$\n\nThe second term is\n{{field-1}}\nand the last term is\n{{field-2}}.",
      "worked_solution": "For this sequence:\n\n- The first term is $7$\n\n- The second term is $14$\n\n- The third term is $21$\n\n- The fourth term is $28$\n\n- The fifth term is $35$\n\n- The sixth term is $42$\n\nTherefore, the second term is $14$ and the last term is $42.$",
      "calculator_instructions": "",
