T180 -117T154 -158T130 -185T117 -194Q113 -194 104 -185T95 -172Q95 -168 106 -156T131 -126T157 -76T173 -3V9L172 8Q170 7 167 6T161 3T152 1T140 0Q113 0 96 17Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E4-MJMAIN-74\"></use>\n <use xlink:href=\"#E4-MJMAIN-61\" x=\"389\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-6E\" x=\"890\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-2C\" x=\"1446\" y=\"0\"></use>\n</g>\n</svg></span> and they are defined as</p>\n<p><span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"23.038ex\" height=\"21.176ex\" style=\"vertical-align: -10.005ex;\" viewBox=\"0 -4809.9 9919.1 9117.4\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-5-Title\">\n<title id=\"MathJax-SVG-5-Title\">\n\t\\eqalign{\n\t\t\\sin(\\theta) &amp;= \\dfrac {\\text{opposite}} {\\text{hypotenuse}},  <span>\\</span>[5pt]\n\t\t\\cos(\\theta) &amp;= \\dfrac {\\text{adjacent}} {\\text{hypotenuse}},  <span>\\</span>[5pt]\n\t\t\\tan(\\theta) &amp;= \\dfrac {\\text{opposite}} {\\text{adjacent}}.  <span>\\</span>\n\t}\n</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E5-MJMAIN-73\" d=\"M295 316Q295 356 268 385T190 414Q154 414 128 401Q98 382 98 349Q97 344 98 336T114 312T157 287Q175 282 201 278T245 269T277 256Q294 248 310 236T342 195T359 133Q359 71 321 31T198 -10H190Q138 -10 94 26L86 19L77 10Q71 4 65 -1L54 -11H46H42Q39 -11 33 -5V74V132Q33 153 35 157T45 162H54Q66 162 70 158T75 146T82 119T101 77Q136 26 198 26Q295 26 295 104Q295 133 277 151Q257 175 194 187T111 210Q75 227 54 256T33 318Q33 357 50 384T93 424T143 442T187 447H198Q238 447 268 432L283 424L292 431Q302 440 314 448H322H326Q329 448 335 442V310L329 304H301Q295 310 295 316Z\"></path>\n<path stroke-width=\"1\" id=\"E5-MJMAIN-69\" d=\"M69 609Q69 637 87 653T131 669Q154 667 171 652T188 609Q188 579 171 564T1