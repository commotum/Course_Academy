=\"#E5-MJMAIN-70\" x=\"1085\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-6F\" x=\"1641\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-74\" x=\"2142\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-65\" x=\"2531\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-6E\" x=\"2976\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-75\" x=\"3532\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-73\" x=\"4089\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-65\" x=\"4483\" y=\"0\"></use>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E5-MJMAIN-2C\" x=\"6344\" y=\"0\"></use>\n<g transform=\"translate(0,-3305)\">\n <use xlink:href=\"#E5-MJMAIN-3D\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(1056,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"3819\" height=\"60\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(99,714)\">\n <use xlink:href=\"#E5-MJMAIN-6F\"></use>\n <use xlink:href=\"#E5-MJMAIN-70\" x=\"500\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-70\" x=\"1057\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-6F\" x=\"1613\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-73\" x=\"2114\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-69\" x=\"2508\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-74\" x=\"2787\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-65\" x=\"3176\" y=\"0\"></use>\n</g>\n<g transform=\"translate(60,-716)\">\n <use xlink:href=\"#E5-MJMAIN-61\"></use>\n <use xlink:href=\"#E5-MJMAIN-64\" x=\"500\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-6A\" x=\"1057\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-61\" x=\"1363\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-63\" x=\"1864\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-65\" x=\"2308\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-6E\" x=\"2753\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-74\" x=\"3309\" y=\"0\"></use>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E5-MJMAIN-2E\" x=\"5115\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n<p>For a given angle <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.09ex\" height=\"2.176ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -791.3 469.5 936.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-6-Title\">\n<title id=\"MathJax-SVG-6-Title\">\\theta</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E6-MJMATHI-3B8\" d=\"M35 200Q35 302 74 415T180 610T319 704Q320 704 327 704T339 705Q393 701 423 656Q462 596 462 495Q462 380 417 261T302 66T168 -10H161Q125 -10 99 10T60 63T41 130T35 200ZM383 566Q383 668 330 668Q294 668 260 623T204 521T170 421T157 371Q206 370 254 370L351 371Q352 372 359 404T375 484T383 566ZM113 132Q113 26 166 26Q181 26 198 36T239 74T287 161T335 307L340 324H145Q145 321 136 286T120 208T113 132Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E6-MJMATHI-3B8\" x=\"0\" y=\"0\"></use>\n</g>\n</svg></span>, these ratios remain the same no matter what the size of the triangle is. For example, if we were to double the length of each side of a given triangle, the values of these ratios would remain unchanged. </p>\n<p>An easy way of remembering how to compute the different trigonometric ratios is by using the three-syllable acronym <strong>SOH-CAH-TOA</strong>. It stands for:</p>\n<ul>\n<li><p>SOH <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"2.324ex\" height=\"1.843ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -647.8 1000.5 793.3\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-7-Title\">\n<title id=\"MathJax-SVG-7-Title\">\\rightarrow</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E7-MJMAIN-2192\" d=\"M56 237T56 250T70 270H835Q719 357 692 493Q692 494 692 496T691 499Q691 511 708 511H711Q720 511 723 510T729 506T732 497T735 481T743 456Q765 389 816 336T935 261Q944 258 944 250Q944 244 939 241T915 231T877 212Q836 186 806 152T761 85T740 35T732 4Q730 -6 727 -8T711 -11Q691 -11 691 0Q691 7 696 25Q728 151 835 230H70Q56 237 56 250Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E7-MJMAIN-2192\" x=\"0\" y=\"0\"></use>\n</g>\n</svg></span> <strong>S</strong>ine = <strong>O</strong>pposite / <strong>H</strong>ypotenuse,</p>\n</li>\n<li><p>CAH <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"2.324ex\" height=\"1.843ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -647.8 1000.5 793.3\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-8-Title\">\n<title id=\"MathJax-SVG-8-Title\">\\rightarrow</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E8-MJMAIN-2192\" d=\"M56 237T56 250T70 270H835Q719 357 692 493Q692 494 692 496T691 499Q691 511 708 511H711Q720 511 723 510T729 506T732 497T735 481T743 456Q765 389 816 336T935 261Q944 258 944 250Q944 244 939 241T915 231T877 212Q836 186 806 152T761 85T740 35T732 4Q730 -6 727 -8T711 -11Q691 -11 691 0Q691 7 696 25Q728 151 835 230H70Q56 237 56 250Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E8-MJMAIN-2192\" x=\"0\" y=\"0\"></use>\n</g>\n</svg></span> <strong>C</strong>osine = <strong>A</strong>djacent / <strong>H</strong>ypotenuse,</p>\n</li>\n<li><p>TOA <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"2.324ex\" height=\"1.843ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -647.8 1000.5 793.3\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-9-Title\">\n<title id=\"MathJax-SVG-9-Title\">\\rightarrow</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E9-MJMAIN-2192\" d=\"M56 237T56 250T70 270H835Q719 357 692 493Q692 494 692 496T691 499Q691 511 708 511H711Q720 511 723 510T729 506T732 497T735 481T743 456Q765 389 816 336T935 261Q944 258 944 250Q944 244 939 241T915 231T877 212Q836 186 806 152T761 85T740 35T732 4Q730 -6 727 -8T711 -11Q691 -11 691 0Q691 7 696 25Q728 151 835 230H70Q56 237 56 250Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E9-MJMAIN-2192\" x=\"0\" y=\"0\"></use>\n</g>\n</svg></span> <strong>T</strong>angent = <strong>O</strong>pposite / <strong>A</strong>djacent.</p>\n</li>\n</ul>\n           \n                </div>        \n                    \n            </div>",
