4c7aab2-8433-5bef-a4f1-a4b1b2559e22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186561678} {:answer/id #uuid "45fbc98b-11ec-5e5a-9e5f-0eddc342eb73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186561758} {:answer/id #uuid "503ab61a-d84b-501e-9b52-096bbc2f789a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186561789} {:answer/id #uuid "89d44df5-6fd3-5f69-a480-93623d68bc39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186561925} {:answer/id #uuid "ea473308-3ceb-56fe-8dec-e7299e790279" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186562166}] :answer-field/correct {:answer/id #uuid "89d44df5-6fd3-5f69-a480-93623d68bc39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186561925} :answer-field/id #uuid "de92e059-1982-5dbc-8af4-37792803768f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562363}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "986f7504-f85e-51dd-a6eb-fbd91caed65d" :question/math-academy-id "q-4543" :question/problem "![](images/8d/8d31dc0c38fbd5f1b3a39a53d3d50939421509ddcef45a96e56d2aa367ed4cd8.png)\n\n$\\operatorname{tan}⁡D=$" :question/worked-solution "The tangent of an angle is equal to the opposite divided by the adjacent (T-O-A). Relative to the angle $D,$ the opposite side is $\\overset{―}{BC},$ and the adjacent is $\\overset{―}{BD}.$ Therefore, \n\n$$\n\\begin{aligned}\\operatorname{tan}⁡D & =\\frac{BC}{BD} \\\\  & =\\frac{8}{6} \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186562469 :knowledge-point/_questions [{:db/id #edb/ref 17592186078537 :knowledge-point/id #uuid "eaac3fe1-285b-57ba-956b-66eaf51ded7e" :knowledge-point/title "Evaluating Trigonometric Ratios Given a Triangle with Integer Side Lengths"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6585b2a8-7a2e-566f-ba35-9d2b78d20311" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{89}{39}" :db/id #edb/ref 17592186561833} {:answer/id #uuid "70dcf41a-bc67-58d9-9b25-43ce1a8d4671" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{80}{89}" :db/id #edb/ref 17592186561865} {:answer/id #uuid "9a735f61-7395-5cc3-8db3-f9fe94365b06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{80}{39}" :db/id #edb/ref 17592186561966} {:answer/id #uuid "b6f0ad3b-4204-50b8-9ec6-145cd980bb2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{89}{80}" :db/id #edb/ref 17592186562038} {:answer/id #uuid "c6bda1e7-d093-58b4-8e9f-f5cf6a2e2e39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{39}{80}" :db/id #edb/ref 17592186562077}] :answer-field/correct {:answer/id #uuid "70dcf41a-bc67-58d9-9b25-43ce1a8d4671" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{80}{89}" :db/id #edb/ref 17592186561865} :answer-field/id #uuid "07898785-a218-597e-baaa-e921663aee93" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562222}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a0ff3000-90f6-50f0-b55e-baca4a2294a7" :question/math-academy-id "q-4605" :question/problem "![](images/44/44f3144d089201597af3ffe32176741b15cbb2345c635549058148f83781175a.png)\n\n$\\operatorname{cos}⁡E=$" :question/worked-solution "The cosine of an angle is equal to the adjacent divided by the hypotenuse (C-A-H). Relative to the angle $E,$ the adjacent side is $\\overset{―}{FE},$ and the hypotenuse is $\\overset{―}{DE}.$ Therefore, \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡E & =\\frac{FE}{DE}=\\frac{80}{89}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186562507 :knowledge-point/_questions [{:db/id #edb/ref 17592186078538 :knowledge-point/id #uuid "50c8132c-18c7-5250-a68e-68500bdb926e" :knowledge-point/title "Evaluating a Trigonometric Ratio Given a Triangle with Non-Integer Side Lengths"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31b09780-74f8-5623-9c4b-1d4b88920a31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{14}}{19}" :db/id #edb/ref 17592186561713} {:answer/id #uuid "70b578e6-30ac-538e-a414-29e486d5b209" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{112}}{19}" :db/id #edb/ref 17592186561862} {:answer/id #uuid "807a7948-f38a-5004-a53f-71205609f19e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{21}}{19}" :db/id #edb/ref 17592186561902} {:answer/id #uuid "a5a1d4ab-4862-5d36-85a4-10e29fd32e5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{133}}{19}" :db/id #edb/ref 17592186561995} {:answer/id #uuid "ff1f13cf-b382-555c-a965-2dabb0abd939" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{26}}{19}" :db/id #edb/ref 17592186562211}] :answer-field/correct {:answer/id #uuid "a5a1d4ab-4862-5d36-85a4-10e29fd32e5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{133}}{19}" :db/id #edb/ref 17592186561995} :answer-field/id #uuid "1c17fb68-b03e-5969-a875-bcdd0370c517" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562236}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ee667b29-0e64-58a9-af5f-3a42e42c422f" :question/math-academy-id "q-54095" :question/problem "![](images/14/14c05d01cdba24b04330a821597eef21dd325228bb8a7fc1e02103ca80f39450.png)\n\n$\\operatorname{cos}⁡S=$" :question/worked-solution "The cosine of an angle is equal to the adjacent divided by the hypotenuse (C-A-H). Relative to the angle $S,$ the adjacent side is $\\overset{―}{ST},$ and the hypotenuse is $\\overset{―}{SR}.$ Therefore, \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡S & =\\frac{ST}{SR} \\\\  & =\\frac{\\sqrt{7}}{\\sqrt{19}} \\\\  & =\\frac{\\sqrt{7}}{\\sqrt{19}}\\cdot \\frac{\\sqrt{19}}{\\sqrt{19}} \\\\  & =\\frac{\\sqrt{133}}{19}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186562411 :knowledge-point/_questions [{:db/id #edb/ref 17592186078538 :knowledge-point/id #uuid "50c8132c-18c7-5250-a68e-68500bdb926e" :knowledge-point/title "Evaluating a Trigonometric Ratio Given a Triangle with Non-Integer Side Lengths"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00c27cff-6db0-5925-b3a7-892c4c471ebe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{21}" :db/id #edb/ref 17592186561580} {:answer/id #uuid "0c742ab1-2878-5697-8580-71d0bf6781d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{4}" :db/id #edb/ref 17592186561619} {:answer/id #uuid "459a7d22-49e8-5e65-a53e-608ea8dcbb70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186561757} {:answer/id #uuid "6d0bd988-f8a7-52b7-934e-dd0faff8023c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{3}" :db/id #edb/ref 17592186561853} {:answer/id #uuid "f950c099-cf0d-5b7d-be55-608c4139a6ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186562198}] :answer-field/correct {:answer/id #uuid "0c742ab1-2878-5697-8580-71d0bf6781d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{4}" :db/id #edb/ref 17592186561619} :answer-field/id #uuid "f7c631e7-639a-55f6-b533-553cff151211" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562379}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "28b7c740-c4b9-5ebd-bb70-3180edf82e3a" :question/math-academy-id "q-54107" :question/problem "In the right triangle $△ABC,$ $∠A$ is a right angle, $AB=3\\sqrt{7},$ $AC=9$ and $BC=12.$ Find $\\operatorname{sin}⁡C.$" :question/worked-solution "Let's illustrate the given triangle.\n\n![](images/40/40f31b56b1078bbab7d423c89088218c3fc52e3a2d56c2170c380d415860c2ad.png)\n\nThe sine of an angle is equal to the opposite divided by the hypotenuse (S-O-H). Relative to the angle $C,$ the opposite side is $\\overset{―}{AB},$ and the hypotenuse is $\\overset{―}{CB}.$ Therefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡C & =\\frac{AB}{CB}=\\frac{3\\sqrt{7}}{12}=\\frac{\\sqrt{7}}{4}.\\end{aligned}\n$$"}]}
