d "6f37a088-e423-52cf-be75-62c749682dc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "disprove" :db/id #edb/ref 17592186199901}] :answer-field/id #uuid "dc9f9337-b145-5cec-aed9-0af889398044" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186199899} {:answer-field/choices [{:answer/id #uuid "4de85962-9dc3-5d43-a9c5-9cd3c07d9222" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "for all integers $a$ and $b$" :db/id #edb/ref 17592186199903} {:answer/id #uuid "67aff66f-a05d-5b05-9735-245fd0896ddb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "there exist integers $a$ and $b$ such that" :db/id #edb/ref 17592186199904}] :answer-field/id #uuid "ef468d72-a205-50d0-8c02-204f7e824995" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186199902}] :question/id #uuid "ede85229-ac6b-539d-a1ef-b131f6c0e688" :question/math-academy-id "q-184797" :question/problem "Disprove the following statement:\n\n> For any $a, b ∈ Z$, if $5a≡5b(mod20)$, then $a≡b(mod20)$.\n\nTo {{field-1}} a universal statement, it's sufficient to find {{field-2}}.\nIn other words, we need to show that {{field-3}} $a≡b$ {{field-4}} {{field-5}}"}]}
