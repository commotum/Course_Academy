47d4-3f79-5bbe-a241-82fc97eaa36d"] :db/ensure [:answer-field/validate]} {:db/id "answer-5ea2dfd9-6bff-552c-95e5-8bfe1d2355ad" :answer/id #uuid "5ea2dfd9-6bff-552c-95e5-8bfe1d2355ad" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-7f7547d4-3f79-5bbe-a241-82fc97eaa36d" :answer/id #uuid "7f7547d4-3f79-5bbe-a241-82fc97eaa36d" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id 17592186204214 :question/problem "Disprove the following statement:\n\nFor any $a,b\\in Z,$ if $5a≡5b\\,(\\text{mod}\\,20),$ then $a≡b\\,(\\text{mod}\\,20).$\n\nTo {{field-1}} a universal statement, it's sufficient to find {{field-2}}. \nIn other words, we need to show that {{field-3}}\n\n$$\n{{field-4}}(\\text{mod}\\,20)\\,\\text{and}\\,{{field-5}}(\\text{mod}\\,20).\n$$\n\nLet's choose\n\n$$\na={{field-6}},\\,b={{field-7}}.\n$$\n\nThen, $5a=$ {{field-8}} and $5b=$ {{field-9}}. \n\nHence, we have that \n\n$$\n{{20}_{⏟}}_{5a}{{field-10}}{{40}_{⏟}}_{5b}\\,(\\text{mod}\\,20)\\,\\text{and}\\,{{4}_{⏟}}_{a}{{field-11}}{{8}_{⏟}}_{b}\\,(\\text{mod}\\,20).\n$$\n\nSo, the pair $a=$ {{field-12}} and $b=$ {{field-13}} is our counterexample. Therefore, the given statement is false." :question/worked-solution "By denoting $P(a,b)$ and $Q(a,b)$ as\n\n- $P(a,b):\\,5a≡5b\\,(\\text{mod}\\,20)$\n\n- $Q(a,b):\\,a≡b\\,(\\text{mod}\\,20)$\n\nour statement can be written as\n\n$$\n∀a,b\\in Z,\\,P⇒Q.\n$$\n\nWe want to disprove this statement. In other words, we must show that its negation is true:\n\n$$\n\\begin{aligned}¬(∀a,b\\in Z,\\,P⇒Q) & ≡\\,∃a,b\\in Z,\\,¬(P⇒Q) \\\\  & ≡\\,∃a,b\\in Z,\\,¬(¬P∨Q) \\\\  & ≡\\,∃a,b\\in Z,\\,P∧¬Q \\\\  & ≡\\,∃a,b\\in Z,\\,(5a≡5b\\,(\\text{mod}\\,20))\\,∧\\,(a≢b\\,(\\text{mod}\\,20))\\end{aligned}\n$$\n\nSo, we begin as follows:\n\nTo disprove a universal statement, it's sufficient to find a counterexample. \nIn other words, we need to show that there exist integers $a$ and $b$ such that \n\n$$\n5a≡5b\\,(\\text{mod}\\,20)\\,\\text{and}\\,a≢b\\,(\\text{mod}\\,20)\n$$\n\nFinding a counterexample is sometimes a nontrivial task, but we only need one. In this case, substituting $(a,b)=(4,8)$ suffices. \n\nLet's choose\n\n$$\na=4,\\,b=8.\n$$\n\nThen, $5a=20$ and $5b=40.$ \n\nTo check that this is a required counterexample, we proceed as follows:\n\nHence, we have that \n\n$$\n{{20}_{⏟}}_{5a}≡{{40}_{⏟}}_{5b}\\,(\\text{mod}\\,20)\\,\\text{and}\\,{{4}_{⏟}}_{a}≢{{8}_{⏟}}_{b}\\,(\\text{mod}\\,20).\n$$\n\nFinally, we state our conclusion:\n\nSo, the pair $a=4$ and $b=8$ is our counterexample. Therefore, the given statement is false." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6af8fcc0-2745-56f0-8009-c6ad3e274378" "answer-field-77664319-818d-5554-9939-354bf5db5f2e" "answer-field-f50f4826-ab89-538f-b95b-5c4a1aa4f699" "answer-field-d9d1e98b-e305-5a4a-baef-68809ced949b" "answer-field-6deaffa6-11c1-53ee-b07e-5e3e2da33591" "answer-field-d9ae6b1b-8684-53cf-900c-a85fb02e71e8" "answer-field-e7f8d5a6-e853-5a87-921b-5a03a304d1cb" "answer-field-e5d4ecf4-326a-50f4-a1d4-5e931c14acca"] :db/ensure [:question/validate]} {:db/id 17592186199899 :answer-field/correct 17592186199901 :db/ensure [:answer-field/validate]} {:db/id 17592186199892 :answer-field/correct 17592186199894 :db/ensure [:answer-field/validate]} {:db/id 17592186199902 :answer-field/correct 17592186199904 :db/ensure [:answer-field/validate]} {:db/id 17592186199888 :answer-field/correct 17592186199889 :db/ensure [:answer-field/validate]} {:db/id 17592186199895 :answer-field/correct 17592186199898 :db/ensure [:answer-field/validate]} {:db/id "answer-field-6af8fcc0-2745-56f0-8009-c6ad3e274378" :answer-field/id #uuid "6af8fcc0-2745-56f0-8009-c6ad3e274378" :answer-field/key "field-6" :answer-field/type :answer-field.type/select :answer-field/correct "answer-438c1e91-5758-5515-afaf-a1c72a5fb2a8" :answer-field/choices ["answer-438c1e91-5758-5515-afaf-a1c72a5fb2a8" "answer-94660d47-6198-5dc9-838