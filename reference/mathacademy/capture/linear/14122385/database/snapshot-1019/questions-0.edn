-2ca5-5e2a-acc4-6cf714e1a86c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∤" :db/id #edb/ref 17592186419268} {:answer/id #uuid "eafdd1b7-04cd-56b0-a285-ab02e71af57b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∣" :db/id #edb/ref 17592186419333}] :answer-field/correct {:answer/id #uuid "45d5dcca-2ca5-5e2a-acc4-6cf714e1a86c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∤" :db/id #edb/ref 17592186419268} :answer-field/id #uuid "bac48d4d-c6a3-5c77-93f2-6a947e9b0f02" :answer-field/key "field-10" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186419379} {:answer-field/choices [{:answer/id #uuid "49f6e705-eca0-563a-8eca-462ca28d61a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∤" :db/id #edb/ref 17592186419270} {:answer/id #uuid "fdde4317-5533-5341-a2a9-25339b29494f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∣" :db/id #edb/ref 17592186419345}] :answer-field/correct {:answer/id #uuid "fdde4317-5533-5341-a2a9-25339b29494f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∣" :db/id #edb/ref 17592186419345} :answer-field/id #uuid "be9ca723-cff2-5337-9476-0020a32363b3" :answer-field/key "field-8" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186419381}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d1cc0610-ee4b-58b1-8b76-c910ff50a754" :question/math-academy-id "q-221742" :question/problem "Disprove the following statement:\n\nFor any $a\\in Z,$ if $10∣a$ and $15∣a,$ then $150∣a.$\n\nTo {{field-1}} a universal statement, it's sufficient to find {{field-2}}. \nIn other words, we need to show that {{field-3}}\n\n$$\n{{field-4}}\\,\\text{and}\\,{{field-5}}\\,\\text{and}\\,{{field-6}}.\n$$\n\nLet's choose $a=$ {{field-7}}.\nThen, we have that \n\n$$\n10{{field-8}}30\\,\\text{and}\\,15{{field-9}}30\\,\\text{and}\\,150{{field-10}}30.\n$$\n\nSo, $a=$ {{field-11}} is our counterexample. Therefore, the given statement is false." :question/worked-solution "By denoting $P(a),$ $Q(a),$ and $R(a)$ as\n\n- $P(a):\\,10∣a$\n\n- $Q(a):\\,15∣a$\n\n- $R(a):\\,150∣a$\n\nour statement can be written as\n\n$$\n∀a\\in Z,\\,(P∧Q)⇒R.\n$$\n\nWe want to disprove this statement. In other words, we must show that its negation is true:\n\n$$\n\\begin{aligned}¬(∀a\\in Z,\\,(P∧Q)⇒R) & ≡\\,∃a\\in Z,\\,¬((P∧Q)⇒R) \\\\  & ≡\\,∃a\\in Z,\\,¬(¬(P∧Q)∨R) \\\\  & ≡\\,∃a\\in Z,\\,(P∧Q)∧¬R \\\\  & ≡\\,∃a\\in Z,\\,P∧Q∧¬R \\\\  & ≡\\,∃a\\in Z,\\,(10∣a)\\,∧\\,(15∣a)\\,∧\\,(150∤a)\\end{aligned}\n$$\n\nSo, we begin as follows:\n\nTo disprove a universal statement, it's sufficient to find a counterexample. \nIn other words, we need to show that there exists an integer $a$ such that \n\n$$\n10∣a\\,\\text{and}\\,15∣a\\,\\text{and}\\,150∤a.\n$$\n\nFinding a counterexample is sometimes a nontrivial task, but we only need one. In this case, substituting $a=30$ suffices. \n\nLet's choose $a=30.$\nThen, we have that \n\n$$\n10∣30\\,\\text{and}\\,15∣30\\,\\text{and}\\,150∤30.\n$$\n\nFinally, we state our conclusion:\n\nSo, $a=30$ is our counterexample. Therefore, the given statement is false."}] [{:db/id #edb/ref 17592186419390 :knowledge-point/_questions [{:db/id #edb/ref 17592186203935 :knowledge-point/id #uuid "cfa972be-3517-5432-8d4c-c787e2a63633" :knowledge-point/title "Disproving Congruences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82edd07f-06c8-5efe-8a76-99cdb443d70c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "≢" :db/id #edb/ref 17592186419293} {:answer/id #uuid "ed6c8529-e793-5545-9ed9-12338ccc6bec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type