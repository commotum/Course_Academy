y/first-step {:db/id #edb/ref 17592186496385} :activity/id #uuid "2bcf3bf0-d9c9-5b6b-b508-f75da935df76" :activity/scope {:db/id #edb/ref 17592186048868 :topic/id #uuid "c7dda967-adbc-5d28-94d6-a574e5483086" :topic/math-academy-id 2184} :activity/steps [{:db/id #edb/ref 17592186496365 :step/content {:db/id #edb/ref 17592186496293 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "655e9f8a-99c6-542e-bec2-084d448a9418" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186495735} {:answer/id #uuid "83fbce6e-87bb-5e0c-a0c3-6b6e1a2ba629" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186495793} {:answer/id #uuid "972195d4-2903-51a7-83ec-a9b9e22afa04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\sqrt{3}}{3}" :db/id #edb/ref 17592186495848} {:answer/id #uuid "f5c54a6b-f8fc-5a8d-915e-56317c3cbc76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186496045} {:answer/id #uuid "f9d08d61-2fdd-54ec-b10c-73a52d207beb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186496055}] :answer-field/correct {:db/id #edb/ref 17592186495735} :answer-field/id #uuid "644279da-6e68-51b9-8779-34237a1405c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496128}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a33bcbcb-8c75-50ac-adb2-e56b319ae036" :question/math-academy-id "q-110883" :question/problem "Given $h(x)=\\frac{\\sqrt{2x+6}}{\\sqrt{2x-1}},$ find $h(5).$" :question/worked-solution "We replace $x$ with $5$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}h(5) & =\\frac{\\sqrt{2(5)+6}}{\\sqrt{2(5)-1}} \\\\  & =\\frac{\\sqrt{10+6}}{\\sqrt{10-1}} \\\\  & =\\frac{\\sqrt{16}}{\\sqrt{9}} \\\\  & =\\frac{4}{3}\\end{aligned}\n$$"} :step/id #uuid "9521dc72-95fd-5b99-9ee6-2cc815dfa07f" :step/next {:db/id #edb/ref 17592186496383}} {:db/id #edb/ref 17592186496373 :step/content {:db/id #edb/ref 17592186496276 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3308a8c5-80f5-511f-b76a-4421e28d64df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186495629} {:answer/id #uuid "44057f65-5e0b-5abb-9f88-1d6765f2c3cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt[3]{2}" :db/id #edb/ref 17592186495666} {:answer/id #uuid "751bfe77-634f-5b8c-9e0e-ec26f932991e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186495765} {:answer/id #uuid "c453f044-0ddc-57f7-a430-a4b1237e6816" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt[3]{3}" :db/id #edb/ref 17592186495940} {:answer/id #uuid "cf142703-648a-59a8-9972-954f2b3fd31f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[3]{3}" :db/id #edb/ref 17592186495964}] :answer-field/correct {:db/id #edb/ref 17592186495940} :answer-field/id #uuid "cfbc7d7c-d17d-5047-bb6c-dea5dcb79c39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496183}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7e27eddd-1b20-5f57-9534-d5e05a5f064b" :question/math-academy-id "q-63881" :question/problem "Evaluate $\\sqrt[3]{8a+1}$ at $a=10.$" :question/worked-solution "We replace $a$ with $10$ in the given expression, and simplify as much as possible:\n\n$$\n\\begin{aligned}\\sqrt[3]{8a+1} & = \\\\ \\sqrt[3]{8\\cdot 10+1} & = \\\\ \\sqrt[3]{80+1} & = \\\\ \\sqrt[3]{81} & = \\\\ \\sqrt[3]{27\\cdot 3} & = \\\\ \\sqrt[3]{{3}^{3}\\cdot 3} & = \\\\ \\sqrt[3]{{3}^{3}}\\cdot \\sqrt[3]{3} & = \\\\ 3\\sqrt[3]{3} & \\end{aligned}\n$$"} :step/id #uuid "ad6c90b7-0c2b-5201-8e7d-d90b7f0e3f2a" :step/next {:db/id #edb/ref 17592186496388}} {:db/id #edb/ref 17592186496383 :step/content {:db/id #edb/ref 17592186496310 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d6bcdc9-14f9-5f71-9835-f562c6809b64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt[3]{6}" :db/id #edb/ref 17592186495570} {:answer/id #uuid "6c922236-31af-5996-9c74-c387180cbf5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\sqrt[3]{3}" :db/id #edb/ref 17592186495749} {:answer/id #uuid "8e8abba6-8d33-582a-b745-99b175925a46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186495822} {:answer/id #uuid "c12064ba-3ce2-5917-bf15-83f64346a24a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186495933} {:answer/id #uuid "d1987438-6c46-55eb-8e91-3ecdd71e97a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt[3]{4}" :db/id #edb/ref 17592186495968}] :answer-field/correct {:db/id #edb/ref 17592186495822} :answer-field/id #uuid "eb373ce3-e8bd-579b-8051-9b912f1cd1ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496205}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c6b5a56c-98c8-5d43-970c-b65710fedbd3" :question/math-academy-id "q-110892" :question/problem "Evaluate $\\sqrt[3]{7r+1}$ at $r=9.$" :question/worked-solution "We replace $r$ with $9$ in the given expression, and simplify as much as possible:\n\n$$\n\\begin{aligned}\\sqrt[3]{7r+1} & = \\\\ \\sqrt[3]{7(9)+1} & = \\\\ \\sqrt[3]{63+1} & = \\\\ \\sqrt[3]{64} & = \\\\ \\sqrt[3]{{4}^{3}} & = \\\\ 4\\end{aligned}\n$$"} :step/id #uuid "d3ae019d-3691-5b62-babc-9366ec2c3c50"} {:db/id #edb/ref 17592186496385 :step/content {:db/id #edb/ref 17592186496257 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dab17f9-ac22-5b75-8783-b52b67743213" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186495616} {:answer/id #uuid "ae36fff1-0086-53b3-8ccf-68ca8561af6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186495901} {:answer/id #uuid "ca4f137d-8bf7-5971-bebc-50b3d830afe7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186495952} {:answer/id #uuid "d8236676-eb79-576e-9082-b3357e3fa004" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186495987} {:answer/id #uuid "e32e104e-2aac-5934-b393-8c62f7b1409a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186496014}] :answer-field/correct {:db/id #edb/ref 17592186496014} :answer-field/id #uuid "0e139fa0-76a4-5594-9a74-4a4f77cb4697" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496078}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "573468a3-fb63-5275-a038-70008c621f95" :question/math-academy-id "q-52512" :question/problem "Given $h(x)=\\frac{\\sqrt{2x+7}}{\\sqrt{x-7}},$ find $h(10).$" :question/worked-solution "We replace $x$ with $10$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}h(10) & =\\frac{\\sqrt{2x+7}}{\\sqrt{x-7}} \\\\  & =\\frac{\\sqrt{2(10)+7}}{\\sqrt{10-7}} \\\\  & =\\frac{\\sqrt{27}}{\\sqrt{3}} \\\\  & =\\sqrt{\\frac{27}{3}} \\\\  & =\\sqrt{9} \\\\  & =3\\end{aligned}\n$$"} :step/id #uuid "e6f4c530-f04a-5bc2-97fa-36f196867ced" :step/next {:db/id #edb/ref 17592186496373}} {:db/id #edb/ref 17592186496388 :step/content {:db/id #edb/ref 17592186496302 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4218e341-ec0e-58d8-ace2-9ffbfc437a65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\sqrt{3}" :db/id #edb/ref 17592186495662} {:answer/id #uuid "4f5cadc9-e3f7-5691-bddf-0c37a865c6eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\sqrt{3}" :db/id #edb/ref 17592186495693} {:answer/id #uuid "990ec7ed-3f19-5a4a-ad58-9fa197948fcb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\sqrt{2}" :db/id #edb/ref 17592186495853} {:answer/id #uuid "f01f2406-67a2-5187-84d4-8c436902d153" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186496036} {:answer/id #uuid "f72c64eb-800b-5870-8d96-1200b7f9c0d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186496049}] :answer-field/correct {:db/id #edb/ref 17592186496036} :answer-field/id #uuid "9748a26e-5f17-5d21-9edf-d14cdccf2bde" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496149}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bbba28e1-c797-5200-af1b-5dd4807a9f53" :question/math-academy-id "q-82110" :question/problem "Evaluate $\\sqrt{x-3}$ for $x=15.$" :question/worked-solution "We replace $x$ with $15$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}\\sqrt{x-3} & = \\\\ \\sqrt{15-3} & = \\\\ \\sqrt{12}\\end{aligned}\n$$\n\nWe can simplify even further using the product rule:\n\n$$\n\\begin{aligned}\\sqrt{12} & = \\\\ \\sqrt{4\\cdot 3} & = \\\\ \\sqrt{{2}^{2}\\cdot 3} & = \\\\ \\sqrt{{2}^{2}}\\cdot \\sqrt{3} & = \\\\ 2\\sqrt{3}\\end{aligned}\n$$"} :step/id #uuid "fa7076ba-9b61-52c4-ac56-c8c93c105064" :step/next {:db/id #edb/ref 17592186496365}}] :activity/title "Evaluating Algebraic Radical Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186495497}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186111531} :activity/id #uuid "812cb5a9-d9bb-5df5-bcad-60b2e4bca49c" :activity/scope {:db/id #edb/ref 17592186049059 :topic/id #uuid "d690f7fb-8ed3-54e1-86b0-fda3f8281846" :topic/math-academy-id 1457} :activity/steps [{:db/id #edb/ref 17592186111523 :step/content {:db/id #edb/ref 17592186110616 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110506 :question/id #uuid "17173a8a-f28b-5456-8dbb-eb80d6d3cb1c" :question/math-academy-id "e-4713"} :knowledge-point/id #uuid "bd2dc211-25cb-5975-a665-f1f6ffd52488" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048683} {:db/id #edb/ref 17592186049861} {:db/id #edb/ref 17592186050927}] :knowledge-point/questions [{:db/id #edb/ref 17592186111375} {:db/id #edb/ref 17592186111378} {:db/id #edb/ref 17592186234249} {:db/id #edb/ref 17592186486366} {:db/id #edb/ref 17592186486371} {:db/id #edb/ref 17592186486431} {:db/id #edb/ref 17592186502081} {:db/id #edb/ref 17592186502113} {:db/id #edb/ref 17592186502124} {:db/id #edb/ref 17592186547022}] :knowledge-point/title "Combining Various Product and Quotient Rules of Exponents"} :step/id #uuid "e1f34a4c-5543-5841-9a26-631425dd8218" :step/math-academy-id 17217 :step/next {:db/id #edb/ref 17592186111524}} {:db/id #edb/ref 17592186111524 :step/content {:db/id #edb/ref 17592186110617 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110507 :question/id #uuid "f145655c-ed98-578d-b7ab-7b18bfbfa107" :question/math-academy-id "e-4714"} :knowledge-point/id #uuid "aaba81d3-d555-5dc8-a904-f0f7e9520225" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050697}] :knowledge-point/questions [{:db/id #edb/ref 17592186111379} {:db/id #edb/ref 17592186111380} {:db/id #edb/ref 17592186486461}] :knowledge-point/title "Combining the Power Rule of Exponents With Other Rules"} :step/id #uuid "869d7516-5f01-5ae5-8aa5-fa957c225b74" :step/math-academy-id 17218} {:db/id #edb/ref 17592186111525 :step/content {:db/id #edb/ref 17592186110618 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110508 :question/id #uuid "43141ab7-5ebf-5175-a512-e04f6646978d" :question/math-academy-id "e-4752"} :knowledge-point/id #uuid "376ceac4-b0bb-5178-81e9-38e724cceaee" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049081} {:db/id #edb/ref 17592186050668}] :knowledge-point/questions [{:db/id #edb/ref 17592186111376} {:db/id #edb/ref 17592186111377} {:db/id #edb/ref 17592186486360} {:db/id #edb/ref 17592186486448}] :knowledge-point/title "Combining the Product and Quotient Rules of Exponents"} :step/id #uuid "99b9d947-8b7b-5e8a-a9e4-9d2b3a2979a2" :step/math-academy-id 17336 :step/next {:db/id #edb/ref 17592186111523}} {:db/id #edb/ref 17592186111531 :step/content {:db/id #edb/ref 17592186111884 :tutorial/content "Let's recap some of the rules for exponents.\n\n- **Product rule**: to multiply powers of the same base, add the exponents.\n\n- **Quotient rule**: to divide powers of the same base, subtract the exponents.\n\n- **Power rule**: to raise a power to another power, multiply the exponents.\n\n- **Power of product rule**: to raise the product of two numbers to a power, raise each number to that power, and then multiply.\n\n- **Power of quotient rule**: to raise a fraction to a power, raise both the numerator and the denominator to that power.\n\nWe can use a combination of these rules to simplify expressions containing exponents. Let's see an example of this." :tutorial/id #uuid "7c442391-b257-5c16-9fe0-292a45e3c172" :tutorial/math-academy-id 3275 :tutorial/title "Introduction"} :step/id #uuid "8150e1a1-0f41-5dc7-a1db-5e474331d638" :step/math-academy-id 17999 :step/next {:db/id #edb/ref 17592186111525}}] :activity/title "Combining the Rules of Exponents" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110829}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186502198} :activity/id #uuid "890e7c6c-adee-5d25-828e-7834d97d256f" :activity/scope {:db/id #edb/ref 17592186049059 :topic/id #uuid "d690f7fb-8ed3-54e1-86b0-fda3f8281846" :topic/math-academy-id 1457} :activity/steps [{:db/id #edb/ref 17592186502168 :step/content {:db/id #edb/ref 17592186111380 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41468d21-4c10-5a19-948e-44ada7c0a123" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{6}^{3}}{{4}