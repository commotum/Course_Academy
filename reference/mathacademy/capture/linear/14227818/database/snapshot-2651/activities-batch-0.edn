{:db/id #edb/ref 17592186045498} :answer/value "{6}^{3}\\cdot {8}^{8}" :db/id #edb/ref 17592186501680} {:answer/id #uuid "a8011c4e-cb58-515e-9fe0-ab3c788f1478" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6}^{8}\\cdot {8}^{3}" :db/id #edb/ref 17592186501793} {:answer/id #uuid "cf81bb58-a87f-5a0e-91a5-9f5976da0085" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6}^{2}\\cdot {8}^{3}" :db/id #edb/ref 17592186501878} {:answer/id #uuid "d2f55899-6b14-567d-959e-9963101cb1f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6}^{3}\\cdot {8}^{3}" :db/id #edb/ref 17592186501885}] :answer-field/correct {:db/id #edb/ref 17592186501793} :answer-field/id #uuid "11312e6f-7278-523b-b492-30e222c5f5a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186501980}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8bec425d-e327-5350-ad55-2bf5d8347c9a" :question/math-academy-id "q-100757" :question/problem "${(6\\cdot 8)}^{3}\\cdot {6}^{5}=$" :question/worked-solution "First, we rewrite the second factor using the power of product rule:\n\n$$\n{(6\\cdot 8)}^{3}\\cdot {6}^{5}={6}^{3}\\cdot {8}^{3}\\cdot {6}^{5}\n$$\n\nFinally, we apply the product rule for exponents, and simplify:\n\n$$\n\\begin{aligned}{6}^{3}\\cdot {8}^{3}\\cdot {6}^{5} & ={6}^{3}\\cdot {6}^{5}\\cdot {8}^{3} \\\\  & ={6}^{3+5}\\cdot {8}^{3} \\\\  & ={6}^{8}\\cdot {8}^{3}\\end{aligned}\n$$"} :step/id #uuid "2d32c85e-20d0-5fd2-a609-287a06932ccb"} {:db/id #edb/ref 17592186502179 :step/content {:db/id #edb/ref 17592186502113 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d4c53a1-b239-5b29-8440-f632e3a00d66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{4}\\cdot {3}^{7}" :db/id #edb/ref 17592186501546} {:answer/id #uuid "6fa97fff-f307-512a-a0df-4801533ea472" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\cdot {3}^{2}" :db/id #edb/ref 17592186501671} {:answer/id #uuid "84236fbb-6291-5f93-81e2-cd38a8816289" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{7}\\cdot {3}^{4}" :db/id #edb/ref 17592186501719} {:answer/id #uuid "c6a0ea31-2173-5c5d-9e00-40527e7cf292" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{12}\\cdot {3}^{2}" :db/id #edb/ref 17592186501862} {:answer/id #uuid "fb321c56-57a3-55ec-b817-8c07ac7ecf7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{3}\\cdot {5}^{4}" :db/id #edb/ref 17592186501965}] :answer-field/correct {:db/id #edb/ref 17592186501719} :answer-field/id #uuid "88004d56-effe-5e83-a749-a2b7c08b3fa4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502022}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6ef8e162-2bcb-5b53-83cc-147de68407b1" :question/math-academy-id "q-68952" :question/problem "${2}^{3}\\cdot {(3\\cdot 2)}^{4}=$" :question/worked-solution "First, we rewrite the second factor using the power of product rule:\n\n$$\n{2}^{3}\\cdot {(3\\cdot 2)}^{4}={2}^{3}\\cdot {3}^{4}\\cdot {2}^{4}\n$$\n\nFinally, we apply the product rule for exponents, and simplify:\n\n$$\n\\begin{aligned}{2}^{3}\\cdot {3}^{4}\\cdot {2}^{4} & ={2}^{3}\\cdot {2}^{4}\\cdot {3}^{4} \\\\  & ={2}^{3+4}\\cdot {3}^{4} \\\\  & ={2}^{7}\\cdot {3}^{4}\\end{aligned}\n$$"} :step/id #uuid "49308f5f-8de3-5dbe-bf1a-8b336864e19e" :step/next {:db/id #edb/ref 17592186502168}} {:db/id #edb/ref 17592186502198 :step/content {:db/id #edb/ref 17592186502081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a73b112-23d9-5ce7-b7f6-9cc9b1ea6ba3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{7}\\cdot {3}^{-2}" :db/id #edb/ref 17592186501541} {:answer/id #uuid "5173cabb-209f-59b0-bb30-f3195ff21e04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{7}\\cdot {3}^{3}" :db/id #edb/ref 17592186501614} {:answer/id #uuid "6b8cacfb-384f-5813-911b-4115a5b7ba6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{7}\\cdot {3}^{2}" :db/id #edb/ref 17592186501667} {:answer/id #uuid "8d016a81-6b30-515f-b97d-3efba5f2f640" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{7}\\cdot 3" :db/id #edb/ref 17592186501737} {:answer/id #uuid "f91702ba-eae7-53c8-b6a7-9bd48502b51b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{7}" :db/id #edb/ref 17592186501961}] :answer-field/correct {:db/id #edb/ref 17592186501667} :answer-field/id #uuid "bf72de5c-8edd-59cf-9c2b-dc6c69c9659d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502043}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "22282018-2ca4-523a-8e4c-90a2c94b5770" :question/math-academy-id "q-68493" :question/problem "${(\\frac{2}{3})}^{7}\\cdot {3}^{9}=$" :question/worked-solution "First, we rewrite the first factor using the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{2}{3})}^{7}\\cdot {3}^{9}=\\frac{{2}^{7}}{{3}^{7}}\\cdot {3}^{9}\\end{aligned}\n$$\n\nNext, we rewrite the fractional part of our expression as follows:\n\n$$\n\\frac{{2}^{7}}{{3}^{7}}\\cdot {3}^{9}={2}^{7}\\cdot \\frac{{3}^{9}}{{3}^{7}}\n$$\n\nFinally, we simplify using the quotient rule for exponents:\n\n$$\n{2}^{7}\\cdot \\frac{{3}^{9}}{{3}^{7}}={2}^{7}\\cdot {3}^{9-7}={2}^{7}\\cdot {3}^{2}\n$$"} :step/id #uuid "ad914d59-631f-5b15-8d69-7505a90e3736" :step/next {:db/id #edb/ref 17592186502179}}] :activity/title "Combining the Rules of Exponents" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186501456}] [{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186180332} :activity/id #uuid "dbe3fe78-cdde-54f2-83c4-33d9a9c37637" :activity/scope {:db/id #edb/ref 17592186049734 :topic/id #uuid "0f38dc01-8b15-5428-9965-6c74ccac2918" :topic/math-academy-id 3752} :activity/steps [{:db/id #edb/ref 17592186180332 :step/content {:db/id #edb/ref 17592186180781 :tutorial/content "When solving a multivariable equation for a particular variable, we sometimes have to factor some terms in the equation to reach the solution.\n\nFor example, let's solve the following equation for the variable $d\\mathbin{:}$\n\n$$\n2cd - 3d = 5\n$$\n\nFirst, we factor out $d$ in the expression on the left-hand side. This gives\n\n$$\nd(2c-3) = 5.\n$$\n\nThen, we divide both sides of the equation by $(2c-3)$ to isolate $d\\mathbin{:}$\n\n$$\n\\begin{aligned}d(2c-3) & =5 \\\\ \\frac{d(2c-3)}{2c-3} & =\\frac{5}{2c-3} \\\\ \\frac{d\\cancel{(2c-3)}}{\\cancel{2c-3}} & =\\frac{5}{2c-3} \\\\ d & =\\frac{5}{2c-3}\\end{aligned}\n$$\n\n**Note:** This result assumes that $2c-3\\neq 0.$" :tutorial/id #uuid "46409ede-9b62-5196-b665-c5ba29062b0d" :tutorial/math-academy-id 8665 :tutorial/title "Introduction"} :step/id #uuid "3089dcee-65bb-5662-9c1b-2bc3b1fd5a0d" :step/math-academy-id 952850 :step/next {:db/id #edb/ref 17592186180333}} {:db/id #edb/ref 17592186180333 :step/content {:db/id #edb/ref 17592186179639 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179467 :question/id #uuid "ae7ee9c8-3162-564e-a3f2-f235b60527f7" :question/math-academy-id "e-13903"} :knowledge-point/id #uuid "eade8768-b97c-5e90-ad02-255b9e8f8dae" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048649} {:db/id #edb/ref 17592186050843} {:db/id #edb/ref 17592186051079}] :knowledge-point/questions [{:db/id #edb/ref 17592186180062} {:db/id #edb/ref 17592186180119} {:db/id #edb/ref 17592186488221} {:db/id #edb/ref 17592186488249}] :knowledge-point/title "Solving Linear Equations by Factoring"} :step/id #uuid "3b5ddf75-036b-5e27-b8bd-3c9f15c022b4" :step/math-academy-id 952851 :step/next {:db/id #edb/ref 17592186180334}} {:db/id #edb/ref 17592186180334 :step/content {:db/id #edb/ref 17592186179640 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179469 :question/id #uuid "7f0aa09d-c765-5ab5-ac89-3fb4ce168d90" :question/math-academy-id "e-13905"} :knowledge-point/id #uuid "3fc2b01b-a60c-53a7-837e-1c6d9a941e98" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049181}] :knowledge-point/questions [{:db/id #edb/ref 17592186180135} {:db/id #edb/ref 17592186180230} {:db/id #edb/ref 17592186488179} {:db/id #edb/ref 17592186488267} {:db/id #edb/ref 17592186492851} {:db/id #edb/ref 17592186492857} {:db/id #edb/ref 17592186492921}] :knowledge-point/title "Solving Linear Equations With Variables on Both Sides"} :step/id #uuid "73aa52b5-b1eb-5d43-851b-e4c810c2ef00" :step/math-academy-id 952855 :step/next {:db/id #edb/ref 17592186180335}} {:db/id #edb/ref 17592186180335 :step/content {:db/id #edb/ref 17592186179641 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179471 :question/id #uuid "f9e1e805-32a3-5d25-8b09-36707350ab61" :question/math-academy-id "e-13907"} :knowledge-point/id #uuid "b201f4cd-b39c-5ca5-9565-0618859cd15a" :knowledge-point/questions [{:db/id #edb/ref 17592186180120} {:db/id #edb/ref 17592186180136} {:db/id #edb/ref 17592186233426} {:db/id #edb/ref 17592186488213} {:db/id #edb/ref 17592186488231} {:db/id #edb/ref 17592186492870}] :knowledge-point/title "Solving Linear Equations Using Cross Multiplication"} :step/id #uuid "8792ecc7-4ffa-5de3-b84a-5c51e5d91d42" :step/math-academy-id 952859}] :activity/title "Solving Linear Equations With Unknown Coefficients by Factoring" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179895}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186492991} :activity/id #uuid "b35e3a1b-0166-5516-8aa0-8b1121392270" :activity/scope {:db/id #edb/ref 17592186049734 :topic/id #uuid "0f38dc01-8b15-5428-9965-6c74ccac2918" :topic/math-academy-id 3752} :activity/steps [{:db/id #edb/ref 17592186492942 :step/content {:db/id #edb/ref 17592186492921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b902175b-6032-5abd-b89d-ba04a4e007bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5q-8}" :db/id #edb/ref 17592186492588}] :answer-field/correct {:db/id #edb/ref 17592186492588} :answer-field/id #uuid "2f144f7c-581f-5a2e-8b69-cd844d062564" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186492721}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f0804f3e-fd28-56db-8f75-05c9b0dc9357" :question/math-academy-id "q-215770" :question/problem "If $5pq=1+8p,$ then $p=${{field-1}}." :question/worked-solution "We need to isolate all terms with $p$ on one side of the equation. To do this, we subtract $8p$ from both sides:\n\n$$\n\\begin{aligned}5pq & =1+8p \\\\ 5pq-8p & =1+8p-8p \\\\ 5pq-8p & =1\\end{aligned}\n$$\n\nNotice that all terms containing $p$ are on the left-hand side, and all terms independent of $p$ are on the right-hand side.\n\nNext, we factor out $p$ in the expression on the left-hand side.\n\n$$\n\\begin{aligned}5pq-8p & =1 \\\\ (5q-8)p & =1\\end{aligned}\n$$\n\nFinally, we divide both sides by $(5q-8)$ to isolate $p:$\n\n$$\n\\begin{aligned}(5q-8)p & =1 \\\\ \\frac{(5q-8)p}{5q-8} & =\\frac{1}{5q-8} \\\\ \\frac{\\cancel{(5q-8)}p}{\\cancel{5q-8}} & =\\frac{1}{5q-8} \\\\ p & =\\frac{1}{5q-8}\\end{aligned}\n$$\n\n**Note:** This result assumes that $5q-8\\ne 0.$"} :step/id #uuid "393d58c8-b803-5dd1-8f8b-d2a9adb7e4fd" :step/next {:db/id #edb/ref 17592186492999}} {:db/id #edb/ref 17592186492974 :step/content {:db/id #edb/ref 17592186492851 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16558bc4-6554-5913-bf18-952e26ae16e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{f+7}{11f-4}" :db/id #edb/ref 17592186492258} {:answer/id #uuid "27236521-7973-56f9-87e0-9e36f16e6909" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{f-11}{7f-4}" :db/id #edb/ref 17592186492296} {:answer/id #uuid "272872da-d0aa-5122-b591-cb63db2b1fd4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{f+11}{7f-4}" :db/id #edb/ref 17592186492297} {:answer/id #uuid "4bd79e1c-2bd0-5b12-8d18-2f49a2dfbe20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{f-7}{11f-4}" :db/id #edb/ref 17592186492364} {:answer/id #uuid "c87c5036-7ee4-5a07-b18a-2234e9e8e8d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7f}{11f-4}" :db/id #edb/ref 17592186492617}] :answer-field/correct {:db/id #edb/ref 17592186492364} :answer-field/id #uuid "ef959e6c-abd2-51af-b36c-77958fb6ba0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492808}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3e267a47-5572-5324-88e0-0916a71d377e" :question/math-academy-id "q-133848" :question/problem "If $11fg+7=f+4g,$ then $g=$" :question/worked-solution "We need to isolate all terms with $g$ on one side of the equation. To do this, we start by subtracting $7$ from both sides: \n\n$$\n\\begin{aligned}11fg+7 & =f+4g \\\\ 11fg+7-7 & =f+4g-7 \\\\ 11fg & =f+4g-7\\end{aligned}\n$$\n\nNext, we subtract $4g$ from both sides of the equation:\n\n$$\n\\begin{aligned}11fg & =f+4g-7 \\\\ 11fg-4g & =f+4g-7-4g \\\\ 11fg-4g & =f-7\\end{aligned}\n$$\n\nNotice that all terms containing $g$ are on the left-hand side, and all terms independent of $g$ are on the right-hand side.\n\nThen, we factor out $g$ in the expression on the left-hand side.\n\n$$\n\\begin{aligned}11fg-4g & =f-7 \\\\ g(11f-4) & =f-7\\end{aligned}\n$$\n\nFinally, we divide both sides by $(11f-4)$ to isolate $g:$\n\n$$\n\\begin{aligned}g(11f-4) & =f-7 \\\\ \\frac{g(11f-4)}{11f-4} & =\\frac{f-7}{11f-4} \\\\ \\frac{g\\cancel{(11f-4)}}{\\cancel{11f-4}} & =\\frac{f-7}{11f-4} \\\\ g & =\\frac{f-7}{11f-4}\\end{aligned}\n$$\n\n**Note:** This result assumes that $11f-4\\ne 0.$"} :step/id #uuid "a17be8bf-d2ce-5f25-87af-9e999ef8b896" :step/next {:db/id #edb/ref 17592186492942}} {:db/id #edb/ref 17592186492991 :step/content {:db/id #edb/ref 17592186492857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "014429d8-b013-59f0-9ef9-dceaaf7c1a8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{2g-3}" :db/id #edb/ref 17592186492224} {:answer/id #uuid "37e76a90-f6df-5aa4-9537-258eef7d84ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2g+1}{3}" :db/id #edb/ref 17592186492336} {:answer/id #uuid "43633fbd-1329-596c-93e7-dc24c7abbb5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3g+2}" :db/id #edb/ref 17592186492352} {:answer/id #uuid "57feefc7-e907-5471-a117-f1cad8eea4eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3g+2}{2}" :db/id #edb/ref 17592186492385} {:answer/id #uuid "de9c99ca-2c92-5c32-84c7-e35e8e18c3ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3g+2}" :db/id #edb/ref 17592186492651}] :answer-field/correct {:db/id #edb/ref 17592186492651} :answer-field/id #uuid "6205bf4c-4b47-54d9-8d23-7d84c77677a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492745}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4e9751ba-f740-5aab-b93b-fcf4271231ee" :question/math-academy-id "q-101832" :question/problem "If $1-3fg=2f-1,$ then $f=$" :question/worked-solution "We need to isolate all terms with $f$ on one side of the equation. To do this, we start by subtracting $1$ from both sides: \n\n$$\n\\begin{aligned}1-3fg & =2f-1 \\\\ 1-3fg-1 & =2f-1-1 \\\\ -3fg & =2f-2\\end{aligned}\n$$\n\nNext, we subtract $2f$ from both sides of the equation:\n\n$$\n\\begin{aligned}-3fg & =2f-2 \\\\ -3fg-2f & =2f-2-2f \\\\ -3fg-2f & =-2\\end{aligned}\n$$\n\nNotice that all terms containing $f$ are on the left-hand side, and all terms independent of $f$ are on the right-hand side.\n\nNext, we factor out $f$ in the expression on the left-hand side.\n\n$$\n\\begin{aligned}-3fg-2f & =-2 \\\\ f(-3g-2) & =-2\\end{aligned}\n$$\n\nFinally, we divide both sides by $(-3g-2)$ to isolate $f:$\n\n$$\n\\begin{aligned}f(-3g-2) & =-2 \\\\ \\frac{f(-3g-2)}{-3g-2} & =\\frac{-2}{-3g-2} \\\\ \\frac{f\\cancel{(-3g-2)}}{\\cancel{-3g-2}} & =\\frac{-2}{-(3g+2)} \\\\ f & =\\frac{2}{3g+2}\\end{aligned}\n$$\n\n**Note:** This result assumes that $3g+2\\ne 0.$"} :step/id #uuid "c1b90b91-ff5b-52bb-aa5d-786d8f31778b" :step/next {:db/id #edb/ref 17592186492974}} {:db/id #edb/ref 17592186492999 :step/content {:db/id #edb/ref 17592186492870 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35f1e89f-7b21-5fb2-aeee-c538c33cdaff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{12p+15}" :db/id #edb/ref 17592186492331}] :answer-field/correct {:db/id #edb/ref 17592186492331} :answer-field/id #uuid "b2ac98ce-4a52-56e4-b996-e489a99ca79a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186492776}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7040b2b2-59d1-533f-a002-d851f289f8ef" :question/math-academy-id "q-215794" :question/problem "If $\\frac{4pq+5}{5}=\\frac{4-3q}{3},$ then $q=${{field-1}}." :question/worked-solution "We need to isolate all terms with $q$ on one side of the equation. To do this, we first cross-multiply:\n\n$$\n\\begin{aligned}\\frac{4pq+5}{5} & =\\frac{4-3q}{3} \\\\ 3\\cdot (4pq+5) & =5\\cdot (4-3q) \\\\ 12pq+15 & =20-15q\\end{aligned}\n$$\n\nNext, we add $15q$ to both sides of the equation:\n\n$$\n\\begin{aligned}12pq+15 & =20-15q \\\\ 12pq+15+15q & =20-15q+15q \\\\ 12pq+15+15q & =20\\end{aligned}\n$$\n\nThen, we subtract $15$ from both sides of the equation:\n\n$$\n\\begin{aligned}12pq+15+15q & =20 \\\\ 12pq+15+15q-15 & =20-15 \\\\ 12pq+15q & =5\\end{aligned}\n$$\n\nNotice that all terms containing $q$ are on the left-hand side, and all terms independent of $q$ are on the right-hand side.\n\nThen, we factor out $q$ from the left-hand side:\n\n$$\n\\begin{aligned}12pq+15q & =5 \\\\ (12p+15)q & =5\\end{aligned}\n$$\n\nFinally, we divide both sides by $(12p+15)$ to isolate $q:$\n\n$$\n\\begin{aligned}(12p+15)q & =5 \\\\ \\frac{(12p+15)q}{12p+15} & =\\frac{5}{12p+15} \\\\ \\frac{\\cancel{(12p+15)}q}{\\cancel{12p+15}} & =\\frac{5}{12p+15} \\\\ q & =\\frac{5}{12p+15}\\end{aligned}\n$$\n\n**Note:** This result assumes that $12p+15\\ne 0.$"} :step/id #uuid "e1e772cc-8c6c-589d-97d1-c78fa38dd9e0"}] :activity/title "Solving Linear Equations With Unknown Coefficients by Factoring" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186492213}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055780} :activity/id #uuid "a6abcd14-76de-59df-adaa-1dc632470883" :activity/scope {:db/id #edb/ref 17592186049986 :topic/id #uuid "2424a53c-3dea-5c8f-aeb6-365cf563d5f2" :topic/math-academy-id 38} :activity/steps [{:db/id #edb/ref 17592186055780 :step/content {:db/id #edb/ref 17592186056020 :tutorial/content "Let's consider the following inequality:\n\n$$\nx + 4 < 7\n$$\n\nTo **solve** this inequality, we need to isolate the variable $x$ on one side.\n\nInequalities are just like equations because they can be solved using the addition and multiplication principles.\n\nSo, to solve this inequality, we subtract $4$ from both sides:\n\n$$\n\\begin{aligned}x+4 & <7 \\\\ x+4-4 & <7-4 \\\\ x & <3\\end{aligned}\n$$\n\nThe solution is $x < 3.$ This tells us that any value of $x$ smaller than $3$ satisfies the original inequality.\n\nWe can represent the solution to this inequality using a number line as follows:\n\n![](images/55/556401d043fbd285a42b257e3c32f0a858377355674c264b90396e43ca8a8a13.png)\n\nLet's take a look at an inequality that we can solve using the multiplication principle." :tutorial/id #uuid "63426fbc-7f6c-516c-a3e9-9f1262862928" :tutorial/math-academy-id 8099 :tutorial/title "Introduction"} :step/id #uuid "5d1cc5da-4e34-51ae-843a-e59df07e8c64" :step/math-academy-id 52055 :step/next {:db/id #edb/ref 17592186055781}} {:db/id #edb/ref 17592186055781 :step/content {:db/id #edb/ref 17592186054769 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054399 :question/id #uuid "121c55cc-404a-53e7-81f7-6edba34b0796" :question/math-academy-id "e-12956"} :knowledge-point/id #uuid "bf8a6a4f-38ce-5ece-bdcb-6f2b58e2605c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048725} {:db/id #edb/ref 17592186050361} {:db/id #edb/ref 17592186050613}] :knowledge-point/questions [{:db/id #edb/ref 17592186055018} {:db/id #edb/ref 17592186055019} {:db/id #edb/ref 17592186489177} {:db/id #edb/ref 17592186489254}] :knowledge-point/title "Solving a One-Step Inequality"} :step/id #uuid "9e6e8c20-c9b3-5288-8894-994f1e8693a4" :step/math-academy-id 52056 :step/next {:db/id #edb/ref 17592186055782}} {:db/id #edb/ref 17592186055782 :step/content {:db/id #edb/ref 17592186056021 :tutorial/content "We've seen that solving linear inequalities is similar to solving linear equations.\n\nHowever, there is one additional rule that we need to remember when solving inequalities:\n\n*When multiplying or dividing both sides by a **negative number**, we flip the inequality sign.*\n\nWhen we \"flip the inequality sign,\" we switch the direction of the inequality symbol. For example:\n\n- \"$\\color{blue}<$\" becomes \"$\\color{red}>$\" and vice versa\n\n- \"$\\color{blue}\\leq$\" becomes \"$\\color{red}\\geq$\" and vice versa\n\nTo illustrate, consider the following inequality:\n\n$$\n- 3x \\gt 9\n$$\n\nWe can solve this inequality using the multiplication principle. However, when we divide both sides by $-3,$ we have to flip the inequality sign. \n\n$$\n\\begin{aligned}-3x\\,\\, & >\\,\\,9 \\\\ \\frac{-3x}{-3}\\,\\, & <\\,\\,\\frac{9}{-3} \\\\ \\frac{-3x}{-3}\\,\\, & <\\,\\,-3 \\\\ \\frac{\\cancel{-3}x}{\\cancel{-3}}\\,\\, & <\\,\\,-3 \\\\ x\\,\\, & <\\,\\,-3\\end{aligned}\n$$\n\nTherefore, the solution is $x \\lt -3.$\n\nWe'll discuss why we need to flip the inequality sign at the end of the lesson. But for now, let's get some practice at applying this idea." :tutorial/id #uuid "2c47a872-da72-51b3-ac92-ef955acc3f08" :tutorial/math-academy-id 8100 :tutorial/title "Multiplying or Dividing an Inequality by a Negative Number"} :step/id #uuid "cb7661d0-6da1-518d-9228-3db6e6b0cead" :step/math-academy-id 52059 :step/next {:db/id #edb/ref 17592186055783}} {:db/id #edb/ref 17592186055783 :step/content {:db/id #edb/ref 17592186054770 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054400 :question/id #uuid "7424a287-2269-5044-abb7-1004b3826aca" :question/math-academy-id "e-12957"} :knowledge-point/id #uuid "281841fb-287e-597a-abb1-3917212e0dcb" :knowledge-point/questions [{:db/id #edb/ref 17592186055024} {:db/id #edb/ref 17592186055201} {:db/id #edb/ref 17592186489248} {:db/id #edb/ref 17592186489269} {:db/id #edb/ref 17592186489281} {:db/id #edb/ref 17592186489283} {:db/id #edb/ref 17592186507405} {:db/id #edb/ref 17592186507412} {:db/id #edb/ref 17592186536841}] :knowledge-point/title "Solving a One-Step Inequality When Flipping Is Required"} :step/id #uuid "18957d57-5792-5701-b6f4-614dc92db70f" :step/math-academy-id 52060 :step/next {:db/id #edb/ref 17592186055784}} {:db/id #edb/ref 17592186055784 :step/content {:db/id #edb/ref 17592186054771 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054401 :question/id #uuid "82a9a75f-ab0e-54c3-9a0d-82c8497714cb" :question/math-academy-id "e-12958"} :knowledge-point/id #uuid "200fc394-b299-5114-8f39-e6265f3c1166" :knowledge-point/questions [{:db/id #edb/ref 17592186055021} {:db/id #edb/ref 17592186055025} {:db/id #edb/ref 17592186489193} {:db/id #edb/ref 17592186489197}] :knowledge-point/title "Solving a One-Step Inequality With Fractions When Flipping Is Required"} :step/id #uuid "0607f740-0035-5986-a51a-77aa35a3ca25" :step/math-academy-id 52063 :step/next {:db/id #edb/ref 17592186055785}} {:db/id #edb/ref 17592186055785 :step/content {:db/id #edb/ref 17592186054772 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054402 :question/id #uuid "1154ded3-0841-5358-980c-15c0f1841e82" :question/math-academy-id "e-12959"} :knowledge-point/id #uuid "b6b0cad0-354b-5c4c-9fe2-3aceff7e5b6e" :knowledge-point/questions [{:db/id #edb/ref 17592186055020} {:db/id #edb/ref 17592186055022} {:db/id #edb/ref 17592186055023} {:db/id #edb/ref 17592186489185} {:db/id #edb/ref 17592186507499} {:db/id #edb/ref 17592186536866}] :knowledge-point/title "Solving an Inequality and Adjusting the Final Result"} :step/id #uuid "351bf5fa-de4c-5dd3-b946-23f3767c42b1" :step/math-academy-id 52066 :step/next {:db/id #edb/ref 17592186055786}} {:db/id #edb/ref 17592186055786 :step/content {:db/id #edb/ref 17592186056022 :tutorial/content "We'll now learn why we must flip the inequality sign when multiplying or dividing an inequality by a negative number. \n\nTo help us, let's consider the following inequality:\n\n$$\n6 > 0\n$$\n\n \n\nThis is a true statement, and it remains true if we multiply or divide both sides by a positive number. \n\nFor example:\n\n- Multiplying the inequality by $2$ gives $12 > 0,$ which is *true*.$\\quad{\\color{green}{\\checkmark}}$\n\n- Dividing the inequality by $2$ gives $3 > 0,$ which is also *true*. $\\quad{\\color{green}{\\checkmark}}$\n\nHowever, if we multiply or divide both sides by a negative number, *without* flipping the inequality sign, we get a false statement.\n\nFor example:\n\n- Multiplying the inequality by $-2$ *without flipping the inequality sign* gives $-12 > 0,$ which is *false*. $\\quad{\\color{red}{\\times}}$\n\n- Dividing the inequality by $-2$ *without flipping the inequality sign* gives $-3 > 0,$ which is also *false*. $\\quad{\\color{red}{\\times}}$\n\nSo, whenever we multiply or divide by a negative number, we need to flip the sign of the inequality for it to remain true.\n\n- Multiplying the inequality by $-2$ *and flipping the inequality sign* gives $-12 < 0,$ which is *true*. $\\quad{\\color{green}{\\checkmark}}$\n\n- Dividing the inequality by $-2$ *and flipping the sign* gives $-3 < 0,$ which is also *true*. $\\quad{\\color{green}{\\checkmark}}$" :tutorial/id #uuid "f9eacf1c-4f75-5dfe-a8e7-798404a6280d" :tutorial/math-academy-id 8101 :tutorial/title "Why We Flip the Inequality Sign"} :step/id #uuid "e300a5cf-0bdb-5c23-9a03-3bb60a12a788" :step/math-academy-id 52070}] :activity/title "Solving One-Step Linear Inequalities" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054900}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186507531} :activity/id #uuid "f76e562d-eefb-5f49-ba13-fb8a997a1b70" :activity/scope {:db/id #edb/ref 17592186049986 :topic/id #uuid "2424a53c-3dea-5c8f-aeb6-365cf563d5f2" :topic/math-academy-id 38} :activity/steps [{:db/id #edb/ref 17592186507531 :step/content {:db/id #edb/ref 17592186507412 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e3dff68-6795-523f-999b-07af4af3ec70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y<6" :db/id #edb/ref 17592186506706} {:answer/id #uuid "7668d459-4f42-5919-bb7f-fa7eec09053a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y>9" :db/id #edb/ref 17592186506946} {:answer/id #uuid "9074c12a-1d5b-5242-a19c-1b503006d445" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y<9" :db/id #edb/ref 17592186506999} {:answer/id #uuid "acb62ac6-c48e-569b-a36c-c8b94883aa98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y>-9" :db/id #edb/ref 17592186507060} {:answer/id #uuid "e10be7fe-3362-55cd-9dae-30e59a1d1e04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y<-9" :db/id #edb/ref 17592186507168}] :answer-field/correct {:db/id #edb/ref 17592186507168} :answer-field/id #uuid "1301f956-a5f9-5af2-b9fc-78b855c39882" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186507253}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2d8f9e5d-ffea-59b8-9f7c-2f9037766a19" :question/math-academy-id "q-6277" :question/problem "Solve the inequality $-2y>18.$" :question/worked-solution "The variable $y$ is being *multiplied* by $-2.$ To isolate $y,$ we perform the *opposite* operation, which is *dividing* by $-2.$ Remember to perform the same operation on both sides.\n\nAlso, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-2y\\,\\, & >\\,\\,18 \\\\ \\frac{-2y}{-2}\\,\\, & <\\,\\,\\frac{18}{-2} \\\\ \\frac{-2y}{-2}\\,\\, & <\\,\\,-9\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $-2$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}\\frac{-2y}{-2} & <-9 \\\\ \\frac{\\cancel{-2}y}{\\cancel{-2}} & <-9 \\\\ y & <-9\\end{aligned}\n$$\n\nTherefore, the solution is $y<-9.$"} :step/id #uuid "015a9fb1-4671-5e91-a484-e36a765ef7c2" :step/next {:db/id #edb/ref 17592186507562}} {:db/id #edb/ref 17592186507546 :step/content {:db/id #edb/ref 17592186507405 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ddfe654-6c20-5256-8c77-e26f467b5752" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ge" :db/id #edb/ref 17592186506823}] :answer-field/correct {:db/id #edb/ref 17592186506823} :answer-field/id #uuid "844948db-6db2-5198-81c4-adc418e774dd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186507318} {:answer-field/choices [{:answer/id #uuid "6ff7601c-194b-518f-be31-b3982ec9d2d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186506935}] :answer-field/correct {:db/id #edb/ref 17592186506935} :answer-field/id #uuid "cfff5c34-1b4e-574b-b2cd-51c419fcd650" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186507368}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1670dd77-8590-5cdd-be80-9cfcce9e381b" :question/math-academy-id "q-181002" :question/problem "The solution to the inequality $-9a\\le -54$ is $a${{field-1}}{{field-2}}." :question/worked-solution "The variable $a$ is being *multiplied* by $-9.$ To isolate $a,$ we perform the *opposite* operation, which is *dividing* by $-9.$ Remember to perform the same operation on both sides.\n\nAlso, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-9a\\,\\, & \\le \\,\\,-54 \\\\ \\frac{-9a}{-9}\\,\\, & \\ge \\,\\,\\frac{-54}{-9} \\\\ \\frac{-9a}{-9}\\,\\, & \\ge \\,\\,6\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $-9$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}\\frac{-9a}{-9} & \\ge 6 \\\\ \\frac{\\cancel{-9}a}{\\cancel{-9}} & \\ge 6 \\\\ a & \\ge 6\\end{aligned}\n$$\n\nTherefore, the solution is $a\\ge 6.$"} :step/id #uuid "40b41b12-df46-55fe-92ac-57937129a72d"} {:db/id #edb/ref 17592186507562 :step/content {:db/id #edb/ref 17592186507499 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "825a3f94-5d5f-59b8-9d4e-7d0f168885a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z>-24" :db/id #edb/ref 17592186506965} {:answer/id #uuid "9bfb137d-cdc8-5e43-84c6-ea0025793bde" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z<24" :db/id #edb/ref 17592186507016} {:answer/id #uuid "a1a10480-cbf4-58a2-9e6b-17815d58cadd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z<-24" :db/id #edb/ref 17592186507026} {:answer/id #uuid "b207b853-0fed-5188-a900-3bb18b72d272" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z>\\frac{2}{3}" :db/id #edb/ref 17592186507070} {:answer/id #uuid "ef835f55-6239-5e48-941a-ae73fc43925e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z<-\\frac{2}{3}" :db/id #edb/ref 17592186507208}] :answer-field/correct {:db/id #edb/ref 17592186507026} :answer-field/id #uuid "b4490670-0ae0-5d23-9e69-8c96fae8a13a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186507356}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c8a935c4-ddf1-51df-a83c-2659ff68e2ef" :question/math-academy-id "q-154041" :question/problem "Solve the inequality $4<-\\frac{z}{6}.$" :question/worked-solution "The variable $z$ is being *divided* by $6.$ To isolate $z$ and remove the negative sign, we *multiply* by $-6$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}4\\,\\, & <\\,\\,-\\frac{z}{6} \\\\ (-6)\\cdot 4\\,\\, & >\\,\\,(-6)\\cdot (-\\frac{z}{6}) \\\\ -24\\,\\, & >\\,\\,(-6)\\cdot (-\\frac{z}{6})\\end{aligned}\n$$\n\nSince two negative numbers multiply to give a positive number, we first cancel the negatives:\n\n$$\n\\begin{aligned}-24\\,\\, & >(-6)\\cdot (-\\frac{z}{6}) \\\\ -24 & >(\\cancel{-}6)\\cdot (\\cancel{-}\\frac{z}{6}) \\\\ -24 & >6\\cdot \\frac{z}{6}\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $6$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}-24 & >6\\cdot \\frac{z}{6} \\\\ -24 & >\\frac{6z}{6} \\\\ -24 & >\\frac{\\cancel{6}z}{\\cancel{6}} \\\\ -24 & >z\\end{aligned}\n$$\n\nFinally, we rewrite the inequality with the variable on the left-hand side:\n\n$$\nz<-24\n$$\n\nTherefore, the solution is $z<-24.$"} :step/id #uuid "86fe7023-fab7-5333-bca0-7bf71a617112" :step/next {:db/id #edb/ref 17592186507546}}] :activity/title "Solving One-Step Linear Inequalities" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186506677}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186536967} :activity/id #uuid "a0296a38-e916-56a7-bb47-0737bade1abd" :activity/scope {:db/id #edb/ref 17592186049986 :topic/id #uuid "2424a53c-3dea-5c8f-aeb6-365cf563d5f2" :topic/math-academy-id 38} :activity/steps [{:db/id #edb/ref 17592186536962 :step/content {:db/id #edb/ref 17592186055021 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "249f7541-1a8a-52ec-9e0c-a25f296e0698" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge 8" :db/id #edb/ref 17592186536338} {:answer/id #uuid "55632b59-8ff0-5f33-bd84-759756febdc5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge 6" :db/id #edb/ref 17592186536432} {:answer/id #uuid "99888988-7d3e-5baa-ab4a-decbb3967954" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\le 8" :db/id #edb/ref 17592186536529} {:answer/id #uuid "ba590d86-ddb8-598a-a220-46efedf147bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge -8" :db/id #edb/ref 17592186536579} {:answer/id #uuid "e10696b4-01d9-5bd2-8740-a24555a84567" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\le -8" :db/id #edb/ref 17592186536632}] :answer-field/correct {:db/id #edb/ref 17592186536579} :answer-field/id #uuid "512b237b-81e0-5620-86e4-6c38ec6c9bc9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186051656}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "05f33d89-cfbf-5ef4-9277-aa93cd1c185b" :question/math-academy-id "q-153984" :question/problem "Solve the inequality $-\\frac{x}{2}\\le 4.$" :question/worked-solution "The variable $x$ is being *divided* by $2.$ To isolate $x$ and remove the negative sign, we *multiply* by $-2.$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-\\frac{x}{2}\\,\\, & \\le \\,\\,4 \\\\ (-2)\\cdot (-\\frac{x}{2})\\,\\, & \\ge \\,\\,(-2)\\cdot 4 \\\\ (-2)\\cdot (-\\frac{x}{2})\\,\\, & \\ge \\,\\,-8\\end{aligned}\n$$\n\nSince two negative numbers multiply to give a positive number, we first cancel the negatives:\n\n$$\n\\begin{aligned}(-2)\\cdot (-\\frac{x}{2}) & \\ge -8 \\\\ (\\cancel{-}2)\\cdot (\\cancel{-}\\frac{x}{2}) & \\ge -8 \\\\ 2\\cdot \\frac{x}{2} & \\ge -8\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $2$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}2\\cdot \\frac{x}{2} & \\ge -8 \\\\ \\frac{2x}{2} & \\ge -8 \\\\ \\frac{\\cancel{2}x}{\\cancel{2}} & \\ge -8 \\\\ x & \\ge -8\\end{aligned}\n$$\n\nTherefore, the solution is $x\\ge -8.$"} :step/id #uuid "b48eede8-bb40-5e1b-981b-25334c7cacd0"} {:db/id #edb/ref 17592186536965 :step/content {:db/id #edb/ref 17592186536866 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "360ebf0c-440b-5b80-aa5d-f220ea76cfe8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge 3" :db/id #edb/ref 17592186536367} {:answer/id #uuid "60e57476-d7c3-5931-afaa-b90f394b253b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\le -3" :db/id #edb/ref 17592186536450} {:answer/id #uuid "6395e4d6-160c-524d-bea0-39d0f0cb0acb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge 11" :db/id #edb/ref 17592186536454} {:answer/id #uuid "6e12aa20-0d6e-5360-a6c8-7346274c8177" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge -3" :db/id #edb/ref 17592186536468} {:answer/id #uuid "a9e80f2e-a321-5d67-acf6-345376f7ea8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\le 3" :db/id #edb/ref 17592186536554}] :answer-field/correct {:db/id #edb/ref 17592186536468} :answer-field/id #uuid "e410432f-86a4-50ea-8294-40d4d0eeeb2f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536794}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a6005239-b6a4-5801-8173-53f2d74d92ea" :question/math-academy-id "q-153600" :question/problem "Solve the inequality $4\\le x+7.$" :question/worked-solution "To isolate $x,$ we need to perform the *opposite* of *adding* $7,$ which is *subtracting* $7.$ Remember to perform the same operation on both sides.\n\n$$\n\\begin{aligned}4 & \\le x+7 \\\\ 4-7 & \\le x+7-7 \\\\ -3 & \\le x+0 \\\\ -3 & \\le x\\end{aligned}\n$$\n\nFinally, we rewrite the inequality with the variable on the left-hand side:\n\n$$\nx\\ge -3\n$$\n\nTherefore, the solution is $x\\ge -3.$"} :step/id #uuid "c0507717-60f0-50ac-81aa-8044cb88a14c" :step/next {:db/id #edb/ref 17592186536962}} {:db/id #edb/ref 17592186536967 :step/content {:db/id #edb/ref 17592186536841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11e4be9b-77ce-5d2c-870a-9582c9f4eacc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z\\ge \\frac{1}{5}" :db/id #edb/ref 17592186536312} {:answer/id #uuid "729d4612-b4b3-52d6-a984-56bcadb47c63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z\\le -\\frac{1}{5}" :db/id #edb/ref 17592186536474} {:answer/id #uuid "91b033fa-0ab3-5c2d-87b8-9809d0825695" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z\\ge 4" :db/id #edb/ref 17592186536517} {:answer/id #uuid "9bb97e3f-8e17-5d53-9ebf-0d14a1a104c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z\\le \\frac{1}{5}" :db/id #edb/ref 17592186536535} {:answer/id #uuid "b94c625a-806d-5398-a511-8434b5363807" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z\\ge -\\frac{1}{5}" :db/id #edb/ref 17592186536575}] :answer-field/correct {:db/id #edb/ref 17592186536312} :answer-field/id #uuid "b60c1271-2aa2-5db6-a4fc-0ced692f3cad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536775}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "60d9e1c1-b611-5995-967c-6c66ed571c82" :question/math-academy-id "q-149565" :question/problem "Solve the inequality $-5z\\le -1.$" :question/worked-solution "The variable $z$ is being *multiplied* by $-5.$ To isolate $z,$ we perform the *opposite* operation, which is *dividing* by $-5.$ Remember to perform the same operation on both sides.\n\nAlso, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-5z\\,\\, & \\le \\,\\,-1 \\\\ \\frac{-5z}{-5}\\,\\, & \\ge \\,\\,\\frac{-1}{-5} \\\\ \\frac{-5z}{-5}\\,\\, & \\ge \\,\\,\\frac{1}{5}\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $-5$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}\\frac{-5z}{-5} & \\ge \\frac{1}{5} \\\\ \\frac{\\cancel{-5}z}{\\cancel{-5}} & \\ge \\frac{1}{5} \\\\ z & \\ge \\frac{1}{5}\\end{aligned}\n$$\n\nTherefore, the solution is $z\\ge \\frac{1}{5}.$"} :step/id #uuid "c4402b05-776a-5423-af2f-f5f1a382df37" :step/next {:db/id #edb/ref 17592186536965}}] :activity/title "Solving One-Step Linear Inequalities" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186536278}] [{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186176945} :activity/id #uuid "996870da-1d36-50d4-81c0-5fbf61ea73c5" :activity/scope {:db/id #edb/ref 17592186050164 :topic/id #uuid "333ee4a3-8244-5546-a959-8bbd7343369d" :topic/math-academy-id 3554} :activity/steps [{:db/id #edb/ref 17592186176851 :step/content {:db/id #edb/ref 17592186176044 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175692 :question/id #uuid "bea49cf1-02d0-5aa0-9584-f2ea5a2eb30c" :question/math-academy-id "e-10584"} :knowledge-point/id #uuid "bf8d806a-b232-5ddd-ad0b-3af70f244194" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048213} {:db/id #edb/ref 17592186050494}] :knowledge-point/questions [{:db/id #edb/ref 17592186176450} {:db/id #edb/ref 17592186176451} {:db/id #edb/ref 17592186487316} {:db/id #edb/ref 17592186497402}] :knowledge-point/title "Solving Problems Involving Congruent Angles"} :step/id #uuid "057cde94-c55a-5403-a94e-042675ba0ae9" :step/math-academy-id 40007} {:db/id #edb/ref 17592186176945 :step/content {:db/id #edb/ref 17592186176966 :tutorial/content "Two angles are **congruent** if their measures are equal.\n\nFor example, if\n\n$$\nm\\angle X =50^\\circ \\quad \\text{and} \\ \\quad m\\angle Y=50^\\circ,\n$$\n\nthen $\\angle X$ and $\\angle Y$ are congruent. We can express this as \n\n$$\n\\angle X \\cong \\angle Y.\n$$\n\nHowever, if \n\n$$\nm\\angle X =50^\\circ \\quad \\text{and} \\ \\quad m\\angle Z = 110^\\circ,\n$$\n\nthen $\\angle X$ and $\\angle Z$ are *not* congruent, and we write \n\n$$\n\\angle X \\ncong \\angle Z.\n$$\n\nWe represent congruent angles by marking the arcs with the same symbol. For example, three pairs of congruent angles are shown below:\n\n![](images/99/997e53a399f06c3aad8391ace4172b7249890a31abeff4e72605bce607fd3bdb.png)" :tutorial/id #uuid "927a2746-94e0-5f78-985c-38429a67496b" :tutorial/math-academy-id 2184 :tutorial/title "Introduction"} :step/id #uuid "1602c522-d568-5230-b809-f60d5df74e28" :step/math-academy-id 8777 :step/next {:db/id #edb/ref 17592186176946}} {:db/id #edb/ref 17592186176946 :step/content {:db/id #edb/ref 17592186176097 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175761 :question/id #uuid "fbd1b514-35d8-54a1-91c1-168d330811e6" :question/math-academy-id "e-2605"} :knowledge-point/id #uuid "beaec0ce-eca9-5e8c-903a-6bf152b37368" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048587} {:db/id #edb/ref 17592186050512}] :knowledge-point/questions [{:db/id #edb/ref 17592186176517} {:db/id #edb/ref 17592186176518} {:db/id #edb/ref 17592186487330} {:db/id #edb/ref 17592186487404}] :knowledge-point/title "Identifying Congruent Angles Given Measures of Angles"} :step/id #uuid "eaf23fc9-d311-5210-b4e5-83bf29c1cd0f" :step/math-academy-id 8778 :step/next {:db/id #edb/ref 17592186176947}} {:db/id #edb/ref 17592186176947 :step/content {:db/id #edb/ref 17592186176098 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175762 :question/id #uuid "bab99447-be6e-5ac0-906c-a9df9aa7f3f3" :question/math-academy-id "e-2606"} :knowledge-point/id #uuid "7ca5614b-e796-5482-89c9-31410de84c33" :knowledge-point/questions [{:db/id #edb/ref 17592186176515} {:db/id #edb/ref 17592186176516} {:db/id #edb/ref 17592186487320} {:db/id #edb/ref 17592186487394}] :knowledge-point/title "Using Markings to Denote Congruent Angles"} :step/id #uuid "fe14b5e5-3934-58ec-925b-8f9569cfa306" :step/math-academy-id 8780 :step/next {:db/id #edb/ref 17592186176851}}] :activity/title "Congruent Angles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186176105}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074751} :activity/id #uuid "17691de4-8d73-56a0-9388-fcd801f22dd1" :activity/scope {:db/id #edb/ref 17592186050341 :topic/id #uuid "4116a9b1-1ae1-5c46-ab2a-fcbda7bb3a26" :topic/math-academy-id 484} :activity/steps [{:db/id #edb/ref 17592186074725 :step/content {:db/id #edb/ref 17592186073788 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073663 :question/id #uuid "e5202e06-b6a8-5d74-a395-fe7c56b8e9bb" :question/math-academy-id "e-9728"} :knowledge-point/id #uuid "1a31c2b6-585a-5715-98f8-4b82605f4c22" :knowledge-point/questions [{:db/id #edb/ref 17592186074003} {:db/id #edb/ref 17592186074004} {:db/id #edb/ref 17592186233430} {:db/id #edb/ref 17592186485534} {:db/id #edb/ref 17592186485537} {:db/id #edb/ref 17592186547071}] :knowledge-point/title "Simplifying Expressions Containing Cube Roots"} :step/id #uuid "74aa14ec-4817-573b-816c-aa9e7cef4458" :step/math-academy-id 36487} {:db/id #edb/ref 17592186074726 :step/content {:db/id #edb/ref 17592186073789 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073664 :question/id #uuid "c1f1d037-45a6-5e72-a735-0c0512290120" :question/math-academy-id "e-9729"} :knowledge-point/id #uuid "622cd109-3764-5f32-8205-046be4b57c54" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049923}] :knowledge-point/questions [{:db/id #edb/ref 17592186074001} {:db/id #edb/ref 17592186074002} {:db/id #edb/ref 17592186485544} {:db/id #edb/ref 17592186485566}] :knowledge-point/title "Simplifying Square Root Expressions Using the Product Rule for Radicals"} :step/id #uuid "b782d57f-6faa-597a-9408-0b6fc960adfb" :step/math-academy-id 36491 :step/next {:db/id #edb/ref 17592186074728}} {:db/id #edb/ref 17592186074727 :step/content {:db/id #edb/ref 17592186075012 :tutorial/content "Recall that the product rule for radicals states that\n\n$$\n\\sqrt{a\\cdot b} = \\sqrt{a}\\cdot \\sqrt{b}\n$$\n\nwhere $a$ and $b$ are nonnegative numbers. \n\nWe can use the product rule for radicals to simplify some expressions. Let's see an example." :tutorial/id #uuid "4af2af2e-0f81-5094-adf6-2ede72a493d2" :tutorial/math-academy-id 5995 :tutorial/title "The Product Rule for Radicals"} :step/id #uuid "d050b8f3-0cc1-593c-8200-076f5b4f824f" :step/math-academy-id 36619 :step/next {:db/id #edb/ref 17592186074726}} {:db/id #edb/ref 17592186074728 :step/content {:db/id #edb/ref 17592186075013 :tutorial/content "We can simplify cube root expressions in the same way as with square roots.\n\nFor example, consider the following expression:\n\n$$\n4\\sqrt[3]2 - 6\\sqrt[3] 2\n$$\n\nWe can simplify our expression by combining the two radicals, as follows:\n\n$$\n\\begin{aligned}4\\sqrt[3]{2}-6\\sqrt[3]{2} & = \\\\ (4-6)\\sqrt[3]{2} & = \\\\ -2\\sqrt[3]{2} & \\end{aligned}\n$$\n\n \n\nAs with square roots, we *cannot* combine terms when the numbers under the radical are different. For example, the expression\n\n$$\n3\\sqrt[3] 2 + \\sqrt[3] 5\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt[3] 2$ and $\\sqrt[3] 5.$\n\nFinally, it is not possible to combine square root and cube root terms -- not even if the numbers under the radical symbol are the same! For example, the expression\n\n$$\n4\\sqrt 2 + \\sqrt[3] 2\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt 2$ and $\\sqrt[3] 2.$" :tutorial/id #uuid "32078f96-6eaf-57d2-bc71-8af8495d5d6f" :tutorial/math-academy-id 5996 :tutorial/title "Simplifying Expressions With Cube Roots"} :step/id #uuid "f9fded71-c2d5-5d66-9f13-5b0253efd6ff" :step/math-academy-id 36620 :step/next {:db/id #edb/ref 17592186074725}} {:db/id #edb/ref 17592186074751 :step/content {:db/id #edb/ref 17592186074948 :tutorial/content "When dealing with sums of square roots, we can combine any terms with the same number under the square root symbol $\\sqrt{\\phantom 0}.$\n\nFor example, consider the following expression:\n\n$$\n2\\sqrt 5 + 4\\sqrt 5\n$$\n\nRemember that $2\\sqrt 5$ and $4\\sqrt 5$ mean $2\\cdot\\sqrt 5$ and $4\\cdot\\sqrt 5,$ respectively. \n\nWe can simplify our expression by combining the two radicals, as follows:\n\n$$\n\\begin{aligned}2\\sqrt{5}+4\\sqrt{5} & = \\\\ (2+4)\\sqrt{5} & = \\\\ 6\\sqrt{5} & \\end{aligned}\n$$\n\n \n\nSimilarly,\n\n$$\n\\begin{aligned}2\\sqrt{7}-\\sqrt{7} & = \\\\ 2\\sqrt{7}-1\\cdot \\sqrt{7} & = \\\\ (2-1)\\sqrt{7} & = \\\\ 1\\cdot \\sqrt{7} & = \\\\ \\sqrt{7}. & \\end{aligned}\n$$\n\n \n\nHowever, we *cannot* combine terms when the numbers under the radical are different. For example, the expression\n\n$$\n2\\sqrt 3 + \\sqrt 5\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt 3$ and $\\sqrt 5.$" :tutorial/id #uuid "9aa49408-30d5-57b5-8dff-ec1744f9fc6e" :tutorial/math-academy-id 1609 :tutorial/title "Introduction"} :step/id #uuid "38f3ace0-f394-598e-8dad-37fefda9d86e" :step/math-academy-id 4327 :step/next {:db/id #edb/ref 17592186074752}} {:db/id #edb/ref 17592186074752 :step/content {:db/id #edb/ref 17592186073806 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073464 :question/id #uuid "cf793c45-6c89-50c8-bb28-d066d2b8342a" :question/math-academy-id "e-1370"} :knowledge-point/id #uuid "2d8a8280-5248-57e4-a5ed-14e281f3db77" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050404}] :knowledge-point/questions [{:db/id #edb/ref 17592186074147} {:db/id #edb/ref 17592186074186} {:db/id #edb/ref 17592186485495} {:db/id #edb/ref 17592186485554}] :knowledge-point/title "Simplifying Square Root Expressions"} :step/id #uuid "459089fc-d278-5487-bc0b-e4cd6237c142" :step/math-academy-id 4328 :step/next {:db/id #edb/ref 17592186074727}}] :activity/title "Adding and Subtracting Radicals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073921}] [{:activity/first-step {:db/id #edb/ref 17592186079457} :activity/id #uuid "45c505a4-630e-59ff-9596-9a36627fb33e" :activity/scope {:db/id #edb/ref 17592186050396 :topic/id #uuid "457136ef-67f9-50bb-b078-34de9c6b59a9" :topic/math-academy-id 655} :activity/steps [{:db/id #edb/ref 17592186079457 :step/content {:db/id #edb/ref 17592186079621 :tutorial/content "A **polynomial term** is a term where the variable contains a non-negative integer power. (The non-negative integers consist of the numbers $0$, $1$, $2$, $3$, and so on.)\n\nSome examples of polynomial terms include\n\n$$\nx^2, \\qquad \\dfrac 1 3 x^6,\\qquad x, \\qquad 1\n$$\n\nLet's go through each one:\n\n- $x^{\\color{blue}2}$ is a polynomial term because the power of the variable is ${\\color{blue}2}$, a non-negative integer.\n- $\\dfrac{1}{3} x^{\\color{blue}6}$ is a polynomial term because the power of the variable is ${\\color{blue}6}$, which is also a non-negative integer. The coefficient of $\\dfrac 1 3$ isn't important.\n- $x$ is a polynomial term because it can be thought of as $x^{\\color{blue}1}$. So the power of the variable is ${\\color{blue}1}$, which is a non-negative integer.\n- Finally, $1$ is a polynomial term because it can be expressed as $1\\cdot x^{\\color{blue}0}$. So the power of the variable is ${\\color{blue}0}$, which is a non-negative integer.\n\nOn the other hand, the following expressions are *not* polynomial terms because their powers are not non-negative integers:\n\n$$\n4x^{-2}, \\qquad x^{1/3}, \\qquad {\\sqrt{\\color{black}x}}, \\qquad {\\dfrac{\\color{black}1}{x^3}}\n$$\n\nTo see why, let's go through each one:\n\n- $4x^{\\color{red}-2}$ is not a polynomial term because the power of the variable is ${\\color{red}-2}$, which is negative.\n- $x^{\\color{red}1/3}$ is not a polynomial term because the power of the variable is ${\\color{red}1/3}$, which is not an integer.\n- $\\sqrt x$ is not a polynomial term because it can be written as $x^{\\color{red}1/2}$. So the power of the variable is ${\\color{red}1/2}$, which is not an integer.\n- Finally, $\\dfrac 1 {x^3}$ is not a polynomial term because it can be written as $x^{-\\color{red}3}$. So the power of the variable is ${\\color{red}-3}$, which is negative." :tutorial/id #uuid "a11e9fb3-6fe1-547c-996f-fb83d15a47d0" :tutorial/math-academy-id 1578 :tutorial/title "Introduction"} :step/id #uuid "0500aa37-469a-53bd-a5da-8fbb0fe569cc" :step/math-academy-id 4106 :step/next {:db/id #edb/ref 17592186079458}} {:db/id #edb/ref 17592186079458 :step/content {:db/id #edb/ref 17592186078529 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078153 :question/id #uuid "0690af9e-ae28-50a0-b2fd-0a9c3baaec3e" :question/math-academy-id "e-1280"} :knowledge-point/id #uuid "c12f648d-f276-5123-b6aa-b222ad108825" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049089} {:db/id #edb/ref 17592186050495}] :knowledge-point/questions [{:db/id #edb/ref 17592186079068} {:db/id #edb/ref 17592186079149}] :knowledge-point/title "Identifying Polynomial Terms"} :step/id #uuid "ad32752d-72d3-5211-adbf-f50f0a51075b" :step/math-academy-id 4107 :step/next {:db/id #edb/ref 17592186079459}} {:db/id #edb/ref 17592186079459 :step/content {:db/id #edb/ref 17592186079622 :tutorial/content "A **polynomial** is a sum of polynomial terms, such as\n$x^2 -5x +3, \\qquad x^3 + x^2 - 9x, \\qquad 4x^4 -2x^2, \\qquad 3x^6 - 2x^3+x^2-1$." :tutorial/id #uuid "2b356365-33dd-5603-8027-95f09e3184a7" :tutorial/math-academy-id 1579 :tutorial/title "Polynomials"} :step/id #uuid "a43ff34d-c027-5df2-820c-70b022c83dc9" :step/math-academy-id 4109 :step/next {:db/id #edb/ref 17592186079460}} {:db/id #edb/ref 17592186079460 :step/content {:db/id #edb/ref 17592186078530 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078155 :question/id #uuid "f6c0be28-9441-513e-83c5-866292fd307a" :question/math-academy-id "e-1282"} :knowledge-point/id #uuid "df8ab577-24c5-5ac4-a9de-9ecc7dfb6653" :knowledge-point/questions [{:db/id #edb/ref 17592186078922} {:db/id #edb/ref 17592186079069}] :knowledge-point/title "Identifying Polynomials"} :step/id #uuid "2556eb4e-afab-5ae3-8996-7aa3b8f721fc" :step/math-academy-id 4112 :step/next {:db/id #edb/ref 17592186079461}} {:db/id #edb/ref 17592186079461 :step/content {:db/id #edb/ref 17592186079623 :tutorial/content "To **evaluate** a polynomial at a specific value of $x$, we substitute the value of $x$ into the polynomial and simplify.\n\nFor example, to evaluate the polynomial $2x^2+3$ at $x=5$, we substitute $x=5$ into the expression and simplify:\n\n$$\n\\begin{aligned}\n2x^{2} + 3 &=  \\\\\n2(5)^{2} + 3 &=  \\\\\n2(25) + 3 &=  \\\\\n50 + 3 &=  \\\\\n&= 53\n\\end{aligned}\n$$" :tutorial/id #uuid "d8de8488-40d3-593a-a8a1-9193eb94f8e8" :tutorial/math-academy-id 1580 :tutorial/title "Evaluating Polynomials"} :step/id #uuid "64a56fd4-dcbc-5271-8a10-da5817638249" :step/math-academy-id 4114 :step/next {:db/id #edb/ref 17592186079462}} {:db/id #edb/ref 17592186079462 :step/content {:db/id #edb/ref 17592186078531 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078162 :question/id #uuid "5242547e-f74d-541d-8c3b-def606b70cb1" :question/math-academy-id "e-1283"} :knowledge-point/id #uuid "a0f7a2ec-3d90-5930-bcc0-d51b8111dbe7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048652}] :knowledge-point/questions [{:db/id #edb/ref 17592186078853} {:db/id #edb/ref 17592186079150} {:db/id #edb/ref 17592186459300} {:db/id #edb/ref 17592186480647} {:db/id #edb/ref 17592186487324} {:db/id #edb/ref 17592186491165} {:db/id #edb/ref 17592186498565}] :knowledge-point/title "Evaluating a Polynomial"} :step/id #uuid "f4dd171c-5f47-5387-8772-afefbec23a35" :step/math-academy-id 4115 :step/next {:db/id #edb/ref 17592186079463}} {:db/id #edb/ref 17592186079463 :step/content {:db/id #edb/ref 17592186078532 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078163 :question/id #uuid "7dc04a57-3d13-5482-93c2-db2cee4ca41a" :question/math-academy-id "e-1284"} :knowledge-point/id #uuid "3b2229bd-c425-5e53-b8cf-56f3f9f3f539" :knowledge-point/questions [{:db/id #edb/ref 17592186078927} {:db/id #edb/ref 17592186079151} {:db/id #edb/ref 17592186233558} {:db/id #edb/ref 17592186233565} {:db/id #edb/ref 17592186233572} {:db/id #edb/ref 17592186485499} {:db/id #edb/ref 17592186485579}] :knowledge-point/title "Evaluating a Polynomial Using Function Notation"} :step/id #uuid "666b2e7a-bdbf-55bd-a1ea-25b21b4d56f8" :step/math-academy-id 4117}] :activity/title "Introduction to Polynomials" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078677}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186485641} :activity/id #uuid "c520d89b-b214-53fa-952a-5cdaa5d839b2" :activity/scope {:db/id #edb/ref 17592186050396 :topic/id #uuid "457136ef-67f9-50bb-b078-34de9c6b59a9" :topic/math-academy-id 655} :activity/steps [{:db/id #edb/ref 17592186485634 :step/content {:db/id #edb/ref 17592186485579 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33703d26-72cd-5cc0-aca3-ff27ce58c3a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "28" :db/id #edb/ref 17592186484926} {:answer/id #uuid "4a0251a2-5a6f-5f2e-a8d7-4946c3bfa1a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186484979} {:answer/id #uuid "4a178c66-540d-5353-b5cb-382e367946e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "27" :db/id #edb/ref 17592186484980} {:answer/id #uuid "7976dd35-fda1-58e9-9f8c-a10bdfaee619" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186485080} {:answer/id #uuid "d27f363a-0795-5e28-96ae-acdc39887ec9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30" :db/id #edb/ref 17592186485260}] :answer-field/correct {:db/id #edb/ref 17592186484926} :answer-field/id #uuid "39e37d12-a990-5afb-9a51-3025326ee005" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186485391}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c90c9cf4-1ba5-5ca6-8d2b-ccc36ce67160" :question/math-academy-id "q-52131" :question/problem "Given the polynomial $f(x)=3{x}^{2}+1,$ $f(3)=$" :question/worked-solution "We substitute $x=x$ into the expression for $f(x)$ and simplify: \n\n$$\n\\begin{aligned}f(x) & =3{x}^{2}+1 \\\\ f(3) & =3(3)^{2}+1 \\\\  & =27+1 \\\\  & =28\\end{aligned}\n$$\n\nTherefore, $f(3)=28.$"} :step/id #uuid "c2d7fc25-7c71-5f9a-b230-683a6fe78e3a" :step/next {:db/id #edb/ref 17592186485644}} {:db/id #edb/ref 17592186485641 :step/content {:db/id #edb/ref 17592186078853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d49c7bc-c10c-5365-bdcf-53015828e98b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186075902} {:answer/id #uuid "d4ce4605-76fb-5b21-b5ed-7fb4b116e814" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186075903} {:answer/id #uuid "f885dbbc-c1d7-5f2c-8a5d-4b57aad4d071" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-19" :db/id #edb/ref 17592186075904} {:answer/id #uuid "3bffe3f8-7623-5e82-8b00-0282c3071997" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-16" :db/id #edb/ref 17592186075905} {:answer/id #uuid "551c4823-47ff-5e04-8c66-bc8ba9ac8296" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-13" :db/id #edb/ref 17592186075906}] :answer-field/correct {:db/id #edb/ref 17592186075904} :answer-field/id #uuid "4215e270-50a3-50bb-b7ed-bf7f3eb3d7b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186075901}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cb6fcbdf-91d2-5cfa-a995-0b092c5eba28" :question/math-academy-id "q-30334" :question/problem "Evaluate the polynomial $-2{x}^{3}-3$ at $x=2.$" :question/worked-solution "To evaluate, we substitute $x=2$ into the polynomial and simplify: \n\n$$\n\\begin{aligned}-2{x}^{3}-3 & = \\\\ -2(2)^{3}-3 & = \\\\ -2(8)-3 & = \\\\ -19\\end{aligned}\n$$"} :step/id #uuid "f1b78880-72cd-5e06-98fa-ff71eb1c6e50" :step/next {:db/id #edb/ref 17592186485634}} {:db/id #edb/ref 17592186485644 :step/content {:db/id #edb/ref 17592186485499 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bf881b2-13e8-5a22-ae7e-ec683fc8ab04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186484906} {:answer/id #uuid "51fefe0c-6917-5f99-be00-78bf52de691d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186484997} {:answer/id #uuid "57e8cf6d-8d35-5805-8a29-824f9a26363b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186485015} {:answer/id #uuid "60d844b9-8ae4-59d2-a8d1-c0bdccdc4cff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186485032} {:answer/id #uuid "84297f1f-e6e8-5683-af04-f7b713873948" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186485101}] :answer-field/correct {:db/id #edb/ref 17592186484906} :answer-field/id #uuid "8f6bd22d-0ba9-56fb-9f12-08c0ea8052b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186485426}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "14cc1a32-5526-5826-8d11-3b9752e2a607" :question/math-academy-id "q-74463" :question/problem "Given the polynomial $g(x)={x}^{4}+3{x}^{3}+{x}^{2}-4x,$ $g(1)=$" :question/worked-solution "We substitute $x=1$ into the expression for $g(x)$ and simplify: \n\n$$\n\\begin{aligned}g(x) & ={x}^{4}+3{x}^{3}+{x}^{2}-4x \\\\ g(1) & ={1}^{4}+3\\cdot {1}^{3}+{1}^{2}-4\\cdot 1 \\\\  & =1+3+1-4 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, $g(1)=1.$"} :step/id #uuid "fb3db9c8-817f-5352-8d1f-22e473869755"}] :activity/title "Introduction to Polynomials" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186484811}] [{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186116390} :activity/id #uuid "e244395f-15ed-5f0d-a0d8-1d032e7f6961" :activity/scope {:db/id #edb/ref 17592186050410 :topic/id #uuid "46ce73a1-ea0d-553e-b5fc-67d8d59a64f8" :topic/math-academy-id 1601} :activity/steps [{:db/id #edb/ref 17592186116095 :step/content {:db/id #edb/ref 17592186115224 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115054 :question/id #uuid "9c478978-dbb7-53c7-b076-c763b4d89c19" :question/math-academy-id "e-4268"} :knowledge-point/id #uuid "676e3d29-f6fa-5fe4-aae4-e9c0e974ee74" :knowledge-point/questions [{:db/id #edb/ref 17592186115898} {:db/id #edb/ref 17592186115899} {:db/id #edb/ref 17592186488207} {:db/id #edb/ref 17592186488224}] :knowledge-point/title "Ordering the Angles of a Triangle by Size Given the Sides"} :step/id #uuid "da9b45ae-e6d0-5a16-9c2a-a707a86b6bbf" :step/math-academy-id 15670} {:db/id #edb/ref 17592186116390 :step/content {:db/id #edb/ref 17592186116446 :tutorial/content "Triangles can be classified by sides or by angles.\n\nFirst, let's consider the classifications by sides. We have three groups of triangles:\n\n- **Equilateral** triangles, where all sides have the same length.\n\n- **Isosceles** triangles, where only two sides are congruent. The congruent sides are called the **legs** of the triangle, and the third side is called the **base**.\n\n- **Scalene** triangles, where all sides have different measures.\n\n![](images/dc/dc38034d6c202b5168fc8184511a839eb41af206eb733e71e5f5c2fa970c0e33.png)" :tutorial/id #uuid "04b4a44f-3943-5a08-9132-ec500b7ff786" :tutorial/math-academy-id 2224 :tutorial/title "Introduction"} :step/id #uuid "2105e8d3-69ba-53f8-b170-b27097df9c59" :step/math-academy-id 9127 :step/next {:db/id #edb/ref 17592186116392}} {:db/id #edb/ref 17592186116391 :step/content {:db/id #edb/ref 17592186115406 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114982 :question/id #uuid "7dd8ef62-3aaf-5db9-9d85-6953f0520e8d" :question/math-academy-id "e-2713"} :knowledge-point/id #uuid "4b19a236-cd8f-52be-9ed2-24581059f7f4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049584}] :knowledge-point/questions [{:db/id #edb/ref 17592186115539} {:db/id #edb/ref 17592186115911} {:db/id #edb/ref 17592186488191} {:db/id #edb/ref 17592186488211}] :knowledge-point/title "Classifying a Triangle Based on Its Sides"} :step/id #uuid "b726def9-901b-503a-8593-201dafc3ad42" :step/math-academy-id 9133 :step/next {:db/id #edb/ref 17592186116393}} {:db/id #edb/ref 17592186116392 :step/content {:db/id #edb/ref 17592186116447 :tutorial/content "Now, let's consider classifying triangles by angles. We have three groups of triangles.\n\n- In an **acute** triangle, all three angles are acute.\n\n- A triangle with a right angle is called a **right** triangle.\n\n- A triangle with an obtuse angle is called an **obtuse** triangle.\n\n![](images/f1/f1c28d1f4b1ec7a93f1778e63be3727aa227e8eea5320eb7d5579c697e709429.png)" :tutorial/id #uuid "c58ae206-f2dc-54ff-8d30-951635f040c4" :tutorial/math-academy-id 2228 :tutorial/title "Classifying Triangles Based on Angles"} :step/id #uuid "93db5f60-a5c9-58e2-9ec2-2983e7914914" :step/math-academy-id 9135 :step/next {:db/id #edb/ref 17592186116391}} {:db/id #edb/ref 17592186116393 :step/content {:db/id #edb/ref 17592186115407 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114983 :question/id #uuid "503325cd-6b72-5216-999f-6601f54aa1b1" :question/math-academy-id "e-2716"} :knowledge-point/id #uuid "391481e0-3bd2-570f-8948-5618d8eb40c4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049949}] :knowledge-point/questions [{:db/id #edb/ref 17592186115540} {:db/id #edb/ref 17592186115639} {:db/id #edb/ref 17592186488232}] :knowledge-point/title "Classifying a Triangle Based on Its Angles"} :step/id #uuid "3f9f27e3-19a0-5fd1-8583-922e58bff6de" :step/math-academy-id 9136 :step/next {:db/id #edb/ref 17592186116394}} {:db/id #edb/ref 17592186116394 :step/content {:db/id #edb/ref 17592186116448 :tutorial/content "Consider the following scalene triangle, where $AB=5$, $BC=7,$ and $AC=6$ units, respectively.\n\n![](images/57/57be69075640f742ffe6c004515485c4f479347f3b8b523272778948935048df.png)\n\nLooking at the angles, it's hard to tell which angle is the largest.\n\nHowever, since we know the sides, there is a simple rule that we can use to determine the relative size of the angles:\n\nLonger sides are opposite to larger angles and vice versa.\n\nApplying this rule to $\\triangle{ABC}$ depicted above, the longest side is $\\overline{BC}.$ Therefore, the largest angle is the angle opposite to $\\overline{BC},$ which is $\\color{red}\\angle{A}.$\n\n![](images/82/82d9ac6d61f285f3557d2dd0dda826803ffae306c5f9a927a422b3b953f262f4.png)\n\nSimilarly,\n\n- the mid-sized side ($\\overline{AC}$) is opposite to the mid-sized angle ($\\angle B$), and\n\n- the shortest side ($\\overline{AB}$) is opposite to the smallest angle ($\\angle C$).\n\nSo, from least to greatest, the angles of the triangle are ordered as follows:\n\n$$\nm\\angle{C} < m\\angle{B} < m\\angle{A}\n$$\n\n**Note:** This rule works in reverse too. If you know the biggest angle of a triangle, the longest side is always opposite to this angle." :tutorial/id #uuid "d464a407-72e1-515b-876a-cb5b0dd3b06f" :tutorial/math-academy-id 2229 :tutorial/title "Relationships Between Sides and Interior Angles of a Triangle"} :step/id #uuid "a22f2d5b-d95d-5243-8574-99ba246bfda2" :step/math-academy-id 9141 :step/next {:db/id #edb/ref 17592186116395}} {:db/id #edb/ref 17592186116395 :step/content {:db/id #edb/ref 17592186115408 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114984 :question/id #uuid "cbac3c76-7a3e-5a86-8e03-667874fe97f9" :question/math-academy-id "e-2719"} :knowledge-point/id #uuid "3360e34f-afe6-5f9e-be39-91e2d51ba353" :knowledge-point/questions [{:db/id #edb/ref 17592186115897} {:db/id #edb/ref 17592186115900} {:db/id #edb/ref 17592186488212}] :knowledge-point/title "Ordering the Sides of a Triangle by Size Given the Interior Angles"} :step/id #uuid "0db57a5e-6e16-5eaa-adcb-b67a00c827c4" :step/math-academy-id 9148 :step/next {:db/id #edb/ref 17592186116095}}] :activity/title "Classifying Triangles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115429}] [{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186193425} :activity/id #uuid "157f57f7-71ad-5178-b6a1-cb1065e17520" :activity/scope {:db/id #edb/ref 17592186050448 :topic/id #uuid "49d2d213-870d-5feb-be49-bffbb6cbe24a" :topic/math-academy-id 4029} :activity/steps [{:db/id #edb/ref 17592186193425 :step/content {:db/id #edb/ref 17592186193943 :tutorial/content "A valuable skill to master when dealing with absolute value equations is to isolate the absolute value expression first.\n\nTo isolate an absolute value expression, we treat it like a variable in a linear equation.\n\nTo demonstrate, let's consider the following absolute value equation:\n\n$$\n2|x-1| + 4 = 8\n$$\n\nWe aim to isolate the $|x-1|$ term on the left-hand side. \n\nWe start by subtracting $4$ from both sides of the equation:\n\n$$\n\\begin{aligned}2|x-1|+4 & =8 \\\\ 2|x-1|+4-4 & =8-4 \\\\ 2|x-1| & =4\\end{aligned}\n$$\n\nThen, we divide both sides of the equation by $2{:}$\n\n$$\n\\begin{aligned}2|x-1| & =4 \\\\ \\frac{2|x-1|}{2} & =\\frac{4}{2} \\\\ \\frac{\\cancel{2}|x-1|}{\\cancel{2}} & =2 \\\\ |x-1| & =2\\end{aligned}\n$$\n\nAnd that's it! We've successfully isolated the absolute value expression in our equation.\n\nLet's consider another example." :tutorial/id #uuid "640fe647-93cb-5b1a-8707-6c53032d81ae" :tutorial/math-academy-id 8824 :tutorial/title "Introduction"} :step/id #uuid "b4b80cf6-ac66-5b80-8e9a-84e34ac2fd5d" :step/math-academy-id 144049 :step/next {:db/id #edb/ref 17592186193426}} {:db/id #edb/ref 17592186193426 :step/content {:db/id #edb/ref 17592186192634 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192592 :question/id #uuid "b3b99d07-5914-578b-9aaf-f028ada5bee0" :question/math-academy-id "e-14220"} :knowledge-point/id #uuid "5bc2c576-4f7c-5b4a-8c78-8a41420fdcce" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048267}] :knowledge-point/questions [{:db/id #edb/ref 17592186193128} {:db/id #edb/ref 17592186193245} {:db/id #edb/ref 17592186487339} {:db/id #edb/ref 17592186487365} {:db/id #edb/ref 17592186487368}] :knowledge-point/title "Isolating an Absolute Value Expression"} :step/id #uuid "6e54dac3-7257-553a-9281-d652e78869f1" :step/math-academy-id 144050 :step/next {:db/id #edb/ref 17592186193427}} {:db/id #edb/ref 17592186193427 :step/content {:db/id #edb/ref 17592186193944 :tutorial/content "Let's consider the following absolute value equation:\n\n$$\n\\vert x \\vert = -4\n$$\n\nNote the following:\n\n- The absolute value of any number is *always* positive or zero.\n\n- So, there is no number whose absolute value is negative.\n\n- Therefore, this equation $|x| = -4$ has **no solution.**\n\nAnother way of understanding this is to recall that the absolute value of a number represents the number's distance from the origin, and distances cannot be negative." :tutorial/id #uuid "b272858e-f85c-5daa-ad70-c87f7a3b792f" :tutorial/math-academy-id 8826 :tutorial/title "Recognizing Equations With No Solution"} :step/id #uuid "1f7f7690-789e-59b6-a31a-f699646aed1e" :step/math-academy-id 144054 :step/next {:db/id #edb/ref 17592186193428}} {:db/id #edb/ref 17592186193428 :step/content {:db/id #edb/ref 17592186193945 :tutorial/content "So, we know that the following equation has no solution:\n\n$$\n\\vert x \\vert = -4\n$$\n\nLet's see what happens when we blindly apply the usual process of solving our equation:\n\n- if $|x| = x,$ we get\n\n$$\n\\begin{aligned}|x| & =-4 \\\\ x & =-4.\\end{aligned}\n$$\n\n- if $|x| = -x,$ we get\n\n$$\n\\begin{aligned}|x| & =-4 \\\\ -x & =-4 \\\\ x & =4.\\end{aligned}\n$$\n\nSo, the usual process has given us the \"solutions\" $x= {\\color{red}{-4}}$ and $x= {\\color{blue}{4}}.$ However, neither of these values satisfies the original equation!\n\nFor example, by substituting $x = {\\color{blue}{4}}$ into the original equation, we get a *false statement!*\n\n$$\n\\begin{aligned}|x| & =-4 \\\\ |4| & =-4 \\\\ 4 & =-4\\,\\times \\end{aligned}\n$$\n\nThe key takeaway is that it's essential to check that the right-hand side is positive (or zero) *before* applying the usual solution process." :tutorial/id #uuid "ea3bc553-4605-5ceb-8f0b-e788bb67414a" :tutorial/math-academy-id 8827 :tutorial/title "Attempting to Solve an Equation With No Solution"} :step/id #uuid "dd2c5b77-7fcb-5443-969e-13f565428281" :step/math-academy-id 144055 :step/next {:db/id #edb/ref 17592186193429}} {:db/id #edb/ref 17592186193429 :step/content {:db/id #edb/ref 17592186192635 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192593 :question/id #uuid "89382e45-4e78-554f-88e1-2bbf281617e9" :question/math-academy-id "e-14223"} :knowledge-point/id #uuid "94d6a2aa-4288-51dc-8944-cf9490812ad2" :knowledge-point/questions [{:db/id #edb/ref 17592186193131} {:db/id #edb/ref 17592186193370} {:db/id #edb/ref 17592186487333} {:db/id #edb/ref 17592186487392} {:db/id #edb/ref 17592186493910}] :knowledge-point/title "Absolute Value Equations With No Solution"} :step/id #uuid "cc568d38-8ed7-5e05-b47d-35fcd03f33e3" :step/math-academy-id 144056 :step/next {:db/id #edb/ref 17592186193430}} {:db/id #edb/ref 17592186193430 :step/content {:db/id #edb/ref 17592186192636 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192594 :question/id #uuid "de2efe4f-e236-5fb2-bc46-eb037ecf26b1" :question/math-academy-id "e-14228"} :knowledge-point/id #uuid "15f03573-42ee-50d4-acdf-e2ee05d3e7e4" :knowledge-point/questions [{:db/id #edb/ref 17592186193246} {:db/id #edb/ref 17592186193251} {:db/id #edb/ref 17592186487342} {:db/id #edb/ref 17592186487353} {:db/id #edb/ref 17592186487381} {:db/id #edb/ref 17592186487385} {:db/id #edb/ref 17592186493952} {:db/id #edb/ref 17592186493966}] :knowledge-point/title "Rearranging and Solving an Absolute Value Equation"} :step/id #uuid "9aebc5c1-cf53-5a78-8700-b622cd65203b" :step/math-academy-id 144059}] :activity/title "Further Absolute Value Equations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186192907}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186494057} :activity/id #uuid "f892b1c0-ec68-5601-bffd-cb6018c52093" :activity/scope {:db/id #edb/ref 17592186050448 :topic/id #uuid "49d2d213-870d-5feb-be49-bffbb6cbe24a" :topic/math-academy-id 4029} :activity/steps [{:db/id #edb/ref 17592186494004 :step/content {:db/id #edb/ref 17592186493952 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a298de8-fcdb-50a2-a4f1-108440d7dce0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=1,4" :db/id #edb/ref 17592186493407} {:answer/id #uuid "1a8ff519-a9c2-54ab-887f-1979423b6e33" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-1,4" :db/id #edb/ref 17592186493436} {:answer/id #uuid "339b4405-4f1c-5518-8af3-9771ff47c479" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solutions exist" :db/id #edb/ref 17592186493478} {:answer/id #uuid "783c039e-76a4-5d62-ae61-0594245c1c1c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-4,1" :db/id #edb/ref 17592186493573} {:answer/id #uuid "b9568ea7-ed57-5f55-98df-37b6253df3dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-4,-1" :db/id #edb/ref 17592186493695}] :answer-field/correct {:db/id #edb/ref 17592186493478} :answer-field/id #uuid "a1189cdb-d12a-5c98-a111-701599799875" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493856}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "baeaa0a7-bfc7-5111-9e74-1fdaefb89ea5" :question/math-academy-id "q-153975" :question/problem "If $3|2x-5|+13=4,$ then $x=$" :question/worked-solution "First, we isolate the absolute value on the left side of the equation:\n\n$$\n\\begin{aligned}3|2x-5|+13 & =4 \\\\ 3|2x-5| & =-9 \\\\ |2x-5| & =-3\\end{aligned}\n$$\n\nNow, notice that the right-hand side is negative. Therefore, the equation has no solutions."} :step/id #uuid "57cb19e7-4470-5b79-801f-a29347b19b6a" :step/next {:db/id #edb/ref 17592186494061}} {:db/id #edb/ref 17592186494057 :step/content {:db/id #edb/ref 17592186493966 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b21a6eb-0eb6-506f-bd93-3ef9b95b88e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=3,\\frac{7}{2}" :db/id #edb/ref 17592186493437} {:answer/id #uuid "aff73d6c-ddcc-5140-9177-17ad84cce051" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{3}{2},\\frac{7}{2}" :db/id #edb/ref 17592186493672} {:answer/id #uuid "affdc6a4-65f8-5318-8a1f-de4178ca2934" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-\\frac{3}{2},\\frac{7}{2}" :db/id #edb/ref 17592186493673} {:answer/id #uuid "bb371206-32f6-5ce9-b43b-759d66c0fc02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-\\frac{7}{2},\\frac{2}{3}" :db/id #edb/ref 17592186493697} {:answer/id #uuid "cd145d96-8415-53a5-bbc1-52861eca7892" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{3}{2},7" :db/id #edb/ref 17592186493720}] :answer-field/correct {:db/id #edb/ref 17592186493672} :answer-field/id #uuid "4c98fed7-20db-50af-9e49-c1f0c73826db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493820}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ddcdce51-4bc7-55a4-81e7-a74a7a6b3b12" :question/math-academy-id "q-112321" :question/problem "If $7|2x-5|+1=15,$ then $x=$" :question/worked-solution "First, we isolate the absolute value on the left side of the equation:\n\n$$\n\\begin{aligned}7|2x-5|+1 & =15 \\\\ 7|2x-5| & =14 \\\\ |2x-5| & =2\\end{aligned}\n$$\n\nNow, we have the following two cases:\n\n- If $|2x-5|=2x-5,$ we obtain:\n\n$$\n\\begin{aligned}|2x-5| & =2 \\\\ 2x-5 & =2 \\\\ 2x & =7 \\\\ x & =\\frac{7}{2}\\end{aligned}\n$$\n\n- If $|2x-5|=-(2x-5),$ we obtain:\n\n$$\n\\begin{aligned}|2x-5| & =2 \\\\ -(2x-5) & =2 \\\\ -2x+5 & =2 \\\\ -2x & =-3 \\\\ x & =\\frac{3}{2}\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\frac{3}{2}$ and $x=\\frac{7}{2}.$"} :step/id #uuid "d8e7db10-2590-5657-8dfe-a36aa1597a4e" :step/next {:db/id #edb/ref 17592186494004}} {:db/id #edb/ref 17592186494061 :step/content {:db/id #edb/ref 17592186493910 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a80c8ae-ff2e-5357-9292-0da8b013d1ac" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186493490} {:answer/id #uuid "74f22dec-1b1b-5ef1-9c84-1d364998af3d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186493564} {:answer/id #uuid "7a8b64d5-61ee-523a-aa6a-0686a98ce1a6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186493577} {:answer/id #uuid "a785c005-45dd-5940-8127-a83f51ea5976" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186493655} {:answer/id #uuid "dfbb0dd3-b661-558a-85dd-839040af8d8b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186493744}] :answer-field/correct {:db/id #edb/ref 17592186493744} :answer-field/id #uuid "09294ff2-d9d6-52b7-9077-c43a5e430b15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493805}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2e7c0ce7-7ffd-571f-9543-de7ea37af680" :question/math-academy-id "q-154664" :question/problem "Which of the following equations has *no* solution?\n\nI. $|5z+1|=5$\n\nII. $|5z+1|-3=-1$\n\nIII. $|5z+1|=-6$" :question/worked-solution "An absolute value equation has no solution if, when the absolute value is isolated on the left side, the right-hand side is negative.\n\nWith that in mind, let's look at each equation in turn:\n\n- Equation I has a solution. The absolute value is already isolated on the left-hand side, and the right-hand side is non-negative.\n\n- Equation II has a solution. To see this, we first isolate the absolute value on the left-hand side as follows:\n\n$$\n\\begin{aligned}|5z+1|-3 & =-1 \\\\ |5z+1| & =2\\end{aligned}\n$$\n\nSince the right-hand side is non-negative, this equation has a solution.\n\n- Equation III *has no solution*. The absolute value is already isolated on the left-hand side, and the right-hand side is *negative*.\n\nTherefore, the answer is \"III only.\""} :step/id #uuid "e0b2caf9-5a3f-5708-9cbd-b6253216f8e1"}] :activity/title "Further Absolute Value Equations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186493389}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186069625} :activity/id #uuid "155e5337-d5e8-53d9-b3b1-ee0f86219c05" :activity/scope {:db/id #edb/ref 17592186050511 :topic/id #uuid "4f6afc08-f23d-50b8-a5e5-a6052d6e4308" :topic/math-academy-id 391} :activity/steps [{:db/id #edb/ref 17592186069625 :step/content {:db/id #edb/ref 17592186070028 :tutorial/content "What is the value of $x$ that satisfies the following equation?\n\n$$\n3^x = 3^4\n$$\n\nWe call this an **exponential equation** because the variable is contained within the exponent. \n\nNow, this equation is pretty easy to solve. Because the bases on both sides of the equation are the same (they are both equal to $3$), we can simply equate the powers.\n\n$$\n\\begin{aligned}{3}^{x} & ={3}^{4} \\\\ x & =4\\end{aligned}\n$$\n\nTherefore, the solution to this equation is $x=4.$" :tutorial/id #uuid "1fc010d0-e380-5035-bdb6-5d5d7cff060b" :tutorial/math-academy-id 8837 :tutorial/title "Introduction"} :step/id #uuid "ddaa7aab-6a5c-5c05-989d-9d15267eceec" :step/math-academy-id 170031 :step/next {:db/id #edb/ref 17592186069626}} {:db/id #edb/ref 17592186069626 :step/content {:db/id #edb/ref 17592186068731 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068495 :question/id #uuid "4912a540-482c-51be-bdc4-8fb128ddfb77" :question/math-academy-id "e-14246"} :knowledge-point/id #uuid "f1e0a7d0-f891-5f5f-8d8d-1ced62b2899e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048725} {:db/id #edb/ref 17592186049714}] :knowledge-point/questions [{:db/id #edb/ref 17592186069155} {:db/id #edb/ref 17592186069474} {:db/id #edb/ref 17592186488215} {:db/id #edb/ref 17592186488218} {:db/id #edb/ref 17592186488241} {:db/id #edb/ref 17592186488279}] :knowledge-point/title "Solving an Exponential Equation"} :step/id #uuid "d2856989-c0e4-57bc-927d-5351b29a50a4" :step/math-academy-id 170032 :step/next {:db/id #edb/ref 17592186069627}} {:db/id #edb/ref 17592186069627 :step/content {:db/id #edb/ref 17592186070029 :tutorial/content "Let's take a look at the following equation: \n\n$$\n5^x = 25\n$$\n\nWe can't solve this equation straight off the bat because the two sides of the equation don't share a common base.\n\nHowever, notice that $25$ can be written as a power of $5\\mathbin{:}$\n\n$$\n25=5^2\n$$\n\nTherefore, we can rewrite the equation as\n\n$$\n5^x = 5^2.\n$$\n\nSince both sides of the equation are now written as an exponential expression with a common base of $5,$ we can set the exponents equal to each other and solve:\n\n$$\n\\begin{aligned}{5}^{x} & ={5}^{2} \\\\ x & =2\\end{aligned}\n$$\n\nTo check that the solution is correct, we plug $x=2$ into the original equation:\n\n$$\n\\eqalign{\n\t\t5^{2} &= 25 \\\n\t\t25 &= 25 \\; {\\color{green}{\\checkmark}}\n\t}\n$$" :tutorial/id #uuid "43789602-55db-50d6-8517-6be1716d6133" :tutorial/math-academy-id 8839 :tutorial/title "Changing the Base of an Expression"} :step/id #uuid "792c4b4f-5718-5101-aad6-254e3d0f1a1c" :step/math-academy-id 170035 :step/next {:db/id #edb/ref 17592186069628}} {:db/id #edb/ref 17592186069628 :step/content {:db/id #edb/ref 17592186068732 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068496 :question/id #uuid "bc9650d4-c12f-5e7a-b0b2-aacca9a9d698" :question/math-academy-id "e-14248"} :knowledge-point/id #uuid "7e0c15b8-dc6e-570d-9392-4c679395cc87" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048262} {:db/id #edb/ref 17592186050495}] :knowledge-point/questions [{:db/id #edb/ref 17592186069156} {:db/id #edb/ref 17592186069157} {:db/id #edb/ref 17592186069358} {:db/id #edb/ref 17592186488260} {:db/id #edb/ref 17592186488284} {:db/id #edb/ref 17592186501198} {:db/id #edb/ref 17592186501221} {:db/id #edb/ref 17592186543540} {:db/id #edb/ref 17592186543583}] :knowledge-point/title "Solving an Exponential Equation by Changing the Base"} :step/id #uuid "6ed2b746-5c94-5683-9d52-e609dd44d3af" :step/math-academy-id 170036 :step/next {:db/id #edb/ref 17592186069629}} {:db/id #edb/ref 17592186069629 :step/content {:db/id #edb/ref 17592186068733 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068497 :question/id #uuid "9a971439-a68b-58e5-a8f3-51045b2a0bf0" :question/math-academy-id "e-14252"} :knowledge-point/id #uuid "368d83db-e01e-543b-ba45-8fc9c63242e9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673}] :knowledge-point/questions [{:db/id #edb/ref 17592186069122} {:db/id #edb/ref 17592186069158} {:db/id #edb/ref 17592186069523} {:db/id #edb/ref 17592186488240} {:db/id #edb/ref 17592186501151} {:db/id #edb/ref 17592186543490}] :knowledge-point/title "Rearranging and Solving an Exponential Equation"} :step/id #uuid "a3c641ad-5eab-5dde-a062-3feb7d161f4c" :step/math-academy-id 170040}] :activity/title "Solving Exponential Equations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068938}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186501254} :activity/id #uuid "f4f76a90-d9b8-5d27-b8ad-37337bf353b0" :activity/scope {:db/id #edb/ref 17592186050511 :topic/id #uuid "4f6afc08-f23d-50b8-a5e5-a6052d6e4308" :topic/math-academy-id 391} :activity/steps [{:db/id #edb/ref 17592186501254 :step/content {:db/id #edb/ref 17592186501221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d95c0c5-ace6-53b1-8acd-f4567066b531" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-5" :db/id #edb/ref 17592186500529} {:answer/id #uuid "2bd93094-e14e-5a07-917e-a7afe75bc4f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=2" :db/id #edb/ref 17592186500556} {:answer/id #uuid "4cb2ba71-a137-5a99-8edd-1849eaa61229" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-1" :db/id #edb/ref 17592186500622} {:answer/id #uuid "ad6a4066-b9ea-53d1-a1ca-0d161468d3c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=1" :db/id #edb/ref 17592186500825} {:answer/id #uuid "d602709b-da4a-5d8a-9f5c-30e950209408" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=5" :db/id #edb/ref 17592186500925}] :answer-field/correct {:db/id #edb/ref 17592186500622} :answer-field/id #uuid "fee5e589-c054-5eb6-8af3-cb3f2d4d13a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186501134}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c1a2b990-ffe2-5008-9b55-fe50c6e1b0a9" :question/math-academy-id "q-72" :question/problem "Solve the equation ${5}^{x}=\\frac{1}{5}.$" :question/worked-solution "First, we rewrite $\\frac{1}{5}$ as ${5}^{-1}$ to get:\n\n$$\n\\begin{aligned}{5}^{x} & =\\frac{1}{5} \\\\ {5}^{x} & ={5}^{-1}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(5)$, we equate the exponents:\n\n$$\n\\begin{aligned}{5}^{x} & ={5}^{-1} \\\\ x & =-1\\end{aligned}\n$$\n\nTherefore, the solution is $x=-1.$"} :step/id #uuid "1ae92f66-49f7-5012-8ef4-d9d2b3e7eeeb" :step/next {:db/id #edb/ref 17592186501262}} {:db/id #edb/ref 17592186501262 :step/content {:db/id #edb/ref 17592186501151 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "026f7618-75a1-5a04-a1b5-19a4dc5bf3a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=3" :db/id #edb/ref 17592186500474} {:answer/id #uuid "927ec64f-f546-590f-a4a2-b25b5259079e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2" :db/id #edb/ref 17592186500771} {:answer/id #uuid "b2009e5a-bca1-5305-a255-000d7c669780" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{3}" :db/id #edb/ref 17592186500839} {:answer/id #uuid "dbbbb42e-e930-5fd7-b9c9-d3dc2136d8ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-2" :db/id #edb/ref 17592186500935} {:answer/id #uuid "f58f8a6d-120b-534f-bcf9-f4589ff32814" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=8" :db/id #edb/ref 17592186500991}] :answer-field/correct {:db/id #edb/ref 17592186500474} :answer-field/id #uuid "8ea04aaa-60fe-5164-9b6a-5f1f5daacdc8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186501081}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "21ccfd77-b3db-57e5-9298-b5b4966f212d" :question/math-academy-id "q-64060" :question/problem "Solve the equation $3\\cdot {2}^{y}=24.$" :question/worked-solution "First, we isolate the term with the variable exponent by dividing both sides by $3$:\n\n$$\n\\begin{aligned}3\\cdot {2}^{y} & =24 \\\\ \\frac{3\\cdot {2}^{y}}{3} & =\\frac{24}{3} \\\\ {2}^{y} & =8\\end{aligned}\n$$\n\nNow, we rewrite $8$ as ${2}^{3}$ to get:\n\n$$\n\\begin{aligned}{2}^{y} & =8 \\\\ {2}^{y} & ={2}^{3}\\end{aligned}\n$$\n\nFinally, since both sides of the equation share the same base $(2)$, we equate the exponents:\n\n$$\n\\begin{aligned}{2}^{y} & ={2}^{3} \\\\ y & =3\\end{aligned}\n$$\n\nTherefore, the solution is $y=3.$"} :step/id #uuid "391259fa-6f5a-58f1-8632-da1ecefaa31a" :step/next {:db/id #edb/ref 17592186501269}} {:db/id #edb/ref 17592186501269 :step/content {:db/id #edb/ref 17592186501198 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4aa42764-8a55-5dbc-bccf-f7cea3894ec5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=-1" :db/id #edb/ref 17592186500618} {:answer/id #uuid "b2001155-eb5c-5cb3-bb2c-450902eb3479" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=3" :db/id #edb/ref 17592186500838} {:answer/id #uuid "b6c8da6c-3a4b-5500-9638-fe300ced4dc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=-2" :db/id #edb/ref 17592186500848} {:answer/id #uuid "eb8af3a9-b131-5b59-8cf5-ff99c1204dc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=2" :db/id #edb/ref 17592186500971} {:answer/id #uuid "fcdebc72-280c-5c16-b415-95987a0b52ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=1" :db/id #edb/ref 17592186501005}] :answer-field/correct {:db/id #edb/ref 17592186500618} :answer-field/id #uuid "70045a59-b4d4-5586-bd99-bd10111a9b0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186501065}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9d01c4ee-dae1-5984-a9e0-aab6ea21f976" :question/math-academy-id "q-64096" :question/problem "Solve the equation ${2}^{z}=\\frac{1}{2}.$" :question/worked-solution "First, we rewrite $\\frac{1}{2}$ as ${2}^{-1}$ to get:\n\n$$\n\\begin{aligned}{2}^{z} & =\\frac{1}{2} \\\\ {2}^{z} & ={2}^{-1}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(2)$, we equate the exponents:\n\n$$\n\\begin{aligned}{2}^{z} & ={2}^{-1} \\\\ z & =-1\\end{aligned}\n$$\n\nTherefore, the solution is $z=-1.$"} :step/id #uuid "5811b9d0-d6f4-5652-886c-ce57664b39ee"}] :activity/title "Solving Exponential Equations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186500469}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186543637} :activity/id #uuid "5b788ddf-8728-5b13-bf64-a344eae95d32" :activity/scope {:db/id #edb/ref 17592186050511 :topic/id #uuid "4f6afc08-f23d-50b8-a5e5-a6052d6e4308" :topic/math-academy-id 391} :activity/steps [{:db/id #edb/ref 17592186543595 :step/content {:db/id #edb/ref 17592186543490 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c14bd25-60b1-5db9-a5b5-db353df1d229" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=4" :db/id #edb/ref 17592186542757} {:answer/id #uuid "6a19ff45-4f16-58c5-a481-27c3e6c6c4b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-2" :db/id #edb/ref 17592186542925} {:answer/id #uuid "780d7c64-0c00-5d57-b7ce-66b2f26ef78a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-1" :db/id #edb/ref 17592186542957} {:answer/id #uuid "9d1f2a50-d198-5902-817a-d0db539435f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{4}" :db/id #edb/ref 17592186543053} {:answer/id #uuid "9ed9741b-2e78-58ae-b8cc-62e01e46a889" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=1" :db/id #edb/ref 17592186543060}] :answer-field/correct {:db/id #edb/ref 17592186542957} :answer-field/id #uuid "cd01a93c-d6e2-540b-8c0d-44c14937bd8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543444}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3044149e-5bfc-5de0-b490-60c442d8ed07" :question/math-academy-id "q-45533" :question/problem "What is the solution to  $2\\cdot {8}^{y}=\\frac{1}{4}?$" :question/worked-solution "First, we isolate the term with the variable exponent by dividing both sides by $2$:\n\n$$\n\\begin{aligned}2\\cdot {8}^{y} & =\\frac{1}{4} \\\\ \\frac{2\\cdot {8}^{y}}{2} & =\\frac{(\\frac{1}{4})}{2} \\\\ {8}^{y} & =\\frac{1}{8}\\end{aligned}\n$$\n\nNow, we rewrite $\\frac{1}{8}$ as ${8}^{-1}$ to get:\n\n$$\n\\begin{aligned}{8}^{y} & =\\frac{1}{8} \\\\ {8}^{y} & ={8}^{-1}\\end{aligned}\n$$\n\nFinally, since both sides of the equation share the same base $(8)$, we equate the exponents:\n\n$$\n\\begin{aligned}{8}^{y} & ={8}^{-1} \\\\ y & =-1\\end{aligned}\n$$\n\nTherefore, the solution is $y=-1.$"} :step/id #uuid "02fdcf69-8aea-585d-b9f7-39f84eb04ef4"} {:db/id #edb/ref 17592186543637 :step/content {:db/id #edb/ref 17592186543583 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "408391ae-d464-521f-b3b1-0616515cdb2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{3}" :db/id #edb/ref 17592186542814} {:answer/id #uuid "4e83f3fd-bf6e-52e8-a020-7d0bc696a11b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=4" :db/id #edb/ref 17592186542853} {:answer/id #uuid "9a86847d-23cc-55e2-bcd7-a9694dcba515" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2" :db/id #edb/ref 17592186543046} {:answer/id #uuid "d3491e51-ea1f-58eb-85da-ce79e7691031" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-3" :db/id #edb/ref 17592186543184} {:answer/id #uuid "e06b7cc3-71e1-5a4d-8b96-8f5989ac4eb6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=3" :db/id #edb/ref 17592186543211}] :answer-field/correct {:db/id #edb/ref 17592186542853} :answer-field/id #uuid "9ca78635-18fa-5e3d-9d10-fbb809a1f37f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543397}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "eeaf419f-60bd-5e26-a56f-c339e863386b" :question/math-academy-id "q-80" :question/problem "Solve the equation ${3}^{y}=81.$" :question/worked-solution "First, we rewrite $81$ as ${3}^{4}$ to get:\n\n$$\n\\begin{aligned}{3}^{y} & =81 \\\\ {3}^{y} & ={3}^{4}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(3)$, we equate the exponents:\n\n$$\n\\begin{aligned}{3}^{y} & ={3}^{4} \\\\ y & =4\\end{aligned}\n$$\n\nTherefore, the solution is $y=4.$"} :step/id #uuid "6149d5bb-fed8-598b-8014-01b1ee9b8064" :step/next {:db/id #edb/ref 17592186543654}} {:db/id #edb/ref 17592186543654 :step/content {:db/id #edb/ref 17592186543540 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2edcc807-3636-52ce-bfc5-aaeaf9e3c605" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-3" :db/id #edb/ref 17592186542763} {:answer/id #uuid "712df8a0-8d70-5d49-b320-e800a8bdd2ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{1}{125}" :db/id #edb/ref 17592186542938} {:answer/id #uuid "79e2e42a-4919-5f80-adf9-a1f3434370e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-125" :db/id #edb/ref 17592186542963} {:answer/id #uuid "8dd35fa6-7512-5340-9b7a-de251ebbb42e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-5" :db/id #edb/ref 17592186543011} {:answer/id #uuid "b5d42485-2e6e-5647-b440-f854c28552be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=5" :db/id #edb/ref 17592186543112}] :answer-field/correct {:db/id #edb/ref 17592186542763} :answer-field/id #uuid "8819a29e-57d4-59e0-a6c9-1c8665d8df6a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543385}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a79b6cc2-bbc0-53f7-9fa7-3b0e82f61fd9" :question/math-academy-id "q-45486" :question/problem "Solve the equation ${5}^{x}=\\frac{1}{125}.$" :question/worked-solution "First, we rewrite $125$ as ${5}^{3}$ to get:\n\n$$\n\\begin{aligned}{5}^{x} & =\\frac{1}{125} \\\\ {5}^{x} & =\\frac{1}{{5}^{3}} \\\\ {5}^{x} & ={5}^{-3}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(5)$, we equate the exponents:\n\n$$\n\\begin{aligned}{5}^{x} & ={5}^{-3} \\\\ x & =-3\\end{aligned}\n$$\n\nTherefore, the solution is $x=-3.$"} :step/id #uuid "ad4d284e-5319-5752-a7e6-913170f0dc13" :step/next {:db/id #edb/ref 17592186543595}}] :activity/title "Solving Exponential Equations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186542622}] [{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186069792} :activity/id #uuid "2dc87c95-826a-555a-9423-36fffbf47e86" :activity/scope {:db/id #edb/ref 17592186051032 :topic/id #uuid "7bffda20-cdd5-5dc8-9399-950fa61fbd19" :topic/math-academy-id 382} :activity/steps [{:db/id #edb/ref 17592186069792 :step/content {:db/id #edb/ref 17592186069940 :tutorial/content "Sometimes, perfect square trinomials have a leading coefficient that is something other than $1.$ For example, the expression\n\n$$\n4x^2+12x+9\n$$\n\nhas a leading coefficient of $4,$ and it is a perfect square trinomial because it is the square of the binomial $(2x+3)$ as we can see below:\n\n$$\n\\begin{aligned}(2x+3)^{2} & = \\\\ (2x)^{2}+2(2x)(3)+(3)^{2} & = \\\\ 4{x}^{2}+12x+9 & \\end{aligned}\n$$\n\nTo factor a perfect square trinomial with a leading coefficient other than $1,$ we use the square of sum formula:\n\n$$\n\\begin{aligned}{a}^{2}+2ab+{b}^{2} & =(a+b)^{2}\\end{aligned}\n$$\n\nTo illustrate, let's factor the expression $4x^2+12x+9$ using the square of sum formula. We perform the following steps:\n\n1\\. Write both the quadratic term and the constant term as perfect squares:\n\n  $$\n  \\begin{aligned}4{x}^{2}+12x+9 & = \\\\ (2x)^{2}+12x+(3)^{2}\\end{aligned}\n  $$\n\n2\\. Factor a $2$ out of the linear term:\n\n  $$\n  \\begin{aligned}(2x)^{2}+2(6x)+(3)^{2}\\end{aligned}\n  $$\n\n3\\. Write the middle parentheses $(6x)$ as a product of $2x$ and ${\\color{blue}3}\\mathbin{:}$\n\n  $$\n  \\begin{aligned}(2x)^{2}+2(2x\\cdot 3)+(3)^{2}\\end{aligned}\n  $$\n\n4\\. Factor the trinomial using the square of sum formula. In this case, we have $a=2x$ and $b=3\\mathbin{:}$\n\n  $$\n  \\begin{aligned}(2x+3)^{2}\\end{aligned}\n  $$\n\n**Note:** This method works *only* when the trinomial is a perfect square! It will *not* work for every trinomial. But we will learn more general methods in the future." :tutorial/id #uuid "5d43b5e8-672e-5cdd-b7a3-8de29e6552f3" :tutorial/math-academy-id 1597 :tutorial/title "Introduction"} :step/id #uuid "8854423e-52a6-5077-ab8f-c9de25d23206" :step/math-academy-id 4236 :step/next {:db/id #edb/ref 17592186069793}} {:db/id #edb/ref 17592186069793 :step/content {:db/id #edb/ref 17592186068847 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068464 :question/id #uuid "99376061-f11c-50f9-8c6e-e67ad640afd1" :question/math-academy-id "e-1331"} :knowledge-point/id #uuid "0f4dc7f6-d085-5ad8-8ac3-95e5b9cc337f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049026}] :knowledge-point/questions [{:db/id #edb/ref 17592186069216} {:db/id #edb/ref 17592186069252} {:db/id #edb/ref 17592186484281} {:db/id #edb/ref 17592186484296}] :knowledge-point/title "Factoring a Perfect Square Trinomial Generated by the Square of a Sum"} :step/id #uuid "ac3a35ba-8b05-5a52-9f06-dc5add492619" :step/math-academy-id 4237 :step/next {:db/id #edb/ref 17592186069898}} {:db/id #edb/ref 17592186069794 :step/content {:db/id #edb/ref 17592186068848 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068465 :question/id #uuid "e9c8bdc9-696d-5a55-bb0d-d247008c5684" :question/math-academy-id "e-1333"} :knowledge-point/id #uuid "5f64efad-73ef-5caa-b38b-060d24ce13cf" :knowledge-point/questions [{:db/id #edb/ref 17592186069219} {:db/id #edb/ref 17592186069220} {:db/id #edb/ref 17592186484210} {:db/id #edb/ref 17592186542225}] :knowledge-point/title "Factoring a Perfect Square Trinomial Whose Terms Have a Common Factor"} :step/id #uuid "6a2dd26d-51b3-5cc1-8396-efeb5b1b8bb7" :step/math-academy-id 4242 :step/next {:db/id #edb/ref 17592186069795}} {:db/id #edb/ref 17592186069795 :step/content {:db/id #edb/ref 17592186069941 :tutorial/content "How can we factor a trinomial that has a negative leading coefficient, like\n\n$$\n-25y^2 + 20y - 4\\,?\n$$\n\n \nWe can reduce this to a more familiar problem by factoring out $−1$ from the entire expression:\n\n$$\n-(25y^2 - 20y + 4)\n$$\n\nNow, we factor the quadratic expression inside the parentheses using the square of a difference formula:\n\n$$\n\\begin{aligned}25{y}^{2}-20y+4 & = \\\\ (5y)^{2}-20y+{2}^{2} & = \\\\ (5y)^{2}-2(10y)+{2}^{2} & = \\\\ (5y)^{2}-2(5y\\cdot 2)+{2}^{2} & = \\\\ (5y-2)^{2} & \\end{aligned}\n$$\n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}-(25{y}^{2}-20y+4) & = \\\\ -(5y-2)^{2}\\end{aligned}\n$$" :tutorial/id #uuid "757d1827-0402-5d3d-b8da-a4dc88c254bb" :tutorial/math-academy-id 1598 :tutorial/title "Factoring a Perfect Square Trinomial With a Negative Leading Coefficient"} :step/id #uuid "3464306e-5c3f-55f3-9c10-87ab309dded2" :step/math-academy-id 4244 :step/next {:db/id #edb/ref 17592186069796}} {:db/id #edb/ref 17592186069796 :step/content {:db/id #edb/ref 17592186068849 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068466 :question/id #uuid "b74ed282-c54c-56f8-aa9f-8c5ef4465712" :question/math-academy-id "e-1334"} :knowledge-point/id #uuid "b67de190-3b32-506e-b375-bd18d4543bf6" :knowledge-point/questions [{:db/id #edb/ref 17592186069338} {:db/id #edb/ref 17592186069339} {:db/id #edb/ref 17592186484231} {:db/id #edb/ref 17592186484282} {:db/id #edb/ref 17592186484292} {:db/id #edb/ref 17592186484295} {:db/id #edb/ref 17592186542210}] :knowledge-point/title "Factoring a Perfect Square Trinomial With a Negative Leading Coefficient"} :step/id #uuid "3222e5cc-52d3-5afd-8468-ab3d87c483b2" :step/math-academy-id 4245} {:db/id #edb/ref 17592186069876 :step/content {:db/id #edb/ref 17592186068902 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068520 :question/id #uuid "b7141e58-61cf-5134-8443-a82d79a5506e" :question/math-academy-id "e-1593"} :knowledge-point/id #uuid "69a3b7a7-1042-511a-aaff-8b0911eae499" :knowledge-point/questions [{:db/id #edb/ref 17592186069215} {:db/id #edb/ref 17592186069251} {:db/id #edb/ref 17592186484249} {:db/id #edb/ref 17592186484291} {:db/id #edb/ref 17592186542124}] :knowledge-point/title "Factoring a Perfect Square Trinomial Generated by the Square of a Difference"} :step/id #uuid "d8accb58-b4d7-5dc8-9c5e-a5ca4f3588a2" :step/math-academy-id 5059 :step/next {:db/id #edb/ref 17592186069794}} {:db/id #edb/ref 17592186069898 :step/content {:db/id #edb/ref 17592186069954 :tutorial/content "Other perfect square trinomials can be factored as the square of a difference:\n\n$$\n\\begin{aligned}{a}^{2}-2ab+{b}^{2} & =(a-b)^{2}\\end{aligned}\n$$\n\nTo illustrate, let's factor the expression $9x^2-24x+16$ using the square of difference formula. We perform the following steps:\n\n1\\. Write both the quadratic term and the constant term as perfect squares:\n\n  $$\n  \\begin{aligned}9{x}^{2}-24x+16 & = \\\\ (3x)^{2}-24x+(4)^{2}\\end{aligned}\n  $$\n\n2\\. Factor a $2$ out of the linear term:\n\n  $$\n  \\begin{aligned}(3x)^{2}-24x+(4)^{2} & = \\\\ (3x)^{2}-2(12x)+(4)^{2}\\end{aligned}\n  $$\n\n3\\. Write the middle parentheses $(12x)$ as a product of $3x$ and ${\\color{blue}4}\\mathbin{:}$\n\n  $$\n  \\begin{aligned}(3x)^{2}-2(12x)+(4)^{2} & = \\\\ (3x)^{2}-2(3x\\cdot 4)+(4)^{2}\\end{aligned}\n  $$\n\n4\\. Factor the trinomial using the square of difference formula. In this case, we have $a=3x$ and $b=4\\mathbin{:}$\n\n  $$\n  \\begin{aligned}(3x)^{2}-2(3x\\cdot 4)+(4)^{2} & = \\\\ (3x-4)^{2}\\end{aligned}\n  $$\n\n**Note:** Once again, we note that this method works *only* when the trinomial is a perfect square! It will *not* work for every trinomial." :tutorial/id #uuid "609ce9b5-1b4e-5dfc-9d22-4ec6ea2d640b" :tutorial/math-academy-id 1856 :tutorial/title "Factoring a Perfect Square Trinomial Generated by the Square of a Difference"} :step/id #uuid "ecc30896-0712-5c97-a35e-e51485979c95" :step/math-academy-id 6170 :step/next {:db/id #edb/ref 17592186069876}}] :activity/title "Factoring Perfect Square Trinomials With Leading Coefficients" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068930}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186542265} :activity/id #uuid "f6b132f1-8395-5934-a798-3dc92cf19ca0" :activity/scope {:db/id #edb/ref 17592186051032 :topic/id #uuid "7bffda20-cdd5-5dc8-9399-950fa61fbd19" :topic/math-academy-id 382} :activity/steps [{:db/id #edb/ref 17592186542263 :step/content {:db/id #edb/ref 17592186542225 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "374194b8-85ae-5815-89c6-1a8f87cc6dbe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2(2x-3)^{2}" :db/id #edb/ref 17592186541540} {:answer/id #uuid "39ef85ad-8276-5ed8-b41e-7af905c91f91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x+3)^{2}" :db/id #edb/ref 17592186541548} {:answer/id #uuid "5bd98886-b613-531e-838d-f40fd260e8e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2x+1)^{2}" :db/id #edb/ref 17592186541605} {:answer/id #uuid "8c94784c-933a-51ab-b0f4-2713a3427fc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4(x-3)^{2}" :db/id #edb/ref 17592186541706} {:answer/id #uuid "bbb07f95-43b5-5477-a9d0-0c1c20b3c07b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4(2x-3)^{2}" :db/id #edb/ref 17592186541811}] :answer-field/correct {:db/id #edb/ref 17592186541811} :answer-field/id #uuid "5e25dd26-d9cd-5142-93e6-a7e8dbdac2b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542014}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f03b5992-4a97-5b3b-9545-c672d1a6e209" :question/math-academy-id "q-79002" :question/problem "Factor $16{x}^{2}-48x+36.$" :question/worked-solution "Notice that all of the terms have a common factor of $4.$ Therefore, we can simplify the expression by factoring out $4,$ as follows:\n\n$$\n\\begin{aligned}16{x}^{2}-48x+36 & = \\\\ 4(4{x}^{2}-12x+9)\\end{aligned}\n$$\n\nNow, let's factor the expression inside parentheses using the square of a difference formula: \n\n$$\n\\begin{aligned}4{x}^{2}-12x+9 & = \\\\ (2x)^{2}-12x+{3}^{2} & = \\\\ (2x)^{2}-2\\cdot (2x\\cdot 3)+{3}^{2} & = \\\\ (2x-3)^{2}\\end{aligned}\n$$\n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}4(4{x}^{2}-12x+9) & = \\\\ 4(2x-3)^{2}\\end{aligned}\n$$"} :step/id #uuid "77f81baa-f622-5822-ad79-2391b7a40d19"} {:db/id #edb/ref 17592186542265 :step/content {:db/id #edb/ref 17592186542124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bb9bce2-0c34-585a-9786-18cdbee30507" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3y-3)^{2}" :db/id #edb/ref 17592186541510} {:answer/id #uuid "41931e51-fe5c-5024-b27f-7666c39e6cec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(y-3)^{2}" :db/id #edb/ref 17592186541559} {:answer/id #uuid "b7268394-d3df-50dd-aefd-a1d483bd162e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3y-1)^{2}" :db/id #edb/ref 17592186541799} {:answer/id #uuid "bfc42d89-bdf4-5894-9f74-40a503a37160" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9(y-1)^{2}" :db/id #edb/ref 17592186541827} {:answer/id #uuid "c4b7e90c-e93d-59fc-87e0-2091f13f04ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3(y-1)^{2}" :db/id #edb/ref 17592186541835}] :answer-field/correct {:db/id #edb/ref 17592186541799} :answer-field/id #uuid "bbdf1e33-0fba-578c-aaad-d0ea6db8cbc2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542052}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1c00ad8d-9908-5ab2-b9e6-65ef0d5fcd94" :question/math-academy-id "q-31964" :question/problem "$9{y}^{2}-6y+1=$" :question/worked-solution "The \"square of a difference\" formula states that\n\n$$\n{a}^{2}-2ab+{b}^{2}=(a-b)^{2}.\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n9{y}^{2}-6y+1.\n$$\n\nFirst, we write both the quadratic term and the constant term as perfect squares:\n\n$$\n\\begin{aligned}(3y)^{2}-6y+(1)^{2}\\end{aligned}\n$$\n\nNext, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}(3y)^{2}-2(3y)+(1)^{2}\\end{aligned}\n$$\n\nThen, we write the middle parentheses $(3y)$ as a product of $3y$ and $1:$ \n\n$$\n\\begin{aligned}(3y)^{2}-2(3y\\cdot 1)+(1)^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of difference formula with $a=3y$ and $b=1.$ This gives \n\n$$\n\\begin{aligned}(3y-1)^{2}.\\end{aligned}\n$$"} :step/id #uuid "7da91827-5e59-5953-84fa-3077985bee0d" :step/next {:db/id #edb/ref 17592186542275}} {:db/id #edb/ref 17592186542275 :step/content {:db/id #edb/ref 17592186542210 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30bc40bd-0baa-53bc-b504-a2c240a14dc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-(2x-1)^{2}" :db/id #edb/ref 17592186541522} {:answer/id #uuid "37d6615e-66de-5728-ae8f-8e2fb4faec1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-(2x+1)^{2}" :db/id #edb/ref 17592186541541} {:answer/id #uuid "464d7d12-8513-5d3d-b8c3-79b6c483fb54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-(4x-1)^{2}" :db/id #edb/ref 17592186541571} {:answer/id #uuid "62b93017-abd9-5aa6-a8a4-50b59a42230d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x-2)^{2}" :db/id #edb/ref 17592186541625} {:answer/id #uuid "995306bc-ae35-5f95-966b-0932e6545022" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4x-1)^{2}" :db/id #edb/ref 17592186541741}] :answer-field/correct {:db/id #edb/ref 17592186541522} :answer-field/id #uuid "d785b8b3-293e-5ba6-866c-d51249e905eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542068}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cf9a0034-0b04-5113-8b59-eaa614930923" :question/math-academy-id "q-44032" :question/problem "Factor $-4{x}^{2}+4x-1.$" :question/worked-solution "Notice that the leading coefficient is negative. To reduce the expression to a more familiar form, we can factor out $-1,$ as follows:\n\n$$\n\\begin{aligned}-4{x}^{2}+4x-1 & = \\\\ -(4{x}^{2}-4x+1)\\end{aligned}\n$$\n\nNow, we factor the quadratic expression inside the parentheses using the square of a difference formula:\n\n$$\n\\begin{aligned}4{x}^{2}-4x+1 & = \\\\ (2x)^{2}-4x+{1}^{2} & = \\\\ (2x)^{2}-2\\cdot (2x)+{1}^{2} & = \\\\ (2x-1)^{2} & \\end{aligned}\n$$\n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}-(4{x}^{2}-4x+1) & = \\\\ -(2x-1)^{2} & \\end{aligned}\n$$"} :step/id #uuid "bf2aa872-b9dd-51ab-a97f-7add7180d9e9" :step/next {:db/id #edb/ref 17592186542263}}] :activity/title "Factoring Perfect Square Trinomials With Leading Coefficients" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186541427}]}
