92186045417] [17592186134917 #edb/ref 1061 4338 #edb/ref 17592186045417] [17592186134917 #edb/ref 1062 #uuid "9851ef2d-c687-52a6-8ea1-ff43bff4d334" #edb/ref 17592186045417] [17592186134917 #edb/ref 1063 #edb/ref 17592186135015 #edb/ref 17592186045417] [17592186134918 #edb/ref 1058 #edb/ref 17592186134919 #edb/ref 17592186045417] [17592186134918 #edb/ref 1061 4339 #edb/ref 17592186045417] [17592186134918 #edb/ref 1062 #uuid "87051a9a-ddb4-5816-97f9-79ce959ac930" #edb/ref 17592186045417] [17592186134918 #edb/ref 1063 #edb/ref 17592186133918 #edb/ref 17592186045417] [17592186134919 #edb/ref 1058 #edb/ref 17592186134920 #edb/ref 17592186045417] [17592186134919 #edb/ref 1061 4341 #edb/ref 17592186045417] [17592186134919 #edb/ref 1062 #uuid "7f5cb20d-4afc-523d-a3c0-7de37322d7ca" #edb/ref 17592186045417] [17592186134919 #edb/ref 1063 #edb/ref 17592186133919 #edb/ref 17592186045417] [17592186134920 #edb/ref 1058 #edb/ref 17592186134921 #edb/ref 17592186045417] [17592186134920 #edb/ref 1061 4342 #edb/ref 17592186045417] [17592186134920 #edb/ref 1062 #uuid "78c2fa37-59af-5314-9297-ed61b5901639" #edb/ref 17592186045417] [17592186134920 #edb/ref 1063 #edb/ref 17592186133920 #edb/ref 17592186045417] [17592186134921 #edb/ref 1061 4344 #edb/ref 17592186045417] [17592186134921 #edb/ref 1062 #uuid "a6b0c3c4-d28e-531d-910c-ec5b8bbf961f" #edb/ref 17592186045417] [17592186134921 #edb/ref 1063 #edb/ref 17592186133921 #edb/ref 17592186045417] [17592186135015 #edb/ref 1064 "Suppose that we wish to evaluate the expression $\\sqrt x + 3$ for the value $x=9.$ This type of expression is called a **radical expression** because it contains the radical symbol $\\sqrt{\\phantom 0}.$ Remember that $\\sqrt x$ means \"the positive square root of the number $x.$\" \n\nTo evaluate this expression at the given value, we replace $x$ with $9$ in the given expression and simplify.\n\n$$\n\\begin{aligned}\\sqrt{x}+3 & = \\\\ \\sqrt{9}+3 & = \\\\ \\sqrt{{3}^{2}}+3 & = \\\\ 3+3 & = \\\\ 6\\end{aligned}\n$$\n\n**Important:** You may have heard somewhere that $\\sqrt{9} = \\pm 3,$ because $(-3)^2=9$ and $(3)^2 = 9.$ However, when we write down $\\sqrt{9},$ we *always* mean \"the positive square root of $9$\".\n\nIf we want the negative square root of $9$, we write $-\\sqrt{9} = -3.$ Sometimes, we want both, in which case we would write $\\pm\\sqrt{9}=\\pm 3.$" #edb/ref 17592186045417] [17592186135015 #edb/ref 1065 1610 #edb/ref 17592186045417] [17592186135015 #edb/ref 1066 #uuid "4457c20d-88c9-5028-8390-390579fa7229" #edb/ref 17592186045417] [17592186135015 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186176044 #edb/ref 1037 #edb/ref 17592186048213 #edb/ref 17592186045417] [17592186176044 #edb/ref 1037 #edb/ref 17592186050494 #edb/ref 17592186045417] [17592186176044 #edb/ref 1038 #edb/ref 17592186176450 #edb/ref 17592186045417] [17592186176044 #edb/ref 1038 #edb/ref 17592186176451 #edb/ref 17592186045417] [17592186176044 #edb/ref 1038 #edb/ref 17592186487316 #edb/ref 17592186045417] [17592186176044 #edb/ref 1038 #edb/ref 17592186497402 #edb/ref 17592186045417] [17592186176044 #edb/ref 1039 "Solving Problems Involving Congruent Angles" #edb/ref 17592186045417] [17592186176044 #edb/ref 1041 #edb/ref 17592186175692 #edb/ref 17592186045417] [17592186176044 #edb/ref 1042 #uuid "bf8d806a-b232-5ddd-ad0b-3af70f244194" #edb/ref 17592186045417] [17592186176097 #edb/ref 1037 #edb/ref 17592186048587 #edb/ref 17592186045417] [17592186176097 #edb/ref 1037 #edb/ref 17592186050512 #edb/ref 17592186045417] [17592186176097 #edb/ref 1038 #edb/ref 17592186176517 #edb/ref 17592186045417] [17592186176097 #edb/ref 1038 #edb/ref 17592186176518 #edb/ref 17592186045417] [17592186176097 #edb/ref 1038 #edb/ref 17592186487330 #edb/ref 17592186045417] [17592186176097 #edb/ref 1038 #edb/ref 17592186487404 #edb/ref 17592186045417] [17592186176097 #edb/ref 1039 "Identifying Congruent Angles Given Measures of Angles" #edb/ref 17592186045417] [17592186176097 #edb/ref 1041 #edb/ref 175921861