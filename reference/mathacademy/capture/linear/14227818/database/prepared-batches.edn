b-8907-9924a3a993c1" :question/math-academy-id "q-215510"] ["question-e2cc5506-dc0b-5a5b-8907-9924a3a993c1" :question/problem "Written in ascending order, the solutions to $|1-2x|-2=7$ are $x=${{field-1}}\nand $x=$\n{{field-2}}."] ["question-e2cc5506-dc0b-5a5b-8907-9924a3a993c1" :question/worked-solution "First, we isolate the absolute value on the left side of the equation:\n\n$$\n\\begin{aligned}|1-2x|-2 & =7 \\\\ |1-2x| & =9\\end{aligned}\n$$\n\nNow, we have the following two cases:\n\n- If $|1-2x|=1-2x,$ we obtain:\n\n$$\n\\begin{aligned}|1-2x| & =9 \\\\ 1-2x & =9 \\\\ -2x & =8 \\\\ x & =-4\\end{aligned}\n$$\n\n- If $|1-2x|=-(1-2x),$ we obtain:\n\n$$\n\\begin{aligned}|1-2x| & =9 \\\\ -(1-2x) & =9 \\\\ -1+2x & =9 \\\\ 2x & =10 \\\\ x & =5\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x=-4$ and $x=5.$"] ["question-e2cc5506-dc0b-5a5b-8907-9924a3a993c1" :question/difficulty :question.difficulty/easy] ["answer-field-4805b999-73a4-56f9-85d1-fd39b746b678" :answer-field/id #uuid "4805b999-73a4-56f9-85d1-fd39b746b678"] ["answer-dad0e77a-e20e-537d-a75c-ebf6a272d4ad" :answer/id #uuid "dad0e77a-e20e-537d-a75c-ebf6a272d4ad"] ["answer-dad0e77a-e20e-537d-a75c-ebf6a272d4ad" :answer/type :answer.type/math] ["answer-dad0e77a-e20e-537d-a75c-ebf6a272d4ad" :answer/value "-4"] ["answer-field-4805b999-73a4-56f9-85d1-fd39b746b678" :answer-field/key "field-1"] ["answer-field-4805b999-73a4-56f9-85d1-fd39b746b678" :answer-field/type :answer-field.type/blank] ["answer-field-4805b999-73a4-56f9-85d1-fd39b746b678" :answer-field/correct "answer-dad0e77a-e20e-537d-a75c-ebf6a272d4ad"] ["answer-field-4805b999-73a4-56f9-85d1-fd39b746b678" :answer-field/choices "answer-dad0e77a-e20e-537d-a75c-ebf6a272d4ad"] ["answer-field-551c716c-7245-54c5-b067-9d77aa114b1a" :answer-field/id #uuid "551c716c-7245-54c5-b067-9d77aa114b1a"] ["answer-92345246-b68e-50d2-85cc-0c9a1ffea68e" :answer/id #uuid "92345246-b68e-50d2-85cc-0c9a1ffea68e"] ["answer-92345246-b68e-50d2-85cc-0c9a1ffea68e" :answer/type :answer.type/math] ["answer-92345246-b68e-50d2-85cc-0c9a1ffea68e" :answer/value "5"] ["answer-field-551c716c-7245-54c5-b067-9d77aa114b1a" :answer-field/key "field-2"] ["answer-field-551c716c-7245-54c5-b067-9d77aa114b1a" :answer-field/type :answer-field.type/blank] ["answer-field-551c716c-7245-54c5-b067-9d77aa114b1a" :answer-field/correct "answer-92345246-b68e-50d2-85cc-0c9a1ffea68e"] ["answer-field-551c716c-7245-54c5-b067-9d77aa114b1a" :answer-field/choices "answer-92345246-b68e-50d2-85cc-0c9a1ffea68e"] ["question-e2cc5506-dc0b-5a5b-8907-9924a3a993c1" :question/answer-fields "answer-field-4805b999-73a4-56f9-85d1-fd39b746b678"] ["question-e2cc5506-dc0b-5a5b-8907-9924a3a993c1" :question/answer-fields "answer-field-551c716c-7245-54c5-b067-9d77aa114b1a"] [17592186192636 :knowledge-point/questions "question-e2cc5506-dc0b-5a5b-8907-9924a3a993c1"] [17592186069424 :question/problem "Simplify $\\sqrt[3]{-\\frac{64}{{b}^{3}}}.$"] [17592186069424 :question/worked-solution "To simplify the expression, we write the term under the radical as a perfect cube, and simplify:\n\n$$\n\\begin{aligned}\\sqrt[3]{-\\frac{64}{{b}^{3}}} & = \\\\ \\sqrt[3]{(-\\frac{4}{b})\\cdot (-\\frac{4}{b})\\cdot (-\\frac{4}{b})} & = \\\\ \\sqrt[3]{{(-\\frac{4}{b})}^{3}} & = \\\\ -\\frac{4}{b}\\end{aligned}\n$$"] [17592186069424 :question/difficulty :question.difficulty/moderate] ["answer-b1595b53-a21f-533f-948c-76530eaa78e7" :answer/id #uuid "b1595b53-a21f-533f-948c-76530eaa78e7"] ["answer-b1595b53-a21f-533f-948c-76530eaa78e7" :answer/type :answer.type/math] ["answer-b1595b53-a21f-533f-948c-76530eaa78e7" :answer/value "-\\frac{4}{{b}^{2}}"] [17592186067714 :answer-field/correct 17592186067715] [17592186067714 :answer-field/choices "answer-b1595b53-a21f-533f-948c-76530eaa78e7"] ["question-f2983b81-0133-59cc-8912-96155bb43215" :question/id #uuid "f2983b81-0133-59cc-8912-96155bb43215"] ["question-f2983b81-0133-59cc-8912-96155bb43215" :question/math-academy-id "q-117951"] ["question-f2983b81-0133-59cc-8912-96155bb43215" :question/problem "![](images/30/304c79983ae3d5cdc007d62aa8e30bac247c1370239a9029a33b21b7fcf2f309.png)\n\nOrder the sides of the triangle $△RST$ above from the shortest to the longest."] ["question-f2983b81-0133-59cc-8912-96155bb43215" :question/worked-solution "First, let's find the missing angle $T.$ Since the interior angles of a triangle sum to ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠R+m∠S+m∠T & ={180}^{∘} \\\\ {40}^{∘}+{103}^{∘}+m∠T & ={180}^{∘} \\\\ m∠T & ={180}^{∘}-{143}^{∘} \\\\ m∠T & ={37}^{∘}.\\end{aligned}\n$$\n\nSince $∠T$ is the smallest angle, its opposite side $\\overset{―}{RS}$ is the shortest side of the triangle.\n\nSince $∠S$ is the largest angle, its opposite side $\\overset{―}{RT}$ must be the longest side of the triangle. \n\nSo, we have\n\n$$\nRS<ST<RT\n$$\n\nand therefore, the required order is\n\n$$\n\\overset{―}{RS},\\overset{―}{ST},\\overset{―}{RT}.\n$$"] ["question-f2983b81-0133-59cc-8912-96155bb43215" :question/difficulty :question.difficulty/moderate] ["answer-field-1d7a78bb-16be-5300-81b5-d88dcf737ba7" :answer-field/id #uuid "1d7a78bb-16be-5300-81b5-d88dcf737ba7"] ["answer-6c64bbe2-dc8b-59c6-8ea8-95bb9a823367" :answer/id #uuid "6c64bbe2-dc8b-59c6-8ea8-95bb9a823367"] ["answer-6c64bbe2-dc8b-59c6-8ea8-95bb9a823367" :answer/type :answer.type/math] ["answer-6c64bbe2-dc8b-59c6-8ea8-95bb9a823367" :answer/value "\\overset{―}{RS},\\overset{―}{RT},\\overset{―}{ST}"] ["answer-cb6c7bae-6800-5585-892f-162cfd43f379" :answer/id #uuid "cb6c7bae-6800-5585-892f-162cfd43f379"] ["answer-cb6c7bae-6800-5585-892f-162cfd43f379" :answer/type :answer.type/math] ["answer-cb6c7bae-6800-5585-892f-162cfd43f379" :answer/value "\\overset{―}{RS},\\overset{―}{ST},\\overset{―}{RT}"] ["answer-201ce639-d825-59d4-909d-cc029b989d10" :answer/id #uuid "201ce639-d825-59d4-909d-cc029b989d10"] ["answer-201ce639-d825-59d4-909d-cc029b989d10" :answer/type :answer.type/math] ["answer-201ce639-d825-59d4-909d-cc029b989d10" :answer/value "\\overset{―}{RT},\\overset{―}{RS},\\overset{―}{ST}"] ["answer-bee89c04-7119-59e0-b530-75c0a845b5fd" :answer/id #uuid "bee89c04-7119-59e0-b530-75c0a845b5fd"] ["answer-bee89c04-7119-59e0-b530-75c0a845b5fd" :answer/type :answer.type/math] ["answer-bee89c04-7119-59e0-b530-75c0a845b5fd" :answer/value "\\overset{―}{RT},\\overset{―}{ST},\\overset{―}{RS}"] ["answer-f5e1a852-120a-5338-ab79-edc1563e6cf1" :answer/id #uuid "f5e1a852-120a-5338-ab79-edc1563e6cf1"] ["answer-f5e1a852-120a-5338-ab79-edc1563e6cf1" :answer/type :answer.type/math] ["answer-f5e1a852-120a-5338-ab79-edc1563e6cf1" :answer/value "\\overset{―}{ST},\\overset{―}{RS},\\overset{―}{RT}"] ["answer-field-1d7a78bb-16be-5300-81b5-d88dcf737ba7" :answer-field/key "selection"] ["answer-field-1d7a78bb-16be-5300-81b5-d88dcf737ba7" :answer-field/type :answer-field.type/radio] ["answer-field-1d7a78bb-16be-5300-81b5-d88dcf737ba7" :answer-field/correct "answer-cb6c7bae-6800-5585-892f-162cfd43f379"] ["answer-field-1d7a78bb-16be-5300-81b5-d88dcf737ba7" :answer-field/choices "answer-6c64bbe2-dc8b-59c6-8ea8-95bb9a823367"] ["answer-field-1d7a78bb-16be-5300-81b5-d88dcf737ba7" :answer-field/choices "answer-cb6c7bae-6800-5585-892f-162cfd43f379"] ["answer-field-1d7a78bb-16be-5300-81b5-d88dcf737ba7" :answer-field/choices "answer-201ce639-d825-59d4-909d-cc029b989d10"] ["answer-field-1d7a78bb-16be-5300-81b5-d88dcf737ba7" :answer-field/choices "answer-bee89c04-7119-59e0-b530-75c0a845b5fd"] ["answer-field-1d7a78bb-16be-5300-81b5-d88dcf737ba7" :answer-field/choices "answer-f5e1a852-120a-5338-ab79-edc1563e6cf1"] ["question-f2983b81-0133-59cc-8912-96155bb43215" :question/answer-fields "answer-field-1d7a78bb-16be-5300-81b5-d88dcf737ba7"] [17592186115408 :knowledge-point/questions "question-f2983b81-0133-59cc-8912-96155bb43215"] ["question-5c6ca484-3f17-5181-8810-930cfb1991ba" :question/id #uuid "5c6ca484-3f17-5181-8810-930cfb1991ba"] ["question-5c6ca484-3f17-5181-8810-930cfb1991ba" :question/math-academy-id "q-171612"] ["question-5c6ca484-3f17-5181-8810-930cfb1991ba" :question/problem "The solution to the inequality $-2a\\ge 10$ is $a${{field-1}}{{field-2}}."] ["question-5c6ca484-3f17-5181-8810-930cfb1991ba" :question/worked-solution "The variable $a$ is being *multiplied* by $-2.$ To isolate $a,$ we perform the *opposite* operation, which is *dividing* by $-2.$ Remember to perform the same operation on both sides.\n\nAlso, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-2a\\,\\, & \\ge \\,\\,10 \\\\ \\frac{-2a}{-2}\\,\\, & \\le \\,\\,\\frac{10}{-2} \\\\ \\frac{-2a}{-2}\\,\\, & \\le \\,\\,-5\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $-2$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}\\frac{-2a}{-2} & \\le -5 \\\\ \\frac{\\cancel{-2}a}{\\cancel{-2}} & \\le -5 \\\\ a & \\le -5\\end{aligned}\n$$\n\nTherefore, the solution is $a\\le -5.$"] ["question-5c6ca484-3f17-5181-8810-930cfb1991ba" :question/difficulty :question.difficulty/easy] ["answer-field-ac508ebb-eb69-5e10-b789-82b08fb0c3a2" :answer-field/id #uuid "ac508ebb-eb69-5e10-b789-82b08fb0c3a2"] ["answer-5b908877-4e9b-5192-8fd2-65f4fa1e3b4e" :answer/id #uuid "5b908877-4e9b-5192-8fd2-65f4fa1e3b4e"] ["answer-5b908877-4e9b-5192-8fd2-65f4fa1e3b4e" :answer/type :answer.type/math] ["answer-5b908877-4e9b-5192-8fd2-65f4fa1e3b4e" :answer/value "\\le"] ["answer-field-ac508ebb-eb69-5e10-b789-82b08fb0c3a2" :answer-field/key "field-1"] ["answer-field-ac508ebb-eb69-5e10-b789-82b08fb0c3a2" :answer-field/type :answer-field.type/blank] ["answer-field-ac508ebb-eb69-5e10-b789-82b08fb0c3a2" :answer-field/correct "answer-5b908877-4e9b-5192-8fd2-65f4fa1e3b4e"] ["answer-field-ac508ebb-eb69-5e10-b789-82b08fb0c3a2" :answer-field/choices "answer-5b908877-4e9b-5192-8fd2-65f4fa1e3b4e"] ["answer-field-217bc00d-ea7b-5b67-b963-3c6eb56a93da" :answer-field/id #uuid "217bc00d-ea7b-5b67-b963-3c6eb56a93da"] ["answer-a8eccfa2-7023-5398-8b0c-e3113e038df8" :answer/id #uuid "a8eccfa2-7023-5398-8b0c-e3113e038df8"] ["answer-a8eccfa2-7023-5398-8b0c-e3113e038df8" :answer/type :answer.type/math] ["answer-a8eccfa2-7023-5398-8b0c-e3113e038df8" :answer/value "-5"] ["answer-field-217bc00d-ea7b-5b67-b963-3c6eb56a93da" :answer-field/key "field-2"] ["answer-field-217bc00d-ea7b-5b67-b963-3c6eb56a93da" :answer-field/type :answer-field.type/blank] ["answer-field-217bc00d-ea7b-5b67-b963-3c6eb56a93da" :answer-field/correct "answer-a8eccfa2-7023-5398-8b0c-e3113e038df8"] ["answer-field-217bc00d-ea7b-5b67-b963-3c6eb56a93da" :answer-field/choices "answer-a8eccfa2-7023-5398-8b0c-e3113e038df8"] ["question-5c6ca484-3f17-5181-8810-930cfb1991ba" :question/answer-fields "answer-field-ac508ebb-eb69-5e10-b789-82b08fb0c3a2"] ["question-5c6ca484-3f17-5181-8810-930cfb1991ba" :question/answer-fields "answer-field-217bc00d-ea7b-5b67-b963-3c6eb56a93da"] [17592186054770 :knowledge-point/questions "question-5c6ca484-3f17-5181-8810-930cfb1991ba"] ["question-fe6f82c7-c73d-5fb8-9cbc-ff242831dba6" :question/id #uuid "fe6f82c7-c73d-5fb8-9cbc-ff242831dba6"] ["question-fe6f82c7-c73d-5fb8-9cbc-ff242831dba6" :question/math-academy-id "q-44680"] ["question-fe6f82c7-c73d-5fb8-9cbc-ff242831dba6" :question/problem "Evaluate the polynomial $\\frac{{z}^{2}}{4}+\\frac{3z}{4}-\\frac{1}{2}$ at $z=2.$"] ["question-fe6f82c7-c73d-5fb8-9cbc-ff242831dba6" :question/worked-solution "To evaluate, we substitute $z=2$  into the polynomial and simplify:\n\n$$\n\\begin{aligned}\\frac{{z}^{2}}{4}+\\frac{3z}{4}-\\frac{1}{2} & = \\\\ \\frac{{2}^{2}}{4}+\\frac{3(2)}{4}-\\frac{1}{2} & = \\\\ \\frac{4}{4}+\\frac{3}{2}-\\frac{1}{2} & = \\\\ 1+1 & = \\\\ 2\\end{aligned}\n$$"] ["question-fe6f82c7-c73d-5fb8-9cbc-ff242831dba6" :question/difficulty :question.difficulty/moderate] ["answer-field-15720162-78da-5cb1-b598-b8344581476a" :answer-field/id #uuid "15720162-78da-5cb1-b598-b8344581476a"] ["answer-677f5fec-7b47-57ac-aa80-a11d479550ef" :answer/id #uuid "677f5fec-7b47-57ac-aa80-a11d479550ef"] ["answer-677f5fec-7b47-57ac-aa80-a11d479550ef"