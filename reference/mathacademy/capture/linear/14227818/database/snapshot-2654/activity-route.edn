#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186550092} :activity/id #uuid "847b3b98-525e-581f-ac77-9ada3ce6c1aa" :activity/steps [{:db/id #edb/ref 17592186550039 :step/content {:db/id #edb/ref 17592186550006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dad0e77a-e20e-537d-a75c-ebf6a272d4ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186549719}] :answer-field/correct {:db/id #edb/ref 17592186549719} :answer-field/id #uuid "4805b999-73a4-56f9-85d1-fd39b746b678" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186549832} {:answer-field/choices [{:answer/id #uuid "92345246-b68e-50d2-85cc-0c9a1ffea68e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186549602}] :answer-field/correct {:db/id #edb/ref 17592186549602} :answer-field/id #uuid "551c716c-7245-54c5-b067-9d77aa114b1a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186549834}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e2cc5506-dc0b-5a5b-8907-9924a3a993c1" :question/math-academy-id "q-215510" :question/problem "Written in ascending order, the solutions to $|1-2x|-2=7$ are $x=${{field-1}}\nand $x=$\n{{field-2}}." :question/worked-solution "First, we isolate the absolute value on the left side of the equation:\n\n$$\n\\begin{aligned}|1-2x|-2 & =7 \\\\ |1-2x| & =9\\end{aligned}\n$$\n\nNow, we have the following two cases:\n\n- If $|1-2x|=1-2x,$ we obtain:\n\n$$\n\\begin{aligned}|1-2x| & =9 \\\\ 1-2x & =9 \\\\ -2x & =8 \\\\ x & =-4\\end{aligned}\n$$\n\n- If $|1-2x|=-(1-2x),$ we obtain:\n\n$$\n\\begin{aligned}|1-2x| & =9 \\\\ -(1-2x) & =9 \\\\ -1+2x & =9 \\\\ 2x & =10 \\\\ x & =5\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x=-4$ and $x=5.$"} :step/id #uuid "2ecdc53b-01a7-5355-9761-f4d0cd7c4210" :step/next {:db/id #edb/ref 17592186550047}} {:db/id #edb/ref 17592186550044 :step/content {:db/id #edb/ref 17592186549989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b2fe58c-5054-5bba-9320-f36184ca121e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4(r+2)^{2}" :db/id #edb/ref 17592186549370} {:answer/id #uuid "21357de3-9850-5489-b2a4-8b42a3cf8c41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4(r-2)^{2}" :db/id #edb/ref 17592186549383} {:answer/id #uuid "443effa8-8bc4-55af-875b-6cb18f9954c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2r+2)^{2}" :db/id #edb/ref 17592186549456} {:answer/id #uuid "81b04f59-9424-5ce4-9b14-2e06ca51be24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2(r+2)^{2}" :db/id #edb/ref 17592186549556} {:answer/id #uuid "b857f724-d721-59f2-a1ef-b1e614faeab1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2r+1)^{2}" :db/id #edb/ref 17592186549661}] :answer-field/correct {:db/id #edb/ref 17592186549370} :answer-field/id #uuid "3f628070-e478-5242-8b4f-a4dea04f863c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549829}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "af2a1028-5c68-5261-af13-01fa26bc76aa" :question/math-academy-id "q-2765" :question/problem "Factor the expression $4{r}^{2}+16r+16.$" :question/worked-solution "Notice that all of the terms have a common factor of $4.$ Therefore, we can simplify the expression by factoring out $4,$ as follows:\n\n$$\n\\begin{aligned}4{r}^{2}+16r+16 & = \\\\ 4({r}^{2}+4r+4)\\end{aligned}\n$$\n\nNow, let's factor the expression inside parentheses using the square of a sum formula:\n\n$$\n\\begin{aligned}{r}^{2}+4r+4 & = \\\\ {r}^{2}+4r+{2}^{2} & = \\\\ {r}^{2}+2\\cdot 2r+{2}^{2} & = \\\\ (r+2)^{2}\\end{aligned}\n$$\n\n \n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}4({r}^{2}+4r+4) & = \\\\ 4(r+2)^{2}\\end{aligned}\n$$"} :step/id #uuid "3aa6c554-176f-5c59-afc8-934d6bc78ac1" :step/next {:db/id #edb/ref 17592186550039}} {:db/id #edb/ref 17592186550047 :step/content {:db/id #edb/ref 17592186069424 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8db7862b-5783-5ab9-a17c-fc752181c249" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{b}" :db/id #edb/ref 17592186067715} {:answer/id #uuid "afd89451-dbcc-525a-914e-caa711a2abb7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{b}" :db/id #edb/ref 17592186067716} {:answer/id #uuid "ea601f60-3ff6-518d-b00e-24fb09177034" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{8}{b}" :db/id #edb/ref 17592186067718} {:answer/id #uuid "6c911733-8c6b-5b54-b28b-ffba8ec043c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{b}" :db/id #edb/ref 17592186067719} {:answer/id #uuid "b1595b53-a21f-533f-948c-76530eaa78e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{{b}^{2}}" :db/id #edb/ref 17592186549648}] :answer-field/correct {:db/id #edb/ref 17592186067715} :answer-field/id #uuid "d0a19cef-79e8-55b0-b52d-817fbf5bad48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186067714}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c88910e9-93dc-5fa8-9def-79b320b71eb9" :question/math-academy-id "q-52492" :question/problem "Simplify $\\sqrt[3]{-\\frac{64}{{b}^{3}}}.$" :question/worked-solution "To simplify the expression, we write the term under the radical as a perfect cube, and simplify:\n\n$$\n\\begin{aligned}\\sqrt[3]{-\\frac{64}{{b}^{3}}} & = \\\\ \\sqrt[3]{(-\\frac{4}{b})\\cdot (-\\frac{4}{b})\\cdot (-\\frac{4}{b})} & = \\\\ \\sqrt[3]{{(-\\frac{4}{b})}^{3}} & = \\\\ -\\frac{4}{b}\\end{aligned}\n$$"} :step/id #uuid "3dc10566-71f1-5733-8f61-e93c9e40f5b1" :step/next {:db/id #edb/ref 17592186550087}} {:db/id #edb/ref 17592186550056 :step/content {:db/id #edb/ref 17592186550009 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25c699cc-f84c-5b48-8508-432e14803537" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2n+1}" :db/id #edb/ref 17592186549395}] :answer-field/correct {:db/id #edb/ref 17592186549395} :answer-field/id #uuid "a2a58eb4-92a4-5719-9dfb-a3aad6a40bc0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186549879}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ea72a94a-bdd5-5d3c-b2b4-c2e3488df948" :question/math-academy-id "q-208694" :question/problem "If $2mn+m+4=7,$ then $m=${{field-1}}." :question/worked-solution "We need to isolate all terms with $m$ on one side of the equation. To do this, we subtract $4$ to both sides:\n\n$$\n\\begin{aligned}2mn+m+4 & =7 \\\\ 2mn+m+4-4 & =7-4 \\\\ 2mn+m & =3\\end{aligned}\n$$\n\nNext, we factor out $m$ in the expression on the left-hand side.\n\n$$\n\\begin{aligned}2mn+m & =3 \\\\ m(2n+1) & =3\\end{aligned}\n$$\n\nThen, we divide both sides by $(2n+1)$ to isolate $m:$\n\n$$\n\\begin{aligned}m(2n+1) & =3 \\\\ \\frac{m(2n+1)}{2n+1} & =\\frac{3}{2n+1} \\\\ \\frac{m\\cancel{(2n+1)}}{\\cancel{2n+1}} & =\\frac{3}{2n+1} \\\\ m & =\\frac{3}{2n+1}\\end{aligned}\n$$\n\n**Note:** This result assumes that $2n+1\\ne 0.$"} :step/id #uuid "56bb3c30-2afe-5b11-a004-62947497ce5e" :step/next {:db/id #edb/ref 17592186550044}} {:db/id #edb/ref 17592186550062 :step/content {:db/id #edb/ref 17592186549950 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71a54dfc-a7bc-50b1-888f-91e3d09fe8d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{v}{2dh}" :db/id #edb/ref 17592186549531}] :answer-field/correct {:db/id #edb/ref 17592186549531} :answer-field/id #uuid "066b2166-822f-5d65-8ee3-2f1f64ae2d7d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186549796}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2c796978-9336-5fc7-a4cc-bd1fe1ccd4cd" :question/math-academy-id "q-215096" :question/problem "If $v=2τdh,$ then $τ=${{field-1}}." :question/worked-solution "We need to isolate $τ,$ so we will treat the other variables $v,d,$ and $h$ as constants. We can use the multiplication principle to solve for $τ.$\n\nFirst, we rearrange and then divide both sides by $2dh:$\n\n$$\n\\begin{aligned}v & =2τdh \\\\ v & =(2dh)τ \\\\ \\frac{v}{2dh} & =\\frac{(2dh)τ}{2dh} \\\\ \\frac{v}{2dh} & =τ\\end{aligned}\n$$\n\nTherefore, $τ=\\frac{v}{2dh}.$\n\n**Note:** This result assumes that $d\\ne 0$ and $h\\ne 0.$"} :step/id #uuid "5ed022d1-55d7-5557-9818-d5cd788aef99" :step/next {:db/id #edb/ref 17592186550075}} {:db/id #edb/ref 17592186550066 :step/content {:db/id #edb/ref 17592186549995 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ac94868-df19-5ec5-bcd2-c6a2c7a548b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5}^{7}\\times {3}^{4}" :db/id #edb/ref 17592186549332} {:answer/id #uuid "505fc778-325e-5f2c-b027-1e6623d55f37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5}^{12}\\times {3}^{4}" :db/id #edb/ref 17592186549478} {:answer/id #uuid "7612e3e8-6c41-58cd-b9cd-de345315c958" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5}^{10}\\times {3}^{6}" :db/id #edb/ref 17592186549542} {:answer/id #uuid "e38221f4-6a33-5206-9b11-ccf256f3aa86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5}^{3}\\times {3}^{8}" :db/id #edb/ref 17592186549735} {:answer/id #uuid "f8652722-ecb3-51f0-bc15-77dae7eb9a77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5}^{12}\\times {3}^{8}" :db/id #edb/ref 17592186549783}] :answer-field/correct {:db/id #edb/ref 17592186549478} :answer-field/id #uuid "8bd771f8-1da2-5ff5-b018-e0a61817e437" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549866}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c20addaa-2ef3-5691-8ace-1f1d2895fe58" :question/math-academy-id "q-68963" :question/problem "${({5}^{3}\\times 3)}^{4}=$" :question/worked-solution "First, we apply the power of product rule for exponents:\n\n$$\n{({5}^{3}\\times 3)}^{4}={({5}^{3})}^{4}\\times {3}^{4}\n$$\n\nThen, we rewrite the first factor using the power rule for exponents, and simplify:\n\n$$\n{({5}^{3})}^{4}\\times {3}^{4}={5}^{3\\cdot 4}\\times {3}^{4}={5}^{12}\\times {3}^{4}\n$$"} :step/id #uuid "6da7d17f-49ff-520c-9d2b-7b16e9928b0c" :step/next {:db/id #edb/ref 17592186550062}} {:db/id #edb/ref 17592186550075 :step/content {:db/id #edb/ref 17592186550003 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27fdf04b-368f-516d-9e0e-8cca33d47e26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\sqrt[3]{3}" :db/id #edb/ref 17592186549400} {:answer/id #uuid "3af63541-1762-58f0-a991-4c6b26b43531" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt[3]{2}" :db/id #edb/ref 17592186549436} {:answer/id #uuid "69a0d827-e260-5878-81a5-f3ff4aab7335" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[3]{2}" :db/id #edb/ref 17592186549518} {:answer/id #uuid "b93ea9d0-8b76-54b8-8b51-d66c68f7b7fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186549664} {:answer/id #uuid "bba12de4-ce73-58e0-91af-1d1824b8de14" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186549668}] :answer-field/correct {:db/id #edb/ref 17592186549436} :answer-field/id #uuid "b9a3fd1a-2273-5c72-90b6-7e74178421d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549893}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d9b9c93d-9a95-57ab-bfc8-b62b1c153ff8" :question/math-academy-id "q-63877" :question/problem "Evaluate $\\sqrt[3]{5y+1}$ at $y=3.$" :question/worked-solution "We replace $y$ with $3$ in the given expression, and simplify as much as possible:\n\n$$\n\\begin{aligned}\\sqrt[3]{5y+1} & = \\\\ \\sqrt[3]{5\\cdot 3+1} & = \\\\ \\sqrt[3]{15+1} & = \\\\ \\sqrt[3]{16} & = \\\\ \\sqrt[3]{8\\cdot 2} & = \\\\ \\sqrt[3]{8}\\cdot \\sqrt[3]{2} & = \\\\ \\sqrt[3]{{2}^{3}}\\cdot \\sqrt[3]{2} & = \\\\ 2\\sqrt[3]{2} & \\end{aligned}\n$$"} :step/id #uuid "8910007d-04c4-5e67-88ba-19f39a138b47"} {:db/id #edb/ref 17592186550083 :step/content {:db/id #edb/ref 17592186549963 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8eccfa2-7023-5398-8b0c-e3113e038df8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186549636}] :answer-field/correct {:db/id #edb/ref 17592186549636} :answer-field/id #uuid "217bc00d-ea7b-5b67-b963-3c6eb56a93da" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186549817} {:answer-field/choices [{:answer/id #uuid "5b908877-4e9b-5192-8fd2-65f4fa1e3b4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le" :db/id #edb/ref 17592186549498}] :answer-field/correct {:db/id #edb/ref 17592186549498} :answer-field/id #uuid "ac508ebb-eb69-5e10-b789-82b08fb0c3a2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186549882}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5c6ca484-3f17-5181-8810-930cfb1991ba" :question/math-academy-id "q-171612" :question/problem "The solution to the inequality $-2a\\ge 10$ is $a${{field-1}}{{field-2}}." :question/worked-solution "The variable $a$ is being *multiplied* by $-2.$ To isolate $a,$ we perform the *opposite* operation, which is *dividing* by $-2.$ Remember to perform the same operation on both sides.\n\nAlso, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-2a\\,\\, & \\ge \\,\\,10 \\\\ \\frac{-2a}{-2}\\,\\, & \\le \\,\\,\\frac{10}{-2} \\\\ \\frac{-2a}{-2}\\,\\, & \\le \\,\\,-5\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $-2$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}\\frac{-2a}{-2} & \\le -5 \\\\ \\frac{\\cancel{-2}a}{\\cancel{-2}} & \\le -5 \\\\ a & \\le -5\\end{aligned}\n$$\n\nTherefore, the solution is $a\\le -5.$"} :step/id #uuid "a4b3d8c7-83da-55a7-8b16-e7e4cbd13a51" :step/next {:db/id #edb/ref 17592186550107}} {:db/id #edb/ref 17592186550087 :step/content {:db/id #edb/ref 17592186550012 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "201ce639-d825-59d4-909d-cc029b989d10" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\overset{―}{RT},\\overset{―}{RS},\\overset{―}{ST}" :db/id #edb/ref 17592186549378} {:answer/id #uuid "6c64bbe2-dc8b-59c6-8ea8-95bb9a823367" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\overset{―}{RS},\\overset{―}{RT},\\overset{―}{ST}" :db/id #edb/ref 17592186549521} {:answer/id #uuid "bee89c04-7119-59e0-b530-75c0a845b5fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\overset{―}{RT},\\overset{―}{ST},\\overset{―}{RS}" :db/id #edb/ref 17592186549677} {:answer/id #uuid "cb6c7bae-6800-5585-892f-162cfd43f379" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\overset{―}{RS},\\overset{―}{ST},\\overset{―}{RT}" :db/id #edb/ref 17592186549695} {:answer/id #uuid "f5e1a852-120a-5338-ab79-edc1563e6cf1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\overset{―}{ST},\\overset{―}{RS},\\overset{―}{RT}" :db/id #edb/ref 17592186549775}] :answer-field/correct {:db/id #edb/ref 17592186549695} :answer-field/id #uuid "1d7a78bb-16be-5300-81b5-d88dcf737ba7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549811}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f2983b81-0133-59cc-8912-96155bb43215" :question/math-academy-id "q-117951" :question/problem "![](images/30/304c79983ae3d5cdc007d62aa8e30bac247c1370239a9029a33b21b7fcf2f309.png)\n\nOrder the sides of the triangle $△RST$ above from the shortest to the longest." :question/worked-solution "First, let's find the missing angle $T.$ Since the interior angles of a triangle sum to ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠R+m∠S+m∠T & ={180}^{∘} \\\\ {40}^{∘}+{103}^{∘}+m∠T & ={180}^{∘} \\\\ m∠T & ={180}^{∘}-{143}^{∘} \\\\ m∠T & ={37}^{∘}.\\end{aligned}\n$$\n\nSince $∠T$ is the smallest angle, its opposite side $\\overset{―}{RS}$ is the shortest side of the triangle.\n\nSince $∠S$ is the largest angle, its opposite side $\\overset{―}{RT}$ must be the longest side of the triangle. \n\nSo, we have\n\n$$\nRS<ST<RT\n$$\n\nand therefore, the required order is\n\n$$\n\\overset{―}{RS},\\overset{―}{ST},\\overset{―}{RT}.\n$$"} :step/id #uuid "ae484d21-22db-51d2-b8a9-ce3832fc68bb" :step/next {:db/id #edb/ref 17592186550083}} {:db/id #edb/ref 17592186550091 :step/content {:db/id #edb/ref 17592186549961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d40922e-bbe8-5b94-813f-515ef8920c77" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186549374} {:answer/id #uuid "46af0f5c-e63b-5c43-8a7a-63eca133b229" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186549461} {:answer/id #uuid "71b862ff-f819-58ba-8500-e7a6c8b9b38e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186549532} {:answer/id #uuid "99bd640f-26eb-57be-b433-3a9313b2d3bf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186549613} {:answer/id #uuid "f212cd6f-41a2-599e-83ee-e2b7414a0f6a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186549765}] :answer-field/correct {:db/id #edb/ref 17592186549374} :answer-field/id #uuid "6452e741-3219-5674-aa9c-11f468eb9f0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549843}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "47312f69-f326-5376-9041-14157a2dd5a5" :question/math-academy-id "q-103266" :question/problem "![](images/4f/4f538bb715c53ad0478539feaef29c725f6f6e494134726faede38586e60a4d6.png)\n\nWhich of the following statements are true regarding the angles shown above?\n\nI. $m∠AOB=m∠BOC$\n\nII. $m∠BOC=m∠COD$\n\nIII. $∠AOB≅∠DOE$" :question/worked-solution "From the diagram, we see that \n\n- $∠AOB$ and $∠BOC$ are marked with $|$, and\n\n- $∠COD$ and $∠DOE$ are marked with $||.$\n\nTherefore,\n\n$$\n\\begin{aligned}∠AOB & ≅∠BOC \\\\ ∠COD & ≅∠DOE.\\end{aligned}\n$$\n\nConsequently, we have\n\n$$\n\\begin{aligned}m∠AOB & =m∠BOC \\\\ m∠COD & =m∠DOE.\\end{aligned}\n$$\n\nSo statement I is true, while statements II and III are false."} :step/id #uuid "b1398280-1413-5d2e-a186-84808efb576d" :step/next {:db/id #edb/ref 17592186550115}} {:db/id #edb/ref 17592186550092 :step/content {:db/id #edb/ref 17592186069358 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15f20d2e-d455-5504-916c-4a9743e14795" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=3" :db/id #edb/ref 17592186549355} {:answer/id #uuid "1903a828-2ddb-5f00-80c5-19f5e92b453a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=1" :db/id #edb/ref 17592186549365} {:answer/id #uuid "21ce9c20-f571-545e-977f-4d515aced9be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-1" :db/id #edb/ref 17592186549385} {:answer/id #uuid "4ff56c93-8f4d-5dca-8f7e-6a6a25c4cfda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-3" :db/id #edb/ref 17592186549476} {:answer/id #uuid "8994455b-f891-57f8-b13b-45d1a9aa4e96" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=27" :db/id #edb/ref 17592186549576}] :answer-field/correct {:db/id #edb/ref 17592186549476} :answer-field/id #uuid "34dfafd9-d85f-5a4a-92db-e318be3e6648" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186067318}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c7238785-3d78-5ef3-9612-1e7b810378dd" :question/math-academy-id "q-45485" :question/problem "Solve the equation ${3}^{x}=\\frac{1}{27}.$" :question/worked-solution "First, we rewrite $27$ as ${3}^{3}$ to get:\n\n$$\n\\begin{aligned}{3}^{x} & =\\frac{1}{27} \\\\ {3}^{x} & =\\frac{1}{{3}^{3}} \\\\ {3}^{x} & ={3}^{-3}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(3)$, we equate the exponents:\n\n$$\n\\begin{aligned}{3}^{x} & ={3}^{-3} \\\\ x & =-3\\end{aligned}\n$$\n\nTherefore, the solution is $x=-3.$"} :step/id #uuid "b34a8ea6-e18d-5a21-b6f4-5039bc0c45ea" :step/next {:db/id #edb/ref 17592186550056}} {:db/id #edb/ref 17592186550107 :step/content {:db/id #edb/ref 17592186550022 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2354abcc-cea2-5f54-b025-a493d7f2f10e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186549388} {:answer/id #uuid "4b2e51f9-9a04-5a20-a5d2-ec9135740a69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186549467} {:answer/id #uuid "677f5fec-7b47-57ac-aa80-a11d479550ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186549514} {:answer/id #uuid "8825f5d3-ef9c-51d5-9ac8-54ce1710ff19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186549572} {:answer/id #uuid "f79a8362-7b0c-58c0-a434-d4d47dde22c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186549779}] :answer-field/correct {:db/id #edb/ref 17592186549388} :answer-field/id #uuid "15720162-78da-5cb1-b598-b8344581476a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549803}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fe6f82c7-c73d-5fb8-9cbc-ff242831dba6" :question/math-academy-id "q-44680" :question/problem "Evaluate the polynomial $\\frac{{z}^{2}}{4}+\\frac{3z}{4}-\\frac{1}{2}$ at $z=2.$" :question/worked-solution "To evaluate, we substitute $z=2$  into the polynomial and simplify:\n\n$$\n\\begin{aligned}\\frac{{z}^{2}}{4}+\\frac{3z}{4}-\\frac{1}{2} & = \\\\ \\frac{{2}^{2}}{4}+\\frac{3(2)}{4}-\\frac{1}{2} & = \\\\ \\frac{4}{4}+\\frac{3}{2}-\\frac{1}{2} & = \\\\ 1+1 & = \\\\ 2\\end{aligned}\n$$"} :step/id #uuid "d7e8e489-f2c2-5f5f-bc7a-2bf612fe6a17" :step/next {:db/id #edb/ref 17592186550091}} {:db/id #edb/ref 17592186550115 :step/content {:db/id #edb/ref 17592186074001 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "832cc6f9-43ba-5a92-b599-63cd98874d91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186070092} {:answer/id #uuid "83d55fa4-28f6-5a90-b7c5-e9daa3ce1c9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186070093} {:answer/id #uuid "da7b9542-d0c9-5bb1-b3a6-5d4030d53b64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6\\sqrt{3}" :db/id #edb/ref 17592186070094} {:answer/id #uuid "dfb95b0c-a610-5642-8da6-75c961db2d4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186070095} {:answer/id #uuid "ed7176ab-d3cf-50d9-8828-f90e72fadd00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\sqrt{3}" :db/id #edb/ref 17592186070096}] :answer-field/correct {:db/id #edb/ref 17592186070094} :answer-field/id #uuid "0fb5b7f6-608c-58d4-b9fb-bb81516a054c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186070091}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b18991a6-bb94-5a66-967b-9daa091157a1" :question/math-academy-id "q-134363" :question/problem "$4\\sqrt{3}-5\\sqrt{12}=$" :question/worked-solution "First, we use the product rule for radicals, as follows:\n\n$$\n\\begin{aligned}\\sqrt{12} & =\\sqrt{4\\cdot 3}=\\sqrt{4}\\cdot \\sqrt{3}=2\\sqrt{3} & \\end{aligned}\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}4\\sqrt{3}-5\\sqrt{12} & = \\\\ 4\\sqrt{3}-5(2\\sqrt{3}) & = \\\\ 4\\sqrt{3}-10\\sqrt{3}. & \\end{aligned}\n$$\n\nNow, we can combine the two $\\sqrt{3}$ terms together:\n\n$$\n\\begin{aligned}4\\sqrt{3}-10\\sqrt{3} & = \\\\ (4-10)\\sqrt{3} & = \\\\ -6\\sqrt{3} & \\end{aligned}\n$$"} :step/id #uuid "f606f3dd-d4d2-5ad8-86ec-38bc352ad7e0" :step/next {:db/id #edb/ref 17592186550066}}] :activity/title "Quiz 14" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186549308}]}
