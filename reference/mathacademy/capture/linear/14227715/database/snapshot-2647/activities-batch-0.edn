#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186106853} :activity/id #uuid "21a47620-e3ce-58d1-b236-202e42fddc8e" :activity/scope {:db/id #edb/ref 17592186049388 :topic/id #uuid "f0cae3f1-329e-50d8-bc2d-f933c5aca17d" :topic/math-academy-id 1397} :activity/steps [{:db/id #edb/ref 17592186106853 :step/content {:db/id #edb/ref 17592186107053 :tutorial/content "The **area of a triangle** can be computed using the formula\n\n$$\n\\mathcal{A} = \\dfrac{b \\cdot h}{2},\n$$\n\nwhere $b$ is a *base* of the triangle and $h$ is the corresponding *height*.\n\nTo demonstrate, let's compute the area of the triangle with base \n$b = 4$\nand the corresponding height is\n$h = 8,$\nas shown below.\n\n![](images/84/84de11aac8e9f33a459f2a83647dac43eb2054445d842ac769511711366a15ec.png)\n\nThe area is\n\n$$\n\\begin{aligned}A & =\\frac{b\\cdot h}{2} \\\\  & =\\frac{4\\cdot 8}{2} \\\\  & =\\frac{32}{2} \\\\  & =16.\\end{aligned}\n$$\n\n**Note:** At the end of the lesson, we'll demonstrate where the formula comes from. But first, let's get some practice using it." :tutorial/id #uuid "bf61df49-32c4-50ee-a6f4-21f9da391a02" :tutorial/math-academy-id 2306 :tutorial/title "Introduction"} :step/id #uuid "4293d690-2bd3-5e64-91c6-7e02a0c764f9" :step/math-academy-id 416085 :step/next {:db/id #edb/ref 17592186106854}} {:db/id #edb/ref 17592186106854 :step/content {:db/id #edb/ref 17592186105870 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105541 :question/id #uuid "fc5fc31e-f585-5d15-8a8a-eb0d19704e9a" :question/math-academy-id "e-2947"} :knowledge-point/id #uuid "b6c58537-344e-5842-b68c-d9b5a9d7ca96" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048472} {:db/id #edb/ref 17592186049608}] :knowledge-point/questions [{:db/id #edb/ref 17592186106402} {:db/id #edb/ref 17592186106403} {:db/id #edb/ref 17592186253331} {:db/id #edb/ref 17592186284686} {:db/id #edb/ref 17592186332895} {:db/id #edb/ref 17592186392749} {:db/id #edb/ref 17592186508965} {:db/id #edb/ref 17592186508973}] :knowledge-point/title "Calculating the Area of a Triangle"} :step/id #uuid "a5cb1ab1-345e-5828-babf-f43dc62b43f0" :step/math-academy-id 416086 :step/next {:db/id #edb/ref 17592186106855}} {:db/id #edb/ref 17592186106855 :step/content {:db/id #edb/ref 17592186105871 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105542 :question/id #uuid "cdb1d145-6e8a-5213-a7f7-8076440cbbeb" :question/math-academy-id "e-2949"} :knowledge-point/id #uuid "6445834c-7788-5427-a72c-30b06cc8e6ab" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050428}] :knowledge-point/questions [{:db/id #edb/ref 17592186106193} {:db/id #edb/ref 17592186106194} {:db/id #edb/ref 17592186354593} {:db/id #edb/ref 17592186354594} {:db/id #edb/ref 17592186354604} {:db/id #edb/ref 17592186354605} {:db/id #edb/ref 17592186399961} {:db/id #edb/ref 17592186549052}] :knowledge-point/title "Calculating the Area of an Isosceles Right Triangle"} :step/id #uuid "bf4e1141-e78b-57d6-8b32-737373cca813" :step/math-academy-id 416089 :step/next {:db/id #edb/ref 17592186106856}} {:db/id #edb/ref 17592186106856 :step/content {:db/id #edb/ref 17592186105872 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105543 :question/id #uuid "58e1ce31-f6fc-5900-ab89-e00241045b12" :question/math-academy-id "e-2950"} :knowledge-point/id #uuid "a7656d23-06c9-5d22-b62a-3636bca66ab6" :knowledge-point/questions [{:db/id #edb/ref 17592186106155} {:db/id #edb/ref 17592186106388} {:db/id #edb/ref 17592186253335} {:db/id #edb/ref 17592186253338} {:db/id #edb/ref 17592186386869} {:db/id #edb/ref 17592186404426} {:db/id #edb/ref 17592186508991} {:db/id #edb/ref 17592186508996} {:db/id #edb/ref 17592186549027}] :knowledge-point/title "Finding the Base or the Height of a Triangle Given Its Area"} :step/id #uuid "e81bf9a1-61c3-5dc2-8537-01fb6d1a7871" :step/math-academy-id 416092 :step/next {:db/id #edb/ref 17592186106857}} {:db/id #edb/ref 17592186106857 :step/content {:db/id #edb/ref 17592186107055 :tutorial/content "We know that the area formula for a triangle is\n\n$$\n\\mathcal{A} = \\dfrac{b \\cdot h}{2},\n$$\n\nwhere $b$ is a base and $h$ is the corresponding height.\n\nBut where does this formula come from?\n\nTo understand where the formula comes from, consider $\\triangle{ABC}$ below.\n\n![](images/02/02c1ace5f18e9204c1559f08f591ecd692f00691c48cbee81bc4426c3b34400e.png)\n\nLet's draw a rectangle around $\\triangle{ABC},$ as follows:\n\n![](images/89/893026324410235de9cb7ac286867006593a451556587c60219fe4375a4218a4.png)\n\nWe have two pairs of right triangles with equal areas (each pair is indicated with arrows).\n\nSo, the area of $\\triangle{ABC}$ is exactly half of the area of the rectangle. This gives\n\n$$\n\\mathcal{A}_{ABC} = \\dfrac{AB \\cdot CH}{2}.\n$$" :tutorial/id #uuid "b5be18d9-4833-50c8-8800-085d64e21ce8" :tutorial/math-academy-id 2311 :tutorial/title "Proof of the Formula"} :step/id #uuid "d47b1a6f-6091-5f5b-832a-9ce0b04d1526" :step/math-academy-id 416095}] :activity/title "Areas of Triangles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186106016}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186549099} :activity/id #uuid "58c010c8-8685-5554-94e6-4a528432d38e" :activity/scope {:db/id #edb/ref 17592186049388 :topic/id #uuid "f0cae3f1-329e-50d8-bc2d-f933c5aca17d" :topic/math-academy-id 1397} :activity/steps [{:db/id #edb/ref 17592186549084 :step/content {:db/id #edb/ref 17592186549052 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "417abf8e-a35f-5695-b467-ef4d6b12c3f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12.5" :db/id #edb/ref 17592186548479} {:answer/id #uuid "5cfd8bf4-6acb-5b60-99c2-c71861b1536a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186548526} {:answer/id #uuid "a449dec1-300a-5c71-8723-ab8f3583b39a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50" :db/id #edb/ref 17592186548678} {:answer/id #uuid "b32a6fda-8006-5e0b-bc5e-adba5d208d71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186548714} {:answer/id #uuid "e8a23dd6-a819-573e-923b-b6ed5c0e58fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32.5" :db/id #edb/ref 17592186548810}] :answer-field/correct {:db/id #edb/ref 17592186548479} :answer-field/id #uuid "20a135df-b545-5cd9-8ae5-be9b531bfe60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186548881}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d45bf6d6-3e38-52ed-a276-f99fe5dd268f" :question/math-academy-id "q-87851" :question/problem "![](images/67/678c719915b0d27c1378548267123cfbac3f13f13ee0a05fd6dacd85164911f6.png)\n\nWhat is the area of the right triangle $ABC$ shown above?" :question/worked-solution "Since $m∠A=m∠C={45}^{∘}$ and $AB=BC,$ we have an isosceles right triangle. \n\n![](images/4d/4d340b37161cb3f970ba588fa15a21b3a35ee376c5766e92d6c48358d4ed003e.png)\n\nTherefore, the area of the triangle is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}AB\\cdot BC \\\\  & =\\frac{1}{2}\\cdot {5}^{2} \\\\  & =\\frac{1}{2}\\cdot 25 \\\\  & =12.5\\,.\\end{aligned}\n$$"} :step/id #uuid "1d366aad-cd67-5343-baa4-8059cf6699a9" :step/next {:db/id #edb/ref 17592186549111}} {:db/id #edb/ref 17592186549099 :step/content {:db/id #edb/ref 17592186549027 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ed3ec42-7887-59f4-8607-49a2c72ca3d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "49\\,cm" :db/id #edb/ref 17592186548449} {:answer/id #uuid "498f62c4-d10e-5980-af7b-cf193748dc55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18\\,cm" :db/id #edb/ref 17592186548494} {:answer/id #uuid "68718dec-ecd8-5ae5-a90a-23ccd4586c90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\,cm" :db/id #edb/ref 17592186548552} {:answer/id #uuid "897c0883-8ea7-5679-b872-375f1438d23b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7\\,cm" :db/id #edb/ref 17592186548619} {:answer/id #uuid "b854d192-b8ff-551c-8ab1-aef38e4dfe2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14\\,cm" :db/id #edb/ref 17592186548723}] :answer-field/correct {:db/id #edb/ref 17592186548619} :answer-field/id #uuid "8da7771e-63f1-5e10-be3c-1af25ccedf2e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186548930}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8d086598-d0f7-52ac-bba9-a6017b092d64" :question/math-academy-id "q-21051" :question/problem "![](images/c8/c85e6ee974a59d956367634fdd1d57b65e9d42a980fe1750886527b173f05d32.png)\n\nFind $BM$ given that the area of $△ACB$ is $49\\,{cm}^{2},$ $AM=5\\,cm,$ and $MC=9\\,cm.$\n\n(Figure not drawn to scale)" :question/worked-solution "The area of the triangle is defined as \n\n$$\nA=\\frac{b\\cdot h}{2},\n$$\n\n where $b$ is the base and $h$ is the corresponding height.\n\nFrom the diagram, we see that the height is $h=BM,$ and the corresponding base is \n\n$$\nb=AM+MC=14\\,cm.\n$$\n\nTherefore, using the formula for the area, we can solve for the height as follows:\n\n$$\n\\begin{aligned}A & =\\frac{b\\cdot h}{2} \\\\ 49 & =\\frac{14\\cdot h}{2} \\\\ 98 & =14\\cdot h \\\\ h & =\\frac{98}{14} \\\\ h & =7\\,cm\\end{aligned}\n$$\n\nAs a result, $BM=7\\,\\text{cm}.$"} :step/id #uuid "51c06ce5-a234-5a1a-aa5e-9042f0827d88" :step/next {:db/id #edb/ref 17592186549084}} {:db/id #edb/ref 17592186549111 :step/content {:db/id #edb/ref 17592186354604 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2db54839-6a5b-5b75-9ac0-2fe3487ce8c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "800" :db/id #edb/ref 17592186351989} {:answer/id #uuid "43e30190-4e81-5fda-b3a5-079b052411c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "100" :db/id #edb/ref 17592186352191} {:answer/id #uuid "43f1421d-10d0-5af6-8262-60e55e5615e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40" :db/id #edb/ref 17592186352192} {:answer/id #uuid "50c4006c-d6f4-5cb3-977c-4236359a9cc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "200" :db/id #edb/ref 17592186352294} {:answer/id #uuid "7d349513-c9f4-5a55-81fa-6b46f8d0946e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "400" :db/id #edb/ref 17592186352666}] :answer-field/correct {:db/id #edb/ref 17592186352294} :answer-field/id #uuid "23513061-aa39-51dd-a874-2807ff166615" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186353872}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2e4dded3-cef3-55b9-ba8c-e50ddf3e7619" :question/math-academy-id "q-87853" :question/problem "![](images/16/1616f8d921cbdaf1a5654354292e261b0941e5dbfcee16ae620c8a1cf3e92135.png)\n\nWhat is the area of the right triangle $ABC$ shown above?" :question/worked-solution "Since $m∠A=m∠C={45}^{∘}$ and $AB=BC,$ we have an isosceles right  triangle. \n\n![](images/3f/3f9a52834fe76f1560beec8580dbd91076a9f7c6ef980f410aa5bfe7da162c9c.png)\n\nTherefore, the area of the triangle is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}AB\\cdot BC \\\\  & =\\frac{1}{2}\\cdot {20}^{2} \\\\  & =\\frac{1}{2}\\cdot 400 \\\\  & =200.\\end{aligned}\n$$"} :step/id #uuid "7462aa22-72f5-51d7-bde0-cc38a35c0d8c"}] :activity/title "Areas of Triangles" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186548343}]}
