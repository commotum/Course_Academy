acing=\"1em 1em 1em 0.5em\" columnspacing=\"0.278em\" displaystyle=\"true\" columnalign=\"right left\"><mtr><mtd><mi>P</mi><mo stretchy=\"false\">(</mo><mn>7</mn><mo>,</mo><mn>4</mn><mo stretchy=\"false\">)</mo></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>7</mn><mo>!</mo></mrow><mrow><mo stretchy=\"false\">(</mo><mn>7</mn><mo>−</mo><mn>4</mn><mo stretchy=\"false\">)</mo><mo>!</mo></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>7</mn><mo>!</mo></mrow><mrow><mn>3</mn><mo>!</mo></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>7</mn><mo>⋅</mo><mn>6</mn><mo>⋅</mo><mn>5</mn><mo>⋅</mo><mn>4</mn><mo>⋅</mo><menclose notation=\"updiagonalstrike\"><mn>3</mn><mo>!</mo></menclose></mrow><menclose notation=\"updiagonalstrike\"><mn>3</mn><mo>!</mo></menclose></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mn>840.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
