edb/ref 17592186549119 :step/content {:db/id #edb/ref 17592186284770 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65208b93-73ae-599e-971c-64b018afa556" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7\\,840" :db/id #edb/ref 17592186282558} {:answer/id #uuid "74e530a2-a937-5e05-b662-e5de993a3efc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\,810" :db/id #edb/ref 17592186282686} {:answer/id #uuid "91048dd7-d12b-52c0-954f-cc3576a961d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "960" :db/id #edb/ref 17592186282945} {:answer/id #uuid "b09def8c-b7c2-5a82-999e-2018b01fca48" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "210" :db/id #edb/ref 17592186283218} {:answer/id #uuid "b0b13bcd-bdc8-5e03-b5de-3079efc7cbc5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\,040" :db/id #edb/ref 17592186283220}] :answer-field/correct {:db/id #edb/ref 17592186283220} :answer-field/id #uuid "e7018e5b-72aa-5303-87a7-3d9f96c06d53" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284342}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ea179dd2-7f3f-57a8-b438-510de353b7e0" :question/math-academy-id "q-1791" :question/problem "John couldn't recall the serial number on his new bike, but he remembered that it was $4$ digits long, each digit ranged from $0$ to $9$ and that none of the digits were used more than once. How many of these serial numbers are possible?" :question/worked-solution "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $10$ digits, so $n=10.$ We want to select $4$ of those digits for the serial number, so we have $r=4.$\n\nTherefore, the number of different $4$-digit serial numbers is\n\n$$\n\\begin{aligned}{}_{10}{P}_{4} & =\\frac{10!}{(10-4)!} \\\\  & =\\frac{10!}{6!} \\\\  & =\\frac{10\\cdot 9\\cdot 8\\cdot 7\\cdot \\cancel{6!}}{\\cancel{6!}} \\\\  & =10\\cdot 9\\cdot 8\\cdot 7 \\\\  & =5\\,040.\\end{aligned}\n$$"} :step/id #uuid "829b7a87-c027-5f43-a68b-2f01748a8b77" :step/next {:db/id #edb/ref 17592186549141}} {:db/id #edb/ref 17592186549141 :step/content {:db/id #edb/ref 17592186332933 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c0e6488-acf9-5dec-9971-9d89c4ff4871" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "140" :db/id #edb/ref 17592186330199} {:answer/id #uuid "40023def-c8fe-598c-9152-cf65f98f4ebb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186330518} {:answer/id #uuid "6dc73ff1-dc0b-5ce6-833f-0e7dd6455ac6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "840" :db/id #edb/ref 17592186330934} {:answer/id #uuid "a795283b-911d-5cde-9645-eee28d589f8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "42" :db/id #edb/ref 17592186331446} {:answer/id #uuid "e862f54b-bdc7-5d6d-8c42-cb4b04ba9197" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "210" :db/id #edb/ref 17592186331989}] :answer-field/correct {:db/id #edb/ref 17592186330934} :answer-field/id #uuid "782837bc-4cb7-554d-8f7c-4ba4d5ffefb0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186332418}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b4d76645-8ad5-5331-b0d3-fcc2a66efe6e" :question/math-academy-id "q-5564" :question/problem "Evaluate $P(7,4).$" :question/worked-solution "The formula for ${}_{n}{P}_{r}$ is given by\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}\\,.\n$$\n\n$P(7,4)$ means the same thing as ${}_{7}{P}_{4}.$ Using the usual formula for ${}_{n}{P}_{r},$ we get\n\n$$\n\\begin{aligned}P(7,4) & =\\frac{7!}{(7-4)!} \\\\  & =\\frac{7!}{3!} \\\\  & =\\frac{7\\cdot 6\\cdot 5\\cdot 4\\cdot \\cancel{3!}}{\\cancel{3!}} \\\\  & =840.\\end{aligned}\n$$"} :step/id #uuid "c2ce084d-6690-5deb-88e4-1d78920f59c2" :step/next {:db/id #edb/ref 17592186549073}}] :activity/title "Permutations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186548347}]}
