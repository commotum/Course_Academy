      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14274623/observations/step-q140582-b21882d2ad3c2e258d14.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14274623/observations/step-q140582-b21882d2ad3c2e258d14.png",
