#{[{:db/id #edb/ref 17592186563677 :knowledge-point/_questions [{:db/id #edb/ref 17592186083166 :knowledge-point/id #uuid "8d887d9f-b9c4-54b3-a53e-691989bda962" :knowledge-point/title "Classifying Odd Functions Graphically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09408971-4d52-596c-8834-deedff8b5844" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186562957} {:answer/id #uuid "58b55549-1f9a-54cb-ae86-f76e94971508" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186563142} {:answer/id #uuid "a6b0e609-1235-5fa1-becc-779f66d23762" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186563322} {:answer/id #uuid "c7aedaf8-9103-5c9c-b19c-4b12dccbbfed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III and IV only" :db/id #edb/ref 17592186563384} {:answer/id #uuid "e14c93c6-83bb-5c7c-9828-cce9626951e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186563443}] :answer-field/correct {:answer/id #uuid "e14c93c6-83bb-5c7c-9828-cce9626951e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186563443} :answer-field/id #uuid "050fe5b1-848b-5f4c-879f-6f713c662044" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563519}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "422c65f7-5866-5757-b32d-736e922491f4" :question/math-academy-id "q-110654" :question/problem "![](images/58/58e4554f6e5081ec5db6876222a7eeea24135743e4b68e25204084e097066ea4.png)\n\nWhich of the above could be graphs of odd functions?" :question/worked-solution "Recall that the graph of an odd function must have rotational symmetry of order $2$ about the origin.\n\n- Graphs II, III, and IV do not have rotational symmetry of order $2$ about the origin. So, it is **not** an odd function.\n\n- On the other hand, graph I does have rotational symmetry about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that graph  I  show odd functions.\n\n![](images/3b/3b5e234a3416a5e7100468b81f170171a873508eb0c87bba126009daca9e49bc.png)\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186563681 :knowledge-point/_questions [{:db/id #edb/ref 17592186083167 :knowledge-point/id #uuid "8bff4063-9e51-53fa-ab55-e68540e6f587" :knowledge-point/title "Evaluating an Expression Given the Table for an Even or Odd Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54507137-2751-518f-a7f2-bf1dc9ab044b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Odd" :db/id #edb/ref 17592186563136} {:answer/id #uuid "9df12679-6f98-598d-ba66-d0981661d244" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Even" :db/id #edb/ref 17592186563298} {:answer/id #uuid "a55644e4-c45b-579a-9be2-0a59b0e03d92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "It's not a function" :db/id #edb/ref 17592186563320} {:answer/id #uuid "b754548b-7d8c-5141-94fa-e1ffa626e2bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Neither even nor odd" :db/id #edb/ref 17592186563348} {:answer/id #uuid "edf6e733-5e69-5efe-8ed4-57ef94ac17ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Both even and odd" :db/id #edb/ref 17592186563478}] :answer-field/correct {:answer/id #uuid "54507137-2751-518f-a7f2-bf1dc9ab044b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Odd" :db/id #edb/ref 17592186563136} :answer-field/id #uuid "fb959f88-2ef8-53d8-991e-77e015bb77af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563640}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "488cdf32-d755-59bf-889e-a9cbc58dc41a" :question/math-academy-id "q-5870" :question/problem "The table below defines the function $f(x).$ Is the function even, odd, or neither?\n\n| **$x$** | $-6$ | $-4$ | $-2$ | $2$ | $4$ | $6$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $85$ | $75$ | $30$ | $-30$ | $-75$ | $-85$ |" :question/worked-solution "Recall that\n\n- a function is even if $f(-x)=f(x)$ for all $x$ in the domain of $f$\n\n- a function is odd if $f(-x)=-f(x)$ for all $x$ in the domain of $f$\n\nFor our function, we have\n\n$$\n\\begin{aligned}f(-6) & =85=-f(6), \\\\ f(-4) & =75=-f(4), \\\\ f(-2) & =30=-f(2).\\end{aligned}\n$$\n\nThis means that $f(-x)=-f(x)$ for all $x$ in the domain of the function. Therefore, $f(x)$ is an odd function.\n\n$$\n\\begin{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186563708 :knowledge-point/_questions [{:db/id #edb/ref 17592186083185 :knowledge-point/id #uuid "4fa847d9-f0bf-57fb-92b2-27c8a7cdb3b1" :knowledge-point/title "Classifying Even and Odd Functions Using the Algebraic Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17b5c879-2bfc-5ae7-aa01-8fe08c59be91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Even" :db/id #edb/ref 17592186562997} {:answer/id #uuid "284ae4e5-3a75-512a-96da-43be36b80b67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Both even and odd" :db/id #edb/ref 17592186563036} {:answer/id #uuid "54a22cd0-e927-5fcf-9c2a-bab375f9af7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Neither even nor odd" :db/id #edb/ref 17592186563137} {:answer/id #uuid "7dc2f9cc-543f-5ad1-a14a-7870a7b49c6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "It's not a function" :db/id #edb/ref 17592186563221} {:answer/id #uuid "f24d99a9-b905-5ab2-8163-7cffe9f00a38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Odd" :db/id #edb/ref 17592186563487}] :answer-field/correct {:answer/id #uuid "f24d99a9-b905-5ab2-8163-7cffe9f00a38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Odd" :db/id #edb/ref 17592186563487} :answer-field/id #uuid "94f1e14e-2d96-586a-93e5-1ee8371fd0d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563597}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "81602105-d969-550d-9191-b0d8d8e1aacf" :question/math-academy-id "q-72132" :question/problem "Is the function $f(x)={x}^{3}+8x$ even, odd, or neither?" :question/worked-solution "Recall that\n\n- a function is even if $f(-x)=f(x)$ for all $x$\n\n- a function is odd if $f(-x)=-f(x)$ for all $x$\n\nComputing $f(-x)$ for the given function and comparing it to $f(x),$ we have\n\n$$\n\\begin{aligned}f(-x) & =(-x)^{3}+8(-x) \\\\  & =-{x}^{3}-8x.\\end{aligned}\n$$\n\nSince $f(-x)\\ne f(x),$ the function is not even.\n\nLastly, we compute $-f(x)$ and get\n\n$$\n\\begin{aligned}-f(x) & =-({x}^{3}+8x) \\\\  & =-{x}^{3}-8x.\\end{aligned}\n$$\n\nSince $f(-x)=-f(x),$ the function is odd."}]}
