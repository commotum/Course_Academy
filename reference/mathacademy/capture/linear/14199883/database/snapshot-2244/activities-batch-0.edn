#{[{:activity/first-step {:db/id #edb/ref 17592186074923} :activity/id #uuid "a8efd125-dcb7-576a-aba7-d6a258e9a53d" :activity/scope {:db/id #edb/ref 17592186048583 :topic/id #uuid "ab9e96eb-9d23-50fe-8a94-f2eebf047bbc" :topic/math-academy-id 491} :activity/steps [{:db/id #edb/ref 17592186074720 :step/content {:db/id #edb/ref 17592186073784 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073656 :question/id #uuid "f89ebcc9-96b7-5d6b-b844-4a9328f2ab6b" :question/math-academy-id "e-7916"} :knowledge-point/id #uuid "87cdc7a8-9437-56cc-a523-6b869b013428" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049112} {:db/id #edb/ref 17592186050659}] :knowledge-point/questions [{:db/id #edb/ref 17592186074208} {:db/id #edb/ref 17592186074219}] :knowledge-point/title "Identifying True Statements Regarding Transformed Polygons"} :step/id #uuid "2480a381-e1e9-5ddf-97c9-5065c97a8cda" :step/math-academy-id 29494 :step/next {:db/id #edb/ref 17592186074924}} {:db/id #edb/ref 17592186074923 :step/content {:db/id #edb/ref 17592186074984 :tutorial/content "Any transformation that maps a polygon to a similar polygon is called a **similarity transformation**.\n\nAny combination of transformations made up of translation, rotation, reflection, and dilation will result in a similarity transformation.\n\nTo understand why this is true, remember:\n\n- Rigid motions (rotation, reflection, and translation) do not change the lengths or angles of the original figure. They map polygons to congruent polygons. If two polygons are congruent, then they are similar.\n- A dilation with scale factor $k$ multiplies all the lengths of the original shape by $k$ (leaving the angle measures unchanged), thereby producing a similar shape." :tutorial/id #uuid "622763c1-840b-5946-a1e7-feb59d8f0c89" :tutorial/math-academy-id 2315 :tutorial/title "Introduction"} :step/id #uuid "7ec1bc50-2134-5ed0-aa3d-e29348fd99e7" :step/math-academy-id 9647 :step/next {:db/id #edb/ref 17592186074720}} {:db/id #edb/ref 17592186074924 :step/content {:db/id #edb/ref 17592186073916 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073602 :question/id #uuid "54f05d2d-1137-5bc7-b56d-0215dc3895ad" :question/math-academy-id "e-2978"} :knowledge-point/id #uuid "d7545aba-d80b-58ab-9a56-25ad196da3ee" :knowledge-point/questions [{:db/id #edb/ref 17592186074183} {:db/id #edb/ref 17592186074184}] :knowledge-point/title "Finding a Similarity Transformation Given a Polygon and Its Image"} :step/id #uuid "b8d1a4d2-47c1-5676-a5b1-d16b02e3ee67" :step/math-academy-id 9655 :step/next {:db/id #edb/ref 17592186074925}} {:db/id #edb/ref 17592186074925 :step/content {:db/id #edb/ref 17592186073917 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073603 :question/id #uuid "a75b57a8-4819-594a-9aa2-e35b54a68f6a" :question/math-academy-id "e-2993"} :knowledge-point/id #uuid "a8b5ef8e-6f13-5496-ae7f-c9fbaf3e25c7" :knowledge-point/questions [{:db/id #edb/ref 17592186074207} {:db/id #edb/ref 17592186074209} {:db/id #edb/ref 17592186234140} {:db/id #edb/ref 17592186234141}] :knowledge-point/title "Identifying Similarity Transformations"} :step/id #uuid "3698100e-df7d-5666-8520-aa605b0f8eca" :step/math-academy-id 9670}] :activity/title "Similarity Transformations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073926}]}
