#{[{:db/id #edb/ref 17592186516855 :knowledge-point/_questions [{:db/id #edb/ref 17592186073917 :knowledge-point/id #uuid "a8b5ef8e-6f13-5496-ae7f-c9fbaf3e25c7" :knowledge-point/title "Identifying Similarity Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a4dea26-3eb3-5f68-9eb1-02c2680a892f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186516131} {:answer/id #uuid "6c7e6e72-0b09-5a44-9520-dfe8cf8a7a8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186516350} {:answer/id #uuid "eaba3792-c563-5079-bcd1-af361f15f0d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186516600} {:answer/id #uuid "fb5e5c56-e5ce-55fd-bc03-e48b07508467" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186516638} {:answer/id #uuid "fc9917d3-0d49-551d-bb4f-aa7e5e3ff567" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186516641}] :answer-field/correct {:answer/id #uuid "0a4dea26-3eb3-5f68-9eb1-02c2680a892f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186516131} :answer-field/id #uuid "eec1a239-a69c-51bb-a8aa-9e0e02460536" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516759}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cfe4ea96-fddc-550c-ac7a-6ec2d2c94652" :question/math-academy-id "q-53703" :question/problem "Which of the following transformations map any polygon to a similar polygon?\n\nI. $(x,y)↦(x-5,y)$\n\nII. $(x,y)↦(-y,x)$\n\nIII. $(x,y)↦(x,3y)$" :question/worked-solution "A similarity transformation is any transformation made up of rigid motions (rotations, reflections, and translations) and dilations. \n\nA similarity transformation will map any polygon to a similar polygon.\n\nWith that in mind, let's examine each of the transformations in turn.\n\n- Transformation I represents a translation by $5$ units to the left. Thus, it is a similarity transformation.\n\n- Transformation II represents a rotation by ${90}^{∘}$ counterclockwise around the origin. Thus, it is a similarity transformation.\n\n- Transformation III represents a stretch of factor $3$ in the $y$-direction. This is not a rigid motion.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186516783 :knowledge-point/_questions [{:db/id #edb/ref 17592186073917 :knowledge-point/id #uuid "a8b5ef8e-6f13-5496-ae7f-c9fbaf3e25c7" :knowledge-point/title "Identifying Similarity Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41f1557f-aa1b-5c6b-97f9-3183a0fdae13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186516243} {:answer/id #uuid "5eeba46f-9dda-59a4-86da-d1ee0173c9ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186516317} {:answer/id #uuid "8861175f-b2e1-5165-afbc-bffd586e1f4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186516397} {:answer/id #uuid "be0af016-3822-5b80-b2b9-b035f07b9902" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186516511} {:answer/id #uuid "c746c42b-4136-5b7a-8e70-85095e0c0424" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186516533}] :answer-field/correct {:answer/id #uuid "be0af016-3822-5b80-b2b9-b035f07b9902" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186516511} :answer-field/id #uuid "f4eeffe0-d387-54ea-99bf-7c07fda39ad8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516762}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1ea750dd-05b5-599b-a75b-1d40366d85dc" :question/math-academy-id "q-89161" :question/problem "Which of the following transformations map any polygon to a similar polygon?\n\nI. Stretching with stretch factor $6$ in the $x$-direction, then a translation by $2$ units downward\n\nII. Rotation by ${45}^{∘}$ clockwise around a point $O$ followed by reflection over a line $l$\n\nIII. Dilation of scale factor $4$ with center at $A,$ then translation by $6$ units to the right" :question/worked-solution "A similarity transformation is any transformation made up of rigid motions (rotations, reflections, and translations) and dilations.\n\nA similarity transformation will map any polygon to a similar polygon.\n\nWith that in mind, let's examine each of the transformations in turn.\n\n- Transformation I includes stretching in only one direction. Thus, it is not a similarity transformation.\n\n- Transformation II is a combination of rotation and a reflection, which are rigid motions. Thus, it is a similarity transformation.\n\n- Transformation III is a combination of dilation of scale factor $4$ and a translation. Thus, it is a similarity transformation.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186516862 :knowledge-point/_questions [{:db/id #edb/ref 17592186073784 :knowledge-point/id #uuid "87cdc7a8-9437-56cc-a523-6b869b013428" :knowledge-point/title "Identifying True Statements Regarding Transformed Polygons"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ed52675-1674-5013-b977-2c1156e5c97e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186516169} {:answer/id #uuid "dc6eb254-4764-5546-881b-d06219358af3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186516576} {:answer/id #uuid "de8ea9cd-d289-5e31-b480-860682054345" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186516581} {:answer/id #uuid "def95e8e-df89-5823-b269-5d8d58bb3e5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186516584} {:answer/id #uuid "eb50b3d4-f784-52f7-8f87-e4315c20fe44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186516601}] :answer-field/correct {:answer/id #uuid "dc6eb254-4764-5546-881b-d06219358af3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186516576} :answer-field/id #uuid "6f5beb74-044c-5e40-8586-8ba7b7f03022" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516701}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e8890925-6102-5a39-922f-cbb90bd120c9" :question/math-academy-id "q-89714" :question/problem "A square $ABCD$ is translated by $3$ units to the left and $3$ units upward. If the resulting quadrilateral is $PQRS,$ which of the following statements must be true?\n\nI. $ABCD∼PQRS$\n\nII. $ABCD≅PQRS$\n\nIII. $\\overset{―}{BC}≅\\overset{―}{QR}$" :question/worked-solution "A similarity transformation is any transformation made up of rigid motions (rotations, reflections, and translations) and dilations. \n\nA similarity transformation will map any polygon to a similar polygon.\n\nWith that in mind, let's examine each of the statements in turn.\n\n- Statement I is true. We are given a combination of translations. As a result, we obtain that \n\n$$\nABCD∼PQRS.\n$$\n\n- Statement II is true. Since our combined transformation consists of rigid motions only (namely, translations), the distance between all points is preserved under the transformation. Therefore,  we obtain that \n\n$$\nABCD≅PQRS.\n$$\n\n- Statement III is true. Since $ABCD≅PQRS,$ all corresponding sides must be congruent. Therefore, \n\n$$\n\\overset{―}{BC}≅\\overset{―}{QR}.\n$$\n\nTherefore, the correct answer is \"I, II, and III.\""}]}
