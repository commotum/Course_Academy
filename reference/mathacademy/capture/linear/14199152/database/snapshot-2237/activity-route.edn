#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186515648} :activity/id #uuid "171482d0-9733-5990-af68-52e897a70b2e" :activity/scope {:db/id #edb/ref 17592186048846 :topic/id #uuid "c59fe2ed-0027-529f-b6e0-3d5e566657df" :topic/math-academy-id 6769} :activity/steps [{:db/id #edb/ref 17592186515648 :step/content {:db/id #edb/ref 17592186515614 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fa01b50-fa86-5d42-9d9e-f20c208a1076" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "72\\,{\\text{in}}^{2}" :db/id #edb/ref 17592186515079} {:answer/id #uuid "8ec4b3e2-e623-5ec4-96cf-21891cfd3080" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "126\\,{\\text{in}}^{2}" :db/id #edb/ref 17592186515173} {:answer/id #uuid "99fdabb5-1a73-59b9-810d-855b3e1bb6d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "63\\,{\\text{in}}^{2}" :db/id #edb/ref 17592186515198} {:answer/id #uuid "c88701b7-a7fa-56ab-8c32-e6f1ba45d2a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "144\\,{\\text{in}}^{2}" :db/id #edb/ref 17592186515298} {:answer/id #uuid "f083bac5-dd38-5485-a153-68c65a64f5f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "98\\,{\\text{in}}^{2}" :db/id #edb/ref 17592186515377}] :answer-field/correct {:db/id #edb/ref 17592186515079} :answer-field/id #uuid "765d86ee-70ad-5e5c-a6c0-9172acef54c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186515452}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e9fe6faf-8364-54c6-b5c6-ec03e2fb9a2a" :question/math-academy-id "q-60624" :question/problem "![](images/43/435f50f68f1d5d206a935ec9b00dcd53e7a68647875e21f36d70379e3915a4c5.png)\n\nFind the area of the triangle." :question/worked-solution "First, we find the height and base of the triangle:\n\n$$\n\\begin{aligned}\\text{base} & =12 \\\\ \\text{height} & =12\\end{aligned}\n$$\n\nThe area of the triangle can be found by the following formula:\n\n$$\n\\text{Area}=\\frac{1}{2}\\times \\text{base}\\times \\text{height}\n$$\n\nSubstituting the values of the base and height, we get\n\n$$\n\\begin{aligned}\\text{Area} & =\\frac{1}{2}\\times 12\\times 12 \\\\  & =6\\times 12 \\\\  & =72.\\end{aligned}\n$$\n\nNow, let's find the units. Since base and height are measured in inches, the area is measured in square inches. Hence,\n\n$$\n\\text{Area}=72\\,{\\text{in}}^{2}.\n$$"} :step/id #uuid "417d8d63-6e21-5e67-9747-6630e9445dd3" :step/next {:db/id #edb/ref 17592186515686}} {:db/id #edb/ref 17592186515667 :step/content {:db/id #edb/ref 17592186515615 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04136959-5e41-5216-9279-1057512c0bff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\,{\\text{ft}}^{2}" :db/id #edb/ref 17592186514880} {:answer/id #uuid "43cbd2ae-0ecf-5595-a730-c4685cb767c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "22.5\\,{\\text{ft}}^{2}" :db/id #edb/ref 17592186515017} {:answer/id #uuid "5034e216-50cc-5f90-9470-0f87b0b6f66d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "35\\,{\\text{ft}}^{2}" :db/id #edb/ref 17592186515049} {:answer/id #uuid "68c29f71-725a-5607-b616-c53b49800b36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24\\,{\\text{ft}}^{2}" :db/id #edb/ref 17592186515091} {:answer/id #uuid "c16fb5a3-adb1-598c-a1b6-a5eb383b33bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "17.5\\,{\\text{ft}}^{2}" :db/id #edb/ref 17592186515282}] :answer-field/correct {:db/id #edb/ref 17592186515282} :answer-field/id #uuid "5a740dc6-0953-53ea-b78c-39bc996dc617" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186515440}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ecf8daef-9b17-549e-9c51-518ec81d55ec" :question/math-academy-id "q-93149" :question/problem "Claire has sectioned off a triangular area of her garden whose base is $7$ feet and height is $5$ feet to plant some flowers. What is the area of the flowerbed?" :question/worked-solution "Let's sketch the flowerbed based on the description.\n\n![](images/b4/b409d299208280d3be7e33be8e74c3d894fa9f3ad7e5605e4b551b6b0434302a.png)\n\nThe height and base of the triangle are\n\n$$\n\\begin{aligned}\\text{base} & =7, \\\\ \\text{height} & =5.\\end{aligned}\n$$\n\nThe area of the triangle can be found by the following formula:\n\n$$\n\\text{Area}=\\frac{1}{2}\\times \\text{base}\\times \\text{height}\n$$\n\nSubstituting the values of the base and height, we get\n\n$$\n\\begin{aligned}\\text{Area} & =\\frac{1}{2}\\times 7\\times 5 \\\\  & =\\frac{1}{2}\\times 35 \\\\  & =17.5.\\end{aligned}\n$$\n\nNow, let's find the units. Since base and height are measured in feet, the area is measured in square feet. Hence,\n\n$$\n\\text{Area}=17.5\\,{\\text{ft}}^{2}.\n$$"} :step/id #uuid "8acdd2d7-5504-5f14-bf0e-df9ca76ee416"} {:db/id #edb/ref 17592186515686 :step/content {:db/id #edb/ref 17592186231768 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e40f59c-5c43-5ce3-9fec-419a42be11b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7.5\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186514975} {:answer/id #uuid "6ad3516e-b294-5e7c-a474-d9e0c1c6b4cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12.5\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186515093} {:answer/id #uuid "a371e2e3-b68a-5d88-b845-9048a4af13b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186515220} {:answer/id #uuid "f399ef28-c29c-5938-afa7-1520d202501d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9.5\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186515384} {:answer/id #uuid "f445b4ca-4a23-598d-8e00-2f709f5f07d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186515385}] :answer-field/correct {:db/id #edb/ref 17592186514975} :answer-field/id #uuid "4dd91ab1-bff9-5024-b786-11dfd18c92a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186231170}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ab0bd4df-9796-5f7d-9c14-c1ed510ea0c1" :question/math-academy-id "q-60640" :question/problem "Nicole bakes triangular cakes with a base of $5$ cm and a height of $3$ cm. What is the area of one cake?" :question/worked-solution "Let's sketch our cake based on the description.\n\n![](images/20/205df21c66b54b84f9b0608baebf49277720738e1fac14219a7631848ea5c19a.png)\n\nThe height and base of the triangle are\n\n$$\n\\begin{aligned}\\text{base} & =5, \\\\ \\text{height} & =3.\\end{aligned}\n$$\n\nThe area of the triangle can be found by the following formula:\n\n$$\n\\text{Area}=\\frac{1}{2}\\times \\text{base}\\times \\text{height}\n$$\n\nSubstituting the values of the base and height, we get\n\n$$\n\\begin{aligned}\\text{Area} & =\\frac{1}{2}\\times 5\\times 3 \\\\  & =\\frac{1}{2}\\times 15 \\\\  & =7.5.\\end{aligned}\n$$\n\nNow, let's find the units. Since base and height are measured in centimeters, the area is measured in square centimeters. Hence,\n\n$$\n\\text{Area}=7.5\\,{\\text{cm}}^{2}.\n$$"} :step/id #uuid "b8dfeb6a-a542-5081-9a28-e226e6553d95" :step/next {:db/id #edb/ref 17592186515667}}] :activity/title "Areas of Triangles" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186514853}]}
