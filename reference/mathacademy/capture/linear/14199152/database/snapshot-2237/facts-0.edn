86515377 #edb/ref 1083 #uuid "f083bac5-dd38-5485-a153-68c65a64f5f0" #edb/ref 17592186045417] [17592186515384 #edb/ref 1080 "9.5\\,{\\text{cm}}^{2}" #edb/ref 17592186045417] [17592186515384 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186515384 #edb/ref 1083 #uuid "f399ef28-c29c-5938-afa7-1520d202501d" #edb/ref 17592186045417] [17592186515385 #edb/ref 1080 "25\\,{\\text{cm}}^{2}" #edb/ref 17592186045417] [17592186515385 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186515385 #edb/ref 1083 #uuid "f445b4ca-4a23-598d-8e00-2f709f5f07d9" #edb/ref 17592186045417] [17592186515440 #edb/ref 1075 #edb/ref 17592186514880 #edb/ref 17592186045417] [17592186515440 #edb/ref 1075 #edb/ref 17592186515017 #edb/ref 17592186045417] [17592186515440 #edb/ref 1075 #edb/ref 17592186515049 #edb/ref 17592186045417] [17592186515440 #edb/ref 1075 #edb/ref 17592186515091 #edb/ref 17592186045417] [17592186515440 #edb/ref 1075 #edb/ref 17592186515282 #edb/ref 17592186045417] [17592186515440 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186515440 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186515440 #edb/ref 1078 #edb/ref 17592186515282 #edb/ref 17592186045417] [17592186515440 #edb/ref 1079 #uuid "5a740dc6-0953-53ea-b78c-39bc996dc617" #edb/ref 17592186045417] [17592186515452 #edb/ref 1075 #edb/ref 17592186515079 #edb/ref 17592186045417] [17592186515452 #edb/ref 1075 #edb/ref 17592186515173 #edb/ref 17592186045417] [17592186515452 #edb/ref 1075 #edb/ref 17592186515198 #edb/ref 17592186045417] [17592186515452 #edb/ref 1075 #edb/ref 17592186515298 #edb/ref 17592186045417] [17592186515452 #edb/ref 1075 #edb/ref 17592186515377 #edb/ref 17592186045417] [17592186515452 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186515452 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186515452 #edb/ref 1078 #edb/ref 17592186515079 #edb/ref 17592186045417] [17592186515452 #edb/ref 1079 #uuid "765d86ee-70ad-5e5c-a6c0-9172acef54c7" #edb/ref 17592186045417] [17592186515614 #edb/ref 1068 #edb/ref 17592186515452 #edb/ref 17592186045417] [17592186515614 #edb/ref 1069 "q-60624" #edb/ref 17592186045417] [17592186515614 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186515614 #edb/ref 1071 "![](images/43/435f50f68f1d5d206a935ec9b00dcd53e7a68647875e21f36d70379e3915a4c5.png)\n\nFind the area of the triangle." #edb/ref 17592186045417] [17592186515614 #edb/ref 1072 #uuid "e9fe6faf-8364-54c6-b5c6-ec03e2fb9a2a" #edb/ref 17592186045417] [17592186515614 #edb/ref 1074 "First, we find the height and base of the triangle:\n\n$$\n\\begin{aligned}\\text{base} & =12 \\\\ \\text{height} & =12\\end{aligned}\n$$\n\nThe area of the triangle can be found by the following formula:\n\n$$\n\\text{Area}=\\frac{1}{2}\\times \\text{base}\\times \\text{height}\n$$\n\nSubstituting the values of the base and height, we get\n\n$$\n\\begin{aligned}\\text{Area} & =\\frac{1}{2}\\times 12\\times 12 \\\\  & =6\\times 12 \\\\  & =72.\\end{aligned}\n$$\n\nNow, let's find the units. Since base and height are measured in inches, the area is measured in square inches. Hence,\n\n$$\n\\text{Area}=72\\,{\\text{in}}^{2}.\n$$" #edb/ref 17592186045417] [17592186515615 #edb/ref 1068 #edb/ref 17592186515440 #edb/ref 17592186045417] [17592186515615 #edb/ref 1069 "q-93149" #edb/ref 17592186045417] [17592186515615 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186515615 #edb/ref 1071 "Claire has sectioned off a triangular area of her garden whose base is $7$ feet and height is $5$ feet to plant some flowers. What is the area of the flowerbed?" #edb/ref 17592186045417] [17592186515615 #edb/ref 1072 #uuid "ecf8daef-9b17-549e-9c51-518ec81d55ec" #edb/ref 17592186045417] [17592186515615 #edb/ref 1074 "Let's sketch the flowerbed based on the description.\n\n![](images/b4/b409d299208280d3be7e33be8e74c3d894fa9f3ad7e5605e4b551b6b0434302a.png)\n\nThe height and base of the triangle are\n\n$$\n\\begin{aligned}\\text{base} & =7, \\\\ \\text{height} & =5.\\end{aligned}\n$$\n\nThe area of the triangle can be found by the following formula:\n\n$$\n\\text{Area}=\\frac{1}{2}\\times \\text{base}\\times \\text{height}\n$$\n\nSubstituting the values of the base and height, we get\n\n$$\n\\begin{aligned}\\text{Area} & =\\frac{1}{2}\\times 7\\times 5 \\\\  & =\\frac{1}{2}\\times 35 \\\\  & =17.5.\\end{aligned}\n$$\n\nNow, let's find the units. Since base and height are measured in feet, the area is measured in square feet. Hence,\n\n$$\n\\text{Area}=17.5\\,{\\text{ft}}^{2}.\n$$" #edb/ref 17592186045417] [17592186515648 #edb/ref 1058 #edb/ref 17592186515686 #edb/ref 17592186045417] [17592186515648 #edb/ref 1062 #uuid "417d8d63-6e21-5e67-9747-6630e9445dd3" #edb/ref 17592186045417] [17592186515648 #edb/ref 1063 #edb/ref 17592186515614 #edb/ref 17592186045417] [17592186515667 #edb/ref 1062 #uuid "8acdd2d7-5504-5f14-bf0e-df9ca76ee416" #edb/ref 17592186045417] [17592186515667 #edb/ref 1063 #edb/ref 17592186515615 #edb/ref 17592186045417] [17592186515686 #edb/ref 1058 #edb/ref 17592186515667 #edb/ref 17592186045417] [17592186515686 #edb/ref 1062 #uuid "b8dfeb6a-a542-5081-9a28-e226e6553d95" #edb/ref 17592186045417] [17592186515686 #edb/ref 1063 #edb/ref 17592186231768 #edb/ref 17592186045417]}
