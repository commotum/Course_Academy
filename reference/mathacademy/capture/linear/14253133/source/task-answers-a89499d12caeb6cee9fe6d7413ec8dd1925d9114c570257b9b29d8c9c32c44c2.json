 + \\sec^2x)  \\, \\textrm{d}x = $</p>\n","choice1":"$-4\\csc x + \\tan x + C$","choice2":"$4\\csc x + \\tan x + C$","choice3":"$-4\\cot x + \\tan x + C$","choice4":"$4\\csc x + \\sec x + C$","choice5":"$-4\\csc x - \\tan x + C$","freeAnswerChoice":"","explanation":"<p>Recall that</p>\n<p>\\begin{align}\n\t\\int \\csc x \\cot x \\, \\textrm dx &= -\\csc x + C\\\\\n\t\\int \\sec^2 x  \\, \\textrm d x &= \\tan x  + C.\n\\end{align}</p>\n<p>Therefore, we have</p>\n<p>\\begin{eqnarray}\n    \\eqalign{\n       \t\\int (4\\csc x \\cot x + \\sec^2x)  \\, \\textrm{d}x&=\\int 4\\csc x \\cot x \\, \\textrm{d}x + \\int \\sec^2 x \\, \\textrm{d}x\\\\[3pt]\n\t\t&=4(-\\csc x) + \\tan x + C\\\\[3pt]\n\t\t&=-4\\csc x + \\tan x + C.\n\n\n    }\n\\end{eqnarray}</p>\n","topic":{"id":285,"name":"Integrating Trigonometric Functions"},"example":{"id":384,"title":"Integrating Secant Squared"},"group":{"id":97486,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14253133,"answer":{"id":62316400,"cread":"2026-10-16T02:56:35.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":12863},"graphic":false,"difficultyClass":"difficultyModerate","difficultySymbol":"M","rendered":true,"testMode":false}}]},{"id":385,"number":4,"title":"Integrating Cosecant Squared","answers":[{"id":62316413,"created":"2026-10-16T02:56:56.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":12880,"number":8,"createdStr":"Fri, Oct 16th @ 2:56 AM","timeElapsedFormatted":"0:13","question":{"id":49123,"format":"MC","difficulty":2,"exampleId":385,"text":"<p>$\\displaystyle \\int \\csc{x}\\left(6\\csc{x} - 5\\cot{x}\\right)   \\textrm{d}x = $</p>\n","choice1":"$-6\\cot{x} + 5\\csc{x} + C$","choice2":"$6\\tan{x} - 5\\csc{x} + C$","choice3":"$-6\\cot{x} - 5\\sec{x} + C$","choice4":"$6\\tan{x} + 5\\csc{x} + C$","choice5":"$6\\cot{x} - 5\\sec{x} + C$","freeAnswerChoice":"","explanation":"<p>Recall that </p>\n<p>\\begin{align}\n\t\\int \\csc^2 x \\, \\textrm d x&= -\\cot x + C,\\\\\n\t\\int \\csc x \\cot x \\, \\textrm dx &= -\\csc x + C.\n\\end{align}</p>\n<p>Therefore, we get</p>\n<p>\\begin{eqnarray}\n\\require{cancel}\n    \\eqalign{\n\\int \\csc{x}\\left(6\\csc{x} - 5\\cot{x}\\right) \\textrm{d}x & = \\int \\left(6\\csc^2{x} - 5\\csc{x}\\cot{x}\\right) \\textrm{d}x \\\\[3pt]\n\n& = \\int 6\\csc^2{x} \\, \\textrm{d}x - \\int 5\\csc{x}\\cot{x}\\, \\textrm{d}x \\\\[3pt]\n\n& =  6\\int \\csc^2{x} \\, \\textrm{d}x - 5\\int \\csc{x}\\cot{x} \\, \\textrm{d}x \\\\[3pt]\n\n&= 6(-\\cot{x}) -5(-\\csc{x}) + C \\\\[3pt]\n\n& = -6\\cot{x} + 5\\csc{x} + C.\n    }\n\\end{eqnarray}</p>\n","topic":{"id":285,"name":"Integrating Trigonometric Functions"},"example":{"id":385,"title":"Integrating Cosecant Squared"},"group":{"id":55609,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14253133,"answer":{"id":62316413,"cread":"2026-10-16T02:56:56.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":12880},"graphic":false,"difficultyClass":"difficultyModerate","difficultySymbol":"M","rendered":true,"testMode":false}},{"id":62316420,"created":"2026-10-16T02:57:12.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":11232,"number":9,"createdStr":"Fri, Oct 16th @ 2:57 AM","timeElapsedFormatted":"0:11","question":{"id":113948,"format":"MC","difficulty":1,"exampleId":385,"text":"<p>$\\displaystyle \\int -\\dfrac{5}{2}\\csc^2 x \\,\\textrm{d}x = $</p>\n","choice1":"$ \\dfrac{5}{2}\\cot x + C$","choice2":"$ -\\dfrac{5}{2}\\tan x + C$","choice3":"$ -\\dfrac{5}{2}\\sec x + C$","choice4":"$ -\\dfrac{5}{2}\\csc{x} \\cot x + C$","choice5":"$ \\dfrac{5}{2}\\cot^2 x + C$","freeAnswerChoice":" ","explanation":"<p>Recall that </p>\n<p>\\[\n\\int \\csc^2 x \\, \\textrm dx = -\\cot x + C\n\\]</p>\n<p>Therefore, we get</p>\n<p>\\begin{eqnarray}\n    \\eqalign{\n      \\int -\\dfrac{5}{2}\\csc ^ 2 x \\, \\textrm{d}x&=  -\\dfrac