"1em 0.5em\" columnspacing=\"0.278em\" displaystyle=\"true\" columnalign=\"right left\"><mtr><mtd><mo data-mjx-texclass=\"OP\">∫</mo><mn>4</mn><mi>sec</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mi>tan</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>x</mi></mtd><mtd><mo>=</mo><mn>4</mn><mo data-mjx-texclass=\"OP\">∫</mo><mi>sec</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mi>tan</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>x</mi></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mn>4</mn><mi>sec</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo>+</mo><mi>C</mi><mo>.</mo></mtd></mtr></mtable></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
