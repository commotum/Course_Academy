d795fb8" :question/math-academy-id "q-49123"] ["question-aefe8a56-b826-5c47-afc1-22f96d795fb8" :question/problem "$\\int \\operatorname{csc}⁡x(6\\operatorname{csc}⁡x-5\\operatorname{cot}⁡x)\\text{d}x=$"] ["question-aefe8a56-b826-5c47-afc1-22f96d795fb8" :question/worked-solution "Recall that \n\n$$\n\\begin{aligned}\\int {csc}^{2}⁡x\\,\\text{d}x & =-\\operatorname{cot}⁡x+C, \\\\ \\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x & =-\\operatorname{csc}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\operatorname{csc}⁡x(6\\operatorname{csc}⁡x-5\\operatorname{cot}⁡x)\\text{d}x & =\\int (6{csc}^{2}⁡x-5\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\text{d}x \\\\  & =\\int 6{csc}^{2}⁡x\\,\\text{d}x-\\int 5\\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x \\\\  & =6\\int {csc}^{2}⁡x\\,\\text{d}x-5\\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x \\\\  & =6(-\\operatorname{cot}⁡x)-5(-\\operatorname{csc}⁡x)+C \\\\  & =-6\\operatorname{cot}⁡x+5\\operatorname{csc}⁡x+C.\\end{aligned}\\end{aligned}\n$$"] ["question-aefe8a56-b826-5c47-afc1-22f96d795fb8" :question/difficulty :question.difficulty/moderate] ["answer-field-6d0a6d73-32b4-5324-aae6-b3e318afe759" :answer-field/id #uuid "6d0a6d73-32b4-5324-aae6-b3e318afe759"] ["answer-18bcbe64-bb6f-55cf-a9d1-22e95a1231bd" :answer/id #uuid "18bcbe64-bb6f-55cf-a9d1-22e95a1231bd"] ["answer-18bcbe64-bb6f-55cf-a9d1-22e95a1231bd" :answer/type :answer.type/math] ["answer-18bcbe64-bb6f-55cf-a9d1-22e95a1231bd" :answer/value "-6\\operatorname{cot}⁡x+5\\operatorname{csc}⁡x+C"] ["answer-f8c18cbb-8412-58a3-a55e-23de81200289" :answer/id #uuid "f8c18cbb-8412-58a3-a55e-23de81200289"] ["answer-f8c18cbb-8412-58a3-a55e-23de81200289" :answer/type :answer.type/math] ["answer-f8c18cbb-8412-58a3-a55e-23de81200289" :answer/value "-6\\operatorname{cot}⁡x-5\\operatorname{sec}⁡x+C"] ["answer-9b5373b4-ce2d-560c-85b8-db62e75a98a9" :answer/id #uuid "9b5373b4-ce2d-560c-85b8-db62e75a98a9"] ["answer-9