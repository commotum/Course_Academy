e-point/questions "question-f7057d32-2563-5caa-9eb0-bb4367d4b45b"] ["question-59e71a7a-5ae7-5b4a-bdd0-a27062dbab09" :question/id #uuid "59e71a7a-5ae7-5b4a-bdd0-a27062dbab09"] ["question-59e71a7a-5ae7-5b4a-bdd0-a27062dbab09" :question/math-academy-id "q-71661"] ["question-59e71a7a-5ae7-5b4a-bdd0-a27062dbab09" :question/problem "$\\int (\\operatorname{cos}⁡x-5{sec}^{2}⁡x)\\,\\text{d}x=$"] ["question-59e71a7a-5ae7-5b4a-bdd0-a27062dbab09" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{cos}⁡x\\,\\text{d}x & =\\operatorname{sin}⁡x+C, \\\\ \\int {sec}^{2}⁡x\\,\\text{d}x & =\\operatorname{tan}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (\\operatorname{cos}⁡x-5{sec}^{2}⁡x)\\,\\text{d}x & =\\int \\operatorname{cos}⁡x\\,\\text{d}x-\\int 5{sec}^{2}⁡x\\,\\text{d}x \\\\  & =\\int \\operatorname{cos}⁡x\\,\\text{d}x-5\\int {sec}^{2}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x-5\\operatorname{tan}⁡x+C.\\end{aligned}\\end{aligned}\n$$"] ["question-59e71a7a-5ae7-5b4a-bdd0-a27062dbab09" :question/difficulty :question.difficulty/moderate] ["answer-field-08e04e2e-7eca-562c-852b-2c70ebf8ebaf" :answer-field/id #uuid "08e04e2e-7eca-562c-852b-2c70ebf8ebaf"] ["answer-9dd5d538-c487-511e-8d7f-5e1b4ffcc218" :answer/id #uuid "9dd5d538-c487-511e-8d7f-5e1b4ffcc218"] ["answer-9dd5d538-c487-511e-8d7f-5e1b4ffcc218" :answer/type :answer.type/math] ["answer-9dd5d538-c487-511e-8d7f-5e1b4ffcc218" :answer/value "-\\operatorname{sin}⁡x+5\\operatorname{tan}⁡x+C."] ["answer-00c21b53-f065-504c-a5e3-aa2005a3edca" :answer/id #uuid "00c21b53-f065-504c-a5e3-aa2005a3edca"] ["answer-00c21b53-f065-504c-a5e3-aa2005a3edca" :answer/type :answer.type/math] ["answer-00c21b53-f065-504c-a5e3-aa2005a3edca" :answer/value "\\operatorname{sin}⁡x+5\\operatorname{csc}⁡\\operatorname{tan}⁡x+C."] ["answer-ad986292-1692-5d51-b82b-3cd472c78eb1" :answer/id #uuid "ad986292-1692-5d51-b82b-3cd472c78eb1"] ["answer-ad986292-1692-5d51-b82b-3cd472c78eb1" :an