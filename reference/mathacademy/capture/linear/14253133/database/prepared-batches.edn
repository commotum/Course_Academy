os}⁡x\\,\\text{d}x & =\\operatorname{sin}⁡x+C, \\\\ \\int {sec}^{2}⁡x\\,\\text{d}x & =\\operatorname{tan}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (\\operatorname{cos}⁡x-5{sec}^{2}⁡x)\\,\\text{d}x & =\\int \\operatorname{cos}⁡x\\,\\text{d}x-\\int 5{sec}^{2}⁡x\\,\\text{d}x \\\\  & =\\int \\operatorname{cos}⁡x\\,\\text{d}x-5\\int {sec}^{2}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x-5\\operatorname{tan}⁡x+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-08e04e2e-7eca-562c-852b-2c70ebf8ebaf"] :db/ensure [:question/validate]} {:db/id "answer-field-08e04e2e-7eca-562c-852b-2c70ebf8ebaf" :answer-field/id #uuid "08e04e2e-7eca-562c-852b-2c70ebf8ebaf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1f40bf7b-d980-5c37-9185-3b085c9c5c53" :answer-field/choices ["answer-9dd5d538-c487-511e-8d7f-5e1b4ffcc218" "answer-00c21b53-f065-504c-a5e3-aa2005a3edca" "answer-ad986292-1692-5d51-b82b-3cd472c78eb1" "answer-1f40bf7b-d980-5c37-9185-3b085c9c5c53" "answer-3a387fb4-5f8e-534c-9e75-92e6cdf63fa6"] :db/ensure [:answer-field/validate]} {:db/id "answer-9dd5d538-c487-511e-8d7f-5e1b4ffcc218" :answer/id #uuid "9dd5d538-c487-511e-8d7f-5e1b4ffcc218" :answer/type :answer.type/math :answer/value "-\\operatorname{sin}⁡x+5\\operatorname{tan}⁡x+C." :db/ensure [:answer/validate]} {:db/id "answer-00c21b53-f065-504c-a5e3-aa2005a3edca" :answer/id #uuid "00c21b53-f065-504c-a5e3-aa2005a3edca" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡x+5\\operatorname{csc}⁡\\operatorname{tan}⁡x+C." :db/ensure [:answer/validate]} {:db/id "answer-ad986292-1692-5d51-b82b-3cd472c78eb1" :answer/id #uuid "ad986292-1692-5d51-b82b-3cd472c78eb1" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡x+5\\operatorname{tan}⁡x+C." :db/ensure [:answer/validate]} {:db/id "answer-1f40bf7b-d980-5c37-9185-3b085c9c5c53" :answer/id #uuid "1f40bf7b-d980-5c37-9185-3b085c9c5c53" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡x-5\\operatorname{tan}⁡x+C." :db/ensure [:answer/validate]} {:db/id "answer-3a387fb4-5f8e-534c-9e75-92e6cdf63fa6" :answer/id #uuid "3a387fb4-5f8e-534c-9e75-92e6cdf63fa6" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡x-{tan}^{2}⁡x+C." :db/ensure [:answer/validate]} {:db/id 17592186064181 :knowledge-point/questions ["question-aefe8a56-b826-5c47-afc1-22f96d795fb8"] :db/ensure [:knowledge-point/validate]} {:db/id "question-aefe8a56-b826-5c47-afc1-22f96d795fb8" :question/id #uuid "aefe8a56-b826-5c47-afc1-22f96d795fb8" :question/math-academy-id "q-49123" :question/problem "$\\int \\operatorname{csc}⁡x(6\\operatorname{csc}⁡x-5\\operatorname{cot}⁡x)\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\begin{aligned}\\int {csc}^{2}⁡x\\,\\text{d}x & =-\\operatorname{cot}⁡x+C, \\\\ \\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x & =-\\operatorname{csc}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\operatorname{csc}⁡x(6\\operatorname{csc}⁡x-5\\operatorname{cot}⁡x)\\text{d}x & =\\int (6{csc}^{2}⁡x-5\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\text{d}x \\\\  & =\\int 6{csc}^{2}⁡x\\,\\text{d}x-\\int 5\\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x \\\\  & =6\\int {csc}^{2}⁡x\\,\\text{d}x-5\\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x \\\\  & =6(-\\operatorname{cot}⁡x)-5(-\\operatorname{csc}⁡x)+C \\\\  & =-6\\operatorname{cot}⁡x+5\\operatorname{csc}⁡x+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6d0a6d73-32b4-5324-aae6-b3e318afe759"] :db/ensure [:question/validate]} {:db/id "answer-field-6d0a6d73-32b4-5324-aae6-b3e318afe759" :answer-field/id #uuid "6d0a6d73-32b4-5324-aae6-b3e318afe759" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-18bcbe64-bb6f-55cf-a9d1-22e95a1231bd" :answer-field/choices ["answer-18bcbe64-bb6f-55cf-a9d1-22e95a1231bd" "answer-f8c18cbb-8412-58a3-a55e-23de81200289" "answer-9b5373b4-ce2d-560c-85b8-db62e75a98a9" "answer-2fc267db-4bcb-55dc-bdea-9ddc9b01a7b7" "answer-c9e90b57-bb92-5b49-98e6-3e0a2d915c73"] :db/ensure [:answer-field/validate]} {:db/id "answer-18bcbe64-bb6f-55cf-a9d1-22e95a1231bd" :answer/id #uuid "18bcbe64-bb6f-55cf-a9d1-22e95a1231bd" :answer/type :answer.type/math :answer/value "-6\\operatorname{cot}⁡x+5\\operatorname{csc}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-f8c18cbb-8412-58a3-a55e-23de81200289" :answer/id #uuid "f8c18cbb-8412-58a3-a55e-23de81200289" :answer/type :answer.type/math :answer/value "-6\\operatorname{cot}⁡x-5\\operatorname{sec}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-9b5373b4-ce2d-560c-85b8-db62e75a98a9" :answer/id #uuid "9b5373b4-ce2d-560c-85b8-db62e75a98a9" :answer/type :answer.type/math :answer/value "6\\operatorname{cot}⁡x-5\\operatorname{sec}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-2fc267db-4bcb-55dc-bdea-9ddc9b01a7b7" :answer/id #uuid "2fc267db-4bcb-55dc-bdea-9ddc9b01a7b7" :answer/type :answer.type/math :answer/value "6\\operatorname{tan}⁡x+5\\operatorname{csc}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-c9e90b57-bb92-5b49-98e6-3e0a2d915c73" :answer/id #uuid "c9e90b57-bb92-5b49-98e6-3e0a2d915c73" :answer/type :answer.type/math :answer/value "6\\operatorname{tan}⁡x-5\\operatorname{csc}⁡x+C" :db/ensure [:answer/validate]} {:db/id 17592186065409 :tutorial/content "We know that the derivative of sine is cosine:\n\n$$\n\\dfrac{\\textrm d }{\\textrm d x}(\\sin{x}) = \\cos{x}\n$$\n\nSince integration is the reverse of differentiation, we see that the integral of cosine is sine:\n\n$$\n\\int \\cos{x}\\,\\textrm d x = \\sin{x} + C\n$$\n\nWe can discover two other integrals by considering the derivatives of cosine and tangent:\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}⁡x\\text{ }\\text{d}x & =-\\operatorname{cos}⁡x+C \\\\ \\int {sec}^{2}⁡x\\text{ }\\text{d}x & =\\operatorname{tan}⁡x+C.\\end{aligned}\n$$\n\nSimilarly, by considering the derivatives of secant, cosecant, and cotangent, we arrive at\n\n$$\n\\begin{aligned}\\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\text{ }\\text{d}x & =\\operatorname{sec}⁡x+C \\\\ \\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\text{ }\\text{d}x & =-\\operatorname{csc}⁡x+C \\\\ \\int {csc}^{2}⁡x\\text{ }\\text{d}x & =-\\operatorname{cot}⁡x+C.\\end{aligned}\n$$\n\nWith these six formulas, we can integrate many different trigonometric functions." :db/ensure [:tutorial/validate]} {:db/id 17592186064392 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}] "assertions" [[17592186064558 :question/difficulty :question.difficulty/easy] ["question-bd10b8fd-b17b-505d-be34-31b755b59a68" :question/id #uuid "bd10b8fd-b17b-505d-be34-31b755b59a68"] ["question-bd10b8fd-b17b-505d-be34-31b755b59a68" :question/math-academy-id "q-71655"] ["question-bd10b8fd-b17b-505d-be34-31b755b59a68" :question/problem "$\\int (8\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)\\,\\text{d}x=$"] ["question-bd10b8fd-b17b-505d-be34-31b755b59a68" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}⁡x\\,\\text{d}x & =-\\operatorname{cos}⁡x+C, \\\\ \\int \\operatorname{cos}⁡x\\,\\text{d}x & =\\operatorname{sin}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (8\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)\\,\\text{d}x & =8\\int \\operatorname{sin}⁡x\\,\\text{d}x-\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =8(-\\operatorname{cos}⁡x)-\\operatorname{sin}⁡x+C \\\\  & =-8\\operatorname{cos}⁡x-\\operatorname{sin}⁡x+C.\\end{aligned}\n$$"] ["question-bd10b8fd-b17b-505d-be34-31b755b59a68" :question/difficulty :question.difficulty/moderate] ["answer-field-1700a89d-2650-5aef-adea-d21bee253a61" :answer-field/id #uuid "1700a89d-2650-5aef-adea-d21bee253a61"] ["answer-a9719d4f-c0e6-58b1-9042-0f8dc0cc5