[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186064558 :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186064178 :knowledge-point/questions ["question-bd10b8fd-b17b-505d-be34-31b755b59a68"] :db/ensure [:knowledge-point/validate]} {:db/id "question-bd10b8fd-b17b-505d-be34-31b755b59a68" :question/id #uuid "bd10b8fd-b17b-505d-be34-31b755b59a68" :question/math-academy-id "q-71655" :question/problem "$\\int (8\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}⁡x\\,\\text{d}x & =-\\operatorname{cos}⁡x+C, \\\\ \\int \\operatorname{cos}⁡x\\,\\text{d}x & =\\operatorname{sin}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (8\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)\\,\\text{d}x & =8\\int \\operatorname{sin}⁡x\\,\\text{d}x-\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =8(-\\operatorname{cos}⁡x)-\\operatorname{sin}⁡x+C \\\\  & =-8\\operatorname{cos}⁡x-\\operatorname{sin}⁡x+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1700a89d-2650-5aef-adea-d21bee253a61"] :db/ensure [:question/validate]} {:db/id "answer-field-1700a89d-2650-5aef-adea-d21bee253a61" :answer-field/id #uuid "1700a89d-2650-5aef-adea-d21bee253a61" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cfa7ffc1-052c-532e-8da6-94ac7004b9a9" :answer-field/choices ["answer-a9719d4f-c0e6-58b1-9042-0f8dc0cc5b3a" "answer-cfa7ffc1-052c-532e-8da6-94ac7004b9a9" "answer-e5572e89-e95f-550c-955c-320f0b7a840a" "answer-322df916-39b9-599e-a476-810f5cef3397" "answer-7c2fc9f8-9ba6-5343-a7ed-17d93cc87a5f"] :db/ensure [:answer-field/validate]} {:db/id "answer-a9719d4f-c0e6-58b1-9042-0f8dc0cc5b3a" :answer/id #uuid "a9719d4f-c0e6-58b1-9042-0f8dc0cc5b3a" :answer/type :answer.type/math :answer/value "-8\\operatorname{cos}⁡x+\\operatorname{sin}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-cfa7ffc1-052c-532e-8da6-94ac7004b9a9" :answer/id #uuid "cfa7ffc1-052c-532e-8da6-94ac7004b9a9" :answer/type :answer.type/math :answer/value "-8\\operatorname{cos}⁡x-\\operatorname{sin}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-e5572e89-e95f-550c-955c-320f0b7a840a" :answer/id #uuid "e5572e89-e95f-550c-955c-320f0b7a840a" :answer/type :answer.type/math :answer/value "-\\operatorname{cos}⁡x+8\\operatorname{sin}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-322df916-39b9-599e-a476-810f5cef3397" :answer/id #uuid "322df916-39b9-599e-a476-810f5cef3397" :answer/type :answer.type/math :answer/value "8\\operatorname{cos}⁡x+\\operatorname{sin}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-7c2fc9f8-9ba6-5343-a7ed-17d93cc87a5f" :answer/id #uuid "7c2fc9f8-9ba6-5343-a7ed-17d93cc87a5f" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡x-8\\operatorname{sin}⁡x+C" :db/ensure [:answer/validate]} {:db/id 17592186064179 :knowledge-point/questions ["question-f7057d32-2563-5caa-9eb0-bb4367d4b45b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f7057d32-2563-5caa-9eb0-bb4367d4b45b" :question/id #uuid "f7057d32-2563-5caa-9eb0-bb4367d4b45b" :question/math-academy-id "q-113919" :question/problem "$\\int 4\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x=\\operatorname{sec}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 4\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x & =4\\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x \\\\  & =4\\operatorname{sec}⁡x+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c17c9630-513d-5b72-86de-468560e389b3"] :db/ensure [:question/validate]} {:db/id "answer-field-c17c9630-513d-5b72-86de-468560e389b3" :answer-field/id #uuid "c17c9630-513