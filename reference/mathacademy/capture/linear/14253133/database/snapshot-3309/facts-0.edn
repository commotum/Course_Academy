xt{d}x & =-\\operatorname{cos}x+C \\\\ \\int {sec}^{2}x\\text{ }\\text{d}x & =\\operatorname{tan}x+C.\\end{aligned}\n$$\n\nSimilarly, by considering the derivatives of secant, cosecant, and cotangent, we arrive at\n\n$$\n\\begin{aligned}\\int \\operatorname{sec}x\\operatorname{tan}x\\text{ }\\text{d}x & =\\operatorname{sec}x+C \\\\ \\int \\operatorname{csc}x\\operatorname{cot}x\\text{ }\\text{d}x & =-\\operatorname{csc}x+C \\\\ \\int {csc}^{2}x\\text{ }\\text{d}x & =-\\operatorname{cot}x+C.\\end{aligned}\n$$\n\nWith these six formulas, we can integrate many different trigonometric functions." #edb/ref 17592186045417] [17592186065409 #edb/ref 1065 718 #edb/ref 17592186045417] [17592186065409 #edb/ref 1066 #uuid "bfa0c70d-6cf7-5c69-8995-d9f6c980a4ba" #edb/ref 17592186045417] [17592186065409 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186233195 #edb/ref 1069 "q-113925" #edb/ref 17592186045417] [17592186233195 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186233195 #edb/ref 1071 "$\\int (2\\operatorname{csc}x\\,\\operatorname{cot}x+\\operatorname{sin}x)\\,\\text{d}x=$" #edb/ref 17592186045417] [17592186233195 #edb/ref 1072 #uuid "b17add20-e3fe-557a-b7ba-b30e3097020e" #edb/ref 17592186045417] [17592186233195 #edb/ref 1074 "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}x\\,\\text{d}x & =-\\operatorname{cos}x+C, \\\\ \\int \\operatorname{csc}x\\operatorname{cot}x\\,\\text{d}x & =-\\operatorname{csc}x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (2\\operatorname{csc}x\\,\\operatorname{cot}x+\\operatorname{sin}x)\\,\\text{d}x & =2\\int \\operatorname{cos}\\operatorname{csc}x\\,\\operatorname{cot}x\\,\\text{d}x+\\int \\operatorname{sin}x\\,\\text{d}x \\\\  & =2(-\\operatorname{csc}x)+(-\\operatorname{cos}x)+C \\\\  & =-2\\operatorname{csc}x-\\operatorname{cos}x+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186233199 #edb/ref 1069 "q-113948" #edb/ref 17592186045417] [17592186233199 #edb/ref 