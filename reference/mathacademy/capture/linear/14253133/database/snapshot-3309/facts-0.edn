6 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186061546 #edb/ref 1083 #uuid "e22ce7c2-7884-59c9-9565-c7fcfd4c2ed6" #edb/ref 17592186045417] [17592186061547 #edb/ref 1080 "2\\cos y + C" #edb/ref 17592186045417] [17592186061547 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186061547 #edb/ref 1083 #uuid "385561fe-4eb3-5d10-a0f5-f926e2992f0e" #edb/ref 17592186045417] [17592186061548 #edb/ref 1080 "-2\\cos y + C" #edb/ref 17592186045417] [17592186061548 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186061548 #edb/ref 1083 #uuid "516532c4-9d7c-5444-85fc-ed8da50b326e" #edb/ref 17592186045417] [17592186064052 #edb/ref 1069 "e-382" #edb/ref 17592186045417] [17592186064052 #edb/ref 1071 "Calculate $\\displaystyle \\int 3\\sin{x}\\,\\textrm d x.$" #edb/ref 17592186045417] [17592186064052 #edb/ref 1072 #uuid "a9671d61-6b85-5d84-b49c-a6443569f6c0" #edb/ref 17592186045417] [17592186064052 #edb/ref 1074 "Recall that\n\n$$\n\\int \\sin x \\, \\textrm dx = -\\cos x + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int 3sin⁡x\\,\\text{d}x & =3\\int sin⁡x\\,\\text{d}x \\\\  & =3(-cos⁡x)+C \\\\  & =-3cos⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186064053 #edb/ref 1069 "e-383" #edb/ref 17592186045417] [17592186064053 #edb/ref 1071 "Calculate $\\displaystyle \\int (-\\csc x\\cot x)\\,\\textrm d x.$" #edb/ref 17592186045417] [17592186064053 #edb/ref 1072 #uuid "4c3342aa-dd1c-566b-9229-164e594c554c" #edb/ref 17592186045417] [17592186064053 #edb/ref 1074 "Recall that\n\n$$\n\\int \\csc x \\cot x \\, \\textrm dx = - \\csc x + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (-csc⁡xcot⁡x)\\,\\text{d}x & =-\\int (csc⁡xcot⁡x)\\,\\text{d}x \\\\  & =-(-csc⁡x)+C \\\\  & =csc⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186064054 #edb/ref 1069 "e-384" #edb/ref 17592186045417] [17592186064054 #edb/ref 1071 "Calculate the integral $\\displaystyle{\\int} (2\\sec^2 x + \\sec x \\tan x )\\, \\textrm{d}x.$" #edb/ref 17592186045417] [17592186064054 #edb/ref 1072 #uuid "3d2bde25-f8dc-5e62-9999-6593424f0ae2" #edb/ref 17592186045417] [17592186064054 #edb/ref 1074 "Recall that \n\n$$\n\\int \\sec^2 x \\, \\textrm dx = \\tan x + C\n$$\n\nand\n\n$$\n\\int \\sec x \\tan x \\, \\textrm dx = \\sec x + C.\n$$\n\nTherefore, we get\n\n$$\n\\eqalign{\n\t\t\\int (2\\sec^2 x + \\sec x \\tan x )\\, \\textrm{d}x& = 2 \\int \\sec^2 x \\, \\textrm{d}x+ \\int \\sec x \\tan x \\, \\textrm{d}x \\\n\t\t\t\t\t\t\t\t\t\t&=2\\tan x + \\sec x + C.\n\n}\n$$" #edb/ref 17592186045417] [17592186064055 #edb/ref 1069 "e-385" #edb/ref 17592186045417] [17592186064055 #edb/ref 1071 "Calculate the integral $\\displaystyle{\\int} \\csc{x}(\\csc{x}+3\\cot{x} )\\, \\textrm{d}x.$" #edb/ref 17592186045417] [17592186064055 #edb/ref 1072 #uuid "c2c57145-3988-5ce8-b13f-114bba6964f7" #edb/ref 17592186045417] [17592186064055 #edb/ref 1074 "Recall that \n\n$$\n\\int \\csc^2 x \\, \\textrm dx = -\\cot x + C\n$$\n\nand\n\n$$\n\\int \\csc x \\cot x \\, \\textrm dx = -\\csc x + C.\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\int csc⁡x(csc⁡x+3cot⁡x)\\,\\text{d}x & =\\int {csc}^{2}⁡x+3csc⁡xcot⁡x\\,\\text{d}x \\\\  & =\\int {csc}^{2}⁡x\\,\\text{d}x+3\\int csc⁡xcot⁡x\\,\\text{d}x \\\\  & =-cot⁡x-3csc⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186064178 #edb/ref 1037 #edb/ref 17592186048442 #edb/ref 17592186045417] [17592186064178 #edb/ref 1037 #edb/ref 17592186050321 #edb/ref 17592186045417] [17592186064178 #edb/ref 1037 #edb/ref 17592186050420 #edb/ref 17592186045417] [17592186064178 #edb/ref 1038 #edb/ref 17592186064558 #edb/ref 17592186045417] [17592186064178 #edb/ref 1038 #edb/ref 17592186064559 #edb/ref 17592186045417] [17592186064178 #edb/ref 1038 #edb/ref 17592186234309 #edb/ref 17592186045417] [17592186064178 #edb/ref 1038 #edb/ref 17592186234310 #edb/ref 17592186045417] [17592186064178 #edb/ref 1038 #edb/ref 17592186235435 #edb/ref 17592186045417] [17592186064178 #edb/ref 1038 #edb/ref 1