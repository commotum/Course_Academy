d}x \\\\  & =\\int \\operatorname{cos}⁡x\\,\\text{d}x-5\\int {sec}^{2}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x-5\\operatorname{tan}⁡x+C.\\end{aligned}\\end{aligned}\n$$"}]}
