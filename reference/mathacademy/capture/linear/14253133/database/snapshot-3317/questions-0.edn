t :answer.type/math} :answer/value "-4csc⁡x-tan⁡x+C" :db/id #edb/ref 17592186288464} {:answer/id #uuid "74d923d2-3efc-5ca9-941b-f2721f9ebb87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4csc⁡x+sec⁡x+C" :db/id #edb/ref 17592186288844} {:answer/id #uuid "abf937ba-cc12-532c-bb17-a12d2975c76f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4cot⁡x+tan⁡x+C" :db/id #edb/ref 17592186289171} {:answer/id #uuid "ba90d1ee-fd42-5b53-b6d2-9a950b91bbcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4csc⁡x+tan⁡x+C" :db/id #edb/ref 17592186289264}] :answer-field/correct {:answer/id #uuid "ba90d1ee-fd42-5b53-b6d2-9a950b91bbcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4csc⁡x+tan⁡x+C" :db/id #edb/ref 17592186289264} :answer-field/id #uuid "1f887537-7c98-501a-bbfa-38699eb068a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289808}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "150e96e0-2dad-5989-ac38-041fb3f1fdd0" :question/math-academy-id "q-2164" :question/problem "$\\int (4csc⁡xcot⁡x+{sec}^{2}⁡x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int csc⁡xcot⁡x\\,\\text{d}x & =-csc⁡x+C \\\\ \\int {sec}^{2}⁡x\\,\\text{d}x & =tan⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (4csc⁡xcot⁡x+{sec}^{2}⁡x)\\,\\text{d}x & =\\int 4csc⁡xcot⁡x\\,\\text{d}x+\\int {sec}^{2}⁡x\\,\\text{d}x \\\\  & =4(-csc⁡x)+tan⁡x+C \\\\  & =-4csc⁡x+tan⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186575586 :knowledge-point/_questions [{:db/id #edb/ref 17592186064181 :knowledge-point/id #uuid "9836abbe-e172-5c2f-8b19-145ef6d5c02d" :knowledge-point/title "Integrating Cosecant Squared"}] :q