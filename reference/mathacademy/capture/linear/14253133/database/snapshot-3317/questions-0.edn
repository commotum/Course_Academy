#{[{:db/id #edb/ref 17592186064052 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064178 :knowledge-point/id #uuid "0cae5c1b-57bd-51f6-a360-db946d25532f" :knowledge-point/title "Integrating Sine and Cosine"}] :question/id #uuid "a9671d61-6b85-5d84-b49c-a6443569f6c0" :question/math-academy-id "e-382" :question/problem "Calculate $\\displaystyle \\int 3\\sin{x}\\,\\textrm d x.$" :question/worked-solution "Recall that\n\n$$\n\\int \\sin x \\, \\textrm dx = -\\cos x + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int 3sin⁡x\\,\\text{d}x & =3\\int sin⁡x\\,\\text{d}x \\\\  & =3(-cos⁡x)+C \\\\  & =-3cos⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064053 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064179 :knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/title "Integrating Secant-Tangent and Cosecant-Cotangent"}] :question/id #uuid "4c3342aa-dd1c-566b-9229-164e594c554c" :question/math-academy-id "e-383" :question/problem "Calculate $\\displaystyle \\int (-\\csc x\\cot x)\\,\\textrm d x.$" :question/worked-solution "Recall that\n\n$$\n\\int \\csc x \\cot x \\, \\textrm dx = - \\csc x + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (-csc⁡xcot⁡x)\\,\\text{d}x & =-\\int (csc⁡xcot⁡x)\\,\\text{d}x \\\\  & =-(-csc⁡x)+C \\\\  & =csc⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064054 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064180 :knowledge-point/id #uuid "caf358b8-31fb-5587-8663-f414317c42be" :knowledge-point/title "Integrating Secant Squared"}] :question/id #uuid "3d2bde25-f8dc-5e62-9999-6593424f0ae2" :question/math-academy-id "e-384" :question/problem "Calculate the integral $\\displaystyle{\\int} (2\\sec^2 x + \\sec x \\tan x )\\, \\textrm{d}x.$" :question/worked-solution "Recall that \n\n$$\n\\int \\sec^2 x \\, \\textrm dx = \\tan x + C\n$$\n\nand\n\n$$\n\\int \\sec x \\tan x \\, \\textrm dx = \\sec x + C.\n$$\n\nTherefore, we get\n\n$$\n\\eqalign{\n\t\t\\int (2\\sec^2 x + \\sec x \\tan x )\\, \\textrm{d}x& = 2 \\int \\sec^2 x \\, \\textrm{d}x+ \\int \\sec x \\tan x \\, \\textrm{d}x \\\n\t\t\t\t\t\t\t\t\t\t&=2\\tan x + \\sec x + C.\n\n}\n$$"}] [{:db/id #edb/ref 17592186064055 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064181 :knowledge-point/id #uuid "9836abbe-e172-5c2f-8b19-145ef6d5c02d" :knowledge-point/title "Integrating Cosecant Squared"}] :question/id #uuid "c2c57145-3988-5ce8-b13f-114bba6964f7" :question/math-academy-id "e-385" :question/problem "Calculate the integral $\\displaystyle{\\int} \\csc{x}(\\csc{x}+3\\cot{x} )\\, \\textrm{d}x.$" :question/worked-solution "Recall that \n\n$$\n\\int \\csc^2 x \\, \\textrm dx = -\\cot x + C\n$$\n\nand\n\n$$\n\\int \\csc x \\cot x \\, \\textrm dx = -\\csc x + C.\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\int csc⁡x(csc⁡x+3cot⁡x)\\,\\text{d}x & =\\int {csc}^{2}⁡x+3csc⁡xcot⁡x\\,\\text{d}x \\\\  & =\\int {csc}^{2}⁡x\\,\\text{d}x+3\\int csc⁡xcot⁡x\\,\\text{d}x \\\\  & =-cot⁡x-3csc⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186575621 :knowledge-point/_questions [{:db/id #edb/ref 17592186064179 :knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/title "Integrating Secant-Tangent and Cosecant-Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4aee2163-e8a4-5db3-b481-1e8dba213e28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186575077} {:answer/id #uuid "555c3bc4-aaa4-54ab-86d4-e690a6ee7f08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\operatorname{csc}⁡x+C" :db/id #edb/ref 17592186575098} {:answer/id #uuid "666f70a8-5246-59d5-a9a4-eb81a720cfdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186575133} {:answer/id #uuid "936df478-a4cb-5ede-900f-165576785176" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{csc}⁡x+C" :db/id #edb/ref 17592186575203} {:answer/id #uuid "c6b9b9b6-687d-58c6-a996-f8747f0bad9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{csc}⁡x\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186575302}] :answer-field/correct {:answer/id #uuid "4aee2163-e8a4-5db3-b481-1e8dba213e28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186575077} :answer-field/id #uuid "c17c9630-513d-5b72-86de-468560e389b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575490}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f7057d32-2563-5caa-9eb0-bb4367d4b45b" :question/math-academy-id "q-113919" :question/problem "$\\int 4\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x=\\operatorname{sec}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 4\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x & =4\\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x \\\\  & =4\\operatorname{sec}⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233195 :knowledge-point/_questions [{:db/id #edb/ref 17592186064179 :knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/title "Integrating Secant-Tangent and Cosecant-Cotangent"}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b17add20-e3fe-557a-b7ba-b30e3097020e" :question/math-academy-id "q-113925" :question/problem "$\\int (2\\operatorname{csc}x\\,\\operatorname{cot}x+\\operatorname{sin}x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}x\\,\\text{d}x & =-\\operatorname{cos}x+C, \\\\ \\int \\operatorname{csc}x\\operatorname{cot}x\\,\\text{d}x & =-\\operatorname{csc}x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (2\\operatorname{csc}x\\,\\operatorname{cot}x+\\operatorname{sin}x)\\,\\text{d}x & =2\\int \\operatorname{cos}\\operatorname{csc}x\\,\\operatorname{cot}x\\,\\text{d}x+\\int \\operatorname{sin}x\\,\\text{d}x \\\\  & =2(-\\operatorname{csc}x)+(-\\operatorname{cos}x)+C \\\\  & =-2\\operatorname{csc}x-\\operatorname{cos}x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250142 :knowledge-point/_questions [{:db/id #edb/ref 17592186064180 :knowledge-point/id #uuid "caf358b8-31fb-5587-8663-f414317c42be" :knowledge-point/title "Integrating Secant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a394ebb-e724-5257-b2b3-c6ee24c9c0ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2sec⁡\\theta +C" :db/id #edb/ref 17592186247513} {:answer/id #uuid "645e7853-d773-51a7-97f0-145e363f5063" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2csc⁡\\theta +C" :db/id #edb/ref 17592186248330} {:answer/id #uuid "a159c48f-05f8-5b71-ac43-7e38b5032b08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{csc}^{2}⁡\\theta +C" :db/id #edb/ref 17592186248866} {:answer/id #uuid "cb0b4d51-0534-5643-95e4-f3c845c225d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{tan}^{2}⁡\\theta +C" :db/id #edb/ref 17592186249233} {:answer/id #uuid "ee2434c9-75b3-5a4f-85a5-13b29917e9e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2tan⁡\\theta +C" :db/id #edb/ref 17592186249513}] :answer-field/correct {:answer/id #uuid "ee2434c9-75b3-5a4f-85a5-13b29917e9e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2tan⁡\\theta +C" :db/id #edb/ref 17592186249513} :answer-field/id #uuid "0726a333-67f4-5bae-9092-988faf871214" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249681}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1eae0c2a-9fbb-58f9-9e02-1ea035b71ceb" :question/math-academy-id "q-113936" :question/problem "$\\int 2{sec}^{2}⁡\\theta \\,\\text{d}\\theta =$" :question/worked-solution "Recall that \n\n$$\n\\int {sec}^{2}⁡\\theta \\,\\text{d}\\theta =tan⁡\\theta +C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 2{sec}^{2}⁡\\theta \\,\\text{d}\\theta  & =2\\int {sec}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =2tan⁡\\theta +C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233199 :knowledge-point/_questions [{:db/id #edb/ref 17592186064181 :knowledge-point/id #uuid "9836abbe-e172-5c2f-8b19-145ef6d5c02d" :knowledge-point/title "Integrating Cosecant Squared"}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f618a7fb-c5a6-5658-a8d2-b99235d841c5" :question/math-academy-id "q-113948" :question/problem "$\\int -\\frac{5}{2}{csc}^{2}x\\,\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\int {csc}^{2}x\\,\\text{d}x=-\\operatorname{cot}x+C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -\\frac{5}{2}{csc}^{2}x\\,\\text{d}x & =-\\frac{5}{2}\\int {csc}^{2}x\\,\\text{d}x \\\\  & =-\\frac{5}{2}(-\\operatorname{cot}x)+C \\\\  & =\\frac{5}{2}\\operatorname{cot}x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064558 :knowledge-point/_questions [{:db/id #edb/ref 17592186064178 :knowledge-point/id #uuid "0cae5c1b-57bd-51f6-a360-db946d25532f" :knowledge-point/title "Integrating Sine and Cosine"}] :question/answer-fields [{:answer-fi