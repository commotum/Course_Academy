/choices [{:answer/id #uuid "24bb2493-b6b6-5d54-b78c-b4c1fd465e51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186487641} {:answer/id #uuid "490a6f61-2482-51b0-81bd-3e73e105401f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186487708} {:answer/id #uuid "89062bc1-52d6-57b1-af7f-faf92c3a0acc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186487829} {:answer/id #uuid "b95af5b5-6f95-5f07-93d3-699e06f67de0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186487917} {:answer/id #uuid "df33c786-ac05-5617-bf45-fc7fd569cbb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186487991}] :answer-field/correct {:answer/id #uuid "df33c786-ac05-5617-bf45-fc7fd569cbb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186487991} :answer-field/id #uuid "bb5ed6c7-ffea-5fa5-bd95-1d344498f2d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186488133}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d094ad0f-c26b-57d4-8a3d-3a131e61b0c8" :question/math-academy-id "q-77697" :question/problem "If $y(t)=A\\cdot {5}^{t}$ and $y(2)=175,$ then $A=$" :question/worked-solution "We substitute $t=2$ and $y(t)=175$ into the expression for $y(t)$ and then solve for $A,$ as follows:\n\n$$\n\\begin{aligned}175 & =A\\cdot {5}^{2} \\\\ \\frac{175}{{5}^{2}} & =A \\\\ \\frac{175}{25} & =A \\\\ 7 & =A.\\end{aligned}\n$$\n\nTherefore, $A=7.$"}] [{:db/id #edb/ref 17592186488187 :knowledge-point/_questions [{:db/id #edb/ref 17592186096658 :knowledge-point/id #uuid "6bab04f2-5e9a-55e7-9669-63e15938be0a" :knowledge-point/title "Evaluating a Function in a Modeling Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b7dfae5-b1a0-5362-83b9-26d68e7d28fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\,500" :db/id #edb/ref 17592186487588} {:answer/id #uuid "12a71d6a-5ce8-5979-a343-2093ca73b8b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,000" :db/id #edb/ref 17592186487607} {:answer/id #uuid "74786fdc-a52c-5700-81a6-37b58ddd953d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,800" :db/id #edb/ref 17592186487800} {:answer/id #uuid "abaf773d-4371-5f2a-80e7-d98c7190b007" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,000" :db/id #edb/ref 17592186487896} {:answer/id #uuid "ce1b38b7-9a86-5be0-9fb2-4ba2d5446529" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,000" :db/id #edb/ref 17592186487962}] :answer-field/correct {:answer/id #uuid "abaf773d-4371-5f2a-80e7-d98c7190b007" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,000" :db/id #edb/ref 17592186487896} :answer-field/id #uuid "340fbdbc-1d06-5b42-ac2d-473bb2673492" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186488070}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "169115e9-c4da-5b2d-98db-fdbf90bfcfbf" :question/math-academy-id "q-78011" :question/problem "Margaret is studying and analyzing a culture of bacteria. From a certain moment, she notices that the number of bacteria $B(t)$ in the culture grows according to the formula $B(t)=500\\cdot {2}^{t},$ where $t$ denotes the time in hours. How many bacteria will there be after $4$ hours?" :question/worked-solution "To get the number of bacteria in the culture after $4$ hours, we evaluate the function at $t=4.$ Substituting $t=4$ into the function $B(t)$ gives\n\n$$\n\\begin{aligned}B(t) & =500\\cdot (2)^{(4)} \\\\  & =500\\cdot 16 \\\\  & =8\\,000.\\end{aligned}\n$$\n\nTherefore, there will be $8\\,000$ bacteria in the culture after $4$ hours."}]}
