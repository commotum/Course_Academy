#{[{:db/id #edb/ref 17592186096390 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186096657 :knowledge-point/id #uuid "9283940a-cad8-51b5-b8c2-dc42ad8de264" :knowledge-point/title "Evaluating an Exponential Function"}] :question/id #uuid "d03736b3-a7d8-52b3-894d-4ce2d04ee31c" :question/math-academy-id "e-14257" :question/problem "If $f(x) = 12 \\cdot 2^{x},$ then $f(-4)=$" :question/worked-solution "To calculate $f(-4),$ we substitute $x=-4$ into the expression for $f(x).$ This gives\n\n$$\n\\begin{aligned}f(-4) & =12\\cdot {2}^{-4} \\\\  & =12\\cdot \\frac{1}{{2}^{4}} \\\\  & =12\\cdot \\frac{1}{16} \\\\  & =\\frac{12}{16} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096391 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186096658 :knowledge-point/id #uuid "6bab04f2-5e9a-55e7-9669-63e15938be0a" :knowledge-point/title "Evaluating a Function in a Modeling Problem"}] :question/id #uuid "a83c1301-18cf-5622-8a4a-73f9d18e36b8" :question/math-academy-id "e-14260" :question/problem "The formula $M(t)=128 \\cdot \\left(\\dfrac{1}{4} \\right)^{t}$ gives the mass (in grams) of a radioactive calcium isotope after $t$ years.\nWhat mass of isotope remains after $3$ years?" :question/worked-solution "To get the mass of the isotope after $3$ years, we evaluate the function at $t=3.$ Substituting $t=3$ into the function $M(t)$ gives\n\n$$\n\\begin{aligned}M & =128{(\\frac{1}{4})}^{t} \\\\  & =128{(\\frac{1}{4})}^{3} \\\\  & =128\\cdot \\frac{{1}^{3}}{{4}^{3}} \\\\  & =128\\cdot \\frac{1}{64} \\\\  & =\\frac{128}{64} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, after $3$ years, there will be $2$ grams of isotope remaining."}] [{:db/id #edb/ref 17592186096392 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186096659 :knowledge-point/id #uuid "b0cee2b0-6cc8-5281-8ea2-02400b2980e1" :knowledge-point/title "Finding an Initial Value"}] :question/id #uuid "ca8cd4d6-8136-59bb-a033-6ba9ae8c06ed" :question/math-academy-id "e-14262" :question/problem "Solve for $C$ given that $y(t) = C \\cdot \\left(\\dfrac{1}{2}\\right)^{t}$ and $y(5)=1.$" :question/worked-solution "We substitute $t=5$ and $y(t)=1$ into the expression for $y(t),$ and get\n\n$$\n\\begin{aligned}1 & =C\\cdot {(\\frac{1}{2})}^{5} \\\\ 1 & =C\\cdot \\frac{{1}^{5}}{{2}^{5}} \\\\ 1 & =C\\cdot \\frac{1}{32} \\\\ 1\\cdot 32 & =C \\\\ 32 & =C.\\end{aligned}\n$$\n\nTherefore, $C=32.$"}] [{:db/id #edb/ref 17592186096393 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186096660 :knowledge-point/id #uuid "4a21f047-5100-5f8b-9448-a5c2044e4e65" :knowledge-point/title "Solving for an Unknown Input Value"}] :question/id #uuid "02cbb721-a880-5600-8093-fc768ae5e993" :question/math-academy-id "e-14264" :question/problem "Given that $P(x) = 2 \\cdot 5^{3x},$ find $x$ such that $P(x)=250.$" :question/worked-solution "First we substitute $P(x)=250$ into the equation:\n\n$$\n2 \\cdot 5^{3x}= 250\n$$\n\nWe can divide both sides of the equation by the constant factor of $2\\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{2\\cdot {5}^{3x}}{2} & =\\frac{250}{2} \\\\ \\frac{\\cancel{2}\\cdot {5}^{3x}}{\\cancel{2}} & =125 \\\\ {5}^{3x} & =125\\end{aligned}\n$$\n\nFinally, we solve for $x,$ using the fact that $125$ is a power of $5\\mathbin{:}$\n\n$$\n\\begin{aligned}{5}^{3x} & ={5}^{3} \\\\ 3x & =3 \\\\ x & =1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186488261 :knowledge-point/_questions [{:db/id #edb/ref 17592186096659 :knowledge-point/id #uuid "b0cee2b0-6cc8-5281-8ea2-02400b2980e1" :knowledge-point/title "Finding an Initial Value"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12a207cf-6494-5af2-b52a-41f556e25100" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "250" :db/id #edb/ref 17592186487606} {:answer/id #uuid "14ac090f-06af-58f6-a876-572a7a915072" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "125" :db/id #edb/ref 17592186487611} {:answer/id #uuid "818f48fd-f209-588b-b57a-55e82b90bb7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "625" :db/id #edb/ref 17592186487815} {:answer/id #uuid "91ec9b4b-73ba-5016-a495-db90de87e967" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "150" :db/id #edb/ref 17592186487843} {:answer/id #uuid "eb46e060-8079-5761-b929-c7bcbfacd690" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "500" :db/id #edb/ref 17592186488008}] :answer-field/correct {:answer/id #uuid "eb46e060-8079-5761-b929-c7bcbfacd690" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "500" :db/id #edb/ref 17592186488008} :answer-field/id #uuid "69942c77-cdc5-573d-a72f-6608a052a092" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186488092}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c97061a8-e888-5c8e-ae09-c8d25cf5d2a1" :question/math-academy-id "q-111930" :question/problem "If $f(t)=A\\cdot {(\\frac{1}{5})}^{t}$ and $f(3)=4,$ then $A=$" :question/worked-solution "We substitute $t=3$ and $f(t)=4$ into the expression for $f(t)$ and solve for $A,$ as follows:\n\n$$\n\\begin{aligned}4 & =A\\cdot {(\\frac{1}{5})}^{3} \\\\ 4 & =A\\cdot (\\frac{{1}^{3}}{{5}^{3}}) \\\\ 4 & =A\\cdot \\frac{1}{125} \\\\ 4\\cdot 125 & =A \\\\ 500 & =A\\end{aligned}\n$$\n\nTherefore, $A=500.$"}] [{:db/id #edb/ref 17592186097195 :knowledge-point/_questions [{:db/id #edb/ref 17592186096657 :knowledge-point/id #uuid "9283940a-cad8-51b5-b8c2-dc42ad8de264" :knowledge-point/title "Evaluating an Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b03f9bd-0d65-5d4d-94b1-94ec66283e31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186487714}] :answer-field/correct {:answer/id #uuid "4b03f9bd-0d65-5d4d-94b1-94ec66283e31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186487714} :answer-field/id #uuid "a730ddba-a0ca-5b47-bb1a-ec0ce7519cb0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186095119}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6b3ff04e-fd71-56bd-a3d9-91bf504b1369" :question/math-academy-id "q-218564" :question/problem "If $g(x)=8\\cdot {(\\frac{3}{4})}^{x},$ then $g(2)=${{field-1}}." :question/requires-calculator true :question/worked-solution "To calculate $g(2),$ we substitute $x=2$ into the expression for $g(x).$ This gives\n\n$$\n\\begin{aligned}g(2) & =8\\cdot {(\\frac{3}{4})}^{2} \\\\  & =8\\cdot (\\frac{{3}^{2}}{{4}^{2}}) \\\\  & =8\\cdot \\frac{9}{16} \\\\  & =\\frac{72}{16} \\\\  & =\\frac{9}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186488280 :knowledge-point/_questions [{:db/id #edb/ref 17592186096660 :knowledge-point/id #uuid "4a21f047-5100-5f8b-9448-a5c2044e4e65" :knowledge-point/title "Solving for an Unknown Input Value"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "649ad70b-e688-5d26-97db-4e5143cbf659" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186487769}] :answer-field/correct {:answer/id #uuid "649ad70b-e688-5d26-97db-4e5143cbf659" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186487769} :answer-field/id #uuid "aaa84f9b-eb74-5ae9-9fee-178d468d3d0a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186488125}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f6033ad1-0d99-515b-be18-2f73585eb731" :question/math-academy-id "q-218659" :question/problem "Given that $h(t)=5\\cdot {4}^{3t+6},$ find $t$ such that $h(t)=320.$\n\n$t=$\n{{field-1}}" :question/worked-solution "First, we substitute $h(t)=320$ into the equation:\n\n$$\n5\\cdot {4}^{3t+6}=320\n$$\n\nWe can divide both sides of the equation by the constant factor of $5:$\n\n$$\n\\begin{aligned}\\frac{5\\cdot {4}^{3t+6}}{5} & =\\frac{320}{5} \\\\ \\frac{\\cancel{5}\\cdot {4}^{3t+6}}{\\cancel{5}} & =64 \\\\ {4}^{3t+6} & =64\\end{aligned}\n$$\n\nFinally, we solve for $t$ using the fact that $64$ is a power of $4:$\n\n$$\n\\begin{aligned}{4}^{3t+6} & ={4}^{3} \\\\ 3t+6 & =3 \\\\ 3t & =-3 \\\\ t & =-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186488251 :knowledge-point/_questions [{:db/id #edb/ref 17592186096658 :knowledge-point/id #uuid "6bab04f2-5e9a-55e7-9669-63e15938be0a" :knowledge-point/title "Evaluating a Function in a Modeling Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01f1eb24-33d1-519b-84d6-31c2eb715398" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30\\,726" :db/id #edb/ref 17592186487571} {:answer/id #uuid "19150eb0-c436-5776-9f31-e67e35e9bc43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20\\,736" :db/id #edb/ref 17592186487618} {:answer/id #uuid "1e0d8b8d-d895-59eb-bcb0-1f00f725418a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22\\,700" :db/id #edb/ref 17592186487627} {:answer/id #uuid "59c69f84-4c9b-5b5c-9c6a-621b7bd33779" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23\\,706" :db/id #edb/ref 17592186487748} {:answer/id #uuid "bceac2a7-1e0e-58bb-8f9d-aaa55d968bf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27\\,036" :db/id #edb/ref 17592186487922}] 