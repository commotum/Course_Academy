 17592186045417 true] [17592186424804 1075 #edb/ref 17592186424719 13194139534537 17592186045417 true] [17592186424804 1075 #edb/ref 17592186424744 13194139534537 17592186045417 true] [17592186424804 1075 #edb/ref 17592186424746 13194139534537 17592186045417 true] [17592186424804 1076 #edb/ref 17592186045493 13194139534537 17592186045417 true] [17592186424804 1077 "selection" 13194139534537 17592186045417 true] [17592186424804 1078 #edb/ref 17592186424719 13194139534537 17592186045417 true] [17592186424804 1079 #uuid "e4ea0cbd-ce5a-544a-994e-2f0c60d8bf7d" 13194139534537 17592186045417 true] [17592186424805 1075 #edb/ref 17592186424646 13194139534537 17592186045417 true] [17592186424805 1075 #edb/ref 17592186424649 13194139534537 17592186045417 true] [17592186424805 1075 #edb/ref 17592186424688 13194139534537 17592186045417 true] [17592186424805 1075 #edb/ref 17592186424713 13194139534537 17592186045417 true] [17592186424805 1075 #edb/ref 17592186424757 13194139534537 17592186045417 true] [17592186424805 1076 #edb/ref 17592186045493 13194139534537 17592186045417 true] [17592186424805 1077 "selection" 13194139534537 17592186045417 true] [17592186424805 1078 #edb/ref 17592186424713 13194139534537 17592186045417 true] [17592186424805 1079 #uuid "efc3478e-663c-513f-98e8-1fbc5277d0d0" 13194139534537 17592186045417 true] [17592186424806 1075 #edb/ref 17592186424659 13194139534537 17592186045417 true] [17592186424806 1075 #edb/ref 17592186424696 13194139534537 17592186045417 true] [17592186424806 1075 #edb/ref 17592186424700 13194139534537 17592186045417 true] [17592186424806 1075 #edb/ref 17592186424735 13194139534537 17592186045417 true] [17592186424806 1075 #edb/ref 17592186424749 13194139534537 17592186045417 true] [17592186424806 1076 #edb/ref 17592186045493 13194139534537 17592186045417 true] [17592186424806 1077 "selection" 13194139534537 17592186045417 true] [17592186424806 1078 #edb/ref 17592186424749 13194139534537 17592186045417 true] [17592186424806 1079 #uuid "f3caaf88-bd90-5d96-ae11-c1828ec82fce" 13194139534537 17592186045417 true] [17592186424807 1068 #edb/ref 17592186424779 13194139534537 17592186045417 true] [17592186424807 1069 "q-61586" 13194139534537 17592186045417 true] [17592186424807 1070 #edb/ref 17592186045486 13194139534537 17592186045417 true] [17592186424807 1071 "If a circle represents a whole, which model shows $210%?$" 13194139534537 17592186045417 true] [17592186424807 1072 #uuid "00b9b682-db5e-578e-b943-e60736c094da" 13194139534537 17592186045417 true] [17592186424807 1074 "First, recall that $210%$ is the same as $\\frac{210}{100}.$\n\nWe now need to simplify this fraction. Dividing the numerator and denominator by $10,$ we get\n\n$$\n\\frac{210}{100}=\\frac{210÷10}{100÷10}=\\frac{21}{10}.\n$$\n\nFinally, we write $\\frac{21}{10}$ as a mixed number:\n\n$$\n\\frac{21}{10}=2\\,\\text{R}\\,1=2\\,\\frac{1}{10}\n$$\n\nThe model that shows $2\\,\\frac{1}{10}$ is:\n\n![](images/b9/b901819e40d67559b5b8f6d137ab5595531801f5529f778be34c768b2dc40c3f.png)" 13194139534537 17592186045417 true] [17592186424808 1068 #edb/ref 17592186424785 13194139534537 17592186045417 true] [17592186424808 1069 "q-70168" 13194139534537 17592186045417 true] [17592186424808 1070 #edb/ref 17592186045487 13194139534537 17592186045417 true] [17592186424808 1071 "$\\frac{7}{10}\\times 6=$" 13194139534537 17592186045417 true] [17592186424808 1072 #uuid "028c8481-ba77-5958-9c80-addca2355a16" 13194139534537 17592186045417 true] [17592186424808 1074 "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n\\frac{7\\times 6}{10}=\\frac{42}{10}\n$$\n\nWe then simplify:\n\n$$\n\\frac{42}{10}=\\frac{42÷2}{10÷2}=\\frac{21}{5}\n$$\n\nFinally, we then convert $\\frac{21}{5}$ to a mixed number:\n\n$$\n21÷5=4\\,\\text{R}1=4\\,\\frac{1}{5}\n$$" 13194139534537 17592186045417 true] [17592186424809 1068 #edb/ref 17592186424804 13194139534537 17592186045417 true] [17592186424809 1069 "q-92133" 13194139534537 17592186045417 true] [17592186424809 1070 #edb/ref 17592186045487 13194139534537 17592186045417 true] [17592186424809 1071 "![](images/b1/b1c4d24b853c33ae4ba367761eb207eacf7cc46312077e3f21416cfc05f5ef3b.png)\n\nThe model above represents $2$ wholes. Use this model to calculate the value of $2÷\\frac{1}{3}.$" 13194139534537 17592186045417 true] [17592186424809 1072 #uuid "02ac172b-9db9-5580-848c-c810f3c4dd7a" 13194139534537 17592186045417 true] [17592186424809 1074 "To calculate $2÷\\frac{1}{3}$, we need to divide each of $2$ wholes into $3$ equal parts, as shown below.\n\n![](images/29/291ef5c96846fd1244b9be904da7d56db056befa0758b78c169f24b414d8b96e.png)\n\n \n\nWe get $2\\times 3=6$ pieces in total. \n\nTherefore:\n\n$$\n2÷\\frac{1}{3}=6\n$$" 13194139534537 17592186045417 true] [17592186424810 1068 #edb/ref 17592186424790 13194139534537 17592186045417 true] [17592186424810 1069 "q-55068" 13194139534537 17592186045417 true] [17592186424810 1070 #edb/ref 17592186045485 13194139534537 17592186045417 true] [17592186424810 1071 "${53}^{4}=$" 13194139534537 17592186045417 true] [17592186424810 1072 #uuid "0cbd63dc-7d38-513f-8022-cfd6f02074bf" 13194139534537 17592186045417 true] [17592186424810 1074 "Here, ${53}^{4}$ is in exponent form. The base is $53$ and the exponent is $4.$ \n\nThis means that $53$ is multiplied by itself $4$ times:\n\n$$\n{{53\\times 53\\times 53\\times 53}_{⏟}}_{4\\text{ times}}.\n$$\n\nTherefore,\n\n$$\n{53}^{4}=53\\times 53\\times 53\\times 53.\n$$" 13194139534537 17592186045417 true] [17592186424811 1068 #edb/ref 17592186424791 13194139534537 17592186045417 true] [17592186424811 1069 "q-138343" 13194139534537 17592186045417 true] [17592186424811 1070 #edb/ref 17592186045486 13194139534537 17592186045417 true] [17592186424811 1071 "$(7.2)^{2}=$" 13194139534537 17592186045417 true] [17592186424811 1072 #uuid "0faa0bbf-a97d-52f3-9471-5236871deb2a" 13194139534537 17592186045417 true] [17592186424811 1074 "First, by writing the expression with multiplication signs, we get the following:\n\n$$\n\\begin{aligned}{(7.2)}^{2} & ={{7.2\\times 7.2}_{⏟}}_{2\\text{ times}}\\end{aligned}\n$$\n\nWe proceed by multiplying the two numbers just as we would with whole numbers:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{1} \\\\ \\boxed{}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\,\\end{aligned} & \\,\\, & \\begin{aligned}\\end{aligned} \\\\  & \\end{aligned}\n$$\n\nWe now count the number of decimal places in the $2$ factors.\n\nThere is $1$ decimal place in $7.2.$\nTherefore, the exponent $(7.2)^{2}$ will have $1\\times 2=2$ decimal places.\n\nSo, we take our value of $5184$ and add a decimal point to make a number with $2$ decimal places:\n\n$$\n51\\,\\overset{↓}{.}\\,\\,\\,\\,\\,{{84}_{⏟}}_{2\\text{ digits}}\n$$\n\nTherefore, we conclude that $(7.2)^{2}=51.84.$" 13194139534537 17592186045417 true] [17592186424812 1068 #edb/ref 17592186424778 13194139534537 17592186045417 true] [17592186424812 1069 "q-136918" 13194139534537 17592186045417 true] [17592186424812 1070 #edb/ref 17592186045487 13194139534537 17592186045417 true] [17592186424812 1071 "$\\frac{32}{5}\\times \\frac{25}{8}=$" 13194139534537 17592186045417 true] [17592186424812 1072 #uuid "152194d4-bfdf-57ac-b58d-963178280721" 13194139534537 17592186045417 true] [17592186424812 1074 "Interpreting the fractions as division, we get\n\n$$\n(32\\,÷\\,5)\\times (25\\,÷\\,8).\n$$\n\n \n\nSince our expression contains multiplication and division only, we can create an equivalent expression by swapping the $÷\\,5$ and $÷\\,8:$\n\n$$\n(32\\,÷\\,8)\\times (25\\,÷\\,5)\n$$\n\n \n\nInterpreting the divisions as fractions, we get\n\n$$\n\\frac{32}{8}\\times \\frac{25}{5}.\n$$\n\nCarrying out the divisions, we arrive at\n\n$$\n\\begin{aligned}{{\\frac{32}{8}}_{⏟}}_{4}\\times {{\\frac{25}{5}}_{⏟}}_{5}=4\\times 5=20.\\end{aligned}\n$$" 13194139534537 17592186045417 true] [17592186424813 1068 #edb/ref 17592186424787 13194139534537 17592186045417 true] [17592186424813 1069 "q-63721" 13194139534537 17592186045417 true] [17592186424813 1070 #edb/ref 17592186045487 13194139534537 17592186045417 true] [17592186424813 1071 "Determine the least common multiple of $4,$ $6$ and $8.$" 13194139534537 17592186045417 true] [17592186424813 1072 #uuid "19af72ca-8e82-500b-a6d5-3bf3c4fb4f5d" 13194139534537 17592186045417 true] [17592186424813 1074 "Let's list the multiples of each number. Then, we find the smallest number that appears in all three lists:\n\n- Multiples of $4$: $\\,4,8,12,16,20,24,28…$\n\n- Multiples of $6$: $\\,6,12,18,24,30…$\n\n- Multiples of $8$: $\\,8,16,24,32…$\n\nWe conclude that the least common multiple of  $4,$ $6$ and $8$ is $24.$" 13194139534537 17592186045417 true] [17592186424814 1068 #edb/ref 17592186424805 13194139534537 17592186045417 true] [17592186424814 1069 "q-150960" 13194139534537 17592186045417 true] [17592186424814 1070 #edb/ref 17592186045487 13194139534537 17592186045417 true] [17592186424814 1071 "![](images/d1/d1e17f92f13f6929a55967bd2fcf9f963adf074056affcedcdd753ed6f68aec7.png)\n\nWhat is the correct way to represent the line segment shown above?" 13194139534537 17592186045417 true] [17592186424814 1072 #uuid "2765417b-abb7-5b0c-b51e-af1cad40b562" 13194139534537 17592186045417 true] [17592186424814 1074 "Since the segment has endpoints $S$ and $T,$ we can represent this line segment as follows:\n\n$$\n\\overset{―}{ST}\n$$\n\nWe draw a horizontal line $(\\overset{―}{})$ with no arrows above our letters to denote that the line does not extend forever." 13194139534537 17592186045417 true] [17592186424815 1068 #edb/ref 17592186424800 13194139534537 17592186045417 true] [17592186424815 1069 "q-43595" 13194139534537 17592186045417 true] [17592186424815 1070 #edb/ref 17592186045486 13194139534537 17592186045417 true] [17592186424815 1071 "Which of the following points lies  in the fourth quadrant?" 13194139534537 17592186045417 true] [17592186424815 1072 #uuid "2919c042-14cc-564a-b488-e11edad346eb" 13194139534537 17592186045417 true] [17592186424815 1074 "- The point $(2,-2)$ is below and to the right of the origin, so it is in the fourth quadrant $✓$\n\n- The point $(1,1)$ is above and to the right of the origin, so it is in the first quadrant $\\times $\n\n- The point $(2,3)$ is above and to the right of the origin, so it is in the first quadrant $\\times $\n\n- The point $(-1,-1)$ is below and to the left of the origin, so it is in the third quadrant $\\times $\n\n- The point $(-2,2)$ is above and to the left of the origin, so it is in the second quadrant $\\times $" 13194139534537 17592186045417 true] [17592186424816 1068 #edb/ref 17592186424803 13194139534537 17592186045417 true] [17592186424816 1069 "q-43156" 13194139534537 17592186045417 true] [17592186424816 1070 #edb/ref 17592186045486 13194139534537 17592186045417 true] [17592186424816 1071 "Which of the following is undefined?\n\nI. $0\\cdot 0$\n\nII. $\\frac{2}{0}$\n\nIII. $\\frac{0}{-1}$" 13194139534537 17592186045417 true] [17592186424816 1072 #uuid "3913baef-cd96-5f27-bb8b-fbabac946e82" 13194139534537 17592186045417 true] [17592186424816 1074 "We consider each point individually:\n\n- Multiplying any number by zero always gives zero. Therefore, $0\\cdot 0=0.$\n\n- We cannot divide any number by zero. Therefore, $\\frac{2}{0}=2÷0$ is undefined.\n\n- Zero divided by any number (other than zero) equals zero. Therefore, $\\frac{0}{-1}=0÷(-1)=0.$\n\nTherefore, the correct answer is \"II only.\"" 13194139534537 17592186045417 true] [17592186424817 1068 #edb/ref 17592186424792 13194139534537 17592186045417 true] [17592186424817 1069 "q-67037" 13194139534537 17592186045417 true] [17592186424817 1070 #edb/ref 17592186045485 13194139534537 17592186045417 true] [17592186424817 1071 "Translate the following phrase into an algebraic expression: \"$2$ less than a number.\"" 13194139534537 17592186045417 true] [17592186424817 1072 #uuid "3e293dd9-81d5-5834-9d60-552159e9c226" 13194139534537 17592186045417 true] [17592186424817 1074 "If we denote our number by $b$, then the phrase can be written as\n\n$$\nb-2.\n$$" 13194139534537 17592186045417 true] [17592186424818 1068 #edb/ref 17592186424801 13194139534537 17592186045417 true] [17592186424818 1069 "q-57929" 13194139534537 17592186045417 true] [17592186424818 1070 #edb/ref 17592186045487 13194139534537 17592186045417 true] [17592186424818 1071 "$6\\,\\frac{7}{8}-1\\,\\frac{5}{6}=$" 13194139534537 17592186045417 true] [17592186424818 1072 #uuid "4123159f-01d7-597f-9386-b9f6aae3c918" 13194139534537 17592186045417 true] [17592186424818 1074 "To subtract two mixed numbers, we subtract whole numbers from whole numbers and fractions from fractions. \n\nSubtracting the whole numbers, we get $6-1=5.$\n\nNow we subtract the fractions:\n\n$$\n\\frac{7}{8}-\\frac{5}{6}\n$$\n\nTo subtract the fractions, we need to find the least common multiple of the denominators ($8$ and $6$).\n\n- Multiples of 8: $\\,8,16,24,…$\n\n- Multiples of 6: $\\,6,12,18,24,…$\n\nTherefore, the least common denominator of $8$ and $6$ is $24.$\n\n- To put $\\frac{7}{8}$ over a denominator of $24,$ we multiply the numerator and denominator by $3$:\n\n$$\n\\frac{7}{8}=\\frac{7\\times 3}{8\\times 3}=\\frac{21}{24}\n$$\n\n- To put $\\frac{5}{6}$ over a denominator of $24,$ we multiply the numerator and denominator by $4$:\n\n$$\n\\frac{5}{6}=\\frac{5\\times 4}{6\\times 4}=\\frac{20}{24}\n$$\n\nWe can now subtract the fractions. We keep the denominator the same, and we subtract the numerators:\n\n$$\n\\begin{aligned}\\frac{7}{8}-\\frac{5}{6}=\\frac{21}{24}-\\frac{20}{24}=\\frac{1}{24}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n6\\,\\frac{7}{8}-1\\,\\frac{5}{6}=5\\,\\frac{1}{24}\n$$" 13194139534537 17592186045417 true] [17592186424819 1068 #edb/ref 17592186424784 13194139534537 17592186045417 true] [17592186424819 1069 "q-41363" 13194139534537 17592186045417 true] [17592186424819 1070 #edb/ref 17592186045486 13194139534537 17592186045417 true] [17592186424819 1071 "${(-\\frac{2}{3})}^{3}=$" 13194139534537 17592186045417 true] [17592186424819 1072 #uuid "4dd6b555-5ecc-595c-aed6-3fa1e6dff4c8" 13194139534537 17592186045417 true] [17592186424819 1074 "To work out ${(-\\frac{2}{3})}^{3},$ we multiply $-\\frac{2}{3}$ by itself and then multiply the result by $-\\frac{2}{3}$ again:\n\n$$\n\\begin{aligned}{(-\\frac{2}{3})}^{3} & =(-\\frac{2}{3})\\cdot (-\\frac{2}{3})\\cdot (-\\frac{2}{3}) \\\\  & =-\\frac{2\\cdot 2\\cdot 2}{3\\cdot 3\\cdot 3} \\\\  & =-\\frac{8}{27}\\end{aligned}\n$$" 13194139534537 17592186045417 true] [17592186424820 1068 #edb/ref 17592186424782 13194139534537 17592186045417 true] [17592186424820 1069 "q-108513" 13194139534537 17592186045417 true] [17592186424820 1070 #edb/ref 17592186045487 13194139534537 17592186045417 true] [17592186424820 1071 "Translate the following phrase into an algebraic expression: \"The quotient of a number and two less than that number.\"" 13194139534537 17592186045417 true] [17592186424820 1072 #uuid "5d05e800-2322-572d-b914-4605eb307837" 13194139534537 17592186045417 true] [17592186424820 1074 "If we denote our number by $x$, then \"two less than that number\" can be written as\n\n$$\nx-2.\n$$\n\nSo, the whole phrase can be written as \n\n$$\n\\frac{x}{x-2}.\n$$" 13194139534537 17592186045417 true] [17592186424821 1068 #edb/ref 17592186424802 13194139534537 17592186045417 true] [17592186424821 1069 "q-52571" 13194139534537 17592186045417 true] [17592186424821 1070 #edb/ref 17592186045486 13194139534537 17592186045417 true] [17592186424821 1071 "![](images/f1/f1c2ae86cd726df7a493351ad0cdb29fdb9767db75c25b432c1832f97865e1dc.png)\n\nFrom the diagram above, which of the following statements is true?" 13194139534537 17592186045417 true] [17592186424821 1072 #uuid "6d3b19cb-cf63-59ba-9591-d8e9da347a6b" 13194139534537 17592186045417 true] [17592186424821 1074 "Suppose $a$ and $b$ are two lines. Then,\n\n- $a∥b$ means $a$ and $b$ are parallel, and\n\n- $a⊥b$ means $a$ and $b$ are perpendicular.\n\nIn the given diagram, there are two pairs of perpendicular lines:\n\n- $q$ is perpendicular to $r,$ which we write as $q⊥r$\n\n- $q$ is perpendicular to $s,$ which we write as $q⊥s.$\n\n![](images/06/063ecc105da75d9ba1b3c242476f1353dec82ca9ec13df48f4f480f5f490cb94.png)\n\nTherefore, the correct statement is $q⊥r$ and $q⊥s.$" 13194139534537 17592186045417 true] [17592186424822 1068 #edb/ref 17592186424797 13194139534537 17592186045417 true] [17592186424822 1069 "q-136486" 13194139534537 17592186045417 true] [17592186424822 1070 #edb/ref 17592186045486 13194139534537 17592186045417 true] [17592186424822 1071 "$∣-9.2\\,∣=$" 13194139534537 17592186045417 true] [17592186424822 1072 #uuid "7e488715-4e78-55fa-9093-dc4d45898e40" 13194139534537 17592186045417 true] [17592186424822 1074 "To find the absolute value of $-9.2,$ we simply drop the negative sign:\n\n$$\n∣-9.2\\,∣=9.2\n$$\n\nThe absolute value of a number gives the distance between the number and zero on a number line.\n\n![](images/73/73e7a7cda9a920826aa6314b99689525de7c8dadc2a937adb87f5b4fd5042e4b.png)" 13194139534537 17592186045417 true] [17592186424823 1068 #edb/ref 17592186424789 13194139534537 17592186045417 true] [17592186424823 1069 "q-92949" 13194139534537 17592186045417 true] [17592186424823 1070 #edb/ref 17592186045487 13194139534537 17592186045417 true] [17592186424823 1071 "What is missing in the following sentence?\n\nIn a music school, the ratio of students in the violin class to students in the piano class is $32:4,$ so there are $\\boxed{}$ students in the violin class for each student in the piano class." 13194139534537 17592186045417 true] [17592186424823 1072 #uuid "7fb16d63-026a-5791-8719-a48e4a4e389e" 13194139534537 17592186045417 true] [17592186424823 1074 "We can rewrite the ratio $32:4$ as the following fraction:\n\n$$\n\\frac{32}{4}\n$$\n\nWe can simplify the fraction by dividing the numerator and denominator by $4:$\n\n$$\n\\frac{32}{4}=\\frac{32÷4}{4÷4}=\\frac{8}{1}=8\n$$\n\nThis means that there are $8$ students in the violin class for each student in the piano class." 13194139534537 17592186045417 true] [17592186424824 1068 #edb/ref 17592186424777 13194139534537 17592186045417 true] [17592186424824 1069 "q-99463" 13194139534537 17592186045417 true] [17592186424824 1070 #edb/ref 17592186045485 13194139534537 17592186045417 true] [17592186424824 1071 "$(-5)\\cdot (3.3)=$" 13194139534537 17592186045417 true] [17592186424824 1072 #uuid "8d1edec4-291f-530b-ae4b-c5263dbe2c85" 13194139534537 17592186045417 true] [17592186424824 1074 "We have a product of a negative number $(-5)$ and a positive number $(3.3).$ So the product will be negative:\n\n$$\n(-5)\\cdot 3.3=-\\boxed{}\n$$\n\nNow, to compute the number that goes in the box, we multiply $-5$ by $3.3$ without any signs: $5\\cdot 3.3=16.5.$ So, we get\n\n$$\n(-5)\\cdot 3.3=-16.5.\n$$" 13194139534537 17592186045417 true] [17592186424825 1068 #edb/ref 17592186424786 13194139534537 17592186045417 true] [17592186424825 1069 "q-99858" 13194139534537 17592186045417 true] [17592186424825 1070 #edb/ref 17592186045487 13194139534537 17592186045417 true] [17592186424825 1071 "What is the reciprocal of $3\\,\\frac{2}{5}?$" 13194139534537 17592186045417 true] [17592186424825 1072 #uuid "905949ae-4813-5860-b334-182f5d44f611" 13194139534537 17592186045417 true] [17592186424825 1074 "First, we convert the given mixed number to an improper fraction:\n\n$$\n3\\,\\frac{2}{5}=\\frac{(3\\times 5)+2}{5}=\\frac{17}{5}\n$$\n\nTo find the reciprocal of a fraction, we switch the numerator and the denominator:\n\n$$\n\\frac{17}{5}\\,\\to \\,\\frac{5}{17}\n$$\n\nSo the reciprocal of $\\frac{17}{5}$ is $\\frac{5}{17}.$" 13194139534537 17592186045417 true] [17592186424826 1068 #edb/ref 17592186424788 13194139534537 17592186045417 true] [17592186424826 1069 "q-136916" 13194139534537 17592186045417 true] [17592186424826 1070 #edb/ref 17592186045487 13194139534537 17592186045417 true] [17592186424826 1071 "$\\frac{15}{8}\\times \\frac{24}{5}=$" 13194139534537 17592186045417 true] [17592186424826 1072 #uuid "b89690ae-8c80-573d-99a2-301f29ba824c" 13194139534537 17592186045417 true] [17592186424826 1074 "Interpreting the fractions as division, we get\n\n$$\n(15\\,÷\\,8)\\times (24\\,÷\\,5).\n$$\n\n \n\nSince our expression contains multiplication and division only, we can create an equivalent expression by swapping the $÷\\,8$ and $÷\\,5:$\n\n$$\n(15\\,÷\\,5)\\times (24\\,÷\\,8)\n$$\n\n \n\nInterpreting the divisions as fractions, we get\n\n$$\n\\frac{15}{5}\\times \\frac{24}{8}.\n$$\n\nCarrying out the divisions, we arrive at\n\n$$\n\\begin{aligned}{{\\frac{15}{5}}_{⏟}}_{3}\\times {{\\frac{24}{8}}_{⏟}}_{3}=3\\times 3=9.\\end{aligned}\n$$" 13194139534537 17592186045417 true] [17592186424827 1068 #edb/ref 17592186424795 13194139534537 17592186045417 true] [17592186424827 1069 "q-71254" 13194139534537 17592186045417 true] [17592186424827 1070 #edb/ref 17592186045486 13194139534537 17592186045417 true] [17592186424827 1071 "Use a visual fraction model to find the value of $3+\\frac{2}{7}$ as an improper fraction." 13194139534537 17592186045417 true] [17592186424827 1072 #uuid "bee69b89-dd1d-5978-a866-55d032eb0cd5" 13194139534537 17592186045417 true] [17592186424827 1074 "Writing $3+\\frac{2}{7}$ as a visual fraction model, we get the following:\n\n![](images/97/9797ccbc74bee1628f6c056415b831ee315d1e5d5b6c01496abdcc7b62537b2b.png)\n\nThe shape on the right is split into $7$ equal parts. We can split the first, second, and third shapes into $7$ equal parts as follows:\n\n![](images/3b/3b8c180326206b70caf96caef6d560ac57621a61a5bd3fc85d9e3bb1e7dfebf8.png)\n\nThere are $7+7+7+2=23$ shaded parts in total. Therefore, their sum is $\\frac{23}{7}.$" 13194139534537 17592186045417 true] [17592186424828 1068 #edb/ref 17592186424806 13194139534537 17592186045417 true] [17592186424828 1069 "q-60095" 13194139534537 17592186045417 true] [17592186424828 1070 #edb/ref 17592186045487 13194139534537 17592186045417 true] [17592186424828 1071 "The ratio of vanilla flavored cakes to total cakes in a bakery is $5:9.$ What is the meaning of this ratio?" 13194139534537 17592186045417 true] [17592186424828 1072 #uuid "c904b7d0-fa86-585f-90ce-acc0a098264d" 13194139534537 17592186045417 true] [17592186424828 1074 "If the ratio of vanilla flavored cakes to total cakes is $5:9,$ it means that there are $5$ vanilla flavored cakes for every $9$ cakes in total.\n\nAnother way of writing this is to say that \"out of every $9$ cakes in the bakery, $5$ of them are vanilla flavored cakes.\"" 13194139534537 17592186045417 true] [17592186424829 1068 #edb/ref 17592186424796 13194139534537 17592186045417 true] [17592186424829 1069 "q-99327" 13194139534537 17592186045417 true] [17592186424829 1070 #edb/ref 17592186045487 13194139534537 17592186045417 true] [17592186424829 1071 "Which of the following statements are true?\n\nI. $-\\frac{1}{9}$ is a natural number\n\nII. $-\\frac{1}{9}$ is an integer\n\nIII. $-\\frac{1}{9}$ is a rational number" 13194139534537 17592186045417 true] [17592186424829 1072 #uuid "d38c8439-616e-58d4-9fa5-c5876ae08e79" 13194139534537 17592186045417 true] [17592186424829 1074 "Let's recall our definitions.\n\n- The natural numbers consist of all positive whole numbers: $1,\\,2,\\,3,\\,4,\\,5,…$\n\n- The integers consist of all of the positive and negative whole numbers, and zero: $…,-3,\\,-2,\\,-1,\\,0,\\,1,\\,2,\\,3,…$\n\n- The rationals consist of all numbers that can be written as the ratio of two integers.\n\nNow, let's go through each number in turn.\n\n- $-\\frac{1}{9}$ is not a natural number.\n\n- $-\\frac{1}{9}$ is not an integer.\n\n- $-\\frac{1}{9}$ is a rational number because it can be written as $\\frac{(-1)}{9}.$\n\nTherefore, the correct answer is \"III only.\"" 13194139534537 17592186045417 true] [17592186424830 1068 #edb/ref 17592186424798 13194139534537 17592186045417 true] [17592186424830 1068 #edb/ref 17592186424799 13194139534537 17592186045417 true] [17592186424830 1069 "q-350289" 13194139534537 17592186045417 true] [17592186424830 1070 #edb/ref 17592186045485 13194139534537 17592186045417 true] [17592186424830 1071 "Mina and Sora have the same number of songs in a playlist. A total of $58%$ of Mina's songs are from the 2000s, while $\\frac{13}{20}$ of Sora's songs are from the 2000s. Select the options that make the statements below true.\n\n$\\,$\nA total of \n{{field-1}}\nof Sora's songs are from the 2000s. \n\n$\\,$\nTherefore, she has \n{{field-2}}\nsongs from the 2000s compared to Mina." 13194139534537 17592186045417 true] [17592186424830 1072 #uuid "ddb0b2b0-9c4c-5863-9ab3-ca3699a76416" 13194139534537 17592186045417 true] [17592186424830 1074 "We need to compare $\\frac{13}{20}$ with $58%.$ We can do this by writing $\\frac{13}{20}$ as a percent.\n\nFirst, we write $\\frac{13}{20}$ as an equivalent fraction with $100$ as the denominator:\n\n$$\n\\frac{13}{20}=\\frac{13\\times 5}{20\\times 5}=\\frac{65}{100}\n$$\n\nNow, we can write this fraction as a percentage:\n\n$$\n\\frac{65}{100}=65%\n$$\n\nSince $65%>58%,$ we have the following:\n\n- A total of $65%$ of Sora's songs are from the 2000s.\n\n- Therefore, she has $\\text{more}$ songs from the 2000s compared to Mina." 13194139534537 17592186045417 true] [17592186424831 1068 #edb/ref 17592186424783 13194139534537 17592186045417 true] [17592186424831 1069 "q-137077" 13194139534537 17592186045417 true] [17592186424831 1070 #edb/ref 17592186045487 13194139534537 17592186045417 true] [17592186424831 1071 "$6\\times \\frac{3}{8}=$" 13194139534537 17592186045417 true] [17592186424831 1072 #uuid "ddbc93fd-d822-55bd-bf23-39217e02eba2" 13194139534537 17592186045417 true] [17592186424831 1074 "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n\\frac{6\\times 3}{8}=\\frac{18}{8}\n$$\n\nWe then simplify:\n\n$$\n\\frac{18}{8}=\\frac{18÷2}{8÷2}=\\frac{9}{4}\n$$\n\nFinally, we then convert $\\frac{9}{4}$ to a mixed number:\n\n$$\n9÷4=2\\,\\text{R}1=2\\,\\frac{1}{4}\n$$" 13194139534537 17592186045417 true] [17592186424832 1068 #edb/ref 17592186424794 13194139534537 17592186045417 true] [17592186424832 1069 "q-151066" 13194139534537 17592186045417 true] [17592186424832 1070 #edb/ref 17592186045485 13194139534537 17592186045417 true] [17592186424832 1071 "Which of the following numbers is prime?" 13194139534537 17592186045417 true] [17592186424832 1072 #uuid "e8c5d328-cf41-5276-9927-daf5b992b1df" 13194139534537 17592186045417 true] [17592186424832 1074 "A prime number is a positive whole number with exactly two distinct whole number factors: itself and $1.$\n\nThe only number that satisfies this definition is $19.$ It has only two factors: $1$ and $19.$\n\n$$\n\\begin{aligned}19 & =1\\times 19 \\\\  & =19\\times 1\\end{aligned}\n$$\n\nAll the other given numbers have at least one factor distinct from itself, and $1:$\n\n- $15$ has $3$ and $5$ as factors:\n\n$$\n15=3\\times 5\n$$\n\n- $6$ has $2$ and $3$ as factors:\n\n$$\n6=2\\times 3\n$$\n\n- $8$ has $2$ and $4$ as factors:\n\n$$\n8=2\\times 4\n$$\n\n- $18$ has $2$ and $9$ as factors:\n\n$$\n18=2\\times 9\n$$\n\nTherefore, the correct answer is $19.$" 13194139534537 17592186045417 true] [17592186424833 1068 #edb/ref 17592186424781 13194139534537 17592186045417 true] [17592186424833 1069 "q-150253" 13194139534537 17592186045417 true] [17592186424833 1070 #edb/ref 17592186045487 13194139534537 17592186045417 true] [17592186424833 1071 "![](images/4e/4e27e66c07e3271b2f03c8c275bc6deba48185e0f0f0d107f2daeece05161100.png)\n\nUse the model above to calculate $3\\times \\frac{1}{4}.$" 13194139534537 17592186045417 true] [17592186424833 1072 #uuid "eef69fb5-3ff0-5bf1-a2d4-52d92f4d7c61" 13194139534537 17592186045417 true] [17592186424833 1074 "Since we need to multiply $\\frac{1}{4}$ by $3$, we repeat the fraction model $3$ times, as shown below.\n\n![](images/52/52b2f58e97058deb1cbe8c01cd1ab430261c3a9f8f374a6cb650ebf0931553e9.png)\n\n \n\nThere are $3\\times 1=3$ shaded pieces in total. Therefore, \n\n$$\n3\\times \\frac{1}{4}=\\frac{3}{4}.\n$$" 13194139534537 17592186045417 true] [17592186424834 1068 #edb/ref 17592186424793 13194139534537 17592186045417 true] [17592186424834 1069 "q-131860" 13194139534537 17592186045417 true] [17592186424834 1070 #edb/ref 17592186045485 13194139534537 17592186045417 true] [17592186424834 1071 "Which digits, when inserted into the blank, make the number $123\\,321\\,87◻$ divisible by $4?$\n\nI. $2$\n\nII. $4$\n\nIII. $8$" 13194139534537 17592186045417 true] [17592186424834 1072 #uuid "ef2c41de-4b26-57f5-bd27-cd0dbe211bfd" 13194139534537 17592186045417 true] [17592186424834 1074 "A number is divisible by $4$ if the last two digits form a number that is divisible by $4.$\n\nThe last two digits of the number $123\\,321\\,87◻$ are $7◻.$\n\n- If $2$ is substituted into the blank, then the last two digits are $72,$ which is indeed divisible by $4.$\n\n- If $4$ is substituted into the blank, then the last two digits are $74,$ which is *not* divisible by $4.$\n\n- If $8$ is substituted into the blank, then the last two digits are $78,$ which is *not* divisible by $4.$\n\nTherefore, the correct answer is \"I only.\"" 13194139534537 17592186045417 true] [17592186424835 1068 #edb/ref 17592186424780 13194139534537 17592186045417 true] [17592186424835 1069 "q-60613" 13194139534537 17592186045417 true] [17592186424835 1070 #edb/ref 17592186045487 13194139534537 17592186045417 true] [17592186424835 1071 "Liza can read $1\\,\\frac{1}{4}$ pages of a book in a minute. How many pages would she read if she read for $3\\,\\frac{1}{3}$ minutes?" 13194139534537 17592186045417 true] [17592186424835 1072 #uuid "f3718652-c7d4-58dc-86d1-2efd82a282a6" 13194139534537 17592186045417 true] [17592186424835 1074 "To determine the number of pages Liza would have read in $3\\,\\frac{1}{3}$ minutes, we need to calculate $1\\,\\frac{1}{4}\\times 3\\,\\frac{1}{3}.$     \n\nFirst, we write  $1\\,\\frac{1}{4}$ as an improper fraction:\n\n$$\n1\\,\\frac{1}{4}=\\frac{(1\\times 4)+1}{4}=\\frac{5}{4}\n$$\n\nWe also write $3\\,\\frac{1}{3}$ as an improper fraction:\n\n$$\n3\\,\\frac{1}{3}=\\frac{(3\\times 3)+1}{3}=\\frac{10}{3}\n$$\n\nSo now, we need to solve the following multiplication problem:\n\n$$\n\\frac{5}{4}\\times \\frac{10}{3}\n$$\n\nNotice that the first fraction's denominator ($4$) and the second fraction's numerator ($10$) have a common factor of $2.$ \n\nTherefore, we can simplify our problem by swapping the denominators first and then multiplying the resulting fractions:\n\n$$\n\\begin{aligned}\\frac{5}{4}\\times \\frac{10}{3} & =\\frac{5}{3}\\times \\frac{10}{4} \\\\  & =\\frac{5}{3}\\times \\frac{5}{2} \\\\  & =\\frac{5\\times 5}{3\\times 2} \\\\  & =\\frac{25}{6}\\end{aligned}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{25}{6}=4\\,\\text{R}\\,1=4\\,\\frac{1}{6}\n$$\n\nSo, Liza would have read $4\\,\\frac{1}{6}$ pages." 13194139534537 17592186045417 true] [17592186424836 1062 #uuid "06dd2778-6877-5905-9f92-f4b181c7ce33" 13194139534537 17592186045417 true] [17592186424836 1063 #edb/ref 17592186424827 13194139534537 17592186045417 true] [17592186424837 1062 #uuid "09fc09aa-a7db-5dcc-96cc-70306cf4080a" 13194139534537 17592186045417 true] [17592186424837 1063 #edb/ref 17592186424834 13194139534537 17592186045417 true] [17592186424838 1062 #uuid "15627a4c-a38f-5f6a-972c-cfb38f874232" 13194139534537 17592186045417 true] [17592186424838 1063 #edb/ref 17592186424818 13194139534537 17592186045417 true] [17592186424839 1062 #uuid "27d317f1-eb32-5dbd-8228-05c2ce9686a6" 13194139534537 17592186045417 true] [17592186424839 1063 #edb/ref 17592186424823 13194139534537 17592186045417 true] [17592186424840 1062 #uuid "338bc011-37c0-5e0c-8b1f-f9ec87b6fbb5" 13194139534537 17592186045417 true] [17592186424840 1063 #edb/ref 17592186424808 13194139534537 17592186045417 true] [17592186424841 1062 #uuid "3b05661e-ad0e-5aa2-9cdf-5b84c8280cab" 13194139534537 17592186045417 true] [17592186424841 1063 #edb/ref 17592186424833 13194139534537 17592186045417 true] [17592186424842 1062 #uuid "4a6bcdd3-808d-5a0d-b924-9044a382847b" 13194139534537 17592186045417 true] [17592186424842 1063 #edb/ref 17592186424816 13194139534537 17592186045417 true] [17592186424843 1062 #uuid "4b07e65e-6075-5d2c-960e-cdf38755c695" 13194139534537 17592186045417 true] [17592186424843 1063 #edb/ref 17592186424819 13194139534537 17592186045417 true] [17592186424844 1062 #uuid "580ef556-5ba2-534c-b639-0134a51bc9e3" 13194139534537 17592186045417 true] [17592186424844 1063 #edb/ref 17592186424832 13194139534537 17592186045417 true] [17592186424845 1062 #uuid "5b676956-210b-53d6-bba9-ec1dd3f76e59" 13194139534537 17592186045417 true] [17592186424845 1063 #edb/ref 17592186424831 13194139534537 17592186045417 true] [17592186424846 1062 #uuid "5e379483-c02c-51e5-9bcd-c0db5c194031" 13194139534537 17592186045417 true] [17592186424846 1063 #edb/ref 17592186424807 13194139534537 17592186045417 true] [17592186424847 1062 #uuid "611e1f25-9593-5898-9bc2-d0405870b526" 13194139534537 17592186045417 true] [17592186424847 1063 #edb/ref 17592186424811 13194139534537 17592186045417 true] [17592186424848 1062 #uuid "6481e327-7cd0-5f1b-af8d-b5225d0dccc4" 13194139534537 17592186045417 true] [17592186424848 1063 #edb/ref