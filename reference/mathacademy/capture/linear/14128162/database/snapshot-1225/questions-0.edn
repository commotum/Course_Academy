:answer/id #uuid "204e3e89-a7a2-5ebb-901f-17ce71c405c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186424652} :answer-field/id #uuid "8a01afe5-a638-50a3-925d-1b1cf232a553" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424794}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e8c5d328-cf41-5276-9927-daf5b992b1df" :question/math-academy-id "q-151066" :question/problem "Which of the following numbers is prime?" :question/worked-solution "A prime number is a positive whole number with exactly two distinct whole number factors: itself and $1.$\n\nThe only number that satisfies this definition is $19.$ It has only two factors: $1$ and $19.$\n\n$$\n\\begin{aligned}19 & =1\\times 19 \\\\  & =19\\times 1\\end{aligned}\n$$\n\nAll the other given numbers have at least one factor distinct from itself, and $1:$\n\n- $15$ has $3$ and $5$ as factors:\n\n$$\n15=3\\times 5\n$$\n\n- $6$ has $2$ and $3$ as factors:\n\n$$\n6=2\\times 3\n$$\n\n- $8$ has $2$ and $4$ as factors:\n\n$$\n8=2\\times 4\n$$\n\n- $18$ has $2$ and $9$ as factors:\n\n$$\n18=2\\times 9\n$$\n\nTherefore, the correct answer is $19.$"}] [{:db/id #edb/ref 17592186180127 :knowledge-point/_questions [{:db/id #edb/ref 17592186179816 :knowledge-point/id #uuid "66bfa36e-be32-5c64-86c1-b17e8e670e04" :knowledge-point/title "Translating Between Phrases and Algebraic Expressions Containing Division"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4910f68-8aac-5e71-bcd5-b7efd51b3338" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{1}" :db/id #edb/ref 17592186178395} {:answer/id #uuid "053d2ef1-b397-50cf-9163-7bd05227394e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{x-1}" :db/id #edb/ref 17592186424632} {:answer/id #uuid "075abfec-b969-5c83-96af-c75cd24b3719" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-1" :db/id #edb/ref 17592186424634} {:answer/id #uuid "836c641b-4f45-56a6-9294-a1ebe96163db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+1}{x}" :db/id #edb/ref 17592186424709} {:answer/id #uuid "dcf7f2f1-37e8-50ac-ad9f-3df58eec3451" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-1}{x}" :db/id #edb/ref 17592186424752}] :answer-field/correct {:answer/id #uuid "053d2ef1-b397-50cf-9163-7bd05227394e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{x-1}" :db/id #edb/ref 17592186424632} :answer-field/id #uuid "4c3846fd-4837-5e23-8b1b-cfd0f2851058" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186178391}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "707758b3-8efc-56c2-97b0-ced821d3d5f1" :question/math-academy-id "q-21262" :question/problem "Translate the following phrase into an algebraic expression: \"The quotient of a number and one fewer than that number.\"" :question/worked-solution "If we denote our number by $x$, then \"one fewer than that number\" can be written as\n\n$$\nx-1.\n$$\n\nSo, the whole phrase can be written as \n\n$$\n\\frac{x}{x-1}.\n$$"}] [{:db/id #edb/ref 17592186424830 :knowledge-point/_questions [{:db/id #edb/ref 17592186147545 :knowledge-point/id #uuid "9d39373d-ba41-53aa-8119-4ecf5138a50a" :knowledge-point/title "Comparing Fractions and Percents: Word Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3762bada-eedf-5b3a-8867-ca77aa7d4d27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "fewer" :db/id #