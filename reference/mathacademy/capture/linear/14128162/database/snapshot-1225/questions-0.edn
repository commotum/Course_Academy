#{[{:db/id #edb/ref 17592186424820 :knowledge-point/_questions [{:db/id #edb/ref 17592186179816 :knowledge-point/id #uuid "66bfa36e-be32-5c64-86c1-b17e8e670e04" :knowledge-point/title "Translating Between Phrases and Algebraic Expressions Containing Division"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "009fd505-9eac-57b5-913b-a45212139e66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{2}" :db/id #edb/ref 17592186424627} {:answer/id #uuid "0f2f6087-810a-5657-8aa0-16bcfc8ec0c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x}{2}" :db/id #edb/ref 17592186424643} {:answer/id #uuid "10fc0f7a-c365-5b8e-8f19-445298fad3ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{x-2}" :db/id #edb/ref 17592186424644} {:answer/id #uuid "3416bee3-747c-50a7-9c2c-09ced8e9b9d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{2}-x" :db/id #edb/ref 17592186424661} {:answer/id #uuid "539d8f81-1c7a-5709-a029-c622d9abc04e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-2}{x}" :db/id #edb/ref 17592186424677}] :answer-field/correct {:answer/id #uuid "10fc0f7a-c365-5b8e-8f19-445298fad3ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{x-2}" :db/id #edb/ref 17592186424644} :answer-field/id #uuid "310b870a-10ad-578d-abe3-261411de2946" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424782}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5d05e800-2322-572d-b914-4605eb307837" :question/math-academy-id "q-108513" :question/problem "Translate the following phrase into an algebraic expression: \"The quotient of a number and two less than that number.\"" :question/worked-solution "If we denote our number by $x$, then \"two less than that number\" can be written as\n\n$$\nx-2.\n$$\n\nSo, the whole phrase can be written as \n\n$$\n\\frac{x}{x-2}.\n$$"}] [{:db/id #edb/ref 17592186064485 :knowledge-point/_questions [{:db/id #edb/ref 17592186064256 :knowledge-point/id #uuid "f1c51da0-7569-50c0-b405-c74419d47ef3" :knowledge-point/title "Subtracting a Positive Number From a Non-Negative Number With Larger Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "875bc176-21b8-52ff-b1c9-b9aa8edf15f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186061141} {:answer/id #uuid "d64c9ad6-22e3-5e80-9811-3cf111469030" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186061142} {:answer/id #uuid "0a2c437c-072a-5a93-ac62-dd397b96cb2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186061143} {:answer/id #uuid "555f2600-120e-58d3-be2d-cd559c191573" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-34" :db/id #edb/ref 17592186061144} {:answer/id #uuid "69b59bfa-fae8-5186-8a08-44b1bf10b231" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-44" :db/id #edb/ref 17592186061145}] :answer-field/correct {:answer/id #uuid "555f2600-120e-58d3-be2d-cd559c191573" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-34" :db/id #edb/ref 17592186061144} :answer-field/id #uuid "0014c7b8-55e9-5ade-bc81-0710ccef62ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186061140}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "837916d9-16cd-56fe-84fd-2eb414bab43b" :question/math-academy-id "q-128109" :question/problem "$69-103=$" :question/worked-solution "Since $103$ is larger than $69,$ the answer will be negative.\n\nWe start by solving an easier problem:\n\n$$\n103-69\n$$\n\nNext, we carry out the subtraction:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\begin{aligned}\\,\\,\\,0\\end{aligned} & \\,\\,\\,\\begin{aligned}\\,\\,\\,9\\end{aligned} & \\,\\,\\,\\begin{aligned}\\,\\,\\,13\\end{aligned} \\\\  &  & \\,\\,\\,1\\,\\,\\, & \\,\\,\\,0\\,\\,\\, & \\,\\,\\,3\\,\\,\\, \\\\ \\,\\,\\,\\,-\\,\\,\\,\\, &  &  & \\,\\,\\,6\\,\\,\\, & \\,\\,\\,9\\,\\,\\, \\\\  &  &  & \\,\\,\\,3\\,\\,\\, & \\,\\,\\,4\\,\\,\\,\\end{aligned}\n$$\n\nSo, we have\n\n$$\n103-69=34.\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n69-103=-34.\n$$"}] [{:db/id #edb/ref 17592186424834 :knowledge-point/_questions [{:db/id #edb/ref 17592186157307 :knowledge-point/id #uuid "a25bce44-98ca-54c6-a59f-b7508880d5ba" :knowledge-point/title "Determining Whether a Number is Divisible by 4"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "482c5dae-4d41-560e-9cce-646d022e2981" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186424670} {:answer/id #uuid "819e1052-6513-50b0-bd5c-5e10197a5eaa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186424708} {:answer/id #uuid "83bf1713-3353-59a3-b698-75b1396a3acb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186424711} {:answer/id #uuid "a7e28211-0c01-504c-9700-eb6226c25b1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186424730} {:answer/id #uuid "d8585b9e-3cc0-56bc-af72-b6f310e2d8f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186424750}] :answer-field/correct {:answer/id #uuid "d8585b9e-3cc0-56bc-af72-b6f310e2d8f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186424750} :answer-field/id #uuid "7c05dc84-ff51-5384-9b95-c62170ff697c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424793}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ef2c41de-4b26-57f5-bd27-cd0dbe211bfd" :question/math-academy-id "q-131860" :question/problem "Which digits, when inserted into the blank, make the number $123\\,321\\,87◻$ divisible by $4?$\n\nI. $2$\n\nII. $4$\n\nIII. $8$" :question/worked-solution "A number is divisible by $4$ if the last two digits form a number that is divisible by $4.$\n\nThe last two digits of the number $123\\,321\\,87◻$ are $7◻.$\n\n- If $2$ is substituted into the blank, then the last two digits are $72,$ which is indeed divisible by $4.$\n\n- If $4$ is substituted into the blank, then the last two digits are $74,$ which is *not* divisible by $4.$\n\n- If $8$ is substituted into the blank, then the last two digits are $78,$ which is *not* divisible by $4.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186424822 :knowledge-point/_questions [{:db/id #edb/ref 17592186138544 :knowledge-point/id #uuid "3391981c-d61d-509c-a8f3-db9598494e08" :knowledge-point/title "Finding the Absolute Value of a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e74441f-bec1-5f4b-ae7b-4cecd5ca404e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186424641} {:answer/id #uuid "319a8dc8-774d-5c8a-abee-47831d2bed03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186424660} {:answer/id #uuid "5349fdad-82c6-5d2e-aad2-4a9e9df69901" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.2" :db/id #edb/ref 17592186424676} {:answer/id #uuid "8be9d67d-6fac-5741-ba99-1311432fc9a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9.2" :db/id #edb/ref 17592186424714} {:answer/id #uuid "c3535040-d118-5836-9521-e513643c50a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186424742}] :answer-field/correct {:answer/id #uuid "5349fdad-82c6-5d2e-aad2-4a9e9df69901" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.2" :db/id #edb/ref 17592186424676} :answer-field/id #uuid "8ff08c2f-d684-5782-84c3-bf0672e7eb43" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424797}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7e488715-4e78-55fa-9093-dc4d45898e40" :question/math-academy-id "q-136486" :question/problem "$∣-9.2\\,∣=$" :question/worked-solution "To find the absolute value of $-9.2,$ we simply drop the negative sign:\n\n$$\n∣-9.2\\,∣=9.2\n$$\n\nThe absolute value of a number gives the distance between the number and zero on a number line.\n\n![](images/73/73e7a7cda9a920826aa6314b99689525de7c8dadc2a937adb87f5b4fd5042e4b.png)"}] [{:db/id #edb/ref 17592186424826 :knowledge-point/_questions [{:db/id #edb/ref 17592186147406 :knowledge-point/id #uuid "b8b307c7-79bc-58de-ab88-b0783857371b" :knowledge-point/title "Cases Where the Answer Is a Whole Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "077c81c4-2e53-51f1-a9bd-bd147e26c272" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186424635} {:answer/id #uuid "35591385-a9ca-5c99-b8b6-2cd819ca9c3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186424663} {:answer/id #uuid "931f6469-3499-5d76-bd2f-82f08bec183f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186424717} {:answer/id #uuid "a085b754-358f-5308-9a51-fc57c78a2409" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186424725} {:answer/id #uuid "ec177e43-15bb-5468-8263-7c011259e1a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186424764}] :answer-field/correct {:answer/id #uuid "931f6469-3499-5d76-bd2f-82f08bec183f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186424717} :answer-field/id #uuid "51c6e7c4-e97a-5ea3-85a6-0892f99515fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424788}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b89690ae-8c80-573d-99a2-301f29ba824c" :question/math-academy-id "q-136916" :question/problem "$\\frac{15}{8}\\times \\frac{24}{5}=$" :question/worked-solution "Interpreting the fractions as division, we get\n\n$$\n(15\\,÷\\,8)\\times (24\\,÷\\,5).\n$$\n\n \n\nSince our expression contains multiplication and division only, we can create an equivalent expression by swapping the $÷\\,8$ and $÷\\,5:$\n\n$$\n(15\\,÷\\,5)\\times (24\\,÷\\,8)\n$$\n\n \n\nInterpreting the divisions as fractions, we get\n\n$$\n\\frac{15}{5}\\times \\frac{24}{8}.\n$$\n\nCarrying out the divisions, we arrive at\n\n$$\n\\begin{aligned}{{\\frac{15}{5}}_{⏟}}_{3}\\times {{\\frac{24}{8}}_{⏟}}_{3}=3\\times 3=9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186424812 :knowledge-point/_questions [{:db/id #edb/ref 17592186147406 :knowledge-point/id #uuid "b8b307c7-79bc-58de-ab88-b0783857371b" :knowledge-point/title "Cases Where the Answer Is a Whole Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ce77225-6b10-59d8-94dc-a85b52516bce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186424673} {:answer/id #uuid "676b422f-6df7-54a6-9579-dc539d565f75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186424691} {:answer/id #uuid "9ebff1b7-7f0a-519b-88c2-d7e903032e27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186424724} {:answer/id #uuid "be90eeca-e1d6-5d59-9d9a-3e7963d6b69c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186424739} {:answer/id #uuid "e47c19c0-77ae-5ff2-9465-d0181a4fe8c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186424758}] :answer-field/correct {:answer/id #uuid "e47c19c0-77ae-5ff2-9465-d0181a4fe8c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186424758} :answer-field/id #uuid "0e429e22-014b-5313-ae56-7ef7411b61f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424778}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "152194d4-bfdf-57ac-b58d-963178280721" :question/math-academy-id "q-136918" :question/problem "$\\frac{32}{5}\\times \\frac{25}{8}=$" :question/worked-solution "Interpreting the fractions as division, we get\n\n$$\n(32\\,÷\\,5)\\times (25\\,÷\\,8).\n$$\n\n \n\nSince our expression contains multiplication and division only, we can create an equivalent expression by swapping the $÷\\,5$ and $÷\\,8:$\n\n$$\n(32\\,÷\\,8)\\times (25\\,÷\\,5)\n$$\n\n \n\nInterpreting the divisions as fractions, we get\n\n$$\n\\frac{32}{8}\\times \\frac{25}{5}.\n$$\n\nCarrying out the divisions, we arrive at\n\n$$\n\\begin{aligned}{{\\frac{32}{8}}_{⏟}}_{4}\\times {{\\frac{25}{5}}_{⏟}}_{5}=4\\times 5=20.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186424831 :knowledge-point/_questions [{:db/id #edb/ref 17592186142775 :knowledge-point/id #uuid "91037b32-189a-5ba9-ab0a-117f6255c496" :knowledge-point/title "Multiplying a Fraction by a Whole Number Resulting in a Mixed Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "258d9a05-6b3f-566b-b004-b327f032c9a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\frac{3}{4}" :db/id #edb/ref 17592186424654} {:answer/id #uuid "744eb43a-c904-5dec-bfd7-828d7d3fa96b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\frac{1}{2}" :db/id #edb/ref 17592186424698} {:answer/id #uuid "a1378277-8008-528c-8224-c16b1b6dd7f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,\\frac{1}{4}" :db/id #edb/ref 17592186424726} {:answer/id #uuid "e36385f1-9f78-58ef-9a0c-dffa72276704" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,\\frac{2}{3}" :db/id #edb/ref 17592186424755} {:answer/id #uuid "f9a022a2-74ce-59bd-85dc-e369f0ba27d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\frac{1}{4}" :db/id #edb/ref 17592186424773}] :answer-field/correct {:answer/id #uuid "f9a022a2-74ce-59bd-85dc-e369f0ba27d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\frac{1}{4}" :db/id #edb/ref 17592186424773} :answer-field/id #uuid "318d6479-dbee-56f4-86d5-38832d4a23df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424783}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ddbc93fd-d822-55bd-bf23-39217e02eba2" :question/math-academy-id "q-137077" :question/problem "$6\\times \\frac{3}{8}=$" :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n\\frac{6\\times 3}{8}=\\frac{18}{8}\n$$\n\nWe then simplify:\n\n$$\n\\frac{18}{8}=\\frac{18÷2}{8÷2}=\\frac{9}{4}\n$$\n\nFinally, we then convert $\\frac{9}{4}$ to a mixed number:\n\n$$\n9÷4=2\\,\\text{R}1=2\\,\\frac{1}{4}\n$$"}] [{:db/id #edb/ref 17592186424811 :knowledge-point/_questions [{:db/id #edb/ref 17592186147413 :knowledge-point/id #uuid "b7701af1-73f4-5da0-a029-1737dfbec48d" :knowledge-point/title "Evaluating Two-Digit Decimal Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04dc323b-3855-5701-bce8-78791ab1d56c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49.72" :db/id #edb/ref 17592186424631} {:answer/id #uuid "9909966f-06f0-584e-ba1a-60ae24edd70e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50.48" :db/id #edb/ref 17592186424720} {:answer/id #uuid "ae530de8-7965-5f20-9b26-cb84a5ce4853" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50.04" :db/id #edb/ref 17592186424733} {:answer/id #uuid "bd973cfc-77ca-57fc-bb29-255d3a6c2446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "51.84" :db/id #edb/ref 17592186424738} {:answer/id #uuid "e76fe111-1d20-599a-8c68-889178b96f00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "52.28" :db/id #edb/ref 17592186424760}] :answer-field/correct {:answer/id #uuid "bd973cfc-77ca-57fc-bb29-255d3a6c2446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "51.84" :db/id #edb/ref 17592186424738} :answer-field/id #uuid "7ba4d5f3-6c7c-5fbc-964e-6c0b058db14b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424791}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0faa0bbf-a97d-52f3-9471-5236871deb2a" :question/math-academy-id "q-138343" :question/problem "$(7.2)^{2}=$" :question/worked-solution "First, by writing the expression with multiplication signs, we get the following:\n\n$$\n\\begin{aligned}{(7.2)}^{2} & ={{7.2\\times 7.2}_{⏟}}_{2\\text{ times}}\\end{aligned}\n$$\n\nWe proceed by multiplying the two numbers just as we would with whole numbers:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{1} \\\\ \\boxed{}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\,\\end{aligned} & \\,\\, & \\begin{aligned}\\end{aligned} \\\\  & \\end{aligned}\n$$\n\nWe now count the number of decimal places in the $2$ factors.\n\nThere is $1$ decimal place in $7.2.$\nTherefore, the exponent $(7.2)^{2}$ will have $1\\times 2=2$ decimal places.\n\nSo, we take our value of $5184$ and add a decimal point to make a number with $2$ decimal places:\n\n$$\n51\\,\\overset{↓}{.}\\,\\,\\,\\,\\,{{84}_{⏟}}_{2\\text{ digits}}\n$$\n\nTherefore, we conclude that $(7.2)^{2}=51.84.$"}] [{:db/id #edb/ref 17592186424833 :knowledge-point/_questions [{:db/id #edb/ref 17592186073796 :knowledge-point/id #uuid "c1e7017e-45df-5adf-9ded-3f815b4f5673" :knowledge-point/title "Multiplying a Unit Fraction by a Whole Number Using Repeated Addition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39f0d521-f256-50a8-a26f-73d4141c8cfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186424667} {:answer/id #uuid "73fb0aeb-f769-5b46-aa10-c3a12b156472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186424697} {:answer/id #uuid "9c5caa2a-03d9-5879-b34a-25cfcbd79c21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186424722} {:answer/id #uuid "ab238fbb-89a8-5754-ac9e-eee2c45a67c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186424731} {:answer/id #uuid "bd67fe7f-248f-5b4a-9d77-f9a84212261b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186424737}] :answer-field/correct {:answer/id #uuid "39f0d521-f256-50a8-a26f-73d4141c8cfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186424667} :answer-field/id #uuid "2b43c170-e3ec-5df0-8bd3-d81bf0e07bee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424781}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eef69fb5-3ff0-5bf1-a2d4-52d92f4d7c61" :question/math-academy-id "q-150253" :question/problem "![](images/4e/4e27e66c07e3271b2f03c8c275bc6deba48185e0f0f0d107f2daeece05161100.png)\n\nUse the model above to calculate $3\\times \\frac{1}{4}.$" :question/worked-solution "Since we need to multiply $\\frac{1}{4}$ by $3$, we repeat the fraction model $3$ times, as shown below.\n\n![](images/52/52b2f58e97058deb1cbe8c01cd1ab430261c3a9f8f374a6cb650ebf0931553e9.png)\n\n \n\nThere are $3\\times 1=3$ shaded pieces in total. Therefore, \n\n$$\n3\\times \\frac{1}{4}=\\frac{3}{4}.\n$$"}] [{:db/id #edb/ref 17592186424814 :knowledge-point/_questions [{:db/id #edb/ref 17592186105858 :knowledge-point/id #uuid "d9e4943a-72d7-545e-b746-3a19ee6d3a83" :knowledge-point/title "Identifying Segments and Their Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11de9d1a-1a03-594a-a95f-199c1fd868a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "ST" :db/id #edb/ref 17592186424646} {:answer/id #uuid "1d927233-00c7-5f7c-9d67-ed12112594aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{⟷}{ST}" :db/id #edb/ref 17592186424649} {:answer/id #uuid "64c3dec6-ac49-5014-9ace-d64ccf964811" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{⟶}{ST}" :db/id #edb/ref 17592186424688} {:answer/id #uuid "892feade-f450-596d-9d33-df8c12666f35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{ST}" :db/id #edb/ref 17592186424713} {:answer/id #uuid "e4548e11-f9b3-572d-9132-f65b17594c6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{⟵}{ST}" :db/id #edb/ref 17592186424757}] :answer-field/correct {:answer/id #uuid "892feade-f450-596d-9d33-df8c12666f35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{ST}" :db/id #edb/ref 17592186424713} :answer-field/id #uuid "efc3478e-663c-513f-98e8-