#{[{:activity/first-step {:db/id #edb/ref 17592186184895} :activity/id #uuid "6d978d43-79f4-5343-ae3a-19ac497b011d" :activity/scope {:db/id #edb/ref 17592186048791 :topic/id #uuid "bf385fa3-be01-54aa-9187-dbf4f77958d8" :topic/math-academy-id 3762} :activity/steps [{:db/id #edb/ref 17592186184895 :step/content {:db/id #edb/ref 17592186185379 :tutorial/content "Multiplication of mixed fractions occurs regularly in real-life situations.\n\nFor example, suppose that a country road is\n\n$$\n5 \\, \\dfrac 12\\,\\textrm{km}\n$$\n\nlong. If\n\n$$\n\\dfrac 35\n$$\n\nof it is paved with asphalt, how long is the paved part?\n\nTo find out the length of the paved part of the road, we need to calculate\n\n$$\n5 \\, \\dfrac{1}{2} \\times \\dfrac{3}{5}\n$$\n\nFirst, we write\n\n$$\n5 \\,\\dfrac{1}{2}\n$$\n\nas an improper fraction:\n\n$$\n5 \\,\\dfrac{1}{2} = \\dfrac{(5 \\times 2) + 1}{2} = \\dfrac{11}{2}\n$$\n\nNow, we can multiply the two numbers. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac{11}{2} \\times \\dfrac{3}{5} = \\dfrac{11 \\times 3}{2 \\times 5} = \\dfrac{33}{10}\n$$\n\nFinally, by converting this fraction to a mixed number, we get\n\n$$\n33 \\div 10 = 3\\,\\textrm{R}\\,3 = 3\\,\\dfrac{3}{10}\n$$\n\nSo, the paved part of the road is\n\n$$\n3\\,\\dfrac{3}{10}\\,\\textrm{km}\n$$\n\nlong." :tutorial/id #uuid "d51b839a-689a-5352-9c20-ec86045b9865" :tutorial/math-academy-id 9004 :tutorial/title "Introduction"} :step/id #uuid "10376ca0-4f49-5079-9693-b993a2a71af9" :step/math-academy-id 119844 :step/next {:db/id #edb/ref 17592186184896}} {:db/id #edb/ref 17592186184896 :step/content {:db/id #edb/ref 17592186184145 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183951 :question/id #uuid "5a6ee672-4f62-5fc1-8285-b30ba76e955d" :question/math-academy-id "e-14573"} :knowledge-point/id #uuid "1b3a2302-d863-584a-acd6-1025ff362a04" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050634}] :knowledge-point/questions [{:db/id #edb/ref 17592186184544} {:db/id #edb/ref 17592186184545}] :knowledge-point/title "Multiplying Mixed Numbers by Whole Numbers"} :step/id #uuid "3a65cb19-9690-5689-822f-24d2022ce76f" :step/math-academy-id 119845 :step/next {:db/id #edb/ref 17592186184897}} {:db/id #edb/ref 17592186184897 :step/content {:db/id #edb/ref 17592186184146 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183949 :question/id #uuid "71291025-e9b3-55b1-9de2-1e6be8310476" :question/math-academy-id "e-14571"} :knowledge-point/id #uuid "dce948b0-e63a-5dcc-a33a-e68492b98321" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048149} {:db/id #edb/ref 17592186050115}] :knowledge-point/questions [{:db/id #edb/ref 17592186184809} {:db/id #edb/ref 17592186184817}] :knowledge-point/title "Mixed Numbers by Proper Fractions"} :step/id #uuid "fcd48847-b6bc-5a18-9b7c-171dc644d3d4" :step/math-academy-id 119848 :step/next {:db/id #edb/ref 17592186184898}} {:db/id #edb/ref 17592186184898 :step/content {:db/id #edb/ref 17592186184147 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183950 :question/id #uuid "22c9774c-400e-5baf-a874-fda211b2bb61" :question/math-academy-id "e-14572"} :knowledge-point/id #uuid "1b88656f-353a-5d5a-88f7-c85a5c9eec3e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050610}] :knowledge-point/questions [{:db/id #edb/ref 17592186184818} {:db/id #edb/ref 17592186184819} {:db/id #edb/ref 17592186424835}] :knowledge-point/title "Multiplying Mixed Numbers"} :step/id #uuid "4252596e-a254-52eb-b4b5-0f01e9f6dffc" :step/math-academy-id 119851}] :activity/title "Multiplying Mixed Numbers: Word Problems" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186184361}] [{:activity/first-step {:db/id #edb/ref 17592186193788} :activity/id #uuid "50c3226a-1d5b-58e4-9444-8327687e10d6" :activity/scope {:db/id #edb/ref 17592186049476 :topic/id #uuid "f8103613-5f0a-54a0-addc-d78e255cf66c" :topic/math-academy-id 3979} :activity/steps [{:db/id #edb/ref 17592186193573 :step/content {:db/id #edb/ref 17592186192728 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192441 :question/id #uuid "ea43cc4f-099a-5f47-885b-17d06c30c932" :question/math-academy-id "e-10618"} :knowledge-point/id #uuid "96a6d19b-af7f-5abd-9713-abb4455e52bf" :knowledge-point/questions [{:db/id #edb/ref 17592186193097} {:db/id #edb/ref 17592186193344}] :knowledge-point/title "Identifying Parallel and Perpendicular Lines in Figures"} :step/id #uuid "bab0d88d-b8de-55ea-9d2b-0f4b6cad3fb7" :step/math-academy-id 40165} {:db/id #edb/ref 17592186193574 :step/content {:db/id #edb/ref 17592186192729 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192442 :question/id #uuid "04518004-e56e-53f5-97b3-32ca751b61cb" :question/math-academy-id "e-10619"} :knowledge-point/id #uuid "241b7ea0-ba03-538f-a4f0-18739424e576" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048723}] :knowledge-point/questions [{:db/id #edb/ref 17592186193082} {:db/id #edb/ref 17592186193096} {:db/id #edb/ref 17592186424821}] :knowledge-point/title "Perpendicular Lines"} :step/id #uuid "7c4c30b3-081a-57b6-a2af-8ec7f827411f" :step/math-academy-id 40166 :step/next {:db/id #edb/ref 17592186193573}} {:db/id #edb/ref 17592186193580 :step/content {:db/id #edb/ref 17592186193847 :tutorial/content "Two lines are **perpendicular** if they intersect and form a $90^\\circ$ angle.\n\nFor example, the lines $r$ and $s$ below are perpendicular.\n\n![](images/73/73d2e836e942d6e468c8d9652921a9321b842d47b54ba59529123da61a9a96b4.png)\n\nWhen two lines are perpendicular, we can express this with the symbol $\\perp$, as follows:\n\n$$\nr \\perp s\n$$\n\nIn words, we say, \"the line $r$ is perpendicular to the line $s$.\"" :tutorial/id #uuid "2580c600-ddf7-5d7e-983d-e971ce3c6700" :tutorial/math-academy-id 6653 :tutorial/title "Perpendicular Lines"} :step/id #uuid "450ba46d-28c8-58be-945a-54fa0106cb15" :step/math-academy-id 40259 :step/next {:db/id #edb/ref 17592186193574}} {:db/id #edb/ref 17592186193788 :step/content {:db/id #edb/ref 17592186193812 :tutorial/content "Two lines are **parallel** if they never meet. So, for example, the lines $r$ and $s$ below are parallel.\n\n![](images/d9/d9bcd3cb4e201292afd4c3dca68273f16cff43d76c5a6a2f80348f5d8db1bd4c.png)\n\nIf two lines are parallel, we can express this using the $\\parallel$ symbol as follows:\n\n$$\nr \\parallel s\n$$\n\nIn words, we say, \"the line $r$ is parallel to the line $s$.\"\n\nIf two lines are not parallel, they must have a common point. In this case, we say that the lines **intersect**.\n\nFor example, the lines $v$ and $w$ below intersect at the point $P{:}$\n\n![](images/a6/a659c4a23e60880656c4fea0ec8e6ca63e0d9e55704fdb53b5bdf1a6e30b89e3.png)\n\nWe have the following important property about lines in two-dimensional space.\n\n> *Any two distinct lines are either parallel or intersect at exactly one point.*" :tutorial/id #uuid "b5d86f95-6437-58f6-a35f-cf72da79271b" :tutorial/math-academy-id 2162 :tutorial/title "Introduction"} :step/id #uuid "17a99595-6232-50d3-939f-80b3dee5b912" :step/math-academy-id 8694 :step/next {:db/id #edb/ref 17592186193789}} {:db/id #edb/ref 17592186193789 :step/content {:db/id #edb/ref 17592186192855 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192614 :question/id #uuid "4819c67f-cc06-555f-ab29-0b63e9ddb164" :question/math-academy-id "e-2544"} :knowledge-point/id #uuid "fccf0330-1c65-5585-aeaf-2efee13aa89c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049350}] :knowledge-point/questions [{:db/id #edb/ref 17592186193081} {:db/id #edb/ref 17592186193343}] :knowledge-point/title "Parallel Lines"} :step/id #uuid "81ac2285-c162-59f3-94c2-bfff181b2ee6" :step/math-academy-id 8695 :step/next {:db/id #edb/ref 17592186193580}}] :activity/title "Parallel and Perpendicular Lines" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186192890}] [{:activity/first-step {:db/id #edb/ref 17592186180632} :activity/id #uuid "fb492055-69db-5196-a7e8-226f6f97db60" :activity/scope {:db/id #edb/ref 17592186051009 :topic/id #uuid "7931e951-f0f8-5132-97e2-67fa64802a65" :topic/math-academy-id 3721} :activity/steps [{:db/id #edb/ref 17592186180632 :step/content {:db/id #edb/ref 17592186180773 :tutorial/content "In algebra, there are many different ways to represent multiplication. The following expressions all mean \"two times $y$\":\n$2y,\\qquad 2 \\cdot y,\\qquad 2 \\times y$.\n\nWhen a number is next to a variable, it means that we multiply them together. We can also represent multiplication using the dot symbol ($\\cdot$) or the familiar \"times\" symbol ($\\times$), though we tend to avoid using the ($\\times$) symbol because it looks a lot like the variable $x$." :tutorial/id #uuid "dfb2834b-8f6f-55c4-b933-6f80cbf9e842" :tutorial/math-academy-id 8167 :tutorial/title "Introduction"} :step/id #uuid "935e508e-1137-5092-83aa-7b9d7f272d35" :step/math-academy-id 77833 :step/next {:db/id #edb/ref 17592186180633}} {:db/id #edb/ref 17592186180633 :step/content {:db/id #edb/ref 17592186179815 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179454 :question/id #uuid "9ecfaf4d-f7c4-52c1-856e-9e487b9e6de5" :question/math-academy-id "e-13062"} :knowledge-point/id #uuid "638adb60-4629-514c-86e9-fa824295dc43" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050618}] :knowledge-point/questions [{:db/id #edb/ref 17592186180157} {:db/id #edb/ref 17592186180224}] :knowledge-point/title "Translating Between Phrases and Algebraic Expressions Containing Multiplication"} :step/id #uuid "e0d6400c-fcd8-5d0d-858f-8d1cf92c2a3e" :step/math-academy-id 77834 :step/next {:db/id #edb/ref 17592186180634}} {:db/id #edb/ref 17592186180634 :step/content {:db/id #edb/ref 17592186180774 :tutorial/content "The **quotient** of two numbers means that we need to divide the first number by the second number.\n\nFor example, \"the quotient of $x$ and two\" means the same thing as \"$x$ divided by two\" and can be written as either expression below:\n\n$$\n\\dfrac{x}{2},\\qquad x \\div 2 \\,\n$$\n\nIn algebra, we prefer to represent division using the fraction bar instead of the ($\\div$) symbol." :tutorial/id #uuid "966707d2-a5e7-5ce1-a0b4-1c2991c80e3d" :tutorial/math-academy-id 8168 :tutorial/title "The Division Sign in Algebra"} :step/id #uuid "1dad9187-c0b1-5618-8f7a-6ee3c7b0a4c1" :step/math-academy-id 77837 :step/next {:db/id #edb/ref 17592186180635}} {:db/id #edb/ref 17592186180635 :step/content {:db/id #edb/ref 17592186179816 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179455 :question/id #uuid "ce7fd393-cd41-5060-9ffe-422f6474102d" :question/math-academy-id "e-13063"} :knowledge-point/id #uuid "66bfa36e-be32-5c64-86c1-b17e8e670e04" :knowledge-point/questions [{:db/id #edb/ref 17592186180127} {:db/id #edb/ref 17592186180225} {:db/id #edb/ref 17592186424820}] :knowledge-point/title "Translating Between Phrases and Algebraic Expressions Containing Division"} :step/id #uuid "8f5e7a7a-0b7b-58c4-970d-eb187e7d2e39" :step/math-academy-id 77838}] :activity/title "Constructing Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179872}]}
