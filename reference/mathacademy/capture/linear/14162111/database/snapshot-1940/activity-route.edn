#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186486467} :activity/id #uuid "2ee8e36f-d6f2-535a-b7e8-f2094eda05e2" :activity/scope {:db/id #edb/ref 17592186050517 :topic/id #uuid "50123c1c-7113-541e-8c4f-047f2eec416d" :topic/math-academy-id 92} :activity/steps [{:db/id #edb/ref 17592186486467 :step/content {:db/id #edb/ref 17592186486370 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e2f253f-f36a-560f-9ec1-161de7ca2936" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-3,-6)" :db/id #edb/ref 17592186485790} {:answer/id #uuid "5b907c20-fdab-5148-9850-5b4dac59cbfc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,6)" :db/id #edb/ref 17592186485926} {:answer/id #uuid "8ea93a26-50f7-53a6-b9a0-fc301c2fc49b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(5,-6)" :db/id #edb/ref 17592186486020} {:answer/id #uuid "bf3c4744-55c7-5126-a9e5-deeb937ce8ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,-6)" :db/id #edb/ref 17592186486108} {:answer/id #uuid "fc37df37-6bf2-589e-b9c3-27692a226298" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,-6)" :db/id #edb/ref 17592186486222}] :answer-field/correct {:db/id #edb/ref 17592186486222} :answer-field/id #uuid "6156ddb1-eb69-58fb-ade4-f35c95453cbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486277}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "33922fa7-9cd5-5240-b5a7-6b856c2f3900" :question/math-academy-id "q-12475" :question/problem "![](images/a3/a3e52270e83d29fe4d53f1429a6648c6ef2451ae5ad5b3d48dd0d1a0f3450df4.png)\n\nWhat are the $xy$-coordinates of the point shown in the axes above?" :question/worked-solution "To find the coordinates of the point, we inspect its position along the $x$ and $y$ axes.\n\nThe point is $3$ units to the right of the origin, in the positive direction of the $x$-axis. So, the point has an $x$-coordinate of $3.$\n\nAdditionally, the point is $6$ units *below* the origin, in the *negative* direction of the $y$-axis. So, the point has a $y$-coordinate of $-6.$\n\nThe point has an $x$-coordinate of $3$ and a $y$-coordinate of $-6,$ so its coordinates are $(3,-6).$"} :step/id #uuid "146a565d-dffc-5e6c-b79e-319aeeb7bc4d" :step/next {:db/id #edb/ref 17592186486486}} {:db/id #edb/ref 17592186486475 :step/content {:db/id #edb/ref 17592186486437 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "649b626b-4386-5c00-bdcf-5dd4938d9112" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,1)" :db/id #edb/ref 17592186485937} {:answer/id #uuid "80ab4c5e-aff9-5dde-a021-093b6b9ddbd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-4,1)" :db/id #edb/ref 17592186485991} {:answer/id #uuid "a9b54552-5965-5854-ba07-c60932f774a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,4)" :db/id #edb/ref 17592186486071} {:answer/id #uuid "c5fcd194-a407-59cf-ae7a-2e21427fcdca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,4)" :db/id #edb/ref 17592186486120} {:answer/id #uuid "dfb98379-8815-506f-a548-b96dd7aea567" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,-4)" :db/id #edb/ref 17592186486174}] :answer-field/correct {:db/id #edb/ref 17592186486071} :answer-field/id #uuid "d0b079f8-570c-5a56-a881-00ac494144c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486321}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c5cd4da4-bcde-5c76-b987-99fb9414b223" :question/math-academy-id "q-93510" :question/problem "![](images/53/53e86e59af40ecd611ad1f7753f4780b692f17afc5a81709ea1c249a0bf011d5.png)\n\nWhat are the coordinates of the point $A?$" :question/worked-solution "To find the coordinates of the point $A,$ we start at the origin, move $1$ unit *left* and then $4$ units *up*. \n\n![](images/14/147aa8c644b24f82abadbbb9362ed51718bf94da992c83d016c72a1898032f0f.png)\n\nThe $x$-coordinate of $A$ is $-1,$ the $y$-coordinate is $4,$ and coordinates are given by the ordered pair $(-1,4).$"} :step/id #uuid "3f07956a-6431-5516-8d25-2cc6c4d55a33"} {:db/id #edb/ref 17592186486486 :step/content {:db/id #edb/ref 17592186486375 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17d8031f-5e2f-5683-84c6-7fe7232955e3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "All" :db/id #edb/ref 17592186485807} {:answer/id #uuid "19d86bf2-74f3-5d7b-a43c-1012785c8707" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186485812} {:answer/id #uuid "41bd2118-a5bb-5da1-8bdd-da8970f09208" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186485890} {:answer/id #uuid "79aeb305-a976-5e19-9df6-af6e17665886" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186485978} {:answer/id #uuid "7dae032f-a2cf-5841-bfb4-ef99e0c6b32f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186485985}] :answer-field/correct {:db/id #edb/ref 17592186485985} :answer-field/id #uuid "db8b3ac8-d583-5e07-b501-9df170f999c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486331}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3b6bba67-98a0-5af4-b6c0-e0b46329b1b5" :question/math-academy-id "q-61365" :question/problem "![](images/6c/6c55183a2999276882036eb3bc54a94f9d7356a58eb7b3d3e1ec7708def1de4f.png)\n\nWhich of the following is true regarding the point $C?$\n\nI. It is in the first quadrant\n\nII. Its $x$-coordinate is $3$\n\nIII. Its $y$-coordinate is $-2$" :question/worked-solution "The point $C$ is in the fourth quadrant, so statement I is false.\n\nTo find the coordinates of the point $C,$ we start at the origin, move $3$ units *right* and then $2$ units *down*. \n\n![](images/98/98c5cd8e245651f99a29c37b6d63122fa7766eed80c64ab6870e05192742dab1.png)\n\nThe coordinates of $C$ are $(3,-2).$ Hence, statements II and III are true."} :step/id #uuid "6a26e169-b937-5d4e-9132-efccf14ec7c7" :step/next {:db/id #edb/ref 17592186486514}} {:db/id #edb/ref 17592186486514 :step/content {:db/id #edb/ref 17592186486380 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2379ed4e-1bad-561c-bd91-f529f4ce1c13" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e8/e8b3ac34b4fe6c877d606d8ddde5f29c9856cc4bdc5ac14e3ffcf5ddccdc0ebb.png" :db/id #edb/ref 17592186485825} {:answer/id #uuid "2a8a49a4-67ee-5dd6-8034-f08b8abe1465" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/79/794cbedc72a4ad51263737802b419bb024f250f67d3a6a8464f3c9b6d61aa194.png" :db/id #edb/ref 17592186485840} {:answer/id #uuid "3f7f4dc2-51a6-57b2-a348-9bb680d817c3" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/5a/5a9caae32c4a20a6646689ceeb16622dbc1982d150988b8b393868e3dab3ac0f.png" :db/id #edb/ref 17592186485885} {:answer/id #uuid "a75b6401-ac5e-5996-87c4-190b7e47c998" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/14/146f5c3b0672a81347edb9d56cfe840ca6acc023444d110584649bf90d741ae6.png" :db/id #edb/ref 17592186486068} {:answer/id #uuid "f9270677-c75b-5726-992c-0684189ac5e6" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/4b/4ba1b8ea826f2d1a095982b03b58c4e75c711dbad168493a6a0d784064e06a74.png" :db/id #edb/ref 17592186486215}] :answer-field/correct {:db/id #edb/ref 17592186486215} :answer-field/id #uuid "3cc8f23d-893d-5af7-ae5b-7ea465b5f2d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486262}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4a14d943-4b53-5214-a1e8-29e07a0ea11f" :question/math-academy-id "q-71670" :question/problem "Which of the following shows the point $A(-2,3)?$" :question/worked-solution "Starting at the origin, we move along the $x$ and $y$ axes to get to the point $A.$\n\nFirst, we move along the $x$-axis. The point $A$ has an $x$-coordinate of $-2,$ so we move $2$ units to the *left*, in the *negative* direction of the $x$-axis.\n\nThen, we move along the $y$-axis. The point $A$ has a $y$-coordinate of $3,$ so we move $3$ units *up*, in the *positive* direction of the $y$-axis.\n\n![](images/4b/4ba1b8ea826f2d1a095982b03b58c4e75c711dbad168493a6a0d784064e06a74.png)"} :step/id #uuid "dd35957b-3e1a-5f26-ae0e-89d442576bd2" :step/next {:db/id #edb/ref 17592186486475}}] :activity/title "The Cartesian Coordinate System" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186485752}]}
