#{[{:activity/first-step {:db/id #edb/ref 17592186069598} :activity/id #uuid "694f32b9-ef02-56c2-a6ab-8b0b5d3806a7" :activity/scope {:db/id #edb/ref 17592186049869 :topic/id #uuid "19d807d9-e4fc-5eae-b364-d71f790123dd" :topic/math-academy-id 408} :activity/steps [{:db/id #edb/ref 17592186069598 :step/content {:db/id #edb/ref 17592186070021 :tutorial/content "Suppose we want to find the point of intersection between the two lines\n\n$$\ny = x + 2\n$$\n\nand\n\n$$\ny = 2x + 1\n$$\n\nA sketch of both lines and the point of intersection $P$ is shown below.\n\n![](images/2b/2bf429fdfbe706521b81617f56a0f561171aa7fd48e0af89318225f1d328e667.png)\n\nThe point $P$ consists of the coordinates $(x,y)$ that satisfy both equations\n\n$$\ny=x+2\n$$\n\nand\n\n$$\ny=2x+1\n$$\n\nSo, to find the coordinates of $P$ we need to solve the system of equations consisting of the two lines:\n\n$$\n{y = x + 2; y = 2x + 1\n$$\n\nWe can solve this system by substitution. Substituting the first equation\n\n$$\ny=x+2\n$$\n\ninto the second equation\n\n$$\ny=2x+1\n$$\n\ngives an equation that we can solve for $x$:\n\n$$\n\\begin{aligned}\nx + 2 &= 2x + 1 \\\\\nx + 1 &= 2x \\\\\n1 &= x\n\\end{aligned}\n$$\n\nThis is the $x$-coordinate of the point of intersection. To find the $y$-coordinate, we substitute $x = 1$ back into one of the equations, say\n\n$$\ny=x+2\n$$\n\nas follows:\n\n$$\n\\begin{aligned}\ny &= x + 2 \\\\\n&= 1 + 2 \\\\\n&= 3\n\\end{aligned}\n$$\n\nTherefore, the solution to the system is\n\n$$\nx=1, \\, y=3\n$$\n\nSo, the point of intersection has the coordinates $(1,3)$." :tutorial/id #uuid "39070934-9f3c-5858-8959-365242cf0563" :tutorial/math-academy-id 8709 :tutorial/title "Introduction"} :step/id #uuid "6ca9afc5-3404-515f-b1c6-ea4d5161c29a" :step/math-academy-id 143915 :step/next {:db/id #edb/ref 17592186069599}} {:db/id #edb/ref 17592186069599 :step/content {:db/id #edb/ref 17592186068713 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068481 :question/id #uuid "5cf6d36a-0e67-5f16-befd-32d30cf4b930" :question/math-academy-id "e-14010"} :knowledge-point/id #uuid "e122a1fe-f340-5af6-9908-68ad52f89731" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048826}] :knowledge-point/questions [{:db/id #edb/ref 17592186069112} {:db/id #edb/ref 17592186069113} {:db/id #edb/ref 17592186069258}] :knowledge-point/title "Finding the Intersection of Two Lines Given in Slope-Intercept Form"} :step/id #uuid "787639d6-4b54-5b06-ab03-6d845df01b6d" :step/math-academy-id 143916 :step/next {:db/id #edb/ref 17592186069600}} {:db/id #edb/ref 17592186069600 :step/content {:db/id #edb/ref 17592186070034 :tutorial/content "When two lines are given in the *standard form*, you may find it easier to use the *elimination method* to find the point of intersection.\n\nLet's see an example." :tutorial/id #uuid "efdf9704-19aa-5a4a-8ac3-220f267bc227" :tutorial/math-academy-id 9140 :tutorial/title "Lines Given in Standard Form"} :step/id #uuid "69dbdcc7-0c22-5579-903a-39ea4acc15fb" :step/math-academy-id 143920 :step/next {:db/id #edb/ref 17592186069601}} {:db/id #edb/ref 17592186069601 :step/content {:db/id #edb/ref 17592186068714 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068482 :question/id #uuid "7fe8c6a0-f152-5349-9152-b4c018368dbc" :question/math-academy-id "e-14012"} :knowledge-point/id #uuid "4a81c1cd-7381-5788-8a51-53cecee5f600" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049840} {:db/id #edb/ref 17592186050190}] :knowledge-point/questions [{:db/id #edb/ref 17592186069114} {:db/id #edb/ref 17592186069128} {:db/id #edb/ref 17592186069518}] :knowledge-point/title "Finding the Intersection of Two Lines Given in Standard Form"} :step/id #uuid "5fda47d7-4b73-57eb-a3db-30d707f29f26" :step/math-academy-id 143921 :step/next {:db/id #edb/ref 17592186069602}} {:db/id #edb/ref 17592186069602 :step/content {:db/id #edb/ref 17592186068715 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068483 :question/id #uuid "cceef15c-a242-5486-a830-f6bdf9f07010" :question/math-academy-id "e-14015"} :knowledge-point/id #uuid "b154eb5d-a45b-5d92-9e33-dd7875327e6e" :knowledge-point/questions [{:db/id #edb/ref 17592186069129} {:db/id #edb/ref 17592186069180}] :knowledge-point/title "Calculating Unknown Parameters Given a Point of Intersection"} :step/id #uuid "3b997cef-985b-5abc-bc48-d1fbfa6ebd29" :step/math-academy-id 143925}] :activity/title "Calculating the Intersection of Two Lines" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068945}]}
