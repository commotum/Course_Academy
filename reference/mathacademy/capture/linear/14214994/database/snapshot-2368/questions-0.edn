#{[{:db/id #edb/ref 17592186115025 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115196 :knowledge-point/id #uuid "1446af0e-7200-51cf-942d-9db92e9ae721" :knowledge-point/title "Simplifying Logarithmic Expressions Containing Two Terms"}] :question/id #uuid "189c39b0-f25c-5d89-b89b-5603040907c7" :question/math-academy-id "e-4005" :question/problem "Simplify $2\\log_{2}{5}+4\\log_{2}{5}.$" :question/worked-solution "Both logarithmic terms have a base of $2$ and an argument of $5.$ Therefore, we can combine them by adding their coefficients:\n\n$$\n\\begin{aligned}2{log}_{2}⁡5+4{log}_{2}⁡5 & =(2+4){log}_{2}⁡5=6{log}_{2}⁡5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115026 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115197 :knowledge-point/id #uuid "041471fd-9f0e-51ab-a5ec-2cc00204153d" :knowledge-point/title "Simplifying Logarithmic Expressions Containing More Than Two Terms"}] :question/id #uuid "a83f2130-927e-54ed-9817-b968256d9f2a" :question/math-academy-id "e-4006" :question/problem "Simplify $2\\log_4(9)-3\\log_3(9)+5\\log_4(9).$" :question/worked-solution "Both the first and the third logarithmic terms have a base of ${\\color{blue}4}$ and an argument of ${\\color{red}9}.$ Therefore, we can combine them by adding their coefficients:\n\n$$\n\\begin{aligned}2{log}_{4}⁡(9)-3{log}_{3}⁡(9)+5{log}_{4}⁡(9) & =(2+5){log}_{4}⁡(9)-3{log}_{3}⁡(9) \\\\  & =7{log}_{4}⁡(9)-3{log}_{3}⁡(9)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115027 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115198 :knowledge-point/id #uuid "b3a510a1-0659-5929-afc5-4554b9f8ba03" :knowledge-point/title "Simplifying Logarithmic Expressions Containing Variable Expressions"}] :question/id #uuid "c45b5963-9e06-558c-b125-f8202e42b1af" :question/math-academy-id "e-4007" :question/problem "Simplify $9\\log_6(2x)-2\\log_4(2x)-3\\log_4(2x).$" :question/worked-solution "Both the second and the third logarithmic terms have a base of ${\\color{blue}4}$ and an argument of ${\\color{red}2x}.$ Therefore, we can combine them by adding their coefficients:\n\n$$\n\\begin{aligned}9{log}_{6}⁡(2x)-2{log}_{4}⁡(2x)-3{log}_{4}⁡(2x) & =9{log}_{6}⁡(2x)+(-2-3){log}_{4}⁡(2x) \\\\  & =9{log}_{6}⁡(2x)-5{log}_{4}⁡(2x)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186526030 :knowledge-point/_questions [{:db/id #edb/ref 17592186115198 :knowledge-point/id #uuid "b3a510a1-0659-5929-afc5-4554b9f8ba03" :knowledge-point/title "Simplifying Logarithmic Expressions Containing Variable Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00679d0e-152a-5c09-a9e3-eaaccadc782b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\operatorname{log}⁡(10x)" :db/id #edb/ref 17592186525210} {:answer/id #uuid "01483a8f-1325-5f10-8c0e-f1d9c9ad8ce3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\operatorname{log}⁡(5x)-5\\operatorname{log}⁡(3x)" :db/id #edb/ref 17592186525212} {:answer/id #uuid "0a727d16-4499-56f9-a237-584ed287288b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\operatorname{log}⁡(5x)" :db/id #edb/ref 17592186525230} {:answer/id #uuid "d41360b2-67bb-5596-8a5b-e461ae816be0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\operatorname{log}⁡(5x)+5\\operatorname{log}⁡(3x)" :db/id #edb/ref 17592186525735} {:answer/id #uuid "fec558e4-5c30-5cfd-bb55-15662712a342" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\operatorname{log}⁡(5x)-3\\operatorname{log}⁡(3x)" :db/id #edb/ref 17592186525842}] :answer-field/correct {:answer/id #uuid "d41360b2-67bb-5596-8a5b-e461ae816be0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\operatorname{log}⁡(5x)+5\\operatorname{log}⁡(3x)" :db/id #edb/ref 17592186525735} :answer-field/id #uuid "cef3cba0-0076-582c-ad3a-3637bb2ac6dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525948}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "68542d18-8a32-5e4e-8371-82abbbeca5f9" :question/math-academy-id "q-108094" :question/problem "Which of the following is equivalent to $7\\operatorname{log}⁡(5x)-2\\operatorname{log}⁡(5x)+5\\operatorname{log}⁡(3x)?$" :question/worked-solution "Both the first and the second logarithmic terms have a base of $10$ and an argument of $5x.$ Therefore, we can combine them by adding their coefficients.\n\n$$\n\\begin{aligned}7\\operatorname{log}⁡(5x)-2\\operatorname{log}⁡(5x)+5\\operatorname{log}⁡(3x) & =(7-2)\\operatorname{log}⁡(5x)+5\\operatorname{log}⁡(3x) \\\\  & =5\\operatorname{log}⁡(5x)+5\\operatorname{log}⁡(3x)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186526031 :knowledge-point/_questions [{:db/id #edb/ref 17592186115197 :knowledge-point/id #uuid "041471fd-9f0e-51ab-a5ec-2cc00204153d" :knowledge-point/title "Simplifying Logarithmic Expressions Containing More Than Two Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a51f353-daaf-5f68-b2f2-768a2623dccb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186525258} {:answer/id #uuid "424f9fa2-dbff-5499-a454-3893b8c1f845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{log}⁡(6)-3\\operatorname{log}⁡(4)" :db/id #edb/ref 17592186525372} {:answer/id #uuid "59d2460b-ac76-530e-b271-398b4e79e462" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{log}⁡(2)" :db/id #edb/ref 17592186525437} {:answer/id #uuid "5c4315b4-27ed-5006-80cf-faa350bc3776" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{log}⁡(6)-3\\operatorname{log}⁡(4)" :db/id #edb/ref 17592186525442} {:answer/id #uuid "85b04967-2a81-584b-9d0e-ab8167b177d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{log}⁡(4)-4\\operatorname{log}⁡(6)" :db/id #edb/ref 17592186525545}] :answer-field/correct {:answer/id #uuid "424f9fa2-dbff-5499-a454-3893b8c1f845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{log}⁡(6)-3\\operatorname{log}⁡(4)" :db/id #edb/ref 17592186525372} :answer-field/id #uuid "db402688-050c-57f0-867e-9cc6e39d0409" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525956}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "68b55bab-dfd4-5ef5-a0ec-17580bbcfd66" :question/math-academy-id "q-24170" :question/problem "Which of the following is equivalent to $\\operatorname{log}⁡(6)-3\\operatorname{log}⁡(4)+3\\operatorname{log}⁡(6)?$" :question/worked-solution "Both the first and the third logarithmic terms have a base of $10$ and an argument of $6.$ Therefore, we can combine them by adding their coefficients.\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(6)-3\\operatorname{log}⁡(4)+3\\operatorname{log}⁡(6) & =(1+3)\\operatorname{log}⁡(6)-3\\operatorname{log}⁡(4) \\\\  & =4\\operatorname{log}⁡(6)-3\\operatorname{log}⁡(4)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186525998 :knowledge-point/_questions [{:db/id #edb/ref 17592186115198 :knowledge-point/id #uuid "b3a510a1-0659-5929-afc5-4554b9f8ba03" :knowledge-point/title "Simplifying Logarithmic Expressions Containing Variable Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f5fdc6b-2a4c-54be-b643-16f35e018c83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-45{log}_{6}⁡(2x)" :db/id #edb/ref 17592186525316} {:answer/id #uuid "437f44e9-0a0d-50f