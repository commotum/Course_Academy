a1-0659-5929-afc5-4554b9f8ba03" :knowledge-point/questions [{:db/id #edb/ref 17592186115550} {:db/id #edb/ref 17592186115583} {:db/id #edb/ref 17592186525998} {:db/id #edb/ref 17592186526030}] :knowledge-point/title "Simplifying Logarithmic Expressions Containing Variable Expressions"} :step/id #uuid "4f56c5a3-084d-50ef-8a0c-e4d67238140b" :step/math-academy-id 14171} {:db/id #edb/ref 17592186116088 :step/content {:db/id #edb/ref 17592186116483 :tutorial/content "When two logarithmic terms in an expression have the same base and argument, we can combine them by adding their coefficients.\n\nTo demonstrate, let's look at the expression\n\n$$\n5\\log_{\\color{blue}4}{\\color{red}7}+3\\log_{\\color{blue}4}{\\color{red}7}.\n$$\n\nBoth logarithmic terms have a base of $\\color{blue}4$ and an argument of ${\\color{red}7}.$ Therefore, we can combine them by adding their coefficients:\n\n$$\n\\begin{aligned}5{log}_{4}⁡7+3{log}_{4}⁡7 & =(5+3){log}_{4}⁡7=8{log}_{4}⁡7\\end{aligned}\n$$" :tutorial/id #uuid "d69a29ed-a882-5088-b562-11ab1966e5e6" :tutorial/math-academy-id 2870 :tutorial/title "Introduction"} :step/id #uuid "e16fddb6-56a0-5964-8a02-4e24a6529539" :step/math-academy-id 15345 :step/next {:db/id #edb/ref 17592186116055}}] :activity/title "Simplifying Logarithmic Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115427}]}
