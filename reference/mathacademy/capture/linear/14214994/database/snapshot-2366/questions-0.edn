#{[{:db/id #edb/ref 17592186115025 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115196 :knowledge-point/id #uuid "1446af0e-7200-51cf-942d-9db92e9ae721" :knowledge-point/title "Simplifying Logarithmic Expressions Containing Two Terms"}] :question/id #uuid "189c39b0-f25c-5d89-b89b-5603040907c7" :question/math-academy-id "e-4005" :question/problem "Simplify $2\\log_{2}{5}+4\\log_{2}{5}$." :question/worked-solution "Both logarithmic terms have a base of $2$ and an argument of $5$. Therefore, we can combine them by adding their coefficients:\n\n$$\n\\begin{aligned}\n2\\log_{2} 5 + 4\\log_{2} 5 &= (2 + 4)\\log_{2} 5 = 6\\log_{2} 5\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115026 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115197 :knowledge-point/id #uuid "041471fd-9f0e-51ab-a5ec-2cc00204153d" :knowledge-point/title "Simplifying Logarithmic Expressions Containing More Than Two Terms"}] :question/id #uuid "a83f2130-927e-54ed-9817-b968256d9f2a" :question/math-academy-id "e-4006" :question/problem "Simplify $2\\log_4(9)-3\\log_3(9)+5\\log_4(9)$." :question/worked-solution "Both the first and the third logarithmic terms have a base of ${\\color{blue}4}$ and an argument of ${\\color{red}9}$. Therefore, we can combine them by adding their coefficients:\n\n$$\n\\begin{aligned}\n2\\log_{4} (9) - 3\\log_{3} (9) + 5\\log_{4} (9) &= (2 + 5)\\log_{4} (9) - 3\\log_{3} (9) \\\\\n&= 7\\log_{4} (9) - 3\\log_{3} (9)\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115027 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115198 :knowledge-point/id #uuid "b3a510a1-0659-5929-afc5-4554b9f8ba03" :knowledge-point/title "Simplifying Logarithmic Expressions Containing Variable Expressions"}] :question/id #uuid "c45b5963-9e06-558c-b125-f8202e42b1af" :question/math-academy-id "e-4007" :question/problem "Simplify $9\\log_6(2x)-2\\log_4(2x)-3\\log_4(2x)$." :question/worked-solution "Both the second and the third logarithmic terms have a base of ${\\color{blue}4}$ and an argument of ${\\color{red}2x}$. Therefore, we can combine them by adding their coefficients:\n\n$$\n\\begin{aligned}\n9\\log_{6} (2x) - 2\\log_{4} (2x) - 3\\log_{4} (2x) &= 9\\log_{6} (2x) + (-2 - 3)\\log_{4} (2x) \\\\\n&= 9\\log_{6} (2x) - 5\\log_{4} (2x)\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115578 :knowledge-point/_questions [{:db/id #edb/ref 17592186115196 :knowledge-point/id #uuid "1446af0e-7200-51cf-942d-9db92e9ae721" :knowledge-point/title "Simplifying Logarithmic Expressions Containing Two Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d147ed9a-2b27-5e8b-92cd-29c463c72e50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\log 3" :db/id #edb/ref 17592186112447} {:answer/id #uuid "de6b60ea-4015-58c3-8b1f-80405e496fce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\log 3" :db/id #edb/ref 17592186112448} {:answer/id #uuid "f8679ed6-07d7-58b4-8333-28145e69b619" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log 3" :db/id #edb/ref 17592186112449} {:answer/id #uuid "374e6657-6b90-5c33-8e35-71ed39c608f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\log 3" :db/id #edb/ref 17592186112450} {:answer/id #uuid "4cbf74a1-92cf-50bb-8d40-dd1faa9028c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\log 3" :db/id #edb/ref 17592186112451}] :answer-field/id #uuid "df7dd2f3-44d4-589f-90b5-8fddaab90610" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186112446}] :question/id #uuid "4c1b7d2a-ec2f-517a-9429-1efa48350748" :question/math-academy-id "q-25681" :question/problem "What is $-2\\log 3 + 3\\log 3$?"}]}
