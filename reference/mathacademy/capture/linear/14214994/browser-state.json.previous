    "q-24170": {
      "dom_id": "step-q24170",
      "name": "Question 4",
      "problem": "Which of the following is equivalent to $\\operatorname{log}⁡(6)-3\\operatorname{log}⁡(4)+3\\operatorname{log}⁡(6)?$",
      "worked_solution": "Both the first and the third logarithmic terms have a base of $10$ and an argument of $6.$ Therefore, we can combine them by adding their coefficients.\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(6)-3\\operatorname{log}⁡(4)+3\\operatorname{log}⁡(6) & =(1+3)\\operatorname{log}⁡(6)-3\\operatorname{log}⁡(4) \\\\  & =4\\operatorname{log}⁡(6)-3\\operatorname{log}⁡(4)\\end{aligned}\n$$",
      "calculator_instructions": "",
