#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186065007} :activity/id #uuid "22bb5766-c513-5d78-a9f8-52a5e929a9f8" :activity/scope {:db/id #edb/ref 17592186048754 :topic/id #uuid "bb9926b3-3427-50e2-94a5-96b4e07466cd" :topic/math-academy-id 312} :activity/steps [{:db/id #edb/ref 17592186065007 :step/content {:db/id #edb/ref 17592186065407 :tutorial/content "Remember that the exponential function $e^x$ has the special property that the derivative of the exponential function is the exponential function itself. In other words, taking the derivative doesn't change anything, and we have\n\n$$\n\\frac{\\textrm{d}}{\\textrm d x} \\left(e^ x\\right)  = e^ x.\n$$\n\nSince integration is the opposite of differentiation, and differentiating the exponential function leaves it unchanged, integrating the exponential function also leaves it unchanged. So, the integral of the exponential function is\n\n$$\n\\displaystyle \\int e^x \\, \\textrm d x = e^x +C.\n$$" :tutorial/id #uuid "d2a6d036-0881-5a58-8935-905cd004a7e1" :tutorial/math-academy-id 711 :tutorial/title "Introduction"} :step/id #uuid "fc7af3af-558f-5f0f-9b14-e5c45f77ad79" :step/math-academy-id 1369 :step/next {:db/id #edb/ref 17592186065008}} {:db/id #edb/ref 17592186065008 :step/content {:db/id #edb/ref 17592186064171 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064049 :question/id #uuid "3ff03590-c618-5a60-b2ac-e0a20be6a8ae" :question/math-academy-id "e-377"} :knowledge-point/id #uuid "3f9548e6-28ef-5a97-ab04-dfb1b6e23c16" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048442} {:db/id #edb/ref 17592186048749}] :knowledge-point/questions [{:db/id #edb/ref 17592186064730} {:db/id #edb/ref 17592186064731} {:db/id #edb/ref 17592186250125} {:db/id #edb/ref 17592186339009} {:db/id #edb/ref 17592186339011} {:db/id #edb/ref 17592186339013}] :knowledge-point/title "Integrating the Exponential Function"} :step/id #uuid "3b0b5798-a45c-58ad-a6a5-18ca5ba2df53" :step/math-academy-id 1370 :step/next {:db/id #edb/ref 17592186065009}} {:db/id #edb/ref 17592186065009 :step/content {:db/id #edb/ref 17592186065408 :tutorial/content "Remember that if $a$ is a positive real number, then the derivative of $a^x$ is given by\n\n$$\n\\frac{\\textrm{d}}{\\textrm d x}\\left( a^ x\\right)\t=\ta^ x \\ln a.\n$$\n\nSo, by \"reversing\" this process, we obtain the following formula for the integral of a general exponential function:\n\n$$\n\\displaystyle \\int  a^x \\, \\textrm d x  = \\dfrac{a^ x }{\\ln a} +C.\n$$\n\nFor instance, suppose that we wish to calculate the integral \n\n$$\n\\int 2^x  \\, \\textrm d x\n$$\n\nTo compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\eqalign{\n\\int 2^x  \\, \\textrm d x   &= \\dfrac{2^x}{\\ln 2} + C\n}\n$$" :tutorial/id #uuid "254d6a12-01a6-5a3b-b0fd-fbefc017a149" :tutorial/math-academy-id 714 :tutorial/title "Integrating an Exponential Function With a General Base"} :step/id #uuid "51842b79-1471-58e3-8240-0e6f8c062fda" :step/math-academy-id 1374 :step/next {:db/id #edb/ref 17592186065010}} {:db/id #edb/ref 17592186065010 :step/content {:db/id #edb/ref 17592186064172 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064050 :question/id #uuid "66cbcaeb-93ee-5c15-a230-e66d2fbdd761" :question/math-academy-id "e-380"} :knowledge-point/id #uuid "8bd8c6d8-0b11-5735-88a1-9b12e6315401" :knowledge-point/questions [{:db/id #edb/ref 17592186064732} {:db/id #edb/ref 17592186064932} {:db/id #edb/ref 17592186250130} {:db/id #edb/ref 17592186250131} {:db/id #edb/ref 17592186250132} {:db/id #edb/ref 17592186297341}] :knowledge-point/title "Integrating an Exponential Function With a General Base"} :step/id #uuid "6e6c41bb-fda0-558d-bff8-d7d5bc882df6" :step/math-academy-id 1377 :step/next {:db/id #edb/ref 17592186065016}} {:db/id #edb/ref 17592186065016 :step/content {:db/id #edb/ref 17592186064177 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064051 :question/id #uuid "90010ae5-e211-510f-b188-dc3006926d94" :question/math-academy-id "e-381"} :knowledge-point/id #uuid "980bb2fb-4bb5-5cbb-aea8-87010493c013" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050321}] :knowledge-point/question-generator {:db/id #edb/ref 17592186488378} :knowledge-point/questions [{:db/id #edb/ref 17592186064733} {:db/id #edb/ref 17592186064889} {:db/id #edb/ref 17592186233778} {:db/id #edb/ref 17592186235436} {:db/id #edb/ref 17592186235485} {:db/id #edb/ref 17592186290437} {:db/id #edb/ref 17592186290438} {:db/id #edb/ref 17592186297342} {:db/id #edb/ref 17592186297344} {:db/id #edb/ref 17592186297347} {:db/id #edb/ref 17592186297358} {:db/id #edb/ref 17592186488350} {:db/id #edb/ref 17592186488353} {:db/id #edb/ref 17592186488365} {:db/id #edb/ref 17592186488377} {:db/id #edb/ref 17592186514423}] :knowledge-point/title "Integrating a Sum of Exponential Functions"} :step/id #uuid "c64b94e8-f57d-5360-9a8d-ce365fb8c43d" :step/math-academy-id 1379}] :activity/title "Integrating Exponential Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064408}]}
