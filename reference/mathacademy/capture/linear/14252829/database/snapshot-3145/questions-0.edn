#{[{:db/id #edb/ref 17592186064049 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064171 :knowledge-point/id #uuid "3f9548e6-28ef-5a97-ab04-dfb1b6e23c16" :knowledge-point/title "Integrating the Exponential Function"}] :question/id #uuid "3ff03590-c618-5a60-b2ac-e0a20be6a8ae" :question/math-academy-id "e-377" :question/problem "Calculate $\\displaystyle \\int 6e^x  \\textrm d x.$" :question/worked-solution "Factoring out the constant $6$ and taking the integral, we get\n\n$$\n\\eqalign{\n\\int 6e^x   \\textrm d x   =6 \\int e^x  \\, \\textrm d x =6e^x +C.\n                                                                               \n}\n$$"}] [{:db/id #edb/ref 17592186064050 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064172 :knowledge-point/id #uuid "8bd8c6d8-0b11-5735-88a1-9b12e6315401" :knowledge-point/title "Integrating an Exponential Function With a General Base"}] :question/id #uuid "66cbcaeb-93ee-5c15-a230-e66d2fbdd761" :question/math-academy-id "e-380" :question/problem "Calculate $\\displaystyle \\int -6(7^x) \\, \\textrm d x.$" :question/worked-solution "First, we factor out the constant $-6.$ Then, we integrate the exponential function, and get\n\n$$\n\\eqalign{\n\\int (-6)7^x  \\, \\textrm d x   \n&= -6\\int 7^x\\,\\textrm{d}x\\\n&=-6 \\cdot \\dfrac{7^x}{\\ln 7} + C.\n}\n$$"}] [{:db/id #edb/ref 17592186064051 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064177 :knowledge-point/id #uuid "980bb2fb-4bb5-5cbb-aea8-87010493c013" :knowledge-point/title "Integrating a Sum of Exponential Functions"}] :question/id #uuid "90010ae5-e211-510f-b188-dc3006926d94" :question/math-academy-id "e-381" :question/problem "Calculate $\\displaystyle \\int 5 \\cdot 9^x +3 e^x \\, \\textrm d x.$" :question/worked-solution "Apply the sum rule and take constant factors outside the integrals. Then integrate each exponential:\n\n$$\n\\begin{aligned}\n\\int \\left(5\\cdot 9^x+3e^x\\right)\\,\\mathrm{d}x\n&=5\\int 9^x\\,\\mathrm{d}x+3\\int e^x\\,\\mathrm{d}x \\\\\n&=\\frac{5\\cdot 9^x}{\\ln 9}+3e^x+C.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573895 :knowledge-point/_questions [{:db/id #edb/ref 17592186064171 :knowledge-point/id #uuid "3f9548e6-28ef-5a97-ab04-dfb1b6e23c16" :knowledge-point/title "Integrating the Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ae25c7f-44cb-5189-a1d0-644fd3146f1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {e}^{2x}+C" :db/id #edb/ref 17592186573451} {:answer/id #uuid "6bcaf640-1def-5f3f-84bc-9e753fd3979d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{\\pi x}+C" :db/id #edb/ref 17592186573555} {:answer/id #uuid "a8edbe47-2393-5cd6-b612-cfaa0aebf56b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi {e}^{x}}+C" :db/id #edb/ref 17592186573643} {:answer/id #uuid "aa04a8fe-0d68-5cd3-84a1-8b67229f2002" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}{e}^{x}+C" :db/id #edb/ref 17592186573644} {:answer/id #uuid "d613ae8f-6382-57b9-800e-873ef80c1a41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2{e}^{x}}+C" :db/id #edb/ref 17592186573708}] :answer-field/correct {:answer/id #uuid "aa04a8fe-0d68-5cd3-84a1-8b67229f2002" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}{e}^{x}+C" :db/id #edb/ref 17592186573644} :answer-field/id #uuid "4e609dbc-39c8-5f0a-b78b-cc260c4aa431" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573803}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7338807d-a806-5642-ae5c-0fdf182692d4" :question/math-academy-id "q-113858" :question/problem "$\\int \\frac{\\pi }{2}{e}^{x}\\,\\text{d}x=$" :question/worked-solution "Factoring out the constant $\\frac{\\pi }{2}$ and calculating the resulting integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\pi }{2}{e}^{x}\\,\\text{d}x & =\\frac{\\pi }{2}\\int {e}^{x}\\,\\text{d}x \\\\  & =\\frac{\\pi }{2}{e}^{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250132 :knowledge-point/_questions [{:db/id #edb/ref 17592186064172 :knowledge-point/id #uuid "8bd8c6d8-0b11-5735-88a1-9b12e6315401" :knowledge-point/title "Integrating an Exponential Function With a General Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14fd8908-86c1-5758-81a1-2ec277f68aa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{1}{8})}^{x}ln⁡8+C" :db/id #edb/ref 17592186247614} {:answer/id #uuid "1d42c3ea-2473-5c66-8a3d-af03c336005b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{(\\frac{1}{8})}^{x}}{ln⁡8}+C" :db/id #edb/ref 17592186247681 :task-item/_responses [{:db/id #edb/ref 17592186569423}]} {:answer/id #uuid "5253b616-1982-56f6-8a9e-7ac1838f5f20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{ln⁡x}{ln⁡8}+C" :db/id #edb/ref 17592186248162} {:answer/id #uuid "57f12027-6306-5a43-b276-eb500592f0a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{ln⁡x}{{8}^{x}}+C" :db/id #edb/ref 17592186248222} {:answer/id #uuid "7f8980f3-ea7f-50a6-9c9c-7812ebfc0549" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{8}^{x}}{ln⁡8}+C" :db/id #edb/ref 17592186248544}] :answer-field/correct {:answer/id #uuid "1d42c3ea-2473-5c66-8a3d-af03c336005b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{(\\frac{1}{8})}^{x}}{ln⁡8}+C" :db/id #edb/ref 17592186247681} :answer-field/id #uuid "8d70d61a-ae6a-57e0-bc6d-72a634f609db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249920}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "89cd3b1f-2f20-5813-8f46-6c4d05bd7fcb" :question/math-academy-id "q-113893" :question/problem "Calculate $\\int {(\\frac{1}{8})}^{x}\\,\\text{d}x.$" :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {(\\frac{1}{8})}^{x}\\,\\text{d}x & =\\frac{{(\\frac{1}{8})}^{x}}{ln⁡(\\frac{1}{8})}+C\\end{aligned}\n$$\n\nUsing the laws of logarithms, we have that\n\n$$\n\\begin{aligned}ln⁡(\\frac{1}{8}) & =ln⁡1-ln⁡8 \\\\  & =0-ln⁡8 \\\\  & =-ln⁡8.\\end{aligned}\n$$\n\nSo, we can simplify our final answer as follows:\n\n$$\n\\begin{aligned}\\frac{{(\\frac{1}{8})}^{x}}{ln⁡(\\frac{1}{8})}+C=-\\frac{{(\\frac{1}{8})}^{x}}{ln⁡8}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573873 :knowledge-point/_questions [{:db/id #edb/ref 17592186064177 :knowledge-point/id #uuid "980bb2fb-4bb5-5cbb-aea8-87010493c013" :knowledge-point/title "Integrating a Sum of Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ef97020-6eb8-5032-b55f-e4a453646fce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{2}^{x}}{\\operatorname{ln}⁡x}-4{e}^{x}+C" :db/id #edb/ref 17592186573481} {:answer/id #uuid "73be6da6-0e94-54d9-8e28-80823daf499f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{4}^{x}}{\\operatorname{ln}⁡4}-{e}^{2x}+C" :db/id #edb/ref 17592186573570} {:answer/id #uuid "961567fa-ad39-5dac-88d0-0e3ca76b9942" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{4}^{2x}}{\\operatorname{ln}⁡4}-2{e}^{x}+C" :db/id #edb/ref 17592186573619} {:answer/id #uuid "9dea4f6b-88de-50bf-9e41-7c205c1d30dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{4}^{x}}{\\operatorname{ln}⁡4}-{e}^{x}+C" :db/id #edb/ref 17592186573629} {:answer/id #uuid "a75dd416-691c-506d-bff3-36ed676c1925" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{\\operatorname{ln}⁡4}-{e}^{x}+C" :db/id #edb/ref 17592186573641}] :answer-field/correct {:answer/id #uuid "9dea4f6b-88de-50bf-9e41-7c205c1d30dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{4}^{x}}{\\operatorname{ln}⁡4}-{e}^{x}+C" :db/id #edb/ref 17592186573629} :answer-field/id #uuid "f535bffb-209d-5bbf-838b-5473917b087a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573860}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "149a14d8-d9d3-538d-9d01-436b9432ab15" :question/math-academy-id "q-2279" :question/problem "$\\int ({4}^{x}-{e}^{x})\\,\\text{d}x=$" :question/worked-solution "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int ({4}^{x}-{e}^{x})\\,\\text{d}x & =\\int {4}^{x}\\,\\text{d}x-\\int {e}^{x}\\,\\text{d}x \\\\  & =\\frac{{4}^{x}}{\\operatorname{ln}⁡4}-{e}^{x}+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290438 :knowledge-point/_questions [{:db/id #edb/ref 17592186064177 :knowledge-point/id #uuid "980bb2fb-4bb5-5cbb-aea8-87010493c013" :knowledge-point/title "Integrating a Sum of Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25701e43-e3df-5d1e-8ac3-09bcc9dcf7bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{9}^{x}}{\\operatorname{ln}⁡9}+3{e}^{x}+C" :db/id #edb/ref 17592186288280} {:answer/id #uuid "5a21abb6-314e-594e-906a-fc211f164a2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡9}{{9}^{x}}+{e}^{x}+C" :db/id #edb/ref 17592186288662} {:answer/id #uuid "ce26c9e7-48dc-50a0-bce8-7f40380eb504" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{9}}{\\operatorname{ln}⁡9}-3{e}^{x}+C" :db/id #edb/ref 17592186289408} {:answer/id #uuid "d1df1022-beed-5ec0-bcb0-27462f2a142b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{\\operatorname{ln}⁡x}+{e}^{3x}+C" :db/id #edb/ref 17592186289424} {:answer/id #uuid "d501df4f-3f69-522d-8918-2f3e4ab83e19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{\\operatorname{ln}⁡9}-3{e}^{x}+C" :db/id #edb/ref 17592186289447}] :answer-field/correct {:answer/id #uuid "25701e43-e3df-5d1e-8ac3-09bcc9dcf7bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{9}^{x}}{\\operatorname{ln}⁡9}+3{e}^{x}+C" :db/id #edb/ref 17592186288280} :answer-field/id #uuid "4104beee-ecab-54db-ad41-31088e6669ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289877}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "58d4516f-1cdf-5b1c-9320-38f5fe340903" :question/math-academy-id "q-2281" :question/problem "$\\int ({9}^{x}+3{e}^{x})\\,\\text{d}x=$" :question/worked-solution "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int ({9}^{x}+3{e}^{x})\\,\\text{d}x & =\\int {9}^{x}\\,\\text{d}x+3\\int {e}^{x}\\,\\text{d}x \\\\  & =\\frac{{9}^{x}}{\\operatorname{ln}⁡9}+3{e}^{x}+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064889 :knowledge-point/_questions [{:db/id #edb/ref 17592186064177 :knowledge-point/id #uuid "980bb2fb-4bb5-5cbb-aea8-87010493c013" :knowledge-point/title "Integrating a Sum of Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1508f44-ef2f-5fb2-833b-2c1cdbc1f242" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{2x} + \\frac{4^{x}}{\\ln 4} - x^{2} + C" :db/id #edb/ref 17592186063391} {:answer/id #uuid "fb1b5947-8324-568d-a1eb-6bab88724f99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{2x} + \\frac{x^{4}}{\\ln 4} - x^{2} + C" :db/id #edb/ref 17592186063392} {:answer/id #uuid "10820fcc-08b9-5665-9f14-e212298a861f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{2x} + \\frac{x^{4}}{\\ln 4} - 2x^{2} + C" :db/id #edb/ref 17592186063393} {:answer/id #uuid "1aa00c79-92f8-5479-b7be-d4906d2fca5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e^{x} + 4^{x}\\ln 4 - \\frac{x^{2}}{2} + C" :db/id #edb/ref 17592186063394} {:answer/id #uuid "64107285-5bce-5d52-ac18-a3e7155a4f0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e^{x} + \\frac{4^{x}}{\\ln 4} - x^{2} + C" :db/id #edb/ref 17592186063395}] :answer-field/id #uuid "6518b595-b387-521a-bcc0-05e2bc70cceb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186063390}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c5ef23df-cb86-53d4-a2bd-c06a8017fa2b" :question/math-academy-id "q-51102" :question/problem "What is $\\displaystyle \\int(2e^{x} + 4^{x} - 2x)dx$?"}] [{:db/id #edb/ref 17592186573944 :knowledge-point/_questions [{:db/id #edb/ref 17592186064172 :knowledge-point/id #uuid "8bd8c6d8-0b11-5735-88a1-9b12e6315401" :knowledge-point/title "Integrating an Exponential Function With a General Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07836247-f997-5dfb-b77d-a88bd5744dd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{(\\frac{1}{3})}^{x}}{\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186573432} {:answer/id #uuid "3c5b76da-5c79-5570-96fc-a1071399ac45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{(\\frac{1}{3})}^{x}}{3\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186573497} {:answer/id #uuid "8096f421-e949-50b4-8f19-80003343c718" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{(\\frac{1}{3})}^{x}+C" :db/id #edb/ref 17592186573592} {:answer/id #uuid "d2eb6285-99de-51bb-896a-d2849f05a9d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\operatorname{ln}⁡3{(\\frac{1}{3})}^{x}+C" :db/id #edb/ref 17592186573702} {:answer/id #uuid "ec976108-75b3-594d-8698-a417623ef1c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3{(\\frac{1}{3})}^{x}+C" :db/id #edb/ref 17592186573734}] :answer-field/correct {:answer/id #uuid "07836247-f997-5dfb-b77d-a88bd5744dd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{(\\frac{1}{3})}^{x}}{\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186573432} :answer-field/id #uuid "2cf68b31-cd10-5161-95fb-e446441e1ca2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573787}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f3a89c81-1f21-57c4-8472-9cb98515b280" :question/math-academy-id "q-71910" :question/problem "Calculate $\\int {(\\frac{1}{3})}^{x}\\,\\text{d}x.$" :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {(\\frac{1}{3})}^{x}\\,\\text{d}x & =\\frac{{(\\frac{1}{3})}^{x}}{\\operatorname{ln}⁡(\\frac{1}{3})}+C\\end{aligned}\n$$\n\nUsing the laws of logarithms, we have that\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(\\frac{1}{3}) & =\\operatorname{ln}⁡1-\\operatorname{ln}⁡3 \\\\  & =0-\\operatorname{ln}⁡3 \\\\  & =-\\operatorname{ln}⁡3.\\end{aligned}\n$$\n\nSo, we can simplify our final answer as follows:\n\n$$\n\\begin{aligned}\\frac{{(\\frac{1}{3})}^{x}}{\\operatorname{ln}⁡(\\frac{1}{3})}+C &=-\\frac{{(\\frac{1}{3})}^{x}}{\\operatorname{ln}⁡3}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339011 :knowledge-point/_questions [{:db/id #edb/ref 17592186064171 :knowledge-point/id #uuid "3f9548e6-28ef-5a97-ab04-dfb1b6e23c16" :knowledge-point/title "Integrating the Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2617015a-5455-5667-ad50-b136e5b1fa55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5{e}^{x}+C" :db/id #edb/ref 17592186336390} {:answer/id #uuid "3a23d2fc-a7aa-5d1c-9864-c7a6153600b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}{e}^{x}+C" :db/id #edb/ref 17592186336580} {:answer/id #uuid "58f93f66-db36-5c48-881b-168f6ab9b1da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}+C" :db/id #edb/ref 17592186336846} {:answer/id #uuid "91871bd5-c6b8-54e1-afe7-328451f3d7cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{e}^{5x}+C" :db/id #edb/ref 17592186337348} {:answer/id #uuid "d7c559ce-e0d7-5005-92d4-45151197edcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-5x}+C" :db/id #edb/ref 17592186337906}] :answer-field/correct {:answer/id #uuid "2617015a-5455-5667-ad50-b136e5b1fa55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5{e}^{x}+C" :db/id #edb/ref 17592186336390} :answer-field/id #uuid "a5cc0952-0c9f-5522-9ba6-3e6da71b3cd2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338585}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d0db7f6e-faf8-548f-9f7b-4ca5b8b122ae" :question/math-academy-id "q-71914" :question/problem "$\\int -5{e}^{x}\\,\\text{d}x=$" :question/worked-solution "Factoring out the constant $-5$ and calculating the resulting integral, we get\n\n$$\n\\begin{aligned}\\int -5{e}^{x}\\,\\text{d}x & =-5\\int {e}^{x}\\,\\text{d}x \\\\  & =-5{e}^{x}+C.\\end{aligned}\n$$"}]}
