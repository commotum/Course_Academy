#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186544907} :activity/id #uuid "e36e2817-44dd-5f9f-b222-4aa63a5581d2" :activity/scope {:db/id #edb/ref 17592186050497 :topic/id #uuid "4dd99b27-25f2-551e-b641-cafc64c1d0b4" :topic/math-academy-id 393} :activity/steps [{:db/id #edb/ref 17592186544897 :step/content {:db/id #edb/ref 17592186544893 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "608d4cf7-57b3-5aae-9566-064dbc4e835d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186544298}] :answer-field/correct {:db/id #edb/ref 17592186544298} :answer-field/id #uuid "66d8e3c9-6afe-5ab2-96bf-1bf5d0f43e5d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186544698} {:answer-field/choices [{:answer/id #uuid "f0f1bd98-1288-5f98-87df-88a402ce918b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186544608}] :answer-field/correct {:db/id #edb/ref 17592186544608} :answer-field/id #uuid "6a4a1367-8323-5342-9d93-3dcdfa929460" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186544703}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "eda5f44d-20e8-5e57-ad4a-984bec77ae99" :question/math-academy-id "q-223729" :question/problem "In **ascending order**, the solutions to $5{p}^{2}=3p$ are $p=${{field-1}} and $p=$\n{{field-2}}." :question/worked-solution "First, we move all of the terms to the left-hand side and then factor:\n\n$$\n\\begin{aligned}5{p}^{2} & =3p \\\\ 5{p}^{2}-3p & =0 \\\\ p(5p-3) & =0\\end{aligned}\n$$\n\nSo, by the zero product rule, we have\n\n$$\np=0\\,\\text{or}\\,5p-3=0,\n$$\n\nwhich in turn gives\n\n$$\np=0\\,\\text{or}\\,p=\\frac{3}{5}.\n$$\n\nTherefore, the solutions are $p=0$ and $p=\\frac{3}{5}.$"} :step/id #uuid "01535422-d9f2-5d71-a038-27ff6a878cc3" :step/next {:db/id #edb/ref 17592186544984}} {:db/id #edb/ref 17592186544907 :step/content {:db/id #edb/ref 17592186544891 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fed37bd-ffc2-55cd-8012-e2fb109c4833" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s=0,1" :db/id #edb/ref 17592186544294} {:answer/id #uuid "b3ea3018-3bc2-5df5-97d2-d21d26114e9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s=-1,0" :db/id #edb/ref 17592186544467} {:answer/id #uuid "ba7ded0d-2929-5550-8969-007749e21782" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s=-1" :db/id #edb/ref 17592186544484} {:answer/id #uuid "bce0fbd8-e3a8-586a-8e62-a96b5ac0ffe6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s=0" :db/id #edb/ref 17592186544488} {:answer/id #uuid "e88b13bd-df5f-51b3-a5bb-08db871b5b91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s=1" :db/id #edb/ref 17592186544589}] :answer-field/correct {:db/id #edb/ref 17592186544467} :answer-field/id #uuid "079ba6f6-a15e-5361-bff8-b7ea93504fce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544653}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e6e37409-094d-5a1f-ac21-68506e2e806b" :question/math-academy-id "q-80060" :question/problem "Solve the equation $2s+5{s}^{2}=s+4{s}^{2}.$" :question/worked-solution "First, we move all of the terms to the left-hand side and then factor:\n\n$$\n\\begin{aligned}2s+5{s}^{2} & =s+4{s}^{2} \\\\ 2s+5{s}^{2}-(s+4{s}^{2}) & =0 \\\\ 2s+5{s}^{2}-s-4{s}^{2} & =0 \\\\ (5{s}^{2}-4{s}^{2})+(2s-s) & =0 \\\\ {s}^{2}+s & =0 \\\\ s(s+1) & =0\\end{aligned}\n$$\n\nThen, we apply the zero product rule to get\n\n$$\ns=0\\,\\text{or}\\,s+1=0,\n$$\n\nwhich in turn gives\n\n$$\ns=0\\,\\text{or}\\,s=-1.\n$$\n\nTherefore, the solutions are $s=-1,0.$"} :step/id #uuid "1dd7a40c-9bb0-59b5-8473-db35e518eb6d" :step/next {:db/id #edb/ref 17592186544897}} {:db/id #edb/ref 17592186544984 :step/content {:db/id #edb/ref 17592186544831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5468f005-5491-5c41-9fe4-0409f68e2c19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186544274}] :answer-field/correct {:db/id #edb/ref 17592186544274} :answer-field/id #uuid "0a16048c-c4fb-5782-927d-c81f3f23f337" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186544654} {:answer-field/choices [{:answer/id #uuid "b985d1dc-f347-5ddb-b4a1-89beddfab1e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186544480}] :answer-field/correct {:db/id #edb/ref 17592186544480} :answer-field/id #uuid "618b8d76-2d69-54e2-a3fc-f3bca2c2fe87" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186544694}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7228245a-4caf-5105-bd90-6c52f7ce3f5f" :question/math-academy-id "q-223793" :question/problem "In **ascending order**, the solutions to $-7{d}^{2}=-49d$ are $d=${{field-1}} and $d=$\n{{field-2}}." :question/worked-solution "First, we move all of the terms to the left-hand side and then factor:\n\n$$\n\\begin{aligned}-7{d}^{2} & =-49d \\\\ -7{d}^{2}+49d & =0 \\\\ -7d(d-7) & =0\\end{aligned}\n$$\n\nThen, we apply the zero product rule to get\n\n$$\n-7d=0\\,\\text{or}\\,d-7=0,\n$$\n\nwhich in turn gives\n\n$$\nd=0\\,\\text{or}\\,d=7.\n$$\n\nTherefore, the solutions are $d=0$ and $d=7.$"} :step/id #uuid "e49732a4-09b5-572c-b2ea-486045291959"}] :activity/title "Solving Quadratic Equations with No Constant Term" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186544082}]}
