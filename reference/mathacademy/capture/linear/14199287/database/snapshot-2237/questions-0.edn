#{[{:db/id #edb/ref 17592186515578 :knowledge-point/_questions [{:db/id #edb/ref 17592186054670 :knowledge-point/id #uuid "5d4a21cd-bd8d-5572-b932-76875827170a" :knowledge-point/title "Computing the Terms of a Fibonacci Sequence Given in Sequence Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b068704-3180-59a1-b01b-5e7e1c4e6db8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186515039} {:answer/id #uuid "61f8c25d-854a-5100-ac32-71bc61d491c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186515084} {:answer/id #uuid "6d11ffbc-8de8-5be4-996f-e24c275de6f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186515098} {:answer/id #uuid "afa5ae3b-a83a-51a5-9c96-b3c49d4685e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186515241} {:answer/id #uuid "d0b4d9da-b6fd-587d-bfb7-fc901f83469f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186515309}] :answer-field/correct {:answer/id #uuid "61f8c25d-854a-5100-ac32-71bc61d491c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186515084} :answer-field/id #uuid "6d59a4a8-c488-5e3c-8591-ed1508ff985d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515447}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "99e2d98d-7a51-5b32-adc6-16bc3dbb4639" :question/math-academy-id "q-103212" :question/problem "If ${a}_{n+2}={a}_{n+1}+{a}_{n}$ with ${a}_{1}=-1$ and ${a}_{2}=1,$ then ${a}_{4}=$" :question/worked-solution "To compute ${a}_{4},$ we first need to compute ${a}_{3}.$ So, we substitute $n=1$ into the recursive formula, as follows:\n\n$$\n\\begin{aligned}{a}_{n+2} & ={a}_{n+1}+{a}_{n} \\\\ {a}_{1+2} & ={a}_{1+1}+{a}_{1} \\\\ {a}_{3} & ={a}_{2}+{a}_{1} \\\\ {a}_{3} & =1+(-1) \\\\ {a}_{3} & =0\\end{aligned}\n$$\n\nNext, to compute ${a}_{4},$ we substitute $n=2$ into the recursive formula:\n\n$$\n\\begin{aligned}{a}_{2+2} & ={a}_{2+1}+{a}_{2} \\\\ {a}_{4} & ={a}_{3}+{a}_{2} \\\\ {a}_{4} & =0+1 \\\\ {a}_{4} & =1\\end{aligned}\n$$\n\nTherefore, ${a}_{4}=1.$"}] [{:db/id #edb/ref 17592186515566 :knowledge-point/_questions [{:db/id #edb/ref 17592186054670 :knowledge-point/id #uuid "5d4a21cd-bd8d-5572-b932-76875827170a" :knowledge-point/title "Computing the Terms of a Fibonacci Sequence Given in Sequence Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fc8ec28-19c8-5852-81cc-746aa47573fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186514978} {:answer/id #uuid "2fd1a056-23c0-5b19-89c0-76e6eedfb9fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186514979} {:answer/id #uuid "4d62557c-a761-57e0-a0f9-8fb42f0b2d5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186515043} {:answer/id #uuid "57173a82-4d10-53b7-9556-2b3b2634fb28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "55" :db/id #edb/ref 17592186515067} {:answer/id #uuid "b5d9d0f3-272c-5aca-a108-a7631f749ccc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186515255}] :answer-field/correct {:answer/id #uuid "2fd1a056-23c0-5b19-89c0-76e6eedfb9fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186514979} :answer-field/id #uuid "74483277-d70b-52c9-b96e-d2190f446b89" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515450}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7ca39e1b-3be6-5060-ba61-ae9bf319f824" :question/math-academy-id "q-103220" :question/problem "The recursive formula for the Fibonacci numbers is \n\n$$\n{a}_{n+2}={a}_{n+1}+{a}_{n},\\,{a}_{1}={a}_{2}=1,\\,n\\ge 1.\n$$\n\nWhat is the eighth number in the sequence?" :question/worked-solution "Substituting $n=1$ into the recursive formula gives:\n\n$$\n\\begin{aligned}{a}_{1+2} & ={a}_{1+1}+{a}_{1} \\\\ {a}_{3} & ={a}_{2}+{a}_{1} \\\\ {a}_{3} & =1+1 \\\\ {a}_{3} & =2\\end{aligned}\n$$\n\nSubstituting $n=2$ into the recursive formula gives:\n\n$$\n\\begin{aligned}{a}_{2+2} & ={a}_{2+1}+{a}_{2} \\\\ {a}_{4} & ={a}_{3}+{a}_{2} \\\\ {a}_{4} & =2+1 \\\\ {a}_{4} & =3\\end{aligned}\n$$\n\nSubstituting $n=3$ into the recursive formula gives:\n\n$$\n\\begin{aligned}{a}_{3+2} & ={a}_{3+1}+{a}_{3} \\\\ {a}_{5} & ={a}_{4}+{a}_{3} \\\\ {a}_{5} & =3+2 \\\\ {a}_{5} & =5\\end{aligned}\n$$\n\nSubstituting $n=4$ into the recursive formula gives:\n\n$$\n\\begin{aligned}{a}_{4+2} & ={a}_{4+1}+{a}_{4} \\\\ {a}_{6} & ={a}_{5}+{a}_{4} \\\\ {a}_{6} & =5+3 \\\\ {a}_{6} & =8\\end{aligned}\n$$\n\nSubstituting $n=5$ into the recursive formula gives:\n\n$$\n\\begin{aligned}{a}_{5+2} & ={a}_{5+1}+{a}_{5} \\\\ {a}_{7} & ={a}_{6}+{a}_{5} \\\\ {a}_{7} & =8+5 \\\\ {a}_{7} & =13\\end{aligned}\n$$\n\nSubstituting $n=6$ into the recursive formula gives:\n\n$$\n\\begin{aligned}{a}_{6+2} & ={a}_{6+1}+{a}_{6} \\\\ {a}_{8} & ={a}_{7}+{a}_{6} \\\\ {a}_{8} & =13+8 \\\\ {a}_{8} & =21\\end{aligned}\n$$\n\nTherefore, $21$ is the eighth number in the sequence."}] [{:db/id #edb/ref 17592186515589 :knowledge-point/_questions [{:db/id #edb/ref 17592186054671 :knowledge-point/id #uuid "549d3c1f-305c-5d21-a3cf-863fb0ff1614" :knowledge-point/title "Computing the Terms of a Fibonacci Sequence Given in Function Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48a0c375-e447-584a-adc5-cd97b9bc69fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186515026}] :answer-field/correct {:answer/id #uuid "48a0c375-e447-584a-adc5-cd97b9bc69fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186515026} :answer-field/id #uuid "19c46680-9993-5640-98e9-22ab2e77aae6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186515417}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b81eff41-cfe8-5cbc-b97f-aeed5d4a52b5" :question/math-academy-id "q-214157" :question/problem "If\n$f(n+2)=f(n+1)+f(n)$\nwith\n$f(1)=7$ and $f(2)=-2,$\nthen $f(8)=${{field-1}}." :question/worked-solution "The recursion relation is\n\n$$\nf(n+2)=f(n+1)+f(n).\n$$\n\nSubstituting $n=1$ into the recursive formula gives:\n\n$$\n\\begin{aligned}f(1+2) & =f(1+1)+f(1) \\\\ f(3) & =f(2)+f(1) \\\\ f(3) & =(-2)+7 \\\\ f(3) & =5\\end{aligned}\n$$\n\nSubstituting $n=2$ into the recursive formula gives:\n\n$$\n\\begin{aligned}f(2+2) & =f(2+1)+f(2) \\\\ f(4) & =f(3)+f(2) \\\\ f(4) & =5+(-2) \\\\ f(4) & =3\\end{aligned}\n$$\n\nSimilarly, substituting $n=3,4,5,6$ into the recursive formula gives:\n\n$$\n\\begin{aligned}f(5) & =f(3+2)=f(3+1)+f(3)=f(4)+f(3)=3+5=8, \\\\ f(6) & =f(4+2)=f(4+1)+f(4)=f(5)+f(4)=8+3=11, \\\\ f(7) & =f(5+2)=f(5+1)+f(5)=f(6)+f(5)=11+8=19, \\\\ f(8) & =f(6+2)=f(6+1)+f(6)=f(7)+f(6)=19+11=30.\\end{aligned}\n$$\n\nHence, $f(8)=30.$"}]}
