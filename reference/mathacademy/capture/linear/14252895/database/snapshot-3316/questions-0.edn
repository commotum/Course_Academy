#{[{:db/id #edb/ref 17592186233141 :knowledge-point/_questions [{:db/id #edb/ref 17592186064277 :knowledge-point/id #uuid "f7019d52-33a1-5968-9a93-2f2f06fbb0d6" :knowledge-point/title "Multiplying Trinomials"}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e08294c6-a979-573d-8467-4eac7fae6a3e" :question/math-academy-id "q-111362" :question/problem "Given that  $(3{s}^{2}+2s+4)({s}^{2}+3s+2)=3{s}^{4}+a{s}^{3}+b{s}^{2}+cs+8,$ calculate $a+b+c.$" :question/worked-solution "We distribute all three terms of the trinomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(3{s}^{2}+2s+4)({s}^{2}+3s+2) & = \\\\ 3{s}^{2}({s}^{2}+3s+2)+(2s)({s}^{2}+3s+2)+(4)({s}^{2}+3s+2) & = \\\\ 3{s}^{4}+9{s}^{3}+6{s}^{2}+2{s}^{3}+6{s}^{2}+4s+4{s}^{2}+12s+8 & = \\\\ 3{s}^{4}+11{s}^{3}+16{s}^{2}+16s+8\\end{aligned}\n$$\n\nTherefore, $a=11,$ $b=16,$ and $c=16.$ So, \n\n$$\na+b+c=11+16+16=43.\n$$"}] [{:db/id #edb/ref 17592186399961 :knowledge-point/_questions [{:db/id #edb/ref 17592186105871 :knowledge-point/id #uuid "6445834c-7788-5427-a72c-30b06cc8e6ab" :knowledge-point/title "Calculating the Area of an Isosceles Right Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e208d2b-dec6-562a-a378-e1098ccc8637" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "113" :db/id #edb/ref 17592186399963} {:answer/id #uuid "95086ebb-7581-57b3-a760-1b80ee3581dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186399964} {:answer/id #uuid "d51ba212-184c-5759-8461-dffee9f36c0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72.5" :db/id #edb/ref 17592186399965} {:answer/id #uuid "6365eea9-1bba-56eb-bc53-b9734f86d4ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84.5" :db/id #edb/ref 17592186399966} {:answer/id #uuid "d5f4da11-8df3-5c32-9ef0-645590937087" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "169" :db/id #edb/ref 17592186399967}] :answer-field/correct {:answer/id #uuid "6365eea9-1bba-56eb-bc53-b9734f86d4ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84.5" :db/id #edb/ref 17592186399966} :answer-field/id #uuid "564afc56-93e1-5116-bc1b-3a39fadf5bbd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399962}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3b82680f-f801-5d98-98f5-3b30c67dd0ca" :question/math-academy-id "q-117347" :question/problem "![](images/4a/4aa952124ddaaa1dc2a54ebb4601255ae42346a9e02f02391c05453a81542505.png)\n\nWhat is the area of the right triangle $ABC$ shown above?" :question/worked-solution "Since $m∠A=m∠C={45}^{∘}$ and $AB=BC,$ we have an isosceles right triangle. \n\n![](images/67/670afdec3633984b2fb493706e762740062348ccbdd0f56df14e3add3d4bbd23.png)\n\nTherefore, the area of the triangle is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}AB\\cdot BC \\\\  & =\\frac{1}{2}\\cdot {13}^{2} \\\\  & =\\frac{1}{2}\\cdot 169 \\\\  & =84.5\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186125027 :knowledge-point/_questions [{:db/id #edb/ref 17592186124564 :knowledge-point/id #uuid "7ec3d139-c43a-5547-b0ae-147e41a55180" :knowledge-point/title "Identifying the Global Minimum of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "952b9614-1c48-5e7e-aa39-73bf3282732b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0, 0)" :db/id #edb/ref 17592186122763} {:answer/id #uuid "d19843fd-85d3-577d-9bac-0e1c6682a024" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3, 2)" :db/id #edb/ref 17592186122764} {:answer/id #uuid "396d3df0-4215-5974-9ead-a960e8adb3fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-0.5,-1)" :db/id #edb/ref 17592186122765} {:answer/id #uuid "62a3da70-7f35-518f-81b8-335d54fc568c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3, 0)" :db/id #edb/ref 17592186122766} {:answer/id #uuid "6de59753-24c5-5ff5-959c-5a4511a3425a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-4)" :db/id #edb/ref 17592186122767}] :answer-field/id #uuid "384047e4-5971-5a12-896e-9cbbe096b46a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122762}] :question/id #uuid "6881735b-cf8d-5bd1-be6c-cf22189f242d" :question/math-academy-id "q-37054" :question/problem "![](images/bc/bc5f414f394a535ca2a1cfcc8c9d8f48d092184f26b3499c80fb55c1af129e95.png)\n\nWhat is the global minimum point of the function shown above?"}]}
