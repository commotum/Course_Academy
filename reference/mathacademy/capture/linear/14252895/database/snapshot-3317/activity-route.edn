#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186575661} :activity/id #uuid "f499a51b-0375-5fe9-adef-ba2c3ffe0ed5" :activity/steps [{:db/id #edb/ref 17592186575632 :step/content {:db/id #edb/ref 17592186575527 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fcc5bc51-ebe5-5f7b-8b5e-1457adb75f01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "27" :db/id #edb/ref 17592186575403}] :answer-field/correct {:db/id #edb/ref 17592186575403} :answer-field/id #uuid "b99fd557-903d-52f2-b885-ba116704ea23" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186575488}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "03d1d0b4-f385-5136-a615-f2e1e9fef632" :question/math-academy-id "q-338386" :question/problem "Find the **exact** value of the limit.\n\n${lim}_{x\\to 0}\\sqrt{(3{x}^{2}+6x+9)^{3}}=$\n{{field-1}}" :question/worked-solution "Applying the root rule, we get\n\n \n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\sqrt{(3{x}^{2}+6x+9)^{3}} & =\\sqrt{{lim}_{x\\to 0}(3{x}^{2}+6x+9)^{3}} \\\\  & =\\sqrt{{({lim}_{x\\to 0}(3{x}^{2}+6x+9))}^{3}} \\\\  & =\\sqrt{(3(0)^{2}+6(0)+9)^{3}} \\\\  & =\\sqrt{(0+0+9)^{3}} \\\\  & =\\sqrt{{9}^{3}} \\\\  & =\\sqrt{729} \\\\  & =27.\\end{aligned}\n$$"} :step/id #uuid "1786b470-22a1-5126-81ff-d7683858760a" :step/next {:db/id #edb/ref 17592186575662}} {:db/id #edb/ref 17592186575634 :step/content {:db/id #edb/ref 17592186575563 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13486019-a392-57be-a337-f52f79477f44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=|x-1|-4" :db/id #edb/ref 17592186574981} {:answer/id #uuid "3cfff7a7-330b-572e-90cb-b9b5dddb8228" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=|x+4|-1" :db/id #edb/ref 17592186575054} {:answer/id #uuid "42b5a490-0ee5-549d-8703-5b5cf81273db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=|x+4|+1" :db/id #edb/ref 17592186575064} {:answer/id #uuid "a91352d6-0efc-5355-a4fa-9b60746ec3f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=|x-4|-1" :db/id #edb/ref 17592186575247} {:answer/id #uuid "d81edf6b-b7ac-5848-8692-2e21c1530fbc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=|x+1|-4" :db/id #edb/ref 17592186575336}] :answer-field/correct {:db/id #edb/ref 17592186575054} :answer-field/id #uuid "ea40d3ec-5a65-5f11-9245-74d21f7dd219" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186575517}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "745d6485-4fab-5db3-ad5a-442675f1d8d6" :question/math-academy-id "q-3682" :question/problem "![](images/a3/a32739957ef5ff1bf81f49b1b1baaaab69c6ef3d2613f8ac09ad4020c91c50f7.png)\n\nWhat is the equation of the curve shown above?" :question/worked-solution "Remember that $y=|x-h|+k$ is a vertical translation of the absolute value graph $y=|x|$ by $h$ units right and $k$ units up.\n\nHere, the graph is moved left by $4$ units and down by $1$ unit. This corresponds to $h=-4$ and $k=-1.$ So, the equation of the graph is $y=|x+4|-1.$\n\n![](images/fc/fcaf6e4e5e5fa63724be00a344c725e8bc9095c74c8b1114a0dbe90e9ac31935.png)"} :step/id #uuid "18997cdd-4144-5716-af59-75b7831d1856" :step/next {:db/id #edb/ref 17592186575641}} {:db/id #edb/ref 17592186575641 :step/content {:db/id #edb/ref 17592186575532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10690335-5930-5fef-a862-6eb8da552d97" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186574974} {:answer/id #uuid "1fab5eef-9775-58f4-b57d-cb792b17ff32" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186575001} {:answer/id #uuid "3630b97b-56be-52b8-9178-cb1d3166fdf2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II, III and IV only" :db/id #edb/ref 17592186575041} {:answer/id #uuid "5ff222c4-39ce-5121-9b09-72ad59c1f29e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and IV only" :db/id #edb/ref 17592186575119} {:answer/id #uuid "d7cfb344-0165-53cc-9422-4c18679479dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186575335}] :answer-field/correct {:db/id #edb/ref 17592186575001} :answer-field/id #uuid "75afd0e8-6c0a-5237-becc-83e629f28d7f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186575465}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1ac9a15a-91b5-5333-bd21-1c4aeb66e1dd" :question/math-academy-id "q-67953" :question/problem "![](images/7f/7f021a38a2c0c2098c14b2af479a609e85f6903ec84b4eafc71cb599becee3d9.png)\n\nWhich of the graphs above represent proportional relationships?" :question/worked-solution "Remember that the graph of a proportional relationship is always a straight line that passes through the origin $(0,0).$\n\nOf the given graphs, only graph III fits this description.\n\n- Graph I is not a straight line.\n\n- Graphs II and IV do not pass through the origin $(0,0).$\n\nTherefore, the correct answer is \"III only\"."} :step/id #uuid "24fa352b-f67b-509b-9a54-bff1759f7275"} {:db/id #edb/ref 17592186575643 :step/content {:db/id #edb/ref 17592186575582 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c832b98-50f0-54df-a19b-b731f40d7b8f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-2,-5)$ and $(4,-5)$" :db/id #edb/ref 17592186574994} {:answer/id #uuid "228618c5-7982-5340-bbbe-5a5309961ca7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-2,-5)$ and $(2,-5)$" :db/id #edb/ref 17592186575006} {:answer/id #uuid "61f21a8c-0f7f-5782-adc3-cc79fe53c3e1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-3,0)$ and $(3,0)$" :db/id #edb/ref 17592186575127} {:answer/id #uuid "8c967535-4ab0-58a8-a729-8bc0b2f84aea" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-3,-5)$ and $(3,-5)$" :db/id #edb/ref 17592186575191} {:answer/id #uuid "9600d968-3c28-5e90-826a-fb2d658d24fb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-2,0)$ and $(2,0)$" :db/id #edb/ref 17592186575206}] :answer-field/correct {:db/id #edb/ref 17592186575191} :answer-field/id #uuid "70c3d0a0-cfc9-5368-8e0e-665d3b3527ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186575464}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a422bda1-83e5-5ea1-b276-7fb095067ffb" :question/math-academy-id "q-78760" :question/problem "![](images/61/612a4d26c399f754318b7aceb2bb0f329cf9515ea49a7da0d84d5d4aa1b672ea.png)\n\nUsing the graphical method, find the solutions $(x,y)$ of the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}y &=-5 \\\\ y &=-{x}^{2}+4\\end{aligned}\\right.\n$$" :question/worked-solution "The solutions $(x,y)$ of the system correspond to the intersection points of the two curves.\n\n![](images/6d/6d9da50ac2c05ae16125d48ed96e5a7a7ed1dbc03ddb53e96ab301d502abb17f.png)\n\nWe see from the graph that the curves intersect at \n\n$\\,$ $(-3,-5)\\,$ and $\\,(3,-5).$ \n\nTherefore, these are the solutions of the corresponding system."} :step/id #uuid "2f21507d-cf75-5bfa-9d60-c8df8743ef85" :step/next {:db/id #edb/ref 17592186575683}} {:db/id #edb/ref 17592186575661 :step/content {:db/id #edb/ref 17592186399961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e208d2b-dec6-562a-a378-e1098ccc8637" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "113" :db/id #edb/ref 17592186399963} {:answer/id #uuid "95086ebb-7581-57b3-a760-1b80ee3581dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "80" :db/id #edb/ref 17592186399964} {:answer/id #uuid "d51ba212-184c-5759-8461-dffee9f36c0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "72.5" :db/id #edb/ref 17592186399965} {:answer/id #uuid "6365eea9-1bba-56eb-bc53-b9734f86d4ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "84.5" :db/id #edb/ref 17592186399966} {:answer/id #uuid "d5f4da11-8df3-5c32-9ef0-645590937087" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "169" :db/id #edb/ref 17592186399967}] :answer-field/correct {:db/id #edb/ref 17592186399966} :answer-field/id #uuid "564afc56-93e1-5116-bc1b-3a39fadf5bbd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186399962}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3b82680f-f801-5d98-98f5-3b30c67dd0ca" :question/math-academy-id "q-117347" :question/problem "![](images/4a/4aa952124ddaaa1dc2a54ebb4601255ae42346a9e02f02391c05453a81542505.png)\n\nWhat is the area of the right triangle $ABC$ shown above?" :question/worked-solution "Since $m∠A=m∠C={45}^{∘}$ and $AB=BC,$ we have an isosceles right triangle. \n\n![](images/67/670afdec3633984b2fb493706e762740062348ccbdd0f56df14e3add3d4bbd23.png)\n\nTherefore, the area of the triangle is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}AB\\cdot BC \\\\  & =\\frac{1}{2}\\cdot {13}^{2} \\\\  & =\\frac{1}{2}\\cdot 169 \\\\  & =84.5\\,.\\end{aligned}\n$$"} :step/id #uuid "6db8f8da-3b17-52a5-b393-3a58b8181d61" :step/next {:db/id #edb/ref 17592186575688}} {:db/id #edb/ref 17592186575662 :step/content {:db/id #edb/ref 17592186575566 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23f86dbc-d003-51d1-827e-f13bf7fdff1f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/63/638b44af1e33b78102a0dbfa3857c1292f200e026f54adf92fe77a97bf7e10a1.png" :db/id #edb/ref 17592186575008} {:answer/id #uuid "45465aa1-5e0a-5908-b63c-595a84123bb3" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/7d/7d7303c5608dbd17911794959438f925d7ab6edd3ebba600d657b396ccf8eaa9.png" :db/id #edb/ref 17592186575072} {:answer/id #uuid "982998cd-20b3-5f6f-b36c-446e47274019" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ad/ad5692ee92c2b67f50c0354020642bd9c711bdf7b88f4d476455512e33f9fc5f.png" :db/id #edb/ref 17592186575208} {:answer/id #uuid "d5ac308f-1478-5136-85b9-dc1b3ab87104" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a6/a63dd45bee5f32ae88bbb8fbfc274def0539794cfc3b1e88a34a42583832ef43.png" :db/id #edb/ref 17592186575329} {:answer/id #uuid "fad71dcb-4bdd-5e5e-9ebe-bbb5c3d95d50" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/24/2463e5d528a3af7798456523c4e456c102ee3fb07828cd5680180d75bb27d2fd.png" :db/id #edb/ref 17592186575397}] :answer-field/correct {:db/id #edb/ref 17592186575008} :answer-field/id #uuid "2baf93f4-97eb-565b-8259-f33d93d8df90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186575436}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7c7074e0-f02c-5273-a98a-de3d3f3ee6a7" :question/math-academy-id "q-76083" :question/problem "What is the set of values of $x$ that satisfy $3\\le 4x+7\\le 19$ or $6x+8<2?$" :question/worked-solution "We start by solving $3\\le 4x+7\\le 19:$\n\n$$\n\\begin{aligned}3 & \\le 4x+7\\le 19 \\\\ -4 & \\le 4x\\le 12 \\\\ -1 & \\le x\\le 3\\end{aligned}\n$$\n\n![](images/7d/7d7303c5608dbd17911794959438f925d7ab6edd3ebba600d657b396ccf8eaa9.png)\n\nThen, we solve $6x+8<2:$\n\n$$\n\\begin{aligned}6x+8 & <2 \\\\ 6x & <-6 \\\\ x & <-1\\end{aligned}\n$$\n\n![](images/ad/ad5692ee92c2b67f50c0354020642bd9c711bdf7b88f4d476455512e33f9fc5f.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/63/638b44af1e33b78102a0dbfa3857c1292f200e026f54adf92fe77a97bf7e10a1.png)\n\nTherefore, the final solution is $x\\le 3.$"} :step/id #uuid "6efa7e92-f016-53bb-834a-4b1eccb1ced4" :step/next {:db/id #edb/ref 17592186575663}} {:db/id #edb/ref 17592186575663 :step/content {:db/id #edb/ref 17592186125027 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "952b9614-1c48-5e7e-aa39-73bf3282732b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0, 0)" :db/id #edb/ref 17592186122763} {:answer/id #uuid "d19843fd-85d3-577d-9bac-0e1c6682a024" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3, 2)" :db/id #edb/ref 17592186122764} {:answer/id #uuid "396d3df0-4215-5974-9ead-a960e8adb3fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-0.5,-1)" :db/id #edb/ref 17592186122765} {:answer/id #uuid "62a3da70-7f35-518f-81b8-335d54fc568c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3, 0)" :db/id #edb/ref 17592186122766} {:answer/id #uuid "6de59753-24c5-5ff5-959c-5a4511a3425a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,-4)" :db/id #edb/ref 17592186122767}] :answer-field/id #uuid "384047e4-5971-5a12-896e-9cbbe096b46a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186122762}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6881735b-cf8d-5bd1-be6c-cf22189f242d" :question/math-academy-id "q-37054" :question/problem "![](images/bc/bc5f414f394a535ca2a1cfcc8c9d8f48d092184f26b3499c80fb55c1af129e95.png)\n\nWhat is the global minimum point of the function shown above?"} :step/id #uuid "76250baa-d726-5448-99de-f65c8294e71c" :step/next {:db/id #edb/ref 17592186575689}} {:db/id #edb/ref 17592186575665 :step/content {:db/id #edb/ref 17592186575567 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "448eccfb-3c08-5bec-841b-585bee529c4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-5y=-10" :db/id #edb/ref 17592186575070} {:answer/id #uuid "60d77254-fa6e-530c-8178-4237af50304a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=5y-10" :db/id #edb/ref 17592186575121} {:answer/id #uuid "9061fc30-c374-57e8-aa75-804d2bbafc4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}x-y=-2" :db/id #edb/ref 17592186575197} {:answer/id #uuid "bd9e69fa-90c3-5ff9-b4f9-43eaf28f779f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-5y+10=0" :db/id #edb/ref 17592186575289} {:answer/id #uuid "fa2a9e76-21e6-55c2-8f02-1bd6cfa3e2c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+5y=5" :db/id #edb/ref 17592186575395}] :answer-field/correct {:db/id #edb/ref 17592186575070} :answer-field/id #uuid "dad8335d-f4a7-566b-a578-6ac7a63c8d7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186575510}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7f25e8cf-a84e-5491-8095-e34846bd72c0" :question/math-academy-id "q-109613" :question/problem "Write $y=\\frac{1}{5}x+2$ in standard form." :question/worked-solution "Our goal is to write the equation in the form $ax+by=c,$ where $a,b,$ and $c$ are integers with no common factors and $a\\ge 0.$\n\nWe begin by moving all of the variables to the left-hand side and all of the constants to the right-hand side. This gives\n\n$$\n-\\frac{1}{5}x+y=2\n$$\n\nNow, we multiply both sides of the equation by $-1:$\n\n$$\n\\begin{aligned}-\\frac{1}{5}x+y & =2 \\\\ (-1)\\cdot (-\\frac{1}{5}x+y) & =(-1)\\cdot (2) \\\\ \\frac{1}{5}x-y & =-2.\\end{aligned}\n$$\n\nFinally, we multiply both sides of the equation by $5:$\n\n$$\n\\begin{aligned}\\frac{1}{5}x-y & =-2 \\\\ 5\\cdot (\\frac{1}{5}x-y) & =5\\cdot (-2) \\\\ x-5y & =-10.\\end{aligned}\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a\\ge 0.$ So we are done!\n\nThe standard form of the line is $x-5y=-10.$"} :step/id #uuid "7842a897-31cc-5300-9462-5bab9938e676" :step/next {:db/id #edb/ref 17592186575634}} {:db/id #edb/ref 17592186575683 :step/content {:db/id #edb/ref 17592186233141 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1814fbcd-9f92-515e-9828-c49eef2bbaf2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "26" :db/id #edb/ref 17592186574987} {:answer/id #uuid "4be48e3e-1c40-52d4-a265-9d0205cf8f91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "23" :db/id #edb/ref 17592186575078} {:answer/id #uuid "5731e481-0681-52ab-b6b9-e017c2f03b1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32" :db/id #edb/ref 17592186575102} {:answer/id #uuid "69f8f087-b4ab-539a-a92a-71c2b7e860e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "43" :db/id #edb/ref 17592186575138} {:answer/id #uuid "9e4a93a5-5f1b-534c-a5dc-2740ee32a078" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "53" :db/id #edb/ref 17592186575224}] :answer-field/correct {:db/id #edb/ref 17592186575138} :answer-field/id #uuid "7c0bdd98-1734-5283-bd19-3a50cb6e8817" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186575467}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e08294c6-a979-573d-8467-4eac7fae6a3e" :question/math-academy-id "q-111362" :question/problem "Given that  $(3{s}^{2}+2s+4)({s}^{2}+3s+2)=3{s}^{4}+a{s}^{3}+b{s}^{2}+cs+8,$ calculate $a+b+c.$" :question/worked-solution "We distribute all three terms of the trinomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(3{s}^{2}+2s+4)({s}^{2}+3s+2) & = \\\\ 3{s}^{2}({s}^{2}+3s+2)+(2s)({s}^{2}+3s+2)+(4)({s}^{2}+3s+2) & = \\\\ 3{s}^{4}+9{s}^{3}+6{s}^{2}+2{s}^{3}+6{s}^{2}+4s+4{s}^{2}+12s+8 & = \\\\ 3{s}^{4}+11{s}^{3}+16{s}^{2}+16s+8\\end{aligned}\n$$\n\nTherefore, $a=11,$ $b=16,$ and $c=16.$ So, \n\n$$\na+b+c=11+16+16=43.\n$$"} :step/id #uuid "cd22f88a-3842-5752-b5b5-8be1505b996e" :step/next {:db/id #edb/ref 17592186575665}} {:db/id #edb/ref 17592186575688 :step/content {:db/id #edb/ref 17592186575616 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b980c429-3941-5497-9718-eff2d9e2f790" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186575278}] :answer-field/correct {:db/id #edb/ref 17592186575278} :answer-field/id #uuid "1743a921-81e3-55b5-9d48-3a7a62d7fca6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186575416} {:answer-field/choices [{:answer/id #uuid "592954bd-e4e3-532e-b6ca-f2133054c745" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186575106}] :answer-field/correct {:db/id #edb/ref 17592186575106} :answer-field/id #uuid "417b571f-db4b-5ef9-8922-9b03f5302044" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186575447} {:answer-field/choices [{:answer/id #uuid "fc2978a6-8ff8-5d5b-8005-22bef1697c15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186575402}] :answer-field/correct {:db/id #edb/ref 17592186575402} :answer-field/id #uuid "97e49246-be20-50e1-b49e-21fb6572d864" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186575474}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e8fb1410-51ee-5a0a-9a08-61072eaa2e45" :question/math-academy-id "q-225260" :question/problem "**Fully** factor the following trinomial.\n\n$-12{a}^{2}-6a+6=$\n{{field-1}}$(a\\,+$\n{{field-2}}\n$)($\n{{field-3}}\n$a\\,-1)$" :question/worked-solution "We need to factor the following expression:\n\n$$\n-12{a}^{2}-6a+6\n$$\n\nFirst, notice that all the terms have a common factor of $-6.$ So, we can simplify the calculation by first factoring out $-6:$\n\n$$\n\\begin{aligned}-6(2{a}^{2}+a-1)\\end{aligned}\n$$\n\nNow, we just need to factor the trinomial $2{a}^{2}+a-1$ in parentheses. To do this, we find two numbers that \n\n- multiply to the product of the quadratic coefficient and the constant (which is $2\\times (-1)=-2$), and\n\n- add to the linear coefficient (which is $1$).\n\nThe factor pairs of $-2$ are\n\n$$\n(1,-2),\\,(-1,2).\n$$\n\nNotice the numbers in the factor pair $(-1,2)$ add to $1:$ \n\n$$\n-1+2=1\\,✓\n$$\n\nThen, we write the linear term as $-a+2a,$ and factor the result by grouping:\n\n$$\n\\begin{aligned}2{a}^{2}+a-1 & = \\\\ 2{a}^{2}-a+2a-1 & = \\\\ (2{a}^{2}-a)+(2a-1) & = \\\\ a(2a-1)+(2a-1) & = \\\\ (a+1)(2a-1) & \\end{aligned}\n$$\n\nTherefore, the original trinomial factors as follows:\n\n$$\n\\begin{aligned}-12{a}^{2}-6a+6 & = \\\\ -6(2{a}^{2}+a-1) & = \\\\ -6(a+1)(2a-1) & \\end{aligned}\n$$"} :step/id #uuid "eb1c4e40-39c2-5f5c-b2b6-26650419156e" :step/next {:db/id #edb/ref 17592186575632}} {:db/id #edb/ref 17592186575689 :step/content {:db/id #edb/ref 17592186575561 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "015e29d4-44ac-5ca8-a43f-99ecdd54ff48" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50" :db/id #edb/ref 17592186574953} {:answer/id #uuid "2272b44c-dbba-5930-a68e-ca0f3289afd9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25\\sqrt{2}" :db/id #edb/ref 17592186575005} {:answer/id #uuid "29d41b66-493d-5b0a-96b8-072a9c66c207" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50\\sqrt{2}" :db/id #edb/ref 17592186575015} {:answer/id #uuid "a30e18e9-8725-50fa-90c2-6a03a46e5e68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186575234} {:answer/id #uuid "ad072040-2706-54b1-aafe-7b97f68a33a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186575254}] :answer-field/correct {:db/id #edb/ref 17592186575254} :answer-field/id #uuid "063ce151-0ba3-5c75-910b-b7e2c256e6ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186575410}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7002a70c-d40e-53ed-9d27-c94492760a6a" :question/math-academy-id "q-22036" :question/problem "![](images/a3/a36fe195458e459aea993232a72ed21e0c780135dc4dbe4bece45bfc3b6e50e2.png)\n\nThe perimeter of the above triangle is $50+25\\sqrt{2}.$ Find the measure of each leg." :question/worked-solution "Because the triangle is isosceles, the legs must have the same length. Let $a$ be the length of each leg. So, we have\n\n$$\nAB=BC=a.\n$$\n\nMoreover, because the triangle is a *right* isosceles triangle, the hypotenuse must be equal to $\\sqrt{2}$ times the length of a leg. Therefore,\n\n$$\nAC=AB\\cdot \\sqrt{2}=a\\sqrt{2}.\n$$\n\nFinally, since the perimeter is $p=50+25\\sqrt{2},$ we have\n\n$$\n\\begin{aligned}p & =AB+BC+AC \\\\ 50+25\\sqrt{2} & =a+a+a\\sqrt{2} \\\\ 25(2+\\sqrt{2}) & =2a+a\\sqrt{2} \\\\ 25(2+\\sqrt{2}) & =(2+\\sqrt{2})a \\\\ 25\\cancel{(2+\\sqrt{2})} & =\\cancel{(2+\\sqrt{2})}a \\\\ 25 & =a\\end{aligned}\n$$\n\nTherefore, the measure of a leg is $25.$"} :step/id #uuid "f0ded8a3-36ee-53e7-9a9e-da01def8fc81" :step/next {:db/id #edb/ref 17592186575643}}] :activity/title "Quiz 26" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186574950}]}
