d #edb/ref 17592186115415}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186557402} :activity/id #uuid "c133fc81-f847-545b-9d93-4e162a569216" :activity/scope {:db/id #edb/ref 17592186050680 :topic/id #uuid "5e676adf-aa45-5e67-b4e5-57ec40661f6e" :topic/math-academy-id 1576} :activity/steps [{:db/id #edb/ref 17592186557343 :step/content {:db/id #edb/ref 17592186557310 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ba0595d-f06f-5885-b3b6-4271c00186cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,\\frac{11}{2})" :db/id #edb/ref 17592186556560} {:answer/id #uuid "9301892d-c921-55d8-b611-e0207b9724b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\frac{3}{2},\\frac{11}{2})" :db/id #edb/ref 17592186556785} {:answer/id #uuid "b5a81b1b-75e9-58dd-a9f3-58f8e6b21ed6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-\\frac{3}{2},\\infty )" :db/id #edb/ref 17592186556875} {:answer/id #uuid "f5463f09-2120-5a87-9ad6-afd48773e784" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,\\frac{3}{2})" :db/id #edb/ref 17592186557036} {:answer/id #uuid "fd6b49c9-3144-5f1b-860e-b009a0d8db9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-\\frac{3}{2},\\infty )\\cup (-\\infty ,\\frac{11}{2})." :db/id #edb/ref 17592186557056}] :answer-field/correct {:db/id #edb/ref 17592186556875} :answer-field/id #uuid "de85a63e-a3d0-55fd-b8a5-f8452278c0c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557189}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cbe793da-7d16-5ef3-b7b6-788b5db16db0" :question/math-academy-id "q-25767" :question/problem "Find the set of values of $x$ that satisfy $5x-1>7$ or $2\\le 2x+5<16.$" :question/worked-solution "We start by solving $5x-1>7:$\n\n$$\n\\begin{aligned}5x-1 & >7 \\\\ 5x & >8 \\\\ x & >\\frac{8}{5}\\end{aligned}\n$$\n\n![](images/0e/0efcf15a3abee964ad2dfc0c1dac12a0f2f43c86180d2ead869fc2ee7b8e9c76.png)\n\nThen, we solve $2\\le 2x+5<16:$\n\n$$\n\\begin{aligned}2 & \\le 2x+5<16 \\\\ 2-5 & \\le 2x<16-5 \\\\ -3 & \\le 2x<11 \\\\ -\\frac{3}{2} & \\le x<\\frac{11}{2}\\end{aligned}\n$$\n\n![](images/22/22f51dad4248c565cd3afcf03ec9f5a8c50494ad79ed1366b3513083be27182a.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/e7/e769eea6e55f7138cbce08cb285253fc1c710c2e39384994a8b36bd43a41ea32.png)\n\nTherefore, the final solution is $x\\ge -\\frac{3}{2}.$  We can write this using interval notation as $[-\\frac{3}{2},\\infty ).$"} :step/id #uuid "18a200e9-cd70-5bff-86ec-4b2d64cebd6c" :step/next {:db/id #edb/ref 17592186557382}} {:db/id #edb/ref 17592186557350 :step/content {:db/id #edb/ref 17592186557323 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "391d070c-32c3-51d1-87a6-51e1deeeceda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,1)" :db/id #edb/ref 17592186556551} {:answer/id #uuid "70d62841-5a2b-56ce-b898-842b8ad2b793" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,-1)" :db/id #edb/ref 17592186556687} {:answer/id #uuid "77434d1a-9653-5239-9ffa-ed467133e340" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,-1)\\cup (-1,3)" :db/id #edb/ref 17592186556702} {:answer/id #uuid "83613639-e746-5cb9-a5b0-1fc25dcbfd60" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,3)" :db/id #edb/ref 17592186556735} {:answer/id #uuid "a900943b-143b-5bc3-a277-6290db942625" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,3)" :db/id #edb/ref 17592186556849}] :answer-field/correct {:db/id #edb/ref 17592186556702} :answer-field/id #uuid "a3e5e47e-db25-536a-83fd-f652100a1d2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557158}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f2b14810-a4bb-5d69-856a-68799a4e514a" :question/math-academy-id "q-104015" :question/problem "Find the set of values of $x$ that satisfy $-8<4x-4<8$ or $2-x>3.$" :question/worked-solution "We start by solving $-8<4x-4<8:$\n\n$$\n\\begin{aligned}-8 & <4x-4<8 \\\\ -4 & <4x<12 \\\\ -1 & <x<3\\end{aligned}\n$$\n\n![](images/fd/fdf77a12d535974088d36ca7508443a2aab00bb147fde65a17fc06cf5f0bce23.png)\n\nThen, we solve $2-x>3:$\n\n$$\n\\begin{aligned}2-x & >3 \\\\ -x & >1 \\\\ \\frac{-x}{-1} & <\\frac{1}{-1} \\\\ x & <-1\\end{aligned}\n$$\n\n![](images/8a/8a1af65f2cebbcaeb73c138be5d1cd67d714aacb8db1c995f29b930c06b953fe.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/be/be8cace3271cdfa133d1b647359400681db04f504560ad306e3e1807eb1502d9.png)\n\nTherefore, the final solution is $-1<x<3$ or $x<-1.$ We can write this using interval notation as $(-\\infty ,-1)\\cup (-1,3).$"} :step/id #uuid "33dd4d66-72f1-548e-a8ea-98c8e4f5383e"} {:db/id #edb/ref 17592186557380 :step/content {:db/id #edb/ref 17592186557264 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10c04a51-ef7c-5856-a076-fb47f0912018" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/25/25f4136a1e248ab30fc0c01feef1e27c331553c1adcf4a1c27c133764cca1ae1.png" :db/id #edb/ref 17592186556463} {:answer/id #uuid "44590ee1-bff9-5692-9fac-4d311f90612f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/1b/1b0700462c3957759abbe608c300fece27f92dfdb9b8c14dbeb44cc053de7784.png" :db/id #edb/ref 17592186556580} {:answer/id #uuid "919b4593-9094-5d6a-9ebe-1e8c3a9a60e5" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/25/253ccc2c3cb59b2e195cd9989b864356181ecffd3c09ab879db6d87208afb55a.png" :db/id #edb/ref 17592186556779} {:answer/id #uuid "d97b4d3f-a651-5195-9620-b1c69ade990e" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/85/8599cc4956010fe616c90f60153e9b656440a6d3751739ddd706434e1e272101.png" :db/id #edb/ref 17592186556969} {:answer/id #uuid "d9cf5b9b-04b8-58a6-9091-f70e73e01318" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ab/ab1b1f6494c00b463e7912ab3f9710aee553e3a99484822e678494b55268e398.png" :db/id #edb/ref 17592186556970}] :answer-field/correct {:db/id #edb/ref 17592186556463} :answer-field/id #uuid "cd3749e3-5087-5fa4-954a-a11f49413b13" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557180}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6d993076-511f-5d5a-b4e5-bf19ec4e8490" :question/math-academy-id "q-76082" :question/problem "What is the set of values of $x$ that satisfy $6\\le 3x+9\\le 15$ or $4x-3\\ge 5?$" :question/worked-solution "We start by solving $6\\le 3x+9\\le 15:$\n\n$$\n\\begin{aligned}6 & \\le 3x+9\\le 15 \\\\ -3 & \\le 3x\\le 6 \\\\ -1 & \\le x\\le 2\\end{aligned}\n$$\n\n![](images/ab/ab1b1f6494c00b463e7912ab3f9710aee553e3a99484822e678494b55268e398.png)\n\nThen, we solve $4x-3\\ge 5:$\n\n$$\n\\begin{aligned}4x-3 & \\ge 5 \\\\ 4x & \\ge 8 \\\\ x & \\ge 2\\end{aligned}\n$$\n\n![](images/1b/1b0700462c3957759abbe608c300fece27f92dfdb9b8c14dbeb44cc053de7784.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/25/25f4136a1e248ab30fc0c01feef1e27c331553c1adcf4a1c27c133764cca1ae1.png)\n\nTherefore, the final solution is $x\\ge -1.$"} :step/id #uuid "96826635-bbbd-5238-b2a0-5744527987c9" :step/next {:db/id #edb/ref 17592186557350}} {:db/id #edb/ref 17592186557382 :step/content {:db/id #edb/ref 17592186557318 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51a286f2-9f76-5594-9f40-1d8d30b4d6ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in [2,\\infty )" :db/id #edb/ref 17592186556616} {:answer/id #uuid "65032a8d-a4f3-517c-a748-1a00ee1aed26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-\\infty ,-2)\\cup [2,\\infty )" :db/id #edb/ref 17592186556663} {:answer/id #uuid "9ba2ca60-ef41-5208-8e4e-1de935cdae6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-2,2]" :db/id #edb/ref 17592186556810} {:answer/id #uuid "c6b0992f-1500-5142-a5f8-a0f17e4f6976" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186556907} {:answer/id #uuid "d7976712-61bc-5824-bdde-76934e8b24a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-\\infty ,-2)" :db/id #edb/ref 17592186556963}] :answer-field/correct {:db/id #edb/ref 17592186556907} :answer-field/id #uuid "2435bb7a-799d-59f0-ad2e-0c6284676d40" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557087}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e377c474-d1b6-5e34-ae2e-6bda298c1707" :question/math-academy-id "q-28966" :question/problem "Find all the values of $x$ that satisfy $3x+5>11$ or $2x-3\\le 1.$" :question/worked-solution "We start by solving $3x+5>11:$ \n\n$$\n\\begin{aligned}3x+5 & >11 \\\\ 3x & >6 \\\\ x & >2\\end{aligned}\n$$\n\n![](images/87/87831ea65f4caa557c8e8826faaa43a60737c3590393872902818921668787d0.png)\n\nThen, we solve $2x-3\\le 1:$\n\n$$\n\\begin{aligned}2x-3 & \\le 1 \\\\ 2x & \\le 4 \\\\ x & \\le 2\\end{aligned}\n$$\n\n![](images/49/4965930532798f18907e5319f2fd9fe5f17d9c1969c12d9795f9867a2cb13351.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/a9/a9543d5a2add249d869a667d16bea75780b0e44e4c0d2bde2cf460733d5e9634.png)\n\nTherefore, the final solution is $x\\le 2$ or $x>2.$ We can write this using interval notation as\n\n$$\nx\\in (-\\infty ,\\infty ).\n$$"} :step/id #uuid "9920cd70-713b-5652-a589-462984092c55" :step/next {:db/id #edb/ref 17592186557380}} {:db/id #edb/ref 17592186557402 :step/content {:db/id #edb/ref 17592186557245 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4208aa5a-ebcf-544c-bdab-57c640b053b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,10)" :db/id #edb/ref 17592186556576} {:answer/id #uuid "4fac84c7-58d6-5175-a114-10e9acc01ee6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,-3)\\cup (10,\\infty )" :db/id #edb/ref 17592186556607} {:answer/id #uuid "a9701182-7d89-5629-8529-d4fad7cef8ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,-10)\\cup (3,\\infty )" :db/id #edb/ref 17592186556850} {:answer/id #uuid "e67b06b1-5b7a-5ce7-a2e3-c9ca5a45bf11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-10,3)" :db/id #edb/ref 17592186556998} {:answer/id #uuid "f052b297-ca34-569f-a527-057e0db288ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,\\infty )" :db/id #edb/ref 17592186557022}] :answer-field/correct {:db/id #edb/ref 17592186557022} :answer-field/id #uuid "bfa95610-12f2-5abb-9640-0c55094b614f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557173}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "49cc684c-6a61-5a0a-9979-944836444765" :question/math-academy-id "q-25402" :question/problem "Find all the values of $x$ that satisfy $2x-5>1$ or $2x-7<13.$" :question/worked-solution "We start by solving $2x-5>1:$ \n\n$$\n\\begin{aligned}2x-5 & >1 \\\\ 2x & >6 \\\\ x & >3\\end{aligned}\n$$\n\n![](images/20/2048d360b427cfd94e92a16f7b9f8cd9ca9c88e808bf3b6205d60eebd71aa1cf.png)\n\nThen, we solve $2x-7<13:$\n\n$$\n\\begin{aligned}2x-7 & <13 \\\\ 2x & <20 \\\\ x & <10\\end{aligned}\n$$\n\n![](images/c1/c1a63d1c991f309dbc10a89f0416c910c2c31bde5fdf069682a6127a1f66987a.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/e0/e03d04e5d2d5d571f5b80353081253087f99b2bf58fd86ae56eff3af26415b92.png)\n\nTherefore, the final solution is $x<10$ or $x>3.$ We can write this using interval notation as $x\\in (-\\infty ,\\infty ).$"} :step/id #uuid "e397555c-38d7-597d-9eef-be097531f336" :step/next {:db/id #edb/ref 17592186557343}}] :activity/title "Compound OR Inequalities" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186556419}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186573977} :activity/id #uuid "7a5b4a5d-3859-51ba-9332-c80d1a470485" :activity/scope {:db/id #edb/ref 17592186050680 :topic/id #uuid "5e676adf-aa45-5e67-b4e5-57ec40661f6e" :topic/math-academy-id 1576} :activity/steps [{:db/id #edb/ref 17592186573960 :step/content {:db/id #edb/ref 17592186115906 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d22ef26-67e9-570b-ae16-d5566bfb5791" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(- ∞, 0]∪(2, 4)" :db/id #edb/ref 17592186114374} {:answer/id #uuid "c20ac221-36b1-5a2b-ad46-804b7ae65441" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(- ∞, 0)∪[2, 4]" :db/id #edb/ref 17592186114375} {:answer/id #uuid "d101d38d-df01-5802-bb76-36b9e5304387" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[0, 2)" :db/id #edb/ref 17592186114376} {:answer/id #uuid "21a3f80c-87a9-5b22-ad7d-760b970bd83b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(- ∞, 2]" :db/id #edb/ref 17592186114377} {:answer/id #uuid "4250dcb6-c304-54c4-972d-d553943e333d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(- ∞, 4]" :db/id #edb/ref 17592186114378}] :answer-field/id #uuid "44ac194c-0973-53bd-953a-017fa40875eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186114373}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "657ccae9-03d3-59e9-af36-01df6031e4ca" :question/math-academy-id "q-59512" :question/problem "Find the set of values of $x$ that satisfy $-3 \\le 2x - 7 \\le 1$ or $2 + 3x < 2$."} :step/id #uuid "45728fdf-d05f-50d8-8c7d-444c58d427ec" :step/next {:db/id #edb/ref 17592186573980}} {:db/id #edb/ref 17592186573977 :step/content {:db/id #edb/ref 17592186573939 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "213b086c-9de7-5968-8df0-bfcd9ec886ac" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No real solutions" :db/id #edb/ref 17592186573462} {:answer/id #uuid "2301e2ab-92a9-51b4-a9b3-3aba28597748" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a8/a889f5a6049842727a00007f29e7e0934a6edac45544f969b2596d43bdc16806.png" :db/id #edb/ref 17592186573466} {:answer/id #uuid "707333ba-3177-5631-8eb1-ce18a0823c06" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/bc/bc475f69877ff3ae14e78430698b5a8a80f9a422c58a5558f08a2e34aff7efae.png" :db/id #edb/ref 17592186573564} {:answer/id #uuid "a58948ab-e814-5339-8ea6-362b2133ac35" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/d9/d9f61f95d32f5f856494ed5e6327bd7101237b906ecf7b90125b746b4a6fa383.png" :db/id #edb/ref 17592186573637} {:answer/id #uuid "b62d3b29-26a8-5c24-8540-fcd3da4394c9" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/4d/4d8b75381554b4fefbe3b89abe5a8a9604036e4ccdda3b9cd53f61fd6df7f462.png" :db/id #edb/ref 17592186573662}] :answer-field/correct {:db/id #edb/ref 17592186573662} :answer-field/id #uuid "b55d58ab-6f36-570d-8c9d-3ef2320bbe2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186573839}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e93fe40f-a4aa-5acf-8d5c-2ac8fa4691b8" :question/math-academy-id "q-25487" :question/problem "Which of the following number lines represents the values of $w$ that satisfy $3w-7\\le 5$ or $5w+7\\ge -3$, or $2w<8?$" :question/worked-solution "We start by solving $3w-7\\le 5:$ \n\n$$\n\\begin{aligned}3w-7 & \\le 5 \\\\ 3w & \\le 12 \\\\ w & \\le 4\\end{aligned}\n$$\n\n![](images/df/dfbf9fce10352e640bb62b75c49339e54c3d22b918e2dfb60a72472ef5129639.png)\n\nThen, we solve $5w+7\\ge -3:$ \n\n$$\n\\begin{aligned}5w+7 & \\ge -3 \\\\ 5w & \\ge -10 \\\\ w & \\ge -2\\end{aligned}\n$$\n\n![](images/53/535934975bf21706e8bfa3b54fa51a0f344f585e89f3003ad042f6fb660c3441.png)\n\nFinally, we solve $2w<8:$ \n\n$$\n\\begin{aligned}2w & <8 \\\\ w & <4\\end{aligned}\n$$\n\n![](images/ba/ba806ca20f496c724c4411c282ab44d81d7713c7b8635b3c286faff1d7728f20.png)\n\nTo graph the values of $w$ that satisfy at least one of the inequalities, we overlay the three graphs on the same number line:\n\n![](images/f0/f084c11e4faf4fdcfc69a32900bf62c1bddfa2266007f8f4ddecf8ab928230fa.png)\n\nTherefore, the final solution is $-\\infty <w<\\infty .$"} :step/id #uuid "e49fe02b-c6f2-5520-b855-c1be08e7b33d" :step/next {:db/id #edb/ref 17592186573960}} {:db/id #edb/ref 17592186573980 :step/content {:db/id #edb/ref 17592186573923 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fb6a318-faf2-5363-9952-257a1853b996" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/44/44b4a08bd4b2aade4c86ac1845878dc44cb41a2fd84cb36c19cfd8110bd84f61.png" :db/id #edb/ref 17592186573484} {:answer/id #uuid "53529ee0-0323-5186-834b-402cd87e5b10" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/6a/6a34e6d82defce5f47d5562151a5ccfe88d4475f60c33632950ff109e4fc2460.png" :db/id #edb/ref 17592186573526} {:answer/id #uuid "7a1a84ac-dd61-54df-9d04-2d6ecbc519cb" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/8a/8ade78ec1b4adac7ee63d1eb3e5b5cc82ffe5b00437add005b7824dc2e0c05a9.png" :db/id #edb/ref 17592186573581} {:answer/id #uuid "83e558d1-2de8-5cb9-b43e-dacc90324e89" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/c8/c82330c4ccd9aff01ac73cd1ebac56d50f685e0da258fb83ec619ebd11023694.png" :db/id #edb/ref 17592186573597} {:answer/id #uuid "f00f0e95-02eb-5786-8fec-b2276b3ddcc8" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/72/72edfbf24542f84652d24d879c2298cff603f960a22885e0b8856635a80d201c.png" :db/id #edb/ref 17592186573744}] :answer-field/correct {:db/id #edb/ref 17592186573744} :answer-field/id #uuid "d394b718-d2f3-5360-aead-3ecf50fe63f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186573850}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c2564ad9-789a-55f4-bf0e-d5069f16525a" :question/math-academy-id "q-76087" :question/problem "What is the set of values of $x$ that satisfy $-2\\le 2x-6\\le 4$ or $12x-22<14?$" :question/worked-solution "We start by solving $-2\\le 2x-6\\le 4:$\n\n$$\n\\begin{aligned}-2 & \\le 2x-6\\le 4 \\\\ 4 & \\le 2x\\le 10 \\\\ 2 & \\le x\\le 5\\end{aligned}\n$$\n\n![](images/c8/c82330c4ccd9aff01ac73cd1ebac56d50f685e0da258fb83ec619ebd11023694.png)\n\nThen, we solve $12x-22<14:$\n\n$$\n\\begin{aligned}12x-22 & <14 \\\\ 12x & <36 \\\\ x & <3\\end{aligned}\n$$\n\n![](images/8a/8ade78ec1b4adac7ee63d1eb3e5b5cc82ffe5b00437add005b7824dc2e0c05a9.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/72/72edfbf24542f84652d24d879c2298cff603f960a22885e0b8856635a80d201c.png)\n\nTherefore, the final solution is $x\\le 5.$"} :step/id #uuid "fefec9ef-1682-5b4f-ba9e-308af8f3441f"}] :activity/title "Compound OR Inequalities" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186573416}] [{:activity/expected-seconds 900.0 :activity/first-step {:db/id #edb/ref 17592186055682} :activity/id #uuid "5aea7af6-7507-583d-9ea4-e7afac732f55" :activity/scope {:db/id #edb/ref 17592186050987 :topic/id #uuid "7734519e-e666-5361-81f3-89b86b5bc28d" :topic/math-academy-id 37} :activity/steps [{:db/id #edb/ref 17592186055518 :step/content {:db/id #edb/ref 17592186054604 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054518 :question/id #uuid "8177157c-4d89-59df-af9b-38f1bee2d6a2" :question/math-academy-id "e-3564"} :knowledge-point/id #uuid "b1bddb74-97be-5f35-b559-afb707e6e964" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049299}] :knowledge-point/questions [{:db/id #edb/ref 17592186055053} {:db/id #edb/ref 17592186055297} {:db/id #edb/ref 17592186233022} {:db/id #edb/ref 17592186233760} {:db/id #edb/ref 17592186233879} {:db/id #edb/ref 17592186233994} {:db/id #edb/ref 17592186233999} {:db/id #edb/ref 17592186234057} {:db/id #edb/ref 17592186234394} {:db/id #edb/ref 17592186311941} {:db/id #edb/ref 17592186311942} {:db/id #edb/ref 17592186514370} {:db/id #edb/ref 17592186563660} {:db/id #edb/ref 17592186563742} {:db/id #edb/ref 17592186575527}] :knowledge-point/title "Applying the Root Rule to Compute a Limit"} :step/id #uuid "9450e070-8dcd-5ffd-bf6c-45e46af5913a" :step/math-academy-id 12007 :step/next {:db/id #edb/ref 17592186055686}} {:db/id #edb/ref 17592186055519 :step/content {:db/id #edb/ref 17592186054605 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054519 :question/id #uuid "3d6b32ee-3385-5fba-91a5-66c0bbb13dea" :question/math-academy-id "e-3565"} :knowledge-point/id #uuid "10100e89-21d6-53c5-a7de-f14fd73ce4b7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049089}] :knowledge-point/questions [{:db/id #edb/ref 17592186055235} {:db/id #edb/ref 17592186055236} {:db/id #edb/ref 17592186233029} {:db/id #edb/ref 17592186233421} {:db/id #edb/ref 17592186233880} {:db/id #edb/ref 17592186233995} {:db/id #edb/ref 17592186234245} {:db/id #edb/ref 17592186234397} {:db/id #edb/ref 17592186235428} {:db/id #edb/ref 17592186311944} {:db/id #edb/ref 17592186403265} {:db/id #edb/ref 17592186514399}] :knowledge-point/title "Combining Different Rules to Compute a Limit Given a Graph"} :step/id #uuid "d5acac99-2496-5224-a6b8-9e6864591fd4" :step/math-academy-id 12008} {:db/id #edb/ref 17592186055682 :step/content {:db/id #edb/ref 17592186055954 :tutorial/content "The **power rule** states that the limit of a power is the power of the limit. More precisely, if $n$ is any positive integer and $\\lim_\\limits{x\\rightarrow a}f(x)=L,$ then\n\n$$\n\\begin{aligned}{lim}_{x\\to a}(f(x))^{n}={({lim}_{x\\to a}f(x))}^{n}={L}^{n}\\,.\\end{aligned}\n$$\n\nFor example, with the power rule, we can evaluate a limit like \n\n$$\n\\lim_\\limits{x\\rightarrow 2}(3x-4)^{8}\n$$\n\n by evaluating the limit of the expression within parentheses and then taking the power of the result.\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}(3x-4)^{8} & ={({lim}_{x\\to 2}(3x-4))}^{8} \\\\  & =(3\\cdot 2-4)^{8} \\\\  & ={2}^{8} \\\\  & =256\\,.\\end{aligned}\n$$" :tutorial/id #uuid "c4331194-9993-526c-ac4e-85c5017ee722" :tutorial/math-academy-id 181 :tutorial/title "Introduction"} :step/id #uuid "ea15caf2-d9e3-5bc4-a4eb-aeae23270b0c" :step/math-academy-id 344 :step/next {:db/id #edb/ref 17592186055683}} {:db/id #edb/ref 17592186055683 :step/content {:db/id #edb/ref 17592186054702 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054512 :question/id #uuid "9f9e4a39-22c9-5bcf-9b34-b3b1459acb44" :question/math-academy-id "e-30"} :knowledge-point/id #uuid "ae7650e3-faf3-520c-9674-ffa036a8eacc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049226}] :knowledge-point/questions [{:db/id #edb/ref 17592186055232} {:db/id #edb/ref 17592186055372} {:db/id #edb/ref 17592186233020} {:db/id #edb/ref 17592186233021} {:db/id #edb/ref 17592186233992} {:db/id #edb/ref 17592186233993} {:db/id #edb/ref 17592186234242} {:db/id #edb/ref 17592186234393} {:db/id #edb/ref 17592186514416}] :knowledge-point/title "Applying the Power Rule to Compute a Limit"} :step/id #uuid "7cdd9667-323b-5010-a8fc-c007664db1d4" :step/math-academy-id 345 :step/next {:db/id #edb/ref 17592186055684}} {:db/id #edb/ref 17592186055684 :step/content {:db/id #edb/ref 17592186054703 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054513 :question/id #uuid "27b89a42-7f31-579b-af21-b33ebe36f749" :question/math-academy-id "e-31"} :knowledge-point/id #uuid "4ad6d0a4-7854-5f87-896c-0c3ba5ef60af" :knowledge-point/questions [{:db/id #edb/ref 17592186055233} {:db/id #edb/ref 17592186055234} {:db/id #edb/ref 17592186233023} {:db/id #edb/ref 17592186233024} {:db/id #edb/ref 17592186233025} {:db/id #edb/ref 17592186233026} {:db/id #edb/ref 17592186233588} {:db/id #edb/ref 17592186233877} {:db/id #edb/ref 17592186233878} {:db/id #edb/ref 17592186233998} {:db/id #edb/ref 17592186234243} {:db/id #edb/ref 17592186234244} {:db/id #edb/ref 17592186234395} {:db/id #edb/ref 17592186234396} {:db/id #edb/ref 17592186237784} {:db/id #edb/ref 17592186311940} {:db/id #edb/ref 17592186563676}] :knowledge-point/title "Applying the Power Rule to Compute a Limit Given a Graph"} :step/id #uuid "2c4ae36c-001f-593c-aad4-04fe90c082c3" :step/math-academy-id 346 :step/next {:db/id #edb/ref 17592186055685}} {:db/id #edb/ref 17592186055685 :step/content {:db/id #edb/ref 17592186055955 :tutorial/content "The **root rule** states that the limit of a root is the root of the limit (provided that the root exists).\n\nMore precisely, if $n$ is any positive integer and $\\lim_\\limits{x\\rightarrow a}f(x)=L,$ then\n\n$$\n\\begin{aligned}{lim}_{x\\to a}\\sqrt[n]{f(x)}=\\sqrt[n]{{lim}_{x\\to a}f(x)}=\\sqrt[n]{L}\\,.\\end{aligned}\n$$\n\nFor example, with the root rule, we can evaluate a limit like \n\n$$\n\\lim_\\limits{x\\rightarrow 2}\\sqrt{3x-2}\n$$\n\n by evaluating the limit of the expression within the root and then taking the root of the result:\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\sqrt{3x-2} & =\\sqrt{{lim}_{x\\to 2}(3x-2)} \\\\  & =\\sqrt{3\\cdot 2-2} \\\\  & =\\sqrt{4} \\\\  & =2\\end{aligned}\n$$" :tutorial/id #uuid "831603dd-2fca-539d-90bc-81d866ca5d77" :tutorial/math-academy-id 185 :tutorial/title "The Root Rule for Limits"} :step/id #uuid "feb2aa0a-5b34-5dae-ba30-562950046860" :step/math-academy-id 348 :step/next {:db/id #edb/ref 17592186055518}} {:db/id #edb/ref 17592186055686 :step/content {:db/id #edb/ref 17592186055956 :tutorial/content "If we combine the power rule and the root rule, then we get the following useful generalization: if $\\lim_\\limits{x\\rightarrow a}f(x)=L,$ then for any fraction $p/q,$ we have\n\n$$\n\\lim_\\limits{x\\rightarrow a}\\left(f(x)\\right)^{p/q} =  \\left(\\lim_\\limits{x\\rightarrow a} f(x)\\right)^{p/q} = L^{p/q}\n$$\n\nprovided that $L^{p/q}$ exists.\n\nFor example, we can evaluate a limit like \n\n$$\n\\lim_\\limits{y\\rightarrow 64} y^{-1/6}\n$$\n\n by evaluating the limit of $y$ and then exponentiating the result to the fractional exponent:\n\n \n\n$$\n\\begin{aligned}{lim}_{y\\to 64}{y}^{-1/6} & ={({lim}_{y\\to 64}y)}^{-1/6} \\\\  & =(64)^{-1/6} \\\\  & ={({2}^{6})}^{-1/6} \\\\  & ={2}^{-1} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$" :tutorial/id #uuid "0ec92465-592d-5e08-8d49-a2a3311282c4" :tutorial/math-academy-id 187 :tutorial/title "Combining Different Rules"} :step/id #uuid "4c16f856-e95a-5082-937e-48f3494765ac" :step/math-academy-id 350 :step/next {:db/id #edb/ref 17592186055519}}] :activity/title "The Power and Root Rules for Limits" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054899}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186534121} :activity/id #uuid "38e95199-7378-5c57-8b6f-37733a1f504d" :activity/scope {:db/id #edb/ref 17592186050987 :topic/id #uuid "7734519e-e666-5361-81f3-89b86b5bc28d" :topic/math-academy-id 37} :activity/steps [{:db/id #edb/ref 17592186534118 :step/content {:db/id #edb/ref 17592186233023 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b2d9170-72bf-5608-bc85-b7e1e90b7337" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186533246} {:answer/id #uuid "3a9642e4-5571-5f69-b42d-8a766a19f94a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186533276} {:answer/id #uuid "b3087c4f-f3ff-5f73-85e3-80711023e115" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186533572} {:answer/id #uuid "c97fc178-695e-5644-8659-728e66bdb6d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186533621} {:answer/id #uuid "cfdaab07-184b-57e0-83cf-49eb37899d71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186533643}] :answer-field/correct {:db/id #edb/ref 17592186533276} :answer-field/id #uuid "eccb0955-0665-53a1-96c5-95a613de628c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186533947}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "98c65517-e27d-5eb7-b458-8dcf5425928f" :question/math-academy-id "q-100273" :question/problem "![](images/fd/fda731fa3c9a3401e9b9e2a7d4c103829d3fe3b14ac9d6f2872b76a319f6ae91.png)\n\nFind ${lim}_{x\\to \\,1}(2{x}^{3}-4f(x))^{3}(2{x}^{4}-3)^{2}$ for the function $f(x)$ plotted above." :question/worked-solution "From the graph, we get that ${lim}_{x\\to \\,1}f(x)=1.$ \n\nFrom the product rule, we have\n\n$$\n{lim}_{x\\to \\,1}(2{x}^{3}-4f(x))^{3}(2{x}^{4}-3)^{2}={lim}_{x\\to \\,1}(2{x}^{3}-4f(x))^{3}\\cdot {lim}_{x\\to \\,1}(2{x}^{4}-3)^{2}.\n$$\n\nWe calculate the limits of each factor, separately.\n\nApplying the power rule, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,1}(2{x}^{3}-4f(x))^{3} & ={({lim}_{x\\to \\,1}(2{x}^{3}-4f(x)))}^{3} \\\\  & =(2(1)^{3}-4(1))^{3} \\\\  & =(-2)^{3} \\\\  & =-8,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,1}(2{x}^{4}-3)^{2} & ={({lim}_{x\\to \\,1}(2{x}^{4}-3))}^{2} \\\\  & =(2(1)^{4}-3)^{2} \\\\  & =(-1)^{2} \\\\  & =1\\,.\\end{aligned}\n$$\n\nFinally, we have\n \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,1}(2{x}^{3}-4f(x))^{3}(2{x}^{4}-3)^{2} & ={lim}_{x\\to \\,1}(2{x}^{3}-4f(x))^{3}\\cdot {lim}_{x\\to \\,1}(2{x}^{4}-3)^{2} \\\\  & =(-8)\\cdot (1) \\\\  & =-8\\,.\\end{aligned}\n$$"} :step/id #uuid "3ceee877-c8fc-531a-9878-62234964e115"} {:db/id #edb/ref 17592186534121 :step/content {:db/id #edb/ref 17592186055233 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83f5e618-9958-5c65-98d7-f72834d8cfad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-81" :db/id #edb/ref 17592186052636} {:answer/id #uuid "c02dfdc4-656f-5641-998f-9bc8a0a18e95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186052637} {:answer/id #uuid "d027fbd4-28ba-5990-9755-63cf439bf5a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186052638} {:answer/id #uuid "41356929-64d9-5d70-95a1-343710b86dad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-641" :db/id #edb/ref 17592186052639} {:answer/id #uuid "42e68d28-554b-55d7-b11f-12bfa298f433" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186052640}] :answer-field/correct {:db/id #edb/ref 17592186052640} :answer-field/id #uuid "022ec75f-d363-5486-95b7-fc4dff138c8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186052635}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0bbcd500-ae70-509c-b570-d85bc1475ae3" :question/math-academy-id "q-35294" :question/problem "![](images/b7/b75586450ddee4f682f02539e02462d0aa5f88830b2989cc7cc2f4f6df635ade.png)\n\nFind ${lim}_{x\\to \\,-1}(5+7x)^{3}(f(x)-x)^{4}$ for the function $f(x)$ plotted above." :question/worked-solution "From the graph, we get that ${lim}_{x\\to \\,-1}f(x)=0.$ \n\nFrom the product rule, we have\n\n$$\n{lim}_{x\\to \\,-1}(5+7x)^{3}(f(x)-x)^{4}={lim}_{x\\to \\,-1}(5+7x)^{3}\\cdot {lim}_{x\\to \\,-1}(f(x)-x)^{4}.\n$$\n\nWe calculate the limits of each factor, separately.\n\nApplying the power rule, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,-1}(5+7x)^{3} & ={({lim}_{x\\to \\,-1}(5+7x))}^{3} \\\\  & =(5+7\\cdot (-1))^{3} \\\\  & =(-2)^{3} \\\\  & =-8,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,-1}(f(x)-x)^{4} & ={({lim}_{x\\to \\,-1}(f(x)-x))}^{4} \\\\  & =(0-(-1))^{4} \\\\  & ={1}^{4} \\\\  & =1\\,.\\end{aligned}\n$$\n\nFinally, we have\n \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,-1}(5+7x)^{3}(f(x)-x)^{4} & ={lim}_{x\\to \\,-1}(5+7x)^{3}\\cdot {lim}_{x\\to \\,-1}(f(x)-x)^{4} \\\\  & =(-8)\\cdot (1) \\\\  & =-8\\,.\\end{aligned}\n$$"} :step/id #uuid "4c6aa450-6cdc-50b4-806e-6dec30f5eb67" :step/next {:db/id #edb/ref 17592186534155}} {:db/id #edb/ref 17592186534155 :step/content {:db/id #edb/ref 17592186233995 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5797e9e9-6e67-537d-a655-48ab777ada22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{21}}{2}" :db/id #edb/ref 17592186533344} {:answer/id #uuid "6cc339c6-f7b7-5c24-ab62-8e1ff9e4ed3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186533394} {:answer/id #uuid "df10c16c-70c6-58c4-9182-e668df07e549" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186533689} {:answer/id #uuid "e6d0edc5-1ae9-515d-a0fc-bd1888788abb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{21}{4}" :db/id #edb/ref 17592186533708} {:answer/id #uuid "f40b5418-f57a-574c-a2f2-815b0c4b394d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186533739}] :answer-field/correct {:db/id #edb/ref 17592186533394} :answer-field/id #uuid "db0ef0b5-fcba-553e-ac8c-0225ffb723a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186533931}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "946e7009-82f2-5bbe-a154-157adaaa3621" :question/math-academy-id "q-35295" :question/problem "![](images/95/95e092490e087b5245f05b352b4738beb1ce3d9d649ea289ded881d0728129e5.png)\n\nFind ${lim}_{x\\to 1/2}\\sqrt{4(f(x))^{4}+10x}$ for the function $f(x)$ plotted above." :question/worked-solution "From the graph, we get that ${lim}_{x\\to 1/2}f(x)=1.$\n\nApplying the root rule, we have \n\n$$\n\\begin{aligned}{lim}_{x\\to 1/2}\\sqrt{4(f(x))^{4}+10x} & =\\sqrt{{lim}_{x\\to 1/2}(4(f(x))^{4}+10x)} \\\\  & =\\sqrt{4(1)^{4}+10\\cdot \\frac{1}{2}} \\\\  & =\\sqrt{4+5} \\\\  & =\\sqrt{9} \\\\  & =3\\,.\\end{aligned}\n$$"} :step/id #uuid "ec7c12e6-02c7-5b5a-a366-35e1a8ba03d7" :step/next {:db/id #edb/ref 17592186534118}}] :activity/title "The Power and Root Rules for Limits" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186533121}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186563772} :activity/id #uuid "893cd585-763a-5ad4-9659-5052de0c1e02" :activity/scope {:db/id #edb/ref 17592186050987 :topic/id #uuid "7734519e-e666-5361-81f3-89b86b5bc28d" :topic/math-academy-id 37} :activity/steps [{:db/id #edb/ref 17592186563772 :step/content {:db/id #edb/ref 17592186563742 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16ba1e29-25ac-579d-9cfe-24448c56edab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186562995} {:answer/id #uuid "a0bf2b88-34c6-53e4-a455-89e06f7f9a7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186563306} {:answer/id #uuid "db467dc8-4b26-512d-821f-e3c4973e9fd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[3]{6}" :db/id #edb/ref 17592186563426} {:answer/id #uuid "fbdaaac8-b49f-51b4-b323-7ea59a4fdd9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{\\sqrt[3]{2}}" :db/id #edb/ref 17592186563510} {:answer/id #uuid "ff7f4802-e1a5-55e2-9352-05637b9f8392" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186563516}] :answer-field/correct {:db/id #edb/ref 17592186563516} :answer-field/id #uuid "ddff0f96-aeb7-5490-8d56-4c8b9d0de231" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563630}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d591e3b7-0993-5fb9-b7f0-ff97c33bf559" :question/math-academy-id "q-100250" :question/problem "Find ${lim}_{x\\to 2}\\frac{3x}{\\sqrt[3]{2{x}^{4}-5}}.$" :question/worked-solution "Applying the quotient rule, we get\n\n$$\n{lim}_{x\\to 2}\\frac{3x}{\\sqrt[3]{2{x}^{4}-5}}=\\frac{{lim}_{x\\to 2}3x}{{lim}_{x\\to 2}\\sqrt[3]{2{x}^{4}-5}}\n$$\n\nWe calculate the limits of the numerator and denominator, separately.\n\nFor the numerator, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}3x & =3{lim}_{x\\to 2}x \\\\  & =3\\cdot 2 \\\\  & =6\\,.\\end{aligned}\n$$\n\nApplying the root rule in the denominator, we have\n \n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\sqrt[3]{2{x}^{4}-5} & =\\sqrt[3]{{lim}_{x\\to 2}(2{x}^{4}-5)} \\\\  & =\\sqrt[3]{2(2)^{4}-5)} \\\\  & =\\sqrt[3]{27} \\\\  & =3\\,.\\end{aligned}\n$$\n\nConsequently,\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{3x}{\\sqrt[3]{2{x}^{4}-5}} & =\\frac{6}{3}=2\\,.\\end{aligned}\n$$"} :step/id #uuid "2e1eff63-f8c6-5d02-9662-7565ab1c3899" :step/next {:db/id #edb/ref 17592186563794}} {:db/id #edb/ref 17592186563787 :step/content {:db/id #edb/ref 17592186563660 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d434ed0-8529-5bae-a087-2963bb7442d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186562969}] :answer-field/correct {:db/id #edb/ref 17592186562969} :answer-field/id #uuid "32d33a71-45d3-5a70-b6f2-f587f0b3ec0b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186563550}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2b9acb7e-8235-5df0-907d-863119079541" :question/math-academy-id "q-338390" :question/problem "Find the **exact** value of the limit.\n\n${lim}_{t\\to -1}(\\sqrt[7]{(2t+1)^{7}}-\\sqrt[3]{({t}^{2}+t+1)^{6}})=$\n{{field-1}}" :question/worked-solution "Applying the sum and root rules, we get\n\n \n\n$$\n\\begin{aligned}{lim}_{t\\to -1}(\\sqrt[7]{(2t+1)^{7}}-\\sqrt[3]{({t}^{2}+t+1)^{6}}) & ={lim}_{t\\to -1}\\sqrt[7]{(2t+1)^{7}}-{lim}_{t\\to -1}\\sqrt[3]{({t}^{2}+t+1)^{6}} \\\\  & =\\sqrt[7]{{({lim}_{t\\to -1}(2t+1))}^{7}}-\\sqrt[3]{{({lim}_{t\\to -1}({t}^{2}+t+1))}^{6}} \\\\  & =\\sqrt[7]{(2(-1)+1)^{7}}-\\sqrt[3]{(((-1)^{2}+(-1)+1))^{6}} \\\\  & =\\sqrt[7]{(-2+1)^{7}}-\\sqrt[3]{((1-1+1))^{6}} \\\\  & =\\sqrt[7]{(-1)^{7}}-\\sqrt[3]{(1)^{6}} \\\\  & =\\sqrt[7]{-1}-\\sqrt[3]{1} \\\\  & =-1-1 \\\\  & =-2.\\end{aligned}\n$$"} :step/id #uuid "75c9d97b-2b75-5de2-b1d4-d07fb1dfbf30"} {:db/id #edb/ref 17592186563794 :step/content {:db/id #edb/ref 17592186563676 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "066cb984-e17a-5fea-af4c-48188475d862" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186562952}] :answer-field/correct {:db/id #edb/ref 17592186562952} :answer-field/id #uuid "817fc64f-fe17-5ab1-8ab5-8f8ebfd722a2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186563582}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "41ad1c03-af11-5517-b3f9-c73f27dc13ff" :question/math-academy-id "q-338364" :question/problem "![](images/94/94027c25ef78ae46d0deb4b577339daf878efd71b71029a9575f9c8ed9096e2c.png)\n\nIf the figure above shows the graph of the function $f(x),$ then\n\n${lim}_{x\\to \\,2}(x-1)^{2}\\,(f(x)-2)^{3}=$\n{{field-1}}" :question/worked-solution "From the graph, we get that ${lim}_{x\\to \\,2}f(x)=3.$\n\nFrom the product rule, we have\n\n$$\n{lim}_{x\\to \\,2}(x-1)^{2}\\,(f(x)-2)^{3}={lim}_{x\\to \\,2}(x-1)^{2}\\cdot {lim}_{x\\to \\,2}(f(x)-2)^{3}.\n$$\n\nWe calculate the limits of each factor, separately.\n\nApplying the power rule, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,2}(x-1)^{2} & ={({lim}_{x\\to \\,2}(x-1))}^{2} \\\\  & =(2-1)^{2} \\\\  & ={1}^{2} \\\\  & =1\\,,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,2}(f(x)-2)^{3} & ={({lim}_{x\\to \\,2}(f(x)-2))}^{3} \\\\  & =(3-2)^{3} \\\\  & ={1}^{3} \\\\  & =1\\,.\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,2}(x-1)^{2}\\,(f(x)-2)^{3} & =(1)\\cdot (1) \\\\  & =1.\\end{aligned}\n$$"} :step/id #uuid "9a7d063a-cc3c-5001-8da3-bc7d18a9ea75" :step/next {:db/id #edb/ref 17592186563787}}] :activity/title "The Power and Root Rules for Limits" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186562932}]}
