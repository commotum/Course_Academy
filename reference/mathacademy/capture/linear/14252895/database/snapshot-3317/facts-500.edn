b/ref 1075 #edb/ref 17592186575402 #edb/ref 17592186045417] [17592186575474 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186575474 #edb/ref 1077 "field-3" #edb/ref 17592186045417] [17592186575474 #edb/ref 1078 #edb/ref 17592186575402 #edb/ref 17592186045417] [17592186575474 #edb/ref 1079 #uuid "97e49246-be20-50e1-b49e-21fb6572d864" #edb/ref 17592186045417] [17592186575488 #edb/ref 1075 #edb/ref 17592186575403 #edb/ref 17592186045417] [17592186575488 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186575488 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186575488 #edb/ref 1078 #edb/ref 17592186575403 #edb/ref 17592186045417] [17592186575488 #edb/ref 1079 #uuid "b99fd557-903d-52f2-b885-ba116704ea23" #edb/ref 17592186045417] [17592186575510 #edb/ref 1075 #edb/ref 17592186575070 #edb/ref 17592186045417] [17592186575510 #edb/ref 1075 #edb/ref 17592186575121 #edb/ref 17592186045417] [17592186575510 #edb/ref 1075 #edb/ref 17592186575197 #edb/ref 17592186045417] [17592186575510 #edb/ref 1075 #edb/ref 17592186575289 #edb/ref 17592186045417] [17592186575510 #edb/ref 1075 #edb/ref 17592186575395 #edb/ref 17592186045417] [17592186575510 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186575510 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186575510 #edb/ref 1078 #edb/ref 17592186575070 #edb/ref 17592186045417] [17592186575510 #edb/ref 1079 #uuid "dad8335d-f4a7-566b-a578-6ac7a63c8d7b" #edb/ref 17592186045417] [17592186575517 #edb/ref 1075 #edb/ref 17592186574981 #edb/ref 17592186045417] [17592186575517 #edb/ref 1075 #edb/ref 17592186575054 #edb/ref 17592186045417] [17592186575517 #edb/ref 1075 #edb/ref 17592186575064 #edb/ref 17592186045417] [17592186575517 #edb/ref 1075 #edb/ref 17592186575247 #edb/ref 17592186045417] [17592186575517 #edb/ref 1075 #edb/ref 17592186575336 #edb/ref 17592186045417] [17592186575517 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186575517 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186575517 #edb/ref 1078 #edb/ref 17592186575054 #edb/ref 17592186045417] [17592186575517 #edb/ref 1079 #uuid "ea40d3ec-5a65-5f11-9245-74d21f7dd219" #edb/ref 17592186045417] [17592186575527 #edb/ref 1068 #edb/ref 17592186575488 #edb/ref 17592186045417] [17592186575527 #edb/ref 1069 "q-338386" #edb/ref 17592186045417] [17592186575527 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186575527 #edb/ref 1071 "Find the **exact** value of the limit.\n\n${lim}_{x\\to 0}\\sqrt{(3{x}^{2}+6x+9)^{3}}=$\n{{field-1}}" #edb/ref 17592186045417] [17592186575527 #edb/ref 1072 #uuid "03d1d0b4-f385-5136-a615-f2e1e9fef632" #edb/ref 17592186045417] [17592186575527 #edb/ref 1074 "Applying the root rule, we get\n\n \n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\sqrt{(3{x}^{2}+6x+9)^{3}} & =\\sqrt{{lim}_{x\\to 0}(3{x}^{2}+6x+9)^{3}} \\\\  & =\\sqrt{{({lim}_{x\\to 0}(3{x}^{2}+6x+9))}^{3}} \\\\  & =\\sqrt{(3(0)^{2}+6(0)+9)^{3}} \\\\  & =\\sqrt{(0+0+9)^{3}} \\\\  & =\\sqrt{{9}^{3}} \\\\  & =\\sqrt{729} \\\\  & =27.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186575532 #edb/ref 1068 #edb/ref 17592186575465 #edb/ref 17592186045417] [17592186575532 #edb/ref 1069 "q-67953" #edb/ref 17592186045417] [17592186575532 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186575532 #edb/ref 1071 "![](images/7f/7f021a38a2c0c2098c14b2af479a609e85f6903ec84b4eafc71cb599becee3d9.png)\n\nWhich of the graphs above represent proportional relationships?" #edb/ref 17592186045417] [17592186575532 #edb/ref 1072 #uuid "1ac9a15a-91b5-5333-bd21-1c4aeb66e1dd" #edb/ref 17592186045417] [17592186575532 #edb/ref 1074 "Remember that the graph of a proportional relationship is always a straight line that passes through the origin $(0,0).$\n\nOf the given graphs, only graph III fits this description.\n\n- Graph I is not a straight line.\n\n- Graphs II and IV do not pass through the origin $(0,0).$\n\nTherefore, the correct answer is \"III only\"." #edb/ref 17592186045417] [17592186575561 #edb/ref 1068 #edb/ref 17592186575410 #edb/ref 17592186045417] [17592186575561 #edb/ref 1069 "q-22036" #edb/ref 17592186045417] [17592186575561 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186575561 #edb/ref 1071 "![](images/a3/a36fe195458e459aea993232a72ed21e0c780135dc4dbe4bece45bfc3b6e50e2.png)\n\nThe perimeter of the above triangle is $50+25\\sqrt{2}.$ Find the measure of each leg." #edb/ref 17592186045417] [17592186575561 #edb/ref 1072 #uuid "7002a70c-d40e-53ed-9d27-c94492760a6a" #edb/ref 17592186045417] [17592186575561 #edb/ref 1074 "Because the triangle is isosceles, the legs must have the same length. Let $a$ be the length of each leg. So, we have\n\n$$\nAB=BC=a.\n$$\n\nMoreover, because the triangle is a *right* isosceles triangle, the hypotenuse must be equal to $\\sqrt{2}$ times the length of a leg. Therefore,\n\n$$\nAC=AB\\cdot \\sqrt{2}=a\\sqrt{2}.\n$$\n\nFinally, since the perimeter is $p=50+25\\sqrt{2},$ we have\n\n$$\n\\begin{aligned}p & =AB+BC+AC \\\\ 50+25\\sqrt{2} & =a+a+a\\sqrt{2} \\\\ 25(2+\\sqrt{2}) & =2a+a\\sqrt{2} \\\\ 25(2+\\sqrt{2}) & =(2+\\sqrt{2})a \\\\ 25\\cancel{(2+\\sqrt{2})} & =\\cancel{(2+\\sqrt{2})}a \\\\ 25 & =a\\end{aligned}\n$$\n\nTherefore, the measure of a leg is $25.$" #edb/ref 17592186045417] [17592186575563 #edb/ref 1068 #edb/ref 17592186575517 #edb/ref 17592186045417] [17592186575563 #edb/ref 1069 "q-3682" #edb/ref 17592186045417] [17592186575563 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186575563 #edb/ref 1071 "![](images/a3/a32739957ef5ff1bf81f49b1b1baaaab69c6ef3d2613f8ac09ad4020c91c50f7.png)\n\nWhat is the equation of the curve shown above?" #edb/ref 17592186045417] [17592186575563 #edb/ref 1072 #uuid "745d6485-4fab-5db3-ad5a-442675f1d8d6" #edb/ref 17592186045417] [17592186575563 #edb/ref 1074 "Remember that $y=|x-h|+k$ is a vertical translation of the absolute value graph $y=|x|$ by $h$ units right and $k$ units up.\n\nHere, the graph is moved left by $4$ units and down by $1$ unit. This corresponds to $h=-4$ and $k=-1.$ So, the equation of the graph is $y=|x+4|-1.$\n\n![](images/fc/fcaf6e4e5e5fa63724be00a344c725e8bc9095c74c8b1114a0dbe90e9ac31935.png)" #edb/ref 17592186045417] [17592186575566 #edb/ref 1068 #edb/ref 17592186575436 #edb/ref 17592186045417] [17592186575566 #edb/ref 1069 "q-76083" #edb/ref 17592186045417] [17592186575566 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186575566 #edb/ref 1071 "What is the set of values of $x$ that satisfy $3\\le 4x+7\\le 19$ or $6x+8<2?$" #edb/ref 17592186045417] [17592186575566 #edb/ref 1072 #uuid "7c7074e0-f02c-5273-a98a-de3d3f3ee6a7" #edb/ref 17592186045417] [17592186575566 #edb/ref 1074 "We start by solving $3\\le 4x+7\\le 19:$\n\n$$\n\\begin{aligned}3 & \\le 4x+7\\le 19 \\\\ -4 & \\le 4x\\le 12 \\\\ -1 & \\le x\\le 3\\end{aligned}\n$$\n\n![](images/7d/7d7303c5608dbd17911794959438f925d7ab6edd3ebba600d657b396ccf8eaa9.png)\n\nThen, we solve $6x+8<2:$\n\n$$\n\\begin{aligned}6x+8 & <2 \\\\ 6x & <-6 \\\\ x & <-1\\end{aligned}\n$$\n\n![](images/ad/ad5692ee92c2b67f50c0354020642bd9c711bdf7b88f4d476455512e33f9fc5f.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/63/638b44af1e33b78102a0dbfa3857c1292f200e026f54adf92fe77a97bf7e10a1.png)\n\nTherefore, the final solution is $x\\le 3.$" #edb/ref 17592186045417] [17592186575567 #edb/ref 1068 #edb/ref 17592186575510 #edb/ref 17592186045417] [17592186575567 #edb/ref 1069 "q-109613" #edb/ref 17592186045417] [17592186575567 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186575567 #edb/ref 1071 "Write $y=\\frac{1}{5}x+2$ in standard form." #edb/ref 17592186045417] [17592186575567 #edb/ref 1072 #uuid "7f25e8cf-a84e-5491-8095-e34846bd72c0" #edb/ref 17592186045417] [17592186575567 #edb/ref 1074 "Our goal is to write the equation in the form $ax+by=c,$ where $a,b,$ and $c$ are integers with no common factors and $a\\ge 0.$\n\nWe begin by moving all of the variables to the left-hand side and all of the constants to the right-hand side. This gives\n\n$$\n-\\frac{1}{5}x+y=2\n$$\n\nNow, we multiply both sides of the equation by $-1:$\n\n$$\n\\begin{aligned}-\\frac{1}{5}x+y & =2 \\\\ (-1)\\cdot (-\\frac{1}{5}x+y) & =(-1)\\cdot (2) \\\\ \\frac{1}{5}x-y & =-2.\\end{aligned}\n$$\n\nFinally, we multiply both sides of the equation by $5:$\n\n$$\n\\begin{aligned}\\frac{1}{5}x-y & =-2 \\\\ 5\\cdot (\\frac{1}{5}x-y) & =5\\cdot (-2) \\\\ x-5y & =-10.\\end{aligned}\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a\\ge 0.$ So we are done!\n\nThe standard form of the line is $x-5y=-10.$" #edb/ref 17592186045417] [17592186575582 #edb/ref 1068 #edb/ref 17592186575464 #edb/ref 17592186045417] [17592186575582 #edb/ref 1069 "q-78760" #edb/ref 17592186045417] [17592186575582 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186575582 #edb/ref 1071 "![](images/61/612a4d26c399f754318b7aceb2bb0f329cf9515ea49a7da0d84d5d4aa1b672ea.png)\n\nUsing the graphical method, find the solutions $(x,y)$ of the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}y &=-5 \\\\ y &=-{x}^{2}+4\\end{aligned}\\right.\n$$" #edb/ref 17592186045417] [17592186575582 #edb/ref 1072 #uuid "a422bda1-83e5-5ea1-b276-7fb095067ffb" #edb/ref 17592186045417] [17592186575582 #edb/ref 1074 "The solutions $(x,y)$ of the system correspond to the intersection points of the two curves.\n\n![](images/6d/6d9da50ac2c05ae16125d48ed96e5a7a7ed1dbc03ddb53e96ab301d502abb17f.png)\n\nWe see from the graph that the curves intersect at \n\n$\\,$ $(-3,-5)\\,$ and $\\,(3,-5).$ \n\nTherefore, these are the solutions of the corresponding system." #edb/ref 17592186045417] [17592186575616 #edb/ref 1068 #edb/ref 17592186575416 #edb/ref 17592186045417] [17592186575616 #edb/ref 1068 #edb/ref 17592186575447 #edb/ref 17592186045417] [17592186575616 #edb/ref 1068 #edb/ref 17592186575474 #edb/ref 17592186045417] [17592186575616 #edb/ref 1069 "q-225260" #edb/ref 17592186045417] [17592186575616 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186575616 #edb/ref 1071 "**Fully** factor the following trinomial.\n\n$-12{a}^{2}-6a+6=$\n{{field-1}}$(a\\,+$\n{{field-2}}\n$)($\n{{field-3}}\n$a\\,-1)$" #edb/ref 17592186045417] [17592186575616 #edb/ref 1072 #uuid "e8fb1410-51ee-5a0a-9a08-61072eaa2e45" #edb/ref 17592186045417] [17592186575616 #edb/ref 1074 "We need to factor the following expression:\n\n$$\n-12{a}^{2}-6a+6\n$$\n\nFirst, notice that all the terms have a common factor of $-6.$ So, we can simplify the calculation by first factoring out $-6:$\n\n$$\n\\begin{aligned}-6(2{a}^{2}+a-1)\\end{aligned}\n$$\n\nNow, we just need to factor the trinomial $2{a}^{2}+a-1$ in parentheses. To do this, we find two numbers that \n\n- multiply to the product of the quadratic coefficient and the constant (which is $2\\times (-1)=-2$), and\n\n- add to the linear coefficient (which is $1$).\n\nThe factor pairs of $-2$ are\n\n$$\n(1,-2),\\,(-1,2).\n$$\n\nNotice the numbers in the factor pair $(-1,2)$ add to $1:$ \n\n$$\n-1+2=1\\,✓\n$$\n\nThen, we write the linear term as $-a+2a,$ and factor the result by grouping:\n\n$$\n\\begin{aligned}2{a}^{2}+a-1 & = \\\\ 2{a}^{2}-a+2a-1 & = \\\\ (2{a}^{2}-a)+(2a-1) & = \\\\ a(2a-1)+(2a-1) & = \\\\ (a+1)(2a-1) & \\end{aligned}\n$$\n\nTherefore, the original trinomial factors as follows:\n\n$$\n\\begin{aligned}-12{a}^{2}-6a+6 & = \\\\ -6(2{a}^{2}+a-1) & = \\\\ -6(a+1)(2a-1) & \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186575632 #edb/ref 1058 #edb/ref 17592186575662 #edb/ref 17592186045417] [17592186575632 #edb/ref 1062 #uuid "1786b470-22a1-5126-81ff-d7683858760a" #edb/ref 17592186045417] [17592186575632 #edb/ref 1063 #edb/ref 17592186575527 #edb/ref 17592186045417] [17592186575634 #edb/ref 1058 #edb/ref 17592186575641 #edb/ref 17592186045417] [17592186575634 #edb/ref 1062 #uuid "18997cdd-4144-5716-af59-75b7831d1856" #edb/ref 17592186045417] [17592186575634 #edb/ref 1063 #edb/ref 17592186575563 #edb/ref 17592186045417] [17592186575641 #edb/ref 1062 #uuid "24fa352b-f67b-509b-9a54-bff1759f7275" #edb/ref 17592186045417] [17592186575641 #edb/ref 1063 #edb/ref 17592186575532 #edb/ref 17592186045417] [17592186575643 #edb/ref 1058 #edb/ref 17592186575683 #edb/ref 17592186045417] [17592186575643 #edb/ref 1062 #uuid "2f21507d-cf75-5bfa-9d60-c8df8743ef85" #edb/ref 17592186045417] [17592186575643 #edb/ref 1063 #edb/ref 17592186575582 #edb/ref 17592186045417] [17592186575661 #edb/ref 1058 #edb/ref 17592186575688 #edb/ref 17592186045417] [17592186575661 #edb/ref 1062 #uuid "6db8f8da-3b17-52a5-b393-3a58b8181d61" #edb/ref 17592186045417] [17592186575661 #edb/ref 1063 #edb/ref 17592186399961 #edb/ref 17592186045417]}
