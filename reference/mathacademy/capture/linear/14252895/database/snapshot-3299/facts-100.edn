edb/ref 17592186508991 #edb/ref 17592186045417] [17592186105872 #edb/ref 1038 #edb/ref 17592186508996 #edb/ref 17592186045417] [17592186105872 #edb/ref 1038 #edb/ref 17592186549027 #edb/ref 17592186045417] [17592186105872 #edb/ref 1039 "Finding the Base or the Height of a Triangle Given Its Area" #edb/ref 17592186045417] [17592186105872 #edb/ref 1041 #edb/ref 17592186105543 #edb/ref 17592186045417] [17592186105872 #edb/ref 1042 #uuid "a7656d23-06c9-5d22-b62a-3636bca66ab6" #edb/ref 17592186045417] [17592186106016 #edb/ref 1043 #edb/ref 17592186106853 #edb/ref 17592186045417] [17592186106016 #edb/ref 1043 #edb/ref 17592186106854 #edb/ref 17592186045417] [17592186106016 #edb/ref 1043 #edb/ref 17592186106855 #edb/ref 17592186045417] [17592186106016 #edb/ref 1043 #edb/ref 17592186106856 #edb/ref 17592186045417] [17592186106016 #edb/ref 1043 #edb/ref 17592186106857 #edb/ref 17592186045417] [17592186106016 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186106016 #edb/ref 1045 "Areas of Triangles" #edb/ref 17592186045417] [17592186106016 #edb/ref 1046 #edb/ref 17592186106853 #edb/ref 17592186045417] [17592186106016 #edb/ref 1049 #edb/ref 17592186049388 #edb/ref 17592186045417] [17592186106016 #edb/ref 1050 420.0 #edb/ref 17592186045417] [17592186106016 #edb/ref 1050 420.0 #edb/ref 17592186045436] [17592186106016 #edb/ref 1053 #uuid "21a47620-e3ce-58d1-b236-202e42fddc8e" #edb/ref 17592186045417] [17592186106853 #edb/ref 1058 #edb/ref 17592186106854 #edb/ref 17592186045417] [17592186106853 #edb/ref 1061 416085 #edb/ref 17592186045417] [17592186106853 #edb/ref 1062 #uuid "4293d690-2bd3-5e64-91c6-7e02a0c764f9" #edb/ref 17592186045417] [17592186106853 #edb/ref 1063 #edb/ref 17592186107053 #edb/ref 17592186045417] [17592186106854 #edb/ref 1058 #edb/ref 17592186106855 #edb/ref 17592186045417] [17592186106854 #edb/ref 1061 416086 #edb/ref 17592186045417] [17592186106854 #edb/ref 1062 #uuid "a5cb1ab1-345e-5828-babf-f43dc62b43f0" #edb/ref 17592186045417] [17592186106854 #edb/ref 1063 #edb/ref 17592186105870 #edb/ref 17592186045417] [17592186106855 #edb/ref 1058 #edb/ref 17592186106856 #edb/ref 17592186045417] [17592186106855 #edb/ref 1061 416089 #edb/ref 17592186045417] [17592186106855 #edb/ref 1062 #uuid "bf4e1141-e78b-57d6-8b32-737373cca813" #edb/ref 17592186045417] [17592186106855 #edb/ref 1063 #edb/ref 17592186105871 #edb/ref 17592186045417] [17592186106856 #edb/ref 1058 #edb/ref 17592186106857 #edb/ref 17592186045417] [17592186106856 #edb/ref 1061 416092 #edb/ref 17592186045417] [17592186106856 #edb/ref 1062 #uuid "e81bf9a1-61c3-5dc2-8537-01fb6d1a7871" #edb/ref 17592186045417] [17592186106856 #edb/ref 1063 #edb/ref 17592186105872 #edb/ref 17592186045417] [17592186106857 #edb/ref 1061 416095 #edb/ref 17592186045417] [17592186106857 #edb/ref 1062 #uuid "d47b1a6f-6091-5f5b-832a-9ce0b04d1526" #edb/ref 17592186045417] [17592186106857 #edb/ref 1063 #edb/ref 17592186107055 #edb/ref 17592186045417] [17592186107053 #edb/ref 1064 "The **area of a triangle** can be computed using the formula\n\n$$\n\\mathcal{A} = \\dfrac{b \\cdot h}{2},\n$$\n\nwhere $b$ is a *base* of the triangle and $h$ is the corresponding *height*.\n\nTo demonstrate, let's compute the area of the triangle with base \n$b = 4$\nand the corresponding height is\n$h = 8,$\nas shown below.\n\n![](images/84/84de11aac8e9f33a459f2a83647dac43eb2054445d842ac769511711366a15ec.png)\n\nThe area is\n\n$$\n\\begin{aligned}A & =\\frac{b\\cdot h}{2} \\\\  & =\\frac{4\\cdot 8}{2} \\\\  & =\\frac{32}{2} \\\\  & =16.\\end{aligned}\n$$\n\n**Note:** At the end of the lesson, we'll demonstrate where the formula comes from. But first, let's get some practice using it." #edb/ref 17592186045417] [17592186107053 #edb/ref 1065 2306 #edb/ref 17592186045417] [17592186107053 #edb/ref 1066 #uuid "bf61df49-32c4-50ee-a6f4-21f9da391a02" #edb/ref 17592186045417] [17592186107053 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186107055 #edb/ref 1064 "We know that the area formula for a triangle is\n\n$$\n\\mathcal{A} = \\dfrac{b \\cdot h}{2},\n$$\n\nwhere $b$ is a base and $h$ is the corresponding height.\n\nBut where does this formula come from?\n\nTo understand where the formula comes from, consider $\\triangle{ABC}$ below.\n\n![](images/02/02c1ace5f18e9204c1559f08f591ecd692f00691c48cbee81bc4426c3b34400e.png)\n\nLet's draw a rectangle around $\\triangle{ABC},$ as follows:\n\n![](images/89/893026324410235de9cb7ac286867006593a451556587c60219fe4375a4218a4.png)\n\nWe have two pairs of right triangles with equal areas (each pair is indicated with arrows).\n\nSo, the area of $\\triangle{ABC}$ is exactly half of the area of the rectangle. This gives\n\n$$\n\\mathcal{A}_{ABC} = \\dfrac{AB \\cdot CH}{2}.\n$$" #edb/ref 17592186045417] [17592186107055 #edb/ref 1065 2311 #edb/ref 17592186045417] [17592186107055 #edb/ref 1066 #uuid "b5be18d9-4833-50c8-8800-085d64e21ce8" #edb/ref 17592186045417] [17592186107055 #edb/ref 1067 "Proof of the Formula" #edb/ref 17592186045417] [17592186114373 #edb/ref 1075 #edb/ref 17592186114374 #edb/ref 17592186045417] [17592186114373 #edb/ref 1075 #edb/ref 17592186114375 #edb/ref 17592186045417] [17592186114373 #edb/ref 1075 #edb/ref 17592186114376 #edb/ref 17592186045417] [17592186114373 #edb/ref 1075 #edb/ref 17592186114377 #edb/ref 17592186045417] [17592186114373 #edb/ref 1075 #edb/ref 17592186114378 #edb/ref 17592186045417] [17592186114373 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186114373 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186114373 #edb/ref 1079 #uuid "44ac194c-0973-53bd-953a-017fa40875eb" #edb/ref 17592186045417] [17592186114374 #edb/ref 1080 "(- ∞, 0]∪(2, 4)" #edb/ref 17592186045417] [17592186114374 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186114374 #edb/ref 1083 #uuid "9d22ef26-67e9-570b-ae16-d5566bfb5791" #edb/ref 17592186045417]}
