![](images/6d/6d9da50ac2c05ae16125d48ed96e5a7a7ed1dbc03ddb53e96ab301d502abb17f.png)\n\nWe see from the graph that the curves intersect at \n\n$\\,$ $(-3,-5)\\,$ and $\\,(3,-5).$ \n\nTherefore, these are the solutions of the corresponding system."] ["question-a422bda1-83e5-5ea1-b276-7fb095067ffb" :question/difficulty :question.difficulty/easy] ["answer-field-70c3d0a0-cfc9-5368-8e0e-665d3b3527ab" :answer-field/id #uuid "70c3d0a0-cfc9-5368-8e0e-665d3b3527ab"] ["answer-228618c5-7982-5340-bbbe-5a5309961ca7" :answer/id #uuid "228618c5-7982-5340-bbbe-5a5309961ca7"] ["answer-228618c5-7982-5340-bbbe-5a5309961ca7" :answer/type :answer.type/text] ["answer-228618c5-7982-5340-bbbe-5a5309961ca7" :answer/value "$(-2,-5)$ and $(2,-5)$"] ["answer-1c832b98-50f0-54df-a19b-b731f40d7b8f" :answer/id #uuid "1c832b98-50f0-54df-a19b-b731f40d7b8f"] ["answer-1c832b98-50f0-54df-a19b-b731f40d7b8f" :answer/type :answer.type/text] ["answer-1c832b98-50f0-54df-a19b-b731f40d7b8f" :answer/value "$(-2,-5)$ and $(4,-5)$"] ["answer-9600d968-3c28-5e90-826a-fb2d658d24fb" :answer/id #uuid "9600d968-3c28-5e90-826a-fb2d658d24fb"] ["answer-9600d968-3c28-5e90-826a-fb2d658d24fb" :answer/type :answer.type/text] ["answer-9600d968-3c28-5e90-826a-fb2d658d24fb" :answer/value "$(-2,0)$ and $(2,0)$"] ["answer-8c967535-4ab0-58a8-a729-8bc0b2f84aea" :answer/id #uuid "8c967535-4ab0-58a8-a729-8bc0b2f84aea"] ["answer-8c967535-4ab0-58a8-a729-8bc0b2f84aea" :answer/type :answer.type/text] ["answer-8c967535-4ab0-58a8-a729-8bc0b2f84aea" :answer/value "$(-3,-5)$ and $(3,-5)$"] ["answer-61f21a8c-0f7f-5782-adc3-cc79fe53c3e1" :answer/id #uuid "61f21a8c-0f7f-5782-adc3-cc79fe53c3e1"] ["answer-61f21a8c-0f7f-5782-adc3-cc79fe53c3e1" :answer/type :answer.type/text] ["answer-61f21a8c-0f7f-5782-adc3-cc79fe53c3e1" :answer/value "$(-3,0)$ and $(3,0)$"] ["answer-field-70c3d0a0-cfc9-5368-8e0e-665d3b3527ab" :answer-field/key "selection"] ["answer-field-70c3d0a0-cfc9-5368-8e0e-665d3b3527ab" :answer-field/type :answer-field.type/radio] ["answer-fi