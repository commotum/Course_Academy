#{[{:activity/first-step {:db/id #edb/ref 17592186193788} :activity/id #uuid "50c3226a-1d5b-58e4-9444-8327687e10d6" :activity/scope {:db/id #edb/ref 17592186049476 :topic/id #uuid "f8103613-5f0a-54a0-addc-d78e255cf66c" :topic/math-academy-id 3979} :activity/steps [{:db/id #edb/ref 17592186193573 :step/content {:db/id #edb/ref 17592186192728 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192441 :question/id #uuid "ea43cc4f-099a-5f47-885b-17d06c30c932" :question/math-academy-id "e-10618"} :knowledge-point/id #uuid "96a6d19b-af7f-5abd-9713-abb4455e52bf" :knowledge-point/questions [{:db/id #edb/ref 17592186193097} {:db/id #edb/ref 17592186193344}] :knowledge-point/title "Identifying Parallel and Perpendicular Lines in Figures"} :step/id #uuid "bab0d88d-b8de-55ea-9d2b-0f4b6cad3fb7" :step/math-academy-id 40165} {:db/id #edb/ref 17592186193574 :step/content {:db/id #edb/ref 17592186192729 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192442 :question/id #uuid "04518004-e56e-53f5-97b3-32ca751b61cb" :question/math-academy-id "e-10619"} :knowledge-point/id #uuid "241b7ea0-ba03-538f-a4f0-18739424e576" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048723}] :knowledge-point/questions [{:db/id #edb/ref 17592186193082} {:db/id #edb/ref 17592186193096} {:db/id #edb/ref 17592186424821}] :knowledge-point/title "Perpendicular Lines"} :step/id #uuid "7c4c30b3-081a-57b6-a2af-8ec7f827411f" :step/math-academy-id 40166 :step/next {:db/id #edb/ref 17592186193573}} {:db/id #edb/ref 17592186193580 :step/content {:db/id #edb/ref 17592186193847 :tutorial/content "Two lines are **perpendicular** if they intersect and form a $90^\\circ$ angle.\n\nFor example, the lines $r$ and $s$ below are perpendicular.\n\n![](images/73/73d2e836e942d6e468c8d9652921a9321b842d47b54ba59529123da61a9a96b4.png)\n\nWhen two lines are perpendicular, we can express this with the symbol $\\perp$, as follows:\n\n$$\nr \\perp s\n$$\n\nIn words, we say, \"the line $r$ is perpendicular to the line $s$.\"" :tutorial/id #uuid "2580c600-ddf7-5d7e-983d-e971ce3c6700" :tutorial/math-academy-id 6653 :tutorial/title "Perpendicular Lines"} :step/id #uuid "450ba46d-28c8-58be-945a-54fa0106cb15" :step/math-academy-id 40259 :step/next {:db/id #edb/ref 17592186193574}} {:db/id #edb/ref 17592186193788 :step/content {:db/id #edb/ref 17592186193812 :tutorial/content "Two lines are **parallel** if they never meet. So, for example, the lines $r$ and $s$ below are parallel.\n\n![](images/d9/d9bcd3cb4e201292afd4c3dca68273f16cff43d76c5a6a2f80348f5d8db1bd4c.png)\n\nIf two lines are parallel, we can express this using the $\\parallel$ symbol as follows:\n\n$$\nr \\parallel s\n$$\n\nIn words, we say, \"the line $r$ is parallel to the line $s$.\"\n\nIf two lines are not parallel, they must have a common point. In this case, we say that the lines **intersect**.\n\nFor example, the lines $v$ and $w$ below intersect at the point $P{:}$\n\n![](images/a6/a659c4a23e60880656c4fea0ec8e6ca63e0d9e55704fdb53b5bdf1a6e30b89e3.png)\n\nWe have the following important property about lines in two-dimensional space.\n\n> *Any two distinct lines are either parallel or intersect at exactly one point.*" :tutorial/id #uuid "b5d86f95-6437-58f6-a35f-cf72da79271b" :tutorial/math-academy-id 2162 :tutorial/title "Introduction"} :step/id #uuid "17a99595-6232-50d3-939f-80b3dee5b912" :step/math-academy-id 8694 :step/next {:db/id #edb/ref 17592186193789}} {:db/id #edb/ref 17592186193789 :step/content {:db/id #edb/ref 17592186192855 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192614 :question/id #uuid "4819c67f-cc06-555f-ab29-0b63e9ddb164" :question/math-academy-id "e-2544"} :knowledge-point/id #uuid "fccf0330-1c65-5585-aeaf-2efee13aa89c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049350}] :knowledge-point/questions [{:db/id #edb/ref 17592186193081} {:db/id #edb/ref 17592186193343}] :knowledge-point/title "Parallel Lines"} :step/id #uuid "81ac2285-c162-59f3-94c2-bfff181b2ee6" :step/math-academy-id 8695 :step/next {:db/id #edb/ref 17592186193580}}] :activity/title "Parallel and Perpendicular Lines" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186192890}]}
