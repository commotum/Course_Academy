:knowledge-point/_questions [{:db/id #edb/ref 17592186192728 :knowledge-point/id #uuid "96a6d19b-af7f-5abd-9713-abb4455e52bf" :knowledge-point/title "Identifying Parallel and Perpendicular Lines in Figures"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e0ee358-b0b8-5e46-96cd-100c7ec69c8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\overset{―}{UP}⊥\\overset{―}{ST}$ and $\\overset{―}{PQ}⊥\\overset{―}{RS}$" :db/id #edb/ref 17592186447392} {:answer/id #uuid "4671dac0-bbb0-5fa6-8601-b114c50e020d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{UP}⊥\\overset{―}{ST}" :db/id #edb/ref 17592186447399} {:answer/id #uuid "5e68d63c-4d7e-5d45-8b8a-6533113be391" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\overset{―}{UP}⊥\\overset{―}{TU}$ and $\\overset{―}{ST}⊥\\overset{―}{TU}$" :db/id #edb/ref 17592186447407} {:answer/id #uuid "7dfd0425-445a-521f-bbc6-60a718f71b38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{QR}⊥\\overset{―}{TU}" :db/id #edb/ref 17592186447418} {:answer/id #uuid "d284ab2c-0ba3-561d-9483-739740f7bed6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\overset{―}{UP}⊥\\overset{―}{PQ}$ and $\\overset{―}{RS}⊥\\overset{―}{ST}$" :db/id #edb/ref 17592186447441}] :answer-field/correct {:answer/id #uuid "d284ab2c-0ba3-561d-9483-739740f7bed6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\overset{―}{UP}⊥\\overset{―}{PQ}$ and $\\overset{―}{RS}⊥\\overset{―}{ST}$" :db/id #edb/ref 17592186447441} :answer-field/id #uuid "59678b0c-54a4-5936-9c40-9493ba3f94b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186447454}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2d6731a9-4b1d-5a58-8690-9d08ea615462" :question/math-academy-id "q-153412" :question/problem "![](images/e8/e8caa8e283c60d845c4b8fbe2c352818d300b51748f37b9788eac0bf1e73b7d5.png)\n\nIn the figure above, find the perpendicular sides." :question/worked-solution "Two lines are perpendicular if they intersect and form a ${90}^{∘}$ angle.\n\nFirst, notice that we have two sets of perpendicular lines:\n\n- $\\overset{⟷}{PU}$ is perpendicular to $\\overset{⟷}{PQ}$\n\n- $\\overset{⟷}{RS}$ is perpendicular to $\\overset{⟷}{ST}$\n\n![](images/24/2492594432bf29b2753d646c53b66ffd6230c21db71c4dd12479c9811217dc91.png)\n\nTherefore, we conclude that the sides $\\overset{―}{UP}$ and $\\overset{―}{PQ}$ are perpendicular, and $\\overset{―}{RS}$ and $\\overset{―}{ST}$ are also perpendicular. We can write this as follows:\n\n$\\,$ $\\overset{―}{UP}⊥\\overset{―}{PQ}$ and $\\overset{―}{RS}⊥\\overset{―}{ST}$"}] [{:db/id #edb/ref 17592186447475 :knowledge-point/_questions [{:db/id #edb/ref 17592186192728 :knowledge-point/id #uuid "96a6d19b-af7f-5abd-9713-abb4455e52bf" :knowledge-point/title "Identifying Parallel and Perpendicular Lines in Figures"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b74390b-09b9-593c-82b7-d426444631b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\overset{―}{AB}∥\\overset{―}{DE}$ and $\\overset{―}{AE}∥\\overset{―}{BC}$" :db/id #edb/ref 17592186447410} {:answer/id #uuid "7a66f47b-ac85-551b-a97a-3186d113774e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the sides are parallel" :db/id #edb/ref 17592186447417} {:answer/id #uuid "909d07a1-afb4-57a2-865a-03a683a8786a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{AB}∥\\overset{―}{DE}" :db/id #edb/ref 17592186447425} {:answer/id #uuid "ae0d3f4d-19fd-5dd8-857e-f6af7fd31107" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{BC}∥\\overset{―}{CD}" :db/id #edb/ref 17592186447431} {:answer/id #uuid "cd97c790-1250-5a1f-a5ed-85bd9459bebf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{AE}∥\\overset{―}{BC}" :db/id #edb/ref 17592186447439}] :answer-field/correct {:answer/id #uuid "909d07a1-afb4-57a2-865a-03a683a8786a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{AB}∥\\overset{―}{DE}" :db/id #edb/ref 17592186447425} :answer-field/id #uuid "7cac5234-5bf9-5934-97a2-7bc5d83dd335" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186447456}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f045e30a-5c77-5aee-853f-bedc4016f900" :question/math-academy-id "q-153499" :question/problem "![](images/86/8666a8c28b50deb88fc9e7cca3951b9d5fab9d8d07ede6abac774f41271324b5.png)\n\nIn the figure above, find the parallel sides." :question/worked-solution "Two lines are parallel if they never intersect.\n\nNow, let's examine the direction of the sides in the figure to determine whether any pair lies along parallel lines.\n\nNotice that the sides $\\overset{―}{AB}$ and $\\overset{―}{DE}$ both lie along horizontal lines. The remaining sides have different directions, so they do not form any additional pair of parallel sides.\n\n![](images/7f/7f55b88378fe0e9389ea7a540cc40a02c9e619854a6815e9700b808770fa3a13.png)\n\nTherefore, we conclude that the sides $\\overset{―}{AB}$ and $\\overset{―}{DE}$ are parallel. We can write this as follows: \n\n$$\n\\overset{―}{AB}∥\\overset{―}{DE}\n$$"}]}
