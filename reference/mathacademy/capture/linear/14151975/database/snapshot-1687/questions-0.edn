#{[{:db/id #edb/ref 17592186192441 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186192728 :knowledge-point/id #uuid "96a6d19b-af7f-5abd-9713-abb4455e52bf" :knowledge-point/title "Identifying Parallel and Perpendicular Lines in Figures"}] :question/id #uuid "ea43cc4f-099a-5f47-885b-17d06c30c932" :question/math-academy-id "e-10618" :question/problem "![](images/eb/eb47af89e11d26af59c0b7fa433358d7f9da16ecdd302722699b1e4e5fa1056a.png)\n\nIn the figure above, find the parallel sides." :question/worked-solution "Two lines are parallel if they never intersect.\n\nFirst, notice that the lines $\\overset{\\longleftrightarrow}{PQ}$ and  $\\overset{\\longleftrightarrow}{TS}$ are parallel.\n\n![](images/78/783488aa5e48aac72fe8aa4870f9a3e5621799475286bcc820573ae099b3ed6b.png)\n\nTherefore, we conclude that the sides $\\overline{PQ}$ and $\\overline{TS}$ are parallel. We can write this as follows: \n\n$$\n\\overline{PQ} \\parallel \\overline{TS}\n$$"}] [{:db/id #edb/ref 17592186192442 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186192729 :knowledge-point/id #uuid "241b7ea0-ba03-538f-a4f0-18739424e576" :knowledge-point/title "Perpendicular Lines"}] :question/id #uuid "04518004-e56e-53f5-97b3-32ca751b61cb" :question/math-academy-id "e-10619" :question/problem "List all of the perpendicular lines in the diagram below.\n\n![](images/99/9963d4b77fc1b6eaca723f2211a2dd64353ff4fcc3d9fc4b6d4c09889d35e5d3.png)" :question/worked-solution "![](images/35/3528edd920ddd50e0e976a46a78980708369f17f5809a3b8578af1bda683fc8b.png)\n\nTwo lines are perpendicular if they intersect and form a $90^\\circ$ angle.\n\nIn the given diagram, the only perpendicular lines are $p$ and $q.$"}] [{:db/id #edb/ref 17592186192614 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186192855 :knowledge-point/id #uuid "fccf0330-1c65-5585-aeaf-2efee13aa89c" :knowledge-point/title "Parallel Lines"}] :question/id #uuid "4819c67f-cc06-555f-ab29-0b63e9ddb164" :question/math-academy-id "e-2544" :question/problem "List all of the parallel lines in the diagram below.\n\n![](images/f8/f8a99100d247f17b42cdcb38d0298be9505bd0aec036216272fd25fdacb0bbf6.png)" :question/worked-solution "![](images/eb/ebebd8b07b11592683a280b53674fa5a153743830f833e752b5b16df1bbf809d.png)\n\nTwo lines are parallel if they never intersect.\n\nIn the given diagram, the only parallel lines are $l$ and $m.$"}] [{:db/id #edb/ref 17592186447463 :knowledge-point/_questions [{:db/id #edb/ref 17592186192729 :knowledge-point/id #uuid "241b7ea0-ba03-538f-a4f0-18739424e576" :knowledge-point/title "Perpendicular Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "220f8e8c-e14a-56af-ac51-6016a703f2a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a$ and $b$" :db/id #edb/ref 17592186447386} {:answer/id #uuid "392d3365-c0c8-5605-a6fb-2c9092a0317e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a$ and $b$, $c$ and $d$" :db/id #edb/ref 17592186447395} {:answer/id #uuid "71b03dc1-cf94-5fa8-9506-cf91ce3ea0c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$b$ and $c$" :db/id #edb/ref 17592186447413} {:answer/id #uuid "9bbeac6b-083a-5a51-9341-43d29e67f1a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$b$ and $c$, $a$ and $d$" :db/id #edb/ref 17592186447429} {:answer/id #uuid "b479acb7-3883-5980-ac98-478fb6d9ca99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$c$ and $d$" :db/id #edb/ref 17592186447432}] :answer-field/correct {:answer/id #uuid "220f8e8c-e14a-56af-ac51-6016a703f2a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a$ and $b$" :db/id #edb/ref 17592186447386} :answer-field/id #uuid "378d53b3-80f3-5877-9654-99d7a7094965" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident 