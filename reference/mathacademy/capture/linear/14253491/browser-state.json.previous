o><mi>x</mi><mo stretchy=\"false\">)</mo><mo>⋅</mo><msup><mi>v</mi><mo data-mjx-alternate=\"1\">′</mo></msup><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo></mrow><mrow><mo stretchy=\"false\">[</mo><mi>v</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo><msup><mo stretchy=\"false\">]</mo><mn>2</mn></msup></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mrow><mn>2</mn><mi>x</mi><msqrt><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi></msqrt></mrow></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo stretchy=\"false\">(</mo><mn>2</mn><mi>x</mi><mo stretchy=\"false\">)</mo><mo>−</mo><mo stretchy=\"false\">(</mo><msqrt><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi></msqrt><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>2</mn><mo stretchy=\"false\">)</mo></mrow><mrow><mo stretchy=\"false\">(</mo><mn>2</mn><mi>x</mi><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><msqrt><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi></msqrt></mfrac></mstyle><mo>−</mo><mn>2</mn><msqrt><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi></msqrt></mrow><mrow><mn>4</mn><msup><mi>x</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>1</mn><mo>−</mo><mn>2</mn><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi></mrow><mrow><mn>4</mn><msup><mi>x</mi><mn>2</mn></msup><msqrt><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi></msqrt></mrow></mfrac></mstyle><mo>.</mo></mtd><