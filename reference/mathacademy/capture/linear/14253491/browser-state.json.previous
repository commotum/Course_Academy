><mn>4</mn></msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>10</mn><mo stretchy=\"false\">(</mo><mn>5</mn><mi>x</mi><mo>+</mo><mn>3</mn><mo stretchy=\"false\">)</mo><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mn>8</mn><msup><mi>x</mi><mn>3</mn></msup><mo stretchy=\"false\">(</mo><mn>5</mn><mi>x</mi><mo>+</mo><mn>3</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>+</mo><mn>20</mn><msup><mi>x</mi><mn>4</mn></msup><mo stretchy=\"false\">(</mo><mn>5</mn><mi>x</mi><mo>+</mo><mn>3</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mo stretchy=\"false\">[</mo><mn>8</mn><mo stretchy=\"false\">(</mo><mn>5</mn><mi>x</mi><mo>+</mo><mn>3</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mn>20</mn><mi>x</mi><mo stretchy=\"false\">]</mo><msup><mi>x</mi><mn>3</mn></msup><mo stretchy=\"false\">(</mo><mn>5</mn><mi>x</mi><mo>+</mo><mn>3</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mo stretchy=\"false\">[</mo><mn>60</mn><mi>x</mi><mo>+</mo><mn>24</mn><mo stretchy=\"false\">]</mo><msup><mi>x</mi><mn>3</mn></msup><mo stretchy=\"false\">(</mo><mn>5</mn><mi>x</mi><mo>+</mo><mn>3</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>12</mn><msup><mi>x</mi><mn>3</mn></msup></mpadded></mstyle><mo stretchy=\"false\">(</mo><mn>5</mn><mi>x</mi><mo>+</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>5</mn><mi>x</mi><mo>+</mo><mn>3</mn><mo stretchy=\"false\">)</mo><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
