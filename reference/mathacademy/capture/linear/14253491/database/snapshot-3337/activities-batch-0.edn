#{[{:activity/expected-seconds 1140.0 :activity/first-step {:db/id #edb/ref 17592186097788} :activity/id #uuid "fbb9f33b-b9f0-53e7-8874-22b435b827fa" :activity/scope {:db/id #edb/ref 17592186048191 :topic/id #uuid "86f36ac3-ad23-5621-9648-009d53c6f968" :topic/math-academy-id 1115} :activity/steps [{:db/id #edb/ref 17592186097627 :step/content {:db/id #edb/ref 17592186096742 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096541 :question/id #uuid "b00f1213-cdaf-512c-9842-92cbee1ec63a" :question/math-academy-id "e-6100"} :knowledge-point/id #uuid "f3ee0d5d-0821-5f6b-b613-6b814e65df50" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049332} {:db/id #edb/ref 17592186050271} {:db/id #edb/ref 17592186050789} {:db/id #edb/ref 17592186051084}] :knowledge-point/question-generator {:db/id #edb/ref 17592186489452} :knowledge-point/questions [{:db/id #edb/ref 17592186097248} {:db/id #edb/ref 17592186097249} {:db/id #edb/ref 17592186233557} {:db/id #edb/ref 17592186233782} {:db/id #edb/ref 17592186290520} {:db/id #edb/ref 17592186297166} {:db/id #edb/ref 17592186297370} {:db/id #edb/ref 17592186297371} {:db/id #edb/ref 17592186317339} {:db/id #edb/ref 17592186489390} {:db/id #edb/ref 17592186489392} {:db/id #edb/ref 17592186489410} {:db/id #edb/ref 17592186489415} {:db/id #edb/ref 17592186489427} {:db/id #edb/ref 17592186489430} {:db/id #edb/ref 17592186489432} {:db/id #edb/ref 17592186489445} {:db/id #edb/ref 17592186489448}] :knowledge-point/title "Calculating a Derivative Using Multiple Instances of the Chain Rule"} :step/id #uuid "dbc9090b-580f-5b0f-9dea-3612b895b159" :step/math-academy-id 22585 :step/next {:db/id #edb/ref 17592186097790}} {:db/id #edb/ref 17592186097788 :step/content {:db/id #edb/ref 17592186097874 :tutorial/content "Sometimes, we need to combine multiple rules of differentiation to differentiate a given function. As a reminder, the product rule, quotient rule, and chain rule are stated below.\n\n- Product rule: $\\hspace{.5cm} \\dfrac{\\mathrm{d} }{\\mathrm{d}x } \\left[ u(x) \\cdot v(x) \\right] = u'(x) \\cdot v(x) + u(x) \\cdot v'(x)$\n\n- Quotient rule: $\\hspace{.5cm} \\dfrac{\\mathrm{d} }{\\mathrm{d}x } \\left[ \\dfrac{u(x)}{v(x)} \\right] = \\dfrac{u'(x)\\cdot v(x) - u(x)\\cdot v'(x)}{[v(x)]^2}$\n\n- Chain rule: $\\hspace{.5cm} \\dfrac{\\mathrm{d} }{\\mathrm{d}x } \\left[ u(v(x)) \\right] = u'(v(x))\\cdot v'(x)$" :tutorial/id #uuid "a5d21aee-bc36-5838-871b-9e5a1f7876c3" :tutorial/math-academy-id 420 :tutorial/title "Introduction"} :step/id #uuid "41748f21-34aa-540a-ab8c-f93a244b470d" :step/math-academy-id 783 :step/next {:db/id #edb/ref 17592186097627}} {:db/id #edb/ref 17592186097789 :step/content {:db/id #edb/ref 17592186096844 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096403 :question/id #uuid "74ffb6be-e709-5635-b6e2-98911c40a19e" :question/math-academy-id "e-184"} :knowledge-point/id #uuid "261910cd-a1a4-5c90-8caa-238208558458" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048842}] :knowledge-point/question-generator {:db/id #edb/ref 17592186487469} :knowledge-point/questions [{:db/id #edb/ref 17592186097026} {:db/id #edb/ref 17592186097201} {:db/id #edb/ref 17592186233662} {:db/id #edb/ref 17592186233785} {:db/id #edb/ref 17592186235373} {:db/id #edb/ref 17592186235383} {:db/id #edb/ref 17592186253603} {:db/id #edb/ref 17592186290522} {:db/id #edb/ref 17592186297366} {:db/id #edb/ref 17592186297367} {:db/id #edb/ref 17592186317412} {:db/id #edb/ref 17592186317415} {:db/id #edb/ref 17592186317469} {:db/id #edb/ref 17592186487457} {:db/id #edb/ref 17592186487459} {:db/id #edb/ref 17592186487460} {:db/id #edb/ref 17592186487465}] :knowledge-point/title "Calculating a Derivative Using the Chain and Quotient Rules"} :step/id #uuid "4220cd03-0cdb-5b7b-88e8-50513acf83fa" :step/math-academy-id 787} {:db/id #edb/ref 17592186097790 :step/content {:db/id #edb/ref 17592186096845 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096404 :question/id #