#{[{:db/id #edb/ref 17592186115019 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115190 :knowledge-point/id #uuid "bbb56f0a-ead0-5794-9e33-7fe0e1f87dc6" :knowledge-point/title "Differentiating Expressions Involving the Cosecant Function"}] :question/id #uuid "118a33c0-5831-586e-a0a5-e8bd3e1e4c9a" :question/math-academy-id "e-3644" :question/problem "Find $f'(x)$ if $f(x) = 2 \\csc x.$" :question/worked-solution "Here, we just take the constant out of the derivative and use the result for the derivative of $\\csc x,$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2csc⁡x) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}(csc⁡x) \\\\  & =2(-csc⁡xcot⁡x) \\\\  & =-2csc⁡xcot⁡x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115020 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115191 :knowledge-point/id #uuid "9699341b-c4e2-547f-8d98-bcda30567272" :knowledge-point/title "Differentiating Expressions Involving the Cotangent Function"}] :question/id #uuid "23b1cfcf-9f46-5274-b07b-66770a827409" :question/math-academy-id "e-3646" :question/problem "Find $\\dfrac {\\textrm d y} {\\textrm d x}$ if $y = 2x - 3\\cot x.$" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2x-3cot⁡x) \\\\  & =2-3(-{csc}^{2}⁡x) \\\\  & =2+3{csc}^{2}⁡x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115021 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115192 :knowledge-point/id #uuid "9e4b3974-1288-524e-a34c-8091c0e072f1" :knowledge-point/title "Differentiating Expressions Involving the Secant Function"}] :question/id #uuid "9b2548d6-87fc-56b1-aa7d-cef328eb4e24" :question/math-academy-id "e-3647" :question/problem "Calculate $f'(x)$ if $f(x) = x\\sec x.$" :question/worked-solution "We use the product rule, as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(xsec⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(x)\\cdot sec⁡x+x\\cdot \\frac{\\text{d}}{\\text{d}x}(sec⁡x) \\\\  & =(1)\\cdot sec⁡x+x\\cdot (sec⁡xtan⁡x) \\\\  & =sec⁡x(1+xtan⁡x)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115022 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115193 :knowledge-point/id #uuid "7995b377-1de4-5126-aa29-8cc30b4918f8" :knowledge-point/title "Finding the Slope of the Tangent at a Point of a Function Involving Reciprocal Trigonometric Functions"}] :question/id #uuid "83b8a6dd-c8c4-5537-ac88-289265752755" :question/math-academy-id "e-3648" :question/problem "Find the slope of $y=f(x)$ at $x=\\dfrac{\\pi}{4}$ if $f(x) = \\dfrac{-2\\cot x}{\\sin x}.$" :question/worked-solution "First, we calculate the derivative using the quotient rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{-2cot⁡x}{sin⁡x}) \\\\  & =\\frac{\\frac{\\text{d}}{\\text{d}x}(-2cot⁡x)\\cdot sin⁡x-(-2cot⁡x)\\cdot \\frac{\\text{d}}{\\text{d}x}(sin⁡x)}{{[sin⁡x]}^{2}} \\\\  & =\\frac{-2(-{csc}^{2}⁡x)\\cdot sin⁡x+2cot⁡x\\cdot (cos⁡x)}{{sin}^{2}⁡x} \\\\  & =\\frac{2csc⁡x+2cot⁡xcos⁡x}{{sin}^{2}⁡x}\\end{aligned}\n$$\n\nThen, we substitute $x=\\dfrac{\\pi}{4}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{′}(\\frac{\\pi }{4}) & =\\frac{2csc⁡(\\frac{\\pi }{4})+2cot⁡(\\frac{\\pi }{4})cos⁡(\\frac{\\pi }{4})}{{sin}^{2}⁡(\\frac{\\pi }{4})} \\\\  & =\\frac{2\\cdot (\\sqrt{2})+2\\cdot (1)\\cdot (\\frac{\\sqrt{2}}{2})}{{(\\frac{\\sqrt{2}}{2})}^{2}} \\\\  & =\\frac{3\\sqrt{2}}{(\\frac{1}{2})} \\\\  & =6\\sqrt{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573927 :knowledge-point/_questions [{:db/id #edb/ref 17592186115190 :knowledge-point/id #uuid "bbb56f0a-ead0-5794-9e33-7fe0e1f87dc6" :knowledge-point/title "Differentiating Expressions Involving the Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74c07577-fe74-57ba-92fc-1b9280d85d7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{csc}⁡x\\operatorname{cot}⁡x-2\\operatorname{csc}⁡x}{{e}^{x}}" :db/id #edb/ref 17592186573572} {:answer/id #uuid "7d45dcf9-cbe1-5b7a-9d59-7c86fbbe2bf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{csc}⁡x\\operatorname{cot}⁡x+2\\operatorname{csc}⁡x}{{e}^{2x}}" :db/id #edb/ref 17592186573587} {:answer/id #uuid "9f6d0573-3d9b-5c60-8903-5e05b999e172" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{csc}⁡x\\operatorname{cot}⁡x-2\\operatorname{csc}⁡x-5}{{e}^{2x}}" :db/id #edb/ref 17592186573632} {:answer/id #uuid "b2eaad33-5562-59b1-ad3b-d8ad6f3fdf8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{csc}⁡x\\operatorname{cot}⁡x+2\\operatorname{csc}⁡x-5}{{e}^{x}}" :db/id #edb/ref 17592186573657} {:answer/id #uuid "f0c61ed6-c60f-5bd5-a4e4-5d7a2115c00f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{csc}⁡x\\operatorname{cot}⁡x+2\\operatorname{csc}⁡x-5}{{e}^{x}}" :db/id #edb/ref 17592186573745}] :answer-field/correct {:answer/id #uuid "f0c61ed6-c60f-5bd5-a4e4-5d7a2115c00f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{csc}⁡x\\operatorname{cot}⁡x+2\\operatorname{csc}⁡x-5}{{e}^{x}}" :db/id #edb/ref 17592186573745} :answer-field/id #uuid "dfaf8be5-c89e-56c8-8f96-19125ea0ec9f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573852}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cdd054fb-7789-52a0-9a24-44d711412a5f" :question/math-academy-id "q-104314" :question/problem "Find ${f}^{′}(x)$ if $f(x)=\\frac{5-2\\operatorname{csc}⁡x}{{e}^{x}}.$" :question/worked-solution "We calculate the derivative using the quotient rule, as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{5-2\\operatorname{csc}⁡x}{{e}^{x}}) \\\\  & =\\frac{(2\\operatorname{csc}⁡x\\operatorname{cot}⁡x){e}^{x}-(5-2\\operatorname{csc}⁡x){e}^{x}}{({e}^{x})^{2}} \\\\  & =\\frac{{e}^{x}(2\\operatorname{csc}⁡x\\operatorname{cot}⁡x-5+2\\operatorname{csc}⁡x)}{{e}^{2x}} \\\\  & =\\frac{2\\operatorname{csc}⁡x\\operatorname{cot}⁡x+2\\operatorname{csc}⁡x-5}{{e}^{x}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115528 :knowledge-point/_questions [{:db/id #edb/ref 17592186115193 :knowledge-point/id #uuid "7995b377-1de4-5126-aa29-8cc30b4918f8" :knowledge-point/title "Finding the Slope of the Tangent at a Point of a Function Involving Reciprocal Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2092ed7b-78ba-5b08-8ed9-5a3ae1c22f13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡(\\sqrt{3})-\\operatorname{csc}⁡(\\sqrt{3})\\operatorname{cot}⁡(\\sqrt{3})-\\frac{1}{3}" :db/id #edb/ref 17592186285080} {:answer/id #uuid "61025999-7cbd-5360-838b-eda24fb2a51c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11\\operatorname{sin}⁡(\\sqrt{3})-\\operatorname{sec}⁡(\\sqrt{3})\\operatorname{tan}⁡(\\sqrt{3})-\\frac{1}{3}" :db/id #edb/ref 17592186285678} {:answer/id #uuid "a9b589e9-9125-5e9a-b153-823caacb3c8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11\\operatorname{sin}⁡(\\sqrt{3})+\\operatorname{sec}⁡(\\sqrt{3})\\operatorname{tan}⁡(\\sqrt{3})+\\frac{1}{3}" :db/id #edb/ref 17592186286334} {:answer/id #uuid "b5151810-8b1c-5b10-a7e3-87a15f4d9958" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11\\operatorname{sin}⁡(\\sqrt{3})-\\operatorname{sec}⁡(\\sqrt{3})\\operatorname{tan}⁡(\\sqrt{3})-\\frac{1}{3}" :db/id #edb/ref 17592186286435} {:answer/id #uuid "daba25ff-6035-5619-8ac0-07d5eb9bd01a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11\\operatorname{sin}⁡(\\sqrt{3})-\\operatorname{csc}⁡(\\sqrt{3})\\operatorname{cot}⁡(\\sqrt{3})-1" :db/id #edb/ref 17592186286782}] :answer-field/correct {:answer/id #uuid "61025999-7cbd-5360-838b-eda24fb2a51c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11\\operatorname{sin}⁡(\\sqrt{3})-\\operatorname{sec}⁡(\\sqrt{3})\\operatorname{tan}⁡(\\sqrt{3})-\\frac{1}{3}" :db/id #edb/ref 17592186285678} :answer-field/id #uuid "ab8dc92d-302f-5800-8e99-962388310e9e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287498}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c56fab41-d998-532e-9118-40493f1a0626" :question/math-academy-id "q-1886" :question/problem "Find the slope of $y=f(x)$ at $x=\\sqrt{3}$ if $f(x)=11\\operatorname{cos}⁡x-\\operatorname{sec}⁡x+\\frac{1}{x}.$" :question/worked-solution "First, we calculate the derivative using the sum rule:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(11\\operatorname{cos}⁡x-\\operatorname{sec}⁡x+\\frac{1}{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(11\\operatorname{cos}⁡x-\\operatorname{sec}⁡x+{x}^{-1}) \\\\  & =11(-\\operatorname{sin}⁡x)-\\operatorname{sec}⁡x\\operatorname{tan}⁡x-\\frac{1}{{x}^{2}} \\\\  & =-11\\operatorname{sin}⁡x-\\operatorname{sec}⁡x\\operatorname{tan}⁡x-\\frac{1}{{x}^{2}}\\end{aligned}\\end{aligned}\n$$\n\nThen, we substitute $x=\\sqrt{3}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{′}(\\sqrt{3}) & =-11\\operatorname{sin}⁡(\\sqrt{3})-\\operatorname{sec}⁡(\\sqrt{3})\\operatorname{tan}⁡(\\sqrt{3})-\\frac{1}{(\\sqrt{3})^{2}} \\\\  & =-11\\operatorname{sin}⁡(\\sqrt{3})-\\operatorname{sec}⁡(\\sqrt{3})\\operatorname{tan}⁡(\\sqrt{3})-\\frac{1}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573884 :knowledge-point/_questions [{:db/id #edb/ref 17592186115191 :knowledge-point/id #uuid "9699341b-c4e2-547f-8d98-bcda30567272" :knowledge-point/title "Differentiating Expressions Involving the Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31ca1017-57c8-5ef7-81bf-c0e0cc05312b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{csc}^{2}⁡x}{3}" :db/id #edb/ref 17592186573488} {:answer/id #uuid "3e2b4496-dac0-5fac-821c-8e4a87a5a680" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{csc}⁡x}{3}" :db/id #edb/ref 17592186573499} {:answer/id #uuid "58eab979-5e52-573b-b85f-2b987d06d42c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{csc}^{2}⁡x}{6}" :db/id #edb/ref 17592186573537} {:answer/id #uuid "91d3d8a7-03f3-5511-8583-848757ecc77d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{csc}^{2}⁡x" :db/id #edb/ref 17592186573614} {:answer/id #uuid "bc921c14-4169-5d8d-9dc9-1252148fcc6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{csc}^{2}⁡x}{3}" :db/id #edb/ref 17592186573668}] :answer-field/correct {:answer/id #uuid "31ca1017-57c8-5ef7-81bf-c0e0cc05312b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{csc}^{2}⁡x}{3}" :db/id #edb/ref 17592186573488} :answer-field/id #uuid "17c99eca-6d45-5641-8c24-6f647f6d895f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573780}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4cc89078-03c5-53b0-908e-62267303049d" :question/math-academy-id "q-31285" :question/problem "Find ${f}^{′}(x)$ if $f(x)=\\frac{\\operatorname{cot}⁡x}{3}.$" :question/worked-solution "Here, we just take the constant out of the derivative and use the result for the derivative of $\\operatorname{cot}⁡x,$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{cot}⁡x}{3}) \\\\  & =\\frac{1}{3}(-{csc}^{2}⁡x) \\\\  & =-\\frac{{csc}^{2}⁡x}{3}\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233781 :knowledge-point/_questions [{:db/id #edb/ref 17592186115191 :knowledge-point/id #uuid "9699341b-c4e2-547f-8d98-bcda30567272" :knowledge-point/title "Differentiating Expressions Involving the Cotangent Function"}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "73219a58-c08c-520e-96a1-4134d001c0d8" :question/math-academy-id "q-31288" :question/problem "Find ${f}^{'}(\\frac{\\pi }{6})$ if $f(x)=-6\\operatorname{cot}x.$" :question/worked-solution "First, we just take the constant out of the derivative and use the result for the derivative of $\\operatorname{cot}x,$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}(-6\\operatorname{cot}x) \\\\  & =-6(-{csc}^{2}x) \\\\  & =6{csc}^{2}x\\end{aligned}\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{6}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{'}(\\frac{\\pi }{6}) & =6{csc}^{2}(\\frac{\\pi }{6}) \\\\  & =6{(2)}^{2} \\\\  & =24.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573943 :knowledge-point/_questions [{:db/id #edb/ref 17592186115190 :knowledge-point/id #uuid "bbb56f0a-ead0-5794-9e33-7fe0e1f87dc6" :knowledge-point/title "Differentiating Expressions Involving the Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5d66f86-6837-5e17-93df-68c4cfd0e36c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\csc(x)\\cot(x)+\\cos(x)" :db/id #edb/ref 17592186573661}] :answer-field/correct {:answer/id #uuid "b5d66f86-6837-5e17-93df-68c4cfd0e36c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\csc(x)\\cot(x)+\\cos(x)" :db/id #edb/ref 17592186573661} :answer-field/id #uuid "f3eb12ff-492a-50b6-a4dc-f5b8576f3948" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573857}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f25a3394-05aa-5c37-ad51-535ad5e51912" :question/math-academy-id "q-313721" :question/problem "Find ${g}^{′}(x)$ if $g(x)=3\\operatorname{csc}⁡(x)+\\operatorname{sin}⁡(x).$\n\n${g}^{′}(x)=$\n{{field-1}}" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{csc}⁡(x)+\\operatorname{sin}⁡(x)) \\\\  & =3(-\\operatorname{csc}⁡(x)\\operatorname{cot}⁡(x))+\\operatorname{cos}⁡(x) \\\\  & =-3\\operatorname{csc}⁡(x)\\operatorname{cot}⁡(x)+\\operatorname{cos}⁡(x)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573900 :knowledge-point/_questions [{:db/id #edb/ref 17592186115193 :knowledge-point/id #uuid "7995b377-1de4-5126-aa29-8cc30b4918f8" :knowledge-point/title "Finding the Slope of the Tangent at a Point of a Function Involving Reciprocal Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f17b38c0-319c-5a6b-a4a9-b68ba9b75662" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4e^{\\pi/2}" :db/id #edb/ref 17592186573747}] :answer-field/correct {:answer/id #uuid "f17b38c0-319c-5a6b-a4a9-b68ba9b75662" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4e^{\\pi/2}" :db/id #edb/ref 17592186573747} :answer-field/id #uuid "f569b9ca-3244-52df-8874-0fe9df4d2496" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573861}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7ecca825-7d5a-5032-8595-2b767ed0d377" :question/math-academy-id "q-314291" :question/problem "Find the slope $m$ of $y=g(x)$ at $x=\\frac{\\pi }{2}$ if $g(x)=-4{e}^{x}\\operatorname{csc}⁡x+6.$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, we calculate the derivative using the product rule and sum rule:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}\\,(-4{e}^{x}\\operatorname{csc}⁡x+6) \\\\  & =\\frac{d}{dx}(-4{e}^{x})\\cdot \\operatorname{csc}⁡x+(-4{e}^{x})\\cdot \\frac{d}{dx}(\\operatorname{csc}⁡x)+\\frac{d}{dx}(6) \\\\  & =-4{e}^{x}\\operatorname{csc}⁡x+(-4{e}^{x})(-\\operatorname{csc}⁡x\\operatorname{cot}⁡x)+0 \\\\  & =-4{e}^{x}\\operatorname{csc}⁡x+4{e}^{x}\\operatorname{csc}⁡x\\operatorname{cot}⁡x \\\\  & =-4{e}^{x}\\operatorname{csc}⁡x(1-\\operatorname{cot}⁡x)\\end{aligned}\n$$\n\nNow, we substitute $x=\\frac{\\pi }{2}$ and evaluate the slope $m:$\n\n$$\n\\begin{aligned}m={g}^{′}(\\frac{\\pi }{2}) & =-4{e}^{\\pi /2}\\operatorname{csc}⁡(\\frac{\\pi }{2})(1-\\operatorname{cot}⁡(\\frac{\\pi }{2})) \\\\  & =-4{e}^{\\pi /2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573894 :knowledge-point/_questions [{:db/id #edb/ref 17592186115192 :knowledge-point/id #uuid "9e4b3974-1288-524e-a34c-8091c0e072f1" :knowledge-point/title "Differentiating Expressions Involving the Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af52c335-7bb0-5690-a57b-ee7f475b624b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{x}+\\ln(x)\\tan(x)" :db/id #edb/ref 17592186573651}] :answer-field/correct {:answer/id #uuid "af52c335-7bb0-5690-a57b-ee7f475b624b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{x}+\\ln(x)\\tan(x)" :db/id #edb/ref 17592186573651} :answer-field/id #uuid "015c6080-8860-5f60-95a7-38c4dfe56ba0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573770}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "70b7e2f2-9311-56ba-8d2d-9b32371b2429" :question/math-academy-id "q-340610" :question/problem "Find the derivative of $y=\\operatorname{ln}⁡(x)\\operatorname{sec}⁡(x).$\n\n$\\frac{\\text{d}y}{\\text{d}x}=\\operatorname{sec}⁡x\\cdot ($\n{{field-1}}\n$)$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,(\\operatorname{ln}⁡(x)\\operatorname{sec}⁡(x)) \\\\  & =\\frac{1}{x}\\cdot \\operatorname{sec}⁡x+\\operatorname{ln}⁡(x)\\cdot \\operatorname{sec}⁡(x)\\operatorname{tan}⁡(x) \\\\  & =\\operatorname{sec}⁡(x)\\cdot (\\frac{1}{x}+\\operatorname{ln}⁡(x)\\operatorname{tan}⁡(x))\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186314983 :knowledge-point/_questions [{:db/id #edb/ref 17592186115192 :knowledge-point/id #uuid "9e4b3974-1288-524e-a34c-8091c0e072f1" :knowledge-point/title "Differentiating Expressions Involving the Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42958185-7df3-56a0-9626-eed54c7f99ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186312504}] :answer-field/correct {:answer/id #uuid "42958185-7df3-56a0-9626-eed54c7f99ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186312504} :answer-field/id #uuid "65f1890c-928c-56f6-8eb3-b4f4e9dc83d7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314295}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e573d90a-bd1d-5d85-a1c8-ca191df5266e" :question/math-academy-id "q-340620" :question/problem "Find the derivative of $y=4sec⁡x+{e}^{x}$ at $x=0.$\n\n$\\frac{\\text{d}y}{\\text{d}x}{|}_{0}=$\n{{field-1}}" :question/worked-solution "First, we take the derivative of each term and then add them:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,(4sec⁡x+{e}^{x}) \\\\  & =4sec⁡xtan⁡x+{e}^{x}\\end{aligned}\n$$\n\nThen, we substitute $x=0$:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{x=0} & =(4sec⁡xtan⁡x+{e}^{x})\\,{|}_{x=0} \\\\  & =4sec⁡(0)tan⁡(0)+{e}^{0} \\\\  & =4\\cdot 1\\cdot 0+1 \\\\  & =1\\end{aligned}\n$$"}]}
