31 "Differentiating Reciprocal Trigonometric Functions" #edb/ref 17592186045417] [17592186050985 #edb/ref 1033 1686 #edb/ref 17592186045417] [17592186050985 #edb/ref 1034 1.789143713939677 #edb/ref 17592186045436] [17592186050985 #edb/ref 1035 #uuid "770e795e-38d4-5b4f-8bd2-bd698bb6794a" #edb/ref 17592186045417] [17592186115019 #edb/ref 1069 "e-3644" #edb/ref 17592186045417] [17592186115019 #edb/ref 1071 "Find $f'(x)$ if $f(x) = 2 \\csc x.$" #edb/ref 17592186045417] [17592186115019 #edb/ref 1072 #uuid "118a33c0-5831-586e-a0a5-e8bd3e1e4c9a" #edb/ref 17592186045417] [17592186115019 #edb/ref 1074 "Here, we just take the constant out of the derivative and use the result for the derivative of $\\csc x,$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2csc⁡x) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}(csc⁡x) \\\\  & =2(-csc⁡xcot⁡x) \\\\  & =-2csc⁡xcot⁡x\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186115020 #edb/ref 1069 "e-3646" #edb/ref 17592186045417] [17592186115020 #edb/ref 1071 "Find $\\dfrac {\\textrm d y} {\\textrm d x}$ if $y = 2x - 3\\cot x.$" #edb/ref 17592186045417] [17592186115020 #edb/ref 1072 #uuid "23b1cfcf-9f46-5274-b07b-66770a827409" #edb/ref 17592186045417] [17592186115020 #edb/ref 1074 "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2x-3cot⁡x) \\\\  & =2-3(-{csc}^{2}⁡x) \\\\  & =2+3{csc}^{2}⁡x\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186115021 #edb/ref 1069 "e-3647" #edb/ref 17592186045417] [17592186115021 #edb/ref 1071 "Calculate $f'(x)$ if $f(x) = x\\sec x.$" #edb/ref 17592186045417] [17592186115021 #edb/ref 1072 #uuid "9b2548d6-87fc-56b1-aa7d-cef328eb4e24" #edb/ref 17592186045417] [17592186115021 #edb/ref 1074 "We use the product rule, as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(xsec⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(x)\\cdot sec⁡x+x\\cdot \\frac{\\text{d}}{\\text{d}x}(sec⁡x) \\\\  & =(1)\\cdot sec⁡x+x\\cdot (sec⁡xtan⁡x) \\\\  & =sec⁡x(1+xtan⁡x)\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186115022 #edb/ref 1069 "e-3648" #edb/ref 17592186045417] [17592186115022 #edb/ref 1071 "Find the slope of $y=f(x)$ at $x=\\dfrac{\\pi}{4}$ if $f(x) = \\dfrac{-2\\cot x}{\\sin x}.$" #edb/ref 17592186045417] [17592186115022 #edb/ref 1072 #uuid "83b8a6dd-c8c4-5537-ac88-289265752755" #edb/ref 17592186045417] [17592186115022 #edb/ref 1074 "First, we calculate the derivative using the quotient rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{-2cot⁡x}{sin⁡x}) \\\\  & =\\frac{\\frac{\\text{d}}{\\text{d}x}(-2cot⁡x)\\cdot sin⁡x-(-2cot⁡x)\\cdot \\frac{\\text{d}}{\\text{d}x}(sin⁡x)}{{[sin⁡x]}^{2}} \\\\  & =\\frac{-2(-{csc}^{2}⁡x)\\cdot sin⁡x+2cot⁡x\\cdot (cos⁡x)}{{sin}^{2}⁡x} \\\\  & =\\frac{2csc⁡x+2cot⁡xcos⁡x}{{sin}^{2}⁡x}\\end{aligned}\n$$\n\nThen, we substitute $x=\\dfrac{\\pi}{4}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{′}(\\frac{\\pi }{4}) & =\\frac{2csc⁡(\\frac{\\pi }{4})+2cot⁡(\\frac{\\pi }{4})cos⁡(\\frac{\\pi }{4})}{{sin}^{2}⁡(\\frac{\\pi }{4})} \\\\  & =\\frac{2\\cdot (\\sqrt{2})+2\\cdot (1)\\cdot (\\frac{\\sqrt{2}}{2})}{{(\\frac{\\sqrt{2}}{2})}^{2}} \\\\  & =\\frac{3\\sqrt{2}}{(\\frac{1}{2})} \\\\  & =6\\sqrt{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186115190 #edb/ref 1037 #edb/ref 17592186048813 #edb/ref 17592186045417] [17592186115190 #edb/ref 1037 #edb/ref 17592186048842 #edb/ref 17592186045417] [17592186115190 #edb/ref 1037 #edb/ref 17592186050928 #edb/ref 17592186045417] [17592186115190 #edb/ref 1038 #edb/ref 17592186115529 #edb/ref 17592186045417] [17592186115190 #edb/ref 1038 #edb/ref 17592186115727 #edb/ref 17592186045417] [17592186115190 #edb/ref 1038 #edb/ref 17592186233086 #edb/ref 17592186045417] [17592186115190 #edb/ref 1038 #edb/ref 17592186233789 #edb/ref 17592186045417] [17592186115190 #edb/ref 1038 #edb/ref 17592186241029 #edb/ref 17592186045417] [17592186115190 #edb/ref 1038 #edb/ref 17592186241030 #edb/ref 17592186045417] [17592186115190 #edb/ref 1038 #edb/ref 17592186297375 #edb/ref 17592186045417] [17592186115190 #edb/ref 1038 #edb/ref 17592186314973 #edb/ref 17592186045417] [17592186115190 #edb/ref 1038 #edb/ref 17592186573927 #edb/ref 17592186045417] [17592186115190 #edb/ref 1038 #edb/ref 17592186573943 #edb/ref 17592186045417] [17592186115190 #edb/ref 1039 "Differentiating Expressions Involving the Cosecant Function" #edb/ref 17592186045417] [17592186115190 #edb/ref 1041 #edb/ref 17592186115019 #edb/ref 17592186045417] [17592186115190 #edb/ref 1042 #uuid "bbb56f0a-ead0-5794-9e33-7fe0e1f87dc6" #edb/ref 17592186045417] [17592186115191 #edb/ref 1038 #edb/ref 17592186115521 #edb/ref 17592186045417] [17592186115191 #edb/ref 1038 #edb/ref 17592186115725 #edb/ref 17592186045417] [17592186115191 #edb/ref 1038 #edb/ref 17592186233781 #edb/ref 17592186045417] [17592186115191 #edb/ref 1038 #edb/ref 17592186233787 #edb/ref 17592186045417] [17592186115191 #edb/ref 1038 #edb/ref 17592186241032 #edb/ref 17592186045417] [17592186115191 #edb/ref 1038 #edb/ref 17592186314976 #edb/ref 17592186045417] [17592186115191 #edb/ref 1038 #edb/ref 17592186314977 #edb/ref 17592186045417] [17592186115191 #edb/ref 1038 #edb/ref 17592186314978 #edb/ref 17592186045417] [17592186115191 #edb/ref 1038 #edb/ref 17592186314979 #edb/ref 17592186045417] [17592186115191 #edb/ref 1038 #edb/ref 17592186314980 #edb/ref 17592186045417] [17592186115191 #edb/ref 1038 #edb/ref 17592186401805 #edb/ref 17592186045417] [17592186115191 #edb/ref 1038 #edb/ref 17592186484393 #edb/ref 17592186045443] [17592186115191 #edb/ref 1038 #edb/ref 17592186484398 #edb/ref 17592186045443] [17592186115191 #edb/ref 1038 #edb/ref 17592186484400 #edb/ref 17592186045443] [17592186115191 #edb/ref 1038 #edb/ref 17592186484401 #edb/ref 17592186045443] [17592186115191 #edb/ref 1038 #edb/ref 17592186484405 #edb/ref 17592186045443] [17592186115191 #edb/ref 1038 #edb/ref 17592186573884 #ed