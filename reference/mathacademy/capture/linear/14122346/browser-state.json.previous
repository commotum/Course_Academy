>(</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mn>0</mn></mstyle></mrow><mo stretchy=\"false\">)</mo><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mstyle mathcolor=\"blue\"><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow></mstyle></mtd><mtd><mstyle mathcolor=\"violet\"><mn>1</mn></mstyle></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mstyle mathcolor=\"blue\"><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow></mstyle></mtd><mtd><mstyle mathcolor=\"violet\"><mn>1</mn></mstyle></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mstyle mathcolor=\"blue\"><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow></mstyle></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo>.</mo></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
