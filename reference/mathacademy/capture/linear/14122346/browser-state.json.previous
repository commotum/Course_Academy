e=\"false\" scriptlevel=\"0\"><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mo>⊕</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle></mstyle></mrow><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"red\"><msub><mi>J</mi><mn>1</mn></msub><mo stretchy=\"false\">(</mo><mn>3</mn><mo stretchy=\"false\">)</mo></mstyle></mrow><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"false\" scriptlevel=\"0\"><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mo>⊕</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle></mstyle></mrow><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"black\"><msub><mi>J</mi><mn>1</mn></msub><mo stretchy=\"false\">(</mo><mn>3</mn><mo stretchy=\"false\">)</mo></mstyle></mrow></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
