">[</mo><mtable columnalign=\"center center center\" columnspacing=\"1em\" rowspacing=\"4pt\" columnlines=\"solid none\" rowlines=\"solid none\"><mtr><mtd><mstyle mathcolor=\"blue\"><mo>−</mo><mn>2</mn></mstyle></mtd><mtd><mstyle mathcolor=\"lightgray\"><mn>0</mn></mstyle></mtd><mtd><mstyle mathcolor=\"lightgray\"><mn>0</mn></mstyle></mtd></mtr><mtr><mtd><mstyle mathcolor=\"lightgray\"><mn>0</mn></mstyle></mtd><mtd><mstyle mathcolor=\"red\"><mi>π</mi></mstyle></mtd><mtd><mstyle mathcolor=\"red\"><mn>1</mn></mstyle></mtd></mtr><mtr><mtd><mstyle mathcolor=\"lightgray\"><mn>0</mn></mstyle></mtd><mtd><mstyle mathcolor=\"red\"><mn>0</mn></mstyle></mtd><mtd><mstyle mathcolor=\"red\"><mi>π</mi></mstyle></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
