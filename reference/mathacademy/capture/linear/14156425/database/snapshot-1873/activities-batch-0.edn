#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186055890} :activity/id #uuid "c6035687-0b20-5278-942e-d7c865a8e2a4" :activity/scope {:db/id #edb/ref 17592186050127 :topic/id #uuid "2ed40600-0b7c-5540-8255-04fca5187c09" :topic/math-academy-id 64} :activity/steps [{:db/id #edb/ref 17592186055890 :step/content {:db/id #edb/ref 17592186056016 :tutorial/content "To **evaluate** the expression $3+x$ for $x={\\color{blue}2}$, we replace $x$ with $\\color{blue}2$ in the expression and simplify:\n\n$$\n\\begin{aligned}3+x & = \\\\ 3+(2) & = \\\\ 3+2 & = \\\\ 5 & \\end{aligned}\n$$" :tutorial/id #uuid "f4532e0a-1865-5de3-b251-2774b7d5d45d" :tutorial/math-academy-id 8079 :tutorial/title "Introduction"} :step/id #uuid "34a47b76-009d-562d-9fa3-84f6480e10ea" :step/math-academy-id 73028 :step/next {:db/id #edb/ref 17592186055891}} {:db/id #edb/ref 17592186055891 :step/content {:db/id #edb/ref 17592186054838 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054393 :question/id #uuid "dad98e52-6c94-5cb9-95f1-0db822fbb44a" :question/math-academy-id "e-12915"} :knowledge-point/id #uuid "9a02aff6-185a-56b7-8139-5efad8ddf403" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048888} {:db/id #edb/ref 17592186050618}] :knowledge-point/questions [{:db/id #edb/ref 17592186055412} {:db/id #edb/ref 17592186055478} {:db/id #edb/ref 17592186055479} {:db/id #edb/ref 17592186479062} {:db/id #edb/ref 17592186479123}] :knowledge-point/title "Evaluating Linear Expressions"} :step/id #uuid "7a44adb4-ec60-5635-a786-870b859b9277" :step/math-academy-id 73029 :step/next {:db/id #edb/ref 17592186055892}} {:db/id #edb/ref 17592186055892 :step/content {:db/id #edb/ref 17592186054839 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054424 :question/id #uuid "6acd4bf9-8cf9-5a35-a1f5-a9a01766af87" :question/math-academy-id "e-13069"} :knowledge-point/id #uuid "f915db41-a929-5ff0-b571-9ab3a1d510e5" :knowledge-point/questions [{:db/id #edb/ref 17592186055062} {:db/id #edb/ref 17592186055288} {:db/id #edb/ref 17592186055289} {:db/id #edb/ref 17592186479069} {:db/id #edb/ref 17592186479111}] :knowledge-point/title "Evaluating Linear Expressions Containing Fractions"} :step/id #uuid "c4f792f2-3137-5f3d-835f-27e81b7b0ddb" :step/math-academy-id 73033 :step/next {:db/id #edb/ref 17592186055893}} {:db/id #edb/ref 17592186055893 :step/content {:db/id #edb/ref 17592186056017 :tutorial/content "The usual order of operations (PEMDAS) applies when evaluating expressions. So when an algebraic expression contains parentheses $(\\ldots)$, we calculate what's inside the parentheses *first*. \n\nFor example, we evaluate $6 - (2x+3)$ at $x=3$, as follows:\n\n$$\n\\begin{aligned}6-(2x+3) & = \\\\ 6-(2\\cdot 3+3) & = \\\\ 6-(6+3) & = \\\\ 6-9 & = \\\\ -3.\\end{aligned}\n$$" :tutorial/id #uuid "34dded6d-159e-5c07-9693-340cd7e2080e" :tutorial/math-academy-id 8081 :tutorial/title "Evaluating Expressions Containing Parentheses"} :step/id #uuid "6c3059f6-37e7-57cf-a1da-3e8a8ac0f0b4" :step/math-academy-id 73037 :step/next {:db/id #edb/ref 17592186055894}} {:db/id #edb/ref 17592186055894 :step/content {:db/id #edb/ref 17592186054840 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054394 :question/id #uuid "51bb6ac7-5c24-5805-85ba-9c697f4360b6" :question/math-academy-id "e-12919"} :knowledge-point/id #uuid "e5dcee75-1c40-5885-81e2-960bee2dd3a8" :knowledge-point/questions [{:db/id #edb/ref 17592186055260} {:db/id #edb/ref 17592186055261} {:db/id #edb/ref 17592186055268} {:db/id #edb/ref 17592186479081} {:db/id #edb/ref 17592186479109}] :knowledge-point/title "Evaluating Expressions of a Single Variable with Parentheses"} :step/id #uuid "0feb005d-8dfd-50f1-975c-f0edcb47caeb" :step/math-academy-id 73038 :step/next {:db/id #edb/ref 17592186055895}} {:db/id #edb/ref 17592186055895 :step/content {:db/id #edb/ref 17592186056018 :tutorial/content "If an expression contains more than one variable, we evaluate it using the same procedure, replacing each variable with the appropriate value.\n\nFor example, to find the value of $2b + \\dfrac{1}{2}a$ when $a=-2$ and $b=3,$ we replace $a$ with $-2$ and $b$ with $3\\mathbin{:}$\n\n$$\n\\begin{aligned}2b+\\frac{1}{2}a & = \\\\ 2\\cdot 3+\\frac{1}{2}\\cdot (-2) & = \\\\ 6-1 & = \\\\ 5\\end{aligned}\n$$" :tutorial/id #uuid "5858aaa3-b757-5794-a965-368222b8122f" :tutorial/math-academy-id 8082 :tutorial/title "Evaluating Expressions Containing More Than One Variable"} :step/id #uuid "fd60f94d-fcfc-5630-bf91-5646b04bf125" :step/math-academy-id 73042 :step/next {:db/id #edb/ref 17592186055896}} {:db/id #edb/ref 17592186055896 :step/content {:db/id #edb/ref 17592186054841 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054395 :question/id #uuid "caf5354e-e240-5515-94c7-6c3caa2063af" :question/math-academy-id "e-12920"} :knowledge-point/id #uuid "6d42c63b-4549-5ed0-8da5-72561253acb9" :knowledge-point/questions [{:db/id #edb/ref 17592186055266} {:db/id #edb/ref 17592186055267} {:db/id #edb/ref 17592186479068} {:db/id #edb/ref 17592186479125}] :knowledge-point/title "Evaluating Expressions Containing Multiple Variables"} :step/id #uuid "561eb475-e13d-577e-88df-bf741708db2f" :step/math-academy-id 73043}] :activity/title "Evaluating Linear Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054916}]}
