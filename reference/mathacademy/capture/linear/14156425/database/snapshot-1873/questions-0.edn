#{[{:db/id #edb/ref 17592186054393 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054838 :knowledge-point/id #uuid "9a02aff6-185a-56b7-8139-5efad8ddf403" :knowledge-point/title "Evaluating Linear Expressions"}] :question/id #uuid "dad98e52-6c94-5cb9-95f1-0db822fbb44a" :question/math-academy-id "e-12915" :question/problem "Evaluate $11p-2$ for $p=4.$" :question/worked-solution "Replacing $p$ with $\\color{blue}4$ in the expression, we get\n\n$$\n\\eqalign{\n\t\t11p-2 &= \\\n\t\t11({\\color{blue}4})-2 &= \\\n\t \t44-2 &= \\\n\t \t42 .\n\t}\n$$"}] [{:db/id #edb/ref 17592186054394 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054840 :knowledge-point/id #uuid "e5dcee75-1c40-5885-81e2-960bee2dd3a8" :knowledge-point/title "Evaluating Expressions of a Single Variable with Parentheses"}] :question/id #uuid "51bb6ac7-5c24-5805-85ba-9c697f4360b6" :question/math-academy-id "e-12919" :question/problem "Evaluate $2(3 x-1) +2$ for $x=-3.$" :question/worked-solution "We replace $x$ with $-3$ in the expression and evaluate the parentheses first:\n\n$$\n\\begin{aligned}2(3x-1)+2 & = \\\\ 2(3\\cdot (-3)-1)+2 & = \\\\ 2(-9-1)+2 & = \\\\ 2(-10)+2 & = \\\\ -20+2 & = \\\\ -18\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054395 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054841 :knowledge-point/id #uuid "6d42c63b-4549-5ed0-8da5-72561253acb9" :knowledge-point/title "Evaluating Expressions Containing Multiple Variables"}] :question/id #uuid "caf5354e-e240-5515-94c7-6c3caa2063af" :question/math-academy-id "e-12920" :question/problem "Find the value of $x - \\dfrac{3}{2}y$ when $x=2$ and $y=-2.$" :question/worked-solution "Replacing $x$ with $2$ and $y$ with $-2$ in the expression, we get\n\n$$\n\\begin{aligned}x-\\frac{3}{2}y & = \\\\ 2-\\frac{3}{2}\\cdot (-2) & = \\\\ 2+(-\\frac{3}{2})\\cdot (-2) & = \\\\ 2+3 & = \\\\ 5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054424 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054839 :knowledge-point/id #uuid "f915db41-a929-5ff0-b571-9ab3a1d510e5" :knowledge-point/title "Evaluating Linear Expressions Containing Fractions"}] :question/id #uuid "6acd4bf9-8cf9-5a35-a1f5-a9a01766af87" :question/math-academy-id "e-13069" :question/problem "Evaluate $2-\\dfrac{u}{4}$ for $u=\\dfrac43.$" :question/worked-solution "Replacing $u$ with $\\dfrac43$ in the expression, we get\n\n$$\n\\begin{aligned}2-\\frac{u}{4} & = \\\\ 2-\\frac{1}{4}u & = \\\\ 2-\\frac{1}{4}\\cdot \\frac{4}{3} & = \\\\ 2-\\frac{4}{12} & = \\\\ 2-\\frac{1}{3} & = \\\\ \\frac{6-1}{3} & = \\\\ \\frac{5}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479123 :knowledge-point/_questions [{:db/id #edb/ref 17592186054838 :knowledge-point/id #uuid "9a02aff6-185a-56b7-8139-5efad8ddf403" :knowledge-point/title "Evaluating Linear Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "586d57ed-6322-50cd-9bf2-d3afc104c6b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186478682}] :answer-field/correct {:answer/id #uuid "586d57ed-6322-50cd-9bf2-d3afc104c6b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186478682} :answer-field/id #uuid "8a3e180a-4f98-588d-a55b-f82b3f9dfac9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479014}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c4c3b101-24b5-5159-855c-3722311747de" :question/math-academy-id "q-171410" :question/problem "If $b=8,$ then $3b-11=${{field-1}}." :question/worked-solution "Replacing $b$ with $8$ in the expression, we get\n\n$$\n\\begin{aligned}3b-11 & = \\\\ 3(8)-11 & = \\\\ 24-11 & = \\\\ 13 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479069 :knowledge-point/_questions [{:db/id #edb/ref 17592186054839 :knowledge-point/i