"field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186478988}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3ba0af4d-b531-5e58-b782-4b7a32460438" :question/math-academy-id "q-180261" :question/problem "If $x=2,$ then $12-4(3x-4)=${{field-1}}." :question/worked-solution "We replace $x$ with $2$ in the expression and evaluate the parentheses first:\n\n$$\n\\begin{aligned}12-4(3x-4) & = \\\\ 12-4(3\\cdot 2-4) & = \\\\ 12-4(6-4) & = \\\\ 12-4(2) & = \\\\ 12-8 & = \\\\ 4 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479109 :knowledge-point/_questions [{:db/id #edb/ref 17592186054840 :knowledge-point/id #uuid "e5dcee75-1c40-5885-81e2-960bee2dd3a8" :knowledge-point/title "Evaluating Expressions of a Single Variable with Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b90ecccc-4503-5760-b2d3-96866aca4524" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186478858}] :answer-field/correct {:answer/id #uuid "b90ecccc-4503-5760-b2d3-96866aca4524" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186478858} :answer-field/id #uuid "1639e847-f891-584d-90ce-1361c0620ec9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186478966}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9a5e0230-7894-51f3-afd6-6cc279d87228" :question/math-academy-id "q-180267" :question/problem "If $y=-2,$ then $3-4(3-2y)=${{field-1}}." :question/worked-solution "We replace $y$ with $-2$ in the expression and evaluate the parentheses first:\n\n$$\n\\begin{aligned}3-4(3-2y) & = \\\\ 3-4(3-2(-2)) & = \\\\ 3-4(3+4) & = \\\\ 3-4(7) & = \\\\ 3-28 & = \\\\ -25 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479125 :knowledge-point/_questions [{:db/id #edb/ref 17592186054841 :knowledge-point/id #uuid "6d42c63b-4549-5ed0-8da5-72561253acb9" :knowledge-point/title "Evaluating Expressions Containing Multiple Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a25c3b76-33b2-5ddb-bd40-9f882ef4f25b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186478825}] :answer-field/correct {:answer/id #uuid "a25c3b76-33b2-5ddb-bd40-9f882ef4f25b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186478825} :answer-field/id #uuid "8e20507b-53cf-5029-9ff9-03e4a68206bb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479016}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c819591b-7976-59a4-815e-5b13c1691fd5" :question/math-academy-id "q-180268" :question/problem "If $w=2$ and $z=-4,$ then $w+5z=${{field-1}}." :question/worked-solution "Replacing $w$ with $2$ and $z$ with $-4,$ we get\n\n$$\n\\begin{aligned}w+5z & = \\\\ 2+5(-4) & = \\\\ 2-20 & = \\\\ -18 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479068 :knowledge-point/_questions [{:db/id #edb/ref 17592186054841 :knowledge-point/id #uuid "6d42c63b-4549-5ed0-8da5-72561253acb9" :knowledge-point/title "Evaluating Expressions Containing Multiple Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d52de4c-5e14-522e-ace7-29624b919a04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186478629}] :answer-field/correct {:answer/id #uuid "2d52de4c-5e14-522e-ace7-29624b919a04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186478629} 