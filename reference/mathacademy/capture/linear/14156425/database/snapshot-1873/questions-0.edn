 17592186478717} :answer-field/id #uuid "3538e5cf-6fb8-5a5e-a234-cabbb29eccf2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478978}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1113da48-16db-5f6c-b647-7ec659a2ab4d" :question/math-academy-id "q-186019" :question/problem "If $w=-6,$ then $-4w-15=$" :question/worked-solution "Replacing $w$ with $-6$ in the expression, we get\n\n$$\n\\begin{aligned}-4w-15 & = \\\\ -4(-6)-15 & = \\\\ 24-15 & = \\\\ 9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479111 :knowledge-point/_questions [{:db/id #edb/ref 17592186054839 :knowledge-point/id #uuid "f915db41-a929-5ff0-b571-9ab3a1d510e5" :knowledge-point/title "Evaluating Linear Expressions Containing Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41f7a202-2c88-5780-a174-3331ee2546d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{5}" :db/id #edb/ref 17592186478649} {:answer/id #uuid "5b555cc0-0ed8-506e-80ce-b3b4bdb41696" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186478686} {:answer/id #uuid "72872caa-7826-5d33-9478-418fcf7b7bc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{10}" :db/id #edb/ref 17592186478727} {:answer/id #uuid "968707ff-2d1c-5885-9528-97f8f79a7377" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186478806} {:answer/id #uuid "dc5ffa82-9e00-5078-94cf-288a2d8f398a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{10}" :db/id #edb/ref 17592186478905}] :answer-field/correct {:answer/id #uuid "41f7a202-2c88-5780-a174-3331ee2546d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{5}" :db/id #edb/ref 17592186478649} :answer-field/id #uuid "eb973e61-7d23-52e5-b2ef-12eefda53bf8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479050}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a26bf3d9-e722-517d-a584-8e9fe07e450e" :question/math-academy-id "q-186031" :question/problem "Evaluate $-6a-\\frac{1}{5}$ for $a=\\frac{1}{3}.$" :question/worked-solution "Replacing $a$ with $\\frac{1}{3}$ in the expression, we get\n\n$$\n\\begin{aligned}-6a-\\frac{1}{5} & = \\\\ -6(\\frac{1}{3})-\\frac{1}{5} & = \\\\ -\\frac{6}{3}-\\frac{1}{5} & = \\\\ -2-\\frac{1}{5} & = \\\\ \\frac{(-2)\\cdot 5-1}{5} & = \\\\ -\\frac{11}{5}.\\end{aligned}\n$$"}]}
