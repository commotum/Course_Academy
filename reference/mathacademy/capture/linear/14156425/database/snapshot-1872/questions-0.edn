#{[{:db/id #edb/ref 17592186054393 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054838 :knowledge-point/id #uuid "9a02aff6-185a-56b7-8139-5efad8ddf403" :knowledge-point/title "Evaluating Linear Expressions"}] :question/id #uuid "dad98e52-6c94-5cb9-95f1-0db822fbb44a" :question/math-academy-id "e-12915" :question/problem "Evaluate $11p-2$ for $p=4$." :question/worked-solution "Replacing $p$ with $\\color{blue}4$ in the expression, we get\n\n$$\n\\begin{aligned} 11p-2 \\\\ &= 11({\\color{blue}4})-2 \\\\ &= 44-2 \\\\ &= 42. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054394 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054840 :knowledge-point/id #uuid "e5dcee75-1c40-5885-81e2-960bee2dd3a8" :knowledge-point/title "Evaluating Expressions of a Single Variable with Parentheses"}] :question/id #uuid "51bb6ac7-5c24-5805-85ba-9c697f4360b6" :question/math-academy-id "e-12919" :question/problem "Evaluate $2(3 x-1) +2$ for $x=-3$." :question/worked-solution "We replace $x$ with $-3$ in the expression and evaluate the parentheses first:\n\n$$\n\\begin{aligned}\n2(3x - 1) + 2 &=  \\\\\n2(3 \\cdot (-3) - 1) + 2 &=  \\\\\n2(-9 - 1) + 2 &=  \\\\\n2(-10) + 2 &=  \\\\\n- 20 + 2 &=  \\\\\n&= - 18\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054395 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054841 :knowledge-point/id #uuid "6d42c63b-4549-5ed0-8da5-72561253acb9" :knowledge-point/title "Evaluating Expressions Containing Multiple Variables"}] :question/id #uuid "caf5354e-e240-5515-94c7-6c3caa2063af" :question/math-academy-id "e-12920" :question/problem "Find the value of $x - \\dfrac{3}{2}y$ when $x=2$ and $y=-2$." :question/worked-solution "Replacing $x$ with $2$ and $y$ with $-2$ in the expression, we get\n\n$$\n\\begin{aligned}\nx - \\frac{3}{2}y &=  \\\\\n2 - \\frac{3}{2} \\cdot (-2) &=  \\\\\n2 + (-\\frac{3}{2}) \\cdot (-2) &=  \\\\\n2 + 3 &=  \\\\\n&= 5\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054424 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054839 :knowledge-point/id #uuid "f915db41-a929-5ff0-b571-9ab3a1d510e5" :knowledge-point/title "Evaluating Linear Expressions Containing Fractions"}] :question/id #uuid "6acd4bf9-8cf9-5a35-a1f5-a9a01766af87" :question/math-academy-id "e-13069" :question/problem "Evaluate $2-\\dfrac{u}{4}$ for $u=\\dfrac43$." :question/worked-solution "Replacing $u$ with\n\n$$\n\\dfrac43\n$$\n\nin the expression, we get\n\n$$\n\\begin{aligned}\n2 - \\frac{u}{4} &=  \\\\\n2 - \\frac{1}{4}u &=  \\\\\n2 - \\frac{1}{4} \\cdot \\frac{4}{3} &=  \\\\\n2 - \\frac{4}{12} &=  \\\\\n2 - \\frac{1}{3} &=  \\\\\n\\frac{6 - 1}{3} &=  \\\\\n&= \\frac{5}{3}\n\\end{aligned}\n$$"}]}
