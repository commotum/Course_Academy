{
  "dom_id": "step-73033",
  "name": "Example: \n                    Evaluating Linear Expressions Containing Fractions",
  "problem": "Evaluate $2-\\dfrac{u}{4}$ for $u=\\dfrac43.$",
  "worked_solution": "Replacing $u$ with $\\dfrac43$ in the expression, we get\n\n$$\n\\begin{aligned}2-\\frac{u}{4} & = \\\\ 2-\\frac{1}{4}u & = \\\\ 2-\\frac{1}{4}\\cdot \\frac{4}{3} & = \\\\ 2-\\frac{4}{12} & = \\\\ 2-\\frac{1}{3} & = \\\\ \\frac{6-1}{3} & = \\\\ \\frac{5}{3}.\\end{aligned}\n$$",
  "calculator_instructions": "",
  "fields": [],
  "problem_field_keys": [],
  "answer_fields_complete": null,
  "result": null,
  "proof_feedback": null,
