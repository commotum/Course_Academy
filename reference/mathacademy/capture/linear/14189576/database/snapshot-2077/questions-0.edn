#{[{:db/id #edb/ref 17592186502140 :knowledge-point/_questions [{:db/id #edb/ref 17592186068693 :knowledge-point/id #uuid "ef428368-9b55-5bbb-94ef-99e503ca9868" :knowledge-point/title "Finding a Point-Slope Equation Given Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1769de88-881d-5956-99f5-096e2c3b7e1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-1=3(x-3)" :db/id #edb/ref 17592186501511} {:answer/id #uuid "4bf048cb-a4c7-5d36-91ca-c83dcdce6dc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+3=\\frac{3}{7}(x-1)" :db/id #edb/ref 17592186501603} {:answer/id #uuid "4fa5e41e-58fd-5a9c-8a80-07017c5e334c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+3=3(x+1)" :db/id #edb/ref 17592186501611} {:answer/id #uuid "afaf01af-827d-5890-8956-ef74d5697985" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+1=\\frac{3}{7}(x+3)" :db/id #edb/ref 17592186501814} {:answer/id #uuid "b7920225-86ca-5473-953d-d1acecfdfacd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-1=\\frac{3}{7}(x+3)" :db/id #edb/ref 17592186501832}] :answer-field/correct {:answer/id #uuid "afaf01af-827d-5890-8956-ef74d5697985" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+1=\\frac{3}{7}(x+3)" :db/id #edb/ref 17592186501814} :answer-field/id #uuid "5537ccfc-a1e3-5cdc-8038-6152a735dd0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502003}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bd240e88-fbe1-5844-ad36-74f8bed7e2a0" :question/math-academy-id "q-109537" :question/problem "Find, in point-slope form, the equation of the line that passes through the points $(-3,-1)$ and $(4,2).$" :question/worked-solution "We know that the line passes through the point $(-3,-1),$ so we can use $({x}_{1},{y}_{1})=(-3,-1)$ in our point-slope formula. All that remains is to compute $m,$ and we can do this using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{2-(-1)}{4-(-3)}=\\frac{2+1}{4+3}=\\frac{3}{7}\\end{aligned}\n$$\n\nThen, we substitute $m=\\frac{3}{7}$ and the point $({x}_{1},{y}_{1})=(-3,-1)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-1) & =\\frac{3}{7}(x-(-3)) \\\\ y+1 & =\\frac{3}{7}(x+3)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502159 :knowledge-point/_questions [{:db/id #edb/ref 17592186068693 :knowledge-point/id #uuid "ef428368-9b55-5bbb-94ef-99e503ca9868" :knowledge-point/title "Finding a Point-Slope Equation Given Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f0e8229-9e05-5b49-a5bc-1c064268bc9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+1=3(x-1)" :db/id #edb/ref 17592186501492} {:answer/id #uuid "70ebac15-8dee-54b4-967e-d6e875941a64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-4=3(x+1)" :db/id #edb/ref 17592186501672} {:answer/id #uuid "81218ca0-1739-582b-ab48-ef0aaec2d811" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+4=\\frac{1}{3}(x-1)" :db/id #edb/ref 17592186501714} {:answer/id #uuid "e304c12c-7b3f-5ccf-8257-ced519e507f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-1=-\\frac{1}{3}(x-4)" :db/id #edb/ref 17592186501920} {:answer/id #uuid "fbd0be6f-c3bd-5524-aac0-617dc0483f3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-4=-\\frac{1}{3}(x+1)" :db/id #edb/ref 17592186501966}] :answer-field/correct {:answer/id #uuid "fbd0be6f-c3bd-5524-aac0-617dc0483f3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-4=-\\frac{1}{3}(x+1)" :db/id #edb/ref 17592186501966} :answer-field/id #uuid "58cdb945-4167-5cc0-adcc-654b4ba82f97" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502005}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f088ab98-ea37-5733-acee-5703f82f16fe" :question/math-academy-id "q-109542" :question/problem "Find, in point-slope form, the equation of the line that passes through the points $(-1,4)$ and $(5,2).$" :question/worked-solution "We know that the line passes through the point $(-1,4),$ so we can use $({x}_{1},{y}_{1})=(-1,4)$ in our point-slope formula. All that remains is to compute $m,$ and we can do this using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{2-4}{5-(-1)}=\\frac{-2}{6}=-\\frac{1}{3}\\end{aligned}\n$$\n\nThen, we substitute $m=-\\frac{1}{3}$ and the point $({x}_{1},{y}_{1})=(-1,4)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-4 & =-\\frac{1}{3}(x-(-1)) \\\\ y-4 & =-\\frac{1}{3}(x+1)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502150 :knowledge-point/_questions [{:db/id #edb/ref 17592186068694 :knowledge-point/id #uuid "1a620c55-6fa6-52db-92c6-231f631c0b45" :knowledge-point/title "Finding a Slope-Intercept Form Using Point-Slope Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a1f86cd-0086-5765-9ba9-5e0bcefb0ed1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x-7" :db/id #edb/ref 17592186501487} {:answer/id #uuid "a044491e-9316-5e2b-828a-80ff38d98c4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x-2" :db/id #edb/ref 17592186501766} {:answer/id #uuid "b1e543ad-cf33-5fd3-921e-3361e3489906" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x+7" :db/id #edb/ref 17592186501822} {:answer/id #uuid "bf69e2dc-5d68-5e7a-8fda-ed88c91e4da7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x+3" :db/id #edb/ref 17592186501852} {:answer/id #uuid "e78fada1-45c2-57a2-a158-de8b1d290184" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x-2" :db/id #edb/ref 17592186501931}] :answer-field/correct {:answer/id #uuid "a044491e-9316-5e2b-828a-80ff38d98c4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x-2" :db/id #edb/ref 17592186501766} :answer-field/id #uuid "8edbb288-1d9d-5e4c-bfd5-15eba8ff9406" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502028}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d43f31da-b163-56de-90b2-998690e787ff" :question/math-academy-id "q-109573" :question/problem "Calculate the equation of the line that passes through the points $(-5,3)$ and $(-1,-1).$" :question/worked-solution "First, we will construct the point-slope formula for the line. Then, we will simplify the point-slope formula into slope-intercept form.\n\nWe start by computing the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{-1-3}{-1-(-5)}=\\frac{-4}{4}=-1\\end{aligned}\n$$\n\nThen, we substitute $m=-1$ and the point $({x}_{1},{y}_{1})=(-5,3)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-3 & =-(x-(-5)) \\\\ y-3 & =-(x+5)\\end{aligned}\n$$\n\nFinally, we simplify the equation into slope-intercept form:\n\n$$\n\\begin{aligned}y-3 & =-(x+5) \\\\ y-3 & =-x-5 \\\\ y & =-x-2\\end{aligned}\n$$"}]}
