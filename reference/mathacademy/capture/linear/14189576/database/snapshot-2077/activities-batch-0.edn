#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186069563} :activity/id #uuid "1f8c9db7-3784-53ad-acdf-c7009ab4e43d" :activity/scope {:db/id #edb/ref 17592186050635 :topic/id #uuid "5a901d31-08d1-5602-a6b3-9ae8fa80845b" :topic/math-academy-id 418} :activity/steps [{:db/id #edb/ref 17592186069563 :step/content {:db/id #edb/ref 17592186070020 :tutorial/content "The **point-slope form** of a line that passes through any point $(x_1,y_1)$ with slope $m$ is given by \n\n$$\ny - y_1 = m(x-x_1).\n$$\n\n \n\nFor example, consider the straight line graph which passes through the points $(3,1)$ and $(5,5)$, as shown below.\n\n![](images/e7/e7838ffcb8f56ebffd384763ff761990e15031bdc5cdf3f0cc1f964ed69a4806.png)\n\nWe know that the line passes through the point $(3,1),$ so we can use $(x_1,y_1) = (3,1)$ in our point-slope formula. All that remains is to compute $m,$ and we can do this using the given points.\n\nFirst, calculate the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{5-1}{5-3}=\\frac{4}{2}=2\\end{aligned}\n$$\n\nThen, we substitute $m=2$ and the point $(x_1,y_1) = (3,1)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =2(x-3)\\end{aligned}\n$$\n\n**Note:** If we simplify this point-slope formula, we obtain the slope-intercept form of the line:\n\n$$\n\\begin{aligned}y-1 & =2(x-3) \\\\ y-1 & =2x-6 \\\\ y & =2x-5\\end{aligned}\n$$\n\n**Watch out!** We could put $(x_1,y_1)=(5,5).$ In this case, the point-slope form will be different:\n\n$$\ny-5=2(x-5)\n$$\n\n \nBut the resulting simplified slope-intercept form will be the same:\n\n$$\ny = 2x-5\n$$" :tutorial/id #uuid "43f9e39e-fc27-549d-8ec4-b2bf4f375a33" :tutorial/math-academy-id 8695 :tutorial/title "Introduction"} :step/id #uuid "866e675a-4d40-5d4f-ab69-7850b06a40d3" :step/math-academy-id 114979 :step/next {:db/id #edb/ref 17592186069564}} {:db/id #edb/ref 17592186069564 :step/content {:db/id #edb/ref 17592186068692 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068478 :question/id #uuid "ccc054b8-db6c-5726-bb60-a744467a9f6d" :question/math-academy-id "e-13974"} :knowledge-point/id #uuid "8f2df46b-730d-54d0-9cfa-3636a3d37839" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049716}] :knowledge-point/questions [{:db/id #edb/ref 17592186069106} {:db/id #edb/ref 17592186069455} {:db/id #edb/ref 17592186492841} {:db/id #edb/ref 17592186492895}] :knowledge-point/title "Finding a Point-Slope Equation Given a Slope and a Point"} :step/id #uuid "81e196b1-7aa2-52a3-a840-bcf07eca8e5a" :step/math-academy-id 114980 :step/next {:db/id #edb/ref 17592186069565}} {:db/id #edb/ref 17592186069565 :step/content {:db/id #edb/ref 17592186068693 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068479 :question/id #uuid "2b89eb42-8f10-57e8-aaa1-db4a2854c93e" :question/math-academy-id "e-13975"} :knowledge-point/id #uuid "ef428368-9b55-5bbb-94ef-99e503ca9868" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049061}] :knowledge-point/questions [{:db/id #edb/ref 17592186069456} {:db/id #edb/ref 17592186069457} {:db/id #edb/ref 17592186492881} {:db/id #edb/ref 17592186492910} {:db/id #edb/ref 17592186502140} {:db/id #edb/ref 17592186502159}] :knowledge-point/title "Finding a Point-Slope Equation Given Two Points"} :step/id #uuid "d8550af5-658f-598e-b2b6-d122f4b6baeb" :step/math-academy-id 114983 :step/next {:db/id #edb/ref 17592186069566}} {:db/id #edb/ref 17592186069566 :step/content {:db/id #edb/ref 17592186068694 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068480 :question/id #uuid "88378710-e983-5b10-b56b-40397480e460" :question/math-academy-id "e-13978"} :knowledge-point/id #uuid "1a620c55-6fa6-52db-92c6-231f631c0b45" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050575}] :knowledge-point/questions [{:db/id #edb/ref 17592186069484} {:db/id #edb/ref 17592186069493} {:db/id #edb/ref 17592186069494} {:db/id #edb/ref 17592186492835} {:db/id #edb/ref 17592186492843} {:db/id #edb/ref 17592186492871} {:db/id #edb/ref 17592186492886} {:db/id #edb/ref 17592186502150}] :knowledge-point/title "Finding a Slope-Intercept Form Using Point-Slope Form"} :step/id #uuid "a58fbae9-fa8d-5cc2-8b3b-97a9b645d318" :step/math-academy-id 114986}] :activity/title "Equations of Lines in Point-Slope Form" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068952}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186502178} :activity/id #uuid "6e99407a-bbb3-5be2-9242-96bf986482bc" :activity/scope {:db/id #edb/ref 17592186050635 :topic/id #uuid "5a901d31-08d1-5602-a6b3-9ae8fa80845b" :topic/math-academy-id 418} :activity/steps [{:db/id #edb/ref 17592186502178 :step/content {:db/id #edb/ref 17592186502140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1769de88-881d-5956-99f5-096e2c3b7e1e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y-1=3(x-3)" :db/id #edb/ref 17592186501511} {:answer/id #uuid "4bf048cb-a4c7-5d36-91ca-c83dcdce6dc4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y+3=\\frac{3}{7}(x-1)" :db/id #edb/ref 17592186501603} {:answer/id #uuid "4fa5e41e-58fd-5a9c-8a80-07017c5e334c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y+3=3(x+1)" :db/id #edb/ref 17592186501611} {:answer/id #uuid "afaf01af-827d-5890-8956-ef74d5697985" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y+1=\\frac{3}{7}(x+3)" :db/id #edb/ref 17592186501814} {:answer/id #uuid "b7920225-86ca-5473-953d-d1acecfdfacd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y-1=\\frac{3}{7}(x+3)" :db/id #edb/ref 17592186501832}] :answer-field/correct {:db/id #edb/ref 17592186501814} :answer-field/id #uuid "5537ccfc-a1e3-5cdc-8038-6152a735dd0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502003}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bd240e88-fbe1-5844-ad36-74f8bed7e2a0" :question/math-academy-id "q-109537" :question/problem "Find, in point-slope form, the equation of the line that passes through the points $(-3,-1)$ and $(4,2).$" :question/worked-solution "We know that the line passes through the point $(-3,-1),$ so we can use $({x}_{1},{y}_{1})=(-3,-1)$ in our point-slope formula. All that remains is to compute $m,$ and we can do this using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{2-(-1)}{4-(-3)}=\\frac{2+1}{4+3}=\\frac{3}{7}\\end{aligned}\n$$\n\nThen, we substitute $m=\\frac{3}{7}$ and the point $({x}_{1},{y}_{1})=(-3,-1)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-1) & =\\frac{3}{7}(x-(-3)) \\\\ y+1 & =\\frac{3}{7}(x+3)\\end{aligned}\n$$"} :step/id #uuid "3fa47a77-5577-5668-bee3-ae8be829d8a6" :step/next {:db/id #edb/ref 17592186502191}} {:db/id #edb/ref 17592186502191 :step/content {:db/id #edb/ref 17592186502159 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f0e8229-9e05-5b49-a5bc-1c064268bc9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y+1=3(x-1)" :db/id #edb/ref 17592186501492} {:answer/id #uuid "70ebac15-8dee-54b4-967e-d6e875941a64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y-4=3(x+1)" :db/id #edb/ref 17592186501672} {:answer/id #uuid "81218ca0-1739-582b-ab48-ef0aaec2d811" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y+4=\\frac{1}{3}(x-1)" :db/id #edb/ref 17592186501714} {:answer/id #uuid "e304c12c-7b3f-5ccf-8257-ced519e507f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y-1=-\\frac{1}{3}(x-4)" :db/id #edb/ref 17592186501920} {:answer/id #uuid "fbd0be6f-c3bd-5524-aac0-617dc0483f3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y-4=-\\frac{1}{3}(x+1)" :db/id #edb/ref 17592186501966}] :answer-field/correct {:db/id #edb/ref 17592186501966} :answer-field/id #uuid "58cdb945-4167-5cc0-adcc-654b4ba82f97" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502005}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f088ab98-ea37-5733-acee-5703f82f16fe" :question/math-academy-id "q-109542" :question/problem "Find, in point-slope form, the equation of the line that passes through the points $(-1,4)$ and $(5,2).$" :question/worked-solution "We know that the line passes through the point $(-1,4),$ so we can use $({x}_{1},{y}_{1})=(-1,4)$ in our point-slope formula. All that remains is to compute $m,$ and we can do this using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{2-4}{5-(-1)}=\\frac{-2}{6}=-\\frac{1}{3}\\end{aligned}\n$$\n\nThen, we substitute $m=-\\frac{1}{3}$ and the point $({x}_{1},{y}_{1})=(-1,4)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-4 & =-\\frac{1}{3}(x-(-1)) \\\\ y-4 & =-\\frac{1}{3}(x+1)\\end{aligned}\n$$"} :step/id #uuid "8aba4594-51e5-51cc-b7f3-736cad45fe1b" :step/next {:db/id #edb/ref 17592186502200}} {:db/id #edb/ref 17592186502200 :step/content {:db/id #edb/ref 17592186502150 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a1f86cd-0086-5765-9ba9-5e0bcefb0ed1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-x-7" :db/id #edb/ref 17592186501487} {:answer/id #uuid "a044491e-9316-5e2b-828a-80ff38d98c4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-x-2" :db/id #edb/ref 17592186501766} {:answer/id #uuid "b1e543ad-cf33-5fd3-921e-3361e3489906" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-x+7" :db/id #edb/ref 17592186501822} {:answer/id #uuid "bf69e2dc-5d68-5e7a-8fda-ed88c91e4da7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=x+3" :db/id #edb/ref 17592186501852} {:answer/id #uuid "e78fada1-45c2-57a2-a158-de8b1d290184" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=x-2" :db/id #edb/ref 17592186501931}] :answer-field/correct {:db/id #edb/ref 17592186501766} :answer-field/id #uuid "8edbb288-1d9d-5e4c-bfd5-15eba8ff9406" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502028}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d43f31da-b163-56de-90b2-998690e787ff" :question/math-academy-id "q-109573" :question/problem "Calculate the equation of the line that passes through the points $(-5,3)$ and $(-1,-1).$" :question/worked-solution "First, we will construct the point-slope formula for the line. Then, we will simplify the point-slope formula into slope-intercept form.\n\nWe start by computing the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{-1-3}{-1-(-5)}=\\frac{-4}{4}=-1\\end{aligned}\n$$\n\nThen, we substitute $m=-1$ and the point $({x}_{1},{y}_{1})=(-5,3)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-3 & =-(x-(-5)) \\\\ y-3 & =-(x+5)\\end{aligned}\n$$\n\nFinally, we simplify the equation into slope-intercept form:\n\n$$\n\\begin{aligned}y-3 & =-(x+5) \\\\ y-3 & =-x-5 \\\\ y & =-x-2\\end{aligned}\n$$"} :step/id #uuid "c1bc04e5-5845-5fbc-b7bb-14ef8645487e"}] :activity/title "Equations of Lines in Point-Slope Form" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186501455}]}
