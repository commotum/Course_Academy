8-50d5-ae52-c02ad59c8fa8" #edb/ref 17592186045417] [17592186566898 #edb/ref 1075 #edb/ref 17592186566649 #edb/ref 17592186045417] [17592186566898 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186566898 #edb/ref 1077 "field-3" #edb/ref 17592186045417] [17592186566898 #edb/ref 1078 #edb/ref 17592186566649 #edb/ref 17592186045417] [17592186566898 #edb/ref 1079 #uuid "30c5013c-7ef7-5aa3-9cbc-e11a67222488" #edb/ref 17592186045417] [17592186566914 #edb/ref 1075 #edb/ref 17592186566707 #edb/ref 17592186045417] [17592186566914 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186566914 #edb/ref 1077 "field-2" #edb/ref 17592186045417] [17592186566914 #edb/ref 1078 #edb/ref 17592186566707 #edb/ref 17592186045417] [17592186566914 #edb/ref 1079 #uuid "53abe454-b2dd-5ad2-8fe1-b231d8cd91f2" #edb/ref 17592186045417] [17592186566989 #edb/ref 1075 #edb/ref 17592186566751 #edb/ref 17592186045417] [17592186566989 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186566989 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186566989 #edb/ref 1078 #edb/ref 17592186566751 #edb/ref 17592186045417] [17592186566989 #edb/ref 1079 #uuid "e8fccfc7-d496-5162-8471-a2686b179c57" #edb/ref 17592186045417] [17592186566994 #edb/ref 1075 #edb/ref 17592186566446 #edb/ref 17592186045417] [17592186566994 #edb/ref 1075 #edb/ref 17592186566517 #edb/ref 17592186045417] [17592186566994 #edb/ref 1075 #edb/ref 17592186566612 #edb/ref 17592186045417] [17592186566994 #edb/ref 1075 #edb/ref 17592186566844 #edb/ref 17592186045417] [17592186566994 #edb/ref 1075 #edb/ref 17592186566859 #edb/ref 17592186045417] [17592186566994 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186566994 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186566994 #edb/ref 1078 #edb/ref 17592186566859 #edb/ref 17592186045417] [17592186566994 #edb/ref 1079 #uuid "f016f7be-fb1c-5a42-bf74-e51c3d868c27" #edb/ref 17592186045417] [17592186567014 #edb/ref 1068 #edb/ref 17592186566994 #edb/ref 17592186045417] [17592186567014 #edb/ref 1069 "q-156127" #edb/ref 17592186045417] [17592186567014 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186567014 #edb/ref 1071 "What is the solution to the following system of inequalities?\n\n$$\n\\{\\begin{aligned}n+2<5 \\\\ 1-2n\\le 3\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186567014 #edb/ref 1072 #uuid "0e2e4815-0beb-5581-be50-52ebe618cd02" #edb/ref 17592186045417] [17592186567014 #edb/ref 1074 "To solve the system, we need to find the values of $n$ that satisfy both $n+2<5$ and $1-2n\\le 3$ simultaneously.\n\n- First, we solve $n+2<5\\,:$ \n\n$$\n\\begin{aligned}n+2 & <5 \\\\ n+2-2 & <5-2 \\\\ n & <3\\end{aligned}\n$$\n\n![](images/4e/4e6e1c1a65abf5b7b88d39bb4d2606d64d5bc9ae526925e9f869eab0927194e3.png)\n\n$$\n\n$$\n\n- Then, we solve $1-2n\\le 3\\,:$\n\n$$\n\\begin{aligned}1-2n & \\le 3 \\\\ 1-2n-1 & \\le 3-1 \\\\ -2n & \\le 2 \\\\ (-1)\\cdot (-2n) & \\ge (-1)\\cdot 2 \\\\ 2n & \\ge -2 \\\\ \\frac{2n}{2} & \\ge \\frac{-2}{2} \\\\ n & \\ge -1\\end{aligned}\n$$\n\n![](images/8e/8e96c91b84e3c69b2e8f58251dbe21294ef8b23ffa695c1b7fbe53ad4f22b2fc.png)\n\nTo find the values of $n$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/cd/cd1d2ad0e357eb3117e5b61351afeda01a348bfff5aec1a2d2940c77ecae120c.png)\n\n \n\n$$\n\n$$\n\nThus, the final solution is $n\\in [-1,3).$" #edb/ref 17592186045417] [17592186567048 #edb/ref 1068 #edb/ref 17592186566889 #edb/ref 17592186045417] [17592186567048 #edb/ref 1069 "q-156128" #edb/ref 17592186045417] [17592186567048 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186567048 #edb/ref 1071 "Find the set of values of $x$ that satisfy $1<2x-1\\le 5$ and $1-2x\\le 3.$" #edb/ref 17592186045417] [17592186567048 #edb/ref 1072 #uuid "6919ce13-e2d9-594d-bb7b-2bdd566b01d1" #edb/ref 17592186045417] [17592186567048 #edb/ref 1074 "To solve compound \"and\" inequalities, we solve each inequality separately and then find their intersection.\n\n- First, we solve $1<2x-1\\le 5\\,:$\n\n$$\n\\begin{aligned}1 & <2x-1\\le 5 \\\\ 1+1 & <2x-1+1\\le 5+1 \\\\ 2 & <2x\\le 6 \\\\ \\frac{2}{2} & <\\frac{2x}{2}\\le \\frac{6}{2} \\\\ 1 & <x\\le 3\\end{aligned}\n$$\n\n![](images/2b/2b111554de3019b78a3d6e8992477bb1401a53d7c2bbe09a6407e675b8d06daa.png)\n\n- Then, we solve  $1-2x\\le 3\\,:$\n\n$$\n\\begin{aligned}1-2x & \\le 3 \\\\ 1-2x-1 & \\le 3-1 \\\\ -2x & \\le 2 \\\\ (-1)\\cdot (-2x) & \\ge (-1)\\cdot 2 \\\\ 2x & \\ge -2 \\\\ \\frac{2x}{2} & \\ge \\frac{-2}{2} \\\\ x & \\ge -1\\end{aligned}\n$$\n\n![](images/ca/ca4d8a229772ec9d22a45c99cdad22379b6b55aa5d6fe4bb6288fe66d8c5696a.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/74/74cc11cbd20e5b82171d4c89407f24eb6f60ee558bf41a313009839c6f885f7e.png)\n\n \n\n$$\n\n$$\n\nThus, the final solution is $x\\in (1,3].$" #edb/ref 17592186045417] [17592186567078 #edb/ref 1068 #edb/ref 17592186566898 #edb/ref 17592186045417] [17592186567078 #edb/ref 1068 #edb/ref 17592186566914 #edb/ref 17592186045417] [17592186567078 #edb/ref 1068 #edb/ref 17592186566989 #edb/ref 17592186045417] [17592186567078 #edb/ref 1069 "q-208784" #edb/ref 17592186045417] [17592186567078 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186567078 #edb/ref 1071 "What is the solution to the following system of inequalities?\n\n$$\n\\{\\begin{aligned}y-5\\le 2 \\\\ 2y+7>11\\end{aligned}\n$$\n\nThe solution is\n{{field-1}}{{field-2}}\n$y\\le $\n{{field-3}}." #edb/ref 17592186045417] [17592186567078 #edb/ref 1072 #uuid "b2b2b02a-ff73-57d9-825a-216db2bab95b" #edb/ref 17592186045417] [17592186567078 #edb/ref 1074 "To solve the system, we need to find the values of $y$ that satisfy both $y-5\\le 2$ and $2y+7>11$ simultaneously.\n\n- First, we solve $y-5\\le 2\\,:$\n\n$$\n\\begin{aligned}y-5 & \\le 2 \\\\ y-5+5 & \\le 2+5 \\\\ y & \\le 7\\end{aligned}\n$$\n\n![](images/b0/b0107bec7ccb2c56036de405a29870e8cfcc166cc6405f425fc3296ec8f1be2b.png)\n\n$$\n\n$$\n\n- Then, we solve $2y+7>11\\,:$\n\n$$\n\\begin{aligned}2y+7 & >11 \\\\ 2y+7-7 & >11-7 \\\\ 2y & >4 \\\\ \\frac{2y}{2} & >\\frac{4}{2} \\\\ y & >2\\end{aligned}\n$$\n\n![](images/59/59523e51144ef776295ec43032def1bc0192351deb6294fbb2d56acd87bb2cac.png)\n\n$$\n\n$$\n\nTo find the values of $y$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/98/981477f5336b96998b61b7ab18647609cb33c12984c14049621ac15c698c25a5.png)\n\n \n\n$$\n\n$$\n\nThus, the final solution is $2<y\\le 7.$" #edb/ref 17592186045417] [17592186567131 #edb/ref 1058 #edb/ref 17592186567150 #edb/ref 17592186045417] [17592186567131 #edb/ref 1062 #uuid "7435e07b-f0f9-5485-9a88-0f7e4a9d5287" #edb/ref 17592186045417] [17592186567131 #edb/ref 1063 #edb/ref 17592186567014 #edb/ref 17592186045417] [17592186567146 #edb/ref 1062 #uuid "c706594b-42c2-5706-a6e2-8d898feb9c13" #edb/ref 17592186045417] [17592186567146 #edb/ref 1063 #edb/ref 17592186567078 #edb/ref 17592186045417] [17592186567150 #edb/ref 1058 #edb/ref 17592186567146 #edb/ref 17592186045417] [17592186567150 #edb/ref 1062 #uuid "ddff42aa-f427-5cc0-ac91-0c80184cf30e" #edb/ref 17592186045417] [17592186567150 #edb/ref 1063 #edb/ref 17592186567048 #edb/ref 17592186045417]}
