#{[{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186065104} :activity/id #uuid "8d3261ec-ded8-5b6d-ac21-5c0ada0ad6a0" :activity/scope {:db/id #edb/ref 17592186049597 :topic/id #uuid "03616d92-38bb-52d1-b636-cc62f67b859d" :topic/math-academy-id 350} :activity/steps [{:db/id #edb/ref 17592186065104 :step/content {:db/id #edb/ref 17592186065437 :tutorial/content "Suppose we want to find all of the values of $x$ that satisfy *both* $3x+9 \\geq 0$ *and* $2x \\leq -2$ simultaneously. \n\nTo do this, we solve each inequality individually and then compute the intersection of the two solutions.\n\n- We start by solving $3x + 9 \\geq 0\\mathbin{:}$\n\n$$\n\\begin{aligned}3x+9 & \\ge 0 \\\\ 3x+9-9 & \\ge 0-9 \\\\ 3x & \\ge -9 \\\\ \\frac{3x}{3} & \\ge \\frac{-9}{3} \\\\ x & \\ge -3\\end{aligned}\n$$\n\nThe solution to this inequality is shown on the number line below.\n\n![](images/51/5127629c09f32bb8ed7872b476322d6973e44e82be7977492c8dd0967d3cb0ec.png)\n\n- Then, we solve $2x \\leq -2\\mathbin{:}$\n\n$$\n\\begin{aligned}2x & \\le -2 \\\\ \\frac{2x}{2} & \\le \\frac{-2}{2} \\\\ x & \\le -1\\end{aligned}\n$$\n\nThe solution to this inequality is shown on the number line below.\n\n![](images/35/35e30bc9c45b08793d847c8750698f7d9dab781438405239ed4483ce82f2dcfb.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/fe/fe4c223767cb06d9d620d32f5e668c7305688b3870bf0317304c56b11053e19f.png)\n\nThus, the final solution is $\\color{blue}-3 \\leq x \\leq -1.$" :tutorial/id #uuid "79460753-2a4c-5227-8dcd-7355a1841558" :tutorial/math-academy-id 8687 :tutorial/title "Introduction"} :step/id #uuid "f583864f-f671-5e7b-bc34-8fcce050be85" :step/math-academy-id 171168 :step/next {:db/id #edb/ref 17592186065105}} {:db/id #edb/ref 17592186065105 :step/content {:db/id #edb/ref 17592186064237 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063973 :question/id #uuid "f55392b5-8cb5-516c-8151-051768d813dd" :question/math-academy-id "e-13948"} :knowledge-point/id #uuid "53bf0d67-be51-5194-884b-e275d58a2ba1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048483} {:db/id #edb/ref 17592186049270} {:db/id #edb/ref 17592186050503}] :knowledge-point/questions [{:db/id #edb/ref 17592186064470} {:db/id #edb/ref 17592186064602} {:db/id #edb/ref 17592186064660} {:db/id #edb/ref 17592186510367} {:db/id #edb/ref 17592186510458}] :knowledge-point/title "Finding the Intersection of Two Inequalities"} :step/id #uuid "571d4995-c070-510a-b196-97efcbe7b3c6" :step/math-academy-id 171169 :step/next {:db/id #edb/ref 17592186065106}} {:db/id #edb/ref 17592186065106 :step/content {:db/id #edb/ref 17592186064238 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063975 :question/id #uuid "f088ca30-8538-57e7-9882-99d5c155c505" :question/math-academy-id "e-13952"} :knowledge-point/id #uuid "79f6f04e-ecce-5318-b72b-46478661ced0" :knowledge-point/questions [{:db/id #edb/ref 17592186064603} {:db/id #edb/ref 17592186064656} {:db/id #edb/ref 17592186064895} {:db/id #edb/ref 17592186510423} {:db/id #edb/ref 17592186510436} {:db/id #edb/ref 17592186567078}] :knowledge-point/title "Solving Systems of Inequalities"} :step/id #uuid "b8f6c481-c857-541c-8eeb-23a9bcc07e97" :step/math-academy-id 171173 :step/next {:db/id #edb/ref 17592186065107}} {:db/id #edb/ref 17592186065107 :step/content {:db/id #edb/ref 17592186064239 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063978 :question/id #uuid "0a39d86b-ab9b-5479-9d7b-726247558397" :question/math-academy-id "e-13959"} :knowledge-point/id #uuid "c9460289-3e48-558e-b149-3e12a25e50a6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049162} {:db/id #edb/ref 17592186050301}] :knowledge-point/questions [{:db/id #edb/ref 17592186064471} {:db/id #edb/ref 17592186064604} {:db/id #edb/ref 17592186064913} {:db/id #edb/ref 17592186510442} {:db/id #edb/ref 17592186510467} {:db/id #edb/ref 17592186541097} {:db/id #edb/ref 17592186541146} {:db/id #edb/ref 17592186567014}] :knowledge-point/title "Flipping the Sign of an Inequality in a System"} :step/id #uuid "1b6abea6-1d80-56ff-9f97-1fb883fa340f" :step/math-academy-id 171177 :step/next {:db/id #edb/ref 17592186065108}} {:db/id #edb/ref 17592186065108 :step/content {:db/id #edb/ref 17592186064240 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063979 :question/id #uuid "d2726a15-72d6-5c0c-8302-68ba55f8734d" :question/math-academy-id "e-13961"} :knowledge-point/id #uuid "d3286dfe-5140-5ba7-8e34-c98e63dc15c0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050734}] :knowledge-point/questions [{:db/id #edb/ref 17592186064518} {:db/id #edb/ref 17592186064605} {:db/id #edb/ref 17592186510429} {:db/id #edb/ref 17592186541075} {:db/id #edb/ref 17592186567048}] :knowledge-point/title "Systems Containing Compound Inequalities"} :step/id #uuid "826c8505-1d09-51a4-a0f1-27d2b362db4d" :step/math-academy-id 171181}] :activity/title "Compound AND Inequalities" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064440}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186541209} :activity/id #uuid "c90a0db0-b9be-51c5-9118-106956e6ede9" :activity/scope {:db/id #edb/ref 17592186049597 :topic/id #uuid "03616d92-38bb-52d1-b636-cc62f67b859d" :topic/math-academy-id 350} :activity/steps [{:db/id #edb/ref 17592186541174 :step/content {:db/id #edb/ref 17592186541146 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bf162e4-cd7b-54b0-8466-f4b821b2abe0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (1,2)" :db/id #edb/ref 17592186540629} {:answer/id #uuid "58c4a563-279d-570a-a388-2ff52a0b29f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (1,2]" :db/id #edb/ref 17592186540679} {:answer/id #uuid "5b4c177a-706d-56c0-a404-7bc45e333979" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (1,\\infty )" :db/id #edb/ref 17592186540681} {:answer/id #uuid "b8c8fe3f-912f-5186-af72-dca875ba83b7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There is no solution" :db/id #edb/ref 17592186540837} {:answer/id #uuid "dedbb23f-f487-5d15-9528-e264d7f421c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-\\infty ,2)" :db/id #edb/ref 17592186540908}] :answer-field/correct {:db/id #edb/ref 17592186540679} :answer-field/id #uuid "3b901c12-2a57-5d11-9bb4-941a5ba8e6d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540968}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e3894629-c728-5b78-885d-1ca88944c278" :question/math-academy-id "q-156096" :question/problem "What is the solution to the following system of inequalities?\n\n$$\n\\{\\begin{aligned}2x+4>6 \\\\ 4-x\\ge 2\\end{aligned}\n$$" :question/worked-solution "To solve the system, we need to find the values of $k$ that satisfy both $2x+4>6$ and $4-x\\ge 2$ simultaneously.\n\n- First, we solve $2x+4>6:$ \n\n$$\n\\begin{aligned}2x+4 & >6 \\\\ 2x+4-4 & >6-4 \\\\ 2x & >2 \\\\ \\frac{2x}{2} & >\\frac{2}{2} \\\\ x & >1\\end{aligned}\n$$\n\n![](images/6d/6d3b61147527a632ccb46629a356e9f5c92a1ddfc8a52f3d0890cd46eb56f564.png)\n\n- Then, we solve $4-x\\ge 2:$ \n\n$$\n\\begin{aligned}4-x & \\ge 2 \\\\ 4-x-4 & \\ge 2-4 \\\\ -x & \\ge -2 \\\\ (-1)\\cdot (-x) & \\le (-1)\\cdot (-2) \\\\ x & \\le 2\\end{aligned}\n$$\n\n![](images/14/1452391c950b051c4cf454723498e6fa657f6d5f1315f78e50f3450bf7fbc1eb.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/a2/a22a207cc64d33470e27d0b1f45ad0b87106fafd67b88c2163524a44951639bf.png)\n\n    \n\nThus, the final solution is $x\\in (1,2].$"} :step/id #uuid "39304ff2-c632-5bfe-be88-8e807d05822b" :step/next {:db/id #edb/ref 17592186541196}} {:db/id #edb/ref 17592186541196 :step/content {:db/id #edb/ref 17592186541075 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "384fd572-a66f-5128-a6b3-44005974b90d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There is no solution" :db/id #edb/ref 17592186540618} {:answer/id #uuid "3b432c6d-0781-5270-b3f1-15ea3f1af7fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in [1,3)" :db/id #edb/ref 17592186540623} {:answer/id #uuid "9852c2c1-fa2d-5d40-ab08-ac566524df45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-\\infty ,-1)\\cup [-2,3]" :db/id #edb/ref 17592186540784} {:answer/id #uuid "a5a74e4a-4c8d-5255-a204-4cf5d72033a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (2,3]" :db/id #edb/ref 17592186540803} {:answer/id #uuid "a7208089-38df-5278-b199-6279ab8f6251" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-\\infty ,-1)" :db/id #edb/ref 17592186540806}] :answer-field/correct {:db/id #edb/ref 17592186540618} :answer-field/id #uuid "db98ca20-fac1-5cbb-9acf-371f7dfc8910" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186541037}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3cd6f974-c65a-5148-8d00-27906b9e797b" :question/math-academy-id "q-156129" :question/problem "Find the set of values of $x$ that satisfy $2<2x+4\\le 6$ and $4x>12.$" :question/worked-solution "To solve compound \"and\" inequalities, we solve each inequality separately and then find their intersection.\n\n- First, we solve $2<2x+4\\le 6\\,:$ \n\n$$\n\\begin{aligned}2 & <2x+4\\le 6 \\\\ 2-4 & <2x+4-4\\le 6-4 \\\\ -2 & <2x\\le 2 \\\\ \\frac{-2}{2} & <\\frac{2x}{2}\\le \\frac{2}{2} \\\\ -1 & <x\\le 1\\end{aligned}\n$$\n\n![](images/48/485e77fe84f5745120d5f450c3e1043ee61463a83f7c12bfc6d1ae0e4124a38b.png)\n\n   \n\n- Then, we solve  $4x>12\\,:$\n\n$$\n\\begin{aligned}4x & >12 \\\\ \\frac{4x}{4} & >\\frac{12}{4} \\\\ x & >3\\end{aligned}\n$$\n\n![](images/65/654f97a64ec1a13b4a94860dfa07d05f7c119a5fe2084ba23aa994a97f0bea70.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/d2/d2d0f41792356b6c250612b033413f66bfd7a35440e1b84da660fccd5c1285b0.png)\n\n$$\n\n$$\n\nIt turns out that the solutions do not overlap at all. Therefore, there are no values of $x$ that satisfy both inequalities simultaneously. So, there is no solution."} :step/id #uuid "83ea5dfe-2530-5a49-b45b-ff45d9eb5966"} {:db/id #edb/ref 17592186541209 :step/content {:db/id #edb/ref 17592186541097 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "360b3e1c-48bd-528c-9d5d-938043d6c2b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in [-3,1)" :db/id #edb/ref 17592186540614} {:answer/id #uuid "3f31d9f9-5c07-5bf0-9421-ad3c02ba0764" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-\\infty ,1)" :db/id #edb/ref 17592186540634} {:answer/id #uuid "582fa1a5-35f2-55f1-ba22-a7eb59f9b896" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There is no solution" :db/id #edb/ref 17592186540677} {:answer/id #uuid "88eadd3f-76f1-5d70-87a5-4c7bc2dd9b57" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in [-3,\\infty )" :db/id #edb/ref 17592186540758} {:answer/id #uuid "d71fd4ba-85b7-5c46-8cbc-f5708e1bd047" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-1,3]" :db/id #edb/ref 17592186540890}] :answer-field/correct {:db/id #edb/ref 17592186540614} :answer-field/id #uuid "36a01c9a-6a75-5d02-8751-2d076edf1a6a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540966}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6ef129d9-0a92-5a3f-b637-51eadd473818" :question/math-academy-id "q-156055" :question/problem "What is the solution to the following system of inequalities?\n\n$$\n\\{\\begin{aligned}x+3<4 \\\\ 3-2x\\le 9\\end{aligned}\n$$" :question/worked-solution "To solve the system, we need to find the values of $x$ that satisfy both $x+3<4$ and $3-2x\\le 9$ simultaneously.\n\n- First, we solve $x+3<4\\,:$ \n\n$$\n\\begin{aligned}x+3 & <4 \\\\ x+3-3 & <4-3 \\\\ x & <1\\end{aligned}\n$$\n\n![](images/c2/c20ffc0279a42a429797f42fcd929fb4dfb499e311dd3ed7b6b61fd95729953c.png)\n\n$$\n\n$$\n\n- Then, we solve $3-2x\\le 9\\,:$\n\n$$\n\\begin{aligned}3-2x & \\le 9 \\\\ 3-2x-3 & \\le 9-3 \\\\ -2x & \\le 6 \\\\ (-1)\\cdot (-2x) & \\ge (-1)\\cdot 6 \\\\ 2x & \\ge -6 \\\\ \\frac{2x}{2} & \\ge \\frac{-6}{2} \\\\ x & \\ge -3\\end{aligned}\n$$\n\n![](images/ae/ae72342a32ea8a952a3d00aec7a8ccc381804ae4b593ba58113911c4bc4b2c09.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/b7/b7d4814919a8c0b2a2ed8e130c8af2bdce5e7fd2d23d10e50e4e293d88170c2f.png)\n\n \n\n$$\n\n$$\n\nThus, the final solution is $x\\in [-3,1).$"} :step/id #uuid "a4e60d9b-c652-5fbe-abd0-d69cda48b5f5" :step/next {:db/id #edb/ref 17592186541174}}] :activity/title "Compound AND Inequalities" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186540524}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186567131} :activity/id #uuid "e6e5530b-ac3a-5a1c-8f43-75afa94c2ed2" :activity/scope {:db/id #edb/ref 17592186049597 :topic/id #uuid "03616d92-38bb-52d1-b636-cc62f67b859d" :topic/math-academy-id 350} :activity/steps [{:db/id #edb/ref 17592186567131 :step/content {:db/id #edb/ref 17592186567014 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26d0891c-161c-5834-b9eb-6586cb0c9bc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "n\\in [-3,3)" :db/id #edb/ref 17592186566446} {:answer/id #uuid "51695b2b-00d2-5afd-9514-8c7464cb7b59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "n\\in (1,3)" :db/id #edb/ref 17592186566517} {:answer/id #uuid "82ae7df2-949d-5f30-8f35-50b577c6c509" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There is no solution" :db/id #edb/ref 17592186566612} {:answer/id #uuid "ed75b313-51b7-5ed1-ad30-3536875d859b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "n\\in [-3,1)" :db/id #edb/ref 17592186566844} {:answer/id #uuid "f7a0d75b-e243-5815-8927-4c35ba1889f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "n\\in [-1,3)" :db/id #edb/ref 17592186566859}] :answer-field/correct {:db/id #edb/ref 17592186566859} :answer-field/id #uuid "f016f7be-fb1c-5a42-bf74-e51c3d868c27" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566994}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0e2e4815-0beb-5581-be50-52ebe618cd02" :question/math-academy-id "q-156127" :question/problem "What is the solution to the following system of inequalities?\n\n$$\n\\{\\begin{aligned}n+2<5 \\\\ 1-2n\\le 3\\end{aligned}\n$$" :question/worked-solution "To solve the system, we need to find the values of $n$ that satisfy both $n+2<5$ and $1-2n\\le 3$ simultaneously.\n\n- First, we solve $n+2<5\\,:$ \n\n$$\n\\begin{aligned}n+2 & <5 \\\\ n+2-2 & <5-2 \\\\ n & <3\\end{aligned}\n$$\n\n![](images/4e/4e6e1c1a65abf5b7b88d39bb4d2606d64d5bc9ae526925e9f869eab0927194e3.png)\n\n$$\n\n$$\n\n- Then, we solve $1-2n\\le 3\\,:$\n\n$$\n\\begin{aligned}1-2n & \\le 3 \\\\ 1-2n-1 & \\le 3-1 \\\\ -2n & \\le 2 \\\\ (-1)\\cdot (-2n) & \\ge (-1)\\cdot 2 \\\\ 2n & \\ge -2 \\\\ \\frac{2n}{2} & \\ge \\frac{-2}{2} \\\\ n & \\ge -1\\end{aligned}\n$$\n\n![](images/8e/8e96c91b84e3c69b2e8f58251dbe21294ef8b23ffa695c1b7fbe53ad4f22b2fc.png)\n\nTo find the values of $n$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/cd/cd1d2ad0e357eb3117e5b61351afeda01a348bfff5aec1a2d2940c77ecae120c.png)\n\n \n\n$$\n\n$$\n\nThus, the final solution is $n\\in [-1,3).$"} :step/id #uuid "7435e07b-f0f9-5485-9a88-0f7e4a9d5287" :step/next {:db/id #edb/ref 17592186567150}} {:db/id #edb/ref 17592186567146 :step/content {:db/id #edb/ref 17592186567078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "916544ca-e729-52f9-99f7-464a605534c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186566649}] :answer-field/correct {:db/id #edb/ref 17592186566649} :answer-field/id #uuid "30c5013c-7ef7-5aa3-9cbc-e11a67222488" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566898} {:answer-field/choices [{:answer/id #uuid "ad0c248c-2575-5291-8824-399e68cd193b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186566707}] :answer-field/correct {:db/id #edb/ref 17592186566707} :answer-field/id #uuid "53abe454-b2dd-5ad2-8fe1-b231d8cd91f2" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566914} {:answer-field/choices [{:answer/id #uuid "c3df23fd-8dd2-5adf-999f-c1d609ac0517" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186566751}] :answer-field/correct {:db/id #edb/ref 17592186566751} :answer-field/id #uuid "e8fccfc7-d496-5162-8471-a2686b179c57" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566989}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b2b2b02a-ff73-57d9-825a-216db2bab95b" :question/math-academy-id "q-208784" :question/problem "What is the solution to the following system of inequalities?\n\n$$\n\\{\\begin{aligned}y-5\\le 2 \\\\ 2y+7>11\\end{aligned}\n$$\n\nThe solution is\n{{field-1}}{{field-2}}\n$y\\le $\n{{field-3}}." :question/worked-solution "To solve the system, we need to find the values of $y$ that satisfy both $y-5\\le 2$ and $2y+7>11$ simultaneously.\n\n- First, we solve $y-5\\le 2\\,:$\n\n$$\n\\begin{aligned}y-5 & \\le 2 \\\\ y-5+5 & \\le 2+5 \\\\ y & \\le 7\\end{aligned}\n$$\n\n![](images/b0/b0107bec7ccb2c56036de405a29870e8cfcc166cc6405f425fc3296ec8f1be2b.png)\n\n$$\n\n$$\n\n- Then, we solve $2y+7>11\\,:$\n\n$$\n\\begin{aligned}2y+7 & >11 \\\\ 2y+7-7 & >11-7 \\\\ 2y & >4 \\\\ \\frac{2y}{2} & >\\frac{4}{2} \\\\ y & >2\\end{aligned}\n$$\n\n![](images/59/59523e51144ef776295ec43032def1bc0192351deb6294fbb2d56acd87bb2cac.png)\n\n$$\n\n$$\n\nTo find the values of $y$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/98/981477f5336b96998b61b7ab18647609cb33c12984c14049621ac15c698c25a5.png)\n\n \n\n$$\n\n$$\n\nThus, the final solution is $2<y\\le 7.$"} :step/id #uuid "c706594b-42c2-5706-a6e2-8d898feb9c13"} {:db/id #edb/ref 17592186567150 :step/content {:db/id #edb/ref 17592186567048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09f83060-457e-51bb-a48c-880d80b51fa1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (0,3)" :db/id #edb/ref 17592186566384} {:answer/id #uuid "2c7f2bd0-2eb9-577c-8ebe-c9c59314df42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (3,2]" :db/id #edb/ref 17592186566454} {:answer/id #uuid "62a7710c-4104-514f-9c9a-a23045e79c8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in [-3,1)" :db/id #edb/ref 17592186566553} {:answer/id #uuid "941d31e7-a180-5faa-b9a0-cad9aa59b9a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (1,3]" :db/id #edb/ref 17592186566652} {:answer/id #uuid "c2287c90-b752-5994-8a09-4fd688b59847" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There is no solution" :db/id #edb/ref 17592186566747}] :answer-field/correct {:db/id #edb/ref 17592186566652} :answer-field/id #uuid "1afdbe50-eaa8-50d5-ae52-c02ad59c8fa8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566889}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6919ce13-e2d9-594d-bb7b-2bdd566b01d1" :question/math-academy-id "q-156128" :question/problem "Find the set of values of $x$ that satisfy $1<2x-1\\le 5$ and $1-2x\\le 3.$" :question/worked-solution "To solve compound \"and\" inequalities, we solve each inequality separately and then find their intersection.\n\n- First, we solve $1<2x-1\\le 5\\,:$\n\n$$\n\\begin{aligned}1 & <2x-1\\le 5 \\\\ 1+1 & <2x-1+1\\le 5+1 \\\\ 2 & <2x\\le 6 \\\\ \\frac{2}{2} & <\\frac{2x}{2}\\le \\frac{6}{2} \\\\ 1 & <x\\le 3\\end{aligned}\n$$\n\n![](images/2b/2b111554de3019b78a3d6e8992477bb1401a53d7c2bbe09a6407e675b8d06daa.png)\n\n- Then, we solve  $1-2x\\le 3\\,:$\n\n$$\n\\begin{aligned}1-2x & \\le 3 \\\\ 1-2x-1 & \\le 3-1 \\\\ -2x & \\le 2 \\\\ (-1)\\cdot (-2x) & \\ge (-1)\\cdot 2 \\\\ 2x & \\ge -2 \\\\ \\frac{2x}{2} & \\ge \\frac{-2}{2} \\\\ x & \\ge -1\\end{aligned}\n$$\n\n![](images/ca/ca4d8a229772ec9d22a45c99cdad22379b6b55aa5d6fe4bb6288fe66d8c5696a.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/74/74cc11cbd20e5b82171d4c89407f24eb6f60ee558bf41a313009839c6f885f7e.png)\n\n \n\n$$\n\n$$\n\nThus, the final solution is $x\\in (1,3].$"} :step/id #uuid "ddff42aa-f427-5cc0-ac91-0c80184cf30e" :step/next {:db/id #edb/ref 17592186567146}}] :activity/title "Compound AND Inequalities" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186566359}]}
