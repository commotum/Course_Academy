#{[{:activity/first-step {:db/id #edb/ref 17592186079288} :activity/id #uuid "a7455b77-2b32-5022-8104-55f7d28d3665" :activity/scope {:db/id #edb/ref 17592186049579 :topic/id #uuid "01b16520-9a60-5cca-93f8-78c461d28525" :topic/math-academy-id 667} :activity/steps [{:db/id #edb/ref 17592186079288 :step/content {:db/id #edb/ref 17592186079726 :tutorial/content "Consider the following sequence:\n$1,\\quad 3,\\quad 5,\\quad 7,\\quad 9,\\quad \\ldots$\nNotice that the difference (or \"jump\") between two consecutive numbers is always the same.\n\n![](images/5a/5a4433d95492b9895793bc497fce887e3a39986a4f0c686ebe8a5d9b54d4f3dc.png)\n\nA sequence where the jump never changes is called an **arithmetic sequence.**\n\nWe call this jump the **common difference**, and represent it using the letter $d$. In this particular case, the common difference is $d=2$." :tutorial/id #uuid "134e25b5-1134-520f-9bd7-cc4176f2fed8" :tutorial/math-academy-id 8907 :tutorial/title "Introduction"} :step/id #uuid "77248861-cfe7-52c2-a064-19e52e2c8319" :step/math-academy-id 147303 :step/next {:db/id #edb/ref 17592186079289}} {:db/id #edb/ref 17592186079289 :step/content {:db/id #edb/ref 17592186078420 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078194 :question/id #uuid "ae7753b6-b58d-57c5-849e-c887e7d1601e" :question/math-academy-id "e-14731"} :knowledge-point/id #uuid "ac161f82-668f-5e67-b8d8-c2f6a438c7a8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050652}] :knowledge-point/questions [{:db/id #edb/ref 17592186078776} {:db/id #edb/ref 17592186078785} {:db/id #edb/ref 17592186078884}] :knowledge-point/title "Finding a Common Difference"} :step/id #uuid "74f48168-99d1-5fe5-b8e4-1ba057d4761b" :step/math-academy-id 147304 :step/next {:db/id #edb/ref 17592186079290}} {:db/id #edb/ref 17592186079290 :step/content {:db/id #edb/ref 17592186078421 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078179 :question/id #uuid "eba75ca0-7f78-531f-96c4-b772b5785828" :quest