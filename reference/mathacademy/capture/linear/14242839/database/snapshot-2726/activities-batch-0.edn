#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186111570} :activity/id #uuid "2f208fe4-4dfa-59da-beb3-a92d28a94643" :activity/scope {:db/id #edb/ref 17592186048633 :topic/id #uuid "b0558a05-99d7-5f39-86c1-1a6b7dbc9ea2" :topic/math-academy-id 1467} :activity/steps [{:db/id #edb/ref 17592186111570 :step/content {:db/id #edb/ref 17592186111891 :tutorial/content "Suppose that we have a cube whose edges are $2\\,\\textrm{cm}$ in length, like the one shown below. \n\n![](images/b9/b974b6e782801fbe2099971afd0df9a5c6e05a10afc2ce0e4054c850088e753b.png)\n\nThe formula for the volume $V$ of a cube with sides of length $s$ is given by\n\n$$\nV = s^3.\n$$\n\nTo find the volume of this cube, we substitute $s=2 \\: \\textrm{cm}$ into the formula. This gives\n\n$$\nV = (2\\, \\textrm{cm})^3 = 8 \\text{ cm}^3 .\n$$\n\nSo the volume of the cube is $8\\,\\textrm{cm}^3.$" :tutorial/id #uuid "7ebfe2f1-6dce-5f67-bf2d-58fcd1660014" :tutorial/math-academy-id 4348 :tutorial/title "Introduction"} :step/id #uuid "d46d4eea-b1b4-5c23-ad6c-8c42f031b1e2" :step/math-academy-id 26435 :step/next {:db/id #edb/ref 17592186111571}} {:db/id #edb/ref 17592186111571 :step/content {:db/id #edb/ref 17592186110644 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110519 :question/id #uuid "333792dd-67b0-5673-821a-304ad5011c62" :question/math-academy-id "e-7177"} :knowledge-point/id #uuid "a444c03b-ed56-5331-90c0-40bd2001f980" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051057}] :knowledge-point/questions [{:db/id #edb/ref 17592186110884} {:db/id #edb/ref 17592186111402} {:db/id #edb/ref 17592186538928} {:db/id #edb/ref 17592186538957} {:db/id #edb/ref 17592186538978} {:db/id #edb/ref 17592186539030}] :knowledge-point/title "Calculating the Volume of a Cube"} :step/id #uuid "20770c24-a658-5103-b267-96d9f7e29f57" :step/math-academy-id 26436 :step/next {:db/id #edb/ref 17592186111572}} {:db/id #edb/ref 17592186111572 :step/content {:db/id #edb/ref 1759