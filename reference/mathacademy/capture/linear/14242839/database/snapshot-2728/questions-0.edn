"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "087adab2-ea54-569c-8686-59d39bb1e022" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50\\,{\\text{ft}}^{3}" :db/id #edb/ref 17592186538253} {:answer/id #uuid "11990872-3a08-59a2-ae15-43f9da89dfd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "175\\,{\\text{ft}}^{3}" :db/id #edb/ref 17592186538273} {:answer/id #uuid "3ffb3373-35a3-5250-ada2-c24c626269af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25\\,{\\text{ft}}^{3}" :db/id #edb/ref 17592186538363} {:answer/id #uuid "67feacb2-a15e-5e1a-b7b8-79bd8e12be90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "75\\,{\\text{ft}}^{3}" :db/id #edb/ref 17592186538464} {:answer/id #uuid "d3e97164-f1d9-5bb8-a576-332346139f1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "125\\,{\\text{ft}}^{3}" :db/id #edb/ref 17592186538723}] :answer-field/correct {:answer/id #uuid "d3e97164-f1d9-5bb8-a576-332346139f1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "125\\,{\\text{ft}}^{3}" :db/id #edb/ref 17592186538723} :answer-field/id #uuid "eea170cf-041d-5502-8a64-b7754c482b33" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538916}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "db058a82-1fa2-5274-82e0-1236f8c5f86e" :question/math-academy-id "q-107284" :question/problem "A statue is mounted on a pedestal consisting of a cubic block made of concrete. \nEach side of the cube has length  $5\\,\\text{ft}.$ \nWhat is the volume of the cube?" :question/worked-solution "We need to find the volume of a cube.\n\nThe volume $V$ of a cube can be found using the formula\n\n$$\nV={s}^{3},\n$$\n\nwhere $s$ is the side length of the cube.\n\nSubstituting $s=5\\,\\text{ft}$ into the formula, we get \n\n$$\nV={(5\\,\\text{ft})}^{3}=125\\,{\\text{ft}}^{3}.\n$$\n\nTherefore, the volume of the pedestal is $125\\,{\\text{ft}}^{3}.$"}]}
