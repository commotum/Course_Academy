#{[{:db/id #edb/ref 17592186110519 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110644 :knowledge-point/id #uuid "a444c03b-ed56-5331-90c0-40bd2001f980" :knowledge-point/title "Calculating the Volume of a Cube"}] :question/id #uuid "333792dd-67b0-5673-821a-304ad5011c62" :question/math-academy-id "e-7177" :question/problem "![](images/3f/3f3ac69cc09fd70f0cbcd67e4b6b64ca1a364be471fda6ccb3a9e42bb991e44c.png)\n\nWhat is the volume of the cube?" :question/worked-solution "The volume $V$ of a cube can be found using the formula\n\n$$\nV = s^3,\n$$\n\nwhere $s$ is the side length of the cube.\n\nSubstituting $s=4\\,\\textrm{cm}$ into the formula, we get \n\n$$\nV = (4\\, \\textrm{cm})^3 = 64\\, \\textrm{cm}^3 .\n$$"}] [{:db/id #edb/ref 17592186110520 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110645 :knowledge-point/id #uuid "a98962c0-8e7b-57d7-997f-0369e2991802" :knowledge-point/title "Finding a Side Length of a Cube Given Its Volume"}] :question/id #uuid "0d03e2bd-c8a2-5a16-a5b2-b51dbf9e408a" :question/math-academy-id "e-7178" :question/problem "The volume of a cube is $729\\, \\textrm{cm}^3.$ Find the length of the edges of the cube." :question/worked-solution "Since the volume of a cube is \n\n$$\nV = s^3,\n$$\n\nwhere $s$ is the length of an edge, we can find $s$ as follows:\n\n$$\ns = \\sqrt[3]{V} =  \\sqrt[3]{729} = 9\n$$\n\nTherefore, the length of the edges is $9\\,\\textrm{cm}.$"}] [{:db/id #edb/ref 17592186110539 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110655 :knowledge-point/id #uuid "cca7a0b2-c939-52cc-9ca0-0b90e5590375" :knowledge-point/title "The Volume of a Cube: Word Problems"}] :question/id #uuid "f265fcf1-8d50-5908-8df4-6df66cb0673a" :question/math-academy-id "e-8977" :question/problem "Six identical plastic cubic containers have a combined volume of $48 \\: \\textrm{ft}^3.$ Find the side length of a single container." :question/worked-solution "First, we find the volume of a single container: \n\n$$\n\\dfrac{48 \\: \\textrm{ft}^3}{6} = 8 \\: \\textrm{ft}^3\n$$\n\nNow, we need to find the side length of one container. \n\nSince the volume of a cube is \n\n$$\nV = s^3,\n$$\n\nwhere $s$ is the length of a side, we can find $s$ as follows:\n\n$$\ns = \\sqrt[3]{V} = \\sqrt[3]{8} = 2\n$$\n\nTherefore, the length of a side of a single container is $2\\,\\textrm{ft}.$"}] [{:db/id #edb/ref 17592186110884 :knowledge-point/_questions [{:db/id #edb/ref 17592186110644 :knowledge-point/id #uuid "a444c03b-ed56-5331-90c0-40bd2001f980" :knowledge-point/title "Calculating the Volume of a Cube"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31626a0e-aab5-5d42-8b93-0858fada7bd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\,{\\text{in}}^{3}" :db/id #edb/ref 17592186538332} {:answer/id #uuid "37f47b20-4d43-5305-b972-ae087cee5b58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "400\\,{\\text{in}}^{3}" :db/id #edb/ref 17592186538347} {:answer/id #uuid "4c31a160-6ce3-5587-b438-de573f586612" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4000\\,{\\text{in}}^{3}" :db/id #edb/ref 17592186538390} {:answer/id #uuid "53db9985-573d-565e-8f90-e4c43990ceb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64\\,{\\text{in}}^{3}" :db/id #edb/ref 17592186538413} {:answer/id #uuid "e15a41f1-aadc-5b22-ad53-036cd98402f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24\\,{\\text{in}}^{3}" :db/id #edb/ref 17592186538748}] :answer-field/correct {:answer/id #uuid "53db9985-573d-565e-8f90-e4c43990ceb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64\\,{\\text{in}}^{3}" :db/id #edb/ref 17592186538413} :answer-field/id #uuid "0d0f2305-80f2-5165-81bc-14e814122e4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186107195}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6c758199-4cfb-5d27-aa04-39e26323982d" :question/math-academy-id "q-107177" :question/problem "Find the volume of the cube whose sides each have length $4\\,\\text{in}.$" :question/worked-solution "The volume $V$ of a cube can be found using the formula\n\n$$\nV={s}^{3},\n$$\n\nwhere $s$ is the side length of the cube.\n\nSubstituting $s=4\\,\\text{in}$ into the formula, we get \n\n$$\nV=(4\\,\\text{in})^{3}=64\\,{\\text{in}}^{3}.\n$$"}] [{:db/id #edb/ref 17592186110886 :knowledge-point/_questions [{:db/id #edb/ref 17592186110655 :knowledge-point/id #uuid "cca7a0b2-c939-52cc-9ca0-0b90e5590375" :knowledge-point/title "The Volume of a Cube: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3552d374-b6a6-5cb4-826e-cd13b7f14a9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,{\\text{in}}^{3}" :db/id #edb/ref 17592186538340} {:answer/id #uuid "670a339f-913d-513b-a28e-c0591f8a972c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\,{\\text{in}}^{3}" :db/id #edb/ref 17592186538463} {:answer/id #uuid "9187f610-fc78-5c7d-965c-d456b5009a1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\,{\\text{in}}^{3}" :db/id #edb/ref 17592186538572} {:answer/id #uuid "c5dbfb27-e377-512a-bccd-c5fa883f50ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,{\\text{in}}^{3}" :db/id #edb/ref 17592186538694} {:answer/id #uuid "d1e17d0a-e9dc-5739-a2dd-6a5048e38238" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}\\,{\\text{in}}^{3}" :db/id #edb/ref 17592186538719}] :answer-field/correct {:answer/id #uuid "d1e17d0a-e9dc-5739-a2dd-6a5048e38238" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}\\,{\\text{in}}^{3}" :db/id #edb/ref 17592186538719} :answer-field/id #uuid "d815bdfe-3b85-52ea-b85b-33c78a779416" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186107207}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cbad5129-59ce-5340-bc33-2a0337860de0" :question/math-academy-id "q-107179" :question/problem "Each side of an ice cube has length $\\frac{1}{2}\\,\\text{in}.$ What is the volume of the ice cube?" :question/worked-solution "We need to find the volume of a cube.\n\nThe volume $V$ of a cube can be found using the formula\n\n$$\nV={s}^{3},\n$$\n\nwhere $s$ is the side length of the cube.\n\nSubstituting $s=\\frac{1}{2}\\,\\text{in}$ into the formula, we get \n\n$$\nV={(\\frac{1}{2}\\,\\text{in})}^{3}=\\frac{1}{8}\\,{\\text{in}}^{3}.\n$$\n\nTherefore, the volume of the ice cube is $\\frac{1}{8}\\,{\\text{in}}^{3}.$"}] [{:db/id #edb/ref 17592186539021 :knowledge-point/_questions [{:db/id #edb/ref 17592186110645 :knowledge-point/id #uuid "a98962c0-8e7b-57d7-997f-0369e2991802" :knowledge-point/title "Finding a Side Length of a Cube Given Its Volume"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10797193-4d5a-5eb2-b8ab-f500f80a2dbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "33\\,\\text{in}" :db/id #edb/ref 17592186538272} {:answer/id #uuid "66826bde-4a93-540b-9bfe-af16c0f072b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30\\,\\text{in}" :db/id #edb/ref 17592186538460} {:answer/id #uuid "87862595-ce7d-55de-becc-829990b1858c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100\\,\\text{in}" :db/id #edb/ref 17592186538544} {:answer/id #uuid "936e2beb-2243-51a3-aa04-77ffd76bac7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "333\\,\\text{in}" :db/id #edb/ref 17592186538579} {:answer/id #uuid "ab61b803-9b05-5d09-9374-a5ee392559df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,\\text{in}" :db/id #edb/ref 17592186538634}] :answer-field/correct {:answer/id #uuid "ab61b803-9b05-5d09-9374-a5ee392559df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,\\text{in}" :db/id #edb/ref 17592186538634} :answer-field/id #uuid "dbc21fde-086b-5544-b142-26aef452c513" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538905}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e83a5e5d-4e50-55da-82b2-166ada387fd5" :question/math-academy-id "q-107263" :question/problem "![](images/3e/3ebe2e4b3436088aa5385757492a8a1f27add8927ea30de71a32a6dc596083cd.png)\n\nThe volume of the cube above is $1\\,000\\,{\\text{in}}^{3}.$ What is the length of its sides?" :question/worked-solution "Since the volume of a cube is \n\n$$\nV={s}^{3},\n$$\n\nwhere $s$ is the length of a side, we can find $s$ as follows:\n\n$$\ns=\\sqrt[3]{V}=\\sqrt[3]{1\\,000}=10\n$$\n\nTherefore, the length of a side is $10\\,\\text{in}.$"}] [{:db/id #edb/ref 17592186538943 :knowledge-point/_questions [{:db/id #edb/ref 17592186110645 :knowledge-point/id #uuid "a98962c0-8e7b-57d7-997f-0369e2991802" :knowledge-point/title "Finding a Side Length of a Cube Given Its Volume"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "422a53c2-d969-5a26-977a-6a73807dc3c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\,\\text{cm}" :db/id #edb/ref 17592186538367} {:answer/id #uuid "49866016-13ee-5c4a-afa8-e772cf299923" :answer/typ