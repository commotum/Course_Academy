#{[{:db/id #edb/ref 17592186073620 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073680 :knowledge-point/id #uuid "c16dc76e-e756-5f66-9453-ba88b3f37f67" :knowledge-point/title "Finding a Trigonometric Ratio"}] :question/id #uuid "2b0df0b9-3484-5408-aadc-01e756c43de7" :question/math-academy-id "e-3315" :question/problem "Given that $x=0.3$ radians, what is $\\sin{x}$ rounded to $3$ decimal places?" :question/worked-solution "Note the argument of the sine is given in radians. Using a calculator in \"radians\" mode, we obtain\n\n$$\n\\sin(0.3) = 0.295\\,520\\ldots \\approx 0.296\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186073621 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073681 :knowledge-point/id #uuid "3a2e44aa-d511-5bb4-bfe3-3213d7df0f1a" :knowledge-point/title "Finding a Trigonometric Ratio of an Acute Special Angle"}] :question/id #uuid "b9829363-8cde-55fb-a1de-b6460ef451a1" :question/math-academy-id "e-3317" :question/problem "Evaluate $\\sin \\left(\\dfrac{\\pi}{6}\\right)$ by converting the angle to degrees." :question/worked-solution "First, we convert\n\n$$\n\\dfrac{\\pi}{6}\n$$\n\nradians to an equivalent measure in degrees. This gives\n\n$$\n\\left(\\dfrac{\\pi} 6\\right) \\left(\\dfrac {180^\\circ} {\\pi}\\right) = \\dfrac {180^\\circ} {6} = 30^\\circ\n$$\n\nTherefore,\n\n$$\n\\sin \\left(\\dfrac{\\pi}{6}\\right) = \\sin 30^\\circ\n$$\n\nFinally, since we know that\n\n$$\n\\sin 30^\\circ = \\dfrac{1}{2}\n$$\n\nwe obtain\n\n$$\n\\sin\\left(\\dfrac{\\pi}{6}\\right) = \\dfrac{1}{2}\n$$"}] [{:db/id #edb/ref 17592186073622 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073682 :knowledge-point/id #uuid "c2439bd5-8e25-5e4f-b852-72cabeeb440f" :knowledge-point/title "Finding an Inverse Trigonometric Ratio"}] :question/id #uuid "55d74eac-00aa-54cc-8e1f-743e053cc599" :question/math-academy-id "e-3318" :question/problem "Rounded to three decimal places, what is $\\arcsin(0.75)$ in radians?" :question/worked-solution "Note that we need the answer in radians. Using a calculator in \"radians\" mode, we obtain\n\n$$\n\\arcsin(0.75) = 0.848\\,062\\ldots \\approx 0.848 \\, \\textrm{radians}\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186073623 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073683 :knowledge-point/id #uuid "ce9c6436-70ed-5b95-b336-b40f0931f825" :knowledge-point/title "Identifying True Statements"}] :question/id #uuid "7eadc0f5-b50a-5e8e-9706-7f4fe0554abf" :question/math-academy-id "e-3319" :question/problem "Is the following statement true or false?\n\n$\\sin30^\\circ \\:\\overset{\\large\\color{red}?}{=}\\: \\sin \\left(\\dfrac16 \\right)$." :question/worked-solution "The statement is false. Converting $30^\\circ$ from degrees to radians, we get\n\n$$\n30^\\circ= 30\\cdot \\dfrac{\\pi}{180} = \\dfrac{\\pi}{6} \\, \\textrm{radians}\n$$\n\nThe statement is false because\n\n$$\n\\dfrac{\\pi}{6} \\neq \\dfrac{1}6\n$$"}] [{:db/id #edb/ref 17592186074263 :knowledge-point/_questions [{:db/id #edb/ref 17592186073681 :knowledge-point/id #uuid "3a2e44aa-d511-5bb4-bfe3-3213d7df0f1a" :knowledge-point/title "Finding a Trigonometric Ratio of an Acute Special Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "819902c3-0b4c-5fe3-8521-1feb1f1898c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186071817} {:answer/id #uuid "839d15c6-6d7c-56ff-8881-c319c5591795" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186071818} {:answer/id #uuid "9264484d-8af9-5098-9c32-2cb2d1800d45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186071819} {:answer/id #uuid "f99ccf96-680a-5706-8358-6370757366d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186071820} {:answer/id #uuid "607426dd-b178-50a9-88aa-a314d7b6e7f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186071821}] :answer-field/id #uuid "26c10b88-71f5-5390-8e7b-29b04e15ed55" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186071816}] :question/id #uuid "7f010bc2-8739-563b-8590-b9a0b63c41ca" :question/math-academy-id "q-54384" :question/problem "What is $\\tan (\\frac{π}{4})$?"}]}
