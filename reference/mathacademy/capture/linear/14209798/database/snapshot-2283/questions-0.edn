Finding a Trigonometric Ratio of an Acute Special Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ffe8b5a-89d1-5cc4-a628-30dfce5ca486" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186520798} {:answer/id #uuid "1d6158b8-7fa1-5374-8102-b315d5ee7d9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186520827} {:answer/id #uuid "4c55ebeb-7cce-5cfe-953e-91fd1d9a3ec2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186520938} {:answer/id #uuid "d4266c13-546a-5d43-a39f-e09844714267" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186521240} {:answer/id #uuid "f3400f05-0efd-579c-9c4d-2bee0c52b9db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186521297}] :answer-field/correct {:answer/id #uuid "4c55ebeb-7cce-5cfe-953e-91fd1d9a3ec2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186520938} :answer-field/id #uuid "716b3e70-e198-5303-8455-9f55371b225a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521376}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "934b60d8-f889-5c91-8ad2-ede254ef4d64" :question/math-academy-id "q-54418" :question/problem "$\\operatorname{sec}⁡(\\frac{\\pi }{4})=$" :question/worked-solution "First, we convert $\\frac{\\pi }{4}$ radians to an equivalent measure in degrees. This gives\n\n$$\n(\\frac{\\pi }{4})(\\frac{{180}^{∘}}{\\pi })=\\frac{{180}^{∘}}{4}={45}^{∘}.\n$$\n\nTherefore, \n\n$$\n\\operatorname{cos}⁡(\\frac{\\pi }{4})=\\operatorname{cos}⁡{45}^{∘}.\n$$\n\nFinally, since we know that $\\operatorname{cos}⁡{45}^{∘}=\\frac{\\sqrt{2}}{2},$ we obtain\n\n$$\n\\begin{aligned}\\operatorname{sec}⁡(\\frac{\\pi }{4}) & =\\frac{1}{\\operatorname{cos}⁡(\\frac{\\pi }{4})} \\\\  & =\\frac{1}{\\operatorname{cos}⁡{45}^{∘}} \\\\  & =\\frac{1}{(\\frac{\\sqrt{2}}{2})} \\\\  & =\\frac{2}{\\sqrt{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521505 :knowledge-point/_questions [{:db/id #edb/ref 17592186073680 :knowledge-point/id #uuid "c16dc76e-e756-5f66-9453-ba88b3f37f67" :knowledge-point/title "Finding a Trigonometric Ratio"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66c48990-e29d-5593-b0be-dcf7bafc7d96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.851" :db/id #edb/ref 17592186520999} {:answer/id #uuid "84c87610-af2e-5130-bef1-8d066bc35df1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.139" :db/id #edb/ref 17592186521066} {:answer/id #uuid "84e539ac-90b0-54ca-bd6a-bd4374e65694" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.435" :db/id #edb/ref 17592186521068} {:answer/id #uuid "88726f67-eb92-5029-aadc-62da88e17614" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.697" :db/id #edb/ref 17592186521076} {:answer/id #uuid "c564d4e6-6829-5a1d-bab0-a8e3e707ce1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.540" :db/id #edb/ref 17592186521203}] :answer-field/correct {:answer/id #uuid "66c48990-e29d-5593-b0be-dcf7bafc7d96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.851" :db/id #edb/ref 17592186520999} :answer-field/id #uuid "7b4090a0-7a08-51d1-b5a5-110eef823f48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186