#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186079582} :activity/id #uuid "4d01100d-d331-5eab-a7b4-b31a3dd20fff" :activity/scope {:db/id #edb/ref 17592186049018 :topic/id #uuid "d44527c5-267a-5fa9-99b7-8ab45e08d4b9" :topic/math-academy-id 645} :activity/steps [{:db/id #edb/ref 17592186079582 :step/content {:db/id #edb/ref 17592186079711 :tutorial/content "The **coefficient** of a term is the number part of a term, including its sign. For instance, the coefficient of $3x$ is $3$, and the coefficient of $-5x$ is $-5.$ \n\nEvery term has a coefficient, even if it has no numerical part. For example:\n\n- The coefficient of $y$ is $1$ because $y$ is equivalent to $1y.$\n\n- The coefficient of $-z$ is $-1$ because $-z$ is equivalent to $-1z.$" :tutorial/id #uuid "0dd14810-5f7c-5799-b9f4-138d8de00b2e" :tutorial/math-academy-id 8032 :tutorial/title "Introduction"} :step/id #uuid "89085689-0df1-52dd-9e7f-3e0a74616260" :step/math-academy-id 71803 :step/next {:db/id #edb/ref 17592186079583}} {:db/id #edb/ref 17592186079583 :step/content {:db/id #edb/ref 17592186078609 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078154 :question/id #uuid "16d88557-c94b-5666-a86b-ed241e6b106e" :question/math-academy-id "e-12819"} :knowledge-point/id #uuid "33ebbaee-ad49-50c1-8973-c447756e0109" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050306}] :knowledge-point/questions [{:db/id #edb/ref 17592186078903} {:db/id #edb/ref 17592186078917} {:db/id #edb/ref 17592186079041} {:db/id #edb/ref 17592186444758} {:db/id #edb/ref 17592186444764} {:db/id #edb/ref 17592186444765} {:db/id #edb/ref 17592186444767}] :knowledge-point/title "Listing the Coefficients of an Expression"} :step/id #uuid "de9c0669-77d2-57ee-b99f-30a863da9b1e" :step/math-academy-id 71804 :step/next {:db/id #edb/ref 17592186079584}} {:db/id #edb/ref 17592186079584 :step/content {:db/id #edb/ref 17592186078610 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078161 :question/id #uuid "c4668f0b-e26f-54d3-b1d2-e5ac6bb4efa5" :question/math-academy-id "e-12826"} :knowledge-point/id #uuid "64f7aa0b-533f-5141-bdec-5b053e7d8c6d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050637}] :knowledge-point/questions [{:db/id #edb/ref 17592186078715} {:db/id #edb/ref 17592186078755} {:db/id #edb/ref 17592186078916} {:db/id #edb/ref 17592186444761} {:db/id #edb/ref 17592186444762} {:db/id #edb/ref 17592186479074}] :knowledge-point/title "Listing Fractional Coefficients When the Variable is in a Numerator"} :step/id #uuid "0db80b9a-f601-5cec-9f17-f246ef2bf3ff" :step/math-academy-id 71808 :step/next {:db/id #edb/ref 17592186079585}} {:db/id #edb/ref 17592186079585 :step/content {:db/id #edb/ref 17592186079713 :tutorial/content "The **constant terms** of a linear expression are terms that contain no variables.\n\nFor example, in the expression\n\n$$\n3x + {\\color{blue}{2}} -3y +{\\color{blue}{9}},\n$$\n\nthe constant terms are ${\\color{blue}{2}}$ and ${\\color{blue}{9}}.$" :tutorial/id #uuid "275a2093-6068-5839-9c20-ef4db6931333" :tutorial/math-academy-id 8034 :tutorial/title "Constant Terms"} :step/id #uuid "e707b727-49f3-550b-b312-e84933e1d533" :step/math-academy-id 71812 :step/next {:db/id #edb/ref 17592186079586}} {:db/id #edb/ref 17592186079586 :step/content {:db/id #edb/ref 17592186078611 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078157 :question/id #uuid "e731b5e2-f04a-50b8-95fc-f708d76a5343" :question/math-academy-id "e-12821"} :knowledge-point/id #uuid "1b866c18-f3a0-599e-9bbb-970e0c79c585" :knowledge-point/questions [{:db/id #edb/ref 17592186078902} {:db/id #edb/ref 17592186079131} {:db/id #edb/ref 17592186079202} {:db/id #edb/ref 17592186444759} {:db/id #edb/ref 17592186444763} {:db/id #edb/ref 17592186444766} {:db/id #edb/ref 17592186444768} {:db/id #edb/ref 17592186444769}] :knowledge-point/title "Identifying the Constant Term of an Expression"} :step/id #uuid "e55cd1ca-93bc-53ba-a4f9-eb66f141140e" :step/math-academy-id 71813 :step/next {:db/id #edb/ref 17592186079587}} {:db/id #edb/ref 17592186079587 :step/content {:db/id #edb/ref 17592186079712 :tutorial/content "*If a variable is missing from an expression, then its coefficient is zero.* For example, in the expression $a+2b,$ the coefficient of $z$ is $0$ because $z$ does not appear in the expression.\n\nTo understand why the coefficient of a missing variable is always zero, remember the following:\n\n1\\. Zero times any number (or variable) is zero. So $0z$ is equal to $0.$\n\n2\\. Adding zero to an expression does not change the expression. So $a+2b$ is equal to $a+2b+0.$\n\nThus, we can rewrite $a+2b$ as \n\n$$\na+2b+0,\n$$\n\n and we can replace $0$ with $0z$ to get: \n\n$$\na+2b+0z\n$$\n\n \n\nNow, we see that the coefficient of $z$ is $0.$" :tutorial/id #uuid "ffa9a201-1851-51f6-b698-789b2379db46" :tutorial/math-academy-id 8033 :tutorial/title "Zero Coefficients"} :step/id #uuid "c67b45cb-0a77-5d83-9382-097fdca782c2" :step/math-academy-id 71817 :step/next {:db/id #edb/ref 17592186079588}} {:db/id #edb/ref 17592186079588 :step/content {:db/id #edb/ref 17592186078612 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078156 :question/id #uuid "ab3ecbe1-5cfd-54e8-b380-6f76b28ae757" :question/math-academy-id "e-12820"} :knowledge-point/id #uuid "444bd7e6-ade1-5ac7-8e53-d4b0735f93fb" :knowledge-point/questions [{:db/id #edb/ref 17592186079130} {:db/id #edb/ref 17592186079132} {:db/id #edb/ref 17592186444760} {:db/id #edb/ref 17592186444770} {:db/id #edb/ref 17592186479140}] :knowledge-point/title "Identifying the Missing Constant or the Coefficient of a Missing Variable"} :step/id #uuid "7e3d901b-ebef-5706-a523-9ff999c35440" :step/math-academy-id 71818}] :activity/title "Identifying Coefficients and Constants" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078667}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186479148} :activity/id #uuid "b0b34d2e-4883-5737-85a2-37f53a7c5534" :activity/scope {:db/id #edb/ref 17592186049018 :topic/id #uuid "d44527c5-267a-5fa9-99b7-8ab45e08d4b9" :topic/math-academy-id 645} :activity/steps [{:db/id #edb/ref 17592186479147 :step/content {:db/id #edb/ref 17592186479074 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2d5a746-cbe2-5c4e-8250-a72bbefe43f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{7}" :db/id #edb/ref 17592186478849}] :answer-field/correct {:db/id #edb/ref 17592186478849} :answer-field/id #uuid "331590f2-60f5-540b-bbc5-f95dc66e46bb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186478976}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2e46b72d-8394-58eb-a628-c7c43d6a0834" :question/math-academy-id "q-175333" :question/problem "The coefficient of $w$ in the expression  $\\frac{x}{3}-\\frac{y}{2}+\\frac{4w}{7}$ is{{field-1}}." :question/worked-solution "The expression has three terms:\n\n$$\n\\frac{x}{3}\\,,\\,-\\frac{y}{2}\\,,\\,\\frac{4w}{7}\n$$\n\nThe only term with the variable $w$ is $\\frac{4w}{7},$ so $\\frac{4}{7}$ is the coefficient of $w.$"} :step/id #uuid "02e66efd-e8b4-5902-a4a9-8d1f150d690c"} {:db/id #edb/ref 17592186479148 :step/content {:db/id #edb/ref 17592186078916 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0903e3e-77fb-5018-ad37-2dd943695068" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{y}{2}" :db/id #edb/ref 17592186076275} {:answer/id #uuid "b3c1f12b-65b3-5e6b-b7bc-56adb44622bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{8}" :db/id #edb/ref 17592186076276} {:answer/id #uuid "d9cdee4e-2c70-5cbe-a18d-a96b25e57c9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186076277} {:answer/id #uuid "07d20f41-d333-53d7-b27e-a9610ba85080" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3y}{4}" :db/id #edb/ref 17592186076278} {:answer/id #uuid "78568bda-ae2a-53bc-bc27-2c7f33d28f3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186076279}] :answer-field/correct {:db/id #edb/ref 17592186076277} :answer-field/id #uuid "c343a50f-a150-5152-98ab-d1462c81b537" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186076274}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5fdf9d3f-882e-5327-869d-96a6a9c4c1cd" :question/math-academy-id "q-44237" :question/problem "What is the coefficient of $y$ in the expression $\\frac{x}{2}-\\frac{3y}{4}+\\frac{11z}{8}?$" :question/worked-solution "The expression has three terms: \n\n$$\n\\frac{x}{2},\\,-\\frac{3y}{4},\\,\\frac{11z}{8}\n$$\n\n \n\nThe only term with the variable $y$ is $-\\frac{3y}{4},$ so $-\\frac{3}{4}$ is the coefficient of $y.$"} :step/id #uuid "0c0a5827-c676-5c46-9702-6937639a0c10" :step/next {:db/id #edb/ref 17592186479159}} {:db/id #edb/ref 17592186479159 :step/content {:db/id #edb/ref 17592186479140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0697dad3-46f6-5d10-89fa-4c837a032b92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186478569} {:answer/id #uuid "291f869a-c46d-58d4-8cdf-867a6f38c27d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186478622} {:answer/id #uuid "5f26e716-5948-5421-bf61-bb04d45e2f23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186478695} {:answer/id #uuid "5fe20a50-b7a3-59fd-86d7-e3fdf07429c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186478697} {:answer/id #uuid "8ac1096e-c1ec-5138-80ca-f8a49701458c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186478778}] :answer-field/correct {:db/id #edb/ref 17592186478778} :answer-field/id #uuid "ec89f1b4-7246-58b6-b78e-5814d0d13e49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186479051}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e9e375f3-04e5-5e92-84aa-677faf38ae91" :question/math-academy-id "q-67059" :question/problem "What is the coefficient of $a$ in the expression $6x-2y-7z?$" :question/worked-solution "We can rewrite the expression $6x-2y-7z$ as\n\n$$\n6x-2y-7z+0,\n$$\n\nand we can replace $0$ with $0a$ to get\n\n$$\n6x-2y-7z+0a.\n$$\n\nWe see that the coefficient of $a$ is $0.$"} :step/id #uuid "ffddaf4b-92f4-5adb-85c4-7ea2685659ca" :step/next {:db/id #edb/ref 17592186479147}}] :activity/title "Identifying Coefficients and Constants" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186478560}]}
