#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186479148} :activity/id #uuid "b0b34d2e-4883-5737-85a2-37f53a7c5534" :activity/scope {:db/id #edb/ref 17592186049018 :topic/id #uuid "d44527c5-267a-5fa9-99b7-8ab45e08d4b9" :topic/math-academy-id 645} :activity/steps [{:db/id #edb/ref 17592186479147 :step/content {:db/id #edb/ref 17592186479074 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2d5a746-cbe2-5c4e-8250-a72bbefe43f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{7}" :db/id #edb/ref 17592186478849}] :answer-field/correct {:db/id #edb/ref 17592186478849} :answer-field/id #uuid "331590f2-60f5-540b-bbc5-f95dc66e46bb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186478976}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2e46b72d-8394-58eb-a628-c7c43d6a0834" :question/math-academy-id "q-175333" :question/problem "The coefficient of $w$ in the expression  $\\frac{x}{3}-\\frac{y}{2}+\\frac{4w}{7}$ is{{field-1}}." :question/worked-solution "The expression has three terms:\n\n$$\n\\frac{x}{3}\\,,\\,-\\frac{y}{2}\\,,\\,\\frac{4w}{7}\n$$\n\nThe only term with the variable $w$ is $\\frac{4w}{7},$ so $\\frac{4}{7}$ is the coefficient of $w.$"} :step/id #uuid "02e66efd-e8b4-5902-a4a9-8d1f150d690c"} {:db/id #edb/ref 17592186479148 :step/content {:db/id #edb/ref 17592186078916 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0903e3e-77fb-5018-ad37-2dd943695068" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{y}{2}" :db/id #edb/ref 17592186076275} {:answer/id #uuid "b3c1f12b-65b3-5e6b-b7bc-56adb44622bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{8}" :db/id #edb/ref 17592186076276} {:answer/id #uuid "d9cdee4e-2c70-5cbe-a18d-a96b25e57c9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 1759218