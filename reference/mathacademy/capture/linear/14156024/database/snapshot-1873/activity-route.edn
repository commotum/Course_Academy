045498} :answer/value "0" :db/id #edb/ref 17592186478778}] :answer-field/correct {:db/id #edb/ref 17592186478778} :answer-field/id #uuid "ec89f1b4-7246-58b6-b78e-5814d0d13e49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186479051}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e9e375f3-04e5-5e92-84aa-677faf38ae91" :question/math-academy-id "q-67059" :question/problem "What is the coefficient of $a$ in the expression $6x-2y-7z?$" :question/worked-solution "We can rewrite the expression $6x-2y-7z$ as\n\n$$\n6x-2y-7z+0,\n$$\n\nand we can replace $0$ with $0a$ to get\n\n$$\n6x-2y-7z+0a.\n$$\n\nWe see that the coefficient of $a$ is $0.$"} :step/id #uuid "ffddaf4b-92f4-5adb-85c4-7ea2685659ca" :step/next {:db/id #edb/ref 17592186479147}}] :activity/title "Identifying Coefficients and Constants" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186478560}]}
