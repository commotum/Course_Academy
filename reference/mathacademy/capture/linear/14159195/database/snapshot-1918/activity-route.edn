#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186483457} :activity/id #uuid "5fe34547-15c9-5b67-8853-ec0046fda80a" :activity/scope {:db/id #edb/ref 17592186048392 :topic/id #uuid "9b9bc1e8-8910-5e7b-b200-0bc492f56034" :topic/math-academy-id 3719} :activity/steps [{:db/id #edb/ref 17592186483446 :step/content {:db/id #edb/ref 17592186483354 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ee4d24e-23ef-5ad1-93ac-34b77b84473c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186483080}] :answer-field/correct {:db/id #edb/ref 17592186483080} :answer-field/id #uuid "b44317ba-2764-5aaf-a2ac-d25521c85278" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186483310}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2ad85a11-bba5-5fae-afa8-bc7f058da66c" :question/math-academy-id "q-173783" :question/problem "Expressed as an improper fraction in its simplest form,  $(-6)÷\\frac{12}{5}=${{field-1}}." :question/worked-solution "Dividing a negative number by a positive number gives a negative number. Hence, the result will be negative.\n\nTherefore, since \n\n$$\n6÷\\frac{12}{5}=\\frac{6\\times 5}{12}=\\frac{30}{12}=\\frac{5}{2},\n$$\n\nwe obtain\n\n$$\n(-6)÷\\frac{12}{5}=-\\frac{5}{2}.\n$$"} :step/id #uuid "2473d2dd-c36e-59cc-a24d-7cd36087675c"} {:db/id #edb/ref 17592186483457 :step/content {:db/id #edb/ref 17592186483358 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15ba5d73-cfbf-5d35-89f4-a709f6e9f4ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{9}{4}" :db/id #edb/ref 17592186482852} {:answer/id #uuid "2c669c68-aefe-5e7c-b2c5-c63d2b25d4ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186482885} {:answer/id #uuid "3c34cd61-57c9-53a6-a30c-553a2947ad18" :answer/type {:db/id #edb/ref 1759218