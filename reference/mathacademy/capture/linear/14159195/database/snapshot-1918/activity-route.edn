wer/value "\\frac{4}{3}" :db/id #edb/ref 17592186483154} {:answer/id #uuid "ce613343-8043-5bc1-ae12-aad3ccc46878" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186483158}] :answer-field/correct {:db/id #edb/ref 17592186483004} :answer-field/id #uuid "7774d184-d47b-5051-8e81-b32b977ef33a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186483285}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ab43471e-dafe-5dcf-b8bc-06037ed994ac" :question/math-academy-id "q-128062" :question/problem "Determine the value of $(-\\frac{1}{5})÷(-\\frac{3}{10}).$" :question/worked-solution "Dividing a negative number by a negative number gives a positive number. Hence, the result will be positive.\n\nTherefore, since \n\n$$\n\\frac{1}{5}÷\\frac{3}{10}=\\frac{1\\times 10}{5\\times 3}=\\frac{10}{15}=\\frac{2}{3},\n$$\n\nwe obtain\n\n$$\n(-\\frac{1}{5})÷(-\\frac{3}{10})=\\frac{2}{3}.\n$$"} :step/id #uuid "e5cfbbd4-d11e-5405-ba15-8c0b2976f8c2" :step/next {:db/id #edb/ref 17592186483446}}] :activity/title "Dividing With Negative Decimals and Fractions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186482805}]}
