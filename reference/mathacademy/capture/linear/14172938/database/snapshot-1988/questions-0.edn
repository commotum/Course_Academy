#{[{:db/id #edb/ref 17592186492897 :knowledge-point/_questions [{:db/id #edb/ref 17592186147415 :knowledge-point/id #uuid "40344731-b251-5ba9-8e05-775144455c95" :knowledge-point/title "Squaring a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d988b357-b43a-58eb-bbe9-becb7fce6217" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{64}{9}" :db/id #edb/ref 17592186492645}] :answer-field/correct {:answer/id #uuid "d988b357-b43a-58eb-bbe9-becb7fce6217" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{64}{9}" :db/id #edb/ref 17592186492645} :answer-field/id #uuid "5e0ef91f-d81a-563a-9329-dff79e2beb86" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186492742}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b192b645-98ae-5323-9ecd-f711bb8584a4" :question/math-academy-id "q-166825" :question/problem "Expressed as an improper fraction, Catherine has$\\,${{field-1}}\n$\\,$liters of alcohol." :question/worked-solution "The exact amount of alcohol is ${(\\frac{8}{3})}^{2}$ liters.\n\nWriting ${(\\frac{8}{3})}^{2}$ with multiplication signs, we get\n\n$$\n\\begin{aligned}{(\\frac{8}{3})}^{2} & ={{\\frac{8}{3}\\times \\frac{8}{3}}_{⏟}}_{2\\text{ times}} \\\\  & =\\frac{8\\times 8}{3\\times 3} \\\\  & =\\frac{64}{9}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{(\\frac{8}{3})}^{2}=\\frac{64}{9}.\n$$"}] [{:db/id #edb/ref 17592186492875 :knowledge-point/_questions [{:db/id #edb/ref 17592186054858 :knowledge-point/id #uuid "ef1ed47e-ac17-5e98-8f3c-ea15497f7ff7" :knowledge-point/title "Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53aee022-3b59-5fca-8c0b-6136d020e903" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.12" :db/id #edb/ref 17592186492376}] :answer-field/correct {:answer/id #uuid "53aee022-3b59-5fca-8c0b-6136d020e903" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.12" :db/id #edb/ref 17592186492376} :answer-field/id #uuid "f1df3b5d-0216-5c59-b5c2-2aefb3e2158a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186492811}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "74464983-3f15-5a8b-be45-9dcaca36d791" :question/math-academy-id "q-166826" :question/problem "To prepare an orange perfume, Catherine must use $0.2$ liters of orange essence for each liter of alcohol. How much orange essence should Catherine use if she plans to use $0.6$ liters of alcohol?\n\nExpressed as a decimal, Catherine must use\n{{field-1}}\nliters of the essence." :question/worked-solution "To determine the amount of orange essence that Catherine must mix with $0.6$ liters of alcohol, we must multiply $0.6$ by $0.2.$\n\nWe proceed by multiplying the two numbers just as we would with whole numbers.\n\nNotice that the second number has a leading $0$, which we ignore during the multiplication:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  & \\,\\,\\,\\,\\,\\begin{aligned} \\\\ 1\\end{aligned}\\,\\,\\,\\, &  \\\\  &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,.6\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,.2\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $1$ decimal place in $0.6$ and there is $1$ decimal place in $0.2.$\nTherefore, their product will have $1+1=2$ decimal places.\n\nSo, we take our value of $12$ and add a decimal point to make a number with $2$ decimal places.\n\n$$\n\\,\\overset{↓}{.}\\,\\,\\,{{12}_{⏟}}_{2\\text{ digits}}\n$$\n\nHence, $0.6\\times 0.2=0.12.$\n\nWe conclude that Catherine must use $0.12$ liters of the essence with $0.6$ liters of alcohol."}] [{:db/id #edb/ref 17592186492879 :knowledge-point/_questions [{:db/id #edb/ref 17592186138368 :knowledge-point/id #uuid "28d5aa07-8c26-5964-bb34-a500d8e0a9e9" :knowledge-point/title "Adding Numbers With One and Two Decimal Places"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e82f5183-4ff9-5158-9c5c-1339f506c1ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.08" :db/id #edb/ref 17592186492669}] :answer-field/correct {:answer/id #uuid "e82f5183-4ff9-5158-9c5c-1339f506c1ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.08" :db/id #edb/ref 17592186492669} :answer-field/id #uuid "f9a5ea18-a22e-5204-9b63-8f74b8ff1fcc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186492813}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7703677a-4909-5475-b6ab-0c17fa2c2c9f" :question/math-academy-id "q-166827" :question/problem "Catherine mixes $3.4$ liters of alcohol with $0.68$ liters of orange essence. What is the volume of the mixture?\n\nExpressed as a decimal, the volume of the mixture is\n{{field-1}}\nliters." :question/worked-solution "To determine the volume of the mixture, we need to calculate the sum $3.4+0.68.$\n\nThere is $1$ decimal place in $3.4$ and $2$ decimal places in $0.68.$\n\nTo add the numbers, they both need to have the same number of decimals. Hence, we rewrite the first number so that it has $2$ decimal places:\n\n$$\n3.4=3.40\n$$\n\nNext, we line up the decimal points:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\  &  &  & \\,\\,\\,\\,.\\,\\,\\,\\, &  & \\end{aligned}\n$$\n\nFinally, we proceed by adding the two numbers just as we would with whole numbers:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\,\\begin{aligned} \\\\ 1\\end{aligned}\\,\\,\\,\\, &  &  \\\\  &  & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\,\\end{aligned}\n$$\n\nTherefore, the volume of the mixture is $4.08$ liters."}] [{:db/id #edb/ref 17592186492829 :knowledge-point/_questions [{:db/id #edb/ref 17592186054862 :knowledge-point/id #uuid "f5d09700-00bd-5c67-93cf-f99c574732d7" :knowledge-point/title "Subtracting Decimals: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8553bef0-6553-5bf6-bdaa-fe1d0be8dfed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.75" :db/id #edb/ref 17592186492485}] :answer-field/correct {:answer/id #uuid "8553bef0-6553-5bf6-bdaa-fe1d0be8dfed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.75" :db/id #edb/ref 17592186492485} :answer-field/id #uuid "a0e9092e-2753-561b-9957-8b32b9689e81" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186492770}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0fe77a68-3c24-5dd5-9917-3c9654562d32" :question/math-academy-id "q-166828" :question/problem "Catherine accidentally spilled $0.33$ liters of the mixture that she prepared. How much of the mixture did Catherine have left? Express your answer as a decimal.\n\nCatherine had\n{{field-1}}\nliters of mixture left." :question/worked-solution "In part 3, we found that the volume of the mixture is $4.08$ liters.\n\nTo determine the amount of the mixture Catherine had left, we need to calculate $4.08-0.33.$\n\nFirst, we line up the decimal points:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\ \\,\\,\\,\\,-\\,\\,\\,\\, &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, \\\\  &  &  & \\,\\,\\,\\,.\\,\\,\\,\\, &  & \\end{aligned}\n$$\n\nNext, we proceed by subtracting the two numbers just as we would with whole numbers:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\,\\,\\begin{aligned} \\\\ 3\\end{aligned}\\,\\,\\,\\, &  & \\,\\,\\,\\,\\,\\begin{aligned} \\\\ 10\\end{aligned}\\,\\,\\,\\, &  \\\\  &  & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\ \\,\\,\\,\\,-\\,\\,\\,\\, &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\,\\end{aligned}\n$$\n\nTherefore, Catherine had $3.75$ liters of mixture left."}] [{:db/id #edb/ref 17592186492849 :knowledge-point/_questions [{:db/id #edb/ref 17592186073705 :knowledge-point/id #uuid "cb42b265-bcf6-58ef-aa08-489dec5d1104" :knowledge-point/title "Converting the Result to a Mixed Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "739cbcc0-e0f8-5a95-8682-9b6135f71748" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,\\frac{13}{28}" :db/id #edb/ref 17592186492448}] :answer-field/correct {:answer/id #uuid "739cbcc0-e0f8-5a95-8682-9b6135f71748" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,\\frac{13}{28}" :db/id #edb/ref 17592186492448} :answer-field/id #uuid "1a59a90a-35fb-5f5a-99e1-690af134a92e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186492714}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3a0555b7-c5c1-5a77-9f84-9a3774853f48" :question/math-academy-id "q-166829" :question/problem "Catherine used $9\\,\\frac{2}{7}$ liters of distilled water out of $10\\,\\frac{3}{4}$ liters of distilled water available. What is the volume of the remaining distilled water? Express your answer as a mixed number.\n\nThe volume of distilled water remaining equals$\\,$\n{{field-1}}\n$\\,$liters." :question/worked-solution "Caterine had $(10\\,\\frac{3}{4}-9\\,\\frac{2}{7})$ liters of distilled water left over.\n \nWriting $10\\,\\frac{3}{4}$ as an improper fraction, we have\n\n$$\n10\\,\\frac{3}{4}=\\frac{10\\times 4+3}{4}=\\frac{43}{4}.\n$$\n\nWriting $9\\,\\frac{2}{7}$ as an improper fraction, we have\n\n$$\n9\\,\\frac{2}{7}=\\frac{9\\times 7+2}{7}=\\frac{65}{7}.\n$$\n\nTherefore, our problem now is to work out the following:\n\n$$\n\\frac{43}{4}-\\frac{65}{7}\n$$\n\nTo subtract two fractions with unlike denominators, we need to express each fraction as an equivalent fraction with a common denominator.\n\nIn this question, we can make a common denominator of $28.$\n\nTo put $\\frac{43}{4}$ over a denominator of $28,$ we multiply the numerator and denominator by $7:$\n\n$$\n\\frac{43}{4}=\\frac{43\\times 7}{4\\times 7}=\\frac{301}{28}\n$$\n\nTo put $\\frac{65}{7}$ over a denominator of $28,$ we multiply the numerator and denominator by $4:$\n\n$$\n\\frac{65}{7}=\\frac{65\\times 4}{7\\times 4}=\\frac{260}{28}\n$$\n\nWe can now subtract the fractions. We keep the denominator the same, and we subtract the numerators:\n\n$$\n\\frac{301}{28}-\\frac{260}{28}=\\frac{41}{28}\n$$\n\nFinally, we convert back to a mixed number:\n\n$$\n\\frac{41}{28}=1\\,\\text{R}\\,13=1\\,\\frac{13}{28}\n$$\n\nTherefore, the volume of distilled water remaining equals $1\\,\\frac{13}{28}$ liters."}] [{:db/id #edb/ref 17592186492923 :knowledge-point/_questions [{:db/id #edb/ref 17592186073676 :knowledge-point/id #uuid "e27e3a75-779a-5817-a2ae-27b58cbac913" :knowledge-point/title "Rounding to the Nearest Whole Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40fd7b2d-6ae5-511b-8f10-3793fe065521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186492351}] :answer-field/correct {:answer/id #uuid "40fd7b2d-6ae5-511b-8f10-3793fe065521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186492351} :answer-field/id #uuid "627baafc-0a62-5d4c-8e2a-51eaaa4f0c15" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186492746}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f3c271f0-3313-54ab-8976-eb2aff616b55" :question/math-academy-id "q-166830" :question/problem "Catherine sold $6$ identical bottles of perfume, for which she received a total of $$90.33.$ Estimate the price of each bottle by rounding the amount of money Catherine received to the nearest dollar.\n\nThe approximate price for each bottle is $\n{{field-1}}." :question/worked-solution "To estimate the price of each of the $6$ perfumes, we need to find an approximation for $90.33÷6.$\n\nSo, we round the dividend to the nearest whole number:\n\n$$\n90.33\\to 90\n$$\n\nNow, we divide $90$ by $6$ as usual:\n\n$$\n90÷6=15\n$$\n\nTherefore, the approximate price for each bottle is $$15.$"}]}
