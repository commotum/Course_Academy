    \n                                 \n\n                                \n                                        </div> <!-- freeResponseLine --> \n                                    </div> <!-- freeResponse --> \n                                \n\n                                                      \n                        </div>  \n\n                        \n\n                        <div class=\"submitButtonFrame\">                     \n                            <div id=\"submitButton-6\" class=\"submitButton enabledButton\" style=\"display: none;\">Submit</div>                            \n                        </div>  \n                  \n                        <div class=\"spinnerFrame\">\n                            <img id=\"spinner-6\" class=\"spinner\" src=\"/img/spinner.gif\" style=\"display: none;\">\n                        </div>\n\n                        <div id=\"question-166829-explanationFrame\" style=\"display: block;\">\n                               \n                        <div class=\"answer\">\n                <table>\n                    <tbody><tr>\n                        <td><img class=\"answerSymbol\" src=\"/img/incorrect-answer.png\"></td>\n                        <td class=\"incorrectAnswerText\">Incorrect</td>\n                    </tr>\n                </tbody></table></div><div class=\"explanationHeader\">Explanation</div><div class=\"questionExplanation\"><p>Caterine had <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"49\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mrow><mjx-mo class=\"mjx-s3\"><mjx-c class=\"mjx-c28 TEX-S3\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn><mjx-mstyle><mjx-mspace style=\"width: 0.167em;\"></mjx-mspace></mjx-mstyle><mjx-mstyle><mjx-mfrac><mjx-frac type=\"d\"><mjx-num><mjx-nstrut type=\"d\"></mjx-nstrut