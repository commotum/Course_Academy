          "input_html": "<div class=\"matheditor-wrapper-answer\" style=\"min-width: 30px; margin-left: 4px; margin-right: 1px;\">\n                                             \n                                        <div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"11\"><span mathquill-command-id=\"55\">1</span><span mathquill-command-id=\"57\">5</span></span></div></div>",
