#{[{:db/id #edb/ref 17592186063988 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064241 :knowledge-point/id #uuid "7ff8de23-e4f2-51e1-9390-78ff7edd2176" :knowledge-point/title "Multiplying Binomials"}] :question/id #uuid "ab6787e7-5b47-51a6-8967-4ede296cc44f" :question/math-academy-id "e-14313" :question/problem "Expand and simplify $(y + 5)(y - 2)$." :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned} (y + 5)(y - 2) \\\\ &= y(y-2) + 5(y-2) \\\\ &= y^2-2y +5y-10 \\\\ &= y^2 + 3y - 10 \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063989 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064242 :knowledge-point/id #uuid "36d4e3a1-9f2e-5434-bfc9-10c29a426e07" :knowledge-point/title "Multiplying Binomials with Leading Coefficients"}] :question/id #uuid "818a9bf5-5ed5-5809-a295-3d332ce98b47" :question/math-academy-id "e-14316" :question/problem "Expand and simplify $(2n - 1)(3n - 6)$." :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned} (2n - 1)(3n - 6) \\\\ &= 2n(3n - 6) + (-1)(3n - 6) \\\\ &= 6n^2 - 12n - 3n + 6 \\\\ &= 6n^2 - 15n + 6 \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063990 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064243 :knowledge-point/id #uuid "27aef839-e6a9-5c8e-bcd7-a2e9438968b0" :knowledge-point/title "Multiplying Binomials with Higher Powers and Multiple Variables"}] :question/id #uuid "4e99bb73-42a1-5b11-8463-020f297c5afc" :question/math-academy-id "e-14317" :question/problem "Expand $(p^2-q^2)(2p+3q)$." :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}\n(p^{2} - q^{2})(2p + 3q) &=  \\\\\np^{2}(2p + 3q) + (-q^{2})(2p + 3q) &=  \\\\\n&= 2p^{3} + 3p^{2}q - 2pq^{2} - 3q^{3}\n\\end{aligned}\n$$\n\nWe cannot simplify the above expression any further because there are no like terms."}] [{:db/id #edb/ref 17592186064596 :knowledge-point/_questions [{:db/id #edb/ref 17592186064243 :knowledge-point/id #uuid "27aef839-e6a9-5c8e-bcd7-a2e9438968b0" :knowledge-point/title "Multiplying Binomials with Higher Powers and Multiple Variables"}] :question/answer-fields [{:answer-field/id #uuid "f1e63775-9bbf-5bac-9ed9-630837fc923d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186061690} {:answer-field/id #uuid "f2b24c1f-e0a9-5e81-80d0-15c9916d9962" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186061691} {:answer-field/id #uuid "20f982b0-71a4-5ef7-924d-0be8af36f72d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186061692} {:answer-field/id #uuid "23f3ab51-ce5a-5bd3-bd7d-e65ca8d3a9a1" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186061693}] :question/id #uuid "a603bcbe-594a-560c-9760-7b1c995efc5b" :question/math-academy-id "q-216734" :question/problem "$(7u^{2} - 6v)(v - u) =$ {{field-1}} $u^{3} +$\n{{field-2}} $u^{2}v +$\n{{field-3}} $uv -$\n{{field-4}} $v^{2}$"}] [{:db/id #edb/ref 17592186064676 :knowledge-point/_questions [{:db/id #edb/ref 17592186064241 :knowledge-point/id #uuid "7ff8de23-e4f2-51e1-9390-78ff7edd2176" :knowledge-point/title "Multiplying Binomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97b4e75c-2cd9-51e7-b230-32e5185c723e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9q^{2} + 12" :db/id #edb/ref 17592186062114} {:answer/id #uuid "db9eb59a-bbaa-5419-bb3a-9eeff203c8c8" 