#{[{:db/id #edb/ref 17592186063988 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064241 :knowledge-point/id #uuid "7ff8de23-e4f2-51e1-9390-78ff7edd2176" :knowledge-point/title "Multiplying Binomials"}] :question/id #uuid "ab6787e7-5b47-51a6-8967-4ede296cc44f" :question/math-academy-id "e-14313" :question/problem "Expand and simplify $(y + 5)(y - 2).$" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\eqalign{\n\t\t(y + 5)(y - 2) &= \\\n\t\ty(y-2) + 5(y-2) &=\\\n\t\ty^2-2y +5y-10 &=\\\n\t\ty^2 + 3y - 10\n\t}\n$$"}] [{:db/id #edb/ref 17592186063989 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064242 :knowledge-point/id #uuid "36d4e3a1-9f2e-5434-bfc9-10c29a426e07" :knowledge-point/title "Multiplying Binomials with Leading Coefficients"}] :question/id #uuid "818a9bf5-5ed5-5809-a295-3d332ce98b47" :question/math-academy-id "e-14316" :question/problem "Expand and simplify $(2n - 1)(3n - 6).$" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\eqalign{\n\t\t(2n - 1)(3n - 6) &= \\\n\t\t2n(3n - 6) + (-1)(3n - 6) &= \\\n\t\t6n^2 - 12n - 3n + 6 &= \\\n\t\t6n^2 - 15n + 6\n\t}\n$$"}] [{:db/id #edb/ref 17592186063990 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064243 :knowledge-point/id #uuid "27aef839-e6a9-5c8e-bcd7-a2e9438968b0" :knowledge-point/title "Multiplying Binomials with Higher Powers and Multiple Variables"}] :question/id #uuid "4e99bb73-42a1-5b11-8463-020f297c5afc" :question/math-academy-id "e-14317" :question/problem "Expand $(p^2-q^2)(2p+3q).$" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}({p}^{2}-{q}^{2})(2p+3q) & = \\\\ {p}^{2}(2p+3q)+(-{q}^{2})(2p+3q) & = \\\\ 2{p}^{3}+3{p}^{2}q-2p{q}^{2}-3{q}^{3} & \\end{aligned}\n$$\n\nWe cannot simplify the above expression any further because there are no like terms."}] [{:db/id #edb/ref 17592186481390 :knowledge-point/_questions [{:db/id #edb/ref 17592186064242 :knowledge-point/id #uuid "36d4e3a1-9f2e-5434-bfc9-10c29a426e07" :knowledge-point/title "Multiplying Binomials with Leading Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "069f88ba-133f-535f-a723-563b81e5b29c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21{k}^{2}+5k+14" :db/id #edb/ref 17592186480752} {:answer/id #uuid "1c0fe191-f3df-5f09-b110-f2120896e9c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21{k}^{2}+56k+9" :db/id #edb/ref 17592186480798} {:answer/id #uuid "268d21ce-8e44-5443-9606-72092afa2e67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21{k}^{2}-55k+14" :db/id #edb/ref 17592186480809} {:answer/id #uuid "979209d8-91c0-5568-969c-cf60d20e453d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21{k}^{2}-5k+14" :db/id #edb/ref 17592186481030} {:answer/id #uuid "c2babc74-c619-5fbd-b511-3dc958506365" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21{k}^{2}+55k+14" :db/id #edb/ref 17592186481112}] :answer-field/correct {:answer/id #uuid "c2babc74-c619-5fbd-b511-3dc958506365" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21{k}^{2}+55k+14" :db/id #edb/ref 17592186481112} :answer-field/id #uuid "90bc955a-ad0b-54ff-af0f-b3b9d809da85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186481288}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "84908780-ec57-5aef-8661-1e98636ea221" :question/math-academy-id "q-111345" :question/problem "$(3k+7)(7k+2)=$" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(3k+7)(7k+2) & = \\\\ 3k(7k+2)+7(7k+2) & = \\\\ 21{k}^{2}+6k+49k+14 & = \\\\ 21{k}^{2}+55k+14\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481381 :knowledge-point/_questions [{:db/id #edb/ref 17592186064243 :knowledge-point/id #uuid "27aef839-e6a9-5c8e-bcd7-a2e9438968b0" :knowledge-point/title "Multiplying Binomials with Higher Powers and Multiple Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20451e96-f9f3-5a95-974f-edcf9b7ac2f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{c}^{8}+{c}^{4}d+6{d}^{2}" :db/id #edb/ref 17592186480803} {:answer/id #uuid "255a116f-8e28-5678-a590-1c837c355838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{c}^{8}+4{c}^{4}{d}^{3}-3d{c}^{4}+6{d}^{2}" :db/id #edb/ref 17592186480808} {:answer/id #uuid "d5ce409f-fc7b-5ac2-b10e-40e80d4d9fcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{c}^{8}-7{c}^{4}d-6{d}^{2}" :db/id #edb/ref 17592186481137} {:answer/id #uuid "e451d3cd-f2c4-5e6b-adb0-b9b776390683" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{c}^{8}+7{c}^{4}d+6{d}^{2}" :db/id #edb/ref 17592186481171} {:answer/id #uuid "f9a5874d-090a-5bae-9920-7a31922ca870" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{c}^{8}-4{c}^{4}{d}^{3}+3d{c}^{4}+6{d}^{2}" :db/id #edb/ref 17592186481221}] :answer-field/correct {:answer/id #uuid "e451d3cd-f2c4-5e6b-adb0-b9b776390683" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{c}^{8}+7{c}^{4}d+6{d}^{2}" :db/id #edb/ref 17592186481171} :answer-field/id #uuid "d6c24e3c-4bd6-5a5c-b865-47973c2733db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186481319}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6e37bd4e-5f8a-5417-aabd-8b7d37d96ee7" :question/math-academy-id "q-111350" :question/problem "$(2{c}^{4}+3d)({c}^{4}+2d)=$" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(2{c}^{4}+3d)({c}^{4}+2d) & = \\\\ 2{c}^{4}({c}^{4}+2d)+3d({c}^{4}+2d) & = \\\\ 2{c}^{8}+4{c}^{4}d+3{c}^{4}d+6{d}^{2} & = \\\\ 2{c}^{8}+7{c}^{4}d+6{d}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481344 :knowledge-point/_questions [{:db/id #edb/ref 17592186064242 :knowledge-point/id #uuid "36d4e3a1-9f2e-5434-bfc9-10c29a426e07" :knowledge-point/title "Multiplying Binomials with Leading Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7be341b-eeb1-56cd-a834-c863d737ab2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "77u^{2}-20u-12" :db/id #edb/ref 17592186481090}] :answer-field/correct {:answer/id #uuid "b7be341b-eeb1-56cd-a834-c863d737ab2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "77u^{2}-20u-12" :db/id #edb/ref 17592186481090} :answer-field/id #uuid "cded0974-27ad-56b0-a5f7-77743e5c2583" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481314}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "04f1ace1-c4c7-5004-a410-92cc0ba374dc" :question/math-academy-id "q-216721" :question/problem "Expand the following product of binomials. Write your answer in **standard form.**\n\n$(11u-6)(7u+2)=$\n{{field-1}}" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(11u-6)(7u+2) & = \\\\ 11u(7u+2)+(-6)(7u+2) & = \\\\ 77{u}^{2}+22u-42u-12 & = \\\\ 77{u}^{2}-20u-12\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064596 :knowledge-point/_questions [{:db/id #edb/ref 17592186064243 :knowledge-point/id #uuid "27aef839-e6a9-5c8e-bcd7-a2e9438968b0" :knowledge-point/title "Multiplying Binomials with Higher Powers and Multiple Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14a3f9bc-2830-5b92-931a-3c810b62441b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186480774}] :answer-field/correct {:answer/id #uuid "14a3f9bc-2830-5b92-931a-3c810b62441b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186480774} :answer-field/id #uuid "f1e63775-9bbf-5bac-9ed9-630837fc923d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186061690} {:answer-field/choices [{:answer/id #uuid "272b01ca-2905-5fd4-8795-37ff6fdbfcd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186480811}] :answer-field/correct {:answer/id #uuid "272b01ca-2905-5fd4-8795-37ff6fdbfcd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186480811} :answer-field/id #uuid "f2b24c1f-e0a9-5e81-80d0-15c9916d9962" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186061691} {:answer-field/choices [{:answer/id #uuid "a2f1bfe9-db04-5089-b55e-98e9532c2a94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186481046}] :answer-field/correct {:answer/id #uuid "a2f1bfe9-db04-5089-b55e-98e9532c2a94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186481046} :answer-field/id #uuid "20f982b0-71a4-5ef7-924d-0be8af36f72d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186061692} {:answer-field/choices [{:answer/id #uuid "402fdbb8-b6b5-5849-b4b5-7740744567bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186480863}] :answer-field/correct {:answer/id #uuid "402fdbb8-b6b5-5849-b4b5-7740744567bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186480863} :answer-field/id #uuid "23f3ab51-ce5a-5bd3-bd7d-e65ca8d3a9a1" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186061693}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a603bcbe-594a-560c-9760-7b1c995efc5b" :question/math-academy-id "q-216734" :question/problem "$(7{u}^{2}-6v)(v-u)=${{field-1}}${u}^{3}\\,+$\n{{field-2}}${u}^{2}v\\,+$\n{{field-3}}$uv\\,-$\n{{field-4}}${v}^{2}$" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(7{u}^{2}-6v)(v-u) & = \\\\ 7{u}^{2}(v-u)+(-6v)(v-u) & = \\\\ 7{u}^{2}v-7{u}^{3}-6{v}^{2}+6uv & = \\\\ -7{u}^{3}+7{u}^{2}v+6uv-6{v}^{2}\\end{aligned}\n$$\n\nWe cannot simplify the above expression any further because there are no like terms."}] [{:db/id #edb/ref 17592186064676 :knowledge-point/_questions [{:db/id #edb/ref 17592186064241 :knowledge-point/id #uuid "7ff8de23-e4f2-51e1-9390-78ff7edd2176" :knowledge-point/title "Multiplying Binomials"}] :question/answer-fields [{:answer-field/choi