#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186065109} :activity/id #uuid "7e0946df-45c0-5786-9c65-795f6164a618" :activity/scope {:db/id #edb/ref 17592186050818 :topic/id #uuid "68e64e22-0e3c-5eac-8837-c36b21dd36c0" :topic/math-academy-id 371} :activity/steps [{:db/id #edb/ref 17592186065109 :step/content {:db/id #edb/ref 17592186065440 :tutorial/content "When we want to multiply two binomials, we take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\nFor example, to multiply $({\\color{blue}{x}} + {\\color{red}{3}})$ and $(x + 2),$ we multiply ${\\color{blue}{x}}$ and $(x + 2),$ and then we add this to the product of ${\\color{red}{3}}$ and $(x+2)$:\n\n$$\n\\eqalign{\n\t\t({\\color{blue}{x}} + {\\color{red}{3}})(x + 2) &= \\[5pt]\n\t\t{\\color{blue}{x}}(x + 2) + {\\color{red}{3}}(x + 2) &= \\[5pt]\n\t\tx^2 + 2x + 3x + 6 &= \\[5pt]\n\t\tx^2 + 5x + 6\n\t}\n$$" :tutorial/id #uuid "0cea50d1-e4ce-511f-821f-0e5e04b6eca1" :tutorial/math-academy-id 8877 :tutorial/title "Introduction"} :step/id #uuid "034d8161-5ef0-5329-ac71-ca2e17506a54" :step/math-academy-id 171384 :step/next {:db/id #edb/ref 17592186065110}} {:db/id #edb/ref 17592186065110 :step/content {:db/id #edb/ref 17592186064241 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063988 :question/id #uuid "ab6787e7-5b47-51a6-8967-4ede296cc44f" :question/math-academy-id "e-14313"} :knowledge-point/id #uuid "7ff8de23-e4f2-51e1-9390-78ff7edd2176" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048548} {:db/id #edb/ref 17592186049496} {:db/id #edb/ref 17592186049538}] :knowledge-point/questions [{:db/id #edb/ref 17592186064595} {:db/id #edb/ref 17592186064676} {:db/id #edb/ref 17592186481382}] :knowledge-point/title "Multiplying Binomials"} :step/id #uuid "befc51ec-1128-57f9-9017-8b1297e2a304" :step/math-academy-id 171385 :step/next {:db/id #edb/ref 17592186065111}} {:db/id #edb/ref 175921860651