#{[{:db/id #edb/ref 17592186508982 :knowledge-point/_questions [{:db/id #edb/ref 17592186096658 :knowledge-point/id #uuid "6bab04f2-5e9a-55e7-9669-63e15938be0a" :knowledge-point/title "Evaluating a Function in a Modeling Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f7d7512-00dd-53a1-a339-e816ce6f9bc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0.04$ gallons" :db/id #edb/ref 17592186508412} {:answer/id #uuid "4a011cf2-f11f-556b-9630-c5475d45f2d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0.2$ gallons" :db/id #edb/ref 17592186508497} {:answer/id #uuid "9528fa7d-db24-588f-95a3-5f14223601ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$ gallon" :db/id #edb/ref 17592186508611} {:answer/id #uuid "a758b6c6-f6c3-5428-a865-833457877121" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0.02$ gallons" :db/id #edb/ref 17592186508640} {:answer/id #uuid "d808d943-003d-59e8-a1b2-bb5ce6ae207f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0.4$ gallons" :db/id #edb/ref 17592186508739}] :answer-field/correct {:answer/id #uuid "0f7d7512-00dd-53a1-a339-e816ce6f9bc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0.04$ gallons" :db/id #edb/ref 17592186508412} :answer-field/id #uuid "6bbf46a9-a271-5e94-8244-41b134f4a887" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186508846}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d4c0de90-e894-5c05-811c-ac221194e0c5" :question/math-academy-id "q-112129" :question/problem "A five gallons water bottle is leaking its content. The number of gallons of water left inside the bottle after $t$ minutes is given by the formula $W(t)=5\\cdot {(\\frac{1}{5})}^{t}.$ How many gallons of water will be inside the bottle after $3$ minutes?" :question/worked-solution "To get the number of gallons of water inside the bottle after $3$ minutes, we evaluate the function at $t=3.$ Substituting $t=3$ into the function $W(t)$ gives\n\n$$\n\\begin{aligned}W(3) & =5\\cdot {(\\frac{1}{5})}^{3} \\\\  & =5\\cdot (\\frac{{1}^{3}}{{5}^{3}}) \\\\  & =5\\cdot \\frac{1}{125} \\\\  & =\\frac{5}{125} \\\\  & =0.04.\\end{aligned}\n$$\n\n \n\nTherefore, after $3$ minutes, there will be $0.04$ gallons of water inside the bottle."}] [{:db/id #edb/ref 17592186508914 :knowledge-point/_questions [{:db/id #edb/ref 17592186096658 :knowledge-point/id #uuid "6bab04f2-5e9a-55e7-9669-63e15938be0a" :knowledge-point/title "Evaluating a Function in a Modeling Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "363f8683-7ce6-519e-b516-88ec0639bc77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2\\,293$ subscribers" :db/id #edb/ref 17592186508471} {:answer/id #uuid "7999765f-0877-5da0-8674-68c82949589f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$11\\,185$ subscribers" :db/id #edb/ref 17592186508568} {:answer/id #uuid "83349184-0745-5f0a-adb8-dc217a25b73d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3\\,645$ subscribers" :db/id #edb/ref 17592186508584} {:answer/id #uuid "bc607cfb-7458-58ee-9fe1-447d861318c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$32\\,805$ subscribers" :db/id #edb/ref 17592186508676} {:answer/id #uuid "d6f48a1a-dec7-5522-a1f4-4f63c0ce08a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$234\\,375$ subscribers" :db/id #edb/ref 17592186508736}] :answer-field/correct {:answer/id #uuid "363f8683-7ce6-519e-b516-88ec0639bc77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2\\,293$ subscribers" :db/id #edb/ref 17592186508471} :answer-field/id #uuid "595c2d53-60ff-5406-b569-8b0372ade376" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186508839}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1571510a-8d3e-5007-9b28-e17c3cb5bde3" :question/math-academy-id "q-112148" :question/problem "The number of subscribers to a video channel is given by $S(t)=5\\cdot (2.4)^{t},$ where $t$ is the time in days since the channel was opened. How many subscribers will the channel have after a week? Round your answer to the nearest integer." :question/worked-solution "To get the number of subscribers to the video channel after a week ($7$ days), we evaluate the function at $t=7.$ Substituting $t=7$ into the function $S(t)$ gives\n\n$$\n\\begin{aligned}S(7) & =5\\cdot (2.4)^{7} \\\\  & ≈2\\,293.\\end{aligned}\n$$\n\n \n\nTherefore, after a week, the video channel will have $2\\,293$ subscribers."}] [{:db/id #edb/ref 17592186508929 :knowledge-point/_questions [{:db/id #edb/ref 17592186096659 :knowledge-point/id #uuid "b0cee2b0-6cc8-5281-8ea2-02400b2980e1" :knowledge-point/title "Finding an Initial Value"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9063cde2-3330-509e-ae49-cc65532f4b9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186508607}] :answer-field/correct {:answer/id #uuid "9063cde2-3330-509e-ae49-cc65532f4b9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186508607} :answer-field/id #uuid "f6b57ab6-1b1d-515d-affc-7350d9f0ce89" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186508906}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4fda74bd-4783-5b76-9154-8ddd3936c772" :question/math-academy-id "q-218594" :question/problem "If $f(x)=A\\cdot {2}^{x}$ and $f(6)=192,$ then $A=${{field-1}}." :question/worked-solution "We substitute $x=6$ and $f(x)=192$ into the expression for $f(x)$ and then solve for $A,$ as follows:\n\n$$\n\\begin{aligned}192 & =A\\cdot {2}^{6} \\\\ \\frac{192}{{2}^{6}} & =A \\\\ \\frac{192}{64} & =A \\\\ 3 & =A.\\end{aligned}\n$$\n\nTherefore, $A=3.$"}]}
