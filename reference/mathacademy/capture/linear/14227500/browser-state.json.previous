      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14227500/observations/step-q90634-db090c17ce76923092c6.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14227500/observations/step-q90634-db090c17ce76923092c6.png",
      "source_url": "https://mathacademy.com/tasks/14227500/topics/2707/lesson",
      "captured_at": 1792062809.992677,
      "math_academy_id": "q-90634",
      "topic_id": "2707",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q90634",
        "placement_id": null,
        "content_id": null,
