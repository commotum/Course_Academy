      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14227500/observations/step-q108281-d2a05947b802c9310c22.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14227500/observations/step-q108281-d2a05947b802c9310c22.png",
      "source_url": "https://mathacademy.com/tasks/14227500/topics/2707/lesson",
      "captured_at": 1792062762.503385,
      "math_academy_id": "q-108281",
      "topic_id": "2707",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q108281",
        "placement_id": null,
        "content_id": null,
