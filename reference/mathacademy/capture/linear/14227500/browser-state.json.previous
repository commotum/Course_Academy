      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14227500/observations/step-q108293-d722c0c9a02afa57a7bb.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14227500/observations/step-q108293-d722c0c9a02afa57a7bb.png",
