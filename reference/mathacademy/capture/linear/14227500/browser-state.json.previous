      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14227500/observations/step-q90637-a58d4c7cfb6888e0d7cb.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14227500/observations/step-q90637-a58d4c7cfb6888e0d7cb.png",
      "source_url": "https://mathacademy.com/tasks/14227500/topics/2707/lesson",
      "captured_at": 1792062829.7968829,
      "math_academy_id": "q-90637",
      "topic_id": "2707",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q90637",
