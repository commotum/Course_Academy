              "value": "I and II only",
              "html": "I and II only"
            },
            {
              "option": "b",
              "dom_id": "questionWidget-choiceLetterCircle-37056-b",
              "type": "text",
              "value": "III only",
              "html": "III only"
            },
            {
              "option": "c",
              "dom_id": "questionWidget-choiceLetterCircle-37056-c",
              "type": "text",
              "value": "II only",
              "html": "II only"
            },
            {
              "option": "d",
              "dom_id": "questionWidget-choiceLetterCircle-37056-d",
