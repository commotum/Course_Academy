#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186536009} :activity/id #uuid "3feed6d1-a0d5-5ab7-9ea2-a3df2bac55db" :activity/scope {:db/id #edb/ref 17592186050364 :topic/id #uuid "42f68342-78b4-5e6c-a159-7ae8ddb5e91f" :topic/math-academy-id 480} :activity/steps [{:db/id #edb/ref 17592186536009 :step/content {:db/id #edb/ref 17592186535924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c92523a-b06e-5c14-a2cd-5360c00395b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=0,\\,1,\\,\\frac{1}{2}" :db/id #edb/ref 17592186535459} {:answer/id #uuid "1640a20d-e4d1-5015-9cda-627837d66005" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-2,\\,0,\\,1" :db/id #edb/ref 17592186535471} {:answer/id #uuid "5b1e67e5-bec5-5ea7-bdf3-f27057c7ae46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{2},\\,0,\\,\\frac{1}{2}" :db/id #edb/ref 17592186535579} {:answer/id #uuid "e8cf239b-fa18-5105-96fb-3beeb63f74e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{2},\\,0,\\,\\frac{1}{3}" :db/id #edb/ref 17592186535794} {:answer/id #uuid "f7dc453a-52bf-5f89-b1b6-01e35d12e5aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{2},\\,0,\\,1" :db/id #edb/ref 17592186535812}] :answer-field/correct {:db/id #edb/ref 17592186535579} :answer-field/id #uuid "f7f1648e-bfb1-591c-80ea-4405790435c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186535921}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "05ed837d-3821-5be3-89df-8ca589e409e2" :question/math-academy-id "q-14005" :question/problem "Determine the real roots of the cubic equation $10{y}^{3}-y=2{y}^{3}+y.$" :question/worked-solution "First, let's rewrite the polynomial equation in the form ${P}_{n}(y)=0.$ To do this, we subtract all the terms from the right-hand side so that the right-hand side becomes $0:$\n\n$$\n\\begin{aligned}10{y}^{3}-y & =2{y}^{3}+y \\\\ 8{y}^{3}-y & =y \\\\ 8{y}^{3}-2y & =0\\end{aligned}\n$$\n\nNext, notice that all of the terms of the polynomial have a common factor of $2y.$ We can factor out the $2y$ as follows:\n\n$$\n\\begin{aligned}8{y}^{3}-2y & =0 \\\\ 2y(4{y}^{2}-1) & =0\\end{aligned}\n$$\n\nNow, we factor the expression $4{y}^{2}-1$ as follows:\n\n$$\n\\begin{aligned}2y(4{y}^{2}-1) & =0 \\\\ 2y(2y+1)(2y-1) & =0\\end{aligned}\n$$\n\nFinally, by applying the zero product rule, the solutions are $y=0,$ $z=-\\frac{1}{2},$ and $y=\\frac{1}{2}.$"} :step/id #uuid "0c49baa4-622e-5e7f-9ddd-42763005e29c" :step/next {:db/id #edb/ref 17592186536045}} {:db/id #edb/ref 17592186536031 :step/content {:db/id #edb/ref 17592186535973 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c64f283-376a-5aea-ad5b-0fd0b69f4c0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=-4,\\,-1,\\,0" :db/id #edb/ref 17592186535479} {:answer/id #uuid "7d7dfd6f-3f62-5676-8e59-619b7bf533ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=-2,\\,-\\frac{1}{2},\\,0" :db/id #edb/ref 17592186535630} {:answer/id #uuid "968b97e4-e536-5306-8c56-99b308114e5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=-2,\\,-1,\\,1" :db/id #edb/ref 17592186535670} {:answer/id #uuid "a2cdcfa6-1b3f-5b11-8574-abd7c13b156b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=-2,\\,0,\\,1" :db/id #edb/ref 17592186535687} {:answer/id #uuid "dce9f8d9-a244-590c-93fe-5a247b012a8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=-6,\\,-\\frac{3}{2},\\,0" :db/id #edb/ref 17592186535772}] :answer-field/correct {:db/id #edb/ref 17592186535630} :answer-field/id #uuid "18396988-80bb-5ded-8e95-066e394e22f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186535840}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9b05fed3-4ab6-51d7-8e10-a90e6b0e2462" :question/math-academy-id "q-70466" :question/problem "Find the roots of the polynomial $p(t)=6{t}^{6}+15{t}^{5}+6{t}^{4}.$" :question/worked-solution "To find the roots of the polynomial, we must solve the equation $p(t)=0,$ that is\n\n$$\n6{t}^{6}+15{t}^{5}+6{t}^{4}=0.\n$$\n\nFirst, notice that all of the terms of the polynomial have a common factor of $3{t}^{4}.$ We can factor out the $3{t}^{4}$ as follows:\n\n$$\n\\begin{aligned}3{t}^{4}(2{t}^{2}+5t+2) & =0\\end{aligned}\n$$\n\nNow, we factor the expression $2{t}^{2}+5t+2$ as follows:\n\n$$\n\\begin{aligned}3{t}^{4}(2{t}^{2}+5t+2) & =0 \\\\ 3{t}^{4}(2t+1)(t+2) & =0\\end{aligned}\n$$\n\nFinally, by applying the zero product rule, the solutions are $t=0,$ $t=-\\frac{1}{2},$ and $t=-2.$"} :step/id #uuid "7e57999b-d68d-5e21-8300-43ec29332e47"} {:db/id #edb/ref 17592186536045 :step/content {:db/id #edb/ref 17592186535932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "055022f7-b555-5b53-bdb6-52590c8cb0bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=0" :db/id #edb/ref 17592186535446} {:answer/id #uuid "4811dac8-5f59-56b0-ac1b-78612918c845" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-1,\\,0" :db/id #edb/ref 17592186535541} {:answer/id #uuid "549aad98-3e4b-5a26-8533-7d549487f2d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=0,\\,3,\\,5" :db/id #edb/ref 17592186535566} {:answer/id #uuid "9807b2dd-bc9a-5693-ad00-0fc00ed47b0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=0,\\,5" :db/id #edb/ref 17592186535674} {:answer/id #uuid "9cbb051b-e065-53ef-b7cf-9b608ab9119d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-1,\\,0,\\,5" :db/id #edb/ref 17592186535682}] :answer-field/correct {:db/id #edb/ref 17592186535446} :answer-field/id #uuid "156cc421-00b2-50d1-b76f-984736c8cfcd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186535839}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1444bcbd-c7af-503c-a5fd-f72a90d6d77a" :question/math-academy-id "q-38109" :question/problem "Solve for $x$ where $4{x}^{3}+3x=3{x}^{3}-4x.$" :question/worked-solution "First, let's rewrite the polynomial equation in the form ${P}_{n}(x)=0.$ To do this, we subtract all the terms from the right-hand side so that the right-hand side becomes $0:$\n\n$$\n\\begin{aligned}4{x}^{3}+3x & =3{x}^{3}-4x \\\\ {x}^{3}+3x & =-4x \\\\ {x}^{3}+7x & =0\\end{aligned}\n$$\n\nNext, notice that all of the terms of the polynomial have a common factor of $x.$ We can factor out the $x$ as follows:\n\n$$\n\\begin{aligned}{x}^{3}+7x & =0 \\\\ x({x}^{2}+7) & =0\\end{aligned}\n$$\n\nSince ${x}^{2}+7=0$ has no real solutions, we cannot factor the expression ${x}^{2}+7$  further.\n\nFinally, by applying the zero product rule, the only solution is $x=0.$"} :step/id #uuid "db2e2257-7721-5598-9a21-bdc28f24d843" :step/next {:db/id #edb/ref 17592186536031}}] :activity/title "Solving Polynomial Equations Using the GCF" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186535429}]}
