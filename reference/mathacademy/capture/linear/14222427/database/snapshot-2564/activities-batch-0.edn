ef 17592186431450} {:db/id #edb/ref 17592186431452} {:db/id #edb/ref 17592186431454} {:db/id #edb/ref 17592186496232} {:db/id #edb/ref 17592186496239} {:db/id #edb/ref 17592186535973}] :knowledge-point/title "Solving a Higher-Order Polynomial Equation With No Constant Term"} :step/id #uuid "99f605fb-6db1-565c-9344-a5cac2693c19" :step/math-academy-id 19002}] :activity/title "Solving Polynomial Equations Using the GCF" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073918}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186496359} :activity/id #uuid "94a260c5-b122-501f-a1e3-f23e0a63ac0c" :activity/scope {:db/id #edb/ref 17592186050364 :topic/id #uuid "42f68342-78b4-5e6c-a159-7ae8ddb5e91f" :topic/math-academy-id 480} :activity/steps [{:db/id #edb/ref 17592186496339 :step/content {:db/id #edb/ref 17592186496286 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22b079b3-82fd-53cc-967c-e6d943626c96" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-5,\\,0,\\,\\frac{5}{2}" :db/id #edb/ref 17592186495586} {:answer/id #uuid "5f175bd8-a787-50aa-9e06-2936f24358df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=0,\\,\\frac{5}{2},\\,5" :db/id #edb/ref 17592186495725} {:answer/id #uuid "ccc7a4ca-8f50-5800-bd17-58acdabf0fcf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-5,\\,-\\frac{5}{2},\\,0" :db/id #edb/ref 17592186495954} {:answer/id #uuid "cf00f047-8ff7-5a2b-acc0-0fb93efa3755" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{5}{2},\\,0,\\,5" :db/id #edb/ref 17592186495962} {:answer/id #uuid "f58c1047-ff2f-539e-a8e7-b10b9832472f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{5}{2},\\,0,\\,\\frac{5}{2}" :db/id #edb/ref 17592186496044}] :answer-field/correct {:db/id #edb/ref 17592186495954} :answer-field/id #uuid "ed6705e1-a953-5bdb-83a1-993a5e062818" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496206}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "919eb3c8-9df3-5268-99a8-1eece100daa7" :question/math-academy-id "q-3986" :question/problem "If $6{y}^{3}+50{y}^{2}+100y=5{y}^{2}+25y$, then $y=$" :question/worked-solution "First, let's rewrite the polynomial equation in the form ${P}_{n}(y)=0.$ To do this, we subtract all the terms from the right-hand side so that the right-hand side becomes $0:$\n\n$$\n\\begin{aligned}6{y}^{3}+50{y}^{2}+100y & =5{y}^{2}+25y \\\\ 6{y}^{3}+45{y}^{2}+100y & =25y \\\\ 6{y}^{3}+45{y}^{2}+75y & =0\\end{aligned}\n$$\n\nNext, notice that all of the terms of the polynomial have a common factor of $3y.$ We can factor out the $3y$ as follows:\n\n$$\n\\begin{aligned}6{y}^{3}+45{y}^{2}+75y & =0 \\\\ 3y(2{y}^{2}+15y+25) & =0\\end{aligned}\n$$\n\nNow, we factor the expression $2{y}^{2}+15y+25$ as follows:\n\n$$\n\\begin{aligned}3y(2{y}^{2}+15y+25) & =0 \\\\ 3y(2y+5)(y+5) & =0\\end{aligned}\n$$\n\nFinally, by applying the zero product rule, the solutions are $y=0,$ $y=-\\frac{5}{2},$ and $y=-5.$"} :step/id #uuid "1558dfef-e88a-58a9-aaaa-91edfc7635f4" :step/next {:db/id #edb/ref 17592186496342}} {:db/id #edb/ref 17592186496342 :step/content {:db/id #edb/ref 17592186233431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19a0ab0c-b3e2-5ae5-addf-1885d686f62c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-1,\\,0,\\,8" :db/id #edb/ref 17592186495560} {:answer/id #uuid "32696e28-235c-5c0a-8eb3-6b3a12f32ac4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-6,\\,0,\\,1" :db/id #edb/ref 17592186495625} {:answer/id #uuid "3daa5066-cd2d-5f30-97c1-528e78913c21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=0,\\,1,\\,7" :db/id #edb/ref 17592186495652} {:answer/id #uuid "ab2ab22f-7d9c-5b55-93af-e42f06696710" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=0,\\,2,\\,7" :db/id #edb/ref 17592186495893} {:answer/id #uuid "cea4e846-061a-50ef-9e7a-5b210f352183" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-1,\\,0,\\,1" :db/id #edb/ref 17592186495959}] :answer-field/correct {:db/id #edb/ref 17592186495652} :answer-field/id #uuid "fa9153f3-18d4-506c-b393-21476c0fa80e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496217}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0f62245d-fa91-5e0d-b7d5-51c473bc7e2e" :question/math-academy-id "q-13468" :question/problem "Determine the real roots of the cubic equation $2{x}^{3}-40{x}^{2}+35x=-3{x}^{3}.$" :question/worked-solution "First, let's rewrite the polynomial equation in the form ${P}_{n}(x)=0.$ To do this, we subtract all the terms from the right-hand side so that the right-hand side becomes $0:$\n\n$$\n\\begin{aligned}2{x}^{3}-40{x}^{2}+35x=-3{x}^{3} \\\\ 5{x}^{3}-40{x}^{2}+35x & =0\\end{aligned}\n$$\n\nNext, notice that all of the terms of the polynomial have a common factor of $5x.$ We can factor out the $5x$ as follows:\n\n$$\n\\begin{aligned}5{x}^{3}-40{x}^{2}+35x & =0 \\\\ 5x({x}^{2}-8x+7) & =0\\end{aligned}\n$$\n\nNow, we factor the expression ${x}^{2}-8x+7$ as follows:\n\n$$\n\\begin{aligned}5x({x}^{2}-8x+7) & =0 \\\\ 5x(x-1)(x-7) & =0\\end{aligned}\n$$\n\nFinally, by applying the zero product rule, the solutions are $x=0,$ $x=1,$ and $x=7.$"} :step/id #uuid "33189ef3-2537-5d6d-bc82-5263f6083b68" :step/next {:db/id #edb/ref 17592186496384}} {:db/id #edb/ref 17592186496359 :step/content {:db/id #edb/ref 17592186496320 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "296694e3-5319-547a-8c8f-0fc26e3a8b01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=-2,\\,-3,\\,5" :db/id #edb/ref 17592186495601} {:answer/id #uuid "4658aaeb-11d9-5b92-a7a2-aea2864fd98a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=-2,\\,0,\\,5" :db/id #edb/ref 17592186495668} {:answer/id #uuid "4a808032-3416-51f3-bad1-93a62d09b580" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=-3,\\,0,\\,5" :db/id #edb/ref 17592186495681} {:answer/id #uuid "ab32c019-df2f-511a-adec-83c31e26c5c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=-3,\\,0,\\,2" :db/id #edb/ref 17592186495894} {:answer/id #uuid "de7814e7-b746-525b-9bf4-f606ff9e5397" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=-2,\\,0,\\,3" :db/id #edb/ref 17592186496001}] :answer-field/correct {:db/id #edb/ref 17592186495668} :answer-field/id #uuid "498bf339-9275-5f3a-b0a2-353256e90566" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496111}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e5110c54-de9e-5958-ac4d-933027f79b9c" :question/math-academy-id "q-3977" :question/problem "If ${z}^{3}-5{z}^{2}=-2{z}^{3}+4{z}^{2}+30z$, then $z=$" :question/worked-solution "First, let's rewrite the polynomial equation in the form ${P}_{n}(z)=0.$ To do this, we subtract all the terms from the right-hand side so that the right-hand side becomes $0:$\n\n$$\n\\begin{aligned}{z}^{3}-5{z}^{2} & =-2{z}^{3}+4{z}^{2}+30z \\\\ 3{z}^{3}-5{z}^{2} & =4{z}^{2}+30z \\\\ 3{z}^{3}-9{z}^{2} & =30z \\\\ 3{z}^{3}-9{z}^{2}-30z & =0\\end{aligned}\n$$\n\nNext, notice that all of the terms of the polynomial have a common factor of $3z.$ We can factor out the $3z$ as follows:\n\n$$\n\\begin{aligned}3{z}^{3}-9{z}^{2}-30z & =0 \\\\ 3z({z}^{2}-3z-10) & =0\\end{aligned}\n$$\n\nNow, we factor the expression ${z}^{2}-3z-10$ as follows:\n\n$$\n\\begin{aligned}3z({z}^{2}-3z-10) & =0 \\\\ 3z(z-5)(z+2) & =0\\end{aligned}\n$$\n\nFinally, by applying the zero product rule, the solutions are $z=0,$ $z=5,$ and $z=-2.$"} :step/id #uuid "7a071822-f696-57c7-88e1-34d9df2aee28" :step/next {:db/id #edb/ref 17592186496339}} {:db/id #edb/ref 17592186496377 :step/content {:db/id #edb/ref 17592186496239 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5758ad16-c0ab-5d62-9062-a5e1852a1ecb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "q=0,\\frac{1}{4},\\frac{7}{3}" :db/id #edb/ref 17592186495709} {:answer/id #uuid "58c04939-8a35-5369-8ee1-e4c5c6a44dcb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "q=-\\frac{1}{4},0,\\frac{7}{3}" :db/id #edb/ref 17592186495711} {:answer/id #uuid "9c635ebe-460c-57fc-bda8-85bc876110bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "q=0,\\frac{1}{2},\\frac{2}{3}" :db/id #edb/ref 17592186495856} {:answer/id #uuid "9d42bf30-69fa-5a6e-b1ed-9340cc4961f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "q=-\\frac{7}{3},0,\\frac{1}{2}" :db/id #edb/ref 17592186495859} {:answer/id #uuid "deaccec4-56c9-5b23-85bf-5b3cc902fd7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "q=-\\frac{2}{3},0,\\frac{1}{2}" :db/id #edb/ref 17592186496002}] :answer-field/correct {:db/id #edb/ref 17592186495709} :answer-field/id #uuid "f5a06e05-cc0b-5c55-b5b3-baf5f29d4969" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496211}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3008b0e3-f22d-5042-85e1-28ca9b5446f9" :question/math-academy-id "q-114115" :question/problem "Find the roots of the polynomial $p(q)=24{q}^{5}-62{q}^{4}+14{q}^{3}.$" :question/worked-solution "To find the roots of the polynomial, we must solve the equation $p(q)=0,$ that is\n\n$$\n24{q}^{5}-62{q}^{4}+14{q}^{3}=0.\n$$\n\nFirst, notice that all of the terms of the polynomial have a common factor of $2{q}^{3}.$ We can factor out the $2{q}^{3}$ as follows:\n\n$$\n\\begin{aligned}2{q}^{3}(12{q}^{2}-31q+7) & =0\\end{aligned}\n$$\n\nNow, we factor the expression $12{q}^{2}-31q+7$ as follows:\n\n$$\n\\begin{aligned}2{q}^{3}(12{q}^{2}-31q+7) & =0 \\\\ 2{q}^{3}(4q-1)(3q-7) & =0\\end{aligned}\n$$\n\nFinally, by applying the zero product rule, the solutions are $q=0,$ $q=\\frac{1}{4},$ and $q=\\frac{7}{3}.$"} :step/id #uuid "b6032cac-7227-50be-bd02-a7e99e5c604e"} {:db/id #edb/ref 17592186496384 :step/content {:db/id #edb/ref 17592186496232 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a7f8b6a-b45f-5c8f-976f-c74371307306" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{3}{2},\\,0,\\,5" :db/id #edb/ref 17592186495604} {:answer/id #uuid "2ef04ceb-f8ca-59cb-a20c-50d2cfae9748" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-3,\\,0,\\,\\frac{5}{2}" :db/id #edb/ref 17592186495619} {:answer/id #uuid "54fe2ab0-a2bf-5bbd-9fd1-b40e561d0d65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=0,\\,\\frac{3}{2},\\,5" :db/id #edb/ref 17592186495702} {:answer/id #uuid "7df9dce5-1c6b-524b-acaa-612aa3aa8726" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{5}{2},\\,0,\\,3" :db/id #edb/ref 17592186495779} {:answer/id #uuid "d8e90b27-c675-5414-9bc3-46e6840f53ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=0,\\,\\frac{5}{2},\\,3" :db/id #edb/ref 17592186495989}] :answer-field/correct {:db/id #edb/ref 17592186495619} :answer-field/id #uuid "8d094d0f-7279-5a6e-957a-b3ab099b5eaf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496145}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1946edce-9ce1-5523-bab8-ee5e33cceb1e" :question/math-academy-id "q-71781" :question/problem "Find the roots of the polynomial $p(y)=6{y}^{4}+3{y}^{3}-45{y}^{2}.$" :question/worked-solution "To find the roots of the polynomial, we must solve the equation $p(y)=0,$ that is\n\n$$\n6{y}^{4}+3{y}^{3}-45{y}^{2}=0.\n$$\n\nFirst, notice that all of the terms of the polynomial have a common factor of $3{y}^{2}.$ We can factor out the $3{y}^{2}$ as follows:\n\n$$\n\\begin{aligned}3{y}^{2}(2{y}^{2}+y-15) & =0\\end{aligned}\n$$\n\nNow, we factor the expression $2{y}^{2}+y-15$ as follows:\n\n$$\n\\begin{aligned}3{y}^{2}(2{y}^{2}+y-15) & =0 \\\\ 3{y}^{2}(y+3)(2y-5) & =0\\end{aligned}\n$$\n\nFinally, by applying the zero product rule, the solutions are $y=0,$ $y=-3,$ and $y=\\frac{5}{2}.$"} :step/id #uuid "dda68f1a-9f99-577a-bd6c-e52e201e6e2e" :step/next {:db/id #edb/ref 17592186496377}}] :activity/title "Solving Polynomial Equations Using the GCF" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186495502}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186536009} :activity/id #uuid "3feed6d1-a0d5-5ab7-9ea2-a3df2bac55db" :activity/scope {:db/id #edb/ref 17592186050364 :topic/id #uuid "42f68342-78b4-5e6c-a159-7ae8ddb5e91f" :topic/math-academy-id 480} :activity/steps [{:db/id #edb/ref 17592186536009 :step/content {:db/id #edb/ref 17592186535924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c92523a-b06e-5c14-a2cd-5360c00395b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=0,\\,1,\\,\\frac{1}{2}" :db/id #edb/ref 17592186535459} {:answer/id #uuid "1640a20d-e4d1-5015-9cda-627837d66005" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-2,\\,0,\\,1" :db/id #edb/ref 17592186535471} {:answer/id #uuid "5b1e67e5-bec5-5ea7-bdf3-f27057c7ae46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{2},\\,0,\\,\\frac{1}{2}" :db/id #edb/ref 17592186535579} {:answer/id #uuid "e8cf239b-fa18-5105-96fb-3beeb63f74e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{2},\\,0,\\,\\frac{1}{3}" :db/id #edb/ref 17592186535794} {:answer/id #uuid "f7dc453a-52bf-5f89-b1b6-01e35d12e5aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{2},\\,0,\\,1" :db/id #edb/ref 17592186535812}] :answer-field/correct {:db/id #edb/ref 17592186535579} :answer-field/id #uuid "f7f1648e-bfb1-591c-80ea-4405790435c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186535921}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "05ed837d-3821-5be3-89df-8ca589e409e2" :question/math-academy-id "q-14005" :question/problem "Determine the real roots of the cubic equation $10{y}^{3}-y=2{y}^{3}+y.$" :question/worked-solution "First, let's rewrite the polynomial equation in the form ${P}_{n}(y)=0.$ To do this, we subtract all the terms from the right-hand side so that the right-hand side becomes $0:$\n\n$$\n\\begin{aligned}10{y}^{3}-y & =2{y}^{3}+y \\\\ 8{y}^{3}-y & =y \\\\ 8{y}^{3}-2y & =0\\end{aligned}\n$$\n\nNext, notice that all of the terms of the polynomial have a common factor of $2y.$ We can factor out the $2y$ as follows:\n\n$$\n\\begin{aligned}8{y}^{3}-2y & =0 \\\\ 2y(4{y}^{2}-1) & =0\\end{aligned}\n$$\n\nNow, we factor the expression $4{y}^{2}-1$ as follows:\n\n$$\n\\begin{aligned}2y(4{y}^{2}-1) & =0 \\\\ 2y(2y+1)(2y-1) & =0\\end{aligned}\n$$\n\nFinally, by applying the zero product rule, the solutions are $y=0,$ $z=-\\frac{1}{2},$ and $y=\\frac{1}{2}.$"} :step/id #uuid "0c49baa4-622e-5e7f-9ddd-42763005e29c" :step/next {:db/id #edb/ref 17592186536045}} {:db/id #edb/ref 17592186536031 :step/content {:db/id #edb/ref 17592186535973 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c64f283-376a-5aea-ad5b-0fd0b69f4c0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=-4,\\,-1,\\,0" :db/id #edb/ref 17592186535479} {:answer/id #uuid "7d7dfd6f-3f62-5676-8e59-619b7bf533ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=-2,\\,-\\frac{1}{2},\\,0" :db/id #edb/ref 17592186535630} {:answer/id #uuid "968b97e4-e536-5306-8c56-99b308114e5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=-2,\\,-1,\\,1" :db/id #edb/ref 17592186535670} {:answer/id #uuid "a2cdcfa6-1b3f-5b11-8574-abd7c13b156b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=-2,\\,0,\\,1" :db/id #edb/ref 17592186535687} {:answer/id #uuid "dce9f8d9-a244-590c-93fe-5a247b012a8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=-6,\\,-\\frac{3}{2},\\,0" :db/id #edb/ref 17592186535772}] :answer-field/correct {:db/id #edb/ref 17592186535630} :answer-field/id #uuid "18396988-80bb-5ded-8e95-066e394e22f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186535840}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9b05fed3-4ab6-51d7-8e10-a90e6b0e2462" :question/math-academy-id "q-70466" :question/problem "Find the roots of the polynomial $p(t)=6{t}^{6}+15{t}^{5}+6{t}^{4}.$" :question/worked-solution "To find the roots of the polynomial, we must solve the equation $p(t)=0,$ that is\n\n$$\n6{t}^{6}+15{t}^{5}+6{t}^{4}=0.\n$$\n\nFirst, notice that all of the terms of the polynomial have a common factor of $3{t}^{4}.$ We can factor out the $3{t}^{4}$ as follows:\n\n$$\n\\begin{aligned}3{t}^{4}(2{t}^{2}+5t+2) & =0\\end{aligned}\n$$\n\nNow, we factor the expression $2{t}^{2}+5t+2$ as follows:\n\n$$\n\\begin{aligned}3{t}^{4}(2{t}^{2}+5t+2) & =0 \\\\ 3{t}^{4}(2t+1)(t+2) & =0\\end{aligned}\n$$\n\nFinally, by applying the zero product rule, the solutions are $t=0,$ $t=-\\frac{1}{2},$ and $t=-2.$"} :step/id #uuid "7e57999b-d68d-5e21-8300-43ec29332e47"} {:db/id #edb/ref 17592186536045 :step/content {:db/id #edb/ref 17592186535932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "055022f7-b555-5b53-bdb6-52590c8cb0bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=0" :db/id #edb/ref 17592186535446} {:answer/id #uuid "4811dac8-5f59-56b0-ac1b-78612918c845" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-1,\\,0" :db/id #edb/ref 17592186535541} {:answer/id #uuid "549aad98-3e4b-5a26-8533-7d549487f2d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=0,\\,3,\\,5" :db/id #edb/ref 17592186535566} {:answer/id #uuid "9807b2dd-bc9a-5693-ad00-0fc00ed47b0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=0,\\,5" :db/id #edb/ref 17592186535674} {:answer/id #uuid "9cbb051b-e065-53ef-b7cf-9b608ab9119d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-1,\\,0,\\,5" :db/id #edb/ref 17592186535682}] :answer-field/correct {:db/id #edb/ref 17592186535446} :answer-field/id #uuid "156cc421-00b2-50d1-b76f-984736c8cfcd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186535839}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1444bcbd-c7af-503c-a5fd-f72a90d6d77a" :question/math-academy-id "q-38109" :question/problem "Solve for $x$ where $4{x}^{3}+3x=3{x}^{3}-4x.$" :question/worked-solution "First, let's rewrite the polynomial equation in the form ${P}_{n}(x)=0.$ To do this, we subtract all the terms from the right-hand side so that the right-hand side becomes $0:$\n\n$$\n\\begin{aligned}4{x}^{3}+3x & =3{x}^{3}-4x \\\\ {x}^{3}+3x & =-4x \\\\ {x}^{3}+7x & =0\\end{aligned}\n$$\n\nNext, notice that all of the terms of the polynomial have a common factor of $x.$ We can factor out the $x$ as follows:\n\n$$\n\\begin{aligned}{x}^{3}+7x & =0 \\\\ x({x}^{2}+7) & =0\\end{aligned}\n$$\n\nSince ${x}^{2}+7=0$ has no real solutions, we cannot factor the expression ${x}^{2}+7$  further.\n\nFinally, by applying the zero product rule, the only solution is $x=0.$"} :step/id #uuid "db2e2257-7721-5598-9a21-bdc28f24d843" :step/next {:db/id #edb/ref 17592186536031}}] :activity/title "Solving Polynomial Equations Using the GCF" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186535429}]}
