#{[{:activity/first-step {:db/id #edb/ref 17592186055521} :activity/id #uuid "5844d9da-308a-5428-8509-e1a619cc5407" :activity/scope {:db/id #edb/ref 17592186048594 :topic/id #uuid "acd6ee8f-99a9-566d-947a-0a7133b158e6" :topic/math-academy-id 121} :activity/steps [{:db/id #edb/ref 17592186055521 :step/content {:db/id #edb/ref 17592186056019 :tutorial/content "As we already know, to evaluate numerical expressions with a mix of different operations, we must follow the order of operations (PEMDAS).\n\nThe same rules apply to numerical expressions with negative numbers. For example, let's compute the value of\n\n$$\n(-2) \\times (-3)^2\n$$\n\nTo evaluate this expression, we use PEMDAS. First, we compute the exponents:\n\n$$\n(-2)\\,\\times\\overbrace{(-3)^2}^{\\large\\color{blue} 9} = (-2) \\times {\\color{blue} 9}\n$$\n\nThen, we multiply:\n\n$$\n(-2) \\times 9 = -18\n$$\n\nTherefore,\n\n$$\n(-2) \\times (-3)^2 = -18\n$$" :tutorial/id #uuid "70914b55-4296-53ed-8b9b-443bffeea358" :tutorial/math-academy-id 8083 :tutorial/title "Introduction"} :step/id #uuid "88234dee-6508-5596-8e07-fe4c5d34c2cd" :step/math-academy-id 132145 :step/next {:db/id #edb/ref 17592186055522}} {:db/id #edb/ref 17592186055522 :step/content {:db/id #edb/ref 17592186054606 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054396 :question/id #uuid "6ce1d2ce-e99a-5f5c-a698-3f744805ef24" :question/math-academy-id "e-12921"} :knowledge-point/id #uuid "fdadd355-0ce5-598a-b9cd-f189ccfb7ca6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048888} {:db/id #edb/ref 17592186049714}] :knowledge-point/questions [{:db/id #edb/ref 17592186055039} {:db/id #edb/ref 17592186055040} {:db/id #edb/ref 17592186055269}] :knowledge-point/title "Evaluating Expressions With Stand-Alone Exponents"} :step/id #uuid "79808ac9-8172-551f-a71d-9565ab867f05" :step/math-academy-id 132146 :step/next {:db/id #edb/ref 17592186055523}} {:db/id #edb/ref 17592186055523 :step/content {:db/id #edb/ref 17592186054607 :