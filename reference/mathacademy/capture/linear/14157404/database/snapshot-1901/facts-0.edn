b/ref 17592186045417] [17592186054398 #edb/ref 1072 #uuid "21fccd11-6107-53b8-beb0-d0c39f23bc17" #edb/ref 17592186045417] [17592186054398 #edb/ref 1074 "To evaluate this expression, we use PEMDAS. First, consider the expression inside the parenthesis:\n\n$$\n\\begin{aligned}5÷(-2)^{2}\\end{aligned}\n$$\n\nApplying PEMDAS to this expression, we obtain:\n\n$$\n\\begin{aligned}5÷(-2)^{2} & = \\\\ 5÷4 & = \\\\ \\frac{5}{4} & \\end{aligned}\n$$\n\nFinally, we multiply:\n\n$$\n\\begin{aligned}(\\overset{\\frac{5}{4}}{\\overset{⏞}{5÷(-2)^{2}}})\\times (-\\frac{4}{5}) & = \\\\ \\frac{5}{4}\\times (-\\frac{4}{5}) & = \\\\ -\\frac{5}{4}\\times \\frac{4}{5} & = \\\\ -\\frac{5\\times 4}{4\\times 5} & = \\\\ -\\frac{\\cancel{5}\\times \\cancel{4}}{\\cancel{4}\\times \\cancel{5}} & = \\\\ -1\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186054606 #edb/ref 1037 #edb/ref 17592186048888 #edb/ref 17592186045417] [17592186054606 #edb/ref 1037 #edb/ref 17592186049714 #edb/ref 17592186045417] [17592186054606 #edb/ref 1038 #edb/ref 17592186055039 #edb/ref 17592186045417] [17592186054606 #edb/ref 1038 #edb/ref 17592186055040 #edb/ref 17592186045417] [17592186054606 #edb/ref 1038 #edb/ref 17592186055269 #edb/ref 17592186045417] [17592186054606 #edb/ref 1038 #edb/ref 17592186480662 #edb/ref 17592186045417] [17592186054606 #edb/ref 1039 "Evaluating Expressions With Stand-Alone Exponents" #edb/ref 17592186045417] [17592186054606 #edb/ref 1041 #edb/ref 17592186054396 #edb/ref 17592186045417] [17592186054606 #edb/ref 1042 #uuid "fdadd355-0ce5-598a-b9cd-f189ccfb7ca6" #edb/ref 17592186045417] [17592186054607 #edb/ref 1037 #edb/ref 17592186048825 #edb/ref 17592186045417] [17592186054607 #edb/ref 1038 #edb/ref 17592186055041 #edb/ref 17592186045417] [17592186054607 #edb/ref 1038 #edb/ref 17592186055042 #edb/ref 17592186045417] [17592186054607 #edb/ref 1038 #edb/ref 17592186055270 #edb/ref 17592186045417] [17592186054607 #edb/ref 1038 #edb/ref 17592186480652 #edb/ref 17592186045417] [17592186054