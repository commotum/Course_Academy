0537 #edb/ref 17592186045417] [17592186480665 #edb/ref 1069 "q-100159" #edb/ref 17592186045417] [17592186480665 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186480665 #edb/ref 1071 "Evaluate $(3\\times (-5)^{2})÷\\frac{5}{2}.$" #edb/ref 17592186045417] [17592186480665 #edb/ref 1072 #uuid "6b52aa6c-ff41-5226-8eac-b56efc594a90" #edb/ref 17592186045417] [17592186480665 #edb/ref 1074 "To evaluate this expression, we use PEMDAS.\n\nFirst, consider the expression inside the parentheses:\n\n$$\n\\begin{aligned}3\\times (-5)^{2}\\end{aligned}\n$$\n\nApplying PEMDAS to this expression, we obtain:\n\n$$\n\\begin{aligned}3\\times (-5)^{2} & = \\\\ 3\\times 25 & = \\\\ 75\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}(3\\times (-5)^{2})÷\\frac{5}{2} & = \\\\ 75÷\\frac{5}{2} & = \\\\ 75\\times \\frac{2}{5} & = \\\\ \\frac{75}{1}\\times \\frac{2}{5} & = \\\\ \\frac{75\\times 2}{1\\times 5} & = \\\\ \\frac{150}{5} & = \\\\ 30\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186480674 #edb/ref 1068 #edb/ref 17592186480530 #edb/ref 17592186045417] [17592186480674 #edb/ref 1069 "q-184059" #edb/ref 17592186045417] [17592186480674 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186480674 #edb/ref 1071 "$(-18)÷((-3)^{4}÷9)=${{field-1}}" #edb/ref 17592186045417] [17592186480674 #edb/ref 1072 #uuid "92e6407b-23f0-522c-8861-cf43d1d90280" #edb/ref 17592186045417] [17592186480674 #edb/ref 1074 "To evaluate this expression, we use PEMDAS.\n\nFirst, consider the expression inside the parentheses:\n\n$$\n\\begin{aligned}(-3)^{4}÷9\\end{aligned}\n$$\n\nApplying PEMDAS to this expression, we obtain:\n\n$$\n\\begin{aligned}(-3)^{4}÷9 & = \\\\ 81÷9 & = \\\\ \\frac{81}{9} & = \\\\ 9\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}(-18)÷((-3)^{4}÷9) & = \\\\ (-18)÷9 & = \\\\ \\frac{(-18)}{9} & = \\\\ -\\frac{18}{9} & = \\\\ -2\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186480695 #edb/ref 1068 #edb/ref 17592186480593 #edb/ref 17592186045417] [17592186480695 #edb/ref 1069 "q-184053" #edb/ref 17592186045417] [17592186480695 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186480695 #edb/ref 1071 "${(2-(-1))}^{4}=${{field-1}}" #edb/ref 17592186045417] [17592186480695 #edb/ref 1072 #uuid "d7d9db10-3db0-5298-a1d1-4ea150f26c84" #edb/ref 17592186045417] [17592186480695 #edb/ref 1074 "To evaluate this expression, we use PEMDAS.\n\nFirst, we perform the operation inside the parentheses:\n\n$$\n\\begin{aligned}{(2-(-1))}^{4} & ={(3)}^{4}\\end{aligned}\n$$\n\nNext, we compute the exponent:\n\n$$\n\\begin{aligned}{(3)}^{4} & =81\\end{aligned}\n$$" #edb/ref 17592186045417]}
