#{[{:db/id #edb/ref 17592186054396 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054606 :knowledge-point/id #uuid "fdadd355-0ce5-598a-b9cd-f189ccfb7ca6" :knowledge-point/title "Evaluating Expressions With Stand-Alone Exponents"}] :question/id #uuid "6ce1d2ce-e99a-5f5c-a698-3f744805ef24" :question/math-academy-id "e-12921" :question/problem "Calculate $(-3)^3 \\div 6$." :question/worked-solution "To evaluate this expression, we use PEMDAS. First, we compute the exponents:\n\n$$\n\\begin{aligned}{{(-3)^{3}}_{⏟}}_{-27}÷6=(-27)÷6\\end{aligned}\n$$\n\nThen, we divide:\n\n$$\n\\begin{aligned}(-27)÷6 & = \\\\ \\frac{(-27)}{6} & = \\\\ -\\frac{27}{6} & = \\\\ -\\frac{27÷3}{6÷3} & = \\\\ -\\frac{9}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054397 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054607 :knowledge-point/id #uuid "cd0c74c4-8496-5bfa-add1-5c3fed61d13f" :knowledge-point/title "Evaluating Expressions With Exponents Outside Parentheses"}] :question/id #uuid "d4bc50be-7125-55ef-9d29-c69af56e25d3" :question/math-academy-id "e-12922" :question/problem "Evaluate $(1-4)^2 \\times \\dfrac{1}{12}.$" :question/worked-solution "To evaluate this expression, we use PEMDAS. First, we perform the operation inside the parentheses:\n\n$$\n\\begin{aligned}({{1-4}_{⏟}}_{-3})^{2}\\times \\frac{1}{12} & =(-3)^{2}\\times \\frac{1}{12}\\end{aligned}\n$$\n\nNext, we compute the exponents:\n\n$$\n\\begin{aligned}{{(-3)^{2}}_{⏟}}_{9}\\times \\frac{1}{12} & =9\\times \\frac{1}{12}\\end{aligned}\n$$\n\nFinally, we multiply:\n\n$$\n\\begin{aligned}9\\times \\frac{1}{12} & = \\\\ \\frac{9}{1}\\times \\frac{1}{12} & = \\\\ \\frac{9\\times 1}{1\\times 12} & = \\\\ \\frac{9}{12} & = \\\\ \\frac{9÷3}{12÷3} & = \\\\ \\frac{3}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054398 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054608 :knowledge-point/id #uuid "4cc66e18-1adb-5bec-a6c6-f434ebf4ed13" :knowledge-point/title "Evaluating Expressions With Exponents Inside Parentheses"}] :question/id #uuid "21fccd11-6107-53b8-beb0-d0c39f23bc17" :question/math-academy-id "e-12923" :question/problem "What is the value of $\\left( 5 \\div (-2)^2 \\right) \\times \\left( -\\dfrac{4}{5} \\right).$" :question/worked-solution "To evaluate this expression, we use PEMDAS. First, consider the expression inside the parenthesis:\n\n$$\n\\begin{aligned}5÷(-2)^{2}\\end{aligned}\n$$\n\nApplying PEMDAS to this expression, we obtain:\n\n$$\n\\begin{aligned}5÷(-2)^{2} & = \\\\ 5÷4 & = \\\\ \\frac{5}{4} & \\end{aligned}\n$$\n\nFinally, we multiply:\n\n$$\n\\begin{aligned}(\\overset{\\frac{5}{4}}{\\overset{⏞}{5÷(-2)^{2}}})\\times (-\\frac{4}{5}) & = \\\\ \\frac{5}{4}\\times (-\\frac{4}{5}) & = \\\\ -\\frac{5}{4}\\times \\frac{4}{5} & = \\\\ -\\frac{5\\times 4}{4\\times 5} & = \\\\ -\\frac{\\cancel{5}\\times \\cancel{4}}{\\cancel{4}\\times \\cancel{5}} & = \\\\ -1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186480665 :knowledge-point/_questions [{:db/id #edb/ref 17592186054608 :knowledge-point/id #uuid "4cc66e18-1adb-5bec-a6c6-f434ebf4ed13" :knowledge-point/title "Evaluating Expressions With Exponents Inside Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a185603-b4f1-56c6-ba48-0f42bd7d26a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186480151} {:answer/id #uuid "4a2f878c-fec5-5755-96bb-1161995eeedf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186480237} {:answer/id #uuid "55a85215-f199-5cc4-8988-d8d0f0927e6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "187.5" :db/id #edb/ref 17592186480255} {:answer/id #uuid "6acc2ab7-51cb-51f1-a07f-1a3b4d54d305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186480283} {:answer/id #uuid "9306faf8-4093-5e6f-9781-92a5fd1a0a66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-187.5" :db/id #edb/ref 17592186480351}] :answer-field/correct {:answer/id #uuid "6acc2ab7-51cb-51f1-a07f-1a3b4d54d305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186480283} :answer-field/id #uuid "10176a3c-6389-5f3b-b3b8-ccc8df0a7ec2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186480537}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6b52aa6c-ff41-5226-8eac-b56efc594a90" :question/math-academy-id "q-100159" :question/problem "Evaluate $(3\\times (-5)^{2})÷\\frac{5}{2}.$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, consider the expression inside the parentheses:\n\n$$\n\\begin{aligned}3\\times (-5)^{2}\\end{aligned}\n$$\n\nApplying PEMDAS to this expression, we obtain:\n\n$$\n\\begin{aligned}3\\times (-5)^{2} & = \\\\ 3\\times 25 & = \\\\ 75\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}(3\\times (-5)^{2})÷\\frac{5}{2} & = \\\\ 75÷\\frac{5}{2} & = \\\\ 75\\times \\frac{2}{5} & = \\\\ \\frac{75}{1}\\times \\frac{2}{5} & = \\\\ \\frac{75\\times 2}{1\\times 5} & = \\\\ \\frac{150}{5} & = \\\\ 30\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186480662 :knowledge-point/_questions [{:db/id #edb/ref 17592186054606 :knowledge-point/id #uuid "fdadd355-0ce5-598a-b9cd-f189ccfb7ca6" :knowledge-point/title "Evaluating Expressions With Stand-Alone Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4140eae-8d2c-5e0e-99c8-5016610f0c02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186480469}] :answer-field/correct {:answer/id #uuid "d4140eae-8d2c-5e0e-99c8-5016610f0c02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186480469} :answer-field/id #uuid "066805a8-839c-56e1-9e27-03e5c7c1c20b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186480529}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "60199b98-6c64-506f-9047-6445f428ee81" :question/math-academy-id "q-184045" :question/problem "${6}^{3}÷{(-3)}^{2}+10=${{field-1}}" :question/worked-solution "To evaluate the given expression, we use PEMDAS. \n\nFirst, we compute the exponent:\n\n$$\n\\begin{aligned}{6}^{3}÷{(-3)}^{2}+10 & =216÷9+10\\end{aligned}\n$$\n\nNext, we divide:\n\n$$\n\\begin{aligned}216÷9+10 & =24+10\\end{aligned}\n$$\n\nFinally, we add:\n\n$$\n\\begin{aligned}24+10 & =34\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186480695 :knowledge-point/_questions [{:db/id #edb/ref 17592186054607 :knowledge-point/id #uuid "cd0c74c4-8496-5bfa-add1-5c3fed61d13f" :knowledge-point/title "Evaluating Expressions With Exponents Outside Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a826d516-fc9a-5f75-ba9d-55064109e5c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186480393}] :answer-field/correct {:answer/id #uuid "a826d516-fc9a-5f75-ba9d-55064109e5c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186480393} :answer-field/id #uuid "ac0f6ff2-731e-5fb2-9004-a75026c24a4d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186480593}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d7d9db10-3db0-5298-a1d1-4ea150f26c84" :question/math-academy-id "q-184053" :question/problem "${(2-(-1))}^{4}=${{field-1}}" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, we perform the operation inside the parentheses:\n\n$$\n\\begin{aligned}{(2-(-1))}^{4} & ={(3)}^{4}\\end{aligned}\n$$\n\nNext, we compute the exponent:\n\n$$\n\\begin{aligned}{(3)}^{4} & =81\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186480674 :knowledge-point/_questions [{:db/id #edb/ref 17592186054608 :knowledge-point/id #uuid "4cc66e18-1adb-5bec-a6c6-f434ebf4ed13" :knowledge-point/title "Evaluating Expressions With Exponents Inside Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8bbbd880-d7e2-5a44-b42a-0dfce6cf9fa9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186480347}] :answer-field/correct {:answer/id #uuid "8bbbd880-d7e2-5a44-b42a-0dfce6cf9fa9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186480347} :answer-field/id #uuid "06fd876a-80c1-5d01-8d82-49f786db185b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186480530}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "92e6407b-23f0-522c-8861-cf43d1d90280" :question/math-academy-id "q-184059" :question/problem "$(-18)÷((-3)^{4}÷9)=${{field-1}}" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, consider the expression inside the parentheses:\n\n$$\n\\begin{aligned}(-3)^{4}÷9\\end{aligned}\n$$\n\nApplying PEMDAS to this expression, we obtain:\n\n$$\n\\begin{aligned}(-3)^{4}÷9 & = \\\\ 81÷9 & = \\\\ \\frac{81}{9} & = \\\\ 9\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}(-18)÷((-3)^{4}÷9) & = \\\\ (-18)÷9 & = \\\\ \\frac{(-18)}{9} & = \\\\ -\\frac{18}{9} & = \\\\ -2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186055269 :knowledge-point/_questions [{:db/id #edb/ref 17592186054606 :knowledge-point/id #uuid "fdadd355-0ce5-598a-b9cd-f189ccfb7ca6" :knowledge-point/title "Evaluating Expressions With Stand-Alone Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a66648cb-8f77-50c9-893b-aedc4963bcc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "37" :db/id #edb/ref 17592186052852} {:answer/id #uuid "b36b0693-1103-5abf-95a7-39b28db21c7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186052853} {:answer/id #uuid "bfa7a2bb-27be-5cfc-8be2-2abb2d0d90ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "55" :db/id #edb/ref 17592186052854} {:answer/id #uuid "f546ef42-84c8-5376-84c5-ad082e37282c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186052855} {:answer/id #uuid "4f7aa1a8-a1e0-58a3-9255-7868dd176226" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186052856}] :answer-field/correct {:answer/id #uuid "a66648cb-8f77-50c9-893b-aedc4963bcc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "37" :db/id #edb/ref 17592186052852} :answer-field/id #uuid "a6737b0c-55e1-56fc-bfb1-13dc14fd1b5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186052851}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bbc810b0-69a7-578e-ab11-1175446069d2" :question/math-academy-id "q-41369" :question/problem "${(-3)}^{3}+{4}^{3}=$" :question/worked-solution "To evaluate the given expression, we use PEMDAS. \n\nFirst, we compute the exponents:\n\n$$\n\\begin{aligned}{(-3)}^{3}+{4}^{3}=(-27)+64\\end{aligned}\n$$\n\nThen, we add:\n\n$$\n\\begin{aligned}(-27)+64 & = \\\\ -27+64 & = \\\\ 37\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186480652 :knowledge-point/_questions [{:db/id #edb/ref 17592186054607 :knowledge-point/id #uuid "cd0c74c4-8496-5bfa-add1-5c3fed61d13f" :knowledge-point/title "Evaluating Expressions With Exponents Outside Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f16fb76-561f-5985-b803-dd56f0fcf567" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1.1" :db/id #edb/ref 17592186480140} {:answer/id #uuid "3e3ae491-0f8d-5d23-8289-5393976f40be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1.21" :db/id #edb/ref 17592186480212} {:answer/id #uuid "60d2bcd6-4428-5daf-bfe4-cc552b9a3737" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.2" :db/id #edb/ref 17592186480271} {:answer/id #uuid "8c98df10-4012-56be-8b7c-b9ee5cfd1c8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.21" :db/id #edb/ref 17592186480348} {:answer/id #uuid "9338d58f-79e1-5985-bb0f-b5100440f147" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.1" :db/id #edb/ref 17592186480352}] :answer-field/correct {:answer/id #uuid "8c98df10-4012-56be-8b7c-b9ee5cfd1c8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.21" :db/id #edb/ref 17592186480348} :answer-field/id #uuid "f5089030-2059-5200-9422-292b5fbd6651" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186480622}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "43b02df2-3069-56a3-b787-8172b48fa9f2" :question/math-academy-id "q-68917" :question/problem "Find the value of ${(-3+1.9)}^{2}.$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, we perform the operation inside the parentheses:\n\n$$\n\\begin{aligned}{(-3+1.9)}^{2} & ={(-1.1)}^{2}\\end{aligned}\n$$\n\nNext, we compute the exponent:\n\n$$\n\\begin{aligned}{(-1.1)}^{2} & =1.21\\end{aligned}\n$$"}]}
