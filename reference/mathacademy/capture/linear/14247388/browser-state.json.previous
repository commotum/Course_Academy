12</mn><mi>z</mi></mtd></mtr><mtr><mtd><mn>9</mn><mi>z</mi><mo>+</mo><mn>7</mn></mtd><mtd><mi></mi><mo>&gt;</mo><mo>−</mo><mn>56</mn></mtd></mtr><mtr><mtd><mn>9</mn><mi>z</mi><mo>+</mo><mn>7</mn><mo>−</mo><mn>7</mn></mtd><mtd><mi></mi><mo>&gt;</mo><mo>−</mo><mn>56</mn><mo>−</mo><mn>7</mn></mtd></mtr><mtr><mtd><mn>9</mn><mi>z</mi></mtd><mtd><mi></mi><mo>&gt;</mo><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>63</mn></mrow></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>9</mn><mi>z</mi></mrow><mn>9</mn></mfrac></mstyle></mtd><mtd><mi></mi><mo>&gt;</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo>−</mo><mn>63</mn></mrow><mn>9</mn></mfrac></mstyle></mtd></mtr><mtr><mtd><mi>z</mi></mtd><mtd><mi></mi><mo>&gt;</mo><mo>−</mo><mn>7</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Therefore, the solution is <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"28\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D467 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3E\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c37\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>z</mi><mo>&gt;</mo><mo>−</mo><mn>7.</mn></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
