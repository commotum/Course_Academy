#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186565497} :activity/id #uuid "1a4c718f-9ee3-5414-894e-1ae72bee4b15" :activity/scope {:db/id #edb/ref 17592186048312 :topic/id #uuid "93c53f5b-1566-5fb9-ab22-72c79a0d93e3" :topic/math-academy-id 4034} :activity/steps [{:db/id #edb/ref 17592186565497 :step/content {:db/id #edb/ref 17592186192941 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03dd1bfc-524a-526c-ab47-ea2176047136" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x<1" :db/id #edb/ref 17592186564945} {:answer/id #uuid "47aa3e32-e1b5-524e-93ad-e8eb5b6262a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x>-1" :db/id #edb/ref 17592186565042} {:answer/id #uuid "a27ca631-3d74-5d12-a5b9-dd9f1c08420e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x<-1" :db/id #edb/ref 17592186565185} {:answer/id #uuid "b8429d24-fcb3-5137-8d24-cdf2001e2ab4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x>3" :db/id #edb/ref 17592186565214} {:answer/id #uuid "ee93ae1d-35f0-50c0-842b-0fc48ec6a8af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x>1" :db/id #edb/ref 17592186565297}] :answer-field/correct {:db/id #edb/ref 17592186564945} :answer-field/id #uuid "994fb7fa-8d18-55d7-b9a1-980f563daff5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186189532}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d3a826f8-4b21-5324-8e83-97a3d69a92ff" :question/math-academy-id "q-101941" :question/problem "Solve the inequality $\\frac{7-3x}{2}>2.$" :question/worked-solution "First, we clear the rational expression by multiplying both sides by $2:$\n\n$$\n\\begin{aligned}\\frac{7-3x}{2} & >2 \\\\ 2\\cdot (\\frac{7-3x}{2}) & >2\\cdot 2 \\\\ \\cancel{2}\\cdot (\\frac{7-3x}{\\cancel{2}}) & >2\\cdot 2 \\\\ 7-3x & >4\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles. \n\nRemember, when we divide an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}7-3x & >4 \\\\ 7-3x-7 & >4-7 \\\\ -3x & >-3 \\\\ \\frac{-3x}{-3} & \\,\\,<\\,\\,\\frac{-3}{-3} \\\\ x & <1\\end{aligned}\n$$\n\nTherefore, the solution is $x<1.$"} :step/id #uuid "2ac4dc87-187f-5c3d-9eca-e0c9ba64b6b0" :step/next {:db/id #edb/ref 17592186565512}} {:db/id #edb/ref 17592186565502 :step/content {:db/id #edb/ref 17592186565471 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3519c2e5-5f0c-5be4-91e1-e42db2f66c0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z>-7" :db/id #edb/ref 17592186565017} {:answer/id #uuid "4bb378fe-4f71-5580-ab7e-5f601b873bc5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z>-5" :db/id #edb/ref 17592186565047} {:answer/id #uuid "9926e2fb-fd74-51d3-bba5-349637b1d762" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z<5" :db/id #edb/ref 17592186565170} {:answer/id #uuid "e606c3e3-7dab-5779-990d-e0e59050c9ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z<-5" :db/id #edb/ref 17592186565279} {:answer/id #uuid "ee0b25a1-2583-58a7-a151-48ea5344260a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z<7" :db/id #edb/ref 17592186565296}] :answer-field/correct {:db/id #edb/ref 17592186565017} :answer-field/id #uuid "eb1ad4f1-13a1-54ac-b3a4-af4682c466cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186565399}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "dc1245c0-95c3-5566-8f75-3345f8116530" :question/math-academy-id "q-156054" :question/problem "Solve the inequality $\\frac{3z+1}{2}>\\frac{-28+6z}{7}.$" :question/worked-solution "First, we clear the rational expressions by multiplying both sides of the inequality by the lowest common positive multiple of the denominators:\n\n$$\n\\begin{aligned}\\frac{3z+1}{2} & >\\frac{-28+6z}{7} \\\\ 14\\cdot (\\frac{3z+1}{2}) & >14\\cdot (\\frac{-28+6z}{7}) \\\\ 7\\cdot (3z+1) & >2\\cdot (-28+6z) \\\\ 21z+7 & >-56+12z\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles:\n\n$$\n\\begin{aligned}21z+7 & >-56+12z \\\\ 21z+7-12z & >-56+12z-12z \\\\ 9z+7 & >-56 \\\\ 9z+7-7 & >-56-7 \\\\ 9z & >-63 \\\\ \\frac{9z}{9} & >\\frac{-63}{9} \\\\ z & >-7\\end{aligned}\n$$\n\nTherefore, the solution is $z>-7.$"} :step/id #uuid "4f1bcea5-74e1-54ba-8b4a-990ce6157849" :step/next {:db/id #edb/ref 17592186565511}} {:db/id #edb/ref 17592186565511 :step/content {:db/id #edb/ref 17592186565450 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c20ac5a-f811-58a6-b83e-5889a9700680" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{45}{11}" :db/id #edb/ref 17592186565127}] :answer-field/correct {:db/id #edb/ref 17592186565127} :answer-field/id #uuid "0556b669-b38b-5beb-96f6-08e8bd808d5b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186565328} {:answer-field/choices [{:answer/id #uuid "b40dda2b-d093-582e-8a93-141dcd009b0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le" :db/id #edb/ref 17592186565209}] :answer-field/correct {:db/id #edb/ref 17592186565209} :answer-field/id #uuid "592b7cac-318f-5d38-9731-e0a49d20cd01" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186565350}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a275c58b-24cd-59ec-af04-d47c2cd4c395" :question/math-academy-id "q-181376" :question/problem "Find the solution to the inequality $\\frac{3-5z}{8}\\le 6-2z.$\n\nThe solution is $z$\n{{field-1}}{{field-2}}." :question/worked-solution "First, we clear the rational expression by multiplying both sides by $8:$\n\n$$\n\\begin{aligned}\\frac{3-5z}{8} & \\le 6-2z \\\\ 8\\cdot (\\frac{3-5z}{8}) & \\le 8\\cdot (6-2z) \\\\ \\cancel{8}\\cdot (\\frac{3-5z}{\\cancel{8}}) & \\le 8\\cdot (6-2z) \\\\ 3-5z & \\le 48-16z\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles:\n\n$$\n\\begin{aligned}3-5z & \\le 48-16z \\\\ 3-5z+16z & \\le 48-16z+16z \\\\ 3+11z & \\le 48 \\\\ 3+11z-3 & \\le 48-3 \\\\ 11z & \\le 45 \\\\ \\frac{11z}{11} & \\le \\frac{45}{11} \\\\ z & \\le \\frac{45}{11}\\end{aligned}\n$$\n\nTherefore, the solution is $z\\le \\frac{45}{11}.$"} :step/id #uuid "6c393902-7f32-566b-b8b1-1ba0ecc047ce" :step/next {:db/id #edb/ref 17592186565541}} {:db/id #edb/ref 17592186565512 :step/content {:db/id #edb/ref 17592186565426 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31acdef2-9f74-5071-a506-a89cb8de8967" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a<\\frac{33}{4}" :db/id #edb/ref 17592186565012} {:answer/id #uuid "57dc35d6-a280-5f88-b102-c62b5b783067" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a>\\frac{33}{4}" :db/id #edb/ref 17592186565074} {:answer/id #uuid "ad14d68e-ca86-505f-bc2e-62689bb72b3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a<-\\frac{33}{4}" :db/id #edb/ref 17592186565196} {:answer/id #uuid "ba9847dc-820c-5f4c-ac3e-314918c2a2b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a>-\\frac{33}{4}" :db/id #edb/ref 17592186565222} {:answer/id #uuid "dcee4a9e-e91f-5041-879e-d70732fa07ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a>\\frac{33}{2}" :db/id #edb/ref 17592186565265}] :answer-field/correct {:db/id #edb/ref 17592186565074} :answer-field/id #uuid "6cd1d0a2-4c61-5c3b-bb28-d1ae4bccad5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186565360}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4a18f4a9-430a-58c6-95f9-9ffd1a99116a" :question/math-academy-id "q-154925" :question/problem "Solve the inequality $3a-7>\\frac{8a+5}{4}.$" :question/worked-solution "First, we clear the rational expression by multiplying both sides by $4:$\n\n$$\n\\begin{aligned}3a-7 & >\\frac{8a+5}{4} \\\\ 4\\cdot (3a-7) & >4\\cdot (\\frac{8a+5}{4}) \\\\ 4\\cdot (3a-7) & >\\cancel{4}\\cdot (\\frac{8a+5}{\\cancel{4}}) \\\\ 4\\cdot (3a-7) & >8a+5 \\\\ 12a-28 & >8a+5\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles:\n\n$$\n\\begin{aligned}12a-28 & >8a+5 \\\\ 12a-28-8a & >8a+5-8a \\\\ 4a-28 & >5 \\\\ 4a-28+28 & >5+28 \\\\ 4a & >33 \\\\ \\frac{4a}{4} & >\\frac{33}{4} \\\\ a & >\\frac{33}{4}\\end{aligned}\n$$\n\nTherefore, the solution is $a>\\frac{33}{4}.$"} :step/id #uuid "6fd0a23d-7910-5d96-8f76-34d1a79f2112" :step/next {:db/id #edb/ref 17592186565502}} {:db/id #edb/ref 17592186565541 :step/content {:db/id #edb/ref 17592186565435 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b16f81c-e174-5d24-b5c3-e147e2a28ebb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186565173}] :answer-field/correct {:db/id #edb/ref 17592186565173} :answer-field/id #uuid "617e3c87-3819-5e4d-88da-1609df57e47e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186565356} {:answer-field/choices [{:answer/id #uuid "52ebf2e5-0884-5026-a89a-4586159854f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{18}{5}" :db/id #edb/ref 17592186565060}] :answer-field/correct {:db/id #edb/ref 17592186565060} :answer-field/id #uuid "dd9b0211-f69a-526f-b18b-0a11d5fc2f14" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186565393}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5cd68e49-7c20-564f-9257-0043b16b7cd5" :question/math-academy-id "q-181417" :question/problem "Find the solution to the inequality $\\frac{x+6}{4}>\\frac{2x}{3}.$\n\nThe solution is $x$\n{{field-1}}{{field-2}}." :question/worked-solution "First, we clear the rational expressions by multiplying both sides of the inequality by the lowest common positive multiple of the denominators:\n\n$$\n\\begin{aligned}\\frac{x+6}{4} & >\\frac{2x}{3} \\\\ 12\\cdot (\\frac{x+6}{4}) & >12\\cdot (\\frac{2x}{3}) \\\\ 3\\cdot (x+6) & >4\\cdot 2x \\\\ 3x+18 & >8x\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles. \n\nRemember, when we divide an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}3x+18 & >8x \\\\ 3x+18-8x & >8x-8x \\\\ 18-5x & >0 \\\\ 18-5x-18 & >0-18 \\\\ -5x & >-18 \\\\ \\frac{-5x}{-5} & \\,\\,<\\,\\,\\frac{-18}{-5} \\\\ x & <\\frac{18}{5}\\end{aligned}\n$$\n\nTherefore, the solution is $x<\\frac{18}{5}.$"} :step/id #uuid "ff60ef8b-6d6e-5dfc-8313-798cacb1cd63"}] :activity/title "Further Solving Linear Inequalities" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186564926}]}
