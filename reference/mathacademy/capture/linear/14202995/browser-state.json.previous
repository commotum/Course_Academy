frac></mstyle></mtd><mtd><mo>=</mo></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msqrt><mn>11</mn><mi>p</mi><mi>q</mi></msqrt><mrow><mo stretchy=\"false\">(</mo><msqrt><mi>p</mi><mi>q</mi></msqrt><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mrow></mfrac></mstyle></mtd><mtd><mo>=</mo></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><msqrt><mn>11</mn><mi>p</mi><mi>q</mi></msqrt></mpadded></mstyle><mrow><mi>p</mi><mi>q</mi></mrow></mfrac></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
