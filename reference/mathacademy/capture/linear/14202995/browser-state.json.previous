displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msqrt><mi>x</mi><mo>+</mo><mn>2</mn></msqrt><msqrt><mn>2</mn><mo>−</mo><mi>x</mi></msqrt></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msqrt><mi>x</mi><mo>+</mo><mn>2</mn></msqrt><msqrt><mn>2</mn><mo>−</mo><mi>x</mi></msqrt></mfrac></mstyle><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msqrt><mn>2</mn><mo>−</mo><mi>x</mi></msqrt><msqrt><mn>2</mn><mo>−</mo><mi>x</mi></msqrt></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><msqrt><mi>x</mi><mo>+</mo><mn>2</mn></msqrt><mo>⋅</mo><msqrt><mn>2</mn><mo>−</mo><mi>x</mi></msqrt></mrow><mrow><mo stretchy=\"false\">(</mo><msqrt><mn>2</mn><mo>−</mo><mi>x</mi></msqrt><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mrow></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msqrt><mo stretchy=\"false\">(</mo><mi>x</mi><mo>+</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>2</mn><mo>−</mo><mi>x</mi><mo stretchy=\"false\">)</mo></msqrt><mrow><mn>2</mn><mo>−</mo><mi>x</mi></mrow></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msqrt><msup><mn>2</mn><mn>2</mn></msup><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup></msqrt><mrow><mn>2</mn><mo>−</mo><mi>x</mi></mrow></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msqrt><mn>4</mn><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup></msqrt><mrow><mn>2</mn><mo>−</mo><mi>x</mi></mrow></mfrac></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
