          "choices": [],
          "dom_index": 0,
          "disabled": false,
          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:100px;\n                                        margin-left:2px;\n                                        margin-right:2px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"27\"><span class=\"mq-non-leaf\" mathquill-command-id=\"29\"><span class=\"mq-scaled mq-sqrt-prefix\" style=\"transform: scale(1, 0.943478);\">√</span><span class=\"mq-non-leaf mq-sqrt-stem\" mathquill-block-id=\"31\"><span mathquill-command-id=\"30\">5</span><var mathquill-command-id=\"32\">x</var><span mathquill-command-id=\"34\" class=\"mq-binary-operator\">+</span><span mathquill-command-id=\"36\">2</span></span></span></span></div></div>",
          "rendered_text": "√5x+2",
