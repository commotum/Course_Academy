      "proof_feedback": null,
      "html": "<div id=\"step-q276847\" class=\"step questionWidget\" style=\"display: block;\"><div class=\"questionWidget-header\"><div class=\"questionWidget-title\">Question 1</div><div class=\"questionWidget-helpButton\">?</div></div><div class=\"questionWidget-text\">Rationalize the denominator of the following expression:<table rules=\"all\" cellpadding=\"1\" align=\"center\" style=\"border:1px solid black; margin: auto; margin-bottom: 10mm; margin-top: 4mm\">\n\n<tbody><tr><td width=\"50\" height=\"10\" style=\"text-align:center; vertical-align: bottom; border:1px solid black; border-right:hidden; border-top:hidden; border-left:hidden\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"-1\" ctxtmenu_counter=\"5\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45D TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup><mjx-msqrt><mjx-sqrt><mjx-surd><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c221A\"></mjx-c></mjx-mo></mjx-surd><mjx-box style=\"padding-top: 0.163em;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c33\"></mjx-c><mjx-c class=\"mjx-c36\"></mjx-c></mjx-mn></mjx-box></mjx-sqrt></mjx-msqrt></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>p</mi><mn>2</mn></msup><msqrt><mn>36</mn></msqrt></math></mjx-assistive-mml></mjx-container></td>\n\n<td width=\"30\" style=\"text-align:center; border-bottom:hidden; border-top:hidden; vertical-align: bottom; font-size: 0.9em; position: relative;\">\n  <div style=\"text-align:center; font-size: 0.9em; position: absolute; bottom: 0px; left: 50%; transform: translateX(-50%); \" \"=\"\">__</div></td>\n<td width=\"60\" height=\"10\" style=\"text-align:center; vertical-align: bottom; border:1px s