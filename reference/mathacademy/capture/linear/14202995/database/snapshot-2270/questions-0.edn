#{[{:db/id #edb/ref 17592186078171 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078562 :knowledge-point/id #uuid "49541737-272f-5821-8bf2-241989e14349" :knowledge-point/title "Rationalizing a Variable Fraction Using the Quotient Rule For Radicals"}] :question/id #uuid "3b907098-3e14-5db0-914f-811c84a79d1b" :question/math-academy-id "e-1385" :question/problem "Rationalize the denominator of  $\\sqrt{\\dfrac{3}{8a}}.$" :question/worked-solution "First, we apply the quotient rule and put the numerator and denominator under separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{3}{8a}} & =\\frac{\\sqrt{3}}{\\sqrt{8a}}\\end{aligned}\n$$\n\nNow, we need to remove the radical $\\sqrt{8a}$ from the denominator. To do this, we multiply both the numerator and denominator by $\\sqrt{8a}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3}}{\\sqrt{8a}}\\cdot \\frac{\\sqrt{8a}}{\\sqrt{8a}} & = \\\\ \\frac{\\sqrt{24a}}{(\\sqrt{8a})^{2}} & = \\\\ \\frac{\\sqrt{4\\cdot 6a}}{8a} & = \\\\ \\frac{2\\sqrt{6a}}{8a} & = \\\\ \\frac{\\sqrt{6a}}{4a}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186078172 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078563 :knowledge-point/id #uuid "bd46dce5-3009-5b72-9230-f4b66fa77c9a" :knowledge-point/title "Rationalizing a Variable Fraction With More Than Two Terms"}] :question/id #uuid "226ef796-a5c7-5113-a268-825bc1738a78" :question/math-academy-id "e-1386" :question/problem "Express $\\dfrac{\\sqrt{y}+2}{\\sqrt{z+1}}$ without radicals in the denominator." :question/worked-solution "We need to remove the radical $\\sqrt{z+1}$ from the denominator. To do this, we multiply both the numerator and denominator by $\\sqrt{z+1}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{y}+2}{\\sqrt{z+1}} & = \\\\ \\frac{\\sqrt{y}+2}{\\sqrt{z+1}}\\cdot \\frac{\\sqrt{z+1}}{\\sqrt{z+1}} & = \\\\ \\frac{(\\sqrt{y}+2)\\sqrt{z+1}}{(\\sqrt{z+1})^{2}} & = \\\\ \\frac{\\sqrt{y}\\cdot \\sqrt{z+1}+2\\cdot \\sqrt{z+1}}{z+1} & = \\\\ \\frac{\\sqrt{y\\cdot (z+1)}+2\\sqrt{z+1}}{z+1} & = \\\\ \\frac{\\sqrt{yz+y}+2\\sqrt{z+1}}{z+1}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186078342 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078561 :knowledge-point/id #uuid "064cd24d-8e8c-5c55-b354-e84edb518c59" :knowledge-point/title "Rationalizing a Variable Fraction"}] :question/id #uuid "b7506e51-659a-5f10-a2a8-822e8378768c" :question/math-academy-id "e-6718" :question/problem "Rationalize $\\dfrac{x}{2\\sqrt{y}}.$" :question/worked-solution "We need to remove the radical $\\sqrt{y}$ from the denominator. To do this, we multiply both the numerator and denominator by $\\sqrt{y},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{x}{2\\sqrt{y}} & = \\\\ \\frac{x}{2\\sqrt{y}}\\cdot \\frac{\\sqrt{y}}{\\sqrt{y}} & = \\\\ \\frac{x\\cdot \\sqrt{y}}{2\\sqrt{y}\\cdot \\sqrt{y}} & = \\\\ \\frac{x\\sqrt{y}}{2(\\sqrt{y})^{2}} & = \\\\ \\frac{x\\sqrt{y}}{2y}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186519540 :knowledge-point/_questions [{:db/id #edb/ref 17592186078561 :knowledge-point/id #uuid "064cd24d-8e8c-5c55-b354-e84edb518c59" :knowledge-point/title "Rationalizing a Variable Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18ef76f8-8dbc-5ebb-8bc9-f86c15aea042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{5q}}{pq}" :db/id #edb/ref 17592186519029} {:answer/id #uuid "881bc8e4-23e6-5c8b-abbb-336ad8921d0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2p\\sqrt{q}}{5q}" :db/id #edb/ref 17592186519209} {:answer/id #uuid "af6a6fd8-98dd-5b95-b6a0-f1f21a75231d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{p\\sqrt{q}}{q}" :db/id #edb/ref 17592186519277} {:answer/id #uuid "c047a171-554c-5af4-97cd-4397157ab688" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2p\\sqrt{5q}}{q}" :db/id #edb/ref 17592186519308} {:answer/id #uuid "db6c92bd-32d1-5af5-8dc2-84c41e3fbc21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{p\\sqrt{5q}}{5q}" :db/id #edb/ref 17592186519355}] :answer-field/correct {:answer/id #uuid "c047a171-554c-5af4-97cd-4397157ab688" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2p\\sqrt{5q}}{q}" :db/id #edb/ref 17592186519308} :answer-field/id #uuid "799ec4d9-c327-5bfe-a23f-9234d6f91082" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519455}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "54170d78-262c-5604-939a-66b79556fcdc" :question/math-academy-id "q-111045" :question/problem "Rationalize $\\frac{10p}{\\sqrt{5q}}.$" :question/worked-solution "We need to remove the radical $\\sqrt{5q}$ from the denominator. To do this, we multiply both the numerator and denominator by $\\sqrt{5q},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{10p}{\\sqrt{5q}} & = \\\\ \\frac{10p}{\\sqrt{5q}}\\cdot \\frac{\\sqrt{5q}}{\\sqrt{5q}} & = \\\\ \\frac{10p\\cdot \\sqrt{5q}}{\\sqrt{5q}\\cdot \\sqrt{5q}} & = \\\\ \\frac{10p\\cdot \\sqrt{5q}}{5q} & = \\\\ \\frac{\\cancel{5}\\cdot 2p\\cdot \\sqrt{5q}}{\\cancel{5}\\cdot q} & = \\\\ \\frac{2p\\sqrt{5q}}{q}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186519570 :knowledge-point/_questions [{:db/id #edb/ref 17592186078561 :knowledge-point/id #uuid "064cd24d-8e8c-5c55-b354-e84edb518c59" :knowledge-point/title "Rationalizing a Variable Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eff31e70-7fa8-5952-b9f9-92a5f5d245e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p^{2}\\sqrt{3s}" :db/id #edb/ref 17592186519386}] :answer-field/correct {:answer/id #uuid "eff31e70-7fa8-5952-b9f9-92a5f5d245e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p^{2}\\sqrt{3s}" :db/id #edb/ref 17592186519386} :answer-field/id #uuid "49e36eda-fd63-55f3-a7d4-f505c4715099" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186519437}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a218b702-260e-5626-9b2a-10fbf0615a24" :question/math-academy-id "q-276847" :question/problem "Rationalize the denominator of the following expression:\n\n| ${p}^{2}\\sqrt{36}$ | __ | {{field-1}} |\n| --- | --- | --- |\n| $2\\sqrt{3s}$ | __ | $s$ |" :question/worked-solution "We must remove the radical $\\sqrt{3s}$ from the denominator. To do this, we multiply both the numerator and denominator by $\\sqrt{3s},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{{p}^{2}\\sqrt{36}}{2\\sqrt{3s}} & = \\\\ \\frac{{p}^{2}\\sqrt{36}}{2\\sqrt{3s}}\\cdot \\frac{\\sqrt{3s}}{\\sqrt{3s}} & = \\\\ \\frac{6{p}^{2}\\cdot \\sqrt{3s}}{2\\sqrt{3s}\\cdot \\sqrt{3s}} & = \\\\ \\frac{6{p}^{2}\\sqrt{3s}}{2{(\\sqrt{3s})}^{2}} & = \\\\ \\frac{6{p}^{2}\\sqrt{3s}}{2\\cdot 3s} & = \\\\ \\frac{\\cancel{6}{p}^{2}\\sqrt{3s}}{\\cancel{6}s} & = \\\\ \\frac{{p}^{2}\\sqrt{3s}}{s}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186519561 :knowledge-point/_questions [{:db/id #edb/ref 17592186078562 :knowledge-point/id #uuid "49541737-272f-5821-8bf2-241989e14349" :knowledge-point/title "Rationalizing a Variable Fraction Using the Quotient Rule For Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f865e495-959b-519f-98c3-1d28f572087e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{11pq}" :db/id #edb/ref 17592186519402}] :answer-field/correct {:answer/id #uuid "f865e495-959b-519f-98c3-1d28f572087e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{11pq}" :db/id #edb/ref 17592186519402} :answer-field/id #uuid "2be4abe8-b965-5965-996d-2949b1702bae" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186519428}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8dffe1e2-d854-56ac-895d-ab0f043c857c" :question/math-academy-id "q-276897" :question/problem "Rationalize the denominator of the following expression:\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"25\" width=\"40\"></td>\n<td align=\"center\" rowspan=\"2\" width=\"25\">$\\sqrt{\\frac{11}{pq}}\\,=\\,$</td>\n<td align=\"center\" height=\"25\" width=\"40\">{{field-1}}\n</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"40\"></td>\n<td align=\"center\" height=\"25\" width=\"40\">$pq$</td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we apply the quotient rule and put the numerator and denominator under separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{11}{pq}} & =\\frac{\\sqrt{11}}{\\sqrt{pq}}\\end{aligned}\n$$\n\nNow, we need to remove the radical $\\sqrt{pq}$ from the denominator. To do this, we multiply both the numerator and denominator by $\\sqrt{pq},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{11}}{\\sqrt{pq}}\\cdot \\frac{\\sqrt{pq}}{\\sqrt{pq}} & = \\\\ \\frac{\\sqrt{11pq}}{(\\sqrt{pq})^{2}} & = \\\\ \\frac{\\sqrt{11pq}}{pq}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186519583 :knowledge-point/_questions [{:db/id #edb/ref 17592186078563 :knowledge-point/id #uuid "bd46dce5-3009-5b72-9230-f4b66fa77c9a" :knowledge-point/title "Rationalizing a Variable Fraction With More Than Two Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "549110d8-b6e9-5bac-9678-e4bf16752d1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5(x+2)}" :db/id #edb/ref 17592186519121}] :answer-field/correct {:answer/id #uuid "549110d8-b6e9-5bac-9678-e4bf16752d1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5(x+2)}" :db/id #edb/ref 17592186519121} :answer-field/id #uuid "1090ed63-0b99-5fd6-8d1a-d720a0b737cc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186519418}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cb60bd4d-fd24-5677-a17c-242785ce4b4c" :question/math-academy-id "q-277015" :question/problem "Rationalize the denominator of the following expression:\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"25\" width=\"80\"></td>\n<td align=\"center\" rowspan=\"2\" width=\"25\">$\\sqrt{\\frac{5}{x+2}}\\,=\\,$</td>\n<td align=\"center\" height=\"25\" width=\"80\">{{field-1}}\n</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"60\"></td>\n<td align=\"center\" height=\"25\" width=\"60\">$x+2$</td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we apply the quotient rule and put the numerator and denominator under separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{5}{x+2}} & =\\frac{\\sqrt{5}}{\\sqrt{x+2}}\\end{aligned}\n$$\n\nTo remove the radical $\\sqrt{x+2}$ from the denominator, we multiply both the numerator and denominator by $\\sqrt{x+2}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{5}}{\\sqrt{x+2}} & = \\\\ \\frac{\\sqrt{5}}{\\sqrt{x+2}}\\cdot \\frac{\\sqrt{x+2}}{\\sqrt{x+2}} & = \\\\ \\frac{\\sqrt{5}\\cdot \\sqrt{x+2}}{\\sqrt{x+2}\\cdot \\sqrt{x+2}} & = \\\\ \\frac{\\sqrt{5(x+2)}}{(\\sqrt{x+2})^{2}} & = \\\\ \\frac{\\sqrt{5(x+2)}}{x+2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186519594 :knowledge-point/_questions [{:db/id #edb/ref 17592186078562 :knowledge-point/id #uuid "49541737-272f-5821-8bf2-241989e14349" :knowledge-point/title "Rationalizing a Variable Fraction Using the Quotient Rule For Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13f0ba23-754e-51a6-a295-4f96fd6ef5e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{a}}{b}" :db/id #edb/ref 17592186519025} {:answer/id #uuid "3b37f642-471b-5f6b-85d2-8b40a9577888" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2ab}}{ab}" :db/id #edb/ref 17592186519083} {:answer/id #uuid "86c7b175-e87a-5dbf-9cea-22949b3d7cdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{a}}{2b}" :db/id #edb/ref 17592186519205} {:answer/id #uuid "d9578fff-a12b-5db2-99d3-cec08ace2c8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{{a}^{3}}" :db/id #edb/ref 17592186519349} {:answer/id #uuid "f44908d9-838a-50aa-b994-1cdffda99e54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2ab\\sqrt{a}" :db/id #edb/ref 17592186519394}] :answer-field/correct {:answer/id #uuid "3b37f642-471b-5f6b-85d2-8b40a9577888" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2ab}}{ab}" :db/id #edb/ref 17592186519083} :answer-field/id #uuid "a2b52444-4149-539f-af43-cc5257565cbc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519472}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e789ca07-9ab5-56ec-aa69-c4d893a03b51" :question/math-academy-id "q-29307" :question/problem "Rationalize the denominator of $\\sqrt{\\frac{2}{ab}}.$" :question/worked-solution "First, we apply the quotient rule and put the numerator and denominator under separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{2}{ab}} & =\\frac{\\sqrt{2}}{\\sqrt{ab}}\\end{aligned}\n$$\n\nNow, we need to remove the radical $\\sqrt{ab}$ from the denominator. To do this, we multiply both the numerator and denominator by $\\sqrt{ab},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{2}}{\\sqrt{ab}}\\cdot \\frac{\\sqrt{ab}}{\\sqrt{ab}} & = \\\\ \\frac{\\sqrt{2ab}}{(\\sqrt{ab})^{2}} & = \\\\ \\frac{\\sqrt{2ab}}{ab}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186519520 :knowledge-point/_questions [{:db/id #edb/ref 17592186078563 :knowledge-point/id #uuid "bd46dce5-3009-5b72-9230-f4b66fa77c9a" :knowledge-point/title "Rationalizing a Variable Fraction With More Than Two Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1362ec50-045d-570a-b8d9-f597a02660d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{x}^{2}+x-20}}{x-4}" :db/id #edb/ref 17592186519023} {:answer/id #uuid "1e90ea7a-8259-5a46-a5a1-561e85f157c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{x}^{2}-x-20}}{x-4}" :db/id #edb/ref 17592186519041} {:answer/id #uuid "4d322ece-08bb-5254-ab69-92f021354124" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{x}^{2}+x-20}}{x+4}" :db/id #edb/ref 17592186519113} {:answer/id #uuid "c733caca-8b56-5be4-8259-9a8dbc49c5cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{x-4}}{x-4}" :db/id #edb/ref 17592186519319} {:answer/id #uuid "f1d80ea2-6dc7-5f7f-8084-aac98a28814c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{x}^{2}-x-20}}{x+4}" :db/id #edb/ref 17592186519391}] :answer-field/correct {:answer/id #uuid "1362ec50-045d-570a-b8d9-f597a02660d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{x}^{2}+x-20}}{x-4}" :db/id #edb/ref 17592186519023} :answer-field/id #uuid "9ec66753-9269-508b-82f0-625ca12d3dac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519470}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0c5d26cb-9be7-50d4-8738-09ac8a11367a" :question/math-academy-id "q-365109" :question/problem "Express $\\frac{\\sqrt{x+5}}{\\sqrt{x-4}}\\,$ without radicals in the denominator." :question/worked-solution "To remove the radical $\\sqrt{x-4}$ from the denominator, we multiply both the numerator and denominator by $\\sqrt{x-4}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{x+5}}{\\sqrt{x-4}} & = \\\\ \\frac{\\sqrt{x+5}}{\\sqrt{x-4}}\\cdot \\frac{\\sqrt{x-4}}{\\sqrt{x-4}} & = \\\\ \\frac{\\sqrt{x+5}\\cdot \\sqrt{x-4}}{(\\sqrt{x-4})^{2}} & = \\\\ \\frac{\\sqrt{(x+5)(x-4)}}{x-4} & = \\\\ \\frac{\\sqrt{{x}^{2}+x-20}}{x-4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186519530 :knowledge-point/_questions [{:db/id #edb/ref 17592186078563 :knowledge-point/id #uuid "bd46dce5-3009-5b72-9230-f4b66fa77c9a" :knowledge-point/title "Rationalizing a Variable Fraction With More Than Two Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1be8bbf0-94a3-514d-b9e7-cf2447c34027" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{m}^{2}-{n}^{2}}}{m-n}" :db/id #edb/ref 17592186519035} {:answer/id #uuid "3b814f94-8ed6-50a2-bfe4-320dae6d343f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{m+n}}{m+n}" :db/id #edb/ref 17592186519084} {:answer/id #uuid "74891615-da22-5cd5-b950-a3e2d5e19836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{m}^{2}+{n}^{2}}}{m+n}" :db/id #edb/ref 17592186519174} {:answer/id #uuid "a6af6e16-740a-54f1-b709-e593a3aa6a29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{m}^{2}-{n}^{2}}}{m+n}" :db/id #edb/ref 17592186519265} {:answer/id #uuid "a8aa1796-cc5a-5ac4-bf5f-2a8bbcd39fb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{m}^{2}+{n}^{2}}}{m-n}" :db/id #edb/ref 17592186519269}] :answer-field/correct {:answer/id #uuid "a6af6e16-740a-54f1-b709-e593a3aa6a29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{m}^{2}-{n}^{2}}}{m+n}" :db/id #edb/ref 17592186519265} :answer-field/id #uuid "703f2d0f-3039-5af3-a486-ae462ad38c20" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519453}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "22cd57f3-188f-5b72-9854-fd7357950a74" :question/math-academy-id "q-365110" :question/problem "Express $\\frac{\\sqrt{m-n}}{\\sqrt{m+n}}\\,$ without radicals in the denominator." :question/worked-solution "To remove the radical $\\sqrt{m+n}$ from the denominator, we multiply both the numerator and denominator by $\\sqrt{m+n}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{m-n}}{\\sqrt{m+n}} & = \\\\ \\frac{\\sqrt{m-n}}{\\sqrt{m+n}}\\cdot \\frac{\\sqrt{m+n}}{\\sqrt{m+n}} & = \\\\ \\frac{\\sqrt{m-n}\\cdot \\sqrt{m+n}}{(\\sqrt{m+n})^{2}} & = \\\\ \\frac{\\sqrt{(m-n)(m+n)}}{m+n} & = \\\\ \\frac{\\sqrt{{m}^{2}-{n}^{2}}}{m+n}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186519517 :knowledge-point/_questions [{:db/id #edb/ref 17592186078563 :knowledge-point/id #uuid "bd46dce5-3009-5b72-9230-f4b66fa77c9a" :knowledge-point/title "Rationalizing a Variable Fraction With More Than Two Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72f2ff78-ff55-57c4-8824-0fdecfba4af0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{x}^{2}-4}}{2+x}" :db/id #edb/ref 17592186519170} {:answer/id #uuid "d32eb343-b5b4-5113-a794-b6b4d1ab3fea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{4-{x}^{2}}}{2-x}" :db/id #edb/ref 17592186519338} {:answer/id #uuid "df8ec371-a2ca-56b1-ae32-b3976639b2c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2-{x}^{2}}}{2+x}" :db/id #edb/ref 17592186519361} {:answer/id #uuid "eb8ecf94-7285-5927-ae86-41b74c3c44a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{x}^{2}-4}}{2-x}" :db/id #edb/ref 17592186519378} {:answer/id #uuid "f1a440e4-05f7-5a40-af58-370b96d95d00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2+{x}^{2}}}{2+x}" :db/id #edb/ref 17592186519390}] :answer-field/correct {:answer/id #uuid "d32eb343-b5b4-5113-a794-b6b4d1ab3fea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{4-{x}^{2}}}{2-x}" :db/id #edb/ref 17592186519338} :answer-field/id #uuid "2d9977c0-0af6-5dbd-8b59-33d467a9c5ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519429}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "07c37b28-ce2e-5984-bd1b-1c0c09dcc7da" :question/math-academy-id "q-77890" :question/problem "Express $\\frac{\\sqrt{x+2}}{\\sqrt{2-x}}\\,$ without radicals in the denominator." :question/worked-solution "To remove the radical $\\sqrt{2-x}$ from the denominator, we multiply both the numerator and denominator by $\\sqrt{2-x}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{x+2}}{\\sqrt{2-x}} & = \\\\ \\frac{\\sqrt{x+2}}{\\sqrt{2-x}}\\cdot \\frac{\\sqrt{2-x}}{\\sqrt{2-x}} & = \\\\ \\frac{\\sqrt{x+2}\\cdot \\sqrt{2-x}}{(\\sqrt{2-x})^{2}} & = \\\\ \\frac{\\sqrt{(x+2)(2-x)}}{2-x} & = \\\\ \\frac{\\sqrt{{2}^{2}-{x}^{2}}}{2-x} & = \\\\ \\frac{\\sqrt{4-{x}^{2}}}{2-x}\\end{aligned}\n$$"}]}
