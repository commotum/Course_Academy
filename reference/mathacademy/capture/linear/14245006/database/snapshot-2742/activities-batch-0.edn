vity.type/lesson} :db/id #edb/ref 17592186138637}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186562583} :activity/id #uuid "5a5c1ccc-61b5-5649-8b40-98a5e29ed519" :activity/scope {:db/id #edb/ref 17592186049996 :topic/id #uuid "24d8f2be-f496-511f-8424-44fbfe7a6a2c" :topic/math-academy-id 2336} :activity/steps [{:db/id #edb/ref 17592186562552 :step/content {:db/id #edb/ref 17592186562440 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08b4bb42-2f07-5f22-b119-aaf61adfbab7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "({p}^{2}+3)({p}^{2}-5)" :db/id #edb/ref 17592186561608} {:answer/id #uuid "1c6d8972-4d89-5edb-aec9-dff3eb9542b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "({p}^{2}-10)({p}^{2}+5)" :db/id #edb/ref 17592186561661} {:answer/id #uuid "44181e52-200e-59de-aaf9-e866eb6eb780" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "({p}^{2}-3)({p}^{2}+5)" :db/id #edb/ref 17592186561749} {:answer/id #uuid "648b3d26-e8d1-59d8-b354-1d025dedb54b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(p-3){(p+5)}^{2}" :db/id #edb/ref 17592186561830} {:answer/id #uuid "734627e7-449d-5d5e-926c-25142aeb544c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{({p}^{2}+5)}^{2}" :db/id #edb/ref 17592186561868}] :answer-field/correct {:db/id #edb/ref 17592186561749} :answer-field/id #uuid "1d0755e9-d2fb-51ff-9dfa-673f50f7bb0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186562237}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "64406c7a-8c8e-5992-a943-fe107c40272e" :question/math-academy-id "q-44522" :question/problem "The trinomial ${p}^{4}+2{p}^{2}-15$ is equivalent to" :question/worked-solution "We can introduce a new variable $z={p}^{2}$ and then rewrite the trinomial as a quadratic in terms of $z:$\n\n$$\n\\begin{aligned}{p}^{4}+2{p}^{2}-15 & ={({p}^{2})}^{2}+2({p}^{2})-15 \\\\  & ={z}^{2}+2z-15\\end{aligned}\n$$\n\nNow, we can factor the quadratic, and then rewrite the final expression in terms of $p:$\n\n$$\n\\begin{aligned}{z}^{2}+2z-15 & =(z-3)(z+5) \\\\  & =({p}^{2}-3)({p}^{2}+5)\\end{aligned}\n$$"} :step/id #uuid "7c777769-9552-5c53-b884-3259a4db8c03" :step/next {:db/id #edb/ref 17592186562573}} {:db/id #edb/ref 17592186562573 :step/content {:db/id #edb/ref 17592186562481 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ea46336-cd01-5b2c-b46f-fe60cc120d35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "({s}^{2}-3)({s}^{2}+4)" :db/id #edb/ref 17592186561736} {:answer/id #uuid "55c7b825-4af3-56a2-afd0-44f6f67a9f69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(s+3)(s-4)" :db/id #edb/ref 17592186561794} {:answer/id #uuid "606f2be5-014b-5b28-bf23-19c63452c1ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "({s}^{2}-3)({s}^{2}-4)" :db/id #edb/ref 17592186561815} {:answer/id #uuid "6fade646-27e9-5be0-ac21-3eaf8e4bd6f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "({s}^{2}+3)({s}^{2}-4)" :db/id #edb/ref 17592186561857} {:answer/id #uuid "7e0bd50e-ed81-5465-824f-8ba7bf5d2ca8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(s-3)(s+4)" :db/id #edb/ref 17592186561898}] :answer-field/correct {:db/id #edb/ref 17592186561857} :answer-field/id #uuid "e4723b73-531b-5f98-acb4-18f8a476a36e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186562367}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b42f766f-91bf-5b16-b807-3079a315696b" :question/math-academy-id "q-79490" :question/problem "Factor ${s}^{4}-{s}^{2}-12.$" :question/worked-solution "We can introduce a new variable $t={s}^{2}$ and then rewrite the trinomial as a quadratic in terms of $t:$\n\n$$\n\\begin{aligned}{s}^{4}-{s}^{2}-12 & ={({s}^{2})}^{2}-({s}^{2})-12 \\\\  & ={t}^{2}-t-12\\end{aligned}\n$$\n\nNow, we can factor the quadratic, and then rewrite the final expression in terms of $s:$\n\n$$\n\\begin{aligned}{t}^{2}-t-12 & =(t+3)(t-4) \\\\  & =({s}^{2}+3)({s}^{2}-4)\\end{aligned}\n$$"} :step/id #uuid "caa39b9e-dedd-5c18-9ea4-fda15a8732cf"} {:db/id #edb/ref 17592186562583 :step/content {:db/id #edb/ref 17592186562453 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e0b825f-4a74-5e95-93f5-65c968e0712c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186561780} {:answer/id #uuid "6104ac45-813f-58b4-ac8f-d09dee3b3225" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186561816} {:answer/id #uuid "7687c68f-49a8-5e6e-a462-3f65463165d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186561876} {:answer/id #uuid "ba648939-1b79-5eeb-a828-f3f413cc4458" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186562059} {:answer/id #uuid "ce32916b-b0a6-5ccf-b2f8-98b980dc5c9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186562096}] :answer-field/correct {:db/id #edb/ref 17592186561816} :answer-field/id #uuid "e17d9c1f-8ee5-537e-b3b1-d2c3901fe469" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186562364}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "83badc2b-8d5f-5e16-ac2d-99f08799fac8" :question/math-academy-id "q-36118" :question/problem "Given that $6{x}^{6}-13{x}^{3}-8=(a{x}^{3}-8)(2{x}^{3}+b)$ where $a$ and $b$ are integers, find the value of $a+b.$" :question/worked-solution "We can introduce a new variable $z={x}^{3}$ and then rewrite the trinomial as a quadratic in terms of $z:$\n\n$$\n\\begin{aligned}6{x}^{6}-13{x}^{3}-8 & =6{({x}^{3})}^{2}-13({x}^{3})-8 \\\\  & =6{z}^{2}-13z-8\\end{aligned}\n$$\n\nNow, we can factor the quadratic, and then rewrite the final expression in terms of $x:$\n\n$$\n\\begin{aligned}6{z}^{2}-13z-8 & =(3z-8)(2z+1) \\\\  & =(3{x}^{3}-8)(2{x}^{3}+1)\\end{aligned}\n$$\n\nSo, $a=3$, $b=1$ and $a+b=4.$"} :step/id #uuid "e4d679cb-4394-5f7c-9a7d-d4a6ff976ebe" :step/next {:db/id #edb/ref 17592186562552}}] :activity/title "Factoring Biquadratic Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186561568}]}
