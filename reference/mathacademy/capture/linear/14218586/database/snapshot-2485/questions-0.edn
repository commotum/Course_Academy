/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-1)" :db/id #edb/ref 17592186528781} :answer-field/id #uuid "c2f02c8f-0f0c-5292-993d-c05cc073b492" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186529046}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e1e8554d-3b9d-57c5-a60f-771660835934" :question/math-academy-id "q-81962" :question/problem "The point $P$ with coordinates $(3,-3)$ lies on the curve $y=3f(x).$ Which of the following points must lie on $y=f(x)?$" :question/worked-solution "The function $y=3f(x)$ represents a stretch of the function $y=f(x)$ by a factor of $3$ parallel to the $y$-axis. This has the effect of multiplying the $y$-coordinates of all points on $y=f(x)$ by $3.$\n\nThe point $Q(3,q)$ on $f(x)$ is mapped to the point $P(3,-3)$ on $y=3f(x).$ Since we know that the $y$-coordinate of $P$ is $3$ times the $y$-coordinate of $Q,$ we can form the following equation:\n\n$$\n3q=-3\n$$\n\nSolving this equation, we get $q=-1.$ Therefore, the coordinates of $Q$ are $(3,-1).$"}] [{:db/id #edb/ref 17592186529131 :knowledge-point/_questions [{:db/id #edb/ref 17592186100986 :knowledge-point/id #uuid "d755013d-f02d-5cde-abcb-5be4c06e3b6b" :knowledge-point/title "Plotting the Graph of a Vertically Compressed Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8639a17b-0e74-5099-9b06-91206ac6da9e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e0/e05a4b4686162c4e36f02f368ac501dc3195280d4b47389e529e14fc0e028734.png" :db/id #edb/ref 17592186528619} {:answer/id #uuid "c141f488-8032-5f30-adb9-71d273cf9168" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/41/41250ff7c9183c6b1786f62e5a8079b787d886cce07cdd5426b40eab6892c2a8.png" :db/id #edb/ref 17592186528774} {:answer/id 