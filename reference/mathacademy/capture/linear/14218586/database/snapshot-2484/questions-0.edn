#{[{:db/id #edb/ref 17592186100708 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186100986 :knowledge-point/id #uuid "d755013d-f02d-5cde-abcb-5be4c06e3b6b" :knowledge-point/title "Plotting the Graph of a Vertically Compressed Function"}] :question/id #uuid "b9857541-376a-5256-b302-74346878af3a" :question/math-academy-id "e-4979" :question/problem "![](images/30/303b6a70330995c124cdfea0bc125febd5ebcf80cb79c8656086d57f3a6f272f.png)\n\nThe graph of $y=f(x)$ is shown above. Sketch the graph of $y = \\dfrac{1}{2}f(x)$." :question/worked-solution "To graph the function\n\n$$\ny = \\dfrac{1}{2}f(x)\n$$\n\nwe take the graph of $y = f(x)$ and compress it by factor of $2$ parallel to the $y$-axis. This has the effect of dividing the $y$-coordinates of all points on $y = f(x)$ by $2$.\n\nThe resulting graph is the solid blue curve shown below.\n\n![](images/71/71b6584d644419a56b2cebb64124510e9f15cca8a4f19e6c1a8d4b6f1441cd0a.png)"}] [{:db/id #edb/ref 17592186100709 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186100985 :knowledge-point/id #uuid "0dd2eb6c-270f-5537-96f3-5c5438966eab" :knowledge-point/title "Plotting the Graph of a Vertically Stretched Function"}] :question/id #uuid "780bc2f7-da0f-5615-92cd-3a9733b3c333" :question/math-academy-id "e-4980" :question/problem "The graph of $y=f(x)$ is shown below. Sketch the graph of $y=4f(x)$.\n\n![](images/49/495e5e02f89dfa125cb95095088cb80cf3e83ab9e6dae619494e900cbe1dc346.png)" :question/worked-solution "To graph the function $y = 4f(x)$, we take the graph of $y = f(x)$ and stretch it by factor of $4$ parallel to the $y$-axis. This has the effect of multiplying the $y$-coordinates of all points on $y = f(x)$ by $4$.\n\nThe resulting graph is the solid blue curve shown below.\n\n![](images/0b/0b20c1355ae0b2e8afc7e7ce701662e0aaf2a6fdcd8e43342ae057e8bd9250e9.png)"}] [{:db/id #edb/ref 17592186100711 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186100987 :knowledge-point/id #uuid "9cb1c0a6-992e-5f39-be35-0a80084ed650" :knowledge-point/title "Finding a Point that Lies on a Vertically Scaled Function"}] :question/id #uuid "446b51d8-1ec7-532c-9b53-21aeb32d57a0" :question/math-academy-id "e-4987" :question/problem "The point $P$ with coordinates $(-2, 2)$ lies on the curve $y=f(x)$. Find a point that must lie on the graph of $y= 7f(x)$." :question/worked-solution "The function $y = 7f(x)$ represents a stretch of the function $y = f(x)$ by a factor of $7$ parallel to the $y$-axis. This has the effect of multiplying the $y$-coordinates of all points on $y=f(x)$ by $7$.\n\nTherefore, the point $(-2,2)$ on $f(x)$ is mapped to the point\n\n$$\n\\left(-2, 7 \\cdot 2\\right) = (-2, 14)\n$$\n\nand this point must lie on the graph of $y = 7f(x)$."}] [{:db/id #edb/ref 17592186101246 :knowledge-point/_questions [{:db/id #edb/ref 17592186100985 :knowledge-point/id #uuid "0dd2eb6c-270f-5537-96f3-5c5438966eab" :knowledge-point/title "Plotting the Graph of a Vertically Stretched Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da1ff81d-d04e-52ec-ab32-281987508598" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9d/9d365b79ff824808c9fd0f9177f234d4cad90eeeb1a5d0375e32331aa06226c6.png" :db/id #edb/ref 17592186098808} {:answer/id #uuid "006ea1df-160d-5e03-a362-bff668361f90" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/13/1309614901d95ce5ff95309d1614987e9f321749e2a64a4b77408101a4746a81.png" :db/id #edb/ref 17592186098809} {:answer/id #uuid "2a493576-895f-56ef-b37c-f24370c67f4b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fd/fdc7faf421e1e594ab729eb741c8f5c68bcb61924e73f2252509d8074a03035c.png" :db/id #edb/ref 17592186098810} {:answer/id #uuid "2b50950d-3c8b-5932-8bd9-48f723083326" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/04/0435b377e5a94d3659c