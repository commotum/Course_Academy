#{[{:activity/first-step {:db/id #edb/ref 17592186101850} :activity/id #uuid "35b6b482-18e8-514d-960d-4d6d3def3f54" :activity/scope {:db/id #edb/ref 17592186050491 :topic/id #uuid "4d8f1d46-f874-5332-bc47-cbcf6b21068c" :topic/math-academy-id 1252} :activity/steps [{:db/id #edb/ref 17592186101850 :step/content {:db/id #edb/ref 17592186101970 :tutorial/content "When we multiply a function by a constant, the graph either stretches out or compresses. Transforming a function in this way is called **scaling**.\n\nTo illustrate, consider the graph of $y=f(x)$ shown below.\n\n![](images/21/21f9b06e470ca0e94605eb72c5a12d2a1f2ec56645588a960f12be81ad8252ec.png)\n\nThe following table lists four sets of points. The set of points in the left-hand column correspond to the graph of $y=f(x)$, and the set on the right-hand side corresponds to $y=2f(x)$.\n\n$$\n\\begin{bmatrix}Points on [math]y=f(x)[/math] & Points on [math]y=2f(x)[/math] \\\\ (1, 2) & (1, 4) \\\\ (4,-3) & (4,-6) \\\\ (0, 2) & (0, 4) \\\\ (-2, 0) & (-2, 0)\\end{bmatrix}\n$$\n\nFor each point on the graph of $y=f(x)$, there is a point on the graph of $y=2f(x)$ with the same $x$-value and *double* the $y$-value.\n\nNow that we have four points on the graph of $y=2f(x)$, let's plot the full graph.\n\n![](images/26/262b6515b995f6fdcf7b959dc62d9599b71476471fbc2bde394dcebfd47cabc0.png)\n\nWe say that the graph of $y=2f(x)$ is the graph of $y=f(x)$ **vertically stretched** by a **scale factor** of $2$.\n\nWe can also say that the graph of $y=2f(x)$ is the graph of $y=f(x)$ stretched by a factor of $2$ **parallel to the $\\mathbf y$-axis.**" :tutorial/id #uuid "bea7d899-701e-53ab-9bb8-42e452f0f5c7" :tutorial/math-academy-id 3284 :tutorial/title "Introduction"} :step/id #uuid "c4c40517-5865-5128-af8f-564d6a22648d" :step/math-academy-id 457106 :step/next {:db/id #edb/ref 17592186101851}} {:db/id #edb/ref 17592186101851 :step/content {:db/id #edb/ref 17592186100985 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100709 :question/id #uuid "780bc2f7-da0f-5615-92cd-3a9733b3c333" :question/math-academy-id "e-4980"} :knowledge-point/id #uuid "0dd2eb6c-270f-5537-96f3-5c5438966eab" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048838}] :knowledge-point/questions [{:db/id #edb/ref 17592186101246} {:db/id #edb/ref 17592186101267}] :knowledge-point/title "Plotting the Graph of a Vertically Stretched Function"} :step/id #uuid "60cd62a7-4991-57ac-90fb-b574ced67839" :step/math-academy-id 457107 :step/next {:db/id #edb/ref 17592186101852}} {:db/id #edb/ref 17592186101852 :step/content {:db/id #edb/ref 17592186100986 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100708 :question/id #uuid "b9857541-376a-5256-b302-74346878af3a" :question/math-academy-id "e-4979"} :knowledge-point/id #uuid "d755013d-f02d-5cde-abcb-5be4c06e3b6b" :knowledge-point/questions [{:db/id #edb/ref 17592186101255} {:db/id #edb/ref 17592186101257}] :knowledge-point/title "Plotting the Graph of a Vertically Compressed Function"} :step/id #uuid "ea2e9c61-fcab-5300-8818-9590ecbb72e7" :step/math-academy-id 457110 :step/next {:db/id #edb/ref 17592186101853}} {:db/id #edb/ref 17592186101853 :step/content {:db/id #edb/ref 17592186100987 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100711 :question/id #uuid "446b51d8-1ec7-532c-9b53-21aeb32d57a0" :question/math-academy-id "e-4987"} :knowledge-point/id #uuid "9cb1c0a6-992e-5f39-be35-0a80084ed650" :knowledge-point/questions [{:db/id #edb/ref 17592186101337} {:db/id #edb/ref 17592186101358} {:db/id #edb/ref 17592186101361}] :knowledge-point/title "Finding a Point that Lies on a Vertically Scaled Function"} :step/id #uuid "c481045b-1f32-5a1d-8b62-25e89a1b9393" :step/math-academy-id 457113}] :activity/title "Vertical Stretches of Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186101092}]}
