#{[{:db/id #edb/ref 17592186073570 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073886 :knowledge-point/id #uuid "2a5b57e9-71fa-5b06-9984-c18e20f79e4e" :knowledge-point/title "Finding the Missing Value in a Unit Rate"}] :question/id #uuid "579bda4d-058c-5572-8d5d-addf9650d1ed" :question/math-academy-id "e-2291" :question/problem "What is the missing number in the statement below?\n\n$\\qquad$ $16$ chickens in $2$ chicken coops ![](images/63/63d89cadf68ca22a5e3e0d9f6477b44a5ceda512a9d09e5496ad60268191867c.svg) chickens per chicken coop." :question/worked-solution "The ratio of the number of chickens to the number of chicken coops is ${\\color{blue}16}:{\\color{red}2}.$ So we start with the ratio $16:2$ and write it as a fraction:\n\n$$\n\\dfrac{{\\color{blue}16}}{{\\color{red}2}}\n$$\n\nWe can make a denominator of $1$ by dividing the numerator and denominator by $2\\mathbin{:}$\n\n$$\n\\dfrac{16 \\div 2}{2 \\div 2} = \\dfrac{8}{1} = 8\n$$\n\nSo,\n\n$\\qquad$ $16$ chickens in $2$ chicken coops $= 8$ chickens per chicken coop."}] [{:db/id #edb/ref 17592186073571 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073887 :knowledge-point/id #uuid "f78d8f50-ae86-59e6-8c88-abc42a6a9fc2" :knowledge-point/title "Calculating Whole Number Unit Rates"}] :question/id #uuid "199c8a83-265f-598b-a6f3-a606f3bbd7a7" :question/math-academy-id "e-2292" :question/problem "Carl walks $450$ meters in $5$ minutes. If he walks at a constant pace, at what rate does he walk?" :question/worked-solution "The ratio of meters to minutes that Carl walks is ${\\color{blue}450}:{\\color{red}5}.$ So we start with the ratio $450:5$ and write it as a fraction:\n\n$$\n\\dfrac{{\\color{blue}450}}{{\\color{red}5}}\n$$\n\nWe can make a denominator of $1$ by dividing the numerator and denominator by $5\\mathbin{:}$\n\n$$\n\\dfrac{{\\color{blue}450}\\div 5}{{\\color{red}5}\\div 5} = \\dfrac{{\\color{blue}90}}{{\\color{red}1}}\n$$\n\nTherefore, Carl walks at a rate of $90$ meters per minute."}] [{:db/id #edb/ref 17592186073572 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073888 :knowledge-point/id #uuid "6edca753-d8cd-55a6-883b-81f80af0e0cc" :knowledge-point/title "Calculating Unit Rates as Fractions"}] :question/id #uuid "3997c678-94c6-5f9f-bf6a-dc752e89b3fe" :question/math-academy-id "e-2293" :question/problem "Anthony says $400$ words in $6$ minutes. If he speaks at a steady pace, what statement describes the unit rate?" :question/worked-solution "The ratio of spoken words to minutes is ${\\color{blue}400}:{\\color{red}6}.$ So we start with the ratio $400:6$ and write it as a fraction:\n\n$$\n\\dfrac{{\\color{blue}400}}{{\\color{red}6}}\n$$\n\nWe can reduce this fraction to its lowest terms by dividing the numerator and denominator by $2\\mathbin{:}$\n\n$$\n\\dfrac{400 \\div 2}{6 \\div 2} = \\dfrac{200}{3}\n$$\n\nTherefore, Anthony said $\\dfrac{200}{3}$ words per minute."}] [{:db/id #edb/ref 17592186073573 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073889 :knowledge-point/id #uuid "f84a62df-3608-5166-af37-4f72d8f1b821" :knowledge-point/title "Calculating Unit Rates as Decimals"}] :question/id #uuid "ffe79c28-3eef-51a9-9185-283676fdaf65" :question/math-academy-id "e-2294" :question/problem "Donald writes $3$ words in $2$ seconds. If he writes at a steady pace, how many words does he write per second?" :question/worked-solution "The ratio of words to seconds is ${\\color{blue}3}:{\\color{red}2}.$ Expressing this as a fraction, we have:\n\n$$\n\\dfrac{{\\color{blue}3}}{{\\color{red}2}}\n$$\n\nWe can convert this fraction to a decimal by multiplying the numerator and denominator by $5{:}$\n\n$$\n\\dfrac{3 \\times 5}{2 \\times 5} = \\dfrac{15}{10} = 1.5\n$$\n\nTherefore, Donald writes $1.5$ words per second."}] [{:db/id #edb/ref 17592186490292 :knowledge-point/_questions [{:db/id #edb/ref 17592186073888 :knowledge-point/id #uuid "6edca753-d8cd-55a6-883b-81f80af0e0cc" :knowledge-point/title "Calculating Unit Rates as Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a198a15-8241-5caa-afd0-156ee85242df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{3}{4}$ of a dollar per cake" :db/id #edb/ref 17592186489573} {:answer/id #uuid "5064c7e8-37f9-58cc-812a-3fac1e503b29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{3}{2}$ of a dollar per cake" :db/id #edb/ref 17592186489707} {:answer/id #uuid "8a7ea42b-81eb-5020-9db5-7a55afd2da06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{2}{3}$ of a dollar per cake" :db/id #edb/ref 17592186489832} {:answer/id #uuid "8fba30bb-3f31-59ba-8591-7252451e24ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{4}{3}$ of a dollar per cake" :db/id #edb/ref 17592186489841} {:answer/id #uuid "df035eb8-f5cf-5b36-9614-347c8b6f1045" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{5}{2}$ of a dollar per cake" :db/id #edb/ref 17592186489998}] :answer-field/correct {:answer/id #uuid "5064c7e8-37f9-58cc-812a-3fac1e503b29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{3}{2}$ of a dollar per cake" :db/id #edb/ref 17592186489707} :answer-field/id #uuid "2b93b1b7-1be7-5e9e-bdda-e5b1b03e0cfd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490094}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b262ffc7-3f09-5b66-b29a-de72ce27ab0c" :question/math-academy-id "q-169435" :question/problem "Lily bought $8$ small cakes for $$12.$ At what unit price did Lily pay?" :question/worked-solution "The ratio of dollars to cakes is $12:8.$ Expressing this as a fraction, we have:\n\n$$\n\\frac{12}{8}\n$$\n\nWe can reduce this fraction to its lowest terms by dividing the numerator and denominator by $4:$\n\n$$\n\\frac{12÷4}{8÷4}=\\frac{3}{2}\n$$\n\nConsequently, the unit price Lily paid is $\\frac{3}{2}$ of a dollar per cake."}] [{:db/id #edb/ref 17592186490233 :knowledge-point/_questions [{:db/id #edb/ref 17592186073888 :knowledge-point/id #uuid "6edca753-d8cd-55a6-883b-81f80af0e0cc" :knowledge-point/title "Calculating Unit Rates as Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15cc29f7-dc8f-5fe3-8e30-425af9d46268" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ pages per day" :db/id #edb/ref 17592186489561} {:answer/id #uuid "42f2488b-b75d-52e0-a6bd-2789e8ca7a6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{22}{3}$ pages per day" :db/id #edb/ref 17592186489669} {:answer/id #uuid "4804cf81-639c-5ed7-b3c5-3ade8a1d843d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{25}{2}$ pages per day" :db/id #edb/ref 17592186489682} {:answer/id #uuid "6e880148-7aa6-53bf-ad89-967a5fbacc48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{15}{2}$ pages per day" :db/id #edb/ref 17592186489775} {:answer/id #uuid "9b8bb416-2b90-53a3-9d14-8df23ad783de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{45}{2}$ pages per day" :db/id #edb/ref 17592186489863}] :answer-field/correct {:answer/id #uuid "6e880148-7aa6-53bf-ad89-967a5fbacc48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{15}{2}$ pages per day" :db/id #edb/ref 17592186489775} :answer-field/id #uuid "4213ba9e-f4e9-5ba0-9998-319810155b21" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490112}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "331d0e38-c03a-5100-b4c4-4b758a51792c" :question/math-academy-id "q-169436" :question/problem "Steven took $6$ days to read a book of $45$ pages. If he read the same number of pages each day, then at what rate did Steven read the book?" :question/worked-solution "The ratio of pages to days is $45:6.$ Expressing this as a fraction, we have:\n\n$$\n\\frac{45}{6}\n$$\n\nWe can reduce this fraction to its lowest terms by dividing the numerator and denominator by $3:$\n\n$$\n\\frac{45÷3}{6÷3}=\\frac{15}{2}\n$$\n\nConsequently, Steven read the book at a rate of $\\frac{15}{2}$ pages per day."}] [{:db/id #edb/ref 17592186490293 :knowledge-point/_questions [{:db/id #edb/ref 17592186073889 :knowledge-point/id #uuid "f84a62df-3608-5166-af37-4f72d8f1b821" :knowledge-point/title "Calculating Unit Rates as Decimals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56b1e35a-f7b2-5de6-96a3-a4d4ebe214af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$1.20$" :db/id #edb/ref 17592186489719} {:answer/id #uuid "66a15fcb-5bd2-5496-87fb-8f0b23fb02c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$1.25$" :db/id #edb/ref 17592186489756} {:answer/id #uuid "7b9170d3-e547-5e77-abfb-235c973c92ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$0.80$" :db/id #edb/ref 17592186489796} {:answer/id #uuid "7fd48ad6-aaf3-5965-bdd0-b50d799642b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$0.75$" :db/id #edb/ref 17592186489802} {:answer/id #uuid "cf680200-8003-557c-b1d1-dd6913a6f41d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$0.60$" :db/id #edb/ref 17592186489974}] :answer-field/correct {:answer/id #uuid "66a15fcb-5bd2-5496-87fb-8f0b23fb02c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$1.25$" :db/id #edb/ref 17592186489756} :answer-field/id #uuid "5b957a94-7175-5bc9-80b7-6abcaf46ddc4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490130}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b842ef2a-5852-5df6-832b-3f42a5693c4d" :question/math-academy-id "q-60053" :question/problem "John bought a bouquet of $4$ roses for $$5.$ What is the price per rose?" :question/worked-solution "The ratio of dollars to roses is $5:4.$ Expressing this as a fraction, we have:\n\n$$\n\\frac{5}{4}\n$$\n\nWe can convert this fraction to a decimal by multiplying the numerator and denominator by $25:$\n\n$$\n\\frac{5\\times 25}{4\\times 25}=\\frac{125}{100}=1.25\n$$\n\nConsequently, the cost is $$1.25$ per rose."}] [{:db/id #edb/ref 17592186490263 :knowledge-point/_questions [{:db/id #edb/ref 17592186073887 :knowledge-point/id #uuid "f78d8f50-ae86-59e6-8c88-abc42a6a9fc2" :knowledge-point/title "Calculating Whole Number Unit Rates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92addfea-c848-5d26-81fc-f20357acb8cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Elena writes $30$ words per minute" :db/id #edb/ref 17592186489847} {:answer/id #uuid "ad4e8f57-2785-57fd-9d96-f27a59e011a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Elena writes $20$ words per minute" :db/id #edb/ref 17592186489895} {:answer/id #uuid "c8f53fa9-e1fa-58a7-9ce4-7d9b930e21f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Elena writes $50$ words per minute" :db/id #edb/ref 17592186489952} {:answer/id #uuid "e2340c89-08e8-515b-ab33-8bb09d73a8ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/va