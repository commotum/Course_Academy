#{[{:db/id #edb/ref 17592186073570 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073886 :knowledge-point/id #uuid "2a5b57e9-71fa-5b06-9984-c18e20f79e4e" :knowledge-point/title "Finding the Missing Value in a Unit Rate"}] :question/id #uuid "579bda4d-058c-5572-8d5d-addf9650d1ed" :question/math-academy-id "e-2291" :question/problem "What is the missing number in the statement below?\n\n$\\qquad$ $16$ chickens in $2$ chicken coops $0$ chickens per chicken coop." :question/worked-solution "The ratio of the number of chickens to the number of chicken coops is ${\\color{blue}16}:{\\color{red}2}$. So we start with the ratio $16:2$ and write it as a fraction:\n\n$$\n\\dfrac{{\\color{blue}16}}{{\\color{red}2}}\n$$\n\nWe can make a denominator of $1$ by dividing the numerator and denominator by $2$:\n\n$$\n\\dfrac{16 \\div 2}{2 \\div 2} = \\dfrac{8}{1} = 8\n$$\n\nSo,\n\n$\\qquad$ $16$ chickens in $2$ chicken coops $= 8$ chickens per chicken coop."}] [{:db/id #edb/ref 17592186073571 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073887 :knowledge-point/id #uuid "f78d8f50-ae86-59e6-8c88-abc42a6a9fc2" :knowledge-point/title "Calculating Whole Number Unit Rates"}] :question/id #uuid "199c8a83-265f-598b-a6f3-a606f3bbd7a7" :question/math-academy-id "e-2292" :question/problem "Carl walks $450$ meters in $5$ minutes. If he walks at a constant pace, at what rate does he walk?" :question/worked-solution "The ratio of meters to minutes that Carl walks is ${\\color{blue}450}:{\\color{red}5}$. So we start with the ratio $450:5$ and write it as a fraction:\n\n$$\n\\dfrac{{\\color{blue}450}}{{\\color{red}5}}\n$$\n\nWe can make a denominator of $1$ by dividing the numerator and denominator by $5$:\n\n$$\n\\dfrac{{\\color{blue}450}\\div 5}{{\\color{red}5}\\div 5} = \\dfrac{{\\color{blue}90}}{{\\color{red}1}}\n$$\n\nTherefore, Carl walks at a rate of $90$ meters per minute."}] [{:db/id #edb/ref 17592186073572 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073888 :knowledge-point/id #uuid "6edca753-d8cd-55a6-883b-81f80af0e0cc" :knowledge-point/title "Calculating Unit Rates as Fractions"}] :question/id #uuid "3997c678-94c6-5f9f-bf6a-dc752e89b3fe" :question/math-academy-id "e-2293" :question/problem "Anthony says $400$ words in $6$ minutes. If he speaks at a steady pace, what statement describes the unit rate?" :question/worked-solution "The ratio of spoken words to minutes is ${\\color{blue}400}:{\\color{red}6}$. So we start with the ratio $400:6$ and write it as a fraction:\n\n$$\n\\dfrac{{\\color{blue}400}}{{\\color{red}6}}\n$$\n\nWe can reduce this fraction to its lowest terms by dividing the numerator and denominator by $2$:\n\n$$\n\\dfrac{400 \\div 2}{6 \\div 2} = \\dfrac{200}{3}\n$$\n\nTherefore, Anthony said\n\n$$\n\\dfrac{200}{3}\n$$\n\nwords per minute."}] [{:db/id #edb/ref 17592186073573 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073889 :knowledge-point/id #uuid "f84a62df-3608-5166-af37-4f72d8f1b821" :knowledge-point/title "Calculating Unit Rates as Decimals"}] :question/id #uuid "ffe79c28-3eef-51a9-9185-283676fdaf65" :question/math-academy-id "e-2294" :question/problem "Donald writes $3$ words in $2$ seconds. If he writes at a steady pace, how many words does he write per second?" :question/worked-solution "The ratio of words to seconds is ${\\color{blue}3}:{\\color{red}2}$. Expressing this as a fraction, we have:\n\n$$\n\\dfrac{{\\color{blue}3}}{{\\color{red}2}}\n$$\n\nWe can convert this fraction to a decimal by multiplying the numerator and denominator by $5{:}$\n\n$$\n\\dfrac{3 \\times 5}{2 \\times 5} = \\dfrac{15}{10} = 1.5\n$$\n\nTherefore, Donald writes $1.5$ words per second."}]}
