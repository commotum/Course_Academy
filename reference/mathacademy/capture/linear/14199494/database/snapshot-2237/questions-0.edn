75ea097cc90ff05fcfc72fc3270553248de0f2b.png)\n\nThe graph above shows the curve $y={(\\frac{1}{8})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{8})}^{x}$ is $y=0.$ \n\nThe vertical translation $y={(\\frac{1}{8})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=-3.$ Therefore, $c=-3.$"}] [{:db/id #edb/ref 17592186401915 :knowledge-point/_questions [{:db/id #edb/ref 17592186068900 :knowledge-point/id #uuid "66ade855-4b16-514b-b44a-1d6b9d61ef28" :knowledge-point/title "Identifying the Shift Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c3666f3-ba98-51a9-b678-f25e043d3a37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+3.5" :db/id #edb/ref 17592186401917} {:answer/id #uuid "e8039e0c-f293-5ce4-b395-a4064a0685bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}-2.5" :db/id #edb/ref 17592186401918} {:answer/id #uuid "a5f24666-89d0-5332-bb2a-21f966094be5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}-3.5" :db/id #edb/ref 17592186401919} {:answer/id #uuid "a479a80c-f0e1-5b4f-9f67-06b99cd086bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+1.5" :db/id #edb/ref 17592186401920} {:answer/id #uuid "266f8f59-63e6-5980-a4b9-749b4fb8201c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+2.5" :db/id #edb/ref 17592186401921}] :answer-field/correct {:answer/id #uuid "266f8f59-63e6-5980-a4b9-749b4fb8201c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+2.5" :db/id #edb/ref 17592186401921} :answer-field/id #uuid "828a7f8a-1289-571e-8aa4-3a396be14d44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401916}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6948e752-4360-51fe-b06f-c6885f4f282f" :question/math-academy-id "q-27482" :question/problem "![](images/c0/c091fc5d742ddca3090725974f00ff7da77b1530d601bb82e288518b27970b0a.png)\n\nThe graph above shows the curve $y={(\\frac{1}{9})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{9})}^{x}$ is $y=0.$\n\nThe vertical translation $y={(\\frac{1}{9})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=2.5.$ Therefore, $c=2.5.$"}] [{:db/id #edb/ref 17592186515538 :knowledge-point/_questions [{:db/id #edb/ref 17592186068830 :knowledge-point/id #uuid "617f0fe6-7998-5d77-b11f-55a0eca11440" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22d13b87-15e2-5156-af20-e9f92d7d3e83" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6b/6ba96fe137b5e6a716ac2f196539a23c783364f3e4ff2fe33384d963760f7cb8.png" :db/id #edb/ref 17592186514953} {:answer/id #uuid "37a5d74f-d40f-5fd5-80ec-9ce4a581202b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2e/2e900d35853346bfbbcac7bb7b48298d45dc39313a549c1459b3aefae2834bad.png" :db/id #edb/ref 17592186514994} {:answer/id #uuid "426cb82b-e20d-5f97-8a0f-067aa9119d68" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/df/df5ae3fe92f747b89e6fdeaad42e4adb8d48db87c302c870caf430442e13cda8.png" :db/id #edb/ref 17592186515013} {:answer/id #uuid "95ed6a5f-c6df-523f-b42e-cd835a9a1c8a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fb/fb918b3042ca95c9401f2938258b7f13c909a87d18448c6e36c410a3d092dd94.png" :db/id #edb/ref 17592186515188} {:answer/id #uuid "efcd7883-e1fd-57d5-928e-040cec2366cc" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e6/e67fd37e421285fcdee0fcd1fae9e2d15171addf075290a7041aec008c0572f8.png" :db/id #edb/ref 17592186515375}] :answer-field/correct {:answer/id #uuid "95ed6a5f-c6df-523f-b42e-cd835a9a1c8a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fb/fb918b3042ca95c9401f2938258b7f13c909a87d18448c6e36c410a3d092dd94.png" :db/id #edb/ref 17592186515188} :answer-field/id #uuid "bc82adce-c8de-5498-affa-bca1f361d52c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515484}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4a3ed51c-6c18-5fdf-aaa4-d46ab866edd6" :question/math-academy-id "q-27537" :question/problem "Which of the following is the graph of $y=2{(\\frac{1}{7})}^{x}+3?$" :question/worked-solution "We start with plotting the graph of $y={(\\frac{1}{7})}^{x}:$\n\n![](images/75/75bb797ddbea41de97c1c4ba52e142342bfffb4f9b2b9b82111ebc94abf55446.png)\n\nNext, we plot the graph of $y=2{(\\frac{1}{7})}^{x}.$ To do this, we scale the graph above by a factor of $2.$ The $y$-intercept moves from $(0,1)$ to $(0,2)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/d6/d68957038bfad7dfb4547d69abd178b087dde6c0f7c8ba95aa0fcd7547ccebe6.png)\n\nFinally, we plot the graph of $y=2{(\\frac{1}{7})}^{x}+3.$ To do this, we shift the above graph $3$ units up. The $y$-intercept moves from $(0,2)$ to $(0,5)$ and the horizontal asymptote moves from $y=0$ to $y=3.$\n\n![](images/fb/fb918b3042ca95c9401f2938258b7f13c909a87d18448c6e36c410a3d092dd94.png)"}]}
