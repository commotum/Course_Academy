#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186069765} :activity/id #uuid "5071f49b-61a5-5356-822f-9c3ef335a011" :activity/scope {:db/id #edb/ref 17592186049379 :topic/id #uuid "f00a9477-eac3-545c-94be-9201367d2a01" :topic/math-academy-id 456} :activity/steps [{:db/id #edb/ref 17592186069765 :step/content {:db/id #edb/ref 17592186069938 :tutorial/content "Adding or subtracting a value to the graph of $y=\\left( \\dfrac{1}{2} \\right)^x$ will **translate** (shift) the graph up or down the $y$-axis. \n\nFor instance, $y=\\left( \\dfrac{1}{2} \\right)^x+3$ has the same shape as $y=\\left( \\dfrac{1}{2} \\right)^x,$ but it's shifted $3$ units up.\n\n![](images/f7/f76f7a276392996811bd70c707107c3b8e3e764c38d188ae3e31e4414ad92ff2.png)\n\nNote the following points:\n\n- The $y$-intercept $(0,1)$ has moved up $3$ units to the point $(0,4).$\n\n- The horizontal asymptote $y=0$ has moved up $3$ units to $y=3.$\n\nNow, consider the graph of $y=\\left( \\dfrac{1}{2} \\right)^x-3.$ In this case, the graph of $y=\\left( \\dfrac{1}{2} \\right)^x$ is shifted $3$ units *down*.\n\n![](images/7e/7e5afd3739b8db7488041a8c90fc0ca7db1e61908ffd7bf7ca4d484fa356f5eb.png)" :tutorial/id #uuid "2643e949-fb98-521b-81d0-fd82217dfc2e" :tutorial/math-academy-id 1546 :tutorial/title "Introduction"} :step/id #uuid "32de2f5b-55c5-5708-a384-5a4d3bc02ea7" :step/math-academy-id 3945 :step/next {:db/id #edb/ref 17592186069766}} {:db/id #edb/ref 17592186069766 :step/content {:db/id #edb/ref 17592186068829 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068454 :question/id #uuid "da62e401-d03d-54fd-90b5-410d36bdefad" :question/math-academy-id "e-1226"} :knowledge-point/id #uuid "5bb394c3-cd7c-523d-88df-b1306d9d528f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048295} {:db/id #edb/ref 17592186049660}] :knowledge-point/questions [{:db/id #edb/ref 17592186069196} {:db/id #edb/ref 17592186069198} {:db/id #edb/ref 17592186297326} {:db/id #edb/ref 17592186297335} {:db/id #edb/ref 17592186390531} {:db/id #edb/ref 17592186390592}] :knowledge-point/title "Identifying a Vertically Shifted Exponential Decay Curve"} :step/id #uuid "fe3a1979-05f3-5832-b489-34e3e8ebfc22" :step/math-academy-id 3946 :step/next {:db/id #edb/ref 17592186069874}} {:db/id #edb/ref 17592186069767 :step/content {:db/id #edb/ref 17592186069939 :tutorial/content "When an exponential decay function is vertically shifted *and* stretched, we apply the stretch first and the shift second.\n\nFor example, to plot the function $y=2\\left( \\dfrac{1}{4} \\right)^x+3,$ we start by plotting the graph of $y = \\left( \\dfrac{1}{4} \\right)^x{:}$\n\n![](images/84/842f4b6dfd9a45f4d187f4b448048879761cfbf4d880a113c9f3fcabc4988543.png)\n\nNext, we plot the graph of $y = 2\\left(\\dfrac{1}{4}\\right)^x.$ To do this, we scale the graph above by a factor of $2.$ The $y$-intercept moves from $(0,1)$ to $(0,2)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/04/0439fee0ab5e8e993cd5eda5dbebc72e5b79209c60aa547c036940ced6a970eb.png)\n\nFinally, we plot the graph of $y = 2\\left(\\dfrac{1}{4}\\right)^x + 3.$ To do this, we shift the above graph $3$ units above. The $y$-intercept moves from $(0,2)$ to $(0,5)$ and the horizontal asymptote moves from $y=0$ to $y=3.$\n\n![](images/22/220210f1b1ece359ea2ba4b41a1176ba02c0e34c370ad09772d03a5afeacbe7d.png)" :tutorial/id #uuid "7a2e3fc7-99a8-5c89-a397-52280e4ecbc6" :tutorial/math-academy-id 1547 :tutorial/title "Combining Vertical Shift and Vertical Stretch"} :step/id #uuid "b04bf78e-c879-5191-9534-b9fde2a2169a" :step/math-academy-id 3949 :step/next {:db/id #edb/ref 17592186069768}} {:db/id #edb/ref 17592186069768 :step/content {:db/id #edb/ref 17592186068830 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068455 :question/id #uuid "be6b6b07-c139-5ba2-b463-420a2ead54c8" :question/math-academy-id "e-1227"} :knowledge-point/id #uuid "617f0fe6-7998-5d77-b11f-55a0eca11440" :knowledge-point/questions [{:db/id #edb/ref 17592186069234} {:db/id #edb/ref 17592186069235} {:db/id #edb/ref 17592186284627} {:db/id #edb/ref 17592186292847} {:db/id #edb/ref 17592186297372} {:db/id #edb/ref 17592186297395} {:db/id #edb/ref 17592186390538} {:db/id #edb/ref 17592186390545} {:db/id #edb/ref 17592186515538}] :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Decay Curve"} :step/id #uuid "a406ece2-26b0-5d5c-823f-d5f1d634a612" :step/math-academy-id 3950 :step/next {:db/id #edb/ref 17592186069769}} {:db/id #edb/ref 17592186069769 :step/content {:db/id #edb/ref 17592186068831 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068456 :question/id #uuid "5ab90279-394b-5df0-8bf3-a1042196b40c" :question/math-academy-id "e-1228"} :knowledge-point/id #uuid "cc402a1d-e538-5510-8a6f-79dd1626ff1f" :knowledge-point/questions [{:db/id #edb/ref 17592186069199} {:db/id #edb/ref 17592186069442} {:db/id #edb/ref 17592186233712} {:db/id #edb/ref 17592186284628} {:db/id #edb/ref 17592186284629} {:db/id #edb/ref 17592186292853} {:db/id #edb/ref 17592186297401} {:db/id #edb/ref 17592186339114} {:db/id #edb/ref 17592186362384}] :knowledge-point/title "Identifying the Shift and Stretch Applied to an Exponential Decay Curve"} :step/id #uuid "fce7e39f-73dc-5287-a314-f30592e4dcfb" :step/math-academy-id 3953} {:db/id #edb/ref 17592186069874 :step/content {:db/id #edb/ref 17592186068900 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068519 :question/id #uuid "20a59278-1d09-5519-a362-4634ac9d5144" :question/math-academy-id "e-1587"} :knowledge-point/id #uuid "66ade855-4b16-514b-b44a-1d6b9d61ef28" :knowledge-point/questions [{:db/id #edb/ref 17592186069197} {:db/id #edb/ref 17592186069508} {:db/id #edb/ref 17592186292732} {:db/id #edb/ref 17592186292734} {:db/id #edb/ref 17592186292735} {:db/id #edb/ref 17592186292776} {:db/id #edb/ref 17592186339128} {:db/id #edb/ref 17592186339133} {:db/id #edb/ref 17592186401593} {:db/id #edb/ref 17592186401915} {:db/id #edb/ref 17592186403461} {:db/id #edb/ref 17592186403592}] :knowledge-point/title "Identifying the Shift Applied to an Exponential Decay Curve"} :step/id #uuid "cf2e4ded-9860-5ec2-a51a-b00155369068" :step/math-academy-id 5012 :step/next {:db/id #edb/ref 17592186069767}}] :activity/title "Vertical Translations of Exponential Decay Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068983}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186515620} :activity/id #uuid "aa9f706d-d3bf-546e-a855-b553a66819a6" :activity/scope {:db/id #edb/ref 17592186049379 :topic/id #uuid "f00a9477-eac3-545c-94be-9201367d2a01" :topic/math-academy-id 456} :activity/steps [{:db/id #edb/ref 17592186515620 :step/content {:db/id #edb/ref 17592186292735 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f1524a6-7f03-5e72-bf82-1ddc542b908b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={(\\frac{1}{8})}^{x}+2" :db/id #edb/ref 17592186290820} {:answer/id #uuid "62a82062-3d6f-5c8a-b3ca-f37bfc94b1a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={(\\frac{1}{8})}^{x}-2" :db/id #edb/ref 17592186291052} {:answer/id #uuid "68499c0c-8bf6-54d3-b445-bdc327cc3c31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={(\\frac{1}{8})}^{x}" :db/id #edb/ref 17592186291076} {:answer/id #uuid "96aba9d4-6466-5956-84da-742a9ab407d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={(\\frac{1}{8})}^{x}-3" :db/id #edb/ref 17592186291287} {:answer/id #uuid "f32f9982-fb06-5fab-8169-95424e927795" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={(\\frac{1}{8})}^{x}+3" :db/id #edb/ref 17592186291656}] :answer-field/correct {:db/id #edb/ref 17592186291287} :answer-field/id #uuid "c03a85b4-faa5-5ef3-aba6-0260bd670f31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186292326}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "62bc1f6e-1349-5366-88e9-e847cbcbc1f3" :question/math-academy-id "q-27448" :question/problem "![](images/f5/f5b33723509f58055f0ded0c575ea097cc90ff05fcfc72fc3270553248de0f2b.png)\n\nThe graph above shows the curve $y={(\\frac{1}{8})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{8})}^{x}$ is $y=0.$ \n\nThe vertical translation $y={(\\frac{1}{8})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=-3.$ Therefore, $c=-3.$"} :step/id #uuid "02e6e2f5-eeca-5fdb-b0e3-b9668d41f577" :step/next {:db/id #edb/ref 17592186515700}} {:db/id #edb/ref 17592186515649 :step/content {:db/id #edb/ref 17592186515538 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22d13b87-15e2-5156-af20-e9f92d7d3e83" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/6b/6ba96fe137b5e6a716ac2f196539a23c783364f3e4ff2fe33384d963760f7cb8.png" :db/id #edb/ref 17592186514953} {:answer/id #uuid "37a5d74f-d40f-5fd5-80ec-9ce4a581202b" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/2e/2e900d35853346bfbbcac7bb7b48298d45dc39313a549c1459b3aefae2834bad.png" :db/id #edb/ref 17592186514994} {:answer/id #uuid "426cb82b-e20d-5f97-8a0f-067aa9119d68" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/df/df5ae3fe92f747b89e6fdeaad42e4adb8d48db87c302c870caf430442e13cda8.png" :db/id #edb/ref 17592186515013} {:answer/id #uuid "95ed6a5f-c6df-523f-b42e-cd835a9a1c8a" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/fb/fb918b3042ca95c9401f2938258b7f13c909a87d18448c6e36c410a3d092dd94.png" :db/id #edb/ref 17592186515188} {:answer/id #uuid "efcd7883-e1fd-57d5-928e-040cec2366cc" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e6/e67fd37e421285fcdee0fcd1fae9e2d15171addf075290a7041aec008c0572f8.png" :db/id #edb/ref 17592186515375}] :answer-field/correct {:db/id #edb/ref 17592186515188} :answer-field/id #uuid "bc82adce-c8de-5498-affa-bca1f361d52c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186515484}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4a3ed51c-6c18-5fdf-aaa4-d46ab866edd6" :question/math-academy-id "q-27537" :question/problem "Which of the following is the graph of $y=2{(\\frac{1}{7})}^{x}+3?$" :question/worked-solution "We start with plotting the graph of $y={(\\frac{1}{7})}^{x}:$\n\n![](images/75/75bb797ddbea41de97c1c4ba52e142342bfffb4f9b2b9b82111ebc94abf55446.png)\n\nNext, we plot the graph of $y=2{(\\frac{1}{7})}^{x}.$ To do this, we scale the graph above by a factor of $2.$ The $y$-intercept moves from $(0,1)$ to $(0,2)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/d6/d68957038bfad7dfb4547d69abd178b087dde6c0f7c8ba95aa0fcd7547ccebe6.png)\n\nFinally, we plot the graph of $y=2{(\\frac{1}{7})}^{x}+3.$ To do this, we shift the above graph $3$ units up. The $y$-intercept moves from $(0,2)$ to $(0,5)$ and the horizontal asymptote moves from $y=0$ to $y=3.$\n\n![](images/fb/fb918b3042ca95c9401f2938258b7f13c909a87d18448c6e36c410a3d092dd94.png)"} :step/id #uuid "4300152a-9d2e-58c9-8a25-583173e89e5b"} {:db/id #edb/ref 17592186515700 :step/content {:db/id #edb/ref 17592186401915 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c3666f3-ba98-51a9-b678-f25e043d3a37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={(\\frac{1}{9})}^{x}+3.5" :db/id #edb/ref 17592186401917} {:answer/id #uuid "e8039e0c-f293-5ce4-b395-a4064a0685bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={(\\frac{1}{9})}^{x}-2.5" :db/id #edb/ref 17592186401918} {:answer/id #uuid "a5f24666-89d0-5332-bb2a-21f966094be5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={(\\frac{1}{9})}^{x}-3.5" :db/id #edb/ref 17592186401919} {:answer/id #uuid "a479a80c-f0e1-5b4f-9f67-06b99cd086bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={(\\frac{1}{9})}^{x}+1.5" :db/id #edb/ref 17592186401920} {:answer/id #uuid "266f8f59-63e6-5980-a4b9-749b4fb8201c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={(\\frac{1}{9})}^{x}+2.5" :db/id #edb/ref 17592186401921}] :answer-field/correct {:db/id #edb/ref 17592186401921} :answer-field/id #uuid "828a7f8a-1289-571e-8aa4-3a396be14d44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186401916}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6948e752-4360-51fe-b06f-c6885f4f282f" :question/math-academy-id "q-27482" :question/problem "![](images/c0/c091fc5d742ddca3090725974f00ff7da77b1530d601bb82e288518b27970b0a.png)\n\nThe graph above shows the curve $y={(\\frac{1}{9})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{9})}^{x}$ is $y=0.$\n\nThe vertical translation $y={(\\frac{1}{9})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=2.5.$ Therefore, $c=2.5.$"} :step/id #uuid "d57bc66a-ca66-5cef-bc31-6b10781f64a7" :step/next {:db/id #edb/ref 17592186515649}}] :activity/title "Vertical Translations of Exponential Decay Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186514862}]}
