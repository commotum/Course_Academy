#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186069765} :activity/id #uuid "5071f49b-61a5-5356-822f-9c3ef335a011" :activity/scope {:db/id #edb/ref 17592186049379 :topic/id #uuid "f00a9477-eac3-545c-94be-9201367d2a01" :topic/math-academy-id 456} :activity/steps [{:db/id #edb/ref 17592186069765 :step/content {:db/id #edb/ref 17592186069938 :tutorial/content "Adding or subtracting a value to the graph of $y=\\left( \\dfrac{1}{2} \\right)^x$ will **translate** (shift) the graph up or down the $y$-axis. \n\nFor instance, $y=\\left( \\dfrac{1}{2} \\right)^x+3$ has the same shape as $y=\\left( \\dfrac{1}{2} \\right)^x,$ but it's shifted $3$ units up.\n\n![](images/f7/f76f7a276392996811bd70c707107c3b8e3e764c38d188ae3e31e4414ad92ff2.png)\n\nNote the following points:\n\n- The $y$-intercept $(0,1)$ has moved up $3$ units to the point $(0,4).$\n\n- The horizontal asymptote $y=0$ has moved up $3$ units to $y=3.$\n\nNow, consider the graph of $y=\\left( \\dfrac{1}{2} \\right)^x-3.$ In this case, the graph of $y=\\left( \\dfrac{1}{2} \\right)^x$ is shifted $3$ units *down*.\n\n![](images/7e/7e5afd3739b8db7488041a8c90fc0ca7db1e61908ffd7bf7ca4d484fa356f5eb.png)" :tutorial/id #uuid "2643e949-fb98-521b-81d0-fd82217dfc2e" :tutorial/math-academy-id 1546 :tutorial/title "Introduction"} :step/id #uuid "32de2f5b-55c5-5708-a384-5a4d3bc02ea7" :step/math-academy-id 3945 :step/next {:db/id #edb/ref 17592186069766}} {:db/id #edb/ref 17592186069766 :step/content {:db/id #edb/ref 17592186068829 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068454 :question/id #uuid "da62e401-d03d-54fd-90b5-410d36bdefad" :question/math-academy-id "e-1226"} :knowledge-point/id #uuid "5bb394c3-cd7c-523d-88df-b1306d9d528f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048295} {:db/id #edb/ref 17592186049660}] :knowledge-point/questions [{:db/id #edb/ref 17592186069196} {:db/id #edb/ref 17592186069198} {:db/id #edb/ref 17592186297326} {:db/id #edb/ref 17592186297335} {:db/id #edb/ref 17592186390531} {:db/id #edb/ref 17592186390592}] :knowledge-point/title "Identifying a Vertically Shifted Exponential Decay Curve"} :step/id #uuid "fe3a1979-05f3-5832-b489-34e3e8ebfc22" :step/math-academy-id 3946 :step/next {:db/id #edb/ref 17592186069874}} {:db/id #edb/ref 17592186069767 :step/content {:db/id #edb/ref 17592186069939 :tutorial/content "When an exponential decay function is vertically shifted *and* stretched, we apply the stretch first and the shift second.\n\nFor example, to plot the function $y=2\\left( \\dfrac{1}{4} \\right)^x+3,$ we start by plotting the graph of $y = \\left( \\dfrac{1}{4} \\right)^x{:}$\n\n![](images/84/842f4b6dfd9a45f4d187f4b448048879761cfbf4d880a113c9f3fcabc4988543.png)\n\nNext, we plot the graph of $y = 2\\left(\\dfrac{1}{4}\\right)^x.$ To do this, we scale the graph above by a factor of $2.$ The $y$-intercept moves from $(0,1)$ to $(0,2)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/04/0439fee0ab5e8e993cd5eda5dbebc72e5b79209c60aa547c036940ced6a970eb.png)\n\nFinally, we plot the graph of $y = 2\\left(\\dfrac{1}{4}\\right)^x + 3.$ To do this, we shift the above graph $3$ units above. The $y$-intercept moves from $(0,2)$ to $(0,5)$ and the horizontal asymptote moves from $y=0$ to $y=3.$\n\n![](images/22/220210f1b1ece359ea2ba4b41a1176ba02c0e34c370ad09772d03a5afeacbe7d.png)" :tutorial/id #uuid "7a2e3fc7-99a8-5c89-a397-52280e4ecbc6" :tutorial/math-academy-id 1547 :tutorial/title "Combining Vertical Shift and Vertical Stretch"} :step/id #uuid "b04bf78e-c879-5191-9534-b9fde2a2169a" :step/math-academy-id 3949 :step/next {:db/id #edb/ref 17592186069768}} {:db/id #edb/ref 17592186069768 :step/content {:db/id #edb/ref 17592186068830 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068455 :question/id #uuid "be6b6b07-c139-5ba2-b463-420a2ead54c8" :question/math-academy-id "e-1227"} :knowledge-point/id #uuid "617f0fe6-7998-5d77-b11f-55a0eca11440" :knowledge-point/questions [{:db/id #edb/ref 17592186069234} {:db/id #edb/ref 17592186069235} {:db/id #edb/ref 17592186284627} {:db/id #edb/ref 17592186292847} {:db/id #edb/ref 17592186297372} {:db/id #edb/ref 17592186297395} {:db/id #edb/ref 17592186390538} {:db/id #edb/ref 17592186390545}] :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Decay Curve"} :step/id #uuid "a406ece2-26b0-5d5c-823f-d5f1d634a612" :step/math-academy-id 3950 :step/next {:db/id #edb/ref 17592186069769}} {:db/id #edb/ref 17592186069769 :step/content {:db/id #edb/ref 17592186068831 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068456 :question/id #uuid "5ab90279-394b-5df0-8bf3-a1042196b40c" :question/math-academy-id "e-1228"} :knowledge-point/id #uuid "cc402a1d-e538-5510-8a6f-79dd1626ff1f" :knowledge-point/questions [{:db/id #edb/ref 17592186069199} {:db/id #edb/ref 17592186069442} {:db/id #edb/ref 17592186233712} {:db/id #edb/ref 17592186284628} {:db/id #edb/ref 17592186284629} {:db/id #edb/ref 17592186292853} {:db/id #edb/ref 17592186297401} {:db/id #edb/ref 17592186339114} {:db/id #edb/ref 17592186362384}] :knowledge-point/title "Identifying the Shift and Stretch Applied to an Exponential Decay Curve"} :step/id #uuid "fce7e39f-73dc-5287-a314-f30592e4dcfb" :step/math-academy-id 3953} {:db/id #edb/ref 17592186069874 :step/content {:db/id #edb/ref 17592186068900 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068519 :question/id #uuid "20a59278-1d09-5519-a362-4634ac9d5144" :question/math-academy-id "e-1587"} :knowledge-point/id #uuid "66ade855-4b16-514b-b44a-1d6b9d61ef28" :knowledge-point/questions [{:db/id #edb/ref 17592186069197} {:db/id #edb/ref 17592186069508} {:db/id #edb/ref 17592186292732} {:db/id #edb/ref 17592186292734} {:db/id #edb/ref 17592186292735} {:db/id #edb/ref 17592186292776} {:db/id #edb/ref 17592186339128} {:db/id #edb/ref 17592186339133} {:db/id #edb/ref 17592186401593} {:db/id #edb/ref 17592186401915} {:db/id #edb/ref 17592186403461} {:db/id #edb/ref 17592186403592}] :knowledge-point/title "Identifying the Shift Applied to an Exponential Decay Curve"} :step/id #uuid "cf2e4ded-9860-5ec2-a51a-b00155369068" :step/math-academy-id 5012 :step/next {:db/id #edb/ref 17592186069767}}] :activity/title "Vertical Translations of Exponential Decay Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068983}]}
