#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186120924} :activity/id #uuid "a57ecb02-a517-575e-937a-29d06cde95ac" :activity/scope {:db/id #edb/ref 17592186048829 :topic/id #uuid "c4140dd8-d457-5cdb-8b51-1b7b952642cd" :topic/math-academy-id 1818} :activity/steps [{:db/id #edb/ref 17592186120924 :step/content {:db/id #edb/ref 17592186120994 :tutorial/content "The common ratio ![](images/3a/3a4ef1c1b261a53f9c45d0c90f2d44b155125fe1e7b1359406830111b4846f2f.svg) of a geometric sequence is found by dividing any term by the term immediately before it:\n![](images/64/641727086c22a06619c11617fae703a715530b8436e05ea22ad57cfffdbf9e8f.svg)\n\nTherefore, the **recursive formula for a geometric sequence** with common ratio ![](images/3a/3a4ef1c1b261a53f9c45d0c90f2d44b155125fe1e7b1359406830111b4846f2f.svg) takes the form\n![](images/c6/c68961a8641390e8d86b86ec557512300a53f424912bed25e9939126e5d71c07.svg)\n\nThe above formula states that to get to the next term in the sequence, we multiply the previous term by ![](images/b2/b2e0c6bf822f391aab6c59cc540176f139c5c69f5a6f54ae9c81d451defe9c9f.svg)\n\nTo illustrate, consider the geometric sequence below:\n\n![](images/7c/7ceb288dea6b0c885bae7014d7170c923afb2d38b8ba6cb338cd63c32e6af5c0.svg)\n\nThe first term is ![](images/82/82447c5e47fb052201522cca2359b821307def74212b7ce26debbfd8875f4dc2.svg) and we can calculate the common ratio ![](images/3a/3a4ef1c1b261a53f9c45d0c90f2d44b155125fe1e7b1359406830111b4846f2f.svg) as\n\n![](images/d2/d2c615fcab22a64d8f610b7ff36d28190b787c456e9e4099d8f5be2522dafd9c.svg)\n\nTherefore, the recursive formula is\n\n![](images/9d/9d7aaea9acc235b192240da83d3e53d9d62ee6e67e128df01dba6bd0d1ced4ad.svg)\n\nWhen writing out our final answer for the recursive formula, we should also state the first term and the range for ![](images/c2/c2475d72e6ec36042292de6c0160930174172b2386148d823a70e59fddfb93c2.svg)\n\nTo check that the recursive formula is correct, we can use it to generate the next few terms of the series:\n\n![](images/b3/b397de9b364d11653d651b7fa2d6ddf422ede5fca1692596f527e3e293bafb27.svg)" :tutorial/id #uuid "ba1c40d0-f4d8-562e-9c41-9e0da7ea24a4" :tutorial/math-academy-id 1668 :tutorial/title "Introduction"} :step/id #uuid "499a7374-b1ea-510b-ad4d-6da274c17403" :step/math-academy-id 455131 :step/next {:db/id #edb/ref 17592186120925}} {:db/id #edb/ref 17592186120925 :step/content {:db/id #edb/ref 17592186119950 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119536 :question/id #uuid "0a5038b8-1c2e-591c-9190-9493014fd98a" :question/math-academy-id "e-1506"} :knowledge-point/id #uuid "ce50e834-b8c1-56da-8750-241601cd1046" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050380} {:db/id #edb/ref 17592186050977}] :knowledge-point/questions [{:db/id #edb/ref 17592186120169} {:db/id #edb/ref 17592186120170} {:db/id #edb/ref 17592186120469} {:db/id #edb/ref 17592186545806} {:db/id #edb/ref 17592186545818} {:db/id #edb/ref 17592186545822} {:db/id #edb/ref 17592186545829} {:db/id #edb/ref 17592186545846} {:db/id #edb/ref 17592186548992} {:db/id #edb/ref 17592186549032}] :knowledge-point/title "Constructing a Recursive Formula for a Geometric Sequence"} :step/id #uuid "9383b3af-074e-5945-a23a-a22fecf5c293" :step/math-academy-id 455132 :step/next {:db/id #edb/ref 17592186120926}} {:db/id #edb/ref 17592186120926 :step/content {:db/id #edb/ref 17592186119951 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119537 :question/id #uuid "25a92b77-314f-5e6a-8a26-5e631d10e4d0" :question/math-academy-id "e-1507"} :knowledge-point/id #uuid "6aee1b1d-3cb6-5f52-8973-13b067b1c41a" :knowledge-point/questions [{:db/id #edb/ref 17592186120165} {:db/id #edb/ref 17592186120171} {:db/id #edb/ref 17592186120470} {:db/id #edb/ref 17592186548977} {:db/id #edb/ref 17592186548998} {:db/id #edb/ref 17592186549041} {:db/id #edb/ref 17592186570006}] :knowledge-point/title "Calculating a Term of a Geometric Sequence Given Its Recursive Formula"} :step/id #uuid "35c45656-808c-5546-9a32-7e6bd7fd0bd1" :step/math-academy-id 455136 :step/next {:db/id #edb/ref 17592186120927}} {:db/id #edb/ref 17592186120927 :step/content {:db/id #edb/ref 17592186119952 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119584 :question/id #uuid "ae9a3613-9e84-53bd-ad35-48394adfdc30" :question/math-academy-id "e-4232"} :knowledge-point/id #uuid "aae4cf92-f456-5b5f-bf92-1c4aed5ee4f6" :knowledge-point/questions [{:db/id #edb/ref 17592186120166} {:db/id #edb/ref 17592186120472} {:db/id #edb/ref 17592186120473} {:db/id #edb/ref 17592186549059} {:db/id #edb/ref 17592186549061} {:db/id #edb/ref 17592186570036}] :knowledge-point/title "Calculating a Term of a Geometric Sequence Given a Recursive Formula in Function Notation"} :step/id #uuid "31f41524-9e94-56de-9207-89a364bea6cf" :step/math-academy-id 455140 :step/next {:db/id #edb/ref 17592186120928}} {:db/id #edb/ref 17592186120928 :step/content {:db/id #edb/ref 17592186119953 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119538 :question/id #uuid "33621cf4-4508-51d5-958b-18a6ec1ebc73" :question/math-academy-id "e-1508"} :knowledge-point/id #uuid "76437951-0d71-548b-b330-e494aa12c6a1" :knowledge-point/questions [{:db/id #edb/ref 17592186120413} {:db/id #edb/ref 17592186120471} {:db/id #edb/ref 17592186548984} {:db/id #edb/ref 17592186549046} {:db/id #edb/ref 17592186569984}] :knowledge-point/title "Identifying Geometric Sequences"} :step/id #uuid "ad84308b-51e1-5262-95cd-8c36986f7636" :step/math-academy-id 455144}] :activity/title "The Recursive Formula for a Geometric Sequence" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186120025}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186570069} :activity/id #uuid "ded1d378-db86-565b-8eaa-f9725c21c11b" :activity/scope {:db/id #edb/ref 17592186048829 :topic/id #uuid "c4140dd8-d457-5cdb-8b51-1b7b952642cd" :topic/math-academy-id 1818} :activity/steps [{:db/id #edb/ref 17592186570069 :step/content {:db/id #edb/ref 17592186570036 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18edd661-2027-5e28-96f0-f828f0dff38b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186569481} {:answer/id #uuid "3b0ddaba-2c82-500c-808e-1d839bf00de9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186569525} {:answer/id #uuid "5e33967c-829f-5beb-b8b0-ea9386b9050d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186569584} {:answer/id #uuid "9f6ee3a8-a1e6-5268-9d51-b43dc805f1e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186569697} {:answer/id #uuid "ffb6401b-1262-5f0b-b7c9-aea70518da43" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186569845}] :answer-field/correct {:db/id #edb/ref 17592186569845} :answer-field/id #uuid "8f97bdd2-bf1f-57d2-a993-56bdac1ca568" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186569898}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e5baa90b-efb9-5b0e-bee8-5a62fcaafd24" :question/math-academy-id "q-67498" :question/problem "What is the $5$th term of the geometric sequence given below?\n\n$$\nf(n+1)=-\\frac{1}{2}f(n),\\,f(1)=80,\\,n\\ge 1\n$$" :question/worked-solution "We use the recursive formula to compute the terms of the sequence up to the $5$th term:\n\n$$\n\\begin{aligned}f(1) & =80 \\\\ f(2) & =-\\frac{1}{2}f(1)=-\\frac{1}{2}(80)=-40 \\\\ f(3) & =-\\frac{1}{2}f(2)=-\\frac{1}{2}(-40)=20 \\\\ f(4) & =-\\frac{1}{2}f(3)=-\\frac{1}{2}(20)=-10 \\\\ f(5) & =-\\frac{1}{2}f(4)=-\\frac{1}{2}(-10)=5\\end{aligned}\n$$\n\nTherefore, $f(5)=5.$"} :step/id #uuid "6eaf6155-fd31-5612-a495-df002400eda9" :step/next {:db/id #edb/ref 17592186570075}} {:db/id #edb/ref 17592186570075 :step/content {:db/id #edb/ref 17592186569984 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a977656-5bc0-52c2-8412-7159dca353b5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186569523} {:answer/id #uuid "4727a762-fdee-5b8f-ab0a-5ac69d4cf5e3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186569541} {:answer/id #uuid "6aeed908-a161-5da2-adf1-5808f16f101a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186569612} {:answer/id #uuid "71bfc73a-a14f-5c8b-a23c-4a17d56fd53e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186569630} {:answer/id #uuid "ccbdc6ea-8277-599f-9f2d-8846ff5d253b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186569768}] :answer-field/correct {:db/id #edb/ref 17592186569768} :answer-field/id #uuid "0d1259d7-7153-5c05-8443-bfcd08dbb965" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186569850}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "42a89ddb-b42b-5afd-9218-01f794cbc72e" :question/math-academy-id "q-67501" :question/problem "Which of the three sequences below are geometric sequences?\n\nI. $\\frac{1}{4},\\,\\frac{1}{2},\\,2,\\,…$\n\nII. ${a}_{n+1}=\\frac{3}{2}{a}_{n},\\,{a}_{1}=-1,\\,n\\ge 1$\n\nIII. $1,\\,0.2,\\,0.03,\\,…$" :question/worked-solution "A sequence is geometric if there is a common ratio between its terms. Let's check each sequence in turn.\n\n- Sequence I is not a geometric sequence because not every pair of consecutive terms has the same ratio. To see this, we only need to go up to the third term:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}}=\\frac{(\\frac{1}{2})}{(\\frac{1}{4})} & =2 \\\\ \\frac{{a}_{3}}{{a}_{2}}=\\frac{2}{(\\frac{1}{2})} & =4\\end{aligned}\n$$\n\n- Sequence II is a geometric sequence. The recursive rule ${a}_{n+1}=\\frac{3}{2}{a}_{n}$ tells us that each term is $\\frac{3}{2}$ times the previous term, so the common ratio is $r=\\frac{3}{2}.$\n\n- Sequence III is not a geometric sequence because not every pair of consecutive terms has the same ratio. To see this, we only need to go up to the third term:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}}=\\frac{0.2}{1} & =0.2 \\\\ \\frac{{a}_{3}}{{a}_{2}}=\\frac{0.03}{0.2} & =0.15\\end{aligned}\n$$\n\nIn conclusion, only sequence II is a geometric sequence."} :step/id #uuid "90cd1598-b2f8-5d28-8110-090cd43a789d" :step/next {:db/id #edb/ref 17592186570093}} {:db/id #edb/ref 17592186570093 :step/content {:db/id #edb/ref 17592186570006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53773b9d-b41d-57fa-9993-8ee73ebf788b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186569565} {:answer/id #uuid "64bcca0d-1370-5e1e-9384-b9fe6e5c2226" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186569599} {:answer/id #uuid "74903b10-b9c3-5982-a77c-38ecc70f9cf4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36" :db/id #edb/ref 17592186569636} {:answer/id #uuid "9ba3a52b-1145-5782-88c9-4be78cb79a7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186569691} {:answer/id #uuid "e4bf7c3d-ba90-54f4-a876-93efb8156cca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186569807}] :answer-field/correct {:db/id #edb/ref 17592186569691} :answer-field/id #uuid "e8f8080f-0b51-545f-9d71-93e2c857b6d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186569943}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "857b63a1-09cd-5ba9-9404-4c37877c9864" :question/math-academy-id "q-79511" :question/problem "What is the $4$th term of the geometric sequence given below?\n\n$$\n{a}_{n+1}=-6{a}_{n},\\,{a}_{1}=\\frac{1}{36},\\,n\\ge 1\n$$" :question/worked-solution "We use the recursive formula to compute the terms of the sequence up to the $4$th term:\n\n$$\n\\begin{aligned}{a}_{1} & =\\frac{1}{36} \\\\ {a}_{2} & =-6{a}_{1}=-6(\\frac{1}{36})=-\\frac{1}{6} \\\\ {a}_{3} & =-6{a}_{2}=-6(-\\frac{1}{6})=1 \\\\ {a}_{4} & =-6{a}_{3}=-6(1)=-6\\end{aligned}\n$$\n\nTherefore, ${a}_{4}=-6.$"} :step/id #uuid "d7c48d56-9ae9-568b-9b4a-0e104f0a6f6d"}] :activity/title "The Recursive Formula for a Geometric Sequence" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186569443}]}
