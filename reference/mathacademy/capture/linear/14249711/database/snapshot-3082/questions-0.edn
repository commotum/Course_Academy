#{[{:db/id #edb/ref 17592186570036 :knowledge-point/_questions [{:db/id #edb/ref 17592186119952 :knowledge-point/id #uuid "aae4cf92-f456-5b5f-bf92-1c4aed5ee4f6" :knowledge-point/title "Calculating a Term of a Geometric Sequence Given a Recursive Formula in Function Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18edd661-2027-5e28-96f0-f828f0dff38b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186569481} {:answer/id #uuid "3b0ddaba-2c82-500c-808e-1d839bf00de9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186569525} {:answer/id #uuid "5e33967c-829f-5beb-b8b0-ea9386b9050d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186569584} {:answer/id #uuid "9f6ee3a8-a1e6-5268-9d51-b43dc805f1e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186569697} {:answer/id #uuid "ffb6401b-1262-5f0b-b7c9-aea70518da43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186569845}] :answer-field/correct {:answer/id #uuid "ffb6401b-1262-5f0b-b7c9-aea70518da43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186569845} :answer-field/id #uuid "8f97bdd2-bf1f-57d2-a993-56bdac1ca568" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569898}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e5baa90b-efb9-5b0e-bee8-5a62fcaafd24" :question/math-academy-id "q-67498" :question/problem "What is the $5$th term of the geometric sequence given below?\n\n$$\nf(n+1)=-\\frac{1}{2}f(n),\\,f(1)=80,\\,n\\ge 1\n$$" :question/worked-solution "We use the recursive formula to compute the terms of the sequence up to the $5$th term:\n\n$$\n\\begin{aligned}f(1) & =80 \\\\ f(2) & =-\\frac{1}{2}f(1)=-\\frac{1}{2}(80)=-40 \\\\ f(3) & =-\\frac{1}{2}f(2)=-\\frac{1}{2}(-40)=20 \\\\ f(4) & =-\\frac{1}{2}f(3)=-\\frac{1}{2}(20)=-10 \\\\ f(5) & =-\\frac{1}{2}f(4)=-\\frac{1}{2}(-10)=5\\end{aligned}\n$$\n\nTherefore, $f(5)=5.$"}] [{:db/id #edb/ref 17592186569984 :knowledge-point/_questions [{:db/id #edb/ref 17592186119953 :knowledge-point/id #uuid "76437951-0d71-548b-b330-e494aa12c6a1" :knowledge-point/title "Identifying Geometric Sequences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a977656-5bc0-52c2-8412-7159dca353b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186569523} {:answer/id #uuid "4727a762-fdee-5b8f-ab0a-5ac69d4cf5e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186569541} {:answer/id #uuid "6aeed908-a161-5da2-adf1-5808f16f101a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186569612} {:answer/id #uuid "71bfc73a-a14f-5c8b-a23c-4a17d56fd53e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186569630} {:answer/id #uuid "ccbdc6ea-8277-599f-9f2d-8846ff5d253b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186569768}] :answer-field/correct {:answer/id #uuid "ccbdc6ea-8277-599f-9f2d-8846ff5d253b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186569768} :answer-field/id #uuid "0d1259d7-7153-5c05-8443-bfcd08dbb965" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569850}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "42a89ddb-b42b-5afd-9218-01f794cbc72e" :question/math-academy-id "q-67501" :question/problem "Which of the three sequences below are geometric sequences?\n\nI. $\\frac{1}{4},\\,\\frac{1}{2},\\,2,\\,…$\n\nII. ${a}_{n+1}=\\frac{3}{2}{a}_{n},\\,{a}_{1}=-1,\\,n\\ge 1$\n\nIII. $1,\\,0.2,\\,0.03,\\,…$" :question/worked-solution "A sequence is geometric if there is a common ratio between its terms. Let's check each sequence in turn.\n\n- Sequence I is not a geometric sequence because not every pair of consecutive terms has the same ratio. To see this, we only need to go up to the third term:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}}=\\frac{(\\frac{1}{2})}{(\\frac{1}{4})} & =2 \\\\ \\frac{{a}_{3}}{{a}_{2}}=\\frac{2}{(\\frac{1}{2})} & =4\\end{aligned}\n$$\n\n- Sequence II is a geometric sequence. The recursive rule ${a}_{n+1}=\\frac{3}{2}{a}_{n}$ tells us that each term is $\\frac{3}{2}$ times the previous term, so the common ratio is $r=\\frac{3}{2}.$\n\n- Sequence III is not a geometric sequence because not every pair of consecutive terms has the same ratio. To see this, we only need to go up to the third term:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}}=\\frac{0.2}{1} & =0.2 \\\\ \\frac{{a}_{3}}{{a}_{2}}=\\frac{0.03}{0.2} & =0.15\\end{aligned}\n$$\n\nIn conclusion, only sequence II is a geometric sequence."}] [{:db/id #edb/ref 17592186570006 :knowledge-point/_questions [{:db/id #edb/ref 17592186119951 :knowledge-point/id #uuid "6aee1b1d-3cb6-5f52-8973-13b067b1c41a" :knowledge-point/title "Calculating a Term of a Geometric Sequence Given Its Recursive Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53773b9d-b41d-57fa-9993-8ee73ebf788b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186569565} {:answer/id #uuid "64bcca0d-1370-5e1e-9384-b9fe6e5c2226" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186569599} {:answer/id #uuid "74903b10-b9c3-5982-a77c-38ecc70f9cf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186569636} {:answer/id #uuid "9ba3a52b-1145-5782-88c9-4be78cb79a7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186569691} {:answer/id #uuid "e4bf7c3d-ba90-54f4-a876-93efb8156cca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186569807}] :answer-field/correct {:answer/id #uuid "9ba3a52b-1145-5782-88c9-4be78cb79a7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186569691} :answer-field/id #uuid "e8f8080f-0b51-545f-9d71-93e2c857b6d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569943}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "857b63a1-09cd-5ba9-9404-4c37877c9864" :question/math-academy-id "q-79511" :question/problem "What is the $4$th term of the geometric sequence given below?\n\n$$\n{a}_{n+1}=-6{a}_{n},\\,{a}_{1}=\\frac{1}{36},\\,n\\ge 1\n$$" :question/worked-solution "We use the recursive formula to compute the terms of the sequence up to the $4$th term:\n\n$$\n\\begin{aligned}{a}_{1} & =\\frac{1}{36} \\\\ {a}_{2} & =-6{a}_{1}=-6(\\frac{1}{36})=-\\frac{1}{6} \\\\ {a}_{3} & =-6{a}_{2}=-6(-\\frac{1}{6})=1 \\\\ {a}_{4} & =-6{a}_{3}=-6(1)=-6\\end{aligned}\n$$\n\nTherefore, ${a}_{4}=-6.$"}]}
