#{[{:db/id #edb/ref 17592186237896 :knowledge-point/_questions [{:db/id #edb/ref 17592186172023 :knowledge-point/id #uuid "3e6159dd-c12e-5882-be17-815b4cc9ae52" :knowledge-point/title "Finding the Roots of a Transformed Radical Function With an Odd Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03873688-2ce0-5a7d-a270-7a389651c5cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{13}{3}" :db/id #edb/ref 17592186235818} {:answer/id #uuid "1fdea023-ee70-5e48-80b9-a4af404acfb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no roots" :db/id #edb/ref 17592186236021} {:answer/id #uuid "91e5d9b8-17dd-5081-b514-ea5a751e5df8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4" :db/id #edb/ref 17592186236743} {:answer/id #uuid "a91f0063-ad28-5731-ace9-22524360f2a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4" :db/id #edb/ref 17592186236881} {:answer/id #uuid "c96e081d-127e-5e54-a36d-a8a7fa6c68c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{4}{3}" :db/id #edb/ref 17592186237095}] :answer-field/correct {:answer/id #uuid "a91f0063-ad28-5731-ace9-22524360f2a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4" :db/id #edb/ref 17592186236881} :answer-field/id #uuid "248493ae-7f8b-5803-8a10-57e7555a1705" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237485}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1ebf9ff3-e2bb-528f-a554-c8a05b21ceab" :question/math-academy-id "q-102416" :question/problem "Find the root of $f(x)=\\sqrt[7]{3x+13}-1.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n\\sqrt[7]{3x+13}-1=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt[7]{3x+13}-1 & =0 \\\\ \\sqrt[7]{3x+13} & =1 \\\\ (\\sqrt[7]{3x+13})^{7} & ={1}^{7} \\\\ 3x+13 & =1 \\\\ 3x & =-12 \\\\ x & =-4\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=-4.$"}]}
