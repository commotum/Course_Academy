#{[{:activity/first-step {:db/id #edb/ref 17592186172879} :activity/id #uuid "9e60f656-c2ee-5768-b1af-a3eb8499887f" :activity/scope {:db/id #edb/ref 17592186049387 :topic/id #uuid "f0b7f9f5-b45c-5478-b9c9-cc76a52e64dd" :topic/math-academy-id 3530} :activity/steps [{:db/id #edb/ref 17592186172879 :step/content {:db/id #edb/ref 17592186173151 :tutorial/content "When finding the roots of a transformed radical function, we need to consider whether the radical's index is odd or even.\n\nLet's start with the odd case first. As an example, we will find the root of the function $f(x)$, given by\n\n$$\nf(x) = \\sqrt[{\\color{blue}{3}}]{10-4x} + 2\\,\n$$\n\nNotice that we're dealing with a cube root, and so the index of the radical is ${\\color{blue}{3}}$, which is odd.\n\nTo find the root of $f(x)$, we must solve\n\n$$\nf(x)=0\n$$\n\n$$\n\\sqrt[3]{10 - 4x} + 2 = 0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\n\\sqrt[3]{10 - 4x} + 2 &= 0 \\\\\n\\sqrt[3]{10 - 4x} &= -2 \\\\\n(\\sqrt[3]{10 - 4x})^{3} &= (-2)^{3} \\\\\n10 - 4x &= -8 \\\\\n- 4x &= -18 \\\\\nx &= \\frac{9}{2}\n\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is\n\n$$\nx=\\dfrac92\n$$\n\nA transformed radical function with an odd index will always have one real root." :tutorial/id #uuid "a49268e2-e58c-5966-ba98-b1786827ba76" :tutorial/math-academy-id 4864 :tutorial/title "Introduction"} :step/id #uuid "ce36d68a-bbb4-56c0-b92d-852e3f103282" :step/math-academy-id 30460 :step/next {:db/id #edb/ref 17592186172880}} {:db/id #edb/ref 17592186172880 :step/content {:db/id #edb/ref 17592186172023 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171829 :question/id #uuid "64957847-edce-52b1-9848-545c18014262" :question/math-academy-id "e-8143"} :knowledge-point/id #uuid "3e6159dd-c12e-5882-be17-815b4cc9ae52" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048784}] :knowledge-point/questions [{:db/id #edb/ref 17592186172609} {:db/id #edb/ref 17592186172610} {:db/id #edb/ref 17592186237896} {:db/id #edb/ref 17592186292700} {:db/id #edb/ref 17592186294898} {:db/id #edb/ref 17592186294899} {:db/id #edb/ref 17592186294900} {:db/id #edb/ref 17592186518100} {:db/id #edb/ref 17592186518182}] :knowledge-point/title "Finding the Roots of a Transformed Radical Function With an Odd Index"} :step/id #uuid "9a817a13-cf12-5a56-abd1-7fbe139fe7b4" :step/math-academy-id 30461 :step/next {:db/id #edb/ref 17592186172928}} {:db/id #edb/ref 17592186172881 :step/content {:db/id #edb/ref 17592186172024 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171830 :question/id #uuid "96c06afd-4449-594e-8655-63f43ede736c" :question/math-academy-id "e-8144"} :knowledge-point/id #uuid "4d059c56-ae7f-5fb6-8bc6-2ce97bb7f876" :knowledge-point/questions [{:db/id #edb/ref 17592186172607} {:db/id #edb/ref 17592186172608} {:db/id #edb/ref 17592186234483} {:db/id #edb/ref 17592186237900} {:db/id #edb/ref 17592186292704} {:db/id #edb/ref 17592186294901} {:db/id #edb/ref 17592186357543} {:db/id #edb/ref 17592186399357} {:db/id #edb/ref 17592186404544} {:db/id #edb/ref 17592186518130} {:db/id #edb/ref 17592186518132} {:db/id #edb/ref 17592186518222} {:db/id #edb/ref 17592186541139}] :knowledge-point/title "Finding the Roots of a Transformed Radical Function With an Even Index"} :step/id #uuid "9b6bd47e-dc8a-5923-bbcc-1f0390d2d1db" :step/math-academy-id 30463} {:db/id #edb/ref 17592186172928 :step/content {:db/id #edb/ref 17592186173170 :tutorial/content "Let's now learn how to find the root of a radical function with an even index. For example, let's try to find the root of\n\n$$\nf(x) = -3\\sqrt[4]{10x+1} + 9\n$$\n\nTo find the root of $f(x)$, we must solve\n\n$$\nf(x)=0\n$$\n\n$$\n-3\\sqrt[4]{10x+1} + 9 = 0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\n-3\\sqrt[4]{10x + 1} + 9 &= 0 \\\\\n- 3\\sqrt[4]{10x + 1} &= -9 \\\\\n\\sqrt[4]{10x + 1} &= 3 \\\\\n(\\sqrt[4]{10x + 1})^{4} &= 3^{4} \\\\\n10x + 1 &= 81 \\\\\n10x &= 80 \\\\\nx &= 8\n\\end{aligned}\n$$\n\nFinally, we must check the answer by substituting it back into the initial equation:\n\n$$\n\\begin{aligned}\n-3\\sqrt[4]{10 \\cdot 8 + 1} + 9 &= 0 \\\\\n- 3\\sqrt[4]{81} + 9 &= 0 \\\\\n- 3 \\cdot 3 + 9 &= 0 \\\\\n0 &= 0✓\n\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=8$.\n\nWhen the index of the radical function is even, we should always check for extraneous roots by substituting them back into the original equation.\n\nSometimes, a radical function with an even index has no root. Let's see an example." :tutorial/id #uuid "0a1feb60-62da-5279-8bfd-f8be6c389de7" :tutorial/math-academy-id 5161 :tutorial/title "Finding the Roots of a Transformed Radical Function: Even Case"} :step/id #uuid "213cee54-dfad-5696-a210-97d588e61069" :step/math-academy-id 32450 :step/next {:db/id #edb/ref 17592186172881}}] :activity/title "Roots of Transformed Radical Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186172204}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186518251} :activity/id #uuid "c0330bc3-207b-51d0-a316-d2214c7dcda9" :activity/scope {:db/id #edb/ref 17592186049387 :topic/id #uuid "f0b7f9f5-b45c-5478-b9c9-cc76a52e64dd" :topic/math-academy-id 3530} :activity/steps [{:db/id #edb/ref 17592186518241 :step/content {:db/id #edb/ref 17592186518222 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a81b0420-9f65-531f-8353-eb44098ecd4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "22" :db/id #edb/ref 17592186517800}] :answer-field/correct {:db/id #edb/ref 17592186517800} :answer-field/id #uuid "7e943489-95ee-51af-889d-7b6b40dcc312" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186518029}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f9219fe2-5911-57bb-89ea-30d2a8256e49" :question/math-academy-id "q-277249" :question/problem "Find the root of $f(x)=\\sqrt[4]{3x+15}-3.$\n\n$x=$\n{{field-1}}" :question/worked-solution "To find the roots of $f(x),$ we must solve $f(x)=0:$\n\n$$\n\\sqrt[4]{3x+15}-3=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt[4]{3x+15}-3 & =0 \\\\ \\sqrt[4]{3x+15} & =3 \\\\ (\\sqrt[4]{3x+15})^{4} & ={3}^{4} \\\\ 3x+15 & =81 \\\\ 3x & =66 \\\\ x & =22\\end{aligned}\n$$\n\nFinally, we must check the answer by substituting it back into the initial equation:\n\n$$\n\\begin{aligned}\\sqrt[4]{3\\cdot 22+15}-3 & =0 \\\\ \\sqrt[4]{81}-3 & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=22.$"} :step/id #uuid "37545647-d742-511f-9014-7665d83e5c8e"} {:db/id #edb/ref 17592186518244 :step/content {:db/id #edb/ref 17592186518100 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7adc2636-e70e-5248-aa1c-0bb461a58b6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "168" :db/id #edb/ref 17592186517723}] :answer-field/correct {:db/id #edb/ref 17592186517723} :answer-field/id #uuid "cab81f3e-8bfa-5ab8-83cb-9612dc5b0919" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186518065}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "01c856f3-ee69-579a-9f89-fe0fbee2a037" :question/math-academy-id "q-277239" :question/problem "Find the root of $f(x)=\\sqrt[9]{-8-3x}+2.$\n\n$x=$\n{{field-1}}" :question/worked-solution "To find the root of $f(x),$ we must solve $f(x)=0:$\n\n$$\n\\sqrt[9]{-8-3x}+2=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt[9]{-8-3x}+2 & =0 \\\\ \\sqrt[9]{-8-3x} & =-2 \\\\ (\\sqrt[9]{-8-3x})^{9} & =(-2)^{9} \\\\ -8-3x & =-512 \\\\ -3x & =-504 \\\\ x & =168\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=168.$"} :step/id #uuid "39c4e283-d4d3-5d87-9aad-815227ed7633" :step/next {:db/id #edb/ref 17592186518241}} {:db/id #edb/ref 17592186518251 :step/content {:db/id #edb/ref 17592186518130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b8d030b-747c-50f7-bfed-0d7b9f175406" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{33}{7}" :db/id #edb/ref 17592186517636} {:answer/id #uuid "9bb6cd66-f41c-5eb6-8461-fb35f552d80d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The function has no root" :db/id #edb/ref 17592186517787} {:answer/id #uuid "af8f1e2a-1bc1-5f57-a33a-4631f51b1179" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=10" :db/id #edb/ref 17592186517819} {:answer/id #uuid "bde38374-e2a1-5247-9b57-f68cacfb826c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-10" :db/id #edb/ref 17592186517849} {:answer/id #uuid "fcce51e9-96c5-5943-a86f-056185216518" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=4" :db/id #edb/ref 17592186517964}] :answer-field/correct {:db/id #edb/ref 17592186517787} :answer-field/id #uuid "979c25b1-368c-57a9-a520-1e6925bb31db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518042}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "442d41d4-64b6-5c13-9965-e1b753377abb" :question/math-academy-id "q-93093" :question/problem "Find the root of $f(x)=\\sqrt[4]{7x+11}+3.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n\\sqrt[4]{7x+11}+3=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt[4]{7x+11}+3 & =0 \\\\ \\sqrt[4]{7x+11} & =-3\\end{aligned}\n$$\n\nThis equation does not have any solutions since its left-hand side is always nonnegative, while the right-hand side is negative.\n\nTherefore, $f(x)$ has no root."} :step/id #uuid "48c4878d-1971-57c2-a2fe-4c7e737d2430" :step/next {:db/id #edb/ref 17592186518264}} {:db/id #edb/ref 17592186518263 :step/content {:db/id #edb/ref 17592186518132 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17baf155-e96d-5274-8ea7-340ef7f9bd6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=8" :db/id #edb/ref 17592186517530} {:answer/id #uuid "3c29c508-ed39-5d19-8512-7d756ca4995b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=4" :db/id #edb/ref 17592186517606} {:answer/id #uuid "acd1e707-0b6f-5e39-905c-184792e0cf81" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The function has no roots" :db/id #edb/ref 17592186517809} {:answer/id #uuid "b07f2caf-1bf7-5a26-ba31-7455fbda5e3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-4" :db/id #edb/ref 17592186517820} {:answer/id #uuid "ea01e92b-e8f5-5231-9823-9b70074e18f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=16" :db/id #edb/ref 17592186517931}] :answer-field/correct {:db/id #edb/ref 17592186517931} :answer-field/id #uuid "9b8b26ed-f144-5797-9db5-2e62acbf1179" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518047}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4df596f3-7605-5476-aed1-e33a4f9ad66d" :question/math-academy-id "q-102549" :question/problem "Find the root of $f(x)=5\\sqrt[4]{4x+17}-15.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n5\\sqrt[4]{4x+17}-15=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}5\\sqrt[4]{4x+17}-15 & =0 \\\\ 5\\sqrt[4]{4x+17} & =15 \\\\ \\sqrt[4]{4x+17} & =3 \\\\ (\\sqrt[4]{4x+17})^{4} & ={3}^{4} \\\\ 4x+17 & =81 \\\\ 4x & =64 \\\\ x & =16\\end{aligned}\n$$\n\nFinally, we must check the answer by substituting it back into the initial equation:\n\n$$\n\\begin{aligned}5\\sqrt[4]{4\\cdot 16+17}-15 & =0 \\\\ 5\\sqrt[4]{81}-15 & =0 \\\\ 5\\cdot 3-15 & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=16.$"} :step/id #uuid "7d5b77cf-1d20-558c-85b8-c6f2f795dd91" :step/next {:db/id #edb/ref 17592186518244}} {:db/id #edb/ref 17592186518264 :step/content {:db/id #edb/ref 17592186518182 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2194eb1e-7b0d-5edd-85b7-6afbfe23a8c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=130" :db/id #edb/ref 17592186517548} {:answer/id #uuid "5e861c56-8d02-588c-a58f-376835a97092" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-130" :db/id #edb/ref 17592186517659} {:answer/id #uuid "658bb3fa-2757-5a31-8166-483686e4b0b3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The function has no roots" :db/id #edb/ref 17592186517674} {:answer/id #uuid "7ca7fe85-63d6-53ae-880b-cfc593ad5c0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-65" :db/id #edb/ref 17592186517725} {:answer/id #uuid "a81c0422-436d-580f-9767-5ba8eab6ddf6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{65}{2}" :db/id #edb/ref 17592186517801}] :answer-field/correct {:db/id #edb/ref 17592186517548} :answer-field/id #uuid "5cadf92c-a907-55b9-84ec-8b9165a4e849" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518017}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a9239051-66d6-5587-8b77-ad2324021796" :question/math-academy-id "q-102534" :question/problem "Find the root of $f(x)=\\sqrt[5]{17-2x}+3.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n\\sqrt[5]{17-2x}+3=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt[5]{17-2x}+3 & =0 \\\\ \\sqrt[5]{17-2x} & =-3 \\\\ (\\sqrt[5]{17-2x})^{5} & =(-3)^{5} \\\\ 17-2x & =-243 \\\\ -2x & =-260 \\\\ x & =130\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=130.$"} :step/id #uuid "83619bcc-b587-5fd0-a67b-67d9fe91b956" :step/next {:db/id #edb/ref 17592186518263}}] :activity/title "Roots of Transf