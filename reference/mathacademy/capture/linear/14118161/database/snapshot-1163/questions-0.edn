Therefore, $|U|\\ne |V|.$"}] [{:db/id #edb/ref 17592186414419 :knowledge-point/_questions [{:db/id #edb/ref 17592186171920 :knowledge-point/id #uuid "13fe2373-2094-5193-8e37-541d3a27e5e1" :knowledge-point/title "Using Arithmetic Sequences to Construct a Bijection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bb647a2-c753-52d4-86dd-b1355a896e6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "surjection" :db/id #edb/ref 17592186414265} {:answer/id #uuid "bbad18f4-d481-5162-933a-7f71ecfe5fe0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "injection" :db/id #edb/ref 17592186414326} {:answer/id #uuid "db9325fb-900c-55f2-a168-a447632ad8fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "bijection" :db/id #edb/ref 17592186414345}] :answer-field/correct {:answer/id #uuid "db9325fb-900c-55f2-a168-a447632ad8fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "bijection" :db/id #edb/ref 17592186414345} :answer-field/id #uuid "251d7581-c688-5919-9c12-44035ef581ef" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186414376} {:answer-field/choices [{:answer/id #uuid "1180da69-070a-5252-b980-f5c18aa9cc6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|A|\\ne |B|" :db/id #edb/ref 17592186414235} {:answer/id #uuid "5d963030-e5ea-5806-93b1-1db562964c9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|A|=|B|" :db/id #edb/ref 17592186414270}] :answer-field/correct {:answer/id #uuid "5d963030-e5ea-5806-93b1-1db562964c9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|A|=|B|" :db/id #edb/ref 17592186414270} :answer-field/id #uuid "c48e800f-2bae-5217-9921-20bb0d6952bc" :answer-field/key "f