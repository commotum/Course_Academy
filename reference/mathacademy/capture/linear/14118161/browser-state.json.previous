n\"><mjx-c class=\"mjx-c7C\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D448 TEX-I\"></mjx-c></mjx-mi><mjx-texatom texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c7C\"></mjx-c></mjx-mo></mjx-texatom><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-texatom space=\"4\" texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c7C\"></mjx-c></mjx-mo></mjx-texatom><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D449 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c7C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo stretchy=\"false\">|</mo><mi>U</mi><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mi>V</mi><mo stretchy=\"false\">|</mo></math></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></div></div></div>. \n</div><div class=\"questionWidget-buttonBar\"><div class=\"questionWidget-submitButton disabledButton\" style=\"display: none;\">Submit</div></div><div class=\"questionWidget-spinnerFrame\"><div class=\"questionWidget-spinner\" style=\"display: block;\"></div></div><div class=\"questionWidget-result\"><div class=\"questionWidget-incorrectIcon\"><img src=\"/img/incorrect-answer.svg\"></div><div class=\"questionWidget-incorrectText\">Incorrect</div></div><div class=\"questionWidget-explanationHeader\">EXPLANATION</div><div class=\"questionWidget-explanation\"><p>The cardinalities of two sets cannot be equal if one set is finite and the other is infinite.</p>\n<p>With that in mind, notice that </p>\n<ul>\n<li><p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"61\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D448 TEX-I\"></