9Q291 -134 285 -156T256 -198Q202 -250 89 -250Q71 -250 68 -247T65 -230Q65 -224 65 -223T66 -218T69 -214T77 -213Q91 -213 108 -210T146 -200T183 -177T207 -139Q208 -134 209 3L210 139Q223 196 280 230Q315 247 330 250Q305 257 280 270Q225 304 212 352L210 362L209 498Q208 635 207 640Q195 680 154 696T77 713Q68 713 67 716T65 731Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E18-MJMATHI-42\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E18-MJMAIN-3D\" x=\"1037\" y=\"0\"></use>\n <use xlink:href=\"#E18-MJMAIN-7B\" x=\"2093\" y=\"0\"></use>\n <use xlink:href=\"#E18-MJMAIN-30\" x=\"2594\" y=\"0\"></use>\n <use xlink:href=\"#E18-MJMAIN-2C\" x=\"3094\" y=\"0\"></use>\n <use xlink:href=\"#E18-MJMAIN-31\" x=\"3539\" y=\"0\"></use>\n <use xlink:href=\"#E18-MJMAIN-2C\" x=\"4040\" y=\"0\"></use>\n <use xlink:href=\"#E18-MJMAIN-32\" x=\"4485\" y=\"0\"></use>\n <use xlink:href=\"#E18-MJMAIN-2C\" x=\"4985\" y=\"0\"></use>\n <use xlink:href=\"#E18-MJMAIN-33\" x=\"5431\" y=\"0\"></use>\n <use xlink:href=\"#E18-MJMAIN-7D\" x=\"5931\" y=\"0\"></use>\n</g>\n</svg></span> each have a cardinality of <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.809ex\" height=\"2.176ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -791.3 779 936.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-19-Title\">\n<title id=\"MathJax-SVG-19-Title\">4.</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E19-MJMAIN-34\" d=\"M462 0Q444 3 333 3Q217 3 199 0H190V46H221Q241 46 248 46T265 48T279 53T286 61Q287 63 287 115V165H28V211L179 442Q332 674 334 675Q336 677 355 677H373L379 671V211H471V165H379V114Q379 73 379 66T385 54Q393 47 442 46H471V0H462ZM293 211V545L74 212L183 211H293Z\"></path>\n<path stroke-width=\"1\" id=\"E19-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E19-MJMAIN-34\"></use>\n <use xlink:href=\"#E19-MJMAIN-2E\" x=\"500\" y=\"0\"></use>\n</g>\n</svg></span> The corresponding bijection might be the following:</p>\n<div id=\"graphic-8f567f585a7821f9e0fb775b56c34bbf\" class=\"graphic\"><img src=\"/graphics/8f567f585a7821f9e0fb775b56c34bbf\"></div>   \n\n<p>In contrast, for the sets <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"9.256ex\" height=\"2.843ex\" style=\"vertical-align: -0.838ex;\" viewBox=\"0 -863.1 3985.1 1223.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-20-Title\">\n<title id=\"MathJax-SVG-20-Title\">C = \\{ \\triangle \\}</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E20-MJMATHI-43\" d=\"M50 252Q50 367 117 473T286 641T490 704Q580 704 633 653Q642 643 648 636T656 626L657 623Q660 623 684 649Q691 655 699 663T715 679T725 690L740 705H746Q760 705 760 698Q760 694 728 561Q692 422 692 421Q690 416 687 415T669 413H653Q647 419 647 422Q647 423 648 429T650 449T651 481Q651 552 619 605T510 659Q484 659 454 652T382 628T299 572T226 479Q194 422 175 346T156 222Q156 108 232 58Q280 24 350 24Q441 24 512 92T606 240Q610 253 612 255T628 257Q648 257 648 248Q648 243 647 239Q618 132 523 55T319 -22Q206 -22 128 53T50 252Z\"></path>\n<path stroke-width=\"1\" id=\"E20-MJMAIN-3D\" d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\"></path>\n<path stroke-width=\"1\" id=\"E20-MJMAIN-7B\" d=\"M434 -231Q434 -244 428 -250H410Q281 -250 230 -184Q225 -177 222 -172T217 -161T213 -148T211 -133T210 -111T209 -84T209 -47T209 0Q209 21 209 53Q208 142 204 153Q203 154 203 155Q189 191 153 211T82 231Q71 231 68 234T65 250T68 266T82 269Q116 269 152 289T203 34