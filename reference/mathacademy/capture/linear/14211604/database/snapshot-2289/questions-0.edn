#{[{:db/id #edb/ref 17592186054540 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054746 :knowledge-point/id #uuid "e0ab12b8-b1c9-5192-91be-cebc968d9587" :knowledge-point/title "Evaluating a Logarithm Without a Calculator Using the Change of Base Formula"}] :question/id #uuid "fc85eeb4-dbc0-5ea7-af3a-60270d6ae722" :question/math-academy-id "e-4089" :question/problem "Calculate $\\log_{16}(32)$ without using a calculator." :question/worked-solution "We use the change of base formula:\n\n$$\n\\log_a X = \\dfrac {\\log_b X} {\\log_b a}\n$$\n\nIn our case, we have $a=16$ and $X =32$. Since both $a$ and $X$ are powers of $2$, we set $b=2$. So, we have\n\n$$\n\\begin{aligned}\n\\log_{16} (32) &= (\\log_{2} (32))/(\\log_{2} (16)) \\\\\n&= (\\log_{2} (2^{5}))/(\\log_{2} (2^{4})) \\\\\n&= \\frac{5}{4}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054541 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054744 :knowledge-point/id #uuid "87ee4eae-702f-59f0-aff4-46c9acb89f6c" :knowledge-point/title "Rewriting a Logarithm Using the Change of Base Formula"}] :question/id #uuid "15844e53-9573-5e6f-8fef-debbe0a142ba" :question/math-academy-id "e-4091" :question/problem "Which of the following is equivalent to $\\log x$?\n\n1. $\\dfrac {\\log_{2} x} {\\log_{2} 10}$\n2. $\\dfrac {\\log_{2} 10} {\\log_{2} x}$\n3. $\\log_{2}\\left(\\dfrac{x}{10}\\right)$" :question/worked-solution "The change of base formula for logarithms is\n\n$$\n\\log_a X = \\dfrac {\\log_b X} {\\log_b a}\n$$\n\nWe want to change from base $a=10$ to base $b=2$. Therefore, we have\n\n$$\n\\begin{aligned}\n\\log x &= \\log_{10} x \\\\\n&= \\frac{\\log_{2} x}{\\log_{2} 10}\n\\end{aligned}\n$$\n\nSo, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186054543 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054745 :knowledge-point/id #uuid "bccd26ff-1dc5-5817-962b-a1ef1f46b2fb" :knowledge-point/title "Evaluating a Logarithm With a Calculator Using the Change of Base Formula"}] :question/id #uuid "890afebc-d130-5dbc-aaf7-c2cd4db193f6" :question/math-academy-id "e-4100" :question/problem "Use a calculator to evaluate $\\log_3 (7)$ rounded to $2$ decimal places." :question/worked-solution "Let's calculate $\\log_3 (7)$ by changing the base $3$ to the common logarithm (base $10$).\n\nWe use the change of base formula:\n\n$$\n\\log_a X = \\dfrac {\\log_b X} {\\log_b a}\n$$\n\nIn our case, we have $a=3$, $X =7$, and $b=10$. So, we have\n\n$$\n\\begin{aligned}\n\\log_{3} (7) &= (\\log_{10} (7))/(\\log_{10} (3)) \\\\\n&= (\\log (7))/(\\log (3)) \\\\\n&\\approx \\frac{0.84510}{0.47712} \\\\\n&\\approx 1.77\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186055183 :knowledge-point/_questions [{:db/id #edb/ref 17592186054746 :knowledge-point/id #uuid "e0ab12b8-b1c9-5192-91be-cebc968d9587" :knowledge-point/title "Evaluating a Logarithm Without a Calculator Using the Change of Base Formula"}] :question/answer-fields [{:answer-field/id #uuid "72fdab3a-5e80-5092-81a0-756921237d3c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186052384}] :question/id #uuid "3ba35fd5-f0a2-573b-abd8-5bda612260aa" :question/math-academy-id "q-262884" :question/problem "Expressed as a fraction in its simplest form, $\\log_{16} (64)$ equals {{field-1}}."}] [{:db/id #edb/ref 17592186055462 :knowledge-point/_questions [{:db/id #edb/ref 17592186054746 :knowledge-point/id #uuid "e0ab12b8-b1c9-5192-91be-cebc968d9587" :knowledge-point/title "Evaluating a Logarithm Without a Calculator Using the Change of Base Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96517480-c58a-580a-bd6c-7724f8c25364" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186054010} {:answer/id #uuid "d6f3604e-93c4-543c-85d4-015c8fe7e1ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186054011} {:answer/id #uuid "f2d3f4da-921c-581d-b2f2-9c94396b9176" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186054012} {:answer/id #uuid "1bd17a35-4d96-574e-94c2-099f33db7738" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186054013} {:answer/id #uuid "2d69af09-12b4-5f14-a76b-d95e41ad99a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186054014}] :answer-field/id #uuid "5c9c30ac-745b-5ac6-8f1f-5c84b0f7083a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186054009}] :question/id #uuid "d4f6e3a6-36a7-5dcc-b176-d20ea50c924d" :question/math-academy-id "q-66882" :question/problem "What is $\\log_{36} (\\sqrt[3]{6})$?"}]}
