217f0d19f0e6"] [17592186124659 :knowledge-point/questions "question-1ffbeb0a-9779-5c35-a530-341343c5a9f9"] ["question-723435c8-f6c2-5011-8005-6ac70ede7884" :question/id #uuid "723435c8-f6c2-5011-8005-6ac70ede7884"] ["question-723435c8-f6c2-5011-8005-6ac70ede7884" :question/math-academy-id "q-90983"] ["question-723435c8-f6c2-5011-8005-6ac70ede7884" :question/problem "What is the range of the function $f(x)=-5(x-1)(x-2)?$"] ["question-723435c8-f6c2-5011-8005-6ac70ede7884" :question/worked-solution "The given parabola is written in factored form,\n\n$$\ny=a(x-{x}_{1})(x-{x}_{2}),\n$$\n\nwith $a=-5<0.$ \n\nBecause the leading coefficient is negative, the parabola opens downward. Consequently, there is no minimum output, and the vertex corresponds to the maximum output.\n\nThe two roots of the parabola are ${x}_{1}=1$ and ${x}_{2}=2,$ and we can find the $x$-coordinate of the vertex by taking the average of the roots:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{1+2}{2}=\\frac{3}{2}\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{3}{2}$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & =-5(x-1)(x-2) \\\\  & =-5(\\frac{3}{2}-1)(\\frac{3}{2}-2) \\\\  & =-5\\cdot \\frac{1}{2}\\cdot (-\\frac{1}{2}) \\\\  & =\\frac{5}{4}\\end{aligned}\n$$\n\nTherefore, the vertex is $(\\frac{3}{2},\\frac{5}{4}),$ and the range of the function is $(-\\infty ,\\frac{5}{4}].$\n\n![](images/42/426a8277921ca2c8282567eeb076c3dcf1f0f1c729c4ebd2e5d624f51b78d61e.png)"] ["question-723435c8-f6c2-5011-8005-6ac70ede7884" :question/difficulty :question.difficulty/easy] ["answer-field-9e3ba704-088a-57fb-bc54-70440ac77e83" :answer-field/id #uuid "9e3ba704-088a-57fb-bc54-70440ac77e83"] ["answer-9bbe7726-805f-5ecb-9261-1dd23f6ff79a" :answer/id #uuid "9bbe7726-805f-5ecb-9261-1dd23f6ff79a"] ["answer-9bbe7726-805f-5ecb-9261-1dd23f6ff79a" :answer/type :answer.type/math] ["answer-9bbe7726-805f-5ecb-9261-1dd23f6ff79a" :answer/value "(-\\infty ,1]"] ["answer-7014d6a2-28c0-585c-9c3a-7254efaca4ea" :answer/id #uuid "7014d6a2-28c0-585c-9c3a-7254efaca4ea"] ["answer-7014d6a2-28c0-585c-9c3a-7254efaca4ea" :answer/type :answer.type/math] ["answer-7014d6a2-28c0-585c-9c3a-7254efaca4ea" :answer/value "(-\\infty ,2]"] ["answer-66edb060-6c48-5d86-bc94-ca07b3f6eff6" :answer/id #uuid "66edb060-6c48-5d86-bc94-ca07b3f6eff6"] ["answer-66edb060-6c48-5d86-bc94-ca07b3f6eff6" :answer/type :answer.type/math] ["answer-66edb060-6c48-5d86-bc94-ca07b3f6eff6" :answer/value "(-\\infty ,\\frac{5}{4}]"] ["answer-c24bd33a-9854-52b8-8040-811faade6cfe" :answer/id #uuid "c24bd33a-9854-52b8-8040-811faade6cfe"] ["answer-c24bd33a-9854-52b8-8040-811faade6cfe" :answer/type :answer.type/math] ["answer-c24bd33a-9854-52b8-8040-811faade6cfe" :answer/value "(\\frac{5}{4},\\infty )"] ["answer-332e1d80-7be9-5c06-af32-c685cf22b488" :answer/id #uuid "332e1d80-7be9-5c06-af32-c685cf22b488"] ["answer-332e1d80-7be9-5c06-af32-c685cf22b488" :answer/type :answer.type/math] ["answer-332e1d80-7be9-5c06-af32-c685cf22b488" :answer/value "[2,\\infty )"] ["answer-field-9e3ba704-088a-57fb-bc54-70440ac77e83" :answer-field/key "selection"] ["answer-field-9e3ba704-088a-57fb-bc54-70440ac77e83" :answer-field/type :answer-field.type/radio] ["answer-field-9e3ba704-088a-57fb-bc54-70440ac77e83" :answer-field/correct "answer-66edb060-6c48-5d86-bc94-ca07b3f6eff6"] ["answer-field-9e3ba704-088a-57fb-bc54-70440ac77e83" :answer-field/choices "answer-9bbe7726-805f-5ecb-9261-1dd23f6ff79a"] ["answer-field-9e3ba704-088a-57fb-bc54-70440ac77e83" :answer-field/choices "answer-7014d6a2-28c0-585c-9c3a-7254efaca4ea"] ["answer-field-9e3ba704-088a-57fb-bc54-70440ac77e83" :answer-field/choices "answer-66edb060-6c48-5d86-bc94-ca07b3f6eff6"] ["answer-field-9e3ba704-088a-57fb-bc54-70440ac77e83" :answer-field/choices "answer-c24bd33a-9854-52b8-8040-811faade6cfe"] ["answer-field-9e3ba704-088a-57fb-bc54-70440ac77e83" :answer-field/choices "answer-332e1d80-7be9-5c06-af32-c685cf22b488"] ["question-723435c8-f6c2-5011-8005-6ac70ede7884" :question/answer-fields "answer-field-9e3ba704-088a-57fb-bc54-70440ac77e83"] [17592186124660 :knowledge-point/questions "question-723435c8-f6c2-5011-8005-6ac70ede7884"] ["question-baf92e1a-9022-5719-8869-44081e0988df" :question/id #uuid "baf92e1a-9022-5719-8869-44081e0988df"] ["question-baf92e1a-9022-5719-8869-44081e0988df" :question/math-academy-id "q-250613"] ["question-baf92e1a-9022-5719-8869-44081e0988df" :question/problem "Find the range of the function $f(x)=-(x+6)^{2}-10.$\n\n{{field-1}}\n$<f(x)$\n{{field-2}}{{field-3}}"] ["question-baf92e1a-9022-5719-8869-44081e0988df" :question/worked-solution "The parabola is written in vertex form, \n\n$$\ny=a(x-h)^{2}+k,\n$$\n\nwhere $a$ is the leading coefficient and $(h,k)$ is the vertex. \n\n- Since $h=-6$ and $k=-10,$ the vertex is $(-6,-10).$\n\n- Since $a=-1<0,$ the parabola opens downwards.\n\nBecause the parabola opens downwards, there is no minimum output, and the vertex corresponds to the maximum output.\n\nTherefore, the range is $(-\\infty ,-10],$ i.e. $-\\infty <f(x)\\le -10.$\n\nThe corresponding diagram is shown below.\n\n![](images/7a/7aa50770fd1c24866ca5d5a8df1b04dc7260b4a5b346f8296757c59d33ba545b.png)"] ["question-baf92e1a-9022-5719-8869-44081e0988df" :question/difficulty :question.difficulty/easy] ["answer-field-e8c25361-0058-5188-b424-05769d00535f" :answer-field/id #uuid "e8c25361-0058-5188-b424-05769d00535f"] ["answer-82d46fe3-a01c-51f2-bb08-72a3443e001a" :answer/id #uuid "82d46fe3-a01c-51f2-bb08-72a3443e001a"] ["answer-82d46fe3-a01c-51f2-bb08-72a3443e001a" :answer/type :answer.type/math] ["answer-82d46fe3-a01c-51f2-bb08-72a3443e001a" :answer/value "-\\infty"] ["answer-field-e8c25361-0058-5188-b424-05769d00535f" :answer-field/key "field-1"] ["answer-field-e8c25361-0058-5188-b424-05769d00535f" :answer-field/type :answer-field.type/blank] ["answer-field-e8c25361-0058-5188-b424-05769d00535f" :answer-field/correct "answer-82d46fe3-a01c-51f2-bb08-72a3443e001a"] ["answer-field-e8c25361-0058