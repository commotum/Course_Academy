d #uuid "1bfffc5a-1c51-522c-989e-2b35810963b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439693} :answer-field/id #uuid "b7d597da-262e-5086-a470-22ba14674ce1" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440204} {:answer-field/choices [{:answer/id #uuid "7475000b-3919-52bf-8008-6c95380eee01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439695} {:answer/id #uuid "f3c419fa-23be-5022-afd3-dc3877e8a532" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439696}] :answer-field/correct {:answer/id #uuid "f3c419fa-23be-5022-afd3-dc3877e8a532" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439696} :answer-field/id #uuid "a8a79d45-b0d7-5b88-a614-9498abaf6c1d" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440205}] :question/id #uuid "9c5d95ad-bb5b-5734-95d6-fffbd7781121" :question/math-academy-id "q-39796" :question/problem "Calculate the vertical asymptotes of $f(x) = \\frac{2}{2 - x} + \\frac{3}{2 + x}$.\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $x=-2$\n- **II.** $x=0$\n- **III.** $x=1$\n- **IV.** $x=2$" :question/worked-solution "After cancellation, $f(x)=\\frac{x - 10}{x^{2} - 4}$. Its real denominator zeros are $\\left\\{-2, 2\\right\\}$; canceled factors produce holes, not vertical asymptotes."}] [{:db/id #edb/ref 17592186234067 :knowledge-point/_questions [{:db/id #edb/ref 17592186087844 :knowledge-point/id #uuid "b18ace11-d31c-5d5a-bd2e-32e1c28af2b9" :knowledge-point/title "Calculating Vertical Asymptotes When the Denominator Has Complex Roots"}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c29f5a25-a27e-5aa7-83e3-1b45bff33614" :question/math-academy-id "q-4698" :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{{x}^{2}-1}{8{x}^{4}+x}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x:$\n\nFactoring the numerator and denominator, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}-1}{8{x}^{4}+x} \\\\  & =\\frac{(x+1)(x-1)}{x(8{x}^{3}+1)} \\\\  & =\\frac{(x+1)(x-1)}{x[(2x)^{3}+{1}^{3}]} \\\\  & =\\frac{(x+1)(x-1)}{x(2x+1)(4{x}^{2}-2x+1)}.\\end{aligned}\n$$\n\nNotice that we used the sum of cubes formula to factor the denominator.\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero. This gives\n\n$$\nx(2x+1)(4{x}^{2}-2x+1)=0.\n$$\n\nWe now solve the above equation using the zero product property:\n\n- Solving $x=0$ gives the solution $x=0.$\n\n- Solving $2x+1=0$ gives the solution $x=-\\frac{1}{2}.$\n\n- The equation $4{x}^{2}-2x+1=0$ has no real solutions because the discriminant $D$ is negative:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(-2)^{2}-4(4)(1) \\\\  & =4-16 \\\\  & =-12\\end{aligned}\n$$\n\nTherefore, the equations of the vertical asymptotes are $x=0$ and $x=-\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186348437 :knowledge-point/_questions [{:db/id #edb/ref 17592186087845 :knowledge-point/id #uuid "4b0b57da-f9af-5fab-a337-51ee4cb28f9e" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors When the Denominator Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a23df9c-0bb4-5f06-a2ce-f50dbe498d84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439993} {:answer/id #uuid "15b3d22f-4cec-5498-90ba-670c1d780658" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439994}] :answer-field/correct {:answer/id #uuid "3a23df9c-0bb4-5f06-a2ce-f50dbe498d84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439993} :answer-field/id #uuid "2c9ab1ab-d571-5366-9440-7a3c113c7d35" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440354} {:answer-field/choices [{:answer/id #uuid "5e50e6fe-de04-5702-9faf-549a10b505fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439995} {:answer/id #uuid "fe516876-d9e1-54d1-84bc-ee6388f07ba7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439996}] :answer-field/correct {:answer/id #uuid "5e50e6fe-de04-5702-9faf-549a10b505fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439995} :answer-field/id #uuid "e1ddbc92-6bd1-5484-8f57-506f318d7cee" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440355} {:answer-field/choices [{:answer/id #uuid "370a76e0-2c04-500b-a841-77d0ae40552c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439997} {:answer/id #uuid "91966088-bf02-5175-b84e-d585c7568317" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439998}] :answer-field/correct {:answer/id #uuid "370a76e0-2c04-500b-a841-77d0ae40552c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439997} :answer-field/id #uuid "81e0421e-636c-51a4-83fb-f74c8f1eae44" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440356}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d7fbfa1c-696c-569c-8a32-b9f903615eb9" :question/math-academy-id "q-80696" :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{4x}{x({x}^{2}+1)}.$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $x=-1$\n- **II.** $x=0$\n- **III.** $x=1$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{4x}{x({x}^{2}+1)} \\\\  & =\\frac{4\\cancel{x}}{\\cancel{x}({x}^{2}+1)} \\\\  & =\\frac{4}{{x}^{2}+1}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}+1=0\n$$\n\nThis equation does not have any real solutions. Therefore, $f(x)$ has no vertical asymptotes."}]}
