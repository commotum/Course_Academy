[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186133903 :knowledge-point/questions ["question-81171e25-e5ad-5118-af05-1058347bd84c" "question-ac0004d1-e33b-579f-a242-badcc09a2477"] :db/ensure [:knowledge-point/validate]} {:db/id "question-81171e25-e5ad-5118-af05-1058347bd84c" :question/id #uuid "81171e25-e5ad-5118-af05-1058347bd84c" :question/math-academy-id "q-41477" :question/problem "![](images/29/296883eddf8dc4521e4fa1313e1f3176c965a376d55ecb9189fa913adc8d2625.png)\n\nPart of the graph of a function $y=f(x)$ with period $4$ is shown above. What is the graph of $y=f(x)$ on the interval $-6\\le x\\le 6?$" :question/worked-solution "The graph above shows the function in the interval $-2\\le x\\le 2.$\n\nSince this interval has length $4,$ and the period of the function is also $4,$ this interval represents a single period of the function.\n\nTherefore, the function will consist of many copies of the shape shown above, shifted horizontally by multiples of $4.$\n\n![](images/13/13eb143d92cd215f9283a44ad67ca91e679610d4b6625ae53ced56295430e843.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bbb74983-a5fb-5b54-80ff-62e42e368833"] :db/ensure [:question/validate]} {:db/id "answer-field-bbb74983-a5fb-5b54-80ff-62e42e368833" :answer-field/id #uuid "bbb74983-a5fb-5b54-80ff-62e42e368833" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c7264fca-3bea-51fc-9e5c-4c009f2fe062" :answer-field/choices ["answer-c7264fca-3bea-51fc-9e5c-4c009f2fe062" "answer-c9f360fa-fc4a-5b06-96ff-4de49594a49d" "answer-146ab018-a035-5b73-95a8-05742d6e5827" "answer-0638622e-b7c3-5da8-a7c5-6cb908cc9ef1" "answer-c5acf350-4f70-57a8-9daa-0cd77ef25e15"] :db/ensure [:answer-field/validate]} {:db/id "answer-c7264fca-3bea-51fc-9e5c-4c009f2fe062" :answer/id #uuid "c7264fca-3bea-51fc-9e5c-4c009f2fe062" :answer/type :answer.type/image :answer/value "images/13/13eb143d92cd215f9283a44ad67ca91e679610d4b6625ae53c