61-85a1-b560c27ee73a"] ["answer-field-30422fd3-ff16-5306-8121-7da0fb9949b6" :answer-field/choices "answer-fab5c2d9-45ff-559e-b899-e258547ba0d0"] ["answer-field-30422fd3-ff16-5306-8121-7da0fb9949b6" :answer-field/choices "answer-dce3d9c0-369f-5fab-9976-aa0c48eecee1"] [17592186234131 :question/answer-fields "answer-field-30422fd3-ff16-5306-8121-7da0fb9949b6"] ["question-578558b7-752b-50a1-8021-c4183d8058d1" :question/id #uuid "578558b7-752b-50a1-8021-c4183d8058d1"] ["question-578558b7-752b-50a1-8021-c4183d8058d1" :question/math-academy-id "q-82379"] ["question-578558b7-752b-50a1-8021-c4183d8058d1" :question/problem "![](images/51/51ed86e455d0716953ad3d083646483d023ff7db6d8f45a9f27e4324d00b21db.png)\n\nThe graph of $y=f(x)$ is shown above. Given that $y=f(x)$ is periodic with period $4,$ what is the value of $f(-46)?$"] ["question-578558b7-752b-50a1-8021-c4183d8058d1" :question/worked-solution "Since the period is $4,$ if we add (or subtract) any multiple of $4$ from the input, the output stays the same.\n\nSo, we can keep adding $4$ to the input until we get to an input that we see in the graph:\n\n$$\n\\begin{aligned}f(-46) & =f(-46+4) \\\\  & =f(-46+2\\cdot 4) \\\\  & =⋯ \\\\  & =f(-46+11\\cdot 4) \\\\  & =f(-2) \\\\  & =1\\end{aligned}\n$$"] ["question-578558b7-752b-50a1-8021-c4183d8058d1" :question/difficulty :question.difficulty/hard] ["answer-field-d5b4eab5-1a97-503e-8f9c-d8f2be8e4c90" :answer-field/id #uuid "d5b4eab5-1a97-503e-8f9c-d8f2be8e4c90"] ["answer-2a865695-6d64-5c60-94d7-9598fdb6c8f9" :answer/id #uuid "2a865695-6d64-5c60-94d7-9598fdb6c8f9"] ["answer-2a865695-6d64-5c60-94d7-9598fdb6c8f9" :answer/type :answer.type/math] ["answer-2a865695-6d64-5c60-94d7-9598fdb6c8f9" :answer/value "-1"] ["answer-b2b705bd-6870-5d3b-84f9-133f603afda9" :answer/id #uuid "b2b705bd-6870-5d3b-84f9-133f603afda9"] ["answer-b2b705bd-6870-5d3b-84f9-133f603afda9" :answer/type :answer.type/math] ["answer-b2b705bd-6870-5d3b-84f9-133f603afda9" :answer/value "-2"] ["answer-4d445e86-f6dc-5