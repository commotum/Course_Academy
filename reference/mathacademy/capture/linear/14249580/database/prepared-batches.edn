dcc09a2477" :question/math-academy-id "q-165275"] ["question-ac0004d1-e33b-579f-a242-badcc09a2477" :question/problem "![](images/79/79fbfbbc0ba9421d770699e663d572da21fa40b87d7d361e56797cd666e05df6.png)\n\nPart of the graph of a function $y=f(x)$ with period $3$ is shown above. What is the graph of $y=f(x)$ on the interval $-4\\le x\\le 5?$"] ["question-ac0004d1-e33b-579f-a242-badcc09a2477" :question/worked-solution "The graph above shows the function in the interval $-1\\le x\\le 2.$\n\nSince this interval has length $3,$ and the period of the function is also $3,$ this interval represents a single period of the function.\n\nTherefore, the function will consist of many copies of the shape shown above, shifted horizontally by multiples of $3.$\n\n![](images/71/71356315a5669dbd5d3a794a046e0c647f674905f89099f8c74d521f10b7498c.png)"] ["question-ac0004d1-e33b-579f-a242-badcc09a2477" :question/difficulty :question.difficulty/easy] ["answer-field-b380c2e7-189c-577f-a4bc-c298b9d70668" :answer-field/id #uuid "b380c2e7-189c-577f-a4bc-c298b9d70668"] ["answer-fb931fc8-bdbe-59ce-a0da-f3e4109eaca2" :answer/id #uuid "fb931fc8-bdbe-59ce-a0da-f3e4109eaca2"] ["answer-fb931fc8-bdbe-59ce-a0da-f3e4109eaca2" :answer/type :answer.type/image] ["answer-fb931fc8-bdbe-59ce-a0da-f3e4109eaca2" :answer/value "images/47/478352fdfd94d21f884fb825e49795912389a1ad227bd4588346827175dd9428.png"] ["answer-4ab6011d-ba6e-542d-bd33-45bcd6fc3cda" :answer/id #uuid "4ab6011d-ba6e-542d-bd33-45bcd6fc3cda"] ["answer-4ab6011d-ba6e-542d-bd33-45bcd6fc3cda" :answer/type :answer.type/image] ["answer-4ab6011d-ba6e-542d-bd33-45bcd6fc3cda" :answer/value "images/54/544e1affb493aa63f91aee8b169cf0c53628a1c4d9c2343664eae653750f772a.png"] ["answer-7e0fa81d-741a-58b6-bcd2-d458fb5d3c04" :answer/id #uuid "7e0fa81d-741a-58b6-bcd2-d458fb5d3c04"] ["answer-7e0fa81d-741a-58b6-bcd2-d458fb5d3c04" :answer/type :answer.type/image] ["answer-7e0fa81d-741a-58b6-bcd2-d458fb5d3c04" :answer/value "images/64/64c77b8c6b074bf12ccf19e33c2cf46d487