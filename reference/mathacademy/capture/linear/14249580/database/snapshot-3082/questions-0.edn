#{[{:db/id #edb/ref 17592186570017 :knowledge-point/_questions [{:db/id #edb/ref 17592186133903 :knowledge-point/id #uuid "57b95b5b-8834-5d1a-8380-fd8889e05cb4" :knowledge-point/title "Drawing the Graph of a Periodic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c3f23c6-2efe-5208-9c9f-0c9bae353a6b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b8/b8fe800f825c931843fd7777d8c3953acb465099b4b5aff7b6ff82813081d21d.png" :db/id #edb/ref 17592186569464} {:answer/id #uuid "4344818a-a04e-54e5-b442-c2ab900ea89f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/71/71356315a5669dbd5d3a794a046e0c647f674905f89099f8c74d521f10b7498c.png" :db/id #edb/ref 17592186569536} {:answer/id #uuid "4ab6011d-ba6e-542d-bd33-45bcd6fc3cda" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/54/544e1affb493aa63f91aee8b169cf0c53628a1c4d9c2343664eae653750f772a.png" :db/id #edb/ref 17592186569545} {:answer/id #uuid "7e0fa81d-741a-58b6-bcd2-d458fb5d3c04" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/64/64c77b8c6b074bf12ccf19e33c2cf46d487bbb7c813afb0c7348c5f340542e88.png" :db/id #edb/ref 17592186569652} {:answer/id #uuid "fb931fc8-bdbe-59ce-a0da-f3e4109eaca2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/47/478352fdfd94d21f884fb825e49795912389a1ad227bd4588346827175dd9428.png" :db/id #edb/ref 17592186569840}] :answer-field/correct {:answer/id #uuid "4344818a-a04e-54e5-b442-c2ab900ea89f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/71/71356315a5669dbd5d3a794a046e0c647f674905f89099f8c74d521f10b7498c.png" :db/id #edb/ref 17592186569536} :answer-field/id #uuid "b380c2e7-189c-577f-a4bc-c298b9d70668" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569915}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ac0004d1-e33b-579f-a242-badcc09a2477" :question/math-academy-id "q-165275" :question/problem "![](images/79/79fbfbbc0ba9421d770699e663d572da21fa40b87d7d361e56797cd666e05df6.png)\n\nPart of the graph of a function $y=f(x)$ with period $3$ is shown above. What is the graph of $y=f(x)$ on the interval $-4\\le x\\le 5?$" :question/worked-solution "The graph above shows the function in the interval $-1\\le x\\le 2.$\n\nSince this interval has length $3,$ and the period of the function is also $3,$ this interval represents a single period of the function.\n\nTherefore, the function will consist of many copies of the shape shown above, shifted horizontally by multiples of $3.$\n\n![](images/71/71356315a5669dbd5d3a794a046e0c647f674905f89099f8c74d521f10b7498c.png)"}] [{:db/id #edb/ref 17592186570005 :knowledge-point/_questions [{:db/id #edb/ref 17592186133903 :knowledge-point/id #uuid "57b95b5b-8834-5d1a-8380-fd8889e05cb4" :knowledge-point/title "Drawing the Graph of a Periodic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0638622e-b7c3-5da8-a7c5-6cb908cc9ef1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/59/5906532556b783839491ae68b5b198adb7269e265b555fdbbc2705133c1ae34f.png" :db/id #edb/ref 17592186569455} {:answer/id #uuid "146ab018-a035-5b73-95a8-05742d6e5827" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/40/40e6d09505869a58f24671706f86c47089b9d8063f9cecaf8c4c24c4e6c939d3.png" :db/id #edb/ref 17592186569475} {:answer/id #uuid "c5acf350-4f70-57a8-9daa-0cd77ef25e15" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8b/8b83be39e7248fb2ca87990848f1a9fec6a089b9e55e28968ff3a4e6c5702a52.png" :db/id #edb/ref 17592186569756} {:answer/id #uuid "c7264fca-3bea-51fc-9e5c-4c009f2fe062" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/13/13eb143d92cd215f9283a44ad67ca91e679610d4b6625ae53ced56295430e843.png" :db/id #edb/ref 17592186569760} {:answer/id #uuid "c9f360fa-fc4a-5b06-96ff-4de49594a49d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/19/192c95fa84b2a10e8131417d8aa8f27cfec426e304a8a5e5424eebf8b77f61cb.png" :db/id #edb/ref 17592186569765}] :answer-field/correct {:answer/id #uuid "c7264fca-3bea-51fc-9e5c-4c009f2fe062" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/13/13eb143d92cd215f9283a44ad67ca91e679610d4b6625ae53ced56295430e843.png" :db/id #edb/ref 17592186569760} :answer-field/id #uuid "bbb74983-a5fb-5b54-80ff-62e42e368833" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569916}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "81171e25-e5ad-5118-af05-1058347bd84c" :question/math-academy-id "q-41477" :question/problem "![](images/29/296883eddf8dc4521e4fa1313e1f3176c965a376d55ecb9189fa913adc8d2625.png)\n\nPart of the graph of a function $y=f(x)$ with period $4$ is shown above. What is the graph of $y=f(x)$ on the interval $-6\\le x\\le 6?$" :question/worked-solution "The graph above shows the function in the interval $-2\\le x\\le 2.$\n\nSince this interval has length $4,$ and the period of the function is also $4,$ this interval represents a single period of the function.\n\nTherefore, the function will consist of many copies of the shape shown above, shifted horizontally by multiples of $4.$\n\n![](images/13/13eb143d92cd215f9283a44ad67ca91e679610d4b6625ae53ced56295430e843.png)"}] [{:db/id #edb/ref 17592186234038 :knowledge-point/_questions [{:db/id #edb/ref 17592186133904 :knowledge-point/id #uuid "282b873c-1ba0-5205-b75f-c58721ffaaff" :knowledge-point/title "Inferring Values of a Periodic Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23ec354d-8e8c-5b62-89a4-d9067bf653c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186569493} {:answer/id #uuid "41841af2-39df-5432-8e2b-4b7ce3eb1b15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186569531} {:answer/id #uuid "6376a0aa-c3b6-5949-94d5-f299f887d586" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186569598} {:answer/id #uuid "762b93f8-720a-5d55-af9a-08e2a280fde2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186569641} {:answer/id #uuid "9832a9f5-bd09-5ffd-bdae-f193f6e6442d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186569685}] :answer-field/correct {:answer/id #uuid "6376a0aa-c3b6-5949-94d5-f299f887d586" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186569598} :answer-field/id #uuid "adf54b9a-9293-5953-b0be-2649d801c3d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569913}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a341a11-ce8b-58fe-beef-6c590edc7b20" :question/math-academy-id "q-41478" :question/problem "![](images/34/34ba4a4dcd6655d68fbc20fb6192354ae755cc7eaf14a2459e9b7012ffe6d9ea.png)\n\nThe graph of $y=f(x)$ is shown above. Given that $y=f(x)$ is periodic with period $4,$ what is the value of $f(62)?$" :question/worked-solution "Since the period is $4,$ if we add (or subtract) any multiple of $4$ from the input, the output stays the same.\n\nSo, we can keep subtracting $4$ from the input until we get to an input that we see in the graph:\n\n$$\n\\begin{aligned}f(62) & =f(62-4) \\\\  & =f(62-2\\cdot 4) \\\\  & =⋯ \\\\  & =f(62-15\\cdot 4) \\\\  & =f(2) \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234131 :knowledge-point/_questions [{:db/id #edb/ref 17592186133902 :knowledge-point/id #uuid "9ebe5738-7682-55ad-a21b-235063f08b88" :knowledge-point/title "Identifying the Period of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ad6d91d-e76b-59dc-a347-415848979029" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186569505} {:answer/id #uuid "bcfde82f-f36c-5b8a-8328-5aa72fb07d43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186569745} {:answer/id #uuid "d280908f-9e1e-5861-85a1-b560c27ee73a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186569774} {:answer/id #uuid "dce3d9c0-369f-5fab-9976-aa0c48eecee1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.5" :db/id #edb/ref 17592186569794} {:answer/id #uuid "fab5c2d9-45ff-559e-b899-e258547ba0d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186569835}] :answer-field/correct {:answer/id #uuid "fab5c2d9-45ff-559e-b899-e258547ba0d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186569835} :answer-field/id #uuid "30422fd3-ff16-5306-8121-7da0fb9949b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569863}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "44e22570-10cc-598d-a717-a67ff911634b" :question/math-academy-id "q-51567" :question/problem "![](images/45/4585ab21f7130a45e2ff5871e0fdc66cda5483181033010519781d9725eec36a.png)\n\nThe graph of a periodic function $y=f(x)$ is shown above. What is the period of this function?" :question/worked-solution "Note that if we shift the graph $3$ units left or right, the graph remains unchanged.\n\nOn the other hand, if we shift the graph horizontally by any distance other than $3$ (or a multiple of $3$), we get a different graph.\n\nTherefore, the period of the function is $3.$"}] [{:db/id #edb/ref 17592186569991 :knowledge-point/_questions [{:db/id #edb/ref 17592186133904 :knowledge-point/id #uuid "282b873c-1ba0-5205-b75f-c58721ffaaff" :knowledge-point/title "Inferring Values of a Periodic Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a865695-6d64-5c60-94d7-9598fdb6c8f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186569503} {:answer/id #uuid "4d445e86-f6dc-50fb-a899-152c417f9ddf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186569549} {:answer/id #uuid "b2b705bd-6870-5d3b-84f9-133f603afda9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186569727} {:answer/id #uuid "c5136637-fcfa-5dcd-b242-2b5729bb2d68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186569754} {:answer/id #uuid "d58a163b-940a-53f9-9d9d-417b99759dae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186569777}] :answer-field/correct {:answer/id #uuid "d58a163b-940a-53f9-9d9d-417b99759dae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186569777} :answer-field/id #uuid "d5b4eab5-1a97-503e-8f9c-d8f2be8e4c90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569931}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "578558b7-752b-50a1-8021-c4183d8058d1" :question/math-academy-id "q-82379" :question/problem "![](images/51/51ed86e455d0716953ad3d083646483d023ff7db6d8f45a9f27e4324d00b21db.png)\n\nThe graph of $y=f(x)$ is shown above. Given that $y=f(x)$ is periodic with period $4,$ what is the value of $f(-46)?$" :question/worked-solution "Since the period is $4,$ if we add (or subtract) any multiple of $4$ from the input, the output stays the same.\n\nSo, we can keep adding $4$ to the input until we get to an input that we see in the graph:\n\n$$\n\\begin{aligned}f(-46) & =f(-46+4) \\\\  & =f(-46+2\\cdot 4) \\\\  & =⋯ \\\\  & =f(-46+11\\cdot 4) \\\\  & =f(-2) \\\\  & =1\\end{aligned}\n$$"}]}
