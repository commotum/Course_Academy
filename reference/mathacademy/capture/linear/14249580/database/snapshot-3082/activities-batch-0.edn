#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186134881} :activity/id #uuid "1129f5af-8b20-5759-9f3e-97b087634b1b" :activity/scope {:db/id #edb/ref 17592186049353 :topic/id #uuid "ee26b28d-c213-5819-bf4f-97826f641d1d" :topic/math-academy-id 2148} :activity/steps [{:db/id #edb/ref 17592186134881 :step/content {:db/id #edb/ref 17592186135013 :tutorial/content "**Periodic functions** are special functions that repeat themselves every ![](images/b3/b332ba26d1b8a3e4b8f817ed7eed0f807c5cc8457a0f29182ba04d25cbcb41b7.svg) units. The smallest positive value of ![](images/b3/b332ba26d1b8a3e4b8f817ed7eed0f807c5cc8457a0f29182ba04d25cbcb41b7.svg) that has this property is called the **period** of the function. \n\nLet's take the following periodic function as an example:\n\n![](images/c8/c8012ef5d26d04c81a6200bffb85babe8787c49258f5c014e6ac42ccbbbbf3cb.png)\n\nThis function repeats itself with a period of ![](images/27/270d33581e0657a10d567c6cfaa529521b34e20a39c9a29550698cbf252fabfa.svg) To illustrate, first focus on the part of the graph shown in blue below.\n\n![](images/c3/c309cafb184c76a6630f4357e07267ad832e85dd982fffce3abd28bf1526ec95.png)\n\nIf we shift this part ![](images/f5/f5f3224583db57b9cfe323c8489ef5e5271000002b5ea253eb98fd067a858b2d.svg) units to the right, the graph remains unchanged!\n\n![](images/a8/a82b5b1fd4da072d954d19bae0a790e82704343ec8b9d4448076f9daebe90617.png)\n\nThe same would happen if we shifted the part ![](images/f5/f5f3224583db57b9cfe323c8489ef5e5271000002b5ea253eb98fd067a858b2d.svg) units to the left. \n\nBy knowing the period of a periodic function, we can use a value of the function to infer many other values of the function. For example, in the function above, note that ![](images/4b/4ba0fb2ba36b90b8993c542124873b19eb240bed743d3c7bce2712f043187c4e.svg) Since the period is ![](images/0b/0be337b1b7891cff68331fbd1be3c8eb739eb8f47e7788e487ab91a8b2c88b67.svg) if we add (or subtract) any multiple of ![](images/f5/f5f3224583db57b9cfe323c8489ef5e5271000002b5ea253eb98fd067a858b2d.svg) from the input, the output stays the same. We can write this as\n\n![](images/b3/b3d30eb46010a29136217b3d004e0878a8923a94e77a52192172638697b6c67a.svg)\n\nwhere ![](images/fb/fb2a8560bbc7122a4dd4f1a0bb9862d4368a63f4b03968884a3a60e7423a852c.svg) is an integer. \n\nFor example, setting ![](images/a4/a44568f6fc5aa5bd466f76f6220d308431c1187631cf36f8bebf2290ef7a0d83.svg) gives the following:\n\n![](images/1e/1e73284bd11385d40e11887964fa4ad1a7f523982c885c5fca7f87197ea1c954.svg)\n\nThe same is true for negative values of ![](images/c2/c2475d72e6ec36042292de6c0160930174172b2386148d823a70e59fddfb93c2.svg) Setting ![](images/55/55af3f37f9d82f0e1d9e6a77096eba247f13ea48ea005c2fd0b8719f1d6c04c1.svg) gives the following:\n\n![](images/7d/7df85879c234dbc914f4f4ee9261f4e12f0a57b03ae7ab433ddd0c8c4ba14d7f.svg)" :tutorial/id #uuid "b8020c2e-cfe4-5187-94df-23d7d0fcb605" :tutorial/math-academy-id 1502 :tutorial/title "Introduction"} :step/id #uuid "fa1d756d-c380-5339-a443-11ba085cc909" :step/math-academy-id 3664 :step/next {:db/id #edb/ref 17592186134882}} {:db/id #edb/ref 17592186134882 :step/content {:db/id #edb/ref 17592186133902 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133469 :question/id #uuid "9a8dfc78-929c-525b-9403-7c1d11d8713f" :question/math-academy-id "e-1124"} :knowledge-point/id #uuid "9ebe5738-7682-55ad-a21b-235063f08b88" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049534}] :knowledge-point/questions [{:db/id #edb/ref 17592186134344} {:db/id #edb/ref 17592186134345} {:db/id #edb/ref 17592186234131} {:db/id #edb/ref 17592186552431} {:db/id #edb/ref 17592186552518}] :knowledge-point/title "Identifying the Period of a Function Given Its Graph"} :step/id #uuid "5c25e487-4990-59fc-bfc4-1a9c9ad30723" :step/math-academy-id 3665 :step/next {:db/id #edb/ref 17592186134883}} {:db/id #edb/ref 17592186134883 :step/content {:db/id #edb/ref 17592186133903 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133470 :question/id #uuid "1529ba15-ecf2-5c3f-871d-ab249ef9af34" :question/math-academy-id "e-1125"} :knowledge-point/id #uuid "57b95b5b-8834-5d1a-8380-fd8889e05cb4" :knowledge-point/questions [{:db/id #edb/ref 17592186134353} {:db/id #edb/ref 17592186134490} {:db/id #edb/ref 17592186552451} {:db/id #edb/ref 17592186552516} {:db/id #edb/ref 17592186570005} {:db/id #edb/ref 17592186570017}] :knowledge-point/title "Drawing the Graph of a Periodic Function"} :step/id #uuid "e726ab95-f076-53ce-a8d3-da7938f96dec" :step/math-academy-id 3668 :step/next {:db/id #edb/ref 17592186134884}} {:db/id #edb/ref 17592186134884 :step/content {:db/id #edb/ref 17592186133904 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133471 :question/id #uuid "6f991ce1-e19a-5324-830a-a17f7ac22848" :question/math-academy-id "e-1126"} :knowledge-point/id #uuid "282b873c-1ba0-5205-b75f-c58721ffaaff" :knowledge-point/questions [{:db/id #edb/ref 17592186134357} {:db/id #edb/ref 17592186134491} {:db/id #edb/ref 17592186234038} {:db/id #edb/ref 17592186552473} {:db/id #edb/ref 17592186552498} {:db/id #edb/ref 17592186552507} {:db/id #edb/ref 17592186569991}] :knowledge-point/title "Inferring Values of a Periodic Function Given Its Graph"} :step/id #uuid "19fd2e5e-dcb6-5935-bb5a-e6645996a5d3" :step/math-academy-id 3671}] :activity/title "Periodic Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186134017}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186570051} :activity/id #uuid "f79b8e64-8b3b-57e3-8811-b62cd095454f" :activity/scope {:db/id #edb/ref 17592186049353 :topic/id #uuid "ee26b28d-c213-5819-bf4f-97826f641d1d" :topic/math-academy-id 2148} :activity/steps [{:db/id #edb/ref 17592186570050 :step/content {:db/id #edb/ref 17592186234038 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23ec354d-8e8c-5b62-89a4-d9067bf653c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186569493} {:answer/id #uuid "41841af2-39df-5432-8e2b-4b7ce3eb1b15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186569531} {:answer/id #uuid "6376a0aa-c3b6-5949-94d5-f299f887d586" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186569598} {:answer/id #uuid "762b93f8-720a-5d55-af9a-08e2a280fde2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186569641} {:answer/id #uuid "9832a9f5-bd09-5ffd-bdae-f193f6e6442d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186569685}] :answer-field/correct {:db/id #edb/ref 17592186569598} :answer-field/id #uuid "adf54b9a-9293-5953-b0be-2649d801c3d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186569913}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1a341a11-ce8b-58fe-beef-6c590edc7b20" :question/math-academy-id "q-41478" :question/problem "![](images/34/34ba4a4dcd6655d68fbc20fb6192354ae755cc7eaf14a2459e9b7012ffe6d9ea.png)\n\nThe graph of $y=f(x)$ is shown above. Given that $y=f(x)$ is periodic with period $4,$ what is the value of $f(62)?$" :question/worked-solution "Since the period is $4,$ if we add (or subtract) any multiple of $4$ from the input, the output stays the same.\n\nSo, we can keep subtracting $4$ from the input until we get to an input that we see in the graph:\n\n$$\n\\begin{aligned}f(62) & =f(62-4) \\\\  & =f(62-2\\cdot 4) \\\\  & =⋯ \\\\  & =f(62-15\\cdot 4) \\\\  & =f(2) \\\\  & =0\\end{aligned}\n$$"} :step/id #uuid "2ef5b5f9-fd4f-527a-8672-0d1fd4f4c389" :step/next {:db/id #edb/ref 17592186570082}} {:db/id #edb/ref 17592186570051 :step/content {:db/id #edb/ref 17592186570005 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0638622e-b7c3-5da8-a7c5-6cb908cc9ef1" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/59/5906532556b783839491ae68b5b198adb7269e265b555fdbbc2705133c1ae34f.png" :db/id #edb/ref 17592186569455} {:answer/id #uuid "146ab018-a035-5b73-95a8-05742d6e5827" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/40/40e6d09505869a58f24671706f86c47089b9d8063f9cecaf8c4c24c4e6c939d3.png" :db/id #edb/ref 17592186569475} {:answer/id #uuid "c5acf350-4f70-57a8-9daa-0cd77ef25e15" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/8b/8b83be39e7248fb2ca87990848f1a9fec6a089b9e55e28968ff3a4e6c5702a52.png" :db/id #edb/ref 17592186569756} {:answer/id #uuid "c7264fca-3bea-51fc-9e5c-4c009f2fe062" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/13/13eb143d92cd215f9283a44ad67ca91e679610d4b6625ae53ced56295430e843.png" :db/id #edb/ref 17592186569760} {:answer/id #uuid "c9f360fa-fc4a-5b06-96ff-4de49594a49d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/19/192c95fa84b2a10e8131417d8aa8f27cfec426e304a8a5e5424eebf8b77f61cb.png" :db/id #edb/ref 17592186569765}] :answer-field/correct {:db/id #edb/ref 17592186569760} :answer-field/id #uuid "bbb74983-a5fb-5b54-80ff-62e42e368833" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186569916}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "81171e25-e5ad-5118-af05-1058347bd84c" :question/math-academy-id "q-41477" :question/problem "![](images/29/296883eddf8dc4521e4fa1313e1f3176c965a376d55ecb9189fa913adc8d2625.png)\n\nPart of the graph of a function $y=f(x)$ with period $4$ is shown above. What is the graph of $y=f(x)$ on the interval $-6\\le x\\le 6?$" :question/worked-solution "The graph above shows the function in the interval $-2\\le x\\le 2.$\n\nSince this interval has length $4,$ and the period of the function is also $4,$ this interval represents a single period of the function.\n\nTherefore, the function will consist of many copies of the shape shown above, shifted horizontally by multiples of $4.$\n\n![](images/13/13eb143d92cd215f9283a44ad67ca91e679610d4b6625ae53ced56295430e843.png)"} :step/id #uuid "33139617-fd72-5761-bd08-a02d6f83f92f" :step/next {:db/id #edb/ref 17592186570050}} {:db/id #edb/ref 17592186570053 :step/content {:db/id #edb/ref 17592186569991 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a865695-6d64-5c60-94d7-9598fdb6c8f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186569503} {:answer/id #uuid "4d445e86-f6dc-50fb-a899-152c417f9ddf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186569549} {:answer/id #uuid "b2b705bd-6870-5d3b-84f9-133f603afda9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186569727} {:answer/id #uuid "c5136637-fcfa-5dcd-b242-2b5729bb2d68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186569754} {:answer/id #uuid "d58a163b-940a-53f9-9d9d-417b99759dae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186569777}] :answer-field/correct {:db/id #edb/ref 17592186569777} :answer-field/id #uuid "d5b4eab5-1a97-503e-8f9c-d8f2be8e4c90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186569931}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "578558b7-752b-50a1-8021-c4183d8058d1" :question/math-academy-id "q-82379" :question/problem "![](images/51/51ed86e455d0716953ad3d083646483d023ff7db6d8f45a9f27e4324d00b21db.png)\n\nThe graph of $y=f(x)$ is shown above. Given that $y=f(x)$ is periodic with period $4,$ what is the value of $f(-46)?$" :question/worked-solution "Since the period is $4,$ if we add (or subtract) any multiple of $4$ from the input, the output stays the same.\n\nSo, we can keep adding $4$ to the input until we get to an input that we see in the graph:\n\n$$\n\\begin{aligned}f(-46) & =f(-46+4) \\\\  & =f(-46+2\\cdot 4) \\\\  & =⋯ \\\\  & =f(-46+11\\cdot 4) \\\\  & =f(-2) \\\\  & =1\\end{aligned}\n$$"} :step/id #uuid "40a96396-80a6-5aed-88d6-32996f4ae12b" :step/next {:db/id #edb/ref 17592186570098}} {:db/id #edb/ref 17592186570082 :step/content {:db/id #edb/ref 17592186234131 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ad6d91d-e76b-59dc-a347-415848979029" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.5" :db/id #edb/ref 17592186569505} {:answer/id #uuid "bcfde82f-f36c-5b8a-8328-5aa72fb07d43" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186569745} {:answer/id #uuid "d280908f-9e1e-5861-85a1-b560c27ee73a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186569774} {:answer/id #uuid "dce3d9c0-369f-5fab-9976-aa0c48eecee1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4.5" :db/id #edb/ref 17592186569794} {:answer/id #uuid "fab5c2d9-45ff-559e-b899-e258547ba0d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186569835}] :answer-field/correct {:db/id #edb/ref 17592186569835} :answer-field/id #uuid "30422fd3-ff16-5306-8121-7da0fb9949b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186569863}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "44e22570-10cc-598d-a717-a67ff911634b" :question/math-academy-id "q-51567" :question/problem "![](images/45/4585ab21f7130a45e2ff5871e0fdc66cda5483181033010519781d9725eec36a.png)\n\nThe graph of a periodic function $y=f(x)$ is shown above. What is the period of this function?" :question/worked-solution "Note that if we shift the graph $3$ units left or right, the graph remains unchanged.\n\nOn the other hand, if we shift the graph horizontally by any distance other than $3$ (or a multiple of $3$), we get a different graph.\n\nTherefore, the period of the function is $3.$"} :step/id #uuid "b7d1b9d2-8d6a-585c-ae7c-8123b1be4a0c" :step/next {:db/id #edb/ref 17592186570053}} {:db/id #edb/ref 17592186570098 :step/content {:db/id #edb/ref 17592186570017 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c3f23c6-2efe-5208-9c9f-0c9bae353a6b" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b8/b8fe800f825c931843fd7777d8c3953acb465099b4b5aff7b6ff82813081d21d.png" :db/id #edb/ref 17592186569464} {:answer/id #uuid "4344818a-a04e-54e5-b442-c2ab900ea89f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/71/71356315a5669dbd5d3a794a046e0c647f674905f89099f8c74d521f10b7498c.png" :db/id #edb/ref 17592186569536} {:answer/id #uuid "4ab6011d-ba6e-542d-bd33-45bcd6fc3cda" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/54/544e1affb493aa63f91aee8b169cf0c53628a1c4d9c2343664eae653750f772a.png" :db/id #edb/ref 17592186569545} {:answer/id #uuid "7e0fa81d-741a-58b6-bcd2-d458fb5d3c04" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/64/64c77b8c6b074bf12ccf19e33c2cf46d487bbb7c813afb0c7348c5f340542e88.png" :db/id #edb/ref 17592186569652} {:answer/id #uuid "fb931fc8-bdbe-59ce-a0da-f3e4109eaca2" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/47/478352fdfd94d21f884fb825e49795912389a1ad227bd4588346827175dd9428.png" :db/id #edb/ref 17592186569840}] :answer-field/correct {:db/id #edb/ref 17592186569536} :answer-field/id #uuid "b380c2e7-189c-577f-a4bc-c298b9d70668" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186569915}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ac0004d1-e33b-579f-a242-badcc09a2477" :question/math-academy-id "q-165275" :question/problem "![](images/79/79fbfbbc0ba9421d770699e663d572da21fa40b87d7d361e56797cd666e05df6.png)\n\nPart of the graph of a function $y=f(x)$ with period $3$ is shown above. What is the graph of $y=f(x)$ on the interval $-4\\le x\\le 5?$" :question/worked-solution "The graph above shows the function in the interval $-1\\le x\\le 2.$\n\nSince this interval has length $3,$ and the period of the function is also $3,$ this interval represents a single period of the function.\n\nTherefore, the function will consist of many copies of the shape shown above, shifted horizontally by multiples of $3.$\n\n![](images/71/71356315a5669dbd5d3a794a046e0c647f674905f89099f8c74d521f10b7498c.png)"} :step/id #uuid "f54f9dd9-6af8-5e82-a8c9-c98b06f1de85"}] :activity/title "Periodic Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186569445}]}
