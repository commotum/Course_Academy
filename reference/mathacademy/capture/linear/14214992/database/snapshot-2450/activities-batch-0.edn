#{[{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186106948} :activity/id #uuid "c87e90cc-8b38-5857-ab16-91e27d4abf5b" :activity/scope {:db/id #edb/ref 17592186049504 :topic/id #uuid "fa26fae5-4dd8-54f6-8b10-f83839bbfcdb" :topic/math-academy-id 1346} :activity/steps [{:db/id #edb/ref 17592186106948 :step/content {:db/id #edb/ref 17592186107164 :tutorial/content "To find the $n$th term of an arithmetic sequence given two arbitrary terms, we must usually apply the following:\n\n- The formula for the $n$th term of an arithmetic sequence is given by\n\n$$\na_n = a_1 + (n-1)d\n$$\n\nwhere $a_n$ is the $n$th term, $a_1$ is the first term, and $d$ is the common difference.\n\n- We can find the common difference $d$ of an arithmetic sequence given two arbitrary terms using\n\n$$\nd = \\frac{a_m-a_k}{m-k}\n$$\n\nwhere $a_m$ is the $m$th term, and $a_k$ is the $k$th term.\n\nLet's see some examples." :tutorial/id #uuid "d021f3a1-b263-5fc0-a08d-cdec57045fb1" :tutorial/math-academy-id 8084 :tutorial/title "Introduction"} :step/id #uuid "a29b3302-3991-50d4-b2af-0500a0002df1" :step/math-academy-id 54971 :step/next {:db/id #edb/ref 17592186106949}} {:db/id #edb/ref 17592186106949 :step/content {:db/id #edb/ref 17592186105919 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105475 :question/id #uuid "e7b51055-36f2-552b-817e-3632cf0446b9" :question/math-academy-id "e-12924"} :knowledge-point/id #uuid "3b13a2e9-d7e8-51a3-b452-0594858dd0d1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048338} {:db/id #edb/ref 17592186050157}] :knowledge-point/questions [{:db/id #edb/ref 17592186106028} {:db/id #edb/ref 17592186106444} {:db/id #edb/ref 17592186106446} {:db/id #edb/ref 17592186527129} {:db/id #edb/ref 17592186527130}] :knowledge-point/title "Finding the Nth Term Given the First Term and Another Term"} :step/id #uuid "92c70c0d-cbf1-5b74-9421-f1cb3d0f5cd3" :step/math-academy-id 54972 :step/next {:db/id #edb/ref 17592186106950}} {:db