mn>7</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>29</mn><mo>−</mo><mn>7</mn><mi>n</mi><mo>+</mo><mn>7</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>36</mn><mo>−</mo><mn>7</mn><mi>n</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
