#{[{:activity/first-step {:db/id #edb/ref 17592186111531} :activity/id #uuid "812cb5a9-d9bb-5df5-bcad-60b2e4bca49c" :activity/scope {:db/id #edb/ref 17592186049059 :topic/id #uuid "d690f7fb-8ed3-54e1-86b0-fda3f8281846" :topic/math-academy-id 1457} :activity/steps [{:db/id #edb/ref 17592186111523 :step/content {:db/id #edb/ref 17592186110616 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110506 :question/id #uuid "17173a8a-f28b-5456-8dbb-eb80d6d3cb1c" :question/math-academy-id "e-4713"} :knowledge-point/id #uuid "bd2dc211-25cb-5975-a665-f1f6ffd52488" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048683} {:db/id #edb/ref 17592186049861} {:db/id #edb/ref 17592186050927}] :knowledge-point/questions [{:db/id #edb/ref 17592186111375} {:db/id #edb/ref 17592186111378} {:db/id #edb/ref 17592186234249}] :knowledge-point/title "Combining Various Product and Quotient Rules of Exponents"} :step/id #uuid "e1f34a4c-5543-5841-9a26-631425dd8218" :step/math-academy-id 17217 :step/next {:db/id #edb/ref 17592186111524}} {:db/id #edb/ref 17592186111524 :step/content {:db/id #edb/ref 17592186110617 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110507 :question/id #uuid "f145655c-ed98-578d-b7ab-7b18bfbfa107" :question/math-academy-id "e-4714"} :knowledge-point/id #uuid "aaba81d3-d555-5dc8-a904-f0f7e9520225" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050697}] :knowledge-point/questions [{:db/id #edb/ref 17592186111379} {:db/id #edb/ref 17592186111380}] :knowledge-point/title "Combining the Power Rule of Exponents With Other Rules"} :step/id #uuid "869d7516-5f01-5ae5-8aa5-fa957c225b74" :step/math-academy-id 17218} {:db/id #edb/ref 17592186111525 :step/content {:db/id #edb/ref 17592186110618 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110508 :question/id #uuid "43141ab7-5ebf-5175-a512-e04f6646978d" :question/math-academy-id "e-4752"} :knowledge-point/id #uuid "376ceac4-b0bb-5178-81e9-38e724cceaee" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049081} {:db/id #edb/ref 17592186050668}] :knowledge-point/questions [{:db/id #edb/ref 17592186111376} {:db/id #edb/ref 17592186111377}] :knowledge-point/title "Combining the Product and Quotient Rules of Exponents"} :step/id #uuid "99b9d947-8b7b-5e8a-a9e4-9d2b3a2979a2" :step/math-academy-id 17336 :step/next {:db/id #edb/ref 17592186111523}} {:db/id #edb/ref 17592186111531 :step/content {:db/id #edb/ref 17592186111884 :tutorial/content "Let's recap some of the rules for exponents.\n\n- **Product rule**: to multiply powers of the same base, add the exponents.\n- **Quotient rule**: to divide powers of the same base, subtract the exponents.\n- **Power rule**: to raise a power to another power, multiply the exponents.\n- **Power of product rule**: to raise the product of two numbers to a power, raise each number to that power, and then multiply.\n- **Power of quotient rule**: to raise a fraction to a power, raise both the numerator and the denominator to that power.\n\nWe can use a combination of these rules to simplify expressions containing exponents. Let's see an example of this." :tutorial/id #uuid "7c442391-b257-5c16-9fe0-292a45e3c172" :tutorial/math-academy-id 3275 :tutorial/title "Introduction"} :step/id #uuid "8150e1a1-0f41-5dc7-a1db-5e474331d638" :step/math-academy-id 17999 :step/next {:db/id #edb/ref 17592186111525}}] :activity/title "Combining the Rules of Exponents" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110829}]}
