5417] [17592186109999 #edb/ref 1079 #uuid "acc11582-c97c-5863-934e-c7e355a2ebf7" #edb/ref 17592186045417] [17592186110000 #edb/ref 1080 "3^{10}" #edb/ref 17592186045417] [17592186110000 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186110000 #edb/ref 1083 #uuid "9ac388f8-984f-5e66-98b1-d9e1ffe69c09" #edb/ref 17592186045417] [17592186110001 #edb/ref 1080 "3^{4}" #edb/ref 17592186045417] [17592186110001 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186110001 #edb/ref 1083 #uuid "be2632de-f2ef-50e0-81cf-2233d9593dff" #edb/ref 17592186045417] [17592186110002 #edb/ref 1080 "3^{24}" #edb/ref 17592186045417] [17592186110002 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186110002 #edb/ref 1083 #uuid "bee4fce8-0b9f-5a35-80d3-961243a522be" #edb/ref 17592186045417] [17592186110003 #edb/ref 1080 "3^{8}" #edb/ref 17592186045417] [17592186110003 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186110003 #edb/ref 1083 #uuid "1fa7fb47-b402-5969-bf9d-e6da36e6017b" #edb/ref 17592186045417] [17592186110004 #edb/ref 1080 "3^{12}" #edb/ref 17592186045417] [17592186110004 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186110004 #edb/ref 1083 #uuid "4869a7fd-218d-58da-b877-ddc332556281" #edb/ref 17592186045417] [17592186110506 #edb/ref 1069 "e-4713" #edb/ref 17592186045417] [17592186110506 #edb/ref 1071 "Express $4^{8} \\cdot \\left(\\dfrac{7}{4}\\right)^5$ as the product of two exponentiated integers." #edb/ref 17592186045417] [17592186110506 #edb/ref 1072 #uuid "17173a8a-f28b-5456-8dbb-eb80d6d3cb1c" #edb/ref 17592186045417] [17592186110506 #edb/ref 1074 "First, we rewrite the second factor using the power of quotient rule:\n\n$$\n4^{8} \\cdot (\\frac{7}{4})^{5} = 4^{8} \\cdot \\frac{7^{5}}{4^{5}}\n$$\n\nNext, we rewrite the fractional part of our expression as follows:\n\n$$\n4^{8} \\cdot \\dfrac{7^5}{4^5} = \\dfrac{4^8}{4^5} \\cdot 7^5\n$$\n\nFinally, we simplify using the quotient rule for exponents:\n\n$$\n\\dfrac{4^8}{4^5} \\cdot 7^5 =4^{8-5}\\cdot 7^5=4^{3}\\cdot 7^5\n$$" #edb/ref 17592186045417] [17592186110507 #edb/ref 1069 "e-4714" #edb/ref 17592186045417] [17592186110507 #edb/ref 1071 "Express $\\left(6^4\\right)^2\\cdot 6$ as a base raised to a single power." #edb/ref 17592186045417] [17592186110507 #edb/ref 1072 #uuid "f145655c-ed98-578d-b7ab-7b18bfbfa107" #edb/ref 17592186045417] [17592186110507 #edb/ref 1074 "First, we rewrite the first factor using the power rule for exponents:\n\n$$\n\\left(6^4\\right)^2=6^{4\\cdot 2}=6^8\n$$\n\nThen we use the product rule for exponents:\n\n$$\n6^8 \\cdot 6= 6^8 \\cdot 6^1=6^{8+1}=6^9\n$$" #edb/ref 17592186045417] [17592186110508 #edb/ref 1069 "e-4752" #edb/ref 17592186045417] [17592186110508 #edb/ref 1071 "Express $\\dfrac{5^4\\cdot 5^2}{5^3}$ as a base raised to a single number." #edb/ref 17592186045417] [17592186110508 #edb/ref 1072 #uuid "43141ab7-5ebf-5175-a512-e04f6646978d" #edb/ref 17592186045417] [17592186110508 #edb/ref 1074 "First, we rewrite the numerator using the product rule for exponents:\n\n$$\n\\dfrac{5^4\\cdot 5^2}{5^3}= \\dfrac{5^{4+2}}{5^3} = \\dfrac{5^{6}}{5^3}\n$$\n\nThen, we use the quotient rule for exponents:\n\n$$\n\\dfrac{5^6}{5^3} = 5^{6-3} = 5^{3}\n$$" #edb/ref 17592186045417] [17592186110616 #edb/ref 1037 #edb/ref 17592186048683 #edb/ref 17592186045417] [17592186110616 #edb/ref 1037 #edb/ref 17592186049861 #edb/ref 17592186045417] [17592186110616 #edb/ref 1037 #edb/ref 17592186050927 #edb/ref 17592186045417] [17592186110616 #edb/ref 1038 #edb/ref 17592186111375 #edb/ref 17592186045417] [17592186110616 #edb/ref 1038 #edb/ref 17592186111378 #edb/ref 17592186045417] [17592186110616 #edb/ref 1038 #edb/ref 17592186234249 #edb/ref 17592186045417] [17592186110616 #edb/ref 1039 "Combining Various Product and Quotient Rules of Exponents" #edb/ref 17592186045417] [17592186110616 #edb/ref 1041 #edb/ref 17592186110506 #edb/ref 17592186045417] [17592186110616 #edb/ref 1042