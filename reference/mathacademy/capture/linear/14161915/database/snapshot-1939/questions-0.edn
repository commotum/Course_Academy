#{[{:db/id #edb/ref 17592186110506 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110616 :knowledge-point/id #uuid "bd2dc211-25cb-5975-a665-f1f6ffd52488" :knowledge-point/title "Combining Various Product and Quotient Rules of Exponents"}] :question/id #uuid "17173a8a-f28b-5456-8dbb-eb80d6d3cb1c" :question/math-academy-id "e-4713" :question/problem "Express $4^{8} \\cdot \\left(\\dfrac{7}{4}\\right)^5$ as the product of two exponentiated integers." :question/worked-solution "First, we rewrite the second factor using the power of quotient rule:\n\n$$\n4^{8} \\cdot (\\frac{7}{4})^{5} = 4^{8} \\cdot \\frac{7^{5}}{4^{5}}\n$$\n\nNext, we rewrite the fractional part of our expression as follows:\n\n$$\n4^{8} \\cdot \\dfrac{7^5}{4^5} = \\dfrac{4^8}{4^5} \\cdot 7^5\n$$\n\nFinally, we simplify using the quotient rule for exponents:\n\n$$\n\\dfrac{4^8}{4^5} \\cdot 7^5 =4^{8-5}\\cdot 7^5=4^{3}\\cdot 7^5\n$$"}] [{:db/id #edb/ref 17592186110507 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110617 :knowledge-point/id #uuid "aaba81d3-d555-5dc8-a904-f0f7e9520225" :knowledge-point/title "Combining the Power Rule of Exponents With Other Rules"}] :question/id #uuid "f145655c-ed98-578d-b7ab-7b18bfbfa107" :question/math-academy-id "e-4714" :question/problem "Express $\\left(6^4\\right)^2\\cdot 6$ as a base raised to a single power." :question/worked-solution "First, we rewrite the first factor using the power rule for exponents:\n\n$$\n\\left(6^4\\right)^2=6^{4\\cdot 2}=6^8\n$$\n\nThen we use the product rule for exponents:\n\n$$\n6^8 \\cdot 6= 6^8 \\cdot 6^1=6^{8+1}=6^9\n$$"}] [{:db/id #edb/ref 17592186110508 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110618 :knowledge-point/id #uuid "376ceac4-b0bb-5178-81e9-38e724cceaee" :knowledge-point/title "Combining the Product and Quotient Rules of Exponents"}] :question/id #uuid "43141ab7-5ebf-5175-a512-e04f6646978d" :question/math-academy-id "e-4752" :question/problem "Express $\\dfrac{5^4\\cdot 5^2}{5^3}$ as a base raised to a single number." :question/worked-solution "First, we rewrite the numerator using the product rule for exponents:\n\n$$\n\\dfrac{5^4\\cdot 5^2}{5^3}= \\dfrac{5^{4+2}}{5^3} = \\dfrac{5^{6}}{5^3}\n$$\n\nThen, we use the quotient rule for exponents:\n\n$$\n\\dfrac{5^6}{5^3} = 5^{6-3} = 5^{3}\n$$"}] [{:db/id #edb/ref 17592186111379 :knowledge-point/_questions [{:db/id #edb/ref 17592186110617 :knowledge-point/id #uuid "aaba81d3-d555-5dc8-a904-f0f7e9520225" :knowledge-point/title "Combining the Power Rule of Exponents With Other Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ac388f8-984f-5e66-98b1-d9e1ffe69c09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3^{10}" :db/id #edb/ref 17592186110000} {:answer/id #uuid "be2632de-f2ef-50e0-81cf-2233d9593dff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3^{4}" :db/id #edb/ref 17592186110001} {:answer/id #uuid "bee4fce8-0b9f-5a35-80d3-961243a522be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3^{24}" :db/id #edb/ref 17592186110002} {:answer/id #uuid "1fa7fb47-b402-5969-bf9d-e6da36e6017b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3^{8}" :db/id #edb/ref 17592186110003} {:answer/id #uuid "4869a7fd-218d-58da-b877-ddc332556281" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3^{12}" :db/id #edb/ref 17592186110004}] :answer-field/id #uuid "acc11582-c97c-5863-934e-c7e355a2ebf7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186109999}] :question/id #uuid "b41835e6-33fd-5bcf-8a92-0b87adf2022a" :question/math-academy-id "q-68962" :question/problem "What is $3^{4} \\cdot (3^{2})^{4}$?"}]}
