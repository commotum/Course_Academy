ned}\\frac{{5}^{4}}{{5}^{3}}\\cdot {2}^{4} & ={5}^{4-3}\\cdot {2}^{4} \\\\  & ={5}^{1}\\cdot {2}^{4} \\\\  & =5\\cdot {2}^{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186111379 :knowledge-point/_questions [{:db/id #edb/ref 17592186110617 :knowledge-point/id #uuid "aaba81d3-d555-5dc8-a904-f0f7e9520225" :knowledge-point/title "Combining the Power Rule of Exponents With Other Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03993b0f-60d9-5e29-badb-1214be9df670" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{24}" :db/id #edb/ref 17592186485772} {:answer/id #uuid "17f29d3b-71f8-59ff-831f-0ec0fd1c39c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{4}" :db/id #edb/ref 17592186485808} {:answer/id #uuid "97dea7cf-2841-5e62-b26c-420915860655" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{12}" :db/id #edb/ref 17592186486039} {:answer/id #uuid "c72fe03e-9ac1-5900-9fdf-8ed3af133666" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{10}" :db/id #edb/ref 17592186486125} {:answer/id #uuid "dbbd387a-4642-52c0-9556-cc8e4e6eafe5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{8}" :db/id #edb/ref 17592186486164}] :answer-field/correct {:answer/id #uuid "97dea7cf-2841-5e62-b26c-420915860655" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{12}" :db/id #edb/ref 17592186486039} :answer-field/id #uuid "acc11582-c97c-5863-934e-c7e355a2ebf7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186109999}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b41835e6-33fd-5bcf-8a92-0b87adf2022a" :question/math-academy-id "q-68962" :question/problem 