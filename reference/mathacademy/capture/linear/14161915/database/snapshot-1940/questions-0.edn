#{[{:db/id #edb/ref 17592186110506 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110616 :knowledge-point/id #uuid "bd2dc211-25cb-5975-a665-f1f6ffd52488" :knowledge-point/title "Combining Various Product and Quotient Rules of Exponents"}] :question/id #uuid "17173a8a-f28b-5456-8dbb-eb80d6d3cb1c" :question/math-academy-id "e-4713" :question/problem "Express $4^{8} \\cdot \\left(\\dfrac{7}{4}\\right)^5$ as the product of two exponentiated integers." :question/worked-solution "First, we rewrite the second factor using the power of quotient rule:\n\n$$\n\\begin{aligned}{4}^{8}\\cdot {(\\frac{7}{4})}^{5}={4}^{8}\\cdot \\frac{{7}^{5}}{{4}^{5}}\\end{aligned}\n$$\n\nNext, we rewrite the fractional part of our expression as follows:\n\n$$\n4^{8} \\cdot  \\dfrac{7^5}{4^5} =  \\dfrac{4^8}{4^5} \\cdot 7^5\n$$\n\nFinally, we simplify using the quotient rule for exponents:\n\n$$\n\\dfrac{4^8}{4^5} \\cdot 7^5 =4^{8-5}\\cdot 7^5=4^{3}\\cdot 7^5\n$$"}] [{:db/id #edb/ref 17592186110507 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110617 :knowledge-point/id #uuid "aaba81d3-d555-5dc8-a904-f0f7e9520225" :knowledge-point/title "Combining the Power Rule of Exponents With Other Rules"}] :question/id #uuid "f145655c-ed98-578d-b7ab-7b18bfbfa107" :question/math-academy-id "e-4714" :question/problem "Express $\\left(6^4\\right)^2\\cdot 6$ as a base raised to a single power." :question/worked-solution "First, we rewrite the first factor using the power rule for exponents:\n\n$$\n\\left(6^4\\right)^2=6^{4\\cdot 2}=6^8\n$$\n\nThen we use the product rule for exponents:\n\n$$\n6^8 \\cdot 6= 6^8 \\cdot 6^1=6^{8+1}=6^9\n$$"}] [{:db/id #edb/ref 17592186110508 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110618 :knowledge-point/id #uuid "376ceac4-b0bb-5178-81e9-38e724cceaee" :knowledge-point/title "Combining the Product and Quotient Rules of Exponents"}] :question/id #uuid "43141ab7-5ebf-5175-a512-e04f6646978d" :question/math-academy-id "e-4752" :question/problem "Express $\\dfrac{5^4\\cdot 5^2}{5^3}$ as a base raised to a single number." :question/worked-solution "First, we rewrite the numerator using the product rule for exponents:\n\n$$\n\\dfrac{5^4\\cdot 5^2}{5^3}= \\dfrac{5^{4+2}}{5^3} = \\dfrac{5^{6}}{5^3}\n$$\n\nThen, we use the quotient rule for exponents:\n\n$$\n\\dfrac{5^6}{5^3} = 5^{6-3} = 5^{3}\n$$"}] [{:db/id #edb/ref 17592186486448 :knowledge-point/_questions [{:db/id #edb/ref 17592186110618 :knowledge-point/id #uuid "376ceac4-b0bb-5178-81e9-38e724cceaee" :knowledge-point/title "Combining the Product and Quotient Rules of Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45fac939-3e16-5efa-820e-331e6e70f177" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{9}^{3}" :db/id #edb/ref 17592186485894} {:answer/id #uuid "87f51321-bf87-5180-bfe1-c356255b4479" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186486003} {:answer/id #uuid "b65bc925-dfd5-51c5-926d-5bacad449cc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{9}^{2}" :db/id #edb/ref 17592186486090} {:answer/id #uuid "c696e8a3-2dbf-58d7-8cd7-c6994a7c3195" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186486122} {:answer/id #uuid "df27c3be-8418-5c45-9d7a-2bc445a06ace" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{9}^{4}" :db/id #edb/ref 17592186486171}] :answer-field/correct {:answer/id #uuid "45fac939-3e16-5efa-820e-331e6e70f177" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{9}^{3}" :db/id #edb/ref 17592186485894} :answer-field/id #uuid "d25fc1dd-f49d-5ae8-9e79-a679c7a95245" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486323}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d5189edd-f130-58fd-8d29-2cbc5d8ac007" :question/math-academy-id "q-100752" :question/problem "$\\frac{{9}^{4}\\cdot {9}^{5}}{{9}^{6}}=$" :question/worked-solution "First, we rewrite the numerator using the product rule for exponents:\n\n$$\n\\frac{{9}^{4}\\cdot {9}^{5}}{{9}^{6}}=\\frac{{9}^{4+5}}{{9}^{6}}=\\frac{{9}^{9}}{{9}^{6}}\n$$\n\nThen, we use the quotient rule for exponents:\n\n$$\n\\frac{{9}^{9}}{{9}^{6}}={9}^{9-6}={9}^{3}\n$$"}] [{:db/id #edb/ref 17592186486360 :knowledge-point/_questions [{:db/id #edb/ref 17592186110618 :knowledge-point/id #uuid "376ceac4-b0bb-5178-81e9-38e724cceaee" :knowledge-point/title "Combining the Product and Quotient Rules of Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08da2468-e440-59f8-9406-34205264ad2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186485783} {:answer/id #uuid "1103329e-ce21-53e1-9e9b-c1dd66995c8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{(-5)}" :db/id #edb/ref 17592186485793} {:answer/id #uuid "1c83d900-d2dd-5e86-b9eb-84fb851c17ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5)^{5}" :db/id #edb/ref 17592186485814} {:answer/id #uuid "883ecb23-a3ed-5339-abf5-72e6c3f0dc59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5)^{4}" :db/id #edb/ref 17592186486005} {:answer/id #uuid "fcbcd7d7-1a08-5ac7-8d28-9ca7d64f86be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5)^{3}" :db/id #edb/ref 17592186486224}] :answer-field/correct {:answer/id #uuid "883ecb23-a3ed-5339-abf5-72e6c3f0dc59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5)^{4}" :db/id #edb/ref 1759218648