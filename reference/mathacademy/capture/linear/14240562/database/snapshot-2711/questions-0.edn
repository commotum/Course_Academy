g graph:\n\n![](images/c1/c1b824ff56cc67a930cc5777aed40f913371154631b7caa2a288b5ce7a64a60b.png)\n\nNow, to get the curve $x=2{y}^{2}+3y,$ we just have to reflect the curve $y=2{x}^{2}+3x$ over the line $y=x,$ as follows:\n\n![](images/65/658ed684c36124ca72a172050f5587e51f8eb9c7395bc6aa2fbe1eea09aa7c63.png)"}] [{:db/id #edb/ref 17592186157961 :knowledge-point/_questions [{:db/id #edb/ref 17592186157354 :knowledge-point/id #uuid "1f2981f6-bfbf-5c1e-a4a2-2814dc24804a" :knowledge-point/title "Plotting a Quadratic Function Where X Is a Function of Y"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dec569bc-4861-5f9b-9002-2902f4b4c77f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/80/80dbbd79a79c59237d61ee228d47887187cb9856366686ce9520291f1d713e72.png" :db/id #edb/ref 17592186156688} {:answer/id #uuid "e6afc5cb-aafa-572c-bf4f-2e18147ce5e1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/95/95f55293ecb8a57ce34c50dfb11b5090923137273e4885e99bd54cae7b125e4f.png" :db/id #edb/ref 17592186156689} {:answer/id #uuid "075982d7-3367-5e34-a8c4-bb90d5e49ddb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ac/acafb0f5cec6fc2ad238fa9a1a53fee47fe8f0e37ded3c7733ec838a6c1d66e2.png" :db/id #edb/ref 17592186156690} {:answer/id #uuid "0a533d56-e848-502f-ba53-cd04f2196f4b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/af/af8a5de34c0cb4d24879c6dc211e8f610eab0a5602985ac82c43cd4db3c2d49e.png" :db/id #edb/ref 17592186156691} {:answer/id #uuid "4a3df525-d1dd-5895-9bfa-0e38c6d44d01" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/72/721db846a92d0ede38f6234154c54f55fe1bb3c5cae852e900864b1da1de2a5a.png" :db/id #edb/ref 17592186156692}] :answer-field/correct {:answer/id #uuid "075982d7-3367-5e34-a8c4-bb90d5e49ddb" :answer/type {:db/id #