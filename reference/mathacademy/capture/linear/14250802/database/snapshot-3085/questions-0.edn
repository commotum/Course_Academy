#{[{:db/id #edb/ref 17592186571434 :knowledge-point/_questions [{:db/id #edb/ref 17592186157380 :knowledge-point/id #uuid "4529c46f-0656-523f-a403-65477ea040f2" :knowledge-point/title "Identifying Graph Transformations Resulting From Reflections With Other Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d93d66e-722f-55b9-a6a8-9666d280e658" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ca/ca1621741dd9491190e7963998837c416dca71687c0d98d1edadac0fa45733fa.png" :db/id #edb/ref 17592186570932} {:answer/id #uuid "b70e6613-acc6-5883-a472-d681a112295d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/24/2493056bb0bdda03f1211cdcf2ba37cc32fa4ca1f24dc958453c3a53dc475e94.png" :db/id #edb/ref 17592186571174} {:answer/id #uuid "bddcd47a-43af-58ae-962e-d4612551bcab" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/85/85eff21720baac1ac1cb32ef937d872f4e43b63cf2f0ad8133ce7e5f5694c261.png" :db/id #edb/ref 17592186571185} {:answer/id #uuid "e211c6d6-c4c3-5811-8f8a-09b9773c2362" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9f/9f615fb34297e7917e962163fe31c965a1198518254ab92b5ddee1396ff42bed.png" :db/id #edb/ref 17592186571238} {:answer/id #uuid "f9a29614-5daf-5385-ab32-1d5fd8bec552" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/32/32fbbaad18af88c2cd20181ed88d1a2f30b505e5116ac00bb8257c4f3182609f.png" :db/id #edb/ref 17592186571270}] :answer-field/correct {:answer/id #uuid "e211c6d6-c4c3-5811-8f8a-09b9773c2362" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9f/9f615fb34297e7917e962163fe31c965a1198518254ab92b5ddee1396ff42bed.png" :db/id #edb/ref 17592186571238} :answer-field/id #uuid "01931c73-45e8-5a20-96d9-664e3a5bcff8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571282}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a5cb4a7d-eb8d-5bb8-b384-6e3ed5b2f571" :question/math-academy-id "q-115012" :question/problem "![](images/a1/a140ec13e1f9e51ebfc5392f327cfbb6e235969ff2b8f94a3e1b3238ff618462.png)\n\nThe diagram above shows the function $y=f(x).$ Which of the following gives the graph of $y=-f(3x)+5?$" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches and reflections, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches and reflections, followed by vertical translations.\n\nTo plot $y=-f(3x)+5,$ we apply the following steps: \n\n- Take the curve $y=f(x).$\n\n- Stretch it by a scale factor of $\\frac{1}{3}$ parallel to the $x$-axis to get the graph of $y=f(3x).$\n\n![](images/6c/6c9ee35100926f041407b00b67c88db4843cc5df56431471869aabe261a55b69.png)\n\n- Then, reflect the result across the $x$-axis to get the graph of $y=-f(3x).$\n\n![](images/9b/9be6d9b1c9edce0a5c41ffe1958238f826696ab1b3d3f48924d3daf4a007228f.png)\n\n- Finally, translate the result up by $5$ units to get the graph of $y=-f(3x)+5.$\n\n![](images/17/17995c1b79fff4a6711c57547b590afccca3d8ec635e114e01f71791bf441cc4.png)"}] [{:db/id #edb/ref 17592186157618 :knowledge-point/_questions [{:db/id #edb/ref 17592186157380 :knowledge-point/id #uuid "4529c46f-0656-523f-a403-65477ea040f2" :knowledge-point/title "Identifying Graph Transformations Resulting From Reflections With Other Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ccf3cf9-7185-5841-8104-8b8ded08a149" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/10/10721ef4895767ca1d56184b51189c63254598944c0535fac0d2965c016e3101.png" :db/id #edb/ref 17592186153953} {:answer/id #uuid "a0ed71e2-e6b3-5771-884e-7367981e18e2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1b/1bda2136308db8c25bcaddb1c8e92f1bbe3375eb66e90fbaaec0f8b93a1d8826.png" :db/id #edb/ref 17592186153954} {:answer/id #uuid "d797c288-bc33-54df-a00d-4b26caba8db0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/12/12cba48528587ada6ce91621ebc3658fc83b92b417bf2399b4220623c6359dcd.png" :db/id #edb/ref 17592186153955} {:answer/id #uuid "e555a6eb-e625-57e4-bc32-d7a0c3c9f563" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/85/854566f8fdffad29cf81c5e1bbf0282445d6a23e5a27ce442d98723638e45e9a.png" :db/id #edb/ref 17592186153956} {:answer/id #uuid "25619d94-9025-55b9-a774-f709fe82d55f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ba/bafbce8eab1e3105b4ddc2bc6f9fda800850b76bd40fa25f74809d32a0d9491e.png" :db/id #edb/ref 17592186153957}] :answer-field/id #uuid "38832501-0380-56d0-a051-f20674843d26" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186153952}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8540c1df-d797-5809-9f6d-9185481ab68d" :question/math-academy-id "q-16727" :question/problem "![](images/65/655a47bf250df8e0694d8a82d5b22efde626681684fb78042767380ff202685e.png)\n\nThe diagram above shows the function $y = f(x)$. Which of the following gives the graph of $y =-\\frac{1}{2}f(x - 1)$?"}] [{:db/id #edb/ref 17592186571447 :knowledge-point/_questions [{:db/id #edb/ref 17592186157319 :knowledge-point/id #uuid "947c8ce4-53c5-5765-ab74-62daf58e53e1" :knowledge-point/title "Identifying Graph Transformations Resulting From Reflections With Shifting"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cc71577-322c-5046-9694-adebb66b8045" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bf/bfd76e37f4be6ebedb1d833f0a6b49014d0b397786bc0d34992a1dd638010524.png" :db/id #edb/ref 17592186571109} {:answer/id #uuid "b64d9a23-0b22-5a70-adee-c975f354879c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ca/cad43db36b13fae5440b02427aa16ab52399037447a2143bb18337b9cfd013ae.png" :db/id #edb/ref 17592186571172} {:answer/id #uuid "d52f0249-2ad9-50b1-b9ca-0f65e3d18411" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0d/0d063ede6f8ced347abfa6ea7d464494bee23132ca4505b3f0ad5fc4b9bd989e.png" :db/id #edb/ref 17592186571221} {:answer/id #uuid "df5dd109-8b40-5e2d-829f-1183caff5110" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f7/f72279b52f1a87ca8c4bf1faf1d5794c3d62a35da9c500163c76b71d5c93e11e.png" :db/id #edb/ref 17592186571236} {:answer/id #uuid "ec714509-9f3f-5d6a-9d87-5100a23e574b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/96/96fd4eaa9f3e74e3c5d2870f302292fdcfd2e74e28bac91cb6112e4e069a8d5d.png" :db/id #edb/ref 17592186571255}] :answer-field/correct {:answer/id #uuid "ec714509-9f3f-5d6a-9d87-5100a23e574b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/96/96fd4eaa9f3e74e3c5d2870f302292fdcfd2e74e28bac91cb6112e4e069a8d5d.png" :db/id #edb/ref 17592186571255} :answer-field/id #uuid "7d2c0693-8d9e-58a9-906e-25f147f9e683" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571333}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e692cc95-5b32-57cb-8318-c9a3ccb94ff4" :question/math-academy-id "q-17800" :question/problem "![](images/49/492cbb12227ccbdd9f9c4d3e78268d41fe50db84edfa8a7a4c1cc7cd3c1f21e8.png)\n\nThe diagram above shows the function $y=f(x).$ Which of the following gives the graph of $y=f(-x)-1?$" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches and reflections, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches and reflections, followed by vertical translations.\n\nTo plot $y=f(-x)-1,$ we apply the following steps:\n\n- Take the curve $y=f(x).$\n\n- Reflect the result across the $y$-axis to get the graph of $y=f(-x).$\n\n![](images/36/36283012eba092d1bb7f8f76ba8bc25423d5f5526e9d89ba4f69644c6d900e00.png)\n\n- Then, translate the result down by $1$ unit to get the graph of $y=f(-x)-1.$\n\n![](images/83/8332b0ae6cc477b451eefaf7192fcad820df3847bed535542e465f8f43994cdb.png)"}] [{:db/id #edb/ref 17592186157630 :knowledge-point/_questions [{:db/id #edb/ref 17592186157319 :knowledge-point/id #uuid "947c8ce4-53c5-5765-ab74-62daf58e53e1" :knowledge-point/title "Identifying Graph Transformations Resulting From Reflections With Shifting"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "886befc2-04e9-56fb-b31b-b439c3fdac8f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4a/4a4b0d1c0e911e34f9bce657964e370f20c8d343b4c0761b0d7bbb24adacb80e.png" :db/id #edb/ref 17592186154017} {:answer/id #uuid "8fa6fcf2-1237-57b6-b7c1-ddaf9045fc2a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9b/9bd122fe355ab806d6a8d162181121375db97198d82013a031e