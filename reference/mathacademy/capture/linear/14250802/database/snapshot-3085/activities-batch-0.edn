#{[{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186158263} :activity/id #uuid "f73902f8-cc54-5fe2-8902-2adcdbcf027e" :activity/scope {:db/id #edb/ref 17592186048753 :topic/id #uuid "bb8df0ff-58fd-5ef3-8af3-6a8fd08c46ef" :topic/math-academy-id 2841} :activity/steps [{:db/id #edb/ref 17592186158169 :step/content {:db/id #edb/ref 17592186157319 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157123 :question/id #uuid "437933c3-8c8b-52b8-84f0-ea6bbf789552" :question/math-academy-id "e-7516"} :knowledge-point/id #uuid "947c8ce4-53c5-5765-ab74-62daf58e53e1" :knowledge-point/questions [{:db/id #edb/ref 17592186157617} {:db/id #edb/ref 17592186157630} {:db/id #edb/ref 17592186554539} {:db/id #edb/ref 17592186554543} {:db/id #edb/ref 17592186571447}] :knowledge-point/title "Identifying Graph Transformations Resulting From Reflections With Shifting"} :step/id #uuid "8ad173dc-2a61-504c-9908-78979256990a" :step/math-academy-id 27895 :step/next {:db/id #edb/ref 17592186158265}} {:db/id #edb/ref 17592186158263 :step/content {:db/id #edb/ref 17592186158543 :tutorial/content "Given the graph of a curve $y= f(x),$ there are two types of reflections we can apply to it:\n\n1\\. Reflection across the $y$-axis. This is a transformation of the form \n\n  $$\n  y=f(-x).\n  $$\n\n2\\. Reflection across the $x$-axis. This is a transformation of the form \n\n  $$\n  y=-f(x).\n  $$\n\nFor example, let's consider the function $y=f(x)$ below. \n\n![](images/69/6931216dd63985631394e3f3f2fe59246ddd810ecce5af0f0c7ad18b8634133b.png)\n\nThe graph of $y=f(-x)$ is a reflection of $y=f(x)$ in the $y$-axis, and it looks as follows:\n\n![](images/e2/e2274a68c25ed14ba93410fe87d672f85b839b7214b30e80d34a3ae28f47ef03.png)\n\n \n\nThe graph of $y=-f(x)$ is a reflection of $y=f(x)$ in the $x$-axis, and it looks as follows:\n\n![](images/ee/eee560bdd17899d55cdaea35204e9963ae9f0148f0ef897173e6250a3eb874b3.png)\n\n  \n\nWe can also combine reflections with other graph transformations. Let's see how." :tutorial/id #uuid "f4bb9366-7e90-51e5-944c-9609c7607cfa" :tutorial/math-academy-id 5125 :tutorial/title "Introduction"} :step/id #uuid "458f5225-bfe2-5847-9c9c-043b6bc8cd45" :step/math-academy-id 32129 :step/next {:db/id #edb/ref 17592186158264}} {:db/id #edb/ref 17592186158264 :step/content {:db/id #edb/ref 17592186157378 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157198 :question/id #uuid "e2417b4a-ffe8-5dc3-946e-d4c7e9a09719" :question/math-academy-id "e-8653"} :knowledge-point/id #uuid "ff702318-379a-5040-b32f-e7c89f1f2451" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048186} {:db/id #edb/ref 17592186048408} {:db/id #edb/ref 17592186050962}] :knowledge-point/questions [{:db/id #edb/ref 17592186157628} {:db/id #edb/ref 17592186157629} {:db/id #edb/ref 17592186554548} {:db/id #edb/ref 17592186554558} {:db/id #edb/ref 17592186554611}] :knowledge-point/title "Determining the Correct Order of Transformations Given a Transformed Function Expression"} :step/id #uuid "b192d500-e629-54c1-bc67-397bce154d97" :step/math-academy-id 32131 :step/next {:db/id #edb/ref 17592186158169}} {:db/id #edb/ref 17592186158265 :step/content {:db/id #edb/ref 17592186157379 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157199 :question/id #uuid "86213aa7-5452-547b-9a8d-467bf870bc08" :question/math-academy-id "e-8654"} :knowledge-point/id #uuid "f0bf39b4-5615-5078-b048-99bbd7c50b50" :knowledge-point/questions [{:db/id #edb/ref 17592186157627} {:db/id #edb/ref 17592186158010} {:db/id #edb/ref 17592186554580} {:db/id #edb/ref 17592186554643}] :knowledge-point/title "Identifying Graph Transformations Resulting From Reflections With Scaling"} :step/id #uuid "1d3f6450-2627-57f9-9c88-1e1c6ddb17b1" :step/math-academy-id 32132 :step/next {:db/id #edb/ref 17592186158266}} {:db/id #edb/ref 17592186158266 :step/content {:db/id #edb/ref 17592186157380 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157200 :question/id #uuid "3b032f9c-3c15-5018-ae45-28b01235a3c7" :question/math-academy-id "e-8655"} :knowledge-point/id #uuid "4529c46f-0656-523f-a403-65477ea040f2" :knowledge-point/questions [{:db/id #edb/ref 17592186157618} {:db/id #edb/ref 17592186158011} {:db/id #edb/ref 17592186554553} {:db/id #edb/ref 17592186554557} {:db/id #edb/ref 17592186554607} {:db/id #edb/ref 17592186554624} {:db/id #edb/ref 17592186571434}] :knowledge-point/title "Identifying Graph Transformations Resulting From Reflections With Other Transformations"} :step/id #uuid "e9bc56b9-0314-5f98-b64e-8cfbc787d859" :step/math-academy-id 32133}] :activity/title "Combining Reflections With Other Graph Transformations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186157496}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186571497} :activity/id #uuid "ceeefb8d-a489-565b-8fd4-3f9818ddc698" :activity/scope {:db/id #edb/ref 17592186048753 :topic/id #uuid "bb8df0ff-58fd-5ef3-8af3-6a8fd08c46ef" :topic/math-academy-id 2841} :activity/steps [{:db/id #edb/ref 17592186571461 :step/content {:db/id #edb/ref 17592186571434 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d93d66e-722f-55b9-a6a8-9666d280e658" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ca/ca1621741dd9491190e7963998837c416dca71687c0d98d1edadac0fa45733fa.png" :db/id #edb/ref 17592186570932} {:answer/id #uuid "b70e6613-acc6-5883-a472-d681a112295d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/24/2493056bb0bdda03f1211cdcf2ba37cc32fa4ca1f24dc958453c3a53dc475e94.png" :db/id #edb/ref 17592186571174} {:answer/id #uuid "bddcd47a-43af-58ae-962e-d4612551bcab" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/85/85eff21720baac1ac1cb32ef937d872f4e43b63cf2f0ad8133ce7e5f5694c261.png" :db/id #edb/ref 17592186571185} {:answer/id #uuid "e211c6d6-c4c3-5811-8f8a-09b9773c2362" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/9f/9f615fb34297e7917e962163fe31c965a1198518254ab92b5ddee1396ff42bed.png" :db/id #edb/ref 17592186571238} {:answer/id #uuid "f9a29614-5daf-5385-ab32-1d5fd8bec552" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/32/32fbbaad18af88c2cd20181ed88d1a2f30b505e5116ac00bb8257c4f3182609f.png" :db/id #edb/ref 17592186571270}] :answer-field/correct {:db/id #edb/ref 17592186571238} :answer-field/id #uuid "01931c73-45e8-5a20-96d9-664e3a5bcff8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571282}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a5cb4a7d-eb8d-5bb8-b384-6e3ed5b2f571" :question/math-academy-id "q-115012" :question/problem "![](images/a1/a140ec13e1f9e51ebfc5392f327cfbb6e235969ff2b8f94a3e1b3238ff618462.png)\n\nThe diagram above shows the function $y=f(x).$ Which of the following gives the graph of $y=-f(3x)+5?$" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches and reflections, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches and reflections, followed by vertical translations.\n\nTo plot $y=-f(3x)+5,$ we apply the following steps: \n\n- Take the curve $y=f(x).$\n\n- Stretch it by a scale factor of $\\frac{1}{3}$ parallel to the $x$-axis to get the graph of $y=f(3x).$\n\n![](images/6c/6c9ee35100926f041407b00b67c88db4843cc5df56431471869aabe261a55b69.png)\n\n- Then, reflect the result across the $x$-axis to get the graph of $y=-f(3x).$\n\n![](images/9b/9be6d9b1c9edce0a5c41ffe1958238f826696ab1b3d3f48924d3daf4a007228f.png)\n\n- Finally, translate the result up by $5$ units to get the graph of $y=-f(3x)+5.$\n\n![](images/17/17995c1b79fff4a6711c57547b590afccca3d8ec635e114e01f71791bf441cc4.png)"} :step/id #uuid "135ba2ab-b4dd-59ec-9b89-fbca647ac0ce"} {:db/id #edb/ref 17592186571475 :step/content {:db/id #edb/ref 17592186571447 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cc71577-322c-5046-9694-adebb66b8045" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/bf/bfd76e37f4be6ebedb1d833f0a6b49014d0b397786bc0d34992a1dd638010524.png" :db/id #edb/ref 17592186571109} {:answer/id #uuid "b64d9a23-0b22-5a70-adee-c975f354879c" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ca/cad43db36b13fae5440b02427aa16ab52399037447a2143bb18337b9cfd013ae.png" :db/id #edb/ref 17592186571172} {:answer/id #uuid "d52f0249-2ad9-50b1-b9ca-0f65e3d18411" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/0d/0d063ede6f8ced347abfa6ea7d464494bee23132ca4505b3f0ad5fc4b9bd989e.png" :db/id #edb/ref 17592186571221} {:answer/id #uuid "df5dd109-8b40-5e2d-829f-1183caff5110" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f7/f72279b52f1a87ca8c4bf1faf1d5794c3d62a35da9c500163c76b71d5c93e11e.png" :db/id #edb/ref 17592186571236} {:answer/id #uuid "ec714509-9f3f-5d6a-9d87-5100a23e574b" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/96/96fd4eaa9f3e74e3c5d2870f302292fdcfd2e74e28bac91cb6112e4e069a8d5d.png" :db/id #edb/ref 17592186571255}] :answer-field/correct {:db/id #edb/ref 17592186571255} :answer-field/id #uuid "7d2c0693-8d9e-58a9-906e-25f147f9e683" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571333}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e692cc95-5b32-57cb-8318-c9a3ccb94ff4" :question/math-academy-id "q-17800" :question/problem "![](images/49/492cbb12227ccbdd9f9c4d3e78268d41fe50db84edfa8a7a4c1cc7cd3c1f21e8.png)\n\nThe diagram above shows the function $y=f(x).$ Which of the following gives the graph of $y=f(-x)-1?$" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches and reflections, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches and reflections, followed by vertical translations.\n\nTo plot $y=f(-x)-1,$ we apply the following steps:\n\n- Take the curve $y=f(x).$\n\n- Reflect the result across the $y$-axis to get the graph of $y=f(-x).$\n\n![](images/36/36283012eba092d1bb7f8f76ba8bc25423d5f5526e9d89ba4f69644c6d900e00.png)\n\n- Then, translate the result down by $1$ unit to get the graph of $y=f(-x)-1.$\n\n![](images/83/8332b0ae6cc477b451eefaf7192fcad820df3847bed535542e465f8f43994cdb.png)"} :step/id #uuid "3588e36d-4954-5851-aad5-f8f415c8cc08" :step/next {:db/id #edb/ref 17592186571505}} {:db/id #edb/ref 17592186571483 :step/content {:db/id #edb/ref 17592186158010 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d8f7b85-3610-5084-9960-568a5f074d30" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/1d/1dca75c75e19f5cf61b52c7981306295db5e082093f4629c4af3679dc80647e8.png" :db/id #edb/ref 17592186156982} {:answer/id #uuid "91ff24db-eb6c-5cf0-bd44-38bfe05fc45b" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a8/a8197203e6c9ce05a03658849551b50a806595cfef2e40835ab957c5d814aad2.png" :db/id #edb/ref 17592186156983} {:answer/id #uuid "c2833740-f48c-58ea-a486-7864f95c881f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/39/39ccbf52a38b94319ecd1b91afe5c7e7f2ffa2bedc952902a9ed99551918edb2.png" :db/id #edb/ref 17592186156984} {:answer/id #uuid "02c61bde-aacf-54df-a7eb-31cf06631289" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e1/e1fd5a5f5289ad132697747f795bf4290a3b61720331d5705b88edd899110680.png" :db/id #edb/r