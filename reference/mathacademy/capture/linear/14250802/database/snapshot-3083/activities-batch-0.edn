#{[{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186158263} :activity/id #uuid "f73902f8-cc54-5fe2-8902-2adcdbcf027e" :activity/scope {:db/id #edb/ref 17592186048753 :topic/id #uuid "bb8df0ff-58fd-5ef3-8af3-6a8fd08c46ef" :topic/math-academy-id 2841} :activity/steps [{:db/id #edb/ref 17592186158169 :step/content {:db/id #edb/ref 17592186157319 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157123 :question/id #uuid "437933c3-8c8b-52b8-84f0-ea6bbf789552" :question/math-academy-id "e-7516"} :knowledge-point/id #uuid "947c8ce4-53c5-5765-ab74-62daf58e53e1" :knowledge-point/questions [{:db/id #edb/ref 17592186157617} {:db/id #edb/ref 17592186157630} {:db/id #edb/ref 17592186554539} {:db/id #edb/ref 17592186554543}] :knowledge-point/title "Identifying Graph Transformations Resulting From Reflections With Shifting"} :step/id #uuid "8ad173dc-2a61-504c-9908-78979256990a" :step/math-academy-id 27895 :step/next {:db/id #edb/ref 17592186158265}} {:db/id #edb/ref 17592186158263 :step/content {:db/id #edb/ref 17592186158543 :tutorial/content "Given the graph of a curve $y= f(x),$ there are two types of reflections we can apply to it:\n\n1\\. Reflection across the $y$-axis. This is a transformation of the form \n\n  $$\n  y=f(-x).\n  $$\n\n2\\. Reflection across the $x$-axis. This is a transformation of the form \n\n  $$\n  y=-f(x).\n  $$\n\nFor example, let's consider the function $y=f(x)$ below. \n\n![](images/69/6931216dd63985631394e3f3f2fe59246ddd810ecce5af0f0c7ad18b8634133b.png)\n\nThe graph of $y=f(-x)$ is a reflection of $y=f(x)$ in the $y$-axis, and it looks as follows:\n\n![](images/e2/e2274a68c25ed14ba93410fe87d672f85b839b7214b30e80d34a3ae28f47ef03.png)\n\n \n\nThe graph of $y=-f(x)$ is a reflection of $y=f(x)$ in the $x$-axis, and it looks as follows:\n\n![](images/ee/eee560bdd17899d55cdaea35204e9963ae9f0148f0ef897173e6250a3eb874b3.png)\n\n  \n\nWe can also combine reflections with other graph transformations. Let's see how." :tutorial/id #uuid "f4bb9366-7e90-51e5-944c-9609c7607cfa" :tutorial/math-academy-id 5125 :tutorial/title "Introduction"} :step/id #uuid "458f5225-bfe2-5847-9c9c-043b6bc8cd45" :step/math-academy-id 32129 :step/next {:db/id #edb/ref 17592186158264}} {:db/id #edb/ref 17592186158264 :step/content {:db/id #edb/ref 17592186157378 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157198 :question/id #uuid "e2417b4a-ffe8-5dc3-946e-d4c7e9a09719" :question/math-academy-id "e-8653"} :knowledge-point/id #uuid "ff702318-379a-5040-b32f-e7c89f1f2451" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048186} {:db/id #edb/ref 17592186048408} {:db/id #edb/ref 17592186050962}] :knowledge-point/questions [{:db/id #edb/ref 17592186157628} {:db/id #edb/ref 17592186157629} {:db/id #edb/ref 17592186554548} {:db/id #edb/ref 17592186554558} {:db/id #edb/ref 17592186554611}] :knowledge-point/title "Determining the Correct Order of Transformations Given a Transformed Function Expression"} :step/id #uuid "b192d500-e629-54c1-bc67-397bce154d97" :step/math-academy-id 32131 :step/next {:db/id #edb/ref 17592186158169}} {:db/id #edb/ref 17592186158265 :step/content {:db/id #edb/ref 17592186157379 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157199 :question/id #uuid "86213aa7-5452-547b-9a8d-467bf870bc08" :question/math-academy-id "e-8654"} :knowledge-point/id #uuid "f0bf39b4-5615-5078-b048-99bbd7c50b50" :knowledge-point/questions [{:db/id #edb/ref 17592186157627} {:db/id #edb/ref 17592186158010} {:db/id #edb/ref 17592186554580} {:db/id #edb/ref 17592186554643}] :knowledge-point/title "Identifying Graph Transformations Resulting From Reflections With Scaling"} :step/id #uuid "1d3f6450-2627-57f9-9c88-1e1c6ddb17b1" :step/math-academy-id 32132 :step/next {:db/id #edb/ref 17592186158266}} {:db/id #edb/ref 17592186158266 :step/content {:db/id #edb/ref 17592186157380 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157200 :question/id #uuid "3b032f9c-3c15-5018-a