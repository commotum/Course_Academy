id #edb/ref 17592186387010} {:answer/id #uuid "9d30e4cd-7866-5dc8-9d17-e3603b0e1d04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{QT}=b+c" :db/id #edb/ref 17592186387011} {:answer/id #uuid "0e6b1f27-9577-571f-a402-5318532c66a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{QT}=a-b" :db/id #edb/ref 17592186387012} {:answer/id #uuid "6efc2e18-f131-54ef-8b65-97d65d26fb87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{QT}=a+b" :db/id #edb/ref 17592186387013} {:answer/id #uuid "4939a251-4f3d-5483-a371-05ba68aaf27c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{QT}=a+d" :db/id #edb/ref 17592186387014}] :answer-field/correct {:answer/id #uuid "0e6b1f27-9577-571f-a402-5318532c66a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{QT}=a-b" :db/id #edb/ref 17592186387012} :answer-field/id #uuid "80e3c074-2fe2-56ad-8be9-99fa6a58e9b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387009}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b958283a-525c-51ab-a33e-68049ee3df0d" :question/math-academy-id "q-12049" :question/problem "![](images/2f/2f9e6eff196e24ddabca8d778d27e499fc1b856ef7169257a31a7cbaca8b564b.png)\n\nConsider the diagram shown above, where $\\overset{\\to }{QP}=a,$ $\\overset{\\to }{TP}=b,$ $\\overset{\\to }{TS}=c,$ and $\\overset{\\to }{RS}=d.$ Find $\\overset{\\to }{QT}$ in terms of $a,b,c,$ and $d.$" :question/worked-solution "We want to find a \"path\" from $Q$ to $T$ consisting only of the vectors $a,b,c,$ and $d.$\n\nAccording to the triangle law of addition,\n\n$$\n\\overset{\\to }{QT}=\\overset{\\to }{QP}+\\overset{\\to }{PT},\n$$\n\nas shown below.\n\n![](images/e1/e1d5eb2f392332f69fa1507899b30b838a42ebd1c40dacddeca4edcf0f7aa8c2.png)\n\n \n\nNow, from the original diagram, we have that\n\n$$\n\\overset{\\to }{QP}=a,\\,\\overset{\\to }{PT}=-b.\n$$\n\nLet's add these to our diagram.\n\n![](images/0e/0e8e24968141284550fac7d4e5c63333789f30ade8f7d5dd8b87fae4e012673a.png)\n\n \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\overset{\\to }{QT} & =\\overset{\\to }{QP}+\\overset{\\to }{PT} \\\\  & =a+(-b) \\\\  & =a-b\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097339 :knowledge-point/_questions [{:db/id #edb/ref 17592186096794 :knowledge-point/id #uuid "66c43200-991b-5854-be1d-fa9db80f3725" :knowledge-point/title "Expressing a Vector as a Sum or Difference of Two Known Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "932f5592-30ac-5c62-b384-7f486827d8d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "QT^(→) = b - d" :db/id #edb/ref 17592186095959} {:answer/id #uuid "eb7de78d-2b15-5011-b093-b1ecd1d5d8f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "QT^(→) = a + c" :db/id #edb/ref 17592186095960} {:answer/id #uuid "0100ff78-f852-53f3-b877-5a8f83dcffbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "QT^(→) = a + b" :db/id #edb/ref 17592186095961} {:answer/id #uuid "1c3729a5-b418-50e7-8211-78c4c9d786db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "QT^(→) = b + c" :db/id #edb/ref 17592186095962} {:answer/id #uuid "73d7f791-5754-5042-b83e-47ec093c5ba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "QT^(→) = b - c" :db/id #edb/ref 17592186095963}] :answer-field/id #uuid "cc93a4ca-1e30-5ce1-8bb0-5d9fd691aa83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 