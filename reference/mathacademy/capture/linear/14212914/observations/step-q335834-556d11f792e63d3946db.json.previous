      "dom_index": 0,
      "disabled": false,
      "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:120px;\n                                        margin-left:2px;\n                                        margin-right:1px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"31\"><span mathquill-command-id=\"33\" class=\"\">−</span><var mathquill-command-id=\"35\">a</var><span mathquill-command-id=\"37\" class=\"mq-binary-operator\">+</span><var mathquill-command-id=\"39\">b</var><span mathquill-command-id=\"41\" class=\"mq-binary-operator\">−</span><var mathquill-command-id=\"43\">c</var><span mathquill-command-id=\"45\" class=\"mq-binary-operator\">+</span><var mathquill-command-id=\"47\">d</var></span></div></div>",
      "rendered_text": "−a+b−c+d",
      "choices_complete": false
    }
