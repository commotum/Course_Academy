      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14212914/observations/step-q69532-80067000201af3726aeb.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14212914/observations/step-q69532-80067000201af3726aeb.png",
