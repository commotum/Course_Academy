      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14212914/observations/step-q328092-c5c5b7e2beab53f0f90c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14212914/observations/step-q328092-c5c5b7e2beab53f0f90c.png",
      "source_url": "https://mathacademy.com/tasks/14212914/topics/1102/lesson",
      "captured_at": 1792003952.344421,
