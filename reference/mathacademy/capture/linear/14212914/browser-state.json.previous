      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14212914/observations/step-q12049-f2699fa57923a47c5c72.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14212914/observations/step-q12049-f2699fa57923a47c5c72.png",
