          "dom_index": 0,
          "disabled": false,
          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:70px;\n                                        margin-left:2px;\n                                        margin-right:1px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"19\"><var mathquill-command-id=\"21\">a</var><span mathquill-command-id=\"23\" class=\"mq-binary-operator\">+</span><var mathquill-command-id=\"25\">b</var><span mathquill-command-id=\"27\" class=\"mq-binary-operator\">+</span><var mathquill-command-id=\"29\">c</var></span></div></div>",
          "rendered_text": "a+b+c",
