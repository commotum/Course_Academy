      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14212914/observations/step-q332559-669134abc6024a86d634.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14212914/observations/step-q332559-669134abc6024a86d634.png",
      "source_url": "https://mathacademy.com/tasks/14212914/topics/1102/lesson",
      "captured_at": 1792003904.7766736,
      "math_academy_id": "q-332559",
