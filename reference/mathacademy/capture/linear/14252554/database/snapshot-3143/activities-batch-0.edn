#{[{:activity/expected-seconds 1080.0 :activity/first-step {:db/id #edb/ref 17592186097726} :activity/id #uuid "73468f98-1cbd-5f7a-ba16-40ada8199e38" :activity/scope {:db/id #edb/ref 17592186049352 :topic/id #uuid "ee0cf1a5-e7d1-5e77-84d9-efd5a5be54f2" :topic/math-academy-id 1117} :activity/steps [{:db/id #edb/ref 17592186097726 :step/content {:db/id #edb/ref 17592186097906 :tutorial/content "Consider the graph of the function $y = f(x)$ shown below. \n\n![](images/5b/5b7ca737255a0af8a8ea0412d74a5ef63d04fe5a6b441eae103e98d3c00bad1a.png)\n\nLet's use our knowledge of derivatives to find $f'(0),$ the derivative of $f$ at $x=0.$\n\nNote the following:\n\n- $f'(0)$ represents the slope of the tangent to $y=f(x)$ at the point $x=0.$\n\n- The function $y = f(x)$ is made up of line segments.\n\n- So, to find $f'(0),$ we simply need to find the slope of $y = f(x)$ over an interval that contains $x=0,$ and where $f$ is represented by a single line segment.\n\nWith that in mind, we consider the graph of $y=f(x)$ over $x\\in [-2,1].$ \n\n![](images/80/80dd0f95c4bd8030bae693e17185d4becee29c7681d134d3ee50a3621a184b94.png)\n\nThis interval contains $x=0,$ and $f$ is represented by a single line segment over this interval.\n\nThe slope of $y=f(x)$ over this interval is equal to\n\n$$\n\\begin{aligned}\\frac{Δf}{Δx} & =\\frac{2-1}{1-(-2)}=\\frac{1}{3}.\\end{aligned}\n$$\n\nTherefore, $f'(0)=\\dfrac{1}{3}.$" :tutorial/id #uuid "a67ce8b0-4e17-57ad-9f00-3f594bfe2ae3" :tutorial/math-academy-id 6803 :tutorial/title "Introduction"} :step/id #uuid "e61a8095-664c-5074-bafd-b31cdbdc3f9d" :step/math-academy-id 41291 :step/next {:db/id #edb/ref 17592186097727}} {:db/id #edb/ref 17592186097727 :step/content {:db/id #edb/ref 17592186096804 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096375 :question/id #uuid "b10aaa3e-2ba4-51af-be3b-056d72692885" :question/math-academy-id "e-10889"} :knowledge-point/id #uuid "0a16e7b6-2a09-5aeb-9a8b-ea8fb1d59807" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049061} {:db/id #edb/ref 17592186050711} {:db/id #edb/ref 17592186050961}] :knowledge-point/questions [{:db/id #edb/ref 17592186097341} {:db/id #edb/ref 17592186097342} {:db/id #edb/ref 17592186240934} {:db/id #edb/ref 17592186241071} {:db/id #edb/ref 17592186317468} {:db/id #edb/ref 17592186317545} {:db/id #edb/ref 17592186317546} {:db/id #edb/ref 17592186341896} {:db/id #edb/ref 17592186479066} {:db/id #edb/ref 17592186479118} {:db/id #edb/ref 17592186479146}] :knowledge-point/title "Calculating the Derivative of a Function From Its Graph"} :step/id #uuid "60e6454d-edc8-5611-b706-381666da1147" :step/math-academy-id 41292 :step/next {:db/id #edb/ref 17592186097728}} {:db/id #edb/ref 17592186097728 :step/content {:db/id #edb/ref 17592186096805 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096376 :question/id #uuid "9811f16e-75aa-5982-b97b-cc59b33fb7d8" :question/math-academy-id "e-10890"} :knowledge-point/id #uuid "aeaff08f-f2c5-5e51-baca-988348852948" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048932}] :knowledge-point/questions [{:db/id #edb/ref 17592186097143} {:db/id #edb/ref 17592186097343} {:db/id #edb/ref 17592186240935} {:db/id #edb/ref 17592186240936} {:db/id #edb/ref 17592186240937} {:db/id #edb/ref 17592186240938} {:db/id #edb/ref 17592186240939} {:db/id #edb/ref 17592186275356} {:db/id #edb/ref 17592186287890} {:db/id #edb/ref 17592186317561} {:db/id #edb/ref 17592186479073} {:db/id #edb/ref 17592186479103} {:db/id #edb/ref 17592186479114} {:db/id #edb/ref 17592186507526}] :knowledge-point/title "Computing the Derivative of a Linear Sum of Functions"} :step/id #uuid "f318e6e8-6284-53bd-8a92-ea63b929f668" :step/math-academy-id 41295 :step/next {:db/id #edb/ref 17592186097729}} {:db/id #edb/ref 17592186097729 :step/content {:db/id #edb/ref 17592186096806 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096377 :question/id #uuid "1fb2491b-f442-57e3-990f-65bf1270d847" :question/math-academy-id "e-10891"} :knowledge-point/id #uuid "36b05580-d22b-5ac4-b8a3-cd8d9629ef74" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048813}] :knowledge-point/questions [{:db/id #edb/ref 17592186097142} {:db/id #edb/ref 17592186097344} {:db/id #edb/ref 17592186240940} {:db/id #edb/ref 17592186240942} {:db/id #edb/ref 17592186241073} {:db/id #edb/ref 17592186287891} {:db/id #edb/ref 17592186317562} {:db/id #edb/ref 17592186317563} {:db/id #edb/ref 17592186317564} {:db/id #edb/ref 17592186317565} {:db/id #edb/ref 17592186341904} {:db/id #edb/ref 17592186479077} {:db/id #edb/ref 17592186479099} {:db/id #edb/ref 17592186479120}] :knowledge-point/title "Computing the Derivative of a Product of Functions"} :step/id #uuid "66cada44-df2e-5018-8802-42f12b055e2d" :step/math-academy-id 41298 :step/next {:db/id #edb/ref 17592186097730}} {:db/id #edb/ref 17592186097730 :step/content {:db/id #edb/ref 17592186096807 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096378 :question/id #uuid "5e929c25-68b1-5a6b-92a0-d12b90a112e8" :question/math-academy-id "e-10892"} :knowledge-point/id #uuid "0e274fe1-7242-5a6c-8351-eeff9877d2bf" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048842}] :knowledge-point/questions [{:db/id #edb/ref 17592186097131} {:db/id #edb/ref 17592186097261} {:db/id #edb/ref 17592186240943} {:db/id #edb/ref 17592186275360} {:db/id #edb/ref 17592186287888} {:db/id #edb/ref 17592186317566} {:db/id #edb/ref 17592186317567} {:db/id #edb/ref 17592186329941} {:db/id #edb/ref 17592186329942} {:db/id #edb/ref 17592186479076} {:db/id #edb/ref 17592186479091} {:db/id #edb/ref 17592186479136} {:db/id #edb/ref 17592186507408} {:db/id #edb/ref 17592186507484}] :knowledge-point/title "Computing the Derivative of a Quotient of Functions"} :step/id #uuid "9a4e38fe-2c63-5d93-80db-eb1b12107085" :step/math-academy-id 41301}] :activity/title "Calculating Derivatives From Graphs" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186096895}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186507594} :activity/id #uuid "4bd31384-9cfe-50e2-a5c0-35742c087c1a" :activity/scope {:db/id #edb/ref 17592186049352 :topic/id #uuid "ee0cf1a5-e7d1-5e77-84d9-efd5a5be54f2" :topic/math-academy-id 1117} :activity/steps [{:db/id #edb/ref 17592186507543 :step/content {:db/id #edb/ref 17592186507408 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b2b3346-7673-59b0-8162-666645b193ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186506854}] :answer-field/correct {:db/id #edb/ref 17592186506854} :answer-field/id #uuid "0b0ffb3a-4b6c-5434-a8c2-b27219cc6547" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186507246}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1f0168e5-5e69-5504-a3b6-aca93e900a7d" :question/math-academy-id "q-344924" :question/problem "![](images/d1/d1d974b84be93c1178820f27c40f7b2bfae66837f5f64dcb7353f968abad966c.png)\n\nGiven the plots of $y=f(x)$ and $y=g(x)$ above, find ${h}^{′}(1)$ where $h(x)=\\frac{f(x)}{g(x)}.$\n\n${h}^{′}(1)=$\n{{field-1}}" :question/worked-solution "The quotient rule for derivatives gives\n\n$$\n{h}^{′}(x)=\\frac{{f}^{′}(x)\\cdot g(x)-f(x)\\cdot {g}^{′}(x)}{(g(x))^{2}}.\n$$\n\nAs a result, we have that\n\n$$\n{h}^{′}(1)=\\frac{{f}^{′}(1)\\cdot g(1)-f(1)\\cdot {g}^{′}(1)}{(g(1))^{2}}.\n$$\n\nFrom the graphs above, we obtain that $f(1)=2$ and $g(1)=1.$\n\nAdditionally:\n\n- The slope of $f(x)$ on $x\\in (-1,3)$ equals $-\\frac{1}{2}.$ So, ${f}^{′}(1)=-\\frac{1}{2}.$\n\n- The slope of $g(x)$ on $x\\in (0,3)$ equals $-1.$ So, ${g}^{′}(1)=-1.$\n\nFinally, we have\n\n$$\n\\begin{aligned}{h}^{′}(1) & =\\frac{{f}^{′}(1)\\cdot g(1)-f(1)\\cdot {g}^{′}(1)}{(g(1))^{2}} \\\\  & =\\frac{(-\\frac{1}{2})\\cdot 1-2\\cdot (-1)}{(1)^{2}} \\\\  & =\\frac{\\frac{3}{2}}{1} \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$"} :step/id #uuid "312712b1-8b7a-53ed-8f8f-1a44e0c3665b"} {:db/id #edb/ref 17592186507545 :step/content {:db/id #edb/ref 17592186507484 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c024e51f-4568-56fd-aa5d-264f65cb958e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186507099}] :answer-field/correct {:db/id #edb/ref 17592186507099} :answer-field/id #uuid "c78a8149-ac98-5a72-838f-ed41c1a3be7e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186507364}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b174aebb-a676-5d61-8eb4-16162678c428" :question/math-academy-id "q-344911" :question/problem "![](images/09/09ad3db74e5345e8d496d1f0f02fb3eca0ceb5f684ec7227900fa565b4f12adc.png)\n\nGiven the plots of $y=f(x)$ and $y=g(x)$ above, find ${h}^{′}(1)$ where $h(x)=\\frac{f(x)}{g(x)}.$\n\n${h}^{′}(1)=$\n{{field-1}}" :question/worked-solution "The quotient rule for derivatives gives\n\n$$\n{h}^{′}(x)=\\frac{{f}^{′}(x)\\cdot g(x)-f(x)\\cdot {g}^{′}(x)}{(g(x))^{2}}.\n$$\n\nAs a result, we have that\n\n$$\n{h}^{′}(1)=\\frac{{f}^{′}(1)\\cdot g(1)-f(1)\\cdot {g}^{′}(1)}{(g(1))^{2}}.\n$$\n\nFrom the graphs above, we obtain that $f(1)=2$ and $g(1)=-1.$\n\nAdditionally:\n\n- The slope of $f(x)$ on $x\\in (-1,2.5)$ equals $1.$ So, ${f}^{′}(1)=1.$\n\n- The slope of $g(x)$ on $x\\in (0,2)$ equals $-2.$ So, ${g}^{′}(1)=-2.$\n\nFinally, we have\n\n$$\n\\begin{aligned}{h}^{′}(1) & =\\frac{{f}^{′}(1)\\cdot g(1)-f(1)\\cdot {g}^{′}(1)}{(g(1))^{2}} \\\\  & =\\frac{1\\cdot (-1)-2\\cdot (-2)}{(-1)^{2}} \\\\  & =\\frac{3}{1} \\\\  & =3.\\end{aligned}\n$$"} :step/id #uuid "38e7c2ba-03d5-59fc-88a3-c217b6bb01e8" :step/next {:db/id #edb/ref 17592186507543}} {:db/id #edb/ref 17592186507568 :step/content {:db/id #edb/ref 17592186097344 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83470de2-4e61-5a1c-b192-79f1df6d4335" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1.5" :db/id #edb/ref 17592186095989} {:answer/id #uuid "95069f73-03b6-5a03-ab67-b16610a1a575" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.5" :db/id #edb/ref 17592186095990} {:answer/id #uuid "b32b8df2-7eab-5d94-a684-c2b38e87a035" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186095991} {:answer/id #uuid "b5942677-2209-5ef1-b68c-d5e736a62a4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-0.5" :db/id #edb/ref 17592186095992} {:answer/id #uuid "26718127-638f-5bd0-a44f-9838ff349877" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186095993}] :answer-field/correct {:db/id #edb/ref 17592186095992} :answer-field/id #uuid "2deafe62-4ea6-5bd2-b1ab-39cbc06aca34" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186095988}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bba9ad1a-f133-594e-8f67-d3021de105b3" :question/math-academy-id "q-73072" :question/problem "![](images/68/68379dee045e8b5d4f123f91c0f8c953d2cbbe6475c5ca13d4435889343c625d.png)\n\nThe graphs of the functions $y=f(x)$ and $y=g(x)$ are given above. Find ${h}^{′}(-1.5)$ where $h(x)=f(x)g(x).$" :question/worked-solution "The product rule for derivatives gives\n\n$$\n{h}^{′}(x)={f}^{′}(x)\\cdot g(x)+f(x)\\cdot {g}^{′}(x).\n$$\n\nAs a result, we have that\n\n$$\n{h}^{′}(-1.5)={f}^{′}(-1.5)\\cdot g(-1.5)+f(-1.5)\\cdot {g}^{′}(-1.5).\n$$\n\nFrom the graphs above, we obtain that $f(-1.5)=-0.5$ and $g(-1.5)=-0.5.$\n\nAdditionally:\n\n- The slope of $f(x)$ on $x\\in (-2.5,0)$ equals $1.$ So, ${f}^{′}(-1.5)=1.$\n\n- The slope of $g(x)$ on $x\\in (-3,-0.5)$ equals $0.$ So, ${g}^{′}(-1.5)=0.$\n\nTherefore,\n\n$$\n\\begin{aligned}{h}^{′}(-1.5) & ={f}^{′}(-1.5)\\cdot g(-1.5)+f(-1.5)\\cdot {g}^{′}(-1.5) \\\\  & =1\\cdot (-0.5)+(-0.5)\\cdot 0 \\\\  & =-0.5.\\end{aligned}\n$$"} :step/id #uuid "a67658ec-ba15-5263-a25f-fc3a8c701ef9" :step/next {:db/id #edb/ref 17592186507545}} {:db/id #edb/ref 17592186507571 :step/content {:db/id #edb/ref 17592186341904 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48032645-41e1-5dbf-86cc-6068e1aa769f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186339768} {:answer/id #uuid "5aadb11c-c90c-542c-af66-409a4c6258f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186339952} {:answer/id #uuid "61fec891-91e7-5bba-b874-5cbd3bea799d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186340001} {:answer/id #uuid "8a0997c6-5117-5d49-a566-b66be7e47668" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186340361} {:answer/id #uuid "e4ed339e-9c42-5596-b7c9-b8865d6b534e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186341152}] :answer-field/correct {:db/id #edb/ref 17592186340361} :answer-field/id #uuid "b1019304-1602-5d3a-92f7-0735c20c8795" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341693}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "66744c9b-eb26-5db6-8152-9819040359e0" :question/math-academy-id "q-73071" :question/problem "![](images/f8/f8ec0a6a96e74958d1972cea2778b9c974abfad08f2457bc8f2a9f6c3778db15.png)\n\nThe graphs of the functions $y=f(x)$ and $y=h(x)$ are given above. Find ${p}^{′}(-2)$ where $p(x)=f(x)h(x).$" :question/worked-solution "The product rule for derivatives gives\n\n$$\n{p}^{′}(x)={f}^{′}(x)\\cdot h(x)+f(x)\\cdot {h}^{′}(x).\n$$\n\nAs a result, we have that\n\n$$\n{p}^{′}(-2)={f}^{′}(-2)\\cdot h(-2)+f(-2)\\cdot {h}^{′}(-2).\n$$\n\nFrom the graphs above, we obtain that $f(-2)=2$ and $h(-2)=-2.$\n\nAdditionally,\n\n- The slope of $f(x)$ on $x\\in (-3,0)$ equals $-1.$ So, ${f}^{′}(-2)=-1.$\n\n- The slope of $h(x)$ on $x\\in (-2.5,0)$ equals $2.$ So, ${h}^{′}(-2)=2.$\n\nTherefore,\n\n$$\n\\begin{aligned}{p}^{′}(-2) & ={f}^{′}(-2)\\cdot h(-2)+f(-2)\\cdot {h}^{′}(-2) \\\\  & =(-1)\\cdot (-2)+2\\cdot 2 \\\\  & =6.\\end{aligned}\n$$"} :step/id #uuid "b65e1306-beb1-5d87-9741-a346607d4e8f" :step/next {:db/id #edb/ref 17592186507568}} {:db/id #edb/ref 17592186507594 :step/content {:db/id #edb/ref 17592186507526 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23c22933-3ae0-55c6-b5c7-adc6ead01d3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186506753} {:answer/id #uuid "8d506a74-f2f5-5e41-8e8c-de01e70eb86d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186506994} {:answer/id #uuid "944336d1-3de5-5f47-b7dd-34713d1454a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186507000} {:answer/id #uuid "d1415baf-245d-5f48-8719-acc972691c60" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186507133} {:answer/id #uuid "d7677738-2814-55ea-acdc-028b230ca13d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186507141}] :answer-field/correct {:db/id #edb/ref 17592186507133} :answer-field/id #uuid "e6b3dcc7-9bff-54ac-98b5-b6d4547269fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186507380}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f357dec6-4d63-50f8-ac56-8adda8bfb923" :question/math-academy-id "q-48934" :question/problem "![](images/72/72befb19f4f9f7834c673794cece69d7d3c70da2d2b83feb4a2961c7ef1b12d3.png)\n\nThe graphs of the functions $y=f(x)$ and $y=g(x)$ are given above. Find ${q}^{′}(-1)$ where $q(x)=f(x)-g(x).$" :question/worked-solution "The addition and constant multiple rules for derivatives give\n\n$$\n{q}^{′}(x)={f}^{′}(x)-{g}^{′}(x).\n$$\n\nAs a result, we have that\n\n$$\n{q}^{′}(-1)={f}^{′}(-1)-{g}^{′}(-1).\n$$\n\nAlso, notice that $x=-1$ corresponds to \n\n- the interval $x\\in (-2,0)$ for the function $f,$ and\n\n- the interval $x\\in (-2,0)$ for the function $g,$\n\nas shown below.\n\n![](images/24/244c8f29305d462ad11eabd50b9e55ae6b1de5d168d64768ed522a915aa1f283.png)\n\n- The slope of $y=f(x)$ is constant on $x\\in (-2,0)$ and equals\n\n$$\n\\frac{Δf}{Δx}=\\frac{3-1}{0-(-2)}=1.\n$$\n\nTherefore, ${f}^{′}(-1)=1.$\n\n- The slope of $y=g(x)$ is constant on $x\\in (-2,0)$ and equals\n\n$$\n\\frac{Δg}{Δx}=\\frac{(-3)-1}{0-(-2)}=-2.\n$$\n\nTherefore, ${g}^{′}(-1)=-2.$\n\nFinally, we have\n\n$$\n\\begin{aligned}{q}^{′}(-1) & ={f}^{′}(-1)-{g}^{′}(-1) \\\\  & =1-(-2) \\\\  & =3.\\end{aligned}\n$$"} :step/id #uuid "fe2899d1-2da7-5155-af7d-57e3adf6c643" :step/next {:db/id #edb/ref 17592186507571}}] :activity/title "Calculating Derivatives From Graphs" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186506667}]}
