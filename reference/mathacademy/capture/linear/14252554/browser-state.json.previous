      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14252554/observations/step-q344119-ac9071bf2669353791d1.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14252554/observations/step-q344119-ac9071bf2669353791d1.png",
      "source_url": "https://mathacademy.com/tasks/14252554/topics/1117/lesson",
      "captured_at": 1792138987.6802998,
      "math_academy_id": "q-344119",
      "topic_id": "1117",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q344119",
        "placement_id": null,
        "content_id": null,
        "type": null
