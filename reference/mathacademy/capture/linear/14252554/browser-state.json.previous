      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14252554/observations/step-q344801-ae8a13b8f5c69c8259fc.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14252554/observations/step-q344801-ae8a13b8f5c69c8259fc.png",
