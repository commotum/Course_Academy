#{[{:activity/first-step {:db/id #edb/ref 17592186097467} :activity/id #uuid "8f327b60-e0cf-5553-a69d-9f75b2352ae4" :activity/scope {:db/id #edb/ref 17592186049603 :topic/id #uuid "03d5463d-8db1-5e89-8946-23139052e041" :topic/math-academy-id 1100} :activity/steps [{:db/id #edb/ref 17592186097467 :step/content {:db/id #edb/ref 17592186097828 :tutorial/content "Given two vectors, we can compute the sum by placing the head of one vector at the tail of the other.\n\nFor example, let's consider the two vectors $\\textbf{a}$ and $\\textbf{b}$ below.\n\n![](images/04/049f79ae22e5931a7ceba7f73fef5cb6bc38d17c2a45e7186d57f8760b02488a.png)\n\nTo find $\\mathbf{a}+\\mathbf{b}$, we need to draw the second vector $\\textbf{b}$ starting from the head of the first vector $\\textbf{a}$. Now, the sum $\\mathbf{a}+\\mathbf{b}$ is the vector that we get when we join the tail of $\\textbf{a}$ to the head of $\\textbf{b}$:\n\n![](images/98/98a42bc3ecf7071630acc7d29349f75f77b20a9cc1c2c34382161cc79b47b4df.png)\n\nWe call this method the **triangle law of addition**. The vector obtained by adding two or more vectors is sometimes called the **resultant**." :tutorial/id #uuid "f1d80471-b824-5cac-9146-15b6e8b910d2" :tutorial/math-academy-id 2901 :tutorial/title "Introduction"} :step/id #uuid "dbd21225-959b-5fe0-a9cb-fd7a77bebb11" :step/math-academy-id 15685 :step/next {:db/id #edb/ref 17592186097470}} {:db/id #edb/ref 17592186097470 :step/content {:db/id #edb/ref 17592186096642 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096439 :question/id #uuid "96cb0487-40a4-5942-aa43-6ca61830bde0" :question/math-academy-id "e-4272"} :knowledge-point/id #uuid "48176a87-796e-5637-9552-4f7fccdeee6a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050194}] :knowledge-point/questions [{:db/id #edb/ref 17592186096954} {:db/id #edb/ref 17592186097171}] :knowledge-point/title "Adding Two Vectors Using the Triangle Law"} :step/id #uuid "d2226c33-40b3-550e-9ab3-8359f4445fdd" :step/math-academy-id 15688 :step/next {:db/id #edb/ref 17592186097473}} {:db/id #edb/ref 17592186097472 :step/content {:db/id #edb/ref 17592186096644 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096441 :question/id #uuid "6db52d38-e14d-5424-9b54-af258ad7551c" :question/math-academy-id "e-4274"} :knowledge-point/id #uuid "db159911-4e9a-563e-9a3d-58d4e73dc862" :knowledge-point/questions [{:db/id #edb/ref 17592186097335} {:db/id #edb/ref 17592186097336}] :knowledge-point/title "Adding Two Opposite Vectors Using the Triangle Law"} :step/id #uuid "c5e4bcd7-3f24-565d-8d90-7d783587b66c" :step/math-academy-id 15690 :step/next {:db/id #edb/ref 17592186097490}} {:db/id #edb/ref 17592186097473 :step/content {:db/id #edb/ref 17592186097830 :tutorial/content "Given a vector $\\overrightarrow{AB}$, the **opposite vector** is the vector $\\overrightarrow{BA}$ that has the same length but goes in the opposite direction.\n\n![](images/65/6591fd004ba2b74c2651182ce0c70302ac789d868389d057a502b8e98ac61fab.png)\n\nWe write\n\n$$\n\\overrightarrow{AB}=-\\overrightarrow{BA}\n$$\n\nTo compute the sum of two opposite vectors,\n$\\overrightarrow{AB}+\\overrightarrow{BA}$,\nwe can use the triangle law of addition.\n\nAccording to the triangle law of addition, the resultant is the vector that goes from the tail of $\\overrightarrow{AB}$ to the head of $\\overrightarrow{BA}$. Therefore, we obtain a new vector for which the tail and head are the same point, $A$. We denote that vector as\n\n$$\n\\overrightarrow{AB}+\\overrightarrow{BA} = \\overrightarrow{AA}=\\mathbf{0}\n$$\n\nThe vector $\\mathbf{0}$ is called the **zero vector**. The zero vector has no direction and zero magnitude. With the zero vector, the head coincides with the tail." :tutorial/id #uuid "ff30d4cd-a46e-5658-aada-2885298012f1" :tutorial/math-academy-id 2903 :tutorial/title "Opposite Vectors and the Zero Vector"} :step/id #uuid "9589b39e-7e79-59cb-a04d-4c80d504257a" :step/math-academy-id 15691 :step/next {:db/id #edb/ref 17592186097472}} {:db/id #edb/ref 17592186097475 :step/content {:db/id #edb/ref 17592186096646 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096443 :question/id #uuid "77d2bd5d-5f79-5204-8c65-395ef6414225" :question/math-academy-id "e-4276"} :knowledge-point/id #uuid "e9ae0161-d016-5aef-8c11-020047c66bbd" :knowledge-point/questions [{:db/id #edb/ref 17592186096993} {:db/id #edb/ref 17592186097337}] :knowledge-point/title "Adding More Than Two Vectors Using the Triangle Law"} :step/id #uuid "79ccec21-3796-56f3-a7d4-24bb46c252eb" :step/math-academy-id 15693} {:db/id #edb/ref 17592186097489 :step/content {:db/id #edb/ref 17592186096654 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096453 :question/id #uuid "5fade14b-9fa1-5777-afe3-c061907218f6" :question/math-academy-id "e-4359"} :knowledge-point/id #uuid "711d0e70-a248-5f93-a836-43bed5435d4f" :knowledge-point/questions [{:db/id #edb/ref 17592186096992} {:db/id #edb/ref 17592186097153}] :knowledge-point/title "Subtracting Two Vectors Using the Triangle Law"} :step/id #uuid "9525b995-7556-5826-b108-58b033c286e1" :step/math-academy-id 16022 :step/next {:db/id #edb/ref 17592186097475}} {:db/id #edb/ref 17592186097490 :step/content {:db/id #edb/ref 17592186097838 :tutorial/content "We've seen how to use the triangle law to add two vectors. We can also use the triangle law to subtract two vectors.\n\nThe trick is to interpret the subtraction as the addition of a negative vector. For example, the subtraction\n$\\mathbf{a}-\\mathbf{b}$\ncan be interpreted as the addition\n$\\mathbf{a} + (-\\mathbf{b})$,\nwhere $-\\mathbf{b}$ is the vector that has the same magnitude as $\\mathbf{b}$ but goes in the direction *opposite* of $\\mathbf{b}$.\n\nLet's see a concrete example." :tutorial/id #uuid "9e3c330e-f67a-51e0-abd7-144acc20080b" :tutorial/math-academy-id 2960 :tutorial/title "Using the Triangle Law for Subtraction"} :step/id #uuid "e1b5149f-330e-5b4d-8235-f3c9ff3b5ad7" :step/math-academy-id 16023 :step/next {:db/id #edb/ref 17592186097489}}] :activity/title "The Triangle Law for the Addition of Two Vectors" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186096880}]}
