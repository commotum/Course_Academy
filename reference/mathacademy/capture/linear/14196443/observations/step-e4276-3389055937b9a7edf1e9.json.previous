73 -3V9L172 8Q170 7 167 6T161 3T152 1T140 0Q113 0 96 17Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E2-MJMAINB-62\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-2C\" x=\"639\" y=\"0\"></use>\n</g>\n</svg></span> and <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.188ex\" height=\"1.676ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -576.1 511.5 721.6\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-3-Title\">\n<title id=\"MathJax-SVG-3-Title\">\\textbf{c}</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E3-MJMAINB-63\" d=\"M447 131H458Q478 131 478 117Q478 112 471 95T439 51T377 9Q330 -6 286 -6Q196 -6 135 35Q39 96 39 222Q39 324 101 384Q169 453 286 453Q359 453 411 431T464 353Q464 319 445 302T395 284Q360 284 343 305T325 353Q325 380 338 396H333Q317 398 295 398H292Q280 398 271 397T245 390T218 373T197 338T183 283Q182 275 182 231Q182 199 184 180T193 132T220 85T270 57Q289 50 317 50H326Q385 50 414 115Q419 127 423 129T447 131Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E3-MJMAINB-63\" x=\"0\" y=\"0\"></use>\n</g>\n</svg></span> are shown in the diagram below. Find <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"10.3ex\" height=\"2.343ex\" style=\"vertical-align: -0.505ex;\" viewBox=\"0 -791.3 4434.9 1008.6\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-4-Title\">\n<title id=\"MathJax-SVG-4-Title\">\\textbf{a}+\\textbf{b}-\\textbf{c}.</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E4-MJMAINB-61\" d=\"M64 349Q64 399 107 426T255 453Q346 453 402 423T473 341Q478 327 478 310T479 196V77Q493 63 529 62Q549 62 553 57T558 31Q558 9 552 5T514 0H497H481Q375 0 367 56L356 46Q300 -6 210 -6Q130 -6 81 30T32 121Q32 188 111 226T332 272H350V292Q350 313 348 327T337 361T306 391T248 402T194 399H189Q204 376 204 354Q204 327 187 306T134 284Q97 284 81 305T64 349ZM164 121Q164 89 186 67T238 45Q274 45 307 63T346 108L350 117V226H347Q248 218 206 189T164 121Z\"></path>\n<path stroke-width=\"1\" id=\"E4-MJMAIN-2B\" d=\"M56 237T56 250T70 270H369V420L370 570Q380 583 389 583Q402 583 409 568V270H707Q722 262 722 250T707 230H409V-68Q401 -82 391 -82H389H387Q375 -82 369 -68V230H70Q56 237 56 250Z\"></path>\n<path stroke-width=\"1\" id=\"E4-MJMAINB-62\" d=\"M32 686L123 690Q214 694 215 694H221V409Q289 450 378 450Q479 450 539 387T600 221Q600 122 535 58T358 -6H355Q272 -6 203 53L160 1L129 0H98V301Q98 362 98 435T99 525Q99 591 97 604T83 620Q69 624 42 624H29V686H32ZM227 105L232 99Q237 93 242 87T258 73T280 59T306 49T339 45Q380 45 411 66T451 131Q457 160 457 230Q457 264 456 284T448 329T430 367T396 389T343 398Q282 398 235 355L227 348V105Z\"></path>\n<path stroke-width=\"1\" id=\"E4-MJMAIN-2212\" d=\"M84 237T84 250T98 270H679Q694 262 694 250T679 230H98Q84 237 84 250Z\"></path>\n<path stroke-width=\"1\" id=\"E4-MJMAINB-63\" d=\"M447 131H458Q478 131 478 117Q478 112 471 95T439 51T377 9Q330 -6 286 -6Q196 -6 135 35Q39 96 39 222Q39 324 101 384Q169 453 286 453Q359 453 411 431T464 353Q464 319 445 302T395 284Q360 284 343 305T325 353Q325 380 338 396H333Q317 398 295 398H292Q280 398 271 397T245 390T218 373T197 338T183 283Q182 275 182 231Q182 199 184 180T193 132T220 85T270 57Q289 50 317 50H326Q385 50 414 115Q419 127 423 129T447 131Z\"></path>\n<path stroke-width=\"1\" id=\"E4-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E4-MJMAINB-61\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-2B\" x=\"781\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAINB-62\" x=\"1782\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-2212\" x=\"2644\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAINB-63\" x=\"3644\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-2E\" x=\"4156\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<div id=\"graphic-77dd1ee7460a10f825b8eec72c3691b9\" class=\"graphic\"><img src=\"/graphics/77dd1ee7460a10f825b8eec72c3691b9\"></div>\n                    </div>     \n            \n                    <div class=\"exampleExplanationHeader\">EXPLANATION</div>\n            \n                    <div class=\"exampleExplanation\">\n                        <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                            float: none;\n                            direction: ltr;\n                            max-width: none;\n                            max-height: none;\n                            min-width: 0;\n                            min-height: 0;\n                            border: 0;\n                            padding: 0;\n                            margin: 0\n                            }\n\n                            .mjpage * {\n                            transition: none;\n                            -webkit-transition: none;\n                            -moz-transition: none;\n                            -ms-transition: none;\n                            -o-transition: none\n                            }\n\n                            .mjx-svg-href {\n                            fill: blue;\n                            stroke: blue\n                            }\n\n                            .MathJax_SVG_LineBox {\n                            display: table!important\n                            }\n\n                            .MathJax_SVG_LineBox span {\n                            display: table-cell!important;\n                            width: 10000em!important;\n                            min-width: 0;\n                            max-width: none;\n                            padding: 0;\n                            border: 0;\n                            margin: 0\n                            }\n\n                            .mjpage__block {\n                            text-align: center;\n                            margin: 1em 0em;\n                            position: relative;\n                            display: block!important;\n                            text-indent: 0;\n                            max-width: none;\n                            max-height: none;\n                            min-width: 0;\n                            min-height: 0;\n                            width: 100%\n                            }</style><p>First, we use the triangle law of addition to find \n<span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"6.272ex\" height=\"2.343ex\" style=\"vertical-align: -0.505ex;\" viewBox=\"0 -791.3 2700.4 1008.6\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-1-Title\">\n<title id=\"MathJax-SVG-1-Title\">\n\\textbf{a}+\\textbf{b}.\n</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E1-MJMAINB-61\" d=\"M64 349Q64 399 107 426T255 453Q346 453 402 423T473 341Q478 327 478 310T479 196V77Q493 63 529 62Q549 62 553 57T558 31Q558 9 552 5T514 0H497H481Q375 0 367 56L356 46Q300 -6 210 -6Q130 -6 81 30T32 121Q32 188 111 226T332 272H350V292Q350 313 348 327T337 361T306 391T248 402T194 399H189Q204 376 204 354Q204 327 187 306T134 284Q97 284 81 305T64 349ZM164 121Q164 89 186 67T238 45Q274 45 307 63T346 108L350 117V226H347Q248 218 206 189T164 121Z\"></path>\n<path stroke-width=\"1\" id=\"E1-MJMAIN-2B\" d=\"M56 237T56 250T70 270H369V420L370 570Q380 583 389 583Q402 583 409 568V270H707Q722 262 722 250T707 230H409V-68Q401 -82 391 -82H389H387Q375 -82 369 -68V230H70Q56 237 56 250Z\"></path>\n<path stroke-width=\"1\" id=\"E1-MJMAINB-62\" d=\"M32 686L123 690Q214 694 215 694H221V409Q289 450 378 450Q479 450 539 387T600 221Q600 122 535 58T358 -6H355Q272 -6 203 53L160 1L129 0H98V301Q98 362 98 435T99 525Q99 591 97 604T83 620Q69 624 42 624H29V686H32ZM227 105L232 99Q237 93 242 87T258 73T280 59T306 49T339 45Q380 45 411 66T451 131Q457 160 457 230Q457 264 456 284T448 329T430 367T396 389T343 398Q282 398 235 355L227 348V105Z\"></path>\n<path stroke-width=\"1\" id=\"E1-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E1-MJMAINB-61\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-2B\" x=\"781\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAINB-62\" x=\"1782\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-2E\" x=\"2421\" y=\"0\"></use>\n</g>\n</svg></span>\nThe resultant <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"5.625ex\" height=\"2.343ex\" style=\"vertical-align: -0.505ex;\" viewBox=\"0 -791.3 2421.9 1008.6\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-2-Title\">\n<title id=\"MathJax-SVG-2-Title\">\\mathbf{a}+\\mathbf{b}</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E2-MJMAINB-61\" d=\"M64 349Q64 399 107 426T255 453Q346 453 402 423T473 341Q478 327 478 310T479 196V77Q493 63 529 62Q549 62 553 57T558 31Q558 9 552 5T514 0H497H481Q375 0 367 56L356 46Q300 -6 210 -6Q130 -6 81 30T32 121Q32 188 111 226T332 272H350V292Q350 313 348 327T337 361T306 391T248 402T194 399H189Q204 376 204 354Q204 327 187 306T134 284Q97 284 81 305T64 349ZM164 121Q164 89 186 67T238 45Q274 45 307 63T346 108L350 117V226H347Q248 218 206 189T164 121Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMAIN-2B\" d=\"M56 237T56 250T70 270H369V420L370 570Q380 583 389 583Q402 583 409 568V270H707Q722 262 722 250T707 230H409V-68Q401 -82 391 -82H389H387Q375 -82 369 -68V230H70Q56 237 56 250Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMAINB-62\" d=\"M32 686L123 690Q214 694 215 694H221V409Q289 450 378 450Q479 450 539 387T600 221Q600 122 535 58T358 -6H355Q272 -6 203 53L160 1L129 0H98V301Q98 362 98 435T99 525Q99 591 97 604T83 620Q69 624 42 624H29V686H32ZM227 105L232 99Q237 93 242 87T258 73T280 59T306 49T339 45Q380 45 411 66T451 131Q457 160 457 230Q457 264 456 284T448 329T430 367T396 389T343 398Q282 398 235 355L227 348V105Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E2-MJMAINB-61\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-2B\" x=\"781\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAINB-62\" x=\"1782\" y=\"0\"></use>\n</g>\n</svg></span> is the vector that joins the tail of <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.299ex\" height=\"1.676ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -576.1 559.5 721.6\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-la