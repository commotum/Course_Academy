[{:db/id 17592186138536 :knowledge-point/questions ["question-f3147df7-04f3-51f7-bd72-80ab17bf146c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138073 :question/problem "Represent the inequality $x < -2$ or $x \\geq  1$ on a number line." :question/worked-solution "The inequality $x < -2$ or $x \\geq  1$ means that $x$ can take any value less than $-2,$ or greater than or equal to $1.$\n\nTo represent this on a number line, we graph the two separate inequalities:\n\n- the inequality $x < -2$ consists of an open circle at $-2$ and an arrow to the left.\n\n- the inequality $x \\geq 1$ consists of a closed circle at $1$ and an arrow to the right.\n\nThe resulting graph is as follows:\n\n![](images/a1/a1067762a65fca32ca847a58dd47b07258f4ce58df20e45435df8a0a9e5d6f90.png)" :db/ensure [:question/validate]} {:db/id 17592186138537 :knowledge-point/questions ["question-fecedee9-3a13-5fd5-818f-649e22887a19" "question-322d7cc1-ec63-5690-b8ff-cb69089ad748"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138075 :question/worked-solution "The red rays contain all values less than $-4$ or greater than $-1.$ In addition, \n\n- the open circle at $-4$ implies that $x$ cannot be equal to $-4,$ and\n\n- the closed circle at $-1$ implies that $x$ can be equal to $-1.$\n\nTherefore, the highlighted region represents $x <    -4$ or $x \\geq -1.$" :db/ensure [:question/validate]} {:db/id 17592186138538 :knowledge-point/questions ["question-a3a4f7e6-baa5-55ec-a1d3-42158ee1abc0"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138074 :question/worked-solution "The red segment contains all values between  $-2$ and $0.$ In addition,\n\n- the closed circle at $-2$ implies that $x$ can be equal to $-2,$ while\n\n- the open circle at $0$ implies that $x$ cannot be equal to $0.$\n\nTherefore, the highlighted region represents $-2 \\leq  x <    0.$" :db/ensure [:question/validate]} {:db/id 17592186138539 :knowledge-point/questions ["question-7acb590f-26ef-56eb-bc17-cd672b435fa9" "question-4c6aaf3a-5087-5971-9f06-dcb66d6db1fe"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138076 :question/worked-solution "The red segment contains all values between  $-2$ and $\\dfrac{3}{2}.$ In addition,\n\n- the closed circle at $-2$ implies that $x$ can be equal to $-2,$ while\n\n- the closed circle at $\\dfrac32$ implies that $x$ can be equal to $\\dfrac32.$\n\nTherefore, the highlighted region represents  $-2 \\bbox[3pt,Gainsboro]{\\color{blue} \\leq }  x \\bbox[3pt,Gainsboro]{\\color{blue} \\leq }  \\dfrac32 .$" :db/ensure [:question/validate]} {:db/id "question-f3147df7-04f3-51f7-bd72-80ab17bf146c" :question/id #uuid "f3147df7-04f3-51f7-bd72-80ab17bf146c" :question/math-academy-id "q-28806" :question/problem "Which of the following number lines represents the inequality $x\\le 0$ or $x>\\frac{11}{5}?$" :question/worked-solution "The inequality $x\\le 0$ or $x>\\frac{11}{5}$ means that $x$ can take any value less than or equal to $0,$ or greater than  $\\frac{11}{5}.$\n\nTo represent this on a number line, we graph the two separate inequalities:\n\n- the inequality $x\\le 0$ consists of a closed circle at $0$ and an arrow to the left.\n\n- the inequality $x>\\frac{11}{5}$ consists of an open circle at $\\frac{11}{5}$ and an arrow to the right.\n\nThe resulting graph is as follows:\n\n![](images/32/32b854cb4bfa0e9d92e044c22275f9ad7c830f621507ee17838d00f650cfe713.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b7510e86-03d4-5530-a18e-bcffd6dd92e8"] :db/ensure [:question/validate]} {:db/id "answer-field-b7510e86-03d4-5530-a18e-bcffd6dd92e8" :answer-field/id #uuid "b7510e86-03d4-5530-a18e-bcffd6dd92e8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fe5bd498-89ce-5b3a-a346-20beb4b6e79b" :answer-field/choices ["answer-082c1ab0-8e73-591d-8757-8fbc99782912" "answer-ac6d34e8-5704-5b65-91e4-21e9a7f9b2ea" "answer-fdd68c63-8e53-5ab3-bd3d-79