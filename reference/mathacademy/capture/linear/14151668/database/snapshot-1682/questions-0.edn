#{[{:db/id #edb/ref 17592186138073 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138536 :knowledge-point/id #uuid "6090342d-3d4e-519f-ab7d-3fb6df6e92a8" :knowledge-point/title "Representing \"Or\" Inequalities on Number Lines"}] :question/id #uuid "014723fc-0b7d-5212-a41e-73847f5adb00" :question/math-academy-id "e-13011" :question/problem "Represent the inequality $x < -2$ or $x \\geq 1$ on a number line." :question/worked-solution "The inequality $x < -2$ or\n\n$$\nx \\geq 1\n$$\n\nmeans that $x$ can take any value less than $-2$, or greater than or equal to $1$.\n\nTo represent this on a number line, we graph the two separate inequalities:\n\n- the inequality $x < -2$ consists of an open circle at $-2$ and an arrow to the left.\n- the inequality $x \\geq 1$ consists of a closed circle at $1$ and an arrow to the right.\n\nThe resulting graph is as follows:\n\n![](images/a1/a1067762a65fca32ca847a58dd47b07258f4ce58df20e45435df8a0a9e5d6f90.png)"}] [{:db/id #edb/ref 17592186138074 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138538 :knowledge-point/id #uuid "9106723c-b8b0-586e-8c2b-9bb4f50bc945" :knowledge-point/title "Representing \"And\" Inequalities on Number Lines"}] :question/id #uuid "21eace75-0b5a-5b37-903c-c238e3821bee" :question/math-academy-id "e-13012" :question/problem "![](images/b4/b4906893158bb5dc9f55363dcf2edc2ae1d30d8acff7121041d4a849ee73cbce.png)\n\nWhat inequality corresponds to the highlighted region shown on the number line above?" :question/worked-solution "The red segment contains all values between $-2$ and $0$. In addition,\n\n- the closed circle at $-2$ implies that $x$ can be equal to $-2$, while\n- the open circle at $0$ implies that $x$ cannot be equal to $0$.\n\nTherefore, the highlighted region represents\n\n$$\n-2 \\leq x < 0\n$$"}] [{:db/id #edb/ref 17592186138075 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138537 :knowledge-point/id #uuid "32daa2fb-e5fa-5e44-b6f2-5d815d9145af" :knowledge-point/title "Identifying \"Or\" Inequalities Given on Number Lines"}] :question/id #uuid "e5b6a9dc-3a19-5496-9e22-d953ff4eb647" :question/math-academy-id "e-13018" :question/problem "![](images/7a/7ae1311495d3fcb290bdf3f4b303224415e2e55c5ae1af8a82efd1f3aa2572b4.png)\n\nWhich inequality corresponds to the highlighted region shown on the number line above?" :question/worked-solution "The red rays contain all values less than $-4$ or greater than $-1$. In addition,\n\n- the open circle at $-4$ implies that $x$ cannot be equal to $-4$, and\n- the closed circle at $-1$ implies that $x$ can be equal to $-1$.\n\nTherefore, the highlighted region represents $x < -4$ or\n\n$$\nx \\geq -1\n$$"}] [{:db/id #edb/ref 17592186138076 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138539 :knowledge-point/id #uuid "a707a741-0208-5a74-8478-ac05ff2673ab" :knowledge-point/title "Identifying \"And\" Inequalities Given on Number Lines"}] :question/id #uuid "347520ff-e759-5d99-acf7-0bc8a8f26689" :question/math-academy-id "e-13019" :question/problem "![](images/f7/f7a8d632deb19af6f7efc30182fb349f766c3ca7c10ba6567f9e2fd2e02e4b07.png)\n\nWhich inequality corresponds to the highlighted region shown on the number line above?" :question/worked-solution "The red segment contains all values between $-2$ and\n\n$$\n\\dfrac{3}{2}\n$$\n\nIn addition,\n\n- the closed circle at $-2$ implies that $x$ can be equal to $-2$, while\n- the closed circle at $\\dfrac32$ implies that $x$ can be equal to $\\dfrac32$.\n\nTherefore, the highlighted region represents\n\n$$\n-2 \\bbox[3pt,Gainsboro]{\\color{blue} \\leq} x \\bbox[3pt,Gainsboro]{\\color{blue} \\leq} \\dfrac32\n$$"}] [{:db/id #edb/ref 17592186138765 :knowledge-point/_questions [{:db/id #edb/ref 17592186138538 :knowledge-point/id #uuid "9106723c-b8b0-586e-8c2b-9bb4f50bc945" :knowledge-point/title "Representing \"And\" Inequalities on Number Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b1259fe-754a-55ec-8186-dbbb9785d5c7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/56/565afdc34f8d9e0bfa9f9d9055ea73714c32d407ca58f6813521e91987435e5c.png" :db/id #edb/ref 17592186135544} {:answer/id #uuid "021c115e-cb29-52d4-8b0c-09d16f6028d0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/38/38d92d3d33be670bbec81491763f2f07f3d23421d7a18d6a7b6eaa861ad41d31.png" :db/id #edb/ref 17592186135545} {:answer/id #uuid "0560d64d-8970-57dd-9ae4-0ff19e255bb6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/96/9640deed2957172b07980523ae9138008cea2e4b0d002a68c978ef3a0a8d9cd1.png" :db/id #edb/ref 17592186135546} {:answer/id #uuid "187659a2-4a24-5270-a264-b67a427dea2c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8b/8bc7a001552fe3467c6a1c6868a49e716a45834568af33ee9262d3cbf92a8306.png" :db/id #edb/ref 17592186135547} {:answer/id #uuid "45b2a9ec-8915-5131-9da5-f4ada09351f0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2b/2b246b87885e5e3c96ea5a456f33707946f736df50890f0cc41165820f0fc326.png" :db/id #edb/ref 17592186135548}] :answer-field/id #uuid "b79b7070-a456-54ed-ad29-b297b8754d5a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186135543}] :question/id #uuid "aa7c23fc-fad6-52a8-9ad0-2150286ddf9e" :question/math-academy-id "q-25698" :question/problem "How is the inequality $-2 \\le x < 2$ represented on a number line?"}]}
