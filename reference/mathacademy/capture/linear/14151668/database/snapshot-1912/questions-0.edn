er-field/id #uuid "b7510e86-03d4-5530-a18e-bcffd6dd92e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186447244}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f3147df7-04f3-51f7-bd72-80ab17bf146c" :question/math-academy-id "q-28806" :question/problem "Which of the following number lines represents the inequality $x\\le 0$ or $x>\\frac{11}{5}?$" :question/worked-solution "The inequality $x\\le 0$ or $x>\\frac{11}{5}$ means that $x$ can take any value less than or equal to $0,$ or greater than  $\\frac{11}{5}.$\n\nTo represent this on a number line, we graph the two separate inequalities:\n\n- the inequality $x\\le 0$ consists of a closed circle at $0$ and an arrow to the left.\n\n- the inequality $x>\\frac{11}{5}$ consists of an open circle at $\\frac{11}{5}$ and an arrow to the right.\n\nThe resulting graph is as follows:\n\n![](images/32/32b854cb4bfa0e9d92e044c22275f9ad7c830f621507ee17838d00f650cfe713.png)"}] [{:db/id #edb/ref 17592186447249 :knowledge-point/_questions [{:db/id #edb/ref 17592186138539 :knowledge-point/id #uuid "a707a741-0208-5a74-8478-ac05ff2673ab" :knowledge-point/title "Identifying \"And\" Inequalities Given on Number Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1acf19ca-e1ca-52d2-a28d-44666d70c49b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<-1$ or  $x>4$" :db/id #edb/ref 17592186447217} {:answer/id #uuid "5225eda9-90f4-5021-862a-16c2df28136c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x\\le -1$ or $x\\ge 4$" :db/id #edb/ref 17592186447221} {:answer/id #uuid "6338b55b-e48b-5949-b4d5-24206f357d11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1\\le x\\le 4" :db/id #edb/ref 17592186447224} {:answer/id #uuid "885b3826-1efb-5a7d-9b94-65d6791601e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1<x<4" :db/id #edb/ref 17592186447227} {:answer/id #uuid "b670a909-c2f8-5e96-8301-2086b25995f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1>x>4" :db/id #edb/ref 17592186447231}] :answer-field/correct {:answer/id #uuid "6338b55b-e48b-5949-b4d5-24206f357d11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1\\le x\\le 4" :db/id #edb/ref 17592186447224} :answer-field/id #uuid "9209c1da-7a51-5b49-93d6-ed78aa06adc3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186447240}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7acb590f-26ef-56eb-bc17-cd672b435fa9" :question/math-academy-id "q-54811" :question/problem "![](images/2a/2ac03455fb1b259e0f31719c613d9f7c3adb50b7d8e96667514abb7c513ed0e3.png)\n\nWhich inequality corresponds to the highlighted region shown on the number line above?" :question/worked-solution "The red segment contains all values between  $-1$ and $4.$ In addition,\n\n- the closed circle at $-1$ implies that $x$ can be equal to $-1,$ while\n\n- the closed circle at $4$ implies that $x$ can be equal to $4.$\n\nTherefore, the highlighted region represents  $-1\\le x\\le 4.$"}] [{:db/id #edb/ref 17592186447250 :knowledge-point/_questions [{:db/id #edb/ref 17592186138538 :knowledge-point/id #uuid "9106723c-b8b0-586e-8c2b-9bb4f50bc945" :knowledge-point/title "Representing \"And\" Inequalities on Number Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ffbefb9-b444-5dc0-9cde-2b9b8e723e45" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f6/f67a6123a1028f9ced155b4752d11b2c3b40b6b4c367e7edbdb795cff294409d.png" :db/id #edb/ref 17592186447