#{[{:db/id #edb/ref 17592186535959 :knowledge-point/_questions [{:db/id #edb/ref 17592186083167 :knowledge-point/id #uuid "8bff4063-9e51-53fa-ab55-e68540e6f587" :knowledge-point/title "Evaluating an Expression Given the Table for an Even or Odd Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c2efd2b-f00a-593f-bb81-c9dd053ed073" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186535626} {:answer/id #uuid "bb33137b-01b7-5b1b-99cc-1a5450ea9b72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186535723} {:answer/id #uuid "ca604a35-1898-54ea-be79-3d86d2c26139" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186535739} {:answer/id #uuid "da8a3e87-40ac-5983-bfbe-cf585598fdf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186535768} {:answer/id #uuid "e5951a84-f04c-5c6f-9a06-d5001b3dda61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186535786}] :answer-field/correct {:answer/id #uuid "ca604a35-1898-54ea-be79-3d86d2c26139" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186535739} :answer-field/id #uuid "987364e2-83c5-563b-a86c-5c9e8d2fcffd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535885}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "71f2cfbf-31cb-5074-ba4b-cb4c0df22324" :question/math-academy-id "q-110665" :question/problem "The table below defines the function $f(x).$ Given that $f(x)$ is an even function, find the value of $a+b.$\n\n| **$x$** | $-90$ | $-65$ | $-40$ | $40$ | $65$ | $90$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $16$ | $b-2$ | $-8$ | $-8$ | $-1$ | $a+6$ |" :question/worked-solution "Since $f(x)$ is an even function, we must have that $f(-x)=f(x).$ \n\nUsing the fact that $f(-90)=f(90),$ we obtain\n\n$$\n\\begin{aligned}f(-90) & =f(90) \\\\ 16 & =a+6 \\\\ a & =10.\\end{aligned}\n$$\n\nUsing the fact that $f(-65)=f(65),$ we obtain\n\n$$\n\\begin{aligned}f(-65) & =f(65) \\\\ b-2 & =-1 \\\\ b & =1.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b=10+1=11.\n$$"}] [{:db/id #edb/ref 17592186083675 :knowledge-point/_questions [{:db/id #edb/ref 17592186083167 :knowledge-point/id #uuid "8bff4063-9e51-53fa-ab55-e68540e6f587" :knowledge-point/title "Evaluating an Expression Given the Table for an Even or Odd Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8655fcd4-4c8b-57b7-9496-b042577adad0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186080982} {:answer/id #uuid "078e8bdf-610e-5d6f-bec2-f28e3aa5ea64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186080983} {:answer/id #uuid "0e699b69-a4eb-599a-bb71-823303466e99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186080984} {:answer/id #uuid "55b58e9d-e155-5967-9343-0ad0053d6a8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186080985} {:answer/id #uuid "68e3fdda-7135-59c5-acdf-a679759b65ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186080986}] :answer-field/correct {:answer/id #uuid "078e8bdf-610e-5d6f-bec2-f28e3aa5ea64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186080983} :answer-field/id #uuid "5abfecb6-3973-5d80-b497-dd0ac1014593" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186080981}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8685c18f-3b3e-5a81-8a52-9c0ab8ac96f4" :question/math-academy-id "q-36592" :question/problem "The table below defines the function $f(x).$ Given that $f(x)$ is an even function, find the value of $a+b.$\n\n| **$x$** | $-23$ | $-15$ | $-7$ | $7$ | $15$ | $23$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $a+5$ | $-\\sqrt{2}$ | $b+1$ | $4$ | $-\\sqrt{2}$ | $6$ |" :question/worked-solution "Since $f(x)$ is an even function, we must have that $f(-x)=f(x).$ \n\nUsing the fact that $f(-23)=f(23),$ we obtain\n\n$$\n\\begin{aligned}f(-23) & =f(23) \\\\ a+5 & =6 \\\\ a & =1.\\end{aligned}\n$$\n\nUsing the fact that $f(-7)=f(7),$ we obtain\n\n$$\n\\begin{aligned}f(-7) & =f(7) \\\\ b+1 & =4 \\\\ b & =3.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b=1+3=4.\n$$"}] [{:db/id #edb/ref 17592186083894 :knowledge-point/_questions [{:db/id #edb/ref 17592186083185 :knowledge-point/id #uuid "4fa847d9-f0bf-57fb-92b2-27c8a7cdb3b1" :knowledge-point/title "Classifying Even and Odd Functions Using the Algebraic Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b087c98d-eb7c-5ce5-82c7-979c21323672" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "It's not a function" :db/id #edb/ref 17592186082296} {:answer/id #uuid "d83acd8e-fca2-5275-988a-6b470f499acb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Even" :db/id #edb/ref 17592186082297} {:answer/id #uuid "039f1f39-8490-577c-8657-6a91decc92dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Both even and odd" :db/id #edb/ref 17592186082298} {:answer/id #uuid "5fa40858-bb4e-5eb9-98c9-f905f338e539" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Neither even nor odd" :db/id #edb/ref 17592186082299} {:answer/id #uuid "5fdc40a8-1125-5cd9-87f6-7f51bdd2283e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Odd" :db/id #edb/ref 17592186082300}] :answer-field/correct {:answer/id #uuid "d83acd8e-fca2-5275-988a-6b470f499acb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Even" :db/id #edb/ref 17592186082297} :answer-field/id #uuid "a88af808-6d41-5393-8859-9acb647cc2cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186082295}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b5078528-4e53-5684-a818-c4b067e4dfab" :question/math-academy-id "q-6684" :question/problem "Is the function $f(x)=\\frac{1}{{x}^{2}}$, for $x\\ne 0$, even, odd, or neither?" :question/worked-solution "Remember that\n\n- a function is even if $f(-x)=f(x)$ for all $x,$ while\n\n- a function is odd if $f(-x)=-f(x)$ for all $x.$\n\nComputing $f(-x)$ for the given function and comparing it to $f(x),$ we have\n\n$$\n\\begin{aligned}f(-x) & =\\frac{1}{(-x)^{2}} \\\\  & =\\frac{1}{{x}^{2}}.\\end{aligned}\n$$\n\nSince $f(-x)=f(x),$ the function is even.\n\nLastly, we compute $-f(x)$ and get\n\n$$\n\\begin{aligned}-f(x) & =-(\\frac{1}{{x}^{2}}) \\\\  & =-\\frac{1}{{x}^{2}}.\\end{aligned}\n$$\n\nSince $f(-x)\\ne -f(x),$ the function is not odd.\n\nTherefore, the function is only even."}] [{:db/id #edb/ref 17592186535936 :knowledge-point/_questions [{:db/id #edb/ref 17592186083185 :knowledge-point/id #uuid "4fa847d9-f0bf-57fb-92b2-27c8a7cdb3b1" :knowledge-point/title "Classifying Even and Odd Functions Using the Algebraic Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ba8a60b-baa6-5af0-9686-d3d8e8a4a09b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Both even and odd" :db/id #edb/ref 17592186535456} {:answer/id #uuid "781a4eaa-66ed-5f45-b66c-ceb488944744" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Neither Even nor Odd" :db/id #edb/ref 17592186535619} {:answer/id #uuid "790f62a9-5b85-5ad8-99aa-12b309ae3d94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Odd" :db/id #edb/ref 17592186535621} {:answer/id #uuid "f31eab5d-3671-5f28-812a-1245b40e2a75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "It's not a function" :db/id #edb/ref 17592186535808} {:answer/id #uuid "f9addbd9-40e1-582a-8e8e-69659487f294" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Even" :db/id #edb/ref 17592186535819}] :answer-field/correct {:answer/id #uuid "790f62a9-5b85-5ad8-99aa-12b309ae3d94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Odd" :db/id #edb/ref 17592186535621} :answer-field/id #uuid "7744ee0a-5590-5bee-b223-157ef8ebf071" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535872}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1b73902c-ad8b-52f6-bdea-d56e526c20d4" :question/math-academy-id "q-72131" :question/problem "Is the function $f(x)=6x$ even, odd, or neither?" :question/worked-solution "Recall that\n\n- a function is even if $f(-x)=f(x)$ for all $x$\n\n- a function is odd if $f(-x)=-f(x)$ for all $x$\n\nComputing $f(-x)$ for the given function and comparing it to $f(x),$ we have\n\n$$\n\\begin{aligned}f(-x) & =6(-x) \\\\  & =-6x\\end{aligned}\n$$\n\nSince $f(-x)\\ne f(x),$ the function is not even. \n\nLastly, we compute $-f(x)$ and get\n\n$$\n\\begin{aligned}-f(x) & =-(6x) \\\\  & =-6x\\end{aligned}\n$$\n\nSince $f(-x)=-f(x),$ the function is odd."}] [{:db/id #edb/ref 17592186536004 :knowledge-point/_questions [{:db/id #edb/ref 17592186083166 :knowledge-point/id #uuid "8d887d9f-b9c4-54b3-a53e-691989bda962" :knowledge-point/title "Classifying Odd Functions Graphically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24bae23a-2b5c-5549-8d74-d4e7ed7715fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186535492} {:answer/id #uuid "4c5799db-521f-5c06-9242-e01b2fe426b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III and IV only" :db/id #edb/ref 17592186535548} {:answer/id #uuid "6b569b29-0310-5803-aa5e-5c8b3097fb67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186535602} {:answer/id #uuid "9a658323-9478-5cd3-bbe5-ee65e87c40c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186535679} {:answer/id #uuid "a4de91ac-6edf-528c-8e95-7ba1adfbf5b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186535691}] :answer-field/correct {:answer/id #uuid "9a658323-9478-5cd3-bbe5-ee65e87c40c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186535679} :answer-field/id #uuid "bd416d50-8739-51d0-a2e4-b34b56fbb8eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535903}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f2ca34f0-80b3-509b-af1e-131cf84ebf9f" :question/math-academy-id "q-72703" :question/problem "![](images/d4/d4cf4f9e1cc145154e5f542a5064b51d6385e7f81d12c7187dff436f5e7e10f9.png)\n\nWhich of the above could be graphs of odd functions?" :question/worked-solution "Recall that the graph of an odd function must have rotational symmetry of order $2$ about the origin.\n\n- Graphs II and III do not have rotational symmetry of order $2$ about the origin. So, they are **not** odd functions.\n\n- On the other hand, graphs I and IV do have rotational symmetry about the origin. If we rotate the graphs ${180}^{∘}$ around the origin, we get the same pictures. This means that graphs I and IV show odd functions.\n\n![](images/60/60a38abf4723f137ef0f824613ab15282c9ff5e3098fac13173630baef577e45.png)\n\nTherefore, the correct answer is \"I and IV only.\""}]}
