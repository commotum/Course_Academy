8 #edb/ref 17592186519539 #edb/ref 17592186045417] [17592186083185 #edb/ref 1038 #edb/ref 17592186535936 #edb/ref 17592186045417] [17592186083185 #edb/ref 1039 "Classifying Even and Odd Functions Using the Algebraic Definition" #edb/ref 17592186045417] [17592186083185 #edb/ref 1041 #edb/ref 17592186082993 #edb/ref 17592186045417] [17592186083185 #edb/ref 1042 #uuid "4fa847d9-f0bf-57fb-92b2-27c8a7cdb3b1" #edb/ref 17592186045417] [17592186083420 #edb/ref 1043 #edb/ref 17592186084017 #edb/ref 17592186045417] [17592186083420 #edb/ref 1043 #edb/ref 17592186084018 #edb/ref 17592186045417] [17592186083420 #edb/ref 1043 #edb/ref 17592186084019 #edb/ref 17592186045417] [17592186083420 #edb/ref 1043 #edb/ref 17592186084020 #edb/ref 17592186045417] [17592186083420 #edb/ref 1043 #edb/ref 17592186084049 #edb/ref 17592186045417] [17592186083420 #edb/ref 1043 #edb/ref 17592186084050 #edb/ref 17592186045417] [17592186083420 #edb/ref 1043 #edb/ref 17592186084051 #edb/ref 17592186045417] [17592186083420 #edb/ref 1043 #edb/ref 17592186084052 #edb/ref 17592186045417] [17592186083420 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186083420 #edb/ref 1045 "Even and Odd Functions" #edb/ref 17592186045417] [17592186083420 #edb/ref 1046 #edb/ref 17592186084017 #edb/ref 17592186045417] [17592186083420 #edb/ref 1049 #edb/ref 17592186049873 #edb/ref 17592186045417] [17592186083420 #edb/ref 1050 480.0 #edb/ref 17592186045417] [17592186083420 #edb/ref 1053 #uuid "f95be382-38ca-5542-bef3-419ba331df88" #edb/ref 17592186045417] [17592186083675 #edb/ref 1068 #edb/ref 17592186080981 #edb/ref 17592186045417] [17592186083675 #edb/ref 1069 "q-36592" #edb/ref 17592186045417] [17592186083675 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186083675 #edb/ref 1071 "The table below defines the function $f(x).$ Given that $f(x)$ is an even function, find the value of $a+b.$\n\n| **$x$** | $-23$ | $-15$ | $-7$ | $7$ | $15$ | $23$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $a+5$ | $-\\sqrt{2}$ | $b+1$ | $4$ | $-\\sqrt{2}$ | $6$ |" #edb/ref 17592186045417] [17592186083675 #edb/ref 1072 #uuid "8685c18f-3b3e-5a81-8a52-9c0ab8ac96f4" #edb/ref 17592186045417] [17592186083675 #edb/ref 1074 "Since $f(x)$ is an even function, we must have that $f(-x)=f(x).$ \n\nUsing the fact that $f(-23)=f(23),$ we obtain\n\n$$\n\\begin{aligned}f(-23) & =f(23) \\\\ a+5 & =6 \\\\ a & =1.\\end{aligned}\n$$\n\nUsing the fact that $f(-7)=f(7),$ we obtain\n\n$$\n\\begin{aligned}f(-7) & =f(7) \\\\ b+1 & =4 \\\\ b & =3.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b=1+3=4.\n$$" #edb/ref 17592186045417] [17592186083894 #edb/ref 1068 #edb/ref 17592186082295 #edb/ref 17592186045417] [17592186083894 #edb/ref 1069 "q-6684" #edb/ref 17592186045417] [17592186083894 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186083894 #edb/ref 1071 "Is the function $f(x)=\\frac{1}{{x}^{2}}$, for $x\\ne 0$, even, odd, or neither?" #edb/ref 17592186045417] [17592186083894 #edb/ref 1072 #uuid "b5078528-4e53-5684-a818-c4b067e4dfab" #edb/ref 17592186045417] [17592186083894 #edb/ref 1074 "Remember that\n\n- a function is even if $f(-x)=f(x)$ for all $x,$ while\n\n- a function is odd if $f(-x)=-f(x)$ for all $x.$\n\nComputing $f(-x)$ for the given function and comparing it to $f(x),$ we have\n\n$$\n\\begin{aligned}f(-x) & =\\frac{1}{(-x)^{2}} \\\\  & =\\frac{1}{{x}^{2}}.\\end{aligned}\n$$\n\nSince $f(-x)=f(x),$ the function is even.\n\nLastly, we compute $-f(x)$ and get\n\n$$\n\\begin{aligned}-f(x) & =-(\\frac{1}{{x}^{2}}) \\\\  & =-\\frac{1}{{x}^{2}}.\\end{aligned}\n$$\n\nSince $f(-x)\\ne -f(x),$ the function is not odd.\n\nTherefore, the function is only even." #edb/ref 17592186045417] [17592186084017 #edb/ref 1058 #edb/ref 17592186084049 #edb/ref 17592186045417] [17592186084017 #edb/ref 1061 14086 #edb/ref 17592186045417] [17592186084017 #edb/ref 1062 #uuid "2819e00a-c45a-50f1-a7ea-e3637612c182" #edb/ref 17592186045417] [17592186084017 #edb/ref 1063 #edb/ref 17592186084422 #edb/ref 17592186045417] [17592186084018 #edb/ref 1058 #edb/ref 17592186084019 #edb/ref 17592186045417] [17592186084018 #edb/ref 1061 14088 #edb/ref 17592186045417] [17592186084018 #edb/ref 1062 #uuid "c9f1a487-6342-5b97-86bc-81ffa4a8d287" #edb/ref 17592186045417] [17592186084018 #edb/ref 1063 #edb/ref 17592186083166 #edb/ref 17592186045417] [17592186084019 #edb/ref 1058 #edb/ref 17592186084051 #edb/ref 17592186045417] [17592186084019 #edb/ref 1061 14090 #edb/ref 17592186045417] [17592186084019 #edb/ref 1062 #uuid "95f32820-f0d3-5c90-856a-b03f017bb399" #edb/ref 17592186045417] [17592186084019 #edb/ref 1063 #edb/ref 17592186084423 #edb/ref 17592186045417] [17592186084020 #edb/ref 1061 14091 #edb/ref 17592186045417] [17592186084020 #edb/ref 1062 #uuid "6f3a0616-90b9-5a24-8eb2-82152eed463a" #edb/ref 17592186045417] [17592186084020 #edb/ref 1063 #edb/ref 17592186083167 #edb/ref 17592186045417] [17592186084049 #edb/ref 1058 #edb/ref 17592186084050 #edb/ref 17592186045417] [17592186084049 #edb/ref 1061 15131 #edb/ref 17592186045417] [17592186084049 #edb/ref 1062 #uuid "8c6a848e-062e-550a-98cc-a5b33fc8efb8" #edb/ref 17592186045417] [17592186084049 #edb/ref 1063 #edb/ref 17592186083184 #edb/ref 17592186045417] [17592186084050 #edb/ref 1058 #edb/ref 17592186084018 #edb/ref 17592186045417] [17592186084050 #edb/ref 1061 15132 #edb/ref 17592186045417] [17592186084050 #edb/ref 1062 #uuid "e25c1d87-8e4c-58bc-98db-694f2852ceb3" #edb/ref 17592186045417] [17592186084050 #edb/ref 1063 #edb/ref 17592186084430 #edb/ref 17592186045417] [17592186084051 #edb/ref 1058 #edb/ref 17592186084052 #edb/ref 17592186045417] [17592186084051 #edb/ref 1061 15142 #edb/ref 17592186045417] [17592186084051 #edb/ref 1062 #uuid "46e959d5-c850-58b6-aabc-e6143b9e3a64" #edb/ref 17592186045417] [17592186084051 #edb/ref 1063 #edb/ref 17592186084431 #edb/ref 17592186045417] [17592186084052 #edb/ref 1058 #edb/ref 17592186084020 #edb/ref 17592186045417] [17592186084052 #edb/ref 1061 15151 #edb/ref 17592186045417] [17592186084052 #edb/ref 1062 #uuid "b60bbea3-5236-5bc1-93fe-54234cf0b4fb" #edb/ref 17592186045417] [17592186084052 #edb/ref 1063 #edb/ref 17592186083185 #edb/ref 17592186045417] [17592186084422 #edb/ref 1064 "A function is said to be an **even function** if it is symmetric about the $y$-axis.\n\nFor example, the function \n\n$$\nf(x) = x^2,\n$$\n\nwhose graph is depicted below, is an example of an even function. It is symmetric about the $y$-axis, meaning that if we reflect the graph over the $y$-axis, we get the same picture.\n\n![](images/cf/cfca345c7ca094cacdbc6d7141a09e34fd116c677629a6a4c1917fb0db1f753f.png)" #edb/ref 17592186045417] [17592186084422 #edb/ref 1065 2774 #edb/ref 17592186045417] [17592186084422 #edb/ref 1066 #uuid "263b7003-1ee6-55aa-94cd-5ee25cbf63a4" #edb/ref 17592186045417] [17592186084422 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186084423 #edb/ref 1064 "Recall that the graph of the even function $f(x) = x^2$ is symmetric about the $y$-axis.\n\n![](images/07/07d0699c46b3cbd215c461d5df3629d86cd31a93228d6790fdc65b383e8556fc.png)\n\nNotice the following:\n\n$$\n\\begin{aligned}f(-1) & =1=f(1) \\\\ f(-2) & =4=f(2) \\\\ f(-3) & =9=f(3) \\\\  & \\,\\,\\,⋮\\end{aligned}\n$$\n\nSo, for every $x$ in the domain, both $x$ and $-x$ give the same value of the function. Algebraically, this fact can be written as follows: $f(-x) = f(x).$\n\nIn general, a function $f(x)$ is said to be **even** if\n\n$$\nf(-x) = f(x)\n$$\n\n \nfor each $x$ in the domain of the function." #edb/ref 17592186045417] [17592186084423 #edb/ref 1065 2776 #edb/ref 17592186045417] [17592186084423 #edb/ref 1066 #uuid "4c7a0bb9-4765-505f-a538-dd4a1426f8c3" #edb/ref 17592186045417] [17592186084423 #edb/ref 1067 "The Algebraic Definition of Even Functions" #edb/ref 17592186045417] [17592186084430 #edb/ref 1064 "A function is said to be an **odd function** if it has **rotational symmetry of order $2$ about the origin**. That is to say, if we rotate the graph of an odd function by $180^\\circ$ about the origin, we end up with the same picture.\n\nFor example, the function\n\n$$\ng(x)=x,\n$$\n\nwhose graph is shown below, is an example of an odd function. It has rotational symmetry of order $2$ about the origin, meaning that if we rotate the graph of an odd function by $180^\\circ$ about the origin, we end up with the same picture.\n\n![](images/ff/ff49c826d9a6a36b35edf73689d30e5d9dadc976b5f1caf47c1dd0383f9893bc.png)" #edb/ref 17592186045417] [17592186084430 #edb/ref 1065 2840 #edb/ref 17592186045417] [17592186084430 #edb/ref 1066 #uuid "1184d837-2701-5c4d-806c-6af72dee583b" #edb/ref 17592186045417] [17592186084430 #edb/ref 1067 "Classifying Odd Functions Graphically" #edb/ref 17592186045417] [17592186084431 #edb/ref 1064 "Now, recall that the graph of the odd function $g(x)=x$ has rotational symmetry of order $2$ about the origin.\n\n![](images/a0/a0dd6a5cbc09182a4a87569879a97da697a21eeda869ae20f512dc86a911b75e.png)\n\nNotice the following:\n\n$$\n\\begin{aligned}f(-1) & =-1=-f(1) \\\\ f(-2) & =-2=-f(2) \\\\ f(-3) & =-3=-f(3) \\\\  & \\,\\,\\,\\,\\,⋮\\end{aligned}\n$$\n\nSo, for every $x$ in the domain, $x$ and $-x$ give opposite values of the function. Algebraically, this fact can be written as $f(-x) = -f(x).$\n\nIn general, a function $f(x)$ is said to be **odd** if\n\n$$\nf(-x) = -f(x)\n$$\n\n \nfor each $x$ in the domain of the function." #edb/ref 17592186045417] [17592186084431 #edb/ref 1065 2844 #edb/ref 17592186045417] [17592186084431 #edb/ref 1066 #uuid "db19e6ba-49d7-534c-b84b-24dfd8866658" #edb/ref 17592186045417] [17592186084431 #edb/ref 1067 "The Algebraic Definition of Odd Functions" #edb/ref 17592186045417] [17592186535434 #edb/ref 1043 #edb/ref 17592186536041 #edb/ref 17592186045417] [17592186535434 #edb/ref 1043 #edb/ref 17592186536044 #edb/ref 17592186045417] [17592186535434 #edb/ref 1043 #edb/ref 17592186536046 #edb/ref 17592186045417] [17592186535434 #edb/ref 1043 #edb/ref 17592186536047 #edb/ref 17592186045417] [17592186535434 #edb/ref 1043 #edb/ref 17592186536051 #edb/ref 17592186045417] [17592186535434 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186535434 #edb/ref 1045 "Even and Odd Functions" #edb/ref 17592186045417] [17592186535434 #edb/ref 1046 #edb/ref 17592186536044 #edb/ref 17592186045417] [17592186535434 #edb/ref 1048 #edb/ref 17592186046647 #edb/ref 17592186045417] [17592186535434 #edb/ref 1049 #edb/ref 17592186049873 #edb/ref 17592186045417] [17592186535434 #edb/ref 1053 #uuid "f7531106-8081-593d-b221-3db6da6b1b3b" #edb/ref 17592186045417] [17592186535456 #edb/ref 1080 "Both even and odd" #edb/ref 17592186045417] [17592186535456 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186535456 #edb/ref 1083 #uuid "0ba8a60b-baa6-5af0-9686-d3d8e8a4a09b" #edb/ref 17592186045417] [17592186535492 #edb/ref 1080 "I and III only" #edb/ref 17592186045417] [17592186535492 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186535492 #edb/ref 1083 #uuid "24bae23a-2b5c-5549-8d74-d4e7ed7715fd" #edb/ref 17592186045417] [17592186535548 #edb/ref 1080 "III and IV only" #edb/ref 17592186045417] [17592186535548 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186535548 #edb/ref 1083 #uuid "4c5799db-521f-5c06-9242-e01b2fe426b4" #edb/ref 17592186045417] [17592186535602 #edb/ref 1080 "I and II only" #edb/ref 17592186045417] [17592186535602 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186535602 #edb/ref 1083 #uuid "6b569b29-0310-5803-aa5e-5c8b3097fb67" #edb/ref 17592186045417] [17592186535619 #edb/ref 1080 "Neither Even nor Odd" #edb/ref 17592186045417] [17592186535619 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186535619 #edb/ref 1083 #uuid "781a4eaa-66ed-5f45-b66c-ceb488944744" #edb/ref 17592186045417] [17592186535621 #edb/ref 1080 "Odd" #edb/ref 17592186045417] [17592186535621 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [1759