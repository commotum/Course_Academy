28-812a-1245b40e2a75" #edb/ref 17592186045417] [17592186535819 #edb/ref 1080 "Even" #edb/ref 17592186045417] [17592186535819 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186535819 #edb/ref 1083 #uuid "f9addbd9-40e1-582a-8e8e-69659487f294" #edb/ref 17592186045417] [17592186535872 #edb/ref 1075 #edb/ref 17592186535456 #edb/ref 17592186045417] [17592186535872 #edb/ref 1075 #edb/ref 17592186535619 #edb/ref 17592186045417] [17592186535872 #edb/ref 1075 #edb/ref 17592186535621 #edb/ref 17592186045417] [17592186535872 #edb/ref 1075 #edb/ref 17592186535808 #edb/ref 17592186045417] [17592186535872 #edb/ref 1075 #edb/ref 17592186535819 #edb/ref 17592186045417] [17592186535872 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186535872 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186535872 #edb/ref 1078 #edb/ref 17592186535621 #edb/ref 17592186045417] [17592186535872 #edb/ref 1079 #uuid "7744ee0a-5590-5bee-b223-157ef8ebf071" #edb/ref 17592186045417] [17592186535885 #edb/ref 1075 #edb/ref 17592186535626 #edb/ref 17592186045417] [17592186535885 #edb/ref 1075 #edb/ref 17592186535723 #edb/ref 17592186045417] [17592186535885 #edb/ref 1075 #edb/ref 17592186535739 #edb/ref 17592186045417] [17592186535885 #edb/ref 1075 #edb/ref 17592186535768 #edb/ref 17592186045417] [17592186535885 #edb/ref 1075 #edb/ref 17592186535786 #edb/ref 17592186045417] [17592186535885 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186535885 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186535885 #edb/ref 1078 #edb/ref 17592186535739 #edb/ref 17592186045417] [17592186535885 #edb/ref 1079 #uuid "987364e2-83c5-563b-a86c-5c9e8d2fcffd" #edb/ref 17592186045417] [17592186535903 #edb/ref 1075 #edb/ref 17592186535492 #edb/ref 17592186045417] [17592186535903 #edb/ref 1075 #edb/ref 17592186535548 #edb/ref 17592186045417] [17592186535903 #edb/ref 1075 #edb/ref 17592186535602 #edb/ref 17592186045417] [17592186535903 #edb/ref 1075 #edb/ref 17592186535679 #edb/ref 17592186045417] [17592186535903 #edb/ref 1075 #edb/ref 17592186535691 #edb/ref 17592186045417] [17592186535903 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186535903 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186535903 #edb/ref 1078 #edb/ref 17592186535679 #edb/ref 17592186045417] [17592186535903 #edb/ref 1079 #uuid "bd416d50-8739-51d0-a2e4-b34b56fbb8eb" #edb/ref 17592186045417] [17592186535936 #edb/ref 1068 #edb/ref 17592186535872 #edb/ref 17592186045417] [17592186535936 #edb/ref 1069 "q-72131" #edb/ref 17592186045417] [17592186535936 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186535936 #edb/ref 1071 "Is the function $f(x)=6x$ even, odd, or neither?" #edb/ref 17592186045417] [17592186535936 #edb/ref 1072 #uuid "1b73902c-ad8b-52f6-bdea-d56e526c20d4" #edb/ref 17592186045417] [17592186535936 #edb/ref 1074 "Recall that\n\n- a function is even if $f(-x)=f(x)$ for all $x$\n\n- a function is odd if $f(-x)=-f(x)$ for all $x$\n\nComputing $f(-x)$ for the given function and comparing it to $f(x),$ we have\n\n$$\n\\begin{aligned}f(-x) & =6(-x) \\\\  & =-6x\\end{aligned}\n$$\n\nSince $f(-x)\\ne f(x),$ the function is not even. \n\nLastly, we compute $-f(x)$ and get\n\n$$\n\\begin{aligned}-f(x) & =-(6x) \\\\  & =-6x\\end{aligned}\n$$\n\nSince $f(-x)=-f(x),$ the function is odd." #edb/ref 17592186045417] [17592186535959 #edb/ref 1068 #edb/ref 17592186535885 #edb/ref 17592186045417] [17592186535959 #edb/ref 1069 "q-110665" #edb/ref 17592186045417] [17592186535959 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186535959 #edb/ref 1071 "The table below defines the function $f(x).$ Given that $f(x)$ is an even function, find the value of $a+b.$\n\n| **$x$** | $-90$ | $-65$ | $-40$ | $40$ | $65$ | $90$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $16$ | $b-2$ | $-8$ | $-8$ | $-1$ | $a+6$ |" #edb/ref 17592186045417] [17592186535959 #edb/ref 1072 #uuid "71f2cfbf-31cb-5074-ba4b-cb4c0df22324" #edb/ref 17592186045417] [17592186535959 #edb/ref 1074 "Since $f(x)$ is an even function, we must have that $f(-x)=f(x).$ \n\nUsing the fact that $f(-90)=f(90),$ we obtain\n\n$$\n\\begin{aligned}f(-90) & =f(90) \\\\ 16 & =a+6 \\\\ a & =10.\\end{aligned}\n$$\n\nUsing the fact that $f(-65)=f(65),$ we obtain\n\n$$\n\\begin{aligned}f(-65) & =f(65) \\\\ b-2 & =-1 \\\\ b & =1.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b=10+1=11.\n$$" #edb/ref 17592186045417] [17592186536004 #edb/ref 1068 #edb/ref 17592186535903 #edb/ref 17592186045417] [17592186536004 #edb/ref 1069 "q-72703" #edb/ref 17592186045417] [17592186536004 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186536004 #edb/ref 1071 "![](images/d4/d4cf4f9e1cc145154e5f542a5064b51d6385e7f81d12c7187dff436f5e7e10f9.png)\n\nWhich of the above could be graphs of odd functions?" #edb/ref 17592186045417] [17592186536004 #edb/ref 1072 #uuid "f2ca34f0-80b3-509b-af1e-131cf84ebf9f" #edb/ref 17592186045417] [17592186536004 #edb/ref 1074 "Recall that the graph of an odd function must have rotational symmetry of order $2$ about the origin.\n\n- Graphs II and III do not have rotational symmetry of order $2$ about the origin. So, they are **not** odd functions.\n\n- On the other hand, graphs I and IV do have rotational symmetry about the origin. If we rotate the graphs ${180}^{∘}$ around the origin, we get the same pictures. This means that graphs I and IV show odd functions.\n\n![](images/60/60a38abf4723f137ef0f824613ab15282c9ff5e3098fac13173630baef577e45.png)\n\nTherefore, the correct answer is \"I and IV only.\"" #edb/ref 17592186045417] [17592186536041 #edb/ref 1062 #uuid "b7a0c930-adde-574d-8760-a44307f3040c" #edb/ref 17592186045417] [17592186536041 #edb/ref 1063 #edb/ref 17592186535959 #edb/ref 17592186045417] [17592186536044 #edb/ref 1058 #edb/ref 17592186536046 #edb/ref 17592186045417] [17592186536044 #edb/ref 1062 #uuid "d955d2cc-d916-5f24-af15-9912f4a42329" #edb/ref 17592186045417] [17592186536044 #edb/ref 1063 #edb/ref 17592186083894 #edb/ref 17592186045417] [17592186536046 #edb/ref 1058 #edb/ref 17592186536051 #edb/ref 17592186045417] [17592186536046 #edb/ref 1062 #uuid "dc6fbc89-df59-502f-a5d5-280777efba84" #edb/ref 17592186045417] [17592186536046 #edb/ref 1063 #edb/ref 17592186083675 #edb/ref 17592186045417] [17592186536047 #edb/ref 1058 #edb/ref 17592186536041 #edb/ref 17592186045417] [17592186536047 #edb/ref 1062 #uuid "ed0e6744-5277-5979-857b-90d5d86b76ba" #edb/ref 17592186045417] [17592186536047 #edb/ref 1063 #edb/ref 17592186536004 #edb/ref 17592186045417] [17592186536051 #edb/ref 1058 #edb/ref 17592186536047 #edb/ref 17592186045417] [17592186536051 #edb/ref 1062 #uuid "f9fbce21-df1a-5096-ad2f-9cba5ddbace4" #edb/ref 17592186045417] [17592186536051 #edb/ref 1063 #edb/ref 17592186535936 #edb/ref 17592186045417]}
