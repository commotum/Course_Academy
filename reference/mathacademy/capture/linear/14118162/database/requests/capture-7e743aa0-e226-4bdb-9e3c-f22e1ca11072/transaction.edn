ate]} {:db/id "answer-field-cf6dbce0-b2c5-55fc-9b50-83b83047aa1a" :answer-field/id #uuid "cf6dbce0-b2c5-55fc-9b50-83b83047aa1a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f1338a88-3f30-5eaa-bef7-ab9bd6533c4a" :answer-field/choices ["answer-6ac731cf-716c-598c-98e8-69f2c4551cdb" "answer-f1338a88-3f30-5eaa-bef7-ab9bd6533c4a" "answer-3fb067aa-cc2a-54fc-9189-08b1620714c2" "answer-5419b720-b862-52a5-8a5f-fff36f7ecc28" "answer-342a53b9-24aa-5db2-b9cd-49fb5b854d17"] :db/ensure [:answer-field/validate]} {:db/id "answer-6ac731cf-716c-598c-98e8-69f2c4551cdb" :answer/id #uuid "6ac731cf-716c-598c-98e8-69f2c4551cdb" :answer/type :answer.type/math :answer/value "P∧¬Q" :db/ensure [:answer/validate]} {:db/id "answer-f1338a88-3f30-5eaa-bef7-ab9bd6533c4a" :answer/id #uuid "f1338a88-3f30-5eaa-bef7-ab9bd6533c4a" :answer/type :answer.type/math :answer/value "¬(P∧Q)" :db/ensure [:answer/validate]} {:db/id "answer-3fb067aa-cc2a-54fc-9189-08b1620714c2" :answer/id #uuid "3fb067aa-cc2a-54fc-9189-08b1620714c2" :answer/type :answer.type/math :answer/value "¬(P∨Q)" :db/ensure [:answer/validate]} {:db/id "answer-5419b720-b862-52a5-8a5f-fff36f7ecc28" :answer/id #uuid "5419b720-b862-52a5-8a5f-fff36f7ecc28" :answer/type :answer.type/math :answer/value "¬P∧Q" :db/ensure [:answer/validate]} {:db/id "answer-342a53b9-24aa-5db2-b9cd-49fb5b854d17" :answer/id #uuid "342a53b9-24aa-5db2-b9cd-49fb5b854d17" :answer/type :answer.type/math :answer/value "¬P∨Q" :db/ensure [:answer/validate]} {:db/id "question-9889c22d-72d2-5a8b-9484-672aacb03351" :question/id #uuid "9889c22d-72d2-5a8b-9484-672aacb03351" :question/math-academy-id "q-183273" :question/problem "$\\,$ $x$ is neither divisible by $2$ nor divisible by $3.$\n\nExpress the compound predicate above in symbolic form given the following predicates:\n\n- $P(x):$ $x$ is divisible by $2$\n\n- $Q(x):$  $x$ is divisible by $3$" :question/worked-solution "The given sentence is equivalent to the following sentence: \n\n$\\,$ $x$ is not divisible by $2$, and $x$ is not divisible by $3.$\n\nLet's break our sentence down into individual statements:\n\n- The statement \"$x$ is not divisible by $2$\" can be expressed symbolically as $¬P.$\n\n- The statement \"$x$ is not divisible by $3$\" can be expressed symbolically as $¬Q.$\n\nTherefore, the given sentence is expressed symbolically as\n\n$$\n¬P∧¬Q.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-cecf3abb-7a46-5d8c-b393-c603f5436106"] :db/ensure [:question/validate]} {:db/id "answer-field-cecf3abb-7a46-5d8c-b393-c603f5436106" :answer-field/id #uuid "cecf3abb-7a46-5d8c-b393-c603f5436106" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e6ee713a-99ec-5ae6-9e36-670552466b25" :answer-field/choices ["answer-83037e88-eb61-57bd-8411-0ecbc99fe67c" "answer-4440c7f9-8abe-54cd-adc9-134bb4829efc" "answer-43b5b4c5-32f5-554a-835a-b5dba99fc249" "answer-e6ee713a-99ec-5ae6-9e36-670552466b25" "answer-9057643d-9839-54d8-ba03-73ad70923b21"] :db/ensure [:answer-field/validate]} {:db/id "answer-83037e88-eb61-57bd-8411-0ecbc99fe67c" :answer/id #uuid "83037e88-eb61-57bd-8411-0ecbc99fe67c" :answer/type :answer.type/math :answer/value "P∧¬Q" :db/ensure [:answer/validate]} {:db/id "answer-4440c7f9-8abe-54cd-adc9-134bb4829efc" :answer/id #uuid "4440c7f9-8abe-54cd-adc9-134bb4829efc" :answer/type :answer.type/math :answer/value "P∨¬Q" :db/ensure [:answer/validate]} {:db/id "answer-43b5b4c5-32f5-554a-835a-b5dba99fc249" :answer/id #uuid "43b5b4c5-32f5-554a-835a-b5dba99fc249" :answer/type :answer.type/math :answer/value "¬(P∧Q)" :db/ensure [:answer/validate]} {:db/id "answer-e6ee713a-99ec-5ae6-9e36-670552466b25" :answer/id #uuid "e6ee713a-99ec-5ae6-9e36-670552466b25" :answer/type :answer.type/math :answer/value "¬P∧¬Q" :db/ensure [:answer/validate]} {:db/id "answer-9057643d-9839-54d8-ba03-73ad70923b21" :answer/id #uuid "9057643d-9839-54d8-ba03-73ad70