d}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-26fcda01-5c95-537d-9e0d-3145c0a955c5" "answer-field-88ab95ef-b903-56e5-8ea2-b5cc6d11f060" "answer-field-2b82623a-e97d-53fa-9ea7-a9b5b6a15cfd"] :db/ensure [:question/validate]} {:db/id "answer-field-26fcda01-5c95-537d-9e0d-3145c0a955c5" :answer-field/id #uuid "26fcda01-5c95-537d-9e0d-3145c0a955c5" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-bae8b203-b89e-5e59-bed6-62f5cefebe37" :answer-field/choices ["answer-bae8b203-b89e-5e59-bed6-62f5cefebe37" "answer-708907a8-09fc-5e0f-b207-c585ac296099"] :db/ensure [:answer-field/validate]} {:db/id "answer-bae8b203-b89e-5e59-bed6-62f5cefebe37" :answer/id #uuid "bae8b203-b89e-5e59-bed6-62f5cefebe37" :answer/type :answer.type/text :answer/value "$x$ is  not an integer" :db/ensure [:answer/validate]} {:db/id "answer-708907a8-09fc-5e0f-b207-c585ac296099" :answer/id #uuid "708907a8-09fc-5e0f-b207-c585ac296099" :answer/type :answer.type/text :answer/value "$x$ is an integer" :db/ensure [:answer/validate]} {:db/id "answer-field-88ab95ef-b903-56e5-8ea2-b5cc6d11f060" :answer-field/id #uuid "88ab95ef-b903-56e5-8ea2-b5cc6d11f060" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-c1b1aa1a-dba0-5c7b-b2ec-0e52162a7fa7" :answer-field/choices ["answer-c1b1aa1a-dba0-5c7b-b2ec-0e52162a7fa7" "answer-653d083b-fab8-5282-815f-4d1cfab935ce"] :db/ensure [:answer-field/validate]} {:db/id "answer-c1b1aa1a-dba0-5c7b-b2ec-0e52162a7fa7" :answer/id #uuid "c1b1aa1a-dba0-5c7b-b2ec-0e52162a7fa7" :answer/type :answer.type/text :answer/value "and" :db/ensure [:answer/validate]} {:db/id "answer-653d083b-fab8-5282-815f-4d1cfab935ce" :answer/id #uuid "653d083b-fab8-5282-815f-4d1cfab935ce" :answer/type :answer.type/text :answer/value "or" :db/ensure [:answer/validate]} {:db/id "answer-field-2b82623a-e97d-53fa-9ea7-a9b5b6a15cfd" :answer-field/id #uuid "2b82623a-e97d-