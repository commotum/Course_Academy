#{[{:db/id #edb/ref 17592186198105 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198257 :knowledge-point/id #uuid "28cb0c9e-bf5a-5cab-9147-77e827e21bb2" :knowledge-point/title "Negating a Conjunction Using De Morgan's Law"}] :question/id #uuid "5b1d6912-85f0-5ac1-affb-6809d4525f29" :question/math-academy-id "e-12734" :question/problem "$\\qquad$ $x$ is prime and $y$ divides $12$.\n\nWhat is the negation of the composite predicate above?" :question/worked-solution "De Morgan's law for conjunctions states that\n\n$$\n\\neg ( A \\land B) = \\neg A \\lor \\neg B.\n$$\n\nSo, the negation of \"$x$ is prime and $y$ divides $12$\" is\n\n$$\n\\begin{aligned}¬(x\\text{ is prime and }y\\text{ divides }12) & ≡¬(x\\text{ is prime}∧y\\text{ divides }12) \\\\  & ≡¬(x\\text{ is prime})∨¬(y\\text{ divides }12) \\\\  & ≡x\\text{ is not prime}∨y\\text{ does not divide }12 \\\\  & ≡x\\text{ is not prime}\\text{ or }y\\text{ does not divide }12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186198113 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198256 :knowledge-point/id #uuid "391d581f-9a2a-5de6-afbe-897917a9f6e3" :knowledge-point/title "Expressing a Predicate in Symbolic Form"}] :question/id #uuid "4402b53e-3c80-5788-b727-20941348c03f" :question/math-academy-id "e-12885" :question/problem "$\\qquad$ $x$ is greater than $4,$ or $x$ is irrational.\n\nExpress the compound predicate above in symbolic form given the following predicates:\n\n- $P(x):$ $x$ is greater than $4$\n\n- $Q(x):$ $x$ is rational" :question/worked-solution "The sentence\n\n$\\qquad$ $x$ is irrational\n\ncan be expressed in symbolic form as $\\lnot Q.$\n\nTherefore, the given sentence is expressed symbolically as \n\n$$\nP\\lor \\lnot Q.\n$$"}] [{:db/id #edb/ref 17592186198114 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198258 :knowledge-point/id #uuid "c65d0713-5b7a-5559-bef7-7b238edc29ab" :knowledge-point/title "Negating a Disjunction Using De Morgan's Law"}] :question/id #uuid "ed229458-dba0-5d6b-b32a-b70b253bc1f4" :question/math-academy-id "e-12886" :question/problem "$\\qquad$ $x$ is a multiple of $5$ or $y$ divides $24$.\n\nWhat is the negation of the composite predicate above?" :question/worked-solution "De Morgan's law for disjunctions states that\n\n$$\n\\neg ( A \\lor B) = \\neg A \\land \\neg B.\n$$\n\nSo, the negation of \"$x$ is a multiple of $5$ or $y$ divides $24$\" is\n\n$$\n\\begin{aligned}¬(x\\text{ is a multiple of [math]5[/math] or }y\\text{ divides }24) & ≡¬(x\\text{ is a multiple of }5∨y\\text{ divides }24) \\\\  & ≡¬(x\\text{ is a multiple of }5)∧¬(y\\text{ divides }24) \\\\  & ≡x\\text{ is not a multiple of }5∧y\\text{ does not divide }24 \\\\  & ≡x\\text{ is not a multiple of }5\\text{ and }y\\text{ does not divide }24.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186198696 :knowledge-point/_questions [{:db/id #edb/ref 17592186198256 :knowledge-point/id #uuid "391d581f-9a2a-5de6-afbe-897917a9f6e3" :knowledge-point/title "Expressing a Predicate in Symbolic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "342a53b9-24aa-5db2-b9cd-49fb5b854d17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬P∨Q" :db/id #edb/ref 17592186414568} {:answer/id #uuid "3fb067aa-cc2a-54fc-9189-08b1620714c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬(P∨Q)" :db/id #edb/ref 17592186414570} {:answer/id #uuid "5419b720-b862-52a5-8a5f-fff36f7ecc28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬P∧Q" :db/id #edb/ref 17592186414576} {:answer/id #uuid "6ac731cf-716c-598c-98e8-69f2c4551cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∧¬Q" :db/id #edb/ref 17592186414581} {:answer/id #uuid "f1338a88-3f30-5eaa-bef7-ab9bd6533c4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬(P∧Q)" :db/id #edb/ref 17592