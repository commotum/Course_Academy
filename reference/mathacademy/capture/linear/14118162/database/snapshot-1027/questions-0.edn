{:answer/id #uuid "ef7aec8d-9712-56a5-9bfb-f43b9d9a4f29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "or" :db/id #edb/ref 17592186414609} :answer-field/id #uuid "c20d578f-edc7-5eaf-9e01-06476cf00faf" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186414632}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "60b90c12-945a-57da-a90e-2ce25715910b" :question/math-academy-id "q-183288" :question/problem "$\\,$ $x$ is rational and $y$ is irrational. \n\nThe negation of the composite predicate above is the following:" :question/worked-solution "De Morgan's law for conjunctions states that\n\n$$\n¬(A∧B)=¬A∨¬B.\n$$\n\nSo, the negation of \"$x$ is rational and $y$ is irrational\" is\n\n$$\n\\begin{aligned}¬(x\\text{ is rational and }y\\text{ is irrational}) & ≡¬(x\\text{ is rational}∧y\\text{ is irrational}) \\\\  & ≡¬(x\\text{ is rational})∨¬(y\\text{ is irrational}) \\\\  & ≡x\\text{ is not rational}∨y\\text{ is not irrational} \\\\  & ≡x\\text{ is not rational or }y\\text{ is not irrational}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186414640 :knowledge-point/_questions [{:db/id #edb/ref 17592186198258 :knowledge-point/id #uuid "c65d0713-5b7a-5559-bef7-7b238edc29ab" :knowledge-point/title "Negating a Disjunction Using De Morgan's Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "708907a8-09fc-5e0f-b207-c585ac296099" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x$ is an integer" :db/id #edb/ref 17592186414582} {:answer/id #uuid "bae8b203-b89e-5e59-bed6-62f5cefebe37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x$ is  not an integer" :db/id #edb/ref 17592186414599}] :answer-field/correct {:answer/id #uuid "bae8b203-b89e-5e59-bed6-62f5cefebe37" :answer/type {:db/id #edb