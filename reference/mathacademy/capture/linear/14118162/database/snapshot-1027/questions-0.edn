ref 17592186414593} :answer-field/id #uuid "ade18156-9e6a-57e2-adc8-e6d739d87723" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186414630}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "078171ae-79c8-5810-aaf2-bebda0bbeadd" :question/math-academy-id "q-175329" :question/problem "$\\,$ $a$ is even or $b$ is odd.\n\nThe negation of the composite predicate above is the following:" :question/worked-solution "De Morgan's law for disjunctions states that\n\n$$\n¬(A∨B)=¬A∧¬B.\n$$\n\nSo, the negation of \"$a$ is even or $b$ is odd\" is\n\n$$\n\\begin{aligned}¬(a\\text{ is even or }b\\text{ is odd }) & ≡¬(a\\text{ is even }∨b\\text{ is odd }) \\\\  & ≡¬(a\\text{ is even })∧¬(b\\text{ is odd }) \\\\  & ≡a\\text{ is odd }∧b\\text{ is even } \\\\  & ≡a\\text{ is odd and }b\\text{ is even}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186414642 :knowledge-point/_questions [{:db/id #edb/ref 17592186198256 :knowledge-point/id #uuid "391d581f-9a2a-5de6-afbe-897917a9f6e3" :knowledge-point/title "Expressing a Predicate in Symbolic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43b5b4c5-32f5-554a-835a-b5dba99fc249" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬(P∧Q)" :db/id #edb/ref 17592186414573} {:answer/id #uuid "4440c7f9-8abe-54cd-adc9-134bb4829efc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∨¬Q" :db/id #edb/ref 17592186414574} {:answer/id #uuid "83037e88-eb61-57bd-8411-0ecbc99fe67c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∧¬Q" :db/id #edb/ref 17592186414588} {:answer/id #uuid "9057643d-9839-54d8-ba03-73ad70923b21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬P∨¬Q" :db/id #edb/ref 17592186414589} {:answer/id #uuid "e6ee713a-99ec-5ae6-9e36-670552466b25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬P∧¬Q" :db/id #edb/ref 17592186414608}] :answer-field/correct {:answer/id #uuid "e6ee713a-99ec-5ae6-9e36-670552466b25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬P∧¬Q" :db/id #edb/ref 17592186414608} :answer-field/id #uuid "cecf3abb-7a46-5d8c-b393-c603f5436106" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414633}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9889c22d-72d2-5a8b-9484-672aacb03351" :question/math-academy-id "q-183273" :question/problem "$\\,$ $x$ is neither divisible by $2$ nor divisible by $3.$\n\nExpress the compound predicate above in symbolic form given the following predicates:\n\n- $P(x):$ $x$ is divisible by $2$\n\n- $Q(x):$  $x$ is divisible by $3$" :question/worked-solution "The given sentence is equivalent to the following sentence: \n\n$\\,$ $x$ is not divisible by $2$, and $x$ is not divisible by $3.$\n\nLet's break our sentence down into individual statements:\n\n- The statement \"$x$ is not divisible by $2$\" can be expressed symbolically as $¬P.$\n\n- The statement \"$x$ is not divisible by $3$\" can be expressed symbolically as $¬Q.$\n\nTherefore, the given sentence is expressed symbolically as\n\n$$\n¬P∧¬Q.\n$$"}] [{:db/id #edb/ref 17592186414637 :knowledge-point/_questions [{:db/id #edb/ref 17592186198256 :knowledge-point/id #uuid "391d581f-9a2a-5de6-afbe-897917a9f6e3" :knowledge-point/title "Expressing a Predicate in Symbolic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dd55b5a-0ce9-56da-98e7-46a8c78ba018" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬Y∨¬Z" :db/id #edb/ref 17592186414561} {:answer/id #uuid "19a32f64-e897-5ff0-bf