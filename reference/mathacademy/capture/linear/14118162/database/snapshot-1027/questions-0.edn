on/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "52356a50-945f-5f86-892e-4a577c3252b5" :question/math-academy-id "q-183308" :question/problem "$\\,$ $x$ is an integer or $x$ is irrational.\n\nThe negation of the composite predicate above is the following:" :question/worked-solution "De Morgan's law for disjunctions states that\n\n$$\n¬(A∨B)=¬A∧¬B.\n$$\n\nSo, the negation of \"$x$ is an integer or $x$ is irrational\" is \n\n$$\n\\begin{aligned}¬(x\\text{ is an integer or }x\\text{ is irrational }) & ≡¬(x\\text{ is an integer}∨x\\text{ is irrational}) \\\\  & ≡¬(x\\text{ is an integer})∧¬(x\\text{ is irrational}) \\\\  & ≡x\\text{ is not an integer}∧x\\text{ is not irrational } \\\\  & ≡x\\text{ is not an integer and }x\\text{ is not irrational}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186414635 :knowledge-point/_questions [{:db/id #edb/ref 17592186198258 :knowledge-point/id #uuid "c65d0713-5b7a-5559-bef7-7b238edc29ab" :knowledge-point/title "Negating a Disjunction Using De Morgan's Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e75a71e-4495-54a5-b480-9ce244247bc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b<0" :db/id #edb/ref 17592186414586} {:answer/id #uuid "97dbbbcf-b1c5-5c50-b93a-0c02d4bcb5df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b\\ne 0" :db/id #edb/ref 17592186414590} {:answer/id #uuid "c154baa0-e60e-5d8c-817b-898c1c08b818" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b=0" :db/id #edb/ref 17592186414601}] :answer-field/correct {:answer/id #uuid "97dbbbcf-b1c5-5c50-b93a-0c02d4bcb5df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b\\ne 0" :db/id #edb/ref 17592186414590} :answer-field/id #uuid "0d7c0e86-adb9-57e0-b75e-19cb45398bc3" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 1