#{[{:db/id #edb/ref 17592186198105 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198257 :knowledge-point/id #uuid "28cb0c9e-bf5a-5cab-9147-77e827e21bb2" :knowledge-point/title "Negating a Conjunction Using De Morgan's Law"}] :question/id #uuid "5b1d6912-85f0-5ac1-affb-6809d4525f29" :question/math-academy-id "e-12734" :question/problem "$\\qquad$ $x$ is prime and $y$ divides $12$.\n\nWhat is the negation of the composite predicate above?" :question/worked-solution "De Morgan's law for conjunctions states that\n\n$$\n\\neg (A \\land B) = \\neg A \\lor \\neg B\n$$\n\nSo, the negation of \"$x$ is prime and $y$ divides $12$\" is\n\n$$\n¬(xis prime andydivides12) \\mid ≡¬(xis prime∧ydivides12); ≡¬(xis prime)∨¬(ydivides12); ≡xis not prime∨ydoes not divide12; ≡xis not primeorydoes not divide12\n$$"}] [{:db/id #edb/ref 17592186198113 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198256 :knowledge-point/id #uuid "391d581f-9a2a-5de6-afbe-897917a9f6e3" :knowledge-point/title "Expressing a Predicate in Symbolic Form"}] :question/id #uuid "4402b53e-3c80-5788-b727-20941348c03f" :question/math-academy-id "e-12885" :question/problem "$\\qquad$ $x$ is greater than $4$, or $x$ is irrational.\n\nExpress the compound predicate above in symbolic form given the following predicates:\n\n- $P(x)$: $x$ is greater than $4$\n- $Q(x)$: $x$ is rational" :question/worked-solution "The sentence\n\n$\\qquad$ $x$ is irrational\n\ncan be expressed in symbolic form as $\\lnot Q$.\n\nTherefore, the given sentence is expressed symbolically as\n$P\\lor \\lnot Q$."}] [{:db/id #edb/ref 17592186198114 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198258 :knowledge-point/id #uuid "c65d0713-5b7a-5559-bef7-7b238edc29ab" :knowledge-point/title "Negating a Disjunction Using De Morgan's Law"}] :question/id #uuid "ed229458-dba0-5d6b-b32a-b70b253bc1f4" :question/math-academy-id "e-12886" :question/problem "$\\qquad$ $x$ is a multiple of $5$ or $y$ divides $24$.\n\nWhat is the negation of the composite predicate above?" :question/worked-solution "De Morgan's law for disjunctions states that\n\n$$\n\\neg (A \\lor B) = \\neg A \\land \\neg B\n$$\n\nSo, the negation of \"$x$ is a multiple of $5$ or $y$ divides $24$\" is\n\n$$\n¬(xis a multiple of [math]5[/math] orydivides24) \\mid ≡¬(xis a multiple of5∨ydivides24); ≡¬(xis a multiple of5)∧¬(ydivides24); ≡xis not a multiple of5∧ydoes not divide24; ≡xis not a multiple of5andydoes not divide24\n$$"}] [{:db/id #edb/ref 17592186198696 :knowledge-point/_questions [{:db/id #edb/ref 17592186198256 :knowledge-point/id #uuid "391d581f-9a2a-5de6-afbe-897917a9f6e3" :knowledge-point/title "Expressing a Predicate in Symbolic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7ae497e-e5fd-50b1-b6cb-e9f83362c06e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬(P∧Q)" :db/id #edb/ref 17592186194803} {:answer/id #uuid "f9759fc2-3609-5ae0-a559-61da19d8a121" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∧¬Q" :db/id #edb/ref 17592186194804} {:answer/id #uuid "50cad3ac-14ed-52aa-8eec-d4a18295093c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬P∧Q" :db/id #edb/ref 17592186194805} {:answer/id #uuid "571e8b1f-6ba9-5eef-b1ec-e8833ade656a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬(P∨Q)" :db/id #edb/ref 17592186194806} {:answer/id #uuid "64f73e4e-3e0b-55f0-9c72-56b03996c046" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬P∨Q" :db/id #edb/ref 17592186194807}] :answer-field/id #uuid "8ba91256-0feb-5728-988e-dfdf1f646441" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186194802}] :question/id #uuid "e716194e-3ab1-59dd-b4e2-2926a9bd85ac" :question/math-academy-id "q-170806" :questio