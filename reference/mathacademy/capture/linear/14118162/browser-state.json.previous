mathvariant=\"normal\">¬</mi><mo stretchy=\"false\">(</mo><mi>m</mi><mtext>&nbsp;is even</mtext><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>≡</mo><mi>n</mi><mtext>&nbsp;is not prime</mtext><mo>∨</mo><mi>m</mi><mtext>&nbsp;is odd</mtext></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>≡</mo><mi>n</mi><mtext>&nbsp;is not prime or&nbsp;</mtext><mi>m</mi><mtext>&nbsp;is odd</mtext><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
