#{[{:db/id #edb/ref 17592186507410 :knowledge-point/_questions [{:db/id #edb/ref 17592186064326 :knowledge-point/id #uuid "457399ac-1ede-551f-968b-9ef270a67d0b" :knowledge-point/title "Factoring a Trinomial Generated by the Square of a Difference"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a6cd19d-164d-5b97-a602-10c686dd9873" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2t-7)^{2}" :db/id #edb/ref 17592186506985} {:answer/id #uuid "9df797c2-4cab-5309-a7be-3552ea5721d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(t-12)^{2}" :db/id #edb/ref 17592186507017} {:answer/id #uuid "a42dd5ae-f26b-5919-9491-b0ee466749f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2t-8)^{2}" :db/id #edb/ref 17592186507035} {:answer/id #uuid "cc44d5db-8cdb-56b6-ac5a-21a07d054d54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(t+11)^{2}" :db/id #edb/ref 17592186507123} {:answer/id #uuid "e43e106b-fd87-54fd-9560-b587c9f88927" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(t-11)^{2}" :db/id #edb/ref 17592186507177}] :answer-field/correct {:answer/id #uuid "e43e106b-fd87-54fd-9560-b587c9f88927" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(t-11)^{2}" :db/id #edb/ref 17592186507177} :answer-field/id #uuid "6b1d029e-2f62-5e77-9841-4721fc7760f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186507300}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1f9f643d-cb40-58cc-a000-e0bdfa821c71" :question/math-academy-id "q-2831" :question/problem "Factor ${t}^{2}-22t+121.$" :question/worked-solution "The \"square of a difference\" formula states that\n\n$$\n{t}^{2}-2at+{a}^{2}=(t-a)^{2}.\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n{t}^{2}-22t+121.\n$$\n\nFirst, we write the constant term as a perfect square:\n\n$$\n\\begin{aligned}{t}^{2}-22t+{11}^{2}\\end{aligned}\n$$\n\nThen, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}{t}^{2}-2\\cdot 11t+{11}^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of difference formula with $a=11.$ This gives\n\n$$\n\\begin{aligned}(t-11)^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186507455 :knowledge-point/_questions [{:db/id #edb/ref 17592186064326 :knowledge-point/id #uuid "457399ac-1ede-551f-968b-9ef270a67d0b" :knowledge-point/title "Factoring a Trinomial Generated by the Square of a Difference"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ca67fe0-cf38-599e-96f0-f21b24a8ed45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2e+9)^{2}" :db/id #edb/ref 17592186506700} {:answer/id #uuid "1e211f2a-503f-53ec-afa6-8cc382355c12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(e-9)^{2}" :db/id #edb/ref 17592186506739} {:answer/id #uuid "836e756a-76b5-5f29-86b1-a991836e11bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(e-3)^{2}" :db/id #edb/ref 17592186506970} {:answer/id #uuid "c6a4827a-5dc1-5018-8b60-d93186610d52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(e+9)^{2}" :db/id #edb/ref 17592186507110} {:answer/id #uuid "c91d77da-831a-57b5-a1ac-15897539bebc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2e-9)^{2}" :db/id #edb/ref 17592186507117}] :answer-field/correct {:answer/id #uuid "1e211f2a-503f-53ec-afa6-8cc382355c12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(e-9)^{2}" :db/id #edb/ref 17592186506739} :answer-field/id #uuid "d8ac7d31-1c83-57d9-9043-68e47336ef2f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186507373}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "85b0de0c-7078-58c3-80c6-e70c35748f20" :question/math-academy-id "q-3001" :question/problem "Factor the expression ${e}^{2}-18e+81.$" :question/worked-solution "The \"square of a difference\" formula states that\n\n$$\n{e}^{2}-2ae+{a}^{2}=(e-a)^{2}.\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n{e}^{2}-18e+81.\n$$\n\nFirst, we write the constant term as a perfect square:\n\n$$\n\\begin{aligned}{e}^{2}-18e+{9}^{2}\\end{aligned}\n$$\n\nThen, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}{e}^{2}-2\\cdot 9e+{9}^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of difference formula with $a=9.$ This gives\n\n$$\n\\begin{aligned}(e-9)^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186507404 :knowledge-point/_questions [{:db/id #edb/ref 17592186064327 :knowledge-point/id #uuid "48f257af-1f00-5cf9-89cd-3d44d21482ec" :knowledge-point/title "Factoring a Trinomial with Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22440f7b-035c-540b-b0e2-3dcd53956334" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x+\\frac{1}{4})}^{2}" :db/id #edb/ref 17592186506747} {:answer/id #uuid "24264748-c5f8-54b5-aa97-cacdbd3e54a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-\\frac{1}{2})}^{2}" :db/id #edb/ref 17592186506756} {:answer/id #uuid "9798202a-5866-5647-b043-5b3551c6a2a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x+\\frac{1}{2})}^{2}" :db/id #edb/ref 17592186507008} {:answer/id #uuid "baca3216-958b-5e79-b70f-2b61c19055ad" :answer/type {:db/id 