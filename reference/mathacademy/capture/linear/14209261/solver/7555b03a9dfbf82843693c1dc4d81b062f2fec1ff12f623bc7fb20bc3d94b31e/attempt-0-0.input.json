        "problem": "Find the value of $f(x)$ at $x=4.$\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        $f(4)\\,=\\,$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}",
