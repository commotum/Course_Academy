ref 17592186045492} :db/id #edb/ref 17592186489052} {:answer-field/choices [{:answer/id #uuid "bd0e570e-08e5-5524-96a6-7ec3e36a900c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186488855}] :answer-field/correct {:db/id #edb/ref 17592186488855} :answer-field/id #uuid "7a9fea34-4574-5f69-af39-751014ba8f68" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186489084} {:answer-field/choices [{:answer/id #uuid "e3888f44-8f46-55f7-b16c-49957fec7733" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186488944}] :answer-field/correct {:db/id #edb/ref 17592186488944} :answer-field/id #uuid "7ec1b407-4fc4-5513-801c-a4b1e6cc64a2" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186489085}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2eb98296-341b-5be8-a509-1dce3cf14c43" :question/math-academy-id "q-236001" :question/problem "![](images/9c/9c69a1ff6845f4be53f42e166a682baf804919ccba0f344ccdd38bc249584efc.png)\n\nWhat is the range of the function $f(x),$ shown above?\n\nThe range is \n{{field-1}}\n$\\le f(x)$\n{{field-2}}{{field-3}}." :question/worked-solution "First, we find the smallest and largest $y$-values in the graph.\n\n- The smallest $y$-value is $-3.$ This occurs when $x=1.$\n\n- The largest $y$-value is $0.$ This occurs when $x\\to -\\infty .$ However, note that this point is not included in the graph.\n\nThe function covers all the $y$-values between $-3$ and $0,$ including $-3$ but not including $0.$\n\nTherefore, the range is $-3\\le y<0,$ which can also be written as  $-3\\le f(x)<0.$"} :step/id #uuid "4667bb2a-2002-535b-abeb-65e5c33b3eb7" :step/next {:db/id #edb/ref 17592186489362}} {:db/id #edb/ref 17592186489351 :step/content {:db/id #edb/ref 17592186489211 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53d33833-5d73-5cd1-aaa3-ebbde8ba