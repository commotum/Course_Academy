e4bc4b0560c2bd4b9fa2700e902a4dde84f90b7.svg)" :tutorial/id #uuid "f4a2e52b-5aee-58ed-bcc3-b236246d862c" :tutorial/math-academy-id 6884 :tutorial/title "The Definition of the Inverse Function"} :step/id #uuid "3130ad01-93cf-56c2-a59d-52d2324277cf" :step/math-academy-id 41725 :step/next {:db/id #edb/ref 17592186084323}} {:db/id #edb/ref 17592186084323 :step/content {:db/id #edb/ref 17592186083359 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082907 :question/id #uuid "062748b1-c85a-5c2c-8d1f-f1006e73a880" :question/math-academy-id "e-10989"} :knowledge-point/id #uuid "06e51d62-ad2a-51c3-b276-eeb60022ab48" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049317} {:db/id #edb/ref 17592186050622}] :knowledge-point/questions [{:db/id #edb/ref 17592186083552} {:db/id #edb/ref 17592186083553} {:db/id #edb/ref 17592186083662} {:db/id #edb/ref 17592186233404} {:db/id #edb/ref 17592186233413} {:db/id #edb/ref 17592186234200} {:db/id #edb/ref 17592186521543} {:db/id #edb/ref 17592186521571} {:db/id #edb/ref 17592186522749}] :knowledge-point/title "Computing an Inverse Function Using the Definition"} :step/id #uuid "84556b63-2621-5c1b-84d0-55dbf5fff5d9" :step/math-academy-id 41726}] :activity/title "Introduction to Inverse Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083443}]}
