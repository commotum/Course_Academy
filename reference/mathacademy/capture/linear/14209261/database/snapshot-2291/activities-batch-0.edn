vg) because ![](images/95/95a3686bf6cd3fddc29b98a39ab23027d1cc794ae2517aefde675a62f0a4d023.svg) On this branch, the function definition is ![](images/85/85f568b3e2d870a755a97fb3457f3c62e814f559b8b017ac05c291fb5d8aa79e.svg) so we have\n\n![](images/16/166c6a001bb66b83e3d369c2211f11baf60650e54c93da7bee47539fa717d44a.svg)" :tutorial/id #uuid "78de19f4-277e-593e-b417-d9c4b49d919f" :tutorial/math-academy-id 1823 :tutorial/title "Introduction"} :step/id #uuid "271b7b22-3952-5a9c-b297-a12548098709" :step/math-academy-id 104209 :step/next {:db/id #edb/ref 17592186060464}} {:db/id #edb/ref 17592186060464 :step/content {:db/id #edb/ref 17592186059632 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059458 :question/id #uuid "92d4072d-90d5-5b12-b043-9361efb446cd" :question/math-academy-id "e-1749"} :knowledge-point/id #uuid "8daba5bf-5162-5779-9512-f22d0c8c0320" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048652} {:db/id #edb/ref 17592186050519}] :knowledge-point/questions [{:db/id #edb/ref 17592186060385} {:db/id #edb/ref 17592186060397} {:db/id #edb/ref 17592186233397} {:db/id #edb/ref 17592186233406} {:db/id #edb/ref 17592186506523} {:db/id #edb/ref 17592186506601} {:db/id #edb/ref 17592186522694}] :knowledge-point/title "Evaluating Piecewise Functions"} :step/id #uuid "4a1af676-293f-5181-9c71-d019fd78b1fc" :step/math-academy-id 104210 :step/next {:db/id #edb/ref 17592186060465}} {:db/id #edb/ref 17592186060465 :step/content {:db/id #edb/ref 17592186059633 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059459 :question/id #uuid "05e153cd-83bb-5d6a-b316-58835ee0fab2" :question/math-academy-id "e-1751"} :knowledge-point/id #uuid "a0df71e7-73ee-5b39-9c36-053215d90052" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050763}] :knowledge-point/questions [{:db/id #edb/ref 17592186060284} {:db/id #edb/ref 17592186060285} {:db/id #edb/ref 17592186506574} {:db/id #edb/ref 17592186506586}] :knowledge-point/title "Graphing a Piecewise Step Function"} :step/id #uuid "a399e495-9b2e-5e32-b85b-e20073c79c2f" :step/math-academy-id 104213 :step/next {:db/id #edb/ref 17592186060466}} {:db/id #edb/ref 17592186060466 :step/content {:db/id #edb/ref 17592186059634 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059608 :question/id #uuid "c2b247d7-416c-5a41-99c2-b6afd3ca918a" :question/math-academy-id "e-6752"} :knowledge-point/id #uuid "bfe3639d-d134-5e2e-b405-a9285a33ec6c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050635}] :knowledge-point/questions [{:db/id #edb/ref 17592186060191} {:db/id #edb/ref 17592186060273} {:db/id #edb/ref 17592186506531}] :knowledge-point/title "Graphing a Piecewise Function"} :step/id #uuid "ee68356a-78de-58d9-b83a-2af6c68a3a3e" :step/math-academy-id 104216 :step/next {:db/id #edb/ref 17592186060467}} {:db/id #edb/ref 17592186060467 :step/content {:db/id #edb/ref 17592186059635 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059623 :question/id #uuid "0ea16984-1ed3-51a5-b425-bfffea3bcd77" :question/math-academy-id "e-9628"} :knowledge-point/id #uuid "ec82342d-2986-5483-88f0-a0c85cac5110" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049072}] :knowledge-point/questions [{:db/id #edb/ref 17592186060274} {:db/id #edb/ref 17592186060275} {:db/id #edb/ref 17592186506576}] :knowledge-point/title "The Domain of a Piecewise Function"} :step/id #uuid "c39cc122-fcc3-5df8-89c6-7bb2d23dee0c" :step/math-academy-id 104219}] :activity/title "Piecewise Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186059893}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186180354} :activity/id #uuid "48809555-7500-5dc1-824d-52a5a22edeba" :activity/scope {:db/id #edb/ref 17592186050580 :topic/id #uuid "557f8b58-be49-555e-8162-3d1448eaff0c" :topic/math-academy-id 3728} :activity/steps [{:db/id #edb/ref 17592186180354 :step/content {:db/id #edb/ref 17592186180785 :tutorial/content "The range of a function can be thought of as the set of $y$-values given by the function's graph. For that reason, it's often helpful to plot the function when determining its range.\n\nFor example, consider the linear function \n\n$$\nf(x) =3-2x,\n$$\n\nwhere $x$ is any real number. What is the range of $f(x)$?\n\nSince this is a linear function, we only need two points to plot it. For example:\n\n- When $x=0,$ we have $y=3.$ This gives the point $(0,3).$\n\n- When $x=1,$ we have $y=1.$ This gives the point $(1,1).$\n\nPlotting these two points and connecting them, we obtain the following diagram.\n\n![](images/51/5124e487118191ae40248d4488450d065fe71712f709ac62321d749ac17b0127.png)\n\nNotice that the graph $y=f(x)$ will cover all possible $y$-values, so the range of the function is\n\n$$\n-\\infty <          y <          \\infty.\n$$\n\nUsing interval notation, we can also write the range as $(-\\infty, \\infty).$\n\nLet's now look at an example of a linear function with a restricted domain." :tutorial/id #uuid "0a33428f-024c-5783-b5d1-b4b0f342d4a6" :tutorial/math-academy-id 8800 :tutorial/title "Introduction"} :step/id #uuid "b396314a-88fd-58e7-a7b9-40fb4292040b" :step/math-academy-id 192940 :step/next {:db/id #edb/ref 17592186180355}} {:db/id #edb/ref 17592186180355 :step/content {:db/id #edb/ref 17592186179650 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179477 :question/id #uuid "dc5cefa9-aa18-52d3-bbdc-a0c1050f6f3b" :question/math-academy-id "e-14168"} :knowledge-point/id #uuid "1ebb0209-904f-598a-9ff2-ab9d4d0cabca" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049072} {:db/id #edb/ref 17592186049707} {:db/id #edb/ref 17592186050790}] :knowledge-point/questions [{:db/id #edb/ref 17592186180143} {:db/id #edb/ref 17592186180171} {:db/id #edb/ref 17592186233403} {:db/id #edb/ref 17592186233412} {:db/id #edb/ref 17592186508038} {:db/id #edb/ref 17592186508051} {:db/id #edb/ref 17592186522697}] :knowledge-poin