      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14198813/observations/step-q300752-fe613764f0372c5071fc.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14198813/observations/step-q300752-fe613764f0372c5071fc.png",
      "source_url": "https://mathacademy.com/tasks/14198813/topics/461/lesson",
