#{[{:db/id #edb/ref 17592186068432 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068828 :knowledge-point/id #uuid "3674f343-59bc-5420-9dca-44102b11aba6" :knowledge-point/title "Simplifying a Radical Expression That Is Not a Perfect Square"}] :question/id #uuid "a474788c-5b2b-570d-84bf-2c9575ac4f54" :question/math-academy-id "e-10022" :question/problem "Simplify $\\sqrt{8z^3}$." :question/worked-solution "We first write $8z^3$ as the product $4z^2 \\cdot 2z$ which contains a perfect square $(4z^2){:}$\n\n$$\n\\begin{aligned} \\sqrt{8z^3} \\\\[3pt] &= \\sqrt{4z^2 \\cdot 2z}& \\end{aligned}\n$$\n\nThen, we can separate the product into two separate radicals:\n\n$$\n\\begin{aligned} \\sqrt{4z^2 \\cdot 2z} \\\\[3pt] &= \\sqrt{(2z)^2\\cdot 2z} \\\\[3pt] &= \\sqrt{(2z)^2}\\cdot \\sqrt{2z}& \\end{aligned}\n$$\n\nFinally, we simplify the radical containing the perfect square:\n\n$$\n\\begin{aligned} \\sqrt{(2z)^2}\\cdot \\sqrt{2z} \\\\[3pt] &= \\begin{vmatrix}2z & \\cdot \\sqrt{2z} \\\\[3pt] &= & 2 & \\cdot & z & \\cdot \\sqrt{2z} \\\\[3pt] &= 2 & z\\end{vmatrix}\\sqrt{2z}& \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068469 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068852 :knowledge-point/id #uuid "4df00200-f680-53f3-9b49-700b9ac14204" :knowledge-point/title "Simplifying a Radical Expression That Is Not a Perfect Square With Domain Restrictions"}] :question/id #uuid "969be012-a830-564e-a355-00a4f1985ae8" :question/math-academy-id "e-1363" :question/problem "Simplify $\\sqrt{18y^3}$ given that $y \\geq 0$." :question/worked-solution "We first write $18y^3$ as the product $9y^2\\cdot 2y$ which contains a perfect square $(9y^2)$. Then, we separate the product into two separate radicals, one of which can be simplified:\n\n$$\n\\begin{aligned} \\sqrt{18y^3} &= \\ \\sqrt{9y^2 \\cdot 2y} &= \\ \\sqrt{9y^2} \\cdot \\sqrt{2y} &= \\ \\sqrt{(3y)^2} \\cdot \\sqrt{2y} \\\\ &= \\begin{vmatrix}3y & \\cdot \\sqrt{2y} \\\\ &= & 3 & \\cdot & y & \\cdot \\sqrt{2y} \\\\ &= 3 \\cdot & y\\end{vmatrix} \\cdot \\sqrt{2y} \\end{aligned}\n$$\n\nSince\n\n$$\ny \\geq 0\n$$\n\nwe have\n\n$$\n\\begin{aligned}\n\\mid y &= y\n\\end{aligned}\n$$\n\nand we can simplify further. Therefore, our final answer is\n\n$$\n\\begin{aligned} 3 \\cdot \\mid y \\mid \\cdot \\sqrt{2y} \\\\ &= 3 \\cdot y \\cdot \\sqrt{2y} \\\\ &= 3y\\sqrt{2y}. & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068676 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068826 :knowledge-point/id #uuid "f2471751-7e5c-5823-9f63-76d14f927db2" :knowledge-point/title "Simplifying a Radical Expression That Is Not a Perfect Square With Larger Powers"}] :question/id #uuid "ce2e3248-96e3-5d69-9a16-1a62e0ce0eeb" :question/math-academy-id "e-9980" :question/problem "Simplify $\\sqrt{50u^7}$." :question/worked-solution "We first write $50u^7$ as the product $25u^6\\cdot 2u$ which contains a perfect square $(25u^6){:}$\n\n$$\n\\begin{aligned} \\sqrt{50u^7} \\\\[3pt] &= \\sqrt{25u^6\\cdot 2u}& \\end{aligned}\n$$\n\nThen, we separate the product into two separate radicals:\n\n$$\n\\begin{aligned} \\sqrt{25u^6\\cdot 2u} \\\\[3pt] &= \\sqrt{\\left(5u^3\\right)^2\\cdot 2u} \\\\[3pt] &= \\sqrt{\\left(5u^3\\right)^2}\\cdot\\sqrt{2u}& \\end{aligned}\n$$\n\nFinally, we simplify the radical containing the perfect square:\n\n$$\n\\begin{aligned} \\sqrt{\\left(5u^3\\right)^2}\\cdot\\sqrt{2u} \\\\[3pt] &= \\begin{vmatrix}5u^3 & \\cdot\\sqrt{2u} \\\\[3pt] &= & 5 & \\cdot & u^3 & \\cdot\\sqrt{2u} \\\\[3pt] &= \\left.5\\end{vmatrix}u\\right|^3 \\sqrt{2u} \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069224 :knowledge-point/_questions [{:db/id #edb/ref 17592186068852 :knowledge-point/id #uuid "4df00200-f680-53f3-9b49-700b9ac14204" :knowledge-point/title "Simplifying a Radical Expression That Is Not a Perfect Square With Domain Restrictions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9604b624-c03b-5347-ba7b-8d49db33c3f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y\\sqrt{8y}" :db/id #edb/ref 17592186066523} {:answer/id #uuid "da5cf77d-ab74-5a12-9ec1-e98ccfb0cb75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y^{2}\\sqrt{8y}" :db/id #edb/ref 17592186066524} {:answer/id #uuid "e9919e2c-cbe1-5c41-a1b1-57be787bd108" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4y\\sqrt{4y}" :db/id #edb/ref 17592186066525} {:answer/id #uuid "4ab5aca2-34cf-511d-b92f-1e7702541d5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4y\\sqrt{2y}" :db/id #edb/ref 17592186066526} {:answer/id #uuid "64285070-c3b5-5963-aa25-3bf6449987b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8y\\sqrt{2y}" :db/id #edb/ref 17592186066527}] :answer-field/id #uuid "e9291b82-8dbe-52ac-a018-87c4d7471cd9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066522}] :question/id #uuid "09ae7f43-8e12-5216-a76e-64db91dde2b1" :question/math-academy-id "q-3052" :question/problem "Simplify $\\sqrt{32y^{3}}$ given that $y \\ge 0$."}]}
