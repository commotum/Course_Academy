{aligned}\n$$"}] [{:db/id #edb/ref 17592186501143 :knowledge-point/_questions [{:db/id #edb/ref 17592186068852 :knowledge-point/id #uuid "4df00200-f680-53f3-9b49-700b9ac14204" :knowledge-point/title "Simplifying a Radical Expression That Is Not a Perfect Square With Domain Restrictions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55c0d6da-ec19-5da3-b2dc-7f663e03694e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2a\\sqrt{2}" :db/id #edb/ref 17592186500641} {:answer/id #uuid "6bff48a8-8066-543e-beda-b761e7cc572b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{a}^{2}" :db/id #edb/ref 17592186500688} {:answer/id #uuid "82bc2d85-b1c1-5c55-a2c7-2b61a9daf911" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4a" :db/id #edb/ref 17592186500737} {:answer/id #uuid "9f55a8e6-e0d9-5e67-80ef-09398f8eab35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{a}^{2}" :db/id #edb/ref 17592186500791} {:answer/id #uuid "cb925792-6008-5f93-bb6b-6fe323c888e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2a" :db/id #edb/ref 17592186500898}] :answer-field/correct {:answer/id #uuid "55c0d6da-ec19-5da3-b2dc-7f663e03694e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2a\\sqrt{2}" :db/id #edb/ref 17592186500641} :answer-field/id #uuid "2d6498f4-a70b-50c1-9ce5-2cc3f0cc3064" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501032}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1704928a-5b6a-5e32-992c-5da9fe38c678" :question/math-academy-id "q-2934" :question/problem "Simplify $\\sqrt{8{a}^{2}}$ given that $a\\ge 0.$" :question/worked-solution "We first write $8{a}^{2}$ as the product $4{a}^{2}\\cdot 2$ which contains a perfect square $(4{a}^{2}).$ Then, we can separate the product into two separate radicals, one of which can be simplified:\n\n$$\n\\begin{aligned}\\sqrt{8{a}^{2}} & = \\\\ \\sqrt{4{a}^{2}\\cdot 2} & = \\\\ \\sqrt{(2a)^{2}\\cdot 2} & = \\\\ \\sqrt{(2a)^{2}}\\cdot \\sqrt{2} & = \\\\ |2a|\\sqrt{2} & = \\\\ |2|\\cdot |a|\\cdot \\sqrt{2} & = \\\\ 2\\cdot |a|\\cdot \\sqrt{2}\\end{aligned}\n$$\n\nSince $a\\ge 0,$ we have $|a|=a,$ and we can simplify further. Therefore, our final answer is\n\n$$\n\\begin{aligned}2\\cdot |a|\\cdot \\sqrt{2} & = \\\\ 2\\cdot a\\cdot \\sqrt{2} & = \\\\ 2a\\sqrt{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069224 :knowledge-point/_questions [{:db/id #edb/ref 17592186068852 :knowledge-point/id #uuid "4df00200-f680-53f3-9b49-700b9ac14204" :knowledge-point/title "Simplifying a Radical Expression That Is Not a Perfect Square With Domain Restrictions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9604b624-c03b-5347-ba7b-8d49db33c3f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y\\sqrt{8y}" :db/id #edb/ref 17592186066523} {:answer/id #uuid "e9919e2c-cbe1-5c41-a1b1-57be787bd108" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4y\\sqrt{4y}" :db/id #edb/ref 17592186066525} {:answer/id #uuid "4ab5aca2-34cf-511d-b92f-1e7702541d5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4y\\sqrt{2y}" :db/id #edb/ref 17592186066526} {:answer/id #uuid "64285070-c3b5-5963-aa25-3bf6449987b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8y\\sqrt{2y}" :db/id #edb/ref 17592186066527} {:answer/id #uuid "effe64da-d5ba-51cb-959c-be6a879f598d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{y}^{2}\\sqrt{8y}" :db/id #edb/ref 17592186500976}] :answer-field/correct {:answer/id #uuid "4ab5aca2-34cf-511d-b92f-1e7702541d5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4y\\sqrt{2y}" :db/id #edb/ref 17592186066526} :answer-field/id #uuid "e9291b82-8dbe-52ac-a018-87c4d7471cd9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066522}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "09ae7f43-8e12-5216-a76e-64db91dde2b1" :question/math-academy-id "q-3052" :question/problem "Simplify $\\sqrt{32{y}^{3}}$ given that $y\\ge 0.$" :question/worked-solution "We first write $32{y}^{3}$ as the product $16{y}^{2}\\cdot 2y$ which contains a perfect square $(16{y}^{2}).$ Then, we separate the product into two separate radicals, one of which can be simplified:\n\n$$\n\\begin{aligned}\\sqrt{32{y}^{3}} & = \\\\ \\sqrt{16{y}^{2}\\cdot 2y} & = \\\\ \\sqrt{(4y)^{2}\\cdot 2y} & = \\\\ \\sqrt{(4y)^{2}}\\cdot \\sqrt{2y} & = \\\\ |4y|\\cdot \\sqrt{2y} & = \\\\ |4|\\cdot |y|\\cdot \\sqrt{2y} & = \\\\ 4\\cdot |y|\\cdot \\sqrt{2y}\\end{aligned}\n$$\n\nSince $y\\ge 0,$ we have $|y|=y,$ and we can simplify further. Therefore, our final answer is\n\n$$\n\\begin{aligned}4\\cdot |y|\\cdot \\sqrt{2y} & = \\\\ 4\\cdot y\\cdot \\sqrt{2y} & = \\\\ 4y\\sqrt{2y}.\\end{aligned}\n$$"}]}
