b/ensure [:answer/validate]} {:db/id "question-2dfcbd6d-7083-5b50-9b60-a0306b88077d" :question/id #uuid "2dfcbd6d-7083-5b50-9b60-a0306b88077d" :question/math-academy-id "q-184000" :question/problem "Suppose $n=6p+10q+3,$ where $p,q\\in Z.$ Complete the following argument." :question/worked-solution "An integer is *odd* if it can be written as $2a+1,$ where $a$ is an integer.\n\nNow, note the following regarding the expression $6p+10q+3:$\n\n- All terms, apart from the constant term, have a common factor of $2.$\n\n- The constant term can be written as $3=2+1.$\n\nTherefore, we complete our argument as follows:\n\nThe number $n$ is $\\text{odd}$ since\n\n$$\n\\begin{aligned}n & =6p+10q+3 \\\\  & =(6p+10q+2)+1 \\\\  & =2({{3p+5q+1}_{⏟}}_{a})+1 \\\\  & =2a+1,\\end{aligned}\n$$\n\nwhere $a=3p+5q+1\\in Z.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-599fafaf-53b4-566d-b85e-61784accfaa7" "answer-field-0d1db078-9bdf-5e11-81df-b0a27eb020dd" "answer-field-1579657b-4653-5d9b-b056-4a5d08d0951c" "answer-field-0f9fa772-542e-57dc-a55b-6d5e08a075a7"] :db/ensure [:question/validate]} {:db/id "answer-field-599fafaf-53b4-566d-b85e-61784accfaa7" :answer-field/id #uuid "599fafaf-53b4-566d-b85e-61784accfaa7" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-de067941-98f6-523c-814d-b88b811d38ec" :answer-field/choices ["answer-d52db73b-f696-576b-aae7-dbf8af2e3f23" "answer-de067941-98f6-523c-814d-b88b811d38ec"] :db/ensure [:answer-field/validate]} {:db/id "answer-d52db73b-f696-576b-aae7-dbf8af2e3f23" :answer/id #uuid "d52db73b-f696-576b-aae7-dbf8af2e3f23" :answer/type :answer.type/text :answer/value "even" :db/ensure [:answer/validate]} {:db/id "answer-de067941-98f6-523c-814d-b88b811d38ec" :answer/id #uuid "de067941-98f6-523c-814d-b88b811d38ec" :answer/type :answer.type/text :answer/value "odd" :db/ensure [:answer/validate]} {:db/id "answer-field-0d1db078-9bdf-5e11-81df-b0a27eb020dd" :answer-fie