ion/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2dfcbd6d-7083-5b50-9b60-a0306b88077d" :question/math-academy-id "q-184000" :question/problem "Suppose $n=6p+10q+3,$ where $p,q\\in Z.$ Complete the following argument." :question/worked-solution "An integer is *odd* if it can be written as $2a+1,$ where $a$ is an integer.\n\nNow, note the following regarding the expression $6p+10q+3:$\n\n- All terms, apart from the constant term, have a common factor of $2.$\n\n- The constant term can be written as $3=2+1.$\n\nTherefore, we complete our argument as follows:\n\nThe number $n$ is $\\text{odd}$ since\n\n$$\n\\begin{aligned}n & =6p+10q+3 \\\\  & =(6p+10q+2)+1 \\\\  & =2({{3p+5q+1}_{⏟}}_{a})+1 \\\\  & =2a+1,\\end{aligned}\n$$\n\nwhere $a=3p+5q+1\\in Z.$"}] [{:db/id #edb/ref 17592186407124 :knowledge-point/_questions [{:db/id #edb/ref 17592186171934 :knowledge-point/id #uuid "fd14b427-db87-5c61-bcd2-4ecec58450a3" :knowledge-point/title "Proving Parity of Non-Linear Expressions With Multiple Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80db6ff3-8290-5af1-9271-34f8a4c983ed" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "odd" :db/id #edb/ref 17592186407057} {:answer/id #uuid "cddf6ea8-210f-5b6d-a034-2fcb454662cc" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "even" :db/id #edb/ref 17592186407080}] :answer-field/correct {:answer/id #uuid "cddf6ea8-210f-5b6d-a034-2fcb454662cc" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "even" :db/id #edb/ref 17592186407080} :answer-field/id #uuid "0e425e18-ff25-58e7-bd5e-c08e391f662c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186407099} {:answer-field/choices [{:answer/id #uuid "2a15e0b4-cd8e-54e4-8da9-edb1ea630a53" :answer/type {:db/id