#{[{:db/id #edb/ref 17592186171735 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186171933 :knowledge-point/id #uuid "9ee426ac-48be-52e8-a0bb-b48b9087cf97" :knowledge-point/title "Proving Parity of Non-Linear Expressions"}] :question/id #uuid "2423fe12-360a-5bda-9492-e3ed5f95435d" :question/math-academy-id "e-13300" :question/problem "Suppose $n=4m^2+2m-1,$ where $m \\in \\mathbb{Z}.$ Construct an argument that explains why $n$ is odd." :question/worked-solution "An integer is *odd* if it can be written as $2a + 1,$ where $a$ is an integer.\n\nNow, note the following regarding the expression $4m^2+2m-1{:}$\n\n- All terms, apart from the constant term, have a common factor of $2.$\n\n- The constant term can be written as $-1 = -2+1.$\n\nTherefore, we complete our argument as follows:\n\nThe number $n$ is $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{odd}}$ since\n\n$$\n\\begin{aligned}n & =4{m}^{2}+2m-1 \\\\  & =(4{m}^{2}+2m-2)+1 \\\\  & =2({{2{m}^{2}+m-1}_{⏟}}_{a})+1 \\\\  & =2a+1,\\end{aligned}\n$$\n\nwhere $a=\\bbox[3pt,Gainsboro]{\\color{blue}2m^2+m-1}$ is an integer."}] [{:db/id #edb/ref 17592186171736 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186171934 :knowledge-point/id #uuid "fd14b427-db87-5c61-bcd2-4ecec58450a3" :knowledge-point/title "Proving Parity of Non-Linear Expressions With Multiple Variables"}] :question/id #uuid "00e763aa-c56c-5201-ae3b-9a4cec1af87d" :question/math-academy-id "e-13302" :question/problem "Suppose $n=2pq - 4q + 5,$ where $p,q \\in \\mathbb{Z}.$ Construct an argument that explains why $n$ is odd." :question/worked-solution "An integer is *odd* if it can be written as $2a + 1,$ where $a$ is an integer.\n\nNow, note the following regarding the expression $2pq - 4q + 5 {:}$\n\n- All terms, apart from the constant term, have a common factor of $2.$\n\n- The constant term can be written as $5 = 4+1.$\n\nTherefore, we complete our argument as follows:\n\nThe number $n$ is $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{odd}}$ since\n\n$$\n\\begin{aligned}n & =2pq-4q+5 \\\\  & =(2pq-4q+4)+1 \\\\  & =2({{pq-2q+2}_{⏟}}_{a})+1 \\\\  & =2a+1,\\end{aligned}\n$$\n\nwhere $a= \\bbox[3pt,Gainsboro]{\\color{blue} pq - 2q + 2\\in \\mathbb Z }.$"}] [{:db/id #edb/ref 17592186171737 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186171931 :knowledge-point/id #uuid "ba331138-93b8-5fb0-918b-17dc6d3e4029" :knowledge-point/title "Showing a Linear Expression Is Even"}] :question/id #uuid "e0de7c98-f98c-516a-8636-98eb63d36f6d" :question/math-academy-id "e-13305" :question/problem "Suppose $n=10-30p,$ where $p \\in \\mathbb{Z}.$ Construct an argument that explains why $n$ is even." :question/worked-solution "An integer is *even* if it can be written as $2a,$ where $a$ is an integer.\n\nTherefore, we complete our argument as follows:\n\nThe number $n$ is even since\n\n$$\n\\begin{aligned}n & =10-30p \\\\  & =2({{5-15p}_{⏟}}_{a}) \\\\  & =2a,\\end{aligned}\n$$\n\nwhere we have defined $a=\\bbox[3pt,Gainsboro]{\\color{blue}5-15p},$ which is an integer."}] [{:db/id #edb/ref 17592186171738 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186171932 :knowledge-point/id #uuid "4090596b-29f5-5dcc-93f8-ff30727e250b" :knowledge-point/title "Showing a Linear Expression Is Odd"}] :question/id #uuid "9e1e05cf-2b3a-5189-b913-06ba1a19d88e" :question/math-academy-id "e-13306" :question/problem "Suppose $n=3-4m,$ where $m \\in \\mathbb{Z}.$ Construct an argument that explains why $n$ is odd." :question/worked-solution "An integer is *odd* if it can be written as $2a + 1,$ where $a$ is an integer.\n\nTherefore, we complete our argument as follows:\n\nThe number $n$ is *odd* since\n\n$$\n\\begin{aligned}n & =3-4m \\\\  & =(-4m+2)+1 \\\\  & =2({{-2m+1}_{⏟}}_{a})+1 \\\\  & =2a+1,\\end{aligned}\n$$\n\nwhere we have defined $a=\\bbox[3pt,Gainsboro]{\\color{blue}-2m+1},$ which is an integer."}] [{:db/id #edb/ref 17592186407123 :knowledge-point/_questions [{:db/id #edb/ref 17592186171934 :knowledge-point/id #uuid "fd14b427-db87-5c61-bcd2-4ecec58450a3" :knowledge-point/title "Proving Parity of Non-Linear Expressions With Multiple Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1875316b-c298-57dd-81ef-a719c982df28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "5q" :db/id #edb/ref 17592186407026} {:answer/id #uuid "1e0f3578-35bd-57e9-8bfb-104124232ee6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "5q-2" :db/id #edb/ref 17592186407029} {:answer/id #uuid "9658d9ad-9976-5ff1-838a-e7525f655f86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "5q+1" :db/id #edb/ref 17592186407061}] :answer-field/correct {:answer/id #uuid "9658d9ad-9976-5ff1-838a-e7525f655f86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "5q+1" :db/id #edb/ref 17592186407061} :answer-field/id #uuid "0d1db078-9bdf-5e11-81df-b0a27eb020dd" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186407097} {:answer-field/choices [{:answer/id #uuid "2d3277a9-0577-57f2-a746-5e23f9e67b14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "3p+5q+1\\in N" :db/id #edb/ref 17592186407033} {:answer/id #uuid "47f4d575-1a76-59a3-b1f3-e6ae4d7e0671" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "3p+5q\\in N" :db/id #edb/ref 17592186407041} {:answer/id #uuid "4f4932fc-e91d-5cf8-8b70-ec8c461adac0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "3p+5q+1\\in Z" :db/id #edb/ref 17592186407043} {:answer/id #uuid "9689cff8-3246-5779-b3c9-97e2d6ac5fca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "3p+5q\\in Z" :db/id #edb/ref 17592186407062}] :answer-field/correct {:answer/id #uuid "4f493