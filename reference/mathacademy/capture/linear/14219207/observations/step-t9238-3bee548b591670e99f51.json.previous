roke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n<g transform=\"translate(167,0)\">\n<g transform=\"translate(-11,0)\">\n<g transform=\"translate(360,3212)\">\n <use xlink:href=\"#E8-MJMATHI-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E8-MJMAIN-32\" x=\"809\" y=\"583\"></use>\n <use xlink:href=\"#E8-MJMAIN-2212\" x=\"1248\" y=\"0\"></use>\n <use xlink:href=\"#E8-MJMAIN-37\" x=\"2249\" y=\"0\"></use>\n <use xlink:href=\"#E8-MJMATHI-78\" x=\"2749\" y=\"0\"></use>\n</g>\n<g transform=\"translate(0,701)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"3442\" height=\"60\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(60,676)\">\n <use xlink:href=\"#E8-MJMATHI-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E8-MJMAIN-32\" x=\"809\" y=\"513\"></use>\n <use xlink:href=\"#E8-MJMAIN-2212\" x=\"1248\" y=\"0\"></use>\n <use xlink:href=\"#E8-MJMAIN-37\" x=\"2249\" y=\"0\"></use>\n <use xlink:href=\"#E8-MJMATHI-78\" x=\"2749\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E8-MJMATHI-78\" x=\"1434\" y=\"-686\"></use>\n</g>\n</g>\n<g transform=\"translate(1386,-1597)\">\n <use xlink:href=\"#E8-MJMATHI-78\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E8-MJMAIN-2212\" x=\"794\" y=\"0\"></use>\n <use xlink:href=\"#E8-MJMAIN-37\" x=\"1795\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E8-MJMATHI-78\" x=\"3109\" y=\"-3397\"></use>\n</g>\n<g transform=\"translate(3671,0)\">\n<g transform=\"translate(0,3212)\">\n <use xlink:href=\"#E8-MJMAIN-3D\" x=\"277\" y=\"0\"></use>\n <use xlink:href=\"#E8-MJMAIN-30\" x=\"1334\" y=\"0\"></use>\n</g>\n<g transform=\"translate(0,701)\">\n <use xlink:href=\"#E8-MJMAIN-3D\" x=\"277\" y=\"0\"></use>\n<g transform=\"translate(1334,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"692\" height=\"60\" x=\"0\" y=\"220\"></rect>\n <use xlink:href=\"#E8-MJMAIN-30\" x=\"96\" y=\"676\"></us