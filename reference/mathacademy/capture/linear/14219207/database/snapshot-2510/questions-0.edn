#{[{:db/id #edb/ref 17592186068511 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068765 :knowledge-point/id #uuid "312677d3-ca04-520e-ae60-1725b65eefdb" :knowledge-point/title "Solving When the Right-Hand Side Is Zero"}] :question/id #uuid "580ca72e-31ba-591c-a5c4-08234ac9d2e0" :question/math-academy-id "e-14827" :question/problem "Solve for $n$ where $n^2 +12n = 0.$" :question/worked-solution "First, we factor the left-hand side.\n\n$$\n\\begin{aligned}{n}^{2}+12n & =0 \\\\ n(n+12) & =0\\end{aligned}\n$$\n\nThen, we apply the zero product rule to get \n\n$$\nn=0 \\qquad\\text{or}\\qquad n+12=0,\n$$\n\nwhich in turn gives \n\n$$\nn=0 \\qquad\\text{or}\\qquad n=-12.\n$$\n\nTherefore, the solutions are $n=-12,0.$"}] [{:db/id #edb/ref 17592186068512 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068766 :knowledge-point/id #uuid "51760e81-8cb9-557f-b010-196be8e5e1b2" :knowledge-point/title "Solving When the Right-Hand Side Is Not Zero"}] :question/id #uuid "8e7b0730-4273-5eef-a9a3-4a9e91c62ff4" :question/math-academy-id "e-14829" :question/problem "Solve $3p^2 = 5p.$" :question/worked-solution "First, we move all of the terms to the left-hand side and then factor:\n\n$$\n\\eqalign{\n\t3p^2 &= 5p \\[3pt]\n\t3p^2 - 5p &= 0 \\[3pt]\n\tp(3p - 5) &= 0\n}\n$$\n\nSo, by the zero product rule, we have\n\n$$\np=0 \\qquad\\text{or}\\qquad 3p-5=0,\n$$\n\nwhich in turn gives \n\n$$\np=0 \\qquad\\text{or}\\qquad p=\\dfrac{5}{3}.\n$$\n\nTherefore, the solutions are $p=0,\\dfrac{5}{3}.$"}] [{:db/id #edb/ref 17592186068513 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068767 :knowledge-point/id #uuid "de81b6a4-0c3c-5f2f-b844-2cef931bec29" :knowledge-point/title "Solving When Both Sides are Quadratic"}] :question/id #uuid "4003ea24-f1cf-5abb-a3cb-033f8a11a6cb" :question/math-academy-id "e-14831" :question/problem "Solve the equation  $6x^2 +2x -2= 8x^2- x -2.$" :question/worked-solution "First, we move all of the terms to the left-hand side and then factor:\n\n$$\n\\begin{aligned}6{x}^{2}+2x-2 & =8{x}^{2}-x-2 \\\\ 6{x}^{2}+2x-2-(8{x}^{2}-x-2) & =0 \\\\ 6{x}^{2}+2x-2-8{x}^{2}+x+2 & =0 \\\\ (6{x}^{2}-8{x}^{2})+(2x+x)+(-2+2) & =0 \\\\ -2{x}^{2}+3x+0 & =0 \\\\ -2{x}^{2}+3x & =0 \\\\ x(-2x+3) & =0\\end{aligned}\n$$\n\nSo, by the zero product rule, we have\n\n$$\nx=0 \\qquad\\text{or}\\qquad -2x + 3=0,\n$$\n\nwhich in turn gives \n\n$$\nx=0 \\qquad\\text{or}\\qquad x=\\dfrac{3}{2}.\n$$\n\nTherefore, the solutions are $x=0,\\dfrac{3}{2}.$"}] [{:db/id #edb/ref 17592186530456 :knowledge-point/_questions [{:db/id #edb/ref 17592186068766 :knowledge-point/id #uuid "51760e81-8cb9-557f-b010-196be8e5e1b2" :knowledge-point/title "Solving When the Right-Hand Side Is Not Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d871265-9745-50ac-9f9f-ff7a82bad2fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186529678}] :answer-field/correct {:answer/id #uuid "2d871265-9745-50ac-9f9f-ff7a82bad2fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186529678} :answer-field/id #uuid "202e3786-76c0-5805-95d7-8f7c83dc23c3" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530241} {:answer-field/choices [{:answer/id #uuid "7bd5f524-9ed8-5a26-bac4-febe5ddeb203" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186529894}] :answer-field/correct {:answer/id #uuid "7bd5f524-9ed8-5a26-bac4-febe5ddeb203" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186529894} :answer-field/id #uuid "81ff2d58-8983-5b2d-9543-a2ae613d6fa6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530320}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "51c36057-7763-517f-b083-7d2e76df4e9d" :question/math-academy-id "q-220342" :question/problem "In **ascending order**, the solutions to $3{t}^{2}=\\frac{t}{3}$ are $t=${{field-1}} and $t=$\n{{field-2}}." :question/worked-solution "First, we move all of the terms to the left-hand side and then factor:\n\n$$\n\\begin{aligned}3{t}^{2} & =\\frac{t}{3} \\\\ 3{t}^{2}-\\frac{t}{3} & =0 \\\\ t(3t-\\frac{1}{3}) & =0\\end{aligned}\n$$\n\nThen, we apply the zero product rule to get\n\n$$\nt=0\\,\\text{or}\\,3t-\\frac{1}{3}=0,\n$$\n\nwhich in turn gives\n\n$$\nt=0\\,\\text{or}\\,t=\\frac{1}{9}.\n$$\n\nTherefore, the solutions are $t=0$ and $t=\\frac{1}{9}.$"}] [{:db/id #edb/ref 17592186530510 :knowledge-point/_questions [{:db/id #edb/ref 17592186068765 :knowledge-point/id #uuid "312677d3-ca04-520e-ae60-1725b65eefdb" :knowledge-point/title "Solving When the Right-Hand Side Is Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "063b4024-4346-54ee-8c39-f524da9d179e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186529587}] :answer-field/correct {:answer/id #uuid "063b4024-4346-54ee-8c39-f524da9d179e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186529587} :answer-field/id #uuid "13097025-abc7-5fd8-ac39-c0822ec5c38a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530231} {:answer-field/choices [{:answer/id #uuid "731fcee1-1015-58b3-a75b-a6066cd86086" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186529871}] :answer-field/correct {:answer/id #uuid "731fcee1-1015-58b3-a75b-a6066cd86086" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186529871} :answer-field/id #uuid "3c399da4-ca9e-5974-bb9e-d6c133075b6b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530262}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b1273579-55cb-579f-b627-8d3491d58407" :question/math-academy-id "q-223708" :question/problem "In **ascending order**, the solutions to ${y}^{2}-y=0$ are $y=${{field-1}} and $y=$\n{{field-2}}." :question/worked-solution "First, we factor the left-hand side:\n\n$$\n\\begin{aligned}{y}^{2}-y & =0 \\\\ y(y-1) & =0\\end{aligned}\n$$\n\nThen, we apply the zero product rule to get\n\n$$\ny=0\\,\\text{or}\\,y-1=0,\n$$\n\nwhich in turn gives\n\n$$\ny=0\\,\\text{or}\\,y=1.\n$$\n\nTherefore, the solutions are $y=0$ and $y=1.$"}] [{:db/id #edb/ref 17592186530473 :knowledge-point/_questions [{:db/id #edb/ref 17592186068765 :knowledge-point/id #uuid "312677d3-ca04-520e-ae60-1725b65eefdb" :knowledge-point/title "Solving When the Right-Hand Side Is Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "629e6591-71d0-53ae-a34c-1497f4a3b29c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186529822}] :answer-field/correct {:answer/id #uuid "629e6591-71d0-53ae-a34c-1497f4a3b29c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186529822} :answer-field/id #uuid "1ec19aa7-3843-53b4-ad93-0c17da1d1f0a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530238} {:answer-field/choices [{:answer/id #uuid "cd20007e-a1bf-5680-a2d9-48f921d0d14c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186530094}] :answer-field/correct {:answer/id #uuid "cd20007e-a1bf-5680-a2d9-48f921d0d14c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186530094} :answer-field/id #uuid "f44ed7f0-c74c-51b2-b88d-368b62c92945" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530398}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e107289-3e5f-5156-a2e0-991fb3d001dd" :question/math-academy-id "q-223721" :question/problem "In **ascending order**, the solutions to $4{m}^{2}+5m=0$ are $m=${{field-1}} and $m=$\n{{field-2}}." :question/worked-solution "First, we factor the left-hand side:\n\n$$\n\\begin{aligned}4{m}^{2}+5m & =0 \\\\ m(4m+5) & =0\\end{aligned}\n$$\n\nThen, we apply the zero product rule to get\n\n$$\nm=0\\,\\text{or}\\,4m+5=0,\n$$\n\nwhich in turn gives\n\n$$\nm=0\\,\\text{or}\\,m=-\\frac{5}{4}.\n$$\n\nTherefore, the solutions are $m=-\\frac{5}{4}$ and $m=0.$"}] [{:db/id #edb/ref 17592186069161 :knowledge-point/_questions [{:db/id #edb/ref 17592186068766 :knowledge-point/id #uuid "51760e81-8cb9-557f-b010-196be8e5e1b2" :knowledge-point/title "Solving When the Right-Hand Side Is Not Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08260f9d-0f7d-5e3a-875c-8660c7a3982f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186529592}] :answer-field/correct {:answer/id #uuid "08260f9d-0f7d-5e3a-875c-8660c7a3982f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186529592} :answer-field/id #uuid "14879c25-f50a-5f08-9d0f-fcc77a6f475b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186066207} {:answer-field/choices [{:answer/id #uuid "f6541888-fe03-58d9-8138-dadc1e8f6450" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186530191}] :answer-field/correct {:answer/id #uuid "f6541888-fe03-58d9-8138-dadc1e8f6450" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186530191} :answer-field/id #uuid "78500993-2a4f-5641-8cd7-0bc54ca0158b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186066208}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "18ebe432-ec65-5059-b100-0754b81eac7b" :question/math-academy-id "q-223741" :question/problem "In **ascending order**, the solutions to $\\frac{2}{5}{z}^{2}=-2z$ are $z=${{field-1}} and $z=$\n{{field-2}}." :question/worked-solution "First, we move all of the terms to the left-hand side and then factor:\n\n$$\n\\begin{aligned}\\frac{2}{5}{z}^{2} & =-2z \\\\ \\frac{2}{5}{z}^{2}+2z & =0 \\\\ \\frac{2}{5}z(z+5) & =0\\end{aligned}\n$$\n\nThen, we apply the zero product rule to get\n\n$$\n\\frac{2}{5}z=0\\,\\text{or}\\,z+5=0,\n$$\n\nwhich in turn gives\n\n$$\nz=0\\,\\text{or}\\,z=-5.\n$$\n\nTherefore, the solutions are $z=-5$ and $z=0.$"}] [{:db/id #edb/ref 17592186530515 :knowledge-point/_questions [{:db/id #edb/ref 17592186068767 :knowledge-point/id #uuid "de81b6a4-0c3c-5f2f-b844-2cef931bec29" :knowledge-point/title "Solving When Both Sides are Quadratic"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a26bf7df-34a2-59ce-a047-995bb3f92dd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=0,4" :db/id #edb/ref 17592186529982} {:answer/id #uuid "b16ea246-d4c6-54c5-a144-ce73e8205a6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=-4,4" :db/id #edb/ref 17592186530022} {:answer/id #uuid "ce81a382-d2c4-543c-9aa2-f3d3ef87a4ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4" :db/id #edb/ref 17592186530099} {:answer/id #uuid "ec0072e3-ac11-5027-8672-d8f98ce2d6a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=0,-4" :db/id #edb/ref 17592186530171} {:answer/id #uuid "f41bf8f6-3517-583a-8ca4-fdcd7e69df4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=-4" :db/id #edb/ref 17592186530187}] :answer-field/correct {:answer/id #uuid "ec0072e3-ac11-5027-8672-d8f98ce2d6a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=0,-4" :db/id #edb/ref 17592186530171} :answer-field/id #uuid "e8df31f3-59b3-58f6-8b3d-b72e6e014b3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530388}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bfb7af78-939c-52a0-a55c-b15bc79862e1" :question/math-academy-id "q-23715" :question/problem "Solve the equation $4{z}^{2}+7z-1=3{z}^{2}+3z-1.$" :question/worked-solution "First, we move all of the terms to the left-hand side and then factor:\n\n$$\n\\begin{aligned}4{z}^{2}+7z-1 & =3{z}^{2}+3z-1 \\\\ (4{z}^{2}+7z-1)-(3{z}^{2}+3z-1) & =0 \\\\ 4{z}^{2}+7z-1-3{z}^{2}-3z+1 & =0 \\\\ (4{z}^{2}-3{z}^{2})+(7z-3z)+(-1+1) & =0 \\\\ {z}^{2}+4z & =0 \\\\ z(z+4) & =0\\end{aligned}\n$$\n\nThen, we apply the zero product rule to get\n\n$$\nz=0\\,\\text{or}\\,z+4=0,\n$$\n\nwhich in turn gives\n\n$$\nz=0\\,\\text{or}\\,z=-4.\n$$\n\nTherefore, the solutions are $z=0,-4.$"}] [{:db/id #edb/ref 17592186530505 :knowledge-point/_questions [{:db/id #edb/ref 17592186068767 :knowledge-point/id #uuid "de81b6a4-0c3c-5f2f-b844-2cef931bec29" :knowledge-point/title "Solving When Both Sides are Quadratic"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fedfe26-a02e-52b3-84ea-784270093329" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-4,0" :db/id #edb/ref 17592186529686} {:answer/id #uuid "3d9b6c73-c2ec-5d4b-9286-8076ad2a3fb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0,4" :db/id #edb/ref 17592186529724} {:answer/id #uuid "a990eba7-1df8-5328-abb1-967fc87af018" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186530002} {:answer/id #uuid "b400ce2f-bacb-5dd3-be52-94e8a8b02fd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-4" :db/id #edb/ref 17592186530029} {:answer/id #uuid "f929d974-67f5-5452-a6a4-f6d429ca40a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186530197}] :answer-field/correct {:answer/id #uuid "3d9b6c73-c2ec-5d4b-9286-8076ad2a3fb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0,4" :db/id #edb/ref 17592186529724} :answer-field/id #uuid "ff633b31-e805-5481-a76c-39ad64dfb129" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530413}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a8446f82-4129-51d2-b187-039c54ac0008" :question/math-academy-id "q-80057" :question/problem "Solve the equation $3{y}^{2}-3y=2{y}^{2}+y.$" :question/worked-solution "First, we move all of the terms to the left-hand side and then factor:\n\n$$\n\\begin{aligned}3{y}^{2}-3y & =2{y}^{2}+y \\\\ 3{y}^{2}-3y-(2{y}^{2}+y) & =0 \\\\ 3{y}^{2}-3y-2{y}^{2}-y & =0 \\\\ (3{y}^{2}-2{y}^{2})+(-3y-y) & =0 \\\\ {y}^{2}-4y & =0 \\\\ y(y-4) & =0\\end{aligned}\n$$\n\nThen, we apply the zero product rule to get\n\n$$\ny=0\\,\\text{or}\\,y-4=0,\n$$\n\nwhich in turn gives\n\n$$\ny=0\\,\\text{or}\\,y=4.\n$$\n\nTherefore, the solutions are $y=0,4.$"}]}
