#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186489333} :activity/id #uuid "a131be7b-68d2-57db-b50e-5c3bbbbafaae" :activity/scope {:db/id #edb/ref 17592186049843 :topic/id #uuid "18188755-d27b-5ea0-8e93-047aeb60e2d7" :topic/math-academy-id 376} :activity/steps [{:db/id #edb/ref 17592186489321 :step/content {:db/id #edb/ref 17592186489289 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20c639d7-7a27-579c-9de2-bfc34b74a330" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-yz" :db/id #edb/ref 17592186488537} {:answer/id #uuid "2c490ecf-5f63-5a62-a464-1073d7062fec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "yz" :db/id #edb/ref 17592186488565} {:answer/id #uuid "307e1365-05e4-5bc5-a68f-ed2c32a38c7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "|yz|" :db/id #edb/ref 17592186488574} {:answer/id #uuid "484f6643-41cd-55bf-ae3f-2f1cfc9ad32a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y|z|" :db/id #edb/ref 17592186488614} {:answer/id #uuid "ef935ffb-6785-53bf-9c0d-9df9b9b9ef91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm yz" :db/id #edb/ref 17592186488973}] :answer-field/correct {:db/id #edb/ref 17592186488574} :answer-field/id #uuid "c670e448-1e22-5196-8fb8-d4e5db38967e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489130}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f02573a0-2790-58d2-b6cc-7bac38c415b0" :question/math-academy-id "q-129432" :question/problem "$\\sqrt{{y}^{2}{z}^{2}}=$" :question/worked-solution "Remember that the square root of a perfect square can be simplified using absolute value.\n\n$$\n\\sqrt{{x}^{2}}=|x|\n$$\n\nAlso, we notice that ${y}^{2}$ and ${z}^{2}$ are perfect squares.\n\nFirst, we write the expression under the square root as a perfect square:\n\n$$\n\\begin{aligned}\\sqrt{{y}^{2}{z}^{2}} & =\\sqrt{y\\cdot y\\cdot z\\cdot z} \\\\  & =\\sqrt{y\\cdot z\\cdot y\\cdot z} \\\\  & =\\sqrt{(yz)\\cdot (yz)} \\\\  & =\\sqrt{(yz)^{2}}\\end{aligned}\n$$\n\nThen, we take the absolute value of the squared quantity:\n\n$$\n\\begin{aligned}\\sqrt{(yz)^{2}} & =|yz|\\end{aligned}\n$$"} :step/id #uuid "580c91a1-4c77-59fd-b9e9-6a409f2c4647" :step/next {:db/id #edb/ref 17592186489326}} {:db/id #edb/ref 17592186489326 :step/content {:db/id #edb/ref 17592186489234 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fb06393-6aac-50f5-a04b-9283e7529b0f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11|cd|" :db/id #edb/ref 17592186488690} {:answer/id #uuid "d516194b-16c2-53ca-ab0c-da1f099bf768" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11|c|d" :db/id #edb/ref 17592186488908} {:answer/id #uuid "da17cde0-38b7-57ed-9d96-55cb435c49c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm 11cd" :db/id #edb/ref 17592186488923} {:answer/id #uuid "efc7ea96-0e54-53a9-8e3a-8267aca4bace" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11c|d|" :db/id #edb/ref 17592186488975} {:answer/id #uuid "f133a350-9010-5f13-9ae6-3042c70926c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11cd" :db/id #edb/ref 17592186488980}] :answer-field/correct {:db/id #edb/ref 17592186488690} :answer-field/id #uuid "f8e5500d-4d6c-5ee8-8d88-044948dcf393" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489164}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7c4e2820-92a5-519d-9225-25cc4948f0c9" :question/math-academy-id "q-129436" :question/problem "$\\sqrt{121{c}^{2}{d}^{2}}=$" :question/worked-solution "Remember that the square root of a perfect square can be simplified using absolute value.\n\n$$\n\\sqrt{{x}^{2}}=|x|\n$$\n\nAlso, we notice that $121,{c}^{2},$ and ${d}^{2}$ are perfect squares.\n\nFirst, we write the expression under the square root as a perfect square:\n\n$$\n\\begin{aligned}\\sqrt{121{c}^{2}{d}^{2}} & =\\sqrt{{11}^{2}\\cdot {c}^{2}\\cdot {d}^{2}} \\\\  & =\\sqrt{11\\cdot 11\\cdot c\\cdot c\\cdot d\\cdot d} \\\\  & =\\sqrt{11\\cdot c\\cdot d\\cdot 11\\cdot c\\cdot d} \\\\  & =\\sqrt{(11cd)\\cdot (11cd)} \\\\  & =\\sqrt{(11cd)^{2}}\\end{aligned}\n$$\n\nThen, we take the absolute value of the squared quantity and simplify using the rules of absolute value:\n\n$$\n\\begin{aligned}\\sqrt{(11cd)^{2}} & =|11cd| \\\\  & =|11|\\cdot |cd| \\\\  & =11|cd|\\end{aligned}\n$$"} :step/id #uuid "71d5e5ee-5255-55c6-92c2-3b6a9653dcc6"} {:db/id #edb/ref 17592186489333 :step/content {:db/id #edb/ref 17592186489184 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aec2d0b-0038-5b9d-8e4f-821e3fd956b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm ab" :db/id #edb/ref 17592186488529} {:answer/id #uuid "677e43b4-9e76-52a3-a1bb-1004c237476a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "ab" :db/id #edb/ref 17592186488670} {:answer/id #uuid "99522d80-934c-58f8-8645-3e3d69f47b0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a|b|" :db/id #edb/ref 17592186488778} {:answer/id #uuid "9f014637-b6bb-5d87-a79d-711ebb7c4222" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "|a|b" :db/id #edb/ref 17592186488784} {:answer/id #uuid "a8914752-237a-5f09-b64c-97f60b10586b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "|ab|" :db/id #edb/ref 17592186488805}] :answer-field/correct {:db/id #edb/ref 17592186488805} :answer-field/id #uuid "e9a1e499-9cd1-5d15-a079-6c7d6a1a34e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489150}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "180b64b1-b15e-57ee-9a92-ff79a509bb19" :question/math-academy-id "q-129431" :question/problem "$\\sqrt{{a}^{2}{b}^{2}}=$" :question/worked-solution "Remember that the square root of a perfect square can be simplified using absolute value.\n\n$$\n\\sqrt{{x}^{2}}=|x|\n$$\n\nAlso, we notice that ${a}^{2}$ and ${b}^{2}$ are perfect squares.\n\nFirst, we write the expression under the square root as a perfect square:\n\n$$\n\\begin{aligned}\\sqrt{{a}^{2}{b}^{2}} & =\\sqrt{a\\cdot a\\cdot b\\cdot b} \\\\  & =\\sqrt{a\\cdot b\\cdot a\\cdot b} \\\\  & =\\sqrt{(ab)\\cdot (ab)} \\\\  & =\\sqrt{(ab)^{2}}\\end{aligned}\n$$\n\nThen, we take the absolute value of the squared quantity:\n\n$$\n\\begin{aligned}\\sqrt{(ab)^{2}} & =|ab|\\end{aligned}\n$$"} :step/id #uuid "830fe1f9-792b-5b8c-98b4-ab430e7693d7" :step/next {:db/id #edb/ref 17592186489321}}] :activity/title "The Square Root of a Perfect Square With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186488459}]}
