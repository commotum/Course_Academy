Line Intersects an Axis"} :step/id #uuid "53c42827-7f73-5fef-997e-9f666fc35841" :step/math-academy-id 663}] :activity/title "Calculating the Equation of a Tangent Line Using Differentiation" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186092460}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186547125} :activity/id #uuid "70f11865-cb63-5f90-bb94-c66ab6be8368" :activity/scope {:db/id #edb/ref 17592186050644 :topic/id #uuid "5beaefa1-1d02-51a5-90bc-250adca28a57" :topic/math-academy-id 986} :activity/steps [{:db/id #edb/ref 17592186547125 :step/content {:db/id #edb/ref 17592186244126 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "462f21c8-a32c-5cda-84b7-37744e22718b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=16x-8" :db/id #edb/ref 17592186241815} {:answer/id #uuid "4b650713-54c4-53ad-9158-64cadb27ca27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=5x-2" :db/id #edb/ref 17592186241859} {:answer/id #uuid "5726209a-7467-583c-a028-1f93390b638f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=16x-12" :db/id #edb/ref 17592186241970} {:answer/id #uuid "a96129cb-4819-5b81-9f60-2fc2160dba34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=5x-13" :db/id #edb/ref 17592186242665} {:answer/id #uuid "dda5ca10-115e-5cb5-bc36-7f1acf094d5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=x-12" :db/id #edb/ref 17592186243151}] :answer-field/correct {:db/id #edb/ref 17592186241815} :answer-field/id #uuid "ae01ef85-57dd-5226-8116-895f71485c74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243751}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d0e5b8a4-9dc2-5fdd-9f7d-f9d1860644a8" :question/math-academy-id "q-10835" :question/problem "Find the equation of the tangent to the curve  $y=2{x}^{2}+8x$ at the point $(2,24).$" :question/worked-solution "Let $f(x)=2{x}^{2}+8x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}+8x)=4x+8.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(2)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(2)=4(2)+8=16\\,.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=16$ and the coordinates of our point $(2,24),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(24) & =16(x-2) \\\\ y & =16x-32+24 \\\\ y & =16x-8.\\end{aligned}\n$$"} :step/id #uuid "8e022878-16c2-5957-b74e-008a82b54dcb" :step/next {:db/id #edb/ref 17592186547126}} {:db/id #edb/ref 17592186547126 :step/content {:db/id #edb/ref 17592186547002 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42fbe54a-78e8-5015-9ce0-c43783605f0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,-\\frac{6}{5})" :db/id #edb/ref 17592186546401} {:answer/id #uuid "69ddeca3-09f2-58ab-9d78-98c1cd90a178" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-6,0)" :db/id #edb/ref 17592186546482} {:answer/id #uuid "6ba59fb1-af14-5b7b-abe3-1d96725a92c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\frac{6}{5},0)" :db/id #edb/ref 17592186546488} {:answer/id #uuid "9ebd227f-5bff-5ee9-8bd2-a6190e5a4b4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\frac{3}{5},0)" :db/id #edb/ref 17592186546605} {:answer/id #uuid "cc873da9-faeb-5c9f-918f-a7d548331962" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\frac{1}{5},0)" :db/id #edb/ref 17592186546705}] :answer-field/correct {:db/id #edb/ref 17592186546488} :answer-field/id #uuid "4e5755c3-35f7-5f3d-a001-f80f16bfbe50" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186546859}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4e139db0-1707-5607-ac19-864fb4bd55f1" :question/math-academy-id "q-70515" :question/problem "Find where the tangent to the curve $y={x}^{5}+2$ at the point $(-1,1)$ intersects the $x$-axis." :question/worked-solution "Let $f(x)={x}^{5}+2.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{5}+2)=5{x}^{4}\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m={f}^{′}(-1)=5(-1)^{4}=5.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =5(x+1) \\\\ y & =5x+5+1 \\\\ y & =5x+6.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $x$-axis, we set $y=0$ and solve:\n\n$$\n\\begin{aligned}0 & =5x+6 \\\\ x & =-\\frac{6}{5}\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(-\\frac{6}{5},0).$"} :step/id #uuid "8f0e1de1-445c-5ef0-8ebc-283d32ff2db4" :step/next {:db/id #edb/ref 17592186547140}} {:db/id #edb/ref 17592186547140 :step/content {:db/id #edb/ref 17592186546983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3668cf4b-8050-5a96-996b-c27c89d6fa21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186546368}] :answer-field/correct {:db/id #edb/ref 17592186546368} :answer-field/id #uuid "a0bed702-55a8-5fce-ad62-782cfcd3d3f5" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186546897} {:answer-field/choices [{:answer/id #uuid "b6894baa-e048-55ba-9e2f-c9d22cb15c27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186546662}] :answer-field/correct {:db/id #edb/ref 17592186546662} :answer-field/id #uuid "fc3c6a28-5baf-5cae-a10f-967bb181d649" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186546955}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2c14c3ab-0147-5311-bdf2-26e728ddcd5d" :question/math-academy-id "q-304084" :question/problem "Find where the tangent to the curve $y=\\frac{2}{x}+x$ at the point  $(2,3)$ intersects the $x$-axis.\n\nThe tangent intersects the $x$-axis at\n$($\n{{field-1}}$,$\n{{field-2}} $).$" :question/worked-solution "Let $f(x)=\\frac{2}{x}+x.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{x}+x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{x})+\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{-1})+\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =-2{x}^{-2}+1 \\\\  & =-\\frac{2}{{x}^{2}}+1.\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m & ={f}^{′}(2) \\\\  & =-\\frac{2}{{2}^{2}}+1 \\\\  & =-\\frac{2}{4}+1 \\\\  & =-\\frac{1}{2}+1 \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-3 & =\\frac{1}{2}(x-2) \\\\ y & =\\frac{1}{2}x-1+3 \\\\ y & =\\frac{1}{2}x+2.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $x$-axis, we set $y=0$ and solve:\n\n$$\n\\begin{aligned}\\frac{1}{2}x+2 & =0 \\\\ \\frac{1}{2}x & =-2 \\\\ x & =-2\\cdot 2 \\\\ x & =-4\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(-4,0).$"} :step/id #uuid "b17b54ae-3884-5315-bfe6-1b6dd906db79"}] :activity/title "Calculating the Equation of a Tangent Line Using Differentiation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186546243}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186572737} :activity/id #uuid "ee3dec29-739f-5aba-9dd8-caf9ba556d77" :activity/scope {:db/id #edb/ref 17592186050644 :topic/id #uuid "5beaefa1-1d02-51a5-90bc-250adca28a57" :topic/math-academy-id 986} :activity/steps [{:db/id #edb/ref 17592186572737 :step/content {:db/id #edb/ref 17592186244131 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4023cacb-0b89-59d1-8c8b-6d61c0d17d1e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=12x-24" :db/id #edb/ref 17592186241755} {:answer/id #uuid "77cf0c33-c99d-5b91-9e89-0474476ff85e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=7x-18" :db/id #edb/ref 17592186242236} {:answer/id #uuid "793cecc2-c2e1-5354-a5af-f001ff5f9a2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=7x-26" :db/id #edb/ref 17592186242248} {:answer/id #uuid "97c25278-d3ee-5a8e-8d67-b5fba18a7f23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=17x-24" :db/id #edb/ref 17592186242510} {:answer/id #uuid "ea60d5c1-e800-5156-9364-ab34b6e9af40" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=7x+24" :db/id #edb/ref 17592186243257}] :answer-field/correct {:db/id #edb/ref 17592186242236} :answer-field/id #uuid "349dffd7-9667-5fc4-9fbf-06fce500cdfd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243536}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "efd8826d-84db-5bb6-981e-e0d1d3969158" :question/math-academy-id "q-10844" :question/problem "Find the equation of the tangent to the curve $y=2{x}^{2}-5x$ at the point $(3,3).$" :question/worked-solution "Let $f(x)=2{x}^{2}-5x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}-5x)=4x-5.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(3)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(3)=4(3)-5=7.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=7$ and the coordinates of our point $(3,3),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(3) & =7(x-3) \\\\ y & =7x-21+3 \\\\ y & =7x-18.\\end{aligned}\n$$"} :step/id #uuid "17e3807e-561d-5bae-a289-a67058e28376" :step/next {:db/id #edb/ref 17592186572782}} {:db/id #edb/ref 17592186572782 :step/content {:db/id #edb/ref 17592186572690 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2100eb44-8e72-5719-a8fb-e972472e7b8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-2,0)" :db/id #edb/ref 17592186572361} {:answer/id #uuid "22f32eae-9185-592c-b114-6d8226facae0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,0)" :db/id #edb/ref 17592186572364} {:answer/id #uuid "5c20e79a-0749-5b55-81fe-8813ae3eba71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,1)" :db/id #edb/ref 17592186572427} {:answer/id #uuid "935da744-e556-5c18-a8cc-a2c7a2f6857a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-5,0)" :db/id #edb/ref 17592186572474} {:answer/id #uuid "bdb0da78-826f-5f6f-9793-f49944deb785" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,0)" :db/id #edb/ref 17592186572530}] :answer-field/correct {:db/id #edb/ref 17592186572361} :answer-field/id #uuid "f835e1bd-3b54-55df-a86e-257a12043f7d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186572660}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "477025c6-a218-5107-ac1d-dc64cfa74878" :question/math-academy-id "q-103326" :question/problem "Find where the tangent to the curve $y={x}^{4}-5$ at the point $(-1,-4)$ intersects the $x$-axis." :question/worked-solution "Let $f(x)={x}^{4}-5.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{4}-5)=4{x}^{3}\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\nm={f}^{′}(-1)=4(-1)^{3}=-4.\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-4) & =-4(x+1) \\\\ y & =-4x-4-4 \\\\ y & =-4x-8.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $x$-axis, we set $y=0$ and solve:\n\n$$\n\\begin{aligned}0 & =-4x-8 \\\\ x & =-2\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(-2,0).$"} :step/id #uuid "9e3e626e-29a1-5de8-9c2d-8429d574e841" :step/next {:db/id #edb/ref 17592186572791}} {:db/id #edb/ref 17592186572791 :step/content {:db/id #edb/ref 17592186297291 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fe4953c-0983-5464-9362-45c9474d1210" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x" :db/id #edb/ref 17592186295360}] :answer-field/correct {:db/id #edb/ref 17592186295360} :answer-field/id #uuid "91224f8e-576e-5980-8358-902f8e6b2203" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186296932}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "251ee9eb-ffd1-5d74-9058-3b8ed977eb92" :question/math-academy-id "q-304068" :question/problem "Find the equation of the tangent to the curve $y=\\frac{3x+2}{{x}^{2}}$ at the point $(-1,-1).$\n\n$y=$\n{{field-1}}" :question/worked-solution "Let $f(x)=\\frac{3x+2}{{x}^{2}}.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3x+2}{{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3}{x}+\\frac{2}{{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3}{x})+\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{-1})+\\frac{\\text{d}}{\\text{d}x}(2{x}^{-2}) \\\\  & =-3{x}^{-2}-4{x}^{-3} \\\\  & =-\\frac{3}{{x}^{2}}-\\frac{4}{{x}^{3}}.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(-1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(-1) & =-\\frac{3}{(-1)^{2}}-\\frac{4}{(-1)^{3}} \\\\  & =-3+4 \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=1$ and the coordinates of our point $(-1,-1),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-1) & =1\\cdot (x-(-1)) \\\\ y+1 & =x+1 \\\\ y & =x.\\end{aligned}\n$$"} :step/id #uuid "bc81bbf7-dbb8-552e-83e2-d8d2990851b9"}] :activity/title "Calculating the Equation of a Tangent Line Using Differentiation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186572315}]}
