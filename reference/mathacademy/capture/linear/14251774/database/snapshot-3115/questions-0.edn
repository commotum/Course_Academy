#{[{:db/id #edb/ref 17592186244131 :knowledge-point/_questions [{:db/id #edb/ref 17592186092382 :knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4023cacb-0b89-59d1-8c8b-6d61c0d17d1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=12x-24" :db/id #edb/ref 17592186241755} {:answer/id #uuid "77cf0c33-c99d-5b91-9e89-0474476ff85e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=7x-18" :db/id #edb/ref 17592186242236} {:answer/id #uuid "793cecc2-c2e1-5354-a5af-f001ff5f9a2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=7x-26" :db/id #edb/ref 17592186242248} {:answer/id #uuid "97c25278-d3ee-5a8e-8d67-b5fba18a7f23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=17x-24" :db/id #edb/ref 17592186242510} {:answer/id #uuid "ea60d5c1-e800-5156-9364-ab34b6e9af40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=7x+24" :db/id #edb/ref 17592186243257}] :answer-field/correct {:answer/id #uuid "77cf0c33-c99d-5b91-9e89-0474476ff85e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=7x-18" :db/id #edb/ref 17592186242236} :answer-field/id #uuid "349dffd7-9667-5fc4-9fbf-06fce500cdfd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243536}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "efd8826d-84db-5bb6-981e-e0d1d3969158" :question/math-academy-id "q-10844" :question/problem "Find the equation of the tangent to the curve $y=2{x}^{2}-5x$ at the point $(3,3).$" :question/worked-solution "Let $f(x)=2{x}^{2}-5x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}-5x)=4x-5.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(3)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(3)=4(3)-5=7.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=7$ and the coordinates of our point $(3,3),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(3) & =7(x-3) \\\\ y & =7x-21+3 \\\\ y & =7x-18.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297291 :knowledge-point/_questions [{:db/id #edb/ref 17592186092382 :knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fe4953c-0983-5464-9362-45c9474d1210" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186295360}] :answer-field/correct {:answer/id #uuid "0fe4953c-0983-5464-9362-45c9474d1210" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186295360} :answer-field/id #uuid "91224f8e-576e-5980-8358-902f8e6b2203" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296932}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "251ee9eb-ffd1-5d74-9058-3b8ed977eb92" :question/math-academy-id "q-304068" :question/problem "Find the equation of the tangent to the curve $y=\\frac{3x+2}{{x}^{2}}$ at the point $(-1,-1).$\n\n$y=$\n{{field-1}}" :question/worked-solution "Let $f(x)=\\frac{3x+2}{{x}^{2}}.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3x+2}{{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3}{x}+\\frac{2}{{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3}{x})+\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{-1})+\\frac{\\text{d}}{\\text{d}x}(2{x}^{-2}) \\\\  & =-3{x}^{-2}-4{x}^{-3} \\\\  & =-\\frac{3}{{x}^{2}}-\\frac{4}{{x}^{3}}.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(-1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(-1) & =-\\frac{3}{(-1)^{2}}-\\frac{4}{(-1)^{3}} \\\\  & =-3+4 \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=1$ and the coordinates of our point $(-1,-1),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-1) & =1\\cdot (x-(-1)) \\\\ y+1 & =x+1 \\\\ y & =x.\\end{aligned}\n$$"}]}
