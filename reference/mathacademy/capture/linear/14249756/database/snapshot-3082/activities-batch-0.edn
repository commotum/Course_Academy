8-26b9-51c3-94de-c738c9f145af" :step/math-academy-id 467340}] :activity/title "Solving Exponential Equations Using the Zero-Product Property" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186157527}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186516929} :activity/id #uuid "2509a6a0-9df2-57e4-aee9-31a2cd4f3649" :activity/scope {:db/id #edb/ref 17592186048423 :topic/id #uuid "9ddcc703-a984-5097-a142-236dc3c2fbaf" :topic/math-academy-id 2979} :activity/steps [{:db/id #edb/ref 17592186516929 :step/content {:db/id #edb/ref 17592186516854 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2057272a-a597-5b12-aed1-a3af401bdb53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186516174} {:answer/id #uuid "5796b45f-c2ac-5d55-b3fc-c9c7d0eeaab2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186516297} {:answer/id #uuid "669845e1-7425-5a30-8b6e-cf58c8bc05e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186516335} {:answer/id #uuid "8501c1b4-2888-5212-9951-757335f5b2f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186516395} {:answer/id #uuid "c4f09f88-2ade-51fb-8aa2-5f0ea6cac91f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186516529}] :answer-field/correct {:db/id #edb/ref 17592186516174} :answer-field/id #uuid "be34ef91-5efd-5e6a-b5e1-ff532d2967ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516738}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cf4d19a8-5c2e-5168-bc23-2f319900269a" :question/math-academy-id "q-110802" :question/problem "What is the product of solutions of the equation ${x}^{2}\\cdot {10}^{x}-3x\\cdot {10}^{x}+2\\cdot {10}^{x}=0?$" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot {10}^{x}-3x\\cdot {10}^{x}+2\\cdot {10}^{x} & =0 \\\\ ({x}^{2}-3x+2){10}^{x} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n{x}^{2}-3x+2=0\\,\\text{and}\\,{10}^{x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation ${x}^{2}-3x+2=0$ can be factored as\n\n$$\n(x-1)(x-2)=0,\n$$\n\nwhich leads to the solutions $x=1,2.$\n\n- The equation ${10}^{x}=0$ has no solutions because ${10}^{x}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=1,2,$ and their product is $1\\cdot 2=2.$"} :step/id #uuid "82b4b547-400b-5d76-b8a1-fb3d5c269718" :step/next {:db/id #edb/ref 17592186516943}} {:db/id #edb/ref 17592186516943 :step/content {:db/id #edb/ref 17592186292659 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6c3f287-5dae-5601-8ebb-1ede42e5ca46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186291423}] :answer-field/correct {:db/id #edb/ref 17592186291423} :answer-field/id #uuid "b46a4763-9986-5fe1-adec-09a176e52d03" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292293} {:answer-field/choices [{:answer/id #uuid "7541a123-c295-5764-92f6-cc633d5666e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186291133}] :answer-field/correct {:db/id #edb/ref 17592186291133} :answer-field/id #uuid "d77cc2d2-1e8e-508d-83cc-6c1e4f0ee7f9" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292392}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a6bdd7ef-3aa2-50b8-bd67-7fd5c008275b" :question/math-academy-id "q-264754" :question/problem "In **ascending order,** the solutions of the equation $2{x}^{2}\\cdot {7}^{2x}-50\\cdot {7}^{2x}=0$ are\n\n$x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}2{x}^{2}\\cdot {7}^{2x}-50\\cdot {7}^{2x} & =0 \\\\ (2{x}^{2}-50)\\cdot {7}^{2x} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n2{x}^{2}-50=0\\,\\text{and}\\,{7}^{2x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $2{x}^{2}-50=0$ can be factored as\n\n$$\n\\begin{aligned}2({x}^{2}-25) & =0 \\\\ 2(x-5)(x+5) & =0,\\end{aligned}\n$$\n\nwhich leads to the solutions $x=-5,5.$\n\n- The equation $2=0$ is not a possible solution because it's a false statement.\n\n- The equation ${7}^{2x}=0$ has no solutions because ${7}^{2x}$ is positive for every real number $x.$\n\nTherefore, in ascending order, the original equation has the solutions \n\n$$\nx=-5\\,\\text{and}\\,x=5.\n$$"} :step/id #uuid "a1e388b6-4b60-5a84-a896-498b3b87a0f2" :step/next {:db/id #edb/ref 17592186516981}} {:db/id #edb/ref 17592186516981 :step/content {:db/id #edb/ref 17592186292662 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a78efb5-52b6-5d3c-b5a0-49f39f6da8ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186291022}] :answer-field/correct {:db/id #edb/ref 17592186291022} :answer-field/id #uuid "818baac4-9846-582e-a016-d7c37e9a7e42" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292135} {:answer-field/choices [{:answer/id #uuid "a37e3585-e3ba-5017-8c94-4dbab9c04a76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186291345}] :answer-field/correct {:db/id #edb/ref 17592186291345} :answer-field/id #uuid "885f1080-4f56-5ac6-a8d7-1a1b1f221f7d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292158}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f911a188-0d00-5124-b074-90cbb871a900" :question/math-academy-id "q-264780" :question/problem "In **ascending order,** the solutions of the equation ${x}^{2}\\cdot {5}^{2x+1}+11x\\cdot {5}^{2x+1}+28\\cdot {5}^{2x+1}=0$ are\n\n$x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot {5}^{2x+1}+11x\\cdot {5}^{2x+1}+28\\cdot {5}^{2x+1} & =0 \\\\ ({x}^{2}+11x+28){5}^{2x+1} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n{x}^{2}+11x+28=0\\,\\text{and}\\,{5}^{2x+1}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation ${x}^{2}+11x+28=0$ can be factored as\n\n$$\n(x+7)(x+4)=0,\n$$\n\nwhich leads to the solutions $x=-7,-4.$\n\n- The equation ${5}^{2x+1}=0$ has no solutions because ${5}^{2x+1}$ is positive for every real number $x.$\n\nTherefore, in ascending order, the original equation has the solutions \n\n$$\nx=-7\\,\\text{and}\\,x=-4.\n$$"} :step/id #uuid "edd4ce43-80f9-5f81-818c-9ae2ce5ab4d1"}] :activity/title "Solving Exponential Equations Using the Zero-Product Property" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186516090}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186537998} :activity/id #uuid "e3578813-12a2-53c7-b590-c0aff695b404" :activity/scope {:db/id #edb/ref 17592186048423 :topic/id #uuid "9ddcc703-a984-5097-a142-236dc3c2fbaf" :topic/math-academy-id 2979} :activity/steps [{:db/id #edb/ref 17592186537998 :step/content {:db/id #edb/ref 17592186537914 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13c010e0-d904-51ec-b491-72fa13a1c722" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-16" :db/id #edb/ref 17592186537265} {:answer/id #uuid "1ab45d96-d124-5fb4-b8cc-95b11dfddc6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186537283} {:answer/id #uuid "7e6209ff-c890-5b77-aea9-3b062a5bffb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186537476} {:answer/id #uuid "b0fe6e5e-9156-5eb2-886b-f6d9bd66017f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186537569} {:answer/id #uuid "c2efe1d1-723f-56a8-b37f-a809b02fb084" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186537603}] :answer-field/correct {:db/id #edb/ref 17592186537265} :answer-field/id #uuid "000395f2-2229-5afc-a0c3-6b50cd88d3b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537757}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "543d7533-dccc-5fe7-9798-fd9513ac4953" :question/math-academy-id "q-88456" :question/problem "What is the product of solutions of the equation $2{x}^{2}\\cdot {5}^{x+2}-32\\cdot {5}^{x+2}=0?$" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}2{x}^{2}\\cdot {5}^{x+2}-32\\cdot {5}^{x+2} & =0 \\\\ (2{x}^{2}-32)\\cdot {5}^{x+2} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n2{x}^{2}-32=0\\,\\text{and}\\,{5}^{x+2}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $2{x}^{2}-32=0$ can be factored as\n\n$$\n\\begin{aligned}2({x}^{2}-16) & =0 \\\\ 2(x+4)(x-4) & =0,\\end{aligned}\n$$\n\nwhich leads to the solutions $x=-4,4.$\n\n- The equation $2=0$ is not a possible solution because it's a false statement.\n\n- The equation ${5}^{x+2}=0$ has no solutions because ${5}^{x+2}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-4,4,$ and their product is $(-4)\\cdot 4=-16.$"} :step/id #uuid "1e124127-bb29-56d9-aea9-e096e5bceea6" :step/next {:db/id #edb/ref 17592186538025}} {:db/id #edb/ref 17592186538025 :step/content {:db/id #edb/ref 17592186354646 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33737a4b-5342-5565-914a-cb6438076b5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186352043} {:answer/id #uuid "380810d5-4536-54a8-96a6-03ca61571cf7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186352085} {:answer/id #uuid "4d84059a-bf3e-5ad8-848d-de47fb5fcbba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186352275} {:answer/id #uuid "8597e99b-a624-5fb1-9f86-e86812b0613d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186352731} {:answer/id #uuid "da180e83-5bee-502b-9c12-ae8aed810433" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186353461}] :answer-field/correct {:db/id #edb/ref 17592186353461} :answer-field/id #uuid "15a5b309-fce0-58d4-9cb6-f4a8f8750bae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186353852}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "395668d0-2b32-5884-a30f-d67a196224fd" :question/math-academy-id "q-88460" :question/problem "What is the product of solutions of the equation $2{x}^{2}\\cdot {6}^{x+3}-9x\\cdot {6}^{x+3}+4\\cdot {6}^{x+3}=0?$" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}2{x}^{2}\\cdot {6}^{x+3}-9x\\cdot {6}^{x+3}+4\\cdot {6}^{x+3} & =0 \\\\ (2{x}^{2}-9x+4){6}^{x+3} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n2{x}^{2}-9x+4=0\\,\\text{and}\\,{6}^{x+3}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $2{x}^{2}-9x+4=0$ can be factored as\n\n$$\n(2x-1)(x-4)=0,\n$$\n\nwhich leads to the solutions $x=\\frac{1}{2},4.$\n\n- The equation ${6}^{x+3}=0$ has no solutions because ${6}^{x+3}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=\\frac{1}{2},4,$ and their product is $\\frac{1}{2}\\cdot 4=2.$"} :step/id #uuid "698684ba-c1ee-5c3c-b7f8-006e905d879a" :step/next {:db/id #edb/ref 17592186538045}} {:db/id #edb/ref 17592186538045 :step/content {:db/id #edb/ref 17592186537962 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "513cdd03-c241-5b39-91b6-0279ee268055" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186537398} {:answer/id #uuid "70cc8f24-5b90-57ac-b62e-1362fb9e8618" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186537449} {:answer/id #uuid "76c93d58-5244-5182-bfad-36ccd0a40c29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186537465} {:answer/id #uuid "949f3a69-bede-5a74-a0b5-be25455f3451" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186537508} {:answer/id #uuid "df115754-c961-559d-9269-701572e5321c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186537677}] :answer-field/correct {:db/id #edb/ref 17592186537677} :answer-field/id #uuid "2e621ebc-06c8-5c50-ae08-59bcabc99cdf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537773}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bb3bd545-e795-5869-ab36-2a8ac7b0ac72" :question/math-academy-id "q-88461" :question/problem "What is the product of solutions of the equation $4\\cdot {5}^{x-2}={x}^{2}\\cdot {5}^{x-2}?$" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}4\\cdot {5}^{x-2} & ={x}^{2}\\cdot {5}^{x-2} \\\\ 4\\cdot {5}^{x-2}-{x}^{2}\\cdot {5}^{x-2} & =0 \\\\ (4-{x}^{2}){5}^{x-2} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n4-{x}^{2}=0\\,\\text{and}\\,{5}^{x-2}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $4-{x}^{2}=0$ can be factored as\n\n$$\n(2+x)(2-x)=0,\n$$\n\nwhich leads to the solutions $x=-2,2.$\n\n- The equation ${5}^{x-2}=0$ has no solutions because ${5}^{x-2}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-2,2,$ and their product is $(-2)\\cdot 2=-4.$"} :step/id #uuid "ab84e546-33f9-5443-89fa-b2f73b6f13b0"}] :activity/title "Solving Exponential Equations Using the Zero-Product Property" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186537221}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186570061} :activity/id #uuid "dc729c17-5f64-5682-98ca-64ec703a1464" :activity/scope {:db/id #edb/ref 17592186048423 :topic/id #uuid "9ddcc703-a984-5097-a142-236dc3c2fbaf" :topic/math-academy-id 2979} :activity/steps [{:db/id #edb/ref 17592186570045 :step/content {:db/id #edb/ref 17592186292661 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54b95013-9673-571d-a385-1ada2dbd7596" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186290994}] :answer-field/correct {:db/id #edb/ref 17592186290994} :answer-field/id #uuid "d77c3cd4-4822-5b88-b531-15ff6b1e643c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292391} {:answer-field/choices [{:answer/id #uuid "abb9bd8e-4e36-5095-84b1-7e4d92640618" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186291378}] :answer-field/correct {:db/id #edb/ref 17592186291378} :answer-field/id #uuid "e319a330-863d-5a2b-83b4-4b5600e073c9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292441}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "77ac52fb-b13e-5bb0-9619-5d3b00902a0e" :question/math-academy-id "q-264778" :question/problem "In **ascending order,** the solutions of the equation $2{x}^{2}\\cdot {2}^{x+3}-7x\\cdot {2}^{x+3}+3\\cdot {2}^{x+3}=0$ are\n\n$x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}2{x}^{2}\\cdot {2}^{x+3}-7x\\cdot {2}^{x+3}+3\\cdot {2}^{x+3} & =0 \\\\ (2{x}^{2}-7x+3){2}^{x+3} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n2{x}^{2}-7x+3=0\\,\\text{and}\\,{2}^{x+3}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $2{x}^{2}-7x+3=0$ can be factored as\n\n$$\n(2x-1)(x-3)=0,\n$$\n\nwhich leads to the solutions $x=\\frac{1}{2},3.$\n\n- The equation ${2}^{x+3}=0$ has no solutions because ${2}^{x+3}$ is positive for every real number $x.$\n\nTherefore, in ascending order, the original equation has the solutions \n\n$$\nx=\\frac{1}{2}\\,\\text{and}\\,x=3.\n$$"} :step/id #uuid "114fb63f-63fb-5356-b093-291fb3d3fff9" :step/next {:db/id #edb/ref 17592186570058}} {:db/id #edb/ref 17592186570058 :step/content {:db/id #edb/ref 17592186292664 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e00ad2a-0346-5764-8bd0-cbcc0f4a797a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186291167}] :answer-field/correct {:db/id #edb/ref 17592186291167} :answer-field/id #uuid "4304fe74-f9d5-5270-981d-8bec5b17751e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186291954} {:answer-field/choices [{:answer/id #uuid "c61ad1b3-442b-57c6-94cb-530214be2c0f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186291485}] :answer-field/correct {:db/id #edb/ref 17592186291485} :answer-field/id #uuid "db84ff3f-88d9-57d9-80ab-3958548a8d86" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186292416}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4930566b-e427-5630-b850-4beaebc0bb52" :question/math-academy-id "q-264787" :question/problem "In **ascending order,** the solutions of the equation $4{x}^{2}\\cdot {5}^{x-4}=144\\cdot {5}^{x-4}$ are\n\n$x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}4{x}^{2}\\cdot {5}^{x-4} & =144\\cdot {5}^{x-4} \\\\ 4{x}^{2}\\cdot {5}^{x-4}-144\\cdot {5}^{x-4} & =0 \\\\ (4{x}^{2}-144)\\cdot {5}^{x-4} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n4{x}^{2}-144=0\\,\\text{and}\\,{5}^{x-4}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $4{x}^{2}-144=0$ can be factored as\n\n$$\n\\begin{aligned}4({x}^{2}-36) & =0 \\\\ 4(x+6)(x-6) & =0,\\end{aligned}\n$$\n\nwhich leads to the solutions $x=-6,6.$\n\n- The equation $4=0$ is not a possible solution because it's a false statement.\n\n- The equation ${5}^{x-4}=0$ has no solutions because ${5}^{x-4}$ is positive for every real number $x.$\n\nTherefore, in ascending order, the original equation has the solutions \n\n$$\nx=-6\\,\\text{and}\\,x=6.\n$$"} :step/id #uuid "4b9091a4-a0a1-5587-b592-b4fc29ebd434"} {:db/id #edb/ref 17592186570061 :step/content {:db/id #edb/ref 17592186569963 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44378ce2-6b6d-50f9-8219-f673e5079ada" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186569538} {:answer/id #uuid "605ed3c1-ae12-54a3-81f7-60de52284930" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186569591} {:answer/id #uuid "61b10d9f-a72c-52f5-9148-9af198ae4115" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-18" :db/id #edb/ref 17592186569595} {:answer/id #uuid "660eda51-d232-5b88-9bd1-a2c03b96321a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186569601} {:answer/id #uuid "cb9d3203-fb35-582c-af0f-5edb1642fe68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186569766}] :answer-field/correct {:db/id #edb/ref 17592186569601} :answer-field/id #uuid "7de9c953-9396-5e7b-9be9-017863373246" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186569890}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "12b67edd-e409-5ea0-9859-9fa94b363ebb" :question/math-academy-id "q-88457" :question/problem "What is the product of solutions of the equation ${x}^{2}{e}^{3x}-4x{e}^{3x}-12{e}^{3x}=0?$" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}{x}^{2}{e}^{3x}-4x{e}^{3x}-12{e}^{3x} & =0 \\\\ ({x}^{2}-4x-12){e}^{3x} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n{x}^{2}-4x-12=0\\,\\text{and}\\,{e}^{3x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation ${x}^{2}-4x-12=0$ can be factored as\n\n$$\n(x+2)(x-6)=0,\n$$\n\nwhich leads to the solutions $x=-2,6.$\n\n- The equation ${e}^{3x}=0$ has no solutions because ${e}^{3x}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-2,6,$ and their product is $(-2)\\cdot 6=-12.$"} :step/id #uuid "59d17a34-18a9-5f21-9ce9-f181a0fe6f9e" :step/next {:db/id #edb/ref 17592186570081}} {:db/id #edb/ref 17592186570081 :step/content {:db/id #edb/ref 17592186570034 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ea8cba7-d03a-516f-a0c3-30fb8354dfdd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186569622} {:answer/id #uuid "86253246-2caa-5e0b-abae-547f561590f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186569664} {:answer/id #uuid "98428f30-5194-58f2-b856-5fc56747aac9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186569687} {:answer/id #uuid "d6757daa-1d29-5c10-947c-afd176f4f5d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186569779} {:answer/id #uuid "d952e124-7588-56a7-81b3-154bceef8a55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186569785}] :answer-field/correct {:db/id #edb/ref 17592186569785} :answer-field/id #uuid "dc076be1-fa1d-5a8e-9f7b-f0d944a99952" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186569934}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e2c0ab81-ce73-5f44-b936-e8bb7ee9594f" :question/math-academy-id "q-100794" :question/problem "What is the product of solutions of the equation $3{x}^{2}\\cdot {5}^{x}=11x\\cdot {5}^{x}+4\\cdot {5}^{x}?$" :question/worked-solution "First, we factor the equation:\n\n  \n\n$$\n\\begin{aligned}3{x}^{2}\\cdot {5}^{x} & =11x\\cdot {5}^{x}+4\\cdot {5}^{x} \\\\ 3{x}^{2}\\cdot {5}^{x}-11x\\cdot {5}^{x}-4\\cdot {5}^{x} & =0 \\\\ (3{x}^{2}-11x-4)\\cdot {5}^{x} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n3{x}^{2}-11x-4=0\\,\\text{and}\\,{5}^{x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $3{x}^{2}-11x-4=0$ can be factored as\n\n$$\n(3x+1)(x-4)=0,\n$$\n\nwhich leads to the solutions $x=-\\frac{1}{3},4.$\n\n- The equation ${5}^{x}=0$ has no solutions because ${5}^{x}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-\\frac{1}{3},4,$ and their product is $(-\\frac{1}{3})\\cdot 4=-\\frac{4}{3}.$"} :step/id #uuid "b0acc92f-1dde-5ca1-888f-6358a324a4bd" :step/next {:db/id #edb/ref 17592186570092}} {:db/id #edb/ref 17592186570092 :step/content {:db/id #edb/ref 17592186569977 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c7135a8-799d-5ef5-9d3d-470881e76d26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186569548} {:answer/id #uuid "adcaa9ff-45f7-5db6-b2e3-d82e71396783" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186569716} {:answer/id #uuid "beb695a1-1361-556b-b4fb-bedb79dc1f93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186569748} {:answer/id #uuid "d2eb82f2-a647-5584-afd7-3c3b5045b584" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186569775} {:answer/id #uuid "ea325e7e-7c0b-5864-bded-5700ce421acf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186569815}] :answer-field/correct {:db/id #edb/ref 17592186569815} :answer-field/id #uuid "459604d3-c555-5e7f-b4d3-0ad596a161eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186569870}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3499241b-bbd1-5943-8b7b-1fe387959bfa" :question/math-academy-id "q-100799" :question/problem "What is the product of solutions of the equation $9{x}^{2}{e}^{x}=36{e}^{x}?$" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}9{x}^{2}{e}^{x} & =36{e}^{x} \\\\ 9{x}^{2}{e}^{x}-36{e}^{x} & =0 \\\\ (9{x}^{2}-36){e}^{x} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n9{x}^{2}-36=0\\,\\text{and}\\,{e}^{x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $9{x}^{2}-36=0$ can be factored as\n\n$$\n(3x+6)(3x-6)=0,\n$$\n\nwhich leads to the solutions $x=-2,2.$\n\n- The equation ${e}^{x}=0$ has no solutions because ${e}^{x}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-2,2,$ and their product is $(-2)\\cdot 2=-4.$"} :step/id #uuid "d4980d2a-a8b8-5708-868f-e424629b107f" :step/next {:db/id #edb/ref 17592186570045}}] :activity/title "Solving Exponential Equations Using the Zero-Product Property" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186569442}]}
