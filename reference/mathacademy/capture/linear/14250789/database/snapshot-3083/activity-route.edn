#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186570848} :activity/id #uuid "b4da87d0-f5a5-50ee-a9f0-c6cb2fb5fc32" :activity/scope {:db/id #edb/ref 17592186049474 :topic/id #uuid "f80da52a-4a96-5269-8885-c600a798d61e" :topic/math-academy-id 790} :activity/steps [{:db/id #edb/ref 17592186570841 :step/content {:db/id #edb/ref 17592186570706 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "189651b0-54f3-5292-acb1-78996d20c50d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186570173} {:answer/id #uuid "80b350c2-d6af-593a-8af1-2ec69b5c8cad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186570352} {:answer/id #uuid "933e034e-403a-57ae-b3fe-587b30e14b03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186570383} {:answer/id #uuid "aa9212d0-88ad-5f2e-997d-59a47e64e7c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186570425} {:answer/id #uuid "dc88590b-2d68-5698-b5ee-ad190de36855" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186570511}] :answer-field/correct {:db/id #edb/ref 17592186570425} :answer-field/id #uuid "7196b41d-0d52-543a-bb1d-8738e6064d5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186570631}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "17bccb94-8027-5ec1-b42e-ebe5775a61ec" :question/math-academy-id "q-15814" :question/problem "Find the minimum value of $y$ on the graph $y=|x-3|+3.$" :question/worked-solution "Remember that $y=|x-h|+k$ is a vertical translation of the absolute value graph $y=|x|$ by $h$ units right and $k$ units up.\n\nThe function $y=|x-3|+3$ has $h=3$ and $k=3.$ Therefore, it is a translation of the absolute value graph $y=|x|$ by $3$ units *right* and $3$ units *up*.\n\n![](images/d5/d5c67a156d80c6dabd832539a4912c2bdd7ef38af9735fcade7ee46e4ba66eaa.png)\n\nLooking at the graph, we can see that the minimum value of $y$ is $3.$ This occurs at the point $(3,3).$"} :step/id #uuid "878cfbc6-5471-58e8-915b-20a46b57e956" :step/next {:db/id #edb/ref 17592186570844}} {:db/id #edb/ref 17592186570843 :step/content {:db/id #edb/ref 17592186570773 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23d06b4f-bc10-59f4-bad3-9be438d8e2e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,-1)" :db/id #edb/ref 17592186570189} {:answer/id #uuid "3ba1fb6c-8327-51bf-8fb0-05e23abf8c83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,0)" :db/id #edb/ref 17592186570222} {:answer/id #uuid "4cf6e7fe-b201-5c9d-a8a4-bd5f53457d4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,0)" :db/id #edb/ref 17592186570259} {:answer/id #uuid "a4336403-9070-5be9-84ed-ebf6940c61a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,1)" :db/id #edb/ref 17592186570415} {:answer/id #uuid "e950df02-b773-5199-bf04-fc99be23ac4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,1)" :db/id #edb/ref 17592186570532}] :answer-field/correct {:db/id #edb/ref 17592186570222} :answer-field/id #uuid "a0a5060b-5648-5c20-ac0c-e7491147f963" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186570651}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bc3a1a0d-0a47-5924-a45a-6ae72b37f737" :question/math-academy-id "q-78063" :question/problem "If $y=|x+1|$, what are the coordinates of the minimum point on the graph?" :question/worked-solution "Remember that $y=|x-a|$ is a horizontal translation of the absolute value graph $y=|x|$ by $a$ units right.\n\nThe function $y=|x+1|$ has $a=-1.$ Therefore, it is a horizontal translation of the absolute value graph $y=|x|$ by $1$ unit left.\n\n![](images/38/38532ccdd10c7a60f26fdf35c837376af799d7b024370e8b223cd61b7b18eb9d.png)\n\nLooking at the graph, we can see that the coordinates of the minimum point are $(-1,0).$"} :step/id #uuid "9272e140-eade-50e0-aa74-a463e9e7aca4" :step/next {:db/id #edb/ref 17592186570857}} {:db/id #edb/ref 17592186570844 :step/content {:db/id #edb/ref 17592186570741 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d75859b-74a6-5c31-b94d-cfb3fec63748" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-5,0)" :db/id #edb/ref 17592186570202} {:answer/id #uuid "53d0ffba-e11b-5c18-a494-dc8db0e90b44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,0)" :db/id #edb/ref 17592186570272} {:answer/id #uuid "7df37ea3-f56a-521e-9c32-559774529837" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,-5)" :db/id #edb/ref 17592186570346} {:answer/id #uuid "96e0d1b5-5c60-5283-a61c-715d74c22923" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,5)" :db/id #edb/ref 17592186570388} {:answer/id #uuid "ca1bc01f-1907-59c5-ae47-53cddb450003" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(5,0)" :db/id #edb/ref 17592186570475}] :answer-field/correct {:db/id #edb/ref 17592186570475} :answer-field/id #uuid "b93eba92-6655-5d26-b15a-6487f0a03dd6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186570667}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7432d94a-3593-5858-b61c-052181b6a281" :question/math-academy-id "q-15826" :question/problem "If $y=|x-5|$, what are the coordinates of the minimum point on the graph?" :question/worked-solution "Remember that $y=|x-a|$ is a horizontal translation of the absolute value graph $y=|x|$ by $a$ units right.\n\nThe function $y=|x-5|$ has $a=5.$ Therefore, it is a horizontal translation of the absolute value graph $y=|x|$ by $5$ units right.\n\n![](images/ca/ca70d305bb0da32441611d879ca2a4a2453b38e951b448964b5d48f01fa33e28.png)\n\nLooking at the graph, we can see that the coordinates of the minimum point are $(5,0).$"} :step/id #uuid "9437c58f-f80b-51f5-a33f-6de7c5ebdc3a" :step/next {:db/id #edb/ref 17592186570843}} {:db/id #edb/ref 17592186570848 :step/content {:db/id #edb/ref 17592186570739 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04656707-2a2c-5ffa-bbcb-9540a7b1d0c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186570130} {:answer/id #uuid "091b549b-9482-5c9d-99a3-414abc46226c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186570138} {:answer/id #uuid "96ce8727-2f4f-5e50-b3b2-f6937e57145d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186570387} {:answer/id #uuid "9cff91ed-11f3-5a4c-b5a3-c02c22d2774b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186570402} {:answer/id #uuid "e8201c4f-d73c-5a75-aee0-069d79e730fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186570529}] :answer-field/correct {:db/id #edb/ref 17592186570138} :answer-field/id #uuid "3f1dab20-875a-5ecd-83ee-e9779ffd70fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186570604}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6dff94b8-5d8c-56b5-9363-d9107e29b4d1" :question/math-academy-id "q-15811" :question/problem "Find the minimum value of $y$ on the graph $y=|x+4|-1.$" :question/worked-solution "Remember that $y=|x-h|+k$ is a vertical translation of the absolute value graph $y=|x|$ by $h$ units right and $k$ units up.\n\nThe function $y=|x+4|-1$ has $h=-4$ and $k=-1.$ Therefore, it is a translation of the absolute value graph $y=|x|$ by $4$ units *left* and $1$ unit *down*.\n\n![](images/45/45411bac1f347093b8b9931e1f8f8bee4f1eb411b6256a4c56d0ba33cffe603e.png)\n\nLooking at the graph, we can see that the minimum value of $y$ is $-1.$ This occurs at the point $(-4,-1).$"} :step/id #uuid "a2af62b9-442c-506b-9cce-b6a9e9270c22" :step/next {:db/id #edb/ref 17592186570841}} {:db/id #edb/ref 17592186570857 :step/content {:db/id #edb/ref 17592186570714 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee5d6999-dacf-585b-9763-55851b2e5a28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186570541}] :answer-field/correct {:db/id #edb/ref 17592186570541} :answer-field/id #uuid "aecd1abd-2502-5a3e-aece-0d12a409100b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186570660}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2b65f25b-10a0-5e3f-8752-11a285fdf596" :question/math-academy-id "q-222360" :question/problem "The minimum value of the function $y=|x+3|+2$ is $y=${{field-1}}." :question/worked-solution "Remember that $y=|x-h|+k$ is a vertical translation of the absolute value graph $y=|x|$ by $h$ units right and $k$ units up.\n\nThe function $y=|x+3|+2$ has $h=-3$ and $k=2.$ Therefore, it is a translation of the absolute value graph $y=|x|$ by $3$ units *left* and $2$ units *up*.\n\n![](images/81/81bace946b2fb425efa7fd7c54eb53ec353be5d9ef1516d9cf24e2c13656a60b.png)\n\nLooking at the graph, we can see that the minimum value of $y$ is $2.$"} :step/id #uuid "c6cb8059-d840-5375-a89b-c4dc968b16b1"}] :activity/title "Absolute Value Graphs" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186570110}]}
