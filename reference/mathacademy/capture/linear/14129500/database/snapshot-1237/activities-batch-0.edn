#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074736} :activity/id #uuid "5e2897c1-674c-573a-bc21-b2ee8969cb98" :activity/scope {:db/id #edb/ref 17592186050244 :topic/id #uuid "39037448-ec95-5f7d-a4a1-9f6678563857" :topic/math-academy-id 564} :activity/steps [{:db/id #edb/ref 17592186074736 :step/content {:db/id #edb/ref 17592186075016 :tutorial/content "We can use fraction models to multiply unit fractions by whole numbers. \n\nFor example, let's consider the following product: \n\n$$\n\\dfrac 13 \\times 2\n$$\n\nFirst, we represent $\\dfrac{1}{3}$ using a model:\n\n![](images/f0/f08054646558ab944940f1f8f0d8a1077748f9882039e775c6cbdd4d307db102.png)\n\n \n\nMultiplication by a whole number is simply a repeated addition. And, since we need to multiply $\\dfrac{\\color{red}1}{3}$ by ${\\color{blue}2},$ we repeat the fraction model $\\color{blue}2$ times, as shown below.\n\n![](images/31/31fcef6d631262e49fc9c9297fd006f935fd7ee8182b0074d77ae22b626efbbc.png)\n\n \n\nThere are ${\\color{blue}2} \\times {\\color{red}1} = 2$ shaded pieces in total. Therefore, we conclude that\n\n$$\n2 \\times \\dfrac{1}{3} = \\dfrac{2}{3}.\n$$" :tutorial/id #uuid "0baa395e-db83-5229-83f7-f40fd99e8a4f" :tutorial/math-academy-id 6606 :tutorial/title "Introduction"} :step/id #uuid "cf5a7b59-9df0-505a-86e0-c7437dc8b262" :step/math-academy-id 39867 :step/next {:db/id #edb/ref 17592186074737}} {:db/id #edb/ref 17592186074737 :step/content {:db/id #edb/ref 17592186073795 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073417 :question/id #uuid "a3241956-5b5b-5760-9383-d7da13f48b16" :question/math-academy-id "e-10548"} :knowledge-point/id #uuid "95e51046-fc4c-536b-91eb-82c7c298b7be" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051027}] :knowledge-point/questions [{:db/id #edb/ref 17592186074413} {:db/id #edb/ref 17592186074414} {:db/id #edb/ref 17592186425255} {:db/id #edb/ref 17592186425260} {:db/id #edb/ref 17592186425265} {:db/id #edb/ref 17592186425267} {:db/id #edb/ref 17592186425269}] :knowledge-point/title "Representing a Product as a Repeated Addition"} :step/id #uuid "f29f88a5-25e3-54f3-b724-70c3d82de050" :step/math-academy-id 39868 :step/next {:db/id #edb/ref 17592186074738}} {:db/id #edb/ref 17592186074738 :step/content {:db/id #edb/ref 17592186073796 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073418 :question/id #uuid "eea25500-f78e-544f-8bf9-7eaacfac84a6" :question/math-academy-id "e-10549"} :knowledge-point/id #uuid "c1e7017e-45df-5adf-9ded-3f815b4f5673" :knowledge-point/questions [{:db/id #edb/ref 17592186074006} {:db/id #edb/ref 17592186074410} {:db/id #edb/ref 17592186424833} {:db/id #edb/ref 17592186425258} {:db/id #edb/ref 17592186425262} {:db/id #edb/ref 17592186425266} {:db/id #edb/ref 17592186425268}] :knowledge-point/title "Multiplying a Unit Fraction by a Whole Number Using Repeated Addition"} :step/id #uuid "ec8f3fd6-e68a-5a08-909a-7ca8734e46ba" :step/math-academy-id 39869 :step/next {:db/id #edb/ref 17592186074740}} {:db/id #edb/ref 17592186074739 :step/content {:db/id #edb/ref 17592186073797 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073419 :question/id #uuid "1c074473-dc1c-56c6-825b-be4b6b3dbfa2" :question/math-academy-id "e-10550"} :knowledge-point/id #uuid "23f5f4f6-9d8c-5ab5-ada8-1212832de40f" :knowledge-point/questions [{:db/id #edb/ref 17592186074415} {:db/id #edb/ref 17592186074416} {:db/id #edb/ref 17592186425259} {:db/id #edb/ref 17592186425261} {:db/id #edb/ref 17592186425264} {:db/id #edb/ref 17592186425270}] :knowledge-point/title "Identifying a Multiplication Problem Given a Model"} :step/id #uuid "6cd88bb7-dfba-55b2-bb7a-0cce2188c27c" :step/math-academy-id 39871 :step/next {:db/id #edb/ref 17592186074741}} {:db/id #edb/ref 17592186074740 :step/content {:db/id #edb/ref 17592186075017 :tutorial/content "There's another way we can use fraction models to multiply unit fractions by whole numbers.\n\nTo demonstrate, let's consider the multiplication problem below:\n\n$$\n\\dfrac{1}{10} \\times 7\n$$\n\nWe start by drawing a fraction model to represent $\\dfrac{1}{10}.$\n\n![](images/62/62b50e658ed9bc691a9559548d09f87fbd3b33e007e81b5e78a3235ac4bc3280.png)\n\n \n\nNow, rather than repeating our model $7$ times (which would take a long time), we can instead multiply the number of shaded pieces by $7.$ \n\nOur model has $1$ shaded piece. So, the resulting model must have $1 \\times 7 = 7$ shaded pieces: \n\n![](images/2a/2a7d54b1d7a6a6013ee64b601d9dc0ba31c8a25dae0f5f69abba4b0fed0e8ee2.png)\n\nTherefore, we conclude that\n\n$$\n\\dfrac{1}{10}\\times 7 = \\dfrac{7}{10}.\n$$" :tutorial/id #uuid "5b799a98-0619-525c-b2da-433704f26bd8" :tutorial/math-academy-id 6608 :tutorial/title "A Faster Way of Computing a Product Using Models"} :step/id #uuid "0ff59236-e8f5-575d-bc8b-731fac2b148a" :step/math-academy-id 39884 :step/next {:db/id #edb/ref 17592186074739}} {:db/id #edb/ref 17592186074741 :step/content {:db/id #edb/ref 17592186073798 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073420 :question/id #uuid "3e10607a-5812-50cd-a2d5-4b7c3ebcbde1" :question/math-academy-id "e-10555"} :knowledge-point/id #uuid "8bf2fa4e-c47e-5d89-a4aa-8e255050f792" :knowledge-point/questions [{:db/id #edb/ref 17592186074407} {:db/id #edb/ref 17592186074408} {:db/id #edb/ref 17592186425256} {:db/id #edb/ref 17592186425257} {:db/id #edb/ref 17592186425263} {:db/id #edb/ref 17592186425271}] :knowledge-point/title "Identifying a Missing Factor Given a Model"} :step/id #uuid "111068bf-412d-586d-b167-f6557ad36f93" :step/math-academy-id 39885}] :activity/title "Multiplying Unit Fractions by Whole Numbers Using Models" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073982}]}
