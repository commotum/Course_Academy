/id #edb/ref 17592186425207} {:answer/id #uuid "bfeb97b4-dddf-5406-8e57-5e00f6139b13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186425218}] :answer-field/correct {:answer/id #uuid "bfeb97b4-dddf-5406-8e57-5e00f6139b13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186425218} :answer-field/id #uuid "3975b1ce-6e7a-5ab7-91cd-b322b772fd9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425241}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fc89f09e-3ad3-5777-acd5-6837ef9994f7" :question/math-academy-id "q-152071" :question/problem "![](images/c7/c7100b6cf16ffab710d0760a7bc6f3f69a0d8fb8fbad4bd601099dbaa2618ba7.png)\n\nWhat number is missing from the multiplication problem above?" :question/worked-solution "We have $\\frac{1}{10}$ on the left and $\\frac{7}{10}$ on the right.\n\n![](images/c4/c40da91dc3f57bf93f7e1fac3d7816ee4b534ad74ce71005ec3fbf0f6825910c.png)\n\nThe shape on the left has $1$ shaded piece, and the shape on the right has $7$ shaded pieces. So the number of shaded pieces has increased by a factor of $7.$\n\nTherefore, we have\n\n$$\n\\frac{1}{10}\\times 7=\\frac{7}{10}.\n$$\n\nSo, the missing number is $7.$"}] [{:db/id #edb/ref 17592186425257 :knowledge-point/_questions [{:db/id #edb/ref 17592186073798 :knowledge-point/id #uuid "8bf2fa4e-c47e-5d89-a4aa-8e255050f792" :knowledge-point/title "Identifying a Missing Factor Given a Model"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "011d959c-931e-57ed-8699-e64bfa41c4f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186425158} {:answer/id #uuid "046d5ee1-bdcd-5df6-b759-1fcc3a6000c5" :answer/type {:db/id #edb/ref 17592186045498 :db/i