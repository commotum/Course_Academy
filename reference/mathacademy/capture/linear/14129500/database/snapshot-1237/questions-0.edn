[](images/26/2644931e09925b44b2e4a5d520e8c6ca471a8c2743fa2b4c4dc3027401d5e4d0.png)\n\nWhat number is missing from the multiplication problem above?" :question/worked-solution "We have $\\frac{1}{3}$ on the left and $\\frac{2}{3}$ on the right.\n\n![](images/0a/0aebc9b26354aefbfc3e0f6a87e95c41280cb3da40729c32f38e6cdafc155686.png)\n\nThe shape on the left has $1$ shaded piece, and the shape on the right has $2$ shaded pieces. So the number of shaded pieces has increased by a factor of $2.$\n\nTherefore, we have\n\n$$\n\\frac{1}{3}\\times 2=\\frac{2}{3}.\n$$\n\nSo, the missing number is $2.$"}] [{:db/id #edb/ref 17592186425261 :knowledge-point/_questions [{:db/id #edb/ref 17592186073797 :knowledge-point/id #uuid "23f5f4f6-9d8c-5ab5-ada8-1212832de40f" :knowledge-point/title "Identifying a Multiplication Problem Given a Model"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "308aafbf-eb02-5846-843b-9fc4c07c3982" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\times 4=\\frac{1}{16}" :db/id #edb/ref 17592186425168} {:answer/id #uuid "3b4f12bd-d0f5-5cf3-9961-05dda7d8a9b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\times 4=\\frac{4}{6}" :db/id #edb/ref 17592186425174} {:answer/id #uuid "569152f1-fa63-5646-8371-d87bc887255f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\times 4=\\frac{1}{20}" :db/id #edb/ref 17592186425180} {:answer/id #uuid "7b00a56d-7c4a-533c-b44b-a9d8ff5d2e90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\times 4=\\frac{4}{5}" :db/id #edb/ref 17592186425194} {:answer/id #uuid "c7a8c923-2e89-5579-b0ad-9c3576255ccb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\times 4=\\frac{4}{24}" :db/id #edb/ref 17592186425220}] :answer-field/correct {:answer/id #uuid "