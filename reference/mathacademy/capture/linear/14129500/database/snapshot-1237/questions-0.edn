b/ref 17592186425182}] :answer-field/correct {:answer/id #uuid "5a8a2d7f-8f01-5aac-b2b5-d614f9576e2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186425182} :answer-field/id #uuid "2a6ff50e-caf5-5c7c-967b-7463ceaf512a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186425239}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2b86cc44-e53b-5bce-9e88-da200892d856" :question/math-academy-id "q-188615" :question/problem "![](images/00/004ae771e8b64b82be9b075b4e657dfc6f25eae3afa6c1be948ef8cf6b7cb614.png)\n\nUsing the model above, $2\\times \\frac{1}{9}=${{field-1}} (write as a fraction with the denominator $9$)." :question/worked-solution "Since we need to multiply $\\frac{1}{9}$ by $2$, we repeat the fraction model $2$ times, as shown below.\n\n![](images/ae/ae3caa583ee9745eb8bb79d6a00bb16373370b15bc272814100d6f10d6b4ad26.png)\n\n \n\nThere are $1\\times 2=2$ shaded pieces in total. Therefore, \n\n$$\n2\\times \\frac{1}{9}=\\frac{2}{9}.\n$$"}] [{:db/id #edb/ref 17592186425270 :knowledge-point/_questions [{:db/id #edb/ref 17592186073797 :knowledge-point/id #uuid "23f5f4f6-9d8c-5ab5-ada8-1212832de40f" :knowledge-point/title "Identifying a Multiplication Problem Given a Model"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16177991-2f1c-54ac-a5a7-cc5d5711bc87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186425165}] :answer-field/correct {:answer/id #uuid "16177991-2f1c-54ac-a5a7-cc5d5711bc87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186425165} :answer-field/id #uuid "5fa687a5-b22c-5822-9ae4-a709b9424b53" :answer-field/key "field-2" :answer-field/type {:db/id #e