  "live_records": {
    "q-119791": {
      "dom_id": "step-q119791",
      "name": "Question 1",
      "problem": "The vector $m$ has magnitude $\\frac{7}{2}.$ Find a unit vector that is parallel to $m.$",
      "worked_solution": "To obtain the unit vector that is parallel to $m$, we divide $m$ by its length:\n\n$$\nu=\\frac{m}{|\\,m\\,|}=\\frac{1}{(\\frac{7}{2})}m=\\frac{2}{7}m\n$$",
