a-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">|</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">a</mi></mrow><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">b</mi></mrow><mo data-mjx-texclass=\"CLOSE\">|</mo></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>13</mn></mfrac></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">a</mi></mrow><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">b</mi></mrow><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
