#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186097737} :activity/id #uuid "886871c8-0b6e-56ce-bc7f-54affec4fd88" :activity/scope {:db/id #edb/ref 17592186049360 :topic/id #uuid "eed250d1-ce5b-5073-a193-140fd0562d65" :topic/math-academy-id 1104} :activity/steps [{:db/id #edb/ref 17592186097737 :step/content {:db/id #edb/ref 17592186097833 :tutorial/content "A **unit vector** is a vector whose magnitude is equal to $1.$ \n\nGiven any vector $\\mathbf a$, we can create a unit vector $\\mathbf u$ by dividing $\\mathbf a$ by its magnitude $|\\, \\mathbf{a} \\,|,$ as follows:\n\n$$\n\\mathbf{u} = \\dfrac{ \\mathbf{a} }{ |\\,\\mathbf{a}\\,| }\n$$\n\nFor example, if $|\\,\\mathbf{a}\\,|=2,$ then the unit vector is\n\n$$\n\\mathbf{u} = \\dfrac{\\mathbf{a}}{2} = \\dfrac{1}{2} \\mathbf{a}.\n$$\n\n![](images/c7/c78d5b75c1d5928e7b269a4a67229487b3d3324e9815b11c5fd1f47f63437d82.png)" :tutorial/id #uuid "a90fd4b3-d41f-589f-9067-39d57e3e8712" :tutorial/math-academy-id 2906 :tutorial/title "Introduction"} :step/id #uuid "961ff0d0-9cef-5a2d-8207-63481c0cc1ab" :step/math-academy-id 430121 :step/next {:db/id #edb/ref 17592186097738}} {:db/id #edb/ref 17592186097738 :step/content {:db/id #edb/ref 17592186096813 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096447 :question/id #uuid "2a61b115-4e26-5966-b2a9-d2fedef6b728" :question/math-academy-id "e-4282"} :knowledge-point/id #uuid "48a66a99-6b4a-5ad5-8922-6f48006ff183" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048882} {:db/id #edb/ref 17592186049715}] :knowledge-point/question-generator {:db/id #edb/ref 17592186502322} :knowledge-point/questions [{:db/id #edb/ref 17592186096969} {:db/id #edb/ref 17592186097045} {:db/id #edb/ref 17592186502222} {:db/id #edb/ref 17592186502223} {:db/id #edb/ref 17592186502225} {:db/id #edb/ref 17592186502232} {:db/id #edb/ref 17592186502236} {:db/id #edb/ref 17592186502240} {:db/id #edb/ref 17592186502241} {:db/id #edb/ref 17592186502242}