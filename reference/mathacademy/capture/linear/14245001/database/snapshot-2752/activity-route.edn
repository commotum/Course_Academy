#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186563788} :activity/id #uuid "60f22d10-34ce-56c1-a0fc-b065cccf3e2d" :activity/scope {:db/id #edb/ref 17592186050564 :topic/id #uuid "53f1b90b-679a-5fc8-8d88-3abe54c112ec" :topic/math-academy-id 1081} :activity/steps [{:db/id #edb/ref 17592186563776 :step/content {:db/id #edb/ref 17592186563726 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5afb7303-a034-559b-ab16-8b8311bec0af" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$v=6,$ $w=-1$" :db/id #edb/ref 17592186563150} {:answer/id #uuid "5bd7e204-8744-5238-87a7-8727a3e0ad13" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$v=2,$ $w=3$" :db/id #edb/ref 17592186563152} {:answer/id #uuid "8355179e-84d2-53eb-b5bb-6abf063bd798" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$v=3,$ $w=4$" :db/id #edb/ref 17592186563239} {:answer/id #uuid "a4b35f93-f5e9-58f7-a2a9-e55dc6e5f15f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$v=-6,$ $w=4$" :db/id #edb/ref 17592186563319} {:answer/id #uuid "c6009515-0020-519f-8dc9-95fcc4128b0e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$v=-3,$ $w=-2$" :db/id #edb/ref 17592186563381}] :answer-field/correct {:db/id #edb/ref 17592186563319} :answer-field/id #uuid "9c21dd7c-6896-5689-b43e-0b6480bc4997" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563602}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b521b5c1-2f07-5bb3-9c22-0775852024a2" :question/math-academy-id "q-18691" :question/problem "Solve the following system of equations:\n\n$$\n\\{\\begin{aligned}3.6v+21.6=0 \\\\ 3v+4w+2=0\\end{aligned}\n$$" :question/worked-solution "To get rid of the decimals, we multiply the top equation by $10,$ as follows:\n\n$$\n\\{\\begin{aligned}3.6v+21.6=0 & |\\,\\times 10 \\\\ 3v+4w+2=0 & \\end{aligned}\\,⟹\\,\\{\\begin{aligned}36v+216=0 \\\\ 3v+4w+2=0\\end{aligned}\n$$\n\nNotice that we can easily solve for $v$ in the first equation:\n\n$$\n\\begin{aligned}36v+216 & =0 \\\\ 36v & =-216 \\\\ v & =-6\\end{aligned}\n$$\n\nNow, to find the value of $w,$ we can substitute $v=-6$ into the second equation:\n\n$$\n\\begin{aligned}3v+4w+2 & =0 \\\\ 3(-6)+4w+2 & =0 \\\\ -18+4w+2 & =0 \\\\ 4w & =16 \\\\ w & =4\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $v=-6,\\,w=4.$"} :step/id #uuid "39f2d06f-7021-57f4-a39a-32489d48f870" :step/next {:db/id #edb/ref 17592186563806}} {:db/id #edb/ref 17592186563788 :step/content {:db/id #edb/ref 17592186097145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "129505e3-dbb4-5427-a410-3191ab7c3f5e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$p=3,$ $q=-2$" :db/id #edb/ref 17592186562983} {:answer/id #uuid "89927ca1-82b8-56b7-88ae-9cce88657f71" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$p=3,$ $q=1$" :db/id #edb/ref 17592186563251} {:answer/id #uuid "96564515-a617-5850-897c-113c823234e1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$p=-2,$ $q=1$" :db/id #edb/ref 17592186563277} {:answer/id #uuid "d17c490c-e41a-5f87-b15c-431cf541d08c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$p=4,$ $q=-3$" :db/id #edb/ref 17592186563405} {:answer/id #uuid "f86ec0bf-3ea6-50be-95c7-99af989a078d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$p=2,$ $q=2$" :db/id #edb/ref 17592186563499}] :answer-field/correct {:db/id #edb/ref 17592186562983} :answer-field/id #uuid "4818ebdf-db1d-5231-b1e1-eff22182309f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186094843}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "88cc79a1-5b49-5041-9f17-10e044db91a8" :question/math-academy-id "q-18636" :question/problem "Solve the following system of equations:\n\n$$\n\\{\\begin{aligned}0.2p=0.6 \\\\ -p-5q=7\\end{aligned}\n$$" :question/worked-solution "To get rid of the decimals, we multiply the top equation by $10,$ as follows:\n\n$$\n\\{\\begin{aligned}0.2p=0.6 & |\\,\\times 10 \\\\ -p-5q=7 & \\end{aligned}\\,⟹\\,\\{\\begin{aligned}2p=6 \\\\ -p-5q=7\\end{aligned}\n$$\n\nNotice that we can easily solve for $p$ in the first equation:\n\n$$\n\\begin{aligned}2p & =6 \\\\ p & =3\\end{aligned}\n$$\n\nNow, to find the value of $q,$ we can substitute $p=3$ into the second equation:\n\n$$\n\\begin{aligned}-p-5q & =7 \\\\ -3-5q & =7 \\\\ -5q & =10 \\\\ q & =\\frac{10}{-5} \\\\ q & =-2\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $p=3,\\,q=-2.$"} :step/id #uuid "7f8ef5c7-ce27-555f-9169-8334ba1109ac" :step/next {:db/id #edb/ref 17592186563776}} {:db/id #edb/ref 17592186563806 :step/content {:db/id #edb/ref 17592186563694 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ae222cd-009b-5eaa-a3a5-11a212b109ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-0.2" :db/id #edb/ref 17592186563108} {:answer/id #uuid "4f925c03-7ab6-5520-8a1e-a5a9a717bba1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186563127} {:answer/id #uuid "5df4489a-0f0d-55e1-b4af-a317e094993e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.2" :db/id #edb/ref 17592186563157} {:answer/id #uuid "8b7e78ed-ac31-5f29-8e01-0ec44695e0e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186563259} {:answer/id #uuid "ed9e94e3-0927-55e7-9927-3ea8b44e2b51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186563477}] :answer-field/correct {:db/id #edb/ref 17592186563108} :answer-field/id #uuid "a297791d-ebee-5b0c-89e6-af072a20920b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563608}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "648c2e1a-c875-5372-ad66-c0b63e6cb405" :question/math-academy-id "q-18760" :question/problem "Let $(a,b)$ be the solution of the following system. What is the value of $a+b?$\n\n$$\n\\{\\begin{aligned}0.05a-0.2b=0.04 \\\\ 0.12a-1.2b=0.24\\end{aligned}\n$$" :question/worked-solution "To get rid of the decimals, we multiply both equations by $100,$ as follows:\n\n$$\n\\{\\begin{aligned}0.05a-0.2b=0.04 & |\\times 100 \\\\ 0.12a-1.2b=0.24 & |\\times 100\\end{aligned}\\,⟹\\,\\{\\begin{aligned}5a-20b=4 \\\\ 12a-120b=24\\end{aligned}\n$$\n\nNotice that if we multiply the first equation by $-2$ and divide the second equation by $3,$ we will get a $40b$ term in the first equation that can cancel with the $-40b$ term in the second equation:\n\n$$\n\\{\\begin{aligned}5a-20b=4 & |\\,\\times (-2) \\\\ 12a-120b=24 & |\\,÷3\\end{aligned}\\,⟹\\,\\{\\begin{aligned}-10a+40b=-8 \\\\ 4a-40b=8\\end{aligned}\n$$\n\nAdding the two equations eliminates the $b$-variable and allows us to solve for $a:$\n\n$$\n\\begin{aligned}-10a+\\cancel{40b} & =-8 \\\\ 4a-\\cancel{40b} & =8 \\\\ (-10a+4a) & =(-8+8) \\\\ -6a & =0 \\\\ a & =0\\end{aligned}\n$$\n\nFinally, we can substitute $a=0$ into the equation $5a-20b=4$ to solve for $b:$\n\n$$\n\\begin{aligned}5a-20b & =4 \\\\ 5(0)-20b & =4 \\\\ -20b & =4 \\\\ b & =-\\frac{4}{20} \\\\ b & =-0.2\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $a=0,\\,b=-0.2.$ So,\n\n$$\na+b=0+(-0.2)=-0.2.\n$$"} :step/id #uuid "dfcc471e-c576-5d39-a9b2-5a98d41b7a04"}] :activity/title "Systems of Linear Equations With Decimal Coefficients" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186562929}]}
