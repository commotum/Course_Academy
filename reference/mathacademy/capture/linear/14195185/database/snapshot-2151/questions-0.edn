#{[{:db/id #edb/ref 17592186059460 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059869 :knowledge-point/id #uuid "1b701fb5-7676-5c5f-8a80-b86d2dec0548" :knowledge-point/title "Creating an Exponential Decay Expression From a Decay Rate"}] :question/id #uuid "53dbcc31-f851-5f0f-84e8-ae06de2cc40b" :question/math-academy-id "e-2027" :question/problem "Carlton initially made $\\[math]40\\,000$ annual profit from his business. However, since then, Carlton's annual profit decreased by $12\\%$ every year due to increased competition. To the nearest dollar, what was Carlton's annual profit $4$ years after the increased competition began?" :question/worked-solution "The number $12\\%$ written as a decimal is $0.12.$ Therefore, a decrease of $12\\%$ corresponds to multiplication by a factor of\n\n$$\n1-0.12 = 0.88.\n$$\n\nTherefore:\n\n- After $1$ year, the annual profit was $40\\,000\\cdot (0.88)$ dollars.\n\n- After $\\color{blue}2$ years, the annual profit was $40\\,000\\cdot (0.88)^{\\color{blue}2}$ dollars.\n\n- After $\\color{blue}3$ years, the annual profit was $40\\,000\\cdot (0.88)^{\\color{blue}3}$ dollars.\n\n- After $\\color{blue}4$ years, the annual profit $40\\,000\\cdot (0.88)^{\\color{blue}4}$ dollars.\n\nFinally, let's evaluate the last expression:\n\n$$\n\\[math]40\\,000\\cdot (0.88)^{4} \\approx \\[/math]23\\,988\n$$\n\nTherefore, Carlton's profit reduced to $\\[math]23\\,988$ after $4$ years."}] [{:db/id #edb/ref 17592186059461 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059870 :knowledge-point/id #uuid "162c9121-ff80-59f5-85e1-cdeb2729bfc6" :knowledge-point/title "Creating an Exponential Decay Expression From a Decay Factor"}] :question/id #uuid "ebc44409-5898-5525-baed-9c0539defa5e" :question/math-academy-id "e-2028" :question/problem "A radioactive substance decays exponentially such that its mass reduces by  $\\dfrac 1 3$ every year. If the mass of the substance was initially  $4\\,\\textrm{kg},$  what is the mass of the substance after $6$ years?" :question/worked-solution "If the mass of the substance reduces by $\\dfrac 1 3$ every year, then $\\dfrac 2 3$ of its mass remains every year.\n\nTherefore:\n\n- After $1$ year, the mass is $4\\cdot \\left(\\dfrac 2 3\\right)\\,\\textrm{kg}.$\n\n- After $\\color{blue}2$ years, the mass is $4\\cdot \\left(\\dfrac 2 3\\right)^{\\color{blue}2}\\,\\textrm{kg}.$\n\n- After $\\color{blue}3$ years, the mass is $4\\cdot \\left(\\dfrac 2 3\\right)^{\\color{blue}3}\\,\\textrm{kg}.$\n\n- $\\ldots$\n\nRepeating this pattern, we see that the mass after $\\color{blue}6$ years is $4\\cdot \\left(\\dfrac 2 3\\right)^{\\color{blue}6}\\,\\textrm{kg}.$"}] [{:db/id #edb/ref 17592186508989 :knowledge-point/_questions [{:db/id #edb/ref 17592186059870 :knowledge-point/id #uuid "162c9121-ff80-59f5-85e1-cdeb2729bfc6" :knowledge-point/title "Creating an Exponential Decay Expression From a Decay Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13d5732d-43c0-52d1-8fcd-5b4c29c890e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186508417} {:answer/id #uuid "1a77c3bd-e621-5fd7-b6c7-0706a0f09516" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186508433} {:answer/id #uuid "4a32cd4b-193c-5d68-8944-db95ecc3226a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186508498} {:answer/id #uuid "6a031128-7cbf-5a5c-a079-c9a2ed669acd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "75" :db/id #edb/ref 17592186508550} {:answer/id #uuid "97e76a18-2641-51b0-a183-4e17294d8733" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186508618}] :answer-field/correct {:answer/id #uuid "4a32cd4b-193c-5d68-8944-db95ecc3226a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186508498} :answer-field/id #uuid "51810a08-334f-5c26-a631-f9e234750786" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186508835}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e2edca84-13da-5da7-b4b8-ed4b37f13789" :question/math-academy-id "q-26244" :question/problem "A pest controller was responsible for humanely reducing the number of mice within a hotel. If there were $720$ mice initially and $\\frac{5}{6}$ of mice were removed from the hotel every day, how many mice remained in the hotel after two days?" :question/worked-solution "Since the number of mice reduced by $\\frac{5}{6}$ per day, then only $\\frac{1}{6}$ of the mice from the previous day remained.\n\nSo we have:\n\n- At the start, there were $720$ mice.\n\n- After $1$ day, there were $720\\cdot (\\frac{1}{6})$ mice.\n\n- After $2$ days, there were $720\\cdot {(\\frac{1}{6})}^{2}$ mice.\n\nEvaluating the last expression, we get\n\n$$\n720\\cdot {(\\frac{1}{6})}^{2}=20.\n$$\n\nTherefore, after $2$ days only $20$ mice remained."}] [{:db/id #edb/ref 17592186508964 :knowledge-point/_questions [{:db/id #edb/ref 17592186059870 :knowledge-point/id #uuid "162c9121-ff80-59f5-85e1-cdeb2729bfc6" :knowledge-point/title "Creating an Exponential Decay Expression From a Decay Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4e028ec-1409-5643-a03a-1db8045367c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$640$" :db/id #edb/ref 17592186508637} {:answer/id #uuid "c63d24bd-4157-511a-865f-5dd14362508a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$1\\,280$" :db/id #edb/ref 17592186508697} {:answer/id #uuid "c99df81f-1e1f-537a-baa9-d9d490cfcc66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$256$" :db/id #edb/ref 17592186508708} {:answer/id #uuid "d47f863c-e4dd-5cb8-9cc2-dd2c380f778e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$320$" :db/id #edb/ref 17592186508732} {:answer/id #uuid "ff6283c6-2d8e-5486-863d-299a65917ed1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$1\\,024$" :db/id #edb/ref 17592186508810}] :answer-field/correct {:answer/id #uuid "c99df81f-1e1f-537a-baa9-d9d490cfcc66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$256$" :db/id #edb/ref 17592186508708} :answer-field/id #uuid "a6663f5d-bdaf-51e5-a9ac-ff63ad1ed5e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186508867}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a3a40784-83f5-5659-8e12-9e2f515c5795" :question/math-academy-id "q-45481" :question/problem "The price of a new bicycle is $$625.$ If the bicycle loses $\\frac{1}{5}$ of its value every year, what will be its value after $4$ years?" :question/worked-solution "Since the value of the bicycle reduces by $\\frac{1}{5}$ per year, $\\frac{4}{5}$ of its value remains every year. \n\nLet's calculate the value of the bicycle after every year:\n\n- After $1$ year, the bicycle will be worth $625\\cdot (\\frac{4}{5})$ dollars.\n\n- After $2$ years, the bicycle will be worth $625\\cdot {(\\frac{4}{5})}^{2}$ dollars.\n\n- After $3$ years, the bicycle will be worth $625\\cdot {(\\frac{4}{5})}^{3}$ dollars.\n\n- After $4$ years, the bicycle will be worth $625\\cdot {(\\frac{4}{5})}^{4}$ dollars.\n\nEvaluating the last expression, we get\n\n$$\n625\\cdot {(\\frac{4}{5})}^{4}=256.\n$$\n\nSo after $4$ years, the bicycle will be worth $$256.$"}] [{:db/id #edb/ref 17592186060312 :knowledge-point/_questions [{:db/id #edb/ref 17592186059869 :knowledge-point/id #uuid "1b701fb5-7676-5c5f-8a80-b86d2dec0548" :knowledge-point/title "Creating an Exponential Decay Expression From a Decay Rate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d884f04-bdfd-5f62-87a4-cc746e783256" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$5\\,301$" :db/id #edb/ref 17592186508408} {:answer/id #uuid "1cfb6c8f-22a9-50b3-a22c-91a50b2c3b34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$4\\,606$" :db/id #edb/ref 17592186508438} {:answer/id #uuid "3724d7ee-a391-55b1-b250-d93c5bb5f7f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$4\\,902$" :db/id #edb/ref 17592186508472} {:answer/id #uuid "c4dc14c8-0985-5ed0-8e0a-76614989ad29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$4\\,224$" :db/id #edb/ref 17592186508695} {:answer/id #uuid "edac4472-e23d-5e0d-afbb-78d7587dfad4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$5\\,067$" :db/id #edb/ref 17592186508770}] :answer-field/correct {:answer/id #uuid "1cfb6c8f-22a9-50b3-a22c-91a50b2c3b34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$4\\,606$" :db/id #edb/ref 17592186508438} :answer-field/id #uuid "5fc3b38a-8bc4-538c-ac92-84c7786b2644" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058494}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8ea4e5bf-c78f-5012-a71e-1e6ffea002af" :question/math-academy-id "q-61792" :question/problem "A car was purchased for $$7\\,500$ and its value depreciated (decreased) by $15%$ per year. To the nearest dollar, what was the value of the car after $3$ years?" :question/worked-solution "The number $15%$ (expressed as a decimal) is equal to $0.15.$ Therefore, a decrease of $15%$ corresponds to multiplication by a factor of:\n\n$$\n1-0.15=0.85\n$$\n\nTherefore:\n\n- After $1$ year, the car's value was $7\\,500\\cdot (0.85)$ dollars.\n\n- After $2$ years, the car's value was $7\\,500\\cdot (0.85)^{2}$ dollars.\n\n- After $3$ years, the car's value was $7\\,500\\cdot (0.85)^{3}$ dollars.\n\nEvaluating the last expression gives\n\n$$\n7\\,500\\cdot (0.85)^{3}≈4\\,606.\n$$\n\nSo the car was worth $$4\\,606$ (to the nearest dollar) after $3$ years."}] [{:db/id #edb/ref 17592186508920 :knowledge-point/_questions [{:db/id #edb/ref 17592186059869 :knowledge-point/id #uuid "1b701fb5-7676-5c5f-8a80-b86d2dec0548" :knowledge-point/title "Creating an Exponential Decay Expression From a Decay Rate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "323b7c73-1649-5faf-b101-6a4ee721f31a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$84\\,346$" :db/id #edb/ref 17592186508464} {:answer/id #uuid "45896a3d-55b3-509c-9a87-a9666e1661fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$77\\,501$" :db/id #edb/ref 17592186508492} {:answer/id #uuid "7d406a7f-05b4-5ddd-b9da-ca2eb0b547f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$79\\,402$" :db/id #edb/ref 17592186508572} {:answer/id #uuid "bb85eec1-a8cc-5386-a093-8ff25c843a0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$76\\,234$" :db/id #edb/ref 17592186508673} {:answer/id #uuid "e2b5a82a-32f7-56ee-bf17-a5cd9187194a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$74\\,681$" :db/id #edb/ref 17592186508750}] :answer-field/correct {:answer/id #uuid "e2b5a82a-32f7-56ee-bf17-a5cd9187194a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$74\\,681$" :db/id #edb/ref 17592186508750} :answer-field/id #uuid "98fc00d4-eaa0-5074-a7a2-52d9b8beb28f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186508864}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "38f4d55c-c716-54e2-ab1e-afc12e3f81f0" :question/math-academy-id "q-63874" :question/problem "Olivia bought a home for $$150\\,000.$ The value of the home declined by $16%$ annually. To the nearest dollar, what was the value of the home after $4$ years?" :question/worked-solution "The number $16%$ (expressed as a decimal) is equal to $0.16.$ Therefore, a decrease of $16%$ corresponds to multiplication by a factor of:\n\n$$\n1-0.16=0.84\n$$\n\nTherefore:\n\n- After $1$ year, value of the home was $150\\,000\\cdot (0.84)$ dollars.\n\n- After $2$ years, value of the home was $150\\,000\\cdot (0.84)^{2}$ dollars.\n\n- After $3$ years, value of the home was  $150\\,000\\cdot (0.84)^{3}$ dollars.\n\n- After $4$ years, value of the home was $150\\,000\\cdot (0.84)^{4}$ dollars.\n\nEvaluating the last expression gives:\n\n$$\n150\\,000\\cdot (0.84)^{4}≈74\\,681\n$$\n\nSo, the home was worth $$74\\,681$ (to the nearest dollar) after $4$ years."}]}
