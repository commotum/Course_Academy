      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14114643/observations/step-q98766-e156d6d43ffbff31cde5.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14114643/observations/step-q98766-e156d6d43ffbff31cde5.png",
      "source_url": "https://mathacademy.com/tasks/14114643/topics/3133/review",
