mfrac><mn>1</mn><mrow><mn>3</mn><msqrt><mn>2</mn></msqrt></mrow></mfrac></mstyle></mtd><mtd><mstyle mathbackground=\"lightgray\"><mpadded height=\"+2pt\" depth=\"+2pt\" lspace=\"2pt\" width=\"+4pt\"><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>2</mn><mn>3</mn></mfrac></mstyle></mpadded></mstyle></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>4</mn><mrow><mn>3</mn><msqrt><mn>2</mn></msqrt></mrow></mfrac></mstyle></mtd><mtd><mstyle mathbackground=\"lightgray\"><mpadded height=\"+2pt\" depth=\"+2pt\" lspace=\"2pt\" width=\"+4pt\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle></mpadded></mstyle></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
      "errors": [],
