  "html": "<div id=\"questionExplanation-164207\" class=\"questionExplanation\" style=\"display: block;\"><p>A table showing the metric units of length is given below.</p>\n<table rules=\"all\" cellpadding=\"10\" align=\"center\" style=\"border:1px solid black; margin: auto; margin-bottom: 4mm; margin-top: 4mm\">\n\n<tbody><tr>\n  <th width=\"100\" bgcolor=\"#D6EAF8\" style=\"text-align:center\">Name</th>\n  <th width=\"100\" bgcolor=\"#D6EAF8\" style=\"text-align:center\">Symbol</th>\n</tr>\n\n<tr>\n  <td style=\"text-align:center\">Kilometer</td>\n  <td style=\"text-align:center\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"7\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c6B\"></mjx-c><mjx-c class=\"mjx-c6D\"></mjx-c></mjx-mtext></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>km</mtext></math></mjx-assistive-mml></mjx-container></td>\n</tr>\n\n<tr>\n  <td style=\"text-align:center\">Meter</td>\n  <td style=\"text-align:center\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"8\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c6D\"></mjx-c></mjx-mtext></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>m</mtext></math></mjx-assistive-mml></mjx-container></td>\n</tr>\n\n<tr>\n  <td style=\"text-align:center\">Centimeter</td>\n  <td style=\"text-align:center\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"9\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c63\"></mj