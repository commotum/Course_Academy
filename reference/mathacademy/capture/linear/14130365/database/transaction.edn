-field/id #uuid "64f97041-9cd3-5d58-aeb0-e390e6a72ba3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-90524dbc-214f-5269-b322-bc4196c9a851" :answer-field/choices ["answer-d6bf567d-6f60-5f95-9724-cceed7e712e2" "answer-3c2420b2-4658-532c-a651-9da48e43cb44" "answer-90524dbc-214f-5269-b322-bc4196c9a851" "answer-9ac9de12-d459-53c5-8c13-193b3a9815a6" "answer-459e6c9a-723b-5e15-ab0f-8ffb1d49feef"] :db/ensure [:answer-field/validate]} {:db/id "answer-d6bf567d-6f60-5f95-9724-cceed7e712e2" :answer/id #uuid "d6bf567d-6f60-5f95-9724-cceed7e712e2" :answer/type :answer.type/math :answer/value "100\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "answer-3c2420b2-4658-532c-a651-9da48e43cb44" :answer/id #uuid "3c2420b2-4658-532c-a651-9da48e43cb44" :answer/type :answer.type/math :answer/value "10\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "answer-90524dbc-214f-5269-b322-bc4196c9a851" :answer/id #uuid "90524dbc-214f-5269-b322-bc4196c9a851" :answer/type :answer.type/math :answer/value "12\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "answer-9ac9de12-d459-53c5-8c13-193b3a9815a6" :answer/id #uuid "9ac9de12-d459-53c5-8c13-193b3a9815a6" :answer/type :answer.type/math :answer/value "24\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "answer-459e6c9a-723b-5e15-ab0f-8ffb1d49feef" :answer/id #uuid "459e6c9a-723b-5e15-ab0f-8ffb1d49feef" :answer/type :answer.type/math :answer/value "4\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "question-9fd93641-57bf-5286-b4f7-02833cadeb2f" :question/id #uuid "9fd93641-57bf-5286-b4f7-02833cadeb2f" :question/math-academy-id "q-164252" :question/problem "The distance between a post office and a police station in a particular town is $1\\,mi.$ How much is this distance in yards?" :question/worked-solution "A table showing the customary units of length is given below.\n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Mile | $\\text{mi}$ | $1\\,\\text{mi}=1760\\,\\text{yd}$ |\n| Yard | $\\text{yd}$ | $1\\,\\text{yd}=3\\,\\text{ft}$ |\n| Foot | $\\text{ft}$ | $1\\,\\text{ft}=12\\,\\text{in}$ |\n| Inch | $\\text{in}$ | $-$ |\n\nSo, $1\\,\\text{mi}$ is equivalent to $1760\\,\\text{yd}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-49ffb604-9f8d-5cbb-8024-8360d5077b8f"] :db/ensure [:question/validate]} {:db/id "answer-field-49ffb604-9f8d-5cbb-8024-8360d5077b8f" :answer-field/id #uuid "49ffb604-9f8d-5cbb-8024-8360d5077b8f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c6db2ac6-ad23-5d05-b476-0de628f1e551" :answer-field/choices ["answer-12164cbf-a4c2-5218-ba54-0635314db2c2" "answer-74407b64-a79e-5bc5-b7d1-f9bc872b18b5" "answer-621e556f-f6cc-5ca7-82ee-6890b5972b3d" "answer-c6db2ac6-ad23-5d05-b476-0de628f1e551" "answer-27d50a89-2e75-5c8c-b82b-b457ccb214ea"] :db/ensure [:answer-field/validate]} {:db/id "answer-12164cbf-a4c2-5218-ba54-0635314db2c2" :answer/id #uuid "12164cbf-a4c2-5218-ba54-0635314db2c2" :answer/type :answer.type/math :answer/value "1000\\,\\text{yd}" :db/ensure [:answer/validate]} {:db/id "answer-74407b64-a79e-5bc5-b7d1-f9bc872b18b5" :answer/id #uuid "74407b64-a79e-5bc5-b7d1-f9bc872b18b5" :answer/type :answer.type/math :answer/value "100\\,\\text{yd}" :db/ensure [:answer/validate]} {:db/id "answer-621e556f-f6cc-5ca7-82ee-6890b5972b3d" :answer/id #uuid "621e556f-f6cc-5ca7-82ee-6890b5972b3d" :answer/type :answer.type/math :answer/value "1600\\,\\text{yd}" :db/ensure [:answer/validate]} {:db/id "answer-c6db2ac6-ad23-5d05-b476-0de628f1e551" :answer/id #uuid "c6db2ac6-ad23-5d05-b476-0de628f1e551" :answer/type :answer.type/math :answer/value "1760\\,\\text{yd}" :db/ensure [:answer/validate]} {:db/id "answer-27d50a89-2e75-5c8c-b82b-b457ccb214ea" :answer/id #uuid "27d50a89-2e75-5c8c-b82b-b457ccb214ea" :answer/type :answer.type/math :answer/value "500\\,\\text{yd}" :db/ensure [:answer/validate]} {:db/id "question-6b418b04-bee3-5296-96e8-f3e5b5af816e" :question/id #uuid "6b418b04-bee3-5296-96e8-f3e5b5af816e" :question/math-academy-id "q-164204" :question/problem "A *piccolo* flute is approximately $1\\,\\text{ft}$ long. What is its length in inches?" :question/worked-solution "A table showing the customary units of length is given below.\n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Mile | $\\text{mi}$ | $1\\,\\text{mi}=1760\\,\\text{yd}$ |\n| Yard | $\\text{yd}$ | $1\\,\\text{yd}=3\\,\\text{ft}$ |\n| Foot | $\\text{ft}$ | $1\\,\\text{ft}=12\\,\\text{in}$ |\n| Inch | $\\text{in}$ | $-$ |\n\nSo, $1\\,\\text{ft}$ is equivalent to $12\\,\\text{in}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ff1ff17c-f96e-5808-9d1c-a4e39bab91d0"] :db/ensure [:question/validate]} {:db/id "answer-field-ff1ff17c-f96e-5808-9d1c-a4e39bab91d0" :answer-field/id #uuid "ff1ff17c-f96e-5808-9d1c-a4e39bab91d0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7bcd0b5a-548c-5989-8871-3f2ec9334bc1" :answer-field/choices ["answer-40e0b25e-6bf4-5edc-a537-e1b3781a6685" "answer-7bcd0b5a-548c-5989-8871-3f2ec9334bc1" "answer-6c64facc-4752-5cf0-a7b3-b7138a5f509e" "answer-bff6e0a5-30ef-5ab1-ad0c-73653ce36c15" "answer-81aa6330-e603-5193-bf6d-65fea2e6f475"] :db/ensure [:answer-field/validate]} {:db/id "answer-40e0b25e-6bf4-5edc-a537-e1b3781a6685" :answer/id #uuid "40e0b25e-6bf4-5edc-a537-e1b3781a6685" :answer/type :answer.type/math :answer/value "10\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "answer-7bcd0b5a-548c-5989-8871-3f2ec9334bc1" :answer/id #uuid "7bcd0b5a-548c-5989-8871-3f2ec9334bc1" :answer/type :answer.type/math :answer/value "12\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "answer-6c64facc-4752-5cf0-a7b3-b7138a5f509e" :answer/id #uuid "6c64facc-4752-5cf0-a7b3-b7138a5f509e" :answer/type :answer.type/math :answer/value "24\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "answer-bff6e0a5-30ef-5ab1-ad0c-73653ce36c15" :answer/id #uuid "bff6e0a5-30ef-5ab1-ad0c-73653ce36c15" :answer/type :answer.type/math :answer/value "3\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "answer-81aa6330-e603-5193-bf6d-65fea2e6f475" :answer/id #uuid "81aa6330-e603-5193-bf6d-65fea2e6f475" :answer/type :answer.type/math :answer/value "6\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id 17592186060975 :tutorial/content "**Measuring** means finding a number that describes the size of something. In particular, we determine how long or short an object is by measuring its **length**. We use **length units** to specify an object's length. \n\nThe most popular measurement system within the scientific community is the **metric system**. Within the metric system, the most common units of measurement are called **base units**.\n\nThe base unit of length is the **meter,** which we denote using the symbol \"$\\textrm{m}$.\" Lengths are measured using **meter sticks** like the one below.\n\n![](images/58/58c549aa0dfda587c3d2423c918d12ebfd78b17ef66d44fb78cd2d8d6cb27242.png)\n\nIt's convenient to define new units of measurement from the base unit. The most common variations for length units are shown below:\n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Kilometer | $\\textrm{km}$ | $1\\,\\textrm{km} = 1\\,000\\,\\textrm{m}$ |\n| Meter | $\\textrm{m}$ | Base Unit |\n| Centimeter | $\\textrm{cm}$ | $100\\,\\textrm{cm} = 1\\,\\textrm{m}$ |\n| Millimeter | $\\textrm{mm}$ | $1\\,000\\,\\textrm{mm} = 1\\,\\textrm{m}$ |\n\nLet's give some examples of each unit, going from the largest unit $(\\textrm{km})$ to the smallest $(\\textrm{mm})$:\n\n- The world's tallest building is the Burj Khalifa in Dubai. Its height is approximately $1\\,\\textrm{km}.$\n\n- The length of one large stride is approximately $1\\,\\textrm{m}.$\n\n- The width of a standard paperclip is around $1\\,\\textrm{cm}.$\n\n- The thickness of a credit card is around $1\\,\\textrm{mm}.$\n\n**Important**: Each metric symbol of length ends in \"$\\textrm{m}$\", the base unit." :db/ensure [:tutorial/validate]} {:db/id 17592186060980 :tutorial/content "Let's recall the table that relates metric units of length.\n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Kilometer | $\\textrm{km}$ | $1\\,\\textrm{km} = 1\\,000\\,\\textrm{m}$ |\n| Meter | $\\textrm{m}$ | Base Unit |\n| Centimeter | $\\textrm{cm}$ | $100\\,\\textrm{cm} = 1\\,\\textrm{m}$ |\n| Millimeter | $\\textrm{mm}$ | $1\\,000\\,\\textrm{mm} = 1\\,\\textrm{m}$ |\n\n**Important**: Symbols in the metric system follow a consistent set of **prefix rules**, which we explain below. If you find these difficult, *do not worry*! For now, you just need to remember the conversions shown in the table above. \n\nThe prefix rules are as follows:\n\n- The prefix \"$\\textrm k$\" stands for **kilo**, which means $1\\,000$. Therefore, $1\\,\\textrm{km} = 1\\,000\\,\\textrm{m}.$\n\n- The prefix \"$\\textrm c$\" stands for **centi**, which means $\\dfrac{1}{100}$. Therefore, $1\\,\\textrm{cm} = \\dfrac{1}{100}\\,\\textrm{m}.$ \n\n Notice that if we add $1\\,\\textrm{cm}$ to itself $100$ times, we get exactly $1\\,\\textrm{m}{:}$\n\n$$\n\\begin{aligned}\\overset{100\\text{ times}}{\\overset{⏞}{1\\,\\text{cm}+1\\,\\text{cm}+⋯+1\\,\\text{cm}}} & = \\\\ \\frac{1}{100}\\,\\text{m}+\\frac{1}{100}\\,\\text{m}+⋯+\\frac{1}{100}\\,\\text{m} & = \\\\ 100\\times \\frac{1}{100}\\,\\text{m} & = \\\\ \\frac{100\\times 1}{100}\\,\\text{m} & = \\\\ \\frac{100}{100}\\,\\text{m} & = \\\\ 1\\,\\text{m}\\end{aligned}\n$$\n\nTherefore, $100\\,\\textrm{cm}$ equals $1\\,\\textrm{m},$ as stated in the table.\n\n- The prefix \"$\\textrm m$\" stands for **milli**, which means $\\dfrac{1}{1\\,000}$. Therefore, $1\\,\\textrm{mm} = \\dfrac{1}{1,000}\\,\\textrm{m}.$ This means that $1\\,000\\,\\textrm{mm}$ equals $1\\,\\textrm{m},$ as shown in the table." :db/ensure [:tutorial/validate]} {:db/id 17592186060976 :tutorial/content "Another way to measure length is to use **customary units**. The most common customary units for length are **inch**, **foot**, **yard**, and **mile**. \n\nA table showing some of the most common customary units of length is shown below.\n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Mile | $\\textrm{mi}$ | $1\\,\\textrm{mi}=1760\\,\\textrm{yd}$ |\n| Yard | $\\textrm{yd}$ | $1\\,\\textrm{yd} = 3\\,\\textrm{ft}$ |\n| Foot | $\\textrm{ft}$ | $1\\,\\textrm{ft}=12\\,\\textrm{in}$ |\n| Inch | $\\textrm{in}$ | $-$ |\n\nLet's give some examples of each unit, going from the largest unit $(\\textrm{mi})$ to the smallest $(\\textrm{in})$:\n\n- Four loops around a standard running track is approximately $1\\,\\textrm{mi}.$\n\n- The length of one large stride is approximately $1\\,\\textrm{yd}.$\n\n- The length of an adult's foot is approximately $1\\,\\textrm{ft}.$\n\n- The length of an adult's thumb tip is around $1\\,\\textrm{in}.$\n\nCustomary units are not standard in the scientific community. However, they are commonly used in the United States and other countries." :db/ensure [:tutorial/validate]} {:db/id 17592186059915 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
