ical-example {:db/id #edb/ref 17592186151823 :question/id #uuid "1fedcc75-84fe-5f3f-9555-896493c91232" :question/math-academy-id "e-12834"} :knowledge-point/id #uuid "b48ae5a6-0426-58c1-ab88-10b748043f6f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048825}] :knowledge-point/questions [{:db/id #edb/ref 17592186152689} {:db/id #edb/ref 17592186152695} {:db/id #edb/ref 17592186479059} {:db/id #edb/ref 17592186479063} {:db/id #edb/ref 17592186493958}] :knowledge-point/title "Evaluating Expressions Containing Parentheses"} :step/id #uuid "bedf91c3-f3f7-550e-b3c7-731b61060441" :step/math-academy-id 72832}] :activity/title "Evaluating Rational Number Expressions Without Exponents" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186152316}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186494032} :activity/id #uuid "93d82c70-ff29-55ed-9d22-40031a1c626d" :activity/scope {:db/id #edb/ref 17592186048888 :topic/id #uuid "c99b0c35-73da-506e-b41f-7fd90b5fde25" :topic/math-academy-id 2561} :activity/steps [{:db/id #edb/ref 17592186493980 :step/content {:db/id #edb/ref 17592186493958 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c7ca818-f28b-5d60-b216-a2e87b1e5db2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8.8" :db/id #edb/ref 17592186493494}] :answer-field/correct {:db/id #edb/ref 17592186493494} :answer-field/id #uuid "c4974698-7ea2-58ec-9b02-4e54bbb36aee" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186493873}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c9b4fb98-fcb9-51e9-9d1c-a0e33aad2c53" :question/math-academy-id "q-175320" :question/problem "$(-4)\\times (2.3-0.1)=${{field-1}}" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, we perform the operation inside the parentheses:\n\n$$\n\\begin{aligned}(-4)\\times (2.3-0.1) & = \\\\ (-4)\\times 2.2\\end{aligned}\n$$\n\nFinally, we multiply:\n\n$$\n\\begin{aligned}(-4)\\times 2.2 & =-8.8\\end{aligned}\n$$"} :step/id #uuid "13d18f39-8c3e-50cf-926a-da6be8b2ee39" :step/next {:db/id #edb/ref 17592186494024}} {:db/id #edb/ref 17592186494024 :step/content {:db/id #edb/ref 17592186493960 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6da77181-6032-5e5c-929d-4a017fc0454f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-60" :db/id #edb/ref 17592186493553}] :answer-field/correct {:db/id #edb/ref 17592186493553} :answer-field/id #uuid "5932016c-ec0a-5d79-9f39-b11ee0e695a8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186493826}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d4dc1b86-0478-57c7-a48b-3ee42621256c" :question/math-academy-id "q-175957" :question/problem "Expressed as an integer, $(-4)÷(\\frac{2}{5})\\times 6=${{field-1}}" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe multiply and divide, from left to right:\n\n$$\n\\begin{aligned}(-4)÷\\frac{2}{5}\\times 6 & = \\\\ ((-4)÷\\frac{2}{5})\\times 6 & = \\\\ (\\frac{-4}{1}\\times \\frac{5}{2})\\times 6 & = \\\\ (\\frac{(-4)\\times 5}{1\\times 2})\\times 6 & = \\\\ (-\\frac{20}{2})\\times 6 & = \\\\ (-10)\\times 6 & = \\\\ -60\\end{aligned}\n$$"} :step/id #uuid "7f0b0168-fedc-5b19-9f11-bf9a623d5ec4"} {:db/id #edb/ref 17592186494032 :step/content {:db/id #edb/ref 17592186493916 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12992113-2342-5279-9f39-93240a16d420" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186493424} {:answer/id #uuid "96d4b2d0-aff1-5142-9b3d-ae023cf3bdf8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30" :db/id #edb/ref 17592186493628} {:answer/id #uuid "9f727f0d-4e72-5891-b43a-44489bd73c19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186493642} {:answer/id #uuid "b594613f-b609-5d9f-b507-7ed04d8bb283" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40" :db/id #edb/ref 17592186493685} {:answer/id #uuid "e4eed5e2-fde8-5761-9397-e3a699b2d564" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186493754}] :answer-field/correct {:db/id #edb/ref 17592186493424} :answer-field/id #uuid "ae7bcc7d-7b8b-541d-a96a-a62bcd62870a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493861}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4227b37a-8e18-5afd-83bf-26143e32cd4d" :question/math-academy-id "q-68842" :question/problem "$2÷\\frac{2}{5}\\times 4=$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe divide and multiply, from left to right:\n\n$$\n\\begin{aligned}2÷\\frac{2}{5}\\times 4 & = \\\\ (2÷\\frac{2}{5})\\times 4 & = \\\\ (2\\times \\frac{5}{2})\\times 4 & = \\\\ (\\frac{2}{1}\\times \\frac{5}{2})\\times 4 & = \\\\ \\frac{2\\times 5}{1\\times 2}\\times 4 & = \\\\ \\frac{\\cancel{2}\\times 5}{1\\times \\cancel{2}}\\times 4 & = \\\\ 5\\times 4 & = \\\\ 20\\end{aligned}\n$$"} :step/id #uuid "8bcf62cd-f6d0-59f6-b33f-9300365fc7dc" :step/next {:db/id #edb/ref 17592186493980}}] :activity/title "Evaluating Rational Number Expressions Without Exponents" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186493382}]}
