#{[{:db/id #edb/ref 17592186493958 :knowledge-point/_questions [{:db/id #edb/ref 17592186152302 :knowledge-point/id #uuid "b48ae5a6-0426-58c1-ab88-10b748043f6f" :knowledge-point/title "Evaluating Expressions Containing Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c7ca818-f28b-5d60-b216-a2e87b1e5db2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8.8" :db/id #edb/ref 17592186493494}] :answer-field/correct {:answer/id #uuid "3c7ca818-f28b-5d60-b216-a2e87b1e5db2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8.8" :db/id #edb/ref 17592186493494} :answer-field/id #uuid "c4974698-7ea2-58ec-9b02-4e54bbb36aee" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493873}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c9b4fb98-fcb9-51e9-9d1c-a0e33aad2c53" :question/math-academy-id "q-175320" :question/problem "$(-4)\\times (2.3-0.1)=${{field-1}}" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, we perform the operation inside the parentheses:\n\n$$\n\\begin{aligned}(-4)\\times (2.3-0.1) & = \\\\ (-4)\\times 2.2\\end{aligned}\n$$\n\nFinally, we multiply:\n\n$$\n\\begin{aligned}(-4)\\times 2.2 & =-8.8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493960 :knowledge-point/_questions [{:db/id #edb/ref 17592186152300 :knowledge-point/id #uuid "b3656cdd-e02d-5ce5-805c-8c76cc0f5996" :knowledge-point/title "Evaluating Expressions With Multiplication and Division"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6da77181-6032-5e5c-929d-4a017fc0454f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186493553}] :answer-field/correct {:answer/id #uuid "6da77181-6032-5e5c-929d-4a017fc0454f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186493553} :answer-field/id #uuid "5932016c-ec0a-5d79-9f39-b11ee0e695a8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493826}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d4dc1b86-0478-57c7-a48b-3ee42621256c" :question/math-academy-id "q-175957" :question/problem "Expressed as an integer, $(-4)÷(\\frac{2}{5})\\times 6=${{field-1}}" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe multiply and divide, from left to right:\n\n$$\n\\begin{aligned}(-4)÷\\frac{2}{5}\\times 6 & = \\\\ ((-4)÷\\frac{2}{5})\\times 6 & = \\\\ (\\frac{-4}{1}\\times \\frac{5}{2})\\times 6 & = \\\\ (\\frac{(-4)\\times 5}{1\\times 2})\\times 6 & = \\\\ (-\\frac{20}{2})\\times 6 & = \\\\ (-10)\\times 6 & = \\\\ -60\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493916 :knowledge-point/_questions [{:db/id #edb/ref 17592186152300 :knowledge-point/id #uuid "b3656cdd-e02d-5ce5-805c-8c76cc0f5996" :knowledge-point/title "Evaluating Expressions With Multiplication and Division"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12992113-2342-5279-9f39-93240a16d420" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186493424} {:answer/id #uuid "96d4b2d0-aff1-5142-9b3d-ae023cf3bdf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186493628} {:answer/id #uuid "9f727f0d-4e72-5891-b43a-44489bd73c19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186493642} {:answer/id #uuid "b594613f-b609-5d9f-b507-7ed04d8bb283" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186493685} {:answer/id #uuid "e4eed5e2-fde8-5761-9397-e3a699b2d564" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186493754}] :answer-field/correct {:answer/id #uuid "12992113-2342-5279-9f39-93240a16d420" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186493424} :answer-field/id #uuid "ae7bcc7d-7b8b-541d-a96a-a62bcd62870a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493861}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4227b37a-8e18-5afd-83bf-26143e32cd4d" :question/math-academy-id "q-68842" :question/problem "$2÷\\frac{2}{5}\\times 4=$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe divide and multiply, from left to right:\n\n$$\n\\begin{aligned}2÷\\frac{2}{5}\\times 4 & = \\\\ (2÷\\frac{2}{5})\\times 4 & = \\\\ (2\\times \\frac{5}{2})\\times 4 & = \\\\ (\\frac{2}{1}\\times \\frac{5}{2})\\times 4 & = \\\\ \\frac{2\\times 5}{1\\times 2}\\times 4 & = \\\\ \\frac{\\cancel{2}\\times 5}{1\\times \\cancel{2}}\\times 4 & = \\\\ 5\\times 4 & = \\\\ 20\\end{aligned}\n$$"}]}
