#{[{:activity/first-step {:db/id #edb/ref 17592186074592} :activity/id #uuid "46f0a6e7-151f-5ed2-99d7-1f23744fcd6d" :activity/scope {:db/id #edb/ref 17592186049415 :topic/id #uuid "f305b2e8-0949-5442-9a4e-a0e42cc69236" :topic/math-academy-id 530} :activity/steps [{:db/id #edb/ref 17592186074592 :step/content {:db/id #edb/ref 17592186075045 :tutorial/content "To divide a unit fraction by a whole number, we multiply the fraction's denominator by the whole number.\n\nFor example, to calculate\n\n$$\n\\dfrac{1}{5} \\div {\\color{blue}2}\n$$\n\nwe multiply the fraction's denominator by ${\\color{blue}2}\\!$:\n\n$$\n\\dfrac{1}{5} \\div {\\color{blue}2} = \\dfrac{1}{5 \\times {\\color{blue}2}} = \\dfrac{1}{10}\n$$\n\nNotice that we get the same answer using a fraction model, and the process is similar.\n\n![](images/3f/3f1f0dddd115c0d820de4d79624bd87492e215a6c2de43071fda73a4a0684d77.png)" :tutorial/id #uuid "fcf4ea8b-7765-55e8-b5c1-a10899bee9f6" :tutorial/math-academy-id 8562 :tutorial/title "Introduction"} :step/id #uuid "b474bf4e-2005-5555-a057-fd7db3b289b5" :step/math-academy-id 136312 :step/next {:db/id #edb/ref 17592186074593}} {:db/id #edb/ref 17592186074593 :step/content {:db/id #edb/ref 17592186073707 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073463 :question/id #uuid "abfb2b94-b25f-589f-b1e0-883ce065ca7a" :question/math-academy-id "e-13698"} :knowledge-point/id #uuid "9ae15778-3c9c-549a-bde8-58875c98d1bc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048460} {:db/id #edb/ref 17592186050735}] :knowledge-point/questions [{:db/id #edb/ref 17592186074055} {:db/id #edb/ref 17592186074276} {:db/id #edb/ref 17592186074282}] :knowledge-point/title "Dividing a Unit Fraction"} :step/id #uuid "fc606030-824f-518c-b2c2-61a2081b0469" :step/math-academy-id 136313 :step/next {:db/id #edb/ref 17592186074594}} {:db/id #edb/ref 17592186074594 :step/content {:db/id #edb/ref 17592186073708 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073