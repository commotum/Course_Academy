#{[{:db/id #edb/ref 17592186073463 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073707 :knowledge-point/id #uuid "9ae15778-3c9c-549a-bde8-58875c98d1bc" :knowledge-point/title "Dividing a Unit Fraction"}] :question/id #uuid "abfb2b94-b25f-589f-b1e0-883ce065ca7a" :question/math-academy-id "e-13698" :question/problem "What is the value of $\\dfrac{1}{4} \\div 3$?" :question/worked-solution "To divide a unit fraction by a whole number, we multiply the fraction's denominator by that whole number:\n\n$$\n\\dfrac{1}{4} \\div 3 = \\dfrac{1}{4 \\times 3} = \\dfrac{1}{12}\n$$"}] [{:db/id #edb/ref 17592186073465 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073708 :knowledge-point/id #uuid "a2697799-83d5-5358-8f7e-32562fd91169" :knowledge-point/title "Dividing a Unit Fraction With a Two-Digit Denominator"}] :question/id #uuid "e5ecc6c8-ef8d-569b-88cc-82fc31f09730" :question/math-academy-id "e-13700" :question/problem "What is the value of $\\dfrac{1}{16} \\div 5$?" :question/worked-solution "To divide a unit fraction by a whole number, we multiply the fraction's denominator by that whole number:\n\n$$\n\\dfrac{1}{16} \\div 5 = \\dfrac{1}{16 \\times 5} = \\dfrac{1}{80}\n$$"}] [{:db/id #edb/ref 17592186073466 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073709 :knowledge-point/id #uuid "fb0eb807-0eda-5565-ae49-a89a97a5b016" :knowledge-point/title "Word Problems"}] :question/id #uuid "b95874b2-2a8e-5ffb-9cbf-8a919a7307fb" :question/math-academy-id "e-13705" :question/problem "Joshua uses $\\dfrac{1}{2} \\, \\textrm{kg}$ of ham to make $4$ pizzas. If the ham is distributed equally among the $4$ pizzas, how much ham does he put on each pizza?" :question/worked-solution "To determine the amount of ham on each pizza, we must divide the amount of ham by the number of pizzas:\n\n$$\n\\dfrac{1}{2} \\div 4\n$$\n\nTo divide a unit fraction by a whole number, we multiply the fraction's denominator by that whole number:\n\n$$\n\\dfrac{1}{2} \\div 4 = \\dfrac{1}{2 \\times 4} = \\dfrac{1}{8}\n$$\n\nTherefore, Joshua puts\n\n$$\n\\dfrac{1}{8} \\, \\textrm{kg}\n$$\n\nof ham on each pizza."}]}
