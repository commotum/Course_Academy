86045498} :answer/value "y\\in (-\\infty ,\\frac{7}{2}]" :db/id #edb/ref 17592186573421} {:answer/id #uuid "1e47d1d4-3d4b-5990-8852-84da67ed1aa2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186573457} {:answer/id #uuid "4b15ece3-d0d6-5f29-9033-ac893c7f0278" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y\\in [\\frac{7}{2},\\infty )" :db/id #edb/ref 17592186573513} {:answer/id #uuid "f31cfaef-c698-5520-9e5a-a8bad3c27c9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y\\in (-\\infty ,2]" :db/id #edb/ref 17592186573751} {:answer/id #uuid "ff2925b7-899a-5f43-86d7-9ca7119df9a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y\\in [2,\\infty )" :db/id #edb/ref 17592186573768}] :answer-field/correct {:db/id #edb/ref 17592186573751} :answer-field/id #uuid "5f4590d7-63a8-5906-9db9-e3c79e28fd23" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186573810}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c0ea79a6-c67e-5025-8851-d3340ce04b62" :question/math-academy-id "q-115847" :question/problem "What is the range of $f(x)=-3\\sqrt[4]{2x-7}+2?$" :question/worked-solution "The range of $\\sqrt[4]{x}$ is\n\n$$\n\\sqrt[4]{x}\\ge 0.\n$$\n\nHorizontal shifts and stretches do not affect the range. Hence,\n\n$$\n\\sqrt[4]{2x-7}\\ge 0.\n$$\n\nMultiplying the above inequality by $-3$ and then adding $2,$ we get\n\n$$\n\\begin{aligned}\\sqrt[4]{2x-7} & \\ge 0 \\\\ -3\\sqrt[4]{2x-7} & \\le 0 \\\\ -3\\sqrt[4]{2x-7}+2 & \\le 2.\\end{aligned}\n$$\n\nTherefore, the range of the given function is $f(x)\\in (-\\infty ,2].$\n\nWe can also see that this is true from the graph of the function. The graph of $y=f(x)$ is shown below.\n\n![](images/e3/e39c45712a29b46df780efe37214aaafb3cb7ab1fa25072c4d9ca21a8bf6c731.png)"} :step/id #uuid "896ef864-228b-5e21-b144-577a92b10f1f"} {:db/id #edb/ref 17592186573971 :step/content {:db/id #edb/ref 17592186573914 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "060a50f3-17f0-5576-adec-3ba09c09188f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y\\in (-\\infty ,\\frac{4}{3}]" :db/id #edb/ref 17592186573430} {:answer/id #uuid "07381586-b8a1-5af8-95ad-a157695e9d4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y\\in (-\\infty ,2]" :db/id #edb/ref 17592186573431} {:answer/id #uuid "1c435279-0dd3-5a3c-a368-afe7f21e6ecc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186573453} {:answer/id #uuid "3cdda6e7-9244-54c5-ab6a-91402d74d45e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y\\in [2,\\infty )" :db/id #edb/ref 17592186573498} {:answer/id #uuid "4eed7b94-a229-54b1-857e-d360605e3623" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y\\in [\\frac{4}{3},\\infty )" :db/id #edb/ref 17592186573517}] :answer-field/correct {:db/id #edb/ref 17592186573431} :answer-field/id #uuid "c9e2bdc9-652d-56aa-ac6f-890e907f7f7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186573844}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b3dce8b7-4368-5263-9706-4359213faf4b" :question/math-academy-id "q-98659" :question/problem "What is the range of $f(x)=-4\\sqrt[6]{4-3x}+2?$" :question/worked-solution "The range of $\\sqrt[6]{x}$ is\n\n$$\n\\sqrt[6]{x}\\ge 0.\n$$\n\nHorizontal shifts and stretches do not affect the range. Hence,\n\n$$\n\\sqrt[6]{4-3x}\\ge 0.\n$$\n\nMultiplying the above inequality by $-4$ and then adding $2,$ we get\n\n$$\n\\begin{aligned}\\sqrt[6]{4-3x} & \\ge 0 \\\\ -4\\sqrt[6]{4-3x} & \\le 0 \\\\ -4\\sqrt[6]{4-3x}+2 & \\le 2.\\end{aligned}\n$$\n\nTherefore, the range of the given function is $f(x)\\in (-\\infty ,2].$\n\nWe can also see that this is true from the graph of the function. The graph of $y=f(x)$ is shown below.\n\n![](images/03/03804e230140549dd67834281d98130a0113122ded9d491b331d7ae76c621e93.png)"} :step/id #uuid "b1e386f4-59ca-5d77-b97f-dc5470bf3762" :step/next {:db/id #edb/ref 17592186573967}}] :activity/title "The Range of a Transformed Radical Function" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186573418}]}
