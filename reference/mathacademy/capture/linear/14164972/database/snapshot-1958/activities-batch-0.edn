#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186230113} :activity/id #uuid "72a697c0-6ee2-52bc-82b4-b77c00f05069" :activity/scope {:db/id #edb/ref 17592186050625 :topic/id #uuid "59db5455-7d67-57c4-8cb4-9c457475eed5" :topic/math-academy-id 6642} :activity/steps [{:db/id #edb/ref 17592186230113 :step/content {:db/id #edb/ref 17592186230167 :tutorial/content "In many real-world situations, such as in retail or finance, it is necessary to apply multiple percentages in succession.\n\nTo do so, we perform one percentage calculation and then apply another percentage to the *result* of the previous calculation.\nThis means each new percentage is based on a *new amount*, not on the original number.\n\nTo demonstrate, let's find $40\\%$ of $150,$ and then $25\\%$ of the result.\n\nFirst, we find $40\\%$ of $150{:}$\n\n$$\n\\begin{aligned}40%\\times 150 & =\\frac{40}{100}\\times 150 \\\\  & =0.4\\times 150 \\\\  & =60\\end{aligned}\n$$\n\nSo, after the first step, the result is $60.$\nThen, we find $25\\%$ of the result:\n\n$$\n\\begin{aligned}25%\\times 60 & =\\frac{25}{100}\\times 60 \\\\  & =0.25\\times 60 \\\\  & =15\\end{aligned}\n$$\n\nTherefore, after applying both percentages in succession, the final answer is $15.$" :tutorial/id #uuid "81602213-1c20-5c8a-86ba-be4dd5c94554" :tutorial/math-academy-id 14335 :tutorial/title "Introduction"} :step/id #uuid "6e6a90ca-fd31-5cbd-a1b4-0385b456029a" :step/math-academy-id 615754 :step/next {:db/id #edb/ref 17592186230114}} {:db/id #edb/ref 17592186230114 :step/content {:db/id #edb/ref 17592186229193 :knowledge-point/canonical-example {:db/id #edb/ref 17592186228884 :question/id #uuid "91ca6940-1bc7-583b-8bac-81d7da934167" :question/math-academy-id "e-21463"} :knowledge-point/id #uuid "ec0d62dd-5b51-5286-b382-776412570561" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050030} {:db/id #edb/ref 17592186050716}] :knowledge-point/questions [{:db/id #edb/ref 17592186229608} {:db/id #edb/ref 17592186229612} {:db/id #edb/ref 17592186486434} {:db/id #edb/ref 17592186486452}] :knowledge-point/title "Applying Subsequent Percentages"} :step/id #uuid "b793c54c-3bb6-5cc0-a0c0-48969b4d982c" :step/math-academy-id 615756 :step/next {:db/id #edb/ref 17592186230115}} {:db/id #edb/ref 17592186230115 :step/content {:db/id #edb/ref 17592186229194 :knowledge-point/canonical-example {:db/id #edb/ref 17592186228882 :question/id #uuid "97d0ab51-97cd-5781-be30-4d70adc5d214" :question/math-academy-id "e-21458"} :knowledge-point/id #uuid "3852a0f9-f1ac-5a3f-9883-8dd2ee03e332" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049467}] :knowledge-point/questions [{:db/id #edb/ref 17592186229609} {:db/id #edb/ref 17592186229617} {:db/id #edb/ref 17592186486368} {:db/id #edb/ref 17592186486404}] :knowledge-point/title "Applying Subsequent Percentages in Real-World Situations"} :step/id #uuid "c03e2806-a10c-543b-9b5f-7884c7db45f1" :step/math-academy-id 615760 :step/next {:db/id #edb/ref 17592186230116}} {:db/id #edb/ref 17592186230116 :step/content {:db/id #edb/ref 17592186230171 :tutorial/content "When percentages are applied in succession, it is useful to represent their combined effect as a single percentage of the original amount. \n\nThis means that, instead of applying one percentage and then another, we can multiply their decimal multipliers to find an overall multiplier (or percentage) for the total change. \n\nFor example, suppose that a city’s library membership rose to $150\\%$ of the previous year’s total. Of these members, $40\\%$ borrowed digital books. What percentage of last year’s members borrowed digital books?\n\nFirst, let $x$ be the number of members in the previous year.\n\nWe're told that membership rose to $150\\%$ of the previous year’s total. Thus, the new number of members is \n\n$$\n1.5x.\n$$\n\nWe are also told that of those members, $40\\%$ borrowed digital books. So, the number of members who borrowed digital books is\n\n$$\n0.4(1.5x) = 0.6x.\n$$\n\nThe expression $0.6x$ represents $60\\%$ of $x.$ Therefore, $60\\%$ of last year’s members borrowed digital books." :tutorial/id #uuid "7bc4fcd7-c5b4-530f-8d3e-668da5241ab4" :tutorial/math-academy-id 14343 :tutorial/title "Subsequent Percentage Applications as a Single Percentage"} :step/id #uuid "80cd6820-e776-5d8b-80df-989f1f917a46" :step/math-academy-id 615763 :step/next {:db/id #edb/ref 17592186230117}} {:db/id #edb/ref 17592186230117 :step/content {:db/id #edb/ref 17592186229195 :knowledge-point/canonical-example {:db/id #edb/ref 17592186228877 :question/id #uuid "4f528740-2fa6-5441-ab8b-86ce294dbf75" :question/math-academy-id "e-21447"} :knowledge-point/id #uuid "d35c9f72-a876-5fc0-8ab4-741c37cb3775" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049194} {:db/id #edb/ref 17592186051009}] :knowledge-point/questions [{:db/id #edb/ref 17592186229594} {:db/id #edb/ref 17592186229613} {:db/id #edb/ref 17592186486374} {:db/id #edb/ref 17592186486403}] :knowledge-point/title "Expressing Subsequent Percentages as a Single Percentage"} :step/id #uuid "dbf3edd7-461c-5d9e-b8a3-744c45503bf4" :step/math-academy-id 615764}] :activity/title "Applying Percentages in Succession" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186229243}]}
