#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186230113} :activity/id #uuid "72a697c0-6ee2-52bc-82b4-b77c00f05069" :activity/scope {:db/id #edb/ref 17592186050625 :topic/id #uuid "59db5455-7d67-57c4-8cb4-9c457475eed5" :topic/math-academy-id 6642} :activity/steps [{:db/id #edb/ref 17592186230113 :step/content {:db/id #edb/ref 17592186230167 :tutorial/content "In many real-world situations, such as in retail or finance, it is necessary to apply multiple percentages in succession.\n\nTo do so, we perform one percentage calculation and then apply another percentage to the *result* of the previous calculation.\nThis means each new percentage is based on a *new amount*, not on the original number.\n\nTo demonstrate, let's find $40\\%$ of $150,$ and then $25\\%$ of the result.\n\nFirst, we find $40\\%$ of $150{:}$\n\n$$\n\\begin{aligned}40%\\times 150 & =\\frac{40}{100}\\times 150 \\\\  & =0.4\\times 150 \\\\  & =60\\end{aligned}\n$$\n\nSo, after the first step, the result is $60.$\nThen, we find $25\\%$ of the result:\n\n$$\n\\begin{aligned}25%\\times 60 & =\\frac{25}{100}\\times 60 \\\\  & =0.25\\times 60 \\\\  & =15\\end{aligned}\n$$\n\nTherefore, after applying both percentages in succession, the final answer is $15.$" :tutorial/id #uuid "81602213-1c20-5c8a-86ba-be4dd5c94554" :tutorial/math-academy-id 14335 :tutorial/title "Introduction"} :step/id #uuid "6e6a90ca-fd31-5cbd-a1b4-0385b456029a" :step/math-academy-id 615754 :step/next {:db/id #edb/ref 17592186230114}} {:db/id #edb/ref 17592186230114 :step/content {:db/id #edb/ref 17592186229193 :knowledge-point/canonical-example {:db/id #edb/ref 17592186228884 :question/id #uuid "91ca6940-1bc7-583b-8bac-81d7da934167" :question/math-academy-id "e-21463"} :knowledge-point/id #uuid "ec0d62dd-5b51-5286-b382-776412570561" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050030} {:db/id #edb/ref 17592186050716}] :knowledge-point/questions [{:db/id #edb/ref 17592186229608} {:db/id #edb/ref 17592186229612} {:db/id #edb/ref 17592186486434} {:db/id #edb/ref 17592186486452}] :knowledge-point/title "Applying Subsequent Percentages"} :step/id #uuid "b793c54c-3bb6-5cc0-a0c0-48969b4d982c" :step/math-academy-id 615756 :step/next {:db/id #edb/ref 17592186230115}} {:db/id #edb/ref 17592186230115 :step/content {:db/id #edb/ref 17592186229194 :knowledge-point/canonical-example {:db/id #edb/ref 17592186228882 :question/id #uuid "97d0ab51-97cd-5781-be30-4d70adc5d214" :question/math-academy-id "e-21458"} :knowledge-point/id #uuid "3852a0f9-f1ac-5a3f-9883-8dd2ee03e332" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049467}] :knowledge-point/questions [{:db/id #edb/ref 17592186229609} {:db/id #edb/ref 17592186229617} {:db/id #edb/ref 17592186486368} {:db/id #edb/ref 17592186486404} {:db/id #edb/ref 17592186489176} {:db/id #edb/ref 17592186489268}] :knowledge-point/title "Applying Subsequent Percentages in Real-World Situations"} :step/id #uuid "c03e2806-a10c-543b-9b5f-7884c7db45f1" :step/math-academy-id 615760 :step/next {:db/id #edb/ref 17592186230116}} {:db/id #edb/ref 17592186230116 :step/content {:db/id #edb/ref 17592186230171 :tutorial/content "When percentages are applied in succession, it is useful to represent their combined effect as a single percentage of the original amount. \n\nThis means that, instead of applying one percentage and then another, we can multiply their decimal multipliers to find an overall multiplier (or percentage) for the total change. \n\nFor example, suppose that a city’s library membership rose to $150\\%$ of the previous year’s total. Of these members, $40\\%$ borrowed digital books. What percentage of last year’s members borrowed digital books?\n\nFirst, let $x$ be the number of members in the previous year.\n\nWe're told that membership rose to $150\\%$ of the previous year’s total. Thus, the new number of members is \n\n$$\n1.5x.\n$$\n\nWe are also told that of those members, $40\\%$ borrowed digital books. So, the number of members who borrowed digital books is\n\n$$\n0.4(1.5x) = 0.6x.\n$$\n\nThe expression $0.6x$ represents $60\\%$ of $x.$ Therefore, $60\\%$ of last year’s members borrowed digital books." :tutorial/id #uuid "7bc4fcd7-c5b4-530f-8d3e-668da5241ab4" :tutorial/math-academy-id 14343 :tutorial/title "Subsequent Percentage Applications as a Single Percentage"} :step/id #uuid "80cd6820-e776-5d8b-80df-989f1f917a46" :step/math-academy-id 615763 :step/next {:db/id #edb/ref 17592186230117}} {:db/id #edb/ref 17592186230117 :step/content {:db/id #edb/ref 17592186229195 :knowledge-point/canonical-example {:db/id #edb/ref 17592186228877 :question/id #uuid "4f528740-2fa6-5441-ab8b-86ce294dbf75" :question/math-academy-id "e-21447"} :knowledge-point/id #uuid "d35c9f72-a876-5fc0-8ab4-741c37cb3775" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049194} {:db/id #edb/ref 17592186051009}] :knowledge-point/questions [{:db/id #edb/ref 17592186229594} {:db/id #edb/ref 17592186229613} {:db/id #edb/ref 17592186486374} {:db/id #edb/ref 17592186486403} {:db/id #edb/ref 17592186489225} {:db/id #edb/ref 17592186489291}] :knowledge-point/title "Expressing Subsequent Percentages as a Single Percentage"} :step/id #uuid "dbf3edd7-461c-5d9e-b8a3-744c45503bf4" :step/math-academy-id 615764}] :activity/title "Applying Percentages in Succession" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186229243}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186489377} :activity/id #uuid "c74fe8fe-ab17-5021-aa6e-cba45f79c1ff" :activity/scope {:db/id #edb/ref 17592186050625 :topic/id #uuid "59db5455-7d67-57c4-8cb4-9c457475eed5" :topic/math-academy-id 6642} :activity/steps [{:db/id #edb/ref 17592186489306 :step/content {:db/id #edb/ref 17592186489176 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d814d78-c63a-5ab2-ad13-3b9219c8d97c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186488502}] :answer-field/correct {:db/id #edb/ref 17592186488502} :answer-field/id #uuid "7a897728-e4f7-5404-b951-a57ef68ace56" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186489083}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0a83854e-3aa1-59c0-86af-4b09c747a5fc" :question/math-academy-id "q-327532" :question/problem "A chemist increased the concentration of a lab solution to $125%$ of its original level. An additional reagent then increased that new concentration by $20%.$ If the original concentration was $80$ units, how many additional units were added solely by the reagent?\n\nThe reagent added \n{{field-1}}\nadditional units to the concentration." :question/worked-solution "First, the new concentration is $125%$ of the original $(80$ units$):$\n\n$$\n\\begin{aligned}125%\\times 80 & =\\frac{125}{100}\\times 80 \\\\  & =1.25\\times 80 \\\\  & =100\\end{aligned}\n$$\n\nSo, the new concentration is $100$ units. Then, the increase due to the reagent is $20%$ of this amount:\n\n$$\n\\begin{aligned}20%\\times 100 & =\\frac{20}{100}\\times 100 \\\\  & =0.2\\times 100 \\\\  & =20\\end{aligned}\n$$\n\nTherefore, the reagent added $20$ additional units to the concentration."} :step/id #uuid "2953197d-53f0-53b5-ae5a-55d33ffe4638" :step/next {:db/id #edb/ref 17592186489309}} {:db/id #edb/ref 17592186489309 :step/content {:db/id #edb/ref 17592186489268 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd4fe015-c4ea-5dd1-9dd5-eccb94b29510" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186488888}] :answer-field/correct {:db/id #edb/ref 17592186488888} :answer-field/id #uuid "6d38fd3a-1929-5eb8-b057-98cae4f07a49" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186489069}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ce7e59b5-3648-5abc-999d-9cb3832d5475" :question/math-academy-id "q-327544" :question/problem "An event organizer raised a ticket’s price to $160%$ of its original cost. A tax of $10%$ was applied to the marked-up price. If the ticket originally cost $$75,$ what is the tax?\n\nThe tax on the ticket is $$$  \n{{field-1}}." :question/worked-solution "First, the marked-up price is $160%$ of the original cost $($75):$\n\n$$\n\\begin{aligned}160%\\times 75 & =\\frac{160}{100}\\times 75 \\\\  & =1.6\\times 75 \\\\  & =120\\end{aligned}\n$$\n\nSo, the marked-up price of the ticket is $$120.$ Then, the tax is $10%$ of this price:\n\n$$\n\\begin{aligned}10%\\times 120 & =\\frac{10}{100}\\times 120 \\\\  & =0.1\\times 120 \\\\  & =12\\end{aligned}\n$$\n\nTherefore, the tax on the ticket is $$12.$"} :step/id #uuid "350b7139-1fab-56d4-86bf-e150f9c15fcd"} {:db/id #edb/ref 17592186489340 :step/content {:db/id #edb/ref 17592186229609 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be31978a-e66c-5914-a793-35965a56b7fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "27" :db/id #edb/ref 17592186488856}] :answer-field/correct {:db/id #edb/ref 17592186488856} :answer-field/id #uuid "40d930ab-9b4f-5758-a9bc-0cebb8f98bdd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186227997}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "74e717f6-68d5-5182-b3f0-a00b3d34de61" :question/math-academy-id "q-326900" :question/problem "A store marked up the price of a jacket to $150%$ of its original cost. The tax on the jacket is $30%$ of its marked-up price.\nIf the jacket originally cost $$60,$ what is the tax on the jacket?\n\nThe tax on the jacket is $$$\n{{field-1}}." :question/requires-calculator true :question/worked-solution "First, the marked-up price is $150%$ of the original cost $($60):$\n\n$$\n\\begin{aligned}150%\\times 60 & =\\frac{150}{100}\\times 60 \\\\  & =1.5\\times 60 \\\\  & =90\\end{aligned}\n$$\n\nSo, the marked-up price of the jacket is $$90.$\nThen, the tax is $30%$ of this price:\n\n$$\n\\begin{aligned}30%\\times 90 & =\\frac{30}{100}\\times 90 \\\\  & =0.3\\times 90 \\\\  & =27\\end{aligned}\n$$\n\nTherefore, the tax on the jacket is $$27.$"} :step/id #uuid "9110eb6a-2e93-51c7-a5d3-f3d5f6f274b2" :step/next {:db/id #edb/ref 17592186489306}} {:db/id #edb/ref 17592186489360 :step/content {:db/id #edb/ref 17592186489225 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "260423ca-c450-564c-9729-9051afdbdb30" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "35%" :db/id #edb/ref 17592186488550} {:answer/id #uuid "4be72f5e-d8f1-550b-b61f-4fa75e6788eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30%" :db/id #edb/ref 17592186488617} {:answer/id #uuid "a33ca1d2-8570-5b69-8b96-022db448b553" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40%" :db/id #edb/ref 17592186488795} {:answer/id #uuid "e2fbfada-c622-57dd-ad25-59b2dadc7979" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50%" :db/id #edb/ref 17592186488943} {:answer/id #uuid "e81179df-8a40-5429-9632-3ec632cd68d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "60%" :db/id #edb/ref 17592186488956}] :answer-field/correct {:db/id #edb/ref 17592186488617} :answer-field/id #uuid "2eb59fef-3913-52e0-b381-93b8afe722d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489042}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "61eb5e2e-fcaa-52d1-ac70-97110690d4d7" :question/math-academy-id "q-326465" :question/problem "According to a recent report, $60%$ of tablet owners said they used their tablets regularly. Of those, $50%$ said they used them primarily for drawing. What percentage of all tablet owners used tablets primarily for drawing?" :question/worked-solution "Let $x$ be the total number of tablet owners.\n\nWe're told that $60%$ of tablet owners used their tablets regularly. Thus, the number of tablet owners who use them regularly is $0.6x.$\n\nWe are also told that of those owners, $50%$ used them for drawing. So, the number of tablet owners who used tablets primarily for drawing is\n\n$$\n0.50(0.6x)=0.30x.\n$$\n\nThe expression $0.30x$ represents $30%$ of $x.$ Therefore, $30%$ of all tablet owners used tablets primarily for drawing."} :step/id #uuid "c1786767-df2d-5dac-97ac-8e1b734195a6" :step/next {:db/id #edb/ref 17592186489340}} {:db/id #edb/ref 17592186489377 :step/content {:db/id #edb/ref 17592186489291 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e949d25-1381-5079-b809-094d27a97f04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30%" :db/id #edb/ref 17592186488687} {:answer/id #uuid "b199cd17-c18e-5be7-a027-a7f522f133b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "45%" :db/id #edb/ref 17592186488824} {:answer/id #uuid "c8f27be0-083f-5731-b1fd-e01f4f406ebf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20%" :db/id #edb/ref 17592186488881} {:answer/id #uuid "d6e51400-072c-5b9e-8e97-35b9e1b59817" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25%" :db/id #edb/ref 17592186488913} {:answer/id #uuid "e420f7a2-62fb-57ef-956f-b0875cfcffa9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15%" :db/id #edb/ref 17592186488946}] :answer-field/correct {:db/id #edb/ref 17592186488946} :answer-field/id #uuid "8c5934ba-d051-5992-8338-41334a774b4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489092}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f7253d28-4651-534c-8fab-305435de6a5d" :question/math-academy-id "q-326461" :question/problem "In an online study, $60%$ of participants reported enjoying painting. Of those, $25%$ said they preferred painting landscapes. What percentage of all participants preferred landscape painting?" :question/worked-solution "Let $x$ be the total number of participants.\n\nWe're told that $60%$ of participants enjoy painting. Thus, the number of participants who enjoy painting is $0.6x.$\n\nWe are also told that of those participants, $25%$ preferred landscapes. So, the number of participants who preferred landscape painting is\n\n$$\n0.25(0.6x)=0.15x.\n$$\n\nThe expression $0.15x$ represents $15%$ of $x.$ Therefore, $15%$ of all participants preferred landscape painting."} :step/id #uuid "e843ada6-b68d-519e-b765-5a7d5f01b61e" :step/next {:db/id #edb/ref 17592186489360}}] :activity/title "Applying Percentages in Succession" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186488463}]}
