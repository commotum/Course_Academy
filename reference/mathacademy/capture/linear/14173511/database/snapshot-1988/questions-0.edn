er/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186492312} {:answer/id #uuid "717705b3-caad-5403-8b66-1d5b0a17f3cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186492442} {:answer/id #uuid "ee5870dc-dd5b-50a4-90e8-1718c1670f75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186492679}] :answer-field/correct {:answer/id #uuid "1456279e-9c2b-5d5f-ab55-b4fefcc82c43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186492253} :answer-field/id #uuid "798a6175-8d3e-501b-8b46-cde42285f727" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492755}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "73bc99c1-88cb-54fb-b573-fbe1a7f6c64f" :question/math-academy-id "q-76743" :question/problem "![](images/4f/4f21734381e5e054ad560e5965afd459ea244dcab69e933a0d4df51055825b3f.png)\n\nSolve for $x$ in the figure above given that $\\overset{⟷}{PQ}$ is the perpendicular bisector of $\\overset{―}{MN}.$" :question/worked-solution "By the perpendicular bisector theorem, a point on the perpendicular bisector of a segment is equidistant from the endpoints of the segment. Hence, we have:\n\n$$\n\\begin{aligned}QM & =QN \\\\ 4x-2 & =3x+1 \\\\ 4x-3x & =1+2 \\\\ x & =3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492914 :knowledge-point/_questions [{:db/id #edb/ref 17592186073878 :knowledge-point/id #uuid "25e57b78-5159-51bc-aeaf-9530f641262b" :knowledge-point/title "Applying the Converse of the Perpendicular Bisector Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c6dc27d-fa04-5c94-993d-f56fe179225e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186492365} {:answer/id #uuid "5c02a76e-a4af-5ea7-bfdf-852f8d10031c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186492399} {:answer/id #uuid "967781f9-bc3f-5802-8e20-58d296887213" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186492508} {:answer/id #uuid "c0013178-2b99-5fb1-a785-2e6b327f44db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186492598} {:answer/id #uuid "f0745d7f-57d4-58e7-98ec-19f3f65df92a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186492683}] :answer-field/correct {:answer/id #uuid "5c02a76e-a4af-5ea7-bfdf-852f8d10031c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186492399} :answer-field/id #uuid "9b5cf645-b47f-5c52-831e-f24d44e305e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492764}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d96f4929-b558-5dc7-a6d9-bc9fa1be46fa" :question/math-academy-id "q-76792" :question/problem "![](images/b3/b365c6a6ae3ff9320465fe9a69e55b1737a7ffedf6cf6da6e91a5ed4ace3ba38.png)\n\nSolve for $x$ in the figure above given that $PR=QR$ and $\\overset{⟷}{RS}⊥\\overset{―}{PQ}.$" :question/worked-solution "By the converse of the perpendicular bisector theorem, a point equidistant from the endpoints of a segment lies on the perpendicular bisector of the segment. \n\nHere, the point $R$ is equidistant from the endpoints of $\\overset{―}{PQ}.$ Therefore, $\\overset{⟷}{SR}$ is the perpendicular bisector of $\\overset{―}{PQ}.$ \n\nIn particular, we have that $SP=SQ.$ We can use this equation so solve for $x:$\n\n$$\n\\begin{aligned}SP & =SQ \\\\ 8x-5 & =6x+1 \\\\ 2x & =6 \\\\ x & =3\\end{aligned}\n$$"}]}
