#{[{:db/id #edb/ref 17592186073584 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073876 :knowledge-point/id #uuid "5fbb6558-01d5-5d08-8e84-64077353b2a6" :knowledge-point/title "Identifying Properties of Perpendicular Bisectors"}] :question/id #uuid "d49eb5a2-baaf-527f-bfa7-12b2befa865a" :question/math-academy-id "e-2609" :question/problem "Which of the following diagrams represents a perpendicular bisector of $\\overline{AB}?$\n\n![](images/90/90e49cf78c7fb86b6f5a8c33b3e5bd28279248f791757a2351ddb86296d79d72.png)" :question/worked-solution "A perpendicular bisector of $\\overline{AB}$:\n\n- must split $\\overline{AB}$ in half, and\n\n- must be perpendicular to $\\overline{AB}$.\n\nAmong the given options, only diagram IV shows a perpendicular bisector to the line segment $\\overline{AB}.$ \n\nNotice that in diagrams I, II and III we have bisectors but they are not perpendicular to $\\overline{AB}.$"}] [{:db/id #edb/ref 17592186073585 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073877 :knowledge-point/id #uuid "5cda2e87-1a65-5075-96fd-98a8a4fd7d7a" :knowledge-point/title "Applying the Perpendicular Bisector Theorem"}] :question/id #uuid "01b53ce1-80d9-530a-bfba-cfd500b37f9d" :question/math-academy-id "e-2610" :question/problem "Solve for $x$ in the figure below given that $\\overset{\\longleftrightarrow}{CD}$ is the perpendicular bisector of $\\overline{AB}.$ \n\n![](images/2d/2dea948c7ab1cf3bb7f543c651d98f23cda8531bbec8cc44e12736c3f04f04c3.png)" :question/worked-solution "By the perpendicular bisector theorem, a point on the perpendicular bisector of a segment is equidistant from the endpoints of the segment. Hence, we have:\n\n$$\n\\begin{aligned}DA & =DB \\\\ x+5 & =2x \\\\ x & =5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186073586 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073878 :knowledge-point/id #uuid "25e57b78-5159-51bc-aeaf-9530f641262b" :knowledge-point/title "Applying the Converse of the Perpendicular Bisector Theorem"}] :question/id #uuid "ab4fe8cf-3651-5a1f-a796-546892cb0178" :question/math-academy-id "e-2613" :question/problem "Solve for $x$ in the figure below given that $AD=BD$ and $AE=BE.$ \n\n![](images/e5/e58ea5aadf9075a8b1d7a3de3a3c82e88eb3b47281cf75134631d3a153d42127.png)" :question/worked-solution "By the converse of the perpendicular bisector theorem, a point equidistant from the endpoints of a segment lies on the perpendicular bisector of the segment. \n\nHere, the points $D$ and $E$ are both equidistant from the endpoints of $\\overline{AB}.$ Therefore, $D$ and $E$ both  lie on the perpendicular bisector of $\\overline{AB}.$ \n\nSince only one line can be drawn through two given points, the line $\\overset{\\longleftrightarrow}{DE}$ is the perpendicular bisector of $\\overline{AB}.$ \n\nIn particular, we have that $AC=BC.$ We can use this equation to solve for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}AC & =BC \\\\ 3x+2 & =5x-2 \\\\ 4 & =2x \\\\ x & =2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492876 :knowledge-point/_questions [{:db/id #edb/ref 17592186073876 :knowledge-point/id #uuid "5fbb6558-01d5-5d08-8e84-64077353b2a6" :knowledge-point/title "Identifying Properties of Perpendicular Bisectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e9a3c0c-1c22-581f-a5d0-2802e1725eea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186492405} {:answer/id #uuid "5f06b478-300b-5908-b205-8b53f9d45e8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III only" :db/id #edb/ref 17592186492406} {:answer/id #uuid "7c1ff45a-2a38-5e29-8e42-6d21fb85bdf1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186492468} {:answer/id #uuid "bb82fdec-5b82-55d0-a7bc-7e2e65a99613" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III and IV only" :db/id #edb/ref 17592186492593} {:answer/id #uuid "dc058b12-9830-5d1e-b0f2-95938104b5ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186492648}] :answer-field/correct {:answer/id #uuid "5f06b478-300b-5908-b205-8b53f9d45e8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III only" :db/id #edb/ref 17592186492406} :answer-field/id #uuid "043cc00a-589a-5a28-89dc-4596ac67231d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492708}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "74744733-4a48-54d6-9cdb-1913c4d1cafb" :question/math-academy-id "q-118626" :question/problem "![](images/24/2498eda00226200b2168cd63002fcd81a19527e562c666e98f5a36b8a2c4caae.png)\n\nWhich of the diagrams above represents a bisector (perpendicular or not perpendicular) of $\\overset{―}{CD}?$" :question/worked-solution "A bisector of $\\overset{―}{CD}$:\n\n- must split $\\overset{―}{CD}$ in half.\n\nAmong the given options, only diagrams I, II, and III show a bisector to the line segment $\\overset{―}{CD}.$ \n\nNotice that in diagram IV the intersection of the two segments does not split $\\overset{―}{CD}$ in half."}] [{:db/id #edb/ref 17592186492822 :knowledge-point/_questions [{:db/id #edb/ref 17592186073878 :knowledge-point/id #uuid "25e57b78-5159-51bc-aeaf-9530f641262b" :knowledge-point/title "Applying the Converse of the Perpendicular Bisector Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14e399eb-c610-5a70-9be3-c5cf8318d749" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186492255} {:answer/id #uuid "2abeecee-defe-5aba-af93-f4e6edf7e994" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186492305} {:answer/id #uuid "2e8c691c-01ff-5adf-a9c8-3026fd1cc52f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186492315} {:answer/id #uuid "51556f70-c451-5644-835a-916d2319bd5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186492372} {:answer/id #uuid "b140c6dc-b0fd-525e-9a4c-62a9f172f1fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186492571}] :answer-field/correct {:answer/id #uuid "2abeecee-defe-5aba-af93-f4e6edf7e994" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186492305} :answer-field/id #uuid "5a1390cb-9886-5394-a1ec-5669e8ce8b76" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492739}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0505a08a-9b50-54e3-aef5-883b15a54631" :question/math-academy-id "q-52981" :question/problem "![](images/4e/4e730cb70a510440f8430533e771d3ae9c26cffef886804b702bc93aa809b27b.png)\n\nSolve for $x$ in the figure above given that $PR=QR$ and $\\overset{⟷}{RS}⊥\\overset{―}{PQ}.$" :question/worked-solution "By the converse of the perpendicular bisector theorem, a point equidistant from the endpoints of a segment lies on the perpendicular bisector of the segment. \n\nHere, the point $R$ is equidistant from the endpoints of $\\overset{―}{PQ}.$ Therefore, $\\overset{⟷}{SR}$ is the perpendicular bisector of $\\overset{―}{PQ}.$ \n\nIn particular, we have that $SP=SQ.$ We can use this equation so solve for $x:$\n\n$$\n\\begin{aligned}SP & =SQ \\\\ 2x+5 & =6x-3 \\\\ 8 & =4x \\\\ x & =2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492853 :knowledge-point/_questions [{:db/id #edb/ref 17592186073876 :knowledge-point/id #uuid "5fbb6558-01d5-5d08-8e84-64077353b2a6" :knowledge-point/title "Identifying Properties of Perpendicular Bisectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27fd5638-4f51-5e3c-a384-36d4371da7ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186492298} {:answer/id #uuid "3822e7ac-d037-5f81-979a-e8b10abbb077" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III" :db/id #edb/ref 17592186492337} {:answer/id #uuid "e73c0e23-5f37-5aac-9566-005f35482199" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV only" :db/id #edb/ref 17592186492665} {:answer/id #uuid "eb7c23b7-4f8a-5a23-bc6e-998c67325d71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186492673} {:answer/id #uuid "f6e264ff-c2c2-53af-85e9-f0c8bbeb24df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186492692}] :answer-field/correct {:answer/id #uuid "f6e264ff-c2c2-53af-85e9-f0c8bbeb24df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186492692} :answer-field/id #uuid "35c4bc8c-2993-5baa-8f3b-3d3d52b82da8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492727}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4149fc67-1e41-5028-8a46-16f732885a43" :question/math-academy-id "q-53044" :question/problem "![](images/cd/cd7bf8806014c80bbe0341c6f3091584cd04c6fc846fb0534119f6ccdf32b102.png)\n\nWhich of the diagrams above represents a bisector (perpendicular or not perpendicular) of $\\overset{―}{KL}?$" :question/worked-solution "A bisector of $\\overset{―}{KL}$:\n\n- must split $\\overset{―}{KL}$ in half.\n\nAmong the given options, only diagrams II and IV show a bisector to the line segment $\\overset{―}{KL}.$ \n\nNotice that in diagrams I and III the intersection of the two segments does not split $\\overset{―}{KL}$ in half."}] [{:db/id #edb/ref 17592186492846 :knowledge-point/_questions [{:db/id #edb/ref 17592186073878 :knowledge-point/id #uuid "25e57b78-5159-51bc-aeaf-9530f641262b" :knowledge-point/title "Applying the Converse of the Perpendicular Bisector Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12c8a65e-a963-526f-8695-e1d98de36624" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186492251} {:answer/id #uuid "15968d7e-2f5a-5796-a92d-eab48c29c4d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186492257} {:answer/id #uuid "3a093d82-aec6-51b8-919d-9c3fb850f1cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186492340} {:answer/id #uuid "5d0c2cf8-b521-5f0e-a3a9-e7f20602123c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186492402} {:answer/id #uuid "8eb599f7-5f9a-59f1-af2b-ac437bac25af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186492498}] :answer-field/correct {:answer/id #uuid "3a093d82-aec6-51b8-919d-9c3fb850f1cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186492340} :answer-field/id #uuid "275786d1-e16f-57d5-90f0-1ca2711b1c9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492719}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "30d08ba8-2476-53e5-a489-f0d0e93d5c87" :question/math-academy-id "q-67780" :question/problem "![](images/4b/4b89ec998b55eacb8e5de3bf0c22aa94d351232f38459c17640956f96e939bac.png)\n\nSolve for $x$ in the figure above given that $KN=LN$ and $KP=LP.$" :question/worked-solution "By the converse of the perpendicular bisector theorem, a point equidistant from the endpoints of a segment lies on the perpendicular bisector of the segment. \n\nHere, the points $P$ and $N$ are both equidistant from the endpoints of $\\overset{―}{KL}.$ Therefore, $P$ and $N$ both  lie on the perpendicular bisector of $\\overset{―}{KL}.$ \n\nSince only one line can be drawn through two given points, the line $\\overset{⟷}{PN}$ is the perpendicular bisector of $\\overset{―}{KL}.$ \n\nIn particular, we have that $KM=LM.$ We can use this equation to solve for $x:$\n\n$$\n\\begin{aligned}KM & =LM \\\\ 8x-6 & =7x+1 \\\\ x & =7\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492859 :knowledge-point/_questions [{:db/id #edb/ref 17592186073877 :knowledge-point/id #uuid "5cda2e87-1a65-5075-96fd-98a8a4fd7d7a" :knowledge-point/title "Applying the Perpendicular Bisector Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "587a11f5-91b9-543b-83df-104503724d1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186492386} {:answer/id #uuid "7149e5d7-63fb-5090-8255-995e4851d1f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186492441} {:answer/id #uuid "9043eb09-5c98-5a0d-a89a-90e1157451d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186492501} {:answer/id #uuid "a19659cb-9c4f-544c-a689-421353fd8547" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17