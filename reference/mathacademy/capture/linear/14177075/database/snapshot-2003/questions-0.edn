ion/id #uuid "151ea9a2-7fca-5107-a3ac-b15fd8b562e9" :question/math-academy-id "q-68461" :question/problem "${(\\frac{1}{2})}^{3}=$" :question/worked-solution "To raise the fraction to the power of $3$, we must raise both the numerator and the denominator to the power of $3:$\n\n$$\n{(\\frac{1}{2})}^{3}=\\frac{{1}^{3}}{{2}^{3}}\n$$\n\nNow, using, ${1}^{3}=1$ and ${2}^{3}=8,$ we get\n\n$$\n\\frac{{1}^{3}}{{2}^{3}}=\\frac{1}{8}.\n$$"}] [{:db/id #edb/ref 17592186106473 :knowledge-point/_questions [{:db/id #edb/ref 17592186105744 :knowledge-point/id #uuid "46cd136a-cc20-51e1-ac90-f8d9b787c5b3" :knowledge-point/title "Evaluating Powers of Negative Fractions Using the Power of Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f287d7b-8e45-585a-98fa-28040508099a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186104987} {:answer/id #uuid "ce55da7f-50bc-50e1-97d4-2fb77506d6e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{49}" :db/id #edb/ref 17592186104988} {:answer/id #uuid "f9e6c57d-980f-5bf5-abe5-039788ff6f9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{14}" :db/id #edb/ref 17592186104989} {:answer/id #uuid "3a096c69-a948-55c4-b1f3-408814661ef8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{7}" :db/id #edb/ref 17592186104990} {:answer/id #uuid "4f053517-545a-56dd-a930-55fa0e6815e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{49}" :db/id #edb/ref 17592186104991}] :answer-field/correct {:answer/id #uuid "ce55da7f-50bc-50e1-97d4-2fb77506d6e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{49}" :db/id #edb/ref 17592186104988} :answer-field/id #uuid "b9230a8b-5c46-59a1-bb96-933a3909004f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186104986}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e207c000-8554-5f94-b1da-034972cbe6db" :question/math-academy-id "q-68467" :question/problem "${(-\\frac{1}{7})}^{2}=$" :question/worked-solution "First, notice that $-\\frac{1}{7}=\\frac{(-1)}{7}.$\n\nTo raise the fraction to the power of $2$, we must raise both the numerator and the denominator to the power of $2:$\n\n$$\n{(-\\frac{1}{7})}^{2}={(\\frac{(-1)}{7})}^{2}=\\frac{(-1)^{2}}{{7}^{2}}\n$$\n\nNow, using $(-1)^{2}=1$ and ${7}^{2}=49,$ we get\n\n$$\n\\frac{(-1)^{2}}{{7}^{2}}=\\frac{1}{49}.\n$$"}]}
