4}^{2}} & = \\\\ -5-4 & = \\\\ -9\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492014 :knowledge-point/_questions [{:db/id #edb/ref 17592186078451 :knowledge-point/id #uuid "e8ac5e9b-5b61-5b1c-b25c-cb46d1d68154" :knowledge-point/title "Evaluating Expressions Containing Radicals and Multiple Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bf2b462-2502-592a-b0ce-07bd8bf7b790" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-22" :db/id #edb/ref 17592186491511} {:answer/id #uuid "44ce22a6-0172-53a7-b33b-5c382ed5ecf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186491585} {:answer/id #uuid "b6e64d39-c835-59ae-a49d-efc231137210" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186491769} {:answer/id #uuid "e36757c9-fa2f-5360-aa90-a67c5ef3c9ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186491842} {:answer/id #uuid "edde2d09-ca70-53d3-8e63-3242c380bf5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186491863}] :answer-field/correct {:answer/id #uuid "edde2d09-ca70-53d3-8e63-3242c380bf5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186491863} :answer-field/id #uuid "1116abcc-56e2-5d6f-a608-53f2c148f2a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491894}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "50acaf8f-e65d-537d-be92-5374b0715e0a" :question/math-academy-id "q-99407" :question/problem "Find the value of  $(\\sqrt{36}+16)÷(-7-4).$" :question/worked-solution "To evaluate the given expression, we use PEMDAS. In terms of the order of operations: \n\n- expressions underneath radicals are treated the same as parentheses\n\n- radicals themselves are treated as exponents\n\nTherefore, following the order of operations, we obtain:\n\n$$\n\\begin{aligned}(\\sqrt{36}+16)÷(-7-4) & = \\\\ (\\sqrt{36}+16)÷(-11) & = \\\\ (\\sqrt{6\\cdot 6}+16)÷(-11) & = \\\\ (\\sqrt{{6}^{2}}+16)÷(-11) & = \\\\ (6+16)÷(-11) & = \\\\ 22÷(-11) & = \\\\ -2\\end{aligned}\n$$"}]}
