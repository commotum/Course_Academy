#{[{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186084135} :activity/id #uuid "93504fb3-0cac-5a79-88f9-a68a78187dd4" :activity/scope {:db/id #edb/ref 17592186050551 :topic/id #uuid "52c5223b-6fe6-5437-ac08-e4f0cd89565a" :topic/math-academy-id 727} :activity/steps [{:db/id #edb/ref 17592186084135 :step/content {:db/id #edb/ref 17592186084455 :tutorial/content "We have learned how to solve quadratic equations by factoring. Just like quadratic equations, some (but not all) cubic equations can also be solved by factoring.\n\nTo solve a cubic equation by factoring, we just need to follow three steps:\n\n1\\. Write the equation with $0$ on one side\n\n2\\. Factor the expression on the other side\n\n3\\. Set each factor equal to $0$ and solve\n\nTo factor the cubic, we can often use the method of grouping.\n\n**Note:** The cubic equations in the following examples can all be factored, but keep in mind that most cubic equations cannot be!" :tutorial/id #uuid "3c5846e9-07ca-5d29-824a-9bb84c33473a" :tutorial/math-academy-id 3710 :tutorial/title "Introduction"} :step/id #uuid "007ccdec-9f76-50fb-9833-3a3f6ac946e8" :step/math-academy-id 20914 :step/next {:db/id #edb/ref 17592186084194}} {:db/id #edb/ref 17592186084156 :step/content {:db/id #edb/ref 17592186083246 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083042 :question/id #uuid "edbd084f-e8ad-53e7-9384-94094a6e7bc6" :question/math-academy-id "e-5879"} :knowledge-point/id #uuid "385b1ccd-ea68-5c59-a0e6-1a0bb7937460" :knowledge-point/questions [{:db/id #edb/ref 17592186083532} {:db/id #edb/ref 17592186083533} {:db/id #edb/ref 17592186233448} {:db/id #edb/ref 17592186233450} {:db/id #edb/ref 17592186520493} {:db/id #edb/ref 17592186558504}] :knowledge-point/title "Solving Cubic Equations With Leading Coefficients by Grouping"} :step/id #uuid "1f4ae760-dcdb-5fe7-ad58-6d57db23484b" :step/math-academy-id 21147 :step/next {:db/id #edb/ref 17592186084195}} {:db/id #edb/ref 17592186084157 :step/content {:db/id #edb/ref 17592186083247 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083043 :question/id #uuid "90296377-6785-5b6d-87ca-8a88d4b266c9" :question/math-academy-id "e-5880"} :knowledge-point/id #uuid "c6158975-c81e-5621-aa39-3f2dc728f107" :knowledge-point/questions [{:db/id #edb/ref 17592186083679} {:db/id #edb/ref 17592186083839} {:db/id #edb/ref 17592186233212} {:db/id #edb/ref 17592186233447} {:db/id #edb/ref 17592186520461} {:db/id #edb/ref 17592186520512} {:db/id #edb/ref 17592186520517}] :knowledge-point/title "Solving Cubic Equations by Manipulating the Equation and Then Grouping"} :step/id #uuid "861a14bd-f811-5d0f-9526-25d3255713aa" :step/math-academy-id 21148} {:db/id #edb/ref 17592186084194 :step/content {:db/id #edb/ref 17592186083274 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083067 :question/id #uuid "1c104a42-2eea-5029-8ada-7d3bb90add52" :question/math-academy-id "e-6110"} :knowledge-point/id #uuid "b7b17a61-b225-5493-98b0-58d15217aa31" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048272} {:db/id #edb/ref 17592186050364}] :knowledge-point/questions [{:db/id #edb/ref 17592186083923} {:db/id #edb/ref 17592186083924} {:db/id #edb/ref 17592186233207} {:db/id #edb/ref 17592186233445} {:db/id #edb/ref 17592186520454} {:db/id #edb/ref 17592186520459} {:db/id #edb/ref 17592186520507} {:db/id #edb/ref 17592186520515}] :knowledge-point/title "Solving Cubic Equations by Grouping"} :step/id #uuid "e204d6ad-cb74-5fc7-9972-8f92949eac92" :step/math-academy-id 22687 :step/next {:db/id #edb/ref 17592186084156}} {:db/id #edb/ref 17592186084195 :step/content {:db/id #edb/ref 17592186083275 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083068 :question/id #uuid "9d7a8d1c-449e-5e58-971f-7a063d52a703" :question/math-academy-id "e-6111"} :knowledge-point/id #uuid "01d58dfd-315a-5a4f-ae16-1db04010169a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048187}] :knowledge-point/questions [{:db/id #edb/ref 17592186083678} {:db/id #edb/ref 17592186083925} {:db/id #edb/ref 17592186233208} {:db/id #edb/ref 17592186233210} {:db/id #edb/ref 17592186520494} {:db/id #edb/ref 17592186558546}] :knowledge-point/title "Solving Cubic Equations With Negative Leading Coefficients by Grouping"} :step/id #uuid "b6b1d8f8-0fd1-5345-a6b4-292a289f9568" :step/math-academy-id 22689 :step/next {:db/id #edb/ref 17592186084157}}] :activity/title "Solving Cubic Equations by Grouping" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083422}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186558596} :activity/id #uuid "2764fc8a-72a0-53dd-b9f3-a894d5e98408" :activity/scope {:db/id #edb/ref 17592186050551 :topic/id #uuid "52c5223b-6fe6-5437-ac08-e4f0cd89565a" :topic/math-academy-id 727} :activity/steps [{:db/id #edb/ref 17592186558587 :step/content {:db/id #edb/ref 17592186558546 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1158a179-4af2-57c0-b482-1b618b682555" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2,\\,\\pm 3" :db/id #edb/ref 17592186557902} {:answer/id #uuid "11ab1234-f864-588c-a250-034b00261075" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\sqrt{2},\\,\\sqrt{3}" :db/id #edb/ref 17592186557904} {:answer/id #uuid "6d45e655-7700-5ee3-8c5a-ec66765eebe8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=3,\\,\\pm \\sqrt{2}" :db/id #edb/ref 17592186558080} {:answer/id #uuid "96d81797-9816-5915-9fed-357eee6ed9ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2,\\,3" :db/id #edb/ref 17592186558159} {:answer/id #uuid "a44cb772-a5d5-5548-a04a-c2f728e6f3bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\sqrt{2},\\,3" :db/id #edb/ref 17592186558193}] :answer-field/correct {:db/id #edb/ref 17592186558080} :answer-field/id #uuid "543735e3-a26c-5ffd-9ec2-86ffb989af36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558398}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a043cae8-5322-50e0-9c25-76e939ce12b0" :question/math-academy-id "q-72032" :question/problem "Solve $-{y}^{3}+3{y}^{2}+2y-6=0.$" :question/worked-solution "First, we multiply the equation by $-1$ to make the coefficient of the cubic term positive. This gives\n\n$$\n{y}^{3}-3{y}^{2}-2y+6=0.\n$$\n\nWe then proceed to factor the left-hand side by grouping:\n\n$$\n\\begin{aligned}{y}^{3}-3{y}^{2}-2y+6 & = \\\\ ({y}^{3}-3{y}^{2})+(-2y+6) & = \\\\ {y}^{2}(y-3)-2(y-3) & = \\\\ ({y}^{2}-2)(y-3) & \\end{aligned}\n$$\n\nThen, we solve $({y}^{2}-2)(y-3)=0$ by setting each factor equal to $0.$\n\n- Setting the factor $({y}^{2}-2)$ equal to $0,$ we get $y=\\pm \\sqrt{2}.$\n\n- Setting the factor $(y-3)$ equal to $0,$ we get $y=3.$\n\nTherefore, the solutions are $y=3,\\,\\pm \\sqrt{2}.$"} :step/id #uuid "1131a607-3df0-551a-af5d-22ed70d6d1d5"} {:db/id #edb/ref 17592186558596 :step/content {:db/id #edb/ref 17592186558504 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8934827e-e1a4-57aa-b9c6-f41a1c0f56fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "b=-\\frac{2}{5}" :db/id #edb/ref 17592186558138} {:answer/id #uuid "9ccdfcfa-5451-5de0-b346-ec9c16f0e00e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "b=-\\frac{12}{5}" :db/id #edb/ref 17592186558176} {:answer/id #uuid "aaca70d2-4202-5062-ab16-0babf7140c48" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "b=\\pm \\sqrt{\\frac{12}{5}}" :db/id #edb/ref 17592186558205} {:answer/id #uuid "f26e943a-7ae3-5e4c-8e3a-b37f9af30ceb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "b=\\pm 2" :db/id #edb/ref 17592186558344} {:answer/id #uuid "f6db3fe8-7692-5d66-b32a-4fca3ee9ca87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "b=\\frac{12}{5},\\,\\pm \\sqrt{2}" :db/id #edb/ref 17592186558351}] :answer-field/correct {:db/id #edb/ref 17592186558176} :answer-field/id #uuid "81b1231e-91d3-5a68-9071-c04003144caf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558424}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "36a20ff4-bc02-5ebc-9459-ae85a99d7c37" :question/math-academy-id "q-14116" :question/problem "Find all the real solutions to the equation $5{b}^{3}+12{b}^{2}+20b+48=0.$" :question/worked-solution "We proceed to factor the left-hand side by grouping:\n\n$$\n\\begin{aligned}5{b}^{3}+12{b}^{2}+20b+48 & = \\\\ (5{b}^{3}+12{b}^{2})+(20b+48) & = \\\\ {b}^{2}(5b+12)+4(5b+12) & = \\\\ (5b+12)\\cdot {b}^{2}+(5b+12)\\cdot 4 & = \\\\ (5b+12)({b}^{2}+4) & .\\end{aligned}\n$$\n\nThen, we solve $(5b+12)({b}^{2}+4)=0$ by setting each factor equal to $0.$\n\n- Setting the factor $(5b+12)$ equal to $0,$ we get\n\n$$\n\\begin{aligned}5b+12 & =0 \\\\ 5b & =-12 \\\\ b & =-\\frac{12}{5}.\\end{aligned}\n$$\n\n- Setting the factor $({b}^{2}+4)$ equal to $0,$ we get\n\n$$\n\\begin{aligned}{b}^{2}+4 & =0 \\\\ {b}^{2} & =-4.\\end{aligned}\n$$\n\nSince a squared real number cannot be negative, the equation ${b}^{2}+4=0$ has no real solutions.\n\nTherefore,  $b=-\\frac{12}{5}$ is the only real solution."} :step/id #uuid "212195c8-25d2-5c20-aa10-fc18d70b1afb" :step/next {:db/id #edb/ref 17592186558639}} {:db/id #edb/ref 17592186558639 :step/content {:db/id #edb/ref 17592186083533 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c6dad2e-76cd-5eb2-9262-987f295943fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=\\frac{1}{2}" :db/id #edb/ref 17592186558143} {:answer/id #uuid "930004be-d1b4-5e3b-893e-3a1546cc1415" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=\\frac{1}{8}" :db/id #edb/ref 17592186558154} {:answer/id #uuid "99ad43d7-bf48-53af-850a-7eaa1d489b83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=\\pm \\sqrt{\\frac{1}{8}}" :db/id #edb/ref 17592186558165} {:answer/id #uuid "c3c85e04-d71d-5e43-9091-e3ca1a560f38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=\\frac{1}{8},\\,\\pm \\sqrt{\\frac{1}{2}}" :db/id #edb/ref 17592186558257} {:answer/id #uuid "c9f37bc2-6b85-584e-b346-e0758e8750b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=\\pm 5" :db/id #edb/ref 17592186558269}] :answer-field/correct {:db/id #edb/ref 17592186558154} :answer-field/id #uuid "8b3e842a-4fdb-5845-8863-61498b5df415" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186080093}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d519077a-270e-582c-9f30-154ca1bb3d9c" :question/math-academy-id "q-14120" :question/problem "Find all of the real solutions to the equation $8{z}^{3}-{z}^{2}+40z-5=0.$" :question/worked-solution "We proceed to factor the left-hand side by grouping:\n\n$$\n\\begin{aligned}8{z}^{3}-{z}^{2}+40z-5 & = \\\\ (8{z}^{3}-{z}^{2})+(40z-5) & = \\\\ {z}^{2}(8z-1)+5(8z-1) & = \\\\ (8z-1)\\cdot {z}^{2}+(8z-1)\\cdot 5 & = \\\\ (8z-1)({z}^{2}+5) & .\\end{aligned}\n$$\n\nThen, we solve $(8z-1)({z}^{2}+5)=0$ by setting each factor equal to $0.$\n\n- Setting the factor $(8z-1)$ equal to $0,$ we get\n\n$$\n\\begin{aligned}8z-1 & =0 \\\\ 8z & =1 \\\\ z & =\\frac{1}{8}.\\end{aligned}\n$$\n\n- Setting the factor $({z}^{2}+5)$ equal to $0,$ we get\n\n$$\n\\begin{aligned}{z}^{2}+5 & =0 \\\\ {z}^{2} & =-5.\\end{aligned}\n$$\n\nSince a squared real number cannot be negative, the equation ${z}^{2}+5=0$ has no real solutions.\n\nTherefore,  $z=\\frac{1}{8}$ is the only real solution."} :step/id #uuid "6f96ecf4-3072-516f-87f5-42a49bd9bdea" :step/next {:db/id #edb/ref 17592186558587}}] :activity/title "Solving Cubic Equations by Grouping" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186557855}]}
