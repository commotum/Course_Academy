b3c-9c37ec913b8b" :answer/type :answer.type/math :answer/value "0.1" :db/ensure [:answer/validate]} {:db/id "answer-e43dbf8d-b450-5420-805c-1d3e1191e288" :answer/id #uuid "e43dbf8d-b450-5420-805c-1d3e1191e288" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-4deb678c-8d2a-5d5f-ba4b-9d6c6e6d7862" :answer/id #uuid "4deb678c-8d2a-5d5f-ba4b-9d6c6e6d7862" :answer/type :answer.type/math :answer/value "100" :db/ensure [:answer/validate]} {:db/id "answer-8b889040-94af-5f4e-b8d8-cee6bf87f054" :answer/id #uuid "8b889040-94af-5f4e-b8d8-cee6bf87f054" :answer/type :answer.type/math :answer/value "1000" :db/ensure [:answer/validate]} {:db/id "question-c3a0e9ee-2041-5135-bc63-3a864333d5da" :question/id #uuid "c3a0e9ee-2041-5135-bc63-3a864333d5da" :question/math-academy-id "q-213090" :question/problem "Let $a$ be a positive integer. Construct an expression that gives the last digit of $15a.$" :question/worked-solution "Let $b=15a.$ Note that $b$ is positive. Now, let ${d}_{3},$ ${d}_{2},$ and ${d}_{1}$ be the last three digits of the number $b:$ \n\n$$\nb=…{d}_{3}{d}_{2}{d}_{1}\n$$\n\nThen, $b$ can be written in expanded form as follows:\n\n$$\n\\begin{aligned}b & =⋯+100{d}_{3}+10{d}_{2}+{d}_{1} \\\\  & =10(⋯+10{d}_{3}+{d}_{2})+{d}_{1}\\end{aligned}\n$$\n\nNow, we compute the residue of $b$ modulo $10:$\n\n$$\n\\begin{aligned}b & ≡10(⋯+10{d}_{3}+{d}_{2})+{d}_{1} &  & (\\text{mod}\\,10) \\\\  & ≡0\\cdot (⋯+10{d}_{3}+{d}_{2})+{d}_{1} &  & (\\text{mod}\\,10) \\\\  & ≡0+{d}_{1} &  & (\\text{mod}\\,10) \\\\  & ≡{d}_{1} &  & (\\text{mod}\\,10)\\end{aligned}\n$$\n\nNotice that ${d}_{1}$ is the last digit of $b.$\n\nFinally, since $b=15a,$ and \n\n$$\n15≡5\\,(\\text{mod}\\,10)\n$$\n\nwe have the following:\n\n$$\n\\begin{aligned}b & ≡{d}_{1} &  & (\\text{mod}\\,10) \\\\ 15a & ≡{d}_{1} &  & (\\text{mod}\\,10) \\\\ 5a & ≡{d}_{1} &  & (\\text{mod}\\,10)\\end{aligned}\n$$\n\nTherefore, the expression that gives the last digit of $15a$ is the following:\n\n$$\n5a\\,\\text{mod}\\,10\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1829be2b-0030-55a2-ac4d-e2351dae6d32" "answer-field-65b70d57-571d-532e-81a3-2903f2154156" "answer-field-89cbf282-a058-5488-ac8a-11acbd299bf1"] :db/ensure [:question/validate]} {:db/id "answer-field-1829be2b-0030-55a2-ac4d-e2351dae6d32" :answer-field/id #uuid "1829be2b-0030-55a2-ac4d-e2351dae6d32" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-bfc79298-8b18-5c41-ab31-d5b786527dc5" :answer-field/choices ["answer-bfc79298-8b18-5c41-ab31-d5b786527dc5" "answer-cbf57528-f936-530c-ae91-0ae767897668" "answer-a1b6f99d-95c5-5d1d-a379-204d9be49203" "answer-3f7a2e7d-a7f7-51a9-b5d1-e6a08a235d60"] :db/ensure [:answer-field/validate]} {:db/id "answer-bfc79298-8b18-5c41-ab31-d5b786527dc5" :answer/id #uuid "bfc79298-8b18-5c41-ab31-d5b786527dc5" :answer/type :answer.type/math :answer/value "5a" :db/ensure [:answer/validate]} {:db/id "answer-cbf57528-f936-530c-ae91-0ae767897668" :answer/id #uuid "cbf57528-f936-530c-ae91-0ae767897668" :answer/type :answer.type/math :answer/value "5a+1" :db/ensure [:answer/validate]} {:db/id "answer-a1b6f99d-95c5-5d1d-a379-204d9be49203" :answer/id #uuid "a1b6f99d-95c5-5d1d-a379-204d9be49203" :answer/type :answer.type/math :answer/value "a" :db/ensure [:answer/validate]} {:db/id "answer-3f7a2e7d-a7f7-51a9-b5d1-e6a08a235d60" :answer/id #uuid "3f7a2e7d-a7f7-51a9-b5d1-e6a08a235d60" :answer/type :answer.type/math :answer/value "a+5" :db/ensure [:answer/validate]} {:db/id "answer-field-65b70d57-571d-532e-81a3-2903f2154156" :answer-field/id #uuid "65b70d57-571d-532e-81a3-2903f2154156" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-3e435929-e6f5-5c22-a0c6-a1cc0a33abed" :answer-field/choices ["answer-1915435a-1ef7-53cf-b21e-3e4a383dab4a" "answer-080ba340-0c2e-55b9-adbc-0e8561a2fd34" "answer-3e435929-e6f5-5c22-a0c6-a1cc0a33a