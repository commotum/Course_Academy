81c5-ab7efd6c4dcc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-429fdcde-3b6d-5c73-8dc3-bcbc021fbd80" :answer-field/choices ["answer-429fdcde-3b6d-5c73-8dc3-bcbc021fbd80" "answer-c3e4fe4d-4c92-521c-83e6-c0e90c02531e" "answer-d8b32333-3d63-5c1d-8463-d060ccddc6d4" "answer-75eb0c8b-4787-5d81-adff-461746539962" "answer-4c321879-5e75-577b-971a-ad0d16a20d10"] :db/ensure [:answer-field/validate]} {:db/id "answer-429fdcde-3b6d-5c73-8dc3-bcbc021fbd80" :answer/id #uuid "429fdcde-3b6d-5c73-8dc3-bcbc021fbd80" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-c3e4fe4d-4c92-521c-83e6-c0e90c02531e" :answer/id #uuid "c3e4fe4d-4c92-521c-83e6-c0e90c02531e" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-d8b32333-3d63-5c1d-8463-d060ccddc6d4" :answer/id #uuid "d8b32333-3d63-5c1d-8463-d060ccddc6d4" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-75eb0c8b-4787-5d81-adff-461746539962" :answer/id #uuid "75eb0c8b-4787-5d81-adff-461746539962" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-4c321879-5e75-577b-971a-ad0d16a20d10" :answer/id #uuid "4c321879-5e75-577b-971a-ad0d16a20d10" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-ab21706d-8653-5637-8475-77432c4bfb1b" :question/id #uuid "ab21706d-8653-5637-8475-77432c4bfb1b" :question/math-academy-id "q-76947" :question/problem "$52\\text{ mod }5=$" :question/worked-solution "The residue of $52$ modulo $5$ is the integer $0\\le r<5$ such that\n\n$$\n52≡r\\,(\\text{mod}\\,5).\n$$\n\n**Method 1**\n\nTo find the residue $r,$ we need to write $52$ as an integer multiple of $5,$ plus the residue $r.$\n\nWe note that $52≡2\\,(\\text{mod}\\,5)$ because\n\n$$\n52=10\\cdot 5+2.\n$$\n\nTherefore, the residue of $52$ modulo $5$ is $2.$\n\n**Method 2**\n\nWe can use the subtraction property:\n\n$$\n\\begin{aligned}52 & ≡52-0 &  & (\\text{mod}\\,5) \\\\  & ≡52-10\\cdot 5 &  & (\\text{mod}\\,5) \\\\  & ≡52-50 &  & (\\text{mod}\\,5) \\\\  & ≡2 &  & (\\text{mod}\\,5)\\end{aligned}\n$$\n\nTherefore, the residue of $52$ modulo $5$ is $2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-73027cc0-3004-56e5-8a8a-41f0c59a4f77"] :db/ensure [:question/validate]} {:db/id "answer-field-73027cc0-3004-56e5-8a8a-41f0c59a4f77" :answer-field/id #uuid "73027cc0-3004-56e5-8a8a-41f0c59a4f77" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3d69ecac-a052-597a-990f-d18d2a8b1970" :answer-field/choices ["answer-02c566de-7afa-5c5b-9076-1b5c4c862420" "answer-ee8fb354-b31e-55fc-80fb-146792dac2d3" "answer-3d69ecac-a052-597a-990f-d18d2a8b1970" "answer-22a7612f-73dd-54d0-af2d-7674b3f15667" "answer-3c268c10-167f-5a67-8207-c306dbc438ea"] :db/ensure [:answer-field/validate]} {:db/id "answer-02c566de-7afa-5c5b-9076-1b5c4c862420" :answer/id #uuid "02c566de-7afa-5c5b-9076-1b5c4c862420" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-ee8fb354-b31e-55fc-80fb-146792dac2d3" :answer/id #uuid "ee8fb354-b31e-55fc-80fb-146792dac2d3" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-3d69ecac-a052-597a-990f-d18d2a8b1970" :answer/id #uuid "3d69ecac-a052-597a-990f-d18d2a8b1970" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-22a7612f-73dd-54d0-af2d-7674b3f15667" :answer/id #uuid "22a7612f-73dd-54d0-af2d-7674b3f15667" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-3c268c10-167f-5a67-8207-c306dbc438ea" :answer/id #uuid "3c268c10-167f-5a67-8207-c306dbc438ea" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-da9aaccf-ed58-5942-8a55-f387c4ff158b" :question/id #uuid "da9aaccf-ed58-5942-8a55-f387c4ff158b" :question/math-academy-id "q-213027" :question/problem "$14\\text{ mod }6=${{field-1}}" :question/worked-solution "The residue of $14$ modulo $6$ is the integer $0\\le r<6$ such that\n\n$$\n14≡r\\,(\\text{mod}\\,6).\n$$\n\n**Method 1**\n\nTo find the residue $r,$ we need to write $14$ as an integer multiple of $6,$ plus the residue $r.$\n\nWe note that $14≡2\\,(\\text{mod}\\,6)$ because\n\n$$\n14=2\\cdot 6+2.\n$$\n\nTherefore, the residue of $14$ modulo $6$ is $2.$\n\n**Method 2**\n\nWe can use the subtraction property:\n\n$$\n\\begin{aligned}14 & ≡14-0 &  & (\\text{mod}\\,6) \\\\  & ≡14-2\\cdot 6 &  & (\\text{mod}\\,6) \\\\  & ≡14-12 &  & (\\text{mod}\\,6) \\\\  & ≡2 &  & (\\text{mod}\\,6)\\end{aligned}\n$$\n\nTherefore, the residue of $14$ modulo $6$ is $2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a41cffe8-3aaa-5190-832f-40d305241d5c"] :db/ensure [:question/validate]} {:db/id "answer-field-a41cffe8-3aaa-5190-832f-40d305241d5c" :answer-field/id #uuid "a41cffe8-3aaa-5190-832f-40d305241d5c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0015065c-e020-549d-8843-ecb2b21a3462" :answer-field/choices ["answer-0015065c-e020-549d-8843-ecb2b21a3462"] :db/ensure [:answer-field/validate]} {:db/id "answer-0015065c-e020-549d-8843-ecb2b21a3462" :answer/id #uuid "0015065c-e020-549d-8843-ecb2b21a3462" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "question-7119d9e9-8c81-54dd-a944-533c5aa1aed1" :question/id #uuid "7119d9e9-8c81-54dd-a944-533c5aa1aed1" :question/math-academy-id "q-213046" :question/problem "$27\\text{ mod }4=${{field-1}}" :question/worked-solution "The residue of $27$ modulo $4$ is the integer $0\\le r<4$ such that\n\n$$\n27≡r\\,(\\text{mod}\\,4).\n$$\n\n**Method 1**\n\nTo find the residue $r,$ we need to write $27$ as an integer multiple of $4,$ plus the residue $r.$\n\nWe note that $27≡3\\,(\\text{mod}\\,4)$ because\n\n$$\n27=6\\cdot 4+3.\n$$\n\nTherefore, the residue of $27$ modulo $4$ is $3.$\n\n**Method 2**\n\nWe can use the subtraction property:\n\n$$\n\\begin{aligned}27 & ≡27-0 &  & (\\text{mod}\\,4) \\\\  & ≡27-6\\cdot 4 &  & (\\text{mod}\\,4) \\\\  & ≡27-24 &  & (\\text{mod}\\,4) \\\\  & ≡3 &  & (\\text{mod}\\,4)\\end{aligned}\n$$\n\nTherefore, the residue of $27$ modulo $4$ is $3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0905d27b-bf64-570e-8e3a-3ea2e09cbd45"] :db/ensure [:question/validate]} {:db/id "answer-field-0905d27b-bf64-570e-8e3a-3ea2e09cbd45" :answer-field/id #uuid "0905d27b-bf64-570e-8e3a-3ea2e09cbd45" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4818c49a-4b28-56a1-84b2-20b5cc1b77cc" :answer-field/choices ["answer-4818c49a-4b28-56a1-84b2-20b5cc1b77cc"] :db/ensure [:answer-field/validate]} {:db/id "answer-4818c49a-4b28-56a1-84b2-20b5cc1b77cc" :answer/id #uuid "4818c49a-4b28-56a1-84b2-20b5cc1b77cc" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-549f3a8c-907a-5b2d-8f07-7849e3e239ab" :question/id #uuid "549f3a8c-907a-5b2d-8f07-7849e3e239ab" :question/math-academy-id "q-76960" :question/problem "$-9\\text{ mod }4=$" :question/worked-solution "The residue of $-9$ modulo $4$ is the integer $0\\le r<4$ such that\n\n$$\n-9≡r\\,(\\text{mod}\\,4).\n$$\n\n**Method 1**\n\nTo find the residue $r,$ we need to write $-9$ as an integer multiple of $4,$ plus the residue $r.$\n\nWe note that $-9≡3\\,(\\text{mod}\\,4)$ because\n\n$$\n-9=(-3)\\cdot 4+3.\n$$\n\nTherefore, the residue of $-9$ modulo $4$ is $3.$\n\n**Method 2**\n\nWe can use the addition property:\n\n$$\n\\begin{aligned}-9 & ≡-9+0 &  & (\\text{mod}\\,4) \\\\  & ≡-9+3\\cdot 4 &  & (\\text{mod}\\,4) \\\\  & ≡-9+12 &  & (\\text{mod}\\,4) \\\\  & ≡3 &  & (\\text{mod}\\,4)\\end{aligned}\n$$\n\nTherefore, the residue of $-9$ modulo $4$ is $3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-172af2de-9700-5ec7-90c0-9263bfe2cefe"] :db/ensure [:question/validate]} {:db/id "answer-field-172af2de-9700-5ec7-90c0-9263bfe2cefe" :answer-field/id #uuid "172af2de-9700-5ec7-90c0-9263bfe2cefe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2afe2d65-4054-594e-b4e8-a303a39cda0d" :answer-field/choices ["answer-1532bdde-984c-58ae-9a0a-62a3cb85c963" "answer-1fb6b485-00ae-55b8-895e-218fb3282422" "answer-44450b1d-6f63-5192-9d49-ab40989723d0" "answer-2afe2d65-4054-594e-b4e8-a303a39cda0d" "answer-d9bdccab-932d-5ce6-9e45-bf399d4ab2c8"] :db/ensure [:answer-field/validate]} {:db/id "answer-1532bdde-984c-58ae-9a0a-62a3cb85c963" :answer/id #uuid "1532bdde-984c-58ae-9a0a-62a3cb85c963" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-1fb6b485-00ae-55b8-895e-218fb3282422" :answer/id #uuid "1fb6b485-00ae-55b8-895e-218fb3282422" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-44450b1d-6f63-5192-9d49-ab40989723d0" :answer/id #uuid "44450b1d-6f63-5192-9d49-ab40989723d0" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-2afe2d65-4054-594e-b4e8-a303a39cda0d" :answer/id #uuid "2afe2d65-4054-594e-b4e8-a303a39cda0d" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-d9bdccab-932d-5ce6-9e45-bf399d4ab2c8" :answer/id #uuid "d9bdccab-932d-5ce6-9e45-bf399d4ab2c8" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-0a2135af-f11d-5278-a560-c7cd73d93e86" :question/id #uuid "0a2135af-f11d-5278-a560-c7cd73d93e86" :question/math-academy-id "q-213089" :question/problem "$-54\\text{ mod }7=${{field-1}}" :question/worked-solution "The residue of $-54$ modulo $7$ is the integer $0\\le r<7$ such that\n\n$$\n-54≡r\\,(\\text{mod}\\,7).\n$$\n\n**Method 1**\n\nTo find the residue $r,$ we need to write $-54$ as an integer multiple of $7,$ plus the residue $r.$\n\nWe note that $-54≡2\\,(\\text{mod}\\,7)$ because\n\n$$\n-54=(-8)\\cdot 7+2.\n$$\n\nTherefore, the residue of $-54$ modulo $7$ is $2.$\n\n**Method 2**\n\nWe can use the addition property:\n\n$$\n\\begin{aligned}-54 & ≡-54+0 &  & (\\text{mod}\\,7) \\\\  & ≡-54+8\\cdot 7 &  & (\\text{mod}\\,7) \\\\  & ≡-54+56 &  & (\\text{mod}\\,7) \\\\  & ≡2 &  & (\\text{mod}\\,7)\\end{aligned}\n$$\n\nTherefore, the residue of $-54$ modulo $7$ is $2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cadd8c20-4787-5c4e-9b19-fc516ac97d48"] :db/ensure [:question/validate]} {:db/id "answer-field-cadd8c20-4787-5c4e-9b19-fc516ac97d48" :answer-field/id #uuid "cadd8c20-4787-5c4e-9b19-fc516ac97d48" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-452e4778-8d1c-58fb-8493-02220c8324c7" :answer-field/choices ["answer-452e4778-8d1c-58fb-8493-02220c8324c7"] :db/ensure [:answer-field/validate]} {:db/id "answer-452e4778-8d1c-58fb-8493-02220c8324c7" :answer/id #uuid "452e4778-8d1c-58fb-8493-02220c8324c7" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "question-24b40dbb-8c36-5294-b359-e391ac1e418a" :question/id #uuid "24b40dbb-8c36-5294-b359-e391ac1e418a" :question/math-academy-id "q-76973" :question/problem "$-21\\text{ mod }5=$" :question/worked-solution "The residue of $-21$ modulo $5$ is the integer $0\\le r<5$ such that\n\n$$\n-21≡r\\,(\\text{mod}\\,5).\n$$\n\n**Method 1**\n\nTo find the residue $r,$ we need to write $-21$ as an integer multiple of $5,$ plus the residue $r.$\n\nWe note that $-21≡4\\,(\\text{mod}\\,5)$ because\n\n$$\n-21=(-5)\\cdot 5+4.\n$$\n\nTherefore, the residue of $-21$ modulo $5$ is $4.$\n\n**Method 2**\n\nWe can use the addition property:\n\n$$\n\\begin{aligned}-21 & ≡-21+0 &  & (\\text{mod}\\,5) \\\\  & ≡-21+5\\cdot 5 &  & (\\text{mod}\\,5) \\\\  & ≡-21+25 &  & (\\text{mod}\\,5) \\\\  & ≡4 &  & (\\text{mod}\\,5)\\end{aligned}\n$$\n\nTherefore, the residue of $-21$ modulo $5$ is $4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-89e48474-6809-54bb-b1e7-62905956c0cc"] :db/ensure [:question/validate]} {:db/id "answer-field-89e48474-6809-54bb-b1e7-62905956c0cc" :answer-field/id #uuid "89e48474-6809-54bb-b1e7-62905956c0cc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-17acc15b-5128-5c4a-a66a-3f4a98cc058d" :answer-field/choices ["answer-dc0ec7ef-b4ca-5d0b-82a5-8ef3a04bb977" "answer-0542fa10-23f6-572f-9b84-a34a655e4e13" "answer-a6aabe2b-aa1c-58cc-a992-7f26463340b6" "answer-dca08ebe-cbb9-5277-8f23-1002fcfc812a" "answer-17acc15b-5128-5c4a-a66a-3f4a98cc058d"] :db/ensure [:answer-field/validate]} {:db/id "answer-dc0ec7ef-b4ca-5d0b-82a5-8ef3a04bb977" :answer/id #uuid "dc0ec7ef-b4ca-5d0b-82a5-8ef3a04bb977" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-0542fa10-23f6-572f-9b84-a34a655e4e13" :answer/id #uuid "0542fa10-23f6-572f-9b84-a34a655e4e13" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-a6aabe2b-aa1c-58cc-a992-7f26463340b6" :answer/id #uuid "a6aabe2b-aa1c-58cc-a992-7f26463340b6" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-dca08ebe-cbb9-5277-8f23-1002fcfc812a" :answer/id #uuid "dca08ebe-cbb9-5277-8f23-1002fcfc812a" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-17acc15b-5128-5c4a-a66a-3f4a98cc058d" :answer/id #uuid "17acc15b-5128-5c4a-a66a-3f4a98cc058d" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-9feebe3a-396b-5d25-94bd-022707c998e2" :question/id #uuid "9feebe3a-396b-5d25-94bd-022707c998e2" :question/math-academy-id "q-76976" :question/problem "$-49\\text{ mod }7=$" :question/worked-solution "The residue of $-49$ modulo $7$ is the integer $0\\le r<7$ such that\n\n$$\n-49≡r\\,(\\text{mod}\\,7).\n$$\n\n**Method 1**\n\nTo find the residue $r,$ we need to write $-49$ as an integer multiple of $7,$ plus the residue $r.$\n\nWe note that $-49≡0\\,(\\text{mod}\\,7)$ because\n\n$$\n-49=(-7)\\cdot 7+0.\n$$\n\nTherefore, the residue of $-49$ modulo $7$ is $0.$\n\n**Method 2**\n\nWe can use the addition property:\n\n$$\n\\begin{aligned}-49 & ≡-49+0 &  & (\\text{mod}\\,7) \\\\  & ≡-49+7\\cdot 7 &  & (\\text{mod}\\,7) \\\\  & ≡-49+49 &  & (\\text{mod}\\,7) \\\\  & ≡0 &  & (\\text{mod}\\,7)\\end{aligned}\n$$\n\nTherefore, the residue of $-49$ modulo $7$ is $0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1ca19ee1-2131-5b73-85ea-31b8d76a7452"] :db/ensure [:question/validate]} {:db/id "answer-field-1ca19ee1-2131-5b73-85ea-31b8d76a7452" :answer-field/id #uuid "1ca19ee1-2131-5b73-85ea-31b8d76a7452" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-75a19707-be57-5e82-8eb4-0944e0c8696f" :answer-field/choices ["answer-75a19707-be57-5e82-8eb4-0944e0c8696f" "answer-a7af7fe3-0c2d-5d34-8fe5-f16f1ad6fe52" "answer-91840381-efb0-52a9-a878-768f9ce27516" "answer-da42cea3-d702-5d12-bf8f-94a1bc835e6e" "answer-e812db0e-640e-54c1-a36a-e2ae29ef8613"] :db/ensure [:answer-field/validate]} {:db/id "answer-75a19707-be57-5e82-8eb4-0944e0c8696f" :answer/id #uuid "75a19707-be57-5e82-8eb4-0944e0c8696f" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-a7af7fe3-0c2d-5d34-8fe5-f16f1ad6fe52" :answer/id #uuid "a7af7fe3-0c2d-5d34-8fe5-f16f1ad6fe52" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-91840381-efb0-52a9-a878-768f9ce27516" :answer/id #uuid "91840381-efb0-52a9-a878-768f9ce27516" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-da42cea3-d702-5d12-bf8f-94a1bc835e6e" :answer/id #uuid "da42cea3-d702-5d12-bf8f-94a1bc835e6e" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-e812db0e-640e-54c1-a36a-e2ae29ef8613" :answer/id #uuid "e812db0e-640e-54c1-a36a-e2ae29ef8613" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-6d645eda-2214-5faa-a63b-2fee859e4238" :question/id #uuid "6d645eda-2214-5faa-a63b-2fee859e4238" :question/math-academy-id "q-213076" :question/problem "$-7\\text{ mod }2=${{field-1}}" :question/worked-solution "The residue of $-7$ modulo $2$ is the integer $0\\le r<2$ such that\n\n$$\n-7≡r\\,(\\text{mod}\\,2).\n$$\n\n**Method 1**\n\nTo find the residue $r,$ we need to write $-7$ as an integer multiple of $2,$ plus the residue $r.$\n\nWe note that $-7≡1\\,(\\text{mod}\\,2)$ because\n\n$$\n-7=(-4)\\cdot 2+1.\n$$\n\nTherefore, the residue of $-7$ modulo $2$ is $1.$\n\n**Method 2**\n\nWe can use the addition property:\n\n$$\n\\begin{aligned}-7 & ≡-7+0 &  & (\\text{mod}\\,2) \\\\  & ≡-7+4\\cdot 2 &  & (\\text{mod}\\,2) \\\\  & ≡-7+8 &  & (\\text{mod}\\,2) \\\\  & ≡1 &  & (\\text{mod}\\,2)\\end{aligned}\n$$\n\nTherefore, the residue of $-7$ modulo $2$ is $1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e5b90a83-101c-5227-b1b7-407300b1fd00"] :db/ensure [:question/validate]} {:db/id "answer-field-e5b90a83-101c-5227-b1b7-407300b1fd00" :answer-field/id #uuid "e5b90a83-101c-5227-b1b7-407300b1fd00" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-cb2108e1-8c03-51d5-809d-d47e269ec3c9" :answer-field/choices ["answer-cb2108e1-8c03-51d5-809d-d47e269ec3c9"] :db/ensure [:answer-field/validate]} {:db/id "answer-cb2108e1-8c03-51d5-809d-d47e269ec3c9" :answer/id #uuid "cb2108e1-8c03-51d5-809d-d47e269ec3c9" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id 17592186152476 :question/problem "Let $a$ be a positive integer. Construct an expression that gives the last digit of $a.$" :question/worked-solution "Let ${d}_{3},$ ${d}_{2},$ and ${d}_{1}$ be the last three digits of the number $a:$ \n\n$$\na=…{d}_{3}{d}_{2}{d}_{1}\n$$\n\nThen, $a$ can be written in expanded form as follows:\n\n$$\n\\begin{aligned}a & =⋯+100{d}_{3}+10{d}_{2}+{d}_{1} \\\\  & =10(⋯+10{d}_{3}+{d}_{2})+{d}_{1}\\end{aligned}\n$$\n\nNow, we compute the residue of $a$ modulo $10:$\n\n$$\n\\begin{aligned}a & ≡10(⋯+10{d}_{3}+{d}_{2})+{d}_{1} &  & (\\text{mod}\\,10) \\\\  & ≡0\\cdot (⋯+10{d}_{3}+{d}_{2})+{d}_{1} &  & (\\text{mod}\\,10) \\\\  & ≡0+{d}_{1} &  & (\\text{mod}\\,10) \\\\  & ≡{d}_{1} &  & (\\text{mod}\\,10)\\end{aligned}\n$$\n\nNotice that ${d}_{1}$ is the last digit of $a.$\n\nTherefore, the expression that gives the last digit of $a$ is the following:\n\n$$\na\\,\\text{mod}\\,10\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6c05a902-7267-5fe7-977c-453f2d8f98fd" "answer-field-67984a06-18d9-553b-84b4-5f0264f4bf20"] :db/ensure [:question/validate]} {:db/id "answer-field-6c05a902-7267-5fe7-977c-453f2d8f98fd" :answer-field/id #uuid "6c05a902-7267-5fe7-977c-453f2d8f98fd" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-ba777412-b184-5cba-a961-7b78fad373b3" :answer-field/choices ["answer-7870242b-ec48-5947-9efb-1e431d8963aa" "answer-025335b4-a543-5316-babf-b941123d0854" "answer-ba777412-b184-5cba-a961-7b78fad373b3"] :db/ensure [:answer-field/validate]} {:db/id "answer-7870242b-ec48-5947-9efb-1e431d8963aa" :answer/id #uuid "7870242b-ec48-5947-9efb-1e431d8963aa" :answer/type :answer.type/math :answer/value "\\,\\,\\times " :db/ensure [:answer/validate]} {:db/id "answer-025335b4-a543-5316-babf-b941123d0854" :answer/id #uuid "025335b4-a543-5316-babf-b941123d0854" :answer/type :answer.type/math :answer/value "\\,\\,÷" :db/ensure [:answer/validate]} {:d