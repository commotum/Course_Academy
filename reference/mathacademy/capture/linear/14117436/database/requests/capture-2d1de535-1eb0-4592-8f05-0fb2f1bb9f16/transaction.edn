3}+{d}_{2})+{d}_{1}\\end{aligned}\n$$\n\nNow, we compute the residue of $b$ modulo $10:$\n\n$$\n\\begin{aligned}b & ≡10(⋯+10{d}_{3}+{d}_{2})+{d}_{1} &  & (\\text{mod}\\,10) \\\\  & ≡0\\cdot (⋯+10{d}_{3}+{d}_{2})+{d}_{1} &  & (\\text{mod}\\,10) \\\\  & ≡0+{d}_{1} &  & (\\text{mod}\\,10) \\\\  & ≡{d}_{1} &  & (\\text{mod}\\,10)\\end{aligned}\n$$\n\nNotice that ${d}_{1}$ is the last digit of $b.$\n\nFinally, since $b=16a-13,$ and \n\n$$\n16≡6,\\,-13≡-3\\,(\\text{mod}\\,10)\n$$\n\nwe have the following:\n\n$$\n\\begin{aligned}b & ≡{d}_{1} &  & (\\text{mod}\\,10) \\\\ 16a-13 & ≡{d}_{1} &  & (\\text{mod}\\,10) \\\\ 6a-3 & ≡{d}_{1} &  & (\\text{mod}\\,10)\\end{aligned}\n$$\n\nTherefore, the expression that gives the last digit of $16a-13$ is the following:\n\n$$\n6a-3\\,\\text{mod}\\,10\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0c8394a2-927d-58dc-b6a8-87142c1ee70c" "answer-field-9faa6a3f-3ae4-53e6-8f14-c0ef31fc8d54" "answer-field-0481e462-b4fa-5800-a934-d4741054820d"] :db/ensure [:question/validate]} {:db/id "answer-field-0c8394a2-927d-58dc-b6a8-87142c1ee70c" :answer-field/id #uuid "0c8394a2-927d-58dc-b6a8-87142c1ee70c" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-0e06888c-a058-5a34-9559-91f136c9f661" :answer-field/choices ["answer-a7ddd90c-3a78-50cb-9f55-63ed6d728c40" "answer-d11b1a12-4e60-5323-88da-0ca756864529" "answer-0e06888c-a058-5a34-9559-91f136c9f661" "answer-f854ff26-52b2-552b-83c0-9d8505ce9cff"] :db/ensure [:answer-field/validate]} {:db/id "answer-a7ddd90c-3a78-50cb-9f55-63ed6d728c40" :answer/id #uuid "a7ddd90c-3a78-50cb-9f55-63ed6d728c40" :answer/type :answer.type/math :answer/value "3a-6" :db/ensure [:answer/validate]} {:db/id "answer-d11b1a12-4e60-5323-88da-0ca756864529" :answer/id #uuid "d11b1a12-4e60-5323-88da-0ca756864529" :answer/type :answer.type/math :answer/value "6a" :db/ensure [:answer/validate]} {:db/id "answer-0e06888c-a058-5a34-9559-91f136