d8b2-5a5b-94bd-eb885922def6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{mod}" :db/id #edb/ref 17592186412298} {:answer/id #uuid "6e6670c0-03f5-514b-a49f-9681e6a26601" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\,\\,÷" :db/id #edb/ref 17592186412299} {:answer/id #uuid "c09550a5-d68c-576a-a921-1dadd5e25bf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\,\\,\\times " :db/id #edb/ref 17592186412320}] :answer-field/correct {:answer/id #uuid "6a2c3b24-d8b2-5a5b-94bd-eb885922def6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{mod}" :db/id #edb/ref 17592186412298} :answer-field/id #uuid "9faa6a3f-3ae4-53e6-8f14-c0ef31fc8d54" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186412364}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e4503f6b-114f-5eeb-b12d-95fc38bf1562" :question/math-academy-id "q-213093" :question/problem "Let $a$ be a positive integer. Construct an expression that gives the last digit of $16a-13.$" :question/worked-solution "Let $b=16a-13.$ Note that $b$ is positive. Now, let ${d}_{3},$ ${d}_{2},$ and ${d}_{1}$ be the last three digits of the number $b:$ \n\n$$\nb=…{d}_{3}{d}_{2}{d}_{1}\n$$\n\nThen, $b$ can be written in expanded form as follows:\n\n$$\n\\begin{aligned}b & =⋯+100{d}_{3}+10{d}_{2}+{d}_{1} \\\\  & =10(⋯+10{d}_{3}+{d}_{2})+{d}_{1}\\end{aligned}\n$$\n\nNow, we compute the residue of $b$ modulo $10:$\n\n$$\n\\begin{aligned}b & ≡10(⋯+10{d}_{3}+{d}_{2})+{d}_{1} &  & (\\text{mod}\\,10) \\\\  & ≡0\\cdot (⋯+10{d}_{3}+{d}_{2})+{d}_{1} &  & (\\text{mod}\\,10) \\\\  & ≡0+{d}_{1} &  & (\\text{mod}\\,10) \\\\  & ≡{d}_{1} &  & (\\text{mod}\\,10)\\end{aligned}\n$$\n\nNotice that ${d}_{1}$ is the last digit of $b.$\n\nFinally, since $b=16a-13,$ and \n\n$$\n16≡6,\\,-13≡-3\\,(\\text{mod}\\,10)\n$$\n\nwe have the following:\n\n$$\n\\begin{aligned}b & ≡{d}_{1} &  & (\\text{mod}\\,10) \\\\ 16a-13 & ≡{d}_{1} &  & (\\text{mod}\\,10) \\\\ 6a-3 & ≡{d}_{1} &  & (\\text{mod}\\,10)\\end{aligned}\n$$\n\nTherefore, the expression that gives the last digit of $16a-13$ is the following:\n\n$$\n6a-3\\,\\text{mod}\\,10\n$$"}] [{:db/id #edb/ref 17592186412374 :knowledge-point/_questions [{:db/id #edb/ref 17592186152057 :knowledge-point/id #uuid "9a090bd2-cdb1-5680-81bc-3cb36de126c4" :knowledge-point/title "Determining the Last Few Digits of a Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fe8e591-ad12-52f4-a2f8-1bca3dfd6296" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5a+3" :db/id #edb/ref 17592186412269} {:answer/id #uuid "92f1412d-1f75-560e-a351-03c9164622a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15a" :db/id #edb/ref 17592186412308} {:answer/id #uuid "96b46831-8183-5119-84cc-89942ba3993e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a+15" :db/id #edb/ref 17592186412309} {:answer/id #uuid "effeb510-969c-5a3f-85d4-ec87567c869b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15a+1" :db/id #edb/ref 17592186412343}] :answer-field/correct {:answer/id #uuid "92f1412d-1f75-560e-a351-03c9164622a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15a" :db/id #edb/ref 17592186412308} :answer-field/id #uuid "4dc1d3c2-ea95-5409-b806-aa17c7b0cff8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186412354} {:answer-field/choices [{:answer/id #uuid "21aa2954-a8d1-507a-b84b-e5072dbc08e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186412275} {:answer/id #uuid "21cbee92-d821-599b-aac4-a6279372c248" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186412276} {:answer/id #uuid "25faa3bd-9411-5f2e-a2b7-564638b4ee31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.01" :db/id #edb/ref 17592186412279} {:answer/id #uuid "4c08cd55-9d75-52c5-ad93-990146646c8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1" :db/id #edb/ref 17592186412293} {:answer/id #uuid "d9866395-0125-5f41-854d-0e5fcdd39c71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1000" :db/id #edb/ref 17592186412330}] :answer-field/correct {:answer/id #uuid "21cbee92-d821-599b-aac4-a6279372c248" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186412276} :answer-field/id #uuid "739873ae-7222-56d4-a75e-62dfb4f6ff56" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186412359} {:answer-field/choices [{:answer/id #uuid "093000e5-24a5-5cd8-98e2-b485b5430a35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\,\\,÷" :db/id #edb/ref 17592186412267} {:answer/id #uuid "379ee39b-848a-531f-87be-6adf177ef1a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\,\\,\\times " :db/id #edb/ref 17592186412283} {:answer/id #uuid "7fc67c42-e02e-5fd8-bc31-14007034daf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{mod}" :db/id #edb/ref 17592186412303} {:answer/id #uuid "c380e17d-2d26-5a2c-84f4-8e3b5fa63886" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186412321}] :answer-field/correct {:answer/id #uuid "7fc67c42-e02e-5fd8-bc31-14007034daf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{mod}" :db/id #edb/ref 17592186412303} :answer-field/id #uuid "fec96176-6e4b-5b1f-af15-6a4b4b87e54e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186412369}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "39ab88df-75d5-5304-96dd-f494bc2a5583" :question/math-academy-id "q-213325" :question/problem "Let $a$ be a positive integer. Construct an expression that gives a two-digit number consisting of the last two digits of $215a.$" :question/worked-solution "Let $b=215a.$ Note that $b$ is positive. Now, let ${d}_{4},$ ${d}_{3},$ ${d}_{2},$ and ${d}_{1}$ be the last four digits of the number $a:$ \n\n$$\na=…{d}_{4}{d}_{3}{d}_{2}{d}_{1}\n$$\n\nThen, $a$ can be written in expanded form as\n\n$$\n\\begin{aligned}a & =⋯+1000{d}_{4}+100{d}_{3}+10{d}_{2}+{d}_{1} \\\\  & =100(⋯+10{d}_{4}+{d}_{3})+10{d}_{2}+{d}_{1}.\\end{aligned}\n$$\n\nNow, we compute the residue of $a$ modulo $100:$\n\n$$\n\\begin{aligned}a & ≡100(⋯+10{d}_{4}+{d}_{3})+10{d}_{2}+{d}_{1} &  & (\\text{mod}\\,100) \\\\  & ≡0\\cdot (⋯+10{d}_{4}+{d}_{3})+10{d}_{2}+{d}_{1} &  & (\\text{mod}\\,100) \\\\  & ≡0+10{d}_{2}+{d}_{1} &  & (\\text{mod}\\,100) \\\\  & ≡10{d}_{2}+{d}_{1} &  & (\\text{mod}\\,100)\\end{aligned}\n$$\n\nNotice that $10{d}_{2}+{d}_{1}$ is the two-digit number consisting of the last two digits of $a.$\n\nFinally, since $b=215a,$ and \n\n$$\n215≡15\\,(\\text{mod}\\,100)\n$$\n\nwe have the following:\n\n$$\n\\begin{aligned}b & ≡10{d}_{2}+{d}_{1} &  & (\\text{mod}\\,100) \\\\ 215a & ≡10{d}_{2}+{d}_{1} &  & (\\text{mod}\\,100) \\\\ 15a & ≡10{d}_{2}+{d}_{1} &  & (\\text{mod}\\,100)\\end{aligned}\n$$\n\nTherefore, the expression that gives the last digit of $215a$ is the following:\n\n$$\n15a\\,\\text{mod}\\,100\n$$"}] [{:db/id #edb/ref 17592186412370 :knowledge-point/_questions [{:db/id #edb/ref 17592186152055 :knowledge-point/id #uuid "1ffdfb29-a3d2-5a7a-868c-21eab8965922" :knowledge-point/title "Modular Residues of Positive Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "429fdcde-3b6d-5c73-8dc3-bcbc021fbd80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186412289} {:answer/id #uuid "4c321879-5e75-577b-971a-ad0d16a20d10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186412294} {:answer/id #uuid "75eb0c8b-4787-5d81-adff-461746539962" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186412301} {:answer/id #uuid "c3e4fe4d-4c92-521c-83e6-c0e90c02531e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186412322} {:answer/id #uuid "d8b32333-3d63-5c1d-8463-d060ccddc6d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186412329}] :answer-field/correct {:answer/id #uuid "429fdcde-3b6d-5c73-8dc3-bcbc021fbd80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186412289} :answer-field/id #uuid "c0862172-5303-5476-81c5-ab7efd6c4dcc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412366}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "025be531-fd73-5fa9-9ce4-f3e4c0c054c5" :question/math-academy-id "q-76946" :question/problem "$67\\text{ mod }6=$" :question/worked-solution "The residue of $67$ modulo $6$ is the integer $0\\le r<6$ such that\n\n$$\n67≡r\\,(\\text{mod}\\,6).\n$$\n\n**Method 1**\n\nTo find the residue $r,$ we need to write $67$ as an integer multiple of $6,$ plus the residue $r.$\n\nWe note that $67≡1\\,(\\text{mod}\\,6)$ because\n\n$$\n67=11\\cdot 6+1.\n$$\n\nTherefore, the residue of $67$ modulo $6$ is $1.$\n\n**Method 2**\n\nWe can use the subtraction property:\n\n$$\n\\begin{aligned}67 & ≡67-0 &  & (\\text{mod}\\,6) \\\\  & ≡67-11\\cdot 6 &  & (\\text{mod}\\,6) \\\\  & ≡67-66 &  & (\\text{mod}\\,6) \\\\  & ≡1 &  & (\\text{mod}\\,6)\\end{aligned}\n$$\n\nTherefore, the residue of $67$ modulo $6$ is $1.$"}] [{:db/id #edb/ref 17592186412380 :knowledge-point/_questions [{:db/id #edb/ref 17592186152055 :knowledge-point/id #uuid "1ffdfb29-a3d2-5a7a-868c-21eab8965922" :knowledge-point/title "Modular Residues of Positive Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02c566de-7afa-5c5b-9076-1b5c4c862420" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186412262} {:answer/id #uuid "22a7612f-73dd-54d0-af2d-7674b3f15667" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186412277} {:answer/id #uuid "3c268c10-167f-5a67-8207-c306dbc438ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186412284} {:answer/id #uuid "3d69ecac-a052-597a-990f-d18d2a8b1970" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186412285} {:answer/id #uuid "ee8fb354-b31e-55fc-80fb-146792dac2d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186412342}] :answer-field/correct {:answer/id #uuid "3d69ecac-a052-597a-990f-d18d2a8b1970" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186412285} :answer-field/id #uuid "73027cc0-3004-56e5-8a8a-41f0c59a4f77" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412358}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ab21706d-8653-5637-8475-77432c4bfb1b" :question/math-academy-id "q-76947" :question/problem "$52\\text{ mod }5=$" :question/worked-solution "The residue of $52$ modulo $5$ is the integer $0\\le r<5$ such that\n\n$$\n52≡r\\,(\\text{mod}\\,5).\n$$\n\n**Method 1**\n\nTo find the residue $r,$ we need to write $52$ as an integer multiple of $5,$ plus the residue $r.$\n\nWe note that $52≡2\\,(\\text{mod}\\,5)$ because\n\n$$\n52=10\\cdot 5+2.\n$$\n\nTherefore, the residue of $52$ modulo $5$ is $2.$\n\n**Method 2**\n\nWe can use the subtraction property:\n\n$$\n\\begin{aligned}52 & ≡52-0 &  & (\\text{mod}\\,5) \\\\  & ≡52-10\\cdot 5 &  & (\\text{mod}\\,5) \\\\  & ≡52-50 &  & (\\text{mod}\\,5) \\\\  & ≡2 &  & (\\text{mod}\\,5)\\end{aligned}\n$$\n\nTherefore, the residue of $52$ modulo $5$ is $2.$"}] [{:db/id #edb/ref 17592186412376 :knowledge-point/_questions [{:db/id #edb/ref 17592186152056 :knowledge-point/id #uuid "e70cef00-bf25-5423-85ac-2d3a44c68f35" :knowledge-point/title "Modular Residues of Negative Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1532bdde-984c-58ae-9a0a-62a3cb85c963" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186412271} {:answer/id #uuid "1fb6b485-00ae-55b8-895e-218fb3282422" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186412274} {:answer/id #uuid "2afe2d65-4054-594e-b4e8-a303a39cda0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186412280} {:answer/id #uuid "44450b1d-6f63-5192-9d49-ab40989723d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186412290} {:answer/id #uuid "d9bdccab-932d-5ce6-9e45-bf399d4ab2c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186412331}] :answer-field/correct {:answer/id #uuid "2afe2d65-4054-594e-b4e8-a303a39cda0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186412280} :answer-field/id #uuid "172af2de-9700-5ec7-90c0-9263bfe2cefe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412349}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "549f3a8c-907a-5b2d-8f07-7849e3e239ab" :question/math-academy-id "q-76960" :question/problem "$-9\\text{ mod }4=$" :question/worked-solution "The residue of $-9$ modulo $4$ is the integer $0\\le r<4$ such that\n\n$$\n-9≡r\\,(\\text{mod}\\,4).\n$$\n\n**Method 1**\n\nTo find the residue $r,$ we need to write $-9$ as an integer multiple of $4,$ plus the residue $r.$\n\nWe note that $-9≡3\\,(\\text{mod}\\,4)$ because\n\n$$\n-9=(-3)\\cdot 4+3.\n$$\n\nTherefore, the residue of $-9$ modulo $4$ is $3.$\n\n**Method 2**\n\nWe can use the addition property:\n\n$$\n\\begin{aligned}-9 & ≡-9+0 &  & (\\text{mod}\\,4) \\\\  & ≡-9+3\\cdot 4 &  & (\\text{mod}\\,4) \\\\  & ≡-9+12 &  & (\\text{mod}\\,4) \\\\  & ≡3 &  & (\\text{mod}\\,4)\\end{aligned}\n$$\n\nTherefore, the residue of $-9$ modulo $4$ is $3.$"}] [{:db/id #edb/ref 17592186412372 :knowledge-point/_questions [{:db/id #edb/ref 17592186152056 :knowledge-point/id #uuid "e70cef00-bf25-5423-85ac-2d3a44c68f35" :knowledge-point/title "Modular Residues of Negative Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0542fa10-23f6-572f-9b84-a34a655e4e13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186412264} {:answer/id #uuid "17acc15b