fore, the expression that gives the last digit of $a$ is the following:\n\n$$\na\\,\\text{mod}\\,10\n$$"}] [{:db/id #edb/ref 17592186412373 :knowledge-point/_questions [{:db/id #edb/ref 17592186152057 :knowledge-point/id #uuid "9a090bd2-cdb1-5680-81bc-3cb36de126c4" :knowledge-point/title "Determining the Last Few Digits of a Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0179ab06-b666-5897-8b46-ee9334267d51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a" :db/id #edb/ref 17592186412260} {:answer/id #uuid "cf382bf7-5ade-5948-8966-a05213deac20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2a" :db/id #edb/ref 17592186412325} {:answer/id #uuid "e614fd17-a49f-57f4-9885-3e191a459935" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a+1" :db/id #edb/ref 17592186412338} {:answer/id #uuid "fc37fd48-8db7-549b-9bca-a9e299c9ef5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2a+1" :db/id #edb/ref 17592186412345}] :answer-field/correct {:answer/id #uuid "fc37fd48-8db7-549b-9bca-a9e299c9ef5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2a+1" :db/id #edb/ref 17592186412345} :answer-field/id #uuid "1c808650-670f-5359-b03d-37e5210f7aab" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186412351} {:answer-field/choices [{:answer/id #uuid "23664f96-879c-51bd-89f0-dede9cc02253" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186412278} {:answer/id #uuid "2e60a1c1-361a-59b7-a94d-06e92eeefa00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186412281} {:answer/id #uuid "5236d587-b4f8-5df5-b8f4-ecdf8d9f02eb" :answer/type {:db/id 