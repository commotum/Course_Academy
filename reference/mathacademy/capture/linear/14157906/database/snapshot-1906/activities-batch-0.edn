#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055695} :activity/id #uuid "f2277d3a-ef2a-5841-a71b-c009fa22474f" :activity/scope {:db/id #edb/ref 17592186048159 :topic/id #uuid "83e3488f-93ea-5d89-9ca2-cc999d6437e8" :topic/math-academy-id 75} :activity/steps [{:db/id #edb/ref 17592186055646 :step/content {:db/id #edb/ref 17592186054680 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054576 :question/id #uuid "6be67098-9840-515b-b0db-e1a0ac9c0cf8" :question/math-academy-id "e-6798"} :knowledge-point/id #uuid "efeb39b0-a8d7-574a-b07f-65da734e7f4b" :knowledge-point/questions [{:db/id #edb/ref 17592186055223} {:db/id #edb/ref 17592186055494} {:db/id #edb/ref 17592186481362} {:db/id #edb/ref 17592186481366}] :knowledge-point/title "Distributing the Absolute Value Over Multiplication"} :step/id #uuid "6f034d09-bf96-5515-9938-b1ba199611c0" :step/math-academy-id 25121 :step/next {:db/id #edb/ref 17592186055647}} {:db/id #edb/ref 17592186055647 :step/content {:db/id #edb/ref 17592186054681 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054577 :question/id #uuid "0a7c872a-a6f5-543e-835f-4c848f482282" :question/math-academy-id "e-6799"} :knowledge-point/id #uuid "7809c90a-fa18-5955-88ee-7235f75b915d" :knowledge-point/questions [{:db/id #edb/ref 17592186055222} {:db/id #edb/ref 17592186055224} {:db/id #edb/ref 17592186481397} {:db/id #edb/ref 17592186481441}] :knowledge-point/title "Distributing the Absolute Value Over Division"} :step/id #uuid "e001fa58-8252-57e0-8441-22d3eb0c4673" :step/math-academy-id 25122} {:db/id #edb/ref 17592186055694 :step/content {:db/id #edb/ref 17592186055996 :tutorial/content "The absolute value operation is **distributive with respect to multiplication.** This means that the absolute value of a product equals the product of the absolute values.\n\nTo demonstrate, consider the following expression:\n\n$$\n|(-6) \\cdot 2|\n$$\n\nWe can evaluate this expression in two separate ways:\n\n- The first is to find the absolute value of the product. In doing this, we get\n\n$$\n\\begin{aligned}|(-6)\\cdot 2| & =|-12| \\\\  & =12.\\end{aligned}\n$$\n\n- The second is to find the product of the absolute values. In doing this, we get\n\n$$\n\\begin{aligned}|(-6)\\cdot 2| & =|-6|\\cdot |2| \\\\  & =6\\cdot 2 \\\\  & =12.\\end{aligned}\n$$\n\nIn general\n\n$$\n|a \\cdot b| = |a|\\cdot |b|.\n$$\n\nThe absolute value operation is also distributive with respect to division. In general,\n\n$$\n\\left|\\dfrac{a}{b}\\right| = \\dfrac{|a|}{|b|}.\n$$" :tutorial/id #uuid "1585ba98-a0d1-54db-b624-714c8520cbd8" :tutorial/math-academy-id 6011 :tutorial/title "The Distributive Properties"} :step/id #uuid "907ede99-0507-5ffb-9c09-ed38cd197061" :step/math-academy-id 36686 :step/next {:db/id #edb/ref 17592186055646}} {:db/id #edb/ref 17592186055695 :step/content {:db/id #edb/ref 17592186055949 :tutorial/content "Recall that the absolute value of a number represents the distance of that number from the origin.\n\nLet's take a look at the number line below.\n\n![](images/e2/e20db43f722fc4db42fc845ab20a7eef2c06437cc1d2246e0aed47dc01107aba.png)\n\nSince $-3$ and $3$ are at the same distance from the origin, we have\n\n$$\n|-3| = |3| = 3.\n$$\n\nIn general, for any real number $a,$\n\n$$\n|-a| = |a|.\n$$\n\nWe can use this fact to simplify expressions containing absolute value. Let's see an example." :tutorial/id #uuid "015d8989-8f7a-58b4-9428-f28935b67b2a" :tutorial/math-academy-id 1550 :tutorial/title "Introduction"} :step/id #uuid "35abb884-8f5f-5a93-a517-42d78b328130" :step/math-academy-id 3973 :step/next {:db/id #edb/ref 17592186055696}} {:db/id #edb/ref 17592186055696 :step/content {:db/id #edb/ref 17592186054709 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054354 :question/id #uuid "e929f7a0-e0a9-5b3f-82e7-400e969307d6" :question/math-academy-id "e-1236"} :knowledge-point/id #uuid "651a1407-6162-54d4-8bab-4dc109d8c88a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049844}] :knowledge-point/questions [{:db/id #edb/ref 17592186055225} {:db/id #edb/ref 17592186055365} {:db/id #edb/ref 17592186481354}] :knowledge-point/title "Simplifying the Absolute Value of a Negative Term"} :step/id #uuid "4ad335be-4991-593a-923a-cdcb127545d0" :step/math-academy-id 3975 :step/next {:db/id #edb/ref 17592186055694}}] :activity/title "Rules of Absolute Value" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054923}]}
