/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186481315}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9b56ca18-7b32-5eb8-a22c-8e34fda01fb4" :question/math-academy-id "q-78907" :question/problem "$|-\\frac{8}{7z}|=$" :question/worked-solution "Firstly, since $|-a|=|a|,$ we can write our expression as\n\n$$\n|\\frac{8}{7z}|.\n$$\n\nThen, we distribute the absolute value over the division, and simplify:\n\n$$\n\\begin{aligned}|\\frac{8}{7z}| & = \\\\ \\frac{|8|}{|7z|} & = \\\\ \\frac{8}{|7z|} & = \\\\ \\frac{8}{|7\\cdot z|} & = \\\\ \\frac{8}{|7|\\cdot |z|} & = \\\\ \\frac{8}{7|z|}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481441 :knowledge-point/_questions [{:db/id #edb/ref 17592186054681 :knowledge-point/id #uuid "7809c90a-fa18-5955-88ee-7235f75b915d" :knowledge-point/title "Distributing the Absolute Value Over Division"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14df1b8b-c09f-5f4f-8912-bce12aef73f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5|p|}{2}" :db/id #edb/ref 17592186480776} {:answer/id #uuid "1bca8841-c608-5df1-a39f-72e10b74000f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5|p|}{2}" :db/id #edb/ref 17592186480797} {:answer/id #uuid "55caa650-df35-59bd-bd90-4e9fd14e444a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5p}{2}" :db/id #edb/ref 17592186480896} {:answer/id #uuid "e25f1198-58ef-5316-a79a-76a71cb9dca8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10p" :db/id #edb/ref 17592186481167} {:answer/id #uuid "ef5a1d4e-4c65-5a3d-9293-71fda013cbca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186481198}] :answer-field/correct {:answer/id #u