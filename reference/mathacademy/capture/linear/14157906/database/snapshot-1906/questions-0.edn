#{[{:db/id #edb/ref 17592186054354 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054709 :knowledge-point/id #uuid "651a1407-6162-54d4-8bab-4dc109d8c88a" :knowledge-point/title "Simplifying the Absolute Value of a Negative Term"}] :question/id #uuid "e929f7a0-e0a9-5b3f-82e7-400e969307d6" :question/math-academy-id "e-1236" :question/problem "Simplify the expression $|-2x|.$" :question/worked-solution "Since $|-a| = |a|,$ we can rewrite our expression as follows:\n\n$$\n\\begin{aligned}|-2x| & =|2x|\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054576 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054680 :knowledge-point/id #uuid "efeb39b0-a8d7-574a-b07f-65da734e7f4b" :knowledge-point/title "Distributing the Absolute Value Over Multiplication"}] :question/id #uuid "6be67098-9840-515b-b0db-e1a0ac9c0cf8" :question/math-academy-id "e-6798" :question/problem "Simplify the expression $|-18a|.$" :question/worked-solution "Firstly, since $|-a| = |a|,$ we can write our expression as\n\n$$\n|18a|\n$$\n\nThen, we distribute the absolute value over the multiplication, and simplify:\n\n$$\n\\begin{aligned}|18a| & = \\\\ |18\\cdot a| & = \\\\ |18|\\cdot |a| & = \\\\ 18\\cdot |a| & = \\\\ 18|a|\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054577 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054681 :knowledge-point/id #uuid "7809c90a-fa18-5955-88ee-7235f75b915d" :knowledge-point/title "Distributing the Absolute Value Over Division"}] :question/id #uuid "0a7c872a-a6f5-543e-835f-4c848f482282" :question/math-academy-id "e-6799" :question/problem "Simplify the expression $\\left|-\\dfrac{9}{5c}\\right|.$" :question/worked-solution "Firstly, since $|-a| = |a|,$ we can write our expression as\n\n$$\n\\left|\\dfrac{9}{5c}\\right|.\n$$\n\nThen, we distribute the absolute value over the division, and simplify:\n\n$$\n\\begin{aligned}|\\frac{9}{5c}| & = \\\\ \\frac{|9|}{|5c|} & = \\\\ \\frac{9}{|5c|} & = \\\\ \\frac{9}{|5|\\cdot |c|} & = \\\\ \\frac{9}{5|c|}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481362 :knowledge-point/_questions [{:db/id #edb/ref 17592186054680 :knowledge-point/id #uuid "efeb39b0-a8d7-574a-b07f-65da734e7f4b" :knowledge-point/title "Distributing the Absolute Value Over Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08f20868-6a4d-50d9-a8bc-710ffae4cb97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186480758} {:answer/id #uuid "85811a93-a7cf-52b7-942f-22f7a24348c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9|a|" :db/id #edb/ref 17592186480995} {:answer/id #uuid "af905c3b-1939-597d-9d71-3aef9f1ab184" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3a" :db/id #edb/ref 17592186481068} {:answer/id #uuid "b30999cc-c633-58f2-83be-6ced52d8ffdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9|a|" :db/id #edb/ref 17592186481077} {:answer/id #uuid "da00413d-224c-5153-8766-d44fa73b23d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9a" :db/id #edb/ref 17592186481149}] :answer-field/correct {:answer/id #uuid "b30999cc-c633-58f2-83be-6ced52d8ffdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9|a|" :db/id #edb/ref 17592186481077} :answer-field/id #uuid "e0e3c8da-c569-5435-b9a3-10772d1de6ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186481329}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4ad222fd-26eb-5815-83d7-f48153369720" :question/math-academy-id "q-111983" :question/problem "Simplify the expression $|-9a|.$" :question/worked-solution "Firstly, since $|-a|=|a|,$ we can write our expression as\n\n$$\n|9a|.\n$$