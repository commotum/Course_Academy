#{[{:db/id #edb/ref 17592186054354 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054709 :knowledge-point/id #uuid "651a1407-6162-54d4-8bab-4dc109d8c88a" :knowledge-point/title "Simplifying the Absolute Value of a Negative Term"}] :question/id #uuid "e929f7a0-e0a9-5b3f-82e7-400e969307d6" :question/math-academy-id "e-1236" :question/problem "Simplify the expression $\\mid -2x \\mid$." :question/worked-solution "Since\n\n$$\n\\begin{vmatrix}-a & = & a\\end{vmatrix}\n$$\n\nwe can rewrite our expression as follows:\n\n$$\n\\begin{aligned}\n\\begin{vmatrix}-2x & &= & 2x\\end{vmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054576 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054680 :knowledge-point/id #uuid "efeb39b0-a8d7-574a-b07f-65da734e7f4b" :knowledge-point/title "Distributing the Absolute Value Over Multiplication"}] :question/id #uuid "6be67098-9840-515b-b0db-e1a0ac9c0cf8" :question/math-academy-id "e-6798" :question/problem "Simplify the expression $\\mid -18a \\mid$." :question/worked-solution "Firstly, since\n\n$$\n\\begin{vmatrix}-a & = & a\\end{vmatrix}\n$$\n\nwe can write our expression as\n\n$$\n\\mid 18a \\mid\n$$\n\nThen, we distribute the absolute value over the multiplication, and simplify:\n\n$$\n\\begin{aligned}\n\\mid 18a \\mid &=  \\\\\n\\mid 18 \\cdot a \\mid &=  \\\\\n\\begin{vmatrix}18 & \\cdot & a\\end{vmatrix} &=  \\\\\n18 \\cdot\\begin{vmatrix}a & &= \\\\ 18 & a\\end{vmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054577 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054681 :knowledge-point/id #uuid "7809c90a-fa18-5955-88ee-7235f75b915d" :knowledge-point/title "Distributing the Absolute Value Over Division"}] :question/id #uuid "0a7c872a-a6f5-543e-835f-4c848f482282" :question/math-academy-id "e-6799" :question/problem "Simplify the expression $\\left|-\\dfrac{9}{5c}\\right|$." :question/worked-solution "Firstly, since\n\n$$\n\\begin{vmatrix}-a & = & a\\end{vmatrix}\n$$\n\nwe can write our expression as\n\n$$\n\\left|\\dfrac{9}{5c}\\right|\n$$\n\nThen, we distribute the absolute value over the division, and simplify:\n\n$$\n\\begin{aligned}\n\\mid \\frac{9}{5c} \\mid &=  \\\\\n\\frac{\\begin{vmatrix}9 &}{\\mid 5c\\end{vmatrix}} &=  \\\\\n\\frac{9}{\\mid 5c\\begin{vmatrix}} &= \\\\ \\frac{9}{\\begin{vmatrix}5 & \\cdot & c\\end{vmatrix}}|= \\\\ \\frac{9}{5 \\mid c\\end{vmatrix}}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186055225 :knowledge-point/_questions [{:db/id #edb/ref 17592186054709 :knowledge-point/id #uuid "651a1407-6162-54d4-8bab-4dc109d8c88a" :knowledge-point/title "Simplifying the Absolute Value of a Negative Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "984c333d-9b91-5c81-a5f1-666d8f12f729" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\mid \\frac{4}{7} \\mid" :db/id #edb/ref 17592186052588} {:answer/id #uuid "cb02607b-48b8-53a9-a393-5b8fbbee4477" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\mid \\frac{4z}{7} \\mid" :db/id #edb/ref 17592186052589} {:answer/id #uuid "d142f5ba-154b-56fb-9467-6cd7d567fac7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{7}" :db/id #edb/ref 17592186052590} {:answer/id #uuid "f2a0bb7f-6725-5716-9884-451aa0ef924e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\mid \\frac{4z}{7} \\mid" :db/id #edb/ref 17592186052591} {:answer/id #uuid "170e054d-b4cf-530d-a481-a382db332a8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{7}" :db/id #edb/ref 17592186052592}] :answer-field/id #uuid "44b6d324-45aa-5a83-beb2-130bf4e15f20" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186052587}] :question/id #uuid "93131466-fa61-511d-92d7-124bf55dab82" :question/math-a