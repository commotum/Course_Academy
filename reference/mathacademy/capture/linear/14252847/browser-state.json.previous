  "live_records": {
    "q-32654": {
      "dom_id": "step-q32654",
      "name": "Question 1",
      "problem": "A sphere has a diameter of $8\\sqrt{3}\\,\\text{mm}.$ Find the surface area of the sphere.",
      "worked_solution": "We can calculate the surface area of a sphere using the formula\n\n$$\nS=4\\pi {r}^{2},\n$$\n\nwhere $r$ is the radius of the sphere.\n\nSubstituting $r=\\frac{8\\sqrt{3}}{2}=4\\sqrt{3}\\,\\text{mm}$ into the formula, we obtain\n\n$$\nS=4\\pi {(4\\sqrt{3})}^{2}=192\\pi \\,{\\text{mm}}^{2}.\n$$",
      "calculator_instructions": "",
