#{[{:db/id #edb/ref 17592186175763 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186175896 :knowledge-point/id #uuid "c1941876-94d1-52d5-9104-7875de691ca0" :knowledge-point/title "Identifying Parts of a Circle"}] :question/id #uuid "2c4c8545-1b0a-519d-95b5-55c1da11b443" :question/math-academy-id "e-3169" :question/problem "Which elements of a circle are depicted below?\n\n![](images/70/7032918db2c75bcf0c0ebad952f617b54523311095529f7ee5ca90714d9b4d90.png)" :question/worked-solution "Here, we have the following:\n\n- a circular segment which is enclosed between the chord $\\overline{CD}$ and the corresponding arc $\\overset{\\frown}{CD},$\n\n- a circular sector $OAC,$ which is formed by the two radii $\\overline{OA}$ and $\\overline{OC}$ and the corresponding arc $\\overset{\\frown}{AC},$ and\n\n- an arc $\\overset{\\frown}{AB}.$"}] [{:db/id #edb/ref 17592186175764 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186175897 :knowledge-point/id #uuid "938c4422-a8ae-56c4-b728-31776db43653" :knowledge-point/title "Completing a True Statement Regarding Circles"}] :question/id #uuid "11cc1b43-3faf-5687-aca8-12c3e60befca" :question/math-academy-id "e-3170" :question/problem "What should be substituted into the blank spaces in the following sentence to make it a true statement?\n\n\"*If $A$ and $B$ are two points on a circle, then $\\overline{AB}$ is a $\\textrm{_________}$ of the circle. Additionally, if we consider the region bounded by $\\overline{AB}$ and the corresponding arc $\\overset{\\frown}{AB},$ then we obtain a circular $\\textrm{_________}.$*\"" :question/worked-solution "First, $\\overline{AB}$ is a line segment whose endpoints lie on a circle. So, $\\overline{AB}$ is a *chord* of the circle. \n\nThe region enclosed between $\\overline{AB}$ and the corresponding arc $\\overset{\\frown}{AB}$ is a circular *segment*. \n\nTherefore, the correct mathematical statement is the following:\n\n\"*If $A$ and $B$ are two points on a circle, then $\\overline{AB}$ is a **chord** of the circle. Additionally, if we consider the region bounded by $\\overline{AB}$ and the corresponding arc $\\overset{\\frown}{AB},$ then we obtain a circular **segment**.*\""}] [{:db/id #edb/ref 17592186504675 :knowledge-point/_questions [{:db/id #edb/ref 17592186175896 :knowledge-point/id #uuid "c1941876-94d1-52d5-9104-7875de691ca0" :knowledge-point/title "Identifying Parts of a Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47a97a76-581f-599b-9035-33f1e56fc3bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The chord $\\overset{―}{JK}$" :db/id #edb/ref 17592186504162} {:answer/id #uuid "60c90d0c-d5c1-5b67-a7cf-65deae0c245d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circular segment $JK$" :db/id #edb/ref 17592186504200} {:answer/id #uuid "6371cc8f-a675-5102-8f66-069a62553803" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circular sector $JK$" :db/id #edb/ref 17592186504204} {:answer/id #uuid "93915c36-d59c-54f8-b6e0-8cbb18f48fa6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The diameter $\\overset{―}{JK}$" :db/id #edb/ref 17592186504293} {:answer/id #uuid "ae292671-61e3-5b7c-a43d-8e16c06f17e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The radius $\\overset{―}{JK}$" :db/id #edb/ref 17592186504331}] :answer-field/correct {:answer/id #uuid "47a97a76-581f-599b-9035-33f1e56fc3bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The chord $\\overset{―}{JK}$" :db/id #edb/ref 17592186504162} :answer-field/id #uuid "5a1f2a6b-9837-578c-87bc-efad8ccc7ba9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504516}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c18974ec-97d7-5314-ad7a-0d98ada7186c" :question/math-academy-id "q-102522" :question/problem "![](images/1d/1dc519a8face19a4950e85b698e61e19f2a9f6d9e4ca8ecb3744707c43d4b7d3.png)\n\nWhat element of the circle is depicted in the diagram above?" :question/worked-solution "We can see that $\\overset{―}{JK}$ is a line segment whose endpoints lie on the circle. So, $\\overset{―}{JK}$ is a chord. It is not a diameter since the line segment does not pass through the center of the circle."}] [{:db/id #edb/ref 17592186504636 :knowledge-point/_questions [{:db/id #edb/ref 17592186175897 :knowledge-point/id #uuid "938c4422-a8ae-56c4-b728-31776db43653" :knowledge-point/title "Completing a True Statement Regarding Circles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16644017-bcaf-5f39-8e3f-40eaf9d3a975" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "points, chord $\\overset{―}{AB}$" :db/id #edb/ref 17592186504071} {:answer/id #uuid "38068622-8f49-5908-8f35-9c8e2253f32e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "chord, diameter $\\overset{―}{AB}$" :db/id #edb/ref 17592186504129} {:answer/id #uuid "3c63225b-db47-56ca-9e29-7552481e0ba5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "radii, chord $\\overset{―}{AB}$" :db/id #edb/ref 17592186504137} {:answer/id #uuid "57cc9e42-eced-5624-a575-d6beae36f7da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "diameters, arc $\\overset{⌢}{AB}$" :db/id #edb/ref 17592186504184} {:answer/id #uuid "f48c0198-f181-53cc-b49d-2db415a27a32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "points, arc $\\overset{⌢}{AB}$" :db/id #edb/ref 17592186504457}] :answer-field/correct {:answer/id #uuid "f48c0198-f181-53cc-b49d-2db415a27a32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "points, arc $\\overset{⌢}{AB}$" :db/id #edb/ref 17592186504457} :answer-field/id #uuid "4a604be8-3cd0-5b4e-9e30-4c6b6f4c6eb9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504509}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6239281f-6d61-5307-bb65-95e4ae171b6c" :question/math-academy-id "q-102526" :question/problem "What should be substituted into the blank spaces in the following sentence to make it a true statement?\n\n\"*If $A$ and $B$ are two $\\text{_________}$ on a circle, then the $\\text{_________}$ is the part of the circle which is enclosed between $A$ and $B.$*\"" :question/worked-solution "If $A$ and $B$ are two points on a circle, then the part of the circle which is enclosed between $A$ and $B$ is the *arc $\\overset{⌢}{AB}.$*\n\nTherefore, the correct mathematical statement is the following:\n\n\"*If $A$ and $B$ are two **points** on a circle, then the **arc $\\overset{⌢}{AB}$** is the part of the circle which is enclosed between $A$ and $B.$*\""}] [{:db/id #edb/ref 17592186504650 :knowledge-point/_questions [{:db/id #edb/ref 17592186175896 :knowledge-point/id #uuid "c1941876-94d1-52d5-9104-7875de691ca0" :knowledge-point/title "Identifying Parts of a Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "253bf0df-6664-5141-ad84-0d0e2a170f9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circular sector $AB$" :db/id #edb/ref 17592186504099} {:answer/id #uuid "4f53c5af-2aeb-5d83-a4c8-5834b0bffcb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The radius $\\overset{―}{AB}$" :db/id #edb/ref 17592186504175} {:answer/id #uuid "9e4dbf03-2d9c-5ca5-b9bc-e8a2d8d5c94e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.t