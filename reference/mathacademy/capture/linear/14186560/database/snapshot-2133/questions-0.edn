db/ref 17592186504152} {:answer/id #uuid "5e852063-56ce-5bf6-a702-0fe8b02250a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "radius, segment" :db/id #edb/ref 17592186504197} {:answer/id #uuid "748f8cc6-0afc-576f-b969-dda7eebfed40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "an arc, segment" :db/id #edb/ref 17592186504231} {:answer/id #uuid "921e9bf6-90e8-51eb-8dac-0e8a3e636e74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "radius, sector" :db/id #edb/ref 17592186504290} {:answer/id #uuid "c94e2a2f-5899-5ab9-a537-eb38a53c3327" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "an arc, sector" :db/id #edb/ref 17592186504371}] :answer-field/correct {:answer/id #uuid "435f0098-0ca8-53cd-81da-04695fc219cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a diameter, segment" :db/id #edb/ref 17592186504152} :answer-field/id #uuid "5a48e581-8a2a-5b17-a4f9-c421cdd44579" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504517}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b78166bd-7c7a-5280-b285-d24358ee444d" :question/math-academy-id "q-74690" :question/problem "What should be substituted into the blank spaces in the following sentence to make it a true statement?\n\n\"*If $A$ and $B$ are two points on a circle and $O$ is the circle's center, then $\\overset{―}{AB},$ which passes through $O,$ is $\\text{_________}$ of the circle. Additionally, if we consider the region bounded by $\\overset{―}{AB}$ and the corresponding arc $\\overset{⌢}{AB},$ then we obtain a circular $\\text{_________}.$*\"" :question/worked-solution "First, $\\overset{―}{AB}$ is a line segment that connects points on the circle and passes through the circle's center. So, $\\overset{―}{AB}$ is *a diameter* of the circle. \n\nThe region enclosed between $\\overset{―}{AB}$ and the corresponding arc $\\overset{⌢}{AB}$ is a circular *segment*.\n\nTherefore, the correct mathematical statement is the following:\n\n\"*If $A$ and $B$ are two points on a circle and $O$ is the circle's center, then $\\overset{―}{AB},$ which passes through $O,$ is **a diameter** of the circle. Additionally, if we consider the region bounded by $\\overset{―}{AB}$ and the corresponding arc $\\overset{⌢}{AB},$ then we obtain a circular **segment**.*\""}]}
