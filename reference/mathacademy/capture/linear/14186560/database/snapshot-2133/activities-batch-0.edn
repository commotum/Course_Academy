#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186176598} :activity/id #uuid "ec9d4c2b-1a22-5786-bdab-76e3e5ac092b" :activity/scope {:db/id #edb/ref 17592186049135 :topic/id #uuid "dd916270-3c49-5d1a-a09d-9c318a1004ba" :topic/math-academy-id 3565} :activity/steps [{:db/id #edb/ref 17592186176598 :step/content {:db/id #edb/ref 17592186176967 :tutorial/content "Let's consider yet more important parts of a circle:\n\n- The **circumference** of a circle is used to describe the perimeter of the circle, as shown in the left diagram below.\n\n- An **arc** is a part of the circumference which is enclosed between two points on a circle. In the right diagram below, we have the arc $\\overset{\\frown}{AB}.$\n\n![](images/5c/5c918b32007a68beecfdef486e9cd5d0818a2122ad672415608f761f7f7953e7.png)\n\nIf an arc is denoted using only two letters, we are referring to the *shortest* arc. However, to avoid ambiguity, we can use three letters. For example, in the diagram below, $\\overset{\\frown}{ACB}$ is the arc to the left and $\\overset{\\frown}{ADB}$ is the arc to the right.\n\n![](images/f6/f6329cc70c467e968628d2d82a0839253ee443881371893d6d7721724e9ae02a.png)" :tutorial/id #uuid "8e47b911-fb88-5251-8c9f-e05a36b02014" :tutorial/math-academy-id 2419 :tutorial/title "Introduction"} :step/id #uuid "25d2b401-6584-5b07-9e4c-0c4734e5d10a" :step/math-academy-id 10841 :step/next {:db/id #edb/ref 17592186176670}} {:db/id #edb/ref 17592186176599 :step/content {:db/id #edb/ref 17592186175896 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175763 :question/id #uuid "2c4c8545-1b0a-519d-95b5-55c1da11b443" :question/math-academy-id "e-3169"} :knowledge-point/id #uuid "c1941876-94d1-52d5-9104-7875de691ca0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049856}] :knowledge-point/questions [{:db/id #edb/ref 17592186176521} {:db/id #edb/ref 17592186176522} {:db/id #edb/ref 17592186504650} {:db/id #edb/ref 17592186504675}] :knowledge-point/title "Identifying Parts of a Circle"} :step/id #uuid "9822102f-f61a-5ba7-a66f-4d48d24c1c3e" :step/math-academy-id 10842 :step/next {:db/id #edb/ref 17592186176600}} {:db/id #edb/ref 17592186176600 :step/content {:db/id #edb/ref 17592186175897 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175764 :question/id #uuid "11cc1b43-3faf-5687-aca8-12c3e60befca" :question/math-academy-id "e-3170"} :knowledge-point/id #uuid "938c4422-a8ae-56c4-b728-31776db43653" :knowledge-point/questions [{:db/id #edb/ref 17592186176520} {:db/id #edb/ref 17592186176523} {:db/id #edb/ref 17592186504636} {:db/id #edb/ref 17592186504670}] :knowledge-point/title "Completing a True Statement Regarding Circles"} :step/id #uuid "86752c7b-de72-5f68-969c-03022173a2d1" :step/math-academy-id 10843} {:db/id #edb/ref 17592186176670 :step/content {:db/id #edb/ref 17592186176974 :tutorial/content "Finally, we have two more elements of a circle to remember:\n\n- A **circular sector** is the region bounded by an arc of the circle and two radii which connect the center of the circle with the endpoints of the arc. In the left diagram below, we have the circular sector $OCD.$\n\n- A **circular segment** is the region bounded by an arc of the circle and the chord that connects the endpoints of the arc. In the right diagram below, we have the circular segment $PQ.$\n\n![](images/84/848e64be2b80b78d88da42473f6778d4012f7ec52ae6950f4ca3635b5b154ca6.png)" :tutorial/id #uuid "3f8e3ddf-673b-5e4a-9d61-f8a2c682ee36" :tutorial/math-academy-id 3986 :tutorial/title "Circular Segments and Sectors"} :step/id #uuid "6b12863c-3e31-50e4-b812-6ce26cac6267" :step/math-academy-id 23718 :step/next {:db/id #edb/ref 17592186176599}}] :activity/title "Arcs, Segments, and Sectors of Circles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186176115}]}
