139534273 17592186045417 true] [17592186416945 1075 #edb/ref 17592186416935 13194139534273 17592186045417 true] [17592186416945 1075 #edb/ref 17592186416938 13194139534273 17592186045417 true] [17592186416945 1075 #edb/ref 17592186416939 13194139534273 17592186045417 true] [17592186416945 1075 #edb/ref 17592186416941 13194139534273 17592186045417 true] [17592186416945 1076 #edb/ref 17592186045493 13194139534273 17592186045417 true] [17592186416945 1077 "selection" 13194139534273 17592186045417 true] [17592186416945 1078 #edb/ref 17592186416935 13194139534273 17592186045417 true] [17592186416945 1079 #uuid "c652bfa5-8e6a-53fc-ad6f-da352c6f194d" 13194139534273 17592186045417 true] [17592186416946 1068 #edb/ref 17592186416944 13194139534273 17592186045417 true] [17592186416946 1069 "q-35247" 13194139534273 17592186045417 true] [17592186416946 1070 #edb/ref 17592186045487 13194139534273 17592186045417 true] [17592186416946 1071 "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2}},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}3 \\\\ 9 \\\\ -12\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}-4 \\\\ -8 \\\\ 16\\end{aligned}],\\,x=[\\begin{aligned}-8 \\\\ -4 \\\\ 32\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}?$" 13194139534273 17592186045417 true] [17592186416946 1072 #uuid "1098aac8-90b3-5ba0-b447-7ead2947d568" 13194139534273 17592186045417 true] [17592186416946 1074 "We need to find ${x}_{1}$ and ${x}_{2}$ such that  \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}[\\begin{aligned}3 \\\\ 9 \\\\ -12\\end{aligned}]+{x}_{2}[\\begin{aligned}-4 \\\\ -8 \\\\ 16\\end{aligned}] & =[\\begin{aligned}-8 \\\\ -4 \\\\ 32\\end{aligned}].\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix \n\n$$\nM=[\\begin{aligned}3 & -4 & -8 \\\\ 9 & -8 & -4 \\\\ -12 & 16 & 32\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}3 & -4 & -8 \\\\ 9 & -8 & -4 \\\\ -12 & 16 & 32\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}3 & -4 & -8 \\\\ 0 & 4 & 20 \\\\ -12 & 16 & 32\\end{aligned}] & {R}_{3} & :={R}_{3}+4{R}_{1} \\\\  & ∼[\\begin{aligned}3 & -4 & -8 \\\\ 0 & 4 & 20 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\n \n\nThe system is now \n\n$$\n{\\begin{aligned}3{x}_{1}-4{x}_{2}=-8 \\\\ 4{x}_{2}=20.\\end{aligned}\n$$\n\nFrom the second equation, we get ${x}_{2}=5.$ Substituting this into the first equation, we obtain\n\n$$\n3{x}_{1}-4(5)=-8\\,⟹\\,{x}_{1}=4.\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}4 \\\\ 5\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=4+5=9.$" 13194139534273 17592186045417 true] [17592186416947 1058 #edb/ref 17592186416948 13194139534273 17592186045417 true] [17592186416947 1062 #uuid "52d64f85-27e5-5e6b-8c92-f165572fe095" 13194139534273 17592186045417 true] [17592186416947 1063 #edb/ref 17592186416946 13194139534273 17592186045417 true] [17592186416948 1058 #edb/ref 17592186416949 13194139534273 17592186045417 true] [17592186416948 1062 #uuid "598de137-99ae-5ba2-ac49-2dd82ea7ee2f" 13194139534273 17592186045417 true] [17592186416948 1063 #edb/ref 17592186120525 13194139534273 17592186045417 true] [17592186416949 1062 #uuid "6074dbdf-0c2f-509e-aa43-e4c385bf7861" 13194139534273 17592186045417 true] [17592186416949 1063 #edb/ref 17592186409821 13194139534273 17592186045417 true]] :edb/tempids {"activity-e9bd4727-090c-5259-8cb9-53f91a718d53" 17592186416933 "answer-04f5fc79-efcf-5beb-8f44-6c5bbee2e205" 17592186416934 "answer-460c227b-da50-5240-a61b-5d7158cbefb0" 17592186416935 "answer-54b2da92-80e1-5a61-a19c-e0402c5db36e" 17592186416936 "answer-94ec8a9d-591d-59ec-b9c5-a655500ebc04" 17592186416937 "answer-b96e7099-61f5-552d-a37f-75ea4d0acd7b" 17592186416938 "answer-c28d8b2c-0794-5b52-be1a-1a5068c24206" 17592186416939 "answer-c791cf81-feb5-59a1-bf25-b0be74c138f2" 175921