#{[{:db/id #edb/ref 17592186120525 :knowledge-point/_questions [{:db/id #edb/ref 17592186119859 :knowledge-point/id #uuid "a2926764-dfbc-5e4e-a6b0-db24a7298a64" :knowledge-point/title "Finding the Coordinates of a Vector Relative To a Given Basis by Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3ca5f46-8807-5e68-b234-462add3c3ca4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186119265} {:answer/id #uuid "bcf23dec-f656-525f-8ac1-999d3f3e089d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186119266} {:answer/id #uuid "3300d5da-1fd2-58ac-bc3e-1a35878af185" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186119267} {:answer/id #uuid "4315f280-056b-5a73-9fd6-b3c5c1347110" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x ∉ Span{b_{1}, b_{2}}" :db/id #edb/ref 17592186119268} {:answer/id #uuid "6dea3717-2bda-584d-bfd9-5854be0e2d0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186119269}] :answer-field/id #uuid "1ebb6232-1974-573d-9edf-e54f519d8e6b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186119264}] :question/id #uuid "93dd069a-4710-5057-b8fe-736d3ab4c0dc" :question/math-academy-id "q-75844" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B = {b_{1}, b_{2}}$, where\n$b_{1} = \\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}, b_{2} = \\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}, x = \\begin{bmatrix}0 \\\\ -4 \\\\ 2\\end{bmatrix}$.\nIf $[x]_{B} = \\begin{bmatrix}x_{1} \\\\ x_{2}\\end{bmatrix}$ then what is the value of $x_{2}$?"}] [{:db/id #edb/ref 17592186409821 :knowledge-point/_questions [{:db/id #edb/ref 17592186119822 :knowledge-point/id #uuid "ed6a6ea8-6100-5224-b75f-b87c037fafbb" :knowledge-point/title "Finding the Coordinates of a Vector Relative To a Given Basis Containing More Than Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0470cd3b-2bcb-575e-9def-d43004406207" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186409787} {:answer/id #uuid "a3e208c3-ba1a-51ec-b367-c2784fabe06c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186409800} {:answer/id #uuid "a5ba42a7-b00b-5980-9f89-48160c1eb49e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\notin \\text{Span}{{b}_{1},{b}_{2},{b}_{3}}" :db/id #edb/ref 17592186409801} {:answer/id #uuid "d13c159c-f442-5933-a821-d94880c3ba32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186409806} {:answer/id #uuid "eec553dd-6fd7-5208-9292-850213e9c19b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186409809}] :answer-field/correct {:answer/id #uuid "a5ba42a7-b00b-5980-9f89-48160c1eb49e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\notin \\text{Span}{{b}_{1},{b}_{2},{b}_{3}}" :db/id #edb/ref 17592186409801} :answer-field/id #uuid "a79bee7d-12b6-5017-ae13-ca00a861bd24" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186409812}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ec45397c-5ced-5a47-b9a9-86c6aa1d1bf3" :question/math-academy-id "q-76073" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2},{b}_{3}},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 0 \\\\ 0\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}-1 \\\\ 0 \\\\ 1 \\\\ 0\\end{aligned}],\\,{b}_{3}=[\\begin{aligned}0 \\\\ -1 \\\\ 1 \\\\ 0\\end{aligned}],\\,x=[\\begin{aligned}5 \\\\ -5 \\\\ 5 \\\\ 0\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "We need to find ${x}_{1}$,  ${x}_{2}$, and ${x}_{3}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3} & =x \\\\ {x}_{1}[\\begin{aligned}1 \\\\ -1 \\\\ 0 \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}-1 \\\\ 0 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{3}[\\begin{aligned}0 \\\\ -1 \\\\ 1 \\\\ 0\\end{aligned}] & =[\\begin{aligned}5 \\\\ -5 \\\\ 5 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nFrom this, we get the system with the augmented matrix $M$, which we reduce using Gaussian elimination:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}1 & -1 & 0 & 5 \\\\ -1 & 0 & -1 & -5 \\\\ 0 & 1 & 1 & 5 \\\\ 0 & 0 & 0 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\ ∼ & [\\begin{aligned}1 & -1 & 0 & 5 \\\\ 0 & -1 & -1 & 0 \\\\ 0 & 1 & 1 & 5 \\\\ 0 & 0 & 0 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{2} \\\\ ∼ & [\\begin{aligned}1 & -1 & 0 & 5 \\\\ 0 & -1 & -1 & 0 \\\\ 0 & 0 & 0 & 5 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}\\,\\,{x}_{1}-{x}_{2}=5 \\\\ \\,\\,-{x}_{2}-{x}_{3}=0 \\\\ \\,\\,0=5,\\end{aligned}\n$$\n\nwhere the third equation is always false. Therefore, the system has no solution and we conclude that \n\n$$\nx\\notin \\text{Span}{{b}_{1},{b}_{2},{b}_{3}}.\n$$"}]}
