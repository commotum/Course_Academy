[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186083312 :knowledge-point/questions ["question-31fc7ad4-02c1-5d63-bb54-860ef7ba25ac"] :db/ensure [:knowledge-point/validate]} {:db/id "question-31fc7ad4-02c1-5d63-bb54-860ef7ba25ac" :question/id #uuid "31fc7ad4-02c1-5d63-bb54-860ef7ba25ac" :question/math-academy-id "q-1802" :question/problem "Evaluate $(\\genfrac{}{}{0pt}{}{7}{3}).$" :question/worked-solution "First, note that $(\\genfrac{}{}{0pt}{}{7}{3})$ means the same thing as ${}_{7}{C}_{3}.$\n\n In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nSubstituting $n=7$ and $r=3,$ we get\n\n$$\n\\begin{aligned}{}_{7}{C}_{3} & =\\frac{7!}{(7-3)!3!} \\\\  & =\\frac{7!}{4!3!} \\\\  & =\\frac{7\\cdot 6\\cdot 5\\cdot \\cancel{4!}}{\\cancel{4!}3!} \\\\  & =\\frac{7\\cdot 6\\cdot 5}{6} \\\\  & =35.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b1a5a15e-ede3-5556-ae58-86c4c81f9d96"] :db/ensure [:question/validate]} {:db/id "answer-field-b1a5a15e-ede3-5556-ae58-86c4c81f9d96" :answer-field/id #uuid "b1a5a15e-ede3-5556-ae58-86c4c81f9d96" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ddae95b6-690f-5af4-a9a8-b1a950ef1aa3" :answer-field/choices ["answer-05bc4eb8-604f-53ae-8cad-cebb805ad20d" "answer-65546efd-9ca8-5f2d-8c2c-136dd631ea88" "answer-28eaf4dc-a8b0-5796-9977-06739a824eef" "answer-ddae95b6-690f-5af4-a9a8-b1a950ef1aa3" "answer-a49f8fb6-757b-5132-94c8-92eac2ab0522"] :db/ensure [:answer-field/validate]} {:db/id "answer-05bc4eb8-604f-53ae-8cad-cebb805ad20d" :answer/id #uuid "05bc4eb8-604f-53ae-8cad-cebb805ad20d" :answer/type :answer.type/math :answer/value "110" :db/ensure [:answer/validate]} {:db/id "answer-65546efd-9ca8-5f2d-8c2c-136dd631ea88" :answer/id #uuid "65546efd-9ca8-5f2d-8c2c-136dd631ea88" :answer/type :answer.type/math :answer/value "180" :db/ensur