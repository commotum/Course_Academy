db/ref 17592186332935 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0177b576-9c1a-5533-9287-c726cee659b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "267\\,500\\,020" :db/id #edb/ref 17592186329970} {:answer/id #uuid "79e9357c-b9f1-5022-907e-3efa1936a58a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "70\\,992\\,003\\,600" :db/id #edb/ref 17592186331029} {:answer/id #uuid "a785008a-1f78-52bb-aa02-3dc1b245839d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "560\\,040" :db/id #edb/ref 17592186331444} {:answer/id #uuid "bc963eef-3c6d-5737-a4c8-2f6273d10c6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "591\\,600\\,030" :db/id #edb/ref 17592186331614} {:answer/id #uuid "bef04870-fd13-5df0-976f-207dcb728dcd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "120" :db/id #edb/ref 17592186331642}] :answer-field/correct {:db/id #edb/ref 17592186331614} :answer-field/id #uuid "f6324b5c-3a2c-5e03-8c69-3fb5045a9e45" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186332633}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6067c274-d28c-560e-a67a-4fd6b1a32c78" :question/math-academy-id "q-5568" :question/problem "Toria's friend holds a barrel of $150$ marbles in front of her, each with a slightly different size or color.  If she reaches in and grabs five of them, how many different groups of five marbles can Toria select?" :question/worked-solution "In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nThere are $150$ marbles, so $n=150.$ We want to select $5$ of those marbles from the bag, so we have $r=5.$\n\nTherefore, the number of different potential groups of five marbles is\n\n$$\n\\begin{aligned}{}_{150}{C}_{5} & =\\frac{150!}{(150-5)!\\,5!} \\\\  & =\\frac{150!}{145!5!} \\\\  & =\\frac{150\\cdot 149\\cdot 148\\cdot 147\\cdot 146\\cdot \\cancel{145!}}{\\cancel{145!}5!} \\\\  & =\\frac{150\\cdot 149\\cdot 148\\cdot 147\\cdot 146}{5\\cdot 4\\cdot 3\\cdot 2\\cdot 1} \\\\  & =591\\,600\\,030.\\end{aligned}\n$$"} :step/id #uuid "4e72fa17-5558-5e4e-ace4-52051946e318" :step/next {:db/id #edb/ref 17592186551456}} {:db/id #edb/ref 17592186551456 :step/content {:db/id #edb/ref 17592186354383 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07778880-6884-5df1-920d-a0903f8fad7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50" :db/id #edb/ref 17592186351632} {:answer/id #uuid "1e3602cb-fb01-54b4-a56e-4c4bc807b24a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "75" :db/id #edb/ref 17592186351834} {:answer/id #uuid "2f3521c0-963a-5660-8b69-4603b9221292" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186352001} {:answer/id #uuid "67a88906-e9ab-5952-b073-0696685cd6a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186352491} {:answer/id #uuid "bce37b2e-420c-51d7-b2f3-a8accac564bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186353176}] :answer-field/correct {:db/id #edb/ref 17592186352001} :answer-field/id #uuid "c64ac77f-40d7-5415-9e91-84ce983b17d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186354155}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e1b1d463-34ec-526e-825f-fea323344b88" :question/math-academy-id "q-84993" :question/problem "Evaluate $(\\genfrac{}{}{0pt}{}{25}{0}).$" :question/worked-solution "First, note that $(\\genfrac{}{}{0pt}{}{25}{0})$ means the same thing as ${}_{25}{C}_{0}.$\n\n In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nSubstituting $n=25$ and $r=0,$ we get\n\n$$\n\\begin{aligned}{}_{25}{C}_{0} & =\\frac{25!}{(25-0)!0!} \\\\  & =\\frac{25!}{25!0!} \\\\  & =\\frac{\\cancel{25!}}{\\cancel{25!}\\cdot 1} \\\\  & =1.\\end{aligned}\n$$"} :step/id #uuid "dffa73c5-7ead-5048-bee5-5764f9977efe"}] :activity/title "Combinations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186550359}]}
