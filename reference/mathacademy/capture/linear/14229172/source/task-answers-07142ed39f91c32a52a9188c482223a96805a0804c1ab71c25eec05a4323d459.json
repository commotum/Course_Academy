rt{3} - 4} {2} &=\\\\[5pt]\n\t\\dfrac {2(\\sqrt{3} - 2)} {2} &=\\\\[5pt]\n\t\\sqrt{3} - 2\n\\end{align*}</p>\n","topic":{"id":86,"name":"Rationalizing Denominators With Two Terms"},"example":{"id":18932,"title":"Rationalizing Denominators Containing Surds in the Numerator and Denominator"},"group":{"id":48688,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14229172,"answer":{"id":62203008,"cread":"2026-10-15T06:10:17.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":12901},"graphic":false,"difficultyClass":"difficultyEasy","difficultySymbol":"E","rendered":true,"testMode":false}},{"id":62203030,"created":"2026-10-15T06:10:34.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":12823,"number":3,"createdStr":"Thu, Oct 15th @ 6:10 AM","timeElapsedFormatted":"0:13","question":{"id":293483,"format":"MC","difficulty":1,"exampleId":18931,"text":"<p>Rationalize the denominator of $\\dfrac{1}{\\sqrt{7} + \\sqrt{3}}.$</p>\n","choice1":"$\\dfrac{\\sqrt{7} - \\sqrt{3}}{4}$","choice2":"$\\sqrt{3} - \\sqrt{4}$","choice3":"$\\dfrac{\\sqrt{7} - \\sqrt{3}}{3}$","choice4":"$\\sqrt{7} - \\sqrt{3}$","choice5":"$\\dfrac{1}{\\sqrt{7} + \\sqrt{3}}$","freeAnswerChoice":" ","explanation":"<p>First, note that the denominator&#39;s conjugate is $\\sqrt{7} - \\sqrt{3}.$</p>\n<p>Now, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{7} - \\sqrt{3},$ and simplify:\n\\begin{align}\n\\dfrac{1}{\\sqrt{7} + \\sqrt{3}} & = \\\\[5pt]\n\n\\dfrac{1}{\\sqrt{7} + \\sqrt{3}} \\cdot \\dfrac{\\sqrt{7} - \\sqrt{3}}{\\sqrt{7} - \\sqrt{3}} & = \\\\[5pt]\n\n\\dfrac{1(\\sqrt{7} - \\sqrt{3})}{(\\sqrt{7} + \\sqrt{3})(\\sqrt{7} - \\sqrt{3})} & = \\\\[5pt]\n \n\\dfrac{\\sqrt{7} - \\sqrt{3}}{(\\sqrt{7})^2 - (\\sqrt{3})^2} & = \\\\[5pt]\n\n\\dfrac{\\sqrt{7} - \\sqrt{3}}{7 - 3} &= \\\\[5pt]\n\n\\dfrac{\\sqrt{7} - \\sqrt{3}}{4}\n\\end{align}</p>\n","topic":{"id"