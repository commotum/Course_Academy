#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186055764} :activity/id #uuid "87315fc7-165f-5b3e-a832-348934ea724d" :activity/scope {:db/id #edb/ref 17592186048229 :topic/id #uuid "8a462f76-1e1a-5c54-833e-8d3d6162407f" :topic/math-academy-id 86} :activity/steps [{:db/id #edb/ref 17592186055764 :step/content {:db/id #edb/ref 17592186055933 :tutorial/content "When simplifying numerical expressions, it is generally preferable to avoid having radicals in the denominator. In cases where we wish to remove a radical from a denominator, we must **rationalize the denominator**.\n\nIf the denominator of an expression consists of two terms and includes one or more radicals, we rationalize it by multiplying both the numerator and the denominator by the **conjugate** of the denominator. \n\nTo illustrate, consider the following expression:\n\n$$\n\\dfrac{1}{1+\\sqrt{2}}\n$$\n\n \n\nTo find the conjugate of the denominator $1+\\sqrt{2},$ we *flip the sign* between the two terms. So, the conjugate of the denominator is \n\n$$\n1\\,{\\color{blue}{-}}\\,\\sqrt{2}.\n$$\n\nNow, to rationalize the denominator, we start by multiplying both the numerator and denominator by the conjugate $1-\\sqrt{2},$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{1+\\sqrt{2}} & = \\\\ \\frac{1}{1+\\sqrt{2}}\\cdot \\frac{1-\\sqrt{2}}{1-\\sqrt{2}} & = \\\\ \\frac{1\\cdot (1-\\sqrt{2})}{(1+\\sqrt{2})(1-\\sqrt{2})} &  \\\\ \\frac{1-\\sqrt{2}}{(1+\\sqrt{2})(1-\\sqrt{2})} & \\end{aligned}\n$$\n\nNow, we recall the difference of squares formula:\n\n$$\n(a+b)(a-b) = a^2 - b^2\n$$\n\nApplying the difference of squares formula with $a=1, b=\\sqrt 2$ to simplify the denominator, we get\n\n$$\n\\begin{aligned}\\frac{1-\\sqrt{2}}{(1+\\sqrt{2})(1-\\sqrt{2})} & = \\\\ \\frac{1-\\sqrt{2}}{{1}^{2}-(\\sqrt{2})^{2}} & = \\\\ \\frac{1-\\sqrt{2}}{1-2} & = \\\\ \\frac{1-\\sqrt{2}}{-1} & = \\\\ \\sqrt{2}-1.\\end{aligned}\n$$" :tutorial/id #uuid "2b34f4d4-8931-5c24-8872-dfa9420a1a87" :tutorial/math-academy-id 13463 :tutorial/title "Introduction"} :step/id #uuid "57ebf44f-ed04-5203-ae79-eb57faf1422c" :step/math-academy-id 478487 :step/next {:db/id #edb/ref 17592186055765}} {:db/id #edb/ref 17592186055765 :step/content {:db/id #edb/ref 17592186054757 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054500 :question/id #uuid "04b471e2-edcd-5f01-8677-e93ddc547a0e" :question/math-academy-id "e-18927"} :knowledge-point/id #uuid "be393dbe-03cc-5259-ba28-8f865537c57a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048702} {:db/id #edb/ref 17592186049943}] :knowledge-point/questions [{:db/id #edb/ref 17592186055281} {:db/id #edb/ref 17592186055282} {:db/id #edb/ref 17592186515542} {:db/id #edb/ref 17592186515603}] :knowledge-point/title "Rationalizing Denominators Containing Two Terms"} :step/id #uuid "dced9096-a47b-5cd3-80ff-98a83b2d683d" :step/math-academy-id 478488 :step/next {:db/id #edb/ref 17592186055766}} {:db/id #edb/ref 17592186055766 :step/content {:db/id #edb/ref 17592186054758 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054501 :question/id #uuid "0e811568-769f-5e18-9c6c-5594c18330b5" :question/math-academy-id "e-18931"} :knowledge-point/id #uuid "eae5693c-a37e-58f4-8793-0875ef8e0fb8" :knowledge-point/questions [{:db/id #edb/ref 17592186054959} {:db/id #edb/ref 17592186054960} {:db/id #edb/ref 17592186515594} {:db/id #edb/ref 17592186515602} {:db/id #edb/ref 17592186524002} {:db/id #edb/ref 17592186524013}] :knowledge-point/title "Rationalizing Denominators Containing Two Surds"} :step/id #uuid "a083012b-d787-56bf-b5e8-8344e62d247c" :step/math-academy-id 478491 :step/next {:db/id #edb/ref 17592186055767}} {:db/id #edb/ref 17592186055767 :step/content {:db/id #edb/ref 17592186054759 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054502 :question/id #uuid "5a664cc0-30ca-5097-9505-0755963b0f1f" :question/math-academy-id "e-18932"} :knowledge-point/id #uuid "203f17e9-3efb-5637-ac02-2c31e5a8a632" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050341} {:db/id #edb/ref 17592186050818}] :knowledge-point/questions [{:db/id #edb/ref 17592186055197} {:db/id #edb/ref 17592186055283} {:db/id #edb/ref 17592186410427} {:db/id #edb/ref 17592186515520} {:db/id #edb/ref 17592186515536} {:db/id #edb/ref 17592186515548} {:db/id #edb/ref 17592186523937}] :knowledge-point/title "Rationalizing Denominators Containing Surds in the Numerator and Denominator"} :step/id #uuid "0cf7c6e7-a7ad-5d24-84b5-68964807ce90" :step/math-academy-id 478494}] :activity/title "Rationalizing Denominators With Two Terms" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054928}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186524094} :activity/id #uuid "9e88ba5c-03cc-5d69-8081-726f2a496f58" :activity/scope {:db/id #edb/ref 17592186048229 :topic/id #uuid "8a462f76-1e1a-5c54-833e-8d3d6162407f" :topic/math-academy-id 86} :activity/steps [{:db/id #edb/ref 17592186524040 :step/content {:db/id #edb/ref 17592186523937 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67e2b9da-2fe4-50ed-9618-993678c6f082" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13+7\\sqrt{3}" :db/id #edb/ref 17592186523467} {:answer/id #uuid "aee4d997-8d2a-5a0e-a121-4be10b52b8ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{13-7\\sqrt{3}}{2}" :db/id #edb/ref 17592186523622} {:answer/id #uuid "b9738106-7d51-517a-9063-bdcf4305298b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13-\\sqrt{3}" :db/id #edb/ref 17592186523644} {:answer/id #uuid "bdc89454-7d65-556b-8f4a-f7322dc15d57" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{13-7\\sqrt{3}}{4}" :db/id #edb/ref 17592186523649} {:answer/id #uuid "bf310402-50e8-58d7-9dfe-6bd390350eee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13-7\\sqrt{3}" :db/id #edb/ref 17592186523656}] :answer-field/correct {:db/id #edb/ref 17592186523656} :answer-field/id #uuid "19de62f6-8bdc-5e1a-9324-111045c1341c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186523804}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1f231ab0-36cf-59c7-86c7-11a5d98e603e" :question/math-academy-id "q-293702" :question/problem "Rationalize the denominator of $\\frac{5-\\sqrt{3}}{\\sqrt{3}+2}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{3}-2.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{3}-2,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{5-\\sqrt{3}}{\\sqrt{3}+2} & = \\\\ \\frac{5-\\sqrt{3}}{\\sqrt{3}+2}\\cdot \\frac{\\sqrt{3}-2}{\\sqrt{3}-2} & = \\\\ \\frac{(5-\\sqrt{3})(\\sqrt{3}-2)}{(\\sqrt{3}+2)(\\sqrt{3}-2)} & = \\\\ \\frac{5\\sqrt{3}-10-(\\sqrt{3})^{2}+2\\sqrt{3}}{(\\sqrt{3})^{2}-(2)^{2}} & = \\\\ \\frac{7\\sqrt{3}-10-3}{3-4} & = \\\\ \\frac{7\\sqrt{3}-13}{-1} & = \\\\ 13-7\\sqrt{3}\\end{aligned}\n$$"} :step/id #uuid "01296d4e-52f1-5b16-9285-4d32f1136eff"} {:db/id #edb/ref 17592186524062 :step/content {:db/id #edb/ref 17592186524002 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fd1eabe-6fb4-500f-8be1-ff96601a4dbe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4(2\\sqrt{3}+\\sqrt{6})}{3}" :db/id #edb/ref 17592186523287} {:answer/id #uuid "23024f2b-1cf3-5a6b-bdad-17fe1468934b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{(8\\sqrt{3}-\\sqrt{6})}{3}" :db/id #edb/ref 17592186523322} {:answer/id #uuid "41df7d9a-ec3e-5f59-99bb-cd2cedae5946" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4(2\\sqrt{3}-\\sqrt{6})}{3}" :db/id #edb/ref 17592186523390} {:answer/id #uuid "655338a1-a2e7-599f-a75e-c996cca2d51d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4(2\\sqrt{3}-\\sqrt{6})" :db/id #edb/ref 17592186523462} {:answer/id #uuid "8ea56f0c-6a63-55f2-a590-10edcfd3d963" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8\\sqrt{6}-6\\sqrt{6}}{3}" :db/id #edb/ref 17592186523552}] :answer-field/correct {:db/id #edb/ref 17592186523390} :answer-field/id #uuid "8fe0ed43-db8f-54cd-a271-1c201a6b718d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186523864}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b0314c88-d178-5a7a-83d0-8641a658389f" :question/math-academy-id "q-293620" :question/problem "Rationalize the denominator of $\\frac{8}{\\sqrt{6}+2\\sqrt{3}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{6}-2\\sqrt{3}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{6}-2\\sqrt{3},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{8}{\\sqrt{6}+2\\sqrt{3}} & = \\\\ \\frac{8}{\\sqrt{6}+2\\sqrt{3}}\\cdot \\frac{\\sqrt{6}-2\\sqrt{3}}{\\sqrt{6}-2\\sqrt{3}} & = \\\\ \\frac{8(\\sqrt{6}-2\\sqrt{3})}{(\\sqrt{6})^{2}-(2\\sqrt{3})^{2}} & = \\\\ \\frac{8(\\sqrt{6}-2\\sqrt{3})}{6-4\\cdot 3} & = \\\\ \\frac{8(\\sqrt{6}-2\\sqrt{3})}{6-12} & = \\\\ \\frac{8(\\sqrt{6}-2\\sqrt{3})}{(-6)} & = \\\\ -\\frac{8(\\sqrt{6}-2\\sqrt{3})}{6} & = \\\\ \\frac{4(2\\sqrt{3}-\\sqrt{6})}{3}\\end{aligned}\n$$"} :step/id #uuid "56760cc4-3829-59a9-a759-c24a29d21680" :step/next {:db/id #edb/ref 17592186524040}} {:db/id #edb/ref 17592186524094 :step/content {:db/id #edb/ref 17592186524013 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04c9a852-e246-5d02-8c8e-89e562e88723" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{7}+2\\sqrt{5}" :db/id #edb/ref 17592186523260} {:answer/id #uuid "277ec95c-e9fb-5172-b6aa-157ff86fcf2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{7}+\\sqrt{5}" :db/id #edb/ref 17592186523334} {:answer/id #uuid "bc41c789-d259-5c4e-96da-500ae024e7b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\sqrt{7}+4\\sqrt{5}" :db/id #edb/ref 17592186523647} {:answer/id #uuid "d1896968-8316-53ce-b6a2-57163eef17bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\sqrt{7}-4\\sqrt{5}" :db/id #edb/ref 17592186523697} {:answer/id #uuid "e13fa96a-d1f6-5081-8b2d-b82ac6692cd0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{7}-\\sqrt{5}" :db/id #edb/ref 17592186523725}] :answer-field/correct {:db/id #edb/ref 17592186523260} :answer-field/id #uuid "ad8e7c2f-1d55-5d7a-b0fa-0d52194e43c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186523875}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cf9e8f5c-9d67-5259-afe2-aab0c57cf6c7" :question/math-academy-id "q-85403" :question/problem "Rationalize the denominator of $\\frac{4}{\\sqrt{7}-\\sqrt{5}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{7}+\\sqrt{5}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{7}+\\sqrt{5},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{4}{\\sqrt{7}-\\sqrt{5}} & = \\\\ \\frac{4}{\\sqrt{7}-\\sqrt{5}}\\cdot \\frac{\\sqrt{7}+\\sqrt{5}}{\\sqrt{7}+\\sqrt{5}} & = \\\\ \\frac{4(\\sqrt{7}+\\sqrt{5})}{(\\sqrt{7}-\\sqrt{5})(\\sqrt{7}+\\sqrt{5})} & = \\\\ \\frac{4(\\sqrt{7}+\\sqrt{5})}{(\\sqrt{7})^{2}-(\\sqrt{5})^{2}} & = \\\\ \\frac{4(\\sqrt{7}+\\sqrt{5})}{7-5} & = \\\\ \\frac{4(\\sqrt{7}+\\sqrt{5})}{2} & = \\\\ 2\\sqrt{7}+2\\sqrt{5}\\end{aligned}\n$$"} :step/id #uuid "c363f1f1-387e-5fd5-9530-f56885b8d0da" :step/next {:db/id #edb/ref 17592186524062}}] :activity/title "Rationalizing Denominators With Two Terms" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186523244}]}
