a7" :answer/id #uuid "bc408780-d5be-5c9c-a818-aa55dd20d3a7"] ["answer-bc408780-d5be-5c9c-a818-aa55dd20d3a7" :answer/type :answer.type/math] ["answer-bc408780-d5be-5c9c-a818-aa55dd20d3a7" :answer/value "\\frac{2\\sqrt{3}+5}{2}"] ["answer-1f951e3d-f904-57c0-a208-d0aa3eba31c4" :answer/id #uuid "1f951e3d-f904-57c0-a208-d0aa3eba31c4"] ["answer-1f951e3d-f904-57c0-a208-d0aa3eba31c4" :answer/type :answer.type/math] ["answer-1f951e3d-f904-57c0-a208-d0aa3eba31c4" :answer/value "\\frac{2\\sqrt{3}+5}{4}"] ["answer-d62ec90e-b49c-5418-9264-c77f8cc9f9fb" :answer/id #uuid "d62ec90e-b49c-5418-9264-c77f8cc9f9fb"] ["answer-d62ec90e-b49c-5418-9264-c77f8cc9f9fb" :answer/type :answer.type/math] ["answer-d62ec90e-b49c-5418-9264-c77f8cc9f9fb" :answer/value "\\frac{\\sqrt{3}+1}{4}"] ["answer-2420e859-faac-5e9c-aad9-2c3cc3554c7d" :answer/id #uuid "2420e859-faac-5e9c-aad9-2c3cc3554c7d"] ["answer-2420e859-faac-5e9c-aad9-2c3cc3554c7d" :answer/type :answer.type/math] ["answer-2420e859-faac-5e9c-aad9-2c3cc3554c7d" :answer/value "\\sqrt{3}+1"] ["answer-48563d18-51b3-56ca-8174-bcd3d2395f03" :answer/id #uuid "48563d18-51b3-56ca-8174-bcd3d2395f03"] ["answer-48563d18-51b3-56ca-8174-bcd3d2395f03" :answer/type :answer.type/math] ["answer-48563d18-51b3-56ca-8174-bcd3d2395f03" :answer/value "\\sqrt{3}-2"] [17592186052449 :answer-field/correct "answer-48563d18-51b3-56ca-8174-bcd3d2395f03"] [17592186052449 :answer-field/choices "answer-bc408780-d5be-5c9c-a818-aa55dd20d3a7"] [17592186052449 :answer-field/choices "answer-1f951e3d-f904-57c0-a208-d0aa3eba31c4"] [17592186052449 :answer-field/choices "answer-d62ec90e-b49c-5418-9264-c77f8cc9f9fb"] [17592186052449 :answer-field/choices "answer-2420e859-faac-5e9c-aad9-2c3cc3554c7d"] [17592186052449 :answer-field/choices "answer-48563d18-51b3-56ca-8174-bcd3d2395f03"] ["question-2be8c3b4-39c9-5644-83d2-b15c8e4f70a2" :question/id #uuid "2be8c3b4-39c9-5644-83d2-b15c8e4f70a2"] ["question-2be8c3b4-39c9-5644-83d2-b15c8e4f70a2" :question/math-academy-id "q-293483"] ["question-2be8c3b4-39c9-5644-83d2-b15c8e4f70a2" :question/problem "Rationalize the denominator of $\\frac{1}{\\sqrt{7}+\\sqrt{3}}.$"] ["question-2be8c3b4-39c9-5644-83d2-b15c8e4f70a2" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{7}-\\sqrt{3}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{7}-\\sqrt{3},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{1}{\\sqrt{7}+\\sqrt{3}} & = \\\\ \\frac{1}{\\sqrt{7}+\\sqrt{3}}\\cdot \\frac{\\sqrt{7}-\\sqrt{3}}{\\sqrt{7}-\\sqrt{3}} & = \\\\ \\frac{1(\\sqrt{7}-\\sqrt{3})}{(\\sqrt{7}+\\sqrt{3})(\\sqrt{7}-\\sqrt{3})} & = \\\\ \\frac{\\sqrt{7}-\\sqrt{3}}{(\\sqrt{7})^{2}-(\\sqrt{3})^{2}} & = \\\\ \\frac{\\sqrt{7}-\\sqrt{3}}{7-3} & = \\\\ \\frac{\\sqrt{7}-\\sqrt{3}}{4}\\end{aligned}\n$$"] ["question-2be8c3b4-39c9-5644-83d2-b15c8e4f70a2" :question/difficulty :question.difficulty/easy] ["answer-field-32bd77f9-d91d-5125-9cb1-16e58bc996cd" :answer-field/id #uuid "32bd77f9-d91d-5125-9cb1-16e58bc996cd"] ["answer-fb1eeb55-0e8c-536a-994c-dc2b50c74be8" :answer/id #uuid "fb1eeb55-0e8c-536a-994c-dc2b50c74be8"] ["answer-fb1eeb55-0e8c-536a-994c-dc2b50c74be8" :answer/type :answer.type/math] ["answer-fb1eeb55-0e8c-536a-994c-dc2b50c74be8" :answer/value "\\frac{1}{\\sqrt{7}+\\sqrt{3}}"] ["answer-a67a328f-fc73-5e16-83b9-a7b74893916b" :answer/id #uuid "a67a328f-fc73-5e16-83b9-a7b74893916b"] ["answer-a67a328f-fc73-5e16-83b9-a7b74893916b" :answer/type :answer.type/math] ["answer-a67a328f-fc73-5e16-83b9-a7b74893916b" :answer/value "\\frac{\\sqrt{7}-\\sqrt{3}}{3}"] ["answer-8c674107-226d-5caa-ae85-db31c6af1d97" :answer/id #uuid "8c674107-226d-5caa-ae85-db31c6af1d97"] ["answer-8c674107-226d-5caa-ae85-db31c6af1d97" :answer/type :answer.type/math] ["answer-8c674107-226d-5caa-ae85-db31c6af1d97" :answer/value "\\frac{\\sqrt{7}-\\sqrt{3}}{4}"] ["answer-fd397035-a545-5279-b6e8-eafddd9a06ff" :answer/id #uuid "fd397035-a545-5279-b6e8-eafddd9a06ff"] ["answer-fd397035-a545-5279-b