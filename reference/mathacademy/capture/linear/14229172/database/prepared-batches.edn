ac{1}{\\sqrt{7}+\\sqrt{3}} & = \\\\ \\frac{1}{\\sqrt{7}+\\sqrt{3}}\\cdot \\frac{\\sqrt{7}-\\sqrt{3}}{\\sqrt{7}-\\sqrt{3}} & = \\\\ \\frac{1(\\sqrt{7}-\\sqrt{3})}{(\\sqrt{7}+\\sqrt{3})(\\sqrt{7}-\\sqrt{3})} & = \\\\ \\frac{\\sqrt{7}-\\sqrt{3}}{(\\sqrt{7})^{2}-(\\sqrt{3})^{2}} & = \\\\ \\frac{\\sqrt{7}-\\sqrt{3}}{7-3} & = \\\\ \\frac{\\sqrt{7}-\\sqrt{3}}{4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-32bd77f9-d91d-5125-9cb1-16e58bc996cd"] :db/ensure [:question/validate]} {:db/id "answer-field-32bd77f9-d91d-5125-9cb1-16e58bc996cd" :answer-field/id #uuid "32bd77f9-d91d-5125-9cb1-16e58bc996cd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8c674107-226d-5caa-ae85-db31c6af1d97" :answer-field/choices ["answer-fb1eeb55-0e8c-536a-994c-dc2b50c74be8" "answer-a67a328f-fc73-5e16-83b9-a7b74893916b" "answer-8c674107-226d-5caa-ae85-db31c6af1d97" "answer-fd397035-a545-5279-b6e8-eafddd9a06ff" "answer-18fdfa3b-ba02-571e-937c-7aa13525db34"] :db/ensure [:answer-field/validate]} {:db/id "answer-fb1eeb55-0e8c-536a-994c-dc2b50c74be8" :answer/id #uuid "fb1eeb55-0e8c-536a-994c-dc2b50c74be8" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{7}+\\sqrt{3}}" :db/ensure [:answer/validate]} {:db/id "answer-a67a328f-fc73-5e16-83b9-a7b74893916b" :answer/id #uuid "a67a328f-fc73-5e16-83b9-a7b74893916b" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{7}-\\sqrt{3}}{3}" :db/ensure [:answer/validate]} {:db/id "answer-8c674107-226d-5caa-ae85-db31c6af1d97" :answer/id #uuid "8c674107-226d-5caa-ae85-db31c6af1d97" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{7}-\\sqrt{3}}{4}" :db/ensure [:answer/validate]} {:db/id "answer-fd397035-a545-5279-b6e8-eafddd9a06ff" :answer/id #uuid "fd397035-a545-5279-b6e8-eafddd9a06ff" :answer/type :answer.type/math :answer/value "\\sqrt{3}-\\sqrt{4}" :db/ensure [:answer/validate]} {:db/id "answer-18fdfa3b-ba02-571e-937c-7aa13