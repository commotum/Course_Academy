} :answer/value "13-7\\sqrt{3}" :db/id #edb/ref 17592186523656}] :answer-field/correct {:db/id #edb/ref 17592186523656} :answer-field/id #uuid "19de62f6-8bdc-5e1a-9324-111045c1341c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186523804}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1f231ab0-36cf-59c7-86c7-11a5d98e603e" :question/math-academy-id "q-293702" :question/problem "Rationalize the denominator of $\\frac{5-\\sqrt{3}}{\\sqrt{3}+2}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{3}-2.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{3}-2,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{5-\\sqrt{3}}{\\sqrt{3}+2} & = \\\\ \\frac{5-\\sqrt{3}}{\\sqrt{3}+2}\\cdot \\frac{\\sqrt{3}-2}{\\sqrt{3}-2} & = \\\\ \\frac{(5-\\sqrt{3})(\\sqrt{3}-2)}{(\\sqrt{3}+2)(\\sqrt{3}-2)} & = \\\\ \\frac{5\\sqrt{3}-10-(\\sqrt{3})^{2}+2\\sqrt{3}}{(\\sqrt{3})^{2}-(2)^{2}} & = \\\\ \\frac{7\\sqrt{3}-10-3}{3-4} & = \\\\ \\frac{7\\sqrt{3}-13}{-1} & = \\\\ 13-7\\sqrt{3}\\end{aligned}\n$$"} :step/id #uuid "01296d4e-52f1-5b16-9285-4d32f1136eff"} {:db/id #edb/ref 17592186524062 :step/content {:db/id #edb/ref 17592186524002 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fd1eabe-6fb4-500f-8be1-ff96601a4dbe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4(2\\sqrt{3}+\\sqrt{6})}{3}" :db/id #edb/ref 17592186523287} {:answer/id #uuid "23024f2b-1cf3-5a6b-bdad-17fe1468934b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{(8\\sqrt{3}-\\sqrt{6})}{3}" :db/id #edb/ref 17592186523322} {:answer/id #uuid "41df7d9a-ec3e-5f59-99bb-cd2cedae5946" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4(2\\sqrt{3}-\\sqrt{6})}{3}" :db/id #edb/ref 17592186523390} {:answer/id #uuid "655338a1-a2e7-599f-a75e-c996cca2d51d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4(2\\sqrt{3}-\\sqrt{6})" :db/id #edb/ref 17592186523462} {:answer/id #uuid "8ea56f0c-6a63-55f2-a590-10edcfd3d963" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8\\sqrt{6}-6\\sqrt{6}}{3}" :db/id #edb/ref 17592186523552}] :answer-field/correct {:db/id #edb/ref 17592186523390} :answer-field/id #uuid "8fe0ed43-db8f-54cd-a271-1c201a6b718d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186523864}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b0314c88-d178-5a7a-83d0-8641a658389f" :question/math-academy-id "q-293620" :question/problem "Rationalize the denominator of $\\frac{8}{\\sqrt{6}+2\\sqrt{3}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{6}-2\\sqrt{3}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{6}-2\\sqrt{3},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{8}{\\sqrt{6}+2\\sqrt{3}} & = \\\\ \\frac{8}{\\sqrt{6}+2\\sqrt{3}}\\cdot \\frac{\\sqrt{6}-2\\sqrt{3}}{\\sqrt{6}-2\\sqrt{3}} & = \\\\ \\frac{8(\\sqrt{6}-2\\sqrt{3})}{(\\sqrt{6})^{2}-(2\\sqrt{3})^{2}} & = \\\\ \\frac{8(\\sqrt{6}-2\\sqrt{3})}{6-4\\cdot 3} & = \\\\ \\frac{8(\\sqrt{6}-2\\sqrt{3})}{6-12} & = \\\\ \\frac{8(\\sqrt{6}-2\\sqrt{3})}{(-6)} & = \\\\ -\\frac{8(\\sqrt{6}-2\\sqrt{3})}{6} & = \\\\ \\frac{4(2\\sqrt{3}-\\sqrt{6})}{3}\\end{aligned}\n$$"} :step/id #uuid "56760cc4-3829-59a9-a759-c24a29d21680" :step/next {:db/id #edb/ref 17592186524040}} {:db/id #edb/ref 17592186524094 :step/content {:db/id #edb/ref 17592186524013 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04c9a852-e246-5d02-8c8e-89e562e88723" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{7}+2\\sqrt{5}" :db/id #edb/ref 17592186523260} {:answer/id #uuid "277ec95c-e9fb-5172-b6aa-157ff86fcf2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{7}+\\sqrt{5}" :db/id #edb/ref 17592186523334} {:answer/id #uuid "bc41c789-d259-5c4e-96da-500ae024e7b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\sqrt{7}+4\\sqrt{5}" :db/id #edb/ref 17592186523647} {:answer/id #uuid "d1896968-8316-53ce-b6a2-57163eef17bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\sqrt{7}-4\\sqrt{5}" :db/id #edb/ref 17592186523697} {:answer/id #uuid "e13fa96a-d1f6-5081-8b2d-b82ac6692cd0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{7}-\\sqrt{5}" :db/id #edb/ref 17592186523725}] :answer-field/correct {:db/id #edb/ref 17592186523260} :answer-field/id #uuid "ad8e7c2f-1d55-5d7a-b0fa-0d52194e43c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186523875}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cf9e8f5c-9d67-5259-afe2-aab0c57cf6c7" :question/math-academy-id "q-85403" :question/problem "Rationalize the denominator of $\\frac{4}{\\sqrt{7}-\\sqrt{5}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{7}+\\sqrt{5}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{7}+\\sqrt{5},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{4}{\\sqrt{7}-\\sqrt{5}} & = \\\\ \\frac{4}{\\sqrt{7}-\\sqrt{5}}\\cdot \\frac{\\sqrt{7}+\\sqrt{5}}{\\sqrt{7}+\\sqrt{5}} & = \\\\ \\frac{4(\\sqrt{7}+\\sqrt{5})}{(\\sqrt{7}-\\sqrt{5})(\\sqrt{7}+\\sqrt{5})} & = \\\\ \\frac{4(\\sqrt{7}+\\sqrt{5})}{(\\sqrt{7})^{2}-(\\sqrt{5})^{2}} & = \\\\ \\frac{4(\\sqrt{7}+\\sqrt{5})}{7-5} & = \\\\ \\frac{4(\\sqrt{7}+\\sqrt{5})}{2} & = \\\\ 2\\sqrt{7}+2\\sqrt{5}\\end{aligned}\n$$"} :step/id #uuid "c363f1f1-387e-5fd5-9530-f56885b8d0da" :step/next {:db/id #edb/ref 17592186524062}}] :activity/title "Rationalizing Denominators With Two Terms" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186523244}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186551376} :activity/id #uuid "fabd4cb5-bf5a-5891-a4c9-271ff3fb6b51" :activity/scope {:db/id #edb/ref 17592186048229 :topic/id #uuid "8a462f76-1e1a-5c54-833e-8d3d6162407f" :topic/math-academy-id 86} :activity/steps [{:db/id #edb/ref 17592186551376 :step/content {:db/id #edb/ref 17592186551245 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bdaf800-b113-54a1-8ae2-bf3062dae2e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2(\\sqrt{2}-\\sqrt{3})}{3}" :db/id #edb/ref 17592186550634} {:answer/id #uuid "7a60e70d-bb07-5822-9f42-ff95fb91e079" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3(\\sqrt{3}-\\sqrt{2})" :db/id #edb/ref 17592186550676} {:answer/id #uuid "9adb5171-3077-5713-b717-2d95d30d3fea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2(\\sqrt{3}-\\sqrt{2})" :db/id #edb/ref 17592186550760} {:answer/id #uuid "daa51955-ac64-5d0a-9e18-fab91aef7595" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3(\\sqrt{2}-\\sqrt{3})" :db/id #edb/ref 17592186550960} {:answer/id #uuid "faddeef1-1236-5ec3-943a-ec3424761ede" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3(\\sqrt{3}-\\sqrt{2})}{2}" :db/id #edb/ref 17592186551038}] :answer-field/correct {:db/id #edb/ref 17592186550676} :answer-field/id #uuid "d19fc5b9-fae1-5789-b1b0-38f6339993d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186551200}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "20eb9dff-e6a3-54ea-a4e3-f227327ba30b" :question/math-academy-id "q-111093" :question/problem "Rationalize the denominator of $\\frac{3}{\\sqrt{3}+\\sqrt{2}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{3}-\\sqrt{2}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{3}-\\sqrt{2},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{3}{\\sqrt{3}+\\sqrt{2}} & = \\\\ \\frac{3}{\\sqrt{3}+\\sqrt{2}}\\cdot \\frac{\\sqrt{3}-\\sqrt{2}}{\\sqrt{3}-\\sqrt{2}} & = \\\\ \\frac{3(\\sqrt{3}-\\sqrt{2})}{(\\sqrt{3}+\\sqrt{2})(\\sqrt{3}-\\sqrt{2})} & = \\\\ \\frac{3(\\sqrt{3}-\\sqrt{2})}{(\\sqrt{3})^{2}-(\\sqrt{2})^{2}} & = \\\\ \\frac{3(\\sqrt{3}-\\sqrt{2})}{3-2} & = \\\\ 3(\\sqrt{3}-\\sqrt{2})\\end{aligned}\n$$"} :step/id #uuid "266a5f98-fcaf-5070-a367-7190c1ac8810" :step/next {:db/id #edb/ref 17592186551399}} {:db/id #edb/ref 17592186551399 :step/content {:db/id #edb/ref 17592186055197 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f951e3d-f904-57c0-a208-d0aa3eba31c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\sqrt{3}+5}{4}" :db/id #edb/ref 17592186550437} {:answer/id #uuid "2420e859-faac-5e9c-aad9-2c3cc3554c7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}+1" :db/id #edb/ref 17592186550456} {:answer/id #uuid "48563d18-51b3-56ca-8174-bcd3d2395f03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}-2" :db/id #edb/ref 17592186550538} {:answer/id #uuid "bc408780-d5be-5c9c-a818-aa55dd20d3a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\sqrt{3}+5}{2}" :db/id #edb/ref 17592186550885} {:answer/id #uuid "d62ec90e-b49c-5418-9264-c77f8cc9f9fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}+1}{4}" :db/id #edb/ref 17592186550946}] :answer-field/correct {:db/id #edb/ref 17592186550538} :answer-field/id #uuid "b2e8f9f6-5607-5264-a7eb-d2c11970defe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186052449}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b1f2dd05-26d6-5c35-85a3-93dc306cbcbc" :question/math-academy-id "q-293312" :question/problem "Rationalize the denominator of $\\frac{1-\\sqrt{3}}{\\sqrt{3}+1}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{3}-1.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{3}+1,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{1-\\sqrt{3}}{\\sqrt{3}+1} & = \\\\ \\frac{1-\\sqrt{3}}{\\sqrt{3}+1}\\cdot \\frac{\\sqrt{3}-1}{\\sqrt{3}-1} & = \\\\ \\frac{(1-\\sqrt{3})(\\sqrt{3}-1)}{(\\sqrt{3}+1)(\\sqrt{3}-1)} & = \\\\ \\frac{\\sqrt{3}-1-(\\sqrt{3})^{2}+\\sqrt{3}}{(\\sqrt{3})^{2}-(1)^{2}} & = \\\\ \\frac{\\sqrt{3}-1-3+\\sqrt{3}}{3-1} & = \\\\ \\frac{2\\sqrt{3}-4}{2} & = \\\\ \\frac{2(\\sqrt{3}-2)}{2} & = \\\\ \\sqrt{3}-2\\end{aligned}\n$$"} :step/id #uuid "4f180baa-e577-5d54-8841-f960239f5fee" :step/next {:db/id #edb/ref 17592186551444}} {:db/id #edb/ref 17592186551444 :step/content {:db/id #edb/ref 17592186551252 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18fdfa3b-ba02-571e-937c-7aa13525db34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{7}-\\sqrt{3}" :db/id #edb/ref 17592186550423} {:answer/id #uuid "8c674107-226d-5caa-ae85-db31c6af1d97" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{7}-\\sqrt{3}}{4}" :db/id #edb/ref 17592186550723} {:answer/id #uuid "a67a328f-fc73-5e16-83b9-a7b74893916b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{7}-\\sqrt{3}}{3}" :db/id #edb/ref 17592186550806} {:answer/id #uuid "fb1eeb55-0e8c-536a-994c-dc2b50c74be8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{7}+\\sqrt{3}}" :db/id #edb/ref 17592186551039} {:answer/id #uuid "fd397035-a545-5279-b6e8-eafddd9a06ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}-\\sqrt{4}" :db/id #edb/ref 17592186551049}] :answer-field/correct {:db/id #edb/ref 17592186550723} :answer-field/id #uuid "32bd77f9-d91d-5125-9cb1-16e58bc996cd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186551096}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2be8c3b4-39c9-5644-83d2-b15c8e4f70a2" :question/math-academy-id "q-293483" :question/problem "Rationalize the denominator of $\\frac{1}{\\sqrt{7}+\\sqrt{3}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{7}-\\sqrt{3}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{7}-\\sqrt{3},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{1}{\\sqrt{7}+\\sqrt{3}} & = \\\\ \\frac{1}{\\sqrt{7}+\\sqrt{3}}\\cdot \\frac{\\sqrt{7}-\\sqrt{3}}{\\sqrt{7}-\\sqrt{3}} & = \\\\ \\frac{1(\\sqrt{7}-\\sqrt{3})}{(\\sqrt{7}+\\sqrt{3})(\\sqrt{7}-\\sqrt{3})} & = \\\\ \\frac{\\sqrt{7}-\\sqrt{3}}{(\\sqrt{7})^{2}-(\\sqrt{3})^{2}} & = \\\\ \\frac{\\sqrt{7}-\\sqrt{3}}{7-3} & = \\\\ \\frac{\\sqrt{7}-\\sqrt{3}}{4}\\end{aligned}\n$$"} :step/id #uuid "c02ceca0-d419-51b9-a528-057d88f7a23b"}] :activity/title "Rationalizing Denominators With Two Terms" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186550366}]}
