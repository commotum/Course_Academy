#{[{:db/id #edb/ref 17592186064119 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064276 :knowledge-point/id #uuid "43f97f24-06a1-50cc-9c73-48bc491c632f" :knowledge-point/title "Multiplying a Binomial and a Quadratic Trinomial"}] :question/id #uuid "5aa1e9b2-a6d3-507d-8530-9cbba2fc2162" :question/math-academy-id "e-6707" :question/problem "Simplify the product $(x - 3)(x^2 - 2x + 6).$" :question/worked-solution "We distribute both terms of the binomial to the trinomial in the second parenthesis. Then, we simplify.\n\n$$\n\\eqalign{\n\t\t(x - 3)(x^2 - 2x + 6) &= \\\n\t\tx(x^2 - 2x + 6) - 3(x^2 - 2x + 6) &= \\\n\t\tx^3 - 2x^2 + 6x - 3x^2 + 6x - 18 &= \\\n\t\tx^3 - 5x^2 + 12x - 18\n\t}\n$$"}] [{:db/id #edb/ref 17592186064120 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064277 :knowledge-point/id #uuid "f7019d52-33a1-5968-9a93-2f2f06fbb0d6" :knowledge-point/title "Multiplying Trinomials"}] :question/id #uuid "55f28c00-cfe7-507e-830f-f7d993d16687" :question/math-academy-id "e-6710" :question/problem "Given that  $(3s^2 + 2s - 1)(s^2 + s + 2) = 3s^4 + \\bbox[3pt,Gainsboro]{a}s^3 + \\bbox[3pt,Gainsboro]{b}s^2 + \\bbox[3pt,Gainsboro]{c}s - 2,$ calculate $a+b+c.$" :question/worked-solution "We distribute all three terms of the trinomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify.\n\n$$\n\\begin{aligned}(3{s}^{2}+2s-1)({s}^{2}+s+2) & = \\\\ 3{s}^{2}({s}^{2}+s+2)+2s({s}^{2}+s+2)+(-1)({s}^{2}+s+2) & = \\\\ 3{s}^{4}+3{s}^{3}+6{s}^{2}+2{s}^{3}+2{s}^{2}+4s-{s}^{2}-s-2 & = \\\\ 3{s}^{4}+5{s}^{3}+7{s}^{2}+3s-2\\end{aligned}\n$$\n\nMatching up the coefficients, we find that $a=5,$ $b=7,$ and $c=3.$\n\nSo, we have\n\n$$\na + b + c = 5 + 7 + 3 = 15.\n$$"}] [{:db/id #edb/ref 17592186064121 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064278 :knowledge-point/id #uuid "09357892-5d4b-5346-99b0-9babc7b0d574" :knowledge-point/title "Multiplying Binomials and Trinomials Containing More Than One Variable"}] :question/id #uuid "9e77dab4-4e8b-51df-a070-1a42fcdbf212" :question/math-academy-id "e-6711" :question/problem "What is the coefficient of $a^2b$ in the product $(a+b)(a^2 + ab + b^2)?$" :question/worked-solution "We distribute both terms of the binomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify.\n\n$$\n\\begin{aligned}(a+b)({a}^{2}+ab+{b}^{2}) & = \\\\ a({a}^{2}+ab+{b}^{2})+b({a}^{2}+ab+{b}^{2}) & = \\\\ {a}^{3}+{a}^{2}b+a{b}^{2}+{a}^{2}b+a{b}^{2}+{b}^{3} & = \\\\ {a}^{3}+2{a}^{2}b+2a{b}^{2}+{b}^{3} & \\end{aligned}\n$$\n\nTherefore, the coefficient of $a^2 b$ is $2.$"}] [{:db/id #edb/ref 17592186483394 :knowledge-point/_questions [{:db/id #edb/ref 17592186064278 :knowledge-point/id #uuid "09357892-5d4b-5346-99b0-9babc7b0d574" :knowledge-point/title "Multiplying Binomials and Trinomials Containing More Than One Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a9d9b4b-ca94-5d3d-944d-072608c2a0de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186482970} {:answer/id #uuid "765bdb1f-67ac-5dc9-bba2-204cd7872f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186483017} {:answer/id #uuid "a9ee0db0-eadf-5cac-9bef-5cd84f91d4de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186483100} {:answer/id #uuid "ab9be181-5cb5-5df7-a4fe-95000c00d7d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186483103} {:answer/id #uuid "e5120102-be3d-54f2-8be6-81caab2a8713" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186483199}] :answer-field/correct {:answer/id #uuid "765bdb1f-67ac-5dc9-bba2-204cd7872f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186483017} :answer-field/id #uuid "6aa15b14-1505-5982-a0d8-def0168c9e04" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483277}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ad1d70aa-42cb-5c9b-8e55-ba51dafe3613" :question/math-academy-id "q-2824" :question/problem "What is the coefficient of $zx$ in the product $(2x-y+2z)(y+2x)?$" :question/worked-solution "We distribute the terms of the trinomial in the first set of parentheses to the binomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(2x-y+2z)(y+2x) & = \\\\ 2x(y+2x)+(-y)(y+2x)+2z(y+2x) & = \\\\ 2xy+4{x}^{2}-{y}^{2}-2xy+2zy+4zx & = \\\\ 4{x}^{2}-{y}^{2}+2zy+4zx\\end{aligned}\n$$\n\nTherefore,  the coefficient of $zx$ is $4.$"}] [{:db/id #edb/ref 17592186233791 :knowledge-point/_questions [{:db/id #edb/ref 17592186064276 :knowledge-point/id #uuid "43f97f24-06a1-50cc-9c73-48bc491c632f" :knowledge-point/title "Multiplying a Binomial and a Quadratic Trinomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30c71a89-1b78-5e7a-bc51-93f4bdcc0b79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}+22{x}^{2}+51x-36" :db/id #edb/ref 17592186482898} {:answer/id #uuid "4c8f52e7-2b8e-575c-9217-06206fea6f30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}-14{x}^{2}-51x-36" :db/id #edb/ref 17592186482948} {:answer/id #uuid "581beaca-78ca-59ab-ba2b-664041e07f97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}+4{x}^{2}-24x-36" :db/id #edb/ref 17592186482968} {:answer/id #uuid "b74b1c83-4325-5d72-b041-4d5e0349539b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}+4{x}^{2}-12x-18" :db/id #edb/ref 17592186483124} {:answer/id #uuid "d0c91194-623b-5e2f-ae4f-faff21602694" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}-18{x}^{2}-27x-36" :db/id #edb/ref 17592186483159}] :answer-field/correct {:answer/id #uuid "4c8f52e7-2b8e-575c-9217-06206fea6f30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}-14{x}^{2}-51x-36" :db/id #edb/ref 17592186482948} :answer-field/id #uuid "f5ad427f-a5c6-5d28-90ed-675589d89537" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483337}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "76a8faca-c056-5acc-8cda-bb43a948af4e" :question/math-academy-id "q-31385" :question/problem "Which of the following is equivalent to $(3x+4)({x}^{2}-6x-9)?$" :question/worked-solution "We distribute both terms of the binomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(3x+4)({x}^{2}-6x-9) & = \\\\ 3x({x}^{2}-6x-9)+4({x}^{2}-6x-9) & = \\\\ 3{x}^{3}-18{x}^{2}-27x+4{x}^{2}-24x-36 & = \\\\ 3{x}^{3}-14{x}^{2}-51x-36\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186483405 :knowledge-point/_questions [{:db/id #edb/ref 17592186064276 :knowledge-point/id #uuid "43f97f24-06a1-50cc-9c73-48bc491c632f" :knowledge-point/title "Multiplying a Binomial and a Quadratic Trinomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12b23156-098d-5b78-902a-2222d96e3b63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{a}^{3}+2{a}^{2}+8a+10" :db/id #edb/ref 17592186482844} {:answer/id #uuid "6b196904-d748-541e-b99e-230895127da9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{a}^{3}+3{a}^{2}+21a+10" :db/id #edb/ref 17592186482997} {:answer/id #uuid "a3fcfd07-2220-5f18-914f-b4ca1f9aeeb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{a}^{3}+6{a}^{2}+7a+10" :db/id #edb/ref 17592186483090} {:answer/id #uuid "c182dc2e-15df-545b-94cd-d81d50cc6098" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{a}^{3}+{a}^{2}+a+10" :db/id #edb/ref 17592186483136} {:answer/id #uuid "f2d4cb32-66b1-5b59-b9f2-a318636d096d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{a}^{3}+5{a}^{2}+14a+10" :db/id #edb/ref 17592186483221}] :answer-field/correct {:answer/id #uuid "6b196904-d748-541e-b99e-230895127da9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{a}^{3}+3{a}^{2}+21a+10" :db/id #edb/ref 17592186482997} :answer-field/id #uuid "997df8e8-e4cd-59a3-9c85-60df68b6ea05" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483301}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c0098ac0-7ed8-5f08-8d20-947c580b7f8e" :question/math-academy-id "q-78165" :question/problem "Which of the following is equivalent to $(2a+1)({a}^{2}+a+10)?$" :question/worked-solution "We distribute both terms of the binomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(2a+1)({a}^{2}+a+10) & = \\\\ 2a({a}^{2}+a+10)+1({a}^{2}+a+10) & = \\\\ 2{a}^{3}+2{a}^{2}+20a+{a}^{2}+a+10 & = \\\\ 2{a}^{3}+3{a}^{2}+21a+10\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234405 :knowledge-point/_questions [{:db/id #edb/ref 17592186064277 :knowledge-point/id #uuid "f7019d52-33a1-5968-9a93-2f2f06fbb0d6" :knowledge-point/title "Multiplying Trinomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16a4e61c-85ba-53f6-8b3d-37e1af2be870" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186482855} {:answer/id #uuid "4909ebb6-5668-52a9-9f12-5dcbd320aa36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186482942} {:answer/id #uuid "7bd0ebfd-7f2c-544d-82ef-f50f2ab806ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186483029} {:answer/id #uuid "a64ff90e-83d3-5d8d-8482-09680c347a23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186483094} {:answer/id #uuid "b3c8c890-0e53-5290-b46b-8bf2245c28c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186483117}] :answer-field/correct {:answer/id #uuid "7bd0ebfd-7f2c-544d-82ef-f50f2ab806ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186483029} :answer-field/id #uuid "ef32ad11-6f3b-5dfc-a8a9-de51cab41cf5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483333}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4ce674de-c42a-508a-99bd-3e2090e8e038" :question/math-academy-id "q-78174" :question/problem "Given that  $(3{w}^{2}+w+5)({w}^{2}+w+1)=3{w}^{4}+a{w}^{3}+b{w}^{2}+cw+5,$ calculate $a+b+c.$" :question/worked-solution "We distribute all three terms of the trinomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(3{w}^{2}+w+5)({w}^{2}+w+1) & = \\\\ 3{w}^{2}({w}^{2}+w+1)+w({w}^{2}+w+1)+5({w}^{2}+w+1) & = \\\\ 3{w}^{4}+3{w}^{3}+3{w}^{2}+{w}^{3}+{w}^{2}+w+5{w}^{2}+5w+5 & = \\\\ 3{w}^{4}+4{w}^{3}+9{w}^{2}+6w+5\\end{aligned}\n$$\n\nTherefore, $a=4,$ $b=9,$ and $c=6.$ So, \n\n$$\na+b+c=4+9+6=19.\n$$"}] [{:db/id #edb/ref 17592186483417 :knowledge-point/_questions [{:db/id #edb/ref 17592186064277 :knowledge-point/id #uuid "f7019d52-33a1-5968-9a93-2f2f06fbb0d6" :knowledge-point/title "Multiplying Trinomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74aecbb6-b8e5-5ebd-857f-df6f9036c234" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186483013} {:answer/id #uuid "913d3085-e6ae-5f6f-898a-07d1e1175573" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186483067} {:answer/id #uuid "d509cae9-f2bc-5f3b-ac9d-5abef902b561" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186483171} {:answer/id #uuid "e0fd4e23-d57a-5ac8-b610-7ece1ba4ab1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186483191} {:answer/id #uuid "fd942ed2-02f2-5c55-b087-0fd2363dcdd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186483236}] :answer-field/correct {:answer/id #uuid "74aecbb6-b8e5-5ebd-857f-df6f9036c234" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186483013} :answer-field/id #uuid "f11bf0b1-7d95-5083-be12-730d1dee4129" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483335}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d7c22bb7-72a0-576c-8d37-5df7a0b2d33e" :question/math-academy-id "q-78175" :question/problem "Given that  $({s}^{2}+2s-1)({s}^{2}-s+2)={s}^{4}+a{s}^{3}+b{s}^{2}+cs-2,$ calculate $a+b+c.$" :question/worked-solution "We distribute all three terms of the trinomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}({s}^{2}+2s-1)({s}^{2}-s+2) & = \\\\ {s}^{2}({s}^{2}-s+2)+2s({s}^{2}-s+2)-1({s}^{2}-s+2) & = \\\\ {s}^{4}-{s}^{3}+2{s}^{2}+2{s}^{3}-2{s}^{2}+4s-{s}^{2}+s-2 & = \\\\ {s}^{4}+{s}^{3}-{s}^{2}+5s-2\\end{aligned}\n$$\n\nTherefore, $a=1,$ $b=-1,$ and $c=5.$ So, \n\n$$\na+b+c=1+(-1)+5=5.\n$$"}] [{:db/id #edb/ref 17592186483427 :knowledge-point/_questions [{:db/id #edb/ref 17592186064277 :knowledge-point/id #uuid "f7019d52-33a1-5968-9a93-2f2f06fbb0d6" :knowledge-point/title "Multiplying Trinomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "043b906f-a914-598a-9f91-5ca6fcec0a3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186482815} {:answer/id #uuid "234ba434-25d1-5f9f-b0f4-93fdd591f9c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186482874} {:answer/id #uuid "45da7d3c-cb8c-5c94-8b92-1b817b5a7a63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186482934} {:answer/id #uuid "70ae1955-aef8-599b-9edf-0669967c6133" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186483008} {:answer/id #uuid "afcb38cd-b552-5548-a076-654fa26d9cec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186483109}] :answer-field/correct {:answer/id #uuid "afcb38cd-b552-5548-a076-654fa26d9cec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186483109} :answer-field/id #uuid "b2072f7a-cde2-54db-a02e-520c47dd2afc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483308}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "efb60196-718e-5a66-900b-f5c4e1c9517a" :question/math-academy-id "q-78178" :question/problem "Given that  $({t}^{2}-6t+9)({t}^{2}-4t+4)={t}^{4}+a{t}^{3}+b{t}^{2}+ct+36,$ calculate $a+b+c.$" :question/worked-solution "We distribute all three terms of the trinomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}({t}^{2}-6t+9)({t}^{2}-4t+4) & = \\\\ {t}^{2}({t}^{2}-4t+4)+(-6t)({t}^{2}-4t+4)+9({t}^{2}-4t+4) & = \\\\ {t}^{4}-4{t}^{3}+4{t}^{2}-6{t}^{3}+24{t}^{2}-24t+9{t}^{2}-36t+36 & = \\\\ {t}^{4}-10{t}^{3}+37{t}^{2}-60t+36\\end{aligned}\n$$\n\nTherefore, $a=-10,$ $b=37,$ and $c=-60.$ So, \n\n$$\na+b+c=-10+37+(-60)=-33.\n$$"}] [{:db/id #edb/ref 17592186483375 :knowledge-point/_questions [{:db/id #edb/ref 17592186064278 :knowledge-point/id #uuid "09357892-5d4b-5346-99b0-9babc7b0d574" :knowledge-point/title "Multiplying Binomials and Trinomials Containing More Than One Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27a47b63-7e07-581d-978f-3dccf5855a7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186482881} {:answer/id #uuid "56772ae2-cad4-5fde-980a-bbea606ea018" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186482963} {:answer/id #uuid "a2f632f9-78c7-5486-b830-3a6212593dcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186483085} {:answer/id #uuid "cd9434a0-e706-544d-be79-f52eabca7932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186483155} {:answer/id #uuid "e4f5c15f-6fb5-5fc1-a3e6-e8629f0df664" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186483198}] :answer-field/correct {:answer/id #uuid "a2f632f9-78c7-5486-b830-3a6212593dcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186483085} :answer-field/id #uuid "51974270-1ca8-52e1-824e-f717ac5b66dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483266}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6568de84-d0cb-5425-90cd-1a3ef070df84" :question/math-academy-id "q-78193" :question/problem "What is the coefficient of $v{w}^{2}$ in the product $(v+w)({v}^{2}+4vw+{w}^{2})?$" :question/worked-solution "We distribute both terms of the binomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(v+w)({v}^{2}+4vw+{w}^{2}) & = \\\\ v({v}^{2}+4vw+{w}^{2})+w({v}^{2}+4vw+{w}^{2}) & = \\\\ {v}^{3}+4{v}^{2}w+v{w}^{2}+{v}^{2}w+4v{w}^{2}+{w}^{3} & = \\\\ {v}^{3}+5{v}^{2}w+5v{w}^{2}+{w}^{3} & \\end{aligned}\n$$\n\nTherefore, the coefficient of $v{w}^{2}$ is $5.$"}]}
