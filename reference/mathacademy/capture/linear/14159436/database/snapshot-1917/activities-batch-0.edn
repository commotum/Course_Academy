#{[{:activity/first-step {:db/id #edb/ref 17592186065162} :activity/id #uuid "0c7c191d-53bd-5ae5-94c5-4eed4a0e0009" :activity/scope {:db/id #edb/ref 17592186049500 :topic/id #uuid "f967432c-0e8a-553d-8497-053cde92d843" :topic/math-academy-id 361} :activity/steps [{:db/id #edb/ref 17592186065162 :step/content {:db/id #edb/ref 17592186065375 :tutorial/content "To multiply a binomial and a trinomial, we take each term of the binomial and multiply it by every term in the trinomial. Then, we simplify by collecting like terms.\n\nFor example, to multiply $({\\color{blue}{x}} + {\\color{red}{3}})$ and $(x^2 + 2x+4)$, we multiply ${\\color{blue}{x}}$ and $(x^2 + 2x+4)$, and then we add this to the product of ${\\color{red}{3}}$ and $(x^2 + 2x+4)$.\n\n$$\n\\begin{aligned}\n(x + 3)(x^{2} + 2x + 4) &=  \\\\\nx(x^{2} + 2x + 4) + 3(x^{2} + 2x + 4) &=  \\\\\n&= x^{3} + 2x^{2} + 4x + 3x^{2} + 6x + 12\n\\end{aligned}\n$$\n\nThen, we group the like terms and simplify:\n\n$$\n\\begin{aligned}\nx^{3} + 2x^{2} + 4x + 3x^{2} + 6x + 12 &=  \\\\\nx^{3} + 2x^{2} + 3x^{2} + 4x + 6x + 12 &=  \\\\\n&= x^{3} + 5x^{2} + 10x + 12\n\\end{aligned}\n$$" :tutorial/id #uuid "abdf5593-94a7-5f4c-a2ec-ca378d5b0034" :tutorial/math-academy-id 4089 :tutorial/title "Introduction"} :step/id #uuid "1805ec56-b520-54eb-bdc6-f80e213e4e8e" :step/math-academy-id 24547 :step/next {:db/id #edb/ref 17592186065163}} {:db/id #edb/ref 17592186065163 :step/content {:db/id #edb/ref 17592186064276 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064119 :question/id #uuid "5aa1e9b2-a6d3-507d-8530-9cbba2fc2162" :question/math-academy-id "e-6707"} :knowledge-point/id #uuid "43f97f24-06a1-50cc-9c73-48bc491c632f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050818}] :knowledge-point/questions [{:db/id #edb/ref 17592186064957} {:db/id #edb/ref 17592186064958} {:db/id #edb/ref 17592186233791} {:db/id #edb/ref 17592186234404}] :knowledge-point/title "Multiplying a Binomial and a Quadratic Trinomial"} :st