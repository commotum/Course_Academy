#{[{:db/id #edb/ref 17592186064119 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064276 :knowledge-point/id #uuid "43f97f24-06a1-50cc-9c73-48bc491c632f" :knowledge-point/title "Multiplying a Binomial and a Quadratic Trinomial"}] :question/id #uuid "5aa1e9b2-a6d3-507d-8530-9cbba2fc2162" :question/math-academy-id "e-6707" :question/problem "Simplify the product $(x - 3)(x^2 - 2x + 6)$." :question/worked-solution "We distribute both terms of the binomial to the trinomial in the second parenthesis. Then, we simplify.\n\n$$\n\\begin{aligned} (x - 3)(x^2 - 2x + 6) \\\\ &= x(x^2 - 2x + 6) - 3(x^2 - 2x + 6) \\\\ &= x^3 - 2x^2 + 6x - 3x^2 + 6x - 18 \\\\ &= x^3 - 5x^2 + 12x - 18 \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064120 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064277 :knowledge-point/id #uuid "f7019d52-33a1-5968-9a93-2f2f06fbb0d6" :knowledge-point/title "Multiplying Trinomials"}] :question/id #uuid "55f28c00-cfe7-507e-830f-f7d993d16687" :question/math-academy-id "e-6710" :question/problem "Given that $(3s^2 + 2s - 1)(s^2 + s + 2) = 3s^4 + \\bbox[3pt,Gainsboro]{a}s^3 + \\bbox[3pt,Gainsboro]{b}s^2 + \\bbox[3pt,Gainsboro]{c}s - 2$, calculate $a+b+c$." :question/worked-solution "We distribute all three terms of the trinomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify.\n\n$$\n\\begin{aligned}\n(3s^{2} + 2s - 1)(s^{2} + s + 2) &=  \\\\\n3s^{2}(s^{2} + s + 2) + 2s(s^{2} + s + 2) + (-1)(s^{2} + s + 2) &=  \\\\\n3s^{4} + 3s^{3} + 6s^{2} + 2s^{3} + 2s^{2} + 4s - s^{2} - s - 2 &=  \\\\\n&= 3s^{4} + 5s^{3} + 7s^{2} + 3s - 2\n\\end{aligned}\n$$\n\nMatching up the coefficients, we find that $a=5$, $b=7$, and $c=3$.\n\nSo, we have\n\n$$\na + b + c = 5 + 7 + 3 = 15\n$$"}] [{:db/id #edb/ref 17592186064121 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064278 :knowledge-point/id #uuid "09357892-5d4b-5346-99b0-9babc7b0d574" :knowledge-point/title "Multiplying Binomials and Trinomials Containing More Than One Variable"}] :question/id #uuid "9e77dab4-4e8b-51df-a070-1a42fcdbf212" :question/math-academy-id "e-6711" :question/problem "What is the coefficient of $a^2b$ in the product $(a+b)(a^2 + ab + b^2)$?" :question/worked-solution "We distribute both terms of the binomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify.\n\n$$\n\\begin{aligned}\n(a + b)(a^{2} + ab + b^{2}) &=  \\\\\na(a^{2} + ab + b^{2}) + b(a^{2} + ab + b^{2}) &=  \\\\\na^{3} + a^{2}b + ab^{2} + a^{2}b + ab^{2} + b^{3} &=  \\\\\n&= a^{3} + 2a^{2}b + 2ab^{2} + b^{3}\n\\end{aligned}\n$$\n\nTherefore, the coefficient of $a^2 b$ is $2$."}] [{:db/id #edb/ref 17592186233791 :knowledge-point/_questions [{:db/id #edb/ref 17592186064276 :knowledge-point/id #uuid "43f97f24-06a1-50cc-9c73-48bc491c632f" :knowledge-point/title "Multiplying a Binomial and a Quadratic Trinomial"}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "76a8faca-c056-5acc-8cda-bb43a948af4e" :question/math-academy-id "q-31385" :question/problem "Which of the following is equivalent to $(3x+4)({x}^{2}-6x-9)?$" :question/worked-solution "We distribute both terms of the binomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(3x+4)({x}^{2}-6x-9) & = \\\\ 3x({x}^{2}-6x-9)+4({x}^{2}-6x-9) & = \\\\ 3{x}^{3}-18{x}^{2}-27x+4{x}^{2}-24x-36 & = \\\\ 3{x}^{3}-14{x}^{2}-51x-36\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234405 :knowledge-point/_questions [{:db/id #edb/ref 17592186064277 :knowledge-point/id #uuid "f7019d52-33a1-5968-9a93-2f2f06fbb0d6" :knowledge-point/title "Multiplying Trinomials"}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4ce674de-c42a-508a-99bd-3e2090e8e038" :question/math-academy-id "q-78174" :question/problem "Given that  $(3{w}^{2}+w+5)({w}^{2}+w+1)=3{w}^{4}+a{w}^{3}+b{w}^{2}+cw+5,$ calculate $a+b+c.$" :question/worked-solution "We distribute all three terms of the trinomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(3{w}^{2}+w+5)({w}^{2}+w+1) & = \\\\ 3{w}^{2}({w}^{2}+w+1)+w({w}^{2}+w+1)+5({w}^{2}+w+1) & = \\\\ 3{w}^{4}+3{w}^{3}+3{w}^{2}+{w}^{3}+{w}^{2}+w+5{w}^{2}+5w+5 & = \\\\ 3{w}^{4}+4{w}^{3}+9{w}^{2}+6w+5\\end{aligned}\n$$\n\nTherefore, $a=4,$ $b=9,$ and $c=6.$ So, \n\n$$\na+b+c=4+9+6=19.\n$$"}]}
