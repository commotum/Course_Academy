mo stretchy=\"false\">(</mo><msup><mi>w</mi><mn>2</mn></msup><mo>+</mo><mi>w</mi><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mi>w</mi><mo stretchy=\"false\">(</mo><msup><mi>w</mi><mn>2</mn></msup><mo>+</mo><mi>w</mi><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mn>5</mn><mo stretchy=\"false\">(</mo><msup><mi>w</mi><mn>2</mn></msup><mo>+</mo><mi>w</mi><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mn>3</mn><msup><mi>w</mi><mn>4</mn></msup><mo>+</mo><mn>3</mn><msup><mi>w</mi><mn>3</mn></msup><mo>+</mo><mn>3</mn><msup><mi>w</mi><mn>2</mn></msup><mo>+</mo><msup><mi>w</mi><mn>3</mn></msup><mo>+</mo><msup><mi>w</mi><mn>2</mn></msup><mo>+</mo><mi>w</mi><mo>+</mo><mn>5</mn><msup><mi>w</mi><mn>2</mn></msup><mo>+</mo><mn>5</mn><mi>w</mi><mo>+</mo><mn>5</mn></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mn>3</mn><msup><mi>w</mi><mn>4</mn></msup><mo>+</mo><mn>4</mn><msup><mi>w</mi><mn>3</mn></msup><mo>+</mo><mn>9</mn><msup><mi>w</mi><mn>2</mn></msup><mo>+</mo><mn>6</mn><mi>w</mi><mo>+</mo><mn>5</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Therefore, <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"38\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D44E TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c34\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mn>4</mn><mo>,</mo></math></mjx-assistive-mml></mjx-container> <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"39\" style=\"font