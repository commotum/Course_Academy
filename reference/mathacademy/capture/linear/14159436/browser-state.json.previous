  "live_records": {
    "q-31385": {
      "dom_id": "step-q31385",
      "name": "Question 1",
      "problem": "Which of the following is equivalent to $(3x+4)({x}^{2}-6x-9)?$",
      "worked_solution": "We distribute both terms of the binomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(3x+4)({x}^{2}-6x-9) & = \\\\ 3x({x}^{2}-6x-9)+4({x}^{2}-6x-9) & = \\\\ 3{x}^{3}-18{x}^{2}-27x+4{x}^{2}-24x-36 & = \\\\ 3{x}^{3}-14{x}^{2}-51x-36\\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
