 17592186416703} {:answer/id #uuid "653e93a6-32da-5603-acb2-af914eac846f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,3)\\notin R" :db/id #edb/ref 17592186416740}] :answer-field/correct {:answer/id #uuid "0f2bcf16-6ee6-50d5-996d-c87fed6e4ab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x,x)\\notin R" :db/id #edb/ref 17592186416696} :answer-field/id #uuid "ddd4f2c5-6ea0-54c5-a5b9-64c77f2c747b" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186416843}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cfc59310-e932-539a-95d8-99d9f3c66e0d" :question/math-academy-id "q-213245" :question/problem "Consider the following relation defined on the set $A={1,3,5,7}.$ \n\n$$\nR={(1,3),(1,5),(3,5),(5,7)}\n$$\n\nSelect the options that make the following reasoning correct:\n\nWe have the following:\n\n$$\n\\begin{aligned}(1,1){{field-1}}R,\\,(3,3){{field-2}}R,\\,(5,5){{field-3}}R,\\,(7,7){{field-4}}R\\end{aligned}\n$$\n\nNow, since \n{{field-5}}{{field-6}}, \n\nthe relation is \n{{field-7}}." :question/worked-solution "A binary relation $R,$ defined on a set $A,$ is \n\n- *reflexive* if $(x,x)\\in R$ for all $x\\in A,$\n\n- *irreflexive* if $(x,x)\\notin R$ for all $x\\in A.$\n\nIf some pairs of the form $(x,x)$ belong to a relation and others do not, then the relation is neither reflexive nor irreflexive.\n\nIn our case, the relation is defined on ${1,3,5,7},$ and we have\n\n$$\n(1,1)\\notin R,\\,(3,3)\\notin R,\\,(5,5)\\notin R,\\,(7,7)\\notin R.\n$$\n\nTherefore, we can conclude the following:\n\n$\\,$ Since $(x,x)\\notin R$ $\\text{for all }x\\in A,$ the relation is $\\text{irreflexive}.$"}] [{:db/id #edb/ref 17592186416857 :knowledge-point/_questions [{:db/id #edb/ref 17592186203923 :knowledge-point/id #uuid "306be17f-f950-57e2-9cb7-2b33c8a4929e" :knowledge-point/title "Identifying Reflexive and Irreflexive Relations Over Infinite Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ab03ed4-fb9b-5074-9880-fe1c53b1877b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ and $T$ only" :db/id #edb/ref 17592186416708} {:answer/id #uuid "2e52c3bd-2b7a-5a24-95b6-a56a7a15447c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ and $T$ only" :db/id #edb/ref 17592186416713} {:answer/id #uuid "b4de6a26-5382-5b6d-bf0e-07b0e5da5b96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ only" :db/id #edb/ref 17592186416780} {:answer/id #uuid "d6c5b715-7c1c-5058-8ab1-617e85ee6cba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$T$ only" :db/id #edb/ref 17592186416795} {:answer/id #uuid "f7295677-3fca-59ea-b647-9db4f20d343a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ and $S$ only" :db/id #edb/ref 17592186416808}] :answer-field/correct {:answer/id #uuid "b4de6a26-5382-5b6d-bf0e-07b0e5da5b96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ only" :db/id #edb/ref 17592186416780} :answer-field/id #uuid "f7897328-67d4-5121-9241-5f901a3d93b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416847}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "653fba49-a6b9-5e57-b514-cf99f2424cd1" :question/math-academy-id "q-213246" :question/problem "Which of the following relations are reflexive? \n\n- $x\\,R\\,y$ if and only if $x≡2y\\,(\\text{mod}\\,7),$ defined on $Z$\n\n- $x\\,S\\,y$ if and only if $x≡y\\,(\\text{mod}\\,9),$ defined on $Z$\n\n- $x\\,T\\,y$ if and only if $y≡x+2\\,(\\text{mod}\\,6),$ defined on $Z$" :question/worked-solution "A binary relation $R,$ defined on a set $A,$ is \n\n- *reflexive* if $(x,x)\\in R$ for all $x\\in A,$\n\n- *irreflexive* if $(x,x)\\notin R$ for all $x\\in A.$\n\nIf some pairs of the form $(x,x)$ belong to a relation and others do not, then the relation is neither reflexive nor irreflexive.\n\nWith that in mind, let's examine our relations.\n\n- Relation $R$ is neither reflexive nor irreflexive. Notice that \n\n- $(1,1)\\notin R$ since $1≢2(1)\\,(\\text{mod}\\,7),$ while\n\n- $(7,7)\\in R$ since $7≡2(7)\\,(\\text{mod}\\,7).$\n\n- Relation $S$ is reflexive. Indeed, $(x,x)\\in S$ for all $x\\in Z.$ Notice that \n\n$$\nx≡x\\,(\\text{mod}\\,9)\n$$\n\nfor any $x\\in Z.$\n\n- Relation $T$ is irreflexive. Indeed, $(x,x)\\notin T$ for all $x\\in Z.$ Notice that \n\n$$\nx≢x+2\\,(\\text{mod}\\,6)\n$$\n\nfor any $x\\in Z.$\n\nTherefore, the correct answer is \"$S$ only.\""}] [{:db/id #edb/ref 17592186416852 :knowledge-point/_questions [{:db/id #edb/ref 17592186203921 :knowledge-point/id #uuid "80cffe94-4f90-5bd8-b0b3-c09d54100580" :knowledge-point/title "Identifying Reflexive and Irreflexive Relations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6cd7d42-d8fe-5432-9a66-7fce567e6b2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "reflexive" :db/id #edb/ref 17592186416787} {:answer/id #uuid "f2ba276c-d015-5725-8277-b0b5827c6528" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "neither reflexive nor irreflexive" :db/id #edb/ref 17592186416804} {:answer/id #uuid "fa10a46b-a0fa-5719-90e0-0cf86e6b7dac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "irreflexive" :db/id #edb/ref 17592186416811}] :answer-field/correct {:answer/id #uuid "fa10a46b-a0fa-5719-90e0-0cf86e6b7dac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "irreflexive" :db/id #