class=\"ORD\"><mi>x</mi><mo>∈</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"double-struck\">Z</mi></mrow></mrow></mrow></mstyle></mpadded></mstyle><mo>,</mo></math></mjx-assistive-mml></mjx-container> the relation is <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"335\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle style=\"background-color: gainsboro;\"><mjx-mpadded><mjx-block style=\"width: 4.912em; margin: 0.3em 0px; position: relative;\"><mjx-rbox style=\"left: 0.3em; top: 0px; max-width: 4.912em;\"><mjx-mstyle style=\"color: blue;\"><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c69\"></mjx-c><mjx-c class=\"mjx-c72\"></mjx-c><mjx-c class=\"mjx-c72\"></mjx-c><mjx-c class=\"mjx-c65\"></mjx-c><mjx-c class=\"mjx-c66\"></mjx-c><mjx-c class=\"mjx-c6C\"></mjx-c><mjx-c class=\"mjx-c65\"></mjx-c><mjx-c class=\"mjx-c78\"></mjx-c><mjx-c class=\"mjx-c69\"></mjx-c><mjx-c class=\"mjx-c76\"></mjx-c><mjx-c class=\"mjx-c65\"></mjx-c></mjx-mtext></mjx-mstyle></mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+3pt\" depth=\"+3pt\" lspace=\"3pt\" width=\"+6pt\"><mstyle mathcolor=\"blue\"><mtext>irreflexive</mtext></mstyle></mpadded></mstyle><mo>.</mo></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
