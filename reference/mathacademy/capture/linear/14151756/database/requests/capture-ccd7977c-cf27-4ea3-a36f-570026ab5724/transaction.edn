b2f-f184-5120-9a9a-02c6bb9b801b" "answer-33faa70d-753a-5641-94fc-4d9701bacfb2" "answer-afc2dbdd-5e81-52fe-a6b2-3c0e8c6f7fe9" "answer-3d5c3910-3542-5c35-97e4-19fbca0e5c3b"] :db/ensure [:answer-field/validate]} {:db/id "answer-10761485-dc2c-5a0d-a547-4ac867a28d86" :answer/id #uuid "10761485-dc2c-5a0d-a547-4ac867a28d86" :answer/type :answer.type/math :answer/value "-100" :db/ensure [:answer/validate]} {:db/id "answer-c344fb2f-f184-5120-9a9a-02c6bb9b801b" :answer/id #uuid "c344fb2f-f184-5120-9a9a-02c6bb9b801b" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-33faa70d-753a-5641-94fc-4d9701bacfb2" :answer/id #uuid "33faa70d-753a-5641-94fc-4d9701bacfb2" :answer/type :answer.type/math :answer/value "100" :db/ensure [:answer/validate]} {:db/id "answer-afc2dbdd-5e81-52fe-a6b2-3c0e8c6f7fe9" :answer/id #uuid "afc2dbdd-5e81-52fe-a6b2-3c0e8c6f7fe9" :answer/type :answer.type/math :answer/value "\\pm 10" :db/ensure [:answer/validate]} {:db/id "answer-3d5c3910-3542-5c35-97e4-19fbca0e5c3b" :answer/id #uuid "3d5c3910-3542-5c35-97e4-19fbca0e5c3b" :answer/type :answer.type/text :answer/value "Not a real number" :db/ensure [:answer/validate]} {:db/id "question-bab3fe97-7845-5d24-a55f-a0948cbbb2ee" :question/id #uuid "bab3fe97-7845-5d24-a55f-a0948cbbb2ee" :question/math-academy-id "q-69747" :question/problem "What is $\\sqrt{{(-9)}^{2}}?$" :question/worked-solution "Remember that by definition, the square root is always zero or positive, never negative.\n\nSo, the square root comes out to\n\n$$\n\\sqrt{(-9)^{2}}=\\sqrt{{9}^{2}}=9.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-1c426ba0-d886-56ab-987e-b800fcd99a44"] :db/ensure [:question/validate]} {:db/id "answer-field-1c426ba0-d886-56ab-987e-b800fcd99a44" :answer-field/id #uuid "1c426ba0-d886-56ab-987e-b800fcd99a44" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-94fc69dc-20e4-5671-82f7-4a34ca5d4968" :answer-field/choices ["answer-b7c33671-5789-5dfb-8383-40ae97ceb530" "answer-d6ab34d5-ce15-56c8-82b4-8bc91f0073c1" "answer-94fc69dc-20e4-5671-82f7-4a34ca5d4968" "answer-f1b81de3-32df-56e8-9489-a3010db1b118" "answer-07a109c2-0447-58a3-8ee4-b0494ff1a436"] :db/ensure [:answer-field/validate]} {:db/id "answer-b7c33671-5789-5dfb-8383-40ae97ceb530" :answer/id #uuid "b7c33671-5789-5dfb-8383-40ae97ceb530" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-d6ab34d5-ce15-56c8-82b4-8bc91f0073c1" :answer/id #uuid "d6ab34d5-ce15-56c8-82b4-8bc91f0073c1" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "answer-94fc69dc-20e4-5671-82f7-4a34ca5d4968" :answer/id #uuid "94fc69dc-20e4-5671-82f7-4a34ca5d4968" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "answer-f1b81de3-32df-56e8-9489-a3010db1b118" :answer/id #uuid "f1b81de3-32df-56e8-9489-a3010db1b118" :answer/type :answer.type/math :answer/value "\\pm 3" :db/ensure [:answer/validate]} {:db/id "answer-07a109c2-0447-58a3-8ee4-b0494ff1a436" :answer/id #uuid "07a109c2-0447-58a3-8ee4-b0494ff1a436" :answer/type :answer.type/text :answer/value "Not a real number" :db/ensure [:answer/validate]} {:db/id 17592186176970 :tutorial/content "Let's calculate $(\\sqrt{100})^2$ by performing each operation one step at a time:\n\n$$\n(\\sqrt{\\color{blue}100})^2 = \\left(\\sqrt{{\\color{red}10}^2}\\right)^2 = ({\\color{red}10})^2 = {\\color{blue}100}\n$$\n\nNotice that the squaring the square root gives the number under the square root:\n\n$$\n\\left( \\sqrt{100} \\right)^2 = 100\n$$\n\nThis result holds in general for any non-negative number. If $\\color{blue}\\square$ is any positive number or zero, then\n\n$$\n(\\sqrt{\\color{blue}\\square})^2 = {\\color{blue}\\square}\\,.\n$$\n\nThe square and the square root cancel each other out, and we're left with the number that we started with.\n\n![](images/1f/1fa29ca192dc3fb99f4180c300aa3120064e3682361d175a698b1d457a569ba0.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186176971 :tutorial/content "We must be careful when taking the square root of a negative number that's been squared.\n\nFor example, $\\sqrt{(-9)^2}$ is *not* equal to $-9!$ We can write this using a **not equal to** symbol $\\neq$ as\n\n$$\n\\sqrt{(-9)^2}  \\neq -9.\n$$\n\nThis is because the square root of a number can *only* be positive or zero, never negative.\nLet's work it out the long way:\n\n$$\n\\begin{aligned}\\sqrt{(-9)^{2}} & = \\\\ \\sqrt{(-9)\\cdot (-9)} & = \\\\ \\sqrt{81} & = \\\\ \\sqrt{{9}^{2}} & = \\\\ 9\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\sqrt{(-9)^2}=\\sqrt{9^2} = 9.\n$$\n\nFor any positive perfect square, we always have exactly two numbers whose squares equal that number. Here, we have\n\n$$\n9^2=81\\quad \\textrm{and} \\quad (-9)^2=81.\n$$\n\nBut *by definition* the square root is always *positive* (or zero) and *cannot* be negative. So here, $\\sqrt{81}=+9,$ and for any non-negative $\\color{blue}\\square$ we get\n\n$$\n\\sqrt{\\color{blue}\\square} \\geq 0.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186176103 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
