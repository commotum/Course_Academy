[{:db/id 17592186175916 :knowledge-point/questions ["question-88fae142-fc63-550f-8060-dadde543f98e" "question-a6920c8a-7064-5177-94ae-b7e5a0869cee"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186175774 :question/problem "Find the value of $(\\sqrt{9})^2.$" :question/worked-solution "The number in the square root is non-negative, so the square and the square root cancel each other out.\n\nTherefore, we have\n\n$$\n(\\sqrt{9})^2 = 9.\n$$" :db/ensure [:question/validate]} {:db/id 17592186175917 :knowledge-point/questions ["question-a44b3de9-6d27-5f81-ba2d-a4c158fc2d5a" "question-bab3fe97-7845-5d24-a55f-a0948cbbb2ee"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186175775 :question/problem "Calculate the value of $\\sqrt{(-16)^2}.$" :question/worked-solution "Remember that by definition, the square root is always zero or positive, never negative.\n\nSo, the square root comes out to\n\n$$\n\\sqrt{(-16)^2} = \\sqrt{16^2} = 16.\n$$" :db/ensure [:question/validate]} {:db/id "question-88fae142-fc63-550f-8060-dadde543f98e" :question/id #uuid "88fae142-fc63-550f-8060-dadde543f98e" :question/math-academy-id "q-40870" :question/problem "$(\\sqrt{16})^{2}=$" :question/worked-solution "The number in the square root is non-negative, so the square and the square root cancel each other out.\n\nTherefore, we have\n\n$$\n(\\sqrt{16})^{2}=16.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-03572bcc-9740-5adc-8e46-5ed14695eff9"] :db/ensure [:question/validate]} {:db/id "answer-field-03572bcc-9740-5adc-8e46-5ed14695eff9" :answer-field/id #uuid "03572bcc-9740-5adc-8e46-5ed14695eff9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1f31c406-9461-57e7-a965-1459163fea19" :answer-field/choices ["answer-9ffa711a-fcf0-5976-a2dd-9a9b4fc02a76" "answer-21e69557-f111-5c5a-8aca-d072af28c1cc" "answer-1f31c406-9461-57e7-a965-1459163fea19" "answer-02b4e579-b5a1-5f8c-86d1-fa89ad54d131" "ans