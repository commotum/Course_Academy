#{[{:db/id #edb/ref 17592186175774 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186175916 :knowledge-point/id #uuid "5a937bb0-da50-5be0-a007-dce431a84282" :knowledge-point/title "Finding the Square of a Square Root"}] :question/id #uuid "a4796dd0-e8ee-5ffe-b96c-6646c209d4be" :question/math-academy-id "e-4609" :question/problem "Find the value of $(\\sqrt{9})^2$." :question/worked-solution "The number in the square root is non-negative, so the square and the square root cancel each other out.\n\nTherefore, we have\n\n$$\n(\\sqrt{9})^2 = 9\n$$"}] [{:db/id #edb/ref 17592186175775 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186175917 :knowledge-point/id #uuid "0f524f08-137f-56e6-8a6d-a45c3dae2635" :knowledge-point/title "Finding the Square Root of a Negative Number Squared"}] :question/id #uuid "0e96044b-b1f8-5d33-85ec-6a6a7f1fec6c" :question/math-academy-id "e-4610" :question/problem "Calculate the value of $\\sqrt{(-16)^2}$." :question/worked-solution "Remember that by definition, the square root is always zero or positive, never negative.\n\nSo, the square root comes out to\n\n$$\n\\sqrt{(-16)^2} = \\sqrt{16^2} = 16\n$$"}]}
