#{[{:db/id #edb/ref 17592186179454 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179815 :knowledge-point/id #uuid "638adb60-4629-514c-86e9-fa824295dc43" :knowledge-point/title "Translating Between Phrases and Algebraic Expressions Containing Multiplication"}] :question/id #uuid "9ecfaf4d-f7c4-52c1-856e-9e487b9e6de5" :question/math-academy-id "e-13062" :question/problem "Translate the phrase \"a number minus the product of three and another number\" into an algebraic expression." :question/worked-solution "If we denote the first number by $n$ and the second number by $k$, we can write \"the product of three and another number\" as $3k$.\n\nSo, the phrase \"a number minus the product of three and another number\" can be written as\n$n - 3k$."}] [{:db/id #edb/ref 17592186179455 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179816 :knowledge-point/id #uuid "66bfa36e-be32-5c64-86c1-b17e8e670e04" :knowledge-point/title "Translating Between Phrases and Algebraic Expressions Containing Division"}] :question/id #uuid "ce7fd393-cd41-5060-9ffe-422f6474102d" :question/math-academy-id "e-13063" :question/problem "Translate the phrase \"the quotient of a number and seven\" into an algebraic expression." :question/worked-solution "\"The quotient of a number and seven\" means the same thing as \"a number divided by seven.\" If we call our number $x$, then we can express this mathematically as\n\n$$\n\\dfrac{x}{7}\n$$"}]}
