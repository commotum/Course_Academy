#{[{:activity/first-step {:db/id #edb/ref 17592186180632} :activity/id #uuid "fb492055-69db-5196-a7e8-226f6f97db60" :activity/scope {:db/id #edb/ref 17592186051009 :topic/id #uuid "7931e951-f0f8-5132-97e2-67fa64802a65" :topic/math-academy-id 3721} :activity/steps [{:db/id #edb/ref 17592186180632 :step/content {:db/id #edb/ref 17592186180773 :tutorial/content "In algebra, there are many different ways to represent multiplication. The following expressions all mean \"two times $y$\":\n$2y,\\qquad 2 \\cdot y,\\qquad 2 \\times y$.\n\nWhen a number is next to a variable, it means that we multiply them together. We can also represent multiplication using the dot symbol ($\\cdot$) or the familiar \"times\" symbol ($\\times$), though we tend to avoid using the ($\\times$) symbol because it looks a lot like the variable $x$." :tutorial/id #uuid "dfb2834b-8f6f-55c4-b933-6f80cbf9e842" :tutorial/math-academy-id 8167 :tutorial/title "Introduction"} :step/id #uuid "935e508e-1137-5092-83aa-7b9d7f272d35" :step/math-academy-id 77833 :step/next {:db/id #edb/ref 17592186180633}} {:db/id #edb/ref 17592186180633 :step/content {:db/id #edb/ref 17592186179815 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179454 :question/id #uuid "9ecfaf4d-f7c4-52c1-856e-9e487b9e6de5" :question/math-academy-id "e-13062"} :knowledge-point/id #uuid "638adb60-4629-514c-86e9-fa824295dc43" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050618}] :knowledge-point/questions [{:db/id #edb/ref 17592186180157} {:db/id #edb/ref 17592186180224}] :knowledge-point/title "Translating Between Phrases and Algebraic Expressions Containing Multiplication"} :step/id #uuid "e0d6400c-fcd8-5d0d-858f-8d1cf92c2a3e" :step/math-academy-id 77834 :step/next {:db/id #edb/ref 17592186180634}} {:db/id #edb/ref 17592186180634 :step/content {:db/id #edb/ref 17592186180774 :tutorial/content "The **quotient** of two numbers means that we need to divide the first number by the second number.\n\nFor example, \"the quotient of $x$ and two\" means the same thing as \"$x$ divided by two\" and can be written as either expression below:\n\n$$\n\\dfrac{x}{2},\\qquad x \\div 2 \\,\n$$\n\nIn algebra, we prefer to represent division using the fraction bar instead of the ($\\div$) symbol." :tutorial/id #uuid "966707d2-a5e7-5ce1-a0b4-1c2991c80e3d" :tutorial/math-academy-id 8168 :tutorial/title "The Division Sign in Algebra"} :step/id #uuid "1dad9187-c0b1-5618-8f7a-6ee3c7b0a4c1" :step/math-academy-id 77837 :step/next {:db/id #edb/ref 17592186180635}} {:db/id #edb/ref 17592186180635 :step/content {:db/id #edb/ref 17592186179816 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179455 :question/id #uuid "ce7fd393-cd41-5060-9ffe-422f6474102d" :question/math-academy-id "e-13063"} :knowledge-point/id #uuid "66bfa36e-be32-5c64-86c1-b17e8e670e04" :knowledge-point/questions [{:db/id #edb/ref 17592186180127} {:db/id #edb/ref 17592186180225} {:db/id #edb/ref 17592186424820}] :knowledge-point/title "Translating Between Phrases and Algebraic Expressions Containing Division"} :step/id #uuid "8f5e7a7a-0b7b-58c4-970d-eb187e7d2e39" :step/math-academy-id 77838}] :activity/title "Constructing Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179872}]}
