#{[{:db/id #edb/ref 17592186078250 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078392 :knowledge-point/id #uuid "c44fafc7-d2e5-584e-8812-6b6983b91cdc" :knowledge-point/title "Evaluating a Trigonometric Ratio by Using the Pythagorean Theorem to Solve for the Hypotenuse"}] :question/id #uuid "8ea6aa9d-bdb3-58d5-9182-8f70176f7060" :question/math-academy-id "e-3242" :question/problem "Find the value of $\\cos L$.\n\n![](images/78/78416d3c8ec8a8351ecfe0a4ea81feb05cce29f55dd9ec4bc676e6363dd49ec0.png)" :question/worked-solution "Recall the definition of cosine:\n\n$$\n\\cos L = \\dfrac {\\textrm{adjacent}}{\\textrm{hypotenuse}} = \\dfrac {JL}{KL} = \\dfrac{3\\sqrt{3}}{KL}\n$$\n\nHere, we need to determine the missing side $KL$. The trick is to use the Pythagorean Theorem:\n\n$$\n\\begin{aligned} KL &= \\sqrt{JK^2 + JL^2} \\\\ &= \\sqrt{(3)^2 + (3\\sqrt3)^2} \\\\ &= \\sqrt{9 + 27} \\\\ &= \\sqrt{36} \\\\ &= 6 \\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned} \\cos L &= \\dfrac{3\\sqrt{3}}{KL} \\\\[5pt] &= \\dfrac{3\\sqrt 3}{6} \\\\[5pt] &=\\dfrac {\\sqrt 3} 2. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186078252 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078393 :knowledge-point/id #uuid "0a83e174-ab83-5bf6-898e-0fe5cddc8ef4" :knowledge-point/title "Evaluating a Trigonometric Ratio by Using the Pythagorean Theorem to Solve for a Leg"}] :question/id #uuid "ab766585-35c3-5c75-bb18-d7d22b505079" :question/math-academy-id "e-3244" :question/problem "Find the sine of $\\angle Y$.\n\n![](images/e0/e0fb47c85d56c314389a0a334029b3b769f13ddcca6ab15a9021cf6361e4b1ce.png)" :question/worked-solution "Recall the definition of sine:\n\n$$\n\\sin Y = \\dfrac {\\textrm{opposite}}{\\textrm{hypotenuse}} = \\dfrac {XZ}{YZ} = \\dfrac{XZ}{61}\n$$\n\nHere, we need to determine the missing side $XZ$. The trick is to use the Pythagorean Theorem:\n\n$$\n\\begin{aligned} XZ &= \\sqrt{YZ^2 - XY^2} \\\\ &= \\sqrt{61^2 - 60^2} \\\\ &= \\sqrt{3721- 3600} \\\\ &= \\sqrt{121} \\\\ &= 11 \\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned} \\sin Y&= \\dfrac{XZ}{61} = \\dfrac{11}{61}. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186078254 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078394 :knowledge-point/id #uuid "7dc4cb42-6295-5484-b37e-0c557c4f6073" :knowledge-point/title "Evaluating a Trigonometric Ratio by Using the Pythagorean Theorem with Decimals"}] :question/id #uuid "cc59ecc0-e886-5e7d-8fbe-c63df5995d3d" :question/math-academy-id "e-3246" :question/problem "Calculate $\\tan K$.\n\n![](images/fb/fbac8700b860cbe8a60f2c24a5ab7ee9e7adfda584b1077edf208b0dcd16744e.png)" :question/worked-solution "Recall the definition of tangent:\n\n$$\n\\tan K = \\dfrac {\\textrm{opposite}}{\\textrm{adjacent}} = \\dfrac {JL}{JK} = \\dfrac{JL}{7.5}\n$$\n\nHere, we need to determine the missing side $JL$. The trick is to use the Pythagorean Theorem:\n\n$$\n\\begin{aligned} JL &= \\sqrt{KL^2 - JK^2} \\\\ &= \\sqrt{12.5^2 - 7.5^2} \\\\ &= \\sqrt{156.25-56.25} \\\\ &= \\sqrt{100} \\\\ &= 10 \\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned} \\tan K&= \\dfrac{JL}{7.5} \\\\[5pt] &= \\dfrac{10}{7.5} \\\\[5pt] &=\\dfrac 4 3. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186078740 :knowledge-point/_questions [{:db/id #edb/ref 17592186078394 :knowledge-point/id #uuid "7dc4cb42-6295-5484-b37e-0c557c4f6073" :knowledge-point/title "Evaluating a Trigonometric Ratio by Using the Pythagorean Theorem with Decimals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9aa19083-4794-58ee-8fad-4ca0e69496d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{5}" :db/id #edb/ref 17592186075317} {:answer/id #uuid "dc53aa94-495a-5de2-ac52-713c00c8250d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{12}" :db/id #edb/ref 17592186075318} {:answer/id #uuid "dfbd7e1a-d670-5049-be73-b31bceca763c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{12}" :db/id #edb/ref 17592186075319} {:answer/id #uuid "e7eb01b0-bbd4-5b07-a9a3-831c67740f92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{13}" :db/id #edb/ref 17592186075320} {:answer/id #uuid "56ab04b7-2119-5221-9469-344254399a8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{13}" :db/id #edb/ref 17592186075321}] :answer-field/id #uuid "26d5018e-19d4-5b5f-aa3f-04252b407275" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186075316}] :question/id #uuid "5ae01ab6-b771-5f83-a86c-608699d71684" :question/math-academy-id "q-14644" :question/problem "![](images/f9/f9f59d4328ad43e6e342da3cf9e87ccd5dfe33b97c46424e7fcc2b9f562fc452.png)\n\nFind the tangent of $∠N$.\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true}] [{:db/id #edb/ref 17592186234385 :knowledge-point/_questions [{:db/id #edb/ref 17592186078393 :knowledge-point/id #uuid "0a83e174-ab83-5bf6-898e-0fe5cddc8ef4" :knowledge-point/title "Evaluating a Trigonometric Ratio by Using the Pythagorean Theorem to Solve for a Leg"}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "021c99cd-4ec5-510e-b0c7-e32ccd554ad9" :question/math-academy-id "q-76560" :question/problem "In a right triangle $△XYZ,$ $∠X$ is a right angle, $XZ=\\sqrt{5}$ and $YZ=7.$ Find the cosine of $∠Y.$" :question/worked-solution "The following triangle illustrates the information given.\n\n![](images/ea/ea0502e8b261358c7b55c60df02474c5b39a75cbb104d6ba3efb40300294ef56.png)\n\nRecall the definition of cosine: \n\n$$\n\\operatorname{cos}Y=\\frac{\\text{adjacent}}{\\text{hypotenuse}}=\\frac{XY}{YZ}=\\frac{XY}{7}\n$$\n\nHere, we need to determine the missing side $XY.$ The trick is to use the Pythagorean Theorem:\n\n$$\n\\begin{aligned}XY & =\\sqrt{Y{Z}^{2}-X{Z}^{2}} \\\\  & =\\sqrt{{7}^{2}-(\\sqrt{5})^{2}} \\\\  & =\\sqrt{49-5} \\\\  & =\\sqrt{44} \\\\  & =2\\sqrt{11}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}Y & =\\frac{XY}{7}=\\frac{2\\sqrt{11}}{7}.\\end{aligned}\n$$"}]}
