x></mjx-sqrt></mjx-msqrt><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable rowspacing=\"0.8em 0.8em 0.8em 0.8em 0.5em\" columnspacing=\"0.278em\" displaystyle=\"true\" columnalign=\"right left\"><mtr><mtd><mi>G</mi><mi>H</mi></mtd><mtd><mo>=</mo><msqrt><mi>F</mi><msup><mi>G</mi><mn>2</mn></msup><mo>−</mo><mi>F</mi><msup><mi>H</mi><mn>2</mn></msup></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><msqrt><msup><mn>6</mn><mn>2</mn></msup><mo>−</mo><mo stretchy=\"false\">(</mo><mn>2</mn><msqrt><mn>2</mn></msqrt><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><msqrt><mn>36</mn><mo>−</mo><mn>8</mn></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><msqrt><mn>28</mn></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mn>2</mn><msqrt><mn>7</mn></msqrt></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Therefore,</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"23\" style=\"font-size: 113.1%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 5.917em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0.139em; padding-bottom: 0.5em;\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c63\"></mjx-c><mjx-c class=\"mjx-c6F\"></mjx-c><mjx-c class=\"mjx-c73\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2061\"></mjx-c></mjx-mo><mjx-texatom space=\"2\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D43A TEX-I\"></mjx-c></mjx-mi></mjx-texatom><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"text-align: left; padding-left: 0.139em; padding-bottom: 0.5em;\"><mjx-mo class=\"mjx-n\"><mj