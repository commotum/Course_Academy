#{[{:db/id #edb/ref 17592186228877 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186229195 :knowledge-point/id #uuid "d35c9f72-a876-5fc0-8ab4-741c37cb3775" :knowledge-point/title "Expressing Subsequent Percentages as a Single Percentage"}] :question/id #uuid "4f528740-2fa6-5441-ab8b-86ce294dbf75" :question/math-academy-id "e-21447" :question/problem "According to a recent report, $40\\%$ of viewers said they enjoyed documentaries. Of those, $50\\%$ preferred documentaries about nature. What percentage of all viewers preferred nature documentaries?" :question/worked-solution "Let $x$ be the total number of viewers.\n\nWe're told that $40\\%$ of viewers enjoyed documentaries. Thus, the number of viewers who enjoy documentaries is \n\n$$\n0.4x.\n$$\n\nWe are also told that of those viewers who enjoy documentaries, $50\\%$ preferred nature topics. So, the number of viewers who preferred nature documentaries is\n\n$$\n0.50(0.4x) = 0.20x.\n$$\n\nThe expression $0.20x$ represents $20\\%$ of $x.$ Therefore, $20\\%$ of all viewers preferred nature documentaries."}] [{:db/id #edb/ref 17592186228882 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186229194 :knowledge-point/id #uuid "3852a0f9-f1ac-5a3f-9883-8dd2ee03e332" :knowledge-point/title "Applying Subsequent Percentages in Real-World Situations"}] :question/id #uuid "97d0ab51-97cd-5781-be30-4d70adc5d214" :question/math-academy-id "e-21458" :question/problem "A service adjusted a subscription fee to $90\\%$ of its original cost. A surcharge of $18\\%$ was applied to the adjusted fee. If the subscription originally cost $\\[math]180,$ what is the surcharge?" :question/worked-solution "First, the adjusted fee is $90\\%$ of the original cost $(\\[math]180){:}$\n\n$$\n\\begin{aligned}90%\\times 180 & =\\frac{90}{100}\\times 180 \\\\  & =0.9\\times 180 \\\\  & =162\\end{aligned}\n$$\n\nSo, the adjusted fee is $\\[/math]162.$ Then, the surcharge is $18\\%$ of this fee:\n\n$$\n\\begin{aligned}18%\\times 162 & =\\frac{18}{100}\\times 162 \\\\  & =0.18\\times 162 \\\\  & =29.16\\end{aligned}\n$$\n\nTherefore, the surcharge is $\\[math]29.16.$"}] [{:db/id #edb/ref 17592186228884 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186229193 :knowledge-point/id #uuid "ec0d62dd-5b51-5286-b382-776412570561" :knowledge-point/title "Applying Subsequent Percentages"}] :question/id #uuid "91ca6940-1bc7-583b-8bac-81d7da934167" :question/math-academy-id "e-21463" :question/problem "Find $160\\%$ of $75,$ and then $150\\%$ of the result." :question/worked-solution "First, we find $160\\%$ of $75{:}$\n\n$$\n\\begin{aligned}160%\\times 75 & =\\frac{160}{100}\\times 75 \\\\  & =1.6\\times 75 \\\\  & =120\\end{aligned}\n$$\n\nThen, we find $150\\%$ of the result $(120){:}$\n\n$$\n\\begin{aligned}150%\\times 120 & =\\frac{150}{100}\\times 120 \\\\  & =1.5\\times 120 \\\\  & =180\\end{aligned}\n$$\n\nTherefore, the final answer is $180.$"}] [{:db/id #edb/ref 17592186486434 :knowledge-point/_questions [{:db/id #edb/ref 17592186229193 :knowledge-point/id #uuid "ec0d62dd-5b51-5286-b382-776412570561" :knowledge-point/title "Applying Subsequent Percentages"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17f93f9d-e765-5f23-b7a3-a6bf802d6bbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186485810} {:answer/id #uuid "4ba290ae-ce34-542b-8844-2cd913434a0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186485902} {:answer/id #uuid "6eb478d3-8479-59d5-a04b-887ccad7ef40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186485953} {:answer/id #uuid "7ca6b597-8f66-55e3-a87a-16773b1daf9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186485984} {:answer/id #uuid "b6a6d2cc-aa72-5e01-a8c2-7be96919829c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186486093}] :answer-field/correct {:answer/id #uuid "6eb478d3-8479-59d5-a04b-887ccad7ef40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186485953} :answer-field/id #uuid "15fa6bcc-052f-5f93-8f6f-7115563b165d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486245}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bee016d0-6cd7-5398-ae5a-81f82544f72f" :question/math-academy-id "q-326891" :question/problem "Find $30%$ of $50,$ and then $20%$ of the result." :question/worked-solution "First, we find $30%$ of $50:$\n\n$$\n\\begin{aligned}30%\\times 50 & =\\frac{30}{100}\\times 50 \\\\  & =0.3\\times 50 \\\\  & =15\\end{aligned}\n$$\n\nThen, we find $20%$ of the result $(15):$\n\n$$\n\\begin{aligned}20%\\times 15 & =\\frac{20}{100}\\times 15 \\\\  & =0.2\\times 15 \\\\  & =3\\end{aligned}\n$$\n\nTherefore, the final answer is $3.$"}] [{:db/id #edb/ref 17592186486452 :knowledge-point/_questions [{:db/id #edb/ref 17592186229193 :knowledge-point/id #uuid "ec0d62dd-5b51-5286-b382-776412570561" :knowledge-point/title "Applying Subsequent Percentages"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84d42e1f-305a-54bb-b17d-52bf63e939f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186485997} {:answer/id #uuid "b819777e-a659-5c20-9091-9e7f7829a0d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186486096} {:answer/id #uuid "b8f9bdda-5a44-5792-bef9-291aa0a56832" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186486098} {:answer/id #uuid "bfe422f1-e684-5801-92e3-ab70da88986b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24.6" :db/id #edb/ref 17592186486109} {:answer/id #uuid "c9c3b32b-32e4-596f-9422-39b4ac1d3ab8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26.4" :db/id #edb/ref 17592186486128}] :answer-field/correct {:answer/id #uuid "c9c3b32b-32e4-596f-9422-39b4ac1d3ab8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26.4" :db/id #edb/ref 17592186486128} :answer-field/id #uuid "efb48e7b-fc34-5e8f-aab9-f0af854abc24" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486339}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e29b2a6a-e1e7-5fde-b63b-dc98de03f40b" :question/math-academy-id "q-327231" :question/problem "Find $110%$ of $80,$ and then $30%$ of the result." :question/worked-solution "First, we find $110%$ of $80:$\n\n$$\n\\begin{aligned}110%\\times 80 & =\\frac{110}{100}\\times 80 \\\\  & =1.1\\times 80 \\\\  & =88\\end{aligned}\n$$\n\nThen, we find $30%$ of the result $(88):$\n\n$$\n\\begin{aligned}30%\\times 88 & =\\frac{30}{100}\\times 88 \\\\  & =0.3\\times 88 \\\\  & =26.4\\end{aligned}\n$$\n\nTherefore, the final answer is $26.4.$"}] [{:db/id #edb/ref 17592186486368 :knowledge-point/_questions [{:db/id #edb/ref 17592186229194 :knowledge-point/id #uuid "3852a0f9-f1ac-5a3f-9883-8dd2ee03e332" :knowledge-point/title "Applying Subsequent Percentages in Real-World Situations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec91b8b4-c109-546b-bf90-82bca1add2ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1080" :db/id #edb/ref 17592186486195}] :answer-field/correct {:answer/id #uuid "ec91b8b4-c109-546b-bf90-82bca1add2ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1080" :db/id #edb/ref 17592186486195} :answer-field/id #uuid "6430fa47-fc07-5133-b350-c0c171fa758d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186486279}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "311706e9-5725-57d0-9ebd-1cb5c9f7c783" :question/math-academy-id "q-327540" :question/problem "An engineer increased a battery’s capacity to $135%$ of its original rating. Then, a safety reserve equal to $20%$ of that new capacity was set aside. If the original capacity was $4000$ mAh, what is the safety reserve in mAh?\n\nThe safety reserve is  \n{{field-1}}\nmAh." :question/worked-solution "First, the new capacity is $135%$ of the original rating $(4000$ mAh$):$\n\n$$\n\\begin{aligned}135%\\times 4000 & =\\frac{135}{100}\\times 4000 \\\\  & =1.35\\times 4000 \\\\  & =5400\\end{aligned}\n$$\n\nSo, the new capacity is $5400$ mAh. Then, the safety reserve is $20%$ of this new capacity:\n\n$$\n\\begin{aligned}20%\\times 5400 & =\\frac{20}{100}\\times 5400 \\\\  & =0.20\\times 5400 \\\\  & =1080\\end{aligned}\n$$\n\nTherefore, the safety reserve is $1080$ mAh."}] [{:db/id #edb/ref 17592186486403 :knowledge-point/_questions [{:db/id #edb/ref 17592186229195 :knowledge-point/id #uuid "d35c9f72-a876-5fc0-8ab4-741c37cb3775" :knowledge-point/title "Expressing Subsequent Percentages as a Single Percentage"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "293d27cb-6be7-542a-a8b8-147db89da707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20%" :db/id #edb/ref 17592186485838} {:answer/id #uuid "39360d96-4ec6-5354-8205-5964ad5fd93c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30%" :db/id #edb/ref 17592186485875} {:answer/id #uuid "abe9f14d-e706-5d0a-b03c-1dcc3935a8cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25%" :db/id #edb/ref 17592186486075} {:answer/id #uuid "d10e3970-e073-5861-9d00-25bade6ebf66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22%" :db/id #edb/ref 17592186486143} {:answer/id #uuid "e344b716-08e2-5ea2-910b-b5e790292980" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35%" :db/id #edb/ref 17592186486181}] :answer-field/correct {:answer/id #uuid "abe9f14d-e706-5d0a-b03c-1dcc3935a8cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25%" :db/id #edb/ref 17592186486075} :answer-field/id #uuid "06487dff-824c-5b16-9a29-dc375e4d13b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486235}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "786bda33-d02b-5551-a3f5-7adb0032f21a" :question/math-academy-id "q-327570" :question/problem "A company’s employee count increased to $125%$ of last year’s total. Of these employees, $20%$ work remotely. What percentage of last year’s total now work remotely?" :question/worked-solution "Let $x$ be the number of employees last year.\n\nWe're told that the total number increased to $125%$ of last year’s total. Thus, the current number of employees is $1.25x.$\n\nWe are also told that of these employees, $20%$ work remotely. So, the number of employees working remotely is\n\n$$\n0.20(1.25x)=0.25x.\n$$\n\nThe expression $0.25x$ represents $25%$ of $x.$ Therefore, $25%$ of last year’s employees now work remotely."}] [{:db/id #edb/ref 17592186486374 :knowledge-point/_questions [{:db/id #edb/ref 17592186229195 :knowledge-point/id #uuid "d35c9f72-a876-5fc0-8ab4-741c37cb3775" :knowledge-point/title "Expressing Subsequent Percentages as a Single Percentage"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57944d59-4548-51e3-b2bc-f10d7935a6a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30%" :db/id #edb/ref 17592186485920} {:answer/id #uuid "58e2fcd0-4ea8-5bae-941b-1c3addb5d792" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45%" :db/id #edb/ref 17592186485921} {:answer/id #uuid "891a0519-5699-5997-9688-80da5e4b5a77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27%" :db/id #edb/ref 17592186486007} {:answer/id #uuid "d13a7742-c51e-5d7e-819d-990c72186a10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18%" :db/id #edb/ref 17592186486145} {:answer/id #uuid "fe145326-bfbc-57f0-be57-4357a75e5373" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15%" :db/id #edb/ref 17592186486228}] :answer-field/correct {:answer/id #uuid "891a0519-5699-5997-9688-80da5e4b5a77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27%" :db/id #edb/ref 17592186486007} :answer-field/id #uuid "54555888-2f4a-506a-879f-422748de22f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486274}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3a5e4afd-b3bf-55da-bca0-9104ea0bafe7" :question/math-academy-id "q-327574" :question/problem "Fitness class enrollment grew to $180%$ of the baseline. Of those enrolled, $15%$ chose yoga. What percentage of the baseline chose yoga?" :question/worked-solution "Let $x$ be the baseline enrollment.\n\nWe're told that enrollment grew to $180%$ of the baseline. Thus, the new enrollment is $1.8x.$\n\nWe are also told that of those enrolled, $15%$ chose yoga. So, the number of people who chose yoga is\n\n$$\n0.15(1.8x)=0.27x.\n$$\n\nThe expression $0.27x$ represents $27%$ of $x.$ Therefore, $27%$ of the baseline chose yoga."}] [{:db/id #edb/ref 17592186486404 :knowledge-point/_questions [{:db/id #edb/ref 17592186229194 :knowledge-point/id #uuid "3852a0f9-f1ac-5a3f-9883-8dd2ee03e332" :knowledge-point/title "Applying Subsequent Percentages in Real-World Situations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aad0335b-1731-5695-976a-b24de2193429" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4800" :db/id #edb/ref 17592186486073}] :answer-field/correct {:answer/id #uuid "aad0335b-1731-5695-976a-b24de2193429" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4800" :db/id #edb/ref 17592186486073} :answer-field/id #uuid "3e451071-6119-5fde-945d-d4fcf665d96a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186486264}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7e4472fc-358a-5367-8f2d-7c530ac4418c" :question/math-academy-id "q-328004" :question/problem "A museum’s attendance decreased to $80%$ of its previous level. Then, a promotion increased attendance by $25%.$ If the museum originally had $24,000$ attendees, how many attendees were added by the promotion?\n\nThe number of attendees added is  \n{{field-1}}." :question/worked-solution "First, the new attendance is $80%$ of the previous level $(24,000$ attendees$):$\n\n$$\n\\begin{aligned}80%\\times 24,000 & =\\frac{80}{100}\\times 24,000 \\\\  & =0.8\\times 24,000 \\\\  & =19,200\\end{aligned}\n$$\n\nSo, the new attendance is $19,200.$ Then, the attendees added by the promotion is $25%$ of this new attendance:\n\n$$\n\\begin{aligned}25%\\times 19,200 & =\\frac{25}{100}\\times 19,200 \\\\  & =0.25\\times 19,200 \\\\  & =4,800\\end{aligned}\n$$\n\nTherefore, the number of attendees added is $4,800.$"}]}
