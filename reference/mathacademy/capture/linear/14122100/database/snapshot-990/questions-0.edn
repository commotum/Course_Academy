#edb/ref 17592186200352} {:answer/id #uuid "7e60faa8-79ef-5f09-a1e6-495e7d61d68d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2, 8)" :db/id #edb/ref 17592186200353}] :answer-field/id #uuid "c13591d6-cf1c-5994-b061-a9d0ba237030" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186200348}] :question/id #uuid "9a0247d0-2902-5cf0-983e-f6aaa39592e8" :question/math-academy-id "q-213430" :question/problem "Consider the following relation defined on the set $A = {2, 4, 8}$.\n$R = {(2, 2), (2, 4), (2, 8), (4, 2), (4, 4), (4, 8)}$\nSelect the options that make the following reasoning correct:\n\nIn this relation, for all $x, y, z ∈ A$, we have\n$∈ \\mid$ {{field-1}} {{field-2}} {{field-3}}\n\nTherefore, the relation is\n{{field-4}}.\n\nFor example, since $(2, 4)$ and $(4, 8)$ belong to $R$, transitivity of $R$ requires\n{{field-5}}\n$∈ R$."}] [{:db/id #edb/ref 17592186204266 :knowledge-point/_questions [{:db/id #edb/ref 17592186203885 :knowledge-point/id #uuid "004a102d-cfb9-539a-9fdd-11ca604fd7ec" :knowledge-point/title "Identifying Transitive Relations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b40c224f-cb87-5146-a59b-d749d15a595b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "transitive" :db/id #edb/ref 17592186200355} {:answer/id #uuid "138684d9-07c7-54c1-8593-e630603d9770" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "not transitive" :db/id #edb/ref 17592186200356}] :answer-field/id #uuid "5e095d99-8463-50ec-a15f-b7361c627474" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186200354} {:answer-field/choices [{:answer/id #uuid "c6ad9419-d8c6-5f70-b96c-238b75216714" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2, 3)" :db/id #edb/ref 17592186200358} {:answer/id #uuid "4d308996-8382-5967-bbe6-d16878e26117" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1, 2)" :db/id #edb/ref 17592186200359}] :answer-field/id #uuid "30641df4-2fc7-5627-931f-e4c747308dc4" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186200357} {:answer-field/choices [{:answer/id #uuid "d52c0867-d82b-5d4b-9627-fc541725b5dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2, 1)" :db/id #edb/ref 17592186200361} {:answer/id #uuid "f9b8effd-ad6f-54d7-a344-fb872e5cf2e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1, 2)" :db/id #edb/ref 17592186200362}] :answer-field/id #uuid "76732a62-eba6-5f38-871f-c684b23eeb13" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186200360} {:answer-field/choices [{:answer/id #uuid "f94e556c-de7b-501d-9b33-6f89efb0a38e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2, 2)" :db/id #edb/ref 17592186200364} {:answer/id #uuid "05117f31-81b5-5bf0-b50b-c487230da0e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1, 3)" :db/id #edb/ref 17592186200365}] :answer-field/id #uuid "077c8fda-501b-5bae-9271-f9e8d955c9cc" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186200363}] :question/id #uuid "4470ad24-c221-5b90-921e-3633822b45db" :question/math-academy-id "q-213431" :question/problem "Consider the following relation defined on the set $A = {1, 2, 3}$.\n$R = {(1, 1), (1, 2), (1, 3), (2, 1), (2, 3), (3, 2), (3, 3)}$\nSelect the options that make the following reasoning correct:\n\nSince\n{{field-1}}\n$∈ R$ and\n{{field-2}}\n$∈ R$, but\n{{field-3}}\n$∉ R$, the relation is\n{{field-4}}."}]}
