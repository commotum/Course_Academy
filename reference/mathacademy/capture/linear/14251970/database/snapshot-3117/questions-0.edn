#{[{:db/id #edb/ref 17592186572727 :knowledge-point/_questions [{:db/id #edb/ref 17592186115293 :knowledge-point/id #uuid "d0c71e95-0a4a-547f-aaf0-774c6fe694a4" :knowledge-point/title "Graphing a Factored Cubic Curve with a Negative Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e8d4033-f315-5068-b4e7-7a561cacc09c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3c/3c5b751fa88a63ae10d0118c7ad05f883b4f16f739d895690a3ad5f1c241989b.png" :db/id #edb/ref 17592186572330} {:answer/id #uuid "43dc7a04-fefa-5f41-a95c-9ce5149a4c8d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6d/6dfc86cf107cc6d37fe64b7efb852213027889bf55a001d5c751f45fd2ae7d7f.png" :db/id #edb/ref 17592186572397} {:answer/id #uuid "ab057bb4-1fee-521c-b644-b78006739dc4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d5/d5f1625d33687f4053f3a5fd20dbf55aa0889bbdd57c266817f9396f47d27331.png" :db/id #edb/ref 17592186572499} {:answer/id #uuid "d692479a-cac9-5f6d-a067-421b5a18ccaa" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3e/3e6be7a333ce5a8d473da4fe54b11888c4e536220a085680a2f2782d953e1dcf.png" :db/id #edb/ref 17592186572553} {:answer/id #uuid "f866ab0a-1204-5a1f-9d28-44d47976870a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/20/20ba88abb40a98b3d832402627568a1536abde65018e09cce9c89e184128132b.png" :db/id #edb/ref 17592186572584}] :answer-field/correct {:answer/id #uuid "f866ab0a-1204-5a1f-9d28-44d47976870a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/20/20ba88abb40a98b3d832402627568a1536abde65018e09cce9c89e184128132b.png" :db/id #edb/ref 17592186572584} :answer-field/id #uuid "d6576acb-ee3e-5578-a842-e3188dc1a132" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572651}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f860d929-2f10-587c-a6b0-b33c9769a489" :question/math-academy-id "q-28199" :question/problem "Which of the following curves is generated by $y=f(x)$ where $f(x)=(3-x)(1-x)^{2}?$" :question/worked-solution "The equation is already in factored form, so by the zero-product rule, we deduce that it has a single root at $x=3$ and a double root at $x=1.$ \n\nWe also find the $y$-intercept of the curve by substituting the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =(3-0)(1-0)^{2} \\\\  & =(3)(1)^{2} \\\\  & =3.\\end{aligned}\n$$\n\nSo, the curve\n\n- intercepts the $y$-axis at the point $(0,3),$\n\n- passes through the $x$-axis at the single root $x=3,$ and\n\n- touches the $x$-axis and turns around at the double root $x=1.$\n\nNotice that the leading coefficient is *negative*:\n\n$$\n\\begin{aligned}f(x) & =(3-x)(1-x)^{2} \\\\  & =(3-x)({x}^{2}-2x+1) \\\\  & =-{x}^{3}+⋯\\end{aligned}\n$$\n\n![](images/20/20ba88abb40a98b3d832402627568a1536abde65018e09cce9c89e184128132b.png)"}] [{:db/id #edb/ref 17592186115692 :knowledge-point/_questions [{:db/id #edb/ref 17592186115292 :knowledge-point/id #uuid "e7ca7245-a828-5bbf-9a6a-dcd1938333a2" :knowledge-point/title "Graphing an Expanded Cubic Curve with a Positive Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3d6467f-ccb8-56b1-a6ab-ea109313614d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/80/80b0d56b4a2234f6e4b54099b00df7c791340fdb1e4089b079a76f22b05fdd8a.png" :db/id #edb/ref 17592186113119} {:answer/id #uuid "d428e9ce-a344-59f7-91cc-a1de328d40ee" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/be/be09c325e7e03e1778ece845ad7798cc0a91fd462f39ac4caf286f405f259861.png" :db/id #edb/ref 17592186113120} {:answer/id #uuid "1b40b956-2d4c-58ba-8c4b-1a0bcb6c425d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/62/62f553fa88886b59f8a19ad48a4209dc92818e520cea281520a28119fd3e766d.png" :db/id #edb/ref 17592186113121} {:answer/id #uuid "331683f2-0620-5d4c-8351-45f6e6a7ba94" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d6/d69d24af14d0683c3dad81de3c7b12ddb6c03150686ab59ca5ea703db3e7c054.png" :db/id #edb/ref 17592186113122} {:answer/id #uuid "748b439a-a5ea-577e-93d4-21798af12f30" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/43/430eb562fa8d48f5ff7b25cf7fc83ba0ff84e08de78a87ad9a6e7d5ab22fa14e.png" :db/id #edb/ref 17592186113123}] :answer-field/id #uuid "ebe372c9-c5f0-5df0-bda1-9368baa4af3d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113118}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "014bdfc5-b701-5497-bf35-6569cca2f837" :question/math-academy-id "q-28515" :question/problem "Given that $(x + 5)$ is a factor of $f(x) = x^{3} + 7x^{2} + 11x + 5$, which of the following curves is generated by $y = f(x)$?\n\n(*Note: Figures not drawn to scale*)"}] [{:db/id #edb/ref 17592186572662 :knowledge-point/_questions [{:db/id #edb/ref 17592186115294 :knowledge-point/id #uuid "6c85a009-fe0d-5c56-ac1d-a2a00002f94e" :knowledge-point/title "Graphing an Expanded Cubic Curve with a Negative Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "163a3c39-b596-599d-9c26-41996cf4088a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/72/7275f0118937d84ac1ce42285ad2c6d6958ef925bb4a4387f95d51ae3d4059bd.png" :db/id #edb/ref 17592186572341} {:answer/id #uuid "35e7bb1b-0c0f-58f1-ae98-babedb00830d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/99/991935a5888ea1becd78ff7f420114b5221d951a271667d643fd377d7dff1f6d.png" :db/id #edb/ref 17592186572380} {:answer/id #uuid "4d5f8551-e61e-5d3a-b47a-6377f4a68f59" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c0/c084c0059cecb1fa33430bc3761a4e5fbe23a44f3db59d61b9f2acfc74a87fa7.png" :db/id #edb/ref 17592186572410} {:answer/id #uuid "bb957a48-c507-57d8-889a-32e9e0971c79" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/15/15fbaca7ca27b09be9122c5a33a9fdd4ce93999a419d9fb9f97601cf94018143.png" :db/id #edb/ref 17592186572524} {:answer/id #uuid "eb2f28cd-c700-5f76-b55a-b8e321d6abe5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/92/92458bf99d2c9ac6bf226020a91cc1b9a7d0fde096711db153fe3a8be88f4490.png" :db/id #edb/ref 17592186572571}] :answer-field/correct {:answer/id #uuid "4d5f8551-e61e-5d3a-b47a-6377f4a68f59" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c0/c084c0059cecb1fa33430bc3761a4e5fbe23a44f3db59d61b9f2acfc74a87fa7.png" :db/id #edb/ref 17592186572410} :answer-field/id #uuid "00f9b105-8b22-52e2-972a-ee7a0aed6cbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572588}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "024af745-75a4-59f6-8f6d-ac762eef1195" :question/math-academy-id "q-75163" :question/problem "Given that $x+3$ is a factor of $f(x)=-{x}^{3}-7{x}^{2}-15x-9$, which of the following curves is generated by $y=f(x)?$\n\n*(Note: Figures not drawn to scale)*" :question/worked-solution "First, we need to factor the polynomial. We are told that $(x+3)$ is a factor of $f(x),$ so $(x+3)$ divides $f(x)$ with zero remainder. To begin factoring $f(x),$ we can divide it by $(x+3)$ using synthetic division:\n\n$$\n\\begin{aligned} & {x}^{3} & {x}^{2} & {x}^{1} & {x}^{0} \\\\ -3 & -1 & -7 & -15 & -9 \\\\  &  & 3 & 12 & 9 \\\\  & -1 & -4 & -3 & 0\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{f(x)}{x+3} & =-{x}^{2}-4x-3 \\\\  & =-({x}^{2}+4x+3)\\end{aligned}\n$$\n\nwhich means that\n\n$$\nf(x)=-(x+3)({x}^{2}+4x+3).\n$$\n\nWe can factor the quadratic factor even further, and get\n\n$$\nf(x)=-(x+3)(x+1)(x+3)=-(x+1)(x+3)^{2}\n$$\n\nNow that we have the cubic in factored form, we can tell that it has a single root at $x=-1$ and a double root at $x=-3.$\n\nWe also find the $y$-intercept of the curve by substituting the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =-(0+1)(0+3)^{2} \\\\  & =-(1)(3)^{2} \\\\  & =-9.\\end{aligned}\n$$\n\nSo, the curve\n\n- intercepts the $y$-axis at $(0,-9),$\n\n- passes through the $x$-axis at the single root $x=-1,$ and\n\n- touches the $x$-axis and turns around at the double root $x=-3.$\n\nBecause the leading coefficient is negative, the graph takes an $\\text{S}$-shape. Therefore, the graph looks as follows:\n\n![](images/c0/c084c0059cecb1fa33430bc3761a4e5fbe23a44f3db59d61b9f2acfc74a87fa7.png)"}]}
