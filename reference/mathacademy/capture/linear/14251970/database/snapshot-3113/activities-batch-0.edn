#{[{:activity/expected-seconds 900.0 :activity/first-step {:db/id #edb/ref 17592186116196} :activity/id #uuid "8e8cb555-3959-5624-b2af-9cd0a96a3927" :activity/scope {:db/id #edb/ref 17592186048799 :topic/id #uuid "bffe508c-6169-5e70-a9ff-c914833ff054" :topic/math-academy-id 1656} :activity/steps [{:db/id #edb/ref 17592186116196 :step/content {:db/id #edb/ref 17592186116521 :tutorial/content "The graph of any cubic function $y = f(x)= ax^3 + bx^2 + cx +d,$ where $a >0,$ has a characteristic inverted ${\\textsf{S}}$-shape, with $y$-values ranging from $-\\infty$ to $+\\infty.$ This means that every such function has *at least* one real root and *at most* three distinct roots. \n\nFor instance, suppose that we want to plot the graph of $y = x^3-4x^2 +4x.$ First, we need to find the roots, so we set $y=0$ and solve:\n\n$$\n\\begin{aligned}{x}^{3}-4{x}^{2}+4x & =0 \\\\ x({x}^{2}-4x+4) & =0 \\\\ x(x-2)^{2} & =0\\end{aligned}\n$$\n\nBy the zero-product rule, we get two distinct roots: $x=0$ and $x=2.$\n\n- The root $x=0$ is a *single* root: it has multiplicity ${\\color{blue}1}$ because it comes from a factor $x^{\\color{blue}1}$ whose exponent is ${\\color{blue}1}.$\n\n- The root $x=2$ is a *double* root: it has multiplicity ${\\color{blue}2}$ because it comes from a factor $(x-2)^{\\color{blue}2}$ whose exponent is ${\\color{blue}2}.$\n\nTo graph the curve, we use the following principles:\n\n- The curve passes through the $x$-axis at the single root (in this case, $x=0$).\n\n- The curve touches the $x$-axis and turns around at the double root (in this case, $x=2$).\n\nBecause the leading coefficient is positive, the graph takes an inverted ${\\textsf{S}}$-shape. Therefore, the graph looks as follows:\n\n![](images/9d/9d3c04ff9f84bef0499b30dfd51da7efd21afe48ad323e57ff8ae9cf6a999fe7.png)" :tutorial/id #uuid "e64a052e-933d-5f77-917c-4573706cf30a" :tutorial/math-academy-id 3751 :tutorial/title "Introduction"} :step/id #uuid "28294870-c0d2-50bc-b203-ef11d392a7b8" :step/math-academy-id 21021 :step/next {:db/id #edb/ref 17592186116199}} {:db/id #edb/ref 17592186116199 :step/content {:db/id #edb/ref 17592186115290 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115112 :question/id #uuid "63ff719f-1f54-5370-854e-480379c93e96" :question/math-academy-id "e-5802"} :knowledge-point/id #uuid "0187a97f-58b6-5b57-aaf9-ef89c90383f8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048691}] :knowledge-point/questions [{:db/id #edb/ref 17592186115659} {:db/id #edb/ref 17592186115695} {:db/id #edb/ref 17592186557265}] :knowledge-point/title "Graphing a Factored Cubic Curve with a Positive Leading Coefficient"} :step/id #uuid "41bbd401-0e7d-590e-87ae-409964b3d065" :step/math-academy-id 21024 :step/next {:db/id #edb/ref 17592186116201}} {:db/id #edb/ref 17592186116201 :step/content {:db/id #edb/ref 17592186115292 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115115 :question/id #uuid "1877c35b-7b3a-55dd-a81e-2b98cf3572bd" :question/math-academy-id "e-5805"} :knowledge-point/id #uuid "e7ca7245-a828-5bbf-9a6a-dcd1938333a2" :knowledge-point/questions [{:db/id #edb/ref 17592186115660} {:db/id #edb/ref 17592186115692} {:db/id #edb/ref 17592186557235} {:db/id #edb/ref 17592186557328}] :knowledge-point/title "Graphing an Expanded Cubic Curve with a Positive Leading Coefficient"} :step/id #uuid "1b9fe28e-6cef-570d-aa37-f179e506c256" :step/math-academy-id 21026 :step/next {:db/id #edb/ref 17592186116202}} {:db/id #edb/ref 17592186116202 :step/content {:db/id #edb/ref 17592186116522 :tutorial/content "The graph of any cubic function $y = f(x)= ax^3 + bx^2 + cx +d,$ where $a <0,$ has a characteristic ${\\textsf{S}}$-shape, with $y$-values ranging from $+\\infty$ to $-\\infty.$\n\nFor instance, suppose that we want to plot the graph of $y = -x^3+8x^2-16x.$ Then we set $y=0$ to find the roots as follows:\n\n$$\n\\begin{aligned}-{x}^{3}+8{x}^{2}-16x & =0 \\\\ -x({x}^{2}-8x+16) & =0 \\\\ -x(x-4)^{2} & =0\\end{aligned}\n$$\n\nBy the zero-product rule, we get two distinct roots: $x=0$ and $x=4,$ where $x=0$ is a single root and $x=4$ is a double root.\n\nTo graph the curve, we use the following principles:\n\n- The curve passes through the $x$-axis at the single root (in this case, $x=0$).\n\n- The curve touches the $x$-axis and turns around at the double root (in this case, $x=4$).\n\nBecause the leading coefficient is negative, the graph takes an ${\\textsf{S}}$-shape. Therefore, the graph looks as follows:\n\n![](images/21/215fe4cdd8949bd91e826b3c1410c20d459557a4681fa856d02b9cfb6ab0b059.png)" :tutorial/id #uuid "baafc1fb-36f6-5c78-9186-9d3cd4e85214" :tutorial/math-academy-id 3753 :tutorial/title "Negative Cubic Curves With a Double Root"} :step/id #uuid "dc7caa78-bac7-5698-a505-e6c8c0a3e056" :step/math-academy-id 21028 :step/next {:db/id #edb/ref 17592186116203}} {:db/id #edb/ref 17592186116203 :step/content {:db/id #edb/ref 17592186115293 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115116 :question/id #uuid "0ef12435-c090-5766-a58a-f913d6e02421" :question/math-academy-id "e-5807"} :knowledge-point/id #uuid "d0c71e95-0a4a-547f-aaf0-774c6fe694a4" :knowledge-point/questions [{:db/id #edb/ref 17592186115668} {:db/id #edb/ref 17592186115697} {:db/id #edb/ref 17592186557316} {:db/id #edb/ref 17592186557334}] :knowledge-point/title "Graphing a Factored Cubic Curve with a Negative Leading Coefficient"} :step/id #uuid "e4db3126-31d4-555b-932d-7275d17b2893" :step/math-academy-id 21030 :step/next {:db/id #edb/ref 17592186116204}} {:db/id #edb/ref 17592186116204 :step/content {:db/id #edb/ref 17592186115294 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115117 :question/id #uuid "35d9d449-6508-5461-89bb-d56c262e6bd0" :question/math-academy-id "e-5809"} :knowledge-point/id #uuid "6c85a009-fe0d-5c56-ac1d-a2a00002f94e" :knowledge-point/questions [{:db/id #edb/ref 17592186115661} {:db/id #edb/ref 17592186115951} {:db/id #edb/ref 17592186557280} {:db/id #edb/ref 17592186557333}] :knowledge-point/title "Graphing an Expanded Cubic Curve with a Negative Leading Coefficient"} :step/id #uuid "da8c998a-2ab7-5d30-ad99-954acacda25e" :step/math-academy-id 21031}] :activity/title "Graphing Cubic Curves Containing a Double Root" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115448}]}
