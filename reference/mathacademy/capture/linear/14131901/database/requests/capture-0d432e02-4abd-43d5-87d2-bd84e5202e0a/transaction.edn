ae3e43338ca5368b6f7a31063ad.png" :db/ensure [:answer/validate]} {:db/id "answer-0a2b823b-5463-5d20-82db-4d5481b520f4" :answer/id #uuid "0a2b823b-5463-5d20-82db-4d5481b520f4" :answer/type :answer.type/image :answer/value "images/d0/d0076450a7583f48e9763eb845ec635cbff525b7c7605ab358bcfbfb9dc71514.png" :db/ensure [:answer/validate]} {:db/id "answer-b279ef10-3cba-574e-b622-e93897a51231" :answer/id #uuid "b279ef10-3cba-574e-b622-e93897a51231" :answer/type :answer.type/image :answer/value "images/e6/e6f44210fe2cbfc08a2222e619b30dfdde64e845e0ffa3b44d8f44d090513dab.png" :db/ensure [:answer/validate]} {:db/id "question-7d88fa90-2961-5af1-aecf-00233f17ae7f" :question/id #uuid "7d88fa90-2961-5af1-aecf-00233f17ae7f" :question/math-academy-id "q-114726" :question/problem "![](images/cc/ccf325ba952371d7ebb1e97eecdbc964a8c877623a3725f5dc7f8599ef6e1a13.png)\n\nWhat type of angle is $∠QPR,$ shown in the figure above?" :question/worked-solution "Notice that the vertex of $∠QPR$ is point $P,$ not point $R.$ So $∠QPR$ is *not* a straight angle.\n\nWe can think of $∠QPR$ as:\n\n- a *null* angle, if we assume that it doesn't turn at all (diagram on the left), or\n\n- a *full* angle, if we assume that it makes one full turn (diagram on the right).\n\n![](images/25/25de8b3fe57372fb5371a6aaf0f14933f1616e33f2c093c9de32c594b57829f4.png)\n\nSo, the answer is 'Null' or 'Full'." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-509427ae-ee21-5cc6-8174-6b57cc63ad1e"] :db/ensure [:question/validate]} {:db/id "answer-field-509427ae-ee21-5cc6-8174-6b57cc63ad1e" :answer-field/id #uuid "509427ae-ee21-5cc6-8174-6b57cc63ad1e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-24d0a706-cb3a-5b0e-9560-36044c90c85d" :answer-field/choices ["answer-d53144d2-e238-57e8-85d5-4a0cdbc1fab8" "answer-24d0a706-cb3a-5b0e-9560-36044c90c85d" "answer-eb6d9f18-1923-502a-8288-ff8f30c229c3" "answer-d03c3a92-f7e4-5e74-a82b-0e955bccc