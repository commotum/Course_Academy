/9cd768b4361e95a18ffa52d6315fb5ea6cd0cf6784bc4c9e12b1bae1f6566755.png)\n\nSo, the answer is \"Null\" or \"Full.\"" :db/ensure [:question/validate]} {:db/id "question-182c93bb-16c2-52b7-9803-fb5ecfba0365" :question/id #uuid "182c93bb-16c2-52b7-9803-fb5ecfba0365" :question/math-academy-id "q-150790" :question/problem "Which of the following is the closest to a right angle?" :question/worked-solution "A right angle has a degree measure of ${90}^{∘}.$ This corresponds to one-quarter of a full turn.\n\nAmong the given options, the closest to a right angle is the following:\n\n![](images/cd/cd1fe51ec4713f7ed35777977d956295553031979d312a45f52f386ef04a4922.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-4d66ef95-ce01-5473-9edf-05dcdf8d6d4e"] :db/ensure [:question/validate]} {:db/id "answer-field-4d66ef95-ce01-5473-9edf-05dcdf8d6d4e" :answer-field/id #uuid "4d66ef95-ce01-5473-9edf-05dcdf8d6d4e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5f1260c5-9a27-51ce-9867-568cd8b6fbac" :answer-field/choices ["answer-c2521959-a222-59dd-9c38-bd594cf08ca4" "answer-5f1260c5-9a27-51ce-9867-568cd8b6fbac" "answer-2df44ca9-a146-585a-b09b-439ad6a7d688" "answer-80c0b8a2-c74a-5c8a-ae6a-baa039c6fa08" "answer-1598b161-9b69-5504-b9c5-fb47e08d4603"] :db/ensure [:answer-field/validate]} {:db/id "answer-c2521959-a222-59dd-9c38-bd594cf08ca4" :answer/id #uuid "c2521959-a222-59dd-9c38-bd594cf08ca4" :answer/type :answer.type/image :answer/value "images/5b/5b44d83ded95fc2dd37f94d75931a9b31ec40fc2ba76e5ca4541df15449e24df.png" :db/ensure [:answer/validate]} {:db/id "answer-5f1260c5-9a27-51ce-9867-568cd8b6fbac" :answer/id #uuid "5f1260c5-9a27-51ce-9867-568cd8b6fbac" :answer/type :answer.type/image :answer/value "images/8a/8a6eeac1bed2046dcf91660384cb49562bb13cf1e59a9037e4e5fb501e92583d.png" :db/ensure [:answer/validate]} {:db/id "answer-2df44ca9-a146-585a-b09b-439ad6a7d688" :answer/id #uuid "2df44ca9-a146-58