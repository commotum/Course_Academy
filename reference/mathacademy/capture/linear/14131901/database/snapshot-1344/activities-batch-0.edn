#{[{:activity/first-step {:db/id #edb/ref 17592186111728} :activity/id #uuid "e304faa7-71b9-5828-9e54-310c7f686f0d" :activity/scope {:db/id #edb/ref 17592186048723 :topic/id #uuid "b88bb3f7-4ab2-5a90-86dd-55c2878b20d0" :topic/math-academy-id 1509} :activity/steps [{:db/id #edb/ref 17592186111611 :step/content {:db/id #edb/ref 17592186110672 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110293 :question/id #uuid "afde7d46-5a88-5ec8-b86f-32d126a36258" :question/math-academy-id "e-10595"} :knowledge-point/id #uuid "6d203cc5-4e76-5f78-b431-b357164de3f9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048587}] :knowledge-point/questions [{:db/id #edb/ref 17592186110921} {:db/id #edb/ref 17592186110922} {:db/id #edb/ref 17592186110923}] :knowledge-point/title "Identifying Right Angles"} :step/id #uuid "46ebc539-57b3-5556-981c-c8b83bb8d7f6" :step/math-academy-id 40054 :step/next {:db/id #edb/ref 17592186111612}} {:db/id #edb/ref 17592186111612 :step/content {:db/id #edb/ref 17592186110673 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110294 :question/id #uuid "5427c83b-5f34-57fa-b56c-a0c190e74348" :question/math-academy-id "e-10596"} :knowledge-point/id #uuid "f5701fed-0320-54da-8983-71c572ab1e8f" :knowledge-point/questions [{:db/id #edb/ref 17592186110924} {:db/id #edb/ref 17592186110925} {:db/id #edb/ref 17592186110926}] :knowledge-point/title "Identifying Straight Angles"} :step/id #uuid "a1fd3388-710f-5be2-bb9b-e0952aac5833" :step/math-academy-id 40055 :step/next {:db/id #edb/ref 17592186111746}} {:db/id #edb/ref 17592186111728 :step/content {:db/id #edb/ref 17592186111837 :tutorial/content "Some angles have special names.\n\n- A **right angle** has a measure of $90^\\circ$. It corresponds to one-quarter of a full turn.![](images/15/155a1d6d2abd868b05674dec47ef4b20a5147d30cd328a5ba53d00dea271d65c.png)\n- A **straight angle**, which is just a straight line, has a measure of $180^\\circ$. It corresponds to one-half of a full turn.![](images/24/2423950f80de8354aee74c4f1daa6e42cf376caa0365307c76ebc7e09f96c8cf.png)\n\n- A **null angle** has a measure of $0^\\circ$. You can imagine \"closing\" the angle until the two sides of the angle overlap. In this case, we don't have any turn, so its measure is zero!![](images/f8/f86b7c1b7ba758fb6b07b6aeabd03395d29103b45e4cd220444b675f70a6e630.png)\n- A **full angle** has a measure of $360^\\circ$. You can imagine \"opening\" the angle until one of the sides goes all the way around. So, this is the angle between a ray and itself after it has made one full turn.![](images/cb/cbc9e288f4d3905357539a221954328ef0ac799531fab62f034364d32a7c0f29.png)\n\nOn a diagram, null and full angles can look the same, so it is up to us what we choose to call it." :tutorial/id #uuid "74e7b6f4-d873-55dc-81f9-6bf4148828b1" :tutorial/math-academy-id 2178 :tutorial/title "Introduction"} :step/id #uuid "73c2d122-acf8-55a5-835f-6ae907dc910c" :step/math-academy-id 8748 :step/next {:db/id #edb/ref 17592186111611}} {:db/id #edb/ref 17592186111746 :step/content {:db/id #edb/ref 17592186110763 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110392 :question/id #uuid "154c65b2-4d51-5da0-b00c-293f3fba3bd0" :question/math-academy-id "e-2604"} :knowledge-point/id #uuid "3b4df4d5-4ffc-53f0-8207-f710351f7456" :knowledge-point/questions [{:db/id #edb/ref 17592186111240} {:db/id #edb/ref 17592186111251}] :knowledge-point/title "Identifying Null and Full Angles"} :step/id #uuid "07919ee0-ec2e-550b-8146-bd88c640d46f" :step/math-academy-id 8781}] :activity/title "Right, Straight, Full, and Null Angles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110864}]}
