  "html": "<div id=\"step-40055\" class=\"step\" style=\"display: block\" stepid=\"40055\" steptype=\"example\" contentid=\"10596\">\n            <div class=\"stepHeader\">\n                <div class=\"stepName\">\n                    Example: \n                    <a id=\"stepAnchor-40055\" class=\"stepAnchor\" style=\"font-weight: normal;\" name=\"step-6\">Identifying Straight Angles</a> \n                </div>      \n                <div class=\"helpButton\" stepid=\"40055\">?</div>\n            </div>\n            \n            <div class=\"exampleQuestion\">\n                <p>Which of the following shows a straight angle?</p>\n<div id=\"graphic-e5163da52d7b58149b9070a20d12b6f2\" class=\"graphic\"><img src=\"/graphics/e5163da52d7b58149b9070a20d12b6f2\"></div> \n            </div>     \n\n            <div class=\"explanationHeader\">EXPLANATION</div>\n\n            <div class=\"exampleExplanation\">\n                <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                            float: none;\n                            directio