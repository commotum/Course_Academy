        "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14131901/observations/step-t2178-b84885676e8a00d6c561.html",
        "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14131901/observations/step-t2178-b84885676e8a00d6c561.png",
        "source_url": "https://mathacademy.com/tasks/14131901/topics/1509/lesson",
        "captured_at": 1791784846.5948768,
        "math_academy_id": "2178",
