          "html": "<div id=\"step-q150801\" class=\"step questionWidget\" style=\"display: block;\"><div class=\"questionWidget-header\"><div class=\"questionWidget-title\">Question 8</div><div class=\"questionWidget-helpButton\">?</div></div><div class=\"questionWidget-text\"><p>Which of the following shows a straight angle?</p>\n</div><table class=\"questionWidget-choicesTable\"><tbody><tr><td class=\"questionWidget-choiceLetter\"><div id=\"questionWidget-choiceLetterCircle-150801-a\" class=\"questionWidget-choiceLetterCircle\">a</div></td><td class=\"questionWidget-choiceText\"><img src=\"/graphics/q-150801-a-5\"> </td></tr><tr><td class=\"questionWidget-choiceLetter\"><div id=\"questionWidget-choiceLetterCircle-150801-b\" class=\"questionWidget-choiceLetterCircle\">b</div></td><td class=\"questionWidget-choiceText\"><img src=\"/graphics/q-150801-a-2\"></td></tr><tr><td class=\"questionWidget-choiceLetter\"><div id=\"questionWidget-choiceLetterCircle-150801-c\" class=\"questionWidget-choiceLetterCircle\">c</div></td><td class=\"questionWidget-choiceText\"><img src=\"/graphics/q-150801-a-3\"></td></tr><tr><td class=\"questionWidget-choiceLetter\"><div id=\"questionWidget-choiceLetterCircle-150801-d\" class=\"questionWidget-choiceLetterCircle\">d</div></td><td class=\"questionWidget-choiceText\"><img src=\"/graphics/q-150801-a-4\"></td></tr><tr><td class=\"questionWidget-choiceLetter\"><div id=\"questionWidget-choiceLetterCircle-150801-e\" class=\"questionWidget-choiceLetterCircle\" style=\"background: rgb(64, 64, 64); color: white;\">e</div></td><td class=\"questionWidget-choiceText\"><img src=\"/graphics/q-150801-a-1\"></td></tr></tbody></table><div class=\"questionWidget-buttonBar\"><div class=\"questionWidget-submitButton disabledButton\" style=\"display: none;\">Submit</div></div><div class=\"questionWidget-spinnerFrame\"><div class=\"questionWidget-spinner\" style=\"display: block;\"></div></div><div class=\"questionWidget-result\"><div class=\"questionWidget