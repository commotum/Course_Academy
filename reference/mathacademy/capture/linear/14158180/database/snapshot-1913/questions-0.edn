#{[{:db/id #edb/ref 17592186063991 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064232 :knowledge-point/id #uuid "288c08af-0583-5588-b767-4254544cf70c" :knowledge-point/title "Squaring Linear Binomials"}] :question/id #uuid "70f19ea4-d0b8-537a-8ae4-06a236cf37cf" :question/math-academy-id "e-14318" :question/problem "Expand $(4+3y)^2$." :question/worked-solution "We will use the following formula:\n\n$$\n(a+b)^2 = a^2 + 2ab + b^2\n$$\n\nSubstituting $a=4$ and $b=3y$, we have\n\n$$\n\\begin{aligned} (4 + 3y)^2 \\\\ &= (4)^2 + 2(4) (3y) + (3y)^2 \\\\ &= 16 + 24y + 9y^2. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063992 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064233 :knowledge-point/id #uuid "63291c46-6a0f-5e7c-ab0a-acba80fe58f3" :knowledge-point/title "Squaring Nonlinear Binomials"}] :question/id #uuid "c1a6df9e-b1e8-51c8-b5df-4cc624e14193" :question/math-academy-id "e-14319" :question/problem "Expand $(2n^2 + 3)^2$." :question/worked-solution "We will use the following formula:\n\n$$\n(a+b)^2 = a^2 + 2ab + b^2\n$$\n\nSubstituting $a=2n^2$ and $b=3$, we have\n\n$$\n\\begin{aligned} (2n^2 + 3)^2 \\\\[2pt] &= (2n^2)^2 + 2(2n^2) (3) + (3)^2 \\\\[2pt] &= 2^2\\cdot (n^2)^2 + 2(2n^2) (3) + (3)^2 \\\\[2pt] &= 4n^4 + 12n^2 + 9. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063993 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064234 :knowledge-point/id #uuid "afd30bc7-dce9-5e03-a213-2b9695e39091" :knowledge-point/title "Squaring Binomials With Subtraction"}] :question/id #uuid "487f1c4c-63c9-51cf-9a0e-7d9bc0a4c7c7" :question/math-academy-id "e-14320" :question/problem "Expand $(3p - 5)^2$." :question/worked-solution "We will use the following formula:\n\n$$\n(a-b)^2 = a^2 - 2ab + b^2\n$$\n\nSubstituting $a=3p$ and $b=5$, we have\n\n$$\n\\begin{aligned} (3p - 5)^2 \\\\ &= (3p)^2 - 2(3p)(5) + 5^2 \\\\ &= 9p^2 - 30p + 25. \\end{aligned}\n$$"}]}
