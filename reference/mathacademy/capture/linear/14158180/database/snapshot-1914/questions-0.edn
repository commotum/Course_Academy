592186482452}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cff0df09-cba2-54ca-961e-ef5673e7180f" :question/math-academy-id "q-31200" :question/problem "${({y}^{3}-2)}^{2}=$" :question/worked-solution "We will use the following formula:\n\n$$\n(a-b)^{2}={a}^{2}-2ab+{b}^{2}\n$$\n\nSubstituting $a={y}^{3}$ and $b=2,$ we have\n\n$$\n\\begin{aligned}({y}^{3}-2)^{2} & = \\\\ {({y}^{3})}^{2}-2({y}^{3})(2)+{2}^{2} & = \\\\ {y}^{6}-4{y}^{3}+4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186482578 :knowledge-point/_questions [{:db/id #edb/ref 17592186064232 :knowledge-point/id #uuid "288c08af-0583-5588-b767-4254544cf70c" :knowledge-point/title "Squaring Linear Binomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04417ca8-5b44-5f47-8588-203cc9670c83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{p}^{2}}{2}+\\frac{3}{4}p+\\frac{9}{2}" :db/id #edb/ref 17592186481779} {:answer/id #uuid "3b77de52-656a-5d60-a77d-89b9ba362ce9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{p}^{2}}{4}+\\frac{9}{4}" :db/id #edb/ref 17592186481921} {:answer/id #uuid "53a9e444-9bb4-5607-8e5c-dff301ba180a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{p}^{2}}{2}+3p+\\frac{9}{4}" :db/id #edb/ref 17592186481976} {:answer/id #uuid "c668be38-d1ab-5b18-93b6-f9c30310d732" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{p}^{2}}{2}+\\frac{9}{2}" :db/id #edb/ref 17592186482244} {:answer/id #uuid "f6ec47ef-9394-5b6f-bf61-3e7cfa86d762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{p}^{2}}{4}+\\frac{3}{2}p+\\frac{9}{4}" :db/id #edb/ref 17592186482360}] :answer-field/correct {:answer/id #uuid "f6ec47ef-9394-5b6f-bf61-3e7cfa86d762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{p}^{2}}{4}+\\frac{3}{2}p+\\frac{9}{4}" :db/id #edb/ref 17592186482360} :answer-field/id #uuid "bd6480f1-db17-5206-8b50-adeb65376df5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186482479}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ae2cfcdb-b465-5141-b188-02dc5998e9f5" :question/math-academy-id "q-33092" :question/problem "${(\\frac{p}{2}+\\frac{3}{2})}^{2}=$" :question/worked-solution "We will use the following formula:\n\n$$\n(a+b)^{2}={a}^{2}+2ab+{b}^{2}\n$$\n\nSubstituting $a=\\frac{p}{2}$ and $b=\\frac{3}{2},$ we have\n\n$$\n\\begin{aligned}{(\\frac{p}{2}+\\frac{3}{2})}^{2} & = \\\\ {(\\frac{p}{2})}^{2}+2(\\frac{p}{2})(\\frac{3}{2})+{(\\frac{3}{2})}^{2} & = \\\\ \\frac{{p}^{2}}{4}+\\frac{3}{2}p+\\frac{9}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186482604 :knowledge-point/_questions [{:db/id #edb/ref 17592186064233 :knowledge-point/id #uuid "63291c46-6a0f-5e7c-ab0a-acba80fe58f3" :knowledge-point/title "Squaring Nonlinear Binomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f787c0c-03cb-51f9-8e40-745ec4e996ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{8}+4{x}^{4}{c}^{2}+4{c}^{4}" :db/id #edb/ref 17592186481860} {:answer/id #uuid "50af92f8-3be6-5f37-a95a-564cc2728cb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}+2{x}^{2}c+4{c}^{2}" :db/id #edb/ref 17592186481970} {:answer/id #uuid "6388eb7c-5120-53e8-8fa8-8aaf0a0ed2df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{8}+4{c}^{4}" :db/id #edb/ref 17592186482003} {:answer/id #uuid "f2923cd2-3693-5a8f-a77b-6ef018432274" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}+4{c}^{2}" :db/id #edb/ref 17592186482352} {:answer/id #uuid "f644fa7e-46be-54d1-96a3-0962b9eead92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{8}+2{x}^{4}{c}^{2}+4{c}^{4}" :db/id #edb/ref 17592186482356}] :answer-field/correct {:answer/id #uuid "1f787c0c-03cb-51f9-8e40-745ec4e996ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{8}+4{x}^{4}{c}^{2}+4{c}^{4}" :db/id #edb/ref 17592186481860} :answer-field/id #uuid "aaa8c9ec-8ced-5a47-b6bc-575605ba1b5b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186482468}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e5bdd830-1ec1-554e-a24b-2d538b13172e" :question/math-academy-id "q-78931" :question/problem "${({x}^{4}+2{c}^{2})}^{2}=$" :question/worked-solution "We will use the following formula:\n\n$$\n(a+b)^{2}={a}^{2}+2ab+{b}^{2}\n$$\n\nSubstituting $a={x}^{4}$ and $b=2{c}^{2},$ we have\n\n$$\n\\begin{aligned}({x}^{4}+2{c}^{2})^{2} & = \\\\ {({x}^{4})}^{2}+2({x}^{4})(2{c}^{2})+(2{c}^{2})^{2} & = \\\\ {x}^{8}+4{x}^{4}{c}^{2}+4{c}^{4}.\\end{aligned}\n$$"}]}
