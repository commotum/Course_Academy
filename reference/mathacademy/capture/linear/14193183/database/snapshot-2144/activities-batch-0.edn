riangle"} :step/id #uuid "f44c88c0-d007-5fb1-91dc-27886bcbfdd5" :step/math-academy-id 186757 :step/next {:db/id #edb/ref 17592186074644}} {:db/id #edb/ref 17592186074644 :step/content {:db/id #edb/ref 17592186073744 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073510 :question/id #uuid "b015f8d6-ac1b-537d-a673-839fc7418f71" :question/math-academy-id "e-15572"} :knowledge-point/id #uuid "8b1f86d8-805c-55c7-8e8c-d96d99e3636b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048213} {:db/id #edb/ref 17592186050164}] :knowledge-point/questions [{:db/id #edb/ref 17592186074032} {:db/id #edb/ref 17592186074493} {:db/id #edb/ref 17592186488248} {:db/id #edb/ref 17592186488252} {:db/id #edb/ref 17592186506598}] :knowledge-point/title "Finding Angles in Triangles With Congruent Angles"} :step/id #uuid "9704d6d3-54b7-59b2-8573-6638158e9c8e" :step/math-academy-id 186761}] :activity/title "Interior Angles of Triangles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073929}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186506629} :activity/id #uuid "70f3ba64-46c6-5c7b-8a26-30ff5c2e8921" :activity/scope {:db/id #edb/ref 17592186049949 :topic/id #uuid "209a2a6e-0f67-50a5-9c80-5938225e61aa" :topic/math-academy-id 496} :activity/steps [{:db/id #edb/ref 17592186506629 :step/content {:db/id #edb/ref 17592186506575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "290c548b-c3c3-5628-aa5a-ac5099056fee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186505982} {:answer/id #uuid "2bc48f0d-cf97-57e5-b754-75ef64300c8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{15}^{∘}" :db/id #edb/ref 17592186505988} {:answer/id #uuid "577eb998-b617-5fd0-ad2f-5345b0832fc8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186506060} {:answer/id #uuid "a896245b-b333-522d-8269-32007289480b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{90}^{∘}" :db/id #edb/ref 17592186506218} {:answer/id #uuid "aff69b7a-deee-5b22-ab6d-06c966782673" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{60}^{∘}" :db/id #edb/ref 17592186506231}] :answer-field/correct {:db/id #edb/ref 17592186505988} :answer-field/id #uuid "c9cd39b4-8f64-5987-b24f-823849f1e540" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186506479}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a9ea04fe-7306-5ab9-aa1b-8506f72bfa0f" :question/math-academy-id "q-52959" :question/problem "Consider a triangle $△ABC,$ where $m∠C={90}^{∘}$, $m∠B=5x$ and $m∠A=x.$  Determine the value of $x.$" :question/worked-solution "The sum of the measures of the interior angles must be ${180}^{∘}.$ Therefore,\n\n$$\n\\begin{aligned}{90}^{∘}+5x+x & ={180}^{∘} \\\\ {90}^{∘}+6x & ={180}^{∘} \\\\ 6x & ={90}^{∘} \\\\ x & ={15}^{∘}.\\end{aligned}\n$$"} :step/id #uuid "62ab666f-6480-566e-aca2-60c89a11dcc4" :step/next {:db/id #edb/ref 17592186506634}} {:db/id #edb/ref 17592186506634 :step/content {:db/id #edb/ref 17592186506567 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82e33c43-c908-5a3f-984d-b2b02dcb3adb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{95}^{∘}" :db/id #edb/ref 17592186506137} {:answer/id #uuid "b6ab8f41-6eaa-57b5-b1f6-d7874a04825c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{106}^{∘}" :db/id #edb/ref 17592186506241} {:answer/id #uuid "be7c7d3d-4561-511b-b47f-dda2a95bacea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{99}^{∘}" :db/id #edb/ref 17592186506255} {:answer/id #uuid "bf6334e8-2413-5414-b886-62651d4edeba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{109}^{∘}" :db/id #edb/ref 17592186506256} {:answer/id #uuid "cd1796c6-7878-5185-b51f-1ab525ee36ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{97}^{∘}" :db/id #edb/ref 17592186506275}] :answer-field/correct {:db/id #edb/ref 17592186506255} :answer-field/id #uuid "acd2ba71-e40b-5b2c-8be7-8057e874f2c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186506458}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8ed94581-861e-525e-ad7d-f6e47b0ded92" :question/math-academy-id "q-67734" :question/problem "![](images/67/671faf1efc8d64c4db563140d6d9bc8e080c1591eef92d44a5d7f381be115c95.png)\n\nFind the measure of angle $B.$" :question/worked-solution "Since the sum of the measures of the interior angles of a triangle is ${180}^{∘}$, we have\n\n$$\n\\begin{aligned}{27}^{∘}+3x+(5x+{9}^{∘}) & ={180}^{∘} \\\\ {36}^{∘}+8x & ={180}^{∘} \\\\ 8x & ={144}^{∘} \\\\ x & ={18}^{∘}\\end{aligned}\n$$\n\nTherefore,\n\n$$\nm∠B=5x+{9}^{∘}=5({18}^{∘})+{9}^{∘}={99}^{∘}.\n$$"} :step/id #uuid "7199ec83-6eb5-50ad-a3dc-decf07fc55b0" :step/next {:db/id #edb/ref 17592186506645}} {:db/id #edb/ref 17592186506645 :step/content {:db/id #edb/ref 17592186506598 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "215914b0-2451-52ec-9701-ffbe8d9894d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{20}^{∘}" :db/id #edb/ref 17592186505966} {:answer/id #uuid "3b1eafad-ed83-5dac-870a-8b0bca34caa8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{15}^{∘}" :db/id #edb/ref 17592186506010} {:answer/id #uuid "8361a8e7-c4ac-5439-98e5-4797a5503bc0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{18}^{∘}" :db/id #edb/ref 17592186506139} {:answer/id #uuid "9dddfcd0-8eb9-5ebd-9a05-f90a810f094b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{25}^{∘}" :db/id #edb/ref 17592186506188} {:answer/id #uuid "9f85dcf7-d001-5073-8ed4-fa98397e59c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{23}^{∘}" :db/id #edb/ref 17592186506197}] :answer-field/correct {:db/id #edb/ref 17592186505966} :answer-field/id #uuid "d3bfce62-88f0-5b8e-beb5-ecf87f7a30ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186506483}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e9dc1df9-d4f7-5877-9eec-28947f9d3962" :question/math-academy-id "q-116727" :question/problem "![](images/69/69245c30b32f12e59a5f57f2e8fb17c7374726ffd6db10726cb508727f66c409.png)\n\nFind the measure of angle $B$ given that $m∠A=m∠C.$" :question/worked-solution "Using $m∠A=m∠C,$ we get\n\n$$\n\\begin{aligned}m∠A & =m∠C \\\\ 3z+{20}^{∘} & =4z \\\\ z & ={20}^{∘}.\\end{aligned}\n$$\n\nConsequently, substituting $z={20}^{∘}$ in the expression for $m∠C,$ we get\n\n$$\nm∠C=4({20}^{∘})={80}^{∘}.\n$$\n\nNow, we can find $m∠B$ using the fact that the internal angles of any triangle sum to ${180}^{∘}$:\n\n$$\n\\begin{aligned}m∠A+m∠B+m∠C & ={180}^{∘} \\\\ m∠B+2m∠C & ={180}^{∘} \\\\ m∠B+2\\cdot {80}^{∘} & ={180}^{∘} \\\\ m∠B+{160}^{∘} & ={180}^{∘} \\\\ m∠B & ={20}^{∘}\\end{aligned}\n$$"} :step/id #uuid "a880f21b-6654-5782-a317-e615d90fad77"}] :activity/title "Interior Angles of Triangles" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186505907}]}
