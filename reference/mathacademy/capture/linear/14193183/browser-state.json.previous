3</mn><mi>x</mi><mo>+</mo><mo stretchy=\"false\">(</mo><mn>5</mn><mi>x</mi><mo>+</mo><msup><mn>9</mn><mo>∘</mo></msup><mo stretchy=\"false\">)</mo></mtd><mtd><mo>=</mo><msup><mn>180</mn><mo>∘</mo></msup></mtd></mtr><mtr><mtd><msup><mn>36</mn><mo>∘</mo></msup><mo>+</mo><mn>8</mn><mi>x</mi></mtd><mtd><mo>=</mo><msup><mn>180</mn><mo>∘</mo></msup></mtd></mtr><mtr><mtd><mn>8</mn><mi>x</mi></mtd><mtd><mo>=</mo><msup><mn>144</mn><mo>∘</mo></msup></mtd></mtr><mtr><mtd><mi>x</mi></mtd><mtd><mo>=</mo><msup><mn>18</mn><mo>∘</mo></msup></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Therefore,</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"20\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45A TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c2220\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D435 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c35\"></mjx-c></mjx-mn><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo><mjx-msup space=\"3\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c39\"></mjx-c></mjx-mn><mjx-script style=\"vertical-align: 0.413em;\"><mjx-mo class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c2218\"></mjx-c></mjx-mo></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c35\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-msup><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c><mjx-c class=\"mjx-c38\"></mjx-c></mjx-