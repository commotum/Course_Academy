    "q-52959": {
      "dom_id": "step-q52959",
      "name": "Question 1",
      "problem": "Consider a triangle $△ABC,$ where $m∠C={90}^{∘}$, $m∠B=5x$ and $m∠A=x.$  Determine the value of $x.$",
      "worked_solution": "The sum of the measures of the interior angles must be ${180}^{∘}.$ Therefore,\n\n$$\n\\begin{aligned}{90}^{∘}+5x+x & ={180}^{∘} \\\\ {90}^{∘}+6x & ={180}^{∘} \\\\ 6x & ={90}^{∘} \\\\ x & ={15}^{∘}.\\end{aligned}\n$$",
      "calculator_instructions": "",
