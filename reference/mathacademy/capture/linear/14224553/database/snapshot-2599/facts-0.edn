 17592186341056 #edb/ref 17592186045417] [17592186341781 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186341781 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186341781 #edb/ref 1078 #edb/ref 17592186340660 #edb/ref 17592186045417] [17592186341781 #edb/ref 1079 #uuid "e1068806-46ea-595d-a611-e82e67e43211" #edb/ref 17592186045417] [17592186341826 #edb/ref 1075 #edb/ref 17592186340009 #edb/ref 17592186045417] [17592186341826 #edb/ref 1075 #edb/ref 17592186340259 #edb/ref 17592186045417] [17592186341826 #edb/ref 1075 #edb/ref 17592186340611 #edb/ref 17592186045417] [17592186341826 #edb/ref 1075 #edb/ref 17592186340830 #edb/ref 17592186045417] [17592186341826 #edb/ref 1075 #edb/ref 17592186341090 #edb/ref 17592186045417] [17592186341826 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186341826 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186341826 #edb/ref 1078 #edb/ref 17592186340009 #edb/ref 17592186045417] [17592186341826 #edb/ref 1079 #uuid "f952c9dc-1256-5a8a-9688-3f9bfd070213" #edb/ref 17592186045417] [17592186342181 #edb/ref 1068 #edb/ref 17592186341736 #edb/ref 17592186045417] [17592186342181 #edb/ref 1069 "q-74202" #edb/ref 17592186045417] [17592186342181 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186342181 #edb/ref 1071 "Find the shortest distance between the point $(-1,-4)$ and the line $x=4.$" #edb/ref 17592186045417] [17592186342181 #edb/ref 1072 #uuid "79f2f5ac-44c5-5b82-9c80-2524e0bd699c" #edb/ref 17592186045417] [17592186342181 #edb/ref 1074 "Let's sketch the given situation.\n\n![](images/d4/d46a6ed76af5c226e327ba197fe019df0d9085e095ca4781898aba54268a1706.png)\n\nSince the line $x=4$ is a vertical line, the shortest distance between this line and the point $(-1,-4)$ is given by the absolute value of the difference between $x$-coordinate of the point and $4.$ \n\nSo, the shortest distance is\n\n$$\nd=|-1-4|=5.\n$$" #edb/ref 17592186045417] [17592186429494 #edb/re