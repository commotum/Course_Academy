validate]} {:db/id "answer-a8f0081d-4fe9-589f-88a0-d44a2ca40125" :answer/id #uuid "a8f0081d-4fe9-589f-88a0-d44a2ca40125" :answer/type :answer.type/math :answer/value "B⇒A" :db/ensure [:answer/validate]} {:db/id "question-4d4b258b-84b1-50f6-97da-60abb52a038b" :question/id #uuid "4d4b258b-84b1-50f6-97da-60abb52a038b" :question/math-academy-id "q-183426" :question/problem "Find the missing values in the following table:\n\n| Sentence | Symbolic Form |\n| --- | --- |\n| {{field-1}} | $A⇒B$ |\n| {{field-2}} | $A⇒B$ |\n| {{field-3}} | $B⇒A$ |\n| {{field-4}} | $A⇒B$ |" :question/worked-solution "Let's recall the following grammatical constructions for the implication $P⇒Q:$\n\n- If $P,$ then $Q$\n\n- $P$ only if $Q$\n\n- $Q$ if $P$\n\n- $P$ implies $Q$\n\nLet's now compare these against the entries in our table:\n\n- \"If $A,$ then $B$\" means $A⇒B$\n\n- \"$A$ only if $B$\" means $A⇒B$\n\n- \"$A$ if $B$\" means $B⇒A$\n\n- \"$A$ implies $B$\" means $A⇒B$\n\nThe completed table is shown below.\n\n| Sentence | Symbolic Form |\n| --- | --- |\n| If $A,$ then $B$ | $A⇒B$ |\n| $A$ only if $B$ | $A⇒B$ |\n| $A$ if $B$ | $B⇒A$ |\n| $A$ implies $B$ | $A⇒B$ |" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-51e6eb99-6c2b-5630-b6b5-2cadca36057a" "answer-field-de61c8fa-80f3-555b-89aa-3091356530e2" "answer-field-65f33d71-0b7e-53a4-a1fe-2b7e153e4588" "answer-field-a6756ef0-a496-5e5f-9a50-fbffec963e2a"] :db/ensure [:question/validate]} {:db/id "answer-field-51e6eb99-6c2b-5630-b6b5-2cadca36057a" :answer-field/id #uuid "51e6eb99-6c2b-5630-b6b5-2cadca36057a" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-31e2d009-2cc4-5f25-92c7-541bf7f66646" :answer-field/choices ["answer-31e2d009-2cc4-5f25-92c7-541bf7f66646" "answer-8a942b28-c0fe-590b-9ba6-40c941f1b793"] :db/ensure [:answer-field/validate]} {:db/id "answer-31e2d009-2cc4-5f25-92c7-541bf7f66646" :answer/id #uuid "31e2d009-2cc4-5f25-92c7-541bf7f666