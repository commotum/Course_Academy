 | $A⇒B$ |\n| $B$ if $A$ | $A⇒B$ |\n| $B$ implies $A$ | $B⇒A$ |"}] [{:db/id #edb/ref 17592186421145 :knowledge-point/_questions [{:db/id #edb/ref 17592186198282 :knowledge-point/id #uuid "0809c075-e1be-5d49-b1fe-5433114bcf16" :knowledge-point/title "\"If-Then\", \"If\", \"Only If\", and \"Implies\""}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31e2d009-2cc4-5f25-92c7-541bf7f66646" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If $A,$ then $B$" :db/id #edb/ref 17592186421023} {:answer/id #uuid "8a942b28-c0fe-590b-9ba6-40c941f1b793" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If $B,$ then $A$" :db/id #edb/ref 17592186421055}] :answer-field/correct {:answer/id #uuid "31e2d009-2cc4-5f25-92c7-541bf7f66646" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If $A,$ then $B$" :db/id #edb/ref 17592186421023} :answer-field/id #uuid "51e6eb99-6c2b-5630-b6b5-2cadca36057a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186421111} {:answer-field/choices [{:answer/id #uuid "77b5366e-a71b-564e-b41a-69414760d442" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ if $A$" :db/id #edb/ref 17592186421048} {:answer/id #uuid "fac4723a-230d-5598-955a-c41b08c9e36c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ if $B$" :db/id #edb/ref 17592186421099}] :answer-field/correct {:answer/id #uuid "fac4723a-230d-5598-955a-c41b08c9e36c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ if $B$" :db/id #edb/ref 17592186421099} :answer-field/id #uuid "65f33d71-0b7e-53a4-a1fe-2b7e153e4588" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186421113} 