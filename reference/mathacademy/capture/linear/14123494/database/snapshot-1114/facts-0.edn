ref 1083 #uuid "3ae6d9e6-00c4-5ee5-bc3f-ec52b0c0dc4e" #edb/ref 17592186045417] [17592186421027 #edb/ref 1080 "B⇒A" #edb/ref 17592186045417] [17592186421027 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186421027 #edb/ref 1083 #uuid "3bdd0e47-18e5-5297-a187-1fce63926a25" #edb/ref 17592186045417] [17592186421028 #edb/ref 1080 "$x$ is positive if $x>0.$" #edb/ref 17592186045417] [17592186421028 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186421028 #edb/ref 1083 #uuid "3c23cefd-456f-5f0f-941c-8d48c26de887" #edb/ref 17592186045417] [17592186421029 #edb/ref 1080 "A⇒B" #edb/ref 17592186045417] [17592186421029 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186421029 #edb/ref 1083 #uuid "3cf90fce-b7c5-5bd0-b2b8-69cfb38d8eec" #edb/ref 17592186045417] [17592186421030 #edb/ref 1080 "A⇒B" #edb/ref 17592186045417] [17592186421030 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186421030 #edb/ref 1083 #uuid "3e1432d2-b89f-57dd-a8d9-a53d86ec88ce" #edb/ref 17592186045417] [17592186421031 #edb/ref 1080 "B⇒A" #edb/ref 17592186045417] [17592186421031 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186421031 #edb/ref 1083 #uuid "3ec2a81b-cffd-58d4-8c3a-040f6244a1c4" #edb/ref 17592186045417]}
