      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14273827/observations/step-q121424-bb44fad770a1306809ca.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14273827/observations/step-q121424-bb44fad770a1306809ca.png",
      "source_url": "https://mathacademy.com/tasks/14273827/topics/395/lesson",
      "captured_at": 1792212049.0179362,
      "math_academy_id": "q-121424",
