"CLOSE\">)</mo></mrow></mrow></mtd><mtd><mi></mi><mo>=</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>2</mn><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mi>π</mi><mn>5</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>2</mn><mi>π</mi></mrow><mn>5</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mrow><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
