[{:db/id 17592186175929 :knowledge-point/questions ["question-db7154e6-6fda-5907-98f7-b3398371be54"] :db/ensure [:knowledge-point/validate]} {:db/id "question-db7154e6-6fda-5907-98f7-b3398371be54" :question/id #uuid "db7154e6-6fda-5907-98f7-b3398371be54" :question/math-academy-id "q-38493" :question/problem "Determine if $v=[\\begin{aligned}1+2\\text{i} \\\\ 2\\end{aligned}]$ is an eigenvector of the matrix $A=[\\begin{aligned}2 & -5 \\\\ 4 & -2\\end{aligned}].$\nIf so, then what is the corresponding eigenvalue?" :question/worked-solution "The eigenvectors are non-zero vectors $v$ such that $Av=\\lambda v.$ So, we have\n\n$$\n\\begin{aligned}Av & =[\\begin{aligned}2 & -5 \\\\ 4 & -2\\end{aligned}][\\begin{aligned}1+2\\text{i} \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}-8+4\\text{i} \\\\ 8\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}8{\\text{i}}^{2}+4\\text{i} \\\\ 8\\text{i}\\end{aligned}] \\\\  & =4\\text{i}[\\begin{aligned}1+2\\text{i} \\\\ 2\\end{aligned}] \\\\  & =4\\text{i}v.\\end{aligned}\n$$\n\nSince $Av=4\\text{i}v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =4\\text{i}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-93c408a0-c9c5-54b6-81eb-ee9b40cb4448"] :db/ensure [:question/validate]} {:db/id "answer-field-93c408a0-c9c5-54b6-81eb-ee9b40cb4448" :answer-field/id #uuid "93c408a0-c9c5-54b6-81eb-ee9b40cb4448" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fa45e365-566e-56f7-88cc-77bf8156b5ec" :answer-field/choices ["answer-c4dc0bd2-9334-5cf0-9566-65f6c6862a8a" "answer-b38f6e8b-7681-58f7-b559-5a8bae4dff01" "answer-fa45e365-566e-56f7-88cc-77bf8156b5ec" "answer-006f21ef-bd9e-5319-853e-7e3fc38e4a67" "answer-4cc31227-522c-5e3c-865f-858998fd51d3"] :db/ensure [:answer-field/validate]} {:db/id "answer-c4dc0bd2-9334-5cf0-9566-65f6c6862a8a" :answer/id #uuid "c4dc0bd2-9334-5cf0-9566-65f6c6862a8a" :answer/type :answer.type/math :answer/value "\\lambda =-2\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-b38f6e8b-7681-58f7-b559-5a8bae4dff01" :answer/id #uuid "b38f6e8b-7681-58f7-b559-5a8bae4dff01" :answer/type :answer.type/math :answer/value "\\lambda =4" :db/ensure [:answer/validate]} {:db/id "answer-fa45e365-566e-56f7-88cc-77bf8156b5ec" :answer/id #uuid "fa45e365-566e-56f7-88cc-77bf8156b5ec" :answer/type :answer.type/math :answer/value "\\lambda =4\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-006f21ef-bd9e-5319-853e-7e3fc38e4a67" :answer/id #uuid "006f21ef-bd9e-5319-853e-7e3fc38e4a67" :answer/type :answer.type/math :answer/value "\\lambda =\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-4cc31227-522c-5e3c-865f-858998fd51d3" :answer/id #uuid "4cc31227-522c-5e3c-865f-858998fd51d3" :answer/type :answer.type/text :answer/value "$v$ is not an eigenvector of $A$" :db/ensure [:answer/validate]} {:db/id "activity-3099b967-b00c-5782-9a83-fd84f9ad579c" :activity/id #uuid "3099b967-b00c-5782-9a83-fd84f9ad579c" :activity/title "Finding Complex Eigenvectors of Real 2x2 Matrices" :activity/type :activity.type/review :activity/scope 17592186048973 :activity/course 17592186046673 :activity/steps ["step-7c22f243-0739-5a0f-8281-eeed84387bab" "step-db758ac7-852d-51b4-ad30-e5acef4cfcd0" "step-42de2582-1d6d-5484-ba6c-324ba0f7ff5f" "step-741564cd-c2f1-5aee-8b62-848c21e617d3" "step-d4502c0c-e4ff-5fb4-9162-5b78360320c6"] :activity/first-step "step-7c22f243-0739-5a0f-8281-eeed84387bab" :db/ensure [:activity/validate]} {:db/id "step-7c22f243-0739-5a0f-8281-eeed84387bab" :step/id #uuid "7c22f243-0739-5a0f-8281-eeed84387bab" :step/content "question-db7154e6-6fda-5907-98f7-b3398371be54" :step/next "step-db758ac7-852d-51b4-ad30-e5acef4cfcd0" :db/ensure [:step/validate]} {:db/id "step-db758ac7-852d-51b4-ad30-e5acef4cfcd0" :step/id #uuid "db758ac7-852d-51b4-ad30-e5acef4cfcd0" :step/content 17592186326744 :step/next "step-42de2582-1d6d-5484-ba6c-324ba0f7ff5f" :db/ensure [:step/va