 :activity/steps [{:db/id #edb/ref 17592186555916 :step/content {:db/id #edb/ref 17592186555827 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cccba6b-f470-51dd-b23c-1c518f8d32fe" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/49/498944b029b0a16a67dcd830a91bf6ea6480b3267a2a8f233d97fab2dd98d3a7.png" :db/id #edb/ref 17592186555021} {:answer/id #uuid "b07ed8b7-ba04-5275-a158-92c500ad6e37" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/1a/1aefee3b012fc011ba7a643d92562724e520f78d06553d5ac82ec7226ccd0550.png" :db/id #edb/ref 17592186555424} {:answer/id #uuid "d89ee78f-3a41-5e1b-82db-a8654f6fdce9" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ce/cecf86b753685cbad211f1a85e0552ef504a7c1fc6cc35219d72a70e922643a7.png" :db/id #edb/ref 17592186555521} {:answer/id #uuid "dc16fd87-410b-57e5-8b5c-be56639e5ed1" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/65/6527b4f7514f14211c796840c704df5544cabfa6099e69a3740e2e1941e126d2.png" :db/id #edb/ref 17592186555534} {:answer/id #uuid "e3d8f0c9-d1d6-5a68-ad42-ce31393b9535" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f8/f815f737ed2f98d9cc8d028545e77407cff0693c6212ffee58efeaff0bf658ff.png" :db/id #edb/ref 17592186555558}] :answer-field/correct {:db/id #edb/ref 17592186555534} :answer-field/id #uuid "3dd397f7-5ec0-560f-a03e-535e6aeb3530" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555670}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "81bf18b7-eab3-5bbd-9ce6-359135969b2e" :question/math-academy-id "q-46785" :question/problem "Given that \n\n$$\nf(x)=\\{\\begin{aligned}1,\\, & x\\le 0 \\\\ -2,\\, & x\\text{ }>0,\\end{aligned}\n$$\n\nwhich of the following is the graph of $y=f(x)?$" :question/worked-solution "We will graph each branch separately.\n\n- On the interval $(-\\infty ,0],$ we have $f(x)=1,$ so the graph is a horizontal line that ends at $(0,1),$ including this point.\n\n- On the interval $(0,\\infty )$, we have $f(x)=-2,$ so the graph is a horizontal line that begins at $(0,-2),$ excluding this point.\n\nTherefore, the graph of the given function is as follows:\n\n![](images/65/6527b4f7514f14211c796840c704df5544cabfa6099e69a3740e2e1941e126d2.png)"} :step/id #uuid "7b1cf0ae-7687-5259-ba31-17bac9e83de2"} {:db/id #edb/ref 17592186555949 :step/content {:db/id #edb/ref 17592186555833 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3437553e-7766-56dc-b3d3-e9e7c72cc279" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=\\{\\begin{aligned}2,\\, & x\\le 1 \\\\ x,\\, & x>1\\end{aligned}" :db/id #edb/ref 17592186555110} {:answer/id #uuid "ae152954-f902-53bd-b2ef-b01345a0f0a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=\\{\\begin{aligned}2x,\\, & x\\le 4 \\\\ 1,\\, & x>4\\end{aligned}" :db/id #edb/ref 17592186555419} {:answer/id #uuid "e1927365-62c2-515d-9dbf-69034002b056" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=\\{\\begin{aligned}x,\\, & x\\le 4 \\\\ 2,\\, & x>4\\end{aligned}" :db/id #edb/ref 17592186555552} {:answer/id #uuid "e34b9c2d-6c57-55bf-8eed-c4819d40f872" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=\\{\\begin{aligned}x+1,\\, & x\\le 2 \\\\ 2,\\, & x>2\\end{aligned}" :db/id #edb/ref 17592186555556} {:answer/id #uuid "fbcec12c-1509-5612-8ee1-be7da7f92471" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=\\{\\begin{aligned}2,\\, & x<4 \\\\ 1-x,\\, & x\\ge 4\\end{aligned}" :db/id #edb/ref 17592186555625}] :answer-field/correct {:db/id #edb/ref 17592186555552} :answer-field/id #uuid "e1f95f09-2832-5ce0-bed7-f205e739286f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555748}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8fda4d22-b124-5945-a801-91535484189e" :question/math-academy-id "q-19294" :question/problem "![](images/8d/8d531960f0aa1444b614279f1ab82d8cc01904580e44be331f42d3d28266e1a9.png)\n\nWhat is the definition of the function $y=f(x)$ shown above?" :question/worked-solution "We will graph each branch separately.\n\n- On the interval $(-\\infty ,4],$ we have a line with a slope of $1$ and $y$-intercept $0.$ So the graph is the line $y=x$ that ends at $(4,4),$ including this point.\n\n- On the interval $(4,\\infty ),$ we have a horizontal line that passes through the point $(4,2).$ So the graph is the line $y=2$ that starts at $(4,2),$ excluding this point.\n\nTherefore, the function is defined as follows:\n\n$$\nf(x)=\\{\\begin{aligned}x,\\, & x\\le 4 \\\\ 2,\\, & x>4\\end{aligned}\n$$"} :step/id #uuid "e255a5ac-9e79-5535-a6b6-46bf858aa400" :step/next {:db/id #edb/ref 17592186555952}} {:db/id #edb/ref 17592186555952 :step/content {:db/id #edb/ref 17592186060274 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28abf02e-9cfb-5f65-a057-166a7d38267e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,5]" :db/id #edb/ref 17592186555088} {:answer/id #uuid "45964d38-34b2-5ca7-bf8d-ba29864503fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,5)" :db/id #edb/ref 17592186555149} {:answer/id #uuid "6a90e9e5-603c-5e40-922f-d01567889028" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-1,5]" :db/id #edb/ref 17592186555242} {:answer/id #uuid "b1e5edc3-eb1e-53e9-97bc-e68a0469e168" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-1,3)\\cup (3,5]" :db/id #edb/ref 17592186555429} {:answer/id #uuid "b5858ca0-0bd2-52e8-9b7f-e5453fd6ff79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-1,5)" :db/id #edb/ref 17592186555437}] :answer-field/correct {:db/id #edb/ref 17592186555088} :answer-field/id #uuid "8cfb2065-4655-52ee-82a2-411f289afbc1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186058266}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fbdcd265-326a-5b5a-b9a1-ceef67e74230" :question/math-academy-id "q-34605" :question/problem "![](images/d5/d5da28420cf16c4563fbf7188a81b16c4cf8aaa62af39998456fe7016b76aa7d.png)\n\nWhat is the domain of the function $f(x),$ shown above?" :question/worked-solution "The function $f(x)$ above is defined for values between $x=-1$ and $x=5.$\n\n- Since there is a closed circle at $x=5,$ this point is included in the domain.\n\n- On the other hand, because there is an open circle at $x=-1,$ this point is not included in the domain.\n\nSo, the function $f(x)$ above is defined for values between $x=-1$ and $x=5,$ including $x=5$ but not including $x=-1.$\n\nTherefore, the domain is\n\n$$\nx\\in (-1,5].\n$$\n\nNote that the function is defined at the point $x=3,$  even though the function jumps at that point. The function value at $x=3$ is $1.$"} :step/id #uuid "e532ec62-765a-5ac3-90b2-68b73e2ff120" :step/next {:db/id #edb/ref 17592186555916}}] :activity/title "Piecewise Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186554994}]}
