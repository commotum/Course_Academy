be87e8.svg) because ![](images/95/95a3686bf6cd3fddc29b98a39ab23027d1cc794ae2517aefde675a62f0a4d023.svg) On this branch, the function definition is ![](images/85/85f568b3e2d870a755a97fb3457f3c62e814f559b8b017ac05c291fb5d8aa79e.svg) so we have\n\n![](images/16/166c6a001bb66b83e3d369c2211f11baf60650e54c93da7bee47539fa717d44a.svg)" :tutorial/id #uuid "78de19f4-277e-593e-b417-d9c4b49d919f" :tutorial/math-academy-id 1823 :tutorial/title "Introduction"} :step/id #uuid "271b7b22-3952-5a9c-b297-a12548098709" :step/math-academy-id 104209 :step/next {:db/id #edb/ref 17592186060464}} {:db/id #edb/ref 17592186060464 :step/content {:db/id #edb/ref 17592186059632 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059458 :question/id #uuid "92d4072d-90d5-5b12-b043-9361efb446cd" :question/math-academy-id "e-1749"} :knowledge-point/id #uuid "8daba5bf-5162-5779-9512-f22d0c8c0320" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048652} {:db/id #edb/ref 17592186050519}] :knowledge-point/questions [{:db/id #edb/ref 17592186060385} {:db/id #edb/ref 17592186060397} {:db/id #edb/ref 17592186233397} {:db/id #edb/ref 17592186233406} {:db/id #edb/ref 17592186506523} {:db/id #edb/ref 17592186506601} {:db/id #edb/ref 17592186522694}] :knowledge-point/title "Evaluating Piecewise Functions"} :step/id #uuid "4a1af676-293f-5181-9c71-d019fd78b1fc" :step/math-academy-id 104210 :step/next {:db/id #edb/ref 17592186060465}} {:db/id #edb/ref 17592186060465 :step/content {:db/id #edb/ref 17592186059633 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059459 :question/id #uuid "05e153cd-83bb-5d6a-b316-58835ee0fab2" :question/math-academy-id "e-1751"} :knowledge-point/id #uuid "a0df71e7-73ee-5b39-9c36-053215d90052" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050763}] :knowledge-point/questions [{:db/id #edb/ref 17592186060284} {:db/id #edb/ref 17592186060285} {:db/id #edb/ref 17592186506574} {:db/id #edb/ref 17592186506586} {:db/id #edb/ref 17592186555827}] :