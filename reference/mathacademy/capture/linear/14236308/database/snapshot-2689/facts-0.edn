0c704df5544cabfa6099e69a3740e2e1941e126d2.png" #edb/ref 17592186045417] [17592186555534 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186555534 #edb/ref 1083 #uuid "dc16fd87-410b-57e5-8b5c-be56639e5ed1" #edb/ref 17592186045417] [17592186555552 #edb/ref 1080 "f(x)=\\{\\begin{aligned}x,\\, & x\\le 4 \\\\ 2,\\, & x>4\\end{aligned}" #edb/ref 17592186045417] [17592186555552 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186555552 #edb/ref 1083 #uuid "e1927365-62c2-515d-9dbf-69034002b056" #edb/ref 17592186045417] [17592186555556 #edb/ref 1080 "f(x)=\\{\\begin{aligned}x+1,\\, & x\\le 2 \\\\ 2,\\, & x>2\\end{aligned}" #edb/ref 17592186045417] [17592186555556 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186555556 #edb/ref 1083 #uuid "e34b9c2d-6c57-55bf-8eed-c4819d40f872" #edb/ref 17592186045417] [17592186555558 #edb/ref 1080 "images/f8/f815f737ed2f98d9cc8d028545e77407cff0693c6212ffee58efeaff0bf658ff.png" #edb/ref 17592186045417] [17592186555558 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186555558 #edb/ref 1083 #uuid "e3d8f0c9-d1d6-5a68-ad42-ce31393b9535" #edb/ref 17592186045417] [17592186555625 #edb/ref 1080 "f(x)=\\{\\begin{aligned}2,\\, & x<4 \\\\ 1-x,\\, & x\\ge 4\\end{aligned}" #edb/ref 17592186045417] [17592186555625 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186555625 #edb/ref 1083 #uuid "fbcec12c-1509-5612-8ee1-be7da7f92471" #edb/ref 17592186045417] [17592186555670 #edb/ref 1075 #edb/ref 17592186555021 #edb/ref 17592186045417] [17592186555670 #edb/ref 1075 #edb/ref 17592186555424 #edb/ref 17592186045417] [17592186555670 #edb/ref 1075 #edb/ref 17592186555521 #edb/ref 17592186045417] [17592186555670 #edb/ref 1075 #edb/ref 17592186555534 #edb/ref 17592186045417] [17592186555670 #edb/ref 1075 #edb/ref 17592186555558 #edb/ref 17592186045417] [17592186555670 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186555670 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186555670 #edb/ref 1078 #edb/ref 17592186555534 #edb/ref 17592186045417] [17592186555670 #edb/ref 1079 #uuid "3dd397f7-5ec0-560f-a03e-535e6aeb3530" #edb/ref 17592186045417] [17592186555748 #edb/ref 1075 #edb/ref 17592186555110 #edb/ref 17592186045417] [17592186555748 #edb/ref 1075 #edb/ref 17592186555419 #edb/ref 17592186045417] [17592186555748 #edb/ref 1075 #edb/ref 17592186555552 #edb/ref 17592186045417] [17592186555748 #edb/ref 1075 #edb/ref 17592186555556 #edb/ref 17592186045417] [17592186555748 #edb/ref 1075 #edb/ref 17592186555625 #edb/ref 17592186045417] [17592186555748 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186555748 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186555748 #edb/ref 1078 #edb/ref 17592186555552 #edb/ref 17592186045417] [17592186555748 #edb/ref 1079 #uuid "e1f95f09-2832-5ce0-bed7-f205e739286f" #edb/ref 17592186045417] [17592186555827 #edb/ref 1068 #edb/ref 17592186555670 #edb/ref 17592186045417] [17592186555827 #edb/ref 1069 "q-46785" #edb/ref 17592186045417] [17592186555827 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186555827 #edb/ref 1071 "Given that \n\n$$\nf(x)=\\{\\begin{aligned}1,\\, & x\\le 0 \\\\ -2,\\, & x\\text{ }>0,\\end{aligned}\n$$\n\nwhich of the following is the graph of $y=f(x)?$" #edb/ref 17592186045417] [17592186555827 #edb/ref 1072 #uuid "81bf18b7-eab3-5bbd-9ce6-359135969b2e" #edb/ref 17592186045417] [17592186555827 #edb/ref 1074 "We will graph each branch separately.\n\n- On the interval $(-\\infty ,0],$ we have $f(x)=1,$ so the graph is a horizontal line that ends at $(0,1),$ including this point.\n\n- On the interval $(0,\\infty )$, we have $f(x)=-2,$ so the graph is a horizontal line that begins at $(0,-2),$ excluding this point.\n\nTherefore, the graph of the given function is as follows:\n\n![](images/65/6527b4f7514f14211c796840c704df5544cabfa6099e69a3740e2e1941e126d2.png)" #edb/ref 17592186045417] [17592186555833 #edb/ref 1068 #edb/ref 17592186555748 #edb/ref 17592186045417] [17592186555833 #edb/ref 1069 "q-19294" #edb/ref 17592186045417] [17592186555833 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186555833 #edb/ref 1071 "![](images/8d/8d531960f0aa1444b614279f1ab82d8cc01904580e44be331f42d3d28266e1a9.png)\n\nWhat is the definition of the function $y=f(x)$ shown above?" #edb/ref 17592186045417] [17592186555833 #edb/ref 1072 #uuid "8fda4d22-b124-5945-a801-91535484189e" #edb/ref 17592186045417] [17592186555833 #edb/ref 1074 "We will graph each branch separately.\n\n- On the interval $(-\\infty ,4],$ we have a line with a slope of $1$ and $y$-intercept $0.$ So the graph is the line $y=x$ that ends at $(4,4),$ including this point.\n\n- On the interval $(4,\\infty ),$ we have a horizontal line that passes through the point $(4,2).$ So the graph is the line $y=2$ that starts at $(4,2),$ excluding this point.\n\nTherefore, the function is defined as follows:\n\n$$\nf(x)=\\{\\begin{aligned}x,\\, & x\\le 4 \\\\ 2,\\, & x>4\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186555916 #edb/ref 1062 #uuid "7b1cf0ae-7687-5259-ba31-17bac9e83de2" #edb/ref 17592186045417] [17592186555916 #edb/ref 1063 #edb/ref 17592186555827 #edb/ref 17592186045417] [17592186555949 #edb/ref 1058 #edb/ref 17592186555952 #edb/ref 17592186045417] [17592186555949 #edb/ref 1062 #uuid "e255a5ac-9e79-5535-a6b6-46bf858aa400" #edb/ref 17592186045417] [17592186555949 #edb/ref 1063 #edb/ref 17592186555833 #edb/ref 17592186045417] [17592186555952 #edb/ref 1058 #edb/ref 17592186555916 #edb/ref 17592186045417] [17592186555952 #edb/ref 1062 #uuid "e532ec62-765a-5ac3-90b2-68b73e2ff120" #edb/ref 17592186045417] [17592186555952 #edb/ref 1063 #edb/ref 17592186060274 #edb/ref 17592186045417]}
