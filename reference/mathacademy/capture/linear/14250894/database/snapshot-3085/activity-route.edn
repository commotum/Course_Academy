#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186571460} :activity/id #uuid "fe1cc446-de88-5021-a6e9-3cb8a26db2bd" :activity/scope {:db/id #edb/ref 17592186049707 :topic/id #uuid "0d118f55-a6b1-5729-9c06-3dbae669ed79" :topic/math-academy-id 754} :activity/steps [{:db/id #edb/ref 17592186571460 :step/content {:db/id #edb/ref 17592186571382 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c8d4228-1aab-5adf-85da-0448648cabd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[0,6]" :db/id #edb/ref 17592186570959} {:answer/id #uuid "4bee82ef-d2a6-5aa6-94ca-b147f889ed29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,6)" :db/id #edb/ref 17592186571008} {:answer/id #uuid "72fe398a-3723-5907-aec5-2845af0817ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{0,6\\}" :db/id #edb/ref 17592186571071} {:answer/id #uuid "86392a48-9ee8-548a-9ffa-8f5c0437fe49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{-6,0,6\\}" :db/id #edb/ref 17592186571101} {:answer/id #uuid "cf35bf23-1a31-5de8-936a-2878bd476be6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-6,6]" :db/id #edb/ref 17592186571211}] :answer-field/correct {:db/id #edb/ref 17592186571071} :answer-field/id #uuid "50dc56a6-6bfb-586f-ad04-d62f457561b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571317}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "231364b7-94f7-52ea-b296-35b7663684ee" :question/math-academy-id "q-37028" :question/problem "What is the range of the function $h$ defined by the following table?\n\n| $x$ | $0$ | $1$ | $2$ | $\\frac{1}{2}$ | $3$ | $\\frac{1}{3}$ | $4$ | $\\frac{1}{4}$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| $h(x)$ | $6$ | $6$ | $6$ | $0$ | $6$ | $0$ | $6$ | $0$ |" :question/worked-solution "The range of $h(x)$ consists of all the outputs that have a corresponding $x$-input.\n\nIn a table, the range consists of all numbers that feature in the row corresponding to $h(x).$\n\nTherefore, the range is the set $\\{0,6\\}.$"} :step/id #uuid "093238a7-1c50-5ad9-aa2c-532f731fbcb1" :step/next {:db/id #edb/ref 17592186571484}} {:db/id #edb/ref 17592186571484 :step/content {:db/id #edb/ref 17592186083515 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9018e2cb-dfa0-5daf-b410-1b1f2d353726" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{-3,-1, 0, 1, 2, 4}" :db/id #edb/ref 17592186079986} {:answer/id #uuid "f15496cb-2dbb-5b4f-8fc0-ad1b73c8244a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{0, 1, 2, 4}" :db/id #edb/ref 17592186079987} {:answer/id #uuid "06134589-bc19-5105-8052-684b81cfdb9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[- 3, 4]" :db/id #edb/ref 17592186079988} {:answer/id #uuid "1fe44727-8eb7-58ec-beac-21ea3a595d7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[- 3, 2]" :db/id #edb/ref 17592186079989} {:answer/id #uuid "4fa3ad6d-7ce1-547f-b5d3-1229d0991acd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{-3,-2,-1, 0, 1, 2}" :db/id #edb/ref 17592186079990}] :answer-field/id #uuid "875c6287-389c-5117-a439-1594fb693754" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186079985}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d08b4296-2598-5ec9-a563-496067db501c" :question/math-academy-id "q-129320" :question/problem "What is the range of the function $f$ defined by the following table?\n\n| $x$ | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ |\n| --- | ---: | ---: | ---: | ---: | ---: | ---: |\n| $f(x)$ | $0$ | $-3$ | $1$ | $2$ | $-1$ | $4$ |"} :step/id #uuid "62f0c4cc-ed76-56a7-93fc-1441f1e22183" :step/next {:db/id #edb/ref 17592186571495}} {:db/id #edb/ref 17592186571495 :step/content {:db/id #edb/ref 17592186489217 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "188c4fda-9403-5e96-8778-6fa47508ca07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\le f(x)\\le 1" :db/id #edb/ref 17592186488522} {:answer/id #uuid "31e170db-9a48-588a-8a1d-9fbc906b510e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\le f(x)\\le -1" :db/id #edb/ref 17592186488577} {:answer/id #uuid "8837b46e-1a4c-5bec-be6d-a7dbe8b25314" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\le f(x)\\le 0" :db/id #edb/ref 17592186488738} {:answer/id #uuid "a548bfd7-7287-5be4-92d7-196f40aaeb6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1\\le f(x)\\le 3" :db/id #edb/ref 17592186488798} {:answer/id #uuid "d4b92c31-a6c4-51c9-9ea1-65459509653c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\le f(x)\\le 3" :db/id #edb/ref 17592186488906}] :answer-field/correct {:db/id #edb/ref 17592186488522} :answer-field/id #uuid "b8128f7f-f2e6-5c3a-88a9-33f221275500" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489119}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4ecf9c80-3378-55e5-9ee3-61d34805f6d4" :question/math-academy-id "q-129333" :question/problem "![](images/57/579e17e56674e39e552f1c0856f40e7f878ed94248a7a0e878c1f851c54ecbea.png)\n\nWhat is the range of the function $f(x),$ shown above?" :question/worked-solution "First, we find the lowest and highest $y$-values in the graph.\n\n- The lowest $y$-value is $-3.$ This occurs at the point $(3,-3).$\n\n- The highest $y$-value is $1.$ This occurs at the point $(-1,1).$\n\nThe function covers all the $y$-values between $-3$ and $1,$ including both $-3$ and $1.$\n\nTherefore, the range is $-3\\le y\\le 1,$ which can also be written as  $-3\\le f(x)\\le 1.$"} :step/id #uuid "a117b9ba-4d36-5d70-abb9-a04c46ca7ab6"}] :activity/title "The Range of a Function" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186570893}]}
