          "input_html": "<div class=\"matheditor-wrapper-answer\" style=\"min-width: 80px; margin-left: 2px; margin-right: 2px;\">\n                                             \n                                        <div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"13\"><var mathquill-command-id=\"64\" class=\"mq-operator-name\">c</var><var mathquill-command-id=\"65\" class=\"mq-operator-name\">o</var><var mathquill-command-id=\"66\" class=\"mq-operator-name mq-last\">s</var><span mathquill-command-id=\"68\">(</span><span mathquill-command-id=\"70\">4</span><var mathquill-command-id=\"72\">t</var><span mathquill-command-id=\"74\">)</span><span mathquill-command-id=\"76\" class=\"mq-binary-operator\">−</span><span mathquill-command-id=\"78\">4</span><var mathquill-command-id=\"80\">t</var><var mathquill-command-id=\"83\" class=\"mq-operator-name mq-first\">s</var><var mathquill-command-id=\"84\" class=\"mq-operator-name\">i</var><var mathquill-command-id=\"85\" class=\"mq-operator-name mq-last\">n</var><span mathquill-command-id=\"87\">(</span><span mathquill-command-id=\"89\">4</span><var mathquill-command-id=\"91\">t</var><span mathquill-command-id=\"93\">)</span></span></div></div>",
          "rendered_text": "cos(4t)−4tsin(4t)",
