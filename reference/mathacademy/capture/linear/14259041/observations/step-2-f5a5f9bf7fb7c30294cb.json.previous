      "input_html": "<div class=\"matheditor-wrapper-answer\" style=\"min-width: 60px; margin-left: 6px; margin-right: 8px;\">\n                                             \n                                        <div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"1\"><span mathquill-command-id=\"15\">6</span></span></div></div>",
      "rendered_text": "6",
