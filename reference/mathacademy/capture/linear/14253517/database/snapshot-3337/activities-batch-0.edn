#{[{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186106948} :activity/id #uuid "c87e90cc-8b38-5857-ab16-91e27d4abf5b" :activity/scope {:db/id #edb/ref 17592186049504 :topic/id #uuid "fa26fae5-4dd8-54f6-8b10-f83839bbfcdb" :topic/math-academy-id 1346} :activity/steps [{:db/id #edb/ref 17592186106948 :step/content {:db/id #edb/ref 17592186107164 :tutorial/content "To find the $n$th term of an arithmetic sequence given two arbitrary terms, we must usually apply the following:\n\n- The formula for the $n$th term of an arithmetic sequence is given by\n\n$$\na_n = a_1 + (n-1)d\n$$\n\nwhere $a_n$ is the $n$th term, $a_1$ is the first term, and $d$ is the common difference.\n\n- We can find the common difference $d$ of an arithmetic sequence given two arbitrary terms using\n\n$$\nd = \\frac{a_m-a_k}{m-k}\n$$\n\nwhere $a_m$ is the $m$th term, and $a_k$ is the $k$th term.\n\nLet's see some examples." :tutorial/id #uuid "d021f3a1-b263-5fc0-a08d-cdec57045fb1" :tutorial/math-academy-id 8084 :tutorial/title "Introduction"} :step/id #uuid "a29b3302-3991-50d4-b2af-0500a0002df1" :step/math-academy-id 54971 :step/next {:db/id #edb/ref 17592186106949}} {:db/id #edb/ref 17592186106949 :step/content {:db/id #edb/ref 17592186105919 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105475 :question/id #uuid "e7b51055-36f2-552b-817e-3632cf0446b9" :question/math-academy-id "e-12924"} :knowledge-point/id #uuid "3b13a2e9-d7e8-51a3-b452-0594858dd0d1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048338} {:db/id #edb/ref 17592186050157}] :knowledge-point/questions [{:db/id #edb/ref 17592186106028} {:db/id #edb/ref 17592186106444} {:db/id #edb/ref 17592186106446} {:db/id #edb/ref 17592186527129} {:db/id #edb/ref 17592186527130}] :knowledge-point/title "Finding the Nth Term Given the First Term and Another Term"} :step/id #uuid "92c70c0d-cbf1-5b74-9421-f1cb3d0f5cd3" :step/math-academy-id 54972 :step/next {:db/id #edb/ref 17592186106950}} {:db/id #edb/ref 17592186106950 :step/content {:db/id #edb/ref 17592186105920 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105476 :question/id #uuid "c7bb25e3-0f81-5290-970d-6785ecbc921c" :question/math-academy-id "e-12925"} :knowledge-point/id #uuid "23171184-edaf-560e-a5a6-fd7f0be2f6ee" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048725}] :knowledge-point/questions [{:db/id #edb/ref 17592186106083} {:db/id #edb/ref 17592186106380} {:db/id #edb/ref 17592186527133} {:db/id #edb/ref 17592186527223} {:db/id #edb/ref 17592186539019}] :knowledge-point/title "Finding the Nth Term Given Two Consecutive Terms"} :step/id #uuid "a79b4d3e-e1aa-56c0-b927-8f3b62d26fa2" :step/math-academy-id 54976 :step/next {:db/id #edb/ref 17592186106951}} {:db/id #edb/ref 17592186106951 :step/content {:db/id #edb/ref 17592186105921 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105477 :question/id #uuid "e564d562-6dd0-5736-a539-63b6c6592e81" :question/math-academy-id "e-12927"} :knowledge-point/id #uuid "b97cdef9-0f97-5f2e-a168-2ea62e08a7f9" :knowledge-point/questions [{:db/id #edb/ref 17592186106308} {:db/id #edb/ref 17592186106447} {:db/id #edb/ref 17592186106449} {:db/id #edb/ref 17592186527142} {:db/id #edb/ref 17592186527197}] :knowledge-point/title "Finding the Nth Term Given Two Non-Consecutive Terms"} :step/id #uuid "87afd085-002a-56d2-8561-df9675f99c3b" :step/math-academy-id 54979}] :activity/title "Finding the Nth Term of an Arithmetic Sequence Given Two Terms" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186105984}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186539071} :activity/id #uuid "060d4036-0ed8-5c85-a941-438a79e46360" :activity/scope {:db/id #edb/ref 17592186049504 :topic/id #uuid "fa26fae5-4dd8-54f6-8b10-f83839bbfcdb" :topic/math-academy-id 1346} :activity/steps [{:db/id #edb/ref 17592186539058 :step/content {:db/id #edb/ref 17592186106380 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dea6f66-3bbd-5b42-8dca-11fd28f5185c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}_{n}=4n+2" :db/id #edb/ref 17592186538266} {:answer/id #uuid "4fdd2eb5-c98d-546b-8571-a3499b2907ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}_{n}=3n+3" :db/id #edb/ref 17592186538404} {:answer/id #uuid "9efb8e4c-4b94-56cc-a616-72f436715fb2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}_{n}=2n-4" :db/id #edb/ref 17592186538609} {:answer/id #uuid "db6886dc-8144-544f-ac7e-3797991967e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}_{n}=3n" :db/id #edb/ref 17592186538735} {:answer/id #uuid "e396d923-9038-578c-9cec-ab4160014ddc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}_{n}=2n+5" :db/id #edb/ref 17592186538750}] :answer-field/correct {:db/id #edb/ref 17592186538735} :answer-field/id #uuid "7579d36c-25f2-5775-a624-8d75fe31f497" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186104428}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "632e1294-ce84-5342-b323-b182d3b71447" :question/math-academy-id "q-51507" :question/problem "The $10$th and $11$th terms of an arithmetic sequence are $30$ and $33,$ respectively. Determine the formula for the $n$th term of the sequence." :question/worked-solution "The formula for the $n$th term is given by \n\n$$\n{a}_{n}={a}_{1}+(n-1)d,\n$$\n\nso we need to figure out the first term ${a}_{1}$ and the common difference $d.$\n\nSince the terms ${a}_{10}=30$ and ${a}_{11}=33$ are consecutive, we can subtract them to find the common difference:\n\n$$\n\\begin{aligned}d & ={a}_{11}-{a}_{10} \\\\  & =33-30 \\\\  & =3\\end{aligned}\n$$\n\nNow, we can use one of our known values, say, ${a}_{10}=30,$ to determine the first term of the sequence. Since ${a}_{10}$ is $9$ jumps after ${a}_{1},$ we have:\n\n$$\n\\begin{aligned}{a}_{10} & ={a}_{1}+9d \\\\ 30 & ={a}_{1}+9(3) \\\\ 30 & ={a}_{1}+27 \\\\ 30-27 & ={a}_{1} \\\\ {a}_{1} & =3\\end{aligned}\n$$\n\nSo, the formula for the $n$th term of this arithmetic sequence is:  \n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =3+(n-1)(3) \\\\  & =3+3n-3 \\\\  & =3n\\end{aligned}\n$$"} :step/id #uuid "4d6aeb91-9c91-562e-a421-ded7cae525a0" :step/next {:db/id #edb/ref 17592186539111}} {:db/id #edb/ref 17592186539071 :step/content {:db/id #edb/ref 17592186106449 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86f2e8d6-a320-5c71-a940-6eff81a662a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "116" :db/id #edb/ref 17592186104843} {:answer/id #uuid "b10bb3d5-3989-5a9a-9609-1f63dd4288f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "115" :db/id #edb/ref 17592186104844} {:answer/id #uuid "b15285ce-4b16-546d-9b37-88a677179181" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "121" :db/id #edb/ref 17592186104845} {:answer/id #uuid "0ed671c3-dab9-5786-babf-07b4b37801c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "117" :db/id #edb/ref 17592186104846} {:answer/id #uuid "58a2c294-53aa-5fbd-a5be-1e2c3ca637a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "111" :db/id #edb/ref 17592186104847}] :answer-field/correct {:db/id #edb/ref 17592186104845} :answer-field/id #uuid "c1a126a1-4e90-5422-81e4-07bfbb4a953b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186104842}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a1bd11c6-80cb-5cfe-a97d-33176cbe000e" :question/math-academy-id "q-5435" :question/problem "Find the $31$st term of an arithmetic sequence given that the $22$nd term is $76$ and the $6$th term is $-4.$" :question/worked-solution "The formula for the $n$th term is given by \n\n$$\n{a}_{n}={a}_{1}+(n-1)d,\n$$\n\nso we need to figure out the first term ${a}_{1}$ and the common difference $d.$\n\nTo find the common difference, we can find the total difference between the terms ${a}_{22}=76$ and ${a}_{6}=-4$ and divide it by the number of jumps, as follows:\n\n$$\n\\begin{aligned}d & =\\frac{{a}_{22}-{a}_{6}}{22-6} \\\\  & =\\frac{76-(-4)}{22-6} \\\\  & =\\frac{80}{16} \\\\  & =5\\end{aligned}\n$$\n\nNow, we can use one of our known values, say, ${a}_{6}=-4,$ to determine the first term of the sequence. Since ${a}_{6}$ is $5$ jumps after ${a}_{1},$ we have:\n\n$$\n\\begin{aligned}{a}_{6} & ={a}_{1}+5d \\\\ -4 & ={a}_{1}+5\\cdot 5 \\\\ -4 & ={a}_{1}+25 \\\\ {a}_{1} & =-29\\end{aligned}\n$$\n\nSo the formula for the $n$th term is:\n\n$$\n\\begin{aligned}{a}_{n} & =-29+(n-1)\\cdot 5 \\\\  & =-34+5n\\end{aligned}\n$$\n\nFinally, we can find the $31$st term by substituting $n=31$ into the above:\n\n$$\n\\begin{aligned}{a}_{31} & =-34+5(31) \\\\  & =-34+155 \\\\  & =121\\end{aligned}\n$$"} :step/id #uuid "7a31efa5-d4c7-5882-8e55-b1f919330c88" :step/next {:db/id #edb/ref 17592186539058}} {:db/id #edb/ref 17592186539111 :step/content {:db/id #edb/ref 17592186539019 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d577714-df32-50d4-a3a7-992d2e6e61f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}_{n}=8n-5" :db/id #edb/ref 17592186538436} {:answer/id #uuid "757055cf-e772-58da-a703-f43ec9a3c7e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}_{n}=4n-12" :db/id #edb/ref 17592186538495} {:answer/id #uuid "809e7a62-ae33-582b-8668-82433fc6dda6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}_{n}=2n-17" :db/id #edb/ref 17592186538527} {:answer/id #uuid "94a2410d-cad5-53c3-8faf-cf633aeba7d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}_{n}=4n-15" :db/id #edb/ref 17592186538581} {:answer/id #uuid "d67c9c6d-7661-524e-8b60-4eeb9d1f1a9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}_{n}=4n+8" :db/id #edb/ref 17592186538727}] :answer-field/correct {:db/id #edb/ref 17592186538581} :answer-field/id #uuid "aa1e5362-5987-509c-a24c-44644e0e29bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538886}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e16d4c55-4032-51af-b361-3c91c642bb36" :question/math-academy-id "q-51559" :question/problem "The $8$th and $9$th terms of an arithmetic sequence are $17$ and $21,$ respectively. Determine the formula for the $n$th term of the sequence." :question/worked-solution "The formula for the $n$th term is given by \n\n$$\n{a}_{n}={a}_{1}+(n-1)d,\n$$\n\nso we need to figure out the first term ${a}_{1}$ and the common difference $d.$ \n\nSince the terms ${a}_{8}=17$ and ${a}_{9}=21$ are consecutive, we can subtract them to find the common difference:\n\n$$\n\\begin{aligned}d & ={a}_{9}-{a}_{8} \\\\  & =21-17 \\\\  & =4\\end{aligned}\n$$\n\nNow, we can use one of our known values, say, ${a}_{8}=17,$ to determine the first term of the sequence. Since ${a}_{8}$ is $7$ jumps after ${a}_{1},$ we have:\n\n$$\n\\begin{aligned}{a}_{8} & ={a}_{1}+7d \\\\ 17 & ={a}_{1}+7(4) \\\\ 17 & ={a}_{1}+28 \\\\ 17-28 & ={a}_{1} \\\\ {a}_{1} & =-11\\end{aligned}\n$$\n\nSo, the formula for the $n$th term of this arithmetic sequence is:  \n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =-11+(n-1)(4) \\\\  & =-11+4n-4 \\\\  & =4n-15\\end{aligned}\n$$"} :step/id #uuid "e7692710-4fdb-558d-9af2-f742b0d553e5"}] :activity/title "Finding the Nth Term of an Arithmetic Sequence Given Two Terms" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186538216}]}
