se\">(</mo><mn>3</mn><mi>n</mi><mo>−</mo><mn>4</mn><mo stretchy=\"false\">)</mo><mi>n</mi><mo>+</mo><mo stretchy=\"false\">(</mo><mn>3</mn><mi>n</mi><mo>−</mo><mn>4</mn><mo stretchy=\"false\">)</mo><mn>7</mn><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><msup><mi>n</mi><mn>3</mn></msup><mo stretchy=\"false\">(</mo><mn>3</mn><mi>n</mi><mo>−</mo><mn>4</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mi>n</mi><mo>+</mo><mn>7</mn><mo stretchy=\"false\">)</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
