></mtd></mtr><mtr><mtd><msup><mi>s</mi><mn>4</mn></msup><mo stretchy=\"false\">(</mo><msup><mi>s</mi><mn>2</mn></msup><mo>−</mo><mn>2</mn><mo>⋅</mo><mn>2</mn><mo>⋅</mo><mi>s</mi><mo>+</mo><msup><mn>2</mn><mn>2</mn></msup><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><msup><mi>s</mi><mn>4</mn></msup><mo stretchy=\"false\">(</mo><mi>s</mi><mo>−</mo><mn>2</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
