t 2\\cdot s+{2}^{2}) & = \\\\ {s}^{4}(s-2)^{2}\\end{aligned}\n$$"} :step/id #uuid "cca2341d-38bb-5afc-ae65-fedb43e7191e" :step/next {:db/id #edb/ref 17592186570060}}] :activity/title "Further Factoring of Polynomials Using GCFs" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186569434}]}
