#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186139329} :activity/id #uuid "47ffc276-429d-5b35-a369-8a6c6db7a74c" :activity/scope {:db/id #edb/ref 17592186050827 :topic/id #uuid "69d60d04-3212-57d7-b613-ac51716a407a" :topic/math-academy-id 2337} :activity/steps [{:db/id #edb/ref 17592186139293 :step/content {:db/id #edb/ref 17592186138386 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138298 :question/id #uuid "ebc0888c-bc8b-5f8c-8e2a-667ca1490d37" :question/math-academy-id "e-4362"} :knowledge-point/id #uuid "0606514f-fdaf-58b5-af01-e4448bf973ac" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048928} {:db/id #edb/ref 17592186051017}] :knowledge-point/questions [{:db/id #edb/ref 17592186139161} {:db/id #edb/ref 17592186139162} {:db/id #edb/ref 17592186530489} {:db/id #edb/ref 17592186530528}] :knowledge-point/title "Factoring Using Common Factors and Differences of Squares"} :step/id #uuid "aa15e218-d8c9-57c8-849f-8e6ae53c6a2a" :step/math-academy-id 16028 :step/next {:db/id #edb/ref 17592186139324}} {:db/id #edb/ref 17592186139324 :step/content {:db/id #edb/ref 17592186138409 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138302 :question/id #uuid "da0223c6-ff03-55da-992c-d8a1ef3f9aff" :question/math-academy-id "e-4999"} :knowledge-point/id #uuid "1d645eb4-1466-56bd-bbd0-67d3967bec55" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051032}] :knowledge-point/questions [{:db/id #edb/ref 17592186139163} {:db/id #edb/ref 17592186139164} {:db/id #edb/ref 17592186530422} {:db/id #edb/ref 17592186530483} {:db/id #edb/ref 17592186569975} {:db/id #edb/ref 17592186570003}] :knowledge-point/title "Factoring Using Common Factors and Perfect Square Trinomials"} :step/id #uuid "34163b20-626f-5df3-b804-04f47202e01a" :step/math-academy-id 18055 :step/next {:db/id #edb/ref 17592186139325}} {:db/id #edb/ref 17592186139325 :step/content {:db/id #edb/ref 17592186138410 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138303 :question/id #uuid "007b9b7b-5fab-5e50-9598-fc94a9f6edde" :question/math-academy-id "e-5000"} :knowledge-point/id #uuid "d02438a3-10ca-5fe5-aad7-ec2c728223e6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048375}] :knowledge-point/questions [{:db/id #edb/ref 17592186139165} {:db/id #edb/ref 17592186139166} {:db/id #edb/ref 17592186234255} {:db/id #edb/ref 17592186530484} {:db/id #edb/ref 17592186570024}] :knowledge-point/title "Factoring Using Common Factors and Quadratic Factoring"} :step/id #uuid "23dd4876-d6d3-50c1-a5c6-9d5d709220d3" :step/math-academy-id 18056} {:db/id #edb/ref 17592186139329 :step/content {:db/id #edb/ref 17592186139645 :tutorial/content "To factor a polynomial, the first step is to find the common factor of all the terms and factor it out. Once we've done that, we can try to apply other factoring tricks that we've learned for quadratic expressions.\n\nFor example, consider the polynomial $2x^3-2x.$\n\nFirst, notice that all of the terms have a common factor of $2x.$ To simplify the computation, we can factor out the $2x,$ as follows:\n\n$$\n2x^3-2x = 2x(x^2-1)\n$$\n\nNow, we factor the expression $x^2-1$ using the difference of squares formula:\n\n$$\n2x(x^2-1) = 2x(x+1)(x-1)\n$$\n\nSo, the expression $2x^3-2x$ factors into $2x(x+1)(x-1).$" :tutorial/id #uuid "85714b2f-9623-52ab-aa32-df1827f75877" :tutorial/math-academy-id 3366 :tutorial/title "Introduction"} :step/id #uuid "bb62a766-8bbc-56b7-a5a5-1db2c882c43d" :step/math-academy-id 18735 :step/next {:db/id #edb/ref 17592186139293}}] :activity/title "Further Factoring of Polynomials Using GCFs" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186138638}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186570089} :activity/id #uuid "132a1609-d838-5cdf-86ad-3b381309c84b" :activity/scope {:db/id #edb/ref 17592186050827 :topic/id #uuid "69d60d04-3212-57d7-b613-ac51716a407a" :topic/math-academy-id 2337} :activity/steps [{:db/id #edb/ref 17592186570060 :step/content {:db/id #edb/ref 17592186569975 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "040ec5ab-bcdf-5aca-99d8-720e6b5d8392" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h(h+4)^{6}" :db/id #edb/ref 17592186569451} {:answer/id #uuid "574ae8f2-ab3d-5f65-a5ac-bc1418674da6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{h}^{4}(h-4)^{3}" :db/id #edb/ref 17592186569569} {:answer/id #uuid "5d268b5c-01f0-51e5-95fd-adf189f6f7e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{h}^{4}(h+4)^{3}" :db/id #edb/ref 17592186569582} {:answer/id #uuid "95c2c16a-d3fe-5fc6-bead-e655541975ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{h}^{5}(h-4)^{2}" :db/id #edb/ref 17592186569680} {:answer/id #uuid "ee148d99-14db-571f-b95d-3fd724833b22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{h}^{5}(h+4)^{2}" :db/id #edb/ref 17592186569819}] :answer-field/correct {:db/id #edb/ref 17592186569819} :answer-field/id #uuid "f9a21e5e-fd27-5130-9714-620502136f1b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186569952}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2c4e4328-a65d-5ebb-a442-4282ed74de70" :question/math-academy-id "q-111940" :question/problem "Factor the expression ${h}^{7}+8{h}^{6}+16{h}^{5}.$" :question/worked-solution "First, notice that all of the terms have a common factor of ${h}^{5}.$ To simplify the computation, we can factor out the ${h}^{5},$ as follows:\n\n$$\n\\begin{aligned}{h}^{7}+8{h}^{6}+16{h}^{5} & ={h}^{5}({h}^{2}+8h+16)\\end{aligned}\n$$\n\nThe expression ${h}^{2}+8h+16$ is a perfect square trinomial that can be factored as follows:\n\n$$\n\\begin{aligned}{h}^{5}({h}^{2}+8h+16) & = \\\\ {h}^{5}({h}^{2}+8h+{4}^{2}) & = \\\\ {h}^{5}({h}^{2}+2\\cdot 4h+{4}^{2}) & = \\\\ {h}^{5}(h+4)^{2}\\end{aligned}\n$$"} :step/id #uuid "55ce3c56-629b-5830-a242-61d678abce37"} {:db/id #edb/ref 17592186570089 :step/content {:db/id #edb/ref 17592186570024 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12e23d40-d227-5424-b5b7-586c63816d72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{n}^{3}(3n+4)^{2}" :db/id #edb/ref 17592186569473} {:answer/id #uuid "2fd4fa4b-4269-5a19-9696-33db33bf7069" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{n}^{3}(3n-7)^{2}" :db/id #edb/ref 17592186569511} {:answer/id #uuid "4eae722a-276d-56a3-8d3f-0f4ca15c0011" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{n}^{2}(2{n}^{2}-14)(n+2)" :db/id #edb/ref 17592186569555} {:answer/id #uuid "a2f6c753-5968-5e31-b594-ba31ba82d2aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{n}^{3}(3n-4)(n+7)" :db/id #edb/ref 17592186569704} {:answer/id #uuid "c7f338ee-1cf8-53b5-9adf-f59a8579be4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{n}^{2}(n-4)(3n+7)" :db/id #edb/ref 17592186569762}] :answer-field/correct {:db/id #edb/ref 17592186569704} :answer-field/id #uuid "60e37793-57d8-5148-aa95-28701d621f67" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186569884}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "cfe388a1-fc00-503a-b10d-218d6be786a1" :question/math-academy-id "q-44531" :question/problem "Factor $3{n}^{5}+17{n}^{4}-28{n}^{3}.$" :question/worked-solution "Note that all of the terms have a common factor of ${n}^{3}.$ To simplify the computation, we can factor out the ${n}^{3},$ as follows:\n\n$$\n\\begin{aligned}3{n}^{5}+17{n}^{4}-28{n}^{3} & ={n}^{3}(3{n}^{2}+17n-28)\\end{aligned}\n$$\n\nNow, we factor the polynomial $3{n}^{2}+17n-28,$ as follows:\n\n$$\n\\begin{aligned}{n}^{3}(3{n}^{2}+17n-28) & = \\\\ {n}^{3}((3{n}^{2}-4n)+(21n-28)) & = \\\\ {n}^{3}((3n-4)n+(3n-4)7) & = \\\\ {n}^{3}(3n-4)(n+7)\\end{aligned}\n$$"} :s