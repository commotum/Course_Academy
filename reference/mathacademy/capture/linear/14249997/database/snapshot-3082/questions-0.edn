#{[{:db/id #edb/ref 17592186569975 :knowledge-point/_questions [{:db/id #edb/ref 17592186138409 :knowledge-point/id #uuid "1d645eb4-1466-56bd-bbd0-67d3967bec55" :knowledge-point/title "Factoring Using Common Factors and Perfect Square Trinomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "040ec5ab-bcdf-5aca-99d8-720e6b5d8392" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "h(h+4)^{6}" :db/id #edb/ref 17592186569451} {:answer/id #uuid "574ae8f2-ab3d-5f65-a5ac-bc1418674da6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{h}^{4}(h-4)^{3}" :db/id #edb/ref 17592186569569} {:answer/id #uuid "5d268b5c-01f0-51e5-95fd-adf189f6f7e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{h}^{4}(h+4)^{3}" :db/id #edb/ref 17592186569582} {:answer/id #uuid "95c2c16a-d3fe-5fc6-bead-e655541975ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{h}^{5}(h-4)^{2}" :db/id #edb/ref 17592186569680} {:answer/id #uuid "ee148d99-14db-571f-b95d-3fd724833b22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{h}^{5}(h+4)^{2}" :db/id #edb/ref 17592186569819}] :answer-field/correct {:answer/id #uuid "ee148d99-14db-571f-b95d-3fd724833b22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{h}^{5}(h+4)^{2}" :db/id #edb/ref 17592186569819} :answer-field/id #uuid "f9a21e5e-fd27-5130-9714-620502136f1b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569952}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2c4e4328-a65d-5ebb-a442-4282ed74de70" :question/math-academy-id "q-111940" :question/problem "Factor the expression ${h}^{7}+8{h}^{6}+16{h}^{5}.$" :question/worked-solution "First, notice that all of the terms have a common factor of ${h}^{5}.$ To simplify the computation, we can factor out the ${h}^{5},$ as follows:\n\n$$\n\\begin{aligned}{h}^{7}+8{h}^{6}+16{h}^{5} & ={h}^{5}({h}^{2}+8h+16)\\end{aligned}\n$$\n\nThe expression ${h}^{2}+8h+16$ is a perfect square trinomial that can be factored as follows:\n\n$$\n\\begin{aligned}{h}^{5}({h}^{2}+8h+16) & = \\\\ {h}^{5}({h}^{2}+8h+{4}^{2}) & = \\\\ {h}^{5}({h}^{2}+2\\cdot 4h+{4}^{2}) & = \\\\ {h}^{5}(h+4)^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570024 :knowledge-point/_questions [{:db/id #edb/ref 17592186138410 :knowledge-point/id #uuid "d02438a3-10ca-5fe5-aad7-ec2c728223e6" :knowledge-point/title "Factoring Using Common Factors and Quadratic Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12e23d40-d227-5424-b5b7-586c63816d72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{3}(3n+4)^{2}" :db/id #edb/ref 17592186569473} {:answer/id #uuid "2fd4fa4b-4269-5a19-9696-33db33bf7069" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{3}(3n-7)^{2}" :db/id #edb/ref 17592186569511} {:answer/id #uuid "4eae722a-276d-56a3-8d3f-0f4ca15c0011" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{2}(2{n}^{2}-14)(n+2)" :db/id #edb/ref 17592186569555} {:answer/id #uuid "a2f6c753-5968-5e31-b594-ba31ba82d2aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{3}(3n-4)(n+7)" :db/id #edb/ref 17592186569704} {:answer/id #uuid "c7f338ee-1cf8-53b5-9adf-f59a8579be4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{2}(n-4)(3n+7)" :db/id #edb/ref 17592186569762}] :answer-field/correct {:answer/id #uuid "a2f6c753-5968-5e31-b594-ba31ba82d2aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{3}(3n-4)(n+7)" :db/id #edb/ref 17592186569704} :answer-field/id #uuid "60e37793-57d8-5148-aa95-28701d621f67" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569884}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cfe388a1-fc00-503a-b10d-218d6be786a1" :question/math-academy-id "q-44531" :question/problem "Factor $3{n}^{5}+17{n}^{4}-28{n}^{3}.$" :question/worked-solution "Note that all of the terms have a common factor of ${n}^{3}.$ To simplify the computation, we can factor out the ${n}^{3},$ as follows:\n\n$$\n\\begin{aligned}3{n}^{5}+17{n}^{4}-28{n}^{3} & ={n}^{3}(3{n}^{2}+17n-28)\\end{aligned}\n$$\n\nNow, we factor the polynomial $3{n}^{2}+17n-28,$ as follows:\n\n$$\n\\begin{aligned}{n}^{3}(3{n}^{2}+17n-28) & = \\\\ {n}^{3}((3{n}^{2}-4n)+(21n-28)) & = \\\\ {n}^{3}((3n-4)n+(3n-4)7) & = \\\\ {n}^{3}(3n-4)(n+7)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570003 :knowledge-point/_questions [{:db/id #edb/ref 17592186138409 :knowledge-point/id #uuid "1d645eb4-1466-56bd-bbd0-67d3967bec55" :knowledge-point/title "Factoring Using Common Factors and Perfect Square Trinomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e10bf21-a085-5225-9e50-b8399bd50bc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{s}^{4}(s+2)(s-2)" :db/id #edb/ref 17592186569508} {:answer/id #uuid "6c382d23-03d9-5fba-94e6-efeccbf637e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{s}^{4}(s-2)^{2}" :db/id #edb/ref 17592186569615} {:answer/id #uuid "96a29d2f-4d5d-549b-80ab-68c608300205" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{s}^{5}(s-4)" :db/id #edb/ref 17592186569681} {:answer/id #uuid "be84eb82-1c77-5ed7-8435-bb77d4b7d622" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{s}^{2}(s+2)^{2}(s-2)^{2}" :db/id #edb/ref 17592186569747} {:answer/id #uuid "fe095cce-7414-588e-8038-6dedc80d8543" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{s}^{3}(s-2)^{2}(s+2)" :db/id #edb/ref 17592186569843}] :answer-field/correct {:answer/id #uuid "6c382d23-03d9-5fba-94e6-efeccbf637e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{s}^{4}(s-2)^{2}" :db/id #edb/ref 17592186569615} :answer-field/id #uuid "97ab82ae-a070-54e1-a8a1-4a953ee8477c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569901}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7cf33662-4ad6-5aa7-8431-3b990d895f49" :question/math-academy-id "q-69844" :question/problem "Factor the expression ${s}^{6}-4{s}^{5}+4{s}^{4}.$" :question/worked-solution "First, notice that all of the terms have a common factor of ${s}^{4}.$ To simplify the computation, we can factor out the ${s}^{4},$ as follows:\n\n$$\n\\begin{aligned}{s}^{6}-4{s}^{5}+4{s}^{4} & ={s}^{4}({s}^{2}-4s+4)\\end{aligned}\n$$\n\nThe expression ${s}^{2}-4s+4$ is a perfect square trinomial that can be factored as follows:\n\n$$\n\\begin{aligned}{s}^{4}({s}^{2}-4s+4) & = \\\\ {s}^{4}({s}^{2}-4s+{2}^{2}) & = \\\\ {s}^{4}({s}^{2}-2\\cdot 2\\cdot s+{2}^{2}) & = \\\\ {s}^{4}(s-2)^{2}\\end{aligned}\n$$"}]}
