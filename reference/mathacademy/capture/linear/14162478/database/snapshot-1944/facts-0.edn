566-08b3cfc3bf82" #edb/ref 17592186045417] [17592186049258 #edb/ref 1028 #edb/ref 17592186184161 #edb/ref 17592186045417] [17592186049258 #edb/ref 1028 #edb/ref 17592186184162 #edb/ref 17592186045417] [17592186049258 #edb/ref 1028 #edb/ref 17592186184163 #edb/ref 17592186045417] [17592186049258 #edb/ref 1031 "Roots of Absolute Value Functions" #edb/ref 17592186045417] [17592186049258 #edb/ref 1033 3851 #edb/ref 17592186045417] [17592186049258 #edb/ref 1035 #uuid "e73acfeb-8e27-55c3-ab0b-f7bd350b0723" #edb/ref 17592186045417] [17592186049309 #edb/ref 1027 #edb/ref 17592186048681 #edb/ref 17592186045417] [17592186049309 #edb/ref 1027 #edb/ref 17592186049795 #edb/ref 17592186045417] [17592186049309 #edb/ref 1027 #edb/ref 17592186050002 #edb/ref 17592186045417] [17592186049309 #edb/ref 1028 #edb/ref 17592186068717 #edb/ref 17592186045417] [17592186049309 #edb/ref 1028 #edb/ref 17592186068718 #edb/ref 17592186045417] [17592186049309 #edb/ref 1028 #edb/ref 17592186068719 #edb/ref 17592186045417] [17592186049309 #edb/ref 1031 "Absolute Value Inequalities" #edb/ref 17592186045417] [17592186049309 #edb/ref 1033 451 #edb/ref 17592186045417] [17592186049309 #edb/ref 1035 #uuid "eb56b359-bf3c-5bc4-a26b-629e05c1d464" #edb/ref 17592186045417] [17592186050448 #edb/ref 1027 #edb/ref 17592186048187 #edb/ref 17592186045417] [17592186050448 #edb/ref 1027 #edb/ref 17592186048517 #edb/ref 17592186045417] [17592186050448 #edb/ref 1027 #edb/ref 17592186049005 #edb/ref 17592186045417] [17592186050448 #edb/ref 1027 #edb/ref 17592186049258 #edb/ref 17592186045417] [17592186050448 #edb/ref 1027 #edb/ref 17592186049309 #edb/ref 17592186045417] [17592186050448 #edb/ref 1028 #edb/ref 17592186192634 #edb/ref 17592186045417] [17592186050448 #edb/ref 1028 #edb/ref 17592186192635 #edb/ref 17592186045417] [17592186050448 #edb/ref 1028 #edb/ref 17592186192636 #edb/ref 17592186045417] [17592186050448 #edb/ref 1031 "Further Absolute Value Equations" #edb/ref 17592186045417] [17592186050448 #edb/ref 1033 4029 #edb/ref 17592186045417] [17592186050448 #edb/ref 1035 #uuid "49d2d213-870d-5feb-be49-bffbb6cbe24a" #edb/ref 17592186045417] [17592186191269 #edb/ref 1075 #edb/ref 17592186486893 #edb/ref 17592186045417] [17592186191269 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186191269 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186191269 #edb/ref 1078 #edb/ref 17592186486893 #edb/ref 17592186045417] [17592186191269 #edb/ref 1079 #uuid "ee0c8bd5-1086-5d70-85b2-9d89fb5fe3c3" #edb/ref 17592186045417] [17592186192592 #edb/ref 1069 "e-14220" #edb/ref 17592186045417] [17592186192592 #edb/ref 1071 "Consider the absolute value equation \n\n$$\n-3|1-x|-2 = -8.\n$$\n\nThis equation can be expressed in the following equivalent form:\n\n$$\n|1-x|=k\n$$\n\nWhat is the value of $k?$" #edb/ref 17592186045417] [17592186192592 #edb/ref 1072 #uuid "b3b99d07-5914-578b-9aaf-f028ada5bee0" #edb/ref 17592186045417] [17592186192592 #edb/ref 1074 "We can rearrange the equation to isolate the absolute value on the left-hand side:\n\nFirst, we add $2$ to both sides of the equation:\n\n$$\n\\begin{aligned}-3|1-x|-2 & =-8 \\\\ -3|1-x|-2+2 & =-8+2 \\\\ -3|1-x| & =-6\\end{aligned}\n$$\n\nThen, we divide both sides of the equation by $-3{:}$\n\n$$\n\\begin{aligned}-3|1-x| & =-6 \\\\ \\frac{-3|1-x|}{-3} & =\\frac{-6}{-3} \\\\ \\frac{\\cancel{-3}|1-x|}{\\cancel{-3}} & =2 \\\\ |1-x| & =2\\end{aligned}\n$$\n\nTherefore, $k=2.$" #edb/ref 17592186045417] [17592186192593 #edb/ref 1069 "e-14223" #edb/ref 17592186045417] [17592186192593 #edb/ref 1071 "Which of the following equations has *no* solution?\n\nI. $|1-x| = -5$\n\nII. $|1-x| + 5 = 2$\n\nIII. $|1-x| = 3$" #edb/ref 17592186045417] [17592186192593 #edb/ref 1072 #uuid "89382e45-4e78-554f-88e1-2bbf281617e9" #edb/ref 17592186045417] [17592186192593 #edb/ref 1074 "An absolute value equation has no solution if, when the absolute value is isolated on the left-hand side, the right-hand side is negative.\n\nWith that in mind, let's look at each equation in turn:\n\n- Equation I *has no solution*. The absolute value is already isolated on the left-hand side, and the right-hand side is *negative*.\n\n- Equation II *has no solution*. To see this, we first isolate the absolute value on the left-hand side as follows:\n\n$$\n\\begin{aligned}|1-x|+5 & =2 \\\\ |1-x| & =-3\\end{aligned}\n$$\n\nSince the right-hand side is *negative*, this equation has *no* solution.\n\n- Equation III has a solution. The absolute value is already isolated on the left-hand side, and the right-hand side is non-negative.\n\nTherefore, the answer is \"I and II only.\"" #edb/ref 17592186045417] [17592186192594 #edb/ref 1069 "e-14228" #edb/ref 17592186045417] [17592186192594 #edb/ref 1071 "Solve the equation $2| 2a - 4 | - 7 = 13.$" #edb/ref 17592186045417] [17592186192594 #edb/ref 1072 #uuid "de2efe4f-e236-5fb2-bc46-eb037ecf26b1" #edb/ref 17592186045417] [17592186192594 #edb/ref 1074 "First, we isolate the absolute value on the left side of the equation:\n\n \n\n$$\n\\begin{aligned}2|2a-4|-7 & =13 \\\\ 2|2a-4| & =20 \\\\ |2a-4| & =10\\end{aligned}\n$$\n\nNow, we have the following two cases:\n\n- If $|2a-4| = 2a-4,$ we obtain:\n\n$$\n\\begin{aligned}|2a-4| & =10 \\\\ 2a-4 & =10 \\\\ 2a & =14 \\\\ a & =7\\end{aligned}\n$$\n\n- If $|2a-4| = -(2a-4),$ we obtain:\n\n$$\n\\begin{aligned}|2a-4| & =10 \\\\ -(2a-4) & =10 \\\\ -2a+4 & =10 \\\\ -2a & =6 \\\\ a & =-3\\end{aligned}\n$$\n\nTherefore, the solutions are $a=-3$ and $a=7.$" #edb/ref 17592186045417] [17592186192634 #edb/ref 1037 #edb/ref 17592186048267 #edb/ref 17592186045417] [17592186192634 #edb/ref 1038 #edb/ref 17592186193128 #edb/ref 17592186045417] [17592186192634 #edb/ref 1038 #edb/ref 17592186193245 #edb/ref 17592186045417] [17592186192634 #edb/ref 1038 #edb/ref 17592186487339 #edb/ref 17592186045417] [17592186192634 #edb/ref 1038 #edb/ref 17592186487365 #edb/ref 17592186045417] [17592186192634 #edb/ref 1038 #edb/ref 17592186487368 #edb/ref 17592186045417] [17592186192634 #edb/ref 1039 "Isolating an Absolute Value Expression" #edb/ref 17592186045417] [17592186192634 #edb/ref 1041 #edb/ref 17592186192592 #edb/ref 17592186045417] [17592186192634 #edb/ref 1042 #uuid "5bc2c576-4f7c-5b4a-8c78-8a41420fdcce" #edb/ref 17592186045417] [17592186192635 #edb/ref 1038 #edb/ref 17592186193131 #edb/ref 17592186045417] [17592186192635 #edb/ref 1038 #edb/ref 17592186193370 #edb/ref 17592186045417] [17592186192635 #edb/ref 1038 #edb/ref 17592186487333 #edb/ref 17592186045417] [17592186192635 #edb/ref 1038 #edb/ref 17592186487392 #edb/ref 17592186045417] [17592186192635 #edb/ref 1039 "Absolute Value Equations With No Solution" #edb/ref 17592186045417] [17592186192635 #edb/ref 1041 #edb/ref 17592186192593 #edb/ref 17592186045417] [17592186192635 #edb/ref 1042 #uuid "94d6a2aa-4288-51dc-8944-cf9490812ad2" #edb/ref 17592186045417] [17592186192636 #edb/ref 1038 #edb/ref 17592186193246 #edb/ref 17592186045417] [17592186192636 #edb/ref 1038 #edb/ref 17592186193251 #edb/ref 17592186045417] [17592186192636 #edb/ref 1038 #edb/ref 17592186487342 #edb/ref 17592186045417] [17592186192636 #edb/ref 1038 #edb/ref 17592186487353 #edb/ref 17592186045417] [17592186192636 #edb/ref 1038 #edb/ref 17592186487381 #edb/ref 17592186045417] [17592186192636 #edb/ref 1038 #edb/ref 17592186487385 #edb/ref 17592186045417] [17592186192636 #edb/ref 1039 "Rearranging and Solving an Absolute Value Equation" #edb/ref 17592186045417] [17592186192636 #edb/ref 1041 #edb/ref 17592186192594 #edb/ref 17592186045417] [17592186192636 #edb/ref 1042 #uuid "15f03573-42ee-50d4-acdf-e2ee05d3e7e4" #edb/ref 17592186045417] [17592186192907 #edb/ref 1043 #edb/ref 17592186193425 #edb/ref 17592186045417] [17592186192907 #edb/ref 1043 #edb/ref 17592186193426 #edb/ref 17592186045417] [17592186192907 #edb/ref 1043 #edb/ref 17592186193427 #edb/ref 17592186045417] [17592186192907 #edb/ref 1043 #edb/ref 17592186193428 #edb/ref 17592186045417] [17592186192907 #edb/ref 1043 #edb/ref 17592186193429 #edb/ref 17592186045417] [17592186192907 #edb/ref 1043 #edb/ref 17592186193430 #edb/ref 17592186045417] [17592186192907 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186192907 #edb/ref 1045 "Further Absolute Value Equations" #edb/ref 17592186045417] [17592186192907 #edb/ref 1046 #edb/ref 17592186193425 #edb/ref 17592186045417] [17592186192907 #edb/ref 1049 #edb/ref 17592186050448 #edb/ref 17592186045417] [17592186192907 #edb/ref 1050 480.0 #edb/ref 17592186045417] [17592186192907 #edb/ref 1053 #uuid "157f57f7-71ad-5178-b6a1-cb1065e17520" #edb/ref 17592186045417] [17592186193245 #edb/ref 1068 #edb/ref 17592186191269 #edb/ref 17592186045417] [17592186193245 #edb/ref 1069 "q-212480" #edb/ref 17592186045417] [17592186193245 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186193245 #edb/ref 1071 "Consider the absolute value equation \n\n$$\n2-|x+2|=-7.\n$$\n\nThis equation can be expressed in the following equivalent form:\n\n$|x+2|=$\n{{field-1}}" #edb/ref 17592186045417] [17592186193245 #edb/ref 1072 #uuid "e5a53e17-d1d0-5fa9-8d04-0b459a7ec9bd" #edb/ref 17592186045417] [17592186193245 #edb/ref 1074 "We can rearrange the equation to isolate the absolute value on the left side:\n\nFirst, we subtract $2$ from both sides of the equation:\n\n$$\n\\begin{aligned}2-|x+2|=-7 \\\\ 2-|x+2|-2=-7-2 \\\\ -|x+2|=-9\\end{aligned}\n$$\n\nThen, we multiply both sides of the equation by $-1:$\n\n$$\n\\begin{aligned}-|x+2| & =-9 \\\\ (-1)\\cdot (-|x+2|) & =(-1)\\cdot (-9) \\\\ (\\cancel{-}1)\\cdot (\\cancel{-}|x+2|) & =9 \\\\ |x+2| & =9\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186193425 #edb/ref 1058 #edb/ref 17592186193426 #edb/ref 17592186045417] [17592186193425 #edb/ref 1061 144049 #edb/ref 17592186045417] [17592186193425 #edb/ref 1062 #uuid "b4b80cf6-ac66-5b80-8e9a-84e34ac2fd5d" #edb/ref 17592186045417] [17592186193425 #edb/ref 1063 #edb/ref 17592186193943 #edb/ref 17592186045417] [17592186193426 #edb/ref 1058 #edb/ref 17592186193427 #edb/ref 17592186045417] [17592186193426 #edb/ref 1061 144050 #edb/ref 17592186045417] [17592186193426 #edb/ref 1062 #uuid "6e54dac3-7257-553a-9281-d652e78869f1" #edb/ref 17592186045417] [17592186193426 #edb/ref 1063 #edb/ref 17592186192634 #edb/ref 17592186045417] [17592186193427 #edb/ref 1058 #edb/ref 17592186193428 #edb/ref 17592186045417] [17592186193427 #edb/ref 1061 144054 #edb/ref 17592186045417] [17592186193427 #edb/ref 1062 #uuid "1f7f7690-789e-59b6-a31a-f699646aed1e" #edb/ref 17592186045417] [17592186193427 #edb/ref 1063 #edb/ref 17592186193944 #edb/ref 17592186045417] [17592186193428 #edb/ref 1058 #edb/ref 17592186193429 #edb/ref 17592186045417] [17592186193428 #edb/ref 1061 144055 #edb/ref 17592186045417] [17592186193428 #edb/ref 1062 #uuid "dd2c5b77-7fcb-5443-969e-13f565428281" #edb/ref 17592186045417] [17592186193428 #edb/ref 1063 #edb/ref 17592186193945 #edb/ref 17592186045417] [17592186193429 #edb/ref 1058 #edb/ref 17592186193430 #edb/ref 17592186045417] [17592186193429 #edb/ref 1061 144056 #edb/ref 17592186045417] [17592186193429 #edb/ref 1062 #uuid "cc568d38-8ed7-5e05-b47d-35fcd03f33e3" #edb/ref 17592186045417] [17592186193429 #edb/ref 1063 #edb/ref 17592186192635 #edb/ref 17592186045417] [17592186193430 #edb/ref 1061 144059 #edb/ref 17592186045417] [17592186193430 #edb/ref 1062 #uuid "9aebc5c1-cf53-5a78-8700-b622cd65203b" #edb/ref 17592186045417] [17592186193430 #edb/ref 1063 #edb/ref 17592186192636 #edb/ref 17592186045417] [17592186193943 #edb/ref 1064 "A valuable skill to master when dealing with absolute value equations is to isolate the absolute value expression first.\n\nTo isolate an absolute value expression, we treat it like a variable in a linear equation.\n\nTo demonstrate, let's consider the following absolute value equation:\n\n$$\n2|x-1| + 4 = 8\n$$\n\nWe aim to isolate the $|x-1|$ term on the left-hand side. \n\nWe start by subtracting $4$ from both sides of the equation:\n\n$$\n\\begin{aligned}2|x-1|+4 & =8 \\\\ 2|x-1|+4-4 & =8-4 \\\\ 2|x-1| & =4\\end{aligned}\n$$\n\nThen, we divide both sides of the equation by $2{:}$\n\n$$\n\\begin{aligned}2|x-1| & =4 \\\\ \\frac{2|x-1|}{2} & =\\frac{4}{2} \\\\ \\frac{\\cancel{2}|x-1|}{\\cancel{2}} & =2 \\\\ |x-1| & =2\\end{aligned}\n$$\n\nAnd that's it! We've successfully isolated the absolute value expression in our equation.\n\nLet's consider another example." #edb/ref 17592186045417] [17592186193943 #edb/ref 1065 8824 #edb/ref 17592186045417] [17592186193943 #edb/ref 1066 #uuid "640fe647-93cb-5b1a-8707-6c53032d81ae" #edb/ref 17592186045417] [17592186193943 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186193944 #edb/ref 1064 "Let's consider the following absolute value equation:\n\n$$\n\\vert x \\vert = -4\n$$\n\nNote the following:\n\n- The absolute value of any number is *always* positive or zero.\n\n- So, there is no number whose absolute value is negative.\n\n- Therefore, this equation $|x| = -4$ has **no solution.**\n\nAnother way of understanding this is to recall that the absolute value of a number represents the number's distance from the origin, and distances cannot be negative." #edb/ref 17592186045417] [17592186193944 #edb/ref 1065 8826 #edb/ref 17592186045417] [17592186193944 #edb/ref 1066 #uuid "b272858e-f85c-5daa-ad70-c87f7a3b792f" #edb/ref 17592186045417] [17592186193944 #edb/ref 1067 "Recognizing Equations With No Solution" #edb/ref 17592186045417] [17592186193945 #edb/ref 1064 "So, we know that the following equation has no solution:\n\n$$\n\\vert x \\vert = -4\n$$\n\nLet's see what happens when we blindly apply the usual process of solving our equation:\n\n- if $|x| = x,$ we get\n\n$$\n\\begin{aligned}|x| & =-4 \\\\ x & =-4.\\end{aligned}\n$$\n\n- if $|x| = -x,$ we get\n\n$$\n\\begin{aligned}|x| & =-4 \\\\ -x & =-4 \\\\ x & =4.\\end{aligned}\n$$\n\nSo, the usual process has given us the \"solutions\" $x= {\\color{red}{-4}}$ and $x= {\\color{blue}{4}}.$ However, neither of these values satisfies the original equation!\n\nFor example, by substituting $x = {\\color{blue}{4}}$ into the original equation, we get a *false statement!*\n\n$$\n\\begin{aligned}|x| & =-4 \\\\ |4| & =-4 \\\\ 4 & =-4\\,\\times \\end{aligned}\n$$\n\nThe key takeaway is that it's essential to check that the right-hand side is positive (or zero) *before* applying the usual solution process." #edb/ref 17592186045417] [17592186193945 #edb/ref 1065 8827 #edb/ref 17592186045417] [17592186193945 #edb/ref 1066 #uuid "ea3bc553-4605-5ceb-8f0b-e788bb67414a" #edb/ref 17592186045417] [17592186193945 #edb/ref 1067 "Attempting to Solve an Equation With No Solution" #edb/ref 17592186045417] [17592186486636 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186486636 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186486636 #edb/ref 1083 #uuid "134da1c6-a5fe-5aaf-877e-e7d3b0e64c90" #edb/ref 17592186045417] [17592186486641 #edb/ref 1080 "I and III only" #edb/ref 17592186045417] [17592186486641 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186486641 #edb/ref 1083 #uuid "15baa1d5-fba5-5eb4-ad30-a795a51c00a7" #edb/ref 17592186045417] [17592186486652 #edb/ref 1080 "II and III only" #edb/ref 17592186045417] [17592186486652 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186486652 #edb/ref 1083 #uuid "1eb2b10e-8e54-5eb1-bcba-8ce98a286647" #edb/ref 17592186045417] [17592186486670 #edb/ref 1080 "x=-2,-\\frac{4}{5}" #edb/ref 17592186045417] [17592186486670 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186486670 #edb/ref 1083 #uuid "26888d75-42dd-5e33-82b3-e66a129d799b" #edb/ref 17592186045417] [17592186486681 #edb/ref 1080 "8" #edb/ref 17592186045417] [17592186486681 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186486681 #edb/ref 1083 #uuid "2d34e6bd-f4b7-56e2-b7bb-3bf9883cc110" #edb/ref 17592186045417] [17592186486697 #edb/ref 1080 "-8" #edb/ref 17592186045417] [17592186486697 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045