65H28V211L179 442Q332 674 334 675Q336 677 355 677H373L379 671V211H471V165H379V114Q379 73 379 66T385 54Q393 47 442 46H471V0H462ZM293 211V545L74 212L183 211H293Z\"></path>\n<path stroke-width=\"1\" id=\"E5-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n<g transform=\"translate(167,0)\">\n<g transform=\"translate(-11,0)\">\n<g transform=\"translate(221,1775)\">\n <use xlink:href=\"#E5-MJMAIN-7C\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMATHI-78\" x=\"278\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-7C\" x=\"851\" y=\"0\"></use>\n</g>\n<g transform=\"translate(0,-75)\">\n <use xlink:href=\"#E5-MJMAIN-2212\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMATHI-78\" x=\"778\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E5-MJMATHI-78\" x=\"778\" y=\"-1875\"></use>\n</g>\n<g transform=\"translate(1340,0)\">\n<g transform=\"translate(0,1775)\">\n <use xlink:href=\"#E5-MJMAIN-3D\" x=\"277\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-2212\" x=\"1334\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-34\" x=\"2112\" y=\"0\"></use>\n</g>\n<g transform=\"translate(0,-75)\">\n <use xlink:href=\"#E5-MJMAIN-3D\" x=\"277\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-2212\" x=\"1334\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-34\" x=\"2112\" y=\"0\"></use>\n</g>\n<g transform=\"translate(0,-1875)\">\n <use xlink:href=\"#E5-MJMAIN-3D\" x=\"277\" y=\"0\"></use>\n<g transform=\"translate(1334,0)\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n <use xlink:href=\"#E5-MJMAIN-34\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E5-MJMAIN-2E\" x=\"1834\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n</li>\n</ul>\n<p>So, th