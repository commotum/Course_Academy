#{[{:activity/expected-seconds 900.0 :activity/first-step {:db/id #edb/ref 17592186065168} :activity/id #uuid "43bcaf37-4f35-5441-9262-198383c30f89" :activity/scope {:db/id #edb/ref 17592186050789 :topic/id #uuid "671f0549-be03-552c-a435-a204b8c7e733" :topic/math-academy-id 305} :activity/steps [{:db/id #edb/ref 17592186065168 :step/content {:db/id #edb/ref 17592186065335 :tutorial/content "The chain rule can be used to differentiate trigonometric functions like \n\n$$\ny = \\sin (2x).\n$$\n\nFirst, notice that this function can be written as the composite function\n\n$$\ny = \\sin u, \\qquad u = 2x.\n$$\n\nWe can use the chain rule to compute the derivative of this composite function:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{\\text{d}}{\\text{d}u}(\\operatorname{sin}u)\\cdot \\frac{\\text{d}}{\\text{d}x}(2x) \\\\  & =\\operatorname{cos}u\\cdot 2 \\\\  & =2\\operatorname{cos}u\\end{aligned}\n$$\n\nSubstituting $u=2x,$ we obtain the final result:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =2\\operatorname{cos}(2x)\\end{aligned}\n$$" :tutorial/id #uuid "40623a7d-e08a-5ec3-a3d6-1fac6307b20a" :tutorial/math-academy-id 1275 :tutorial/title "Introduction"} :step/id #uuid "2bd9287a-2129-5eca-a08d-0604b85098f4" :step/math-academy-id 2508 :step/next {:db/id #edb/ref 17592186065169}} {:db/id #edb/ref 17592186065169 :step/content {:db/id #edb/ref 17592186064281 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064125 :question/id #uuid "2bb17470-6365-5e08-b649-f9f42146a4c6" :question/math-academy-id "e-732"} :knowledge-point/id #uuid "73216188-6524-55c3-b945-86d13ef64170" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050420} {:db/id #edb/ref 17592186051084}] :knowledge-point/question-generator {:db/id #edb/ref 17592186491440} :knowledge-point/questions [{:db/id #edb/ref 17592186064546} {:db/id #edb/ref 17592186064547} {:db/id #edb/ref 175921