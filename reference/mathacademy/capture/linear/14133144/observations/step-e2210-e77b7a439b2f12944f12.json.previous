0)\" aria-hidden=\"true\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"620\" height=\"60\" x=\"0\" y=\"220\"></rect>\n <use xlink:href=\"#E1-MJMAIN-35\" x=\"60\" y=\"676\"></use>\n <use xlink:href=\"#E1-MJMAIN-36\" x=\"60\" y=\"-687\"></use>\n</g>\n <use xlink:href=\"#E1-MJMAIN-F7\" x=\"1082\" y=\"0\"></use>\n<g transform=\"translate(2083,0)\">\n <use xlink:href=\"#E1-MJMAIN-34\"></use>\n <use xlink:href=\"#E1-MJMAIN-2E\" x=\"500\" y=\"0\"></use>\n</g>\n</g>\n</svg></span></p>\n<p><br></p>\n<div id=\"graphic-59a0c04d06716ee4dd66241ee7baa8dd\" class=\"graphic\"><img src=\"/graphics/59a0c04d06716ee4dd66241ee7baa8dd\"></div>\n                    </div>     \n            \n                    <div class=\"exampleExplanationHeader\">EXPLANATION</div>\n            \n                    <div class=\"exampleExplanation\">\n                        <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                            float: none;\n                            direction: ltr;\n                            max-width: none;\n                            max-height: none;\n                            min-width: 0;\n                            min-height: 0;\n                            border: 0;\n                            padding: 0;\n                            margin: 0\n                            }\n\n                            .mjpage * {\n                            transition: none;\n                            -webkit-transition: none;\n                            -moz-transition: none;\n                            -ms-transition: none;\n                            -o-transition: none\n                            }\n\n                            .mjx-svg-href {\n                            fill: blue;\n                            stroke: blue\n                            }\n\n                            .MathJax_SVG_LineBox {\n                            display: table!important\n                            }\n\n                            .MathJax_SVG_LineBox span {\n                            display: table-cell!important;\n                            width: 10000em!important;\n                            min-width: 0;\n                            max-width: none;\n                            padding: 0;\n                            border: 0;\n                            margin: 0\n                            }\n\n                            .mjpage__block {\n                            text-align: center;\n                            margin: 1em 0em;\n                            position: relative;\n                            display: block!important;\n                            text-indent: 0;\n                            max-width: none;\n                            max-height: none;\n                            min-width: 0;\n                            min-height: 0;\n                            width: 100%\n                            }</style><p>Since we need to divide by <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.162ex\" height=\"2.176ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -791.3 500.5 936.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-1-Title\">\n<title id=\"MathJax-SVG-1-Title\">\\color{blue}4</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E1-MJMAIN-34\" d=\"M462 0Q444 3 333 3Q217 3 199 0H190V46H221Q241 46 248 46T265 48T279 53T286 61Q287 63 287 115V165H28V211L179 442Q332 674 334 675Q336 677 355 677H373L379 671V211H471V165H379V114Q379 73 379 66T385 54Q393 47 442 46H471V0H462ZM293 211V545L74 212L183 211H293Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n <use xlink:href=\"#E1-MJMAIN-34\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span>, we split the whole into <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.162ex\" height=\"2.176ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -791.3 500.5 936.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-2-Title\">\n<title id=\"MathJax-SVG-2-Title\">\\color{blue}4</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E2-MJMAIN-34\" d=\"M462 0Q444 3 333 3Q217 3 199 0H190V46H221Q241 46 248 46T265 48T279 53T286 61Q287 63 287 115V165H28V211L179 442Q332 674 334 675Q336 677 355 677H373L379 671V211H471V165H379V114Q379 73 379 66T385 54Q393 47 442 46H471V0H462ZM293 211V545L74 212L183 211H293Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n <use xlink:href=\"#E2-MJMAIN-34\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span> equal parts horizontally.</p>\n<p><br></p>\n<div id=\"graphic-95cd947116f76b63c65e33ac3a928251\" class=\"graphic\"><img src=\"/graphics/95cd947116f76b63c65e33ac3a928251\"></div>\n\n<p><br></p>\n<p>From the picture on the right, we obtain that the shaded part represents <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"3.161ex\" height=\"5.176ex\" style=\"vertical-align: -1.838ex;\" viewBox=\"0 -1437.2 1361 2228.5\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-3-Title\">\n<title id=\"MathJax-SVG-3-Title\">\\dfrac{5}{24}</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E3-MJMAIN-35\" d=\"M164 157Q164 133 148 117T109 101H102Q148 22 224 22Q294 22 326 82Q345 115 345 210Q345 313 318 349Q292 382 260 382H254Q176 382 136 314Q132 307 129 306T114 304Q97 304 95 310Q93 314 93 485V614Q93 664 98 664Q100 666 102 666Q103 666 123 658T178 642T253 634Q324 634 389 662Q397 666 402 666Q410 666 410 648V635Q328 538 205 538Q174 538 149 544L139 546V374Q158 388 169 396T205 412T256 420Q337 420 393 355T449 201Q449 109 385 44T229 -22Q148 -22 99 32T50 154Q50 178 61 192T84 210T107 214Q132 214 148 197T164 157Z\"></path>\n<path stroke-width=\"1\" id=\"E3-MJMAIN-32\" d=\"M109 429Q82 429 66 447T50 491Q50 562 103 614T235 666Q326 666 387 610T449 465Q449 422 429 383T381 315T301 241Q265 210 201 149L142 93L218 92Q375 92 385 97Q392 99 409 186V189H449V186Q448 183 436 95T421 3V0H50V19V31Q50 38 56 46T86 81Q115 113 136 137Q145 147 170 174T204 211T233 244T261 278T284 308T305 340T320 369T333 401T340 431T343 464Q343 527 309 573T212 619Q179 619 154 602T119 569T109 550Q109 549 114 549Q132 549 151 535T170 489Q170 464 154 447T109 429Z\"></path>\n<path stroke-width=\"1\" id=\"E3-MJMAIN-34\" d=\"M462 0Q444 3 333 3Q217 3 199 0H190V46H221Q241 46 248 46T265 48T279 53T286 61Q287 63 287 115V165H28V211L179 442Q332 674 334 675Q336 677 355 677H373L379 671V211H471V165H379V114Q379 73 379 66T385 54Q393 47 442 46H471V0H462ZM293 211V545L74 212L183 211H293Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"1121\" height=\"60\" x=\"0\" y=\"220\"></rect>\n <use xlink:href=\"#E3-MJMAIN-35\" x=\"310\" y=\"676\"></use>\n<g transform=\"translate(60,-698)\">\n <use xlink:href=\"#E3-MJMAIN-32\"></use>\n <use xlink:href=\"#E3-MJMAIN-34\" x=\"500\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</svg></span> of the whole.</p>\n<p>Therefore,\n<span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"13.295ex\" height=\"5.176ex\" style=\"vertical-align: -1.838ex;\" viewBox=\"0 -1437.2 5724.2 2228.5\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-4-Title\">\n<title id=\"MathJax-SVG-4-Title\">\n\\dfrac{5}{6} \\div 4 = \\dfrac{5}{24} \\, .\n</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E4-MJMAIN-35\" d=\"M164 157Q164 133 148 117T109 101H102Q148 22 224 22Q294 22 326 82Q345 115 345 210Q345 313 318 349Q292 382 260 382H254Q176 382 136 314Q132 307 129 306T114 304Q97 304 95 310Q93 314 93 485V614Q93 664 98 664Q100 666 102 666Q103 666 123 658T178 642T253 634Q324 634 389 662Q397 666 402 666Q410 666 410 648V635Q328 538 205 538Q174 538 149 544L139 546V374Q158 388 169 396T205 412T256 420Q337 420 393 355T449 201Q449 109 385 44T229 -22Q148 -22 99 32T50 154Q50 178 61 192T84 210T107 214Q132 214 148 197T164 157Z\"></path>\n<path stroke-width=\"1\" id=\"E4-MJMAIN-36\" d=\"M42 313Q42 476 123 571T303 666Q372 666 402 630T432 550Q432 525 418 510T379 495Q356 495 341 509T326 548Q326 592 373 601Q351 623 311 626Q240 626 194 566Q147 500 147 364L148 360Q153 366 156 373Q197 433 263 433H267Q313 433 348 414Q372 400 396 374T435 317Q456 268 456 210V192Q456 169 451 149Q440 90 387 34T253 -22Q225 -22 199 -14T143 16T92 75T56 172T42 313ZM257 397Q227 397 205 380T171 335T154 278T148 216Q148 133 160 97T198 39Q222 21 251 21Q302 21 329 59Q342