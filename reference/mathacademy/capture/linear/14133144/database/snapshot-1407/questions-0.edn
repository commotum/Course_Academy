337c3ae88c7d2c3c8f.png)\n\nTherefore, the division problem shown is\n\n$$\n\\frac{2}{4}÷3=\\frac{2}{12}.\n$$"}] [{:db/id #edb/ref 17592186433938 :knowledge-point/_questions [{:db/id #edb/ref 17592186142942 :knowledge-point/id #uuid "489a2e3f-b599-5a48-8957-5f9f452b262e" :knowledge-point/title "Interpreting a Division Model"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "553ddc5d-6720-516e-80dd-ec5e17de7086" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}÷4=\\frac{2}{16}" :db/id #edb/ref 17592186433850} {:answer/id #uuid "7b9c389a-a075-5804-89c1-4868351614ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}÷4=\\frac{1}{8}" :db/id #edb/ref 17592186433865} {:answer/id #uuid "822cefef-a5a8-53bd-a0ef-ad6600d1701b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}÷4=\\frac{4}{16}" :db/id #edb/ref 17592186433869} {:answer/id #uuid "96f4186f-2c0f-592f-ae9a-b235f1e1efcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}÷4=\\frac{3}{4}" :db/id #edb/ref 17592186433877} {:answer/id #uuid "ee6b41bf-e648-5688-ab53-b797f4f69fc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}÷4=\\frac{1}{16}" :db/id #edb/ref 17592186433905}] :answer-field/correct {:answer/id #uuid "ee6b41bf-e648-5688-ab53-b797f4f69fc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}÷4=\\frac{1}{16}" :db/id #edb/ref 17592186433905} :answer-field/id #uuid "5402ff16-0373-5349-8863-8c00aa9fd51d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186433915}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "662c53e3-18d6-5731-9604-9861a090