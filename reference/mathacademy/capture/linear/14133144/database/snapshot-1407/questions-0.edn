difficulty/moderate} :question/id #uuid "4e146227-144b-584c-b9e2-5ebcaa1d7469" :question/math-academy-id "q-100603" :question/problem "![](images/98/984ba6ca16cd8ddf25c1bcc68ec04ec353f691f0b9faac78a7fbccc59bf3d9e5.png)\n\nWhat number is missing from the division problem above?" :question/worked-solution "We have $\\frac{2}{4}$ on the left and $\\frac{2}{20}$ on the right.\n\n![](images/b1/b129b90d78fb67dc217534e10db45b5bccc4bea5094bb9242d14e89528b2c891.png)\n\nThe division operation splits each vertical line into $5$ equal parts. So the shaded parts on the left are $5$ times larger than the shaded parts on the right.  \n\nTherefore, the division problem shown is\n\n$$\n\\frac{2}{4}÷5=\\frac{2}{20}.\n$$\n\nSo, the missing number is $5.$"}] [{:db/id #edb/ref 17592186433939 :knowledge-point/_questions [{:db/id #edb/ref 17592186142945 :knowledge-point/id #uuid "6b44b363-0fb9-59c3-8fb6-8e83f3709f9e" :knowledge-point/title "Dividing a Fraction by a Whole Number Using a Division Model"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f9c877-3cd5-54ff-b304-3d5e30059ffa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{20}" :db/id #edb/ref 17592186433828} {:answer/id #uuid "58e888a1-b6d6-569e-aa2d-f4a6e4fa5c62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{20}" :db/id #edb/ref 17592186433854} {:answer/id #uuid "81c46354-3263-564a-b0e9-6369b61bf031" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186433868} {:answer/id #uuid "b4db9a7a-1f7c-5f71-ab3b-e8f3e5618c49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186433888} {:answer/id #uuid "dd1252b9-adba-5a42-b13c-aedc82858cb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{20}" :db/id #edb/ref 1759218