 17592186142222} {:answer/id #uuid "25faedad-75f4-5b6c-af61-2ae16afbede6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186142223} {:answer/id #uuid "3d8175f4-46d5-5a4f-ace0-b371f5ccecb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186142224} {:answer/id #uuid "66cef24c-fa4a-51e9-83d0-fbab99329af2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186142225} {:answer/id #uuid "6f10fb1d-0bd0-5303-8b0e-18c93ae6efec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186142226}] :answer-field/id #uuid "0a0177f3-2406-5fa8-8bf1-fc9160374224" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186142221}] :question/id #uuid "1f89fb8d-4b5b-5292-a64a-e181392d9a34" :question/math-academy-id "q-61234" :question/problem "![](images/1b/1bdaebd241576e9101a30d6b8882950494220a2f06f9fdbe1e357107fafabe9e.png)\n\nWhat number is missing from the division problem above?"}]}
