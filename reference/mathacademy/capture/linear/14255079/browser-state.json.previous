      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14255079/observations/step-q13041-65195468fa5060193bb0.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14255079/observations/step-q13041-65195468fa5060193bb0.png",
      "source_url": "https://mathacademy.com/tasks/14255079/topics/1659/lesson",
      "captured_at": 1792156404.8955555,
      "math_academy_id": "q-13041",
