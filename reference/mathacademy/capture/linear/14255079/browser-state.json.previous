      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14255079/observations/step-q13036-bb8c4c6d4c763423c24c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14255079/observations/step-q13036-bb8c4c6d4c763423c24c.png",
      "source_url": "https://mathacademy.com/tasks/14255079/topics/1659/lesson",
      "captured_at": 1792156379.7820847,
