{ in}}^{2}" :db/id #edb/ref 17592186552910} {:answer/id #uuid "1cdcbe33-8e94-5992-8450-f26f66113bfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "832{\\text{ in}}^{2}" :db/id #edb/ref 17592186552920} {:answer/id #uuid "4a18eb32-1ca8-5373-9bcb-cf3f0d55898d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,693\\pi {\\text{ in}}^{2}" :db/id #edb/ref 17592186553024} {:answer/id #uuid "8e07b930-8463-5659-906b-a56157d2f4b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,211\\pi {\\text{ in}}^{3}" :db/id #edb/ref 17592186553154} {:answer/id #uuid "cd6696cb-a4b0-587b-87ab-f24acbab5c35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,016\\pi {\\text{ in}}^{2}" :db/id #edb/ref 17592186553279}] :answer-field/correct {:answer/id #uuid "8e07b930-8463-5659-906b-a56157d2f4b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,211\\pi {\\text{ in}}^{3}" :db/id #edb/ref 17592186553154} :answer-field/id #uuid "de9a3def-d070-54d7-bbf2-c59c7db8f8be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553476}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d0d0c8bc-c21f-597b-9878-4cb5aff16c4d" :question/math-academy-id "q-13282" :question/problem "![](images/bc/bc117c302bf4a2963dca000a030d92ae58e6dd13f236826505ca1e732015ba14.png)\n\nCalculate the volume of a cylinder given that its radius is $13\\,\\text{in}$ and its height is $19\\,\\text{in}.$" :question/worked-solution "The volume of a cylinder with radius $r$ and height $h$ is given by\n\n$$\nV=\\pi {r}^{2}h.\n$$\n\nSubstituting $r=13\\,\\text{in}$ and $h=19\\,\\text{in}$ into the formula, we get\n\n$$\nV=\\pi (13)^{2}(19)=3\\,211\\pi {\\text{ in}}^{3}.\n$$"}] [{:db/