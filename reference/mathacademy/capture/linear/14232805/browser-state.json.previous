<mo>=</mo><mi>π</mi><mo stretchy=\"false\">(</mo><mn>5</mn><mi>h</mi><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>⋅</mo><mi>h</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mi>π</mi><mo>⋅</mo><mn>25</mn><msup><mi>h</mi><mn>2</mn></msup><mo>⋅</mo><mi>h</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>25</mn><mi>π</mi><msup><mi>h</mi><mn>3</mn></msup><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
