  "live_records": {
    "q-66390": {
      "dom_id": "step-q66390",
      "name": "Question 1",
      "problem": "What is the value of $15{\\text{i}}^{4}+15{\\text{i}}^{2}?$",
      "worked_solution": "Let's recall the first few powers of $\\text{i},$ where $\\text{i}=\\sqrt{-1}:$\n\n$$\n\\begin{aligned}{\\text{i}}^{0} & =1 \\\\ {\\text{i}}^{1} & =\\text{i} \\\\ {\\text{i}}^{2} & =-1 \\\\ {\\text{i}}^{3} & ={\\text{i}}^{2}\\cdot \\text{i}=(-1)\\cdot \\text{i}=-\\text{i} \\\\ {\\text{i}}^{4} & ={\\text{i}}^{2}\\cdot {\\text{i}}^{2}=(-1)\\cdot (-1)=1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}15{\\text{i}}^{4}+15{\\text{i}}^{2}=15(1)+15(-1)=0.\\end{aligned}\n$$",
      "calculator_instructions": "",
