d #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186514963} {:answer/id #uuid "95fe6bc0-80b2-59ce-8e98-8b6fb022689d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}\\text{i}" :db/id #edb/ref 17592186515189} {:answer/id #uuid "d22f515d-3390-5083-865d-1cfdc6e38f51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186515311} {:answer/id #uuid "dc0f5c3c-5409-5295-8b20-7a4804f5c5b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\text{i}" :db/id #edb/ref 17592186515335}] :answer-field/correct {:answer/id #uuid "dc0f5c3c-5409-5295-8b20-7a4804f5c5b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\text{i}" :db/id #edb/ref 17592186515335} :answer-field/id #uuid "b22a68bf-48b5-5b55-b3d4-8c326751eadf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515481}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fd293abd-5e28-58d2-85df-2177162157d2" :question/math-academy-id "q-66484" :question/problem "$-5{\\text{i}}^{-1}=$" :question/worked-solution "First, using the laws of exponents, we can write\n\n$$\n-5{\\text{i}}^{-1}=-\\frac{5}{\\text{i}}.\n$$\n\nMultiplying the numerator and denominator by $\\text{i},$ we get\n\n$$\n\\begin{aligned}-\\frac{5}{\\text{i}}=-\\frac{5}{\\text{i}}\\cdot \\frac{\\text{i}}{\\text{i}}=-\\frac{5\\text{i}}{{\\text{i}}^{2}}.\\end{aligned}\n$$\n\nWe now recall that ${\\text{i}}^{2}=-1.$ Therefore,\n\n$$\n-\\frac{5\\text{i}}{{\\text{i}}^{2}}=-\\frac{5\\text{i}}{(-1)}=-\\frac{5}{(-1)}\\cdot \\text{i}=5\\text{i}.\n$$"}] [{:db/id #edb/ref 17592186515533 :knowledge-point/_questions [{:db/id #edb/ref 17592186054617 :knowledge-point/id #uuid "aa5128ae-312f-5a12-9a19-9158fa7ddb9a" :knowledge-point/title "Raising i to a Negative Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "227e3695-f1f7-5799-8a85-616d2730eb59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{8}\\text{i}" :db/id #edb/ref 17592186514952} {:answer/id #uuid "39dc5097-774b-5eb9-86c6-bbbc78406ee3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}\\text{i}" :db/id #edb/ref 17592186514998} {:answer/id #uuid "46cb35cd-d4fd-54a6-9bec-45341e758acc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\text{i}" :db/id #edb/ref 17592186515022} {:answer/id #uuid "4962bdcd-8c48-52ef-a215-673b0cd6e85a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186515033} {:answer/id #uuid "e49e1ad2-02e4-5a64-b217-e343adb1441e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\text{i}" :db/id #edb/ref 17592186515349}] :answer-field/correct {:answer/id #uuid "e49e1ad2-02e4-5a64-b217-e343adb1441e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\text{i}" :db/id #edb/ref 17592186515349} :answer-field/id #uuid "b3ebdfd7-1487-5255-822c-f756d3dffe5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515483}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "397ae4dc-5dce-54bd-9646-1b3867960198" :question/math-academy-id "q-66487" :question/problem "$8{\\text{i}}^{-1}=$" :question/worked-solution "First, using the laws of exponents, we can write\n\n$$\n8{\\text{i}}^{-1}=\\frac{8}{\\text{i}}.\n$$\n\nMultiplying the numerator and denominator by $\\text{i},$ we get\n\n$$\n\\begin{aligned}\\frac{8}{\\text{i}}=\\frac{8}{\\text{i}}\\cdot \\frac{\\text{i}}{\\text{i}}=\\frac{8\\text{i}}{{\\text{i}}^{2}}.\\end{aligned}\n$$\n\nWe now recall that ${\\text{i}}^{2}=-1.$ Therefore,\n\n$$\n\\frac{8\\text{i}}{{\\text{i}}^{2}}=\\frac{8\\text{i}}{(-1)}=\\frac{8}{(-1)}\\cdot \\text{i}=-8\\text{i}.\n$$"}] [{:db/id #edb/ref 17592186515577 :knowledge-point/_questions [{:db/id #edb/ref 17592186054615 :knowledge-point/id #uuid "760a1a5b-4c06-547d-9248-a6acb97c4b84" :knowledge-point/title "Raising i to a Positive Integer Power Using the Cyclic Property"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f5a2ed3-aedb-53c8-b6f0-683c2740a1ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186515008} {:answer/id #uuid "8a5b9ccf-c810-596c-a480-905fc8b7511a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186515160} {:answer/id #uuid "cd6d5655-16fd-5320-b556-780a9e47d63a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186515302} {:answer/id #uuid "d50a43db-071f-5dad-b0e5-5a3a9f03f0b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{i}" :db/id #edb/ref 17592186515318} {:answer/id #uuid "decacbed-d2e3-5347-ad87-711506c21f85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\text{i}" :db/id #edb/ref 17592186515339}] :answer-field/correct {:answer/id #uuid "decacbed-d2e3-5347-ad87-711506c21f85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\text{i}" :db/id #edb/ref 17592186515339} :answer-field/id #uuid "449b3727-013d-5c7f-8153-b83812f8679d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515433}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "963c1f30-8cab-5b1e-a22e-507ad07f1c0a" :question/math-academy-id "q-921" :question/problem "What is the value of ${\\text{i}}^{7}?$" :question/worked-solution "To find the value of $\\text{i}$ raised to some positive integer power $n$, we divide $n$ by $4,$ and raise $\\text{i}$ to the remainder.\n\nIn our case, we have $n=7.$ Dividing the power by $4,$ we get\n\n$$\n7÷4=1\\,\\text{R}3.\n$$\n\nSo the remainder is $3.$ Therefore,\n\n$$\n{\\text{i}}^{7}={\\text{i}}^{3}=-\\text{i}.\n$$"}]}
