#{[{:db/id #edb/ref 17592186054525 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054614 :knowledge-point/id #uuid "60e8ad55-058a-5d71-ac05-3f8533f8bd46" :knowledge-point/title "Raising i to a Small Positive Integer Power"}] :question/id #uuid "2777aa24-9055-55d3-9548-3aef0586bea7" :question/math-academy-id "e-3942" :question/problem "What is the value of $4\\textrm{i}^3?$" :question/worked-solution "Let's recall the first few powers of $\\textrm{i},$ where $\\textrm{i} = \\sqrt{-1}\\mathbin{:}$\n\n$$\n\\begin{aligned}{\\text{i}}^{0} & =1 \\\\ {\\text{i}}^{1} & =\\text{i} \\\\ {\\text{i}}^{2} & =-1 \\\\ {\\text{i}}^{3} & ={\\text{i}}^{2}\\cdot \\text{i}=(-1)\\cdot \\text{i}=-\\text{i} \\\\ {\\text{i}}^{4} & ={\\text{i}}^{2}\\cdot {\\text{i}}^{2}=(-1)\\cdot (-1)=1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}4{\\text{i}}^{3} & =4\\cdot (-\\text{i})=-4\\text{i}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054526 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054615 :knowledge-point/id #uuid "760a1a5b-4c06-547d-9248-a6acb97c4b84" :knowledge-point/title "Raising i to a Positive Integer Power Using the Cyclic Property"}] :question/id #uuid "71af77a8-8b16-59f5-b6fb-0c344c3b9f90" :question/math-academy-id "e-3943" :question/problem "Simplify $\\textrm{i}^{15}.$" :question/worked-solution "To find the value of $\\textrm{i}$ to some positive integer power $n$, we divide $n$ by $4$ and raise $\\textrm{i}$ to the remainder.\n\nIn our case, we have $n=15.$ Dividing the power by $4,$ we get\n\n$$\n15\\div 4 = 3\\,\\textrm{R} \\color{blue}{3}.\n$$\n\nSo the remainder is $\\color{blue}3.$ Therefore,\n\n$$\n\\textrm{i}^{15} = \\textrm{i}^{\\color{blue}{3}} = -\\textrm{i}.\n$$"}] [{:db/id #edb/ref 17592186054527 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054616 :knowledge-point/id #uuid "35c51033-ad39-5776-9829-cf573214ef03" :knowledge-point/title "Evaluating an Expression Involving Powers of i Using the Laws of Exponents"}] :question/id #uuid "3bc3d3e9-6745-5021-b571-a301851d7bb9" :question/math-academy-id "e-3944" :question/problem "If $a = \\textrm{i}^9$ and $b = \\textrm{i}^{7},$ then $ab =$" :question/worked-solution "Using the addition law for exponents, we have\n\n$$\nab =\\textrm{i}^9\\cdot\\textrm{i}^7 = \\textrm{i}^{9+7} = \\textrm{i}^{16}.\n$$\n\nTo find the value of $\\textrm{i}$ raised to some positive integer power $n,$ we divide $n$ by $4$ and raise $\\textrm{i}$ to the remainder.\n\nIn our case, we have $n=16.$ Dividing the power by $4,$ we get\n\n$$\n16\\div 4 = 4\\,\\textrm{R} \\color{blue}{0}.\n$$\n\nSo the remainder is $\\color{blue}0.$ Therefore,\n\n$$\n\\textrm{i}^{16} = \\textrm{i}^{\\color{blue}{0}} =1.\n$$"}] [{:db/id #edb/ref 17592186054528 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054617 :knowledge-point/id #uuid "aa5128ae-312f-5a12-9a19-9158fa7ddb9a" :knowledge-point/title "Raising i to a Negative Power"}] :question/id #uuid "a1b59f3b-4378-5b1e-b21e-a865369e6e01" :question/math-academy-id "e-3964" :question/problem "Find the value of $\\textrm{i}^{-2}.$" :question/worked-solution "First, using the laws of exponents, we can write\n\n$$\n\\textrm{i}^{-2}=\\dfrac{1}{\\textrm{i}^2}.\n$$\n\nWe now recall that $\\textrm{i}^2 = -1.$ Therefore,\n\n$$\n\\dfrac{1}{\\textrm{i}^2} = \\dfrac{1}{(-1)} = -1.\n$$"}] [{:db/id #edb/ref 17592186515535 :knowledge-point/_questions [{:db/id #edb/ref 17592186054617 :knowledge-point/id #uuid "aa5128ae-312f-5a12-9a19-9158fa7ddb9a" :knowledge-point/title "Raising i to a Negative Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30a5e83d-857c-5c56-89fe-2c514067a79f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-23\\text{i}" :db/id #edb/ref 17592186514981} {:answer/id #uuid "542c8b6c-14b3-50ce-a50e-cdcc99c9e23e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23\\text{i}" :db/id #edb/ref 17592186515057} {:answer/id #uuid "8e95a151-896e-51ec-998e-4c2100f34265" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186515171} {:answer/id #uuid "b3292bda-9b83-5e17-b5db-c3daf4056235" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186515245} {:answer/id #uuid "c3b1eb34-fe49-528f-962a-0345cb5de9f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\text{i}" :db/id #edb/ref 17592186515287}] :answer-field/correct {:answer/id #uuid "30a5e83d-857c-5c56-89fe-2c514067a79f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-23\\text{i}" :db/id #edb/ref 17592186514981} :answer-field/id #uuid "c889ac42-82ad-583c-ac4c-14efe04c8381" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515492}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "40959c8e-9382-5950-9324-5f121903c27d" :question/math-academy-id "q-113047" :question/problem "$23{\\text{i}}^{-1}=$" :question/worked-solution "First, using the laws of exponents, we can write\n\n$$\n23{\\text{i}}^{-1}=\\frac{23}{\\text{i}}.\n$$\n\nMultiplying the numerator and denominator by $\\text{i},$ we get\n\n$$\n\\begin{aligned}\\frac{23}{\\text{i}}=\\frac{23}{\\text{i}}\\cdot \\frac{\\text{i}}{\\text{i}}=\\frac{23\\text{i}}{{\\text{i}}^{2}}.\\end{aligned}\n$$\n\nWe now recall that ${\\text{i}}^{2}=-1.$ Therefore,\n\n$$\n\\frac{23\\text{i}}{{\\text{i}}^{2}}=\\frac{23\\text{i}}{(-1)}=\\frac{23}{(-1)}\\cdot \\text{i}=-23\\text{i}.\n$$"}] [{:db/id #edb/ref 17592186234139 :knowledge-point/_questions [{:db/id #edb/ref 17592186054614 :knowledge-point/id #uuid "60e8ad55-058a-5d71-ac05-3f8533f8bd46" :knowledge-point/title "Raising i to a Small Positive Integer Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0df1ec4e-edbd-5130-a905-b8d2bac5e501" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\text{i}" :db/id #edb/ref 17592186514901} {:answer/id #uuid "17677d63-450f-5039-a14c-92919267330b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186514923} {:answer/id #uuid "3551830e-e0b3-5f7d-8cfc-ea3d73e6690c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186514990} {:answer/id #uuid "800c984a-ad09-55ac-912f-6daaaa216654" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{i}" :db/id #edb/ref 17592186515134} {:answer/id #uuid "f7cecf35-e8c8-5c54-aa57-75ff3dd26127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186515391}] :answer-field/correct {:answer/id #uuid "3551830e-e0b3-5f7d-8cfc-ea3d73e6690c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186514990} :answer-field/id #uuid "c520f2b6-d9bf-55e5-9288-ea1c659d1fce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515490}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ecda4efc-f543-5a75-8638-7f985bba9d1b" :question/math-academy-id "q-533" :question/problem "What is the value of ${\\text{i}}^{2}?$" :question/worked-solution "Let's recall the first few powers of $\\text{i},$ where $\\text{i}=\\sqrt{-1}:$\n\n$$\n\\begin{aligned}{\\text{i}}^{0} & =1 \\\\ {\\text{i}}^{1} & =\\text{i} \\\\ {\\text{i}}^{2} & =-1 \\\\ {\\text{i}}^{3} & ={\\text{i}}^{2}\\cdot \\text{i}=(-1)\\cdot \\text{i}=-\\text{i} \\\\ {\\text{i}}^{4} & ={\\text{i}}^{2}\\cdot {\\text{i}}^{2}=(-1)\\cdot (-1)=1\\end{aligned}\n$$\n\nTherefore, we have that ${\\text{i}}^{2}=-1.$"}] [{:db/id #edb/ref 17592186515616 :knowledge-point/_questions [{:db/id #edb/ref 17592186054616 :knowledge-point/id #uuid "35c51033-ad39-5776-9829-cf573214ef03" :knowledge-point/title "Evaluating an Expression Involving Powers of i Using the Laws of Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "120a71cf-8528-512a-82ff-1d95f599c730" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186514911} {:answer/id #uuid "217e49f0-4369-59a0-b87d-d301db0750c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186514949} {:answer/id #uuid "54aacff4-92da-52fa-94b2-bd39d9d27a91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{i}" :db/id #edb/ref 17592186515061} {:answer/id #uuid "978dec03-22c3-57eb-93f3-3a45e31ea0ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\text{i}" :db/id #edb/ref 17592186515191} {:answer/id #uuid "f83fc420-b2b0-5955-bd55-fbc821765a7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186515393}] :answer-field/correct {:answer/id #uuid "978dec03-22c3-57eb-93f3-3a45e31ea0ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\text{i}" :db/id #edb/ref 17592186515191} :answer-field/id #uuid "27ba5d5c-b1ef-53f4-96da-21e0a2672d52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515424}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ee98c1bb-35f5-5014-9747-c74bb8f7a21e" :question/math-academy-id "q-535" :question/problem "If $a={\\text{i}}^{5},$ then ${a}^{3}=$" :question/worked-solution "Using the power law for exponents, we have\n\n$$\n{a}^{3}={({\\text{i}}^{5})}^{3}={\\text{i}}^{5\\cdot 3}={\\text{i}}^{15}.\n$$\n\nTo find the value of $\\text{i}$ raised to some positive integer power $n$, we divide $n$ by $4,$ and raise $\\text{i}$ to the remainder.\n\nIn our case, we have $n=15.$ Dividing the power by $4,$ we get\n\n$$\n15÷4=3\\,\\text{R}3.\n$$\n\nSo the remainder is $3.$ Therefore,\n\n$$\n{\\text{i}}^{15}={\\text{i}}^{3}=-\\text{i}.\n$$"}] [{:db/id #edb/ref 17592186515584 :knowledge-point/_questions [{:db/id #edb/ref 17592186054616 :knowledge-point/id #uuid "35c51033-ad39-5776-9829-cf573214ef03" :knowledge-point/title "Evaluating an Expression Involving Powers of i Using the Laws of Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "150744f4-cb82-55ac-ae42-7e7c6a5fee3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186514918} {:answer/id #uuid "17650096-45ec-54b0-9f2b-20816e3ea300" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186514922} {:answer/id #uuid "64bfe8c5-244a-59b9-8372-80e64714778f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\text{i}" :db/id #edb/ref 17592186515088} {:answer/id #uuid "6d3a3235-368d-5426-9683-c85ceff43dff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{i}" :db/id #edb/ref 17592186515099} {:answer/id #uuid "783d135f-bab5-5d5c-a98f-030e5c1d593c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\text{i}" :db/id #edb/ref 17592186515119}] :answer-field/correct {:answer/id #uuid "150744f4-cb82-55ac-ae42-7e7c6a5fee3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186514918} :answer-field/id #uuid "da1fc962-9c05-5d4d-a988-eca539b9fea1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515498}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a99262a6-2443-5dc5-a1ae-4680319ed028" :question/math-academy-id "q-536" :question/problem "Simplify ${({\\text{i}}^{3})}^{10}.$" :question/worked-solution "Using the power law for exponents, we have\n\n$$\n{({\\text{i}}^{3})}^{10}={\\text{i}}^{3\\cdot 10}={\\text{i}}^{30}.\n$$\n\nTo find the value of $\\text{i}$ raised to some positive integer power $n$, we divide $n$ by $4,$ and raise $\\text{i}$ to the remainder.\n\nIn our case, we have $n=30.$ Dividing the power by $4,$ we get\n\n$$\n30÷4=7\\,\\text{R}2.\n$$\n\nSo the remainder is $2.$ Therefore,\n\n$$\n{\\text{i}}^{30}={\\text{i}}^{2}=-1.\n$$"}] [{:db/id #edb/ref 17592186515613 :knowledge-point/_questions [{:db/id #edb/ref 17592186054615 :knowledge-point/id #uuid "760a1a5b-4c06-547d-9248-a6acb97c4b84" :knowledge-point/title "Raising i to a Positive Integer Power Using the Cyclic Property"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25cf66c5-e27f-5642-9233-7fc96d6bfc68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186514959} {:answer/id #uuid "30fe0027-51f9-5cd3-ab41-0608ddbddefb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186514982} {:answer/id #uuid "5447ea87-e11a-50f7-a3b8-9b12ed5741c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186515058} {:answer/id #uuid "bc81ac12-213b-58c2-a6a0-0def39e97f6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{i}" :db/id #edb/ref 17592186515273} {:answer/id #uuid "fb124c64-8723-57a9-8478-8dc10bb975e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\text{i}" :db/id #edb/ref 17592186515398}] :answer-field/correct {:answer/id #uuid "fb124c64-8723-57a9-8478-8dc10bb975e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\text{i}" :db/id #edb/ref 17592186515398} :answer-field/id #uuid "2efa9861-bd6e-570a-8910-36882db4e19c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515426}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e97c4d66-5268-5c26-8025-6f1540da8cb0" :question/math-academy-id "q-554" :question/problem "Simplify ${\\text{i}}^{27}.$" :question/worked-solution "To find the value of $\\text{i}$ raised to some positive integer power $n$, we divide $n$ by $4,$ and raise $\\text{i}$ to the remainder.\n\nIn our case, we have $n=27.$ Dividing the power by $4,$ we get\n\n$$\n27÷4=6\\,\\text{R}3.\n$$\n\nSo the remainder is $3.$ Therefore,\n\n$$\n{\\text{i}}^{27}={\\text{i}}^{3}=-\\text{i}.\n$$"}] [{:db/id #edb/ref 17592186515562 :knowledge-point/_questions [{:db/id #edb/ref 17592186054614 :knowledge-point/id #uuid "60e8ad55-058a-5d71-ac05-3f8533f8bd46" :knowledge-point/title "Raising i to a Small Positive Integer Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05e86823-606d-52b9-b22c-08dc8213a50f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186514886} {:answer/id #uuid "26d08161-81ec-5c98-aa09-3753da662eb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186514961} {:answer/id #uuid "35695b19-9dc0-5ad2-b6d8-e4361c0009b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15-15\\text{i}" :db/id #edb/ref 17592186514991} {:answer/id #uuid "b9ec1402-18e1-5807-b8e4-f930d98509cb" :answer/type {:db/id #edb/ref 175921