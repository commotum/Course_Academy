#{[{:db/id #edb/ref 17592186115088 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115259 :knowledge-point/id #uuid "372e7248-7fe0-5138-896d-61b4866f83cd" :knowledge-point/title "Plotting a Horizontal Translation of a Given Graph"}] :question/id #uuid "e320a97a-d524-5225-895e-76034e599fa9" :question/math-academy-id "e-4973" :question/problem "Plot the graph $y=f(x+2)$ for $y=f(x)$ given below.\n\n![](images/6c/6ca96bba855899f9b87ae06c166503c9af739fcd6bb2ec466a73b75cc70dde7f.png)" :question/worked-solution "The graph of\n\n$$\ny=f(x+2)\n$$\n\nis a horizontal translation of the graph of $y=f(x)$ by $2$ units to the *left*. So, every point on the graph of\n\n$$\ny=f(x+2)\n$$\n\nis two units *to the left* of the corresponding point on the graph of $y=f(x)$.\n\n![](images/75/758899a1abd5298429059016a4127db61eda014e8c46e0539e9226c5641e5ceb.png)"}] [{:db/id #edb/ref 17592186115089 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115260 :knowledge-point/id #uuid "919da198-25e0-5b6f-8d99-79f1508759b9" :knowledge-point/title "Finding a Corresponding Point on a Horizontally Translated Function"}] :question/id #uuid "4dec57af-1c02-56fe-b38e-e62795fdc93d" :question/math-academy-id "e-4974" :question/problem "The point $P$ with coordinates $(-2,0)$ lies on the curve $y=f(x)$. Find a point that must lie on $y=f(x-7)$." :question/worked-solution "The graph of $y=f(x-7)$ is a translation of the graph of $y=f(x)$ by $7$ units to the *right*. So the $y$-coordinate remains unchanged while the $x$-coordinate increases by $7$.\n\nWe know that the point $(-2,0)$ lies on $y=f(x)$. Therefore, the point\n\n$$\n(-2+7,0) = (5,0)\n$$\n\nmust lie on $y=f(x-7)$."}] [{:db/id #edb/ref 17592186115090 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115261 :knowledge-point/id #uuid "d7c84dd5-2c76-5584-81a1-53d2459afb94" :knowledge-point/title "Plotting Horizontal and Vertical Translations of a Given Graph"}] :question/id #uuid "86b96055-a0e1-5dc7-9f89-364f77412a77" :question/math-academy-id "e-4975" :question/problem "Plot the graph of $y=f(x+1)-2$ for $y=f(x)$ given below.\n\n![](images/38/3814318e7d04bf8457c0e5a9a5d563412bb6a988eda83fca84b8400ffea2a117.png)" :question/worked-solution "To graph\n\n$$\ny=f(x+1)-2\n$$\n\nwe translate the graph of $y=f(x)$ by $1$ unit to the left and then $2$ units down.\n\n![](images/17/1744139728266d53c546e0b98452e042b8d099cebed12f5ee0a7c230257e9fa2.png)"}] [{:db/id #edb/ref 17592186115103 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115274 :knowledge-point/id #uuid "57ef1e2c-07d4-5d04-9de8-8884cae17c00" :knowledge-point/title "Finding a Corresponding Point on a Horizontally and Vertically Translated Function"}] :question/id #uuid "740d5deb-3982-5293-9071-ddaaa189fb81" :question/math-academy-id "e-5229" :question/problem "The point $P$ with coordinates $(1, 0)$ lies on the curve $y = f(x)$. What point must lie on $y=f(x + 1)+5$?" :question/worked-solution "The graph of\n\n$$\ny=f(x+1)+5\n$$\n\nis a translation of the graph of $y=f(x)$ by $1$ unit to the *left* and $5$ units up. So the $y$-coordinate increases by $5$ and the $x$-coordinate decreases by $1$.\n\nWe know that the point $P(1,0)$ lies on $y=f(x)$. Therefore, the point\n\n$$\n(1-1,0+5) = (0,5)\n$$\n\nmust lie on\n\n$$\ny=f(x+1)+5\n$$"}] [{:db/id #edb/ref 17592186115506 :knowledge-point/_questions [{:db/id #edb/ref 17592186115259 :knowledge-point/id #uuid "372e7248-7fe0-5138-896d-61b4866f83cd" :knowledge-point/title "Plotting a Horizontal Translation of a Given Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8544974e-1e1c-528b-873a-9b8d6660d38a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/83/8364f7af258a0a222cb5819744b2d38ca56b0b0c019ac24185235788561654c6.png" :db/id #edb/ref 17592186112046} {:answer/id #uuid "a5d631a8-c95f-569e-b99d-96cb66981b89" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/val