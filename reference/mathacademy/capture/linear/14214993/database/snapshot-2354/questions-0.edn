#{[{:db/id #edb/ref 17592186115088 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115259 :knowledge-point/id #uuid "372e7248-7fe0-5138-896d-61b4866f83cd" :knowledge-point/title "Plotting a Horizontal Translation of a Given Graph"}] :question/id #uuid "e320a97a-d524-5225-895e-76034e599fa9" :question/math-academy-id "e-4973" :question/problem "Plot the graph $y=f(x+2)$ for $y=f(x)$ given below.\n\n![](images/6c/6ca96bba855899f9b87ae06c166503c9af739fcd6bb2ec466a73b75cc70dde7f.png)" :question/worked-solution "The graph of $y=f(x+2)$ is a horizontal translation of the graph of $y=f(x)$ by $2$ units to the *left*. So, every point on the graph of $y=f(x+2)$ is two units *to the left* of the corresponding point on the graph of $y=f(x).$\n\n![](images/75/758899a1abd5298429059016a4127db61eda014e8c46e0539e9226c5641e5ceb.png)"}] [{:db/id #edb/ref 17592186115089 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115260 :knowledge-point/id #uuid "919da198-25e0-5b6f-8d99-79f1508759b9" :knowledge-point/title "Finding a Corresponding Point on a Horizontally Translated Function"}] :question/id #uuid "4dec57af-1c02-56fe-b38e-e62795fdc93d" :question/math-academy-id "e-4974" :question/problem "The point $P$ with coordinates $(-2,0)$ lies on the curve $y=f(x)$. Find a point that must lie on $y=f(x-7).$" :question/worked-solution "The graph of $y=f(x-7)$ is a translation of the graph of $y=f(x)$ by $7$ units to the *right*. So the $y$-coordinate remains unchanged while the $x$-coordinate increases by $7.$\n\nWe know that the point $(-2,0)$ lies on $y=f(x).$ Therefore, the point $(-2+7,0) = (5,0)$ must lie on $y=f(x-7).$"}] [{:db/id #edb/ref 17592186115090 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115261 :knowledge-point/id #uuid "d7c84dd5-2c76-5584-81a1-53d2459afb94" :knowledge-point/title "Plotting Horizontal and Vertical Translations of a Given Graph"}] :question/id #uuid "86b96055-a0e1-5dc7-9f89-364f77412a77" :question/math-academy-id "e-4975" :question/problem "Plot the graph of $y=f(x+1)-2$ for $y=f(x)$ given below.\n\n![](images/38/3814318e7d04bf8457c0e5a9a5d563412bb6a988eda83fca84b8400ffea2a117.png)" :question/worked-solution "To graph $y=f(x+1)-2,$ we translate the graph of $y=f(x)$ by $1$ unit to the left and then $2$ units down.\n\n![](images/17/1744139728266d53c546e0b98452e042b8d099cebed12f5ee0a7c230257e9fa2.png)"}] [{:db/id #edb/ref 17592186115103 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115274 :knowledge-point/id #uuid "57ef1e2c-07d4-5d04-9de8-8884cae17c00" :knowledge-point/title "Finding a Corresponding Point on a Horizontally and Vertically Translated Function"}] :question/id #uuid "740d5deb-3982-5293-9071-ddaaa189fb81" :question/math-academy-id "e-5229" :question/problem "The point $P$ with coordinates $(1, 0)$ lies on the curve $y = f(x) .$ What point must lie on $y=f(x + 1)+5?$" :question/worked-solution "The graph of $y=f(x+1)+5$  is a translation of the graph of $y=f(x)$ by $1$ unit to the *left* and $5$ units up. So the $y$-coordinate increases by $5$ and the $x$-coordinate decreases by $1.$\n\nWe know that the point $P(1,0)$ lies on $y=f(x).$ Therefore, the point $(1-1,0+5) = (0,5)$ must lie on $y=f(x+1)+5.$"}] [{:db/id #edb/ref 17592186525037 :knowledge-point/_questions [{:db/id #edb/ref 17592186115261 :knowledge-point/id #uuid "d7c84dd5-2c76-5584-81a1-53d2459afb94" :knowledge-point/title "Plotting Horizontal and Vertical Translations of a Given Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20b47aad-7f2a-5a97-9da1-711cbe595051" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=3,\\,b=-2" :db/id #edb/ref 17592186524442} {:answer/id #uuid "4faa0bb8-8326-5058-8667-97b855fd0f03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=2,\\,b=-3" :db/id #edb/ref 17592186524516} {:answer/id #uuid "981db8c4-da69-5c83-845c-0f8f09f2acaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=-2,\\,b=3" :db/id #edb/ref 17592186524625} {:answer/id #uuid "e1ee2e54-ef77-58b9-851d-13d05f34589d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=-3,\\,b=2" :db/id #edb/ref 17592186524776} {:answer/id #uuid "ed238e4d-c38f-5aeb-a9d0-826a5dda4697" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=3,\\,b=2" :db/id #edb/ref 17592186524801}] :answer-field/correct {:answer/id #uuid "ed238e4d-c38f-5aeb-a9d0-826a5dda4697" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=3,\\,b=2" :db/id #edb/ref 17592186524801} :answer-field/id #uuid "662d422b-1530-5ba0-98a4-0880cce3feef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524883}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c3371da1-431a-54c0-b96b-91167f5060d5" :question/math-academy-id "q-110147" :question/problem "![](images/7b/7b89a8737e3fcb062d5cb53a8832bc3d8f30273696b3be0e8c47d25ba158fa60.png)\n\nThe diagram above shows the graphs of $y=f(x)$ and $y=g(x)$, where $g(x)=f(x+a)+b.$ What are the values of $a$ and $b?$" :question/worked-solution "Notice that every point on the graph $y=g(x)$ is three units *to the left* and two units *up* of the corresponding point on the graph of $y=f(x).$ \n\nSo, we conclude that $g(x)=f(x+3)+2,$ and therefore $a=3$ and $b=2.$"}] [{:db/id #edb/ref 17592186524981 :knowledge-point/_questions [{:db/id #edb/ref 17592186115274 :knowledge-point/id #uuid "57ef1e2c-07d4-5d04-9de8-8884cae17c00" :knowledge-point/title "Finding a Corresponding Point on a Horizontally and Vertically Translated Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "253750c5-fb5b-5091-b589-190f83fde901" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,4)" :db/id #edb/ref 17592186524449} {:answer/id #uuid "343a6236-e67e-511d-86a7-fcbebbd3f0c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,7)" :db/id #edb/ref 17592186524477} {:answer/id #uuid "528da259-0eed-5175-be85-38acc3e05272" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,0)" :db/id #edb/ref 17592186524524} {:answer/id #uuid "83f2e323-c3d8-5e6f-a0d0-0868dd0ebd6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,4)" :db/id #edb/ref 17592186524588} {:answer/id #uuid "d3cda7fd-69e3-5b1a-abe8-7a7edabb5729" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,7)" :db/id #edb/ref 17592186524736}] :answer-field/correct {:answer/id #uuid "253750c5-fb5b-5091-b589-190f83fde901" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,4)" :db/id #edb/ref 17592186524449} :answer-field/id #uuid "9776b31f-8640-5e03-aee4-a9445951e6de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524908}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "44298347-9f79-536a-ae21-5b66403bb6c0" :question/math-academy-id "q-110268" :question/problem "The point $P$ with coordinates $(1,2)$ lies on the curve $y=f(x).$ Which of the following points must lie on $y=f(x+5)+2?$" :question/worked-solution "The graph of $y=f(x+5)+2$  is a translation of the graph of $y=f(x)$ by $5$ units to the *left* and $2$ units up. So the $y$-coordinate increases by $2$ and the $x$-coordinate decreases by $5.$\n\nWe know that the point $(1,2)$ lies on $y=f(x).$ Therefore, the point $(1-5,2+2)=(-4,4)$ must lie on $y=f(x+5)+2.$\n\n![](images/00/00557550846a020f437c6187dfe237b4e1cb874eca2bb1cf2bd70416e0e8d97c.png)"}] [{