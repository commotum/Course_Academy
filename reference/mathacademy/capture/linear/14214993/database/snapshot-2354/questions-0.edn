493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186112045}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "288404cd-b53d-5960-beb2-b80beaaa484f" :question/math-academy-id "q-15511" :question/problem "![](images/55/5573133cd1a199d53254947f951999a10731d980faffcf75e25ac6c3e66cd861.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following is the graph of $y=f(x-1)?$" :question/worked-solution "The graph of $y=f(x-1)$ is a horizontal translation of the graph of $y=f(x)$ by $1$ unit to the *right*. So, every point on the graph of $y=f(x-1)$ is one unit *to the right* of the corresponding point on the graph of $y=f(x).$\n\n![](images/96/96e78d86fc113988887c0c35daf2ebf119f2f47be8d82822d439b2f47433c31d.png)"}] [{:db/id #edb/ref 17592186115508 :knowledge-point/_questions [{:db/id #edb/ref 17592186115261 :knowledge-point/id #uuid "d7c84dd5-2c76-5584-81a1-53d2459afb94" :knowledge-point/title "Plotting Horizontal and Vertical Translations of a Given Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d2a3043-aab5-51ab-8906-670761da3dcc" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/70/70333235b0587d6055ed38b0ebc5cbf3d1621196e657e3461f1d9fb14bc89a35.png" :db/id #edb/ref 17592186112058} {:answer/id #uuid "bcaf7fef-e1a9-5f92-8805-44dff0fff56f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ef/efca82053e43552df9cf3233d92368d0db538d20ebfbb39a9c4e7f8d013319b2.png" :db/id #edb/ref 17592186112059} {:answer/id #uuid "2692ad15-4743-5b90-813d-3cf394dbe3f1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/56/56f73c166e5be1be3536d363eaec01acdba4ac4ae5c4027d1a9e8254309fbce0.png" :db/id #edb/ref 17592186112060} {:answer/id #uuid "45b974c5-21c7-583e-9f09-99a5331f688e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2b/2b78032ffd515ab81928a4d639b83783bdea3a8a79eeb7300c6b89a8e9bcb63c.png" :db/id #edb/ref 17592186112061} {:answer/id #uuid "4adf586b-3455-5f58-810d-5d58de6b52e3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5e/5e2bf6ccf5f5725ac82f176300e3c5a2d20cc7270ca33e1f28c9e99c5cad18d2.png" :db/id #edb/ref 17592186112062}] :answer-field/correct {:answer/id #uuid "9d2a3043-aab5-51ab-8906-670761da3dcc" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/70/70333235b0587d6055ed38b0ebc5cbf3d1621196e657e3461f1d9fb14bc89a35.png" :db/id #edb/ref 17592186112058} :answer-field/id #uuid "1d516e47-bec0-5370-89a0-bc3db319f771" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186112057}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1050c6d7-bf6b-5e55-8ad0-841edc477272" :question/math-academy-id "q-15736" :question/problem "![](images/f3/f35440c0132f7e98617f2d700b60563d44b7e9cb3af3850f557d4b169cc08bb7.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following is the graph of $y=f(x-3)+2?$" :question/worked-solution "To graph $y=f(x-3)+2,$ we translate the graph of $y=f(x)$ by $3$ units to the right and then $2$ units up.\n\n![](images/3c/3cdbb6ef28bc47734820fadaef1e65061775b8c96724713f7f8de30e8a5d0d5e.png)"}] [{:db/id #edb/ref 17592186525060 :knowledge-point/_questions [{:db/id #edb/ref 17592186115259 :knowledge-point/id #uuid "372e7248-7fe0-5138-896d-61b4866f83cd" :knowledge-point/title "Plotting a Horizontal Translation of a Given Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04ea9c31-066d-5652-a164-4fc1fda7f5d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186524387} {:answer/id #uuid "767ef9f6-4ec4-5a15-aa5e-723ded6627db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186524572} {:answer/id #uuid "d3bb863f-e804-568f-9536-a01cbc1d024f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186524735} {:answer/id #uuid "d5b7b5b3-7025-5803-b5cd-7ffc7342a5df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186524739} {:answer/id #uuid "dae7ff61-54fc-5b6a-a0ec-a0048b5f802f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186524749}] :answer-field/correct {:answer/id #uuid "d3bb863f-e804-568f-9536-a01cbc1d024f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186524735} :answer-field/id #uuid "5f260f2b-acd0-58c2-b56d-1f9b044c4797" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524877}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f10d9718-f09b-5a57-a9a5-0bd402337019" :question/math-academy-id "q-34672" :question/problem "![](images/b8/b8a944368cb4549780c5868c164a57d55fffff205ef0816b7316cb9fcf5a93dc.png)\n\nGiven the curve $y=f(x)$ and the curve $y=f(x+a)$, which of the following is the value of $a?$" :question/worked-solution "Every point on the graph of $y=f(x+a)$ is $2$ units *to the left* of the corresponding point on the graph of $y=f(x).$ So the graph of $y=f(x+a)$ is a horizontal translation of the graph of $y=f(x)$ by $2$ units to the *left*. \n\nConsequently, $y=f(x+a)=f(x+2)$ and so $a=2.$"}] [{:db/id #edb/ref 17592186524979 :knowledge-point/_questions [{:db/id #edb/ref 17592186115260 :knowledge-point/id #uuid "919da198-25e0-5b6f-8d99-79f1508759b9" :knowledge-point/title "Finding a Corresponding Point on a Horizontally Translated Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d64ca17-c947-58ed-8484-2b4faddc327b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-1)" :db/id #edb/ref 17592186524405} {:answer/id #uuid "3c4095b4-65a1-56f2-ac3d-93ac60413253" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,7)" :db/id #edb/ref 17592186524493} {:answer/id #uuid "42ed0312-6a97-5afe-81c4-371cc07a5a7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,3)" :db/id #edb/ref 17592186524503} {:answer/id #uuid "62243a18-d6eb-5824-aa8f-0549aac6858a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,3)" :db/id #edb/ref 17592186524543} {:answer/id #uuid "c09ee531-8050-5ebc-a580-9f1799c0b3fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,3)" :db/id #edb/ref 17592186524689}] :answer-field/correct {:answer/id #uuid "42ed0312-6a97-5afe-81c4-371cc07a5a7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,3)" :db/id #edb/ref 17592186524503} :answer-field/id #uuid "33d2b5fb-4d11-5cae-853f-e747c0eae138" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524863}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "39cdb9cb-c996-510c-9952-40829263e555" :question/math-academy-id "q-70398" :question/problem "The point $P$ with coordinates $(1,3)$ lies on the curve $y=f(x).$ Which of the following points must lie on $y=f(x+4)?$" :question/worked-solution "The graph of $y=f(x+4)$ is a translation of the graph of $y=f(x)$ by $4$ units to the *left*. So the $y$-coordinate remains unchanged while the $x$-coordinate decreases by $4.$\n\nWe know that the point $(1,3)$ lies on $y=f(x).$ Therefore, the point $(1-4,3)=(-3,3)$ must lie on $y=f(x+4).$\n\n![](images/2a/2a7333b3778aed3b4a9d744c6a100577fdeeafc497ac9d7f33670908163551b2.png)"}] [{:db/id #edb/ref 17592186525020 :knowledge-point/_questions [{:db/id #edb/ref 17592186115260 :knowledge-point/id #uuid "919da198-25e0-5b6f-8d99-79f1508759b9" :knowledge-point/title "Finding a Corresponding Point on a Horizontally Translated Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dcad000-3cc4-5bb3-96d9-ce67b820e4b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-3)" :db/id #edb/ref 17592186524497} {:answer/id #uuid "6cc81242-fc50-5712-ad13-ddb7870716c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,1)" :db/id #edb/ref 17592186524560} {:answer/id #uuid "af3fc2ee-4622-517a-a981-1ef92ebc4f62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,1)" :db/id #edb/ref 17592186524664} {:answer/id #uuid "bc52afa7-72d6-50aa-8279-a45af0dd9f53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,5)" :db/id #edb/ref 17592186524683} {:answer/id #uuid "d35fe771-29a2-5a54-986e-d9947dff2727" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,1)" :db/id #edb/ref 17592186524734}] :answer-field/correct {:answer/id #uuid "6cc81242-fc50-5712-ad13-ddb7870716c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,1)" :db/id #edb/ref 17592186524560} :answer-field/id #uuid "5fcce4a0-897e-5fde-9536-5a4f0e1e870a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524879}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9f46143b-fdb8-50df-bf49-6caa0060fc7f" :question/math-academy-id "q-70399" :question/problem "The point $P$ with coordinates $(1,1)$ lies on the curve $y=f(x).$ Which of the following points must lie on $y=f(x-4)?$" :question/worked-solution "The graph of $y=f(x-4)$ is a translation of the graph of $y=f(x)$ by $4$ units to the *right*. So the $y$-coordinate remains unchanged while the $x$-coordinate increases by $4.$\n\nWe know that the point $(1,1)$ lies on $y=f(x).$ Therefore, the point $(1+4,1)=(5,1)$ must lie on $y=f(x-4).$\n\n![](images/8c/8c736b4ad424cfc7efe3cd7218f873655b5bface8fe4cc670b8185ff1b73f5e5.png)"}] [{:db/id #edb/ref 17592186525008 :knowledge-point/_questions [{:db/id #edb/ref 17592186115274 :knowledge-point/id #uuid "57ef1e2c-07d4-5d04-9de8-8884cae17c00" :knowledge-point/title "Finding a Corresponding Point on a Horizontally and Vertically Translated Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15fa8f48-3b9f-5a19-861a-ca8945c6f29f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-1)" :db/id #edb/ref 17592186524424} {:answer/id #uuid "7d07ecb0-0d8f-5957-8454-8750d51c7413" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186524578} {:answer/id #uuid "91825f07-3800-5d91-9a87-771d92a21e89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,1)" :db/id #edb/ref 17592186524610} {:answer/id #uuid "c2ed0611-cdfb-5d8f-8208-a35a23108ed1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,1)" :db/id #edb/ref 17592186524695} {:answer/id #uuid "c7608469-92f8-5e24-9662-94400215b327" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-1)" :db/id #edb/ref 17592186524703}] :answer-field/correct {:answer/id #uuid "91825f07-3800-5d91-9a87-771d92a21e89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,1)" :db/id #edb/ref 17592186524610} :answer-field/id #uuid "1bdfdaa2-a65e-5470-970a-f7ae1c96194c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524851}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8c7a6d9e-5cbe-57ca-9331-32f4ca36decb" :question/math-academy-id "q-72294" :question/problem "The point $P$ with coordinates $(0,3)$ lies on the curve $y=f(x).$ Which of the following points must lie on $y=f(x-1)-2?$" :question/worked-solution "The graph of $y=f(x-1)-2$ is a translation of the graph of $y=f(x)$ by $1$ unit to the *right* and $2$ units *down*. So the $y$-coordinate decreases by $2$ and the $x$-coordinate increases by $1.$\n\nWe know that the point $(0,3)$ lies on $y=f(x).$ Therefore, the point $(0+1,3-2)=(1,1)$ must lie on $y=f(x-1)-2.$\n\n![](images/64/64d0dc944682b12702eb8a2fa9de0ef3e65cc57ac1cc7a242a09c986ca7f955c.png)"}]}
