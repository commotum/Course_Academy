#{[{:activity/first-step {:db/id #edb/ref 17592186111536} :activity/id #uuid "f15731b1-3f94-5cda-9865-241f1ae29ba5" :activity/scope {:db/id #edb/ref 17592186050886 :topic/id #uuid "6e409d61-3310-5c51-abad-da7413b800ab" :topic/math-academy-id 1499} :activity/steps [{:db/id #edb/ref 17592186111536 :step/content {:db/id #edb/ref 17592186111914 :tutorial/content "A biologist is experimenting with bacteria stored in a Petri dish. She observes that the number of bacteria in the dish *triples* every hour. If there were $100$ bacteria initially, can she determine how many bacteria will be present after $3$ hours?\n\nStarting with $100$ bacteria, she knows that this number *triples* after one hour. Remember that tripling means to multiply by a factor of $3$.\n\nTo get the number of bacteria after one hour, we multiply the initial amount by $3$:\n\n$$\n\\color{blue}{100\\cdot 3}\n$$\n\nAfter another hour ($2$ hours in total), the number above triples again. So to get the total number of bacteria after $2$ hours, we multiply the amount above by $3$:\n\n$$\n({\\color{blue}{100\\cdot 3}})\\cdot 3 = {\\color{red}{100 \\cdot 3^2}}\n$$\n\nAnd after another hour ($3$ hours total), the number above triples once again:\n\n$$\n({\\color{red}{100 \\cdot 3^2}})\\cdot 3 = 100 \\cdot 3^3\n$$\n\nIf we evaluate the above expression, we get\n\n$$\n100 \\cdot 3^3 = 100\\cdot 27 = 2\\,700\n$$\n\nSo after $3$ hours, there will be $2\\,700$ bacteria in the Petri dish.\n\nThis is an example of **exponential growth**. The number of bacteria triples over a time interval of $1$ hour, every hour. The total number of bacteria grows very rapidly, as we can see from the chart below.\n\n![](images/bf/bf039743a936cab0ca74708584fc3670202588d15fc63a4257ad1a737047da2d.png)" :tutorial/id #uuid "60dc9833-8054-5a01-9e29-d592d2e4498a" :tutorial/math-academy-id 8841 :tutorial/title "Introduction"} :step/id #uuid "868a0a9f-3d0c-5548-b4c4-a2688c08805c" :step/math-academy-id 193608 :step/next {:db/id #edb/ref 17592186111537}} {:db/id #edb/ref 17592186111537 :step/content {:db/id #edb/ref 17592186110625 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110331 :question/id #uuid "27d792f0-b574-531e-9907-80891a464ece" :question/math-academy-id "e-14250"} :knowledge-point/id #uuid "affac6f0-da94-5545-a49c-e1e306bcd918" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049714}] :knowledge-point/questions [{:db/id #edb/ref 17592186110943} {:db/id #edb/ref 17592186111060} {:db/id #edb/ref 17592186111207} {:db/id #edb/ref 17592186491120} {:db/id #edb/ref 17592186491213}] :knowledge-point/title "Creating an Exponential Growth Expression"} :step/id #uuid "cc23439c-f454-5e68-a5a0-22cdf9bf2e0f" :step/math-academy-id 193609 :step/next {:db/id #edb/ref 17592186111538}} {:db/id #edb/ref 17592186111538 :step/content {:db/id #edb/ref 17592186110626 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110332 :question/id #uuid "139799dc-8baf-5e41-9241-23e2ede77162" :question/math-academy-id "e-14254"} :knowledge-point/id #uuid "dcd3e634-d64c-57dc-9d4c-8f7f67c731ab" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048502} {:db/id #edb/ref 17592186050415} {:db/id #edb/ref 17592186050436} {:db/id #edb/ref 17592186050625}] :knowledge-point/questions [{:db/id #edb/ref 17592186110944} {:db/id #edb/ref 17592186111203} {:db/id #edb/ref 17592186459303} {:db/id #edb/ref 17592186480651} {:db/id #edb/ref 17592186487334} {:db/id #edb/ref 17592186491116} {:db/id #edb/ref 17592186491157}] :knowledge-point/title "Creating an Exponential Growth Expression Using Percentage Growth"} :step/id #uuid "8da3c630-d870-51f5-bf19-afa5e49a3cbb" :step/math-academy-id 193613}] :activity/title "Creating Exponential Growth Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110858}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186491258} :activity/id #uuid "9e157ec6-4793-57c2-b506-87c05869c40b" :activity/scope {:db/id #edb/ref 17592186050886 :topic/id #uuid "6e409d61-3310-5c51-abad-da7413b800ab" :topic/math-academy-id 1499} :activity/steps [{:db/id #edb/ref 17592186491258 :step/content {:db/id #edb/ref 17592186491120 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6357466a-e4ea-521a-92ec-7b2d42f668c3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$256$" :db/id #edb/ref 17592186490696} {:answer/id #uuid "79610b64-22b4-50f7-b812-ad542343eb6b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$48$" :db/id #edb/ref 17592186490753} {:answer/id #uuid "b52889ab-eb19-53ea-8825-b325ed2ff1b2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$64$" :db/id #edb/ref 17592186490873} {:answer/id #uuid "bf4718b5-f1ce-5b53-ac08-9cc53e69a2e2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$128$" :db/id #edb/ref 17592186490880} {:answer/id #uuid "fec9058d-07b5-5a4c-a11c-9d5c5f724085" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$32$" :db/id #edb/ref 17592186490993}] :answer-field/correct {:db/id #edb/ref 17592186490880} :answer-field/id #uuid "9a82f3a6-3d2a-5198-9362-48c0a5218bec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491059}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "161c04f6-2c29-5d26-a94d-0d2b0dbcd5e9" :question/math-academy-id "q-45460" :question/problem "Max initially had $$2$ in his piggy bank. Then, thanks to a generous relative, the amount of money in Max's piggy bank doubled at the end of every day. How much money will Max have in the piggy bank after $6$ days?" :question/worked-solution "Initially, Max has $$2$ in the piggy bank, and this amount doubles every day.\n\nTherefore, we have:\n\n- After $1$ day, Max has $2\\cdot 2$ dollars.\n\n- After $2$ days, Max will have $2\\cdot (2)^{2}$ dollars.\n\n- After $3$ days, Max will have $2\\cdot (2)^{3}$ dollars.\n\n- $…$\n\n- After $6$ days, Max will have $2\\cdot (2)^{6}$ dollars.\n\nEvaluating the expression for its value after $6$ days, we get:\n\n$$\n2\\cdot (2)^{6}=2\\cdot 64=128\n$$\n\nThus, Max will have $$128$ after $6$ days."} :step/id #uuid "ad8834ac-70e7-53d1-ac18-85aaa9bf4538" :step/next {:db/id #edb/ref 17592186491270}} {:db/id #edb/ref 17592186491268 :step/content {:db/id #edb/ref 17592186491116 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a5b533e-8c41-5f4b-88da-6d0580536264" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\cdot (1.02)^{4}" :db/id #edb/ref 17592186490593} {:answer/id #uuid "6e26456a-7d62-5d69-a9ab-c9620753384a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\cdot 4+1.02" :db/id #edb/ref 17592186490726} {:answer/id #uuid "8318c1b5-f4b9-5a26-bc7b-e3b3ea36e674" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\cdot (0.02)^{4}" :db/id #edb/ref 17592186490775} {:answer/id #uuid "a2d7b21e-90ba-57aa-a18f-97a5226a44e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\cdot 1.02\\cdot 4" :db/id #edb/ref 17592186490845} {:answer/id #uuid "eb5e6209-59c4-551c-bb4d-769a0d3bdb1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\cdot 1.02+4" :db/id #edb/ref 17592186490959}] :answer-field/correct {:db/id #edb/ref 17592186490593} :answer-field/id #uuid "24ff1f28-f0f9-59c5-8c0e-c4a81ff3b536" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491020}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0f56d78a-7130-5489-9a56-5160eb99a2b4" :question/math-academy-id "q-61642" :question/problem "The price of a gallon of gasoline is $$2.$ Some economists estimate that its price will rise by $2%$ weekly. What will be the price of a gallon of gasoline after $4$ weeks?" :question/worked-solution "The price of a gallon of gasoline is $$2$, and this amount will increase by $2%$ each week.\n\n$2%$ as a decimal is $0.02.$ Therefore, an increase of $2%$ corresponds to multiplication by a factor of\n\n$$\n1+0.02=1.02.\n$$\n\nTherefore, we have:\n\n- After $1$ week, the price will be $2\\cdot (1.02)$ dollars.\n\n- After $2$ weeks, the price will be $2\\cdot (1.02)^{2}$ dollars.\n\n- After $3$ weeks, the price will be $2\\cdot (1.02)^{3}$ dollars.\n\n- After $4$ weeks, the price will be $2\\cdot (1.02)^{4}$ dollars."} :step/id #uuid "c957ca72-06bc-5086-986f-9d17f1ee65e2"} {:db/id #edb/ref 17592186491270 :step/content {:db/id #edb/ref 17592186491213 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14b09e89-02e2-512e-b84a-5ca59c815d96" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "101\\,000" :db/id #edb/ref 17592186490553} {:answer/id #uuid "2873b67c-4668-555a-9f4a-0e815ba69aeb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "81\\,000" :db/id #edb/ref 17592186490585} {:answer/id #uuid "2bbed5df-68aa-5615-8e90-9b092ebf1fff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "79\\,000" :db/id #edb/ref 17592186490597} {:answer/id #uuid "9343b46e-26a1-5287-aca1-350548204a75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "91\\,000" :db/id #edb/ref 17592186490811} {:answer/id #uuid "c2707c3c-65fb-5113-972c-7ac861497d86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "27\\,000" :db/id #edb/ref 17592186490884}] :answer-field/correct {:db/id #edb/ref 17592186490585} :answer-field/id #uuid "7d125985-c78a-5a52-909d-a458fb058e31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491054}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f2ca89cb-8c64-51c3-8674-6c2ebe1a78fd" :question/math-academy-id "q-45479" :question/problem "The number of ants in a building triples every month. If there were $3\\,000$ ants initially, how many ants will there be after $3$ months?" :question/worked-solution "Initially, there were $3,000$ ants, and this number triples every month.\n\nTherefore, we have:\n\n- After $1$ month, there will be $3\\,000\\cdot 3$ ants.\n\n- After $2$ months, the will be $3\\,000\\cdot (3)^{2}$ ants.\n\n- After $3$ months, there will be $3\\,000\\cdot (3)^{3}$ ants.\n\nEvaluating the expression for the number of ants after $3$ months, we get:\n\n$$\n3,000\\cdot (3)^{3}=3,000\\cdot 27=81,000\n$$\n\nTherefore, after $3$ months, there will be $81,000$ ants"} :step/id #uuid "df1473f0-6912-5cbe-ab3f-0795d393adae" :step/next {:db/id #edb/ref 17592186491268}}] :activity/title "Creating Exponential Growth Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186490505}]}
