#{[{:db/id #edb/ref 17592186491120 :knowledge-point/_questions [{:db/id #edb/ref 17592186110625 :knowledge-point/id #uuid "affac6f0-da94-5545-a49c-e1e306bcd918" :knowledge-point/title "Creating an Exponential Growth Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6357466a-e4ea-521a-92ec-7b2d42f668c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$256$" :db/id #edb/ref 17592186490696} {:answer/id #uuid "79610b64-22b4-50f7-b812-ad542343eb6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$48$" :db/id #edb/ref 17592186490753} {:answer/id #uuid "b52889ab-eb19-53ea-8825-b325ed2ff1b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$64$" :db/id #edb/ref 17592186490873} {:answer/id #uuid "bf4718b5-f1ce-5b53-ac08-9cc53e69a2e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$128$" :db/id #edb/ref 17592186490880} {:answer/id #uuid "fec9058d-07b5-5a4c-a11c-9d5c5f724085" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$32$" :db/id #edb/ref 17592186490993}] :answer-field/correct {:answer/id #uuid "bf4718b5-f1ce-5b53-ac08-9cc53e69a2e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$128$" :db/id #edb/ref 17592186490880} :answer-field/id #uuid "9a82f3a6-3d2a-5198-9362-48c0a5218bec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491059}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "161c04f6-2c29-5d26-a94d-0d2b0dbcd5e9" :question/math-academy-id "q-45460" :question/problem "Max initially had $$2$ in his piggy bank. Then, thanks to a generous relative, the amount of money in Max's piggy bank doubled at the end of every day. How much money will Max have in the piggy bank after $6$ days?" :question/worked-solution "Initially, Max has $$2$ in the piggy bank, and this amount doubles every day.\n\nTherefore, we have:\n\n- After $1$ day, Max has $2\\cdot 2$ dollars.\n\n- After $2$ days, Max will have $2\\cdot (2)^{2}$ dollars.\n\n- After $3$ days, Max will have $2\\cdot (2)^{3}$ dollars.\n\n- $…$\n\n- After $6$ days, Max will have $2\\cdot (2)^{6}$ dollars.\n\nEvaluating the expression for its value after $6$ days, we get:\n\n$$\n2\\cdot (2)^{6}=2\\cdot 64=128\n$$\n\nThus, Max will have $$128$ after $6$ days."}] [{:db/id #edb/ref 17592186491213 :knowledge-point/_questions [{:db/id #edb/ref 17592186110625 :knowledge-point/id #uuid "affac6f0-da94-5545-a49c-e1e306bcd918" :knowledge-point/title "Creating an Exponential Growth Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14b09e89-02e2-512e-b84a-5ca59c815d96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "101\\,000" :db/id #edb/ref 17592186490553} {:answer/id #uuid "2873b67c-4668-555a-9f4a-0e815ba69aeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81\\,000" :db/id #edb/ref 17592186490585} {:answer/id #uuid "2bbed5df-68aa-5615-8e90-9b092ebf1fff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "79\\,000" :db/id #edb/ref 17592186490597} {:answer/id #uuid "9343b46e-26a1-5287-aca1-350548204a75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "91\\,000" :db/id #edb/ref 17592186490811} {:answer/id #uuid "c2707c3c-65fb-5113-972c-7ac861497d86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27\\,000" :db/id #edb/ref 17592186490884}] :answer-field/correct {:answer/id #uuid "2873b67c-4668-555a-9f4a-0e815ba69aeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81\\,000" :db/id #edb/ref 17592186490585} :answer-field/id #uuid "7d125985-c78a-5a52-909d-a458fb058e31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491054}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f2ca89cb-8c64-51c3-8674-6c2ebe1a78fd" :question/math-academy-id "q-45479" :question/problem "The number of ants in a building triples every month. If there were $3\\,000$ ants initially, how many ants will there be after $3$ months?" :question/worked-solution "Initially, there were $3,000$ ants, and this number triples every month.\n\nTherefore, we have:\n\n- After $1$ month, there will be $3\\,000\\cdot 3$ ants.\n\n- After $2$ months, the will be $3\\,000\\cdot (3)^{2}$ ants.\n\n- After $3$ months, there will be $3\\,000\\cdot (3)^{3}$ ants.\n\nEvaluating the expression for the number of ants after $3$ months, we get:\n\n$$\n3,000\\cdot (3)^{3}=3,000\\cdot 27=81,000\n$$\n\nTherefore, after $3$ months, there will be $81,000$ ants"}] [{:db/id #edb/ref 17592186491116 :knowledge-point/_questions [{:db/id #edb/ref 17592186110626 :knowledge-point/id #uuid "dcd3e634-d64c-57dc-9d4c-8f7f67c731ab" :knowledge-point/title "Creating an Exponential Growth Expression Using Percentage Growth"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a5b533e-8c41-5f4b-88da-6d0580536264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cdot (1.02)^{4}" :db/id #edb/ref 17592186490593} {:answer/id #uuid "6e26456a-7d62-5d69-a9ab-c9620753384a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cdot 4+1.02" :db/id #edb/ref 17592186490726} {:answer/id #uuid "8318c1b5-f4b9-5a26-bc7b-e3b3ea36e674" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cdot (0.02)^{4}" :db/id #edb/ref 17592186490775} {:answer/id #uuid "a2d7b21e-90ba-57aa-a18f-97a5226a44e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cdot 1.02\\cdot 4" :db/id #edb/ref 17592186490845} {:answer/id #uuid "eb5e6209-59c4-551c-bb4d-769a0d3bdb1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cdot 1.02+4" :db/id #edb/ref 17592186490959}] :answer-field/correct {:answer/id #uuid "2a5b533e-8c41-5f4b-88da-6d0580536264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cdot (1.02)^{4}" :db/id #edb/ref 17592186490593} :answer-field/id #uuid "24ff1f28-f0f9-59c5-8c0e-c4a81ff3b536" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491020}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0f56d78a-7130-5489-9a56-5160eb99a2b4" :question/math-academy-id "q-61642" :question/problem "The price of a gallon of gasoline is $$2.$ Some economists estimate that its price will rise by $2%$ weekly. What will be the price of a gallon of gasoline after $4$ weeks?" :question/worked-solution "The price of a gallon of gasoline is $$2$, and this amount will increase by $2%$ each week.\n\n$2%$ as a decimal is $0.02.$ Therefore, an increase of $2%$ corresponds to multiplication by a factor of\n\n$$\n1+0.02=1.02.\n$$\n\nTherefore, we have:\n\n- After $1$ week, the price will be $2\\cdot (1.02)$ dollars.\n\n- After $2$ weeks, the price will be $2\\cdot (1.02)^{2}$ dollars.\n\n- After $3$ weeks, the price will be $2\\cdot (1.02)^{3}$ dollars.\n\n- After $4$ weeks, the price will be $2\\cdot (1.02)^{4}$ dollars."}]}
