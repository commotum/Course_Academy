#{[{:activity/first-step {:db/id #edb/ref 17592186101692} :activity/id #uuid "328a1df9-8161-5a4a-9d4a-f98a221f2e83" :activity/scope {:db/id #edb/ref 17592186050380 :topic/id #uuid "447961c1-111c-53db-a91f-2d16f3c59e56" :topic/math-academy-id 1226} :activity/steps [{:db/id #edb/ref 17592186101692 :step/content {:db/id #edb/ref 17592186102028 :tutorial/content "Some sequences are defined **recursively**, which means that there is a formula to get from one term to the next.\n\nFor example, suppose that we have the following formula:\n\n$$\na_{n+1}=a_n+{\\color{blue}{2}}, \\quad a_1 = {\\color{red}{3}}\n$$\n\nIn this formula,\n\n- the statement $a_{n+1} = a_n + {\\color{blue}{2}}$ means \"to get to the next term, we add ${\\color{blue}{2}}$ to the previous term,\" and\n- the statement $a_1 = {\\color{red}{3}}$ tells us that the first term is ${\\color{red}{3}}$.\n\nSo how do we calculate $a_2$, the next term in the sequence? Easy! We plug $n=1$ into the formula:\n\n$$\n\\begin{aligned}\na_{n + 1} &= a_{n} + 2 \\\\\na_{1 + 1} &= a_{1} + 2 \\\\\na_{2} &= a_{1} + 2 \\\\\na_{2} &= 3 + 2 \\\\\na_{2} &= 5\n\\end{aligned}\n$$\n\nNow that we know $a_2$, we can find $a_3$ by plugging in $n=2$ into the formula:\n\n$$\n\\begin{aligned}\na_{n + 1} &= a_{n} + 2 \\\\\na_{2 + 1} &= a_{2} + 2 \\\\\na_{3} &= a_{2} + 2 \\\\\na_{3} &= 5 + 2 \\\\\na_{3} &= 7\n\\end{aligned}\n$$\n\nWe can keep going by substituting $n=3,4,5$, and so on. The resulting terms of the sequence are as follows:\n$3,\\qquad 5,\\qquad 7,\\qquad 9,\\qquad 11,\\ldots$" :tutorial/id #uuid "5d79688c-a099-5380-9491-ad72de6dacd8" :tutorial/math-academy-id 8904 :tutorial/title "Introduction"} :step/id #uuid "b00c5358-c585-5513-8287-64cb58758618" :step/math-academy-id 166552 :step/next {:db/id #edb/ref 17592186101693}} {:db/id #edb/ref 17592186101693 :step/content {:db/id #edb/ref 17592186100880 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100604 :question/id #uuid "78ec85fc-7ed5-5486-bc84-27751b7f70de" :question/math-academy-id "e-14369"} :knowledge-point/id #uuid "0fbdcd5f-41de-52fa-9652-3084a5edc01f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050652}] :knowledge-point/questions [{:db/id #edb/ref 17592186101314} {:db/id #edb/ref 17592186101485} {:db/id #edb/ref 17592186101531}] :knowledge-point/title "Computing the Second Term of a Sequence"} :step/id #uuid "25962fc2-f3ff-5048-966a-d70dfa605793" :step/math-academy-id 166553 :step/next {:db/id #edb/ref 17592186101694}} {:db/id #edb/ref 17592186101694 :step/content {:db/id #edb/ref 17592186100881 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100605 :question/id #uuid "e39ea126-770e-5556-9b16-6a2563c271d4" :question/math-academy-id "e-14373"} :knowledge-point/id #uuid "a36f5a6d-8206-5d0f-a3b9-e42c179c0452" :knowledge-point/questions [{:db/id #edb/ref 17592186101201} {:db/id #edb/ref 17592186101315} {:db/id #edb/ref 17592186101486}] :knowledge-point/title "Computing the Third Term of a Sequence"} :step/id #uuid "6da96a9a-ef6d-52ab-af31-36879d385e35" :step/math-academy-id 166557 :step/next {:db/id #edb/ref 17592186101695}} {:db/id #edb/ref 17592186101695 :step/content {:db/id #edb/ref 17592186100882 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100606 :question/id #uuid "529c3240-d3a0-5740-a868-dc76f0be5fff" :question/math-academy-id "e-14377"} :knowledge-point/id #uuid "e74655b8-92bc-5142-96b7-408643c8ad39" :knowledge-point/questions [{:db/id #edb/ref 17592186101316} {:db/id #edb/ref 17592186101487}] :knowledge-point/title "Recursive Sequences in Function Notation"} :step/id #uuid "482dc702-ce49-5577-b9c9-967ceb471c2d" :step/math-academy-id 166561 :step/next {:db/id #edb/ref 17592186101696}} {:db/id #edb/ref 17592186101696 :step/content {:db/id #edb/ref 17592186100883 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100607 :question/id #uuid "86382a53-f250-529c-9980-840d7a614e2a" :question/math-academy-id "e-14379"} :knowledge-point/id #uuid "9a1bf68a-bdb3-5e76-a587