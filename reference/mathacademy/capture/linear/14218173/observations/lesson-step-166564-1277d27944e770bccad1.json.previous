y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-2B\" x=\"1762\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-31\" x=\"2763\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-29\" x=\"3263\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-3D\" x=\"3931\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMATHI-66\" x=\"4987\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-28\" x=\"5538\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMATHI-6E\" x=\"5927\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-29\" x=\"6528\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-2B\" x=\"7139\" y=\"0\"></use>\n<g style=\"\" transform=\"translate(8140,0)\">\n<g transform=\"translate(100,0)\">\n<g></g>\n</g>\n<line stroke-linecap=\"square\" stroke=\"black\" stroke-width=\"100\" y1=\"50\" x2=\"50\" x1=\"50\" y2=\"1468\" transform=\"translate(-5,-401)\"></line>\n<line stroke-linecap=\"square\" stroke=\"black\" stroke-width=\"100\" y1=\"50\" x2=\"50\" x1=\"50\" y2=\"1468\" transform=\"translate(1455,-401)\"></line>\n<line stroke-linecap=\"square\" stroke=\"black\" stroke-width=\"100\" y2=\"50\" y1=\"50\" x1=\"50\" x2=\"1500\" transform=\"translate(0,1022)\"></line>\n<line stroke-linecap=\"square\" stroke=\"black\" stroke-width=\"100\" y2=\"50\" y1=\"50\" x1=\"50\" x2=\"1500\" transform=\"translate(0,-406)\"></line>\n</g>\n <use xlink:href=\"#E2-MJMAIN-2C\" x=\"9862\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMATHI-66\" x=\"12307\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-28\" x=\"12858\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-31\" x=\"13247\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-29\" x=\"13748\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-3D\" x=\"14415\" y=\"0\"></use>\n<g style=\"\" transform=\"translate(15471,0)\">\n<g transform=\"translate(100,0)\">\n<g></g>\n</g>\n<line stroke-linecap=\"square\" stroke=\"black\" stroke-width=\"100\" y1=\"50\" x2=\"50\" x1=\"50\" y2=\"1468\" transform=\"translate(-5,-401)\"></line>\n<line stroke-linecap=\"square\" stroke=\"black\" stroke-width=\"100\" y1=\"50\" x2=\"50\" x1=\"50\" y2=\"1468\" transform=\"translate(1455,-401)\"></line>\n<line stroke-linecap=\"square\" stroke=\"black\" stroke-width=\"100\" y2=\"50\" y1=\"50\" x1=\"50\" x2=\"1500\" transform=\"translate(0,1022)\"></line>\n<line stroke-linecap=\"square\" stroke=\"black\" stroke-width=\"100\" y2=\"50\" y1=\"50\" x1=\"50\" x2=\"1500\" transform=\"translate(0,-406)\"></line>\n</g>\n <use xlink:href=\"#E2-MJMAIN-2E\" x=\"17194\" y=\"0\"></use>\n</g>\n</svg></span>\nFrom left to right, what are the missing values?</p>\n\n            </div>     \n\n            <div class=\"explanationHeader\">EXPLANATION</div>\n\n            <div class=\"exampleExplanation\">\n                <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                            float: none;\n                            direction: ltr;\n                            max-width: none;\n                            max-height: none;\n                            min-width: 0;\n                            min-height: 0;\n                            border: 0;\n                            padding: 0;\n                            margin: 0\n                            }\n\n                            .mjpage * {\n                            transition: none;\n                            -webkit-transition: none;\n                            -moz-transition: none;\n                            -ms-transition: none;\n                            -o-transition: none\n                            }\n\n                            .mjx-svg-href {\n                            fill: blue;\n                            stroke: blue\n                            }\n\n                            .MathJax_SVG_LineBox {\n                            display: table!important\n                            }\n\n                            .MathJax_SVG_LineBox span {\n                            display: table-cell!important;\n                            width: 10000em!important;\n                            min-width: 0;\n                            max-width: none;\n                            padding: 0;\n                            border: 0;\n                            margin: 0\n                            }\n\n                            .mjpage__block {\n                            text-align: center;\n                            margin: 1em 0em;\n                            position: relative;\n                            display: block!important;\n                            text-indent: 0;\n                            max-width: none;\n                            max-height: none;\n                            min-width: 0;\n                            min-height: 0;\n                            width: 100%\n                            }</style><p>Notice that the first term of the sequence is <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"9.158ex\" height=\"2.843ex\" style=\"vertical-align: -0.838ex;\" viewBox=\"0 -863.1 3943.1 1223.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-1-Title\">\n<title id=\"MathJax-SVG-1-Title\">f(1) = {\\color{blue}1}.</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E1-MJMATHI-66\" d=\"M118 -162Q120 -162 124 -164T135 -167T147 -168Q160 -168 171 -155T187 -126Q197 -99 221 27T267 267T289 382V385H242Q195 385 192 387Q188 390 188 397L195 425Q197 430 203 430T250 431Q298 431 298 432Q298 434 307 482T319 540Q356 705 465 705Q502 703 526 683T550 630Q550 594 529 578T487 561Q443 561 443 603Q443 622 454 636T478 657L487 662Q471 668 457 668Q445 668 434 658T419 630Q412 601 403 552T387 469T380 433Q380 431 435 431Q480 431 487 430T498 424Q499 420 496 407T491 391Q489 386 482 386T428 385H372L349 263Q301 15 282 -47Q255 -132 212 -173Q175 -205 139 -205Q107 -205 81 -186T55 -132Q55 -95 76 -78T118 -61Q162 -61 162 -103Q162 -122 151 -136T127 -157L118 -162Z\"></path>\n<path stroke-width=\"1\" id=\"E1-MJMAIN-28\" d=\"M94 250Q94 319 104 381T127 488T164 576T202 643T244 695T277 729T302 750H315H319Q333 750 333 741Q333 738 316 720T275 667T226 581T184 443T167 250T184 58T225 -81T274 -167T316 -220T333 -241Q333 -250 318 -250H315H302L274 -226Q180 -141 137 -14T94 250Z\"></path>\n<path stroke-width=\"1\" id=\"E1-MJMAIN-31\" d=\"M213 578L200 573Q186 568 160 563T102 556H83V602H102Q149 604 189 617T245 641T273 663Q275 666 285 666Q294 666 302 660V361L303 61Q310 54 315 52T339 48T401 46H427V0H416Q395 3 257 3Q121 3 100 0H88V46H114Q136 46 152 46T177 47T193 50T201 52T207 57T213 61V578Z\"></path>\n<path stroke-width=\"1\" id=\"E1-MJMAIN-29\" d=\"M60 749L64 750Q69 750 74 750H86L114 726Q208 641 251 514T294 250Q294 182 284 119T261 12T224 -76T186 -143T145 -194T113 -227T90 -246Q87 -249 86 -250H74Q66 -250 63 -250T58 -247T55 -238Q56 -237 66 -225Q221 -64 221 250T66 725Q56 737 55 738Q55 746 60 749Z\"></path>\n<path stroke-width=\"1\" id=\"E1-MJMAIN-3D\" d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\"></path>\n<path stroke-width=\"1\" id=\"E1-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E1-MJMATHI-66\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-28\" x=\"550\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-31\" x=\"940\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-29\" x=\"1440\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-3D\" x=\"2107\" y=\"0\"></use>\n<g transform=\"translate(3164,0)\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n <use xlink:href=\"#E1-MJMAIN-31\"></use>\n</g>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E1-MJMAIN-2E\" x=\"3664\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p>Inspecting the terms of the sequence, we see that we always get the next term by adding <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.809ex\" height=\"2.176ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -791.3 779 936.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-2-Title\">\n<title id=\"MathJax-SVG-2-Title\">{\\color{red}5}.</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E2-MJMAIN-35\" d=\"M164 157Q164 133 148 117T109 101H102Q148 22 224 22Q294 22 326 82Q345 115 345 210Q345 313 318 349Q292 382 260 382H254Q176 382 136 314Q132 307 129 306T114 304Q97 304 95 310Q93 314 93 485V614Q93 664 98 664Q100 666 102 666Q103 666 123 658T178 642T253 634Q324 634 389 662Q397 666 402 666Q410 666 410 648V635Q328 538 205 538Q174 538 149 544L139 546V374Q158 388 169 396T205 412T256 420Q337 420 393 355T449 201Q449 109 385 44T229 -22Q148 -22 99 32T50 154Q50 178 61 192T84 210T107 214Q132 214 148 197T164 157Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n<g fill=\"red\" stroke=\"red\">\n<g fill=\"red\" stroke=\"red\">\n<g fill=\"red\" stroke=\"red\">\n <use xlink:href=\"#E2-MJMAIN-35\"></use>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E2-MJMAIN-2E\" x=\"500\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p>Therefore, the recursive rule must be the following:\n<span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"38.386ex\" height=\"3.843ex\" style=\"vertical-align: -1.171ex;\" viewBox=\"0 -1150.1 16527.3 1654.5\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-3-Title\">\n<title id=\"MathJax-SVG-3-Title\">\nf(n+1) = f(n) + \\bbox[3pt, border: 1pt solid black]{{\\color{red}5}}\\,, \\qquad f(1) = \\bbox[3pt, border: 1pt solid black]{{\\color{blue}1}}\n</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E3-MJMATHI-66\" d=\"M118 -162Q120 -162 124 -164T135 -167T147 -168Q160 -168 171 -155T187 -126Q197 -99 221 27T267 267T289 382V385H242Q195 385 192 387Q188 390 188 397L195 425Q197 430 203 430T250 431Q298 431 298 432Q298 434 307 482T319 540Q356 705 465 705Q502 703 526 683T550 630Q550 594 529 578T487 561Q443 561 443 603Q443 622 454 636T478 657L487 662Q471 668 457 668Q445 668 434 658T419 630Q412 601 403 552T387 469T380 433Q380 431 435 431Q480 431 487 430T498 424Q499 420 496 407T491 391Q489 386 482 386T428 385H372L349 263Q301 15 282 -47Q255 -132 212 -173Q175 -205 139 -205Q107 -205 81 -186T55 -132Q55 -95 76 -78T118 -61Q162 -61 162 -103Q162 -122 151 -136T127 -157L118 -162Z\"></path>\n<path stroke-width=\"1\" id=\"E3-MJMAIN-28\" d=\"M94 250Q94 319 104 381T127 488T164 576T202 643T244 695T277 729T302 750H315H319Q333 750 333 741Q333 738 316 720T275 667T226 581T184 443T167 250T184 58T225 -81T274 -167T316 -220T333 -241Q333 -250 318 -250H315H302L274 -226Q180 -141