0\" transform=\"translate(1205,-423)\"></line>\n<line stroke-linecap=\"square\" stroke=\"black\" stroke-width=\"100\" y2=\"50\" y1=\"50\" x1=\"50\" x2=\"1250\" transform=\"translate(0,972)\"></line>\n<line stroke-linecap=\"square\" stroke=\"black\" stroke-width=\"100\" y2=\"50\" y1=\"50\" x1=\"50\" x2=\"1250\" transform=\"translate(0,-428)\"></line>\n</g>\n <use xlink:href=\"#E3-MJMAIN-2C\" x=\"9612\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMATHI-66\" x=\"12057\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-28\" x=\"12608\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-31\" x=\"12997\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-29\" x=\"13498\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-3D\" x=\"14165\" y=\"0\"></use>\n<g style=\"\" transform=\"translate(15221,0)\">\n<g transform=\"translate(100,0)\">\n<g>\n<g transform=\"translate(300,0)\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n <use xlink:href=\"#E3-MJMAIN-31\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n<line stroke-linecap=\"square\" stroke=\"black\" stroke-width=\"100\" y1=\"50\" x2=\"50\" x1=\"50\" y2=\"1418\" transform=\"translate(-5,-401)\"></line>\n<line stroke-linecap=\"square\" stroke=\"black\" stroke-width=\"100\" y1=\"50\" x2=\"50\" x1=\"50\" y2=\"1418\" transform=\"translate(1205,-401)\"></line>\n<line stroke-linecap=\"square\" stroke=\"black\" stroke-width=\"100\" y2=\"50\" y1=\"50\" x1=\"50\" x2=\"1250\" transform=\"translate(0,972)\"></line>\n<line stroke-linecap=\"square\" stroke=\"black\" stroke-width=\"100\" y2=\"50\" y1=\"50\" x1=\"50\" x2=\"1250\" transform=\"translate(0,-406)\"></line>\n</g>\n</g>\n</svg></span></p>\n<p>So, the missing values are <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.162ex\" height=\"2.176ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -791.3 500.5 936.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-4-Title\">\n<title id=\"MathJax-SVG-4-Title\">5</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E4-MJMAIN-35\" d=\"M164 157Q164 133 148 117T109 101H102Q148 22 224 22Q294 22 326 82Q345 115 345 210Q345 313 318 349Q292 382 260 382H254Q176 382 136 314Q132 307 129 306T114 304Q97 304 95 310Q93 314 93 485V614Q93 664 98 664Q100 666 102 666Q103 666 123 658T178 642T253 634Q324 634 389 662Q397 666 402 666Q410 666 410 648V635Q328 538 205 538Q174 538 149 544L139 546V374Q158 388 169 396T205 412T256 420Q337 420 393 355T449 201Q449 109 385 44T229 -22Q148 -22 99 32T50 154Q50 178 61 192T84 210T107 214Q132 214 148 197T164 157Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E4-MJMAIN-35\" x=\"0\" y=\"0\"></use>\n</g>\n</svg></span> and <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.809ex\" height=\"2.176ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -791.3 779 936.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-5-Title\">\n<title id=\"MathJax-SVG-5-Title\">1.</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E5-MJMAIN-31\" d=\"M213 578L200 573Q186 568 160 563T102 556H83V602H102Q149 604 189 617T245 641T273 663Q275 666 285 666Q294 666 302 660V361L303 61Q310 54 315 52T339 48T401 46H427V0H416Q395 3 257 3Q121 3 100 0H88V46H114Q136 46 152 46T177 47T193 50T201 52T207 57T213 61V578Z\"></path>\n<path stroke-width=\"1\" id=\"E5-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E5-MJMAIN-31\"></use>\n <use xlink:href=\"#E5-MJMAIN-2E\" x=\"500\" y=\"0\"></use>\n</g>\n</svg></span></p>\n\n            </div>           \n        </div>"