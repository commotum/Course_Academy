 Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0884ad38-9d14-5f8e-b665-d8b35b5af237" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+4" :db/id #edb/ref 17592186269346} {:answer/id #uuid "0db0ac08-c4ce-5d3f-845f-d38358413506" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+8" :db/id #edb/ref 17592186269388} {:answer/id #uuid "2934301c-7684-5c1f-b910-d7819431eba3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186269640} {:answer/id #uuid "7789397b-7630-5bd8-9c80-42e72f128cee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e+8" :db/id #edb/ref 17592186270328} {:answer/id #uuid "81639cc6-e903-5cd2-bc14-50bfc72b4d70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e+4" :db/id #edb/ref 17592186270388}] :answer-field/correct {:answer/id #uuid "7789397b-7630-5bd8-9c80-42e72f128cee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e+8" :db/id #edb/ref 17592186270328} :answer-field/id #uuid "c7c2979c-8072-5209-9ca0-20ccbaf77003" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271876}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d2ffa4af-5dbe-569b-8d78-f233584a8913" :question/math-academy-id "q-140431" :question/problem "Given that $f(x)=2{e}^{x}+4{x}^{2}-3$, find the slope of the tangent at $x=1.$" :question/worked-solution "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}+4{x}^{2}-3) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(4{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(-3) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}({e}^{x})+4\\frac{\\text{d}}{\\text{d}x}({x}^{2})+0 \\\\  & =2{e}^{x}+8x.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={(2{e}^{x}+8x)\\,|}_{x=1} \\\\  & =2\\cdot {e}^{1}+8\\cdot 1 \\\\  & =2e+8.\\end{aligned}\n$$"}]}
