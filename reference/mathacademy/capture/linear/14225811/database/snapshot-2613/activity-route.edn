#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186543657} :activity/id #uuid "943d4724-4157-55d1-a2b7-c6967297f552" :activity/scope {:db/id #edb/ref 17592186048749 :topic/id #uuid "bad8d582-b827-501b-8a06-58b93e5ecdb0" :topic/math-academy-id 1114} :activity/steps [{:db/id #edb/ref 17592186543608 :step/content {:db/id #edb/ref 17592186543477 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5669689b-d4c2-598a-9b8e-4640a33a9697" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6\\ln 2" :db/id #edb/ref 17592186542874}] :answer-field/correct {:db/id #edb/ref 17592186542874} :answer-field/id #uuid "4d0c9719-4708-560e-a504-150738be227f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186543338}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0f325821-aed1-5216-b5a3-ffaf528190d5" :question/math-academy-id "q-340284" :question/problem "Given that $f(x)=\\operatorname{ln}⁡(5)-3\\cdot {2}^{x}$, the slope of the tangent at $x=1$ is{{field-1}}." :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(5)-3\\cdot {2}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(5))-\\frac{\\text{d}}{\\text{d}x}(3\\cdot {2}^{x}) \\\\  & =0-3\\frac{\\text{d}}{\\text{d}x}({2}^{x}) \\\\  & =-3\\operatorname{ln}⁡(2)\\cdot {2}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={(-3\\operatorname{ln}⁡(2)\\cdot {2}^{x})|}_{x=1} \\\\  & =-3\\operatorname{ln}⁡(2)\\cdot {2}^{1} \\\\  & =-3\\operatorname{ln}⁡(2)\\cdot 2 \\\\  & =-6\\operatorname{ln}⁡(2).\\end{aligned}\n$$"} :step/id #uuid "1be5bca1-959e-5dc6-afbd-3797a27d03d0" :step/next {:db/id #edb/ref 17592186543656}} {:db/id #edb/ref 17592186543656 :step/content {:db/id #edb/ref 17592186543507 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3481b85e-58eb-5313-8a75-21e00c14674a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\ln 7" :db/id #edb/ref 17592186542780}] :answer-field/correct {:db/id #edb/ref 17592186542780} :answer-field/id #uuid "5f82e929-b888-5d34-a5dc-e42fb4ed9aff" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186543349}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5e010595-5a96-5d35-8548-77ec2815a5a0" :question/math-academy-id "q-340285" :question/problem "Given that $f(x)=5\\cdot {7}^{x}$, the slope of the tangent at $x=0$ is{{field-1}}." :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(5\\cdot {7}^{x}) \\\\  & =5\\frac{\\text{d}}{\\text{d}x}({7}^{x}) \\\\  & =5\\operatorname{ln}⁡(7)\\cdot {7}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(5\\operatorname{ln}⁡(7)\\cdot {7}^{x})|}_{x=0} \\\\  & =5\\operatorname{ln}⁡(7)\\cdot {7}^{0} \\\\  & =5\\operatorname{ln}⁡(7)\\cdot 1 \\\\  & =5\\operatorname{ln}⁡(7).\\end{aligned}\n$$"} :step/id #uuid "af2c57ec-5158-512f-86f1-2fb4d3101440"} {:db/id #edb/ref 17592186543657 :step/content {:db/id #edb/ref 17592186096989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c78d12d-e0a1-56ab-9f9b-0b5ab3109e1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{′}(x)=5{e}^{x}+4{x}^{2}-3" :db/id #edb/ref 17592186542713} {:answer/id #uuid "207cc40d-fc6f-5da2-b43d-321cce4f0d3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{′}(x)={e}^{x}+4x" :db/id #edb/ref 17592186542728} {:answer/id #uuid "92c2fe7a-f2f7-5b68-8d4d-cf6414096282" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{′}(x)=5{e}^{x}+4x" :db/id #edb/ref 17592186543024} {:answer/id #uuid "9caf9432-187f-5eb0-a837-cd39bf99957b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{′}(x)=5{e}^{x}+4x-3" :db/id #edb/ref 17592186543051} {:answer/id #uuid "c2b5f78e-5928-5e0b-9292-bc6f68419181" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{f}^{′}(x)=5{e}^{x}+4{x}^{2}" :db/id #edb/ref 17592186543149}] :answer-field/correct {:db/id #edb/ref 17592186543024} :answer-field/id #uuid "7eaf35cc-b950-5185-a9a1-b26eb9ffff7a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186093908}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "be52e61b-18d3-573c-9b27-5eaa6fa86e49" :question/math-academy-id "q-11728" :question/problem "Given that $f(x)=5{e}^{x}+2{x}^{2}-3$, find ${f}^{′}(x).$" :question/worked-solution "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(5{e}^{x}+2{x}^{2}-3) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(5{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(2{x}^{2})-\\frac{\\text{d}}{\\text{d}x}(3) \\\\  & =5\\frac{\\text{d}}{\\text{d}x}({e}^{x})+2\\frac{\\text{d}}{\\text{d}x}({x}^{2})-0 \\\\  & =5{e}^{x}+2(2x)-0 \\\\  & =5{e}^{x}+4x.\\end{aligned}\n$$"} :step/id #uuid "b6c1d9da-40dd-56ff-9485-773b66c48f3c" :step/next {:db/id #edb/ref 17592186543676}} {:db/id #edb/ref 17592186543663 :step/content {:db/id #edb/ref 17592186543497 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8301abdf-6346-54fc-a966-bee78fbb19e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\ln 4-2e" :db/id #edb/ref 17592186542988}] :answer-field/correct {:db/id #edb/ref 17592186542988} :answer-field/id #uuid "b41aee66-8662-5e0a-8dc7-1405a17238b0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186543424}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "47d673bd-5b90-569f-9bcd-5db84649c548" :question/math-academy-id "q-340277" :question/problem "Given that $f(x)=3\\cdot {4}^{x}-2{e}^{x}$, the slope of the tangent at $x=1$ is{{field-1}}." :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {4}^{x}-2{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {4}^{x})-\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}({4}^{x})-2\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =3\\operatorname{ln}⁡(4)\\cdot {4}^{x}-2{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={(3\\operatorname{ln}⁡(4)\\cdot {4}^{x}-2{e}^{x})|}_{x=1} \\\\  & =3\\operatorname{ln}⁡(4)\\cdot {4}^{1}-2{e}^{1} \\\\  & =12\\operatorname{ln}⁡(4)-2e.\\end{aligned}\n$$"} :step/id #uuid "c9a5a8b7-be4a-5735-b51b-59b6b55d6cc5" :step/next {:db/id #edb/ref 17592186543608}} {:db/id #edb/ref 17592186543676 :step/content {:db/id #edb/ref 17592186272085 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0884ad38-9d14-5f8e-b665-d8b35b5af237" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e+4" :db/id #edb/ref 17592186269346} {:answer/id #uuid "0db0ac08-c4ce-5d3f-845f-d38358413506" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e+8" :db/id #edb/ref 17592186269388} {:answer/id #uuid "2934301c-7684-5c1f-b910-d7819431eba3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2e" :db/id #edb/ref 17592186269640} {:answer/id #uuid "7789397b-7630-5bd8-9c80-42e72f128cee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2e+8" :db/id #edb/ref 17592186270328} {:answer/id #uuid "81639cc6-e903-5cd2-bc14-50bfc72b4d70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2e+4" :db/id #edb/ref 17592186270388}] :answer-field/correct {:db/id #edb/ref 17592186270328} :answer-field/id #uuid "c7c2979c-8072-5209-9ca0-20ccbaf77003" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186271876}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d2ffa4af-5dbe-569b-8d78-f233584a8913" :question/math-academy-id "q-140431" :question/problem "Given that $f(x)=2{e}^{x}+4{x}^{2}-3$, find the slope of the tangent at $x=1.$" :question/worked-solution "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}+4{x}^{2}-3) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(4{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(-3) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}({e}^{x})+4\\frac{\\text{d}}{\\text{d}x}({x}^{2})+0 \\\\  & =2{e}^{x}+8x.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={(2{e}^{x}+8x)\\,|}_{x=1} \\\\  & =2\\cdot {e}^{1}+8\\cdot 1 \\\\  & =2e+8.\\end{aligned}\n$$"} :step/id #uuid "fbee3716-0f60-561c-b60e-4bde22d77367" :step/next {:db/id #edb/ref 17592186543663}}] :activity/title "Differentiating Exponential Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186542624}]}
