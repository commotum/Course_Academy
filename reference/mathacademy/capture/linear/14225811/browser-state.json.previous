/mo></mrow><mo data-mjx-texclass=\"CLOSE\">|</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mo>=</mo><mn>1</mn></mrow></msub></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mo>−</mo><mn>3</mn><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mo>⋅</mo><msup><mn>2</mn><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow></msup></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mo>−</mo><mn>3</mn><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mo>⋅</mo><mn>2</mn></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mo>−</mo><mn>6</mn><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mn>2</mn><mo stretchy=\"false\">)</mo></mpadded></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
