n><msup><mi>x</mi><mn>2</mn></msup><mo stretchy=\"false\">)</mo><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mtext>d</mtext><mrow><mtext>d</mtext><mi>x</mi></mrow></mfrac></mstyle><mo stretchy=\"false\">(</mo><mn>3</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>5</mn><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mtext>d</mtext><mrow><mtext>d</mtext><mi>x</mi></mrow></mfrac></mstyle><mo stretchy=\"false\">(</mo><msup><mi>e</mi><mi>x</mi></msup><mo stretchy=\"false\">)</mo><mo>+</mo><mn>2</mn><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mtext>d</mtext><mrow><mtext>d</mtext><mi>x</mi></mrow></mfrac></mstyle><mo stretchy=\"false\">(</mo><msup><mi>x</mi><mn>2</mn></msup><mo stretchy=\"false\">)</mo><mo>−</mo><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>5</mn><msup><mi>e</mi><mi>x</mi></msup><mo>+</mo><mn>2</mn><mo stretchy=\"false\">(</mo><mn>2</mn><mi>x</mi><mo stretchy=\"false\">)</mo><mo>−</mo><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>5</mn><msup><mi>e</mi><mi>x</mi></msup><mo>+</mo><mn>4</mn><mi>x</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
