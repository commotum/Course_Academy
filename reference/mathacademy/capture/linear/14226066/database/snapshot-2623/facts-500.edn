-98cd-00aabe81a7d0" #edb/ref 17592186045417] [17592186544753 #edb/ref 1075 #edb/ref 17592186544104 #edb/ref 17592186045417] [17592186544753 #edb/ref 1075 #edb/ref 17592186544186 #edb/ref 17592186045417] [17592186544753 #edb/ref 1075 #edb/ref 17592186544300 #edb/ref 17592186045417] [17592186544753 #edb/ref 1075 #edb/ref 17592186544432 #edb/ref 17592186045417] [17592186544753 #edb/ref 1075 #edb/ref 17592186544641 #edb/ref 17592186045417] [17592186544753 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186544753 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186544753 #edb/ref 1078 #edb/ref 17592186544186 #edb/ref 17592186045417] [17592186544753 #edb/ref 1079 #uuid "d3f3064e-eb4a-5d50-aa76-43139622458b" #edb/ref 17592186045417] [17592186544759 #edb/ref 1075 #edb/ref 17592186544120 #edb/ref 17592186045417] [17592186544759 #edb/ref 1075 #edb/ref 17592186544224 #edb/ref 17592186045417] [17592186544759 #edb/ref 1075 #edb/ref 17592186544455 #edb/ref 17592186045417] [17592186544759 #edb/ref 1075 #edb/ref 17592186544461 #edb/ref 17592186045417] [17592186544759 #edb/ref 1075 #edb/ref 17592186544568 #edb/ref 17592186045417] [17592186544759 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186544759 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186544759 #edb/ref 1078 #edb/ref 17592186544224 #edb/ref 17592186045417] [17592186544759 #edb/ref 1079 #uuid "dd16cf0e-5f7d-51cc-ae14-ca512e5da309" #edb/ref 17592186045417] [17592186544760 #edb/ref 1075 #edb/ref 17592186544204 #edb/ref 17592186045417] [17592186544760 #edb/ref 1075 #edb/ref 17592186544218 #edb/ref 17592186045417] [17592186544760 #edb/ref 1075 #edb/ref 17592186544352 #edb/ref 17592186045417] [17592186544760 #edb/ref 1075 #edb/ref 17592186544406 #edb/ref 17592186045417] [17592186544760 #edb/ref 1075 #edb/ref 17592186544557 #edb/ref 17592186045417] [17592186544760 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186544760 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186544760 #edb/ref 1078 #edb/ref 17592186544204 #edb/ref 17592186045417] [17592186544760 #edb/ref 1079 #uuid "de4038dd-4a4f-5744-b3e0-9f127c2fa707" #edb/ref 17592186045417] [17592186544769 #edb/ref 1075 #edb/ref 17592186544141 #edb/ref 17592186045417] [17592186544769 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186544769 #edb/ref 1077 "field-3" #edb/ref 17592186045417] [17592186544769 #edb/ref 1078 #edb/ref 17592186544141 #edb/ref 17592186045417] [17592186544769 #edb/ref 1079 #uuid "ed63e6cb-39c3-5d3f-a8c6-4ef7473abfa3" #edb/ref 17592186045417] [17592186544801 #edb/ref 1068 #edb/ref 17592186544673 #edb/ref 17592186045417] [17592186544801 #edb/ref 1069 "q-73781" #edb/ref 17592186045417] [17592186544801 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186544801 #edb/ref 1071 "Which of the following values of $w$ satisfy the inequality $\\frac{w}{4}<5\\,?$\n\nI. $w=24$\n\nII. $w=20$\n\nIII. $w=8$" #edb/ref 17592186045417] [17592186544801 #edb/ref 1072 #uuid "3861e4f2-43a8-5a8e-aa2e-58c7272cde17" #edb/ref 17592186045417] [17592186544801 #edb/ref 1074 "We substitute each value into the given inequality and check to see if the resulting statement is true or false.\n\n- We substitute the value $w=24$ into the given inequality. We get:\n\n$$\n\\begin{aligned}\\frac{w}{4} & <5 \\\\ \\frac{24}{4} & <5 \\\\ 6 & <5\\,\\times \\end{aligned}\n$$\n\nSo, substituting $w=24$ into the inequality leads to a **false** statement. \n\nTherefore, $w=24$ **does not satisfy** this inequality.\n\n- We substitute the value $w=20$ into the given inequality. We get:\n\n$$\n\\begin{aligned}\\frac{w}{4} & <5 \\\\ \\frac{20}{4} & <5 \\\\ 5 & <5\\,\\times \\end{aligned}\n$$\n\nSo, substituting $w=20$ into the inequality leads to a **false** statement. \n\nTherefore, $w=20$ **does not satisfy** this inequality.\n\n- We substitute the value $w=8$ into the given inequality. We get:\n\n$$\n\\begin{aligned}\\frac{w}{4} & <5 \\\\ \\frac{8}{4} & <5 \\\\ 2 & <5\\,✓\\end{aligned}\n$$\n\nSo, substituting $w=8$ into the inequality leads to a **true** statement. \n\nTherefore, $w=8$ **satisfies** this inequality." #edb/ref 17592186045417] [17592186544809 #edb/ref 1068 #edb/ref 17592186544731 #edb/ref 17592186045417] [17592186544809 #edb/ref 1069 "q-52181" #edb/ref 17592186045417] [17592186544809 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186544809 #edb/ref 1071 "$-{z}^{3}(4{z}^{2}-2z)=$" #edb/ref 17592186045417] [17592186544809 #edb/ref 1072 #uuid "3eaa9b96-57f5-5bea-bcf0-0afa03bea744" #edb/ref 17592186045417] [17592186544809 #edb/ref 1074 "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}-{z}^{3}(4{z}^{2}-2z) & = \\\\ (-{z}^{3})(4{z}^{2})+(-{z}^{3})(-2z) & = \\\\ ((-1)\\cdot 4)({z}^{3}\\cdot {z}^{2})+((-1)\\cdot (-2))({z}^{3}\\cdot z) & = \\\\ (-4){z}^{3+2}+(2){z}^{3+1} & = \\\\ -4{z}^{5}+2{z}^{4}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186544826 #edb/ref 1068 #edb/ref 17592186544691 #edb/ref 17592186045417] [17592186544826 #edb/ref 1069 "q-74708" #edb/ref 17592186045417] [17592186544826 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186544826 #edb/ref 1071 "Evaluate $f(-2,1)$ if $f(x,y)=3x+y-1.$" #edb/ref 17592186045417] [17592186544826 #edb/ref 1072 #uuid "6705c0b1-618f-5fe7-bac1-95db3808efcf" #edb/ref 17592186045417] [17592186544826 #edb/ref 1074 "We substitute $x=-2$ and $y=1$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x,y) & =3x+y-1 \\\\ f(-2,1) & =3(-2)+(1)-1 \\\\  & =-6+1-1 \\\\  & =-6\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186544833 #edb/ref 1068 #edb/ref 17592186544717 #edb/ref 17592186045417] [17592186544833 #edb/ref 1069 "q-177595" #edb/ref 17592186045417] [17592186544833 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186544833 #edb/ref 1071 "If $-3=\\frac{a}{9},$ then $a=${{field-1}}." #edb/ref 17592186045417] [17592186544833 #edb/ref 1072 #uuid "7841e502-bd87-5f16-9f68-b66396ece51e" #edb/ref 17592186045417] [17592186544833 #edb/ref 1074 "First, let's swap the left and right-hand sides so that the variable is on the left-hand side.\n\n$$\n\\frac{a}{9}=-3\n$$\n\nIn this equation, $a$ is being divided by $9.$ To isolate $a$, we can perform the opposite operation, which is *multiplying* by $9.$ So, we multiply both sides of the equation by $9$ and simplify.\n\n$$\n\\begin{aligned}\\frac{a}{9} & =-3 \\\\ 9\\cdot \\frac{a}{9} & =9\\cdot (-3) \\\\ \\frac{9a}{9} & =-27 \\\\ \\frac{\\cancel{9}a}{\\cancel{9}} & =-27 \\\\ a & =-27\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186544852 #edb/ref 1068 #edb/ref 17592186544759 #edb/ref 17592186045417] [17592186544852 #edb/ref 1069 "q-86657" #edb/ref 17592186045417] [17592186544852 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186544852 #edb/ref 1071 "Given that $\\sqrt[5]{{x}^{3}}={x}^{n},$ what is $n?$" #edb/ref 17592186045417] [17592186544852 #edb/ref 1072 #uuid "99da1bf2-2ba4-5686-8f97-30d5bccdda0f" #edb/ref 17592186045417] [17592186544852 #edb/ref 1074 "First, we convert the radical to a fractional exponent, and then we apply the power rule:\n\n$$\n\\begin{aligned}\\sqrt[5]{{x}^{3}} & = \\\\ {({x}^{3})}^{1/5} & = \\\\ {x}^{3\\cdot (1/5)} & = \\\\ {x}^{3/5}\\end{aligned}\n$$\n\n \n\nTherefore, $n=\\frac{3}{5}.$" #edb/ref 17592186045417] [17592186544857 #edb/ref 1068 #edb/ref 17592186544702 #edb/ref 17592186045417] [17592186544857 #edb/ref 1069 "q-100726" #edb/ref 17592186045417] [17592186544857 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186544857 #edb/ref 1071 "$(14÷9)^{4}=$" #edb/ref 17592186045417] [17592186544857 #edb/ref 1072 #uuid "9d8ff61d-9e20-514e-9557-6082e8e48970" #edb/ref 17592186045417] [17592186544857 #edb/ref 1074 "To raise the quotient of two numbers to the power of $4$, we must raise each number to the power of $4,$ and then divide:\n\n$$\n(14÷9)^{4}={14}^{4}÷{9}^{4}\n$$" #edb/ref 17592186045417] [17592186544865 #edb/ref 1068 #edb/ref 17592186544736 #edb/ref 17592186045417] [17592186544865 #edb/ref 1069 "q-93129" #edb/ref 17592186045417] [17592186544865 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186544865 #edb/ref 1071 "$40$ students took an algebra exam. If $12$ of them failed this exam, what percentage of students failed it?" #edb/ref 17592186045417] [17592186544865 #edb/ref 1072 #uuid "ae08ca9c-939c-5021-b3a5-7c6bc6fdc648" #edb/ref 17592186045417] [17592186544865 #edb/ref 1074 "We're given a part and a whole, and we must find a percentage. So, we can use the following formula:\n\n$$\n\\text{percentage}=\\text{part}÷\\text{whole}\n$$\n\nIn this case, \n\n- the part is the number of students that failed the exam, which is $12,$ and\n\n- the whole is the total number of students, which is $40.$\n\nSubstituting our numbers into the above formula, we get\n\n$$\n\\text{percentage}=12÷40=\\frac{12}{40}.\n$$\n\nWe can simplify this fraction as follows:\n\n$$\n\\frac{12}{40}=\\frac{12÷4}{40÷4}=\\frac{3}{10}\n$$\n\nTo write this as a percentage, we create an equivalent fraction with $100$ as the denominator:\n\n$$\n\\frac{3}{10}=\\frac{3\\times 10}{10\\times 10}=\\frac{30}{100}\n$$\n\nNow we can write this fraction as a percentage:\n\n$$\n\\frac{30}{100}=30%\n$$\n\nTherefore, $30%$ of the students failed the exam." #edb/ref 17592186045417] [17592186544866 #edb/ref 1068 #edb/ref 17592186544753 #edb/ref 17592186045417] [17592186544866 #edb/ref 1069 "q-99627" #edb/ref 17592186045417] [17592186544866 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186544866 #edb/ref 1071 "$\\frac{63}{4\\sqrt{7}}=$" #edb/ref 17592186045417] [17592186544866 #edb/ref 1072 #uuid "af48560b-05fb-5bc9-95de-b8bf00a67a5f" #edb/ref 17592186045417] [17592186544866 #edb/ref 1074 "To remove the radical $\\sqrt{7}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{7}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{63}{4\\sqrt{7}} & = \\\\ \\frac{63}{4\\sqrt{7}}\\cdot \\frac{\\sqrt{7}}{\\sqrt{7}} & = \\\\ \\frac{63\\sqrt{7}}{4\\cdot (\\sqrt{7})^{2}} & = \\\\ \\frac{63\\sqrt{7}}{4\\cdot 7} & = \\\\ \\frac{9\\sqrt{7}}{4} & \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186544873 #edb/ref 1068 #edb/ref 17592186544684 #edb/ref 17592186045417] [17592186544873 #edb/ref 1068 #edb/ref 17592186544706 #edb/ref 17592186045417] [17592186544873 #edb/ref 1069 "q-175481" #edb/ref 17592186045417] [17592186544873 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186544873 #edb/ref 1071 "$\\frac{1}{3}(9x+12y)=${{field-1}}\n$x\\,+$\n{{field-2}}\n$y$" #edb/ref 17592186045417] [17592186544873 #edb/ref 1072 #uuid "bdb96e93-5d4a-5d24-ab91-43e3876a1cf8" #edb/ref 17592186045417] [17592186544873 #edb/ref 1074 "Applying the distributive law and simplifying, we have:\n\n$$\n\\begin{aligned}\\frac{1}{3}(9x+12y) & = \\\\ \\frac{1}{3}\\cdot 9x+\\frac{1}{3}\\cdot 12y & = \\\\ \\frac{9x}{3}+\\frac{12y}{3} & = \\\\ 3\\,x+4\\,y & \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186544874 #edb/ref 1068 #edb/ref 17592186544690 #edb/ref 17592186045417] [17592186544874 #edb/ref 1069 "q-59913" #edb/ref 17592186045417] [17592186544874 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186544874 #edb/ref 1071 "| $5$ | $10$ |\n| --- | --- |\n| $?$ | $30$ |\n| $25$ | $50$ |\n\n$$\n\n$$\n\nWhat number is missing from the ratio table?" #edb/ref 17592186045417] [17592186544874 #edb/ref 1072 #uuid "c2d93ca7-606b-5dec-9244-b98215ef5117" #edb/ref 17592186045417] [17592186544874 #edb/ref 1074 "We start with the ratio $5:10$ and write it as a fraction:\n\n$$\n\\frac{5}{10}\n$$\n\nSo the numerator represents the left-hand entry ($5$), and the denominator represents the right-hand entry ($10$).\n\nWe can make a denominator of $30$ by multiplying the numerator and denominator by $3$:\n\n$$\n\\begin{aligned}\\frac{5\\times 3}{10\\times 3} & =\\frac{15}{30}\\end{aligned}\n$$\n\nWe add this to our ratio table:\n\n| $5$ | $10$ |\n| --- | --- |\n| $15$ | $30$ |\n| $25$ | $50$ |\n\n$$\n\n$$\n\nSo, the missing number is $15.$" #edb/ref 17592186045417] [17592186544886 #edb/ref 1068 #edb/ref 17592186544672 #edb/ref 17592186045417] [17592186544886 #edb/ref 1069 "q-129415" #edb/ref 17592186045417] [17592186544886 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186544886 #edb/ref 1071 "$\\sqrt{64{p}^{2}}=$" #edb/ref 17592186045417] [17592186544886 #edb/ref 1072 #uuid "e0efe9ed-909f-5452-9389-702e59cbbd2e" #edb/ref 17592186045417] [17592186544886 #edb/ref 1074 "Remember that the square root of a perfect square can be simplified using absolute value.\n\n$$\n\\sqrt{{x}^{2}}=|x|\n$$\n\nAlso, we notice that $64$ and ${p}^{2}$ are both perfect squares.\n\nFirst, we write the expression under the square root as a perfect square:\n\n$$\n\\begin{aligned}\\sqrt{64{p}^{2}} & =\\sqrt{{8}^{2}\\cdot {p}^{2}} \\\\  & =\\sqrt{8\\cdot 8\\cdot p\\cdot p} \\\\  & =\\sqrt{8\\cdot p\\cdot 8\\cdot p} \\\\  & =\\sqrt{8p\\cdot 8p} \\\\  & =\\sqrt{(8p)^{2}}\\end{aligned}\n$$\n\nThen, we take the absolute value of the squared quantity and simplify using the rules of absolute value:\n\n$$\n\\begin{aligned}\\sqrt{(8p)^{2}} & =|8p| \\\\  & =|8|\\cdot |p| \\\\  & =8|p|\\end{aligned}\n$$" #edb/ref 17592186045417]}
