g the Power Rule with Fractional Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "114b0dfa-89bf-5311-81ef-fcc7328f4d93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186544120} {:answer/id #uuid "3d2d9d98-d016-50d1-ade9-88cfcb3d34b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186544224} {:answer/id #uuid "ac3b342a-b178-519b-87a5-bbfeeed0b751" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186544455} {:answer/id #uuid "b116a718-63f8-5776-b375-ffe686801428" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186544461} {:answer/id #uuid "de25f1f1-df80-5532-ac59-dc389d2badfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186544568}] :answer-field/correct {:answer/id #uuid "3d2d9d98-d016-50d1-ade9-88cfcb3d34b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186544224} :answer-field/id #uuid "dd16cf0e-5f7d-51cc-ae14-ca512e5da309" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186544759}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "99da1bf2-2ba4-5686-8f97-30d5bccdda0f" :question/math-academy-id "q-86657" :question/problem "Given that $\\sqrt[5]{{x}^{3}}={x}^{n},$ what is $n?$" :question/worked-solution "First, we convert the radical to a fractional exponent, and then we apply the power rule:\n\n$$\n\\begin{aligned}\\sqrt[5]{{x}^{3}} & = \\\\ {({x}^{3})}^{1/5} & = \\\\ {x}^{3\\cdot (1/5)} & = \\\\ {x}^{3/5}\\end{aligned}\n$$\n\n \n\nTherefore, $n=\\frac{3}{5}.$"}] [{:db/id #edb/ref 17592186544865 :knowledge-point/_questions [{:db/id #edb/ref 17592186179820 :knowledge-point/id #uuid "6f67408f-f019-5365-b4a0-6f60ac23cc1d" :knowledge-point/title "Finding a Missing Percent Given Two Numbers Using Simplification"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03a9e932-b2d8-57e4-8e26-371499db4a87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40%" :db/id #edb/ref 17592186544094} {:answer/id #uuid "37af64e4-e53f-5906-9205-2976cf8eff34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30%" :db/id #edb/ref 17592186544209} {:answer/id #uuid "51036995-cbd5-5e9c-b7fc-99756d59a10b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35%" :db/id #edb/ref 17592186544263} {:answer/id #uuid "b358ad10-6ca2-50e7-b950-ca22dadd8d53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20%" :db/id #edb/ref 17592186544466} {:answer/id #uuid "f71d24b6-3be6-532f-aae7-679ccc049399" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25%" :db/id #edb/ref 17592186544628}] :answer-field/correct {:answer/id #uuid "37af64e4-e53f-5906-9205-2976cf8eff34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30%" :db/id #edb/ref 17592186544209} :answer-field/id #uuid "b3071424-443b-5ed8-bef9-8dd32743f887" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186544736}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ae08ca9c-939c-5021-b3a5-7c6bc6fdc648" :question/math-academy-id "q-93129" :question/problem "$40$ students took an algebra exam. If $12$ of them failed this exam, what percentage of students failed it?" :question/worked-solution "We're given a part and a whole, and we must find a percentage. So, we can use the following formula:\n\n$$\n\\text{percentage}=\\text{part}÷\\text{whole}\n$$\n\nIn this case, \n\n- the part is the number of students that failed the exam, which is $12,$ and\n\n- the whole is the total number of students, which is $40.$\n\nSubstituting our numbers into the above formula, we get\n\n$$\n\\text{percentage}=12÷40=\\frac{12}{40}.\n$$\n\nWe can simplify this fraction as follows:\n\n$$\n\\frac{12}{40}=\\frac{12÷4}{40÷4}=\\frac{3}{10}\n$$\n\nTo write this as a percentage, we create an equivalent fraction with $100$ as the denominator:\n\n$$\n\\frac{3}{10}=\\frac{3\\times 10}{10\\times 10}=\\frac{30}{100}\n$$\n\nNow we can write this fraction as a percentage:\n\n$$\n\\frac{30}{100}=30%\n$$\n\nTherefore, $30%$ of the students failed the exam."}] [{:db/id #edb/ref 17592186544866 :knowledge-point/_questions [{:db/id #edb/ref 17592186105705 :knowledge-point/id #uuid "2d0b2497-9533-5fa9-9895-8a02a2b68c86" :knowledge-point/title "Rationalizing a Denominator When Simplification Is Needed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "075367fe-cef1-561e-ad91-ec32ec907f37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{9}" :db/id #edb/ref 17592186544104} {:answer/id #uuid "2c78cadf-d441-59dd-9a48-0819bcfd8b94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9\\sqrt{7}}{4}" :db/id #edb/ref 17592186544186} {:answer/id #uuid "62aab15a-523b-57ab-b3b2-b44eb5a260b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9\\sqrt{4}}{7}" :db/id #edb/ref 17592186544300} {:answer/id #uuid "9f9633f7-e053-503e-9b57-d699b632a649" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{7}}{9}" :db/id #edb/ref 17592186544432} {:answer/id #uuid "fd410286-c33b-54a1-9423-e773de555f9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{4}" :db/id #edb/ref 17592186544641}] :answer-field/correct {:answer/id #uuid "2c78cadf-d441-59dd-9a48-0819bcfd8b94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9\\sqrt{7}}{4}" :db/id #edb/ref 17592186544186} :answer-field/id #uuid "d3f3064e-eb4a-5d50-aa76-43139622458b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186544753}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af48560b-05fb-5bc9-95de-b8bf00a67a5f" :question/math-academy-id "q-99627" :question/problem "$\\frac{63}{4\\sqrt{7}}=$" :question/worked-solution "To remove the radical $\\sqrt{7}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{7}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{63}{4\\sqrt{7}} & = \\\\ \\frac{63}{4\\sqrt{7}}\\cdot \\frac{\\sqrt{7}}{\\sqrt{7}} & = \\\\ \\frac{63\\sqrt{7}}{4\\cdot (\\sqrt{7})^{2}} & = \\\\ \\frac{63\\sqrt{7}}{4\\cdot 7} & = \\\\ \\frac{9\\sqrt{7}}{4} & \\end{aligned}\n$$"}]}
