nowledge-point/questions [{:db/id #edb/ref 17592186069063} {:db/id #edb/ref 17592186069075} {:db/id #edb/ref 17592186480681} {:db/id #edb/ref 17592186480706}] :knowledge-point/title "Simplifying Rational Expressions With Common Constant Factors"} :step/id #uuid "65cce613-c74c-5057-9966-c834e52edbdf" :step/math-academy-id 4905 :step/next {:db/id #edb/ref 17592186069731}}] :activity/title "Simplifying Rational Expressions by Factoring" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068956}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186502165} :activity/id #uuid "ccf00ea8-24df-5710-b43a-322d9402d168" :activity/scope {:db/id #edb/ref 17592186049181 :topic/id #uuid "e176f8f6-a3bc-5ea6-89d2-2202d9d89fd7" :topic/math-academy-id 423} :activity/steps [{:db/id #edb/ref 17592186502165 :step/content {:db/id #edb/ref 17592186069048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8de4a17a-b413-5d45-8140-74a4ed852096" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7x" :db/id #edb/ref 17592186065722} {:answer/id #uuid "2812d53d-b145-5315-be1a-cfe001d69566" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186065724} {:answer/id #uuid "4756fea0-2e4c-525d-8bdd-27b135309d47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186065726} {:answer/id #uuid "2181c5f8-b9fc-5a90-b0ca-d4fcb9f73264" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7x+1}{7x}" :db/id #edb/ref 17592186501522} {:answer/id #uuid "d24eea38-ad0b-5c27-9ca0-b6fa84d4d26b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7x+1" :db/id #edb/ref 17592186501881}] :answer-field/correct {:db/id #edb/ref 17592186501522} :answer-field/id #uuid "1bc06e8b-9454-5e2b-82fd-21d690bf6ad3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186065721}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1c66045b-0cd9-5504-b541-34258606f987" :question/math-academy-id "q-140" :question/problem "$\\frac{7x+1}{7x}=$" :question/worked-solution "The numerator and denominator have no common factors, so the expression can not be reduced. The expression \n\n$$\n\\frac{7x+1}{7x}\n$$\n\n is already in lowest terms."} :step/id #uuid "06ab3711-3d4c-5c2c-8653-bca368f0f08b" :step/next {:db/id #edb/ref 17592186502172}} {:db/id #edb/ref 17592186502172 :step/content {:db/id #edb/ref 17592186502073 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3886ddee-8772-528b-bf4d-8bf02e891107" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{5(2g+6)^{2}}" :db/id #edb/ref 17592186501568} {:answer/id #uuid "5450829c-b0a3-5655-bd1c-5951e0c37b62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2g+6" :db/id #edb/ref 17592186501622} {:answer/id #uuid "87a0ab98-9dd0-5490-bcc8-385d1c51bb82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186501726} {:answer/id #uuid "afcad7b6-af4e-59d6-82fd-8b0d5cf543c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5(2g+6)^{2}}{4}" :db/id #edb/ref 17592186501815} {:answer/id #uuid "fcd329fc-b34a-5fbb-bd9a-1392f560a2ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186501970}] :answer-field/correct {:db/id #edb/ref 17592186501726} :answer-field/id #uuid "f3dfd035-8faf-5e9c-8f1e-539bc75374da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502058}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0dc91759-1708-5aa4-a78f-8164b2208179" :question/math-academy-id "q-51526" :question/problem "What is $\\frac{10g+30}{8g+24}$ reduced to its lowest terms?" :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\\frac{10g+30}{8g+24} & =\\frac{5(2g+6)}{4(2g+6)} \\\\  & =\\frac{5\\cancel{(2g+6)}}{4\\cancel{(2g+6)}} \\\\  & =\\frac{5}{4}\\end{aligned}\n$$"} :step/id #uuid "244bf9be-1869-5c01-9bef-c171796be681" :step/next {:db/id #edb/ref 17592186502193}} {:db/id #edb/ref 17592186502193 :step/content {:db/id #edb/ref 17592186502106 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05f4f1f7-644a-5080-b0cf-201bf0a40bc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{x-3}" :db/id #edb/ref 17592186501480} {:answer/id #uuid "070118e9-d838-5a52-8939-3d392169bc42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186501482} {:answer/id #uuid "ac77b55f-c27a-5257-a8fa-649823e99715" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186501809} {:answer/id #uuid "cbc47ca7-0390-52f9-aa36-ff5d3975d9c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186501871} {:answer/id #uuid "daa76a02-84a6-5425-b200-2e9ee6c38aef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3-x}" :db/id #edb/ref 17592186501904}] :answer-field/correct {:db/id #edb/ref 17592186501871} :answer-field/id #uuid "6d7f57eb-669c-54ed-8aa2-d787aac81274" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502013}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "624c7b11-aded-592e-be21-f98c6f89890c" :question/math-academy-id "q-52367" :question/problem "Which of the following is equivalent to $\\frac{2x-6}{3-x}?$" :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\\frac{2x-6}{3-x} & =\\frac{2(x-3)}{-(x-3)} \\\\  & =\\frac{2\\cdot (x-3)}{(-1)\\cdot (x-3)} \\\\  & =\\frac{2\\cdot \\cancel{(x-3)}}{(-1)\\cdot \\cancel{(x-3)}} \\\\  & =\\frac{2}{(-1)} \\\\  & =-2\\end{aligned}\n$$"} :step/id #uuid "906a3f57-f0f9-58fa-b96b-4062bc57287a"}] :activity/title "Simplifying Rational Expressions by Factoring" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186501460}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186065239} :activity/id #uuid "c9abc5e8-7b1c-5f9f-b127-db76daab3fd6" :activity/scope {:db/id #edb/ref 17592186049843 :topic/id #uuid "18188755-d27b-5ea0-8e93-047aeb60e2d7" :topic/math-academy-id 376} :activity/steps [{:db/id #edb/ref 17592186065166 :step/content {:db/id #edb/ref 17592186064279 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064122 :question/id #uuid "d71c8752-131c-5c82-b642-dee1d03484f4" :question/math-academy-id "e-6737"} :knowledge-point/id #uuid "3bb1eda0-9577-59e7-9c6c-b85966fbb7e4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048159} {:db/id #edb/ref 17592186050358}] :knowledge-point/questions [{:db/id #edb/ref 17592186064495} {:db/id #edb/ref 17592186064700} {:db/id #edb/ref 17592186481671} {:db/id #edb/ref 17592186544886}] :knowledge-point/title "Expressing the Square Root of a Perfect Square Using Absolute Value"} :step/id #uuid "90ca222a-d123-5386-9588-6d8292b8a140" :step/math-academy-id 24828 :step/next {:db/id #edb/ref 17592186065201}} {:db/id #edb/ref 17592186065201 :step/content {:db/id #edb/ref 17592186064305 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064141 :question/id #uuid "6bf774f8-aaa7-5a8e-9fb5-1ed1356b87ae" :question/math-academy-id "e-9639"} :knowledge-point/id #uuid "4a48a060-871e-5c31-b1c0-7c4ed10eb259" :knowledge-point/questions [{:db/id #edb/ref 17592186064496} {:db/id #edb/ref 17592186064704} {:db/id #edb/ref 17592186481666} {:db/id #edb/ref 17592186481673} {:db/id #edb/ref 17592186489184} {:db/id #edb/ref 17592186489234} {:db/id #edb/ref 17592186489289}] :knowledge-point/title "Simplifying the Square Root of a Perfect Square With Multiple Variables"} :step/id #uuid "741a6139-aa26-54b7-8036-ade246aa12a8" :step/math-academy-id 36121 :step/next {:db/id #edb/ref 17592186065240}} {:db/id #edb/ref 17592186065239 :step/content {:db/id #edb/ref 17592186065343 :tutorial/content "When simplifying an algebraic expression involving square roots, it's useful to remember that\n\n$$\n\\sqrt{x^2} = |x|.\n$$\n\nIt's tempting to think that $\\sqrt{x^2}$ is equivalent to $x,$ but that's not true because $\\sqrt{x^2}$ is always non-negative, even if $x$ is negative.\n\nTo illustrate, let's evaluate $\\sqrt{x^2}$ for a couple of different values of $x\\mathbin{:}$\n\n$$\n\\begin{aligned}\\sqrt{{4}^{2}} & =\\sqrt{16}=4 \\\\ \\sqrt{(-4)^{2}} & =\\sqrt{16}=4\\end{aligned}\n$$\n\nIn both cases, using absolute value gives the correct result:\n\n$$\n\\begin{aligned}\\sqrt{{4}^{2}}=|4| & =4 & ✓ \\\\ \\sqrt{(-4)^{2}}=|-4| & =4 & ✓\\end{aligned}\n$$" :tutorial/id #uuid "4e09a82d-1598-56ed-9888-9a1bfa380f55" :tutorial/math-academy-id 1604 :tutorial/title "Introduction"} :step/id #uuid "89060a03-576a-52b0-8345-c548845df17b" :step/math-academy-id 4284 :step/next {:db/id #edb/ref 17592186065166}} {:db/id #edb/ref 17592186065240 :step/content {:db/id #edb/ref 17592186064330 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063968 :question/id #uuid "62a47fad-0c27-5e6d-a21f-8b298ac11159" :question/math-academy-id "e-1355"} :knowledge-point/id #uuid "c0d0fdb7-9849-5aca-b494-3b013b2eb035" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049253}] :knowledge-point/questions [{:db/id #edb/ref 17592186064494} {:db/id #edb/ref 17592186064903} {:db/id #edb/ref 17592186233381} {:db/id #edb/ref 17592186481663}] :knowledge-point/title "Simplifying a Square Root of a Perfect Square Containing a Fraction"} :step/id #uuid "5eab9871-4247-51fe-85ce-5a836f6d3bc4" :step/math-academy-id 4291}] :activity/title "The Square Root of a Perfect Square With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064461}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186489333} :activity/id #uuid "a131be7b-68d2-57db-b50e-5c3bbbbafaae" :activity/scope {:db/id #edb/ref 17592186049843 :topic/id #uuid "18188755-d27b-5ea0-8e93-047aeb60e2d7" :topic/math-academy-id 376} :activity/steps [{:db/id #edb/ref 17592186489321 :step/content {:db/id #edb/ref 17592186489289 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20c639d7-7a27-579c-9de2-bfc34b74a330" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-yz" :db/id #edb/ref 17592186488537} {:answer/id #uuid "2c490ecf-5f63-5a62-a464-1073d7062fec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "yz" :db/id #edb/ref 17592186488565} {:answer/id #uuid "307e1365-05e4-5bc5-a68f-ed2c32a38c7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "|yz|" :db/id #edb/ref 17592186488574} {:answer/id #uuid "484f6643-41cd-55bf-ae3f-2f1cfc9ad32a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y|z|" :db/id #edb/ref 17592186488614} {:answer/id #uuid "ef935ffb-6785-53bf-9c0d-9df9b9b9ef91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm yz" :db/id #edb/ref 17592186488973}] :answer-field/correct {:db/id #edb/ref 17592186488574} :answer-field/id #uuid "c670e448-1e22-5196-8fb8-d4e5db38967e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489130}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f02573a0-2790-58d2-b6cc-7bac38c415b0" :question/math-academy-id "q-129432" :question/problem "$\\sqrt{{y}^{2}{z}^{2}}=$" :question/worked-solution "Remember that the square root of a perfect square can be simplified using absolute value.\n\n$$\n\\sqrt{{x}^{2}}=|x|\n$$\n\nAlso, we notice that ${y}^{2}$ and ${z}^{2}$ are perfect squares.\n\nFirst, we write the expression under the square root as a perfect square:\n\n$$\n\\begin{aligned}\\sqrt{{y}^{2}{z}^{2}} & =\\sqrt{y\\cdot y\\cdot z\\cdot z} \\\\  & =\\sqrt{y\\cdot z\\cdot y\\cdot z} \\\\  & =\\sqrt{(yz)\\cdot (yz)} \\\\  & =\\sqrt{(yz)^{2}}\\end{aligned}\n$$\n\nThen, we take the absolute value of the squared quantity:\n\n$$\n\\begin{aligned}\\sqrt{(yz)^{2}} & =|yz|\\end{aligned}\n$$"} :step/id #uuid "580c91a1-4c77-59fd-b9e9-6a409f2c4647" :step/next {:db/id #edb/ref 17592186489326}} {:db/id #edb/ref 17592186489326 :step/content {:db/id #edb/ref 17592186489234 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fb06393-6aac-50f5-a04b-9283e7529b0f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11|cd|" :db/id #edb/ref 17592186488690} {:answer/id #uuid "d516194b-16c2-53ca-ab0c-da1f099bf768" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11|c|d" :db/id #edb/ref 17592186488908} {:answer/id #uuid "da17cde0-38b7-57ed-9d96-55cb435c49c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm 11cd" :db/id #edb/ref 17592186488923} {:answer/id #uuid "efc7ea96-0e54-53a9-8e3a-8267aca4bace" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11c|d|" :db/id #edb/ref 17592186488975} {:answer/id #uuid "f133a350-9010-5f13-9ae6-3042c70926c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11cd" :db/id #edb/ref 17592186488980}] :answer-field/correct {:db/id #edb/ref 17592186488690} :answer-field/id #uuid "f8e5500d-4d6c-5ee8-8d88-044948dcf393" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489164}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7c4e2820-92a5-519d-9225-25cc4948f0c9" :question/math-academy-id "q-129436" :question/problem "$\\sqrt{121{c}^{2}{d}^{2}}=$" :question/worked-solution "Remember that the square root of a perfect square can be simplified using absolute value.\n\n$$\n\\sqrt{{x}^{2}}=|x|\n$$\n\nAlso, we notice that $121,{c}^{2},$ and ${d}^{2}$ are perfect squares.\n\nFirst, we write the expression under the square root as a perfect square:\n\n$$\n\\begin{aligned}\\sqrt{121{c}^{2}{d}^{2}} & =\\sqrt{{11}^{2}\\cdot {c}^{2}\\cdot {d}^{2}} \\\\  & =\\sqrt{11\\cdot 11\\cdot c\\cdot c\\cdot d\\cdot d} \\\\  & =\\sqrt{11\\cdot c\\cdot d\\cdot 11\\cdot c\\cdot d} \\\\  & =\\sqrt{(11cd)\\cdot (11cd)} \\\\  & =\\sqrt{(11cd)^{2}}\\end{aligned}\n$$\n\nThen, we take the absolute value of the squared quantity and simplify using the rules of absolute value:\n\n$$\n\\begin{aligned}\\sqrt{(11cd)^{2}} & =|11cd| \\\\  & =|11|\\cdot |cd| \\\\  & =11|cd|\\end{aligned}\n$$"} :step/id #uuid "71d5e5ee-5255-55c6-92c2-3b6a9653dcc6"} {:db/id #edb/ref 17592186489333 :step/content {:db/id #edb/ref 17592186489184 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aec2d0b-0038-5b9d-8e4f-821e3fd956b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm ab" :db/id #edb/ref 17592186488529} {:answer/id #uuid "677e43b4-9e76-52a3-a1bb-1004c237476a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "ab" :db/id #edb/ref 17592186488670} {:answer/id #uuid "99522d80-934c-58f8-8645-3e3d69f47b0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a|b|" :db/id #edb/ref 17592186488778} {:answer/id #uuid "9f014637-b6bb-5d87-a79d-711ebb7c4222" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "|a|b" :db/id #edb/ref 17592186488784} {:answer/id #uuid "a8914752-237a-5f09-b64c-97f60b10586b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "|ab|" :db/id #edb/ref 17592186488805}] :answer-field/correct {:db/id #edb/ref 17592186488805} :answer-field/id #uuid "e9a1e499-9cd1-5d15-a079-6c7d6a1a34e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489150}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "180b64b1-b15e-57ee-9a92-ff79a509bb19" :question/math-academy-id "q-129431" :question/problem "$\\sqrt{{a}^{2}{b}^{2}}=$" :question/worked-solution "Remember that the square root of a perfect square can be simplified using absolute value.\n\n$$\n\\sqrt{{x}^{2}}=|x|\n$$\n\nAlso, we notice that ${a}^{2}$ and ${b}^{2}$ are perfect squares.\n\nFirst, we write the expression under the square root as a perfect square:\n\n$$\n\\begin{aligned}\\sqrt{{a}^{2}{b}^{2}} & =\\sqrt{a\\cdot a\\cdot b\\cdot b} \\\\  & =\\sqrt{a\\cdot b\\cdot a\\cdot b} \\\\  & =\\sqrt{(ab)\\cdot (ab)} \\\\  & =\\sqrt{(ab)^{2}}\\end{aligned}\n$$\n\nThen, we take the absolute value of the squared quantity:\n\n$$\n\\begin{aligned}\\sqrt{(ab)^{2}} & =|ab|\\end{aligned}\n$$"} :step/id #uuid "830fe1f9-792b-5b8c-98b4-ab430e7693d7" :step/next {:db/id #edb/ref 17592186489321}}] :activity/title "The Square Root of a Perfect Square With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186488459}] [{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186074893} :activity/id #uuid "48334486-8ae7-5572-8e8f-b176d6318f35" :activity/scope {:db/id #edb/ref 17592186050138 :topic/id #uuid "2fda426e-c98b-5b36-800a-304f9ce90e0d" :topic/math-academy-id 554} :activity/steps [{:db/id #edb/ref 17592186074893 :step/content {:db/id #edb/ref 17592186075038 :tutorial/content "Let's take a look at the following equivalent ratios:\n\n![](images/6c/6cda61e0fbd0d9695644a29f0c6fa3478eae84cf253623da7f4b544f35873472.svg)\n\nWe can place the equivalent ratios in a **ratio table**, such as the one below. In a ratio table, each row represents a ratio.\n\n| ${\\color{blue}5}$ | ${\\color{red}10}$ |\n| --- | --- |\n| ${\\color{blue}10}$ | $\\bbox[3pt,Gainsboro]{\\color{red}\\textrm{?}}$ |\n| ${\\color{blue}20}$ | ${\\color{red}40}$ |\n\nOne number is missing. Let's figure out what it is.\n\nWe start with the ratio ${\\color{blue}5}:{\\color{red}10},$ which is the first ratio in the table. Writing this ratio as a fraction, we have\n\n$$\n\\dfrac{{\\color{blue}5}}{{\\color{red}10}}.\n$$\n\nThe numerator represents the left-hand entry (${\\color{blue}5}$), and the denominator represents the right-hand entry (${\\color{red}10}$).\n\nTo find the missing number, we need to make a numerator of ${\\color{blue}10}.$ We can do this by multiplying the numerator and denominator by $2$:\n\n$$\n\\begin{aligned}\\frac{5\\times 2}{10\\times 2} & =\\frac{10}{20}\\end{aligned}\n$$\n\nWe now add this to our ratio table:\n\n| ${\\color{blue}5}$ | ${\\color{red}10}$ |\n| --- | --- |\n| ${\\color{blue}10}$ | $\\bbox[3pt,Gainsboro]{\\color{red}20}$ |\n| ${\\color{blue}20}$ | ${\\color{red}40}$ |\n\nSo, the missing number is $\\color{red}20.$" :tutorial/id #uuid "ca7b3d51-7281-5705-bed5-276f34939c25" :tutorial/math-academy-id 8357 :tutorial/title "Introduction"} :step/id #uuid "ac8583b6-39eb-5a51-9b51-c3c4ebec13fa" :step/math-academy-id 81656 :step/next {:db/id #edb/ref 17592186074894}} {:db/id #edb/ref 17592186074894 :step/content {:db/id #edb/ref 17592186073894 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073453 :question/id #uuid "8e2f5bec-3573-5f1d-9870-41ac26b1ddf2" :question/math-academy-id "e-13342"} :knowledge-point/id #uuid "b9357cc9-e383-5d88-9741-f49f6fbcca99" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049733} {:db/id #edb/ref 17592186050481}] :knowledge-point/questions [{:db/id #edb/ref 17592186074048} {:db/id #edb/ref 17592186074049} {:db/id #edb/ref 17592186455472} {:db/id #edb/ref 17592186455473}] :knowledge-point/title "Filling a Ratio Table by Multiplying: Missing Denominators"} :step/id #uuid "f054590d-449e-5753-b1fc-569c01699cad" :step/math-academy-id 81657 :step/next {:db/id #edb/ref 17592186074895}} {:db/id #edb/ref 17592186074895 :step/content {:db/id #edb/ref 17592186073895 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073455 :question/id #uuid "e2ada4db-c1f0-53b0-9af7-ee2712ae75ef" :question/math-academy-id "e-13409"} :knowledge-point/id #uuid "6e3287b0-2ecb-5d83-9596-7943d68f8884" :knowledge-point/questions [{:db/id #edb/ref 17592186074024} {:db/id #edb/ref 17592186074384} {:db/id #edb/ref 17592186455446} {:db/id #edb/ref 17592186455501} {:db/id #edb/ref 17592186538941} {:db/id #edb/ref 17592186544874}] :knowledge-point/title "Filling a Ratio Table by Multiplying: Missing Numerators"} :step/id #uuid "aab5d8f4-9d49-5c7f-9619-01557ca3969b" :step/math-academy-id 81660 :step/next {:db/id #edb/ref 17592186074896}} {:db/id #edb/ref 17592186074896 :step/content {:db/id #edb/ref 17592186073896 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073454 :question/id #uuid "11fac5c9-ca4a-54a6-9f38-3c675411673e" :question/math-academy-id "e-13343"} :knowledge-point/id #uuid "60021495-9d2a-58a5-9321-bb16013bbba7" :knowledge-point/questions [{:db/id #edb/ref 17592186073996} {:db/id #edb/ref 17592186074050} {:db/id #edb/ref 17592186455439} {:db/id #edb/ref 17592186455465} {:db/id #edb/ref 17592186533991} {:db/id #edb/ref 17592186544885}] :knowledge-point/title "Filling a Ratio Table by Multiplying and Dividing"} :step/id #uuid "bd74231b-139c-5091-8fd3-66103c7f1329" :step/math-academy-id 81663 :step/next {:db/id #edb/ref 17592186074897}} {:db/id #edb/ref 17592186074897 :step/content {:db/id #edb/ref 17592186073897 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073456 :question/id #uuid "f1a6757d-3e68-5263-a6c7-d03c73391848" :question/math-academy-id "e-13410"} :knowledge-point/id #uuid "84a526bf-9d98-54e1-a54e-cd625bbaea49" :knowledge-point/questions [{:db/id #edb/ref 17592186074385} {:db/id #edb/ref 17592186074398} {:db/id #edb/ref 17592186455467} {:db/id #edb/ref 17592186455502} {:db/id #edb/ref 17592186544785}] :knowledge-point/title "Word Problems"} :step/id #uuid "b13509a4-8a23-5240-a77b-f79cb3691c99" :step/math-academy-id 81666}] :activity/title "Ratio Tables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073973}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186544970} :activity/id #uuid "246e194b-38b8-58e5-8bf1-ed23e18707c6" :activity/scope {:db/id #edb/ref 17592186050138 :topic/id #uuid "2fda426e-c98b-5b36-800a-304f9ce90e0d" :topic/math-academy-id 554} :activity/steps [{:db/id #edb/ref 17592186544960 :step/content {:db/id #edb/ref 17592186544785 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "257f2818-68c3-56e8-8274-f829f0a2508c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "26" :db/id #edb/ref 17592186544171} {:answer/id #uuid "3b6ac35d-9f43-5857-b1f2-871ed91f248e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32" :db/id #edb/ref 17592186544214} {:answer/id #uuid "4f9324be-63c9-5f43-89d5-f643aba91802" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30" :db/id #edb/ref 17592186544259} {:answer/id #uuid "67aa2a37-93dc-537d-8c25-bd3d37cb5f4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186544312} {:answer/id #uuid "91cc30be-ed6a-5c8b-b0fc-539e49732127" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "28" :db/id #edb/ref 17592186544405}] :answer-field/correct {:db/id #edb/ref 17592186544405} :answer-field/id #uuid "143347e7-6d5a-5881-950d-01ac371e0e93" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544659}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "07105131-b758-5e72-bdb4-02c98035c4fe" :question/math-academy-id "q-59864" :question/problem "Gerry, a gardener, is planting roses. He knows he needs $1$ cup of water for every $4$ seeds he plants. So, Gerry creates a ratio table to determine the ratio of water to seeds for different quantities.\n\n| Water (cups) | Seeds |\n| --- | --- |\n| $1$ | $4$ |\n| $7$ | $?$ |\n| $12$ | $48$ |\n\n$$\n\n$$\n\nHow many seeds can Gerry plant with $7$ cups of water?" :question/worked-solution "We start with the ratio $1:4$ and write it as a fraction:\n\n$$\n\\frac{1}{4}\n$$\n\nSo the numerator represents the number of cups of water ($1$), and the denominator represents the number of seeds ($4$).\n\nWe can make a numerator of $7$ by multiplying the numerator and denominator by $7$:\n\n$$\n\\begin{aligned}\\frac{1\\times 7}{4\\times 7} & =\\frac{7}{28}\\end{aligned}\n$$\n\nWe add this to our ratio table:\n\n| Water (cups) | Seeds |\n| --- | --- |\n| $1$ | $4$ |\n| $7$ | $28$ |\n| $12$ | $48$ |\n\n$$\n\n$$\n\nSo, Gerry can plant $28$ seeds with $7$ cups of water."} :step/id #uuid "b2e36d57-8213-53e5-bff9-ed407c12c943" :step/next {:db/id #edb/ref 17592186544993}} {:db/id #edb/ref 17592186544970 :step/content {:db/id #edb/ref 17592186074384 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "805fcf6a-52c6-530b-93ed-5397ad073053" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$21$ and $20$" :db/id #edb/ref 17592186072543} {:answer/id #uuid "b6d607ee-0b23-5d1a-beeb-1fbeecaeadcb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$21$ and $16$" :db/id #edb/ref 17592186072544} {:answer/id #uuid "dfb84b1f-8738-59b6-ac48-27feb1cfefbd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$28$ and $20$" :db/id #edb/ref 17592186072545} {:answer/id #uuid "fbd78151-6ab0-5687-8eed-258100912557" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$42$ and $24$" :db/id #edb/ref 17592186072546} {:answer/id #uuid "6890ecb2-7743-5147-b5f9-be5a6b87114d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$14$ and $16$" :db/id #edb/ref 17592186072547}] :answer-field/correct {:db/id #edb/ref 17592186072543} :answer-field/id #uuid "e097f782-347d-504a-b939-0a797ec8e368" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186072542}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "71ed15e5-6449-55de-bddd-3b4b9bf5265e" :question/math-academy-id "q-59819" :question/problem "From top to bottom, what are the missing numbers in the ratio table below?\n\n| $4$ | $7$ |\n| --- | --- |\n| $12$ | $?$ |\n| $?$ | $35$ |\n\n$$\n\n$$" :question/worked-solution "We start with the ratio $4:7$ and write it as a fraction:\n\n$$\n\\frac{4}{7}\n$$\n\nSo the numerator represents the left-hand entry ($4$), and the denominator represents the right-hand entry ($7$).\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n- To create a numerator of $12,$ we multiply the numerator and denominator of our fraction by $3:$\n\n$$\n\\frac{4\\times 3}{7\\times 3}=\\frac{12}{21}\n$$\n\n- To create a denominator of $35,$ we multiply the numerator and denominator of our fraction by $5:$\n\n$$\n\\frac{4\\times 5}{7\\times 5}=\\frac{20}{35}\n$$\n\nFinally, we fill in the ratio table:\n\n| $4$ | $7$ |\n| --- | --- |\n| $12$ | $21$ |\n| $20$ | $35$ |\n\n$$\n\n$$\n\nSo, from top to bottom, the missing numbers are $21$ and $20.$"} :step/id #uuid "c2a4f642-7f5e-5258-bf8b-7514a82eded7" :step/next {:db/id #edb/ref 17592186544960}} {:db/id #edb/ref 17592186544993 :step/content {:db/id #edb/ref 17592186544885 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e1d0b9d-3357-54ab-82cf-abf91011ffa6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5$ and $30$" :db/id #edb/ref 17592186544152} {:answer/id #uuid "38f59563-e260-5f22-a248-5d3fefc64cdc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ and $30$" :db/id #edb/ref 17592186544210} {:answer/id #uuid "a545f8d6-c144-53ff-ae29-f028d06395f6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4$ and $20$" :db/id #edb/ref 17592186544443} {:answer/id #uuid "a67179fa-5ca5-5e82-94ea-ac2e1fb430df" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ and $18$" :db/id #edb/ref 17592186544447} {:answer/id #uuid "e37e6ce5-4981-521e-804c-81bef08aaaba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5$ and $18$" :db/id #edb/ref 17592186544577}] :answer-field/correct {:db/id #edb/ref 17592186544210} :answer-field/id #uuid "00fa6310-f945-5eef-a33e-d1403f30df5d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544648}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d91b69e3-fd77-5457-a2ba-3ce70f9e9f93" :question/math-academy-id "q-101518" :question/problem "From top to bottom, what are the missing numbers in the ratio table below?\n\n| $?$ | $10$ |\n| --- | --- |\n| $3$ | $15$ |\n| $6$ | $?$ |\n\n$$\n\n$$" :question/worked-solution "We start with the ratio $3:15$ and write it as a fraction:\n\n$$\n\\frac{3}{15}\n$$\n\nSo the numerator represents the left-hand entry ($3$), and the denominator represents the right-hand entry ($15$).\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n- To create a numerator of $6,$ we multiply the numerator and denominator of our fraction by $2:$\n\n$$\n\\frac{3\\times 2}{15\\times 2}=\\frac{6}{30}\n$$\n\n- To create a denominator of $10,$ we divide the numerator and denominator of the previous fraction by $3:$\n\n$$\n\\frac{6÷3}{30÷3}=\\frac{2}{10}\n$$\n\nFinally, we fill in the ratio table:\n\n| $2$ | $10$ |\n| --- | --- |\n| $3$ | $15$ |\n| $6$ | $30$ |\n\n$$\n\n$$\n\nSo, from top to bottom, the missing numbers are $2$ and $30.$"} :step/id #uuid "fcd7a88c-39ee-5167-897e-fa978522f159"}] :activity/title "Ratio Tables" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186544071}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186065195} :activity/id #uuid "abc3056c-c606-506b-b00e-5921984cd770" :activity/scope {:db/id #edb/ref 17592186050208 :topic/id #uuid "3668d61c-1873-5fa7-ac2e-a1d14113f40f" :topic/math-academy-id 362} :activity/steps [{:db/id #edb/ref 17592186065195 :step/content {:db/id #edb/ref 17592186065338 :tutorial/content "The **power rule for exponents** states that a power raised to another power is equal to the product of the two powers:\n\n$$\n\\left(a^m\\right)^n = a^{mn}\n$$\n\nFor example,\n\n$$\n\\eqalign{\n\t\t\\left(5^2\\right)^3 &= \\\n\t\t\t\t5^{2 \\cdot 3} &= \\\n\t\t\t\t5^6.\n\t}\n$$\n\nTo see why the power rule for exponents is true, let's take the above example and work it out again, the long way:\n\n$$\n\\eqalign{\n\\left(5^2\\right)^3 &= \\[5pt]\n\t\\underbrace{5^2\\cdot 5^2\\cdot 5^2}_{3\\text{ times}} &= \\[5pt]\n(5 \\cdot 5) \\cdot (5 \\cdot 5) \\cdot (5 \\cdot 5) &= \\[5pt]\n\t\\underbrace{5\\cdot5\\cdot5\\cdot5\\cdot5\\cdot5}_{6\\text{ times}} &= \\[5pt]\n\t5^6\n}\n$$\n\nThe power rule for exponents is just a shortcut for the process above." :tutorial/id #uuid "1a2e18f4-6996-52a0-95eb-77abb10d0e77" :tutorial/math-academy-id 1480 :tutorial/title "Introduction"} :step/id #uuid "d4e0fa30-ed7c-5ef6-9aaa-10d6ba2f9c05" :step/math-academy-id 3529 :step/next {:db/id #edb/ref 17592186065196}} {:db/id #edb/ref 17592186065196 :step/content {:db/id #edb/ref 17592186064301 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063922 :question/id #uuid "a023e3eb-38bb-52ed-ae06-26ccdcd8fbf6" :question/math-academy-id "e-1076"} :knowledge-point/id #uuid "e463f04c-3ec1-5b0b-99a4-c286cf0f2d23" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050697} {:db/id #edb/ref 17592186051009}] :knowledge-point/questions [{:db/id #edb/ref 17592186064680} {:db/id #edb/ref 17592186064917} {:db/id #edb/ref 17592186485550}] :knowledge-point/title "Using the Power Rule with Positive Exponents"} :step/id #uuid "57c38b87-4e15-573a-960c-a61055841b16" :step/math-academy-id 3530 :step/next {:db/id #edb/ref 17592186065197}} {:db/id #edb/ref 17592186065197 :step/content {:db/id #edb/ref 17592186064302 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063923 :question/id #uuid "bc3b926b-dc98-5c74-8fc6-32075763059c" :question/math-academy-id "e-1077"} :knowledge-point/id #uuid "5abe4cbe-7495-5723-88cd-f97796f8ef49" :knowledge-point/questions [{:db/id #edb/ref 17592186064690} {:db/id #edb/ref 17592186064918} {:db/id #edb/ref 17592186485517} {:db/id #edb/ref 17592186485563} {:db/id #edb/ref 17592186544867} {:db/id #edb/ref 17592186544871}] :knowledge-point/title "Using the Power Rule with Negative Exponents"} :step/id #uuid "94008045-7999-599a-b725-36201f5023db" :step/math-academy-id 3532 :step/next {:db/id #edb/ref 17592186065198}} {:db/id #edb/ref 17592186065198 :step/content {:db/id #edb/ref 17592186065339 :tutorial/content "Suppose we want to remove the radical term in an expression like $\\sqrt{x^{3}}.$ To do this, we first convert the radical to a fractional exponent:\n\n$$\n\\sqrt{x^{3}}= \\left(x^{3}\\right)^{1/2}\n$$\n\nThen, we can apply the power rule and multiply the fractional exponents:\n\n$$\n\\begin{aligned}{({x}^{3})}^{1/2} & = \\\\ {x}^{(3)\\cdot (1/2)} & = \\\\ {x}^{3/2}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\sqrt{x^{3}} = x^{3/2},\n$$\n\nand in general,\n\n$$\n\\sqrt[n]{x^m} = x^{m/n}.\n$$" :tutorial/id #uuid "40488864-6672-59b7-9ac6-79903856b484" :tutorial/math-academy-id 1481 :tutorial/title "The Power Rule With Fractional Exponents"} :step/id #uuid "19a0572e-4edb-579e-b72d-fdc1fefe72ca" :step/math-academy-id 3536 :step/next {:db/id #edb/ref 17592186065199}} {:db/id #edb/ref 17592186065199 :step/content {:db/id #edb/ref 17592186064303 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063924 :question/id #uuid "f61d95d1-9761-53c3-bfb3-699bdcf6467a" :question/math-academy-id "e-1079"} :knowledge-point/id #uuid "0b64073e-4aa0-551c-b914-98420b0be338" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050894}] :knowledge-point/questions [{:db/id #edb/ref 17592186064715} {:db/id #edb/ref 17592186064919} {:db/id #edb/ref 17592186485536} {:db/id #edb/ref 17592186485539} {:db/id #edb/ref 17592186544852}] :knowledge-point/title "Using the Power Rule with Fractional Exponents"} :step/id #uuid "d556d6dc-07a0-5db1-b5db-945a6a81b5eb" :step/math-academy-id 3537 :step/next {:db/id #edb/ref 17592186065200}} {:db/id #edb/ref 17592186065200 :step/content {:db/id #edb/ref 17592186064304 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063925 :question/id #uuid "bdb00b27-cb4d-5713-98c1-d4aa2eaa4643" :question/math-academy-id "e-1080"} :knowledge-point/id #uuid "acc85958-ad98-5ce2-912c-e2ba70d025ca" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049729}] :knowledge-point/questions [{:db/id #edb/ref 17592186064750} {:db/id #edb/ref 17592186064920} {:db/id #edb/ref 17592186233088} {:db/id #edb/ref 17592186485504} {:db/id #edb/ref 17592186485511} {:db/id #edb/ref 17592186544805}] :knowledge-point/title "Simplifying Challenging Expressions Using the Power Rule"} :step/id #uuid "7aabc08d-413a-5e15-8a0e-170869a0198c" :step/math-academy-id 3539}] :activity/title "The Power Rule for Exponents With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064449}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186544978} :activity/id #uuid "d4e8d8ea-37ee-5a5f-b346-bb11740b6853" :activity/scope {:db/id #edb/ref 17592186050208 :topic/id #uuid "3668d61c-1873-5fa7-ac2e-a1d14113f40f" :topic/math-academy-id 362} :activity/steps [{:db/id #edb/ref 17592186544965 :step/content {:db/id #edb/ref 17592186544871 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bd28ffb-2444-5b3b-9352-22dee73812b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{q}^{9}" :db/id #edb/ref 17592186544215} {:answer/id #uuid "4ec9da01-88b1-59bd-a764-b87dd8ba36c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{q}^{3}" :db/id #edb/ref 17592186544258} {:answer/id #uuid "56691dcf-1c03-50ed-a797-5ec52a32d0c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{q}^{-6}" :db/id #edb/ref 17592186544277} {:answer/id #uuid "a3c29c00-745a-56cd-a7cb-a7200aaec254" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{q}^{-9}" :db/id #edb/ref 17592186544440} {:answer/id #uuid "edc6ddbf-8437-5dac-b182-00dc00ca17f3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "undefined" :db/id #edb/ref 17592186544601}] :answer-field/correct {:db/id #edb/ref 17592186544215} :answer-field/id #uuid "50a6c686-68dd-5071-9327-897d026326b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544687}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b9bd1889-37e7-5c18-aff9-d79a4155a663" :question/math-academy-id "q-25388" :question/problem "Which of the following is equivalent to ${({p}^{0}{q}^{-3})}^{-3}?$" :question/worked-solution "First, we simplify the expression inside the parenthesis and then we apply the power rule\n\n$$\n\\begin{aligned}{({p}^{0}{q}^{-3})}^{-3} & = \\\\ {(1\\cdot {q}^{-3})}^{-3} & = \\\\ {({q}^{-3})}^{-3} & = \\\\ {q}^{(-3)(-3)} & = \\\\ {q}^{9}\\end{aligned}\n$$"} :step/id #uuid "ba723f55-31ec-5dd6-9dc6-ad73e8e639a6" :step/next {:db/id #edb/ref 17592186544976}} {:db/id #edb/ref 17592186544976 :step/content {:db/id #edb/ref 17592186544805 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "172ae84a-d9ad-5b2c-a66c-13b732c1d880" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186544134} {:answer/id #uuid "1e055b9f-627a-5ebf-9e18-8a5c87b9089b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186544151} {:answer/id #uuid "795691ba-bdae-5475-be56-27a71a0be7cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186544356} {:answer/id #uuid "eba20943-6e93-5443-b335-cbfdcee078e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186544595} {:answer/id #uuid "faf8fbf1-75c8-5c7e-9dff-ca66a5c03643" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186544635}] :answer-field/correct {:db/id #edb/ref 17592186544356} :answer-field/id #uuid "8f0bb462-c95e-50f5-9f00-b9bf46397566" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544718}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3b874545-de9e-5368-9969-5a0f4efc79db" :question/math-academy-id "q-34432" :question/problem "If $\\sqrt[3]{{z}^{-6/5}}={z}^{k},$ then $k=$" :question/worked-solution "First, we express the radical as a fractional power and then we apply the power rule:\n\n$$\n\\begin{aligned}\\sqrt[3]{{z}^{-6/5}} & = \\\\ {({z}^{-6/5})}^{1/3} & = \\\\ {z}^{(-6/5)(1/3)} & = \\\\ {z}^{-2/5}\\end{aligned}\n$$\n\nHence, $k=-\\frac{2}{5}.$"} :step/id #uuid "d14d94aa-acdf-59ab-9018-6c208c90e229"} {:db/id #edb/ref 17592186544978 :step/content {:db/id #edb/ref 17592186544867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c62a19f-ef87-5040-8957-d453f57e8355" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186544252} {:answer/id #uuid "53a706e6-a114-5dcb-968f-bd0f47f11344" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-15" :db/id #edb/ref 17592186544271} {:answer/id #uuid "6c734423-1ce5-5bc2-820b-5582e72ffadb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186544326} {:answer/id #uuid "d5c37a78-c18d-591f-99d3-033cf620f68f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186544541} {:answer/id #uuid "f1f3060e-7fe3-5928-908b-1b159cbd448d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186544611}] :answer-field/correct {:db/id #edb/ref 17592186544271} :answer-field/id #uuid "9999e1f9-b3be-5f04-b3f7-4c9ed6f2d031" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544724}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b2001685-083c-5b23-92d4-dc534c9b8927" :question/math-academy-id "q-2798" :question/problem "If ${({x}^{-3})}^{5}={x}^{k},$ then $k=$" :question/worked-solution "We multiply the exponents, as follows:\n\n$$\n\\begin{aligned}{({x}^{-3})}^{5} & = \\\\ {x}^{(-3)5} & = \\\\ {x}^{-15}\\end{aligned}\n$$\n\nHence, $k=-15.$"} :step/id #uuid "d2528ecc-26c4-5f1d-b559-b7a427afb73d" :step/next {:db/id #edb/ref 17592186544965}}] :activity/title "The Power Rule for Exponents With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186544081}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186069704} :activity/id #uuid "5d42bb12-b3dd-51d8-b182-d11c5610f66c" :activity/scope {:db/id #edb/ref 17592186050361 :topic/id #uuid "42d6df97-82bc-5c46-b6ad-8dc1bac71005" :topic/math-academy-id 387} :activity/steps [{:db/id #edb/ref 17592186069701 :step/content {:db/id #edb/ref 17592186068782 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068624 :question/id #uuid "bd57c7f2-87b5-55a0-9237-1ef814f59898" :question/math-academy-id "e-6136"} :knowledge-point/id #uuid "a0e5b503-a393-58ef-bbcd-5c6d65257f53" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050127} {:db/id #edb/ref 17592186050519}] :knowledge-point/questions [{:db/id #edb/ref 17592186069463} {:db/id #edb/ref 17592186069466} {:db/id #edb/ref 17592186484205} {:db/id #edb/ref 17592186484237} {:db/id #edb/ref 17592186484269}] :knowledge-point/title "Identifying Values that Satisfy a Given Inequality"} :step/id #uuid "7a12041b-cf05-5ef7-861a-4a41e851ccce" :step/math-academy-id 22846 :step/next {:db/id #edb/ref 17592186069705}} {:db/id #edb/ref 17592186069702 :step/content {:db/id #edb/ref 17592186068783 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068625 :question/id #uuid "74587421-d1ad-550e-a30d-4d4768588d4f" :question/math-academy-id "e-6137"} :knowledge-point/id #uuid "09fdde75-121e-5378-bad1-1ab564375d41" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049051}] :knowledge-point/questions [{:db/id #edb/ref 17592186069470} {:db/id #edb/ref 17592186069471} {:db/id #edb/ref 17592186484222}] :knowledge-point/title "Identifying Values that Satisfy a Given Compound Inequality"} :step/id #uuid "6e5127b1-8f72-5af1-9af8-0a68620f1c8f" :step/math-academy-id 22847 :step/next {:db/id #edb/ref 17592186069703}} {:db/id #edb/ref 17592186069703 :step/content {:db/id #edb/ref 17592186068784 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068626 :question/id #uuid "fb564b00-2d04-556a-a662-7b92e21ec3d3" :question/math-academy-id "e-6138"} :knowledge-point/id #uuid "cd07be8d-2eba-5e4e-ba42-72470fd12120" :knowledge-point/questions [{:db/id #edb/ref 17592186069472} {:db/id #edb/ref 17592186069512} {:db/id #edb/ref 17592186484221} {:db/id #edb/ref 17592186484268} {:db/id #edb/ref 17592186484274} {:db/id #edb/ref 17592186484290}] :knowledge-point/title "Identifying Inequalities that are Satisfied by a Given Value"} :step/id #uuid "d2c8d513-b9f7-5e4d-b550-a588fb3a8ef1" :step/math-academy-id 22848} {:db/id #edb/ref 17592186069704 :step/content {:db/id #edb/ref 17592186069979 :tutorial/content "We can find which values satisfy an inequality by trial and error, which involves substituting a number for the variable and checking to see if we get a true statement.\n\nFor example, which of the following values of $y$ satisfy the inequality $y - 1 > 3\\,?$\n\nI. $y=6$\n\nII. $y=2$\n\nIII. $y=3$\n\nLet's go through the possibilities one at a time.\n\n- Substituting the value ${\\color{blue}y}={\\color{blue}6}$ into the given equation, we get:\n\n$$\n\\begin{aligned}y-1 & >3 \\\\ 6-1 & >3 \\\\ 5 & >3\\,✓\\end{aligned}\n$$\n\nThis is a **true** statement, so $y=6$ **satisfies** this inequality.\n\n- Substituting the value ${\\color{blue}y}={\\color{blue}2}$ into the given equation, we get:\n\n$$\n\\begin{aligned}y-1 & >3 \\\\ 2-1 & >3 \\\\ 1 & >3\\,\\times \\end{aligned}\n$$\n\nThis is a **false** statement, so $y=2$ **does not satisfy** this inequality.\n\n- Substituting the value ${\\color{blue}y}={\\color{blue}3}$ into the given equation, we get:\n\n$$\n\\begin{aligned}y-1 & >3 \\\\ 3-1 & >3 \\\\ 2 & >3\\,\\times \\end{aligned}\n$$\n\nThis is a **false** statement, so $y=3$ **does not satisfy** this inequality.\n\nTherefore, only I satisfies the inequality." :tutorial/id #uuid "c8259a9f-33bd-5c3f-9005-695f9474fbab" :tutorial/math-academy-id 3879 :tutorial/title "Introduction"} :step/id #uuid "d80f89b1-82f3-5c21-ae3e-13d7fbef2b51" :step/math-academy-id 22849 :step/next {:db/id #edb/ref 17592186069701}} {:db/id #edb/ref 17592186069705 :step/content {:db/id #edb/ref 17592186068785 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068627 :question/id #uuid "73bc0b43-f3a9-5a4b-a49f-833cdf1f493f" :question/math-academy-id "e-6139"} :knowledge-point/id #uuid "9c472f18-da99-5969-acdf-1a7b53465494" :knowledge-point/questions [{:db/id #edb/ref 17592186069462} {:db/id #edb/ref 17592186069465} {:db/id #edb/ref 17592186484216} {:db/id #edb/ref 17592186484242} {:db/id #edb/ref 17592186544801}] :knowledge-point/title "Identifying Values that Satisfy a Given Inequality with Fractions"} :step/id #uuid "a64fa200-0d99-5bad-916e-7cbe9afb1166" :step/math-academy-id 22850 :step/next {:db/id #edb/ref 17592186069702}}] :activity/title "Verifying Solutions of Linear Inequalities" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068934}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055883} :activity/id #uuid "105911a6-a8fa-5b40-bf5e-8a3845e590dc" :activity/scope {:db/id #edb/ref 17592186050613 :topic/id #uuid "58d4d7b7-4b91-5e3c-ba04-7522d5cfa8f6" :topic/math-academy-id 40} :activity/steps [{:db/id #edb/ref 17592186055883 :step/content {:db/id #edb/ref 17592186056009 :tutorial/content "Let's suppose that we want to solve an equation like \n\n$$\n\\dfrac x 6 = 4.\n$$\n\nFor this, we can use the **multiplication principle.** The multiplication principle tells us that multiplying (or dividing) both sides of an equation by the same number does not change its solution.\n\nIn this case, the variable $x$ is being *divided* by $6.$ To isolate $x$, we can perform the *opposite* operation, which is *multiplying* by $6$. So, we multiply both sides of the equation by $6.$\n\n$$\n\\eqalign{\n\t\t\\dfrac x 6 \t\t\t\t\t&= 4 \\[5pt]\n\t\t{\\color{blue}{6}} \\cdot \\dfrac x 6  \t&= {\\color{blue}{6}}\\cdot 4\\[5pt]\n\t\t\\dfrac{6x}{6}\t\t\t&=24\\[5pt]\n\t}\n$$\n\n \n\nNow, we can cancel a common factor of $6$ from both the numerator and denominator.\n\n$$\n\\eqalign{\n\t\t\\dfrac{6x}{6}\t\t\t&=24 \\\n\t\t\\dfrac{ \\cancel{6} x}{\\cancel{6} }\t\t\t&=24 \\\n\t\tx\t\t\t\t&=24\n\t}\n$$\n\n \n\nThus, our solution is $x=24.$ Let's check that this solution is correct by plugging it back into the original equation:\n\n$$\n\\eqalign{\n    \t\t\\dfrac x 6 &=4 \\[5pt]\n    \t\t\\dfrac{24}{6} &=4 \\[5pt]\n\t\t4 &= 4 \\; {\\color{green}{\\checkmark}}\n\t}\n$$" :tutorial/id #uuid "66f28923-eb93-5bc0-b870-b4316258a3c8" :tutorial/math-academy-id 8052 :tutorial/title "Introduction"} :step/id #uuid "85cdcdec-1c60-5ac5-8e3f-e25e47c0bb28" :step/math-academy-id 72101 :step/next {:db/id #edb/ref 17592186055884}} {:db/id #edb/ref 17592186055884 :step/content {:db/id #edb/ref 17592186054834 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054381 :question/id #uuid "c64cd16e-2f9d-5564-8d04-eddcad2c5d01" :question/math-academy-id "e-12859"} :knowledge-point/id #uuid "4007f63e-0a99-57ca-a1f6-190b21f02ecc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050414} {:db/id #edb/ref 17592186050599}] :knowledge-point/questions [{:db/id #edb/ref 17592186055151} {:db/id #edb/ref 17592186055443} {:db/id #edb/ref 17592186479855} {:db/id #edb/ref 17592186479893}] :knowledge-point/title "Linear Equations Requiring Multiplication by a Positive Integer"} :step/id #uuid "036eee4c-d08b-5bac-82ff-0d8314f256ca" :step/math-academy-id 72102 :step/next {:db/id #edb/ref 17592186055885}} {:db/id #edb/ref 17592186055885 :step/content {:db/id #edb/ref 17592186054835 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054388 :question/id #uuid "cbce1708-81ba-5d37-ae21-fc8d94ebbc2f" :question/math-academy-id "e-12894"} :knowledge-point/id #uuid "b765f7b2-639a-5519-9170-02a4fcb0f8fe" :knowledge-point/questions [{:db/id #edb/ref 17592186054940} {:db/id #edb/ref 17592186055290} {:db/id #edb/ref 17592186479828} {:db/id #edb/ref 17592186479865} {:db/id #edb/ref 17592186544833}] :knowledge-point/title "Cases Where the Variable Is on the Right-Hand Side"} :step/id #uuid "f810611a-c93d-5ca0-8ad1-26bd885d89c1" :step/math-academy-id 72105 :step/next {:db/id #edb/ref 17592186055886}} {:db/id #edb/ref 17592186055886 :step/content {:db/id #edb/ref 17592186056010 :tutorial/content "In order to remove a negative sign from our variable, we can multiply both sides by $-1$. This way, the two negatives will cancel out to form a positive. \n\nFor example, suppose that we have the equation\n\n$$\n-x = 3\n$$\n\nWe can isolate $x$ by multiplying both sides of the equation by $-1,$ as follows:\n\n$$\n\\begin{aligned}-x & =3 \\\\ (-1)\\cdot (-x) & =(-1)\\cdot 3 \\\\ x & =-3\\end{aligned}\n$$\n\nTherefore, the solution to the equation is $x=-3.$ Let's check to see that this works by substituting our solution back into the original equation.\n\n$$\n\\begin{aligned}-x & =3 \\\\ -(-3) & =3 \\\\ 3 & =3\\,✓\\end{aligned}\n$$" :tutorial/id #uuid "7de479d1-5bb2-5cc9-9fdc-117a02790cab" :tutorial/math-academy-id 8053 :tutorial/title "Removing a Negative Sign from a Variable"} :step/id #uuid "91e35f06-1502-52eb-91c6-d755a826ebfc" :step/math-academy-id 72108 :step/next {:db/id #edb/ref 17592186055887}} {:db/id #edb/ref 17592186055887 :step/content {:db/id #edb/ref 17592186054836 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054382 :question/id #uuid "5fe35108-2fa8-563e-862e-ad27d4ed5334" :question/math-academy-id "e-12860"} :knowledge-point/id #uuid "712bc4c6-aeaf-5081-9e64-791027b38963" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049349}] :knowledge-point/questions [{:db/id #edb/ref 17592186055291} {:db/id #edb/ref 17592186055420} {:db/id #edb/ref 17592186479831} {:db/id #edb/ref 17592186479882} {:db/id #edb/ref 17592186538937} {:db/id #edb/ref 17592186542151}] :knowledge-point/title "Linear Equations Requiring Multiplication by a Negative Integer"} :step/id #uuid "fe58020e-d340-5fac-88b2-1c50209326d9" :step/math-academy-id 72109 :step/next {:db/id #edb/ref 17592186055888}} {:db/id #edb/ref 17592186055888 :step/content {:db/id #edb/ref 17592186056011 :tutorial/content "To solve an equation like $7x = 21$, we again need to look at what's happening to the variable and ask ourselves what the opposite operation is.\n\nIn this case, the variable $x$ is being *multiplied* by $7.$ To isolate $x$, we can perform the *opposite* operation, which is *dividing* by $7$. So, we divide both sides of the equation by $7.$\n\n$$\n\\eqalign{\n\t\t7x &= 21 \\[5pt]\n\t\t\\dfrac{7x}{{\\color{blue}7}} &=\\dfrac{21}{{\\color{blue}7}}\n\t}\n$$\n\n \n\nNow, we can cancel a common factor of $7$ from both the numerator and denominator.\n\n$$\n\\eqalign{\n\t\t\\dfrac{7x}{{\\color{blue}7}} &=\\dfrac{21}{{\\color{blue}7}}\\[5pt]\n\t\t\\dfrac{\\cancel{7}x}{\\cancel{\\color{blue}7}} &=3 \\[5pt]\n\t\tx &=3\n\t}\n$$\n\n \n\nLet's check that our answer is correct by plugging it back into the original equation:\n\n$$\n\\eqalign{\n    \t\t7x &=21 \\[5pt]\n    \t\t7(3) &=21 \\[5pt]\n\t\t21 &= 21 \\; {\\color{green}{\\checkmark}}\n\t}\n$$\n\n**Note:** If there is a negative coefficient on a variable, we can get rid of it by dividing, like we do with positive coefficients. For example:\n\n$$\n\\begin{aligned}-2y & =10 \\\\ \\frac{-2y}{-2} & =\\frac{10}{-2} \\\\ \\frac{\\cancel{-2}y}{\\cancel{-2}} & =-5 \\\\ y & =-5\\end{aligned}\n$$" :tutorial/id #uuid "1a74f63d-cfcc-5a3f-899c-6b15cfa2247f" :tutorial/math-academy-id 8054 :tutorial/title "Using the Multiplication Principle to Divide"} :step/id #uuid "afb3bda0-823e-547e-bb19-4e9d28f09976" :step/math-academy-id 72112 :step/next {:db/id #edb/ref 17592186055889}} {:db/id #edb/ref 17592186055889 :step/content {:db/id #edb/ref 17592186054837 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054383 :question/id #uuid "68865bc2-e4e2-53d9-9988-4fa962e04746" :question/math-academy-id "e-12861"} :knowledge-point/id #uuid "e153c18d-6f3e-5fef-a006-c5597cd88bc9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050719}] :knowledge-point/questions [{:db/id #edb/ref 17592186055033} {:db/id #edb/ref 17592186055274} {:db/id #edb/ref 17592186479844} {:db/id #edb/ref 17592186479891}] :knowledge-point/title "Linear Equations Requiring Division"} :step/id #uuid "1b859cff-8545-5c6f-9fc0-22c30fff2c3b" :step/math-academy-id 72113}] :activity/title "Solving One-Step Multiplication and Division Equations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054901}]}
