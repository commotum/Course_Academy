b/ref 17592186045498} :answer/value "\\frac{\\sqrt{63}}{7}" :db/id #edb/ref 17592186494673} {:answer/id #uuid "c52da2ef-45c8-5cc1-8d40-dcc039628f7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\sqrt{7}}{7}" :db/id #edb/ref 17592186494781} {:answer/id #uuid "e2e5fe20-ac58-5d90-b58b-91cc21887122" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{7}}{21}" :db/id #edb/ref 17592186494859}] :answer-field/correct {:db/id #edb/ref 17592186494555} :answer-field/id #uuid "a3bf9e83-273c-5b34-b405-581696dd025a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494994}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ae109d24-9fc2-5d5a-8052-a06c5bb12363" :question/math-academy-id "q-68978" :question/problem "$\\frac{\\sqrt{3}}{\\sqrt{7}}=$" :question/worked-solution "To remove the radical $\\sqrt{7}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{7}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3}}{\\sqrt{7}} & = \\\\ \\frac{\\sqrt{3}}{\\sqrt{7}}\\cdot \\frac{\\sqrt{7}}{\\sqrt{7}} & = \\\\ \\frac{\\sqrt{3}\\cdot \\sqrt{7}}{(\\sqrt{7})^{2}} & = \\\\ \\frac{\\sqrt{3}\\cdot \\sqrt{7}}{7} & \\end{aligned}\n$$\n\nNow, we use the product rule to simplify the numerator:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3}\\cdot \\sqrt{7}}{7} & = \\\\ \\frac{\\sqrt{3\\cdot 7}}{7} & = \\\\ \\frac{\\sqrt{21}}{7} & \\end{aligned}\n$$"} :step/id #uuid "052fe2c5-40e8-568d-a7e6-4596a024895e" :step/next {:db/id #edb/ref 17592186495204}} {:db/id #edb/ref 17592186495204 :step/content {:db/id #edb/ref 17592186495047 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b1b5fba-fdd8-5128-9a27-cbfb26a9e1c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\sqrt{5}}{5}" :db/id #edb/ref 17592186494634} {:answer/id #uuid "a519e98f-6574-52d8-8a8c-870b9a1a0093" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{15}}{5}" :db/id #edb/ref 17592186494694} {:answer/id #uuid "aabd3a95-2d4e-5129-96fc-6ea2f3661cd0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{15}" :db/id #edb/ref 17592186494712} {:answer/id #uuid "e7a916dc-cd3b-563d-8a31-4a98472fc173" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{30}}{5}" :db/id #edb/ref 17592186494867} {:answer/id #uuid "e7d7cf72-8c4a-588a-92d9-55fa1de43c10" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{5}" :db/id #edb/ref 17592186494868}] :answer-field/correct {:db/id #edb/ref 17592186494694} :answer-field/id #uuid "a8d63188-077b-53b4-bf34-059f17e831ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494996}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0166b33d-cd65-51f2-b6e7-3a4bfb8c5ea3" :question/math-academy-id "q-68979" :question/problem "$\\frac{\\sqrt{3}}{\\sqrt{5}}=$" :question/worked-solution "To remove the radical $\\sqrt{5}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{5}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3}}{\\sqrt{5}} & = \\\\ \\frac{\\sqrt{3}}{\\sqrt{5}}\\cdot \\frac{\\sqrt{5}}{\\sqrt{5}} & = \\\\ \\frac{\\sqrt{3}\\cdot \\sqrt{5}}{(\\sqrt{5})^{2}} & = \\\\ \\frac{\\sqrt{3}\\cdot \\sqrt{5}}{5} & \\end{aligned}\n$$\n\nNow, we use the product rule to simplify the numerator:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3}\\cdot \\sqrt{5}}{5} & = \\\\ \\frac{\\sqrt{3\\cdot 5}}{5} & = \\\\ \\frac{\\sqrt{15}}{5} & \\end{aligned}\n$$"} :step/id #uuid "61942193-2d0a-56bf-a25c-0114eb566388"} {:db/id #edb/ref 17592186495212 :step/content {:db/id #edb/ref 17592186495091 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08ba6809-48d6-572e-a887-ee445eb17ac5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\sqrt{3}}{5}" :db/id #edb/ref 17592186494341} {:answer/id #uuid "9541ae86-02b9-5a82-a43c-89a200374f23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\sqrt{3}" :db/id #edb/ref 17592186494660} {:answer/id #uuid "e1e2d6be-e1f7-5b7f-b3e5-50ad0be9ac8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{5}" :db/id #edb/ref 17592186494854} {:answer/id #uuid "e294048f-eaaa-5e29-aeaf-312c92a62877" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{15}}{5}" :db/id #edb/ref 17592186494858} {:answer/id #uuid "eafd7840-0948-5dc2-99ff-617d14233294" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186494875}] :answer-field/correct {:db/id #edb/ref 17592186494854} :answer-field/id #uuid "8e4335f4-0a43-52eb-920e-e7c8066542cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494981}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6053c699-eed7-5f85-aa40-b59fc9957b5c" :question/math-academy-id "q-68973" :question/problem "$\\frac{3}{5\\sqrt{3}}=$" :question/worked-solution "To remove the radical $\\sqrt{3}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{3}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{3}{5\\sqrt{3}} & = \\\\ \\frac{3}{5\\sqrt{3}}\\cdot \\frac{\\sqrt{3}}{\\sqrt{3}} & = \\\\ \\frac{3\\sqrt{3}}{5\\cdot (\\sqrt{3})^{2}} & = \\\\ \\frac{3\\sqrt{3}}{5\\cdot 3} & = \\\\ \\frac{\\sqrt{3}}{5} & \\end{aligned}\n$$"} :step/id #uuid "707ae3ed-9b4d-5300-a0d5-6ced1c7337f1" :step/next {:db/id #edb/ref 17592186495179}}] :activity/title "Rationalizing Denominators" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186494302}] [{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186139486} :activity/id #uuid "63522699-6803-576b-82ed-8d88d13eba2f" :activity/scope {:db/id #edb/ref 17592186049047 :topic/id #uuid "d5a8629a-110d-5d05-beb7-159e81536910" :topic/math-academy-id 2244} :activity/steps [{:db/id #edb/ref 17592186139486 :step/content {:db/id #edb/ref 17592186139661 :tutorial/content "Suppose that we want to simplify the following expression: \n\n$$\n2+\\dfrac{5}{2}x -5 + \\dfrac{7}{2}x.\n$$\n\n  \n\nWe begin by collecting like terms.\n\n$$\n\\begin{aligned}(\\frac{5}{2}x+\\frac{7}{2}x)+(2-5)\\end{aligned}\n$$\n\nThen, we combine the like terms, simplifying the coefficients as much as possible.\n\n$$\n\\begin{aligned}(\\frac{5}{2}x+\\frac{7}{2}x)+(2-5) & = \\\\ (\\frac{5+7}{2})x+(-3) & = \\\\ \\frac{12}{2}x-3 & = \\\\ 6x-3 & .\\end{aligned}\n$$\n\nThus, the simplified expression is $6x-3.$" :tutorial/id #uuid "7ef8a0d2-a9fe-57f8-b3fc-7b69cbb3a818" :tutorial/math-academy-id 8040 :tutorial/title "Introduction"} :step/id #uuid "3cca408f-980b-5a63-a54c-03cd0d86a422" :step/math-academy-id 71207 :step/next {:db/id #edb/ref 17592186139487}} {:db/id #edb/ref 17592186139487 :step/content {:db/id #edb/ref 17592186138510 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138069 :question/id #uuid "e85da1d1-1cf3-547c-86ce-42329475fbdd" :question/math-academy-id "e-12835"} :knowledge-point/id #uuid "54498b47-9a43-5b4d-8bbf-806af5968829" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050311} {:db/id #edb/ref 17592186050452} {:db/id #edb/ref 17592186050833}] :knowledge-point/questions [{:db/id #edb/ref 17592186138716} {:db/id #edb/ref 17592186138809} {:db/id #edb/ref 17592186459206} {:db/id #edb/ref 17592186459226}] :knowledge-point/title "Simplifying Fractions with Like Denominators"} :step/id #uuid "24f9787a-6b3b-581b-a228-064feb6d711c" :step/math-academy-id 71208 :step/next {:db/id #edb/ref 17592186139488}} {:db/id #edb/ref 17592186139488 :step/content {:db/id #edb/ref 17592186138511 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138071 :question/id #uuid "53c1f7ca-bcaa-59e4-9929-0695b67621cb" :question/math-academy-id "e-12837"} :knowledge-point/id #uuid "75d096f5-9834-5e52-a7eb-9aae72398d19" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050131} {:db/id #edb/ref 17592186050637}] :knowledge-point/questions [{:db/id #edb/ref 17592186138816} {:db/id #edb/ref 17592186138817} {:db/id #edb/ref 17592186459205} {:db/id #edb/ref 17592186459293} {:db/id #edb/ref 17592186536857} {:db/id #edb/ref 17592186542142}] :knowledge-point/title "Simplifying Fractions with Unlike Denominators"} :step/id #uuid "aae03f7b-9f94-5281-8d40-eddd120590d8" :step/math-academy-id 71212 :step/next {:db/id #edb/ref 17592186139489}} {:db/id #edb/ref 17592186139489 :step/content {:db/id #edb/ref 17592186138512 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138070 :question/id #uuid "30cf0891-33d3-566c-8286-4c161f84c1dd" :question/math-academy-id "e-12836"} :knowledge-point/id #uuid "dec4e22a-5882-56d9-8e13-b18b4d22efdc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050599} {:db/id #edb/ref 17592186050908}] :knowledge-point/questions [{:db/id #edb/ref 17592186138760} {:db/id #edb/ref 17592186138779} {:db/id #edb/ref 17592186544873}] :knowledge-point/title "Using the Distributive Law With Fractions"} :step/id #uuid "1036460b-f34d-54e4-a730-f0b57e843495" :step/math-academy-id 71216 :step/next {:db/id #edb/ref 17592186139490}} {:db/id #edb/ref 17592186139490 :step/content {:db/id #edb/ref 17592186138513 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138072 :question/id #uuid "957b3102-6eb7-52d3-9299-54ed9bd4718e" :question/math-academy-id "e-12892"} :knowledge-point/id #uuid "e3e39a9d-1f97-54f2-a388-90c71c83b93e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050575}] :knowledge-point/questions [{:db/id #edb/ref 17592186138818} {:db/id #edb/ref 17592186139065} {:db/id #edb/ref 17592186459228} {:db/id #edb/ref 17592186459288}] :knowledge-point/title "Simplifying Expressions Using the Distributive Law"} :step/id #uuid "4e4a8574-0322-564e-8108-20569dba02f5" :step/math-academy-id 71219}] :activity/title "Simplifying Linear Expressions Containing Fractions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186138596}] [{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186069730} :activity/id #uuid "74c085db-a02d-55d0-a9c6-2ff188739b10" :activity/scope {:db/id #edb/ref 17592186049181 :topic/id #uuid "e176f8f6-a3bc-5ea6-89d2-2202d9d89fd7" :topic/math-academy-id 423} :activity/steps [{:db/id #edb/ref 17592186069730 :step/content {:db/id #edb/ref 17592186069927 :tutorial/content "To simplify a rational expression, we cancel out the largest common factor from the numerator and denominator. To do this, we sometimes need to factor the numerator and denominator before canceling.\n\nFor example, suppose that we wish to simplify $\\dfrac {4x - 12} {10x + 4}.$ To do this, we factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\eqalign{\n\t\t\\dfrac {4x - 12} {10x + 4}\n\t\t&=\\dfrac {4(x - 3)} {2(5x + 2)}\\[5pt]\n&=\\dfrac {2 \\cdot 2 \\cdot (x - 3)} {2(5x + 2)}\\[5pt]\t\t\n\t\t&=\\dfrac {\\cancel{2} \\cdot 2(x - 3)} {\\cancel{2}(5x + 2)}\\[5pt]\t\n\t\t&=\\dfrac {2(x - 3)} {5x + 2}\n\t}\n$$" :tutorial/id #uuid "332f534f-811e-5c03-8393-560134dd4ea8" :tutorial/math-academy-id 1370 :tutorial/title "Introduction"} :step/id #uuid "818bd86a-fb35-5a26-8a36-9ee10c0aa1c5" :step/math-academy-id 2850 :step/next {:db/id #edb/ref 17592186069869}} {:db/id #edb/ref 17592186069731 :step/content {:db/id #edb/ref 17592186068805 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068653 :question/id #uuid "3df1f00a-3a87-5db7-83c5-d47dce633bf9" :question/math-academy-id "e-843"} :knowledge-point/id #uuid "6a17d9d6-cd3a-554e-98d2-7e9536950bd0" :knowledge-point/questions [{:db/id #edb/ref 17592186069273} {:db/id #edb/ref 17592186069446} {:db/id #edb/ref 17592186480645} {:db/id #edb/ref 17592186480703} {:db/id #edb/ref 1759