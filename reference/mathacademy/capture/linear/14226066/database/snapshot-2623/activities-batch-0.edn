#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186065191} :activity/id #uuid "47f4640b-e4b7-5133-a3a1-63ce3b9d9596" :activity/scope {:db/id #edb/ref 17592186048180 :topic/id #uuid "863badb9-fd80-557c-8deb-101ce376c451" :topic/math-academy-id 374} :activity/steps [{:db/id #edb/ref 17592186065191 :step/content {:db/id #edb/ref 17592186065337 :tutorial/content "The **quotient rule for exponents** states that when we divide two exponents that have the same base, we take the difference of the exponents in the numerator and denominator:\n\n$$\n\\dfrac{a^n}{a^m}=a^{n-m}\n$$\n\nFor example, \n\n$$\n\\begin{aligned}\\frac{{a}^{5}}{{a}^{2}} & = \\\\ {a}^{(5-2)} & = \\\\ {a}^{3}.\\end{aligned}\n$$\n\nTo see why the quotient rule is true, let's take the above example and work it out again, the long way.\n\nFor the two terms $a^5$ and $a^2$ we have $a^5 = a \\cdot a \\cdot a \\cdot a \\cdot a$ and $a^2 = a \\cdot a.$ If we now substitute these two expressions into $\\dfrac{a^5}{a^2},$ we get the same result:\n\n$$\n\\require{cancel}\n\\eqalign{\n\\dfrac{a^{5}}{a^2}&=\\\n\\dfrac {a \\cdot a \\cdot a \\cdot a \\cdot a} {a \\cdot a}&=\\\n\\dfrac {\\cancel{a} \\cdot \\cancel{a} \\cdot a \\cdot a \\cdot a} {\\cancel{a} \\cdot \\cancel{a} }&=\\\na \\cdot a \\cdot a &=\\\n a^3\n}\n$$\n\nThe quotient rule is just a shortcut for the process above." :tutorial/id #uuid "5ce1b58b-8395-5986-99e6-cfd10bbca653" :tutorial/math-academy-id 1478 :tutorial/title "Introduction"} :step/id #uuid "6663dad9-c326-5db6-92b4-d33b07b35ae2" :step/math-academy-id 3518 :step/next {:db/id #edb/ref 17592186065192}} {:db/id #edb/ref 17592186065192 :step/content {:db/id #edb/ref 17592186064298 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063919 :question/id #uuid "46a52c71-86ed-5e9c-a1cb-f2110a4c6484" :question/math-academy-id "e-1073"} :knowledge-point/id #uuid "577ff555-4622-5388-8bc3-b49fa39c5674" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049081} {:db/id #edb/ref 17592186051009}] :knowledge-point/questions [{:db/id #edb/ref 17592186064748} {:db/id #edb/ref 17592186064914} {:db/id #edb/ref 17592186485583}] :knowledge-point/title "Applying the Quotient Rule for Exponents"} :step/id #uuid "f2b04881-6bc8-5920-904c-e6ab5ed0bea7" :step/math-academy-id 3522 :step/next {:db/id #edb/ref 17592186065193}} {:db/id #edb/ref 17592186065193 :step/content {:db/id #edb/ref 17592186064299 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063920 :question/id #uuid "d09010dc-a725-5d22-91ba-cb4372187dbc" :question/math-academy-id "e-1074"} :knowledge-point/id #uuid "c099e644-e8e1-5889-a228-af1e38fff0f7" :knowledge-point/questions [{:db/id #edb/ref 17592186064756} {:db/id #edb/ref 17592186064915} {:db/id #edb/ref 17592186485532} {:db/id #edb/ref 17592186485567} {:db/id #edb/ref 17592186485581} {:db/id #edb/ref 17592186541121} {:db/id #edb/ref 17592186541132}] :knowledge-point/title "Applying the Quotient Rule with Negative Exponents"} :step/id #uuid "e5df8da7-4ba5-5203-9fe1-9d3c0405217c" :step/math-academy-id 3524 :step/next {:db/id #edb/ref 17592186065194}} {:db/id #edb/ref 17592186065194 :step/content {:db/id #edb/ref 17592186064300 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063921 :question/id #uuid "a8d19b4c-5361-5520-b0c9-7f6667b6a1c4" :question/math-academy-id "e-1075"} :knowledge-point/id #uuid "fd5f2545-503b-503c-a1e6-294bfe966b2a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049729}] :knowledge-point/questions [{:db/id #edb/ref 17592186064879} {:db/id #edb/ref 17592186064916} {:db/id #edb/ref 17592186485491} {:db/id #edb/ref 17592186485494} {:db/id #edb/ref 17592186485519} {:db/id #edb/ref 17592186485553} {:db/id #edb/ref 17592186485592}] :knowledge-point/title "Applying the Quotient Rule and Product Rule"} :step/id #uuid "f852560e-1702-515d-ab85-f06ccdd54d76" :step/math-academy-id 3526}] :activity/title "The Quotient Rule for Exponents With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064459}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186541199} :activity/id #uuid "5d6c1c0e-f983-5e65-b79a-777868d3866c" :activity/scope {:db/id #edb/ref 17592186048180 :topic/id #uuid "863badb9-fd80-557c-8deb-101ce376c451" :topic/math-academy-id 374} :activity/steps [{:db/id #edb/ref 17592186541177 :step/content {:db/id #edb/ref 17592186541132 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "033f434c-3046-522b-94a4-81632e4a755b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10s" :db/id #edb/ref 17592186540528} {:answer/id #uuid "0669641e-b96f-5124-91fb-7e3c660ead50" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{s}^{10}" :db/id #edb/ref 17592186540532} {:answer/id #uuid "1fa5ccc7-24c9-5135-a04c-ae8d18034a81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{s}^{-8}" :db/id #edb/ref 17592186540582} {:answer/id #uuid "9b484352-7629-5375-b0d9-77b6e261a631" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{s}^{8}" :db/id #edb/ref 17592186540787} {:answer/id #uuid "bfe5339b-4cf2-565b-bfa0-c3cc78a6ca4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{s}^{-10}" :db/id #edb/ref 17592186540848}] :answer-field/correct {:db/id #edb/ref 17592186540532} :answer-field/id #uuid "59feceec-a624-5628-a381-c6600e83fb86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540982}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cd8ebbf6-3c12-5a7b-94b3-133315a02160" :question/math-academy-id "q-72663" :question/problem "Simplify $\\frac{{s}^{9}}{{s}^{-1}}.$" :question/worked-solution "We subtract the exponents, as follows:\n\n$$\n\\begin{aligned}\\frac{{s}^{9}}{{s}^{-1}} & = \\\\ {s}^{9-(-1)} & = \\\\ {s}^{9+1} & = \\\\ {s}^{10}\\end{aligned}\n$$"} :step/id #uuid "44bd68f9-76d7-5671-a775-367b392cc8a1"} {:db/id #edb/ref 17592186541188 :step/content {:db/id #edb/ref 17592186541121 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "485bb920-75f2-543e-86f4-7307fb235081" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{n}^{3}" :db/id #edb/ref 17592186540656} {:answer/id #uuid "6a59e3c7-6cc7-57d1-83cd-69c5dbfbe731" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{n}^{13}" :db/id #edb/ref 17592186540710} {:answer/id #uuid "6e2b3ab7-1898-5a6d-8d35-dbd1960d63c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{n}^{-13}" :db/id #edb/ref 17592186540718} {:answer/id #uuid "db1cdde4-94b3-556e-a937-442da7328c61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3n" :db/id #edb/ref 17592186540900} {:answer/id #uuid "e0536911-917d-575c-bc7b-8d68f8630efd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{n}^{-3}" :db/id #edb/ref 17592186540909}] :answer-field/correct {:db/id #edb/ref 17592186540710} :answer-field/id #uuid "8ff7302a-d542-53c0-aaea-5d54a18a01b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186541002}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b49d548d-fbc0-53b0-baae-b58e91b84e6d" :question/math-academy-id "q-72662" :question/problem "Simplify $\\frac{{n}^{8}}{{n}^{-5}}.$" :question/worked-solution "We subtract the exponents, as follows:\n\n$$\n\\begin{aligned}\\frac{{n}^{8}}{{n}^{-5}} & = \\\\ {n}^{8-(-5)} & = \\\\ {n}^{8+5} & = \\\\ {n}^{13}\\end{aligned}\n$$"} :step/id #uuid "63a707cc-e9d2-5550-a3aa-e671c780ce3a" :step/next {:db/id #edb/ref 17592186541177}} {:db/id #edb/ref 17592186541199 :step/content {:db/id #edb/ref 17592186064915 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bd4b6b6-0e75-5946-aa7b-a2c81e452a26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{3}" :db/id #edb/ref 17592186540663} {:answer/id #uuid "68de499e-e383-5af5-926d-9c7ff8a7a14b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{{x}^{3}}" :db/id #edb/ref 17592186540706} {:answer/id #uuid "8a64610d-8f33-596a-ae2d-6e4a4d1ac047" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{5}" :db/id #edb/ref 17592186540761} {:answer/id #uuid "93fcd4ad-0d95-5822-9f9a-c6e995d03ab5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{7}" :db/id #edb/ref 17592186540776} {:answer/id #uuid "eab6a494-8ff8-5e33-97a0-efc477f7317e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{{x}^{7}}" :db/id #edb/ref 17592186540924}] :answer-field/correct {:db/id #edb/ref 17592186540663} :answer-field/id #uuid "27ae64f1-6b7b-57f5-a135-05c6e56fbe63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186063546}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8f4b0e01-d481-5aba-819f-1e32b934467a" :question/math-academy-id "q-60574" :question/problem "Simplify $\\frac{{x}^{-2}}{{x}^{-5}}.$" :question/worked-solution "We subtract the exponents, as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{-2}}{{x}^{-5}} & = \\\\ {x}^{-2-(-5)} & = \\\\ {x}^{-2+5} & = \\\\ {x}^{3} & \\end{aligned}\n$$"} :step/id #uuid "89f73a27-148a-57cb-b909-46d5f29e59d3" :step/next {:db/id #edb/ref 17592186541188}}] :activity/title "The Quotient Rule for Exponents With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186540519}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186180639} :activity/id #uuid "39af6225-7719-5f09-ae8c-6df89ff6b7cd" :activity/scope {:db/id #edb/ref 17592186048280 :topic/id #uuid "900f65f4-ad2b-51fa-b027-f2b2cba3065b" :topic/math-academy-id 3754} :activity/steps [{:db/id #edb/ref 17592186180639 :step/content {:db/id #edb/ref 17592186180661 :tutorial/content "If we start with the formula\n\n$$\n\\textrm{percentage}\\times \\textrm{whole} = \\textrm{part} ,\n$$\n\nwe can use the relationship between multiplication and division to write down a formula to calculate a percentage:\n\n$$\n\\textrm{percentage} = \\textrm{part} \\div \\textrm{whole}\n$$\n\nLet's demonstrate how to apply this formula using a real-world example.\n\nSuppose that $54$ out of $300$ boxes of grapes in a supermarket contain red grapes. What percentage of the boxes contain red grapes?\n\nIn this case, the part is the number of red grapes, which is $54$, and the whole is the total number of grapes, which is $300.$\n\nSubstituting our numbers into the above formula, we get\n\n$$\n\\textrm{percentage} = 54 \\div 300 = \\dfrac{54}{300}.\n$$\n\nTo write this fraction as a percentage, we create an equivalent fraction with $100$ as the denominator:\n\n$$\n\\dfrac{54}{300} = \\dfrac{54 \\div 3}{300 \\div 3} = \\dfrac{18}{100}\n$$\n\nNow we can write this fraction as a percentage:\n\n$$\n\\dfrac{18}{100} = 18 \\%\n$$\n\nTherefore, $18 \\%$ of the boxes contain red grapes." :tutorial/id #uuid "73bca8be-ae46-5214-9ba6-2beb553be49f" :tutorial/math-academy-id 2082 :tutorial/title "Introduction"} :step/id #uuid "bdf65be2-4038-5c62-b8e0-2362d10939cc" :step/math-academy-id 7964 :step/next {:db/id #edb/ref 17592186180640}} {:db/id #edb/ref 17592186180640 :step/content {:db/id #edb/ref 17592186179819 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179496 :question/id #uuid "75ac9866-6b0f-5736-a592-0bade16b8814" :question/math-academy-id "e-2333"} :knowledge-point/id #uuid "ddf13639-8d18-5909-a26d-aeda1e011ac0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050776}] :knowledge-point/questions [{:db/id #edb/ref 17592186180240} {:db/id #edb/ref 17592186180243} {:db/id #edb/ref 17592186459213} {:db/id #edb/ref 17592186459256} {:db/id #edb/ref 17592186538994}] :knowledge-point/title "Finding a Missing Percent Given Two Numbers Without Simplification"} :step/id #uuid "2a3797e0-441d-5d87-adba-4fa2a33a82b4" :step/math-academy-id 7965 :step/next {:db/id #edb/ref 17592186180641}} {:db/id #edb/ref 17592186180641 :step/content {:db/id #edb/ref 17592186179820 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179497 :question/id #uuid "2f3270cc-d191-5282-b9f7-cf63dcd69d70" :question/math-academy-id "e-2334"} :knowledge-point/id #uuid "6f67408f-f019-5365-b4a0-6f60ac23cc1d" :knowledge-point/questions [{:db/id #edb/ref 17592186180242} {:db/id #edb/ref 17592186180244} {:db/id #edb/ref 17592186459298} {:db/id #edb/ref 17592186459309} {:db/id #edb/ref 17592186544865}] :knowledge-point/title "Finding a Missing Percent Given Two Numbers Using Simplification"} :step/id #uuid "d0c640ea-bd66-5449-a695-d9913915d65f" :step/math-academy-id 7966}] :activity/title "Finding a Percentage Given Two Numbers: Word Problems" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179897}] [{:activity/expected-seconds 960.0 :activity/first-step {:db/id #edb/ref 17592186065119} :activity/id #uuid "56a150ec-8529-5db2-95d7-052f09baf4bc" :activity/scope {:db/id #edb/ref 17592186048375 :topic/id #uuid "9a4e8d0a-b62a-512a-8fb3-08502110771a" :topic/math-academy-id 372} :activity/steps [{:db/id #edb/ref 17592186065119 :step/content {:db/id #edb/ref 17592186065449 :tutorial/content "In a previous lesson, we learned how to factor quadratic trinomials whose quadratic coefficient equals one. In this lesson, we'll extend our understanding to include cases where the quadratic coefficient is a positive integer that's different from one.\n\nFor example, let's factor the following trinomial:\n\n$$\n{\\color{red}{2}}x^2+{\\color{purple}{7}}x+{\\color{blue}{3}}\n$$\n\n \n\nNotice that the quadratic coefficient equals ${\\color{red}{2}}.$\n\nTo factor this trinomial, we must find two numbers that \n\n- *multiply* to give the *product* of the quadratic coefficient and the constant $({\\color{red}{2}} \\times {\\color{blue}{3}} = 6),$ and\n\n- *add* to give the linear coefficient $({\\color{purple}{7}})$.\n\nWe can factor this trinomial in four steps:\n\n- **Step 1:**  We start by writing down the factor pairs of $6{:}$\n\nThe factor pairs of $6$ are\n\n$$\n(1,6), \\qquad (2,3).\n$$\n\n- **Step 2:**  Determine which of these factor pairs add up to the coefficient of the linear term $({\\color{purple}{7}})\\mathbin{:}$\n\n$$\n\\begin{aligned}1+6 & =7 & ✓ \\\\ 2+3 & =5 & \\times \\end{aligned}\n$$\n\n- **Step 3:**  Using the factor pair identified in the previous step, write the linear term as $7x=x+6x\\mathbin{:}$\n\n$$\n\\begin{aligned}2{x}^{2}+7x+3 & = \\\\ 2{x}^{2}+x+6x+3\\end{aligned}\n$$\n\n- **Step 4:**  Factor the first two terms and the last two terms separately and then factor the expression completely:\n\n$$\n\\begin{aligned}2{x}^{2}+x+6x+3 & = \\\\ x(2x+1)+3(2x+1) & = \\\\ (2x+1)(x+3).\\end{aligned}\n$$\n\nAnd we're done! \n\nWe can check that our answer is correct by expanding the parentheses:\n\n$$\n\\begin{aligned}(2x+1)(x+3) & = \\\\ 2x\\cdot (x+3)+1\\cdot (x+3) & = \\\\ 2{x}^{2}+6x+x+3 & = \\\\ 2{x}^{2}+7x+3 & \\,✓\\end{aligned}\n$$" :tutorial/id #uuid "f7e6d3a2-936b-5775-9cf9-10135f0e6486" :tutorial/math-academy-id 9455 :tutorial/title "Introduction"} :step/id #uuid "c655bc80-5885-54d2-8a94-0ad9c1a41019" :step/math-academy-id 177992 :step/next {:db/id #edb/ref 17592186065120}} {:db/id #edb/ref 17592186065120 :step/content {:db/id #edb/ref 17592186064247 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064002 :question/id #uuid "44cf8c85-f228-5eaa-922d-613355cb7d5b" :question/math-academy-id "e-15070"} :knowledge-point/id #uuid "7f6a7917-f877-5263-abea-a78c0707d9fc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049074}] :knowledge-point/questions [{:db/id #edb/ref 17592186064476} {:db/id #edb/ref 17592186064577} {:db/id #edb/ref 17592186064613} {:db/id #edb/ref 17592186483430}] :knowledge-point/title "Factoring Trinomial With Positive Coefficients"} :step/id #uuid "462ef775-e55e-588f-acaf-4bf8f7bdc2df" :step/math-academy-id 177993 :step/next {:db/id #edb/ref 17592186065121}} {:db/id #edb/ref 17592186065121 :step/content {:db/id #edb/ref 17592186064248 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064004 :question/id #uuid "35bedd9f-bcb7-5024-bfe7-5ef6d34518bc" :question/math-academy-id "e-15073"} :knowledge-point/id #uuid "8cfe2121-66f0-53fa-b744-041fe830bf13" :knowledge-point/questions [{:db/id #edb/ref 17592186064617} {:db/id #edb/ref 17592186064695} {:db/id #edb/ref 17592186064751} {:db/id #edb/ref 17592186483365} {:db/id #edb/ref 17592186483415}] :knowledge-point/title "Factoring Trinomials With Negative Constants"} :step/id #uuid "1a35042e-19b9-53df-b251-f234f0733094" :step/math-academy-id 177997 :step/next {:db/id #edb/ref 17592186065122}} {:db/id #edb/ref 17592186065122 :step/content {:db/id #edb/ref 17592186065450 :tutorial/content "To factor a quadratic expression, we must find a factor pair of the *product* of the quadratic coefficient and the constant that adds to the linear coefficient.\n\nWith that in mind, let's factor the following trinomial:\n\n$$\n{\\color{red}{2}}y^2 {\\color{purple}{\\,-\\,7}}y + {\\color{blue}{3}}\n$$\n\nNotice that,\n\n- the product of the quadratic coefficient and the constant, ${\\color{red}{2}} \\times {\\color{blue}{3}} = 6$, is *positive*, while\n\n- the coefficient of the linear term $({\\color{purple}{-7}})$ is *negative*.\n\nSince the linear coefficient is negative and the product of the quadratic coefficient and constant is positive, we need to consider the *negative* factor pairs of $6.$\n\nThe negative factor pairs of $6$ are\n\n$$\n(-1,-6), \\quad (-2,-3).\n$$\n\nFor each pair, their *product* is positive, and their sum is *negative*, which is what we want.\n\nNow, we determine which of these factor pairs sums to the coefficient of the linear term $({\\color{purple}{-7}}){:}$\n\n$$\n\\begin{aligned}(-1)+(-6) & =-7\\,✓ \\\\ (-2)+(-3) & =-5\\,\\times \\end{aligned}\n$$\n\nThen, we write the linear term as $-y - 6y,$ and factor the result by grouping:\n\n$$\n\\begin{aligned}2{y}^{2}-7y+3 & = \\\\ 2{y}^{2}-y-6y+3 & = \\\\ (2{y}^{2}-y)-(6y-3) & = \\\\ y(2y-1)-3(2y-1) & = \\\\ (y-3)(2y-1) & \\end{aligned}\n$$" :tutorial/id #uuid "5ff88dae-40df-5a63-a7bd-0d73317e94a4" :tutorial/math-academy-id 9506 :tutorial/title "Trinomials With Negative Linear Coefficients and Positive Constants"} :step/id #uuid "412ba190-4d83-5be1-abb2-91fae26ca40e" :step/math-academy-id 178001 :step/next {:db/id #edb/ref 17592186065123}} {:db/id #edb/ref 17592186065123 :step/content {:db/id #edb/ref 17592186064249 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064003 :question/id #uuid "ad032833-ecf8-5295-9a9f-f69f759c19b0" :question/math-academy-id "e-15072"} :knowledge-point/id #uuid "0d5115f8-05b7-5df5-92b1-b4faa95f8449" :knowledge-point/questions [{:db/id #edb/ref 17592186064614} {:db/id #edb/ref 17592186064615} {:db/id #edb/ref 17592186064616} {:db/id #edb/ref 17592186483361}] :knowledge-point/title "Factoring Trinomials With Negative Coefficients and Positive Constants"} :step/id #uuid "e94449ef-31f1-5a5f-b3b9-9cc8fc6af17b" :step/math-academy-id 178002}] :activity/title "Factoring Trinomials With Leading Coefficients" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064458}] [{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186065071} :activity/id #uuid "51fdec6a-c844-517d-b568-514facdec359" :activity/scope {:db/id #edb/ref 17592186048422 :topic/id #uuid "9dd30f5e-90f1-5ed7-bd60-9c0dea37e1e2" :topic/math-academy-id 349} :activity/steps [{:db/id #edb/ref 17592186065071 :step/content {:db/id #edb/ref 17592186065439 :tutorial/content "To expand an expression like   \n\n![](images/cd/cd1928f00c75236e8749153ea82e10efd3fc88d435eb095a940215337086e8a9.svg)  \n\nwe can use the distributive law. We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:  \n\n![](images/22/225564303e86ce4bce242c66c78434d94114de43c144933d6cadda2b718cfbc9.svg)" :tutorial/id #uuid "3d4f07a3-afec-5d4a-a881-ea0271831a54" :tutorial/math-academy-id 8871 :tutorial/title "Introduction"} :step/id #uuid "9adebaa0-c60d-5909-ab40-deaebd964a20" :step/math-academy-id 165334 :step/next {:db/id #edb/ref 17592186065072}} {:db/id #edb/ref 17592186065072 :step/content {:db/id #edb/ref 17592186064214 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063984 :question/id #uuid "7361c770-5274-5ed2-8366-e4b7ba21ff9f" :question/math-academy-id "e-14301"} :knowledge-point/id #uuid "4677d3e7-6833-514c-b035-0a7bbf0495fc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048661} {:db/id #edb/ref 17592186049729}] :knowledge-point/questions [{:db/id #edb/ref 17592186064597} {:db/id #edb/ref 17592186064898} {:db/id #edb/ref 17592186064900} {:db/id #edb/ref 17592186481351} {:db/id #edb/ref 17592186481428}] :knowledge-point/title "Multiplying Polynomials"} :step/id #uuid "e3510aa7-0d8b-5b73-ba73-c850214d0a6a" :step/math-academy-id 165335 :step/next {:db/id #edb/ref 17592186065073}} {:db/id #edb/ref 17592186065073 :step/content {:db/id #edb/ref 17592186064215 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063985 :question/id #uuid "e8968548-b5a7-55c9-af2e-48aecb217cc6" :question/math-academy-id "e-14304"} :knowledge-point/id #uuid "c0f2a4f3-5117-5796-b35c-524c1e0514cb" :knowledge-point/questions [{:db/id #edb/ref 17592186064475} {:db/id #edb/ref 17592186064598} {:db/id #edb/ref 17592186064899} {:db/id #edb/ref 17592186481342} {:db/id #edb/ref 17592186481346} {:db/id #edb/ref 17592186490289} {:db/id #edb/ref 17592186544809}] :knowledge-point/title "Cases Containing Two Negative Signs"} :step/id #uuid "563f7cac-b98f-5187-bde3-7740505dfe4c" :step/math-academy-id 165339 :step/next {:db/id #edb/ref 17592186065074}} {:db/id #edb/ref 17592186065074 :step/content {:db/id #edb/ref 17592186064216 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063986 :question/id #uuid "0317d27d-9501-5de5-a55a-b9a73ce39500" :question/math-academy-id "e-14306"} :knowledge-point/id #uuid "eb972b0c-3ca7-5d79-83f9-162ea8d4076e" :knowledge-point/questions [{:db/id #edb/ref 17592186064599} {:db/id #edb/ref 17592186064600} {:db/id #edb/ref 17592186064738} {:db/id #edb/ref 17592186481368} {:db/id #edb/ref 17592186481401} {:db/id #edb/ref 17592186490282}] :knowledge-point/title "Multiplying Polynomials Containing Fractions"} :step/id #uuid "70b3ff64-4fc4-5140-b269-757b73a994ec" :step/math-academy-id 165343 :step/next {:db/id #edb/ref 17592186065075}} {:db/id #edb/ref 17592186065075 :step/content {:db/id #edb/ref 17592186064217 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063987 :question/id #uuid "7e3162ad-ed76-548d-a020-142ea0c0976b" :question/math-academy-id "e-14309"} :knowledge-point/id #uuid "a437f9a3-60c1-563d-bd6d-1816d14ffe6e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048661}] :knowledge-point/questions [{:db/id #edb/ref 17592186064601} {:db/id #edb/ref 17592186064784} {:db/id #edb/ref 17592186064953} {:db/id #edb/ref 17592186481370} {:db/id #edb/ref 17592186490277}] :knowledge-point/title "Multiplying Multivariable Polynomials"} :step/id #uuid "9d9e5f05-8a30-5b09-b82f-b7e3a8735064" :step/math-academy-id 165347}] :activity/title "The Distributive Law for Polynomials" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064439}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186490336} :activity/id #uuid "d65a0de1-92e1-56c5-b358-49f6ba21fa25" :activity/scope {:db/id #edb/ref 17592186048422 :topic/id #uuid "9dd30f5e-90f1-5ed7-bd60-9c0dea37e1e2" :topic/math-academy-id 349} :activity/steps [{:db/id #edb/ref 17592186490336 :step/content {:db/id #edb/ref 17592186490277 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1383eea4-8385-5b80-a00d-bc4a381cec34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{x}^{3}+6x" :db/id #edb/ref 17592186489557} {:answer/id #uuid "469c4db6-332e-52b7-9453-76a3e2e8733c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{x}^{3}y+6xy" :db/id #edb/ref 17592186489677} {:answer/id #uuid "80fd8b82-26bf-59a6-af6c-1efba9feb3e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{x}^{3}y+3x" :db/id #edb/ref 17592186489808} {:answer/id #uuid "f38cbb7a-75fa-5860-832a-bf4ea3489c86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{x}^{3}y+6x" :db/id #edb/ref 17592186490039} {:answer/id #uuid "f4ba294a-378d-5da9-9fd9-e632d9345e57" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{x}^{3}y+2" :db/id #edb/ref 17592186490043}] :answer-field/correct {:db/id #edb/ref 17592186490039} :answer-field/id #uuid "7d5fa659-d7d1-55a1-83c5-184b6ed1af7f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490145}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9cfc88f5-5c61-5b90-beb5-64a3476a024f" :question/math-academy-id "q-44727" :question/problem "$3x({x}^{2}y+2)=$" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}3x({x}^{2}y+2) & = \\\\ 3x({x}^{2}y)+3x(2) & = \\\\ 3\\cdot {x}^{2+1}y+6x & = \\\\ 3{x}^{3}y+6x\\end{aligned}\n$$"} :step/id #uuid "0bc8636c-0807-5847-a5a8-7748bf0a3cfb" :step/next {:db/id #edb/ref 17592186490359}} {:db/id #edb/ref 17592186490359 :step/content {:db/id #edb/ref 17592186490289 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10618d86-2776-5cce-97a6-7ca9e920abd5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}^{2}-3{a}^{4}+{a}^{5}" :db/id #edb/ref 17592186489553} {:answer/id #uuid "47ed6dd6-b0d1-5887-8326-53ee4a3b117a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{a}^{6}+2{a}^{4}+5{a}^{2}" :db/id #edb/ref 17592186489681} {:answer/id #uuid "4cfe73b4-b0e8-50ac-850e-f133bc075de3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2{a}^{6}+3{a}^{3}+6a" :db/id #edb/ref 17592186489696} {:answer/id #uuid "4ff82ea5-a53e-581b-bf6e-70bfe7b8756b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2{a}^{5}+3{a}^{2}+6{a}^{2}" :db/id #edb/ref 17592186489706} {:answer/id #uuid "f80efb83-27d0-51e9-bdfb-27593f4de169" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2{a}^{6}+3{a}^{4}+6{a}^{2}" :db/id #edb/ref 17592186490054}] :answer-field/correct {:db/id #edb/ref 17592186490054} :answer-field/id #uuid "f72b4150-b00a-5010-ad64-3981725c8bb1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490204}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aad55e06-4983-5ff1-b72a-41466f8cbb81" :question/math-academy-id "q-110835" :question/problem "$-{a}^{2}(2{a}^{4}-3{a}^{2}-6)=$" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}-{a}^{2}(2{a}^{4}-3{a}^{2}-6) & = \\\\ (-{a}^{2})(2{a}^{4})+(-{a}^{2})(-3{a}^{2})+(-{a}^{2})(-6) & = \\\\ ((-1)\\cdot 2)({a}^{2}\\cdot {a}^{4})+((-1)\\cdot (-3))({a}^{2}\\cdot {a}^{2})+((-1)\\cdot (-6))({a}^{2}) & = \\\\ (-2){a}^{2+4}+(3){a}^{2+2}+(6){a}^{2} & = \\\\ -2{a}^{6}+3{a}^{4}+6{a}^{2}\\end{aligned}\n$$"} :step/id #uuid "73a8d1dc-0fad-55c8-9ef4-adcb5e444d92" :step/next {:db/id #edb/ref 17592186490392}} {:db/id #edb/ref 17592186490392 :step/content {:db/id #edb/ref 17592186490282 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f663968-9914-51d2-a0d5-0de18327bcb2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-5{x}^{4}" :db/id #edb/ref 17592186489659} {:answer/id #uuid "aa8be593-a930-5092-b401-4276e53f4bb9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-\\frac{5{x}^{4}}{2}" :db/id #edb/ref 17592186489890} {:answer/id #uuid "aab4c61d-684a-5773-b4d6-164888798bb8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3x}{2}-5{x}^{4}" :db/id #edb/ref 17592186489891} {:answer/id #uuid "c9c56fc1-b117-576b-81a6-2f4abdab9754" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3x}{2}-\\frac{5{x}^{4}}{2}" :db/id #edb/ref 17592186489955} {:answer/id #uuid "f6bfd523-eab9-5a44-b230-8dd48c8d9b55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6x+5{x}^{4}" :db/id #edb/ref 17592186490049}] :answer-field/correct {:db/id #edb/ref 17592186489659} :answer-field/id #uuid "cc8bf450-8384-5183-8fd7-ee109eb1c278" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490181}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a0223a5d-a1d6-5c40-af63-e8dfd73551f8" :question/math-academy-id "q-111117" :question/problem "$\\frac{x}{2}(6-10{x}^{3})=$" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}\\frac{x}{2}(6-10{x}^{3}) & = \\\\ (\\frac{x}{2})(6)+(\\frac{x}{2})(-10{x}^{3}) & = \\\\ (\\frac{1}{2}x)(6)+(\\frac{1}{2}x)(-10{x}^{3}) & = \\\\ (\\frac{1}{2}\\cdot 6)x+(\\frac{1}{2}\\cdot (-10))(x\\cdot {x}^{3}) & = \\\\ (3)x+(-5)({x}^{1+3}) & = \\\\ 3x-5{x}^{4}\\end{aligned}\n$$"} :step/id #uuid "fef1509a-8ac4-5f19-b17b-2194e4983c02"}] :activity/title "The Distributive Law for Polynomials" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186489510}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186069578} :activity/id #uuid "09fac72c-e8cf-5881-9f87-6135d15c419b" :activity/scope {:db/id #edb/ref 17592186048652 :topic/id #uuid "b27952f8-4bda-51a9-b51b-57fe61de4a72" :topic/math-academy-id 470} :activity/steps [{:db/id #edb/ref 17592186069578 :step/content {:db/id #edb/ref 17592186070022 :tutorial/content "A **function** is a rule that takes a number as **input** and then **outputs** another number.\n\nFor instance, let's look at the following function: \n\n$$\nf(x) = 3x+1\n$$\n\nIn this example,\n\n- $f$ is the **name** of the function,\n\n- the number $x$ is the **input**,\n\n- the number $3x+1$ is the **output**.\n\nIf we **substitute** a number into our function in place of $x$, we get another number as output. \n\nFor example, by substituting $x={\\color{blue}{2}},$ we get\n\n$$\nf({\\color{blue}{2}}) = 3\\cdot {\\color{blue}{2}}+1 = 7.\n$$\n\nSo, the input $x={\\color{blue}{2}}$ results in an output of $7.$\n\nWe can substitute any number we like into this function! For example, if we substitute $x={\\color{red}{-2}},$ we get\n\n$$\nf({\\color{red}{-2}}) = 3\\cdot ({\\color{red}{-2}})+1 = -5.\n$$\n\nSo, the input $x={\\color{red}{-2}}$ results in an output of $-5.$" :tutorial/id #uuid "902a3802-7423-5fa0-9cf1-43856055c65c" :tutorial/math-academy-id 8783 :tutorial/title "Introduction"} :step/id #uuid "726a2782-726c-5f7e-b8e5-138b8563ebff" :step/math-academy-id 138156 :step/next {:db/id #edb/ref 17592186069579}} {:db/id #edb/ref 17592186069579 :step/content {:db/id #edb/ref 17592186068701 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068486 :question/id #uuid "38228952-21ef-5caf-9805-76e42ebf0caa" :question/math-academy-id "e-14148"} :knowledge-point/id #uuid "4e5366dd-a374-5abd-bdf6-77f378f97145" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048594} {:db/id #edb/ref 17592186049299} {:db/id #edb/ref 17592186050127}] :knowledge-point/questions [{:db/id #edb/ref 17592186069041} {:db/id #edb/ref 17592186069115} {:db/id #edb/ref 17592186069123} {:db/id #edb/ref 17592186233385} {:db/id #edb/ref 17592186233396} {:db/id #edb/ref 17592186233405} {:db/id #edb/ref 17592186233561} {:db/id #edb/ref 17592186233568} {:db/id #edb/ref 17592186233575} {:db/id #edb/ref 17592186482561} {:db/id #edb/ref 17592186482574} {:db/id #edb/ref 17592186492831} {:db/id #edb/ref 17592186492850} {:db/id #edb/ref 17592186492901} {:db/id #edb/ref 17592186522723}] :knowledge-point/title "Evaluating a Function"} :step/id #uuid "8af30817-9be7-537a-9bfb-2ce31b525422" :step/math-academy-id 138157 :step/next {:db/id #edb/ref 17592186069580}} {:db/id #edb/ref 17592186069580 :step/content {:db/id #edb/ref 17592186070023 :tutorial/content "Functions with more than one input are called **multivariable functions**. \n\nFor example, the multivariable function \n\n$$\nf(x,y)=x-y\n$$\n\ntakes in two numbers, $x$ and $y$, and returns their difference. \n\nFor multivariable functions, the order of the inputs matters. For example, if we substitute $x={\\color{blue}{3}}$ and $y={\\color{red}{2}},$ we get\n\n$$\nf({\\color{blue}{3}},{\\color{red}{2}}) = {\\color{blue}{3}}-{\\color{red}{2}}=1,\n$$\n\nwhereas if we substitute $x={\\color{red}{2}}$ and $y={\\color{blue}{3}},$ we get a different output:\n\n$$\nf({\\color{red}{2}},{\\color{blue}{3}})={\\color{red}{2}}-{\\color{blue}{3}}=-1\n$$" :tutorial/id #uuid "0bef6d6f-bda2-56dd-badb-0001ca2e4329" :tutorial/math-academy-id 8784 :tutorial/title "Evaluating Functions of More Than One Variable"} :step/id #uuid "004a3461-1ea4-5e28-807b-fea6c51ae3d4" :step/math-academy-id 138161 :step/next {:db/id #edb/ref 17592186069581}} {:db/id #edb/ref 17592186069581 :step/content {:db/id #edb/ref 17592186068702 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068487 :question/id #uuid "4e06fa0b-f3f0-5e60-9a83-67a393b4cc07" :question/math-academy-id "e-14150"} :knowledge-point/id #uuid "2b5f42de-fad6-54b6-90e1-205fdbe8a456" :knowledge-point/questions [{:db/id #edb/ref 17592186069042} {:db/id #edb/ref 17592186069116} {:db/id #edb/ref 17592186069124} {:db/id #edb/ref 17592186482526} {:db/id #edb/ref 17592186482569} {:db/id #edb/ref 17592186492852} {:db/id #edb/ref 17592186544826} {:db/id #edb/ref 17592186544830} {:db/id #edb/ref 17592186544841}] :knowledge-point/title "Evaluating a Multivariable Function"} :step/id #uuid "e7679093-39bc-5822-a013-8ae88e7f542e" :step/math-academy-id 138162}] :activity/title "Introduction to Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068995}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186492946} :activity/id #uuid "32d73cc0-19b4-59d2-9583-c970a787e5ed" :activity/scope {:db/id #edb/ref 17592186048652 :topic/id #uuid "b27952f8-4bda-51a9-b51b-57fe61de4a72" :topic/math-academy-id 470} :activity/steps [{:db/id #edb/ref 17592186492936 :step/content {:db/id #edb/ref 17592186492831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e1864d1-334e-5ed1-a854-e574404fd88a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186492368}] :answer-field/correct {:db/id #edb/ref 17592186492368} :answer-field/id #uuid "40e76a0e-856c-5852-affb-986c061df288" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186492730}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "135b40fb-5cf8-57bf-b723-676d052a026d" :question/math-academy-id "q-214832" :question/problem "If $f(x)={x}^{2}-{4}^{x-2},$ then $f(4)=${{field-1}}." :question/worked-solution "We substitute $x=4$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x) & ={x}^{2}-{4}^{x-2} \\\\ f(4) & ={4}^{2}-{4}^{4-2} \\\\  & =16-{4}^{2} \\\\  & =16-16 \\\\  & =0\\end{aligned}\n$$"} :step/id #uuid "235c73d5-ae23-5b39-841a-4951560a5eff"} {:db/id #edb/ref 17592186492946 :step/content {:db/id #edb/ref 17592186492850 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "019dfabe-776e-5411-a52a-468bd8010e2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g(-3)=-29" :db/id #edb/ref 17592186492226} {:answer/id #uuid "1d371280-0e81-5a2f-8015-37b237435f45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g(-3)=21" :db/id #edb/ref 17592186492274} {:answer/id #uuid "28841ece-193a-5984-aca8-980d7d142fd5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g(-3)=29" :db/id #edb/ref 17592186492301} {:answer/id #uuid "8bf18704-fb98-57f4-be11-81048d8cd298" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g(-3)=49" :db/id #edb/ref 17592186492495} {:answer/id #uuid "8d6261f9-d215-5ae3-bfdb-9431ed756997" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g(-3)=-21" :db/id #edb/ref 17592186492496}] :answer-field/correct {:db/id #edb/ref 17592186492496} :answer-field/id #uuid "76bd600f-4df3-5837-8db3-4c610cb01b2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492754}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3e0ff0f4-e55f-55b3-97b5-30132033682d" :question/math-academy-id "q-12993" :question/problem "Evaluate $g(-3)$, where $g(x)=(x+1)^{2}-(x-2)^{2}.$" :question/worked-solution "We substitute $x=-3$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}g(x) & =(x+1)^{2}-(x-2)^{2} \\\\ g(-3) & =(-3+1)^{2}-(-3-2)^{2} \\\\  & =(-2)^{2}-(-5)^{2} \\\\  & =4-25 \\\\  & =-21\\end{aligned}\n$$"} :step/id #uuid "45066582-f649-5b97-b9fa-5d0d0116ad1b" :step/next {:db/id #edb/ref 17592186492959}} {:db/id #edb/ref 17592186492957 :step/content {:db/id #edb/ref 17592186492852 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ea9fe05-136c-54fa-8287-468235cbdb0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186492316} {:answer/id #uuid "92ff2ec6-c1ed-57da-a105-85732944baad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-16" :db/id #edb/ref 17592186492504} {:answer/id #uuid "c4dd854f-76b8-57b7-925b-6bec0085d762" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186492611} {:answer/id #uuid "c81618e6-76ad-5708-8e7c-de8c549d1cea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186492616} {:answer/id #uuid "cfb62b1a-34c6-56d6-983c-37f403386609" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186492629}] :answer-field/correct {:db/id #edb/ref 17592186492616} :answer-field/id #uuid "021d4422-18e9-573a-aea3-c035cc557e6f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492706}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3e8b84ea-82b6-5138-bf4d-e73af61fdac3" :question/math-academy-id "q-130576" :question/problem "Evaluate $f(-1,2)$ if $f(x,y)=(2x-y)(x+2y).$" :question/worked-solution "We substitute $x=-1$ and $y=2$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x,y) & =(2x-y)(x+2y) \\\\ f(-1,2) & =(2(-1)-2)((-1)+2(2)) \\\\  & =(-4)(3) \\\\  & =-12\\end{aligned}\n$$"} :step/id #uuid "719d3968-3672-57cb-89f5-452d75b3654a" :step/next {:db/id #edb/ref 17592186492936}} {:db/id #edb/ref 17592186492959 :step/content {:db/id #edb/ref 17592186492901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04609b43-5111-5208-b18d-1c6e7b99af15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g(-1)=-32" :db/id #edb/ref 17592186492230} {:answer/id #uuid "16f29b86-ae62-561b-a969-655e99943a2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g(-1)=27" :db/id #edb/ref 17592186492260} {:answer/id #uuid "28262c89-1983-5b3b-9aa2-400cb80daebc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g(-1)=31" :db/id #edb/ref 17592186492299} {:answer/id #uuid "8319ede1-808f-592a-a403-f22857a5c9d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g(-1)=-27" :db/id #edb/ref 17592186492481} {:answer/id #uuid "b5da9e45-5970-5fa3-92b6-9e353c5519c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g(-1)=-39" :db/id #edb/ref 17592186492584}] :answer-field/correct {:db/id #edb/ref 17592186492230} :answer-field/id #uuid "7da22270-2bc9-5e75-a1ee-38a321ba33ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492758}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b9348d7e-52bc-5a07-98ca-88ef4ff5b0f5" :question/math-academy-id "q-31727" :question/problem "Evaluate $g(-1),$ if $g(x)=(x+3)^{2}-(x-5)^{2}.$" :question/worked-solution "We substitute $x=-1$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}g(x) & =(x+3)^{2}-(x-5)^{2} \\\\ g(-1) & =((-1)+3)^{2}-((-1)-5)^{2} \\\\  & =(2)^{2}-(-6)^{2} \\\\  & =4-36 \\\\  & =-32\\end{aligned}\n$$"} :step/id #uuid "75570071-e9a9-567a-93e7-3ab7178838f5" :step/next {:db/id #edb/ref 17592186492957}}] :activity/title "Introduction to Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186492206}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186544957} :activity/id #uuid "f68627be-ff54-526c-8208-8406616b4322" :activity/scope {:db/id #edb/ref 17592186048652 :topic/id #uuid "b27952f8-4bda-51a9-b51b-57fe61de4a72" :topic/math-academy-id 470} :activity/steps [{:db/id #edb/ref 17592186544957 :step/content {:db/id #edb/ref 17592186233385 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f66ec8e-8bae-5a96-a179-d8e3a1dfe2cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "19" :db/id #edb/ref 17592186544118} {:answer/id #uuid "3182f7a3-fd37-55f9-853d-66f2f6f3f9d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186544197} {:answer/id #uuid "514f3bb9-096e-5c0d-b085-0e9b207d4026" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186544264} {:answer/id #uuid "5da83ddd-756d-5caa-827b-cb339578aa6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186544290} {:answer/id #uuid "76c83aeb-cd5d-5dbb-bf1d-595dc42cd722" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186544350}] :answer-field/correct {:db/id #edb/ref 17592186544118} :answer-field/id #uuid "a932ff36-ed99-5a50-893b-5f175f3ceeef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544730}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "06658175-2088-56d6-9b3b-8c8339fcc59d" :question/math-academy-id "q-130569" :question/problem "Evaluate $f(2)$, where $f(x)=\\sqrt{x+7}+{4}^{x}.$" :question/worked-solution "We substitute $x=2$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x) & =\\sqrt{x+7}+{4}^{x} \\\\ f(2) & =\\sqrt{2+7}+{4}^{2} \\\\  & =\\sqrt{9}+16 \\\\  & =3+16 \\\\  & =19\\end{aligned}\n$$"} :step/id #uuid "a3365b0a-a746-531d-b973-83372efaf126" :step/next {:db/id #edb/ref 17592186544989}} {:db/id #edb/ref 17592186544989 :step/content {:db/id #edb/ref 17592186544841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "351d8210-c575-5ac4-a472-cd52a62017be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186544204} {:answer/id #uuid "3c1e55c9-211f-5df0-b5a6-dab892b30f5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186544218} {:answer/id #uuid "7736b0cd-e345-58aa-b572-63adfa1c527d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186544352} {:answer/id #uuid "92061fea-8540-57d3-bf20-97d7a67ca306" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186544406} {:answer/id #uuid "da61b983-1fd7-5312-8583-91abd7c70e0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186544557}] :answer-field/correct {:db/id #edb/ref 17592186544204} :answer-field/id #uuid "de4038dd-4a4f-5744-b3e0-9f127c2fa707" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544760}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "850f2473-aeb8-5637-89c4-7aa5503f51fe" :question/math-academy-id "q-130574" :question/problem "Evaluate $f(2,1)$ if $f(x,y)=(x-3y)(x+y)^{2}.$" :question/worked-solution "We substitute $x=2$ and $y=1$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x,y) & =(x-3y)(x+y)^{2} \\\\ f(2,1) & =(2-3(1))(2+1)^{2} \\\\  & =(-1)\\cdot (3)^{2} \\\\  & =-1\\cdot 9 \\\\  & =-9\\end{aligned}\n$$"} :step/id #uuid "f310f4e8-5364-5f72-bc12-2c5b4ed0e307" :step/next {:db/id #edb/ref 17592186544995}} {:db/id #edb/ref 17592186544995 :step/content {:db/id #edb/ref 17592186544830 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2522a912-6ec9-5d1e-9006-2d6a985f8f29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186544168} {:answer/id #uuid "32bfe30f-860e-5462-9664-fd946b7e9aeb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186544200} {:answer/id #uuid "432f6ee1-afa8-57d6-ae54-4a08db2f0814" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186544235} {:answer/id #uuid "92fc0bde-21ea-528f-87e4-e626ffa89252" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186544411} {:answer/id #uuid "f5c66c90-2e89-5fdf-92e0-e36e92e33fac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186544622}] :answer-field/correct {:db/id #edb/ref 17592186544622} :answer-field/id #uuid "92a31c45-7d31-5b52-9c18-6a21a65bc008" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544720}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6e8aaddd-953c-576c-ad6b-2e4d36b66988" :question/math-academy-id "q-130578" :question/problem "Evaluate $f(1,1)$ if $f(x,y)=(3y-x)^{3}+(2x-y)^{2}.$" :question/worked-solution "We substitute $x=1$ and $y=1$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x,y) & =(3y-x)^{3}+(2x-y)^{2} \\\\ f(1,1) & =(3(1)-1)^{3}+(2(1)-1)^{2} \\\\  & ={2}^{3}+{1}^{2} \\\\  & =8+1 \\\\  & =9\\end{aligned}\n$$"} :step/id #uuid "fffd7ed9-55d6-58a4-b296-ec80636460e6"}] :activity/title "Introduction to Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186544085}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186106642} :activity/id #uuid "5d527aa8-abdc-59f4-9e67-fe8dbfab8e99" :activity/scope {:db/id #edb/ref 17592186048683 :topic/id #uuid "b4904126-8a71-5d04-a71d-74c10d4620ba" :topic/math-academy-id 1289} :activity/steps [{:db/id #edb/ref 17592186106632 :step/content {:db/id #edb/ref 17592186105742 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105599 :question/id #uuid "3ef53b20-3e82-5cd0-a1df-bd679ea8c650" :question/math-academy-id "e-4671"} :knowledge-point/id #uuid "bbc7c6e8-63c7-5ac4-9b65-f12c006b3fde" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049714}] :knowledge-point/questions [{:db/id #edb/ref 17592186106469} {:db/id #edb/ref 17592186106470} {:db/id #edb/ref 17592186478377} {:db/id #edb/ref 17592186544857}] :knowledge-point/title "Applying the Power of Quotient Rule"} :step/id #uuid "2f04115d-4fb6-50da-9efd-0c167f51e86a" :step/math-academy-id 17142 :step/next {:db/id #edb/ref 17592186106633}} {:db/id #edb/ref 17592186106633 :step/content {:db/id #edb/ref 17592186105743 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105600 :question/id #uuid "0debd4b6-66bd-5c00-8f0c-db39f5d848bc" :question/math-academy-id "e-4672"} :knowledge-point/id #uuid "d87a38cc-5ca0-534e-8fa1-0a6e68d65706" :knowledge-point/questions [{:db/id #edb/ref 17592186106471} {:db/id #edb/ref 17592186106472} {:db/id #edb/ref 17592186478380} {:db/id #edb/ref 17592186493896} {:db/id #edb/ref 17592186536830} {:db/id #edb/ref 17592186544795} {:db/id #edb/ref 17592186544797}] :knowledge-point/title "Evaluating Powers of Fractions Using Power of Quotient Rule"} :step/id #uuid "34836a29-5761-54fe-b6ca-a58e1fca9de8" :step/math-academy-id 17143 :step/next {:db/id #edb/ref 17592186106634}} {:db/id #edb/ref 17592186106634 :step/content {:db/id #edb/ref 17592186105744 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105601 :question/id #uuid "80cde83c-b7fb-5ad7-bc3e-528e47151da4" :question/math-academy-id "e-4673"} :knowledge-point/id #uuid "46cd136a-cc20-51e1-ac90-f8d9b787c5b3" :knowledge-point/questions [{:db/id #edb/ref 17592186106473} {:db/id #edb/ref 17592186106474} {:db/id #edb/ref 17592186478376} {:db/id #edb/ref 17592186478425} {:db/id #edb/ref 17592186544861}] :knowledge-point/title "Evaluating Powers of Negative Fractions Using the Power of Quotient Rule"} :step/id #uuid "fde68042-0dcb-5358-9469-295c9964cb49" :step/math-academy-id 17144} {:db/id #edb/ref 17592186106642 :step/content {:db/id #edb/ref 17592186107083 :tutorial/content "To raise a fraction to a power, we must raise both the numerator and the denominator to that power. This is known as the **power of quotient rule for exponents**.\n\nTo demonstrate, let's simplify the expression $\\left(\\dfrac{2}{5}\\right)^3$ by applying the power of quotient rule:\n\n$$\n\\left(\\dfrac{2}{5}\\right)^3=\\dfrac{2^3}{5^3}\n$$\n\n**Note:** The power of quotient rule for exponents is really just a quicker alternative to using repeated multiplication, as follows:\n\n$$\n\\begin{aligned}{(\\frac{2}{5})}^{3} & =(\\frac{2}{5})\\times (\\frac{2}{5})\\times (\\frac{2}{5}) \\\\  & =\\frac{2\\times 2\\times 2}{5\\times 5\\times 5} \\\\  & =\\frac{{2}^{3}}{{5}^{3}}\\end{aligned}\n$$" :tutorial/id #uuid "8abc3ed3-0ba8-5dc1-8bf8-437985614b92" :tutorial/math-academy-id 3273 :tutorial/title "Introduction"} :step/id #uuid "c9e8e3ef-fed3-5e60-ae33-e12940a91210" :step/math-academy-id 17997 :step/next {:db/id #edb/ref 17592186106632}}] :activity/title "The Power of Quotient Rule for Exponents" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186105965}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186494040} :activity/id #uuid "7e7b6dc7-4114-5b93-bb27-c0eeaa8b140f" :activity/scope {:db/id #edb/ref 17592186048683 :topic/id #uuid "b4904126-8a71-5d04-a71d-74c10d4620ba" :topic/math-academy-id 1289} :activity/steps [{:db/id #edb/ref 17592186493993 :step/content {:db/id #edb/ref 17592186493896 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36fd9457-00f5-537f-ad12-5edc30b6be51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186493479} {:answer/id #uuid "3fcd1bb2-1500-5ee2-b804-b199a4af59f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186493499} {:answer/id #uuid "72f3cf98-f8a7-5839-b0ee-742e6ecc2ac4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186493561} {:answer/id #uuid "da258386-0ee6-57ce-b6d3-41ef50f8b2d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186493733} {:answer/id #uuid "f175e3a1-caba-5bec-9be2-4f528d2943b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186493781}] :answer-field/correct {:db/id #edb/ref 17592186493499} :answer-field/id #uuid "f8aa62db-1655-53a1-a21b-36bf03df3896" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493887}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "151ea9a2-7fca-5107-a3ac-b15fd8b562e9" :question/math-academy-id "q-68461" :question/problem "${(\\frac{1}{2})}^{3}=$" :question/worked-solution "To raise the fraction to the power of $3$, we must raise both the numerator and the denominator to the power of $3:$\n\n$$\n{(\\frac{1}{2})}^{3}=\\frac{{1}^{3}}{{2}^{3}}\n$$\n\nNow, using, ${1}^{3}=1$ and ${2}^{3}=8,$ we get\n\n$$\n\\frac{{1}^{3}}{{2}^{3}}=\\frac{1}{8}.\n$$"} :step/id #uuid "341ef616-a07f-5fa1-b233-8905f2e7e196" :step/next {:db/id #edb/ref 17592186494048}} {:db/id #edb/ref 17592186494040 :step/content {:db/id #edb/ref 17592186106471 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe24bada-d3e5-58d4-87be-b638964a837f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186104975} {:answer/id #uuid "42c68a77-9d73-5bab-93cb-6b7a5e748fac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186104976} {:answer/id #uuid "55d4e952-a6d8-5904-946b-38407b47e342" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{25}" :db/id #edb/ref 17592186104977} {:answer/id #uuid "5ddacffd-3676-5cad-8eda-6c8155b58081" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{5}" :db/id #edb/ref 17592186104978} {:answer/id #uuid "6d66a109-c2bd-5416-af13-846d5afe3a77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{25}" :db/id #edb/ref 17592186104979}] :answer-field/correct {:db/id #edb/ref 17592186104977} :answer-field/id #uuid "1fc66f7f-3850-5fa3-bc61-13386480b4f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186104974}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5b2c788a-e2e8-529d-bb25-574b06c58bb0" :question/math-academy-id "q-68458" :question/problem "${(\\frac{3}{5})}^{2}=$" :question/worked-solution "To raise the fraction to the power of $2$, we must raise both the numerator and the denominator to the power of $2:$\n\n$$\n{(\\frac{3}{5})}^{2}=\\frac{{3}^{2}}{{5}^{2}}\n$$\n\nNow, using ${3}^{2}=9$ and ${5}^{2}=25,$ we get\n\n$$\n\\frac{{3}^{2}}{{5}^{2}}=\\frac{9}{25}.\n$$"} :step/id #uuid "9adbfcf0-8452-52d5-b4fb-e01320e32a18" :step/next {:db/id #edb/ref 17592186493993}} {:db/id #edb/ref 17592186494048 :step/content {:db/id #edb/ref 17592186106473 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f287d7b-8e45-585a-98fa-28040508099a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186104987} {:answer/id #uuid "ce55da7f-50bc-50e1-97d4-2fb77506d6e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{49}" :db/id #edb/ref 17592186104988} {:answer/id #uuid "f9e6c57d-980f-5bf5-abe5-039788ff6f9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{14}" :db/id #edb/ref 17592186104989} {:answer/id #uuid "3a096c69-a948-55c4-b1f3-408814661ef8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{7}" :db/id #edb/ref 17592186104990} {:answer/id #uuid "4f053517-545a-56dd-a930-55fa0e6815e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{49}" :db/id #edb/ref 17592186104991}] :answer-field/correct {:db/id #edb/ref 17592186104988} :answer-field/id #uuid "b9230a8b-5c46-59a1-bb96-933a3909004f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186104986}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e207c000-8554-5f94-b1da-034972cbe6db" :question/math-academy-id "q-68467" :question/problem "${(-\\frac{1}{7})}^{2}=$" :question/worked-solution "First, notice that $-\\frac{1}{7}=\\frac{(-1)}{7}.$\n\nTo raise the fraction to the power of $2$, we must raise both the numerator and the denominator to the power of $2:$\n\n$$\n{(-\\frac{1}{7})}^{2}={(\\frac{(-1)}{7})}^{2}=\\frac{(-1)^{2}}{{7}^{2}}\n$$\n\nNow, using $(-1)^{2}=1$ and ${7}^{2}=49,$ we get\n\n$$\n\\frac{(-1)^{2}}{{7}^{2}}=\\frac{1}{49}.\n$$"} :step/id #uuid "b0856f94-0f86-5940-aa64-f087a7c6407e"}] :activity/title "The Power of Quotient Rule for Exponents" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186493379}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186544982} :activity/id #uuid "5780162d-05a6-5c90-833c-f4c321c6a2c0" :activity/scope {:db/id #edb/ref 17592186048683 :topic/id #uuid "b4904126-8a71-5d04-a71d-74c10d4620ba" :topic/math-academy-id 1289} :activity/steps [{:db/id #edb/ref 17592186544900 :step/content {:db/id #edb/ref 17592186544795 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d3a6092-0ccc-5ace-b0a2-bbc9a1d476ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{25}" :db/id #edb/ref 17592186544113} {:answer/id #uuid "131b820a-255c-5c25-b591-253c1c2de483" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{12}{25}" :db/id #edb/ref 17592186544129} {:answer/id #uuid "24a253e9-25f8-58a3-a4ca-11ccea22f01d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{32}{25}" :db/id #edb/ref 17592186544167} {:answer/id #uuid "2fec3986-8b5e-5f78-b80f-5ca09b68480c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16}{125}" :db/id #edb/ref 17592186544192} {:answer/id #uuid "6ebc8797-8c31-5b8e-8e34-21f6a5e5a7b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16}{25}" :db/id #edb/ref 17592186544331}] :answer-field/correct {:db/id #edb/ref 17592186544331} :answer-field/id #uuid "4da087de-bf0c-5ba2-9cf1-aeb4a1fe7f57" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544685}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1fb4db83-3d4f-5c8b-938d-159db1a747a1" :question/math-academy-id "q-68721" :question/problem "$10{(\\frac{2}{5})}^{3}=$" :question/worked-solution "To raise the fraction to the power of $3$, we must raise both the numerator and the denominator to the power of $3.$ So we have\n\n$$\n{(\\frac{2}{5})}^{3}=\\frac{{2}^{3}}{{5}^{3}}=\\frac{8}{125}.\n$$\n\nTherefore,\n\n$$\n10{(\\frac{2}{5})}^{3}=10\\cdot \\frac{8}{125}=\\frac{80}{125}.\n$$\n\nFinally, we simplify:\n\n$$\n\\frac{80}{125}=\\frac{16\\cdot 5}{25\\cdot 5}=\\frac{16}{25}\n$$"} :step/id #uuid "038c7b55-7263-5198-8c54-9c42b551c2fd" :step/next {:db/id #edb/ref 17592186544966}} {:db/id #edb/ref 17592186544966 :step/content {:db/id #edb/ref 17592186544861 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "283aec17-150c-5d77-97de-8e2a579c1b9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186544179} {:answer/id #uuid "2e6c5baf-6923-5afe-bd84-66fa2b5ce9c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{27}" :db/id #edb/ref 17592186544188} {:answer/id #uuid "98102fa6-60fa-5c9e-a3d6-b1c5223c3f16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16}{81}" :db/id #edb/ref 17592186544417} {:answer/id #uuid "be6a372e-767d-5043-93bc-06652273b513" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{8}{81}" :db/id #edb/ref 17592186544492} {:answer/id #uuid "fae39428-4f93-5219-a733-bb8b7cbb74a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{16}{27}" :db/id #edb/ref 17592186544634}] :answer-field/correct {:db/id #edb/ref 17592186544417} :answer-field/id #uuid "2c6a5509-5ce2-50bc-ada9-2d5121a407c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544670}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a48af0b4-b2cb-5194-ba80-dd04350d6f6a" :question/math-academy-id "q-68731" :question/problem "${(-\\frac{2}{3})}^{4}=$" :question/worked-solution "First, notice that $-\\frac{2}{3}=\\frac{(-2)}{3}.$\n\nTo raise the fraction to the power of $4$, we must raise both the numerator and the denominator to the power of $4:$\n\n$$\n{(-\\frac{2}{3})}^{4}={(\\frac{(-2)}{3})}^{4}=\\frac{(-2)^{4}}{{3}^{4}}\n$$\n\nNow, using $(-2)^{4}=16$ and ${3}^{4}=81,$ we get\n\n$$\n\\frac{(-2)^{4}}{{3}^{4}}=\\frac{16}{81}.\n$$"} :step/id #uuid "bf8ead69-26f1-574e-ae54-1fabd6a6f119"} {:db/id #edb/ref 17592186544982 :step/content {:db/id #edb/ref 17592186544797 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "501a303e-f34d-5682-9a05-1e75280b89ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27}{343}" :db/id #edb/ref 17592186544261} {:answer/id #uuid "52b7763a-dee6-51ad-b099-1735a48c0f99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{7}" :db/id #edb/ref 17592186544268} {:answer/id #uuid "57795c6e-ecfc-5f71-bd3a-93bb2461acc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{343}" :db/id #edb/ref 17592186544280} {:answer/id #uuid "b617d68c-7e77-5483-94f6-4afee9202b1c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{81}{343}" :db/id #edb/ref 17592186544473} {:answer/id #uuid "c193368e-633b-5f1f-af0b-7ec6461bd71b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27}{7}" :db/id #edb/ref 17592186544500}] :answer-field/correct {:db/id #edb/ref 17592186544261} :answer-field/id #uuid "14e7fc7d-33ea-5894-af3c-237ca0c4a223" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544661}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2545d131-b88a-533a-a3f0-2d6b5ef7d401" :question/math-academy-id "q-68718" :question/problem "${(\\frac{3}{7})}^{3}=$" :question/worked-solution "To raise the fraction to the power of $3$, we must raise both the numerator and the denominator to the power of $3:$\n\n$$\n{(\\frac{3}{7})}^{3}=\\frac{{3}^{3}}{{7}^{3}}\n$$\n\nNow, using ${3}^{3}=27$ and ${7}^{3}=343,$ we get\n\n$$\n\\frac{{3}^{3}}{{7}^{3}}=\\frac{27}{343}.\n$$"} :step/id #uuid "dd7d2971-38b4-5f54-91d8-a5c3949b6990" :step/next {:db/id #edb/ref 17592186544900}}] :activity/title "The Power of Quotient Rule for Exponents" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186544076}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186106568} :activity/id #uuid "c03def6f-6404-54a2-be07-37a61c9f3ebb" :activity/scope {:db/id #edb/ref 17592186048702 :topic/id #uuid "b66180ad-be0f-549e-967d-4ba9e0cb40fa" :topic/math-academy-id 1318} :activity/steps [{:db/id #edb/ref 17592186106568 :step/content {:db/id #edb/ref 17592186107169 :tutorial/content "Whenever we have a fraction that contains a square root in the denominator, such as $\\dfrac{3}{\\sqrt{2}},$ we often want to find an equivalent fraction that has no square root in the denominator.\n\nTo find this equivalent fraction, all we need to do is multiply both the numerator and the denominator by the square root in the denominator. This process is known as **rationalizing the denominator**.\n\nFor example, for the fraction $\\dfrac{3}{\\sqrt{2}},$ we can remove the square root from the denominator by multiplying both the numerator and denominator by the square root:\n\n$$\n\\begin{aligned}\\frac{3}{\\sqrt{2}} & = \\\\ \\frac{3}{\\sqrt{2}}\\cdot \\frac{\\sqrt{2}}{\\sqrt{2}} & = \\\\ \\frac{3\\sqrt{2}}{{(\\sqrt{2})}^{2}} & = \\\\ \\frac{3\\sqrt{2}}{2}\\end{aligned}\n$$\n\nSo, when we rationalize the denominator in the fraction  $\\dfrac{3}{\\sqrt{2}},$ we get the equivalent fraction $\\dfrac{3 \\sqrt{2} }{ 2 }$ that has no square root in the denominator." :tutorial/id #uuid "a73f63d7-83ef-5e72-a786-df2bbc85ddd0" :tutorial/math-academy-id 9068 :tutorial/title "Introduction"} :step/id #uuid "8ca3d4bb-c694-5bb7-b380-f5c1233f1952" :step/math-academy-id 127307 :step/next {:db/id #edb/ref 17592186106569}} {:db/id #edb/ref 17592186106569 :step/content {:db/id #edb/ref 17592186105704 :knowledge-point/canonical-example {:db/id