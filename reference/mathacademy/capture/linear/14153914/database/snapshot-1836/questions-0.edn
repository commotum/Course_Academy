#{[{:db/id #edb/ref 17592186188086 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186188373 :knowledge-point/id #uuid "77a8929d-7aa9-5410-97d7-c7c72e9f1356" :knowledge-point/title "Distributing the Negative Sign Before Simplifying"}] :question/id #uuid "7f43385c-ccc0-5855-916a-e6bb689c290f" :question/math-academy-id "e-13094" :question/problem "Simplify the expression $-3-(5+2u).$" :question/worked-solution "First, we remove the parentheses by distributing the negative sign. This gives\n\n$$\n-3 - 5 - 2u.\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}-3-5-2u & = \\\\ (-3-5)-2u & = \\\\ -8-2u & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186188087 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186188374 :knowledge-point/id #uuid "b93a6e36-3ec9-5451-92c0-a534f2776cf1" :knowledge-point/title "Distributing the Negative Sign Before Simplifying: Negative Terms in Parentheses"}] :question/id #uuid "d73b6911-278d-5c8e-a900-fc751fa518fa" :question/math-academy-id "e-13095" :question/problem "Simplify the expression $11-(5a-7).$" :question/worked-solution "First, we remove the parentheses by distributing the negative sign. This gives\n\n$$\n11-5a + 7.\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}11-5a+7 & = \\\\ (11+7)-5a & = \\\\ 18-5a & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186188088 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186188375 :knowledge-point/id #uuid "9012632c-56fc-59b7-8212-39aeb96e2f9d" :knowledge-point/title "Applying the Distributive Law Before Simplifying"}] :question/id #uuid "34317825-e142-5f97-951f-45f87d9672d5" :question/math-academy-id "e-13096" :question/problem "Simplify the expression $-9v-4(3+5v).$" :question/worked-solution "Notice that the expression we need to subtract from $-9v$ must be expanded using the distributive law. \n\nSo first, let's write some big brackets around the expression in parentheses, keeping the minus sign *outside*.\n\n$$\n-9v - \\Big[4(3+5v)\\Big]\n$$\n\nNext, we expand the expression inside the brackets using the distributive law. This gives\n\n$$\n-9v - \\Big[12+20v\\Big].\n$$\n\nNow, we remove the brackets by distributing the negative sign. This gives\n\n$$\n-9v - 12 - 20v.\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}-9v-12-20v & = \\\\ (-9v-20v)-12 & = \\\\ -29v-12 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186188089 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186188376 :knowledge-point/id #uuid "1f9b26ce-9f61-5cb0-aeab-ee44bb3584c9" :knowledge-point/title "Applying the Distributive Law Before Simplifying: Negative Terms in Parentheses"}] :question/id #uuid "d6283f26-9e20-5255-b358-8bc0c6523065" :question/math-academy-id "e-13097" :question/problem "Simplify the expression $10 - 2(3x - 4).$" :question/worked-solution "Notice that the expression we need to subtract from $10$ must be expanded using the distributive law. \n\nSo first, let's write some big brackets around the expression in parentheses, keeping the minus sign *outside*.\n\n$$\n10 - \\Big[2(3x-4)\\Big]\n$$\n\nNext, we expand the expression inside the brackets using the distributive law. This gives\n\n$$\n10 - \\Big[6x-8\\Big].\n$$\n\nNow, we remove the brackets by distributing the negative sign. This gives\n\n$$\n10 - 6x + 8.\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}10-6x+8 & = \\\\ (10+8)-6x & = \\\\ 18-6x & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186475950 :knowledge-point/_questions [{:db/id #edb/ref 17592186188376 :knowledge-point/id #uuid "1f9b26ce-9f61-5cb0-aeab-ee44bb3584c9" :knowledge-point/title "Applying the Distributive Law Before Simplifying: Negative Terms in Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aa24d74-d9dc-5a8e-9eda-f3a3016da541" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11z+9" :db/id #edb/ref 17592186475459} {:answer/id #uuid "8dcbb5f9-2e57-519d-9b79-c6eecd256576" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-17z+18" :db/id #edb/ref 17592186475656} {:answer/id #uuid "ab7b29d1-5012-5948-9f3a-7ef9d0fa006c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11z+18" :db/id #edb/ref 17592186475694} {:answer/id #uuid "e842cecc-85a1-5003-9253-2d9e20e7af70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-17z-6" :db/id #edb/ref 17592186475798} {:answer/id #uuid "f36aa5ba-bb68-557f-92dd-41193183f7ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7z+9" :db/id #edb/ref 17592186475815}] :answer-field/correct {:answer/id #uuid "8dcbb5f9-2e57-519d-9b79-c6eecd256576" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-17z+18" :db/id #edb/ref 17592186475656} :answer-field/id #uuid "6612aa6a-9bb2-5533-866f-7b58d5968c70" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186475864}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "98d2da5e-a56a-51ef-b628-e972a6b524aa" :question/math-academy-id "q-141957" :question/problem "$-5z-6(2z-3)=$" :question/worked-solution "Notice that the expression we need to subtract from $-5z$ must be expanded using the distributive law. \n\nSo first, let's write some big brackets around the expression in parentheses, keeping the minus sign *outside*.\n\n$$\n-5z-[6(2z-3)]\n$$\n\nNext, we expand the expression inside the brackets using the distributive law. This gives\n\n$$\n-5z-[12z-18].\n$$\n\nNow, we remove the brackets by distributing the negative sign. This gives\n\n$$\n-5z-12z+18.\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}-5z-12z+18 & = \\\\ (-5z-12z)+18 & = \\\\ -17z+18 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186188575 :knowledge-point/_questions [{:db/id #edb/ref 17592186188374 :knowledge-point/id #uuid "b93a6e36-3ec9-5451-92c0-a534f2776cf1" :knowledge-point/title "Distributing the Negative Sign Before Simplifying: Negative Terms in Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1de64fc7-fb93-5d22-8f16-5303159ac96e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-2h" :db/id #edb/ref 17592186475481} {:answer/id #uuid "2112bd3d-e542-5085-90cd-bcbd60ea2b61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7+2h" :db/id #edb/ref 17592186475485} {:answer/id #uuid "2f24c363-f085-58b6-847a-2afc26d5f4cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7-2h" :db/id #edb/ref 17592186475506} {:answer/id #uuid "3d790aef-7b50-510a-afd1-29b89543cb30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+2h" :db/id #edb/ref 17592186475530} {:answer/id #uuid "dcb211f6-50dd-5038-b436-55be68b355ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+2h" :db/id #edb/ref 17592186475777}] :answer-field/correct {:answer/id #uuid "2f24c363-f085-58b6-847a-2afc26d5f4cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7-2h" :db/id #edb/ref 17592186475506} :answer-field/id #uuid "b8941c1b-9cc5-546c-9b11-85c5048affec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186185730}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "81c5debf-9545-5811-9ea3-88835b4357f4" :question/math-academy-id "q-144142" :question/problem "Simplify the expression $4-(2h-3).$" :question/worked-solution "First, we remove the parentheses by distributing the negative sign. This gives\n\n$$\n4-2h+3\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}4-2h+3 & = \\\\ (4+3)-2h & = \\\\ 7-2h & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186475951 :knowledge-point/_questions [{:db/id #edb/ref 17592186188374 :knowledge-point/id #uuid "b93a6e36-3ec9-5451-92c0-a534f2776cf1" :knowledge-point/title "Distributing the Negative Sign Before Simplifying: Negative Terms in Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dae3037-4575-5765-9479-a15a5d86b990" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5-7u" :db/id #edb/ref 17592186475531} {:answer/id #uuid "5a9d893f-3209-5732-a6d8-9ce794343443" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8+7u" :db/id #edb/ref 17592186475572} {:answer/id #uuid "73ca03a1-7934-590a-a077-2fd21093bf6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8-7u" :db/id #edb/ref 17592186475608} {:answer/id #uuid "79d9e989-2454-5618-910e-e1371e040f39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-7u" :db/id #edb/ref 17592186475618} {:answer/id #uuid "cb509127-6045-5ce5-9072-138713c10958" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+7u" :db/id #edb/ref 17592186475747}] :answer-field/correct {:answer/id #uuid "79d9e989-2454-5618-910e-e1371e040f39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-7u" :db/id #edb/ref 17592186475618} :answer-field/id #uuid "341ab2cc-5573-5b61-8445-9e89253684c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186475844}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9aa821db-a963-5bfc-89f9-99a159ea39a0" :question/math-academy-id "q-144243" :question/problem "Simplify the expression $-3-(7u-5).$" :question/worked-solution "First, we remove the parentheses by distributing the negative sign. This gives\n\n$$\n-3-7u+5\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}-3-7u+5 & = \\\\ (-3+5)-7u & = \\\\ 2-7u & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186475983 :knowledge-point/_questions [{:db/id #edb/ref 17592186188375 :knowledge-point/id #uuid "9012632c-56fc-59b7-8212-39aeb96e2f9d" :knowledge-point/title "Applying the Distributive Law Before Simplifying"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f328f54-0498-5e32-9f91-3d142c477a88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4-6y" :db/id #edb/ref 17592186475466} {:answer/id #uuid "2c4670ca-af66-5cff-8304-47b8087b3f65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-22+6y" :db/id #edb/ref 17592186475504} {:answer/id #uuid "38ea4a4a-e8be-54c5-8c53-25387149ad6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4+6y" :db/id #edb/ref 17592186475520} {:answer/id #uuid "790b1852-965b-57cd-a3f9-8847540987e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-22-6y" :db/id #edb/ref 17592186475617} {:answer/id #uuid "acb188d1-c611-5b5e-8ea6-c4fb3aa8a424" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10-2y" :db/id #edb/ref 17592186475696}] :answer-field/correct {:answer/id #uuid "790b1852-965b-57cd-a3f9-8847540987e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-22-6y" :db/id #edb/ref 17592186475617} :answer-field/id #uuid "05baa02c-244c-5f4c-8c25-2580b8b26401" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186475831}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fbe26239-f4a5-5ec1-a88c-e3440a20795a" :question/math-academy-id "q-144252" :question/problem "$-13-3(2y+3)=$" :question/worked-solution "Notice that the expression we need to subtract from $-13$ must be expanded using the distributive law. \n\nSo first, let's write some big brackets around the expression in parentheses, keeping the minus sign *outside*.\n\n$$\n-13-[3(2y+3)]\n$$\n\nNext, we expand the expression inside the brackets using the distributive law. This gives\n\n$$\n-13-[6y+9].\n$$\n\nNow, we remove the brackets by distributing the negative sign. This gives\n\n$$\n-13-6y-9.\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}-13-6y-9 & = \\\\ (-13-9)-6y & = \\\\ -22-6y & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186475981 :knowledge-point/_questions [{:db/id #edb/ref 17592186188376 :knowledge-point/id #uuid "1f9b26ce-9f61-5cb0-aeab-ee44bb3584c9" :knowledge-point/title "Applying the Distributive Law Before Simplifying: Negative Terms in Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f8a55e4-c42a-5a98-aa39-a2c1159e99f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13-8b" :db/id #edb/ref 17592186475482} {:answer/id #uuid "347cfb63-115f-55b3-9368-59edd66954c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4-8b" :db/id #edb/ref 17592186475513} {:answer/id #uuid "3e5e3e49-98cf-5d0d-bf3b-a666881820b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13+8b" :db/id #edb/ref 17592186475534} {:answer/id #uuid "ce97c6e3-987a-57f7-b0a7-2f6cdd65ed96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+8b" :db/id #edb/ref 17592186475752} {:answer/id #uuid "effb8580-755c-5546-b30d-ad7484380e66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-8b" :db/id #edb/ref 17592186475810}] :answer-field/correct {:answer/id #uuid "1f8a55e4-c42a-5a98-aa39-a2c1159e99f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13-8b" :db/id #edb/ref 17592186475482} :answer-field/id #uuid "3e868b29-0793-5cd6-9a3d-fe9a4f09f0db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186475849}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "effd2690-1ce3-5bfd-837f-fb52a891061c" :question/math-academy-id "q-144260" :question/problem "$7-2(4b-3)=$" :question/worked-solution "Notice that the expression we need to subtract from $7$ must be expanded using the distributive law. \n\nSo first, let's write some big brackets around the expression in parentheses, keeping the minus sign *outside*.\n\n$$\n7-[2(4b-3)]\n$$\n\nNext, we expand the expression inside the brackets using the distributive law. This gives\n\n$$\n7-[8b-6].\n$$\n\nNow, we remove the brackets by distributing the negative sign. This gives\n\n$$\n7-8b+6.\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}7-8b+6 & = \\\\ (7+6)-8b & = \\\\ 13-8b & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186475982 :knowledge-point/_questions [{:db/id #edb/ref 17592186188373 :knowledge-point/id #uuid "77a8929d-7aa9-5410-97d7-c7c72e9f1356" :knowledge-point/title "Distributing the Negative Sign Before Simplifying"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf3d970e-04da-5aa1-a97a-e87cc67fb4ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186475753}] :answer-field/correct {:answer/id #uuid "cf3d970e-04da-5aa1-a97a-e87cc67fb4ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186475753} :answer-field/id #uuid "249a5df1-da20-50af-9054-d6d04854a01f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186475839} {:answer-field/choices [{:answer/id #uuid "86832dc0-4298-586a-8e43-de507470c150" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186475646}] :answer-field/correct {:answer/id #uuid "86832dc0-4298-586a-8e43-de507470c150" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186475646} :answer-field/id #uuid "284c3cde-a7c6-5c11-83e9-da9910a1d2bf" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186475841}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f10306d0-b077-5314-9baa-700a263e9595" :question/math-academy-id "q-171523" :question/problem "The expression $-a-(3a+1)$ can be written as{{field-1}}\n$a\\,-$\n{{field-2}}." :question/worked-solution "First, we remove the parentheses by distributing the negative sign. This gives\n\n$$\n-a-3a-1.\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}-a-3a-1 & = \\\\ (-a-3a)-1 & = \\\\ -4a-1 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186475944 :knowledge-point/_questions [{:db/id #edb/ref 17592186188373 :knowledge-point/id #uuid "77a8929d-7aa9-5410-97d7-c7c72e9f1356" :knowledge-point/title "Distributing the Negative Sign Before Simplifying"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "baf6f1d2-fbec-5363-972f-cafbb43c97bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186475726}] :answer-field/correct {:answer/id #uuid "baf6f1d2-fbec-5363-972f-cafbb43c97bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186475726} :answer-field/id #uuid "404ad5b9-ee70-5fbe-8b26-e4e1a3d4eb2f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186475851} {:answer-field/choices [{:answer/id #uuid "3ab4c3b5-282b-5e0c-945f-fe042c9bdaca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186475524}] :answer-field/correct {:answer/id #uuid "3ab4c3b5-282b-5e0c-945f-fe042c9bdaca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186475524} :answer-field/id #uuid "dce83c35-0469-5e49-bd24-ced898bca6fd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186475898}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8bada953-d1ec-5430-baf3-32480cff3e3b" :question/math-academy-id "q-181301" :question/problem "The expression $10-(7u+8)$ can be written as{{field-1}}\n$-$\n{{field-2}}\n$u.$" :question/worked-solution "First, we remove the parentheses by distributing the negative sign. This gives\n\n$$\n10-7u-8.\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}10-7u-8 & = \\\\ (10-8)-7u & = \\\\ 2-7\\,u & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186475946 :knowledge-point/_questions [{:db/id #edb/ref 17592186188375 :knowledge-point/id #uuid "9012632c-56fc-59b7-8212-39aeb96e2f9d" :knowledge-point/title "Applying the Distributive Law Before Simplifying"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1605f4c-5e8c-5d13-a5c6-33118c45cc08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186475787}] :answer-field/correct {:answer/id #uuid "e1605f4c-5e8c-5d13-a5c6-33118c45cc08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186475787} :answer-field/id #uuid "55cc041c-1be5-5d06-aa0c-b583d8a885af" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186475859} {:answer-field/choices [{:answer/id #uuid "deb0ac8f-1163-57aa-b169-608958b1a87e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186475783}] :answer-field/correct {:answer/id #uuid "deb0ac8f-1163-57aa-b169-608958b1a87e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186475783} :answer-field/id #uuid "d16d18e8-ecbb-53f2-b58f-64ff0cd149b7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186475893}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8e87c3a3-adbf-5bc1-93e9-45cedd31d826" :question/math-academy-id "q-181400" :question/problem "The expression $15-3(k+3)$ can be written as{{field-1}}\n$-$\n{{field-2}}\n$k.$" :question/worked-solution "Notice that the expression we need to subtract from $15$ must be expanded using the distributive law.  \n\nSo first, let's write some big brackets around the expression in parentheses, keeping the minus sign *outside*.\n\n$$\n15-[3(k+3)]\n$$\n\nNext, we expand the expression inside the brackets using the distributive law. This gives\n\n$$\n15-[3k+9].\n$$\n\nNow, we remove the brackets by distributing the negative sign. This gives\n\n$$\n15-3k-9.\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}15-3k-9 & = \\\\ (15-9)-3k & = \\\\ 6-3\\,k & \\end{aligned}\n$$"}]}
