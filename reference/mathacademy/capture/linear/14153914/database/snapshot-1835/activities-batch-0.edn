#{[{:activity/first-step {:db/id #edb/ref 17592186189246} :activity/id #uuid "d79ba348-c646-5f14-ae8e-c850ebf9ecf1" :activity/scope {:db/id #edb/ref 17592186049496 :topic/id #uuid "f93c391b-70b7-5915-96b7-e71123856cd6" :topic/math-academy-id 3873} :activity/steps [{:db/id #edb/ref 17592186189246 :step/content {:db/id #edb/ref 17592186189440 :tutorial/content "Let's think about how to simplify the following expression:\n\n$$\n6x-(3+2x)\n$$\n\nIn this example, we're subtracting the entire group of terms in parentheses from $6x$. In such cases, we distribute the negative sign to each term in the parentheses *first* and then simplify by collecting like terms.\n\nRemoving the parentheses by distributing the negative sign, we get\n\n$$\n\\begin{aligned}\n6x - (3 + 2x) &=  \\\\\n&= 6x - 3 - 2x \\mid\n\\end{aligned}\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}\n6x - 3 - 2x &=  \\\\\n(6x - 2x) - 3 &=  \\\\\n&= 4x - 3\n\\end{aligned}\n$$\n\nLet's take a look at another example." :tutorial/id #uuid "e0305f7d-c5ac-5566-af24-891e025ad938" :tutorial/math-academy-id 8189 :tutorial/title "Introduction"} :step/id #uuid "48299c1f-8045-5cb7-a906-450404a7722b" :step/math-academy-id 54169 :step/next {:db/id #edb/ref 17592186189247}} {:db/id #edb/ref 17592186189247 :step/content {:db/id #edb/ref 17592186188373 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188086 :question/id #uuid "7f43385c-ccc0-5855-916a-e6bb689c290f" :question/math-academy-id "e-13094"} :knowledge-point/id #uuid "77a8929d-7aa9-5410-97d7-c7c72e9f1356" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049939} {:db/id #edb/ref 17592186050452}] :knowledge-point/questions [{:db/id #edb/ref 17592186188574} {:db/id #edb/ref 17592186188576}] :knowledge-point/title "Distributing the Negative Sign Before Simplifying"} :step/id #uuid "b722a519-23e4-59d9-b070-fe41c31e900a" :step/math-academy-id 54170 :step/next {:db/id #edb/ref 17592186189248}} {:db/id #edb/ref 17592186189248 :step/content {:db/id #edb/ref 17592186188374 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188087 :question/id #uuid "d73b6911-278d-5c8e-a900-fc751fa518fa" :question/math-academy-id "e-13095"} :knowledge-point/id #uuid "b93a6e36-3ec9-5451-92c0-a534f2776cf1" :knowledge-point/questions [{:db/id #edb/ref 17592186188575} {:db/id #edb/ref 17592186188577}] :knowledge-point/title "Distributing the Negative Sign Before Simplifying: Negative Terms in Parentheses"} :step/id #uuid "2d27c88e-9503-5c41-bf18-fcea1bf5999f" :step/math-academy-id 54173 :step/next {:db/id #edb/ref 17592186189249}} {:db/id #edb/ref 17592186189249 :step/content {:db/id #edb/ref 17592186189441 :tutorial/content "Sometimes, to subtract a group of terms, we have to apply the distributive law.\n\nFor example, let's simplify the following expression:\n\n$$\n7-4(y+2)\n$$\n\nFirst, let's write some big brackets around the expression in parentheses, keeping the minus sign *outside*.\n\n$$\n7 - \\Big[4(y+2)\\Big]\n$$\n\nNext, we expand the expression inside the brackets using the distributive law. This gives\n\n$$\n7 - \\Big[4y+8\\Big]\n$$\n\nNow, we proceed as before. Removing the brackets by distributing the negative sign gives\n\n$$\n7 - 4y - 8\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}\n7 - 4y - 8 &=  \\\\\n(7 - 8) - 4y &=  \\\\\n&= - 1 - 4y\n\\end{aligned}\n$$" :tutorial/id #uuid "7ded6b18-fb82-5e0c-999c-e8bede8f99c8" :tutorial/math-academy-id 8190 :tutorial/title "Subtracting a Group of Terms Using the Distributive Law"} :step/id #uuid "ad56d248-e365-5d0f-9646-35528365848b" :step/math-academy-id 54176 :step/next {:db/id #edb/ref 17592186189250}} {:db/id #edb/ref 17592186189250 :step/content {:db/id #edb/ref 17592186188375 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188088 :question/id #uuid "34317825-e142-5f97-951f-45f87d9672d5" :question/math-academy-id "e-13096"} :knowledge-point/id #uuid "9012632c-56fc-59b7-8212-39aeb96e2f9d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050575}] :knowledge-point/questions [{:db/id #edb/ref 17592186188950} {:db/id #edb/ref 17592186188974}] :knowledge-point/title "Applying the Distributive Law Before Simplifying"} :step/id #uuid "f8f736f0-3a01-5ac8-a88f-d5962e78c148" :step/math-academy-id 54177 :step/next {:db/id #edb/ref 17592186189251}} {:db/id #edb/ref 17592186189251 :step/content {:db/id #edb/ref 17592186188376 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188089 :question/id #uuid "d6283f26-9e20-5255-b358-8bc0c6523065" :question/math-academy-id "e-13097"} :knowledge-point/id #uuid "1f9b26ce-9f61-5cb0-aeab-ee44bb3584c9" :knowledge-point/questions [{:db/id #edb/ref 17592186188971} {:db/id #edb/ref 17592186188972}] :knowledge-point/title "Applying the Distributive Law Before Simplifying: Negative Terms in Parentheses"} :step/id #uuid "7f09baad-048d-5278-9394-d9bf15b40156" :step/math-academy-id 54180}] :activity/title "Simplifying Linear Expressions When a Group of Terms Is Subtracted" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186188467}]}
