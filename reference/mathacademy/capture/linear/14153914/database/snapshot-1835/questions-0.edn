#{[{:db/id #edb/ref 17592186188086 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186188373 :knowledge-point/id #uuid "77a8929d-7aa9-5410-97d7-c7c72e9f1356" :knowledge-point/title "Distributing the Negative Sign Before Simplifying"}] :question/id #uuid "7f43385c-ccc0-5855-916a-e6bb689c290f" :question/math-academy-id "e-13094" :question/problem "Simplify the expression $-3-(5+2u)$." :question/worked-solution "First, we remove the parentheses by distributing the negative sign. This gives\n\n$$\n-3 - 5 - 2u\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}\n-3 - 5 - 2u &=  \\\\\n(-3 - 5) - 2u &=  \\\\\n&= - 8 - 2u\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186188087 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186188374 :knowledge-point/id #uuid "b93a6e36-3ec9-5451-92c0-a534f2776cf1" :knowledge-point/title "Distributing the Negative Sign Before Simplifying: Negative Terms in Parentheses"}] :question/id #uuid "d73b6911-278d-5c8e-a900-fc751fa518fa" :question/math-academy-id "e-13095" :question/problem "Simplify the expression $11-(5a-7)$." :question/worked-solution "First, we remove the parentheses by distributing the negative sign. This gives\n\n$$\n11-5a + 7\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}\n11 - 5a + 7 &=  \\\\\n(11 + 7) - 5a &=  \\\\\n&= 18 - 5a\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186188088 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186188375 :knowledge-point/id #uuid "9012632c-56fc-59b7-8212-39aeb96e2f9d" :knowledge-point/title "Applying the Distributive Law Before Simplifying"}] :question/id #uuid "34317825-e142-5f97-951f-45f87d9672d5" :question/math-academy-id "e-13096" :question/problem "Simplify the expression $-9v-4(3+5v)$." :question/worked-solution "Notice that the expression we need to subtract from $-9v$ must be expanded using the distributive law.\n\nSo first, let's write some big brackets around the expression in parentheses, keeping the minus sign *outside*.\n\n$$\n-9v - \\Big[4(3+5v)\\Big]\n$$\n\nNext, we expand the expression inside the brackets using the distributive law. This gives\n\n$$\n-9v - \\Big[12+20v\\Big]\n$$\n\nNow, we remove the brackets by distributing the negative sign. This gives\n\n$$\n-9v - 12 - 20v\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}\n-9v - 12 - 20v &=  \\\\\n(-9v - 20v) - 12 &=  \\\\\n&= - 29v - 12\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186188089 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186188376 :knowledge-point/id #uuid "1f9b26ce-9f61-5cb0-aeab-ee44bb3584c9" :knowledge-point/title "Applying the Distributive Law Before Simplifying: Negative Terms in Parentheses"}] :question/id #uuid "d6283f26-9e20-5255-b358-8bc0c6523065" :question/math-academy-id "e-13097" :question/problem "Simplify the expression $10 - 2(3x - 4)$." :question/worked-solution "Notice that the expression we need to subtract from $10$ must be expanded using the distributive law.\n\nSo first, let's write some big brackets around the expression in parentheses, keeping the minus sign *outside*.\n\n$$\n10 - \\Big[2(3x-4)\\Big]\n$$\n\nNext, we expand the expression inside the brackets using the distributive law. This gives\n\n$$\n10 - \\Big[6x-8\\Big]\n$$\n\nNow, we remove the brackets by distributing the negative sign. This gives\n\n$$\n10 - 6x + 8\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}\n10 - 6x + 8 &=  \\\\\n(10 + 8) - 6x &=  \\\\\n&= 18 - 6x\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186188575 :knowledge-point/_questions [{:db/id #edb/ref 17592186188374 :knowledge-point/id #uuid "b93a6e36-3ec9-5451-92c0-a534f2776cf1" :knowledge-point/title "Distributing the Negative Sign Before Simplifying: Negative Terms in Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cef6ca59-b5e6-514a-91ae-ddb12a4368a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1 + 2h" :db/id #edb/ref 17592186185731} {:a