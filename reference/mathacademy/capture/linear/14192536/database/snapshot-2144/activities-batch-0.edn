#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186193604} :activity/id #uuid "53f8a96f-9300-5270-99f9-06fc6fa03819" :activity/scope {:db/id #edb/ref 17592186048483 :topic/id #uuid "a3715b53-2444-5539-85aa-a4d20357877e" :topic/math-academy-id 4031} :activity/steps [{:db/id #edb/ref 17592186193602 :step/content {:db/id #edb/ref 17592186192746 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192464 :question/id #uuid "fef2e81e-33db-518d-91ad-a3d39637d736" :question/math-academy-id "e-10747"} :knowledge-point/id #uuid "e38c34ab-8ac6-5dd1-9812-e1a446e77ebf" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050503}] :knowledge-point/questions [{:db/id #edb/ref 17592186193331} {:db/id #edb/ref 17592186193332} {:db/id #edb/ref 17592186506545} {:db/id #edb/ref 17592186506570} {:db/id #edb/ref 17592186506583}] :knowledge-point/title "Solving Two-Step Inequalities"} :step/id #uuid "6f436efa-7ff9-5c0c-b1b4-46029ab6b788" :step/math-academy-id 40724} {:db/id #edb/ref 17592186193604 :step/content {:db/id #edb/ref 17592186193860 :tutorial/content "We can always represent the solution of an inequality using a number line.\n\nFor example, let's express the solution of the following inequality using a number line:\n\n$$\n5x \\geq 30\n$$\n\nThe variable $x$ is being *multiplied* by $5.$ To isolate $x,$ we can perform the *opposite* operation, which is *dividing* by $5.$ So, we divide both sides of the inequality by $5{:}$\n\n$$\n\\begin{aligned}5x & \\ge 30 \\\\ \\frac{5x}{5} & \\ge \\frac{30}{5} \\\\ \\frac{5x}{5} & \\ge 6\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $5$ from the numerator and denominator:\n\n$$\n\\begin{aligned}\\frac{5x}{5} & \\ge 6 \\\\ \\frac{\\cancel{5}x}{\\cancel{5}} & \\ge 6 \\\\ x & \\ge 6\\end{aligned}\n$$\n\nTherefore, the solution is $x \\geq 6.$ This solution can be expressed on a number line, as shown below.\n\n![](images/c3/c3a3d5a89d9181af5de9658ad2ac00cd8026a3050d48765dba5f5b23d3a0e7bc.png)" :tutorial/id #uuid "c86ff43d-11e0-54fc-bafd-5638148ec372" :tutorial/math-academy-id 6759 :tutorial/title "Introduction"} :step/id #uuid "00cc323b-1079-57c2-bd10-8b8280d6b6cd" :step/math-academy-id 40957 :step/next {:db/id #edb/ref 17592186193635}} {:db/id #edb/ref 17592186193605 :step/content {:db/id #edb/ref 17592186192748 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192467 :question/id #uuid "56743b65-6e81-557e-a0b6-e04dbe9fc7e4" :question/math-academy-id "e-10806"} :knowledge-point/id #uuid "78151f63-63dc-5338-bf9b-90f3fd825173" :knowledge-point/questions [{:db/id #edb/ref 17592186193125} {:db/id #edb/ref 17592186193132} {:db/id #edb/ref 17592186506542} {:db/id #edb/ref 17592186506551}] :knowledge-point/title "Solving One-Step Inequalities When Flipping Is Required"} :step/id #uuid "1ec4a8ba-4e50-585a-8d91-2b697329ceeb" :step/math-academy-id 40958 :step/next {:db/id #edb/ref 17592186193602}} {:db/id #edb/ref 17592186193635 :step/content {:db/id #edb/ref 17592186192768 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192492 :question/id #uuid "5280bed5-8ca3-55e5-9a6b-af86bf858e0e" :question/math-academy-id "e-10945"} :knowledge-point/id #uuid "9415209a-a06f-5d07-900f-7deb280837b5" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049986} {:db/id #edb/ref 17592186050519}] :knowledge-point/questions [{:db/id #edb/ref 17592186193070} {:db/id #edb/ref 17592186193124} {:db/id #edb/ref 17592186506558}] :knowledge-point/title "Solving One-Step Inequalities"} :step/id #uuid "8a4ad5e8-f1f8-5216-8929-a54e602ffd9d" :step/math-academy-id 41512 :step/next {:db/id #edb/ref 17592186193605}}] :activity/title "Representing Solutions to Inequalities on Number Lines" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186192908}]}
