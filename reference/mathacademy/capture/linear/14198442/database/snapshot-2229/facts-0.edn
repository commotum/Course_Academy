86233025 #edb/ref 17592186045417] [17592186054703 #edb/ref 1038 #edb/ref 17592186233026 #edb/ref 17592186045417] [17592186054703 #edb/ref 1038 #edb/ref 17592186233588 #edb/ref 17592186045417] [17592186054703 #edb/ref 1038 #edb/ref 17592186233877 #edb/ref 17592186045417] [17592186054703 #edb/ref 1038 #edb/ref 17592186233878 #edb/ref 17592186045417] [17592186054703 #edb/ref 1038 #edb/ref 17592186233998 #edb/ref 17592186045417] [17592186054703 #edb/ref 1038 #edb/ref 17592186234243 #edb/ref 17592186045417] [17592186054703 #edb/ref 1038 #edb/ref 17592186234244 #edb/ref 17592186045417] [17592186054703 #edb/ref 1038 #edb/ref 17592186234395 #edb/ref 17592186045417] [17592186054703 #edb/ref 1038 #edb/ref 17592186234396 #edb/ref 17592186045417] [17592186054703 #edb/ref 1038 #edb/ref 17592186237784 #edb/ref 17592186045417] [17592186054703 #edb/ref 1038 #edb/ref 17592186311940 #edb/ref 17592186045417] [17592186054703 #edb/ref 1039 "Applying the Power Rule to Compute a Limit Given a Graph" #edb/ref 17592186045417] [17592186054703 #edb/ref 1041 #edb/ref 17592186054513 #edb/ref 17592186045417] [17592186054703 #edb/ref 1042 #uuid "4ad6d0a4-7854-5f87-896c-0c3ba5ef60af" #edb/ref 17592186045417] [17592186054899 #edb/ref 1043 #edb/ref 17592186055518 #edb/ref 17592186045417] [17592186054899 #edb/ref 1043 #edb/ref 17592186055519 #edb/ref 17592186045417] [17592186054899 #edb/ref 1043 #edb/ref 17592186055682 #edb/ref 17592186045417] [17592186054899 #edb/ref 1043 #edb/ref 17592186055683 #edb/ref 17592186045417] [17592186054899 #edb/ref 1043 #edb/ref 17592186055684 #edb/ref 17592186045417] [17592186054899 #edb/ref 1043 #edb/ref 17592186055685 #edb/ref 17592186045417] [17592186054899 #edb/ref 1043 #edb/ref 17592186055686 #edb/ref 17592186045417] [17592186054899 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186054899 #edb/ref 1045 "The Power and Root Rules for Limits" #edb/ref 17592186045417] [17592186054899 #edb/ref 1046 #edb/ref 17592186055682 #edb/ref 17592186045417] [17592186054899 #edb/ref 1049 #edb/ref 17592186050987 #edb/ref 17592186045417] [17592186054899 #edb/ref 1050 900.0 #edb/ref 17592186045417] [17592186054899 #edb/ref 1053 #uuid "5aea7af6-7507-583d-9ea4-e7afac732f55" #edb/ref 17592186045417] [17592186055518 #edb/ref 1058 #edb/ref 17592186055686 #edb/ref 17592186045417] [17592186055518 #edb/ref 1061 12007 #edb/ref 17592186045417] [17592186055518 #edb/ref 1062 #uuid "9450e070-8dcd-5ffd-bf6c-45e46af5913a" #edb/ref 17592186045417] [17592186055518 #edb/ref 1063 #edb/ref 17592186054604 #edb/ref 17592186045417] [17592186055519 #edb/ref 1061 12008 #edb/ref 17592186045417] [17592186055519 #edb/ref 1062 #uuid "d5acac99-2496-5224-a6b8-9e6864591fd4" #edb/ref 17592186045417] [17592186055519 #edb/ref 1063 #edb/ref 17592186054605 #edb/ref 17592186045417] [17592186055682 #edb/ref 1058 #edb/ref 17592186055683 #edb/ref 17592186045417] [17592186055682 #edb/ref 1061 344 #edb/ref 17592186045417] [17592186055682 #edb/ref 1062 #uuid "ea15caf2-d9e3-5bc4-a4eb-aeae23270b0c" #edb/ref 17592186045417] [17592186055682 #edb/ref 1063 #edb/ref 17592186055954 #edb/ref 17592186045417] [17592186055683 #edb/ref 1058 #edb/ref 17592186055684 #edb/ref 17592186045417] [17592186055683 #edb/ref 1061 345 #edb/ref 17592186045417] [17592186055683 #edb/ref 1062 #uuid "7cdd9667-323b-5010-a8fc-c007664db1d4" #edb/ref 17592186045417] [17592186055683 #edb/ref 1063 #edb/ref 17592186054702 #edb/ref 17592186045417] [17592186055684 #edb/ref 1058 #edb/ref 17592186055685 #edb/ref 17592186045417] [17592186055684 #edb/ref 1061 346 #edb/ref 17592186045417] [17592186055684 #edb/ref 1062 #uuid "2c4ae36c-001f-593c-aad4-04fe90c082c3" #edb/ref 17592186045417] [17592186055684 #edb/ref 1063 #edb/ref 17592186054703 #edb/ref 17592186045417] [17592186055685 #edb/ref 1058 #edb/ref 17592186055518 #edb/ref 17592186045417] [17592186055685 #edb/ref 1061 348 #edb/ref 17592186045417] [17592186055685 #edb/ref 1062 #uuid "feb2aa0a-5b34-5dae-ba30-562950046860" #edb/ref 17592186045417] [17592186055685 #edb/ref 1063 #edb/ref 17592186055955 #edb/ref 17592186045417] [17592186055686 #edb/ref 1058 #edb/ref 17592186055519 #edb/ref 17592186045417] [17592186055686 #edb/ref 1061 350 #edb/ref 17592186045417] [17592186055686 #edb/ref 1062 #uuid "4c16f856-e95a-5082-937e-48f3494765ac" #edb/ref 17592186045417] [17592186055686 #edb/ref 1063 #edb/ref 17592186055956 #edb/ref 17592186045417] [17592186055954 #edb/ref 1064 "The **power rule** states that the limit of a power is the power of the limit. More precisely, if $n$ is any positive integer and $\\lim_\\limits{x\\rightarrow a}f(x)=L,$ then\n\n$$\n\\begin{aligned}{lim}_{x\\to a}(f(x))^{n}={({lim}_{x\\to a}f(x))}^{n}={L}^{n}\\,.\\end{aligned}\n$$\n\nFor example, with the power rule, we can evaluate a limit like \n\n$$\n\\lim_\\limits{x\\rightarrow 2}(3x-4)^{8}\n$$\n\n by evaluating the limit of the expression within parentheses and then taking the power of the result.\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}(3x-4)^{8} & ={({lim}_{x\\to 2}(3x-4))}^{8} \\\\  & =(3\\cdot 2-4)^{8} \\\\  & ={2}^{8} \\\\  & =256\\,.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186055954 #edb/ref 1065 181 #edb/ref 17592186045417] [17592186055954 #edb/ref 1066 #uuid "c4331194-9993-526c-ac4e-85c5017ee722" #edb/ref 17592186045417] [17592186055954 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186055955 #edb/ref 1064 "The **root rule** states that the limit of a root is the root of the limit (provided that the root exists).\n\nMore precisely, if $n$ is any positive integer and $\\lim_\\limits{x\\rightarrow a}f(x)=L,$ then\n\n$$\n\\begin{aligned}{lim}_{x\\to a}\\sqrt[n]{f(x)}=\\sqrt[n]{{lim}_{x\\to a}f(x)}=\\sqrt[n]{L}\\,.\\end{aligned}\n$$\n\nFor example, with the root rule, we can evaluate a limit like \n\n$$\n\\lim_\\limits{x\\rightarrow 2}\\sqrt{3x-2}\n$$\n\n by evaluating the limit of the expression within the root and then taking the root of the result:\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\sqrt{3x-2} & =\\sqrt{{lim}_{x\\to 2}(3x-2)} \\\\  & =\\sqrt{3\\cdot 2-2} \\\\  & =\\sqrt{4} \\\\  & =2\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186055955 #edb/ref 1065 185 #edb/ref 17592186045417] [17592186055955 #edb/ref 1066 #uuid "831603dd-2fca-539d-90bc-81d866ca5d77" #edb/ref 17592186045417] [17592186055955 #edb/ref 1067 "The Root Rule for Limits" #edb/ref 17592186045417] [17592186055956 #edb/ref 1064 "If we combine the power rule and the root rule, then we get the following useful generalization: if $\\lim_\\limits{x\\rightarrow a}f(x)=L,$ then for any fraction $p/q,$ we have\n\n$$\n\\lim_\\limits{x\\rightarrow a}\\left(f(x)\\right)^{p/q} =  \\left(\\lim_\\limits{x\\rightarrow a} f(x)\\right)^{p/q} = L^{p/q}\n$$\n\nprovided that $L^{p/q}$ exists.\n\nFor example, we can evaluate a limit like \n\n$$\n\\lim_\\limits{y\\rightarrow 64} y^{-1/6}\n$$\n\n by evaluating the limit of $y$ and then exponentiating the result to the fractional exponent:\n\n \n\n$$\n\\begin{aligned}{lim}_{y\\to 64}{y}^{-1/6} & ={({lim}_{y\\to 64}y)}^{-1/6} \\\\  & =(64)^{-1/6} \\\\  & ={({2}^{6})}^{-1/6} \\\\  & ={2}^{-1} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186055956 #edb/ref 1065 187 #edb/ref 17592186045417] [17592186055956 #edb/ref 1066 #uuid "0ec92465-592d-5e08-8d49-a2a3311282c4" #edb/ref 17592186045417] [17592186055956 #edb/ref 1067 "Combining Different Rules" #edb/ref 17592186045417] [17592186233026 #edb/ref 1068 #edb/ref 17592186514299 #edb/ref 17592186045417] [17592186233026 #edb/ref 1069 "q-100279" #edb/ref 17592186045417] [17592186233026 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186233026 #edb/ref 1071 "![](images/a4/a4f8b046dd85d258dd897e595b5dba1116e5df763e2e74a196c6b79e2a8a42a5.png)\n\nFind ${lim}_{x\\to \\,1}(3-x)^{3}(f(x)-4{x}^{2})^{5}$ for the function $f(x)$ plotted above." #edb/ref 17592186045417] [17592186233026 #edb/ref 1072 #uuid "bbcc700b-75d4-530d-b320-ed65a6308882" #edb/ref 17592186045417] [17592186233026 #edb/ref 1074 "From the graph, we get that ${lim}_{x\\to \\,1}f(x)=3.$ \n\nFrom the product rule, we have\n\n$$\n{lim}_{x\\to \\,1}(3-x)^{3}(f(x)-4{x}^{2})^{5}={lim}_{x\\to \\,1}(3-x)^{3}\\cdot {lim}_{x\\to \\,1}(f(x)-4{x}^{2})^{5}.\n$$\n\nWe calculate the limits of each factor, separately.\n\nApplying the power rule, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,1}(3-x)^{3} & ={({lim}_{x\\to \\,1}(3-x))}^{3} \\\\  & =(3-1)^{3} \\\\  & ={2}^{3} \\\\  & =8,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,1}(f(x)-4{x}^{2})^{4} & ={({lim}_{x\\to \\,1}(f(x)-4{x}^{2}))}^{5} \\\\  & =(3-4(1)^{2})^{5} \\\\  & =(-1)^{5} \\\\  & =-1\\,.\\end{aligned}\n$$\n\nFinally, we have\n \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,1}(3-x)^{3}(f(x)-4{x}^{2})^{5} & ={lim}_{x\\to \\,1}(3-x)^{3}\\cdot {lim}_{x\\to \\,1}(f(x)-4{x}^{2})^{5} \\\\  & =8\\cdot (-1) \\\\  & =-8\\,.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186233588 #edb/ref 1068 #edb/ref 17592186514230 #edb/ref 17592186045417] [17592186233588 #edb/ref 1069 "q-17280" #edb/ref 17592186045417] [17592186233588 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186233588 #edb/ref 1071 "![](images/5e/5e8383b56998815d4c981e72c946fdbf8de77ece15e52ca2ed5c7371c8f2c8af.png)\n\nFind ${lim}_{x\\to 3}{(\\frac{4f(x)-12}{{x}^{2}-2x+2})}^{2}$ for the function $f(x)$ plotted above." #edb/ref 17592186045417] [17592186233588 #edb/ref 1072 #uuid "948c861d-0397-5eab-9d25-bae477da16f9" #edb/ref 17592186045417] [17592186233588 #edb/ref 1074 "Using the power and quotient rules, we can rewrite the given limit as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to 3}{(\\frac{4f(x)-12}{{x}^{2}-2x+2})}^{2} & ={(\\frac{{lim}_{x\\to 3}(4f(x)-12)}{{lim}_{x\\to 3}({x}^{2}-2x+2)})}^{2}\\end{aligned}\n$$\n\nThe above is true provided that  ${lim}_{x\\to 3}f(x)$ exists.\n\nWe find from the graph that ${lim}_{x\\to 3}f(x)=4.$ We calculate the limits of the numerator and denominator, separately.\n\n$$\n{lim}_{x\\to 3}(4f(x)-12)=4(4)-12=4\n$$\n\nand\n\n$$\n{lim}_{x\\to 3}({x}^{2}-2x+2)={3}^{2}-2(3)+2=5\n$$\n\nSo we have\n \n\n$$\n\\begin{aligned}{lim}_{x\\to 3}{(\\frac{4f(x)-12}{{x}^{2}-2x+2})}^{2} & ={(\\frac{{lim}_{x\\to 3}(4f(x)-12)}{{lim}_{x\\to 3}({x}^{2}-2x+2)})}^{2} \\\\  & ={(\\frac{4}{5})}^{2} \\\\  & =\\frac{16}{25}\\,.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186233993 #edb/ref 1068 #edb/ref 17592186514296 #edb/ref 17592186045417] [17592186233993 #edb/ref 1069 "q-35282" #edb/ref 17592186045417] [17592186233993 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186233993 #edb/ref 1071 "Calculate ${lim}_{z\\to (-4)}\\frac{{({z}^{2}-10)}^{2}}{(z+6)^{5}}.$" #edb/ref 17592186045417] [17592186233993 #edb/ref 1072 #uuid "5a56b3f7-a945-5fcc-bc40-896faa412616" #edb/ref 17592186045417] [17592186233993 #edb/ref 1074 "Here, we apply the quotient rule and the power rule to get\n \n\n$$\n\\begin{aligned}{lim}_{z\\to (-4)}\\frac{{({z}^{2}-10)}^{2}}{(z+6)^{5}} & =\\frac{{lim}_{z\\to (-4)}{({z}^{2}-10)}^{2}}{{lim}_{z\\to (-4)}(z+6)^{5}} \\\\  & =\\frac{{({lim}_{z\\to (-4)}({z}^{2}-10))}^{2}}{{({lim}_{z\\to (-4)}(z+6))}^{5}} \\\\  & =\\frac{{((-4)^{2}-10)}^{2}}{(-4+6)^{5}} \\\\  & =\\frac{{6}^{2}}{{2}^{5}} \\\\  & =\\frac{36}{32} \\\\  & =\\frac{9}{8}\\,.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186233999 #edb/ref 1068 #edb/ref 17592186514315 #edb/ref 17592186045417] [17592186233999 #edb/ref 1069 "q-35630" #edb/ref 17592186045417] [17592186233999 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186233999 #edb/ref 1071 "Calculate ${lim}_{y\\to 128}{y}^{-1/7}.$" #edb/ref 17592186045417] [17592186233999 #edb/ref 1072 #uuid "813daa4e-ee7e-5bca-b4a8-b7e7146be5c0" #edb/ref 17592186045417] [17592186233999 #edb/ref 1074 "Applying the root rule, we get\n\n$$\n\\begin{aligned}{lim}_{y\\to 128}{y}^{-1/7} & ={({lim}_{y\\to 128}y)}^{-1/7} \\\\  & =(128)^{-1/7} \\\\  & ={({2}^{7})}^{-1/7} \\\\  & ={2}^{-1} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186403265 #edb/ref 1068 #edb/ref 17592186403266 #edb/ref 17592186045417] [17592186403265 #edb/ref 1069 "q-67703" #edb/ref 17592186045417] [17592186403265 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186403265 #edb/ref 1071 "![](images/0b/0b0074bb582011695cec9807beab1623c6aab894e0c6abeb1bf3068be6ed3543.png)\n\nFind ${lim}_{x\\to \\,3}\\frac{\\sqrt{25-f(x)}}{2}$ for the function $f(x)$ plotted above." #edb/ref 17592186045417] [17592186403265 #edb/ref 1072 #uuid "8c978569-5523-50ca-8c37-1ccfd41ba3f3" #edb/ref 17592186045417] [17592186403265 #edb/ref 1074 "From the graph, we get that ${lim}_{x\\to \\,3}f(x)=9.$ \n\nApplying the root rule, we get\n \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,3}\\frac{\\sqrt{25-f(x)}}{2} & =\\frac{1}{2}\\sqrt{{lim}_{x\\to \\,3}(25-f(x))} \\\\  & =\\frac{1}{2}\\sqrt{25-9} \\\\  & =\\frac{\\sqrt{16}}{2} \\\\  & =\\frac{4}{2} \\\\  & =2\\,.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186403266 #edb/ref 1075 #edb/ref 17592186403267 #edb/ref 17592186045417] [17592186403266 #edb/ref 1075 #edb/ref 17592186403268 #edb/ref 17592186045417] [17592186403266 #edb/ref 1075 #edb/ref 17592186403269 #edb/ref 17592186045417] [17592186403266 #edb/ref 1075 #edb/ref 17592186403270 #edb/ref 17592186045417] [17592186403266 #edb/ref 1075 #edb/ref 17592186403271 #edb/ref 17592186045417] [17592186403266 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186403266 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186403266 #edb/ref 1078 #edb/ref 17592186403269 #edb/ref 17592186045417] [17592186403266 #edb/ref 1079 #uuid "89a133e4-dd1e-5f83-ae36-ea8f3bd624c1" #edb/ref 17592186045417] [17592186403267 #edb/ref 1080 "\\frac{\\sqrt{19}}{2}" #edb/ref 17592186045417] [17592186403267 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186403267 #edb/ref 1083 #uuid "d3e5e428-55c6-547c-8a43-b717c453f470" #edb/ref 17592186045417] [17592186403268 #edb/ref 1080 "-\\frac{\\sqrt{19}}{2}" #edb/ref 17592186045417] [1759218640326