b/ref 1075 #edb/ref 17592186513910 #edb/ref 17592186045417] [17592186514315 #edb/ref 1075 #edb/ref 17592186513959 #edb/ref 17592186045417] [17592186514315 #edb/ref 1075 #edb/ref 17592186513972 #edb/ref 17592186045417] [17592186514315 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186514315 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186514315 #edb/ref 1078 #edb/ref 17592186513652 #edb/ref 17592186045417] [17592186514315 #edb/ref 1079 #uuid "bea736b1-beb7-5da5-bed3-ff2b567324b5" #edb/ref 17592186045417] [17592186514370 #edb/ref 1068 #edb/ref 17592186514245 #edb/ref 17592186045417] [17592186514370 #edb/ref 1069 "q-77741" #edb/ref 17592186045417] [17592186514370 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186514370 #edb/ref 1071 "Find ${lim}_{x\\to 3}\\frac{\\sqrt[3]{10x-3}}{{x}^{2}-3}.$" #edb/ref 17592186045417] [17592186514370 #edb/ref 1072 #uuid "156d5c20-d8d9-52c6-bf0a-a41e2c4bb6cd" #edb/ref 17592186045417] [17592186514370 #edb/ref 1074 "Applying the quotient rule, we get\n\n$$\n{lim}_{x\\to 3}\\frac{\\sqrt[3]{10x-3}}{{x}^{2}-3}=\\frac{{lim}_{x\\to 3}(\\sqrt[3]{10x-3})}{{lim}_{x\\to 3}({x}^{2}-3)}\n$$\n\nWe calculate the limits of the numerator and denominator, separately.\n\nApplying the root rule in the numerator, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to 3}(\\sqrt[3]{10x-3}) & =\\sqrt[3]{10(3)-3} \\\\  & =\\sqrt[3]{30-3} \\\\  & =\\sqrt[3]{27} \\\\  & =3\\,.\\end{aligned}\n$$\n\nFor the denominator, we have\n \n\n$$\n\\begin{aligned}{lim}_{x\\to 3}({x}^{2}-3) & =(3)^{2}-3 \\\\  & =6\\,.\\end{aligned}\n$$\n\nConsequently,\n\n$$\n\\begin{aligned}{lim}_{x\\to 3}\\frac{\\sqrt[3]{10x-3}}{{x}^{2}-3} & =\\frac{3}{6} \\\\  & =\\frac{1}{2}\\,.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186514399 #edb/ref 1068 #edb/ref 17592186514286 #edb/ref 17592186045417] [17592186514399 #edb/ref 1069 "q-100306" #edb/ref 17592186045417] [17592186514399 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186514399 #edb/ref 1071 "![](images/b1/b12ba04b803d58c6cacf4fc781db5c7032c3aedad80506c101bf084109ebd797.png)\n\nFind ${lim}_{x\\to -2}\\sqrt[3]{\\frac{4(f(x))^{3}-3{x}^{2}}{2}}$ for the function $f(x)$ plotted above." #edb/ref 17592186045417] [17592186514399 #edb/ref 1072 #uuid "522ad648-b326-5d90-9d3d-5351c0a03cfc" #edb/ref 17592186045417] [17592186514399 #edb/ref 1074 "From the graph, we get that ${lim}_{x\\to -2}f(x)=-1.$\n\nApplying the root rule, we have \n\n$$\n\\begin{aligned}{lim}_{x\\to -2}\\sqrt[3]{\\frac{4(f(x))^{3}-3{x}^{2}}{2}} & =\\sqrt[3]{{lim}_{x\\to -2}(\\frac{4(f(x))^{3}-3{x}^{2}}{2})} \\\\  & =\\sqrt[3]{\\frac{4\\cdot (-1)^{3}-3(-2)^{2}}{2}} \\\\  & =\\sqrt[3]{\\frac{-4-12}{2}} \\\\  & =\\sqrt[3]{-8} \\\\  & =-2\\,.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186514416 #edb/ref 1068 #edb/ref 17592186514227 #edb/ref 17592186045417] [17592186514416 #edb/ref 1069 "q-100238" #edb/ref 17592186045417] [17592186514416 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186514416 #edb/ref 1071 "Find ${lim}_{x\\to -3}\\frac{({x}^{3}-6x+6)^{3}}{(2x+3)^{4}}.$" #edb/ref 17592186045417] [17592186514416 #edb/ref 1072 #uuid "6909c4f4-167d-501d-93f8-5aca9ebb11ed" #edb/ref 17592186045417] [17592186514416 #edb/ref 1074 "Here, we apply the quotient rule and the power rule to get\n\n \n\n$$\n\\begin{aligned}{lim}_{x\\to -3}\\frac{({x}^{3}-6x+6)^{3}}{(2x+3)^{4}} & =\\frac{{lim}_{x\\to -3}({x}^{3}-6x+6)^{3}}{{lim}_{x\\to -3}(2x+3)^{4}} \\\\  & =\\frac{{({lim}_{x\\to -3}({x}^{3}-6x+6))}^{3}}{{({lim}_{x\\to -3}(2x+3))}^{4}} \\\\  & =\\frac{((-3)^{3}-6(-3)+6)^{3}}{(2(-3)+3)^{4}} \\\\  & =\\frac{(-27+18+6)^{3}}{(-6+3)^{4}} \\\\  & =\\frac{(-3)^{3}}{(-3)^{4}} \\\\  & =-\\frac{1}{3}\\,.\\end{aligned}\n$$" #edb/ref 17592186045417]}
