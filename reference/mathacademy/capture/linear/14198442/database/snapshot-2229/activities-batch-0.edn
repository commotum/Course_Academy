#{[{:activity/expected-seconds 900.0 :activity/first-step {:db/id #edb/ref 17592186055682} :activity/id #uuid "5aea7af6-7507-583d-9ea4-e7afac732f55" :activity/scope {:db/id #edb/ref 17592186050987 :topic/id #uuid "7734519e-e666-5361-81f3-89b86b5bc28d" :topic/math-academy-id 37} :activity/steps [{:db/id #edb/ref 17592186055518 :step/content {:db/id #edb/ref 17592186054604 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054518 :question/id #uuid "8177157c-4d89-59df-af9b-38f1bee2d6a2" :question/math-academy-id "e-3564"} :knowledge-point/id #uuid "b1bddb74-97be-5f35-b559-afb707e6e964" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049299}] :knowledge-point/questions [{:db/id #edb/ref 17592186055053} {:db/id #edb/ref 17592186055297} {:db/id #edb/ref 17592186233022} {:db/id #edb/ref 17592186233760} {:db/id #edb/ref 17592186233879} {:db/id #edb/ref 17592186233994} {:db/id #edb/ref 17592186233999} {:db/id #edb/ref 17592186234057} {:db/id #edb/ref 17592186234394} {:db/id #edb/ref 17592186311941} {:db/id #edb/ref 17592186311942} {:db/id #edb/ref 17592186514370}] :knowledge-point/title "Applying the Root Rule to Compute a Limit"} :step/id #uuid "9450e070-8dcd-5ffd-bf6c-45e46af5913a" :step/math-academy-id 12007 :step/next {:db/id #edb/ref 17592186055686}} {:db/id #edb/ref 17592186055519 :step/content {:db/id #edb/ref 17592186054605 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054519 :question/id #uuid "3d6b32ee-3385-5fba-91a5-66c0bbb13dea" :question/math-academy-id "e-3565"} :knowledge-point/id #uuid "10100e89-21d6-53c5-a7de-f14fd73ce4b7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049089}] :knowledge-point/questions [{:db/id #edb/ref 17592186055235} {:db/id #edb/ref 17592186055236} {:db/id #edb/ref 17592186233029} {:db/id #edb/ref 17592186233421} {:db/id #edb/ref 17592186233880} {:db/id #edb/ref 17592186233995} {:db/id #edb/ref 17592186234245} {:db/id #edb/ref 17592186234397} {:db/id #edb/ref 17592186235428} {:db/id #edb/ref 17592186311944} {:db/id #edb/ref 17592186403265} {:db/id #edb/ref 17592186514399}] :knowledge-point/title "Combining Different Rules to Compute a Limit Given a Graph"} :step/id #uuid "d5acac99-2496-5224-a6b8-9e6864591fd4" :step/math-academy-id 12008} {:db/id #edb/ref 17592186055682 :step/content {:db/id #edb/ref 17592186055954 :tutorial/content "The **power rule** states that the limit of a power is the power of the limit. More precisely, if $n$ is any positive integer and $\\lim_\\limits{x\\rightarrow a}f(x)=L,$ then\n\n$$\n\\begin{aligned}{lim}_{x\\to a}(f(x))^{n}={({lim}_{x\\to a}f(x))}^{n}={L}^{n}\\,.\\end{aligned}\n$$\n\nFor example, with the power rule, we can evaluate a limit like \n\n$$\n\\lim_\\limits{x\\rightarrow 2}(3x-4)^{8}\n$$\n\n by evaluating the limit of the expression within parentheses and then taking the power of the result.\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}(3x-4)^{8} & ={({lim}_{x\\to 2}(3x-4))}^{8} \\\\  & =(3\\cdot 2-4)^{8} \\\\  & ={2}^{8} \\\\  & =256\\,.\\end{aligned}\n$$" :tutorial/id #uuid "c4331194-9993-526c-ac4e-85c5017ee722" :tutorial/math-academy-id 181 :tutorial/title "Introduction"} :step/id #uuid "ea15caf2-d9e3-5bc4-a4eb-aeae23270b0c" :step/math-academy-id 344 :step/next {:db/id #edb/ref 17592186055683}} {:db/id #edb/ref 17592186055683 :step/content {:db/id #edb/ref 17592186054702 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054512 :question/id #uuid "9f9e4a39-22c9-5bcf-9b34-b3b1459acb44" :question/math-academy-id "e-30"} :knowledge-point/id #uuid "ae7650e3-faf3-520c-9674-ffa036a8eacc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049226}] :knowledge-point/questions [{:db/id #edb/ref 17592186055232} {:db/id #edb/ref 17592186055372} {:db/id #edb/ref 17592186233020} {:db/id #edb/ref 17592186233021} {:db/id #edb/ref 17592186233992} {:db/id #edb/ref 17592186233993} {:db/id #edb/ref 17592186234242} {:db/id #edb/ref 17592186234393} {:db/id #edb/ref 17592186514416}] :knowledge-point/title "Applying the Power Rule to Compute a Limit"} :step/id #uuid "7cdd9667-323b-5010-a8fc-c007664db1d4" :step/math-academy-id 345 :step/next {:db/id #edb/ref 17592186055684}} {:db/id #edb/ref 17592186055684 :step/content {:db/id #edb/ref 17592186054703 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054513 :question/id #uuid "27b89a42-7f31-579b-af21-b33ebe36f749" :question/math-academy-id "e-31"} :knowledge-point/id #uuid "4ad6d0a4-7854-5f87-896c-0c3ba5ef60af" :knowledge-point/questions [{:db/id #edb/ref 17592186055233} {:db/id #edb/ref 17592186055234} {:db/id #edb/ref 17592186233023} {:db/id #edb/ref 17592186233024} {:db/id #edb/ref 17592186233025} {:db/id #edb/ref 17592186233026} {:db/id #edb/ref 17592186233588} {:db/id #edb/ref 17592186233877} {:db/id #edb/ref 17592186233878} {:db/id #edb/ref 17592186233998} {:db/id #edb/ref 17592186234243} {:db/id #edb/ref 17592186234244} {:db/id #edb/ref 17592186234395} {:db/id #edb/ref 17592186234396} {:db/id #edb/ref 17592186237784} {:db/id #edb/ref 17592186311940}] :knowledge-point/title "Applying the Power Rule to Compute a Limit Given a Graph"} :step/id #uuid "2c4ae36c-001f-593c-aad4-04fe90c082c3" :step/math-academy-id 346 :step/next {:db/id #edb/ref 17592186055685}} {:db/id #edb/ref 17592186055685 :step/content {:db/id #edb/ref 17592186055955 :tutorial/content "The **root rule** states that the limit of a root is the root of the limit (provided that the root exists).\n\nMore precisely, if $n$ is any positive integer and $\\lim_\\limits{x\\rightarrow a}f(x)=L,$ then\n\n$$\n\\begin{aligned}{lim}_{x\\to a}\\sqrt[n]{f(x)}=\\sqrt[n]{{lim}_{x\\to a}f(x)}=\\sqrt[n]{L}\\,.\\end{aligned}\n$$\n\nFor example, with the root rule, we can evaluate a limit like \n\n$$\n\\lim_\\limits{x\\rightarrow 2}\\sqrt{3x-2}\n$$\n\n by evaluating the limit of the expression within the root and then taking the root of the result:\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\sqrt{3x-2} & =\\sqrt{{lim}_{x\\to 2}(3x-2)} \\\\  & =\\sqrt{3\\cdot 2-2} \\\\  & =\\sqrt{4} \\\\  & =2\\end{aligned}\n$$" :tutorial/id #uuid "831603dd-2fca-539d-90bc-81d866ca5d77" :tutorial/math-academy-id 185 :tutorial/title "The Root Rule for Limits"} :step/id #uuid "feb2aa0a-5b34-5dae-ba30-562950046860" :step/math-academy-id 348 :step/next {:db/id #edb/ref 17592186055518}} {:db/id #edb/ref 17592186055686 :step/content {:db/id #edb/ref 17592186055956 :tutorial/content "If we combine the power rule and the root rule, then we get the following useful generalization: if $\\lim_\\limits{x\\rightarrow a}f(x)=L,$ then for any fraction $p/q,$ we have\n\n$$\n\\lim_\\limits{x\\rightarrow a}\\left(f(x)\\right)^{p/q} =  \\left(\\lim_\\limits{x\\rightarrow a} f(x)\\right)^{p/q} = L^{p/q}\n$$\n\nprovided that $L^{p/q}$ exists.\n\nFor example, we can evaluate a limit like \n\n$$\n\\lim_\\limits{y\\rightarrow 64} y^{-1/6}\n$$\n\n by evaluating the limit of $y$ and then exponentiating the result to the fractional exponent:\n\n \n\n$$\n\\begin{aligned}{lim}_{y\\to 64}{y}^{-1/6} & ={({lim}_{y\\to 64}y)}^{-1/6} \\\\  & =(64)^{-1/6} \\\\  & ={({2}^{6})}^{-1/6} \\\\  & ={2}^{-1} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$" :tutorial/id #uuid "0ec92465-592d-5e08-8d49-a2a3311282c4" :tutorial/math-academy-id 187 :tutorial/title "Combining Different Rules"} :step/id #uuid "4c16f856-e95a-5082-937e-48f3494765ac" :step/math-academy-id 350 :step/next {:db/id #edb/ref 17592186055519}}] :activity/title "The Power and Root Rules for Limits" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054899}]}
