#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186541215} :activity/id #uuid "09e02f53-8a92-5ad2-9c96-e92966523e23" :activity/scope {:db/id #edb/ref 17592186049927 :topic/id #uuid "1f1f7b83-a1f4-5b1c-888f-a20ae593bd72" :topic/math-academy-id 1813} :activity/steps [{:db/id #edb/ref 17592186541204 :step/content {:db/id #edb/ref 17592186541054 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ecaeecc-1dd7-50eb-83e9-f0550181de4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186540580} {:answer/id #uuid "2ac09810-2176-58cd-aa0b-9736d84fc7e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186540601} {:answer/id #uuid "54bf5811-f21f-5d2c-886d-ccd5bf4f9758" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186540669} {:answer/id #uuid "a9943892-6a5d-567f-a068-dec6e6f6140d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186540812} {:answer/id #uuid "d0c0f7e1-5ac8-52a6-a477-47a0531cf7cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186540879}] :answer-field/correct {:db/id #edb/ref 17592186540601} :answer-field/id #uuid "d2177b68-63d5-53b3-a804-f2a9f09d50af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186541034}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "000ec056-1962-5b34-98db-f72ea83a397c" :question/math-academy-id "q-101157" :question/problem "Evaluate ${lim}_{t\\to -4}\\frac{{t}^{2}-16}{{t}^{2}+4t}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to -4}\\frac{{t}^{2}-16}{{t}^{2}+4t} & =\\frac{(-4)^{2}-16}{(-4)^{2}+4(-4)}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{t}^{2}-16}{{t}^{2}+4t} & =\\frac{(t+4)(t-4)}{t(t+4)} \\\\  & =\\frac{t-4}{t}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{t\\to -4}\\frac{{t}^{2}-16}{{t}^{2}+4t} & ={lim}_{t\\to -4}\\frac{t-4}{t} \\\\  & =\\frac{-4-4}{(-4)} \\\\  & =\\frac{(-8)}{(-4)} \\\\  & =2.\\end{aligned}\n$$"} :step/id #uuid "9a97cb65-3846-5c88-b3b7-a6e46d1bdf5c" :step/next {:db/id #edb/ref 17592186541210}} {:db/id #edb/ref 17592186541210 :step/content {:db/id #edb/ref 17592186541129 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16787501-bf61-5650-acba-b6330c5fbd81" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Does not exist" :db/id #edb/ref 17592186540563} {:answer/id #uuid "1b673edc-f9bf-5da4-a8b1-570b0810ca4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186540573} {:answer/id #uuid "a84a29ca-0cdf-58cd-bf89-e6937cd9cb17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186540808} {:answer/id #uuid "ac833262-dd83-5bdc-a643-9892af09fe23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{8}" :db/id #edb/ref 17592186540816} {:answer/id #uuid "cd352154-c198-57dc-a850-df25b22c0f47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186540870}] :answer-field/correct {:db/id #edb/ref 17592186540808} :answer-field/id #uuid "01c57478-0f3f-518c-9545-f7b2b4a1d9d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540942}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c1e71946-3589-5a14-87c2-2599e8aef444" :question/math-academy-id "q-107041" :question/problem "Evaluate ${lim}_{x\\to 5}\\frac{{x}^{2}-5x}{{x}^{2}-8x+15}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 5}\\frac{{x}^{2}-5x}{{x}^{2}-8x+15} & =\\frac{{5}^{2}-5(5)}{{5}^{2}-8(5)+15}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}-5x}{{x}^{2}-8x+15} & =\\frac{x(x-5)}{(x-5)(x-3)} \\\\  & =\\frac{x}{x-3}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to 5}\\frac{{x}^{2}-5x}{{x}^{2}-8x+15} & ={lim}_{x\\to 5}\\frac{x}{x-3} \\\\  & =\\frac{5}{5-3} \\\\  & =\\frac{5}{2}.\\end{aligned}\n$$"} :step/id #uuid "b0ee0554-72db-514b-8267-3bcda471dd63" :step/next {:db/id #edb/ref 17592186541227}} {:db/id #edb/ref 17592186541215 :step/content {:db/id #edb/ref 17592186541065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bb41bce-fce3-5aca-b3c6-9258d6451625" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186540546} {:answer/id #uuid "a9102bb7-1a7c-515a-bc83-8aa77adb4e86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186540811} {:answer/id #uuid "e4c5729f-2ec8-544e-b828-2de2b317c0ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186540916} {:answer/id #uuid "e4ff5de3-95df-570c-97a0-37b81b1edad0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186540917} {:answer/id #uuid "f8fc8b30-393b-592f-a907-3907a2e566f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186540934}] :answer-field/correct {:db/id #edb/ref 17592186540917} :answer-field/id #uuid "9da39b9f-c278-5623-b8c6-2f09872d7126" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186541009}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1889a049-4ef8-5003-97ad-4734948ea194" :question/math-academy-id "q-14553" :question/problem "Evaluate ${lim}_{x\\to 4}\\frac{{x}^{2}-2x-8}{{x}^{2}+x-20}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 4}\\frac{{x}^{2}-2x-8}{{x}^{2}+x-20} & =\\frac{{4}^{2}-2(4)-8}{{4}^{2}+4-20}=\\frac{0}{0},\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}-2x-8}{{x}^{2}+x-20} & =\\frac{(x+2)(x-4)}{(x+5)(x-4)} \\\\  & =\\frac{x+2}{x+5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to 4}\\frac{{x}^{2}-2x-8}{{x}^{2}+x-20} & ={lim}_{x\\to 4}\\frac{x+2}{x+5} \\\\  & =\\frac{4+2}{4+5} \\\\  & =\\frac{6}{9} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"} :step/id #uuid "b86c1506-fd97-5625-ace8-d8b15485c870" :step/next {:db/id #edb/ref 17592186541204}} {:db/id #edb/ref 17592186541227 :step/content {:db/id #edb/ref 17592186541105 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "077220d2-c11b-581c-9dc9-a863cd12de00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "54" :db/id #edb/ref 17592186540535} {:answer/id #uuid "086f31ad-a572-5058-91fc-e1dcee2b9771" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186540538} {:answer/id #uuid "34f2a82b-7c4f-54f8-b717-955f680377fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27}{2}" :db/id #edb/ref 17592186540610} {:answer/id #uuid "866ea189-c7fa-588c-bb97-2a9eac42cd76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186540753} {:answer/id #uuid "d4751cb2-aee2-5bbb-a97c-2800d912b17c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "27" :db/id #edb/ref 17592186540887}] :answer-field/correct {:db/id #edb/ref 17592186540610} :answer-field/id #uuid "81caaad2-536e-533e-be45-81a17e89437b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540996}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7aab1343-37d9-52dc-ba1f-d0f44020bf1c" :question/math-academy-id "q-140416" :question/problem "Evaluate ${lim}_{x\\to 3}\\frac{{x}^{3}-27}{2x-6}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 3}\\frac{{x}^{3}-27}{2x-6} & =\\frac{{3}^{3}-27}{2(3)-6}=\\frac{27-27}{6-6}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. \n\nNotice that the numerator is a difference of cubes. Therefore, factoring our expression, we get\n\n$$\n\\begin{aligned}\\frac{{x}^{3}-27}{2x-6} & =\\frac{{x}^{3}-{3}^{3}}{2(x-3)} \\\\  & =\\frac{(x-3)({x}^{2}+3x+{3}^{2})}{2(x-3)} \\\\  & =\\frac{{x}^{2}+3x+9}{2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to 3}\\frac{{x}^{3}-27}{2x-6} & ={lim}_{x\\to 3}\\frac{{x}^{2}+3x+9}{2} \\\\  & =\\frac{{3}^{2}+3(3)+9}{2} \\\\  & =\\frac{9+9+9}{2} \\\\  & =\\frac{27}{2}.\\end{aligned}\n$$"} :step/id #uuid "ed05f966-1db5-5d79-b616-775fcdf355c1"}] :activity/title "Calculating Limits of Rational Functions by Factoring" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186540513}]}
