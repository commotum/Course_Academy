#{[{:db/id #edb/ref 17592186110531 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110708 :knowledge-point/id #uuid "a70b1e82-4650-5de9-ad47-7578481b802a" :knowledge-point/title "Identifying a Square Root Function Containing One Translation"}] :question/id #uuid "04070131-1543-5516-a7f1-509ea3f01234" :question/math-academy-id "e-7937" :question/problem "Find the equation that generates the graph shown below. \n\n![](images/10/10f082165ef5b901e0ec43139fac54317395e1b349b31dd491dc36980981a622.png)" :question/worked-solution "To obtain the given graph, we perform the following transformations:\n\n- Take the graph of $y=\\sqrt{x}.$\n\n- Translate the graph to the left by $1$ unit to get the graph of $y=\\sqrt{x+1}.$\n\nThe result is the solid blue curve shown below. \n\n![](images/35/3561b98dcf8113dcb644b1f3c738821f74d9f453e268fb2d47f6379d41f31951.png)\n\nTherefore, the answer is $y=\\sqrt{x+1}.$"}] [{:db/id #edb/ref 17592186110532 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110709 :knowledge-point/id #uuid "d3425852-1b32-552e-baaf-bf53644e53b8" :knowledge-point/title "Identifying a Square Root Function Containing Two Translations"}] :question/id #uuid "0e964fdb-fa9e-516a-badf-2217a7937bc8" :question/math-academy-id "e-7938" :question/problem "The graph below is a translation of $y=\\sqrt{x}.$ Find the equation that generated the graph.    \n\n![](images/d7/d7705be833455f266e892f78ec29f0dee88a7e3e803a00f85dfdfd15ff5f6f92.png)" :question/worked-solution "To obtain the given graph, we can perform the following transformations:\n\n- Take the graph of $y=\\sqrt{x}.$\n\n- Translate the graph to the  left by $2$ units to get the graph of $y=\\sqrt{x+2}.$\n\n- Translate the result  down by $1$ unit to get the graph of $y=\\sqrt{x+2}-1.$\n\nThe result is the solid blue curve shown below.\n\n![](images/9a/9af181a909b6ed88cee9ab8d331a09378ed75cc85a33d0f156a5b89ac91796cf.png)\n\nTherefore, the answer is $y=\\sqrt{x+2}-1.$"}] [{:db/id #edb/ref 17592186110533 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110710 :knowledge-point/id #uuid "adbab69f-d3db-5162-9c21-0402b95e0c74" :knowledge-point/title "Graphing a Reflected Square Root Function Containing One Translation"}] :question/id #uuid "4ffc1494-2efd-581c-a58e-d1e9a8a2dfc4" :question/math-academy-id "e-7939" :question/problem "Sketch the graph of the function $f(x) =\\sqrt{2-x}.$" :question/worked-solution "First, let's re-write the expression as follows:\n\n$$\ny=\\sqrt{2-x}=\\sqrt{-(x-2)}\n$$\n\nTo obtain the graph of $y=\\sqrt{-(x-2)},$ we can perform the following transformations:\n\n- Take the graph of $y=\\sqrt{x}.$\n\n- Reflect the graph in the $y$-axis to get the graph of $y=\\sqrt{-x}.$\n\nThe result is the solid blue curve shown below.\n\n![](images/08/0848b7ecf37824cfb1eabe5b9b100cd3daf545887535e691eea62686bc99d973.png)\n\n- Translate the result to the right by $2$ units to get the graph of $y=\\sqrt{-(x-2)}.$\n\nThe result is the solid blue curve shown below.\n\n![](images/22/227210ee73219614d94bff78ddf7e0a8539dabfa2bc3b8f4778fa9292359c5f6.png)"}] [{:db/id #edb/ref 17592186110534 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110711 :knowledge-point/id #uuid "396377cb-7e23-5c95-9f9f-a33c210bc670" :knowledge-point/title "Graphing a Reflected Square Root Function Containing Two Translations"}] :question/id #uuid "bc4d0d1e-4cf6-5e3a-99b8-3613593fd0d3" :question/math-academy-id "e-7940" :question/problem "Find the equation that generated the graph below.\n\n![](images/16/16cbb1865575a8f1d968a065a3b9a09eb6fa3b998a24029d75713825cd5b7a2a.png)" :question/worked-solution "To obtain the given graph, we can perform the following transformations:\n\n- Take the graph of $y=\\sqrt{x}.$\n\n- Reflect the graph in the $x$-axis to get the graph of $y=-\\sqrt{x}.$\n\nThe result is the solid blue curve shown below.\n\n![](images/78/78b19415feaf4e648e0d49a7aa3a130db5a57cf23b4aeafbdc34e5a968a3bf0e.png)\n\n- Translate the result to the left by $1$ unit to get the graph of $y=-\\sqrt{x+1}.$\n\n- Translate the result up by $2$ units to get the graph of $y=-\\sqrt{x+1}+2.$\n\nThe result is the solid blue curve shown below.\n\n![](images/4f/4ffbc7f9dd9ec50830a671f4ce688f51f6a7a11663f0c93af567ee8cc9a4a4f4.png)\n\nTherefore, the correct answer is $y = -\\sqrt{x+1}+2.$"}] [{:db/id #edb/ref 17592186557241 :knowledge-point/_questions [{:db/id #edb/ref 17592186110708 :knowledge-point/id #uuid "a70b1e82-4650-5de9-ad47-7578481b802a" :knowledge-point/title "Identifying a Square Root Function Containing One Translation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09cf528c-8252-5a22-8998-109c93d6204b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{\\frac{x}{5}}" :db/id #edb/ref 17592186556452} {:answer/id #uuid "1830591e-8d7e-5b2f-b13a-73be57a52b29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{x-5}" :db/id #edb/ref 17592186556482} {:answer/id #uuid "1be93c4f-121e-539a-b9ba-12e7993eed42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{x}-5" :db/id #edb/ref 17592186556495} {:answer/id #uuid "801c7b34-bf18-5a46-8b9f-14a132e0191f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{x}+5" :db/id #edb/ref 17592186556725} {:answer/id #uuid "f503fe8a-d68c-52cd-a6a9-ff882dd0efc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{x+5}" :db/id #edb/ref 17592186557033}] :answer-field/correct {:answer/id #uuid "1be93c4f-121e-539a-b9ba-12e7993eed42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{x}-5" :db/id #edb/ref 17592186556495} :answer-field/id #uuid "ce9e8219-1157-56ea-bd3e-e4c614b1910f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557182}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "41c06b75-0eb3-5c66-92c4-5d80f2f59bde" :question/math-academy-id "q-115158" :question/problem "![](images/a9/a9c9324b8b15e38c1037d39a744a9e1d28796ea70a5d300563f9eaaaef966522.png)\n\nIdentify the equation that generated the graph shown above." :question/worked-solution "To obtain the given graph, we perform the following transformations:\n\n- Take the graph of $y=\\sqrt{x}.$\n\n- Translate the graph down by $5$ units to get the graph of $y=\\sqrt{x}-5.$\n\nThe result is the solid blue curve shown below.\n\n![](images/f0/f005ef005ce79b953aa61c01266ab4b9ba39c215169faf833bd91529f0e99c77.png)\n\nTherefore, the correct answer is $y=\\sqrt{x}-5.$"}] [{:db/id #edb/ref 17592186557299 :knowledge-point/_questions [{:db/id #edb/ref 17592186110709 :knowledge-point/id #uuid "d3425852-1b32-552e-baaf-bf53644e53b8" :knowledge-point/title "Identifying a Square Root Function Containing Two Translations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59287204-348a-50de-a654-4c533b517979" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b7/b71061d18f93259329b422ebd707694aeb55a927743403b93570d1d6374c14a9.png" :db/id #edb/ref 17592186556632} {:answer/id #uuid "613b7606-ecac-5b70-a24d-7e507d707861" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0b/0be12e475c36471a4e0cea7d4f21946bbc1853e1679d76a7238cf50d88c9632a.png" :db/id #edb/ref 17592186556652} {:answer/id #uuid "798c70bc-6741-5ad5-a130-7df97d91e3c3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d8/d8579523b133b169b65d483b2bfd44cec529abffd147f3fe9c16fcbaee7a69ac.png" :db/id #edb/ref 17592186556713} {:answer/id #uuid "c0bdcf9e-51a2-5fce-a56f-9be532e4b06c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :an