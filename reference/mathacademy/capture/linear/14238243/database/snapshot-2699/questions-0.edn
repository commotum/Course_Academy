{x+3}-1.$\n\nThe result is the solid blue curve shown below.\n\n![](images/b6/b6f0f056c74b60cc8a548ae14d10512c929f378285591996d440da97cb3ed19e.png)\n\nTherefore, the correct answer is $y=\\sqrt{x+3}-1.$"}] [{:db/id #edb/ref 17592186557261 :knowledge-point/_questions [{:db/id #edb/ref 17592186110709 :knowledge-point/id #uuid "d3425852-1b32-552e-baaf-bf53644e53b8" :knowledge-point/title "Identifying a Square Root Function Containing Two Translations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22d2e73f-09f1-5048-97c5-82f1287642c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{x-1}" :db/id #edb/ref 17592186556508} {:answer/id #uuid "3f997366-ef31-5f99-a11f-c1519e2ce8ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{x-1}+2" :db/id #edb/ref 17592186556571} {:answer/id #uuid "5f6789ed-43fb-5ee5-972c-3073b78cda82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{x+1}+1" :db/id #edb/ref 17592186556645} {:answer/id #uuid "a6d0b0ed-6f8f-5574-bd53-59667a48aaf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{x+1}+2" :db/id #edb/ref 17592186556838} {:answer/id #uuid "b34e0e20-0478-53c9-9213-6494e6a2364e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{x}+2" :db/id #edb/ref 17592186556871}] :answer-field/correct {:answer/id #uuid "3f997366-ef31-5f99-a11f-c1519e2ce8ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{x-1}+2" :db/id #edb/ref 17592186556571} :answer-field/id #uuid "e236862f-0a43-5394-a246-a343aae46e34" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557191}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6a7fd6db-b3ef-597a-8e12-d89a63fe1013" :question/math-academy-id "q-24089" :question/problem "![](images/66/66d61dadbaed0bb64bebc27286d2b574e63ce71c5c359a2da6b4f3f1a29ee6a9.png)\n\nThe graph above is a translation of $y=\\sqrt{x}.$ Identify the equation that generated the graph." :question/worked-solution "To obtain the given graph, we can perform the following transformations:\n\n- Take the graph of $y=\\sqrt{x}.$\n\n- Translate the graph to the right by $1$ unit to get the graph of $y=\\sqrt{x-1}.$\n\n- Translate the result up by $2$ units to get the graph of $y=\\sqrt{x-1}+2.$\n\nThe result is the solid blue curve shown below.\n\n![](images/ea/ea0e33e6af15954c3a58b873c82d7877bd3d82595feea8e51b273345309f3241.png)\n\nTherefore, the correct answer is $y=\\sqrt{x-1}+2.$"}] [{:db/id #edb/ref 17592186111013 :knowledge-point/_questions [{:db/id #edb/ref 17592186110708 :knowledge-point/id #uuid "a70b1e82-4650-5de9-ad47-7578481b802a" :knowledge-point/title "Identifying a Square Root Function Containing One Translation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ea6647e-0cb6-5bbd-a4fe-9947b42ce300" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d9/d90776d8b12b727af5f9045436ecf2ad385d40da9a5ec436fe4a4fc7302ca15e.png" :db/id #edb/ref 17592186107782} {:answer/id #uuid "c6f0b184-dfe4-5a12-a205-4a8d4dc10947" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c2/c24ba8ef36056ffebe3c06581af61b24c66300a3c9d23777533489728f337356.png" :db/id #edb/ref 17592186107783} {:answer/id #uuid "dc75a9e9-3932-567e-b31b-8333478939d4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7c/7cc31ba983d311d6d25bab56624d159002809debae90d7295c9405f982c975a2.png" :db/id #edb/ref 17592186107784} {:answer/id #uuid "fd128e2f-86e9-55c8-8ca4-7159074f4716" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/83/836e1284af20ad191bf28edd53b87ec2189c8864200c200782870692c1768892.png" :db/id #edb/ref 17592186107785} {:answer/id #uuid "19d1b0fa-0645-5dce-b678-77b48e611901" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d5/d55a89bc54f5e3e086bf67490c7c57f6d99133eb226a88e079bb2cc35d24099c.png" :db/id #edb/ref 17592186107786}] :answer-field/correct {:answer/id #uuid "fd128e2f-86e9-55c8-8ca4-7159074f4716" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/83/836e1284af20ad191bf28edd53b87ec2189c8864200c200782870692c1768892.png" :db/id #edb/ref 17592186107785} :answer-field/id #uuid "18238f24-74a4-5314-aeda-c3389e0409e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186107781}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f7d38e85-9320-5cc8-bab7-c5891248f38b" :question/math-academy-id "q-24153" :question/problem "Which of the following is the graph of $y=\\sqrt{x}-2?$" :question/worked-solution "To obtain the graph of $y=\\sqrt{x}-2,$ we can perform the following transformations:\n\n- Take the graph of $y=\\sqrt{x}.$\n\n- Translate the graph down by $2$ units to get the graph of $y=\\sqrt{x}-2.$\n\nThe result is the solid blue curve shown below.\n\n![](images/b2/b29dd00fae42bb810b95071e24ab395d9c5f9d3de967e6fa9541dcc0f93eaf80.png)"}] [{:db/id #edb/ref 17592186557234 :knowledge-point/_questions [{:db/id #edb/ref 17592186110711 :knowledge-point/id #uuid "396377cb-7e23-5c95-9f9f-a33c210bc670" :knowledge-point/title "Graphing a Reflected Square Root Function Containing Two Translations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f4b416f-f7e3-507c-938f-37652289351a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{1-x}+4" :db/id #edb/ref 17592186556505}] :answer-field/correct {:answer/id #uuid "1f4b416f-f7e3-507c-938f-37652289351a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{1-x}+4" :db/id #edb/ref 17592186556505} :answer-field/id #uuid "0c113b2a-ad23-5780-9cce-e37da6147575" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186557070}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3a8011cb-eb86-5ec9-8024-d1a5101b449a" :question/math-academy-id "q-279985" :question/problem "![](images/06/062562ff86719e1ea820642d424ac93705eb56f3ec9f49adbd09108735d4e284.png)\n\nThe graph above is a result of the reflection and translation of $y=\\sqrt{x}.$ Identify the equation that generated the graph.\n\n$y=$\n{{field-1}}" :question/worked-solution "To obtain the given graph, we can perform the following transformations:\n\n- Take the graph of $y=\\sqrt{x}.$\n\n- Reflect the graph in the $y$-axis to get the graph of $y=\\sqrt{-x}.$\n\nThe result is the solid blue curve shown below.\n\n![](images/30/30add2e841bb25faa97692ec22309482c9b18d8c55f878057978f0896f7420ea.png)\n\n- Reflect the graph in the $x$-axis to get the graph of $y=-\\sqrt{-x}.$\n\nThe result is the solid blue curve shown below.\n\n![](images/0b/0bab48c1fe5e6d1a0d90b1aae3c8cd123327d1b2e18ca8101e056726b76de002.png)\n\n- Translate the result to the right by $1$ units to get the graph of $y=-\\sqrt{-(x-1)}.$\n\n- Translate the result up by $4$ units to get the graph of $y=-\\sqrt{-(x-1)}+4.$\n\nThe result is the solid blue curve shown below.\n\n![](images/57/572a818b9621f8cec26f815429ff6d6e2846686afa348c7ae5a767dbd42fd3f6.png)\n\nTherefore, the correct answer is $y=-\\sqrt{-(x-1)}+4.$"}] [{:db/id #edb/ref 17592186557272 :knowledge-point/_questions [{:db/id #edb/ref 17592186110710 :knowledge-point/id #uuid "adbab69f-d3db-5162-9c21-0402b95e0c74" :knowledge-point/title "Graphing a Reflected Square Root Function Containing One Translation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b91cf26b-c838-5e5d-aa06-fc66092081b3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ab/ab7ae0789e9d434b24a6f00b77bde26514fac1a375fe406d567c6f8560661d36.png" :db/id #edb/ref 17592186556881} {:answer/id #uuid "c12b47a2-9d98-55dd-aa4e-1bd6ee49e769" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ea/ea43acbcaa5eaf10fef44753863bafed13f64bc684f06fbd60268deee23800ea.png" :db/id #edb/ref 17592186556894} {:answer/id #uuid "d71d8ced-67cb-5b4f-bc7b-de4475da4fe8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c2/c284d316ccc20ff2a3f790fe7573b0250a6b2430b778e3c8e0fe7081368e3106.png" :db/id #edb/ref 17592186556958} {:answer/id #uuid "ef4a2f03-57e0-5d1f-8907-f7f6963d369c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/00/009bd2b9fe689cb44c0bb4bbf5ccc21b3c7bd347b3bfc112ea34a15d0fd58cd5.png" :db/id #edb/ref 17592186557019} {:answer/id #uuid "ff3d60c5-46d8-578c-bb51-151bc60afbf1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1b/1b50a13e835d1c467cb596c8364dc6a15e406fa4568b5953836e3788624bb3b3.png" :db/id #edb/ref 17592186557059}] :answer-field/correct {:answer/id #uuid "b91cf26b-c838-5e5d-aa06-fc66092081b3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ab/ab7ae0789e9d434b24a6f00b77bde26514fac1a375fe406d567c6f8560661d36.png" :db/id #edb/ref 17592186556881} :answer-field/id #uuid "4cfcd9be-e783-55b0-99ea-fba6321bdddf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557108}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "78215167-343c-5511-b0e2-4a5f5a4ce03b" :question/math-academy-id "q-38384" :question/problem "Which of the following is the graph of $y=\\sqrt{-x}-1?$" :question/worked-solution "To obtain the graph of $y=\\sqrt{-x}-1,$ we can perform the following transformations:\n\n- Take the graph of $y=\\sqrt{x}.$\n\n- Reflect the graph in the $y$-axis to get the graph of $y=\\sqrt{-x}.$\n\nThe result is the solid blue curve shown below.\n\n![](images/d0/d078ff010c5bb8a05bfe08bd6585ebb334bda324c69f7c8498bde38dbd8cd234.png)\n\n- Translate the result down by $1$ unit to get the graph of $y=\\sqrt{-x}-1.$\n\nThe result is the solid blue curve shown below.\n\n![](images/28/2832645bc8cac13094899294dcd0cb45b24fb0da8339d5bc9e1e2c055aaee2b8.png)"}] [{:db/id #edb/ref 17592186111163 :knowledge-point/_questions [{:db/id #edb/ref 17592186110710 :knowledge-point/id #uuid "adbab69f-d3db-5162-9c21-0402b95e0c74" :knowledge-point/title "Graphing a Reflected Square Root Function Containing One Translation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "963f02d1-73d7-5f08-98d8-8a22cc874cb8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/15/156907581e915495fb382a24fbd47d89a4d7b6e61ce590667e87bec607d74835.png" :db/id #edb/ref 17592186108704} {:answer/id #uuid "af356d84-ad8e-50d9-b7a5-cb4db2dca717" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/00/009bd2b9fe689cb44c0bb4bbf5ccc21b3c7bd347b3bfc112ea34a15d0fd58cd5.png" :db/id #edb/ref 17592186108705} {:answer/id #uuid "cc1a15c3-176a-5276-8829-8127fd83a205" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c4/c405cf4c2772a3ca38e76bf0b8a3363f0ae5cc6777110436741fcc8777deaefb.png" :db/id #edb/ref 17592186108706} {:answer/id #uuid "1e85f0f9-5093-509f-b6d5-89d20ac3fe2c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6a/6a3717a85c76d0c969184f2cd6d67bca0e394e73d73e2b0e1f9bac54ef47b0c0.png" :db/id #edb/ref 17592186108707} {:answer/id #uuid "3f62843f-3df7-5523-adf2-a4d30f0843da" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ea/ea43acbcaa5eaf10fef44753863bafed13f64bc684f06fbd60268deee23800ea.png" :db/id #edb/ref 17592186108708}] :answer-field/correct {:answer/id #uuid "cc1a15c3-176a-5276-8829-8127fd83a205" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c4/c405cf4c2772a3ca38e76bf0b8a3363f0ae5cc6777110436741fcc8777deaefb.png" :db/id #edb/ref 17592186108706} :answer-field/id #uuid "5e81ac9a-016a-5a10-8641-c99509fb22e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186108703}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4ac10221-24ce-5dfe-9994-3541ffaea81d" :question/math-academy-id "q-38649" :question/problem "Which of the following is the graph of $y=\\sqrt{-x-1}?$" :question/worked-solution "First, let's re-write the expression, as follows:\n\n$$\ny=\\sqrt{-x-1}=\\sqrt{-(x+1)}\n$$\n\nTo obtain the graph of $y=\\sqrt{-(x+1)},$ we can perform the following transformations:\n\n- Take the graph of $y=\\sqrt{x}.$\n\n- Reflect the graph in the $y$-axis to get the graph of $y=\\sqrt{-x}.$\n\nThe result is the solid blue curve shown below.\n\n![](images/d0/d078ff010c5bb8a05bfe08bd6585ebb334bda324c69f7c8498bde38dbd8cd234.png)\n\n- Translate the result to the left by $1$ unit to get the graph of $y=\\sqrt{-(x+1)}.$\n\nThe result is the solid blue curve shown below.\n\n![](images/2f/2fcd6900faf5246202403591c333f30a04ad6d5f51894ab509c229234976fc5b.png)"}] [{:db/id #edb/ref 17592186557322 :knowledge-point/_questions [{:db/id #edb/ref 17592186110709 :knowledge-point/id #uuid "d3425852-1b32-552e-baaf-bf53644e53b8" :knowledge-point/title "Identifying a Square Root Function Containing Two Translations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "787344e4-b447-57a7-b4ab-f0b3ca9a7e30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{x-1}-4" :db/id #edb/ref 17592186556704} {:answer/id #uuid "83a63546-1c86-5fdd-b5e6-15e0d840c41e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{x+1}-4" :db/id #edb/ref 17592186556737} {:answer/id #uuid "9dacab61-ec81-533d-9df5-e7d815ecdd26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{x+1}+4" :db/id #edb/ref 17592186556815} {:answer/id #uuid "b94769dc-ce89-5881-a817-ef1b9a663e1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4\\sqrt{x}+1" :db/id #edb/ref 17592186556883} {:answer/id #uuid "e6d47743-3746-5c66-9e17-1fccd6a15b0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{x+4}-1" :db/id #edb/ref 17592186557001}] :answer-field/correct {:answer/id #uuid "83a63546-1c86-5fdd-b5e6-15e0d840c41e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\sqrt{x+1}-4" :db/id #edb/ref 17592186556737} :answer-field/id #uuid "04596443-fde1-5423-b9f3-18ec31b9269d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557064}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eb053305-3f48-5a05-bfa6-336398fa92e3" :question/math-academy-id "q-3889" :question/problem "![](images/40/406bfedb1113d8e953fcac9739a144027a592ac5d7e2409604147a1b7f258a02.png)\n\nThe graph above is a translation of $y=\\sqrt{x}.$ Identify the equation that generated the graph." :question/worked-solution "To obtain the given graph, we can perform the following transformations:\n\n- Take the graph of $y=\\sqrt{x}.$\n\n- Translate the graph to the left by $1$ unit to get the graph of $y=\\sqrt{x+1}.$\n\n- Translate the result down by $4$ units to get the graph of $y=\\sqrt{x+1}-4.$\n\nThe result is the solid blue curve shown below.\n\n![](images/7e/7ef3c8f48902dda0c80fb5fbd3db74dee4cd3ea71c2711878911f6bb0090d730.png)\n\nTherefore, the correct answer is $y=\\sqrt{x+1}-4.$"}] [{:db/id #edb/ref 17592186557225 :knowledge-point/_questions [{:db/id #edb/ref 17592186110711 :knowledge-point/id #uuid "396377cb-7e23-5c95-9f9f-a33c210bc670" :knowledge-point/title "Graphing a Reflected Square Root Function Containing Two Translations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e71492d-7e4b-506c-b7fb-5427c68ca906" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ce/ceff2bebf692a1db8d0edb938543498d3930f29a1cc551f005bf8ac3b57f63d5.png" :db/id #edb/ref 17592186556500} {:answer/id #uuid "8545f868-355a-5980-bf30-3d293d470f6b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/be/be7b05a412acafde6ddb2c09e6df8731a078b46d38a8a722f57564043e40cd1f.png" :db/id #edb/ref 17592186556744} {:answer/id #uuid "a605914d-130d-5995-b05e-d6ca34faf0a1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/15/159ea04f3e69844b91c8bb2b4739a27f604ed30f4fb1081fa0b7e95565ea6051.png" :db/id #edb/ref 17592186556835} {:answer/id #uuid "c78771ee-cdbc-50e4-b2a2-d26c0253edf0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fe/fe3bed5784852da3bc18e4f277a1195a173b0168e08bb64f01c3c4f0641685aa.png" :db/id #edb/ref 17592186556911} {:answer/id #uuid "ec96415f-9c0c-577f-9429-ab697ff9d175" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/77/77eefc762f37b11fc65d942b5f6dd733ba60620f4a704936525bc3d69d6738e8.png" :db/id #edb/ref 17592186557013}] :answer-field/correct {:answer/id #uuid "ec96415f-9c0c-577f-9429-ab697ff9d175" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/77/77eefc762f37b11fc65d942b5f6dd733ba60620f4a704936525bc3d69d6738e8.png" :db/id #edb/ref 17592186557013} :answer-field/id #uuid "19b830fb-2397-5027-b124-14a89d3a6a96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557082}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2cdfaece-91e9-59d5-8fba-ab96089ab7a5" :question/math-academy-id "q-89802" :question/problem "Which of the following is the graph of $y=-\\sqrt{1-x}-1?$" :question/worked-solution "First, let's re-write the expression, as follows:\n\n$$\ny=-\\sqrt{1-x}-1=-\\sqrt{-(x-1)}-1\n$$\n\nTo get the graph of $y=-\\sqrt{-(x-1)}-1,$ we can do the following transformations:\n\n- Take the graph of $y=\\sqrt{x}.$\n\n- Reflect the graph in the $y$-axis to get the graph of $y=\\sqrt{-x}.$\n\nThe result is the solid blue curve shown below.\n\n![](images/85/854a720d691342b87a7f390176cdc60cf5d68d8863a755fed8929dbd3fecd655.png)\n\n- Reflect the graph in the $x$-axis to get the graph of $y=-\\sqrt{-x}.$\n\nThe result is the solid blue curve shown below.\n\n![](images/b5/b5c145b598e3311edf3f9f6958245bd7a6b5a875e476d2f383e7c1c394f80538.png)\n\n- Translate the result to the right by $1$ unit to get the graph of $y=-\\sqrt{-(x-1)}.$\n\n- Translate the result down by $1$ unit to get the graph of $y=-\\sqrt{-(x-1)}-1.$\n\nThe result is the solid blue curve shown below.\n\n![](images/7a/7a7c548b2d93636bb00902b62a37fd75fc7aceea00c71574d7761b46775eb844.png)"}]}
