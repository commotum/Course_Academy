#{[{:db/id #edb/ref 17592186110531 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110708 :knowledge-point/id #uuid "a70b1e82-4650-5de9-ad47-7578481b802a" :knowledge-point/title "Identifying a Square Root Function Containing One Translation"}] :question/id #uuid "04070131-1543-5516-a7f1-509ea3f01234" :question/math-academy-id "e-7937" :question/problem "Find the equation that generates the graph shown below.\n\n![](images/10/10f082165ef5b901e0ec43139fac54317395e1b349b31dd491dc36980981a622.png)" :question/worked-solution "To obtain the given graph, we perform the following transformations:\n\n- Take the graph of $y=\\sqrt{x}$.\n- Translate the graph to the left by $1$ unit to get the graph of $y=\\sqrt{x+1}$.\n\nThe result is the solid blue curve shown below.\n\n![](images/35/3561b98dcf8113dcb644b1f3c738821f74d9f453e268fb2d47f6379d41f31951.png)\n\nTherefore, the answer is\n\n$$\ny=\\sqrt{x+1}\n$$"}] [{:db/id #edb/ref 17592186110532 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110709 :knowledge-point/id #uuid "d3425852-1b32-552e-baaf-bf53644e53b8" :knowledge-point/title "Identifying a Square Root Function Containing Two Translations"}] :question/id #uuid "0e964fdb-fa9e-516a-badf-2217a7937bc8" :question/math-academy-id "e-7938" :question/problem "The graph below is a translation of $y=\\sqrt{x}$. Find the equation that generated the graph.\n\n![](images/d7/d7705be833455f266e892f78ec29f0dee88a7e3e803a00f85dfdfd15ff5f6f92.png)" :question/worked-solution "To obtain the given graph, we can perform the following transformations:\n\n- Take the graph of $y=\\sqrt{x}$.\n- Translate the graph to the left by $2$ units to get the graph of $y=\\sqrt{x+2}$.\n- Translate the result down by $1$ unit to get the graph of $y=\\sqrt{x+2}-1$.\n\nThe result is the solid blue curve shown below.\n\n![](images/9a/9af181a909b6ed88cee9ab8d331a09378ed75cc85a33d0f156a5b89ac91796cf.png)\n\nTherefore, the answer is\n\n$$\ny=\\sqrt{x+2}-1\n$$"}] [{:db/id #edb/ref 17592186110533 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110710 :knowledge-point/id #uuid "adbab69f-d3db-5162-9c21-0402b95e0c74" :knowledge-point/title "Graphing a Reflected Square Root Function Containing One Translation"}] :question/id #uuid "4ffc1494-2efd-581c-a58e-d1e9a8a2dfc4" :question/math-academy-id "e-7939" :question/problem "Sketch the graph of the function $f(x) =\\sqrt{2-x}$." :question/worked-solution "First, let's re-write the expression as follows:\n\n$$\ny=\\sqrt{2-x}=\\sqrt{-(x-2)}\n$$\n\nTo obtain the graph of\n\n$$\ny=\\sqrt{-(x-2)}\n$$\n\nwe can perform the following transformations:\n\n- Take the graph of $y=\\sqrt{x}$.\n- Reflect the graph in the $y$-axis to get the graph of $y=\\sqrt{-x}$.\n\nThe result is the solid blue curve shown below.\n\n![](images/08/0848b7ecf37824cfb1eabe5b9b100cd3daf545887535e691eea62686bc99d973.png)\n\n- Translate the result to the right by $2$ units to get the graph of $y=\\sqrt{-(x-2)}$.\n\nThe result is the solid blue curve shown below.\n\n![](images/22/227210ee73219614d94bff78ddf7e0a8539dabfa2bc3b8f4778fa9292359c5f6.png)"}] [{:db/id #edb/ref 17592186110534 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110711 :knowledge-point/id #uuid "396377cb-7e23-5c95-9f9f-a33c210bc670" :knowledge-point/title "Graphing a Reflected Square Root Function Containing Two Translations"}] :question/id #uuid "bc4d0d1e-4cf6-5e3a-99b8-3613593fd0d3" :question/math-academy-id "e-7940" :question/problem "Find the equation that generated the graph below.\n\n![](images/16/16cbb1865575a8f1d968a065a3b9a09eb6fa3b998a24029d75713825cd5b7a2a.png)" :question/worked-solution "To obtain the given graph, we can perform the following transformations:\n\n- Take the graph of $y=\\sqrt{x}$.\n- Reflect the graph in the $x$-axis to get the graph of $y=-\\sqrt{x}$.\n\nThe result is the solid blue curve shown below.\n\n![](images/78/78b19415feaf4e648e0d49a7aa3a130db5a57cf23b4aeafbdc34e5a968a3bf0e.png)\n\n- Translate the result to the left by $1$ unit to get the graph of $y=-\\sqrt{x+1}$.\n- Translate the result up by $2$ units to get the graph of $y=-\\sqrt{x+1}+2$.\n\nThe result is the solid blue curve shown below.\n\n![](images/4f/4ffbc7f9dd9ec50830a671f4ce688f51f6a7a11663f0c93af567ee8cc9a4a4f4.png)\n\nTherefore, the correct answer is\n\n$$\ny = -\\sqrt{x+1}+2\n$$"}] [{:db/id #edb/ref 17592186111013 :knowledge-point/_questions [{:db/id #edb/ref 17592186110708 :knowledge-point/id #uuid "a70b1e82-4650-5de9-ad47-7578481b802a" :knowledge-point/title "Identifying a Square Root Function Containing One Translation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ea6647e-0cb6-5bbd-a4fe-9947b42ce300" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d9/d90776d8b12b727af5f9045436ecf2ad385d40da9a5ec436fe4a4fc7302ca15e.png" :db/id #edb/ref 17592186107782} {:answer/id #uuid "c6f0b184-dfe4-5a12-a205-4a8d4dc10947" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c2/c24ba8ef36056ffebe3c06581af61b24c66300a3c9d23777533489728f337356.png" :db/id #edb/ref 17592186107783} {:answer/id #uuid "dc75a9e9-3932-567e-b31b-8333478939d4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7c/7cc31ba983d311d6d25bab56624d159002809debae90d7295c9405f982c975a2.png" :db/id #edb/ref 17592186107784} {:answer/id #uuid "fd128e2f-86e9-55c8-8ca4-7159074f4716" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/83/836e1284af20ad191bf28edd53b87ec2189c8864200c200782870692c1768892.png" :db/id #edb/ref 17592186107785} {:answer/id #uuid "19d1b0fa-0645-5dce-b678-77b48e611901" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d5/d55a89bc54f5e3e086bf67490c7c57f6d99133eb226a88e079bb2cc35d24099c.png" :db/id #edb/ref 17592186107786}] :answer-field/id #uuid "18238f24-74a4-5314-aeda-c3389e0409e8"