[17592186049859 #edb/ref 1033 379 #edb/ref 17592186045417] [17592186049859 #edb/ref 1035 #uuid "192bf4e3-cb05-59d7-b07e-d2c2a92f6a25" #edb/ref 17592186045417] [17592186049865 #edb/ref 1027 #edb/ref 17592186048964 #edb/ref 17592186045417] [17592186049865 #edb/ref 1028 #edb/ref 17592186068869 #edb/ref 17592186045417] [17592186049865 #edb/ref 1028 #edb/ref 17592186068870 #edb/ref 17592186045417] [17592186049865 #edb/ref 1028 #edb/ref 17592186068871 #edb/ref 17592186045417] [17592186049865 #edb/ref 1028 #edb/ref 17592186068872 #edb/ref 17592186045417] [17592186049865 #edb/ref 1031 "Converting From Logarithmic to Exponential Form" #edb/ref 17592186045417] [17592186049865 #edb/ref 1033 457 #edb/ref 17592186045417] [17592186049865 #edb/ref 1035 #uuid "199474d1-056b-5893-9b64-b81d744c2685" #edb/ref 17592186045417] [17592186050495 #edb/ref 1027 #edb/ref 17592186048599 #edb/ref 17592186045417] [17592186050495 #edb/ref 1027 #edb/ref 17592186050511 #edb/ref 17592186045417] [17592186050495 #edb/ref 1027 #edb/ref 17592186050668 #edb/ref 17592186045417] [17592186050495 #edb/ref 1028 #edb/ref 17592186176090 #edb/ref 17592186045417] [17592186050495 #edb/ref 1028 #edb/ref 17592186176091 #edb/ref 17592186045417] [17592186050495 #edb/ref 1028 #edb/ref 17592186176092 #edb/ref 17592186045417] [17592186050495 #edb/ref 1031 "Negative Exponents" #edb/ref 17592186045417] [17592186050495 #edb/ref 1033 3561 #edb/ref 17592186045417] [17592186050495 #edb/ref 1035 #uuid "4dbeffe2-9f1b-50ed-8f1c-59e3cce889c3" #edb/ref 17592186045417] [17592186064060 #edb/ref 1069 "e-3971" #edb/ref 17592186045417] [17592186064060 #edb/ref 1071 "Express $2^4 = 16$ in logarithmic form." #edb/ref 17592186045417] [17592186064060 #edb/ref 1072 #uuid "6200912b-0686-50bb-8ce8-dd793f3cc3f7" #edb/ref 17592186045417] [17592186064060 #edb/ref 1074 "The logarithm of $a$ with base $b$ is defined as follows:\n\n> $a = b^x$ is equivalent to $\\log_{b}{a} = x$\n\nIf we compare $2^4 = 16$ with $a = b^x$, we get $a = 16$, $b = 2$, and $x = 4$.\n\nTherefore, the equation $2^4 = 16$ can be expressed as\n\n$$\n\\log_{2}{16} = 4\n$$" #edb/ref 17592186045417] [17592186064061 #edb/ref 1069 "e-3974" #edb/ref 17592186045417] [17592186064061 #edb/ref 1071 "Express $\\sqrt[3]{5} \\approx 1.709$ in an equivalent logarithmic form." #edb/ref 17592186045417] [17592186064061 #edb/ref 1072 #uuid "dd2d0092-e56d-5245-95b4-a1f73dac284b" #edb/ref 17592186045417] [17592186064061 #edb/ref 1074 "Notice that the given approximation can be written using exponents:\n\n$$\n5^{1/3} \\approx 1.709\n$$\n\nThe logarithm of $a$ with base $b$ is defined as follows:\n\n> $a = b^x$ is equivalent to $\\log_{b}{a} = x$\n\nIf we compare\n\n$$\n5^{1/3} \\approx 1.709\n$$\n\nwith $a = b^x$, we get\n\n$$\na = 1.709, b = 5\n$$\n\nand\n\n$$\nx=\\dfrac{1}{3}\n$$\n\nTherefore, the approximation\n\n$$\n\\sqrt[3]{5} \\approx 1.709\n$$\n\nis equivalent to\n\n$$\n\\log_{5}(1.709) \\approx \\dfrac{1}{3}\n$$" #edb/ref 17592186045417] [17592186064062 #edb/ref 1069 "e-3975" #edb/ref 17592186045417] [17592186064062 #edb/ref 1071 "Express $2^{-5} = \\dfrac{1}{32}$ in logarithmic form." #edb/ref 17592186045417] [17592186064062 #edb/ref 1072 #uuid "79cab436-4a4a-55ee-b584-faf87280ff64" #edb/ref 17592186045417] [17592186064062 #edb/ref 1074 "The logarithm of $a$ with base $b$ is defined as follows:\n\n> $a = b^x$ is equivalent to $\\log_{b}{a} = x$\n\nIf we compare\n\n$$\n2^{-5} = \\dfrac{1}{32}\n$$\n\nwith $a = b^x$, we get\n\n$$\na = \\dfrac{1}{32}, b = 2\n$$\n\nand $x=-5$.\n\nTherefore, the given equation can be expressed as\n\n$$\n\\log_{2}\\left(\\dfrac{1}{32} \\right)= -5\n$$" #edb/ref 17592186045417] [17592186064063 #edb/ref 1069 "e-3976" #edb/ref 17592186045417] [17592186064063 #edb/ref 1071 "Express $7^0 = 1$ in logarithmic form." #edb/ref 17592186045417] [17592186064063 #edb/ref 1072 #uuid "df39de4a-3296-5ce5-8a5a-a83c8f995cf4" #edb/ref 17592186045417] [17592186064063 #edb/ref 1074 "The logarithm of $a$ with base $b$ is defined as follows:\n\n> $a = b^x$ is equivalent to $\\log_{b}{a} = x$\n\nIf we compare $7^0 = 1$ with $a = b^x$, we get\n\n$$\na = 1, b = 7\n$$\n\nand $x=0$.\n\nTherefore, the equation $7^0 = 1$ is equivalent to\n\n$$\n\\log_{7}{1}= 0\n$$\n\nIn general,\n\n$$\n\\log_n(1) = 0\n$$\n\nfor any\n\n$$\nn>0, n\\neq 1\n$$" #edb/ref 17592186045417] [17592186064184 #edb/ref 1037 #edb/ref 17592186049714 #edb/ref 17592186045417] [17592186064184 #edb/ref 1038 #edb/ref 17592186064710 #edb/ref 17592186045417] [17592186064184 #edb/ref 1038 #edb/ref 17592186064711 #edb/ref 17592186045417] [17592186064184 #edb/ref 1039 "Converting Equations From Exponential Form to Logarithmic Form" #edb/ref 17592186045417] [17592186064184 #edb/ref 1041 #edb/ref 17592186064060 #edb/ref 17592186045417] [17592186064184 #edb/ref 1042 #uuid "bea0b2f4-c3cc-5cd5-a259-ff987711d6f4" #edb/ref 17592186045417] [17592186064186 #edb/ref 1037 #edb/ref 17592186049089 #edb/ref 17592186045417] [17592186064186 #edb/ref 1038 #edb/ref 17592186064935 #edb/ref 17592186045417] [17592186064186 #edb/ref 1038 #edb/ref 17592186064938 #edb/ref 17592186045417] [17592186064186 #edb/ref 1038 #edb/ref 17592186234204 #edb/ref 17592186045417] [17592186064186 #edb/ref 1038 #edb/ref 17592186234512 #edb/ref 17592186045417] [17592186064186 #edb/ref 1039 "Converting Equations With Radicals Into Logarithmic Form" #edb/ref 17592186045417] [17592186064186 #edb/ref 1041 #edb/ref 17592186064061 #edb/ref 17592186045417] [17592186064186 #edb/ref 1042 #uuid "b514d4ef-68ad-5fd4-b802-e61ca86aec2c" #edb/ref 17592186045417] [17592186064187 #edb/ref 1037 #edb/ref 17592186050495 #edb/ref 17592186045417] [17592186064187 #edb/ref 1038 #edb/ref 17592186064936 #edb/ref 17592186045417] [17592186064187 #edb/ref 1038 #edb/ref 17592186064937 #edb/ref 17592186045417] [17592186064187 #edb/ref 1039 "Converting Equations With Negative Powers From Exponential Form to Logarithmic Form" #edb/ref 17592186045417] [17592186064187 #edb/ref 1041 #edb/ref 17592186064062 #edb/ref 175921860454