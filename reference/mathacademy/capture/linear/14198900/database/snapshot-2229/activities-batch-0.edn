on/id #uuid "79cab436-4a4a-55ee-b584-faf87280ff64" :question/math-academy-id "e-3975"} :knowledge-point/id #uuid "21af4820-89b6-5931-86ed-84ec6bc973bc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050495}] :knowledge-point/questions [{:db/id #edb/ref 17592186064936} {:db/id #edb/ref 17592186064937} {:db/id #edb/ref 17592186514382} {:db/id #edb/ref 17592186514456}] :knowledge-point/title "Converting Equations With Negative Powers From Exponential Form to Logarithmic Form"} :step/id #uuid "dcc23e94-3ee0-58a9-b2f0-f64588a9d011" :step/math-academy-id 13983 :step/next {:db/id #edb/ref 17592186065034}} {:db/id #edb/ref 17592186065029 :step/content {:db/id #edb/ref 17592186064188 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064063 :question/id #uuid "df39de4a-3296-5ce5-8a5a-a83c8f995cf4" :question/math-academy-id "e-3976"} :knowledge-point/id #uuid "c75abcbb-bd77-5d0f-af35-1c849a178f68" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048262}] :knowledge-point/questions [{:db/id #edb/ref 17592186064933} {:db/id #edb/ref 17592186064934} {:db/id #edb/ref 17592186514431} {:db/id #edb/ref 17592186514476}] :knowledge-point/title "Converting Equations From Exponential Form to Logarithmic Form with Exponents of Zero or One"} :step/id #uuid "7676fb8a-e4a5-5c86-861b-29726b6f4646" :step/math-academy-id 13984 :step/next {:db/id #edb/ref 17592186065028}} {:db/id #edb/ref 17592186065034 :step/content {:db/id #edb/ref 17592186065351 :tutorial/content "What logarithmic equation is equivalent to the equation $\\sqrt{4} = 2 ?$\n\nNotice that the given equation can be written using exponents as\n\n$$\n4^{1/2} = 2.\n$$\n\nThe logarithm of $a$ with base $b$ is defined as follows:\n\n$a = b^x$ is equivalent to $\\log_{b}{a} = x$\n\nIf we compare $4^{1/2} = 2$ with $a = b^x,$ we get $a = 2, b = 4,$ and $x=\\dfrac{1}{2}.$\n\nTherefore, the equation $\\sqrt{4} = 2$ is equivalent to $\\log_{4}{2}= \\dfrac{1}{2}.$" :tutorial/id #uuid "689eb94a-47df-5cd0-9019-d100d1621193" :tutorial/math-academy-id 2780 :tutorial/title "Converting Equations With Radicals Into Logarithmic Form"} :step/id #uuid "a24545f5-76c6-581e-99d9-e9b0034c2475" :step/math-academy-id 14167 :step/next {:db/id #edb/ref 17592186065027}} {:db/id #edb/ref 17592186065043 :step/content {:db/id #edb/ref 17592186065354 :tutorial/content "A **logarithm** (or log) is an operation that's the *inverse* of exponentiation. \n\nFor example, we know that ${\\color{blue}{2}}^{\\color{red}{3}} = 8.$ But we can also write this using a logarithm as\n\n$$\n\\log_{\\color{blue}{2}}(8) = {\\color{red}{3}}.\n$$\n\nIn words, we would say \"log of $8$ with base ${\\color{blue}{2}}$ equals ${\\color{red}{3}}$\". The **base** of the logarithm is always the base of the exponential expression.\n\nSince exponents and logarithms are opposite operations, an exponential equation can always be expressed in logarithmic form, and vice versa.\n\nIn general, the logarithm of $a$ with positive base $b \\neq 1$ is defined as follows:\n\n$a = {\\color{blue}b}^{\\color{red}x}$ is equivalent to $\\log_{\\color{blue}b}{a} = {\\color{red}x}.$" :tutorial/id #uuid "4581c0d9-ad31-511c-a9d0-00d5ae0d5e38" :tutorial/math-academy-id 2863 :tutorial/title "Introduction"} :step/id #uuid "e9ebe7f3-c1dc-5c5b-9736-209a7e1ed0c3" :step/math-academy-id 15296 :step/next {:db/id #edb/ref 17592186065025}}] :activity/title "Converting From Exponential to Logarithmic Form" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064463}]}
