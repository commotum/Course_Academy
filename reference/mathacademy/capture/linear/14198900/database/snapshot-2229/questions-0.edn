#{[{:db/id #edb/ref 17592186064060 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064184 :knowledge-point/id #uuid "bea0b2f4-c3cc-5cd5-a259-ff987711d6f4" :knowledge-point/title "Converting Equations From Exponential Form to Logarithmic Form"}] :question/id #uuid "6200912b-0686-50bb-8ce8-dd793f3cc3f7" :question/math-academy-id "e-3971" :question/problem "Express $2^4 = 16$ in logarithmic form." :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$a = b^x$ is equivalent to $\\log_{b}{a} = x$\n\nIf we compare $2^4 = 16$ with $a = b^x,$ we get $a = 16,$ $b = 2,$ and $x = 4.$\n\nTherefore, the equation $2^4 = 16$ can be expressed as $\\log_{2}{16} = 4.$"}] [{:db/id #edb/ref 17592186064061 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064186 :knowledge-point/id #uuid "b514d4ef-68ad-5fd4-b802-e61ca86aec2c" :knowledge-point/title "Converting Equations With Radicals Into Logarithmic Form"}] :question/id #uuid "dd2d0092-e56d-5245-95b4-a1f73dac284b" :question/math-academy-id "e-3974" :question/problem "Express $\\sqrt[3]{5} \\approx 1.709$ in an equivalent logarithmic form." :question/worked-solution "Notice that the given approximation can be written using exponents:\n\n$$\n5^{1/3} \\approx 1.709\n$$\n\nThe logarithm of $a$ with base $b$ is defined as follows:\n\n$a = b^x$ is equivalent to $\\log_{b}{a} = x$\n\nIf we compare $5^{1/3} \\approx 1.709$ with $a = b^x,$ we get $a = 1.709, b = 5,$ and $x=\\dfrac{1}{3}.$\n\nTherefore, the approximation $\\sqrt[3]{5} \\approx 1.709$ is equivalent to $\\log_{5}(1.709) \\approx \\dfrac{1}{3}.$"}] [{:db/id #edb/ref 17592186064062 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064187 :knowledge-point/id #uuid "21af4820-89b6-5931-86ed-84ec6bc973bc" :knowledge-point/title "Converting Equations With Negative Powers From Exponential Form to Logarithmic Form"}] :question/id #uuid "79cab436-4a4a-55ee-b584-faf87280ff64" :question/math-academy-id "e-3975" :question/problem "Express $2^{-5} = \\dfrac{1}{32}$ in logarithmic form." :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$a = b^x$ is equivalent to $\\log_{b}{a} = x$\n\nIf we compare $2^{-5} = \\dfrac{1}{32}$ with $a = b^x,$ we get $a = \\dfrac{1}{32}, b = 2,$ and $x=-5.$\n\nTherefore, the given equation can be expressed as $\\log_{2}\\left( \\dfrac{1}{32} \\right)= -5.$"}] [{:db/id #edb/ref 17592186064063 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064188 :knowledge-point/id #uuid "c75abcbb-bd77-5d0f-af35-1c849a178f68" :knowledge-point/title "Converting Equations From Exponential Form to Logarithmic Form with Exponents of Zero or One"}] :question/id #uuid "df39de4a-3296-5ce5-8a5a-a83c8f995cf4" :question/math-academy-id "e-3976" :question/problem "Express $7^0 = 1$ in logarithmic form." :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$a = b^x$ is equivalent to $\\log_{b}{a} = x$\n\nIf we compare $7^0 = 1$ with $a = b^x,$ we get $a = 1, b = 7,$ and $x=0.$\n\nTherefore, the equation $7^0 = 1$ is equivalent to $\\log_{7}{1}= 0.$\n\nIn general, $\\log_n(1) = 0$ for any $n>0, n\\neq 1.$"}] [{:db/id #edb/ref 17592186514476 :knowledge-point/_questions [{:db/id #edb/ref 17592186064188 :knowledge-point/id #uuid "c75abcbb-bd77-5d0f-af35-1c849a178f68" :knowledge-point/title "Converting Equations From Exponential Form to Logarithmic Form with Exponents of Zero or One"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10b3f0de-10ab-59f8-9482-ea6432ae1a1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{1/16}⁡16=0" :db/id #edb/ref 17592186513574} {:answer/id #uuid "130dd748-2866-5a43-a676-5219cb240dfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{1/16}⁡(\\frac{1}{16})=0" :db/id #edb/ref 17592186513582} {:answer/id #uuid "45709d79-2399-5b8b-aae1-30eedf29c6f3" :answer/type {