selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514320}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "be53ea1d-fce1-50b2-b27f-f485b9e423e6" :question/math-academy-id "q-66504" :question/problem "$\\sqrt{2}≈1.414$ can be expressed as" :question/worked-solution "Notice that the given approximation can be written using exponents as follows:\n\n$$\n{2}^{1/2}≈1.412\n$$\n\nThe logarithm of $a$ with base $b$ is defined as follows:\n\n$a={b}^{x}$ is equivalent to ${log}_{b}⁡a=x$\n\nIf we compare ${2}^{1/2}≈1.412$ with $a={b}^{x},$ we get $a=1.412,b=2$ and $x=\\frac{1}{2}.$\n\nTherefore, the approximation $\\sqrt{2}≈1.414$ can be expressed as ${log}_{2}⁡(1.414)≈\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186514361 :knowledge-point/_questions [{:db/id #edb/ref 17592186064184 :knowledge-point/id #uuid "bea0b2f4-c3cc-5cd5-a259-ff987711d6f4" :knowledge-point/title "Converting Equations From Exponential Form to Logarithmic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "184567b3-3117-53f7-b834-8fce87f609ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{32}⁡2=x" :db/id #edb/ref 17592186513594} {:answer/id #uuid "4eb874fd-69aa-54af-bae8-bfb72c700049" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{x}⁡32=2" :db/id #edb/ref 17592186513746} {:answer/id #uuid "75fbd0b9-d9fb-5560-8900-a790eefb385f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{32}⁡x=2" :db/id #edb/ref 17592186513845} {:answer/id #uuid "b632151f-5928-5f49-843d-035deb3c234e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡x=32" :db/id #edb/ref 17592186514010} {:answer/id #uuid "bf5c1add-f890-555f-a7fd-bd4ad49b0a43" :answer/type {:db/id #edb/ref 17592186045498 :d