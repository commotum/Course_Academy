b943a-a17d-5522-ab1c-15feac6abf33" #edb/ref 17592186045417] [17592186050436 #edb/ref 1027 #edb/ref 17592186048680 #edb/ref 17592186045417] [17592186050436 #edb/ref 1027 #edb/ref 17592186048688 #edb/ref 17592186045417] [17592186050436 #edb/ref 1027 #edb/ref 17592186049082 #edb/ref 17592186045417] [17592186050436 #edb/ref 1027 #edb/ref 17592186050061 #edb/ref 17592186045417] [17592186050436 #edb/ref 1027 #edb/ref 17592186050177 #edb/ref 17592186045417] [17592186050436 #edb/ref 1027 #edb/ref 17592186050404 #edb/ref 17592186045417] [17592186050436 #edb/ref 1027 #edb/ref 17592186050717 #edb/ref 17592186045417] [17592186050436 #edb/ref 1027 #edb/ref 17592186050886 #edb/ref 17592186045417] [17592186050436 #edb/ref 1028 #edb/ref 17592186175892 #edb/ref 17592186045417] [17592186050436 #edb/ref 1028 #edb/ref 17592186175893 #edb/ref 17592186045417] [17592186050436 #edb/ref 1028 #edb/ref 17592186175894 #edb/ref 17592186045417] [17592186050436 #edb/ref 1028 #edb/ref 17592186175895 #edb/ref 17592186045417] [17592186050436 #edb/ref 1031 "Rounding Up Decimals" #edb/ref 17592186045417] [17592186050436 #edb/ref 1033 3585 #edb/ref 17592186045417] [17592186050436 #edb/ref 1035 #uuid "490bb9e7-cb49-5d04-a7c1-aff95960778a" #edb/ref 17592186045417] [17592186133500 #edb/ref 1069 "e-12828" #edb/ref 17592186045417] [17592186133500 #edb/ref 1071 "Which of the following numbers are surds?\n\n$$\n\\sqrt{2},\\qquad \\sqrt{8},\\qquad \\sqrt{16}\n$$" #edb/ref 17592186045417] [17592186133500 #edb/ref 1072 #uuid "0b823033-1f76-5656-a284-b94f33f3e359" #edb/ref 17592186045417] [17592186133500 #edb/ref 1074 "A surd is a number containing a radical symbol $\\sqrt{\\phantom{0}}$ that cannot be written as a positive or negative whole number or fraction.\n\nWith that in mind, let's look at each number in turn.\n\n- $\\sqrt{2}$ is a surd. Using a calculator, we find that $\\sqrt{2}=1.414\\,213\\,562\\,...$\n\n- $\\sqrt{8}$ is a surd. Using a calculator, we find that $\\sqrt{8}=2.828\\,427\\,124\\,...$\n\n- $\\sqrt{16}$ is **NOT** a surd. Since $16$ is a perfect square, we can get rid of the square root symbol ($\\sqrt{\\phantom{x}}$) and obtain a whole number:\n\n$$\n\\sqrt{16}=\\sqrt{4^2}=4\n$$\n\nTherefore, the correct answer is: $\\sqrt{2}$ and $\\sqrt{8}$ only." #edb/ref 17592186045417] [17592186133501 #edb/ref 1069 "e-12829" #edb/ref 17592186045417] [17592186133501 #edb/ref 1071 "What is the value of $\\sqrt{126}$ rounded to $3$ decimal places?" #edb/ref 17592186045417] [17592186133501 #edb/ref 1072 #uuid "127ac025-aa32-505a-98d8-27721a37fdbe" #edb/ref 17592186045417] [17592186133501 #edb/ref 1074 "Using a calculator, we find that\n\n$$\n\\sqrt{126}=11.224\\,972\\,160\\,...\n$$\n\nNow, we round to $3$ decimal places:\n\n$$\n\\sqrt{126} \\approx 11.225\n$$" #edb/ref 17592186045417] [17592186133502 #edb/ref 1069 "e-12830" #edb/ref 17592186045417] [17592186133502 #edb/ref 1071 "Which of the following numbers are surds?\n\n$$\n\\sqrt[3]{2},\\qquad \\sqrt[3]{\\dfrac{1}{27}},\\qquad \\sqrt[3]{11}\n$$" #edb/ref 17592186045417] [17592186133502 #edb/ref 1072 #uuid "9e145904-a9bf-59fc-9070-339b0e133de9" #edb/ref 17592186045417] [17592186133502 #edb/ref 1074 "A surd is a number containing a radical symbol $\\sqrt{\\phantom{0}}$ that cannot be written as a positive or negative whole number or fraction.\n\nSurds can be square roots $\\sqrt{\\phantom{0}}$, cube roots $\\sqrt[3]{\\phantom{0}},$ or higher roots such as $\\sqrt[4]{\\phantom{0}}, \\sqrt[5]{\\phantom{0}},\\ldots,$ etc.\n\nWith that in mind, let's look at each number in turn.\n\n- $\\sqrt[3]{2}$ is a surd. Using a calculator, we find that $\\sqrt[3]{2} = 1.259\\,921\\,\\ldots$\n\n- $\\sqrt[3]{\\dfrac{1}{27}}$ is **NOT** a surd. Since $1$ and $27$ are perfect cubes, we can get rid of the cube root symbol $(\\sqrt[3]{\\phantom{0}})$ and obtain a regular fraction.\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{1}{27}} & =\\sqrt[3]{\\frac{{1}^{3}}{{3}^{3}}} \\\\  & =\\sqrt[3]{\\frac{1\\cdot 1\\cdot 1}{3\\cdot 3\\cdot 3}} \\\\  & =\\sqrt[3]{\\frac{1}{3}\\cdot \\frac{1}{3}\\cdot \\frac{1}{3}} \\\\  & =\\sqrt[3]{{(\\frac{1}{3})}^{3}} \\\\  & =\\frac{1}{3}\\end{aligned}\n$$\n\n- $\\sqrt[3]{11}$ is a surd. Using a calculator, we find that $\\sqrt[3]{11} = 2.223\\,980\\,\\ldots$\n\nTherefore, the correct answer is: $\\sqrt[3]{2}$ and $\\sqrt[3]{11}$ only." #edb/ref 17592186045417] [17592186133515 #edb/ref 1069 "e-13357" #edb/ref 17592186045417] [17592186133515 #edb/ref 1071 "Which of the following numbers are surds?\n\n$$\n\\sqrt{\\dfrac{5}{12}}, \\qquad \\sqrt{\\dfrac{64}{81}}, \\qquad \\sqrt{\\dfrac{10}{7}}\n$$" #edb/ref 17592186045417] [17592186133515 #edb/ref 1072 #uuid "12b5f86f-9e86-5c1b-8773-38e2b69a6417" #edb/ref 17592186045417] [17592186133515 #edb/ref 1074 "A surd is a number containing a radical symbol $\\sqrt{\\phantom{0}}$ that cannot be written as a positive or negative whole number or fraction.\n\nWith that in mind, let's look at each number in turn.\n\n- $\\sqrt{\\dfrac{5}{12}}$ is a surd. Using a calculator, we find that $\\sqrt{\\dfrac{5}{12}} = 0.645\\,497\\,\\ldots$\n\n- $\\sqrt{\\dfrac{64}{81}}$ is **NOT** a surd. Since $64$ and $81$ are perfect squares, we can get rid of the square root symbol $(\\sqrt{\\phantom{0}})$ and obtain a regular fraction.\n\n$$\n\\begin{aligned}\\sqrt{\\frac{64}{81}} & =\\sqrt{\\frac{{8}^{2}}{{9}^{2}}} \\\\  & =\\sqrt{\\frac{8\\cdot 8}{9\\cdot 9}} \\\\  & =\\sqrt{\\frac{8}{9}\\cdot \\frac{8}{9}} \\\\  & =\\sqrt{{(\\frac{8}{9})}^{2}} \\\\  & =\\frac{8}{9}\\end{aligned}\n$$\n\n- $\\sqrt{\\dfrac{10}{7}}$ is a surd. Using a calculator, we find that $\\sqrt{\\dfrac{10}{7}} = 1.195\\,228\\,\\ldots$\n\nTherefore, the correct answer is: $\\sqrt{\\dfrac{5}{12}}$ and $\\sqrt{\\dfrac{10}{7}}$ only." #edb/ref 17592186045417] [17592186133722 #edb/ref 1037 #edb/ref 17592186050358 #edb/ref 17592186045417] [17592186133722 #edb/ref 1037 #edb/ref 17592186050415 #edb/ref 17592186045417] [17592186133722 #edb/ref 1037 #edb/ref 17592186050436 #edb/ref 17592186045417] [17592186133722 #edb/ref 1038 #edb/ref 17592186134143 #edb/ref 17592186045417] [17592186133722 #edb/ref 1038 #edb/ref 17592186134144 #edb/ref 17592186045417] [17592186133722 #edb/ref 1038 #edb/ref 17592186476924 #edb/ref 17592186045417] [17592186133722 #edb/ref 1038 #edb/ref 17592186476958 #edb/ref 17592186045417] [17592186133722 #edb/ref 1039 "Finding a Decimal Approximation of a Square Root Surd" #edb/ref 17592186045417] [17592186133722 #edb/ref 1041 #edb/ref 17592186133501 #edb/ref 17592186045417] [17592186133722 #edb/ref 1042 #uuid "2c606764-287a-500f-aa91-e6a68bec8860" #edb/ref 17592186045417] [17592186133723 #edb/ref 1038 #edb/ref 17592186134415 #edb/ref 17592186045417] [17592186133723 #edb/ref 1038 #edb/ref 17592186134420 #edb/ref 17592186045417] [17592186133723 #edb/ref 1038 #edb/ref 17592186476908 #edb/ref 17592186045417] [17592186133723 #edb/ref 1038 #edb/ref 17592186476937 #edb/ref 17592186045417] [17592186133723 #edb/ref 1039 "Identifying Surds: Square Roots of Integers" #edb/ref 17592186045417] [17592186133723 #edb/ref 1041 #edb/ref 17592186133500 #edb/ref 17592186045417] [17592186133723 #edb/ref 1042 #uuid "bf6ecc42-d84a-584f-9ccc-d6a987c89394" #edb/ref 17592186045417] [17592186133724 #edb/ref 1038 #edb/ref 17592186134147 #edb/ref 17592186045417] [17592186133724 #edb/ref 1038 #edb/ref 17592186134149 #edb/ref 17592186045417] [17592186133724 #edb/ref 1038 #edb/ref 17592186476874 #edb/ref 17592186045417] [17592186133724 #edb/ref 1038 #edb/ref 17592186476929 #edb/ref 17592186045417] [17592186133724 #edb/ref 1039 "Identifying Surds: Square Roots of Fractions" #edb/ref 17592186045417] [17592186133724 #edb/ref 1041 #edb/ref 17592186133515 #edb/ref 17592186045417] [17592186133724 #edb/ref 1042 #uuid "7b1e6bea-5399-5dba-b2b1-f59441915324" #edb/ref 17592186045417] [17592186133725 #edb/ref 1037 #edb/ref 17592186048770 #edb/ref 17592186045417] [17592186133725 #edb/ref 1038 #edb/ref 17592186134416 #edb/ref 17592186045417] [17592186133725 #edb/ref 1038 #edb/ref 17592186134501 #edb/ref 17592186045417] [17592186133725 #edb/ref 1038 #edb/ref 17592186476912 #edb/ref 17592186045417] [17592186133725 #edb/ref 1038 #edb/ref 17592186476968 #edb/ref 17592186045417] [17592186133725 #edb/ref 1039 "Identifying Cube Root Surds" #edb/ref 17592186045417] [17592186133725 #edb/ref 1041 #edb/ref 17592186133502 #edb/ref 17592186045417] [17592186133725 #edb/ref 1042 #uuid "115ee606-48f2-5a63-a5c6-fd8e3e1dbec0" #edb/ref 17592186045417] [17592186134044 #edb/ref 1043 #edb/ref 17592186134571 #edb/ref 17592186045417] [17592186134044 #edb/ref 1043 #edb/ref 17592186134572 #edb/ref 17592186045417] [17592186134044 #edb/ref 1043 #edb/ref 17592186134573 #edb/ref 17592186045417] [17592186134044 #edb/ref 1043 #edb/ref 17592186134574 #edb/ref 17592186045417] [17592186134044 #edb/ref 1043 #edb/ref 17592186134575 #edb/ref 17592186045417] [17592186134044 #edb/ref 1043 #edb/ref 17592186134576 #edb/ref 17592186045417] [17592186134044 #edb/ref 1043 #edb/ref 17592186134577 #edb/ref 17592186045417] [17592186134044 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186134044 #edb/ref 1045 "Surds" #edb/ref 17592186045417] [17592186134044 #edb/ref 1046 #edb/ref 17592186134571 #edb/ref 17592186045417] [17592186134044 #edb/ref 1049 #edb/ref 17592186050404 #edb/ref 17592186045417] [17592186134044 #edb/ref 1050 420.0 #edb/ref 17592186045417] [17592186134044 #edb/ref 1053 #uuid "c72a2713-294e-5bf3-a1ca-721b4a5a5f0a" #edb/ref 17592186045417] [17592186134571 #edb/ref 1058 #edb/ref 17592186134572 #edb/ref 17592186045417] [17592186134571 #edb/ref 1061 132257 #edb/ref 17592186045417] [17592186134571 #edb/ref 1062 #uuid "91bdb3fa-af0d-57f2-b5a8-2c5dade5d3ce" #edb/ref 17592186045417] [17592186134571 #edb/ref 1063 #edb/ref 17592186135175 #edb/ref 17592186045417] [17592186134572 #edb/ref 1058 #edb/ref 17592186134573 #edb/ref 17592186045417] [17592186134572 #edb/ref 1061 132258 #edb/ref 17592186045417] [17592186134572 #edb/ref 1062 #uuid "c6632f15-dcfd-5f47-ab63-3c36a369fd9c" #edb/ref 17592186045417] [17592186134572 #edb/ref 1063 #edb/ref 17592186133722 #edb/ref 17592186045417] [17592186134573 #edb/ref 1058 #edb/ref 17592186134574 #edb/ref 17592186045417] [17592186134573 #edb/ref 1061 132261 #edb/ref 17592186045417] [17592186134573 #edb/ref 1062 #uuid "69bc6dd4-7575-5aeb-a397-947a836138af" #edb/ref 17592186045417] [17592186134573 #edb/ref 1063 #edb/ref 17592186135185 #edb/ref 17592186045417] [17592186134574 #edb/ref 1058 #edb/ref 17592186134575 #edb/ref 17592186045417] [17592186134574 #edb/ref 1061 132262 #edb/ref 17592186045417] [17592186134574 #edb/ref 1062 #uuid "9ac709cd-552f-50aa-b69e-d983a3ec2e82" #edb/ref 17592186045417] [17592186134574 #edb/ref 1063 #edb/ref 17592186133723 #edb/ref 17592186045417] [17592186134575 #edb/ref 1058 #edb/ref 17592186134576 #edb/ref 17592186045417] [17592186134575 #edb/ref 1061 132265 #edb/ref 17592186045417] [17592186134575 #edb/ref 1062 #uuid "ad93c1bc-44bd-5e00-a24e-9f1402579cd1" #edb/ref 17592186045417] [17592186134575 #edb/ref 1063 #edb/ref 17592186133724 #edb/ref 17592186045417] [17592186134576 #edb/ref 1058 #edb/ref 17592186134577 #edb/ref 17592186045417] [17592186134576 #edb/ref 1061 132268 #edb/ref 17592186045417] [17592186134576 #edb/ref 1062 #uuid "a48ef472-2382-5ca8-8e7b-babfbe25146f" #edb/ref 17592186045417] [17592186134576 #edb/ref 1063 #edb/ref 17592186135176 #edb/ref 17592186045417] [17592186134577 #edb/ref 1061 132269 #edb/ref 17592186045417] [17592186134577 #edb/ref 1062 #uuid "3a1a1a85-8f6a-50dd-977c-70e0ac0215bf" #edb/ref 17592186045417] [17592186134577 #edb/ref 1063 #edb/ref 17592186133725 #edb/ref 17592186045417] [17592186135175 #edb/ref 1064 "We know how to find the square root of a perfect square. But how do we find square roots of numbers that are not perfect squares? \n\nFor example, what is the square root of ![](images/6e/6e598ebd61f7b5abdb46a3fedf97dbd86c13caa5fdd9a6ae8af9d41c02b74f9a.svg)\n\n![](images/16/16e7d5e5ffc7d8d0978956477c3dbc426dbd0e74879ae959c0d3f78c11ed5c8d.svg)\n\nEven though ![](images/0c/0cf2eee0cdec31b7acdc244a255aaee7d6d520cfeee67b64ac9cf215f5377477.svg) is not a perfect square, ![](images/89/891186f912bc7147e436f91ef0a04deeb1454f0bdd1695f17874c9bcc13c9e94.svg) is still a number. Such numbers are called **surds**. Surds are a new type of number that *cannot be written as a whole number or regular fraction*! \n\nSurds can, however, be written as infinite, non-repeating decimals. \n\nIn general, a surd is the ![](images/fb/fb2a8560bbc7122a4dd4f1a0bb9862d4368a63f4b03968884a3a60e7423a852c.svg)th root of a positive rational number, where the result is an irrational number. \n\nWe can find a decimal approximation to the value of ![](images/89/891186f912bc7147e436f91ef0a04deeb1454f0bdd1695f17874c9bcc13c9e94.svg) using the **square root button** ![](images/bd/bd66148fee2153d93c9f9ebf03746c0cae45c4a7b18cebf40d4356062dfbb466.svg) on our calculator.\n\nDifferent calculator models work differently. However, one of the following sequences should work with your calculator:\n\n- Press ![](images/45/45408fc2a9491077a8f4f9723c752888ee9f8bdf4af94045e56c4e9012a5320f.svg) type ![](images/7f/7f38cebb638dae513ad9a568ededc8af694d8148daf8d1b4ec7b0c3f7f0b2a62.svg), and then press ![](images/67/67fb55146f79bf4b913be2b4fe77c3d090f4ad858227984983fb555b9c70eb39.svg).\n\n- Alternatively, you may need to type ![](images/7f/7f38cebb638dae513ad9a568ededc8af694d8148daf8d1b4ec7b0c3f7f0b2a62.svg) first, then press ![](images/45/45408fc2a9491077a8f4f9723c752888ee9f8bdf4af94045e56c4e9012a5320f.svg) followed by ![](images/67/67fb55146f79bf4b913be2b4fe77c3d090f4ad858227984983fb555b9c70eb39.svg).\n\nIf you find yourself stuck, search for an online video that shows how to use the square root button with your calculator model.\n\nWhen we do this, we get the following on our calculator's display.\n![](images/da/dad013cc5495b4d22e9d0dc62647bdaff06f65fdbdbe9c5ac99bdac9f152aef7.svg)\n\nThe value given by the calculator is an *approximation* to the true value of ![](images/6e/6e3c3c02cccece42efad3a2cd406eb0ac3aa3f0638fe80f080cb10e456fd4bba.svg) In reality, the digits continue forever, and the pattern of decimal digits does not repeat. It is *impossible* to express ![](images/89/891186f912bc7147e436f91ef0a04deeb1454f0bdd1695f17874c9bcc13c9e94.svg) precisely using decimals." #edb/ref 17592186045417] [17592186135175 #edb/ref 1065 8037 #edb/ref 17592186045417] [17592186135175 #edb/ref 1066 #uuid "e462feae-1235-5718-8b9d-5ec284e6d71b" #edb/ref 17592186045417] [17592186135175 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186135176 #edb/ref 1064 "Similarly, we can have surds involving the cube root sign ($\\sqrt[3]{\\phantom{x}}$). For example, \n\n$$\n\\sqrt[3]{2}, \\quad\\sqrt[3]{9}, \\quad \\sqrt[3]{11}, \\quad \\sqrt[3]{129}, \\quad \\ldots\n$$\n\nBut $\\sqrt[3]{8}$ is **not** a surd since we can get rid of the cube root:\n\n$$\n\\sqrt[3]{8} = \\sqrt[3]{2^3} = 2\n$$\n\nMost calculators have a \"cube root button\" $\\bbox[lightgray, 2pt]{\\sqrt[3]{\\phantom{x}}}$ that can be used to compute cube roots.\n\nNote that we can have surds involving cube roots ($\\sqrt[3]{\\phantom{x}}$) of negative numbers, such as\n\n$$\n\\sqrt[3]{-2}, \\quad \\sqrt[3]{-5}, \\quad \\sqrt[3]{-14},\n$$\n\nbecause it's fine to take the cube root of a negative number." #edb/ref 17592186045417] [17592186135176 #edb/ref 1065 8038 #edb/ref 17592186045417] [17592186135176 #edb/ref 1066 #uuid "b5b34634-e24f-5780-9fda-2d39dc3347bc" #edb/ref 17592186045417] [17592186135176 #edb/ref 1067 "Surds With Cube Roots" #edb/ref 17592186045417] [17592186135185 #edb/ref 1064 "A number is *not* a surd if we can write it as a positive or negative whole number or fraction. \n\nFor example, $\\sqrt 9$ is *not* a surd because it is a perfect square and can be expressed as a whole number:\n\n$$\n\\sqrt 9 = \\sqrt{3^2} = 3\n$$\n\nSimilarly, $\\sqrt{\\dfrac{1}{16}}$ is *not* a surd because it can be written as a regular fraction (i.e., as the ratio of two whole numbers):\n\n$$\n\\begin{aligned}\\sqrt{\\frac{1}{16}} & =\\sqrt{\\frac{1\\cdot 1}{4\\cdot 4}} \\\\  & =\\sqrt{\\frac{1}{4}\\cdot \\frac{1}{4}} \\\\  & =\\sqrt{{(\\frac{1}{4})}^{2}} \\\\  & =\\frac{1}{4}\\end{aligned}\n$$\n\nFinally, we cannot have surds involving square roots of negative numbers. In other words, the numbers \n\n$$\n\\sqrt{-2}, \\qquad \\sqrt{-5}, \\qquad \\sqrt{-14}\n$$\n\nare *not* surds because they are *not real numbers*!" #edb/ref 17592186045417] [17592186135185 #edb/ref 1065 8363 #edb/ref 17592186045417] [17592186135185 #edb/ref 1066 #uuid "1d377452-f2b4-5c72-80ce-d643f8f571be" #edb/ref 17592186045417] [17592186135185 #edb/ref 1067 "Numbers That Are Not Surds" #edb/ref 17592186045417] [17592186476207 #edb/ref 1080 "$\\sqrt[3]{5}$ and $\\sqrt[3]{125}$ only" #edb/ref 17592186045417] [17592186476207 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186476207 #edb/ref 1083 #uuid "02d7ea31-a2a4-5aba-9002-c6de8ea5a613" #edb/ref 17592186045417] [17592186476228 #edb/ref 1080 "$\\sqrt{144}$ and $\\sqrt{25}$ only" #edb/ref 17592186045417] [17592186476228 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186476228 #edb/ref 1083 #uuid "0e7cf0f8-2065-5fa3-aaca-8888cf2f2375" #edb/ref 17592186045417] [17592186476236 #edb/ref 1080 "$\\sqrt[3]{10}$ and $\\sqrt[3]{100}$ only" #edb/ref 17592186045417] [17592186476236 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186476236 #edb/ref 1083 #uuid "14971dd6-fe9f-51a5-8502-501597d33911" #edb/ref 17592186045417] [17592186476269 #edb/ref 1080 "4.6" #edb/ref 17592186045417] [17592186476269 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186476269 #edb/ref 1083 #uuid "1e51721d-28a8-5621-adf0-f7fdfc0ed31c" #edb/ref 17592186045417] [17592186476283 #edb/ref 1080 "$\\sqrt{64}$ only" #edb/ref 17592186045417] [17592186476283 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186476283 #edb/ref 1083 #uuid "22f69457-ca71-5ee7-8a