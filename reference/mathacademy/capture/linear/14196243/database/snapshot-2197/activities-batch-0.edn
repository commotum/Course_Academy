ademy-id "e-13396"} :knowledge-point/id #uuid "91037b32-189a-5ba9-ab0a-117f6255c496" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050249}] :knowledge-point/questions [{:db/id #edb/ref 17592186143196} {:db/id #edb/ref 17592186143197} {:db/id #edb/ref 17592186424808} {:db/id #edb/ref 17592186424831} {:db/id #edb/ref 17592186426008} {:db/id #edb/ref 17592186510387}] :knowledge-point/title "Multiplying a Fraction by a Whole Number Resulting in a Mixed Number"} :step/id #uuid "130fe104-c8f0-562f-9d3d-edb7b1985250" :step/math-academy-id 130669}] :activity/title "Multiplying Fractions by Whole Numbers" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186142997}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186510491} :activity/id #uuid "34478af7-016b-50ef-8d17-1e3de9d584b8" :activity/scope {:db/id #edb/ref 17592186050599 :topic/id #uuid "576878c2-12a4-51b4-9889-1011d89192c4" :topic/math-academy-id 2360} :activity/steps [{:db/id #edb/ref 17592186510487 :step/content {:db/id #edb/ref 17592186510471 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55cee1b2-fc14-5406-a50c-ee1bef2c1a97" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186509864}] :answer-field/correct {:db/id #edb/ref 17592186509864} :answer-field/id #uuid "99f9767b-d358-50e5-b8c1-d0f2290a8e76" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186510315}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ed7855b2-e0c4-5d43-a793-86601ef49531" :question/math-academy-id "q-172835" :question/problem "Expressed as a fraction in its lowest terms, $\\frac{2}{9}\\times 3=${{field-1}}." :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n\\frac{2\\times 3}{9}=\\frac{6}{9}\n$$\n\nWe then reduce this fraction to its lowest terms:\n\n$$\n\\frac{6}{9}=\\frac{6÷3}{9÷3}=\\frac{2}{3}\n$$"} :step/id #uuid "2b15e500-4d9d-5d95-8183-8b0548be87ce"} {:db/id #edb/ref 17592186510491 :step/content {:db/id #edb/ref 17592186510384 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2701a568-7b51-5ee3-bdfe-cf300d253cdd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186509769} {:answer/id #uuid "440961ef-7018-5985-aa9f-2b72b868ad3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186509829} {:answer/id #uuid "b004acfc-1115-58e9-8ed3-d963f269395e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186510065} {:answer/id #uuid "d7efecac-de95-5f99-84b2-c5509aa3264e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186510147} {:answer/id #uuid "efc7e933-0aaa-5e03-b174-d2fedd705768" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186510202}] :answer-field/correct {:db/id #edb/ref 17592186509769} :answer-field/id #uuid "a6394540-bef1-5d14-899a-e48a9dd05538" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186510325}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3ef9ce40-b102-5a3a-80df-f4d65ee91715" :question/math-academy-id "q-56845" :question/problem "$\\frac{1}{10}\\times 10=$" :question/worked-solution "First, we write $10$ as an improper fraction:\n\n$$\n10=\\frac{10}{1}\n$$\n\nFinally, we simplify:\n\n$$\n10÷10=1\n$$"} :step/id #uuid "32fe809e-be15-5879-9ca6-f696ed248dbe" :step/next {:db/id #edb/ref 17592186510546}} {:db/id #edb/ref 17592186510546 :step/content {:db/id #edb/ref 17592186510387 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d68b516-9901-561b-9284-284a39ac9db3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\,\\frac{1}{3}" :db/id #edb/ref 17592186509847} {:answer/id #uuid "4fcaa2b8-b53e-57c5-bb30-a9e4289aa081" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\,\\frac{1}{3}" :db/id #edb/ref 17592186509855} {:answer/id #uuid "598b4d6b-45a5-5d71-bce7-4f8b0f8e22a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\,\\frac{2}{3}" :db/id #edb/ref 17592186509874} {:answer/id #uuid "728aa58f-57cb-5136-9754-148669dae9b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\,\\frac{2}{3}" :db/id #edb/ref 17592186509925} {:answer/id #uuid "d59076de-8e00-5557-b8ef-6aad547d73e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,\\frac{2}{3}" :db/id #edb/ref 17592186510140}] :answer-field/correct {:db/id #edb/ref 17592186509847} :answer-field/id #uuid "4bfc692b-2350-57db-b02c-fe993e24627e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186510277}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "482bced9-3212-5918-a8c9-a1d576cd678a" :question/math-academy-id "q-70169" :question/problem "$\\frac{5}{12}\\times 8=$" :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n\\frac{5\\times 8}{12}=\\frac{40}{12}\n$$\n\nWe then simplify:\n\n$$\n\\frac{40}{12}=\\frac{40÷4}{12÷4}=\\frac{10}{3}\n$$\n\nFinally, we then convert $\\frac{10}{3}$ to a mixed number:\n\n$$\n10÷3=3\\,\\text{R}1=3\\,\\frac{1}{3}\n$$"} :step/id #uuid "ce2e5790-1b2c-55cb-9978-7f2ea8c71e01" :step/next {:db/id #edb/ref 17592186510487}}] :activity/title "Multiplying Fractions by Whole Numbers" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186509681}]}
