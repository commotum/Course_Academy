7592186510140}] :answer-field/correct {:db/id #edb/ref 17592186509847} :answer-field/id #uuid "4bfc692b-2350-57db-b02c-fe993e24627e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186510277}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "482bced9-3212-5918-a8c9-a1d576cd678a" :question/math-academy-id "q-70169" :question/problem "$\\frac{5}{12}\\times 8=$" :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n\\frac{5\\times 8}{12}=\\frac{40}{12}\n$$\n\nWe then simplify:\n\n$$\n\\frac{40}{12}=\\frac{40÷4}{12÷4}=\\frac{10}{3}\n$$\n\nFinally, we then convert $\\frac{10}{3}$ to a mixed number:\n\n$$\n10÷3=3\\,\\text{R}1=3\\,\\frac{1}{3}\n$$"} :step/id #uuid "ce2e5790-1b2c-55cb-9978-7f2ea8c71e01" :step/next {:db/id #edb/ref 17592186510487}}] :activity/title "Multiplying Fractions by Whole Numbers" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186509681}]}
