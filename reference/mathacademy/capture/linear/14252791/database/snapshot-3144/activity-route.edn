answer/id #uuid "2d48c471-d496-5e72-8f43-a0fd4a41d812" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡3+6" :db/id #edb/ref 17592186573478} {:answer/id #uuid "cbaeae74-b76a-5cac-8d00-62aefa456af0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{ln}⁡3" :db/id #edb/ref 17592186573691} {:answer/id #uuid "cda365c1-55e5-5287-8978-e7a05511b801" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\operatorname{ln}⁡3" :db/id #edb/ref 17592186573696} {:answer/id #uuid "f258410d-8ea4-55cc-bd6e-487007ddffc6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{ln}⁡3" :db/id #edb/ref 17592186573750} {:answer/id #uuid "f47d40ef-eb53-5e3d-9f33-e4ae67afc82e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{ln}⁡3+3" :db/id #edb/ref 17592186573754}] :answer-field/correct {:db/id #edb/ref 17592186573696} :answer-field/id #uuid "a8dd7b69-cfda-51dc-9216-0f0346dfcc24" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186573835}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "75343968-4357-560c-bdef-83ca2d136bed" :question/math-academy-id "q-17250" :question/problem "Given that $f(x)=2\\cdot {3}^{x}$,  find the slope of the tangent at $x=1.$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2\\cdot {3}^{x}) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}({3}^{x}) \\\\  & =2\\operatorname{ln}⁡3\\cdot {3}^{x}.\\end{aligned}\n$$\n\n                    \n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & =2\\operatorname{ln}⁡3\\cdot {3}^{x}{|}_{x=1} \\\\  & =2\\operatorname{ln}⁡3\\cdot {3}^{1} \\\\  & =2\\operatorname{ln}⁡3\\cdot 3 \\\\  & =6\\operatorname{ln}⁡3.\\end{aligned}\n$$"} :step/id #uuid "8b06feae-c161-587d-918b-dfc481fac531" :step/next {:db/id #edb/ref 17592186573972}} {:db/id #edb/ref 17592186573972 :step/content {:db/id #edb/ref 17592186573948 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dbcb0c2-591c-550c-90b6-0fa9fa9b335f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2e-5" :db/id #edb/ref 17592186573480} {:answer/id #uuid "b03f4bd7-1016-5d30-85e9-b66832fd85f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{ln}⁡5+e" :db/id #edb/ref 17592186573652} {:answer/id #uuid "e32fa90f-7612-53ac-9c86-6c9a25e4133f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{ln}⁡5+2e" :db/id #edb/ref 17592186573721} {:answer/id #uuid "ecb092bd-0bce-5b77-ba8a-c99b73f4276d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡5+e" :db/id #edb/ref 17592186573735} {:answer/id #uuid "f11cb49d-d874-5676-aa73-e04982383d65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡5+2e" :db/id #edb/ref 17592186573746}] :answer-field/correct {:db/id #edb/ref 17592186573721} :answer-field/id #uuid "5b970639-69ce-55ff-915b-17b1d62588d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186573808}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fe3ddee2-6465-59d2-8bfd-072b67b0281b" :question/math-academy-id "q-140438" :question/problem "Given that $f(x)={5}^{x}+2{e}^{x}-\\operatorname{ln}⁡2$,  find the slope of the tangent at $x=1.$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({5}^{x}+2{e}^{x}-\\operatorname{ln}⁡2) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({5}^{x})+\\frac{\\text{d}}{\\text{d}x}(2{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(-\\operatorname{ln}⁡2) \\\\  & ={5}^{x}\\operatorname{ln}⁡5+2\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & ={5}^{x}\\operatorname{ln}⁡5+2{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & =({5}^{x}\\operatorname{ln}⁡5+2{e}^{x}){|}_{x=1} \\\\  & ={5}^{1}\\cdot \\operatorname{ln}⁡5+2\\cdot {e}^{1} \\\\  & =5\\operatorname{ln}⁡5+2e.\\end{aligned}\n$$"} :step/id #uuid "c80b7016-b1ea-5341-bc9d-f85fa36383dd"}] :activity/title "Differentiating Exponential Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186573419}]}
