#{[{:activity/expected-seconds 1140.0 :activity/first-step {:db/id #edb/ref 17592186093327} :activity/id #uuid "bfd96d16-131a-5887-9f3c-822479cc8e6b" :activity/scope {:db/id #edb/ref 17592186049119 :topic/id #uuid "dc19c9ce-6319-5943-8842-352e3c3735c7" :topic/math-academy-id 987} :activity/steps [{:db/id #edb/ref 17592186093087 :step/content {:db/id #edb/ref 17592186092240 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092083 :question/id #uuid "e405bf60-d500-55df-90be-a938dc9dfc93" :question/math-academy-id "e-6080"} :knowledge-point/id #uuid "55a323ba-f2a7-5a49-abd4-a9812518ef8c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050635}] :knowledge-point/question-generator {:db/id #edb/ref 17592186493326} :knowledge-point/questions [{:db/id #edb/ref 17592186092722} {:db/id #edb/ref 17592186092724} {:db/id #edb/ref 17592186233912} {:db/id #edb/ref 17592186233927} {:db/id #edb/ref 17592186234077} {:db/id #edb/ref 17592186235432} {:db/id #edb/ref 17592186235480} {:db/id #edb/ref 17592186238020} {:db/id #edb/ref 17592186315036} {:db/id #edb/ref 17592186317211} {:db/id #edb/ref 17592186317212} {:db/id #edb/ref 17592186317214} {:db/id #edb/ref 17592186329814} {:db/id #edb/ref 17592186392582} {:db/id #edb/ref 17592186514424} {:db/id #edb/ref 17592186523970}] :knowledge-point/title "Determining the Equation of a Normal Line to a Curve at a Point"} :step/id #uuid "978ac109-c615-5055-9e0a-f164ca3a1990" :step/math-academy-id 22383 :step/next {:db/id #edb/ref 17592186093329}} {:db/id #edb/ref 17592186093327 :step/content {:db/id #edb/ref 17592186093442 :tutorial/content "The equation of the normal line to the curve $y = f(x)$ at the point $P(x_1,y_1),$ in point-slope form, is given by\n\n$$\ny - y_1 = m (x - x_1), \\hspace{1cm} m=-\\dfrac{1}{f'(x_1)}.\n$$\n\nHere, $m=-\\dfrac{1}{f'(x_1)}$ because the slope of the normal line is the negative reciprocal of the slope of the tangent line, and $f'(x_1)$ represents the slope of the tangent line to $y=f(x)$ at the point $(x_1,y_1).$\n\nFor example, suppose we want to compute the equation of the normal line to the curve $y=x^2$ at the point $A(1,1).$ This normal line is the dashed line shown below, which is perpendicular to the solid tangent line. \n\n![](images/31/31ba09ff14e5bd485794f283c5d6a5b087b6c21fdb9242af01b75ec8e8744e0d.png)\n\nSince $y=x^2,$ we have $f(x)=x^2.$ We begin by calculating the derivative of $f(x)\\mathbin{:}$\n\n$$\nf'(x) \t\t = \\dfrac {\\textrm{d}}{\\textrm{d}x}(x^2)= 2x\n$$\n\nAt $A(1,1),$ the slope of the tangent line is given by\n\n$$\nf'(1) \t= 2(1) = 2.\n$$\n\nHowever, we want the normal line, and the slope of the normal line is the negative reciprocal of the slope of the tangent line:\n\n$$\nm = -\\dfrac{1}{f'(1)} = -\\dfrac{1}{2}\n$$\n\n \n\nFinally, we work out the equation of the normal line using the point-slope form:\n\n$$\n\\begin{aligned}y-1 & =-\\frac{1}{2}(x-1) \\\\ y & =-\\frac{x}{2}+\\frac{1}{2}+1 \\\\ y & =-\\frac{x}{2}+\\frac{3}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the normal line is $y=-\\dfrac x 2 + \\dfrac 3 2.$ We could also write this in standard form as $x+2y=3.$" :tutorial/id #uuid "c50c999b-ac30-5116-acbd-795f13cc2b3d" :tutorial/math-academy-id 359 :tutorial/title "Introduction"} :step/id #uuid "5a4d7867-7ef2-52ad-93ae-c3ea0c556954" :step/math-academy-id 667 :step/next {:db/id #edb/ref 17592186093328}} {:db/id #edb/ref 17592186093328 :step/content {:db/id #edb/ref 17592186092384 :knowledge-point/canonical-example {:db/id #edb/ref 17592186091953 :question/id #uuid "4a734f55-ceac-587c-a831-fa8bed578a99" :question/math-academy-id "e-148"} :knowledge-point/id #uuid "4a05f6c0-98ab-5197-922e-8e8dff1d4302" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050473} {:db/id #edb/ref 17592186050711}] :knowledge-point/question-generator {:db/id #edb/ref 17592186480110} :knowledge-point/questions [{:db/id #edb/ref 17592186092723} {:db/id #edb/ref 17592186092725} {:db/id #edb/ref 17592186233770} {:db/id #edb/ref 17592186233924} {:db/id #edb/ref 17592186233925} {:db/id #edb/ref 17592186233926} {:db/id #edb/ref 17592186234307} {:db/id #edb/ref 17592186238012} {:db/id #edb/ref 17592186238013} {:db/id #edb/ref 17592186238019} {:db/id #edb/ref 17592186317210} {:db/id #edb/ref 17592186329815} {:db/id #edb/ref 17592186338957} {:db/id #edb/ref 17592186524012} {:db/id #edb/ref 17592186524021}] :knowledge-point/title "Calculating the Slope of a Normal Line to a Curve at a Point"} :step/id #uuid "ee29e21c-ec79-5cef-8080-e39f4ded4176" :step/math-academy-id 668 :step/next {:db/id #edb/ref 17592186093087}} {:db/id #edb/ref 17592186093329 :step/content {:db/id #edb/ref 17592186092385 :knowledge-point/canonical-example {:db/id #edb/ref 17592186091954 :question/id #uuid "df59a07a-922c-50b9-8c2c-22ed57ac2bda" :question/math-academy-id "e-149"} :knowledge-point/id #uuid "3ba61258-92a9-511e-891f-9e6adce2edb0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049394}] :knowledge-point/question-generator {:db/id #edb/ref 17592186493324} :knowledge-point/questions [{:db/id #edb/ref 17592186092507} {:db/id #edb/ref 17592186092510} {:db/id #edb/ref 17592186233120} {:db/id #edb/ref 17592186233928} {:db/id #edb/ref 17592186234308} {:db/id #edb/ref 17592186240795} {:db/id #edb/ref 17592186240796} {:db/id #edb/ref 17592186297306} {:db/id #edb/ref 17592186317215} {:db/id #edb/ref 17592186317216} {:db/id #edb/ref 17592186493316} {:db/id #edb/ref 17592186493318} {:db/id #edb/ref 17592186493321} {:db/id #edb/ref 17592186523994}] :knowledge-point/title "Determining the Intercepts of a Normal Line"} :step/id #uuid "434b8ac4-0cfe-5365-987b-8d6de7b04e04" :step/math-academy-id 671}] :activity/title "Calculating the Equation of a Normal Line Using Differentiation" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186092461}]}
