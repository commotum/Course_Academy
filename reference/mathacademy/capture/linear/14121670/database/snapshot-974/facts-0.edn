#{[17592186045463 #edb/ref 10 :activity.type/lesson #edb/ref 17592186045416] [17592186045485 #edb/ref 10 :question.difficulty/easy #edb/ref 17592186045416] [17592186045487 #edb/ref 10 :question.difficulty/moderate #edb/ref 17592186045416] [17592186045493 #edb/ref 10 :answer-field.type/radio #edb/ref 17592186045416] [17592186045494 #edb/ref 10 :answer-field.type/select #edb/ref 17592186045416] [17592186045498 #edb/ref 10 :answer.type/math #edb/ref 17592186045416] [17592186045499 #edb/ref 10 :answer.type/text #edb/ref 17592186045416] [17592186046673 #edb/ref 1003 #edb/ref 17592186046646 #edb/ref 17592186045417] [17592186046673 #edb/ref 1004 #edb/ref 17592186046584 #edb/ref 17592186045417] [17592186046673 #edb/ref 1004 #edb/ref 17592186046585 #edb/ref 17592186045417] [17592186046673 #edb/ref 1004 #edb/ref 17592186046586 #edb/ref 17592186045417] [17592186046673 #edb/ref 1004 #edb/ref 17592186046587 #edb/ref 17592186045417] [17592186046673 #edb/ref 1004 #edb/ref 17592186046588 #edb/ref 17592186045417] [17592186046673 #edb/ref 1004 #edb/ref 17592186046589 #edb/ref 17592186045417] [17592186046673 #edb/ref 1004 #edb/ref 17592186046590 #edb/ref 17592186045417] [17592186046673 #edb/ref 1004 #edb/ref 17592186046591 #edb/ref 17592186045417] [17592186046673 #edb/ref 1004 #edb/ref 17592186046592 #edb/ref 17592186045417] [17592186046673 #edb/ref 1004 #edb/ref 17592186046593 #edb/ref 17592186045417] [17592186046673 #edb/ref 1004 #edb/ref 17592186046594 #edb/ref 17592186045417] [17592186046673 #edb/ref 1004 #edb/ref 17592186046595 #edb/ref 17592186045417] [17592186046673 #edb/ref 1004 #edb/ref 17592186046596 #edb/ref 17592186045417] [17592186046673 #edb/ref 1004 #edb/ref 17592186046597 #edb/ref 17592186045417] [17592186046673 #edb/ref 1004 #edb/ref 17592186046598 #edb/ref 17592186045417] [17592186046673 #edb/ref 1004 #edb/ref 17592186046599 #edb/ref 17592186045417] [17592186046673 #edb/ref 1004 #edb/ref 17592186046600 #edb/ref 17592186045417] [17592186046673 #edb/ref 1004 #edb/ref 1