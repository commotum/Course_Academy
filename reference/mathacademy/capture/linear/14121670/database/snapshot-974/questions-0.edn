6417506}] :answer-field/correct {:answer/id #uuid "b70f01d1-c9cb-5c50-9266-5b397436034a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186417493} :answer-field/id #uuid "f999aae1-a9f0-58f9-8bee-410f830f1fb6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186417601}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9eda2a4b-3d8a-59f1-94ed-61897f90dd80" :question/math-academy-id "q-213372" :question/problem "Consider a relation $R$ that is defined on the set $A={1,2,3}.$ Given that $R$ is symmetric, enter the missing values in the adjacency matrix. \n\n**Note**: If there is not enough information to determine a particular cell's value, then select the question mark $(\\text{?}).$\n\n|  | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- |\n| $1$ | $1$ | {{field-1}} | $1$ |\n| $2$ | $0$ | $1$ | {{field-2}} |\n| $3$ | {{field-3}} | $1$ | {{field-4}} |" :question/worked-solution "First, recall the following definitions:\n\n- A binary relation $R,$ defined on a set $A,$ is *symmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,⟹\\,(y,x)\\in R.\n$$\n\nIn other words, if a pair $(x,y)$ belongs to a symmetric relation, then the pair $(y,x)$ should also be in the relation.\n\n- A binary relation $R,$ defined on a set $A,$ is *antisymmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,\\text{and}\\,(y,x)\\in R\\,⟹\\,x=y.\n$$\n\nIn other words, only one of the pairs, either $(x,y)$ or $(y,x),$ can be in an antisymmetric relation. Note that this condition allows pairs of the form $(x,x).$\n\nWe are given elements of the adjacency matrix in the following highlighted cells outside the diagonal:  \n\n|  | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- |\n| $1$ | $1$ |  | $1$ |\n| $2$ | $0$ | $1$ |  |\n| $3$ |  | $1$ |  |\n\nAs a result, the relation contains the pairs $(1,3)$ and $(3,2).$ Since $R$ must be symmetric, we require \n\n$$\n(3,1)\\in R,\\,(2,3)\\in R.\n$$\n\nSo, the cells corresponding to these elements must all equal $1.$\n\n|  | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- |\n| $1$ | $1$ |  | $1$ |\n| $2$ | $0$ | $1$ | $1$ |\n| $3$ | $1$ | $1$ |  |\n\nAlso, note the following:\n\n- The symmetric relation condition is equivalent to $(x,y)\\notin R⟹(y,x)\\notin R.$ Therefore, $(2,1)\\notin R$ implies $(1,2)\\notin R.$\n\n- We do not have enough information to determine whether $(3,3)$ is an element of $R.$\n\nLet's add this information to our table.\n\n|  | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- |\n| $1$ | $1$ | $0$ | $1$ |\n| $2$ | $0$ | $1$ | $1$ |\n| $3$ | $1$ | $1$ | $?$ |"}] [{:db/id #edb/ref 17592186204267 :knowledge-point/_questions [{:db/id #edb/ref 17592186203924 :knowledge-point/id #uuid "b7ca5b3a-0cd7-5325-8b14-6ac2b0dda994" :knowledge-point/title "Identifying Symmetric and Antisymmetric Relations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44b27acb-56a0-5a37-a759-2e92f4d95422" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "symmetric" :db/id #edb/ref 17592186417419} {:answer/id #uuid "efb36215-c68b-5cad-b85d-c3c83bfc846d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "antisymmetric" :db/id #edb/ref 17592186417536}] :answer-field/correct {:answer/id #uuid "44b27acb-56a0-5a37-a759-2e92f4d95422" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "symmetric" :db/id #edb/ref 17592186417419} :answer-field/id #uuid "1b132b3a-9126-5417-89ca-76b0debdd83e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186417553} {:answer-field/choices [{:answer/id #uuid "503d2955-c940-5895-89c0-b837afe62422" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=y" :db/id #edb/ref 17592186417426} {:answer/id #uuid "6575c01f-cf77-5ba8-8141-df609ef60155" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y,x)\\in R" :db/id #edb/ref 17592186417437} {:answer/id #uuid "ac8bca78-4b7b-5746-9df3-aed03e18c52e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y,x)\\notin R" :db/id #edb/ref 17592186417484} {:answer/id #uuid "ad2d05dd-0008-5725-9fee-359bcb18b6bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne y" :db/id #edb/ref 17592186417486}] :answer-field/correct {:answer/id #uuid "6575c01f-cf77-5ba8-8141-df609ef60155" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y,x)\\in R" :db/id #edb/ref 17592186417437} :answer-field/id #uuid "8e51691e-f830-5422-8951-de5df1038574" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186417578}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "37eb7b35-93ad-5ec5-a3ec-aea21530b881" :question/math-academy-id "q-213433" :question/problem "Consider the following relation defined on the set $A={2,4,8}.$ \n\n$$\nR={(2,2),(2,4),(2,8),(4,2),(8,2)}\n$$\n\nSelect the options that make the following reasoning correct:\n\nSince for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,⟹\\,{{field-1}},\n$$\n\n \nthe relation is \n{{field-2}}." :question/worked-solution "First, recall the following definitions:\n\n- A binary relation $R,$ defined on a set $A,$ is *symmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,⟹\\,(y,x)\\in R.\n$$\n\nIn other words, if a pair $(x,y)$ belongs to a symmetric relation, then the pair $(y,x)$ should also be in the relation.\n\n- A binary relation $R,$ defined on a set $A,$ is *antisymmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,\\text{and}\\,(y,x)\\in R\\,⟹\\,x=y.\n$$\n\nIn other words, only one of the pairs, either $(x,y)$ or $(y,x),$ can be in an antisymmetric relation. Note that this condition allows pairs of the form $(x,x).$\n\nOur relation is defined on ${2,4,8}.$ Notice that:\n\n- $(2,4)\\in R$ and $(4,2)\\in R$\n\n- $(2,8)\\in R$ and $(8,2)\\in R$\n\nThere are no other pairs of the form $(x,y)$ with $x\\ne y$ in the relation. So, for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,⟹\\,(y,x)\\in R.\n$$\n\nTherefore, the relation is  $\\text{symmetric}.$"}] [{:db/id #edb/ref 17592186417607 :knowledge-point/_questions [{:db/id #edb/ref 17592186203924 :knowledge-point/id #uuid "b7ca5b3a-0cd7-5325-8b14-6ac2b0dda994" :knowledge-point/title "Identifying Symmetric and Antisymmetric Relations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2e1189f-caa1-573c-b240-3670a06a7492" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "symmetric" :db/id #edb/ref 17592186417503} {:answer/id #uuid "efac7a6c-a549-5e8b-b44f-34063d93ac38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "antisymmetric" :db/id #edb/ref 17592186417535}] :answer-field/correct {:answer/id #uuid "c2e1189f-caa1-573c-b240-3670a06a7492" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "symmetric" :db/id #edb/ref 17592186417503} :answer-field/id #uuid "315b90b8-3579-537d-b0a8-3d925fb81f19" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186417558} {:answer-field/choices [{:answer/id #uuid "3024eaf7-b4a4-5c0f-8216-9554c9812c01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne y" :db/id #edb/ref 17592186417410} {:answer/id #uuid "7060f16c-94d3-573c-ae34-673a8dbf65fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y,x)\\in R" :db/id #edb/ref 17592186417445} {:answer/id #uuid "e8b420ea-8607-5349-859b-557962fda19c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=y" :db/id #edb/ref 17592186417530} {:answer/id #uuid "f4dc12f8-b5a2-54fc-ad20-19a9a277ced8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y,x)\\notin R" :db/id #edb/ref 17592186417538}] :answer-field/correct {:answer/id #uuid "7060f16c-94d3-573c-ae34-673a8dbf65fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y,x)\\in R" :db/id #edb/ref 17592186417445} :answer-field/id #uuid "7f3e3ed1-e6b0-5edd-bc5c-8babe4b32fe8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186417574}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "83135e57-d72a-5f9f-8787-4bc48f405724" :question/math-academy-id "q-213472" :question/problem "Consider the following relation defined on the set $A={5,10,15}.$ \n\n$$\nR={(5,5),(5,10),(10,5)}\n$$\n\nSelect the options that make the following reasoning correct:\n\nSince for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,⟹\\,{{field-1}},\n$$\n\n \nthe relation is \n{{field-2}}." :question/worked-solution "First, recall the following definitions:\n\n- A binary relation $R,$ defined on a set $A,$ is *symmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,⟹\\,(y,x)\\in R.\n$$\n\nIn other words, if a pair $(x,y)$ belongs to a symmetric relation, then the pair $(y,x)$ should also be in the relation.\n\n- A binary relation $R,$ defined on a set $A,$ is *antisymmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,\\text{and}\\,(y,x)\\in R\\,⟹\\,x=y.\n$$\n\nIn other words, only one of the pairs, either $(x,y)$ or $(y,x),$ can be in an antisymmetric relation. Note that this condition allows pairs of the form $(x,x).$\n\nOur relation is defined on ${5,10,15}.$ Notice that:\n\n- $(5,10)\\in R$ and $(10,5)\\in R$\n\nThere are no other pairs of the form $(x,y)$ with $x\\ne y$ in the relation. So, for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,⟹\\,(y,x)\\in R.\n$$\n\nTherefore, the relation is  $\\text{symmetric}.$"}] [{:db/id #edb/ref 17592186417603 :knowledge-point/_questions [{:db/id #edb/ref 17592186203924 :knowledge-point/id #uuid "b7ca5b3a-0cd7-5325-8b14-6ac2b0dda994" :knowledge-point/title "Identifying Symmetric and Antisymmetric Relations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d60191f-8b09-58fc-88dd-c1feb852be39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "symmetric" :db/id #edb/ref 17592186417442} {:answer/id #uuid "be49dc7b-f0e9-5b31-9471-e7975f0dc5c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "antisymmetric" :db/id #edb/ref 17592186417499}] :answer-field/correct {:answer/id #uuid "be49dc7b-f0e9-5b31-9471-e7975f0dc5c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "antisymmetric" :db/id #edb/ref 17592186417499} :answer-field/id #uuid "07a8c960-fbd6-58c0-9b4d-29380f121ae1" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186417550} {:answer-field/choices [{:answer/id #uuid "7cdfee2c-3ebf-576e-ac43-6fe2c0795441" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y,x)\\in R" :db/id #edb/ref 17592186417458} {:answer/id #uuid "b708513e-9a16-5d19-a44b-a0911d96e3f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y,y)\\in R" :db/id #edb/ref 17592186417492} {:answer/id #uuid "e5292722-7f3b-56a1-8b87-f169bd48d491" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x,x)\\notin R" :db/id #edb/ref 17592186417527} {:answer/id #uuid "fc650c37-921a-5af1-93b0-33d63951c635" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y,x)\\notin R" :db/id #edb/ref 17592186417543}] :answer-field/correct {:answer/id #uuid "7cdfee2c-3ebf-576e-ac43-6fe2c0795441" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y,x)\\in R" :db/id #edb/ref 17592186417458} :answer-field/id #uuid "8a604a5c-1a1e-5a3d-addc-b224a59bd107" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186417577} {:answer-field/choices [{:answer/id #uuid "15596502-16d6-5f2a-842b-48e247cfb1d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=y" :db/id #edb/ref 17592186417389} {:answer/id #uuid "91dba1c6-ea68-5933-aa3b-c5ccba835780" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne y" :db/id #edb/ref 17592186417473}] :answer-field/correct {:answer/id #uuid "15596502-16d6-5f2a-842b-48e247cfb1d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=y" :db/id #edb/ref 17592186417389} :answer-field/id #uuid "e59ed41d-6f63-5211-9981-7094e0a62bd3" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186417595}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3a2bda0c-9e42-53f1-a525-c0492f5a91dc" :question/math-academy-id "q-213473" :question/problem "Consider the following relation defined on the set $A={0,2,5}.$ \n\n$$\nR={(0,0),(0,2),(5,0),(5,2)}\n$$\n\nSelect the options that make the following reasoning correct:\n\nSince for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,\\text{and}\\,{{field-1}}\\,⟹\\,{{field-2}}\\,,\n$$\n\n \nthe relation is \n{{field-3}}." :question/worked-solution "First, recall the following definitions:\n\n- A binary relation $R,$ defined on a set $A,$ is *symmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,⟹\\,(y,x)\\in R.\n$$\n\nIn other words, if a pair $(x,y)$ belongs to a symmetric relation, then the pair $(y,x)$ should also be in the relation.\n\n- A binary relation $R,$ defined on a set $A,$ is *antisymmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,\\text{and}\\,(y,x)\\in R\\,⟹\\,x=y.\n$$\n\nIn other words, only one of the pairs, either $(x,y)$ or $(y,x),$ can be in an antisymmetric relation. Note that this condition allows pairs of the form $(x,x).$\n\nOur relation is defined on ${0,2,5}.$ Notice that:\n\n- $(0,2)\\in R$ and $(2,0)\\notin R$\n\n- $(5,0)\\in R$ and $(0,5)\\notin R$\n\n- $(5,2)\\in R$ and $(2,5)\\notin R$\n\nThere are no other pairs of the form $(x,y)$ with $x\\ne y$ in the relation. So, for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,\\text{and}\\,(y,x)\\in R\\,⟹\\,x=y.\n$$\n\nTherefore, the relation is  $\\text{antisymmetric}.$"}] [{:db/id #edb/ref 17592186417610 :knowledge-point/_questions [{:db/id #edb/ref 17592186203924 :knowledge-point/id #uuid "b7ca5b3a-0cd7-5325-8b14-6ac2b0dda994" :knowledge-point/title "Identifying Symmetric and Antisymmetric Relations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22a238fa-8707-5936-a0d6-2835ee491b30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,1)\\in R" :db/id #edb/ref 17592186417397} {:answer/id #uuid "391cc89c-62e9-5f44-adb0-3ca923fdb954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-1)\\in R" :db/id #edb/ref 17592186417415}] :answer-field/correct {:answer/id #uuid "391cc89c-62e9-5f44-adb0-3ca923fdb954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-1)\\in R" :db/id #edb/ref 17592186417415} :answer-field/id #uuid "9908f439-3475-54c2-acaa-70b8aa532972" :answer-field/key "field-2" :answer-field/type {:db/id #edb/re