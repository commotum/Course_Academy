n is neither symmetric nor antisymmetric." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-efda5b75-970c-5d64-8c59-14946d984faa" "answer-field-9908f439-3475-54c2-acaa-70b8aa532972" "answer-field-e2cae02a-700a-53d3-8cda-4c0eb2c59ce9" "answer-field-e7950904-3c40-596d-ac53-ce1c8b5f7021" "answer-field-c184bc6c-a6ab-5e85-a34b-c9dd86fb2923" "answer-field-f6de0020-8ee8-5ff1-8ab7-98a147556959"] :db/ensure [:question/validate]} {:db/id "answer-field-efda5b75-970c-5d64-8c59-14946d984faa" :answer-field/id #uuid "efda5b75-970c-5d64-8c59-14946d984faa" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-be0263b8-da6c-5757-b44e-2150685ff381" :answer-field/choices ["answer-be0263b8-da6c-5757-b44e-2150685ff381" "answer-e0a43c50-a4d7-589a-a714-f4ff32df2442"] :db/ensure [:answer-field/validate]} {:db/id "answer-be0263b8-da6c-5757-b44e-2150685ff381" :answer/id #uuid "be0263b8-da6c-5757-b44e-2150685ff381" :answer/type :answer.type/math :answer/value "(-1,2)\\in R" :db/ensure [:answer/validate]} {:db/id "answer-e0a43c50-a4d7-589a-a714-f4ff32df2442" :answer/id #uuid "e0a43c50-a4d7-589a-a714-f4ff32df2442" :answer/type :answer.type/math :answer/value "(0,0)\\in R" :db/ensure [:answer/validate]} {:db/id "answer-field-9908f439-3475-54c2-acaa-70b8aa532972" :answer-field/id #uuid "9908f439-3475-54c2-acaa-70b8aa532972" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-391cc89c-62e9-5f44-adb0-3ca923fdb954" :answer-field/choices ["answer-22a238fa-8707-5936-a0d6-2835ee491b30" "answer-391cc89c-62e9-5f44-adb0-3ca923fdb954"] :db/ensure [:answer-field/validate]} {:db/id "answer-22a238fa-8707-5936-a0d6-2835ee491b30" :answer/id #uuid "22a238fa-8707-5936-a0d6-2835ee491b30" :answer/type :answer.type/math :answer/value "(1,1)\\in R" :db/ensure [:answer/validate]} {:db/id "answer-391cc89c-62e9-5f44-adb0-3ca923fdb954" :answer/id #uuid "391cc89c-62e9-5f44-adb0-3ca923