6114992 :question/id #uuid "514f238c-bac6-516a-a498-d1569db22471" :question/math-academy-id "e-3279"} :knowledge-point/id #uuid "437a71fe-92e0-58e3-9f49-6560b2755776" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049224}] :knowledge-point/questions [{:db/id #edb/ref 17592186115565} {:db/id #edb/ref 17592186115574} {:db/id #edb/ref 17592186115675} {:db/id #edb/ref 17592186259685} {:db/id #edb/ref 17592186290627} {:db/id #edb/ref 17592186290628} {:db/id #edb/ref 17592186290629} {:db/id #edb/ref 17592186290630} {:db/id #edb/ref 17592186290631} {:db/id #edb/ref 17592186545800} {:db/id #edb/ref 17592186545869}] :knowledge-point/title "Determining the Area of a Triangle Given a Trigonometric Ratio of an Angle and the Length of a Leg"} :step/id #uuid "afebb130-5563-5b16-9d8e-fa9f724ad05c" :step/math-academy-id 456969 :step/next {:db/id #edb/ref 17592186116312}} {:db/id #edb/ref 17592186116312 :step/content {:db/id #edb/ref 17592186115360 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114993 :question/id #uuid "759db275-8647-5bf1-a3fb-dc014c920279" :question/math-academy-id "e-3282"} :knowledge-point/id #uuid "fe83dedc-3034-5e3a-b546-dd57c0ccc6e8" :knowledge-point/questions [{:db/id #edb/ref 17592186115566} {:db/id #edb/ref 17592186115677} {:db/id #edb/ref 17592186259686} {:db/id #edb/ref 17592186259687} {:db/id #edb/ref 17592186259688} {:db/id #edb/ref 17592186290632} {:db/id #edb/ref 17592186295267} {:db/id #edb/ref 17592186335933} {:db/id #edb/ref 17592186345256} {:db/id #edb/ref 17592186345257} {:db/id #edb/ref 17592186545812} {:db/id #edb/ref 17592186545843} {:db/id #edb/ref 17592186552415}] :knowledge-point/title "Finding the Area of a Triangle by Solving for a Variable Given an Angle"} :step/id #uuid "e7059010-035b-50fa-b4f2-ccd4b5b1eb28" :step/math-academy-id 456973}] :activity/title "Calculating Areas of Right Triangles Using Trigonometry" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115434}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186552534} :activity/id #uuid "7e266baf-6076-5151-ac24-f5cce138038c" :activity/scope {:db/id #edb/ref 17592186049449 :topic/id #uuid "f65efa00-a9e9-5306-b53a-84a278412a36" :topic/math-academy-id 1608} :activity/steps [{:db/id #edb/ref 17592186552534 :step/content {:db/id #edb/ref 17592186552471 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "247fa86a-645c-57f8-a89a-6503e26ce257" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10.5" :db/id #edb/ref 17592186551748} {:answer/id #uuid "377fdb35-62f8-58d4-acdb-38cee3c07574" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186551798} {:answer/id #uuid "a04a85bb-32c3-5756-bee0-77f10e337177" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11.5" :db/id #edb/ref 17592186552053} {:answer/id #uuid "c18f3614-44fc-5c08-a3f0-a1649c4fcb82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186552127} {:answer/id #uuid "f171aadd-79df-5adf-a87e-68012d759eab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186552228}] :answer-field/correct {:db/id #edb/ref 17592186551748} :answer-field/id #uuid "410ec2bb-6a29-58bd-a046-3457e91665a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186552290}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8a507b16-48a7-5e03-967f-cb9296e5eda5" :question/math-academy-id "q-67547" :question/problem "![](images/8a/8af022dcc3065a036ba04fb79e75c43906ccef7f32e3416917778afec3d344a8.png)\n\nGiven that $\\operatorname{tan}⁡(m∠A)=\\frac{7}{3},$ calculate the area (in square units) of $△ABC$ shown above." :question/worked-solution "In this case, the area of the right triangle is\n\n$$\nA=\\frac{1}{2}AC\\cdot BC.\n$$\n\nWe are given that $\\operatorname{tan}⁡(m∠A)=\\frac{7}{3}.$ Notice that relative to $∠A,$ we have expressions for the lengths of the opposite side $\\overset{―}{BC}$ and adjacent side $\\overset{―}{AC}.$ Hence, we can use the tangent ratio to solve for $x:$\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡(m∠A) & =\\frac{BC}{AC} \\\\ \\frac{7}{3} & =\\frac{4x-1}{x+1} \\\\ 7(x+1) & =3(4x-1) \\\\ 7x+7 & =12x-3 \\\\ 7x-12x & =-3-7 \\\\ -5x & =-10 \\\\ x & =2\\end{aligned}\n$$\n\nSo, the side lengths are\n\n$$\n\\begin{aligned}AC & =x+1=2+1=3, \\\\ BC & =4x-1=4(2)-1=7.\\end{aligned}\n$$\n\nTherefore, the area of $△ABC$ is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}AC\\cdot BC \\\\  & =\\frac{1}{2}\\cdot 3\\cdot 7 \\\\  & =10.5.\\end{aligned}\n$$"} :step/id #uuid "0bddf274-21d6-5005-a1f9-cd9d602c1a33" :step/next {:db/id #edb/ref 17592186552551}} {:db/id #edb/ref 17592186552551 :step/content {:db/id #edb/ref 17592186552414 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "548caf3b-b72d-5235-982e-308d7b3a3fd3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "169" :db/id #edb/ref 17592186551868} {:answer/id #uuid "6c7e3b50-d234-5a04-8390-608a16441e36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "108" :db/id #edb/ref 17592186551919} {:answer/id #uuid "9fd1f07c-0d7a-552b-98a0-fc0ca4c49be7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "130" :db/id #edb/ref 17592186552051} {:answer/id #uuid "b08a4c8d-3495-5fbc-b6bd-1fda68fe8003" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "121" :db/id #edb/ref 17592186552091} {:answer/id #uuid "c5b8d687-bba2-5d21-a3ba-c65d066667a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "144" :db/id #edb/ref 17592186552135}] :answer-field/correct {:db/id #edb/ref 17592186552135} :answer-field/id #uuid "aab0fb0a-8165-54b3-b1b3-36d377c7585d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186552354}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1bc85b39-7b87-56e7-bb5c-212278f36ea1" :question/math-academy-id "q-124430" :question/problem "![](images/e9/e9610ceabe4a1e82995e589f482887dd9f4325218cfb5d37b5795dcb5a3bbbdc.png)\n\nGiven that $\\operatorname{tan}⁡(m∠A)=\\frac{9}{8},$ calculate the area (in square units) of $△ABC$ shown above." :question/worked-solution "In this case, the area of the right triangle is\n\n$$\nA=\\frac{1}{2}AC\\cdot BC.\n$$\n\nWe are given that $\\operatorname{tan}⁡(m∠A)=\\frac{9}{8}.$ Notice that relative to $∠A,$ we have expressions for the lengths of the opposite side $\\overset{―}{BC}$ and adjacent side $\\overset{―}{AC}.$ Hence, we can use the tangent ratio to solve for $x:$\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡(m∠A) & =\\frac{BC}{AC} \\\\ \\frac{9}{8} & =\\frac{4x-2}{3x+1} \\\\ 9(3x+1) & =8(4x-2) \\\\ 27x+9 & =32x-16 \\\\ 9+16 & =32x-27x \\\\ 25 & =5x \\\\ x & =5\\end{aligned}\n$$\n\nSo, the side lengths are\n\n$$\n\\begin{aligned}BC & =4x-2=4(5)-2=18, \\\\ AC & =3x+1=3(5)+1=16.\\end{aligned}\n$$\n\nTherefore, the area of $△ABC$ is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}AC\\cdot BC \\\\  & =\\frac{1}{2}\\cdot 16\\cdot 18 \\\\  & =144.\\end{aligned}\n$$"} :step/id #uuid "38f025ec-1329-54cc-9b54-18fc83dfd877" :step/next {:db/id #edb/ref 17592186552565}} {:db/id #edb/ref 17592186552565 :step/content {:db/id #edb/ref 17592186552415 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a457f71e-f579-5a90-b5de-4ace90c01a2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "34.9" :db/id #edb/ref 17592186552061}] :answer-field/correct {:db/id #edb/ref 17592186552061} :answer-field/id #uuid "1ad64ad7-3b3f-5c5b-8b8e-0a49ed062733" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186552270}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1eaad09e-a27c-5525-b0d1-ca7f3b1ec2af" :question/math-academy-id "q-244482" :question/problem "![](images/ed/ed4fb3bd21624b15349fd520c2944389d81af99d81962fa54b815628fd7360aa.png)\n\nIn square units rounded to one decimal place, the area of $△ABC$ is{{field-1}}." :question/worked-solution "In this case, the area of the right triangle is\n\n$$\nA=\\frac{1}{2}AC\\cdot BC.\n$$\n\nWe are given that $m∠B={35}^{∘}.$ Notice that relative to $∠B,$ we have expressions for the lengths of the opposite side $\\overset{―}{AC}$ and adjacent side $\\overset{―}{BC}.$ Hence, we can use the tangent ratio to solve for $x:$\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡(m∠B) & =\\frac{AC}{BC} \\\\ \\operatorname{tan}⁡({35}^{∘}) & =\\frac{x+2}{2x} \\\\ 2x\\cdot \\operatorname{tan}⁡({35}^{∘}) & =x+2 \\\\ 2x\\cdot \\operatorname{tan}⁡({35}^{∘})-x & =2 \\\\ x(2\\operatorname{tan}⁡({35}^{∘})-1) & =2 \\\\ x & =\\frac{2}{2\\operatorname{tan}⁡({35}^{∘})-1} \\\\ x & =4.994\\,8…\\end{aligned}\n$$\n\nSo, the side lengths are \n\n$$\n\\begin{aligned}BC & =2x=2(4.994\\,8…)=9.989\\,6…, \\\\ AC & =x+2=(4.994\\,8…)+2=6.994\\,8….\\end{aligned}\n$$\n\nTherefore, the area of $△ABC$ is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}(9.989\\,6…)(6.994\\,8…) \\\\  & =34.937\\,8… \\\\  & ≈34.9,\\end{aligned}\n$$\n\nrounded to one decimal place."} :step/id #uuid "6cec34a3-6181-515e-ab04-4ee2f91ac0ab"}] :activity/title "Calculating Areas of Right Triangles Using Trigonometry" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186551655}]}
