#{[{:db/id #edb/ref 17592186183935 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186184320 :knowledge-point/id #uuid "5fcba20f-b43b-558d-bd84-d76816d3186b" :knowledge-point/title "Combining Radical Expressions Using the Rules of Absolute Value"}] :question/id #uuid "d669aafc-c1f1-5acd-b7d8-5ff0f31178b0" :question/math-academy-id "e-1361" :question/problem "Simplify $\\sqrt{x} \\cdot \\sqrt{x^3}.$" :question/worked-solution "We perform the multiplication under a single radical and then simplify the result:\n\n$$\n\\eqalign{\n\t\t\\sqrt{x} \\cdot \\sqrt{x^3} &= \\\n\t\t\\sqrt{x \\cdot x^3} &= \\\n\t\t\\sqrt{x^4} &= \\\n\t\t|x^2|\n\t}\n$$\n\nA squared number is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have\n\n$$\n\\begin{aligned}|{x}^{2}| & ={x}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186183936 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186184321 :knowledge-point/id #uuid "de2b7926-fa13-5636-9682-8fa382336be7" :knowledge-point/title "Simplifying a Cube Root Expression"}] :question/id #uuid "d6b143d1-7d3f-5836-8797-19cb37181541" :question/math-academy-id "e-1364" :question/problem "Simplify $\\sqrt[3]{16x^2}\\cdot \\sqrt[3]{4x}.$" :question/worked-solution "We perform the multiplication under a single radical and then simplify the result:\n\n$$\n\\begin{aligned}\\sqrt[3]{16{x}^{2}}\\cdot \\sqrt[3]{4x} & = \\\\ \\sqrt[3]{16{x}^{2}\\cdot 4x} & = \\\\ \\sqrt[3]{64{x}^{3}} & = \\\\ \\sqrt[3]{(4x)^{3}} & = \\\\ 4x & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184131 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186184225 :knowledge-point/id #uuid "37603549-5c55-5b9e-8d2d-2121db167d02" :knowledge-point/title "Combining Radical Expressions"}] :question/id #uuid "cd3fba6a-bb16-51b1-b2ea-fb88656d5aa6" :question/math-academy-id "e-9979" :question/problem "Find an expression that's equal to $\\sqrt{5w^3} \\cdot \\sqrt{uv}$ by combining the radicals." :question/worked-solution "We apply the product rule for radicals, as follows:\n\n$$\n\\begin{aligned}\\sqrt{5{w}^{3}}\\cdot \\sqrt{uv} & = \\\\ \\sqrt{5{w}^{3}\\cdot uv} & = \\\\ \\sqrt{5uv{w}^{3}} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186503733 :knowledge-point/_questions [{:db/id #edb/ref 17592186184320 :knowledge-point/id #uuid "5fcba20f-b43b-558d-bd84-d76816d3186b" :knowledge-point/title "Combining Radical Expressions Using the Rules of Absolute Value"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05cd87b2-a486-59e8-85ee-e76c7c31902b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15{z}^{4}" :db/id #edb/ref 17592186502990} {:answer/id #uuid "10e1544e-48e2-5db7-a5cf-be0b233078c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{2}\\sqrt{15z}" :db/id #edb/ref 17592186503018} {:answer/id #uuid "492dabbf-4621-5e6f-9294-dfbe3cbd667e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{3}\\sqrt{15z}" :db/id #edb/ref 17592186503118} {:answer/id #uuid "9f0a6e86-1cc6-5082-a1e5-5f66102b512a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15{z}^{3}\\sqrt{z}" :db/id #edb/ref 17592186503299} {:answer/id #uuid "ddeb8158-e099-5e92-b52e-6505d13a382f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{4}\\sqrt{15}" :db/id #edb/ref 17592186503431}] :answer-field/correct {:answer/id #uuid "492dabbf-4621-5e6f-9294-dfbe3cbd667e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{3}\\sqrt{15z}" :db/id #edb/ref 17592186503118} :answer-field/id #uuid "5505afd0-bf5c-53e8-aefd-6b87f5951abf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503550}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b57aff47-fce6-506a-bd4c-d85de1a296a5" :question/math-academy-id "q-110957" :question/problem "If $z\\ge 0,$ then $\\sqrt{3z}\\cdot \\sqrt{5{z}^{6}}=$" :question/worked-solution "We perform the multiplication under a single radical and then simplify the result:\n\n$$\n\\begin{aligned}\\sqrt{3z}\\cdot \\sqrt{5{z}^{6}} & = \\\\ \\sqrt{3z\\cdot 5{z}^{6}} & = \\\\ \\sqrt{{z}^{6}\\cdot 15z} & = \\\\ \\sqrt{{({z}^{3})}^{2}\\cdot 15z} & = \\\\ \\sqrt{{({z}^{3})}^{2}}\\cdot \\sqrt{15z} & = \\\\ |{z}^{3}|\\cdot \\sqrt{15z} & = \\\\ |z{|}^{3}\\cdot \\sqrt{15z} & =\\end{aligned}\n$$\n\nSince $z\\ge 0,$ we have $|z|=z,$ and we can simplify further. Therefore, our final answer is\n\n$$\n|z{|}^{3}\\cdot \\sqrt{15z}={z}^{3}\\sqrt{15z}.\n$$"}] [{:db/id #edb/ref 17592186503673 :knowledge-point/_questions [{:db/id #edb/ref 17592186184225 :knowledge-point/id #uuid "37603549-5c55-5b9e-8d2d-2121db167d02" :knowledge-point/title "Combining Radical Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03aa9e77-c1bd-5499-b44b-44dc50ce6ae6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\sqrt{u+v}" :db/id #edb/ref 17592186502986} {:answer/id #uuid "08f49d0c-f8bf-5cbd-b4c6-6dfe0604684e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\sqrt{uv}" :db/id #edb/ref 17592186503000} {:answer/id #uuid "2cbb732d-82d4-547c-80a8-7d83e3b744d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{14u+v}" :db/id #edb/ref 17592186503063} {:answer/id #uuid "5ab73013-fe3d-5603-853c-82b4701416c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{7uv}" :db/id #edb/ref 17592186503156} {:answer/id #uuid "e61a8f64-3597-5f56-9cf2-f1c26072d67c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{14uv}" :db/id #edb/ref 17592186503453}] :answe