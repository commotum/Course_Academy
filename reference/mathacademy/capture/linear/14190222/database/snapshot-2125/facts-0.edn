 [17592186050887 #edb/ref 1035 #uuid "6e563fb5-2e53-5b68-a90b-a963f8d0dc96" #edb/ref 17592186045417] [17592186050890 #edb/ref 1027 #edb/ref 17592186048132 #edb/ref 17592186045417] [17592186050890 #edb/ref 1027 #edb/ref 17592186049797 #edb/ref 17592186045417] [17592186050890 #edb/ref 1027 #edb/ref 17592186050496 #edb/ref 17592186045417] [17592186050890 #edb/ref 1028 #edb/ref 17592186179761 #edb/ref 17592186045417] [17592186050890 #edb/ref 1028 #edb/ref 17592186179762 #edb/ref 17592186045417] [17592186050890 #edb/ref 1031 "The Square Root of a Perfect Square With Domain Restrictions" #edb/ref 17592186045417] [17592186050890 #edb/ref 1033 3729 #edb/ref 17592186045417] [17592186050890 #edb/ref 1035 #uuid "6eaa79dd-c90f-5e62-94cb-871b5a23b05e" #edb/ref 17592186045417] [17592186183935 #edb/ref 1069 "e-1361" #edb/ref 17592186045417] [17592186183935 #edb/ref 1071 "Simplify $\\sqrt{x} \\cdot \\sqrt{x^3}.$" #edb/ref 17592186045417] [17592186183935 #edb/ref 1072 #uuid "d669aafc-c1f1-5acd-b7d8-5ff0f31178b0" #edb/ref 17592186045417] [17592186183935 #edb/ref 1074 "We perform the multiplication under a single radical and then simplify the result:\n\n$$\n\\eqalign{\n\t\t\\sqrt{x} \\cdot \\sqrt{x^3} &= \\\n\t\t\\sqrt{x \\cdot x^3} &= \\\n\t\t\\sqrt{x^4} &= \\\n\t\t|x^2|\n\t}\n$$\n\nA squared number is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have\n\n$$\n\\begin{aligned}|{x}^{2}| & ={x}^{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186183936 #edb/ref 1069 "e-1364" #edb/ref 17592186045417] [17592186183936 #edb/ref 1071 "Simplify $\\sqrt[3]{16x^2}\\cdot \\sqrt[3]{4x}.$" #edb/ref 17592186045417] [17592186183936 #edb/ref 1072 #uuid "d6b143d1-7d3f-5836-8797-19cb37181541" #edb/ref 17592186045417] [17592186183936 #edb/ref 1074 "We perform the multiplication under a single radical and then simplify the result:\n\n$$\n\\begin{aligned}\\sqrt[3]{16{x}^{2}}\\cdot \\sqrt[3]{4x} & = \\\\ \\sqrt[3]{16{x}^{2}\\cdot 4x} & = \\\\ \\sqrt[3]{64{x}^{3}} & = \\\\ \\sqrt[3]{(4x)^{3}} & = \\\\ 4x & \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186184131 #edb/ref 1069 "e-9979" #edb/ref 17592186045417] [17592186184131 #edb/ref 1071 "Find an expression that's equal to $\\sqrt{5w^3} \\cdot \\sqrt{uv}$ by combining the radicals." #edb/ref 17592186045417] [17592186184131 #edb/ref 1072 #uuid "cd3fba6a-bb16-51b1-b2ea-fb88656d5aa6" #edb/ref 17592186045417] [17592186184131 #edb/ref 1074 "We apply the product rule for radicals, as follows:\n\n$$\n\\begin{aligned}\\sqrt{5{w}^{3}}\\cdot \\sqrt{uv} & = \\\\ \\sqrt{5{w}^{3}\\cdot uv} & = \\\\ \\sqrt{5uv{w}^{3}} & \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186184225 #edb/ref 1037 #edb/ref 17592186049923 #edb/ref 17592186045417] [17592186184225 #edb/ref 1038 #edb/ref 17592186184801 #edb/ref 17592186045417] [17592186184225 #edb/ref 1038 #edb/ref 17592186184802 #edb/ref 17592186045417] [17592186184225 #edb/ref 1038 #edb/ref 17592186503673 #edb/ref 17592186045417] [17592186184225 #edb/ref 1038 #edb/ref 17592186503703 #edb/ref 17592186045417] [17592186184225 #edb/ref 1039 "Combining Radical Expressions" #edb/ref 17592186045417] [17592186184225 #edb/ref 1041 #edb/ref 17592186184131 #edb/ref 17592186045417] [17592186184225 #edb/ref 1042 #uuid "37603549-5c55-5b9e-8d2d-2121db167d02" #edb/ref 17592186045417] [17592186184320 #edb/ref 1037 #edb/ref 17592186050890 #edb/ref 17592186045417] [17592186184320 #edb/ref 1038 #edb/ref 17592186184740 #edb/ref 17592186045417] [17592186184320 #edb/ref 1038 #edb/ref 17592186184803 #edb/ref 17592186045417] [17592186184320 #edb/ref 1038 #edb/ref 17592186503733 #edb/ref 17592186045417] [17592186184320 #edb/ref 1038 #edb/ref 17592186503743 #edb/ref 17592186045417] [17592186184320 #edb/ref 1039 "Combining Radical Expressions Using the Rules of Absolute Value" #edb/ref 17592186045417] [17592186184320 #edb/ref 1041 #edb/ref 17592186183935 #edb/ref 17592186045417] [17592186184320 #edb/ref 1042 #uuid "5fcba20f-b43b-558d-bd84-d76816d3186b" 