#{[{:activity/first-step {:db/id #edb/ref 17592186185016} :activity/id #uuid "a963d35a-d51d-50f7-b102-8821b5ecb011" :activity/scope {:db/id #edb/ref 17592186048132 :topic/id #uuid "81fdc96c-a638-5049-8995-3d48064b08cb" :topic/math-academy-id 3848} :activity/steps [{:db/id #edb/ref 17592186185015 :step/content {:db/id #edb/ref 17592186184225 :knowledge-point/canonical-example {:db/id #edb/ref 17592186184131 :question/id #uuid "cd3fba6a-bb16-51b1-b2ea-fb88656d5aa6" :question/math-academy-id "e-9979"} :knowledge-point/id #uuid "37603549-5c55-5b9e-8d2d-2121db167d02" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049923}] :knowledge-point/questions [{:db/id #edb/ref 17592186184801} {:db/id #edb/ref 17592186184802}] :knowledge-point/title "Combining Radical Expressions"} :step/id #uuid "2a88297e-0c93-59fc-a45e-bb8dc09591fe" :step/math-academy-id 37583 :step/next {:db/id #edb/ref 17592186185195}} {:db/id #edb/ref 17592186185016 :step/content {:db/id #edb/ref 17592186185346 :tutorial/content "The **product rule for radicals** states that the square root of a product equals the product of the square roots:\n\n$$\n\\begin{aligned} \\sqrt{a} \\cdot \\sqrt{b} = \\sqrt{ab} \\end{aligned}\n$$\n\nWe can use the product rule to combine radical expressions.\n\nFor example, let's suppose we want to combine the radicals in the following expression:\n\n$$\n\\sqrt{5x} \\cdot \\sqrt{6z}\n$$\n\nTo combine the radicals, we apply the product rule as follows:\n\n$$\n\\begin{aligned}\n\\sqrt{5x} \\cdot \\sqrt{6z} &=  \\\\\n\\sqrt{5x \\cdot 6z} &=  \\\\\n&= \\sqrt{30xz}\n\\end{aligned}\n$$" :tutorial/id #uuid "1c9d8f0d-315b-5c83-a8e6-17638c1c3d24" :tutorial/math-academy-id 6200 :tutorial/title "Introduction"} :step/id #uuid "9a6b95b2-a3b2-5264-9183-0fefe3abfed8" :step/math-academy-id 37588 :step/next {:db/id #edb/ref 17592186185015}} {:db/id #edb/ref 17592186185195 :step/content {:db/id #edb/ref 17592186184320 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183935 :question/id #uuid "d669aafc-c1f1-5acd-b7d8-5ff0f31178b0" :question/math-academy-id "e-1361"} :knowledge-point/id #uuid "5fcba20f-b43b-558d-bd84-d76816d3186b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050890}] :knowledge-point/questions [{:db/id #edb/ref 17592186184740} {:db/id #edb/ref 17592186184803}] :knowledge-point/title "Combining Radical Expressions Using the Rules of Absolute Value"} :step/id #uuid "83175ccc-7da0-50d9-b695-82571c0cb353" :step/math-academy-id 4307 :step/next {:db/id #edb/ref 17592186185196}} {:db/id #edb/ref 17592186185196 :step/content {:db/id #edb/ref 17592186185310 :tutorial/content "The product rule for radicals also works for higher-order roots, like the cube root. In the case of the cube root, we have\n\n$$\n\\sqrt[3]{ab} = \\sqrt[3]{a}\\cdot \\sqrt[3]{b}\n$$\n\nIn general,\n\n$$\n\\sqrt[n]{ab} = \\sqrt[n]{a}\\cdot \\sqrt[n]{b}\n$$" :tutorial/id #uuid "f9406c08-e6de-514e-aeae-9f581d5730a5" :tutorial/math-academy-id 1607 :tutorial/title "The Product Rule for Cube Roots"} :step/id #uuid "c0a3a07c-d5b4-5d4b-805c-3c93987ee6fe" :step/math-academy-id 4313 :step/next {:db/id #edb/ref 17592186185197}} {:db/id #edb/ref 17592186185197 :step/content {:db/id #edb/ref 17592186184321 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183936 :question/id #uuid "d6b143d1-7d3f-5836-8797-19cb37181541" :question/math-academy-id "e-1364"} :knowledge-point/id #uuid "de2b7926-fa13-5636-9682-8fa382336be7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048170}] :knowledge-point/questions [{:db/id #edb/ref 17592186184500} {:db/id #edb/ref 17592186184501}] :knowledge-point/title "Simplifying a Cube Root Expression"} :step/id #uuid "d028b29f-988d-5038-a9c2-8a95b472232b" :step/math-academy-id 4314}] :activity/title "Combining Radical Expressions Using the Product Rule" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186184432}]}
