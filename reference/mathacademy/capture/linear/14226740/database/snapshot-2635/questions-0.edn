#{[{:db/id #edb/ref 17592186546991 :knowledge-point/_questions [{:db/id #edb/ref 17592186073753 :knowledge-point/id #uuid "b4352698-7af7-5d74-9c3a-0f951c3e6078" :knowledge-point/title "Solving a Challenging System of Linear Equations Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b85cb2c-460d-5f91-86c0-674d13fae83e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186546309} {:answer/id #uuid "242eed59-c937-5dab-b478-b3a1accb9d4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186546329} {:answer/id #uuid "463e0a8b-5e11-54a2-8cdd-72b176626176" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186546407} {:answer/id #uuid "6a785a85-c477-5db9-a10d-570f963f9181" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186546485} {:answer/id #uuid "f5ff80ce-ffb0-542a-ba50-ce8557612884" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186546805}] :answer-field/correct {:answer/id #uuid "1b85cb2c-460d-5f91-86c0-674d13fae83e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186546309} :answer-field/id #uuid "e282d81b-1bfe-5c5b-abe6-d91779057814" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186546940}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3b789afd-79c7-56fc-b94a-f894f177dfe2" :question/math-academy-id "q-18555" :question/problem "Given the system of equations below, what is the value of $a+b?$\n\n$$\n\\{\\begin{aligned}2b=6a+14 \\\\ 5b+25=0\\end{aligned}\n$$" :question/worked-solution "We number the equations so that we can refer to them more easily:\n\n$$\n\\{\\begin{aligned}2b=6a+14 & \\,\\,(1) \\\\ 5b+25=0. & \\,\\,(2)\\end{aligned}\n$$\n\nWe will isolate a variable in one of the equations and then substitute it into the other equation. Using equation $(2),$ we can solve for $b$ as follows:\n\n$$\n\\begin{aligned}5b+25 & =0 \\\\ 5b & =-25 \\\\ b & =-5\\end{aligned}\n$$\n\nThen, we substitute $b=-5$ into equation $(1)$ and solve for $a:$\n\n$$\n\\begin{aligned}2(-5) & =6a+14 \\\\ -10 & =6a+14 \\\\ -10-14 & =6a \\\\ 6a & =-24 \\\\ a & =-4\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $a=-4,\\,b=-5.$ So,\n\n$$\na+b=-4+(-5)=-4-5=-9.\n$$"}] [{:db/id #edb/ref 17592186074185 :knowledge-point/_questions [{:db/id #edb/ref 17592186073752 :knowledge-point/id #uuid "5e79a91b-c479-53da-9f06-59c082fa4187" :knowledge-point/title "Solving a System of Linear Equations Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "831b8a12-3240-5543-8f0b-63a066174430" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186071349} {:answer/id #uuid "e71abec1-af90-564e-96cc-65f749dff99a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186071350} {:answer/id #uuid "f9bd14c8-f201-5c70-ba77-5489006197a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186071351} {:answer/id #uuid "30891c0a-e32e-5e99-9826-2629f5f5792b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186071352} {:answer/id #uuid "424e6c76-ef65-55f4-bb2c-05129500785f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186071353}] :answer-field/correct {:answer/id #uuid "831b8a12-3240-5543-8f0b-63a066174430" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186071349} :answer-field/id #uuid "4ff0f62d-b46f-5fed-abea-e9c339cbff76" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186071348}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5c71bd6b-b9a3-5587-89f4-a14a2c760bc2" :question/math-academy-id "q-5179" :question/problem "Given the system of equations below, what is the value of $p-q?$\n\n$$\n\\{\\begin{aligned}3p=15 \\\\ p+2q=9.\\end{aligned}\n$$" :question/worked-solution "We will isolate a variable in one of the equations and then substitute it into the other equation. It doesn't matter which equation we pick first, so we choose the easiest one. In this case, the first equation looks like the easiest.\n\nUsing the first equation, we can isolate $p$ by dividing both sides of the equation by $3:$\n\n$$\n\\begin{aligned}3p & =15 \\\\ p & =5\\end{aligned}\n$$\n\nIf we now substitute $p=5$ into $p+2q=9,$ then we can find the value of $q:$\n\n$$\n\\begin{aligned}p+2q & =9 \\\\ (5)+2q & =9 \\\\ 2q & =4 \\\\ q & =2\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $p=5,\\,q=2.$ So,\n\n$$\np-q=5-2=3.\n$$"}] [{:db/id #edb/ref 17592186546971 :knowledge-point/_questions [{:db/id #edb/ref 17592186073752 :knowledge-point/id #uuid "5e79a91b-c479-53da-9f06-59c082fa4187" :knowledge-point/title "Solving a System of Linear Equations Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25d7a53c-5916-5db7-992b-ff7a626a51c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186546336} {:answer/id #uuid "51399b6f-2763-5014-9b02-635633f0dada" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186546427} {:answer/id #uuid "9e23c320-e17b-534f-8a91-354568ebc163" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186546603} {:answer/id #uuid "a3f272eb-ffc1-5fb6-b622-055a0def12d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186546617} {:answer/id #uuid "d9f37f2b-79d8-5ebd-8615-8e1bcfb28380" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186546732}] :answer-field/correct {:answer/id #uuid "d9f37f2b-79d8-5ebd-8615-8e1bcfb28380" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186546732} :answer-field/id #uuid "78ca5c4c-b502-5598-a6f0-d81d606b319e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186546881}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1ad70587-af92-55e0-95cf-31aa82c10e13" :question/math-academy-id "q-52115" :question/problem "Given the system of equations below, what is the value of $a-b?$\n\n$$\n\\{\\begin{aligned}a=7 \\\\ 3a+6b=15\\end{aligned}\n$$" :question/worked-solution "We will isolate a variable in one of the equations and then substitute it into the other equation. It so happens that the first equation is already solved for $a:$\n\n$$\na=7\n$$\n\nIf we now substitute $a=7$ into $3a+6b=15,$ then we can find the value of $b:$\n\n$$\n\\begin{aligned}3a+6b & =15 \\\\ 3(7)+6b & =15 \\\\ 6b & =-6 \\\\ b & =-1\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $a=7,\\,b=-1.$ So,\n\n$$\na-b=7-(-1)=7+1=8.\n$$"}]}
