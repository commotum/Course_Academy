#{[{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186074657} :activity/id #uuid "7809af08-83ac-5450-986d-2614a3fd22d3" :activity/scope {:db/id #edb/ref 17592186048826 :topic/id #uuid "c375d3cc-e398-5a47-a69f-ddc853431752" :topic/math-academy-id 487} :activity/steps [{:db/id #edb/ref 17592186074657 :step/content {:db/id #edb/ref 17592186075033 :tutorial/content "Suppose that we want to solve, *without* using graphs, the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}x+y &=4 \\\\ x-2 &=y\\,\\end{aligned}\\right.\n$$\n\nIn order to solve the system without a graph, we will need to combine the equations into a single equation that can be solved using algebraic manipulation.\n\nOne way to combine the equations is called the **substitution method.** To use the substitution method, we substitute for one variable in terms of the other.\n\nFor instance, notice that we can make $y$ the subject of the second equation:\n\n$$\n\\color{red}y=x - 2\n$$\n\nSubstituting this expression for $y$ into the first equation, we get an equation that we can solve for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}x+y & =4 \\\\ x+(x-2) & =4 \\\\ 2x-2 & =4 \\\\ 2x & =6 \\\\ x & =3\\end{aligned}\n$$\n\nSo, the solution must have $x=3.$ But we also need to figure out what $y$ is. We can do this by substituting $x=3$ back into the second equation:\n\n$$\n\\begin{aligned}y & =x-2 \\\\ y & =3-2 \\\\ y & =1\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x = 3$ and $y = 1$, which can be written as $\\left(3, 1\\right).$\n\n**Note:** Whenever we isolate the variable in one equation, we have to substitute it into the *other* equation. We cannot substitute a variable into the same equation it came from, because this will not give us any more information about the variable." :tutorial/id #uuid "e1e8cb2d-3d4e-5cb9-8947-2bd9deb11b89" :tutorial/math-academy-id 8131 :tutorial/title "Introduction"} :step/id #uuid "413b9b90-7693-5568-a868-970271a5a258" :step/math-academy-id 197419 :step/next {:db/id #edb/ref 17592186074658}} {:db/id #edb/ref 17592186074658 :step/content {:db/id #edb/ref 17592186073752 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073445 :question/id #uuid "e9aae52c-65f3-5dff-bc6b-a530f8c7acc1" :question/math-academy-id "e-13009"} :knowledge-point/id #uuid "5e79a91b-c479-53da-9f06-59c082fa4187" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048678} {:db/id #edb/ref 17592186050622}] :knowledge-point/question-generator {:db/id #edb/ref 17592186508241} :knowledge-point/questions [{:db/id #edb/ref 17592186074030} {:db/id #edb/ref 17592186074172} {:db/id #edb/ref 17592186074185} {:db/id #edb/ref 17592186233560} {:db/id #edb/ref 17592186233567} {:db/id #edb/ref 17592186233574} {:db/id #edb/ref 17592186496226} {:db/id #edb/ref 17592186496255} {:db/id #edb/ref 17592186497411} {:db/id #edb/ref 17592186503753} {:db/id #edb/ref 17592186508171} {:db/id #edb/ref 17592186508174} {:db/id #edb/ref 17592186508179} {:db/id #edb/ref 17592186508187} {:db/id #edb/ref 17592186508204} {:db/id #edb/ref 17592186508205} {:db/id #edb/ref 17592186508207} {:db/id #edb/ref 17592186508210} {:db/id #edb/ref 17592186508214} {:db/id #edb/ref 17592186508215} {:db/id #edb/ref 17592186508227} {:db/id #edb/ref 17592186508233}] :knowledge-point/title "Solving a System of Linear Equations Using Substitution"} :step/id #uuid "99e9f36f-648c-5025-bfca-c63f6f77d9b1" :step/math-academy-id 197420 :step/next {:db/id #edb/ref 17592186074659}} {:db/id #edb/ref 17592186074659 :step/content {:db/id #edb/ref 17592186073753 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073446 :question/id #uuid "707504e8-a367-5dc2-a663-371a9dcf7224" :question/math-academy-id "e-13010"} :knowledge-point/id #uuid "b4352698-7af7-5d74-9c3a-0f951c3e6078" :knowledge-point/question-generator {:db/id #edb/ref 17592186505092} :knowledge-point/questions [{:db/id #edb/ref 17592186073997} {:db/id #edb/ref 17592186073998} 