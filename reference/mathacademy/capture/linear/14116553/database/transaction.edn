41613-58b3-5878-8f3f-4404da6faf4d"] :db/ensure [:question/validate]} {:db/id "answer-field-3eb41613-58b3-5878-8f3f-4404da6faf4d" :answer-field/id #uuid "3eb41613-58b3-5878-8f3f-4404da6faf4d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7dceedd7-4b1f-5a60-b090-4dc26f3702e7" :answer-field/choices ["answer-50d2e581-451b-5360-b4da-e26396ea468e" "answer-24985731-b6b9-5e8d-820b-1f13827d0949" "answer-7dceedd7-4b1f-5a60-b090-4dc26f3702e7" "answer-09435933-4c28-52dd-8678-41dcf0848333" "answer-91cae48a-5ff2-5a13-a3b1-20c945ab4731"] :db/ensure [:answer-field/validate]} {:db/id "answer-50d2e581-451b-5360-b4da-e26396ea468e" :answer/id #uuid "50d2e581-451b-5360-b4da-e26396ea468e" :answer/type :answer.type/math :answer/value "(R-I)" :db/ensure [:answer/validate]} {:db/id "answer-24985731-b6b9-5e8d-820b-1f13827d0949" :answer/id #uuid "24985731-b6b9-5e8d-820b-1f13827d0949" :answer/type :answer.type/math :answer/value "(R-m\\cdot I)" :db/ensure [:answer/validate]} {:db/id "answer-7dceedd7-4b1f-5a60-b090-4dc26f3702e7" :answer/id #uuid "7dceedd7-4b1f-5a60-b090-4dc26f3702e7" :answer/type :answer.type/math :answer/value "{R}^{-1}" :db/ensure [:answer/validate]} {:db/id "answer-09435933-4c28-52dd-8678-41dcf0848333" :answer/id #uuid "09435933-4c28-52dd-8678-41dcf0848333" :answer/type :answer.type/math :answer/value "{R}^{T}" :db/ensure [:answer/validate]} {:db/id "answer-91cae48a-5ff2-5a13-a3b1-20c945ab4731" :answer/id #uuid "91cae48a-5ff2-5a13-a3b1-20c945ab4731" :answer/type :answer.type/math :answer/value "{R}^{T}R" :db/ensure [:answer/validate]} {:db/id "activity-9b29a2c1-0e8f-51a5-8bb4-88c6d8d5a680" :activity/id #uuid "9b29a2c1-0e8f-51a5-8bb4-88c6d8d5a680" :activity/title "Finding a Least-Squares Solution Using QR Factorization" :activity/type :activity.type/review :activity/scope 17592186049845 :activity/course 17592186046673 :activity/steps ["step-70103913-067c-52aa-850c-673f2ce5ac0f" "step-de997394-83f9-5ca3-92c7-b205bedc19d