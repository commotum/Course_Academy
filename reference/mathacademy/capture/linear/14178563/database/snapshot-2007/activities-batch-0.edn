#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186065109} :activity/id #uuid "7e0946df-45c0-5786-9c65-795f6164a618" :activity/scope {:db/id #edb/ref 17592186050818 :topic/id #uuid "68e64e22-0e3c-5eac-8837-c36b21dd36c0" :topic/math-academy-id 371} :activity/steps [{:db/id #edb/ref 17592186065109 :step/content {:db/id #edb/ref 17592186065440 :tutorial/content "When we want to multiply two binomials, we take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\nFor example, to multiply $({\\color{blue}{x}} + {\\color{red}{3}})$ and $(x + 2),$ we multiply ${\\color{blue}{x}}$ and $(x + 2),$ and then we add this to the product of ${\\color{red}{3}}$ and $(x+2)$:\n\n$$\n\\eqalign{\n\t\t({\\color{blue}{x}} + {\\color{red}{3}})(x + 2) &= \\[5pt]\n\t\t{\\color{blue}{x}}(x + 2) + {\\color{red}{3}}(x + 2) &= \\[5pt]\n\t\tx^2 + 2x + 3x + 6 &= \\[5pt]\n\t\tx^2 + 5x + 6\n\t}\n$$" :tutorial/id #uuid "0cea50d1-e4ce-511f-821f-0e5e04b6eca1" :tutorial/math-academy-id 8877 :tutorial/title "Introduction"} :step/id #uuid "034d8161-5ef0-5329-ac71-ca2e17506a54" :step/math-academy-id 171384 :step/next {:db/id #edb/ref 17592186065110}} {:db/id #edb/ref 17592186065110 :step/content {:db/id #edb/ref 17592186064241 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063988 :question/id #uuid "ab6787e7-5b47-51a6-8967-4ede296cc44f" :question/math-academy-id "e-14313"} :knowledge-point/id #uuid "7ff8de23-e4f2-51e1-9390-78ff7edd2176" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048548} {:db/id #edb/ref 17592186049496} {:db/id #edb/ref 17592186049538}] :knowledge-point/questions [{:db/id #edb/ref 17592186064595} {:db/id #edb/ref 17592186064676} {:db/id #edb/ref 17592186481382}] :knowledge-point/title "Multiplying Binomials"} :step/id #uuid "befc51ec-1128-57f9-9017-8b1297e2a304" :step/math-academy-id 171385 :step/next {:db/id #edb/ref 17592186065111}} {:db/id #edb/ref 17592186065111 :step/content {:db/id #edb/ref 17592186064242 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063989 :question/id #uuid "818a9bf5-5ed5-5809-a295-3d332ce98b47" :question/math-academy-id "e-14316"} :knowledge-point/id #uuid "36d4e3a1-9f2e-5434-bfc9-10c29a426e07" :knowledge-point/questions [{:db/id #edb/ref 17592186064578} {:db/id #edb/ref 17592186064927} {:db/id #edb/ref 17592186481344} {:db/id #edb/ref 17592186481390} {:db/id #edb/ref 17592186495055} {:db/id #edb/ref 17592186495155}] :knowledge-point/title "Multiplying Binomials with Leading Coefficients"} :step/id #uuid "cd84d1a6-b898-5206-86c9-b0b4524beab8" :step/math-academy-id 171388 :step/next {:db/id #edb/ref 17592186065112}} {:db/id #edb/ref 17592186065112 :step/content {:db/id #edb/ref 17592186064243 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063990 :question/id #uuid "4e99bb73-42a1-5b11-8463-020f297c5afc" :question/math-academy-id "e-14317"} :knowledge-point/id #uuid "27aef839-e6a9-5c8e-bcd7-a2e9438968b0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048422}] :knowledge-point/questions [{:db/id #edb/ref 17592186064596} {:db/id #edb/ref 17592186064685} {:db/id #edb/ref 17592186481381} {:db/id #edb/ref 17592186495085}] :knowledge-point/title "Multiplying Binomials with Higher Powers and Multiple Variables"} :step/id #uuid "f2afcd5e-f99f-58d4-92e1-abd2be293082" :step/math-academy-id 171391}] :activity/title "Multiplying Binomials" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064457}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186495266} :activity/id #uuid "8721e25f-828d-529f-8d37-00132303e9c8" :activity/scope {:db/id #edb/ref 17592186050818 :topic/id #uuid "68e64e22-0e3c-5eac-8837-c36b21dd36c0" :topic/math-academy-id 371} :activity/steps [{:db/id #edb/ref 17592186495211 :step/content {:db/id #edb/ref 17592186495055 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25e004be-f08e-52db-afcf-7bfb57aca531" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15{w}^{2}+19w-7" :db/id #edb/ref 17592186494390} {:answer/id #uuid "33f29d9f-b7f9-538d-84ef-87f102db7a58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15{w}^{2}-19w-10" :db/id #edb/ref 17592186494421} {:answer/id #uuid "4a1a226c-3b58-5de1-bdd1-09862e44a749" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15{w}^{2}-31w-7" :db/id #edb/ref 17592186494467} {:answer/id #uuid "725a4025-c76c-5f78-bc98-4504976b2a0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15{w}^{2}+19w-10" :db/id #edb/ref 17592186494562} {:answer/id #uuid "c9194380-fd78-526b-86b8-a0353fc773b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15{w}^{2}-31w-10" :db/id #edb/ref 17592186494791}] :answer-field/correct {:db/id #edb/ref 17592186494421} :answer-field/id #uuid "cdeb2f7f-39f3-55df-bda0-3ce7a30bfa82" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186495015}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0944dac9-480d-52ed-acdf-aeb980d5e726" :question/math-academy-id "q-52152" :question/problem "$(5w+2)(3w-5)=$" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(5w+2)(3w-5) & = \\\\ 5w(3w-5)+2(3w-5) & = \\\\ 15{w}^{2}-25w+6w-10 & = \\\\ 15{w}^{2}-19w-10\\end{aligned}\n$$"} :step/id #uuid "6dab3f05-590c-5fd9-986b-e9d3f2e3114c" :step/next {:db/id #edb/ref 17592186495254}} {:db/id #edb/ref 17592186495254 :step/content {:db/id #edb/ref 17592186495155 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c2a21ab-44c4-5643-851b-b4a76932cc75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16y^{2}+42y+5" :db/id #edb/ref 17592186494344}] :answer-field/correct {:db/id #edb/ref 17592186494344} :answer-field/id #uuid "e00f9b37-087b-5f93-99a9-aa065185418d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186495027}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e2cad58f-c472-581c-a16b-711a6072cc50" :question/math-academy-id "q-216712" :question/problem "Expand the following product of binomials. Write your answer in **standard form.**\n\n$(8y+1)(2y+5)=$\n{{field-1}}" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(8y+1)(2y+5) & = \\\\ 8y(2y+5)+1(2y+5) & = \\\\ 16{y}^{2}+40y+2y+5 & = \\\\ 16{y}^{2}+42y+5\\end{aligned}\n$$"} :step/id #uuid "d0ea6c41-f392-560c-af01-cf23e5e44c12"} {:db/id #edb/ref 17592186495266 :step/content {:db/id #edb/ref 17592186495085 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b16ee72-72ca-517a-b1b1-2198b148afbc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{3}+rs-2s{r}^{2}-2{s}^{3}" :db/id #edb/ref 17592186494371} {:answer/id #uuid "6d7ad74c-af73-5446-9052-df37d91b1f6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{3}+r{s}^{2}-2s{r}^{2}-{s}^{3}" :db/id #edb/ref 17592186494544} {:answer/id #uuid "759904a1-8636-537e-9c40-516d7deaa4c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{3}+r{s}^{2}-2s{r}^{2}+2{s}^{3}" :db/id #edb/ref 17592186494568} {:answer/id #uuid "907ffe26-5485-53ae-a1fa-c8f1197ef46e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{3}+r{s}^{2}-2s{r}^{2}-2{s}^{3}" :db/id #edb/ref 17592186494646} {:answer/id #uuid "ad0f2020-3fca-5d25-b5e4-b0d419345bb8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{3}+rs-2s{r}^{2}+{s}^{3}" :db/id #edb/ref 17592186494717}] :answer-field/correct {:db/id #edb/ref 17592186494646} :answer-field/id #uuid "6164af12-a061-5247-be0b-02a0af340dc4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494960}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4f37487a-b4b8-5992-9edf-d3983de67b65" :question/math-academy-id "q-31319" :question/problem "$(r-2s)({r}^{2}+{s}^{2})=$" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(r-2s)({r}^{2}+{s}^{2}) & = \\\\ r({r}^{2}+{s}^{2})+(-2s)({r}^{2}+{s}^{2}) & = \\\\ {r}^{3}+r{s}^{2}-2s{r}^{2}-2{s}^{3}.\\end{aligned}\n$$\n\nWe cannot simplify the above expression any further because there are no like terms."} :step/id #uuid "eb20a321-9a03-525a-8fd7-cf559bae04c2" :step/next {:db/id #edb/ref 17592186495211}}] :activity/title "Multiplying Binomials" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186494307}]}
