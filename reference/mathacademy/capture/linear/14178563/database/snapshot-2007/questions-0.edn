#{[{:db/id #edb/ref 17592186495155 :knowledge-point/_questions [{:db/id #edb/ref 17592186064242 :knowledge-point/id #uuid "36d4e3a1-9f2e-5434-bfc9-10c29a426e07" :knowledge-point/title "Multiplying Binomials with Leading Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c2a21ab-44c4-5643-851b-b4a76932cc75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16y^{2}+42y+5" :db/id #edb/ref 17592186494344}] :answer-field/correct {:answer/id #uuid "0c2a21ab-44c4-5643-851b-b4a76932cc75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16y^{2}+42y+5" :db/id #edb/ref 17592186494344} :answer-field/id #uuid "e00f9b37-087b-5f93-99a9-aa065185418d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186495027}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e2cad58f-c472-581c-a16b-711a6072cc50" :question/math-academy-id "q-216712" :question/problem "Expand the following product of binomials. Write your answer in **standard form.**\n\n$(8y+1)(2y+5)=$\n{{field-1}}" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(8y+1)(2y+5) & = \\\\ 8y(2y+5)+1(2y+5) & = \\\\ 16{y}^{2}+40y+2y+5 & = \\\\ 16{y}^{2}+42y+5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186495085 :knowledge-point/_questions [{:db/id #edb/ref 17592186064243 :knowledge-point/id #uuid "27aef839-e6a9-5c8e-bcd7-a2e9438968b0" :knowledge-point/title "Multiplying Binomials with Higher Powers and Multiple Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b16ee72-72ca-517a-b1b1-2198b148afbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{3}+rs-2s{r}^{2}-2{s}^{3}" :db/id #edb/ref 17592186494371} {:answer/id #uuid "6d7ad74c-af73-5446-9052-df37d91b1f6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{3}+r{s}^{2}-2s{r}^{2}-{s}^{3}" :db/id #edb/ref 17592186494544} {:answer/id #uuid "759904a1-8636-537e-9c40-516d7deaa4c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{3}+r{s}^{2}-2s{r}^{2}+2{s}^{3}" :db/id #edb/ref 17592186494568} {:answer/id #uuid "907ffe26-5485-53ae-a1fa-c8f1197ef46e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{3}+r{s}^{2}-2s{r}^{2}-2{s}^{3}" :db/id #edb/ref 17592186494646} {:answer/id #uuid "ad0f2020-3fca-5d25-b5e4-b0d419345bb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{3}+rs-2s{r}^{2}+{s}^{3}" :db/id #edb/ref 17592186494717}] :answer-field/correct {:answer/id #uuid "907ffe26-5485-53ae-a1fa-c8f1197ef46e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{3}+r{s}^{2}-2s{r}^{2}-2{s}^{3}" :db/id #edb/ref 17592186494646} :answer-field/id #uuid "6164af12-a061-5247-be0b-02a0af340dc4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186494960}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4f37487a-b4b8-5992-9edf-d3983de67b65" :question/math-academy-id "q-31319" :question/problem "$(r-2s)({r}^{2}+{s}^{2})=$" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(r-2s)({r}^{2}+{s}^{2}) & = \\\\ r({r}^{2}+{s}^{2})+(-2s)({r}^{2}+{s}^{2}) & = \\\\ {r}^{3}+r{s}^{2}-2s{r}^{2}-2{s}^{3}.\\end{aligned}\n$$\n\nWe cannot simplify the above expression any further because there are no like terms."}] [{:db/id #edb/ref 17592186495055 :knowledge-point/_questions [{:db/id #edb/ref 17592186064242 :knowledge-point/id #uuid "36d4e3a1-9f2e-5434-bfc9-10c29a426e07" :knowledge-point/title "Multiplying Binomials with Leading Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25e004be-f08e-52db-afcf-7bfb57aca531" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15{w}^{2}+19w-7" :db/id #edb/ref 17592186494390} {:answer/id #uuid "33f29d9f-b7f9-538d-84ef-87f102db7a58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15{w}^{2}-19w-10" :db/id #edb/ref 17592186494421} {:answer/id #uuid "4a1a226c-3b58-5de1-bdd1-09862e44a749" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15{w}^{2}-31w-7" :db/id #edb/ref 17592186494467} {:answer/id #uuid "725a4025-c76c-5f78-bc98-4504976b2a0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15{w}^{2}+19w-10" :db/id #edb/ref 17592186494562} {:answer/id #uuid "c9194380-fd78-526b-86b8-a0353fc773b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15{w}^{2}-31w-10" :db/id #edb/ref 17592186494791}] :answer-field/correct {:answer/id #uuid "33f29d9f-b7f9-538d-84ef-87f102db7a58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15{w}^{2}-19w-10" :db/id #edb/ref 17592186494421} :answer-field/id #uuid "cdeb2f7f-39f3-55df-bda0-3ce7a30bfa82" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186495015}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0944dac9-480d-52ed-acdf-aeb980d5e726" :question/math-academy-id "q-52152" :question/problem "$(5w+2)(3w-5)=$" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(5w+2)(3w-5) & = \\\\ 5w(3w-5)+2(3w-5) & = \\\\ 15{w}^{2}-25w+6w-10 & = \\\\ 15{w}^{2}-19w-10\\end{aligned}\n$$"}]}
