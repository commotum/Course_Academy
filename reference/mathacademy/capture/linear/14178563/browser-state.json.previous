\" space=\"3\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D460 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.413em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn></mjx-texatom></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd extra=\"true\"></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable rowspacing=\"0.8em 0.8em 0.5em\" columnspacing=\"0.278em\" displaystyle=\"true\" columnalign=\"right left\"><mtr><mtd><mo stretchy=\"false\">(</mo><mi>r</mi><mo>−</mo><mn>2</mn><mi>s</mi><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><msup><mi>r</mi><mn>2</mn></msup><mo>+</mo><msup><mi>s</mi><mn>2</mn></msup><mo stretchy=\"false\">)</mo></mtd><mtd><mo>=</mo></mtd></mtr><mtr><mtd><mi>r</mi><mo stretchy=\"false\">(</mo><msup><mi>r</mi><mn>2</mn></msup><mo>+</mo><msup><mi>s</mi><mn>2</mn></msup><mo stretchy=\"false\">)</mo><mo>+</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><mi>s</mi><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><msup><mi>r</mi><mn>2</mn></msup><mo>+</mo><msup><mi>s</mi><mn>2</mn></msup><mo stretchy=\"false\">)</mo></mtd><mtd><mo>=</mo></mtd></mtr><mtr><mtd><msup><mi>r</mi><mrow data-mjx-texclass=\"ORD\"><mn>3</mn></mrow></msup><mo>+</mo><mi>r</mi><msup><mi>s</mi><mn>2</mn></msup><mo>−</mo><mn>2</mn><mi>s</mi><msup><mi>r</mi><mn>2</mn></msup><mo>−</mo><mn>2</mn><msup><mi>s</mi><mrow data-mjx-texclass=\"ORD\"><mn>3</mn></mrow></msup><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>We cannot simplify the above expression any further because there are no like terms.</p>\n</div></div>",
