/ref 1075 #edb/ref 17592186537678 #edb/ref 17592186045417] [17592186537791 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186537791 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186537791 #edb/ref 1078 #edb/ref 17592186537678 #edb/ref 17592186045417] [17592186537791 #edb/ref 1079 #uuid "5cbb9a83-83f5-559b-aa22-cc741328c862" #edb/ref 17592186045417] [17592186537795 #edb/ref 1075 #edb/ref 17592186537325 #edb/ref 17592186045417] [17592186537795 #edb/ref 1075 #edb/ref 17592186537363 #edb/ref 17592186045417] [17592186537795 #edb/ref 1075 #edb/ref 17592186537550 #edb/ref 17592186045417] [17592186537795 #edb/ref 1075 #edb/ref 17592186537689 #edb/ref 17592186045417] [17592186537795 #edb/ref 1075 #edb/ref 17592186537694 #edb/ref 17592186045417] [17592186537795 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186537795 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186537795 #edb/ref 1078 #edb/ref 17592186537550 #edb/ref 17592186045417] [17592186537795 #edb/ref 1079 #uuid "63c756b9-1e9d-5271-bbd7-583507116b40" #edb/ref 17592186045417] [17592186537897 #edb/ref 1068 #edb/ref 17592186537795 #edb/ref 17592186045417] [17592186537897 #edb/ref 1069 "q-66777" #edb/ref 17592186045417] [17592186537897 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186537897 #edb/ref 1071 "What are the solutions of the equation $(x-3)^{2}=-9?$" #edb/ref 17592186045417] [17592186537897 #edb/ref 1072 #uuid "239de5f3-ea6f-59ef-b333-b7c1243259a4" #edb/ref 17592186045417] [17592186537897 #edb/ref 1074 "The left-hand side is a perfect square. Therefore, we can solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-3)^{2} & =-9 \\\\ x-3 & =\\pm \\sqrt{-9} \\\\ x-3 & =\\pm 3\\,\\text{i} \\\\ x & =3\\pm 3\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=3+3\\,\\text{i}$ and $x=3-3\\,\\text{i}.$" #edb/ref 17592186045417] [17592186537959 #edb/ref 1068 #edb/ref 17592186537791 #edb/ref 17592186045417] [17592186537959 #edb/ref 1069 "q-66431" #edb/ref 17592186045417] [17592186537959 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186537959 #edb/ref 1071 "The equation ${x}^{2}-10x+50=0$ can be written in the form $(x+p)^{2}=q.$ Find $p+q,$ and solve the equation." #edb/ref 17592186045417] [17592186537959 #edb/ref 1072 #uuid "b2554883-e4a0-51fb-ab55-70bbe918132c" #edb/ref 17592186045417] [17592186537959 #edb/ref 1074 "We first move the constant to the right-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-10x+50 & =0 \\\\ {x}^{2}-10x & =-50\\end{aligned}\n$$\n\nNext, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-10x & =-50 \\\\ {x}^{2}-2\\cdot 5x+{5}^{2}-{5}^{2} & =-50 \\\\ (x-5)^{2}-25 & =-50 \\\\ (x-5)^{2} & =-25\\end{aligned}\n$$\n\nTherefore, $p=-5,\\,q=-25,$ and $p+q=-30.$\n\nWe now solve the equation using the square root method.\n\n$$\n\\begin{aligned}(x-5)^{2} & =-25 \\\\ x-5 & =\\pm \\sqrt{-25} \\\\ x-5 & =\\pm 5\\,\\text{i} \\\\ x & =5\\pm 5\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=5+5\\,\\text{i}$ and $x=5-5\\,\\text{i}.$" #edb/ref 17592186045417] [17592186538037 #edb/ref 1058 #edb/ref 17592186538048 #edb/ref 17592186045417] [17592186538037 #edb/ref 1062 #uuid "98a1bdb7-2495-5817-9fd6-2f09ad4a6055" #edb/ref 17592186045417] [17592186538037 #edb/ref 1063 #edb/ref 17592186088250 #edb/ref 17592186045417] [17592186538038 #edb/ref 1058 #edb/ref 17592186538037 #edb/ref 17592186045417] [17592186538038 #edb/ref 1062 #uuid "9d18d958-1ee9-5247-8bd4-5393f772d4ed" #edb/ref 17592186045417] [17592186538038 #edb/ref 1063 #edb/ref 17592186537959 #edb/ref 17592186045417] [17592186538048 #edb/ref 1062 #uuid "b62aaa32-0ff5-5a3f-84ad-80c8603564e8" #edb/ref 17592186045417] [17592186538048 #edb/ref 1063 #edb/ref 17592186537897 #edb/ref 17592186045417]}
