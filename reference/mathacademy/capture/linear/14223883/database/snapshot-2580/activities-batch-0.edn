#{[{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186088740} :activity/id #uuid "4ee3f6cf-7f54-503a-9d82-660a1ecf09f8" :activity/scope {:db/id #edb/ref 17592186049695 :topic/id #uuid "0bd4af20-8e63-5977-8ad8-a3833c62469f" :topic/math-academy-id 895} :activity/steps [{:db/id #edb/ref 17592186088740 :step/content {:db/id #edb/ref 17592186088886 :tutorial/content "Suppose that we want to solve the quadratic equation\n\n$$\nx^2 -2x +2=0.\n$$\n\nThis quadratic is written in standard form with $a=1,$ $b=-2,$ and $c=2.$ However, its discriminant is negative:\n\n$$\n\\begin{aligned}{b}^{2}-4ac & =(-2)^{2}-4(1)(2) \\\\  & =4-8 \\\\  & =-4 \\\\  & <0\\end{aligned}\n$$\n\nThis means that the quadratic equation has no real solutions. However, if we allow complex solutions, we may solve the equation as follows:\n\n$$\n\\begin{aligned}x & =\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a} \\\\  & =\\frac{-(-2)\\pm \\sqrt{(-2)^{2}-4(1)(2)}}{2\\cdot 1} \\\\  & =\\frac{2\\pm \\sqrt{-4}}{2} \\\\  & =\\frac{2\\pm 2\\text{i}}{2} \\\\  & =1\\pm \\text{i}\\end{aligned}\n$$\n\nTherefore, the equation $x^2 -2x +2=0$ has two solutions, $x=1+\\textrm{i}$ and $x=1-\\textrm{i}.$" :tutorial/id #uuid "275a04ea-da37-527f-9ade-d57aa888110b" :tutorial/math-academy-id 2827 :tutorial/title "Introduction"} :step/id #uuid "625577f3-63da-5990-aa37-6436fc70cf20" :step/math-academy-id 455706 :step/next {:db/id #edb/ref 17592186088741}} {:db/id #edb/ref 17592186088741 :step/content {:db/id #edb/ref 17592186087828 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087498 :question/id #uuid "2e80a8b3-de45-51f0-9241-a699222da37b" :question/math-academy-id "e-4157"} :knowledge-point/id #uuid "bbe35c7b-8068-5b28-a820-d25e6b62565a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048428} {:db/id #edb/ref 17592186050465}] :knowledge-point/questions [{:db/id #edb/ref 17592186088048} {:db/id #edb/ref 17592186088076} {:db/id #edb/ref 17592186088077} {:db/id #edb/ref 17592186335884} {:db/id #edb/ref 17592186390448} {:db/id #edb/ref 17592186522730} {:db/id #edb/ref 17592186522805} {:db/id #edb/ref 17592186522811}] :knowledge-point/title "Solving a Quadratic Equation With Complex Roots Using the Quadratic Formula"} :step/id #uuid "7641a04f-8f2b-513e-af55-334dff7e186c" :step/math-academy-id 455707 :step/next {:db/id #edb/ref 17592186088742}} {:db/id #edb/ref 17592186088742 :step/content {:db/id #edb/ref 17592186087829 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087632 :question/id #uuid "7f7e9924-1c7b-516c-928c-962a4cd5cbcc" :question/math-academy-id "e-7517"} :knowledge-point/id #uuid "ef8dec7d-5154-59ee-aee8-9f068eb6b8f4" :knowledge-point/questions [{:db/id #edb/ref 17592186088078} {:db/id #edb/ref 17592186088251} {:db/id #edb/ref 17592186233675} {:db/id #edb/ref 17592186233676} {:db/id #edb/ref 17592186233738} {:db/id #edb/ref 17592186233739} {:db/id #edb/ref 17592186234208} {:db/id #edb/ref 17592186335883} {:db/id #edb/ref 17592186390453}] :knowledge-point/title "Rearranging and Solving a Quadratic Equation With Complex Roots"} :step/id #uuid "04a3ac7e-6653-5ae7-bf85-4e6eb8db0752" :step/math-academy-id 455711 :step/next {:db/id #edb/ref 17592186088743}} {:db/id #edb/ref 17592186088743 :step/content {:db/id #edb/ref 17592186088887 :tutorial/content "We can also solve a quadratic equation with complex solutions using the square root method.\n\nTo demonstrate, let's find the solutions of the equation $(x-2)^2=-16.$\n\nThe left-hand side is a perfect square. Therefore, we can solve the equation as follows:\n\n$$\n\\begin{aligned}(x-2)^{2} & =-16 \\\\ x-2 & =\\pm \\sqrt{-16} \\\\ x-2 & =\\pm 4\\text{i} \\\\ x & =2\\pm 4\\text{i}\\end{aligned}\n$$\n\nSometimes, we need to complete the square first before applying the square root method. Let's see how." :tutorial/id #uuid "145efd5f-c374-5133-89cb-39314be19dcd" :tutorial/math-academy-id 2829 :tutorial/title "Solving a Quadratic Equation With Complex Roots by Completing the Square"} :step/id #uuid "8514fb33-b596-528a-a07d-1f67ad500b05" :step/math-academy-id 455714 :step/next {:db/id #edb/ref 17592186088744}} {:db/id #edb/ref 17592186088744 :step/content {:db/id #edb/ref 17592186087830 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087499 :question/id #uuid "af6ecee9-30de-5913-be21-f184d6f9cacd" :question/math-academy-id "e-4160"} :knowledge-point/id #uuid "a9c8c1d8-2662-5c15-b084-084f9e930141" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049250}] :knowledge-point/questions [{:db/id #edb/ref 17592186088079} {:db/id #edb/ref 17592186088250} {:db/id #edb/ref 17592186088258} {:db/id #edb/ref 17592186233677} {:db/id #edb/ref 17592186233678} {:db/id #edb/ref 17592186234210} {:db/id #edb/ref 17592186247337} {:db/id #edb/ref 17592186290598} {:db/id #edb/ref 17592186335907} {:db/id #edb/ref 17592186399788} {:db/id #edb/ref 17592186403230} {:db/id #edb/ref 17592186522714} {:db/id #edb/ref 17592186522814} {:db/id #edb/ref 17592186537897} {:db/id #edb/ref 17592186537959}] :knowledge-point/title "Solving a Quadratic Equation With Complex Roots by Completing the Square"} :step/id #uuid "402941da-4dd4-589e-92f9-62b01650ad6b" :step/math-academy-id 455715}] :activity/title "Solving Quadratic Equations With Complex Roots" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186087957}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186538038} :activity/id #uuid "d8473e55-ba03-5c28-a07f-8b33a1ce3d26" :activity/scope {:db/id #edb/ref 17592186049695 :topic/id #uuid "0bd4af20-8e63-5977-8ad8-a3833c62469f" :topic/math-academy-id 895} :activity/steps [{:db/id #edb/ref 17592186538037 :step/content {:db/id #edb/ref 17592186088250 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c5a9dee-19f1-525b-8742-ffc708372643" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p+q=-40,\\,x=-4\\pm 4\\,\\text{i}" :db/id #edb/ref 17592186537286} {:answer/id #uuid "2bd7ae77-8250-5020-80a4-12b94cebd915" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p+q=-10,\\,x=-4\\pm 4\\,\\text{i}" :db/id #edb/ref 17592186537320} {:answer/id #uuid "b040fcf5-22f0-58e5-aba7-527d9e48d77e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p+q=-40,\\,x=4\\pm 3\\,\\text{i}" :db/id #edb/ref 17592186537563} {:answer/id #uuid "b1727935-a31f-5667-8134-811f238cf74d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p+q=-10,\\,x=4\\pm 6\\,\\text{i}" :db/id #edb/ref 17592186537571} {:answer/id #uuid "e295243b-2633-5336-988f-8567cf89ac74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p+q=-40,\\,x=4\\pm 6\\,\\text{i}" :db/id #edb/ref 17592186537686}] :answer-field/correct {:db/id #edb/ref 17592186537686} :answer-field/id #uuid "751718f7-92f5-50ac-87c6-386399d5f32c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186086154}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "383c50ad-8f55-5e66-be3c-643b265bd68f" :question/math-academy-id "q-66436" :question/problem "The equation ${x}^{2}-8x+52=0$ can be written in the form $(x+p)^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "We first move the constant to the right-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-8x+52 & =0 \\\\ {x}^{2}-8x & =-52\\end{aligned}\n$$\n\nNext, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-8x & =-52 \\\\ {x}^{2}-2\\cdot 4x+{4}^{2}-{4}^{2} & =-52 \\\\ (x-4)^{2}-16 & =-52 \\\\ (x-4)^{2} & =-36\\end{aligned}\n$$\n\nTherefore, $p=-4,\\,q=-36,$ and $p+q=-40.$\n\nFinally, we solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-4)^{2} & =-36 \\\\ x-4 & =\\pm \\sqrt{-36} \\\\ x-4 & =\\pm 6\\,\\text{i} \\\\ x & =4\\pm 6\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=4+6\\,\\text{i}$ and $x=4-6\\,\\text{i}.$"} :step/id #uuid "98a1bdb7-2495-5817-9fd6-2f09ad4a6055" :step/next {:db/id #edb/ref 17592186538048}} {:db/id #edb/ref 17592186538038 :step/content {:db/id #edb/ref 17592186537959 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22b3528e-bd13-54b8-90c1-09193176faa0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p+q=-30,\\,x=5\\pm 2\\,\\text{i}" :db/id #edb/ref 17592186537303} {:answer/id #uuid "3d076420-a779-5e3e-a34a-583c1f93d33d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p+q=-30,\\,x=-3\\pm 2\\,\\text{i}" :db/id #edb/ref 17592186537355} {:answer/id #uuid "96c84526-c5b4-5255-bf98-af414fdb1fb0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p+q=-20,\\,x=-3\\pm 2\\,\\text{i}" :db/id #edb/ref 17592186537514} {:answer/id #uuid "d5d0d590-2ae3-51d3-8da2-43b173b5a68b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p+q=-20,\\,x=5\\pm 5\\,\\text{i}" :db/id #edb/ref 17592186537652} {:answer/id #uuid "df58f72d-ec96-5b04-8b62-aec6bafc8591" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p+q=-30,\\,x=5\\pm 5\\,\\text{i}" :db/id #edb/ref 17592186537678}] :answer-field/correct {:db/id #edb/ref 17592186537678} :answer-field/id #uuid "5cbb9a83-83f5-559b-aa22-cc741328c862" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537791}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b2554883-e4a0-51fb-ab55-70bbe918132c" :question/math-academy-id "q-66431" :question/problem "The equation ${x}^{2}-10x+50=0$ can be written in the form $(x+p)^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "We first move the constant to the right-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-10x+50 & =0 \\\\ {x}^{2}-10x & =-50\\end{aligned}\n$$\n\nNext, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-10x & =-50 \\\\ {x}^{2}-2\\cdot 5x+{5}^{2}-{5}^{2} & =-50 \\\\ (x-5)^{2}-25 & =-50 \\\\ (x-5)^{2} & =-25\\end{aligned}\n$$\n\nTherefore, $p=-5,\\,q=-25,$ and $p+q=-30.$\n\nWe now solve the equation using the square root method.\n\n$$\n\\begin{aligned}(x-5)^{2} & =-25 \\\\ x-5 & =\\pm \\sqrt{-25} \\\\ x-5 & =\\pm 5\\,\\text{i} \\\\ x & =5\\pm 5\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=5+5\\,\\text{i}$ and $x=5-5\\,\\text{i}.$"} :step/id #uuid "9d18d958-1ee9-5247-8bd4-5393f772d4ed" :step/next {:db/id #edb/ref 17592186538037}} {:db/id #edb/ref 17592186538048 :step/content {:db/id #edb/ref 17592186537897 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d5d2c87-1a8f-5972-81f5-e437b77531ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=9\\pm 3\\,\\text{i}" :db/id #edb/ref 17592186537325} {:answer/id #uuid "40c2a656-f6ad-5bfb-96eb-0caf8028ad4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=3\\pm 9\\,\\text{i}" :db/id #edb/ref 17592186537363} {:answer/id #uuid "aaa26d8b-77e9-5401-b941-393cc5d1b997" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=3\\pm 3\\,\\text{i}" :db/id #edb/ref 17592186537550} {:answer/id #uuid "e380e9d9-befb-5010-b366-7137019f90be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=2\\pm 4\\,\\text{i}" :db/id #edb/ref 17592186537689} {:answer/id #uuid "e4eb8c58-f6fc-5d10-80b0-051c38578765" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-3\\pm 3\\,\\text{i}" :db/id #edb/ref 17592186537694}] :answer-field/correct {:db/id #edb/ref 17592186537550} :answer-field/id #uuid "63c756b9-1e9d-5271-bbd7-583507116b40" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537795}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "239de5f3-ea6f-59ef-b333-b7c1243259a4" :question/math-academy-id "q-66777" :question/problem "What are the solutions of the equation $(x-3)^{2}=-9?$" :question/worked-solution "The left-hand side is a perfect square. Therefore, we can solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-3)^{2} & =-9 \\\\ x-3 & =\\pm \\sqrt{-9} \\\\ x-3 & =\\pm 3\\,\\text{i} \\\\ x & =3\\pm 3\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=3+3\\,\\text{i}$ and $x=3-3\\,\\text{i}.$"} :step/id #uuid "b62aaa32-0ff5-5a3f-84ad-80c8603564e8"}] :activity/title "Solving Quadratic Equations With Complex Roots" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186537219}]}
