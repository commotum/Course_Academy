ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186369137} {:answer/id #uuid "ae11a534-9071-51c5-9c62-96edf873879c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186369138} {:answer/id #uuid "cc2753ab-b03e-57dd-aed5-1141d4ab60d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186369139}] :answer-field/correct {:answer/id #uuid "ae11a534-9071-51c5-9c62-96edf873879c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186369138} :answer-field/id #uuid "3df95490-7dfb-5aeb-bc5c-bf3022d491c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369134}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f6ec68df-0117-55d8-9ffd-b15f593e769d" :question/math-academy-id "q-112868" :question/problem "According to the rational roots theorem, which of the following could be a root of the polynomial $f(x)=-5{x}^{5}+3{x}^{4}-8{x}^{3}+{x}^{2}-7x+15?$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $15,$ and the leading coefficient is $-5.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }15}{\\text{factor of }-5}.\n$$\n\nOf the given answer choices, only $\\frac{3}{5}$ takes the above form since the numerator $(3)$ is a factor of $15$ and the denominator $(5)$ is a factor of $-5.$"}] [{:db/id #edb/ref 17592186369147 :knowledge-point/_questions [{:db/id #edb/ref 17592186083306 :knowledge-point/id #uuid "a75b47ec-8d5a-545e-b915-daca92320322" :knowledge-point/title "Identifying Non-Roots of a Polynomial Using the Rational Roots Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a0522a7-0507-5731-a4b7-8bba18622019" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186369149} {:answer/id #uuid "8fde88cc-1dfe-551e-b505-43ea2c33d068" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186369150} {:answer/id #uuid "83ab7bbf-94b2-5cb5-9325-46ad92883dbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186369151} {:answer/id #uuid "a6bc4bf1-1c7f-5632-a344-3a92a856f8ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186369152} {:answer/id #uuid "ba1d826c-ea85-5f67-b6de-9779918444e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186369153}] :answer-field/correct {:answer/id #uuid "a6bc4bf1-1c7f-5632-a344-3a92a856f8ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186369152} :answer-field/id #uuid "70b789b7-b641-5d56-91db-ef1575144f19" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369148}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ff153540-97c0-598a-84af-1ded375d76ae" :question/math-academy-id "q-112872" :question/problem "According to the rational roots theorem, which of the following **cannot** be a root of the polynomial $f(x)=2{x}^{4}-3{x}^{2}+x+6?$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $6$ and the leading coefficient is $2.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }6}{\\text{factor of }2}.\n$$\n\nOf the given answer choices, only $\\frac{3}{4}$ does not take the above form. The denominator $(4)$ is not a factor of $2.$"}] [{:db/id #edb/ref 17592186272278 :knowledge-point/_questions [{:db/id #edb/ref 17592186083232 :knowledge-point/id #uuid "1b5f9ee9-a489-5048-8346-0116a19e9b4a" :knowledge-point/title "Counting the Number of Possible Rational Roots of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6405d500-a31a-5609-aba5-ac3249a09dfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186270155} {:answer/id #uuid "84078102-7b7b-545e-a782-92516a6671d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186270410} {:answer/id #uuid "96c63d03-1535-5cd8-8181-f92fd1c97211" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186270595} {:answer/id #uuid "a05af57a-c82b-5d27-85c6-99d5f8210667" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186270692} {:answer/id #uuid "c2dab93d-0f89-5715-9780-3efeba02867c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186270991}] :answer-field/correct {:answer/id #uuid "6405d500-a31a-5609-aba5-ac3249a09dfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186270155} :answer-field/id #uuid "0dd51303-5171-520b-af95-af33d1662222" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271529}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "52c32cb4-13fd-5370-99b6-582dfa832135" :question/math-academy-id "q-14141" :question/problem "For the polynomial $f(x)=4{x}^{5}-4{x}^{2}+16x-16,$ how many *potential* roots are given by the rational roots theorem?" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial:\n\n- The constant term is $-16,$ and its factors are $\\pm 1,\\,\\pm 2,\\,\\pm 4,\\,\\pm 8$ and $\\pm 16.$\n\n- The leading coefficient is $4,$ and its factors are $\\pm 1,\\,\\pm 2$ and $\\pm 4.$\n\nFirst, we list out all the possibilities for the numerator and denominator:\n\n$$\n\\begin{aligned}\\pm \\frac{1}{1}, & \\pm \\frac{1}{2}, & \\pm \\frac{1}{4}, \\\\ \\pm \\frac{2}{1}, & \\pm \\frac{2}{2}, & \\pm \\frac{2}{4}, \\\\ \\pm \\frac{4}{1}, & \\pm \\frac{4}{2}, & \\pm \\frac{4}{4}, \\\\ \\pm \\frac{8}{1}, & \\pm \\frac{8}{2}, & \\pm \\frac{8}{4}, \\\\ \\pm \\frac{16}{1}, & \\pm \\frac{16}{2}, & \\pm \\frac{16}{4}.\\end{aligned}\n$$\n\nNext, we reduce the fractions to lowest terms:\n\n$$\n\\begin{aligned}\\pm 1, & \\pm \\frac{1}{2}, & \\pm \\frac{1}{4}, \\\\ \\pm 2, & \\pm 1, & \\pm \\frac{1}{2}, \\\\ \\pm 4, & \\pm 2, & \\pm 1, \\\\ \\pm 8, & \\pm 4, & \\pm 2, \\\\ \\pm 16, & \\pm 8, & \\pm 4.\\end{aligned}\n$$\n\nNotice that some potential roots are duplicates (shown above in red). Removing these duplicates, and listing those remaining in order from least to greatest in absolute value, we have\n\n$$\n\\pm \\frac{1}{4},\\,\\pm \\frac{1}{2}\\,\\pm 1,\\,\\pm 2,\\,\\pm 4,\\,\\pm 8,\\,\\pm 16.\n$$\n\nThis makes a total of $14$ potential roots. (Remember that each $\\pm $ sign accounts for $2$ roots, and $2\\cdot 7=14.$)"}] [{:db/id #edb/ref 17592186433672 :knowledge-point/_questions [{:db/id #edb/ref 17592186083232 :knowledge-point/id #uuid "1b5f9ee9-a489-5048-8346-0116a19e9b4a" :knowledge-point/title "Counting the Number of Possible Rational Roots of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "087ad481-79d2-5803-a05b-415265f74035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186433634} {:answer/id #uuid "68ce9788-0470-5c3e-a1b2-2e1c81f8f0d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186433645} {:answer/id #uuid "cd3b1417-956a-5906-8f67-b13dacbb7ab9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186433655} {:answer/id #uuid "cd8039a9-93f2-5720-ab0a-1873075b3cd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186433656} {:answer/id #uuid "d1b2ae26-7ce6-5b5d-8c0d-644be4a27793" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186433658}] :answer-field/correct {:answer/id #uuid "087ad481-79d2-5803-a05b-415265f74035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186433634} :answer-field/id #uuid "60877b9d-92c5-51c5-86d7-d416451d8505" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186433667}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2e2ad5ba-576c-5412-b8cf-f6ef173b3a57" :question/math-academy-id "q-14143" :question/problem "For the polynomial $f(x)=4{x}^{7}-18{x}^{2}+26x-12,$ how many *potential* roots are given by the rational roots theorem?" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial:\n\n- The constant term is $-12,$ and its factors are $\\pm 1,\\,\\pm 2,\\,\\pm 3,\\,\\pm 4,\\,\\pm 6$ and $\\pm 12.$\n\n- The leading coefficient is $4,$ and its factors are $\\pm 1,\\,\\pm 2$ and $\\pm 4.$\n\nFirst, we list out all the possibilities for the numerator and denominator:\n\n$$\n\\begin{aligned}\\pm \\frac{1}{1}, & \\pm \\frac{1}{2}, & \\pm \\frac{1}{4}, \\\\ \\pm \\frac{2}{1}, & \\pm \\frac{2}{2}, & \\pm \\frac{2}{4}, \\\\ \\pm \\frac{3}{1}, & \\pm \\frac{3}{2}, & \\pm \\frac{3}{4}, \\\\ \\pm \\frac{4}{1}, & \\pm \\frac{4}{2}, & \\pm \\frac{4}{4}, \\\\ \\pm \\frac{6}{1}, & \\pm \\frac{6}{2}, & \\pm \\frac{6}{4}, \\\\ \\pm \\frac{12}{1}, & \\pm \\frac{12}{2}, & \\pm \\frac{12}{4}.\\end{aligned}\n$$\n\nNext, we reduce the fractions to lowest terms:\n\n$$\n\\begin{aligned}\\pm 1, & \\pm \\frac{1}{2}, & \\pm \\frac{1}{4}, \\\\ \\pm 2, & \\pm 1, & \\pm \\frac{1}{2}, \\\\ \\pm 3, & \\pm \\frac{3}{2}, & \\pm \\frac{3}{4}, \\\\ \\pm 4, & \\pm 2, & \\pm 1, \\\\ \\pm 6, & \\pm 3, & \\pm \\frac{3}{2}, \\\\ \\pm 12, & \\pm 6, & \\pm 3.\\end{aligned}\n$$\n\nNotice that some potential roots are duplicates (shown above in red). Removing these duplicates, and listing those remaining in order from least to greatest in absolute value, we have\n\n$$\n\\pm \\frac{1}{4},\\,\\pm \\frac{1}{2},\\,\\pm \\frac{3}{4},\\,\\pm 1,\\,\\pm \\frac{3}{2},\\,\\pm 2,\\,\\pm 3,\\,\\pm 4,\\,\\pm 6,\\,\\pm 12.\n$$\n\nThis makes a total of $20$ potential roots. (Remember that each $\\pm $ sign accounts for $2$ roots, and $2\\cdot 10=20.$)"}] [{:db/id #edb/ref 17592186370866 :knowledge-point/_questions [{:db/id #edb/ref 17592186083310 :knowledge-point/id #uuid "001262b8-82b7-5421-80ac-8608b20d4be1" :knowledge-point/title "Factoring a Cubic Polynomial Using the Rational Roots Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb03aa8e-5be4-5437-9054-75e6dbfbb9a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186370868} {:answer/id #uuid "525502ba-0880-5578-acff-65e20803b028" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{2}" :db/id #edb/ref 17592186370869} {:answer/id #uuid "c151b231-6c09-5fd5-8da3-0a602ae8796e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186370870} {:answer/id #uuid "081f69f0-7245-5874-828b-11600bf35ba3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186370871} {:answer/id #uuid "2913592d-f550-5146-a015-3b6287e30319" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186370872}] :answer-field/correct {:answer/id #uuid "525502ba-0880-5578-acff-65e20803b028" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{2}" :db/id #edb/ref 17592186370869} :answer-field/id #uuid "8e6bae3a-a9a4-5fca-824b-62e8e3c68470" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186370867}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "10d6890a-296c-53ec-8907-6981aa9b1760" :question/math-academy-id "q-38277" :question/problem "Given that the polynomial $f(x)=2{x}^{3}+9{x}^{2}+7x-6$ has one of its roots in the interval $(0,\\frac{3}{2}),$ find the sum of the distinct real roots of $f(x).$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $-6$ and the leading coefficient is $2.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }-6}{\\text{factor of }2}.\n$$\n\nTherefore, the possible rational roots are as follows:\n\n$$\n\\pm \\frac{1}{2},\\,\\pm \\frac{3}{2},\\,\\pm 1,\\,\\pm 2,\\,\\pm 3,\\,\\pm 6\n$$\n\nOf these roots, the only roots in the interval $(0,\\frac{3}{2}),$ are $\\frac{1}{2}$ and $1.$\n\nNow, let's use synthetic division to test whether $(x-\\frac{1}{2})$ is a factor of $f(x).$ We get the following:\n\n|  | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- |\n| $\\frac{1}{2}$ | $2$ | $9$ | $7$ | $-6$ |\n|  | $↓$ | $1$ | $5$ | $6$ |\n|  | $2$ | $10$ | $12$ | $0$ |\n\nSince the remainder is $0,$ we conclude that $(x-\\frac{1}{2})$ is indeed a factor of $f(x).$ Moreover, we have\n\n$$\nf(x)=(x-\\frac{1}{2})(2{x}^{2}+10x+12).\n$$\n\nSince the highest-degree factor is now a quadratic, we can continue factoring using the usual methods:\n\n$$\n\\begin{aligned}f(x) & =(x-\\frac{1}{2})(2{x}^{2}+10x+12) \\\\  & =2(x-\\frac{1}{2})({x}^{2}+5x+6) \\\\  & =2(x-\\frac{1}{2})(x+2)(x+3)\\end{aligned}\n$$\n\nSetting the factors equal to $0,$ we find the roots $x=\\frac{1}{2},-2,-3.$ Summing these roots, we get\n\n$$\n\\frac{1}{2}-2-3=-\\frac{9}{2}.\n$$"}] [{:db/id #edb/ref 17592186083891 :knowledge-point/_questions [{:db/id #edb/ref 17592186083306 :knowledge-point/id #uuid "a75b47ec-8d5a-545e-b915-daca92320322" :knowledge-point/title "Identifying Non-Roots of a Polynomial Using the Rational Roots Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6034f8d-aa19-5323-b77c-9c3e9840bc79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186082278} {:answer/id #uuid "dda9558b-7186-57d5-a556-24b82b6fe6b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186082279} {:answer/id #uuid "fa067bc6-591d-5442-89b0-4bb61deffa95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186082280} {:answer/id #uuid "29a21594-229a-524b-b19a-e19944ed8938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186082281} {:answer/id #uuid "79b3ab26-2ad0-508c-bbd0-cb7f4dcb206e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186082282}] :answer-field/id #uuid "abbccfce-f350-5b66-8f1c-7c3548b3e2ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186082277} {:answer-field/choices [{:answer/id #uuid "bfd1cd6a-285c-548a-adba-d82870244265" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186395926} {:answer/id #uuid "131a7494-8f01-55ba-92bc-b15e88fd9846" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186395927} {:answer/id #uuid "269d0de3-6a01-5def-89db-3dc958c2558c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186395928} {:answer/id #uuid "093668c9-e9ba-5cdb-99a9-79d2c36efe70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186395929} {:answer/id #uuid "b5f49533-db03-5f90-9f04-b99e950b449d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186395930}] :answer-field/correct {:answer/id #uuid "b5f49533-db03-5f90-9f04-b99e950b449d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186395930} :answer-field/id #uuid "754d2cb4-bc72-56f5-9aae-e0a939de763c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395925}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "edc161f0-8951-58a5-87a8-35a7ed39116e" :question/math-academy-id "q-6671" :question/problem "According to the rational roots theorem, which of the following **cannot** be a root of the polynomial $f(x)=4{x}^{3}-6{x}^{2}-10x-4?$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $-4$ and the leading coefficient is $4.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }-4}{\\text{factor of }4}.\n$$\n\nOf the given answer choices, only $-6$ does not take the above form. The value $-6$ can be interpreted as a fraction $-\\frac{6}{1},$ and the numerator $(6)$ is not a factor of $-4.$"}]}
