[{:db/id 17592186198424 :knowledge-point/questions ["question-31b20932-a88b-54bd-ad72-798a42092fda" "question-2832e0eb-5e7b-5688-bfb6-27961002a194"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186198066 :question/problem "A large bottle of tempera paint has a volume of $1\\,\\textrm{L}.$ What is this volume in milliliters?" :question/worked-solution "A table showing the metric units of volume is given below.\n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Liter | $\\textrm{L}$ | --- |\n| Milliliter | $\\textrm{mL}$ | $1,000\\,\\textrm{mL} = 1\\,\\textrm{L}$ |\n\nSo, $1\\,\\textrm{L}$ is equivalent to $1\\,000\\,\\textrm{mL}.$" :db/ensure [:question/validate]} {:db/id 17592186198425 :knowledge-point/questions ["question-f31883c8-d30d-5b23-ae4e-6476fbac9a55" "question-fd88aef1-a9d1-56f6-9a8e-465d846b2c75"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186198067 :question/problem "A self-service restaurant offers ketchup in individual packets. Which customary unit of measurement could the restaurant use to quantify the volume of sauce in each packet?\n\nI. ounces\n\nII. fluid ounces\n\nIII. inches" :question/worked-solution "A table showing the customary units of volume is given below.\n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Gallon | $\\textrm{gal}$ | $1\\,\\textrm{gal} = 8\\,\\textrm{pints}$ |\n| Pint | $\\textrm{pt}$ | $1\\,\\textrm{pt} = 2\\,\\textrm{cups}$ |\n| Cup | $-$ | $1\\,\\textrm{cup} = 8\\,\\textrm{fl oz}$ |\n| Fluid ounce | $\\textrm{fl oz}$ | $-$ |\n\nTherefore, from the given options, the only unit of volume is \"fluid ounce.\"" :db/ensure [:question/validate]} {:db/id 17592186198429 :knowledge-point/questions ["question-36197295-ff24-5cc2-86bf-da1d0aa5bd10"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186198071 :question/worked-solution "A table showing the customary units of volume is given below.\n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Gallon | $\\textrm{gal}$ | $1\\,\\textrm{gal} = 8\\,\\textrm{pints}$ |\n| Pint | $\\textrm{pt}$ | $1\\,\\textrm{pt} = 2\\,\\textrm{cups}$ |\n| Cup | $-$ | $1\\,\\textrm{cup} = 8\\,\\textrm{fl oz}$ |\n| Fluid ounce | $\\textrm{fl oz}$ | $-$ |\n\nSo, $1\\,\\textrm{pint}$ is equivalent to $2\\,\\textrm{cups}.$" :db/ensure [:question/validate]} {:db/id "question-31b20932-a88b-54bd-ad72-798a42092fda" :question/id #uuid "31b20932-a88b-54bd-ad72-798a42092fda" :question/math-academy-id "q-164344" :question/problem "A soda bottle has a volume of $1\\,\\text{L}.$ What is this volume in milliliters?" :question/worked-solution "A table showing the metric units of volume is given below.\n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Liter | $\\text{L}$ | --- |\n| Milliliter | $\\text{mL}$ | $1,000\\,\\text{mL}=1\\,\\text{L}$ |\n\nSo, $1\\,\\text{L}$ is equivalent to $1\\,000\\,\\text{mL}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-811d8564-5a35-55de-949c-a681971dda57"] :db/ensure [:question/validate]} {:db/id "answer-field-811d8564-5a35-55de-949c-a681971dda57" :answer-field/id #uuid "811d8564-5a35-55de-949c-a681971dda57" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8826b698-786d-5509-943c-65d0a9db4a4e" :answer-field/choices ["answer-1f9bcc40-87b3-5775-8bba-43c1ec5128f3" "answer-cc0304cc-4a8c-51f9-b91b-0654d27652f9" "answer-8d0c9fa8-6de4-57c7-ab92-3dc5cc7287da" "answer-a0a091b3-80af-5558-a4bb-4712b235f028" "answer-8826b698-786d-5509-943c-65d0a9db4a4e"] :db/ensure [:answer-field/validate]} {:db/id "answer-1f9bcc40-87b3-5775-8bba-43c1ec5128f3" :answer/id #uuid "1f9bcc40-87b3-5775-8bba-43c1ec5128f3" :answer/type :answer.type/math :answer/value "0.001\\,\\text{mL}" :db/ensure [:answer/validate]} {:db/id "answer-cc0304cc-4a8c-51f9-b91b-0654d27652f9" :answer/id #uuid "cc0304cc-4a8c-51f9-b91b-0654d27652f9" :answer/type :answer.type/math :answer/value "0.01\\,\\text{mL}" :db/ensure [:answer/validate]} {:db/id "answe