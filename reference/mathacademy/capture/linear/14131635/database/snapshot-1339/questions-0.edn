#{[{:db/id #edb/ref 17592186198066 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198424 :knowledge-point/id #uuid "1b8161e6-678c-5fb6-b1bd-3e3d78913495" :knowledge-point/title "Metric Units of Volume"}] :question/id #uuid "c0546e5d-93b8-5ccd-9833-c5d1cfc1533a" :question/math-academy-id "e-12512" :question/problem "A large bottle of tempera paint has a volume of $1\\,\\textrm{L}.$ What is this volume in milliliters?" :question/worked-solution "A table showing the metric units of volume is given below.\n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Liter | $\\textrm{L}$ | --- |\n| Milliliter | $\\textrm{mL}$ | $1,000\\,\\textrm{mL} = 1\\,\\textrm{L}$ |\n\nSo, $1\\,\\textrm{L}$ is equivalent to $1\\,000\\,\\textrm{mL}.$"}] [{:db/id #edb/ref 17592186198067 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198425 :knowledge-point/id #uuid "5957039e-4732-518a-b8e3-ca00900e3a25" :knowledge-point/title "Identifying Customary Units of Volume"}] :question/id #uuid "fb4a9b9a-9e34-5d0d-9be0-02627b2058b5" :question/math-academy-id "e-12513" :question/problem "A self-service restaurant offers ketchup in individual packets. Which customary unit of measurement could the restaurant use to quantify the volume of sauce in each packet?\n\nI. ounces\n\nII. fluid ounces\n\nIII. inches" :question/worked-solution "A table showing the customary units of volume is given below.\n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Gallon | $\\textrm{gal}$ | $1\\,\\textrm{gal} = 8\\,\\textrm{pints}$ |\n| Pint | $\\textrm{pt}$ | $1\\,\\textrm{pt} = 2\\,\\textrm{cups}$ |\n| Cup | $-$ | $1\\,\\textrm{cup} = 8\\,\\textrm{fl oz}$ |\n| Fluid ounce | $\\textrm{fl oz}$ | $-$ |\n\nTherefore, from the given options, the only unit of volume is \"fluid ounce.\""}] [{:db/id #edb/ref 17592186198071 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198429 :knowledge-point/id #uuid "2630641a-ee5f-5a10-a67d-aea77af4471c" :knowledge-point/title "Stating Volume Conversions in Customary Units"}] :question/id #uuid "490ae71b-5dbf-5315-9a00-2dda8677c47b" :question/math-academy-id "e-12521" :question/problem "A soap dispenser has a volume of $1$ pint. What is this volume in cups?" :question/worked-solution "A table showing the customary units of volume is given below.\n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Gallon | $\\textrm{gal}$ | $1\\,\\textrm{gal} = 8\\,\\textrm{pints}$ |\n| Pint | $\\textrm{pt}$ | $1\\,\\textrm{pt} = 2\\,\\textrm{cups}$ |\n| Cup | $-$ | $1\\,\\textrm{cup} = 8\\,\\textrm{fl oz}$ |\n| Fluid ounce | $\\textrm{fl oz}$ | $-$ |\n\nSo, $1\\,\\textrm{pint}$ is equivalent to $2\\,\\textrm{cups}.$"}] [{:db/id #edb/ref 17592186198669 :knowledge-point/_questions [{:db/id #edb/ref 17592186198429 :knowledge-point/id #uuid "2630641a-ee5f-5a10-a67d-aea77af4471c" :knowledge-point/title "Stating Volume Conversions in Customary Units"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad96f2e7-3aca-5bd9-9bbe-4aa439f74a6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$8$ pints" :db/id #edb/ref 17592186194646} {:answer/id #uuid "d358e982-9fd8-58cb-b565-52d3693392cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$16$ pints" :db/id #edb/ref 17592186194647} {:answer/id #uuid "f0100775-a837-52d7-9059-765aa5c37ec9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ pints" :db/id #edb/ref 17592186194648} {:answer/id #uuid "064cfd56-4a24-5abf-8b58-9789847d4346" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ pints" :db/id #edb/ref 17592186194649} {:answer/id #uuid "0cd16442-16ad-5769-ad9a-8a11ed52a780" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ pints" :db/id #edb/ref 17592186194650}] :answer-field/correct {:answer/id #uuid "ad96f2e7-3aca-5bd9-9bbe-4aa439f74a6a" :answer/t