      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14258034/observations/step-q120275-4cfd648c5e1c3e9074a4.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14258034/observations/step-q120275-4cfd648c5e1c3e9074a4.png",
      "source_url": "https://mathacademy.com/tasks/14258034/topics/1106/review",
