{
  "dom_id": "step-71804",
  "name": "Example: \n                    Listing the Coefficients of an Expression",
  "problem": "List the coefficients of the expression $4n - m.$",
  "worked_solution": "The terms of the expression are $4n$ and $-m.$ Looking at each term individually, we see that\n\n- the coefficient of the term $4n$ is $4$, and\n\n- the coefficient of the term $-m$ is $-1.$\n\nSo, the coefficients of the expression are $4$ and $-1.$",
  "calculator_instructions": "",
  "fields": [],
  "problem_field_keys": [],
  "answer_fields_complete": null,
  "result": null,
  "proof_feedback": null,
