-62ea-59ad-a8a1-f6ae346da60d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186444730} {:answer/id #uuid "af627d93-8a24-54bb-851c-b64d1659977e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186444731}] :answer-field/correct {:answer/id #uuid "a2648f19-5fca-5f9b-9748-cee1d7b80661" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186444728} :answer-field/id #uuid "0e69f4aa-cc1f-53f4-9bb4-92e5bff916a4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186444744}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ebbf94e8-8bda-5e3a-9314-f9c7774a7046" :question/math-academy-id "q-101493" :question/problem "What is the value of the constant term in the expression $7x-\\frac{2}{9}y-3z?$" :question/worked-solution "The expression has three terms: $7x,$ $-\\frac{2}{9}y,$ and $-3z.$ Each of these terms contains a variable, so none of them are constant terms.\n\nThe constant term is missing. However, we can include it by adding zero to the expression. Rewriting the given expression as\n\n$$\n7x-\\frac{2}{9}y-3z+0,\n$$\n\nwe see that the value of the constant term is $0.$"}] [{:db/id #edb/ref 17592186444760 :knowledge-point/_questions [{:db/id #edb/ref 17592186078612 :knowledge-point/id #uuid "444bd7e6-ade1-5ac7-8e53-d4b0735f93fb" :knowledge-point/title "Identifying the Missing Constant or the Coefficient of a Missing Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eacf3ffe-9baf-5cbb-9690-c854a9200472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186444739}] :answer-field/correct {:answer/id #uuid "eacf3ffe-9baf-5cbb-9690-c854a9200472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186444739} :answer-field/id #uuid "20cb68b3-1470-5d7e-933d-e77a12610b14" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444745}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2bd1aa13-179d-5d50-b799-cdeceb985d71" :question/math-academy-id "q-171468" :question/problem "The constant term in the expression $4m+7n$ is{{field-1}}." :question/worked-solution "The expression has two terms: \n\n$$\n4m\\,,\\,7n\n$$\n\n \n\nEach of these terms contains a variable, so none are constant.\n\nThe constant term is missing. However, we can include it by adding zero to the expression. Rewriting the given expression as\n\n$$\n4m+7n+0,\n$$\n\nwe see that the constant term is $0.$"}] [{:db/id #edb/ref 17592186444758 :knowledge-point/_questions [{:db/id #edb/ref 17592186078609 :knowledge-point/id #uuid "33ebbaee-ad49-50c1-8973-c447756e0109" :knowledge-point/title "Listing the Coefficients of an Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e967ed5c-c2ee-58cc-84de-ec31791a74b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186444738}] :answer-field/correct {:answer/id #uuid "e967ed5c-c2ee-58cc-84de-ec31791a74b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186444738} :answer-field/id #uuid "05455061-8db8-59c8-b895-e03f2c611b42" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444743} {:answer-field/choices [{:answer/id #uuid "386d4d9f-5768-5531-a3b1-5bc0f02b7a94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186444715}] :answer-field/correct {:answer/id #uuid "386d4d9f-5768-5531-a3b1-5bc0f02b7a94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186444715} :answer-field/id #uuid "cf72dd3e-1280-592e-8d1f-648022766cbc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444754}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2272cd41-1d55-5834-b251-13ac33998b0e" :question/math-academy-id "q-175309" :question/problem "The coefficients of $z$ and $w$ of the expression $4z-2v-w$ are{{field-1}}\nand\n{{field-2}}\n, respectively." :question/worked-solution "The terms of the expression are $4z,$ $-2v,$  and $-w.$ Looking at each term individually, we see that\n\n- the coefficient of the term $4z$ is $4$,\n\n- the coefficient of the term $-2v$ is $-2$, and\n\n- the coefficient of the term $-w$ is $-1.$\n\nSo, the coefficients of $z$ and $w$ of the given expression are $4$ and $-1,$ respectively."}] [{:db/id #edb/ref 17592186444761 :knowledge-point/_questions [{:db/id #edb/ref 17592186078610 :knowledge-point/id #uuid "64f7aa0b-533f-5141-bdec-5b053e7d8c6d" :knowledge-point/title "Listing Fractional Coefficients When the Variable is in a Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "676d8f01-aad4-5d49-bf8f-17f4178a608e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{5}" :db/id #edb/ref 17592186444721}] :answer-field/correct {:answer/id #uuid "676d8f01-aad4-5d49-bf8f-17f4178a608e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{5}" :db/id #edb/ref 17592186444721} :answer-field/id #uuid "43f1d29c-e3bd-5414-ae05-7bc016fcdd74" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.