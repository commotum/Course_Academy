#{[{:db/id #edb/ref 17592186078154 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078609 :knowledge-point/id #uuid "33ebbaee-ad49-50c1-8973-c447756e0109" :knowledge-point/title "Listing the Coefficients of an Expression"}] :question/id #uuid "16d88557-c94b-5666-a86b-ed241e6b106e" :question/math-academy-id "e-12819" :question/problem "List the coefficients of the expression $4n - m.$" :question/worked-solution "The terms of the expression are $4n$ and $-m.$ Looking at each term individually, we see that\n\n- the coefficient of the term $4n$ is $4$, and\n\n- the coefficient of the term $-m$ is $-1.$\n\nSo, the coefficients of the expression are $4$ and $-1.$"}] [{:db/id #edb/ref 17592186078156 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078612 :knowledge-point/id #uuid "444bd7e6-ade1-5ac7-8e53-d4b0735f93fb" :knowledge-point/title "Identifying the Missing Constant or the Coefficient of a Missing Variable"}] :question/id #uuid "ab3ecbe1-5cfd-54e8-b380-6f76b28ae757" :question/math-academy-id "e-12820" :question/problem "What is the coefficient of $c$ in the expression $7a + 4b - 1 ?$" :question/worked-solution "We can rewrite the expression as\n\n$$\n7a+4b-1+ 0,\n$$\n\nand we can replace $0$ with $0c$ to get:\n\n$$\n7a+4b-1+ 0c\n$$\n\nWe see that the coefficient of $c$ is $0.$"}] [{:db/id #edb/ref 17592186078157 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078611 :knowledge-point/id #uuid "1b866c18-f3a0-599e-9bbb-970e0c79c585" :knowledge-point/title "Identifying the Constant Term of an Expression"}] :question/id #uuid "e731b5e2-f04a-50b8-95fc-f708d76a5343" :question/math-academy-id "e-12821" :question/problem "What is the value of the constant term in the expression $2x-4y+4z-\\dfrac{5}{2}?$" :question/worked-solution "The expression has four terms: $2x$, $-4y$, $4z$ and $-\\dfrac 5 2.$ The only term that does not contain any variables is $-\\dfrac 5 2$, so $-\\dfrac 5 2$ is the constant term."}] [{:db/id #edb/ref 17592186078161 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078610 :knowledge-point/id #uuid "64f7aa0b-533f-5141-bdec-5b053e7d8c6d" :knowledge-point/title "Listing Fractional Coefficients When the Variable is in a Numerator"}] :question/id #uuid "c4668f0b-e26f-54d3-b1d2-e5ac6bb4efa5" :question/math-academy-id "e-12826" :question/problem "What are the coefficients of $a$ and $b$ in the expression $\\dfrac{3a}{5} -10b+1?$" :question/worked-solution "The terms of the expression are $\\dfrac{3a}{5},$ $-10b,$ and $1.$ Looking at each term individually, we see that\n\n- the coefficient of the term $\\dfrac{3a}{5}$ is $\\dfrac{3}{5}$,\n\n- the coefficient of the term $-10b$ is $-10,$ and\n\n- the coefficient of the term $1$ is $1.$\n\nSo, the coefficients of $a$ and $b$ in the given expression are $\\bbox[3pt,Gainsboro]{\\color{blue}\\dfrac{3}{5}}$ and $\\bbox[3pt,Gainsboro]{\\color{blue}-10},$ respectively."}] [{:db/id #edb/ref 17592186444768 :knowledge-point/_questions [{:db/id #edb/ref 17592186078611 :knowledge-point/id #uuid "1b866c18-f3a0-599e-9bbb-970e0c79c585" :knowledge-point/title "Identifying the Constant Term of an Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03a52dd8-c7ac-5c17-8468-552c2c7715eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186444706} {:answer/id #uuid "0ae664aa-5842-54ae-8ad4-5b4748cd5d8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{9}" :db/id #edb/ref 17592186444709} {:answer/id #uuid "3ef717fc-2ca1-5319-8e33-7b255902d526" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186444717} {:answer/id #uuid "e1d10094-ff3a-52a9-913c-931f5c1a4da5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-w" :db/id #edb/ref 17592186444736} {:answer/id #uuid "fa161e75-e126-5914-b5f