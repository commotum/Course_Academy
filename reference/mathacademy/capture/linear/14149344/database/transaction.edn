[{:db/id 17592186078609 :knowledge-point/questions ["question-2272cd41-1d55-5834-b251-13ac33998b0e" "question-3f37989f-b57a-5aea-8240-70da015f5138" "question-6fc23966-668e-556a-8201-5e4dfbc9499b" "question-50031aea-32a5-5fdf-84b7-ae97c029443e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078154 :question/problem "List the coefficients of the expression $4n - m.$" :question/worked-solution "The terms of the expression are $4n$ and $-m.$ Looking at each term individually, we see that\n\n- the coefficient of the term $4n$ is $4$, and\n\n- the coefficient of the term $-m$ is $-1.$\n\nSo, the coefficients of the expression are $4$ and $-1.$" :db/ensure [:question/validate]} {:db/id 17592186078610 :knowledge-point/questions ["question-3b6ff78f-5ae9-5640-bff0-d028984b3a83" "question-3a1bccc4-dcaa-5037-affa-01c48877663d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078161 :question/problem "What are the coefficients of $a$ and $b$ in the expression $\\dfrac{3a}{5} -10b+1?$" :question/worked-solution "The terms of the expression are $\\dfrac{3a}{5},$ $-10b,$ and $1.$ Looking at each term individually, we see that\n\n- the coefficient of the term $\\dfrac{3a}{5}$ is $\\dfrac{3}{5}$,\n\n- the coefficient of the term $-10b$ is $-10,$ and\n\n- the coefficient of the term $1$ is $1.$\n\nSo, the coefficients of $a$ and $b$ in the given expression are $\\bbox[3pt,Gainsboro]{\\color{blue}\\dfrac{3}{5}}$ and $\\bbox[3pt,Gainsboro]{\\color{blue}-10},$ respectively." :db/ensure [:question/validate]} {:db/id 17592186078611 :knowledge-point/questions ["question-62dea677-f3f9-594c-972b-a951f4087b85" "question-2410df8a-af5f-5395-a8f7-6f01fb9b5a62" "question-a6ad512b-05d5-5a8e-92ba-aaa6e2d9bc0a" "question-c8eb1f28-793c-5aac-9e95-717919e5f9cd" "question-3f084ce4-122d-54f2-8959-73b35064d8ae"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078157 :question/problem "What is the value of the constant term in the expression $2x-4y+4z-\\dfrac{5}{2}?$" :question/worked-solution "The expression has four terms: $2x$, $-4y$, $4z$ and $-\\dfrac 5 2.$ The only term that does not contain any variables is $-\\dfrac 5 2$, so $-\\dfrac 5 2$ is the constant term." :db/ensure [:question/validate]} {:db/id 17592186078612 :knowledge-point/questions ["question-ebbf94e8-8bda-5e3a-9314-f9c7774a7046" "question-2bd1aa13-179d-5d50-b799-cdeceb985d71"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078156 :question/problem "What is the coefficient of $c$ in the expression $7a + 4b - 1 ?$" :question/worked-solution "We can rewrite the expression as\n\n$$\n7a+4b-1+ 0,\n$$\n\nand we can replace $0$ with $0c$ to get:\n\n$$\n7a+4b-1+ 0c\n$$\n\nWe see that the coefficient of $c$ is $0.$" :db/ensure [:question/validate]} {:db/id "question-2272cd41-1d55-5834-b251-13ac33998b0e" :question/id #uuid "2272cd41-1d55-5834-b251-13ac33998b0e" :question/math-academy-id "q-175309" :question/problem "The coefficients of $z$ and $w$ of the expression $4z-2v-w$ are{{field-1}}\nand\n{{field-2}}\n, respectively." :question/worked-solution "The terms of the expression are $4z,$ $-2v,$  and $-w.$ Looking at each term individually, we see that\n\n- the coefficient of the term $4z$ is $4$,\n\n- the coefficient of the term $-2v$ is $-2$, and\n\n- the coefficient of the term $-w$ is $-1.$\n\nSo, the coefficients of $z$ and $w$ of the given expression are $4$ and $-1,$ respectively." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-cf72dd3e-1280-592e-8d1f-648022766cbc" "answer-field-05455061-8db8-59c8-b895-e03f2c611b42"] :db/ensure [:question/validate]} {:db/id "answer-field-cf72dd3e-1280-592e-8d1f-648022766cbc" :answer-field/id #uuid "cf72dd3e-1280-592e-8d1f-648022766cbc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-386d4d9f-5768-5531-a3b1-5bc0f02b7a94" :answer-field/choices ["answer-386d4d9f-5768-5531-a3b1-5bc0f02b7a94"] :db/ensure [:answer-field/validate]} {:db/id "answer-3