#{[{:db/id #edb/ref 17592186078154 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078609 :knowledge-point/id #uuid "33ebbaee-ad49-50c1-8973-c447756e0109" :knowledge-point/title "Listing the Coefficients of an Expression"}] :question/id #uuid "16d88557-c94b-5666-a86b-ed241e6b106e" :question/math-academy-id "e-12819" :question/problem "List the coefficients of the expression $4n - m$." :question/worked-solution "The terms of the expression are $4n$ and $-m$. Looking at each term individually, we see that\n\n- the coefficient of the term $4n$ is $4$, and\n- the coefficient of the term $-m$ is $-1$.\n\nSo, the coefficients of the expression are $4$ and $-1$."}] [{:db/id #edb/ref 17592186078156 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078612 :knowledge-point/id #uuid "444bd7e6-ade1-5ac7-8e53-d4b0735f93fb" :knowledge-point/title "Identifying the Missing Constant or the Coefficient of a Missing Variable"}] :question/id #uuid "ab3ecbe1-5cfd-54e8-b380-6f76b28ae757" :question/math-academy-id "e-12820" :question/problem "What is the coefficient of $c$ in the expression $7a + 4b - 1$?" :question/worked-solution "We can rewrite the expression as\n$7a+4b-1+ 0$,\nand we can replace $0$ with $0c$ to get:\n$7a+4b-1+ 0c$\nWe see that the coefficient of $c$ is $0$."}] [{:db/id #edb/ref 17592186078157 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078611 :knowledge-point/id #uuid "1b866c18-f3a0-599e-9bbb-970e0c79c585" :knowledge-point/title "Identifying the Constant Term of an Expression"}] :question/id #uuid "e731b5e2-f04a-50b8-95fc-f708d76a5343" :question/math-academy-id "e-12821" :question/problem "What is the value of the constant term in the expression $2x-4y+4z-\\dfrac{5}{2}$?" :question/worked-solution "The expression has four terms: $2x$, $-4y$, $4z$ and\n\n$$\n-\\dfrac 5 2\n$$\n\nThe only term that does not contain any variables is\n\n$$\n-\\dfrac 5 2\n$$\n\n, so\n\n$$\n-\\dfrac 5 2\n$$\n\nis the constant term."}] [{:db/id #edb/ref 17592186078161 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078610 :knowledge-point/id #uuid "64f7aa0b-533f-5141-bdec-5b053e7d8c6d" :knowledge-point/title "Listing Fractional Coefficients When the Variable is in a Numerator"}] :question/id #uuid "c4668f0b-e26f-54d3-b1d2-e5ac6bb4efa5" :question/math-academy-id "e-12826" :question/problem "What are the coefficients of $a$ and $b$ in the expression $\\dfrac{3a}{5} -10b+1$?" :question/worked-solution "The terms of the expression are\n\n$$\n\\dfrac{3a}{5}\n$$\n\n$-10b$, and $1$. Looking at each term individually, we see that\n\n- the coefficient of the term $\\dfrac{3a}{5}$ is $\\dfrac{3}{5}$,\n- the coefficient of the term $-10b$ is $-10$, and\n- the coefficient of the term $1$ is $1$.\n\nSo, the coefficients of $a$ and $b$ in the given expression are\n\n$$\n\\bbox[3pt,Gainsboro]{\\color{blue}\\dfrac{3}{5}}\n$$\n\nand $\\bbox[3pt,Gainsboro]{\\color{blue}-10}$, respectively."}] [{:db/id #edb/ref 17592186078903 :knowledge-point/_questions [{:db/id #edb/ref 17592186078609 :knowledge-point/id #uuid "33ebbaee-ad49-50c1-8973-c447756e0109" :knowledge-point/title "Listing the Coefficients of an Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "937e0437-09e0-5eae-8c96-69be01531656" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186076197} {:answer/id #uuid "988a40b5-846c-5d76-874c-39a6a36fb184" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186076198} {:answer/id #uuid "a9781be4-d71e-5dc6-8499-ef250604a633" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3t" :db/id #edb/ref 17592186076199} {:answer/id #uuid "d3f96a86-ec69-56c1-83a9-91da93314865" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186076200} {:answer/id #uuid "40794ef8-7793-51d7-b49f-0b4f6e6c3946" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186076201}] :answer-field/id #uuid "605b590d-ebdd-57f3-b142-ec1474cff6e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186076196}] :question/id #uuid "38c57af4-d635-5e3a-a5d2-843a31f548ca" :question/math-academy-id "q-41008" :question/problem "What is the coefficient of $t$ in the expression $4r + 3t - 2s$?"}]}
