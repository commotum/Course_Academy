#{[{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186097689} :activity/id #uuid "e88ba3cb-c9bf-5fd4-b41a-f7a4a7dbdf65" :activity/scope {:db/id #edb/ref 17592186050564 :topic/id #uuid "53f1b90b-679a-5fc8-8d88-3abe54c112ec" :topic/math-academy-id 1081} :activity/steps [{:db/id #edb/ref 17592186097689 :step/content {:db/id #edb/ref 17592186097810 :tutorial/content "Sometimes, we might have a system of equations with decimal coefficients, such as the following:\n\n$$\n\\left\\{\\begin{aligned}0.2x+y &=1 \\\\ 0.15x-0.04y &=0.2\\end{aligned}\\right.\n$$\n\nTo make the system easier to solve, we turn it into a system involving integer coefficients only.\n\nIn general, we multiply each equation by $10,$ or $100,$ or $1000,$ etc. depending on how many decimal places we need to eliminate. In this particular instance:\n\n- We need to eliminate one decimal place in the top equation, so we multiply by $10.$\n\n- We need to eliminate two decimal places in the bottom equation, so we multiply by $100.$\n\nSo, we multiply the first equation by $10$ and the second equation by $100,$ as follows:\n\n$$\n\\left\\{\\begin{aligned}0.2x+y &=1 && |\\times 10 \\\\ 0.15x-0.04y &=0.2 && |\\times 100\\end{aligned}\\right.\n$$\n\nFrom here, we can solve the system of equations using either substitution or elimination." :tutorial/id #uuid "ca705a2f-5d99-5642-87c9-9aadf1ef0319" :tutorial/math-academy-id 1465 :tutorial/title "Introduction"} :step/id #uuid "ea69e83f-e045-5c97-abd8-0852c912ada9" :step/math-academy-id 3426 :step/next {:db/id #edb/ref 17592186097690}} {:db/id #edb/ref 17592186097690 :step/content {:db/id #edb/ref 17592186096784 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096368 :question/id #uuid "0a5391bf-06ef-5099-a835-0375ff96c342" :question/math-academy-id "e-1038"} :knowledge-point/id #uuid "f7578c48-cc9e-5170-8ffe-5ebee6580677" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048826} {:db/id #edb/ref 17592186049060}] :know