edb/ref 17592186045585] [17592186407272 #edb/ref 1075 #edb/ref 17592186407255 #edb/ref 17592186045585] [17592186407272 #edb/ref 1075 #edb/ref 17592186407259 #edb/ref 17592186045585] [17592186407272 #edb/ref 1075 #edb/ref 17592186407268 #edb/ref 17592186045585] [17592186407272 #edb/ref 1075 #edb/ref 17592186407269 #edb/ref 17592186045585] [17592186407272 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045585] [17592186407272 #edb/ref 1077 "selection" #edb/ref 17592186045585] [17592186407272 #edb/ref 1079 #edb/ref 17592186407259 #edb/ref 17592186045585] [17592186407272 #edb/ref 1080 #uuid "65c8f326-9093-58bd-a6e1-bf36f4cf4e21" #edb/ref 17592186045585] [17592186407273 #edb/ref 1075 #edb/ref 17592186407245 #edb/ref 17592186045585] [17592186407273 #edb/ref 1075 #edb/ref 17592186407250 #edb/ref 17592186045585] [17592186407273 #edb/ref 1075 #edb/ref 17592186407257 #edb/ref 17592186045585] [17592186407273 #edb/ref 1075 #edb/ref 17592186407262 #edb/ref 17592186045585] [17592186407273 #edb/ref 1075 #edb/ref 17592186407263 #edb/ref 17592186045585] [17592186407273 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045585] [17592186407273 #edb/ref 1077 "selection" #edb/ref 17592186045585] [17592186407273 #edb/ref 1079 #edb/ref 17592186407263 #edb/ref 17592186045585] [17592186407273 #edb/ref 1080 #uuid "a14d9fc2-b7d8-5af8-b07b-319f63dc6ba1" #edb/ref 17592186045585] [17592186407274 #edb/ref 1075 #edb/ref 17592186407246 #edb/ref 17592186045585] [17592186407274 #edb/ref 1075 #edb/ref 17592186407252 #edb/ref 17592186045585] [17592186407274 #edb/ref 1075 #edb/ref 17592186407256 #edb/ref 17592186045585] [17592186407274 #edb/ref 1075 #edb/ref 17592186407258 #edb/ref 17592186045585] [17592186407274 #edb/ref 1075 #edb/ref 17592186407266 #edb/ref 17592186045585] [17592186407274 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045585] [17592186407274 #edb/ref 1077 "selection" #edb/ref 17592186045585] [17592186407274 #edb/ref 1079 #edb/ref 17592186407258 #edb/ref 17592186045585] [17592186407274 #edb/ref 1080 #uuid "e82e089a-caba-5439-8d15-a646e7c8e9fa" #edb/ref 17592186045585] [17592186407275 #edb/ref 1068 #edb/ref 17592186407270 #edb/ref 17592186045585] [17592186407275 #edb/ref 1069 "q-109846" #edb/ref 17592186045585] [17592186407275 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045585] [17592186407275 #edb/ref 1071 "Consider a $5\\times 4$ matrix $A.$ If $\\text{dim}(\\text{Col}({A}^{T}))=3,$ then $\\text{dim}(\\text{Null}(A))=$" #edb/ref 17592186045585] [17592186407275 #edb/ref 1072 #uuid "5d75070f-88dd-5b20-8fec-c1f3c6de013c" #edb/ref 17592186045585] [17592186407275 #edb/ref 1074 "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=5,$ $n=4,$ and $r=3.$ \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Null}(A)) & =n-r=4-3=1.\\end{aligned}\n$$" #edb/ref 17592186045585] [17592186407276 #edb/ref 1068 #edb/ref 17592186407274 #edb/ref 17592186045585] [17592186407276 #edb/ref 1069 "q-109873" #edb/ref 17592186045585] [17592186407276 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045585] [17592186407276 #edb/ref 1071 "Consider a $5\\times 6$ matrix $A.$ If $\\text{dim}(\\text{Col}({A}^{T}))=3,$ then $\\text{dim}(\\text{Null}({A}^{T}))=$" #edb/ref 17592186045585] [17592186407276 #edb/ref 1072 #uuid "66ca173a-d952-58d1-b484-502590c17693" #edb/ref 17592186045585] [17592186407276 #edb/ref 1074 "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=5,$ $n=6,$ and $r=3.$ \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Null}({A}^{T})) & =m-r=5-3=2.\\end{aligned}\n$$" #edb/ref 17592186045585] [17592186407277 #edb/ref 1068 #edb/ref 17592186407271 #edb/ref 17592186045585] [17592186407277 #edb/ref 1069 "q-109848" #edb/ref 17592186045585] [17592186407277 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045585] [17592186407277 #edb/ref 1071 "Let $A$ be a $m\\times n$ matrix. What is the image of ${R}^{m}$ under the action of ${A}^{T}?$" #edb/ref 17592186045585] [17592186407277 #edb/ref 1072 #uuid "b9c49e80-5070-56aa-b070-99b1fa2fdff3" #edb/ref 17592186045585] [17592186407277 #edb/ref 1074 "First, notice that ${A}^{T}$ is a $n\\times m$ matrix.\n\nPre-multiplying a vector $x\\in {R}^{m}$ by ${A}^{T}$ gives a linear combination of the columns of ${A}^{T}:$\n\n$$\n{{[\\begin{aligned}| & | & ⋯ & | \\\\ {a}_{1}^{T} & {a}_{2}^{T} & ⋯ & {a}_{m}^{T} \\\\ | & | & ⋯ & |\\end{aligned}]}_{⏟}}_{{A}^{T}}\\cdot {{[\\begin{aligned}{x}_{1} \\\\ ⋮ \\\\ {x}_{m}\\end{aligned}]}_{⏟}}_{x}={x}_{1}[\\begin{aligned}| \\\\ {a}_{1}^{T} \\\\ |\\end{aligned}]+{x}_{2}[\\begin{aligned}| \\\\ {a}_{2}^{T} \\\\ |\\end{aligned}]+⋯+{x}_{m}[\\begin{aligned}| \\\\ {a}_{m}^{T} \\\\ |\\end{aligned}]\n$$\n\nTherefore, the image of ${R}^{m}$ under the action of ${A}^{T}$ must be $\\text{Col}({A}^{T}),$ the row space of $A.$" #edb/ref 17592186045585] [17592186407278 #edb/ref 1068 #edb/ref 17592186407272 #edb/ref 17592186045585] [17592186407278 #edb/ref 1069 "q-109777" #edb/ref 17592186045585] [17592186407278 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045585] [17592186407278 #edb/ref 1071 "Which of the following subspaces must be orthogonal to $\\text{Col}(A)$ for every matrix $A?$\n\n- $\\text{Col}({A}^{T})$\n- $\\text{Null}({A}^{T})$\n- $\\text{Null}(A)$" #edb/ref 17592186045585] [17592186407278 #edb/ref 1072 #uuid "b9f78c95-881f-537a-b5e6-305264553498" #edb/ref 17592186045585] [17592186407278 #edb/ref 1074 "Recall that $\\text{Col}(A)$ consists of all linear combinations of the columns of $A$, that is, the rows of ${A}^{T}.$\n\nIf a vector is orthogonal to every linear combination of the rows of ${A}^{T},$ it must be orthogonal to each row of ${A}^{T}.$\nBut notice that when pre-multiplying a vector by ${A}^{T},$ we actually multiply each row of ${A}^{T}$ by that vector.\nSo, $\\text{Col}(A)$ must be orthogonal to the left null space of $A,$ which is $\\text{Null}({A}^{T}).$\n\nTherefore, the correct answer is \"II only.\"\n\n**Note:** In general, the four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/de/de22dd5b352e1d5be48f4b6ed3b2a4657ae623c1bd288d3464559758ea334af7.png)" #edb/ref 17592186045585] [17592186407279 #edb/ref 1068 #edb/ref 17592186407273 #edb/ref 17592186045585] [17592186407279 #edb/ref 1069 "q-109861" #edb/ref 17592186045585] [17592186407279 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045585] [17592186407279 #edb/ref 1071 "Let $A$ and $B$ be $m\\times p$ and $p\\times n$ matrices, respectively. What is the image of $\\text{Col}({B}^{T}\\,{A}^{T})$ under the action of $AB?$" #edb/ref 17592186045585] [17592186407279 #edb/ref 1072 #uuid "de769de3-3ab7-5536-ae28-2dcbd744b48f" #edb/ref 17592186045585] [17592186407279 #edb/ref 1074 "Pre-multiplying a vector $x\\in {R}^{n}$ by $AB$ gives a linear combination of the columns of $AB:$\n\n$$\n{{[\\begin{aligned}| & | & ⋯ & | \\\\ (ab)_{1} & (ab)_{2} & ⋯ & (ab)_{n} \\\\ | & | & ⋯ & |\\end{aligned}]}_{⏟}}_{AB}\\cdot {{[\\begin{aligned}{x}_{1} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}={x}_{1}[\\begin{aligned}| \\\\ (ab)_{1} \\\\ |\\end{aligned}]+{x}_{2}[\\begin{aligned}| \\\\ (ab)_{2} \\\\ |\\end{aligned}]+⋯+{x}_{n}[\\begin{aligned}| \\\\ (ab)_{n} \\\\ |\\end{aligned}]\n$$\n\nTherefore, the image of ${R}^{n}$ under the action of $AB$ must be $\\text{Col}(AB),$ the column space of $AB.$\n\nFurthermore, since $\\text{Null}(AB)$ is mapped to the zero vector $0$ by the definition of the null subspace, the image of its orthogonal complement $\\text{Col}((AB)^{T})=\\text{Col}({B}^{T}\\,{A}^{T})$ must be $\\text{Col}(AB).$\n\nThis can be schematically visualized, as shown below.\n\n![](images/88/885bf8a3061f93ad400897a7273ffe4157d22dee20b8e4ee7ebb982b1c4319bb.png)" #edb/ref 17592186045585] [17592186407280 #edb/ref 1058 #edb/ref 17592186407282 #edb/ref 17592186045585] [17592186407280 #edb/ref 1062 #uuid "453b68d4-1d9d-50c9-a90c-51c8b99946a5" #edb/ref 17592186045585] [17592186407280 #edb/ref 1063 #edb/ref 17592186407278 #edb/ref 17592186045585] [17592186407281 #edb/ref 1058 #edb/ref 17592186407284 #edb/ref 17592186045585] [17592186407281 #edb/ref 1062 #uuid "6ef8f97d-5b2a-5ab0-998f-92729ef9dc31" #edb/ref 17592186045585] [17592186407281 #edb/ref 1063 #edb/ref 17592186407277 #edb/ref 17592186045585] [17592186407282 #edb/ref 1058 #edb/ref 17592186407281 #edb/ref 17592186045585] [17592186407282 #edb/ref 1062 #uuid "6f121dc0-6e9f-506e-8370-6a73e7b21516" #edb/ref 17592186045585] [17592186407282 #edb/ref 1063 #edb/ref 17592186407275 #edb/ref 17592186045585] [17592186407283 #edb/ref 1062 #uuid "9114f2aa-68cd-5878-a5bf-ad32cd59fd29" #edb/ref 17592186045585] [17592186407283 #edb/ref 1063 #edb/ref 17592186407276 #edb/ref 17592186045585] [17592186407284 #edb/ref 1058 #edb/ref 17592186407283 #edb/ref 17592186045585] [17592186407284 #edb/ref 1062 #uuid "d8a9f51b-41b7-5b08-9832-d19d696012d7" #edb/ref 17592186045585] [17592186407284 #edb/ref 1063 #edb/ref 17592186407279 #edb/ref 17592186045585]}
