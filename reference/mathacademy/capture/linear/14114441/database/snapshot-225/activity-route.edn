#{[{:activity/course {:db/id #edb/ref 17592186046679} :activity/first-step {:db/id #edb/ref 17592186407280} :activity/id #uuid "d12b0c27-35c4-517e-8eb3-41dab352b8fa" :activity/scope {:db/id #edb/ref 17592186049887 :topic/id #uuid "1aba1eae-fe85-559f-b4fb-b8896b64623f" :topic/math-academy-id 2200} :activity/steps [{:db/id #edb/ref 17592186407280 :step/content {:db/id #edb/ref 17592186407278 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61b8af3e-3b47-5aa2-91bd-6b1c4c03c696" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II and III only" :db/id #edb/ref 17592186407251} {:answer/id #uuid "a0b64355-3c4a-5468-b79c-60409857f476" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "III only" :db/id #edb/ref 17592186407255} {:answer/id #uuid "bc41a449-214b-5c1b-8a85-1c8dc86ad746" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II only" :db/id #edb/ref 17592186407259} {:answer/id #uuid "f4e3cd61-e48f-5faf-ad9f-c294bdd8ce47" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I only" :db/id #edb/ref 17592186407268} {:answer/id #uuid "f62c90f5-3a7e-558e-82d7-d3e2ac3e06e4" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I and III only" :db/id #edb/ref 17592186407269}] :answer-field/correct {:db/id #edb/ref 17592186407259} :answer-field/id #uuid "65c8f326-9093-58bd-a6e1-bf36f4cf4e21" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407272}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b9f78c95-881f-537a-b5e6-305264553498" :question/math-academy-id "q-109777" :question/problem "Which of the following subspaces must be orthogonal to $\\text{Col}(A)$ for every matrix $A?$\n\n- $\\text{Col}({A}^{T})$\n- $\\text{Null}({A}^{T})$\n- $\\text{Null}(A)$" :question/worked-solution "Recall that $\\text{Col}(A)$ consists of all linear combinations of the columns of $A$, that is, the rows of ${A}^{T}.$\n\nIf a vector is orthogonal to every linear combination of the rows of ${A}^{T},$ it must be orthogonal to each row of ${A}^{T}.$\nBut notice that when pre-multiplying a vector by ${A}^{T},$ we actually multiply each row of ${A}^{T}$ by that vector.\nSo, $\\text{Col}(A)$ must be orthogonal to the left null space of $A,$ which is $\\text{Null}({A}^{T}).$\n\nTherefore, the correct answer is \"II only.\"\n\n**Note:** In general, the four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/de/de22dd5b352e1d5be48f4b6ed3b2a4657ae623c1bd288d3464559758ea334af7.png)"} :step/id #uuid "453b68d4-1d9d-50c9-a90c-51c8b99946a5" :step/next {:db/id #edb/ref 17592186407282}} {:db/id #edb/ref 17592186407281 :step/content {:db/id #edb/ref 17592186407277 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ad86372-161b-56b5-b9b3-67cb9855544f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0" :db/id #edb/ref 17592186407248} {:answer/id #uuid "3e4b4700-8836-57b3-a254-6685beac57ed" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\text{Null}({A}^{T})" :db/id #edb/ref 17592186407249} {:answer/id #uuid "65001b28-0435-5b9d-91ec-614c84c822e3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "{R}^{n}" :db/id #edb/ref 17592186407253} {:answer/id #uuid "bf467989-30ff-5c80-94cc-972d1936e437" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\text{Col}({A}^{T})" :db/id #edb/ref 17592186407260} {:answer/id #uuid "d63461e1-95f1-5efd-aec4-a9f50c64386c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "{R}^{m}" :db/id #edb/ref 17592186407264}] :answer-field/correct {:db/id #edb/ref 17592186407260} :answer-field/id #uuid "32cd5975-d7c1-5dd8-91de-4834a553c50c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407271}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b9c49e80-5070-56aa-b070-99b1fa2fdff3" :question/math-academy-id "q-109848" :question/problem "Let $A$ be a $m\\times n$ matrix. What is the image of ${R}^{m}$ under the action of ${A}^{T}?$" :question/worked-solution "First, notice that ${A}^{T}$ is a $n\\times m$ matrix.\n\nPre-multiplying a vector $x\\in {R}^{m}$ by ${A}^{T}$ gives a linear combination of the columns of ${A}^{T}:$\n\n$$\n{{[\\begin{aligned}| & | & ⋯ & | \\\\ {a}_{1}^{T} & {a}_{2}^{T} & ⋯ & {a}_{m}^{T} \\\\ | & | & ⋯ & |\\end{aligned}]}_{⏟}}_{{A}^{T}}\\cdot {{[\\begin{aligned}{x}_{1} \\\\ ⋮ \\\\ {x}_{m}\\end{aligned}]}_{⏟}}_{x}={x}_{1}[\\begin{aligned}| \\\\ {a}_{1}^{T} \\\\ |\\end{aligned}]+{x}_{2}[\\begin{aligned}| \\\\ {a}_{2}^{T} \\\\ |\\end{aligned}]+⋯+{x}_{m}[\\begin{aligned}| \\\\ {a}_{m}^{T} \\\\ |\\end{aligned}]\n$$\n\nTherefore, the image of ${R}^{m}$ under the action of ${A}^{T}$ must be $\\text{Col}({A}^{T}),$ the row space of $A.$"} :step/id #uuid "6ef8f97d-5b2a-5ab0-998f-92729ef9dc31" :step/next {:db/id #edb/ref 17592186407284}} {:db/id #edb/ref 17592186407282 :step/content {:db/id #edb/ref 17592186407275 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "166f24b3-2b33-5589-9ba5-efd73efdf696" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "3" :db/id #edb/ref 17592186407247} {:answer/id #uuid "794d7c6a-4727-5c98-8506-efa641e24334" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0" :db/id #edb/ref 17592186407254} {:answer/id #uuid "c4f31e2f-2172-581c-b46f-338027d98c9a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "1" :db/id #edb/ref 17592186407261} {:answer/id #uuid "de4a68e5-c938-5191-8ef4-522e158bedb4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2" :db/id #edb/ref 17592186407265} {:answer/id #uuid "f4d32fbe-6d2e-5aca-9070-ed1ab0efc4fa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "4" :db/id #edb/ref 17592186407267}] :answer-field/correct {:db/id #edb/ref 17592186407261} :answer-field/id #uuid "077cd26a-5956-5d07-8539-e101ab53d7f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407270}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5d75070f-88dd-5b20-8fec-c1f3c6de013c" :question/math-academy-id "q-109846" :question/problem "Consider a $5\\times 4$ matrix $A.$ If $\\text{dim}(\\text{Col}({A}^{T}))=3,$ then $\\text{dim}(\\text{Null}(A))=$" :question/worked-solution "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=5,$ $n=4,$ and $r=3.$ \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Null}(A)) & =n-r=4-3=1.\\end{aligned}\n$$"} :step/id #uuid "6f121dc0-6e9f-506e-8370-6a73e7b21516" :step/next {:db/id #edb/ref 17592186407281}} {:db/id #edb/ref 17592186407283 :step/content {:db/id #edb/ref 17592186407276 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e0fd37b-833c-5581-bf94-abc93beffe65" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "6" :db/id #edb/ref 17592186407246} {:answer/id #uuid "6203c04e-a6ad-568e-b086-f63c9a0600d1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "3" :db/id #edb/ref 17592186407252} {:answer/id #uuid "a5ba999d-5dc0-5e42-af53-78dc73ee4de4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "1" :db/id #edb/ref 17592186407256} {:answer/id #uuid "ba9ba337-a858-55b1-bf28-9f915ba4dcc2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2" :db/id #edb/ref 17592186407258} {:answer/id #uuid "e18de25a-171d-5acb-88a3-6812297610fa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "5" :db/id #edb/ref 17592186407266}] :answer-field/correct {:db/id #edb/ref 17592186407258} :answer-field/id #uuid "e82e089a-caba-5439-8d15-a646e7c8e9fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407274}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "66ca173a-d952-58d1-b484-502590c17693" :question/math-academy-id "q-109873" :question/problem "Consider a $5\\times 6$ matrix $A.$ If $\\text{dim}(\\text{Col}({A}^{T}))=3,$ then $\\text{dim}(\\text{Null}({A}^{T}))=$" :question/worked-solution "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=5,$ $n=6,$ and $r=3.$ \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Null}({A}^{T})) & =m-r=5-3=2.\\end{aligned}\n$$"} :step/id #uuid "9114f2aa-68cd-5878-a5bf-ad32cd59fd29"} {:db/id #edb/ref 17592186407284 :step/content {:db/id #edb/ref 17592186407279 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d3a4ec2-bd1c-569f-bc25-a735fbf6e8f7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0" :db/id #edb/ref 17592186407245} {:answer/id #uuid "4624e774-8f8e-50d7-922a-9f2511cb84dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\text{Null}(AB)" :db/id #edb/ref 17592186407250} {:answer/id #uuid "ab8461c5-2db5-555b-98b8-ef3d5aadb4ce" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\text{Col}({B}^{T}{A}^{T})" :db/id #edb/ref 17592186407257} {:answer/id #uuid "ca1a752d-a1b9-5c75-a6eb-005f23fda936" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\text{Null}({B}^{T}{A}^{T})" :db/id #edb/ref 17592186407262} {:answer/id #uuid "cafe991c-8437-5728-ad05-fe57c0cef2d4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\text{Col}(AB)" :db/id #edb/ref 17592186407263}] :answer-field/correct {:db/id #edb/ref 17592186407263} :answer-field/id #uuid "a14d9fc2-b7d8-5af8-b07b-319f63dc6ba1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407273}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "de769de3-3ab7-5536-ae28-2dcbd744b48f" :question/math-academy-id "q-109861" :question/problem "Let $A$ and $B$ be $m\\times p$ and $p\\times n$ matrices, respectively. What is the image of $\\text{Col}({B}^{T}\\,{A}^{T})$ under the action of $AB?$" :question/worked-solution "Pre-multiplying a vector $x\\in {R}^{n}$ by $AB$ gives a linear combination of the columns of $AB:$\n\n$$\n{{[\\begin{aligned}| & | & ⋯ & | \\\\ (ab)_{1} & (ab)_{2} & ⋯ & (ab)_{n} \\\\ | & | & ⋯ & |\\end{aligned}]}_{⏟}}_{AB}\\cdot {{[\\begin{aligned}{x}_{1} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}={x}_{1}[\\begin{aligned}| \\\\ (ab)_{1} \\\\ |\\end{aligned}]+{x}_{2}[\\begin{aligned}| \\\\ (ab)_{2} \\\\ |\\end{aligned}]+⋯+{x}_{n}[\\begin{aligned}| \\\\ (ab)_{n} \\\\ |\\end{aligned}]\n$$\n\nTherefore, the image of ${R}^{n}$ under the action of $AB$ must be $\\text{Col}(AB),$ the column space of $AB.$\n\nFurthermore, since $\\text{Null}(AB)$ is mapped to the zero vector $0$ by the definition of the null subspace, the image of its orthogonal complement $\\text{Col}((AB)^{T})=\\text{Col}({B}^{T}\\,{A}^{T})$ must be $\\text{Col}(AB).$\n\nThis can be schematically visualized, as shown below.\n\n![](images/88/885bf8a3061f93ad400897a7273ffe4157d22dee20b8e4ee7ebb982b1c4319bb.png)"} :step/id #uuid "d8a9f51b-41b7-5b08-9832-d19d696012d7" :step/next {:db/id #edb/ref 17592186407283}}] :activity/title "The Four Fundamental Subspaces of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186407244}]}
