56-5d07-8539-e101ab53d7f4" :answer-field/id #uuid "077cd26a-5956-5d07-8539-e101ab53d7f4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c4f31e2f-2172-581c-b46f-338027d98c9a" :answer-field/choices ["answer-794d7c6a-4727-5c98-8506-efa641e24334" "answer-c4f31e2f-2172-581c-b46f-338027d98c9a" "answer-de4a68e5-c938-5191-8ef4-522e158bedb4" "answer-166f24b3-2b33-5589-9ba5-efd73efdf696" "answer-f4d32fbe-6d2e-5aca-9070-ed1ab0efc4fa"] :db/ensure [:answer-field/validate]} {:db/id "answer-794d7c6a-4727-5c98-8506-efa641e24334" :answer/id #uuid "794d7c6a-4727-5c98-8506-efa641e24334" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-c4f31e2f-2172-581c-b46f-338027d98c9a" :answer/id #uuid "c4f31e2f-2172-581c-b46f-338027d98c9a" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-de4a68e5-c938-5191-8ef4-522e158bedb4" :answer/id #uuid "de4a68e5-c938-5191-8ef4-522e158bedb4" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-166f24b3-2b33-5589-9ba5-efd73efdf696" :answer/id #uuid "166f24b3-2b33-5589-9ba5-efd73efdf696" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-f4d32fbe-6d2e-5aca-9070-ed1ab0efc4fa" :answer/id #uuid "f4d32fbe-6d2e-5aca-9070-ed1ab0efc4fa" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186133894 :knowledge-point/questions ["question-b9c49e80-5070-56aa-b070-99b1fa2fdff3" "question-de769de3-3ab7-5536-ae28-2dcbd744b48f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b9c49e80-5070-56aa-b070-99b1fa2fdff3" :question/id #uuid "b9c49e80-5070-56aa-b070-99b1fa2fdff3" :question/math-academy-id "q-109848" :question/problem "Let $A$ be a $m\\times n$ matrix. What is the image of ${R}^{m}$ under the action of ${A}^{T}?$" :question/worked-solution "First, notice that ${A}^{T}$ is a $n\\times m$ matrix.\n\nPre-multiplying a vector $x\\in {R}^{m}$ by ${A}^{T}$ gives a linear combination of the columns of ${A}^{T}:$\n\n$$\n{{[\\begin{aligned}| & | & ⋯ & | \\\\ {a}_{1}^{T} & {a}_{2}^{T} & ⋯ & {a}_{m}^{T} \\\\ | & | & ⋯ & |\\end{aligned}]}_{⏟}}_{{A}^{T}}\\cdot {{[\\begin{aligned}{x}_{1} \\\\ ⋮ \\\\ {x}_{m}\\end{aligned}]}_{⏟}}_{x}={x}_{1}[\\begin{aligned}| \\\\ {a}_{1}^{T} \\\\ |\\end{aligned}]+{x}_{2}[\\begin{aligned}| \\\\ {a}_{2}^{T} \\\\ |\\end{aligned}]+⋯+{x}_{m}[\\begin{aligned}| \\\\ {a}_{m}^{T} \\\\ |\\end{aligned}]\n$$\n\nTherefore, the image of ${R}^{m}$ under the action of ${A}^{T}$ must be $\\text{Col}({A}^{T}),$ the row space of $A.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-32cd5975-d7c1-5dd8-91de-4834a553c50c"] :db/ensure [:question/validate]} {:db/id "answer-field-32cd5975-d7c1-5dd8-91de-4834a553c50c" :answer-field/id #uuid "32cd5975-d7c1-5dd8-91de-4834a553c50c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bf467989-30ff-5c80-94cc-972d1936e437" :answer-field/choices ["answer-2ad86372-161b-56b5-b9b3-67cb9855544f" "answer-bf467989-30ff-5c80-94cc-972d1936e437" "answer-3e4b4700-8836-57b3-a254-6685beac57ed" "answer-d63461e1-95f1-5efd-aec4-a9f50c64386c" "answer-65001b28-0435-5b9d-91ec-614c84c822e3"] :db/ensure [:answer-field/validate]} {:db/id "answer-2ad86372-161b-56b5-b9b3-67cb9855544f" :answer/id #uuid "2ad86372-161b-56b5-b9b3-67cb9855544f" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-bf467989-30ff-5c80-94cc-972d1936e437" :answer/id #uuid "bf467989-30ff-5c80-94cc-972d1936e437" :answer/type :answer.type/math :answer/value "\\text{Col}({A}^{T})" :db/ensure [:answer/validate]} {:db/id "answer-3e4b4700-8836-57b3-a254-6685beac57ed" :answer/id #uuid "3e4b4700-8836-57b3-a254-6685beac57ed" :answer/type :answer.type/math :answer/value "\\text{Null}({A}^{T})" :db/ensure [:answer/validate]} {:db/id "answer-d63461e1-95f1-5efd-aec4-a9f50c64386c" :answer/id #uuid "d63461e1-95f1-5efd-aec4-a9f50c64386c" :answer/type :answer.type/math :answer/value "{R}^{m}" :db/ensure [:answer/validate]} {:db/id "answer-65001b28-0435-5b9d-91ec-614c84c822e3" :answer/id #uuid "65001b28-0435-5b9d-91ec-614c84c822e3" :answer/type :answer.type/math :answer/value "{R}^{n}" :db/ensure [:answer/validate]} {:db/id "question-de769de3-3ab7-5536-ae28-2dcbd744b48f" :question/id #uuid "de769de3-3ab7-5536-ae28-2dcbd744b48f" :question/math-academy-id "q-109861" :question/problem "Let $A$ and $B$ be $m\\times p$ and $p\\times n$ matrices, respectively. What is the image of $\\text{Col}({B}^{T}\\,{A}^{T})$ under the action of $AB?$" :question/worked-solution "Pre-multiplying a vector $x\\in {R}^{n}$ by $AB$ gives a linear combination of the columns of $AB:$\n\n$$\n{{[\\begin{aligned}| & | & ⋯ & | \\\\ (ab)_{1} & (ab)_{2} & ⋯ & (ab)_{n} \\\\ | & | & ⋯ & |\\end{aligned}]}_{⏟}}_{AB}\\cdot {{[\\begin{aligned}{x}_{1} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}={x}_{1}[\\begin{aligned}| \\\\ (ab)_{1} \\\\ |\\end{aligned}]+{x}_{2}[\\begin{aligned}| \\\\ (ab)_{2} \\\\ |\\end{aligned}]+⋯+{x}_{n}[\\begin{aligned}| \\\\ (ab)_{n} \\\\ |\\end{aligned}]\n$$\n\nTherefore, the image of ${R}^{n}$ under the action of $AB$ must be $\\text{Col}(AB),$ the column space of $AB.$\n\nFurthermore, since $\\text{Null}(AB)$ is mapped to the zero vector $0$ by the definition of the null subspace, the image of its orthogonal complement $\\text{Col}((AB)^{T})=\\text{Col}({B}^{T}\\,{A}^{T})$ must be $\\text{Col}(AB).$\n\nThis can be schematically visualized, as shown below.\n\n![](images/88/885bf8a3061f93ad400897a7273ffe4157d22dee20b8e4ee7ebb982b1c4319bb.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-a14d9fc2-b7d8-5af8-b07b-319f63dc6ba1"] :db/ensure [:question/validate]} {:db/id "answer-field-a14d9fc2-b7d8-5af8-b07b-319f63dc6ba1" :answer-field/id #uuid "a14d9fc2-b7d8-5af8-b07b-319f63dc6ba1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cafe991c-8437-5728-ad05-fe57c0cef2d4" :answer-field/choices ["answer-0d3a4ec2-bd1c-569f-bc25-a735fbf6e8f7" "answer-cafe991c-8437-5728-ad05-fe57c0cef2d4" "answer-ab8461c5-2db5-555b-98b8-ef3d5aadb4ce" "answer-4624e774-8f8e-50d7-922a-9f2511cb84dc" "answer-ca1a752d-a1b9-5c75-a6eb-005f23fda936"] :db/ensure [:answer-field/validate]} {:db/id "answer-0d3a4ec2-bd1c-569f-bc25-a735fbf6e8f7" :answer/id #uuid "0d3a4ec2-bd1c-569f-bc25-a735fbf6e8f7" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-cafe991c-8437-5728-ad05-fe57c0cef2d4" :answer/id #uuid "cafe991c-8437-5728-ad05-fe57c0cef2d4" :answer/type :answer.type/math :answer/value "\\text{Col}(AB)" :db/ensure [:answer/validate]} {:db/id "answer-ab8461c5-2db5-555b-98b8-ef3d5aadb4ce" :answer/id #uuid "ab8461c5-2db5-555b-98b8-ef3d5aadb4ce" :answer/type :answer.type/math :answer/value "\\text{Col}({B}^{T}{A}^{T})" :db/ensure [:answer/validate]} {:db/id "answer-4624e774-8f8e-50d7-922a-9f2511cb84dc" :answer/id #uuid "4624e774-8f8e-50d7-922a-9f2511cb84dc" :answer/type :answer.type/math :answer/value "\\text{Null}(AB)" :db/ensure [:answer/validate]} {:db/id "answer-ca1a752d-a1b9-5c75-a6eb-005f23fda936" :answer/id #uuid "ca1a752d-a1b9-5c75-a6eb-005f23fda936" :answer/type :answer.type/math :answer/value "\\text{Null}({B}^{T}{A}^{T})" :db/ensure [:answer/validate]} {:db/id "question-66ca173a-d952-58d1-b484-502590c17693" :question/id #uuid "66ca173a-d952-58d1-b484-502590c17693" :question/math-academy-id "q-109873" :question/problem "Consider a $5\\times 6$ matrix $A.$ If $\\text{dim}(\\text{Col}({A}^{T}))=3,$ then $\\text{dim}(\\text{Null}({A}^{T}))=$" :question/worked-solution "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=5,$ $n=6,$ and $r=3.$ \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Null}({A}^{T})) & =m-r=5-3=2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e82e089a-caba-5439-8d15-a646e7c8e9fa"] :db/ensure [:question/validate]} {:db/id "answer-field-e82e089a-caba-5439-8d15-a646e7c8e9fa" :answer-field/id #uuid "e82e089a-caba-5439-8d15-a646e7c8e9fa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ba9ba337-a858-55b1-bf28-9f915ba4dcc2" :answer-field/choices ["answer-a5ba999d-5dc0-5e42-af53-78dc73ee4de4" "answer-ba9ba337-a858-55b1-bf28-9f915ba4dcc2" "answer-6203c04e-a6ad-568e-b086-f63c9a0600d1" "answer-e18de25a-171d-5acb-88a3-6812297610fa" "answer-0e0fd37b-833c-5581-bf94-abc93beffe65"] :db/ensure [:answer-field/validate]} {:db/id "answer-a5ba999d-5dc0-5e42-af53-78dc73ee4de4" :answer/id #uuid "a5ba999d-5dc0-5e42-af53-78dc73ee4de4" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-ba9ba337-a858-55b1-bf28-9f915ba4dcc2" :answer/id #uuid "ba9ba337-a858-55b1-bf28-9f915ba4dcc2" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-6203c04e-a6ad-568e-b086-f63c9a0600d1" :answer/id #uuid "6203c04e-a6ad-568e-b086-f63c9a0600d1" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-e18de25a-171d-5acb-88a3-6812297610fa" :answer/id #uuid "e18de25a-171d-5acb-88a3-6812297610fa" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-0e0fd37b-833c-5581-bf94-abc93beffe65" :answer/id #uuid "0e0fd37b-833c-5581-bf94-abc93beffe65" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "activity-d12b0c27-35c4-517e-8eb3-41dab352b8fa" :activity/id #uuid "d12b0c27-35c4-517e-8eb3-41dab352b8fa" :activity/title "The Four Fundamental Subspaces of a Matrix" :activity/type :act