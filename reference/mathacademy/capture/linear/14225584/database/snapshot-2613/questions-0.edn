#{[{:db/id #edb/ref 17592186110490 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110589 :knowledge-point/id #uuid "48581e81-b2de-5be0-9e97-1057bedc16f3" :knowledge-point/title "Separating a Logarithm Into Two Logarithms Using the Quotient Rule"}] :question/id #uuid "85379129-7b9e-507f-b70a-841c868cfa15" :question/math-academy-id "e-4020" :question/problem "Express $\\log_3\\left(\\dfrac{2}{5}\\right)$ as a difference of logarithms." :question/worked-solution "First, let's recall the quotient rule for logarithms:\n\n$$\n\\log_n(a) - \\log_n(b) = \\log_n\\left( \\dfrac{a}{b} \\right)\n$$\n\nUsing the quotient rule for logarithms, we obtain\n\n$$\n\\begin{aligned}{log}_{3}⁡(\\frac{2}{5}) & ={log}_{3}⁡(2)-{log}_{3}⁡(5).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186110491 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110590 :knowledge-point/id #uuid "7c0acf69-d973-56b7-bdb3-a5804709c6da" :knowledge-point/title "Combining Logarithms Using the Quotient Rule"}] :question/id #uuid "8a8c6256-216f-5516-ac07-80311c557f4b" :question/math-academy-id "e-4022" :question/problem "Write $\\log_5(16) - \\log_5(8)$ as a single logarithm." :question/worked-solution "First, let's recall the quotient rule for logarithms:\n\n$$\n\\log_n(a) - \\log_n(b) = \\log_n\\left( \\dfrac{a}{b} \\right)\n$$\n\nUsing the quotient rule for logarithms, the given expression can be rewritten as\n\n$$\n\\begin{aligned}{log}_{5}⁡(16)-{log}_{5}⁡(8) & ={log}_{5}⁡(\\frac{16}{8}) \\\\  & ={log}_{5}⁡(2).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186110492 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110591 :knowledge-point/id #uuid "1da4785a-0124-517b-9dba-ba012853b83a" :knowledge-point/title "Combining Logarithms With Coefficients Using the Quotient Rule"}] :question/id #uuid "23ccceb8-73ee-58c7-9787-ae1eb6b3f53f" :question/math-academy-id "e-4023" :question/problem "Express $2\\log_2(25) - 2\\log_2(5)$ as a single logarithm." :question/worked-solution "First, let's recall the quotient rule for logarithms:\n\n$$\n\\log_n(a) - \\log_n(b) = \\log_n\\left( \\dfrac{a}{b} \\right)\n$$\n\nIf we factor the given expression and use the quotient rule for logarithms, we get\n\n$$\n\\begin{aligned}2{log}_{2}⁡(25)-2{log}_{2}⁡(5) & =2({log}_{2}⁡(25)-{log}_{2}⁡(5)) \\\\  & =2({log}_{2}⁡(\\frac{25}{5})) \\\\  & =2{log}_{2}⁡(5).\\end{aligned}\n$$\n\nTherefore,\n\n$$\n2\\log_2(25) - 2\\log_2(5) = 2\\log_2(5).\n$$"}] [{:db/id #edb/ref 17592186110493 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110592 :knowledge-point/id #uuid "543da446-8e2b-5978-b5fd-886a3b89e57c" :knowledge-point/title "Evaluating an Expression Using the Quotient Rule"}] :question/id #uuid "85ee2fdc-9c05-5795-bcdf-adb3a871cc5a" :question/math-academy-id "e-4025" :question/problem "If $\\ln (p) =6$ and $\\ln (q) = 4$, then $\\ln \\left(\\dfrac p q\\right)=$" :question/worked-solution "First, let's recall the quotient rule for natural logarithms:\n\n$$\n\\ln(a) - \\ln(b) = \\ln\\left( \\dfrac{a}{b} \\right)\n$$\n\nUsing the quotient rule for natural logarithms, we have\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(\\frac{p}{q}) & =\\operatorname{ln}⁡(p)-\\operatorname{ln}⁡(q) \\\\  & =6-4 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186543547 :knowledge-point/_questions [{:db/id #edb/ref 17592186110592 :knowledge-point/id #uuid "543da446-8e2b-5978-b5fd-886a3b89e57c" :knowledge-point/title "Evaluating an Expression Using the Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06386582-1858-5b59-a352-479a8fbec1ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k-m" :db/id #edb/ref 17592186542651} {:answer/id #uuid "a7595e68-63e0-55b4-9190-55fd9ad8ee38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k+m" :db/id #edb/ref 17592186543080} {:answer/id #uuid "c8679008-38bf-5c0c-91af-6a3638018d35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k}{m}" :db/id #edb/ref 17592186543162} {:answer/id #uuid "e5e08e8d-ec38-59a8-94ea-46959cbfc389" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "km" :db/id #edb/ref 17592186543225} {:answer/id #uuid "ed27e2cf-d889-5413-8f07-fe2a732afd99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "m-k" :db/id #edb/ref 17592186543243}] :answer-field/correct {:answer/id #uuid "06386582-1858-5b59-a352-479a8fbec1ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k-m" :db/id #edb/ref 17592186542651} :answer-field/id #uuid "54df9ca0-9526-59ba-8d0c-624262e20b11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543342}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ada9c1dd-522d-5138-9cfe-44ee7af19872" :question/math-academy-id "q-108201" :question/problem "If $\\operatorname{log}⁡(y)=k$ and $\\operatorname{log}⁡(\\frac{y}{x})=m$, then $\\operatorname{log}⁡(x)=$" :question/worked-solution "First, let's recall the quotient rule for logarithms:\n\n$$\n{log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})\n$$\n\nUsing the quotient rule for logarithms, we have\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(x) & =\\operatorname{log}⁡(\\frac{y}{(\\frac{y}{x})}) \\\\  & =\\operatorname{log}⁡(y)-\\operatorname{log}⁡(\\frac{y}{x}) \\\\  & =k-m.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186543532 :knowledge-point/_questions [{:db/id #edb/ref 17592186110592 :knowledge-point/id #uuid "543da446-8e2b-5978-b5fd-886a3b89e57c" :knowledge-point/title "Evaluating an Expression Using the Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ab9f307-2949-509c-aa21-cb7f2f79269e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math}