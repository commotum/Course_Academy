(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})\n$$\n\nUsing the quotient rule for logarithms, the given expression can be rewritten as:\n\n$$\n\\begin{aligned}{log}_{2}⁡({x}^{3})-{log}_{2}⁡(x) & ={log}_{2}⁡(\\frac{{x}^{3}}{x}) \\\\  & ={log}_{2}⁡({x}^{2})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186543483 :knowledge-point/_questions [{:db/id #edb/ref 17592186110589 :knowledge-point/id #uuid "48581e81-b2de-5be0-9e97-1057bedc16f3" :knowledge-point/title "Separating a Logarithm Into Two Logarithms Using the Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fdf82a0-2583-54a3-bd7d-1ee3403c2774" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3}⁡(y)-{log}_{3}⁡(x)" :db/id #edb/ref 17592186542727} {:answer/id #uuid "31ee8031-ab23-5347-a954-5922df481593" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3}⁡(x)\\cdot {log}_{3}⁡(y)" :db/id #edb/ref 17592186542772} {:answer/id #uuid "7f80c10e-5297-5c3f-976a-b2a1b6bb66bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{log}_{3}⁡(x)}{{log}_{3}⁡(y)}" :db/id #edb/ref 17592186542983} {:answer/id #uuid "b25d0d08-c661-51ef-9ff7-c14e5da09762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3}⁡(x)+{log}_{3}⁡(y)" :db/id #edb/ref 17592186543104} {:answer/id #uuid "ecc6e0b1-d90c-5f5b-9ef7-e7b55fb39ddf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3}⁡(x)-{log}_{3}⁡(y)" :db/id #edb/ref 17592186543239}] :answer-field/correct {:answer/id #uuid "ecc6e0b1-d90c-5f5b-9ef7-e7b55fb39ddf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{3}⁡(x)-{log}_{3}⁡(y)" :db/id #edb/ref 17592186543239} :answer-field/id #uuid "058dd5c5-0df5-5561-a280-d0460c220852" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :d