#{[{:db/id #edb/ref 17592186110490 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110589 :knowledge-point/id #uuid "48581e81-b2de-5be0-9e97-1057bedc16f3" :knowledge-point/title "Separating a Logarithm Into Two Logarithms Using the Quotient Rule"}] :question/id #uuid "85379129-7b9e-507f-b70a-841c868cfa15" :question/math-academy-id "e-4020" :question/problem "Express $\\log_3\\left(\\dfrac{2}{5}\\right)$ as a difference of logarithms." :question/worked-solution "First, let's recall the quotient rule for logarithms:\n\n$$\n\\log_n(a) - \\log_n(b) = \\log_n\\left(\\dfrac{a}{b} \\right)\n$$\n\nUsing the quotient rule for logarithms, we obtain\n\n$$\n\\begin{aligned}\n\\log_{3} (\\frac{2}{5}) &= \\log_{3} (2) - \\log_{3} (5)\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186110491 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110590 :knowledge-point/id #uuid "7c0acf69-d973-56b7-bdb3-a5804709c6da" :knowledge-point/title "Combining Logarithms Using the Quotient Rule"}] :question/id #uuid "8a8c6256-216f-5516-ac07-80311c557f4b" :question/math-academy-id "e-4022" :question/problem "Write $\\log_5(16) - \\log_5(8)$ as a single logarithm." :question/worked-solution "First, let's recall the quotient rule for logarithms:\n\n$$\n\\log_n(a) - \\log_n(b) = \\log_n\\left(\\dfrac{a}{b} \\right)\n$$\n\nUsing the quotient rule for logarithms, the given expression can be rewritten as\n\n$$\n\\begin{aligned}\n\\log_{5} (16) - \\log_{5} (8) &= \\log_{5} (\\frac{16}{8}) \\\\\n&= \\log_{5} (2)\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186110492 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110591 :knowledge-point/id #uuid "1da4785a-0124-517b-9dba-ba012853b83a" :knowledge-point/title "Combining Logarithms With Coefficients Using the Quotient Rule"}] :question/id #uuid "23ccceb8-73ee-58c7-9787-ae1eb6b3f53f" :question/math-academy-id "e-4023" :question/problem "Express $2\\log_2(25) - 2\\log_2(5)$ as a single logarithm." :question/worked-solution "First, let's recall the quotient rule for logarithms:\n\n$$\n\\log_n(a) - \\log_n(b) = \\log_n\\left(\\dfrac{a}{b} \\right)\n$$\n\nIf we factor the given expression and use the quotient rule for logarithms, we get\n\n$$\n\\begin{aligned}\n2\\log_{2} (25) - 2\\log_{2} (5) &= 2(\\log_{2} (25) - \\log_{2} (5)) \\\\\n&= 2(\\log_{2} (\\frac{25}{5})) \\\\\n&= 2\\log_{2} (5)\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n2\\log_2(25) - 2\\log_2(5) = 2\\log_2(5)\n$$"}] [{:db/id #edb/ref 17592186110493 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110592 :knowledge-point/id #uuid "543da446-8e2b-5978-b5fd-886a3b89e57c" :knowledge-point/title "Evaluating an Expression Using the Quotient Rule"}] :question/id #uuid "85ee2fdc-9c05-5795-bcdf-adb3a871cc5a" :question/math-academy-id "e-4025" :question/problem "If $\\ln (p) =6$ and $\\ln (q) = 4$, then $\\ln \\left(\\dfrac p q\\right)=$" :question/worked-solution "First, let's recall the quotient rule for natural logarithms:\n\n$$\n\\ln(a) - \\ln(b) = \\ln\\left(\\dfrac{a}{b} \\right)\n$$\n\nUsing the quotient rule for natural logarithms, we have\n\n$$\n\\begin{aligned}\n\\ln (\\frac{p}{q}) &= \\ln (p) - \\ln (q) \\\\\n&= 6 - 4 \\\\\n&= 2\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186111055 :knowledge-point/_questions [{:db/id #edb/ref 17592186110590 :knowledge-point/id #uuid "7c0acf69-d973-56b7-bdb3-a5804709c6da" :knowledge-point/title "Combining Logarithms Using the Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8bc2e314-530b-5c99-b867-8c746ff233ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{2} (x^{3})" :db/id #edb/ref 17592186108088} {:answer/id #uuid "cf9f701a-2c89-58f1-8513-1fbcc9dcbd3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{2} (x^{2})" :db/id #edb/ref 17592186108089} {:answer/id #uuid "fa2dfa46-4cd8-5c2e-b727-08a07f473270" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{2} (x^{3} - x)" :db/id #edb/ref 17592186108090} {:answer/id #uuid "1fede3ca-6f20-55c2-804f-4d8875bacd49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{2} (x^{3} + x)" :db/id #edb/ref 17592186108091} {:answer/id #uuid "3cfeeb9e-da9c-5684-b0c2-79169ed3c51b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{2} (x)" :db/id #edb/ref 17592186108092}] :answer-field/id #uuid "8e31e373-15da-5c90-abf8-352f69c53e7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186108087}] :question/id #uuid "1ffe9f61-1ba3-54d9-b9af-4cad3fb8f150" :question/math-academy-id "q-25233" :question/problem "Express $\\log_{2} (x^{3}) - \\log_{2} (x)$ as a single logarithm."}] [{:db/id #edb/ref 17592186111217 :knowledge-point/_questions [{:db/id #edb/ref 17592186110589 :knowledge-point/id #uuid "48581e81-b2de-5be0-9e97-1057bedc16f3" :knowledge-point/title "Separating a Logarithm Into Two Logarithms Using the Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90cf8135-6a98-5dfe-bdb4-9aca22eb3896" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 - \\ln (8)" :db/id #edb/ref 17592186109028} {:answer/id #uuid "e5beb6b9-4d4a-5769-a5e2-28fd8b4c5270" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln (8) - 3" :db/id #edb/ref 17592186109029} {:answer/id #uuid "eb7c32b3-1fd0-5409-b065-3fa93463acf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3)/(\\ln (8))" :db/id #edb/ref 17592186109030} {:answer/id #uuid "6c18d351-3f78-5dd8-aba8-44c6c2afbb28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(e)/(\\ln (8))" :db/id #edb/ref 17592186109031} {:answer/id #uuid "7add5574-51a0-52f7-895e-1ca48714b975" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e - \\ln (8)" :db/id #edb/ref 17592186109032}] :answer-field/id #uuid "1171bfe8-4dba-5123-b25c-20e86f721ab8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186109027}] :question/id #uuid "46d440a6-1c70-56f2-8920-e5415a5e3165" :question/math-academy-id "q-47298" :question/problem "What is $\\ln (\\frac{e^{3}}{8})$?"}] [{:db/id #edb/ref 17592186234207 :knowledge-point/_questions [{:db/id #edb/ref 17592186110591 :knowledge-point/id #uuid "1da4785a-0124-517b-9dba-ba012853b83a" :knowledge-point/title "Combining Logarithms With Coefficients Using the Quotient Rule"}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f70da637-39bf-585b-b7da-8cee169442e1" :question/math-academy-id "q-66772" :question/problem "$6{log}_{5}(100)-6{log}_{5}(4)=$" :question/worked-solution "First, let's recall the quotient rule for logarithms:\n\n$$\n{log}_{n}(a)-{log}_{n}(b)={log}_{n}(\\frac{a}{b})\n$$\n\nIf we factor the given expression and use the quotient rule for logarithms, we get:\n\n$$\n\\begin{aligned}6{log}_{5}(100)-6{log}_{5}(4) & =6({log}_{5}(100)-{log}_{5}(4)) \\\\  & =6{log}_{5}(\\frac{100}{4}) \\\\  & =6{log}_{5}(25)\\end{aligned}\n$$\n\nNow, since ${5}^{2}=25$, then ${log}_{5}(25)={log}_{5}({5}^{2})=2.$ Therefore:\n\n$$\n6{log}_{5}(25)=6\\cdot 2=12.\n$$"}]}
