e4d-208c-5ed7-aabe-77c31967fea9" :answer/id #uuid "98b48e4d-208c-5ed7-aabe-77c31967fea9" :answer/type :answer.type/math :answer/value "\\frac{5}{6}\\times \\frac{6}{12}" :db/ensure [:answer/validate]} {:db/id "answer-62aece08-e1dd-5dc8-a651-c6d0fd49b34d" :answer/id #uuid "62aece08-e1dd-5dc8-a651-c6d0fd49b34d" :answer/type :answer.type/math :answer/value "\\frac{6}{5}\\times \\frac{5}{12}" :db/ensure [:answer/validate]} {:db/id "question-a80469df-5371-5771-a53c-6877f0cc2ac2" :question/id #uuid "a80469df-5371-5771-a53c-6877f0cc2ac2" :question/math-academy-id "q-195599" :question/problem "What fraction is missing from the statement below?\n\n$\\frac{5}{4}\\times \\frac{9}{10}=$\n{{field-1}}\n$\\times \\,\\frac{9}{4}$" :question/worked-solution "Interpreting the fractions as division, we get\n\n$$\n\\frac{5}{4}\\times \\frac{9}{10}=(5÷4)\\times (9÷10).\n$$\n\nThen, our expression is\n\n$$\n(5\\,÷\\,4)\\times (9\\,÷\\,10).\n$$\n\nSince our expression contains multiplication and division only, we can write an equivalent expression by swapping the $÷\\,4$ and the $÷\\,10$:\n\n$$\n(5\\,÷\\,10)\\times (9\\,÷\\,4)\n$$\n\nWe can now interpret the divisions as fractions:\n\n$$\n\\frac{5}{10}\\times \\frac{9}{4}\n$$\n\nSo the missing factor is $\\frac{5}{10}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c54d245e-17a7-5113-88c7-9a4ce20205e5"] :db/ensure [:question/validate]} {:db/id "answer-field-c54d245e-17a7-5113-88c7-9a4ce20205e5" :answer-field/id #uuid "c54d245e-17a7-5113-88c7-9a4ce20205e5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-abb0f93d-7294-5dfb-9e3e-41eb24d7f7cb" :answer-field/choices ["answer-abb0f93d-7294-5dfb-9e3e-41eb24d7f7cb"] :db/ensure [:answer-field/validate]} {:db/id "answer-abb0f93d-7294-5dfb-9e3e-41eb24d7f7cb" :answer/id #uuid "abb0f93d-7294-5dfb-9e3e-41eb24d7f7cb" :answer/type :answer.type/math :answer/value "\\frac{5}{10}" :db/ensure [:answer/validate]} {:db/id "question-36cbce10-7136-5dc9-8dd6-df6f370a71a6" :question/id #uuid "36cbce10-7136-5dc9-8dd6-df6f370a71a6" :question/math-academy-id "q-195616" :question/problem "Expressed as an integer, $\\frac{35}{6}\\times \\frac{18}{7}=${{field-1}}." :question/worked-solution "Interpreting the fractions as division, we get\n\n$$\n(35\\,÷\\,6)\\times (18\\,÷\\,7).\n$$\n\n \n\nSince our expression contains multiplication and division only, we can create an equivalent expression by swapping the $÷\\,6$ and $÷\\,7$:\n\n$$\n(35\\,÷\\,7)\\times (18\\,÷\\,6)\n$$\n\n \n\nInterpreting the divisions as fractions, we get\n\n$$\n\\frac{35}{7}\\times \\frac{18}{6}.\n$$\n\nCarrying out the divisions, we arrive at\n\n$$\n\\begin{aligned}{{\\frac{35}{7}}_{⏟}}_{5}\\times {{\\frac{18}{6}}_{⏟}}_{3}=5\\times 3=15.\\end{aligned}\n$$\n\nTherefore, $\\frac{35}{6}\\times \\frac{18}{7}=15.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-f6d2e9ad-b4e5-5278-b6a7-178a56d479ff"] :db/ensure [:question/validate]} {:db/id "answer-field-f6d2e9ad-b4e5-5278-b6a7-178a56d479ff" :answer-field/id #uuid "f6d2e9ad-b4e5-5278-b6a7-178a56d479ff" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-bff0f413-a5b9-5bdb-a906-8c4ce718f4c5" :answer-field/choices ["answer-bff0f413-a5b9-5bdb-a906-8c4ce718f4c5"] :db/ensure [:answer-field/validate]} {:db/id "answer-bff0f413-a5b9-5bdb-a906-8c4ce718f4c5" :answer/id #uuid "bff0f413-a5b9-5bdb-a906-8c4ce718f4c5" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "question-27a694ea-4a25-512f-a531-3c15a047f01c" :question/id #uuid "27a694ea-4a25-512f-a531-3c15a047f01c" :question/math-academy-id "q-61684" :question/problem "$\\frac{15}{4}\\times \\frac{16}{3}=$" :question/worked-solution "Interpreting the fractions as division, we get\n\n$$\n(15\\,÷\\,4)\\times (16\\,÷\\,3).\n$$\n\n \n\nSince our expression contains multiplication and division only, we can create an equivalent expression by swapping the $÷\\,4$ and $÷\\,3$:\n\n \n\n$$\n(15\\,÷\\,3)\\times (16\\,÷\\,4)\n$$\n\n \n\nInterpreting the divisions as fractions, we get\n\n$$\n\\frac{15}{3}\\times \\frac{16}{4}.\n$$\n\nCarrying out the divisions, we arrive at\n\n$$\n\\begin{aligned}{{\\frac{15}{3}}_{⏟}}_{5}\\times {{\\frac{16}{4}}_{⏟}}_{4}=5\\times 4=20.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9bee491f-7dd5-5e20-b7cd-84156c8102f8"] :db/ensure [:question/validate]} {:db/id "answer-field-9bee491f-7dd5-5e20-b7cd-84156c8102f8" :answer-field/id #uuid "9bee491f-7dd5-5e20-b7cd-84156c8102f8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5c732ae2-b8c2-5cef-81f4-7f6697c28fb4" :answer-field/choices ["answer-3bb73056-9bb2-5c81-af79-24007bd492a5" "answer-c7b89e02-de24-5fd0-96c0-932def05e022" "answer-41179ec7-a94b-555a-8aaf-935e2fc49a6e" "answer-5c732ae2-b8c2-5cef-81f4-7f6697c28fb4" "answer-dc7e080c-89a9-58ff-ac78-a81f19fb729b"] :db/ensure [:answer-field/validate]} {:db/id "answer-3bb73056-9bb2-5c81-af79-24007bd492a5" :answer/id #uuid "3bb73056-9bb2-5c81-af79-24007bd492a5" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-c7b89e02-de24-5fd0-96c0-932def05e022" :answer/id #uuid "c7b89e02-de24-5fd0-96c0-932def05e022" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-41179ec7-a94b-555a-8aaf-935e2fc49a6e" :answer/id #uuid "41179ec7-a94b-555a-8aaf-935e2fc49a6e" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-5c732ae2-b8c2-5cef-81f4-7f6697c28fb4" :answer/id #uuid "5c732ae2-b8c2-5cef-81f4-7f6697c28fb4" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-dc7e080c-89a9-58ff-ac78-a81f19fb729b" :answer/id #uuid "dc7e080c-89a9-58ff-ac78-a81f19fb729b" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "question-635b731f-24aa-5bbe-94a3-dad141942646" :question/id #uuid "635b731f-24aa-5bbe-94a3-dad141942646" :question/math-academy-id "q-61682" :question/problem "$\\frac{15}{2}\\times \\frac{10}{3}=$" :question/worked-solution "Interpreting the fractions as division, we get\n\n$$\n(15\\,÷\\,2)\\times (10\\,÷\\,3).\n$$\n\n \n\nSince our expression contains multiplication and division only, we can create an equivalent expression by swapping the $÷\\,2$ and $÷\\,3$:\n\n \n\n$$\n(15\\,÷\\,3)\\times (10\\,÷\\,2)\n$$\n\n \n\nInterpreting the divisions as fractions, we get\n\n$$\n\\frac{15}{3}\\times \\frac{10}{2}.\n$$\n\nCarrying out the divisions, we arrive at\n\n$$\n\\begin{aligned}{{\\frac{15}{3}}_{⏟}}_{5}\\times {{\\frac{10}{2}}_{⏟}}_{5}=5\\times 5=25.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fecac385-daaa-5ecb-995d-e703b50ec88e"] :db/ensure [:question/validate]} {:db/id "answer-field-fecac385-daaa-5ecb-995d-e703b50ec88e" :answer-field/id #uuid "fecac385-daaa-5ecb-995d-e703b50ec88e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6df36da5-be2c-5e70-a34b-ddd9550d927d" :answer-field/choices ["answer-98699e05-5fa7-508d-b75f-cd265da5c7f9" "answer-8ac4732d-869a-55af-9d16-3657747a6220" "answer-18184068-8bbe-5aaa-b472-4c1fdc10006e" "answer-6df36da5-be2c-5e70-a34b-ddd9550d927d" "answer-f8ca717c-ebbc-5f31-b1a9-41aa95fededa"] :db/ensure [:answer-field/validate]} {:db/id "answer-98699e05-5fa7-508d-b75f-cd265da5c7f9" :answer/id #uuid "98699e05-5fa7-508d-b75f-cd265da5c7f9" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-8ac4732d-869a-55af-9d16-3657747a6220" :answer/id #uuid "8ac4732d-869a-55af-9d16-3657747a6220" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-18184068-8bbe-5aaa-b472-4c1fdc10006e" :answer/id #uuid "