3bf9f34f3" "answer-40ed7987-15fc-5e02-8aef-70ab495d4217" "answer-edbb5a1e-74d7-5142-9edf-c7e568e18402" "answer-4f25c2b5-5dd6-57dc-b64b-4bf8d35775e8" "answer-eb730c66-f1b1-5979-8625-159f6e1cb683"] :db/ensure [:answer-field/validate]} {:db/id "answer-d5772281-7ba0-54de-946f-4873bf9f34f3" :answer/id #uuid "d5772281-7ba0-54de-946f-4873bf9f34f3" :answer/type :answer.type/math :answer/value "\\frac{2}{27}" :db/ensure [:answer/validate]} {:db/id "answer-40ed7987-15fc-5e02-8aef-70ab495d4217" :answer/id #uuid "40ed7987-15fc-5e02-8aef-70ab495d4217" :answer/type :answer.type/math :answer/value "\\frac{3}{35}" :db/ensure [:answer/validate]} {:db/id "answer-edbb5a1e-74d7-5142-9edf-c7e568e18402" :answer/id #uuid "edbb5a1e-74d7-5142-9edf-c7e568e18402" :answer/type :answer.type/math :answer/value "\\frac{5}{28}" :db/ensure [:answer/validate]} {:db/id "answer-4f25c2b5-5dd6-57dc-b64b-4bf8d35775e8" :answer/id #uuid "4f25c2b5-5dd6-57dc-b64b-4bf8d35775e8" :answer/type :answer.type/math :answer/value "\\frac{7}{30}" :db/ensure [:answer/validate]} {:db/id "answer-eb730c66-f1b1-5979-8625-159f6e1cb683" :answer/id #uuid "eb730c66-f1b1-5979-8625-159f6e1cb683" :answer/type :answer.type/math :answer/value "\\frac{7}{32}" :db/ensure [:answer/validate]} {:db/id "question-fceaf763-2a1c-5ef1-b51c-0b12e59864a9" :question/id #uuid "fceaf763-2a1c-5ef1-b51c-0b12e59864a9" :question/math-academy-id "q-211481" :question/problem "Expressed as a fraction in lowest terms, $\\frac{16}{9}\\times \\frac{1}{28}=${{field-1}}." :question/worked-solution "We need to solve the following multiplication problem:\n\n$$\n\\frac{16}{9}\\times \\frac{1}{28}\n$$\n\nNotice that the first fraction's numerator ($16$) and the second fraction's denominator ($28$) have a common \nfactor of $4.$ \n\nTherefore, we can simplify our problem by first swapping the denominators:\n\n$$\n\\frac{16}{28}\\times \\frac{1}{9}\n$$\n\nNext, we reduce the first fraction to its lowest terms by dividing the numerator and denominator by $4.$ \n\n$$\n\\begin{aligned}\\frac{16÷4}{28÷4}\\times \\frac{1}{9} & =\\frac{4}{7}\\times \\frac{1}{9}\\end{aligned}\n$$\n\nTo multiply two fractions, we multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{4}{7}\\times \\frac{1}{9}=\\frac{4\\times 1}{7\\times 9}=\\frac{4}{63}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1c91f540-3897-5173-a2c1-f70bf2768153"] :db/ensure [:question/validate]} {:db/id "answer-field-1c91f540-3897-5173-a2c1-f70bf2768153" :answer-field/id #uuid "1c91f540-3897-5173-a2c1-f70bf2768153" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e243e300-45bf-52c2-88fe-9276d26a1487" :answer-field/choices ["answer-e243e300-45bf-52c2-88fe-9276d26a1487"] :db/ensure [:answer-field/validate]} {:db/id "answer-e243e300-45bf-52c2-88fe-9276d26a1487" :answer/id #uuid "e243e300-45bf-52c2-88fe-9276d26a1487" :answer/type :answer.type/math :answer/value "\\frac{4}{63}" :db/ensure [:answer/validate]} {:db/id "question-4b8ecff1-169c-50b4-9995-e59b8594fed1" :question/id #uuid "4b8ecff1-169c-50b4-9995-e59b8594fed1" :question/math-academy-id "q-208021" :question/problem "$\\frac{2}{7}\\times \\frac{5}{4}=$" :question/worked-solution "We need to solve the following multiplication problem:\n\n$$\n\\frac{2}{7}\\times \\frac{5}{4}\n$$\n\nNotice that the first fraction's numerator ($2$) and the second fraction's denominator ($4$) have a common \nfactor of $2.$ \n\nTherefore, we can simplify our problem by first swapping the denominators:\n\n$$\n\\frac{2}{4}\\times \\frac{5}{7}\n$$\n\nNext, we reduce the first fraction to its lowest terms by dividing the numerator and denominator by $2.$ \n\n$$\n\\begin{aligned}\\frac{2÷2}{4÷2}\\times \\frac{5}{7} & =\\frac{1}{2}\\times \\frac{5}{7}\\end{aligned}\n$$\n\nTo multiply two fractions, we multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{1}{2}\\times \\frac{5}{7}=\\frac{1\\times 5}{2\\times 7}=\\frac{5}{14}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-194d737a-ce02-5375-9f0b-24ddf953c2a7"] :db/ensure [:question/validate]} {:db/id "answer-field-194d737a-ce02-5375-9f0b-24ddf953c2a7" :answer-field/id #uuid "194d737a-ce02-5375-9f0b-24ddf953c2a7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f5bf1dc5-2c3b-5138-9433-985d40f21e69" :answer-field/choices ["answer-af632068-8f59-5319-a50f-667d0b0aaee3" "answer-bc05a1f4-a693-5791-b52c-5866bafdf327" "answer-f5bf1dc5-2c3b-5138-9433-985d40f21e69" "answer-1cb0afc6-4da0-5c91-9872-0603b7132149" "answer-a97b1730-dd27-5fd8-9002-de4f8ab1da7e"] :db/ensure [:answer-field/validate]} {:db/id "answer-af632068-8f59-5319-a50f-667d0b0aaee3" :answer/id #uuid "af632068-8f59-5319-a50f-667d0b0aaee3" :answer/type :answer.type/math :answer/value "\\frac{1}{7}" :db/ensure [:answer/validate]} {:db/id "answer-bc05a1f4-a693-5791-b52c-5866bafdf327" :answer/id #uuid "bc05a1f4-a693-5791-b52c-5866bafdf327" :answer/type :answer.type/math :answer/value "\\frac{3}{14}" :db/ensure [:answer/validate]} {:db/id "answer-f5bf1dc5-2c3b-5138-9433-985d40f21e69" :answer/id #uuid "f5bf1dc5-2c3b-5138-9433-985d40f21e69" :answer/type :answer.type/math :answer/value "\\frac{5}{14}" :db/ensure [:answer/validate]} {:db/id "answer-1cb0afc6-4da0-5c91-9872-0603b7132149" :answer/id #uuid "1cb0afc6-4da0-5c91-9872-0603b7132149" :answer/type :answer.type/math :answer/value "\\frac{5}{28}" :db/ensure [:answer/validate]} {:db/id "answer-a97b1730-dd27-5fd8-9002-de4f8ab1da7e" :answer/id #uuid "a97b1730-dd27-5fd8-9002-de4f8ab1da7e" :answer/type :answer.type/math :answer/value "\\frac{7}{11}" :db/ensure [:answer/validate]} {:db/id "question-681d41b4-1702-556b-95c8-796404cb03b3" :question/id #uuid "681d41b4-1702-556b-95c8-796404cb03b3" :question/math-academy-id "q-208027" :question/problem "$\\frac{2}{11}\\times \\frac{3}{4}=$" :question/worked-solution "We need to solve the following multiplication problem:\n\n$$\n\\frac{2}{11}\\times \\frac{3}{4}\n$$\n\nNotice that the first fraction's numerator ($2$) and the second fraction's denominator ($4$) have a common \nfactor of $2.$ \n\nTherefore, we can simplify our problem by first swapping the denominators:\n\n$$\n\\frac{2}{4}\\times \\frac{3}{11}\n$$\n\nNext, we reduce the first fraction to its lowest terms by dividing the numerator and denominator by $2.$ \n\n$$\n\\begin{aligned}\\frac{2÷2}{4÷2}\\times \\frac{3}{11} & =\\frac{1}{2}\\times \\frac{3}{11}\\end{aligned}\n$$\n\nTo multiply two fractions, we multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{1}{2}\\times \\frac{3}{11}=\\frac{1\\times 3}{2\\times 11}=\\frac{3}{22}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8b341392-9aee-561f-8b14-c797019028cb"] :db/ensure [:question/validate]} {:db/id "answer-field-8b341392-9aee-561f-8b14-c797019028cb" :answer-field/id #uuid "8b341392-9aee-561f-8b14-c797019028cb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-001b2fc4-e19b-55f3-88e4-2e4cc199be37" :answer-field/choices ["answer-70e42c13-133f-568d-bbfb-d9fa073ecad9" "answer-7641df91-ae56-5a9b-a419-3c75e6f82c61" "answer-8f4524d1-5ec8-517f-9a3e-ecffad9f3a63" "answer-6567de9f-83af-5cbe-8f42-7ad1634d9996" "answer-001b2fc4-e19b-55f3-88e4-2e4cc199be37"] :db/ensure [:answer-field/validate]} {:db/id "answer-70e42c13-133f-568d-bbfb-d9fa073ecad9" :answer/id #uuid "70e42c13-133f-568d-bbfb-d9fa073ecad9" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-7641df91-ae56-5a9b-a419-3c75e6f82c61" :answer/id #uuid "7641df91-ae56-5a9b-a419-3c75e6f82c61" :answer/type :answer.type/math :answer/value "\\frac{2}{11}" :db/ensure [:answer/validate]} {:db/id "answer-8f4524d1-5ec8-517f-9a3e-ecffad9f3a63" :answer/id #uuid "8f4524d1-5ec8-517f-9a3e-ecffad9f3a63" :answer/type :answer.type/math :answer/value "\\frac{2}{33}" :db/ensure [:answer/validate]} {:db/id "answer-6567de9f-83af-5cbe-8f42-7ad1634d9996" :answer/id #uuid "6567de9f-83af-5cbe-8f42-7ad1634d9996" :answer/type :answer.type/math :answer/value "\\frac{3}{11}" :db/ensure [:answer/validate]} {:db/id "answer-001b2fc4-e19b-55f3-88e4-2e4cc199be37" :answer/id #uuid "001b2fc4-e19b-55f3-88e4-2e4cc199be37" :answer/type :answer.type/math :answer/value "\\frac{3}{22}" :db/ensure [:answer/validate]} {:db/id "question-4761ec95-7832-59a1-a543-1121304509d3" :question/id #uuid "4761ec95-7832-59a1-a543-1121304509d3" :question/math-academy-id "q-208003" :question/problem "$\\frac{1}{9}\\times \\frac{12}{5}=$" :question/worked-solution "We need to solve the following multiplication problem:\n\n$$\n\\frac{1}{9}\\times \\frac{12}{5}\n$$\n\nNotice that the first fraction's denominator ($9$) and the second fraction's numerator ($12$) have a common \nfactor of $3.$ \n\nTherefore, we can simplify our problem by first swapping the denominators:\n\n$$\n\\frac{1}{5}\\times \\frac{12}{9}\n$$\n\nNext, we reduce the second fraction to its lowest terms by dividing the numerator and denominator by $3.$ \n\n$$\n\\begin{aligned}\\frac{1}{5}\\times \\frac{12÷3}{9÷3} & =\\frac{1}{5}\\times \\frac{4}{3}\\end{aligned}\n$$\n\nTo multiply two fractions, we multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{1}{5}\\times \\frac{4}{3}=\\frac{1\\times 4}{5\\times 3}=\\frac{4}{15}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f4621eea-9ed0-562c-b850-b7b7a1bd0a4c"] :db/ensure [:question/validate]} {:db/id "answer-field-f4621eea-9ed0-562c-b850-b7b7a1bd0a4c" :answer-field/id #uuid "f4621eea-9ed0-562c-b850-b7b7a1bd0a4c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-07282d48-88bb-5986-812b-b1ad5940eec8" :answer-field/choices ["answer-8a0e8364-97f3-5e5d-8fd9-d2d303e76fc8" "answer-07282d48-88bb-5986-812b-b1ad5940eec8" "answer-e8aad9a7-6637-5001-b622-f519b4527c8c" "answer-6876307f-3fe0-52d1-8f06-0a368e30f549" "answer-0dd3ba50-6268-549b-91c3-d5ecd4bf40ee"] :db/ensure [:answer-field/validate]} {:db/id "answer-8a0e8364-97f3-5e5d-8fd9-d2d303e76fc8" :answer/id #uuid "8a0e8364-97f3-5e5d-8fd9-d2d303e76fc8" :answer/type :answer.type/math :answer/value "\\frac{3}{14}" :db/ensure [:answer/validate]} {:db/id "answer-07282d48-88bb-5986-812b-b1ad5940eec8" :answer/id #uuid "07282d48-88bb-5986-812b-b1ad5940eec8" :answer/type :answer.type/math :answer/value "\\frac{4}{15}" :db/ensure [:answer/validate]} {:db/id "answer-e8aad9a7-6637-5001-b622-f519b4527c8c" :answer/id #uuid "e8aad9a7-6637-5001-b622-f519b4527c8c" :answer/type :answer.type/math :answer/value "\\frac{5}{12}" :db/ensure [:answer/validate]} {:db/id "answer-6876307f-3fe0-52d1-8f06-0a368e30f549" :answer/id #uuid "6876307f-3fe0-52d1-8f06-0a368e30f549" :answer/type :answer.type/math :answer/value "\\frac{5}{16}" :db/ensure [:answer/validate]} {:db/id "answer-0dd3ba50-6268-549b-91c3-d5ecd4bf40ee" :answer/id #uuid "0dd3ba50-6268-549b-91c3-d5ecd4bf40ee" :answer/type :answer.type/math :answer/value "\\frac{7}{18}" :db/ensure [:answer/validate]} {:db/id 17592186148791 :tutorial/content "Any multiplication of fractions can also be interpreted as multiplication and division of whole numbers.\n\nFor example, consider\n\n$$\n\\dfrac{14}{\\color{blue}3} \\times \\dfrac{6}{\\color{red}7}.\n$$\n\nWriting the fractions as division, our expression becomes\n\n$$\n(14\\,{\\color{blue}{\\div\\, 3}})\\times (6\\,{\\color{red}{\\div\\, 7}}) .\n$$\n\nWe use parentheses to make it easier to read.\n\nSince our expression contains multiplication and division only, we can write an equivalent expression by swapping the two divisions. Swapping the ${\\color{red}{\\div\\, 3}}$ and the ${\\color{blue}{\\div\\, 7}}$, we get the following equivalent expression:\n\n$$\n(14\\, {\\color{red}{\\div\\, 7}}) \\times (6\\, {\\color{blue}{\\div\\, 3}})\n$$\n\nIf we interpret the divisions as fractions again, then we have another equivalent expression:\n\n$$\n\\dfrac{14}{\\color{red}7} \\times \\dfrac{6}{\\color{blue}3}\n$$\n\nNotice that this amounts to *swapping the denominators* in the original expression." :db/ensure [:tutorial/validate]} {:db/id 17592186148792 :tutorial/content "When solving a fraction multiplication problem, it's often convenient to simplify the problem *before* carrying out the multiplication. \n\nFor example, let's consider the following multiplication problem:\n\n$$\n\\dfrac{\\color{red}3}{8} \\times \\dfrac{1}{\\color{blue}12}\n$$\n\nNotice that the first fraction's numerator ($\\color{red}3$) and the second fraction's denominator ($\\color{blue}12$) have a common \nfactor of $3.$ \n\nTherefore, we can simplify our problem by first swapping the denominators:\n\n$$\n\\dfrac{\\color{red}3}{\\color{blue}12} \\times \\dfrac{1}{8}\n$$\n\nNext, we reduce the first fraction to its lowest terms by dividing the numerator and denominator by $3.$ \n\n$$\n\\begin{aligned}\\frac{3÷3}{12÷3}\\times \\frac{1}{8} & =\\frac{1}{4}\\times \\frac{1}{8}\\end{aligned}\n$$\n\nTo multiply two fractions, we multiply the numerators and we multiply the denominators:\n\n$$\n\\dfrac{1}{4} \\times \\dfrac{1}{8} = \\dfrac{1 \\times 1}{4 \\times 8} = \\dfrac{1}{32}\n$$\n\nTherefore, we conclude that\n\n$$\n\\dfrac{3}{8} \\times \\dfrac{1}{12} = \\dfrac{1}{32}.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186147660 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
