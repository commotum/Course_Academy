#{[{:db/id #edb/ref 17592186536841 :knowledge-point/_questions [{:db/id #edb/ref 17592186054770 :knowledge-point/id #uuid "281841fb-287e-597a-abb1-3917212e0dcb" :knowledge-point/title "Solving a One-Step Inequality When Flipping Is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11e4be9b-77ce-5d2c-870a-9582c9f4eacc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z\\ge \\frac{1}{5}" :db/id #edb/ref 17592186536312} {:answer/id #uuid "729d4612-b4b3-52d6-a984-56bcadb47c63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z\\le -\\frac{1}{5}" :db/id #edb/ref 17592186536474} {:answer/id #uuid "91b033fa-0ab3-5c2d-87b8-9809d0825695" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z\\ge 4" :db/id #edb/ref 17592186536517} {:answer/id #uuid "9bb97e3f-8e17-5d53-9ebf-0d14a1a104c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z\\le \\frac{1}{5}" :db/id #edb/ref 17592186536535} {:answer/id #uuid "b94c625a-806d-5398-a511-8434b5363807" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z\\ge -\\frac{1}{5}" :db/id #edb/ref 17592186536575}] :answer-field/correct {:answer/id #uuid "11e4be9b-77ce-5d2c-870a-9582c9f4eacc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z\\ge \\frac{1}{5}" :db/id #edb/ref 17592186536312} :answer-field/id #uuid "b60c1271-2aa2-5db6-a4fc-0ced692f3cad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536775}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "60d9e1c1-b611-5995-967c-6c66ed571c82" :question/math-academy-id "q-149565" :question/problem "Solve the inequality $-5z\\le -1.$" :question/worked-solution "The variable $z$ is being *multiplied* by $-5.$ To isolate $z,$ we perform the *opposite* operation, which is *dividing* by $-5.$ Remember to perform the same operation on both sides.\n\nAlso, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-5z\\,\\, & \\le \\,\\,-1 \\\\ \\frac{-5z}{-5}\\,\\, & \\ge \\,\\,\\frac{-1}{-5} \\\\ \\frac{-5z}{-5}\\,\\, & \\ge \\,\\,\\frac{1}{5}\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $-5$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}\\frac{-5z}{-5} & \\ge \\frac{1}{5} \\\\ \\frac{\\cancel{-5}z}{\\cancel{-5}} & \\ge \\frac{1}{5} \\\\ z & \\ge \\frac{1}{5}\\end{aligned}\n$$\n\nTherefore, the solution is $z\\ge \\frac{1}{5}.$"}] [{:db/id #edb/ref 17592186536866 :knowledge-point/_questions [{:db/id #edb/ref 17592186054772 :knowledge-point/id #uuid "b6b0cad0-354b-5c4c-9fe2-3aceff7e5b6e" :knowledge-point/title "Solving an Inequality and Adjusting the Final Result"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "360ebf0c-440b-5b80-aa5d-f220ea76cfe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 3" :db/id #edb/ref 17592186536367} {:answer/id #uuid "60e57476-d7c3-5931-afaa-b90f394b253b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le -3" :db/id #edb/ref 17592186536450} {:answer/id #uuid "6395e4d6-160c-524d-bea0-39d0f0cb0acb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 11" :db/id #edb/ref 17592186536454} {:answer/id #uuid "6e12aa20-0d6e-5360-a6c8-7346274c8177" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -3" :db/id #edb/ref 17592186536468} {:answer/id #uuid "a9e80f2e-a321-5d67-acf6-345376f7ea8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 3" :db/id #edb/ref 17592186536554}] :answer-field/correct {:answer/id #uuid "6e12aa20-0d6e-5360-a6c8-7346274c8177" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -3" :db/id #edb/ref 17592186536468} :answer-field/id #uuid "e410432f-86a4-50ea-8294-40d4d0eeeb2f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536794}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a6005239-b6a4-5801-8173-53f2d74d92ea" :question/math-academy-id "q-153600" :question/problem "Solve the inequality $4\\le x+7.$" :question/worked-solution "To isolate $x,$ we need to perform the *opposite* of *adding* $7,$ which is *subtracting* $7.$ Remember to perform the same operation on both sides.\n\n$$\n\\begin{aligned}4 & \\le x+7 \\\\ 4-7 & \\le x+7-7 \\\\ -3 & \\le x+0 \\\\ -3 & \\le x\\end{aligned}\n$$\n\nFinally, we rewrite the inequality with the variable on the left-hand side:\n\n$$\nx\\ge -3\n$$\n\nTherefore, the solution is $x\\ge -3.$"}] [{:db/id #edb/ref 17592186055021 :knowledge-point/_questions [{:db/id #edb/ref 17592186054771 :knowledge-point/id #uuid "200fc394-b299-5114-8f39-e6265f3c1166" :knowledge-point/title "Solving a One-Step Inequality With Fractions When Flipping Is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "249f7541-1a8a-52ec-9e0c-a25f296e0698" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 8" :db/id #edb/ref 17592186536338} {:answer/id #uuid "55632b59-8ff0-5f33-bd84-759756febdc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 6" :db/id #edb/ref 17592186536432} {:answer/id #uuid "99888988-7d3e-5baa-ab4a-decbb3967954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 8" :db/id #edb/ref 17592186536529} {:answer/id #uuid "ba590d86-ddb8-598a-a220-46efedf147bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -8" :db/id #edb/ref 17592186536579} {:answer/id #uuid "e10696b4-01d9-5bd2-8740-a24555a84567" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le -8" :db/id #edb/ref 17592186536632}] :answer-field/correct {:answer/id #uuid "ba590d86-ddb8-598a-a220-46efedf147bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -8" :db/id #edb/ref 17592186536579} :answer-field/id #uuid "512b237b-81e0-5620-86e4-6c38ec6c9bc9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186051656}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "05f33d89-cfbf-5ef4-9277-aa93cd1c185b" :question/math-academy-id "q-153984" :question/problem "Solve the inequality $-\\frac{x}{2}\\le 4.$" :question/worked-solution "The variable $x$ is being *divided* by $2.$ To isolate $x$ and remove the negative sign, we *multiply* by $-2.$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-\\frac{x}{2}\\,\\, & \\le \\,\\,4 \\\\ (-2)\\cdot (-\\frac{x}{2})\\,\\, & \\ge \\,\\,(-2)\\cdot 4 \\\\ (-2)\\cdot (-\\frac{x}{2})\\,\\, & \\ge \\,\\,-8\\end{aligned}\n$$\n\nSince two negative numbers multiply to give a positive number, we first cancel the negatives:\n\n$$\n\\begin{aligned}(-2)\\cdot (-\\frac{x}{2}) & \\ge -8 \\\\ (\\cancel{-}2)\\cdot (\\cancel{-}\\frac{x}{2}) & \\ge -8 \\\\ 2\\cdot \\frac{x}{2} & \\ge -8\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $2$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}2\\cdot \\frac{x}{2} & \\ge -8 \\\\ \\frac{2x}{2} & \\ge -8 \\\\ \\frac{\\cancel{2}x}{\\cancel{2}} & \\ge -8 \\\\ x & \\ge -8\\end{aligned}\n$$\n\nTherefore, the solution is $x\\ge -8.$"}]}
