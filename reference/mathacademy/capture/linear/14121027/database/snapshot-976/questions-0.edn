#{[{:db/id #edb/ref 17592186417703 :knowledge-point/_questions [{:db/id #edb/ref 17592186124521 :knowledge-point/id #uuid "e9d77214-796e-558f-a364-00ae3e25cc13" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64373e5d-5dd7-5b8c-997e-b1a1d51821a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186417686} {:answer/id #uuid "7ed9e009-1eed-587e-99c2-a5c90a12f34a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186417688} {:answer/id #uuid "bd086813-aae0-5b88-80fb-38d4e70fa634" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186417692} {:answer/id #uuid "f5946256-8005-5d78-9fdf-0e9f112f6155" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186417697} {:answer/id #uuid "fd2228ec-39b9-5ba7-96a0-e30dc0202e32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186417699}] :answer-field/correct {:answer/id #uuid "bd086813-aae0-5b88-80fb-38d4e70fa634" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186417692} :answer-field/id #uuid "2afbf87d-1c06-55f7-9a1b-f8b6764e8f1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417701}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0464e7a7-ce22-55cd-90ec-4b6a71a12079" :question/math-academy-id "q-38893" :question/problem "Which of the following statements are true given that $T:{R}^{5}\\to {R}^{5}$ is a linear transformation whose standard matrix is $T,$ and $T(x)=v$ has no solution? \n\n- $T$ is invertible\n- $\\text{Ker}(T)\\ne {0}$\n- $\\text{nullity}(T)=0$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{5}$ into ${R}^{5},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{5} \\\\  & \\text{rank}(T)=5 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since $T(x)=v$ has no solution, we have that $v\\notin \\text{Im}(T),$ hence $\\text{Im}(T)\\ne {R}^{5}.$ According to the invertible matrix theorem, since $\\text{Im}(T)\\ne {R}^{5},$ the transformation $T$ and the matrix $T$ are not invertible.\n\n- Statement II is true. Since $T$ is not invertible, the invertible matrix theorem implies that  $\\text{Ker}(T)\\ne {0}.$\n\n- Statement III is false. Since $T$ is not invertible, the invertible matrix theorem implies that $\\text{nullity}(T)\\ne 0.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186125164 :knowledge-point/_questions [{:db/id #edb/ref 17592186124631 :knowledge-point/id #uuid "113a601e-220a-54a3-a64b-1e554bc3d79f" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bdc2284-27e4-5704-8274-3bbae725fe40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186417687} {:answer/id #uuid "86137dd0-1a5b-577a-bcd9-2df89f80ba0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186417689} {:answer/id #uuid "8ba47e3f-5df2-5d3d-9f48-fd9b4dac64f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186417690} {:answer/id #uuid "e41cc51f-809d-5496-8f87-309d33b65dcd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186417694} {:answer/id #uuid "eb26f8f1-623e-5c62-85e0-a07163ca023d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186417695}] :answer-field/correct {:answer/id #uuid "86137dd0-1a5b-577a-bcd9-2df89f80ba0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186417689} :answer-field/id #uuid "0f9bf687-3349-5509-9785-9f7978d92cf5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417700}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a059dc0b-5296-5e25-93e6-3ffd38125f6c" :question/math-academy-id "q-47556" :question/problem "Let $T:{R}^{2}\\to {R}^{2}$ be a linear transformation whose standard matrix is $T.$ Consider the following statement:\n\n*If $[1,-1]^{T}\\notin \\text{Im}(T)$, then $\\text{__________}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\n- $\\text{Ker}(T)={0}$\n- $\\text{rank}(T)\\ne 2$\n- $T$ is invertible" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{2}$ into ${R}^{2},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{2} \\\\  & \\text{rank}(T)=2 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since the vector $[\\begin{aligned}1 \\\\ -1\\end{aligned}]$ does not lie in $\\text{Im}(T)$, then $\\text{Im}(T)\\ne {R}^{2}.$ Therefore, according to the invertible matrix theorem, we must have $\\text{Ker}(T)\\ne {0}.$\n\n- Statement II is true. Since $\\text{Im}(T)\\ne {R}^{2}$, then $\\text{rank}(T)=\\text{rank}(T)\\ne 2.$\n\n- Statement III is false. According to the invertible matrix theorem, since $\\text{Im}(T)\\ne {R}^{2},$ the transformation $T$ can't be invertible.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186417704 :knowledge-point/_questions [{:db/id #edb/ref 17592186124631 :knowledge-point/id #uuid "113a601e-220a-54a3-a64b-1e554bc3d79f" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f10238c-7d05-58b9-96e8-9c69a8801161" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186417685} {:answer/id #uuid "b1eb1104-92b0-5dcf-bd12-07d9a0132bf5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186417691} {:answer/id #uuid "d5329d0a-dafa-5056-a8ca-478564ecacb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186417693} {:answer/id #uuid "eeaaa408-6e32-550a-b040-2adb608fe8fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186417696} {:answer/id #uuid "fb5e2579-8b62-5595-a1e0-8ecfe4516933" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186417698}] :answer-field/correct {:answer/id #uuid "eeaaa408-6e32-550a-b040-2adb608fe8fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186417696} :answer-field/id #uuid "4b17b4e5-ae42-5c71-8493-ac975ab35b5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417702}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c77aeb41-578d-533f-87d1-e33216f35c1e" :question/math-academy-id "q-84053" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T$ and ${u}_{1},{u}_{2}\\in {R}^{3}.$  Consider the following statement:\n\n*If ${u}_{1}-{u}_{2}\\ne 0$ and $T({u}_{1})-T({u}_{2})=0,$ then $\\text{__________}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\n- $\\text{Ker}(T)={0}$\n- $\\text{rank}(T)\\ne 3$\n- $T$ is invertible" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since $T$ is a linear transformation and $T({u}_{1})-T({u}_{2})=0,$ we have $T({u}_{1}-{u}_{2})=0.$ So ${u}_{1}-{u}_{2}\\in \\text{Ker}(T)$ and ${u}_{1}-{u}_{2}\\ne 0.$ Therefore, we must have $\\text{Ker}(T)\\ne {0}.$\n\n- Statement II is true. Since $\\text{Ker}(T)\\ne {0}$, then $\\text{rank}(T)=\\text{rank}(T)\\ne 3.$\n\n- Statement III is false. According to the invertible matrix theorem, since $\\text{rank}(T)\\ne 3,$ the transformation $T$ can't be invertible.\n\nTherefore, the correct answer is \"II only.\""}]}
