\" stretchy=\"false\">→</mo><mn>2</mn></mrow></munder><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mn>4</mn><mi>x</mi><mo stretchy=\"false\">(</mo><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo><mo>−</mo><mn>8</mn><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo data-mjx-alternate=\"1\">′</mo></msup><msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mn>2</mn><mi>x</mi><mo>−</mo><mn>4</mn><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo data-mjx-alternate=\"1\">′</mo></msup></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mn>2</mn></mrow></munder><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>4</mn><mo stretchy=\"false\">(</mo><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mn>8</mn><msup><mi>x</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>4</mn><mo stretchy=\"false\">(</mo><msup><mn>2</mn><mn>2</mn></msup><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mn>8</mn><mo stretchy=\"false\">(</mo><mn>2</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>4</mn><mo>+</mo><mn>32</mn></mrow><mn>2</mn></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>18.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
