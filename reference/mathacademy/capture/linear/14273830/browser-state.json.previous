  "live_records": {
    "q-336885": {
      "dom_id": "step-q336885",
      "name": "Question 1",
      "problem": "Evaluate the following limit:\n\n$\\,{lim}_{x\\to 0}\\frac{ln\\,(1+\\operatorname{sin}⁡(4x))}{\\operatorname{tan}⁡(2x)}=$\n{{field-1}}",
      "worked_solution": "Note that plugging in $x=0$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{ln\\,(1+\\operatorname{sin}⁡(4x))}{\\operatorname{tan}⁡(2x)} & ={lim}_{x\\to 0}\\frac{{[ln\\,(1+\\operatorname{sin}⁡(4x))]}^{′}}{[\\operatorname{tan}⁡(2x)]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{(\\frac{4\\operatorname{cos}⁡(4x)}{1+\\operatorname{sin}⁡(4x)})}{2{sec}^{2}⁡(2x)} \\\\  & =\\frac{(\\frac{4\\operatorname{cos}⁡(4(0))}{1+\\operatorname{sin}⁡(4(0))})}{2{sec}^{2}⁡(2(0))} \\\\  & =\\frac{(\\frac{4(1)}{1+0})}{2(1)} \\\\  & =2\\end{aligned}\n$$",
      "calculator_instructions": "",
