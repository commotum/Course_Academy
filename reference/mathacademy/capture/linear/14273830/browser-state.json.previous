2</mn><mi>x</mi></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mn>0</mn></mrow></munder><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mn>8</mn><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>8</mn><mi>x</mi></mrow></msup><mo>−</mo><mn>5</mn><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>5</mn><mi>x</mi></mrow></msup><mo>−</mo><mn>3</mn><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo data-mjx-alternate=\"1\">′</mo></msup><mrow><mo stretchy=\"false\">[</mo><mn>2</mn><mi>x</mi><msup><mo stretchy=\"false\">]</mo><mo data-mjx-alternate=\"1\">′</mo></msup></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mn>0</mn></mrow></munder><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>64</mn><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>8</mn><mi>x</mi></mrow></msup><mo>−</mo><mn>25</mn><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>5</mn><mi>x</mi></mrow></msup></mrow><mn>2</mn></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>64</mn><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>−</mo><mn>25</mn><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mrow><mn>2</mn></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>39</mn><mn>2</mn></mfrac></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
