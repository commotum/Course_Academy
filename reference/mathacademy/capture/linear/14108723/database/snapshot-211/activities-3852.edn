#{[{:activity/first-step {:db/id #edb/ref 17592186189084} :activity/id #uuid "e8e2dcd1-d239-5120-a71f-5337f9c0fb01" :activity/scope {:db/id #edb/ref 17592186049886 :topic/id #uuid "1a7775b9-b31c-568f-86d9-182b4c190efc" :topic/math-academy-id 3852} :activity/steps [{:db/id #edb/ref 17592186189066 :step/content {:db/id #edb/ref 17592186188267 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188210 :question/id #uuid "4b196d96-a95f-53d6-a0c5-7233de14a401" :question/math-academy-id "e-5445"} :knowledge-point/id #uuid "9cc062b6-306b-5edc-81db-1a3051cf3f51" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048984} {:db/id #edb/ref 17592186049545} {:db/id #edb/ref 17592186049909}] :knowledge-point/questions [{:db/id #edb/ref 17592186188923} {:db/id #edb/ref 17592186188987} {:db/id #edb/ref 17592186364981} {:db/id #edb/ref 17592186365079} {:db/id #edb/ref 17592186365086} {:db/id #edb/ref 17592186366440}] :knowledge-point/title "Finding the Rank or Nullity of a Linear Transformation Using the Rank-Nullity Theorem"} :step/id #uuid "4b289521-18f1-582d-b604-520f11ba29d7" :step/math-academy-id 20021 :step/next {:db/id #edb/ref 17592186189094}} {:db/id #edb/ref 17592186189083 :step/content {:db/id #edb/ref 17592186188279 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188213 :question/id #uuid "0eddf8b0-bdd9-55db-9388-d39bd91c24c1" :question/math-academy-id "e-7251"} :knowledge-point/id #uuid "e12609b7-286b-50a8-8373-a331d60ab904" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049377}] :knowledge-point/questions [{:db/id #edb/ref 17592186188917} {:db/id #edb/ref 17592186188931} {:db/id #edb/ref 17592186366045} {:db/id #edb/ref 17592186366103} {:db/id #edb/ref 17592186366433} {:db/id #edb/ref 17592186366461} {:db/id #edb/ref 17592186406872} {:db/id #edb/ref 17592186406874}] :knowledge-point/title "Identifying True Statements Using the Rank-Nullity Theorem"} :step/id #uuid "626e026a-01da-503f-a127-2b353dbc209b" :step/math-academy-id 26827} {:db/id #edb/ref 17592186189084 :step/content {:db/id #edb/ref 17592186189371 :tutorial/content "The **rank-nullity theorem in terms of linear transformations** states the following:\n\n*If $\\mathbf{T}:\\mathbb{R}^n \\to \\mathbb{R}^n$ is a linear transformation, then* $$\\textrm{dim(Im}(\\mathbf{T})) + \\textrm{dim(Ker}(\\mathbf{T})) = \\textrm{dim}(\\mathbb{R}^n),$$ *or equivalently,* $$\\textrm{rank}(\\mathbf{T}) + \\textrm{nullity}(\\mathbf{T}) = n.$$\n\nFor example, suppose that $\\mathbf{T}:\\mathbb{R}^3\\to\\mathbb{R}^3$ is a linear transformation such that $$\\textrm{Im}(\\mathbf{T})=\\{ [ x, y, z ]^T \\, : \\, y+2z=0\\}.$$\n\nLet's use the rank-nullity theorem to compute $\\textrm{rank}(\\mathbf{T})$ and $\\text{nullity}(\\mathbf{T}).$\n\nFirst, solving $y+2z=0$ for $y,$ we get $y = -2z.$ Therefore, any vector from $\\textrm{Im}(\\mathbf{T})$ can be written as $$\\begin{aligned}[\\begin{aligned}x \\\\ -2z \\\\ z\\end{aligned}]=x{{[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]}_{⏟}}_{{v}_{1}}+z{{[\\begin{aligned}0 \\\\ -2 \\\\ 1\\end{aligned}]}_{⏟}}_{{v}_{2}}.\\end{aligned}$$\n\nThis means that $\\textrm{Im}(\\mathbf{T})=\\textrm{Span}\\{\\mathbf{v}_1,\\mathbf{v}_2\\}.$ And since $\\mathbf v_1$ and $\\mathbf v_2$ are linearly independent, we have $\\textrm{rank}(\\mathbf{T})=2.$\n\nFinally, using the rank-nullity theorem, we obtain $$\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\ & =3-2 \\\\ & =1.\\end{aligned}$$" :tutorial/id #uuid "9c4215af-a9cf-5a1a-aabc-40c5395f2df4" :tutorial/math-academy-id 4379 :tutorial/title "Introduction"} :step/id #uuid "9e0c933b-d880-5bfa-804a-944d21dae8a3" :step/math-academy-id 26840 :step/next {:db/id #edb/ref 17592186189066}} {:db/id #edb/ref 17592186189094 :step/content {:db/id #edb/ref 17592186188287 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188222 :question/id #uuid "91885df0-9f1d-5c18-acf1-70259cf7f4d9" :question/math-academy-id "e-9987"} :knowledge-point/id #uuid "9a9a16cc-d807-5015-ba40-b4a15fe3a0db" :knowledge-point/questions [{:db/id #edb/ref 17592186188930} {:db/id #edb/ref 17592186188988} {:db/id #edb/ref 17592186365093} {:db/id #edb/ref 17592186365100} {:db/id #edb/ref 17592186366447} {:db/id #edb/ref 17592186366454} {:db/id #edb/ref 17592186406871} {:db/id #edb/ref 17592186406873}] :knowledge-point/title "Finding the Rank or Nullity of a Linear Transformation Given a Description of the Image or Kernel"} :step/id #uuid "6735a644-2990-5e5c-b639-afb52f0b4d15" :step/math-academy-id 37613 :step/next {:db/id #edb/ref 17592186189083}}] :activity/title "The Rank-Nullity Theorem in Terms of Linear Transformations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186188454}] [{:activity/course {:db/id #edb/ref 17592186046679} :activity/first-step {:db/id #edb/ref 17592186406878} :activity/id #uuid "1a6d8485-0053-526d-9b37-3def23fa3c0b" :activity/scope {:db/id #edb/ref 17592186049886 :topic/id #uuid "1a7775b9-b31c-568f-86d9-182b4c190efc" :topic/math-academy-id 3852} :activity/steps [{:db/id #edb/ref 17592186406875 :step/content {:db/id #edb/ref 17592186406872 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "137c378d-550c-59a7-83a4-77963d65438e" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II only" :db/id #edb/ref 17592186406842} {:answer/id #uuid "398883aa-641c-5083-bd16-075d6b81fc9c" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II and III only" :db/id #edb/ref 17592186406845} {:answer/id #uuid "f008c6f6-1933-5ee3-808d-05aba679cfa0" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "III only" :db/id #edb/ref 17592186406862} {:answer/id #uuid "f2d76c7a-6c06-5532-924f-6597deab979a" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I and II only" :db/id #edb/ref 17592186406864} {:answer/id #uuid "f9f2e498-b357-5b66-a290-e994e329a0aa" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I only" :db/id #edb/ref 17592186406865}] :answer-field/correct {:db/id #edb/ref 17592186406865} :answer-field/id #uuid "b752c3d9-0b1a-5d80-8a37-82a98660d651" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406870}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "838322c6-867e-5a73-a18d-bbf81bd1218b" :question/math-academy-id "q-84081" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T.$ Which of the following statements are true?\n\n- If $\\text{Ker}(T)={[x,y,z]^{T}\\,:\\,y=z=0}$ then $\\text{rank}(T)=2$\n- If $Tx=[1,0,0]^{T}$ has more than one solution, then $\\text{nullity}(T)=0$\n- If $\\text{Ker}(T)=\\text{Span}{[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}]}$, then $T$ is invertible" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=3.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $y=z=0,$ any vector from $\\text{Ker}(T)$ can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}x \\\\ 0 \\\\ 0\\end{aligned}]=x{{[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]}_{⏟}}_{{v}_{1}}.\\end{aligned}\n$$\n\nThis means that $\\text{Ker}(T)=\\text{Span}{{v}_{1}}.$ Therefore, $\\text{nullity}(T)=1.$ Finally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(T) & =3-\\text{nullity}(T) \\\\  & =3-1 \\\\  & =2.\\end{aligned}\n$$\n\n- Statement II is false. Since $Tx=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]$ has more than one solution, there are ${u}_{1},{u}_{2}\\in {R}^{3}$ such that  ${u}_{1}\\ne {u}_{2}$ and \n\n$$\nT({u}_{1})=T({u}_{2})=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}].\n$$\n\nThis means, $T$ is not a bijection and according to the invertible matrix theorem, $\\text{nullity}(T)\\ne 0.$\n\n- Statement III is false. Notice that $\\text{Ker}(T)=\\text{Span}{[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}]}.$ Therefore, $\\text{nullity}(T)=1.$ So, $T$ is not a bijection or, which is the same, $T$ is not invertible.\n\nTherefore, the correct answer is \"I only.\""} :step/id #uuid "4b0b57c7-2d59-5d20-9983-005e3257de52" :step/next {:db/id #edb/ref 17592186406876}} {:db/id #edb/ref 17592186406876 :step/content {:db/id #edb/ref 17592186406871 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f3fa2ee-eac1-54f7-a4c6-ec5b539510f4" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "Not enough information." :db/id #edb/ref 17592186406841} {:answer/id #uuid "b15a9656-7038-5a55-bf9f-c3d46f455338" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2" :db/id #edb/ref 17592186406854} {:answer/id #uuid "cc277bfe-8316-5960-ad00-41d18d0bb79e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0" :db/id #edb/ref 17592186406857} {:answer/id #uuid "e7eb8255-65e0-55e8-9452-62dfb2f06a3d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "3" :db/id #edb/ref 17592186406859} {:answer/id #uuid "e84109bf-1001-5843-8805-1788b156098c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "1" :db/id #edb/ref 17592186406860}] :answer-field/correct {:db/id #edb/ref 17592186406860} :answer-field/id #uuid "28b8502d-f01b-56da-9de3-fce2aa5353e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406868}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7bb2599b-79c3-5637-9b4b-ca26bce210be" :question/math-academy-id "q-140098" :question/problem "Find $\\text{nullity}(T)$ given that $T:{R}^{3}\\to {R}^{3}$ and $\\text{Im}(T)={[x,y,z]^{T}\\,:\\,y-2z=0}.$" :question/worked-solution "Solving $y-2z=0$ for $y,$ we get $y=2z.$ Therefore, any vector from $\\text{Im}(T)$ can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ 2z \\\\ z\\end{aligned}]=x{{[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]}_{⏟}}_{{v}_{1}}+z{{[\\begin{aligned}0 \\\\ 2 \\\\ 1\\end{aligned}]}_{⏟}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2}}.$ Therefore, $\\text{rank}(T)=2.$ \n\nFinally, according to the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$"} :step/id #uuid "81a2fa92-8011-53d7-b83d-7c048c758080" :step/next {:db/id #edb/ref 17592186406877}} {:db/id #edb/ref 17592186406877 :step/content {:db/id #edb/ref 17592186406874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c9cc9f1-6dc9-5ef5-bc2e-1c6223fff913" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I only" :db/id #edb/ref 17592186406844} {:answer/id #uuid "6c1ecd08-5cfd-5fa0-8816-6cd1534d5cfe" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I and II  only" :db/id #edb/ref 17592186406847} {:answer/id #uuid "814e5ad9-9f01-5ecd-b8a4-c2d681744359" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II only" :db/id #edb/ref 17592186406849} {:answer/id #uuid "baf23525-fd54-5469-816a-c9815ee5e488" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II and III  only" :db/id #edb/ref 17592186406855} {:answer/id #uuid "f296e857-ff04-5310-8c81-bcc9e90783d0" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "III only" :db/id #edb/ref 17592186406863}] :answer-field/correct {:db/id #edb/ref 17592186406844} :answer-field/id #uuid "0afa56a8-491c-5f58-8d6a-30c34a607288" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406866}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b72abcb6-85da-5c4d-a8eb-72ce20ae6b72" :question/math-academy-id "q-140100" :question/problem "Let $T:{R}^{5}\\to {R}^{5}$ be a linear transformation whose standard matrix is $T,$ and let ${{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ be a set of linearly independent vectors in ${R}^{5}.$ Consider the following statement:\n\n*If  $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$, then $\\text{__________}.$ * \n\nWhich of the following can be placed into the blank space to make a true statement?\n\n- $\\text{rank}(T)=4$\n- $\\text{nullity}(T)=4$\n- $T$ is a bijection" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{5}$ into ${R}^{5},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{5} \\\\  & \\text{rank}(T)=5 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=5.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Indeed, since $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ and the set ${{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ is linearly independent, we get that $\\text{rank}(T)=\\text{rank}(T)=4.$\n\n- Statement II is false. According to the rank-nullity theorem, we obtain \n\n$$\n\\begin{aligned}\\text{nullity}(T) & =5-\\text{rank}(T) \\\\  & =5-4 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement III is false. Since $\\text{rank}(T)\\ne 5$ (or since $\\text{nullity}(T)\\ne 0$), the linear transformation $T$ cannot be a bijection according to the invertible matrix theorem.\n\nTherefore, the correct option is \"I only.\""} :step/id #uuid "83597e6d-f7ab-5d6b-86d3-62716c58dc6e"} {:db/id #edb/ref 17592186406878 :step/content {:db/id #edb/ref 17592186188931 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5540b73e-76fe-5b3b-9e59-bcdd8e64db55" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II only" :db/id #edb/ref 17592186406846} {:answer/id #uuid "6da2df3c-89eb-5372-97ad-f660691bfcb8" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I and III only" :db/id #edb/ref 17592186406848} {:answer/id #uuid "82cdbbed-d3b0-5cbd-98ec-7fd44334fdc9" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I only" :db/id #edb/ref 17592186406850} {:answer/id #uuid "8c7f5f0b-b8d0-5234-8de6-49e97dadce22" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I and II only" :db/id #edb/ref 17592186406851} {:answer/id #uuid "d681f156-99f3-5753-a570-2bb3e53d88eb" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II and III only" :db/id #edb/ref 17592186406858}] :answer-field/correct {:db/id #edb/ref 17592186406850} :answer-field/id #uuid "1a41ad32-7f22-5720-8aeb-d6772bd219f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406867}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1b3a8f74-a4d2-5020-9ea6-4077acac1b2e" :question/math-academy-id "q-47524" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T.$ Which of the following statements are true?\n\n- If $\\text{Im}(T)={[x,y,z]^{T}\\,:\\,3x+2y-z=0}$ then $\\text{nullity}(T)=1$\n- If ${v}_{1}$ and ${v}_{2}$ are two different solutions to $Tx=[1,-2,1]^{T}$ then $T$ is invertible\n- If ${v}_{1},$ ${v}_{2},$ and ${v}_{3}$ are the columns of $T$ and ${v}_{3}={v}_{1}+2{v}_{2}$, then $\\text{Ker}(T)={0}$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=3.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Solving $3x+2y-z=0$ for $z,$ we get $z=3x+2y.$ Therefore, any vector from $\\text{Im}(T)$ can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}x \\\\ y \\\\ 3x+2y\\end{aligned}]=x{{[\\begin{aligned}1 \\\\ 0 \\\\ 3\\end{aligned}]}_{⏟}}_{{v}_{1}}+y{{[\\begin{aligned}0 \\\\ 1 \\\\ 2\\end{aligned}]}_{⏟}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2}}.$ Therefore, $\\text{rank}(T)=2.$ Finally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement II is false. If ${v}_{1}$ and ${v}_{2}$ are two different solutions to $Tx=[1,-2,1]^{T},$ then \n\n$$\nT{v}_{1}=T{v}_{2}\\,⟹\\,T({v}_{1}-{v}_{2})=0,\n$$\n\nwhere ${v}_{1}-{v}_{2}$ is a non-zero vector. This means that $\\text{Ker}(T)=\\text{Null}(T)\\ne {0}$ and, according to the invertible matrix theorem, $T$ can't be invertible.\n\n- Statement III is false. If the columns of $T$ are such that ${v}_{3}={v}_{1}+2{v}_{2},$ then the set of vectors ${{v}_{1},{v}_{2},{v}_{3}}$ is linearly dependent and therefore $\\text{Im}(T)=\\text{Col}(T)\\ne {R}^{3}.$ Now, according to the matrix invertible theorem, we obtain that $\\text{Ker}(T)\\ne {0}.$\n\nTherefore, the correct answer is \"I only.\""} :step/id #uuid "962a6c24-9fbc-5081-8aa6-b1e292aead4b" :step/next {:db/id #edb/ref 17592186406879}} {:db/id #edb/ref 17592186406879 :step/content {:db/id #edb/ref 17592186406873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1470852b-03e9-5db4-8d33-ce40b9b312ff" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "Not enough information." :db/id #edb/ref 17592186406843} {:answer/id #uuid "a80e2855-a004-5120-bf2a-4803a51aedf5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "3" :db/id #edb/ref 17592186406852} {:answer/id #uuid "af65c1f2-8ae8-5564-a484-7a9735e719d2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0" :db/id #edb/ref 17592186406853} {:answer/id #uuid "c038e33b-b13d-5ebb-aa6f-234d43c1d51b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2" :db/id #edb/ref 17592186406856} {:answer/id #uuid "e9530934-50fc-57c8-a93e-515a75115d2d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "1" :db/id #edb/ref 17592186406861}] :answer-field/correct {:db/id #edb/ref 17592186406861} :answer-field/id #uuid "6c728edd-0030-5f84-bc57-b18190d3fb0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406869}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "94b1ad7b-577b-5c7c-8164-0f25bc8b5263" :question/math-academy-id "q-83446" :question/problem "Find $\\text{rank}(T)$ given that $T:{R}^{3}\\to {R}^{3}$ and $\\text{Ker}(T)={[x,y,z]^{T}\\,:\\,x+y+z=0}.$" :question/worked-solution "Solving $x+y+z=0$ for $z,$ we get $z=-x-y.$ Therefore, any vector from $\\text{Ker}(T)$ can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ -x-y\\end{aligned}]=x{{[\\begin{aligned}1 \\\\ 0 \\\\ -1\\end{aligned}]}_{⏟}}_{{v}_{1}}+y{{[\\begin{aligned}0 \\\\ 1 \\\\ -1\\end{aligned}]}_{⏟}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Ker}(T)=\\text{Span}{{v}_{1},{v}_{2}}.$ Therefore, $\\text{nullity}(T)=2.$ \n\nFinally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(T) & =3-\\text{nullity}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$"} :step/id #uuid "a96e7cad-642a-5c4d-add9-f21b4c3f7cb6" :step/next {:db/id #edb/ref 17592186406875}}] :activity/title "The Rank-Nullity Theorem in Terms of Linear Transformations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186406840}]}
