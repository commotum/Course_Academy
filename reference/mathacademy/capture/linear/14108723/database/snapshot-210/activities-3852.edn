#{[{:activity/first-step {:db/id #edb/ref 17592186189084} :activity/id #uuid "e8e2dcd1-d239-5120-a71f-5337f9c0fb01" :activity/scope {:db/id #edb/ref 17592186049886 :topic/id #uuid "1a7775b9-b31c-568f-86d9-182b4c190efc" :topic/math-academy-id 3852} :activity/steps [{:db/id #edb/ref 17592186189066 :step/content {:db/id #edb/ref 17592186188267 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188210 :question/id #uuid "4b196d96-a95f-53d6-a0c5-7233de14a401" :question/math-academy-id "e-5445"} :knowledge-point/id #uuid "9cc062b6-306b-5edc-81db-1a3051cf3f51" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048984} {:db/id #edb/ref 17592186049545} {:db/id #edb/ref 17592186049909}] :knowledge-point/questions [{:db/id #edb/ref 17592186188923} {:db/id #edb/ref 17592186188987} {:db/id #edb/ref 17592186364981} {:db/id #edb/ref 17592186365079} {:db/id #edb/ref 17592186365086} {:db/id #edb/ref 17592186366440}] :knowledge-point/title "Finding the Rank or Nullity of a Linear Transformation Using the Rank-Nullity Theorem"} :step/id #uuid "4b289521-18f1-582d-b604-520f11ba29d7" :step/math-academy-id 20021 :step/next {:db/id #edb/ref 17592186189094}} {:db/id #edb/ref 17592186189083 :step/content {:db/id #edb/ref 17592186188279 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188213 :question/id #uuid "0eddf8b0-bdd9-55db-9388-d39bd91c24c1" :question/math-academy-id "e-7251"} :knowledge-point/id #uuid "e12609b7-286b-50a8-8373-a331d60ab904" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049377}] :knowledge-point/questions [{:db/id #edb/ref 17592186188917} {:db/id #edb/ref 17592186188931} {:db/id #edb/ref 17592186366045} {:db/id #edb/ref 17592186366103} {:db/id #edb/ref 17592186366433} {:db/id #edb/ref 17592186366461}] :knowledge-point/title "Identifying True Statements Using the Rank-Nullity Theorem"} :step/id #uuid "626e026a-01da-503f-a127-2b353dbc209b" :step/math-academy-id 26827} {:db/id #edb/ref 17592186189084 :step/content {:db/id #edb/ref 17592186189371 :tutorial/content "The **rank-nullity theorem in terms of linear transformations** states the following:\n\n*If $\\mathbf{T}:\\mathbb{R}^n \\to \\mathbb{R}^n$ is a linear transformation, then* $$\\textrm{dim(Im}(\\mathbf{T})) + \\textrm{dim(Ker}(\\mathbf{T})) = \\textrm{dim}(\\mathbb{R}^n),$$ *or equivalently,* $$\\textrm{rank}(\\mathbf{T}) + \\textrm{nullity}(\\mathbf{T}) = n.$$\n\nFor example, suppose that $\\mathbf{T}:\\mathbb{R}^3\\to\\mathbb{R}^3$ is a linear transformation such that $$\\textrm{Im}(\\mathbf{T})=\\{ [ x, y, z ]^T \\, : \\, y+2z=0\\}.$$\n\nLet's use the rank-nullity theorem to compute $\\textrm{rank}(\\mathbf{T})$ and $\\text{nullity}(\\mathbf{T}).$\n\nFirst, solving $y+2z=0$ for $y,$ we get $y = -2z.$ Therefore, any vector from $\\textrm{Im}(\\mathbf{T})$ can be written as $$\\begin{aligned}[\\begin{aligned}x \\\\ -2z \\\\ z\\end{aligned}]=x{{[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]}_{⏟}}_{{v}_{1}}+z{{[\\begin{aligned}0 \\\\ -2 \\\\ 1\\end{aligned}]}_{⏟}}_{{v}_{2}}.\\end{aligned}$$\n\nThis means that $\\textrm{Im}(\\mathbf{T})=\\textrm{Span}\\{\\mathbf{v}_1,\\mathbf{v}_2\\}.$ And since $\\mathbf v_1$ and $\\mathbf v_2$ are linearly independent, we have $\\textrm{rank}(\\mathbf{T})=2.$\n\nFinally, using the rank-nullity theorem, we obtain $$\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\ & =3-2 \\\\ & =1.\\end{aligned}$$" :tutorial/id #uuid "9c4215af-a9cf-5a1a-aabc-40c5395f2df4" :tutorial/math-academy-id 4379 :tutorial/title "Introduction"} :step/id #uuid "9e0c933b-d880-5bfa-804a-944d21dae8a3" :step/math-academy-id 26840 :step/next {:db/id #edb/ref 17592186189066}} {:db/id #edb/ref 17592186189094 :step/content {:db/id #edb/ref 17592186188287 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188222 :question/id #uuid "91885df0-9f1d-5c18-acf1-70259cf7f4d9" :question/math-academy-id "e-9987"} :knowledge-point/id #uuid "9a9a16cc-d807-5015-ba40-b4a15fe3a0db" :knowledge-point/questions [{:db/id #edb/ref 17592186188930} {:db/id #edb/ref 17592186188988} {:db/id #edb/ref 17592186365093} {:db/id #edb/ref 17592186365100} {:db/id #edb/ref 17592186366447} {:db/id #edb/ref 17592186366454}] :knowledge-point/title "Finding the Rank or Nullity of a Linear Transformation Given a Description of the Image or Kernel"} :step/id #uuid "6735a644-2990-5e5c-b639-afb52f0b4d15" :step/math-academy-id 37613 :step/next {:db/id #edb/ref 17592186189083}}] :activity/title "The Rank-Nullity Theorem in Terms of Linear Transformations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186188454}]}
