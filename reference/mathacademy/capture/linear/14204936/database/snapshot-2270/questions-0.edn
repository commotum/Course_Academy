#{[{:db/id #edb/ref 17592186078183 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078423 :knowledge-point/id #uuid "f9307a5e-2eea-5cea-b5f3-2ce6df53961e" :knowledge-point/title "Finding the Common Difference Given Two Consecutive Terms"}] :question/id #uuid "cb23119e-7625-5dad-873f-03049677618c" :question/math-academy-id "e-14385" :question/problem "An arithmetic sequence has $a_{11}=39$ and $a_{12}=34$. What is the common difference of the sequence?" :question/worked-solution "The first thing to note is that the terms are *decreasing*, and therefore we expect the common difference $d$ to be *negative*.\n\nSince the two terms are consecutive ($a_{12}$ goes right after $a_{11}$ in the sequence), we can find the common difference by subtracting $a_{11}$ from $a_{12}\\mathbin{:}$\n\n$$\n\\begin{aligned}d & ={a}_{12}-{a}_{11} \\\\  & =34-39 \\\\  & =-5\\end{aligned}\n$$\n\nIndeed, our result is negative, so we can be fairly confident that it is correct."}] [{:db/id #edb/ref 17592186078185 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078424 :knowledge-point/id #uuid "4d15f023-4061-51ad-b307-013bd06d3ec1" :knowledge-point/title "Finding the Common Difference Given Two Non-Consecutive Terms"}] :question/id #uuid "a22637f2-14e5-55ff-a41b-1f2a7e0eaa73" :question/math-academy-id "e-14390" :question/problem "Find the common difference of an arithmetic sequence if the $12$th term is $-56$ and the $20$th term is $-112.$" :question/worked-solution "The first thing to note is that the terms are *decreasing*, and therefore we expect $d$ to be *negative*.\n\nWe are given the terms\n\n$$\na_{\\color{black}12} = {\\color{red}-56}, \\quad a_{\\color{black}20} = {\\color{blue}-112}.\n$$\n\nTo find $d,$ we apply the formula with $n=20$ and $m=12\\mathbin{:}$\n\n$$\n\\begin{aligned}d & =\\frac{{a}_{n}-{a}_{m}}{n-m} \\\\  & =\\frac{{a}_{20}-{a}_{12}}{20-12} \\\\  & =\\frac{-112-(-56)}{20-12} \\\\  & =\\frac{-112+56}{8} \\\\  & =\\frac{-56}{8} \\\\  & =-7\\end{aligned}\n$$\n\nTherefore, the common difference is $d=-7.$ \n\nIndeed, our result is negative, so we can be fairly confident that it is correct."}] [{:db/id #edb/ref 17592186519564 :knowledge-point/_questions [{:db/id #edb/ref 17592186078423 :knowledge-point/id #uuid "f9307a5e-2eea-5cea-b5f3-2ce6df53961e" :knowledge-point/title "Finding the Common Difference Given Two Consecutive Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12893f67-0a72-530f-9e9f-da2d3170d036" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186519021} {:answer/id #uuid "1c65c842-a24a-534b-b71d-7bbd9a2e778b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186519036} {:answer/id #uuid "6bab63ff-4098-5a0e-800d-2d691a5bd939" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186519150} {:answer/id #uuid "8e197a92-1ab8-5d1c-8ddb-f517bf898065" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186519225} {:answer/id #uuid "b1f240c5-c25e-5fa7-902e-f55ad2af342c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186519282}] :answer-field/correct {:answer/id #uuid "12893f67-0a72-530f-9e9f-da2d3170d036" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186519021} :answer-field/id #uuid "615f12b4-a2ba-5d4a-9169-34d42046d8b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519446}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "947d1f31-89e5-5a9c-9e34-33e153098c01" :question/math-academy-id "q-103251" :question/problem "Find the common difference of an arithmetic sequence if its sixth and seventh terms are $6$ and $11$, respectively." :question/worked-solution "The first thing to note is that the terms are *increasing*, and therefore we expect the common difference $d$ to be *positive*.\n\nSince the two terms are consecutive, we can find the common difference by subtracting ${a}_{6}$ from ${a}_{7}:$\n\n$$\n\\begin{aligned}d & ={a}_{7}-{a}_{6} \\\\  & =11-6 \\\\  & =5\\end{aligned}\n$$\n\nTherefore, the common difference is $d=5.$"}] [{:db/id #edb/ref 17592186519575 :knowledge-point/_questions [{:db/id #edb/ref 17592186078423 :knowledge-point/id #uuid "f9307a5e-2eea-5cea-b5f3-2ce6df53961e" :knowledge-point/title "Finding the Common Difference Given Two Consecutive Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b50083da-beb9-5c72-9c70-0ef2423e7fdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186519290}] :answer-field/correct {:answer/id #uuid "b50083da-beb9-5c72-9c70-0ef2423e7fdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186519290} :answer-field/id #uuid "de38856f-a33a-5ed7-bb38-849a76e1e582" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186519501}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a939b213-95ee-5354-bca1-280bbeed2f43" :question/math-academy-id "q-214179" :question/problem "An arithmetic sequence has ${a}_{7}=6$ and ${a}_{8}=-3.$ The common difference of this sequence is $d=${{field-1}}." :question/worked-solution "The first thing to note is that the terms are *decreasing*, and therefore we expect the common difference $d$ to be *negative*.\n\nSince the two terms are consecutive, we can find the common difference by subtracting ${a}_{7}$ from ${a}_{8}:$\n\n$$\n\\begin{aligned}d & ={a}_{8}-{a}_{7} \\\\  & =-3-6 \\\\  & =-9\\end{aligned}\n$$\n\nTherefore, the common difference is $d=-9.$"}] [{:db/id #edb/ref 17592186519529 :knowledge-point/_questions [{:db/id #edb/ref 17592186078423 :knowledge-point/id #uuid "f9307a5e-2eea-5cea-b5f3-2ce6df53961e" :knowledge-point/title "Finding the Common Difference Given Two Consecutive Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fe8b005-e363-529b-8fe2-6986a0457b61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186519115} {:answer/id #uuid "503d308c-1466-5ba5-8ea1-a9767a5440f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186519116} {:answer/id #uuid "7665a2ff-2ced-5664-87cb-3db145a74222" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186519178} {:answer/id #uuid "8618bb86-b61e-563d-b59e-7eac3926ecaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186519204} {:answer/id #uuid "ca7b841c-e04e-5c49-a893-f93f15bfc3ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186519322}] :answer-field/correct {:answer/id #uuid "8618bb86-b61e-563d-b59e-7eac3926ecaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186519204} :answer-field/id #uuid "8fc7bd26-ca8e-5bc2-bb52-3ac4e12e2471" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519464}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "226f3771-4340-5c2a-b0b8-27bc76c058c5" :question/math-academy-id "q-5271" :question/problem "An arithmetic sequence has ${a}_{3}=18$ and ${a}_{4}=23.$ What is the common difference of the sequence?" :question/worked-solution "The first thing to note is that the terms are *increasing*, and therefore we expect the common difference $d$ to be *positive*.\n\nSince the two terms are consecutive, we can find the common difference by subtracting ${a}_{3}$ from ${a}_{4}:$\n\n$$\n\\begin{aligned}d & ={a}_{4}-{a}_{3} \\\\  & =23-18 \\\\  & =5\\end{aligned}\n$$\n\nTherefore, the common difference is $d=5.$"}] [{:db/id #edb/ref 17592186519606 :knowledge-point/_questions [{:db/id #edb/ref 17592186078424 :knowledge-point/id #uuid "4d15f023-4061-51ad-b307-013bd06d3ec1" :knowledge-point/title "Finding the Common Difference Given Two Non-Consecutive Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34e48f07-bceb-5ad2-80b0-5117a66ddea5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186519073} {:answer/id #uuid "8a16a038-6bbf-5095-975b-dbccda1b5ad7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186519216} {:answer/id #uuid "913157f6-c13c-5150-8233-c83d7cf2170e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186519231} {:answer/id #uuid "b17c2395-c5ac-59bf-80dd-3db42e983e1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186519280} {:answer/id #uuid "cbf92e30-8f1a-5c5d-abf3-b538bc67a447" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186519324}] :answer-field/correct {:answer/id #uuid "8a16a038-6bbf-5095-975b-dbccda1b5ad7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186519216} :answer-field/id #uuid "1e18fa7d-c611-527d-89ed-f33f1b215455" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519425}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f9d7919f-152a-59f4-84d8-010f7c33087a" :question/math-academy-id "q-5274" :question/problem "Find the common difference of an arithmetic sequence if its third and sixth terms are $2$ and $-22$, respectively." :question/worked-solution "The first thing to note is that the terms are *decreasing*, and therefore we expect $d$ to be *negative*.\n\nWe are given the terms\n\n$$\n{a}_{3}=2,\\,{a}_{6}=-22.\n$$\n\nSo, to find $d,$ we apply the formula with $n=6$ and $m=3:$\n\n$$\n\\begin{aligned}d & =\\frac{{a}_{n}-{a}_{m}}{n-m} \\\\  & =\\frac{{a}_{6}-{a}_{3}}{6-3} \\\\  & =\\frac{(-22)-2}{6-3} \\\\  & =\\frac{-24}{3} \\\\  & =-8\\end{aligned}\n$$\n\nTherefore, the common difference is $d=-8.$"}] [{:db/id #edb/ref 17592186519596 :knowledge-point/_questions [{:db/id #edb/ref 17592186078424 :knowledge-point/id #uuid "4d15f023-4061-51ad-b307-013bd06d3ec1" :knowledge-point/title "Finding the Common Difference Given Two Non-Consecutive Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "488a956f-9bc7-5837-8db3-c481d1b56fc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3.25" :db/id #edb/ref 17592186519107} {:answer/id #uuid "6bced045-23f8-5104-9d2d-7d8e3acb682e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186519152} {:answer/id #uuid "84168e80-8a3b-5417-900e-1ead231a2125" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186519200} {:answer/id #uuid "aaf6f79d-d6ee-5f05-a6e5-f7bf8776711a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2.25" :db/id #edb/ref 17592186519273} {:answer/id #uuid "e8157d94-5b61-5154-8e4e-d4a4ee2c3a4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2.5" :db/id #edb/ref 17592186519374}] :answer-field/correct {:answer/id #uuid "aaf6f79d-d6ee-5f05-a6e5-f7bf8776711a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2.25" :db/id #edb/ref 17592186519273} :answer-field/id #uuid "c6014564-1e53-5cb5-8d8c-c8d21f1fe08e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519492}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ee47bebb-a1a4-5edd-a0dd-08fb92af0f27" :question/math-academy-id "q-67317" :question/problem "An arithmetic sequence has ${a}_{20}=21.5$ and ${a}_{24}=12.5.$ What is the common difference of the sequence?" :question/worked-solution "The first thing to note is that the terms are *decreasing*, and therefore we expect $d$ to be *negative*.\n\nWe are given the terms\n\n$$\n{a}_{20}=21.5,\\,{a}_{24}=12.5.\n$$\n\nTo find $d,$ we apply the formula with $n=24$ and $m=20:$\n\n$$\n\\begin{aligned}d & =\\frac{{a}_{n}-{a}_{m}}{n-m} \\\\  & =\\frac{{a}_{24}-{a}_{20}}{24-20} \\\\  & =\\frac{12.5-21.5}{24-20} \\\\  & =\\frac{-9}{4} \\\\  & =-2.25\\end{aligned}\n$$\n\nTherefore, the common difference is $d=-2.25.$"}]}
