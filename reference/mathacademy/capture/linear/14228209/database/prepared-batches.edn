n.difficulty/hard] ["answer-field-55d0838d-ba45-55d3-974e-0b53bb87f9c1" :answer-field/id #uuid "55d0838d-ba45-55d3-974e-0b53bb87f9c1"] ["answer-e5c61a37-b0ad-558b-a7d1-6120ba4e9368" :answer/id #uuid "e5c61a37-b0ad-558b-a7d1-6120ba4e9368"] ["answer-e5c61a37-b0ad-558b-a7d1-6120ba4e9368" :answer/type :answer.type/math] ["answer-e5c61a37-b0ad-558b-a7d1-6120ba4e9368" :answer/value "\\frac{16}{5}"] ["answer-field-55d0838d-ba45-55d3-974e-0b53bb87f9c1" :answer-field/key "field-1"] ["answer-field-55d0838d-ba45-55d3-974e-0b53bb87f9c1" :answer-field/type :answer-field.type/blank] ["answer-field-55d0838d-ba45-55d3-974e-0b53bb87f9c1" :answer-field/correct "answer-e5c61a37-b0ad-558b-a7d1-6120ba4e9368"] ["answer-field-55d0838d-ba45-55d3-974e-0b53bb87f9c1" :answer-field/choices "answer-e5c61a37-b0ad-558b-a7d1-6120ba4e9368"] ["question-2ac819b8-8252-5f38-81b6-27fb48d49f54" :question/answer-fields "answer-field-55d0838d-ba45-55d3-974e-0b53bb87f9c1"] [17592186078570 :knowledge-point/questions "question-2ac819b8-8252-5f38-81b6-27fb48d49f54"] ["activity-730efb98-1f2f-5dbd-abfa-6eb2ca40c973" :activity/id #uuid "730efb98-1f2f-5dbd-abfa-6eb2ca40c973"] ["step-fffeb167-2231-519c-b231-4f453c6d3104" :step/id #uuid "fffeb167-2231-519c-b231-4f453c6d3104"] ["step-ba61d36f-7149-5d34-b5ba-7a9fcfac6d9d" :step/id #uuid "ba61d36f-7149-5d34-b5ba-7a9fcfac6d9d"] ["step-1f9dc2e7-7f93-5620-ae72-7c9fa71554d4" :step/id #uuid "1f9dc2e7-7f93-5620-ae72-7c9fa71554d4"] ["step-fffeb167-2231-519c-b231-4f453c6d3104" :step/content "question-470997c7-250a-5a72-adc9-b7b406031a9e"] ["step-fffeb167-2231-519c-b231-4f453c6d3104" :step/next "step-ba61d36f-7149-5d34-b5ba-7a9fcfac6d9d"] ["step-ba61d36f-7149-5d34-b5ba-7a9fcfac6d9d" :step/content "question-dd5db24a-0334-5fd9-a195-a6f3785eda3b"] ["step-ba61d36f-7149-5d34-b5ba-7a9fcfac6d9d" :step/next "step-1f9dc2e7-7f93-5620-ae72-7c9fa71554d4"] ["step-1f9dc2e7-7f93-5620-ae72-7c9fa71554d4" :step/content "question-2ac819b8-8252-5f38-81b6-27fb48d49f54"] ["activity-730efb98-1f2f-5db