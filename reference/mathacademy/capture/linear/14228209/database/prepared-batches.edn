[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186078570 :knowledge-point/questions ["question-470997c7-250a-5a72-adc9-b7b406031a9e" "question-2ac819b8-8252-5f38-81b6-27fb48d49f54"] :db/ensure [:knowledge-point/validate]} {:db/id "question-470997c7-250a-5a72-adc9-b7b406031a9e" :question/id #uuid "470997c7-250a-5a72-adc9-b7b406031a9e" :question/math-academy-id "q-5338" :question/problem "Evaluate ${\\sum }_{n=1}^{3}5\\cdot {2}^{n-1}.$" :question/worked-solution "The sum takes integer values of $n$ from $1$ to $3.$ So, computing the terms for $n=1,2,3$ and then adding them, we get\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{3}5\\cdot {2}^{n-1} & =(5\\cdot {2}^{1-1})+(5\\cdot {2}^{2-1})+(5\\cdot {2}^{3-1}) \\\\  & =(5\\cdot {2}^{0})+(5\\cdot {2}^{1})+(5\\cdot {2}^{2}) \\\\  & =(5\\cdot 1)+(5\\cdot 2)+(5\\cdot 4) \\\\  & =5+10+20 \\\\  & =35.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fba6865d-0f42-54a0-ae09-88d638e07043"] :db/ensure [:question/validate]} {:db/id "answer-field-fba6865d-0f42-54a0-ae09-88d638e07043" :answer-field/id #uuid "fba6865d-0f42-54a0-ae09-88d638e07043" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ca6b6978-9f05-5362-abfd-39a4f83c9478" :answer-field/choices ["answer-1d1d49e9-52a3-5714-bf0d-4a751bb9d80a" "answer-f5d1d6c4-1fed-5c72-a347-2744da1b1c47" "answer-ca6b6978-9f05-5362-abfd-39a4f83c9478" "answer-f25dcb5d-f98e-51be-bfb1-219423934d86" "answer-e5a83e13-741b-53db-a957-67d0a0178010"] :db/ensure [:answer-field/validate]} {:db/id "answer-1d1d49e9-52a3-5714-bf0d-4a751bb9d80a" :answer/id #uuid "1d1d49e9-52a3-5714-bf0d-4a751bb9d80a" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-f5d1d6c4-1fed-5c72-a347-2744da1b1c47" :answer/id #uuid "f5d1d6c4-1fed-5c72-a347-2744da1b1c47" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "answer-ca6b6978-9f05-5362-abfd-39a4f83c9478" :answer/id #uuid "ca6b6978-9f05-5362-abfd-39a4f83c9478" :answer/type :answer.type/math :answer/value "35" :db/ensure [:answer/validate]} {:db/id "answer-f25dcb5d-f98e-51be-bfb1-219423934d86" :answer/id #uuid "f25dcb5d-f98e-51be-bfb1-219423934d86" :answer/type :answer.type/math :answer/value "40" :db/ensure [:answer/validate]} {:db/id "answer-e5a83e13-741b-53db-a957-67d0a0178010" :answer/id #uuid "e5a83e13-741b-53db-a957-67d0a0178010" :answer/type :answer.type/math :answer/value "45" :db/ensure [:answer/validate]} {:db/id 17592186078571 :knowledge-point/questions ["question-dd5db24a-0334-5fd9-a195-a6f3785eda3b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-dd5db24a-0334-5fd9-a195-a6f3785eda3b" :question/id #uuid "dd5db24a-0334-5fd9-a195-a6f3785eda3b" :question/math-academy-id "q-66995" :question/problem "Express $S=8+16+24+⋯+80+88$ in sigma notation." :question/worked-solution "Notice that the terms of the corresponding sequence\n\n$$\n8,\\,16,\\,24,\\,…,\\,80,\\,88.\n$$\n\n are multiples of $8,$ and since $88÷8=11,$ there are $11$ terms in total. \n\nTherefore, the $n$th term of the sequence has the form\n\n$$\n{a}_{n}=8n,\n$$\n\nwhere $n$ ranges from $n=1$ to $n=11.$ Indeed: \n\n$$\n\\begin{aligned}{a}_{1} & =8(1)=8 \\\\ {a}_{2} & =8(2)=16 \\\\ {a}_{3} & =8(3)=24 \\\\  & \\,\\,⋮ \\\\ {a}_{10} & =8(10)=80 \\\\ {a}_{11} & =8(11)=88\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S=8+16+24+⋯+80+88={\\sum }_{n=1}^{11}8n.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-944f2e05-631f-5917-979a-ad00e83fe8a8"] :db/ensure [:question/validate]} {:db/id "answer-field-944f2e05-631f-5917-979a-ad00e83fe8a8" :answer-field/id #uuid "944f2e05-631f-5917-979a-ad00e83fe8a8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-448738d9-f7ba-5faa-973c-18695727c554" :answer-field/choices ["answer-add3a4ae-8c07-5039-ba04-4c97679fbc0f" "answer-323b99ba-09f2-5bc7-9d64-8e7dd6ab6344" "answer-6ee3a55d-76a5-5964-95de-fa24a41c09c8" "answer-4941d029-0c96-5c12-a446-5688c75f9081" "answer-448738d9-f7ba-5faa-973c-18695727c554"] :db/ensure [:answer-field/validate]} {:db/id "answer-add3a4ae-8c07-5039-ba04-4c97679fbc0f" :answer/id #uuid "add3a4ae-8c07-5039-ba04-4c97679fbc0f" :answer/type :answer.type/math :answer/value "{\\sum }_{n=1}^{10}8n" :db/ensure [:answer/validate]} {:db/id "answer-323b99ba-09f2-5bc7-9d64-8e7dd6ab6344" :answer/id #uuid "323b99ba-09f2-5bc7-9d64-8e7dd6ab6344" :answer/type :answer.type/math :answer/value "{\\sum }_{n=1}^{11}(8n+8)" :db/ensure [:answer/validate]} {:db/id "answer-6ee3a55d-76a5-5964-95de-fa24a41c09c8" :answer/id #uuid "6ee3a55d-76a5-5964-95de-fa24a41c09c8" :answer/type :answer.type/math :answer/value "{\\sum }_{n=1}^{11}(8n-8)" :db/ensure [:answer/validate]} {:db/id "answer-4941d029-0c96-5c12-a446-5688c75f9081" :answer/id #uuid "4941d029-0c96-5c12-a446-5688c75f9081" :answer/type :answer.type/math :answer/value "{\\sum }_{n=1}^{11}(n+8)" :db/ensure [:answer/validate]} {:db/id "answer-448738d9-f7ba-5faa-973c-18695727c554" :answer/id #uuid "448738d9-f7ba-5faa-973c-18695727c554" :answer/type :answer.type/math :answer/value "{\\sum }_{n=1}^{11}8n" :db/ensure [:answer/validate]} {:db/id "question-2ac819b8-8252-5f38-81b6-27fb48d49f54" :question/id #uuid "2ac819b8-8252-5f38-81b6-27fb48d49f54" :question/math-academy-id "q-251017" :question/problem "Evaluate ${\\sum }_{m=2}^{5}\\frac{2m+1}{10}=${{field-1}}" :question/worked-solution "The sum takes integer values of $m$ from $2$ to $5.$ So, computing the terms for $m=2,3,4,5$ and then adding them, we get\n\n$$\n\\begin{aligned}{\\sum }_{m=2}^{5}\\frac{2m+1}{10} & =\\frac{2\\cdot 2+1}{10}+\\frac{2\\cdot 3+1}{10}+\\frac{2\\cdot 4+1}{10}+\\frac{2\\cdot 5+1}{10} \\\\  & =\\frac{5}{10}+\\frac{7}{10}+\\frac{9}{10}+\\frac{11}{10} \\\\  & =\\frac{5+7+9+11}{10} \\\\  & =\\frac{32}{10} \\\\  & =\\frac{\\cancel{2}\\cdot 16}{\\cancel{2}\\cdot 5} \\\\  & =\\frac{16}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-55d0838d-ba45-55d3-974e-0b53bb87f9c1"] :db/ensure [:question/validate]} {:db/id "answer-field-55d0838d-ba45-55d3-974e-0b53bb87f9c1" :answer-field/id #uuid "55d0838d-ba45-55d3-974e-0b53bb87f9c1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e5c61a37-b0ad-558b-a7d1-6120ba4e9368" :answer-field/choices ["answer-e5c61a37-b0ad-558b-a7d1-6120ba4e9368"] :db/ensure [:answer-field/validate]} {:db/id "answer-e5c61a37-b0ad-558b-a7d1-6120ba4e9368" :answer/id #uuid "e5c61a37-b0ad-558b-a7d1-6120ba4e9368" :answer/type :answer.type/math :answer/value "\\frac{16}{5}" :db/ensure [:answer/validate]} {:db/id "activity-730efb98-1f2f-5dbd-abfa-6eb2ca40c973" :activity/id #uuid "730efb98-1f2f-5dbd-abfa-6eb2ca40c973" :activity/title "Sigma Notation" :activity/type :activity.type/review :activity/scope 17592186048820 :activity/course 17592186046647 :activity/steps ["step-fffeb167-2231-519c-b231-4f453c6d3104" "step-ba61d36f-7149-5d34-b5ba-7a9fcfac6d9d" "step-1f9dc2e7-7f93-5620-ae72-7c9fa71554d4"] :activity/first-step "step-fffeb167-2231-519c-b231-4f453c6d3104" :db/ensure [:activity/validate]} {:db/id "step-fffeb167-2231-519c-b231-4f453c6d3104" :step/id #uuid "fffeb167-2231-519c-b231-4f453c6d3104" :step/content "question-470997c7-250a-5a72-adc9-b7b406031a9e" :step/next "step-ba61d36f-7149-5d34-b5ba-7a9fcfac6d9d" :db/ensure [:step/validate]} {:db/id "step-ba61d36f-7149-5d34-b5ba-7a9fcfac6d9d" :step/id #uuid "ba61d36f-7149-5d34-b5ba-7a9fcfac6d9d" :step/content "question-dd5db24a-0334-5fd9-a195-a6f3785eda3b" :step/next "step-1f9dc2e7-7f93-5620-ae72-7c9fa71554d4" :db/ensure [:step/validate]} {:db/id "step-1f9dc2e7-7f93-5620-ae72-7c9fa71554d4" :step/id #uuid "1f9dc2e7-7f93-5620-ae72-7c9fa71554d4" :step/content "question-2ac819b8-8252-5f38-81b6-27fb48d49f54" :db/ensure [:step/validate]}] "assertions" [["question-470997c7-250a-5a7