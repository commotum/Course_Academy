b/ref 17592186550004 :knowledge-point/_questions [{:db/id #edb/ref 17592186078571 :knowledge-point/id #uuid "50fb047f-8c8d-56a6-9093-29a68cd89a90" :knowledge-point/title "Writing Sums Using Sigma Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "323b99ba-09f2-5bc7-9d64-8e7dd6ab6344" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{11}(8n+8)" :db/id #edb/ref 17592186549423} {:answer/id #uuid "448738d9-f7ba-5faa-973c-18695727c554" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{11}8n" :db/id #edb/ref 17592186549458} {:answer/id #uuid "4941d029-0c96-5c12-a446-5688c75f9081" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{11}(n+8)" :db/id #edb/ref 17592186549466} {:answer/id #uuid "6ee3a55d-76a5-5964-95de-fa24a41c09c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{11}(8n-8)" :db/id #edb/ref 17592186549526} {:answer/id #uuid "add3a4ae-8c07-5039-ba04-4c97679fbc0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{10}8n" :db/id #edb/ref 17592186549641}] :answer-field/correct {:answer/id #uuid "448738d9-f7ba-5faa-973c-18695727c554" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{11}8n" :db/id #edb/ref 17592186549458} :answer-field/id #uuid "944f2e05-631f-5917-979a-ad00e83fe8a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186549871}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd5db24a-0334-5fd9-a195-a6f3785eda3b" :question/math-academy-id "q-66995" :question/problem "Express $S=8+16+24+⋯+80+88$ in sigma notation." :question/worked-solution "Notice that the terms of the corresponding sequence\n\n$$\n8,\\,16,\\,24,\\,…,\\,80,\\,88.\n$$\n\n are multiples of $8,$ and since $88÷8=11,$ there are $11$ terms in total. \n\nTherefore, the $n$th term of the sequence has the form\n\n$$\n{a}_{n}=8n,\n$$\n\nwhere $n$ ranges from $n=1$ to $n=11.$ Indeed: \n\n$$\n\\begin{aligned}{a}_{1} & =8(1)=8 \\\\ {a}_{2} & =8(2)=16 \\\\ {a}_{3} & =8(3)=24 \\\\  & \\,\\,⋮ \\\\ {a}_{10} & =8(10)=80 \\\\ {a}_{11} & =8(11)=88\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S=8+16+24+⋯+80+88={\\sum }_{n=1}^{11}8n.\\end{aligned}\n$$"}]}
