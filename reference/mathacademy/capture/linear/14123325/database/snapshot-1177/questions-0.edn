c-53ce-b7f8-4e11aadbf4a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186374487}] :answer-field/correct {:answer/id #uuid "296014ff-439c-53ce-b7f8-4e11aadbf4a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186374487} :answer-field/id #uuid "b79ae90c-0d36-5d1c-8416-c9af790b4f27" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186374486} {:answer-field/choices [{:answer/id #uuid "9d4de7c3-95e7-59a5-b6dd-15e14af73f47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186374489}] :answer-field/correct {:answer/id #uuid "9d4de7c3-95e7-59a5-b6dd-15e14af73f47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186374489} :answer-field/id #uuid "36599e8f-789f-5518-8d65-81d09037ca61" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186374488} {:answer-field/choices [{:answer/id #uuid "77a9cf15-958b-5e1e-b2cb-535037ccdba1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186374491}] :answer-field/correct {:answer/id #uuid "77a9cf15-958b-5e1e-b2cb-535037ccdba1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186374491} :answer-field/id #uuid "18c16c31-6b5e-5563-acf2-2064877009ae" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186374490}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d1352187-54c7-5a62-9d05-9f2859a738dd" :question/math-academy-id "q-181811" :question/problem "![](images/d1/d13bfa3f5b0a9456c3251e9363c132578ba0d93b1b5a76c5b375c0c1abc7e310.png)\n\nUse set builder notation to describe the shaded region given in the diagram above:\n\n${(x,y)\\in {R}^{2}\\,:\\,$\n{{field-1}}\n${x}^{2}\\,+\\,$\n{{field-2}}\n${y}^{2}$\n{{field-3}}\n\n$64$\n\n$}$" :question/worked-solution "The equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the elliptical boundary of our region has horizontal radius $a=4$ and vertical radius $b=2.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{4} & =1,\\end{aligned}\n$$\n\nwhich we can write as\n\n$$\n4{x}^{2}+16{y}^{2}=64.\n$$\n\nWe're interested in describing all points that lie *outside* the ellipse. So, let's pick any point outside the region, say, $(5,0).$ Substituting its coordinates into the equation of the boundary, we obtain\n\n$$\n4(5)^{2}+16(0)^{2}\\,>\\,64.\n$$\n\nAs a result, the points $P(x,y)$ in our region are any real numbers that satisfy the condition\n\n$$\n4{x}^{2}+16{y}^{2}>64.\n$$\n\nWe must also include the curve $4{x}^{2}+16{y}^{2}=64$ since the boundary is included in the set (the curve is solid). So, we change the inequality symbol above as follows:\n\n$$\n4{x}^{2}+16{y}^{2}\\ge 64.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,4{x}^{2}+16{y}^{2}\\ge 64}.\n$$"}] [{:db/id #edb/ref 17592186299851 :knowledge-point/_questions [{:db/id #edb/ref 17592186100878 :knowledge-point/id #uuid "288e49b0-f706-54de-86b7-a17248fe2408" :knowledge-point/title "Calculating the Area of the Parallelogram Spanned by Two Non-Parallel Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd440cb0-4f36-544e-b800-2b632f84913a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186298446}] :answer-field/correct {:answer/id #uuid "cd440cb0-4f36-544e-b800-2b632f84913a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186298446} :answer-field/id #uuid "a4386ef2-d375-5d83-9422-3a383082baa8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299188}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "216d9367-5418-5e10-afd0-533eb5320c38" :question/math-academy-id "q-320414" :question/problem "Determine the area $A$ of the parallelogram spanned by $\\text{u}=⟨5,-3⟩$ and $\\text{v}=⟨-2,-4⟩.$\n\n$\\,\\,A=$ {{field-1}}" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}5 & -2 \\\\ -3 & -4\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}5 & -2 \\\\ -3 & -4\\end{aligned}| \\\\  & =5\\cdot (-4)-(-2)\\cdot (-3) \\\\  & =-20-6 \\\\  & =-26\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,-26\\,|=26\n$$"}] [{:db/id #edb/ref 17592186360711 :knowledge-point/_questions [{:db/id #edb/ref 17592186172033 :knowledge-point/id #uuid "7e61a3c8-45b0-532e-a54f-4597ad01a6f0" :knowledge-point/title "Using the Alternative Arrow Notations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c7cd51d-90dc-5dc9-a419-e7b634bbc656" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f:x↦{x}^{2}+{x}^{3}" :db/id #edb/ref 17592186358414} {:answer/id #uuid "4d27fc08-f5cd-50a8-9513-9bc9a360da1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f:{x}^{2}↦x+{x}^{3}" :db/id #edb/ref 17592186358420} {:answer/id #uuid "b1564a89-84aa-5f1a-ae48-7f463c0d25d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f:x↦x+{x}^{2}+{x}^{3}" :db/id #edb/ref 17592186359291} {:answer/id #uuid "b2ed2fbe-0739-5175-b99e-9a48302050c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f:{x}^{3}↦x+{x}^{2}" :db/id #edb/ref 17592186359311} {:answer/id #uuid "fb0992c3-51c4-547a-82b8-91b900fea332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f:x+{x}^{2}↦{x}^{3}" :db/id #edb/ref 17592186359972}] :answer-field/correct {:answer/id #uuid "b1564a89-84aa-5f1a-ae48-7f463c0d25d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f:x↦x+{x}^{2}+{x}^{3}" :db/id #edb/ref 17592186359291} :answer-field/id #uuid "8aac2d36-b7b8-5391-9580-adb6de3218e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360233}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a2816f2b-6c4e-52d9-94f7-482b59dd7020" :question/math-academy-id "q-96816" :question/problem "Which of the following is equivalent to $f(x)=x+{x}^{2}+{x}^{3}?$" :question/worked-solution "The notation $f(x)=x+{x}^{2}+{x}^{3}$ means that the function $f$ maps the element $x$ in the domain to $x+{x}^{2}+{x}^{3}$ in the codomain. This can also be written as\n\n$$\nf:x↦x+{x}^{2}+{x}^{3}.\n$$"}]}
