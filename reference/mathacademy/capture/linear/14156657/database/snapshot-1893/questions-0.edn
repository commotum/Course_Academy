#{[{:db/id #edb/ref 17592186133492 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133962 :knowledge-point/id #uuid "00f73402-88ee-5e43-8e45-dbdd0a361521" :knowledge-point/title "Evaluating a Single Fraction"}] :question/id #uuid "e2e06b2a-d740-5280-addb-2796864dd5a8" :question/math-academy-id "e-12768" :question/problem "Evaluate $\\dfrac{x-2}{x+1}$ for $x=5$." :question/worked-solution "We replace $x$ with $5$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\n\\frac{x - 2}{x + 1} &=  \\\\\n\\frac{5 - 2}{5 + 1} &=  \\\\\n\\frac{3}{6} &=  \\\\\n&= \\frac{1}{2}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186133493 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133964 :knowledge-point/id #uuid "de683deb-e208-59ef-9110-7523dd22ce2a" :knowledge-point/title "Evaluating a Sum or Difference"}] :question/id #uuid "378a718e-c6cb-5b85-adc3-22ff4bd7bc9b" :question/math-academy-id "e-12769" :question/problem "Evaluate $\\dfrac{1}{p} + \\dfrac{1}{2p}$ for $p=4$." :question/worked-solution "We replace $p$ with $4$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\n\\frac{1}{p} + \\frac{1}{2p} &=  \\\\\n\\frac{1}{4} + \\frac{1}{2 \\cdot 4} &=  \\\\\n\\frac{1}{4} + \\frac{1}{8} &=  \\\\\n\\frac{2}{8} + \\frac{1}{8} &=  \\\\\n\\frac{2 + 1}{8} &=  \\\\\n&= \\frac{3}{8}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186133494 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133963 :knowledge-point/id #uuid "75725a2d-2a8d-563f-99f1-8d071c2ff0c9" :knowledge-point/title "Evaluating Expressions With Parentheses"}] :question/id #uuid "74f72809-7c28-5fc8-9e0e-b5542b5ffe4d" :question/math-academy-id "e-12770" :question/problem "Evaluate $\\dfrac{3(2a-1)}{2(3a+1)}$ for $a=1$." :question/worked-solution "We replace $a$ with $1$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\n(3(2a - 1))/(2(3a + 1)) &=  \\\\\n(3(2(1) - 1))/(2(3(1) + 1)) &=  \\\\\n(3(2 - 1))/(2(3 + 1)) &=  \\\\\n(3(1))/(2(4)) &=  \\\\\n&= \\frac{3}{8}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186133495 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133965 :knowledge-point/id #uuid "21b84055-253e-50a0-b57f-d288d466bc02" :knowledge-point/title "Evaluating Expressions With Multiple Variables"}] :question/id #uuid "4e54a97f-16af-57c7-ab4e-c6f12e83306f" :question/math-academy-id "e-12771" :question/problem "Evaluate $\\dfrac{n-2}{m-1} + \\dfrac{2(m+1)}{n}$ for $m=4$ and $n=6$." :question/worked-solution "We replace $m$ with $4$ and $n$ with $6$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\n\\frac{n - 2}{m - 1} + (2(m + 1))/(n) &=  \\\\\n\\frac{6 - 2}{4 - 1} + (2(4 + 1))/(6) &=  \\\\\n\\frac{4}{3} + (2(5))/(6) &=  \\\\\n\\frac{4}{3} + \\frac{10}{6} &=  \\\\\n\\frac{4}{3} + \\frac{5}{3} &=  \\\\\n\\frac{4 + 5}{3} &=  \\\\\n\\frac{9}{3} &=  \\\\\n&= 3\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234263 :knowledge-point/_questions [{:db/id #edb/ref 17592186133963 :knowledge-point/id #uuid "75725a2d-2a8d-563f-99f1-8d071c2ff0c9" :knowledge-point/title "Evaluating Expressions With Parentheses"}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "26c367db-a0c7-5b44-a453-a1b81bc2c048" :question/math-academy-id "q-70116" :question/problem "Evaluate $\\frac{2(x-3)}{4-x}$ for $x=2.$" :question/worked-solution "We replace $x$ with $2$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{2(x-3)}{4-x} & = \\\\ \\frac{2(2-3)}{4-2} & = \\\\ \\frac{2(-1)}{2} & = \\\\ \\frac{\\cancel{2}(-1)}{\\cancel{2}} & = \\\\ -1\\end{aligned}\n$$"}]}
