[17592186479900 #edb/ref 1069 "q-99771" #edb/ref 17592186045417] [17592186479900 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186479900 #edb/ref 1071 "Evaluate $\\frac{5x+8}{3-x}$ for $x=1.$" #edb/ref 17592186045417] [17592186479900 #edb/ref 1072 #uuid "fa6ce3e2-d928-5ded-b467-af49a788ffd9" #edb/ref 17592186045417] [17592186479900 #edb/ref 1074 "We replace $x$ with $1$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{5x+8}{3-x} & = \\\\ \\frac{5(1)+8}{3-1} & = \\\\ \\frac{13}{2}\\end{aligned}\n$$" #edb/ref 17592186045417]}
