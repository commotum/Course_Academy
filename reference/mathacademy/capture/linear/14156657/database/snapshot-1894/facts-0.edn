db/ref 17592186045417] [17592186479857 #edb/ref 1069 "q-99873" #edb/ref 17592186045417] [17592186479857 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186479857 #edb/ref 1071 "Evaluate $\\frac{p(5p-2)}{6(3p+8)}$ for $p=-3.$" #edb/ref 17592186045417] [17592186479857 #edb/ref 1072 #uuid "5b344d92-93c1-5290-a0ad-6b1e4107b056" #edb/ref 17592186045417] [17592186479857 #edb/ref 1074 "We replace $p$ with $-3$ in the above expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{p(5p-2)}{6(3p+8)} & = \\\\ \\frac{(-3)(5(-3)-2)}{6(3(-3)+8)} & = \\\\ \\frac{(-3)(-15-2)}{6(-9+8)} & = \\\\ \\frac{(-3)(-17)}{6(-1)} & = \\\\ \\frac{51}{(-6)} & = \\\\ -\\frac{17}{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186479871 #edb/ref 1068 #edb/ref 17592186479802 #edb/ref 17592186045417] [17592186479871 #edb/ref 1069 "q-175684" #edb/ref 17592186045417] [17592186479871 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186479871 #edb/ref 1071 "If $x=4,$ then $\\frac{5x-4}{x-2}=${{field-1}}." #edb/ref 17592186045417] [17592186479871 #edb/ref 1072 #uuid "87efd59d-ce0a-5957-a5fd-7fe6753d07aa" #edb/ref 17592186045417] [17592186479871 #edb/ref 1074 "We replace $x$ with $4$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{5x-4}{x-2} & = \\\\ \\frac{5(4)-4}{4-2} & = \\\\ \\frac{16}{2} & = \\\\ 8\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186479874 #edb/ref 1068 #edb/ref 17592186479747 #edb/ref 17592186045417] [17592186479874 #edb/ref 1069 "q-173732" #edb/ref 17592186045417] [17592186479874 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186479874 #edb/ref 1071 "If $x=4,$ then $\\frac{4}{x}+\\frac{12}{5x}=${{field-1}}." #edb/ref 17592186045417] [17592186479874 #edb/ref 1072 #uuid "9225fcc6-6a47-5dc8-ba01-452e86bfb00e" #edb/ref 17592186045417] [17592186479874 #edb/ref 1074 "We replace $x$ with $4$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\fr