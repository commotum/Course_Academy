5417] [17592186133492 #edb/ref 1071 "Evaluate $\\dfrac{x-2}{x+1}$ for $x=5.$" #edb/ref 17592186045417] [17592186133492 #edb/ref 1072 #uuid "e2e06b2a-d740-5280-addb-2796864dd5a8" #edb/ref 17592186045417] [17592186133492 #edb/ref 1074 "We replace $x$ with $5$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{x-2}{x+1} & = \\\\ \\frac{5-2}{5+1} & = \\\\ \\frac{3}{6} & = \\\\ \\frac{1}{2} & \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186133493 #edb/ref 1069 "e-12769" #edb/ref 17592186045417] [17592186133493 #edb/ref 1071 "Evaluate $\\dfrac{1}{p} + \\dfrac{1}{2p}$ for $p=4.$" #edb/ref 17592186045417] [17592186133493 #edb/ref 1072 #uuid "378a718e-c6cb-5b85-adc3-22ff4bd7bc9b" #edb/ref 17592186045417] [17592186133493 #edb/ref 1074 "We replace $p$ with $4$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{1}{p}+\\frac{1}{2p} & = \\\\ \\frac{1}{4}+\\frac{1}{2\\cdot 4} & = \\\\ \\frac{1}{4}+\\frac{1}{8} & = \\\\ \\frac{2}{8}+\\frac{1}{8} & = \\\\ \\frac{2+1}{8} & = \\\\ \\frac{3}{8} & \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186133494 #edb/ref 1069 "e-12770" #edb/ref 17592186045417] [17592186133494 #edb/ref 1071 "Evaluate $\\dfrac{3(2a-1)}{2(3a+1)}$ for $a=1.$" #edb/ref 17592186045417] [17592186133494 #edb/ref 1072 #uuid "74f72809-7c28-5fc8-9e0e-b5542b5ffe4d" #edb/ref 17592186045417] [17592186133494 #edb/ref 1074 "We replace $a$ with $1$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{3(2a-1)}{2(3a+1)} & = \\\\ \\frac{3(2(1)-1)}{2(3(1)+1)} & = \\\\ \\frac{3(2-1)}{2(3+1)} & = \\\\ \\frac{3(1)}{2(4)} & = \\\\ \\frac{3}{8} & \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186133495 #edb/ref 1069 "e-12771" #edb/ref 17592186045417] [17592186133495 #edb/ref 1071 "Evaluate $\\dfrac{n-2}{m-1} + \\dfrac{2(m+1)}{n}$ for $m=4$ and $n=6.$" #edb/ref 17592186045417] [17592186133495 #edb/ref 1072 #uuid "4e54a97f-16af-57c7-ab4e-c6f12e83306f" #edb/ref 17592186045417] [17592186133495 #edb/ref 1074 "We replace $m$ with $4$ and $n$ with $6$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{n-2}{m-1}+\\frac{2(m+1)}{n} & = \\\\ \\frac{6-2}{4-1}+\\frac{2(4+1)}{6} & = \\\\ \\frac{4}{3}+\\frac{2(5)}{6} & = \\\\ \\frac{4}{3}+\\frac{10}{6} & = \\\\ \\frac{4}{3}+\\frac{5}{3} & = \\\\ \\frac{4+5}{3} & = \\\\ \\frac{9}{3} & = \\\\ 3 & \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186133962 #edb/ref 1037 #edb/ref 17592186050078 #edb/ref 17592186045417] [17592186133962 #edb/ref 1037 #edb/ref 17592186050127 #edb/ref 17592186045417] [17592186133962 #edb/ref 1038 #edb/ref 17592186134348 #edb/ref 17592186045417] [17592186133962 #edb/ref 1038 #edb/ref 17592186134349 #edb/ref 17592186045417] [17592186133962 #edb/ref 1038 #edb/ref 17592186479871 #edb/ref 17592186045417] [17592186133962 #edb/ref 1038 #edb/ref 17592186479900 #edb/ref 17592186045417] [17592186133962 #edb/ref 1039 "Evaluating a Single Fraction" #edb/ref 17592186045417] [17592186133962 #edb/ref 1041 #edb/ref 17592186133492 #edb/ref 17592186045417] [17592186133962 #edb/ref 1042 #uuid "00f73402-88ee-5e43-8e45-dbdd0a361521" #edb/ref 17592186045417] [17592186133963 #edb/ref 1038 #edb/ref 17592186134350 #edb/ref 17592186045417] [17592186133963 #edb/ref 1038 #edb/ref 17592186134489 #edb/ref 17592186045417] [17592186133963 #edb/ref 1038 #edb/ref 17592186234263 #edb/ref 17592186045417] [17592186133963 #edb/ref 1038 #edb/ref 17592186479857 #edb/ref 17592186045417] [17592186133963 #edb/ref 1039 "Evaluating Expressions With Parentheses" #edb/ref 17592186045417] [17592186133963 #edb/ref 1041 #edb/ref 17592186133494 #edb/ref 17592186045417] [17592186133963 #edb/ref 1042 #uuid "75725a2d-2a8d-563f-99f1-8d071c2ff0c9" #edb/ref 17592186045417] [17592186133964 #edb/ref 1037 #edb/ref 17592186050131 #edb/ref 17592186045417] [17592186133964 #edb/ref 1038 #edb/ref 17592186134165 #edb/ref 17592186045417] [17592186133964 #edb/ref 1038 #edb/ref 17592186134166 #edb/ref 17592186045417] [17