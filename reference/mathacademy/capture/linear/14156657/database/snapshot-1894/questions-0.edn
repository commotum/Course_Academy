#{[{:db/id #edb/ref 17592186133492 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133962 :knowledge-point/id #uuid "00f73402-88ee-5e43-8e45-dbdd0a361521" :knowledge-point/title "Evaluating a Single Fraction"}] :question/id #uuid "e2e06b2a-d740-5280-addb-2796864dd5a8" :question/math-academy-id "e-12768" :question/problem "Evaluate $\\dfrac{x-2}{x+1}$ for $x=5.$" :question/worked-solution "We replace $x$ with $5$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{x-2}{x+1} & = \\\\ \\frac{5-2}{5+1} & = \\\\ \\frac{3}{6} & = \\\\ \\frac{1}{2} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186133493 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133964 :knowledge-point/id #uuid "de683deb-e208-59ef-9110-7523dd22ce2a" :knowledge-point/title "Evaluating a Sum or Difference"}] :question/id #uuid "378a718e-c6cb-5b85-adc3-22ff4bd7bc9b" :question/math-academy-id "e-12769" :question/problem "Evaluate $\\dfrac{1}{p} + \\dfrac{1}{2p}$ for $p=4.$" :question/worked-solution "We replace $p$ with $4$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{1}{p}+\\frac{1}{2p} & = \\\\ \\frac{1}{4}+\\frac{1}{2\\cdot 4} & = \\\\ \\frac{1}{4}+\\frac{1}{8} & = \\\\ \\frac{2}{8}+\\frac{1}{8} & = \\\\ \\frac{2+1}{8} & = \\\\ \\frac{3}{8} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186133494 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133963 :knowledge-point/id #uuid "75725a2d-2a8d-563f-99f1-8d071c2ff0c9" :knowledge-point/title "Evaluating Expressions With Parentheses"}] :question/id #uuid "74f72809-7c28-5fc8-9e0e-b5542b5ffe4d" :question/math-academy-id "e-12770" :question/problem "Evaluate $\\dfrac{3(2a-1)}{2(3a+1)}$ for $a=1.$" :question/worked-solution "We replace $a$ with $1$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{3(2a-1)}{2(3a+1)} & = \\\\ \\frac{3(2(1)-1)}{2(3(1)+1)} & = \\\\ \\frac{3(2-1)}{2(3+1)} & = \\\\ \\frac{3(1)}{2(4)} & = \\\\ \\frac{3}{8} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186133495 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133965 :knowledge-point/id #uuid "21b84055-253e-50a0-b57f-d288d466bc02" :knowledge-point/title "Evaluating Expressions With Multiple Variables"}] :question/id #uuid "4e54a97f-16af-57c7-ab4e-c6f12e83306f" :question/math-academy-id "e-12771" :question/problem "Evaluate $\\dfrac{n-2}{m-1} + \\dfrac{2(m+1)}{n}$ for $m=4$ and $n=6.$" :question/worked-solution "We replace $m$ with $4$ and $n$ with $6$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{n-2}{m-1}+\\frac{2(m+1)}{n} & = \\\\ \\frac{6-2}{4-1}+\\frac{2(4+1)}{6} & = \\\\ \\frac{4}{3}+\\frac{2(5)}{6} & = \\\\ \\frac{4}{3}+\\frac{10}{6} & = \\\\ \\frac{4}{3}+\\frac{5}{3} & = \\\\ \\frac{4+5}{3} & = \\\\ \\frac{9}{3} & = \\\\ 3 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479874 :knowledge-point/_questions [{:db/id #edb/ref 17592186133964 :knowledge-point/id #uuid "de683deb-e208-59ef-9110-7523dd22ce2a" :knowledge-point/title "Evaluating a Sum or Difference"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f65767b-700b-514d-abc3-d7fa9a5ea4a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186479547}] :answer-field/correct {:answer/id #uuid "7f65767b-700b-514d-abc3-d7fa9a5ea4a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186479547} :answer-field/id #uuid "0f109fc3-9149-5bcd-ab8c-1f1c08cac4eb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479747}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9225fcc6-6a47-5dc8-ba01-452e86bfb00e" :question/math-academy-id "q-173732" :question/problem "If $x=4,$ then $\\frac{4}{x}+\\frac{12}{5x}=${{field-1}}." :question/worked-solution "We replace $x$ with $4$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{4}{x}+\\frac{12}{5x} & = \\\\ \\frac{4}{4}+\\frac{12}{5\\cdot 4} & = \\\\ 1+\\frac{3}{5} & = \\\\ \\frac{5}{5}+\\frac{3}{5} & = \\\\ \\frac{5+3}{5} & = \\\\ \\frac{8}{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479871 :knowledge-point/_questions [{:db/id #edb/ref 17592186133962 :knowledge-point/id #uuid "00f73402-88ee-5e43-8e45-dbdd0a361521" :knowledge-point/title "Evaluating a Single Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dad6b761-626c-5e60-b184-97c3c374f08a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186479685}] :answer-field/correct {:answer/id #uuid "dad6b761-626c-5e60-b184-97c3c374f08a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186479685} :answer-field/id #uuid "c649b4ef-f1a9-5c40-9e0e-b1c1946fdccc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479802}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "87efd59d-ce0a-5957-a5fd-7fe6753d07aa" :question/math-academy-id "q-175684" :question/problem "If $x=4,$ then $\\frac{5x-4}{x-2}=${{field-1}}." :question/worked-solution "We replace $x$ with $4$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{5x-4}{x-2} & = \\\\ \\frac{5(4)-4}{4-2} & = \\\\ \\frac{16}{2} & = \\\\ 8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479897 :knowledge-point/_questions [{:db/id #edb/ref 17592186133964 :knowledge-point/id #uuid "de683deb-e208-59ef-9110-7523dd22ce2a" :knowledge-point/title "Evaluating a Sum or Difference"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72bc25be-0c58-52ca-abbd-b05107247f5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{10}" :db/id #edb/ref 17592186479529}] :answer-field/correct {:answer/id #uuid "72bc25be-0c58-52ca-abbd-b05107247f5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{10}" :db/id #edb/ref 17592186479529} :answer-field/id #uuid "5cc10fd6-407a-53fb-b5c9-ca815a84b79f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479775}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e26eed03-f29f-5ce3-a1e7-151a8b9035cd" :question/math-academy-id "q-175875" :question/problem "If $p=5,$ then $\\frac{3p}{10}+\\frac{1}{p}=${{field-1}}." :question/worked-solution "We replace $p$ with $5$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{3p}{10}+\\frac{1}{p}= \\\\ \\frac{3(5)}{10}+\\frac{1}{5} & = \\\\ \\frac{15}{10}+\\frac{1}{5} & = \\\\ \\frac{15}{10}+\\frac{2}{10} & = \\\\ \\frac{15+2}{10} & = \\\\ \\frac{17}{10}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479890 :knowledge-point/_questions [{:db/id #edb/ref 17592186133965 :knowledge-point/id #uuid "21b84055-253e-50a0-b57f-d288d466bc02" :knowledge-point/title "Evaluating Expressions With Multiple Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90695084-425d-5a63-8e98-c52c1fc270bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186479578}] :answer-field/correct {:answer/id #uuid "90695084-425d-5a63-8e98-c52c1fc270bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186479578} :answer-field/id #uuid "f7d10e84-318f-5815-a469-6c3b1e58e115" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479821}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c7c69cd2-d2ae-54a6-bb6d-38d0dd05009e" :question/math-academy-id "q-175906" :question/problem "If $x=-4$ and $y=3,$ then $\\frac{3x+2}{3}+\\frac{x+y}{2y}=${{field-1}}." :question/worked-solution "Replacing $x$ with $-4$ and $y$ with $3$ in the expression, we get the following:\n\n$$\n\\begin{aligned}\\frac{3x+2}{3}+\\frac{x+y}{2y} & = \\\\ \\frac{3(-4)+2}{3}+\\frac{-4+3}{2(3)} & = \\\\ \\frac{-12+2}{3}+\\frac{(-1)}{6} & = \\\\ -\\frac{10}{3}-\\frac{1}{6} & = \\\\ -\\frac{20}{6}-\\frac{1}{6} & = \\\\ \\frac{-20-1}{6} & = \\\\ -\\frac{21}{6} & = \\\\ -\\frac{7}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479838 :knowledge-point/_questions [{:db/id #edb/ref 17592186133965 :knowledge-point/id #uuid "21b84055-253e-50a0-b57f-d288d466bc02" :knowledge-point/title "Evaluating Expressions With Multiple Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fa47c90-822e-5cae-9c90-9811be703303" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186479382} {:answer/id #uuid "13cd9def-d62d-523f-bcc8-d8abfd3e4096" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186479389} {:answer/id #uuid "6bf40da0-404d-5051-9d95-09134da5b392" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186479521} {:answer/id #uuid "8e50ea8a-2303-5b56-a731-389bce2ade00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186479571} {:answer/id #uuid "948f56c7-8f8d-5b25-a476-f644a3998656" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186479582}] :answer-field/correct {:answer/id #uuid "948f56c7-8f8d-5b25-a476-f644a3998656" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186479582} :answer-field/id #uuid "5ce10bcb-f75f-5da4-9cc0-483d51851272" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479776}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "15e3ee11-29b6-56d8-a84c-a4bce1a94db1" :question/math-academy-id "q-67237" :question/problem "Evaluate $\\frac{6x}{2t}-\\frac{3x}{t}$ if $x=-1$ and $t=3$ ." :question/worked-solution "We replace $x$ with $-1$ and $t$ with $3$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{6x}{2t}-\\frac{3x}{t} & = \\\\ \\frac{6(-1)}{2(3)}-\\frac{3(-1)}{3} & = \\\\ \\frac{-6}{6}-\\frac{-3}{3} & = \\\\ -1-(-1) & = \\\\ 0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234263 :knowledge-point/_questions [{:db/id #edb/ref 17592186133963 :knowledge-point/id #uuid "75725a2d-2a8d-563f-99f1-8d071c2ff0c9" :knowledge-point/title "Evaluating Expressions With Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0293cb2c-bda1-5c83-8a0c-78a43f11388d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186479362} {:answer/id #uuid "3a9dcd64-e665-5bbe-99de-6af676869a0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186479446} {:answer/id #uuid "43dc56a9-ef06-5ad5-95ce-cadbd8aaaa52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186479458} {:answer/id #uuid "5de57ac8-c0f1-53fd-85b6-a8da90591bd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186479495} {:answer/id #uuid "e9e04f32-f49f-5493-8cf