wer/value "-\\frac{17}{2}" :db/id #edb/ref 17592186479563} {:answer/id #uuid "9a93ac9b-b8c1-54ca-9c6c-3304b49dca1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186479595} {:answer/id #uuid "d88a5b69-267c-5551-979c-1ae79b8e5657" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{17}" :db/id #edb/ref 17592186479684}] :answer-field/correct {:answer/id #uuid "8998867c-2920-592a-b642-f1440b72c516" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{17}{2}" :db/id #edb/ref 17592186479563} :answer-field/id #uuid "14dd0833-e969-55f0-900c-6ed71684dc4e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479749}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5b344d92-93c1-5290-a0ad-6b1e4107b056" :question/math-academy-id "q-99873" :question/problem "Evaluate $\\frac{p(5p-2)}{6(3p+8)}$ for $p=-3.$" :question/worked-solution "We replace $p$ with $-3$ in the above expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{p(5p-2)}{6(3p+8)} & = \\\\ \\frac{(-3)(5(-3)-2)}{6(3(-3)+8)} & = \\\\ \\frac{(-3)(-15-2)}{6(-9+8)} & = \\\\ \\frac{(-3)(-17)}{6(-1)} & = \\\\ \\frac{51}{(-6)} & = \\\\ -\\frac{17}{2}\\end{aligned}\n$$"}]}
