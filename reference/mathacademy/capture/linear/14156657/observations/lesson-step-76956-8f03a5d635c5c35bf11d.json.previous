{
  "dom_id": "step-76956",
  "name": "Example: \n                    Evaluating a Sum or Difference",
  "problem": "Evaluate $\\dfrac{1}{p} + \\dfrac{1}{2p}$ for $p=4.$",
  "worked_solution": "We replace $p$ with $4$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{1}{p}+\\frac{1}{2p} & = \\\\ \\frac{1}{4}+\\frac{1}{2\\cdot 4} & = \\\\ \\frac{1}{4}+\\frac{1}{8} & = \\\\ \\frac{2}{8}+\\frac{1}{8} & = \\\\ \\frac{2+1}{8} & = \\\\ \\frac{3}{8} & \\end{aligned}\n$$",
  "calculator_instructions": "",
  "fields": [],
  "problem_field_keys": [],
  "answer_fields_complete": null,
  "result": null,
  "proof_feedback": null,
