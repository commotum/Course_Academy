 \n                                        \n                                        <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"25\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D434 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>=</mo></math></mjx-assistive-mml></mjx-container>\n\n\n                                    \n                                \n                                    \n                            \n                                        <div class=\"matheditor-wrapper-answer\" style=\"min-width: 30px; margin-left: 4px; margin-right: 4px;\">\n                                             \n                                        <div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"13\"><span mathquill-command-id=\"85\" class=\"\">−</span><span class=\"mq-fraction mq-non-leaf\" mathquill-command-id=\"87\"><span class=\"mq-numerator\" mathquill-block-id=\"89\"><span mathquill-command-id=\"88\">1</span></span><span class=\"mq-denominator\" mathquill-block-id=\"91\"><span mathquill-command-id=\"90\">3</span></span><span style=\"display:inline-block;width:0\">​</span></span></span></div></div>                \n                                    \n                                \n                                    \n                                        \n                                                </div>\n                    