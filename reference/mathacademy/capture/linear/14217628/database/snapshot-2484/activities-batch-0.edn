#{[{:activity/first-step {:db/id #edb/ref 17592186055713} :activity/id #uuid "e7a68f82-01c3-5f8e-ac40-f72fcee7a2b7" :activity/scope {:db/id #edb/ref 17592186049919 :topic/id #uuid "1e7769c8-1985-591a-bba8-e917166ea21d" :topic/math-academy-id 84} :activity/steps [{:db/id #edb/ref 17592186055652 :step/content {:db/id #edb/ref 17592186054685 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054578 :question/id #uuid "5bb6861a-ea00-5644-bc16-d458cd2bb30f" :question/math-academy-id "e-7375"} :knowledge-point/id #uuid "ae1738d1-3261-5769-ab80-0edcc76ab6f3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048652}] :knowledge-point/questions [{:db/id #edb/ref 17592186055380} {:db/id #edb/ref 17592186055509} {:db/id #edb/ref 17592186233089} {:db/id #edb/ref 17592186233769} {:db/id #edb/ref 17592186234449}] :knowledge-point/title "Computing the Y-Intercept of a Parabola Given Its Graph"} :step/id #uuid "128181ff-b771-504f-87d8-8018de0e4105" :step/math-academy-id 27352 :step/next {:db/id #edb/ref 17592186055716}} {:db/id #edb/ref 17592186055713 :step/content {:db/id #edb/ref 17592186055952 :tutorial/content "Consider the graph of the parabola $y=x^2-2x-3$, shown below.\n\n![](images/c5/c560a02b9c499128b6911aec66ad8ecf1cee2ee3c7d607b80b6e6962fc441289.png)\n\nWe can describe many features of the graph using mathematical terminology:\n\n- The $x$-intercepts of the parabola are at $(-1,0)$ and $(3,0)$. We say that $x=-1$ and $x=3$ are the **roots** (or **zeros**) of the parabola.\n- The parabola intersects the $y$-axis at $\\color{red}(0,-3)$. We say that $-3$ is the **$y$-intercept**. The $y$-intercept is the same as the constant term of the function.\n- The parabola has a \"turning point\" at $\\color{blue}(1,-4)$ which is called the **vertex**. In an upwards parabola (like the one shown above), the vertex is the minimum point, while in a downwards parabola, the vertex is the maximum point.\n- The vertical line $\\color{blue}x=1$ that passes through the vertex is called the **axis of symmetry**. The part of the parabola to the left of the axis of symmetry is the mirror image of the right, and vice versa.\n- This particular parabola is **upward opening** because it has a distinctive $\\smile$ shape. A parabola $y=ax^2+bx+c$ is upward opening if the quadratic coefficient is positive $(a > 0)$.\n- Parabolas can also be **downward opening** with a distinctive $\\frown$ shape. A parabola $y=ax^2+bx+c$ is downward opening if the quadratic coefficient is negative $(a < 0)$.\n\nLet's take a look at an example of a downward opening parabola." :tutorial/id #uuid "38157cb0-baf6-5463-917a-3e22397a6104" :tutorial/math-academy-id 1643 :tutorial/title "Introduction"} :step/id #uuid "d642e4f2-9830-5f74-a1bf-20c4e26c8ac1" :step/math-academy-id 4546 :step/next {:db/id #edb/ref 17592186055714}} {:db/id #edb/ref 17592186055714 :step/content {:db/id #edb/ref 17592186054720 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054486 :question/id #uuid "d7d8ce77-98d8-54d6-9684-edde0ba9e1ea" :question/math-academy-id "e-1450"} :knowledge-point/id #uuid "2ec5627a-4a37-5a14-9b39-1b43b422171f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050763}] :knowledge-point/questions [{:db/id #edb/ref 17592186055158} {:db/id #edb/ref 17592186055159}] :knowledge-point/title "Finding the Vertex and Axis of Symmetry of a Parabola Given Its Graph"} :step/id #uuid "f933d693-32d6-57d7-a9d6-8e75f0fb5999" :step/math-academy-id 4547 :step/next {:db/id #edb/ref 17592186055715}} {:db/id #edb/ref 17592186055715 :step/content {:db/id #edb/ref 17592186054721 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054487 :question/id #uuid "7b9c1bbd-6d33-5fb8-a207-02cf71ba8b0b" :question/math-academy-id "e-1451"} :knowledge-point/id #uuid "6aa081d4-f85a-5239-b034-b78894429611" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049472}] :knowledge-point/questions [{:db/id #edb/ref 17592186055208} {:db/id #edb/ref 17592186055209} {:db/id #edb/ref 17592186233669} {:db/id #edb/ref 17592186233670}] :knowledge-point/title "Finding the Roots of a Parabola Given Its Graph"} :step/id #uuid "4eea49a1-27f3-5ec1-8c5c-c52dee47ff51" :step/math-academy-id 4550 :step/next {:db/id #edb/ref 17592186055652}} {:db/id #edb/ref 17592186055716 :step/content {:db/id #edb/ref 17592186054722 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054488 :question/id #uuid "d43441ff-4ab3-5cfd-ad5d-fbb6f82fa504" :question/math-academy-id "e-1452"} :knowledge-point/id #uuid "867af724-0aa0-599a-8a5f-ee753fd19414" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050790}] :knowledge-point/questions [{:db/id #edb/ref 17592186055166} {:db/id #edb/ref 17592186055168}] :knowledge-point/title "Sketching the Graph of a Parabola Given Its Equation"} :step/id #uuid "ef88d516-7d9b-56b6-8c46-e0b80b4f034e" :step/math-academy-id 4553}] :activity/title "Graphs of General Quadratic Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054926}]}
