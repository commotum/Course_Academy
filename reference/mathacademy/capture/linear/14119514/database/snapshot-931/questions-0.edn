#{[{:db/id #edb/ref 17592186403947 :knowledge-point/_questions [{:db/id #edb/ref 17592186092187 :knowledge-point/id #uuid "5d0cda54-4a4b-5255-b375-ce5e7b604dff" :knowledge-point/title "Solving a Matrix Equation Using Algebraic Manipulation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53d8f566-865b-5d1d-968f-ffc7aeaaf0b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${D}^{-1}$ and ${I}_{n}$" :db/id #edb/ref 17592186403949} {:answer/id #uuid "6898f8cf-ef60-599d-b703-aeb35e14e141" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$D$ and ${I}_{n}$" :db/id #edb/ref 17592186403950} {:answer/id #uuid "0329ed6f-dee9-5205-b238-18984ed73972" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${D}^{-1}$ and $D$" :db/id #edb/ref 17592186403951} {:answer/id #uuid "a15466de-3c65-5970-8e36-5b25e21ca209" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${D}^{-1}$ and ${D}^{-1}$" :db/id #edb/ref 17592186403952} {:answer/id #uuid "daabc2d4-f4ce-50f8-9f41-a9e7585ac6e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$D$ and $z$" :db/id #edb/ref 17592186403953}] :answer-field/correct {:answer/id #uuid "53d8f566-865b-5d1d-968f-ffc7aeaaf0b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${D}^{-1}$ and ${I}_{n}$" :db/id #edb/ref 17592186403949} :answer-field/id #uuid "4cf7d7a2-cf8f-5d79-a5a3-2c7fb6abb055" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403948}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "863bd08e-01cd-5a69-b3ce-bacc176f8b4b" :question/math-academy-id "q-78559" :question/problem "Consider a system of $n$ linear equations in $n$ variables, written in matrix form as $D\\,z=c.$ Here, $D$ is the non-singular coefficient matrix of the system, $z$ is the column vector containing the variables, and $c$ is the column vector containing the constants. The unique solution of the system can be found using the method shown below:\n\n$$\n\\begin{aligned}D\\,z & =c \\\\ {D}^{-1}D\\,z & =\\boxed{\\phantom{D^{-1}}}c \\\\ \\boxed{\\phantom{I_n}}z & ={D}^{-1}\\,c \\\\ z & ={D}^{-1}\\,c\\end{aligned}\n$$\n\nFrom top to bottom and right to left, what are the missing parts of the derivation?" :question/worked-solution "Since $D$ is not singular, it must have an inverse ${D}^{-1}.$ Now, pre-multiplying both sides of the equation $D\\,z=c$ by ${D}^{-1},$ we obtain the following:\n\n$$\n\\begin{aligned}D\\,z & =c \\\\ {D}^{-1}D\\,z & ={D}^{-1}c \\\\ {I}_{n}\\,z & ={D}^{-1}\\,c \\\\ z & ={D}^{-1}\\,c\\end{aligned}\n$$\n\nTherefore, the missing parts are ${D}^{-1}$ and ${I}_{n}.$"}] [{:db/id #edb/ref 17592186348099 :knowledge-point/_questions [{:db/id #edb/ref 17592186092187 :knowledge-point/id #uuid "5d0cda54-4a4b-5255-b375-ce5e7b604dff" :knowledge-point/title "Solving a Matrix Equation Using Algebraic Manipulation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6788781d-31d5-5bd7-b27b-68afaa4d9325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=B\\,d\\,A" :db/id #edb/ref 17592186346254} {:answer/id #uuid "9bded5b5-b83d-570e-9629-cd29113e20b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=B\\,d\\,{A}^{-1}" :db/id #edb/ref 17592186346708} {:answer/id #uuid "a4a497d7-ea8a-5a5f-b4fd-1d8c483ff5a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={A}^{-1}B\\,d" :db/id #edb/ref 17592186346783} {:answer/id #uuid "b6d2cc68-86a2-5604-8401-931a07c9e6b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=BA\\,d" :db/id #edb/ref 17592186346945} {:answer/id #uuid "e304282a-e8e7-5d48-b8b7-fb2bbc3eab5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=AB\\,d" :db/id #edb/ref 17592186347347}] :answer-field/correct {:answer/id #uuid "e304282a-e8e7-5d48-b8b7-fb2bbc3eab5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=AB\\,d" :db/id #edb/ref 17592186347347} :answer-field/id #uuid "b4e01459-2873-55b9-8f7c-c4fb473002de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347921}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5f0cd9e3-58c9-5ff5-838e-38f22a6e88cb" :question/math-academy-id "q-78570" :question/problem "Consider a matrix equation ${A}^{-1}\\,x=B\\,d,$ where $A$ and $B$ are $7\\times 7$ non-singular matrices, while $x$ and $d$ are $7\\times 1$ column vectors. Solve the equation for $x.$" :question/worked-solution "Pre-multiplying both sides of the equation ${A}^{-1}\\,x=B\\,d$ by $A,$ we obtain\n\n$$\n\\begin{aligned}{A}^{-1}\\,x & =B\\,d \\\\ A{A}^{-1}\\,x & =AB\\,d \\\\ {I}_{7}\\,x & =AB\\,d \\\\ x & =AB\\,d.\\end{aligned}\n$$"}]}
