b/ref 17592186082987 :question/id #uuid "34a604f1-d3e2-5746-818a-17c572ff2243" :question/math-academy-id "e-4060"} :knowledge-point/id #uuid "67d294d0-542a-5332-b837-256792817dde" :knowledge-point/questions [{:db/id #edb/ref 17592186083885} {:db/id #edb/ref 17592186083887} {:db/id #edb/ref 17592186234206} {:db/id #edb/ref 17592186234518} {:db/id #edb/ref 17592186234519} {:db/id #edb/ref 17592186520450} {:db/id #edb/ref 17592186520498} {:db/id #edb/ref 17592186520511}] :knowledge-point/title "Evaluating Common Logarithms of Fractions and Roots"} :step/id #uuid "0e4c07a5-d038-53d5-9e80-41609421ecfc" :step/math-academy-id 14413 :step/next {:db/id #edb/ref 17592186084030}} {:db/id #edb/ref 17592186084030 :step/content {:db/id #edb/ref 17592186083175 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082988 :question/id #uuid "b4b8a7af-fe7c-5d8a-80f4-c997c404a889" :question/math-academy-id "e-4061"} :knowledge-point/id #uuid "60270e0c-a60c-5a5f-8993-3d8362081c8f" :knowledge-point/questions [{:db/id #edb/ref 17592186083730} {:db/id #edb/ref 17592186083731} {:db/id #edb/ref 17592186234072} {:db/id #edb/ref 17592186234408} {:db/id #edb/ref 17592186520448} {:db/id #edb/ref 17592186520469}] :knowledge-point/title "Evaluating Expressions Containing Common Logarithms Using a Calculator"} :step/id #uuid "0bde6944-9073-5c4e-a281-06f1c4f6f6fc" :step/math-academy-id 14414} {:db/id #edb/ref 17592186084055 :step/content {:db/id #edb/ref 17592186084436 :tutorial/content "Suppose we are given the logarithm $\\log (100).$ If no base is specified, then by default the base is equal to $10.$\n\nIn our example, we have\n\n$$\n\\log(100)=\\log_{10}(100)=\\log_{10}(10^2) = 2.\n$$\n\nIn general, the logarithm with base $10$ is called the **common logarithm**, and is defined as follows:\n\n$a = 10^x$ is equivalent to $\\log{a} = x$\n\nEverything we did with logarithms, we can do with the common logarithm. For example, we can\n\n- convert between exponential and logarithm form,\n\n- evaluate common logarithm expressions, and\n\n- calculate specific values of $\\log a$ using a calculator.\n\nFinally, note that most calculators have a button for the common logarithm. This is usually denoted $\\log_{10}$ or simply $\\log.$" :tutorial/id #uuid "624f3e19-2500-53b2-ad06-eeb824d256a0" :tutorial/math-academy-id 2869 :tutorial/title "Introduction"} :step/id #uuid "69d8dfa2-ca90-55fc-a1e3-baa65975b4db" :step/math-academy-id 15322 :step/next {:db/id #edb/ref 17592186084027}}] :activity/title "The Common Logarithm" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083421}]}
