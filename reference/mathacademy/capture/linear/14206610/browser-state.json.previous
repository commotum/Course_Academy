  "live_records": {
    "q-66543": {
      "dom_id": "step-q66543",
      "name": "Question 1",
      "problem": "${10}^{-2}=\\frac{1}{100}$ can be expressed as",
      "worked_solution": "The common logarithm of $a$ is defined as follows:\n\n$a={10}^{x}$ is equivalent to $\\operatorname{log}⁡a=x$\n\nIf we compare ${10}^{-2}=\\frac{1}{100}$ with ${10}^{x}=a,$ we get that $a=\\frac{1}{100}$ and $x=-2.$\n\nTherefore, the given equation can be expressed as $\\operatorname{log}⁡(\\frac{1}{100})=-2.$",
      "calculator_instructions": "",
