#{[{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186419640} :activity/id #uuid "542e5824-46d0-5a80-a9f2-36fc58d51cbf" :activity/scope {:db/id #edb/ref 17592186049004 :topic/id #uuid "d28e701c-f952-587a-ba2a-6c1d3807d35a" :topic/math-academy-id 2641} :activity/steps [{:db/id #edb/ref 17592186419638 :step/content {:db/id #edb/ref 17592186419637 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14749e55-fcd9-5cab-b71b-ab77bde17dca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186419604} {:answer/id #uuid "31c492b8-531d-5421-96e8-37acf0421d51" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186419607} {:answer/id #uuid "436c60b7-f2a7-5cc5-ada7-157322f4a843" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186419608} {:answer/id #uuid "98edc3ec-d794-589b-8439-5ef103206375" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186419620} {:answer/id #uuid "fe6cf5ba-4043-5780-8f58-4c07333d4125" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186419627}] :answer-field/correct {:db/id #edb/ref 17592186419620} :answer-field/id #uuid "7adb391f-ba37-5aef-9e23-79d9c1428c63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186419632}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ee3460a5-a9ce-5793-8247-ccd3db242273" :question/math-academy-id "q-113675" :question/problem "Which of the following statements are true?\n\n- $-36≡-19\\,(\\text{mod}\\,7)$\n- $15≡-26\\,(\\text{mod}\\,10)$\n- $-27≡9\\,(\\text{mod}\\,4)$" :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWith that in mind, let's analyze each statement in turn.\n\n- Statement I is false because $7∤(-36-(-19)).$ Notice that $-36-(-19)=-17,$ which is not divisible by $7.$\n\n- Statement II is false because $10∤(15-(-26)).$ Notice that $15-(-26)=41,$ which is not divisible by $10.$\n\n- Statement III is true because $4\\,|\\,(-27-9).$ There is no remainder:\n\n$$\n(-27-9)÷4=-36÷4=-9\n$$\n\nTherefore, the correct answer is \"III only.\""} :step/id #uuid "50b54d0a-1dd6-5c1c-9143-afdb86424602" :step/next {:db/id #edb/ref 17592186419639}} {:db/id #edb/ref 17592186419639 :step/content {:db/id #edb/ref 17592186419633 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "209a85c7-16ad-5315-9321-6bb903fa5398" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186419605} {:answer/id #uuid "28bfae27-6981-5691-9a5a-62fdf2e3c47c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186419606} {:answer/id #uuid "7596282f-3290-5e4c-b0bc-7c7fefc0d1f5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186419613} {:answer/id #uuid "aaaf34e3-c318-5109-9b20-14ae45f46079" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186419621} {:answer/id #uuid "f9d05e4d-4d94-5fc7-aaf2-511184e63ae5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186419626}] :answer-field/correct {:db/id #edb/ref 17592186419606} :answer-field/id #uuid "6f52fc05-4e89-5fdf-9a0b-799264a128a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186419631}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "237ee44c-ddeb-50a9-b28f-87d4edfa4e60" :question/math-academy-id "q-212521" :question/problem "Given that $-21≡-12\\,(\\text{mod}\\,n),$ which of the following could be the value of $n?$\n\n- $n=3$\n- $n=9$\n- $n=12$" :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWe have $a-b=-21-(-12)=-9.$\n\nWith that in mind, let's analyze each statement in turn.\n\n- Note that $3∣(-9)$ because $(-9)÷3=-3,$ and there is no remainder. Therefore, the statement is true when $n=3.$\n\n- Note that $9∣(-9)$ because $(-9)÷9=-1,$ and there is no remainder. Therefore, the statement is true when $n=9.$\n\n- Note that $12∤(-9).$ Therefore, the statement is false when $n=12.$\n\nTherefore, the correct answer is \"I and II only.\""} :step/id #uuid "b6185db5-f13a-5f65-96d8-0e2c10a7500a"} {:db/id #edb/ref 17592186419640 :step/content {:db/id #edb/ref 17592186419634 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e51f6df-e206-53ac-8c6a-e8c968fdbab4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186419609} {:answer/id #uuid "56156d58-5991-5469-83af-0516720e5fe0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186419611} {:answer/id #uuid "845c3642-d5b7-51cc-8c24-5c719388349e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186419616} {:answer/id #uuid "ccd62da4-495d-5a88-9b81-83fe4d43949a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186419623} {:answer/id #uuid "e6e785cd-3ae0-5934-b08f-1e3d607da075" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186419625}] :answer-field/correct {:db/id #edb/ref 17592186419616} :answer-field/id #uuid "2ffa6280-410f-5863-a63a-238138cfb0ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186419628}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7dad68af-5609-5774-82ac-907f4e4304f5" :question/math-academy-id "q-76962" :question/problem "Given that $19≡5\\,(\\text{mod}\\,n),$ which of the following could be the value of $n?$\n\n- $n=7$\n- $n=9$\n- $n=2$" :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWe have $a-b=19-5=14.$\n\nWith that in mind, let's analyze each statement in turn.\n\n- Note that $7∣14$ because $14÷7=2,$ and there is no remainder. Therefore, the statement is true when $n=7.$\n\n- Note that $9∤14.$ Therefore, the statement is false when $n=9.$\n\n- Note that $2∣14$ because $14÷2=7,$ and there is no remainder. Therefore, the statement is true when $n=2.$\n\nTherefore, the correct answer is \"I and III only.\""} :step/id #uuid "c56685a8-e8eb-5b43-8922-8c4993a94d78" :step/next {:db/id #edb/ref 17592186419641}} {:db/id #edb/ref 17592186419641 :step/content {:db/id #edb/ref 17592186419635 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51ed1169-4dcb-5651-bbbd-c7b884f63478" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186419610} {:answer/id #uuid "5eef336e-d43f-594c-8c6c-e0250235815a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186419612} {:answer/id #uuid "85e9b13d-72c1-546a-b6fc-eafc300cdb59" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186419617} {:answer/id #uuid "965cecae-b949-5417-b3cc-5e430c2f2b6b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186419619} {:answer/id #uuid "e5f886d7-3b46-5e40-b8ea-797128add774" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186419624}] :answer-field/correct {:db/id #edb/ref 17592186419617} :answer-field/id #uuid "5b9776a6-3e68-58ea-b6e5-5ee338447367" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186419630}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c37fbba7-25b2-5279-9899-188d8dedca8a" :question/math-academy-id "q-103380" :question/problem "Which of the following statements are true?\n\n- $-7≡27\\,(\\text{mod}\\,5)$\n- $-5≡15\\,(\\text{mod}\\,6)$\n- $11≡18\\,(\\text{mod}\\,7)$" :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWith that in mind, let's analyze each statement in turn.\n\n- Statement I is false because $5∤(-7-27).$ Notice that $-7-27=-34,$ which is not divisible by $5.$\n\n- Statement II is false because $6∤(-5-15).$ Notice that $-5-15=-20,$ which is not divisible by $6.$\n\n- Statement III is true because $7\\,|\\,(11-18).$ There is no remainder:\n\n$$\n(11-18)÷7=-7÷7=-1\n$$\n\nTherefore, the correct answer is \"III only.\""} :step/id #uuid "fd272049-411e-5017-89c4-63e90889b13c" :step/next {:db/id #edb/ref 17592186419642}} {:db/id #edb/ref 17592186419642 :step/content {:db/id #edb/ref 17592186419636 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bc1a27e-8427-57e6-ac2e-b947a4b1556a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186419603} {:answer/id #uuid "7a197d0d-9913-5fb2-bf3c-4835cbe300af" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186419614} {:answer/id #uuid "7d9d3ee8-5a6d-521f-b277-71c7303fe530" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186419615} {:answer/id #uuid "8a94c9aa-c1e4-5350-85e8-39c118369fb4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186419618} {:answer/id #uuid "c959a564-e622-5a0d-8e5b-fc810aa60b43" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186419622}] :answer-field/correct {:db/id #edb/ref 17592186419603} :answer-field/id #uuid "3da5eb72-bc77-5ebc-a47a-3006549126c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186419629}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e9350880-d00e-5d41-adb3-52fc6c8e0846" :question/math-academy-id "q-113664" :question/problem "Which of the following statements are true?\n\n- $-5≡8\\,(\\text{mod}\\,7)$\n- $-23≡-5\\,(\\text{mod}\\,6)$\n- $-7≡-1\\,(\\text{mod}\\,2)$" :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWith that in mind, let's analyze each statement in turn.\n\n- Statement I is false because $7∤(-5-8).$ Notice that $-5-8=-13,$ which is not divisible by $7.$\n\n- Statement II is true because $6∣(-23-(-5)).$ There is no remainder:\n\n$$\n(-23-(-5))÷6=-18÷6=-3\n$$\n\n- Statement III is true because $2\\,|\\,(-7-(-1)).$ There is no remainder:\n\n$$\n(-7-(-1))÷2=-6÷2=-3\n$$\n\nTherefore, the correct answer is \"II and III only.\""} :step/id #uuid "ffadd7bc-757c-5488-b522-842379494aad" :step/next {:db/id #edb/ref 17592186419638}}] :activity/title "Modular Congruence" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186419602}]}
