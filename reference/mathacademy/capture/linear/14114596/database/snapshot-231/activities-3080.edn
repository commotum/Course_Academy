#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186162740} :activity/id #uuid "9610f5eb-4c2a-5356-ab60-5e12da9a7560" :activity/scope {:db/id #edb/ref 17592186048610 :topic/id #uuid "ade9d1d5-3224-5403-9c8b-f3e5be0db3c5" :topic/math-academy-id 3080} :activity/steps [{:db/id #edb/ref 17592186162740 :step/content {:db/id #edb/ref 17592186163373 :tutorial/content "Suppose $a$ and $b$ are integers where $a\\neq 0.$ We say that $\\boldsymbol a$ **divides** $\\boldsymbol b$ and write \n\n$$\na\\mid b\n$$\n\nif there exists an integer $k$ such that\n\n$$\nb = ka.\n$$\n\nWe can write this more formally as follows:\n\n$$\na\\mid b \\qquad \\Leftrightarrow\\qquad \\exists k \\in \\mathbb Z, b = ka\n$$\n\nFor example, $2\\mid 8$ because there exists an integer ${\\color{blue}{k}} = {\\color{blue}{4}}$ such that\n\n$$\n8 = {\\color{blue}{4}}\\cdot 2.\n$$" :tutorial/id #uuid "100e1a89-de92-5d1a-86ba-bcd72190ae6d" :tutorial/math-academy-id 9351 :tutorial/title "Introduction"} :step/id #uuid "b0fa360f-9e02-5a70-b17f-90340c91003c" :step/math-academy-id 162161 :step/next {:db/id #edb/ref 17592186162741}} {:db/id #edb/ref 17592186162741 :step/content {:db/id #edb/ref 17592186161923 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161726 :question/id #uuid "ada57336-8fdb-584d-b03c-7b7e31cbf55a" :question/math-academy-id "e-14981"} :knowledge-point/id #uuid "d0e960a4-872c-55c0-8439-60426671f5cf" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050884}] :knowledge-point/questions [{:db/id #edb/ref 17592186162471} {:db/id #edb/ref 17592186162472} {:db/id #edb/ref 17592186407526} {:db/id #edb/ref 17592186407534} {:db/id #edb/ref 17592186407535} {:db/id #edb/ref 17592186407536}] :knowledge-point/title "Stating the Definition of Integer Divisibility"} :step/id #uuid "3902c14b-dd71-5c37-bd20-4fb2177d36a2" :step/math-academy-id 162162 :step/next {:db/id #edb/ref 17592186162744}} {:db/id #edb/ref 17592186162742 :step/content {:db/id #edb/ref 17592186161924 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161727 :question/id #uuid "1df938d2-db9c-5335-9f54-e44c40659992" :question/math-academy-id "e-14982"} :knowledge-point/id #uuid "05d3b242-3ecd-54d6-a763-925e2baada2c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049558}] :knowledge-point/questions [{:db/id #edb/ref 17592186162469} {:db/id #edb/ref 17592186162473} {:db/id #edb/ref 17592186407525} {:db/id #edb/ref 17592186407527} {:db/id #edb/ref 17592186407528} {:db/id #edb/ref 17592186407529} {:db/id #edb/ref 17592186407533}] :knowledge-point/title "Stating the Definition of Non-Divisibility"} :step/id #uuid "3ae5e0bc-75a2-5dd9-b814-d4bdb58d123f" :step/math-academy-id 162166 :step/next {:db/id #edb/ref 17592186162743}} {:db/id #edb/ref 17592186162743 :step/content {:db/id #edb/ref 17592186161925 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161728 :question/id #uuid "2b06423e-99a9-5ac2-a413-93aa71ac4fbe" :question/math-academy-id "e-14983"} :knowledge-point/id #uuid "559e653a-2ab9-54a8-84e3-02bf106a8f47" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051085}] :knowledge-point/questions [{:db/id #edb/ref 17592186162470} {:db/id #edb/ref 17592186162474} {:db/id #edb/ref 17592186407530} {:db/id #edb/ref 17592186407531} {:db/id #edb/ref 17592186407532} {:db/id #edb/ref 17592186407537}] :knowledge-point/title "Inferring Divisibility in Algebraic Expressions"} :step/id #uuid "d795623f-e963-5223-922d-0146dbda23bb" :step/math-academy-id 162169} {:db/id #edb/ref 17592186162744 :step/content {:db/id #edb/ref 17592186163374 :tutorial/content "We have the following definition of integer divisibility. \n\n$$\na\\mid b \\qquad \\Leftrightarrow\\qquad \\exists k \\in \\mathbb Z, b = ka\n$$\n\nIf $a$ **does not divide** $b,$ we write $a\\not\\mid b.$ Therefore, by negating the two statements above, we get the following equivalence:\n\n$$\n\\begin{aligned}¬(a∣b)\\, & ⇔\\,¬(∃k\\in Z,b=ka) \\\\ a∤b\\, & ⇔\\,∀k\\in Z,b\\ne ka\\end{aligned}\n$$\n\nThus, $a\\not\\mid b$ means that $b \\neq ak$ *for all* integers $k.$\n\nFor example, $3\\not \\mid 8$ because there does not exist an integer ${\\color{red}{k_2}}$ such that\n\n$$\n8 = {\\color{red}{k_2}}\\cdot 3.\n$$" :tutorial/id #uuid "1a06989c-367e-5d20-840c-e5ab34c82911" :tutorial/math-academy-id 9355 :tutorial/title "Non-Divisibility"} :step/id #uuid "7cc84b4a-0d80-572a-b21b-ca0aa54f80ff" :step/math-academy-id 162181 :step/next {:db/id #edb/ref 17592186162742}}] :activity/title "Integer Divisibility" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186162213}]}
