#{[{:db/id #edb/ref 17592186483357 :knowledge-point/_questions [{:db/id #edb/ref 17592186147415 :knowledge-point/id #uuid "40344731-b251-5ba9-8e05-775144455c95" :knowledge-point/title "Squaring a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a4c5101-e4ab-510b-a90b-1f80dc5e7721" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{81}" :db/id #edb/ref 17592186482863}] :answer-field/correct {:answer/id #uuid "1a4c5101-e4ab-510b-a90b-1f80dc5e7721" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{81}" :db/id #edb/ref 17592186482863} :answer-field/id #uuid "30583036-b5c2-5e98-859d-3145c20f317d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186483252}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "319f568f-1d7f-56e6-aaee-eed8bdcd4507" :question/math-academy-id "q-166804" :question/problem "Expressed as a single fraction, the exact area of the plot of land is$\\,${{field-1}}\nhectares." :question/worked-solution "The exact area of land is ${(\\frac{7}{9})}^{2}$ hectares.\n\nWriting ${(\\frac{7}{9})}^{2}$ with multiplication signs, we get\n\n$$\n\\begin{aligned}{(\\frac{7}{9})}^{2} & ={{\\frac{7}{9}\\times \\frac{7}{9}}_{⏟}}_{2\\text{ times}} \\\\  & =\\frac{7\\times 7}{9\\times 9} \\\\  & =\\frac{49}{81}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{(\\frac{7}{9})}^{2}=\\frac{49}{81}.\n$$"}] [{:db/id #edb/ref 17592186483372 :knowledge-point/_questions [{:db/id #edb/ref 17592186054858 :knowledge-point/id #uuid "ef1ed47e-ac17-5e98-8f3c-ea15497f7ff7" :knowledge-point/title "Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2675299-d6cf-5aaa-92e1-6451ffe45542" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "47.3" :db/id #edb/ref 17592186483165}] :answer-field/correct {:answer/id #uuid "d2675299-d6cf-5aaa-92e1-6451ffe45542" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "47.3" :db/id #edb/ref 17592186483165} :answer-field/id #uuid "efce6c9c-9575-5794-8252-ed79a4699e45" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186483334}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5d4461c0-b1a3-50ea-9b6f-7279220b9f4b" :question/math-academy-id "q-166805" :question/problem "To prepare liquid fertilizer, $5.5$ grams of fertilizer powder should be dissolved in a liter of water. How much powder must be dissolved in $8.6$ liters of water to make fertilizer?\n\nExpressed as a decimal, \n{{field-1}}\n$\\,$grams of powder must be dissolved in $8.6$ liters of water." :question/worked-solution "To determine the amount of powder that must be dissolved in $8.6$ liters of water, we have to multiply $8.6$ by $5.5.$\n\nWe proceed by multiplying the two numbers just as we would with whole numbers.\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  &  & \\,\\,\\,\\,\\,\\begin{aligned}\\boxed{3} \\\\ \\boxed{3}\\end{aligned}\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{0}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  &  & \\,\\,\\,\\,8\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,.6\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,.5\\,\\,\\,\\, \\\\  &  &  & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\,4\\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\,4\\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $1$ decimal place in $8.6$ and there is $1$ decimal place in $5.5.$\nTherefore, their product will have $1+1=2$ decimal places.\n\nSo, we take our value of $4730$ and add a decimal point to make a number with $2$ decimal places.\n\n$$\n47\\,\\overset{↓}{.}\\,\\,\\,{{30}_{⏟}}_{2\\text{ digits}}\n$$\n\nHence, $8.6\\times 5.5=47.30=47.3.$\n\nWe conclude that $47.3$ grams of powder must be dissolved in $8.6$ liters of water."}] [{:db/id #edb/ref 17592186483385 :knowledge-point/_questions [{:db/id #edb/ref 17592186138368 :knowledge-point/id #uuid "28d5aa07-8c26-5964-bb34-a500d8e0a9e9" :knowledge-point/title "Adding Numbers With One and Two Decimal Places"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b26ff19c-06ea-5b77-a484-27ad05fc75d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.48" :db/id #edb/ref 17592186483116}] :answer-field/correct {:answer/id #uuid "b26ff19c-06ea-5b77-a484-27ad05fc75d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.48" :db/id #edb/ref 17592186483116} :answer-field/id #uuid "b59f696c-7ffe-5130-82fd-2b129a555d20" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186483311}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "88140710-3cf2-5db3-9844-9b23db7c5cfc" :question/math-academy-id "q-166806" :question/problem "Orlando used $0.3\\,\\text{kg}$ of powdered fertilizer on Monday morning. He then used $0.18\\,\\text{kg}$ of powdered fertilizer on Monday afternoon. How much powder did Orlando use that day?\n\nExpressed as a decimal, Orlando used$\\,$\n{{field-1}}\n$\\text{kg}$ of powdered fertilizer." :question/worked-solution "To determine the amount of powder Orlando used, we need to calculate the sum $0.3+0.18.$\n\nThere is $1$ decimal place in $0.3$ and $2$ decimal places in $0.18.$\n\nTo add the numbers, they both need to have the same number of decimals. Hence, we rewrite the first number so that it has $2$ decimal places:\n\n$$\n0.3=0.30\n$$\n\nNext, we line up the decimal points:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\  &  &  & \\,\\,\\,\\,.\\,\\,\\,\\, &  & \\end{aligned}\n$$\n\nFinally, we proceed by adding the two numbers just as we would with whole numbers:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\,\\begin{aligned} \\\\ \\end{aligned}\\,\\,\\,\\, &  &  \\\\  &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\,\\end{aligned}\n$$\n\nTherefore, Orlando used $0.48\\,\\text{kg}$ of powdered fertilizer."}] [{:db/id #edb/ref 17592186483416 :knowledge-point/_questions [{:db/id #edb/ref 17592186054862 :knowledge-point/id #uuid "f5d09700-00bd-5c67-93cf-f99c574732d7" :knowledge-point/title "Subtracting Decimals: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1010a43c-fb7e-515d-bae0-b8eed8842553" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.47" :db/id #edb/ref 17592186482837}] :answer-field/correct {:answer/id #uuid "1010a43c-fb7e-515d-bae0-b8eed8842553" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.47" :db/id #edb/ref 17592186482837} :answer-field/id #uuid "9795c27f-91f6-581d-90ed-a7431126765e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186483300}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d5ff9fd7-f4d9-5987-9375-7f097e607931" :question/math-academy-id "q-166807" :question/problem "The package of powdered fertilizer that Orlando opened before starting work on Monday weighed $0.95\\,\\text{kg}.$ How much fertilizer was left in the package after he'd finished on Monday afternoon?\n\nExpressed as a decimal, there was$\\,$\n{{field-1}}\n$\\text{kg}$ of fertilizer left." :question/worked-solution "In part 3, we find that Orlando used $0.48\\,\\text{kg}$ of fertilizer on Monday.\n\nTo determine the amount of fertilizer left in the package, we need to calculate $0.95-0.48.$\n\nFirst, we line up the decimal points:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,-\\,\\,\\,\\, &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\  &  &  & \\,\\,\\,\\,.\\,\\,\\,\\, &  & \\end{aligned}\n$$\n\nNext, we proceed by subtracting the two numbers just as we would with whole numbers:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\,\\,\\begin{aligned} \\\\ \\end{aligned}\\,\\,\\,\\, &  & \\,\\,\\,\\,\\,\\begin{aligned} \\\\ 8\\end{aligned}\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\begin{aligned} \\\\ 15\\end{aligned}\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,-\\,\\,\\,\\, &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,7\\,\\,\\,\\,\\end{aligned}\n$$\n\nTherefore, $0.47\\,\\text{kg}$ of fertilizer remained."}] [{:db/id #edb/ref 17592186483420 :knowledge-point/_questions [{:db/id #edb/ref 17592186073705 :knowledge-point/id #uuid "cb42b265-bcf6-58ef-aa08-489dec5d1104" :knowledge-point/title "Converting the Result to a Mixed Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a23b3b85-3b3f-5cad-b5eb-d6d6c2bf5943" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,\\frac{1}{3}" :db/id #edb/ref 17592186483084}] :answer-field/correct {:answer/id #uuid "a23b3b85-3b3f-5cad-b5eb-d6d6c2bf5943" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,\\frac{1}{3}" :db/id #edb/ref 17592186483084} :answer-field/id #uuid "5138ec1b-11c8-5624-8ae0-30b14a7ff9f7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186483265}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e29d8681-5a80-5808-b535-ab9dc2e4503c" :question/math-academy-id "q-166808" :question/problem "During a particular weekend, Orlando made $10\\,\\frac{1}{2}$ liters of liquid fertilizer. He used $9\\,\\frac{1}{6}$ liters from this amount. How much liquid fertilizer did Orlando have left over? Express your answer as a mixed number in its lowest terms.\n\nOrlando had$\\,$\n{{field-1}}\n$\\,$liters of liquid fertilizer left over." :question/worked-solution "Orlando had $(10\\,\\frac{1}{2}-9\\,\\frac{1}{6})$ liters of liquid fertilizer left over.\n\nWriting $10\\,\\frac{1}{2}$ as an improper fraction, we have\n\n$$\n10\\,\\frac{1}{2}=\\frac{10\\times 2+1}{2}=\\frac{21}{2}.\n$$\n\nWriting $9\\,\\frac{1}{6}$ as an improper fraction, we have\n\n$$\n9\\,\\frac{1}{6}=\\frac{9\\times 6+1}{6}=\\frac{55}{6}.\n$$\n\nTherefore, our problem now is to work out the following:\n\n$$\n\\frac{21}{2}-\\frac{55}{6}\n$$\n\nTo subtract two fractions with unlike denominators, we need to express each fraction as an equivalent fraction with a common denominator.\n\nIn this question, we can make a common denominator of $6.$\n\nTo put $\\frac{21}{2}$ over a denominator of $6,$ we multiply the numerator and denominator by $3:$\n\n$$\n\\frac{21}{2}=\\frac{21\\times 3}{2\\times 3}=\\frac{63}{6}\n$$\n\nWe can now subtract the fractions. We keep the denominator the same, and we subtract the numerators:\n\n$$\n\\frac{63}{6}-\\frac{55}{6}=\\frac{8}{6}\n$$\n\nSimplifying, we have\n\n$$\n\\frac{8}{6}=\\frac{8÷2}{6÷2}=\\frac{4}{3}.\n$$\n\nFinally, we convert back to a mixed number:\n\n$$\n\\frac{4}{3}=1\\,\\text{R}\\,1=1\\,\\frac{1}{3}\n$$\n\nTherefore, Orlando had $1\\,\\frac{1}{3}$ liters of liquid fertilizer left over."}] [{:db/id #edb/ref 17592186483369 :knowledge-point/_questions [{:db/id #edb/ref 17592186073676 :knowledge-point/id #uuid "e27e3a75-779a-5817-a2ae-27b58cbac913" :knowledge-point/title "Rounding to the Nearest Whole Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c41f39ef-abdb-5ed8-84f4-7d095d72ad6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186483139}] :answer-field/correct {:answer/id #uuid "c41f39ef-abdb-5ed8-84f4-7d095d72ad6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186483139} :answer-field/id #uuid "0bba3ab6-f9f8-574e-8261-1a84cd0c3faa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186483243}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5606b628-dd5a-51e3-a0c0-f4f6b8db27d7" :question/math-academy-id "q-166809" :question/problem "Orlando bought $6$ packages of powdered fertilizer, for which he paid $$96.44.$ Estimate the price of each package by rounding the amount of money he spent to the nearest dollar.\n\nThe approximate price of each package is $\n{{field-1}}." :question/worked-solution "To estimate the price of each package, we need to find an approximation to $96.44÷6.$\n\nSo, we round the dividend to the nearest whole number:\n\n$$\n96.44\\to 96\n$$\n\nNow, we divide $96$ by $6$ as usual:\n\n$$\n96÷6=16\n$$\n\nTherefore, the approximate price of each package is $$16.$"}]}
