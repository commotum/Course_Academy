#{[{:activity/first-step {:db/id #edb/ref 17592186148262} :activity/id #uuid "6c51ae60-8fe3-549c-b67d-8a5d1d77e244" :activity/scope {:db/id #edb/ref 17592186048381 :topic/id #uuid "9a91ea80-ff07-5f55-ac26-f678345641da" :topic/math-academy-id 2476} :activity/steps [{:db/id #edb/ref 17592186148262 :step/content {:db/id #edb/ref 17592186148793 :tutorial/content "We can use our knowledge of fraction multiplication to square fractions.\n\nFor example, let's evaluate the following squared fraction:\n\n$$\n\\left(\\dfrac{3}{5}\\right)^2\n$$\n\nFirst, we write\n\n$$\n\\left(\\dfrac{3}{5}\\right)^2\n$$\n\nwith multiplication signs:\n\n$$\n(\\frac{3}{5})^{2} = \\frac{3}{5} \\cdot \\frac{3}{5}_(⏟)_([math]\\color{blue}2[/math] times)\n$$\n\nNow, we calculate the product of the two fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\begin{aligned}\n(\\frac{3}{5})^{2} &= \\frac{3}{5} \\cdot \\frac{3}{5} \\\\\n&= \\frac{3 \\cdot 3}{5 \\cdot 5} \\\\\n&= \\frac{9}{25}\n\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\left(\\dfrac{3}{5}\\right)^2= \\dfrac{9}{25}\n$$" :tutorial/id #uuid "f0e87aeb-338c-5f8d-be18-59b85ed28aac" :tutorial/math-academy-id 8806 :tutorial/title "Introduction"} :step/id #uuid "60be27f5-6cd2-5965-9278-49fd234a2f60" :step/math-academy-id 176246 :step/next {:db/id #edb/ref 17592186148263}} {:db/id #edb/ref 17592186148263 :step/content {:db/id #edb/ref 17592186147415 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147171 :question/id #uuid "a4cc2406-5f53-5a80-9e85-9cafd1fa2576" :question/math-academy-id "e-14182"} :knowledge-point/id #uuid "40344731-b251-5ba9-8e05-775144455c95" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049253} {:db/id #edb/ref 17592186050170}] :knowledge-point/questions [{:db/id #edb/ref 17592186147739} {:db/id #edb/ref 17592186147927} {:db/id #edb/ref 17592186483357}] :knowledge-point/title "Squaring a Fraction"} :step/id #uuid "e85e09d4-1db1-5d14-8624-322891620292" :step/math-academy-id 176247 :step/next {:db/id #edb/ref 17592186148264}} {:db/id #edb/ref 17592186148264 :step/content {:db/id #edb/ref 17592186147416 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147172 :question/id #uuid "24da41ad-50c6-5654-8ebe-4c47c51ebd5d" :question/math-academy-id "e-14184"} :knowledge-point/id #uuid "f3cbc34d-4bd5-5b12-81a4-81d0c75c4780" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050735}] :knowledge-point/questions [{:db/id #edb/ref 17592186147748} {:db/id #edb/ref 17592186147928}] :knowledge-point/title "Cubing a Fraction"} :step/id #uuid "019a4899-8126-5053-9f04-d4a2cdb37169" :step/math-academy-id 176251 :step/next {:db/id #edb/ref 17592186148265}} {:db/id #edb/ref 17592186148265 :step/content {:db/id #edb/ref 17592186147417 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147187 :question/id #uuid "902a3945-f3e7-588c-83e3-9d74fcaacc62" :question/math-academy-id "e-15037"} :knowledge-point/id #uuid "6852978a-f093-58dd-b0fc-bd8b9dea39e0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048924} {:db/id #edb/ref 17592186049368}] :knowledge-point/questions [{:db/id #edb/ref 17592186147732} {:db/id #edb/ref 17592186147933}] :knowledge-point/title "Raising a Fraction to the Fourth Power"} :step/id #uuid "69440fb9-e705-54f8-8912-a6132bdc4df6" :step/math-academy-id 176255}] :activity/title "Evaluating Exponents With Fractional Bases" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186147676}] [{:activity/first-step {:db/id #edb/ref 17592186055922} :activity/id #uuid "9ae31bbd-56a5-592e-b1ae-0f9422843586" :activity/scope {:db/id #edb/ref 17592186049097 :topic/id #uuid "da5c2e85-609c-5053-9d7f-22b4b7de38e0" :topic/math-academy-id 109} :activity/steps [{:db/id #edb/ref 17592186055922 :step/content {:db/id #edb/ref 17592186056065 :tutorial/content "Decimal subtraction works in a similar way to whole number subtraction.\n\nAs an example, let's find the value of $0.8 - 0.5$.\n\nFirst, we write one number above the other, lining up the decimal points and placing a decimal point below the others in our answer:\n\n$$\n0\\begin{vmatrix}. & 8 \\\\ - & 0\\end{vmatrix}. \\mid 5;\n$$\n\nNext, we proceed by subtracting the two numbers just as we would with whole numbers:\n\n$$\n0\\begin{vmatrix}. & 8 \\\\ - & 0\\end{vmatrix}.\\begin{vmatrix}5 \\\\ 0\\end{vmatrix}. \\mid 3\n$$\n\nTherefore:\n\n$$\n0.8 - 0.5= 0.3\n$$\n\nThis is just like $8-5=3$, but with the decimal point in a different position." :tutorial/id #uuid "16d8e6c1-8d01-5516-827d-397c6734f173" :tutorial/math-academy-id 8603 :tutorial/title "Introduction"} :step/id #uuid "3e6498a8-c16d-5592-9cec-685118a071ae" :step/math-academy-id 96858 :step/next {:db/id #edb/ref 17592186055923}} {:db/id #edb/ref 17592186055923 :step/content {:db/id #edb/ref 17592186054859 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054466 :question/id #uuid "362e6a99-d454-5cdf-9696-80598c59ad6a" :question/math-academy-id "e-13785"} :knowledge-point/id #uuid "6e56241a-8a2b-5d56-9601-1b7af2eb311a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049516}] :knowledge-point/questions [{:db/id #edb/ref 17592186055408} {:db/id #edb/ref 17592186055410}] :knowledge-point/title "Subtracting Decimals"} :step/id #uuid "7c16ca82-a4b4-59ca-80f0-2f2957de1351" :step/math-academy-id 96859 :step/next {:db/id #edb/ref 17592186055924}} {:db/id #edb/ref 17592186055924 :step/content {:db/id #edb/ref 17592186054860 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054467 :question/id #uuid "da2ab4ab-9590-5659-a718-4e9e1ccfa25f" :question/math-academy-id "e-13788"} :knowledge-point/id #uuid "2961da18-04a4-5c8c-b54e-6788d3c3bbc4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050695}] :knowledge-point/questions [{:db/id #edb/ref 17592186055407} {:db/id #edb/ref 17592186055409}] :knowledge-point/title "Subtracting Decimals: Borrowing Once"} :step/id #uuid "03cb5d7b-5967-5f9a-a258-36a20ed16c54" :step/math-academy-id 96862 :step/next {:db/id #edb/ref 17592186055925}} {:db/id #edb/ref 17592186055925 :step/content {:db/id #edb/ref 17592186054861 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054468 :question/id #uuid "b6ec9b57-8559-57bd-9851-574760973d59" :question/math-academy-id "e-13789"} :knowledge-point/id #uuid "b2647be2-904e-56b1-99a2-37214974d121" :knowledge-point/questions [{:db/id #edb/ref 17592186055003} {:db/id #edb/ref 17592186055004}] :knowledge-point/title "Subtracting Decimals: Borrowing More Than Once"} :step/id #uuid "6f67e1c4-2636-5eff-9bb0-30cbfdf725b1" :step/math-academy-id 96865 :step/next {:db/id #edb/ref 17592186055926}} {:db/id #edb/ref 17592186055926 :step/content {:db/id #edb/ref 17592186054862 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054469 :question/id #uuid "22de382b-6e7d-5384-ba72-948bbcc93220" :question/math-academy-id "e-13791"} :knowledge-point/id #uuid "f5d09700-00bd-5c67-93cf-f99c574732d7" :knowledge-point/questions [{:db/id #edb/ref 17592186055405} {:db/id #edb/ref 17592186055406} {:db/id #edb/ref 17592186483416}] :knowledge-point/title "Subtracting Decimals: Word Problems"} :step/id #uuid "864f348b-8f1b-5b5f-9f76-5744454aba98" :step/math-academy-id 96868}] :activity/title "Subtracting Decimals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054867}] [{:activity/first-step {:db/id #edb/ref 17592186055916} :activity/id #uuid "f2c04a04-88f6-5815-a8e5-20ee0a02526b" :activity/scope {:db/id #edb/ref 17592186049194 :topic/id #uuid "e278596d-5bf2-562c-8ffb-72c85230ed4d" :topic/math-academy-id 111} :activity/steps [{:db/id #edb/ref 17592186055916 :step/content {:db/id #edb/ref 17592186056062 :tutorial/content "To multiply two-digit decimals, we can use the usual method of removing and replacing the decimal point.\n\nAs an example, let's learn how to compute $0.4 \\times 0.9$. We proceed as follows:\n\n**Step 1.** First, ignore the decimal points and multiply as if both numbers were whole numbers:\n\n$$\n4 \\times 9 = 36\n$$\n\n**Step 2.** Then, insert the decimal point in the result so that number of decimal places is equal to the total number of decimal places in *both factors combined.*\n\nHere, there is $\\color{blue}1$ decimal place in $0.4$ and there is $\\color{blue}1$ decimal place in $0.9$, so their product will have a total of\n\n$$\n{\\color{blue}1} + {\\color{blue}1} = 2\n$$\n\ndecimal places.\n\nWe take our value of $36$ and insert a decimal point to make a number with $2$ decimal places:\n\n$$\n2\n$$\n\nTherefore,\n\n$$\n0.4 \\times 0.9 = 0.36 \\,\n$$" :tutorial/id #uuid "6b36f4a0-7deb-5913-be8e-0317929f793d" :tutorial/math-academy-id 8550 :tutorial/title "Introduction"} :step/id #uuid "834ec7ff-c309-55d8-b8c4-51a8a44a519b" :step/math-academy-id 90825 :step/next {:db/id #edb/ref 17592186055917}} {:db/id #edb/ref 17592186055917 :step/content {:db/id #edb/ref 17592186054855 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054461 :question/id #uuid "1105c7d8-178a-598c-bf98-3032e506af4d" :question/math-academy-id "e-13681"} :knowledge-point/id #uuid "a20a2e6d-b919-5385-932a-83df013f47d6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050007}] :knowledge-point/questions [{:db/id #edb/ref 17592186055378} {:db/id #edb/ref 17592186055383}] :knowledge-point/title "Multiplying Decimals Smaller Than One"} :step/id #uuid "e032ff82-cb04-58bb-bd2c-e15b9dde6bed" :step/math-academy-id 90826 :step/next {:db/id #edb/ref 17592186055918}} {:db/id #edb/ref 17592186055918 :step/content {:db/id #edb/ref 17592186056063 :tutorial/content "We can use the same method to multiply decimals even when they are greater than $1$. For example, to compute\n\n$$\n4.7 \\times 0.8\n$$\n\nwe first ignore the decimal points and multiply as if both numbers were whole numbers. We ignore any leading ${\\color{red}{0}}$'s during the multiplication:\n\n$$\n5; 4\\begin{vmatrix}.7 \\\\ \\cdot\\end{vmatrix}0\\begin{vmatrix}.8 \\\\ 3\\end{vmatrix}7 \\mid 6\n$$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $\\color{blue}1$ decimal place in $4.7$ and there is $\\color{blue}1$ decimal place in $0.8$, so their product will have\n\n$$\n{\\color{blue}1} + {\\color{blue}1} = 2\n$$\n\ndecimal places.\n\nWe take our value of $376$ and insert a decimal point to make a number with $2$ decimal places:\n\n$$\n2\n$$\n\nTherefore,\n\n$$\n4.7 \\times 0.8 = 3.76 \\,\n$$" :tutorial/id #uuid "20294d5f-7279-5d62-89c7-a543f06efc49" :tutorial/math-academy-id 8552 :tutorial/title "Multiplying Two Digit-Decimals by Two-Digit Decimals"} :step/id #uuid "08d09184-4451-5335-ae64-031bb2cd8262" :step/math-academy-id 90829 :step/next {:db/id #edb/ref 17592186055919}} {:db/id #edb/ref 17592186055919 :step/content {:db/id #edb/ref 17592186054856 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054462 :question/id #uuid "960a0585-8002-5eb7-8eea-ee53e3bc12aa" :question/math-academy-id "e-13683"} :knowledge-point/id #uuid "4a9d5cbc-7a1a-5948-b9bd-24b093751fbe" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051030}] :knowledge-point/questions [{:db/id #edb/ref 17592186055377} {:db/id #edb/ref 17592186055382}] :knowledge-point/title "Multiplying a Decimal Smaller Than One by a Decimal Greater Than One"} :step/id #uuid "a0a2d350-01c3-50f2-98cb-04421352da34" :step/math-academy-id 90830 :step/next {:db/id #edb/ref 17592186055920}} {:db/id #edb/ref 17592186055920 :step/content {:db/id #edb/ref 17592186054857 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054463 :question/id #uuid "7dc1728c-bfb1-5658-8717-6c1447470fb2" :question/math-academy-id "e-13684"} :knowledge-point/id #uuid "429347ff-82e0-5b92-8dbc-e5e673ab9d5e" :knowledge-point/questions [{:db/id #edb/ref 17592186055384} {:db/id #edb/ref 17592186055385}] :knowledge-point/title "Multiplying Decimals Greater Than One"} :step/id #uuid "7ca6bcd3-528d-5a3e-88e4-1738b2a87420" :step/math-academy-id 90833 :step/next {:db/id #edb/ref 17592186055921}} {:db/id #edb/ref 17592186055921 :step/content {:db/id #edb/ref 17592186054858 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054464 :question/id #uuid "cdc78012-1cb8-522d-9a6d-e9c4c4e02f2f" :question/math-academy-id "e-13685"} :knowledge-point/id #uuid "ef1ed47e-ac17-5e98-8f3c-ea15497f7ff7" :knowledge-point/questions [{:db/id #edb/ref 17592186055387} {:db/id #edb/ref 17592186055388} {:db/id #edb/ref 17592186483372}] :knowledge-point/title "Word Problems"} :step/id #uuid "45823383-fdd7-591d-bf81-f0875d54bdb2" :step/math-academy-id 90836}] :activity/title "Multiplying Two-Digit Decimals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054869}] [{:activity/first-step {:db/id #edb/ref 17592186139261} :activity/id #uuid "033334be-eb60-5622-8597-51bc1a145d04" :activity/scope {:db/id #edb/ref 17592186049484 :topic/id #uuid "f8b021d6-f0b4-55fa-8712-545c2bda47d0" :topic/math-academy-id 2339} :activity/steps [{:db/id #edb/ref 17592186139261 :step/content {:db/id #edb/ref 17592186139709 :tutorial/content "Suppose we want to compute the sum of two numbers with different numbers of decimal places, such as\n\n$$\n19+5.6\n$$\n\nHere, there are no decimal places in $19$, but there is $\\color{blue}1$ decimal place in $5.6$.\n\nIn order to add the two numbers, we need the two numbers to have the same number of decimal places. We can achieve this by attaching an extra zero behind the decimal place in the first number, so that it has $\\color{blue}1$ decimal place:\n\n$$\n1\n$$\n\nRemember that whenever we attach an extra zero behind the decimal place, the number remains unchanged. So the number $19.0$ is equivalent to the original number $19$.\n\nNow the addition problem reads\n\n$$\n19.0 + 5.6\n$$\n\nand we can add the decimal numbers using the usual method. First, we line up the decimal points:\n\n$$\n1\\begin{vmatrix}9 &. & 0 \\\\ + & 5 &.\\end{vmatrix}6;\n$$\n\nThen, we proceed by adding the two numbers just as we would with whole numbers:\n\n$$\n1; 1\\begin{vmatrix}9 &. & 0 \\\\ + & 5 &.\\end{vmatrix}6; 2\\begin{vmatrix}4 &.\\end{vmatrix}6\n$$\n\nTherefore,\n\n$$\n19 + 5.6 = 24.6\n$$" :tutorial/id #uuid "bbd5cc8c-5c61-557c-ac3d-b35131923855" :tutorial/math-academy-id 8659 :tutorial/title "Introduction"} :step/id #uuid "d8a23e98-5d75-52b5-a8a9-9ec9d4eb8ce9" :step/math-academy-id 131579 :step/next {:db/id #edb/ref 17592186139262}} {:db/id #edb/ref 17592186139262 :step/content {:db/id #edb/ref 17592186138367 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138153 :question/id #uuid "19136b06-7720-5324-b391-9089ddcb40c6" :question/math-academy-id "e-13884"} :knowledge-point/id #uuid "22273771-e182-5e72-ad15-434dfc080d85" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048844} {:db/id #edb/ref 17592186049549}] :knowledge-point/questions [{:db/id #edb/ref 17592186138703} {:db/id #edb/ref 17592186138731}] :knowledge-point/title "Adding Decimals and Whole Numbers"} :step/id #uuid "1461c30b-0b21-5a2e-8580-8471638fecb4" :step/math-academy-id 131580 :step/next {:db/id #edb/ref 17592186139263}} {:db/id #edb/ref 17592186139263 :step/content {:db/id #edb/ref 17592186138368 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138154 :question/id #uuid "44ddf017-7985-54a0-95e5-131cebd13a56" :question/math-academy-id "e-13888"} :knowledge-point/id #uuid "28d5aa07-8c26-5964-bb34-a500d8e0a9e9" :knowledge-point/questions [{:db/id #edb/ref 17592186138732} {:db/id #edb/ref 17592186138935} {:db/id #edb/ref 17592186483385}] :knowledge-point/title "Adding Numbers With One and Two Decimal Places"} :step/id #uuid "feedfa63-390b-53d3-b4e9-ba9fa9628476" :step/math-academy-id 131583 :step/next {:db/id #edb/ref 17592186139264}} {:db/id #edb/ref 17592186139264 :step/content {:db/id #edb/ref 17592186138369 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138156 :question/id #uuid "1aa57da3-ce99-5d2f-80a7-1742064b5f1a" :question/math-academy-id "e-13891"} :knowledge-point/id #uuid "a5510509-4189-54e0-b92a-298e60469518" :knowledge-point/questions [{:db/id #edb/ref 17592186138709} {:db/id #edb/ref 17592186138733}] :knowledge-point/title "Adding Numbers With Two and Three Decimal Places"} :step/id #uuid "56aaa78e-43e0-50c6-a007-8f7f41855d42" :step/math-academy-id 131586 :step/next {:db/id #edb/ref 17592186139265}} {:db/id #edb/ref 17592186139265 :step/content {:db/id #edb/ref 17592186139711 :tutorial/content "Sometimes, we will need to place more than one zero to the right of a decimal point.\n\nFor instance, to find the value of $78.9 + 45.962$, notice that there is $\\color{blue}1$ decimal place in $78.9$ and there are $\\color{blue}3$ decimal places in $45.962$.\n\nTo add the two numbers, we need them to have the same number of decimal places. So, we rewrite the first number so that it has $\\color{blue}3$ decimal places:\n\n$$\n78.9=78.9{\\color{red}00}\n$$\n\nNext, we line up the decimal points:\n\n$$\n7\\begin{vmatrix}8 &. & 9 & 0 & 0 \\\\ + & 4 & 5 &. & 9\\end{vmatrix}6 \\mid 2;\n$$\n\nFinally, we proceed by adding the two numbers just as we would with whole numbers:\n\n$$\n1\\begin{vmatrix}1 \\\\ 7\\end{vmatrix}8\\begin{vmatrix}. & 9 & 0 & 0 \\\\ + & 4 & 5 &.\\end{vmatrix}9\\begin{vmatrix}6 & 2 \\\\ 1 & 2\\end{vmatrix}4\\begin{vmatrix}. & 8 & 6\\end{vmatrix}2\n$$\n\nTherefore,\n\n$$\n78.9 + 45.962 = 124.862\n$$" :tutorial/id #uuid "b92b614c-df34-57df-b4f4-f8d2a4585e5d" :tutorial/math-academy-id 8662 :tutorial/title "Decimal Addition With Multiple Decimal Place Differences"} :step/id #uuid "a039ef0e-db7b-520c-acb5-321b992f0f47" :step/math-academy-id 131589 :step/next {:db/id #edb/ref 17592186139266}} {:db/id #edb/ref 17592186139266 :step/content {:db/id #edb/ref 17592186138370 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138157 :question/id #uuid "eaddf5a2-efaf-5363-88ed-fa5a2d052d7a" :question/math-academy-id "e-13894"} :knowledge-point/id #uuid "ad98133f-fb05-5622-a3af-da4acd823e0b" :knowledge-point/questions [{:db/id #edb/ref 17592186138711} {:db/id #edb/ref 17592186138734}] :knowledge-point/title "Adding Numbers With Multiple Decimal Place Differences"} :step/id #uuid "405d6b9e-8686-5904-853f-89c53abda3d6" :step/math-academy-id 131590}] :activity/title "Addition With Unequal Numbers of Decimals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186138640}] [{:activity/first-step {:db/id #edb/ref 17592186074543} :activity/id #uuid "37b89a15-be25-59b1-9aff-a1e4d5475cca" :activity/scope {:db/id #edb/ref 17592186050177 :topic/id #uuid "340ad0ce-00e0-59e7-b309-a91b80db4146" :topic/math-academy-id 548} :activity/steps [{:db/id #edb/ref 17592186074543 :step/content {:db/id #edb/ref 17592186075048 :tutorial/content "We can estimate decimal division by rounding each decimal to the nearest whole number and dividing the resulting numbers.\n\nFor example, suppose we wish to estimate the quotient of the following division problem.\n$19.7 \\div 5.3$\n\nOne way to proceed is first to round both quantities to the nearest whole number:\n\n$$\n19.7\\begin{vmatrix}\\div & 5.3 \\\\ ↓ & ↓ \\\\ 20 & \\div\\end{vmatrix}5\n$$\n\nSo, we can form an estimate of $19.7 \\div 5.3$ by evaluating $20 \\div 5$.\n\nComputing the quotient of this simplified problem gives\n\n$$\n20 \\div 5 = 4\n$$\n\nTherefore, $19.7 \\div 5.3$ is approximately equal to $4$. We can write this symbolically as follows:\n\n$$\n19.7 \\div 5.3 \\approx 4\n$$\n\nThe symbol\n\n$$\n\\approx\n$$\n\nmeans \"is approximately equal to.\"" :tutorial/id #uuid "5c7a997b-e3c3-5ff6-a0dc-63838fdbab45" :tutorial/math-academy-id 8661 :tutorial/title "Introduction"} :step/id #uuid "35e65a05-4982-56a5-a60d-0723e221ecf5" :step/math-academy-id 110353 :step/next {:db/id #edb/ref 17592186074544}} {:db/id #edb/ref 17592186074544 :step/content {:db/id #edb/ref 17592186073676 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073476 :question/id #uuid "145782cb-fa17-5870-a174-16552a6b236b" :question/math-academy-id "e-13890"} :knowledge-point/id #uuid "e27e3a75-779a-5817-a2ae-27b58cbac913" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048145} {:db/id #edb/ref 17592186049577} {:db/id #edb/ref 17592186050415} {:db/id #edb/ref 17592186050436}] :knowledge-point/questions [{:db/id #edb/ref 17592186074344} {:db/id #edb/ref 17592186074353} {:db/id #edb/ref 17592186483369}] :knowledge-point/title "Rounding to the Nearest Whole Number"} :step/id #uuid "28d0851d-1f6d-5d37-a89a-dc5f7b11d15c" :step/math-academy-id 110354 :step/next {:db/id #edb/ref 17592186074545}} {:db/id #edb/ref 17592186074545 :step/content {:db/id #edb/ref 17592186073677 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073477 :question/id #uuid "fbbf151d-cecb-5ee1-b5bb-e1843130c0cc" :question/math-academy-id "e-13893"} :knowledge-point/id #uuid "757957e9-dfd6-5ae8-96c6-f2f6ca86736a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049142}] :knowledge-point/questions [{:db/id #edb/ref 17592186074013} {:db/id #edb/ref 17592186074368} {:db/id #edb/ref 17592186074522}] :knowledge-point/title "Rounding to the Nearest Ten, Hundred or Thousand"} :step/id #uuid "6431c422-f59b-51f5-9a09-8d7eab553fc4" :step/math-academy-id 110357 :step/next {:db/id #edb/ref 17592186074546}} {:db/id #edb/ref 17592186074546 :step/content {:db/id #edb/ref 17592186073678 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073478 :question/id #uuid "7272264d-b07f-58d7-b084-24ede4cc2243" :question/math-academy-id "e-13896"} :knowledge-point/id #uuid "ebda804f-71a4-586f-b66e-0c20e1a89f42" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049143}] :knowledge-point/questions [{:db/id #edb/ref 17592186074014} {:db/id #edb/ref 17592186074346}] :knowledge-point/title "Rounding Decimals With Two Decimal Places"} :step/id #uuid "4925581e-95aa-56ca-80c2-9631b95d64c1" :step/math-academy-id 110361 :step/next {:db/id #edb/ref 17592186074547}} {:db/id #edb/ref 17592186074547 :step/content {:db/id #edb/ref 17592186073679 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073479 :question/id #uuid "b223571e-3070-5474-a01c-f909c89bf36d" :question/math-academy-id "e-13900"} :knowledge-point/id #uuid "5a63e81d-07ac-5835-9bdb-4efc72960490" :knowledge-point/questions [{:db/id #edb/ref 17592186074345} {:db/id #edb/ref 17592186074370}] :knowledge-point/title "Cases With Remainders"} :step/id #uuid "5059c5cd-2bb7-5b9a-8d2d-d8fa0f3d172d" :step/math-academy-id 110364}] :activity/title "Estimating Decimal Division" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073967}] [{:activity/first-step {:db/id #edb/ref 17592186074587} :activity/id #uuid "88aafef4-dba1-5836-aa72-e3d8e32d91a2" :activity/scope {:db/id #edb/ref 17592186050701 :topic/id #uuid "602e3c88-6527-582d-aadc-9d4a51aebd6f" :topic/math-academy-id 525} :activity/steps [{:db/id #edb/ref 17592186074587 :step/content {:db/id #edb/ref 17592186075047 :tutorial/content "When subtracting mixed numbers, we sometimes run into a problem when subtracting the fractional parts.\n\nFor example, let's try to work out the following problem:\n\n$$\n4 \\, \\dfrac{1}{6} - 2 \\,\\dfrac{1}{3}\n$$\n\nIf we try to subtract fractions from fractions, we run into a problem:\n\n$$\n\\dfrac{1}{6} - \\dfrac{1}{3}\\quad \\color{red}{\\times}\n$$\n\nWe cannot perform the above subtraction because\n\n$$\n\\dfrac 1 6 < \\dfrac 1 3\n$$\n\nTo get around this problem, we convert each mixed number to an improper fraction, and *then* subtract.\n\nWriting\n\n$$\n4 \\, \\dfrac{1}{6}\n$$\n\nas an improper fraction, we have:\n\n$$\n4 \\, \\dfrac{1}{6} = \\dfrac{(4 \\times 6) + 1}{6} = \\dfrac{25}{6}\n$$\n\nWriting\n\n$$\n2 \\, \\dfrac{1}{3}\n$$\n\nas an improper fraction, we have:\n\n$$\n2 \\, \\dfrac{1}{3} = \\dfrac{(2 \\times 3) + 1}{3} = \\dfrac {7}{3}\n$$\n\nTherefore, our problem now is to work out the following:\n\n$$\n\\dfrac{25}{6} - \\dfrac {7}{3}\n$$\n\nWe can make a common denominator of $6$. To put\n\n$$\n\\dfrac{7}{3}\n$$\n\nover a denominator of $6$, we multiply the numerator and denominator by $2$:\n\n$$\n\\dfrac{7}{3} = \\dfrac{7 \\times 2}{3 \\times 2} = \\dfrac{14}{6}\n$$\n\nWe can now subtract the fractions:\n\n$$\n\\frac{25}{6} - \\frac{14}{6} = \\frac{11}{6}\n$$" :tutorial/id #uuid "1487c9af-6568-5567-8ed9-1f5ab7639230" :tutorial/math-academy-id 8574 :tutorial/title "Introduction"} :step/id #uuid "3d902ee2-b016-5ca0-845f-d3f7ea2b9c72" :step/math-academy-id 135982 :step/next {:db/id #edb/ref 17592186074588}} {:db/id #edb/ref 17592186074588 :step/content {:db/id #edb/ref 17592186073703 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073472 :question/id #uuid "662dd1ce-e2f5-57c8-8f72-c6767751a43c" :question/math-academy-id "e-13727"} :knowledge-point/id #uuid "ca4cf40d-4f8f-5d82-a07f-79f2364b67e1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048566} {:db/id #edb/ref 17592186049601} {:db/id #edb/ref 17592186050735}] :knowledge-point/questions [{:db/id #edb/ref 17592186073994} {:db/id #edb/ref 17592186074273}] :knowledge-point/title "Finding a Missing Numerator"} :step/id #uuid "8391060b-70b6-551e-91d4-e4853d1da022" :step/math-academy-id 135983 :step/next {:db/id #edb/ref 17592186074589}} {:db/id #edb/ref 17592186074589 :step/content {:db/id #edb/ref 17592186073704 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073473 :question/id #uuid "63ba6ccc-1699-5a3a-9bd1-6df76bfa97ee" :question/math-academy-id "e-13730"} :knowledge-point/id #uuid "cdb5b936-b803-5f53-ad84-e7e6150b06a5" :knowledge-point/questions [{:db/id #edb/ref 17592186074034} {:db/id #edb/ref 17592186074035} {:db/id #edb/ref 17592186074274}] :knowledge-point/title "Subtracting Mixed Numbers Using Improper Fractions"} :step/id #uuid "0f442a91-edc8-5ddc-ae58-362b6163f540" :step/math-academy-id 135986 :step/next {:db/id #edb/ref 17592186074590}} {:db/id #edb/ref 17592186074590 :step/content {:db/id #edb/ref 17592186073705 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073474 :question/id #uuid "38dd2bf7-809e-515f-ac23-9d688488423a" :question/math-academy-id "e-13733"} :knowledge-point/id #uuid "cb42b265-bcf6-58ef-aa08-489dec5d1104" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049640}] :knowledge-point/questions [{:db/id #edb/ref 17592186074036} {:db/id #edb/ref 17592186074061} {:db/id #edb/ref 17592186074062} {:db/id #edb/ref 17592186483420}] :knowledge-point/title "Converting the Result to a Mixed Number"} :step/id #uuid "b4a260fb-0642-59a6-80a6-933088e32e9d" :step/math-academy-id 135990 :step/next {:db/id #edb/ref 17592186074591}} {:db/id #edb/ref 17592186074591 :step/content {:db/id #edb/ref 17592186073706 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073475 :question/id #uuid "8651dc4e-2367-507b-81b4-07dfc80e664d" :question/math-academy-id "e-13735"} :knowledge-point/id #uuid "7985b636-6cbb-5aa8-a5d0-47db5fa2bfed" :knowledge-point/questions [{:db/id #edb/ref 17592186074063} {:db/id #edb/ref 17592186074064} {:db/id #edb/ref 17592186074519}] :knowledge-point/title "Converting a Result Greater Than Two to a Mixed Number"} :step/id #uuid "a1a6476a-a354-5aff-b6fc-e12657a58b81" :step/math-academy-id 135994}] :activity/title "Subtracting Mixed Numbers With Unlike Denominators Using Improper Fractions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073945}]}
