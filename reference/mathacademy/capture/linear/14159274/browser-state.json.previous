idth=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mn>7</mn><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle></mtd><mtd><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mn>3</mn><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle></mtd><mtd><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mn>0</mn><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle></mtd></mtr></mtable></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>We now count the total number of decimal places in the two factors.</p>\n<p>There is <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"27\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle style=\"color: blue;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-mstyle></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle mathcolor=\"blue\"><mn>1</mn></mstyle></math></mjx-assistive-mml></mjx-container> decimal place in <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"28\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c38\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c><mjx-c class=\"mjx-c36\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8.6</mn></math></mjx-assistive-mml></mjx-container> and there is <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"29\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle style=\"color: blue;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-mstyle></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle mathcolor=\"blue\"><mn>1</mn></mstyle></math></mjx-assistive-mml></mjx-container> decimal place in <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"30\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c35\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c><mjx-c class=\"mjx-c35\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5.5</mn><mo>.</mo></math></mjx-assistive-mml></mjx-container>\nTherefore, their product will have <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"31\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-texatom texclass=\"ORD\"><mjx-mstyle style=\"color: blue;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-mstyle></mjx-texatom><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo><mjx-texatom space=\"3\" texclass=\"ORD\"><mjx-mstyle style=\"color: blue;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-mstyle></mjx-texatom><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mn>1</mn></mstyle></mrow><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mn>1</mn></mstyle></mrow><mo>=</mo><mn>2</mn></math></mjx-assistive-mml></mjx-container> decimal places.</p>\n<p>So, we take our value of <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"32\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c34\"></mjx-c><mjx-c class=\"mjx-c37\"></mjx-c><mjx-c class=\"mjx-c33\"></mjx-c><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4730</mn></math></mjx-assistive-mml></mjx-container> and add a decimal point to make a number with <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"33\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math></mjx-assistive-mml></mjx-container> decimal places.</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"34\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c34\"></mjx-c><mjx-c class=\"mjx-c37\"></mjx-c></mjx-mn><mjx-mstyle><mjx-mspace style=\"width: 0.167em;\"></mjx-mspace></mjx-mstyle><mjx-mover><mjx-over style=\"padding-bottom: 0.111em; padding-left: 0.074em;\"><mjx-mstyle size=\"s\" style=\"color: red;\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2193\"></mjx-c></mjx-mo></mjx-mstyle></mjx-over><mjx-base><mjx-mstyle style=\"color: red;\"><mjx-mstyle style=\"background-color: lightgray;\"><mjx-mpadded><mjx-block style=\"width: 0.501em; margin: 0.112em 0px; position: relative;\"><mjx-rbox style=\"left: 0.112em; top: 0px; max-width: 0.501em;\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle></mjx-mstyle></mjx-base></mjx-mover><mjx-mstyle style=\"width: 0px; margin-right: -0.167em;\"><mjx-mspace style=\"margin-right: -0.167em;\"></mjx-mspace></mjx-mstyle><mjx-mstyle style=\"width: 0px; margin-right: -0.167em;\"><mjx-mspace style=\"margin-right: -0.167em;\"></mjx-mspace></mjx-mstyle><mjx-mstyle style=\"width: 0px; margin-right: -0.167em;\"><mjx-mspace style=\"margin-right: -0.167em;\"></mjx-mspace></mjx-mstyle><mjx-munder space=\"2\"><mjx-row><mjx-base style=\"padding-left: 0.434em;\"><mjx-texatom texclass=\"OP\"><mjx-munder><mjx-row><mjx-base style=\"padding-l