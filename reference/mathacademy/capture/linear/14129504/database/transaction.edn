]} {:db/id "answer-ca6adf97-24ed-50b6-a9f3-407b38334510" :answer/id #uuid "ca6adf97-24ed-50b6-a9f3-407b38334510" :answer/type :answer.type/math :answer/value "(-1,0)" :db/ensure [:answer/validate]} {:db/id "answer-a637edd7-a291-59bd-a9c1-112f2becc5f2" :answer/id #uuid "a637edd7-a291-59bd-a9c1-112f2becc5f2" :answer/type :answer.type/math :answer/value "(0,-1)" :db/ensure [:answer/validate]} {:db/id "answer-b462fa88-6ef5-57e2-8fdb-7017933c3a19" :answer/id #uuid "b462fa88-6ef5-57e2-8fdb-7017933c3a19" :answer/type :answer.type/math :answer/value "(0,1)" :db/ensure [:answer/validate]} {:db/id "answer-4c729f97-43d0-5203-afff-9ba3dae7d3e1" :answer/id #uuid "4c729f97-43d0-5203-afff-9ba3dae7d3e1" :answer/type :answer.type/math :answer/value "(1,0)" :db/ensure [:answer/validate]} {:db/id "question-becd9473-0ed4-5726-bb5b-2671f06103f1" :question/id #uuid "becd9473-0ed4-5726-bb5b-2671f06103f1" :question/math-academy-id "q-61349" :question/problem "![](images/09/098579a792cd5fe253661082b3cc0a909c68e21a7b6ab11eae4f5a0644cb1195.png)\n\nWhat are the coordinates of the point $A?$" :question/worked-solution "To find the coordinates of the point $A,$ we start at the origin, move $2$ unit *left* and then $3$ units *down*. \n\n![](images/28/28f80206ef851fe3228ca616beb78f5df28d8d1c866cc77f8042af2c8b72e779.png)\n\nThe $x$-coordinate of $A$ is $-2,$ the $y$-coordinate is $-3,$ and coordinates are given by the ordered pair $(-2,-3).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-52dafe2e-4879-5351-a896-60d3a41a4d95"] :db/ensure [:question/validate]} {:db/id "answer-field-52dafe2e-4879-5351-a896-60d3a41a4d95" :answer-field/id #uuid "52dafe2e-4879-5351-a896-60d3a41a4d95" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3778c069-76f0-510d-946d-9422aa1a1f41" :answer-field/choices ["answer-3778c069-76f0-510d-946d-9422aa1a1f41" "answer-66fc29c5-9031-5966-987b-523aa7667045" "answer-a5c33ca1-2c69-551b-a73d-193dde2b8ee3" "answer-9668af75-c7b3-568d-bc53-55a7b15e375f" "answer-06388a3b-d728-5519-b802-7793c4a29207"] :db/ensure [:answer-field/validate]} {:db/id "answer-3778c069-76f0-510d-946d-9422aa1a1f41" :answer/id #uuid "3778c069-76f0-510d-946d-9422aa1a1f41" :answer/type :answer.type/math :answer/value "(-2,-3)" :db/ensure [:answer/validate]} {:db/id "answer-66fc29c5-9031-5966-987b-523aa7667045" :answer/id #uuid "66fc29c5-9031-5966-987b-523aa7667045" :answer/type :answer.type/math :answer/value "(-3,2)" :db/ensure [:answer/validate]} {:db/id "answer-a5c33ca1-2c69-551b-a73d-193dde2b8ee3" :answer/id #uuid "a5c33ca1-2c69-551b-a73d-193dde2b8ee3" :answer/type :answer.type/math :answer/value "(2,-3)" :db/ensure [:answer/validate]} {:db/id "answer-9668af75-c7b3-568d-bc53-55a7b15e375f" :answer/id #uuid "9668af75-c7b3-568d-bc53-55a7b15e375f" :answer/type :answer.type/math :answer/value "(2,3)" :db/ensure [:answer/validate]} {:db/id "answer-06388a3b-d728-5519-b802-7793c4a29207" :answer/id #uuid "06388a3b-d728-5519-b802-7793c4a29207" :answer/type :answer.type/math :answer/value "(3,-2)" :db/ensure [:answer/validate]} {:db/id 17592186055120 :question/problem "Which of the following shows the point $C(-2,-3)?$" :question/worked-solution "Starting at the origin, we move along the $x$ and $y$ axes to get to the point $C.$\n\nFirst, we move along the $x$-axis. The point $C$ has an $x$-coordinate of $-2,$ so we move $2$ units to the *left*, in the negative direction of the $x$-axis.\n\nThen, we move along the $y$-axis. The point $C$ has a $y$-coordinate of $-3,$ so we move $3$ units *down*, in the negative direction of the $y$-axis.\n\n![](images/e8/e8b3ac34b4fe6c877d606d8ddde5f29c9856cc4bdc5ac14e3ffcf5ddccdc0ebb.png)" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186052088 :answer-field/correct 17592186052093 :db/ensure [:answer-field/validate]} {:db/id "question-fbf139c7-761b-543f-b693-759ff9beaf7d" :question/id #uuid "fbf139c7-761b-543f-b693-759ff9beaf7d" :question/math-academy-id "q-109031" :question/problem "Which of the following shows the point $D(6,-5)?$" :question/worked-solution "Starting at the origin, we move along the $x$ and $y$ axes to get to the point $D.$\n\nFirst, we move along the $x$-axis. The point $D$ has an $x$-coordinate of $6,$ so we move $6$ units to the *right*, in the positive direction of the $x$-axis.\n\nThen, we move along the $y$-axis. The point $D$ has a $y$-coordinate of $-5,$ so we move $5$ units *down*, in the negative direction of the $y$-axis.\n\n![](images/99/9917f6ae367b802cf686cd847d2ed77641de7e4a0349082c66548f9e461351be.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-553327f0-4110-5faf-81c7-bedf971328be"] :db/ensure [:question/validate]} {:db/id "answer-field-553327f0-4110-5faf-81c7-bedf971328be" :answer-field/id #uuid "553327f0-4110-5faf-81c7-bedf971328be" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-699ed89b-df40-5d1a-b068-a9f77aa9dbd9" :answer-field/choices ["answer-1b3ff6e9-2bb7-5f0f-a6cf-f104a81f37a0" "answer-d893debb-3b1c-5b1e-b3cc-bddd57a92c41" "answer-b050080f-80b3-5dae-824a-248c3f29f940" "answer-699ed89b-df40-5d1a-b068-a9f77aa9dbd9" "answer-fbbe53b2-b11d-54d4-8666-65da7ceb38fb"] :db/ensure [:answer-field/validate]} {:db/id "answer-1b3ff6e9-2bb7-5f0f-a6cf-f104a81f37a0" :answer/id #uuid "1b3ff6e9-2bb7-5f0f-a6cf-f104a81f37a0" :answer/type :answer.type/image :answer/value "images/20/208af477bbb723caaf5aeb37498a9d9afed6fbcab26d258bce6d1bb844b8358f.png" :db/ensure [:answer/validate]} {:db/id "answer-d893debb-3b1c-5b1e-b3cc-bddd57a92c41" :answer/id #uuid "d893debb-3b1c-5b1e-b3cc-bddd57a92c41" :answer/type :answer.type/image :answer/value "images/24/245599183e581932d6bfdaea742f547651ca919ade381ce22b96e4cae09061a9.png" :db/ensure [:answer/validate]} {:db/id "answer-b050080f-80b3-5dae-824a-248c3f29f940" :answer/id #uuid "b050080f-80b3-5dae-824a-248c3f29f940"