e7a9315f6b0a938fdc502f370c90f29d5bbeaa063fc27a7df81360f01adaf.png)\n\nSince $A$ is placed below and to the right of the origin, it lies in quadrant $\\text{IV},$ which is the fourth quadrant."}] [{:db/id #edb/ref 17592186426967 :knowledge-point/_questions [{:db/id #edb/ref 17592186054809 :knowledge-point/id #uuid "7fcec0d8-ca03-5446-a42f-65d0ccddd584" :knowledge-point/title "Identifying the Quadrant of a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27633f58-a6d2-5307-bd31-29b1cab88ef1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Left quadrant" :db/id #edb/ref 17592186426880} {:answer/id #uuid "3be94df4-6fff-56cc-b61c-1c9be533a501" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Fourth quadrant" :db/id #edb/ref 17592186426886} {:answer/id #uuid "3ffbcafc-4e15-5257-ad1c-619b9e1498a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Third quadrant" :db/id #edb/ref 17592186426888} {:answer/id #uuid "40c0080a-2057-5ae3-958c-5ce297522af4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "First quadrant" :db/id #edb/ref 17592186426890} {:answer/id #uuid "6b29aa89-e385-5dc5-9891-e712c71032ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Second quadrant" :db/id #edb/ref 17592186426902}] :answer-field/correct {:answer/id #uuid "6b29aa89-e385-5dc5-9891-e712c71032ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Second quadrant" :db/id #edb/ref 17592186426902} :answer-field/id #uuid "0f8a175c-5cea-592c-9a16-dbcd9b012fa6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186426950}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "17973190-6a31-5b4