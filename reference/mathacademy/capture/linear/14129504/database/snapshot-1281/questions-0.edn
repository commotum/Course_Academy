 $4$ units *down*, in the *negative* direction of the $y$-axis.\n\n![](images/d9/d98351134079c9ccf3b467b6b57df892b0e4ecc6040e32f764f3f9eb4e24989b.png)"}] [{:db/id #edb/ref 17592186426978 :knowledge-point/_questions [{:db/id #edb/ref 17592186054806 :knowledge-point/id #uuid "f41c2f3b-9b55-5f32-bb0a-a8397cdf66ce" :knowledge-point/title "Determining the X- or Y-Coordinate of a Point in the Coordinate Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38aed697-bc3a-5253-8ed1-ff1668e0df3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186426885} {:answer/id #uuid "405c6bd9-935b-5b0a-94fb-3eacb0de7ca1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186426889} {:answer/id #uuid "51428dd2-3c8f-5a6f-97c5-6284dcac5abd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186426895} {:answer/id #uuid "542ffa98-f6bd-5f12-9165-60bc6a62b11f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186426896} {:answer/id #uuid "f7571bcc-0219-5027-b4e0-d1574a3e83e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186426946}] :answer-field/correct {:answer/id #uuid "38aed697-bc3a-5253-8ed1-ff1668e0df3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186426885} :answer-field/id #uuid "cf97dbca-0410-56a7-9320-1bd6e4d0171d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186426962}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd34f23b-b976-5fc4-96ef-147e2f03d920" :question/math-academy-id "q-93506" :question/problem "![](images/15/15d