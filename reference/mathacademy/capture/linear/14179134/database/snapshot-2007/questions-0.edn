#{[{:db/id #edb/ref 17592186495116 :knowledge-point/_questions [{:db/id #edb/ref 17592186073900 :knowledge-point/id #uuid "83bbdad9-c2a5-5caa-a4e9-2a0c904c605b" :knowledge-point/title "Finding the Distance Between Two Points: Crossing the Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bdc2701-e79a-5b33-86a6-ef27722a55d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186494506} {:answer/id #uuid "6822bf50-caeb-554f-938f-a5cc8683af71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186494526} {:answer/id #uuid "80300fbe-d90a-591a-928d-9196db5a2240" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186494596} {:answer/id #uuid "b85c490c-92e9-5030-a0f6-291132b15fa4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186494748} {:answer/id #uuid "dceb000c-8083-5f83-9e97-ae002b6b6ba1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186494841}] :answer-field/correct {:answer/id #uuid "5bdc2701-e79a-5b33-86a6-ef27722a55d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186494506} :answer-field/id #uuid "7a673c29-4fae-58d2-bcf6-86accdee64d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186494972}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "95857c13-ed71-5f23-a1a7-f058676d3273" :question/math-academy-id "q-161670" :question/problem "What is the distance between the points $(-1,5)$  and $(3,5)?$" :question/worked-solution "**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/74/74dfce8c8444a841f9f742d70204d82b22157bf5b955bb2691eb0cdefe62fb75.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $4$ units, so the distance equals $4.$\n\n![](images/4d/4df0d2515a43236634f934879d6a4d8926cc09163f79216ce288e07e2ba28e72.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $y$-axis and then adding.\n\n![](images/aa/aaf091301a2b004e80bef49a2893eed00f0a28693d8799ee366ed47425869a9c.png)\n\nThe point $(-1,5)$ is at a distance of $1$ from the $y$-axis, and the point $(3,5)$ is at a distance of $3$ from the $y$-axis. Therefore, the distance between the two points is $1+3=4.$"}] [{:db/id #edb/ref 17592186495146 :knowledge-point/_questions [{:db/id #edb/ref 17592186073899 :knowledge-point/id #uuid "f0708cd3-0608-5d57-ac14-4c16ef362473" :knowledge-point/title "Finding the Vertical Distance Between Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4844ffa7-9148-54b8-9e72-b30c1cb0c11e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186494463} {:answer/id #uuid "800b7dfe-1222-53bf-82a3-9afc3077f999" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186494595} {:answer/id #uuid "b32d799a-1971-505f-9d44-6d88dea78839" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186494736} {:answer/id #uuid "cde81723-b01c-5413-aefe-9f6e7a2f5589" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186494806} {:answer/id #uuid "ee3d1b5c-cd0f-5511-8f83-2c24cef83452" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186494883}] :answer-field/correct {:answer/id #uuid "b32d799a-1971-505f-9d44-6d88dea78839" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186494736} :answer-field/id #uuid "ce35d819-2898-51ad-bcff-556e53b6cc07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186495016}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d345ec95-0d6e-5d8e-a681-8aa64a38a770" :question/math-academy-id "q-61238" :question/problem "What is the distance between the points $(-2,2)$  and $(-2,7)?$" :question/worked-solution "**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/39/39ac0f7718d7ee4ca8ed96b43c4f5ff9b644e0a3f7b5e2629052468b36ccf687.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $5$ units, so the distance equals $5.$\n\n![](images/59/5995f7494a28a33cc4bdeef51d7d4cc0a85ee8e3219d8630d366c50345629d54.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $x$-axis and then subtracting.\n\n![](images/1c/1cb541f6fcbb93b30a8f154763b0daa60e3b76142db1001ce804a2a68ba79247.png)\n\nThe point $(-2,7)$ is at a distance of $7$ from the $x$-axis, and the point $(-2,2)$ is at a distance of $2$ from the $x$-axis. Therefore, the distance between the two points is $7-2=5.$"}] [{:db/id #edb/ref 17592186495173 :knowledge-point/_questions [{:db/id #edb/ref 17592186073899 :knowledge-point/id #uuid "f0708cd3-0608-5d57-ac14-4c16ef362473" :knowledge-point/title "Finding the Vertical Distance Between Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42efa052-c9ab-54d8-9f6d-f34afac5ba39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186494453} {:answer/id #uuid "6ec87af5-64e1-5fd2-bd75-166d861e724a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186494553} {:answer/id #uuid "70a17d06-9360-5c19-9fa3-a5b4fb34974f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186494559} {:answer/id #uuid "c731f4ef-fe9c-53df-889c-769685b74d4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186494787} {:answer/id #uuid "ea8a321d-e3fc-594f-880d-2f2880f86d49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186494873}] :answer-field/correct {:answer/id #uuid "6ec87af5-64e1-5fd2-bd75-166d861e724a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186494553} :answer-field/id #uuid "7857e68d-f576-5073-be69-923b7ef4e7c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186494970}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fce25e13-2247-5592-b858-9038960a704e" :question/math-academy-id "q-61243" :question/problem "What is the distance between the points $(-5,-2)$  and $(-5,-9)?$" :question/worked-solution "**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/35/353bedad7a1692dea35f8b6adf30b7b461458c7852b4123a3fc865e1b23370a6.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $7$ units, so the distance equals $7.$\n\n![](images/e3/e3516729d7662a3b4438a3d3085da3428605d026ba3387a71afeb085e2bd3e73.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $x$-axis and then subtracting.\n\n![](images/f8/f8c5583d14d4e5ca50df3ce906254446c402177734f352169d794de2bb7dea5c.png)\n\nThe point $(-5,-2)$ is at a distance of $2$ from the $x$-axis, and the point $(-5,-9)$ is at a distance of $9$ from the $x$-axis. Therefore, the distance between the two points is $9-2=7.$"}]}
