th-academy-id "e-12976" :question/problem "Calculate $-81\\div (-9).$" :question/worked-solution "We have to divide a negative number ${\\color{red}(-81)}$ by another negative number ${\\color{red}(-9)}.$ So the result will be positive:\n![](images/bc/bcbaff723e9bce7d0cd513fb879cbc0a9758c2c5d9d584f4c55aab9df25e46d3.svg)\n\nNow, to compute the number that goes in the box, we divide $81$ by $9$ without any signs: $81 \\div 9 = 9.$ Therefore,  we get\n\n$$\n{\\color{red}(-81)} \\div {\\color{red}(-9)} = {\\color{blue}9}.\n$$"}] [{:db/id #edb/ref 17592186442934 :knowledge-point/_questions [{:db/id #edb/ref 17592186064358 :knowledge-point/id #uuid "7de4234d-932f-537c-9eae-746e1711cccd" :knowledge-point/title "Dividing a Positive Number by a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ad8be38-648b-57a3-980b-257313c2d78e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\,\\frac{1}{9}" :db/id #edb/ref 17592186442865} {:answer/id #uuid "297ebbb8-02e5-59f4-8704-eed5b7fbb4b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\,\\frac{2}{9}" :db/id #edb/ref 17592186442868} {:answer/id #uuid "ab6369d7-1d40-58a9-98dc-c2fd0a76f4fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\frac{7}{9}" :db/id #edb/ref 17592186442890} {:answer/id #uuid "d4bd4c13-9a0b-5b16-bd6b-3c1f5fbbcdc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\,\\frac{7}{9}" :db/id #edb/ref 17592186442899} {:answer/id #uuid "d8490e4a-34ad-5020-b49b-5a264aec83e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\frac{2}{9}" :db/id #edb/ref 17592186442901}] :answer-field/correct {:answer/id #uuid "d4bd4c13-9a0b-5b16-bd6b-3c1f5fbbcdc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\,\\frac{7}{9}" :db/id #edb/ref