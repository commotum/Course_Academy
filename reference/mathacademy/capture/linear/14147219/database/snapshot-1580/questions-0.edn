#{[{:db/id #edb/ref 17592186063941 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064357 :knowledge-point/id #uuid "b434d0d5-bd04-554b-888e-df84e3961839" :knowledge-point/title "Dividing a Negative Number by a Positive Number"}] :question/id #uuid "5b4f3b5f-2f0b-5178-9055-cf83a9885920" :question/math-academy-id "e-12972" :question/problem "Find the value of $-15 \\div 3$." :question/worked-solution "Here, we are dividing a negative number $\\color{red}(-15)$ by a positive one $\\color{blue}(3)$. So the result will be negative:\n$5$\n\nNow, to compute the number that goes in the box, we divide $15$ by $3$ without any signs:\n\n$$\n15 \\div 3 = 5\n$$\n\nTherefore, we get\n\n$$\n{\\color{red}(-15)} \\div {\\color{blue}3} = {\\color{red}-5}\n$$"}] [{:db/id #edb/ref 17592186063942 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064358 :knowledge-point/id #uuid "7de4234d-932f-537c-9eae-746e1711cccd" :knowledge-point/title "Dividing a Positive Number by a Negative Number"}] :question/id #uuid "166aaac7-bc88-577a-8e84-47347408e3c9" :question/math-academy-id "e-12973" :question/problem "Calculate the value of $50 \\div (-5)$." :question/worked-solution "We have to divide a positive number $\\color{blue}(50)$ by a negative one $\\color{red}(-5)$. So the result will be negative:\n$10$\n\nNow, to compute the number that goes in the box, we divide $50$ by $5$ without any signs:\n\n$$\n50 \\div 5 = 10\n$$\n\nTherefore, we get\n\n$$\n{\\color{blue}{50}} \\div {\\color{red}{(-5)}} = {\\color{red}{-10}}\n$$"}] [{:db/id #edb/ref 17592186063943 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064359 :knowledge-point/id #uuid "b85ef92b-d5fb-5927-aa68-60e72d0b3e72" :knowledge-point/title "Dividing a Negative Number by a Negative Number"}] :question/id #uuid "e2005c9d-c0ff-5b8e-bc64-4e222fd19fdf" :question/math-academy-id "e-12976" :question/problem "Calculate $-81\\div (-9)$." :question/worked-solution "We have to divide a negative number ${\\color{red}(-81)}$ by another negative number ${\\color{red}(-9)}$. So the result will be positive:\n$9$\n\nNow, to compute the number that goes in the box, we divide $81$ by $9$ without any signs:\n\n$$\n81 \\div 9 = 9\n$$\n\nTherefore, we get\n\n$$\n{\\color{red}(-81)} \\div {\\color{red}(-9)} = {\\color{blue}9}\n$$"}]}
