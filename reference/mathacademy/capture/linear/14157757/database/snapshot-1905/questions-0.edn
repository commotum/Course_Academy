#{[{:db/id #edb/ref 17592186054470 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054626 :knowledge-point/id #uuid "2a5017c8-1933-515c-980a-c4b6a8a46334" :knowledge-point/title "Evaluating an Expression With One Absolute Value"}] :question/id #uuid "af2c36f6-7258-56b3-aabc-c0736bdfb6a5" :question/math-academy-id "e-14209" :question/problem "Evaluate $\\mid x - 6 \\mid + 2 x +3$ for $x = -3$." :question/worked-solution "We substitute $x = -3$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}\n\\mid x - 6 \\mid + 2x + 3 &=  \\\\\n\\mid - 3 - 6 \\mid + 2(-3) + 3 &=  \\\\\n\\mid - 9 \\mid + 2(-3) + 3 &=  \\\\\n9 + 2(-3) + 3 &=  \\\\\n9 - 6 + 3 &=  \\\\\n&= 6\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054471 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054627 :knowledge-point/id #uuid "9d29b448-4fd6-51bc-b2f0-92e3d909f299" :knowledge-point/title "Evaluating an Expression With Two Absolute Values"}] :question/id #uuid "2af15364-dc4d-52c1-a519-02e8568279ae" :question/math-academy-id "e-14212" :question/problem "Evaluate $\\begin{vmatrix}2 - x & + 1 + 5 & x\\end{vmatrix}$ for $x = 5$." :question/worked-solution "We substitute $x = 5$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}\n\\begin{vmatrix}2 - x & + 1 + 5 & x\\end{vmatrix} &=  \\\\\n\\begin{vmatrix}2 - 5 & + 1 + 5 & 5\\end{vmatrix} &=  \\\\\n\\mid - 3 \\mid + 1 + 5(5) &=  \\\\\n3 + 1 + 25 &=  \\\\\n4 + 25 &=  \\\\\n&= 29\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186055103 :knowledge-point/_questions [{:db/id #edb/ref 17592186054627 :knowledge-point/id #uuid "9d29b448-4fd6-51bc-b2f0-92e3d909f299" :knowledge-point/title "Evaluating an Expression With Two Absolute Values"}] :question/answer-fields [{:answer-field/id #uuid "7605857f-6ec1-5c37-83db-3d9633b3952d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186052049}] :question/id #uuid "77b7fa26-d28f-58ff-acd8-77ebdc7f46c6" :question/math-academy-id "q-212318" :question/problem "If $t = 0$, then $\\begin{vmatrix}t - 2 & -\\end{vmatrix}t + 3|=$ {{field-1}}."}]}
