#{[{:db/id #edb/ref 17592186054470 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054626 :knowledge-point/id #uuid "2a5017c8-1933-515c-980a-c4b6a8a46334" :knowledge-point/title "Evaluating an Expression With One Absolute Value"}] :question/id #uuid "af2c36f6-7258-56b3-aabc-c0736bdfb6a5" :question/math-academy-id "e-14209" :question/problem "Evaluate $|x - 6| + 2 x +3$ for $x = -3.$" :question/worked-solution "We substitute $x = -3$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|x-6|+2x+3 & = \\\\ |-3-6|+2(-3)+3 & = \\\\ |-9|+2(-3)+3 & = \\\\ 9+2(-3)+3 & = \\\\ 9-6+3 & = \\\\ 6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054471 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054627 :knowledge-point/id #uuid "9d29b448-4fd6-51bc-b2f0-92e3d909f299" :knowledge-point/title "Evaluating an Expression With Two Absolute Values"}] :question/id #uuid "2af15364-dc4d-52c1-a519-02e8568279ae" :question/math-academy-id "e-14212" :question/problem "Evaluate $|2 - x| + 1 + 5|x|$ for $x = 5.$" :question/worked-solution "We substitute $x = 5$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|2-x|+1+5|x| & = \\\\ |2-5|+1+5|5| & = \\\\ |-3|+1+5(5) & = \\\\ 3+1+25 & = \\\\ 4+25 & = \\\\ 29\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481409 :knowledge-point/_questions [{:db/id #edb/ref 17592186054627 :knowledge-point/id #uuid "9d29b448-4fd6-51bc-b2f0-92e3d909f299" :knowledge-point/title "Evaluating an Expression With Two Absolute Values"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3376d8a9-d9cf-56fe-87c0-0b074a11fc4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186480838} {:answer/id #uuid "4c4f1470-7854-5859-9502-6ce3be1a1e33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-37" :db/id #edb/ref 175921864