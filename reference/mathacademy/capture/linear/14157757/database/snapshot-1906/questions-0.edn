answer/id #uuid "3871d1a8-8b5e-554b-aea0-bef649450799" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186480848} :answer-field/id #uuid "36e13187-05a7-5f23-83c3-7072e5bce2e1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481260}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8db98389-40f2-5730-bf5c-0c0bb991f194" :question/math-academy-id "q-212311" :question/problem "If $y=10,$ then $|y-15|+2-y=${{field-1}}." :question/worked-solution "We substitute $y=10$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|y-15|+2-y & = \\\\ |10-15|+2-10 & = \\\\ |-5|+2-10 & = \\\\ 5+2-10 & = \\\\ -3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186055103 :knowledge-point/_questions [{:db/id #edb/ref 17592186054627 :knowledge-point/id #uuid "9d29b448-4fd6-51bc-b2f0-92e3d909f299" :knowledge-point/title "Evaluating an Expression With Two Absolute Values"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e021af68-5d6f-5219-aa63-1cfbae73cd9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186481159}] :answer-field/correct {:answer/id #uuid "e021af68-5d6f-5219-aa63-1cfbae73cd9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186481159} :answer-field/id #uuid "7605857f-6ec1-5c37-83db-3d9633b3952d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186052049}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "77b7fa26-d28f-58ff-acd8-77ebdc7f46c6" :question/math-academy-id "q-212318" :question/problem "If $t=0,$ then $|t-2|-|t+3|=${{field-1}}." :question/worked-solution "We substitute $t=0$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|t-2|-|t+3| & = \\\\ |0-2|-|0+3| & = \\\\ |-2|-|3| & = \\\\ 2-3 & = \\\\ -1 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481347 :knowledge-point/_questions [{:db/id #edb/ref 17592186054626 :knowledge-point/id #uuid "2a5017c8-1933-515c-980a-c4b6a8a46334" :knowledge-point/title "Evaluating an Expression With One Absolute Value"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da556150-891e-5d8b-9f01-4c094a952cfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186481151}] :answer-field/correct {:answer/id #uuid "da556150-891e-5d8b-9f01-4c094a952cfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186481151} :answer-field/id #uuid "da963681-e81e-570e-8ee7-27f4ce7fcb83" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481323}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0c594a87-b025-5472-b8ba-c9c1f57faafe" :question/math-academy-id "q-215788" :question/problem "If $x=-2,$ then $|{x}^{3}-x|+2x=${{field-1}}." :question/worked-solution "We substitute $x=-2$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|{x}^{3}-x|+2x & = \\\\ |(-2)^{3}-(-2)|+2(-2) & = \\\\ |-8+2|-4 & = \\\\ |-6|-4 & = \\\\ 6-4 & = \\\\ 2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481436 :knowledge-point/_questions [{:db/id #edb/ref 17592186054626 :knowledge-point/id #uuid "2a5017c8-1933-515c-980a-c4b6a8a46334" :knowledge-point/title "Evaluating an Expression With One Absolute Value"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "684c058e-fbb0-5665-8e58-bdc2317acb6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186480932}] :answer-field/correct {:answer/id #uuid "684c058e-fbb0-5665-8e58-bdc2317acb6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186480932} :answer-field/id #uuid "0f498857-35a2-5b14-a67d-d149c66e46bb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481247}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f8176f08-c3fb-5b9f-a7f7-c8961022e13b" :question/math-academy-id "q-215791" :question/problem "If $y=-3,$ then $|2y+7{|}^{6}=${{field-1}}." :question/worked-solution "We substitute $y=-3$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|2y+7{|}^{6} & = \\\\ |2(-3)+7{|}^{6} & = \\\\ |-6+7{|}^{6} & = \\\\ |1{|}^{6} & = \\\\ {1}^{6} & = \\\\ 1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481358 :knowledge-point/_questions [{:db/id #edb/ref 17592186054627 :knowledge-point/id #uuid "9d29b448-4fd6-51bc-b2f0-92e3d909f299" :knowledge-point/title "Evaluating an Expression With Two Absolute Values"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "069e3471-ebe0-5e7e-8dba-bc08c1f1ec1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186480751}] :answer-field/correct {:answer/id #uuid "069e3471-ebe0-5e7e-8dba-bc08c1f1ec1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186480751} :answer-field/id #uuid "ae6361ee-8e08-51d0-bc10-6459c6132ecc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481300}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3d01c032-f798-5a69-9d8e-9a45c684623b" :question/math-academy-id "q-215798" :question/problem "If $x=-7,$ then $|x+2|+|x|=${{field-1}}." :question/worked-solution "We substitute $x=-7$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|x+2|+|x| & = \\\\ |-7+2|+|-7| & = \\\\ |-5|+|-7| & = \\\\ 5+7 & = \\\\ 12 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481394 :knowledge-point/_questions [{:db/id #edb/ref 17592186054627 :knowledge-point/id #uuid "9d29b448-4fd6-51bc-b2f0-92e3d909f299" :knowledge-point/title "Evaluating an Expression With Two Absolute Values"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6cc06e26-7f7d-5361-947a-a5a6be1a9519" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186480943}] :answer-field/correct {:answer/id #uuid "6cc06e26-7f7d-5361-947a-a5a6be1a9519" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186480943} :answer-field/id #uuid "aceab721-8a64-56ee-a107-a68ea20a149a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481298}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8e7406b5-c760-50f7-b793-e44ff061d556" :question/math-academy-id "q-215801" :question/problem "If $y=-2,$ then $|3-{y}^{4}|+|y|-8=${{field-1}}." :question/worked-solution "We substitute $y=-2$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|3-{y}^{4}|+|y|-8 & = \\\\ |3-(-2)^{4}|+|-2|-8 & = \\\\ |3-16|+|-2|-8 & = \\\\ |-13|+|-2|-8 & = \\\\ 13+2-8 & = \\\\ 7 & \\end{aligned}\n$$"}]}
