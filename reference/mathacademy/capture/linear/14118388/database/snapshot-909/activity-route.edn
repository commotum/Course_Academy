#{[{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186414665} :activity/id #uuid "1cd8eb7e-fe04-5fdd-83e0-383ffc51e2ba" :activity/scope {:db/id #edb/ref 17592186050693 :topic/id #uuid "5f71e968-b382-5c1b-bc8c-518dc0440228" :topic/math-academy-id 2101} :activity/steps [{:db/id #edb/ref 17592186414664 :step/content {:db/id #edb/ref 17592186414663 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bec6782-5b25-5f66-a69c-bd940a684008" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{84.32}^{∘}" :db/id #edb/ref 17592186414645} {:answer/id #uuid "42d9c80c-b7ce-5329-bd52-05c6944cc99d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{83.24}^{∘}" :db/id #edb/ref 17592186414648} {:answer/id #uuid "6fccab70-38d0-5196-9e05-328ab9515f03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{85.50}^{∘}" :db/id #edb/ref 17592186414649} {:answer/id #uuid "82db5a26-f843-545e-b28d-8edda8760ffb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{87.27}^{∘}" :db/id #edb/ref 17592186414651} {:answer/id #uuid "89bd71bc-8f74-5cc5-8323-858f0ad1097e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{85.35}^{∘}" :db/id #edb/ref 17592186414652}] :answer-field/correct {:db/id #edb/ref 17592186414649} :answer-field/id #uuid "c9256cbf-1d22-506c-aaed-b510f33eb670" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186414661}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "99b52f99-8be2-5e57-bfd3-38bdea87dcf3" :question/math-academy-id "q-40563" :question/problem "Rounded to two decimal places, what is the acute angle between the vectors $v=[\\begin{aligned}6 \\\\ \\sqrt{5} \\\\ 1 \\\\ -1\\end{aligned}]$ and $w=[\\begin{aligned}1 \\\\ -2 \\\\ 2\\sqrt{5} \\\\ 3\\end{aligned}]?$" :question/worked-solution "Using the formula\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{v\\cdot w}{‖v‖\\,‖w‖},\n$$\n\nwe have the following:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{(6)(1)+(\\sqrt{5})(-2)+(1)(2\\sqrt{5})+(-1)(3)}{\\sqrt{{6}^{2}+(\\sqrt{5})^{2}+{1}^{2}+(-1)^{2}}\\sqrt{{1}^{2}+(-2)^{2}+(2\\sqrt{5})^{2}+{3}^{2}}} \\\\  & =\\frac{3}{\\sqrt{43}\\sqrt{34}} \\\\  & =\\frac{3\\sqrt{1462}}{1462}\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{3\\sqrt{1462}}{1462})≈{85.50}^{∘}.\n$$"} :step/id #uuid "31ec05bc-1755-5418-abd2-881dd5798752" :step/next {:db/id #edb/ref 17592186414666}} {:db/id #edb/ref 17592186414665 :step/content {:db/id #edb/ref 17592186414662 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bff7206-3e83-5486-87f5-627306292967" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{5}" :db/id #edb/ref 17592186414646} {:answer/id #uuid "385da54c-4492-5bbc-951a-ed5c5080d241" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186414647} {:answer/id #uuid "c9aa9be2-fd88-5217-83f7-344e4baf419e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186414656} {:answer/id #uuid "d4a61390-9440-51e4-aed8-0f77831ed9d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{8}" :db/id #edb/ref 17592186414657} {:answer/id #uuid "faeabdd2-c5d4-509e-96e7-7dc4d046eb5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186414658}] :answer-field/correct {:db/id #edb/ref 17592186414647} :answer-field/id #uuid "8e595341-6d0b-5218-827a-e206e85ab469" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186414659}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "44f2ea0b-1adf-505c-8fa7-ec801c70c20d" :question/math-academy-id "q-40560" :question/problem "Find the acute angle between the vectors $v=[\\begin{aligned}-\\sqrt{2} \\\\ 1 \\\\ -2 \\\\ 3\\end{aligned}]$ and $w=[\\begin{aligned}1 \\\\ \\sqrt{2} \\\\ -5 \\\\ 2\\end{aligned}].$" :question/worked-solution "Using the formula\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{v\\cdot w}{‖v‖\\,‖w‖},\n$$\n\nwe have the following: \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{(-\\sqrt{2})(1)+(1)(\\sqrt{2})+(-2)(-5)+(3)(2)}{\\sqrt{(-\\sqrt{2})^{2}+{1}^{2}+(-2)^{2}+{3}^{2}}\\sqrt{{1}^{2}+(\\sqrt{2})^{2}+(-5)^{2}+{2}^{2}}} \\\\  & =\\frac{16}{\\sqrt{16}\\sqrt{32}} \\\\  & =\\frac{4}{\\sqrt{32}} \\\\  & =\\frac{1}{\\sqrt{2}} \\\\  & =\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{2}}{2})=\\frac{\\pi }{4}.\n$$"} :step/id #uuid "a5f85e51-6089-5f7b-af28-71304b8227fc" :step/next {:db/id #edb/ref 17592186414664}} {:db/id #edb/ref 17592186414666 :step/content {:db/id #edb/ref 17592186134331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "002742f3-7284-5ac0-8779-30b804e92705" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{\\sqrt{131}}" :db/id #edb/ref 17592186414644} {:answer/id #uuid "7d06f1ec-30ff-53f8-9943-6ae3b36ce40d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{\\sqrt{266}}" :db/id #edb/ref 17592186414650} {:answer/id #uuid "bcaffc6f-0a85-5982-a4c7-707c5cbc1a65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{15}{\\sqrt{131}}" :db/id #edb/ref 17592186414653} {:answer/id #uuid "bd84ff6d-55f1-5a15-aef5-c63480bc1877" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{13}{\\sqrt{266}}" :db/id #edb/ref 17592186414654} {:answer/id #uuid "bf2d35a4-2976-51e9-ab5e-f0e748e55003" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{18}{\\sqrt{266}}" :db/id #edb/ref 17592186414655}] :answer-field/correct {:db/id #edb/ref 17592186414650} :answer-field/id #uuid "c90a5531-3cd5-5504-b1c0-5278d3ea6ed7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186414660}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3dd6a25a-12e9-5ca9-91cb-a545462d6da3" :question/math-academy-id "q-40902" :question/problem "Let $A(-2,1,0,-3)$ and $B(1,-1,1,-4).$ Find the cosine of the angle $∠AOB$, where $O(0,0,0,0)$ is the origin." :question/worked-solution "First, let\n\n$$\n\\begin{aligned}a=\\overset{\\to }{OA}=[\\begin{aligned}-2 \\\\ 1 \\\\ 0 \\\\ -3\\end{aligned}],\\,b=\\overset{\\to }{OB}=[\\begin{aligned}1 \\\\ -1 \\\\ 1 \\\\ -4\\end{aligned}].\\end{aligned}\n$$\n\nAlso, let $\\theta =m∠AOB$ be the angle between the vectors $a$ and $b.$ Then, we can find $\\operatorname{cos}⁡\\theta $ using the following formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{‖a‖\\,‖b‖} \\\\  & =\\frac{{a}_{1}{b}_{1}+{a}_{2}{b}_{2}+{a}_{3}{b}_{3}+{a}_{4}{b}_{4}}{\\sqrt{{a}_{1}^{2}+{a}_{2}^{2}+{a}_{3}^{2}+{a}_{4}^{2}}\\,\\sqrt{{b}_{1}^{2}+{b}_{2}^{2}+{b}_{3}^{2}+{b}_{4}^{2}}} \\\\  & =\\frac{(-2)\\cdot 1+1\\cdot (-1)+0\\cdot 1+(-3)\\cdot (-4)}{\\sqrt{(-2)^{2}+{1}^{2}+{0}^{2}+(-3)^{2}}\\,\\sqrt{{1}^{2}+(-1)^{2}+{1}^{2}+(-4)^{2}}} \\\\  & =\\frac{9}{\\sqrt{14}\\cdot \\sqrt{19}} \\\\  & =\\frac{9}{\\sqrt{266}}\\end{aligned}\n$$"} :step/id #uuid "fa61a90f-8525-5836-ab74-36eb3593cfd4"}] :activity/title "The Cauchy-Schwarz Inequality and the Angle Between Two Vectors" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186414643}]}
