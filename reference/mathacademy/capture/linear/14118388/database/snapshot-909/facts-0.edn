22-506c-aaed-b510f33eb670" #edb/ref 17592186045417] [17592186414662 #edb/ref 1068 #edb/ref 17592186414659 #edb/ref 17592186045417] [17592186414662 #edb/ref 1069 "q-40560" #edb/ref 17592186045417] [17592186414662 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186414662 #edb/ref 1071 "Find the acute angle between the vectors $v=[\\begin{aligned}-\\sqrt{2} \\\\ 1 \\\\ -2 \\\\ 3\\end{aligned}]$ and $w=[\\begin{aligned}1 \\\\ \\sqrt{2} \\\\ -5 \\\\ 2\\end{aligned}].$" #edb/ref 17592186045417] [17592186414662 #edb/ref 1072 #uuid "44f2ea0b-1adf-505c-8fa7-ec801c70c20d" #edb/ref 17592186045417] [17592186414662 #edb/ref 1074 "Using the formula\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{v\\cdot w}{‖v‖\\,‖w‖},\n$$\n\nwe have the following: \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{(-\\sqrt{2})(1)+(1)(\\sqrt{2})+(-2)(-5)+(3)(2)}{\\sqrt{(-\\sqrt{2})^{2}+{1}^{2}+(-2)^{2}+{3}^{2}}\\sqrt{{1}^{2}+(\\sqrt{2})^{2}+(-5)^{2}+{2}^{2}}} \\\\  & =\\frac{16}{\\sqrt{16}\\sqrt{32}} \\\\  & =\\frac{4}{\\sqrt{32}} \\\\  & =\\frac{1}{\\sqrt{2}} \\\\  & =\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{2}}{2})=\\frac{\\pi }{4}.\n$$" #edb/ref 17592186045417] [17592186414663 #edb/ref 1068 #edb/ref 17592186414661 #edb/ref 17592186045417] [17592186414663 #edb/ref 1069 "q-40563" #edb/ref 17592186045417] [17592186414663 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186414663 #edb/ref 1071 "Rounded to two decimal places, what is the acute angle between the vectors $v=[\\begin{aligned}6 \\\\ \\sqrt{5} \\\\ 1 \\\\ -1\\end{aligned}]$ and $w=[\\begin{aligned}1 \\\\ -2 \\\\ 2\\sqrt{5} \\\\ 3\\end{aligned}]?$" #edb/ref 17592186045417] [17592186414663 #edb/ref 1072 #uuid "99b52f99-8be2-5e57-bfd3-38bdea87dcf3" #edb/ref 17592186045417] [17592186414663 #edb/ref 1074 "Using the formula\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{v\\cdot w}{‖v‖\\,‖w‖},\n$$\n\nwe have the following:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{{v}_{1}{w}_{1}+{v}_{2}{w}_{2}+{v}_{3}{w}_{3}+{v}_{4}{w}_{4}}{\\sqrt{{v}_{1}^{2}+{v}_{2}^{2}+{v}_{3}^{2}+{v}_{4}^{2}}\\sqrt{{w}_{1}^{2}+{w}_{2}^{2}+{w}_{3}^{2}+{w}_{4}^{2}}} \\\\  & =\\frac{(6)(1)+(\\sqrt{5})(-2)+(1)(2\\sqrt{5})+(-1)(3)}{\\sqrt{{6}^{2}+(\\sqrt{5})^{2}+{1}^{2}+(-1)^{2}}\\sqrt{{1}^{2}+(-2)^{2}+(2\\sqrt{5})^{2}+{3}^{2}}} \\\\  & =\\frac{3}{\\sqrt{43}\\sqrt{34}} \\\\  & =\\frac{3\\sqrt{1462}}{1462}\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{3\\sqrt{1462}}{1462})≈{85.50}^{∘}.\n$$" #edb/ref 17592186045417] [17592186414664 #edb/ref 1058 #edb/ref 17592186414666 #edb/ref 17592186045417] [17592186414664 #edb/ref 1062 #uuid "31ec05bc-1755-5418-abd2-881dd5798752" #edb/ref 17592186045417] [17592186414664 #edb/ref 1063 #edb/ref 17592186414663 #edb/ref 17592186045417] [17592186414665 #edb/ref 1058 #edb/ref 17592186414664 #edb/ref 17592186045417] [17592186414665 #edb/ref 1062 #uuid "a5f85e51-6089-5f7b-af28-71304b8227fc" #edb/ref 17592186045417] [17592186414665 #edb/ref 1063 #edb/ref 17592186414662 #edb/ref 17592186045417] [17592186414666 #edb/ref 1062 #uuid "fa61a90f-8525-5836-ab74-36eb3593cfd4" #edb/ref 17592186045417] [17592186414666 #edb/ref 1063 #edb/ref 17592186134331 #edb/ref 17592186045417]}
