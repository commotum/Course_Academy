" displaystyle=\"true\" columnalign=\"right left\"><mtr><mtd><mi>Q</mi><mi>R</mi></mtd><mtd><mo>=</mo><msqrt><mi>P</mi><msup><mi>R</mi><mn>2</mn></msup><mo>−</mo><mi>P</mi><msup><mi>Q</mi><mn>2</mn></msup></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><msqrt><msup><mn>12.5</mn><mn>2</mn></msup><mo>−</mo><msup><mn>3.5</mn><mn>2</mn></msup></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><msqrt><mn>156.25</mn><mo>−</mo><mn>12.25</mn></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><msqrt><mn>144</mn></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mn>12</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Therefore,</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"20\" style=\"font-size: 113.1%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 5.686em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0.139em; padding-bottom: 0.5em;\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c74\"></mjx-c><mjx-c class=\"mjx-c61\"></mjx-c><mjx-c class=\"mjx-c6E\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2061\"></mjx-c></mjx-mo><mjx-texatom space=\"2\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D443 TEX-I\"></mjx-c></mjx-mi></mjx-texatom><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"text-align: left; padding-left: 0.139em; padding-bottom: 0.5em;\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mstyle space=\"4\"><mjx-mfrac><mjx-frac type=\"d\"><mjx-num><mjx-nstrut type=\"d\"></mjx-nstrut><mjx-mrow><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D444 TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D445 TEX-I\"></mjx-c></mjx-mi></mjx-mrow></mjx-num><mjx-dbox><mjx-dtable><mjx-line type=\"d\"></mjx-line><mjx-row><mjx-den><mjx-dstrut type=\"d\"