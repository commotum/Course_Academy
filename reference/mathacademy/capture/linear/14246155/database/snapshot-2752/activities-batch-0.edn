#{[{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186079242} :activity/id #uuid "0d14646c-eeb0-5b75-9e6d-1004f8c5e4d7" :activity/scope {:db/id #edb/ref 17592186048299 :topic/id #uuid "92705545-a0a9-5765-ace5-b1ebda874c1c" :topic/math-academy-id 633} :activity/steps [{:db/id #edb/ref 17592186079242 :step/content {:db/id #edb/ref 17592186079637 :tutorial/content "Suppose that we have a right triangle $\\triangle ABC$ with legs $AC= BC = 1,$ like the one in the diagram below.\nHow can we find the value $\\sin \\theta$ if we don't know one of the relevant sides?\n\n![](images/ae/ae5157e6824fd98861194302ab912e76d9e79dade6706dfbedea97d859f18a79.png)\n\nRecall the definition of sine: \n\n$$\n\\sin \\theta = \\dfrac {\\textrm{opposite}}{\\textrm{hypotenuse}} = \\dfrac {AC}{AB} = \\dfrac 1 c\n$$\n\nHere, we need to determine the missing side $c.$ The trick is to use the Pythagorean Theorem:\n\n$$\n\\begin{aligned}c & =\\sqrt{A{C}^{2}+B{C}^{2}} \\\\  & =\\sqrt{{1}^{2}+{1}^{2}} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nFinally, we can finish computing the value of $\\sin\\theta\\mathbin{:}$\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\frac{1}{c}=\\frac{1}{\\sqrt{2}}=\\frac{1\\cdot \\sqrt{2}}{\\sqrt{2}\\cdot \\sqrt{2}}=\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nNo matter which trigonometric function we need to find, if we are missing one of the relevant sides but we know the lengths of the other two sides, we can always use the Pythagorean Theorem." :tutorial/id #uuid "75942071-e229-5a18-a349-e9a0df09faba" :tutorial/math-academy-id 2446 :tutorial/title "Introduction"} :step/id #uuid "8ebb795c-035e-52c3-b4ba-c450ca1f827f" :step/math-academy-id 10963 :step/next {:db/id #edb/ref 17592186079243}} {:db/id #edb/ref 17592186079243 :step/content {:db/id #edb/ref 17592186078392 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078250 :question/id #uuid "8ea6aa9d-bdb3-58d5-9182-8f70176f7060" :question/math-academy-id "e-3242"} :knowledge-point/id #uuid "c44fafc7-d2e5-584e-8812-6b6983b91cdc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049224} {:db/id #edb/ref 17592186049915}] :knowledge-point/questions [{:db/id #edb/ref 17592186078735} {:db/id #edb/ref 17592186078964} {:db/id #edb/ref 17592186540063} {:db/id #edb/ref 17592186540105}] :knowledge-point/title "Evaluating a Trigonometric Ratio by Using the Pythagorean Theorem to Solve for the Hypotenuse"} :step/id #uuid "6c12aa91-d787-5d8f-9350-a9292f99b2bf" :step/math-academy-id 10965 :step/next {:db/id #edb/ref 17592186079244}} {:db/id #edb/ref 17592186079244 :step/content {:db/id #edb/ref 17592186078393 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078252 :question/id #uuid "ab766585-35c3-5c75-bb18-d7d22b505079" :question/math-academy-id "e-3244"} :knowledge-point/id #uuid "0a83e174-ab83-5bf6-898e-0fe5cddc8ef4" :knowledge-point/questions [{:db/id #edb/ref 17592186078736} {:db/id #edb/ref 17592186078737} {:db/id #edb/ref 17592186234385} {:db/id #edb/ref 17592186540081} {:db/id #edb/ref 17592186563724}] :knowledge-point/title "Evaluating a Trigonometric Ratio by Using the Pythagorean Theorem to Solve for a Leg"} :step/id #uuid "b3770d5c-9454-5c9e-9318-ca70f7d23260" :step/math-academy-id 10967 :step/next {:db/id #edb/ref 17592186079245}} {:db/id #edb/ref 17592186079245 :step/content {:db/id #edb/ref 17592186078394 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078254 :question/id #uuid "cc59ecc0-e886-5e7d-8fbe-c63df5995d3d" :question/math-academy-id "e-3246"} :knowledge-point/id #uuid "7dc4cb42-6295-5484-b37e-0c557c4f6073" :knowledge-point/questions [{:db/id #edb/ref 17592186078740} {:db/id #edb/ref 17592186079166} {:db/id #edb/ref 17592186540033} {:db/id #edb/ref 17592186540061} {:db/id #edb/ref 17592186540114} {:db/id #edb/ref 17592186563680}] :knowledge-point/title "Evaluating a Trigonometric Ratio by Using the Pythagorean Theorem with Decimals"} :step/id #uuid "a6811326-f5c8-5f68-91b5-87dca18b285d" :step/math-academy-id 10971}] :activity/title "Calculating Trigonometric Ratios Using the Pythagorean Theorem" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078657}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186563766} :activity/id #uuid "2fc03e67-f529-57d4-bd70-e937a60ca493" :activity/scope {:db/id #edb/ref 17592186048299 :topic/id #uuid "92705545-a0a9-5765-ace5-b1ebda874c1c" :topic/math-academy-id 633} :activity/steps [{:db/id #edb/ref 17592186563766 :step/content {:db/id #edb/ref 17592186078737 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a03f1c4-85f0-544a-98ce-eb511fe07eaa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186075299} {:answer/id #uuid "0a671052-347b-512f-9f82-a17f56d9b608" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{6}}{8}" :db/id #edb/ref 17592186075300} {:answer/id #uuid "39c25198-703a-5df7-aa3a-a52a10dde17f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\sqrt{2}}{5}" :db/id #edb/ref 17592186075301} {:answer/id #uuid "4ee76099-e24e-58a0-bb4f-7e88b011ff6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186075302} {:answer/id #uuid "5fa3c182-4108-54cf-ac41-2c7b914e0c29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{7}}{5}" :db/id #edb/ref 17592186075303}] :answer-field/correct {:db/id #edb/ref 17592186075301} :answer-field/id #uuid "daf6a544-6cab-5dae-af57-5b6a03128e40" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186075298}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a297f665-c83d-57c5-a5b3-4e4cdbf2c7d6" :question/math-academy-id "q-14581" :question/problem "![](images/d0/d04a8e993da8e90ca75f5f7541317d26a6a9c8f9b76cdb9c95511080035177c5.png)\n\nFind the cosine of $∠Y.$" :question/requires-calculator true :question/worked-solution "Recall the definition of cosine: \n\n$$\n\\operatorname{cos}⁡Y=\\frac{\\text{adjacent}}{\\text{hypotenuse}}=\\frac{XY}{YZ}=\\frac{XY}{5}\n$$\n\nHere, we need to determine the missing side $XY.$ The trick is to use the Pythagorean Theorem:\n\n$$\n\\begin{aligned}XY & =\\sqrt{Y{Z}^{2}-X{Z}^{2}} \\\\  & =\\sqrt{{5}^{2}-(\\sqrt{7})^{2}} \\\\  & =\\sqrt{25-7} \\\\  & =\\sqrt{18} \\\\  & =3\\sqrt{2}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡Y & =\\frac{XY}{5}=\\frac{3\\sqrt{2}}{5}.\\end{aligned}\n$$"} :step/id #uuid "19daaae6-6d2a-56f2-a06f-7650bdc33cd8" :step/next {:db/id #edb/ref 17592186563774}} {:db/id #edb/ref 17592186563774 :step/content {:db/id #edb/ref 17592186563724 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2561f127-b662-5797-b919-80264e333b26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\sqrt{5}}{5}" :db/id #edb/ref 17592186563030} {:answer/id #uuid "35b1eb42-ba69-53f4-81c2-c8740d0d9806" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\sqrt{5}}{5}" :db/id #edb/ref 17592186563067} {:answer/id #uuid "493e3c85-b25e-53b6-a08c-4fea9dba4c1c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\sqrt{5}" :db/id #edb/ref 17592186563106} {:answer/id #uuid "c48feefc-15c4-5bef-ac32-e7d9d07bb0ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{3}" :db/id #edb/ref 17592186563376} {:answer/id #uuid "d04f3cfc-1715-5df0-995f-34492b52003c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{5}" :db/id #edb/ref 17592186563402}] :answer-field/correct {:db/id #edb/ref 17592186563067} :answer-field/id #uuid "f15bdbe8-d486-594d-b02d-d29460c4afc4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563637}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b2b55850-322e-5b17-9a94-b2696bd083f6" :question/math-academy-id "q-122050" :question/problem "In the right triangle $△JKL,$ $∠J$ is a right angle, $JL=8$ and $KL=12.$ Find $\\operatorname{tan}⁡K.$" :question/worked-solution "The following triangle illustrates the information given.\n\n![](images/cc/cc33327cc6d071cb6ec9ac0c10d58e57bc35f8d81b326731120cf04c18f58ec1.png)\n\nRecall the definition of tangent: \n\n$$\n\\operatorname{tan}⁡K=\\frac{\\text{opposite}}{\\text{adjacent}}=\\frac{JL}{JK}=\\frac{8}{JK}\n$$\n\nHere, we need to determine the missing side $JK.$ The trick is to use the Pythagorean Theorem:\n\n$$\n\\begin{aligned}JK & =\\sqrt{K{L}^{2}-J{L}^{2}} \\\\  & =\\sqrt{{12}^{2}-{8}^{2}} \\\\  & =\\sqrt{144-64} \\\\  & =\\sqrt{80} \\\\  & =4\\sqrt{5}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡K & =\\frac{8}{4\\sqrt{5}} \\\\  & =\\frac{2}{\\sqrt{5}} \\\\  & =\\frac{2}{\\sqrt{5}}\\cdot \\frac{\\sqrt{5}}{\\sqrt{5}} \\\\  & =\\frac{2\\sqrt{5}}{5}.\\end{aligned}\n$$"} :step/id #uuid "311cff77-4b9d-5219-ae3d-48aca39552db" :step/next {:db/id #edb/ref 17592186563809}} {:db/id #edb/ref 17592186563809 :step/content {:db/id #edb/ref 17592186563680 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24c3606f-796c-5b0b-8a50-19ba888da79b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{24}" :db/id #edb/ref 17592186563027} {:answer/id #uuid "9a5b3adb-f36e-546f-90c5-4151e04b2960" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{21}{5}" :db/id #edb/ref 17592186563293} {:answer/id #uuid "b43265d8-cc49-526f-8e22-5651c777ca5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{12}" :db/id #edb/ref 17592186563342} {:answer/id #uuid "dcdc4442-a9d9-5305-bc8b-adc1a7389cb8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{12}{7}" :db/id #edb/ref 17592186563429} {:answer/id #uuid "f46bc196-b847-5053-8f6e-796c26a26b99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{24}{7}" :db/id #edb/ref 17592186563492}] :answer-field/correct {:db/id #edb/ref 17592186563492} :answer-field/id #uuid "518b1e5c-6389-594b-b333-90ba109eabdc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563565}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "44ffb250-1ebe-5832-a06b-038dd7ff73b2" :question/math-academy-id "q-122171" :question/problem "![](images/0b/0bff27a71fc8421d51e69a677260f60a1e421c09fe3969f70d4c07bf1ac58576.png)\n\nFind the tangent of $∠P.$" :question/worked-solution "Recall the definition of tangent: \n\n$$\n\\operatorname{tan}⁡P=\\frac{\\text{opposite}}{\\text{adjacent}}=\\frac{QR}{PQ}=\\frac{QR}{3.5}\n$$\n\nHere, we need to determine the missing length $QR.$ The trick is to use the Pythagorean Theorem:\n\n$$\n\\begin{aligned}QR & =\\sqrt{P{R}^{2}-P{Q}^{2}} \\\\  & =\\sqrt{{12.5}^{2}-{3.5}^{2}} \\\\  & =\\sqrt{156.25-12.25} \\\\  & =\\sqrt{144} \\\\  & =12\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡P & =\\frac{QR}{3.5} \\\\  & =\\frac{12}{3.5} \\\\  & =\\frac{120}{35} \\\\  & =\\frac{24}{7}.\\end{aligned}\n$$"} :step/id #uuid "e42c4ff4-4729-582c-9103-cb4c5fbad322"}] :activity/title "Calculating Trigonometric Ratios Using the Pythagorean Theorem" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186562925}]}
