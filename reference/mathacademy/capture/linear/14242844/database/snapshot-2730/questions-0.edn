on/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "56d22403-432e-50ae-b57b-c4360be65083" :question/math-academy-id "q-16362" :question/problem "Which of the following is the graph of the function $y=\\frac{1}{x+4}+2?$" :question/worked-solution "The given function can be obtained by translating $y=\\frac{1}{x}$ both horizontally and vertically.\n\nWe have two translations:\n\n- the $+4$ in the denominator means a horizontal translation of $4$ units to the *left*, and\n\n- the $+2$ outside the fraction means a vertical translation of $2$ units *up*.\n\nSo, the new graph looks as follows:\n\n![](images/85/851b90f3d442a528ccc2441f0c15e3ef344be9ee54c6789b312673a5ee7ae06f.png)"}] [{:db/id #edb/ref 17592186180265 :knowledge-point/_questions [{:db/id #edb/ref 17592186179657 :knowledge-point/id #uuid "7bd87ed4-1b63-516e-9945-5de0c15e0c90" :knowledge-point/title "Graphing Horizontal Translations of Reciprocal Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b53d827c-ff25-528f-9649-2ea9069c798e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5b/5b08af75bcb971634255faf90bfdb24edb4de4be94bdb0dc094e118844e6d335.png" :db/id #edb/ref 17592186179135} {:answer/id #uuid "f5493a59-dac5-5d4b-b96f-894bca879192" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/11/117bcb3bed1764fe8ee78aeb8127f6771f55dab3b04d204606b42ecda3405f6b.png" :db/id #edb/ref 17592186179136} {:answer/id #uuid "583cfdf1-3d37-5e91-88a5-afcac53f5770" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/16/16d54b44282cb402b73ba6b67653a427b6de315d641f2d70f73f40b2acad95e2.png" :db/id #edb/ref 17592186179137} {:answer/id #uuid "5ffbf08b-ad5b-5607-986c-6c1b54c934e3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c5/c575c9898d27a6bf612d89655fcb78328a