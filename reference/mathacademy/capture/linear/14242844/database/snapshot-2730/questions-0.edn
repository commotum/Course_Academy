d43-5c3b-549b-b3c8-0cd389937794" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8e/8e73ed9744751224b9ef0bba78812f3681a9a98275f172b90552abcd1c6fc7d8.png" :db/id #edb/ref 17592186560444} {:answer/id #uuid "3bc9ec70-cf1f-53e0-9fec-93b995dd44d5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b9/b9b68c4f4407add9b297d6a077c1cbef10d50f6d680678dd4190f4bd4a14e57d.png" :db/id #edb/ref 17592186560500} {:answer/id #uuid "485a3976-0372-5957-b2a8-bc15b2c010fa" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a1/a1d8f2f4b804c9a7b8998cfd27e84303b60e0ae215a0f126dfe4ff5bb43d97ca.png" :db/id #edb/ref 17592186560523} {:answer/id #uuid "9030a799-cb3a-5ebf-9876-3b9560ccf0ab" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2c/2ce69568487a3808d066cd0e0e3befb4732c3fb3125fab33e02d44bd8a309bdc.png" :db/id #edb/ref 17592186560662} {:answer/id #uuid "d118d372-4320-5acc-bdd4-bcfef1d1a2d0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/12/12dffdcbf8105292d5d88f548ed673b214c2f491153c535e9749fe7e2e163d84.png" :db/id #edb/ref 17592186560781}] :answer-field/correct {:answer/id #uuid "227aed43-5c3b-549b-b3c8-0cd389937794" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8e/8e73ed9744751224b9ef0bba78812f3681a9a98275f172b90552abcd1c6fc7d8.png" :db/id #edb/ref 17592186560444} :answer-field/id #uuid "f0b86c36-4ba5-5460-9bef-164231b9026a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560965}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cdddff3e-12b7-51e5-bbd8-54acd953d28d" :question/math-academy-id "q-74385" :question/problem "Which of the following is the graph of the function $y=\\frac{1}{x-2}.$" :question/worked-solution "First, let's sketch the graph of $y=\\frac{1}{x}.$\n\n![](images/34/345fdaf3f301848b35448b710f240a308cfaadc1bae2729a5b0ddfa76793f6cb.png)\n\nSince we have $y=\\frac{1}{x-2},$ we need to translate the graph of $y=\\frac{1}{x}$ to the *right* by $2$ units.\n\nNow, since the graph of $y=\\frac{1}{x}$ is translated to the right by $2$ units, the vertical asymptote $x=0$ is also translated to the right by $2$ units. So, the equation of the new vertical asymptote is $x=2.$\n\nTherefore, the correct graph is as follows:\n\n![](images/8e/8e73ed9744751224b9ef0bba78812f3681a9a98275f172b90552abcd1c6fc7d8.png)"}]}
