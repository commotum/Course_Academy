-fields [{:answer-field/choices [{:answer/id #uuid "0ff81a49-0d16-5746-903d-60f6f455bb68" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fe/fe2430ab3ea16569aaba3c38e1d268f74cd7242c1e594eb5f14bc853b97a89e7.png" :db/id #edb/ref 17592186560400} {:answer/id #uuid "54c0b57c-a29e-5dd5-aff4-839755f093bd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ca/ca3d18d029fb7a0111046704cc911d2f5027fc50a132ba456d987c1ded345ab2.png" :db/id #edb/ref 17592186560549} {:answer/id #uuid "90cffb8a-d87b-5902-a447-970ea110de92" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fa/fa40fe0970b99770dfa6f228f4ed7b49db74d03c37162879b3458d83d340e7c1.png" :db/id #edb/ref 17592186560664} {:answer/id #uuid "de0532c3-9ba6-579a-b169-217d96152121" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/56/56d343e13ae9af0bd1f204f82f11abc685aa0b33f627b8d1ad175be34814fba0.png" :db/id #edb/ref 17592186560800} {:answer/id #uuid "f92d9fab-b888-55fb-a357-3b881cd30b6a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b8/b8ddc086b4a2a6e9f29843db6a861357271f14c138201ea314e6653ab51d1113.png" :db/id #edb/ref 17592186560855}] :answer-field/correct {:answer/id #uuid "90cffb8a-d87b-5902-a447-970ea110de92" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fa/fa40fe0970b99770dfa6f228f4ed7b49db74d03c37162879b3458d83d340e7c1.png" :db/id #edb/ref 17592186560664} :answer-field/id #uuid "73b8b396-f960-5434-9408-2683ac668e9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560911}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a049f227-9a74-52c4-a177-20bed5af6f28" :question/math-academy-id "q-74370" :question/problem "Which of the following is the graph of $y=-\\frac{1}{x}+2?$" :question/worked-solution "First, let's sketch the graph of $y=-\\frac{1}{x}.$\n\n![](images/1c/1cc1a1f5fa2bf98d700bf0c8d8e0630a4fda0540b8715865ee72d34b17049b8a.png)\n\nSince we have $y=-\\frac{1}{x}\\,+\\,2,$ we need to translate the graph of $y=-\\frac{1}{x}$ *up* by $2$ units.\n\nNow, since the graph of $y=-\\frac{1}{x}$ is translated up by $2$ units, the horizontal asymptote $y=0$ is also translated up by $2$ units. So, the equation of the new horizontal asymptote is $y=2.$\n\nTherefore, the correct graph is as follows:\n\n![](images/fa/fa40fe0970b99770dfa6f228f4ed7b49db74d03c37162879b3458d83d340e7c1.png)"}] [{:db/id #edb/ref 17592186560999 :knowledge-point/_questions [{:db/id #edb/ref 17592186179656 :knowledge-point/id #uuid "7e14129e-c8c9-5c9b-8ad4-feb9d618dd6b" :knowledge-point/title "Graphing Vertical Translations of Reciprocal Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3375677f-2605-5437-aded-b6c2230d05ae" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ac/ac83d9afe3a7c3333f9db674eee4458cfe5f210d58b5c48a5397b83be5fe103c.png" :db/id #edb/ref 17592186560480} {:answer/id #uuid "4b3f159b-1541-5e92-952b-f1551c9af726" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/56/56d343e13ae9af0bd1f204f82f11abc685aa0b33f627b8d1ad175be34814fba0.png" :db/id #edb/ref 17592186560529} {:answer/id #uuid "4c223c57-5e79-59f7-82f7-d42e3d82bde2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fa/fa40fe0970b99770dfa6f228f4ed7b49db74d03c37162879b3458d83d340e7c1.png" :db/id #edb/ref 17592186560534} {:answer/id #uuid "9b71c6d8-23d9-5cfc-a5fb-af31bdaa4b87" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/10/10c52c6f400ff5880358c6653f2cd0341aed312317d88438a545b2522e19b61b.p