#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186180364} :activity/id #uuid "5e5f11fe-e348-53cd-b6dc-ce7bd4a7602c" :activity/scope {:db/id #edb/ref 17592186050257 :topic/id #uuid "3a18fde4-db19-5b15-8908-3ebf74e1dcd1" :topic/math-academy-id 3735} :activity/steps [{:db/id #edb/ref 17592186180364 :step/content {:db/id #edb/ref 17592186180670 :tutorial/content "In general, the graph of \n\n$$\ny=\\dfrac{1}{x}+k\n$$\n\nis a vertical translation of the graph of $y=\\dfrac{1}{x}$ by $k$ units up.\n\nFor example, to plot the function \n\n$$\ny=\\dfrac{1}{x} \\, {\\color{blue} \\, +\\, 2},\n$$\n\nwe translate the original curve *up* by $\\color{blue}2$ units:\n\n![](images/2a/2aa8f50f8a40719e237c0e3d3706a3e161bfe1b107f6639c1df1a9aa8a956cbf.png)\n\nSimilarly, to plot the function \n\n$$\ny=\\dfrac{1}{x} \\, {\\color{red} - \\, 3},\n$$\n\nwe translate the original curve *down* by $\\color{red}3$ units:\n\n![](images/45/45b81796c0140f9963afc26d13af1df9c9ac3f41de430f0dfee1192ab33bf42d.png)\n\nWith vertical translations of the reciprocal function, the vertical asymptote doesn't change, but the horizontal asymptote is translated by the same number of units." :tutorial/id #uuid "8393cefa-8bed-55ae-8c13-24021fc39b02" :tutorial/math-academy-id 3461 :tutorial/title "Introduction"} :step/id #uuid "6fc045ed-1f66-5059-9322-147635824965" :step/math-academy-id 19595 :step/next {:db/id #edb/ref 17592186180370}} {:db/id #edb/ref 17592186180365 :step/content {:db/id #edb/ref 17592186180671 :tutorial/content "Because we know how to plot the graph of $y=\\dfrac{1}{x},$ we can also plot horizontal translations of this graph. In general, the graph of \n\n$$\ny=\\dfrac{1}{x-h}\n$$\n\nis a horizontal translation of the graph of $y=\\dfrac{1}{x}$ by $h$ units *right*.\n\nFor example, to plot the graph of \n\n$$\ny=\\dfrac{1}{x {\\color{blue} \\, - \\, 1}},\n$$\n\nwe translate the original curve horizontally by $\\color{blue}1$ unit *right*:\n\n![](images/d4/d4778ef277b11ab33eb01a650ad07c4fd2e3902f303dd2fb15ed81a4b54649a0.png)\n\nThe graph of \n\n$$\ny=\\dfrac{1}{x+h}\n$$\n\nis a horizontal translation of the graph of $y=\\dfrac{1}{x}$ by $h$ units *left*.\n\nFor example, to plot the graph of \n\n$$\ny=\\dfrac{1}{x{\\color{red} \\, + \\, 3}},\n$$\n\nwe translate the original curve by $\\color{red}3$ units *left*:\n\n![](images/87/87bbb7c00e10db814c9fc67786940cf5891d96496a2e85ed7ee2023bb1af8e3d.png)\n\n**Watch out!** Horizontal translations are always counter-intuitive. The translation $y=\\dfrac{1}{x-h}$ is to the right and the translation $y=\\dfrac{1}{x+h}$ is to the left, even though it seems like it should be the other way around.\n\nWith horizontal translations of the reciprocal function, the horizontal asymptote doesn't change, but the vertical asymptote is translated by the same number of units." :tutorial/id #uuid "02a5b0c7-2b66-5387-a512-fc34f2371da0" :tutorial/math-academy-id 3463 :tutorial/title "Horizontal Translations of a Reciprocal Curve"} :step/id #uuid "eb8634ab-c293-5d46-b057-a1e2064c7743" :step/math-academy-id 19597 :step/next {:db/id #edb/ref 17592186180368}} {:db/id #edb/ref 17592186180366 :step/content {:db/id #edb/ref 17592186180672 :tutorial/content "We can combine horizontal and vertical translations of reciprocal functions.\n\nIn general, the graph of \n\n$$\ny = \\dfrac{1}{x-h} + k\n$$\n\nis obtained from the graph of $y=\\dfrac{1}{x}$ by translating it\n\n- horizontally by $h$ units to the right, and\n\n- vertically by $k$ units up.\n\nThe same is true regarding translations of the negative reciprocal function. In general, the graph of\n\n$$\ny = -\\dfrac{1}{x-h} + k\n$$\n\nis obtained from the graph of $y=-\\dfrac{1}{x}$ by translating it\n\n- horizontally by $h$ units to the right, and\n\n- vertically by $k$ units up." :tutorial/id #uuid "a418bb7f-5146-523f-b21c-d3b1d2d1aa3c" :tutorial/math-academy-id 3465 :tutorial/title "Combining Horizontal and Vertical Translations"} :step/id #uuid "b64d3fe7-bf20-54ae-8ec5-3e3537b62a40" :step/math-academy-id 19599 :step/next {:db/id #edb/ref 17592186180369}} {:db/id #edb/ref 17592186180367 :step/content {:db/id #edb/ref 17592186179656 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179511 :question/id #uuid "0c18caa2-840d-5911-ade5-63fd59752b64" :question/math-academy-id "e-5306"} :knowledge-point/id #uuid "7e14129e-c8c9-5c9b-8ad4-feb9d618dd6b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049313} {:db/id #edb/ref 17592186050647}] :knowledge-point/questions [{:db/id #edb/ref 17592186180094} {:db/id #edb/ref 17592186180097} {:db/id #edb/ref 17592186560999} {:db/id #edb/ref 17592186561034}] :knowledge-point/title "Graphing Vertical Translations of Reciprocal Functions"} :step/id #uuid "1886e869-3dac-5d58-87a0-374f861e3930" :step/math-academy-id 19611 :step/next {:db/id #edb/ref 17592186180365}} {:db/id #edb/ref 17592186180368 :step/content {:db/id #edb/ref 17592186179657 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179512 :question/id #uuid "8ab32d98-1888-5ef0-95c1-81233cb7f449" :question/math-academy-id "e-5307"} :knowledge-point/id #uuid "7bd87ed4-1b63-516e-9945-5de0c15e0c90" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048419}] :knowledge-point/questions [{:db/id #edb/ref 17592186180265} {:db/id #edb/ref 17592186180266} {:db/id #edb/ref 17592186561048}] :knowledge-point/title "Graphing Horizontal Translations of Reciprocal Functions"} :step/id #uuid "e213f8b6-ed0b-5850-bade-ae0621dbb5e7" :step/math-academy-id 19612 :step/next {:db/id #edb/ref 17592186180366}} {:db/id #edb/ref 17592186180369 :step/content {:db/id #edb/ref 17592186179658 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179513 :question/id #uuid "5aee1873-5503-54ab-bf91-71a0abaf91a5" :question/math-academy-id "e-5308"} :knowledge-point/id #uuid "be4ff1c6-496e-5b3d-886f-5b6d21719469" :knowledge-point/questions [{:db/id #edb/ref 17592186180104} {:db/id #edb/ref 17592186180109} {:db/id #edb/ref 17592186561019}] :knowledge-point/title "Combining Horizontal and Vertical Translations of Reciprocal Functions"} :step/id #uuid "b8c2a567-f4fc-54d4-9695-14458fe899fe" :step/math-academy-id 19613} {:db/id #edb/ref 17592186180370 :step/content {:db/id #edb/ref 17592186180673 :tutorial/content "We also know the graph of $y=-\\dfrac{1}{x},$ so we can plot vertical translations of this function as well.\n\nFor example, to plot the function \n\n$$\ny=-\\dfrac{1}{x} \\, {\\color{blue} \\, +\\, 1.5},\n$$\n\nwe translate the original curve *up* by $\\color{blue}1.5$ units:\n\n![](images/01/0189d3fe1630049f5b4c7b1c13b134cc77454008e51450db5bf8d85b2050eeb8.png)" :tutorial/id #uuid "cd85bb48-e6a6-5094-a85a-9f2fc9f0ac95" :tutorial/math-academy-id 3469 :tutorial/title "Vertical Translations of a Negative Reciprocal Curve"} :step/id #uuid "bb1b780c-22b7-56b9-98ce-88af12e62b74" :step/math-academy-id 19615 :step/next {:db/id #edb/ref 17592186180367}}] :activity/title "Graph Transformations of Reciprocal Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179883}]}
