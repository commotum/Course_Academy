b/ref 17592186045417] [17592186092461 #edb/ref 1043 #edb/ref 17592186093328 #edb/ref 17592186045417] [17592186092461 #edb/ref 1043 #edb/ref 17592186093329 #edb/ref 17592186045417] [17592186092461 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186092461 #edb/ref 1045 "Calculating the Equation of a Normal Line Using Differentiation" #edb/ref 17592186045417] [17592186092461 #edb/ref 1046 #edb/ref 17592186093327 #edb/ref 17592186045417] [17592186092461 #edb/ref 1049 #edb/ref 17592186049119 #edb/ref 17592186045417] [17592186092461 #edb/ref 1050 1140.0 #edb/ref 17592186045417] [17592186092461 #edb/ref 1050 1140.0 #edb/ref 17592186045436] [17592186092461 #edb/ref 1053 #uuid "bfd96d16-131a-5887-9f3c-822479cc8e6b" #edb/ref 17592186045417] [17592186093087 #edb/ref 1058 #edb/ref 17592186093329 #edb/ref 17592186045417] [17592186093087 #edb/ref 1061 22383 #edb/ref 17592186045417] [17592186093087 #edb/ref 1062 #uuid "978ac109-c615-5055-9e0a-f164ca3a1990" #edb/ref 17592186045417] [17592186093087 #edb/ref 1063 #edb/ref 17592186092240 #edb/ref 17592186045417] [17592186093327 #edb/ref 1058 #edb/ref 17592186093328 #edb/ref 17592186045417] [17592186093327 #edb/ref 1061 667 #edb/ref 17592186045417] [17592186093327 #edb/ref 1062 #uuid "5a4d7867-7ef2-52ad-93ae-c3ea0c556954" #edb/ref 17592186045417] [17592186093327 #edb/ref 1063 #edb/ref 17592186093442 #edb/ref 17592186045417] [17592186093328 #edb/ref 1058 #edb/ref 17592186093087 #edb/ref 17592186045417] [17592186093328 #edb/ref 1061 668 #edb/ref 17592186045417] [17592186093328 #edb/ref 1062 #uuid "ee29e21c-ec79-5cef-8080-e39f4ded4176" #edb/ref 17592186045417] [17592186093328 #edb/ref 1063 #edb/ref 17592186092384 #edb/ref 17592186045417] [17592186093329 #edb/ref 1061 671 #edb/ref 17592186045417] [17592186093329 #edb/ref 1062 #uuid "434b8ac4-0cfe-5365-987b-8d6de7b04e04" #edb/ref 17592186045417] [17592186093329 #edb/ref 1063 #edb/ref 17592186092385 #edb/ref 17592186045417] [17592186093442 #edb/ref 1064 "The equation of the normal line to the curve $y = f(x)$ at the point $P(x_1,y_1),$ in point-slope form, is given by\n\n$$\ny - y_1 = m (x - x_1), \\hspace{1cm} m=-\\dfrac{1}{f'(x_1)}.\n$$\n\nHere, $m=-\\dfrac{1}{f'(x_1)}$ because the slope of the normal line is the negative reciprocal of the slope of the tangent line, and $f'(x_1)$ represents the slope of the tangent line to $y=f(x)$ at the point $(x_1,y_1).$\n\nFor example, suppose we want to compute the equation of the normal line to the curve $y=x^2$ at the point $A(1,1).$ This normal line is the dashed line shown below, which is perpendicular to the solid tangent line. \n\n![](images/31/31ba09ff14e5bd485794f283c5d6a5b087b6c21fdb9242af01b75ec8e8744e0d.png)\n\nSince $y=x^2,$ we have $f(x)=x^2.$ We begin by calculating the derivative of $f(x)\\mathbin{:}$\n\n$$\nf'(x) \t\t = \\dfrac {\\textrm{d}}{\\textrm{d}x}(x^2)= 2x\n$$\n\nAt $A(1,1),$ the slope of the tangent line is given by\n\n$$\nf'(1) \t= 2(1) = 2.\n$$\n\nHowever, we want the normal line, and the slope of the normal line is the negative reciprocal of the slope of the tangent line:\n\n$$\nm = -\\dfrac{1}{f'(1)} = -\\dfrac{1}{2}\n$$\n\n \n\nFinally, we work out the equation of the normal line using the point-slope form:\n\n$$\n\\begin{aligned}y-1 & =-\\frac{1}{2}(x-1) \\\\ y & =-\\frac{x}{2}+\\frac{1}{2}+1 \\\\ y & =-\\frac{x}{2}+\\frac{3}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the normal line is $y=-\\dfrac x 2 + \\dfrac 3 2.$ We could also write this in standard form as $x+2y=3.$" #edb/ref 17592186045417] [17592186093442 #edb/ref 1065 359 #edb/ref 17592186045417] [17592186093442 #edb/ref 1066 #uuid "c50c999b-ac30-5116-acbd-795f13cc2b3d" #edb/ref 17592186045417] [17592186093442 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186233120 #edb/ref 1069 "q-10878" #edb/ref 17592186045417] [17592186233120 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186233120 #edb/ref 1071 "Find where the normal line to the curve $y={x}^{2}$ at the point $(3,9)$ intersects the $x$-axis." #edb/ref 17592186045417] [17592186233120 #edb/ref 1072 #uuid "73d11496-6181-52ca-9d4d-b27d18c44afc" #edb/ref 17592186045417] [17592186233120 #edb/ref 1074 "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{'}(x)=\\frac{\\text{d}}{\\text{d}x}({x}^{2})=2x.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm={f}^{'}(3)=2(3)=6,\n$$\n\nand therefore the slope of the normal line is\n\n$$\n{m}^{'}=-\\frac{1}{m}=-\\frac{1}{6}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-9 & =-\\frac{1}{6}(x-3) \\\\ y & =-\\frac{1}{6}x+\\frac{1}{2}+9 \\\\ y & =-\\frac{1}{6}x+\\frac{19}{2}.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}-\\frac{1}{6}x+\\frac{19}{2} & =0 \\\\ \\frac{19}{2} & =\\frac{1}{6}x \\\\ x & =57.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $x$-axis at $(57,0).$" #edb/ref 17592186045417] [17592186244498 #edb/ref 1080 "(0,1)" #edb/ref 17592186045417] [17592186244498 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186244498 #edb/ref 1083 #uuid "142b6536-fed4-529f-ac1d-8a42fc666730" #edb/ref 17592186045417] [17592186245208 #edb/ref 1080 "(0,2)" #edb/ref 17592186045417] [17592186245208 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186245208 #edb/ref 1083 #uuid "65112d5b-e5af-58b2-8b42-2fafe84f3bf1" #edb/ref 17592186045417] [17592186245289 #edb/ref 1080 "(0,\\frac{5}{2})" #edb/ref 17592186045417] [17592186245289 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186245289 #edb/ref 1083 #uuid "6e29c4b1-5a97-5a97-bbf2-51eabed39e9c" #edb/ref 17592186045417] [17592186246111 #edb/ref 1080 "(0,\\frac{1}{2})" #edb/ref 17592186045417] [17592186246111 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186246111 #edb/ref 1083 #uuid "ca93f7a3-eace-5053-ae98-706828a1b4af" #edb/ref 1