#{[{:activity/expected-seconds 1140.0 :activity/first-step {:db/id #edb/ref 17592186093327} :activity/id #uuid "bfd96d16-131a-5887-9f3c-822479cc8e6b" :activity/scope {:db/id #edb/ref 17592186049119 :topic/id #uuid "dc19c9ce-6319-5943-8842-352e3c3735c7" :topic/math-academy-id 987} :activity/steps [{:db/id #edb/ref 17592186093087 :step/content {:db/id #edb/ref 17592186092240 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092083 :question/id #uuid "e405bf60-d500-55df-90be-a938dc9dfc93" :question/math-academy-id "e-6080"} :knowledge-point/id #uuid "55a323ba-f2a7-5a49-abd4-a9812518ef8c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050635}] :knowledge-point/question-generator {:db/id #edb/ref 17592186493326} :knowledge-point/questions [{:db/id #edb/ref 17592186092722} {:db/id #edb/ref 17592186092724} {:db/id #edb/ref 17592186233912} {:db/id #edb/ref 17592186233927} {:db/id #edb/ref 17592186234077} {:db/id #edb/ref 17592186235432} {:db/id #edb/ref 17592186235480} {:db/id #edb/ref 17592186238020} {:db/id #edb/ref 17592186315036} {:db/id #edb/ref 17592186317211} {:db/id #edb/ref 17592186317212} {:db/id #edb/ref 17592186317214} {:db/id #edb/ref 17592186329814} {:db/id #edb/ref 17592186392582} {:db/id #edb/ref 17592186514424} {:db/id #edb/ref 17592186523970} {:db/id #edb/ref 17592186547057}] :knowledge-point/title "Determining the Equation of a Normal Line to a Curve at a Point"} :step/id #uuid "978ac109-c615-5055-9e0a-f164ca3a1990" :step/math-academy-id 22383 :step/next {:db/id #edb/ref 17592186093329}} {:db/id #edb/ref 17592186093327 :step/content {:db/id #edb/ref 17592186093442 :tutorial/content "The equation of the normal line to the curve $y = f(x)$ at the point $P(x_1,y_1),$ in point-slope form, is given by\n\n$$\ny - y_1 = m (x - x_1), \\hspace{1cm} m=-\\dfrac{1}{f'(x_1)}.\n$$\n\nHere, $m=-\\dfrac{1}{f'(x_1)}$ because the slope of the normal line is the negative reciprocal of the slope of the tangent line, and $f'(x_1)$ represents the slope of the tangent line to $y=f(x)$ at the point $(x_1,y_1).$\n\nFor example, suppose we want to compute the equation of the normal line to the curve $y=x^2$ at the point $A(1,1).$ This normal line is the dashed line shown below, which is perpendicular to the solid tangent line. \n\n![](images/31/31ba09ff14e5bd485794f283c5d6a5b087b6c21fdb9242af01b75ec8e8744e0d.png)\n\nSince $y=x^2,$ we have $f(x)=x^2.$ We begin by calculating the derivative of $f(x)\\mathbin{:}$\n\n$$\nf'(x) \t\t = \\dfrac {\\textrm{d}}{\\textrm{d}x}(x^2)= 2x\n$$\n\nAt $A(1,1),$ the slope of the tangent line is given by\n\n$$\nf'(1) \t= 2(1) = 2.\n$$\n\nHowever, we want the normal line, and the slope of the normal line is the negative reciprocal of the slope of the tangent line:\n\n$$\nm = -\\dfrac{1}{f'(1)} = -\\dfrac{1}{2}\n$$\n\n \n\nFinally, we work out the equation of the normal line using the point-slope form:\n\n$$\n\\begin{aligned}y-1 & =-\\frac{1}{2}(x-1) \\\\ y & =-\\frac{x}{2}+\\frac{1}{2}+1 \\\\ y & =-\\frac{x}{2}+\\frac{3}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the normal line is $y=-\\dfrac x 2 + \\dfrac 3 2.$ We could also write this in standard form as $x+2y=3.$" :tutorial/id #uuid "c50c999b-ac30-5116-acbd-795f13cc2b3d" :tutorial/math-academy-id 359 :tutorial/title "Introduction"} :step/id #uuid "5a4d7867-7ef2-52ad-93ae-c3ea0c556954" :step/math-academy-id 667 :step/next {:db/id #edb/ref 17592186093328}} {:db/id #edb/ref 17592186093328 :step/content {:db/id #edb/ref 17592186092384 :knowledge-point/canonical-example {:db/id #edb/ref 17592186091953 :question/id #uuid "4a734f55-ceac-587c-a831-fa8bed578a99" :question/math-academy-id "e-148"} :knowledge-point/id #uuid "4a05f6c0-98ab-5197-922e-8e8dff1d4302" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050473} {:db/id #edb/ref 17592186050711}] :knowledge-point/question-generator {:db/id #edb/ref 17592186480110} :knowledge-point/questions [{:db/id #edb/ref 17592186092723} {:db/id #edb/ref 17592186092725} {:db/id #edb/ref 17592186233770} {:db/id #edb/ref 17592186233924} {:db/id #edb/ref 17592186233925} {:db/id #edb/ref 17592186233926} {:db/id #edb/ref 17592186234307} {:db/id #edb/ref 17592186238012} {:db/id #edb/ref 17592186238013} {:db/id #edb/ref 17592186238019} {:db/id #edb/ref 17592186317210} {:db/id #edb/ref 17592186329815} {:db/id #edb/ref 17592186338957} {:db/id #edb/ref 17592186524012} {:db/id #edb/ref 17592186524021}] :knowledge-point/title "Calculating the Slope of a Normal Line to a Curve at a Point"} :step/id #uuid "ee29e21c-ec79-5cef-8080-e39f4ded4176" :step/math-academy-id 668 :step/next {:db/id #edb/ref 17592186093087}} {:db/id #edb/ref 17592186093329 :step/content {:db/id #edb/ref 17592186092385 :knowledge-point/canonical-example {:db/id #edb/ref 17592186091954 :question/id #uuid "df59a07a-922c-50b9-8c2c-22ed57ac2bda" :question/math-academy-id "e-149"} :knowledge-point/id #uuid "3ba61258-92a9-511e-891f-9e6adce2edb0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049394}] :knowledge-point/question-generator {:db/id #edb/ref 17592186493324} :knowledge-point/questions [{:db/id #edb/ref 17592186092507} {:db/id #edb/ref 17592186092510} {:db/id #edb/ref 17592186233120} {:db/id #edb/ref 17592186233928} {:db/id #edb/ref 17592186234308} {:db/id #edb/ref 17592186240795} {:db/id #edb/ref 17592186240796} {:db/id #edb/ref 17592186297306} {:db/id #edb/ref 17592186317215} {:db/id #edb/ref 17592186317216} {:db/id #edb/ref 17592186493316} {:db/id #edb/ref 17592186493318} {:db/id #edb/ref 17592186493321} {:db/id #edb/ref 17592186523994}] :knowledge-point/title "Determining the Intercepts of a Normal Line"} :step/id #uuid "434b8ac4-0cfe-5365-987b-8d6de7b04e04" :step/math-academy-id 671}] :activity/title "Calculating the Equation of a Normal Line Using Differentiation" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186092461}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186547100} :activity/id #uuid "fad01a8c-be82-5d4b-b516-bfef7fe94dc5" :activity/scope {:db/id #edb/ref 17592186049119 :topic/id #uuid "dc19c9ce-6319-5943-8842-352e3c3735c7" :topic/math-academy-id 987} :activity/steps [{:db/id #edb/ref 17592186547100 :step/content {:db/id #edb/ref 17592186092510 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "142b6536-fed4-529f-ac1d-8a42fc666730" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,1)" :db/id #edb/ref 17592186244498} {:answer/id #uuid "65112d5b-e5af-58b2-8b42-2fafe84f3bf1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,2)" :db/id #edb/ref 17592186245208} {:answer/id #uuid "6e29c4b1-5a97-5a97-bbf2-51eabed39e9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,\\frac{5}{2})" :db/id #edb/ref 17592186245289} {:answer/id #uuid "ca93f7a3-eace-5053-ae98-706828a1b4af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,\\frac{1}{2})" :db/id #edb/ref 17592186246111} {:answer/id #uuid "d23fbfd4-1cbd-54d1-aa24-886860426aba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,3)" :db/id #edb/ref 17592186246184}] :answer-field/correct {:db/id #edb/ref 17592186246184} :answer-field/id #uuid "816b14ca-c9ce-5b90-8b9c-06306f5bacc2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246773}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "24c7ef87-44ff-5aaa-8c80-717e24087d16" :question/math-academy-id "q-11124" :question/problem "Find where the normal line to the curve $f(x)=2\\sqrt{x}$ at the point $(1,2)$ intersects the $y$-axis." :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2\\sqrt{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{1/2}) \\\\  & ={x}^{-1/2} \\\\  & =\\frac{1}{\\sqrt{x}}.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm={f}^{′}(1)=\\frac{1}{\\sqrt{1}}=1,\n$$\n\nand therefore the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-1.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-2 & =-1(x-1) \\\\ y & =-x+1+2 \\\\ y & =-x+3.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $y$-axis by setting $x=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}y & =-0+3 \\\\ y & =3.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $y$-axis at  $(0,3).$"} :step/id #uuid "273eb5b8-c26e-526c-b817-5fd744a9c5cc" :step/next {:db/id #edb/ref 17592186547118}} {:db/id #edb/ref 17592186547118 :step/content {:db/id #edb/ref 17592186092722 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3826d54-f39e-5e45-982c-0196c96b30c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "77" :db/id #edb/ref 17592186090533} {:answer/id #uuid "bf822091-623a-5b75-a700-06562c3fa7b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "74" :db/id #edb/ref 17592186090534} {:answer/id #uuid "c014a862-aa95-5ee5-8cc4-90a1115cf633" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "66" :db/id #edb/ref 17592186090535} {:answer/id #uuid "e535f72e-5b43-5878-a978-9a20e1d8470d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "56" :db/id #edb/ref 17592186090536} {:answer/id #uuid "48a27df3-0a04-52a4-9003-fd2c61c07e74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "58" :db/id #edb/ref 17592186090537}] :answer-field/correct {:db/id #edb/ref 17592186090534} :answer-field/id #uuid "7907bce1-6e91-548c-bf8c-f50341390d5a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186090532}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2a649b33-83ae-5424-9852-7d09d082fffc" :question/math-academy-id "q-47406" :question/problem "The equation of the normal line to the curve $y=2{x}^{2}$ at the point $(2,8)$ is given by $x+py=q$ where $p$ and $q$ are constants. Find the value of $p+q.$" :question/worked-solution "Let $f(x)=2{x}^{2}.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2})=4x\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(2,8):$\n\n$$\n\\begin{aligned}m={f}^{′}(2)=4(2)=8\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{8}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-8 & =-\\frac{1}{8}(x-2) \\\\ 8y-64 & =-x+2 \\\\ x+8y & =66.\\end{aligned}\n$$\n\nTherefore, $p+q=8+66=74.$"} :step/id #uuid "6d424a59-d0d5-5dc4-afe5-f773d34fca45" :step/next {:db/id #edb/ref 17592186547159}} {:db/id #edb/ref 17592186547159 :step/content {:db/id #edb/ref 17592186547057 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e827c707-4183-5bda-8490-ae6373ae9ace" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186546771}] :answer-field/correct {:db/id #edb/ref 17592186546771} :answer-field/id #uuid "aa428138-3fdd-52e3-90d7-e57b79a7836a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186546911} {:answer-field/choices [{:answer/id #uuid "85168c9f-eca2-5f20-86c3-38ab8f99e07f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-13" :db/id #edb/ref 17592186546543}] :answer-field/correct {:db/id #edb/ref 17592186546543} :answer-field/id #uuid "e1fb6fa9-d25d-5930-b90b-ff3334996e24" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186546939}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d27eb9e3-1a36-5293-b88b-ba67a6d55870" :question/math-academy-id "q-342187" :question/problem "Find the equation of the normal line to the curve $y=4x-\\frac{2}{x}$ at the point $(-1,-2).$\n\n$x\\,+$\n{{field-1}}$\\cdot \\,y\\,=$\n{{field-2}}" :question/worked-solution "Let $f(x)=4x-\\frac{2}{x}.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4x-\\frac{2}{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4x-2{x}^{-1}) \\\\  & =4+2{x}^{-2} \\\\  & =4+\\frac{2}{{x}^{2}}\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(-1,-2):$\n\n$$\nm={f}^{′}(-1)=4+\\frac{2}{(-1)^{2}}=4+2=6\n$$\n\nTherefore, the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{6}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-(-2) & =-\\frac{1}{6}[x-(-1)] \\\\ -6(y+2) & =x+1 \\\\ -6y-12 & =x+1 \\\\ x+6\\cdot y & =-13.\\end{aligned}\n$$"} :step/id #uuid "dfa4a8d0-084b-5540-8862-0031ccbeff76"}] :activity/title "Calculating the Equation of a Normal Line Using Differentiation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186546252}]}
