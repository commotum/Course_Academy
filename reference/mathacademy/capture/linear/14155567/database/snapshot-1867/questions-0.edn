#{[{:db/id #edb/ref 17592186179507 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179808 :knowledge-point/id #uuid "d7450aff-4876-5522-b0d6-8abb41b45799" :knowledge-point/title "Simplifying Expressions Containing Square Root Surds"}] :question/id #uuid "6466c715-1d9f-5a22-8eb5-2f319213c984" :question/math-academy-id "e-4620" :question/problem "Find the value of $\\sqrt{5} \\cdot \\sqrt{5}$." :question/worked-solution "First, we rewrite the expression as a square:\n\n$$\n\\sqrt{5} \\cdot \\sqrt{5} = \\left(\\sqrt{5}\\right)^2\n$$\n\nNow, recall that the square and the square root cancel each other out. So, we have\n\n$$\n\\left(\\sqrt{5}\\right)^2 = 5.\n$$"}] [{:db/id #edb/ref 17592186179508 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179809 :knowledge-point/id #uuid "45b856ca-5470-539c-992d-224d6f4da5de" :knowledge-point/title "Simplifying Expressions Containing Cube Root Surds"}] :question/id #uuid "26c11357-893b-5921-a9ea-d3db80d36de0" :question/math-academy-id "e-4621" :question/problem "Find $\\sqrt[3]{12} \\cdot \\sqrt{3} \\cdot \\sqrt[3]{12} \\cdot \\sqrt{3} \\cdot \\sqrt[3]{12}.$" :question/worked-solution "Grouping up the square roots and the cube roots, we find\n\n$$\n\\begin{aligned}\\sqrt[3]{12}\\cdot \\sqrt{3}\\cdot \\sqrt[3]{12}\\cdot \\sqrt{3}\\cdot \\sqrt[3]{12} & = \\\\ (\\sqrt[3]{12}\\cdot \\sqrt[3]{12}\\cdot \\sqrt[3]{12})(\\sqrt{3}\\cdot \\sqrt{3}) & = \\\\ {(\\sqrt[3]{12})}^{3}{(\\sqrt{3})}^{2} & = \\\\ 12\\cdot 3 & = \\\\ 36 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186478382 :knowledge-point/_questions [{:db/id #edb/ref 17592186179809 :knowledge-point/id #uuid "45b856ca-5470-539c-992d-224d6f4da5de" :knowledge-point/title "Simplifying Expressions Containing Cube Root Surds"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "805c3fae-b4ea-5501-aafe-149f2da5f17a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\text{ }048" :db/id #edb/ref 175921864