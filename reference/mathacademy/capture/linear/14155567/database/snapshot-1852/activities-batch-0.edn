#{[{:activity/first-step {:db/id #edb/ref 17592186180620} :activity/id #uuid "5548d9d0-335e-5dab-afd6-a236e37418d5" :activity/scope {:db/id #edb/ref 17592186050015 :topic/id #uuid "261efe96-a502-51d4-a6f4-1beb366e5efe" :topic/math-academy-id 3709} :activity/steps [{:db/id #edb/ref 17592186180620 :step/content {:db/id #edb/ref 17592186180668 :tutorial/content "We can simplify the product of two square roots, such as $\\sqrt{3}\\cdot \\sqrt{3}$.\nFirst, we re-write the expression as a square:\n\n$$\n\\sqrt{3} \\cdot \\sqrt{3} = \\left(\\sqrt{3}\\right)^2\n$$\n\nNow, recall that the square and the square root cancel each other out. So, we have\n\n$$\n\\left(\\sqrt{3}\\right)^2 = 3\n$$\n\nWe can do something similar for a product of three cube roots, like $\\sqrt[3]{3}\\cdot \\sqrt[3]{3}\\cdot \\sqrt[3]{3}$.\nFirst, we rewrite the expression as a cube:\n\n$$\n\\sqrt[3]{3}\\cdot \\sqrt[3]{3}\\cdot \\sqrt[3]{3} = \\left(\\sqrt[3]{3}\\right)^3\n$$\n\nNow, recall that the cube and the cube root cancel each other out. So, we have\n\n$$\n\\left(\\sqrt[3]{3}\\right)^3 = 3\n$$" :tutorial/id #uuid "237a4f95-3604-56a2-8809-03b4d40f35d4" :tutorial/math-academy-id 3100 :tutorial/title "Introduction"} :step/id #uuid "72c8ed91-9fb7-5d29-a50e-eaf59de22272" :step/math-academy-id 62339 :step/next {:db/id #edb/ref 17592186180621}} {:db/id #edb/ref 17592186180621 :step/content {:db/id #edb/ref 17592186179808 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179507 :question/id #uuid "6466c715-1d9f-5a22-8eb5-2f319213c984" :question/math-academy-id "e-4620"} :knowledge-point/id #uuid "d7450aff-4876-5522-b0d6-8abb41b45799" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050204} {:db/id #edb/ref 17592186050404}] :knowledge-point/questions [{:db/id #edb/ref 17592186180192} {:db/id #edb/ref 17592186180196}] :knowledge-point/title "Simplifying Expressions Containing Square Root Surds"} :step/id #uuid "824c9688-1516-55a2-af62-bf4fc82a884b" :step/math-academy-id 62340 :step/next {:db/id #edb/ref 17592186180622}} {:db/id #edb/ref 17592186180622 :step/content {:db/id #edb/ref 17592186179809 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179508 :question/id #uuid "26c11357-893b-5921-a9ea-d3db80d36de0" :question/math-academy-id "e-4621"} :knowledge-point/id #uuid "45b856ca-5470-539c-992d-224d6f4da5de" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048770}] :knowledge-point/questions [{:db/id #edb/ref 17592186180197} {:db/id #edb/ref 17592186180198}] :knowledge-point/title "Simplifying Expressions Containing Cube Root Surds"} :step/id #uuid "2c6ef7dd-08af-5926-982f-7fef0db63de0" :step/math-academy-id 62343}] :activity/title "Simplifying Expressions With Surds" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179862}]}
