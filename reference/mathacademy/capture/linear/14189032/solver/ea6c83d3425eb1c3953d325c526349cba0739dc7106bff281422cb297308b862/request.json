      {
        "question_id": "q-134224",
        "problem": "Maria, Esther, and Albert each bought $1$ pound of canary seed and $3$ pounds of sunflower seeds. In total, they bought\n\n                            \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        \n pounds of seeds.",
        "status": "ambiguous",
        "answers": [
