tion/answer-fields "answer-field-695816b9-028c-5cdf-b7e1-17fd412268d1"] [17592186133735 :knowledge-point/questions "question-b06c7090-b9ea-594c-b431-3fe9296b347e"] ["question-3cfc1cc8-75ac-58cb-baba-115d9b2db8af" :question/id #uuid "3cfc1cc8-75ac-58cb-baba-115d9b2db8af"] ["question-3cfc1cc8-75ac-58cb-baba-115d9b2db8af" :question/math-academy-id "q-185181"] ["question-3cfc1cc8-75ac-58cb-baba-115d9b2db8af" :question/problem "Expressed as an improper fraction or mixed number, ${(-\\frac{8}{5})}^{2}=${{field-1}}."] ["question-3cfc1cc8-75ac-58cb-baba-115d9b2db8af" :question/worked-solution "To work out ${(-\\frac{8}{5})}^{2},$ we multiply $-\\frac{8}{5}$ by itself:\n\n$$\n\\begin{aligned}{(-\\frac{8}{5})}^{2} & = \\\\ (-\\frac{8}{5})\\cdot (-\\frac{8}{5}) & = \\\\ \\frac{8\\cdot 8}{5\\cdot 5} & = \\\\ \\frac{64}{25} & \\end{aligned}\n$$"] ["question-3cfc1cc8-75ac-58cb-baba-115d9b2db8af" :question/difficulty :question.difficulty/hard] ["answer-field-dfa2a1c0-d3ce-5d21-872c-ede324a37869" :answer-field/id #uuid "dfa2a1c0-d3ce-5d21-872c-ede324a37869"] ["answer-cb37b488-9bf2-5a55-9b98-ff72718291b6" :answer/id #uuid "cb37b488-9bf2-5a55-9b98-ff72718291b6"] ["answer-cb37b488-9bf2-5a55-9b98-ff72718291b6" :answer/type :answer.type/math] ["answer-cb37b488-9bf2-5a55-9b98-ff72718291b6" :answer/value "\\frac{64}{25}"] ["answer-field-dfa2a1c0-d3ce-5d21-872c-ede324a37869" :answer-field/key "field-1"] ["answer-field-dfa2a1c0-d3ce-5d21-872c-ede324a37869" :answer-field/type :answer-field.type/blank] ["answer-field-dfa2a1c0-d3ce-5d21-872c-ede324a37869" :answer-field/correct "answer-cb37b488-9bf2-5a55-9b98-ff72718291b6"] ["answer-field-dfa2a1c0-d3ce-5d21-872c-ede324a37869" :answer-field/choices "answer-cb37b488-9bf2-5a55-9b98-ff72718291b6"] ["question-3cfc1cc8-75ac-58cb-baba-115d9b2db8af" :question/answer-fields "answer-field-dfa2a1c0-d3ce-5d21-872c-ede324a37869"] [17592186133736 :knowledge-point/questions "question-3cfc1cc8-75ac-58cb-baba-115d9b2db8af"] ["question-056f7c20-573d-55c9-bb54-7bee0a1479fd" :question/id #uuid "056f7c20-573d-55c9-bb54-7bee0a1479fd"] ["question-056f7c20-573d-55c9-bb54-7bee0a1479fd" :question/math-academy-id "q-185189"] ["question-056f7c20-573d-55c9-bb54-7bee0a1479fd" :question/problem "Expressed as an improper fraction or mixed number, ${(\\frac{5}{3})}^{2}=${{field-1}}."] ["question-056f7c20-573d-55c9-bb54-7bee0a1479fd" :question/worked-solution "To work out ${(\\frac{5}{3})}^{2},$ we multiply $\\frac{5}{3}$ by itself:\n\n$$\n{(\\frac{5}{3})}^{2}=\\frac{5}{3}\\cdot \\frac{5}{3}=\\frac{25}{9}\n$$"] ["question-056f7c20-573d-55c9-bb54-7bee0a1479fd" :question/difficulty :question.difficulty/moderate] ["answer-field-6d582431-5271-591c-a589-e2a2aea28272" :answer-field/id #uuid "6d582431-5271-591c-a589-e2a2aea28272"] ["answer-540b5a5a-5141-58c1-9bbe-df63004cb07d" :answer/id #uuid "540b5a5a-5141-58c1-9bbe-df63004cb07d"] ["answer-540b5a5a-5141-58c1-9bbe-df63004cb07d" :answer/type :answer.type/math] ["answer-540b5a5a-5141-58c1-9bbe-df63004cb07d" :answer/value "\\frac{25}{9}"] ["answer-field-6d582431-5271-591c-a589-e2a2aea28272" :answer-field/key "field-1"] ["answer-field-6d582431-5271-591c-a589-e2a2aea28272" :answer-field/type :answer-field.type/blank] ["answer-field-6d582431-5271-591c-a589-e2a2aea28272" :answer-field/correct "answer-540b5a5a-5141-58c1-9bbe-df63004cb07d"] ["answer-field-6d582431-5271-591c-a589-e2a2aea28272" :answer-field/choices "answer-540b5a5a-5141-58c1-9bbe-df63004cb07d"] ["question-056f7c20-573d-55c9-bb54-7bee0a1479fd" :question/answer-fields "answer-field-6d582431-5271-591c-a589-e2a2aea28272"] [17592186133735 :knowledge-point/questions "question-056f7c20-573d-55c9-bb54-7bee0a1479fd"] ["question-9362856b-6dfd-5551-b35f-afef6a56607c" :question/id #uuid "9362856b-6dfd-5551-b35f-afef6a56607c"] ["question-9362856b-6dfd-5551-b35f-afef6a56607c" :question/math-academy-id "q-185205"] ["question-9362856b-6dfd-5551-b35f-afef6a56607c" :question/problem "Expressed as a decimal in its simplest form, $(-4.5)^{2}=${{field-1}}."] ["question-9362856b-6dfd-5551-b35f-afef6a56607c" :question/worked-solution "We need to calculate the product of $(-4.5)$ with itself:\n\n$$\n(-4.5)^{2}=(-4.5)\\cdot (-4.5)=(4.5)\\cdot (4.5)\n$$\n\nFirst, we ignore the decimal points and multiply as if both numbers were whole numbers:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{2} \\\\ \\boxed{2}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $45\\times 45=2\\,025.$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $1$ decimal place in the first factor ($4.5$) and $1$ decimal place in the second factor ($4.5$), so their product will have $1+1=2$ decimal places.\n\nWe take our value of $2\\,025$ and insert a decimal point to make a number with $2$ decimal places:\n\n$$\n20\\,\\overset{↓}{.}\\,\\,\\,{{25}_{⏟}}_{2\\text{ digits}}\n$$\n\nTherefore, $(-4.5)^{2}=20.25\\,.$"] ["question-9362856b-6dfd-5551-b35f-afef6a56607c" :question/difficulty :question.difficulty/hard] ["answer-field-80f35c7a-0c9b-50f3-b115-b30ce556b18b" :answer-field/id #uuid "80f35c7a-0c9b-50f3-b115-b30ce556b18b"] ["answer-f2c06f3e-ac54-53ac-853c-0a9d19f1a9ad" :answer/id #uuid "f2c06f3e-ac54-53ac-853c-0a9d19f1a9ad"] ["answer-f2c06f3e-ac54-53ac-853c-0a9d19f1a9ad" :answer/type :answer.type/math] ["answer-f2c06f3e-ac54-53ac-853c-0a9d19f1a9ad" :answer/value "20.25"] ["answer-field-80f35c7a-0c9b-