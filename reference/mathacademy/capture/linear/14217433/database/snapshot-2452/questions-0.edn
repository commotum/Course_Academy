#{[{:db/id #edb/ref 17592186527154 :knowledge-point/_questions [{:db/id #edb/ref 17592186133736 :knowledge-point/id #uuid "46e8fb12-e59a-5aba-a9e8-2f872a89b915" :knowledge-point/title "Squaring Negative Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb37b488-9bf2-5a55-9b98-ff72718291b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{64}{25}" :db/id #edb/ref 17592186526893}] :answer-field/correct {:answer/id #uuid "cb37b488-9bf2-5a55-9b98-ff72718291b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{64}{25}" :db/id #edb/ref 17592186526893} :answer-field/id #uuid "dfa2a1c0-d3ce-5d21-872c-ede324a37869" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186527107}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3cfc1cc8-75ac-58cb-baba-115d9b2db8af" :question/math-academy-id "q-185181" :question/problem "Expressed as an improper fraction or mixed number, ${(-\\frac{8}{5})}^{2}=${{field-1}}." :question/worked-solution "To work out ${(-\\frac{8}{5})}^{2},$ we multiply $-\\frac{8}{5}$ by itself:\n\n$$\n\\begin{aligned}{(-\\frac{8}{5})}^{2} & = \\\\ (-\\frac{8}{5})\\cdot (-\\frac{8}{5}) & = \\\\ \\frac{8\\cdot 8}{5\\cdot 5} & = \\\\ \\frac{64}{25} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186527125 :knowledge-point/_questions [{:db/id #edb/ref 17592186133735 :knowledge-point/id #uuid "eece577d-72b8-5a0d-89fd-1cfa63bf73fb" :knowledge-point/title "Squaring Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "540b5a5a-5141-58c1-9bbe-df63004cb07d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{9}" :db/id #edb/ref 17592186526674}] :answer-field/correct {:answer/id #uuid "540b5a5a-5141-58c1-9bbe-df63004cb07d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{9}" :db/id #edb/ref 17592186526674} :answer-field/id #uuid "6d582431-5271-591c-a589-e2a2aea28272" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186527065}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "056f7c20-573d-55c9-bb54-7bee0a1479fd" :question/math-academy-id "q-185189" :question/problem "Expressed as an improper fraction or mixed number, ${(\\frac{5}{3})}^{2}=${{field-1}}." :question/worked-solution "To work out ${(\\frac{5}{3})}^{2},$ we multiply $\\frac{5}{3}$ by itself:\n\n$$\n{(\\frac{5}{3})}^{2}=\\frac{5}{3}\\cdot \\frac{5}{3}=\\frac{25}{9}\n$$"}] [{:db/id #edb/ref 17592186527182 :knowledge-point/_questions [{:db/id #edb/ref 17592186133737 :knowledge-point/id #uuid "c28f4ffc-5168-5e71-9d77-ae313dd462ad" :knowledge-point/title "Calculating the Square of a Decimal"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2c06f3e-ac54-53ac-853c-0a9d19f1a9ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20.25" :db/id #edb/ref 17592186526982}] :answer-field/correct {:answer/id #uuid "f2c06f3e-ac54-53ac-853c-0a9d19f1a9ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20.25" :db/id #edb/ref 17592186526982} :answer-field/id #uuid "80f35c7a-0c9b-50f3-b115-b30ce556b18b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186527072}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9362856b-6dfd-5551-b35f-afef6a56607c" :question/math-academy-id "q-185205" :question/problem "Expressed as a decimal in its simplest form, $(-4.5)^{2}=${{field-1}}." :question/worked-solution "We need to calculate the product of $(-4.5)$ with itself:\n\n$$\n(-4.5)^{2}=(-4.5)\\cdot (-4.5)=(4.5)\\cdot (4.5)\n$$\n\nFirst, we ignore the decimal points and multiply as if both numbers were whole numbers:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{2} \\\\ \\boxed{2}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $45\\times 45=2\\,025.$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $1$ decimal place in the first factor ($4.5$) and $1$ decimal place in the second factor ($4.5$), so their product will have $1+1=2$ decimal places.\n\nWe take our value of $2\\,025$ and insert a decimal point to make a number with $2$ decimal places:\n\n$$\n20\\,\\overset{↓}{.}\\,\\,\\,{{25}_{⏟}}_{2\\text{ digits}}\n$$\n\nTherefore, $(-4.5)^{2}=20.25\\,.$"}] [{:db/id #edb/ref 17592186527179 :knowledge-point/_questions [{:db/id #edb/ref 17592186133737 :knowledge-point/id #uuid "c28f4ffc-5168-5e71-9d77-ae313dd462ad" :knowledge-point/title "Calculating the Square of a Decimal"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ff1f921-52e3-539a-b46b-8486b70c61bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49.29" :db/id #edb/ref 17592186526596} {:answer/id #uuid "4ef14f82-1314-55e0-aa7f-d6fa02048203" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "53" :db/id #edb/ref 17592186526663} {:answer/id #uuid "9ce61d4c-674e-501c-94f8-21794f4cd123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "53.9" :db/id #edb/ref 17592186526806} {:answer/id #uuid "dc6fe410-d7fb-5fa7-84e2-d245a133c254" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14.29" :db/id #edb/ref 17592186526931} {:answer/id #uuid "fe7b2309-a94f-5c47-83f4-fd09d8bb04d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "53.29" :db/id #edb/ref 17592186527009}] :answer-field/correct {:answer/id #uuid "fe7b2309-a94f-5c47-83f4-fd09d8bb04d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "53.29" :db/id #edb/ref 17592186527009} :answer-field/id #uuid "5b277ddb-c4ed-5fd4-b2dc-c14fccceaffe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186527056}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8c77c325-2e41-51df-821c-943abffd054d" :question/math-academy-id "q-75520" :question/problem "${7.3}^{2}=$" :question/worked-solution "We need to calculate the product of $7.3$ with itself:\n\n$$\n{7.3}^{2}=(7.3)\\cdot (7.3)\n$$\n\nFirst, we ignore the decimal points and multiply as if both numbers were whole numbers:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{2} \\\\ \\boxed{}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $73\\times 73=5\\,329.$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $1$ decimal place in the first factor ($7.3$) and $1$ decimal place in the second factor ($7.3$), so their product will have $1+1=2$ decimal places.\n\nWe take our value of $5\\,329$ and insert a decimal point to make a number with $2$ decimal places:\n\n$$\n53\\,\\overset{↓}{.}\\,\\,\\,{{29}_{⏟}}_{2\\text{ digits}}\n$$\n\nTherefore, ${7.3}^{2}=53.29\\,.$"}] [{:db/id #edb/ref 17592186527199 :knowledge-point/_questions [{:db/id #edb/ref 17592186133735 :knowledge-point/id #uuid "eece577d-72b8-5a0d-89fd-1cfa63bf73fb" :knowledge-point/title "Squaring Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "274904f4-58f7-56e2-9b6d-31c1ae57ce78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{49}" :db/id #edb/ref 17592186526587} {:answer/id #uuid "6431f8e0-22c1-5a92-b706-ab325a5dfa0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{18}" :db/id #edb/ref 17592186526703} {:answer/id #uuid "8776b217-a7c6-5847-98f1-2b8609aea8cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{90}" :db/id #edb/ref 17592186526772} {:answer/id #uuid "a6f1ac2b-edcc-5f11-8220-b6a757312e57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186526822} {:answer/id #uuid "ffd5b701-3c55-5a13-9705-5e37e7b904b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{81}" :db/id #edb/ref 17592186527012}] :answer-field/correct {:answer/id #uuid "ffd5b701-3c55-5a13-9705-5e37e7b904b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{81}" :db/id #edb/ref 17592186527012} :answer-field/id #uuid "695816b9-028c-5cdf-b7e1-17fd412268d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186527061}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b06c7090-b9ea-594c-b431-3fe9296b347e" :question/math-academy-id "q-99437" :question/problem "${(\\frac{1}{9})}^{2}=$" :question/worked-solution "To work out \n${(\\frac{1}{9})}^{2},$\n we multiply \n$\\frac{1}{9}$\n by itself:\n\n$$\n{(\\frac{1}{9})}^{2}=\\frac{1}{9}\\cdot \\frac{1}{9}=\\frac{1}{81}\n$$"}]}
