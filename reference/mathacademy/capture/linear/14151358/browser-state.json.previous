              "value": "I only",
              "html": "I only"
            },
            {
              "option": "b",
              "dom_id": "questionWidget-choiceLetterCircle-53000-b",
              "type": "text",
              "value": "I and III only",
              "html": "I and III only"
            },
            {
              "option": "c",
              "dom_id": "questionWidget-choiceLetterCircle-53000-c",
              "type": "text",
              "value": "I, II, and III",
              "html": "I, II, and III"
            },
            {
              "option": "d",
              "dom_id": "questionWidget-choiceLetterCircle-53000-d",
              "type": "text",
              "value": "I and II only",
              "html": "I and II only\n\n"
            },
            {
              "option": "e",
              "dom_id": "questionWidget-choiceLetterCircle-53000-e",
              "type": "text",
              "value": "II only",
              "html": "II only"
            }
