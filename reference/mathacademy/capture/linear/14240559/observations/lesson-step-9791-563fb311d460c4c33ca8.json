  "html": "<div id=\"step-9791\" class=\"step\" style=\"display: block\" stepid=\"9791\" steptype=\"example\" contentid=\"3017\">\n            <div class=\"stepHeader\">\n                <div class=\"stepName\">\n                    Example: \n                    <a id=\"stepAnchor-9791\" class=\"stepAnchor\" style=\"font-weight: normal;\" name=\"step-5\">Counting the Number of Vertices of a Polyhedron</a> \n                </div>      \n                <div class=\"helpButton\" stepid=\"9791\">?</div>\n            </div>\n            \n            <div class=\"exampleQuestion\">\n                <p>How many vertices does the rectangular prism shown below have? </p>\n<p><br></p>\n<div id=\"graphic-96e9414f2571c87c3cd9aed9e8a945fd\" class=\"graphic\"><img src=\"/graphics/96e9414f2571c87c3cd9aed9e8a945fd\"></div>\n            </div>     \n\n            <div class=\"explanationHeader\">EXPLANATION</div>\n\n            <div class=\"exampleExplanation\">\n                <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                            float: