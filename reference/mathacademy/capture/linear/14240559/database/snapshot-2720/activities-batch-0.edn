#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186148634} :activity/id #uuid "d5d96805-07b5-520e-938a-7e557c88e809" :activity/scope {:db/id #edb/ref 17592186050220 :topic/id #uuid "373dc814-a47d-5ed6-afef-f1396ddaaa18" :topic/math-academy-id 2484} :activity/steps [{:db/id #edb/ref 17592186148634 :step/content {:db/id #edb/ref 17592186148730 :tutorial/content "The **faces** of a polyhedron are the polygonal sides that construct it. \n\nLet's consider the triangular prism below.\n\n![](images/4e/4e0550f18e27ad9326b5606f23b502ff6879d2149f5bac5e2fcc829506748f0b.png)\n\nOur triangular prism has $5$ faces:\n\n![](images/ca/cabe6f9d976ad0b577d8a12b22fda051a284416c284b88c90723bbbcbcd0f723.png)\n\nThe **vertices** of a polyhedron are its corners. Our triangular prism has $6$ vertices:\n\n![](images/15/153dffffba0e8e344f667d9b4aa0badbd8b6560bdf731b75b1a3efafd2c2a7cc.png)\n\nThe **edges** of a polyhedron are the straight line segments that connect its vertices. Our triangular prism has $9$ edges:\n\n![](images/b0/b001673f783be6e9cb45fe42375d460fbe5aa760843b02ad480b340641b5c3bc.png)" :tutorial/id #uuid "9a0867c3-217a-596d-8426-8bafb724cb53" :tutorial/math-academy-id 2335 :tutorial/title "Introduction"} :step/id #uuid "82aabb46-313a-5268-aa07-51f490d0308b" :step/math-academy-id 9789 :step/next {:db/id #edb/ref 17592186148635}} {:db/id #edb/ref 17592186148635 :step/content {:db/id #edb/ref 17592186147645 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147330 :question/id #uuid "dd8a337c-4d71-5ec3-8d50-a78280e3f907" :question/math-academy-id "e-3016"} :knowledge-point/id #uuid "55b4be72-5049-5a39-86c7-13dfea1793a1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048313}] :knowledge-point/questions [{:db/id #edb/ref 17592186147916} {:db/id #edb/ref 17592186147917} {:db/id #edb/ref 17592186538962} {:db/id #edb/ref 17592186538995} {:db/id #edb/ref 17592186539004} {:db/id #edb/ref 17592186539020} {:db/id #edb/ref 17592186539023