d893-9f54-54ed-aeda-32d2ad8dd333" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186446575} {:answer/id #uuid "81680c27-9217-546f-97f8-fc5d66aae181" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186446597} {:answer/id #uuid "88c4d714-07f1-5806-b454-0b9377675255" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186446598} {:answer/id #uuid "b54e7192-eeb9-57ee-97bf-b3d272c3bcb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186446603} {:answer/id #uuid "e201d14b-775b-52cd-9102-62bc6eeafef8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186446609}] :answer-field/correct {:answer/id #uuid "88c4d714-07f1-5806-b454-0b9377675255" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186446598} :answer-field/id #uuid "1e7c4932-12c2-55fd-b4a9-63d1a3d70eed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446614}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e7d87357-9dbd-5804-b609-79909ab26f10" :question/math-academy-id "q-152051" :question/problem "Simplify $\\sqrt{\\frac{1}{36}}.$" :question/worked-solution "Recall that if $a\\ge 0,$ then\n\n$$\n\\sqrt{{a}^{2}}=a.\n$$\n\nFirst, notice that $1$ and $36$ are both perfect squares, where\n\n$$\n1={1}^{2}.\n$$\n\nand\n\n$$\n36={6}^{2}.\n$$\n\nSo, to work out $\\sqrt{\\frac{1}{36}},$ we express $\\frac{1}{36}$ as a perfect square:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{1}{36}} & = \\\\ \\sqrt{\\frac{{1}^{2}}{{6}^{2}}} & = \\\\ \\sqrt{\\frac{1\\cdot 1}{6\\cdot 6}} & = \\\\ \\sqrt{\\frac{1}{6}\\cdot \\frac{1}{6}} & = \\\\ \\sqrt{{(\\frac{1}{6})}^{2}} & = \\\\ \\frac{1}{6} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186446632 :knowledge-point/_questions [{:db/id #edb/ref 17592186119976 :knowledge-point/id #uuid "dd5aec46-708e-5de8-ad56-ce0c2a711fe2" :knowledge-point/title "The Square Root of a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac55b45e-36cf-5ce5-a3a9-88ee734e0054" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186446601}] :answer-field/correct {:answer/id #uuid "ac55b45e-36cf-5ce5-a3a9-88ee734e0054" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186446601} :answer-field/id #uuid "a3ffaf66-88bf-5785-a4c3-fe54ed409050" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186446617}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ed622752-4bb3-5695-8b97-40b6d4099979" :question/math-academy-id "q-178662" :question/problem "Expressed as a fraction in its simplest form, $\\sqrt{\\frac{4}{25}}=${{field-1}}." :question/worked-solution "Recall that if $a\\ge 0,$ then\n\n$$\n\\sqrt{{a}^{2}}=a.\n$$\n\nFirst, notice that $4$ and $25$ are both perfect squares, where\n\n$$\n4={2}^{2},\n$$\n\nand\n\n$$\n25={5}^{2}.\n$$\n\nSo, to work out $\\sqrt{\\frac{4}{25}},$ we express $\\frac{4}{25}$ as a perfect square:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{4}{25}} & = \\\\ \\sqrt{\\frac{{2}^{2}}{{5}^{2}}} & = \\\\ \\sqrt{\\frac{2\\cdot 2}{5\\cdot 5}} & = \\\\ \\sqrt{\\frac{2}{5}\\cdot \\frac{2}{5}} & = \\\\ \\sqrt{{(\\frac{2}{5})}^{2}} & = \\\\ \\frac{2}{5} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186446631 :knowledge-point/_questions [{:db/id #edb/ref 17592186119974 :knowledge-point/id #uuid "9d87cbd6-7c9b-5f31-871a-b21000755ef0" :knowledge-point/title "The Square Root of a Positive Number Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c6b38d7-3431-57dd-a93c-c863a35a7ad2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186446584}] :answer-field/correct {:answer/id #uuid "2c6b38d7-3431-57dd-a93c-c863a35a7ad2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186446584} :answer-field/id #uuid "cf380968-9ca2-5374-ab3b-465a10440279" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186446619}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ea5b88c7-6c7f-53c0-965d-0668d1eb1c86" :question/math-academy-id "q-178670" :question/problem "Expressed in its simplest form, $\\sqrt{{16}^{2}}=${{field-1}}." :question/worked-solution "Recall that if $a\\ge 0,$ then\n\n$$\n\\sqrt{{a}^{2}}=a.\n$$\n\nIn our case, since the number under the square root ($\\sqrt{}$) is already written as a square, we obtain the answer immediately:\n\n$$\n\\sqrt{{16}^{2}}=16\n$$"}] [{:db/id #edb/ref 17592186446629 :knowledge-point/_questions [{:db/id #edb/ref 17592186119974 :knowledge-point/id #uuid "9d87cbd6-7c9b-5f31-871a-b21000755ef0" :knowledge-point/title "The Square Root of a Positive Number Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ecba3cc-fbbf-5659-a952-96114df336c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "123" :db/id #edb/ref 17592186446577}] :answer-field/correct {:answer/id #uuid "0ecba3cc-fbbf-5659-a952-96114df336c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "123" :db/id #edb/ref 17592186446577} :answer-field/id #uuid "c71e49a6-b7c6-5a0a-82a5-79c0e3067c67" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186446618}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "aaa4309c-ee3c-55c4-881c-1b4771765495" :question/math-academy-id "q-178686" :question/problem "Expressed in its simplest form, $\\sqrt{{123}^{2}}=${{field-1}} ." :question/worked-solution "Recall that if $a\\ge 0,$ then\n\n$$\n\\sqrt{{a}^{2}}=a.\n$$\n\nIn our case, since the number under the square root ($\\sqrt{}$) is already written as a square, we obtain the answer immediately:\n\n$$\n\\sqrt{{123}^{2}}=123\n$$"}] [{:db/id #edb/ref 17592186446627 :knowledge-point/_questions [{:db/id #edb/ref 17592186119977 :knowledge-point/id #uuid "c1e3ad2c-3335-5bdd-b7ee-8abcfa4c6951" :knowledge-point/title "Determining Whether a Square Root Is a Real Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19f896b5-0443-5806-a212-3c4ec64dda15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186446579} {:answer/id #uuid "2860357a-766c-5155-bac9-fe5c53a16036" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186446581} {:answer/id #uuid "295dbb2e-fa5b-5515-bc1c-ba370caa1204" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186446582} {:answer/id #uuid "c1c4a777-1189-50a7-9afa-ab313f4b15d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186446604} {:answer/id #uuid "ed6e554a-cb47-5be3-bbf7-899c5382d6fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186446610}] :answer-field/correct {:answer/id #uuid "2860357a-766c-5155-bac9-fe5c53a16036" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186446581} :answer-field/id #uuid "2d41e236-c615-5466-ade7-c56e40316986" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446615}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "97407b65-a5d7-539f-9f4c-1c8b734462e0" :question/math-academy-id "q-43303" :question/problem "Which of the following square roots are real numbers?\n\nI. $\\sqrt{21}$\n\nII. $\\sqrt{-25}$\n\nIII. $\\sqrt{10.5}$" :question/worked-solution "The square root of a negative number is not a real number, while the square root of a non-negative number is a real number.\n\nLet's look at each square root in turn.\n\n- $\\sqrt{21}$ is the square root of $21,$ which is a non-negative number. So $\\sqrt{21}$ is a real number.\n\n- $\\sqrt{-25}$ is the square root of $-25,$ which is a negative number. So $\\sqrt{-25}$ is not a real number.\n\n- $\\sqrt{10.5}$ is the square root of $10.5,$ which is a non-negative number. So $\\sqrt{10.5}$ is a real number.\n\nSo, the correct answer is \"I and III only\"."}] [{:db/id #edb/ref 17592186446625 :knowledge-point/_questions [{:db/id #edb/ref 17592186119977 :knowledge-point/id #uuid "c1e3ad2c-3335-5bdd-b7ee-8abcfa4c6951" :knowledge-point/title "Determining Whether a Square Root Is a Real Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10de1a3d-25de-5c4c-9c57-e87d14ed0670" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186446578} {:answer/id #uuid "36453a05-f5a9-562a-8cd9-105e0d481ce7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186446587} {:answer/id #uuid "46e484e7-8e0a-5a6e-9861-4b9e54a0dc31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186446589} {:answer/id #uuid "c4b5f970-a438-5591-8e1c-aa152b157e72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186446605} {:answer/id #uuid "f81c6df6-ae70-5a90-a9c2-ac7020dab4b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186446611}] :answer-field/correct {:answer/id #uuid "f81c6df6-ae70-5a90-a9c2-ac7020dab4b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186446611} :answer-field/id #uuid "02dd8765-7c56-54dd-9b4d-1f9f91b54328" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446613}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5eb0d8b8-4879-5688-ac59-46c90d81a790" :question/math-academy-id "q-99131" :question/problem "Which of the following square roots are real numbers?\n\nI. $\\sqrt{-13}$\n\nII. $\\sqrt{29}$\n\nIII. $\\sqrt{-35}$" :question/worked-solution "The square root of a negative number is not a real number, while the square root of a non-negative number is a real number.\n\nLet's look at each square root in turn.\n\n- $\\sqrt{-13}$ is the square root of $-13,$ which is a negative number. So $\\sqrt{-13}$ is not a real number.\n\n- $\\sqrt{29}$ is the square root of $29,$ which is a non-negative number. So $\\sqrt{29}$ is a real number.\n\n- $\\sqrt{-35}$ is the square root of $-35,$ which is a negative number. So $\\sqrt{-35}$ is not a real number.\n\nSo, the correct answer is \"II only\"."}]}
