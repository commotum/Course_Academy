464Q343 527 309 573T212 619Q179 619 154 602T119 569T109 550Q109 549 114 549Q132 549 151 535T170 489Q170 464 154 447T109 429Z\"></path>\n<path stroke-width=\"1\" id=\"E3-MJMAIN-3D\" d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\"></path>\n<path stroke-width=\"1\" id=\"E3-MJMAIN-34\" d=\"M462 0Q444 3 333 3Q217 3 199 0H190V46H221Q241 46 248 46T265 48T279 53T286 61Q287 63 287 115V165H28V211L179 442Q332 674 334 675Q336 677 355 677H373L379 671V211H471V165H379V114Q379 73 379 66T385 54Q393 47 442 46H471V0H462ZM293 211V545L74 212L183 211H293Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E3-MJMAIN-31\"></use>\n <use xlink:href=\"#E3-MJMAIN-32\" x=\"500\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E3-MJMAIN-32\" x=\"1415\" y=\"557\"></use>\n <use xlink:href=\"#E3-MJMAIN-3D\" x=\"1732\" y=\"0\"></use>\n<g transform=\"translate(2788,0)\">\n <use xlink:href=\"#E3-MJMAIN-31\"></use>\n <use xlink:href=\"#E3-MJMAIN-34\" x=\"500\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-34\" x=\"1001\" y=\"0\"></use>\n</g>\n</g>\n</svg></span> are highlighted below.</p>\n<p><br></p>\n<table rules=\"all\" cellpadding=\"10\" align=\"center\" style=\"border:1px solid black; margin: auto; margin-top:4mm; margin-bottom:4mm\">\n\n<tbody><tr>\n<td width=\"20\" bgcolor=\"#D6EAF8\" style=\"text-align:center\"><b><span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.808ex\" height=\"1.509ex\" style=\"vertical-align: 0.019ex; margin-bottom: -0.19ex;\" viewBox=\"0 -576.1 778.5 649.8\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-4-Title\">\n<title id=\"MathJax-SVG-4-Title\">\\times</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E4-MJMAIN-D7\" d=\"M63