nswer-57c8a3b4-8173-5938-b698-2abfcad48518"] ["answer-field-700c44b0-518b-5383-9cc4-49a4e33ab23a" :answer-field/choices "answer-901f0f8f-ae86-5446-bb09-058c84094a71"] ["question-407ccba6-df92-5ced-bae5-a0584a2e9a9b" :question/answer-fields "answer-field-700c44b0-518b-5383-9cc4-49a4e33ab23a"] [17592186054736 :knowledge-point/questions "question-407ccba6-df92-5ced-bae5-a0584a2e9a9b"] ["question-e440f356-fb13-5144-832e-aba59bbee006" :question/id #uuid "e440f356-fb13-5144-832e-aba59bbee006"] ["question-e440f356-fb13-5144-832e-aba59bbee006" :question/math-academy-id "q-160280"] ["question-e440f356-fb13-5144-832e-aba59bbee006" :question/problem "What is the magnitude of the number $z=-9\\text{i}?$"] ["question-e440f356-fb13-5144-832e-aba59bbee006" :question/worked-solution "The imaginary number $-9\\text{i}$ is equivalent to the complex number $z=0-9\\text{i}.$\n\nWe know that for a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nSo, the magnitude of $z=0-9\\text{i}$ is given by\n\n$$\n\\begin{aligned}|z| & =\\sqrt{{a}^{2}+{b}^{2}} \\\\  & =\\sqrt{(0)^{2}+(-9)^{2}} \\\\  & =\\sqrt{81} \\\\  & =9.\\end{aligned}\n$$"] ["question-e440f356-fb13-5144-832e-aba59bbee006" :question/difficulty :question.difficulty/easy] ["answer-field-82433c6e-f90d-5505-9496-d2c147d30d79" :answer-field/id #uuid "82433c6e-f90d-5505-9496-d2c147d30d79"] ["answer-6fdb107c-f069-5a3f-b408-4442f17dca80" :answer/id #uuid "6fdb107c-f069-5a3f-b408-4442f17dca80"] ["answer-6fdb107c-f069-5a3f-b408-4442f17dca80" :answer/type :answer.type/math] ["answer-6fdb107c-f069-5a3f-b408-4442f17dca80" :answer/value "-3\\sqrt{3}"] ["answer-d488e77f-965b-5239-a2f4-9c5c6fd27700" :answer/id #uuid "d488e77f-965b-5239-a2f4-9c5c6fd27700"] ["answer-d488e77f-965b-5239-a2f4-9c5c6fd27700" :answer/type :answer.type/math] ["answer-d488e77f-965b-5239-a2f4-9c5c6fd27700" :answer/value "-9"] ["answer-fa74a01a-75f7-5f19-9147-121c4a1a9617" :answer/id #uuid "fa74a01a-75f7-5f19-9147-