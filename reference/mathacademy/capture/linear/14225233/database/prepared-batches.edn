[{"source" ":org/Math-Academy" "forms" [[:db/retract 17592186054315 :answer-field/choices 17592186054320] [:db/retract 17592186054315 :answer-field/choices 17592186054316] [:db/retract 17592186054315 :answer-field/choices 17592186054317] [:db/retract 17592186054315 :answer-field/choices 17592186054318] [:db/retract 17592186054315 :answer-field/choices 17592186054319] {:db/id 17592186055513 :question/problem "Find $|z|$ if $z=-c-d\\text{i},$ where $c$ and $d$ are real numbers." :question/worked-solution "For a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nFor the complex number $z=-c-d\\text{i},$ we have $a=-c$ and $b=-d.$ So, the magnitude is given by\n\n$$\n\\begin{aligned}\\begin{aligned}|-c-d\\text{i}| & =\\sqrt{(-c)^{2}+(-d)^{2}} \\\\  & =\\sqrt{{c}^{2}+{d}^{2}}.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186054315 :answer-field/correct "answer-15acad6a-1588-50dc-884b-0bc494d8457f" :answer-field/choices ["answer-b58e593b-db73-5134-8433-9704c2af763a" "answer-98affaef-6797-5eee-a74c-fa5d61288f53" "answer-15acad6a-1588-50dc-884b-0bc494d8457f" "answer-854035a8-ed0e-5bd3-9e72-e2d04380d94d" "answer-dd2ae299-d491-5962-8c63-b8d3103f30bd"] :db/ensure [:answer-field/validate]} {:db/id "answer-b58e593b-db73-5134-8433-9704c2af763a" :answer/id #uuid "b58e593b-db73-5134-8433-9704c2af763a" :answer/type :answer.type/math :answer/value "\\sqrt{c+d}" :db/ensure [:answer/validate]} {:db/id "answer-98affaef-6797-5eee-a74c-fa5d61288f53" :answer/id #uuid "98affaef-6797-5eee-a74c-fa5d61288f53" :answer/type :answer.type/math :answer/value "\\sqrt{c-d}" :db/ensure [:answer/validate]} {:db/id "answer-15acad6a-1588-50dc-884b-0bc494d8457f" :answer/id #uuid "15acad6a-1588-50dc-884b-0bc494d8457f" :answer/type :answer.type/math :answer/value "\\sqrt{{c}^{2}+{d}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-854035a8-ed0e-5bd3-9e72-e2d04380d94d" :answer/id #uuid "854035a8-ed0e-5bd3-9e72-e2d04380d94d" :answer/type :answer.type/math :answer/value "\\sqrt{{c}^{2}-{d}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-dd2ae299-d491-5962-8c63-b8d3103f30bd" :answer/id #uuid "dd2ae299-d491-5962-8c63-b8d3103f30bd" :answer/type :answer.type/math :answer/value "\\sqrt{{c}^{2}}\\sqrt{{d}^{2}}" :db/ensure [:answer/validate]} {:db/id 17592186054736 :knowledge-point/questions ["question-407ccba6-df92-5ced-bae5-a0584a2e9a9b" "question-e440f356-fb13-5144-832e-aba59bbee006"] :db/ensure [:knowledge-point/validate]} {:db/id "question-407ccba6-df92-5ced-bae5-a0584a2e9a9b" :question/id #uuid "407ccba6-df92-5ced-bae5-a0584a2e9a9b" :question/math-academy-id "q-70259" :question/problem "What is the magnitude of the number $z=3\\sqrt{2}\\,\\text{i}?$" :question/worked-solution "The imaginary number $3\\sqrt{2}\\,\\text{i}$ is equivalent to the complex number $z=0+3\\sqrt{2}\\,\\text{i}.$\n\nWe know that for a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nSo, the magnitude of $z=0+3\\sqrt{2}\\,\\text{i}$ is given by\n\n$$\n\\begin{aligned}|z| & =\\sqrt{{a}^{2}+{b}^{2}} \\\\  & =\\sqrt{(0)^{2}+(3\\sqrt{2})^{2}} \\\\  & =3\\sqrt{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-700c44b0-518b-5383-9cc4-49a4e33ab23a"] :db/ensure [:question/validate]} {:db/id "answer-field-700c44b0-518b-5383-9cc4-49a4e33ab23a" :answer-field/id #uuid "700c44b0-518b-5383-9cc4-49a4e33ab23a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-57c8a3b4-8173-5938-b698-2abfcad48518" :answer-field/choices ["answer-baa275e2-b6b5-5efe-92e8-68e43ce68a9f" "answer-20fcdb42-91ca-575f-b2d7-0e66f5434d4c" "answer-803a45f2-870d-54d9-83cb-ae54be25ca4f" "answer-57c8a3b4-8173-5938-b698-2abfcad48518" "answer-901f0f8f-ae86-5446-bb09-058c84094a71"] :db/ensure [:answer-field/validate]} {:db/id "answe