#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186544926} :activity/id #uuid "582cf0be-b649-5c80-ab83-11d8d6de800e" :activity/scope {:db/id #edb/ref 17592186049831 :topic/id #uuid "1726eb44-d776-5df6-8797-69b129ad3167" :topic/math-academy-id 34} :activity/steps [{:db/id #edb/ref 17592186544926 :step/content {:db/id #edb/ref 17592186055513 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15acad6a-1588-50dc-884b-0bc494d8457f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{{c}^{2}+{d}^{2}}" :db/id #edb/ref 17592186544132} {:answer/id #uuid "854035a8-ed0e-5bd3-9e72-e2d04380d94d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{{c}^{2}-{d}^{2}}" :db/id #edb/ref 17592186544375} {:answer/id #uuid "98affaef-6797-5eee-a74c-fa5d61288f53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{c-d}" :db/id #edb/ref 17592186544419} {:answer/id #uuid "b58e593b-db73-5134-8433-9704c2af763a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{c+d}" :db/id #edb/ref 17592186544470} {:answer/id #uuid "dd2ae299-d491-5962-8c63-b8d3103f30bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{{c}^{2}}\\sqrt{{d}^{2}}" :db/id #edb/ref 17592186544563}] :answer-field/correct {:db/id #edb/ref 17592186544132} :answer-field/id #uuid "3986505e-1ad4-514c-9a76-d29a84124f71" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186054315}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1234cf5e-bc44-54a6-aa08-551f55b5254e" :question/math-academy-id "q-904" :question/problem "Find $|z|$ if $z=-c-d\\text{i},$ where $c$ and $d$ are real numbers." :question/worked-solution "For a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nFor the complex number $z=-c-d\\text{i},$ we have $a=-c$ and $b=-d.$ So, the magnitude is given by\n\n$$\n\\begin{aligned}\\begin{aligned}|-c-d\\text{i}| & =\\sqrt{(-c)^{2}+(-d)^{2}} \\\\  & =\\sqrt{{c}^{2}+{d}^{2}}.\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "4e4d1882-3af3-542b-a0de-5d934be9d250" :step/next {:db/id #edb/ref 17592186544967}} {:db/id #edb/ref 17592186544967 :step/content {:db/id #edb/ref 17592186544810 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20fcdb42-91ca-575f-b2d7-0e66f5434d4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186544162} {:answer/id #uuid "57c8a3b4-8173-5938-b698-2abfcad48518" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186544281} {:answer/id #uuid "803a45f2-870d-54d9-83cb-ae54be25ca4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186544368} {:answer/id #uuid "901f0f8f-ae86-5446-bb09-058c84094a71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186544403} {:answer/id #uuid "baa275e2-b6b5-5efe-92e8-68e43ce68a9f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\sqrt{2}" :db/id #edb/ref 17592186544485}] :answer-field/correct {:db/id #edb/ref 17592186544281} :answer-field/id #uuid "700c44b0-518b-5383-9cc4-49a4e33ab23a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544705}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "407ccba6-df92-5ced-bae5-a0584a2e9a9b" :question/math-academy-id "q-70259" :question/problem "What is the magnitude of the number $z=3\\sqrt{2}\\,\\text{i}?$" :question/worked-solution "The imaginary number $3\\sqrt{2}\\,\\text{i}$ is equivalent to the complex number $z=0+3\\sqrt{2}\\,\\text{i}.$\n\nWe know that for a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nSo, the magnitude of $z=0+3\\sqrt{2}\\,\\text{i}$ is given by\n\n$$\n\\begin{aligned}|z| & =\\sqrt{{a}^{2}+{b}^{2}} \\\\  & =\\sqrt{(0)^{2}+(3\\sqrt{2})^{2}} \\\\  & =3\\sqrt{2}.\\end{aligned}\n$$"} :step/id #uuid "bf91d901-c429-5294-8b90-ff69ad18fb15" :step/next {:db/id #edb/ref 17592186544971}} {:db/id #edb/ref 17592186544971 :step/content {:db/id #edb/ref 17592186544890 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "297edda3-9036-5d3f-841d-95794066b68e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186544182} {:answer/id #uuid "6fdb107c-f069-5a3f-b408-4442f17dca80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\sqrt{3}" :db/id #edb/ref 17592186544336} {:answer/id #uuid "d488e77f-965b-5239-a2f4-9c5c6fd27700" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186544539} {:answer/id #uuid "f69636d0-b0c4-52be-8443-48117c693451" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186544625} {:answer/id #uuid "fa74a01a-75f7-5f19-9147-121c4a1a9617" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186544633}] :answer-field/correct {:db/id #edb/ref 17592186544182} :answer-field/id #uuid "82433c6e-f90d-5505-9496-d2c147d30d79" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544712}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e440f356-fb13-5144-832e-aba59bbee006" :question/math-academy-id "q-160280" :question/problem "What is the magnitude of the number $z=-9\\text{i}?$" :question/worked-solution "The imaginary number $-9\\text{i}$ is equivalent to the complex number $z=0-9\\text{i}.$\n\nWe know that for a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nSo, the magnitude of $z=0-9\\text{i}$ is given by\n\n$$\n\\begin{aligned}|z| & =\\sqrt{{a}^{2}+{b}^{2}} \\\\  & =\\sqrt{(0)^{2}+(-9)^{2}} \\\\  & =\\sqrt{81} \\\\  & =9.\\end{aligned}\n$$"} :step/id #uuid "c5102343-0d92-5737-bfce-0a300f842184"}] :activity/title "The Magnitude of a Complex Number" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186544077}]}
