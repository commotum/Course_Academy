#{[{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186097419} :activity/id #uuid "a08f28ad-f5a0-5009-8802-2bc2d37a5e98" :activity/scope {:db/id #edb/ref 17592186050690 :topic/id #uuid "5f59a4ad-6d31-5757-be65-f24e070b2c60" :topic/math-academy-id 1116} :activity/steps [{:db/id #edb/ref 17592186097419 :step/content {:db/id #edb/ref 17592186097816 :tutorial/content "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\dfrac{\\textrm{d}}{ \\textrm{d} x}\\left( \\ln x \\right)= \\dfrac{1}{x}\n$$\n\nWe'll prove this result in a future lesson." :tutorial/id #uuid "b1f46211-3766-53d0-bcc7-30bb9056b948" :tutorial/math-academy-id 2615 :tutorial/title "Introduction"} :step/id #uuid "c57de084-771c-5781-b9e0-8c1803097cbb" :step/math-academy-id 12313 :step/next {:db/id #edb/ref 17592186097420}} {:db/id #edb/ref 17592186097420 :step/content {:db/id #edb/ref 17592186096613 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096413 :question/id #uuid "6624681a-bb00-59db-8df9-4d5a3cd00434" :question/math-academy-id "e-3627"} :knowledge-point/id #uuid "a71301e9-bc7f-53b9-900e-c3bd37f96b03" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048932}] :knowledge-point/question-generator {:db/id #edb/ref 17592186481493} :knowledge-point/questions [{:db/id #edb/ref 17592186097021} {:db/id #edb/ref 17592186097022} {:db/id #edb/ref 17592186233897} {:db/id #edb/ref 17592186234288} {:db/id #edb/ref 17592186237851} {:db/id #edb/ref 17592186237852} {:db/id #edb/ref 17592186297307} {:db/id #edb/ref 17592186314887} {:db/id #edb/ref 17592186314888} {:db/id #edb/ref 17592186481489} {:db/id #edb/ref 17592186526014} {:db/id #edb/ref 17592186526101}] :knowledge-point/title "Differentiating the Product of a Constant and the Natural Logarithm Function"} :step/id #uuid "b0bc4f64-4ed3-59b3-8f89-94255173749b" :step/math-academy-id 12314 :step/next {:db/id #edb/ref 17592186097421}} {:db/id #edb/ref 17592186097421 :step/content {:db/id #edb/ref 17592186096614 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096414 :question/id #uuid "58d47fb0-cf75-58c4-8eea-f3ae97333159" :question/math-academy-id "e-3628"} :knowledge-point/id #uuid "83ce3c28-857b-5538-b362-cf52526e3688" :knowledge-point/questions [{:db/id #edb/ref 17592186097156} {:db/id #edb/ref 17592186097157} {:db/id #edb/ref 17592186233262} {:db/id #edb/ref 17592186233899} {:db/id #edb/ref 17592186237853} {:db/id #edb/ref 17592186253547} {:db/id #edb/ref 17592186297308} {:db/id #edb/ref 17592186314910} {:db/id #edb/ref 17592186314911} {:db/id #edb/ref 17592186314912} {:db/id #edb/ref 17592186401627} {:db/id #edb/ref 17592186526008} {:db/id #edb/ref 17592186547067} {:db/id #edb/ref 17592186565449}] :knowledge-point/title "Differentiating a Sum Containing a Natural Logarithm Function"} :step/id #uuid "f8894432-f206-54fd-8d25-0650b8854e56" :step/math-academy-id 12315 :step/next {:db/id #edb/ref 17592186097422}} {:db/id #edb/ref 17592186097422 :step/content {:db/id #edb/ref 17592186097817 :tutorial/content "For a general logarithm of base $a,$ the derivative is given by\n\n$$\n\\dfrac{\\textrm{d}}{ \\textrm{d} x}\\left( \\log_a x \\right)= \\dfrac{1}{x\\ln a}.\n$$\n\nAlso, recall that whenever $\\log$ is written without a base, we can assume that it represents the base $10.$ So, we have\n\n$$\n\\log x =  \\log_{10} x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{d}{dx}(\\operatorname{log}⁡x) & =\\frac{d}{dx}({log}_{10}⁡x)=\\frac{1}{x\\operatorname{ln}⁡10}.\\end{aligned}\n$$\n\n**Note:** To see where this rule comes from, we can use the change-of-base formula as shown below.\n\n$$\n\\log_a x = \\dfrac{\\ln x}{\\ln a}\n$$\n\nTaking the derivative and using the fact that $\\ln a$ is a constant, then, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡a}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡a}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x) \\\\  & =\\frac{1}{\\operatorname{ln}⁡a}\\cdot \\frac{1}{x} \\\\  & =\\frac{1}{x\\operatorname{ln}⁡a}.\\end{aligned}\n$$" :tutorial/id #uuid "7a7450e4-ec0e-5a5e-9c86-9430eb889be7" :tutorial/math-academy-id 2616 :tutorial/title "Differentiating a Logarithmic Function with a General Base"} :step/id #uuid "50c40528-51c7-55e5-8f01-7af56b1066fc" :step/math-academy-id 12316 :step/next {:db/id #edb/ref 17592186097423}} {:db/id #edb/ref 17592186097423 :step/content {:db/id #edb/ref 17592186096615 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096415 :question/id #uuid "f61ac550-d62c-558f-b6d5-0d4c9aba8089" :question/math-academy-id "e-3629"} :knowledge-point/id #uuid "5856f3cc-5423-5a97-b2fd-7f44e0797ec7" :knowledge-point/question-generator {:db/id #edb/ref 17592186481488} :knowledge-point/questions [{:db/id #edb/ref 17592186097018} {:db/id #edb/ref 17592186097019} {:db/id #edb/ref 17592186233051} {:db/id #edb/ref 17592186233900} {:db/id #edb/ref 17592186233901} {:db/id #edb/ref 17592186241022} {:db/id #edb/ref 17592186253529} {:db/id #edb/ref 17592186287936} {:db/id #edb/ref 17592186297309} {:db/id #edb/ref 17592186314898} {:db/id #edb/ref 17592186314913} {:db/id #edb/ref 17592186314914} {:db/id #edb/ref 17592186481479} {:db/id #edb/ref 17592186481480} {:db/id #edb/ref 17592186481483} {:db/id #edb/ref 17592186481484} {:db/id #edb/ref 17592186526083} {:db/id #edb/ref 17592186547011}] :knowledge-point/title "Differentiating a Logarithmic Function With a General Base"} :step/id #uuid "386f854e-f0f4-5871-a66f-7812d943cd5f" :step/math-academy-id 12317 :step/next {:db/id #edb/ref 17592186097424}} {:db/id #edb/ref 17592186097424 :step/content {:db/id #edb/ref 17592186096616 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096416 :question/id #uuid "5eaa00f8-0fd0-5de6-a7c0-965db6de3a5c" :question/math-academy-id "e-3630"} :knowledge-point/id #uuid "cef7fc21-23f4-5d6a-a208-9963ef23c784" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050711}] :knowledge-point/question-generator {:db/id #edb/ref 17592186480730} :knowledge-point/questions [{:db/id #edb/ref 17592186097136} {:db/id #edb/ref 17592186097137} {:db/id #edb/ref 17592186233052} {:db/id #edb/ref 17592186233902} {:db/id #edb/ref 17592186233903} {:db/id #edb/ref 17592186233905} {:db/id #edb/ref 17592186234289} {:db/id #edb/ref 17592186237854} {:db/id #edb/ref 17592186284696} {:db/id #edb/ref 17592186314899} {:db/id #edb/ref 17592186314901} {:db/id #edb/ref 17592186314915} {:db/id #edb/ref 17592186403412} {:db/id #edb/ref 17592186526025} {:db/id #edb/ref 17592186526067} {:db/id #edb/ref 17592186547029} {:db/id #edb/ref 17592186565467} {:db/id #edb/ref 17592186565474}] :knowledge-point/title "Calculating the Slope of the Tangent Line of a Logarithmic Function at a Point"} :step/id #uuid "346741f6-8687-5172-973e-c1b1ec2d6336" :step/math-academy-id 12319}] :activity/title "Differentiating Logarithmic Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186096894}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186547112} :activity/id #uuid "a5f48c28-a90a-5826-83d5-d9daf3f2f41b" :activity/scope {:db/id #edb/ref 17592186050690 :topic/id #uuid "5f59a4ad-6d31-5757-be65-f24e070b2c60" :topic/math-academy-id 1116} :activity/steps [{:db/id #edb/ref 17592186547085 :step/content {:db/id #edb/ref 17592186547067 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d32edabb-91fd-5a5c-9e67-a4e4b7b77dbf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+6\\ln 3" :db/id #edb/ref 17592186546717}] :answer-field/correct {:db/id #edb/ref 17592186546717} :answer-field/id #uuid "4e8e3638-67f3-58d9-93f9-3c0a5190ed16" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186546860}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e2977b6b-7b41-5dba-a0b9-9d44c80b37c2" :question/math-academy-id "q-340103" :question/problem "Given the function  $y=\\operatorname{ln}⁡x+2\\cdot {3}^{x}-1$, find the instantaneous rate of change at $x=1.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=1$ is\n{{field-1}}." :question/worked-solution "To find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x+2\\cdot {3}^{x}-1) \\\\  & =\\frac{1}{x}+2\\cdot {3}^{x}\\operatorname{ln}⁡(3).\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{1}{x}+2\\cdot {3}^{x}\\operatorname{ln}⁡(3))|}_{x=1} \\\\  & =\\frac{1}{1}+2\\cdot {3}^{1}\\operatorname{ln}⁡(3) \\\\  & =1+6\\operatorname{ln}⁡(3)\\,.\\end{aligned}\n$$"} :step/id #uuid "022a5585-d56d-5d96-a491-516934e44cec"} {:db/id #edb/ref 17592186547112 :step/content {:db/id #edb/ref 17592186547011 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fa57cc0-2c75-5aeb-aa4c-fd8435058a21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{x\\operatorname{ln}⁡5}" :db/id #edb/ref 17592186546395} {:answer/id #uuid "4395965f-6000-5eb9-b9e6-b1775cbf5929" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{x}" :db/id #edb/ref 17592186546404} {:answer/id #uuid "745dc55c-39f6-5188-893e-9e3610df2015" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{x\\operatorname{ln}⁡5}+\\frac{1}{x}" :db/id #edb/ref 17592186546508} {:answer/id #uuid "ad695ffc-4f3a-5a92-ab02-41059e526392" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{x}" :db/id #edb/ref 17592186546638} {:answer/id #uuid "da5cda44-a757-5b8c-8598-b4c7d9c5616f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{x\\operatorname{ln}⁡5}+\\frac{5}{x}" :db/id #edb/ref 17592186546733}] :answer-field/correct {:db/id #edb/ref 17592186546733} :answer-field/id #uuid "9d79f823-7d5d-51a6-84fc-0f83ec6272a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186546895}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5f56c11c-a25d-5517-9da3-7d7d6457fb75" :question/math-academy-id "q-1929" :question/problem "Find ${f}^{′}(x)$ for $f(x)={log}_{5}⁡x+5\\operatorname{ln}⁡x.$" :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{x\\operatorname{ln}⁡a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({log}_{5}⁡x+5\\operatorname{ln}⁡x) \\\\  & =\\frac{1}{x\\operatorname{ln}⁡5}+5(\\frac{1}{x}) \\\\  & =\\frac{1}{x\\operatorname{ln}⁡5}+\\frac{5}{x}.\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "52d24250-13c5-5a58-b409-7dc9b4086b72" :step/next {:db/id #edb/ref 17592186547128}} {:db/id #edb/ref 17592186547128 :step/content {:db/id #edb/ref 17592186547029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b82f47ce-2a1a-54d9-910c-89e3281c9d96" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2+3e" :db/id #edb/ref 17592186546663}] :answer-field/correct {:db/id #edb/ref 17592186546663} :answer-field/id #uuid "a2358ea3-5164-5a96-8a75-9e3a351c0de6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186546902}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "87c3de01-5d96-5716-bf8b-2cb387f1c8ec" :question/math-academy-id "q-340017" :question/problem "Given the function $y=2\\operatorname{ln}⁡x+3{e}^{x},$ the slope of the tangent line at $x=1$ is{{field-1}}." :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2\\operatorname{ln}⁡x+3{e}^{x}) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x)+3\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =2\\cdot \\frac{1}{x}+3{e}^{x} \\\\  & =\\frac{2}{x}+3{e}^{x}\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{2}{x}+3{e}^{x})|}_{x=1} \\\\  & =\\frac{2}{1}+3{e}^{1} \\\\  & =2+3e\\,.\\end{aligned}\n$$"} :step/id #uuid "96ed02b0-ade6-5327-846d-4799bbb19082" :step/next {:db/id #edb/ref 17592186547085}}] :activity/title "Differentiating Logarithmic Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186546248}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186565496} :activity/id #uuid "b5cb9568-f704-53f1-beaa-d5085eac04fc" :activity/scope {:db/id #edb/ref 17592186050690 :topic/id #uuid "5f59a4ad-6d31-5757-be65-f24e070b2c60" :topic/math-academy-id 1116} :activity/steps [{:db/id #edb/ref 17592186565493 :step/content {:db/id #edb/ref 17592186565449 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8429822b-a07a-5669-ae42-aeb9f8f5a3d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{x}+10^x\\ln 10" :db/id #edb/ref 17592186565144}] :answer-field/correct {:db/id #edb/ref 17592186565144} :answer-field/id #uuid "5cbfb684-4d22-5eea-b2a7-3432b18ace7e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186565352}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a201ee06-61a2-5773-8a24-56af686eb568" :question/math-academy-id "q-339978" :question/problem "Given that $y=-3\\operatorname{ln}⁡x+{10}^{x}-1$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$ \n{{field-1}}" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-3\\operatorname{ln}⁡x+{10}^{x}-1) \\\\  & =-3(\\frac{1}{x})+{10}^{x}\\operatorname{ln}⁡(10) \\\\  & =-\\frac{3}{x}+{10}^{x}\\operatorname{ln}⁡(10).\\end{aligned}\n$$"} :step/id #uuid "1d6993b8-0e14-54e1-8ab0-bf5e5194170c" :step/next {:db/id #edb/ref 17592186565515}} {:db/id #edb/ref 17592186565496 :step/content {:db/id #edb/ref 17592186565474 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16b0bf70-d0c6-5265-85ca-2d4c67b3b29d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2e" :db/id #edb/ref 17592186564973} {:answer/id #uuid "1d48afac-9c4c-549b-83f2-b72451b70ea3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3+2e}{2e}" :db/id #edb/ref 17592186564983} {:answer/id #uuid "27a612df-1175-56b7-ab0d-5a99177ef558" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3+2e" :db/id #edb/ref 17592186565002} {:answer/id #uuid "27db33f7-179e-55c9-8b80-bd9a663c2e69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186565004} {:answer/id #uuid "dd199b45-1cbb-5d70-a666-0e5b05022b74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2e}{3+2e}" :db/id #edb/ref 17592186565266}] :answer-field/correct {:db/id #edb/ref 17592186565002} :answer-field/id #uuid "3848e352-91c9-5cd2-91d3-3c804cea2ed3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186565344}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "de4c520d-e939-5935-ab41-475d00b0a086" :question/math-academy-id "q-17382" :question/problem "Given that $y=3\\operatorname{ln}⁡x+2{e}^{x}$, find the slope of the tangent at $x=1.$" :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{3}{x}+2{e}^{x}\\,.\n$$\n\nTherefore, the slope  of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{3}{x}+2{e}^{x})|}_{x=1} \\\\  & =\\frac{3}{1}+2{e}^{1} \\\\  & =3+2e\\,.\\end{aligned}\n$$"} :step/id #uuid "2a942685-248c-5d59-9658-99f916f859a9" :step/next {:db/id #edb/ref 17592186565493}} {:db/id #edb/ref 17592186565515 :step/content {:db/id #edb/ref 17592186565467 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f716f286-0901-500a-b1e6-20a7dee63999" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3+4e" :db/id #edb/ref 17592186565313}] :answer-field/correct {:db/id #edb/ref 17592186565313} :answer-field/id #uuid "89f12e8d-bf93-5637-a264-6851084e5f96" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186565364}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d2ff517e-a169-5a1c-9487-46b4246b351b" :question/math-academy-id "q-340023" :question/problem "Given the function $y=-3\\operatorname{ln}⁡x+4{e}^{x},$ the slope of the tangent line at $x=1$ is{{field-1}}." :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-3\\operatorname{ln}⁡x+4{e}^{x}) \\\\  & =-3\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x)+4\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =-3\\cdot \\frac{1}{x}+4{e}^{x} \\\\  & =-\\frac{3}{x}+4{e}^{x}\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(-\\frac{3}{x}+4{e}^{x})|}_{x=1} \\\\  & =-\\frac{3}{1}+4{e}^{1} \\\\  & =-3+4e\\,.\\end{aligned}\n$$"} :step/id #uuid "782e6b17-e16b-5fe8-941a-0b4c677aff59"}] :activity/title "Differentiating Logarithmic Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186564935}]}
