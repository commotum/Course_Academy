#{[{:db/id #edb/ref 17592186565474 :knowledge-point/_questions [{:db/id #edb/ref 17592186096616 :knowledge-point/id #uuid "cef7fc21-23f4-5d6a-a208-9963ef23c784" :knowledge-point/title "Calculating the Slope of the Tangent Line of a Logarithmic Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16b0bf70-d0c6-5265-85ca-2d4c67b3b29d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186564973} {:answer/id #uuid "1d48afac-9c4c-549b-83f2-b72451b70ea3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3+2e}{2e}" :db/id #edb/ref 17592186564983} {:answer/id #uuid "27a612df-1175-56b7-ab0d-5a99177ef558" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3+2e" :db/id #edb/ref 17592186565002} {:answer/id #uuid "27db33f7-179e-55c9-8b80-bd9a663c2e69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186565004} {:answer/id #uuid "dd199b45-1cbb-5d70-a666-0e5b05022b74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2e}{3+2e}" :db/id #edb/ref 17592186565266}] :answer-field/correct {:answer/id #uuid "27a612df-1175-56b7-ab0d-5a99177ef558" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3+2e" :db/id #edb/ref 17592186565002} :answer-field/id #uuid "3848e352-91c9-5cd2-91d3-3c804cea2ed3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186565344}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "de4c520d-e939-5935-ab41-475d00b0a086" :question/math-academy-id "q-17382" :question/problem "Given that $y=3\\operatorname{ln}⁡x+2{e}^{x}$, find the slope of the tangent at $x=1.$" :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{3}{x}+2{e}^{x}\\,.\n$$\n\nTherefore, the slope  of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{3}{x}+2{e}^{x})|}_{x=1} \\\\  & =\\frac{3}{1}+2{e}^{1} \\\\  & =3+2e\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186565449 :knowledge-point/_questions [{:db/id #edb/ref 17592186096614 :knowledge-point/id #uuid "83ce3c28-857b-5538-b362-cf52526e3688" :knowledge-point/title "Differentiating a Sum Containing a Natural Logarithm Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8429822b-a07a-5669-ae42-aeb9f8f5a3d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x}+10^x\\ln 10" :db/id #edb/ref 17592186565144}] :answer-field/correct {:answer/id #uuid "8429822b-a07a-5669-ae42-aeb9f8f5a3d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x}+10^x\\ln 10" :db/id #edb/ref 17592186565144} :answer-field/id #uuid "5cbfb684-4d22-5eea-b2a7-3432b18ace7e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186565352}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a201ee06-61a2-5773-8a24-56af686eb568" :question/math-academy-id "q-339978" :question/problem "Given that $y=-3\\operatorname{ln}⁡x+{10}^{x}-1$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$ \n{{field-1}}" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-3\\operatorname{ln}⁡x+{10}^{x}-1) \\\\  & =-3(\\frac{1}{x})+{10}^{x}\\operatorname{ln}⁡(10) \\\\  & =-\\frac{3}{x}+{10}^{x}\\operatorname{ln}⁡(10).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186565467 :knowledge-point/_questions [{:db/id #edb/ref 17592186096616 :knowledge-point/id #uuid "cef7fc21-23f4-5d6a-a208-9963ef23c784" :knowledge-point/title "Calculating the Slope of the Tangent Line of a Logarithmic Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f716f286-0901-500a-b1e6-20a7dee63999" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3+4e" :db/id #edb/ref 17592186565313}] :answer-field/correct {:answer/id #uuid "f716f286-0901-500a-b1e6-20a7dee63999" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3+4e" :db/id #edb/ref 17592186565313} :answer-field/id #uuid "89f12e8d-bf93-5637-a264-6851084e5f96" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186565364}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d2ff517e-a169-5a1c-9487-46b4246b351b" :question/math-academy-id "q-340023" :question/problem "Given the function $y=-3\\operatorname{ln}⁡x+4{e}^{x},$ the slope of the tangent line at $x=1$ is{{field-1}}." :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-3\\operatorname{ln}⁡x+4{e}^{x}) \\\\  & =-3\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x)+4\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =-3\\cdot \\frac{1}{x}+4{e}^{x} \\\\  & =-\\frac{3}{x}+4{e}^{x}\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(-\\frac{3}{x}+4{e}^{x})|}_{x=1} \\\\  & =-\\frac{3}{1}+4{e}^{1} \\\\  & =-3+4e\\,.\\end{aligned}\n$$"}]}
