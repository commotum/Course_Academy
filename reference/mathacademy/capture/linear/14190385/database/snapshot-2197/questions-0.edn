#{[{:db/id #edb/ref 17592186188179 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186188243 :knowledge-point/id #uuid "12bd9bab-79dd-577e-907e-5f537b3b5eac" :knowledge-point/title "Converting From Kilograms to Grams"}] :question/id #uuid "a8a6ddf1-4401-5f68-9eba-e6d1162d33eb" :question/math-academy-id "e-14051" :question/problem "What is $0.2 \\,\\textrm{kg}$ expressed in $\\textrm g?$" :question/worked-solution "We start by recalling the conversion table for mass units. \n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Kilogram | $\\textrm{kg}$ | $1\\,\\textrm{kg} = 1\\,000\\,\\textrm{g}$ |\n| Gram | $\\textrm{g}$ | Base Unit |\n| Milligram | $\\textrm{mg}$ | $1\\,000\\,\\textrm{mg} = 1\\,\\textrm{g}$ |\n\nThere are $1000\\,\\textrm g$ per $\\textrm{kg},$ which we can write as follows:\n\n$$\n\\dfrac{1000\\,\\textrm g}{\\textrm{kg}}\n$$\n\nThis is our conversion factor.\n\nNow, multiplying $0.2\\,\\textrm{kg}$ by our conversion factor, we get\n\n$$\n\\begin{aligned}0.2\\,\\text{kg} & =0.2\\,\\text{kg}\\cdot \\frac{1\\,000\\,\\text{g}}{\\text{kg}} \\\\  & =0.2\\,\\cancel{\\text{kg}}\\cdot \\frac{1\\,000\\,\\text{g}}{\\cancel{\\text{kg}}} \\\\  & =0.2\\cdot 1\\,000\\,\\text{g} \\\\  & =200\\,\\text{g}.\\end{aligned}\n$$\n\nTherefore, $0.2\\,\\textrm{kg}$ is equivalent to $200 \\,\\text{g}.$"}] [{:db/id #edb/ref 17592186188180 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186188244 :knowledge-point/id #uuid "278e33dd-6216-5cf9-9e52-e20924e0622b" :knowledge-point/title "Converting From Grams to Milligrams"}] :question/id #uuid "f565f22a-58de-5553-b618-d55f088be079" :question/math-academy-id "e-14052" :question/problem "What is $2.25 \\,\\textrm{g}$ expressed in $\\textrm{mg}?$" :question/worked-solution "We start by recalling the conversion table for mass units. \n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Kilogram | $\\textrm{kg}$ | $1\\,\\textrm{kg} = 1\\,000\\,\\textrm{g}$ |\n| Gram | $\\textrm{g}$ | Base Unit |\n| Milligram | $\\textrm{mg}$ | $1\\,000\\,\\textrm{mg} = 1\\,\\textrm{g}$ |\n\nThere are $1000\\,\\textrm {mg}$ per $\\textrm{g},$ which we can write as follows:\n\n$$\n\\dfrac{1000\\,\\textrm{mg}}{\\textrm{g}}\n$$\n\nThis is our conversion factor.\n\nNow, multiplying $2.25 \\,\\textrm{g}$ by our conversion factor, we get\n\n$$\n\\begin{aligned}2.25\\,\\text{g} & =2.25\\,\\text{g}\\cdot \\frac{1\\,000\\,\\text{mg}}{\\text{g}} \\\\  & =2.25\\,\\cancel{\\text{g}}\\cdot \\frac{1\\,000\\,\\text{mg}}{\\cancel{\\text{g}}} \\\\  & =2.25\\cdot 1\\,000\\,\\text{mg} \\\\  & =2\\,250\\,\\text{mg}.\\end{aligned}\n$$\n\nTherefore, $2.25 \\,\\textrm{g}$ is equivalent to $2\\,250\\,\\text{mg}.$"}] [{:db/id #edb/ref 17592186188182 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186188245 :knowledge-point/id #uuid "0018c984-790b-57d0-b086-77f5bdf8f273" :knowledge-point/title "Converting From Smaller Units to Larger Units"}] :question/id #uuid "8e2f9e3e-e0b3-53d5-88e6-38cbcb37af59" :question/math-academy-id "e-14057" :question/problem "What is $1\\,300 \\,\\textrm{g}$ expressed in $\\textrm{kg}?$" :question/worked-solution "We start by recalling the conversion table for mass units. \n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Kilogram | $\\textrm{kg}$ | $1\\,\\textrm{kg} = 1\\,000\\,\\textrm{g}$ |\n| Gram | $\\textrm{g}$ | Base Unit |\n| Milligram | $\\textrm{mg}$ | $1\\,000\\,\\textrm{mg} = 1\\,\\textrm{g}$ |\n\nThere are $1000\\,\\textrm g$ per $\\textrm{kg},$ which we can write as follows:\n\n$$\n\\dfrac{1000\\,\\textrm g}{\\textrm{kg}}\n$$\n\nHowever, since we're converting from a smaller unit of mass $(\\textrm g)$ to a larger one $(\\textrm{kg}),$ we need to multiply  $1\\,300 \\,\\textrm{g}$ by the reciprocal of the above:\n\n$$\n\\dfrac{\\textrm{kg}}{1000\\,\\textrm g}\n$$\n\nThis is our conversion factor.\n\nNow, multiplying $1\\,300 \\,\\textrm{g}$ by our conversion factor, we get\n\n$$\n\\begin{aligned}1\\,300\\,\\text{g} & =1\\,300\\,\\text{g}\\cdot \\frac{\\text{kg}}{1000\\,\\text{g}} \\\\  & =1\\,300\\,\\cancel{\\text{g}}\\cdot \\frac{\\text{kg}}{1000\\,\\cancel{\\text{g}}} \\\\  & =1\\,300\\cdot \\frac{\\text{kg}}{1000} \\\\  & =\\frac{1\\,300}{1\\,000}\\,\\text{kg} \\\\  & =1.3\\,\\text{kg}\\end{aligned}\n$$\n\nTherefore, $1\\,300 \\,\\textrm{g}$ is equivalent to $1.3 \\,\\text{kg}.$"}] [{:db/id #edb/ref 17592186510403 :knowledge-point/_questions [{:db/id #edb/ref 17592186188243 :knowledge-point/id #uuid "12bd9bab-79dd-577e-907e-5f537b3b5eac" :knowledge-point/title "Converting From Kilograms to Grams"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30348f3c-3788-504b-9629-f4c936131ec8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "500\\,\\text{g}" :db/id #edb/ref 17592186509791} {:answer/id #uuid "e68a5125-7424-5c12-92c5-8132da348da7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50\\,000\\,\\text{g}" :db/id #edb/ref 17592186510177} {:answer/id #uuid "e88356a0-253d-51cc-8b75-cec089be1a7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,000\\,\\text{g}" :db/id #edb/ref 17592186510183} {:answer/id #uuid "eac1d7d8-880e-5edc-a86e-411b33ed6ae4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{g}" :db/id #edb/ref 17592186510193} {:answer/id #uuid "ec1cd35e-8a1d-59c4-ad98-cc96b2855af5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50\\,\\text{g}" :db/id #edb/ref 17592186510198}] :answer-field/correct {:answer/id #uuid "30348f3c-3788-504b-9629-f4c936131ec8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "500\\,\\text{g}" :db/id #edb/ref 17592186509791} :answer-field/id #uuid "5663f6d6-57a6-5d47-a135-65312b3d6dfc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186510282}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6c39888c-26fe-5434-a6f8-f7931c732ee1" :question/math-academy-id "q-143906" :question/problem "What is $0.5\\,\\text{kg}$ expressed in $\\text{g}?$" :question/worked-solution "We start by recalling the conversion table for mass units. \n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Kilogram | $\\text{kg}$ | $1\\,\\text{kg}=1\\,000\\,\\text{g}$ |\n| Gram | $\\text{g}$ | Base Unit |\n| Milligram | $\\text{mg}$ | $1\\,000\\,\\text{mg}=1\\,\\text{g}$ |\n\n$$\n\n$$\n\nThere are $1000\\,\\text{g}$ per $\\text{kg},$ which we can write as follows:\n\n$$\n\\frac{1000\\,\\text{g}}{\\text{kg}}\n$$\n\nThis is our conversion factor.\n\nNow, multiplying $0.5\\,\\text{kg}$ by our conversion factor, we get\n\n$$\n\\begin{aligned}0.5\\,\\text{kg} & =0.5\\,\\text{kg}\\cdot \\frac{1\\,000\\,\\text{g}}{\\text{kg}} \\\\  & =0.5\\,\\cancel{\\text{kg}}\\cdot \\frac{1\\,000\\,\\text{g}}{\\cancel{\\text{kg}}} \\\\  & =0.5\\cdot 1\\,000\\,\\text{g} \\\\  & =500\\,\\text{g}.\\end{aligned}\n$$\n\nTherefore, $0.5\\,\\text{kg}$ is equivalent to $500\\,\\text{g}.$"}] [{:db/id #edb/ref 17592186510407 :knowledge-point/_questions [{:db/id #edb/ref 17592186188244 :knowledge-point/id #uuid "278e33dd-6216-5cf9-9e52-e20924e0622b" :knowledge-point/title "Converting From Grams to Milligrams"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1eebb549-c8b6-5a56-864b-c66e34c6003b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,200\\,\\text{mg}" :db/id #edb/ref 17592186509749} {:answer/id #uuid "2cad8974-2411-59a1-8dec-b752ba429ba3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,\\text{mg}" :db/id #edb/ref 17592186509780} {:answer/id #uuid "4619eae4-0b7a-5046-abf3-851ad72a223f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math}