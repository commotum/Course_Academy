3</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>kg</mtext></mtd><mtd><mi></mi><mo>=</mo><mn>73</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>kg</mtext><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>1</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mn>000</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>g</mtext></mrow><mtext>kg</mtext></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>73</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><menclose notation=\"updiagonalstrike\"><mtext>kg</mtext></menclose><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>1</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mn>000</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>g</mtext></mrow><menclose notation=\"updiagonalstrike\"><mtext>kg</mtext></menclose></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>73</mn><mo>⋅</mo><mn>1</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mn>000</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>g</mtext></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>73</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mn>000</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>g</mtext><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Therefore, <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"21\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c37\"></mjx-c><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn><mjx-mstyle><mjx-mspace style=\"width: 0.167em;\"></mjx-mspace></mjx-mstyle><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c6B\"></mjx-c><mjx-c class=\"mjx-c67\"></mjx-c></mjx-mtext></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>73</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>kg</mtext></math></mjx-assistive-mml></mjx-container> is equivalent to <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"22\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle style=\"border: 1px solid lightgray;\"><mjx-mpadded><mjx-block style=\"width: 3.467em; margin: 0.4em 0px; position: relative;\"><mjx-rbox style=\"left: 0.4em; top: 0px; max-width: 3.467em;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c37\"></mjx-c><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn><mjx-mstyle><mjx-mspace style=\"width: 0.167em;\"></mjx-mspace></mjx-mstyle><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c30\"></mjx-c><mjx-c class=\"mjx-c30\"></mjx-c><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle><mjx-mstyle><mjx-mspace style=\"width: 0.167em;\"></mjx-mspace></mjx-mstyle><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c67\"></mjx-c></mjx-mtext><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>73</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mn>000</mn></mpadded></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>g</mtext><mo>.</mo></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
