3 -75Z\"></path>\n<path stroke-width=\"1\" id=\"E10-MJMAIN-6B\" d=\"M36 46H50Q89 46 97 60V68Q97 77 97 91T97 124T98 167T98 217T98 272T98 329Q98 366 98 407T98 482T98 542T97 586T97 603Q94 622 83 628T38 637H20V660Q20 683 22 683L32 684Q42 685 61 686T98 688Q115 689 135 690T165 693T176 694H179V463L180 233L240 287Q300 341 304 347Q310 356 310 364Q310 383 289 385H284V431H293Q308 428 412 428Q475 428 484 431H489V385H476Q407 380 360 341Q286 278 286 274Q286 273 349 181T420 79Q434 60 451 53T500 46H511V0H505Q496 3 418 3Q322 3 307 0H299V46H306Q330 48 330 65Q330 72 326 79Q323 84 276 153T228 222L176 176V120V84Q176 65 178 59T189 49Q210 46 238 46H254V0H246Q231 3 137 3T28 0H20V46H36Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"2789\" height=\"60\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(60,726)\">\n <use xlink:href=\"#E10-MJMAIN-31\"></use>\n <use xlink:href=\"#E10-MJMAIN-30\" x=\"500\" y=\"0\"></use>\n <use xlink:href=\"#E10-MJMAIN-30\" x=\"1001\" y=\"0\"></use>\n <use xlink:href=\"#E10-MJMAIN-30\" x=\"1501\" y=\"0\"></use>\n <use xlink:href=\"#E10-MJMAIN-67\" x=\"2168\" y=\"0\"></use>\n</g>\n<g transform=\"translate(880,-716)\">\n <use xlink:href=\"#E10-MJMAIN-6B\"></use>\n <use xlink:href=\"#E10-MJMAIN-67\" x=\"528\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</svg></span></p>\n<p>This is our <strong>conversion factor.</strong> It's important to write the conversion factor with the units included.</p>\n<p>To convert <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"6.911ex\" height=\"2.509ex\" style=\"vertical-align: -0.671ex;\" viewBox=\"0 -791.3 2975.7 1080.4\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-11-Title\">\n<title id=\"MathJax-SVG-11-Title\">0.03 \\,\\textrm{kg} </title>\n<defs aria-hidden=\"true\">\n<path stroke-width=