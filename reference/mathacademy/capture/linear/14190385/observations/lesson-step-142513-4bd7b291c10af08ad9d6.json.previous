</use>\n<g transform=\"translate(60,-687)\">\n <use xlink:href=\"#E13-MJMAIN-31\"></use>\n <use xlink:href=\"#E13-MJMAIN-30\" x=\"500\" y=\"0\"></use>\n <use xlink:href=\"#E13-MJMAIN-30\" x=\"1001\" y=\"0\"></use>\n <use xlink:href=\"#E13-MJMAIN-30\" x=\"1501\" y=\"0\"></use>\n<g transform=\"translate(2168,0)\">\n <use xlink:href=\"#E13-MJMAIN-6D\"></use>\n <use xlink:href=\"#E13-MJMAIN-67\" x=\"833\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n<p>Now, multiplying <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"6.973ex\" height=\"2.509ex\" style=\"vertical-align: -0.671ex;\" viewBox=\"0 -791.3 3002.2 1080.4\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-14-Title\">\n<title id=\"MathJax-SVG-14-Title\">600 \\,\\textrm{mg} </title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E14-MJMAIN-36\" d=\"M42 313Q42 476 123 571T303 666Q372 666 402 630T432 550Q432 525 418 510T379 495Q356 495 341 509T326 548Q326 592 373 601Q351 623 311 626Q240 626 194 566Q147 500 147 364L148 360Q153 366 156 373Q197 433 263 433H267Q313 433 348 414Q372 400 396 374T435 317Q456 268 456 210V192Q456 169 451 149Q440 90 387 34T253 -22Q225 -22 199 -14T143 16T92 75T56 172T42 313ZM257 397Q227 397 205 380T171 335T154 278T148 216Q148 133 160 97T198 39Q222 21 251 21Q302 21 329 59Q342 77 347 104T352 209Q352 289 347 316T329 361Q302 397 257 397Z\"></path>\n<path stroke-width=\"1\" id=\"E14-MJMAIN-30\" d=\"M96 585Q152 666 249 666Q297 666 345 640T423 548Q460 465 460 320Q460 165 417 83Q397 41 362 16T301 -15T250 -22Q224 -22 198 -16T137 16T82 83Q39 165 39 320Q39 494 96 585ZM321 597Q291 629 250 629Q208 629 178 597Q153 571 145 525T137 333Q137 175 145 125T181 46Q209 16 250 16Q290 16 318 46Q347 76 354 130T362 333Q362 478 354 524T321 597Z\"></path>\n<path stroke-width=\"1\" id=\"E14-MJMAIN-6D\" d=\"M41 46H55Q94 46 102 60V68Q102 77 102 91T102 122T103 161T103 203Q103 234 103 269T102 328V351Q99 370 88 376T43 38