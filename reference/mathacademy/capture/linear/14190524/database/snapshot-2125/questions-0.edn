#{[{:db/id #edb/ref 17592186503680 :knowledge-point/_questions [{:db/id #edb/ref 17592186068926 :knowledge-point/id #uuid "63461668-4f76-52a4-8115-1ab135eef9e3" :knowledge-point/title "Finding the X-Intercept of a Line Given a Point and a Slope"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "196a504d-8519-53de-a140-45e7f8cea19a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186503033} {:answer/id #uuid "4098c8f0-90f5-57e1-ba2c-2a4d7e248771" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186503104} {:answer/id #uuid "50a00234-aaec-5fc9-a334-a039e8d088d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186503135} {:answer/id #uuid "77e09b7f-fef5-597d-84f8-1e7e8d6c7194" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186503223} {:answer/id #uuid "b9ac371a-7bc0-5123-8664-79c20ac774c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186503356}] :answer-field/correct {:answer/id #uuid "4098c8f0-90f5-57e1-ba2c-2a4d7e248771" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186503104} :answer-field/id #uuid "f749aa0a-56e8-5fac-8b2c-39890015d4a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503640}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4459c635-09f2-5d35-8ba8-5eb9bfaa5126" :question/math-academy-id "q-44304" :question/problem "Calculate the $x$-intercept of the line $y=-2x+10.$" :question/worked-solution "At the $x$-intercept, the $y$-coordinate is equal to $0.$ So, we can substitute $y=0$ into the equation and then solve for $x:$\n\n$$\n\\begin{aligned}y & =-2x+10 \\\\ 0 & =-2x+10 \\\\ 2x & =10 \\\\ x & =\\frac{10}{2} \\\\ x & =5\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $x=5.$ The coordinates of the $x$-intercept are $(5,0).$"}] [{:db/id #edb/ref 17592186069483 :knowledge-point/_questions [{:db/id #edb/ref 17592186068925 :knowledge-point/id #uuid "5e985ae8-05ba-590a-b504-4c84884679f4" :knowledge-point/title "Finding the Equation of a Line That Passes Through Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60e87123-16db-5a92-8cb2-8a23c0aeaba6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4x-1" :db/id #edb/ref 17592186503170} {:answer/id #uuid "698c2d3c-6a55-59a5-8c8b-9b9708fddb70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3x-1" :db/id #edb/ref 17592186503187} {:answer/id #uuid "97d26e7c-a075-5ed5-a723-528daa017501" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x-6" :db/id #edb/ref 17592186503282} {:answer/id #uuid "bdc76194-9c0b-5ed2-8b4e-4b1e27f0b5e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4x+1" :db/id #edb/ref 17592186503361} {:answer/id #uuid "f9554e82-405c-52e6-af3f-b2b480146aaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3x-3" :db/id #edb/ref 17592186503497}] :answer-field/correct {:answer/id #uuid "60e87123-16db-5a92-8cb2-8a23c0aeaba6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4x-1" :db/id #edb/ref 17592186503170} :answer-field/id #uuid "1f1a378b-e807-52c5-ac81-76d5297f2e2a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186068068}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b4eef31d-a7fd-5ae0-810a-624f060a825b" :question/math-academy-id "q-6902" :question/problem "Determine the equation of the line that passes through the points $(2,7)$ and $(3,11).$" :question/worked-solution "We will write the equation of the line in the slope-intercept form $y=mx+b.$ So, we need to work out the slope $m$ and the $y$-intercept $b.$\n\nFirst, we calculate the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{11-7}{3-2} \\\\  & =\\frac{4}{1} \\\\  & =4\\end{aligned}\n$$\n\nSubstituting the slope $m=4$ into the slope-intercept formula $y=mx+b,$ we reach\n\n$$\ny=4x+b.\n$$\n\nWe now need to find the $y$-intercept $b.$ We can find this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(2,7):$\n\n$$\n\\begin{aligned}y & =4x+b \\\\ 7 & =4(2)+b \\\\ 7 & =8+b \\\\ 7-8 & =b \\\\ -1 & =b\\end{aligned}\n$$\n\nSo the equation of the line is $y=4x-1.$"}] [{:db/id #edb/ref 17592186503720 :knowledge-point/_questions [{:db/id #edb/ref 17592186068925 :knowledge-point/id #uuid "5e985ae8-05ba-590a-b504-4c84884679f4" :knowledge-point/title "Finding the Equation of a Line That Passes Through Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33213927-0872-5481-b492-8c2a15d7bc5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=10x-33" :db/id #edb/ref 17592186503073} {:answer/id #uuid "3e07aaa1-5380-511b-82d1-705ddf05637f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=10x+7" :db/id #edb/ref 17592186503096} {:answer/id #uuid "a3fd756d-7353-5103-b953-d571e22e7381" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=10x+47" :db/id #edb/ref 17592186503312} {:answer/id #uuid "ca218148-c955-580f-8eb5-5479cf23735d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=10x+17" :db/id #edb/ref 17592186503386} {:answer/id #uuid "fb7e9268-f0e3-598c-acbf-cc02c162d4d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=10x-47" :db/id #edb/ref 17592186503502}] :answer-field/correct {:answer/id #uuid "33213927-0872-5481-b492-8c2a15d7bc5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=10x-33" :db/id #edb/ref 17592186503073} :answer-field/id #uuid "806cc9db-3354-5070-98b7-05a7234f89ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503576}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9be101d3-9545-55c8-953e-3e73d5bfedaf" :question/math-academy-id "q-6944" :question/problem "Determine the equation of the line that passes through the points $(4,7)$ and $(5,17).$" :question/worked-solution "We will write the equation of the line in the slope-intercept form $y=mx+b.$ So, we need to work out the slope $m$ and the $y$-intercept $b.$\n\nFirst, we calculate the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{17-7}{5-4} \\\\  & =\\frac{10}{1} \\\\  & =10\\end{aligned}\n$$\n\nSubstituting the slope $m=10$ into the slope-intercept formula $y=mx+b,$ we reach\n\n$$\ny=10x+b.\n$$\n\nWe now need to find the $y$-intercept $b.$ We can find this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(4,7):$\n\n$$\n\\begin{aligned}y & =10x+b \\\\ 7 & =10(4)+b \\\\ 7 & =40+b \\\\ 7-40 & =b \\\\ -33 & =b.\\end{aligned}\n$$\n\nSo, the equation of the line is $y=10x-33.$"}]}
