#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186180522} :activity/id #uuid "847ae41b-99e9-5c25-94db-a091578bf000" :activity/scope {:db/id #edb/ref 17592186048138 :topic/id #uuid "8277b645-964a-5702-acc5-193fe49612d2" :topic/math-academy-id 3756} :activity/steps [{:db/id #edb/ref 17592186180522 :step/content {:db/id #edb/ref 17592186180739 :tutorial/content "When dealing with sums or differences of square roots, we can combine any terms with the same algebraic expression under the square root symbol $\\sqrt{\\phantom 0}.$ This is similar to collecting like terms in a linear expression.\n\nFor example, consider the following expression:\n\n$$\n5\\sqrt{x} - 3\\sqrt{x}\n$$\n\nWe can simplify our expression by combining the two radicals, as follows:\n\n$$\n\\begin{aligned}5\\sqrt{x}-3\\sqrt{x} & = \\\\ (5-3)\\sqrt{x} & = \\\\ 2\\sqrt{x} & \\end{aligned}\n$$\n\nWe *cannot* combine terms when the expressions under the radical are different. For example, the expression\n\n$$\n5\\sqrt{x} - 3\\sqrt{y}\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt x$ and $\\sqrt y.$" :tutorial/id #uuid "deda60a8-4b35-50ac-a71c-d3f884aa8e1d" :tutorial/math-academy-id 5971 :tutorial/title "Introduction"} :step/id #uuid "9e6999c1-79fe-5006-91df-3c25468791e3" :step/math-academy-id 36452 :step/next {:db/id #edb/ref 17592186180549}} {:db/id #edb/ref 17592186180523 :step/content {:db/id #edb/ref 17592186179751 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179619 :question/id #uuid "213ad0ee-813b-5a4b-8926-5fbd1aed4906" :question/math-academy-id "e-9723"} :knowledge-point/id #uuid "79a1c2e0-4183-58c6-ac88-0a4856b751a2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048170}] :knowledge-point/questions [{:db/id #edb/ref 17592186180162} {:db/id #edb/ref 17592186180179} {:db/id #edb/ref 17592186501140} {:db/id #edb/ref 17592186501154} {:db/id #edb/ref 17592186501180} {:db/id #edb/ref 17592186501203} {:db/id #edb/ref 17592186502098} {:db/id #edb/ref 17592186502138} {:db/id #edb/ref 17592186563736}] :knowledge-point/title "Simplifying Sums of Radicals with Cube Roots"} :step/id #uuid "145c40ab-6bce-539c-acfa-6819834eff82" :step/math-academy-id 36453} {:db/id #edb/ref 17592186180536 :step/content {:db/id #edb/ref 17592186180749 :tutorial/content "Recall that the product rule for radicals states that\n\n$$\n\\sqrt{a\\cdot b} = \\sqrt{a}\\cdot \\sqrt{b}\n$$\n\nwhere $a$ and $b$ are nonnegative.\n\nWe can use the product rule for radicals to simplify some expressions. Let's see an example." :tutorial/id #uuid "30549c94-702e-5e00-8cdc-4a050a34243f" :tutorial/math-academy-id 6012 :tutorial/title "The Product Rule for Radicals"} :step/id #uuid "e61e6895-553c-5528-9f47-4ce31a87b2fc" :step/math-academy-id 36694 :step/next {:db/id #edb/ref 17592186180550}} {:db/id #edb/ref 17592186180537 :step/content {:db/id #edb/ref 17592186180750 :tutorial/content "We can simplify cube root expressions in the same way as with square roots.\n\nFor example, consider the following expression:\n\n$$\n4\\sqrt[3]x - 2\\sqrt[3] x\n$$\n\nWe can simplify our expression by combining the two radicals, as follows:\n\n$$\n\\begin{aligned}4\\sqrt[3]{x}-2\\sqrt[3]{x} & = \\\\ (4-2)\\sqrt[3]{x} & = \\\\ 2\\sqrt[3]{x} & \\end{aligned}\n$$\n\n \n\nAs with square roots, we *cannot* combine terms when the expressions under the radical are different. For example, the expression\n\n$$\n\\sqrt[3]{x-1} + \\sqrt[3]{x+1}\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt[3]{x-1}$ and $\\sqrt[3]{x+1}.$\n\nFinally, it is not possible to combine square root and cube root terms, even if the numbers under the radical symbol are the same! For example, the expression\n\n$$\n2\\sqrt x + \\sqrt[3] x\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt x$ and $\\sqrt[3] x.$" :tutorial/id #uuid "a4a25921-e2bd-5bf7-99ed-3a8dd852fb70" :tutorial/math-academy-id 6013 :tutorial/title "Simplifying Expressions with Cube Roots"} :step/id #uuid "9ed96a02-bacb-559e-9bf4-ebf7f568ed2f" :step/math-academy-id 36695 :step/next {:db/id #edb/ref 17592186180523}} {:db/id #edb/ref 17592186180549 :step/content {:db/id #edb/ref 17592186179763 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179463 :question/id #uuid "13f8fdac-32c2-5f2a-a818-cde14e59299e" :question/math-academy-id "e-1373"} :knowledge-point/id #uuid "477301de-0888-5f46-84cc-5b2939516e7b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050341} {:db/id #edb/ref 17592186050452}] :knowledge-point/questions [{:db/id #edb/ref 17592186180214} {:db/id #edb/ref 17592186180215} {:db/id #edb/ref 17592186501137} {:db/id #edb/ref 17592186501209} {:db/id #edb/ref 17592186502097} {:db/id #edb/ref 17592186502146}] :knowledge-point/title "Simplifying Expressions Containing Radicals"} :step/id #uuid "402d2fd6-c005-5674-be33-360f1b1762d7" :step/math-academy-id 4334 :step/next {:db/id #edb/ref 17592186180536}} {:db/id #edb/ref 17592186180550 :step/content {:db/id #edb/ref 17592186179764 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179464 :question/id #uuid "eb35e7da-e6d0-5811-a2ee-92390f71c5f7" :question/math-academy-id "e-1374"} :knowledge-point/id #uuid "35580c97-b64e-55a3-b71e-9190dbcac10b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050496}] :knowledge-point/questions [{:db/id #edb/ref 17592186179916} {:db/id #edb/ref 17592186180180} {:db/id #edb/ref 17592186501220} {:db/id #edb/ref 17592186502101} {:db/id #edb/ref 17592186502133} {:db/id #edb/ref 17592186563718} {:db/id #edb/ref 17592186563723}] :knowledge-point/title "Simplifying Sums of Radicals Using the Product Rule"} :step/id #uuid "e9871c72-8aa0-5596-948e-55a61792f893" :step/math-academy-id 4336 :step/next {:db/id #edb/ref 17592186180537}}] :activity/title "Adding and Subtracting Radical Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179899}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186563790} :activity/id #uuid "5f674834-2a57-5e4c-9972-af563d469b92" :activity/scope {:db/id #edb/ref 17592186048138 :topic/id #uuid "8277b645-964a-5702-acc5-193fe49612d2" :topic/math-academy-id 3756} :activity/steps [{:db/id #edb/ref 17592186563786 :step/content {:db/id #edb/ref 17592186563736 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c2f4616-54cd-5516-be79-b77cd37a59b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6\\sqrt{y}" :db/id #edb/ref 17592186562964} {:answer/id #uuid "1aed403b-dbdf-50cf-b8cc-99506a344078" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\sqrt{y}-4\\sqrt[3]{y}" :db/id #edb/ref 17592186563005} {:answer/id #uuid "40bbda36-b2ef-5389-b981-78447392ad16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\sqrt{y}-2\\sqrt[3]{y}" :db/id #edb/ref 17592186563094} {:answer/id #uuid "784a2285-292b-5a35-aaf7-7340d809529b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{y}-4\\sqrt[3]{y}" :db/id #edb/ref 17592186563211} {:answer/id #uuid "89462c96-0fb9-5051-8f94-3c90423306ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{y}-5\\sqrt[3]{y}" :db/id #edb/ref 17592186563249}] :answer-field/correct {:db/id #edb/ref 17592186563005} :answer-field/id #uuid "a8669faa-71b0-532d-ba32-5f961f40b158" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563611}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ce532f1b-ce31-55ab-8ca6-180ef8818c5e" :question/math-academy-id "q-29319" :question/problem "Simplify $3\\sqrt[3]{y}-4\\sqrt{y}-7\\sqrt[3]{y}+2\\sqrt{y}.$" :question/worked-solution "We can combine the two $\\sqrt[3]{y}$ terms together, and the two $\\sqrt{y}$ terms together:\n\n$$\n\\begin{aligned}3\\sqrt[3]{y}-4\\sqrt{y}-7\\sqrt[3]{y}+2\\sqrt{y} & = \\\\ (-4+2)\\sqrt{y}+(3-7)\\sqrt[3]{y} & = \\\\ -2\\sqrt{y}-4\\sqrt[3]{y}\\end{aligned}\n$$\n\nNotice that we cannot combine the $\\sqrt[3]{y}$ and $\\sqrt{y}$ terms."} :step/id #uuid "749f734f-f9f3-581f-9e6b-58c70b1f490a" :step/next {:db/id #edb/ref 17592186563801}} {:db/id #edb/ref 17592186563790 :step/content {:db/id #edb/ref 17592186563718 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85b4904a-d133-59e2-89df-d49b787f7a62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt[3]{{x}^{2}}-{x}^{2}\\sqrt{x}" :db/id #edb/ref 17592186563245} {:answer/id #uuid "9026f5ff-791a-5770-911f-0b0b83b85fb1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[3]{{x}^{2}}-3x\\sqrt{x}" :db/id #edb/ref 17592186563268} {:answer/id #uuid "9c93eb0d-6ded-596d-b4ab-b36cd01140e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}+3\\sqrt[3]{{x}^{2}}-{x}^{2}\\sqrt{x}" :db/id #edb/ref 17592186563296} {:answer/id #uuid "ac5245bd-caba-5f74-b81d-55f9a9e8ac2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}+3\\sqrt[3]{{x}^{2}}-x\\sqrt{x}" :db/id #edb/ref 17592186563336} {:answer/id #uuid "ebcfccec-dd55-5089-ac9a-b0ae93280f1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[3]{3{x}^{2}-{x}^{5}}" :db/id #edb/ref 17592186563472}] :answer-field/correct {:db/id #edb/ref 17592186563245} :answer-field/id #uuid "c61d8497-db30-5312-b6cc-cc9f8eeed283" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563622}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a056777d-2d90-5391-b8e4-3c8ae89bd6c6" :question/math-academy-id "q-4064" :question/problem "$3\\sqrt{3}-\\sqrt{27}+3\\sqrt[3]{{x}^{2}}-\\sqrt{{x}^{5}}=$" :question/worked-solution "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}3\\sqrt{3}-\\sqrt{27}+3\\sqrt[3]{{x}^{2}}-\\sqrt{{x}^{5}} & = \\\\ 3\\sqrt{3}-\\sqrt{9\\cdot 3}+3\\sqrt[3]{{x}^{2}}-\\sqrt{{x}^{4}\\cdot x} & = \\\\ 3\\sqrt{3}-\\sqrt{9}\\cdot \\sqrt{3}+3\\sqrt[3]{{x}^{2}}-\\sqrt{{x}^{4}}\\cdot \\sqrt{x} & = \\\\ 3\\sqrt{3}-3\\sqrt{3}+3\\sqrt[3]{{x}^{2}}-{x}^{2}\\sqrt{x} & \\end{aligned}\n$$\n\nFinally, we combine the like terms:\n\n$$\n\\begin{aligned}3\\sqrt{3}-3\\sqrt{3}+3\\sqrt[3]{{x}^{2}}-{x}^{2}\\sqrt{x} & = \\\\ (3-3)\\sqrt{3}+3\\sqrt[3]{{x}^{2}}-{x}^{2}\\sqrt{x} & = \\\\ 0\\cdot \\sqrt{3}+3\\sqrt[3]{{x}^{2}}-{x}^{2}\\sqrt{x} & = \\\\ 3\\sqrt[3]{{x}^{2}}-{x}^{2}\\sqrt{x} & \\end{aligned}\n$$"} :step/id #uuid "8968f935-7b70-53c6-a08f-fcaf88c8bc02" :step/next {:db/id #edb/ref 17592186563786}} {:db/id #edb/ref 17592186563801 :step/content {:db/id #edb/ref 17592186563723 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18d7d654-83a6-5095-8350-0c24ed3b09f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{6}+\\sqrt{x}" :db/id #edb/ref 17592186563002} {:answer/id #uuid "3f460124-51cf-5f31-ae09-245b7c4d361f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x" :db/id #edb/ref 17592186563088} {:answer/id #uuid "5b0c664c-f8c9-5f53-b9f0-e91c57fa6455" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\sqrt{6}" :db/id #edb/ref 17592186563151} {:answer/id #uuid "8d383985-681c-53c8-9484-5c98b6262456" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\sqrt{6}+2x\\sqrt{x}" :db/id #edb/ref 17592186563263} {:answer/id #uuid "e8fc2ea4-ed54-5789-9c1b-da6da0a36fc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\sqrt{6}-x\\sqrt{x}" :db/id #edb/ref 17592186563466}] :answer-field/correct {:db/id #edb/ref 17592186563263} :answer-field/id #uuid "2edd54bc-8785-50e5-9005-f3528fdfbcbc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563548}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aceecb75-92cf-58b4-997d-d31ecad9d81f" :question/math-academy-id "q-29322" :question/problem "Simplify $2x\\sqrt{54}+2x\\sqrt{x}-5x\\sqrt{6}.$" :question/worked-solution "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}2x\\sqrt{54}+2x\\sqrt{x}-5x\\sqrt{6} & = \\\\ 2x\\sqrt{9\\cdot 6}+2x\\sqrt{x}-5x\\sqrt{6} & = \\\\ 2x\\sqrt{9}\\cdot \\sqrt{6}+2x\\sqrt{x}-5x\\sqrt{6} & = \\\\ 2x\\cdot 3\\cdot \\sqrt{6}+2x\\sqrt{x}-5x\\sqrt{6} & = \\\\ 6x\\sqrt{6}+2x\\sqrt{x}-5x\\sqrt{6} & \\end{aligned}\n$$\n\nFinally, we combine the like terms:\n\n$$\n\\begin{aligned}6x\\sqrt{6}+2x\\sqrt{x}-5x\\sqrt{6} & = \\\\ (6x-5x)\\sqrt{6}+2x\\sqrt{x} & = \\\\ x\\sqrt{6}+2x\\sqrt{x}\\end{aligned}\n$$"} :step/id #uuid "b609203c-4095-58fb-bb8f-2ece8932910b"}] :activity/title "Adding and Subtracting Radical Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186562928}]}
