#{[{:db/id #edb/ref 17592186059503 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059675 :knowledge-point/id #uuid "0de0627b-2568-5c02-8928-d14344df5a2f" :knowledge-point/title "Finding the Derivative of an Expression With Sine or Cosine Trigonometric Functions"}] :question/id #uuid "31b9e2d8-1458-50b3-a920-703476825420" :question/math-academy-id "e-3631" :question/problem "Find the derivative of $y =  3\\cos x  + 4\\sin x + 2x^3.$" :question/worked-solution "We know that $\\dfrac{\\textrm{d}}{\\textrm{d}x} ( \\sin x ) = \\cos x,$ and that $\\dfrac{\\textrm{d}}{\\textrm{d}x} ( \\cos x ) = -\\sin x.$ Applying these formulas, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3cos⁡x+4sin⁡x+2{x}^{3}) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}(cos⁡x)+4\\frac{\\text{d}}{\\text{d}x}(sin⁡x)+2\\frac{\\text{d}}{\\text{d}x}({x}^{3}) \\\\  & =-3sin⁡x+4cos⁡x+2(3){x}^{2} \\\\  & =-3sin⁡x+4cos⁡x+6{x}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059504 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059676 :knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/id #uuid "ae922c00-2ff5-5a46-805a-62955bc5a08a" :question/math-academy-id "e-3632" :question/problem "Find the slope of $y = 4\\tan x + 5x$ at $x = 0.$" :question/worked-solution "The slope at $x=0$ is given by the value of the derivative $y'$ at $x=0.$ \n\nFirst, we compute the derivative, using the fact that $\\dfrac{\\textrm{d}}{\\textrm{d}x} (\\tan x) = \\sec^2 x.$ We get\n\n$$\n\\begin{aligned}{y}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4tan⁡x+5x) \\\\  & =4{sec}^{2}⁡x+5.\\end{aligned}\n$$\n\nEvaluating at $x=0,$ we get\n\n$$\n\\begin{aligned}{y}^{′}(0) & =4{sec}^{2}⁡0+5 \\\\  & =4\\cdot 1+5 \\\\  & =9.\\end{aligned}\n$$\n\nTherefore, the slope is $9.$"}] [{:db/id #edb/ref 17592186570747 :knowledge-point/_questions [{:db/id #edb/ref 17592186059675 :knowledge-point/id #uuid "0de0627b-2568-5c02-8928-d14344df5a2f" :knowledge-point/title "Finding the Derivative of an Expression With Sine or Cosine Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3194e810-de8d-5ddb-b76b-c74b5e2ef41d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\operatorname{sin}⁡x-10x" :db/id #edb/ref 17592186570210} {:answer/id #uuid "3f601fa8-b710-5fc9-9176-855a030771b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{sin}⁡x-5x" :db/id #edb/ref 17592186570228} {:answer/id #uuid "ab58c061-3981-52fa-bc50-c227c5cc414a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{sin}⁡x-10x" :db/id #edb/ref 17592186570428} {:answer/id #uuid "d3209c96-76c1-5e14-9703-6ac9f612067a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\operatorname{sin}⁡x+5x" :db/id #edb/ref 17592186570494} {:answer/id #uuid "f26b14ca-3532-5536-8a57-8073b5442eba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{sin}⁡x+10x" :db/id #edb/ref 17592186570552}] :answer-field/correct {:answer/id #uuid "3194e810-de8d-5ddb-b76b-c74b5e2ef41d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\operatorname{sin}⁡x-10x" :db/id #edb/ref 17592186570210} :answer-field/id #uuid "8f8541fc-fa14-5f93-80a3-f994b1803ff3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186570640}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c894a69-28f5-558a-ade7-8f7e7954ebf4" :question/math-academy-id "q-30987" :question/problem "Find ${f}^{′}(x)$ for $f(x)=4\\operatorname{cos}⁡x-5{x}^{2}+8.$" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡x)=-\\operatorname{sin}⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4\\operatorname{cos}⁡x-5{x}^{2}+8) \\\\  & =-4\\operatorname{sin}⁡x-5\\cdot 2x+0 \\\\  & =-4\\operatorname{sin}⁡x-10x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570758 :knowledge-point/_questions [{:db/id #edb/ref 17592186059675 :knowledge-point/id #uuid "0de0627b-2568-5c02-8928-d14344df5a2f" :knowledge-point/title "Finding the Derivative of an Expression With Sine or Cosine Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "105d29a7-9a34-55b8-a94b-995812557ef4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x}{2}-11" :db/id #edb/ref 17592186570154} {:answer/id #uuid "42d8d3f1-b54f-5e7f-8d1d-0466a7bd27d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186570238} {:answer/id #uuid "56c27e64-4407-52e3-8447-a30f78f42be9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡x+11" :db/id #edb/ref 17592186570278} {:answer/id #uuid "9c379984-86b2-5382-ac5b-36f81eb2c38d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186570401} {:answer/id #uuid "ca8d5c20-cb81-5101-81a2-893618e67ba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{cos}⁡x}{4}" :db/id #edb/ref 17592186570476}] :answer-field/correct {:answer/id #uuid "9c379984-86b2-5382-ac5b-36f81eb2c38d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186570401} :answer-field/id #uuid "182c4a26-9e39-59c6-8813-cab2a16a0730" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186570587}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "94bfc6e6-a43f-5249-b046-4e95dd242cc6" :question/math-academy-id "q-30988" :question/problem "Find the derivative of $y=\\frac{\\operatorname{sin}⁡x}{2}-11.$" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡x)=\\operatorname{cos}⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{sin}⁡x}{2}-11) \\\\  & =\\frac{\\operatorname{cos}⁡x}{2}-0 \\\\  & =\\frac{\\operatorname{cos}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186570742 :knowledge-point/_questions [{:db/id #edb/ref 17592186059676 :knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47b44d8b-ac69-5abc-8c54-02ef7744ad3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186570252}] :answer-field/correct {:answer/id #uuid "47b44d8b-ac69-5abc-8c54-02ef7744ad3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186570252} :answer-field/id #uuid "7b17d67a-7d81-5cb0-bd55-92bce57573b5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186570634}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "75deedc5-439f-5c0b-9ed9-ea7f29313f69" :question/math-academy-id "q-341826" :question/problem "Calculate the instantaneous rate of change of the function $f(x)=4x-\\operatorname{tan}⁡x$ when $x=0.$\n\n${f}^{′}(0)=$\n{{field-1}}" :question/worked-solution "The instantaneous rate of change when $x=0$ is given by the value of the derivative ${f}^{′}(x)$ at $x=0.$ \n\nFirst, we compute the derivative, using the fact that $\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x)={sec}^{2}⁡x$ and $\\frac{\\text{d}}{\\text{d}x}(4x)=4.$ We get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4x-\\operatorname{tan}⁡x) \\\\  & =4-{sec}^{2}⁡x.\\end{aligned}\n$$\n\nEvaluating at $x=0,$ we get\n\n$$\n\\begin{aligned}{f}^{′}(0) & =4-{sec}^{2}⁡(0) \\\\  & =4-{(\\frac{1}{\\operatorname{cos}⁡(0)})}^{2} \\\\  & =4-{(\\frac{1}{1})}^{2}=4-1 \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change is $3.$"}] [{:db/id #edb/ref 17592186570762 :knowledge-point/_questions [{:db/id #edb/ref 17592186059676 :knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4316991d-1d98-5261-b089-c06f2c337224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186570239}] :answer-field/correct {:answer/id #uuid "4316991d-1d98-5261-b089-c06f2c337224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186570239} :answer-field/id #uuid "847db2ec-c888-5238-a1ba-407a230ec903" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186570636}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9b9f5ad2-fc37-5cb1-8895-57f56e806362" :question/math-academy-id "q-341876" :question/problem "Calculate the instantaneous rate of change of the function $f(x)=6x-\\operatorname{tan}⁡x$ when $x=\\frac{\\pi }{3}.$\n\n${f}^{′}(\\frac{\\pi }{3})=$\n{{field-1}}" :question/worked-solution "The instantaneous rate of change when $x=\\frac{\\pi }{3}$ is given by the value of the derivative ${f}^{′}(x)$ at $x=\\frac{\\pi }{3}.$ \n\nFirst, we compute the derivative, using the fact that $\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x)={sec}^{2}⁡x$ and $\\frac{\\text{d}}{\\text{d}x}(6x)=6.$ We get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(6x-\\operatorname{tan}⁡x) \\\\  & =6-{sec}^{2}⁡x.\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi }{3},$ we get\n\n$$\n\\begin{aligned}{f}^{′}(\\frac{\\pi }{3}) & =6-{sec}^{2}⁡(\\frac{\\pi }{3}) \\\\  & =6-{(\\frac{1}{\\operatorname{cos}⁡(\\frac{\\pi }{3})})}^{2} \\\\  & =6-{(\\frac{1}{1/2})}^{2} \\\\  & =6-4 \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change is $2.$"}] [{:db/id #edb/ref 17592186570750 :knowledge-point/_questions [{:db/id #edb/ref 17592186059675 :knowledge-point/id #uuid "0de0627b-2568-5c02-8928-d14344df5a2f" :knowledge-point/title "Finding the Derivative of an Expression With Sine or Cosine Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e87bb41-37ec-51b0-90c2-386893952022" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{cos}⁡x}{3}+{x}^{2}" :db/id #edb/ref 17592186570145} {:answer/id #uuid "64fa19fb-c747-568b-ad30-d38992d14797" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{cos}⁡x+{x}^{2}}{3}" :db/id #edb/ref 17592186570301} {:answer/id #uuid "6d432d7e-6e29-58fd-8eee-cb46ac6ac7bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{cos}⁡x}{3}+3{x}^{2}" :db/id #edb/ref 17592186570317} {:answer/id #uuid "e3c2ac7d-c4a5-557b-a3d6-dcd10f508d48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{cos}⁡x-{x}^{2}}{3}" :db/id #edb/ref 17592186570522} {:answer/id #uuid "ef209f1c-45b2-5eb0-a0b8-6f5c8266e247" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2\\operatorname{cos}⁡x}{3}+{x}^{2}" :db/id #edb/ref 17592186570543}] :answer-field/correct {:answer/id #uuid "0e87bb41-37ec-51b0-90c2-386893952022" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{cos}⁡x}{3}+{x}^{2}" :db/id #edb/ref 17592186570145} :answer-field/id #uuid "f4175479-f256-5ab9-9cfb-a0e3e88e6fa3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186570691}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "83b5db67-0cfd-59f0-8254-1d32998685fc" :question/math-academy-id "q-47984" :question/problem "Find the derivative of $y=\\frac{2\\operatorname{sin}⁡x}{3}+\\frac{{x}^{3}}{3}.$" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡x)=\\operatorname{cos}⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2\\operatorname{sin}⁡x}{3}+\\frac{{x}^{3}}{3}) \\\\  & =\\frac{2\\operatorname{cos}⁡x}{3}+\\frac{3{x}^{2}}{3} \\\\  & =\\frac{2\\operatorname{cos}⁡x}{3}+{x}^{2}.\\end{aligned}\n$$"}]}
