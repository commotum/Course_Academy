#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186088728} :activity/id #uuid "21e3df28-881c-51eb-8c4e-abefad2477c8" :activity/scope {:db/id #edb/ref 17592186049660 :topic/id #uuid "08e2d71b-c870-531a-9550-54bbf2ed62c2" :topic/math-academy-id 817} :activity/steps [{:db/id #edb/ref 17592186088728 :step/content {:db/id #edb/ref 17592186088868 :tutorial/content "Adding a value to $y=2^x$ will **translate** (shift) the exponential function up or down the $y$-axis. \n\nFor instance, adding $3$ to $y=2^x$ will move each point on the exponential function $3$ units up.\n\n![](images/c8/c89fd5fdcdc3773143a5f14ecb20f5bd2917bce20ece18a7dc70631bf358a0e8.png)\n\nNote the following points:\n\n- The $y$-intercept $(0,1)$ has moved up $3$ units to the point $(0,4).$\n\n- The horizontal asymptote $y=0$ has moved up $3$ units to $y=3.$\n\nAs a second example, let's consider the function $y=2^x-3.$ In this case, the graph of $y=2^x$ is shifted *down* by $3$ units.\n\n![](images/84/84987b3e9138a2e7e8afe70a7aa28a1cd81e081033aa2a766773e63cb8f41da5.png)" :tutorial/id #uuid "4c549a4f-8132-5b94-bae2-990ac8abaf08" :tutorial/math-academy-id 1542 :tutorial/title "Introduction"} :step/id #uuid "93d50159-32bd-555f-a60b-03d9216f91b0" :step/math-academy-id 3924 :step/next {:db/id #edb/ref 17592186088729}} {:db/id #edb/ref 17592186088729 :step/content {:db/id #edb/ref 17592186087821 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087425 :question/id #uuid "8ab1df94-0c4f-5720-a9b6-939dba0ab9c6" :question/math-academy-id "e-1219"} :knowledge-point/id #uuid "dd63cb30-a236-546e-82ac-08bce09c88f7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048789}] :knowledge-point/question-generator {:db/id #edb/ref 17592186513491} :knowledge-point/questions [{:db/id #edb/ref 17592186088107} {:db/id #edb/ref 17592186088108} {:db/id #edb/ref 17592186284654} {:db/id #edb/ref 17592186284656} {:db/id #edb/ref 17592186292681} {:db/id #edb/ref 17592186390514} {:db/id #edb/ref 17592186390521} {:db/id #edb/ref 17592186513442} {:db/id #edb/ref 17592186513446} {:db/id #edb/ref 17592186513448} {:db/id #edb/ref 17592186513449} {:db/id #edb/ref 17592186513451} {:db/id #edb/ref 17592186513457} {:db/id #edb/ref 17592186513471} {:db/id #edb/ref 17592186513475} {:db/id #edb/ref 17592186513483} {:db/id #edb/ref 17592186513488}] :knowledge-point/title "Identifying a Vertically Shifted Exponential Growth Curve"} :step/id #uuid "354545d2-1dac-5987-aeab-9e3a6beb6acf" :step/math-academy-id 3925 :step/next {:db/id #edb/ref 17592186088730}} {:db/id #edb/ref 17592186088730 :step/content {:db/id #edb/ref 17592186087822 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087426 :question/id #uuid "65c814f8-df2f-549d-9467-c6dda6890bb3" :question/math-academy-id "e-1220"} :knowledge-point/id #uuid "79daf9dd-814d-562b-b3bc-b066bd2dfb90" :knowledge-point/question-generator {:db/id #edb/ref 17592186513349} :knowledge-point/questions [{:db/id #edb/ref 17592186088113} {:db/id #edb/ref 17592186088291} {:db/id #edb/ref 17592186284657} {:db/id #edb/ref 17592186292680} {:db/id #edb/ref 17592186362385} {:db/id #edb/ref 17592186362386} {:db/id #edb/ref 17592186403550} {:db/id #edb/ref 17592186403557} {:db/id #edb/ref 17592186513322} {:db/id #edb/ref 17592186513325} {:db/id #edb/ref 17592186513327} {:db/id #edb/ref 17592186513339} {:db/id #edb/ref 17592186513343}] :knowledge-point/title "Identifying the Shift Applied to an Exponential Growth Curve"} :step/id #uuid "f98fbdc8-9f48-5836-b35a-2573f78bdfc8" :step/math-academy-id 3928 :step/next {:db/id #edb/ref 17592186088731}} {:db/id #edb/ref 17592186088731 :step/content {:db/id #edb/ref 17592186088869 :tutorial/content "When an exponential growth function is vertically shifted *and* stretched, we apply the stretch first and the shift second.\n\nFor example, to plot the function $y=2(4^x)+3,$ we start by plotting the graph of $y=2(4^x).$ Stretching $y=4^x$ by a factor of $2$ moves the $y$-intercept from $(0,1)$ to $(0,2),$ but the horizontal asymptote stays at $y=0.$\n\n![](images/5d/5d6bdd7aa3290567fc6a64747ea605970fcb1d0f05ba06907134e7fc0a3e290b.png)\n\nThen, to plot the graph of $y=2(4^x)+3,$ we take the graph of $y=2(4^x)$ and shift it $3$ units up. The $y$-intercept moves from $(0,2)$ to $(0,5),$ and the horizontal asymptote moves from $y=0$ to $y=3.$\n\n![](images/19/191a51b0b4b7da7c6744240f36786d55b8b525356b8d0300750fb48af5a2f06a.png)" :tutorial/id #uuid "d208d68e-2371-5f6f-ac25-d2dc8486e293" :tutorial/math-academy-id 1543 :tutorial/title "Combining Vertical Shift and Vertical Stretch"} :step/id #uuid "533d1530-e852-5412-8a94-36e4244be365" :step/math-academy-id 3930 :step/next {:db/id #edb/ref 17592186088732}} {:db/id #edb/ref 17592186088732 :step/content {:db/id #edb/ref 17592186087823 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087427 :question/id #uuid "f73207f4-4661-55f1-acfb-cc5fe6ba9316" :question/math-academy-id "e-1221"} :knowledge-point/id #uuid "40eeb5a8-3ffe-54d2-b263-f2b1c41fed93" :knowledge-point/question-generator {:db/id #edb/ref 17592186513420} :knowledge-point/questions [{:db/id #edb/ref 17592186088117} {:db/id #edb/ref 17592186088126} {:db/id #edb/ref 17592186284658} {:db/id #edb/ref 17592186297279} {:db/id #edb/ref 17592186297305} {:db/id #edb/ref 17592186338914} {:db/id #edb/ref 17592186513368} {:db/id #edb/ref 17592186513370} {:db/id #edb/ref 17592186513372} {:db/id #edb/ref 17592186513381} {:db/id #edb/ref 17592186513391} {:db/id #edb/ref 17592186513397} {:db/id #edb/ref 17592186513405} {:db/id #edb/ref 17592186513408} {:db/id #edb/ref 17592186513418} {:db/id #edb/ref 17592186513419}] :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Growth Curve"} :step/id #uuid "e32a8e49-a685-502f-b6aa-154562d2bef8" :step/math-academy-id 3931 :step/next {:db/id #edb/ref 17592186088733}} {:db/id #edb/ref 17592186088733 :step/content {:db/id #edb/ref 17592186087824 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087428 :question/id #uuid "62f7d6e1-61ec-5f3d-8cdd-4da0c90c7ccf" :question/math-academy-id "e-1222"} :knowledge-point/id #uuid "0b70a3b7-90a7-5a83-b71f-304f7f25c4ef" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048725}] :knowledge-point/question-generator {:db/id #edb/ref 17592186513313} :knowledge-point/questions [{:db/id #edb/ref 17592186088061} {:db/id #edb/ref 17592186088062} {:db/id #edb/ref 17592186297230} {:db/id #edb/ref 17592186339103} {:db/id #edb/ref 17592186339109} {:db/id #edb/ref 17592186339112} {:db/id #edb/ref 17592186362387} {:db/id #edb/ref 17592186513251} {:db/id #edb/ref 17592186513252} {:db/id #edb/ref 17592186513255} {:db/id #edb/ref 17592186513256} {:db/id #edb/ref 17592186513261} {:db/id #edb/ref 17592186513266} {:db/id #edb/ref 17592186513299} {:db/id #edb/ref 17592186513308} {:db/id #edb/ref 17592186513310} {:db/id #edb/ref 17592186513311}] :knowledge-point/title "Identifying the Shift and Stretch Applied to an Exponential Growth Curve"} :step/id #uuid "72a62e03-ddf9-557c-8ed7-f6d22f5d752f" :step/math-academy-id 3933}] :activity/title "Vertical Translations of Exponential Growth Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186087901}]}
