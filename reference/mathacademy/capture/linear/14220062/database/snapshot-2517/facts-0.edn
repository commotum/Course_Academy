46872303988d034183b634286da680fcd2245f3fe063a300efe.png" #edb/ref 17592186045417] [17592186085293 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186085293 #edb/ref 1083 #uuid "d2b8e4b9-7a4c-571e-9c28-d33267dcdb67" #edb/ref 17592186045417] [17592186085294 #edb/ref 1080 "images/4f/4fe9f375fc6adb646e282f7b62171b9df5d564194dfcde3d07210a2a74a11ca1.png" #edb/ref 17592186045417] [17592186085294 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186085294 #edb/ref 1083 #uuid "2519e987-ba87-5028-bb61-2b4887e0e5b1" #edb/ref 17592186045417] [17592186085295 #edb/ref 1080 "images/16/16076a1aa92ffd34563f3c69d55fc58a3f6d8da69352c1aeccb114d107371968.png" #edb/ref 17592186045417] [17592186085295 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186085295 #edb/ref 1083 #uuid "6fd90e75-f6a8-53ee-b54d-669c0526af1d" #edb/ref 17592186045417] [17592186087425 #edb/ref 1069 "e-1219" #edb/ref 17592186045417] [17592186087425 #edb/ref 1071 "Plot the graph of $y=4^{x}-1.$" #edb/ref 17592186045417] [17592186087425 #edb/ref 1072 #uuid "8ab1df94-0c4f-5720-a9b6-939dba0ab9c6" #edb/ref 17592186045417] [17592186087425 #edb/ref 1074 "First, we plot the graph of $y=4^{x}{:}$\n\n![](images/df/dfac014ecedaa03a46048b4729ddfa60e7a3776322d0b9ea19035fbcd24bf85b.png)\n\nTo sketch the graph of $y=4^x-1,$ we take the graph of $y=4^x$ and shift it $1$ unit down. The $y$-intercept moves from $(0,1)$ to $(0,0),$ and the horizontal asymptote moves from $y=0$ to $y=-1.$\n\n![](images/ee/eef6c5dd67c683ccd0826caa9760fa240be973f8debd29b41d463f6184a00620.png)" #edb/ref 17592186045417] [17592186087426 #edb/ref 1069 "e-1220" #edb/ref 17592186045417] [17592186087426 #edb/ref 1071 "The graph below shows the curve $y=3^{x}+c$ . What is the value of $c?$\n\n![](images/00/00264eb90dbaa2c50fdd626d61292c0428fd0bbbd03a6d051353598450b4ad89.png)" #edb/ref 17592186045417] [17592186087426 #edb/ref 1072 #uuid "65c814f8-df2f-549d-9467-c6dda6890bb3" #edb/ref 17592186045417] [17592186087426 #edb/ref 1074 "The horizontal asymptote of $y=3^x$ is $y=0.$ The vertical translation $y=3^x+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=2.$ Therefore, $c=2.$" #edb/ref 17592186045417] [17592186087427 #edb/ref 1069 "e-1221" #edb/ref 17592186045417] [17592186087427 #edb/ref 1071 "Plot the graph of $y=5(3^x)-3.$" #edb/ref 17592186045417] [17592186087427 #edb/ref 1072 #uuid "f73207f4-4661-55f1-acfb-cc5fe6ba9316" #edb/ref 17592186045417] [17592186087427 #edb/ref 1074 "First, we plot the graph of $y=3^{x}\\mathbin{:}$\n\n![](images/1c/1cd695e6f1fab35a692fde9003d452862db33a894c23657eb87f8d773de8cbb9.png)\n\nNext, we plot the graph of $y=5(3^x).$ To do this, we scale the graph above by a factor of $5.$ The $y$-intercept moves from $(0,1)$ to $(0,5),$ but the horizontal asymptote stays at $y=0.$\n\n![](images/1c/1c92ea5f3cbfd40bd0dc384b152f6166c27400dbedd93a9c8333195950e7f9c3.png)\n\nFinally, we plot the graph of $y=5(3^x)-3.$ To do this, we shift the above graph $3$ units down. The $y$-intercept moves from $(0,5)$ to $(0,2),$ and the horizontal asymptote moves from $y=0$ to $y=-3.$\n\n![](images/d8/d8e8cdccd58a9f1f21c8c2bf0a4a8c08e9c263c4fe91cc92e2bee334de057116.png)" #edb/ref 17592186045417] [17592186087428 #edb/ref 1069 "e-1222" #edb/ref 17592186045417] [17592186087428 #edb/ref 1071 "The graph below shows $y=k(6^{x})+c.$ Determine the values of $k$ and $c$ and find the equation of the curve.\n\n![](images/de/deb7e20658882229a3653f4058c787bf2a5c4a26c5f2982406a2dba34c2d5846.png)" #edb/ref 17592186045417] [17592186087428 #edb/ref 1072 #uuid "62f7d6e1-61ec-5f3d-8cdd-4da0c90c7ccf" #edb/ref 17592186045417] [17592186087428 #edb/ref 1074 "The horizontal asymptote of the curve $y=k(6^{x})+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=4$, so $c=4.$\n\nTherefore, our function takes the form\n\n$$\ny=k(6^{x})+4.\n$$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,6),$ so we substitute $x=0$ and $y=6$ into the function and solve for $k\\mathbin{:}$\n\n$$\n\\begin{aligned}y & =k({6}^{x})+4 \\\\ 6 & =k({6}^{0})+4 \\\\ 6 & =k(1)+4 \\\\ 6 & =k+4 \\\\ 2 & =k\\end{aligned}\n$$\n\nTherefore, the curve is $y=2(6^{x})+4.$" #edb/ref 17592186045417] [17592186087821 #edb/ref 1037 #edb/ref 17592186048789 #edb/ref 17592186045417] [17592186087821 #edb/ref 1038 #edb/ref 17592186088107 #edb/ref 17592186045417] [17592186087821 #edb/ref 1038 #edb/ref 17592186088108 #edb/ref 17592186045417] [17592186087821 #edb/ref 1038 #edb/ref 17592186284654 #edb/ref 17592186045417] [17592186087821 #edb/ref 1038 #edb/ref 17592186284656 #edb/ref 17592186045417] [17592186087821 #edb/ref 1038 #edb/ref 17592186292681 #edb/ref 17592186045417] [17592186087821 #edb/ref 1038 #edb/ref 17592186390514 #edb/ref 17592186045417] [17592186087821 #edb/ref 1038 #edb/ref 17592186390521 #edb/ref 17592186045417] [17592186087821 #edb/ref 1038 #edb/ref 17592186513442 #edb/ref 17592186045443] [17592186087821 #edb/ref 1038 #edb/ref 17592186513446 #edb/ref 17592186045443] [17592186087821 #edb/ref 1038 #edb/ref 17592186513448 #edb/ref 17592186045443] [17592186087821 #edb/ref 1038 #edb/ref 17592186513449 #edb/ref 17592186045443] [17592186087821 #edb/ref 1038 #edb/ref 17592186513451 #edb/ref 17592186045443] [17592186087821 #edb/ref 1038 #edb/ref 17592186513457 #edb/ref 17592186045443] [17592186087821 #edb/ref 1038 #edb/ref 17592186513471 #edb/ref 17592186045443] [17592186087821 #edb/ref 1038 #edb/ref 17592186513475 #edb/ref 17592186045443] [17592186087821 #edb/ref 1038 #edb/ref 17592186513483 #edb/ref 17592186045443] [17592186087821 #edb/ref 1038 #edb/ref 17592186513488 #edb/ref 17592186045443] [17592186087821 #edb/ref 1039 "Identifying a Vertically Shifted Exponential Growth Curve" #edb/ref 17592186045417] [17592186087821 #edb/ref 1040 #edb/ref 17592186513491 #edb/ref 17592186045443] [17592186087821 #edb/ref 1041 #edb/ref 17592186087425 #edb/ref 175921860