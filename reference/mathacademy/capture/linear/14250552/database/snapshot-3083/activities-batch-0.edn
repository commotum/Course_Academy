![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-intercept moves from ![](images/42/42f562f132f08838fe095cdeb883c38dd65e0d77828f65f73d783980c52f34ec.svg) to ![](images/e8/e8c4c8598a8228afb25cbf13c034e2fe234393f9b9c0dfde8be1726b4fc79a8e.svg)" :tutorial/id #uuid "78c17e05-8ef3-58fd-a9ea-a2fc04f4bd83" :tutorial/math-academy-id 1858 :tutorial/title "Vertical Compression"} :step/id #uuid "254e2522-a3c6-57f8-9ac1-0e813acdc6d7" :step/math-academy-id 516458 :step/next {:db/id #edb/ref 17592186111708}} {:db/id #edb/ref 17592186111708 :step/content {:db/id #edb/ref 17592186110735 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110312 :question/id #uuid "3661675e-e7da-5834-97cf-017e4e084275" :question/math-academy-id "e-1217"} :knowledge-point/id #uuid "f8a6ac29-44ee-5305-be7a-41f9ae742756" :knowledge-point/questions [{:db/id #edb/ref 17592186110930} {:db/id #edb/ref 17592186111100}] :knowledge-point/title "Plotting a Vertically Compressed Exponential Growth Function"} :step/id #uuid "fbd6d68b-40b3-5cb7-afa4-487f4a8e9f03" :step/math-academy-id 516459}] :activity/title "Graphing Exponential Growth Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110875}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186570818} :activity/id #uuid "d5568308-bda7-5799-8026-2f5cbd870b6e" :activity/scope {:db/id #edb/ref 17592186048789 :topic/id #uuid "bf1964cf-beba-5911-abd1-76470578e4aa" :topic/math-academy-id 1530} :activity/steps [{:db/id #edb/ref 17592186570818 :step/content {:db/id #edb/ref 17592186570696 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3118dc30-430b-5641-935f-ec4dd4e6c1d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.5" :db/id #edb/ref 17592186570208} {:answer/id #uuid "525e884d-2c1b-5eed-a6de-01b31fd57b53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.5" :db/id #edb/ref 17592186570270} {:answer/id #uuid "71905937-3f2a-58cd-8d8a-0bf16a4067cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.5" :db/id #edb/ref 17592186570326} {:answer/id #uuid "a6023041-ba47-52db-be44-55cee271cb2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186570417} {:answer/id #uuid "ae03e523-d064-5bc8-8d5a-b59524369b9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186570435}] :answer-field/correct {:db/id #edb/ref 17592186570326} :answer-field/id #uuid "19b2167b-179a-512d-a243-20e811f23fa5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186570588}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0355a074-20a2-5164-b4c8-0cc8e981bffa" :question/math-academy-id "q-7234" :question/problem "![](images/2c/2c1790cb306a749737594f994f6893d0146d5f2ed2458dc9e50ff9f4278475d7.png)\n\nThe graph above shows $y=k({3}^{x}).$ What is the value of the constant $k?$" :question/worked-solution "To plot the graph of $y=k({3}^{x})$ we take the graph of $y={3}^{x}$ and stretch it vertically by a scale factor of  $k.$ Under the action of this transformation, the $y$-intercept is mapped from $(0,1)$ to $(0,k)$\n\nComparing the point $(0,1.5)$ on the graph to $(0,k),$ we see that we must have $k=1.5.$"} :step/id #uuid "50ca0270-94b5-532f-bb51-0054a50b67eb" :step/next {:db/id #edb/ref 17592186570867}} {:db/id #edb/ref 17592186570820 :step/content {:db/id #edb/ref 17592186570744 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "019635f7-41ec-5c33-956d-3525d5f504ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x>0" :db/id #edb/ref 17592186570123} {:answer/id #uuid "4efe46e0-8039-5028-9861-5bd36a2bf5e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x<0" :db/id #edb/ref 17592186570265} {:answer/id #uuid "bc3c2323-bf20-57d6-8203-ae1d1f0becdf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\infty <x<\\infty" :db/id #edb/ref 17592186570456} {:answer/id #uuid "da0adfae-34a6-5d88-a719-1f51cf3b61e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x>10" :db/id #edb/ref 17592186570507} {:answer/id #uuid "f09c79c9-533f-56c9-9850-3e6d0f52fcf8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x<10" :db/id #edb/ref 17592186570547}] :answer-field/correct {:db/id #edb/ref 17592186570456} :answer-field/id #uuid "ffea6c0c-7929-576d-9b9a-48a5f98cb7b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186570695}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7782f625-0fd2-5a62-8065-db81e75a2462" :question/math-academy-id "q-28931" :question/problem "What's the domain of the function $f(x)={10}^{x}?$" :question/worked-solution "Let's start by recalling the graph of $y={10}^{x}:$\n\n![](images/37/378d8bc3c7dadc1915e4db903147793b37fcdb4e1ed74481e14ca3f2ca7f1e18.png)\n\nFrom the graph, we see that the domain is $-\\infty <x<\\infty .$"} :step/id #uuid "52733f46-8218-5aeb-b8b9-bbaf5b7ced19"} {:db/id #edb/ref 17592186570867 :step/content {:db/id #edb/ref 17592186570703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60fabe23-e9a4-511d-a2ac-e20dfc36269c" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/30/30a6d96c1bf2138e93cb1bdf2b162091c592dcae6aed8ef852e0d5eb382fb699.png" :db/id #edb/ref 17592186570294} {:answer/id #uuid "7b772bde-4db4-5297-93d4-4e70a27f4a4e" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a9/a9488240fef69008fc4b2611c0fd0ef77616f1af9b0ffe668b4ac310959832b2.png" :db/id #edb/ref 17592186570344} {:answer/id #uuid "920f3fb1-3e7b-5542-a5a0-f6b4897b1c53" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/5d/5db9ec3cf9d8597d498b315ba38d28042940d66e08ce677feccfda99464460a9.png" :db/id #edb/ref 17592186570381} {:answer/id #uuid "c239bd0b-d1fd-5b79-b1ba-c5658d4f895b" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/7f/7f3210b5790d2a553bf0c12cc57f1f6a9350c6203b75bdf14dd674bfc036fa4e.png" :db/id #edb/ref 17592186570464} {:answer/id #uuid "fe984f0e-babe-53d8-9142-84c87b1f2bf9" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/0f/0f667cef87ff35e6012a9b059aec786a7175c49b8e5d5ee473f1648e42638394.png" :db/id #edb/ref 17592186570575}] :answer-field/correct {:db/id #edb/ref 17592186570294} :answer-field/id #uuid "da254e7c-1de1-5549-93d9-35f0de0913ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186570680}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "14efb3d8-c222-5e12-b8b9-d5a90aefed95" :question/math-academy-id "q-26883" :question/problem "Which of the following represents the graph of $y=6({5}^{x})?$" :question/worked-solution "First we plot the graph of $y={5}^{x}$:\n\n![](images/c0/c0bc33204b0cc8590f93529a76d4dd785fc52317505fcdee4a03022315da5333.png)\n\nThen, we scale this graph vertically by a factor of $6.$ The $y$-intercept becomes $(0,6),$ and the resulting graph is as follows:\n\n![](images/11/11a8b1a124812c91be270a728ce07c3c2a9ea9f5b7bddd351ceb7d7dec7970f7.png)"} :step/id #uuid "e4f415bb-254a-5692-963e-82a207e52a4a" :step/next {:db/id #edb/ref 17592186570820}}] :activity/title "Graphing Exponential Growth Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186570115}]}
