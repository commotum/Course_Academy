s [{:answer/id #uuid "5224e6a0-1eae-5556-a2d3-9d3dd872f527" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 9 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186416998} {:answer/id #uuid "5fa36f3b-bf80-5db3-b764-a0218c369342" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}9 & 0 \\\\ 0 & 9\\end{aligned}]" :db/id #edb/ref 17592186417000} {:answer/id #uuid "a2ff33c1-3f15-529f-84b2-061fce0b1530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 9\\end{aligned}]" :db/id #edb/ref 17592186417006} {:answer/id #uuid "a4115946-4c02-5432-b8f2-66ab9b1555c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186417007} {:answer/id #uuid "abb8b95a-5b60-56cf-a1e8-1a33cc205b9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}9 & 1 \\\\ 0 & 9\\end{aligned}]" :db/id #edb/ref 17592186417008}] :answer-field/correct {:answer/id #uuid "5fa36f3b-bf80-5db3-b764-a0218c369342" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}9 & 0 \\\\ 0 & 9\\end{aligned}]" :db/id #edb/ref 17592186417000} :answer-field/id #uuid "9b283720-eadb-54f9-b376-5d69b0511f8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417015}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "62c396bc-091d-5afa-9941-7c10127fae8a" :question/math-academy-id "q-112447" :question/problem "Find the Jordan canonical form of the matrix \n$A=[\\begin{aligned}9 & 0 \\\\ 0 & 9\\end{aligned}].$" :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix. \n\nNotice that $A$ is a scalar matrix, which means that it is already in Jordan canonical form. Therefore, it has a single (repeated) eigenvalue $\\lambda =9,$ and\n\n$$\nJ=A=9I=[\\begin{aligned}9 & 0 \\\\ 0 & 9\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186417020 :knowledge-point/_questions [{:db/id #edb/ref 17592186176008 :knowledge-point/id #uuid "b629bead-e64a-5e73-ae42-80d4ebb3762b" :knowledge-point/title "Finding a Jordan Canonical Form of a 2x2 Matrix With Only One Eigenvalue"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00cd8275-45be-5ddc-b8ef-e32e340faed8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 & 0 \\\\ 0 & 8\\end{aligned}]" :db/id #edb/ref 17592186416989} {:answer/id #uuid "116ccc33-25a8-5801-9ef8-97c8196420e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186416991} {:answer/id #uuid "345fef9e-2d68-5276-b5a8-66f4a893391e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 & 1 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186416996} {:answer/id #uuid "87d699c9-48e9-5acb-be99-b2dbb7b37645" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186417004} {:answer/id #uuid "f4cf0c9f-9400-57d8-bda0-74f00f45a5f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 & 1 \\\\ 0 & 8\\end{aligned}]" :db/id #edb/ref 17592186417013}] :answer-field/correct {:answer/id #uuid "f4cf0c9f-9400-57d8-bda0-74f00f45a5f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 & 1 \\\\ 0 & 8\\end{aligned}]" :db/id #edb/ref 17592186417013} :answer-field/id #uuid "f6626528-e08c-559b-9616-d45c9d6758c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417018}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "69022431-229c-5853-9ee3-a4c4ae931331" :question/math-academy-id "q-112473" :question/problem "Find the Jordan canonical form of the matrix \n$A=[\\begin{aligned}7 & -1 \\\\ 1 & 9\\end{aligned}].$" :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix. \n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}|\\begin{aligned}7-\\lambda  & -1 \\\\ 1 & 9-\\lambda \\end{aligned}| & =0 \\\\ (7-\\lambda )(9-\\lambda )-(-1)\\cdot 1 & =0 \\\\ {\\lambda }^{2}-16\\lambda +64 & =0 \\\\ (\\lambda -8)(\\lambda -8) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=8.$ \n\nSince $A$ is not a scalar matrix, we conclude that $A$ is not diagonalizable, and its Jordan canonical form is\n\n$$\nJ={J}_{2}(8)=[\\begin{aligned}8 & 1 \\\\ 0 & 8\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186417021 :knowledge-point/_questions [{:db/id #edb/ref 17592186176008 :knowledge-point/id #uuid "b629bead-e64a-5e73-ae42-80d4ebb3762b" :knowledge-point/title "Finding a Jordan Canonical Form of a 2x2 Matrix With Only One Eigenvalue"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ef2032d-530d-50c1-908e-9d91e9d7cad4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186416990} {:answer/id #uuid "1fe7266d-5234-5afc-ad8b-4d38abe1dc8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 & 1 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186416992} {:answer/id #uuid "2997e2ff-2037-5552-b0bd-698795cf62e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 & 1 \\\\ 0 & -6\\end{aligned}]" :db/id #edb/ref 17592186416993} {:answer/id #uuid "a1e158f2-e157-5bef-b2f6-497683140d4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186417005} {:answer/id #uuid "dda58d8b-c65f-5bb6-910b-6e1345e0dd12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 & 0 \\\\ 0 & -6\\end{aligned}]" :db/id #edb/ref 17592186417011}] :answer-field/correct {:answer/id #uuid "2997e2ff-2037-5552-b0bd-698795cf62e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 & 1 \\\\ 0 & -6\\end{aligned}]" :db/id #edb/ref 17592186416993} :answer-field/id #uuid "9d46200f-1674-5061-b28b-bbacea4c478e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417016}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac392660-8c5c-5e68-838e-b85d4459418a" :question/math-academy-id "q-112476" :question/problem "Find the Jordan canonical form of the matrix \n$A=[\\begin{aligned}-10 & -2 \\\\ 8 & -2\\end{aligned}].$" :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix.\n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}|\\begin{aligned}-10-\\lambda  & -2 \\\\ 8 & -2-\\lambda \\end{aligned}| & =0 \\\\ (-10-\\lambda )(-2-\\lambda )-(-2)\\cdot 8 & =0 \\\\ {\\lambda }^{2}+12\\lambda +36 & =0 \\\\ (\\lambda +6)(\\lambda +6) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=-6.$ \n\nSince $A$ is not a scalar matrix, we conclude that $A$ is not diagonalizable, and its Jordan canonical form is\n\n$$\nJ={J}_{2}(-6)=[\\begin{aligned}-6 & 1 \\\\ 0 & -6\\end{aligned}].\n$$"}]}
