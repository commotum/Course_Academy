#{[{:db/id #edb/ref 17592186176224 :knowledge-point/_questions [{:db/id #edb/ref 17592186176008 :knowledge-point/id #uuid "b629bead-e64a-5e73-ae42-80d4ebb3762b" :knowledge-point/title "Finding a Jordan Canonical Form of a 2x2 Matrix With Only One Eigenvalue"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e1f42a9-2410-5d00-a50f-5c6a17763473" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186416994} {:answer/id #uuid "31f893f9-5f3d-577a-921d-33855e0c2e6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 1 \\\\ 0 & 3\\end{aligned}]" :db/id #edb/ref 17592186416995} {:answer/id #uuid "4d46be50-d6db-513b-9ef7-cbc8edd3addb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186416997} {:answer/id #uuid "bc499839-44bb-51b3-bb95-1413004e1a12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186417009} {:answer/id #uuid "ce04ef35-1259-5b77-8dbd-404063317f6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 0 \\\\ 0 & 3\\end{aligned}]" :db/id #edb/ref 17592186417010}] :answer-field/correct {:answer/id #uuid "31f893f9-5f3d-577a-921d-33855e0c2e6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 1 \\\\ 0 & 3\\end{aligned}]" :db/id #edb/ref 17592186416995} :answer-field/id #uuid "4b4a2d2b-0aea-53f7-a0ec-6d74774ae6df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417014}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8231d418-c039-5ff1-a299-022f1329d9d4" :question/math-academy-id "q-108613" :question/problem "Find the Jordan canonical form of the matrix \n$A=[\\begin{aligned}4 & 1 \\\\ -1 & 2\\end{aligned}].$" :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix. \n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}|\\begin{aligned}4-\\lambda  & 1 \\\\ -1 & 2-\\lambda \\end{aligned}| & =0 \\\\ (4-\\lambda )(2-\\lambda )-1\\cdot (-1) & =0 \\\\ {\\lambda }^{2}-6\\lambda +9 & =0 \\\\ (\\lambda -3)(\\lambda -3) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=3.$ \n\nSince $A$ is not a scalar matrix, we conclude that $A$ is not diagonalizable, and its Jordan canonical form is\n\n$$\nJ={J}_{2}(3)=[\\begin{aligned}3 & 1 \\\\ 0 & 3\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186417022 :knowledge-point/_questions [{:db/id #edb/ref 17592186176009 :knowledge-point/id #uuid "511398e8-780e-57b2-8f1b-092e9f6cca45" :knowledge-point/title "Finding a Jordan Canonical Form of a 2x2 Scalar Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "595ce512-9a9b-5ca3-aac8-d272314ba843" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -1 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186416999} {:answer/id #uuid "6283ecd1-90b2-5044-ab8a-28bdf364d373" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186417001} {:answer/id #uuid "646b5b75-0908-572e-b93c-5c7ea9d9a751" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}]" :d