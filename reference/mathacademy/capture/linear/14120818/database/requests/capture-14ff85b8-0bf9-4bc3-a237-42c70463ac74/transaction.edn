ned}-1 & 0 \\\\ 0 & -1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f2fa2805-77b1-599c-986c-f94986d2e904"] :db/ensure [:question/validate]} {:db/id "answer-field-f2fa2805-77b1-599c-986c-f94986d2e904" :answer-field/id #uuid "f2fa2805-77b1-599c-986c-f94986d2e904" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-646b5b75-0908-572e-b93c-5c7ea9d9a751" :answer-field/choices ["answer-646b5b75-0908-572e-b93c-5c7ea9d9a751" "answer-f2edbfba-1747-5369-9701-18db59e619b9" "answer-86ad3ac9-b39d-5f2a-9c28-d24facac008b" "answer-595ce512-9a9b-5ca3-aac8-d272314ba843" "answer-6283ecd1-90b2-5044-ab8a-28bdf364d373"] :db/ensure [:answer-field/validate]} {:db/id "answer-646b5b75-0908-572e-b93c-5c7ea9d9a751" :answer/id #uuid "646b5b75-0908-572e-b93c-5c7ea9d9a751" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-f2edbfba-1747-5369-9701-18db59e619b9" :answer/id #uuid "f2edbfba-1747-5369-9701-18db59e619b9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & -1 \\\\ 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-86ad3ac9-b39d-5f2a-9c28-d24facac008b" :answer/id #uuid "86ad3ac9-b39d-5f2a-9c28-d24facac008b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-595ce512-9a9b-5ca3-aac8-d272314ba843" :answer/id #uuid "595ce512-9a9b-5ca3-aac8-d272314ba843" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -1 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-6283ecd1-90b2-5044-ab8a-28bdf364d373" :answer/id #uuid "6283ecd1-90b2-5044-ab8a-28bdf364d373" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-62c396bc-091d-5afa-9941-7c10127fae8a