      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14275487/observations/step-q88548-b078540fe5b2ea80d95d.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14275487/observations/step-q88548-b078540fe5b2ea80d95d.png",
      "source_url": "https://mathacademy.com/tasks/14275487/topics/183/lesson",
      "captured_at": 1792226373.989093,
      "math_academy_id": "q-88548",
