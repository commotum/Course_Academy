1)!}=$"] ["question-8948ecd0-03b4-5bf8-9bc2-1467d2b61321" :question/worked-solution "First, we notice that\n\n$$\n(m+2)!=(m+2)(m+1)(m)(m-1)!\n$$\n\nThen, we can cancel the $(m+2)$ and $(m-1)!$ that occur in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(m+2)!}{(m+2)\\text{ }(m-1)!} & =\\frac{(m+2)\\cdot (m+1)\\cdot m\\cdot (m-1)!}{(m+2)\\cdot (m-1)!} \\\\  & =\\frac{\\cancel{(m+2)}\\cdot (m+1)\\cdot m\\cdot \\cancel{(m-1)!}}{\\cancel{(m+2)}\\cdot \\cancel{(m-1)!}} \\\\  & =(m+1)\\cdot m \\\\  & ={m}^{2}+m\\end{aligned}\n$$"] ["question-8948ecd0-03b4-5bf8-9bc2-1467d2b61321" :question/difficulty :question.difficulty/moderate] ["answer-field-3466d9a9-8d93-5dce-a113-2a97b5048512" :answer-field/id #uuid "3466d9a9-8d93-5dce-a113-2a97b5048512"] ["answer-1584deb7-4764-5143-864e-22d0f7584563" :answer/id #uuid "1584deb7-4764-5143-864e-22d0f7584563"] ["answer-1584deb7-4764-5143-864e-22d0f7584563" :answer/type :answer.type/math] ["answer-1584deb7-4764-5143-864e-22d0f7584563" :answer/value "\\frac{m+1}{m}"] ["answer-ea990394-d45f-5925-aedd-845ccc8ee565" :answer/id #uuid "ea990394-d45f-5925-aedd-845ccc8ee565"] ["answer-ea990394-d45f-5925-aedd-845ccc8ee565" :answer/type :answer.type/math] ["answer-ea990394-d45f-5925-aedd-845ccc8ee565" :answer/value "\\frac{m}{m+1}"] ["answer-59ec1f07-6b74-59a0-bd26-0c900add0f71" :answer/id #uuid "59ec1f07-6b74-59a0-bd26-0c900add0f71"] ["answer-59ec1f07-6b74-59a0-bd26-0c900add0f71" :answer/type :answer.type/math] ["answer-59ec1f07-6b74-59a0-bd26-0c900add0f71" :answer/value "{m}^{2}"] ["answer-5fef2f0c-7256-578e-b6f0-95a297ff2ae3" :answer/id #uuid "5fef2f0c-7256-578e-b6f0-95a297ff2ae3"] ["answer-5fef2f0c-7256-578e-b6f0-95a297ff2ae3" :answer/type :answer.type/math] ["answer-5fef2f0c-7256-578e-b6f0-95a297ff2ae3" :answer/value "{m}^{2}+m"] ["answer-6b2ad49e-66ce-572e-83ee-22eb483326c7" :answer/id #uuid "6b2ad49e-66ce-572e-83ee-22eb483326c7"] ["answer-6b2ad49e-66ce-572e-83ee-22eb483326c7" :answer/type :answer.type/math] ["answer-