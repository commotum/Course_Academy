f6-2b28-57e0-9971-452cd7b77a19" :question/answer-fields "answer-field-8bebaea8-1ea1-5395-8e7f-1a00a59795e8"] [17592186179659 :knowledge-point/questions "question-14a5adf6-2b28-57e0-9971-452cd7b77a19"] ["question-c9507815-c165-5ef4-b7fc-1303dcd3fdc4" :question/id #uuid "c9507815-c165-5ef4-b7fc-1303dcd3fdc4"] ["question-c9507815-c165-5ef4-b7fc-1303dcd3fdc4" :question/math-academy-id "q-122049"] ["question-c9507815-c165-5ef4-b7fc-1303dcd3fdc4" :question/problem "Given that $n\\ge 0$ is an integer, simplify $\\frac{(n+3)!}{n!}.$"] ["question-c9507815-c165-5ef4-b7fc-1303dcd3fdc4" :question/worked-solution "First, notice the following:\n\n$$\n(n+3)!=(n+3)\\cdot (n+2)\\cdot (n+1)\\cdot n!\n$$\n\nThen, we cancel the $n!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(n+3)!}{n!} & =\\frac{(n+3)\\cdot (n+2)\\cdot (n+1)\\cdot n!}{n!} \\\\  & =\\frac{(n+3)\\cdot (n+2)\\cdot (n+1)\\cdot \\cancel{n!}}{\\cancel{n!}} \\\\  & =(n+1)(n+2)(n+3)\\end{aligned}\n$$"] ["question-c9507815-c165-5ef4-b7fc-1303dcd3fdc4" :question/difficulty :question.difficulty/moderate] ["answer-field-96838955-c6ff-5947-a190-f1ef251ea9e1" :answer-field/id #uuid "96838955-c6ff-5947-a190-f1ef251ea9e1"] ["answer-5263ce43-a391-52ed-a678-006a7cae38af" :answer/id #uuid "5263ce43-a391-52ed-a678-006a7cae38af"] ["answer-5263ce43-a391-52ed-a678-006a7cae38af" :answer/type :answer.type/math] ["answer-5263ce43-a391-52ed-a678-006a7cae38af" :answer/value "(n+1)(n+2)"] ["answer-c6e71356-751a-5b88-bb29-4ab075926417" :answer/id #uuid "c6e71356-751a-5b88-bb29-4ab075926417"] ["answer-c6e71356-751a-5b88-bb29-4ab075926417" :answer/type :answer.type/math] ["answer-c6e71356-751a-5b88-bb29-4ab075926417" :answer/value "(n+1)(n+2)(n+3)"] ["answer-e76e9a1a-cb09-51eb-bef3-1b4f0aeb11c7" :answer/id #uuid "e76e9a1a-cb09-51eb-bef3-1b4f0aeb11c7"] ["answer-e76e9a1a-cb09-51eb-bef3-1b4f0aeb11c7" :answer/type :answer.type/math] ["answer-e76e9a1a-cb09-51eb-bef3-1b4f0aeb11c7" :answer/value "(n+2)(n+3)"] ["ans