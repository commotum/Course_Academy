#{[{:db/id #edb/ref 17592186179514 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179659 :knowledge-point/id #uuid "44e3a595-a9ae-5d8c-9aa5-c8e3403fcb28" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient of Factorials"}] :question/id #uuid "6dfde17c-e23e-5137-86cb-f8b756788f13" :question/math-academy-id "e-5669" :question/problem "Given that $n \\geq 2$ is an integer, simplify $\\dfrac {n!} {(n - 2)!}.$" :question/worked-solution "First, notice the following:\n\n$$\nn! = n \\cdot (n-1) \\cdot (n-2)!\n$$\n\nThen, we cancel the $(n-2)!$ that occurs in both the numerator and the denominator:\n\n$$\n\\eqalign{\n\\dfrac {n!} {(n - 2)!} \n&= \\dfrac {n \\cdot (n - 1) \\cdot (n - 2)!} {(n - 2)!}\\[5pt] \n\n&= \\dfrac {n \\cdot (n - 1) \\cdot \\cancel{(n - 2)!}} {\\cancel{(n - 2)!}}\\[5pt] \n\n&= n(n -1) \\[5pt]\n&= n^2 - n\n\t}\n$$"}] [{:db/id #edb/ref 17592186179515 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179660 :knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient With Many Factorials"}] :question/id #uuid "357d19f9-977d-5143-a881-3ecbc068556c" :question/math-academy-id "e-5670" :question/problem "Given that $k \\geq 1$ is an integer, simplify $\\dfrac {k^2(k - 1)!} {k!}.$" :question/worked-solution "First, we notice that \n\n$$\nk! = k \\cdot (k-1)!\n$$\n\nSo, we can simplify the numerator as follows:\n\n$$\nk^2 (k-1)! = k \\cdot \\underbrace{k \\cdot (k-1)!}_{k!} = k \\cdot k!\n$$\n\nThen, we cancel the $k!$ that occurs in both the numerator and the denominator:\n\n$$\n\\eqalign{\n\\dfrac {k^2(k - 1)!} {k!} \n&= \\dfrac {k \\cdot k!} {k!}\\[5pt]\n&= \\dfrac {k \\cdot \\cancel{k!}} {\\cancel{k!}} \\[5pt]\n&= \\dfrac {k} {1} \\[5pt]\n&= k\n\t}\n$$"}] [{:db/id #edb/ref 17592186179592 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179730 :knowledge-point/id #uuid "90a5c75b-e93d-5f09-a126-3d0cb5ede2d5" :knowledge-point/title "Writing a Factorial in an Equivalent Form"}] :question/id #uuid "bcdea8ab-4c41-5d45-b62f-a1f2dc9f83e2" :question/math-academy-id "e-9520" :question/problem "Which of the following is equivalent to $(k+1)!$ for any $k \\geq 2?$\n\n- $(k+1) \\cdot k \\cdot (k-1)$\n\n- $(k+1) \\cdot k \\cdot (k-1)!$\n\n- $(k+1) \\cdot k$" :question/worked-solution "Using the definition of factorial, we have \n\n$$\n(k+1)! = (k+1) \\cdot k \\cdot (k-1) \\cdot (k-2) \\cdot \\: \\cdots \\: \\cdot 2 \\cdot 1.\n$$\n\nNow, applying the factorial definition to all but the first two factors, we get\n\n$$\n\\begin{aligned}(k+1)! & =(k+1)\\cdot k\\cdot \\overset{(k-1)!}{\\overset{⏞}{(k-1)\\cdot (k-2)\\cdot \\,⋯\\,\\cdot 2\\cdot 1}} \\\\  & =(k+1)\\cdot k\\cdot (k-1)!\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186233345 :knowledge-point/_questions [{:db/id #edb/ref 17592186179730 :knowledge-point/id #uuid "90a5c75b-e93d-5f09-a126-3d0cb5ede2d5" :knowledge-point/title "Writing a Factorial in an Equivalent Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7d70344-02ef-576e-88c3-b1257e9fa69d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n-2)\\cdot (n-3)" :db/id #edb/ref 17592186258245} {:answer/id #uuid "afe91a2d-c0e2-5aba-9506-7d7fa44f831a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n-2)\\cdot (n-4)!" :db/id #edb/ref 17592186258315} {:answer/id #uuid "c29284ad-e72b-5f4e-ba3c-e24c1075f985" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n-2)\\cdot (n-3)\\cdot \\,⋯\\,\\cdot 4" :db/id #edb/ref 17592186258490} {:answer/id #uuid "cd9add60-65a6-55a9-8eda-c385f59c8510" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n-2)\\cdot (n-3)\\cdot (n-4)!" :db/id #edb/ref 17592186258562} {:answer/id #uuid "f6f3132b-6330-575d-bb7b-0b4b18d22c23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n-2)\\cdot (n-3)\\cdot (n-4)" :db/id #edb/ref 17592186258945}] :answer-field/correct {:answer/id #uuid "cd9add60-65a6-55a9-8eda-c385f59c8510" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n-2)\\cdot (n-3)\\cdot (n-4)!" :db/id #edb/ref 17592186258562} :answer-field/id #uuid "434ed2fe-5fe2-52b2-a372-d845963597d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259154}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "242ef596-08e0-5569-8454-a2cc5d042d36" :question/math-academy-id "q-124492" :question/problem "Which of the following is equivalent to $(n-2)!$ for any $n\\ge 4?$" :question/worked-solution "Using the definition of factorial, we have\n\n$$\n(n-2)!=(n-2)\\cdot (n-3)\\cdot (n-4)\\cdot (n-5)\\cdot \\,⋯\\,\\cdot 2\\cdot 1.\n$$\n\nNow, applying the factorial definition to all but the first two factors, we get\n\n$$\n\\begin{aligned}(n-2)! & =(n-2)\\cdot (n-3)\\cdot \\overset{(n-4)!}{\\overset{⏞}{(n-4)\\cdot (n-5)\\cdot \\,⋯\\,\\cdot 2\\cdot 1}} \\\\  & =(n-2)\\cdot (n-3)\\cdot (n-4)!\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233618 :knowledge-point/_questions [{:db/id #edb/ref 17592186179660 :knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient With Many Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5648b93b-be97-5805-a488-8842edd00a86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(k+1)^{2}}{k!}" :db/id #edb/ref 17592186285582} {:answer/id #uuid "6e4881fd-5591-586f-9565-383104973160" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(k+1)^{2}" :db/id #edb/ref 17592186285801} {:answer/id #uuid "725a2469-6df1-5221-ba82-f8082e82b195" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k+1}{k!}" :db/id #edb/ref 17592186285839} {:answer/id #uuid "a6547bd2-852d-5274-bc55-1dbed1cf7dba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(k+1)k!" :db/id #edb/ref 17592186286306} {:answer/id #uuid "db833302-1c95-5a31-9cb0-e5fcc2f36168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(k+1)^{2}k!" :db/id #edb/ref 17592186286787}] :answer-field/correct {:answer/id #uuid "db833302-1c95-5a31-9cb0-e5fcc2f36168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(k+1)^{2}k!" :db/id #edb/ref 17592186286787} :answer-field/id #uuid "82918e76-ef23-537a-bc48-d16e2ec4bf50" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287421}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9ce46fc1-2caa-54d2-842e-6b699e777d29" :question/math-academy-id "q-19877" :question/problem "Given that $k\\ge 0$ is an integer, $\\frac{{((k+1)!)}^{2}}{k!}=$" :question/worked-solution "First, we notice that\n\n$$\n(k+1)!=(k+1)k!\n$$\n\nThen, we can cancel the $k!$ that occur in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{{((k+1)!)}^{2}}{k!} & =\\frac{{((k+1)k!)}^{2}}{k!} \\\\  & =\\frac{(k+1)^{2}\\,\\cdot (k!)^{2}}{k!} \\\\  & =\\frac{(k+1)^{2}\\,\\cdot k!\\cdot \\cancel{k!}}{\\cancel{k!}} \\\\  & =(k+1)^{2}k!\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233619 :knowledge-point/_questions [{:db/id #edb/ref 17592186179660 :knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient With Many Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22766496-0abf-50a1-80d1-5c3aa17a5c49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n-8)(n+8)(n+9)" :db/id #edb/ref 17592186285095} {:answer/id #uuid "2decc5e8-9169-5cef-a48f-c52612fb5bb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n+8)(n+9)" :db/id #edb/ref 17592186285195} {:answer/id #uuid "68bba672-b656-58bd-ab7d-b6d8e1d686e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n+7)(n+8)(n+9)" :db/id #edb/ref 17592186285750} {:answer/id #uuid "96c58f78-9e89-5c29-947e-3e0a3eea9a98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(n+8)(n+9)}{n-9}" :db/id #edb/ref 17592186286158} {:answer/id #uuid "bd10a16d-830d-53c9-ba1c-682004537a80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n+9}{n-9}" :db/id #edb/ref 17592186286513}] :answer-field/correct {:answer/id #uuid "22766496-0abf-50a1-80d1-5c3aa17a5c49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n-8)(n+8)(n+9)" :db/id #edb/ref 17592186285095} :answer-field/id #uuid "12acb7ca-836f-551c-8db4-207dc9c189b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287179}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f3ef0665-6f2a-5dd9-af17-7da892c3b332" :question/math-academy-id "q-19882" :question/problem "Given that $n\\ge 9$ is an integer, simplify $\\frac{(n-8)!\\,(n+9)!}{(n-9)!\\,(n+7)!}.$" :question/worked-solution "First, we notice that\n\n$$\n\\begin{aligned}(n+9)! & =(n+9)(n+8)(n+7)! \\\\ (n-8)! & =(n-8)(n-9)!\\end{aligned}\n$$\n\nThen, we can cancel the $(n+7)!$ and $(n-9)!$ that occur in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(n-8)!\\,(n+9)!}{(n-9)!\\,(n+7)!} & =\\frac{[(n-8)\\cdot (n-9)!]\\cdot [(n+9)\\cdot (n+8)\\cdot (n+7)!]}{(n-9)!\\cdot (n+7)!} \\\\  & =\\frac{(n-8)\\cdot \\cancel{(n-9)!}\\cdot (n+9)\\cdot (n+8)\\cdot \\cancel{(n+7)!}}{\\cancel{(n-9)!}\\cdot \\cancel{(n+7)!}} \\\\  & =(n-8)\\cdot (n+8)\\cdot (n+9) \\\\  & =(n-8)(n+8)(n+9)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234328 :knowledge-point/_questions [{:db/id #edb/ref 17592186179659 :knowledge-point/id #uuid "44e3a595-a9ae-5d8c-9aa5-c8e3403fcb28" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient of Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ae24c67-169d-568f-9906-74f5b3cc2e0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n(n+1)" :db/id #edb/ref 17592186339505} {:answer/id #uuid "35c068a3-dbe1-516f-a719-8c52f792f017" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{2}(n+1)" :db/id #edb/ref 17592186339606} {:answer/id #uuid "4cc01694-bcd6-5105-860b-e7ae3171d223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n(n-2)" :db/id #edb/ref 17592186339824} {:answer/id #uuid "9d31eea3-a5b0-5f91-81ac-06d7e2e82a81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n-1)(n+1)" :db/id #edb/ref 17592186340545} {:answer/id #uuid "cb8da782-b040-553f-a209-d1c9c3875b8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n(n-1)" :db/id #edb/ref 17592186340932}] :answer-field/correct {:answer/id #uuid "2ae24c67-169d-568f-9906-74f5b3cc2e0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n(n+1)" :db/id #edb/ref 17592186339505} :answer-field/id #uuid "20784676-1346-5beb-bf37-2d8560fbcb5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341437}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "81d120ad-3169-5d64-9a97-a76dfeab46ec" :question/math-academy-id "q-73023" :question/problem "Given that $n\\ge 1$ is an integer, simplify $\\frac{(n+1)!}{(n-1)!}.$" :question/worked-solution "First, notice the following:\n\n$$\n(n+1)!=(n+1)\\cdot n\\cdot (n-1)!\n$$\n\nThen, we cancel the $(n-1)!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(n+1)!}{(n-1)!} & =\\frac{(n+1)\\cdot n\\cdot (n-1)!}{(n-1)!} \\\\  & =\\frac{(n+1)\\cdot n\\cdot \\cancel{(n-1)!}}{\\cancel{(n-1)!}} \\\\  & =n(n+1)\\end{aligned}\n$$"}]}
