tivity/scope {:db/id #edb/ref 17592186048649 :topic/id #uuid "b2233765-2b13-58ee-a72e-84adcf0f08b9" :topic/math-academy-id 3747} :activity/steps [{:db/id #edb/ref 17592186492941 :step/content {:db/id #edb/ref 17592186180206 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91ec71e3-376b-5690-bca2-fd7f9226952f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3l}" :db/id #edb/ref 17592186178782} {:answer/id #uuid "0348f45c-980d-513c-857c-5ece1eddec7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{3l}" :db/id #edb/ref 17592186178784} {:answer/id #uuid "0d79c308-26ef-52ae-932f-2f9ac93870dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5l}" :db/id #edb/ref 17592186178785} {:answer/id #uuid "28347eb9-3aaa-5526-b6b3-b14025785b42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3+5l" :db/id #edb/ref 17592186492300} {:answer/id #uuid "55468543-5feb-5a4e-9af4-c5b682e3a497" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3-5l" :db/id #edb/ref 17592186492379}] :answer-field/correct {:db/id #edb/ref 17592186178785} :answer-field/id #uuid "c51d51c6-6c3d-5b81-8fca-89e3690d5721" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186178780}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c65531cd-98d9-5536-becc-69514edf4556" :question/math-academy-id "q-45320" :question/problem "If $2lx=\\frac{6}{5},$ then $x=$" :question/worked-solution "First, we multiply both sides of the equation by $5$ to get rid of the fraction:\n\n$$\n\\begin{aligned}2lx & =\\frac{6}{5} \\\\ 5\\cdot 2lx & =5\\cdot \\frac{6}{5} \\\\ 10lx & =6\\end{aligned}\n$$\n\nNow, we need to isolate $x.$ To do this, we divide both sides of the equation by $10l:$\n\n$$\n\\begin{aligned}10lx & =6 \\\\ \\frac{10lx}{10l} & =\\frac{6}{10l} \\\\ \\frac{\\cancel{10l}x}{\\cancel{10l}} & =\\frac{6}{10l} \\\\ x & =\\frac{6}{10l}\\end{aligned}\n$$\n\nWe can further simplify the right-hand side as follows:\n\n$$\n\\begin{aligned}x & =\\frac{2\\cdot 3}{2\\cdot 5l} \\\\ x & =\\frac{\\cancel{2}\\cdot 3}{\\cancel{2}\\cdot 5l} \\\\ x & =\\frac{3}{5l}\\end{aligned}\n$$"} :step/id #uuid "3884d043-75db-5212-8395-1e2c764892ba" :step/next {:db/id #edb/ref 17592186492944}} {:db/id #edb/ref 17592186492944 :step/content {:db/id #edb/ref 17592186492902 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "591dd984-6568-5ccd-bf61-c54b92e1498c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{5m}" :db/id #edb/ref 17592186492391} {:answer/id #uuid "5cb5b0ed-5f47-54e9-a659-1c3087a32a54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5m}{4}" :db/id #edb/ref 17592186492401} {:answer/id #uuid "80e08489-6db6-5fff-889e-336e8aa7cbf9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{m}" :db/id #edb/ref 17592186492475} {:answer/id #uuid "c8e1d746-f7b8-568f-a44a-cb0999d610f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{m}{4}" :db/id #edb/ref 17592186492619} {:answer/id #uuid "d4cce29f-595a-5529-a3ee-ff3b48c4d743" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{m}" :db/id #edb/ref 17592186492637}] :answer-field/correct {:db/id #edb/ref 17592186492475} :answer-field/id #uuid "a40c5b5f-c277-58f8-b74e-f824cd64414a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492772}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "baac7ae1-a07b-5049-b210-41cf170484ad" :question/math-academy-id "q-45326" :question/problem "If $\\frac{5mg}{8}=\\frac{5}{2},$ then $g=$" :question/worked-solution "We need to isolate $g.$ To do this, we first cross-multiply:\n\n$$\n\\begin{aligned}\\frac{5mg}{8} & =\\frac{5}{2} \\\\ 2\\cdot 5mg & =8\\cdot 5 \\\\ 10mg & =40\\end{aligned}\n$$\n\nThen, we divide both sides of the equation by $10m:$\n\n$$\n\\begin{aligned}10mg & =40 \\\\ \\frac{10mg}{10m} & =\\frac{40}{10m} \\\\ \\frac{\\cancel{10m}g}{\\cancel{10m}} & =\\frac{40}{10m} \\\\ g & =\\frac{40}{10m}\\end{aligned}\n$$\n\nWe can further simplify the right-hand side as follows:\n\n$$\n\\begin{aligned}g & =\\frac{10\\cdot 4}{10m} \\\\ g & =\\frac{\\cancel{10}\\cdot 4}{\\cancel{10}m} \\\\ g & =\\frac{4}{m}\\end{aligned}\n$$"} :step/id #uuid "410ffcfc-0175-5671-8ae5-c5418ec86558"} {:db/id #edb/ref 17592186492976 :step/content {:db/id #edb/ref 17592186492919 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68462d68-12db-54b8-a746-2531c1eca657" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9k}{16}" :db/id #edb/ref 17592186492425} {:answer/id #uuid "7585635c-e1d7-5b96-94d0-5d364aaa613f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{6k}" :db/id #edb/ref 17592186492452} {:answer/id #uuid "832bdf00-a4ad-5f8c-bf5d-f4b3fb00505e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{16k}" :db/id #edb/ref 17592186492482} {:answer/id #uuid "c0bc745d-c282-5d96-94ce-175a536badd8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{k}" :db/id #edb/ref 17592186492601} {:answer/id #uuid "c5b49b76-ea76-5b4a-9b6a-b89c34045986" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{12k}" :db/id #edb/ref 17592186492613}] :answer-field/correct {:db/id #edb/ref 17592186492482} :answer-field/id #uuid "dfc268ac-13af-5ab2-8208-3b471658735c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492801}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e830f76b-5a84-5b55-8ce0-c003dd77dcc2" :question/math-academy-id "q-45293" :question/problem "If $\\frac{4kb}{3}=\\frac{3}{4},$ then $b=$" :question/worked-solution "We need to isolate $b.$ To do this, we first cross-multiply:\n\n$$\n\\begin{aligned}\\frac{4kb}{3} & =\\frac{3}{4} \\\\ 4\\cdot 4kb & =3\\cdot 3 \\\\ 16kb & =9\\end{aligned}\n$$\n\nThen, we divide both sides of the equation by $16k:$\n\n$$\n\\begin{aligned}16kb & =9 \\\\ \\frac{16kb}{16k} & =\\frac{9}{16k} \\\\ \\frac{\\cancel{16k}b}{\\cancel{16k}} & =\\frac{9}{16k} \\\\ b & =\\frac{9}{16k}\\end{aligned}\n$$"} :step/id #uuid "a23b9573-7415-545a-9e8b-b6740ea06d30" :step/next {:db/id #edb/ref 17592186492941}}] :activity/title "Solving Linear Equations With Unknown Coefficients" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186492214}]}
