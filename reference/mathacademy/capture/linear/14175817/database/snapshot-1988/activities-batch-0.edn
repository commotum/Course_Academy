#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186180313} :activity/id #uuid "e4b9901d-88e7-5d69-a378-0f71f70c0310" :activity/scope {:db/id #edb/ref 17592186048649 :topic/id #uuid "b2233765-2b13-58ee-a72e-84adcf0f08b9" :topic/math-academy-id 3747} :activity/steps [{:db/id #edb/ref 17592186180313 :step/content {:db/id #edb/ref 17592186180780 :tutorial/content "Consider the following equation:\n\n$$\n2{\\color{red}m}{\\color{blue}t} = 1\n$$\n\nNotice that this equation has two variables, ${\\color{red}m}$ and ${\\color{blue}t}.$ Suppose we want to solve the equation for the variable ${\\color{blue}t}.$\n\nTo isolate ${\\color{blue}t},$ we apply the multiplication principle and divide both sides of the equation by $2{\\color{red}m},$ treating ${\\color{red}m}$ as though it were a constant:\n\n$$\n\\begin{aligned}2mt & =1 \\\\ \\frac{2mt}{2m} & =\\frac{1}{2m} \\\\ \\frac{\\cancel{2m}t}{\\cancel{2m}} & =\\frac{1}{2m} \\\\ t & =\\frac{1}{2m}\\end{aligned}\n$$\n\nNext, we'll take a look at an example where we need to apply both the addition and multiplication principles." :tutorial/id #uuid "841f1014-d389-5378-ab68-d2e1d2a95016" :tutorial/math-academy-id 8664 :tutorial/title "Introduction"} :step/id #uuid "fb33245e-3b63-52de-95bb-e6deb0330b74" :step/math-academy-id 103208 :step/next {:db/id #edb/ref 17592186180314}} {:db/id #edb/ref 17592186180314 :step/content {:db/id #edb/ref 17592186179626 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179465 :question/id #uuid "ddcd149b-a90b-5ed2-923d-75e8a84ff145" :question/math-academy-id "e-13901"} :knowledge-point/id #uuid "7c6535bf-7dd1-5231-a992-9aefb8066499" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050622} {:db/id #edb/ref 17592186050843}] :knowledge-point/questions [{:db/id #edb/ref 17592186179907} {:db/id #edb/ref 17592186180204} {:db/id #edb/ref 17592186488184} {:db/id #edb/ref 17592186488238}] :knowledge-point/title "Solving Equations With Unknown Coefficients