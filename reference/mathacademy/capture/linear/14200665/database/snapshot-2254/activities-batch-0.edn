#{[{:activity/first-step {:db/id #edb/ref 17592186120590} :activity/id #uuid "9b3a1069-52b2-5215-b943-d2a9a9c9e0ec" :activity/scope {:db/id #edb/ref 17592186049225 :topic/id #uuid "e4d5c007-bb0e-5384-b435-d19add6ff444" :topic/math-academy-id 1745} :activity/steps [{:db/id #edb/ref 17592186120590 :step/content {:db/id #edb/ref 17592186121005 :tutorial/content "The area of a circle with radius $r$ is given by the formula\n\n$$\n\\mathcal{A}=\\pi r^2\n$$\n\nTo demonstrate, let's find the area of a circle that has a radius of $3\\textrm{cm}$.\n\n![](images/ea/ea7b4221ec972df5bce524c031ac82ecd7f427aaf6fd04ce2a93734d9597d271.png)\n\nUsing the area formula, the area is\n\n$$\n\\begin{aligned}\nA &= πr^{2} \\\\\n&= π \\cdot (3)^{2} \\\\\n&= π \\cdot 9 \\\\\n&= 9πcm^{2}\n\\end{aligned}\n$$" :tutorial/id #uuid "81aba826-d72c-50d9-85e5-cb77544b3df7" :tutorial/math-academy-id 2424 :tutorial/title "Introduction"} :step/id #uuid "2d8d663f-5c91-557f-836d-bff3e1edd11c" :step/math-academy-id 10882 :step/next {:db/id #edb/ref 17592186120591}} {:db/id #edb/ref 17592186120591 :step/content {:db/id #edb/ref 17592186119755 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119571 :question/id #uuid "57ebd9c4-2338-5beb-8b58-0902de3d7f33" :question/math-academy-id "e-3183"} :knowledge-point/id #uuid "1aaab9fd-0ef0-5240-9142-d84b66df0eeb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049608} {:db/id #edb/ref 17592186049856} {:db/id #edb/ref 17592186050204}] :knowledge-point/questions [{:db/id #edb/ref 17592186120483} {:db/id #edb/ref 17592186120486} {:db/id #edb/ref 17592186235503}] :knowledge-point/title "Calculating the Area of a Circle Given the Radius"} :step/id #uuid "ebfc68d5-4727-5d49-aafa-c697c47d0110" :step/math-academy-id 10883 :step/next {:db/id #edb/ref 17592186120592}} {:db/id #edb/ref 17592186120592 :step/content {:db/id #edb/ref 17592186119756 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119572 :question/id #uuid "57533c91-7a96-52c7-b9a4