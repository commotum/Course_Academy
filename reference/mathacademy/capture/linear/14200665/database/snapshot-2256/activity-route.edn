#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186518236} :activity/id #uuid "245364c3-4153-568e-865a-04318a8cc074" :activity/scope {:db/id #edb/ref 17592186049225 :topic/id #uuid "e4d5c007-bb0e-5384-b435-d19add6ff444" :topic/math-academy-id 1745} :activity/steps [{:db/id #edb/ref 17592186518236 :step/content {:db/id #edb/ref 17592186518101 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "259964da-e8d1-584f-a47d-4187a4bcd044" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186517558} {:answer/id #uuid "33ee2c32-24ac-5d6c-a2c0-def46f715359" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186517586} {:answer/id #uuid "374ff126-9136-52a2-9c24-06afbd88f83f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36" :db/id #edb/ref 17592186517597} {:answer/id #uuid "9583798b-f370-5608-be6f-201e498aa9ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\pi " :db/id #edb/ref 17592186517770} {:answer/id #uuid "beda97a9-4ab0-569e-927e-f09c4d2f3d20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\pi " :db/id #edb/ref 17592186517852}] :answer-field/correct {:db/id #edb/ref 17592186517558} :answer-field/id #uuid "3bee644a-73f2-5d35-892b-6222224db91f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518000}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0207e47c-2942-5ced-8414-95264c8bde68" :question/math-academy-id "q-5658" :question/problem "![](images/2e/2e054a16d93658d53cc9dc16e3fe5544b9a007721d1d9c2f87581799a6257797.png)\n\nWhat is the diameter of a circle that has an area of $36\\pi ?$" :question/worked-solution "The formula for the area of a circle is $A=\\pi {r}^{2}$, where $r$ is the radius. Therefore,\n\n$$\n\\begin{aligned}A & =\\pi {r}^{2} \\\\ 36\\pi  & =\\pi {r}^{2} \\\\ 36\\cancel{\\pi } & =\\cancel{\\pi }{r}^{2} \\\\ {r}^{2} & =36 \\\\ r & =6.\\end{aligned}\n$$\n\nTherefore, the diameter is\n\n$$\nd=2\\cdot r=2\\cdot 6=12.\n$$"} :step/id #uuid "312df14d-95e2-5711-b6a4-410aa3c383fb" :step/next {:db/id #edb/ref 17592186518282}} {:db/id #edb/ref 17592186518282 :step/content {:db/id #edb/ref 17592186518114 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35141247-f3e1-5990-ba0f-9bc6d95fa8b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16\\pi \\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186517593} {:answer/id #uuid "3b348032-0523-5bc6-be3d-02aaaa0f92d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "64\\pi \\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186517604} {:answer/id #uuid "4f7f24b1-0abd-57b7-93d2-f859b641466d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\pi \\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186517643} {:answer/id #uuid "62dc01c0-ac9f-55a8-97d8-58206daf5ac2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\pi \\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186517669} {:answer/id #uuid "7c50db5f-63f5-5063-9925-f6ec4ff127dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32\\pi \\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186517724}] :answer-field/correct {:db/id #edb/ref 17592186517604} :answer-field/id #uuid "1edcd967-7d6c-5932-892a-7a8dee229da8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186517980}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1c7ac009-3403-59c4-adad-c97136633e2b" :question/math-academy-id "q-53582" :question/problem "What is the area of a circular dinner plate given that its radius is $8\\,\\text{cm}?$" :question/worked-solution "![](images/72/7223cab003af57279fc16d8044bd9eae6dbfa6bbfe41433b851ebdafd52e91da.png)\n\n \n\nThe area of the dinner plate  is\n\n$$\n\\begin{aligned}A & =\\pi {r}^{2} \\\\  & =\\pi \\cdot {8}^{2} \\\\  & =64\\pi \\,{\\text{cm}}^{2}.\\end{aligned}\n$$"} :step/id #uuid "a9e09edb-4acf-52c7-b158-1173f1f2be15" :step/next {:db/id #edb/ref 17592186518289}} {:db/id #edb/ref 17592186518289 :step/content {:db/id #edb/ref 17592186518160 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21bc70ee-3aa4-5a15-a13b-393c06fe66f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\pi " :db/id #edb/ref 17592186517550} {:answer/id #uuid "2aaf08f9-085c-56ea-a193-97d47d7a7c3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi " :db/id #edb/ref 17592186517568} {:answer/id #uuid "2fd0935c-2821-5b9c-b6d0-877b2c1aed13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{\\pi }^{2}" :db/id #edb/ref 17592186517580} {:answer/id #uuid "4a8b7aa7-f777-5613-a453-077e27a21b41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16\\pi " :db/id #edb/ref 17592186517631} {:answer/id #uuid "e4675869-60cd-54e6-8ce6-957f6ff1cc02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16{\\pi }^{2}" :db/id #edb/ref 17592186517920}] :answer-field/correct {:db/id #edb/ref 17592186517550} :answer-field/id #uuid "7f2ed3a4-ca61-5ce1-89d9-355511e39533" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518030}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "78884415-9ec2-5003-9971-d3d9da1f23e6" :question/math-academy-id "q-79024" :question/problem "What is the area of a circle that has a diameter of $4?$" :question/worked-solution "The radius of a circle is half the diameter. So, the radius of our circle is $r=2.$\n\nTherefore, the area is\n\n$$\n\\begin{aligned}A & =\\pi {r}^{2} \\\\  & =\\pi \\cdot {2}^{2} \\\\  & =4\\pi .\\end{aligned}\n$$"} :step/id #uuid "bb3ad15a-27ed-57cd-85b9-84582d33ba21"}] :activity/title "Areas of Circles" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186517477}]}
