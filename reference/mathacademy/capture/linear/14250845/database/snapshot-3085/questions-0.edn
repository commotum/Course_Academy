#{[{:db/id #edb/ref 17592186078350 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078498 :knowledge-point/id #uuid "45915032-87ea-583d-8570-ad1d56d019b2" :knowledge-point/title "Finding the Surface Area of a Cube Given a Side Length"}] :question/id #uuid "d27805b4-9ade-5429-b5d9-85f202750d97" :question/math-academy-id "e-7150" :question/problem "![](images/2e/2ea953a445de3655c3977cffcc3e5834cae936508cbbee761988b0f71d99a50c.png)\n\nDetermine the surface area for the cube above." :question/worked-solution "The surface area $S$ of a cube can be found using the formula\n\n$$\nS = 6s^2\n$$\n\nwhere $s$ is the side length of the cube.\n\nSubstituting\n\n$$\ns = 7\\,\\textrm{m}\n$$\n\ninto the formula, we get\n\n$$\nS = 6(7\\, \\text{m})^2 = 294\\,\\textrm{m}^2\n$$"}] [{:db/id #edb/ref 17592186078351 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078499 :knowledge-point/id #uuid "676d79a5-129d-5e14-ad1f-4af43090459f" :knowledge-point/title "Finding the Side Length of a Cube Given the Surface Area"}] :question/id #uuid "1572978d-d8a9-5a85-b5f7-dc724de52824" :question/math-academy-id "e-7151" :question/problem "The surface area of a cube is $240$ square units. Find the length of the edges of the cube." :question/worked-solution "The surface area $S$ of a cube is made of $6$ congruent squares. So, the area $\\mathcal A$ of one face is\n\n$$\n\\mathcal{A} = \\dfrac{S}{6} = \\frac{240}{6} = 40\\,\n$$\n\nSince\n\n$$\n\\mathcal A = s^2\n$$\n\nwhere $s$ is the length of an edge, we can find $s$ as follows:\n\n$$\ns = \\sqrt{\\mathcal{A}} = \\sqrt{40} = 2\\sqrt{10}\n$$\n\nTherefore, the length of the edges is $2\\sqrt{10}$ units."}] [{:db/id #edb/ref 17592186078376 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078523 :knowledge-point/id #uuid "b01e7b76-466f-522d-bfd1-aa8616cbe023" :knowledge-point/title "Calculating the Lateral Surface Area of a Cube Given its Dimensions"}] :question/id #uuid "80eb6640-3bd6-5cff-81c5-7e6b850d6f93" :question/math-academy-id "e-9015" :question/problem "![](images/8b/8bbdcdc749ecf9bf1a2aae1904f7be960139be55df49f5a23c1b657656df0f7d.png)\n\nDetermine the lateral surface area for the cube above." :question/worked-solution "The lateral surface area $S_L$ of a cube can be found using the formula\n\n$$\nS_L = 4s^2\n$$\n\nwhere $s$ is the side length of the cube.\n\nSubstituting\n\n$$\ns = 9\\,\\textrm{cm}\n$$\n\ninto the formula, we get\n\n$$\nS_L = 4(9\\, \\text{cm})^2 = 324 \\,\\textrm{cm}^2\n$$"}] [{:db/id #edb/ref 17592186571415 :knowledge-point/_questions [{:db/id #edb/ref 17592186078498 :knowledge-point/id #uuid "45915032-87ea-583d-8570-ad1d56d019b2" :knowledge-point/title "Finding the Surface Area of a Cube Given a Side Length"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "453ee29e-94fa-5e17-bc94-a7fd78b20dd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "672\\,{\\text{in}}^{2}" :db/id #edb/ref 17592186570996} {:answer/id #uuid "45e593fc-f214-5254-9f7e-6ed3bc257f4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24\\sqrt{7}\\,{\\text{in}}^{2}" :db/id #edb/ref 17592186570999} {:answer/id #uuid "580ab51c-deac-57fd-bc76-582a5f3cfc51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "448\\sqrt{7}\\,{\\text{in}}^{2}" :db/id #edb/ref 17592186571028} {:answer/id #uuid "8e055ee7-b9d0-521f-8cc9-494a750bec3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "336\\,{\\text{in}}^{2}" :db/id #edb/ref 17592186571111} {:answer/id #uuid "9a154e33-feee-5f5f-b632-439836470c60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "112\\,{\\text{in}}^{2}" :db/id #edb/ref 17592186571131}] :answer-field/correct {:answer/id #uuid "453ee29e-94fa-5e17-bc94-a7fd78b20dd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "672\\,{\\text{in}}^{2}" :db/id #edb/ref 17592186570996} :answer-field/id #uuid "b2fa9367-0a44-5d1b-9036-7aa4df8f20af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571350}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "77a60330-8cf9-5eed-a2b7-ae915d42d5e9" :question/math-academy-id "q-107323" :question/problem "Find the surface area of the cube whose sides each have length $4\\sqrt{7}\\,\\text{in}.$" :question/worked-solution "The surface area $S$ of a cube can be found using the formula\n\n$$\nS=6{s}^{2},\n$$\n\nwhere $s$ is the side length of the cube.\n\nSubstituting $s=4\\sqrt{7}\\,\\text{in}$ into the formula, we get \n\n$$\nS=6(4\\sqrt{7}\\,\\text{in})^{2}=672\\,{\\text{in}}^{2}.\n$$"}] [{:db/id #edb/ref 17592186571453 :knowledge-point/_questions [{:db/id #edb/ref 17592186078523 :knowledge-point/id #uuid "b01e7b76-466f-522d-bfd1-aa8616cbe023" :knowledge-point/title "Calculating the Lateral Surface Area of a Cube Given its Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08d96e16-1bd6-58b5-9795-26ecc03a9146" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "270\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186570905} {:answer/id #uuid "4b622d66-e7f4-5148-b50a-d72acf220f0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24\\sqrt{5}\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186571007} {:answer/id #uuid "518e942c-a5ec-54da-9661-250800f52115" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36\\sqrt{5}\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186571016} {:answer/id #uuid "a6cfbbae-8e47-5211-a5a4-c600c5ef62dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186571152} {:answer/id #uuid "f800d00a-e6c8-5a0a-ad24-fc4f857f20b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "180\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186571268}] :answer-field/correct {:answer/id #uuid "f800d00a-e6c8-5a0a-ad24-fc4f857f20b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "180\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186571268} :answer-field/id #uuid "1991d839-355a-5ccf-b0bd-d49cc6c04c9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571294}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fa36ef42-622c-5ec4-b237-5aa6a8f72c36" :question/math-academy-id "q-107341" :question/problem "![](images/4a/4ab1cb82bca3650868b7e654cb52d3eb7a0c3101ab4d6a3458485865ae353264.png)\n\nDetermine the lateral surface area for the cube above." :question/worked-solution "The lateral surface area ${S}_{L}$ of a cube can be found using the formula\n\n$$\n{S}_{L}=4{s}^{2},\n$$\n\nwhere $s$ is the side length of the cube.\n\nSubstituting $s=3\\sqrt{5}\\,\\text{cm}$ into the formula, we get \n\n$$\n{S}_{L}=4(3\\sqrt{5}\\,\\text{cm})^{2}=180\\,{\\text{cm}}^{2}.\n$$"}] [{:db/id #edb/ref 17592186571422 :knowledge-point/_questions [{:db/id #edb/ref 17592186078523 :knowledge-point/id #uuid "b01e7b76-466f-522d-bfd1-aa8616cbe023" :knowledge-point/title "Calculating the Lateral Surface Area of a Cube Given its Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0079d0f2-da19-5418-845c-6b92aad2f91e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\sqrt{2}\\,\\text{ft}" :db/id #edb/ref 17592186570894} {:answer/id #uuid "64ac15cb-f10c-50b0-b45a-a057683b6f45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{2}\\,\\text{ft}" :db/id #edb/ref 17592186571046} {:answer/id #uuid "8313afe8-5ab5-5eb3-82e5-d091d3983bd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25\\,\\text{ft}" :db/id #edb/ref 17592186571096} {:answer/id #uuid "9b9592d9-ece5-5bdd-b87c-26d42bad42f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{ft}" :db/id #edb/ref 17592186571133} {:answer/id #uuid "b36445f1-56bd-5f7f-978b-36cf6a73668a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,\\text{ft}" :db/id #edb/ref 17592186571167}] :answer-field/correct {:answer/id #uuid "b36445f1-56bd-5f7f-978b-36cf6a73668a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,\\text{ft}" :db/id #edb/ref 17592186571167} :answer-field/id #uuid "5f4160a4-abcf-5073-a54d-32bafbe4e390" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571325}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "84fa227b-da46-520b-a245-2527cb980b2f" :question/math-academy-id "q-118510" :question/problem "The lateral surface area of a cube is $400\\,{\\text{ft}}^{2}.$ Find the length of the edges of the cube." :question/worked-solution "The lateral surface area ${S}_{L}$ of a cube is made up of $4$ congruent squares. So, the area $A$ of one face is\n\n$$\nA=\\frac{{S}_{L}}{4}=\\frac{400}{4}=100\\,{\\text{ft}}^{2}\\,.\n$$\n\nSince $A={s}^{2},$ where $s$ is the length of an edge, we can find $s$ as follows:\n\n$$\ns=\\sqrt{A}=\\sqrt{100}=10\\,\\text{ft}\n$$\n\nTherefore, the length of the edges is $10\\,\\text{ft}.$"}] [{:db/id #edb/ref 17592186571409 :knowledge-point/_questions [{:db/id #edb/ref 17592186078499 :knowledge-point/id #uuid "676d79a5-129d-5e14-ad1f-4af43090459f" :knowledge-point/title "Finding the Side Length of a Cube Given the Surface Area"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "585cac20-9727-55d9-8bd4-76bb8bab9d94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ units" :db/id #edb/ref 17592186571030} {:answer/id #uuid "59a4f48f-2d43-5659-a6af-f410d9d6bc09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ units" :db/id #edb/ref 17592186571032} {:answer/id #uuid "6dbdb338-8356-587f-a018-80a4e8fdf83e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$ units" :db/id #edb/ref 17592186571062} {:answer/id #uuid "d373d8fe-bfa0-57b0-9bb4-432e2aa2df99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ units" :db/id #edb/ref 17592186571216} {:answer/id #uuid "fb17efa7-0ec7-5922-857e-7a83153fdb14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ units" :db/id #edb/ref 17592186571272}] :answer-field/correct {:answer/id #uuid "fb17efa7-0ec7-5922-857e-7a83153fdb14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ units" :db/id #edb/ref 17592186571272} :answer-field/id #uuid "12f596b0-e775-5acf-b9f6-a9085fdb1c60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571290}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "661ca87c-9ae5-589f-ace6-f92ef07fb654" :question/math-academy-id "q-23926" :question/problem "The surface area of a cube is $150$ square units. Find the length of the edges of the cube." :question/worked-solution "The surface area $S$ of a cube is made up of $6$ congruent squares. So, the area $A$ of one face is\n\n$$\nA=\\frac{S}{6}=\\frac{150}{6}=25\\,.\n$$\n\nSince $A={s}^{2},$ where $s$ is the length of an edge, we can find $s$ as follows:\n\n$$\ns=\\sqrt{A}=\\sqrt{25}=5\n$$\n\nTherefore, the length of the edges is $5$ units."}] [{:db/id #edb/ref 17592186571429 :knowledge-point/_questions [{:db/id #edb/ref 17592186078498 :knowledge-point/id #uuid "45915032-87ea-583d-8570-ad1d56d019b2" :knowledge-point/title "Finding the Surface Area of a Cube Given a Side Length"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f391917-93ef-520e-957b-715ce231030c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "102\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186571013} {:answer/id #uuid "62372eae-09f9-5c86-ae1b-65c818385134" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186571042} {:answer/id #uuid "af551e3a-6e90-5552-ac13-0072e15e1273" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90\\sqrt{2}\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186571162} {:answer/id #uuid "bf730ee6-b7e4-5f39-8e7f-8b104a2e9472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120\\sqrt{2}\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186571187} {:answer/id #uuid "bf990291-e633-56a2-968f-5c216447b7db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186571188}] :answer-field/correct {:answer/id #uuid "62372eae-09f9-5c86-ae1b-65c818385134" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186571042} :answer-field/id #uuid "15e1967e-09fc-5194-8f52-9932c2288cb3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571293}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "98cd99a4-4813-5a81-8e79-78ee88e169c6" :question/math-academy-id "q-86336" :question/problem "![](images/5e/5eef04daa0a8ac1a590b3a0da378d9184ad9b82c5e4834c5079ccb4f3665cced.png)\n\nDetermine the surface area for the cube above." :question/worked-solution "The surface area $S$ of a cube can be found using the formula\n\n$$\nS=6{s}^{2},\n$$\n\nwhere $s$ is the side length of the cube.\n\nSubstituting $s=2\\sqrt{5}\\,\\text{cm}$ into the formula, we get \n\n$$\nS=6(2\\sqrt{5}\\,\\text{cm})^{2}=120\\,{\\text{cm}}^{2}.\n$$"}] [{:db/id #edb/ref 17592186571449 :knowledge-point/_questions [{:db/id #edb/ref 17592186078499 :knowledge-point/id #uuid "676d79a5-129d-5e14-ad1f-4af43090459f" :knowledge-point/title "Finding the Side Length of a Cube Given the Surface Area"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "278f16aa-ac80-55cb-acb8-a4af58bf0d0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,\\text{cm}" :db/id #edb/ref 17592186570950} {:answer/id #uuid "3e26f609-af30-506f-b693-160d5e8a3114" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\text{cm}" :db/id #edb/ref 17592186570984} {:answer/id #uuid "61177209-db20-5e28-b275-3e817d3b78f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\,\\text{cm}" :db/id #edb/ref 17592186571040} {:answer/id #uuid "9cf7e0db-4b16-5907-89ad-1cebd3b384e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\text{cm}" :db/id #edb/ref 17592186571134} {:answer/id #uuid "f79e1475-405a-5cb3-99af-5fb356d6fc1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\text{cm}" :db/id #edb/ref 17592186571266}] :answer-field/correct {:answer/id #uuid "9cf7e0db-4b16-5907-89ad-1cebd3b384e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\text{cm}" :db/id #edb/ref 17592186571134} :answer-field/id #uuid "1562e441-0576-5a3c-a1e7-1f5ba18cc339" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571292}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f1ef2b0d-aa7e-55cc-9472-24fb79eacf8f" :question/math-academy-id "q-86353" :question/problem "The surface area of a cube is $294\\,{\\text{cm}}^{2}.$ Find the length of the edges of the cube." :question/worked-solution "The surface area $S$ of a cube is made up of $6$ congruent squares. So, the area $A$ of one face is\n\n$$\nA=\\frac{S}{6}=\\frac{294}{6}=49\\,{\\text{cm}}^{2}\\,.\n$$\n\nSince $A={s}^{2},$ where $s$ is the length of an edge, we can find $s$ as follows:\n\n$$\ns=\\sqrt{A}=\\sqrt{49}=7\\,\\text{cm}\n$$\n\nTherefore, the length of the edges is $7\\,\\text{cm}.$"}]}
