#{[{:activity/first-step {:db/id #edb/ref 17592186069543} :activity/id #uuid "bf2edb5d-ba82-59e5-8293-ed68021af1ea" :activity/scope {:db/id #edb/ref 17592186049224 :topic/id #uuid "e4d4205c-47d1-5b87-81bd-c01b64870d2b" :topic/math-academy-id 433} :activity/steps [{:db/id #edb/ref 17592186069543 :step/content {:db/id #edb/ref 17592186069955 :tutorial/content "The **Pythagorean theorem**, also known as Pythagoras' theorem, is an important theorem related to right-angled triangles. Let's consider the right triangle depicted below.\n\n![](images/53/5351dc4269f0b0d04a8c94aa939cc32b333471752f009e5775c829896e63afdd.png)\n\nThe theorem can be written as\n\n$$\nc^{2} = a^{2} + b^{2}\n$$\n\nwhere\n\n- $\\color{red}c$ is the length of the longest side, which is called the **hypotenuse**, and\n- $\\color{blue}a$ and $\\color{blue}b$ are the lengths of the two other sides, which are called the **legs**." :tutorial/id #uuid "3906cd78-408a-5d9b-80d1-8e5892cb9cb1" :tutorial/math-academy-id 2378 :tutorial/title "Introduction"} :step/id #uuid "d159d6b3-8d4c-5cb7-b994-7c62f80c0558" :step/math-academy-id 10409 :step/next {:db/id #edb/ref 17592186069544}} {:db/id #edb/ref 17592186069544 :step/content {:db/id #edb/ref 17592186068678 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068539 :question/id #uuid "856c3429-0e56-5123-b2bc-76e3f252b404" :question/math-academy-id "e-3072"} :knowledge-point/id #uuid "b6db510b-5976-5c90-8e02-b9f61ff3327b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048187} {:db/id #edb/ref 17592186048868}] :knowledge-point/questions [{:db/id #edb/ref 17592186069295} {:db/id #edb/ref 17592186069296}] :knowledge-point/title "Finding the Length of the Hypotenuse of a Given Right Triangle"} :step/id #uuid "250f28c9-e9bf-5949-8505-fc35334043dd" :step/math-academy-id 10410 :step/next {:db/id #edb/ref 17592186069545}} {:db/id #edb/ref 17592186069545 :step/content {:db/id #edb/ref 17592186068679 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068540 :question/id #uuid "9c6ba1f6-f462-5e47-9731-a906732a46cb" :question/math-academy-id "e-3073"} :knowledge-point/id #uuid "42cc9880-912e-5dce-9b93-e6af88a411c4" :knowledge-point/questions [{:db/id #edb/ref 17592186069428} {:db/id #edb/ref 17592186069429} {:db/id #edb/ref 17592186459302} {:db/id #edb/ref 17592186480701} {:db/id #edb/ref 17592186487374}] :knowledge-point/title "Finding the Length of the Hypotenuse Given the Length of the Legs of a Right Triangle"} :step/id #uuid "134b7f42-bc95-57d8-908c-8372da83cad4" :step/math-academy-id 10411 :step/next {:db/id #edb/ref 17592186069546}} {:db/id #edb/ref 17592186069546 :step/content {:db/id #edb/ref 17592186068680 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068541 :question/id #uuid "83f7c86a-a646-5f19-bd80-2df7d218a8ea" :question/math-academy-id "e-3074"} :knowledge-point/id #uuid "91a6a152-8dd3-5439-9d49-096c5284fcd4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048274}] :knowledge-point/questions [{:db/id #edb/ref 17592186069297} {:db/id #edb/ref 17592186069300}] :knowledge-point/title "Determining the Length of a Leg Given a Right Triangle"} :step/id #uuid "f2534b51-1cec-58f8-8ea0-10c382e1a685" :step/math-academy-id 10412}] :activity/title "The Pythagorean Theorem" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068964}]}
