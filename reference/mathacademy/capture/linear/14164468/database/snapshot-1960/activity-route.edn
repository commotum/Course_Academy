#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186489375} :activity/id #uuid "5d7d6b48-4082-54df-a38c-264067bb8314" :activity/scope {:db/id #edb/ref 17592186049224 :topic/id #uuid "e4d4205c-47d1-5b87-81bd-c01b64870d2b" :topic/math-academy-id 433} :activity/steps [{:db/id #edb/ref 17592186489338 :step/content {:db/id #edb/ref 17592186489267 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a9cdac2-f621-564f-8709-0203bdf85dd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{35}{2}" :db/id #edb/ref 17592186488589} {:answer/id #uuid "60d53825-bf07-5091-90ed-8b078be85249" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{\\frac{873}{2}}" :db/id #edb/ref 17592186488656} {:answer/id #uuid "79751c18-eaa3-5051-9226-7e74700d3de0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186488710} {:answer/id #uuid "7c96d7b0-33e5-5715-9230-bacb2c9fa936" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "17" :db/id #edb/ref 17592186488719} {:answer/id #uuid "ac564bf3-c6f3-5221-811b-35794c5d512f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{323}" :db/id #edb/ref 17592186488810}] :answer-field/correct {:db/id #edb/ref 17592186488710} :answer-field/id #uuid "8a817628-1149-5ae9-912f-5d3dd1012acd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489091}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ce23a05a-85d4-5790-9eda-0cc10c821050" :question/math-academy-id "q-5650" :question/problem "![](images/3c/3c5b5a5c9531b6568c78633f5c44c8332cc722c9d88860a4b6bb9c2c336a1683.png)\n\nWhat is the length of $a$ in the triangle shown above?" :question/worked-solution "Here, we know the lengths of the hypotenuse and one leg, so let $b=\\frac{15}{2}$ and $c=\\frac{39}{2}.$ We need to find $a,$ the length of the other leg.\n\nAccording to the Pythagorean theorem, we obtain\n\n$$\n\\begin{aligned}{c}^{2} & ={a}^{2}+{b}^{2} \\\\ {a}^{2} & ={c}^{2}-{b}^{2} \\\\ a & =\\sqrt{{c}^{2}-{b}^{2}}.\\end{aligned}\n$$\n\nSubstituting in the values for $b$ and $c$ gives us\n\n$$\n\\begin{aligned}a & =\\sqrt{{(\\frac{39}{2})}^{2}-{(\\frac{15}{2})}^{2}} \\\\  & =\\sqrt{\\frac{1\\,521}{4}-\\frac{225}{4}} \\\\  & =\\sqrt{324} \\\\  & =18.\\end{aligned}\n$$"} :step/id #uuid "8c98aac9-e3f2-5011-8aaa-b9b56e695d7d" :step/next {:db/id #edb/ref 17592186489349}} {:db/id #edb/ref 17592186489349 :step/content {:db/id #edb/ref 17592186489178 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ae35f5d-fc84-5280-980e-ba21def821dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{10}" :db/id #edb/ref 17592186488563} {:answer/id #uuid "44486489-16d0-571b-ac64-959574132778" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\sqrt{5}" :db/id #edb/ref 17592186488609} {:answer/id #uuid "89a36b84-72a1-56e6-b785-03e44768abb4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186488745} {:answer/id #uuid "f2f259dd-0c52-5cac-9647-ed39eaed1dc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7\\sqrt{2}" :db/id #edb/ref 17592186488983} {:answer/id #uuid "fb25e632-b168-5065-ad33-00818427e651" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186489001}] :answer-field/correct {:db/id #edb/ref 17592186488609} :answer-field/id #uuid "d1d1d5a9-6a7c-5386-ac49-57029f04b961" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489138}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0d67eb70-42fa-5852-8a29-377a03af6acb" :question/math-academy-id "q-82392" :question/problem "A right triangle has legs of length $4$ and $8.$ Calculate the length of its hypotenuse." :question/worked-solution "Let $a=4,$ $b=8,$ and $c$ be the length of the hypotenuse. According to the Pythagorean theorem, we obtain\n\n$$\n\\begin{aligned}{c}^{2} & ={a}^{2}+{b}^{2} \\\\ c & =\\sqrt{{a}^{2}+{b}^{2}}.\\end{aligned}\n$$\n\nSubstituting in the values for $a$ and $b$ gives us\n\n$$\n\\begin{aligned}c & =\\sqrt{(4)^{2}+(8)^{2}} \\\\  & =\\sqrt{16+64} \\\\  & =\\sqrt{80} \\\\  & =4\\sqrt{5}.\\end{aligned}\n$$"} :step/id #uuid "a571d258-25ad-5505-b4a6-44cb1f7c2043"} {:db/id #edb/ref 17592186489375 :step/content {:db/id #edb/ref 17592186489258 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03528b79-9066-5700-95cd-a28d264f9a9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186488475} {:answer/id #uuid "05f4b190-6978-5583-8c36-6d2df2e0ac80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186488484} {:answer/id #uuid "0f2d72d2-a8d1-5dd9-8bea-42b1a2417a31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186488503} {:answer/id #uuid "6291ad98-e54f-5119-bf5f-b501c0c71255" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186488658} {:answer/id #uuid "9b15c0f3-e9b3-5a77-9b5d-950decf55d35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186488780}] :answer-field/correct {:db/id #edb/ref 17592186488484} :answer-field/id #uuid "912e2818-58ec-5b3c-9288-7b141fa8ef9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489096}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a9ba7727-634b-5b27-90cd-2da161027238" :question/math-academy-id "q-3710" :question/problem "![](images/66/663096ab9ecc1daca22587d94526cbf0db841602ca0b64eaa1a9477ec8a35aee.png)\n\nWhat is the length of $a$ in the triangle shown above?" :question/worked-solution "Here, we know the lengths of the hypotenuse and one leg, so let $b=12$ and $c=13.$ We need to find $a,$ the length of the other leg.\n\nAccording to the Pythagorean theorem, we obtain\n\n$$\n\\begin{aligned}{c}^{2} & ={a}^{2}+{b}^{2} \\\\ {a}^{2} & ={c}^{2}-{b}^{2} \\\\ a & =\\sqrt{{c}^{2}-{b}^{2}}.\\end{aligned}\n$$\n\nSubstituting in the values for $b$ and $c$ gives us\n\n$$\n\\begin{aligned}a & =\\sqrt{(13)^{2}-(12)^{2}} \\\\  & =\\sqrt{169-144} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$"} :step/id #uuid "e100fe69-e3de-5f66-8bf1-1a8103c6fd5e" :step/next {:db/id #edb/ref 17592186489338}}] :activity/title "The Pythagorean Theorem" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186488455}]}
