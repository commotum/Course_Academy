/choices "answer-8eb267c2-4d81-510b-a0ac-9f51187c8d5c"] ["answer-field-f0743b1d-d7b4-5ff8-9fc5-8af0138bd88a" :answer-field/choices "answer-1ca2d046-b650-55fd-a1d2-c96295731924"] ["answer-field-f0743b1d-d7b4-5ff8-9fc5-8af0138bd88a" :answer-field/choices "answer-c5129a7e-e66a-5aca-be73-9cc77c8b5f12"] ["question-759e1619-eead-5907-8f58-8d6fbf13ba52" :question/answer-fields "answer-field-f0743b1d-d7b4-5ff8-9fc5-8af0138bd88a"] [17592186110662 :knowledge-point/questions "question-759e1619-eead-5907-8f58-8d6fbf13ba52"] ["question-af8fd3b0-1f7d-5ae6-bdf4-ff12a7c85e49" :question/id #uuid "af8fd3b0-1f7d-5ae6-bdf4-ff12a7c85e49"] ["question-af8fd3b0-1f7d-5ae6-bdf4-ff12a7c85e49" :question/math-academy-id "q-22308"] ["question-af8fd3b0-1f7d-5ae6-bdf4-ff12a7c85e49" :question/problem "If $\\frac{{y}^{2}\\cdot {y}^{13}}{{y}^{12}}={y}^{n},$ then $n=$"] ["question-af8fd3b0-1f7d-5ae6-bdf4-ff12a7c85e49" :question/worked-solution "We start by using the product rule in the numerator:\n\n$$\n\\begin{aligned}\\frac{{y}^{2}\\cdot {y}^{13}}{{y}^{12}} & ={y}^{n} \\\\ \\frac{{y}^{2+13}}{{y}^{12}} & ={y}^{n} \\\\ \\frac{{y}^{15}}{{y}^{12}} & ={y}^{n}\\end{aligned}\n$$\n\nThen, we apply the quotient rule:\n\n$$\n\\begin{aligned}\\frac{{y}^{15}}{{y}^{12}} & ={y}^{n} \\\\ {y}^{15+(-12)} & ={y}^{n} \\\\ {y}^{3} & ={y}^{n}\\end{aligned}\n$$\n\nFinally, since both sides of the equation share the same base ($y$), we can equate the exponents:\n\n$$\n\\begin{aligned}{y}^{3} & ={y}^{n} \\\\ 3 & =n\\end{aligned}\n$$\n\nHence, $n=3.$"] ["question-af8fd3b0-1f7d-5ae6-bdf4-ff12a7c85e49" :question/difficulty :question.difficulty/moderate] ["answer-field-6938548d-d593-5818-8e31-5db0d3b2686a" :answer-field/id #uuid "6938548d-d593-5818-8e31-5db0d3b2686a"] ["answer-17eac886-4e63-5300-aa99-dd71380871fa" :answer/id #uuid "17eac886-4e63-5300-aa99-dd71380871fa"] ["answer-17eac886-4e63-5300-aa99-dd71380871fa" :answer/type :answer.type/math] ["answer-17eac886-4e63-5300-aa99-dd71380871fa" :answer/value "-2"] ["answer-91bd