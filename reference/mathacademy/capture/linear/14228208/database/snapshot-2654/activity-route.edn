#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186550045} :activity/id #uuid "635a428f-cdf1-5972-bb3d-42ad8fc88328" :activity/scope {:db/id #edb/ref 17592186049252 :topic/id #uuid "e6cf27ef-361e-5cae-8ab4-96194d52b166" :topic/math-academy-id 1417} :activity/steps [{:db/id #edb/ref 17592186550042 :step/content {:db/id #edb/ref 17592186549990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12c046f7-1d2c-5c08-94f0-b15b0633518f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186549346} {:answer/id #uuid "17eac886-4e63-5300-aa99-dd71380871fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186549363} {:answer/id #uuid "91bde951-cb8f-577a-896b-ce42dc1b9fb7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186549601} {:answer/id #uuid "9b468f4f-c3de-5872-a718-b96e20c9f9a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186549615} {:answer/id #uuid "d8927f65-02e1-588d-9e78-6fe1b24c1d71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186549717}] :answer-field/correct {:db/id #edb/ref 17592186549601} :answer-field/id #uuid "6938548d-d593-5818-8e31-5db0d3b2686a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549845}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "af8fd3b0-1f7d-5ae6-bdf4-ff12a7c85e49" :question/math-academy-id "q-22308" :question/problem "If $\\frac{{y}^{2}\\cdot {y}^{13}}{{y}^{12}}={y}^{n},$ then $n=$" :question/worked-solution "We start by using the product rule in the numerator:\n\n$$\n\\begin{aligned}\\frac{{y}^{2}\\cdot {y}^{13}}{{y}^{12}} & ={y}^{n} \\\\ \\frac{{y}^{2+13}}{{y}^{12}} & ={y}^{n} \\\\ \\frac{{y}^{15}}{{y}^{12}} & ={y}^{n}\\end{aligned}\n$$\n\nThen, we apply the quotient rule:\n\n$$\n\\begin{aligned}\\frac{{y}^{15}}{{y}^{12}} & ={y}^{n} \\\\ {y}^{15+(-12)} & ={y}^{n} \\\\ {y}^{3} & ={y}^{n}\\end{aligned}\n$$\n\nFinally, since both sides of the equation share the same base ($y$), we can equate the exponents:\n\n$$\n\\begin{aligned}{y}^{3} & ={y}^{n} \\\\ 3 & =n\\end{aligned}\n$$\n\nHence, $n=3.$"} :step/id #uuid "385d5250-b237-518e-a161-9e072c92d0c6"} {:db/id #edb/ref 17592186550045 :step/content {:db/id #edb/ref 17592186549985 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3010ad72-5935-55f4-a972-2133c2f9cacc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9{y}^{2}}{{x}^{3}}" :db/id #edb/ref 17592186549420} {:answer/id #uuid "8d3af29e-c891-5b3d-91d7-0ee584444542" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27{y}^{2}}{{x}^{4}}" :db/id #edb/ref 17592186549589} {:answer/id #uuid "bd4ed26e-84c6-586f-98a0-82989e8a7dde" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27{y}^{3}}{{x}^{4}}" :db/id #edb/ref 17592186549674} {:answer/id #uuid "cc14420e-7afe-5666-ae48-76b590082c86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27{y}^{3}}{{x}^{6}}" :db/id #edb/ref 17592186549698} {:answer/id #uuid "e785e421-4990-562e-bcc2-6b724b6ea31d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9{y}^{3}}{{x}^{6}}" :db/id #edb/ref 17592186549741}] :answer-field/correct {:db/id #edb/ref 17592186549698} :answer-field/id #uuid "34e11030-4cbc-51ae-ad3e-605289271154" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549826}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9cb24353-5541-5833-aaa7-2a27c3864cfb" :question/math-academy-id "q-424" :question/problem "${(\\frac{3y}{{x}^{2}})}^{3}=$" :question/worked-solution "We start by using the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{3y}{{x}^{2}})}^{3} & = \\\\ \\frac{(3y)^{3}}{{({x}^{2})}^{3}} & \\end{aligned}\n$$\n\nThen, we apply the power of product rule in the numerator and the power rule in the denominator:\n\n$$\n\\begin{aligned}\\frac{(3y)^{3}}{{({x}^{2})}^{3}} & = \\\\ \\frac{{3}^{3}{y}^{3}}{{x}^{2\\cdot 3}} & = \\\\ \\frac{27{y}^{3}}{{x}^{6}} & \\end{aligned}\n$$"} :step/id #uuid "3c44dfa5-7694-5da4-b5f0-5c65abf3a30f" :step/next {:db/id #edb/ref 17592186550076}} {:db/id #edb/ref 17592186550076 :step/content {:db/id #edb/ref 17592186549971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16185a8f-1aed-53a4-8147-fb86611335ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9{a}^{4}{b}^{5}{c}^{8}" :db/id #edb/ref 17592186549356} {:answer/id #uuid "1ca2d046-b650-55fd-a1d2-c96295731924" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9{a}^{8}{b}^{5}{c}^{4}" :db/id #edb/ref 17592186549372} {:answer/id #uuid "28dcf52a-fdfa-5969-9364-91741721e814" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9{a}^{4}{b}^{8}{c}^{5}" :db/id #edb/ref 17592186549402} {:answer/id #uuid "8eb267c2-4d81-510b-a0ac-9f51187c8d5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9{a}^{5}{b}^{4}{c}^{8}" :db/id #edb/ref 17592186549594} {:answer/id #uuid "c5129a7e-e66a-5aca-be73-9cc77c8b5f12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}^{4}{b}^{5}{c}^{8}" :db/id #edb/ref 17592186549682}] :answer-field/correct {:db/id #edb/ref 17592186549356} :answer-field/id #uuid "f0743b1d-d7b4-5ff8-9fc5-8af0138bd88a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549914}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "759e1619-eead-5907-8f58-8d6fbf13ba52" :question/math-academy-id "q-2648" :question/problem "If $x=\\frac{81{a}^{8}}{{b}^{2}{c}^{3}}$ and $y=\\frac{{b}^{7}{c}^{11}}{9{a}^{4}},$ then $xy=$" :question/worked-solution "First, we substitute for $x$ and $y:$\n\n$$\n\\begin{aligned}xy & =(\\frac{81{a}^{8}}{{b}^{2}{c}^{3}})\\cdot (\\frac{{b}^{7}{c}^{11}}{9{a}^{4}}) \\\\  & =\\frac{81{a}^{8}{b}^{7}{c}^{11}}{9{a}^{4}{b}^{2}{c}^{3}}\\end{aligned}\n$$\n\nThen, we separate the fraction, group the three variables separately, and apply the quotient rule:\n\n$$\n\\begin{aligned}\\frac{81{a}^{8}{b}^{7}{c}^{11}}{9{a}^{4}{b}^{2}{c}^{3}} & = \\\\ \\frac{81}{9}\\cdot \\frac{{a}^{8}}{{a}^{4}}\\cdot \\frac{{b}^{7}}{{b}^{2}}\\cdot \\frac{{c}^{11}}{{c}^{3}} & = \\\\ \\frac{81}{9}\\cdot {a}^{(8-4)}\\cdot {b}^{(7-2)}\\cdot {c}^{(11-3)} & = \\\\ 9{a}^{4}{b}^{5}{c}^{8} & \\end{aligned}\n$$"} :step/id #uuid "8b33002d-aae0-5d21-b694-3794848906a8" :step/next {:db/id #edb/ref 17592186550042}}] :activity/title "Combining the Rules of Exponents With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186549306}]}
