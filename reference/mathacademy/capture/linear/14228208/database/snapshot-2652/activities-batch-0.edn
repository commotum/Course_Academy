#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186111594} :activity/id #uuid "7fe1fb12-e10b-5870-8007-02f1eb2f68f4" :activity/scope {:db/id #edb/ref 17592186049252 :topic/id #uuid "e6cf27ef-361e-5cae-8ab4-96194d52b166" :topic/math-academy-id 1417} :activity/steps [{:db/id #edb/ref 17592186111594 :step/content {:db/id #edb/ref 17592186111824 :tutorial/content "Sometimes, we might need to use more than one rule of exponents to simplify an expression. First, let's remind ourselves of all of the rules of exponents.\n\n- Radicals as fractional exponents: $\\sqrt[n]{x} = x^{1/n}$\n\n- The product rule: $a^n \\cdot a^m = a^{n+m}$\n\n- The quotient rule: $\\dfrac{a^n}{a^m} = a^{n-m}$\n\n- The power rule: $\\left( a^m \\right)^n = a^{mn}$\n\n- The power of product rule: $(ab)^n = a^nb^n$\n\n- The power of quotient rule: $\\left(\\dfrac a b \\right)^n = \\dfrac{a^n}{b^n}$\n\nAs an example, let's simplify the following expression:\n\n$$\n\\left(u^2 v\\right)^3\n$$\n\nWe start by using the power of product rule:\n\n$$\n\\begin{aligned}{({u}^{2}v)}^{3}={({u}^{2})}^{3}\\cdot {v}^{3}\\end{aligned}\n$$\n\nThen, we use the power rule:\n\n$$\n\\begin{aligned}{({u}^{2})}^{3}\\cdot {v}^{3} & = \\\\ {u}^{(2\\cdot 3)}\\cdot {v}^{3} & = \\\\ {u}^{6}\\cdot {v}^{3} & = \\\\ {u}^{6}{v}^{3}\\end{aligned}\n$$" :tutorial/id #uuid "13b1c64a-c868-5824-919e-c3a665bb4a96" :tutorial/math-academy-id 1485 :tutorial/title "Introduction"} :step/id #uuid "ff971efe-57b1-5d6a-a9d6-53728830ae56" :step/math-academy-id 3561 :step/next {:db/id #edb/ref 17592186111595}} {:db/id #edb/ref 17592186111595 :step/content {:db/id #edb/ref 17592186110661 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110299 :question/id #uuid "ee3fd0ee-77a9-5ebb-9bc9-c7439f5946b4" :question/math-academy-id "e-1088"} :knowledge-point/id #uuid "854edbd5-3aef-5c6b-bb79-967aa241beb2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049729} {:db/id #edb/ref 17592186050208} {:db/id #edb/ref 17592186050802}] :knowledge-point/questions [{:db/id #edb/ref 17592186110915} {:db/id #edb/ref 17592186111165} {:db/id #edb/ref 17592186499508}] :knowledge-point/title "Combining the Rules of Exponents Without Fractions"} :step/id #uuid "a787c3de-89d7-50ac-b1ff-50a2fb31a2ab" :step/math-academy-id 3562 :step/next {:db/id #edb/ref 17592186111596}} {:db/id #edb/ref 17592186111596 :step/content {:db/id #edb/ref 17592186110662 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110300 :question/id #uuid "d8aca072-8ed5-5d49-8d4e-8bcc96a27ddb" :question/math-academy-id "e-1089"} :knowledge-point/id #uuid "736c1b75-fe60-5f0a-b426-a19f3edaaa2b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048180} {:db/id #edb/ref 17592186050672}] :knowledge-point/questions [{:db/id #edb/ref 17592186111086} {:db/id #edb/ref 17592186111192} {:db/id #edb/ref 17592186499549}] :knowledge-point/title "Combining the Rules of Exponents With Fractions"} :step/id #uuid "8884d25c-0665-5e4b-b13b-866ef3ec66f7" :step/math-academy-id 3565 :step/next {:db/id #edb/ref 17592186111601}} {:db/id #edb/ref 17592186111597 :step/content {:db/id #edb/ref 17592186110663 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110301 :question/id #uuid "cf539049-76f2-56c0-a890-00c2d767c0a8" :question/math-academy-id "e-1091"} :knowledge-point/id #uuid "014ea973-359e-53f5-9151-adc85e08bd3f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049089}] :knowledge-point/questions [{:db/id #edb/ref 17592186111333} {:db/id #edb/ref 17592186111391} {:db/id #edb/ref 17592186499483} {:db/id #edb/ref 17592186499500} {:db/id #edb/ref 17592186499524}] :knowledge-point/title "Combining the Rules of Exponents With Radicals"} :step/id #uuid "73248b69-f18a-503e-b712-b3f56ae6841a" :step/math-academy-id 3569} {:db/id #edb/ref 17592186111601 :step/content {:db/id #edb/ref 17592186111904 :tutorial/content "To simplify the expression $x\\cdot \\sqrt[3]{x^2},$ we first rewrite the radical as a fractional exponent:\n\n$$\nx \\cdot \\sqrt[3]{x^2} = x \\cdot \\left( x^2 \\right)^{1/3}\n$$\n\nNow, we apply the power rule for exponents:\n\n$$\nx \\cdot \\left( x^2 \\right)^{1/3} = x \\cdot x^{2(1/3)} = x \\cdot x^{2/3}\n$$\n\nThen, we apply the product rule:\n\n$$\n\\begin{aligned}x\\cdot {x}^{2/3} & = \\\\ {x}^{1+2/3} & = \\\\ {x}^{5/3} & \\end{aligned}\n$$\n\nFinally, we express the result as a radical:\n\n$$\nx^{5/3} = \\sqrt[3]{x^5}\n$$\n\nNotice that, by combining the radicals as fractional exponents and power rules, we get the following formula:\n\n$$\n\\sqrt[n]{x^m} = x^{m/n}\n$$" :tutorial/id #uuid "91debf57-af23-518b-b432-ea04beccc17a" :tutorial/math-academy-id 6221 :tutorial/title "Rules of Exponents and Radicals"} :step/id #uuid "d8d59c7e-2b45-5493-a09c-f4211a690c16" :step/math-academy-id 37772 :step/next {:db/id #edb/ref 17592186111597}}] :activity/title "Combining the Rules of Exponents With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110813}]}
