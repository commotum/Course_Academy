#{[{:db/id #edb/ref 17592186064102 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064257 :knowledge-point/id #uuid "724bdf2f-c9f0-564e-ae33-c64d44c582ef" :knowledge-point/title "Splitting a Rational Expression With Two Terms in the Numerator"}] :question/id #uuid "6e148f32-5352-5368-a08a-6da278a6068d" :question/math-academy-id "e-5124" :question/problem "Given that $\\dfrac{6y − 1}{3} = ay + b,$  what are the values of $a$ and $b?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\eqalign{\n\t\t\\dfrac{6y − 1}{3} &= \\\n\t\t\\dfrac{6y}{3} - \\dfrac 1 3 &= \\\n\t\t\\dfrac{6}{3} \\cdot y - \\dfrac 1 3 &= \\\t\n\t\t2 \\cdot y - \\dfrac 1 3 &= \\\t\t\n\t\t2y - \\dfrac 1 3 &.\n\t}\n$$\n\nWriting the above in the form $ay+b,$ we get\n\n$$\n\\begin{aligned}{{(2)}_{⏟}}_{a}y+{{(-\\frac{1}{3})}_{⏟}}_{b}.\\end{aligned}\n$$\n\nTherefore, $a=2$ and $b=-\\dfrac{1}{3}.$"}] [{:db/id #edb/ref 17592186064103 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064258 :knowledge-point/id #uuid "0649943a-643f-592f-8815-45c871f7e7dd" :knowledge-point/title "Splitting a Rational Expression With Three Terms in the Numerator"}] :question/id #uuid "41294f0b-dc6a-5a84-a7f8-7c2370b5733c" :question/math-academy-id "e-5125" :question/problem "Given that $\\dfrac{1 − 2a + 16b}{4} = p + qa + rb,$ what are the values of $p,$ $q,$ and $r?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\eqalign{\n\t\t\\dfrac{1 − 2a + 16b}{4} &= \\\n\t\t\\dfrac 1 4 − \\dfrac {2a} {4} + \\dfrac {16b}{4} &= \\\n\t\t\\dfrac 1 4 − \\dfrac {2} {4} \\cdot a + \\dfrac {16}{4} \\cdot b &= \\\n\t\t\\dfrac 1 4 − \\dfrac {1} {2} \\cdot a + 4 \\cdot b &= \\\t\t\n\t\t\\dfrac 1 4 − \\dfrac {a} {2} + 4b &= \\\n                \\dfrac{1}{4} - \\dfrac{1}{2}a + 4b &.\n\t}\n$$\n\nWriting the above in the form $p+qa+rb,$ we get\n\n$$\n\\begin{aligned}{{(\\frac{1}{4})}_{⏟}}_{p}+{{(-\\frac{1}{2})}_{⏟}}_{q}a+{{(4)}_{⏟}}_{r}b.\\end{aligned}\n$$\n\nTherefore, $p=\\dfrac{1}{4},$ $q=-\\dfrac{1}{2},$ and $r=4.$"}] [{:db/id #edb/ref 17592186446899 :knowledge-point/_questions [{:db/id #edb/ref 17592186064257 :knowledge-point/id #uuid "724bdf2f-c9f0-564e-ae33-c64d44c582ef" :knowledge-point/title "Splitting a Rational Expression With Two Terms in the Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "530dd5a9-f465-5462-94e9-f01a209b0d78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\frac{4a}{5}" :db/id #edb/ref 17592186446879} {:answer/id #uuid "58d31a0f-1cc7-5817-86b7-5127bda2669e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5-\\frac{a}{5}" :db/id #edb/ref 17592186446881} {:answer/id #uuid "5ed01a2f-aebe-5710-bb22-50c7d72b1cbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\frac{8a}{5}" :db/id #edb/ref 17592186446882} {:answer/id #uuid "9006bbdb-d766-5f52-962e-8440379f6cce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-8a" :db/id #edb/ref 17592186446889} {:answer/id #uuid "bbaf1a3e-a51d-568b-8426-87f8af9a03aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5-\\frac{8a}{5}" :db/id #edb/ref 17592186446892}] :answer-field/correct {:answer/id #uuid "5ed01a2f-aebe-5710-bb22-50c7d72b1cbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\frac{8a}{5}" :db/id #edb/ref 17592186446882} :answer-field/id #uuid "f376e390-4e95-5028-9093-ef1c0f9ff815" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446898}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3df2a403-93cd-5b64-9814-34a448286c87" :question/math-academy-id "q-103611" :question/problem "Which of the following is equivalent to $\\frac{10-8a}{5}?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in individual terms, we get\n\n$$\n\\begin{aligned}\\frac{10-8a}{5} & = \\\\ \\frac{10}{5}-\\frac{8a}{5} & = \\\\ 2-\\frac{8a}{5} & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186446900 :knowledge-point/_questions [{:db/id #edb/ref 17592186064258 :knowledge-point/id #uuid "0649943a-643f-592f-8815-45c871f7e7dd" :knowledge-point/title "Splitting a Rational Expression With Three Terms in the Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48a6505d-1142-59a6-8de5-35951e5ab5d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{a}{4}+\\frac{5b}{4}-\\frac{3c}{4}" :db/id #edb/ref 17592186446877} {:answer/id #uuid "5243e457-add4-5054-99f0-cb9f8d0b61ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2a+\\frac{5b}{4}+\\frac{3c}{2}" :db/id #edb/ref 17592186446878} {:answer/id #uuid "7b456930-e6cd-5a95-ac0e-a775bec47f3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{a}{2}+\\frac{5b}{4}-\\frac{3c}{2}" :db/id #edb/ref 17592186446883} {:answer/id #uuid "836a86a0-52d2-5bb6-85f7-08745b789b15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{a}{4}+\\frac{5b}{4}-3c" :db/id #edb/ref 17592186446887} {:answer/id #uuid "d9f67298-3106-53a6-9427-8810ddae2046" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{a}{2}+5b-\\frac{3c}{4}" :db/id #edb/ref 17592186446894}] :answer-field/correct {:answer/id #uuid "7b456930-e6cd-5a95-ac0e-a775bec47f3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{a}{2}+\\frac{5b}{4}-\\frac{3c}{2}" :db/id #edb/ref 17592186446883} :answer-field/id #uuid "ba3923bd-8380-52fe-8508-6d5f9d84c266" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446897}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5d87cdbc-df13-5193-a29d-fd4c82ca5467" :question/math-academy-id "q-103631" :question/problem "$\\frac{4a+10b-12c}{8}=$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in individual terms, we get\n\n$$\n\\begin{aligned}\\frac{4a+10b-12c}{8} & = \\\\ \\frac{4a}{8}+\\frac{10b}{8}-\\frac{12c}{8} & = \\\\ \\frac{4}{8}\\cdot a+\\frac{10}{8}\\cdot b-\\frac{12}{8}\\cdot c & = \\\\ \\frac{1}{2}\\cdot a+\\frac{5}{4}\\cdot b-\\frac{3}{2}\\cdot c & = \\\\ \\frac{a}{2}+\\frac{5b}{4}-\\frac{3c}{2} & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186446901 :knowledge-point/_questions [{:db/id #edb/ref 17592186064257 :knowledge-point/id #uuid "724bdf2f-c9f0-564e-ae33-c64d44c582ef" :knowledge-point/title "Splitting a Rational Expression With Two Terms in the Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01a02ab5-3cde-53e5-8def-fa56bb2f44e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-\\frac{1}{3}" :db/id #edb/ref 17592186446875} {:answer/id #uuid "41737690-1985-5531-8052-7be9b91b3f57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+\\frac{1}{2}" :db/id #edb/ref 17592186446876} {:answer/id #uuid "7e0b0d8c-0464-5afe-8503-cacd0ae75675" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+2" :db/id #edb/ref 17592186446884} {:answer/id #uuid "805c8a50-245c-58af-bd42-b38be8fbdd2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-2" :db/id #edb/ref 17592186446885} {:answer/id #uuid "94c300a0-1022-5004-81fd-c22c0bf39989" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-\\frac{1}{2}" :db/id #edb/ref 17592186446890}] :answer-field/correct {:answer/id #uuid "805c8a50-245c-58af-bd42-b38be8fbdd2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-2" :db/id #edb/ref 17592186446885} :answer-field/id #uuid "11c4f691-19c6-5faa-97dd-197cfd379445" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446895}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9cea6c8e-15d8-5c1a-96d6-c4ced565f8d5" :question/math-academy-id "q-2576" :question/problem "Which of the following is equivalent to $\\frac{6x-4}{2}?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{6x-4}{2} & = \\\\ \\frac{6x}{2}-\\frac{4}{2} & = \\\\ \\frac{6}{2}\\cdot x-\\frac{4}{2} & = \\\\ 3x-2 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233685 :knowledge-point/_questions [{:db/id #edb/ref 17592186064258 :knowledge-point/id #uuid "0649943a-643f-592f-8815-45c871f7e7dd" :knowledge-point/title "Splitting a Rational Expression With Three Terms in the Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53e9d902-de9b-55d9-9b20-355b1a1b6bf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3a-\\frac{7b}{2}+10" :db/id #edb/ref 17592186446880} {:answer/id #uuid "831a3230-7424-5169-af8a-d6d2b2861921" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6a-7b+5" :db/id #edb/ref 17592186446886} {:answer/id #uuid "8e8ed662-cf71-5e2f-b69a-b4df0b3fe84a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6a-\\frac{7b}{2}+4" :db/id #edb/ref 17592186446888} {:answer/id #uuid "b4e0c1be-f4dc-5408-81ec-caa5587b6322" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3a-\\frac{7b}{2}+5" :db/id #edb/ref 17592186446891} {:answer/id #uuid "cb08a7a3-ca83-5332-8a55-c8082691a13f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3a-2b-4" :db/id #edb/ref 17592186446893}] :answer-field/correct {:answer/id #uuid "b4e0c1be-f4dc-5408-81ec-caa5587b6322" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3a-\\frac{7b}{2}+5" :db/id #edb/ref 17592186446891} :answer-field/id #uuid "6959c732-7d08-5c84-85a6-8d75281cd02e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446896}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "76575948-5aa9-591f-9ed4-b205ffc76bed" :question/math-academy-id "q-2594" :question/problem "$\\frac{6a-7b+10}{2}=$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{6a-7b+10}{2} & = \\\\ \\frac{6a}{2}-\\frac{7b}{2}+\\frac{10}{2} & = \\\\ \\frac{6}{2}\\cdot a-\\frac{7b}{2}+\\frac{10}{2} & = \\\\ 3a-\\frac{7b}{2}+5 & .\\end{aligned}\n$$"}]}
