#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186065135} :activity/id #uuid "457bb695-c5a7-5c4b-bc54-87bb84576ab7" :activity/scope {:db/id #edb/ref 17592186048957 :topic/id #uuid "cf262221-31bc-5e58-a6f2-8acf1c2b4906" :topic/math-academy-id 355} :activity/steps [{:db/id #edb/ref 17592186065135 :step/content {:db/id #edb/ref 17592186065367 :tutorial/content "Fractions that contain multiple terms in the numerator and a single term in the denominator can be split into separate terms.\n\nFor example, \n\n$$\n\\eqalign{\n\t\t\\dfrac {x + 2} {3} &= \\\n\t\t\\dfrac x 3 + \\dfrac 2 3\n\t}\n$$\n\nand\n\n$$\n\\eqalign{\n\t\t\\dfrac {3a - 4b + 1} {5} &= \\\n\t\t\\dfrac {3a} 5 - \\dfrac {4b} 5 + \\dfrac 1 5.\n\t}\n$$\n\nOften, we're able to simplify the fractions in the individual terms, as follows:\n\n$$\n\\eqalign{\n\t\t\\dfrac {10x + 9} {2} &= \\\n\t\t\\dfrac {10x} {2} + \\dfrac 9 2 &= \\\n\t\t\\dfrac {10} {2} \\cdot x + \\dfrac 9 2 &= \\\t\n\t\t5 \\cdot x + \\dfrac 9 2 &= \\\n\t\t5x + \\dfrac 9 2 \n\t}\n$$" :tutorial/id #uuid "0a37b6ec-6750-5aea-ae26-ad82d059a0ef" :tutorial/math-academy-id 3375 :tutorial/title "Introduction"} :step/id #uuid "871a576b-9882-5cab-a267-5bfaae09bb5c" :step/math-academy-id 18870 :step/next {:db/id #edb/ref 17592186065136}} {:db/id #edb/ref 17592186065136 :step/content {:db/id #edb/ref 17592186064257 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064102 :question/id #uuid "6e148f32-5352-5368-a08a-6da278a6068d" :question/math-academy-id "e-5124"} :knowledge-point/id #uuid "724bdf2f-c9f0-564e-ae33-c64d44c582ef" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050998}] :knowledge-point/questions [{:db/id #edb/ref 17592186064665} {:db/id #edb/ref 17592186064717} {:db/id #edb/ref 17592186233078} {:db/id #edb/ref 17592186233687} {:db/id #edb/ref 17592186446899} {:db/id #edb/ref 17592186446901}] :knowledge-point/title "Splitting a Rational Expression With Two Terms in the Numerator"} :step/id #uu