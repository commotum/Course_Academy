db/ref 17592186105835 #edb/ref 17592186045417] [17592186050998 #edb/ref 1028 #edb/ref 17592186105910 #edb/ref 17592186045417] [17592186050998 #edb/ref 1028 #edb/ref 17592186105911 #edb/ref 17592186045417] [17592186050998 #edb/ref 1028 #edb/ref 17592186105912 #edb/ref 17592186045417] [17592186050998 #edb/ref 1031 "Equivalent Expressions With Fractions" #edb/ref 17592186045417] [17592186050998 #edb/ref 1033 1297 #edb/ref 17592186045417] [17592186050998 #edb/ref 1035 #uuid "782cde63-c3cf-5599-8f18-28a9d8b09d13" #edb/ref 17592186045417] [17592186064102 #edb/ref 1069 "e-5124" #edb/ref 17592186045417] [17592186064102 #edb/ref 1071 "Given that $\\dfrac{6y - 1}{3} = ay + b$, what are the values of $a$ and $b$?" #edb/ref 17592186045417] [17592186064102 #edb/ref 1072 #uuid "6e148f32-5352-5368-a08a-6da278a6068d" #edb/ref 17592186045417] [17592186064102 #edb/ref 1074 "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned} \\dfrac{6y - 1}{3} &= \\ \\dfrac{6y}{3} - \\dfrac 1 3 &= \\ \\dfrac{6}{3} \\cdot y - \\dfrac 1 3 \\\\ &= 2 \\cdot y - \\dfrac 1 3 \\\\ &= 2y - \\dfrac 1 3 &. \\end{aligned}\n$$\n\nWriting the above in the form $ay+b$, we get\n\n$$\n(2)_(⏟)_(a)y + (-\\frac{1}{3})_(⏟)_(b)\n$$\n\nTherefore, $a=2$ and\n\n$$\nb=-\\dfrac{1}{3}\n$$" #edb/ref 17592186045417] [17592186064103 #edb/ref 1069 "e-5125" #edb/ref 17592186045417] [17592186064103 #edb/ref 1071 "Given that $\\dfrac{1 - 2a + 16b}{4} = p + qa + rb$, what are the values of $p$, $q$, and $r$?" #edb/ref 17592186045417] [17592186064103 #edb/ref 1072 #uuid "41294f0b-dc6a-5a84-a7f8-7c2370b5733c" #edb/ref 17592186045417] [17592186064103 #edb/ref 1074 "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned} \\dfrac{1 - 2a + 16b}{4} &= \\ \\dfrac 1 4 - \\dfrac {2a} {4} + \\dfrac {16b}{4} &= \\ \\dfrac 1 4 - \\dfrac {2} {4} \\cdot a + \\dfrac {16}{4} \\cdot b &= \\ \\dfrac 1 4 - \\dfrac {1} {2} \\cdot a + 4 \\cdot b &= \\ \\dfrac 1 4 - \\dfrac {a} {2} + 4b &= \\ \\dfrac{1}{4} - \\dfrac{1}{2}a + 4b &. \\end{aligned}\n$$\n\nWriting the above in the form $p+qa+rb$, we get\n\n$$\n(\\frac{1}{4})_(⏟)_(p) + (-\\frac{1}{2})_(⏟)_(q)a + (4)_(⏟)_(r)b\n$$\n\nTherefore,\n\n$$\np=\\dfrac{1}{4}\n$$\n\n$$\nq=-\\dfrac{1}{2}\n$$\n\nand $r=4$." #edb/ref 17592186045417] [17592186064257 #edb/ref 1037 #edb/ref 17592186050998 #edb/ref 17592186045417] [17592186064257 #edb/ref 1038 #edb/ref 17592186064665 #edb/ref 17592186045417] [17592186064257 #edb/ref 1038 #edb/ref 17592186064717 #edb/ref 17592186045417] [17592186064257 #edb/ref 1038 #edb/ref 17592186233078 #edb/ref 17592186045417] [17592186064257 #edb/ref 1038 #edb/ref 17592186233687 #edb/ref 17592186045417] [17592186064257 #edb/ref 1039 "Splitting a Rational Expression With Two Terms in the Numerator" #edb/ref 17592186045417] [17592186064257 #edb/ref 1041 #edb/ref 17592186064102 #edb/ref 17592186045417] [17592186064257 #edb/ref 1042 #uuid "724bdf2f-c9f0-564e-ae33-c64d44c582ef" #edb/ref 17592186045417] [17592186064258 #edb/ref 1038 #edb/ref 17592186064666 #edb/ref 17592186045417] [17592186064258 #edb/ref 1038 #edb/ref 17592186064718 #edb/ref 17592186045417] [17592186064258 #edb/ref 1038 #edb/ref 17592186233685 #edb/ref 17592186045417] [17592186064258 #edb/ref 1038 #edb/ref 17592186233686 #edb/ref 17592186045417] [17592186064258 #edb/ref 1039 "Splitting a Rational Expression With Three Terms in the Numerator" #edb/ref 17592186045417] [17592186064258 #edb/ref 1041 #edb/ref 17592186064103 #edb/ref 17592186045417] [17592186064258 #edb/ref 1042 #uuid "0649943a-643f-592f-8815-45c871f7e7dd" #edb/ref 17592186045417] [17592186064444 #edb/ref 1043 #edb/ref 17592186065135 #edb/ref 17592186045417] [17592186064444 #edb/ref 1043 #edb/ref 17592186065136 #edb/ref 17592186045417] [17592186064444 #edb/ref 1043 #edb/ref 17592186065137 #edb/ref 17592186045417] [17592186064444 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186064444 #edb/ref 1045 "Splitting Rational Expressions Into Separate Terms" #edb/ref 17592186045417] [17592186064444 #edb/ref 1046 #edb/ref 17592186065135 #edb/ref 17592186045417] [17592186064444 #edb/ref 1049 #edb/ref 17592186048957 #edb/ref 17592186045417] [17592186064444 #edb/ref 1053 #uuid "457bb695-c5a7-5c4b-bc54-87bb84576ab7" #edb/ref 17592186045417] [17592186065135 #edb/ref 1058 #edb/ref 17592186065136 #edb/ref 17592186045417] [17592186065135 #edb/ref 1061 18870 #edb/ref 17592186045417] [17592186065135 #edb/ref 1062 #uuid "871a576b-9882-5cab-a267-5bfaae09bb5c" #edb/ref 17592186045417] [17592186065135 #edb/ref 1063 #edb/ref 17592186065367 #edb/ref 17592186045417] [17592186065136 #edb/ref 1058 #edb/ref 17592186065137 #edb/ref 17592186045417] [17592186065136 #edb/ref 1061 18871 #edb/ref 17592186045417] [17592186065136 #edb/ref 1062 #uuid "213c99f3-2e96-5282-8c9f-7798f6d583ee" #edb/ref 17592186045417] [17592186065136 #edb/ref 1063 #edb/ref 17592186064257 #edb/ref 17592186045417] [17592186065137 #edb/ref 1061 18872 #edb/ref 17592186045417] [17592186065137 #edb/ref 1062 #uuid "2ca88a28-b372-506f-bc28-472bf491340a" #edb/ref 17592186045417] [17592186065137 #edb/ref 1063 #edb/ref 17592186064258 #edb/ref 17592186045417] [17592186065367 #edb/ref 1064 "Fractions that contain multiple terms in the numerator and a single term in the denominator can be split into separate terms.\n\nFor example,\n\n$$\n\\begin{aligned} \\dfrac {x + 2} {3} &= \\ \\dfrac x 3 + \\dfrac 2 3 \\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned} \\dfrac {3a - 4b + 1} {5} &= \\ \\dfrac {3a} 5 - \\dfrac {4b} 5 + \\dfrac 1 5. \\end{aligned}\n$$\n\nOften, we're able to simplify the fractions in the individual terms, as follows:\n\n$$\n\\begin{aligned} \\dfrac {10x + 9} {2} &= \\ \\dfrac {10x} {2} + \\dfrac 9 2 &= \\ \\dfrac {10} {2} \\cdot x + \\dfrac 9 2 \\\\ &= 5 \\cdot x + \\dfrac 9 2 \\\\ &= 5x + \\dfrac 9 2 \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186065367 #edb/ref 1065 3375 #edb/ref 17592186045417] [17592186065367 #edb/ref 1066 #uuid "0a37b6ec-6750-5aea-ae26-ad82d059a0ef" #edb/ref 17592186045417] [17592186065367 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186233685 #edb/ref 1069 "q-2594" #edb/ref 17592186045417] [17592186233685 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186233685 #edb/ref 1071 "$\\frac{6a-7b+10}{2}=$" #edb/ref 17592186045417] [17592186233685 #edb/ref 1072 #uuid "76575948-5aa9-591f-9ed4-b205ffc76bed" #edb/ref 17592186045417] [17592186233685 #edb/ref 1074 "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{6a-7b+10}{2} & = \\\\ \\frac{6a}{2}-\\frac{7b}{2}+\\frac{10}{2} & = \\\\ \\frac{6}{2}\\cdot a-\\frac{7b}{2}+\\frac{10}{2} & = \\\\ 3a-\\frac{7b}{2}+5 & .\\end{aligned}\n$$" #edb/ref 17592186045417]}
