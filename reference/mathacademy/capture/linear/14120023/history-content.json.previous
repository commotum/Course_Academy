      "raw_html": "<div class=\"question\" id=\"question-126385\"><div class=\"questionHeader\"><span class=\"questionNumber\">3.</span><a class=\"questionKP\" href=\"/topics/3771#743\">Computing a Higher-Degree Taylor Polynomial Of a Given Function About a Given Point</a><span class=\"helpButton\" questionid=\"126385\">?</span></div><div class=\"questionText\"><p>Find the fourth-degree Taylor polynomial of <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"36\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D452 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.363em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi></mjx-texatom></mjx-script></mjx-msup></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>3</mn><mi>x</mi></mrow></msup></math></mjx-assistive-mml></mjx-container> about <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"37\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c30\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>0.</mn></math></mjx-assistive-mml></mjx-container></p>\n</div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyEasy\">E</div><span class=\"answerCreated\">Sun, Oct 11th @ 9:23 AM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 1:47</span><span class=\"answerResult\"><span style=\"color: green;\">Correct</span></span></div></div>",
      "source_file": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14120023/repairs/completeness-38b837b7033ae3be/source/f5a8f38e318215bd256b7d7676809d8b7184ef0356a9d857b6e65eaad9cee48f.html",
      "recovery": {
        "extractor_sha256": "180bb0a794550ed7d3ff1495e1cb7b445ddcb78c030b687aa004e6f85eb6d367",
        "original_source": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14120023/observations/history-q-126385-801bcc1d58a0804bde15.html",
        "source_sha256": "f5a8f38e318215bd256b7d7676809d8b7184ef0356a9d857b6e65eaad9cee48f"
