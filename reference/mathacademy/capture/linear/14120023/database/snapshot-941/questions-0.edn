#{[{:db/id #edb/ref 17592186237950 :knowledge-point/_questions [{:db/id #edb/ref 17592186092184 :knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix With Reorganization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37503db8-10d7-5583-8f30-374405d5c1fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}4 & -2 \\\\ 5 & 0\\end{aligned}][\\begin{aligned}4 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186236171} {:answer/id #uuid "4461e345-3733-5f04-8b2d-ba7bcab3ab70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{10}[\\begin{aligned}0 & 2 \\\\ -5 & 4\\end{aligned}][\\begin{aligned}4 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186236258} {:answer/id #uuid "6ca5d4f4-cb39-51c0-989f-7439bc2613f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}[\\begin{aligned}0 & -2 \\\\ 5 & 4\\end{aligned}][\\begin{aligned}4 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186236501} {:answer/id #uuid "825b8a80-c42c-526f-8704-24d7b15a4dde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{1}{10}[\\begin{aligned}0 & 2 \\\\ 5 & 4\\end{aligned}][\\begin{aligned}4 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186236631} {:answer/id #uuid "ee57336e-c7c8-555f-8bf6-a84746d0aacb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}[\\begin{aligned}4 & 2 \\\\ -5 & 0\\end{aligned}][\\begin{aligned}4 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186237317}] :answer-field/correct {:answer/id #uuid "4461e345-3733-5f04-8b2d-ba7bcab3ab70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{10}[\\begin{aligned}0 & 2 \\\\ -5 & 4\\end{aligned}][\\begin{aligned}4 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186236258} :answer-field/id #uuid "fe30c037-d401-593e-a43e-6b8a2fcfc035" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237773}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9876e0e7-b1e4-559d-b97c-350c8c6823a9" :question/math-academy-id "q-102802" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\begin{aligned}{\\begin{aligned}4x-2y=4 \\\\ 6=5x\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\begin{aligned}{\\begin{aligned}4x-2y=4 \\\\ 5x=6.\\end{aligned}\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}4 & -2 \\\\ 5 & 0\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}4 \\\\ 6\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=[\\begin{aligned}4 & -2 \\\\ 5 & 0\\end{aligned}].$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{4\\cdot 0-5\\cdot (-2)}[\\begin{aligned}0 & 2 \\\\ -5 & 4\\end{aligned}] \\\\  & =\\frac{1}{10}[\\begin{aligned}0 & 2 \\\\ -5 & 4\\end{aligned}].\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{10}[\\begin{aligned}0 & 2 \\\\ -5 & 4\\end{aligned}][\\begin{aligned}4 \\\\ 6\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287751 :knowledge-point/_questions [{:db/id #edb/ref 17592186198274 :knowledge-point/id #uuid "6290e701-b4ea-5a86-ab7e-7371c5bdc11e" :knowledge-point/title "Visualizing Unions of Uncountable Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "458475cb-7c2d-5db3-9d9a-f7dcbf9640f1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/07/070389fcdb6d69f9aa90dabbd98a0d3461e26d3e3e08b1d53b92e99688c09923.png" :db/id #edb/ref 17592186285422} {:answer/id #uuid "56cc21dc-81f2-58b5-a405-76666971f42b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0f/0f219c170d7e73a8a5c3d11afabe6763e25ade77be9ed8a0b7495a8d9f6be90c.png" :db/id #edb/ref 17592186285585} {:answer/id #uuid "57df3629-2829-5e67-a0ee-b0af9d5c5261" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/91/91f80f30887e5233d12ee814c1e991f81613bd52c9afd7334397b123b68b8bc7.png" :db/id #edb/ref 17592186285592} {:answer/id #uuid "71705615-b275-5206-9f46-e59b618b0dd6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6b/6bc02e0957ea0099329b8266d4960b542d86c19f44b4fc811ba0752512def666.png" :db/id #edb/ref 17592186285828} {:answer/id #uuid "e7ebacdf-8af4-5d1c-ad4f-a5eaba6a49e3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/42/4233644fb8c5e19f379fdbc001951869fd5d9062e1f14d0abbb53d677780fb0a.png" :db/id #edb/ref 17592186286912}] :answer-field/correct {:answer/id #uuid "458475cb-7c2d-5db3-9d9a-f7dcbf9640f1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/07/070389fcdb6d69f9aa90dabbd98a0d3461e26d3e3e08b1d53b92e99688c09923.png" :db/id #edb/ref 17592186285422} :answer-field/id #uuid "88fca9fa-b9b5-5967-9c21-b7010d8c4956" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287435}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1e98098c-88d7-594b-ad3c-687cf15456dc" :question/math-academy-id "q-181775" :question/problem "Which of the following is a representation of the set $S=R\\times R$ in the Cartesian plane?" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\n$$\nA\\times B={(a,b)\\,:\\,a\\in A,\\,b\\in B}\n$$\n\nIn this case, the set\n\n$$\nS=R\\times R\n$$\n\ncontains every point in ${R}^{2}$ whose $x$-coordinate is any real number and whose $y$-coordinate is any real number.\n\n$$\nS={(x,y)\\,:\\,x\\in R,\\,y\\in R}.\n$$\n\nTo visualize $S$, consider ${S}_{0}⊂S$ containing all points whose $x$-coordinate equals $0$ and whose $y$-coordinate is any real number.\n\n$$\n{S}_{0}={(0,y)\\,:\\,y\\in R}\n$$\n\nWe can represent ${S}_{0}$ in the plane as follows:\n\n![](images/07/07a3d9a6c38b5bfcc529496735a1a66eaceefd5ae3437a2cb0cd45911eccafae.png)\n\nNow, consider a general ${S}_{i}⊂S$ containing all points whose $x$-coordinate equals some $i\\in R$ and whose $y$-coordinate is any real number.\n\n$$\n{S}_{i}={(i,y)\\,:\\,y\\in R}\n$$\n\nFor each $i\\in R,$ ${S}_{i}$ is a vertical line.\n\n![](images/e4/e454f1cf125486ca25acf15e26efd251a4a03b08e899814ab3e77db7898713c4.png)\n\nOur Cartesian product $S$ is the union of these subsets over $R:$\n\n$$\nS={⋃}_{i\\in R}{S}_{i}.\n$$\n\nThis is the whole plane, as shown in the diagram below.\n\n![](images/07/070389fcdb6d69f9aa90dabbd98a0d3461e26d3e3e08b1d53b92e99688c09923.png)"}] [{:db/id #edb/ref 17592186390402 :knowledge-point/_questions [{:db/id #edb/ref 17592186105894 :knowledge-point/id #uuid "7d1252e9-f2ac-5adf-9cf5-ef48e35fb747" :knowledge-point/title "Determining the Image of an Object Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd55c037-00e6-5219-914e-9a5a9bd7534e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e6/e667849ed8a214e7d17871b0f96f73f83c59eec2677bfbaeaab589e04cc89e61.png" :db/id #edb/ref 17592186390404} {:answer/id #uuid "f174cb91-e1ee-5d6c-90ef-6029cbaebf29" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/52/52266ff97300b29c85ac14f5b60b308d9e8a0e2fe3a01e8e0431b643e6a28922.png" :db/id #edb/ref 17592186390405} {:answer/id #uuid "071cdea1-0dac-5f25-b6f4-63481ba1e33c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1a/1a027e19617c0c62fd8f5247c6d1bbac894f9522ec9e90aec5b7ed05b3996b37.png" :db/id #edb/ref 17592186390406} {:answer/id #uuid "dd9aba44-7003-5d32-9bce-752796690c23" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ca/cac3c2b4fb6191aa9a523b445d8533774f438d24556ea79b8e67a4d6c3867526.png" :db/id #edb/ref 17592186390407} {:answer/id #uuid "38ce622d-f9f2-50a8-99cd-404657278c3a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f7/f7033ca262624a9723186563638f5ff006d4174a82349be0812ac3de4c25af5e.png" :db/id #edb/ref 17592186390408}] :answer-field/correct {:answer/id #uuid "f174cb91-e1ee-5d6c-90ef-6029cbaebf29" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/52/52266ff97300b29c85ac14f5b60b308d9e8a0e2fe3a01e8e0431b643e6a28922.png" :db/id #edb/ref 17592186390405} :answer-field/id #uuid "8cfcca37-0c5f-5e1f-94b7-02dbf414d41e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390403}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f7e170ff-3ef3-51ef-bb76-d32ad791f4a6" :question/math-academy-id "q-21058" :question/problem "![](images/fe/fee79ec0b214a4ba87400b4b8c9dab2c623878d067821c572b26ae241625c48a.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}2 & 1 \\\\ 10 & 5\\end{aligned}].\n$$\n\nWhich of the following is the image of the triangle shown above under the action of $T?$" :question/worked-solution "To find the image of the triangle under the action of $T$, we first create a matrix $X$ containing all of the vertices of the triangle:\n\n$$\nX=[\\begin{aligned}1 & 1 & 2 \\\\ 0 & 1 & 1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & 1 \\\\ 10 & 5\\end{aligned}][\\begin{aligned}1 & 1 & 2 \\\\ 0 & 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 3 & 5 \\\\ 10 & 15 & 25\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the image's vertices are $(2,10)$, $(3,15)$, and  $(5,25).$  Notice that all three points lie on the same line.\n\n![](images/bf/bf5987fde11416780a6a599e3952db7319e1c0e859e2439b7df70c5659bc6839.png)"}]}
