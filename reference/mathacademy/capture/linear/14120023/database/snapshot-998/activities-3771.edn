#{[{:activity/first-step {:db/id #edb/ref 17592186184960} :activity/id #uuid "2d8d094d-3193-5fac-913b-86ed4139db30" :activity/scope {:db/id #edb/ref 17592186048482 :topic/id #uuid "a35b2494-edfb-5f14-91d5-3c70b0096e14" :topic/math-academy-id 3771} :activity/steps [{:db/id #edb/ref 17592186184960 :step/content {:db/id #edb/ref 17592186185298 :tutorial/content "The $n$th-degree Taylor polynomial of a function $f(x)$ around the point $x=a$ is\n\n$$\nP_n(x) = f(a) + f'(a)(x-a) + \\dfrac{f''(a)}{2!}(x-a)^2 + \\cdots + \\dfrac{f^{(n)}(a)}{n!}(x-a)^n.\n$$\n\nIn particular, the coefficient of the $k$th-degree term is\n\n$$\n\\dfrac{f^{(k)}(a)}{k!}.\n$$" :tutorial/id #uuid "8570bb84-4036-5426-9b9a-4050bb0a0f6b" :tutorial/math-academy-id 1289 :tutorial/title "Introduction"} :step/id #uuid "813e9605-20b7-56b3-aa91-7c8f9b64c19b" :step/math-academy-id 2535 :step/next {:db/id #edb/ref 17592186184961}} {:db/id #edb/ref 17592186184961 :step/content {:db/id #edb/ref 17592186184189 :knowledge-point/canonical-example {:db/id #edb/ref 17592186184087 :question/id #uuid "05dec044-4b3b-5f42-88c5-b7ab323b0e97" :question/math-academy-id "e-743"} :knowledge-point/id #uuid "22d992a1-2ea8-5226-9971-188447f98ab6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050866}] :knowledge-point/questions [{:db/id #edb/ref 17592186184851} {:db/id #edb/ref 17592186184883} {:db/id #edb/ref 17592186262609} {:db/id #edb/ref 17592186262610} {:db/id #edb/ref 17592186319170} {:db/id #edb/ref 17592186319171} {:db/id #edb/ref 17592186320906} {:db/id #edb/ref 17592186320907} {:db/id #edb/ref 17592186320908} {:db/id #edb/ref 17592186320909} {:db/id #edb/ref 17592186351239} {:db/id #edb/ref 17592186351344} {:db/id #edb/ref 17592186351346} {:db/id #edb/ref 17592186351348} {:db/id #edb/ref 17592186369338} {:db/id #edb/ref 17592186416141}] :knowledge-point/title "Computing a Higher-Degree Taylor Polynomial Of a Given Function About a Given Point"} :step/id #uuid "2af6d490-9670-5c6f-871c-b37af160c40d" :step