b/ref 1063 #edb/ref 17592186184189 #edb/ref 17592186045417] [17592186184962 #edb/ref 1061 2538 #edb/ref 17592186045417] [17592186184962 #edb/ref 1062 #uuid "0fe424cb-a6ec-5b72-809e-e18f76d90bda" #edb/ref 17592186045417] [17592186184962 #edb/ref 1063 #edb/ref 17592186184190 #edb/ref 17592186045417] [17592186185298 #edb/ref 1064 "The $n$th-degree Taylor polynomial of a function $f(x)$ around the point $x=a$ is\n\n$$\nP_n(x) = f(a) + f'(a)(x-a) + \\dfrac{f''(a)}{2!}(x-a)^2 + \\cdots + \\dfrac{f^{(n)}(a)}{n!}(x-a)^n.\n$$\n\nIn particular, the coefficient of the $k$th-degree term is\n\n$$\n\\dfrac{f^{(k)}(a)}{k!}.\n$$" #edb/ref 17592186045417] [17592186185298 #edb/ref 1065 1289 #edb/ref 17592186045417] [17592186185298 #edb/ref 1066 #uuid "8570bb84-4036-5426-9b9a-4050bb0a0f6b" #edb/ref 17592186045417] [17592186185298 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186198272 #edb/ref 1037 #edb/ref 17592186048899 #edb/ref 17592186045417] [17592186198272 #edb/ref 1037 #edb/ref 17592186050367 #edb/ref 17592186045417] [17592186198272 #edb/ref 1037 #edb/ref 17592186050432 #edb/ref 17592186045417] [17592186198272 #edb/ref 1037 #edb/ref 17592186050763 #edb/ref 17592186045417] [17592186198272 #edb/ref 1037 #edb/ref 17592186050923 #edb/ref 17592186045417] [17592186198272 #edb/ref 1038 #edb/ref 17592186198802 #edb/ref 17592186045417] [17592186198272 #edb/ref 1038 #edb/ref 17592186198807 #edb/ref 17592186045417] [17592186198272 #edb/ref 1038 #edb/ref 17592186287775 #edb/ref 17592186045417] [17592186198272 #edb/ref 1038 #edb/ref 17592186287870 #edb/ref 17592186045417] [17592186198272 #edb/ref 1038 #edb/ref 17592186287871 #edb/ref 17592186045417] [17592186198272 #edb/ref 1038 #edb/ref 17592186389895 #edb/ref 17592186045417] [17592186198272 #edb/ref 1038 #edb/ref 17592186390326 #edb/ref 17592186045417] [17592186198272 #edb/ref 1038 #edb/ref 17592186421830 #edb/ref 17592186045417] [17592186198272 #edb/ref 1039 "Sketching Cartesian Products in the Coordinate Plane" #edb/ref 17