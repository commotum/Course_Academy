#{[{:db/id #edb/ref 17592186068486 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068701 :knowledge-point/id #uuid "4e5366dd-a374-5abd-bdf6-77f378f97145" :knowledge-point/title "Evaluating a Function"}] :question/id #uuid "38228952-21ef-5caf-9805-76e42ebf0caa" :question/math-academy-id "e-14148" :question/problem "If $g(x) = (x-4)^2+3(5-x)$, calculate $g(2)$." :question/worked-solution "We substitute $x=2$ into the function definition and then simplify:\n\n$$\n\\begin{aligned} g(x) &= (x-4)^2+3(5-x) \\\\[5pt] g(2) &= (2-4)^2+3(5-2) \\\\[5pt] &= (-2)^2+3(3) \\\\[5pt] &= 4 + 9 \\\\[5pt] &= 13 \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068487 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068702 :knowledge-point/id #uuid "2b5f42de-fad6-54b6-90e1-205fdbe8a456" :knowledge-point/title "Evaluating a Multivariable Function"}] :question/id #uuid "4e06fa0b-f3f0-5e60-9a83-67a393b4cc07" :question/math-academy-id "e-14150" :question/problem "Evaluate $f(4,-1)$ if $f(x,y)= 3\\cdot 2^{x+3y}$." :question/worked-solution "We substitute $x=4$ and $y=-1$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}\nf(x, y) &= 3 \\cdot 2^{x + 3y} \\\\\nf(4,-1) &= 3 \\cdot 2^{4 + 3(-1)} \\\\\n&= 3 \\cdot 2^{4 - 3} \\\\\n&= 3 \\cdot 2^{1} \\\\\n&= 3 \\cdot 2 \\\\\n&= 6\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069116 :knowledge-point/_questions [{:db/id #edb/ref 17592186068702 :knowledge-point/id #uuid "2b5f42de-fad6-54b6-90e1-205fdbe8a456" :knowledge-point/title "Evaluating a Multivariable Function"}] :question/answer-fields [{:answer-field/id #uuid "74b4fbd0-e9dc-5227-bfa5-f00035d005f9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186066112}] :question/id #uuid "4b5fe75d-7a98-5eb6-b62b-621c886c5581" :question/math-academy-id "q-212133" :question/problem "If $g(a, b) = (a - b)(a^{2} - b^{2})$, then $g(2,-2) =$ {{field-1}}."}]}
