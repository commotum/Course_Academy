#{[{:db/id #edb/ref 17592186068486 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068701 :knowledge-point/id #uuid "4e5366dd-a374-5abd-bdf6-77f378f97145" :knowledge-point/title "Evaluating a Function"}] :question/id #uuid "38228952-21ef-5caf-9805-76e42ebf0caa" :question/math-academy-id "e-14148" :question/problem "If $g(x) = (x-4)^2+3(5-x)$, calculate $g(2).$" :question/worked-solution "We substitute $x=2$ into the function definition and then simplify:\n\n$$\n\\eqalign{\n\t\tg(x) &= (x-4)^2+3(5-x) \\[5pt]\n\t\tg(2) &= (2-4)^2+3(5-2) \\[5pt]\n\t\t      &= (-2)^2+3(3) \\[5pt]\n\t\t      &= 4 + 9 \\[5pt]\n\t\t      &= 13\n\t}\n$$"}] [{:db/id #edb/ref 17592186068487 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068702 :knowledge-point/id #uuid "2b5f42de-fad6-54b6-90e1-205fdbe8a456" :knowledge-point/title "Evaluating a Multivariable Function"}] :question/id #uuid "4e06fa0b-f3f0-5e60-9a83-67a393b4cc07" :question/math-academy-id "e-14150" :question/problem "Evaluate $f(4,-1)$ if $f(x,y)= 3\\cdot 2^{x+3y}.$" :question/worked-solution "We substitute $x=4$ and $y=-1$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x,y) & =3\\cdot {2}^{x+3y} \\\\ f(4,-1) & =3\\cdot {2}^{4+3(-1)} \\\\  & =3\\cdot {2}^{4-3} \\\\  & =3\\cdot {2}^{1} \\\\  & =3\\cdot 2 \\\\  & =6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186482569 :knowledge-point/_questions [{:db/id #edb/ref 17592186068702 :knowledge-point/id #uuid "2b5f42de-fad6-54b6-90e1-205fdbe8a456" :knowledge-point/title "Evaluating a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "111ff245-85aa-568e-aeb5-1f58b333c4bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186481817} {:answer/id #uuid "6da051be-bc81-55c6-82ce-1cbc6e6910b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186482029} {:answer/id #uuid "