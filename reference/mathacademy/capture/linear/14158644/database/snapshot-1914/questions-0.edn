orrect {:answer/id #uuid "d8d28ec1-8bca-5b66-95e1-e3b9c1576a50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186482290} :answer-field/id #uuid "74b4fbd0-e9dc-5227-bfa5-f00035d005f9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186066112}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4b5fe75d-7a98-5eb6-b62b-621c886c5581" :question/math-academy-id "q-212133" :question/problem "If $g(a,b)=(a-b)({a}^{2}-{b}^{2}),$ then $g(2,-2)=${{field-1}}." :question/worked-solution "We substitute $a=2$ and $b=-2$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}g(a,b) & =(a-b)({a}^{2}-{b}^{2}) \\\\ g(2,-2) & =((2)-(-2))((2)^{2}-(-2)^{2}) \\\\  & =(2+2)(4-4) \\\\  & =4\\cdot 0 \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186482526 :knowledge-point/_questions [{:db/id #edb/ref 17592186068702 :knowledge-point/id #uuid "2b5f42de-fad6-54b6-90e1-205fdbe8a456" :knowledge-point/title "Evaluating a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41647c32-39d8-5520-9ac1-9758281e2a40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186481935}] :answer-field/correct {:answer/id #uuid "41647c32-39d8-5520-9ac1-9758281e2a40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186481935} :answer-field/id #uuid "74583649-f1a5-51a3-a457-5e1abe4ddf06" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186482437}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "377f9da3-7e91-540b-b15e-84984d6004ce" :question/math-academy-id "q-214851" :question/problem "If $g(u,v)=3\\cdot {5}^{2u-3v}-2u,$ then $g(5,3)=${{field-1}}." :question/worked-solution "We substitute $u=5$ and $v=3$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}g(u,v) & =3\\cdot {5}^{2u-3v}-2u \\\\ g(5,3) & =3\\cdot {5}^{2(5)-3(3)}-2(5) \\\\  & =3\\cdot {5}^{10-9}-10 \\\\  & =3\\cdot {5}^{1}-10 \\\\  & =15-10 \\\\  & =5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186482574 :knowledge-point/_questions [{:db/id #edb/ref 17592186068701 :knowledge-point/id #uuid "4e5366dd-a374-5abd-bdf6-77f378f97145" :knowledge-point/title "Evaluating a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c65c371-84c2-5336-a5ba-b786e1391ad7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g(2)=16" :db/id #edb/ref 17592186481850} {:answer/id #uuid "21a4b4b6-d1ed-5313-8755-aabe9512feb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g(2)=20" :db/id #edb/ref 17592186481865} {:answer/id #uuid "43ed415e-f5fe-55ff-8e1c-c259e3c52856" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g(2)=32" :db/id #edb/ref 17592186481941} {:answer/id #uuid "9deb7ae3-7740-5a1f-837e-aa18418ee2b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g(2)=10" :db/id #edb/ref 17592186482151} {:answer/id #uuid "b857a0f1-501b-5f87-851a-332c8930b6b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g(2)=30" :db/id #edb/ref 17592186482213}] :answer-field/correct {:answer/id #uuid "b857a0f1-501b-5f87-851a-332c8930b6b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g(2)=30" :db/id #edb/ref 17592186482213} :answer-field/id #uuid "9efe11b6-9e5a-5718-855d-0ceb47e59c9e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186482462}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a662c339-4277-548c-aaa6-345c7b02ceaa" :question/math-academy-id "q-31666" :question/problem "Evaluate $g(2),$ if $g(x)=(x-3)(x+4)(x-7).$" :question/worked-solution "We substitute $x=2$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}g(x) & =(x-3)(x+4)(x-7) \\\\ g(2) & =(2-3)(2+4)(2-7) \\\\  & =(-1)(6)(-5) \\\\  & =30\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186482561 :knowledge-point/_questions [{:db/id #edb/ref 17592186068701 :knowledge-point/id #uuid "4e5366dd-a374-5abd-bdf6-77f378f97145" :knowledge-point/title "Evaluating a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ca75c3d-4868-5830-9738-11577069a7a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186481959} {:answer/id #uuid "5bdec0d5-25bb-599c-bb88-de95a33396e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186481991} {:answer/id #uuid "8d159bd3-ad14-53c2-a7b8-ac88014f10b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186482104} {:answer/id #uuid "c773536d-4803-5b61-b3eb-4cda7f75454f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186482248} {:answer/id #uuid "e2cc33ad-9851-56cb-8073-0d7b5da205d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186482310}] :answer-field/correct {:answer/id #uuid "8d159bd3-ad14-53c2-a7b8-ac88014f10b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186482104} :answer-field/id #uuid "8f16ab47-5e41-5f62-8b8a-f141f8ee7ffc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186482453}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "86c185f8-7069-5803-a8a3-6aebf9cf8dbc" :question/math-academy-id "q-35796" :question/problem "Find the value of $f(t)=(t+1)^{2}-2(t+1)$ at $t=-2.$" :question/worked-solution "We substitute $t=-2$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}f(t) & =(t+1)^{2}-2(t+1) \\\\ f(-2) & =(-2+1)^{2}-2(-2+1) \\\\  & =(-1)^{2}-2(-1) \\\\  & =1+2 \\\\  & =3\\end{aligned}\n$$"}]}
