edb/ref 17592186054837 #edb/ref 17592186045417] [17592186050613 #edb/ref 1031 "Solving One-Step Multiplication and Division Equations" #edb/ref 17592186045417] [17592186050613 #edb/ref 1033 40 #edb/ref 17592186045417] [17592186050613 #edb/ref 1035 #uuid "58d4d7b7-4b91-5e3c-ba04-7522d5cfa8f6" #edb/ref 17592186045417] [17592186110316 #edb/ref 1069 "e-13058" #edb/ref 17592186045417] [17592186110316 #edb/ref 1071 "If $z + 9 = 12$, then what is the value of $z$?" #edb/ref 17592186045417] [17592186110316 #edb/ref 1072 #uuid "4fe9cbfc-9788-5596-83f2-56bddc767eb2" #edb/ref 17592186045417] [17592186110316 #edb/ref 1074 "If we substitute\n\n$$\n{\\color{blue}{z}}={\\color{blue}{3}}\n$$\n\ninto the given equation, we get a true statement:\n\n$$\n\\begin{aligned}\nz + 9 &= 12 \\\\\n3 + 9 &= 12 \\\\\n12 &= 12✓\n\\end{aligned}\n$$\n\nTherefore, the solution is $z=3$." #edb/ref 17592186045417] [17592186110317 #edb/ref 1069 "e-13059" #edb/ref 17592186045417] [17592186110317 #edb/ref 1071 "What is the solution to the equation $a - 3 = 4$?" #edb/ref 17592186045417] [17592186110317 #edb/ref 1072 #uuid "8f332559-5eb1-52ca-835e-b0da5a5a29ad" #edb/ref 17592186045417] [17592186110317 #edb/ref 1074 "If we substitute\n\n$$\n{\\color{blue}{a}}={\\color{blue}{7}}\n$$\n\ninto the given equation, we get a true statement:\n\n$$\n\\begin{aligned}\na - 3 &= 4 \\\\\n7 - 3 &= 4 \\\\\n4 &= 4✓\n\\end{aligned}\n$$\n\nTherefore, the solution is $a=7$." #edb/ref 17592186045417] [17592186110318 #edb/ref 1069 "e-13060" #edb/ref 17592186045417] [17592186110318 #edb/ref 1071 "If $2b = 8$, then $b=$" #edb/ref 17592186045417] [17592186110318 #edb/ref 1072 #uuid "5204a10c-ec1e-5276-95f2-0842b4c1bdf5" #edb/ref 17592186045417] [17592186110318 #edb/ref 1074 "If we substitute\n\n$$\n{\\color{blue}{b}}={\\color{blue}{4}}\n$$\n\ninto the given equation, we get a true statement:\n\n$$\n\\begin{aligned}\n2b &= 8 \\\\\n2 \\cdot 4 &= 8 \\\\\n8 &= 8✓\n\\end{aligned}\n$$\n\nTherefore, the solution is $b=4$." #edb/ref 17592186045417] [17592186110319 #edb/ref 1069 "e-13061" #edb/ref 17592186045417] [17592186110319 #edb/ref 1071 "If $\\dfrac{15}{c} = 5$, then $c=$" #edb/ref 17592186045417] [17592186110319 #edb/ref 1072 #uuid "e2be2f3b-d507-5447-9ed0-d164374a8b4a" #edb/ref 17592186045417] [17592186110319 #edb/ref 1074 "If we substitute\n\n$$\n{\\color{blue}{c}}={\\color{blue}{3}}\n$$\n\ninto the given equation, we get a true statement:\n\n$$\n\\begin{aligned}\n\\frac{15}{c} &= 5 \\\\\n\\frac{15}{3} &= 5 \\\\\n5 &= 5✓\n\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\nc = \\bbox[3pt,Gainsboro]{\\color{blue}3}\n$$" #edb/ref 17592186045417] [17592186110737 #edb/ref 1037 #edb/ref 17592186050127 #edb/ref 17592186045417] [17592186110737 #edb/ref 1038 #edb/ref 17592186111330 #edb/ref 17592186045417] [17592186110737 #edb/ref 1038 #edb/ref 17592186111348 #edb/ref 17592186045417] [17592186110737 #edb/ref 1039 "Solving Linear Equations Involving Addition" #edb/ref 17592186045417] [17592186110737 #edb/ref 1041 #edb/ref 17592186110316 #edb/ref 17592186045417] [17592186110737 #edb/ref 1042 #uuid "a7f85a2c-76f2-5c56-b6a0-3a0cc95150b7" #edb/ref 17592186045417] [17592186110738 #edb/ref 1038 #edb/ref 17592186111231 #edb/ref 17592186045417] [17592186110738 #edb/ref 1038 #edb/ref 17592186111327 #edb/ref 17592186045417] [17592186110738 #edb/ref 1039 "Solving Linear Equations Involving Subtraction" #edb/ref 17592186045417] [17592186110738 #edb/ref 1041 #edb/ref 17592186110317 #edb/ref 17592186045417] [17592186110738 #edb/ref 1042 #uuid "a4381161-582b-5cbf-8b0a-1e6d6aa32077" #edb/ref 17592186045417] [17592186110739 #edb/ref 1038 #edb/ref 17592186110962 #edb/ref 17592186045417] [17592186110739 #edb/ref 1038 #edb/ref 17592186111232 #edb/ref 17592186045417] [17592186110739 #edb/ref 1038 #edb/ref 17592186111328 #edb/ref 17592186045417] [17592186110739 #edb/ref 1039 "Solving Linear Equations Involving Multiplication" #edb/ref 17592186045417] [17592186110739 #edb/ref 1041 #edb/ref 17592186110318 #edb/ref 17592