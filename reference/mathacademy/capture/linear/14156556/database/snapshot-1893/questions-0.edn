#{[{:db/id #edb/ref 17592186110316 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110737 :knowledge-point/id #uuid "a7f85a2c-76f2-5c56-b6a0-3a0cc95150b7" :knowledge-point/title "Solving Linear Equations Involving Addition"}] :question/id #uuid "4fe9cbfc-9788-5596-83f2-56bddc767eb2" :question/math-academy-id "e-13058" :question/problem "If $z + 9 = 12$, then what is the value of $z$?" :question/worked-solution "If we substitute\n\n$$\n{\\color{blue}{z}}={\\color{blue}{3}}\n$$\n\ninto the given equation, we get a true statement:\n\n$$\n\\begin{aligned}\nz + 9 &= 12 \\\\\n3 + 9 &= 12 \\\\\n12 &= 12✓\n\\end{aligned}\n$$\n\nTherefore, the solution is $z=3$."}] [{:db/id #edb/ref 17592186110317 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110738 :knowledge-point/id #uuid "a4381161-582b-5cbf-8b0a-1e6d6aa32077" :knowledge-point/title "Solving Linear Equations Involving Subtraction"}] :question/id #uuid "8f332559-5eb1-52ca-835e-b0da5a5a29ad" :question/math-academy-id "e-13059" :question/problem "What is the solution to the equation $a - 3 = 4$?" :question/worked-solution "If we substitute\n\n$$\n{\\color{blue}{a}}={\\color{blue}{7}}\n$$\n\ninto the given equation, we get a true statement:\n\n$$\n\\begin{aligned}\na - 3 &= 4 \\\\\n7 - 3 &= 4 \\\\\n4 &= 4✓\n\\end{aligned}\n$$\n\nTherefore, the solution is $a=7$."}] [{:db/id #edb/ref 17592186110318 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110739 :knowledge-point/id #uuid "65ff89be-b8a4-5efd-9240-863ea90dcc1b" :knowledge-point/title "Solving Linear Equations Involving Multiplication"}] :question/id #uuid "5204a10c-ec1e-5276-95f2-0842b4c1bdf5" :question/math-academy-id "e-13060" :question/problem "If $2b = 8$, then $b=$" :question/worked-solution "If we substitute\n\n$$\n{\\color{blue}{b}}={\\color{blue}{4}}\n$$\n\ninto the given equation, we get a true statement:\n\n$$\n\\begin{aligned}\n2b &= 8 \\\\\n2 \\cdot 4 &= 8 \\\\\n8 &= 8✓\n\\end{aligned}\n$$\n\nTherefore, the solution is $b=4$."}] [{:db/id #edb/ref 17592186110319 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110740 :knowledge-point/id #uuid "36bf1a80-e4c3-5219-91d9-9f4f619ace33" :knowledge-point/title "Solving Linear Equations Involving Division"}] :question/id #uuid "e2be2f3b-d507-5447-9ed0-d164374a8b4a" :question/math-academy-id "e-13061" :question/problem "If $\\dfrac{15}{c} = 5$, then $c=$" :question/worked-solution "If we substitute\n\n$$\n{\\color{blue}{c}}={\\color{blue}{3}}\n$$\n\ninto the given equation, we get a true statement:\n\n$$\n\\begin{aligned}\n\\frac{15}{c} &= 5 \\\\\n\\frac{15}{3} &= 5 \\\\\n5 &= 5✓\n\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\nc = \\bbox[3pt,Gainsboro]{\\color{blue}3}\n$$"}]}
