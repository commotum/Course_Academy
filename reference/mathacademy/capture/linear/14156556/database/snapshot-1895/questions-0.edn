#{[{:db/id #edb/ref 17592186110316 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110737 :knowledge-point/id #uuid "a7f85a2c-76f2-5c56-b6a0-3a0cc95150b7" :knowledge-point/title "Solving Linear Equations Involving Addition"}] :question/id #uuid "4fe9cbfc-9788-5596-83f2-56bddc767eb2" :question/math-academy-id "e-13058" :question/problem "If $z + 9 = 12,$ then what is the value of $z?$" :question/worked-solution "If we substitute ${\\color{blue}{z}}={\\color{blue}{3}}$ into the given equation, we get a true statement:\n\n$$\n\\begin{aligned}z+9 & =12 \\\\ 3+9 & =12 \\\\ 12 & =12\\,✓\\end{aligned}\n$$\n\nTherefore, the solution is $z=3.$"}] [{:db/id #edb/ref 17592186110317 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110738 :knowledge-point/id #uuid "a4381161-582b-5cbf-8b0a-1e6d6aa32077" :knowledge-point/title "Solving Linear Equations Involving Subtraction"}] :question/id #uuid "8f332559-5eb1-52ca-835e-b0da5a5a29ad" :question/math-academy-id "e-13059" :question/problem "What is the solution to the equation $a - 3 = 4?$" :question/worked-solution "If we substitute ${\\color{blue}{a}}={\\color{blue}{7}}$ into the given equation, we get a true statement:\n\n$$\n\\begin{aligned}a-3 & =4 \\\\ 7-3 & =4 \\\\ 4 & =4\\,✓\\end{aligned}\n$$\n\nTherefore, the solution is $a=7.$"}] [{:db/id #edb/ref 17592186110318 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110739 :knowledge-point/id #uuid "65ff89be-b8a4-5efd-9240-863ea90dcc1b" :knowledge-point/title "Solving Linear Equations Involving Multiplication"}] :question/id #uuid "5204a10c-ec1e-5276-95f2-0842b4c1bdf5" :question/math-academy-id "e-13060" :question/problem "If $2b = 8,$ then $b=$" :question/worked-solution "If we substitute ${\\color{blue}{b}}={\\color{blue}{4}}$ into the given equation, we get a true statement:\n\n$$\n\\begin{aligned}2b & =8 \\\\ 2\\cdot 4 & =8 \\\\ 8 & =8\\,✓\\end{aligned}\n$$\n\nTherefore, the solution is $b=4.$"}] [{:db/id #edb/ref 17592186110319 :knowled