#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186111710} :activity/id #uuid "3431fc8c-c600-51f4-8d15-f78c817eddd7" :activity/scope {:db/id #edb/ref 17592186050414 :topic/id #uuid "46e68909-9583-59bd-9b81-a80e5ed3b316" :topic/math-academy-id 1412} :activity/steps [{:db/id #edb/ref 17592186111710 :step/content {:db/id #edb/ref 17592186111910 :tutorial/content "An **equation** consists of two mathematical expressions separated by an equals $(=)$ sign. The expressions may or may not contain variables. Two examples of equations are shown below:\n\n$$\n2 + 3 = 5 \\qquad\\qquad 2 + x = 5\n$$\n\n \n\nAn equation is **true** if the expression to the left side of the equals sign is equal to the expression on the right side. Otherwise, if the left side is not equal to the right side, then the equation is **false**. For instance,\n\n- the equation $2 + 3 = 5$ is **true**, whereas\n\n- the equation $2+2 = 5$ is **false**.\n\nAs a result, the equation\n\n$$\n2 + x = 5\n$$\n\nis true *only if* $x=3.$ We say that $x=3$ is the **solution** to the equation $2+x=5.$" :tutorial/id #uuid "72db5a21-14d9-5476-a1be-f9fddc69fb06" :tutorial/math-academy-id 8166 :tutorial/title "Introduction"} :step/id #uuid "81121f82-1fec-57a5-a0d8-dc18a6499494" :step/math-academy-id 73231 :step/next {:db/id #edb/ref 17592186111711}} {:db/id #edb/ref 17592186111711 :step/content {:db/id #edb/ref 17592186110737 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110316 :question/id #uuid "4fe9cbfc-9788-5596-83f2-56bddc767eb2" :question/math-academy-id "e-13058"} :knowledge-point/id #uuid "a7f85a2c-76f2-5c56-b6a0-3a0cc95150b7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050127}] :knowledge-point/questions [{:db/id #edb/ref 17592186111330} {:db/id #edb/ref 17592186111348} {:db/id #edb/ref 17592186479829} {:db/id #edb/ref 17592186479864}] :knowledge-point/title "Solving Linear Equations Involving Addition"} :step/id #uuid "115c6749-158b-533c-af14-a1f2e5b