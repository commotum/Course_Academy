{
  "dom_id": "step-73235",
  "name": "Example: \n                    Solving Linear Equations Involving Subtraction",
  "problem": "What is the solution to the equation $a - 3 = 4?$",
  "worked_solution": "If we substitute ${\\color{blue}{a}}={\\color{blue}{7}}$ into the given equation, we get a true statement:\n\n$$\n\\begin{aligned}a-3 & =4 \\\\ 7-3 & =4 \\\\ 4 & =4\\,✓\\end{aligned}\n$$\n\nTherefore, the solution is $a=7.$",
  "calculator_instructions": "",
  "fields": [],
  "problem_field_keys": [],
  "answer_fields_complete": null,
  "result": null,
  "proof_feedback": null,
