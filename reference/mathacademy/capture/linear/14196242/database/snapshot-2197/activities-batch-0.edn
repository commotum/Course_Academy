#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074610} :activity/id #uuid "d1e56cd5-fc3b-5ec2-ae90-20ca4a2e732f" :activity/scope {:db/id #edb/ref 17592186050665 :topic/id #uuid "5d634c2c-a4e7-591a-891e-89c65f30d787" :topic/math-academy-id 529} :activity/steps [{:db/id #edb/ref 17592186074610 :step/content {:db/id #edb/ref 17592186075043 :tutorial/content "Remember that a **unit fraction** is a fraction containing $1$ in the numerator. \n\nFor example, the following fractions are unit fractions since they each contain ${\\color{blue}{1}}$ in the numerator:\n\n$$\n\\dfrac{\\color{blue}{1}}{2}, \\qquad \\dfrac{\\color{blue}{1}}{5}, \\qquad \\dfrac{\\color{blue}{1}}{8}\n$$\n\nHowever, the following fractions are *not* unit fractions since they do *not* contain ${\\color{blue}{1}}$ in the numerator:\n\n$$\n\\dfrac{\\color{red}{2}}{3}, \\qquad \\dfrac{\\color{red}{5}}{8}, \\qquad \\dfrac{\\color{red}{7}}{12}\n$$\n\nIn this lesson, we will use models to divide whole numbers by unit fractions. \n\nLet's start with an example. Suppose we divide the pizza below into fifths. How many fifths will there be in total?\n\n![](images/4a/4a73488a784067fbe0a4281ef8de45209e284bcd8675f5476c14a8bdcb357712.png)\n\n \n\nSince each part is $\\dfrac{1}{\\color{blue}5}$ of a whole, we need to split $\\color{red}1$ pizza (whole) into $\\color{blue}5$ equal parts, as shown below.\n\n![](images/9e/9e36c7b607bd6ada0018e574d52c060851837b62025429b6cfb94f98ed378ccd.png)\n\n \n\nSo, we get ${\\color{red}1} \\times {\\color{blue}5} = 5$ parts in total." :tutorial/id #uuid "577d7682-3ed8-5103-8641-0c02702a9e08" :tutorial/math-academy-id 8557 :tutorial/title "Introduction"} :step/id #uuid "26245a65-ebc8-5e42-9300-6d874c79a4ec" :step/math-academy-id 172318 :step/next {:db/id #edb/ref 17592186074611}} {:db/id #edb/ref 17592186074611 :step/content {:db/id #edb/ref 17592186073720 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073461 :question/id #uuid "4f8f2348-c6ec-5073-9f95-6697173654a7" :question/math-academy-id "e-13690"} :knowledge-point/id #uuid "b2b57f76-8fab-5b44-80ee-d905e5f9a14f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049517}] :knowledge-point/questions [{:db/id #edb/ref 17592186074042} {:db/id #edb/ref 17592186074365} {:db/id #edb/ref 17592186074521} {:db/id #edb/ref 17592186425718} {:db/id #edb/ref 17592186425719}] :knowledge-point/title "Determining How Many Parts Fit Into a Whole"} :step/id #uuid "3c05bf1b-ab93-581a-9e20-32a418b2cda1" :step/math-academy-id 172319 :step/next {:db/id #edb/ref 17592186074612}} {:db/id #edb/ref 17592186074612 :step/content {:db/id #edb/ref 17592186075044 :tutorial/content "The model below represents $2$ wholes. Let's use it to calculate the value of $2 \\div \\dfrac{1}{5}.$\n\n![](images/bc/bceafee7d9ca5e92e69b5d33d9504f4290526b80059ad62ed26229d02712a278.png)\n\n \n\nTo calculate ${\\color{red}2} \\div \\dfrac{1}{\\color{blue}5}$, we need to divide each of $\\color{red}2$ wholes into $\\color{blue}5$ equal parts, as shown below.\n\n![](images/cf/cf608ce8f5d8e2a47a4bebe21f198d193b10dd8f6e95436986bc954c89c60d19.png)\n\n \n\nWe get ${\\color{red}2} \\times {\\color{blue}5} = 10$ pieces in total. \n\nTherefore,\n\n$$\n2 \\div \\dfrac{1}{5} = 10\\,.\n$$" :tutorial/id #uuid "2de869cb-775d-5db4-b90d-7df0de218fc0" :tutorial/math-academy-id 8561 :tutorial/title "Dividing Whole Numbers by Unit Fractions"} :step/id #uuid "480191b5-d5a1-50b4-8e0c-c36a3b10da79" :step/math-academy-id 172323 :step/next {:db/id #edb/ref 17592186074613}} {:db/id #edb/ref 17592186074613 :step/content {:db/id #edb/ref 17592186073721 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073462 :question/id #uuid "2f739b94-f494-546b-8623-bd17a525a436" :question/math-academy-id "e-13695"} :knowledge-point/id #uuid "ed8053e5-f273-56f2-bfb6-294f936d9701" :knowledge-point/questions [{:db/id #edb/ref 17592186074367} {:db/id #edb/ref 17592186074386} {:db/id #edb/ref 17592186425721} {:db/id #edb/ref 17592186510434}] :knowledge-point/title "Identifying a Model Representing a Division Problem"} :step/id #uuid "242be67e-027e-54a4-9866-c63cb081faa9" :step/math-academy-id 172324 :step/next {:db/id #edb/ref 17592186074614}} {:db/id #edb/ref 17592186074614 :step/content {:db/id #edb/ref 17592186073722 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073467 :question/id #uuid "dd5b4bc8-110c-5247-b5e6-ee4ce7636a1b" :question/math-academy-id "e-13707"} :knowledge-point/id #uuid "2e33ab8e-736b-5972-af0d-f7eeabda1148" :knowledge-point/questions [{:db/id #edb/ref 17592186074043} {:db/id #edb/ref 17592186074366} {:db/id #edb/ref 17592186425715} {:db/id #edb/ref 17592186425716} {:db/id #edb/ref 17592186510433} {:db/id #edb/ref 17592186510455}] :knowledge-point/title "Identifying the Division Problem Represented by a Model"} :step/id #uuid "7721ecc8-af47-5723-b955-d68c3dc4eecb" :step/math-academy-id 172327 :step/next {:db/id #edb/ref 17592186074615}} {:db/id #edb/ref 17592186074615 :step/content {:db/id #edb/ref 17592186073723 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073468 :question/id #uuid "06e730e3-2df3-5d28-afd1-72c34d11cf8e" :question/math-academy-id "e-13709"} :knowledge-point/id #uuid "79e310e4-b8a2-5327-b4e6-fd71b6783e3a" :knowledge-point/questions [{:db/id #edb/ref 17592186074074} {:db/id #edb/ref 17592186074387} {:db/id #edb/ref 17592186424809} {:db/id #edb/ref 17592186425717} {:db/id #edb/ref 17592186425720} {:db/id #edb/ref 17592186510390}] :knowledge-point/title "Dividing Whole Numbers by Unit Fractions"} :step/id #uuid "b662cd66-040d-56ae-be80-ddf72c03e975" :step/math-academy-id 172330}] :activity/title "Dividing Whole Numbers by Unit Fractions Using Models" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073949}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186510532} :activity/id #uuid "27bc1257-fd21-5f11-87a5-72c434203efe" :activity/scope {:db/id #edb/ref 17592186050665 :topic/id #uuid "5d634c2c-a4e7-591a-891e-89c65f30d787" :topic/math-academy-id 529} :activity/steps [{:db/id #edb/ref 17592186510480 :step/content {:db/id #edb/ref 17592186510390 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e9be780-5147-51ee-b002-a0f63e5a12b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186509853} {:answer/id #uuid "68111c37-72e6-5fc9-be07-6a3b54ac4ad9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186509905} {:answer/id #uuid "9cba4bf1-c6c7-5edd-8528-71868f7bbfb1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186510015} {:answer/id #uuid "9ec836ed-be04-5f5e-89ff-824aa2643569" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186510019} {:answer/id #uuid "fa4a7e45-1247-5586-a96f-798ff42a6b1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186510223}] :answer-field/correct {:db/id #edb/ref 17592186510015} :answer-field/id #uuid "aba16430-0b0e-51ab-956c-4e4440ad03c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186510328}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4afa323a-6ccb-55bc-8693-1338e0d62847" :question/math-academy-id "q-92138" :question/problem "![](images/4a/4af3047f22d112fd3b1c2689ffacc50a1ce3d53dc458327ba25038f448de9c61.png)\n\nThe model above represents $3$ wholes. Use this model to calculate the value of $3÷\\frac{1}{7}.$" :question/worked-solution "To calculate $3÷\\frac{1}{7}$, we need to divide each of $3$ wholes into $7$ equal parts, as shown below.\n\n![](images/19/19b5902c790191dff44c240bb518feeeea9f9ffe5c0c440ca94b59344b78e1eb.png)\n\n \n\nWe get $3\\times 7=21$ pieces in total. \n\nTherefore:\n\n$$\n3÷\\frac{1}{7}=21\n$$"} :step/id #uuid "0d938664-32ae-58c2-9276-34c95d3f3781" :step/next {:db/id #edb/ref 17592186510528}} {:db/id #edb/ref 17592186510528 :step/content {:db/id #edb/ref 17592186510433 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0594fa26-83d8-55d6-ba2f-f5602e974d7e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $12$" :db/id #edb/ref 17592186509704} {:answer/id #uuid "2d5084db-05d5-56b6-a9d7-ebb87d1f5662" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$6$ and $18$" :db/id #edb/ref 17592186509783} {:answer/id #uuid "34761e05-28a7-5780-b0ee-5911ee3484df" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$12$ and $18$" :db/id #edb/ref 17592186509799} {:answer/id #uuid "bab1da5b-2b3d-5064-9788-38acf0fa6ff8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$6$ and $3$" :db/id #edb/ref 17592186510085} {:answer/id #uuid "e89c2fc3-a3b1-57e9-a10c-59b0f6af795d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$6$ and $6$" :db/id #edb/ref 17592186510186}] :answer-field/correct {:db/id #edb/ref 17592186509783} :answer-field/id #uuid "84c38cbc-a594-504c-a843-d261f92675be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186510308}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a2e8b668-df51-5edf-a673-01b58575b2f0" :question/math-academy-id "q-137761" :question/problem "![](images/67/675a66c94bee0deba216bf684aa2b74e6fa048ed62a3944dabe50cdbb88952f3.png)\n\nEach of the six shapes in the model above represents one whole. From left to right, what numbers are missing from the division problem below?\n\n$$\n\\boxed{\\,\\,}÷\\frac{1}{3}=\\boxed{\\,\\,}\n$$" :question/worked-solution "In the model, there are $6$ shapes. Each shape consists of $3$ pieces that each represent $\\frac{1}{3}$ of a whole. There are $18$ pieces in total.\n\nThe model tells us that when we divide $6$ wholes into thirds, we will be left with $18$ pieces.\n\nHence, the division problem is:\n\n$$\n\\boxed{\\,6\\,}÷\\frac{1}{3}=\\boxed{\\,18\\,}\n$$\n\nTherefore, the missing numbers are $6$ and $18.$"} :step/id #uuid "a126afd0-6b9f-56d3-afce-acd7571f30e0"} {:db/id #edb/ref 17592186510532 :step/content {:db/id #edb/ref 17592186510434 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d0ff9e0-35db-5bc9-91f1-79e039622baa" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a0/a084209041e41554c744914bf42692c9d6cc77c3d86bb85747c1c62df15aab99.png" :db/id #edb/ref 17592186509748} {:answer/id #uuid "7090b097-239e-5212-88fd-47671d2450fe" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/20/20895cf6185b627cf2081cb9afd248ff1bb3a8b11a988807bfb1a04ada2302f2.png" :db/id #edb/ref 17592186509918} {:answer/id #uuid "9abe1a9b-a332-59c0-ab49-37957cb6cdaf" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ec/ecb4ff70a833b96a4f0e42ae14e3afff36c5a3fa656fedf45830fe64791db738.png" :db/id #edb/ref 17592186510012} {:answer/id #uuid "cfbebdf1-3a63-5465-be64-fa925058ad05" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/d0/d08c2ac302acf38baa05c091c52a0a1d8fd89570989503f028529e0fa2cd9ff9.png" :db/id #edb/ref 17592186510128} {:answer/id #uuid "ddc48ef6-a7f8-5213-bda3-913460dbb747" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/29/29ab6ef1e10eab020a25bec6c949bebeaf0c2cb5cb77db125f84fd6dd6c88129.png" :db/id #edb/ref 17592186510160}] :answer-field/correct {:db/id #edb/ref 17592186510012} :answer-field/id #uuid "546f4173-148e-5f1a-a1fc-5d267635ba7f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186510278}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a352b711-8af2-5a66-960f-d91f88b29c96" :question/math-academy-id "q-92127" :question/problem "Which model represents the division problem below?\n\n$$\n2÷\\frac{1}{8}=16\n$$" :question/worked-solution "To calculate $2÷\\frac{1}{8}$, we need to divide each of $2$ wholes into $8$ equal parts, as shown below. This gives us the corresponding model for the given division problem.\n\n![](images/80/80d6548bd656ccfd0e4a2cd3dadd52671f7c9cfa648faf9ed293463adf3a92ba.png)\n\n \n\nWe get $2\\times 8=16$ pieces in total."} :step/id #uuid "ac1e36de-ed27-5385-a094-8568c7fcf072" :step/next {:db/id #edb/ref 17592186510480}}] :activity/title "Dividing Whole Numbers by Unit Fractions Using Models" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186509680}]}
