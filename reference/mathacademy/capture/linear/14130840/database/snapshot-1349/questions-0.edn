#{[{:db/id #edb/ref 17592186198064 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198422 :knowledge-point/id #uuid "666d43f8-bf05-51b0-af1f-d89540f4c29c" :knowledge-point/title "Identifying Metric Units of Mass"}] :question/id #uuid "857b2e09-68cc-5fc4-b9d0-1f6a9d43fbaa" :question/math-academy-id "e-12510" :question/problem "Suppose we want to measure the mass of an ant. Which of the following metric units could we use?\n\n1. $\\rm{m}$\n2. $\\rm{mg}$\n3. $\\rm{s}$" :question/worked-solution "A table showing the metric units of mass is given below.\n\n| Name | Symbol |\n| --- | ---: |\n| Kilogram | $\\textrm{kg}$ |\n| Gram | $\\textrm{g}$ |\n| Milligram | $\\textrm{mg}$ |\n\nTherefore, from the given options, the only unit of mass is $\\textrm{mg}$."}] [{:db/id #edb/ref 17592186198065 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198423 :knowledge-point/id #uuid "e01d9e5b-d4e5-5e84-84c5-33f6678b53ee" :knowledge-point/title "Stating Mass Conversions in Metric Units"}] :question/id #uuid "8783fe1f-5b08-5862-9e3d-231ba39ad4e8" :question/math-academy-id "e-12511" :question/problem "A melon has a mass of $1\\,\\textrm{kg}$. What is this mass in grams?" :question/worked-solution "A table showing the metric units of mass is given below.\n\n| Name | Symbol | Conversion |\n| --- | ---: | ---: |\n| Kilogram | $\\textrm{kg}$ | $1\\,\\textrm{kg} = 1\\,000\\,\\textrm{g}$ |\n| Gram | $\\textrm{g}$ | Base Unit |\n| Milligram | $\\textrm{mg}$ | $1\\,000\\,\\textrm{mg} = 1\\,\\textrm{g}$ |\n\nSo, $1\\,\\textrm{kg}$ is equivalent to $1\\,000\\,\\textrm{g}$."}] [{:db/id #edb/ref 17592186198068 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198426 :knowledge-point/id #uuid "c3ec882e-9438-5f6a-bcb3-3baa7a871f56" :knowledge-point/title "Identifying Customary Units of Mass"}] :question/id #uuid "0526feee-cfe1-5aa2-9de0-a37e7a162492" :question/math-academy-id "e-12516" :question/problem "Suppose we want to measure the mass of a flat-screen TV. Which of the following customary units could we use?\n\n1. $\\textrm{yd}$\n2. $\\textrm{ft}$\n3. $\\textrm{lb}$" :question/worked-solution "A table showing the customary units of mass is given below.\n\n| Name | Symbol |\n| --- | ---: |\n| Ton | $\\textrm{ton}$ |\n| Pound | $\\textrm{lb}$ |\n| Ounce | $\\textrm{oz}$ |\n\nTherefore, from the given options, the only unit of mass is $\\textrm{lb}$."}] [{:db/id #edb/ref 17592186198069 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198427 :knowledge-point/id #uuid "7e0296c8-9ada-5097-a967-f10fc498a9eb" :knowledge-point/title "Stating Mass Conversions in Customary Units"}] :question/id #uuid "16c47009-d38d-5957-bc2d-525483e18161" :question/math-academy-id "e-12517" :question/problem "An american bison has a mass of $1\\,\\textrm{ton}$. What is this mass in pounds?" :question/worked-solution "A table showing the customary units of mass is given below.\n\n| Name | Symbol | Conversion |\n| --- | ---: | ---: |\n| Ton | $\\textrm{ton}$ | $1\\,\\textrm{ton} = 2,000\\,\\textrm{lb}$ |\n| Pound | $\\textrm{lb}$ | $1\\,\\textrm{lb} = 16\\,\\textrm{oz}$ |\n| Ounce | $\\textrm{oz}$ | $-$ |\n\nSo, $1\\,\\textrm{ton}$ is equivalent to $2,000\\,\\textrm{lb}$."}] [{:db/id #edb/ref 17592186198659 :knowledge-point/_questions [{:db/id #edb/ref 17592186198423 :knowledge-point/id #uuid "e01d9e5b-d4e5-5e84-84c5-33f6678b53ee" :knowledge-point/title "Stating Mass Conversions in Metric Units"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec3d5e3f-e2ea-5ea8-b1de-b1796d984e39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.01g" :db/id #edb/ref 17592186194586} {:answer/id #uuid "0398b1f3-a4ee-5fec-adeb-5023017970d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100g" :db/id #edb/ref 17592186194587} {:answer/id #uuid "04ea125e-537a-5f0c-91d1-741e865f99a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math}