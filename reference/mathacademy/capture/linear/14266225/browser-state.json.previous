      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14266225/observations/step-3-b4b700199dc5721e1efe.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14266225/observations/step-3-b4b700199dc5721e1efe.png",
      "source_url": "https://mathacademy.com/tasks/14266225/multisteps/1792",
