          "input_html": "<div class=\"matheditor-wrapper-answer\" style=\"min-width: 80px; margin-left: 5px; margin-right: 5px;\">\n                                             \n                                        <div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"17\"><span mathquill-command-id=\"53\">2</span><var mathquill-command-id=\"55\">x</var><span mathquill-command-id=\"57\" class=\"mq-binary-operator\">+</span><span class=\"mq-fraction mq-non-leaf\" mathquill-command-id=\"59\"><span class=\"mq-numerator\" mathquill-block-id=\"61\"><span mathquill-command-id=\"60\">4</span></span><span class=\"mq-denominator\" mathquill-block-id=\"63\"><var mathquill-command-id=\"62\">x</var></span><span style=\"display:inline-block;width:0\">​</span></span></span></div></div>",
          "rendered_text": "2x+4x​",
