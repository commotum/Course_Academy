  "problem": "$\\int \\frac{4}{{x}^{2}}\\,\\text{d}x=$\n\n                            \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$+\\,C$",
