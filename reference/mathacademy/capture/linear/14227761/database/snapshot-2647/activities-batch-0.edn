#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186093122} :activity/id #uuid "4d6a31ac-41c5-5814-8574-33c8d7e8a0e1" :activity/scope {:db/id #edb/ref 17592186049332 :topic/id #uuid "ec784b83-0c82-5c6a-9dd1-3880cd96d4cb" :topic/math-academy-id 1036} :activity/steps [{:db/id #edb/ref 17592186093122 :step/content {:db/id #edb/ref 17592186093370 :tutorial/content "The chain rule can be used to differentiate logarithmic functions like \n\n$$\ny = \\ln (2x+1).\n$$\n\nFirst notice that this function can be written as the composite function\n\n$$\ny = \\ln u, \\qquad u = 2x+1.\n$$\n\nWe can use the chain rule to compute the derivative of this composite function:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{\\text{d}}{\\text{d}u}(\\operatorname{ln}⁡u)\\cdot \\frac{\\text{d}}{\\text{d}x}(2x+1) \\\\  & =\\frac{1}{u}\\cdot 2 \\\\  & =\\frac{2}{u}\\end{aligned}\n$$\n\nSubstituting $u=2x+1,$ we obtain the final result:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{2}{2x+1}\\end{aligned}\n$$" :tutorial/id #uuid "054d5bfc-280f-5da5-9576-4b4cd8668e78" :tutorial/math-academy-id 1272 :tutorial/title "Introduction"} :step/id #uuid "e409fa6f-b896-5f75-a481-3ece75fb28d5" :step/math-academy-id 2500 :step/next {:db/id #edb/ref 17592186093123}} {:db/id #edb/ref 17592186093123 :step/content {:db/id #edb/ref 17592186092264 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092120 :question/id #uuid "5d2c0fff-c9af-5e8a-846a-640878f08283" :question/math-academy-id "e-730"} :knowledge-point/id #uuid "b4ac7f7e-1e07-57d7-a82a-d6545588c2de" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050690} {:db/id #edb/ref 17592186051084}] :knowledge-point/question-generator {:db/id #edb/ref 17592186490412} :knowledge-point/questions [{:db/id #edb/ref 17592186092514} {:db/id #edb/ref 17592186092677} {:db/id #edb/ref 17592186233100} {:db/id #edb/ref 17592186233916} {:db/id #edb/ref 17592186253563} {:db/id #edb/ref 17592186253567} {:db/id #edb/ref 17592186275257} {:db/id #edb/ref 17592186275258} {:db/id #edb/ref 17592186297318} {:db/id #edb/ref 17592186317167} {:db/id #edb/ref 17592186317168} {:db/id #edb/ref 17592186329899} {:db/id #edb/ref 17592186490400} {:db/id #edb/ref 17592186490408} {:db/id #edb/ref 17592186526015} {:db/id #edb/ref 17592186526078} {:db/id #edb/ref 17592186549070}] :knowledge-point/title "Differentiating a Natural Logarithm Function Using the Chain Rule"} :step/id #uuid "85e75718-6b20-5a31-9c9f-44d7e919b212" :step/math-academy-id 2501 :step/next {:db/id #edb/ref 17592186093124}} {:db/id #edb/ref 17592186093124 :step/content {:db/id #edb/ref 17592186092265 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092122 :question/id #uuid "7df7fed3-c172-5cc2-aca8-abd31a0902a0" :question/math-academy-id "e-731"} :knowledge-point/id #uuid "a9102c1c-1c38-58dd-9932-b04bd24a6846" :knowledge-point/questions [{:db/id #edb/ref 17592186092617} {:db/id #edb/ref 17592186092732} {:db/id #edb/ref 17592186233614} {:db/id #edb/ref 17592186233771} {:db/id #edb/ref 17592186233917} {:db/id #edb/ref 17592186233918} {:db/id #edb/ref 17592186234085} {:db/id #edb/ref 17592186234306} {:db/id #edb/ref 17592186297319} {:db/id #edb/ref 17592186297320} {:db/id #edb/ref 17592186317170} {:db/id #edb/ref 17592186317171} {:db/id #edb/ref 17592186329895} {:db/id #edb/ref 17592186329900} {:db/id #edb/ref 17592186332869} {:db/id #edb/ref 17592186338953} {:db/id #edb/ref 17592186525997} {:db/id #edb/ref 17592186549011}] :knowledge-point/title "Differentiating a General Logarithm Function Using the Chain Rule"} :step/id #uuid "e714e4f8-4119-55f8-addf-068b78303467" :step/math-academy-id 2505}] :activity/title "The Chain Rule With Logarithmic Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186092417}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186549149} :activity/id #uuid "4163d0cc-c56a-5718-9ce6-a0070aa91ee4" :activity/scope {:db/id #edb/ref 17592186049332 :topic/id #uuid "ec784b83-0c82-5c6a-9dd1-3880cd96d4cb" :topic/math-academy-id 1036} :activity/steps [{:db/id #edb/ref 17592186549081 :step/content {:db/id #edb/ref 17592186549011 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0677b7f9-d152-5eed-97e5-8f5592a31657" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{2x}{5\\operatorname{ln}⁡(10)}-\\frac{2}{5\\operatorname{ln}⁡(10)}" :db/id #edb/ref 17592186548366} {:answer/id #uuid "06923402-c07c-528b-a298-0b8a71448268" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{2x}{5\\operatorname{ln}⁡(10)}+1" :db/id #edb/ref 17592186548368} {:answer/id #uuid "2ede9697-6d3d-5e61-a427-35aecef7a252" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{2x}{5\\operatorname{ln}⁡(10)}-\\frac{2}{5\\operatorname{ln}⁡(10)}+1" :db/id #edb/ref 17592186548450} {:answer/id #uuid "35a68164-9e76-57b2-aab1-2d80d9c78b2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{2x}{5\\operatorname{ln}⁡(10)}+\\frac{2}{5\\operatorname{ln}⁡(10)}+1" :db/id #edb/ref 17592186548459} {:answer/id #uuid "b233612d-1ef2-5a1d-af72-2a0729071ac6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{2x}{5\\operatorname{ln}⁡(10)}-\\frac{3}{5}" :db/id #edb/ref 17592186548710}] :answer-field/correct {:db/id #edb/ref 17592186548450} :answer-field/id #uuid "12a6637d-3fa8-57d6-a18a-381344c8f764" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186548872}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "694c8d1d-6f8f-5d0d-9977-6900e2cfbc80" :question/math-academy-id "q-107472" :question/problem "Find the equation of the tangent to the curve $y=\\operatorname{log}⁡(4x+6)$ at the point $(1,1).$" :question/worked-solution "First, we need to find the slope of the tangent line. The slope is equal to the derivative of the curve at the given point:\n\n$$\nm=\\frac{\\text{d}y}{\\text{d}x}{|}_{x=1}\n$$\n\nTo compute $\\frac{\\text{d}y}{\\text{d}x},$ we first express $y$ as the composite function\n\n$$\ny=\\operatorname{log}⁡(u),\\,u=4x+6.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{u\\operatorname{ln}⁡(10)},\\,\\frac{\\text{d}u}{\\text{d}x}=4.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{u\\operatorname{ln}⁡(10)}\\cdot 4 \\\\  & =\\frac{4}{(4x+6)\\operatorname{ln}⁡(10)} \\\\  & =\\frac{2}{(2x+3)\\operatorname{ln}⁡(10)}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent line at the point where $x=1$ is \n\n$$\n\\begin{aligned}\\begin{aligned}m & =\\frac{\\text{d}y}{\\text{d}x}{|}_{x=1} \\\\  & =\\frac{2}{(2x+3)\\operatorname{ln}⁡(10)}{|}_{x=1} \\\\  & =\\frac{2}{(2(1)+3)\\operatorname{ln}⁡(10)} \\\\  & =\\frac{2}{5\\operatorname{ln}⁡(10)}.\\end{aligned}\\end{aligned}\n$$\n\nNow we know that the slope of the tangent line at the point $(1,1)$ is $m=\\frac{2}{5\\operatorname{ln}⁡(10)}.$ Finally, we find the equation of the tangent line at that point:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =\\frac{2}{5\\operatorname{ln}⁡(10)}(x-1) \\\\ y & =\\frac{2x}{5\\operatorname{ln}⁡(10)}-\\frac{2}{5\\operatorname{ln}⁡10}+1.\\end{aligned}\n$$"} :step/id #uuid "1598bc67-4403-5bf2-9b72-cfab9c69ea72"} {:db/id #edb/ref 17592186549136 :step/content {:db/id #edb/ref 17592186233100 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "011261f6-f670-587f-9bdd-9a520a83e6ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-x+1" :db/id #edb/ref 17592186548361} {:answer/id #uuid "6007a77d-8635-5b6c-baa1-e41d26c907eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-x+1+\\operatorname{ln}⁡2" :db/id #edb/ref 17592186548533} {:answer/id #uuid "6c6fa548-c78e-5183-aee5-05878a4f08f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-x+1+4\\operatorname{ln}⁡2" :db/id #edb/ref 17592186548556} {:answer/id #uuid "ed876f04-a32c-5ff4-8888-d57182793668" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-x+\\operatorname{ln}⁡2" :db/id #edb/ref 17592186548820} {:answer/id #uuid "edf7f618-406b-55ec-a4b0-ea2a3cc3aa13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-x-1-3\\operatorname{ln}⁡2" :db/id #edb/ref 17592186548821}] :answer-field/correct {:db/id #edb/ref 17592186548533} :answer-field/id #uuid "499c195b-8d64-5d7d-9d3e-bb9baebdfb2e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186548904}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e624a42e-febd-5a83-813e-03b578dd4b5f" :question/math-academy-id "q-107469" :question/problem "Find the equation of the tangent to the curve $f(x)=\\operatorname{ln}⁡(4-2x)$ at the point $(1,\\operatorname{ln}⁡2).$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf=\\operatorname{ln}⁡u,\\,u=4-2x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=\\frac{1}{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-2.\n$$\n\nWe now apply the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{u}\\cdot (-2) \\\\  & =\\frac{1}{4-2x}\\cdot (-2) \\\\  & =-\\frac{2}{4-2x} \\\\  & =-\\frac{\\cancel{2}}{\\cancel{2}\\cdot (2-x)} \\\\  & =-\\frac{1}{2-x}\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent line at the point where $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={-\\frac{1}{2-x}|}_{x=1}=-\\frac{1}{2-1}=-1\\,.\\end{aligned}\n$$\n\nHence, the slope of the tangent line at the point $(1,\\operatorname{ln}⁡2)$ is $m=-1.$ Now, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-\\operatorname{ln}⁡2 & =-1(x-1) \\\\ y & =-x+1+\\operatorname{ln}⁡2\\end{aligned}\n$$"} :step/id #uuid "b0ad1a3e-52d2-5769-a49d-34e5806ad438" :step/next {:db/id #edb/ref 17592186549081}} {:db/id #edb/ref 17592186549149 :step/content {:db/id #edb/ref 17592186549070 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60e32486-7db9-572e-bf0b-abb0511aec74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{3x+1}" :db/id #edb/ref 17592186548538} {:answer/id #uuid "7fa58aec-2436-55ed-8db4-68bc0b24c12c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{ln}⁡(3x+1)" :db/id #edb/ref 17592186548598} {:answer/id #uuid "84b40ed1-5a51-5fc6-89ae-d9b2b8b060a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3x+1}" :db/id #edb/ref 17592186548610} {:answer/id #uuid "e5cbf553-6bf5-593b-adb6-71b0634cb9a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{x+1}" :db/id #edb/ref 17592186548804} {:answer/id #uuid "e777fd40-075b-5a8d-88b7-24757d97d60b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{x+1}" :db/id #edb/ref 17592186548807}] :answer-field/correct {:db/id #edb/ref 17592186548538} :answer-field/id #uuid "3eb65b3e-6b41-59b0-9d94-518769d72256" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186548896}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "faab7281-1d54-5c27-a108-8672d8a7d7bc" :question/math-academy-id "q-11931" :question/problem "Given that $f(x)=\\operatorname{ln}⁡(3x+1)$, find $\\frac{\\text{d}f}{\\text{d}x}.$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf=\\operatorname{ln}⁡u,\\,u=3x+1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=\\frac{1}{u},\\,\\frac{\\text{d}u}{\\text{d}x}=3.\n$$\n\nWe now apply the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{u}\\cdot 3 \\\\  & =\\frac{1}{3x+1}\\cdot 3 \\\\  & =\\frac{3}{3x+1}.\\end{aligned}\n$$"} :step/id #uuid "e22638d2-4c46-5db8-9072-104c4a9a278c" :step/next {:db/id #edb/ref 17592186549136}}] :activity/title "The Chain Rule With Logarithmic Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186548339}]}
