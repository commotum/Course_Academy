e-point/id #uuid "64cd9663-3e98-5508-9279-9af971ab13b2" :knowledge-point/title "Identifying Points That Lie on the Graph on an Inverse Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6374228-908a-5ae3-9c45-b9246f1a198a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-1)" :db/id #edb/ref 17592186080934} {:answer/id #uuid "ecaaa766-bd6d-598a-9148-aa3b41482c6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-1)" :db/id #edb/ref 17592186080936} {:answer/id #uuid "3a648c59-715c-54b7-b0c3-e1bb681b4ef5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,1)" :db/id #edb/ref 17592186520893} {:answer/id #uuid "5def6256-d0d4-5511-bf5c-30e0edd55937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,1)" :db/id #edb/ref 17592186520975} {:answer/id #uuid "7b9b2dea-96eb-5491-90c6-bbf646d32f55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,3)" :db/id #edb/ref 17592186521042}] :answer-field/correct {:answer/id #uuid "ecaaa766-bd6d-598a-9148-aa3b41482c6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-1)" :db/id #edb/ref 17592186080936} :answer-field/id #uuid "f12ad298-bd6a-541d-a3b3-d430db56add5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186080933}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c4bff519-79b1-5c4d-b25d-261bafc7dc6d" :question/math-academy-id "q-35205" :question/problem "Given that the function $f(x)$ has an inverse ${f}^{-1}(x)$, and the point $(-1,-3)$ lies on the graph $y=f(x),$ which point must lie on the graph of $y={f}^{-1}(x)?$" :question/worked-solution "The function $y={f}^{-1}(x)$ is a reflection of $y=f(x)$ in the line $y=x.$ Therefore, each point $(a,b)$ on $y=f(x)$ has a corresponding point $(b,a)$ on $y={f}^{-1}(x)$ (the $x$ and $y$ coordinates swap).\n\nSince the point $(-1,-3)$ lies on $y=f(x),$ the point $(-3,-1)$ lies on $y={f}^{-1}(x).$"}] [{:db/id #edb/ref 17592186521525 :knowledge-point/_questions [{:db/id #edb/ref 17592186083161 :knowledge-point/id #uuid "64cd9663-3e98-5508-9279-9af971ab13b2" :knowledge-point/title "Identifying Points That Lie on the Graph on an Inverse Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "336e2f7d-fd40-50a7-8a7b-30a742e79f73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,5)" :db/id #edb/ref 17592186520871} {:answer/id #uuid "83e5ec26-38cf-5113-82fa-51f609535188" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-5)" :db/id #edb/ref 17592186521064} {:answer/id #uuid "8b01730a-325b-5954-acee-5baa39308c77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,-1)" :db/id #edb/ref 17592186521079} {:answer/id #uuid "fc2a4f96-2c06-5aec-9e46-84e2bde15441" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-5)" :db/id #edb/ref 17592186521316} {:answer/id #uuid "fd4d1f48-5be7-5ed8-887e-1f8ca7d1ca99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,5)" :db/id #edb/ref 17592186521320}] :answer-field/correct {:answer/id #uuid "fd4d1f48-5be7-5ed8-887e-1f8ca7d1ca99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,5)" :db/id #edb/ref 17592186521320} :answer-field/id #uuid "e97ea637-210f-534c-9a36-7028bbfa41bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521443}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8dc02ab1-2232-53a5-8f5c-8a9183793c53" :question/math-academy-id "q-66616" :question/problem "Given that the function $f(x)$ has an inverse ${f}^{-1}(x)$, and the point $(5,1)$ lies on the graph $y=f(x),$ which point must lie on the graph of $y={f}^{-1}(x)?$" :question/worked-solution "The function $y={f}^{-1}(x)$ is a reflection of $y=f(x)$ in the line $y=x.$ Therefore, each point $(a,b)$ on $y=f(x)$ has a corresponding point $(b,a)$ on $y={f}^{-1}(x)$ (the $x$ and $y$ coordinates swap).\n\nSince the point $(5,1)$ lies on $y=f(x),$ the point $(1,5)$ lies on $y={f}^{-1}(x).$"}]}
