#{[{:activity/first-step {:db/id #edb/ref 17592186084010} :activity/id #uuid "e7e95ebe-a6d4-54ce-af5e-ef12ac0f54c1" :activity/scope {:db/id #edb/ref 17592186048686 :topic/id #uuid "b4b6e87b-d6e5-55d8-9ea3-9ee51851e02a" :topic/math-academy-id 756} :activity/steps [{:db/id #edb/ref 17592186084010 :step/content {:db/id #edb/ref 17592186084421 :tutorial/content "Consider the function\n\n$$\n{\\color{black}f(x)} = 4x-2\n$$\n\ndefined over the entire real line, and its inverse function\n\n$$\n{\\color{black}f^{-1}(x)} = \\dfrac{1}{4}(x+2)\n$$\n\nIf we plot both\n\n$$\n{\\color{blue}y=f(x)}\n$$\n\nand\n\n$$\n{\\color{red}y=f^{-1}(x)}\n$$\n\non the same diagram, we can see that the graph of\n\n$$\n{\\color{red}y=f^{-1}(x)}\n$$\n\nis a **reflection** of\n\n$$\n{\\color{blue}y=f(x)}\n$$\n\nin the line $y=x$.\n\n![](images/ec/ec501e8c71fdcc1cfdd78e47ed81542bbba44aa8ac50084cc6ddfeb7eff011ff.png)\n\nEach point $(a,b)$ on the graph of\n\n$$\n{\\color{blue}y=f(x)}\n$$\n\nhas a corresponding point $(b,a)$ on the graph of the inverse function\n\n$$\n{\\color{red}y=f^{-1}(x)}\n$$\n\nThat is to say, the $x$ and $y$ coordinates swap.\n\nFor example, notice that the point $A(2,6)$ on\n\n$$\n{\\color{blue}y=f(x)}\n$$\n\nhas the corresponding point $A'(6,2)$ on\n\n$$\n{\\color{red}y=f^{-1}(x)}\n$$" :tutorial/id #uuid "e6b66591-b35b-5dff-9df3-0030f51e2811" :tutorial/math-academy-id 2764 :tutorial/title "Introduction"} :step/id #uuid "0f462406-aa92-557b-8726-d65ca3ece754" :step/math-academy-id 13792 :step/next {:db/id #edb/ref 17592186084012}} {:db/id #edb/ref 17592186084011 :step/content {:db/id #edb/ref 17592186083160 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082977 :question/id #uuid "ad4ecf44-6f6e-51a8-9c37-57483f958c72" :question/math-academy-id "e-3947"} :knowledge-point/id #uuid "321d88fd-fca2-5907-8a16-809b3795c640" :knowledge-point/questions [{:db/id #edb/ref 17592186083664} {:db/id #edb/ref 17592186083666}] :knowledge-point/title "Identifying the Graph of an Inverse Function"} :step/id #uuid "c915c7b8-4ebd-5772-a1b7-fe38b1c8862e" :step/math-academy-id 13795} {:db/id #edb/ref 17592186084012 :step/content {:db/id #edb/ref 17592186083161 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082978 :question/id #uuid "31a829fb-738f-579d-9232-7313c531733a" :question/math-academy-id "e-3948"} :knowledge-point/id #uuid "64cd9663-3e98-5508-9279-9af971ab13b2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050867}] :knowledge-point/questions [{:db/id #edb/ref 17592186083667} {:db/id #edb/ref 17592186083668}] :knowledge-point/title "Identifying Points That Lie on the Graph on an Inverse Function"} :step/id #uuid "292083a0-53fe-58ee-833c-f83407811012" :step/math-academy-id 13801 :step/next {:db/id #edb/ref 17592186084011}}] :activity/title "Graphs of Inverse Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083446}]}
