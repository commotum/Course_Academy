#{[{:db/id #edb/ref 17592186082977 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083160 :knowledge-point/id #uuid "321d88fd-fca2-5907-8a16-809b3795c640" :knowledge-point/title "Identifying the Graph of an Inverse Function"}] :question/id #uuid "ad4ecf44-6f6e-51a8-9c37-57483f958c72" :question/math-academy-id "e-3947" :question/problem "The graph of $y=f(x)$ is shown below. Sketch the graph of $y = f^{-1}(x)$.\n\n![](images/99/99f02265f84874638b3faae106bb293e238b5e5064ea09beb2a6d71aeff12fe5.png)" :question/worked-solution "Remember that each point $(a,b)$ on $y = f(x)$ has a corresponding point $(b,a)$ on\n\n$$\ny = f^{-1}(x)\n$$\n\nIn other words, the points on $y=f(x)$ have corresponding points on $y=f^{-1}(x)$ with the coordinates swapped:\n\n$$\n\\begin{bmatrix}(0, 1) & ⟶(1, 0) \\\\ (-2, 5) & ⟶(5,-2)\\end{bmatrix}\n$$\n\nTo graph\n\n$$\ny=f^{-1}(x)\n$$\n\nwe plot the two points $(1,0)$ and $(5,-2)$ and connect the segment. We see that, as expected, the function\n\n$$\ny = f^{-1}(x)\n$$\n\nis a reflection of $y = f(x)$ in the line $y=x$.\n\n![](images/e7/e701f7e4f82b2ae3f6e48abcbbce350f57d6f54f9d4a98c03eabeaec89a328dd.png)"}] [{:db/id #edb/ref 17592186082978 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083161 :knowledge-point/id #uuid "64cd9663-3e98-5508-9279-9af971ab13b2" :knowledge-point/title "Identifying Points That Lie on the Graph on an Inverse Function"}] :question/id #uuid "31a829fb-738f-579d-9232-7313c531733a" :question/math-academy-id "e-3948" :question/problem "Given that the function $f(x)$ has an inverse $f^{-1}(x)$, and the point $(2,9)$ lies on the graph $y=f(x)$, which point must lie on the graph of $y=f^{-1}(x)$?" :question/worked-solution "The function\n\n$$\ny = f^{-1}(x)\n$$\n\nis a reflection of $y = f(x)$ in the line $y=x$. Therefore, each point $(a,b)$ on $y = f(x)$ has a corresponding point $(b,a)$ on\n\n$$\ny = f^{-1}(x)\n$$\n\nIn other words, the $x$ and $y$ coordinates swap.\n\nSince the point $(2,9)$ lies on $y = f(x)$, the point $(9,2)$ lies on\n\n$$\ny = f^{-1}(x)\n$$"}] [{:db/id #edb/ref 17592186083666 :knowledge-point/_questions [{:db/id #edb/ref 17592186083160 :knowledge-point/id #uuid "321d88fd-fca2-5907-8a16-809b3795c640" :knowledge-point/title "Identifying the Graph of an Inverse Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a02ea01c-f1f1-5741-9cde-a5ac6abf9ee6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bd/bd2331dd971ecd94fadb88b88e4fcd5e0e7235a300892359687834e60d13f6aa.png" :db/id #edb/ref 17592186080928} {:answer/id #uuid "23d4c101-f946-5279-abbc-206f41c08e81" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ba/baaeeb67a6f996a0b92bae640571a5bf12101a70a80853197059c04f7479916f.png" :db/id #edb/ref 17592186080929} {:answer/id #uuid "419e0a90-f22c-5e79-a7b5-5754372697d6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/25/25ad02d9c81701f6b8b76899b2b73c6d79a8006fc0591dd7738d6978974d506d.png" :db/id #edb/ref 17592186080930} {:answer/id #uuid "47158bf3-b734-56d4-ba98-10f6ebb10279" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/97/97a96720d41ae0debd49a348fe72da09bcb0135c8408ee83fdb674662d06ae81.png" :db/id #edb/ref 17592186080931} {:answer/id #uuid "5306b32c-54f7-5237-9a4d-604d3058211d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f7/f79e0b061f9cff03c19aabb8e39f184173f1f2310b0f747ad802a53717ef6094.png" :db/id #edb/ref 17592186080932}] :answer-field/id #uuid "e3358c53-be58-5aa1-9f9e-2fd1d88a0a26" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186080927}] :question/id #uuid "61beea40-a442-5d88-bc28-c86f6bb11eea" :question/math-academy-id "q-35202" :question/problem "![](images/46/46022df1ffb1b45ffe344658075dd363f3e2856798050fdbe85aacff0bc98ebe.png)\n\nThe graph of $y = f(x)$ is shown above. Which of the following is the graph of $y = f^{-1}(x)$?"}] [{:db/id #edb/ref 17592186083667 :knowledge-point/_questions [{:db/id #edb/ref 17592186083161 :knowledge-point/id #uuid "64cd9663-3e98-5508-9279-9af971ab13b2" :knowledge-point/title "Identifying Points That Lie on the Graph on an Inverse Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6374228-908a-5ae3-9c45-b9246f1a198a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-1)" :db/id #edb/ref 17592186080934} {:answer/id #uuid "d99a2c95-c164-5754-a9b1-a1a52d2e03fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3, 1)" :db/id #edb/ref 17592186080935} {:answer/id #uuid "ecaaa766-bd6d-598a-9148-aa3b41482c6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-1)" :db/id #edb/ref 17592186080936} {:answer/id #uuid "f74c14b0-895a-5b9f-afb2-01faa8afc6da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3, 1)" :db/id #edb/ref 17592186080937} {:answer/id #uuid "3183da3e-0d0c-5e53-9bb2-7ed0745d4749" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1, 3)" :db/id #edb/ref 17592186080938}] :answer-field/id #uuid "f12ad298-bd6a-541d-a3b3-d430db56add5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186080933}] :question/id #uuid "c4bff519-79b1-5c4d-b25d-261bafc7dc6d" :question/math-academy-id "q-35205" :question/problem "Given that the function $f(x)$ has an inverse $f^{-1}(x)$, and the point $(-1,-3)$ lies on the graph $y = f(x)$, which point must lie on the graph of $y = f^{-1}(x)$?"}]}
