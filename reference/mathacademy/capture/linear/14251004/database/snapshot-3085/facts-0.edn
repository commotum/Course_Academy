f 17592186045498 #edb/ref 17592186045417] [17592186571094 #edb/ref 1083 #uuid "82b7408e-0165-58fb-9ffe-29dd90fb32bb" #edb/ref 17592186045417] [17592186571154 #edb/ref 1080 "2244q^2" #edb/ref 17592186045417] [17592186571154 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186571154 #edb/ref 1083 #uuid "a6f99b8f-3a5a-5ef1-bccb-09ce2846b404" #edb/ref 17592186045417] [17592186571224 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186571224 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186571224 #edb/ref 1083 #uuid "d611d837-c607-55f1-84f6-82a363b4fcc6" #edb/ref 17592186045417] [17592186571309 #edb/ref 1075 #edb/ref 17592186570909 #edb/ref 17592186045417] [17592186571309 #edb/ref 1075 #edb/ref 17592186570924 #edb/ref 17592186045417] [17592186571309 #edb/ref 1075 #edb/ref 17592186570969 #edb/ref 17592186045417] [17592186571309 #edb/ref 1075 #edb/ref 17592186570972 #edb/ref 17592186045417] [17592186571309 #edb/ref 1075 #edb/ref 17592186571005 #edb/ref 17592186045417] [17592186571309 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186571309 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186571309 #edb/ref 1078 #edb/ref 17592186570972 #edb/ref 17592186045417] [17592186571309 #edb/ref 1079 #uuid "4782ff3c-c734-5dad-88e3-9bed03473528" #edb/ref 17592186045417] [17592186571356 #edb/ref 1075 #edb/ref 17592186570927 #edb/ref 17592186045417] [17592186571356 #edb/ref 1075 #edb/ref 17592186571003 #edb/ref 17592186045417] [17592186571356 #edb/ref 1075 #edb/ref 17592186571031 #edb/ref 17592186045417] [17592186571356 #edb/ref 1075 #edb/ref 17592186571094 #edb/ref 17592186045417] [17592186571356 #edb/ref 1075 #edb/ref 17592186571224 #edb/ref 17592186045417] [17592186571356 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186571356 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186571356 #edb/ref 1078 #edb/ref 17592186571224 #edb/ref 17592186045417] [17592186571356 #edb/ref 1079 #uuid "cf2bf7fa-473d-5f46-831b-f02037509aa6" #edb/ref 17592186045417] [17592186571362 #edb/ref 1075 #edb/ref 17592186571154 #edb/ref 17592186045417] [17592186571362 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186571362 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186571362 #edb/ref 1078 #edb/ref 17592186571154 #edb/ref 17592186045417] [17592186571362 #edb/ref 1079 #uuid "d70374a3-fd1e-563a-bc82-ef9476203959" #edb/ref 17592186045417] [17592186571394 #edb/ref 1068 #edb/ref 17592186571362 #edb/ref 17592186045417] [17592186571394 #edb/ref 1069 "q-210542" #edb/ref 17592186045417] [17592186571394 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186571394 #edb/ref 1071 "The electrostatic force $F,$ in newtons ($N$), exerted between two identical charged particles kept at a fixed distance apart, varies directly with the **square** of the charge $q$ of each particle, measured in coulombs $(C).$ If the electrostatic force is $8\\,976\\,N$ when the charges are $2\\,C,$ then express $F$ in terms of $q.$\n\n$F=$\n{{field-1}}" #edb/ref 17592186045417] [17592186571394 #edb/ref 1072 #uuid "493093e8-547a-52cb-ae1e-43635271726b" #edb/ref 17592186045417] [17592186571394 #edb/ref 1074 "The electrostatic force $F$ is directly proportional to the square of the charge $q,$ so we have\n\n$$\nF=k{q}^{2},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that $F=8\\,976\\,\\text{N}$ when $q=2\\,\\text{C}.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}8\\,976 & =k\\cdot {2}^{2} \\\\ 8\\,976 & =k\\cdot 4 \\\\ \\frac{8\\,976}{4} & =k \\\\ 2\\,244 & =k\\end{aligned}\n$$\n\nTherefore, our direct variation equation is\n\n$$\nF=2\\,244{q}^{2}.\n$$" #edb/ref 17592186045417] [17592186571398 #edb/ref 1068 #edb/ref 17592186571309 #edb/ref 17592186045417] [17592186571398 #edb/ref 1069 "q-120299" #edb/ref 17592186045417] [17592186571398 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186571398 #edb/ref 1071 "The surface $S,$ in square centimeters, of a cylinder whose height equals the radius of its base varies directly with the **square** of its radius $r,$ measured in centimeters. If the surface is $16\\pi \\,{\\text{cm}}^{2}$ when the radius is $2\\,\\text{cm},$ then what is the constant of variation?" #edb/ref 17592186045417] [17592186571398 #edb/ref 1072 #uuid "52c4a416-f053-5e55-99b6-12fd0ef1b322" #edb/ref 17592186045417] [17592186571398 #edb/ref 1074 "The surface $S$ is directly proportional to the radius $r,$ so we have\n\n$$\nS=k{r}^{2},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that $S=16\\pi \\,{\\text{cm}}^{2}$ when $r=2\\,\\text{cm}.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}16\\pi  & =k\\cdot {2}^{2} \\\\ 16\\pi  & =k\\cdot 4 \\\\ \\frac{16\\pi }{4} & =k \\\\ 4\\pi  & =k\\end{aligned}\n$$\n\nTherefore, the constant of variation is $k=4\\pi .$" #edb/ref 17592186045417] [17592186571412 #edb/ref 1068 #edb/ref 17592186571356 #edb/ref 17592186045417] [17592186571412 #edb/ref 1069 "q-52005" #edb/ref 17592186045417] [17592186571412 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186571412 #edb/ref 1071 "The distance $d$, in meters, a falling body travels after being released from rest varies directly with the **square** of the time $t,$ measured in seconds, since the body was released. If the body covers $12$ meters in $2$ seconds, then what is the constant of variation?" #edb/ref 17592186045417] [17592186571412 #edb/ref 1072 #uuid "6bd84e69-7c5f-5a4e-bce4-f665a1006214" #edb/ref 17592186045417] [17592186571412 #edb/ref 1074 "The distance $d$ is directly proportional to the square of the time $t$, so we have\n\n$$\nd=k{t}^{2},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that $d=12\\,\\text{m}$ when $t=2\\,\\text{s}.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}12 & =k\\cdot {2}^{2} \\\\ 12 & =k\\cdot 4 \\\\ \\frac{12}{4} & =k \\\\ 3 & =k\\end{aligned}\n$$\n\nTherefore, the constant of variation is $k=3.$" #edb/ref 17592186045417] [17592186571496 #edb/ref 1058 #edb/ref 17592186571517 #edb/ref 17592186045417] [17592186571496 #edb/ref 1062 #uuid "a99e37c4-23d9-55c1-b8b6-ca1793b52727" #edb/ref 17592186045417] [17592186571496 #edb/ref 1063 #edb/ref 17592186571398 #edb/ref 17592186045417] [17592186571503 #edb/ref 1058 #edb/ref 17592186571496 #edb/ref 17592186045417] [17592186571503 #edb/ref 1062 #uuid "c86fa239-db3c-5048-bcc4-8263276901e2" #edb/ref 17592186045417] [17592186571503 #edb/ref 1063 #edb/ref 17592186571412 #edb/ref 17592186045417] [17592186571517 #edb/ref 1062 #uuid "f590571b-7252-57ff-b911-5ccaa64a69e4" #edb/ref 17592186045417] [17592186571517 #edb/ref 1063 #edb/ref 17592186571394 #edb/ref 17592186045417]}
