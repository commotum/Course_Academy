#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186571503} :activity/id #uuid "af367d3a-cdad-5fce-b0de-9044800e4633" :activity/scope {:db/id #edb/ref 17592186049281 :topic/id #uuid "e9994744-cb83-57d9-8154-ea5ac4c05cc8" :topic/math-academy-id 2274} :activity/steps [{:db/id #edb/ref 17592186571496 :step/content {:db/id #edb/ref 17592186571398 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b0f61ca-4b31-5d02-b3fa-da62506bb922" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186570909} {:answer/id #uuid "178a11f1-2e2f-512c-81ef-7ba747eb04b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi" :db/id #edb/ref 17592186570924} {:answer/id #uuid "31844f5d-e1c6-58a5-911d-752c2c6738db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186570969} {:answer/id #uuid "34146648-0aef-5194-b0bd-b28640147dea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\pi" :db/id #edb/ref 17592186570972} {:answer/id #uuid "4841b2db-6473-515a-b60c-cb4143294f92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\pi" :db/id #edb/ref 17592186571005}] :answer-field/correct {:db/id #edb/ref 17592186570972} :answer-field/id #uuid "4782ff3c-c734-5dad-88e3-9bed03473528" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571309}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "52c4a416-f053-5e55-99b6-12fd0ef1b322" :question/math-academy-id "q-120299" :question/problem "The surface $S,$ in square centimeters, of a cylinder whose height equals the radius of its base varies directly with the **square** of its radius $r,$ measured in centimeters. If the surface is $16\\pi \\,{\\text{cm}}^{2}$ when the radius is $2\\,\\text{cm},$ then what is the constant of variation?" :question/worked-solution "The surface $S$ is directly proportional to the radius $r,$ so we have\n\n$$\nS=k{r}^{2},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that $S=16\\pi \\,{\\text{cm}}^{2}$ when $r=2\\,\\text{cm}.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}16\\pi  & =k\\cdot {2}^{2} \\\\ 16\\pi  & =k\\cdot 4 \\\\ \\frac{16\\pi }{4} & =k \\\\ 4\\pi  & =k\\end{aligned}\n$$\n\nTherefore, the constant of variation is $k=4\\pi .$"} :step/id #uuid "a99e37c4-23d9-55c1-b8b6-ca1793b52727" :step/next {:db/id #edb/ref 17592186571517}} {:db/id #edb/ref 17592186571503 :step/content {:db/id #edb/ref 17592186571412 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1897ea72-c13e-5fd4-8083-32c921ead598" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186570927} {:answer/id #uuid "4786e8d1-90b1-5d13-9ebd-a4ddaedea0e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186571003} {:answer/id #uuid "58ba7898-216c-5d88-b22b-f355ac55120b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186571031} {:answer/id #uuid "82b7408e-0165-58fb-9ffe-29dd90fb32bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186571094} {:answer/id #uuid "d611d837-c607-55f1-84f6-82a363b4fcc6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186571224}] :answer-field/correct {:db/id #edb/ref 17592186571224} :answer-field/id #uuid "cf2bf7fa-473d-5f46-831b-f02037509aa6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571356}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6bd84e69-7c5f-5a4e-bce4-f665a1006214" :question/math-academy-id "q-52005" :question/problem "The distance $d$, in meters, a falling body travels after being released from rest varies directly with the **square** of the time $t,$ measured in seconds, since the body was released. If the body covers $12$ meters in $2$ seconds, then what is the constant of variation?" :question/worked-solution "The distance $d$ is directly proportional to the square of the time $t$, so we have\n\n$$\nd=k{t}^{2},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that $d=12\\,\\text{m}$ when $t=2\\,\\text{s}.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}12 & =k\\cdot {2}^{2} \\\\ 12 & =k\\cdot 4 \\\\ \\frac{12}{4} & =k \\\\ 3 & =k\\end{aligned}\n$$\n\nTherefore, the constant of variation is $k=3.$"} :step/id #uuid "c86fa239-db3c-5048-bcc4-8263276901e2" :step/next {:db/id #edb/ref 17592186571496}} {:db/id #edb/ref 17592186571517 :step/content {:db/id #edb/ref 17592186571394 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6f99b8f-3a5a-5ef1-bccb-09ce2846b404" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2244q^2" :db/id #edb/ref 17592186571154}] :answer-field/correct {:db/id #edb/ref 17592186571154} :answer-field/id #uuid "d70374a3-fd1e-563a-bc82-ef9476203959" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186571362}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "493093e8-547a-52cb-ae1e-43635271726b" :question/math-academy-id "q-210542" :question/problem "The electrostatic force $F,$ in newtons ($N$), exerted between two identical charged particles kept at a fixed distance apart, varies directly with the **square** of the charge $q$ of each particle, measured in coulombs $(C).$ If the electrostatic force is $8\\,976\\,N$ when the charges are $2\\,C,$ then express $F$ in terms of $q.$\n\n$F=$\n{{field-1}}" :question/worked-solution "The electrostatic force $F$ is directly proportional to the square of the charge $q,$ so we have\n\n$$\nF=k{q}^{2},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that $F=8\\,976\\,\\text{N}$ when $q=2\\,\\text{C}.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}8\\,976 & =k\\cdot {2}^{2} \\\\ 8\\,976 & =k\\cdot 4 \\\\ \\frac{8\\,976}{4} & =k \\\\ 2\\,244 & =k\\end{aligned}\n$$\n\nTherefore, our direct variation equation is\n\n$$\nF=2\\,244{q}^{2}.\n$$"} :step/id #uuid "f590571b-7252-57ff-b911-5ccaa64a69e4"}] :activity/title "Modeling with Direct Variation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186570886}]}
