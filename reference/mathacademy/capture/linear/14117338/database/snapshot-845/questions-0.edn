0 \\\\ 0 & 0 & 1\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $W,$ and the vector $b$ above. If the normal equation for the corresponding weighted least-squares problem $W\\,A=Wb$ is given by\n\n$$\n[\\begin{aligned}a & 18 \\\\ 18 & b\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}c \\\\ 3\\end{aligned}]\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n$$\n{W}^{T}W=[\\begin{aligned}{2}^{2} & 0 & 0 \\\\ 0 & {1}^{2} & 0 \\\\ 0 & 0 & {1}^{2}\\end{aligned}]=[\\begin{aligned}4 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}],\n$$\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & 4 & 2 \\\\ 0 & 4 & 1\\end{aligned}][\\begin{aligned}4 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 4 & 4 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}1 & 4 & 2 \\\\ 0 & 4 & 1\\end{aligned}][\\begin{aligned}4 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}4 \\\\ 1 \\\\ -1\\end{aligned}] \\\\ [\\begin{aligned}1 & 4 & 2 \\\\ 0 & 4 & 1\\end{aligned}][\\begin{aligned}4 & 0 \\\\ 4 & 4 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}1 & 4 & 2 \\\\ 0 & 4 & 1\\end{aligned}][\\begin{aligned}16 \\\\ 1 \\\\ -1\\end{aligned}] \\\\ [\\begin{aligned}24 & 18 \\\\ 18 & 17\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}18 \\\\ 3\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=24+17+18=59.\n$$"}] [{:db/id #edb/ref 17592186162350 :knowledge-point/_questions [{:db/id #edb/ref 17592186162093 :knowledge-point/id #uuid "b21c27bd-5c7a-5645-93b5-0af73c59f685" :knowledge-point/title "Finding the Solution to a Weighted Least-Squares Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "088981d3-114e-574b-937a-924f96c1a577" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{5}{3} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186412634} {:answer/id #uuid "495b45ed-6e05-5844-806a-6ba5b784755f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{5}{3} \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186412639} {:answer/id #uuid "552d678b-530b-5d1a-bf8b-91ab4eb12691" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186412640} {:answer/id #uuid "e4052908-8f95-52dd-aefc-cb82ac135212" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{4}{3} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186412649} {:answer/id #uuid "fb119cac-1cdf-5bd7-b4cf-2acfdf9b0565" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186412653}] :answer-field/correct {:answer/id #uuid "088981d3-114e-574b-937a-924f96c1a577" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{5}{3} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186412634} :answer-field/id #uuid "fea215fb-04f0-534e-86ff-be0201f49602" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412657}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f6bb363c-48b6-5047-89db-8e3fcc537bc7" :question/math-academy-id "q-137102" :question/problem "Find the solution for the weighted least-squares problem $W\\,Ax=Wb,$ where\n\n$$\nA=[\\begin{aligned}1 & -1 \\\\ 1 & 0 \\\\ 2 & -1\\end{aligned}],\\,b=[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}],\\,W=[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 1\\end{aligned}].\n$$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n$$\n{W}^{T}W=[\\begin{aligned}{2}^{2} & 0 & 0 \\\\ 0 & {2}^{2} & 0 \\\\ 0 & 0 & {1}^{2}\\end{aligned}]=[\\begin{aligned}4 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{aligned}],\n$$\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & 1 & 2 \\\\ -1 & 0 & -1\\end{aligned}][\\begin{aligned}4 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & -1 \\\\ 1 & 0 \\\\ 2 & -1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}1 & 1 & 2 \\\\ -1 & 0 & -1\\end{aligned}][\\begin{aligned}4 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}1 & 1 & 2 \\\\ -1 & 0 & -1\\end{aligned}][\\begin{aligned}4 & -4 \\\\ 4 & 0 \\\\ 2 & -1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}1 & 1 & 2 \\\\ -1 & 0 & -1\\end{aligned}][\\begin{aligned}4 \\\\ 8 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}12 & -6 \\\\ -6 & 5\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}14 \\\\ -5\\end{aligned}]\\end{aligned}\n$$\n\nFinally, since the matrix on the left-hand side is invertible, we obtain\n\n$$\n\\begin{aligned}[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & ={[\\begin{aligned}12 & -6 \\\\ -6 & 5\\end{aligned}]}^{-1}[\\begin{aligned}14 \\\\ -5\\end{aligned}] \\\\  & =\\frac{1}{12\\cdot 5-(-6)\\cdot (-6)}[\\begin{aligned}5 & 6 \\\\ 6 & 12\\end{aligned}][\\begin{aligned}14 \\\\ -5\\end{aligned}] \\\\  & =\\frac{1}{24}[\\begin{aligned}40 \\\\ 24\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{5}{3} \\\\ 1\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186412659 :knowledge-point/_questions [{:db/id #edb/ref 17592186162092 :knowledge-point/id #uuid "af51b0b6-4ae7-5b6a-b151-7f8cb88fa186" :knowledge-point/title "Finding the Normal Equation for a Weighted Least-Squares Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "598cbe9b-f2eb-52d5-9e41-b48441ed64d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186412641} {:answer/id #uuid "84e93a6b-0108-570f-8119-23d513088357" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "53" :db/id #edb/ref 17592186412643} {:answer/id #uuid "8e9cc8d3-0106-5ea8-86d6-66b4ea64a0cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186412644} {:answer/id #uuid "934431cc-66ef-56d1-a66f-d360d9139b16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186412645} {:answer/id #uuid "f9cbe89f-eecc-5c0e-b93a-5822e57acd6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186412651}] :answer-field/correct {:answer/id #uuid "598cbe9b-f2eb-52d5-9e41-b48441ed64d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186412641} :answer-field/id #uuid "b982590b-c792-58f1-b493-14196b43933c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412656}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8d91806b-81b0-566e-90e0-48dc8925cff9" :question/math-academy-id "q-137886" :question/problem "$$\nA=[\\begin{aligned}1 & 2 \\\\ 3 & 6 \\\\ 0 & 0\\end{aligned}],\\,b=[\\begin{aligned}0 \\\\ 1 \\\\ 2\\end{aligned}],\\,W=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 2\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $W,$ and the vector $b$ above. If the normal equation for the corresponding weighted least-squares problem $W\\,Ax=Wb$ is given by\n\n$$\n[\\begin{aligned}a & 20 \\\\ 20 & b\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}3 \\\\ c\\end{aligned}]\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n$$\n{W}^{T}W=[\\begin{aligned}{1}^{2} & 0 & 0 \\\\ 0 & {1}^{2} & 0 \\\\ 0 & 0 & {2}^{2}\\end{aligned}]=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 4\\end{aligned}],\n$$\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & 3 & 0 \\\\ 2 & 6 & 0\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 4\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 3 & 6 \\\\ 0 & 0\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}1 & 3 & 0 \\\\ 2 & 6 & 0\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 4\\end{aligned}][\\begin{aligned}0 \\\\ 1 \\\\ 2\\end{aligned}] \\\\ [\\begin{aligned}1 & 3 & 0 \\\\ 2 & 6 & 0\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 3 & 6 \\\\ 0 & 0\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}1 & 3 & 0 \\\\ 2 & 6 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1 \\\\ 8\\end{aligned}] \\\\ [\\begin{aligned}10 & 20 \\\\ 20 & 40\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}3 \\\\ 6\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=10+40+6=56.\n$$"}] [{:db/id #edb/ref 17592186411867 :knowledge-point/_questions [{:db/id #edb/ref 17592186162093 :knowledge-point/id #uuid "b21c27bd-5c7a-5645-93b5-0af73c59f685" :knowledge-point/title "Finding the Solution to a Weighted Least-Squares Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "118a9ee1-aa44-5777-9118-5227ee29fe39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186411690} {:answer/id #uuid "343f47c9-bb05-5183-9f14-e8b4fa694501" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186411704} {:answer/id #uuid "4d9f0f42-a4f1-5465-a3a2-7a60cda35ef3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186411719} {:answer/id #uuid "8cb4a560-b34c-5ecb-b912-d45e89d2bc34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186411753} {:answer/id #uuid "fd063dda-be76-5f0e-93fe-6561f604b438" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186411817}] :answer-field/correct {:answer/id #uuid "4d9f0f42-a4f1-5465-a3a2-7a60cda35ef3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186411719} :answer-field/id #uuid "4272bc52-3700-5a4c-920e-c054cf89452b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411825}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9a9c63b9-55aa-5f88-8ff0-b14dd8c3b850" :question/math-academy-id "q-137889" :question/problem "Find the solution for the weighted least-squares problem $W\\,Ax=Wb,$ where\n\n$$\nA=[\\begin{aligned}1 & 2 \\\\ 0 & 1 \\\\ 2 & 0\\end{aligned}],\\,b=[\\begin{aligned}1 \\\\ 1 \\\\ -2\\end{aligned}],\\,W=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 2\\end{aligned}].\n$$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n$$\n{W}^{T}W=[\\begin{aligned}{1}^{2} & 0 & 0 \\\\ 0 & {1}^{2} & 0 \\\\ 0 & 0 & {2}^{2}\\end{aligned}]=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 4\\end{aligned}],\n$$\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & 0 & 2 \\\\ 2 & 1 & 0\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 4\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 0 & 1 \\\\ 2 & 0\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}1 & 0 & 2 \\\\ 2 & 1 & 0\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 4\\end{aligned}][\\begin{aligned}1 \\\\ 1 \\\\ -2\\end{aligned}] \\\\ [\\begin{aligned}1 & 0 & 2 \\\\ 2 & 1 & 0\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 0 & 1 \\\\ 8 & 0\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}1 & 0 & 2 \\\\ 2 & 1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 1 \\\\ -8\\end{aligned}] \\\\ [\\begin{aligned}17 & 2 \\\\ 2 & 5\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}-15 \\\\ 3\\end{aligned}]\\end{aligned}\n$$\n\nFinally, since the matrix on the left-hand side is invertible, we obtain\n\n$$\n\\begin{aligned}[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & ={[\\begin{aligned}17 & 2 \\\\ 2 & 5\\end{aligned}]}^{-1}[\\begin{aligned}-15 \\\\ 3\\end{aligned}] \\\\  & =\\frac{1}{17\\cdot 5-2\\cdot 2}[\\begin{aligned}5 & -2 \\\\ -2 & 17\\end{aligned}][\\begin{aligned}-15 \\\\ 3\\end{aligned}] \\\\  & =\\frac{1}{81}[\\begin{aligned}-81 \\\\ 81\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ 1\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186412658 :knowledge-point/_questions [{:db/id #edb/ref 17592186162093 :knowledge-point/id #uuid "b21c27bd-5c7a-5645-93b5-0af73c59f685" :knowledge-point/title "Finding the Solution to a Weighted Least-Squares Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "466cb1d5-bbaa-5bcf-a4b9-8e35b9769bc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186412638} {:answer/id #uuid "7390aa1b-1e0b-5b8f-8041-bba7a08ed6ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186412642} {:answer/id #uuid "b8d7ad48-ee12-53ed-ae80-3bfaa814df4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186412647} {:answer/id #uuid "cb0cdbb1-4af3-53da-b876-22b6640991ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186412648} {:answer/id #uuid "f47c99c4-37e6-574e-a7cb-b1c519e96e66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186412650}] :answer-field/correct {:answer/id #uuid "7390aa1b-1e0b-5b8f-8041-bba7a08ed6ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186412642} :answer-field/id #uuid "68d36053-187e-5834-b46e-6140de6fde31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412655}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7e019bd1-c120-5401-ab70-85681df29503" :question/math-academy-id "q-137930" :question/problem "$$\nA=[\\begin{aligned}2 & 6 \\\\ -1 & -3 \\\\ 1 & 3\\end{aligned}],\\,b=[\\begin{aligned}-22 \\\\ 11 \\\\ 7\\end{aligned}],\\,W=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 1\\end{aligned}].\n$$\n\nConsider the matrices $A$ and $W,$ and the vector $b$ shown above. If the general solution for the weighted least-squares problem $W\\,Ax=Wb$ is \n\n$$\n[\\begin{aligned}a \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}b \\\\ c\\end{aligned}],\\,{x}_{2}\\in R,\n$$\n\nwhat is the value of  $a+\\frac{b}{c}?$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n$$\n{W}^{T}W=[\\begin{aligned}{1}^{2} & 0 & 0 \\\\ 0 & {2}^{2} & 0 \\\\ 0 & 0 & {1}^{2}\\end{aligned}]=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{aligned}],\n$$\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}[\\begin{aligned}2 & -1 & 1 \\\\ 6 & -3 & 3\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}2 & 6 \\\\ -1 & -3 \\\\ 1 & 3\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}2 & -1 & 1 \\\\ 6 & -3 & 3\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}-22 \\\\ 11 \\\\ 7\\end{aligned}] \\\\ [\\begin{aligned}2 & -1 & 1 \\\\ 6 & -3 & 3\\end{aligned}][\\begin{aligned}2 & 6 \\\\ -4 & -12 \\\\ 1 & 3\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}2 & -1 & 1 \\\\ 6 & -3 & 3\\end{aligned}][\\begin{aligned}-22 \\\\ 44 \\\\ 7\\end{aligned}] \\\\ [\\begin{aligned}9 & 27 \\\\ 27 & 81\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}-81 \\\\ -243\\end{aligned}]\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the above matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}9 & 27 & -81 \\\\ 27 & 81 & -243\\end{aligned}] & {R}_{2}:={R}_{2}-3{R}_{1} \\\\  & ∼[\\begin{aligned}9 & 27 & -81 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=-9-3{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n[\\begin{aligned}-9-3{x}_{2} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}-9 \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}-3 \\\\ 1\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\na+\\frac{b}{c}=-9+\\frac{(-3)}{1}=-12.\n$$"}]}
