#{[{:activity/first-step {:db/id #edb/ref 17592186101796} :activity/id #uuid "af8776aa-b3ed-5305-95b5-bf42623f4ed3" :activity/scope {:db/id #edb/ref 17592186049226 :topic/id #uuid "e4f7b310-649d-511b-ae6e-709dcea1f6cd" :topic/math-academy-id 1246} :activity/steps [{:db/id #edb/ref 17592186101602 :step/content {:db/id #edb/ref 17592186100823 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100658 :question/id #uuid "0f441b48-b977-538c-82af-aa40ed4076d2" :question/math-academy-id "e-3561"} :knowledge-point/id #uuid "23567a86-8e1e-5b94-bac6-09c79cdb42c9" :knowledge-point/questions [{:db/id #edb/ref 17592186101387} {:db/id #edb/ref 17592186101388}] :knowledge-point/title "Applying the Product Rule to Compute a Limit Given a Graph"} :step/id #uuid "2408ea61-ca9b-52c5-ae47-17af57a34e64" :step/math-academy-id 12001 :step/next {:db/id #edb/ref 17592186101797}} {:db/id #edb/ref 17592186101603 :step/content {:db/id #edb/ref 17592186100824 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100659 :question/id #uuid "7a24a8e0-768e-541c-aff1-cad6f977da87" :question/math-academy-id "e-3562"} :knowledge-point/id #uuid "5feb914d-efad-5d89-85a9-db99befc9928" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050653}] :knowledge-point/questions [{:db/id #edb/ref 17592186101385} {:db/id #edb/ref 17592186101386} {:db/id #edb/ref 17592186233420} {:db/id #edb/ref 17592186235427}] :knowledge-point/title "Applying the Product Rule to Compute a Limit"} :step/id #uuid "a3d559f2-c362-56ee-804c-080f88071508" :step/math-academy-id 12002 :step/next {:db/id #edb/ref 17592186101602}} {:db/id #edb/ref 17592186101796 :step/content {:db/id #edb/ref 17592186101928 :tutorial/content "The **product rule** states that the limit of the product of two functions equals the product of the limits.\n\nMore precisely, if\n\n$$\n\\lim_\\limits{x\\rightarrow \\, a}f(x)=L\n$$\n\nand\n\n$$\n\\lim_\\limits{x\\rightarrow \\, a}g(x)=K\n$$\n\nthen\n\n$$\n\\begin{aligned}\nlim_(x → a)(f(x) \\cdot g(x)) &= lim_(x → a)f(x) \\cdot lim_(x → a)g(x) \\\\\n&= L \\cdot K\n\\end{aligned}\n$$\n\nFor example, we can evaluate\n\n$$\n\\lim_\\limits{x \\rightarrow \\,2} \\left[ (x^2 +2x +3)(x^3-2x-1) \\right]\n$$\n\nby evaluating the limit of each polynomial separately, and then multiplying the results together:\n\n$$\n\\begin{aligned}\nlim_(x → 2)[(x^{2} + 2x + 3)(x^{3} - 2x - 1)] &= lim_(x → 2)(x^{2} + 2x + 3) \\cdot lim_(x → 2)(x^{3} - 2x - 1) \\\\\n&= (2^{2} + 2 \\cdot 2 + 3) \\cdot (2^{3} - 2 \\cdot 2 - 1) \\\\\n&= (4 + 4 + 3) \\cdot (8 - 4 - 1) \\\\\n&= (11) \\cdot (3) \\\\\n&= 33\n\\end{aligned}\n$$" :tutorial/id #uuid "c7f68019-2904-5740-87e6-e66d189cb771" :tutorial/math-academy-id 175 :tutorial/title "Introduction"} :step/id #uuid "55b6421a-40da-531f-9d53-41329827a526" :step/math-academy-id 333 :step/next {:db/id #edb/ref 17592186101603}} {:db/id #edb/ref 17592186101797 :step/content {:db/id #edb/ref 17592186101929 :tutorial/content "The **quotient rule** states that the limit of the quotient of two functions equals the quotient of the limits (provided that the limit of the denominator is not zero).\n\nMore precisely, if\n\n$$\n\\lim_\\limits{x\\rightarrow a}f(x)=L\n$$\n\nand\n\n$$\n\\lim_\\limits{x\\rightarrow a}g(x)= K \\neq 0\n$$\n\n, then\n\n$$\n\\lim_\\limits{x\\rightarrow a} \\dfrac{f(x)}{g(x)} = \\dfrac{\\lim_\\limits{x\\rightarrow a}f(x)}{\\lim_\\limits{x\\rightarrow a}g(x)}=\\dfrac{L}{K}\n$$\n\nFor example, we can evaluate\n\n$$\n\\lim_\\limits{x \\rightarrow \\,2} \\dfrac{x^2+4x}{x+1}\n$$\n\nby evaluating the limits of the numerator and denominator separately, and then dividing the results:\n\n$$\n\\begin{aligned}\nlim_(x → 2)\\frac{x^{2} + 4x}{x + 1} &= (lim_(x → 2)(x^{2} + 4x))/(lim_(x → 2)(x + 1)) \\\\\n&= \\frac{2^{2} + 4 \\cdot 2}{2 + 1} \\\\\n&= \\frac{12}{3} \\\\\n&= 4\n\\end{aligned}\n$$" :tutorial/id #uuid "46d526ad-25bf-58f5-88e0-695b4ff6d430" :tutorial/math-academy-id 178 :tutorial/title "The Quotient Rule for Limits"} :step/id #uuid "67532783-b8e9-5de2-9ca2-19a49fbf6ec4" :step/math-academy-id 339 :step/next {:db/id #edb/ref 17592186101798}} {:db/id #edb/ref 17592186101798 :step/content {:db/id #edb/ref 17592186100952 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100620 :question/id #uuid "04538f07-6e4c-547e-be0c-8b62025e19ff" :question/math-academy-id "e-28"} :knowledge-point/id #uuid "0a649e49-73c7-5470-8361-2002da74f234" :knowledge-point/questions [{:db/id #edb/ref 17592186101389} {:db/id #edb/ref 17592186101419} {:db/id #edb/ref 17592186235468}] :knowledge-point/title "Applying the Quotient Rule to Compute a Limit"} :step/id #uuid "e8f2b1af-f0df-5d06-b349-280fb90373de" :step/math-academy-id 340 :step/next {:db/id #edb/ref 17592186101799}} {:db/id #edb/ref 17592186101799 :step/content {:db/id #edb/ref 17592186100953 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100621 :question/id #uuid "71b3f83c-33e6-5043-9215-7db7b4b12497" :question/math-academy-id "e-29"} :knowledge-point/id #uuid "b0159149-010c-5bef-a28d-85c4c43f0586" :knowledge-point/questions [{:db/id #edb/ref 17592186101241} {:db/id #edb/ref 17592186101242} {:db/id #edb/ref 17592186235507} {:db/id #edb/ref 17592186512873}] :knowledge-point/title "Applying the Quotient Rule to Compute a Limit Given a Graph"} :step/id #uuid "1da33225-c9cd-5fd9-8576-b2d8fdce7dcf" :step/math-academy-id 342}] :activity/title "The Product and Quotient Rules for Limits" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186101087}]}
