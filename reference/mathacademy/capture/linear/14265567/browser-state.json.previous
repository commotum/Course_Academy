      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14265567/observations/step-q59754-085a91149ee7eab0be6a.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14265567/observations/step-q59754-085a91149ee7eab0be6a.png",
      "source_url": "https://mathacademy.com/tasks/14265567/topics/2327/lesson",
