#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186508162} :activity/id #uuid "d4e27f16-3ada-5048-ad9f-c15bdd8faa37" :activity/scope {:db/id #edb/ref 17592186048121 :topic/id #uuid "809502b3-ee2f-5a96-8373-13e255b37eac" :topic/math-academy-id 263} :activity/steps [{:db/id #edb/ref 17592186508143 :step/content {:db/id #edb/ref 17592186508113 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32fcd00f-a39a-58b1-925b-6f97038dc7ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\sqrt{2}" :db/id #edb/ref 17592186507668} {:answer/id #uuid "7a5e9904-c441-5249-95eb-da32c2bf31f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186507775} {:answer/id #uuid "b21ebaaf-7316-5810-a179-40920135f9f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186507844} {:answer/id #uuid "e5291e91-5e75-563e-9047-4ac169fda707" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186507908} {:answer/id #uuid "fa1bd1ce-5d7c-5356-8a41-6149fd10be2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186507937}] :answer-field/correct {:db/id #edb/ref 17592186507937} :answer-field/id #uuid "563ab28a-360a-5519-9504-d8c10d6a3bc9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186507979}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ed931f9b-ec89-504b-8f3a-6fc6233992c9" :question/math-academy-id "q-82302" :question/problem "![](images/27/2788f2795065599063c67d9ae7e9e6ee17cae4aa21198450faf7c09ad10765e1.png)\n\nThe perimeter of the above triangle is $6+3\\sqrt{2}.$ Find the measure of each leg." :question/worked-solution "Because the triangle is isosceles, the legs must have the same length. Let $a$ be the length of each leg. So, we have\n\n$$\nAB=BC=a.\n$$\n\nMoreover, because the triangle is a *right* isosceles triangle, the hypotenuse must be equal to $\\sqrt{2}$ times the length of a leg. Therefore,\n\n$$\nAC=AB\\cdot \\sqrt{2}=a\\sqrt{2}.\n$$\n\nFinally, since the perimeter is $p=6+3\\sqrt{2},$ we have\n\n$$\n\\begin{aligned}p & =AB+BC+AC \\\\ 6+3\\sqrt{2} & =a+a+a\\sqrt{2} \\\\ 3(2+\\sqrt{2}) & =2a+a\\sqrt{2} \\\\ 3(2+\\sqrt{2}) & =(2+\\sqrt{2})a \\\\ 3\\cancel{(2+\\sqrt{2})} & =\\cancel{(2+\\sqrt{2})}a \\\\ 3 & =a.\\end{aligned}\n$$\n\nTherefore, the measure of a leg is $3.$"} :step/id #uuid "8730d12c-cd05-5ba6-99b2-4dbdb27838ea" :step/next {:db/id #edb/ref 17592186508149}} {:db/id #edb/ref 17592186508149 :step/content {:db/id #edb/ref 17592186508105 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "241e62f7-500f-5996-9c45-a5607a120603" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\sqrt{2}" :db/id #edb/ref 17592186507640} {:answer/id #uuid "5288f03e-bcc1-596c-b630-e9cce9ef441f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186507722} {:answer/id #uuid "628e1648-d1f4-5cdd-a67a-e29de5ad49a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5\\sqrt{2}}{2}" :db/id #edb/ref 17592186507743} {:answer/id #uuid "b789fe7c-a826-5709-8e86-6a1815f091c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186507851} {:answer/id #uuid "e77d63d4-3768-57eb-87f1-5ab52552457c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\sqrt{2}" :db/id #edb/ref 17592186507912}] :answer-field/correct {:db/id #edb/ref 17592186507722} :answer-field/id #uuid "3915ce74-cbdd-56d7-8c28-9b915fda8173" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186507962}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d933a602-cca3-50d1-9290-6754d9186974" :question/math-academy-id "q-82303" :question/problem "![](images/70/70d961102240b0c48132baca8db0b77ed80ff8e0d3b7296bd5c727ab2f97dfd3.png)\n\nThe perimeter of the above triangle is $10+5\\sqrt{2}.$ Find the measure of each leg." :question/worked-solution "Because the triangle is isosceles, the legs must have the same length. Let $a$ be the length of each leg. So, we have\n\n$$\nAB=BC=a.\n$$\n\nMoreover, because the triangle is a *right* isosceles triangle, the hypotenuse must be equal to $\\sqrt{2}$ times the length of a leg. Therefore,\n\n$$\nAC=AB\\cdot \\sqrt{2}=a\\sqrt{2}.\n$$\n\nFinally, since the perimeter is $p=10+5\\sqrt{2},$ we have\n\n$$\n\\begin{aligned}p & =AB+BC+AC \\\\ 10+5\\sqrt{2} & =a+a+a\\sqrt{2} \\\\ 5(2+\\sqrt{2}) & =2a+a\\sqrt{2} \\\\ 5(2+\\sqrt{2}) & =(2+\\sqrt{2})a \\\\ 5\\cancel{(2+\\sqrt{2})} & =\\cancel{(2+\\sqrt{2})}a \\\\ 5 & =a.\\end{aligned}\n$$\n\nTherefore, the measure of a leg is $5.$"} :step/id #uuid "a6f7ec19-e013-5d9c-bcfa-d6001e21386c"} {:db/id #edb/ref 17592186508162 :step/content {:db/id #edb/ref 17592186508040 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f9feb6b-dcf3-574d-a90e-17e5696df9b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186507739} {:answer/id #uuid "665ff479-5f6c-53a5-8058-2fe44ac3785d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186507749} {:answer/id #uuid "aa4ee9ac-349c-5bdf-9164-c6193cd4e551" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186507836} {:answer/id #uuid "bba14005-dce5-5914-a761-712d664bb63a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2\\sqrt{2}}" :db/id #edb/ref 17592186507857} {:answer/id #uuid "c3eab157-7b55-56d1-9b81-180236a85206" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186507871}] :answer-field/correct {:db/id #edb/ref 17592186507871} :answer-field/id #uuid "71e2b994-15e5-5aeb-82fd-d4bc2277603b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186507992}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0589289f-bd62-59fb-8540-3927d969e746" :question/math-academy-id "q-1663" :question/problem "If the hypotenuse of a ${45}^{∘}$-${45}^{∘}$-${90}^{∘}$ triangle has a length of $2$, then what is the length of each leg?" :question/worked-solution "The hypotenuse in a ${45}^{∘}$-${45}^{∘}$-${90}^{∘}$ triangle is equal to $\\sqrt{2}$ times the length of a leg.\n\nHere, we know that the hypotenuse has length $2.$ So, if the length of a leg is $a,$ then we must have\n\n$$\n\\begin{aligned}2 & =\\sqrt{2}\\cdot a \\\\ a & =\\frac{2}{\\sqrt{2}}.\\end{aligned}\n$$\n\nTo remove the square root from the denominator, we can multiply both the numerator and denominator by $\\sqrt{2},$ as follows:\n\n$$\n\\begin{aligned}a & =\\frac{2\\cdot \\sqrt{2}}{\\sqrt{2}\\cdot \\sqrt{2}} \\\\  & =\\frac{2\\sqrt{2}}{2} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the length of each leg is $\\sqrt{2}.$"} :step/id #uuid "e2059ad8-8e80-5bdc-ac88-748ce810f290" :step/next {:db/id #edb/ref 17592186508143}}] :activity/title "Isosceles Right Triangles" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186507606}]}
