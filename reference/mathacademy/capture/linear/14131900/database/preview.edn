96bba68be3cb4916f4e7aab7.png)\n\nWhat is the measure of $\\overset{^}{COE}?$" 13194139534679 17592186045417 true] [17592186432453 1072 #uuid "04351232-e12f-56c5-9996-c18094808c54" 13194139534679 17592186045417 true] [17592186432453 1074 "![](images/18/18be9d5946a70aa62b4dda5408fa7e3312fe2e33675cbf695cbbdecac2feaa5b.png)\n\nFirst, notice that $\\overset{^}{COD}$ and $\\overset{^}{DOE}$ are adjacent because they share the same side $\\overset{\\to }{OD}.$\n\nWe can add the measures of two adjacent angles to find the measure of the combined angle.\n\nTherefore:\n\n$$\n\\begin{aligned}m\\overset{^}{COE} & =m\\overset{^}{COD}+m\\overset{^}{DOE} \\\\  & ={70}^{∘}+{35}^{∘} \\\\  & ={105}^{∘}\\end{aligned}\n$$" 13194139534679 17592186045417 true] [17592186432454 1068 #edb/ref 17592186432446 13194139534679 17592186045417 true] [17592186432454 1069 "q-150765" 13194139534679 17592186045417 true] [17592186432454 1070 #edb/ref 17592186045485 13194139534679 17592186045417 true] [17592186432454 1071 "![](images/d8/d8552636c6f68b4885bf8a30bb8611629c0891ddc8c61cd27ff43c95cf6057bd.png)\n\nIn the diagram above, $m∠BAD={70}^{∘}.$ What equation could be used to find the value of $x?$" 13194139534679 17592186045417 true] [17592186432454 1072 #uuid "22b396b3-caeb-5440-bb61-ec5206652aa9" 13194139534679 17592186045417 true] [17592186432454 1074 "Here, the letter $x$ represents the measure of the unknown angle $∠BAC.$\n\nNote the following:\n\n- The angles $∠BAC$ and $∠CAD$ are adjacent because they share the side $\\overset{\\to }{AC}.$\n\n- So, the measure of the *large* angle $(∠BAD)$ must be the *sum* of the measures of the two *smaller* angles $(∠BAC$ and $∠CAD).$\n\n- This means that the measure of $∠BAC$ must be the *difference* between the large angle $(∠BAD)$ and the smaller known angle $(∠CAD).$\n\nTherefore, the correct equation to determine $x$ is the following:\n\n$$\nx={70}^{∘}-{30}^{∘}\n$$" 13194139534679 17592186045417 true] [17592186432455 1068 #edb/ref 17592186432443 13194139534679 17592186045417 true] [17592186432455 1069 "q-53142" 13194139534679 17592186045417 true] [17592186432455 1070 #edb/ref 17592186045485 13194139534679 17592186045417 true] [17592186432455 1071 "![](images/7e/7e365bb8c51729748b0efdb54f50459859a382cba1def4b32b4009b3bde89dbd.png)\n\nIn the figure above, find $m∠COE.$" 13194139534679 17592186045417 true] [17592186432455 1072 #uuid "39939039-dfca-5f99-86f6-773331c4950d" 13194139534679 17592186045417 true] [17592186432455 1074 "![](images/ae/ae007a68607a96bfd78986eeae11e69a4c8bd8dba35e8997933885d2ff1dc29f.png)\n\nFirst, notice that $∠COD$ and $∠DOE$ are adjacent because they share the side $\\overset{\\to }{OD}.$\n\nWe can add the measures of two adjacent angles to find the measure of the combined angle.\n\nTherefore:\n\n$$\n\\begin{aligned}m∠COE & =m∠COD+m∠DOE \\\\  & ={45}^{∘}+{59}^{∘} \\\\  & ={104}^{∘}\\end{aligned}\n$$" 13194139534679 17592186045417 true] [17592186432456 1068 #edb/ref 17592186432441 13194139534679 17592186045417 true] [17592186432456 1069 "q-154877" 13194139534679 17592186045417 true] [17592186432456 1070 #edb/ref 17592186045487 13194139534679 17592186045417 true] [17592186432456 1071 "![](images/e3/e3fe548e2dd695d682dec13287307e58fe28aa8a01b3e672695ef8ed07c61e1d.png)\n\nThe measure of the angle $∠BAE$ is ${150}^{∘}.$ Find the value of $x.$" 13194139534679 17592186045417 true] [17592186432456 1072 #uuid "461025dd-2d02-5f63-a292-225c3460091c" 13194139534679 17592186045417 true] [17592186432456 1074 "Here, the letter $x$ represents the measure of the unknown angle $∠DAE.$\n\nNote the following:\n\n- The angles $∠BAD$ and $∠DAE$ are adjacent because they share the side $\\overset{\\to }{AD}.$\n\n- So, the measure of the *large* angle $(∠BAE)$ must be the *sum* of the measures of the two *smaller* angles $(∠BAD$ and $∠DAE).$\n\n- This means that the measure of $∠DAE$ must be the *difference* between the large angle $(∠BAE)$ and the smaller known angle $(∠BAD).$\n\nTherefore, \n\n$$\nx={150}^{∘}-{110}^{∘}={40}^{∘}.\n$$" 13194139534679 17592186045417 true] [17592186432457 1068 #edb/ref 17592186432451 13194139534679 17592186045417 true] [17592186432457 1069 "q-150760" 13194139534679 17592186045417 true] [17592186432457 1070 #edb/ref 17592186045485 13194139534679 17592186045417 true] [17592186432457 1071 "![](images/17/17f25c6b6aa718b37a539f030a51b71ae12b7fa95aeb00fb68fa108e3a51df64.png)\n\nIn the figure above, find $m∠ROT.$" 13194139534679 17592186045417 true] [17592186432457 1072 #uuid "5dfae6a6-b61d-556e-b52c-ca5836e31d8c" 13194139534679 17592186045417 true] [17592186432457 1074 "![](images/02/0269db77d9a551b6f75e260bac9d3385d6cfad05d15359bff6f059e0050ef1dc.png)\n\nFirst, notice that $∠ROS$ and $∠SOT$ are adjacent because they share the same side $\\overset{\\to }{OS}.$\n\nWe can add the measures of two adjacent angles to find the measure of the combined angle.\n\nTherefore: \n\n$$\n\\begin{aligned}m∠ROT & =m∠ROS+m∠SOT \\\\  & ={55}^{∘}+{66}^{∘} \\\\  & ={121}^{∘}\\end{aligned}\n$$" 13194139534679 17592186045417 true] [17592186432458 1068 #edb/ref 17592186432452 13194139534679 17592186045417 true] [17592186432458 1069 "q-4320" 13194139534679 17592186045417 true] [17592186432458 1070 #edb/ref 17592186045487 13194139534679 17592186045417 true] [17592186432458 1071 "![](images/1e/1ed3b825702e9d446754d5bf56ff2964f8456bce45ab57fe9f6931458c9f5038.png)\n\nIn the figure above, $m∠DEA={147}^{∘}.$ Find the value of $x.$" 13194139534679 17592186045417 true] [17592186432458 1072 #uuid "9a3a7198-9475-534b-8bac-8c66e26d7479" 13194139534679 17592186045417 true] [17592186432458 1074 "Here, the letter $x$ represents the measure of the unknown angle $∠CED.$\n\nThe measure of $∠CED$ must be the *difference* between the large angle $(∠DEA)$ and the two smaller known angles $(∠CEB$ and $∠BEA).$\n\nTherefore, \n\n$$\nx={147}^{∘}-{56}^{∘}-{40}^{∘}={51}^{∘}.\n$$" 13194139534679 17592186045417 true] [17592186432459 1068 #edb/ref 17592186432449 13194139534679 17592186045417 true] [1759