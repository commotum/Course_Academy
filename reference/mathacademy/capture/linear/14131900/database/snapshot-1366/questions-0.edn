#{[{:db/id #edb/ref 17592186110292 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110671 :knowledge-point/id #uuid "3e8c4c24-2d04-5fd1-a9f4-6f1abb25c255" :knowledge-point/title "Finding the Measure of a Smaller Angle"}] :question/id #uuid "d4240cff-2c48-520b-a11a-f6838c163a17" :question/math-academy-id "e-10594" :question/problem "The measure of the angle $\\angle BAD$ is ${90}^{\\circ}$. Find the value of $x$.\n\n![](images/f4/f41802149d3e2a8524a47123e6de1bb6aa68e480cf54aafd756085ad52355ede.png)" :question/worked-solution "Here, the letter $x$ represents the measure of the unknown angle $\\angle CAD$.\n\nNote the following:\n\n- The angles $\\angle BAC$ and $\\angle CAD$ are adjacent because they share the side $\\overrightarrow{AC}$.\n- So, the measure of the *large* angle $(\\angle BAD)$ must be the *sum* of the measures of the two *smaller* angles $(\\angle BAC$ and $\\angle CAD)$.\n- This means that the measure of $\\angle CAD$ must be the *difference* between the large angle $(\\angle BAD)$ and the smaller known angle $(\\angle BAC)$.\n\nTherefore,\n\n$$\nx = 90^\\circ - 35^\\circ = 55^\\circ\n$$"}] [{:db/id #edb/ref 17592186110381 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110748 :knowledge-point/id #uuid "782a6a0a-7a15-5230-8f9d-5405aa72f96a" :knowledge-point/title "Finding the Measure of a Combined Angle"}] :question/id #uuid "361d828c-ec57-5baa-81c6-321e0dc723e2" :question/math-academy-id "e-2577" :question/problem "In the figure below, determine $m\\angle{POR}$.\n\n![](images/0b/0bb38727216cc66882b7ed55fa59c3c700243ad18eb035a3e19a73eeffa81a2a.png)" :question/worked-solution "![](images/70/70bb672243a7689bd08c2d03ebe19570fdb148182dd7b5137da5be4b91724f03.png)\n\nFirst, notice that $\\angle{POQ}$ and $\\angle{QOR}$ are adjacent because they share the same side $\\overrightarrow{OQ}$.\n\nWe can add the measures of two adjacent angles to find the measure of the combined angle.\n\nTherefore:\n\n$$\n\\begin{aligned}\nm∠POR &= m∠POQ + m∠QOR \\\\\n&= 68^{∘} + 37^{∘} \\\\\n&= 105^{∘}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186110382 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110750 :knowledge-point/id #uuid "c59421f9-a1af-59d9-aa89-16cd2d13d332" :knowledge-point/title "Finding the Measure of an Unknown Angle Using the Extended Rule"}] :question/id #uuid "4ad9432d-82fc-58e6-b586-f16474fa18f3" :question/math-academy-id "e-2578" :question/problem "In the figure below, $m \\angle BAE = {110}^{\\circ}$. Find the value of $x$.\n\n![](images/24/245dbaa430eb99aee193110fcd6df2844cfd7cffd2363c561337ac74d18a1fb5.png)" :question/worked-solution "Here, the letter $x$ represents the measure of the unknown angle $\\angle CAD$.\n\nThe measure of $\\angle CAD$ must be the *difference* between the large angle $(\\angle BAE)$ and the two smaller known angles $(\\angle BAC$ and $\\angle DAE)$.\n\nTherefore,\n\n$$\nx = 110^\\circ - 40^\\circ - 20^\\circ = 50^\\circ\n$$"}] [{:db/id #edb/ref 17592186110927 :knowledge-point/_questions [{:db/id #edb/ref 17592186110671 :knowledge-point/id #uuid "3e8c4c24-2d04-5fd1-a9f4-6f1abb25c255" :knowledge-point/title "Finding the Measure of a Smaller Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3e66530-255b-5a56-a1ea-9a7bcb49ccc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = 40^{∘} + 90^{∘}" :db/id #edb/ref 17592186107454} {:answer/id #uuid "b868f78b-855c-5ffb-994b-c0d9769850d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = 40^{∘} - 90^{∘}" :db/id #edb/ref 17592186107455} {:answer/id #uuid "db154de1-1b6f-5e70-8123-193564f371cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = 90^{∘} + 40^{∘}" :db/id #edb/ref 17592186107456} {:answer/id #uuid "e8391b29-033c-53ab-a4e5-07a8d2d4784d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = 90^{∘} - 40^{∘}" :db/id #edb/ref 17592186107457} {:answer/id #uuid "589ad2e6-a7dc-52f2-80b6-ba480b287486" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = 40^{∘} \\cdot 90^{∘}" :db/id #edb/ref 17592186107458}] :answer-field/id #uuid "ef70b5dc-8003-5cad-8bc8-e75e2766fb95" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186107453}] :question/id #uuid "8df2efb5-d399-5afd-8217-2b502698df60" :question/math-academy-id "q-150699" :question/problem "![](images/b8/b884ae8109d723e9277daa7b076d8a4ff52c07c8295e83d360a07bbb7785dd1d.png)\n\nIn the diagram above, $m∠BAD = 90^{∘}$. What equation could be used to find the value of $x$?"}] [{:db/id #edb/ref 17592186110954 :knowledge-point/_questions [{:db/id #edb/ref 17592186110748 :knowledge-point/id #uuid "782a6a0a-7a15-5230-8f9d-5405aa72f96a" :knowledge-point/title "Finding the Measure of a Combined Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a16f2b0-a36e-5e31-9518-9bc59ce89182" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100^{∘}" :db/id #edb/ref 17592186107558} {:answer/id #uuid "a77e227a-9382-5553-8709-9638074b8403" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "105^{∘}" :db/id #edb/ref 17592186107559} {:answer/id #uuid "aa92f2c9-6975-5eb0-a19e-e13101666de0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "114^{∘}" :db/id #edb/ref 17592186107560} {:answer/id #uuid "23132bc7-2efb-5b15-9611-4357bd3db0ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "110^{∘}" :db/id #edb/ref 17592186107561} {:answer/id #uuid "56864b2d-72c0-58b6-88ab-620fb833f0a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "102^{∘}" :db/id #edb/ref 17592186107562}] :answer-field/id #uuid "98bae0c0-0e36-5a