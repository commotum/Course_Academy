#{[{:db/id #edb/ref 17592186179458 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179812 :knowledge-point/id #uuid "44b96053-1ffa-56d3-8129-15ada765b9a7" :knowledge-point/title "Subtracting Positive Decimals From Decimals With Halves"}] :question/id #uuid "0e9e4dd1-3161-5d3c-afab-5514e1c2d0d4" :question/math-academy-id "e-13383" :question/problem "What is $-2.5 - 4.5?$" :question/worked-solution "To subtract $4.5$ from $-2.5,$ we break up $4.5$ into its whole number part ($4$) and its decimal part ($0.5$) and proceed in two steps.\n\n- First, we subtract the whole number part. We start at $-2.5$ on the number line and move $4$ places to the left, which brings us to $-6.5.$\n\n- Then, we subtract the decimal part. We move the remaining $0.5$ places to the left, leaving us at $-7.$\n\n![](images/53/53e5b15019c3189519b0fb4801e2ead2d9cd954d7da84640bb684215e53aca7a.png)\n\nThis gives $-2.5 - 4.5 = -7.0.$"}] [{:db/id #edb/ref 17592186179459 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179813 :knowledge-point/id #uuid "507d4d46-699c-5b4f-a010-66aec6abef67" :knowledge-point/title "Subtracting Positive Decimals From Decimals"}] :question/id #uuid "6bd42661-9814-51ce-a359-39bd54aff3e7" :question/math-academy-id "e-13384" :question/problem "What is the value of $4.6-7.7?$" :question/worked-solution "Since $7.7$ is larger than $4.6,$ the answer will be negative.\n\nWe start by solving an easier problem, which is to carry out the subtraction in the reverse order:\n\n$$\n7.7 - 4.6 = 3.1\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n4.6-7.7 = -3.1\n$$"}] [{:db/id #edb/ref 17592186179460 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179814 :knowledge-point/id #uuid "778ae1c8-c651-56f1-ab58-1817d3fe4bb9" :knowledge-point/title "Subtracting Positive Decimals From Decimals With Unequal Numbers of Decimals"}] :question/id #uuid "45b45968-91b2-5ed4-86c2-51d31e02b714" :question/math-academy-id "e-13385" :question/problem "What is the value of $-1.25-3.3?$" :question/worked-solution "Since $3.3$ is larger than $1.25,$ the answer will be negative.\n\nWe start by solving an easier problem, which is to add their absolute values:\n\n$$\n1.25+3.3 = 4.55\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n-1.25-3.3 = -4.55\n$$"}] [{:db/id #edb/ref 17592186444444 :knowledge-point/_questions [{:db/id #edb/ref 17592186179813 :knowledge-point/id #uuid "507d4d46-699c-5b4f-a010-66aec6abef67" :knowledge-point/title "Subtracting Positive Decimals From Decimals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "217a6a38-78f9-525d-8949-ce1d414087af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5.5" :db/id #edb/ref 17592186444380} {:answer/id #uuid "42adc968-9c82-53d2-87c8-fa61224f615b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6.2" :db/id #edb/ref 17592186444385} {:answer/id #uuid "71add816-b752-51a0-ae13-08846de3e557" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5.8" :db/id #edb/ref 17592186444398} {:answer/id #uuid "7821fd4f-a0bf-5473-80ec-004a7c48609c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4.9" :db/id #edb/ref 17592186444399} {:answer/id #uuid "7dd32b55-fa50-5f01-ab3f-d4e34d003d9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5.1" :db/id #edb/ref 17592186444401}] :answer-field/correct {:answer/id #uuid "71add816-b752-51a0-ae13-08846de3e557" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5.8" :db/id #edb/ref 17592186444398} :answer-field/id #uuid "76910b26-8a95-5a63-b466-7d837bfc920a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186444426}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "69cc1cb5-56cb-5b6d-8755-10b31e399d86" :question/math-academy-id "q-119503" :question/problem "$-2.1-3.7=$" :question/worked-solution "The answer will be negative since $-2.1$ is negative, and we're subtracting $3.7$ from it.\n\nWe start by solving an easier problem, which is to add their absolute values:\n\n$$\n2.1+3.7=5.8\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n-2.1-3.7=-5.8\n$$"}] [{:db/id #edb/ref 17592186444448 :knowledge-point/_questions [{:db/id #edb/ref 17592186179813 :knowledge-point/id #uuid "507d4d46-699c-5b4f-a010-66aec6abef67" :knowledge-point/title "Subtracting Positive Decimals From Decimals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13da375e-a338-5a2a-ad02-7d1c7dac4fc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5.4" :db/id #edb/ref 17592186444378} {:answer/id #uuid "4ac0f214-cbb8-50f3-a5f1-80e475b5a581" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6.1" :db/id #edb/ref 17592186444389} {:answer/id #uuid "929e2ce9-6a71-59c3-9bae-b470f6cc9c10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6.3" :db/id #edb/ref 17592186444405} {:answer/id #uuid "a9f9747e-91c1-5de1-8930-801ad7f115d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186444409} {:answer/id #uuid "d9a99cb1-e765-59df-ac99-ec8ba588cb27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5.7" :db/id #edb/ref 17592186444413}] :answer-field/correct {:answer/id #uuid "d9a99cb1-e765-59df-ac99-ec8ba588cb27" :answer/type {:db/id #edb/ref 17592186045498