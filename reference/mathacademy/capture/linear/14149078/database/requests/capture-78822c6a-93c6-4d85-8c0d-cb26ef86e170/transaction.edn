0-801ad7f115d0" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-4ac0f214-cbb8-50f3-a5f1-80e475b5a581" :answer/id #uuid "4ac0f214-cbb8-50f3-a5f1-80e475b5a581" :answer/type :answer.type/math :answer/value "-6.1" :db/ensure [:answer/validate]} {:db/id "answer-929e2ce9-6a71-59c3-9bae-b470f6cc9c10" :answer/id #uuid "929e2ce9-6a71-59c3-9bae-b470f6cc9c10" :answer/type :answer.type/math :answer/value "-6.3" :db/ensure [:answer/validate]} {:db/id "question-878f1e7f-afb5-5706-a035-9ec1ffd67f97" :question/id #uuid "878f1e7f-afb5-5706-a035-9ec1ffd67f97" :question/math-academy-id "q-186106" :question/problem "$-4.4-4.2=${{field-1}}" :question/worked-solution "The answer will be negative since $-4.4$ is negative, and we're subtracting $4.2$ from it.\n\nWe start by solving an easier problem, which is to add their absolute values:\n\n$$\n4.4+4.2=8.6\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n-4.4-4.2=-8.6.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-38e17c17-8426-5adb-8ce0-036d06f3c275"] :db/ensure [:question/validate]} {:db/id "answer-field-38e17c17-8426-5adb-8ce0-036d06f3c275" :answer-field/id #uuid "38e17c17-8426-5adb-8ce0-036d06f3c275" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-707a87b1-68b1-588d-b973-f69618098629" :answer-field/choices ["answer-707a87b1-68b1-588d-b973-f69618098629"] :db/ensure [:answer-field/validate]} {:db/id "answer-707a87b1-68b1-588d-b973-f69618098629" :answer/id #uuid "707a87b1-68b1-588d-b973-f69618098629" :answer/type :answer.type/math :answer/value "-8.6" :db/ensure [:answer/validate]} {:db/id "question-69cc1cb5-56cb-5b6d-8755-10b31e399d86" :question/id #uuid "69cc1cb5-56cb-5b6d-8755-10b31e399d86" :question/math-academy-id "q-119503" :question/problem "$-2.1-3.7=$" :question/worked-solution "The answer will be negative since $-2.1$ is negative, and we're subtracting $3.7$ from it.\n\nWe start by solving an easier problem, which is to add their absolute values:\n\n$$\n2.1+3.7=5.8\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n-2.1-3.7=-5.8\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-76910b26-8a95-5a63-b466-7d837bfc920a"] :db/ensure [:question/validate]} {:db/id "answer-field-76910b26-8a95-5a63-b466-7d837bfc920a" :answer-field/id #uuid "76910b26-8a95-5a63-b466-7d837bfc920a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-71add816-b752-51a0-ae13-08846de3e557" :answer-field/choices ["answer-7821fd4f-a0bf-5473-80ec-004a7c48609c" "answer-7dd32b55-fa50-5f01-ab3f-d4e34d003d9f" "answer-217a6a38-78f9-525d-8949-ce1d414087af" "answer-71add816-b752-51a0-ae13-08846de3e557" "answer-42adc968-9c82-53d2-87c8-fa61224f615b"] :db/ensure [:answer-field/validate]} {:db/id "answer-7821fd4f-a0bf-5473-80ec-004a7c48609c" :answer/id #uuid "7821fd4f-a0bf-5473-80ec-004a7c48609c" :answer/type :answer.type/math :answer/value "-4.9" :db/ensure [:answer/validate]} {:db/id "answer-7dd32b55-fa50-5f01-ab3f-d4e34d003d9f" :answer/id #uuid "7dd32b55-fa50-5f01-ab3f-d4e34d003d9f" :answer/type :answer.type/math :answer/value "-5.1" :db/ensure [:answer/validate]} {:db/id "answer-217a6a38-78f9-525d-8949-ce1d414087af" :answer/id #uuid "217a6a38-78f9-525d-8949-ce1d414087af" :answer/type :answer.type/math :answer/value "-5.5" :db/ensure [:answer/validate]} {:db/id "answer-71add816-b752-51a0-ae13-08846de3e557" :answer/id #uuid "71add816-b752-51a0-ae13-08846de3e557" :answer/type :answer.type/math :answer/value "-5.8" :db/ensure [:answer/validate]} {:db/id "answer-42adc968-9c82-53d2-87c8-fa61224f615b" :answer/id #uuid "42adc968-9c82-53d2-87c8-fa61224f615b" :answer/type :answer.type/math :answer/value "-6.2" :db/ensure [:answer/validate]} {:db/id "question-5dee817e-9057-5c1e-b780-3a4e2fb1b445" :question/id #uuid "5dee817e-9057-5c1e-b780-3a4e2fb1b445" :question/math-academy-id "q-186111" :question/problem "$1.1-1.8=${{field-1}}" :question/worked-solution "Since $1.8$ is larger than $1.1,$ the answer will be negative.\n\nWe start by solving an easier problem, which is to carry out the subtraction in the reverse order:\n\n$$\n1.8-1.1=0.7\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n1.1-1.8=-0.7.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e76cd9ec-5758-5788-8714-62601bda6996"] :db/ensure [:question/validate]} {:db/id "answer-field-e76cd9ec-5758-5788-8714-62601bda6996" :answer-field/id #uuid "e76cd9ec-5758-5788-8714-62601bda6996" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-42adda89-a5ff-5da4-98c0-dd6417d9224f" :answer-field/choices ["answer-42adda89-a5ff-5da4-98c0-dd6417d9224f"] :db/ensure [:answer-field/validate]} {:db/id "answer-42adda89-a5ff-5da4-98c0-dd6417d9224f" :answer/id #uuid "42adda89-a5ff-5da4-98c0-dd6417d9224f" :answer/type :answer.type/math :answer/value "-0.7" :db/ensure [:answer/validate]} {:db/id "question-750b10c3-54f6-5269-a368-26aaa93477ab" :question/id #uuid "750b10c3-54f6-5269-a368-26aaa93477ab" :question/math-academy-id "q-128120" :question/problem "$2.7-6.9=$" :question/worked-solution "Since $6.9$ is larger than $2.7,$ the answer will be negative.\n\nWe start by solving an easier problem, which is to carry out the subtraction in the reverse order:\n\n$$\n6.9-2.7=4.2\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n2.7-6.9=-4.2\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c47ee6a7-826c-579a-8039-267ae6d793a2"] :db/ensure [:question/valida