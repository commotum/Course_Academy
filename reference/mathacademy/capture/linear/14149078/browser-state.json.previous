    "q-42708": {
      "dom_id": "step-q42708",
      "name": "Question 4",
      "problem": "$-1.5-4.5=$",
      "worked_solution": "To subtract $4.5$ from $-1.5,$ we break up $4.5$ into its whole number part ($4$) and its decimal part ($0.5$) and proceed in two steps.\n\n- We start at $-1.5$ on the number line and move $4$ places to the left, which brings us to $-5.5.$\n\n- Then, we move the remaining $0.5$ places to the left, leaving us at $-6.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14149078/assets/1c119ac6d1c3681ab4a1863eb4ed4bf186ff8948bb038625d28d9d2d0a616dbf.png)\n\nWe get $-1.5-4.5=-6.$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
