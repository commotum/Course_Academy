f8-6d13138cf85c" #edb/ref 17592186045417] [17592186055613 #edb/ref 1063 #edb/ref 17592186054660 #edb/ref 17592186045417] [17592186055787 #edb/ref 1058 #edb/ref 17592186055788 #edb/ref 17592186045417] [17592186055787 #edb/ref 1061 521385 #edb/ref 17592186045417] [17592186055787 #edb/ref 1062 #uuid "7baea5d5-f521-54dc-aa2f-ff6e04e9e58c" #edb/ref 17592186045417] [17592186055787 #edb/ref 1063 #edb/ref 17592186056067 #edb/ref 17592186045417] [17592186055788 #edb/ref 1058 #edb/ref 17592186055789 #edb/ref 17592186045417] [17592186055788 #edb/ref 1061 521386 #edb/ref 17592186045417] [17592186055788 #edb/ref 1062 #uuid "46ff7c1c-0ad5-5a99-a07f-4743ea906700" #edb/ref 17592186045417] [17592186055788 #edb/ref 1063 #edb/ref 17592186054773 #edb/ref 17592186045417] [17592186055789 #edb/ref 1058 #edb/ref 17592186055790 #edb/ref 17592186045417] [17592186055789 #edb/ref 1061 521390 #edb/ref 17592186045417] [17592186055789 #edb/ref 1062 #uuid "d2d2808c-5375-5c39-8d76-ed44abc7a434" #edb/ref 17592186045417] [17592186055789 #edb/ref 1063 #edb/ref 17592186054774 #edb/ref 17592186045417] [17592186055790 #edb/ref 1058 #edb/ref 17592186055791 #edb/ref 17592186045417] [17592186055790 #edb/ref 1061 521394 #edb/ref 17592186045417] [17592186055790 #edb/ref 1062 #uuid "a0375f2a-c27c-50dc-b2aa-7d86343e6e08" #edb/ref 17592186045417] [17592186055790 #edb/ref 1063 #edb/ref 17592186056068 #edb/ref 17592186045417] [17592186055791 #edb/ref 1058 #edb/ref 17592186055792 #edb/ref 17592186045417] [17592186055791 #edb/ref 1061 521395 #edb/ref 17592186045417] [17592186055791 #edb/ref 1062 #uuid "015841f6-ea30-5123-b4ff-814780c357f9" #edb/ref 17592186045417] [17592186055791 #edb/ref 1063 #edb/ref 17592186054775 #edb/ref 17592186045417] [17592186055792 #edb/ref 1061 521399 #edb/ref 17592186045417] [17592186055792 #edb/ref 1062 #uuid "7c7ca7d9-ecb0-5c71-a008-51cd9a46b417" #edb/ref 17592186045417] [17592186055792 #edb/ref 1063 #edb/ref 17592186054776 #edb/ref 17592186045417] [17592186056067 #edb/ref 1064 "Suppose that we have the two polynomials $6x^2 + x +1$ and $2x^2 - 3x + 6$, and we want to add them. To do that, we put a plus sign between the two, collect like terms, and then simplify:\n\n$$\n\\begin{aligned}\n(6x^{2} + x + 1) + (2x^{2} - 3x + 6) &=  \\\\\n6x^{2} + x + 1 + 2x^{2} - 3x + 6 &=  \\\\\n6x^{2} + 2x^{2}_(⏟)_(x^{2}terms) + x - 3x^(⏞)^(xterms) + 1 + 6_(⏟)_(constants) &=  \\\\\n(6 + 2)x^{2} + (1 - 3)x + 7 &=  \\\\\n&= 8x^{2} - 2x + 7\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186056067 #edb/ref 1065 8873 #edb/ref 17592186045417] [17592186056067 #edb/ref 1066 #uuid "f6745611-70da-526a-9a6c-143b072c13c2" #edb/ref 17592186045417] [17592186056067 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186056068 #edb/ref 1064 "Suppose that we want to *subtract* the polynomial $2x^2 + x$ from the polynomial $6x^2 - 3x +1$. To do that, we start by putting a minus sign between the two:\n\n$$\n(6x^2 - 3x +1) - (2x^2 + x)\n$$\n\nHere, we need to remember to distribute the minus sign. Once we've done that, we can collect like terms and then simplify as usual:\n\n$$\n\\begin{aligned}\n(6x^{2} - 3x + 1) - (2x^{2} + x) &=  \\\\\n6x^{2} - 3x + 1 - 2x^{2} - x &=  \\\\\n6x^{2} - 2x^{2} - 3x - x + 1 &=  \\\\\n(6 - 2)x^{2} + (-3 - 1)x + 1 &=  \\\\\n&= 4x^{2} - 4x + 1\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186056068 #edb/ref 1065 8875 #edb/ref 17592186045417] [17592186056068 #edb/ref 1066 #uuid "90da9a1a-3727-51e9-ad38-7db8b7ed3e20" #edb/ref 17592186045417] [17592186056068 #edb/ref 1067 "The Difference of Two Polynomials" #edb/ref 17592186045417] [17592186056069 #edb/ref 1064 "Let's think about how to factor the following trinomial:\n\n$$\nx^2 + 7x + 12\n$$\n\nThis trinomial is neither a perfect square nor a difference of squares. In such cases, the factoring process requires a little trial and error.\n\nWe can factor this trinomial in four steps:\n\n- **Step 1:** Find the factor pairs of the constant term $(12)$:The factor pairs of $12$ are\n$(1, 12), (2, 6), (3, 4)$.\n- **Step 2:** Determine which of these factor pairs add up to the coefficient of the linear term $(7)$:\n$\\begin{bmatrix}1 + 12|= 13 & \\cdot \\\\ 2 + 6|= 8 & \\cdot \\\\ 3 + 4|= 7 & ✓\\end{bmatrix}$\n- **Step 3:** Using the factor pair identified in the previous step, write the linear term as $7x=3x+4x$:\n$x^{2} + 7x + 12|=; x^{2} + 3x + 4x_(⏟)_(7x) + 12$\n- **Step 4:** Factor the first two terms and the last two terms separately and then factor the expression completely:\n$x^{2} + 3x + 4x + 12|=; (x^{2} + 3x) + (4x + 12)|=; x(x + 3) + 4(x + 3)|=; (x + 4)(x + 3)$\n\nAnd we're done!\n\nBefore we continue, note the following:\n\n- The process carried out in step 4 is sometimes called **factoring by grouping.** This is because we group two sets of terms and factor them individually before factoring the entire expression.\n- We can check that our answer is correct by multiplying out the factors:\n$(x + 4)(x + 3)|= x(x + 3) + 4(x + 3); = x^{2} + 3x + 4x + 12; = x^{2} + 7x + 12✓$" #edb/ref 17592186045417] [17592186056069 #edb/ref 1065 8891 #edb/ref 17592186045417] [17592186056069 #edb/ref 1066 #uuid "90a8aa34-4549-57c2-bdc2-24cc962cd306" #edb/ref 17592186045417] [17592186056069 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186056070 #edb/ref 1064 "Let's now consider the following trinomial:\n\n$$\nx^2 - 2x - 8\n$$\n\nNotice that the constant term $(-8)$ is *negative*. So, when writing down our factor pairs, one number will always be positive, and the other will always be negative.\n\nSo, first, we write down all factor pairs of $-8{:}$\n\n$$\n(1,-8), (-1, 8), (2,-4), (-2, 4)\n$$\n\nNow, we find which factor pair adds up to the coefficient of the linear term $(-2)$:\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}1 + (-8) &= -7 & \\cdot \\\\ (-1) + 8|= 7 & \\cdot \\\\ 2 + (-4)|=-2 & ✓ \\\\ (-2) + 4|= 2 & \\cdot\\end{bmatrix}\n\\end{aligned}\n$$\n\nUsing the factor pair identified above, write the linear term as\n\n$$\n-2x = 2x-4x\n$$\n\n$$\n\\begin{aligned}\nx^{2} - 2x - 8 &=  \\\\\n&= x^{2} + 2x - 4x - 8\n\\end{aligned}\n$$\n\nFinally, we factor the first two terms and the last two terms separately, and then factor the expression completely:\n\n$$\n\\begin{aligned}\nx^{2} + 2x - 4x - 8 &=  \\\\\n(x^{2} + 2x) + (-4x - 8) &=  \\\\\nx(x + 2) - 4(x + 2) &=  \\\\\n&= (x - 4)(x + 2)\n\\end{aligned}\n$$\n\nLet's see another example." #edb/ref 17592186045417] [17592186056070 #edb/ref 1065 8894 #edb/ref 17592186045417] [17592186056070 #edb/ref 1066 #uuid "3b5a5752-232b-5714-b74a-1e50c4210b83" #edb/ref 17592186045417] [17592186056070 #edb/ref 1067 "Trinomials With Negative Constants" #edb/ref 17592186045417] [17592186056076 #edb/ref 1064 "Remember that to factor a quadratic expression, we must find a factor pair of the constant term that adds to the coefficient of the linear term.\n\nWith that in mind, let's factor the following trinomial:\n\n$$\nx^2 - 7x+12\n$$\n\nNotice that,\n\n- the constant term $(12)$ is *positive*, while\n- the coefficient of the linear term $(-7)$ is *negative*.\n\nSince the constant is *positive* and the coefficient of the linear term is *negative*, we must first consider the *negative* factor pairs of the constant term $(12)$. These are as follows:\n\n$$\n(-1,-12),\\qquad (-2,-6),\\qquad (-3,-4)\n$$\n\nFor each pair, their *product* is positive, and their *sum* is negative, which is what we want.\n\nNow, we find which factor pair adds up to the coefficient of the linear term $(-7)$:\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}(-1) + (-12) &= -13 & \\cdot \\\\ (-2) + (-6)|=-8 & \\cdot \\\\ (-3) + (-4)|=-7 & ✓\\end{bmatrix}\n\\end{aligned}\n$$\n\nUsing the factor pair identified in the previous step, write the linear term as\n\n$$\n-7x = -3x - 4x\n$$\n\n$$\n\\begin{aligned}\nx^{2} - 7x + 12 &=  \\\\\n&= x^{2} - 3x - 4x + 12\n\\end{aligned}\n$$\n\nNext, we factor the first two terms and the last two terms separately:\n\n$$\n\\begin{aligned}\nx^{2} - 3x - 4x + 12 &=  \\\\\n(x^{2} - 3x) + (-4x + 12) &=  \\\\\n&= x(x - 3) + 4(-x + 3)\n\\end{aligned}\n$$\n\nNow, to get a *common* factor in both terms, we take an additional factor of $-1$ from the second term:\n\n$$\nx(x - 3) - 4(x - 3)\n$$\n\nNow that we have a common factor of $(x-3)$, we factor the expression fully in the usual way:\n\n$$\n\\begin{aligned}\nx(x - 3) - 4(x - 3) &=  \\\\\n&= (x - 3)(x - 4)\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186056076 #edb/ref 1065 9504 #edb/ref 17592186045417] [17592186056076 #edb/ref 1066 #uuid "25f481d5-38d8-5f35-95fc-dd74f97d0394" #edb/ref 17592186045417] [17592186056076 #edb/ref 1067 "Trinomials With Negative Linear Coefficients and Positive Constants" #edb/ref 17592186045417] [17592186064322 #edb/ref 1038 #edb/ref 17592186064684 #edb/ref 17592186045417] [17592186064322 #edb/ref 1038 #edb/ref 17592186064720 #edb/ref 17592186045417] [17592186064322 #edb/ref 1039 "Factoring a Monomial out of a Binomial Containing Two Variables" #edb/ref 17592186045417] [17592186064322 #edb/ref 1041 #edb/ref 17592186063953 #edb/ref 17592186045417] [17592186064322 #edb/ref 1042 #uuid "12fed420-dbc6-57b4-8b3b-a13d441a51df" #edb/ref 17592186045417] [17592186064323 #edb/ref 1038 #edb/ref 17592186064675 #edb/ref 17592186045417] [17592186064323 #edb/ref 1038 #edb/ref 17592186064719 #edb/ref 17592186045417] [17592186064323 #edb/ref 1038 #edb/ref 17592186233562 #edb/ref 17592186045417] [17592186064323 #edb/ref 1038 #edb/ref 17592186233569 #edb/ref 17592186045417] [17592186064323 #edb/ref 1038 #edb/ref 17592186233576 #edb/ref 17592186045417] [17592186064323 #edb/ref 1039 "Factoring a Monomial From a Trinomial" #edb/ref 17592186045417] [17592186064323 #edb/ref 1041 #edb/ref 17592186063954 #edb/ref 17592186045417] [17592186064323 #edb/ref 1042 #uuid "6d1134c0-02ce-59c1-8238-4820da388f90" #edb/ref 17592186045417]}
