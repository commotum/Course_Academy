#{[{:activity/first-step {:db/id #edb/ref 17592186069704} :activity/id #uuid "5d42bb12-b3dd-51d8-b182-d11c5610f66c" :activity/scope {:db/id #edb/ref 17592186050361 :topic/id #uuid "42d6df97-82bc-5c46-b6ad-8dc1bac71005" :topic/math-academy-id 387} :activity/steps [{:db/id #edb/ref 17592186069701 :step/content {:db/id #edb/ref 17592186068782 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068624 :question/id #uuid "bd57c7f2-87b5-55a0-9237-1ef814f59898" :question/math-academy-id "e-6136"} :knowledge-point/id #uuid "a0e5b503-a393-58ef-bbcd-5c6d65257f53" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050127} {:db/id #edb/ref 17592186050519}] :knowledge-point/questions [{:db/id #edb/ref 17592186069463} {:db/id #edb/ref 17592186069466}] :knowledge-point/title "Identifying Values that Satisfy a Given Inequality"} :step/id #uuid "7a12041b-cf05-5ef7-861a-4a41e851ccce" :step/math-academy-id 22846 :step/next {:db/id #edb/ref 17592186069705}} {:db/id #edb/ref 17592186069702 :step/content {:db/id #edb/ref 17592186068783 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068625 :question/id #uuid "74587421-d1ad-550e-a30d-4d4768588d4f" :question/math-academy-id "e-6137"} :knowledge-point/id #uuid "09fdde75-121e-5378-bad1-1ab564375d41" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049051}] :knowledge-point/questions [{:db/id #edb/ref 17592186069470} {:db/id #edb/ref 17592186069471}] :knowledge-point/title "Identifying Values that Satisfy a Given Compound Inequality"} :step/id #uuid "6e5127b1-8f72-5af1-9af8-0a68620f1c8f" :step/math-academy-id 22847 :step/next {:db/id #edb/ref 17592186069703}} {:db/id #edb/ref 17592186069703 :step/content {:db/id #edb/ref 17592186068784 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068626 :question/id #uuid "fb564b00-2d04-556a-a662-7b92e21ec3d3" :question/math-academy-id "e-6138"} :knowledge-point/id #uuid "cd07be8d-2eba-5e4e-ba42-72470fd12120" :knowledge-point/questions [{:db/id #edb/ref 17592186069472} {:db/id #edb/ref 17592186069512}] :knowledge-point/title "Identifying Inequalities that are Satisfied by a Given Value"} :step/id #uuid "d2c8d513-b9f7-5e4d-b550-a588fb3a8ef1" :step/math-academy-id 22848} {:db/id #edb/ref 17592186069704 :step/content {:db/id #edb/ref 17592186069979 :tutorial/content "We can find which values satisfy an inequality by trial and error, which involves substituting a number for the variable and checking to see if we get a true statement.\n\nFor example, which of the following values of $y$ satisfy the inequality $y - 1 > 3\\,$?\n\n1. $y=6$\n2. $y=2$\n3. $y=3$\n\nLet's go through the possibilities one at a time.\n\n- Substituting the value ${\\color{blue}y}={\\color{blue}6}$ into the given equation, we get:\n$\\begin{bmatrix}y - 1 & > 3 \\\\ 6 - 1 & > 3 \\\\ 5 & > 3✓\\end{bmatrix}$\nThis is a **true** statement, so $y=6$ **satisfies** this inequality.\n- Substituting the value ${\\color{blue}y}={\\color{blue}2}$ into the given equation, we get:\n$\\begin{bmatrix}y - 1 & > 3 \\\\ 2 - 1 & > 3 \\\\ 1 & > 3\\cdot\\end{bmatrix}$\nThis is a **false** statement, so $y=2$ **does not satisfy** this inequality.\n- Substituting the value ${\\color{blue}y}={\\color{blue}3}$ into the given equation, we get:\n$\\begin{bmatrix}y - 1 & > 3 \\\\ 3 - 1 & > 3 \\\\ 2 & > 3\\cdot\\end{bmatrix}$\nThis is a **false** statement, so $y=3$ **does not satisfy** this inequality.\n\nTherefore, only I satisfies the inequality." :tutorial/id #uuid "c8259a9f-33bd-5c3f-9005-695f9474fbab" :tutorial/math-academy-id 3879 :tutorial/title "Introduction"} :step/id #uuid "d80f89b1-82f3-5c21-ae3e-13d7fbef2b51" :step/math-academy-id 22849 :step/next {:db/id #edb/ref 17592186069701}} {:db/id #edb/ref 17592186069705 :step/content {:db/id #edb/ref 17592186068785 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068627 :question/id #uuid "73bc0b43-f3a9-5a4b-a49f-833cdf1f493f" :question/math-academy-id "e-6139"} :knowledge-point/id #uuid "9c472f18-da99-5969-acdf-1a7b53465494" :knowledge-point/questions [{:db/id #edb/ref 17592186069462} {:db/id #edb/ref 17592186069465}] :knowledge-point/title "Identifying Values that Satisfy a Given Inequality with Fractions"} :step/id #uuid "a64fa200-0d99-5bad-916e-7cbe9afb1166" :step/math-academy-id 22850 :step/next {:db/id #edb/ref 17592186069702}}] :activity/title "Verifying Solutions of Linear Inequalities" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068934}]}
