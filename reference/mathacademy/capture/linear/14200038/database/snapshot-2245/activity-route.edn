#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186516962} :activity/id #uuid "e2fcbe2f-4ff6-58b3-8208-814e82a85124" :activity/scope {:db/id #edb/ref 17592186048135 :topic/id #uuid "8257a26c-85bf-580e-9d81-e2194473d981" :topic/math-academy-id 793} :activity/steps [{:db/id #edb/ref 17592186516883 :step/content {:db/id #edb/ref 17592186516821 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64e91312-ff58-54f3-b439-a8ba0e101cf9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{23}" :db/id #edb/ref 17592186516332} {:answer/id #uuid "a2568178-6c14-5310-b06c-f6da6cadd369" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "22" :db/id #edb/ref 17592186516446} {:answer/id #uuid "a89f9d8f-ba4e-55a2-9762-c20470143c7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{22}{23}" :db/id #edb/ref 17592186516463} {:answer/id #uuid "cb0bbe30-3e25-5367-88f5-88e0431bffb0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{22}" :db/id #edb/ref 17592186516541} {:answer/id #uuid "d990847b-1002-5b97-9e33-5b92b5b1594f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{23}{22}" :db/id #edb/ref 17592186516569}] :answer-field/correct {:db/id #edb/ref 17592186516463} :answer-field/id #uuid "8d3be114-0077-5092-b1f3-6cfed4a013eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516718}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8518694b-ea1e-5380-a35c-13f3072f6df4" :question/math-academy-id "q-84440" :question/problem "![](images/52/5245725446c23cc37e5ca4ad5b4def939c1544100eb3488092f59c4ed0f8beaa.png)\n\nConsider the sample space $S$ with the Venn diagram given above. What is $P(A)?$" :question/worked-solution "From the given Venn diagram, we have $P(A)=y$ and $P({A}^{′})=\\frac{y}{22}.$\nTherefore\n\n$$\n\\begin{aligned}P(A)+P({A}^{′}) & =1 \\\\ y+\\frac{y}{22} & =1 \\\\ \\frac{23y}{22} & =1 \\\\ y & =\\frac{22}{23}.\\end{aligned}\n$$\n\nConsequently,  $P(A)=y=\\frac{22}{23}.$"} :step/id #uuid "20e5a0d7-e4a4-5527-9522-5eac4387dd43"} {:db/id #edb/ref 17592186516885 :step/content {:db/id #edb/ref 17592186516818 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "618e6135-f56b-58e3-9328-1dabdd58e75e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.251" :db/id #edb/ref 17592186516325} {:answer/id #uuid "98e412be-1a3f-5243-b5d3-e6079198e12b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.201" :db/id #edb/ref 17592186516428} {:answer/id #uuid "bc95322b-4d62-5251-8e5a-af2d36102789" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.551" :db/id #edb/ref 17592186516508} {:answer/id #uuid "c03ce4f2-8551-5443-840b-a6936ad84d20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.250" :db/id #edb/ref 17592186516521} {:answer/id #uuid "d82264de-339c-5e57-9840-e930e1482ddb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.521" :db/id #edb/ref 17592186516567}] :answer-field/correct {:db/id #edb/ref 17592186516325} :answer-field/id #uuid "dee1b406-0379-5d58-ba7e-b9ef815df898" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516753}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7764a147-f3f7-5293-8ab2-21a4f6d2919a" :question/math-academy-id "q-84435" :question/problem "![](images/a3/a347f23ec8c99fda74de190515eb7aa2d071be29ca106b99116b3d050cb8a1fe.png)\n\nGiven the above sample space, find $P(X).$" :question/worked-solution "The Venn diagram tells us that $P({X}^{′})=0.749.$ So, we have\n\n$$\n\\begin{aligned}P(X) & =1-P({X}^{′}) \\\\  & =1-0.749 \\\\  & =0.251.\\end{aligned}\n$$"} :step/id #uuid "2c9093fe-c1c5-5ee0-9d9c-ed832e4df4f4" :step/next {:db/id #edb/ref 17592186516883}} {:db/id #edb/ref 17592186516962 :step/content {:db/id #edb/ref 17592186083486 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "845355a0-843b-51f7-8c0d-52009b5363fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186079812} {:answer/id #uuid "93f57bbd-68cb-5590-b469-f8dec98c1443" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186079813} {:answer/id #uuid "b495be06-7373-56b0-9303-363912083a38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186079814} {:answer/id #uuid "f552a0c7-fea4-5002-ae66-4c9943b9551b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186079815} {:answer/id #uuid "26fabe08-9668-5bfd-b855-ea3411ba9fc6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186079816}] :answer-field/correct {:db/id #edb/ref 17592186079812} :answer-field/id #uuid "f0ccf4c3-ab1b-50f2-bb00-0b00faa94fbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186079811}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "991f3941-ac00-506d-94c9-cb69a7d61849" :question/math-academy-id "q-11322" :question/problem "![](images/9c/9c092436e6f2f66cd2ade33818209f001d1481f962c086da09c284975af83795.png)\n\nGiven the above sample space, find $P({X}^{′}).$" :question/worked-solution "The Venn diagram tells us that $P(X)=\\frac{2}{5}.$ So, we have\n\n$$\n\\begin{aligned}P({X}^{′}) & =1-P(X) \\\\  & =1-\\frac{2}{5} \\\\  & =\\frac{3}{5}.\\end{aligned}\n$$"} :step/id #uuid "c6e45cc7-205e-57d1-80c2-e67d0fe17e04" :step/next {:db/id #edb/ref 17592186516885}}] :activity/title "Venn Diagrams in Probability" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186516110}]}
