 missing number is $8.$"}] [{:db/id #edb/ref 17592186434583 :knowledge-point/_questions [{:db/id #edb/ref 17592186073879 :knowledge-point/id #uuid "6e191386-9391-5e3c-9f2f-f17d55f9b6ca" :knowledge-point/title "Completing a Statement Describing a Ratio as a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0032f9bd-ebd4-5d63-81c8-f075778d994f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186434511} {:answer/id #uuid "74a7a2cd-7462-5027-9411-a8cb8f752101" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186434540} {:answer/id #uuid "d7d5748c-af75-5fe4-933c-1f5bbb120bc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186434553} {:answer/id #uuid "f6fea697-276f-52f4-8cf2-d0f069a86d85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186434562} {:answer/id #uuid "f985e341-bbda-56f2-a9fd-37984524e12a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186434563}] :answer-field/correct {:answer/id #uuid "f6fea697-276f-52f4-8cf2-d0f069a86d85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186434562} :answer-field/id #uuid "2b695b86-eba6-598a-b0f5-563082ce8443" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186434569}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a47458ac-762b-5c69-b95f-710fff05fa39" :question/math-academy-id "q-60292" :question/problem "What is missing in the following sentence?\n\nColin and Emma shared some candies in the ratio of $6:4$, so there are $\\boxed{}$ candies in Colin's share for each candy in Emma's share." :question/worked-solution "We can rewrite the ratio as a fraction, as follows:\n\n$$\n\\frac{6}{4}\n$$\n\nWe can simplify the fraction by dividing the numerator and denominator by $2$:\n\n$$\n\\frac{6}{4}=\\frac{6÷2}{4÷2}=\\frac{3}{2}\n$$\n\nThat means that there are $\\frac{3}{2}$ candies in Colin's share for each candy in Emma's share."}] [{:db/id #edb/ref 17592186434581 :knowledge-point/_questions [{:db/id #edb/ref 17592186073880 :knowledge-point/id #uuid "7435b531-e922-5db5-8140-463b7e66dd64" :knowledge-point/title "Completing a Statement by Interpreting a Fraction as a Ratio"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6dd9a5ec-7add-574d-addd-b5e192adc19a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$ and $5$" :db/id #edb/ref 17592186434537} {:answer/id #uuid "9324e15c-d1f2-5c8e-94ee-5703f5a32c8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$ and $5$" :db/id #edb/ref 17592186434544} {:answer/id #uuid "f3f55ce8-575f-5e18-b6ca-e8f20155e0aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$ and $10$" :db/id #edb/ref 17592186434560} {:answer/id #uuid "f4010111-de65-51dc-b54f-bd5d61994160" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ and $10$" :db/id #edb/ref 17592186434561} {:answer/id #uuid "fc9ff2c7-9413-5997-a8e2-1165bfb8fc2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$ and $10$" :db/id #edb/ref 17592186434564}] :answer-field/correct {:answer/id #uuid "f3f55ce8-575f-5e18-b6ca-e8f20155e0aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$ and $10$" :db/id #edb/ref 17592186434560} :answer-field/id #uuid "1f1cea88-37fb-58e4-89b9-544d7890a146" :answer-field/key "selection" :answer-