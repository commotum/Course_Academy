answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186434546}] :answer-field/correct {:answer/id #uuid "a57a7a8c-0dae-5210-8914-3add40bc5b74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186434546} :answer-field/id #uuid "cd3a2ca3-823c-5206-b939-d30cfa7894d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186434573}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2cf3ec40-81c7-5457-9357-3212d8b07109" :question/math-academy-id "q-92960" :question/problem "![](images/2a/2ae5ab474ad05d17554d4f938255df6b8d5c53c0aa19607bf251ab0b25d471e8.png)\n\nWhat ratio describes the number of rectangles to the total number of shapes?" :question/worked-solution "We count the number of rectangles. We see that there is $1$ rectangle.\n\n We count the total number of shapes. We see that there are $6$ shapes in total.\n\nSo the ratio of rectangles to the total number of shapes is $\\frac{1}{6}.$"}] [{:db/id #edb/ref 17592186434578 :knowledge-point/_questions [{:db/id #edb/ref 17592186073786 :knowledge-point/id #uuid "b6a21dbe-0674-5fa2-b3ee-e4069115c6be" :knowledge-point/title "Writing a Ratio as a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f911b00-6db1-51d3-bd0d-b1915c5e3081" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186434515} {:answer/id #uuid "3aa1b9c4-a4aa-5fbe-826a-0df2b9fe2330" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186434524} {:answer/id #uuid "680f4693-9585-52a2-9497-400aafb2210b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186434533} {:answer/id #uuid "b6445eca-ac3b-560c-b809-c901c5da86cf" :answer/type {:d