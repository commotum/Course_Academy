#{[{:db/id #edb/ref 17592186073558 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073879 :knowledge-point/id #uuid "6e191386-9391-5e3c-9f2f-f17d55f9b6ca" :knowledge-point/title "Completing a Statement Describing a Ratio as a Fraction"}] :question/id #uuid "44e1e2da-6e2f-50b1-b982-dd5d4b5a432c" :question/math-academy-id "e-2265" :question/problem "What is missing in the following sentence?\n\n> To make a fertilizer Esther mixed $2$ quarts of fertilizer concentrate and $3$ quarts of distilled water, so there are $0$ quarts of fertilizer concentrate for each quart of distilled water." :question/worked-solution "The ratio of the number of quarts of fertilizer concentrate to the number of quarts of distilled water is ${\\color{blue}{2}}:{\\color{red}{3}}$.\n\nWe can rewrite this ratio as a fraction, as follows:\n\n$$\n\\dfrac{{\\color{blue}{2}}}{{\\color{red}{3}}}\n$$\n\nThis means that there is\n\n$$\n\\dfrac{2}{3}\n$$\n\nquart of fertilizer concentrate for each quart of distilled water."}] [{:db/id #edb/ref 17592186073559 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073880 :knowledge-point/id #uuid "7435b531-e922-5db5-8140-463b7e66dd64" :knowledge-point/title "Completing a Statement by Interpreting a Fraction as a Ratio"}] :question/id #uuid "cd725418-654f-5cb2-a77a-9f6f9ed27825" :question/math-academy-id "e-2267" :question/problem "From left to right, what are the missing numbers in the following sentence?\n\n> A chef requires $\\dfrac{1}{7}$ grams of chilies for each gram of turmeric for his recipe. Therefore, the recipe has a ratio of $0$ grams of chilies to $0$ grams of turmeric." :question/worked-solution "Let's rewrite the fraction\n\n$$\n\\dfrac{1}{7}\n$$\n\nas a ratio:\n\n$$\n1:7\n$$\n\nTherefore, the recipe has a ratio of $1$ gram of chilies to $7$ grams of turmeric."}] [{:db/id #edb/ref 17592186073658 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073786 :knowledge-point/id #uuid "b6a21dbe-0674-5fa2-b3ee-e4069115c6be" :knowledge-point/title "Writing a Ratio as a Fraction"}] :question/id #uuid "b3b354ef-26fc-55dc-acdd-4b28c5f273ef" :question/math-academy-id "e-8139" :question/problem "What ratio describes the number of rhombuses to the number of triangles?\n\n![](images/49/49a799c1ec4b9e7caadd4af8714aa1133f33e7012b76083e9b241d05b0d2fee7.png)" :question/worked-solution "First, we count the number of rhombuses. We see that there are $2$ rhombuses.\n\nThen, we count the number of triangles. We see that there are $3$ triangles.\n\nSo the ratio of rhombuses to triangles is\n\n$$\n\\dfrac{2}{3}\n$$"}] [{:db/id #edb/ref 17592186074380 :knowledge-point/_questions [{:db/id #edb/ref 17592186073879 :knowledge-point/id #uuid "6e191386-9391-5e3c-9f2f-f17d55f9b6ca" :knowledge-point/title "Completing a Statement Describing a Ratio as a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c02d13b4-a76c-5985-8725-30f4c1a08dd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{7}" :db/id #edb/ref 17592186072519} {:answer/id #uuid "cbf6f959-6cd2-5370-b1f4-e39c542146eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186072520} {:answer/id #uuid "d8ff87f5-54d3-5b39-8757-72b5a3926b21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186072521} {:answer/id #uuid "f57fd97d-606b-5201-bf0f-24b9a69e0394" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186072522} {:answer/id #uuid "30cc8338-e44e-5943-8393-bf8b4500beaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186072523}] :answer-field/id #uuid "55c17b28-298e-5e3f-bb30-936bb2b165b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-fiel