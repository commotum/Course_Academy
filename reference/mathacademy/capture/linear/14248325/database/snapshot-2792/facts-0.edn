\n\\begin{aligned}\\frac{12a{b}^{3}}{15c}÷\\frac{24{a}^{3}{b}^{2}}{25{c}^{3}} & = \\\\ \\frac{12a{b}^{3}}{15c}\\cdot \\frac{25{c}^{3}}{24{a}^{3}{b}^{2}} & = \\\\ \\frac{12\\cdot a{b}^{2}\\cdot b}{3\\cdot 5c}\\cdot \\frac{5\\cdot 5c\\cdot {c}^{2}}{12\\cdot 2{a}^{2}\\cdot a{b}^{2}} & = \\\\ \\frac{\\cancel{12}\\cdot \\cancel{a{b}^{2}}\\cdot b}{3\\cdot \\cancel{5c}}\\cdot \\frac{5\\cdot \\cancel{5c}\\cdot {c}^{2}}{\\cancel{12}\\cdot 2{a}^{2}\\cdot \\cancel{a{b}^{2}}} & = \\\\ \\frac{b}{3}\\cdot \\frac{5{c}^{2}}{2{a}^{2}} & = \\\\ \\frac{5b{c}^{2}}{6{a}^{2}}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186295613 #edb/ref 1080 "\\frac{11(k+2)}{{y}^{2}}" #edb/ref 17592186045417] [17592186295613 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186295613 #edb/ref 1083 #uuid "3c4f1d16-78b3-5045-8bb5-5579fec4543a" #edb/ref 17592186045417] [17592186295709 #edb/ref 1080 "\\frac{11{y}^{2}}{k+4}" #edb/ref 17592186045417] [17592186295709 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186295709 #edb/ref 1083 #uuid "4d3602d9-f3c5-5344-8c7b-288df52749cd" #edb/ref 17592186045417] [17592186296058 #edb/ref 1080 "\\frac{k+4}{{y}^{2}}" #edb/ref 17592186045417] [17592186296058 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186296058 #edb/ref 1083 #uuid "93b20eed-4388-595a-84d8-977910934218" #edb/ref 17592186045417] [17592186296162 #edb/ref 1080 "\\frac{{y}^{2}}{44(k+2)}" #edb/ref 17592186045417] [17592186296162 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186296162 #edb/ref 1083 #uuid "aa7ed919-742c-5a4c-b988-a4265e3f6f06" #edb/ref 17592186045417] [17592186296502 #edb/ref 1080 "\\frac{22(k+2)}{{y}^{2}}" #edb/ref 17592186045417] [17592186296502 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186296502 #edb/ref 1083 #uuid "e8492be0-a6b9-5d09-afa1-2e0f3bbeb2cf" #edb/ref 17592186045417] [17592186296680 #edb/ref 1075 #edb/ref 17592186295613 #edb/ref 17592186045417] [17592186296680 #