5498} :answer/value "\\frac{{y}^{2}}{44(k+2)}" :db/id #edb/ref 17592186296162} {:answer/id #uuid "e8492be0-a6b9-5d09-afa1-2e0f3bbeb2cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{22(k+2)}{{y}^{2}}" :db/id #edb/ref 17592186296502}] :answer-field/correct {:db/id #edb/ref 17592186296502} :answer-field/id #uuid "17d9d487-4676-539c-9b1c-0c3a024bdb73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186296680}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "964f86e1-4f13-55f4-a1ab-8caf3da2db2d" :question/math-academy-id "q-29970" :question/problem "If $\\frac{2(k+2)}{121y}\\cdot Y=\\frac{4(k+2)^{2}}{11{y}^{3}},$ then what is $Y?$" :question/worked-solution "Since $\\frac{2(k+2)}{121y}\\cdot Y=\\frac{4(k+2)^{2}}{11{y}^{3}},$ we have\n\n$$\nY=\\frac{4(k+2)^{2}}{11{y}^{3}}÷\\frac{2(k+2)}{121y}.\n$$\n\nTo compute this quotient, we just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{4(k+2)^{2}}{11{y}^{3}}÷\\frac{2(k+2)}{121y} & = \\\\ \\frac{4(k+2)^{2}}{11{y}^{3}}\\cdot \\frac{121y}{2(k+2)} & = \\\\ \\frac{2\\cdot 2(k+2)\\cdot (k+2)}{11y\\cdot {y}^{2}}\\cdot \\frac{11\\cdot 11y}{2(k+2)} & = \\\\ \\frac{2\\cdot \\cancel{2(k+2)}\\cdot (k+2)}{\\cancel{11y}\\cdot {y}^{2}}\\cdot \\frac{11\\cdot \\cancel{11y}}{\\cancel{2(k+2)}} & = \\\\ \\frac{2(k+2)}{{y}^{2}}\\cdot 11 & = \\\\ \\frac{22(k+2)}{{y}^{2}}\\end{aligned}\n$$"} :step/id #uuid "32241be2-2b52-50a8-89b1-59f0ea43c4b9"} {:db/id #edb/ref 17592186566291 :step/content {:db/id #edb/ref 17592186233757 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d9d372c-4477-5559-a60e-525b79945d82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6{a}^{2}}{5b{c}^{2}}" :db/id #edb/ref 17592186565778} {:answer/id #uuid "a3d57647-a858-58be-b6c6-5a8426f661a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5b{c}^{2}}{6{a}^{2}}" :db/id #edb/ref 17592186565940} {:answer/id #uuid "b3162ef4-1d4d-5280-b14a-835a8f8afd09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{b{c}^{2}}{6{a}^{2}}" :db/id #edb/ref 17592186565963} {:answer/id #uuid "c14dcc77-87a2-509e-aefb-42b5a939a216" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{b{c}^{2}}{2{a}^{2}}" :db/id #edb/ref 17592186565987} {:answer/id #uuid "cd4945a6-b616-5950-9cff-ca98bb020943" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5{c}^{2}}{6{a}^{2}}" :db/id #edb/ref 17592186566011}] :answer-field/correct {:db/id #edb/ref 17592186565940} :answer-field/id #uuid "144673bd-7ce0-5009-80d2-846588e5d153" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566112}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3a8407af-a47a-5ef1-a65f-b4b72289472c" :question/math-academy-id "q-29966" :question/problem "If $\\frac{24{a}^{3}{b}^{2}}{25{c}^{3}}\\cdot X=\\frac{12a{b}^{3}}{15c},$ then what is $X?$" :question/worked-solution "Since $\\frac{24{a}^{3}{b}^{2}}{25{c}^{3}}\\cdot X=\\frac{12a{b}^{3}}{15c},$ we have\n\n$$\nX=\\frac{12a{b}^{3}}{15c}÷\\frac{24{a}^{3}{b}^{2}}{25{c}^{3}}.\n$$\n\nTo compute this quotient, we just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{12a{b}^{3}}{15c}÷\\frac{24{a}^{3}{b}^{2}}{25{c}^{3}} & = \\\\ \\frac{12a{b}^{3}}{15c}\\cdot \\frac{25{c}^{3}}{24{a}^{3}{b}^{2}} & = \\\\ \\frac{12\\cdot a{b}^{2}\\cdot b}{3\\cdot 5c}\\cdot \\frac{5\\cdot 5c\\cdot {c}^{2}}{12\\cdot 2{a}^{2}\\cdot a{b}^{2}} & = \\\\ \\frac{\\cancel{12}\\cdot \\cancel{a{b}^{2}}\\cdot b}{3\\cdot \\cancel{5c}}\\cdot \\frac{5\\cdot \\cancel{5c}\\cdot {c}^{2}}{\\cancel{12}\\cdot 2{a}^{2}\\cdot \\cancel{a{b}^{2}}} & = \\\\ \\frac{b}{3}\\cdot \\frac{5{c}^{2}}{2{a}^{2}} & = \\\\ \\frac{5b{c}^{2}}{6{a}^{2}}\\end{aligned}\n$$"} :step/id #uuid "550d753b-1769-55d3-8954-608c58b8b6eb" :step/next {:db/id #edb/ref 17592186566283}} {:db/id #edb/ref 17592186566313 :step/content {:db/id #edb/ref 17592186566246 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "895d9ffc-006a-5e14-8d3d-a031c859cb98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3v}{v+1}" :db/id #edb/ref 17592186565897} {:answer/id #uuid "8b898f83-508a-5c71-a91c-9734fa02e059" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3v+1}{3v}" :db/id #edb/ref 17592186565901} {:answer/id #uuid "c7b0a4d1-23a0-5efc-ad6b-fdcb29f179bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{v}{3v+1}" :db/id #edb/ref 17592186566000} {:answer/id #uuid "f0190a87-fbf5-57b6-9650-b6eac82f4005" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{v}{v+9}" :db/id #edb/ref 17592186566073} {:answer/id #uuid "f8c019a7-2cb9-5d61-898a-4e58c10a6b87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3v}{v+9}" :db/id #edb/ref 17592186566088}] :answer-field/correct {:db/id #edb/ref 17592186566088} :answer-field/id #uuid "88dbefa0-da08-5591-8494-05b870a9513b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566162}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7688caa9-079d-576d-afcf-e01cab97b9fe" :question/math-academy-id "q-14467" :question/problem "$\\frac{9{v}^{2}+3v}{v+9}÷(3v+1)=$" :question/worked-solution "To compute\n\n$$\n\\frac{9{v}^{2}+3v}{v+9}÷(3v+1),\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{9{v}^{2}+3v}{v+9}÷(3v+1) & = \\\\ \\frac{9{v}^{2}+3v}{v+9}\\cdot \\frac{1}{(3v+1)} & = \\\\ \\frac{3v(3v+1)}{v+9}\\cdot \\frac{1}{(3v+1)} & = \\\\ \\frac{3v\\cancel{(3v+1)}}{(v+9)}\\cdot \\frac{1}{\\cancel{(3v+1)}} & = \\\\ \\frac{3v}{v+9}\\end{aligned}\n$$"} :step/id #uuid "dc32b9d9-57dc-5bdc-81ef-ce7a8486ff9d" :step/next {:db/id #edb/ref 17592186566291}}] :activity/title "Dividing Rational Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186565673}]}
