close></mrow><mrow><mo stretchy=\"false\">(</mo><mi>v</mi><mo>+</mo><mn>9</mn><mo stretchy=\"false\">)</mo></mrow></mfrac></mstyle><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><menclose notation=\"updiagonalstrike\"><mo stretchy=\"false\">(</mo><mn>3</mn><mi>v</mi><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo></menclose></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>3</mn><mi>v</mi></mrow><mrow><mi>v</mi><mo>+</mo><mn>9</mn></mrow></mfrac></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
