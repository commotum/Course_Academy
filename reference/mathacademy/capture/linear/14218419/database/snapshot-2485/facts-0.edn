db/ref 17592186045417] [17592186529056 #edb/ref 1075 #edb/ref 17592186528787 #edb/ref 17592186045417] [17592186529056 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186529056 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186529056 #edb/ref 1078 #edb/ref 17592186528402 #edb/ref 17592186045417] [17592186529056 #edb/ref 1079 #uuid "d31978c6-bceb-5325-aea8-c4dcaee83acf" #edb/ref 17592186045417] [17592186529100 #edb/ref 1068 #edb/ref 17592186528961 #edb/ref 17592186045417] [17592186529100 #edb/ref 1069 "q-105994" #edb/ref 17592186045417] [17592186529100 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186529100 #edb/ref 1071 "What are the coordinates of the minimum point of the function $y=(x-2)^{2}?$" #edb/ref 17592186045417] [17592186529100 #edb/ref 1072 #uuid "1f5ba24c-6238-510f-bebb-ee4c2a2d372a" #edb/ref 17592186045417] [17592186529100 #edb/ref 1074 "In general, the graph of $y=(x-h)^{2}$ looks like the standard parabola $y={x}^{2}$ but translated $h$ units right. The vertex of $y=(x-h)^{2}$ is located at $(h,0).$\n\nFor the given function $y=(x-2)^{2},$ we have $h=2.$\n\nTherefore, the given curve is the parabola $y={x}^{2}$ after being translated $2$ units *right*. \n\n![](images/ae/aed4cce9a698952f9d24e386249c88023d4e56a353f2d7e0c6b75f3bec0cdf4d.png)\n\nThe vertex is located at $(2,0),$ and these are the coordinates of the minimum point." #edb/ref 17592186045417] [17592186529145 #edb/ref 1068 #edb/ref 17592186529056 #edb/ref 17592186045417] [17592186529145 #edb/ref 1069 "q-23089" #edb/ref 17592186045417] [17592186529145 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186529145 #edb/ref 1071 "Which of the following is the graph of the function $y=(x-2)^{2}+2?$" #edb/ref 17592186045417] [17592186529145 #edb/ref 1072 #uuid "82cee2a3-9424-531b-bce3-49f1ee87bedc" #edb/ref 17592186045417] [17592186529145 #edb/ref 1074 "Remember that the graph of $y=(x-h)^{2}+k$ is a translation of the standard parabola $y={x}^{2}$ by\n\n- $h$ units right, and\n\n- $k$ units up.\n\nThe vertex of $y=(x-h)^{2}+k$ is located at $(h,k).$\n\nHere, the parabola is translated $2$ units *right*, so we have $h=2.$ The parabola is also translated $2$ units *up*, so we have $k=2.$ \n\n![](images/4e/4e43c68bd7ab2da6fb0be21ecc69ab29e111c442219caaae70b819e9df3488be.png)\n\nThe vertex is located at $(2,2),$ and these are the coordinates of the minimum point." #edb/ref 17592186045417] [17592186529153 #edb/ref 1068 #edb/ref 17592186528974 #edb/ref 17592186045417] [17592186529153 #edb/ref 1069 "q-106003" #edb/ref 17592186045417] [17592186529153 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186529153 #edb/ref 1071 "What are the coordinates of the minimum point of the function $y=(x+2)^{2}+5?$" #edb/ref 17592186045417] [17592186529153 #edb/ref 1072 #uuid "9521123b-d716-51bb-900f-b70ee495c687" #edb/ref 17592186045417] [17592186529153 #edb/ref 1074 "Remember that the graph of $y=(x-h)^{2}+k$ is a translation of the standard parabola $y={x}^{2}$ by\n\n- $h$ units right, and\n\n- $k$ units up.\n\nThe vertex of $y=(x-h)^{2}+k$ is located at $(h,k).$\n\nHere, the parabola is translated $2$ units *left*, so we have $h=-2.$ The parabola is also translated $5$ units *up*, so we have $k=5.$ \n\n![](images/8e/8e69ca48e852176d2ed258f062995835889374975492873fe0863ea782d87ebd.png)\n\nThe vertex is located at $(-2,5),$ and these are the coordinates of the minimum point." #edb/ref 17592186045417] [17592186529188 #edb/ref 1068 #edb/ref 17592186529018 #edb/ref 17592186045417] [17592186529188 #edb/ref 1069 "q-23258" #edb/ref 17592186045417] [17592186529188 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186529188 #edb/ref 1071 "What are the coordinates of the minimum point of the function $y={x}^{2}+5?$" #edb/ref 17592186045417] [17592186529188 #edb/ref 1072 #uuid "ead518c9-914d-5e94-b01b-fb4224373ff4" #edb/ref 17592186045417] [17592186529188 #edb/ref 1074 "In general, the graph of $y={x}^{2}+k$ looks like the standard parabola $y={x}^{2}$ but translated $k$ units up. The vertex of $y={x}^{2}+k$ is located at $(0,k).$\n\nFor the given function $y={x}^{2}+5,$ we have $k=5.$\n\nTherefore, the given curve is the parabola $y={x}^{2}$ after being translated $5$ units *up*. \n\n![](images/a9/a975d014ad92c31850e41367a2b5e46e85ab18a8a7e63bee81cd0f9b6af02bc0.png)\n\nThe vertex is located at $(0,5),$ and these are the coordinates of the minimum point." #edb/ref 17592186045417] [17592186529189 #edb/ref 1068 #edb/ref 17592186528939 #edb/ref 17592186045417] [17592186529189 #edb/ref 1069 "q-105999" #edb/ref 17592186045417] [17592186529189 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186529189 #edb/ref 1071 "![](images/60/60d4ffad53a01f24e99b838e057b73f270cc41771db7f0718bcf731909182908.png)\n\nIdentify the equation that generated the graph above." #edb/ref 17592186045417] [17592186529189 #edb/ref 1072 #uuid "eae2df82-c842-5432-893d-0301f5c3e7e4" #edb/ref 17592186045417] [17592186529189 #edb/ref 1074 "In general, the graph of $y=(x-h)^{2}$ looks like the standard parabola $y={x}^{2}$ but translated $h$ units right. The vertex of $y=(x-h)^{2}$ is located at $(h,0).$\n\nHere, the curve shown is the parabola $y={x}^{2}$ after being translated $8$ units *right*. The vertex is located at $(8,0).$\n\nTherefore, $h=8,$ and the equation of the parabola is \n\n$$\n\\begin{aligned}y & =(x-8)^{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529190 #edb/ref 1068 #edb/ref 17592186528994 #edb/ref 17592186045417] [17592186529190 #edb/ref 1069 "q-23288" #edb/ref 17592186045417] [17592186529190 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186529190 #edb/ref 1071 "What are the coordinates of the minimum point of the function $y={x}^{2}+3?$" #edb/ref 17592186045417] [17592186529190 #edb/ref 1072 #uuid "ecfb5c66-7387-5472-a64e-2ed6bd44ab74" #edb/ref 17592186045417] [17592186529190 #edb/ref 1074 "In general, the graph of $y={x}^{2}+k$ looks like the standard parabola $y={x}^{2}$ but translated $k$ units up. The vertex of $y={x}^{2}+k$ is located at $(0,k).$\n\nFor the given function $y={x}^{2}+3,$ we have $k=3.$\n\nTherefore, the given curve is the parabola $y={x}^{2}$ after being translated $3$ units *up*. \n\n![](images/b6/b66bc0862b1a16cd71e846624903adea3f98a1b6d867a6516ec08cdee970518c.png)\n\nThe vertex is located at $(0,3),$ and these are the coordinates of the minimum point." #edb/ref 17592186045417]}
