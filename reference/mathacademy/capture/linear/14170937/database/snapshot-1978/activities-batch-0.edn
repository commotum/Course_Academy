#{[{:activity/first-step {:db/id #edb/ref 17592186069912} :activity/id #uuid "f525c0ff-8172-5646-b7ba-2dd13dd2cdf5" :activity/scope {:db/id #edb/ref 17592186049394 :topic/id #uuid "f121c6bf-38c7-56a2-930a-199717f2bc16" :topic/math-academy-id 398} :activity/steps [{:db/id #edb/ref 17592186069912 :step/content {:db/id #edb/ref 17592186070012 :tutorial/content "The **$y$-intercept** of a line is where the line intersects the $y$-axis. For instance, consider the line that passes through the point $(1,-1)$ and has a slope of $3$. How can we find the $y$-intercept of this line?\n\n![](images/c3/c307a60266b77cb497a5c5b02a6d9518a3b31e22b1ec97afb1d2b40f488982cb.png)\n\nWe already know values for $x$, $y$ and $m$, so we can just substitute them into the equation\n\n$$\ny=mx+b\n$$\n\nand then solve for $b$:\n\n$$\n\\begin{aligned}\ny &= mx + b \\\\\n(-1) &= (3)(1) + b \\\\\n- 1 &= 3 + b \\\\\nb &= -4\n\\end{aligned}\n$$\n\nSo, the $y$-intercept is\n\n$$\n{\\color{blue}b}=-4\n$$\n\nThe coordinates of the $y$-intercept are $(0,-4)$." :tutorial/id #uuid "1f9c0e73-8a80-5472-bf82-4c78c873c181" :tutorial/math-academy-id 8059 :tutorial/title "Introduction"} :step/id #uuid "32960d35-0132-5c05-a0dc-e73600e6a188" :step/math-academy-id 67150 :step/next {:db/id #edb/ref 17592186069913}} {:db/id #edb/ref 17592186069913 :step/content {:db/id #edb/ref 17592186068924 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068460 :question/id #uuid "4ad21d3a-bf40-5b65-8ba6-320d853e6cff" :question/math-academy-id "e-12869"} :knowledge-point/id #uuid "bc85ca17-8a08-5473-9473-dce954132bd5" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048725} {:db/id #edb/ref 17592186049716}] :knowledge-point/questions [{:db/id #edb/ref 17592186069250} {:db/id #edb/ref 17592186069491} {:db/id #edb/ref 17592186069492}] :knowledge-point/title "Finding the Y-Intercept of a Line Given a Point on the Line and Its Slope"} :step/id #uuid "05d03a89-9aa4-5b0f-97cd-69809a74c97d" :step/math-academy-id 67151 :step/next {:db/id #edb/ref 17592186069914}} {:db/id #edb/ref 17592186069914 :step/content {:db/id #edb/ref 17592186068925 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068461 :question/id #uuid "fdc3a6e9-080b-5e2a-b5a4-3af01c7018ff" :question/math-academy-id "e-12870"} :knowledge-point/id #uuid "5e985ae8-05ba-590a-b504-4c84884679f4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049061}] :knowledge-point/questions [{:db/id #edb/ref 17592186069012} {:db/id #edb/ref 17592186069483} {:db/id #edb/ref 17592186069510} {:db/id #edb/ref 17592186235491}] :knowledge-point/title "Finding the Equation of a Line That Passes Through Two Points"} :step/id #uuid "fab7c6fb-b6fe-5b55-adee-114f45b728d4" :step/math-academy-id 67155 :step/next {:db/id #edb/ref 17592186069915}} {:db/id #edb/ref 17592186069915 :step/content {:db/id #edb/ref 17592186070013 :tutorial/content "The **$x$-intercept** of a line is where the line intersects the $x$-axis. For instance, consider the line $y = 2x - 4$. How can we find the $x$-intercept of this line?\n\n![](images/57/57a31eab932c948358e7ab6e428707a6a4b9f551bc956554c3a16b659b5f7988.png)\n\nAt the $x$-intercept, the $y$-coordinate is equal to $0$. So, we can substitute $y=0$ into the equation and then solve for $x$:\n\n$$\n\\begin{aligned}\ny &= 2x - 4 \\\\\n(0) &= 2x - 4 \\\\\n4 &= 2x \\\\\n2 &= x \\\\\nx &= 2\n\\end{aligned}\n$$\n\nTherefore, the $x$**-intercept** is $x=2$. The coordinates of the $x$-intercept are $(2,0)$." :tutorial/id #uuid "fbd0b44d-8460-5058-9b94-c21852d09a4b" :tutorial/math-academy-id 8060 :tutorial/title "Finding the X-Intercept of a Straight Line"} :step/id #uuid "27dfa118-efd1-5317-966f-90a083509c55" :step/math-academy-id 67159 :step/next {:db/id #edb/ref 17592186069916}} {:db/id #edb/ref 17592186069916 :step/content {:db/id #edb/ref 17592186068926 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068462 :question/id #uuid "ec5bebf6-58d8-5b4d-900c-3c024628647c" :question/math-academy-id "e-12871"} :knowledge-point/id #uuid "63461668-4f76-52a4-8115-1ab135eef9e3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050532}] :knowledge-point/questions [{:db/id #edb/ref 17592186069044} {:db/id #edb/ref 17592186069346} {:db/id #edb/ref 17592186069453} {:db/id #edb/ref 17592186234053} {:db/id #edb/ref 17592186235493}] :knowledge-point/title "Finding the X-Intercept of a Line Given a Point and a Slope"} :step/id #uuid "ebe74c08-cc12-564f-b8bf-ce093355d7a9" :step/math-academy-id 67160 :step/next {:db/id #edb/ref 17592186069917}} {:db/id #edb/ref 17592186069917 :step/content {:db/id #edb/ref 17592186068927 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068463 :question/id #uuid "409dfb1f-7400-5539-9dea-6c2d1b6b7ef0" :question/math-academy-id "e-12872"} :knowledge-point/id #uuid "f66989ce-aac5-5737-b60b-6ed703634cd5" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050763}] :knowledge-point/questions [{:db/id #edb/ref 17592186069245} {:db/id #edb/ref 17592186069249} {:db/id #edb/ref 17592186069454}] :knowledge-point/title "Finding the Intercept of a Horizontal or Vertical Line"} :step/id #uuid "8c918cb7-6f6b-5686-99e8-54b94b6009e4" :step/math-academy-id 67164}] :activity/title "Properties of Lines Given in Slope-Intercept Form" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068943}]}
