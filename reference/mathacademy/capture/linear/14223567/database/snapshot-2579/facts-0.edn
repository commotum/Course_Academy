86045417] [17592186069845 #edb/ref 1061 465010 #edb/ref 17592186045417] [17592186069845 #edb/ref 1062 #uuid "cccb1623-1f88-5a91-a725-a9297c4a42bd" #edb/ref 17592186045417] [17592186069845 #edb/ref 1063 #edb/ref 17592186069977 #edb/ref 17592186045417] [17592186069846 #edb/ref 1058 #edb/ref 17592186069847 #edb/ref 17592186045417] [17592186069846 #edb/ref 1061 465011 #edb/ref 17592186045417] [17592186069846 #edb/ref 1062 #uuid "f052205e-dccb-5df1-854d-2736620747d4" #edb/ref 17592186045417] [17592186069846 #edb/ref 1063 #edb/ref 17592186068880 #edb/ref 17592186045417] [17592186069847 #edb/ref 1058 #edb/ref 17592186069848 #edb/ref 17592186045417] [17592186069847 #edb/ref 1061 465015 #edb/ref 17592186045417] [17592186069847 #edb/ref 1062 #uuid "b5a7d92f-989e-567b-9228-7809f4fc610d" #edb/ref 17592186045417] [17592186069847 #edb/ref 1063 #edb/ref 17592186068881 #edb/ref 17592186045417] [17592186069848 #edb/ref 1058 #edb/ref 17592186069849 #edb/ref 17592186045417] [17592186069848 #edb/ref 1061 465019 #edb/ref 17592186045417] [17592186069848 #edb/ref 1062 #uuid "cdc39d32-ea5c-5bfb-b560-748aa57a8c25" #edb/ref 17592186045417] [17592186069848 #edb/ref 1063 #edb/ref 17592186068882 #edb/ref 17592186045417] [17592186069849 #edb/ref 1061 465023 #edb/ref 17592186045417] [17592186069849 #edb/ref 1062 #uuid "0939db2e-16b6-55cd-b607-6457140f35be" #edb/ref 17592186045417] [17592186069849 #edb/ref 1063 #edb/ref 17592186068883 #edb/ref 17592186045417] [17592186069977 #edb/ref 1064 "To solve an equation that contains multiple rational terms, we need to multiply both sides of the equation by the least common denominator. \n\nFor example, consider the equation\n\n$$\n\\dfrac{1}{2x^2}= \\dfrac{1}{2x}-\\dfrac{1}{x}.\n$$\n\nFirst, note that $x=0$ cannot be a solution because it would make the denominators equal zero.\n\nNow, let's multiply both sides of the equation by the least common denominator. The equation has the denominators $2x^2,$ $2x,$ and $x,$ so the least common multiple (or $\\textrm{LCM}$) of the denominators is \n\n$$\n\\textrm{LCM}(2x^2, 2x, x) = {\\color{black}2x^2}.\n$$\n\nMultiplying both sides of the equation by ${\\color{black}2x^2}$ and simplifying, we get\n\n$$\n\\begin{aligned}2{x}^{2}\\cdot \\frac{1}{2{x}^{2}} & =2{x}^{2}\\cdot (\\frac{1}{2x}-\\frac{1}{x}) \\\\ \\cancel{2{x}^{2}}\\cdot \\frac{1}{\\cancel{2{x}^{2}}} & =\\frac{2{x}^{2}}{2x}-\\frac{2{x}^{2}}{x} \\\\ 1 & =\\frac{\\cancel{2x}\\cdot x}{\\cancel{2x}}-\\frac{\\cancel{x}\\cdot 2x}{\\cancel{x}} \\\\ 1 & =x-2x \\\\ 1 & =-x \\\\ x & =-1.\\end{aligned}\n$$\n\nFinally, recall that we cannot allow $x=0$ as a solution. Since $x = -1$ is different from $x=0,$ we can accept it as the solution. \n\nTherefore, the solution is $x=-1.$" #edb/ref 17592186045417] [17592186069977 #edb/ref 1065 3762 #edb/ref 17592186045417] [17592186069977 #edb/ref 1066 #uuid "71bfcc96-f9ce-5b5f-868d-60177e6790d8" #edb/ref 17592186045417] [17592186069977 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186293095 #edb/ref 1080 "32" #edb/ref 17592186045417] [17592186293095 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186293095 #edb/ref 1083 #uuid "2562c2a5-6799-5040-a6d8-35239d94c6c4" #edb/ref 17592186045417] [17592186294811 #edb/ref 1075 #edb/ref 17592186293095 #edb/ref 17592186045417] [17592186294811 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186294811 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186294811 #edb/ref 1078 #edb/ref 17592186293095 #edb/ref 17592186045417] [17592186294811 #edb/ref 1079 #uuid "fb132b1f-eced-50c2-9b8d-4aadb8c3a8b1" #edb/ref 17592186045417] [17592186294884 #edb/ref 1068 #edb/ref 17592186294811 #edb/ref 17592186045417] [17592186294884 #edb/ref 1069 "q-276864" #edb/ref 17592186045417] [17592186294884 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186294884 #edb/ref 1071 "Solve for $f$ where $\\frac{f+6}{f}-\\frac{3f+9}{5f}=\\frac{f+2}{2f}.$\n\n$f=$\n{{field-1}}" #edb/ref 17592186045417] [17592186294884 #edb/ref 1072 #uuid "8ce28150-db62-5cfe-975f-e10652804e6e" #edb/ref 17592186045417] [17592186294884 #edb/ref 1074 "We note that $f=0$ cannot be a solution since division by $0$ is undefined. \n\nThe equation has the denominators $f,\\,2f,$ and $5f.$ So first, we find the least common multiple (or $\\text{LCM}$) of the denominators. We find that\n\n$$\n\\text{LCM}(f,2f,5f)=10f.\n$$\n\nSo, we multiply both sides of the equation by $10f,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{f+6}{f}-\\frac{3f+9}{5f} & =\\frac{f+2}{2f} \\\\ 10f(\\frac{f+6}{f}-\\frac{3f+9}{5f}) & =10f(\\frac{f+2}{2f}) \\\\ 10f\\cdot \\frac{f+6}{f}-10f\\cdot \\frac{3f+9}{5f} & =10f\\cdot \\frac{f+2}{2f} \\\\ 10\\cdot f\\cdot \\frac{f+6}{f}-2\\cdot 5f\\cdot \\frac{3f+9}{5f} & =5\\cdot 2f\\cdot \\frac{f+2}{2f} \\\\ 10\\cdot \\cancel{f}\\cdot \\frac{f+6}{\\cancel{f}}-2\\cdot \\cancel{5f}\\cdot \\frac{3f+9}{\\cancel{5f}} & =5\\cdot \\cancel{2f}\\cdot \\frac{f+2}{\\cancel{2f}} \\\\ 10(f+6)-2(3f+9) & =5(f+2)\\end{aligned}\n$$\n\nWe now have a linear equation in $f,$ and we can solve this using the addition and multiplication principles:\n\n$$\n\\begin{aligned}10(f+6)-2(3f+9) & =5(f+2) \\\\ 10f+60-6f-18 & =5f+10 \\\\ 4f+42 & =5f+10 \\\\ -f & =-32 \\\\ f & =32\\end{aligned}\n$$\n\nFinally, we recall that we cannot allow $f=0$ as a solution. But since $f=32\\ne 0,$ we conclude that the solution is $f=32.$" #edb/ref 17592186045417] [17592186429417 #edb/ref 1030 1.0 #edb/ref 17592186045436] [17592186429417 #edb/ref 1032 "Initial Codex estimate from captured target-band crossing frequency. Selected account foundations: 1 rises / 1 eligible passed source activities = 1.000000; nearest selected fraction = 1. Crossing activity numbers [1]; waits [1]. Separate account estimates: foundations=1 (1/1). Selection: most observations, then lower weight, then account name; no averaging. Single-activity estimates included. Intervening target updates: False. Crossing frequency is the chosen practical estimate of