#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186069829} :activity/id #uuid "869ed6af-0b10-50ce-bcc8-797d11374764" :activity/scope {:db/id #edb/ref 17592186049865 :topic/id #uuid "199474d1-056b-5893-9b64-b81d744c2685" :topic/math-academy-id 457} :activity/steps [{:db/id #edb/ref 17592186069829 :step/content {:db/id #edb/ref 17592186069965 :tutorial/content "So far, we have expressed an exponential equation in logarithm form. We can also go the other way, and express a logarithmic equation in exponential form.\n\nRemember, the base of the logarithm is always the base of the exponential expression.\nFor instance, if we know that $\\log_{\\color{blue}{2}}(8) = {\\color{red}{3}},$ we could write this using an exponent as\n\n$$\n{\\color{blue}{2}}^{\\color{red}{3}} = 8.\n$$\n\nIn general, the logarithm of $a$ with base $b$ is defined as follows:\n\n$\\log_{\\color{blue}b}{a} = {\\color{red}x}$ is equivalent to $a = {\\color{blue}b}^{\\color{red}x}.$" :tutorial/id #uuid "2c0b02d2-c424-5af8-967f-1b8a92acc6a0" :tutorial/math-academy-id 2864 :tutorial/title "Introduction"} :step/id #uuid "077084c4-e969-5566-9b83-62efaa598eb0" :step/math-academy-id 455501 :step/next {:db/id #edb/ref 17592186069830}} {:db/id #edb/ref 17592186069830 :step/content {:db/id #edb/ref 17592186068869 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068555 :question/id #uuid "0cd0e716-e9da-51ca-9c75-adedad1bf12d" :question/math-academy-id "e-3978"} :knowledge-point/id #uuid "2d99805e-a17a-57ef-ae56-85f3060b066a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049859}] :knowledge-point/questions [{:db/id #edb/ref 17592186069190} {:db/id #edb/ref 17592186069207} {:db/id #edb/ref 17592186069480} {:db/id #edb/ref 17592186516810} {:db/id #edb/ref 17592186516834}] :knowledge-point/title "Converting Equations From Logarithmic Form to Exponential Form"} :step/id #uuid "c26247c0-b345-560a-ab6b-b4538d6ca211" :step/math-academy-id 455502 :step/next {:db/i