#{[{:db/id #edb/ref 17592186068555 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068869 :knowledge-point/id #uuid "2d99805e-a17a-57ef-ae56-85f3060b066a" :knowledge-point/title "Converting Equations From Logarithmic Form to Exponential Form"}] :question/id #uuid "0cd0e716-e9da-51ca-9c75-adedad1bf12d" :question/math-academy-id "e-3978" :question/problem "The equation $\\log_3{9} = 2$ is equivalent to $b^2 = 9.$ What is the value of $b?$" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$\\log_{b}{a} = x$ is equivalent to $a = b^x$\n\nIf we compare $\\log_3{9} = 2$ with $\\log_{b}{a} = x,$ we get $a = 9,$ $b = 3,$ and $x = 2.$\n\nTherefore, the given equation is equivalent to $3^2 = 9.$ Consequently, $b = 3.$"}] [{:db/id #edb/ref 17592186068556 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068870 :knowledge-point/id #uuid "2812181f-7ccc-5609-a399-1cf68591a903" :knowledge-point/title "Converting Equations From Logarithmic Form to Exponential Form with Exponents of Zero or One"}] :question/id #uuid "c9eafa03-bc10-5dfd-a212-a662d26974ab" :question/math-academy-id "e-3979" :question/problem "The equation $\\log_{6}{1} = 0$ is equivalent to $b^0 = 1.$ What is the value of $b?$" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$\\log_{b}{a} = x$ is equivalent to $a = b^x$\n\nIf we compare $\\log_{6}{1} = 0$ with $\\log_{b}{a} = x,$ we get $a = 1,$ $b = 6,$ and $x = 0.$\n\nTherefore, the given equation is equivalent to $6^0 = 1.$ Consequently, $b = 6.$"}] [{:db/id #edb/ref 17592186068557 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068871 :knowledge-point/id #uuid "aedb775e-d1c1-54dd-b66a-a9351dff1d97" :knowledge-point/title "Converting Equations From Logarithmic Form to Exponential Form Using Fractional Powers"}] :question/id #uuid "446ff062-5a2d-5178-9660-60bafae375fb" :question/math-academy-id "e-3980" :question/problem "The equation $\\log_{16}{4} = \\dfrac{1}{2}$ is equivalent to $\\sqrt{b} = 4.$ What is the value of $b?$" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$\\log_{b}{a} = x$ is equivalent to $a = b^x$\n\nIf we compare $\\log_{16}{4} = \\dfrac{1}{2}$ with $\\log_{b}{a} = x,$ we get $a = 4,$ $b = 16,$ and $x = \\dfrac{1}{2}.$\n\nTherefore, the given equation is equivalent to $16^{1/2} = 4,$ which is also equivalent to $\\sqrt{16} = 4.$ Consequently, $b = 16.$"}] [{:db/id #edb/ref 17592186068558 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068872 :knowledge-point/id #uuid "c754b280-89d0-5a8b-a1bc-a1be3d3ffce6" :knowledge-point/title "Converting Equations From Logarithmic Form to Exponential Form Using Negative Powers"}] :question/id #uuid "2613759b-9a0e-59b1-952b-1d2a8a08b4f4" :question/math-academy-id "e-3981" :question/problem "The equation $\\log_{2}\\left( \\dfrac{1}{8} \\right) = -3$ is equivalent to $b^{-3} = \\dfrac{1}{8}.$ What is the value of $b?$" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$\\log_{b}{a} = x$ is equivalent to $a = b^x$\n\nIf we compare $\\log_{2}\\left( \\dfrac{1}{8} \\right) = -3$ with $\\log_{b}{a} = x,$ we get $a = \\dfrac{1}{8},$ $b = 2,$ and $x = -3.$\n\nTherefore, the given equation is equivalent to $2^{-3} = \\dfrac{1}{8}.$ Consequently, $b = 2.$"}] [{:db/id #edb/ref 17592186516834 :knowledge-point/_questions [{:db/id #edb/ref 17592186068869 :knowledge-point/id #uuid "2d99805e-a17a-57ef-ae56-85f3060b066a" :knowledge-point/title "Converting Equations From Logarithmic Form to Exponential Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9c06735-3f62-57f4-8f53-da25745305f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186516467}] :answer-field/correct {:answer/id #uuid "a9c06735-3f62-57f4-8f53-da25745305f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type