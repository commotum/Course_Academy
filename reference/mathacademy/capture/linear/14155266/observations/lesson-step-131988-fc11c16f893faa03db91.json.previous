722 153Q722 140 707 133H70Q56 140 56 153Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E8-MJMAIN-33\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E8-MJMAIN-D7\" x=\"889\" y=\"0\"></use>\n<g transform=\"translate(1890,0)\">\n<g transform=\"translate(351,0)\">\n <use xlink:href=\"#E8-MJMAIN-32\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E8-MJMAIN-32\" x=\"707\" y=\"583\"></use>\n</g>\n<g transform=\"translate(0,1206)\">\n <use xlink:href=\"#E8-MJSZ4-E150\" x=\"23\" y=\"0\"></use>\n<g transform=\"translate(390,0)\">\n <use xlink:href=\"#E8-MJSZ4-E153\"></use>\n <use xlink:href=\"#E8-MJSZ4-E152\" x=\"450\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E8-MJSZ4-E151\" x=\"1207\" y=\"0\"></use>\n</g>\n<g transform=\"translate(616,1740)\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n <use transform=\"scale(0.849)\" xlink:href=\"#E8-MJMAIN-34\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E8-MJMAIN-3D\" x=\"3825\" y=\"0\"></use>\n <use xlink:href=\"#E8-MJMAIN-33\" x=\"4882\" y=\"0\"></use>\n <use xlink:href=\"#E8-MJMAIN-D7\" x=\"5604\" y=\"0\"></use>\n<g fill=\"blue\" stroke=\"blue\" transform=\"translate(6605,0)\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n <use xlink:href=\"#E8-MJMAIN-34\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span> </p>\n<p>Then, we perform the <strong>M</strong>ultiplication:\n<span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"10.589ex\" height=\"2.176ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -791.3 4559 936.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-9-Title\">\n<title id=\"MathJax-SVG-9-Title\">\n\t3\\times 4 = 12\n</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E9-MJMAI