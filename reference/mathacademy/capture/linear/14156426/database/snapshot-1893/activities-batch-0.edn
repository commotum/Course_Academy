#{[{:activity/first-step {:db/id #edb/ref 17592186079527} :activity/id #uuid "b8eeb531-1cc3-5a66-b9a3-821d7aefa496" :activity/scope {:db/id #edb/ref 17592186049823 :topic/id #uuid "168508a9-54ad-56a7-94f7-54369acb9706" :topic/math-academy-id 652} :activity/steps [{:db/id #edb/ref 17592186079527 :step/content {:db/id #edb/ref 17592186079710 :tutorial/content "We know how to evaluate expressions like $2^3, 2^2, 2^1$, and even $2^0$. But what if the power is negative? How would we evaluate $2^{-1}$, for example?\n\nTo help us with that, let's go back to the results table for powers of $2$.\n\n$$\n\\begin{aligned}\n2^{4} &= 16 \\\\\n2^{3} &= 8 \\\\\n2^{2} &= 4 \\\\\n2^{1} &= 2 \\\\\n2^{0} &= 1 \\\\\n2^{-1} &= ◻\n\\end{aligned}\n$$\n\nAs we go down the list, the number in blue is divided by $2$ every time. If we follow the same pattern, we find that\n\n$$\n2^{\\color{red}{-1}} = {\\color{blue}{1}}\\div 2 = \\dfrac{1}{2}\n$$\n\nNow,\n\n$$\n\\dfrac{1}{2}\n$$\n\nis just the reciprocal of $2$. So, raising a number to the power of $-1$ is the *same* as finding its reciprocal!" :tutorial/id #uuid "1a1e2f61-f43c-5311-914b-4898ea6cd4eb" :tutorial/math-academy-id 8016 :tutorial/title "Introduction"} :step/id #uuid "f1b1c942-6488-5737-81b4-60277d491717" :step/math-academy-id 51347 :step/next {:db/id #edb/ref 17592186079528}} {:db/id #edb/ref 17592186079528 :step/content {:db/id #edb/ref 17592186078574 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078150 :question/id #uuid "6b6bbf54-883b-5890-b016-95a5a02f56c6" :question/math-academy-id "e-12785"} :knowledge-point/id #uuid "d14f7dad-9602-57e7-83ee-cb518f9b573d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050749}] :knowledge-point/questions [{:db/id #edb/ref 17592186078906} {:db/id #edb/ref 17592186079192}] :knowledge-point/title "Raising an Integer to the Power of Negative One"} :step/id #uuid "9cfe4369-6905-5a30-aa98-1082dd158832" :step/math-academy-id 51348 :step/next {:db/id #edb/ref 17592186079529}} {:db/id #edb/ref 17592186079529 :step/content {:db/id #edb/ref 17592186078575 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078151 :question/id #uuid "48aabb5b-91c6-5d79-b448-ffdaadced783" :question/math-academy-id "e-12786"} :knowledge-point/id #uuid "676544c7-1f2d-5c99-bf97-784e541bdd10" :knowledge-point/questions [{:db/id #edb/ref 17592186078907} {:db/id #edb/ref 17592186079201}] :knowledge-point/title "Raising a Negative Integer to the Power of Negative One"} :step/id #uuid "9d8d0d0e-8969-50fb-bfd9-4416a4ac940d" :step/math-academy-id 51351 :step/next {:db/id #edb/ref 17592186079530}} {:db/id #edb/ref 17592186079530 :step/content {:db/id #edb/ref 17592186078576 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078152 :question/id #uuid "b7fb5d2e-4832-5372-b829-b86e91a21ab6" :question/math-academy-id "e-12787"} :knowledge-point/id #uuid "5481b688-9770-57a7-a8a8-26a72f50be09" :knowledge-point/questions [{:db/id #edb/ref 17592186078882} {:db/id #edb/ref 17592186079193}] :knowledge-point/title "Raising a Fraction to the Power of Negative One"} :step/id #uuid "5a5fdb67-bf71-5205-952b-abc1bad1cbcd" :step/math-academy-id 51354}] :activity/title "Powers of Negative One" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078674}]}
