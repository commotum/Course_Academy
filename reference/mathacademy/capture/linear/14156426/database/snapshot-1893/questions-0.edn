#{[{:db/id #edb/ref 17592186078150 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078574 :knowledge-point/id #uuid "d14f7dad-9602-57e7-83ee-cb518f9b573d" :knowledge-point/title "Raising an Integer to the Power of Negative One"}] :question/id #uuid "6b6bbf54-883b-5890-b016-95a5a02f56c6" :question/math-academy-id "e-12785" :question/problem "Express $3^{-1}$ as a fraction in its simplest form." :question/worked-solution "The expression $3^{-1}$ means the reciprocal of $3$. Hence\n\n$$\n3^{-1} = \\dfrac{1}{3}\n$$"}] [{:db/id #edb/ref 17592186078151 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078575 :knowledge-point/id #uuid "676544c7-1f2d-5c99-bf97-784e541bdd10" :knowledge-point/title "Raising a Negative Integer to the Power of Negative One"}] :question/id #uuid "48aabb5b-91c6-5d79-b448-ffdaadced783" :question/math-academy-id "e-12786" :question/problem "What is $(-4)^{-1}$?" :question/worked-solution "The expression $(-4)^{-1}$ means the reciprocal of $-4$. Therefore,\n\n$$\n(-4)^{-1} = -\\dfrac{1}{4}\n$$"}] [{:db/id #edb/ref 17592186078152 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078576 :knowledge-point/id #uuid "5481b688-9770-57a7-a8a8-26a72f50be09" :knowledge-point/title "Raising a Fraction to the Power of Negative One"}] :question/id #uuid "b7fb5d2e-4832-5372-b829-b86e91a21ab6" :question/math-academy-id "e-12787" :question/problem "Evaluate $\\left(\\dfrac{2}{3}\\right)^{-1}$." :question/worked-solution "The expression\n\n$$\n\\left(\\dfrac{2}{3}\\right)^{-1}\n$$\n\nmeans the reciprocal of\n\n$$\n\\dfrac{2}{3}\n$$\n\nTherefore,\n\n$$\n\\left(\\dfrac{2}{3}\\right)^{-1} = \\dfrac{3}{2}\n$$"}]}
