/content {:db/id #edb/ref 17592186501146 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c7b9ffa-61e8-5834-acc7-13454c3bc5ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186500619}] :answer-field/correct {:db/id #edb/ref 17592186500619} :answer-field/id #uuid "bcc60e61-7c99-51fb-8ae6-518b9c8d435c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186501106}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "18e9c87c-d5d7-52d0-922d-e65af5fe041b" :question/math-academy-id "q-171258" :question/problem "Express ${(\\frac{2}{9})}^{-1}$ as an improper fraction in its simplest form.\n\n${(\\frac{2}{9})}^{-1}=$\n{{field-1}}" :question/worked-solution "The expression ${(\\frac{2}{9})}^{-1}$ means the reciprocal of $\\frac{2}{9}.$ Therefore,\n\n$$\n{(\\frac{2}{9})}^{-1}=\\frac{9}{2}.\n$$"} :step/id #uuid "49ba4a41-efbb-530f-82bb-ce4e6b9af5f6"} {:db/id #edb/ref 17592186501267 :step/content {:db/id #edb/ref 17592186501164 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cc6c2a8-9cc6-5de4-ac4c-c45eae060371" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{18}" :db/id #edb/ref 17592186500561} {:answer/id #uuid "58d6deca-98f9-5e49-bb01-84d6e5714d37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{18}" :db/id #edb/ref 17592186500647} {:answer/id #uuid "71edb4cb-d29b-51f7-8df6-7cd288853616" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-19" :db/id #edb/ref 17592186500701} {:answer/id #uuid "7ef80cc3-e4cc-56bc-9ec4-72bac32f2ddf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-18" :db/id #edb/ref 17592186500730} {:answer/id #uuid "95467930-7eb8-56fc-8500-ec42d5d257bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186500774}] :answer-field/correct {:db/id #edb/ref 17592186500647} :answer-field/id #uuid "1ca2