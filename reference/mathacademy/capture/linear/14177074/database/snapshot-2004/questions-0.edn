#{[{:db/id #edb/ref 17592186064736 :knowledge-point/_questions [{:db/id #edb/ref 17592186064278 :knowledge-point/id #uuid "09357892-5d4b-5346-99b0-9babc7b0d574" :knowledge-point/title "Multiplying Binomials and Trinomials Containing More Than One Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a73230d7-2608-5fda-9bd9-d380d1b68a15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186062474} {:answer/id #uuid "1b5c7bcc-d988-51a2-9faf-29f8684be33d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186062475} {:answer/id #uuid "51aa5b57-b075-512f-8ab1-4f61456e288d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186062476} {:answer/id #uuid "54e07f76-634a-50b0-88d5-295949f8771b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186062477} {:answer/id #uuid "62156e2a-34ce-55e9-88d2-edcd5c90f59d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186062478}] :answer-field/correct {:answer/id #uuid "54e07f76-634a-50b0-88d5-295949f8771b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186062477} :answer-field/id #uuid "13a25c94-9e58-52b2-9281-07182838de44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186062473}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aa8dfac6-2e07-5a12-91bc-c7ca479ccc66" :question/math-academy-id "q-31382" :question/problem "What is the coefficient of ${x}^{2}y$ in the product $(x-y)({x}^{2}+6xy-9{y}^{2})?$" :question/worked-solution "We distribute all three terms of the binomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(x-y)({x}^{2}+6xy-9{y}^{2}) & = \\\\ x({x}^{2}+6xy-9{y}^{2})+(-y)({x}^{2}+6xy-9{y}^{2}) & = \\\\ {x}^{3}+6{x}^{2}y-9x{y}^{2}-{x}^{2}y-6x{y}^{2}+9{y}^{3} & = \\\\ {x}^{3}+5{x}^{2}y-15x{y}^{2}+9{y}^{3}\\end{aligned}\n$$\n\nTherefore, the coefficient of ${x}^{2}y$ is $5.$"}] [{:db/id #edb/ref 17592186493963 :knowledge-point/_questions [{:db/id #edb/ref 17592186064277 :knowledge-point/id #uuid "f7019d52-33a1-5968-9a93-2f2f06fbb0d6" :knowledge-point/title "Multiplying Trinomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1509f49e-da21-5888-a3e2-156f6abd8874" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186493429} {:answer/id #uuid "39d6163e-8a28-5dea-acdf-43f43b916822" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186493487} {:answer/id #uuid "45f89047-5bab-5a07-8abc-c0436c6ee8a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186493509} {:answer/id #uuid "e27c97bd-9bdc-5a82-9295-1903f7e28d23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186493750} {:answer/id #uuid "e8b629bc-bc84-51ab-bcdf-5cf5e9435232" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186493763}] :answer-field/correct {:answer/id #uuid "e27c97bd-9bdc-5a82-9295-1903f7e28d23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186493750} :answer-field/id #uuid "d4c94381-cca8-57b8-bdf5-3cd85a1f90d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493877}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d9aae8a4-653e-5752-9c3b-a882c899846f" :question/math-academy-id "q-78170" :question/problem "Given that  $({p}^{2}+p+1)({p}^{2}+3p+1)={p}^{4}+a{p}^{3}+b{p}^{2}+cp+1,$ calculate $a+b+c.$" :question/worked-solution "We distribute all three terms of the trinomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}({p}^{2}+p+1)({p}^{2}+3p+1) & = \\\\ {p}^{2}({p}^{2}+3p+1)+p({p}^{2}+3p+1)+1({p}^{2}+3p+1) & = \\\\ {p}^{4}+3{p}^{3}+{p}^{2}+{p}^{3}+3{p}^{2}+p+{p}^{2}+3p+1 & = \\\\ {p}^{4}+4{p}^{3}+5{p}^{2}+4p+1\\end{aligned}\n$$\n\nTherefore, $a=4,$ $b=5,$ and $c=4.$ So, \n\n$$\na+b+c=4+5+4=13.\n$$"}] [{:db/id #edb/ref 17592186493900 :knowledge-point/_questions [{:db/id #edb/ref 17592186064277 :knowledge-point/id #uuid "f7019d52-33a1-5968-9a93-2f2f06fbb0d6" :knowledge-point/title "Multiplying Trinomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6186a0e8-15ad-5f04-9514-03a897bd46d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186493536} {:answer/id #uuid "79daec01-1bd7-52c2-9729-762b7fa0a1f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186493575} {:answer/id #uuid "7bcf2e2e-64a8-5b8a-80c5-fd2e2740d5d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186493579} {:answer/id #uuid "89b4a778-8744-54f1-9b64-0291ebefd5aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186493606} {:answer/id #uuid "db0402ea-ca02-5133-8b2b-0f9106ee55f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186493735}] :answer-field/correct {:answer/id #uuid "6186a0e8-15ad-5f04-9514-03a897bd46d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186493536} :answer-field/id #uuid "fb22af84-6e18-5551-a3f1-bbcb3eb8cfb6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493889}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "222f2e72-f895-5b79-8f06-000077812dd5" :question/math-academy-id "q-78171" :question/problem "Given that  $({t}^{2}+t+2)({t}^{2}+2t+1)={t}^{4}+a{t}^{3}+b{t}^{2}+ct+2,$ calculate $a+b+c.$" :question/worked-solution "We distribute all three terms of the trinomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}({t}^{2}+t+2)({t}^{2}+2t+1) & = \\\\ {t}^{2}({t}^{2}+2t+1)+t({t}^{2}+2t+1)+2({t}^{2}+2t+1) & = \\\\ {t}^{4}+2{t}^{3}+{t}^{2}+{t}^{3}+2{t}^{2}+t+2{t}^{2}+4t+2 & = \\\\ {t}^{4}+3{t}^{3}+5{t}^{2}+5t+2 & \\end{aligned}\n$$\n\nTherefore, $a=3,$ $b=5,$ and $c=5.$ So, \n\n$$\na+b+c=3+5+5=13.\n$$"}]}
