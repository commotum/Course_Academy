b/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{-1,0}" :db/id #edb/ref 17592186409873}] :answer-field/correct {:answer/id #uuid "357a177c-678c-5efe-b182-20eab09b9991" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{-4,0}" :db/id #edb/ref 17592186409849} :answer-field/id #uuid "21f37bd0-557b-529a-88f6-615287ca253d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186409880}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3574e15c-1d81-5d76-a394-37484fa9dfbb" :question/math-academy-id "q-174363" :question/problem "![](images/ae/aeb0c87a33cf30494636f0a8f8d411033ba064385ad04065abff184752ea99d7.png)\n\nWhich of the following is the subset $A$ of $U={-4,-3,-2,-1,0}$ whose indicator function ${1}_{A}(x)$ is shown above?" :question/worked-solution "An indicator function maps elements from a set to the values $0$ or $1,$ depending on whether the element belongs to a specified subset. The indicator function is designed to \"indicate\" whether an element is a member of a subset.\n\nMore specifically, consider a universal set $X.$ Then, the indicator function of a set $A⊆X$ is the function\n\n$$\n{1}_{A}(x)={\\begin{aligned}1, & \\text{if }x\\in A, \\\\ 0, & \\text{if }x\\notin A.\\end{aligned}\n$$\n\nIn the diagram above, only the elements $-4$ and $0$ are mapped to $1.$ Therefore, the indicator function in the diagram above corresponds to the set $A={-4,0}.$"}] [{:db/id #edb/ref 17592186420398 :knowledge-point/_questions [{:db/id #edb/ref 17592186092338 :knowledge-point/id #uuid "2e380013-0002-5a17-bbf7-e9ce89e6331d" :knowledge-point/title "Identifying the Indicator Function of a Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03fbd85f-b443-5e0c-9c2a-949a37212341" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/45/4544c4662d43872a4b36bdb0fec343de92ae60a9357d952c4c1d4683c6dc5e2b.png" :db/id #edb/ref 17592186420386} {:answer/id #uuid "065f51d0-87f5-5d0a-beff-e1ffeb43d4fd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/43/430e795e30015f0cad5add0db6360890dadca7b2829947aeb5d40999a08be201.png" :db/id #edb/ref 17592186420387} {:answer/id #uuid "133bd8dc-2c5b-5e1b-bfb2-e4928c76cb5e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/42/428dbace9da052a9a308996f661f17249c72798f72d7aff416e82e2a747860ba.png" :db/id #edb/ref 17592186420388} {:answer/id #uuid "68af38a9-4172-580e-b666-d3cbc1377bf4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/41/41937d29a553f82e3f40c698773ab7f87c7743c16c6ee74fe23ed4edd74fe226.png" :db/id #edb/ref 17592186420390} {:answer/id #uuid "fe62726e-5545-5152-8439-a9f4dd17bb4a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/71/7188822007990d41967c09a32f58911494a2c0e2e48a30d1461d398f95178377.png" :db/id #edb/ref 17592186420395}] :answer-field/correct {:answer/id #uuid "133bd8dc-2c5b-5e1b-bfb2-e4928c76cb5e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/42/428dbace9da052a9a308996f661f17249c72798f72d7aff416e82e2a747860ba.png" :db/id #edb/ref 17592186420388} :answer-field/id #uuid "3c4bea35-db14-526a-a533-f1c203bb2ae0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420396}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1bca56bb-980a-59df-8356-0638316b5266" :question/math-academy-id "q-174367" :question/problem "Which of the following is the indicator function ${1}_{A}(x)$ of the subset $A={m,r,t}$ of $X={m,n,r,s,t}.$" :question/worked-solution "An indicator function maps elements from a set to the values $0$ or $1,$ depending on whether the element belongs to a specified subset. The indicator function is designed to \"indicate\" whether an element is a member of a subset.\n\nMore specifically, consider a universal set $X.$ Then, the indicator function of a set $A⊆X$ is the function\n\n$$\n{1}_{A}(x)={\\begin{aligned}1, & \\text{if }x\\in A, \\\\ 0, & \\text{if }x\\notin A.\\end{aligned}\n$$\n\nThe indicator function of the set ${m,r,t}$ is shown below.\n\n![](images/1f/1fd2100d57c3483e737dc40298d4d5f61099ebc2863c54839906b66183acf576.png)\n\n \n\nNotice that the elements $m,r$ and $t$ (the elements of our subset) are mapped to $1,$ and all other elements are mapped to $0.$"}] [{:db/id #edb/ref 17592186420399 :knowledge-point/_questions [{:db/id #edb/ref 17592186092338 :knowledge-point/id #uuid "2e380013-0002-5a17-bbf7-e9ce89e6331d" :knowledge-point/title "Identifying the Indicator Function of a Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5876baf4-837d-5703-a553-2a933946b7af" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/30/3068b57e654d320836833f2e8852a0e1fbffd8d35e9825f9152082e8f4824f3d.png" :db/id #edb/ref 17592186420389} {:answer/id #uuid "6ec41f8d-3b1b-5812-9900-158cda061db0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/28/28a91b86412c4aee3e560ab931cece60b018d5f6cb7bfc58a5708397a5115e66.png" :db/id #edb/ref 17592186420391} {:answer/id #uuid "8af772ff-67fa-5e4c-8c75-dfb82ea441bf" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d7/d77304e3deb98dc692121763451260c7e4009cff1c22aa8a05a7735fef032c45.png" :db/id #edb/ref 17592186420392} {:answer/id #uuid "9931fd7f-38ac-5c61-8d34-f2a0e53f7a02" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/32/322e21c2df0269a54bec0dce99fa46ab637bad8951ea