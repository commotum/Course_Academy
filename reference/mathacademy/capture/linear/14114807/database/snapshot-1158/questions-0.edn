edge-point/id #uuid "bd399539-33cf-5738-b970-fcc6c1d919c8" :knowledge-point/title "Using Properties of Indicator Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06dd1182-e612-5525-b9de-c12d2d05c3e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186409840} {:answer/id #uuid "4068f7e2-a0ab-5191-84b6-5c4067339274" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186409852} {:answer/id #uuid "618b2a8e-572b-5ad5-b3c0-c1a42f8e3e99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186409856} {:answer/id #uuid "a84e75b5-3a80-5752-b9ec-b71303a5aec6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186409865} {:answer/id #uuid "e97f4d7f-aabf-5567-8431-321ca8787569" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186409875}] :answer-field/correct {:answer/id #uuid "a84e75b5-3a80-5752-b9ec-b71303a5aec6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186409865} :answer-field/id #uuid "83594dda-c004-5625-a3b0-3d790a7941a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186409885}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a8a05322-998a-5d01-8b89-68a8bc93dd0f" :question/math-academy-id "q-174380" :question/problem "Given that ${1}_{A}(0)=0,$ which of the following statements about $\\overset{―}{A}$ are true?\n\nI. ${1}_{\\overset{―}{A}}\\,(0)=1$\n\nII. ${1}_{\\overset{―}{A}}\\,(0)=0$\n\nIII. $0\\in \\overset{―}{A}$\n\n*Hint: ${1}_{A}$ denotes the indicator function of the set $A$ and ${1}_{\\overset{―}{A}}$ denotes the indicator function of the complement of $A.$*" :question/worked-solution "Recall that the indicator functions of $\\overset{―}{A},$ $A\\cap B,$ and $A\\cup B$ have the following properties:\n\n$$\n\\begin{aligned}{1}_{\\overset{―}{A}}\\,(x) & =1-{1}_{A}(x) \\\\ {1}_{A\\,\\cap \\,B}\\,(x) & =min{{1}_{A}(x),{1}_{B}(x)} \\\\ {1}_{A\\,\\cup \\,B}\\,(x) & =max{{1}_{A}(x),{1}_{B}(x)}\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true while statement II is false. We have\n\n$$\n\\begin{aligned}{1}_{\\overset{―}{A}}\\,(0) & =1-{1}_{A}(0) \\\\  & =1-0 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement III is true. Since ${1}_{\\overset{―}{A}}\\,(0)=1,$ we conclude that $0$ belongs to $\\overset{―}{A}.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186409888 :knowledge-point/_questions [{:db/id #edb/ref 17592186092339 :knowledge-point/id #uuid "bd399539-33cf-5738-b970-fcc6c1d919c8" :knowledge-point/title "Using Properties of Indicator Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14622146-9357-5002-bb58-2d5df436755d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186409842} {:answer/id #uuid "3e0876cb-849b-532e-9b46-8b0f0fdbeb1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186409851} {:answer/id #uuid "6ee506d6-f345-54fa-9845-d354cdc4d92e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186409859} {:answer/id #uuid "b3660aee-3664-5309-b332-b14dc695c7ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186409868} {:answer/id #uuid "d0708573-229b-5e9d-a525-9d080007c898" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186409872}] :answer-field/correct {:answer/id #uuid "b3660aee-3664-5309-b332-b14dc695c7ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186409868} :answer-field/id #uuid "924887b9-029f-5ae2-880f-5a02a4c501f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186409886}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "09ca95e9-e7fd-5d14-80c3-ab64bc50a23d" :question/math-academy-id "q-174385" :question/problem "Given that ${1}_{A}(q)=0,$ which of the following statements about $\\overset{―}{A}$ are true?\n\nI. ${1}_{\\overset{―}{A}}\\,(q)=1$\n\nII. ${1}_{\\overset{―}{A}}\\,(q)=0$\n\nIII. $q\\in \\overset{―}{A}$\n\n*Hint: ${1}_{A}$ denotes the indicator function of the set $A$ and ${1}_{\\overset{―}{A}}$ denotes the indicator function of the complement of $A.$*" :question/worked-solution "Recall that the indicator functions of $\\overset{―}{A},$ $A\\cap B,$ and $A\\cup B$ have the following properties:\n\n$$\n\\begin{aligned}{1}_{\\overset{―}{A}}\\,(x) & =1-{1}_{A}(x) \\\\ {1}_{A\\,\\cap \\,B}\\,(x) & =min{{1}_{A}(x),{1}_{B}(x)} \\\\ {1}_{A\\,\\cup \\,B}\\,(x) & =max{{1}_{A}(x),{1}_{B}(x)}\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true while statement II is false. We have\n\n$$\n\\begin{aligned}{1}_{\\overset{―}{A}}\\,(q) & =1-{1}_{A}(q) \\\\  & =1-0 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement III is true. Since ${1}_{\\overset{―}{A}}\\,(q)=1,$ we conclude that $q$ belongs to $\\overset{―}{A}.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186409891 :knowledge-point/_questions [{:db/id #edb/ref 17592186092339 :knowledge-point/id #uuid "bd399539-33cf-5738-b970-fcc6c1d919c8" :knowledge-point/title "Using Properties of Indicator Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a0cc322-449d-5a1c-a8d7-1039e1ba0529" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186409845} {:answer/id #uuid "7bdeb40f-7a93-51cd-bc84-fa02eb15dc72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186409860} {:answer/id #uuid "9366fcca-3b9b-567c-9045-3a0693b79cf8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186409862} {:answer/id #uuid "de642bb2-a99e-53bd-8f67-e1c68961beb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186409874} {:answer/id #uuid "f75b591c-4385-5f6c-a77e-5445cd4d5bf5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186409877}] :answer-field/correct {:answer/id #uuid "7bdeb40f-7a93-51cd-bc84-fa02eb15dc72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186409860} :answer-field/id #uuid "652fe437-abe7-5a5a-bb3a-38f7c9e05f8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186409883}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "92b8a61e-f7a9-5e1e-adba-90e2fa6c6243" :question/math-academy-id "q-174394" :question/problem "$$\n{1}_{A}(-1)=1,\\,{1}_{B}(-1)=1\n$$\n\nGiven the values of the indicator functions of the sets $A$ and $B,$ which of the following statements are true?\n\nI. ${1}_{A\\,\\cap \\,B}\\,(-1)=1$\n\nII. ${1}_{A\\,\\cap \\,B}\\,(-1)=0$\n\nIII. $-1\\in A\\cap B$" :question/worked-solution "Recall that the indicator functions of $\\overset{―}{A},$ $A\\cap B,$ and $A\\cup B$ have the following properties:\n\n$$\n\\begin{aligned}{1}_{\\overset{―}{A}}\\,(x) & =1-{1}_{A}(x) \\\\ {1}_{A\\,\\cap \\,B}\\,(x) & =min{{1}_{A}(x),{1}_{B}(x)} \\\\ {1}_{A\\,\\cup \\,B}\\,(x) & =max{{1}_{A}(x),{1}_{B}(x)}\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true while statement II is false. We have\n\n$$\n\\begin{aligned}{1}_{A\\,\\cap \\,B}\\,(-1) & =min{{1}_{A}(-1),{1}_{B}(-1)} \\\\  & =min{1,1} \\\\  & =1.\\end{aligned}\n$$\n\n- Statement III is true. Since ${1}_{A\\,\\cap \\,B}\\,(-1)=1,$ we conclude that $-1$ belongs to $A\\cap B.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186409890 :knowledge-point/_questions [{:db/id #edb/ref 17592186092339 :knowledge-point/id #uuid "bd399539-33cf-5738-b970-fcc6c1d919c8" :knowledge-point/title "Using Properties of Indicator Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43e6f09d-b15b-583f-b322-ed2cb2110fd7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186409853} {:answer/id #uuid "4dbbb73e-91a8-55fd-a1de-9d7b3f028b3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186409855} {:answer/id #uuid "a8709f24-d2a8-5df8-9964-5dbb01efd971" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186409866} {:answer/id #uuid "fa079c9e-2ffa-5770-8242-48897473068d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186409878} {:answer/id #uuid "fb44f87f-b177-51f3-96ce-7df17d89d7db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186409879}] :answer-field/correct {:answer/id #uuid "4dbbb73e-91a8-55fd-a1de-9d7b3f028b3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186409855} :answer-field/id #uuid "2f6ddc19-1832-5d0d-a446-4a288e0c42e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186409881}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6c60efa7-9f70-50c9-8725-0334784ed791" :question/math-academy-id "q-174402" :question/problem "$$\n{1}_{A}(t)=1,\\,{1}_{B}(t)=1\n$$\n\nGiven the values of the indicator functions of the sets $A$ and $B,$ which of the following statements are true?\n\nI. ${1}_{A\\,\\cup \\,B}\\,(t)=1$\n\nII. ${1}_{A\\,\\cup \\,B}\\,(t)=0$\n\nIII. $t\\in A\\cup B$" :question/worked-solution "Recall that the indicator functions of $\\overset{―}{A},$ $A\\cap B,$ and $A\\cup B$ have the following properties:\n\n$$\n\\begin{aligned}{1}_{\\overset{―}{A}}\\,(x) & =1-{1}_{A}(x) \\\\ {1}_{A\\,\\cap \\,B}\\,(x) & =min{{1}_{A}(x),{1}_{B}(x)} \\\\ {1}_{A\\,\\cup \\,B}\\,(x) & =max{{1}_{A}(x),{1}_{B}(x)}\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true while statement II is false. We have\n\n$$\n\\begin{aligned}{1}_{A\\,\\cup \\,B}\\,(t) & =max{{1}_{A}(t),{1}_{B}(t)} \\\\  & =max{1,1} \\\\  & =1.\\end{aligned}\n$$\n\n- Statement III is true. Since ${1}_{A\\,\\cup \\,B}\\,(t)=1,$ we conclude that $t$ belongs to $A\\cup B.$\n\nTherefore, the correct answer is \"I and III only.\""}]}
