#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186093249} :activity/id #uuid "32f8f5ef-15f3-5904-a759-74a6bc8770e8" :activity/scope {:db/id #edb/ref 17592186048808 :topic/id #uuid "c1647abf-57b4-5851-a828-2952c6947148" :topic/math-academy-id 948} :activity/steps [{:db/id #edb/ref 17592186093249 :step/content {:db/id #edb/ref 17592186093495 :tutorial/content "An **indicator function** is a function that maps elements from a set to the values $0$ or $1,$ depending on whether the element belongs to a specified subset.\n\nThe indicator function is designed to \"indicate\" whether an element is a member of a subset.\n\nMore specifically, consider a universal set $X.$ Then, the indicator function of a set $A \\subseteq X$ is the function\n\n![](images/af/af268dd04b20dde1e7216e63839f309f572615b59f57f81515cd2e7998c1f45d.svg)\n\nFor example, let $A = \\{ a,c \\}$ be a subset of the universal set $X=\\{ a,b,c,d,e \\}.$ Then, the indicator function $\\mathbf{1}_A(x)$ of $A$ is the following:\n\n![](images/7b/7b1ec0a80d5ec7dc9974d2ebaf6984e94faa00d73ec624dc48d56addbe701ee1.png)\n\n \n\nNotice that the elements $a$ and $c$ (the elements of our subset) are mapped to $1,$ and all other elements are mapped to $0.$" :tutorial/id #uuid "20986866-6719-520f-b707-cf6b26e3823b" :tutorial/math-academy-id 8006 :tutorial/title "Introduction"} :step/id #uuid "a653fede-ccbc-5f2f-b061-934db5fa0d21" :step/math-academy-id 46177 :step/next {:db/id #edb/ref 17592186093250}} {:db/id #edb/ref 17592186093250 :step/content {:db/id #edb/ref 17592186092338 :knowledge-point/canonical-example {:db/id #edb/ref 17592186091944 :question/id #uuid "2acf7f4e-1d5d-56e5-8478-9611a3afde73" :question/math-academy-id "e-12766"} :knowledge-point/id #uuid "2e380013-0002-5a17-bbf7-e9ce89e6331d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049534}] :knowledge-point/questions [{:db/id #edb/ref 17592186092600} {:db/id #edb/ref 17592186092601} {:db/id #edb/ref 17592186409889} {:db/id #edb/ref 17592186409892}] :knowledge-point/title "Identifying the Indicator Function of a Set"} :step/id #uuid "7390f8dd-a510-5070-8b26-59db8798d82a" :step/math-academy-id 46178 :step/next {:db/id #edb/ref 17592186093252}} {:db/id #edb/ref 17592186093251 :step/content {:db/id #edb/ref 17592186092339 :knowledge-point/canonical-example {:db/id #edb/ref 17592186091945 :question/id #uuid "cc45cc10-61e3-5cb7-babc-7253a5158c4b" :question/math-academy-id "e-12767"} :knowledge-point/id #uuid "bd399539-33cf-5738-b970-fcc6c1d919c8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048899} {:db/id #edb/ref 17592186049900} {:db/id #edb/ref 17592186051033}] :knowledge-point/questions [{:db/id #edb/ref 17592186092602} {:db/id #edb/ref 17592186092603} {:db/id #edb/ref 17592186092604} {:db/id #edb/ref 17592186376157} {:db/id #edb/ref 17592186409888} {:db/id #edb/ref 17592186409890} {:db/id #edb/ref 17592186409891} {:db/id #edb/ref 17592186409893}] :knowledge-point/title "Using Properties of Indicator Functions"} :step/id #uuid "d6d114da-0075-5e74-9dfb-15ec23ed1bd3" :step/math-academy-id 46181} {:db/id #edb/ref 17592186093252 :step/content {:db/id #edb/ref 17592186093496 :tutorial/content "Recall that the indicator function of a set $A \\subseteq X$ is the function\n\n![](images/74/7408ad6ce2700ac59d8e6a78c511ba2b51551e6b9d039ee7e2f8548f4177802e.svg)\n\nTherefore, the indicator function of the complement $\\overline{A}$ is given by \n\n![](images/de/de1a51c00e16d836fde350e0936fb9cb63124c72b49174210be3e6f6faa152da.svg)\n\nThis means that the indicator function of $A$ and its complement are related as follows:\n\n$$\n\\begin{aligned}{1}_{\\overset{―}{A}}\\,(x) & =1-{1}_{A}(x)\\end{aligned}\n$$\n\nSimilarly, the indicator functions of $A \\cap B$ and union $A \\cup B$ can be expressed through the indicator functions of $A$ and $B.$\n\n- For the indicator function of the *intersection*, we have: \n\n$$\n\\begin{aligned}{1}_{A\\,\\cap \\,B}\\,(x) & =min{{1}_{A}(x),{1}_{B}(x)} \\\\  & ={1}_{A}(x)\\cdot {1}_{B}(x)\\end{aligned}\n$$\n\n- For the indicator function of the *union*, we have \n\n$$\n\\begin{aligned}{1}_{A\\,\\cup \\,B}\\,(x) & =max{{1}_{A}(x),{1}_{B}(x)} \\\\  & ={1}_{A}(x)+{1}_{B}(x)-{1}_{A}(x)\\cdot {1}_{B}(x).\\end{aligned}\n$$\n\nWe can prove these results by splitting them into cases." :tutorial/id #uuid "a111c445-39e3-5ddd-8272-48ef3795a3b0" :tutorial/math-academy-id 8007 :tutorial/title "Properties of Indicator Functions"} :step/id #uuid "d765dcbb-6e69-5616-b71c-25e2c514aa3c" :step/math-academy-id 46185 :step/next {:db/id #edb/ref 17592186093251}}] :activity/title "Indicator Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186092441}]}
