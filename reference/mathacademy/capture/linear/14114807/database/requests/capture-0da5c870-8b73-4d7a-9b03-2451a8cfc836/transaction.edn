-55fd-a1de-9d7b3f028b3c" "answer-fb44f87f-b177-51f3-96ce-7df17d89d7db" "answer-a8709f24-d2a8-5df8-9964-5dbb01efd971" "answer-fa079c9e-2ffa-5770-8242-48897473068d" "answer-43e6f09d-b15b-583f-b322-ed2cb2110fd7"] :db/ensure [:answer-field/validate]} {:db/id "answer-4dbbb73e-91a8-55fd-a1de-9d7b3f028b3c" :answer/id #uuid "4dbbb73e-91a8-55fd-a1de-9d7b3f028b3c" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-fb44f87f-b177-51f3-96ce-7df17d89d7db" :answer/id #uuid "fb44f87f-b177-51f3-96ce-7df17d89d7db" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-a8709f24-d2a8-5df8-9964-5dbb01efd971" :answer/id #uuid "a8709f24-d2a8-5df8-9964-5dbb01efd971" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-fa079c9e-2ffa-5770-8242-48897473068d" :answer/id #uuid "fa079c9e-2ffa-5770-8242-48897473068d" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-43e6f09d-b15b-583f-b322-ed2cb2110fd7" :answer/id #uuid "43e6f09d-b15b-583f-b322-ed2cb2110fd7" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-a8a05322-998a-5d01-8b89-68a8bc93dd0f" :question/id #uuid "a8a05322-998a-5d01-8b89-68a8bc93dd0f" :question/math-academy-id "q-174380" :question/problem "Given that ${1}_{A}(0)=0,$ which of the following statements about $\\overset{―}{A}$ are true?\n\n- ${1}_{\\overset{―}{A}}\\,(0)=1$\n- ${1}_{\\overset{―}{A}}\\,(0)=0$\n- $0\\in \\overset{―}{A}$\n\n*Hint: ${1}_{A}$ denotes the indicator function of the set $A$ and ${1}_{\\overset{―}{A}}$ denotes the indicator function of the complement of $A.$*" :question/worked-solution "Recall that the indicator functions of $\\overset{―}{A},$ $A\\cap B,$ and $A\\cup B$ have the following properties:\n\n$$\n\\begin{aligned}{1}_{\\overset{―}{A}}\\,(x) & =1-{1}_{A}(x) \\\\ {1}_{A\\,\\cap \\,B}\\,(x) & =min{{1}_{A}(x),{1}_{B}(x)} \\\\ {1}_{A\\,\\cup \\,B}\\,(x) & =max{{1}_{A}(x),{1}_{B}(x)}\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true while statement II is false. We have\n\n$$\n\\begin{aligned}{1}_{\\overset{―}{A}}\\,(0) & =1-{1}_{A}(0) \\\\  & =1-0 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement III is true. Since ${1}_{\\overset{―}{A}}\\,(0)=1,$ we conclude that $0$ belongs to $\\overset{―}{A}.$\n\nTherefore, the correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-83594dda-c004-5625-a3b0-3d790a7941a5"] :db/ensure [:question/validate]} {:db/id "answer-field-83594dda-c004-5625-a3b0-3d790a7941a5" :answer-field/id #uuid "83594dda-c004-5625-a3b0-3d790a7941a5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a84e75b5-3a80-5752-b9ec-b71303a5aec6" :answer-field/choices ["answer-a84e75b5-3a80-5752-b9ec-b71303a5aec6" "answer-e97f4d7f-aabf-5567-8431-321ca8787569" "answer-4068f7e2-a0ab-5191-84b6-5c4067339274" "answer-618b2a8e-572b-5ad5-b3c0-c1a42f8e3e99" "answer-06dd1182-e612-5525-b9de-c12d2d05c3e6"] :db/ensure [:answer-field/validate]} {:db/id "answer-a84e75b5-3a80-5752-b9ec-b71303a5aec6" :answer/id #uuid "a84e75b5-3a80-5752-b9ec-b71303a5aec6" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-e97f4d7f-aabf-5567-8431-321ca8787569" :answer/id #uuid "e97f4d7f-aabf-5567-8431-321ca8787569" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-4068f7e2-a0ab-5191-84b6-5c4067339274" :answer/id #uuid "4068f7e2-a0ab-5191-84b6-5c4067339274" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-618b2a8e-572b-5ad5-b3c0-c1a42f8e3e99" :answer/id #uuid "618b2a8e-572b-5ad5-b3c0-c1a42f8e3e99" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-06dd1182-e612-5525-b9de-c12d2d05c3e6" :answer/id #uuid "06dd1182-e612-5525-b9de-c12d2d05c3e6" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-09ca95e9-e7fd-5d14-80c3-ab64bc50a23d" :question/id #uuid "09ca95e9-e7fd-5d14-80c3-ab64bc50a23d" :question/math-academy-id "q-174385" :question/problem "Given that ${1}_{A}(q)=0,$ which of the following statements about $\\overset{―}{A}$ are true?\n\n- ${1}_{\\overset{―}{A}}\\,(q)=1$\n- ${1}_{\\overset{―}{A}}\\,(q)=0$\n- $q\\in \\overset{―}{A}$\n\n*Hint: ${1}_{A}$ denotes the indicator function of the set $A$ and ${1}_{\\overset{―}{A}}$ denotes the indicator function of the complement of $A.$*" :question/worked-solution "Recall that the indicator functions of $\\overset{―}{A},$ $A\\cap B,$ and $A\\cup B$ have the following properties:\n\n$$\n\\begin{aligned}{1}_{\\overset{―}{A}}\\,(x) & =1-{1}_{A}(x) \\\\ {1}_{A\\,\\cap \\,B}\\,(x) & =min{{1}_{A}(x),{1}_{B}(x)} \\\\ {1}_{A\\,\\cup \\,B}\\,(x) & =max{{1}_{A}(x),{1}_{B}(x)}\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true while statement II is false. We have\n\n$$\n\\begin{aligned}{1}_{\\overset{―}{A}}\\,(q) & =1-{1}_{A}(q) \\\\  & =1-0 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement III is true. Since ${1}_{\\overset{―}{A}}\\,(q)=1,$ we conclude that $q$ belongs to $\\overset{―}{A}.$\n\nTherefore, the correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-924887b9-029f-5ae2-880f-5a02a4c501f0"] :db/ensure [:question/validate]} {:db/id "answer-field-924887b9-029f-5ae2-880f-5a02a4c501f0" :answer-field/id #uuid "924887b9-029f-5ae2-880f-5a02a4c501f0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b3660aee-3664-5309-b332-b14dc695c7ce" :answer-field/choices ["answer-b3660aee-3664-5309-b332-b14dc695c7ce" "answer-14622146-9357-5002-bb58-2d5df436755d" "answer-3e0876cb-849b-532e-9b46-8b0f0fdbeb1e" "answer-d0708573-229b-5e9d-a525-9d080007c898" "answer-6ee506d6-f345-54fa-9845-d354cdc4d92e"] :db/ensure [:answer-field/validate]} {:db/id "answer-b3660aee-3664-5309-b332-b14dc695c7ce" :answer/id #uuid "b3660aee-3664-5309-b332-b14dc695c7ce" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-14622146-9357-5002-bb58-2d5df436755d" :answer/id #uuid "14622146-9357-5002-bb58-2d5df436755d" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-3e0876cb-849b-532e-9b46-8b0f0fdbeb1e" :answer/id #uuid "3e0876cb-849b-532e-9b46-8b0f0fdbeb1e" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-d0708573-229b-5e9d-a525-9d080007c898" :answer/id #uuid "d0708573-229b-5e9d-a525-9d080007c898" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-6ee506d6-f345-54fa-9845-d354cdc4d92e" :answer/id #uuid "6ee506d6-f345-54fa-9845-d354cdc4d92e" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186093495 :tutorial/content "An **indicator function** is a function that maps elements from a set to the values $0$ or $1,$ depending on whether the element belongs to a specified subset.\n\nThe indicator function is designed to \"indicate\" whether an element is a member of a subset.\n\nMore specifically, consider a universal set $X.$ Then, the indicator function of a set $A \\subseteq X$ is the function\n\n![](images/af/af268dd04b20dde1e7216e63839f309f572615b59f57f81515cd2e7998c1f45d.svg)\n\nFor example, let $A = \\{ a,c \\}$ be a subset of the universal set $X=\\{ a,b,c,d,e \\}.$ Then, the indicator function $\\mathbf{1}_A(x)$ of $A$ is the following:\n\n![](images/7b/7b1ec0a80d5ec7dc9974d2ebaf6984e94faa00d73ec624dc48d56addbe701ee1.png)\n\n \n\nNotice that the elements $a$ and $c$ (the elements of our subset) are mapped to $1,$ and all other elements are mapped to $0.$" :db/ensure [:tutorial/validate]} {:db/id 17592186093496 :tutorial/content "Recall that the indicator function of a set $A \\subseteq X$ is the function\n\n![](images/74/7408ad6ce2700ac59d8e6a78c511ba2b51551e6b9d039ee7e2f8548f4177802e.svg)\n\nTherefore, the indicator function of the complement $\\overline{A}$ is given by \n\n![](images/de/de1a51c00e16d836fde350e0936fb9cb63124c72b49174210be3e6f6faa152da.svg)\n\nThis means that the indicator function of $A$ and its complement are related as follows:\n\n$$\n\\begin{aligned}{1}_{\\overset{―}{A}}\\,(x) & =1-{1}_{A}(x)\\end{aligned}\n$$\n\nSimilarly, the indicator functions of $A \\cap B$ and union $A \\cup B$ can be expressed through the indicator functions of $A$ and $B.$\n\n- For the indicator function of the *intersection*, we have: \n\n$$\n\\begin{aligned}{1}_{A\\,\\cap \\,B}\\,(x) & =min{{1}_{A}(x),{1}_{B}(x)} \\\\  & ={1}_{A}(x)\\cdot {1}_{B}(x)\\end{aligned}\n$$\n\n- For the indicator function of the *union*, we have \n\n$$\n\\begin{aligned}{1}_{A\\,\\cup \\,B}\\,(x) & =max{{1}_{A}(x),{1}_{B}(x)} \\\\  & ={1}_{A}(x)+{1}_{B}(x)-{1}_{A}(x)\\cdot {1}_{B}(x).\\end{aligned}\n$$\n\nWe can prove these results by splitting them into cases." :db/ensure [:tutorial/validate]} {:db/id 17592186092441 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
