  "html": "<div id=\"questionExplanation-141143\" class=\"questionExplanation\" style=\"display: block;\"><p><style>\ndiv.graphic {\n    margin-top: 0px;\n    margin-bottom: 0px;\n    text-align: center;\n}\n</style></p>\n<table rules=\"all\" cellpadding=\"10\" align=\"center\" width=\"600px\" style=\"border:1px solid black; margin: auto; margin-bottom: 4mm; margin-top: 4mm\">\n    <tbody><tr>\n        <th bgcolor=\"#D6EAF8\" style=\"text-align: center;\">Multiplicity</th>\n        <th bgcolor=\"#D6EAF8\" style=\"text-align: center;\">Sketch</th>\n        <th bgcolor=\"#D6EAF8\" style=\"text-align: center;\">Sketch</th>\n    </tr>\n    <tr>\n        <td width=\"200px\" height=\"120px\" style=\"font-size:10pt;\" align=\"center\">  <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"68\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn></math></mjx-assistive-mml></mjx-container> <br><br> (Simple Root) </td>\n        <td width=\"200px\" style=\"font-size:10pt;\">\n\n<div id=\"graphic-4daf16066dde35728116840bf83a4714\" class=\"graphic\"><img src=\"/graphics/4daf16066dde35728116840bf83a4714\"></div>\n\n        </td>\n<td width=\"200px\" height=\"120px\" style=\"font-size:10pt;\" align=\"center\">\n\n<div id=\"graphic-ce432211e7ace0b56d79f5dbd4200845\" class=\"graphic\"><img src=\"/graphics/ce432211e7ace0b56d79f5dbd4200845\"></div>\n\n        </td>\n    </tr>\n    <tr>\n        <td height=\"120px\" style=\"font-size:10pt;\" align=\"center\">  <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"69\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mj