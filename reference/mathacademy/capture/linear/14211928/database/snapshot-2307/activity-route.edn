#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186524051} :activity/id #uuid "37d0b1d2-0d33-5132-981f-7237e41ecb79" :activity/steps [{:db/id #edb/ref 17592186524042 :step/content {:db/id #edb/ref 17592186064767 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1360334-a082-5417-83d5-2f1fc4425ff7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186062660} {:answer/id #uuid "b6b89ca9-9218-58dc-8735-9c3820ef581e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "70" :db/id #edb/ref 17592186062661} {:answer/id #uuid "f0d0ca08-c106-52c1-9b92-da11f70a0f8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7.7" :db/id #edb/ref 17592186062662} {:answer/id #uuid "4b966a5a-d2fe-56b3-b89a-b736837412ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-70" :db/id #edb/ref 17592186062663} {:answer/id #uuid "60902241-a53a-5be7-9e39-aab76a57a6a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186062664}] :answer-field/correct {:db/id #edb/ref 17592186062664} :answer-field/id #uuid "c852b4bf-048c-5a02-b8f9-be1a2a8e19e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186062659}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f2fe8ba6-2f65-5ad0-a08b-c3655f4cc3dc" :question/math-academy-id "q-43025" :question/problem "$10\\cdot (-0.7)=$" :question/worked-solution "We have a product of a positive number $(10)$ and a negative number $(-0.7).$ So the product will be negative:\n\n$$\n10\\cdot (-0.7)=-\\boxed{}\n$$\n\nNow, to compute the number that goes in the box, we multiply $10$ by $0.7$ without any signs: $10\\cdot 0.7=7.$ So, we get\n\n$$\n10\\cdot (-0.7)=-7.\n$$"} :step/id #uuid "07db862f-07ff-550f-b7db-a94183dc2e6c"} {:db/id #edb/ref 17592186524048 :step/content {:db/id #edb/ref 17592186523984 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39b063a5-a3ee-5ac4-af1b-7e3f2eb8d73a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186523374} {:answer/id #uuid "4b6b86f9-95e1-5078-964a-812f65e7c86f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186523407} {:answer/id #uuid "55a0a46c-e48c-5d8f-b839-aaeda5150bb6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186523428} {:answer/id #uuid "61025d0a-c07b-5a36-acca-f1913c26af7d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186523448} {:answer/id #uuid "7005b21d-6fc3-5fa8-a675-951cc13b9a8d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186523484}] :answer-field/correct {:db/id #edb/ref 17592186523448} :answer-field/id #uuid "f80727cc-5fda-5d7f-a94d-a0834b4aa2eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186523914}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8ba50b21-9ef4-5151-a99b-e87a06229c81" :question/math-academy-id "q-128553" :question/problem "Which of the following are natural numbers?\n\nI. $-1$\n\nII. $0$\n\nIII. $11$" :question/worked-solution "The natural numbers consist of all positive whole numbers.\n\n$$\n1,\\,2,\\,3,\\,4,\\,5,…\n$$\n\nOf the given numbers, $11$ is a natural number, but $-1$ and $0$ are not.\n\nTherefore, the correct answer is \"III only.\""} :step/id #uuid "315ebbfd-2ea0-5ceb-a85f-0680158355d3" :step/next {:db/id #edb/ref 17592186524076}} {:db/id #edb/ref 17592186524051 :step/content {:db/id #edb/ref 17592186523969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e7cf7ba-68f6-5297-8ecb-5cbcb4319093" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186523316} {:answer/id #uuid "4ffcb838-2f8f-514c-916d-7ecc0e14a9fd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186523416} {:answer/id #uuid "55b429c7-69d9-5bf9-8c81-7e51c17241c7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186523429} {:answer/id #uuid "935a874d-2c69-5a73-a09e-1d948d77d34e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186523565} {:answer/id #uuid "960bdafc-7f50-588d-9837-9eadd76e45a4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186523568}] :answer-field/correct {:db/id #edb/ref 17592186523316} :answer-field/id #uuid "e6aac269-3443-59ce-abcc-30a3070cf5de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186523906}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "76598254-2f11-555f-8a0a-b51f61e7748b" :question/math-academy-id "q-350260" :question/problem "Olivia and Harper are musicians. In the previous season, the decimal proportion of Olivia’s performances that were solos was $0.55,$ while $40%$ of Harper’s performances were solos. \n\nWhich of the following statements are true?\n\nI. Less than half of Olivia's performances were solos.\n\nII. More than half of Harper's performances were solos.\n\nIII. Olivia had a greater percentage of solo performances compared to Harper." :question/worked-solution "Let's examine our statements in turn.\n\n- Statement I is false. Indeed, since \n\n$$\n0.55>0.5,\n$$\n\nmore than half of Olivia's performances were solos.\n\n- Statement II is false. Notice that \n\n$$\n40%<50%.\n$$\n\nSo, less than half of Harper's performances were solos.\n\n- Statement III is true. We can compare $0.55$ and $40%$ by converting the decimal into a percent. \n\nTo do this, we multiply it by $100:$\n\n$$\n0.55\\times 100=55%\n$$\n\nSince $55%>40%,$ Olivia had a **greater** percentage of solo performances compared to Harper.\n\nTherefore, the correct answer is \"III only\"."} :step/id #uuid "3962c57b-8223-5237-84cb-966ed91f92a5" :step/next {:db/id #edb/ref 17592186524048}} {:db/id #edb/ref 17592186524069 :step/content {:db/id #edb/ref 17592186523979 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06edf1c7-c8bc-581d-90d0-594bd44549ca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Left quadrant" :db/id #edb/ref 17592186523270} {:answer/id #uuid "2c6172b4-b1a0-52e6-b911-311e77e86cfd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Fourth quadrant" :db/id #edb/ref 17592186523343} {:answer/id #uuid "65b1977d-52f0-5c1d-90ff-8d07b0a7ec07" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Third quadrant" :db/id #edb/ref 17592186523464} {:answer/id #uuid "73c23cad-d442-5454-b829-add3e2e417c0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Second quadrant" :db/id #edb/ref 17592186523491} {:answer/id #uuid "d3d529c8-ca6c-5c5f-b5f1-1f054c538fc4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "First quadrant" :db/id #edb/ref 17592186523700}] :answer-field/correct {:db/id #edb/ref 17592186523464} :answer-field/id #uuid "75c412c0-32da-548d-bf84-4a15a64dd939" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186523847}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "84a619bd-064d-5238-b773-07631be56d2c" :question/math-academy-id "q-101924" :question/problem "![](images/72/72cfa1c8918f9f50b2426eb05ac16eed5605f557b59870aa914d07148d782676.png)\n\nA point $Q$ is shown on the axis above. To which quadrant does it belong?" :question/worked-solution "We label the quadrants as follows:\n\n![](images/0a/0a6e04eba0886d64c1a36b259c7a3c17afb9a86ad5169e28f476fff2d31c68b1.png)\n\nSince $Q$ is placed below and to the left of the origin, it lies in quadrant $\\text{III},$ which is the third quadrant."} :step/id #uuid "7310a483-c40f-5b26-a7a9-915a4dc0418c" :step/next {:db/id #edb/ref 17592186524089}} {:db/id #edb/ref 17592186524076 :step/content {:db/id #edb/ref 17592186524035 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00eef7cd-53a9-593e-a267-c9da06c25bea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{7}" :db/id #edb/ref 17592186523252} {:answer/id #uuid "1bbec767-e533-5c10-9e12-149088192f95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186523309} {:answer/id #uuid "76154324-9a81-5b0d-a958-23841c6c7f0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{9}" :db/id #edb/ref 17592186523495} {:answer/id #uuid "dcdebc50-1a9d-5401-81bd-abe973d6d489" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{7}{9}" :db/id #edb/ref 17592186523716} {:answer/id #uuid "f24d6aa3-5802-57f1-bbdd-fb4785ed51d4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Undefined" :db/id #edb/ref 17592186523758}] :answer-field/correct {:db/id #edb/ref 17592186523309} :answer-field/id #uuid "7693271f-4341-5f7a-9e8f-486b996d263b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186523848}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f162fba1-f09f-5af9-a84b-e3875292cc2e" :question/math-academy-id "q-128441" :question/problem "What is $0÷(-\\frac{9}{7}).$" :question/worked-solution "Zero divided by any number (other than zero) equals zero. Therefore, \n\n$$\n0÷(-\\frac{9}{7})=0.\n$$"} :step/id #uuid "8e8b3083-de9c-5c24-abbc-5972258cafe1" :step/next {:db/id #edb/ref 17592186524092}} {:db/id #edb/ref 17592186524089 :step/content {:db/id #edb/ref 17592186074427 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81dbd7ab-a3c7-5420-8d68-cbbe8c450d53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186072801} {:answer/id #uuid "8a5b71c5-d270-5894-9b81-6a0a2955a55a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186072802} {:answer/id #uuid "e947dd8f-4a50-56fb-abdf-d0e82a648295" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186072803} {:answer/id #uuid "4dc1b04c-8a81-522e-a54b-adf71780b908" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186072804} {:answer/id #uuid "73851527-31ca-5227-8c70-479e54da0592" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186072805}] :answer-field/correct {:db/id #edb/ref 17592186072804} :answer-field/id #uuid "8a22d274-51aa-5a89-96e8-f370b9ff649d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186072800}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cd61932e-b6ca-50a7-a5cd-e2df3462046c" :question/math-academy-id "q-60291" :question/problem "What is missing in the following sentence?\n\nMark and James shared slices of pizza in the ratio of $2:6$, so there are $\\boxed{}$ slices of Mark's share for each slice of James' share." :question/worked-solution "We can rewrite the ratio as a fraction, as follows:\n\n$$\n\\frac{2}{6}\n$$\n\nWe can simplify the fraction by dividing the numerator and denominator by $2$:\n\n$$\n\\frac{2}{6}=\\frac{2÷2}{6÷2}=\\frac{1}{3}\n$$\n\nThat means that there are $\\frac{1}{3}$ slices of Mark's share for each slice of James' share."} :step/id #uuid "b52ce16c-4d5c-526a-b072-8ba9e02db153" :step/next {:db/id #edb/ref 17592186524099}} {:db/id #edb/ref 17592186524092 :step/content {:db/id #edb/ref 17592186523991 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8de20a7f-62f7-51e8-90de-227ff7c98d0f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-25" :db/id #edb/ref 17592186523549}] :answer-field/correct {:db/id #edb/ref 17592186523549} :answer-field/id #uuid "5d9b0439-1e80-5d6a-bc2b-6811b4343b6f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186523836}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9d2a64c1-9bb3-5573-99a2-5c763e9021bd" :question/math-academy-id "q-236833" :question/problem "$23-48=${{field-1}}" :question/worked-solution "Since $48$ is larger than $23,$ the answer will be negative.\n\nWe start by solving an easier problem:\n\n$$\n48-23\n$$\n\nNext, we carry out the subtraction:\n\n$$\n\\begin{aligned} &  & \\,\\,\\, & \\,\\,\\, \\\\  &  & \\,\\,\\,4\\,\\,\\, & \\,\\,\\,8\\,\\,\\, \\\\ \\,\\,\\,\\,-\\,\\,\\,\\, &  & \\,\\,\\,2\\,\\,\\, & \\,\\,\\,3\\,\\,\\, \\\\  &  & \\,\\,\\,2\\,\\,\\, & \\,\\,\\,5\\,\\,\\,\\end{aligned}\n$$\n\nSo, we have\n\n$$\n48-23=25.\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n23-48=-25.\n$$"} :step/id #uuid "bf028505-d785-547c-b2c1-3e538df6ea05" :step/next {:db/id #edb/ref 17592186524095}} {:db/id #edb/ref 17592186524095 :step/content {:db/id #edb/ref 17592186524017 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ddb27d9-bf9f-58a3-8b13-e2c911a46068" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5:6" :db/id #edb/ref 17592186523315} {:answer/id #uuid "6109d19e-7b42-5696-b0d8-eb8bbfdb9805" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2:3" :db/id #edb/ref 17592186523449} {:answer/id #uuid "64af21c4-1578-5f21-ba90-bcbd5688e962" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1:4" :db/id #edb/ref 17592186523460} {:answer/id #uuid "d399264a-ea27-5301-8009-d5f8653eb057" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3:5" :db/id #edb/ref 17592186523699} {:answer/id #uuid "e4f770e5-ee30-51e6-a12e-840e5446d7c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1:2" :db/id #edb/ref 17592186523734}] :answer-field/correct {:db/id #edb/ref 17592186523734} :answer-field/id #uuid "842c48ea-56dd-5cc6-aceb-60fc8c45526c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186523856}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d65e17ea-2def-584a-904b-9397e33a3b17" :question/math-academy-id "q-59888" :question/problem "![](images/dd/dd9943f680dedd516084909e74d769e7605c7180f04d55b3c12113834bb47136.png)\n\nWhat ratio describes the number of rectangles to the total number of shapes?" :question/worked-solution "We count the number of rectangles. We see that there are $3$ rectangles.\n\nWe count the total number of shapes. We see that there are $6$ shapes in total.\n\nSo the ratio of rectangles to total shapes is $3:6.$\n\nWe can simplify this ratio by dividing both numbers in a ratio by $3$:\n\n$$\n\\begin{aligned}\\,\\,3 &  & : & \\,\\,\\,\\, & \\,\\,\\,6 &  \\\\ \\,\\,↓÷\\,\\,3 &  &  &  & \\,\\,\\,↓÷\\,\\,3 &  \\\\ \\,\\,1 &  & : &  & \\,\\,\\,2 & \\end{aligned}\n$$\n\nTherefore, the ratio of rectangles to the total shapes is $1:2.$"} :step/id #uuid "c3f47e54-d0df-5184-8c1d-5c275975c07c" :step/next {:db/id #edb/ref 17592186524105}} {:db/id #edb/ref 17592186524099 :step/content {:db/id #edb/ref 17592186523999 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1af6ee9f-ae42-51c5-b7de-ef2b565520ac" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186523308} {:answer/id #uuid "28347767-b666-52fa-a9d8-5e24528f5b0a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186523336} {:answer/id #uuid "8d793313-b695-5fb8-9045-3b51e59571cf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186523548} {:answer/id #uuid "931aa220-ad5f-5920-8624-85dee5435de8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186523564} {:answer/id #uuid "e266b9f7-eb22-5300-a9a9-5cb7a739a5ee" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186523727}] :answer-field/correct {:db/id #edb/ref 17592186523308} :answer-field/id #uuid "7f142419-33c2-52ed-b329-1e3e4574c8cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186523853}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a8e40c21-fa80-544c-8d3a-4f03c8add411" :question/math-academy-id "q-85400" :question/problem "Which of the following numbers are divisible by $9?$\n\nI. $7\\,050\\,113$\n\nII. $5\\,119\\,232$\n\nIII. $14\\,624\\,100$" :question/worked-solution "A number is divisible by $9$ if the sum of its digits is divisible by $9.$\n\n- The sum of the digits of $7\\,050\\,113$ is\n\n$$\n7+0+5+0+1+1+3=17,\n$$\n\nwhich is *not* divisible by $9.$ So, $7\\,050\\,113$ is *not* divisible by $9.$\n\n- The sum of the digits of $5\\,119\\,232$ is\n\n$$\n5+1+1+9+2+3+2=23,\n$$\n\nwhich is *not* divisible by $9.$ So, $5\\,119\\,232$ is *not* divisible by $9.$\n\n- The sum of the digits of $14\\,624\\,100$ is\n\n$$\n1+4+6+2+4+1+0+0=18,\n$$\n\nwhich is divisible by $9.$ So, $14\\,624\\,100$ is divisible by $9.$\n\nTherefore, the correct answer is \"llI only.\""} :step/id #uuid "d6658c9b-d996-55e1-8b94-2b786d9fa9ac" :step/next {:db/id #edb/ref 17592186524042}} {:db/id #edb/ref 17592186524105 :step/content {:db/id #edb/ref 17592186523965 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce077c8b-a643-584e-9991-1ba8f0a61be7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p-9" :db/id #edb/ref 17592186523685}] :answer-field/correct {:db/id #edb/ref 17592186523685} :answer-field/id #uuid "cd8abb59-1066-5acc-8b33-5e97fe06f21e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186523891}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "71607034-c109-5c32-ac61-2615649524b9" :question/math-academy-id "q-184137" :question/problem "Translate the following phrase into an algebraic expression: \"Nine fewer than a number.\"\n\nUse the letter $p$ to represent the unknown number.\n\n{{field-1}}" :question/worked-solution "If we denote our number by $p,$ then the phrase \"nine fewer than a number\" can be written as \n\n$$\np-9.\n$$"} :step/id #uuid "f12ef982-156d-583a-a725-578271e47f6a" :step/next {:db/id #edb/ref 17592186524069}}] :activity/title "Quiz 4" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186523239}]}
