    "q-25388": {
      "dom_id": "step-q25388",
      "name": "Question 2",
      "problem": "Which of the following is equivalent to ${({p}^{0}{q}^{-3})}^{-3}?$",
      "worked_solution": "First, we simplify the expression inside the parenthesis and then we apply the power rule\n\n$$\n\\begin{aligned}{({p}^{0}{q}^{-3})}^{-3} & = \\\\ {(1\\cdot {q}^{-3})}^{-3} & = \\\\ {({q}^{-3})}^{-3} & = \\\\ {q}^{(-3)(-3)} & = \\\\ {q}^{9}\\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-25388-a",
              "type": "math",
              "value": "{q}^{3}",
              "html": "<mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"10\" style=\"font-size: 119.6%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45E TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.363em; margin-left: 0.051em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn></mjx-script></mjx-msup></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>q</mi><mn>3</mn></msup></math></mjx-assistive-mml></mjx-container>"
