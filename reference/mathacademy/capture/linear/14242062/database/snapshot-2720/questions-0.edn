#{[{:db/id #edb/ref 17592186088002 :knowledge-point/_questions [{:db/id #edb/ref 17592186087711 :knowledge-point/id #uuid "daa37544-c4ec-5b8b-91a5-ccf5ee8f50d6" :knowledge-point/title "Converting an Arbitrary Line to Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58cdbd56-5509-538e-b603-fef18e91906b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x=-7y+10" :db/id #edb/ref 17592186559247} {:answer/id #uuid "878172e5-39a1-5579-ac73-a152016732a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x+7y=-10" :db/id #edb/ref 17592186559354} {:answer/id #uuid "9229895d-0594-56eb-b6bb-8200027ca079" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x+7y=10" :db/id #edb/ref 17592186559378} {:answer/id #uuid "c9603c17-6eb9-5ed3-8741-ab4249868c6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x+7y-10=0" :db/id #edb/ref 17592186559507} {:answer/id #uuid "f550dedc-bf0e-5266-888c-3e215c48f4ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5x+7y=10" :db/id #edb/ref 17592186559619}] :answer-field/correct {:answer/id #uuid "9229895d-0594-56eb-b6bb-8200027ca079" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x+7y=10" :db/id #edb/ref 17592186559378} :answer-field/id #uuid "03d1386f-01a8-5fc7-a5f6-2fb52b986e1b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084746}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fa966eb0-9844-5c98-a111-46249d704582" :question/math-academy-id "q-13338" :question/problem "Write $-10+7y+5x=0$ in standard form." :question/worked-solution "Our goal is to write the equation in the form $ax+by=c,$ where $a,b,$ and $c$ are integers with no common factors and $a\\ge 0.$\n\nWe begin by moving all of the variables to the left-hand side and all of the constants to the right-hand side. This gives\n\n$$\n5x+7y=10.\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a\\ge 0.$ So we are done!\n\nThe standard form of the line is $5x+7y=10.$"}] [{:db/id #edb/ref 17592186559871 :knowledge-point/_questions [{:db/id #edb/ref 17592186073726 :knowledge-point/id #uuid "d34e60c9-710b-50ca-a491-adc2b50e6edc" :knowledge-point/title "Problem Solving Using the Ratio of Two Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10817ad1-584a-5cae-9e74-85b7d8b67207" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$32$ dollars" :db/id #edb/ref 17592186559057} {:answer/id #uuid "4fd4acc3-a923-5db9-8ff0-2bb877f1bb6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$24$ dollars" :db/id #edb/ref 17592186559221} {:answer/id #uuid "73f566d9-4d80-5e41-bf04-bed2d3dceb46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$30$ dollars" :db/id #edb/ref 17592186559307} {:answer/id #uuid "802803f5-5ea3-5767-b470-c0bd3aa61b84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$35$ dollars" :db/id #edb/ref 17592186559335} {:answer/id #uuid "d5445e47-0caa-523d-a710-3fc1a4dce491" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$27$ dollars" :db/id #edb/ref 17592186559540}] :answer-field/correct {:answer/id #uuid "d5445e47-0caa-523d-a710-3fc1a4dce491" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$27$ dollars" :db/id #edb/ref 17592186559540} :answer-field/id #uuid "e291dcc7-8c1e-5891-b89d-054f30fdf260" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559757}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e0a4a8a4-751d-5872-ad1c-8d3477e4c365" :question/math-academy-id "q-148287" :question/problem "Peter pays $\\frac{3}{5}$ of a dollar for $\\frac{1}{15}$ of a pound of pumpkin seeds. How much should he pay for $3$ pounds of seeds?" :question/worked-solution "To determine how much Peter should pay for $3$ pounds of seeds, we first find the unit rate of dollars per pound and then multiply it by $3$ pounds.\n\nTo find the unit rate of dollars per pound, we divide the number of dollars, $\\frac{3}{5},$ by the number of pounds, $\\frac{1}{15},$ as follows:\n\n$$\n\\frac{3}{5}÷\\frac{1}{15}\n$$\n\nDividing one fraction by another is equivalent to multiplying the fraction by the reciprocal of the second fraction:\n\n$$\n\\begin{aligned}\\frac{3}{5}÷\\frac{1}{15} & =\\frac{3}{5}\\times \\frac{15}{1} \\\\  & =\\frac{3\\times 15}{5\\times 1} \\\\  & =\\frac{45}{5} \\\\  & =45÷5 \\\\  & =9\\end{aligned}\n$$\n\nSo, the unit rate is $9$ dollars per pound. To determine how much Peter should pay for $3$ pounds, we multiply the unit rate by $3$ pounds and get\n\n$$\n9\\times 3=27.\n$$\n\nTherefore, Peter must pay $27$ dollars for $3$ pounds of pumpkin seeds."}] [{:db/id #edb/ref 17592186559786 :knowledge-point/_questions [{:db/id #edb/ref 17592186129309 :knowledge-point/id #uuid "97e3c93e-ceff-5bdb-905f-0c245aa0d362" :knowledge-point/title "Evaluating Expressions With Negative Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa972374-4a13-56c9-9cad-962d8ee51506" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186559633}] :answer-field/correct {:answer/id #uuid "fa972374-4a13-56c9-9cad-962d8ee51506" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186559633} :answer-field/id #uuid "63c49bf2-4fa7-5960-9c8b-b53c37923e52" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186559700}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "21de0665-fffe-50d8-acfd-284a6430dcc9" :question/math-academy-id "q-178587" :question/problem "$64\\times (-2)^{-3}=${{field-1}}" :question/worked-solution "To evaluate the given expression, we use PEMDAS.\n\nNotice that $(-2)^{-3}=\\frac{1}{(-2)^{3}}.$ So, we obtain:\n\n$$\n\\begin{aligned}64\\times (-2)^{-3} & = \\\\ 64\\times \\frac{1}{(-2)^{3}} & = \\\\ 64\\times \\frac{1}{(-8)} & = \\\\ -\\frac{64}{8} & = \\\\ -(64÷8) & = \\\\ -8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186559802 :knowledge-point/_questions [{:db/id #edb/ref 17592186138526 :knowledge-point/id #uuid "e0576504-7bd6-5649-99fe-a758faaffa4b" :knowledge-point/title "Solving Linear Equations Containing Single-Digit Decimals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01f18fc7-eb9b-5164-88db-2455cb33f7c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186559021}] :answer-field/correct {:answer/id #uuid "01f18fc7-eb9b-5164-88db-2455cb33f7c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186559021} :answer-field/id #uuid "56f02922-700a-5761-8857-860c35743e1f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186559693}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4143dbb0-9a1f-50d1-bc72-9b5c0cbd50d6" :question/math-academy-id "q-178628" :question/problem "What is the solution to the equation $0.6y=-4.8?$\n\nThe solution is $y=$\n{{field-1}}." :question/worked-solution "First, we multiply both sides of the equation by $10$ to get rid of the decimals:\n\n$$\n\\begin{aligned}0.6y & =-4.8 \\\\ 10\\cdot (0.6y) & =10\\cdot (-4.8) \\\\ 6y & =-48\\end{aligned}\n$$\n\nThen, we solve the equation using the multiplication principle, as usual:\n\n$$\n\\begin{aligned}6y & =-48 \\\\ \\frac{6y}{6} & =\\frac{-48}{6} \\\\ \\frac{\\cancel{6}y}{\\cancel{6}} & =-8 \\\\ y & =-8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186559823 :knowledge-point/_questions [{:db/id #edb/ref 17592186083170 :knowledge-point/id #uuid "bc55e7f0-598a-5244-84ef-6dff74f0c420" :knowledge-point/title "Determining the Result of a Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "677fe6bd-dd31-5f40-9b58-25620987e35f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "61q" :db/id #edb/ref 17592186559274}] :answer-field/correct {:answer/id #uuid "677fe6bd-dd31-5f40-9b58-25620987e35f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "61q" :db/id #edb/ref 17592186559274} :answer-field/id #uuid "916e2064-2417-541d-9181-6188328022c5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186559726}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "81d71337-d62e-547f-9ba2-a1325854394f" :question/math-academy-id "q-214915" :question/problem "Consider the following system of equations.\n\n$$\n\\begin{aligned}\\{\\begin{aligned}-p+7q=-4 \\\\ 10p-9q=-21\\end{aligned}\\end{aligned}\n$$\n\nThe variable $p$ can be eliminated from the system using the following two steps:\n\n1\\. Multiply the first equation by $10$ and obtain\n\n  $$\n  \\begin{aligned}-10p+70q & =-40.\\end{aligned}\n  $$\n\n2\\. Add the multiplied equation to the second equation to get\n\n$\\,$\n{{field-1}}\n$=-61.$" :question/worked-solution "Let's follow the steps provided:\n\n**Step 1**: Multiplying the first equation by $10$ yields the following equivalent system:\n\n$$\n\\{\\begin{aligned}(\\,-p+7q=-4\\,)\\,\\times (10) \\\\ 10p-9q=-21\\end{aligned}\\,⟹\\,\\{\\begin{aligned}-10p+70q=-40 \\\\ 10p-9q=-21\\end{aligned}\n$$\n\n**Step 2**: Next, we add these two equations together:\n\n$$\n\\begin{aligned}-\\cancel{10p}+70q & =-40 \\\\ \\cancel{10p}-9q & =-21 \\\\ (70q-9q) & =(-40-21) \\\\ 61q & =-61\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186559830 :knowledge-point/_questions [{:db/id #edb/ref 17592186083330 :knowledge-point/id #uuid "384f8f04-972d-50cb-a023-dba29924242e" :knowledge-point/title "Finding the Lowest Common Multiple of Two Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09a49a6f-e4ec-5fb0-af87-0497ff08ef5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186559034} {:answer/id #uuid "2f77e5cf-71c2-517b-9c44-d94ee4f08168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186559137} {:answer/id #uuid "4479c3ed-9983-547b-abb3-f811acaf8508" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186559197} {:answer/id #uuid "53cd9597-c31e-5e16-b33d-d3a647a72f3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186559229} {:answer/id #uuid "f33995be-d5da-5fe4-8be3-3948c991c6da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186559609}] :answer-field/correct {:answer/id #uuid "4479c3ed-9983-547b-abb3-f811acaf8508" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186559197} :answer-field/id #uuid "d9ca9e5c-13b4-5378-89a1-16e1132aad45" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559754}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "919304f4-9784-5406-8c58-3a53fea4edc4" :question/math-academy-id "q-43567" :question/problem "Find $\\text{LCM}(18,30).$" :question/worked-solution "To find the lowest common multiple of two numbers, we first find the prime factorization of both numbers. \n\n- We start by finding the prime factorization of $18:$ \n\n![](images/9e/9e7bddde8a287f6224b3e79f9fdacc3ac22d6db5a021b85df287e5e5fa321932.png)\n\n \nTherefore, $18=2\\cdot {3}^{2}.$\n\n- Next, we find the prime factorization of $30:$\n\n![](images/31/312d8c33355fb36260cce172ab20bf907637528d0a5d04dc4dd1eceb59d765dd.png)\n\n \nTherefore, $30=2\\cdot 3\\cdot 5.$\n\nSo, we have the following prime factorizations:\n\n$$\n\\begin{aligned}18 & =2\\cdot {3}^{2} \\\\ 30 & =2\\cdot 3\\cdot 5\\end{aligned}\n$$\n\nNow, we write down every prime factor that is shown above, and we raise each prime factor to the highest power given in either factorization:\n\n- the highest power of $2$ is $1$\n\n- the highest power of $3$ is $2$\n\n- the highest power of $5$ is $1$\n\nTherefore, the lowest common multiple of $18$ and $30$ is \n\n$$\n\\text{LCM}(18,30)=2\\cdot {3}^{2}\\cdot 5=90.\n$$"}] [{:db/id #edb/ref 17592186559890 :knowledge-point/_questions [{:db/id #edb/ref 17592186133850 :knowledge-point/id #uuid "a926bb0a-acd8-529c-8705-f6c7b4bbc2c2" :knowledge-point/title "Constructing an Expression With a Constant Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d160da5-61d6-5a2e-be7c-65ff5bdb5a5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4000h" :db/id #edb/ref 17592186559044} {:answer/id #uuid "5d1abfe8-147b-5dad-818f-b3e773fcec28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50h+80" :db/id #edb/ref 17592186559256} {:answer/id #uuid "76ebbf98-0b4a-52d3-bc2f-d43672813fba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "130h" :db/id #edb/ref 17592186559315} {:answer/id #uuid "92630e05-756a-5d8e-9c72-9166455f8a5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80h+50" :db/id #edb/ref 17592186559379} {:answer/id #uuid "9b4cd0f0-08f2-55b4-ae98-e19ad7c982e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(50+80)h" :db/id #edb/ref 17592186559409}] :answer-field/correct {:answer/id #uuid "5d1abfe8-147b-5dad-818f-b3e773fcec28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50h+80" :db/id #edb/ref 17592186559256} :answer-field/id #uuid "c72e6967-872e-5a8d-a85b-1b0076606cb0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559746}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fdafad3a-7759-57a9-8969-df2e3e1dfbfc" :question/math-academy-id "q-44817" :question/problem "A  recording studio charges musicians an initial fee of $$80$ to record an album. The studio also charges an additional $$50$ per hour.\n\nWhat expression gives the cost, in dollars, of recording an album,  in terms of the number of hours $h$ used?" :question/worked-solution "The fixed fee for recording an album is $$80.$ Hence,  $80$ should be a constant term.\n\nNow, if $h$ is the number of hours used to record an album, the cost  for $h$ hours of a recording must be $50h$ dollars.\n\nTherefore, the expression that represents the total cost, in dollars, of recording an album will be $50h+80.$"}] [{:db/id #edb/ref 17592186559784 :knowledge-point/_questions [{:db/id #edb/ref 17592186138458 :knowledge-point/id #uuid "010539bb-ae6a-5071-a7bd-25c40d5a9717" :knowledge-point/title "Choosing Appropriate Units When Base Units Are Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c2c01b0-418c-5e7b-bef1-9f74e8360551" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{s}}{{\\text{m}}^{2}}" :db/id #edb/ref 17592186559041} {:answer/id #uuid "32f41347-0e90-5f70-a725-afb601591ea5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{m}}{{\\text{s}}^{2}}" :db/id #edb/ref 17592186559143} {:answer/id #uuid "4b47a822-0376-58c7-bf52-c9886690a3c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{m}}{\\text{s}}" :db/id #edb/ref 17592186559215} {:answer/id #uuid "8260a8d8-6aad-5a51-b1f6-e47075b8707a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\text{m}}^{2}}{\\text{s}}" :db/id #edb/ref 17592186559340} {:answer/id #uuid "e1e51680-d23b-5e4b-b480-4740a65ffc07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{m}" :db/id #edb/ref 17592186559576}] :answer-field/correct {:answer/id #uuid "32f41347-0e90-5f70-a725-afb601591ea5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{m}}{{\\text{s}}^{2}}" :db/id #edb/ref 17592186559143} :answer-field/id #uuid "7d2a0144-e2db-559d-95d4-b901779d3f75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559714}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1fe48b5d-2d75-5bc6-88de-325b6398cfcb" :question/math-academy-id "q-45925" :question/problem "For an object moving in a straight line, its acceleration is the rate of change of its speed. What are the units of acceleration in terms of meters and seconds?" :question/worked-solution "We *measure the change* in the speed, as *we change* the time. Consequently, any appropriate unit must take the form\n\n$$\n\\frac{\\text{unit of speed}}{\\text{unit of time}}.\n$$\n\nIn terms of meters and seconds, the unit for speed is $\\frac{\\text{m}}{\\text{s}},$ and the unit for time is $\\text{s}.$ Therefore, the appropriate unit for acceleration is\n\n$$\n\\frac{(\\frac{\\text{m}}{\\text{s}})}{\\text{s}}=\\frac{\\text{m}}{{\\text{s}}^{2}}.\n$$\n\nor, meters per square second."}] [{:db/id #edb/ref 17592186559857 :knowledge-point/_questions [{:db/id #edb/ref 17592186152271 :knowledge-point/id #uuid "2a9d0449-2b61-5979-bd5c-94c33c8899c2" :knowledge-point/title "Identifying the Equation of a Proportional Relationship"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c5a0257-a0c5-59b4-81a5-a67cca57571d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=7w" :db/id #edb/ref 17592186559084} {:answer/id #uuid "2ecb1ff6-c6a8-5900-940f-8ee305160790" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=9w" :db/id #edb/ref 17592186559136} {:answer/id #uuid "5290e566-05b8-57a3-91e2-381dd9418d97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=8w" :db/id #edb/ref 17592186559224} {:answer/id #uuid "cb999a89-4362-59d0-b97c-1d030c842952" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=5w" :db/id #edb/ref 17592186559510} {:answer/id #uuid "cee6b386-d23f-5c89-b76f-83f2e15a81ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=6w" :db/id #edb/ref 17592186559517}] :answer-field/correct {:answer/id #uuid "5290e566-05b8-57a3-91e2-381dd9418d97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=8w" :db/id #edb/ref 17592186559224} :answer-field/id #uuid "4f2e6ed3-eae4-566d-b1ac-521499dbb0e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559685}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c6b59906-d6e5-5bad-9d0f-b7c18e490304" :question/math-academy-id "q-51850" :question/problem "If $z$ varies directly with $w$ and $z=72$ when $w=9$, find the relationship between $w$ and $z.$" :question/worked-solution "Since $z$ varies directly with $w,$ we use the equation\n\n$$\nz=kw.\n$$\n\nNext, we use the fact that $z=72$ when $w=9$ to find $k:$\n\n$$\n\\begin{aligned}72 & =9\\cdot k \\\\ \\frac{72}{9} & =k \\\\ 8 & =k\\end{aligned}\n$$\n\nTherefore, our direct variation equation is\n\n$$\nz=8w.\n$$"}] [{:db/id #edb/ref 17592186083783 :knowledge-point/_questions [{:db/id #edb/ref 17592186083397 :knowledge-point/id #uuid "c8e827c3-95a0-5270-8323-f2512b64edd0" :knowledge-point/title "Finding the Maximum or Minimum Length of a Side of a Triangle: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "095e4586-7797-5c50-acb3-59cf2d012ac1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "between $300\\,\\text{km}$ and $600\\,\\text{km}$" :db/id #edb/ref 17592186559033} {:answer/id #uuid "238fce51-3d98-5221-a18f-c58850f70188" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "between $400\\,\\text{km}$ and $800\\,\\text{km}$" :db/id #edb/ref 17592186559102} {:answer/id #uuid "966587d5-4b8d-5b36-be28-5a95a82d75c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "between $300\\,\\text{km}$ and $400\\,\\text{km}$" :db/id #edb/ref 17592186559393} {:answer/id #uuid "9862033a-b48a-5571-b9ee-129e1361d314" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "between $400\\,\\text{km}$ and $600\\,\\text{km}$" :db/id #edb/ref 17592186559399} {:answer/id #uuid "a5a4395a-46de-5f09-a0d7-51daf5c6e185" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "between $600\\,\\text{km}$ and $800\\,\\text{km}$" :db/id #edb/ref 17592186559432}] :answer-field/correct {:answer/id #uuid "095e4586-7797-5c50-acb3-59cf2d012ac1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "between $300\\,\\text{km}$ and $600\\,\\text{km}$" :db/id #edb/ref 17592186559033} :answer-field/id #uuid "23cf3c85-ab89-555e-a368-d24bdd8c8baf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186081629}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6eff57b7-61f0-5d4f-bfb7-25538940239e" :question/math-academy-id "q-53065" :question/problem "Captain Sparrow's ship is $150\\,\\text{km}$ away from a lighthouse, while Captain Jones' ship is at a distance of $450\\,\\text{km}$ from the same lighthouse. Assuming that the three locations form a triangle, what is the range of all possible values for the distance between the two ships?" :question/worked-solution "First, we let: \n\n- $S$ be the position of Captain Sparrow's ship\n\n- $J$ be the position of Captain Jones' ship\n\n- $L$ be the position of the lighthouse\n\nLet's draw $△SJL.$\n\n![](images/da/daa3d50135304457e258e3f702a115162a085a4c3940070b4ac3cef77d5ae748.png)\n\nWe know that\n\n$$\nSL=150\\,\\text{km},\\,JL=450\\,\\text{km}.\n$$\n\nAccording to the triangle inequality theorem,\n\n$$\n\\begin{aligned}JL-SL & <JS<JL+SL \\\\ 450-150 & <JS<450+150 \\\\ 300 & <JS<600.\\end{aligned}\n$$\n\nTherefore, the distance from Captain Sparrow's to Captain Jones' ship must be *between $300\\,\\text{km}$ and $600\\,\\text{km}$*."}] [{:db/id #edb/ref 17592186559824 :knowledge-point/_questions [{:db/id #edb/ref 17592186172111 :knowledge-point/id #uuid "2b534245-8276-5e9b-8b9f-0d749116477a" :knowledge-point/title "Simplifying the Absolute Value of a Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4aed9040-08cc-5807-b5a4-1787d0109cec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28{c}^{2}" :db/id #edb/ref 17592186559213} {:answer/id #uuid "4f24db4a-1005-5049-be48-5d4cdcd1f83c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{c}^{2}}{7}" :db/id #edb/ref 17592186559220} {:answer/id #uuid "6effc252-b0f9-5d2b-ad31-932aa4478f40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4{c}^{2}}{7}" :db/id #edb/ref 17592186559290} {:answer/id #uuid "b66c1b22-292a-59dd-be49-5eeabdfb43cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28{c}^{2}" :db/id #edb/ref 17592186559471} {:answer/id #uuid "e9c0d0b4-c3e0-5116-88df-a59415a5b128" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-4(c)^{2}}{7}" :db/id #edb/ref 17592186559588}] :answer-field/correct {:answer/id #uuid "4f24db4a-1005-5049-be48-5d4cdcd1f83c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{c}^{2}}{7}" :db/id #edb/ref 17592186559220} :answer-field/id #uuid "5d6de616-d83b-5377-8c79-b2dcdeb0a26b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559697}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8404264d-3a64-5581-ad4c-0afe9c6e6c44" :question/math-academy-id "q-78940" :question/problem "$|-\\frac{4{c}^{2}}{7}|=$" :question/worked-solution "Firstly, since $|-a|=|a|,$ we can write our expression as\n\n$$\n|\\frac{4{c}^{2}}{7}|.\n$$\n\nThen, we distribute the absolute value over the multiplication and division:\n\n$$\n\\begin{aligned}|\\frac{4{c}^{2}}{7}| & = \\\\ \\frac{|4{c}^{2}|}{|7|} & = \\\\ \\frac{4|{c}^{2}|}{|7|} & = \\\\ \\frac{4|{c}^{2}|}{7}\\end{aligned}\n$$\n\nSince ${c}^{2}\\ge 0$ for any real $c,$ we have that $|{c}^{2}|={c}^{2}.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{4|{c}^{2}|}{7} & =\\frac{4{c}^{2}}{7}.\\end{aligned}\n$$"}]}
