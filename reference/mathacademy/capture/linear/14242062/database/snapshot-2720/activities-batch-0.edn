#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186130284} :activity/id #uuid "acf531f3-0cde-565d-8aa6-4d76a1de1ef0" :activity/scope {:db/id #edb/ref 17592186048599 :topic/id #uuid "ad3dc03a-62fe-5e03-bb38-d788728fe7b0" :topic/math-academy-id 1987} :activity/steps [{:db/id #edb/ref 17592186130284 :step/content {:db/id #edb/ref 17592186130481 :tutorial/content "As we know already, to evaluate numerical expressions with a mix of different operations, we follow the order of operations (PEMDAS).\n\nThe same rules apply to numerical expressions with zero and negative exponents. To demonstrate, let's compute the value of\n\n$$\n(-3)^0 +2^2 \\div 2.\n$$\n\nTo evaluate the given expression, we use PEMDAS.\n\nNotice that $\\left(-3\\right)^{0}=1.$ So, we obtain\n\n$$\n\\begin{aligned}{(-3)}^{0}+{2}^{2}÷2 & = \\\\ 1+{2}^{2}÷2 & = \\\\ 1+4÷2 & = \\\\ 1+2 & = \\\\ 3 & .\\end{aligned}\n$$" :tutorial/id #uuid "e2d29fa0-8bcb-537b-bed9-91a9ff109764" :tutorial/math-academy-id 8061 :tutorial/title "Introduction"} :step/id #uuid "32a4a3c3-8cf8-5f85-9674-14a9a3dced4b" :step/math-academy-id 54570 :step/next {:db/id #edb/ref 17592186130285}} {:db/id #edb/ref 17592186130285 :step/content {:db/id #edb/ref 17592186129308 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128870 :question/id #uuid "e2f973d4-5d1e-5e35-84d3-277d1069d6f7" :question/math-academy-id "e-12873"} :knowledge-point/id #uuid "72c96e3f-e296-52c6-9c78-1b926625fe29" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048262} {:db/id #edb/ref 17592186048594}] :knowledge-point/questions [{:db/id #edb/ref 17592186129400} {:db/id #edb/ref 17592186129557} {:db/id #edb/ref 17592186481340} {:db/id #edb/ref 17592186481380} {:db/id #edb/ref 17592186481395} {:db/id #edb/ref 17592186481413}] :knowledge-point/title "Evaluating Expressions With Zero Exponents"} :step/id #uuid "c6823b52-f5d1-5aa5-81ad-e750bc27c1f0" :step/math-academy-id 54571 :step/next {:db/id #edb/ref 17592186130286}} {:db/id #edb/ref 17592186130286 :step/content {:db/id #edb/ref 17592186129309 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128871 :question/id #uuid "6f8c20ab-5dcb-5cb2-bf0f-8bc14e019e00" :question/math-academy-id "e-12874"} :knowledge-point/id #uuid "97e3c93e-ceff-5bdb-905f-0c245aa0d362" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050495}] :knowledge-point/questions [{:db/id #edb/ref 17592186129832} {:db/id #edb/ref 17592186129833} {:db/id #edb/ref 17592186481355} {:db/id #edb/ref 17592186481375} {:db/id #edb/ref 17592186490224} {:db/id #edb/ref 17592186490256} {:db/id #edb/ref 17592186559786}] :knowledge-point/title "Evaluating Expressions With Negative Exponents"} :step/id #uuid "fdb98c09-b092-5110-810e-f98748d5cf6a" :step/math-academy-id 54575 :step/next {:db/id #edb/ref 17592186130287}} {:db/id #edb/ref 17592186130287 :step/content {:db/id #edb/ref 17592186129310 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128872 :question/id #uuid "c6b6a911-843f-5c96-a792-ebd807b5d60e" :question/math-academy-id "e-12875"} :knowledge-point/id #uuid "222a5d13-74e9-5f1b-81d5-f38a6b80870c" :knowledge-point/questions [{:db/id #edb/ref 17592186129401} {:db/id #edb/ref 17592186129834} {:db/id #edb/ref 17592186481353} {:db/id #edb/ref 17592186481373} {:db/id #edb/ref 17592186490236}] :knowledge-point/title "Evaluating Expressions With Both Zero and Negative Exponents"} :step/id #uuid "b8275c3d-10fe-5893-af21-13f12dddc26e" :step/math-academy-id 54579}] :activity/title "Evaluating Expressions With Integer Exponents" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186129335}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186490338} :activity/id #uuid "dbf71e83-e6c5-5f76-a850-bb5e63425c3e" :activity/scope {:db/id #edb/ref 17592186048599 :topic/id #uuid "ad3dc03a-62fe-5e03-bb38-d788728fe7b0" :topic/math-academy-id 1987} :activity/steps [{:db/id #edb/ref 17592186490338 :step/content {:db/id #edb/ref 17592186490224 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "545f6b34-8b08-5486-9f0e-2cc84dac10e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186489714} {:answer/id #uuid "5923c943-f43e-5441-819c-fc4c38287552" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186489731} {:answer/id #uuid "7575186d-b230-5c3f-951f-24397f6e911d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186489787} {:answer/id #uuid "b71f29a1-8d1a-5479-ac04-69c1694fac07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186489917} {:answer/id #uuid "c44f6e25-54af-5112-a2ff-488411a644f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186489938}] :answer-field/correct {:db/id #edb/ref 17592186489917} :answer-field/id #uuid "7a5fd354-5df8-5dcc-bf17-82ac638ded50" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490142}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "27f65119-9cfd-5858-830b-dc487011110a" :question/math-academy-id "q-69345" :question/problem "Calculate $\\frac{5}{8}\\times 3-(8-10)^{-3}.$" :question/worked-solution "To evaluate the given expression, we use PEMDAS.\n\nFirst, we compute the expression inside the parentheses:\n\n$$\n\\frac{5}{8}\\times 3-(8-10)^{-3}=\\frac{5}{8}\\times 3-(-2)^{-3}\n$$\n\nNext, notice that $(-2)^{-3}=\\frac{1}{(-2)^{3}}=-\\frac{1}{8}.$ So, we obtain:\n\n$$\n\\begin{aligned}\\frac{5}{8}\\times 3-(-2)^{-3} & = \\\\ \\frac{5}{8}\\times 3-(-\\frac{1}{8}) & = \\\\ \\frac{5}{8}\\times \\frac{3}{1}+\\frac{1}{8} & = \\\\ \\frac{5\\times 3}{8\\times 1}+\\frac{1}{8} & = \\\\ \\frac{15}{8}+\\frac{1}{8} & = \\\\ \\frac{15+1}{8} & = \\\\ \\frac{16}{8} & = \\\\ 2\\end{aligned}\n$$"} :step/id #uuid "128dae23-270e-52bb-9758-c300a092867a" :step/next {:db/id #edb/ref 17592186490366}} {:db/id #edb/ref 17592186490343 :step/content {:db/id #edb/ref 17592186490256 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a76c1ed-9c9a-5884-8b85-3040e0c60944" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{10}" :db/id #edb/ref 17592186489795}] :answer-field/correct {:db/id #edb/ref 17592186489795} :answer-field/id #uuid "370651de-97e9-5350-9a2a-8b5e0ff4246c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186490104}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5fe451b2-edf1-59c7-ba6b-aec83b3dbee5" :question/math-academy-id "q-175956" :question/problem "${2}^{-3}\\times (\\frac{8}{5}+4)=${{field-1}}" :question/worked-solution "To evaluate the given expression, we use PEMDAS.\n\nNotice that ${2}^{-3}=\\frac{1}{{2}^{3}}.$ So, we obtain:\n\n$$\n\\begin{aligned}{2}^{-3}\\times (\\frac{8}{5}+4) & = \\\\ \\frac{1}{{2}^{3}}\\times (\\frac{8}{5}+4) & = \\\\ \\frac{1}{8}\\times (\\frac{8}{5}+4) & = \\\\ \\frac{1}{8}\\times \\frac{8+20}{5} & = \\\\ \\frac{1}{8}\\times \\frac{28}{5} & = \\\\ \\frac{1\\times 28}{8\\times 5} & = \\\\ \\frac{1\\times 4\\times 7}{2\\times 4\\times 5} & = \\\\ \\frac{1\\times \\cancel{4}\\times 7}{2\\times \\cancel{4}\\times 5} & = \\\\ \\frac{7}{10}\\end{aligned}\n$$"} :step/id #uuid "2c54203f-3a25-554b-95d3-3f146fa16ddb"} {:db/id #edb/ref 17592186490366 :step/content {:db/id #edb/ref 17592186490236 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90c61a4c-acb5-5943-83c3-2a9169499652" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{125}" :db/id #edb/ref 17592186489842}] :answer-field/correct {:db/id #edb/ref 17592186489842} :answer-field/id #uuid "3292a063-82f7-566f-97f5-25f4fc63cbef" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186490100}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "355c3927-42d5-52b6-8af5-1388530c1ab2" :question/math-academy-id "q-171378" :question/problem "$(-1+7.35)^{0}\\times {5}^{-3}=${{field-1}}" :question/worked-solution "To evaluate the given expression, we use PEMDAS.\n\nFirst, we compute the expression inside the parentheses:\n\n$$\n(-1+7.35)^{0}\\times {5}^{-3}=(6.35)^{0}\\times {5}^{-3}\n$$\n\nNext, notice that $(6.35)^{0}=1.$ So, we obtain:\n\n$$\n\\begin{aligned}(6.35)^{0}\\times {5}^{-3} & = \\\\ 1\\times {5}^{-3} & = \\\\ {5}^{-3}\\end{aligned}\n$$\n\nFinally, \n\n$$\n{5}^{-3}=\\frac{1}{{5}^{3}}=\\frac{1}{125}.\n$$"} :step/id #uuid "95845e10-8b08-5a84-8f24-4769592ec34a" :step/next {:db/id #edb/ref 17592186490343}}] :activity/title "Evaluating Expressions With Integer Exponents" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186489511}] [{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186084277} :activity/id #uuid "38aff8ec-fcf4-52b8-8557-cb2bcff71738" :activity/scope {:db/id #edb/ref 17592186048719 :topic/id #uuid "b8656b86-9f88-52e9-adb0-d3cc15fbb7cc" :topic/math-academy-id 755} :activity/steps [{:db/id #edb/ref 17592186084277 :step/content {:db/id #edb/ref 17592186084484 :tutorial/content "The **lowest common multiple** (or $\\textrm{LCM}$) of two integers is the smallest multiple that's common to both numbers.\n\nTo find the lowest common multiple of two small numbers, we can list all multiples of the two numbers and identify the smallest multiple that they have in common.\n\nFor example, let's find the lowest common multiple of $4$ and $6.$ We start by listing all multiples of $4$ and $6\\mathbin{:}$\n\n$$\n\\begin{aligned}4 & \\,\\to \\,4,\\,8,\\,\\boxed{\\text{[math]12[/math]}},\\,16,\\,20,\\,24,\\,… \\\\ 6 & \\,\\to \\,6,\\,\\boxed{\\text{[math]12[/math]}},\\,18,\\,24,\\,30,\\,36,\\,…\\end{aligned}\n$$\n\nThe smallest multiple in both lists is ![](images/92/9285d37c7b455395acb42a54f78348bedfd8c9a72ad63d6e6ab7c2426148ea0d.svg) So $12$ is our answer, and we can write\n\n$$\n\\textrm{LCM}(4,6)= 12.\n$$\n\n**Note:** The lowest common multiple is also sometimes called the *least* common multiple." :tutorial/id #uuid "b16f2464-2c19-5166-bd61-97043695afcb" :tutorial/math-academy-id 5301 :tutorial/title "Introduction"} :step/id #uuid "853eea8e-7e8c-5972-b2df-6a996d469c6a" :step/math-academy-id 33113 :step/next {:db/id #edb/ref 17592186084281}} {:db/id #edb/ref 17592186084278 :step/content {:db/id #edb/ref 17592186083330 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083132 :question/id #uuid "f524667d-8cd2-5b91-a9e0-538fc64399e5" :question/math-academy-id "e-8869"} :knowledge-point/id #uuid "384f8f04-972d-50cb-a023-dba29924242e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049086} {:db/id #edb/ref 17592186050170} {:db/id #edb/ref 17592186050212}] :knowledge-point/questions [{:db/id #edb/ref 17592186083690} {:db/id #edb/ref 17592186083711} {:db/id #edb/ref 17592186493920} {:db/id #edb/ref 17592186559830}] :knowledge-point/title "Finding the Lowest Common Multiple of Two Integers"} :step/id #uuid "0c8932d3-46c6-5cd6-941d-98887b4bfb0e" :step/math-academy-id 33116 :step/next {:db/id #edb/ref 17592186084280}} {:db/id #edb/ref 17592186084279 :step/content {:db/id #edb/ref 17592186083331 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083133 :question/id #uuid "7c928766-9971-565a-b38b-5c97b2c3ee1d" :question/math-academy-id "e-8870"} :knowledge-point/id #uuid "c28dd57d-e6e5-5704-94a4-5f9bfb37f383" :knowledge-point/questions [{:db/id #edb/ref 17592186083689} {:db/id #edb/ref 17592186083929} {:db/id #edb/ref 17592186234048} {:db/id #edb/ref 17592186493909} {:db/id #edb/ref 17592186493965}] :knowledge-point/title "Finding the Lowest Common Denominator of Two Fractions"} :step/id #uuid "764cac2a-73a8-581d-8ccd-4d665b951e2b" :step/math-academy-id 33118} {:db/id #edb/ref 17592186084280 :step/content {:db/id #edb/ref 17592186083332 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083134 :question/id #uuid "1373d2e3-fc83-56f2-b779-8f1e2d10efea" :question/math-academy-id "e-8874"} :knowledge-point/id #uuid "746e99f3-561d-5212-ba2a-3d34b8bcdbee" :knowledge-point/questions [{:db/id #edb/ref 17592186083479} {:db/id #edb/ref 17592186083712} {:db/id #edb/ref 17592186493890} {:db/id #edb/ref 17592186493918} {:db/id #edb/ref 17592186493924} {:db/id #edb/ref 17592186493959} {:db/id #edb/ref 17592186558531}] :knowledge-point/title "Finding the Lowest Common Multiple of Three Integers"} :step/id #uuid "7e705e91-32b9-5486-b6d0-c6ebfbc45c9b" :step/math-academy-id 33136 :step/next {:db/id #edb/ref 17592186084279}} {:db/id #edb/ref 17592186084281 :step/content {:db/id #edb/ref 17592186084485 :tutorial/content "Now suppose that we want to find the lowest common multiple of two larger numbers. It would take a while to make long lists of multiples. Luckily, there is a faster method. \n\nLet's demonstrate by finding $\\textrm{LCM}(10,12).$ We start by writing the prime factorization of $10$ and $12$, writing any repeating factors as powers:\n\n$$\n\\begin{aligned}10 & =2\\cdot 5={2}^{1}\\cdot {5}^{1} \\\\ 12 & =2\\cdot 2\\cdot 3={2}^{2}\\cdot {3}^{1}\\end{aligned}\n$$\n\nThen, we write down each unique prime factor that appears in either of our decompositions. In our case, the unique prime factors are \n\n$$\n{\\color{red}2}, \\qquad {\\color{red}3}, \\qquad {\\color{red}5}.\n$$\n\nNow, for each number in our list, we look at *both* prime factorizations and we take the *largest* power shown for each prime factor:\n\n- The factors corresponding to ${\\color{red}2}$ are ${\\color{red}2}^{\\color{blue}1}$ and ${\\color{red}2}^{\\color{blue}2}.$ Of these, the larger power is ${\\color{red}2}^{\\color{blue}2}.$\n\n- There is only one factor corresponding to ${\\color{red}3}.$ It is ${\\color{red}3}^{\\color{blue}1}.$\n\n- There is only one factor corresponding to ${\\color{red}5}.$ It is ${\\color{red}5}^{\\color{blue}1}.$\n\nFinally, we multiply the largest powers of each factor together, and we get\n\n$$\n\\begin{aligned}\\text{LCM}(10,12) & ={2}^{2}\\cdot {3}^{1}\\cdot {5}^{1} \\\\  & =4\\cdot 3\\cdot 5 \\\\  & =60.\\end{aligned}\n$$" :tutorial/id #uuid "de44c642-c9d2-5c1d-8b59-8781a99559ef" :tutorial/math-academy-id 5489 :tutorial/title "Finding the Lowest Common Multiple of Two Larger Numbers"} :step/id #uuid "44919f35-fd65-50af-b639-7d5eb83ab3b0" :step/math-academy-id 34200 :step/next {:db/id #edb/ref 17592186084278}}] :activity/title "Finding Lowest Common Multiples Using Prime Factorization" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083445}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186134779} :activity/id #uuid "3675dcdc-e716-5cf3-815c-6104dee10ef7" :activity/scope {:db/id #edb/ref 17592186048925 :topic/id #uuid "ccad99ab-e070-516f-9254-b5d931a9723d" :topic/math-academy-id 2213} :activity/steps [{:db/id #edb/ref 17592186134779 :step/content {:db/id #edb/ref 17592186135012 :tutorial/content "The expression below gives the cost, in dollars, of sending a letter to Spain: \n\n$$\n2w + 1\n$$\n\nHere, $w$ is the letter's weight in ounces.\n\n$$\n\\overbrace{\\:{\\color{blue}2}\\!\\!\\!{\\underset{\\underset{\\Large\\textrm{weight}}{\\large\\uparrow}}{w}}\\!\\!\\!+{\\color{red}1}\\:}^{\\large\\textrm{total cost}}\n$$\n\nThe coefficient of $w$ is the cost for each additional ounce of weight.\n\nTo illustrate:\n\n- If $w=1$ (we have a $1$-ounce letter), the cost is ${\\color{blue}2} \\cdot 1 + {\\color{red}1} = \\[math]3.$\n\n- If $w=2$ (we have a $2$-ounce letter), the cost is ${\\color{blue}2} \\cdot 2 + {\\color{red}1} = \\[/math]5.$\n\n- If $w=3$ (we have a $3$-ounce letter), the cost is ${\\color{blue}2} \\cdot 3 + {\\color{red}1} = \\[math]7.$\n\nNote the following:\n\n- The number $\\color{blue}2$ in this expression represents a *unit rate.* Each time we increase the letter's weight by $1$ ounce, the cost increases by $\\color{blue}\\[/math]2$.\n\n- There is also a **base fee** of $\\color{red}\\[math]1$, which does not depend on the weight of the letter. We can think of this as the cost of sending a zero-ounce letter." :tutorial/id #uuid "4884ffa5-ca42-52e9-9661-39a00bd97ba4" :tutorial/math-academy-id 1363 :tutorial/title "Introduction"} :step/id #uuid "3727010c-1515-54c6-9fef-96ea2dc82e6d" :step/math-academy-id 2798 :step/next {:db/id #edb/ref 17592186134780}} {:db/id #edb/ref 17592186134780 :step/content {:db/id #edb/ref 17592186133849 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133673 :question/id #uuid "d580ba90-3479-5bc6-be3c-457485999ade" :question/math-academy-id "e-822"} :knowledge-point/id #uuid "ad5ad311-bf6f-58e9-a473-51ad651160fd" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049018} {:db/id #edb/ref 17592186050195}] :knowledge-point/questions [{:db/id #edb/ref 17592186134437} {:db/id #edb/ref 17592186134439} {:db/id #edb/ref 17592186495077} {:db/id #edb/ref 17592186495117}] :knowledge-point/title "Interpreting the Meaning of the Coefficient and Constant Term"} :step/id #uuid "da830df3-d6a9-51ba-bd81-b481445b0aa5" :step/math-academy-id 2799 :step/next {:db/id #edb/ref 17592186134781}} {:db/id #edb/ref 17592186134781 :step/content {:db/id #edb/ref 17592186133850 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133674 :question/id #uuid "2797cfc6-ae99-55a6-98a2-bb1f5be39b4e" :question/math-academy-id "e-824"} :knowledge-point/id #uuid "a926bb0a-acd8-529c-8705-f6c7b4bbc2c2" :knowledge-point/questions [{:db/id #edb/ref 17592186134440} {:db/id #edb/ref 17592186134486} {:db/id #edb/ref 17592186495120} {:db/id #edb/ref 17592186558562} {:db/id #edb/ref 17592186559890}] :knowledge-point/title "Constructing an Expression With a Constant Term"} :step/id #uuid "d4c12aa1-5cda-5b3b-9eb9-f006009f5e4f" :step/math-academy-id 2804 :step/next {:db/id #edb/ref 17592186134897}} {:db/id #edb/ref 17592186134782 :step/content {:db/id #edb/ref 17592186133851 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133675 :question/id #uuid "0c075047-3971-5f0b-a03b-c67be0032db4" :question/math-academy-id "e-825"} :knowledge-point/id #uuid "7a696afb-6edc-5445-a6e4-23b82f96c76b" :knowledge-point/questions [{:db/id #edb/ref 17592186134441} {:db/id #edb/ref 17592186134488} {:db/id #edb/ref 17592186495057} {:db/id #edb/ref 17592186495070} {:db/id #edb/ref 17592186495088} {:db/id #edb/ref 17592186495169}] :knowledge-point/title "Interpreting an Expression With Multiple Variables"} :step/id #uuid "70341f70-571d-537e-81a7-dfdece0049ef" :step/math-academy-id 2806} {:db/id #edb/ref 17592186134897 :step/content {:db/id #edb/ref 17592186135149 :tutorial/content "In many countries, a **sales tax** is charged whenever an individual or company makes a purchase. The tax is usually based on a certain percentage of the sale price.\n\nFor example, suppose a person purchases a bicycle for $\\[math] 200,$ and there is a sales tax of $5\\%.$ How much is this tax, and what is the total cost of the bicycle?\n\nTo determine the amount of the tax the person must pay, we multiply $200 \\times 5\\%$, as follows:\n\n$$\n\\begin{aligned}Tax & =\\text{\\[}/math]200\\times 5% \\\\  & =\\text{\\[}math]200\\times 0.05 \\\\  & =\\text{\\[}/math]10\\end{aligned}\n$$\n\nTherefore, the purchaser must pay a $\\[math]10$ sales tax. This means that the total amount the person needs to pay for the bicycle is\n\n$$\n\\[/math]200 + \\[math]10 = \\[/math]210.\n$$" :tutorial/id #uuid "683a47a7-4c0a-5da2-888c-d004b4167df5" :tutorial/math-academy-id 6218 :tutorial/title "Calculating Taxes"} :step/id #uuid "7365f275-4f44-5bdc-b64a-45158abcf6d5" :step/math-academy-id 37767 :step/next {:db/id #edb/ref 17592186134962}} {:db/id #edb/ref 17592186134962 :step/content {:db/id #edb/ref 17592186133947 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133538 :question/id #uuid "93b2ed4a-45ad-5fc4-bfe8-479f5a674595" :question/math-academy-id "e-1604"} :knowledge-point/id #uuid "758ce589-dcf8-5be8-8f15-ae72172050db" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049467}] :knowledge-point/questions [{:db/id #edb/ref 17592186134438} {:db/id #edb/ref 17592186134487} {:db/id #edb/ref 17592186495112} {:db/id #edb/ref 17592186495140} {:db/id #edb/ref 17592186495141} {:db/id #edb/ref 17592186495172}] :knowledge-point/title "Constructing an Expression With a Tax Term"} :step/id #uuid "4b073ed7-15e0-5244-aa23-477855194546" :step/math-academy-id 5156 :step/next {:db/id #edb/ref 17592186134782}}] :activity/title "Interpreting Linear Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186134048}] [{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186084021} :activity/id #uuid "a68b3f7f-449b-5dcc-876b-2a9dda0b7af9" :activity/scope {:db/id #edb/ref 17592186049060 :topic/id #uuid "d6922e01-c712-5ba1-b304-de1c9c2ec2dd" :topic/math-academy-id 742} :activity/steps [{:db/id #edb/ref 17592186084021 :step/content {:db/id #edb/ref 17592186084514 :tutorial/content "Suppose that we want to solve, *without using graphs*, the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}x+y &=1 \\\\ 5x-y &=11\\end{aligned}\\right.\n$$\n\nTo solve the system, we must combine the equations into a single equation that can be solved using algebraic manipulation. One way to combine the equations is to use the **elimination method.** \n\nNotice that the coefficient of $y$ in the first equation is $1,$ and the coefficient of $y$ in the second equation is $-1.$ Since these numbers add to zero, we can *add* the two equations, *eliminate* the variable $y,$ and solve the resulting equation for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}\\begin{aligned}x+\\cancel{y} & =1 \\\\ 5x-\\cancel{y} & =11 \\\\ (x+5x) & =(1+11) \\\\ 6x & =12 \\\\ x & =2\\end{aligned}\\end{aligned}\n$$\n\nSo, the solution must have $x=2.$ However, we still need to find $y.$ To do this, we substitute $x=2$ back into one of the equations. Let's choose the first equation:\n\n$$\n\\begin{aligned}\\begin{aligned}x+y & =1 \\\\ (2)+y & =1 \\\\ y & =-1\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=2$ and $y=-1,$ which can be expressed as $(2, -1).$" :tutorial/id #uuid "48f030ba-6728-565a-be53-cfb1e88abc86" :tutorial/math-academy-id 8702 :tutorial/title "Introduction"} :step/id #uuid "22b878ba-aa9a-5218-889c-006c8dcacca7" :step/math-academy-id 143346 :step/next {:db/id #edb/ref 17592186084022}} {:db/id #edb/ref 17592186084022 :step/content {:db/id #edb/ref 17592186083168 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082932 :question/id #uuid "06136eef-284e-548f-a57b-f400a05f2cb9" :question/math-academy-id "e-13993"} :knowledge-point/id #uuid "7e0dbf68-2247-5a47-aac8-c16acc5e710c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673} {:db/id #edb/ref 17592186048678} {:db/id #edb/ref 17592186050452}] :knowledge-point/questions [{:db/id #edb/ref 17592186083605} {:db/id #edb/ref 17592186083606} {:db/id #edb/ref 17592186083927} {:db/id #edb/ref 17592186496237} {:db/id #edb/ref 17592186496321}] :knowledge-point/title "Eliminating the Second Variable"} :step/id #uuid "5234accd-01b6-501e-866d-11b931397534" :step/math-academy-id 143347 :step/next {:db/id #edb/ref 17592186084023}} {:db/id #edb/ref 17592186084023 :step/content {:db/id #edb/ref 17592186083169 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082933 :question/id #uuid "17cb905e-e692-59b8-964d-c7b50482c11e" :question/math-academy-id "e-13994"} :knowledge-point/id #uuid "e562941a-078d-555f-aab6-c59d4c79dfba" :knowledge-point/questions [{:db/id #edb/ref 17592186083485} {:db/id #edb/ref 17592186083607} {:db/id #edb/ref 17592186496235} {:db/id #edb/ref 17592186496287} {:db/id #edb/ref 17592186559819} {:db/id #edb/ref 17592186559861}] :knowledge-point/title "Eliminating the First Variable"} :step/id #uuid "adba60f0-2f20-5985-8599-c86e9c30f9db" :step/math-academy-id 143351 :step/next {:db/id #edb/ref 17592186084024}} {:db/id #edb/ref 17592186084024 :step/content {:db/id #edb/ref 17592186084515 :tutorial/content "Now, suppose that we want to solve the following system of linear equations using elimination:\n\n$$\n\\left\\{\\begin{aligned}x+2y &=1 \\\\ x-y &=-2\\end{aligned}\\right.\n$$\n\nAs it stands, adding the two equations will not eliminate any of the variables. \n\nHowever, suppose we want to eliminate the variable $x$. We begin by multiplying the second equation by $\\color{blue}-1$, which gives the following equivalent system:\n\n![](images/85/85996afab1889f8032a295f4db6bbbcbc8670a0bc12f0b64f53a3b809f111628.svg)\n\nThen, we add the two resulting equations together. This eliminates the variable $x,$ making it possible to solve for $y\\mathbin{:}$\n\n$$\n\\begin{aligned}\\begin{aligned}\\cancel{x}+2y & =1 \\\\ -\\cancel{x}+y & =2 \\\\ (2y+y) & =(1+2) \\\\ 3y & =3 \\\\ y & =1\\end{aligned}\\end{aligned}\n$$\n\nSo, the solution must have $y=1.$ However, we still need to find $x.$ To do this, we substitute $y=1$ back into one of the equations. Let's choose the second equation:\n\n$$\n\\begin{aligned}\\begin{aligned}x-y & =-2 \\\\ x-(1) & =-2 \\\\ x & =-1\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=-1$ and $y=1,$ which can be expressed as $(-1, 1).$" :tutorial/id #uuid "170be181-ae77-50d7-a5f1-0a4bdcfa318e" :tutorial/math-academy-id 8704 :tutorial/title "Eliminating Variables From Systems of Linear Equations"} :step/id #uuid "1c45a64c-2352-5510-9c77-6d975e32ee8a" :step/math-academy-id 143354 :step/next {:db/id #edb/ref 17592186084025}} {:db/id #edb/ref 17592186084025 :step/content {:db/id #edb/ref 17592186083170 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082934 :question/id #uuid "98645504-986a-5847-8042-32ced1cf4d14" :question/math-academy-id "e-13996"} :knowledge-point/id #uuid "bc55e7f0-598a-5244-84ef-6dff74f0c420" :knowledge-point/questions [{:db/id #edb/ref 17592186083608} {:db/id #edb/ref 17592186083609} {:db/id #edb/ref 17592186083779} {:db/id #edb/ref 17592186496289} {:db/id #edb/ref 17592186496330} {:db/id #edb/ref 17592186559823}] :knowledge-point/title "Determining the Result of a Transformation"} :step/id #uuid "f6f3680b-161b-5ba4-b393-bb9b5b36236b" :step/math-academy-id 143355 :step/next {:db/id #edb/ref 17592186084026}} {:db/id #edb/ref 17592186084026 :step/content {:db/id #edb/ref 17592186083171 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082935 :question/id #uuid "0e96914f-2f28-5fef-8a36-9cf2869b1b43" :question/math-academy-id "e-14000"} :knowledge-point/id #uuid "20e61a36-c5bf-598a-a07d-833611ffaee6" :knowledge-point/questions [{:db/id #edb/ref 17592186083568} {:db/id #edb/ref 17592186083780} {:db/id #edb/ref 17592186496233} {:db/id #edb/ref 17592186496256} {:db/id #edb/ref 17592186496304} {:db/id #edb/ref 17592186496305} {:db/id #edb/ref 17592186496322} {:db/id #edb/ref 17592186559839} {:db/id #edb/ref 17592186559874}] :knowledge-point/title "Solving a System of Equations"} :step/id #uuid "b6308dc5-5a40-5abe-9f8e-91524b3b2359" :step/math-academy-id 143359}] :activity/title "Introduction to the Elimination Method" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083433}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186559944} :activity/id #uuid "397850c6-acc7-5579-8f02-292fa0842dbf" :activity/scope {:db/id #edb/ref 17592186049060 :topic/id #uuid "d6922e01-c712-5ba1-b304-de1c9c2ec2dd" :topic/math-academy-id 742} :activity/steps [{:db/id #edb/ref 17592186559922 :step/content {:db/id #edb/ref 17592186559819 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05e5070a-60a7-51db-a7a0-ecbd3b937e38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186559028}] :answer-field/correct {:db/id #edb/ref 17592186559028} :answer-field/id #uuid "acfdc83e-36c8-5bab-b817-c6b95dba314d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186559737} {:answer-field/choices [{:answer/id #uuid "b788af03-66b4-5f39-9af4-1a154adb18e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186559475}] :answer-field/correct {:db/id #edb/ref 17592186559475} :answer-field/id #uuid "e4124ec5-3e6f-5d7a-9254-21f518b1c2eb" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186559758}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7d0d1a49-c8c0-5ac4-a633-472aeac1d8a8" :question/math-academy-id "q-214839" :question/problem "Using the elimination method, eliminate the variable $p$ and find the solution $(p,q)$ to the following system of equations:\n\n$$\n\\{\\begin{aligned}4p+q=-24 \\\\ -4p+7q=24\\end{aligned}\n$$\n\nThe solution is $($\n{{field-1}}$\\,,$\n{{field-2}}\n$).$" :question/worked-solution "Notice that the coefficient of $p$ in the first equation is $4,$ and the coefficient of $p$ in the second equation is $-4.$ \n\nSince these numbers add to zero, we can add the two equations, *eliminate* the variable $p,$ and solve the resulting equation for $q:$\n\n$$\n\\begin{aligned}\\cancel{4p}+q & =-24 \\\\ -\\cancel{4p}+7q & =24 \\\\ (q+7q) & =(-24+24) \\\\ 8q & =0 \\\\ q & =0\\end{aligned}\n$$\n\nSo, the solution must have $q=0.$ However, we still need to find $p.$ To do this, we substitute $q=0$ back into one of the equations. Let's choose the first equation:\n\n$$\n\\begin{aligned}4p+q & =-24 \\\\ 4p+(0) & =-24 \\\\ 4p & =-24 \\\\ p & =-6\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $p=-6,\\,q=0,$ which can be expressed as $(\\,-\\,6,0\\,).$"} :step/id #uuid "48662e2a-320d-5b65-83c0-53722452ce12"} {:db/id #edb/ref 17592186559944 :step/content {:db/id #edb/ref 17592186559874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79e9ed81-8adc-5412-8b2e-0655de8c1d6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,-1)" :db/id #edb/ref 17592186559321} {:answer/id #uuid "801bd6ee-55fe-555a-a5a1-7e40518e7c8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,7)" :db/id #edb/ref 17592186559334} {:answer/id #uuid "a20dfd08-1474-5e67-86b1-3cce1d26279a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,9)" :db/id #edb/ref 17592186559425} {:answer/id #uuid "d924bb24-e255-5e91-950b-1728e67a3a03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,2)" :db/id #edb/ref 17592186559548} {:answer/id #uuid "f76338d9-5322-5de7-be10-ca730f0460ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,3)" :db/id #edb/ref 17592186559627}] :answer-field/correct {:db/id #edb/ref 17592186559321} :answer-field/id #uuid "b1cd66a4-4798-5107-a762-4b88b1221841" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559739}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e48aeb5c-60a2-50ba-8aad-37ecd4e919eb" :question/math-academy-id "q-170020" :question/problem "Consider the following system of equations.\n\n$$\n\\{\\begin{aligned}5t+2v=13 \\\\ 2t+v=5\\end{aligned}\n$$\n\nThe variable $v$ can be eliminated from the system using the following two steps:\n\n1\\. Multiply the second equation by $-2$ and obtain\n\n  $$\n  \\begin{aligned}-4t-2v=-10.\\end{aligned}\n  $$\n\n2\\. Add the multiplied equation to the first equation to get\n\n  $$\n  \\begin{aligned}⋯\\,\\,?\\,\\,⋯\\,\\,=3.\\end{aligned}\n  $$\n\nFind the missing expression, and hence find the solution $(t,v)$ of the system." :question/worked-solution "Let's follow the steps provided:\n\n**Step 1**: Multiplying the second equation by $-2$ yields the following equivalent system:\n\n$$\n\\{\\begin{aligned}5t+2v=13 \\\\ (\\,2t+v=5\\,)\\,\\times (-2)\\end{aligned}\\,⟹\\,\\{\\begin{aligned}5t+2v=13 \\\\ -4t-2v=-10\\end{aligned}\n$$\n\n**Step 2**: Next, we add these two equations together, *eliminate* the variable $v,$ and solve the resulting equation for $t:$\n\n$$\n\\begin{aligned}5t+\\cancel{2v} & =13 \\\\ -4t-\\cancel{2v} & =-10 \\\\ (5t-4t) & =(13-10) \\\\ t & =3\\end{aligned}\n$$\n\nSo, the solution must have $t=3.$ However, we still need to find $v.$ To do this, we substitute $t=3$ back into one of the equations. Let's choose the second equation:\n\n$$\n\\begin{aligned}2t+v & =5 \\\\ 2(3)+v & =5 \\\\ 6+v & =5 \\\\ v & =-1\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $t=3,\\,v=-1,$ which can be expressed as $(3,-1).$"} :step/id #uuid "7e438f98-2e65-5923-a09a-5e8be95eb6f5" :step/next {:db/id #edb/ref 17592186559945}} {:db/id #edb/ref 17592186559945 :step/content {:db/id #edb/ref 17592186559839 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d16b812f-c6b5-520d-969e-18bfaa8a836f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186559529}] :answer-field/correct {:db/id #edb/ref 17592186559529} :answer-field/id #uuid "61df3c66-7c8a-518e-88c5-f9c95caa3752" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186559699} {:answer-field/choices [{:answer/id #uuid "f6432dec-a821-5a8f-91c0-bc8eb104b4db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7x" :db/id #edb/ref 17592186559622}] :answer-field/correct {:db/id #edb/ref 17592186559622} :answer-field/id #uuid "92216407-d4a0-5405-80ce-75bdb22713b8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186559727} {:answer-field/choices [{:answer/id #uuid "1d011b84-399d-5ccd-8fd8-17c37c9d5011" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186559087}] :answer-field/correct {:db/id #edb/ref 17592186559087} :answer-field/id #uuid "cfc01578-2ddc-5e45-a0ad-a9e131bb6c30" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186559748}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a91b43fb-d787-5c95-8cec-baa3db0b3a5b" :question/math-academy-id "q-208822" :question/problem "Consider the following system of equations.\n\n$$\n\\{\\begin{aligned}-3x+5y=9 \\\\ 2x-y=1\\end{aligned}\n$$\n\nThe variable $y$ can be eliminated from the system using the following two steps:\n\n1\\. Multiply the second equation by $5$ and obtain\n\n  $$\n  \\begin{aligned}10x-5y=5.\\end{aligned}\n  $$\n\n2\\. Add the multiplied equation to the first equation to get\n\n$\\,$\n{{field-1}}$=14.$\n\n$\\,$\nHence, the solution to the system of equations is $($\n{{field-2}}$\\,,$\n{{field-3}}\n$).$" :question/worked-solution "Let's follow the steps provided:\n\n**Step 1**: Multiplying the second equation by $5$ yields the following equivalent system:\n\n$$\n\\{\\begin{aligned}-3x+5y=9 \\\\ (\\,2x-y=1\\,)\\,\\times (5)\\end{aligned}\\,⟹\\,\\{\\begin{aligned}-3x+5y=9 \\\\ 10x-5y=5\\end{aligned}\n$$\n\n**Step 2**: Next, we add these two equations together, *eliminate* the variable $y,$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}-3x+\\cancel{5y} & =9 \\\\ 10x-\\cancel{5y} & =5 \\\\ (-3x+10x) & =(9+5) \\\\ 7x & =14\\end{aligned}\n$$\n\nSo, the solution must have $x=2.$ However, we still need to find $y.$ To do this, we substitute $x=2$ back into one of the equations. Let's choose the second equation:\n\n$$\n\\begin{aligned}2x-y & =1 \\\\ 2(2)-y & =1 \\\\ 4-y & =1 \\\\ -y & =-3 \\\\ y & =3\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=2,\\,y=3,$ which can be expressed as $(\\,2,3\\,).$"} :step/id #uuid "810b9fa4-db24-548c-ad22-6936f48bccc2" :step/next {:db/id #edb/ref 17592186559964}} {:db/id #edb/ref 17592186559964 :step/content {:db/id #edb/ref 17592186559861 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7dfaf16c-d8c2-5fee-b8aa-4c4defa51d4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186559329}] :answer-field/correct {:db/id #edb/ref 17592186559329} :answer-field/id #uuid "6922ba3e-81d0-5c06-979c-0240b56ed179" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186559703} {:answer-field/choices [{:answer/id #uuid "7611515b-eb94-5d0e-a6cc-97bdcad28000" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186559313}] :answer-field/correct {:db/id #edb/ref 17592186559313} :answer-field/id #uuid "702844cc-350c-5557-8e47-27b87222f0d3" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186559707}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cd2697ea-50eb-59a5-a69d-76e0004cb7aa" :question/math-academy-id "q-214764" :question/problem "Using the elimination method, eliminate the variable $x$ and find the solution $(x,y)$ to the following system of equations:\n\n$$\n\\{\\begin{aligned}5x+2y=45 \\\\ -5x-7y=-70\\end{aligned}\n$$\n\nThe solution is $($\n{{field-1}}$\\,,$\n{{field-2}}\n$).$" :question/worked-solution "Notice that the coefficient of $x$ in the first equation is $5,$ and the coefficient of $x$ in the second equation is $-5.$ \n\nSince these numbers add to zero, we can add the two equations, *eliminate* the variable $x,$ and solve the resulting equation for $y:$\n\n$$\n\\begin{aligned}\\cancel{5x}+2y & =45 \\\\ -\\cancel{5x}-7y & =-70 \\\\ (2y-7y) & =(45-70) \\\\ -5y & =-25 \\\\ y & =5\\end{aligned}\n$$\n\nSo, the solution must have $y=5.$ However, we still need to find $x.$ To do this, we substitute $y=5$ back into one of the equations. Let's choose the first equation:\n\n$$\n\\begin{aligned}5x+2y & =45 \\\\ 5x+2(5) & =45 \\\\ 5x+10 & =45 \\\\ 5x & =35 \\\\ x & =7\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=7,\\,y=5,$ which can be expressed as $(\\,7,5\\,).$"} :step/id #uuid "b651d884-2534-5e34-b6eb-6c5d837c21b3" :step/next {:db/id #edb/ref 17592186559922}}] :activity/title "Introduction to the Elimination Method" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186559002}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186139371} :activity/id #uuid "ddf9f6c0-2c82-5508-b796-5212ce1fc527" :activity/scope {:db/id #edb/ref 17592186049092 :topic/id #uuid "d9ba8adc-063a-54f1-8d4e-3ac01a6c2237" :topic/math-academy-id 2231} :activity/steps [{:db/id #edb/ref 17592186139371 :step/content {:db/id #edb/ref 17592186139598 :tutorial/content "Sometimes, when we are choosing an appropriate unit, we are not given any formula to use. \n\nThis often occurs when we measure the **rate of change** of something. A rate of change measures how much something changes as we change something else.\n\nIn such cases, we can use a quotient to work out an appropriate unit. The numerator is what we measure the change of, and the denominator is what we change:\n\n$$\n\\dfrac{\\color{blue}\\textrm{what we measure the change of}}{\\color{red}\\textrm{what we change}}\n$$\n\nFor instance, suppose that a newly opened store wants to measure the rate at which the number of customers increases each day.\n\nWe *measure the change* of the number of customers, as *we change* the number of days, so the most appropriate unit is\n\n$$\n\\dfrac{\\color{blue}\\textrm{customers}}{\\color{red}\\textrm{day}},\n$$\n\nor, customers per day." :tutorial/id #uuid "56217ef8-a09e-5cdd-91f3-7f35d3cba561" :tutorial/math-academy-id 1401 :tutorial/title "Introduction"} :step/id #uuid "81f48e8d-1f8d-5602-aaa8-6dbfe592f877" :step/math-academy-id 3029 :step/next {:db/id #edb/ref 17592186139372}} {:db/id #edb/ref 17592186139372 :step/content {:db/id #edb/ref 17592186138440 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138313 :question/id #uuid "66c31f3c-2abb-51ff-b8d5-8377aeb90d80" :question/math-academy-id "e-901"} :knowledge-point/id #uuid "86db8dde-c4ad-5ba3-9022-afe85acbc3d8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050076}] :knowledge-point/questions [{:db/id #edb/ref 17592186138794} {:db/id #edb/ref 17592186138819} {:db/id #edb/ref 17592186496240} {:db/id #edb/ref 17592186496253}] :knowledge-point/title "Choosing Appropriate Units When Base Units Are Not Required"} :step/id #uuid "fc01ce33-f078-54a8-aba9-533e122ac058" :step/math-academy-id 3033 :step/next {:db/id #edb/ref 17592186139408}} {:db/id #edb/ref 17592186139408 :step/content {:db/id #edb/ref 17592186138458 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138211 :question/id #uuid "f0782388-8184-5922-8e9e-d9edcf727264" :question/math-academy-id "e-1526"} :knowledge-point/id #uuid "010539bb-ae6a-5071-a7bd-25c40d5a9717" :knowledge-point/questions [{:db/id #edb/ref 17592186139085} {:db/id #edb/ref 17592186139086} {:db/id #edb/ref 17592186496279} {:db/id #edb/ref 17592186496280} {:db/id #edb/ref 17592186559784}] :knowledge-point/title "Choosing Appropriate Units When Base Units Are Required"} :step/id #uuid "224fd6c9-017e-5d25-880a-8e0f92b408fe" :step/math-academy-id 4786}] :activity/title "Selecting Units for Rates of Change" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186138591}] [{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186153254} :activity/id #uuid "a59e2561-e0dc-5240-8024-effab456d18a" :activity/scope {:db/id #edb/ref 17592186049141 :topic/id #uuid "de04f42d-8248-5b77-8683-487f694fba77" :topic/math-academy-id 2554} :activity/steps [{:db/id #edb/ref 17592186153254 :step/content {:db/id #edb/ref 17592186153437 :tutorial/content "Recall that two variables, $x$ and $y,$ are said to have a proportional relationship if their ratio is constant. The constant of proportionality $k$ is given by\n\n$$\nk = \\dfrac{y}{x}.\n$$\n\nWe can rearrange the equation above as follows:\n\n$$\ny = kx\n$$\n\nThe following statements are all equivalent:\n\n- $y = kx$\n\n- $y$ **varies directly** with $x$\n\n- $y$ is **directly proportional** to $x$\n\n- $y \\propto x$\n\nProportional relationships frequently occur in real-world problems. Let's see an example." :tutorial/id #uuid "cd20b689-18a3-54cb-97a9-7fa52d610ec1" :tutorial/math-academy-id 8191 :tutorial/title "Introduction"} :step/id #uuid "d67d1aae-88f2-5c83-9e8b-9cb74a319475" :step/math-academy-id 54183 :step/next {:db/id #edb/ref 17592186153255}} {:db/id #edb/ref 17592186153255 :step/content {:db/id #edb/ref 17592186152270 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151824 :question/id #uuid "e85107d6-ecdf-526d-a7ce-091d028039eb" :question/math-academy-id "e-13098"} :knowledge-point/id #uuid "8d510b2f-df38-5fbe-a420-4ea79135488c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049405}] :knowledge-point/questions [{:db/id #edb/ref 17592186152664} {:db/id #edb/ref 17592186152665} {:db/id #edb/ref 17592186498525} {:db/id #edb/ref 17592186498527} {:db/id #edb/ref 17592186498574}] :knowledge-point/title "Computing a Constant of Proportionality"} :step/id #uuid "2b45a9cd-8289-51d2-8e4f-c06b2b089b8c" :step/math-academy-id 54184 :step/next {:db/id #edb/ref 17592186153256}} {:db/id #edb/ref 17592186153256 :step/content {:db/id #edb/ref 17592186152271 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151825 :question/id #uuid "15f20ecd-503f-5748-b004-680b5fc127c1" :question/math-academy-id "e-13099"} :knowledge-point/id #uuid "2a9d0449-2b61-5979-bd5c-94c33c8899c2" :knowledge-point/questions [{:db/id #edb/ref 17592186152607} {:db/id #edb/ref 17592186152666} {:db/id #edb/ref 17592186498489} {:db/id #edb/ref 17592186498600} {:db/id #edb/ref 17592186559857}] :knowledge-point/title "Identifying the Equation of a Proportional Relationship"} :step/id #uuid "db6fedfb-85d0-5eb6-a2b9-f9df621ac942" :step/math-academy-id 54187 :step/next {:db/id #edb/ref 17592186153257}} {:db/id #edb/ref 17592186153257 :step/content {:db/id #edb/ref 17592186152272 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151826 :question/id #uuid "6b17572d-a8f7-523f-9697-ae16f3d84398" :question/math-academy-id "e-13100"} :knowledge-point/id #uuid "3f29a835-91e3-51e3-a016-e13d296b7654" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050613}] :knowledge-point/questions [{:db/id #edb/ref 17592186152608} {:db/id #edb/ref 17592186152667} {:db/id #edb/ref 17592186498523} {:db/id #edb/ref 17592186498528} {:db/id #edb/ref 17592186559811} {:db/id #edb/ref 17592186559849}] :knowledge-point/title "Solving for an Unknown Amount"} :step/id #uuid "8a87b9ba-c67e-5da1-b438-76dadef85d15" :step/math-academy-id 54190}] :activity/title "Understanding Proportional Relationships From Descriptions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186152312}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186559921} :activity/id #uuid "a6fc1838-76b5-5520-9919-4902b4fe7101" :activity/scope {:db/id #edb/ref 17592186049141 :topic/id #uuid "de04f42d-8248-5b77-8683-487f694fba77" :topic/math-academy-id 2554} :activity/steps [{:db/id #edb/ref 17592186559921 :step/content {:db/id #edb/ref 17592186152666 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "103709a2-22c6-5949-b0cd-dcd0a6b21cb1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=900x" :db/id #edb/ref 17592186559055} {:answer/id #uuid "28206bbb-1d0c-5761-98a7-04bf422d3d59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{225}{x}" :db/id #edb/ref 17592186559116} {:answer/id #uuid "43b4ca6f-6da3-5d02-ad82-9a4ba6031881" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{x}{225}" :db/id #edb/ref 17592186559192} {:answer/id #uuid "6f2f078c-1c25-5c7c-888a-0e00bc4cb766" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=450x" :db/id #edb/ref 17592186559291} {:answer/id #uuid "7f6e8d8b-8c88-56a9-9d7a-dfc845a80f68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=225x" :db/id #edb/ref 17592186559332}] :answer-field/correct {:db/id #edb/ref 17592186559332} :answer-field/id #uuid "f68181be-98c9-5512-b756-2bae65bbe2ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186150503}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2352802a-045d-530a-8500-09dde40a2d51" :question/math-academy-id "q-68126" :question/problem "Jordan wants to paint the outside of his home. Using $2$ gallons of paint, he was able to paint $450$ square feet of the surface. There is a proportional relationship between the volume of paint $x$ (in gallons) that Jordan uses and the area $y$ (in square feet) he paints. What is the equation that represents the relationship between $x$ and $y?$" :question/worked-solution "Every proportional relationship takes the form $y=kx,$ where $k$ is the constant of proportionality.\n\nWe are told that Jordan painted $y=450$ square feet using $x=2$ gallons of paint.\n\nWe can find the constant of proportionality by computing the ratio of the $y$-value to the $x$-value, as follows:\n\n$$\nk=\\frac{y}{x}=\\frac{450}{2}=225\n$$\n\nTherefore, the equation is\n\n$$\ny=225x.\n$$"} :step/id #uuid "47b80ac9-74af-5bd8-9d8e-2a4389248412" :step/next {:db/id #edb/ref 17592186559970}} {:db/id #edb/ref 17592186559929 :step/content {:db/id #edb/ref 17592186559849 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9625a562-0617-5d9b-abc5-16cb402a5d88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-20" :db/id #edb/ref 17592186559391}] :answer-field/correct {:db/id #edb/ref 17592186559391} :answer-field/id #uuid "0bac2356-e89d-5b9a-9d4b-f566c2759495" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186559645}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b590fcf1-ec20-533b-be69-95e4b245f98f" :question/math-academy-id "q-170877" :question/problem "Suppose $v$ is directly proportional to $u.$ Given that $v=-12$ when $u=3$, find the value of $v$ when $u=5.${{field-1}}." :question/worked-solution "Since $v$ varies directly with $u,$ we use the equation\n\n$$\nv=ku.\n$$\n\nWe are told that $v=-12$ when $u=3.$ We substitute this data into the equation to find $k:$\n\n$$\n\\begin{aligned}-12 & =k\\cdot 3 \\\\ \\frac{(-12)}{3} & =k \\\\ -4 & =k\\end{aligned}\n$$\n\nSo, the direct variation equation is given by\n\n$$\nv=-4u.\n$$\n\nFinally, substituting the value of $u=5$ into this equation gives\n\n$$\n\\begin{aligned}v & =-4\\cdot 5=-20.\\end{aligned}\n$$"} :step/id #uuid "5272e248-00bc-5399-9b74-6540dfa2cf52"} {:db/id #edb/ref 17592186559970 :step/content {:db/id #edb/ref 17592186559811 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "084c23f6-d996-50e5-a433-1f7029a87dd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-31" :db/id #edb/ref 17592186559032} {:answer/id #uuid "139bd3a5-a604-5f9b-9ae1-5ed234a6ade6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "31" :db/id #edb/ref 17592186559060} {:answer/id #uuid "52dc2da6-2a46-5aa0-a09e-218bf0c62453" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-21" :db/id #edb/ref 17592186559225} {:answer/id #uuid "b784a9d6-44a1-5356-9039-0276f2c60082" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "62" :db/id #edb/ref 17592186559474} {:answer/id #uuid "f0abb498-6f9d-58b7-99be-b0bcc10995cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-62" :db/id #edb/ref 17592186559602}] :answer-field/correct {:db/id #edb/ref 17592186559602} :answer-field/id #uuid "7219bea5-8ca7-51f2-9ec4-6aea1bd10dc8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559708}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5ce15c8c-b8c7-513a-aedc-297e6604d6a3" :question/math-academy-id "q-115600" :question/problem "Let $b$ be directly proportional to $g.$ Given that $b=98$ when $g=-7$, find the value of $b$ when $g=\\frac{31}{7}.$" :question/worked-solution "Since $b$ varies directly with $g,$ we use the equation\n\n$$\nb=kg.\n$$\n\nWe are told that $b=98$ when $g=-7.$ We substitute this data into the equation to find $k:$\n\n$$\n\\begin{aligned}98 & =k\\cdot (-7) \\\\ \\frac{98}{(-7)} & =k \\\\ -14 & =k\\end{aligned}\n$$\n\nSo, the direct variation equation is given by\n\n$$\nb=-14g.\n$$\n\nFinally, substituting the value of $g=\\frac{31}{7}$ into this equation gives\n\n$$\n\\begin{aligned}b & =-14\\cdot \\frac{31}{7} \\\\  & =-2\\cdot 31 \\\\  & =-62.\\end{aligned}\n$$"} :step/id #uuid "c8307780-4519-5f2b-8645-dac88fec372c" :step/next {:db/id #edb/ref 17592186559929}}] :activity/title "Understanding Proportional Relationships From Descriptions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186559008}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186139507} :activity/id #uuid "b0017abd-99d5-54d3-8a58-5379b4b38c75" :activity/scope {:db/id #edb/ref 17592186049200 :topic/id #uuid "e2ea8cb9-99ed-50a0-9f84-e14a154720d8" :topic/math-academy-id 2270} :activity/steps [{:db/id #edb/ref 17592186139507 :step/content {:db/id #edb/ref 17592186139664 :tutorial/content "To solve an equation with a decimal coefficient, such as \n\n$$\n0.2x = -1,\n$$\n\nwe start by getting rid of the decimal. To do this, we multiply both sides of the equation by ${\\color{blue}10}.$ Multiplying a decimal by $10$ shifts the decimal place one spot over to the right.\n\n$$\n\\begin{aligned}0.2x & =-1 \\\\ 10\\cdot (0.2x) & =10\\cdot (-1) \\\\ 2x & =-10\\end{aligned}\n$$\n\nThen, we solve the equation using the multiplication principle, as usual:\n\n$$\n\\begin{aligned}2x & =-10 \\\\ \\frac{2x}{2} & =\\frac{-10}{2} \\\\ \\frac{\\cancel{2}x}{\\cancel{2}} & =-\\frac{10}{2} \\\\ x & =-5\\end{aligned}\n$$" :tutorial/id #uuid "b3690d9a-5c80-54c4-b523-5aef327aa8f0" :tutorial/math-academy-id 8147 :tutorial/title "Introduction"} :step/id #uuid "1fb7ee48-ceed-57fd-b2ac-c96be2c76bf9" :step/math-academy-id 77041 :step/next {:db/id #edb/ref 17592186139508}} {:db/id #edb/ref 17592186139508 :step/content {:db/id #edb/ref 17592186138526 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138077 :question/id #uuid "6ff19222-3f56-53cf-bd39-b399573664b8" :question/math-academy-id "e-13026"} :knowledge-point/id #uuid "e0576504-7bd6-5649-99fe-a758faaffa4b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048392} {:db/id #edb/ref 17592186049747} {:db/id #edb/ref 17592186050613}] :knowledge-point/questions [{:db/id #edb/ref 17592186138814} {:db/id #edb/ref 17592186138815} {:db/id #edb/ref 17592186487297} {:db/id #edb/ref 17592186487347} {:db/id #edb/ref 17592186559802}] :knowledge-point/title "Solving Linear Equations Containing Single-Digit Decimals"} :step/id #uuid "364c2756-fa89-54cc-b2db-95feab14b48c" :step/math-academy-id 77042 :step/next {:db/id #edb/ref 17592186139509}} {:db/id #edb/ref 17592186139509 :step/content {:db/id #edb/ref 17592186139665 :tutorial/content "How do we get rid of the decimal in an equation like\n\n$$\n0.25x = 2,\n$$\n\nwhen there is more than one number behind the decimal place? If we multiply by $10$ as usual, we shift the decimal place over one spot to the right:\n\n$$\n\\begin{aligned}0.25x & =2 \\\\ 10\\cdot (0.25x) & =10\\cdot (2) \\\\ 2.5x & =20\\end{aligned}\n$$\n\nHowever, there is still one number behind the decimal place. So, we can multiply by $10$ again:\n\n$$\n\\begin{aligned}2.5x & =20 \\\\ 10\\cdot (2.5x) & =10\\cdot (20) \\\\ 25x & =200\\end{aligned}\n$$\n\nNow that our equation contains only whole numbers, we can continue with the usual method of applying the multiplication principle:\n\n$$\n\\begin{aligned}25x & =200 \\\\ \\frac{25x}{25} & =\\frac{200}{25} \\\\ \\frac{\\cancel{25}x}{\\cancel{25}} & =\\frac{200}{25} \\\\ x & =8\\end{aligned}\n$$\n\nLooking back, we can see a faster way to apply the same method. We multiplied by $10$ twice, which means that overall, we multiplied by $100.$ In general, multiplying a decimal by $100$ shifts the decimal place over two spots to the right. So, we could have solved the equation faster by multiplying by $100.$\n\n$$\n\\begin{aligned}0.25x & =2 \\\\ 100\\cdot (0.25x) & =100\\cdot (2) \\\\ 25x & =200 \\\\ \\frac{25x}{25} & =\\frac{200}{25} \\\\ \\frac{\\cancel{25}x}{\\cancel{25}} & =\\frac{200}{25} \\\\ x & =8\\end{aligned}\n$$" :tutorial/id #uuid "50c650c0-be15-5aa0-87c5-181d41d15934" :tutorial/math-academy-id 8148 :tutorial/title "Solving Linear Equations with More than One Decimal Place"} :step/id #uuid "82c64b9e-8aa0-5f1b-8c24-1c35d17dc86b" :step/math-academy-id 77046 :step/next {:db/id #edb/ref 17592186139510}} {:db/id #edb/ref 17592186139510 :step/content {:db/id #edb/ref 17592186138527 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138078 :question/id #uuid "015eac36-e18d-5a53-bfff-f301722a1f0c" :question/math-academy-id "e-13027"} :knowledge-point/id #uuid "039fc0a8-337f-50b3-be2c-cfbdbd399537" :knowledge-point/questions [{:db/id #edb/ref 17592186138811} {:db/id #edb/ref 17592186139074} {:db/id #edb/ref 17592186487313} {:db/id #edb/ref 17592186487356}] :knowledge-point/title "Solving Linear Equations Containing Two-Digit Decimals"} :step/id #uuid "f7c6198b-012e-5cff-b87c-52603f1f404e" :step/math-academy-id 77047 :step/next {:db/id #edb/ref 17592186139511}} {:db/id #edb/ref 17592186139511 :step/content {:db/id #edb/ref 17592186138528 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138079 :question/id #uuid "49ed1c21-223b-5dda-8f4d-7b6a3492a26b" :question/math-academy-id "e-13028"} :knowledge-point/id #uuid "68f57411-1d39-52cd-86ee-abf633adf3c3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673}] :knowledge-point/questions [{:db/id #edb/ref 17592186138812} {:db/id #edb/ref 17592186138813} {:db/id #edb/ref 17592186487301} {:db/id #edb/ref 17592186487372}] :knowledge-point/title "Solving Two-Step Equations"} :step/id #uuid "b47f949a-8886-5418-81d1-5442ddd763e1" :step/math-academy-id 77051}] :activity/title "Solving Linear Equations With Decimal Coefficients" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186138597}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186173015} :activity/id #uuid "0db9f058-2c2b-5d1f-a85c-11f1e1e699e3" :activity/scope {:db/id #edb/ref 17592186049636 :topic/id #uuid "07291a04-1a38-5ba5-bc33-f7a4e1cf0c19" :topic/math-academy-id 3536} :activity/steps [{:db/id #edb/ref 17592186172867 :step/content {:db/id #edb/ref 17592186172015 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171819 :question/id #uuid "9c4b5b23-3d35-593a-ae69-4766e5b1d996" :question/math-academy-id "e-6800"} :knowledge-point/id #uuid "72810e1e-8a12-5488-8aac-3a94cc027e68" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048159} {:db/id #edb/ref 17592186050452}] :knowledge-point/questions [{:db/id #edb/ref 17592186172573} {:db/id #edb/ref 17592186172574} {:db/id #edb/ref 17592186498498}] :knowledge-point/title "Simplifying Absolute Value Expressions"} :step/id #uuid "4c2ee3dc-ab94-51f0-bcdc-ab20413c5355" :step/math-academy-id 25123 :step/next {:db/id #edb/ref 17592186173102}} {:db/id #edb/ref 17592186173015 :step/content {:db/id #edb/ref 17592186173210 :tutorial/content "In this lesson, we'll extend our knowledge of absolute value. \n\nLet's first remind ourselves of the rules of absolute value:\n\n- $|{-a}| = |a|$\n\n- $|a \\cdot b| = |a| \\cdot |b|$\n\n- $\\left| \\dfrac{a}{b} \\right| = \\dfrac{|a|}{|b|}$\n\nRecall that the last two rules are known as the **distributive properties.**" :tutorial/id #uuid "3d23d2e9-6bc0-5a8b-bdb3-84a2f0e9d4d6" :tutorial/math-academy-id 6010 :tutorial/title "Introduction"} :step/id #uuid "de7a2169-7d86-5d52-813f-d1d199541882" :step/math-academy-id 36685 :step/next {:db/id #edb/ref 17592186172867}} {:db/id #edb/ref 17592186173035 :step/content {:db/id #edb/ref 17592186172111 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171714 :question/id #uuid "8b27c37f-10a7-5e55-8230-916bb246142b" :question/math-academy-id "e-1238"} :knowledge-point/id #uuid "2b534245-8276-5e9b-8b9f-0d749116477a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050428}] :knowledge-point/questions [{:db/id #edb/ref 17592186172550} {:db/id #edb/ref 17592186172584} {:db/id #edb/ref 17592186498552} {:db/id #edb/ref 17592186498592} {:db/id #edb/ref 17592186559824}] :knowledge-point/title "Simplifying the Absolute Value of a Square"} :step/id #uuid "a35c659d-3a92-5292-a856-8e051b0df01d" :step/math-academy-id 3977 :step/next {:db/id #edb/ref 17592186173103}} {:db/id #edb/ref 17592186173036 :step/content {:db/id #edb/ref 17592186172112 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171715 :question/id #uuid "e0d4030c-4490-5e36-af26-7ded6003e841" :question/math-academy-id "e-1239"} :knowledge-point/id #uuid "60502703-f918-51c6-98dc-62fdd6e3241e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050519}] :knowledge-point/questions [{:db/id #edb/ref 17592186172314} {:db/id #edb/ref 17592186172549} {:db/id #edb/ref 17592186498496} {:db/id #edb/ref 17592186498593}] :knowledge-point/title "Evaluating an Absolute Value Expression with a Domain Restriction"} :step/id #uuid "6c3441ba-31e5-52c4-9a8b-3e8a4cd3a43d" :step/math-academy-id 3978} {:db/id #edb/ref 17592186173102 :step/content {:db/id #edb/ref 17592186173140 :tutorial/content "We know that the absolute value operation does nothing to a number if it is non-negative. For example:\n\n$$\n\\begin{aligned}|0| & =0 \\\\ |1| & =1 \\\\ |2| & =2 \\\\ |3| & =3 \\\\  & ⋮\\end{aligned}\n$$\n\nWe can summarize this fact as follows:\n\n$$\n|x| = x \\quad \\text{ if } \\quad x \\geq 0\n$$\n\nWe also know that $x^2$ is non-negative for any value of $x$. Therefore, \n\n$$\n\\left|x^2\\right| = x^2\n$$\n\nwhere $x$ is *any* real number." :tutorial/id #uuid "b20a7fe3-4627-5ed7-a7dd-afd383fa3c59" :tutorial/math-academy-id 1716 :tutorial/title "The Absolute Value of a Square"} :step/id #uuid "f329f688-b5f5-5222-a1c0-599debe7606f" :step/math-academy-id 5019 :step/next {:db/id #edb/ref 17592186173035}} {:db/id #edb/ref 17592186173103 :step/content {:db/id #edb/ref 17592186173141 :tutorial/content "We know that $|x|=x$ if $x \\geq 0.$ But what if $x < 0?$\n\nIf a variable is known to be negative, then the absolute value changes it to positive. To turn a negative number into a positive number, we multiply by $-1.$ Therefore, we have\n\n$$\n|x|  = -x \\quad\\textrm{for}\\quad x < 0.\n$$\n\nTo convince ourselves that this is indeed true, let's verify it in the case when $x=-2.$ Substituting this value into the above, we get\n\n$$\n\\begin{aligned}|-2| & =-(-2)=2.\\,✓\\end{aligned}\n$$" :tutorial/id #uuid "93c4f77c-611c-5870-88b3-e76b8bbc7275" :tutorial/math-academy-id 1831 :tutorial/title "The Absolute Value of a Negative Variable"} :step/id #uuid "3819c50d-8c6b-5e33-b8c9-e35bd4855c00" :step/math-academy-id 5922 :step/next {:db/id #edb/ref 17592186173036}}] :activity/title "Further Rules of Absolute Value" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186172208}] [{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186088543} :activity/id #uuid "cfe67386-85ee-52bc-a19f-9e5f91df386d" :activity/scope {:db/id #edb/ref 17592186049840 :topic/id #uuid "17f87fcb-3fe5-5ecd-ba54-8883ffee898f" :topic/math-academy-id 839} :activity/steps [{:db/id #edb/ref 17592186088543 :step/content {:db/id #edb/ref 17592186088991 :tutorial/content "The **standard form** equation of a line is \n\n$$\nax+by=c,\n$$\n\nwhere\n\n- $a,b,$ and $c$ are all integers,\n\n- $a \\geq 0,$ and\n\n- $a,b,$ and $c$ have no common factors.\n\nNote that we always write $x$ *before* $y$ on the left-hand side!\n\nLet's see some examples:\n\n- The equation $2x - y= -5$ is in standard form. Indeed, the variables are on the left-hand side, while the constant term is on the right-hand side:\n\n$$\n\\underbrace{2x - y}_{\\textrm{variables}} \\quad = \\underbrace{-5\\phantom{y}}_{\\textrm{constant}}\n$$\n\n \nAll coefficients are integers (namely, $2,$ $-1,$ and $-5$) and don't have common factors greater than $1.$ Also, the coefficient of $x$ is non-negative ($2$).\n\n- The equation $-3x + y = 1$ is *not* in standard form because the coefficient of $x$ is negative ($-3$).\n\n- The equation $2x+4y = -10$ is *not* in standard form because the coefficients $(2,4,$ and $-10)$ have a common factor of $2.$\n\n- The equation $\\dfrac12x+\\dfrac13y = 6$ is *not* in standard form because the coefficients of $x$ and $y$ are not integers." :tutorial/id #uuid "739ff387-5940-547f-adac-8b2ac8e5a229" :tutorial/math-academy-id 9126 :tutorial/title "Introduction"} :step/id #uuid "0f6a809a-5a39-577f-8881-246e8ed35867" :step/math-academy-id 178720 :step/next {:db/id #edb/ref 17592186088544}} {:db/id #edb/ref 17592186088544 :step/content {:db/id #edb/ref 17592186087709 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087437 :question/id #uuid "5faa755c-1e2d-52a7-a521-49f79b94ec39" :question/math-academy-id "e-14709"} :knowledge-point/id #uuid "8e2458e5-8061-5f3f-9b4f-4d0bdd0ec641" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049935} {:db/id #edb/ref 17592186050581}] :knowledge-point/questions [{:db/id #edb/ref 17592186088071} {:db/id #edb/ref 17592186088074} {:db/id #edb/ref 17592186088219} {:db/id #edb/ref 17592186493927} {:db/id #edb/ref 17592186493955}] :knowledge-point/title "Identifying Equations Written in Standard Form"} :step/id #uuid "e1825121-20e1-5854-9a35-360f43ffb277" :step/math-academy-id 178721 :step/next {:db/id #edb/ref 17592186088545}} {:db/id #edb/ref 17592186088545 :step/content {:db/id #edb/ref 17592186088993 :tutorial/content "Let's now discuss how to convert the equation of a line to standard form.\n\nTo illustrate, we will take the line $y = 2x-1$ and convert it into standard form. We begin by moving all of the variables to the left-hand side and all of the constants to the right-hand side.\n\n$$\n\\begin{aligned}y & =2x-1 \\\\ y-2x & =-1 \\\\ -2x+y & =-1\\end{aligned}\n$$\n\nNow the equation is in the form $ax+by=c.$ However, it violates the rule $a \\geq 0.$ We can fix this by multiplying the equation by $-1$ as follows:\n\n$$\n\\begin{aligned}-2x+y & =-1 \\\\ (-1)\\cdot (-2x+y) & =(-1)\\cdot (-1) \\\\ 2x-y & =1\\end{aligned}\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a \\geq 0.$ So, we are done!\n\nThe standard form of the line is $2x-y=1.$" :tutorial/id #uuid "914fb469-510e-5e74-92bc-6174870cbd47" :tutorial/math-academy-id 9221 :tutorial/title "Converting a Line to Standard Form"} :step/id #uuid "1ad80f23-5479-5329-8fd1-39cf7d32c8f0" :step/math-academy-id 178725 :step/next {:db/id #edb/ref 17592186088546}} {:db/id #edb/ref 17592186088546 :step/content {:db/id #edb/ref 17592186087710 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087438 :question/id #uuid "7a4196bc-1f72-5435-9c00-c1fbef60b549" :question/math-academy-id "e-14710"} :knowledge-point/id #uuid "f399f6ed-91bc-594e-9a40-b7c79f60c5dc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050622}] :knowledge-point/questions [{:db/id #edb/ref 17592186088065} {:db/id #edb/ref 17592186088299} {:db/id #edb/ref 17592186088300} {:db/id #edb/ref 17592186235494} {:db/id #edb/ref 17592186493934} {:db/id #edb/ref 17592186493940} {:db/id #edb/ref 17592186523946} {:db/id #edb/ref 17592186551270}] :knowledge-point/title "Converting from Slope-Intercept Form to Standard Form"} :step/id #uuid "219a19a2-5ca7-55ec-b664-706e0003f956" :step/math-academy-id 178726 :step/next {:db/id #edb/ref 17592186088547}} {:db/id #edb/ref 17592186088547 :step/content {:db/id #edb/ref 17592186087711 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087439 :question/id #uuid "9e0c4000-c24e-5761-8cbe-60699b557eca" :question/math-academy-id "e-14711"} :knowledge-point/id #uuid "daa37544-c4ec-5b8b-91a5-ccf5ee8f50d6" :knowledge-point/questions [{:db/id #edb/ref 17592186088002} {:db/id #edb/ref 17592186088069} {:db/id #edb/ref 17592186493922} {:db/id #edb/ref 17592186493928} {:db/id #edb/ref 17592186501171} {:db/id #edb/ref 17592186526035}] :knowledge-point/title "Converting an Arbitrary Line to Standard Form"} :step/id #uuid "54390c19-603c-54bd-bf54-163d31414029" :step/math-academy-id 178730 :step/next {:db/id #edb/ref 17592186088548}} {:db/id #edb/ref 17592186088548 :step/content {:db/id #edb/ref 17592186087712 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087440 :question/id #uuid "f78832f7-acd3-5779-b171-0650782b918e" :question/math-academy-id "e-14712"} :knowledge-point/id #uuid "eefba93e-12c7-5835-80fb-b36463f140d8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049061} {:db/id #edb/ref 17592186050635}] :knowledge-point/questions [{:db/id #edb/ref 17592186088066} {:db/id #edb/ref 17592186088070} {:db/id #edb/ref 17592186088301} {:db/id #edb/ref 17592186493891} {:db/id #edb/ref 17592186501182} {:db/id #edb/ref 17592186501213}] :knowledge-point/title "Finding the Standard Equation of a Line Passing Through Two Points"} :step/id #uuid "5756f274-95fd-5077-9cb0-2b24aadadb72" :step/math-academy-id 178733}] :activity/title "Equations of Lines in Standard Form" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186087911}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186501288} :activity/id #uuid "ea710b72-1ae9-594f-81f0-bb4e388075ac" :activity/scope {:db/id #edb/ref 17592186049840 :topic/id #uuid "17f87fcb-3fe5-5ecd-ba54-8883ffee898f" :topic/math-academy-id 839} :activity/steps [{:db/id #edb/ref 17592186501256 :step/content {:db/id #edb/ref 17592186501171 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ff46960-a634-5a81-ae1f-2ca39d897a7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x=4y-3" :db/id #edb/ref 17592186500593} {:answer/id #uuid "79487712-6da4-5496-8225-aac3af672e2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4y=3x+3" :db/id #edb/ref 17592186500719} {:answer/id #uuid "b8f9749e-7d8c-55a2-9037-1039c6ab8a8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-2y=-1" :db/id #edb/ref 17592186500852} {:answer/id #uuid "dd48f16b-2a4a-5029-a026-63bc2965823a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-4y+3=0" :db/id #edb/ref 17592186500938} {:answer/id #uuid "ec6efbc0-8d44-5de2-87c8-4041efd1a2f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-4y=-3" :db/id #edb/ref 17592186500972}] :answer-field/correct {:db/id #edb/ref 17592186500972} :answer-field/id #uuid "5ecaf1bd-48c2-52f6-ac2e-e2c732914f1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186501059}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "654a7d79-4ae5-544e-b9a0-d1ca56a9cbc1" :question/math-academy-id "q-109618" :question/problem "Write $3-4y=-3x$ in standard form." :question/worked-solution "Our goal is to write the equation in the form $ax+by=c,$ where $a,b,$ and $c$ are integers with no common factors and $a\\ge 0.$\n\nWe begin by moving all of the variables to the left-hand side and all of the constants to the right-hand side. This gives\n\n$$\n3x-4y=-3.\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a\\ge 0.$ So we are done!\n\nThe standard form of the line is $3x-4y=-3.$"} :step/id #uuid "20f07fd1-d467-5612-a99b-42e2c6facda8"} {:db/id #edb/ref 17592186501288 :step/content {:db/id #edb/ref 17592186501182 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4948554b-8702-53e2-9b75-d60c9757c1b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-2y=1" :db/id #edb/ref 17592186500613} {:answer/id #uuid "81c06851-5a55-515e-b014-4e1a61503690" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2y=3x-1" :db/id #edb/ref 17592186500734} {:answer/id #uuid "9a1bd908-d894-5634-a386-eae6d2558b62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7x-4y=0" :db/id #edb/ref 17592186500780} {:answer/id #uuid "ace9b919-181f-5f85-aacf-3f2308c62bcf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-\\frac{4}{7}\\,y=0" :db/id #edb/ref 17592186500824} {:answer/id #uuid "fc01bcb9-ef79-5851-a139-46cdb6164d5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4y=7x" :db/id #edb/ref 17592186501004}] :answer-field/correct {:db/id #edb/ref 17592186500780} :answer-field/id #uuid "cf0b3dce-d893-5070-8809-d9f2b47f02b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186501112}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7638fe82-2585-52d0-beb7-40611addaef6" :question/math-academy-id "q-44202" :question/problem "What is the equation of the line that passes through the points $(0,0)$ and $(4,7)$, expressed in standard form?" :question/worked-solution "First, we will construct the point-slope form of the line. Then, we will simplify it into standard form.\n\nTo construct the point-slope form of the line, we need a point and a slope. We already have two points, so we calculate the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{7-0}{4-0}=\\frac{7}{4}\\end{aligned}\n$$\n\nThen, we use this slope along with one of the points to write the point-slope form equation of the line. It doesn't matter which point we choose, but let's choose $(0,0).$ The point-slope equation is as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-0 & =\\frac{7}{4}(x-0) \\\\ y & =\\frac{7}{4}x\\end{aligned}\n$$\n\nTo simplify the point-slope formula into standard form, we first multiply by $4$ to get rid of the fraction:\n\n$$\n\\begin{aligned}y & =\\frac{7}{4}(x) \\\\ 4\\cdot (y) & =4\\cdot \\frac{7}{4}(x) \\\\ 4y & =7x\\end{aligned}\n$$\n\nThen, we move the variables to the left side and the constant to the right side:\n\n$$\n\\begin{aligned}4y & =7x \\\\ -7x+4y & =0\\end{aligned}\n$$\n\nFinally, we multiply by $-1$ to make the $x$-coefficient positive:\n\n$$\n\\begin{aligned}-7x+4y & =0 \\\\ (-1)\\cdot (-7x+4y) & =(-1)\\cdot 0 \\\\ 7x-4y & =0\\end{aligned}\n$$\n\nSo, the standard form of the equation is $7x-4y=0.$"} :step/id #uuid "b7421da9-e8bc-5823-9858-330f84d2ecf1" :step/next {:db/id #edb/ref 17592186501292}} {:db/id #edb/ref 17592186501292 :step/content {:db/id #edb/ref 17592186501213 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa1d2cc4-2934-5c01-acf3-e4688de64dff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4x-y=6" :db/id #edb/ref 17592186500819} {:answer/id #uuid "c0d0840e-b8f1-5833-899d-775ab6668a32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x-y=3" :db/id #edb/ref 17592186500867} {:answer/id #uuid "c3d3f7b4-e921-553d-88ad-be60876e12b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2x-3" :db/id #edb/ref 17592186500877} {:answer/id #uuid "ca9d0db1-1d42-546b-8c61-bc0bc89d225c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4x+y=-6" :db/id #edb/ref 17592186500896} {:answer/id #uuid "cf99202c-1f33-5c86-9aa3-ff042e4be5ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+2y=4" :db/id #edb/ref 17592186500913}] :answer-field/correct {:db/id #edb/ref 17592186500819} :answer-field/id #uuid "2ee1d5f3-79b0-529f-9d27-584c54dd513d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186501034}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b34b9e0f-ca1a-53ee-8948-5e07722771b6" :question/math-academy-id "q-72425" :question/problem "What is the equation of the line that passes through the points $(1,-2)$ and $(3,6)$, expressed in standard form?" :question/worked-solution "First, we will construct the point-slope form of the line. Then, we will simplify it into standard form.\n\nTo construct the point-slope form of the line, we need a point and a slope. We already have two points, so we calculate the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{6-(-2)}{3-1}=\\frac{8}{2}=4\\end{aligned}\n$$\n\nThen, we use this slope along with one of the points to write the point-slope form equation of the line. It doesn't matter which point we choose, but let's choose $(1,-2).$ The point-slope equation is as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-2) & =4(x-1) \\\\ y+2 & =4(x-1)\\end{aligned}\n$$\n\nNext, we simplify the point-slope formula into standard form, moving the variables to the left side and the constant to the right side:\n\n$$\n\\begin{aligned}y+2 & =4(x-1) \\\\ y+2 & =4x-4 \\\\ y & =4x-6 \\\\ -4x+y & =-6\\end{aligned}\n$$\n\nFinally, we multiply by $-1$ to make the $x$-coefficient positive:\n\n$$\n\\begin{aligned}-4x+y & =-6 \\\\ (-1)\\cdot (-4x+y) & =(-1)\\cdot (-6) \\\\ 4x-y & =6\\end{aligned}\n$$\n\nSo, the standard form of the equation is $4x-y=6.$"} :step/id #uuid "dbbb55d2-6ac7-5cb1-a4a3-8f1b82a1b491" :step/next {:db/id #edb/ref 17592186501256}}] :activity/title "Equations of Lines in Standard Form" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186500468}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186526118} :activity/id #uuid "5fd46b7c-ef09-527e-bc1f-fb6f5543dee9" :activity/scope {:db/id #edb/ref 17592186049840 :topic/id #uuid "17f87fcb-3fe5-5ecd-ba54-8883ffee898f" :topic/math-academy-id 839} :activity/steps [{:db/id #edb/ref 17592186526118 :step/content {:db/id #edb/ref 17592186088300 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ce635f8-4383-5e2d-baa8-462f0646a57d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2x-10" :db/id #edb/ref 17592186525359} {:answer/id #uuid "56dcaada-2e45-5e47-b10d-7423de786283" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y-2x=10" :db/id #edb/ref 17592186525431} {:answer/id #uuid "a64fc9d9-1954-54bb-9104-2c70061145e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+y=10" :db/id #edb/ref 17592186525626} {:answer/id #uuid "a9fc8576-442e-5448-9c72-26dd2ff8c409" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x-y=10" :db/id #edb/ref 17592186525635} {:answer/id #uuid "b0e5661e-64af-5f76-ad7e-bb04261a05bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+y-10=0" :db/id #edb/ref 17592186525654}] :answer-field/correct {:db/id #edb/ref 17592186525635} :answer-field/id #uuid "8bedc031-1af4-59be-8827-ddccc40055ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186086454}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1ddc1b00-1388-5ab1-b4ec-fe79f4a369ed" :question/math-academy-id "q-7375" :question/problem "Write $y=2x-10$ in standard form." :question/worked-solution "Our goal is to write the equation in the form $ax+by=c,$ where $a,b,$ and $c$ are integers with no common factors and $a\\ge 0.$\n\nWe begin by moving all of the variables to the left-hand side and all of the constants to the right-hand side. This gives\n\n$$\n-2x+y=-10\n$$\n\nNow, we multiply both sides of the equation by $-1:$\n\n$$\n\\begin{aligned}-2x+y & =-10 \\\\ (-1)\\cdot (-2x+y) & =(-1)\\cdot (-10) \\\\ 2x-y & =10.\\end{aligned}\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a\\ge 0.$ So we are done!\n\nThe standard form of the line is $2x-y=10.$"} :step/id #uuid "5531d2d2-4653-5821-ad34-95da930170ae" :step/next {:db/id #edb/ref 17592186526148}} {:db/id #edb/ref 17592186526128 :step/content {:db/id #edb/ref 17592186088065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50e5beee-cd5d-5d0e-a06c-ed2bcb868f66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+10y" :db/id #edb/ref 17592186525416}] :answer-field/correct {:db/id #edb/ref 17592186525416} :answer-field/id #uuid "ca145851-e9d5-53d0-b524-37f7de7eeb0b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186085124} {:answer-field/choices [{:answer/id #uuid "7c83729c-0f7e-5ffe-bf01-d09e27351dab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186525515}] :answer-field/correct {:db/id #edb/ref 17592186525515} :answer-field/id #uuid "6f29fa38-38be-5d7a-8b04-017c959f4e64" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186085125}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b90758e4-7aff-5ee7-bbb0-64e72c86781c" :question/math-academy-id "q-208783" :question/problem "Express the equation of the line $y=-\\frac{1}{5}x+\\frac{1}{2}$ in standard form.\n\n{{field-1}}\n\n$=$\n{{field-2}}" :question/worked-solution "Our goal is to write the equation in the form $ax+by=c,$ where $a,b,$ and $c$ are integers with no common factors and $a\\ge 0.$\n\nWe begin by moving all of the variables to the left-hand side and all of the constants to the right-hand side. This gives\n\n$$\n\\frac{1}{5}x+y=\\frac{1}{2}\n$$\n\nNow, we multiply both sides of the equation by $10:$\n\n$$\n\\begin{aligned}\\frac{1}{5}x+y & =\\frac{1}{2} \\\\ 10\\cdot (\\frac{1}{5}x+y) & =10\\cdot (\\frac{1}{2}) \\\\ 2x+10y & =5.\\end{aligned}\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a\\ge 0.$ So we are done!\n\nThe standard form of the line is \n\n$$\n2x+10y=5.\n$$"} :step/id #uuid "81bb2396-2021-540b-9bce-0c126fd371de"} {:db/id #edb/ref 17592186526148 :step/content {:db/id #edb/ref 17592186526035 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01ceb895-6483-595f-b812-ce7792346c53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+10y=-4" :db/id #edb/ref 17592186525213} {:answer/id #uuid "38916548-028a-5017-811a-5ecb8cc9b06a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+11y=-2" :db/id #edb/ref 17592186525345} {:answer/id #uuid "669b434e-e144-50c0-890a-a5e64976a180" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-11y=-4" :db/id #edb/ref 17592186525468} {:answer/id #uuid "9f12e004-fb3b-598c-9d12-4da7ab0cd767" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+11y=-4" :db/id #edb/ref 17592186525612} {:answer/id #uuid "f2361365-100c-59dd-ae92-0d3dd51e9ba8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+11y=-4" :db/id #edb/ref 17592186525811}] :answer-field/correct {:db/id #edb/ref 17592186525811} :answer-field/id #uuid "38e9167e-6f24-5db2-a3c7-7d0d60e4c2f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186525876}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "704b5a22-e7b8-5a05-8c48-94b98e94c6e2" :question/math-academy-id "q-22753" :question/problem "Write $2x+22y=-8$ in standard form." :question/worked-solution "Our goal is to write the equation in the form $ax+by=c,$ where $a,b,$ and $c$ are integers with no common factors and $a\\ge 0.$\n\nThe equation is in the form $ax+by=c.$ However, $a,b,$ and $c$ have a common factor of $2.$ So, we divide by $2$ as follows:\n\n$$\n\\begin{aligned}2x+22y & =-8 \\\\ \\frac{2x+22y}{2} & =\\frac{-8}{2} \\\\ x+11y & =-4\\end{aligned}\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a\\ge 0.$ So we are done!\n\nThe standard form of the line is $x+11y=-4.$"} :step/id #uuid "e46359de-50c7-51f6-b170-e204f33ff01e" :step/next {:db/id #edb/ref 17592186526128}}] :activity/title "Equations of Lines in Standard Form" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186525201}] [{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186084381} :activity/id #uuid "44d765ee-f9a3-51fd-a9fb-673e5f0fd77d" :activity/scope {:db/id #edb/ref 17592186050235 :topic/id #uuid "3816ddcf-eb6f-59e3-80aa-5b965a06b098" :topic/math-academy-id 766} :activity/steps [{:db/id #edb/ref 17592186084381 :step/content {:db/id #edb/ref 17592186084509 :tutorial/content "Let $\\triangle{ABC}$ be a triangle where the lengths $AB=7$ and $AC=5$ are fixed. For example, consider the triangle shown below.\n\n![](images/e4/e4c1df256d9a40c50e3535f3055fef041cf02710c0a9e0414acae1bf38681ff4.png)\n\n      \n\nNow, suppose that we vary the angle $\\angle{A}$, making it either very small or very large. What would be the maximum possible length of the side $\\overline {BC}$ for which the figure is still a triangle?  \n\nWe make the longest possible segment $\\overline{BC}$ by increasing the angle $\\angle{A}$ as shown in the sketches below. Here, we fix vertices $A$ and $B$, and then \"rotate\" the side $\\overline{AC}$ about the vertex $A$ until $\\angle{A}$ measures $180^\\circ.$\n\n![](images/d9/d9777d021ad9aac118452b691567d325939c5c8591b777f2cf9c17b39916e660.png)\n\n          \n\nFrom the picture, we can see that when $m\\angle{A}=180^\\circ ,$ we will not have a triangle anymore and the length of $\\overline{BC}$ will be $7+5=12.$ Therefore, if we would like to have a triangle, $\\overline{BC}$ must be shorter than the sum of the other sides: \n\n$$\n\\begin{aligned}BC & <AB+AC \\\\  & <7+5 \\\\  & <12\\end{aligned}\n$$\n\nThis is true for all triangles:\n\nIn every triangle, the length of any one side must be smaller than the sum of the other two sides.\n\nThe above statement is one part of the **triangle inequality theorem**, which we will continue building upon in this lesson." :tutorial/id #uuid "29fc4755-2259-5126-bad7-5e7c73c355b7" :tutorial/math-academy-id 8192 :tutorial/title "Introduction"} :step/id #uuid "13ee6ddf-a2c8-5588-8e52-f8a84af5eba4" :step/math-academy-id 73696 :step/next {:db/id #edb/ref 17592186084382}} {:db/id #edb/ref 17592186084382 :step/content {:db/id #edb/ref 17592186083395 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082921 :question/id #uuid "25a73406-c869-5786-af97-cf90866eb1a7" :question/math-academy-id "e-13101"} :knowledge-point/id #uuid "768204cd-ee1f-5271-9ec9-71d672b4eb9e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048336}] :knowledge-point/questions [{:db/id #edb/ref 17592186083834} {:db/id #edb/ref 17592186083835} {:db/id #edb/ref 17592186497387}] :knowledge-point/title "Identifying Impossible Sides of a Triangle"} :step/id #uuid "a2043004-3f75-55f7-8ceb-e7960310878d" :step/math-academy-id 73697 :step/next {:db/id #edb/ref 17592186084383}} {:db/id #edb/ref 17592186084383 :step/content {:db/id #edb/ref 17592186084510 :tutorial/content "Consider the same triangle as before, with sides $5$ and $7.$ This time, what is the shortest possible length of the side $\\overline {BC},$ for which the figure is still a triangle?\n\nWe make the shortest possible segment $\\overline{BC}$ by decreasing the angle $\\angle{A}.$ Again, we fix $A$ and $B$, and then \"rotate\" the side $\\overline{AC}$ about the vertex $A$ towards the side $\\overline{AB}.$\n\n![](images/7d/7d1bd3363c2c218c6a2813a957bace3d29b7240919ced63d58be299e9478c099.png)\n\n         \n\nFrom the picture, we can see that for $m\\angle{A}=0^\\circ$ we will not have a triangle anymore and the length of $\\overline{BC}$ will be $7-5=2.$ Therefore, if we would like to have a triangle, $\\overline{BC}$ must be longer than the difference of the other sides: \n\n$$\n\\begin{aligned}BC & >AB-AC \\\\  & >7-5 \\\\  & >2\\end{aligned}\n$$\n\nThis is true for all triangles: \n\nIn every triangle, the length of any one side must be larger than the difference of the other two sides.\n\nThe above statement is the other part of the **triangle inequality theorem**." :tutorial/id #uuid "64f2a60c-c156-5226-a994-9c2f141a59db" :tutorial/math-academy-id 8193 :tutorial/title "The Difference of Two Sides"} :step/id #uuid "a2714886-a7e1-52ee-ba1b-b1922a69c5ca" :step/math-academy-id 73700 :step/next {:db/id #edb/ref 17592186084384}} {:db/id #edb/ref 17592186084384 :step/content {:db/id #edb/ref 17592186084511 :tutorial/content "All of the discussion so far can be summarized in the following statement that is called the **triangle inequality theorem**.\n\n*In a triangle, the length of a side must be greater than the difference of the lengths of the other two sides and less than the sum of those lengths.*\n\nLet's write that down using mathematical notations. Suppose that in a triangle the length of a side equals $a$ and the other two sides have length $b$ and $c$ with $b>c.$ Then, we must have \n\n$$\nb - c < a < b + c.\n$$\n\nIf we would like to omit the assumption that $b>c$, we can still use the same inequality, as long as we include an absolute value on the left-hand side:\n\n$$\n| b - c |  < a < b + c\n$$" :tutorial/id #uuid "cd8d2616-ebae-5d43-89d3-470c89118c36" :tutorial/math-academy-id 8194 :tutorial/title "The Triangle Inequality Theorem"} :step/id #uuid "85378e79-6c45-5c8a-9009-8d28559db885" :step/math-academy-id 73701 :step/next {:db/id #edb/ref 17592186084385}} {:db/id #edb/ref 17592186084385 :step/content {:db/id #edb/ref 17592186083396 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082922 :question/id #uuid "fa9395a9-f5b8-5c80-87e0-49da33706994" :question/math-academy-id "e-13102"} :knowledge-point/id #uuid "8f668f90-7140-5471-8638-18a38eae5e07" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049051}] :knowledge-point/questions [{:db/id #edb/ref 17592186083600} {:db/id #edb/ref 17592186083836} {:db/id #edb/ref 17592186497378} {:db/id #edb/ref 17592186497408}] :knowledge-point/title "Finding the Possible Lengths for a Side of a Triangle Given the Other Sides"} :step/id #uuid "abd1e9c3-f22d-5627-bb7d-521c942987a6" :step/math-academy-id 73702 :step/next {:db/id #edb/ref 17592186084386}} {:db/id #edb/ref 17592186084386 :step/content {:db/id #edb/ref 17592186083397 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082923 :question/id #uuid "dddb137b-afbb-515c-b44a-17b9ab2d667e" :question/math-academy-id "e-13103"} :knowledge-point/id #uuid "c8e827c3-95a0-5270-8323-f2512b64edd0" :knowledge-point/questions [{:db/id #edb/ref 17592186083783} {:db/id #edb/ref 17592186083785} {:db/id #edb/ref 17592186497337} {:db/id #edb/ref 17592186497397}] :knowledge-point/title "Finding the Maximum or Minimum Length of a Side of a Triangle: Word Problems"} :step/id #uuid "381f23e4-4ced-5b30-8ea4-c24b78bb3ff1" :step/math-academy-id 73705 :step/next {:db/id #edb/ref 17592186084387}} {:db/id #edb/ref 17592186084387 :step/content {:db/id #edb/ref 17592186083398 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082924 :question/id #uuid "1512acb2-ac78-557a-b6a7-5b37addbeb24" :question/math-academy-id "e-13104"} :knowledge-point/id #uuid "3736cf03-5a3a-5a22-8338-63cdabb1c046" :knowledge-point/questions [{:db/id #edb/ref 17592186083782} {:db/id #edb/ref 17592186083784} {:db/id #edb/ref 17592186497347} {:db/id #edb/ref 17592186497376}] :knowledge-point/title "Finding an Upper Bound for a Length"} :step/id #uuid "1cc41227-f39d-5f7a-a0e4-998e7c74302e" :step/math-academy-id 73708}] :activity/title "The Triangle Inequality" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083455}] [{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186074629} :activity/id #uuid "a0efe329-d527-57d7-9005-092c45b3c758" :activity/scope {:db/id #edb/ref 17592186050273 :topic/id #uuid "3bc5deb9-7ddf-5f6d-86b1-c0f92239ac2d" :topic/math-academy-id 558} :activity/steps [{:db/id #edb/ref 17592186074616 :step/content {:db/id #edb/ref 17592186073724 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073635 :question/id #uuid "a86fdc21-1c98-5929-8282-aed055b1b053" :question/math-academy-id "e-4745"} :knowledge-point/id #uuid "1a94905c-48fe-5662-bb6c-2153f7725648" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050195}] :knowledge-point/questions [{:db/id #edb/ref 17592186074400} {:db/id #edb/ref 17592186074494} {:db/id #edb/ref 17592186491147} {:db/id #edb/ref 17592186491170}] :knowledge-point/title "Problem Solving Using the Ratio of Two Integers"} :step/id #uuid "18311dd6-9a0a-534e-9a8d-3794869d485b" :step/math-academy-id 17329 :step/next {:db/id #edb/ref 17592186074617}} {:db/id #edb/ref 17592186074617 :step/content {:db/id #edb/ref 17592186073725 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073636 :question/id #uuid "52c7bc18-eedc-504f-bbae-a501944834a0" :question/math-academy-id "e-4746"} :knowledge-point/id #uuid "ea092786-a281-534e-803b-90e6c23b90a9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049357}] :knowledge-point/questions [{:db/id #edb/ref 17592186074496} {:db/id #edb/ref 17592186074505} {:db/id #edb/ref 17592186491159} {:db/id #edb/ref 17592186491214}] :knowledge-point/title "Problem Solving Using the Ratio of a Fraction and an Integer"} :step/id #uuid "b3df2fe0-94ac-5bcc-a3b1-52b4d1b4236b" :step/math-academy-id 17330 :step/next {:db/id #edb/ref 17592186074618}} {:db/id #edb/ref 17592186074618 :step/content {:db/id #edb/ref 17592186073726 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073637 :question/id #uuid "4f61ec9c-9b87-5b25-9543-44b6043b7b4a" :question/math-academy-id "e-4747"} :knowledge-point/id #uuid "d34e60c9-710b-50ca-a491-adc2b50e6edc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049616}] :knowledge-point/questions [{:db/id #edb/ref 17592186074495} {:db/id #edb/ref 17592186074506} {:db/id #edb/ref 17592186491150} {:db/id #edb/ref 17592186491210} {:db/id #edb/ref 17592186553520} {:db/id #edb/ref 17592186559871}] :knowledge-point/title "Problem Solving Using the Ratio of Two Fractions"} :step/id #uuid "347b63ef-9c0b-5688-8e27-d7df776461a0" :step/math-academy-id 17331} {:db/id #edb/ref 17592186074629 :step/content {:db/id #edb/ref 17592186075005 :tutorial/content "Unit rates can be used to solve many real-world problems in which we are given two quantities and wish to find what happens to one quantity when we vary the other.\n\nFor example, we might know the total cost of a specific number of items and be asked to find the cost for a different number of the same item.\n\nTo solve a problem using unit rates, the first step is to compute the unit rate by dividing the two given quantities. Then, we can use the unit rate to calculate the desired quantity.\n\nLet's see some examples!" :tutorial/id #uuid "fc623ecb-782c-5182-90e7-e8b6720b2780" :tutorial/math-academy-id 3313 :tutorial/title "Introduction"} :step/id #uuid "7987d98c-69c0-57a6-b100-cd3d9e53820b" :step/math-academy-id 18413 :step/next {:db/id #edb/ref 17592186074616}}] :activity/title "Solving Problems Using Unit Rates" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073976}]}
