#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186111495} :activity/id #uuid "e4f773f3-68ee-5605-ba18-3c151d342b17" :activity/scope {:db/id #edb/ref 17592186049879 :topic/id #uuid "1a5322f4-e5da-55f5-a61c-018264a8843c" :topic/math-academy-id 1475} :activity/steps [{:db/id #edb/ref 17592186111495 :step/content {:db/id #edb/ref 17592186111880 :tutorial/content "The **power rule** allows us to simplify logarithms of exponentiated expressions. It states that\n\n$$\n\\log_{n}\\left( c^{\\color{blue}m} \\right) = {\\color{blue}m}\\log_{n}{c}.\n$$\n\nIn other words, the logarithm has the effect of \"bringing down the power.\"\n\nFor example, let's use the rule to simplify $\\log\\left(125\\right)\\mathbin{:}$\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(125) & =\\operatorname{log}⁡({5}^{3}) \\\\  & =3\\operatorname{log}⁡(5)\\end{aligned}\n$$\n\n**Note:** To understand why the power rule works, notice that we can reach the same result using the product rule:\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(125) & =\\operatorname{log}⁡({5}^{3}) \\\\  & =\\operatorname{log}⁡(5\\cdot 5\\cdot 5) \\\\  & =\\operatorname{log}⁡(5)+\\operatorname{log}⁡(5)+\\operatorname{log}⁡(5) \\\\  & =3\\operatorname{log}⁡(5)\\end{aligned}\n$$\n\nThe power rule is just a shortcut for the above procedure." :tutorial/id #uuid "3cb8c8f4-3573-58ab-8e08-3c60cc3a3d12" :tutorial/math-academy-id 2795 :tutorial/title "Introduction"} :step/id #uuid "19f59ba1-2dd1-5223-a575-1ac050cc06a0" :step/math-academy-id 14483 :step/next {:db/id #edb/ref 17592186111496}} {:db/id #edb/ref 17592186111496 :step/content {:db/id #edb/ref 17592186110596 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110497 :question/id #uuid "bf0e781a-8bf7-51c8-a67b-031449fee038" :question/math-academy-id "e-4078"} :knowledge-point/id #uuid "ddcd6d98-7aad-5d57-9a17-cc05cbce863a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049560}] :knowledge-point/questions [{:db/id #edb/ref 175921861