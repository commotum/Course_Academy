#{[{:db/id #edb/ref 17592186110497 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110596 :knowledge-point/id #uuid "ddcd6d98-7aad-5d57-9a17-cc05cbce863a" :knowledge-point/title "Simplifying the Logarithm of a Power Function Using the Power Rule"}] :question/id #uuid "bf0e781a-8bf7-51c8-a67b-031449fee038" :question/math-academy-id "e-4078" :question/problem "By expressing $\\ln\\left(x^2\\right)$ in the form $k\\ln x,$ determine the value of $k.$" :question/worked-solution "First, let's recall the power rule for logarithms:\n\n$$\n\\log_n(c^m)= m\\log_n\\left( c \\right)\n$$\n\nUsing the power rule for logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({x}^{2}) & =2\\operatorname{ln}⁡x.\\end{aligned}\n$$\n\nTherefore, $k =2.$"}] [{:db/id #edb/ref 17592186110498 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110597 :knowledge-point/id #uuid "6657c93d-ca62-5bce-a136-b2e8a8c43869" :knowledge-point/title "Writing an Expression as the Logarithm of a Power Function Using the Power Rule"}] :question/id #uuid "53a33ca5-8a37-5ec7-acb2-00e3471a1c6a" :question/math-academy-id "e-4079" :question/problem "By expressing $\\dfrac{1}{2}\\log_3{x}$ in the form $\\log_3 \\left(x^k\\right),$ determine the value of $k.$" :question/worked-solution "First, let's recall the power rule for logarithms:\n\n$$\n\\log_n(c^m)= m\\log_n\\left( c \\right)\n$$\n\nUsing the power rule for logarithms, we get\n\n$$\n\\begin{aligned}\\frac{1}{2}{log}_{3}⁡x & ={log}_{3}⁡({x}^{1/2}).\\end{aligned}\n$$\n\nTherefore, $k = \\dfrac{1}{2}.$"}] [{:db/id #edb/ref 17592186110499 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110598 :knowledge-point/id #uuid "a0a4cb5a-4492-56df-8138-0d8cb9a07d0c" :knowledge-point/title "Evaluating an Expression Using the Power Rule"}] :question/id #uuid "7e755fc4-40b5-5d64-8087-ae67baad204c" :question/math-academy-id "e-4080" :question/problem "Find the value of $\\ln\\left(x^3\\right)$ if $\\ln(x) = 0.2.$" :question/worked-solution "First, let's recall the power rule for natural logarithms:\n\n$$\n\\ln\\left( c^m \\right) = m\\ln{c}\n$$\n\nUsing the power rule for logarithms and the information given, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({x}^{3}) & =3\\cdot \\operatorname{ln}⁡(x) \\\\  & =3\\cdot 0.2 \\\\  & =0.6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186543549 :knowledge-point/_questions [{:db/id #edb/ref 17592186110597 :knowledge-point/id #uuid "6657c93d-ca62-5bce-a136-b2e8a8c43869" :knowledge-point/title "Writing an Expression as the Logarithm of a Power Function Using the Power Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "312ee280-346c-51be-9a5b-40f3ad5f100e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡(7t)" :db/id #edb/ref 17592186542770} {:answer/id #uuid "5543e5e9-fa34-55a2-963c-46317805891c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡(\\frac{{t}^{7}}{2})" :db/id #edb/ref 17592186542869} {:answer/id #uuid "61eaa231-d53f-5412-a297-547a805089db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡(\\frac{7t}{2})" :db/id #edb/ref 17592186542907} {:answer/id #uuid "ce45adcc-4013-5eaa-828b-6c4c5f9aefd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡(t+7)" :db/id #edb/ref 17592186543175} {:answer/id #uuid "f7a71173-deae-5155-8154-2b2bf6b3687d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡({t}^{7})" :db/id #edb/ref 17592186543275}] :answer-field/correct {:answer/id #uuid "f7a71173-deae-5155-8154-2b2bf6b3687d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡({t}^{7})" :db/id #edb/ref 17592186543275} :answer-field/id #uuid "eba2b04a-58b1-5797-a2dc-057b2fcfd9dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 1