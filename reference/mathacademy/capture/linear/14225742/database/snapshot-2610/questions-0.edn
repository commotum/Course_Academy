#{[{:db/id #edb/ref 17592186110497 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110596 :knowledge-point/id #uuid "ddcd6d98-7aad-5d57-9a17-cc05cbce863a" :knowledge-point/title "Simplifying the Logarithm of a Power Function Using the Power Rule"}] :question/id #uuid "bf0e781a-8bf7-51c8-a67b-031449fee038" :question/math-academy-id "e-4078" :question/problem "By expressing $\\ln\\left(x^2\\right)$ in the form $k\\ln x$, determine the value of $k$." :question/worked-solution "First, let's recall the power rule for logarithms:\n\n$$\n\\log_n(c^m)= m\\log_n\\left(c \\right)\n$$\n\nUsing the power rule for logarithms, we get\n\n$$\n\\begin{aligned}\n\\ln (x^{2}) &= 2\\ln x\n\\end{aligned}\n$$\n\nTherefore, $k =2$."}] [{:db/id #edb/ref 17592186110498 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110597 :knowledge-point/id #uuid "6657c93d-ca62-5bce-a136-b2e8a8c43869" :knowledge-point/title "Writing an Expression as the Logarithm of a Power Function Using the Power Rule"}] :question/id #uuid "53a33ca5-8a37-5ec7-acb2-00e3471a1c6a" :question/math-academy-id "e-4079" :question/problem "By expressing $\\dfrac{1}{2}\\log_3{x}$ in the form $\\log_3 \\left(x^k\\right)$, determine the value of $k$." :question/worked-solution "First, let's recall the power rule for logarithms:\n\n$$\n\\log_n(c^m)= m\\log_n\\left(c \\right)\n$$\n\nUsing the power rule for logarithms, we get\n\n$$\n\\begin{aligned}\n\\frac{1}{2}\\log_{3} x &= \\log_{3} (x^{1/2})\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\nk = \\dfrac{1}{2}\n$$"}] [{:db/id #edb/ref 17592186110499 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110598 :knowledge-point/id #uuid "a0a4cb5a-4492-56df-8138-0d8cb9a07d0c" :knowledge-point/title "Evaluating an Expression Using the Power Rule"}] :question/id #uuid "7e755fc4-40b5-5d64-8087-ae67baad204c" :question/math-academy-id "e-4080" :question/problem "Find the value of $\\ln\\left(x^3\\right)$ if $\\ln(x) = 0.2$." :question/worked-solution "First, let's recall the power rule for natural logarithms:\n\n$$\n\\ln\\left(c^m \\right) = m\\ln{c}\n$$\n\nUsing the power rule for logarithms and the information given, we get\n\n$$\n\\begin{aligned}\n\\ln (x^{3}) &= 3 \\cdot \\ln (x) \\\\\n&= 3 \\cdot 0.2 \\\\\n&= 0.6\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186111212 :knowledge-point/_questions [{:db/id #edb/ref 17592186110597 :knowledge-point/id #uuid "6657c93d-ca62-5bce-a136-b2e8a8c43869" :knowledge-point/title "Writing an Expression as the Logarithm of a Power Function Using the Power Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b731c708-1c16-5fcf-9f3a-35c6a2fed263" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186108998} {:answer/id #uuid "ddf62482-7895-5867-b6d4-032cf39bed8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186108999} {:answer/id #uuid "e3dba866-f768-5693-8087-0c4a699c50b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186109000} {:answer/id #uuid "f41f9730-ef2e-5a2f-b153-e37b0d26ca72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186109001} {:answer/id #uuid "17f25aab-ae49-52dc-9973-bb3a1dfd9a93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186109002}] :answer-field/id #uuid "daf9485b-a7d9-541b-9a10-be96d7c09e9e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186108997}] :question/id #uuid "280546e1-c920-58e1-a384-cc694d6876d2" :question/math-academy-id "q-47220" :question/problem "By expressing $\\frac{5}{2}\\log_{2} t$ in the form $\\log_{2} (t^{k})$, determine the value of $k$."}]}
