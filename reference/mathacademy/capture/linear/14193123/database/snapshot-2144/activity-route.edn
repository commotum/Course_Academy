#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186506603} :activity/id #uuid "26dc73c3-a573-5ce4-b269-7e050d805860" :activity/scope {:db/id #edb/ref 17592186050428 :topic/id #uuid "484d0a1c-bca0-5a5c-8066-d983f4434a94" :topic/math-academy-id 2174} :activity/steps [{:db/id #edb/ref 17592186506603 :step/content {:db/id #edb/ref 17592186506514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "552d15ae-c5c8-509e-8ca8-494431dec439" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30" :db/id #edb/ref 17592186506055} {:answer/id #uuid "68e4b1c8-a132-5e30-a98b-556a99af5dac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30.25" :db/id #edb/ref 17592186506088} {:answer/id #uuid "996044d0-4829-58b0-acf3-4fda7d419060" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5.5" :db/id #edb/ref 17592186506179} {:answer/id #uuid "f4c01550-6c48-50cb-af06-6cd887f27626" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "27.5" :db/id #edb/ref 17592186506360} {:answer/id #uuid "ffd4bfdb-d6a7-556d-9522-25b678ff5a2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "33" :db/id #edb/ref 17592186506379}] :answer-field/correct {:db/id #edb/ref 17592186506088} :answer-field/id #uuid "c64d54dd-1bd9-5b4c-bf85-d147344d6818" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186506478}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "14d93e8f-2ff1-562e-a35c-f8de5c3818d2" :question/math-academy-id "q-40857" :question/problem "$(-5.5)^{2}=$" :question/worked-solution "We need to calculate the product of $-5.5$ with itself:\n\n$$\n(-5.5)^{2}=(-5.5)\\cdot (-5.5)=(5.5)\\cdot (5.5)\n$$\n\nFirst, we ignore the decimal points and multiply as if both numbers were whole numbers:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{2} \\\\ \\boxed{2}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $55\\times 55=3\\,025.$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $1$ decimal place in the first factor ($5.5$) and $1$ decimal place in the second factor ($5.5$), so their product will have $1+1=2$ decimal places.\n\nWe take our value of $3\\,025$ and insert a decimal point to make a number with $2$ decimal places:\n\n$$\n30\\,\\overset{↓}{.}\\,\\,\\,{{25}_{⏟}}_{2\\text{ digits}}\n$$\n\nTherefore, ${5.5}^{2}=30.25.$"} :step/id #uuid "044c8258-6998-590f-acbe-62a40481c0e9" :step/next {:db/id #edb/ref 17592186506616}} {:db/id #edb/ref 17592186506616 :step/content {:db/id #edb/ref 17592186506593 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52f8b7f2-814b-52b7-8406-e6c27493120e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-100" :db/id #edb/ref 17592186506053} {:answer/id #uuid "586654e7-8734-5135-9af9-664cad8ca414" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "100" :db/id #edb/ref 17592186506061} {:answer/id #uuid "65eac8e3-d47a-5916-a461-305de8d9c4b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186506084} {:answer/id #uuid "c7fa432d-1e24-5a86-b227-9bd8e7f5ffaa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1000" :db/id #edb/ref 17592186506265} {:answer/id #uuid "daa57dc6-1f16-5e29-96c2-37eb66dd98de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186506303}] :answer-field/correct {:db/id #edb/ref 17592186506061} :answer-field/id #uuid "aa969c6f-c49d-52e8-859b-a1950adae923" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186506457}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dffd7631-0175-532f-861a-5fc5f04bbe69" :question/math-academy-id "q-42826" :question/problem "$(-10)^{2}=$" :question/worked-solution "To work out $(-10)^{2},$ we multiply $-10$ by itself: \n\n$$\n\\begin{aligned}(-10)^{2}=(-10)\\cdot (-10)=100\\end{aligned}\n$$"} :step/id #uuid "2eb80d86-6678-5a3e-88d9-4f420dd31528" :step/next {:db/id #edb/ref 17592186506624}} {:db/id #edb/ref 17592186506624 :step/content {:db/id #edb/ref 17592186134406 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e937730-041f-5478-a981-98a01c39c491" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "225" :db/id #edb/ref 17592186132476} {:answer/id #uuid "b12bf7a3-2fd4-50b0-b302-33ed49888285" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-225" :db/id #edb/ref 17592186132477} {:answer/id #uuid "424db066-192b-5a60-b740-a16c46343edb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "115" :db/id #edb/ref 17592186132478} {:answer/id #uuid "6eae60c3-f0ec-5c89-afab-06747c6d0dd1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30" :db/id #edb/ref 17592186132479} {:answer/id #uuid "7f835a56-bce0-51c2-820e-eda856d85dac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-30" :db/id #edb/ref 17592186132480}] :answer-field/correct {:db/id #edb/ref 17592186132476} :answer-field/id #uuid "6b96da10-424d-55ff-8df7-9396205c5033" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186132475}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "30ca79b4-7e41-5f3a-9cf8-5de3bed64d2a" :question/math-academy-id "q-42831" :question/problem "$(-15)^{2}=$" :question/worked-solution "Since the product of two negative numbers gives a positive number, we have\n\n$$\n(-15)^{2}=(-15)\\cdot (-15)=15\\cdot 15\n$$\n\nNext, we calculate $15\\cdot 15:$\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{2}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n(-15)^{2}={15}^{2}=225.\n$$"} :step/id #uuid "56ee66c4-5700-5c25-bdef-89a28b53c5bc"}] :activity/title "Squaring Rational Numbers" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186505902}]}
