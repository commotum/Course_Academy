9}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9ea4d21a-4360-5351-8a08-59d8247080d9" :question/math-academy-id "q-6844" :question/problem "![](images/2c/2c12cd35e66acc00de926a2375460242e46f359548a5112f0d87654485ba9a42.png)\n\nWhat is the range of the function $f(x),$ shown above?" :question/worked-solution "First, we find the lowest and highest $y$-values in the graph.\n\n- The lowest $y$-value is $0.$ This occurs at the point $(-1,0).$ However note that this point is not actually included in the graph.\n\n- The highest $y$-value is $4.$ This occurs at the point $(3,4).$\n\nThe function covers all the $y$-values between $0$ and $4,$ including $4$ but not including $0.$\n\nTherefore, the range is $0<y\\le 4,$ which can also be written as  $0<f(x)\\le 4.$"} :step/id #uuid "9dac1b33-2fa1-53c0-9f5f-ba56b251587a" :step/next {:db/id #edb/ref 17592186490364}} {:db/id #edb/ref 17592186490391 :step/content {:db/id #edb/ref 17592186490288 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fda99040-da9f-5a9e-8cf6-9ff75122c468" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186490068}] :answer-field/correct {:db/id #edb/ref 17592186490068} :answer-field/id #uuid "10804da5-cf35-5cd3-8082-0a562cf7ce3a" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186490079} {:answer-field/choices [{:answer/id #uuid "8684e22b-15e0-5e8a-afcb-e8c9f5f0b375" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186489821}] :answer-field/correct {:db/id #edb/ref 17592186489821} :answer-field/id #uuid "d4aa10cd-476a-5a7d-a63f-dcb3c8018761" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186490187} {:answer-field/choices [{:answer/id #uuid "87be075e-0f4d-5db1-9f62-57359d743531" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186489825}] :answer-field/correct {:db/id #edb/ref 17592186489825} :answer-field/id #uuid "f90dffe7-5f7c-50b9-8f60-36a09cdbbb47" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186490206}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "aa05eb09-9ab6-5ac2-b2dd-bab3e1656e0c" :question/math-academy-id "q-223782" :question/problem "![](images/0c/0c18987fb16fc67df39e9887f152b2c6f38649b58e4bf469c80feb908eded8d2.png)\n\nWhat is the range of the function $f(x),$ shown above?\n\n{{field-1}}\n$<\\,f(x)$\n{{field-2}}{{field-3}}" :question/worked-solution "First, we find the lowest and highest $y$-values in the graph.\n\n- The lowest $y$-value is $2.$ This occurs at the point $(2,2).$\n\n- The highest $y$-value is $6.$ This occurs at the point $(-2,6).$\n\nThe function covers all the $y$-values between $2$ and $6,$ but not including $2$ nor $6.$\n\nTherefore, the range is $2<y<6,$ which can also be written as $2<f(x)<6.$"} :step/id #uuid "fc768b09-4880-5df9-8458-7d28f05e4e82"}] :activity/title "The Range of a Function" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186489512}]}
