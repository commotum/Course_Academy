\le y<4,$ which can also be written as $-2\\le f(x)<4.$"}] [{:db/id #edb/ref 17592186490294 :knowledge-point/_questions [{:db/id #edb/ref 17592186083179 :knowledge-point/id #uuid "7d3796fa-e911-5553-83c2-24c98370e4ea" :knowledge-point/title "Identifying a Function's Range From a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14c41c16-9803-55fa-a5ea-e27f258697f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-4,-3,-2,-1,0\\}" :db/id #edb/ref 17592186489560} {:answer/id #uuid "3a1175ce-ad9d-5809-b45e-508cf644005e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{1,2,3\\}" :db/id #edb/ref 17592186489646} {:answer/id #uuid "a4078208-f82f-58ea-a06a-9183c0a39a85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{1,2,3,4\\}" :db/id #edb/ref 17592186489880} {:answer/id #uuid "b0685845-823d-5102-8576-378e2adb4ec5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{0,1,2,3\\}" :db/id #edb/ref 17592186489900} {:answer/id #uuid "e4ae3fc3-cd5c-5fd4-9466-6ba1a8dc3f8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-4,-3,-2,-1,0,1,2,3\\}" :db/id #edb/ref 17592186490011}] :answer-field/correct {:answer/id #uuid "a4078208-f82f-58ea-a06a-9183c0a39a85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{1,2,3,4\\}" :db/id #edb/ref 17592186489880} :answer-field/id #uuid "abdc0fd2-3497-5511-9719-4d38e8827235" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490170}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b868c541-58e5-5131-8ec5-c685d5ff37ca" :question/math-academy-id "q-54965" :question/problem "What is the range of the function $f$ defined 