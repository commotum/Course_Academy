#{[{:db/id #edb/ref 17592186082939 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083178 :knowledge-point/id #uuid "390282db-587c-5b6c-a051-f62e4092bb0a" :knowledge-point/title "Identifying a Function's Range From a Mapping Diagram"}] :question/id #uuid "9e732b25-cc9a-5a1a-b6d8-3502495a7fe4" :question/math-academy-id "e-14165" :question/problem "What is the range of the function $g$ defined by the mapping diagram shown below? \n\n![](images/5e/5e01cbf87af705346d112ed8f65a40936f7bc38776146b2c98736a4712828389.png)" :question/worked-solution "The range of $g(x)$ consists of all the outputs that have a corresponding $x$-input.\n\nIn a mapping diagram, the range consists of all the outputs to which an arrow is drawn.\n\nTherefore, the range is the set $\\{ 3,6,9,12 \\}.$"}] [{:db/id #edb/ref 17592186082940 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083179 :knowledge-point/id #uuid "7d3796fa-e911-5553-83c2-24c98370e4ea" :knowledge-point/title "Identifying a Function's Range From a Table"}] :question/id #uuid "0b107cc8-8085-57b4-b194-9adc02698826" :question/math-academy-id "e-14170" :question/problem "What is the range of the function $f$ defined by the following table?\n\n| $x$ | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $-1$ | $4$ | $3$ | $-1$ | $4$ | $2$ | $0$ |" :question/worked-solution "The range of $f(x)$ consists of all the outputs that have a corresponding $x$-input.\n\nIn a table, the range consists of all numbers that feature in the row corresponding to $f(x).$\n\nTherefore, the range is the set $\\{ -1,0,2,3,4  \\}.$"}] [{:db/id #edb/ref 17592186082941 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083180 :knowledge-point/id #uuid "f4d624bf-dfd2-5910-a5a6-c72352e76e40" :knowledge-point/title "Identifying a Function's Range From a Graph"}] :question/id #uuid "6b1dabe1-f820-5ab8-aceb-bbd5be3029a2" :question/math-academy-id "e-14172" :question/problem "What is the range of the function $f(x)$ defined by the graph below?\n\n![](images/11/112d92062583c1be3d89a01894feb5f3d7087241cdaec9834c4571be502a9cfd.png)" :question/worked-solution "First, we find the lowest and highest $y$-values in the graph.\n\n- The lowest $y$-value is $-1.$ This occurs at the point $(-1,-1).$\n\n- The highest $y$-value is $8.$ This occurs at the point $(2,8).$\n\nThe function covers all the $y$-values between $-1$ and $8,$ including both $-1$ and $8.$\n\nTherefore, the range is \n\n$$\n-1\\leq y \\leq 8,\n$$\n\nwhich can also be written as\n\n$$\n-1\\leq f(x) \\leq 8.\n$$"}] [{:db/id #edb/ref 17592186507490 :knowledge-point/_questions [{:db/id #edb/ref 17592186083180 :knowledge-point/id #uuid "f4d624bf-dfd2-5910-a5a6-c72352e76e40" :knowledge-point/title "Identifying a Function's Range From a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08dac064-7a79-5640-bfde-043631981e7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1<f(x)<5" :db/id #edb/ref 17592186506693} {:answer/id #uuid "1e0ca8d0-a3c1-5df8-a17e-a92f77fd9eb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<f(x)\\le 5" :db/id #edb/ref 17592186506738} {:answer/id #uuid "3eb70e17-2ceb-5594-bfd3-ccfe80e685bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\le f(x)\\le 1" :db/id #edb/ref 17592186506825} {:answer/id #uuid "4e02e265-0d66-5aaf-8be2-b066d397f39b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\le f(x)\\le 5" :db/id #edb/ref 17592186506858} {:answer/id #uuid "8c3727a8-b673-5274-a8e8-3df04bea7012" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\le f(x)\\le 2" :db/id #edb/ref 17592186506989}] :answer-field/correct {:answer/id #uuid "4e02e265-0d66-5aaf-8be2-b066d397f39b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\le f(x)\\le 5" :db/id #edb/ref 17592186506858} :answer-field/id #uuid "af48bdab-43b4-53ac-9a3f-185cef31192b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186507352}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "beacaecf-2eb5-55f8-8278-e9b484096e26" :question/math-academy-id "q-129330" :question/problem "![](images/ed/edc4005c3c0a8f3d521156afc9d38c3ac35ee140c4479928d4c1ffb08fda21ad.png)\n\nWhat is the range of the function $f(x),$ shown above?" :question/worked-solution "First, we find the lowest and highest $y$-values in the graph.\n\n- The lowest $y$-value is $1.$ This occurs at the point $(-2,1).$\n\n- The highest $y$-value is $5.$ This occurs at the point $(2,5).$\n\nThe function covers all the $y$-values between $1$ and $5,$ including both $1$ and $5.$\n\nTherefore, the range is $1\\le y\\le 5,$ which can also be written as  $1\\le f(x)\\le 5.$"}] [{:db/id #edb/ref 17592186488182 :knowledge-point/_questions [{:db/id #edb/ref 17592186083180 :knowledge-point/id #uuid "f4d624bf-dfd2-5910-a5a6-c72352e76e40" :knowledge-point/title "Identifying a Function's Range From a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d9a0b69-2551-510b-a191-6777480f7929" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186487719}] :answer-field/correct {:answer/id #uuid "4d9a0b69-2551-510b-a191-6777480f7929" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186487719} :answer-field/id #uuid "0dc700b9-f0a4-5b59-9c19-77a6b7c1362c" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186488059} {:answer-field/choices [{:answer/id #uuid "049ea557-4d92-5f5b-878c-bb4d41b99