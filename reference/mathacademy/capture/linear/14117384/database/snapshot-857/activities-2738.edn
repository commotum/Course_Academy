#{[{:activity/first-step {:db/id #edb/ref 17592186153168} :activity/id #uuid "2d6eb053-cae1-5c17-b076-ba71324db2b8" :activity/scope {:db/id #edb/ref 17592186049408 :topic/id #uuid "f1e8e720-50ea-5aa2-9e19-afac3ed8baad" :topic/math-academy-id 2738} :activity/steps [{:db/id #edb/ref 17592186153168 :step/content {:db/id #edb/ref 17592186153410 :tutorial/content "Let $A$ be an  $m \\times m$ matrix. Recall that a nonzero vector $\\mathbf{v}_1$ is an eigenvector of $A$ corresponding to the eigenvalue $\\lambda$ if\n\n$$\nA\\mathbf{v}_1 = \\lambda \\mathbf{v}_1.\n$$\n\nWe can write this equation as \n\n$$\n(A - \\lambda I) \\mathbf{v}_1 = \\mathbf{0}.\n$$\n\nTherefore, the matrix $A-\\lambda I$ maps the vector $\\mathbf{v}_1$ to the zero vector $\\mathbf{0}{:}$\n\n$$\n\\mathbf{v}_1 \\xrightarrow{A- \\lambda I} \\mathbf{0}\n$$\n\nNow suppose that there exists a nonzero vector $\\mathbf v_2$ that is mapped to the zero vector in *two* steps by the matrix $A-\\lambda I.$ That is,\n\n$$\n(A-\\lambda I)\\mathbf v_2 = \\mathbf v_1 \\qquad \\textrm{and}\\qquad (A-\\lambda I)\\mathbf v_1 = \\mathbf 0,\n$$\n\nwhere $\\mathbf v_1$ is an eigenvector of $A$ corresponding to the eigenvalue $\\lambda.$\n\nWe can represent this schematically as a chain of mappings, as follows:\n\n$$\n\\mathbf{v}_2 \\xrightarrow{A- \\lambda I} \\mathbf{v}_{1} \\xrightarrow{A- \\lambda I}  \\mathbf{0}\n$$\n\nWe call $\\mathbf v_2$ a **generalized eigenvector of rank** $2$ because it is mapped to the zero vector in two steps. \n\nBy the same idea, an eigenvector of $A$ is a generalized eigenvector of rank $1$ because it is mapped to the zero vector in one step." :tutorial/id #uuid "88994c46-d16a-531c-895a-e2c3fdddfc1f" :tutorial/math-academy-id 5419 :tutorial/title "Introduction"} :step/id #uuid "70c56d2e-edef-5c66-b434-a79d78754fe4" :step/math-academy-id 33794 :step/next {:db/id #edb/ref 17592186153172}} {:db/id #edb/ref 17592186153169 :step/content {:db/id #edb/ref 17592186152224 :knowledge-point/canonical-example {:db/id #edb/ref 17592186152034 :question/id #uuid "3d5ffe46-c0ac-5309-a31b-28a6a1d927e5" :question/math-academy-id "e-9054"} :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050857}] :knowledge-point/questions [{:db/id #edb/ref 17592186152380} {:db/id #edb/ref 17592186152383} {:db/id #edb/ref 17592186244298} {:db/id #edb/ref 17592186246999} {:db/id #edb/ref 17592186247000} {:db/id #edb/ref 17592186362675}] :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix"} :step/id #uuid "3ba3a9ff-1652-5e2f-a17b-31f53f5fa7ce" :step/math-academy-id 33795 :step/next {:db/id #edb/ref 17592186153173}} {:db/id #edb/ref 17592186153170 :step/content {:db/id #edb/ref 17592186152225 :knowledge-point/canonical-example {:db/id #edb/ref 17592186152035 :question/id #uuid "30daf182-0ed6-5ddd-994e-a5af7c6c6c01" :question/math-academy-id "e-9056"} :knowledge-point/id #uuid "04926916-8e08-5401-a57b-3fd333741913" :knowledge-point/questions [{:db/id #edb/ref 17592186152379} {:db/id #edb/ref 17592186152382} {:db/id #edb/ref 17592186244251} {:db/id #edb/ref 17592186244253} {:db/id #edb/ref 17592186244262} {:db/id #edb/ref 17592186244274} {:db/id #edb/ref 17592186244291} {:db/id #edb/ref 17592186244292} {:db/id #edb/ref 17592186362661}] :knowledge-point/title "Identifying Generalized Eigenvectors Using Definition"} :step/id #uuid "4c7afd25-604b-599f-93ac-e074a6562587" :step/math-academy-id 33799 :step/next {:db/id #edb/ref 17592186153171}} {:db/id #edb/ref 17592186153171 :step/content {:db/id #edb/ref 17592186152226 :knowledge-point/canonical-example {:db/id #edb/ref 17592186152036 :question/id #uuid "79ffef9f-8be0-581f-b2f1-dc796d2cf94b" :question/math-academy-id "e-9057"} :knowledge-point/id #uuid "76e60bc4-ae61-5c39-ad80-14e0cdab14da" :knowledge-point/questions [{:db/id #edb/ref 17592186152381} {:db/id #edb/ref 17592186152384} {:db/id #edb/ref 17592186247001} {:db/id #edb/ref 17592186247002} {:db/id #edb/ref 17592186247011} {:db/id #edb/ref 17592186247012} {:db/id #edb/ref 17592186247013} {:db/id #edb/ref 17592186247016} {:db/id #edb/ref 17592186247254} {:db/id #edb/ref 17592186362682}] :knowledge-point/title "Identifying Generalized Eigenvectors of a 3x3 Matrix"} :step/id #uuid "c580f07b-112f-562a-a89e-5d7287e732f7" :step/math-academy-id 33800} {:db/id #edb/ref 17592186153172 :step/content {:db/id #edb/ref 17592186153411 :tutorial/content "Consider the matrix $A$ and the vector $\\mathbf v,$ given by\n\n$$\n[\\begin{aligned}1 & 4 \\\\ -1 & 5\\end{aligned}]\n$$\n\nThe matrix $A$ has only one eigenvalue, namely $\\lambda = 3.$ Let's show that $\\mathbf v$ is a generalized eigenvector of rank $2$ corresponding to this eigenvalue.\n\n- First, we compute $A-3I{:}$\n\n$$\n[\\begin{aligned}1 & 4 \\\\ -1 & 5\\end{aligned}]\n$$\n\n- Next, we find the image of $\\mathbf{v}$ under the action of $A-3I{:}$\n\n$$\n[\\begin{aligned}-2 & 4 \\\\ -1 & 2\\end{aligned}]\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $\\mathbf{w}$ under the action of $A-3I{:}$\n\n$$\n[\\begin{aligned}-2 & 4 \\\\ -1 & 2\\end{aligned}]\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n[\\begin{aligned}1 \\\\ 1\\end{aligned}]\n$$\n\nAs we can see,  $A-3I$ maps $\\mathbf{v}$ to $\\mathbf{0}$ in $2$ steps.\n\nTherefore, we conclude that $\\mathbf{v}$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda=3$ of $A.$" :tutorial/id #uuid "398d8883-81a4-5080-8b00-904f74cdef07" :tutorial/math-academy-id 5587 :tutorial/title "An Example of a Generalized Eigenvector of Rank Two for a 2x2 Matrix"} :step/id #uuid "3ec840df-f049-5126-988c-9c7bbb99172d" :step/math-academy-id 34485 :step/next {:db/id #edb/ref 17592186153169}} {:db/id #edb/ref 17592186153173 :step/content {:db/id #edb/ref 17592186153412 :tutorial/content "Let $A$ be an  $m \\times m$ matrix. A **generalized eigenvector of rank $n$** corresponding to the eigenvalue $\\lambda$ of  $A$ is a nonzero vector $\\mathbf{v}_n$ such that\n\n$$\n\\mathbf{v}_n \\xrightarrow{A- \\lambda I} \\mathbf{v}_{n-1} \\xrightarrow{A- \\lambda I} \\ldots \\xrightarrow{A- \\lambda I} \\mathbf{v}_1 \\xrightarrow{A- \\lambda I} \\mathbf{0},\n$$\n\nwhere $\\mathbf{v}_{n-1}, \\mathbf{v}_{n-2},\\ldots, \\mathbf{v}_{1} \\neq \\mathbf{0}.$ In other words, $A-\\lambda I$ maps $\\mathbf{v}$ to $\\mathbf{0}$ in $n$ steps." :tutorial/id #uuid "6382bc76-a365-5639-83d8-91bd8605500a" :tutorial/math-academy-id 5588 :tutorial/title "Generalized Eigenvectors of Rank N"} :step/id #uuid "cd7d895d-dd6d-5fb6-acf9-cde71c0edb5f" :step/math-academy-id 34486 :step/next {:db/id #edb/ref 17592186153170}}] :activity/title "Generalized Eigenvectors" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186152358}]}
