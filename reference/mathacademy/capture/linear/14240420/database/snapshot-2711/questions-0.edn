#{[{:db/id #edb/ref 17592186558574 :knowledge-point/_questions [{:db/id #edb/ref 17592186138439 :knowledge-point/id #uuid "deb16829-8ec8-5cbb-b81f-2c526bce165e" :knowledge-point/title "Dividing Nonstandard Units"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9df49a9f-7b13-5d0e-94bf-4077f92c9eef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{machines}}{\\text{ball}}" :db/id #edb/ref 17592186558179} {:answer/id #uuid "adc47bce-7d5b-5419-90c1-b6900875bc26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\text{balls}}^{2}}{\\text{machine}}" :db/id #edb/ref 17592186558214} {:answer/id #uuid "d44676fb-cfb9-5576-bfd7-4326efdf4071" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{balls}}{\\text{machine}}" :db/id #edb/ref 17592186558284} {:answer/id #uuid "db400d60-85d5-52eb-959c-6924766f7a85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\text{machines}}^{2}}{{\\text{ball}}^{2}}" :db/id #edb/ref 17592186558299} {:answer/id #uuid "e6f489c1-6d75-5a3e-8fdf-791aab447eda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\text{machines}}^{2}}{\\text{ball}}" :db/id #edb/ref 17592186558327}] :answer-field/correct {:answer/id #uuid "d44676fb-cfb9-5576-bfd7-4326efdf4071" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{balls}}{\\text{machine}}" :db/id #edb/ref 17592186558284} :answer-field/id #uuid "d31a35ae-5ca8-5d6c-a47c-8b5b084ab4be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558460}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f55788bf-5fa6-5009-a74f-4343731f157e" :question/math-academy-id "q-46070" :question/problem "A factory with $150$ machines produces $600\\,000$ baseball balls weekly. To determine the number of balls produced by a machine on average, the owner of the factory uses the formula\n\n$$\nP=\\frac{b}{m},\n$$\n\n \nwhere $b$ is the number of balls produced by the factory weekly, and $m$ is the number of machines in the factory.\n\nWhat is an appropriate measurement unit for $P?$" :question/worked-solution "We are solving for measurement units, so we can ignore the quantities $150$ and $600\\,000.$ They do not matter, if we are just solving for units.\n\nSince $b$ represents $\\text{balls}$ and $m$ represents $\\text{machines},$ the appropriate measurement unit for $P=\\frac{b}{m}$ is $\\frac{\\text{balls}}{\\text{machines}}.$"}] [{:db/id #edb/ref 17592186558558 :knowledge-point/_questions [{:db/id #edb/ref 17592186138438 :knowledge-point/id #uuid "4e1b4e78-8b4a-59ea-8fac-9092c2eeb67a" :knowledge-point/title "Finding Units When There Is Cancellation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0087c9b5-6fa9-54cf-b875-8154f8e1a3e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{m}}{{\\text{s}}^{2}\\,{\\text{km}}^{3}}" :db/id #edb/ref 17592186557870} {:answer/id #uuid "16b3c8b4-9bbf-5a82-b8c2-9a041a21c8b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{m}}{\\text{km}\\,{\\text{s}}^{2}}" :db/id #edb/ref 17592186557920} {:answer/id #uuid "21442043-31fd-5aab-92ba-0f264502b9eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\text{s}}^{2}}{\\text{m}}" :db/id #edb/ref 17592186557937} {:answer/id #uuid "57ec2723-24ad-548e-bbe6-9d7bd87f30f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{m}}{\\text{s}}" :db/id #edb/ref 17592186558032} {:answer/id #uuid "6c26b31a-a05b-53fb-b0ed-1793466f9725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{m}}{{\\text{s}}^{2}}" :db/id #edb/ref 17592186558077}] :answer-field/correct {:answer/id #uuid "6c26b31a-a05b-53fb-b0ed-1793466f9725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{m}}{{\\text{s}}^{2}}" :db/id #edb/ref 17592186558077} :answer-field/id #uuid "11e0e1ea-dc6c-5b3f-89da-7dc4c90d0d81" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558369}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b8a0ff68-2bfe-50b7-8470-09b73dbea458" :question/math-academy-id "q-46095" :question/problem "The acceleration $a$ of a body is related to applied force $F$ and mass $m$ by the equation $a=\\frac{F}{m}.$ If $F$ is measured in Newtons $(\\frac{\\text{kg}\\,\\text{m}}{{\\text{s}}^{2}})$ and $m$ is measured in kilograms, determine an appropriate measurement unit for acceleration." :question/worked-solution "We can find the unit of acceleration by substituting the given units of force and mass into the formula and simplifying.\n\n$$\n\\begin{aligned}a & =\\frac{F}{m} \\\\  & =\\frac{(\\frac{\\text{kg}\\,\\text{m}}{{\\text{s}}^{2}})}{\\text{kg}} \\\\  & =\\frac{\\cancel{\\text{kg}}\\,\\text{m}}{{\\text{s}}^{2}\\,\\cancel{\\text{kg}}} \\\\  & =\\frac{\\text{m}}{{\\text{s}}^{2}}\\end{aligned}\n$$\n\nThus, the unit of acceleration is $\\frac{\\text{m}}{{\\text{s}}^{2}}.$"}] [{:db/id #edb/ref 17592186558530 :knowledge-point/_questions [{:db/id #edb/ref 17592186138438 :knowledge-point/id #uuid "4e1b4e78-8b4a-59ea-8fac-9092c2eeb67a" :knowledge-point/title "Finding Units When There Is Cancellation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13280df4-2330-5e3f-a795-a4797d385b73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{m}}{\\text{s}}" :db/id #edb/ref 17592186557910} {:answer/id #uuid "92e3a44a-45f8-56a5-93ce-aadc94b4a4b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{s}}{\\text{m}}" :db/id #edb/ref 17592186558153} {:answer/id #uuid "aac98899-8115-5802-b963-acb140b5967b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{m}}{{\\text{s}}^{2}}" :db/id #edb/ref 17592186558204} {:answer/id #uuid "e59368b3-7a79-555b-bf69-9f407a1f2366" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\text{s}}^{2}}{{\\text{m}}^{2}}" :db/id #edb/ref 17592186558326} {:answer/id #uuid "e8401ebb-283d-5b15-a0db-c2b75fab6b15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{s}}{{\\text{m}}^{2}}" :db/id #edb/ref 17592186558331}] :answer-field/correct {:answer/id #uuid "13280df4-2330-5e3f-a795-a4797d385b73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{m}}{\\text{s}}" :db/id #edb/ref 17592186557910} :answer-field/id #uuid "f8d533bf-32da-572b-b69a-5759fa85571d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558475}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7753ef82-1930-5153-93dc-89e284e045d1" :question/math-academy-id "q-46152" :question/problem "The speed of a car moving with a constant acceleration is given by the formula $v=at,$ where $a$ is the car's acceleration, and $t$ is the time passed. Given that the acceleration is measured in $\\frac{\\text{m}}{{\\text{s}}^{2}}$, determine the units of speed in terms of meters and seconds." :question/worked-solution "Acceleration is measured in $\\frac{\\text{m}}{{\\text{s}}^{2}}$ and time is measured in seconds. We can find the unit of speed by substituting the given units of acceleration and time into the formula and simplifying. \n\n$$\n\\begin{aligned}v & =a\\cdot t \\\\  & =\\frac{\\text{m}}{{\\text{s}}^{2}}\\cdot \\text{s} \\\\  & =\\frac{\\text{m}\\,\\cancel{\\text{s}}}{{\\text{s}}^{\\cancel{2}}} \\\\  & =\\frac{\\text{m}}{\\text{s}}\\end{aligned}\n$$\n\nThus, the unit of speed is $\\frac{\\text{m}}{\\text{s}}.$"}]}
