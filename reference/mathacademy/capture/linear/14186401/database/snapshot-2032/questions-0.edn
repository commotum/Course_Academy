#{[{:db/id #edb/ref 17592186500299 :knowledge-point/_questions [{:db/id #edb/ref 17592186147474 :knowledge-point/id #uuid "1a494473-0da3-5789-a3da-08d8a0f62d6a" :knowledge-point/title "Modeling Exponential Growth Using a Growth Rate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14107df9-1142-5b13-a4eb-cc0f979fe623" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "450,792" :db/id #edb/ref 17592186499699} {:answer/id #uuid "143d216d-e1b6-5b77-b80e-11048d8298ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "79,379" :db/id #edb/ref 17592186499700} {:answer/id #uuid "6de7a497-dd0c-5d56-ac16-d0eaf3570086" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64,467" :db/id #edb/ref 17592186499860} {:answer/id #uuid "96687e47-684e-58fb-863d-2da17bbf8bc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "59,058" :db/id #edb/ref 17592186499948} {:answer/id #uuid "cec9699d-a223-50f9-941c-c2542b406244" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "441,156" :db/id #edb/ref 17592186500078}] :answer-field/correct {:answer/id #uuid "14107df9-1142-5b13-a4eb-cc0f979fe623" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "450,792" :db/id #edb/ref 17592186499699} :answer-field/id #uuid "29a2769d-116f-58e7-ae7f-aaabbc05f186" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186500199}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "300c5739-f0bd-5d32-a60a-07c8bf92cedc" :question/math-academy-id "q-1416" :question/problem "In $1990$, there were $5,000$ cell phone subscribers in a city. The number of subscribers increased by $35%$ per year until $2005.$ How many cell-phone subscribers were there in $2005?$" :question/worked-solution "The number of subscribers $y(t)$ grows exponentially with a growth rate of $35%.$\n\nThe formula for exponential growth (in terms of a growth rate $r$) is\n\n$$\ny=a(1+r)^{t}.\n$$\n\nWe have:\n\n- $a=5\\,000$ is the initial number of subscribers.\n\n- $r=0.35$ is the growth rate ($35%$ expressed as a decimal).\n\n- $t=$ the time, in years.\n\nTherefore, the correct expression for $y$ is\n\n$$\n\\begin{aligned}y & =5\\,000\\cdot (1+0.35)^{t} \\\\  & =5\\,000\\cdot (1.35)^{t}.\\end{aligned}\n$$\n\nEvaluating the expression for the number of subscribers after $15$ years, we get\n\n$$\ny(15)=5,000\\cdot (1.35)^{15}≈450\\,792.\n$$\n\nWe round to the nearest whole number because we are talking about people."}] [{:db/id #edb/ref 17592186500311 :knowledge-point/_questions [{:db/id #edb/ref 17592186147475 :knowledge-point/id #uuid "bb2a01a6-39e9-55ac-ac4a-eaab72e72257" :knowledge-point/title "Modeling Exponential Growth Using Percentage Increases Greater Than 100%"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6885483a-aa71-5fea-be44-2ce9914f562d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "86" :db/id #edb/ref 17592186499854} {:answer/id #uuid "99d3b702-8f26-5fec-864d-fc1d46d65b97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "700" :db/id #edb/ref 17592186499952} {:answer/id #uuid "a54c4dd1-562b-5848-ac11-19e631519c9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "532" :db/id #edb/ref 17592186499977} {:answer/id #uuid "ab6b2e34-5b0d-511b-9c71-0da9a7de6e76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "246" :db/id #edb/ref 17592186499993} {:answer/id #uuid "be53aed4-2603-538a-bb13-6ffecb59a0fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "198" :db/id #edb/ref 17592186500043}] :answer-field/correct {:answer/id #uuid "a54c4dd1-562b-5848-ac11-19e631519c9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "532" :db/id #edb/ref 17592186499977} :answer-field/id #uuid "1232ee90-f900-5499-a331-ceb50d527115" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186500188}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "50e1b98c-c8a1-53cf-8367-e3764f5a2f08" :question/math-academy-id "q-317613" :question/problem "A video was posted on a streaming platform with $50$ initial views. An exponential model estimates that at the end of each hour after the video was posted, the number of views increased by $120%$ of the number of views at the end of the previous hour.\n\nAccording to this model, how many views are there estimated to be after $3$ hours?" :question/worked-solution "The number of views $V(t)$ grows exponentially with a growth rate of $120%.$\n\nLet's write down what we know:\n\n- $a=50$ is the total number of views initially\n\n- $r=1.2$ is the growth rate ($120%$ expressed as a decimal)\n\n- $t=$ the time (in hours) after the video was posted\n\nThe formula for exponential growth (in terms of a growth rate $r$) is\n\n$$\nV=a(1+r)^{t}.\n$$\n\nTherefore, the correct expression for $V(t)$ is\n\n$$\nV=50\\cdot (1+1.2)^{t}.\n$$\n\nSimplifying the above, we get\n\n$$\nV(t)=50\\cdot (2.2)^{t}.\n$$\n\nTo find the total number of views after $3$ hours, we evaluate the above for $t=3:$\n\n$$\nV(3)=50\\cdot (2.2)^{3}≈532\n$$\n\nTherefore, the estimated number of views after $3$ hours is $532.$"}] [{:db/id #edb/ref 17592186500323 :knowledge-point/_questions [{:db/id #edb/ref 17592186147475 :knowledge-point/id #uuid "bb2a01a6-39e9-55ac-ac4a-eaab72e72257" :knowledge-point/title "Modeling Exponential Growth Using Percentage Increases Greater Than 100%"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "421513ab-7ba9-53ad-8cc4-202843fff382" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "V(t)=40\\cdot (9)^{t}" :db/id #edb/ref 17592186499779} {:answer/id #uuid "49751aae-f779-5ca6-9b9e-7a8ffe15ccc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "V(t)=40\\cdot (2.9)^{t}" :db/id #edb/ref 17592186499793} {:answer/id #uuid "77ce4af4-fcc6-55af-ac0a-de8056e6b319" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "V(t)=40\\cdot (3.9)^{t}" :db/id #edb/ref 17592186499875} {:answer/id #uuid "961d3d8b-abcf-51c0-a2d4-4c9ea00eafc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "V(t)=40\\cdot (0.9)^{t}" :db/id #edb/ref 17592186499947} {:answer/id #uuid "fffde48d-2021-53c1-b6ab-24b4f090abde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "V(t)=40\\cdot (19)^{t}" :db/id #edb/ref 17592186500177}] :answer-field/correct {:answer/id #uuid "49751aae-f779-5ca6-9b9e-7a8ffe15ccc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "V(t)=40\\cdot (2.9)^{t}" :db/id #edb/ref 17592186499793} :answer-field/id #uuid "8f647258-0007-5333-ac78-26a8426f4858" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186500237}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7b3a2ac3-80ac-548f-ab31-d1de79eaa643" :question/math-academy-id "q-318202" :question/problem "When a new article was first published on a news website, it had $40$ views. An exponential model estimates that at the end of each hour after publication, the number of views increased by $190%$ of the number of views at the end of the previous hour.\n\nWhich of the following equations best represents this model, where $V$ is the estimated number of views $t$ hours after the article was published, and $t\\le 6?$" :question/worked-solution "The number of views $V(t)$ grows exponentially with a growth rate of $190%.$\n\nLet's write down what we know:\n\n- $a=40$ is the total number of views initially\n\n- $r=1.9$ is the growth rate ($190%$ expressed as a decimal)\n\n- $t=$ the time (in hours) after publication\n\nThe formula for exponential growth (in terms of a growth rate $r$) is\n\n$$\nV=a(1+r)^{t}.\n$$\n\nTherefore, the correct expression for $V(t)$ is\n\n$$\nV=40\\cdot (1+1.9)^{t}.\n$$\n\nSimplifying the above, we get\n\n$$\nV(t)=40\\cdot (2.9)^{t}.\n$$"}] [{:db/id #edb/ref 17592186500378 :knowledge-point/_questions [{:db/id #edb/ref 17592186147474 :knowledge-point/id #uuid "1a494473-0da3-5789-a3da-08d8a0f62d6a" :knowledge-point/title "Modeling Exponential Growth Using a Growth Rate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a06080c-4982-56b7-b5e3-ea683c5488d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$63$" :db/id #edb/ref 17592186499771} {:answer/id #uuid "529fdd70-21b7-5a61-acff-82b1d5ee51b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$65$" :db/id #edb/ref 17592186499810} {:answer/id #uuid "8a2a7572-9dfa-5124-bbbe-d5a09f71180d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$68$" :db/id #edb/ref 17592186499925} {:answer/id #uuid "8bf143da-90ae-5cc9-9f95-1d1c3df1b0b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$54$" :db/id #edb/ref 17592186499927} {:answer/id #uuid "b5201925-5100-5ac3-b4cc-f62281b63503" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$58$" :db/id #edb/ref 17592186500021}] :answer-field/correct {:answer/id #uuid "3a06080c-4982-56b7-b5e3-ea683c5488d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$63$" :db/id #edb/ref 17592186499771} :answer-field/id #uuid "30a9f7e5-72a7-5d8d-87b1-f07b7357b6d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186500204}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f7a13f7a-d9b6-5c70-a5f5-bc0989abd19e" :question/math-academy-id "q-61916" :question/problem "A watch collector bought a watch for $$50.$ They estimate that the value of the watch increases at a rate of $8%$ every decade. According to this estimate, what will be the price of the watch after $3$ decades? Round your answer to the nearest dollar." :question/worked-solution "The price of the watch $y(t)$ grows exponentially with a growth rate of $8%.$\n\nThe formula for exponential growth (in terms of a growth rate $r$) is\n\n$$\ny=a(1+r)^{t}.\n$$\n\nWe have:\n\n- $a=50$ dollars is the original price of the watch.\n\n- $r=0.08$ is the growth rate ($8%$ expressed as a decimal).\n\n- $t=$ the time, in decades.\n\nTherefore, the correct expression for $y$ is\n\n$$\n\\begin{aligned}y & =50\\cdot (1+0.08)^{t} \\\\  & =50\\cdot (1.08)^{t}.\\end{aligned}\n$$\n\nEvaluating the function at $t=3$ gives the value of the watch after $3$ decades.\n\n$$\ny(3)=50\\cdot (1.08)^{3}≈63\n$$\n\nTherefore, the value of the watch after $3$ decades will be approximately $$63.$"}]}
