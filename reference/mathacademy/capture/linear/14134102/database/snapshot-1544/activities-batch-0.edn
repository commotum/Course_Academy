#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186111613} :activity/id #uuid "dc520173-74e8-57e7-ad6f-9e7a82ef78e1" :activity/scope {:db/id #edb/ref 17592186049892 :topic/id #uuid "1c2006c0-c4c4-5ff8-8fa2-7f9dd3693f49" :topic/math-academy-id 1500} :activity/steps [{:db/id #edb/ref 17592186111613 :step/content {:db/id #edb/ref 17592186111906 :tutorial/content "For any two distinct points, there is always one (and only one) line that passes through them.\n\nFor example, the line passing through the points $P$ and $Q$ is $\\overset{\\longleftrightarrow}{PQ},$ while the line that passes through $A$ and $B$ is $\\overset{\\longleftrightarrow}{AB}\\mathbin{:}$\n\n![](images/8c/8c79a551e7ced71de157ea292baa3d7f38afaca4ea76ee467fc4add1b28ed33f.png)\n\nHowever, given three or more points, there is not always a line that passes through all of them.\n\nFor example, for the three points $F, G,$ and $H$ below, it is impossible to draw a single straight line that passes through all of them.\n\n![](images/30/30361c0bd49e571e317746f2d88848626da52e5ddbcda8fe9b6f496e4aff6b69.png)\n\nHowever, it is *sometimes* possible to draw a line through three (or more) points. In such cases, we say that the points are **collinear**.\n\nFor example, the points $M,$ $N,$ and $O$ shown below are collinear since they all lie on the same line.\n\n![](images/bf/bf3de55518c21de30718b2d9fee7032139c89aa3a4a963b8346b457ceafbeada.png)" :tutorial/id #uuid "051ac95a-dc63-5270-a5fa-a498a36c8297" :tutorial/math-academy-id 6732 :tutorial/title "Introduction"} :step/id #uuid "2afa6da4-491a-5a31-8b50-09bd210fc929" :step/math-academy-id 40727 :step/next {:db/id #edb/ref 17592186111615}} {:db/id #edb/ref 17592186111614 :step/content {:db/id #edb/ref 17592186110674 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110295 :question/id #uuid "a042ba66-3567-5b06-84e6-344ad0043bbc" :question/math-academy-id "e-10748"} :knowledge-point/id #uuid "f67c3319-1153-51ed-a57a-f85c06c7e76c" :knowledge-point/questions [{:db/id #edb/ref 17592186110905} {:db/id #edb/ref 17592186111394} {:db/id #edb/ref 17592186441206} {:db/id #edb/ref 17592186441209} {:db/id #edb/ref 17592186441210} {:db/id #edb/ref 17592186441212}] :knowledge-point/title "Determining Whether Points on Intersecting Lines Are Collinear"} :step/id #uuid "08fe2b06-8140-5116-be8c-f9a047f0e538" :step/math-academy-id 40728} {:db/id #edb/ref 17592186111615 :step/content {:db/id #edb/ref 17592186110675 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110296 :question/id #uuid "76902823-634d-5525-afc5-5f2a98cea481" :question/math-academy-id "e-10749"} :knowledge-point/id #uuid "9ef4e321-841e-5933-b5e4-ff7dab6c5275" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049350}] :knowledge-point/questions [{:db/id #edb/ref 17592186110928} {:db/id #edb/ref 17592186110929} {:db/id #edb/ref 17592186441205} {:db/id #edb/ref 17592186441207} {:db/id #edb/ref 17592186441208} {:db/id #edb/ref 17592186441211}] :knowledge-point/title "Identifying Collinear Points on a Grid"} :step/id #uuid "f4bbacca-99b9-57fe-b9c5-a2075ef9663b" :step/math-academy-id 40731 :step/next {:db/id #edb/ref 17592186111614}}] :activity/title "Collinear Points" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110859}]}
