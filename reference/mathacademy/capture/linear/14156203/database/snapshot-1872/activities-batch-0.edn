#{[{:activity/first-step {:db/id #edb/ref 17592186153304} :activity/id #uuid "6475ad04-5d9b-517e-800a-5523bcdb2d20" :activity/scope {:db/id #edb/ref 17592186048888 :topic/id #uuid "c99b0c35-73da-506e-b41f-7fd90b5fde25" :topic/math-academy-id 2561} :activity/steps [{:db/id #edb/ref 17592186153304 :step/content {:db/id #edb/ref 17592186153435 :tutorial/content "As we already know, to evaluate numerical expressions with a mix of different operations, we must follow the order of operations known as PEMDAS.\n\nThe same rules apply to numerical expressions with negative numbers. For example, let's compute the value of\n\n$$\n\\left(-5 + 7 \\right) \\div (-2) \\times 6\n$$\n\nFirst, we perform the operation inside the parentheses:\n\n$$\n\\begin{aligned}\n(-5 + 7) \\div (-2) \\cdot 6 &=  \\\\\n&= 2 \\div (-2) \\cdot 6\n\\end{aligned}\n$$\n\nNow recall that if both multiplication and division appear in an expression, we complete each operation from left to right (similarly for addition and subtraction).\nSo, we first divide:\n\n$$\n\\begin{aligned}\n2 \\div (-2) \\cdot 6 &=  \\\\\n&= - 1 \\cdot 6\n\\end{aligned}\n$$\n\nThen finally, we multiply:\n\n$$\n\\begin{aligned}\n-1 \\cdot 6 &= -6\n\\end{aligned}\n$$" :tutorial/id #uuid "26e3e757-ef98-5e88-a3e6-7a753c09e46f" :tutorial/math-academy-id 8039 :tutorial/title "Introduction"} :step/id #uuid "fb21e1cc-7a97-5bfc-8f91-3ca3436f2fd4" :step/math-academy-id 72819 :step/next {:db/id #edb/ref 17592186153305}} {:db/id #edb/ref 17592186153305 :step/content {:db/id #edb/ref 17592186152299 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151820 :question/id #uuid "fc9992be-d6e0-569b-b0a9-7ff40a8c0e22" :question/math-academy-id "e-12831"} :knowledge-point/id #uuid "be45dab5-8dcc-5820-9ada-fa57dd060d37" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049484} {:db/id #edb/ref 17592186050421} {:db/id #edb/ref 17592186050637}] :knowledge-point/questions [{:db/id #edb/ref 17592186152687} {:db/id #edb/ref 1759218615269