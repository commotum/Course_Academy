#{[{:db/id #edb/ref 17592186151820 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186152299 :knowledge-point/id #uuid "be45dab5-8dcc-5820-9ada-fa57dd060d37" :knowledge-point/title "Evaluating Expressions With Addition and Subtraction"}] :question/id #uuid "fc9992be-d6e0-569b-b0a9-7ff40a8c0e22" :question/math-academy-id "e-12831" :question/problem "Evaluate $-7 + 3.1 - 5.$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe add and subtract, from left to right:\n\n$$\n\\begin{aligned}-7+3.1-5 & = \\\\ (-7+3.1)-5 & = \\\\ -\\,3.9-5 & = \\\\ -8.9\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186151821 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186152300 :knowledge-point/id #uuid "b3656cdd-e02d-5ce5-805c-8c76cc0f5996" :knowledge-point/title "Evaluating Expressions With Multiplication and Division"}] :question/id #uuid "9d5382d3-5153-5457-ae03-26736f3a123a" :question/math-academy-id "e-12832" :question/problem "What is the value of $2 \\div 6 \\times (-5)?$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe divide and multiply, from left to right:\n\n$$\n\\begin{aligned}2÷6\\times (-5) & = \\\\ (2÷6)\\times (-5) & = \\\\ \\frac{2}{6}\\times (-5) & = \\\\ \\frac{1}{3}\\times (-5) & = \\\\ \\frac{1}{3}\\times \\frac{(-5)}{1} & = \\\\ \\frac{1\\times (-5)}{3\\times 1} & = \\\\ -\\frac{5}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186151822 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186152301 :knowledge-point/id #uuid "40c77bba-95b6-5f8d-876d-3eb0b0905d6d" :knowledge-point/title "Evaluating Numerical Expressions Containing Multiple Operations"}] :question/id #uuid "216c39cc-456d-5bf8-abbc-2860ab3ebb43" :question/math-academy-id "e-12833" :question/problem "Evaluate $-2 + 6 \\div (-10).$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, we divide:\n\n$$\n\\begin{aligned}-2+6÷(-10) & = \\\\ -2+(6÷(-10)) & = \\\\ -2+(-0.6)\\end{aligned}\n$$\n\nFinally, we add:\n\n$$\n\\begin{aligned}-2+(-0.6) & =-2.6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186151823 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186152302 :knowledge-point/id #uuid "b48ae5a6-0426-58c1-ab88-10b748043f6f" :knowledge-point/title "Evaluating Expressions Containing Parentheses"}] :question/id #uuid "1fedcc75-84fe-5f3f-9555-896493c91232" :question/math-academy-id "e-12834" :question/problem "What is the value of $\\left( -3 + 6 \\right) \\div \\dfrac{4}{3} - \\dfrac{1}{4}?$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, we perform the operation inside the parentheses:\n\n$$\n\\begin{aligned}(-3+6)÷\\frac{4}{3}-\\frac{1}{4} & = \\\\ 3÷\\frac{4}{3}-\\frac{1}{4}\\end{aligned}\n$$\n\nNext, we divide:\n\n$$\n\\begin{aligned}3÷\\frac{4}{3}-\\frac{1}{4} & = \\\\ (3÷\\frac{4}{3})-\\frac{1}{4} & = \\\\ (\\frac{3}{1}÷\\frac{4}{3})-\\frac{1}{4} & = \\\\ (\\frac{3}{1}\\times \\frac{3}{4})-\\frac{1}{4} & = \\\\ \\frac{3\\times 3}{1\\times 4}-\\frac{1}{4} & = \\\\ \\frac{9}{4}-\\frac{1}{4}\\end{aligned}\n$$\n\nFinally, we subtract:\n\n$$\n\\begin{aligned}\\frac{9}{4}-\\frac{1}{4} & = \\\\ \\frac{9-1}{4} & = \\\\ \\frac{8}{4} & = \\\\ 8÷4 & = \\\\ 2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479078 :knowledge-point/_questions [{:db/id #edb/ref 17592186152301 :knowledge-point/id #uuid "40c77bba-95b6-5f8d-876d-3eb0b0905d6d" :knowledge-point/title "Evaluating Numerical Expressions Containing Multiple Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dcc6f5fd-050d-5fbb-88f7-e841559dfb66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186478906}] :answer-field/correct {:answer/id #uuid "dcc6f5fd-050d-5fbb-88f7-e841559dfb66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186478906} :answer-field/id #uuid "af98e227-3993-52d7-9ae5-2d273b174754" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479027}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "32e41319-b064-5c4a-91f7-13675a0d7fcb" :question/math-academy-id "q-174388" :question/problem "Expressed as a fraction in lowest terms, $\\frac{4}{3}÷2-\\frac{1}{3}=${{field-1}}." :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, we divide:\n\n$$\n\\begin{aligned}\\frac{4}{3}÷2-\\frac{1}{3} & = \\\\ (\\frac{4}{3}÷\\frac{2}{1})-\\frac{1}{3} & = \\\\ (\\frac{4}{3}\\times \\frac{1}{2})-\\frac{1}{3} & = \\\\ (\\frac{4\\times 1}{3\\times 2})-\\frac{1}{3} & = \\\\ \\frac{4}{6}-\\frac{1}{3}\\end{aligned}\n$$\n\nFinally, we subtract:\n\n$$\n\\begin{aligned}\\frac{4}{6}-\\frac{1}{3} & = \\\\ \\frac{2}{3}-\\frac{1}{3} & = \\\\ \\frac{2-1}{3} & = \\\\ \\frac{1}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479063 :knowledge-point/_questions [{:db/id #edb/ref 17592186152302 :knowledge-point/id #uuid "b48ae5a6-0426-58c1-ab88-10b748043f6f" :knowledge-point/title "Evaluating Expressions Containing Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0ce97a1-5e79-58a4-9cd7-c578898dcd66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.3" :db/id #edb/ref 17592186478934}] :answer-field/correct {:answer/id #uuid "f0ce97a1-5e79-58a4-9cd7-c578898dcd66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.3" :db/id #edb/ref 17592186478934} :answer-field/id #uuid "07818ad5-3003-5a61-89f8-d143f34c577f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186478961}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "16c2fdd2-5848-54fb-8203-57bceb610cf0" :question/math-academy-id "q-175317" :question/problem "$(0.6+2)÷2=${{field-1}}" :question/worked-solution "First, we perform the operation inside the parentheses:\n\n$$\n\\begin{aligned}(0.6+2)÷2 & = \\\\ 2.6÷2\\end{aligned}\n$$\n\nFinally, we multiply and divide, from left to right:\n\n$$\n\\begin{aligned}2.6÷2 & =1.3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479134 :knowledge-point/_questions [{:db/id #edb/ref 17592186152299 :knowledge-point/id #uuid "be45dab5-8dcc-5820-9ada-fa57dd060d37" :knowledge-point/title "Evaluating Expressions With Addition and Subtraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e65ebf46-2f69-57b1-97a2-8a7627364272" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{8}" :db/id #edb/ref 17592186478917}] :answer-field/correct {:answer/id #uuid "e65ebf46-2f69-57b1-97a2-8a7627364272" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{8}" :db/id #edb/ref 17592186478917} :answer-field/id #uuid "64409c9a-b082-5202-877a-44cfa2b215a2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186478999}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "db6984e3-bfbe-5e15-a092-ee9588e31df7" :question/math-academy-id "q-175940" :question/problem "Expressed as an improper fraction in lowest terms, $\\frac{1}{4}+3-\\frac{5}{8}=${{field-1}}." :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe add and subtract, from left to right:\n\n$$\n\\begin{aligned}\\frac{1}{4}+3-\\frac{5}{8} & = \\\\ (\\frac{1}{4}+3)-\\frac{5}{8} & = \\\\ (\\frac{1}{4}+\\frac{12}{4})-\\frac{5}{8} & = \\\\ \\frac{1+12}{4}-\\frac{5}{8} & = \\\\ \\frac{13}{4}-\\frac{5}{8} & = \\\\ \\frac{26}{8}-\\frac{5}{8} & = \\\\ \\frac{26-5}{8} & = \\\\ \\frac{21}{8}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479127 :knowledge-point/_questions [{:db/id #edb/ref 17592186152300 :knowledge-point/id #uuid "b3656cdd-e02d-5ce5-805c-8c76cc0f5996" :knowledge-point/title "Evaluating Expressions With Multiplication and Division"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b403c69-74fe-5349-aefb-9cb442a9a6e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186478814}] :answer-field/correct {:answer/id #uuid "9b403c69-74fe-5349-aefb-9cb442a9a6e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186478814} :answer-field/id #uuid "89a1c7b6-5a65-5b4e-bfb7-cbbcc3b7d3f6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479013}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cafba121-70b2-571d-a218-1d3bb9b3e4ea" :question/math-academy-id "q-175955" :question/problem "Expressed as an improper fraction in lowest terms, $\\frac{3}{7}÷\\frac{2}{5}\\times 7=${{field-1}}." :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe divide and multiply, from left to right:\n\n$$\n\\begin{aligned}\\frac{3}{7}÷\\frac{2}{5}\\times 7 & = \\\\ (\\frac{3}{7}÷\\frac{2}{5})\\times 7 & = \\\\ (\\frac{3}{7}\\times \\frac{5}{2})\\times 7 & = \\\\ \\frac{3\\times 5}{7\\times 2}\\times 7 & = \\\\ \\frac{15}{14}\\times 7 & = \\\\ \\frac{15}{14}\\times \\frac{7}{1} & = \\\\ \\frac{15\\times 7}{14\\times 1} & = \\\\ \\frac{105}{14} & = \\\\ \\frac{15}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479096 :knowledge-point/_questions [{:db/id #edb/ref 17592186152301 :knowledge-point/id #uuid "40c77bba-95b6-5f8d-876d-3eb0b0905d6d" :knowledge-point/title "Evaluating Numerical Expressions Containing Multiple Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d396ebfa-2351-59b3-9a9a-85e9a027b858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-13" :db/id #edb/ref 17592186478895}] :answer-field/correct {:answer/id #uuid "d396ebfa-2351-59b3-9a9a-85e9a027b858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-13" :db/id #edb/ref 17592186478895} :answer-field/id #uuid "a6b9cf49-c2bb-5ce4-941d-b3540c075320" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479024}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "720361bc-07a5-589b-85d2-04870e7c2310" :question/math-academy-id "q-176386" :question/problem "Expressed as an integer, $8÷(-\\frac{4}{5})-3=${{field-1}}" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, we divide:\n\n$$\n\\begin{aligned}8÷(-\\frac{4}{5})-3 & = \\\\ (8÷(-\\frac{4}{5}))-3 & = \\\\ (\\frac{8}{1}\\times (-\\frac{5}{4}))-3 & = \\\\ -\\frac{8\\times 5}{1\\times 4}-3 & = \\\\ -\\frac{40}{4}-3 & = \\\\ -10-3\\end{aligned}\n$$\n\nFinally, we subtract:\n\n$$\n\\begin{aligned}-10-3 & =-13\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479059 :knowledge-point/_questions [{:db/id #edb/ref 17592186152302 :knowledge-point/id #uuid "b48ae5a6-0426-58c1-ab88-10b748043f6f" :knowledge-point/title "Evaluating Expressions Containing Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "287b8b8b-a357-530b-a29a-b4409ba9867a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{24}" :db/id #edb/ref 17592186478620}] :answer-field/correct {:answer/id #uuid "287b8b8b-a357-530b-a29a-b4409ba9867a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{24}" :db/id #edb/ref 17592186478620} :answer-field/id #uuid "78bc0c44-a6c7-5cb4-b731-9e72f7a43817" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479005}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0d504829-eef7-5492-8d82-0cc4f8d13b08" :question/math-academy-id "q-176475" :question/problem "Expressed as a fraction in lowest terms, $\\frac{5}{2}÷(7+5)=${{field-1}}." :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nFirst, we perform the operation inside the parentheses:\n\n$$\n\\begin{aligned}\\frac{5}{2}÷(7+5) & = \\\\ \\frac{5}{2}÷12\\end{aligned}\n$$\n\nFinally, we divide:\n\n$$\n\\begin{aligned}\\frac{5}{2}÷12 & = \\\\ \\frac{5}{2}÷\\frac{12}{1} & = \\\\ \\frac{5}{2}\\times \\frac{1}{12} & = \\\\ \\frac{5\\times 1}{2\\times 12} & = \\\\ \\frac{5}{24}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479079 :knowledge-point/_questions [{:db/id #edb/ref 17592186152300 :knowledge-point/id #uuid "b3656cdd-e02d-5ce5-805c-8c76cc0f5996" :knowledge-point/title "Evaluating Expressions With Multiplication and Division"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b07c6de-b540-57b6-96a7-08b3703af820" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{2}" :db/id #edb/ref 17592186478644} {:answer/id #uuid "654dcaef-b3ac-5aa3-a431-ca34193d3cdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{21}" :db/id #edb/ref 17592186478707} {:answer/id #uuid "6edf906e-43f0-5d16-aa0d-11200a173867" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-42" :db/id #edb/ref 17592186478725} {:answer/id #uuid "7bd7035f-0535-5d1b-baf7-fe650baf14c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186478743} {:answer/id #uuid "f1cde2af-e93f-51ce-b249-b3c8098d9356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186478936}] :answer-field/correct {:answer/id #uuid "7bd7035f-0535-5d1b-baf7-fe650baf14c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186478743} :answer-field/id #uuid "6483320d-efd6-5033-ac44-8b3c7ef96b4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479000}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "35969ec8-7388-5a9c-af50-84fbe5444368" :question/math-academy-id "q-75812" :question/problem "$\\frac{7}{2}\\times 3÷\\frac{1}{4}=$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe multiply and divide, from left to right:\n\n$$\n\\begin{aligned}\\frac{7}{2}\\times 3÷\\frac{1}{4} & = \\\\ (\\frac{7}{2}\\times 3)÷\\frac{1}{4} & = \\\\ (\\frac{7}{2}\\times \\frac{3}{1})÷\\frac{1}{4} & = \\\\ \\frac{7\\times 3}{2\\times 1}÷\\frac{1}{4} & = \\\\ \\frac{21}{2}÷\\frac{1}{4} & = \\\\ \\frac{21}{2}\\times \\frac{4}{1} & = \\\\ \\frac{21\\times 4}{2\\times 1} & = \\\\ \\frac{84}{2} & = \\\\ 42\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479121 :knowledge-point/_questions [{:db/id #edb/ref 17592186152299 :knowledge-point/id #uuid "be45dab5-8dcc-5820-9ada-fa57dd060d37" :knowledge-point/title "Evaluating Expressions With Addition and Subtraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4dbc7d01-1ba7-5cfe-8510-01783b2399ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{31}{6}" :db/id #edb/ref 17592186478670} {:answer/id #uuid "7c97b078-eb82-558a-830c-8ca790a11d1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186478746} {:answer/id #uuid "9186da31-0d26-59a2-89cc-724bd81bef84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186478793} {:answer/id #uuid "d12d2174-597b-55c5-9f3a-9dd7d9e8014f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{29}{6}" :db/id #edb/ref 17592186478891} {:answer/id #uuid "e3491aad-f540-5d63-b808-205276445ed8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{3}" :db/id #edb/ref 17592186478913}] :answer-field/correct {:answer/id #uuid "4dbc7d01-1ba7-5cfe-8510-01783b2399ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{31}{6}" :db/id #edb/ref 17592186478670} :answer-field/id #uuid "94188954-378c-51e7-898f-7f8bdd2e70ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479017}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bcde543e-81aa-57ea-886b-66ee35330ede" :question/math-academy-id "q-99811" :question/problem "$\\frac{4}{3}+5-\\frac{7}{6}=$" :question/worked-solution "To evaluate this expression, we use PEMDAS.\n\nWe add and subtract, from left to right:\n\n$$\n\\begin{aligned}\\frac{4}{3}+5-\\frac{7}{6} & = \\\\ (\\frac{4}{3}+5)-\\frac{7}{6} & = \\\\ (\\frac{4}{3}+\\frac{15}{3})-\\frac{7}{6} & = \\\\ \\frac{4+15}{3}-\\frac{7}{6} & = \\\\ \\frac{19}{3}-\\frac{7}{6} & = \\\\ \\frac{38}{6}-\\frac{7}{6} & = \\\\ \\frac{38-7}{6} & = \\\\ \\frac{31}{6}\\end{aligned}\n$$"}]}
