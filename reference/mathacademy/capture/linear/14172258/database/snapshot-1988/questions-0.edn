#{[{:db/id #edb/ref 17592186492916 :knowledge-point/_questions [{:db/id #edb/ref 17592186068726 :knowledge-point/id #uuid "6c5d24fa-8a65-5c20-bb50-530ca8dcf061" :knowledge-point/title "Solving Equations With Fractional Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7524c348-11f2-59fe-89ce-2554d91064a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\frac{5}{7}" :db/id #edb/ref 17592186492451}] :answer-field/correct {:answer/id #uuid "7524c348-11f2-59fe-89ce-2554d91064a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\frac{5}{7}" :db/id #edb/ref 17592186492451} :answer-field/id #uuid "246155e5-4b6f-5296-89cb-0ce66033efc4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186492717}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dc9b5d6a-36da-5369-a8e0-149a58110d0a" :question/math-academy-id "q-218577" :question/problem "If $49{a}^{2}+12=37,$ then $a=${{field-1}}." :question/worked-solution "First, we isolate the ${a}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}49{a}^{2}+12 & =37 \\\\ 49{a}^{2} & =25 \\\\ {a}^{2} & =\\frac{25}{49}\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{a}^{2}} & =\\sqrt{\\frac{25}{49}} \\\\ |a| & =\\frac{\\sqrt{25}}{\\sqrt{49}} \\\\ |a| & =\\frac{5}{7} \\\\ a & =\\pm \\frac{5}{7}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492883 :knowledge-point/_questions [{:db/id #edb/ref 17592186068727 :knowledge-point/id #uuid "a21c64f2-1b4b-54b3-a8a1-70ca63330e04" :knowledge-point/title "Solving Equations With Radical Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b1bc9b8-0ea0-52cc-a644-25016e73c24b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 3\\sqrt{5}" :db/id #edb/ref 17592186492465}] :answer-field/correct {:answer/id #uuid "7b1bc9b8-0ea0-52cc-a644-25016e73c24b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 3\\sqrt{5}" :db/id #edb/ref 17592186492465} :answer-field/id #uuid "fb6954e1-945b-51aa-b2d8-20a643556b8d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186492816}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "90d6c1a2-df8a-556c-89a1-d672dd78eab8" :question/math-academy-id "q-218588" :question/problem "Solve the equation ${v}^{2}=45.$ Express your final answer in its simplest form.\n\n$v=$\n\n{{field-1}}" :question/worked-solution "We take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{v}^{2}} & =\\sqrt{45} \\\\ |v| & =\\sqrt{9\\cdot 5} \\\\ |v| & =\\sqrt{9}\\cdot \\sqrt{5} \\\\ |v| & =3\\sqrt{5} \\\\ v & =\\pm 3\\sqrt{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492907 :knowledge-point/_questions [{:db/id #edb/ref 17592186068726 :knowledge-point/id #uuid "6c5d24fa-8a65-5c20-bb50-530ca8dcf061" :knowledge-point/title "Solving Equations With Fractional Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a6f09a0-ccd7-5f3c-b936-37c4d8190186" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{3}{7}" :db/id #edb/ref 17592186492363} {:answer/id #uuid "72c93668-102e-59cf-bbee-5a2ec27c8f74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{3}{7}" :db/id #edb/ref 17592186492444} {:answer/id #uuid "8bbf1f51-b87d-56f3-a2e4-c8c1a5907fb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{7}{3}" :db/id #edb/ref 17592186492494} {:answer/id #uuid "aabe0e05-f4e4-5dba-8d77-0379c8bb7619" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{3}{49}" :db/id #edb/ref 17592186492562} {:answer/id #uuid "d05fdd44-d514-56b7-a034-70edb6be2559" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{9}{7}" :db/id #edb/ref 17592186492631}] :answer-field/correct {:answer/id #uuid "72c93668-102e-59cf-bbee-5a2ec27c8f74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{3}{7}" :db/id #edb/ref 17592186492444} :answer-field/id #uuid "52cb84e8-9f4d-596d-8658-8754ec0aa693" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492737}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c009e53d-f124-53fe-9bd5-4569b0faacf3" :question/math-academy-id "q-78906" :question/problem "Solve for $x$ where $\\frac{{x}^{2}}{2}=\\frac{9}{98}.$" :question/worked-solution "First, we isolate the ${x}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{2} & =\\frac{9}{98} \\\\ {x}^{2} & =\\frac{9\\cdot 2}{98} \\\\ {x}^{2} & =\\frac{9}{49}\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}} & =\\sqrt{\\frac{9}{49}} \\\\ |x| & =\\frac{\\sqrt{9}}{\\sqrt{49}} \\\\ |x| & =\\frac{3}{7} \\\\ x & =\\pm \\frac{3}{7}\\end{aligned}\n$$"}]}
