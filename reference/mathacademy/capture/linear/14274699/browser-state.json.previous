<mo stretchy=\"false\">(</mo><mo>−</mo><mn>4</mn><mo>,</mo><mn>0</mn><mo stretchy=\"false\">]</mo><mo>.</mo></math></mjx-assistive-mml></mjx-container></p><div class=\"freeResponseLine\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"-1\" ctxtmenu_counter=\"50\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D44E TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo></math></mjx-assistive-mml></mjx-container>\n<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:45px;\n                                        margin-left:2px;\n                                        margin-right:1px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"23\"><span mathquill-command-id=\"25\" class=\"\">−</span><span class=\"mq-fraction mq-non-leaf\" mathquill-command-id=\"27\"><span class=\"mq-numerator\" mathquill-block-id=\"29\"><span mathquill-command-id=\"28\">1</span><span mathquill-command-id=\"30\">1</span></span><span class=\"mq-denominator\" mathquill-block-id=\"33\"><span mathquill-command-id=\"32\">6</span></span><span style=\"display:inline-block;width:0\">​</span></span></span></div></div></div></div><div class=\"questionWidget-buttonBar\"><div class=\"questionWidget-submitButton disabledButton\" style=\"display: none;\">Submit</div></div><div class=\"questionWidget-spinnerFrame\"><div clas