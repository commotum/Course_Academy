px;\">&nbsp;<span class=\"selectListSelectedText\"></span></div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1;\"><div class=\"selectListOption\" style=\"height: 17px;\">True</div><div class=\"selectListOption\" style=\"height: 17px;\">False</div></div></div></td>\n</tr>\n<tr> \n<td style=\"text-align:left; border:hidden;\">The relation is symmetric</td>\n<td style=\"text-align:left; border:hidden;\"><div id=\"selectList-214254-1\" class=\"selectList\" style=\"margin: 0px 2px 2px;\"><div class=\"selectListFrame\" id=\"selectListFrame-214254-1\" style=\"width: 55px; height: 17px; line-height: 17px;\">&nbsp;<span class=\"selectListSelectedText\"></span></div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1;\"><div class=\"selectListOption\" style=\"height: 17px;\">True</div><div class=\"selectListOption\" style=\"height: 17px;\">False</div></div></div></td>\n</tr>\n<tr> \n<td style=\"text-align:left; border:hidden;\">The relation  is transitive</td>\n<td style=\"text-align:left; border:hidden;\"><div id=\"selectList-214254-2\" class=\"selectList\" style=\"margin: 0px 2px 2px;\"><div class=\"selectListFrame\" id=\"selectListFrame-214254-2\" style=\"width: 55px; height: 17px; line-height: 17px;\">&nbsp;<span class=\"selectListSelectedText\"></span></div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1;\"><div class=\"selectListOption\" style=\"height: 17px;\">True</div><div class=\"selectListOption\" style=\"height: 17px;\">False</div></div></div></td>\n</tr>\n<tr> \n<td style=\"text-align:left; border:hidden;\">The relation is an equivalence relation</td>\n<td style=\"text-align:left; border:hidden;\"><div id=\"selectList-214254-3\" class=\"selectList\" style=\"margin: 0px 2px 2px;\"><div class=\"selectListFrame\" id=\"selectListFrame-214254-3\" style=\"width: 55px; height: 17px; line-height: 17px;\">&nbsp;<span class=\"selectListSelectedText\"></span></div><div class=\"selectListOptions\" style=\"v