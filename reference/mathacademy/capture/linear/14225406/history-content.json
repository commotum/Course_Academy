l=\"0\"><mfrac><msqrt><mn>32</mn><msup><mi>z</mi><mn>5</mn></msup></msqrt><msqrt><mn>8</mn><msup><mi>z</mi><mn>3</mn></msup></msqrt></mfrac></mstyle></math></mjx-assistive-mml></mjx-container> given that <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"2\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D467 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3E\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c30\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>z</mi><mo>&gt;</mo><mn>0.</mn></math></mjx-assistive-mml></mjx-container></p>\n</div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyModerate\">M</div><span class=\"answerCreated\">Thu, Oct 15th @ 12:20 AM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:14</span><span class=\"answerResult\"><span style=\"color: green;\">Correct</span></span></div></div>"
