class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c7C\"></mjx-c></mjx-mo><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd extra=\"true\"></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.8em 0.8em 0.3em\"><mtr><mtd><msqrt><mn>25</mn><msup><mi>t</mi><mn>4</mn></msup></msqrt></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><msqrt><mo stretchy=\"false\">(</mo><mn>5</mn><msup><mi>t</mi><mn>2</mn></msup><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></msqrt></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mo stretchy=\"false\">|</mo><mn>5</mn><msup><mi>t</mi><mn>2</mn></msup><mo stretchy=\"false\">|</mo></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mo stretchy=\"false\">|</mo><mn>5</mn><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mo>⋅</mo><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><msup><mi>t</mi><mn>2</mn></msup><mo stretchy=\"false\">|</mo></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mn>5</mn><mo>⋅</mo><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><msup><mi>t</mi><mn>2</mn></msup><mo stretchy=\"false\">|</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>A squared number is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"29\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 3.632em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"tex