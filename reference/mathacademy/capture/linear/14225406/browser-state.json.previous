      "html": "<div id=\"step-q162953\" class=\"step questionWidget\" stepid=\"q162953\" questionid=\"162953\" format=\"MC\" answer=\"\" current=\"false\" style=\"display: block;\"><div class=\"questionWidget-header\"><div class=\"questionWidget-title\">Question 4</div><div class=\"questionWidget-helpButton\">?</div></div><div class=\"questionWidget-text\"><p>Simplify <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"30\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-msqrt><mjx-sqrt><mjx-surd><mjx-mo class=\"mjx-s3\"><mjx-c class=\"mjx-c221A TEX-S3\"></mjx-c></mjx-mo></mjx-surd><mjx-box style=\"padding-top: 0.08em;\"><mjx-mstyle><mjx-mfrac><mjx-frac type=\"d\"><mjx-num><mjx-nstrut type=\"d\"></mjx-nstrut><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c39\"></mjx-c></mjx-mn></mjx-num><mjx-dbox><mjx-dtable><mjx-line type=\"d\"></mjx-line><mjx-row><mjx-den><mjx-dstrut type=\"d\"></mjx-dstrut><mjx-mrow><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c36\"></mjx-c><mjx-c class=\"mjx-c34\"></mjx-c></mjx-mn><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45E TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.289em; margin-left: 0.051em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup></mjx-mrow></mjx-den></mjx-row></mjx-dtable></mjx-dbox></mjx-frac></mjx-mfrac></mjx-mstyle></mjx-box></mjx-sqrt></mjx-msqrt></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>9</mn><mrow><mn>64</mn><msup><mi>q</mi><mn>2</mn></msup></mrow></mfrac></mstyle></msqrt></math></mjx-assistive-mml></mjx-container> given that <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"31\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-