#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186069776} :activity/id #uuid "3fcb435e-dc90-5888-b34e-40125c4a37f1" :activity/scope {:db/id #edb/ref 17592186050887 :topic/id #uuid "6e563fb5-2e53-5b68-a90b-a963f8d0dc96" :topic/math-academy-id 390} :activity/steps [{:db/id #edb/ref 17592186069776 :step/content {:db/id #edb/ref 17592186069998 :tutorial/content "To simplify radical expressions, we can use the quotient rule for radicals, which states \n\n$$\n\\dfrac {\\sqrt {a}} {\\sqrt{b}} = \\sqrt{\\dfrac a b}.\n$$\n\nFor example, let's simplify $\\sqrt{\\dfrac{16w^2}{25}}$\n\nFirst, we put the numerator and denominator under separate radicals and then simplify the result:\n\n$$\n\\sqrt{\\dfrac{16w^2}{25}}  = \\dfrac {\\sqrt{16w^2}} {\\color{blue}\\sqrt{25}} = \\dfrac{\\sqrt{16w^2}}{\\color{blue}\\sqrt{5^2}} = \\dfrac{\\sqrt{16w^2}}{\\color{blue}5}\n$$\n\nNow, notice that the expression inside the radical is a perfect square. So, we can continue simplifying by writing the expression under the radical as a perfect square and taking its square root:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{16{w}^{2}}}{5} & = \\\\ \\frac{\\sqrt{(4w)^{2}}}{5} & = \\\\ \\frac{|4w|}{5} & = \\\\ \\frac{|4|\\cdot |w|}{5} & = \\\\ \\frac{4\\cdot |w|}{5} & = \\\\ \\frac{4|w|}{5}\\end{aligned}\n$$" :tutorial/id #uuid "7bfc07d9-feb0-5bcc-b3f0-50bb42eb2b6d" :tutorial/math-academy-id 6691 :tutorial/title "Introduction"} :step/id #uuid "2bc45b7b-b768-5e67-92eb-6d8dfdb26080" :step/math-academy-id 40513 :step/next {:db/id #edb/ref 17592186069777}} {:db/id #edb/ref 17592186069777 :step/content {:db/id #edb/ref 17592186068836 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068442 :question/id #uuid "dd7c79e5-d274-5f04-af44-335b5a6d95df" :question/math-academy-id "e-10699"} :knowledge-point/id #uuid "bc723e84-3051-5e73-ac57-08da7193c368" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050315} {:db/id #edb/ref 17592186050496}] :knowledge-point/questions [{:db/id #edb/ref 17592186069096} {:db/id #edb/ref 17592186069423} {:db/id #edb/ref 17592186503656} {:db/id #edb/ref 17592186503672}] :knowledge-point/title "Simplifying Radical Expressions With Perfect Squares Under the Radical"} :step/id #uuid "92bbfce1-1705-5e28-a0bf-e544d5fecdf9" :step/math-academy-id 40520 :step/next {:db/id #edb/ref 17592186069780}} {:db/id #edb/ref 17592186069778 :step/content {:db/id #edb/ref 17592186069999 :tutorial/content "The quotient rule for radicals also works for higher-order roots, like the cube root:\n\n$$\n\\sqrt[3]{ \\dfrac a b } = \\dfrac{ \\sqrt[3]{a} }{ \\sqrt[3]{b} }\n$$\n\nIn general, we have the following result:\n\n$$\n\\sqrt[n]{ \\dfrac a b } = \\dfrac{ \\sqrt[n]{a} }{ \\sqrt[n]{b} }\n$$" :tutorial/id #uuid "a1d735da-05d5-5959-9226-229b7c29c497" :tutorial/math-academy-id 6692 :tutorial/title "The Quotient Rule for Cube Roots and Other Radicals"} :step/id #uuid "57fbfe53-6167-5a8c-ac3b-d190aa02b687" :step/math-academy-id 40523} {:db/id #edb/ref 17592186069779 :step/content {:db/id #edb/ref 17592186068837 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068443 :question/id #uuid "40af3166-710b-508c-9a8e-2c54365cd238" :question/math-academy-id "e-10712"} :knowledge-point/id #uuid "f03bcc0e-23e1-534b-81bb-146079d37c3e" :knowledge-point/questions [{:db/id #edb/ref 17592186069229} {:db/id #edb/ref 17592186069419} {:db/id #edb/ref 17592186503721} {:db/id #edb/ref 17592186542127} {:db/id #edb/ref 17592186542226}] :knowledge-point/title "Simplifying a Radical Expression With Domain Restrictions"} :step/id #uuid "25606295-3ea3-509a-91f7-294ef43bb1c1" :step/math-academy-id 40568 :step/next {:db/id #edb/ref 17592186069778}} {:db/id #edb/ref 17592186069780 :step/content {:db/id #edb/ref 17592186068838 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068444 :question/id #uuid "9ceac090-9a1c-57d7-a311-f771ece6e0b6" :question/math-academy-id "e-10716"} :knowledge-point/id #uuid "eeca0971-59ed-576d-a248-293decd655b1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048132}] :knowledge-point/questions [{:db/id #edb/ref 17592186069071} {:db/id #edb/ref 17592186069072} {:db/id #edb/ref 17592186503650} {:db/id #edb/ref 17592186503686} {:db/id #edb/ref 17592186542155} {:db/id #edb/ref 17592186542186}] :knowledge-point/title "Simplifying Radical Expressions With Perfect Fourths Under the Radical"} :step/id #uuid "d917615e-b6ee-5929-8832-7bcfe670df91" :step/math-academy-id 40586 :step/next {:db/id #edb/ref 17592186069779}}] :activity/title "Simplifying Square Root Expressions Using the Quotient Rule" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068937}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186542270} :activity/id #uuid "ee3bbf0a-d993-58e5-a8fc-07c4a231168f" :activity/scope {:db/id #edb/ref 17592186050887 :topic/id #uuid "6e563fb5-2e53-5b68-a90b-a963f8d0dc96" :topic/math-academy-id 390} :activity/steps [{:db/id #edb/ref 17592186542239 :step/content {:db/id #edb/ref 17592186542186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2eb4d114-2918-5ab2-bf22-75e0da8cb4b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12|b|" :db/id #edb/ref 17592186541515} {:answer/id #uuid "909bae66-0894-556e-9500-12a1b7a472c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6{b}^{2}" :db/id #edb/ref 17592186541718} {:answer/id #uuid "b637ac06-ccda-5d32-8eda-5fa75421a3e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3{b}^{2}}{4}" :db/id #edb/ref 17592186541796} {:answer/id #uuid "cb31de31-8d0b-5162-a0c9-422a314cd031" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3{b}^{2}}{8}" :db/id #edb/ref 17592186541853} {:answer/id #uuid "de41d849-2235-524b-857c-75638f3eee68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3|b|}{4}" :db/id #edb/ref 17592186541893}] :answer-field/correct {:db/id #edb/ref 17592186541796} :answer-field/id #uuid "db7da12b-df2d-5c36-a689-024827fa16bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542072}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ad438bd0-4fe5-5891-83d5-f58699093a97" :question/math-academy-id "q-162925" :question/problem "$\\sqrt{\\frac{9{b}^{4}}{16}}=$" :question/worked-solution "First, we put the numerator and denominator under separate radicals and then simplify the result:\n\n$$\n\\sqrt{\\frac{9{b}^{4}}{16}}=\\frac{\\sqrt{9{b}^{4}}}{\\sqrt{16}}=\\frac{\\sqrt{9{b}^{4}}}{\\sqrt{{4}^{2}}}=\\frac{\\sqrt{9{b}^{4}}}{4}\n$$\n\nNow, notice that the expression inside the radical is a perfect square. So, we can continue simplifying by writing the expression as this perfect square:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{9{b}^{4}}}{4} & = \\\\ \\frac{\\sqrt{(3{b}^{2})^{2}}}{4} & = \\\\ \\frac{|3{b}^{2}|}{4} & = \\\\ \\frac{|3|\\cdot |{b}^{2}|}{4} & = \\\\ \\frac{3\\cdot |{b}^{2}|}{4}\\end{aligned}\n$$\n\nA squared number is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have\n\n$$\n\\begin{aligned}\\frac{3\\cdot |{b}^{2}|}{4} & = \\\\ \\frac{3\\cdot {b}^{2}}{4} & = \\\\ \\frac{3{b}^{2}}{4}.\\end{aligned}\n$$"} :step/id #uuid "1bd8041d-54cf-5609-a2c4-badf0fb9dad3" :step/next {:db/id #edb/ref 17592186542246}} {:db/id #edb/ref 17592186542242 :step/content {:db/id #edb/ref 17592186542127 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c7b78ca-8580-5c9a-9e23-bd4f302f7745" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4{q}^{2}}" :db/id #edb/ref 17592186541551} {:answer/id #uuid "52b37762-6860-50dd-aeb0-d0cabcd4e494" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{8q}" :db/id #edb/ref 17592186541590} {:answer/id #uuid "5b54469f-3889-528d-887c-1afa870e8a1e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4q}" :db/id #edb/ref 17592186541603} {:answer/id #uuid "685b98ba-a8e1-5c4f-b9d8-047835caaa45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{8q}" :db/id #edb/ref 17592186541632} {:answer/id #uuid "9043e801-59d7-5790-8af9-6f696592f319" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{8{q}^{2}}" :db/id #edb/ref 17592186541715}] :answer-field/correct {:db/id #edb/ref 17592186541590} :answer-field/id #uuid "e404fc04-8fb2-5959-b21b-6f275023d337" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542080}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "21c2ef3e-e8f5-5baf-b96b-0dcf270605ef" :question/math-academy-id "q-162953" :question/problem "Simplify $\\sqrt{\\frac{9}{64{q}^{2}}}$ given that $q>0.$" :question/worked-solution "First, we put the numerator and denominator under separate radicals and then simplify the result:\n\n$$\n\\sqrt{\\frac{9}{64{q}^{2}}}=\\frac{\\sqrt{9}}{\\sqrt{64{q}^{2}}}=\\frac{\\sqrt{{3}^{2}}}{\\sqrt{64{q}^{2}}}=\\frac{3}{\\sqrt{64{q}^{2}}}\n$$\n\nNow, notice that the expression inside the radical is a perfect square. So, we can continue simplifying by writing the expression as this perfect square:\n\n$$\n\\begin{aligned}\\frac{3}{\\sqrt{64{q}^{2}}} & = \\\\ \\frac{3}{\\sqrt{(8q)^{2}}} & = \\\\ \\frac{3}{|8q|} & = \\\\ \\frac{3}{|8|\\cdot |q|} & = \\\\ \\frac{3}{8\\cdot |q|}\\end{aligned}\n$$\n\nLastly, we are told that $q>0,$ so we have $|q|=q.$ Therefore, the final answer is\n\n$$\n\\begin{aligned}\\frac{3}{8\\cdot |q|} & = \\\\ \\frac{3}{8\\cdot q} & = \\\\ \\frac{3}{8q}.\\end{aligned}\n$$"} :step/id #uuid "26cd2bb1-3bcf-502c-a435-ef5e74ba0530"} {:db/id #edb/ref 17592186542246 :step/content {:db/id #edb/ref 17592186542155 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cdfb1d6-c6c1-5db2-a980-ce6c3297090a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25t" :db/id #edb/ref 17592186541608} {:answer/id #uuid "c4f4cc0a-9998-5ff9-9843-1a1abb3513fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\sqrt{t}" :db/id #edb/ref 17592186541837} {:answer/id #uuid "cf54f03f-7bc1-5fbd-ba32-a303174a4ad1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5t}" :db/id #edb/ref 17592186541861} {:answer/id #uuid "d71cb3dd-3e7f-5450-8b7f-a549af417b2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25{t}^{2}" :db/id #edb/ref 17592186541882} {:answer/id #uuid "e7c6bcbf-624c-5a0d-bf2e-2dc05e823676" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{t}^{2}" :db/id #edb/ref 17592186541914}] :answer-field/correct {:db/id #edb/ref 17592186541914} :answer-field/id #uuid "a6085066-0ecc-5f31-ba69-929db19f889c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542046}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6a46c4fe-4fbf-584a-9b57-cb0bbf472594" :question/math-academy-id "q-162933" :question/problem "$\\frac{\\sqrt{125{t}^{4}}}{\\sqrt{5}}=$" :question/worked-solution "First, we bring the quotient under a single radical and then simplify the result:\n\n$$\n\\frac{\\sqrt{125{t}^{4}}}{\\sqrt{5}}=\\sqrt{\\frac{125{t}^{4}}{5}}=\\sqrt{25{t}^{4}}\n$$\n\nNow, notice that the expression inside the radical is a perfect square. So, we can continue simplifying by writing the expression as this perfect square:\n\n$$\n\\begin{aligned}\\sqrt{25{t}^{4}} & = \\\\ \\sqrt{(5{t}^{2})^{2}} & = \\\\ |5{t}^{2}| & = \\\\ |5|\\cdot |{t}^{2}| & = \\\\ 5\\cdot |{t}^{2}|\\end{aligned}\n$$\n\nA squared number is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have\n\n$$\n\\begin{aligned}5\\cdot |{t}^{2}| & = \\\\ 5\\cdot {t}^{2} & = \\\\ 5{t}^{2}.\\end{aligned}\n$$"} :step/id #uuid "311b2fda-a010-566e-93e7-acf12c4fd8a2" :step/next {:db/id #edb/ref 17592186542242}} {:db/id #edb/ref 17592186542270 :step/content {:db/id #edb/ref 17592186542226 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d11c2d2-3001-5e8a-be3a-e32230076db9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{z}^{2}" :db/id #edb/ref 17592186541553} {:answer/id #uuid "98d13ba9-dfd3-52c2-b70f-fb7735e5b240" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4z" :db/id #edb/ref 17592186541740} {:answer/id #uuid "a852ddcc-f65d-5be4-bb4e-4120b2627298" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{z}^{2}" :db/id #edb/ref 17592186541768} {:answer/id #uuid "bf0b0421-5aec-5d9c-a383-f76749bb0f15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{z}" :db/id #edb/ref 17592186541824} {:answer/id #uuid "f8c3f8b1-179e-5104-b995-51741f073176" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2z" :db/id #edb/ref 17592186541941}] :answer-field/correct {:db/id #edb/ref 17592186541941} :answer-field/id #uuid "18f8115a-b5d4-5929-a1c8-36a6a9737a96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186541976}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f043c885-cf65-5aa1-b5b8-12a5b94bca34" :question/math-academy-id "q-152384" :question/problem "Simplify $\\frac{\\sqrt{32{z}^{5}}}{\\sqrt{8{z}^{3}}}$ given that $z>0.$" :question/worked-solution "First, we bring the quotient under a single radical and then simplify the result:\n\n$$\n\\frac{\\sqrt{32{z}^{5}}}{\\sqrt{8{z}^{3}}}=\\sqrt{\\frac{32{z}^{5}}{8{z}^{3}}}=\\sqrt{4{z}^{2}}\n$$\n\nNow, notice that the expression inside the radical is a perfect square. So, we can continue simplifying by writing the expression as this perfect square:\n\n$$\n\\begin{aligned}\\sqrt{4{z}^{2}} & = \\\\ \\sqrt{{2}^{2}{z}^{2}} & = \\\\ \\sqrt{{(2z)}^{2}} & = \\\\ |2z| & = \\\\ |2|\\cdot |z| & = \\\\ 2\\cdot |z| & \\end{aligned}\n$$\n\nLastly, we are told that $z>0,$ so we have $|z|=z.$ Therefore, the final answer is\n\n$$\n\\begin{aligned}2\\cdot |z| & = \\\\ 2\\cdot z & = \\\\ 2z.\\end{aligned}\n$$"} :step/id #uuid "87aa8fbe-097a-54cb-9c88-e60e947273cc" :step/next {:db/id #edb/ref 17592186542239}}] :activity/title "Simplifying Square Root Expressions Using the Quotient Rule" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186541423}]}
