#{[{:db/id #edb/ref 17592186551299 :knowledge-point/_questions [{:db/id #edb/ref 17592186064329 :knowledge-point/id #uuid "7f0b9133-daf8-5f04-8fa1-c8c3210c4487" :knowledge-point/title "Factoring a Difference of Squares with Leading Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33e05cb0-0d11-5a48-ae94-2df779dd5f0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{s}{5}+\\frac{1}{9})(\\frac{s}{5}-\\frac{1}{9})" :db/id #edb/ref 17592186550494} {:answer/id #uuid "3d3da440-df14-5563-8357-d5962df16751" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{s}{3}-\\frac{1}{5})(\\frac{s}{3}-\\frac{1}{5})" :db/id #edb/ref 17592186550508} {:answer/id #uuid "6b0dd266-8b12-51fc-9c32-a952e58010e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{s}{5}+\\frac{1}{9})(\\frac{s}{5}+\\frac{1}{9})" :db/id #edb/ref 17592186550631} {:answer/id #uuid "df3163ca-87f7-559b-8a74-14ac6aab05d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{s}{9}+\\frac{1}{5})(\\frac{s}{9}-\\frac{1}{5})" :db/id #edb/ref 17592186550974} {:answer/id #uuid "f3f16648-6db8-53b7-95d5-df7ac3de4c04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{s}{5}+\\frac{1}{3})(\\frac{s}{5}-\\frac{1}{3})" :db/id #edb/ref 17592186551022}] :answer-field/correct {:answer/id #uuid "33e05cb0-0d11-5a48-ae94-2df779dd5f0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{s}{5}+\\frac{1}{9})(\\frac{s}{5}-\\frac{1}{9})" :db/id #edb/ref 17592186550494} :answer-field/id #uuid "77716a4d-fef6-5073-82d5-f3b9f059ff15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551133}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "840068df-b5bb-5a8c-a125-569067cf40da" :question/math-academy-id "q-111663" :question/problem "$\\frac{{s}^{2}}{25}-\\frac{1}{81}$ is equivalent to" :question/worked-solution "First, we write the expression as a difference of squares:\n\n$$\n\\frac{{s}^{2}}{25}-\\frac{1}{81}={(\\frac{s}{5})}^{2}-{(\\frac{1}{9})}^{2}\n$$\n\nThen, we factor the expression using the difference of squares formula:\n\n$$\n\\begin{aligned}{(\\frac{s}{5})}^{2}-{(\\frac{1}{9})}^{2}=(\\frac{s}{5}+\\frac{1}{9})(\\frac{s}{5}-\\frac{1}{9}) & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186551336 :knowledge-point/_questions [{:db/id #edb/ref 17592186073788 :knowledge-point/id #uuid "1a31c2b6-585a-5715-98f8-4b82605f4c22" :knowledge-point/title "Simplifying Expressions Containing Cube Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "065ae3c0-fb6b-5bbc-8244-e1ceaeb58116" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\sqrt[3]{21}" :db/id #edb/ref 17592186550388} {:answer/id #uuid "55cb117a-a3e3-57c8-a572-86ad57a0929d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10\\sqrt[3]{21}" :db/id #edb/ref 17592186550575} {:answer/id #uuid "6f827fd0-d5f1-5251-bb83-ba5f01eb8e5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-21\\sqrt[3]{21}" :db/id #edb/ref 17592186550648} {:answer/id #uuid "ca21d742-cc43-5c28-9388-f527772dc009" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt[3]{21}" :db/id #edb/ref 17592186550912} {:answer/id #uuid "cd152fad-4d16-5965-9278-80d8a20ea542" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\sqrt[3]{21}" :db/id #edb/ref 17592186550918}] :answer-field/correct {:answer/id #uuid "ca21d742-cc43-5c28-9388-f527772dc009" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt[3]{21}" :db/id #edb/ref 17592186550912} :answer-field/id #uuid "d99382d4-4eef-5bcc-8e0c-245c996446a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551205}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d56a0cf9-3169-596f-ae20-a8cf3a250f28" :question/math-academy-id "q-134560" :question/problem "$7\\sqrt[3]{21}-3\\sqrt[3]{21}=$" :question/worked-solution "We can combine the two $\\sqrt[3]{21}$ terms together, as follows:\n\n$$\n\\begin{aligned}7\\sqrt[3]{21}-3\\sqrt[3]{21} & = \\\\ (7-3)\\sqrt[3]{21} & = \\\\ 4\\sqrt[3]{21} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186551234 :knowledge-point/_questions [{:db/id #edb/ref 17592186110620 :knowledge-point/id #uuid "e880edeb-82ad-5943-a846-dc3246e3e3bd" :knowledge-point/title "Cross-Multiplying with Two Binomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "524035be-2593-5a4d-bfe2-d81c72edfd13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C=4" :db/id #edb/ref 17592186550563} {:answer/id #uuid "65c90b5a-a03b-5bf6-8480-c7c62bfe9030" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C=8" :db/id #edb/ref 17592186550617} {:answer/id #uuid "7f05a7c3-f108-5a33-a17e-501c5172c2c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C=2" :db/id #edb/ref 17592186550686} {:answer/id #uuid "aa5cff85-b17d-5788-a258-7f1b6edc431f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C=3" :db/id #edb/ref 17592186550824} {:answer/id #uuid "fd2d7f86-1899-5971-8da0-f2042a0e6b74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C=6" :db/id #edb/ref 17592186551048}] :answer-field/correct {:answer/id #uuid "fd2d7f86-1899-5971-8da0-f2042a0e6b74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C=6" :db/id #edb/ref 17592186551048} :answer-field/id #uuid "e58248cb-cc47-5d46-bdcf-ee616fe70ffa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551213}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0a65343e-809a-580c-9503-c6f1ca221068" :question/math-academy-id "q-14753" :question/problem "Solve for $C$ where $\\frac{C-4}{3}=\\frac{C-2}{6}.$" :question/worked-solution "First, we cross-multiply:\n\n$$\n\\begin{aligned}\\frac{C-4}{3} & =\\frac{C-2}{6} \\\\ (C-4)\\cdot 6 & =3\\cdot (C-2)\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}(C-4)\\cdot 6 & =3\\cdot (C-2) \\\\ 6C-24 & =3C-6 \\\\ 6C-24-3C & =3C-6-3C \\\\ 3C-24 & =-6 \\\\ 3C-24+24 & =-6+24 \\\\ 3C & =18 \\\\ \\frac{3C}{3} & =\\frac{18}{3} \\\\ C & =6\\end{aligned}\n$$\n\nThus, $C=6.$"}] [{:db/id #edb/ref 17592186551284 :knowledge-point/_questions [{:db/id #edb/ref 17592186054771 :knowledge-point/id #uuid "200fc394-b299-5114-8f39-e6265f3c1166" :knowledge-point/title "Solving a One-Step Inequality With Fractions When Flipping Is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00426310-f76d-56f6-ba30-c47b331278a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\ge -9" :db/id #edb/ref 17592186550368} {:answer/id #uuid "40f2638c-2ac7-53e0-a8a3-97b62783762e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\le -9" :db/id #edb/ref 17592186550518} {:answer/id #uuid "4b95ea89-bff8-543e-8bf5-469472004602" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\le 1" :db/id #edb/ref 17592186550546} {:answer/id #uuid "9f72d829-4271-58e8-a988-e7422040bc4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\ge -1" :db/id #edb/ref 17592186550777} {:answer/id #uuid "dc2f9355-cedb-5f9d-876c-a0aae0d73911" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\ge 9" :db/id #edb/ref 17592186550967}] :answer-field/correct {:answer/id #uuid "00426310-f76d-56f6-ba30-c47b331278a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\ge -9" :db/id #edb/ref 17592186550368} :answer-field/id #uuid "4e4a26f0-ed0b-57e8-a627-d6b00292461a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551112}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "66604494-d5d9-5eb8-81e3-a76e00656f7f" :question/math-academy-id "q-154008" :question/problem "Solve the inequality $-\\frac{y}{3}\\le 3.$" :question/worked-solution "The variable $y$ is being *divided* by $3.$ To isolate $y$ and remove the negative sign, we *multiply* by $-3.$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-\\frac{y}{3}\\,\\, & \\le \\,\\,3 \\\\ (-3)\\cdot (-\\frac{y}{3})\\,\\, & \\ge \\,\\,(-3)\\cdot 3 \\\\ (-3)\\cdot (-\\frac{y}{3})\\,\\, & \\ge \\,\\,-9\\end{aligned}\n$$\n\nSince two negative numbers multiply to give a positive number, we first cancel the negatives:\n\n$$\n\\begin{aligned}(-3)\\cdot (-\\frac{y}{3}) & \\ge -9 \\\\ (\\cancel{-}3)\\cdot (\\cancel{-}\\frac{y}{3}) & \\ge -9 \\\\ 3\\cdot \\frac{y}{3} & \\ge -9\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $3$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}3\\cdot \\frac{y}{3} & \\ge -9 \\\\ \\frac{3y}{3} & \\ge -9 \\\\ \\frac{\\cancel{3}y}{\\cancel{3}} & \\ge -9 \\\\ y & \\ge -9\\end{aligned}\n$$\n\nTherefore, the solution is $y\\ge -9.$"}] [{:db/id #edb/ref 17592186551329 :knowledge-point/_questions [{:db/id #edb/ref 17592186073742 :knowledge-point/id #uuid "3eb85b52-cd40-5469-b2f5-ceee2f0bf0cb" :knowledge-point/title "Calculating an Unknown Quantity From a Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b1dd17e-6a46-5835-a89d-5170c527c7f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "47" :db/id #edb/ref 17592186550632}] :answer-field/correct {:answer/id #uuid "6b1dd17e-6a46-5835-a89d-5170c527c7f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "47" :db/id #edb/ref 17592186550632} :answer-field/id #uuid "cf5500f0-2865-526a-8496-9b3d246cba65" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186551195}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bc6c1cea-fda3-5da9-9a26-2a572a4b6650" :question/math-academy-id "q-171875" :question/problem "![](images/d2/d29179efa4eaaf77d34a7c044e82c8a6bf053763adf829b83207b652d39fa531.png)\n\nIn the figure above, $m∠B=${{field-1}}${}^{∘}.$" :question/worked-solution "Since the sum of the measures of the interior angles of a triangle is ${180}^{∘}$, we have\n\n$$\n\\begin{aligned}{74}^{∘}+(3x+{2}^{∘})+(4x-{1}^{∘}) & ={180}^{∘} \\\\ {75}^{∘}+7x & ={180}^{∘} \\\\ 7x & ={105}^{∘} \\\\ x & ={15}^{∘}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nm∠B=3x+{2}^{∘}=3({15}^{∘})+{2}^{∘}={47}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186551343 :knowledge-point/_questions [{:db/id #edb/ref 17592186068711 :knowledge-point/id #uuid "61dbfea6-68e8-56b0-aae1-a48fdd8839b1" :knowledge-point/title "Solving Absolute Value Equations With Negative Variable Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17e936a5-a46e-5f28-bee3-fe36f08d04ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186550420}] :answer-field/correct {:answer/id #uuid "17e936a5-a46e-5f28-bee3-fe36f08d04ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186550420} :answer-field/id #uuid "08683cb0-0568-5527-8640-5395efa58e06" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186551066} {:answer-field/choices [{:answer/id #uuid "a7870dc6-533c-55cb-a45b-d1c9d01bcb2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186550810}] :answer-field/correct {:answer/id #uuid "a7870dc6-533c-55cb-a45b-d1c9d01bcb2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186550810} :answer-field/id #uuid "87d09cd1-be9d-5d97-9558-cf66eb1f306a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186551148}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dbb8c729-ab7f-5cd4-a54a-d589b9fc5814" :question/math-academy-id "q-215134" :question/problem "Written in **ascending order**, the solutions to $|9-y|=4$ are $y=${{field-1}} and $y=$\n{{field-2}}." :question/worked-solution "Either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nSo, we set up the two corresponding equations and solve them independently:\n\n- If $|9-y|=9-y,$ we obtain:\n\n$$\n\\begin{aligned}|9-y| & =4 \\\\ 9-y & =4 \\\\ -y & =-5 \\\\ y & =5\\end{aligned}\n$$\n\n- If $|9-y|=-(9-y),$ we obtain:\n\n$$\n\\begin{aligned}|9-y| & =4 \\\\ -(9-y) & =4 \\\\ -9+y & =4 \\\\ y & =13\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $y=5$ and $y=13.$"}] [{:db/id #edb/ref 17592186551254 :knowledge-point/_questions [{:db/id #edb/ref 17592186064303 :knowledge-point/id #uuid "0b64073e-4aa0-551c-b914-98420b0be338" :knowledge-point/title "Using the Power Rule with Fractional Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24c427ff-136d-5e02-834c-78d58866a1f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(16b)}^{1/5}" :db/id #edb/ref 17592186550457} {:answer/id #uuid "8ce1cc38-1be6-55d2-9892-38dca132ddb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(4b)}^{5/2}" :db/id #edb/ref 17592186550726} {:answer/id #uuid "9bc6d199-9f38-5b42-89b2-79ce40f67e2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(4{b}^{2})}^{1/5}" :db/id #edb/ref 17592186550763} {:answer/id #uuid "aa4104de-0fb6-5d3a-9b4d-86d5cc5eba4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(4b)}^{2/5}" :db/id #edb/ref 17592186550822} {:answer/id #uuid "ba7ceab6-ffe9-5a0f-99e5-f4ff8d2f405c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4b\\sqrt[5]{4b}" :db/id #edb/ref 17592186550881}] :answer-field/correct {:answer/id #uuid "aa4104de-0fb6-5d3a-9b4d-86d5cc5eba4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(4b)}^{2/5}" :db/id #edb/ref 17592186550822} :answer-field/id #uuid "62734ab9-d09e-5de4-8437-31e23e927829" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551122}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2d3bb2ee-cb7d-5b52-9b6d-3169a083b4de" :question/math-academy-id "q-2973" :question/problem "$\\sqrt[5]{{(4b)}^{2}}$ is equivalent to" :question/worked-solution "First, we convert the radical to a fractional exponent, and then we apply the power rule:\n\n$$\n\\begin{aligned}\\sqrt[5]{{(4b)}^{2}} & = \\\\ {({(4b)}^{2})}^{1/5} & = \\\\ {(4b)}^{2\\cdot (1/5)} & = \\\\ {(4b)}^{2/5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186551241 :knowledge-point/_questions [{:db/id #edb/ref 17592186147475 :knowledge-point/id #uuid "bb2a01a6-39e9-55ac-ac4a-eaab72e72257" :knowledge-point/title "Modeling Exponential Growth Using Percentage Increases Greater Than 100%"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80a4e79f-f5e3-5dea-8677-36fb735e95bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D(t)=60\\cdot (22)^{t}" :db/id #edb/ref 17592186550694} {:answer/id #uuid "8cc1db70-ceb5-5077-8253-f53025313cf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D(t)=60\\cdot (12)^{t}" :db/id #edb/ref 17592186550725} {:answer/id #uuid "a925509f-f08c-58a9-b080-19cb6b1fa0ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D(t)=60\\cdot (0.2)^{t}" :db/id #edb/ref 17592186550817} {:answer/id #uuid "ae522b8c-fb7c-5e53-b9b0-80eb9a9e7dfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D(t)=60\\cdot (1.2)^{t}" :db/id #edb/ref 17592186550839} {:answer/id #uuid "f15b3e3b-3933-5a12-84e9-ce050c7c09a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D(t)=60\\cdot (2.2)^{t}" :db/id #edb/ref 17592186551018}] :answer-field/correct {:answer/id #uuid "f15b3e3b-3933-5a12-84e9-ce050c7c09a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D(t)=60\\cdot (2.2)^{t}" :db/id #edb/ref 17592186551018} :answer-field/id #uuid "c306525f-8dcb-5d5f-ac56-1625bc0e3733" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551185}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1818fb31-e6dd-51ed-98a5-48141bc40666" :question/math-academy-id "q-318203" :question/problem "When a new app was first launched, it had $60$ downloads. An exponential model estimates that at the end of each day after launch, the number of downloads increased by $120%$ of the number of downloads at the end of the previous day.\n\nWhich of the following equations best represents this model, where $D$ is the estimated number of downloads $t$ days after the app was launched, and $t\\le 7?$" :question/worked-solution "The number of downloads $D(t)$ grows exponentially with a growth rate of $120%.$\n\nLet's write down what we know:\n\n- $a=60$ is the total number of downloads initially\n\n- $r=1.2$ is the growth rate ($120%$ expressed as a decimal)\n\n- $t=$ the time (in days) after launch\n\nThe formula for exponential growth (in terms of a growth rate $r$) is\n\n$$\nD=a(1+r)^{t}.\n$$\n\nTherefore, the correct expression for $D(t)$ is\n\n$$\nD=60\\cdot (1+1.2)^{t}.\n$$\n\nSimplifying the above, we get\n\n$$\nD(t)=60\\cdot (2.2)^{t}.\n$$"}] [{:db/id #edb/ref 17592186551283 :knowledge-point/_questions [{:db/id #edb/ref 17592186068805 :knowledge-point/id #uuid "6a17d9d6-cd3a-554e-98d2-7e9536950bd0" :knowledge-point/title "Simplifying Rational Expressions With Common Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a8498bc-b719-557e-9763-d7cba7322c58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4(t+2)^{2}}" :db/id #edb/ref 17592186550543} {:answer/id #uuid "6ac0e7f3-b048-5528-adf6-7217ade58ad6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3t+2" :db/id #edb/ref 17592186550629} {:answer/id #uuid "8390fa53-be06-51cf-8aa3-c8e2da6accdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186550700} {:answer/id #uuid "9cd45af2-78e3-56bc-a520-df5551e2b7bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(t+2)^{2}}{4}" :db/id #edb/ref 17592186550767} {:answer/id #uuid "ce52509e-469f-5c06-abf8-ae17dc40dbde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186550923}] :answer-field/correct {:answer/id #uuid "8390fa53-be06-51cf-8aa3-c8e2da6accdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186550700} :answer-field/id #uuid "a641e9d4-b840-5597-8760-455f2c53c4f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551163}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6410f1b3-233a-5db4-a768-91ae7f99b09a" :question/math-academy-id "q-3479" :question/problem "What is $\\frac{3t+6}{4t+8}$ reduced to its lowest terms?" :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\\frac{3t+6}{4t+8} & =\\frac{3\\cdot (t+2)}{4\\cdot (t+2)} \\\\  & =\\frac{3\\cdot \\cancel{(t+2)}}{4\\cdot \\cancel{(t+2)}} \\\\  & =\\frac{3}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186551315 :knowledge-point/_questions [{:db/id #edb/ref 17592186489169 :knowledge-point/id #uuid "2ee93f86-38d1-591a-b694-a4f455240d75" :knowledge-point/title "Expressing a Rational Number as a Repeating Decimal Using Long Division"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17c3be89-aca7-5ac7-b8f7-e39eb22b9863" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42.6\\overset{―}{1}" :db/id #edb/ref 17592186550419} {:answer/id #uuid "40019526-1666-5f1d-8230-6381166fb1c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42.1\\overset{―}{6}" :db/id #edb/ref 17592186550515} {:answer/id #uuid "43711b70-d073-5cbd-a084-cdf5e0e6cbd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "41.1\\overset{―}{6}" :db/id #edb/ref 17592186550526} {:answer/id #uuid "6d555af7-aaf2-50c3-91c0-af81c12d446a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42.6\\overset{―}{6}" :db/id #edb/ref 17592186550639} {:answer/id #uuid "c0586438-67ae-5057-a65e-de88d395b4c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42.1\\overset{―}{3}" :db/id #edb/ref 17592186550895}] :answer-field/correct {:answer/id #uuid "40019526-1666-5f1d-8230-6381166fb1c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42.1\\overset{―}{6}" :db/id #edb/ref 17592186550515} :answer-field/id #uuid "c6059ab7-5ca5-52c9-ad6a-30214539ee65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551187}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9c3882c6-2da8-5fcb-8c4a-eadb749133f7" :question/math-academy-id "q-357516" :question/problem "Convert $\\frac{253}{6}$ into a repeating decimal using long division." :question/worked-solution "To write the fraction as a decimal, we divide the numerator by the denominator:\n\n$$\n253÷6\n$$\n\nWe proceed using long division as usual, continuing until a repeating pattern of digits appears after the decimal point:\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" width=\"150\">\n<br/><br/><table align=\"left\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"left\" height=\"20\" width=\"20\"></td>\n<td align=\"left\" colspan=\"7\" height=\"20\" width=\"15\">$\\,\\,\\,4\\,2\\,.\\,1\\,6\\,6\\,…$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\">$6$</td>\n<td align=\"left\" colspan=\"7\" height=\"20\" width=\"15\">$\\,\\enclose{longdiv}{2\\,\\phantom{|}5\\,\\phantom{|}3\\,.\\,0\\,\\phantom{|}0\\,\\phantom{|}0}$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\,\\,\\,\\,\\,\\,$</td><td align=\"center\" height=\"20\" width=\"15\">$2$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$4$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$3$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\,\\,\\,$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$2$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$-$</td><td align=\"center\" height=\"20\" width=\"15\">$6$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$4$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\,0$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\,\\,$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$3$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\,6$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\,4$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\,0$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\,\\,$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\,3$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\,6$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\,4$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\,⋮$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n</tbody></table>\n<p></p></td>\n</tr>\n</tbody></table>\n\nWe could continue the division, but the same digit keeps repeating. Thus, the decimal continues with repeating $6$'s:\n\n$$\n42.166…\n$$\n\nTherefore,\n\n$$\n\\frac{253}{6}=42.166…=42.1\\overset{―}{6}.\n$$"}] [{:db/id #edb/ref 17592186551249 :knowledge-point/_questions [{:db/id #edb/ref 17592186054668 :knowledge-point/id #uuid "9b84d144-1a2b-5007-817e-20a5d6446515" :knowledge-point/title "Identifying a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48be1cd8-aced-52d8-a52d-d13f65e8987d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f3/f3388c31419e07c151621