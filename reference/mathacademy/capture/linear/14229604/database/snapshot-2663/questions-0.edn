llowing vertical line:\n\n![](images/00/00b0a9c54b56b91417cb89752b39b1d5969ca631cc56da84815a0bb5d4cbead3.png)"}] [{:db/id #edb/ref 17592186551334 :knowledge-point/_questions [{:db/id #edb/ref 17592186068850 :knowledge-point/id #uuid "942732a6-ca14-5b61-b8fb-ab9ef81610cf" :knowledge-point/title "Finding the Cube Root of a Monomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0826b2a3-5ac7-5dcc-ac1d-bf03465aeb17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3x" :db/id #edb/ref 17592186550391} {:answer/id #uuid "27bed5b6-f163-5dd7-8925-f268bc816087" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x" :db/id #edb/ref 17592186550465} {:answer/id #uuid "8ab00684-1404-54cc-8b78-5a8eed09285d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x" :db/id #edb/ref 17592186550720} {:answer/id #uuid "9556c8b9-a5b5-559b-8d5e-07a1166eca58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}" :db/id #edb/ref 17592186550742} {:answer/id #uuid "af753c10-bf82-5a32-9969-0aabdfdf7f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186550846}] :answer-field/correct {:answer/id #uuid "8ab00684-1404-54cc-8b78-5a8eed09285d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x" :db/id #edb/ref 17592186550720} :answer-field/id #uuid "c7d07edc-50fb-51a7-81d6-22b65ff2e867" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551189}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c6c9bca9-ea70-5989-b840-49d437c3ef76" :question/math-academy-id "q-52490" :question/problem "$\\sqrt[3]{-{x}^{3}}=$" :question/worked-solution "We write the term under the radical as a perfect cube, and simplify:\n\n$$\n\\begin{aligned}\\sqrt[3]{-{x}^{3}} & = \\\\ \\sqrt[3]{-x\\cdot x\\cdot x} & = \\\\ \\sqrt[3]{(-x)\\cdot (-x)\\cdot (-x)} & = \\\\ \\sqrt[3]{(-x)^{3}} & = \\\\ -x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186551238 :knowledge-point/_questions [{:db/id #edb/ref 17592186073882 :knowledge-point/id #uuid "d710628f-14e0-5587-90d1-564a5e0ead19" :knowledge-point/title "Using a Ratio to Compute a Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d5e8c8f-f6e7-56e5-8a31-fc7adcc316f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ meters" :db/id #edb/ref 17592186550403} {:answer/id #uuid "2d244888-b2c9-5337-8e94-586debfc6129" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$36$ meters" :db/id #edb/ref 17592186550479} {:answer/id #uuid "4a070890-c9f5-5a17-980a-3eb585400e7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$32$ meters" :db/id #edb/ref 17592186550542} {:answer/id #uuid "b9811572-1c25-5655-8a5c-e49f5bdc3be6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$9$ meters" :db/id #edb/ref 17592186550879} {:answer/id #uuid "cde15c88-15bc-555a-ab11-1026e804b48c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ meters" :db/id #edb/ref 17592186550921}] :answer-field/correct {:answer/id #uuid "b9811572-1c25-5655-8a5c-e49f5bdc3be6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$9$ meters" :db/id #edb/ref 17592186550879} :answer-field/id #uuid "2ec32fd6-a036-5546-a09f-d04ace386339" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551093}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "14d57c7d-ff6e-530b-b67b-f43cfc293439" :question/math-academy-id "q-92838" :question/problem "The ratio of the width of a volleyball court to its length is $\\frac{1}{2}.$ If the length of the volleyball court is $18$ meters, what is its width?" :question/worked-solution "The ratio of width to length is $\\frac{1}{2}.$\n\nIn this fraction, the numerator represents the width and the denominator represents the length.\n\nWe can make a denominator of $18$ by multiplying the numerator and denominator by $9$:\n\n$$\n\\frac{1\\times 9}{2\\times 9}=\\frac{9}{18}\n$$\n\nTherefore, the width of the volleyball court is $9$ meters."}]}
