id "1bc06e8b-9454-5e2b-82fd-21d690bf6ad3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186065721}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1c66045b-0cd9-5504-b541-34258606f987" :question/math-academy-id "q-140" :question/problem "$\\frac{7x+1}{7x}=$" :question/worked-solution "The numerator and denominator have no common factors, so the expression can not be reduced. The expression \n\n$$\n\\frac{7x+1}{7x}\n$$\n\n is already in lowest terms."} :step/id #uuid "06ab3711-3d4c-5c2c-8653-bca368f0f08b" :step/next {:db/id #edb/ref 17592186502172}} {:db/id #edb/ref 17592186502172 :step/content {:db/id #edb/ref 17592186502073 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3886ddee-8772-528b-bf4d-8bf02e891107" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{5(2g+6)^{2}}" :db/id #edb/ref 17592186501568} {:answer/id #uuid "5450829c-b0a3-5655-bd1c-5951e0c37b62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2g+6" :db/id #edb/ref 17592186501622} {:answer/id #uuid "87a0ab98-9dd0-5490-bcc8-385d1c51bb82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186501726} {:answer/id #uuid "afcad7b6-af4e-59d6-82fd-8b0d5cf543c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5(2g+6)^{2}}{4}" :db/id #edb/ref 17592186501815} {:answer/id #uuid "fcd329fc-b34a-5fbb-bd9a-1392f560a2ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186501970}] :answer-field/correct {:db/id #edb/ref 17592186501726} :answer-field/id #uuid "f3dfd035-8faf-5e9c-8f1e-539bc75374da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502058}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0dc91759-1708-5aa4-a78f-8164b2208179" :question/math-academy-id "q-51526" :question/problem "What is $\\frac{10g+30}{8g+24}$ reduced to its lowest terms?" :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\\frac{10g+30}{8g+24} & =\\frac{5(2g+6)}{4(2g+6)} \\\\  & =\\frac{5\\cancel{(2g+6)}}{4\\cancel{(2g+6)}} \\\\  & =\\frac{5}{4}\\end{aligned}\n$$"} :step/id #uuid "244bf9be-1869-5c01-9bef-c171796be681" :step/next {:db/id #edb/ref 17592186502193}} {:db/id #edb/ref 17592186502193 :step/content {:db/id #edb/ref 17592186502106 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05f4f1f7-644a-5080-b0cf-201bf0a40bc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{x-3}" :db/id #edb/ref 17592186501480} {:answer/id #uuid "070118e9-d838-5a52-8939-3d392169bc42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186501482} {:answer/id #uuid "ac77b55f-c27a-5257-a8fa-649823e99715" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186501809} {:answer/id #uuid "cbc47ca7-0390-52f9-aa36-ff5d3975d9c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186501871} {:answer/id #uuid "daa76a02-84a6-5425-b200-2e9ee6c38aef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3-x}" :db/id #edb/ref 17592186501904}] :answer-field/correct {:db/id #edb/ref 17592186501871} :answer-field/id #uuid "6d7f57eb-669c-54ed-8aa2-d787aac81274" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502013}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "624c7b11-aded-592e-be21-f98c6f89890c" :question/math-academy-id "q-52367" :question/problem "Which of the following is equivalent to $\\frac{2x-6}{3-x}?$" :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\\frac{2x-6}{3-x} & =\\frac{2(x-3)}{-(x-3)} \\\\  & =\\frac{2\\cdot (x-3)}{(-1)\\cdot (x-3)} \\\\  & =\\frac{2\\cdot \\cancel{(x-3)}}{(-1)\\cdot \\cancel{(x-3)}} \\\\  & =\\frac{2}{(-1)} \\\\  & =-2\\end{aligned}\n$$"} :step/id #uuid "906a3f57-f0f9-58fa-b96b-4062bc57287a"}] :activity/title "Simplifying Rational Expressions by Factoring" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186501460}] [{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186111526} :activity/id #uuid "224e6883-ecf1-58d2-8217-7503c15c1910" :activity/scope {:db/id #edb/ref 17592186049846 :topic/id #uuid "1843810f-c12f-5f01-b69f-9484dfe1a88e" :topic/math-academy-id 1413} :activity/steps [{:db/id #edb/ref 17592186111526 :step/content {:db/id #edb/ref 17592186111911 :tutorial/content "If we have rational expressions on both sides of an equation, say,\n\n$$\n\\dfrac{{\\color{red}x-1}}{{\\color{blue}2}} = \\dfrac{{\\color{blue}2x-1}}{{\\color{red}5}},\n$$\n\nthen we can eliminate the rational expressions by applying **cross-multiplication**:\n\n- we cross-multiply the left-hand side numerator $({\\color{red}x-1})$ with the right-hand side denominator $({\\color{red}5}),$ and\n\n- we cross-multiply the left-hand side denominator $({\\color{blue}2})$ with the right-hand side numerator $({\\color{blue}2x-1}).$\n\nDoing this, we get the following equation:\n\n$$\n({\\color{red}x-1}) \\cdot ({\\color{red}5}) = ({\\color{blue}2}) \\cdot ({\\color{blue}2x - 1})\n$$\n\nAfter we've cross-multiplied, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}(x-1)\\cdot 5 & =2\\cdot (2x-1) \\\\ 5x-5 & =4x-2 \\\\ 5x-5+5 & =4x-2+5 \\\\ 5x & =4x+3 \\\\ 5x-4x & =4x+3-4x \\\\ x & =3\\end{aligned}\n$$\n\n**Note:** Cross-multiplication might seem magical, but it is really just a shortcut for multiplying both sides of the equation by each denominator:\n\n$$\n\\begin{aligned}\\frac{x-1}{2} & =\\frac{2x-1}{5} \\\\ 2\\cdot \\frac{x-1}{2} & =2\\cdot \\frac{2x-1}{5} \\\\ \\cancel{2}\\cdot \\frac{x-1}{\\cancel{2}} & =2\\cdot \\frac{2x-1}{5} \\\\ x-1 & =2\\cdot \\frac{2x-1}{5} \\\\ (x-1)\\cdot 5 & =2\\cdot \\frac{2x-1}{5}\\cdot 5 \\\\ (x-1)\\cdot 5 & =2\\cdot \\frac{2x-1}{\\cancel{5}}\\cdot \\cancel{5} \\\\ (x-1)\\cdot (5) & =(2)\\cdot (2x-1)\\end{aligned}\n$$" :tutorial/id #uuid "99ff1453-e12b-518f-94b1-9baf8ee914e6" :tutorial/math-academy-id 8174 :tutorial/title "Introduction"} :step/id #uuid "62154097-0663-58a8-8dfe-b1f260a5583e" :step/math-academy-id 175966 :step/next {:db/id #edb/ref 17592186111527}} {:db/id #edb/ref 17592186111527 :step/content {:db/id #edb/ref 17592186110619 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110320 :question/id #uuid "7df7a073-8131-5732-b353-f89484052e38" :question/math-academy-id "e-13077"} :knowledge-point/id #uuid "3ff2f965-b406-5c9a-bd41-73ccdce951eb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048760}] :knowledge-point/questions [{:db/id #edb/ref 17592186110932} {:db/id #edb/ref 17592186111181} {:db/id #edb/ref 17592186111182} {:db/id #edb/ref 17592186488259} {:db/id #edb/ref 17592186488277} {:db/id #edb/ref 17592186497364}] :knowledge-point/title "Cross-Multiplying with One Binomial"} :step/id #uuid "79e64205-d43a-5719-a973-65d5eb873b04" :step/math-academy-id 175967 :step/next {:db/id #edb/ref 17592186111528}} {:db/id #edb/ref 17592186111528 :step/content {:db/id #edb/ref 17592186110620 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110321 :question/id #uuid "4041cf6f-61b8-5794-9988-436722985bcd" :question/math-academy-id "e-13078"} :knowledge-point/id #uuid "e880edeb-82ad-5943-a846-dc3246e3e3bd" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050908}] :knowledge-point/questions [{:db/id #edb/ref 17592186110933} {:db/id #edb/ref 17592186111155} {:db/id #edb/ref 17592186488196} {:db/id #edb/ref 17592186488233} {:db/id #edb/ref 17592186497390} {:db/id #edb/ref 17592186551234}] :knowledge-point/title "Cross-Multiplying with Two Binomials"} :step/id #uuid "39ea7244-0ca1-52cc-9e51-81973115c977" :step/math-academy-id 175971 :step/next {:db/id #edb/ref 17592186111529}} {:db/id #edb/ref 17592186111529 :step/content {:db/id #edb/ref 17592186111912 :tutorial/content "Consider the following equation:\n\n$$\n\\dfrac{x+1}{2} = -\\dfrac{x}{3}\n$$\n\nEven though one of the fractions is negative, we can still use cross-multiplication. All we have to do is transfer the negative into the numerator of the fraction, and proceed with cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{x+1}{2} & =-\\frac{x}{3} \\\\ \\frac{x+1}{2} & =\\frac{-x}{3} \\\\ (x+1)\\cdot 3 & =2\\cdot (-x)\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}(x+1)\\cdot 3 & =2\\cdot (-x) \\\\ 3x+3 & =-2x \\\\ 3x+3-3x & =-2x-3x \\\\ 3 & =-5x \\\\ \\frac{3}{-5} & =\\frac{-5x}{-5} \\\\ -\\frac{3}{5} & =x\\end{aligned}\n$$\n\nTherefore, $x = -\\dfrac{3}{5}.$" :tutorial/id #uuid "ed67f4e3-4ff1-5900-bda0-c7f4e2b5a652" :tutorial/math-academy-id 8175 :tutorial/title "Cross-Multiplying with a Negative Sign"} :step/id #uuid "a5826411-42a0-5ce0-aa7f-6e0d021d40fa" :step/math-academy-id 175974 :step/next {:db/id #edb/ref 17592186111530}} {:db/id #edb/ref 17592186111530 :step/content {:db/id #edb/ref 17592186110621 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110322 :question/id #uuid "d97adcd5-65ea-5cf7-905a-db954e43904b" :question/math-academy-id "e-13079"} :knowledge-point/id #uuid "59230000-ef0e-56c0-ab06-17676d817d5a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049939}] :knowledge-point/questions [{:db/id #edb/ref 17592186110934} {:db/id #edb/ref 17592186110935} {:db/id #edb/ref 17592186111121} {:db/id #edb/ref 17592186234052} {:db/id #edb/ref 17592186488255} {:db/id #edb/ref 17592186488257}] :knowledge-point/title "Cross-Multiplying with a Negative Sign"} :step/id #uuid "1f42768c-0adb-5fc8-8dd3-b63229bed312" :step/math-academy-id 175975}] :activity/title "Solving Linear Equations Using Cross-Multiplication" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110809}] [{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186074640} :activity/id #uuid "0a78772c-a19f-53fb-871e-c7eaab046f48" :activity/scope {:db/id #edb/ref 17592186049949 :topic/id #uuid "209a2a6e-0f67-50a5-9c80-5938225e61aa" :topic/math-academy-id 496} :activity/steps [{:db/id #edb/ref 17592186074640 :step/content {:db/id #edb/ref 17592186075060 :tutorial/content "A **triangle** is a geometric shape that consists of three points connected by three line segments, as shown below.\n\n![](images/06/0668279b79482db2fd78116a244bba8e28d3771f88d2e28fb4b6a62387f9d8fd.png)\n\nFor this triangle,\n\n- the line segments $\\overline{AB}$, $\\overline{BC}$ and $\\overline{CA}$ are the **sides** of the triangle,\n\n- the points $\\color{red}A$, $\\color{red}B$ and $\\color{red}C$ are the **vertices** of the triangle,\n\n- the angles $\\angle{A}$, $\\angle{B}$ and $\\angle{C}$ formed by the sides are called the **interior angles** of the triangle.\n\nTo denote a triangle, we use the symbol $\\boldsymbol{\\triangle}$ and list its vertices (in any order). So, the above diagram shows us \n\n$$\n\\triangle ABC.\n$$\n\nIt can be shown that all triangles have the following property:\n\n*The sum of the measures of the interior angles of any triangle is always equal to $180^\\circ.$*\n\nFor example, in $\\triangle ABC$ shown above, the interior angle theorem tells us that\n\n$$\nm\\angle{A} + m\\angle{B} + m\\angle{C} = 180^\\circ .\n$$\n\nTherefore, if we know the measures of two angles in a triangle, we can calculate the value of the other." :tutorial/id #uuid "96cce37a-34b0-5808-afbe-f145cca9fa52" :tutorial/math-academy-id 9135 :tutorial/title "Introduction"} :step/id #uuid "ed98c5d3-adda-5e21-a9b7-9743c1d54f21" :step/math-academy-id 186750 :step/next {:db/id #edb/ref 17592186074641}} {:db/id #edb/ref 17592186074641 :step/content {:db/id #edb/ref 17592186073741 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073507 :question/id #uuid "ed0361cf-cec0-5ec2-baab-e0f558619191" :question/math-academy-id "e-14725"} :knowledge-point/id #uuid "fdb1e0fe-da89-5d80-b9a0-82d4daddc396" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048587} {:db/id #edb/ref 17592186048725}] :knowledge-point/questions [{:db/id #edb/ref 17592186074031} {:db/id #edb/ref 17592186074173} {:db/id #edb/ref 17592186488272}] :knowledge-point/title "Finding a Missing Angle in a Triangle"} :step/id #uuid "81b24cd1-04c0-58c9-91b8-d4977d0d042a" :step/math-academy-id 186751 :step/next {:db/id #edb/ref 17592186074642}} {:db/id #edb/ref 17592186074642 :step/content {:db/id #edb/ref 17592186073742 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073508 :question/id #uuid "bf72c879-105c-5416-8dbd-7976228f0b4b" :question/math-academy-id "e-14727"} :knowledge-point/id #uuid "3eb85b52-cd40-5469-b2f5-ceee2f0bf0cb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673} {:db/id #edb/ref 17592186050452}] :knowledge-point/questions [{:db/id #edb/ref 17592186074033} {:db/id #edb/ref 17592186074174} {:db/id #edb/ref 17592186233233} {:db/id #edb/ref 17592186488197} {:db/id #edb/ref 17592186488235} {:db/id #edb/ref 17592186506567} {:db/id #edb/ref 17592186551329}] :knowledge-point/title "Calculating an Unknown Quantity From a Triangle"} :step/id #uuid "990d21ba-52ac-5cd9-a01b-cb67cfa2bc1d" :step/math-academy-id 186754 :step/next {:db/id #edb/ref 17592186074643}} {:db/id #edb/ref 17592186074643 :step/content {:db/id #edb/ref 17592186073743 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073509 :question/id #uuid "8200fc85-afcc-5fb9-b942-cedbc87c739b" :question/math-academy-id "e-14728"} :knowledge-point/id #uuid "6a4f969d-aebf-53b5-ad47-1376bb98dc6a" :knowledge-point/questions [{:db/id #edb/ref 17592186074083} {:db/id #edb/ref 17592186074188} {:db/id #edb/ref 17592186074364} {:db/id #edb/ref 17592186488183} {:db/id #edb/ref 17592186488216} {:db/id #edb/ref 17592186506575}] :knowledge-point/title "Calculating an Unknown Quantity Given a Description of a Triangle"} :step/id #uuid "f44c88c0-d007-5fb1-91dc-27886bcbfdd5" :step/math-academy-id 186757 :step/next {:db/id #edb/ref 17592186074644}} {:db/id #edb/ref 17592186074644 :step/content {:db/id #edb/ref 17592186073744 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073510 :question/id #uuid "b015f8d6-ac1b-537d-a673-839fc7418f71" :question/math-academy-id "e-15572"} :knowledge-point/id #uuid "8b1f86d8-805c-55c7-8e8c-d96d99e3636b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048213} {:db/id #edb/ref 17592186050164}] :knowledge-point/questions [{:db/id #edb/ref 17592186074032} {:db/id #edb/ref 17592186074493} {:db/id #edb/ref 17592186488248} {:db/id #edb/ref 17592186488252} {:db/id #edb/ref 17592186506598}] :knowledge-point/title "Finding Angles in Triangles With Congruent Angles"} :step/id #uuid "9704d6d3-54b7-59b2-8573-6638158e9c8e" :step/math-academy-id 186761}] :activity/title "Interior Angles of Triangles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073929}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186506629} :activity/id #uuid "70f3ba64-46c6-5c7b-8a26-30ff5c2e8921" :activity/scope {:db/id #edb/ref 17592186049949 :topic/id #uuid "209a2a6e-0f67-50a5-9c80-5938225e61aa" :topic/math-academy-id 496} :activity/steps [{:db/id #edb/ref 17592186506629 :step/content {:db/id #edb/ref 17592186506575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "290c548b-c3c3-5628-aa5a-ac5099056fee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186505982} {:answer/id #uuid "2bc48f0d-cf97-57e5-b754-75ef64300c8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{15}^{∘}" :db/id #edb/ref 17592186505988} {:answer/id #uuid "577eb998-b617-5fd0-ad2f-5345b0832fc8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186506060} {:answer/id #uuid "a896245b-b333-522d-8269-32007289480b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{90}^{∘}" :db/id #edb/ref 17592186506218} {:answer/id #uuid "aff69b7a-deee-5b22-ab6d-06c966782673" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{60}^{∘}" :db/id #edb/ref 17592186506231}] :answer-field/correct {:db/id #edb/ref 17592186505988} :answer-field/id #uuid "c9cd39b4-8f64-5987-b24f-823849f1e540" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186506479}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a9ea04fe-7306-5ab9-aa1b-8506f72bfa0f" :question/math-academy-id "q-52959" :question/problem "Consider a triangle $△ABC,$ where $m∠C={90}^{∘}$, $m∠B=5x$ and $m∠A=x.$  Determine the value of $x.$" :question/worked-solution "The sum of the measures of the interior angles must be ${180}^{∘}.$ Therefore,\n\n$$\n\\begin{aligned}{90}^{∘}+5x+x & ={180}^{∘} \\\\ {90}^{∘}+6x & ={180}^{∘} \\\\ 6x & ={90}^{∘} \\\\ x & ={15}^{∘}.\\end{aligned}\n$$"} :step/id #uuid "62ab666f-6480-566e-aca2-60c89a11dcc4" :step/next {:db/id #edb/ref 17592186506634}} {:db/id #edb/ref 17592186506634 :step/content {:db/id #edb/ref 17592186506567 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82e33c43-c908-5a3f-984d-b2b02dcb3adb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{95}^{∘}" :db/id #edb/ref 17592186506137} {:answer/id #uuid "b6ab8f41-6eaa-57b5-b1f6-d7874a04825c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{106}^{∘}" :db/id #edb/ref 17592186506241} {:answer/id #uuid "be7c7d3d-4561-511b-b47f-dda2a95bacea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{99}^{∘}" :db/id #edb/ref 17592186506255} {:answer/id #uuid "bf6334e8-2413-5414-b886-62651d4edeba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{109}^{∘}" :db/id #edb/ref 17592186506256} {:answer/id #uuid "cd1796c6-7878-5185-b51f-1ab525ee36ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{97}^{∘}" :db/id #edb/ref 17592186506275}] :answer-field/correct {:db/id #edb/ref 17592186506255} :answer-field/id #uuid "acd2ba71-e40b-5b2c-8be7-8057e874f2c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186506458}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8ed94581-861e-525e-ad7d-f6e47b0ded92" :question/math-academy-id "q-67734" :question/problem "![](images/67/671faf1efc8d64c4db563140d6d9bc8e080c1591eef92d44a5d7f381be115c95.png)\n\nFind the measure of angle $B.$" :question/worked-solution "Since the sum of the measures of the interior angles of a triangle is ${180}^{∘}$, we have\n\n$$\n\\begin{aligned}{27}^{∘}+3x+(5x+{9}^{∘}) & ={180}^{∘} \\\\ {36}^{∘}+8x & ={180}^{∘} \\\\ 8x & ={144}^{∘} \\\\ x & ={18}^{∘}\\end{aligned}\n$$\n\nTherefore,\n\n$$\nm∠B=5x+{9}^{∘}=5({18}^{∘})+{9}^{∘}={99}^{∘}.\n$$"} :step/id #uuid "7199ec83-6eb5-50ad-a3dc-decf07fc55b0" :step/next {:db/id #edb/ref 17592186506645}} {:db/id #edb/ref 17592186506645 :step/content {:db/id #edb/ref 17592186506598 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "215914b0-2451-52ec-9701-ffbe8d9894d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{20}^{∘}" :db/id #edb/ref 17592186505966} {:answer/id #uuid "3b1eafad-ed83-5dac-870a-8b0bca34caa8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{15}^{∘}" :db/id #edb/ref 17592186506010} {:answer/id #uuid "8361a8e7-c4ac-5439-98e5-4797a5503bc0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{18}^{∘}" :db/id #edb/ref 17592186506139} {:answer/id #uuid "9dddfcd0-8eb9-5ebd-9a05-f90a810f094b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{25}^{∘}" :db/id #edb/ref 17592186506188} {:answer/id #uuid "9f85dcf7-d001-5073-8ed4-fa98397e59c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{23}^{∘}" :db/id #edb/ref 17592186506197}] :answer-field/correct {:db/id #edb/ref 17592186505966} :answer-field/id #uuid "d3bfce62-88f0-5b8e-beb5-ecf87f7a30ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186506483}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e9dc1df9-d4f7-5877-9eec-28947f9d3962" :question/math-academy-id "q-116727" :question/problem "![](images/69/69245c30b32f12e59a5f57f2e8fb17c7374726ffd6db10726cb508727f66c409.png)\n\nFind the measure of angle $B$ given that $m∠A=m∠C.$" :question/worked-solution "Using $m∠A=m∠C,$ we get\n\n$$\n\\begin{aligned}m∠A & =m∠C \\\\ 3z+{20}^{∘} & =4z \\\\ z & ={20}^{∘}.\\end{aligned}\n$$\n\nConsequently, substituting $z={20}^{∘}$ in the expression for $m∠C,$ we get\n\n$$\nm∠C=4({20}^{∘})={80}^{∘}.\n$$\n\nNow, we can find $m∠B$ using the fact that the internal angles of any triangle sum to ${180}^{∘}$:\n\n$$\n\\begin{aligned}m∠A+m∠B+m∠C & ={180}^{∘} \\\\ m∠B+2m∠C & ={180}^{∘} \\\\ m∠B+2\\cdot {80}^{∘} & ={180}^{∘} \\\\ m∠B+{160}^{∘} & ={180}^{∘} \\\\ m∠B & ={20}^{∘}\\end{aligned}\n$$"} :step/id #uuid "a880f21b-6654-5782-a317-e615d90fad77"}] :activity/title "Interior Angles of Triangles" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186505907}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055780} :activity/id #uuid "a6abcd14-76de-59df-adaa-1dc632470883" :activity/scope {:db/id #edb/ref 17592186049986 :topic/id #uuid "2424a53c-3dea-5c8f-aeb6-365cf563d5f2" :topic/math-academy-id 38} :activity/steps [{:db/id #edb/ref 17592186055780 :step/content {:db/id #edb/ref 17592186056020 :tutorial/content "Let's consider the following inequality:\n\n$$\nx + 4 < 7\n$$\n\nTo **solve** this inequality, we need to isolate the variable $x$ on one side.\n\nInequalities are just like equations because they can be solved using the addition and multiplication principles.\n\nSo, to solve this inequality, we subtract $4$ from both sides:\n\n$$\n\\begin{aligned}x+4 & <7 \\\\ x+4-4 & <7-4 \\\\ x & <3\\end{aligned}\n$$\n\nThe solution is $x < 3.$ This tells us that any value of $x$ smaller than $3$ satisfies the original inequality.\n\nWe can represent the solution to this inequality using a number line as follows:\n\n![](images/55/556401d043fbd285a42b257e3c32f0a858377355674c264b90396e43ca8a8a13.png)\n\nLet's take a look at an inequality that we can solve using the multiplication principle." :tutorial/id #uuid "63426fbc-7f6c-516c-a3e9-9f1262862928" :tutorial/math-academy-id 8099 :tutorial/title "Introduction"} :step/id #uuid "5d1cc5da-4e34-51ae-843a-e59df07e8c64" :step/math-academy-id 52055 :step/next {:db/id #edb/ref 17592186055781}} {:db/id #edb/ref 17592186055781 :step/content {:db/id #edb/ref 17592186054769 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054399 :question/id #uuid "121c55cc-404a-53e7-81f7-6edba34b0796" :question/math-academy-id "e-12956"} :knowledge-point/id #uuid "bf8a6a4f-38ce-5ece-bdcb-6f2b58e2605c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048725} {:db/id #edb/ref 17592186050361} {:db/id #edb/ref 17592186050613}] :knowledge-point/questions [{:db/id #edb/ref 17592186055018} {:db/id #edb/ref 17592186055019} {:db/id #edb/ref 17592186489177} {:db/id #edb/ref 17592186489254}] :knowledge-point/title "Solving a One-Step Inequality"} :step/id #uuid "9e6e8c20-c9b3-5288-8894-994f1e8693a4" :step/math-academy-id 52056 :step/next {:db/id #edb/ref 17592186055782}} {:db/id #edb/ref 17592186055782 :step/content {:db/id #edb/ref 17592186056021 :tutorial/content "We've seen that solving linear inequalities is similar to solving linear equations.\n\nHowever, there is one additional rule that we need to remember when solving inequalities:\n\n*When multiplying or dividing both sides by a **negative number**, we flip the inequality sign.*\n\nWhen we \"flip the inequality sign,\" we switch the direction of the inequality symbol. For example:\n\n- \"$\\color{blue}<$\" becomes \"$\\color{red}>$\" and vice versa\n\n- \"$\\color{blue}\\leq$\" becomes \"$\\color{red}\\geq$\" and vice versa\n\nTo illustrate, consider the following inequality:\n\n$$\n- 3x \\gt 9\n$$\n\nWe can solve this inequality using the multiplication principle. However, when we divide both sides by $-3,$ we have to flip the inequality sign. \n\n$$\n\\begin{aligned}-3x\\,\\, & >\\,\\,9 \\\\ \\frac{-3x}{-3}\\,\\, & <\\,\\,\\frac{9}{-3} \\\\ \\frac{-3x}{-3}\\,\\, & <\\,\\,-3 \\\\ \\frac{\\cancel{-3}x}{\\cancel{-3}}\\,\\, & <\\,\\,-3 \\\\ x\\,\\, & <\\,\\,-3\\end{aligned}\n$$\n\nTherefore, the solution is $x \\lt -3.$\n\nWe'll discuss why we need to flip the inequality sign at the end of the lesson. But for now, let's get some practice at applying this idea." :tutorial/id #uuid "2c47a872-da72-51b3-ac92-ef955acc3f08" :tutorial/math-academy-id 8100 :tutorial/title "Multiplying or Dividing an Inequality by a Negative Number"} :step/id #uuid "cb7661d0-6da1-518d-9228-3db6e6b0cead" :step/math-academy-id 52059 :step/next {:db/id #edb/ref 17592186055783}} {:db/id #edb/ref 17592186055783 :step/content {:db/id #edb/ref 17592186054770 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054400 :question/id #uuid "7424a287-2269-5044-abb7-1004b3826aca" :question/math-academy-id "e-12957"} :knowledge-point/id #uuid "281841fb-287e-597a-abb1-3917212e0dcb" :knowledge-point/questions [{:db/id #edb/ref 17592186055024} {:db/id #edb/ref 17592186055201} {:db/id #edb/ref 17592186489248} {:db/id #edb/ref 17592186489269} {:db/id #edb/ref 17592186489281} {:db/id #edb/ref 17592186489283} {:db/id #edb/ref 17592186507405} {:db/id #edb/ref 17592186507412} {:db/id #edb/ref 17592186536841} {:db/id #edb/ref 17592186549963}] :knowledge-point/title "Solving a One-Step Inequality When Flipping Is Required"} :step/id #uuid "18957d57-5792-5701-b6f4-614dc92db70f" :step/math-academy-id 52060 :step/next {:db/id #edb/ref 17592186055784}} {:db/id #edb/ref 17592186055784 :step/content {:db/id #edb/ref 17592186054771 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054401 :question/id #uuid "82a9a75f-ab0e-54c3-9a0d-82c8497714cb" :question/math-academy-id "e-12958"} :knowledge-point/id #uuid "200fc394-b299-5114-8f39-e6265f3c1166" :knowledge-point/questions [{:db/id #edb/ref 17592186055021} {:db/id #edb/ref 17592186055025} {:db/id #edb/ref 17592186489193} {:db/id #edb/ref 17592186489197} {:db/id #edb/ref 17592186551284}] :knowledge-point/title "Solving a One-Step Inequality With Fractions When Flipping Is Required"} :step/id #uuid "0607f740-0035-5986-a51a-77aa35a3ca25" :step/math-academy-id 52063 :step/next {:db/id #edb/ref 17592186055785}} {:db/id #edb/ref 17592186055785 :step/content {:db/id #edb/ref 17592186054772 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054402 :question/id #uuid "1154ded3-0841-5358-980c-15c0f1841e82" :question/math-academy-id "e-12959"} :knowledge-point/id #uuid "b6b0cad0-354b-5c4c-9fe2-3aceff7e5b6e" :knowledge-point/questions [{:db/id #edb/ref 17592186055020} {:db/id #edb/ref 17592186055022} {:db/id #edb/ref 17592186055023} {:db/id #edb/ref 17592186489185} {:db/id #edb/ref 17592186507499} {:db/id #edb/ref 17592186536866}] :knowledge-point/title "Solving an Inequality and Adjusting the Final Result"} :step/id #uuid "351bf5fa-de4c-5dd3-b946-23f3767c42b1" :step/math-academy-id 52066 :step/next {:db/id #edb/ref 17592186055786}} {:db/id #edb/ref 17592186055786 :step/content {:db/id #edb/ref 17592186056022 :tutorial/content "We'll now learn why we must flip the inequality sign when multiplying or dividing an inequality by a negative number. \n\nTo help us, let's consider the following inequality:\n\n$$\n6 > 0\n$$\n\n \n\nThis is a true statement, and it remains true if we multiply or divide both sides by a positive number. \n\nFor example:\n\n- Multiplying the inequality by $2$ gives $12 > 0,$ which is *true*.$\\quad{\\color{green}{\\checkmark}}$\n\n- Dividing the inequality by $2$ gives $3 > 0,$ which is also *true*. $\\quad{\\color{green}{\\checkmark}}$\n\nHowever, if we multiply or divide both sides by a negative number, *without* flipping the inequality sign, we get a false statement.\n\nFor example:\n\n- Multiplying the inequality by $-2$ *without flipping the inequality sign* gives $-12 > 0,$ which is *false*. $\\quad{\\color{red}{\\times}}$\n\n- Dividing the inequality by $-2$ *without flipping the inequality sign* gives $-3 > 0,$ which is also *false*. $\\quad{\\color{red}{\\times}}$\n\nSo, whenever we multiply or divide by a negative number, we need to flip the sign of the inequality for it to remain true.\n\n- Multiplying the inequality by $-2$ *and flipping the inequality sign* gives $-12 < 0,$ which is *true*. $\\quad{\\color{green}{\\checkmark}}$\n\n- Dividing the inequality by $-2$ *and flipping the sign* gives $-3 < 0,$ which is also *true*. $\\quad{\\color{green}{\\checkmark}}$" :tutorial/id #uuid "f9eacf1c-4f75-5dfe-a8e7-798404a6280d" :tutorial/math-academy-id 8101 :tutorial/title "Why We Flip the Inequality Sign"} :step/id #uuid "e300a5cf-0bdb-5c23-9a03-3bb60a12a788" :step/math-academy-id 52070}] :activity/title "Solving One-Step Linear Inequalities" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054900}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186507531} :activity/id #uuid "f76e562d-eefb-5f49-ba13-fb8a997a1b70" :activity/scope {:db/id #edb/ref 17592186049986 :topic/id #uuid "2424a53c-3dea-5c8f-aeb6-365cf563d5f2" :topic/math-academy-id 38} :activity/steps [{:db/id #edb/ref 17592186507531 :step/content {:db/id #edb/ref 17592186507412 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e3dff68-6795-523f-999b-07af4af3ec70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y<6" :db/id #edb/ref 17592186506706} {:answer/id #uuid "7668d459-4f42-5919-bb7f-fa7eec09053a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y>9" :db/id #edb/ref 17592186506946} {:answer/id #uuid "9074c12a-1d5b-5242-a19c-1b503006d445" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y<9" :db/id #edb/ref 17592186506999} {:answer/id #uuid "acb62ac6-c48e-569b-a36c-c8b94883aa98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y>-9" :db/id #edb/ref 17592186507060} {:answer/id #uuid "e10be7fe-3362-55cd-9dae-30e59a1d1e04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y<-9" :db/id #edb/ref 17592186507168}] :answer-field/correct {:db/id #edb/ref 17592186507168} :answer-field/id #uuid "1301f956-a5f9-5af2-b9fc-78b855c39882" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186507253}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2d8f9e5d-ffea-59b8-9f7c-2f9037766a19" :question/math-academy-id "q-6277" :question/problem "Solve the inequality $-2y>18.$" :question/worked-solution "The variable $y$ is being *multiplied* by $-2.$ To isolate $y,$ we perform the *opposite* operation, which is *dividing* by $-2.$ Remember to perform the same operation on both sides.\n\nAlso, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-2y\\,\\, & >\\,\\,18 \\\\ \\frac{-2y}{-2}\\,\\, & <\\,\\,\\frac{18}{-2} \\\\ \\frac{-2y}{-2}\\,\\, & <\\,\\,-9\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $-2$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}\\frac{-2y}{-2} & <-9 \\\\ \\frac{\\cancel{-2}y}{\\cancel{-2}} & <-9 \\\\ y & <-9\\end{aligned}\n$$\n\nTherefore, the solution is $y<-9.$"} :step/id #uuid "015a9fb1-4671-5e91-a484-e36a765ef7c2" :step/next {:db/id #edb/ref 17592186507562}} {:db/id #edb/ref 17592186507546 :step/content {:db/id #edb/ref 17592186507405 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ddfe654-6c20-5256-8c77-e26f467b5752" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ge" :db/id #edb/ref 17592186506823}] :answer-field/correct {:db/id #edb/ref 17592186506823} :answer-field/id #uuid "844948db-6db2-5198-81c4-adc418e774dd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186507318} {:answer-field/choices [{:answer/id #uuid "6ff7601c-194b-518f-be31-b3982ec9d2d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186506935}] :answer-field/correct {:db/id #edb/ref 17592186506935} :answer-field/id #uuid "cfff5c34-1b4e-574b-b2cd-51c419fcd650" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186507368}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1670dd77-8590-5cdd-be80-9cfcce9e381b" :question/math-academy-id "q-181002" :question/problem "The solution to the inequality $-9a\\le -54$ is $a${{field-1}}{{field-2}}." :question/worked-solution "The variable $a$ is being *multiplied* by $-9.$ To isolate $a,$ we perform the *opposite* operation, which is *dividing* by $-9.$ Remember to perform the same operation on both sides.\n\nAlso, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-9a\\,\\, & \\le \\,\\,-54 \\\\ \\frac{-9a}{-9}\\,\\, & \\ge \\,\\,\\frac{-54}{-9} \\\\ \\frac{-9a}{-9}\\,\\, & \\ge \\,\\,6\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $-9$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}\\frac{-9a}{-9} & \\ge 6 \\\\ \\frac{\\cancel{-9}a}{\\cancel{-9}} & \\ge 6 \\\\ a & \\ge 6\\end{aligned}\n$$\n\nTherefore, the solution is $a\\ge 6.$"} :step/id #uuid "40b41b12-df46-55fe-92ac-57937129a72d"} {:db/id #edb/ref 17592186507562 :step/content {:db/id #edb/ref 17592186507499 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "825a3f94-5d5f-59b8-9d4e-7d0f168885a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z>-24" :db/id #edb/ref 17592186506965} {:answer/id #uuid "9bfb137d-cdc8-5e43-84c6-ea0025793bde" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z<24" :db/id #edb/ref 17592186507016} {:answer/id #uuid "a1a10480-cbf4-58a2-9e6b-17815d58cadd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z<-24" :db/id #edb/ref 17592186507026} {:answer/id #uuid "b207b853-0fed-5188-a900-3bb18b72d272" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z>\\frac{2}{3}" :db/id #edb/ref 17592186507070} {:answer/id #uuid "ef835f55-6239-5e48-941a-ae73fc43925e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z<-\\frac{2}{3}" :db/id #edb/ref 17592186507208}] :answer-field/correct {:db/id #edb/ref 17592186507026} :answer-field/id #uuid "b4490670-0ae0-5d23-9e69-8c96fae8a13a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186507356}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c8a935c4-ddf1-51df-a83c-2659ff68e2ef" :question/math-academy-id "q-154041" :question/problem "Solve the inequality $4<-\\frac{z}{6}.$" :question/worked-solution "The variable $z$ is being *divided* by $6.$ To isolate $z$ and remove the negative sign, we *multiply* by $-6$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}4\\,\\, & <\\,\\,-\\frac{z}{6} \\\\ (-6)\\cdot 4\\,\\, & >\\,\\,(-6)\\cdot (-\\frac{z}{6}) \\\\ -24\\,\\, & >\\,\\,(-6)\\cdot (-\\frac{z}{6})\\end{aligned}\n$$\n\nSince two negative numbers multiply to give a positive number, we first cancel the negatives:\n\n$$\n\\begin{aligned}-24\\,\\, & >(-6)\\cdot (-\\frac{z}{6}) \\\\ -24 & >(\\cancel{-}6)\\cdot (\\cancel{-}\\frac{z}{6}) \\\\ -24 & >6\\cdot \\frac{z}{6}\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $6$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}-24 & >6\\cdot \\frac{z}{6} \\\\ -24 & >\\frac{6z}{6} \\\\ -24 & >\\frac{\\cancel{6}z}{\\cancel{6}} \\\\ -24 & >z\\end{aligned}\n$$\n\nFinally, we rewrite the inequality with the variable on the left-hand side:\n\n$$\nz<-24\n$$\n\nTherefore, the solution is $z<-24.$"} :step/id #uuid "86fe7023-fab7-5333-bca0-7bf71a617112" :step/next {:db/id #edb/ref 17592186507546}}] :activity/title "Solving One-Step Linear Inequalities" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186506677}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186536967} :activity/id #uuid "a0296a38-e916-56a7-bb47-0737bade1abd" :activity/scope {:db/id #edb/ref 17592186049986 :topic/id #uuid "2424a53c-3dea-5c8f-aeb6-365cf563d5f2" :topic/math-academy-id 38} :activity/steps [{:db/id #edb/ref 17592186536962 :step/content {:db/id #edb/ref 17592186055021 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "249f7541-1a8a-52ec-9e0c-a25f296e0698" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge 8" :db/id #edb/ref 17592186536338} {:answer/id #uuid "55632b59-8ff0-5f33-bd84-759756febdc5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge 6" :db/id #edb/ref 17592186536432} {:answer/id #uuid "99888988-7d3e-5baa-ab4a-decbb3967954" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\le 8" :db/id #edb/ref 17592186536529} {:answer/id #uuid "ba590d86-ddb8-598a-a220-46efedf147bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge -8" :db/id #edb/ref 17592186536579} {:answer/id #uuid "e10696b4-01d9-5bd2-8740-a24555a84567" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\le -8" :db/id #edb/ref 17592186536632}] :answer-field/correct {:db/id #edb/ref 17592186536579} :answer-field/id #uuid "512b237b-81e0-5620-86e4-6c38ec6c9bc9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186051656}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "05f33d89-cfbf-5ef4-9277-aa93cd1c185b" :question/math-academy-id "q-153984" :question/problem "Solve the inequality $-\\frac{x}{2}\\le 4.$" :question/worked-solution "The variable $x$ is being *divided* by $2.$ To isolate $x$ and remove the negative sign, we *multiply* by $-2.$ \n\nRemember, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-\\frac{x}{2}\\,\\, & \\le \\,\\,4 \\\\ (-2)\\cdot (-\\frac{x}{2})\\,\\, & \\ge \\,\\,(-2)\\cdot 4 \\\\ (-2)\\cdot (-\\frac{x}{2})\\,\\, & \\ge \\,\\,-8\\end{aligned}\n$$\n\nSince two negative numbers multiply to give a positive number, we first cancel the negatives:\n\n$$\n\\begin{aligned}(-2)\\cdot (-\\frac{x}{2}) & \\ge -8 \\\\ (\\cancel{-}2)\\cdot (\\cancel{-}\\frac{x}{2}) & \\ge -8 \\\\ 2\\cdot \\frac{x}{2} & \\ge -8\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $2$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}2\\cdot \\frac{x}{2} & \\ge -8 \\\\ \\frac{2x}{2} & \\ge -8 \\\\ \\frac{\\cancel{2}x}{\\cancel{2}} & \\ge -8 \\\\ x & \\ge -8\\end{aligned}\n$$\n\nTherefore, the solution is $x\\ge -8.$"} :step/id #uuid "b48eede8-bb40-5e1b-981b-25334c7cacd0"} {:db/id #edb/ref 17592186536965 :step/content {:db/id #edb/ref 17592186536866 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "360ebf0c-440b-5b80-aa5d-f220ea76cfe8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge 3" :db/id #edb/ref 17592186536367} {:answer/id #uuid "60e57476-d7c3-5931-afaa-b90f394b253b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\le -3" :db/id #edb/ref 17592186536450} {:answer/id #uuid "6395e4d6-160c-524d-bea0-39d0f0cb0acb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge 11" :db/id #edb/ref 17592186536454} {:answer/id #uuid "6e12aa20-0d6e-5360-a6c8-7346274c8177" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge -3" :db/id #edb/ref 17592186536468} {:answer/id #uuid "a9e80f2e-a321-5d67-acf6-345376f7ea8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\le 3" :db/id #edb/ref 17592186536554}] :answer-field/correct {:db/id #edb/ref 17592186536468} :answer-field/id #uuid "e410432f-86a4-50ea-8294-40d4d0eeeb2f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536794}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a6005239-b6a4-5801-8173-53f2d74d92ea" :question/math-academy-id "q-153600" :question/problem "Solve the inequality $4\\le x+7.$" :question/worked-solution "To isolate $x,$ we need to perform the *opposite* of *adding* $7,$ which is *subtracting* $7.$ Remember to perform the same operation on both sides.\n\n$$\n\\begin{aligned}4 & \\le x+7 \\\\ 4-7 & \\le x+7-7 \\\\ -3 & \\le x+0 \\\\ -3 & \\le x\\end{aligned}\n$$\n\nFinally, we rewrite the inequality with the variable on the left-hand side:\n\n$$\nx\\ge -3\n$$\n\nTherefore, the solution is $x\\ge -3.$"} :step/id #uuid "c0507717-60f0-50ac-81aa-8044cb88a14c" :step/next {:db/id #edb/ref 17592186536962}} {:db/id #edb/ref 17592186536967 :step/content {:db/id #edb/ref 17592186536841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11e4be9b-77ce-5d2c-870a-9582c9f4eacc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z\\ge \\frac{1}{5}" :db/id #edb/ref 17592186536312} {:answer/id #uuid "729d4612-b4b3-52d6-a984-56bcadb47c63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z\\le -\\frac{1}{5}" :db/id #edb/ref 17592186536474} {:answer/id #uuid "91b033fa-0ab3-5c2d-87b8-9809d0825695" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z\\ge 4" :db/id #edb/ref 17592186536517} {:answer/id #uuid "9bb97e3f-8e17-5d53-9ebf-0d14a1a104c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z\\le \\frac{1}{5}" :db/id #edb/ref 17592186536535} {:answer/id #uuid "b94c625a-806d-5398-a511-8434b5363807" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z\\ge -\\frac{1}{5}" :db/id #edb/ref 17592186536575}] :answer-field/correct {:db/id #edb/ref 17592186536312} :answer-field/id #uuid "b60c1271-2aa2-5db6-a4fc-0ced692f3cad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536775}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "60d9e1c1-b611-5995-967c-6c66ed571c82" :question/math-academy-id "q-149565" :question/problem "Solve the inequality $-5z\\le -1.$" :question/worked-solution "The variable $z$ is being *multiplied* by $-5.$ To isolate $z,$ we perform the *opposite* operation, which is *dividing* by $-5.$ Remember to perform the same operation on both sides.\n\nAlso, when multiplying or dividing an inequality by a negative number, we need to flip the inequality sign:\n\n$$\n\\begin{aligned}-5z\\,\\, & \\le \\,\\,-1 \\\\ \\frac{-5z}{-5}\\,\\, & \\ge \\,\\,\\frac{-1}{-5} \\\\ \\frac{-5z}{-5}\\,\\, & \\ge \\,\\,\\frac{1}{5}\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $-5$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}\\frac{-5z}{-5} & \\ge \\frac{1}{5} \\\\ \\frac{\\cancel{-5}z}{\\cancel{-5}} & \\ge \\frac{1}{5} \\\\ z & \\ge \\frac{1}{5}\\end{aligned}\n$$\n\nTherefore, the solution is $z\\ge \\frac{1}{5}.$"} :step/id #uuid "c4402b05-776a-5423-af2f-f5f1a382df37" :step/next {:db/id #edb/ref 17592186536965}}] :activity/title "Solving One-Step Linear Inequalities" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186536278}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074874} :activity/id #uuid "ec7b59c9-abe8-57a3-a286-1bbf406859b0" :activity/scope {:db/id #edb/ref 17592186050174 :topic/id #uuid "33fcd530-1cfd-5f42-a911-762522fe7130" :topic/math-academy-id 563} :activity/steps [{:db/id #edb/ref 17592186074874 :step/content {:db/id #edb/ref 17592186074967 :tutorial/content "Sometimes, we are given a ratio and want to find an amount. In these cases, it's helpful to use equivalent fractions. \n\nFor example, if the ratio of cows to sheep on Margaret's farm is $11:7$, and she has $22$ cows, how many sheep are there on the farm?\n\nTo solve this, we start with the ratio ${\\color{blue}11}:{\\color{red}7}$ and write it as a fraction:\n\n$$\n\\dfrac{\\color{blue}11}{\\color{red}7}\n$$\n\nIn this fraction, the numerator represents the number of cows and the denominator represents the number of sheep.\n\nSince there are $22$ cows on the farm, we would like a numerator of $22.$ We make this by multiplying the numerator and denominator by $2\\mathbin{:}$\n\n$$\n\\dfrac{{\\color{blue}11}\\times 2}{{\\color{red}7}\\times 2} = \\dfrac{{\\color{blue}22}}{{\\color{red}14}}\n$$\n\nThe denominator is now the number of sheep on the farm if there are $22$ cows. Therefore, on Margaret's farm, there are $\\color{red}14$ sheep." :tutorial/id #uuid "cfd89526-b68e-5436-a4e1-e20aa477ab68" :tutorial/math-academy-id 2050 :tutorial/title "Introduction"} :step/id #uuid "1f40eb50-1f7f-5b78-a04c-ac11239e4005" :step/math-academy-id 7792 :step/next {:db/id #edb/ref 17592186074875}} {:db/id #edb/ref 17592186074875 :step/content {:db/id #edb/ref 17592186073881 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073563 :question/id #uuid "913c1995-fe26-5359-8298-e3b8379e39d8" :question/math-academy-id "e-2277"} :knowledge-point/id #uuid "48f71a07-2bd3-5164-a227-b82d56c0abc7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048508} {:db/id #edb/ref 17592186050481}] :knowledge-point/questions [{:db/id #edb/ref 17592186074389} {:db/id #edb/ref 17592186074411} {:db/id #edb/ref 17592186234155} {:db/id #edb/ref 17592186490296} {:db/id #edb/ref 17592186490299}] :knowledge-point/title "Using a Ratio to Compute a Denominator"} :step/id #uuid "b00d4672-3ee3-5870-9ffd-2a7b3538ab54" :step/math-academy-id 7793 :step/next {:db/id #edb/ref 17592186074876}} {:db/id #edb/ref 17592186074876 :step/content {:db/id #edb/ref 17592186073882 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073564 :question/id #uuid "2eeba279-cd91-55c7-b423-a14edb255ebb" :question/math-academy-id "e-2278"} :knowledge-point/id #uuid "d710628f-14e0-5587-90d1-564a5e0ead19" :knowledge-point/questions [{:db/id #edb/ref 17592186074390} {:db/id #edb/ref 17592186074412} {:db/id #edb/ref 17592186490235} {:db/id #edb/ref 17592186490246} {:db/id #edb/ref 17592186551238}] :knowledge-point/title "Using a Ratio to Compute a Numerator"} :step/id #uuid "5144de57-8e74-52bb-a605-38d854105198" :step/math-academy-id 7794}] :activity/title "Reasoning With Equivalent Ratios" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073981}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186065195} :activity/id #uuid "abc3056c-c606-506b-b00e-5921984cd770" :activity/scope {:db/id #edb/ref 17592186050208 :topic/id #uuid "3668d61c-1873-5fa7-ac2e-a1d14113f40f" :topic/math-academy-id 362} :activity/steps [{:db/id #edb/ref 17592186065195 :step/content {:db/id #edb/ref 17592186065338 :tutorial/content "The **power rule for exponents** states that a power raised to another power is equal to the product of the two powers:\n\n$$\n\\left(a^m\\right)^n = a^{mn}\n$$\n\nFor example,\n\n$$\n\\eqalign{\n\t\t\\left(5^2\\right)^3 &= \\\n\t\t\t\t5^{2 \\cdot 3} &= \\\n\t\t\t\t5^6.\n\t}\n$$\n\nTo see why the power rule for exponents is true, let's take the above example and work it out again, the long way:\n\n$$\n\\eqalign{\n\\left(5^2\\right)^3 &= \\[5pt]\n\t\\underbrace{5^2\\cdot 5^2\\cdot 5^2}_{3\\text{ times}} &= \\[5pt]\n(5 \\cdot 5) \\cdot (5 \\cdot 5) \\cdot (5 \\cdot 5) &= \\[5pt]\n\t\\underbrace{5\\cdot5\\cdot5\\cdot5\\cdot5\\cdot5}_{6\\text{ times}} &= \\[5pt]\n\t5^6\n}\n$$\n\nThe power rule for exponents is just a shortcut for the process above." :tutorial/id #uuid "1a2e18f4-6996-52a0-95eb-77abb10d0e77" :tutorial/math-academy-id 1480 :tutorial/title "Introduction"} :step/id #uuid "d4e0fa30-ed7c-5ef6-9aaa-10d6ba2f9c05" :step/math-academy-id 3529 :step/next {:db/id #edb/ref 17592186065196}} {:db/id #edb/ref 17592186065196 :step/content {:db/id #edb/ref 17592186064301 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063922 :question/id #uuid "a023e3eb-38bb-52ed-ae06-26ccdcd8fbf6" :question/math-academy-id "e-1076"} :knowledge-point/id #uuid "e463f04c-3ec1-5b0b-99a4-c286cf0f2d23" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050697} {:db/id #edb/ref 17592186051009}] :knowledge-point/questions [{:db/id #edb/ref 17592186064680} {:db/id #edb/ref 17592186064917} {:db/id #edb/ref 17592186485550}] :knowledge-point/title "Using the Power Rule with Positive Exponents"} :step/id #uuid "57c38b87-4e15-573a-960c-a61055841b16" :step/math-academy-id 3530 :step/next {:db/id #edb/ref 17592186065197}} {:db/id #edb/ref 17592186065197 :step/content {:db/id #edb/ref 17592186064302 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063923 :question/id #uuid "bc3b926b-dc98-5c74-8fc6-32075763059c" :question/math-academy-id "e-1077"} :knowledge-point/id #uuid "5abe4cbe-7495-5723-88cd-f97796f8ef49" :knowledge-point/questions [{:db/id #edb/ref 17592186064690} {:db/id #edb/ref 17592186064918} {:db/id #edb/ref 17592186485517} {:db/id #edb/ref 17592186485563} {:db/id #edb/ref 17592186544867} {:db/id #edb/ref 17592186544871}] :knowledge-point/title "Using the Power Rule with Negative Exponents"} :step/id #uuid "94008045-7999-599a-b725-36201f5023db" :step/math-academy-id 3532 :step/next {:db/id #edb/ref 17592186065198}} {:db/id #edb/ref 17592186065198 :step/content {:db/id #edb/ref 17592186065339 :tutorial/content "Suppose we want to remove the radical term in an expression like $\\sqrt{x^{3}}.$ To do this, we first convert the radical to a fractional exponent:\n\n$$\n\\sqrt{x^{3}}= \\left(x^{3}\\right)^{1/2}\n$$\n\nThen, we can apply the power rule and multiply the fractional exponents:\n\n$$\n\\begin{aligned}{({x}^{3})}^{1/2} & = \\\\ {x}^{(3)\\cdot (1/2)} & = \\\\ {x}^{3/2}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\sqrt{x^{3}} = x^{3/2},\n$$\n\nand in general,\n\n$$\n\\sqrt[n]{x^m} = x^{m/n}.\n$$" :tutorial/id #uuid "40488864-6672-59b7-9ac6-79903856b484" :tutorial/math-academy-id 1481 :tutorial/title "The Power Rule With Fractional Exponents"} :step/id #uuid "19a0572e-4edb-579e-b72d-fdc1fefe72ca" :step/math-academy-id 3536 :step/next {:db/id #edb/ref 17592186065199}} {:db/id #edb/ref 17592186065199 :step/content {:db/id #edb/ref 17592186064303 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063924 :question/id #uuid "f61d95d1-9761-53c3-bfb3-699bdcf6467a" :question/math-academy-id "e-1079"} :knowledge-point/id #uuid "0b64073e-4aa0-551c-b914-98420b0be338" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050894}] :knowledge-point/questions [{:db/id #edb/ref 17592186064715} {:db/id #edb/ref 17592186064919} {:db/id #edb/ref 17592186485536} {:db/id #edb/ref 17592186485539} {:db/id #edb/ref 17592186544852} {:db/id #edb/ref 17592186551254}] :knowledge-point/title "Using the Power Rule with Fractional Exponents"} :step/id #uuid "d556d6dc-07a0-5db1-b5db-945a6a81b5eb" :step/math-academy-id 3537 :step/next {:db/id #edb/ref 17592186065200}} {:db/id #edb/ref 17592186065200 :step/content {:db/id #edb/ref 17592186064304 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063925 :question/id #uuid "bdb00b27-cb4d-5713-98c1-d4aa2eaa4643" :question/math-academy-id "e-1080"} :knowledge-point/id #uuid "acc85958-ad98-5ce2-912c-e2ba70d025ca" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049729}] :knowledge-point/questions [{:db/id #edb/ref 17592186064750} {:db/id #edb/ref 17592186064920} {:db/id #edb/ref 17592186233088} {:db/id #edb/ref 17592186485504} {:db/id #edb/ref 17592186485511} {:db/id #edb/ref 17592186544805}] :knowledge-point/title "Simplifying Challenging Expressions Using the Power Rule"} :step/id #uuid "7aabc08d-413a-5e15-8a0e-170869a0198c" :step/math-academy-id 3539}] :activity/title "The Power Rule for Exponents With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064449}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186544978} :activity/id #uuid "d4e8d8ea-37ee-5a5f-b346-bb11740b6853" :activity/scope {:db/id #edb/ref 17592186050208 :topic/id #uuid "3668d61c-1873-5fa7-ac2e-a1d14113f40f" :topic/math-academy-id 362} :activity/steps [{:db/id #edb/ref 17592186544965 :step/content {:db/id #edb/ref 17592186544871 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bd28ffb-2444-5b3b-9352-22dee73812b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{q}^{9}" :db/id #edb/ref 17592186544215} {:answer/id #uuid "4ec9da01-88b1-59bd-a764-b87dd8ba36c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{q}^{3}" :db/id #edb/ref 17592186544258} {:answer/id #uuid "56691dcf-1c03-50ed-a797-5ec52a32d0c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{q}^{-6}" :db/id #edb/ref 17592186544277} {:answer/id #uuid "a3c29c00-745a-56cd-a7cb-a7200aaec254" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{q}^{-9}" :db/id #edb/ref 17592186544440} {:answer/id #uuid "edc6ddbf-8437-5dac-b182-00dc00ca17f3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "undefined" :db/id #edb/ref 17592186544601}] :answer-field/correct {:db/id #edb/ref 17592186544215} :answer-field/id #uuid "50a6c686-68dd-5071-9327-897d026326b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544687}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b9bd1889-37e7-5c18-aff9-d79a4155a663" :question/math-academy-id "q-25388" :question/problem "Which of the following is equivalent to ${({p}^{0}{q}^{-3})}^{-3}?$" :question/worked-solution "First, we simplify the expression inside the parenthesis and then we apply the power rule\n\n$$\n\\begin{aligned}{({p}^{0}{q}^{-3})}^{-3} & = \\\\ {(1\\cdot {q}^{-3})}^{-3} & = \\\\ {({q}^{-3})}^{-3} & = \\\\ {q}^{(-3)(-3)} & = \\\\ {q}^{9}\\end{aligned}\n$$"} :step/id #uuid "ba723f55-31ec-5dd6-9dc6-ad73e8e639a6" :step/next {:db/id #edb/ref 17592186544976}} {:db/id #edb/ref 17592186544976 :step/content {:db/id #edb/ref 17592186544805 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "172ae84a-d9ad-5b2c-a66c-13b732c1d880" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186544134} {:answer/id #uuid "1e055b9f-627a-5ebf-9e18-8a5c87b9089b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186544151} {:answer/id #uuid "795691ba-bdae-5475-be56-27a71a0be7cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186544356} {:answer/id #uuid "eba20943-6e93-5443-b335-cbfdcee078e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186544595} {:answer/id #uuid "faf8fbf1-75c8-5c7e-9dff-ca66a5c03643" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186544635}] :answer-field/correct {:db/id #edb/ref 17592186544356} :answer-field/id #uuid "8f0bb462-c95e-50f5-9f00-b9bf46397566" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544718}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3b874545-de9e-5368-9969-5a0f4efc79db" :question/math-academy-id "q-34432" :question/problem "If $\\sqrt[3]{{z}^{-6/5}}={z}^{k},$ then $k=$" :question/worked-solution "First, we express the radical as a fractional power and then we apply the power rule:\n\n$$\n\\begin{aligned}\\sqrt[3]{{z}^{-6/5}} & = \\\\ {({z}^{-6/5})}^{1/3} & = \\\\ {z}^{(-6/5)(1/3)} & = \\\\ {z}^{-2/5}\\end{aligned}\n$$\n\nHence, $k=-\\frac{2}{5}.$"} :step/id #uuid "d14d94aa-acdf-59ab-9018-6c208c90e229"} {:db/id #edb/ref 17592186544978 :step/content {:db/id #edb/ref 17592186544867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c62a19f-ef87-5040-8957-d453f57e8355" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186544252} {:answer/id #uuid "53a706e6-a114-5dcb-968f-bd0f47f11344" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-15" :db/id #edb/ref 17592186544271} {:answer/id #uuid "6c734423-1ce5-5bc2-820b-5582e72ffadb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186544326} {:answer/id #uuid "d5c37a78-c18d-591f-99d3-033cf620f68f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186544541} {:answer/id #uuid "f1f3060e-7fe3-5928-908b-1b159cbd448d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186544611}] :answer-field/correct {:db/id #edb/ref 17592186544271} :answer-field/id #uuid "9999e1f9-b3be-5f04-b3f7-4c9ed6f2d031" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544724}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b2001685-083c-5b23-92d4-dc534c9b8927" :question/math-academy-id "q-2798" :question/problem "If ${({x}^{-3})}^{5}={x}^{k},$ then $k=$" :question/worked-solution "We multiply the exponents, as follows:\n\n$$\n\\begin{aligned}{({x}^{-3})}^{5} & = \\\\ {x}^{(-3)5} & = \\\\ {x}^{-15}\\end{aligned}\n$$\n\nHence, $k=-15.$"} :step/id #uuid "d2528ecc-26c4-5f1d-b559-b7a427afb73d" :step/next {:db/id #edb/ref 17592186544965}}] :activity/title "The Power Rule for Exponents With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186544081}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074751} :activity/id #uuid "17691de4-8d73-56a0-9388-fcd801f22dd1" :activity/scope {:db/id #edb/ref 17592186050341 :topic/id #uuid "4116a9b1-1ae1-5c46-ab2a-fcbda7bb3a26" :topic/math-academy-id 484} :activity/steps [{:db/id #edb/ref 17592186074725 :step/content {:db/id #edb/ref 17592186073788 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073663 :question/id #uuid "e5202e06-b6a8-5d74-a395-fe7c56b8e9bb" :question/math-academy-id "e-9728"} :knowledge-point/id #uuid "1a31c2b6-585a-5715-98f8-4b82605f4c22" :knowledge-point/questions [{:db/id #edb/ref 17592186074003} {:db/id #edb/ref 17592186074004} {:db/id #edb/ref 17592186233430} {:db/id #edb/ref 17592186485534} {:db/id #edb/ref 17592186485537} {:db/id #edb/ref 17592186547071} {:db/id #edb/ref 17592186551336}] :knowledge-point/title "Simplifying Expressions Containing Cube Roots"} :step/id #uuid "74aa14ec-4817-573b-816c-aa9e7cef4458" :step/math-academy-id 36487} {:db/id #edb/ref 17592186074726 :step/content {:db/id #edb/ref 17592186073789 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073664 :question/id #uuid "c1f1d037-45a6-5e72-a735-0c0512290120" :question/math-academy-id "e-9729"} :knowledge-point/id #uuid "622cd109-3764-5f32-8205-046be4b57c54" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049923}] :knowledge-point/questions [{:db/id #edb/ref 17592186074001} {:db/id #edb/ref 17592186074002} {:db/id #edb/ref 17592186485544} {:db/id #edb/ref 17592186485566}] :knowledge-point/title "Simplifying Square Root Expressions Using the Product Rule for Radicals"} :step/id #uuid "b782d57f-6faa-597a-9408-0b6fc960adfb" :step/math-academy-id 36491 :step/next {:db/id #edb/ref 17592186074728}} {:db/id #edb/ref 17592186074727 :step/content {:db/id #edb/ref 17592186075012 :tutorial/content "Recall that the product rule for radicals states that\n\n$$\n\\sqrt{a\\cdot b} = \\sqrt{a}\\cdot \\sqrt{b}\n$$\n\nwhere $a$ and $b$ are nonnegative numbers. \n\nWe can use the product rule for radicals to simplify some expressions. Let's see an example." :tutorial/id #uuid "4af2af2e-0f81-5094-adf6-2ede72a493d2" :tutorial/math-academy-id 5995 :tutorial/title "The Product Rule for Radicals"} :step/id #uuid "d050b8f3-0cc1-593c-8200-076f5b4f824f" :step/math-academy-id 36619 :step/next {:db/id #edb/ref 17592186074726}} {:db/id #edb/ref 17592186074728 :step/content {:db/id #edb/ref 17592186075013 :tutorial/content "We can simplify cube root expressions in the same way as with square roots.\n\nFor example, consider the following expression:\n\n$$\n4\\sqrt[3]2 - 6\\sqrt[3] 2\n$$\n\nWe can simplify our expression by combining the two radicals, as follows:\n\n$$\n\\begin{aligned}4\\sqrt[3]{2}-6\\sqrt[3]{2} & = \\\\ (4-6)\\sqrt[3]{2} & = \\\\ -2\\sqrt[3]{2} & \\end{aligned}\n$$\n\n \n\nAs with square roots, we *cannot* combine terms when the numbers under the radical are different. For example, the expression\n\n$$\n3\\sqrt[3] 2 + \\sqrt[3] 5\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt[3] 2$ and $\\sqrt[3] 5.$\n\nFinally, it is not possible to combine square root and cube root terms -- not even if the numbers under the radical symbol are the same! For example, the expression\n\n$$\n4\\sqrt 2 + \\sqrt[3] 2\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt 2$ and $\\sqrt[3] 2.$" :tutorial/id #uuid "32078f96-6eaf-57d2-bc71-8af8495d5d6f" :tutorial/math-academy-id 5996 :tutorial/title "Simplifying Expressions With Cube Roots"} :step/id #uuid "f9fded71-c2d5-5d66-9f13-5b0253efd6ff" :step/math-academy-id 36620 :step/next {:db/id #edb/ref 17592186074725}} {:db/id #edb/ref 17592186074751 :step/content {:db/id #edb/ref 17592186074948 :tutorial/content "When dealing with sums of square roots, we can combine any terms with the same number under the square root symbol $\\sqrt{\\phantom 0}.$\n\nFor example, consider the following expression:\n\n$$\n2\\sqrt 5 + 4\\sqrt 5\n$$\n\nRemember that $2\\sqrt 5$ and $4\\sqrt 5$ mean $2\\cdot\\sqrt 5$ and $4\\cdot\\sqrt 5,$ respectively. \n\nWe can simplify our expression by combining the two radicals, as follows:\n\n$$\n\\begin{aligned}2\\sqrt{5}+4\\sqrt{5} & = \\\\ (2+4)\\sqrt{5} & = \\\\ 6\\sqrt{5} & \\end{aligned}\n$$\n\n \n\nSimilarly,\n\n$$\n\\begin{aligned}2\\sqrt{7}-\\sqrt{7} & = \\\\ 2\\sqrt{7}-1\\cdot \\sqrt{7} & = \\\\ (2-1)\\sqrt{7} & = \\\\ 1\\cdot \\sqrt{7} & = \\\\ \\sqrt{7}. & \\end{aligned}\n$$\n\n \n\nHowever, we *cannot* combine terms when the numbers under the radical are different. For example, the expression\n\n$$\n2\\sqrt 3 + \\sqrt 5\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt 3$ and $\\sqrt 5.$" :tutorial/id #uuid "9aa49408-30d5-57b5-8dff-ec1744f9fc6e" :tutorial/math-academy-id 1609 :tutorial/title "Introduction"} :step/id #uuid "38f3ace0-f394-598e-8dad-37fefda9d86e" :step/math-academy-id 4327 :step/next {:db/id #edb/ref 17592186074752}} {:db/id #edb/ref 17592186074752 :step/content {:db/id #edb/ref 17592186073806 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073464 :question/id #uuid "cf793c45-6c89-50c8-bb28-d066d2b8342a" :question/math-academy-id "e-1370"} :knowledge-point/id #uuid "2d8a8280-5248-57e4-a5ed-14e281f3db77" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050404}] :knowledge-point/questions [{:db/id #edb/ref 17592186074147} {:db/id #edb/ref 17592186074186} {:db/id #edb/ref 17592186485495} {:db/id #edb/ref 17592186485554}] :knowledge-point/title "Simplifying Square Root Expressions"} :step/id #uuid "459089fc-d278-5487-bc0b-e4cd6237c142" :step/math-academy-id 4328 :step/next {:db/id #edb/ref 17592186074727}}] :activity/title "Adding and Subtracting Radicals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073921}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055621} :activity/id #uuid "4fd2aaf3-6b86-52c0-bd25-cdccd740e574" :activity/scope {:db/id #edb/ref 17592186050763 :topic/id #uuid "64c4dbd5-509e-506d-ad70-5a35f835770e" :topic/math-academy-id 97} :activity/steps [{:db/id #edb/ref 17592186055621 :step/content {:db/id #edb/ref 17592186056014 :tutorial/content "Suppose that we wish to find the equation of the **horizontal line** that passes through the point $(0,3)$, as shown below:\n\n![](images/37/379af2ba930fa537f1fbdda5b4b5cc91e355a46e90918cdc56bbce66f3502d7b.png)\n\nNotice that for *any* $x$-value on the line, the $y$-value is always $\\color{red}3.$ \n\n![](images/ff/ff5ec246a558fc981ba5f0b0085ce3663ac6ab837121f31a5d44de6adb91cb90.png)\n\nTherefore, the equation of the line is $y=3.$\n\n**Note**: When writing the equation of a horizontal line, we always put the variable $y$ on the left side and the constant on the right side." :tutorial/id #uuid "8d036bf9-1cb2-59e4-a418-b586ec35d56e" :tutorial/math-academy-id 8070 :tutorial/title "Introduction"} :step/id #uuid "4925b445-d5c7-5a6b-a5f1-da050fb02303" :step/math-academy-id 191798 :step/next {:db/id #edb/ref 17592186055622}} {:db/id #edb/ref 17592186055622 :step/content {:db/id #edb/ref 17592186054666 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054390 :question/id #uuid "ff34ddfb-7ea8-505a-8a4f-7898d7f5c3c0" :question/math-academy-id "e-12902"} :knowledge-point/id #uuid "b57ffad1-b83f-5ebb-b0fe-928566ffe8b6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050517} {:db/id #edb/ref 17592186050790}] :knowledge-point/questions [{:db/id #edb/ref 17592186055063} {:db/id #edb/ref 17592186055423} {:db/id #edb/ref 17592186490260} {:db/id #edb/ref 17592186490295} {:db/id #edb/ref 17592186490307}] :knowledge-point/title "Finding the Equation of a Horizontal Line"} :step/id #uuid "2922d040-74f4-5896-83b7-35b38603c224" :step/math-academy-id 191799 :step/next {:db/id #edb/ref 17592186055623}} {:db/id #edb/ref 17592186055623 :step/content {:db/id #edb/ref 17592186056015 :tutorial/content "Suppose that we want to find the equation of the **vertical line** that passes through the point $(-4,0)$, as shown below:\n\n![](images/06/065dfc149c1624bbe2c6fd51085c48b5e60c1d37d248d073dd1374d08e65b5af.png)\n\nNotice that for *any* $y$-value on the line, the $x$-value is always $\\color{red}-4.$ \n\n![](images/01/01d24274cc3d2b5a7899cc1aa8cee4aef4fb02ddb45acd27629a57d6af41a398.png)\n\nTherefore, the equation of this vertical line is $x=-4.$\n\n**Note**: When writing the equation of a vertical line, we always put the variable $x$ on the left side and the constant on the right side." :tutorial/id #uuid "fcdbdf94-22ce-5781-9f56-42dc93763172" :tutorial/math-academy-id 8071 :tutorial/title "Vertical Lines"} :step/id #uuid "3e8762cd-7d9e-50f2-bb1b-c07fd53a30c1" :step/math-academy-id 191802 :step/next {:db/id #edb/ref 17592186055624}} {:db/id #edb/ref 17592186055624 :step/content {:db/id #edb/ref 17592186054667 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054491 :question/id #uuid "fa11d81b-2154-584a-9fd0-ce4399fd3a93" :question/math-academy-id "e-15644"} :knowledge-point/id #uuid "1f626489-1967-542a-8782-35596cffc7a4" :knowledge-point/questions [{:db/id #edb/ref 17592186055045} {:db/id #edb/ref 17592186055424} {:db/id #edb/ref 17592186490306} {:db/id #edb/ref 17592186490308}] :knowledge-point/title "Finding the Equation of a Vertical Line"} :step/id #uuid "95b8d112-1200-5651-b046-ddd819995d89" :step/math-academy-id 191803 :step/next {:db/id #edb/ref 17592186055625}} {:db/id #edb/ref 17592186055625 :step/content {:db/id #edb/ref 17592186054668 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054391 :question/id #uuid "1af37b2d-2400-5e55-b7b6-6d9652204f4c" :question/math-academy-id "e-12903"} :knowledge-point/id #uuid "9b84d144-1a2b-5007-817e-20a5d6446515" :knowledge-point/questions [{:db/id #edb/ref 17592186055129} {:db/id #edb/ref 17592186055428} {:db/id #edb/ref 17592186490250} {:db/id #edb/ref 17592186490253} {:db/id #edb/ref 17592186551249}] :knowledge-point/title "Identifying a Horizontal or Vertical Line"} :step/id #uuid "f599f285-d643-5707-ac7a-89a8993f9002" :step/math-academy-id 191806 :step/next {:db/id #edb/ref 17592186055626}} {:db/id #edb/ref 17592186055626 :step/content {:db/id #edb/ref 17592186054669 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054392 :question/id #uuid "03ebd3ab-aa4d-5bf4-9079-62cde6da307d" :question/math-academy-id "e-12904"} :knowledge-point/id #uuid "bf635847-145c-5da5-927e-8196e809324e" :knowledge-point/questions [{:db/id #edb/ref 17592186055054} {:db/id #edb/ref 17592186055068} {:db/id #edb/ref 17592186055292} {:db/id #edb/ref 17592186235488} {:db/id #edb/ref 17592186490251} {:db/id #edb/ref 17592186490265} {:db/id #edb/ref 17592186523961} {:db/id #edb/ref 17592186551354}] :knowledge-point/title "Points Associated With Horizontal and Vertical Lines"} :step/id #uuid "30da6f5a-53a7-5a1c-9b14-200b76e84b56" :step/math-academy-id 191809}] :activity/title "Horizontal and Vertical Lines" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054937}] [{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186489345} :activity/id #uuid "f5d315b3-1937-5219-9b02-93324c4b74bb" :activity/scope {:db/id #edb/ref 17592186408188 :topic/id #uuid "24a28f9b-1f4f-5349-9353-6e0a556259c4" :topic/math-academy-id 7011} :activity/steps [{:db/id #edb/ref 17592186489298 :step/content {:db/id #edb/ref 17592186489387 :tutorial/content "It's convenient to use the following special **bar-notation** to indicate decimals that repeat indefinitely:\n\n$$\n0.\\overline{3} = 0.333\\,333\\ldots\n$$\n\nSome decimals have two or more digits that repeat indefinitely. For example:\n\n$$\n\\begin{aligned}0.\\overset{―}{78} & =0.78\\,78\\,78\\,78… \\\\ 0.\\overset{―}{675} & =0.675\\,675\\,675…\\end{aligned}\n$$\n\nSome repeating decimals have non-repeating digits before the repeating part. For example:\n\n$$\n0.45\\overline{67} = 0.45\\,67\\,67\\,67\\,67\\ldots\n$$" :tutorial/id #uuid "8545445f-23ee-5309-8571-5a1f6a4b253d" :tutorial/math-academy-id 15180 :tutorial/title "Notations for Repeating Decimals"} :step/id #uuid "07766a04-75bc-582b-a3f7-a4d9e94b4bfa" :step/math-academy-id 653256 :step/next {:db/id #edb/ref 17592186489373}} {:db/id #edb/ref 17592186489328 :step/content {:db/id #edb/ref 17592186489169 :knowledge-point/canonical-example {:db/id #edb/ref 17592186489196 :question/id #uuid "2953724f-e9c5-5a58-a253-c1d894297cc0" :question/math-academy-id "e-22734"} :knowledge-point/id #uuid "2ee93f86-38d1-591a-b694-a4f455240d75" :knowledge-point/questions [{:db/id #edb/ref 17592186489200} {:db/id #edb/ref 17592186489282} {:db/id #edb/ref 17592186551315}] :knowledge-point/title "Expressing a Rational Number as a Repeating Decimal Using Long Division"} :step/id #uuid "722917c0-0a2f-564d-92a1-3b8f90e0a367" :step/math-academy-id 653258 :step/next {:db/id #edb/ref 17592186489335}} {:db/id #edb/ref 17592186489335 :step/content {:db/id #edb/ref 17592186489170 :knowledge-point/canonical-example {:db/id #edb/ref 17592186489245 :question/id #uuid "975545b6-bff4-5fab-aaf4-e8ee01507788" :question/math-academy-id "e-22727"} :knowledge-point/id #uuid "4c28dcab-dd12-58c2-88c6-0301dc0f9ce4" :knowledge-point/questions [{:db/id #edb/ref 17592186152676} {:db/id #edb/ref 17592186489222}] :knowledge-point/title "Identifying Rational Decimals"} :step/id #uuid "84e16e8f-676c-575f-83e7-d1a743860017" :step/math-academy-id 653261} {:db/id #edb/ref 17592186489343 :step/content {:db/id #edb/ref 17592186489388 :tutorial/content "Let's consider the following rational number:\n\n$$\n\\dfrac13\n$$\n\nTo find its decimal representation, we divide $1$ by $3$ using long division, as follows:\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" width=\"150\">\n<table align=\"left\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"left\" height=\"20\" width=\"20\"></td>\n<td align=\"left\" colspan=\"4\" height=\"20\" width=\"15\">$\\,\\,0 \\,. 3 {\\:\\phantom{|}} 3 {\\:\\phantom{|}} 3$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\:\\ldots$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\">$3$</td>\n<td align=\"left\" colspan=\"4\" height=\"20\" width=\"15\">$\\!\\require{enclose}\\enclose{longdiv}{1 {\\, . \\,} 0  {\\:\\phantom{|}} 0 {\\:\\phantom{|}} 0}$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\!\\!\\!\\!\\!\\!\\!$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$9$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\!\\!\\!\\!\\!$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$9$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\!\\!\\!\\!\\!$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$9$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\,\\ldots$</td>\n</tr>\n</tbody></table>\n<p></p></td>\n</tr>\n</tbody></table>\n\nNotice that, in this case,\n\n- the long division process never ends, and\n\n- the digit $3$ after the decimal point repeats *forever*.\n\nTherefore,\n\n$$\n\\dfrac13 = 0.333\\,333\\ldots\n$$\n\nThis is an example of a **repeating decimal** - a decimal in which the digits after the decimal point continue forever in a *repeating pattern*." :tutorial/id #uuid "b877953a-1821-5fae-aebf-3ff936971679" :tutorial/math-academy-id 15177 :tutorial/title "Repeating Decimals"} :step/id #uuid "989620d9-34b2-5998-bf43-7b078a5551e7" :step/math-academy-id 653255 :step/next {:db/id #edb/ref 17592186489298}} {:db/id #edb/ref 17592186489345 :step/content {:db/id #edb/ref 17592186489385 :tutorial/content "A rational number can have a decimal representation that either *ends* or *repeats*.\n\nIn this lesson, we will see how to convert rational numbers written as fractions into decimals using *long division*. \nWe begin with examples where the decimal terminates. \n\nLet's convert $\\dfrac{7}{2}$ into a decimal using long division.\n\nTo write the fraction as a decimal, we divide the numerator by the denominator:\n\n$$\n7 \\div 2\n$$\n\nWe proceed using long division as usual, stopping once we obtain a remainder of $0\\mathbin{:}$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" width=\"150\">\n<table align=\"left\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"left\" height=\"20\" width=\"20\"></td>\n<td align=\"left\" colspan=\"2\" height=\"20\" width=\"15\">$\\,\\,3    {\\, . \\,} 5$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\">$2$</td>\n<td align=\"left\" colspan=\"2\" height=\"20\" width=\"15\">$\\!\\require{enclose}\\enclose{longdiv}{7   {\\, . \\,} 0}$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\!\\!\\!\\!\\!\\!\\!$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$6$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\!\\!\\!\\!\\!\\!\\!$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n</tr>\n</tbody></table>\n<p></p></td>\n</tr>\n</tbody></table>\n\nTherefore,\n\n$$\n\\dfrac{7}{2} = 3.5.\n$$" :tutorial/id #uuid "6c539020-aca7-5b8f-a2b0-b72c56336242" :tutorial/math-academy-id 15179 :tutorial/title "Introduction"} :step/id #uuid "9d911030-9a41-5eba-8339-d738949a2899" :step/math-academy-id 653251 :step/next {:db/id #edb/ref 17592186489372}} {:db/id #edb/ref 17592186489372 :step/content {:db/id #edb/ref 17592186489171 :knowledge-point/canonical-example {:db/id #edb/ref 17592186489180 :question/id #uuid "11a8381c-60e6-54f2-ac78-bece2edc403e" :question/math-academy-id "e-22733"} :knowledge-point/id #uuid "9f161693-0317-5b9e-9156-c781f703a4c0" :knowledge-point/questions [{:db/id #edb/ref 17592186489205} {:db/id #edb/ref 17592186489207} {:db/id #edb/ref 17592186489227} {:db/id #edb/ref 17592186489286}] :knowledge-point/title "Expressing a Rational Number as a Finite Decimal Using Long Division"} :step/id #uuid "dd795099-acd6-53fe-9be5-05e82111a5a2" :step/math-academy-id 653252 :step/next {:db/id #edb/ref 17592186489343}} {:db/id #edb/ref 17592186489373 :step/content {:db/id #edb/ref 17592186489386 :tutorial/content "The key takeaway for this lesson is that every repeating decimal is rational! In other words, every repeating decimal can be expressed as a ratio of two integers.\n\nFor example:\n\n$$\n\\begin{aligned}0.\\overset{―}{3} & =\\frac{1}{3} \\\\ 0.\\overset{―}{78} & =\\frac{26}{33} \\\\ 0.333\\overset{―}{67} & =\\frac{16517}{49500}\\end{aligned}\n$$\n\nIn a future lesson, we'll learn how to express a repeating decimal as a fraction. For now, you can verify these results using a calculator." :tutorial/id #uuid "77b1162b-17a9-5251-8efe-31b7034274d5" :tutorial/math-academy-id 15181 :tutorial/title "Any Repeating Decimal is a Rational"} :step/id #uuid "e016072c-e22d-536a-a6ed-5eef7793da16" :step/math-academy-id 653257 :step/next {:db/id #edb/ref 17592186489328}}] :activity/title "Rational Numbers as Finite or Repeating Decimals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186488466}]}
