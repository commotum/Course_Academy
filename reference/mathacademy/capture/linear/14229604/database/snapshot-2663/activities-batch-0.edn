t {:db/id #edb/ref 17592186064339 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064006 :question/id #uuid "c4a15443-e2a4-5bda-ab14-8fb427ec6ca4" :question/math-academy-id "e-1784"} :knowledge-point/id #uuid "8aa1c2ce-6229-5af9-b9b3-870a7e661143" :knowledge-point/questions [{:db/id #edb/ref 17592186064692} {:db/id #edb/ref 17592186064694}] :knowledge-point/title "Factoring a Difference of Squares Containing More Than One Variable"} :step/id #uuid "fb8aebaa-3368-514b-bf57-1953890130b9" :step/math-academy-id 6061}] :activity/title "Factoring Differences of Squares" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064456}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186485603} :activity/id #uuid "85c2e892-b9bc-5813-82ef-08b9292dfe81" :activity/scope {:db/id #edb/ref 17592186048928 :topic/id #uuid "ccd0b2ba-3714-5783-a6c4-70021ded19c3" :topic/math-academy-id 370} :activity/steps [{:db/id #edb/ref 17592186485603 :step/content {:db/id #edb/ref 17592186064686 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24bb8047-0ff3-5b85-aee9-2e6ac88d6e1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2a-3)(2a-3)" :db/id #edb/ref 17592186484885} {:answer/id #uuid "28b71172-7a45-5d09-98d1-64ccf6b8bfda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4a-9)(4a-9)" :db/id #edb/ref 17592186484892} {:answer/id #uuid "51172389-9c15-5caa-bf7e-b95637b65d2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4a-9)(4a+9)" :db/id #edb/ref 17592186484992} {:answer/id #uuid "73e7769f-fc92-5de8-8c10-550b71e31703" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2a-3)(2a+3)" :db/id #edb/ref 17592186485066} {:answer/id #uuid "9035e54c-8039-5816-9bcf-cf8e910bf09e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4a+9)(4a+9)" :db/id #edb/ref 17592186485131}] :answer-field/correct {:db/id #edb/ref 17592186484992} :answer-field/id #uuid "ed8d0e1b-a803-5935-b215-5114cd1136b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186062173}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0f566ff8-5109-5c5a-864e-7810af0e53ff" :question/math-academy-id "q-2761" :question/problem "Factor the expression $16{a}^{2}-81.$" :question/worked-solution "First, we write the expression as a difference of squares:\n\n$$\n\\begin{aligned}16{a}^{2}-81 & =(4a)^{2}-{9}^{2}\\end{aligned}\n$$\n\nThen, we factor the expression using the difference of squares formula:\n\n$$\n\\begin{aligned}(4a)^{2}-{9}^{2} & =(4a+9)(4a-9)\\end{aligned}\n$$"} :step/id #uuid "13e0558d-c68a-56fe-97cc-a967ca46bd21" :step/next {:db/id #edb/ref 17592186485625}} {:db/id #edb/ref 17592186485607 :step/content {:db/id #edb/ref 17592186485546 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "206acbc9-87db-578e-b3b2-16b30eb642bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9-x)(9+x)" :db/id #edb/ref 17592186484877} {:answer/id #uuid "39335b45-13f8-58f6-bd9b-9a97b1c75cc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9-x)^{2}" :db/id #edb/ref 17592186484937} {:answer/id #uuid "64dfcde6-8a80-5dd4-b6fd-951b6b011f44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9+x)^{2}" :db/id #edb/ref 17592186485036} {:answer/id #uuid "6faf371b-64f9-55f0-8fd0-2ade74e5df26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x-9)(x+9)" :db/id #edb/ref 17592186485056} {:answer/id #uuid "8e7eccde-081c-5f5d-be03-c306f58839d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(18-x)(18+x)" :db/id #edb/ref 17592186485125}] :answer-field/correct {:db/id #edb/ref 17592186484877} :answer-field/id #uuid "8cab9527-ddd1-529a-ae51-224da9fcc4cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186485423}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7a010f5a-cc94-5c4d-81d2-4c21165ae9ab" :question/math-academy-id "q-44102" :question/problem "$81-{x}^{2}=$" :question/worked-solution "First, we write the expression as a difference of squares:\n\n$$\n81-{x}^{2}={9}^{2}-{x}^{2}\n$$\n\nThen, we factor the expression using the difference of squares formula:\n\n$$\n{9}^{2}-{x}^{2}=(9-x)(9+x)\n$$"} :step/id #uuid "2738148b-cedf-57d8-ae04-d09d72e66898"} {:db/id #edb/ref 17592186485625 :step/content {:db/id #edb/ref 17592186064692 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58d24321-d687-5666-b444-c67333ddf888" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2e-4f)(2e+4f)" :db/id #edb/ref 17592186485017} {:answer/id #uuid "883f814c-6c18-5941-967b-2ebea351df17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2e-4f)(2e-4f)" :db/id #edb/ref 17592186485113} {:answer/id #uuid "a2d7f83e-938d-58ce-b03e-2aa0fbe0f394" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(e-2f)(e+2f)" :db/id #edb/ref 17592186485171} {:answer/id #uuid "b13e591a-bf5d-5ccb-bebd-477bcfb2fa24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2e+4f)(2e+4f)" :db/id #edb/ref 17592186485202} {:answer/id #uuid "fdc225a0-8ce8-5951-977f-0f5267f0a478" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(e-2f)(e-2f)" :db/id #edb/ref 17592186485360}] :answer-field/correct {:db/id #edb/ref 17592186485017} :answer-field/id #uuid "2bdfff3f-3f1d-5467-b903-2b86371c55b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186062209}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0ca5943c-81c0-5244-b701-34175b2232ae" :question/math-academy-id "q-2833" :question/problem "Express $4{e}^{2}-16{f}^{2}$ as a product of two binomials." :question/worked-solution "We factor the expression using the difference of squares formula:\n\n$$\n\\begin{aligned}4{e}^{2}-16{f}^{2} & = \\\\ (2e)^{2}-(4f)^{2} & = \\\\ (2e-4f)(2e+4f) & \\end{aligned}\n$$"} :step/id #uuid "8a3fd681-fb58-5e69-96b1-2127582ffe4f" :step/next {:db/id #edb/ref 17592186485607}}] :activity/title "Factoring Differences of Squares" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186484810}] [{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186069730} :activity/id #uuid "74c085db-a02d-55d0-a9c6-2ff188739b10" :activity/scope {:db/id #edb/ref 17592186049181 :topic/id #uuid "e176f8f6-a3bc-5ea6-89d2-2202d9d89fd7" :topic/math-academy-id 423} :activity/steps [{:db/id #edb/ref 17592186069730 :step/content {:db/id #edb/ref 17592186069927 :tutorial/content "To simplify a rational expression, we cancel out the largest common factor from the numerator and denominator. To do this, we sometimes need to factor the numerator and denominator before canceling.\n\nFor example, suppose that we wish to simplify $\\dfrac {4x - 12} {10x + 4}.$ To do this, we factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\eqalign{\n\t\t\\dfrac {4x - 12} {10x + 4}\n\t\t&=\\dfrac {4(x - 3)} {2(5x + 2)}\\[5pt]\n&=\\dfrac {2 \\cdot 2 \\cdot (x - 3)} {2(5x + 2)}\\[5pt]\t\t\n\t\t&=\\dfrac {\\cancel{2} \\cdot 2(x - 3)} {\\cancel{2}(5x + 2)}\\[5pt]\t\n\t\t&=\\dfrac {2(x - 3)} {5x + 2}\n\t}\n$$" :tutorial/id #uuid "332f534f-811e-5c03-8393-560134dd4ea8" :tutorial/math-academy-id 1370 :tutorial/title "Introduction"} :step/id #uuid "818bd86a-fb35-5a26-8a36-9ee10c0aa1c5" :step/math-academy-id 2850 :step/next {:db/id #edb/ref 17592186069869}} {:db/id #edb/ref 17592186069731 :step/content {:db/id #edb/ref 17592186068805 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068653 :question/id #uuid "3df1f00a-3a87-5db7-83c5-d47dce633bf9" :question/math-academy-id "e-843"} :knowledge-point/id #uuid "6a17d9d6-cd3a-554e-98d2-7e9536950bd0" :knowledge-point/questions [{:db/id #edb/ref 17592186069273} {:d