MAIN-28\" x=\"8530\" y=\"0\"></use>\n<g transform=\"translate(8919,0)\">\n <use xlink:href=\"#E6-MJMAIN-6D\"></use>\n <use xlink:href=\"#E6-MJMAIN-6F\" x=\"833\" y=\"0\"></use>\n <use xlink:href=\"#E6-MJMAIN-64\" x=\"1334\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E6-MJMATHI-6E\" x=\"10976\" y=\"0\"></use>\n <use xlink:href=\"#E6-MJMAIN-29\" x=\"11577\" y=\"0\"></use>\n <use xlink:href=\"#E6-MJMAIN-2E\" x=\"11966\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n<p>Therefore, we conclude that\n<span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"40.458ex\" height=\"2.843ex\" style=\"vertical-align: -0.838ex;\" viewBox=\"0 -863.1 17419.4 1223.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-7-Title\">\n<title id=\"MathJax-SVG-7-Title\">\na \\equiv b \\: (\\textrm{mod}\\,n)  \\quad \\Longrightarrow\\quad ka \\equiv kb \\:(\\textrm{mod}\\,n).\n</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E7-MJMATHI-61\" d=\"M33 157Q33 258 109 349T280 441Q331 441 370 392Q386 422 416 422Q429 422 439 414T449 394Q449 381 412 234T374 68Q374 43 381 35T402 26Q411 27 422 35Q443 55 463 131Q469 151 473 152Q475 153 483 153H487Q506 153 506 144Q506 138 501 117T481 63T449 13Q436 0 417 -8Q409 -10 393 -10Q359 -10 336 5T306 36L300 51Q299 52 296 50Q294 48 292 46Q233 -10 172 -10Q117 -10 75 30T33 157ZM351 328Q351 334 346 350T323 385T277 405Q242 405 210 374T160 293Q131 214 119 129Q119 126 119 118T118 106Q118 61 136 44T179 26Q217 26 254 59T298 110Q300 114 325 217T351 328Z\"></path>\n<path stroke-width=\"1\" id=\"E7-MJMAIN-2261\" d=\"M56 444Q56 457 70 464H707Q722 456 722 444Q722 430 706 424H72Q56 429 56 444ZM56 237T56 250T70 270H707Q722 262 722 250T707 230H70Q56 237 56 250ZM56 56Q56 71 72 76H706Q722 70 722 56Q722 44 707 36H70Q56 43 56 56Z\"></path>\n<path stroke-width=\"1\" id=\"E7-MJMATHI-62\" d=\"M73 647Q73 657 77 670T89 683Q90 683 161 688T234 694Q246 694 246 685T212 542Q204 