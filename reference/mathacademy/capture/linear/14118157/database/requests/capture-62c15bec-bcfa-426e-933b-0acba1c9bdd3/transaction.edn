od}\\,10) \\\\  & ≡0+2\\, & (\\text{mod}\\,10) \\\\  & ≡2\\, & (\\text{mod}\\,10)\\end{aligned}\n$$\n\nTherefore, by the exponentiation property, we have the following:\n\n$$\n\\begin{aligned}{12}^{4} & ≡{2}^{4}\\, & (\\text{mod}\\,10) \\\\  & ≡16\\, & (\\text{mod}\\,10) \\\\  & ≡10+6\\, & (\\text{mod}\\,10) \\\\  & ≡0+6\\, & (\\text{mod}\\,10) \\\\  & ≡6\\, & (\\text{mod}\\,10) \\\\ {12}^{8} & ≡{6}^{2}\\, & (\\text{mod}\\,10) \\\\  & ≡36\\, & (\\text{mod}\\,10) \\\\  & ≡3\\cdot 10+6\\, & (\\text{mod}\\,10) \\\\  & ≡3\\cdot 0+6\\, & (\\text{mod}\\,10) \\\\  & ≡6\\, & (\\text{mod}\\,10)\\end{aligned}\n$$\n\nNext, we decompose ${12}^{17}$ into a product of smaller exponents. \n\n$$\n{12}^{17}={({12}^{8})}^{2}\\cdot 12\n$$\n\nBy applying the multiplicative and exponentiation properties, we have the following:\n\n$$\n\\begin{aligned}{12}^{17} & ≡{({12}^{8})}^{2}\\cdot 12\\, & (\\text{mod}\\,10) \\\\  & ≡(6)^{2}\\cdot 2\\, & (\\text{mod}\\,10) \\\\  & ≡36\\cdot 2\\, & (\\text{mod}\\,10) \\\\  & ≡72\\, & (\\text{mod}\\,10) \\\\  & ≡7\\cdot 10+2\\, & (\\text{mod}\\,10) \\\\  & ≡7\\cdot 0+2\\, & (\\text{mod}\\,10) \\\\  & ≡2\\, & (\\text{mod}\\,10)\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{12}^{17}\\text{ mod }10=2\n$$\n\nwhich means that the last digit of ${12}^{17}$ is $2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9c2c66a9-3896-5725-a5ff-7e8f8b45bda5"] :db/ensure [:question/validate]} {:db/id "answer-field-9c2c66a9-3896-5725-a5ff-7e8f8b45bda5" :answer-field/id #uuid "9c2c66a9-3896-5725-a5ff-7e8f8b45bda5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-85f30528-69a2-5386-9ced-f8a2a9aa251c" :answer-field/choices ["answer-435c4276-bb89-5e54-9226-0a5f36cba6d1" "answer-85f30528-69a2-5386-9ced-f8a2a9aa251c" "answer-48c7861e-daa2-5f32-8cbe-7e879c2a04bc" "answer-3bc7c2b3-26fe-52ba-840f-cc9a5abd5758" "answer-d68d2076-28d4-5eef-999b-f6df1b2a030f"] :db/ensure [:an