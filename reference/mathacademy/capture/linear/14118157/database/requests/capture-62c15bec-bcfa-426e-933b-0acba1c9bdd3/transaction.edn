dot 0+6\\, & (\\text{mod}\\,8) \\\\  & ≡6\\, & (\\text{mod}\\,8) \\\\ 74 & ≡9\\cdot 8+2\\, & (\\text{mod}\\,8) \\\\  & ≡9\\cdot 0+2\\, & (\\text{mod}\\,8) \\\\  & ≡2\\, & (\\text{mod}\\,8)\\end{aligned}\n$$\n\nTherefore, by the multiplicative property of congruences, we have the following:\n\n$$\n\\begin{aligned}94\\cdot 74 & ≡6\\cdot 2\\, & (\\text{mod}\\,8) \\\\  & ≡12\\, & (\\text{mod}\\,8) \\\\  & ≡8+4\\, & (\\text{mod}\\,8) \\\\  & ≡0+4\\, & (\\text{mod}\\,8) \\\\  & ≡4\\, & (\\text{mod}\\,8)\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n94\\cdot 74\\text{ mod }8=4.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-88403233-5d65-5d7f-a884-198469bdac12"] :db/ensure [:question/validate]} {:db/id "answer-field-88403233-5d65-5d7f-a884-198469bdac12" :answer-field/id #uuid "88403233-5d65-5d7f-a884-198469bdac12" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3ee53d91-2594-53d2-9d42-3fe1afc3ede2" :answer-field/choices ["answer-3ee53d91-2594-53d2-9d42-3fe1afc3ede2"] :db/ensure [:answer-field/validate]} {:db/id "answer-3ee53d91-2594-53d2-9d42-3fe1afc3ede2" :answer/id #uuid "3ee53d91-2594-53d2-9d42-3fe1afc3ede2" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186152483 :question/problem "Use the multiplicative property of congruences to compute the following residue.\n\n$84\\cdot 102\\text{ mod }5=$\n\n{{field-1}}" :question/worked-solution "The multiplicative property of modular congruences states that if\n\n$$\na≡b\\,\\text{and}\\,c≡d\\,(\\text{mod}\\,n),\n$$\n\nthen, we have \n\n$$\nac≡bd\\,(\\text{mod}\\,n).\n$$\n\nFirst, we note the following:\n\n$$\n\\begin{aligned}84 & ≡16\\cdot 5+4\\, & (\\text{mod}\\,5) \\\\  & ≡16\\cdot 0+4\\, & (\\text{mod}\\,5) \\\\  & ≡4\\, & (\\text{mod}\\,5) \\\\ 102 & ≡20\\cdot 5+2\\, & (\\text{mod}\\,5) \\\\  & ≡20\\cdot 0+2\\, & (\\text{mod}\\,5) \\\\  & ≡2\\, & (\\text{mod}\\,5)\\end{aligned}\n$$\n\nTherefore, by the multiplicative property of congruences, we have the following:\n\n$$\n\\begin{aligned}84\\cdot 102 & ≡4\\cdot 2\\, & (\\text{mod}\\,5) \\\\  & ≡8\\, & (\\text{mod}\\,5) \\\\  & ≡5+3\\, & (\\text{mod}\\,5) \\\\  & ≡0+3\\, & (\\text{mod}\\,5) \\\\  & ≡3\\, & (\\text{mod}\\,5)\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n84\\cdot 102\\text{ mod }5=3.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-dea5876a-7981-5a10-9558-42412b898766"] :db/ensure [:question/validate]} {:db/id "answer-field-dea5876a-7981-5a10-9558-42412b898766" :answer-field/id #uuid "dea5876a-7981-5a10-9558-42412b898766" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-caf00a28-bbe1-5808-ba3d-02015e277bef" :answer-field/choices ["answer-caf00a28-bbe1-5808-ba3d-02015e277bef"] :db/ensure [:answer-field/validate]} {:db/id "answer-caf00a28-bbe1-5808-ba3d-02015e277bef" :answer/id #uuid "caf00a28-bbe1-5808-ba3d-02015e277bef" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-6f365d70-97c4-5d2a-be4d-f7de85215156" :question/id #uuid "6f365d70-97c4-5d2a-be4d-f7de85215156" :question/math-academy-id "q-213204" :question/problem "Use the multiplicative property of congruences to compute the following residue.\n\n$83\\cdot 96\\text{ mod }10=$\n\n{{field-1}}" :question/worked-solution "The multiplicative property of modular congruences states that if\n\n$$\na≡b\\,\\text{and}\\,c≡d\\,(\\text{mod}\\,n),\n$$\n\nthen, we have \n\n$$\nac≡bd\\,(\\text{mod}\\,n).\n$$\n\nFirst, we note the following:\n\n$$\n\\begin{aligned}83 & ≡8\\cdot 10+3\\, & (\\text{mod}\\,10) \\\\  & ≡8\\cdot 0+3\\, & (\\text{mod}\\,10) \\\\  & ≡3\\, & (\\text{mod}\\,10) \\\\ 96 & ≡9\\cdot 10+6\\, & (\\text{mod}\\,10) \\\\  & ≡9\\cdot 0+6\\, & (\\text{mod}\\,10) \\\\  & ≡6\\, & (\\text{mod}\\,10)\\end{aligned}\n$$\n\nTherefore, by the multiplicative property of congruences, we have the following:\n\n$$\n\\begin{aligned}83\\cdot 96 & ≡3\\cdot 6\\, & (\\text{mod}\\,10) \\\\  & ≡18\\, & (\\text{mod}\\,10) \\\\  & ≡10+8\\, & (\\text{mod}\\,10) \\\\  & ≡0+8\\, & (\\text{mod}\\,10) \\\\  & ≡8\\, & (\\text{mod}\\,10)\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n83\\cdot 96\\text{ mod }10=8.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9a4a822a-0df9-511d-8cdb-21b5b97be2e7"] :db/ensure [:question/validate]} {:db/id "answer-field-9a4a822a-0df9-511d-8cdb-21b5b97be2e7" :answer-field/id #uuid "9a4a822a-0df9-511d-8cdb-21b5b97be2e7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-55107169-1347-5d61-9f4e-046e76adf857" :answer-field/choices ["answer-55107169-1347-5d61-9f4e-046e76adf857"] :db/ensure [:answer-field/validate]} {:db/id "answer-55107169-1347-5d61-9f4e-046e76adf857" :answer/id #uuid "55107169-1347-5d61-9f4e-046e76adf857" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "question-4a7e58ae-7402-5947-902d-187649afe03f" :question/id #uuid "4a7e58ae-7402-5947-902d-187649afe03f" :question/math-academy-id "q-213206" :question/problem "Use the multiplicative property of congruences to compute the following residue.\n\n$113\\cdot 119\\text{ mod }10=$\n\n{{field-1}}" :question/worked-solution "The multiplicative property of modular congruences states that if\n\n$$\na≡b\\,\\text{and}\\,c≡d\\,(\\text{mod}\\,n),\n$$\n\nthen, we have \n\n$$\nac≡bd\\,(\\text{mod}\\,n).\n$$\n\nFirst, we note the following:\n\n$$\n\\begin{aligned}113 & ≡11\\cdot 10+3\\, & (\\text{mod}\\,10) \\\\  & ≡11\\cdot 0+3\\, & (\\text{mod}\\,10) \\\\  & ≡3\\, & (\\text{mod}\\,10) \\\\ 119 & ≡11\\cdot 10+9\\, & (\\text{mod}\\,10) \\\\  & ≡11\\cdot 0+9\\, & (\\text{mod}\\,10) \\\\  & ≡9\\, & (\\text{mod}\\,10)\\end{aligned}\n$$\n\nTherefore, by the multiplicative property of congruences, we have the following:\n\n$$\n\\begin{aligned}113\\cdot 119 & ≡3\\cdot 9\\, & (\\text{mod}\\,10) \\\\  & ≡27\\, & (\\text{mod}\\,10) \\\\  & ≡2\\cdot 10+7\\, & (\\text{mod}\\,10) \\\\  & ≡2\\cdot 0+7\\, & (\\text{mod}\\,10) \\\\  & ≡0+7\\, & (\\text{mod}\\,10) \\\\  & ≡7\\, & (\\text{mod}\\,10)\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n113\\cdot 119\\text{ mod }10=7.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-158bdf28-7538-5205-9155-7eb2e0864758"] :db/ensure [:question/validate]} {:db/id "answer-field-158bdf28-7538-5205-9155-7eb2e0864758" :answer-field/id #uuid "158bdf28-7538-5205-9155-7eb2e0864758" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b4728c8e-2946-54fe-b1c8-574c9966d95c" :answer-field/choices ["answer-b4728c8e-2946-54fe-b1c8-574c9966d95c"] :db/ensure [:answer-field/validate]} {:db/id "answer-b4728c8e-2946-54fe-b1c8-574c9966d95c" :answer/id #uuid "b4728c8e-2946-54fe-b1c8-574c9966d95c" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "question-33e605f0-847a-5675-b130-592bda56586a" :question/id #uuid "33e605f0-847a-5675-b130-592bda56586a" :question/math-academy-id "q-213065" :question/problem "Use the multiplicative property of congruences to compute the following residue.\n\n$120\\cdot 140\\text{ mod }9=$\n\n{{field-1}}" :question/worked-solution "The multiplicative property of modular congruences states that if\n\n$$\na≡b\\,\\text{and}\\,c≡d\\,(\\text{mod}\\,n),\n$$\n\nthen, we have \n\n$$\nac≡bd\\,(\\text{mod}\\,n).\n$$\n\nFirst, we note the following:\n\n$$\n\\begin{aligned}120 & ≡13\\cdot 9+3\\, & (\\text{mod}\\,9) \\\\  & ≡13\\cdot 0+3\\, & (\\text{mod}\\,9) \\\\  & ≡3\\, & (\\text{mod}\\,9) \\\\ 140 & ≡15\\cdot 9+5\\, & (\\text{mod}\\,9) \\\\  & ≡15\\cdot 0+5\\, & (\\text{mod}\\,9) \\\\  & ≡5\\, & (\\text{mod}\\,9)\\end{aligned}\n$$\n\nTherefore, by the multiplicative property of congruences, we have the following:\n\n$$\n\\begin{aligned}120\\cdot 140 & ≡3\\cdot 5\\, & (\\text{mod}\\,9) \\\\  & ≡15\\, & (\\text{mod}\\,9) \\\\  & ≡9+6\\, & (\\text{mod}\\,9) \\\\  & ≡0+6\\, & (\\text{mod}\\,9) \\\\  & ≡6\\, & (\\text{mod}\\,9)\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n120\\cdot 140\\text{ mod }9=6.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b582a022-b816-570a-9ea2-aa5288c6cd78"] :db/ensure [:question/validate]} {:db/id "answer-field-b582a022-b816-570a-9ea2-aa5288c6cd78" :answer-field/id #uuid "b582a022-b816-570a-9ea2-aa5288c6cd78" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e13f034b-3533-5ff3-af42-5647e7b22ae2" :answer-field/choices ["answer-e13f034b-3533-5ff3-af42-5647e7b22ae2"] :db/ensure [:answer-field/validate]} {:db/id "answer-e13f034b-3533-5ff3-af42-5647e7b22ae2" :answer/id #uuid "e13f034b-3533-5ff3-af42-5647e7b22ae2" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-d32d1e8e-c6cb-5e8e-ad44-72ef38726d73" :question/id #uuid "d32d1e8e-c6cb-5e8e-ad44-72ef38726d73" :question/math-academy-id "q-213057" :question/problem "By the multiplicative property of congruences, ${15}^{4}≡$" :question/worked-solution "The multiplicative property of modular congruences states that if\n\n$$\na≡b\\,\\text{and}\\,c≡d\\,(\\text{mod}\\,n),\n$$\n\nthen, we have \n\n$$\nac≡bd\\,(\\text{mod}\\,n).\n$$\n\nFirst, we decompose the exponent into a product of smaller exponents. For example,\n\n$$\n{15}^{4}=(3\\cdot 5)^{4}={3}^{2}\\cdot {3}^{2}\\cdot {5}^{2}\\cdot {5}^{2}.\n$$\n\nNext, we note the following:\n\n$$\n\\begin{aligned}{3}^{2} & ≡9\\, & (\\text{mod}\\,7) \\\\  & ≡1\\cdot 7+2\\, & (\\text{mod}\\,7) \\\\  & ≡1\\cdot 0+2\\, & (\\text{mod}\\,7) \\\\  & ≡2\\, & (\\text{mod}\\,7) \\\\ {5}^{2} & ≡25\\, & (\\text{mod}\\,7) \\\\  & ≡3\\cdot 7+4\\, & (\\text{mod}\\,7) \\\\  & ≡3\\cdot 0+4\\, & (\\text{mod}\\,7) \\\\  & ≡4\\, & (\\text{mod}\\,7)\\end{aligned}\n$$\n\nTherefore, by the multiplicative property of congruences, we have the following:\n\n$$\n\\begin{aligned}{15}^{4} & ≡{3}^{2}\\cdot {3}^{2}\\cdot {5}^{2}\\cdot {5}^{2}\\, & (\\text{mod}\\,7) \\\\  & ≡2\\cdot 2\\cdot 4\\cdot 4\\, & (\\text{mod}\\,7) \\\\  & ≡64\\, & (\\text{mod}\\,7) \\\\  & ≡9\\cdot 7+1\\, & (\\text{mod}\\,7) \\\\  & ≡9\\cdot 0+1\\, & (\\text{mod}\\,7) \\\\  & ≡1\\, & (\\text{mod}\\,7)\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{15}^{4}≡1\\,\\,(\\text{mod}\\,7).\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-2e1229ef-83d7-5706-a137-61793a70b333"] :db/ensure [:question/validate]} {:db/id "answer-field-2e1229ef-83d7-5706-a137-61793a70b333" :answer-field/id #uuid "2e1229ef-83d7-5706-a137-61793a70b333" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fbe3488a-bf88-541e-89a3-283a067565bc" :answer-field/choices ["answer-fbe3488a-bf88-541e-89a3-283a067565bc" "answer-72dfd0de-01f9-5745-9e80-7951963796da" "answer-2e4fd226-e1ee-532e-9da7-b3a38912b44c" "answer-745ac539-6595-5789-9996-9d6eca918d93" "answer-311985a2-423d-589b-bb01-4905e58b17b4"] :db/ensure [:answer-field/validate]} {:db/id "answer-fbe3488a-bf88-541e-89a3-283a067565bc" :answer/id #uuid "fbe3488a-bf88-541e-89a3-283a067565bc" :answer/type :answer.type/math :answer/value "1\\,(\\text{mod}\\,7)" :db/ensure [:answer/validate]} {:db/id "answer-72dfd0de-01f9-5745-9e80-7951963796da" :answer/id #uuid "72dfd0de-01f9-5745-9e80-7951963796da" :answer/type :answer.type/math :answer/value "2\\,(\\text{mod}\\,7)" :db/ensure [:answer/validate]} {:db/id "answer-2e4fd226-e1ee-532e-9da7-b3a38912b44c" :answer/id #uuid "2e4fd226-e1ee-532e-9da7-b3a38912b44c" :answer/type :answer.type/math :answer/value "3\\,(\\text{mod}\\,7)" :db/ensure [:answer/validate]} {:db/id "answer-745ac539-6595-5789-9996-9d6eca918d93" :answer/id #uuid "745ac539-6595-5789-9996-9d6eca918d93" :answer/type :answer.type/math :answer/value "4\\,(\\text{mod}\\,7)" :db/ensure [:answer/validate]} {:db/id "answer-311985a2-423d-589b-bb01-4905e58b17b4" :answer/id #uuid "311985a2-423d-589b-bb01-4905e58b17b4" :answer/type :answer.type/math :answer/value "5\\,(\\text{mod}\\,7)" :db/ensure [:answer/validate]} {:db/id "question-d8e0aa45-c7f0-5602-aeab-6e88c994c623" :question/id #uuid "d8e0aa45-c7f0-5602-aeab-6e88c994c623" :question/math-academy-id "q-213055" :question/problem "By the multiplicative property of congruences, ${20}^{4}≡$" :question/worked-solution "The multiplicative property of modular congruences states that if\n\n$$\na≡b\\,\\text{and}\\,c≡d\\,(\\text{mod}\\,n),\n$$\n\nthen, we have \n\n$$\nac≡bd\\,(\\text{mod}\\,n).\n$$\n\nFirst, we decompose the exponent into a product of smaller exponents. For example,\n\n$$\n{20}^{4}=(4\\cdot 5)^{4}={4}^{2}\\cdot {4}^{2}\\cdot {5}^{2}\\cdot {5}^{2}.\n$$\n\nNext, we note the following:\n\n$$\n\\begin{aligned}{4}^{2} & ≡16\\, & (\\text{mod}\\,6) \\\\  & ≡2\\cdot 6+4\\, & (\\text{mod}\\,6) \\\\  & ≡2\\cdot 0+4\\, & (\\text{mod}\\,6) \\\\  & ≡4\\, & (\\text{mod}\\,6) \\\\ {5}^{2} & ≡25\\, & (\\text{mod}\\,6) \\\\  & ≡4\\cdot 6+1\\, & (\\text{mod}\\,6) \\\\  & ≡4\\cdot 0+1\\, & (\\text{mod}\\,6) \\\\  & ≡1\\, & (\\text{mod}\\,6)\\end{aligned}\n$$\n\nTherefore, by the multiplicative property of congruences, we have the following:\n\n$$\n\\begin{aligned}{20}^{4} & ≡{4}^{2}\\cdot {4}^{2}\\cdot {5}^{2}\\cdot {5}^{2}\\, & (\\text{mod}\\,6) \\\\  & ≡4\\cdot 4\\cdot 1\\cdot 1\\, & (\\text{mod}\\,6) \\\\  & ≡16\\, & (\\text{mod}\\,6) \\\\  & ≡2\\cdot 6+4\\, & (\\text{mod}\\,6) \\\\  & ≡2\\cdot 0+4\\, & (\\text{mod}\\,6) \\\\  & ≡4\\, & (\\text{mod}\\,6)\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{20}^{4}≡4\\,\\,(\\text{mod}\\,6).\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-0588c800-d87c-56d9-83a6-8993a8964638"] :db/ensure [:question/validate]} {:db/id "answer-field-0588c800-d87c-56d9-83a6-8993a8964638" :ans