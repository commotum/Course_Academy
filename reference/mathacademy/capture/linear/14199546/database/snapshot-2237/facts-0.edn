b/ref 17592186045417] [17592186074071 #edb/ref 1072 #uuid "da9fefdc-bf24-5050-9662-b6463d7dc33f" #edb/ref 17592186045417] [17592186074071 #edb/ref 1074 "Let $({x}_{m},{y}_{m})$ be the midpoint between ${{(p,-3q)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(-p,7q)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\  & =(\\frac{a+5a}{2},\\frac{2b+7b}{2}) \\\\  & =(\\frac{6a}{2},\\frac{9b}{2}) \\\\  & =(3a,\\frac{9b}{2})\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186074600 #edb/ref 1058 #edb/ref 17592186074601 #edb/ref 17592186045417] [17592186074600 #edb/ref 1061 154975 #edb/ref 17592186045417] [17592186074600 #edb/ref 1062 #uuid "eecc366e-853e-52a8-bc68-b16fc245ecce" #edb/ref 17592186045417] [17592186074600 #edb/ref 1063 #edb/ref 17592186075050 #edb/ref 17592186045417] [17592186074601 #edb/ref 1058 #edb/ref 17592186074602 #edb/ref 17592186045417] [17592186074601 #edb/ref 1061 154976 #edb/ref 17592186045417] [17592186074601 #edb/ref 1062 #uuid "ee2327aa-02a2-5e9b-b07c-07c22671f4fc" #edb/ref 17592186045417] [17592186074601 #edb/ref 1063 #edb/ref 17592186073713 #edb/ref 17592186045417] [17592186074602 #edb/ref 1058 #edb/ref 17592186074603 #edb/ref 17592186045417] [17592186074602 #edb/ref 1061 154979 #edb/ref 17592186045417] [17592186074602 #edb/ref 1062 #uuid "a966a4b4-4e42-5a47-812c-3a495619e03c" #edb/ref 17592186045417] [17592186074602 #edb/ref 1063 #edb/ref 17592186073714 #edb/ref 17592186045417] [17592186074603 #edb/ref 1058 #edb/ref 17592186074604 #edb/ref 17592186045417] [17592186074603 #edb/ref 1061 154983 #edb/ref 17592186045417] [17592186074603 #edb/ref 1062 #uuid "4b327d3b-e449-5f4a-9b7f-318819c5309f" #edb/ref 17592186045417] [17592186074603 #edb/ref 1063 #edb/ref 17592186075051 #edb/ref 17592186045417] [17592186074604 #edb/ref 1061 154984 #edb/ref 17592186045417] [17592186074604 #edb/ref 1062 #uuid "039589a4-f68f-5959-bc9d-32aaa65805e0" #edb/ref 17592186045417] [17592186074604 #edb/ref 1063 #edb/ref 17592186073715 #edb/ref 17592186045417] [17592186075050 #edb/ref 1064 "In the coordinate plane, the **midpoint** of a line segment with endpoints $(x_1,y_1)$ and $(x_2,y_2)$ lies halfway between the $x$-coordinates $x_1$ and $x_2$, and halfway between the $y$-coordinates $y_1$ and $y_2$.\n\nThe coordinates of the midpoint can be computed using the formula\n\n$$\n(x_m,y_m) = \\left(\\dfrac{x_1 +x_2}2,\\dfrac{y_1+y_2}2\\right)\n$$\n\nFor example, the coordinates of the midpoint of a line segment with endpoints $(2,1)$ and $(6,13)$ can be found as follows:\n\n$$\n\\begin{aligned}\n(x_{m}, y_{m}) &= (\\frac{x_{1} + x_{2}}{2}, \\frac{y_{1} + y_{2}}{2}) \\\\\n&= (\\frac{2 + 6}{2}, \\frac{1 + 13}{2}) \\\\\n&= (\\frac{8}{2}, \\frac{14}{2}) \\\\\n&= (4, 7)\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186075050 #edb/ref 1065 8897 #edb/ref 17592186045417] [17592186075050 #edb/ref 1066 #uuid "164a0bd6-c234-5906-82c5-f00aefe19504" #edb/ref 17592186045417] [17592186075050 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186075051 #edb/ref 1064 "Suppose $M(4,2)$ is the midpoint between $A(1,1)$ and $B(a,b)$. What are the values of $a$ and $b$?\n\n![](images/d9/d946b98f81c7f30ff5a277c337be47dc743de531e3b138795d4a15f34ad82d54.png)\n\nAgain, we use the midpoint formula:\n\n$$\n\\begin{aligned}\n(x_{m}, y_{m}) &= (\\frac{x_{1} + x_{2}}{2}, \\frac{y_{1} + y_{2}}{2})\n\\end{aligned}\n$$\n\nWe have\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}x_{1} &= 1, & y_{1}|= 1, \\\\ x_{2}|= a, & y_{2}|= b, \\\\ x_{m}|= 4, & y_{m}|= 2\\end{bmatrix}\n\\end{aligned}\n$$\n\nSubstituting the known values in the formula, we obtain\n\n$$\n\\begin{aligned}\n(4, 2) &= (\\frac{1 + a}{2}, \\frac{1 + b}{2})\n\\end{aligned}\n$$\n\nSetting the $x$-coordinates equal to each other and the $y$-coordinates equal to each other, we have the following two equations:\n\n$$\n{4 = \\frac{1 + a}{2}; 2 = \\frac{1 + b}{2}\n$$\n\nMultiplying both sides of the equations by $2$, we have:\n\n$$\n{8 = 1 + a; 4 = 1 + b\n$$\n\nFinally, we solve both equations independently:\n\n$$\n{a = 8 - 1 = 7; b = 4 - 1 = 3\n$$\n\nTherefore, $a=7$ and $b=3$." #edb/ref 17592186045417] [17592186075051 #edb/ref 1065 8900 #edb/ref 17592186045417] [17592186075051 #edb/ref 1066 #uuid "34ecfb6d-a13d-5bc2-b346-787701d55aad" #edb/ref 17592186045417] [17592186075051 #edb/ref 1067 "Finding the Coordinates of Endpoints" #edb/ref 17592186045417] [17592186232320 #edb/ref 1075 #edb/ref 17592186232321 #edb/ref 17592186045417] [17592186232320 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186232320 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186232320 #edb/ref 1078 #edb/ref 17592186232321 #edb/ref 17592186045417] [17592186232320 #edb/ref 1079 #uuid "1082e8b5-8913-5875-8fe3-ad51c1835a69" #edb/ref 17592186045417] [17592186232321 #edb/ref 1080 "0" #edb/ref 17592186045417] [17592186232321 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186232321 #edb/ref 1083 #uuid "8aad39ba-6db2-56df-800c-230c6458882c" #edb/ref 17592186045417] [17592186232322 #edb/ref 1075 #edb/ref 17592186232323 #edb/ref 17592186045417] [17592186232322 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186232322 #edb/ref 1077 "field-2" #edb/ref 17592186045417] [17592186232322 #edb/ref 1078 #edb/ref 17592186232323 #edb/ref 17592186045417] [17592186232322 #edb/ref 1079 #uuid "35d8314b-9f95-5b94-bfab-fca783b713e6" #edb/ref 17592186045417] [17592186232323 #edb/ref 1080 "7b" #edb/ref 17592186045417] [17592186232323 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186232323 #edb/ref 1083 #uuid "42ca0cda-c134-5297-8632-955cb72a1ca9" #edb/ref 17592186045417] [17592186233639 #edb/ref 1068 #edb/ref 17592186232320 #edb/ref 17592186045417] [17592186233639 #edb/ref 1068 #edb/ref 17592186232322 #edb/ref 17592186045417] [17592186233639 #edb/ref 1069 "q-216930" #edb/ref 17