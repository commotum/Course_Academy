#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186515705} :activity/id #uuid "0883d86e-5541-56ae-8de4-4ac2740940dd" :activity/scope {:db/id #edb/ref 17592186049418 :topic/id #uuid "f344db4d-49a0-59ae-b874-a20de566b228" :topic/math-academy-id 485} :activity/steps [{:db/id #edb/ref 17592186515650 :step/content {:db/id #edb/ref 17592186515597 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b7b9791-af25-5e90-861e-446399a6a146" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186515128}] :answer-field/correct {:db/id #edb/ref 17592186515128} :answer-field/id #uuid "6b2a52c3-ee42-535e-8b88-9e9ef0d1b7d4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186515446} {:answer-field/choices [{:answer/id #uuid "b8c1496a-1064-5406-b667-1268a2be4ad7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186515264}] :answer-field/correct {:db/id #edb/ref 17592186515264} :answer-field/id #uuid "daca740b-bc95-5aa8-be58-811d21d0982f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186515499}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c5f766d1-90d4-56be-969c-e0d6ece7eafd" :question/math-academy-id "q-216948" :question/problem "![](images/75/75ea79c4a66a187d5973375c40f49d373cee14f9d15848841616e93a420c6cbd.png)\n\nGiven that $(-3,3)$ is the midpoint of the line segment $\\overset{―}{PQ}$ above, find the values of $a$ and $b.$\n\n$a=$\n{{field-1}},\n$\\,b=$\n{{field-2}}" :question/worked-solution "The given points are ${{(a,b)}_{⏟}}_{\\text{(}{x}_{1},\\,{y}_{1})}$, ${{(0,1)}_{⏟}}_{\\text{(}{x}_{2},\\,{y}_{2})}$ and ${{(-3,3)}_{⏟}}_{\\text{(}{x}_{m},\\,{y}_{m})}.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\ (-3,3) & =(\\frac{a+0}{2},\\frac{b+1}{2})\\end{aligned}\n$$\n\nEquating the corresponding $x$- and $y$-coordinates in the equation above gives us\n\n$$\n\\begin{aligned}\\{\\begin{aligned}-3=\\frac{a}{2} \\\\ 3=\\frac{b+1}{2}\\end{aligned}\\,⇒\\,\\{\\begin{aligned}a=-6 \\\\ b=5.\\end{aligned}\\end{aligned}\n$$\n\nThus, $a=-6$ and $b=5.$"} :step/id #uuid "4abe6353-f41c-5f2e-aa9f-118f96d42a30"} {:db/id #edb/ref 17592186515661 :step/content {:db/id #edb/ref 17592186074071 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bf240b6-f61f-518a-b330-8c680ccea02f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3a" :db/id #edb/ref 17592186514933}] :answer-field/correct {:db/id #edb/ref 17592186514933} :answer-field/id #uuid "eee5b7ab-c133-57eb-9614-aeff1522c54c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186070332} {:answer-field/choices [{:answer/id #uuid "b7cf5be2-d878-5497-9973-b2239ae30dbe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9b}{2}" :db/id #edb/ref 17592186515261}] :answer-field/correct {:db/id #edb/ref 17592186515261} :answer-field/id #uuid "5e65decf-258e-5566-95ef-5b3bd98f8cc1" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186070333}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "da9fefdc-bf24-5050-9662-b6463d7dc33f" :question/math-academy-id "q-216932" :question/problem "The midpoint of the line segment with endpoints $(a,2b)$ and $(5a,7b)$\n is$\\,($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "Let $({x}_{m},{y}_{m})$ be the midpoint between ${{(p,-3q)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(-p,7q)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\  & =(\\frac{a+5a}{2},\\frac{2b+7b}{2}) \\\\  & =(\\frac{6a}{2},\\frac{9b}{2}) \\\\  & =(3a,\\frac{9b}{2})\\end{aligned}\n$$"} :step/id #uuid "6a7eee90-2761-51ce-a490-bd435592e5d7" :step/next {:db/id #edb/ref 17592186515650}} {:db/id #edb/ref 17592186515663 :step/content {:db/id #edb/ref 17592186233639 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8aad39ba-6db2-56df-800c-230c6458882c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186232321}] :answer-field/correct {:db/id #edb/ref 17592186232321} :answer-field/id #uuid "1082e8b5-8913-5875-8fe3-ad51c1835a69" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186232320} {:answer-field/choices [{:answer/id #uuid "42ca0cda-c134-5297-8632-955cb72a1ca9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7b" :db/id #edb/ref 17592186232323}] :answer-field/correct {:db/id #edb/ref 17592186232323} :answer-field/id #uuid "35d8314b-9f95-5b94-bfab-fca783b713e6" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186232322}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "41810a95-1f10-5b21-be9b-c2e54027cf53" :question/math-academy-id "q-216930" :question/problem "The midpoint of the line segment with endpoints $(-3a,6b)$ and $(3a,8b)$ is$\\,($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "Let $({x}_{m},{y}_{m})$ be the midpoint between ${{(-3a,6b)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(3a,8b)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\  & =(\\frac{-3a+3a}{2},\\frac{6b+8b}{2}) \\\\  & =(\\frac{0}{2},\\frac{14b}{2}) \\\\  & =(0,7b)\\end{aligned}\n$$"} :step/id #uuid "6f7eaf96-9084-5973-a1bd-0aea49c8d031" :step/next {:db/id #edb/ref 17592186515661}} {:db/id #edb/ref 17592186515705 :step/content {:db/id #edb/ref 17592186515519 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f0cd083-b85f-5b73-be46-8de81ad9529e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186514903} {:answer/id #uuid "3f987373-c5cf-510d-a27d-0b648d09125c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186515010} {:answer/id #uuid "93e4a872-764c-5c44-8abe-38d12305d515" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186515184} {:answer/id #uuid "abb63ab6-3015-5a1d-98ac-a93a26fa894d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186515233} {:answer/id #uuid "be75ab74-ecad-5cde-bccf-db980f3b0d57" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186515276}] :answer-field/correct {:db/id #edb/ref 17592186514903} :answer-field/id #uuid "3b988816-8ed1-5b88-adb7-733d9244bffa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186515431}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "07669a6a-a7d4-5af3-bbb0-d0ed7db93b62" :question/math-academy-id "q-14364" :question/problem "If the midpoint of the line segment with endpoints $(-5,3)$ and $(a,b)$ is $(1,4),$\nthen $a+b=$" :question/worked-solution "The given points are ${{(-5,3)}_{⏟}}_{\\text{(}{x}_{1},\\,{y}_{1})},$ ${{(a,b)}_{⏟}}_{\\text{(}{x}_{2},\\,{y}_{2})}$ and ${{(1,4)}_{⏟}}_{\\text{(}{x}_{m},\\,{y}_{m})}\\,.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\ (1,4) & =(\\frac{-5+a}{2},\\frac{3+b}{2}).\\end{aligned}\n$$\n\nEquating the corresponding $x$- and $y$-coordinates in the equation above gives us\n\n$$\n\\begin{aligned}\\{\\begin{aligned}1=\\frac{-5+a}{2} \\\\ 4=\\frac{3+b}{2}\\end{aligned}\\,⇒\\,\\{\\begin{aligned}a=7 \\\\ b=5.\\end{aligned}\\end{aligned}\n$$\n\nThus, $(a,b)=(7,5)$ and $a+b=12.$"} :step/id #uuid "ee2d3f73-67b1-53f4-89a5-3dc76f78bca8" :step/next {:db/id #edb/ref 17592186515663}}] :activity/title "Midpoints in the Coordinate Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186514851}]}
