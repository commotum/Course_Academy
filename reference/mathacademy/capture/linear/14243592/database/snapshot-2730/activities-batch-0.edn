ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186124694}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186561072} :activity/id #uuid "1a6e8abe-f458-5f9e-be48-4dd594b1e0e4" :activity/scope {:db/id #edb/ref 17592186049731 :topic/id #uuid "0f127f4a-3cf5-5736-90b8-9817b73eb050" :topic/math-academy-id 1889} :activity/steps [{:db/id #edb/ref 17592186561067 :step/content {:db/id #edb/ref 17592186125195 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a40ae285-433a-5246-af0a-c88929a17e44" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438362} {:answer/id #uuid "e15901cc-60b2-5acb-8bde-29e449df57e8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438363}] :answer-field/correct {:db/id #edb/ref 17592186438362} :answer-field/id #uuid "31c00eba-5f85-593e-a961-4f82d5b230c4" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439210} {:answer-field/choices [{:answer/id #uuid "0e9d17c6-21e1-5f62-96ed-ad5565cf2dd8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438364} {:answer/id #uuid "dffc387b-695d-57a9-8327-5b7f95278dec" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438365}] :answer-field/correct {:db/id #edb/ref 17592186438365} :answer-field/id #uuid "d8399770-7bd0-5bd4-871d-487953742e13" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439211} {:answer-field/choices [{:answer/id #uuid "1e0e5c91-0cdc-57c0-b0a0-e40824bbc4e9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438366} {:answer/id #uuid "0fd86b3d-4e5d-5a86-912e-c80f82634797" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438367}] :answer-field/correct {:db/id #edb/ref 17592186438367} :answer-field/id #uuid "4fca4c40-e85f-5c68-8f26-936d0e0fe80e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439212}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9ea11e93-5fca-5cd0-afe6-c972b9a2cce3" :question/math-academy-id "q-66482" :question/problem "Given that $f(x)={x}^{2}+2,$ on which of the following intervals is $f(x)$ invertible?\n\nSelect all that apply.\n\n- **I.** $x\\in (-2,2)$\n- **II.** $x\\in [0,\\infty )$\n- **III.** $x\\in (-\\infty ,0]$" :question/worked-solution "The graph of the function $f(x)={x}^{2}+2$ can be obtained in the following way:\n\n- Take the curve $y={x}^{2}.$\n\n- Translate it by $2$ units up to get $f(x)={x}^{2}+2.$\n\n![](images/ff/ff3d1ac7500d83574b8671b23e99d4a0f1dbd6ab9cebc906aa06ff2c21f95345.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The function $f(x)$ is not invertible on the interval $x\\in (-2,2).$ On this interval, some horizontal lines will intersect the curve more than once.\n\n![](images/a7/a71ce036adc5dc0b15fce9e367a0c8512699dc6a7814f4e9a1886696d2abad6e.png)\n\n- The function $f(x)$ is invertible on the intervals $x\\in [0,\\infty )$ and  $x\\in (-\\infty ,0].$ On these intervals, any horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](images/68/6858bd1fab8d9659c84fa941cd63ee9f509c8364dce0e753706c640ecfe6e9ec.png)\n\nTherefore, the correct answer is \"II and III only\"."} :step/id #uuid "05667c2e-8371-5d18-b8f4-28e387601b58"} {:db/id #edb/ref 17592186561072 :step/content {:db/id #edb/ref 17592186124951 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4b078b7-f5a3-5e10-8da4-739f031e9cbe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438214} {:answer/id #uuid "8c292220-45e3-5b72-bba6-cb8a5c0646b0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438215}] :answer-field/correct {:db/id #edb/ref 17592186438215} :answer-field/id #uuid "251d1017-18ef-5bc9-9883-11eca3e38d83" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439136} {:answer-field/choices [{:answer/id #uuid "48ad9111-5ff9-5808-834a-73627abed3d4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438216} {:answer/id #uuid "29672cf9-dfff-5490-ae19-b79923580048" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438217}] :answer-field/correct {:db/id #edb/ref 17592186438217} :answer-field/id #uuid "02d06f78-7466-5d54-950d-cb989daacc0e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439137} {:answer-field/choices [{:answer/id #uuid "fbe0bd4f-6a4d-525e-ac35-a1868f919e0b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438218} {:answer/id #uuid "00a2f1ae-0f2a-55b3-bef4-eabad652d111" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438219}] :answer-field/correct {:db/id #edb/ref 17592186438218} :answer-field/id #uuid "4c704ed7-9a63-5c1b-90d0-bdb2e302d80f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439138}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b8099f21-9137-5121-a075-a61a4c5ae84b" :question/math-academy-id "q-36039" :question/problem "![](images/93/936cea1e20ef7bbc1eb66acf9dd564c61476f5bb68ee05e553b00aaf3f970dc3.png)\n\nOn which of the following intervals is the function $f(x)$ (shown above) invertible?\n\nSelect all that apply.\n\n- **I.** $x\\in [-4,0]$\n\n- **II.** $x\\in (-4,-2]$\n\n- **III.** $x\\in (-3,1)$" :question/worked-solution "A function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.  \n\n- The given function is invertible on each of the intervals $x\\in [-4,0]$ and $x\\in (-4,-2].$ Indeed, any horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](images/a4/a4499c2d4995c09b9ab6f8852cc2982f415f1650d65429c86df83800344106f4.png)\n\n- The given function is **not** invertible on the interval $x\\in (-3,1]$  because some lines will intersect the curve at more than one point.\n\n![](images/cb/cb0a462b3af10d15bb586f127baac45a74eecd5dc19848bda23664e75de968a4.png)\n\nTherefore, the correct answer is \"I and II only\"."} :step/id #uuid "51114073-60cf-523a-978f-1aa6471e7316" :step/next {:db/id #edb/ref 17592186561098}} {:db/id #edb/ref 17592186561098 :step/content {:db/id #edb/ref 17592186323749 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "efc69b98-00eb-5840-b90d-c96ba4931e4e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438228} {:answer/id #uuid "4ccd2d26-a281-5b97-9b06-263136be07dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438229}] :answer-field/correct {:db/id #edb/ref 17592186438229} :answer-field/id #uuid "559a6aac-97fe-50a0-8beb-d1323671d7f8" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439143} {:answer-field/choices [{:answer/id #uuid "40a97abe-d55d-5007-b4fd-6937cc34e17a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438230} {:answer/id #uuid "b173d1e1-4b30-5d88-8de6-73fd6e00131b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438231}] :answer-field/correct {:db/id #edb/ref 17592186438231} :answer-field/id #uuid "6639d61d-bf93-5072-838b-4370ba49c0ed" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439144} {:answer-field/choices [{:answer/id #uuid "6fcc16d7-b530-54ef-9b90-9c7275e5931d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438232} {:answer/id #uuid "8cf0f901-76be-5f84-b0ee-c5cd9c1a5306" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438233}] :answer-field/correct {:db/id #edb/ref 17592186438232} :answer-field/id #uuid "5f0537b4-3665-5585-a12b-bb1d508ad121" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439145}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6815ae09-6f05-5b7b-9ca9-f709c3e26769" :question/math-academy-id "q-36066" :question/problem "![](images/e2/e2065775ae6372e8c820b5e2f19f6f105e032dcd37db1e32e04af5bfa6a4faf9.png)\n\nOn which of the following intervals is the function $f(x)$ (shown above) invertible?\n\nSelect all that apply.\n\n- **I.** $x\\in (-3,-2]\\cup (2,4)$\n- **II.** $x\\in (0,2]$\n- **III.** $x\\in [1,4)$" :question/worked-solution "A function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test. \n\n- The given function is invertible on the intervals $x\\in (-3,-2]\\cup (2,4)$ and $x\\in (0,2].$ Indeed, any horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](images/3c/3c5bc724ee29aee7bef2790012bf0e73ce1ed087134213dbad36a670fd136a36.png)\n\n        \n\n- The given function is **not** invertible on the interval $[1,4)$  because some horizontal lines will intersect the curve more than once.\n\n![](images/03/03b9d70513a4ef99b39c9f05d0c0ac803f8e5611d0967015e9c1d9c0f45bd418.png)\n\nTherefore, the correct answer is \"I  and II only\"."} :step/id #uuid "e51b8e10-e997-539f-b84d-64f26a00ff50" :step/next {:db/id #edb/ref 17592186561067}}] :activity/title "Invertible Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186560353}]}
