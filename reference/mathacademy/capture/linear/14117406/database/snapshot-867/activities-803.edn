#{[{:activity/first-step {:db/id #edb/ref 17592186088554} :activity/id #uuid "08de5d22-7723-5283-ac76-b0a9c54b4ea9" :activity/scope {:db/id #edb/ref 17592186048293 :topic/id #uuid "91edf602-4db5-5995-a70e-acdee225f178" :topic/math-academy-id 803} :activity/steps [{:db/id #edb/ref 17592186088554 :step/content {:db/id #edb/ref 17592186088904 :tutorial/content "We can draw a curve by defining a relationship between $x$ and $y$ using a third parameter $t.$ For example, suppose we have \n\n$$\nx=2t, \\,\\,\\, y=t^2, \\quad -3\\leq t\\leq 3.\n$$\n\nThese are the **parametric equations** of the curve.\n\nFirst, let's create a table for some values of $t\\mathbin{:}$\n\n| **$t$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x= 2t$ | $-6$ | $-4$ | $-2$ | $0$ | $2$ | $4$ | $6$ |\n| $y=t^2$ | $9$ | $4$ | $1$ | $0$ | $1$ | $4$ | $9$ |\n\nPlotting these points, we get the following curve:\n\n![](images/f7/f716e12c79731f363ace05965809bfc1963a6c3a231e1c4a96eaf3dbb62c848e.png)\n\nThe curve is actually a parabola.\nA curve defined by parametric equations is called a **parametric curve** and is said to be \"defined parametrically\"." :tutorial/id #uuid "f1327a56-c215-50cb-a30e-e43369078a3c" :tutorial/math-academy-id 3349 :tutorial/title "Introduction"} :step/id #uuid "218377cb-122a-56d3-9bc2-df2b7ebad88e" :step/math-academy-id 18547 :step/next {:db/id #edb/ref 17592186088555}} {:db/id #edb/ref 17592186088555 :step/content {:db/id #edb/ref 17592186087717 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087518 :question/id #uuid "53ce2176-ae44-578d-8fba-35c5018d4162" :question/math-academy-id "e-5075"} :knowledge-point/id #uuid "bbf50e27-a8c3-52e7-be21-5d7ed61e5512" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050790}] :knowledge-point/questions [{:db/id #edb/ref 17592186088269} {:db/id #edb/ref 17592186088270} {:db/id #edb/ref 17592186233325} {:db/id #edb/ref 17592186233831} {:db/id #edb/ref 17592186234248} {:db/id #edb/ref 17592186234256} {:db/id #edb/ref 17592186259554} {:db/id #edb/ref 17592186259555} {:db/id #edb/ref 17592186302269} {:db/id #edb/ref 17592186302270} {:db/id #edb/ref 17592186302271} {:db/id #edb/ref 17592186302272} {:db/id #edb/ref 17592186302273} {:db/id #edb/ref 17592186302274} {:db/id #edb/ref 17592186302275} {:db/id #edb/ref 17592186335928} {:db/id #edb/ref 17592186335959} {:db/id #edb/ref 17592186336019}] :knowledge-point/title "Filling a Table of Values for a Parametric Curve"} :step/id #uuid "100ba475-df33-5ce4-9f19-dc90b51a15ac" :step/math-academy-id 18548 :step/next {:db/id #edb/ref 17592186088560}} {:db/id #edb/ref 17592186088560 :step/content {:db/id #edb/ref 17592186087721 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087522 :question/id #uuid "b322617c-ab21-5ce8-997f-2f10813b4280" :question/math-academy-id "e-5098"} :knowledge-point/id #uuid "e0dc11d5-8eda-52b1-b7b1-42b481813ff4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049072}] :knowledge-point/questions [{:db/id #edb/ref 17592186088027} {:db/id #edb/ref 17592186088028} {:db/id #edb/ref 17592186259562} {:db/id #edb/ref 17592186259563} {:db/id #edb/ref 17592186259564} {:db/id #edb/ref 17592186259565} {:db/id #edb/ref 17592186281298} {:db/id #edb/ref 17592186281377} {:db/id #edb/ref 17592186281382} {:db/id #edb/ref 17592186281384} {:db/id #edb/ref 17592186387437} {:db/id #edb/ref 17592186387444} {:db/id #edb/ref 17592186389223} {:db/id #edb/ref 17592186389236} {:db/id #edb/ref 17592186389243} {:db/id #edb/ref 17592186393320}] :knowledge-point/title "Graphing a Curve Defined Parametrically"} :step/id #uuid "5621dae4-d9c7-5199-b4f0-2ee503009aa1" :step/math-academy-id 18603 :step/next {:db/id #edb/ref 17592186088561}} {:db/id #edb/ref 17592186088561 :step/content {:db/id #edb/ref 17592186087722 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087523 :question/id #uuid "a792fa16-e1fd-5f30-a128-bbc49a285429" :question/math-academy-id "e-5099"} :knowledge-point/id #uuid "3cbf0ad0-a7c5-5c0f-a06c-9210fdc244ef" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050372} {:db/id #edb/ref 17592186050580} {:db/id #edb/ref 17592186050642}] :knowledge-point/questions [{:db/id #edb/ref 17592186088030} {:db/id #edb/ref 17592186088031} {:db/id #edb/ref 17592186233539} {:db/id #edb/ref 17592186234355} {:db/id #edb/ref 17592186259556} {:db/id #edb/ref 17592186259557} {:db/id #edb/ref 17592186259558} {:db/id #edb/ref 17592186259559} {:db/id #edb/ref 17592186259560} {:db/id #edb/ref 17592186281385} {:db/id #edb/ref 17592186281386} {:db/id #edb/ref 17592186292914} {:db/id #edb/ref 17592186302276} {:db/id #edb/ref 17592186302278} {:db/id #edb/ref 17592186302285} {:db/id #edb/ref 17592186302286} {:db/id #edb/ref 17592186302287} {:db/id #edb/ref 17592186302337} {:db/id #edb/ref 17592186302362} {:db/id #edb/ref 17592186302363} {:db/id #edb/ref 17592186342036} {:db/id #edb/ref 17592186400114} {:db/id #edb/ref 17592186403675}] :knowledge-point/title "Determining the Range of a Parametric Equation"} :step/id #uuid "a2b6d468-dc59-53d1-b89f-9fdbc94f428b" :step/math-academy-id 18604 :step/next {:db/id #edb/ref 17592186088562}} {:db/id #edb/ref 17592186088562 :step/content {:db/id #edb/ref 17592186088906 :tutorial/content "We often see parametric curves defined in terms of the parameter $t,$ such as the parametric curve given below:\n\n$$\nx=2 \\cos t, \\,\\,\\, y=3 \\sin t, \\quad 0 \\leq t < 2 \\pi\n$$\n\nHowever, we can also define parametric curves in terms of other variables. Another commonly used variable is $\\theta.$ So, in terms of $\\theta,$ the above parametric equation is expressed as\n\n$$\nx=2 \\cos \\theta, \\,\\,\\, y=3 \\sin \\theta, \\quad 0 \\leq \\theta < 2 \\pi .\n$$\n\nWe often use $\\theta$ when the bounds are $0 \\leq \\theta < 2\\pi,$ because this implies that the parameter $\\theta$ might be interpreted as an angle." :tutorial/id #uuid "5a132530-6b5f-59d1-bd02-6ac362b558a7" :tutorial/math-academy-id 3370 :tutorial/title "Defining Parametric Curves Using Other Parameters"} :step/id #uuid "35535a0b-1ada-5085-afad-0de6b32bfb5b" :step/math-academy-id 18844 :step/next {:db/id #edb/ref 17592186088588}} {:db/id #edb/ref 17592186088588 :step/content {:db/id #edb/ref 17592186087736 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087542 :question/id #uuid "25ab094c-a35e-5507-a6df-459361ff6fcd" :question/math-academy-id "e-5292"} :knowledge-point/id #uuid "cddc940d-2185-569c-a62b-b507e95d3c35" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049872}] :knowledge-point/questions [{:db/id #edb/ref 17592186088029} {:db/id #edb/ref 17592186088281} {:db/id #edb/ref 17592186233713} {:db/id #edb/ref 17592186233838} {:db/id #edb/ref 17592186259561} {:db/id #edb/ref 17592186292915} {:db/id #edb/ref 17592186302364} {:db/id #edb/ref 17592186302365} {:db/id #edb/ref 17592186302367} {:db/id #edb/ref 17592186302369} {:db/id #edb/ref 17592186302370} {:db/id #edb/ref 17592186338790} {:db/id #edb/ref 17592186342038} {:db/id #edb/ref 17592186342042} {:db/id #edb/ref 17592186400121} {:db/id #edb/ref 17592186400128}] :knowledge-point/title "Determining the Range of a Parametric Equation Defined in Terms of Trigonometric Functions"} :step/id #uuid "a097ab21-0ae3-5fba-a879-051b3ab0e156" :step/math-academy-id 19530}] :activity/title "Graphing Curves Defined Parametrically" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186087892}]}
