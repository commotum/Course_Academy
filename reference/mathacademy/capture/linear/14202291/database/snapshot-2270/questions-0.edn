#{[{:db/id #edb/ref 17592186519532 :knowledge-point/_questions [{:db/id #edb/ref 17592186119942 :knowledge-point/id #uuid "bea72566-55ba-582e-802c-e5ce5ef4a9fc" :knowledge-point/title "Calculating the Limit of a Rational Function With Two Quadratic Terms by Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c83a02a-d899-55c8-a94f-5215ee121e17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186519111} {:answer/id #uuid "81e207e3-fbc2-5800-abe0-1ceefd387562" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186519195} {:answer/id #uuid "89b85bb3-22c0-5d24-a29b-0c275ecfe2a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186519215} {:answer/id #uuid "d56cb5bc-4d9d-5419-a948-dca0397cf746" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186519344} {:answer/id #uuid "e10ffd2c-df31-5361-8cae-6b39de43c35c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186519365}] :answer-field/correct {:answer/id #uuid "89b85bb3-22c0-5d24-a29b-0c275ecfe2a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186519215} :answer-field/id #uuid "be118eae-f956-5136-8758-541234de46d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519484}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2778d4f8-72c7-5929-98a7-5df304873786" :question/math-academy-id "q-101160" :question/problem "Evaluate ${lim}_{y\\to 3}\\frac{{y}^{2}+3y-18}{{y}^{2}-3y}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{y\\to 3}\\frac{{y}^{2}+3y-18}{{y}^{2}-3y} & =\\frac{{3}^{2}+3(3)-18}{{3}^{2}-3(3)}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{y}^{2}+3y-18}{{y}^{2}-3y} & =\\frac{(y+6)(y-3)}{y(y-3)} \\\\  & =\\frac{y+6}{y}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{y\\to 3}\\frac{{y}^{2}+3y-18}{{y}^{2}-3y} & ={lim}_{y\\to 3}\\frac{y+6}{y} \\\\  & =\\frac{3+6}{3} \\\\  & =\\frac{9}{3} \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186519542 :knowledge-point/_questions [{:db/id #edb/ref 17592186119942 :knowledge-point/id #uuid "bea72566-55ba-582e-802c-e5ce5ef4a9fc" :knowledge-point/title "Calculating the Limit of a Rational Function With Two Quadratic Terms by Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b385cd1-b9ce-5705-9e8c-ff293413d49c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186519185}] :answer-field/correct {:answer/id #uuid "7b385cd1-b9ce-5705-9e8c-ff293413d49c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186519185} :answer-field/id #uuid "dd8d554e-6195-547e-bcb1-ff6fe5d58358" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186519500}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5986bf81-4caa-5e55-8c99-36ab322d7c9c" :question/math-academy-id "q-313149" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to -2}\\frac{{x}^{2}-5x-14}{x+2}=$\n{{field-1}}" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to -2}\\frac{{x}^{2}-5x-14}{x+2} & =\\frac{(-2)^{2}-5(-2)-14}{-2+2} \\\\  & =\\frac{4+10-14}{0} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator. We get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}-5x-14}{x+2} & =\\frac{(x-7)(x+2)}{x+2} \\\\  & =x-7.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to -2}(x-7) & =(-2)-7 \\\\  & =-9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186519551 :knowledge-point/_questions [{:db/id #edb/ref 17592186119938 :knowledge-point/id #uuid "7eaa6cbd-46e1-5681-b536-06d16e8d3654" :knowledge-point/title "Calculating the Limit of a Rational Function With Higher Order Terms by Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e1be6ba-0318-5199-9cf7-6cfc2c56fa02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186519156} {:answer/id #uuid "892f567d-b4cc-5f65-95a7-7373905d09c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186519211} {:answer/id #uuid "8ce5d32b-9d7b-5303-97bb-68e862c5ae64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186519222} {:answer/id #uuid "a6c6b966-6937-5cda-a2a8-2103c125ed81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186519266} {:answer/id #uuid "edf46e72-237e-5ade-b7c8-d89a1c8c5d81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186519382}] :answer-field/correct {:answer/id #uuid "a6c6b966-6937-5cda-a2a8-2103c125ed81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186519266} :answer-field/id #uuid "2b3845e7-e81e-5c5b-85b8-7d7f11e07468" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519427}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "72828711-fc6d-5cc1-8d14-0b819a351e61" :question/math-academy-id "q-3749" :question/problem "Evaluate ${lim}_{x\\to 1}\\frac{-2{x}^{4}+6{x}^{2}-4}{{x}^{2}-1}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{-2{x}^{4}+6{x}^{2}-4}{{x}^{2}-1} & =\\frac{-2(1)^{4}+6(1)^{2}-4}{(1)^{2}-1}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. \n\n$$\n\\begin{aligned}\\frac{-2{x}^{4}+6{x}^{2}-4}{{x}^{2}-1} & =\\frac{-2({x}^{4}-3{x}^{2}+2)}{{x}^{2}-1} \\\\  & =\\frac{-2({x}^{2}-2)({x}^{2}-1)}{{x}^{2}-1} \\\\  & =-2({x}^{2}-2).\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{-2{x}^{4}+6{x}^{2}-4}{{x}^{2}-1} & ={lim}_{x\\to 1}\\,\\,-2({x}^{2}-2) \\\\  & =-2(1-2) \\\\  & =2.\\end{aligned}\n$$"}]}
