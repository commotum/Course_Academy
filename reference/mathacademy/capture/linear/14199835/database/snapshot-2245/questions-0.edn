#{[{:db/id #edb/ref 17592186516787 :knowledge-point/_questions [{:db/id #edb/ref 17592186073674 :knowledge-point/id #uuid "c1ec0eb3-ea8e-5783-b6a2-dc7128709f71" :knowledge-point/title "Expressing a Trigonometric Ratio With a Linear Expression Angle as a Cofunction of a Complementary Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28286d6d-ad07-57e3-bf30-df2a9fc9669f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡(\\theta +{38}^{∘})" :db/id #edb/ref 17592186516195} {:answer/id #uuid "3e419048-16ff-5c66-ae89-db3a66c0e04b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡({38}^{∘}-\\theta )" :db/id #edb/ref 17592186516234} {:answer/id #uuid "6c996574-91a9-51e8-9312-f04c34295651" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡({38}^{∘}-\\theta )" :db/id #edb/ref 17592186516351} {:answer/id #uuid "bf651374-36d8-557f-b681-3dc03d4228d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡({38}^{∘}-\\theta )" :db/id #edb/ref 17592186516518} {:answer/id #uuid "db5ab455-9105-51dc-b743-f8595cf1ed86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡(\\theta +{38}^{∘})" :db/id #edb/ref 17592186516573}] :answer-field/correct {:answer/id #uuid "db5ab455-9105-51dc-b743-f8595cf1ed86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡(\\theta +{38}^{∘})" :db/id #edb/ref 17592186516573} :answer-field/id #uuid "7dda5fed-8473-5945-9921-a17a8674675e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516710}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2741d45a-fa16-53e2-880b-c02211a343a6" :question/math-academy-id "q-121635" :question/problem "Express $\\operatorname{csc}⁡({52}^{∘}-\\theta )$ as a cofunction of a complementary angle." :question/worked-solution "We know that the cofunction of $\\operatorname{csc}⁡\\theta $ is $\\operatorname{sec}⁡\\theta ,$ and the angle complementary to ${52}^{∘}-\\theta $ is \n\n$$\n{90}^{∘}-({52}^{∘}-\\theta )={90}^{∘}-{52}^{∘}+\\theta =\\theta +{38}^{∘}.\n$$\n\n \n\n So we have\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡({52}^{∘}-\\theta )=\\operatorname{sec}⁡({90}^{∘}-({52}^{∘}-\\theta ))=\\operatorname{sec}⁡(\\theta +{38}^{∘}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186074081 :knowledge-point/_questions [{:db/id #edb/ref 17592186073675 :knowledge-point/id #uuid "b653137f-4991-5388-b34d-8573c58c0841" :knowledge-point/title "Solving for a Variable Given Two Angles and a Cofunction Equality"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8bc448ef-ad7d-573d-9492-1e1fa503989b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186070355} {:answer/id #uuid "9687551b-7554-5709-ab37-c37ccd8eb982" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186070356} {:answer/id #uuid "de51a6d2-c8d5-5050-a5b7-7f7ecc5db40c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186070357} {:answer/id #uuid "0de35427-4700-5455-aeef-e3d6cb0e1fba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186070358} {:answer/id #uuid "12fdcb2b-c21e-552b-8b9d-a52c607d5cf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186070359}] :answer-field/correct {:answer/id #uuid "12fdcb2b-c21e-552b-8b9d-a52c607d5cf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186070359} :answer-field/id #uuid "1712deff-6406-55d7-b884-b4d5e3627df7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186070354}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5f4e61a7-f26a-56bc-8378-0113cfde8291" :question/math-academy-id "q-23396" :question/problem "If $m∠A=(5x+16)^{∘}$ and $m∠B=(x+8)^{∘},$ find a value of $x$ that satisfies $\\operatorname{cot}⁡A=\\operatorname{tan}⁡B.$  Suppose that both $∠A$ and $∠B$ are acute." :question/worked-solution "If both angles are acute and $\\operatorname{cot}⁡A=\\operatorname{tan}⁡B,$ then the angles $∠A$ and $∠B$ must be complementary, and we have\n\n$$\n\\begin{aligned}(5x+16)^{∘}+(x+8)^{∘} & ={90}^{∘} \\\\ (6x+24)^{∘} & ={90}^{∘} \\\\ 6x+24 & =90 \\\\ 6x & =66 \\\\ x & =11.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186516799 :knowledge-point/_questions [{:db/id #edb/ref 17592186073674 :knowledge-point/id #uuid "c1ec0eb3-ea8e-5783-b6a2-dc7128709f71" :knowledge-point/title "Expressing a Trigonometric Ratio With a Linear Expression Angle as a Cofunction of a Complementary Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "249bd755-b9fc-5059-a4cc-054bc42e9314" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡({59}^{∘}-\\theta )" :db/id #edb/ref 17592186516182} {:answer/id #uuid "a2f9945e-67bd-552a-92a0-da62f3ed7aec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡({31}^{∘}-\\theta )" :db/id #edb/ref 17592186516448} {:answer/id #uuid "e568a46e-9865-52b5-95e3-a68f91b5f928" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡({59}^{∘}-\\theta )" :db/id #edb/ref 17592186516590} {:answer/id #uuid "eddd4ec4-631c-5919-aeb3-fe7717bba038" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡({31}^{∘}-\\theta )" :db/id #edb/ref 17592186516605} {:answer/id #uuid "fc4b055c-aeb5-5d2a-b243-457b5c94d048" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡({59}^{∘}-\\theta )" :db/id #edb/ref 17592186516639}] :answer-field/correct {:answer/id #uuid "fc4b055c-aeb5-5d2a-b243-457b5c94d048" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡({59}^{∘}-\\theta )" :db/id #edb/ref 17592186516639} :answer-field/id #uuid "5d9dfd76-7e56-51fc-b4c9-69b55120139b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516688}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "48f83c42-2b91-552c-8245-857f1b1c658c" :question/math-academy-id "q-54180" :question/problem "Express $\\operatorname{cos}⁡(\\theta +{31}^{∘})$ as a cofunction of a complementary angle." :question/worked-solution "We know that the cofunction of $\\operatorname{cos}⁡\\theta $ is $\\operatorname{sin}⁡\\theta ,$ and the angle complementary to $\\theta +{31}^{∘}$ is \n\n$$\n{90}^{∘}-(\\theta +{31}^{∘})={90}^{∘}-\\theta -{31}^{∘}={59}^{∘}-\\theta .\n$$\n\nSo we have\n\n$$\n\\operatorname{cos}⁡(\\theta +{31}^{∘})=\\operatorname{sin}⁡({90}^{∘}-(\\theta +{31}^{∘}))=\\operatorname{sin}⁡({59}^{∘}-\\theta ).\n$$"}] [{:db/id #edb/ref 17592186516777 :knowledge-point/_questions [{:db/id #edb/ref 17592186073673 :knowledge-point/id #uuid "52f46344-b7c0-51a1-918c-aaac34dd5c40" :knowledge-point/title "Finding the Value of a Variable Satisfying a Cofunction Equality"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d6260fb-52da-585b-8762-43ddb0c85bd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{65}^{∘}" :db/id #edb/ref 17592186516167} {:answer/id #uuid "52894601-4ce1-5150-accd-ddb12bf8ce0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{39}^{∘}" :db/id #edb/ref 17592186516284} {:answer/id #uuid "95595f2a-9508-56a1-9b79-2e80f73d9cfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{28}^{∘}" :db/id #edb/ref 17592186516420} {:answer/id #uuid "c879ab7d-d2e0-5cdf-a36d-49043d561722" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{49}^{∘}" :db/id #edb/ref 17592186516537} {:answer/id #uuid "f0745c84-f316-5a12-9678-2861eb0bf75f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{32}^{∘}" :db/id #edb/ref 17592186516609}] :answer-field/correct {:answer/id #uuid "52894601-4ce1-5150-accd-ddb12bf8ce0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{39}^{∘}" :db/id #edb/ref 17592186516284} :answer-field/id #uuid "987f7db7-dd4a-52e2-baa4-bf058dad8795" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516726}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "177a5181-a104-5ae5-8d0b-29a1b6bce482" :question/math-academy-id "q-67541" :question/problem "Determine a value of $x$ satisfying the equation $\\operatorname{tan}⁡{51}^{∘}=\\operatorname{cot}⁡x.$" :question/worked-solution "Since the tangent of an angle equals the cotangent of its complement, we have\n\n$$\n\\operatorname{tan}⁡{51}^{∘}=\\operatorname{cot}⁡({90}^{∘}-{51}^{∘})=\\operatorname{cot}⁡{39}^{∘}.\n$$\n\nTherefore, $x={39}^{∘}$ satisfies the given equation."}]}
