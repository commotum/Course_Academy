c-c551-5bb2-bff8-2b656eb8f001" :step/id #uuid "ff46c6ac-c551-5bb2-bff8-2b656eb8f001" :step/content "question-17babc52-289e-5d9d-bc9c-baaf511d4b6f" :db/ensure [:step/validate]}] "assertions" [["question-3ba51678-bfa5-5eea-a51d-29e6a8b3feb3" :question/id #uuid "3ba51678-bfa5-5eea-a51d-29e6a8b3feb3"] ["question-3ba51678-bfa5-5eea-a51d-29e6a8b3feb3" :question/math-academy-id "q-74587"] ["question-3ba51678-bfa5-5eea-a51d-29e6a8b3feb3" :question/problem "![](images/9a/9a1f9f1877ae0ecbc37464c5b8b20821070e7927e59dea8d930ceb8f37313722.png)\n\nWhich of the figures above is a parallelogram?"] ["question-3ba51678-bfa5-5eea-a51d-29e6a8b3feb3" :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nRemember that a parallelogram is a quadrilateral with $2$ pairs of parallel sides.\n\nWith that in mind, let's look at each shape in turn.\n\n- The shape $P$ is a parallelogram since it has $2$ pairs of parallel sides.\n\n- The shape $Q$ is a square. Therefore, its opposite sides are parallel, so it is a parallelogram.\n\n- The shape $R$ is a rhombus. Since the opposite sides of a rhombus are parallel, it is a parallelogram.\n\n- The shape $S$ is a kite. It has no pairs of opposite sides that are parallel, therefore, it is not a parallelogram.\n\nTherefore, shapes $P,$ $Q,$ and $R$ are parallelograms. The shape $S$ is not parallelogram."] ["question-3ba51678-bfa5-5eea-a51d-29e6a8b3feb3" :question/difficulty :question.difficulty/easy] ["answer-field-b42fb396-a4b8-5570-82e5-99d092314e89" :answer-field/id #uuid "b42fb396-a4b8-5570-82e5-99d092314e89"] ["answer-f1f6f0ac-04f0-51ca-89d5-280f541bf412" :answer/id #uuid "f1f6f0ac-04f0-51ca-89d5-280f541bf412"] ["answer-f1f6f0ac-04f0-51ca-89d5-280f541bf412" :answer/type :answer.type/text] ["answer-f1f6f0ac-04f0-51ca-89d5-280f541bf412" :answer/value "$P$ and $Q$ only"] ["answer-aa794fee-92cb-5205-bbb7-3265b7d85083" :answer/id #uuid "aa794fee-92cb-5205-bbb7-3265b7d85083"] ["answer-aa794fee-92cb-5205-bbb7-3265b7d85083" :answer/type :answer.type/text] ["answer-aa794fee-92cb-5205-bbb7-3265b7d85083" :answer/value "$P$ and $R$ only"] ["answer-b5636201-42e6-5b02-b154-839b34a298f1" :answer/id #uuid "b5636201-42e6-5b02-b154-839b34a298f1"] ["answer-b5636201-42e6-5b02-b154-839b34a298f1" :answer/type :answer.type/text] ["answer-b5636201-42e6-5b02-b154-839b34a298f1" :answer/value "$P$ only"] ["answer-b0c121de-66bb-58ae-a63e-bbf43d0fe360" :answer/id #uuid "b0c121de-66bb-58ae-a63e-bbf43d0fe360"] ["answer-b0c121de-66bb-58ae-a63e-bbf43d0fe360" :answer/type :answer.type/text] ["answer-b0c121de-66bb-58ae-a63e-bbf43d0fe360" :answer/value "$P,$ $Q,$ and $R$ only"] ["answer-58145878-10ab-57b3-b664-f6d36bca4d69" :answer/id #uuid "58145878-10ab-57b3-b664-f6d36bca4d69"] ["answer-58145878-10ab-57b3-b664-f6d36bca4d69" :answer/type :answer.type/text] ["answer-58145878-10ab-57b3-b664-f6d36bca4d69" :answer/value "$Q$ and $R$ only"] ["answer-field-b42fb396-a4b8-5570-82e5-99d092314e89" :answer-field/key "selection"] ["answer-field-b42fb396-a4b8-5570-82e5-99d092314e89" :answer-field/type :answer-field.type/radio] ["answer-field-b42fb396-a4b8-5570-82e5-99d092314e89" :answer-field/correct "answer-b0c121de-66bb-58ae-a63e-bbf43d0fe360"] ["answer-field-b42fb396-a4b8-5570-82e5-99d092314e89" :answer-field/choices "answer-f1f6f0ac-04f0-51ca-89d5-280f541bf412"] ["answer-field-b42fb396-a4b8-5570-82e5-99d092314e89" :answer-field/choices "answer-aa794fee-92cb-5205-bbb7-3265b7d85083"] ["answer-field-b42fb396-a4b8-5570-82e5-99d092314e89" :answer-field/choices "answer-b5636201-42e6-5b02-b154-839b34a298f1"] ["answer-field-b42fb396-a4b8-5570-82e5-99d092314e89" :answer-field/choices "answer-b0c121de-66bb-58ae-a63e-bbf43d0fe360"] ["answer-field-b42fb396-a4b8-5570-82e5-99d092314e89" :answer-field/choices "answer-58145878-10ab-57b3-b664-f6d36bca4d69"] ["question-3ba51678-bfa5-5eea-a51d-29e6a8b3feb3" :question/answer-fields "answer-field-b42fb396-a4b8-5570-82e5-99d092314e89"] [17592186110777 :knowledge-point/questions "question-3ba51678-bfa5-5eea-a51d-29e6a8b3feb3"] ["question-0f0c1499-18ff-5c0e-854a-a4a1f5ed7366" :question/id #uuid "0f0c1499-18ff-5c0e-854a-a4a1f5ed7366"] ["question-0f0c1499-18ff-5c0e-854a-a4a1f5ed7366" :question/math-academy-id "q-68484"] ["question-0f0c1499-18ff-5c0e-854a-a4a1f5ed7366" :question/problem "The city of Mexicali, in Mexico, is $6.6$ feet below sea level, while the city of Porto Alegre, in Brazil, is $55.8$ feet above sea level. What is the difference between the elevations of both cities?"] ["question-0f0c1499-18ff-5c0e-854a-a4a1f5ed7366" :question/worked-solution "To calculate the difference between the elevations of both cities, we must calculate the difference between the city with the highest elevation and the city with the lowest elevation. That is, we must calculate $55.8-(-6.6).$ This gives\n\n$$\n55.8-(-6.6)=55.8+6.6=62.4\\,\\text{ft}.\n$$"] ["question-0f0c1499-18ff-5c0e-854a-a4a1f5ed7366" :question/difficulty :question.difficulty/moderate] ["answer-field-efa5e756-b09f-5eba-be5d-3837c1691e2d" :answer-field/id #uuid "efa5e756-b09f-5eba-be5d-3837c1691e2d"] ["answer-2ce53447-7833-5af3-8f32-25e4bb25afb1" :answer/id #uuid "2ce53447-7833-5af3-8f32-25e4bb25afb1"] ["answer-2ce53447-7833-5af3-8f32-25e4bb25afb1" :answer/type :answer.type/math] ["answer-2ce53447-7833-5af3-8f32-25e4bb25afb1" :answer/value "49.2\\,\\text{ft}"] ["answer-94e4a985-0800-55dd-82be-d6e16717c046" :answer/id #uuid "94e4a985-0800-55dd-82be-d6e16717c046"] ["answer-94e4a985-0800-55dd-82be-d6e16717c046" :answer/type :answer.type/math] ["answer-94e4a985-0800-55dd-82be-d6e16717c046" :answer/value "52.1\\,\\text{ft}"] ["answer-984a41f7-7d0c-5d85-9a6b-bd545d610281" :answer/id #uuid "984a41f7-7d0c-5d85-9a6b-bd545d610281"] ["answer-984a41f7-7d0c-5d85-9a6b-bd545d610281" :answer/type :answer.type/math] ["answer-984a41f7-7d0c-5d85-9a6b-bd545d610281" :