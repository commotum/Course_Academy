#{[{:db/id #edb/ref 17592186531591 :knowledge-point/_questions [{:db/id #edb/ref 17592186073740 :knowledge-point/id #uuid "d16202af-d3ac-54bc-9c76-25947a7a0b60" :knowledge-point/title "Completing a Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "072c4612-620f-5665-ae88-803a5e73fc7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186530873} {:answer/id #uuid "08513f19-74f5-507e-a4d8-bfb5cd2b45a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186530878} {:answer/id #uuid "23d90c48-ea12-53a1-858f-c697d01e819a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186530943} {:answer/id #uuid "31ef6be4-bd24-5a95-b3aa-bc1b412f2eef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186530972} {:answer/id #uuid "81cb9c8e-f7fd-5812-bb11-be5300ffbd38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186531144}] :answer-field/correct {:answer/id #uuid "81cb9c8e-f7fd-5812-bb11-be5300ffbd38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186531144} :answer-field/id #uuid "b1951351-6ab8-534f-90fd-05b82bf0bde5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531504}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4b671a86-bc70-5855-bc03-8c1fbe9580d0" :question/math-academy-id "q-101460" :question/problem "![](images/de/de806ae4a790c7339d49e362204a7a16257a3cb43165e0992f9a35afffed01bd.png)\n\nWhat number is missing from the boxes in the statement below?\n\nThe ratio of triangles to hexagons is $1:\\boxed{}\\,$ because there is $1$ triangle for every $\\boxed{}\\,$ hexagons." :question/worked-solution "First, we count the number of triangles. We see that there are $2$ triangles.\n\nThen, we count the number of hexagons. We see that there are $10$ hexagons.\n\nSo the ratio of triangles to hexagons is $2:10.$\n\nWe can simplify this ratio by dividing both numbers by $2:$\n\n$$\n\\begin{aligned}\\,\\,2 &  & : & \\,\\,\\,\\, & \\,\\,\\,10 &  \\\\ \\,\\,↓÷\\,\\,2 &  &  &  & \\,\\,\\,↓÷\\,\\,2 &  \\\\ \\,\\,1 &  & : &  & \\,\\,\\,5 & \\end{aligned}\n$$\n\nThis means that $1:5$ is equivalent to $2:10.$ \n\nSo, the complete statement is\n\"The ratio of triangles to hexagons is $1:5$ because there is $1$ triangle for every $5$ hexagons.\""}] [{:db/id #edb/ref 17592186531586 :knowledge-point/_questions [{:db/id #edb/ref 17592186073821 :knowledge-point/id #uuid "b38f30b0-9e05-510f-9ba6-928ab1b8482b" :knowledge-point/title "Finding the Additive Inverse of a Negative Integer"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c2d8b23-480d-58a0-a53f-2e077ed9eded" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{15}" :db/id #edb/ref 17592186530887} {:answer/id #uuid "1ebe73ea-6758-5ea6-a455-730e9fbe8545" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186530922} {:answer/id #uuid "8390a06a-40ab-56b4-bf37-2cc84dc97a79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{35}" :db/id #edb/ref 17592186531150} {:answer/id #uuid "8dcff317-0a65-5de1-9449-fd4587a618e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{35}" :db/id #edb/ref 17592186531173} {:answer/id #uuid "eacbba2a-ca7e-5120-b5aa-f3d6d4b09848" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186531336}] :answer-field/correct {:answer/id #uuid "eacbba2a-ca7e-5120-b5aa-f3d6d4b09848" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186531336} :answer-field/id #uuid "672bb081-9c15-5ea5-a6d5-d6d4d17fafa5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531459}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "42762342-58bc-5c22-b022-fb45988d86d1" :question/math-academy-id "q-101566" :question/problem "What number can be added to $-35$ to get a sum of $0?$" :question/worked-solution "The number that can be added to $-35$ to give $0$ is the additive inverse of $-35.$\n\nTo find the additive inverse of the number $-35$, we change its sign by placing a minus symbol $(-)$ in front of it. So, we obtain\n\n$$\n-\\,(-35)=35.\n$$\n\nTo check our work, we simply add the inverse to the original number. If we're correct, we should get zero.\n\n$$\n(-35)+35=-35+35=0\\,✓\n$$"}] [{:db/id #edb/ref 17592186531561 :knowledge-point/_questions [{:db/id #edb/ref 17592186064258 :knowledge-point/id #uuid "0649943a-643f-592f-8815-45c871f7e7dd" :knowledge-point/title "Splitting a Rational Expression With Three Terms in the Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "154b90d1-09df-5975-9106-7abfa155a7f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{3}-2y+4z" :db/id #edb/ref 17592186530901} {:answer/id #uuid "77da7769-a1d4-5c71-8686-24a20677c965" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{3}-\\frac{y}{2}+\\frac{4z}{3}" :db/id #edb/ref 17592186531131} {:answer/id #uuid "8274a2c9-bf10-549e-8286-c1d9ea4ef1c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{3}-y-\\frac{4z}{3}" :db/id #edb/ref 17592186531147} {:answer/id #uuid "8ae6efe2-2a69-5edd-a91a-e313b3c19515" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-3y+4z" :db/id #edb/ref 17592186531167} {:answer/id #uuid "b90bf318-c0cb-58e1-9f0f-37146557bef8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-2y+\\frac{4z}{3}" :db/id #edb/ref 17592186531259}] :answer-field/correct {:answer/id #uuid "77da7769-a1d4-5c71-8686-24a20677c965" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{3}-\\frac{y}{2}+\\frac{4z}{3}" :db/id #edb/ref 17592186531131} :answer-field/id #uuid "beaa49a3-09ca-5bd9-8b13-bb052a6be6fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531513}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "15a43dbb-9c91-5be9-a586-59bfd5235547" :question/math-academy-id "q-103627" :question/problem "$\\frac{2x-3y+8z}{6}=$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in individual terms, we get\n\n$$\n\\begin{aligned}\\frac{2x-3y+8z}{6} & = \\\\ \\frac{2x}{6}-\\frac{3y}{6}+\\frac{8z}{6} & = \\\\ \\frac{2}{6}\\cdot x-\\frac{3}{6}\\cdot y+\\frac{8}{6}\\cdot z & = \\\\ \\frac{1}{3}\\cdot x-\\frac{1}{2}\\cdot y+\\frac{4}{3}\\cdot z & = \\\\ \\frac{x}{3}-\\frac{y}{2}+\\frac{4z}{3} & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186531646 :knowledge-point/_questions [{:db/id #edb/ref 17592186054786 :knowledge-point/id #uuid "8ffb0f82-65ba-5522-93a4-193c9a794a71" :knowledge-point/title "Simplifying Linear Expressions With Positive Numbers in Parentheses: Distributing a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2147df49-a826-5ebb-a3dc-ebe444239e0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-20y" :db/id #edb/ref 17592186530935} {:answer/id #uuid "272cdf46-670b-5698-b4dd-e9cb21841355" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10x-8y" :db/id #edb/ref 17592186530952} {:answer/id #uuid "5ae20b64-ab72-5509-bc96-2ab8d1fafe50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15x-15y" :db/id #edb/ref 17592186531063} {:answer/id #uuid "9183e516-17fb-5257-9c76-19c9409e87ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10x-20y" :db/id #edb/ref 17592186531177} {:answer/id #uuid "d17a4b4a-c1a9-581c-8038-8ac220d502da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10x+15y" :db/id #edb/ref 17592186531297}] :answer-field/correct {:answer/id #uuid "9183e516-17fb-5257-9c76-19c9409e87ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10x-20y" :db/id #edb/ref 17592186531177} :answer-field/id #uuid "add26c3a-8ea0-579d-b7c2-eb977845c92f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531503}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dcca9682-5c6e-581c-bcc3-60c96a3dddcd" :question/math-academy-id "q-141915" :question/problem "$(-5)(2x+3y)-5y=$" :question/worked-solution "First, we distribute the $(-5)$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}\\begin{aligned}(-5)(2x+3y)-5y & = \\\\ (-5)\\cdot 2x+(-5)\\cdot 3y-5y & = \\\\ (-10x)+(-15y)-5y & = \\\\ -10x-15y-5y\\end{aligned}\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}\\begin{aligned}-10x-15y-5y & = \\\\ -10x+(-15y-5y) & = \\\\ -10x-20y\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186531657 :knowledge-point/_questions [{:db/id #edb/ref 17592186110675 :knowledge-point/id #uuid "9ef4e321-841e-5933-b5e4-ff7dab6c5275" :knowledge-point/title "Identifying Collinear Points on a Grid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1643603d-c5ae-57d3-9136-823babe8d447" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186530905} {:answer/id #uuid "20256647-65f2-5046-a78f-8335ba715a35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186530931} {:answer/id #uuid "56e1f971-d113-5022-8210-b1ab22042601" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186531054} {:answer/id #uuid "a0af0a69-97d7-566d-ae7c-64e83031da5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186531212} {:answer/id #uuid "ea8c32c2-3154-5e95-ba13-18e6ee28fe41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186531335}] :answer-field/correct {:answer/id #uuid "56e1f971-d113-5022-8210-b1ab22042601" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186531054} :answer-field/id #uuid "7892cfad-b772-5810-a92d-5b07af0c75e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531471}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f8c7f0d6-8dc6-549e-8375-7c33cf7277e3" :question/math-academy-id "q-155053" :question/problem "![](images/a3/a31a793df705b6cbe8dddb648ca6a0d2ebb6f4eb724ff8b99682f48cafb072a0.png)\n\nWhich of the diagrams above shows three collinear points?" :question/worked-solution "Three (or more) points are collinear if a straight line passes through all points.\n\nWith that in mind, let's examine our diagrams in turn.\n\n- Diagram I shows three points that are *not* collinear. We can't draw a straight line that passes through all three points.\n\n![](images/aa/aad13ab456bc61c90522725ddb60f481c6138a9e53a50136d691ddd344349cf1.png)\n\n- Diagram II shows three collinear points. There is a straight line that passes through all three of these points.\n\n![](images/14/143e831321a485a0e57b706c6df89273bd92b3134d691d1ef41a67b7f7076481.png)\n\n- Diagram III shows three collinear points. There is a straight line that passes through all three of these points.\n\n![](images/2c/2c361eea2a598de063dc62375716ca5bdb7b0a06d4c30cf9a5c420cd9cc48e4b.png)\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186531656 :knowledge-point/_questions [{:db/id #edb/ref 17592186198382 :knowledge-point/id #uuid "0fe851f3-482c-5426-87b2-32ec3c1b40f6" :knowledge-point/title "Expressing Division Problems as Mixed Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "057d7c6e-29e6-5051-a5e8-b0998b5d0542" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1\\,\\frac{1}{4}" :db/id #edb/ref 17592186530870} {:answer/id #uuid "2b653396-bc27-5145-b8ac-e1022471deab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,\\frac{1}{4}" :db/id #edb/ref 17592186530960} {:answer/id #uuid "2e6041d2-fb6a-5f6a-8e9c-714854eda1d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1\\,\\frac{3}{4}" :db/id #edb/ref 17592186530966} {:answer/id #uuid "76d979a8-8760-59e0-812f-a0b817c69f44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\frac{1}{2}" :db/id #edb/ref 17592186531127} {:answer/id #uuid "f19ae37e-0dc6-5e4e-b694-e737cfd667d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\,\\frac{1}{2}" :db/id #edb/ref 17592186531355}] :answer-field/correct {:answer/id #uuid "057d7c6e-29e6-5051-a5e8-b0998b5d0542" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1\\,\\frac{1}{4}" :db/id #edb/ref 17592186530870} :answer-field/id #uuid "30c3593c-4e14-5e97-8e53-48b988006b27" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531425}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f462c87b-3e02-54b6-b206-e6def06b7c2e" :question/math-academy-id "q-162057" :question/problem "$(-5)÷4$ is equivalent to" :question/worked-solution "Here, we are dividing a negative number $(-5)$ by a positive one $(4).$ So the result will be negative:\n\n$$\n(-5)÷4=-\\,\\boxed{}\n$$\n\nNow, to write down the fraction that goes in the box, recall that\n\n$$\n5÷4=1\\,\\text{R}\\,1=1\\,\\frac{1}{4}.\n$$\n\nTherefore, we get\n\n$$\n(-5)÷4=-1\\,\\frac{1}{4}.\n$$"}] [{:db/id #edb/ref 17592186531639 :knowledge-point/_questions [{:db/id #edb/ref 17592186171934 :knowledge-point/id #uuid "cb0ae539-5348-5a2c-b226-c009ce6d6094" :knowledge-point/title "Determining if a Number Is Divisible by 7"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59e23be7-e49a-5617-a19a-0b9edeb9ef0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186531062} {:answer/id #uuid "644bbb8f-fc0c-52e9-9279-e0d5f67b08dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186531085} {:answer/id #uuid "ac2ddf87-b8c7-544a-b0fe-0f9d59990b3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186531235} {:answer/id #uuid "c7bd7190-4fcc-5ddc-85ba-33c60cc87c93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186531280} {:answer/id #uuid "d9021da8-7e8e-5f02-a09d-4138a97ca091" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186531309}] :answer-field/correct {:answer/id #uuid "c7bd7190-4fcc-5ddc-85ba-33c60cc87c93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186531280} :answer-field/id #uuid "1f59470d-4a45-5417-a822-eaa3dc02953a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531410}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cca0b3f3-f64a-53b6-8329-0c693549bc28" :question/math-academy-id "q-223387" :question/problem "Which of the following numbers are divisible by $7?$\n\nI. $523$\n\nII. $532$\n\nIII. $501$" :question/worked-solution "To check if a number is divisible by $7,$ double the last digit, subtract the result from the remaining digits, and then check if the difference is divisible by $7.$\n\n- For the number $523,$ we have that \n\n$$\n52-2(3)=52-6=46\n$$\n\nwhich is not divisible by $7.$ Therefore, $523$ is not divisible by $7.$\n\n- For the number $532,$ we have that \n\n$$\n53-2(2)=53-4=49\n$$\n\nwhich is divisible by $7.$ Therefore, $532$ is divisible by $7.$\n\n- For the number $501,$ we have that \n\n$$\n50-2(1)=50-2=48\n$$\n\nwhich is not divisible by $7.$ Therefore, $501$ is not divisible by $7.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186138776 :knowledge-point/_questions [{:db/id #edb/ref 17592186138539 :knowledge-point/id #uuid "a707a741-0208-5a74-8478-ac05ff2673ab" :knowledge-point/title "Identifying \"And\" Inequalities Given on Number Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14295dff-21db-5fe1-a96c-8930ed638809" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<-2$ or $x\\ge 1$" :db/id #edb/ref 17592186530900} {:answer/id #uuid "4592c636-8f62-592d-9c3e-276e70810db5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2<x<1" :db/id #edb/ref 17592186531013} {:answer/id #uuid "9871d376-12ef-5e6e-af44-fe57744b0653" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2<x\\le 2" :db/id #edb/ref 17592186531192} {:answer/id #uuid "9be6b73e-0418-56db-90da-473d702f855a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\le x<1" :db/id #edb/ref 17592186531198} {:answer/id #uuid "ef9054fd-d157-5ca3-9428-0aa2e99411c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\le x\\le 1" :db/id #edb/ref 17592186531348}] :answer-field/correct {:answer/id #uuid "4592c636-8f62-592d-9c3e-276e70810db5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2<x<1" :db/id #edb/ref 17592186531013} :answer-field/id #uuid "3671129c-87d8-52b4-8590-501af8b56cbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186135604}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "62a55de5-3196-51cd-84ab-2997655d2ecd" :question/math-academy-id "q-28800" :question/problem "![](images/9c/9c67083932dcc9cdca8a54b963923d5b5c1aab223830f01a653834c5a6bb6456.png)\n\nWhich inequality corresponds to the highlighted region shown on the number line above?" :question/worked-solution "The red segment contains all values between  $-2$ and $1.$ In addition,\n\n- the open circle at $-2$ implies that $x$ cannot be equal to $-2,$ while\n\n- the open circle at $1$ implies that $x$ cannot be equal to $1.$\n\nTherefore, the highlighted region represents $-2<x<1.$"}] [{:db/id #edb/ref 17592186176483 :knowledge-point/_questio