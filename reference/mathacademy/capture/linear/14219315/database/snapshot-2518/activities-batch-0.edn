a0d-5e46-a1d7-32e60cf0b8c0" :step/math-academy-id 52950}] :activity/title "Simplifying Linear Expressions Using the Distributive Law" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054888}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186489379} :activity/id #uuid "a3308d93-fc2c-5afd-b2a2-d10eabcc55b8" :activity/scope {:db/id #edb/ref 17592186050575 :topic/id #uuid "54fec5c0-eab2-5b02-8283-066ac6462c43" :topic/math-academy-id 138} :activity/steps [{:db/id #edb/ref 17592186489314 :step/content {:db/id #edb/ref 17592186489294 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15ca5f0a-6066-5ca0-a1b3-1aed5c88446b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2+x" :db/id #edb/ref 17592186488518} {:answer/id #uuid "3b392e44-d743-52c0-b2c4-1b24a9652e42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7+3x" :db/id #edb/ref 17592186488592} {:answer/id #uuid "3f111cec-76bb-5894-9561-03fcdf244044" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7+x" :db/id #edb/ref 17592186488600} {:answer/id #uuid "5a8175c1-02fa-50e9-a6cd-d3cc478b8b05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2+5x" :db/id #edb/ref 17592186488642} {:answer/id #uuid "a82c0323-a9df-5774-94f2-0aaef3aa4133" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2+3x" :db/id #edb/ref 17592186488804}] :answer-field/correct {:db/id #edb/ref 17592186488642} :answer-field/id #uuid "56cc9ec7-a78c-54b1-a942-1c31a8e69346" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489063}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fadc73be-dedf-5384-82b7-e3c8b9123466" :question/math-academy-id "q-173697" :question/problem "$12-3x+(4x-5)\\cdot 2=$" :question/worked-solution "First, we distribute the $2$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}12-3x+(4x-5)\\cdot 2 & = \\\\ 12-3x+4x\\cdot 2+(-5)\\cdot 2 & = \\\\ 12-3x+(8x)+(-10) & = \\\\ 12-3x+8x-10\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}12-3x+8x-10 & = \\\\ (12-10)+(-3x+8x) & = \\\\ (2)+(5x) & = \\\\ 2+5x\\end{aligned}\n$$"} :step/id #uuid "4145c55f-d17c-5a31-bd5a-fdc2bf4c0fc5" :step/next {:db/id #edb/ref 17592186489370}} {:db/id #edb/ref 17592186489368 :step/content {:db/id #edb/ref 17592186489221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05bb9e95-1d10-5069-a452-c7b0b169db9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4-4a" :db/id #edb/ref 17592186488483} {:answer/id #uuid "5ae65b8c-35be-548c-a00d-0cc258220579" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20-4a" :db/id #edb/ref 17592186488644} {:answer/id #uuid "a6e3c89e-98d3-5561-a67a-a1b501b72224" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8-a" :db/id #edb/ref 17592186488803} {:answer/id #uuid "cb99c864-e94b-5f43-b916-b054dd2ef046" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20-a" :db/id #edb/ref 17592186488884} {:answer/id #uuid "fa49a3a2-0170-50ed-940e-118d1bf5b6a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8-4a" :db/id #edb/ref 17592186488998}] :answer-field/correct {:db/id #edb/ref 17592186488644} :answer-field/id #uuid "fcc25ce6-564a-5da0-94c0-553cbcb50892" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489167}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5d0b6029-5d16-5038-805d-6574595234a2" :question/math-academy-id "q-141938" :question/problem "Simplify $4(2-a)+12.$" :question/worked-solution "First, we distribute the $4$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}4(2-a)+12 & = \\\\ 4\\cdot 2+4\\cdot (-a)+12 & = \\\\ (8)+(-4a)+12 & = \\\\ 8-4a+12\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}8-4a+12 & = \\\\ (8+12)-4a & = \\\\ 20-4a\\end{aligned}\n$$"} :step/id #uuid "d6103e78-f799-5832-96a9-e9962966f7a1" :step/next {:db/id #edb/ref 17592186489314}} {:db/id #edb/ref 17592186489370 :step/content {:db/id #edb/ref 17592186489266 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ac84694-db3c-508f-ab4f-56602c4d7c88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186488643}] :answer-field/correct {:db/id #edb/ref 17592186488643} :answer-field/id #uuid "36634756-bd5b-5b68-9066-c998674fe2a6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186489047} {:answer-field/choices [{:answer/id #uuid "d00aea71-15dd-50d3-9494-51ab03f8e7b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186488893}] :answer-field/correct {:db/id #edb/ref 17592186488893} :answer-field/id #uuid "fb10cdd1-554d-5648-b07a-f7242920d579" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186489166}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cd9687a1-fd95-59a6-b621-1301fd1f4974" :question/math-academy-id "q-178204" :question/problem "$(3p+5q)\\cdot (-3)+9q=${{field-1}}\n$p\\,-$\n{{field-2}}\n$q$" :question/worked-solution "First, we distribute the $(-3)$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}\\begin{aligned}(3p+5q)\\cdot (-3)+9q & = \\\\ 3p\\cdot (-3)+5q\\cdot (-3)+9q & = \\\\ (-9p)+(-15q)+9q & = \\\\ -9p-15q+9q\\end{aligned}\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n \n\n$$\n\\begin{aligned}-9p-15q+9q & = \\\\ -9p+(-15q+9q) & = \\\\ -9\\,p-6\\,q & \\end{aligned}\n$$"} :step/id #uuid "da58662e-c1cd-5da2-878b-9e28abdccc9d"} {:db/id #edb/ref 17592186489379 :step/content {:db/id #edb/ref 17592186055007 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0adde8b3-07d2-55b6-a1f0-3c38ee251bfc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-16u-4v" :db/id #edb/ref 17592186488494} {:answer/id #uuid "7c324be0-96e7-5ffe-bcfe-ef9337be7a83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-18u-4v" :db/id #edb/ref 17592186488717} {:answer/id #uuid "a12bce51-2478-5eb3-b82a-2dd61753bcce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16u-4v" :db/id #edb/ref 17592186488787} {:answer/id #uuid "c86e6225-f0f0-5ec3-9fed-7879c6d560c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18u-4v" :db/id #edb/ref 17592186488880} {:answer/id #uuid "f4d7958e-1aae-57c9-9588-d067a948ae50" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-16u+4v" :db/id #edb/ref 17592186488988}] :answer-field/correct {:db/id #edb/ref 17592186488717} :answer-field/id #uuid "8f10d8a0-402a-56dc-90f7-09efc71a379e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186051572}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "eba523b6-dd38-519f-9070-b818c12401b0" :question/math-academy-id "q-141873" :question/problem "$2u+(5u+v)\\cdot (-4)=$" :question/worked-solution "First, we distribute the $(-4)$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}\\begin{aligned}2u+(5u+v)\\cdot (-4) & = \\\\ 2u+5u\\cdot (-4)+v\\cdot (-4) & = \\\\ 2u+(-20u)+(-4v) & = \\\\ 2u-20u-4v & .\\end{aligned}\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n \n\n$$\n\\begin{aligned}2u-20u-4v & = \\\\ (2u-20u)-4v & = \\\\ -18u-4v & \\end{aligned}\n$$"} :step/id #uuid "f47ccfb1-eb71-5fb2-bcfe-bd3c04a130c5" :step/next {:db/id #edb/ref 17592186489381}} {:db/id #edb/ref 17592186489381 :step/content {:db/id #edb/ref 17592186489220 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ad97cff-9e2e-563f-b6a9-474cb218d7b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x+6y" :db/id #edb/ref 17592186488561} {:answer/id #uuid "3b3b0a0d-ced6-5f22-a4fb-24960d846e07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8x+8y" :db/id #edb/ref 17592186488593} {:answer/id #uuid "c4a42675-06f0-5aac-910b-a636d62f1f43" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6x+6y" :db/id #edb/ref 17592186488868} {:answer/id #uuid "f3da4469-9b3d-59cb-947a-65e2c706782e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6x+9y" :db/id #edb/ref 17592186488984} {:answer/id #uuid "f668a967-ab29-563f-b04a-57e4cb7a86bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5x+9y" :db/id #edb/ref 17592186488992}] :answer-field/correct {:db/id #edb/ref 17592186488868} :answer-field/id #uuid "a999e85d-466d-5b48-8784-0835d63fcc46" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489109}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "56c7326b-73aa-516e-8094-38a5a4c858fb" :question/math-academy-id "q-141910" :question/problem "$(-2)(3x+y)+8y=$" :question/worked-solution "First, we distribute the $(-2)$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}\\begin{aligned}(-2)(3x+y)+8y & = \\\\ (-2)\\cdot 3x+(-2)\\cdot y+8y & = \\\\ (-6x)+(-2y)+8y & = \\\\ -6x-2y+8y & \\end{aligned}\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}\\begin{aligned}-6x-2y+8y & = \\\\ -6x+(8y-2y) & = \\\\ -6x+6y & \\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "f954900d-db8e-5669-983f-61ddeb5299ad" :step/next {:db/id #edb/ref 17592186489368}}] :activity/title "Simplifying Linear Expressions Using the Distributive Law" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186488460}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186065281} :activity/id #uuid "5c56a3ff-c078-5460-97b4-4cf59ad749b8" :activity/scope {:db/id #edb/ref 17592186050719 :topic/id #uuid "61178d17-c292-5e1d-a08e-a6ce03bd5a13" :topic/math-academy-id 330} :activity/steps [{:db/id #edb/ref 17592186065281 :step/content {:db/id #edb/ref 17592186065416 :tutorial/content "Dividing with negative numbers follows similar rules as multiplying with negative numbers. \n\nFirst of all, a negative number divided by a positive number gives a negative number. We can picture this rule as\n\n$$\n\\begin{aligned}(-)\\,÷\\,(+)\\,=\\,(-).\\end{aligned}\n$$\n\nFor example, let's use this rule to find the value of $(-6) \\div 2.$\n\nHere, since we are dividing a negative number $\\color{red}(-6)$ by a positive number ${\\color{blue}(2)},$ the result is going to be negative:\n![](images/b6/b64108fa03fc286ddcd04ac4cd7a9d77c1672d0ced66ebb1953c97afa5488533.svg)\n\nNow, to compute the number that goes in the box, we divide $6$ by $2$ *without* any signs: $6 \\div 2 = 3.$ So, we get\n\n$$\n{\\color{red}(-6)} \\div {\\color{blue}2} = {\\color{red} -3 }.\n$$" :tutorial/id #uuid "b92ac2e4-b983-5fd5-bc18-7dfb821497f0" :tutorial/math-academy-id 8108 :tutorial/title "Introduction"} :step/id #uuid "39aa10e9-422a-5c1c-b5b2-de119dcca067" :step/math-academy-id 77819 :step/next {:db/id #edb/ref 17592186065282}} {:db/id #edb/ref 17592186065282 :step/content {:db/id #edb/ref 17592186064357 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063941 :question/id #uuid "5b4f3b5f-2f0b-5178-9055-cf83a9885920" :question/math-academy-id "e-12972"} :knowledge-point/id #uuid "b434d0d5-bd04-554b-888e-df84e3961839" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049349}] :knowledge-point/questions [{:db/id #edb/ref 17592186064489} {:db/id #edb/ref 17592186064564} {:db/id #edb/ref 17592186064764} {:db/id #edb/ref 17592186442926} {:db/id #edb/ref 17592186442927} {:db/id #edb/ref 17592186442928} {:db/id #edb/ref 17592186442933} {:db/id #edb/ref 17592186442937}] :knowledge-point/title "Dividing a Negative Number by a Positive Number"} :step/id #uuid "46d3cb51-86b4-59d6-8a39-eab709bb05a3" :step/math-academy-id 77820 :step/next {:db/id #edb/ref 17592186065283}} {:db/id #edb/ref 17592186065283 :step/content {:db/id #edb/ref 17592186065417 :tutorial/content "A positive number divided by a negative number is also a negative number. We can picture this rule as\n\n$$\n\\begin{aligned}(+)\\,÷\\,(-)\\,=\\,(-).\\end{aligned}\n$$\n\nFor instance, to find $8\\div (-2),$ we have to divide a positive number $\\color{blue}(8)$ by a negative one ${\\color{red}(-2)}.$ So the result will be negative:\n![](images/79/797eda7126fff569fccda2681c628f99f103057d7c5e23c1b65cb566b48ef203.svg)\n\nNow, to compute the number that goes in the box, we divide $8$ by $2$ without any signs: $8 \\div 2 = 4.$ So, we get\n\n$$\n{\\color{blue}8} \\div {\\color{red}(-2)} = {\\color{red}-4}.\n$$" :tutorial/id #uuid "67beb927-7da4-5576-8982-1a823c878691" :tutorial/math-academy-id 8109 :tutorial/title "The Quotient of a Positive and a Negative is a Negative"} :step/id #uuid "b2792086-a352-5ca3-b086-f381a58864aa" :step/math-academy-id 77824 :step/next {:db/id #edb/ref 17592186065284}} {:db/id #edb/ref 17592186065284 :step/content {:db/id #edb/ref 17592186064358 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063942 :question/id #uuid "166aaac7-bc88-577a-8e84-47347408e3c9" :question/math-academy-id "e-12973"} :knowledge-point/id #uuid "7de4234d-932f-537c-9eae-746e1711cccd" :knowledge-point/questions [{:db/id #edb/ref 17592186064490} {:db/id #edb/ref 17592186064551} {:db/id #edb/ref 17592186442924} {:db/id #edb/ref 17592186442925} {:db/id #edb/ref 17592186442929} {:db/id #edb/ref 17592186442934} {:db/id #edb/ref 17592186442938} {:db/id #edb/ref 17592186491118} {:db/id #edb/ref 17592186527167} {:db/id #edb/ref 17592186531588} {:db/id #edb/ref 17592186531618} {:db/id #edb/ref 17592186531629}] :knowledge-point/title "Dividing a Positive Number by a Negative Number"} :step/id #uuid "503ce197-02ae-5ae2-897a-80af7de15a2a" :step/math-academy-id 77825 :step/next {:db/id #edb/ref 17592186065285}} {:db/id #edb/ref 17592186065285 :step/content {:db/id #edb/ref 17592186065418 :tutorial/content "Finally, the third rule is that a negative number divided by a negative number is a positive number:\n\n$$\n\\begin{aligned}(-)\\,÷\\,(-)\\,=\\,(+)\\end{aligned}\n$$\n\nTo demonstrate, let's find $-12 \\div (-3).$ We have to divide a negative number $\\color{red}(-12)$ by another negative number ${\\color{red}(-3)}.$ So the result will be positive:\n![](images/d3/d31776de6ab95f8178d0bdd6e3b34cfa2f4fc0b987851dcace50aff1818936da.svg)\n\nNow, to compute the number that goes in the box, we divide $12$ by $3$ without any signs: $12 \\div 3 = 4.$ Therefore,  we get\n\n$$\n{\\color{red}(-12)} \\div {\\color{red}(-3)} = {\\color{blue}4}.\n$$" :tutorial/id #uuid "b1d3d95e-7953-5c5b-b97b-d4eb85e1f80d" :tutorial/math-academy-id 8111 :tutorial/title "The Quotient of a Negative and a Negative is a Positive"} :step/id #uuid "b129822d-f637-5611-9cad-e2f8b6aefca4" :step/math-academy-id 77828 :step/next {:db/id #edb/ref 17592186065286}} {:db/id #edb/ref 17592186065286 :step/content {:db/id #edb/ref 17592186064359 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063943 :question/id #uuid "e2005c9d-c0ff-5b8e-bc64-4e222fd19fdf" :question/math-academy-id "e-12976"} :knowledge-point/id #uuid "b85ef92b-d5fb-5927-aa68-60e72d0b3e72" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050287}] :knowledge-point/questions [{:db/id #edb/ref 17592186064491} {:db/id #edb/ref 17592186064549} {:db/id #edb/ref 17592186064763} {:db/id #edb/ref 17592186442930} {:db/id #edb/ref 17592186442931} {:db/id #edb/ref 17592186442932} {:db/id #edb/ref 17592186442935} {:db/id #edb/ref 17592186442936} {:db/id #edb/ref 17592186491216} {:db/id #edb/ref 17592186531617}] :knowledge-point/title "Dividing a Negative Number by a Negative Number"} :step/id #uuid "8ddc832d-59f9-5fa2-85e2-002f7b9c4ccc" :step/math-academy-id 77829}] :activity/title "Dividing With Negative Numbers" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064421}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186491250} :activity/id #uuid "c415186d-7a79-528f-ade9-bfd554821382" :activity/scope {:db/id #edb/ref 17592186050719 :topic/id #uuid "61178d17-c292-5e1d-a08e-a6ce03bd5a13" :topic/math-academy-id 330} :activity/steps [{:db/id #edb/ref 17592186491239 :step/content {:db/id #edb/ref 17592186064490 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9291dd81-8db7-572e-abb6-47ed16d95a66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\,\\frac{1}{6}" :db/id #edb/ref 17592186490808} {:answer/id #uuid "a20fd88b-a1ae-59ea-8d71-bf0e83f3c2c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\,\\frac{1}{6}" :db/id #edb/ref 17592186490843} {:answer/id #uuid "a820a307-a4eb-5ebe-b435-dac2bf7599a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\,\\frac{5}{6}" :db/id #edb/ref 17592186490848} {:answer/id #uuid "e515b3dc-e776-5382-bf68-34b85c10532d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,\\frac{5}{6}" :db/id #edb/ref 17592186490948} {:answer/id #uuid "f2562b5c-a5b7-583e-97c1-be81c5954f49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\,\\frac{5}{6}" :db/id #edb/ref 17592186490974}] :answer-field/correct {:db/id #edb/ref 17592186490808} :answer-field/id #uuid "7b7911da-da11-5f0a-8cf6-b9c959a6a7e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186061170}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ae2c2497-1704-5e15-bc0f-8e11eb0096e2" :question/math-academy-id "q-128420" :question/problem "Expressed as a mixed number, $19÷(-6)=$" :question/worked-solution "We have to divide a positive number $(19)$ by a negative one $(-6).$ So the result will be negative:\n\n$$\n19÷(-6)=-\\boxed{}\n$$\n\nNow, to compute the number that goes in the box, we divide $19$ by $-6$ without any signs: $19÷6=3\\,\\frac{1}{6}.$ Therefore,  we get\n\n$$\n19÷(