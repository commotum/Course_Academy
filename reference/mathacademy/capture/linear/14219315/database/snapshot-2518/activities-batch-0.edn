95e6ec2a-3bed-5c88-b4a1-9bcfd6f1f5dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186433067} {:answer/id #uuid "c088db7c-17d3-5a62-bc77-81a67fffb752" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186433071}] :answer-field/correct {:db/id #edb/ref 17592186433071} :answer-field/id #uuid "2d0b58c9-0b33-5eae-9645-c413c3c2079d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186433076}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "75341efd-b297-526b-aba4-58f021908c5b" :question/math-academy-id "q-75792" :question/problem "Compute the value of $0÷\\frac{1}{8}.$" :question/worked-solution "Zero divided by any number (other than zero) equals zero. Therefore, \n\n$$\n0÷\\frac{1}{8}=0.\n$$"} :step/id #uuid "bb1fd126-7794-5985-b55c-e3b72348c559" :step/next {:db/id #edb/ref 17592186433088}}] :activity/title "Multiplying and Dividing With Zero" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186433049}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186176625} :activity/id #uuid "a4ff07dc-a8f7-53b1-8ab9-7a78e691a8a6" :activity/scope {:db/id #edb/ref 17592186050204 :topic/id #uuid "3609f48c-4b74-5e7c-8832-d67903fa5696" :topic/math-academy-id 3552} :activity/steps [{:db/id #edb/ref 17592186176625 :step/content {:db/id #edb/ref 17592186176970 :tutorial/content "Let's calculate $(\\sqrt{100})^2$ by performing each operation one step at a time:\n\n$$\n(\\sqrt{\\color{blue}100})^2 = \\left(\\sqrt{{\\color{red}10}^2}\\right)^2 = ({\\color{red}10})^2 = {\\color{blue}100}\n$$\n\nNotice that the squaring the square root gives the number under the square root:\n\n$$\n\\left( \\sqrt{100} \\right)^2 = 100\n$$\n\nThis result holds in general for any non-negative number. If $\\color{blue}\\square$ is any positive number or zero, then\n\n$$\n(\\sqrt{\\color{blue}\\square})^2 = {\\color{blue}\\square}\\,.\n$$\n\nThe square and the square root cancel each other out, and we're left with the number that we started with.\n\n![](images/1f/1fa29ca192dc3fb99f4180c300aa3120064e3682361d175a698b1d457a569ba0.png)" :tutorial/id #uuid "871b272d-6a05-5ad2-b443-785a6abbd186" :tutorial/math-academy-id 3093 :tutorial/title "Introduction"} :step/id #uuid "e1e25251-ada4-572c-af12-8dec4f2cc93b" :step/math-academy-id 16791 :step/next {:db/id #edb/ref 17592186176626}} {:db/id #edb/ref 17592186176626 :step/content {:db/id #edb/ref 17592186175916 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175774 :question/id #uuid "a4796dd0-e8ee-5ffe-b96c-6646c209d4be" :question/math-academy-id "e-4609"} :knowledge-point/id #uuid "5a937bb0-da50-5be0-a007-dce431a84282" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050358}] :knowledge-point/questions [{:db/id #edb/ref 17592186176484} {:db/id #edb/ref 17592186176489} {:db/id #edb/ref 17592186447326} {:db/id #edb/ref 17592186447328}] :knowledge-point/title "Finding the Square of a Square Root"} :step/id #uuid "8bcb8880-f2b7-5129-b867-7a66c1a6f8d9" :step/math-academy-id 16792 :step/next {:db/id #edb/ref 17592186176627}} {:db/id #edb/ref 17592186176627 :step/content {:db/id #edb/ref 17592186176971 :tutorial/content "We must be careful when taking the square root of a negative number that's been squared.\n\nFor example, $\\sqrt{(-9)^2}$ is *not* equal to $-9!$ We can write this using a **not equal to** symbol $\\neq$ as\n\n$$\n\\sqrt{(-9)^2}  \\neq -9.\n$$\n\nThis is because the square root of a number can *only* be positive or zero, never negative.\nLet's work it out the long way:\n\n$$\n\\begin{aligned}\\sqrt{(-9)^{2}} & = \\\\ \\sqrt{(-9)\\cdot (-9)} & = \\\\ \\sqrt{81} & = \\\\ \\sqrt{{9}^{2}} & = \\\\ 9\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\sqrt{(-9)^2}=\\sqrt{9^2} = 9.\n$$\n\nFor any positive perfect square, we always have exactly two numbers whose squares equal that number. Here, we have\n\n$$\n9^2=81\\quad \\textrm{and} \\quad (-9)^2=81.\n$$\n\nBut *by definition* the square root is always *positive* (or zero) and *cannot* be negative. So here, $\\sqrt{81}=+9,$ and for any non-negative $\\color{blue}\\square$ we get\n\n$$\n\\sqrt{\\color{blue}\\square} \\geq 0.\n$$" :tutorial/id #uuid "27f63bb3-bf90-584e-b96c-d999c482f4e4" :tutorial/math-academy-id 3094 :tutorial/title "The Square Root of a Negative Number Squared"} :step/id #uuid "b53578db-d74c-51c3-a032-b84c8468af3c" :step/math-academy-id 16793 :step/next {:db/id #edb/ref 17592186176628}} {:db/id #edb/ref 17592186176628 :step/content {:db/id #edb/ref 17592186175917 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175775 :question/id #uuid "0e96044b-b1f8-5d33-85ec-6a6a7f1fec6c" :question/math-academy-id "e-4610"} :knowledge-point/id #uuid "0f524f08-137f-56e6-8a6d-a45c3dae2635" :knowledge-point/questions [{:db/id #edb/ref 17592186176482} {:db/id #edb/ref 17592186176483} {:db/id #edb/ref 17592186447327} {:db/id #edb/ref 17592186447329} {:db/id #edb/ref 17592186482577} {:db/id #edb/ref 17592186482600}] :knowledge-point/title "Finding the Square Root of a Negative Number Squared"} :step/id #uuid "b246c6a3-8aeb-5a46-904f-bf555b6a6441" :step/math-academy-id 16794}] :activity/title "Squaring a Square Root" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186176103}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186482623} :activity/id #uuid "5b7f0e4f-3348-59d7-a1d5-4c76f7ddaa47" :activity/scope {:db/id #edb/ref 17592186050204 :topic/id #uuid "3609f48c-4b74-5e7c-8832-d67903fa5696" :topic/math-academy-id 3552} :activity/steps [{:db/id #edb/ref 17592186482623 :step/content {:db/id #edb/ref 17592186176484 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a024b6e6-f598-5bfb-9c5b-9891ec143e43" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186175043} {:answer/id #uuid "ad93111b-ae82-568b-baa1-a2eb0e8edcfe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186175044} {:answer/id #uuid "ef209fb7-1988-5052-bb3c-b7bb08c2e94a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186175045} {:answer/id #uuid "05007abd-c0fb-50e9-936d-298b4ff76f0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-64" :db/id #edb/ref 17592186175046} {:answer/id #uuid "7d39ed9e-f884-5860-88d1-2fe2375e50b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "64" :db/id #edb/ref 17592186175047}] :answer-field/correct {:db/id #edb/ref 17592186175047} :answer-field/id #uuid "325a11df-fa0e-5ef9-9315-be877024bfaa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186175042}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4cf96200-b795-57c8-ab21-303d7b2f1640" :question/math-academy-id "q-40878" :question/problem "What is $(\\sqrt{64})^{2}?$" :question/worked-solution "The number in the square root is non-negative, so the square and the square root cancel each other out.\n\nTherefore, we have\n\n$$\n(\\sqrt{64})^{2}=64.\n$$"} :step/id #uuid "10c71a29-7215-5eb1-a413-a092dcb8ff4c" :step/next {:db/id #edb/ref 17592186482643}} {:db/id #edb/ref 17592186482643 :step/content {:db/id #edb/ref 17592186482577 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0561decb-7e57-5d8d-98fc-79752f342f51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-36" :db/id #edb/ref 17592186481781} {:answer/id #uuid "445ae046-f9c4-5f28-92c9-c8ffe97025d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186481944} {:answer/id #uuid "dfb477dd-f26c-5b3f-8833-6f12839a60d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36" :db/id #edb/ref 17592186482304} {:answer/id #uuid "e2a559a8-743c-5e88-8b4d-