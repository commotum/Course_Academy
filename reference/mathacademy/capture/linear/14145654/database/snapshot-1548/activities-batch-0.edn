#{[{:activity/first-step {:db/id #edb/ref 17592186139533} :activity/id #uuid "f6fac74e-e2d7-5db4-a32b-99183dac9daf" :activity/scope {:db/id #edb/ref 17592186049688 :topic/id #uuid "0b1376ba-3439-5dd7-a72c-5ade3c34e879" :topic/math-academy-id 2281} :activity/steps [{:db/id #edb/ref 17592186139533 :step/content {:db/id #edb/ref 17592186139666 :tutorial/content "The **absolute value** of a number is its *distance from zero* when viewed on a number line.\n\nDistances are never negative. Therefore, the absolute value of a number is always positive or zero.\n\nLet's consider the number $-5$ and its position on a number line, shown below.\n\n![](images/30/3072e47752dc69d38f997e926092f60c24966031d0484241fa9c1133d89d1c56.png)\n\nThe **distance** between $-5$ and zero equals $5$ because $-5$ is five steps away from zero.\n\n![](images/dd/dd155b158a3457eb08a95885461d3ffbd36dd852e1b6c4e9dbda04efed749280.png)\n\nTherefore, *the absolute value of* $-5$ *equals* $5$. We write this as follows:\n\n$$\n\\mid \\, {-5} \\, \\mid = 5\n$$" :tutorial/id #uuid "60694119-254a-584f-b1aa-d0a0d8aeced2" :tutorial/math-academy-id 8159 :tutorial/title "Introduction"} :step/id #uuid "5023fb7a-0b02-5916-9015-3ae01cfc7dda" :step/math-academy-id 81266 :step/next {:db/id #edb/ref 17592186139534}} {:db/id #edb/ref 17592186139534 :step/content {:db/id #edb/ref 17592186139668 :tutorial/content "There is a fast way to find the absolute value of a number:\n\n- The absolute value of a positive number is equal to itself. For example,\n$\\mid 8 \\mid = 8$.\n- To find the absolute value of a negative number, we drop the negative sign. For instance,\n$\\mid {-8} \\mid = 8$." :tutorial/id #uuid "30b514af-50d6-5cf2-9bec-168ccf25be5e" :tutorial/math-academy-id 8367 :tutorial/title "A Fast Way of Finding the Absolute Value"} :step/id #uuid "f16163e2-e8ad-55d9-ab45-85920f3debf6" :step/math-academy-id 81267 :step/next {:db/id #edb/ref 17592186139535}} {:db/id #edb/ref 17592186139535 :step/content {:db/id #edb/ref 17592186138543 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138080 :question/id #uuid "651f6d3a-6def-5064-b5c9-872d02a468fd" :question/math-academy-id "e-13045"} :knowledge-point/id #uuid "b113dd89-f612-5771-a186-27bfc984c3c0" :knowledge-point/questions [{:db/id #edb/ref 17592186138669} {:db/id #edb/ref 17592186139146}] :knowledge-point/title "Finding the Absolute Value of a Positive Number"} :step/id #uuid "439c7674-2599-57c2-ba40-61a36bdde131" :step/math-academy-id 81268 :step/next {:db/id #edb/ref 17592186139536}} {:db/id #edb/ref 17592186139536 :step/content {:db/id #edb/ref 17592186138544 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138081 :question/id #uuid "68b6b6aa-1346-5aaa-a909-fbd43513ba04" :question/math-academy-id "e-13047"} :knowledge-point/id #uuid "3391981c-d61d-509c-a8f3-db9598494e08" :knowledge-point/questions [{:db/id #edb/ref 17592186138670} {:db/id #edb/ref 17592186139148} {:db/id #edb/ref 17592186424822}] :knowledge-point/title "Finding the Absolute Value of a Negative Number"} :step/id #uuid "1242c5ef-8b03-5424-a7c3-063f61399da6" :step/math-academy-id 81272 :step/next {:db/id #edb/ref 17592186139537}} {:db/id #edb/ref 17592186139537 :step/content {:db/id #edb/ref 17592186138545 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138082 :question/id #uuid "f8cde1b6-791d-5b26-be22-59d4cd59f7bf" :question/math-academy-id "e-13049"} :knowledge-point/id #uuid "5be86966-3bdb-565f-b0bc-9802ae22e7de" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049429}] :knowledge-point/questions [{:db/id #edb/ref 17592186139149} {:db/id #edb/ref 17592186139150}] :knowledge-point/title "Finding a Number Given Its Absolute Value and Position on a Number Line"} :step/id #uuid "16286879-9e35-508e-8e51-962ff4f3364b" :step/math-academy-id 81276}] :activity/title "Absolute Value" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186138603}]}
