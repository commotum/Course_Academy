#{[{:db/id #edb/ref 17592186138080 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138543 :knowledge-point/id #uuid "b113dd89-f612-5771-a186-27bfc984c3c0" :knowledge-point/title "Finding the Absolute Value of a Positive Number"}] :question/id #uuid "651f6d3a-6def-5064-b5c9-872d02a468fd" :question/math-academy-id "e-13045" :question/problem "What is the value of $\\mid 4\\!\\mid \\,$?" :question/worked-solution "The absolute value of a positive number equals the number:\n\n$$\n\\begin{aligned} \\mid 4\\!\\mid \\, =4 \\end{aligned}\n$$\n\nThe absolute value of a number gives the distance between the number and zero on a number line.\n\n![](images/4d/4dc8f8174b1a226b3cfeaedc9e909adce1171c9daca1833d80ca09b286115755.png)"}] [{:db/id #edb/ref 17592186138081 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138544 :knowledge-point/id #uuid "3391981c-d61d-509c-a8f3-db9598494e08" :knowledge-point/title "Finding the Absolute Value of a Negative Number"}] :question/id #uuid "68b6b6aa-1346-5aaa-a909-fbd43513ba04" :question/math-academy-id "e-13047" :question/problem "Find $\\mid {-2} \\mid$." :question/worked-solution "To find the absolute value of $-2$, we simply drop the negative sign:\n\n$$\n\\mid-2\\!\\mid=2\n$$\n\nThe absolute value of a number gives the distance between the number and zero on a number line.\n\n![](images/79/79429acd5f23eaca53c510a515096e419cbbf1f685868bfaa1bc8ee41498adce.png)"}] [{:db/id #edb/ref 17592186138082 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138545 :knowledge-point/id #uuid "5be86966-3bdb-565f-b0bc-9802ae22e7de" :knowledge-point/title "Finding a Number Given Its Absolute Value and Position on a Number Line"}] :question/id #uuid "f8cde1b6-791d-5b26-be22-59d4cd59f7bf" :question/math-academy-id "e-13049" :question/problem "The point shown below represents a number on a number line. The absolute value of this number is $4$. What is the number?\n\n![](images/0e/0e8aaf68af47ecf3eadbd492af662273a68400bed20d3a5b214ec118abb6a2df.png)" :question/worked-solution "The number is *negative* because it is to the *left* of zero.\n\nThe absolute value of the number is $4$, so the distance between that number and zero on a number line is $4$.\n\nThe negative number at a distance of $4$ from zero is $-4$, so the number is $-4$.\n\n![](images/b0/b0d99997e27059b23342de79fc887c85b56991e1312f430f80fcf39311479ad2.png)"}] [{:db/id #edb/ref 17592186139150 :knowledge-point/_questions [{:db/id #edb/ref 17592186138545 :knowledge-point/id #uuid "5be86966-3bdb-565f-b0bc-9802ae22e7de" :knowledge-point/title "Finding a Number Given Its Absolute Value and Position on a Number Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0f9d44d-3351-5b34-bb98-93f4a95b2369" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186137849} {:answer/id #uuid "d2a9f10e-a8f5-5c07-8c07-2e86935fae91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186137850} {:answer/id #uuid "dbacb998-19ce-51b9-b3c2-c8b424347053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186137851} {:answer/id #uuid "093a8d96-d976-5232-a022-63820a66c5b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186137852} {:answer/id #uuid "7d523b6f-d95c-5522-8c76-816afce93461" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186137853}] :answer-field/id #uuid "457f7712-1c44-50a0-ab3c-20e20b2471f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186137848}] :question/id #uuid "127a457b-84c0-5c21-84ff-8f71fbbe2a3d" :question/math-academy-id "q-61631" :question/problem "![](images/46/46c110dc92d254443f7046536f9384fc666d581