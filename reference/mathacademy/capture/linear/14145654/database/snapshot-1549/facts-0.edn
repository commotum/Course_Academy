6-9015-3ae01cfc7dda" #edb/ref 17592186045417] [17592186139533 #edb/ref 1063 #edb/ref 17592186139666 #edb/ref 17592186045417] [17592186139534 #edb/ref 1058 #edb/ref 17592186139535 #edb/ref 17592186045417] [17592186139534 #edb/ref 1061 81267 #edb/ref 17592186045417] [17592186139534 #edb/ref 1062 #uuid "f16163e2-e8ad-55d9-ab45-85920f3debf6" #edb/ref 17592186045417] [17592186139534 #edb/ref 1063 #edb/ref 17592186139668 #edb/ref 17592186045417] [17592186139535 #edb/ref 1058 #edb/ref 17592186139536 #edb/ref 17592186045417] [17592186139535 #edb/ref 1061 81268 #edb/ref 17592186045417] [17592186139535 #edb/ref 1062 #uuid "439c7674-2599-57c2-ba40-61a36bdde131" #edb/ref 17592186045417] [17592186139535 #edb/ref 1063 #edb/ref 17592186138543 #edb/ref 17592186045417] [17592186139536 #edb/ref 1058 #edb/ref 17592186139537 #edb/ref 17592186045417] [17592186139536 #edb/ref 1061 81272 #edb/ref 17592186045417] [17592186139536 #edb/ref 1062 #uuid "1242c5ef-8b03-5424-a7c3-063f61399da6" #edb/ref 17592186045417] [17592186139536 #edb/ref 1063 #edb/ref 17592186138544 #edb/ref 17592186045417] [17592186139537 #edb/ref 1061 81276 #edb/ref 17592186045417] [17592186139537 #edb/ref 1062 #uuid "16286879-9e35-508e-8e51-962ff4f3364b" #edb/ref 17592186045417] [17592186139537 #edb/ref 1063 #edb/ref 17592186138545 #edb/ref 17592186045417] [17592186139666 #edb/ref 1064 "The **absolute value** of a number is its *distance from zero* when viewed on a number line. \n\nDistances are never negative. Therefore, the absolute value of a number is always positive or zero.\n\nLet's consider the number $-5$ and its position on a number line, shown below.\n\n![](images/30/3072e47752dc69d38f997e926092f60c24966031d0484241fa9c1133d89d1c56.png)\n\n \n\nThe **distance** between $-5$ and zero equals $5$ because $-5$ is five steps away from zero. \n\n![](images/dd/dd155b158a3457eb08a95885461d3ffbd36dd852e1b6c4e9dbda04efed749280.png)\n\n \n\nTherefore, *the absolute value of * $-5$ *equals* $5.$ We write this as follows:\n\n$$\n| \\, {-5}  \\, |  = 5\n$$" #edb/ref 17592186045417] [17592186139666 #edb/ref 1065 8159 #edb/ref 17592186045417] [17592186139666 #edb/ref 1066 #uuid "60694119-254a-584f-b1aa-d0a0d8aeced2" #edb/ref 17592186045417] [17592186139666 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186139668 #edb/ref 1064 "There is a fast way to find the absolute value of a number:\n\n- The absolute value of a positive number is equal to itself. For example, \n\n$$\n|8| = 8 .\n$$\n\n- To find the absolute value of a negative number, we drop the negative sign. For instance,\n\n$$\n| {-8} | = 8.\n$$" #edb/ref 17592186045417] [17592186139668 #edb/ref 1065 8367 #edb/ref 17592186045417] [17592186139668 #edb/ref 1066 #uuid "30b514af-50d6-5cf2-9bec-168ccf25be5e" #edb/ref 17592186045417] [17592186139668 #edb/ref 1067 "A Fast Way of Finding the Absolute Value" #edb/ref 17592186045417] [17592186441443 #edb/ref 1080 "-3" #edb/ref 17592186045417] [17592186441443 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186441443 #edb/ref 1083 #uuid "070fb7a1-427d-52b6-b565-7115b5eea26e" #edb/ref 17592186045417] [17592186441444 #edb/ref 1080 "-5" #edb/ref 17592186045417] [17592186441444 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186441444 #edb/ref 1083 #uuid "091e295d-dbc2-5710-9d60-a2ee449b0436" #edb/ref 17592186045417] [17592186441445 #edb/ref 1080 "-5" #edb/ref 17592186045417] [17592186441445 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186441445 #edb/ref 1083 #uuid "2252249a-a2ef-500a-86d4-4161de85035c" #edb/ref 17592186045417] [17592186441446 #edb/ref 1080 "-6" #edb/ref 17592186045417] [17592186441446 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186441446 #edb/ref 1083 #uuid "297a0a0b-51bd-5b71-b32c-063b12ebae9f" #edb/ref 17592186045417] [17592186441447 #edb/ref 1080 "-3" #edb/ref 17592186045417] [17592186441447 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186441447 #edb/re