#{[{:activity/first-step {:db/id #edb/ref 17592186069840} :activity/id #uuid "34bc121a-11b5-50d2-b626-7f80c9f81c46" :activity/scope {:db/id #edb/ref 17592186048157 :topic/id #uuid "83bad3df-40e8-5e95-ad95-39947df5a5ac" :topic/math-academy-id 394} :activity/steps [{:db/id #edb/ref 17592186069840 :step/content {:db/id #edb/ref 17592186069945 :tutorial/content "Suppose we have a quadratic equation like\n$x^2-25 = 0$.\nWe can solve this equation using the **difference of squares** formula, shown below:\n\n$$\n{\\color{red}a}^2 - {\\color{blue}b}^2 = ({\\color{red}a}+{\\color{blue}b})({\\color{red}a}-{\\color{blue}b})\n$$\n\nUsing the difference of squares formula, we can factor the left-hand side of our quadratic equation:\n\n$$\n\\begin{aligned}\nx^{2} - 25 &= 0 \\\\\nx^{2} - 5^{2} &= 0 \\\\\n(x + 5)(x - 5) &= 0\n\\end{aligned}\n$$\n\nFinally, we apply the zero product rule to get\n\n$$\nx+5=0 \\qquad\\text{or}\\qquad x-5=0\n$$\n\nwhich in turn gives\n\n$$\nx=-5 \\qquad\\text{or}\\qquad x=5\n$$\n\nTherefore, the solutions are $x=-5,5$. We can write this even more concisely as $x=\\pm 5$.\n\n**Note:** We could have solved the equation $x^2-25=0$ using the square root method. However, the factoring method introduced in this lesson will become very useful later when we move on to more complicated quadratic equations. Make sure that you learn it!" :tutorial/id #uuid "0e80849d-fec5-5167-8b39-902cd2d825ef" :tutorial/math-academy-id 1623 :tutorial/title "Introduction"} :step/id #uuid "44b39091-c3ce-5da7-935a-b6a8e7f88bf6" :step/math-academy-id 460445 :step/next {:db/id #edb/ref 17592186069841}} {:db/id #edb/ref 17592186069841 :step/content {:db/id #edb/ref 17592186068877 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068484 :question/id #uuid "8a5c740c-4719-5ebc-a5e3-0b82a2450521" :question/math-academy-id "e-1413"} :knowledge-point/id #uuid "50a815eb-f3d9-5ac7-bf15-2e28894e8910" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048928} {:db/id #edb/ref 17592186050845}] :knowledge-point/questions [{:db/id #edb/ref 17592186069142} {:db/id #edb/ref 17592186069143} {:db/id #edb/ref 17592186069529}] :knowledge-point/title "Solving Perfect Square Quadratic Equations"} :step/id #uuid "387068d5-e460-551c-9a0f-ef1602e7f7f9" :step/math-academy-id 460446 :step/next {:db/id #edb/ref 17592186069842}} {:db/id #edb/ref 17592186069842 :step/content {:db/id #edb/ref 17592186068878 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068485 :question/id #uuid "74c951a8-5bd6-5296-af9e-4f7a5f4008c4" :question/math-academy-id "e-1414"} :knowledge-point/id #uuid "3af5fb92-f8bf-5cda-94b7-72d8ad15fc79" :knowledge-point/questions [{:db/id #edb/ref 17592186069035} {:db/id #edb/ref 17592186069144} {:db/id #edb/ref 17592186069145}] :knowledge-point/title "Solving Perfect Square Quadratic Equations With Leading Coefficients"} :step/id #uuid "7e0d8a37-ec5c-5b5c-a24c-b05472a5add4" :step/math-academy-id 460450 :step/next {:db/id #edb/ref 17592186069843}} {:db/id #edb/ref 17592186069843 :step/content {:db/id #edb/ref 17592186068879 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068488 :question/id #uuid "be3c2628-847c-5b00-a7ea-7881c8805aa8" :question/math-academy-id "e-1416"} :knowledge-point/id #uuid "70100cca-afbd-5fc2-83ce-760342a03364" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048524}] :knowledge-point/questions [{:db/id #edb/ref 17592186069146} {:db/id #edb/ref 17592186069168} {:db/id #edb/ref 17592186069185}] :knowledge-point/title "Solving Perfect Square Quadratic Equations by Reorganizing and Factoring"} :step/id #uuid "393a0e1c-9694-5613-967a-4569b3f7a14f" :step/math-academy-id 460454}] :activity/title "Solving Quadratic Equations Using a Difference of Squares" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068940}]}
