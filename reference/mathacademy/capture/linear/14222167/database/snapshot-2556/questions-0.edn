#{[{:db/id #edb/ref 17592186534997 :knowledge-point/_questions [{:db/id #edb/ref 17592186068878 :knowledge-point/id #uuid "3af5fb92-f8bf-5cda-94b7-72d8ad15fc79" :knowledge-point/title "Solving Perfect Square Quadratic Equations With Leading Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34c8611d-f4d0-5fc3-bc5b-7bb9b1dcfd80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\pm \\frac{9}{4}" :db/id #edb/ref 17592186534365} {:answer/id #uuid "6810cf2e-dde9-5c88-ba30-9bf1db5e3988" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{2}{9}" :db/id #edb/ref 17592186534475} {:answer/id #uuid "7e5080fb-4356-5e0d-810b-29ca0123aff1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\pm \\frac{9}{2}" :db/id #edb/ref 17592186534538} {:answer/id #uuid "c793206a-9ed2-5ff6-90f1-25919555ed3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\pm \\frac{81}{16}" :db/id #edb/ref 17592186534713} {:answer/id #uuid "d7fe1427-aadb-56ed-9930-60e09e59d9b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{81}{16}" :db/id #edb/ref 17592186534753}] :answer-field/correct {:answer/id #uuid "34c8611d-f4d0-5fc3-bc5b-7bb9b1dcfd80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\pm \\frac{9}{4}" :db/id #edb/ref 17592186534365} :answer-field/id #uuid "ced7671a-bc8b-5661-8f1a-fdc445d654be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534945}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "36228bc3-c8df-58ee-9fb1-b8814e29ddd8" :question/math-academy-id "q-111997" :question/problem "Use the difference of squares method to solve the equation $16{y}^{2}-81=0.$" :question/worked-solution "Using the difference of squares formula, we factor the left-hand side of our quadratic equation:\n\n$$\n\\begin{aligned}16{y}^{2}-81 & =0 \\\\ (4y)^{2}-(9)^{2} & =0 \\\\ (4y-9)(4y+9) & =0\\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\n4y-9=0\\,\\text{or}\\,4y+9=0.\n$$\n\nThen, we solve each equation separately:\n\n$$\n\\begin{aligned}4y-9 & =0 & \\, & \\, & 4y+9 & =0 \\\\ 4y & =9 & \\, & \\, & 4y & =-9 \\\\ y & =\\frac{9}{4} & \\, & \\, & y & =-\\frac{9}{4}\\end{aligned}\n$$\n\nTherefore, the solutions are $y=-\\frac{9}{4},\\frac{9}{4}.$ We can write this even more concisely as $y=\\pm \\frac{9}{4}.$"}] [{:db/id #edb/ref 17592186535085 :knowledge-point/_questions [{:db/id #edb/ref 17592186068879 :knowledge-point/id #uuid "70100cca-afbd-5fc2-83ce-760342a03364" :knowledge-point/title "Solving Perfect Square Quadratic Equations by Reorganizing and Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d8327b6-7b01-5a19-936b-ca09e8613a7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-\\frac{5}{2}" :db/id #edb/ref 17592186534382} {:answer/id #uuid "7d1a02f4-ee95-57b6-97e6-2580b8e0c2e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=0,\\frac{5}{2}" :db/id #edb/ref 17592186534534} {:answer/id #uuid "8de39a43-8ede-5187-ba08-b187507759ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=\\pm \\frac{5}{2}" :db/id #edb/ref 17592186534572} {:answer/id #uuid "d6d3906e-8813-5496-bc23-8f6231b7e268" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=2,5" :db/id #edb/ref 17592186534751} {:answer/id #uuid "ee107525-6275-5cbd-ab75-f56bf4255a19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=\\pm \\frac{2}{5}" :db/id #edb/ref 17592186534794}] :answer-field/correct {:answer/id #uuid "8de39a43-8ede-5187-ba08-b187507759ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=\\pm \\frac{5}{2}" :db/id #edb/ref 17592186534572} :answer-field/id #uuid "c9e8053f-1d19-507b-ae24-2f03876f5694" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534942}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f49a62d5-679a-524a-aa83-c1365bd71520" :question/math-academy-id "q-12786" :question/problem "Use the difference of squares method to solve the equation $p$ is $4{p}^{2}=25.$" :question/worked-solution "First, we move all of the terms to the left-hand side and collect the like terms:\n\n$$\n\\begin{aligned}4{p}^{2} & =25 \\\\ 4{p}^{2}-25 & =0\\end{aligned}\n$$\n\nNow, using the difference of squares formula, we factor the left-hand side of our quadratic equation:\n\n$$\n\\begin{aligned}4{p}^{2}-25 & =0 \\\\ (2p)^{2}-{5}^{2} & =0 \\\\ (2p-5)(2p+5) & =0\\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\n2p-5=0\\,\\text{or}\\,2p+5=0.\n$$\n\nThen, we solve each equation separately:\n\n$$\n\\begin{aligned}2p-5 & =0 & \\, & \\, & 2p+5 & =0 \\\\ 2p & =5 & \\, & \\, & 2p & =-5 \\\\ p & =\\frac{5}{2} & \\, & \\, & p & =-\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the solutions are $p=-\\frac{5}{2},\\frac{5}{2}.$ We can write this even more concisely as $p=\\pm \\frac{5}{2}.$"}] [{:db/id #edb/ref 17592186535021 :knowledge-point/_questions [{:db/id #edb/ref 17592186068879 :knowledge-point/id #uuid "70100cca-afbd-5fc2-83ce-760342a03364" :knowledge-point/title "Solving Perfect Square Quadratic Equations by Reorganizing and Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7363154c-84f1-50eb-a664-4c273bbb58c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{\\sqrt{10}}{7}" :db/id #edb/ref 17592186534511} {:answer/id #uuid "8ec6ff9a-236c-5222-9a36-a98ddc2fec27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{7}{10}" :db/id #edb/ref 17592186534577} {:answer/id #uuid "b911aa7c-d630-5d40-a422-58c6b53d97f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\sqrt{\\frac{7}{10}}" :db/id #edb/ref 17592186534678} {:answer/id #uuid "bcde4af1-a530-531b-be8b-3a0aa122b238" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{\\sqrt{7}}{10}" :db/id #edb/ref 17592186534687} {:answer/id #uuid "ccd2a13c-9442-5d35-a48b-3bbad053d7bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{10}{7}" :db/id #edb/ref 17592186534722}] :answer-field/correct {:answer/id #uuid "bcde4af1-a530-531b-be8b-3a0aa122b238" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{\\sqrt{7}}{10}" :db/id #edb/ref 17592186534687} :answer-field/id #uuid "ab8d9acb-6fc3-559a-a240-a008f18351b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534928}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6bcd8b40-daaf-5baf-a297-367e7c76cde5" :question/math-academy-id "q-44216" :question/problem "Use the difference of squares method to solve the equation $100{x}^{2}=7.$" :question/worked-solution "First, we move all of the terms to the left-hand side and collect the like terms:\n\n$$\n\\begin{aligned}100{x}^{2} & =7 \\\\ 100{x}^{2}-7 & =0\\end{aligned}\n$$\n\nNow, using the difference of squares formula, we factor the left-hand side of our quadratic equation:\n\n$$\n\\begin{aligned}100{x}^{2}-7 & =0 \\\\ (10x)^{2}-{(\\sqrt{7})}^{2} & =0 \\\\ (10x-\\sqrt{7})(10x+\\sqrt{7}) & =0\\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\n10x-\\sqrt{7}=0\\,\\text{or}\\,10x+\\sqrt{7}=0.\n$$\n\nThen, we solve each equation separately:\n\n$$\n\\begin{aligned}10x-\\sqrt{7} & =0 & \\, & \\, & 10x+\\sqrt{7} & =0 \\\\ 10x & =\\sqrt{7} & \\, & \\, & 10x & =-\\sqrt{7} \\\\ x & =\\frac{\\sqrt{7}}{10} & \\, & \\, & x & =-\\frac{\\sqrt{7}}{10}\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-\\frac{\\sqrt{7}}{10},\\frac{\\sqrt{7}}{10}.$ We can write this even more concisely as $x=\\pm \\frac{\\sqrt{7}}{10}.$"}]}
