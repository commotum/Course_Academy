#uuid "ecd4ae46-c2af-5662-9274-af388364381f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 0" :db/id #edb/ref 17592186563475}] :answer-field/correct {:answer/id #uuid "92382c27-92bc-5dd2-b684-531a54f35ad5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>0" :db/id #edb/ref 17592186563272} :answer-field/id #uuid "83ddd1a9-0fe9-5c63-8c81-7a18c730d0ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563584}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "db1e03ac-5baa-5855-b6ca-f2c610df9446" :question/math-academy-id "q-156700" :question/problem "What's the domain of $y={log}_{8}⁡x?$" :question/worked-solution "Let's recall the graph of $y={log}_{8}⁡x.$\n\n![](images/8e/8e38a8edb560a0ddaa2e7802048ea0285e7bf3e72325de0a48f2672d9e81112c.png)\n\nThe domain of $y={log}_{8}⁡x$ is $x\\in (0,\\infty )$ and the range is $y\\in (-\\infty ,\\infty ).$\n\nTherefore, the correct answer is $x>0.$"}] [{:db/id #edb/ref 17592186233518 :knowledge-point/_questions [{:db/id #edb/ref 17592186110679 :knowledge-point/id #uuid "06ede1c9-b17d-504b-86a8-9284f7ded093" :knowledge-point/title "Finding the Zeros and Asymptotes of a Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14c52374-9b9f-5ea2-9b1d-640924d6082b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no horizontal asymptotes." :db/id #edb/ref 17592186562989} {:answer/id #uuid "44521491-c131-5639-a63c-726e10f92842" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186563098} {:answer/id #uuid "5c6d8c85-9923-5fdb-8597-d5d5d1259719" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-6" :db/id #edb/ref 17592186563154} {:answer/id #uuid "7569d322-3718-5d60-86d6-93dea8795fd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6" :db/id #edb/ref 17592186563204} {:answer/id #uuid "a4afd188-4d20-517e-a47b-c6882d781b67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186563318}] :answer-field/correct {:answer/id #uuid "14c52374-9b9f-5ea2-9b1d-640924d6082b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no horizontal asymptotes." :db/id #edb/ref 17592186562989} :answer-field/id #uuid "37ad94da-747c-5f20-8c1e-e2c0668e7607" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563553}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "58b2d6c3-6089-5685-8952-ba465d3a1547" :question/math-academy-id "q-156741" :question/problem "Which of the following is a horizontal asymptote of $y={log}_{6}⁡x?$" :question/worked-solution "Let's recall the graph of $y={log}_{6}⁡x.$\n\n![](images/41/4177d9520b3758b29926eba7a7a74ed4c508d861e3c343f46c372ec79500fc9d.png)\n\nFrom the graph, we note that for $x>1$, the graph grows very slowly as we increase $x.$ \n\nWe say that $y\\to \\infty $ (slowly) as $x\\to \\infty .$\n\nTherefore, there are no horizontal asymptotes."}] [{:db/id #edb/ref 17592186563715 :knowledge-point/_questions [{:db/id #edb/ref 17592186110678 :knowledge-point/id #uuid "8f1fce29-a071-5a86-8a5e-0e7093558d0f" :knowledge-point/title "Identifying True Statements Regarding Logarithmic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62e95736-ac92-5898-8904-f57247321448" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186563173} {:answer/id #uuid "834c2010-d5e2-594b-8783-23e8ef44ba8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186563238} {:answer/id #uuid "c5b8c9e5-0db3-58d3-ac01-f00cd2950bda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186563380} {:answer/id #uuid "eff2370c-3b33-5e79-a285-16c3e0abb4ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186563480} {:answer/id #uuid "f270d552-6c79-5d29-8e6a-1213fad5b8b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186563489}] :answer-field/correct {:answer/id #uuid "62e95736-ac92-5898-8904-f57247321448" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186563173} :answer-field/id #uuid "c42bbbe5-1f49-507b-a85b-15a0a5e80a99" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563620}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "96d6c320-22a1-578b-bc1b-575bf1a1c004" :question/math-academy-id "q-156742" :question/problem "Which of the following statements are true regarding the function $y={log}_{8}⁡x?$\n\nI. The domain is $x\\ge 0$\n\nII. It has no horizontal asymptotes\n\nIII. It passes through the point $(64,2)$" :question/worked-solution "Let's plot the graph of $y={log}_{8}⁡x.$\n\n![](images/68/6811e57f1259b97448811ac9abe8d6fc7f76a52b62e685f2fa0ec36e290381b4.png)\n\nLet's go through each statement.\n\n- Statement I is false. From the graph, we see that the domain is $x>0.$\n\n- Statement II is true. Indeed, the function $y={log}_{8}⁡x$ has no horizontal asymptote. However, it does have the vertical asymptote $x=0.$\n\n- Statement III is true. Substituting $x=64$ into the equation of the curve gives:\n\n$$\n\\begin{aligned}y & ={log}_{8}⁡(64) \\\\  & ={log}_{8}⁡({8}^{2}) \\\\  & =2{log}_{8}⁡(8) \\\\  & =2\\,\\,✓\\end{aligned}\n$$\n\nIn conclusion, only statements II and III are true."}] [{:db/id #edb/ref 17592186233519 :knowledge-point/_questions [{:db/id #edb/ref 17592186110678 :knowledge-point/id #uuid "8f1fce29-a071-5a86-8a5e-0e7093558d0f" :knowledge-point/title "Identifying True Statements Regarding Logarithmic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b0f5b8f-e5e0-519d-aa21-ccb7de143a67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186562962} {:answer/id #uuid "2d1effa9-7e1a-55a3-81d4-aac75787131d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186563047} {:answer/id #uuid "5963bb65-6486-5a51-a43b-a6e3dcb86561" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186563145} {:answer/id #uuid "d9334f19-c8ae-5204-a395-20c07315d341" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186563420} {:answer/id #uuid "dd5aa106-d5f2-58b4-962e-4d9b7feff98e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186563430}] :answer-field/correct {:answer/id #uuid "2d1effa9-7e1a-55a3-81d4-aac75787131d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186563047} :answer-field/id #uuid "b179eeb3-b9e7-569b-a20d-09ef65081dfe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563614}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "19c56fe1-1bea-5145-bd09-d55715bd1967" :question/math-academy-id "q-156743" :question/problem "Which of the following statements are true regarding the function $y={log}_{6}⁡x?$ \n\nI. It has no zeros\n\nII. $y\\to 6$ as $x\\to \\infty $\n\nIII. It has a vertical asymptote at $x=0$" :question/worked-solution "Let's plot the graph of $y={log}_{6}⁡x.$\n\n![](images/d8/d8d3f9dc995d8801d451b15129860362efa772178cdc3ef07be5adb6a1da5c45.png)\n\nLet's go through each statement.\n\n- Statement I is false. The function has a zero at $x=1.$\n\n- Statement II is false. As $x$ increases, $y$ increases without bound. Therefore, $y\\to \\infty $ as $x\\to \\infty $\n\n- Statement III is true.\n\nIn conclusion, only statement III is true."}] [{:db/id #edb/ref 17592186111219 :knowledge-point/_questions [{:db/id #edb/ref 17592186110678 :knowledge-point/id #uuid "8f1fce29-a071-5a86-8a5e-0e7093558d0f" :knowledge-point/title "Identifying True Statements Regarding Logarithmic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da423ee6-60d2-5fbf-a2a5-c3d103b35222" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186109040} {:answer/id #uuid "ede0e572-2c5a-50de-9e82-7e13932190f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186109041} {:answer/id #uuid "3c6217f0-e9af-5f93-ab26-9dc1352bfdee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III" :db/id #edb/ref 17592186109042} {:answer/id #uuid "41790905-c115-51dd-b040-ce97622db28a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II" :db/id #edb/ref 17592186109043} {:answer/id #uuid "43c9e31a-6391-5c1b-bc12-b2191b613c47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III" :db/id #edb/ref 17592186109044}] :answer-field/correct {:answer/id #uuid "ede0e572-2c5a-50de-9e82-7e13932190f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186109041} :answer-field/id #uuid "a96c92ca-92a4-5c9f-b939-b05afbaad1ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186109039}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "dbbb8cfe-8860-58a2-9309-4541390e9f81" :question/math-academy-id "q-47626" :question/problem "Which of the following statements are true regarding the function $y=\\operatorname{log}⁡x?$\n\nI. The function passes through the point $(1,0)$\n\nII. Its horizontal asymptote is $y=0.$\n\nIII. It passes through the point $(10,100).$" :question/worked-solution "Let's plot the graph of $y=\\operatorname{log}⁡x.$\n\n![](images/17/177d2949118515d96b6a1c49d0222a2417ab6236e8641f8d89c0cd8f6b30a592.png)\n\nLet's go through each statement.\n\n- Statement I is true.\n\n- Statement II is false. The function $y=\\operatorname{log}⁡x$ has no horizontal asymptote. However, it does have the vertical asymptote $x=0.$\n\n- Statement III is false. Substituting $x=10$ into the equation of the curve gives:\n\n$$\n\\begin{aligned}y & =\\operatorname{log}⁡(10) \\\\  & =\\operatorname{log}⁡({10}^{1}) \\\\  & =1\\ne 100\\,\\times \\end{aligned}\n$$\n\nIn conclusion, only statement I is true."}] [{:db/id #edb/ref 17592186234082 :knowledge-point/_questions [{:db/id #edb/ref 17592186110677 :knowledge-point/id #uuid "f5468f23-98bd-52d9-ba21-85e5eea058a9" :knowledge-point/title "Identifying the Domain and Range of a Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b036fe4-7233-5ebc-8f0c-3cf98501a5ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y>9" :db/id #edb/ref 17592186563109} {:answer/id #uuid "5e0c9f33-790a-501e-b19f-3f8e49dc71a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y>1" :db/id #edb/ref 17592186563158} {:answer/id #uuid "6fa24a05-46a0-58d6-9f18-9c9e0b452ff4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y>0" :db/id #edb/ref 17592186563197} {:answer/id #uuid "7f349f14-4593-5f2a-895a-e0b5fea4b00c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y<1" :db/id #edb/ref 17592186563224} {:answer/id #uuid "98d3f8f9-ad50-5b5b-ab14-47a7ba9a65a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "All real numbers" :db/id #edb/ref 17592186563289}] :answer-field/correct {:answer/id #uuid "98d3f8f9-ad50-5b5b-ab14-47a7ba9a65a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "All real numbers" :db/id #edb/ref 17592186563289} :answer-field/id #uuid "78b5fafb-5a7a-5f32-a04d-538e33ff8b78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563578}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c872bbea-0830-58ac-9bad-a456f39f833d" :question/math-academy-id "q-47778" :question/problem "What's the range of $f(x)={log}_{9}⁡x?$" :question/worked-solution "Let's recall the graph of $y={log}_{9}⁡x.$\n\n![](images/40/40664f83ba162a93ed06970798d37798db90b85c21d44a9ed20f338df4e1b4e1.png)\n\nThe domain of $y={log}_{9}⁡x$ is $x\\in (0,\\infty )$ and the range is $y\\in (-\\infty ,\\infty ).$\n\nTherefore, the correct answer is \"All real numbers.\""}] [{:db/id #edb/ref 17592186111382 :knowledge-point/_questions [{:db/id #edb/ref 17592186110679 :knowledge-point/id #uuid "06ede1c9-b17d-504b-86a8-9284f7ded093" :knowledge-point/title "Finding the Zeros and Asymptotes of a Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3434375c-1ed2-5f71-80ef-9421d3daba23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186563062} {:answer/id #uuid "772a545f-c998-5cca-b0ca-b27d118ff58d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=5" :db/id #edb/ref 17592186563208} {:answer/id #uuid "82d33dd7-17dd-5d35-859e-346211ae4641" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}" :db/id #edb/ref 17592186563236} {:answer/id #uuid "967407a3-388d-50e5-b05f-6024104a481d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1" :db/id #edb/ref 17592186563278} {:answer/id #uuid "c52bc628-e221-5ead-8655-971a0094fb2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=1" :db/id #edb/ref 17592186563377}] :answer-field/correct {:answer/id #uuid "c52bc628-e221-5ead-8655-971a0094fb2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=1" :db/id #edb/ref 17592186563377} :answer-field/id #uuid "1a86d023-59e1-58b5-8e16-26b22652d4d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186110017}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3ecd0e41-2586-55ce-b89a-08c18fa75672" :question/math-academy-id "q-69657" :question/problem "Which of the following is a zero of $y={log}_{5}⁡x?$" :question/worked-solution "Let's recall the graph of $y={log}_{5}⁡x.$\n\n![](images/f0/f095d09fd04a982ad51ff3859f6d789083ed7528b382457954e45cf259cc06a5.png)\n\nNote that the graph passes through the point $(1,0).$ \n\nTherefore, the zero of the function $y={log}_{5}⁡x$ is $x=1.$"}] [{:db/id #edb/ref 17592186563710 :knowledge-point/_questions [{:db/id #edb/ref 17592186110676 :knowledge-point/id #uuid "c6914109-37d4-5b87-a64d-f919a124377d" :knowledge-point/title "Graphing Logarithmic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "019e96cc-90d0-5b45-819f-c08d766dfb34" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/df/dfc188411db17364c61df7fdc938658f683ebaf987b546c6656724b49af3dd05.png" :db/id #edb/ref 17592186562942} {:answer/id #uuid "2821546d-1b86-59e1-aefc-96a353b7c4d6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5d/5d4fb47e0dc5d3328f985be136691a4f34765b804c100f58ed6d8ad378e20409.png" :db/id #edb/ref 17592186563034} {:answer/id #uuid "96c77cf6-e1bd-580c-9fce-429624d4e465" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9c/9c6d1189439bab1a83653c410b9d7528337707e9b99ec33a87b49118152db4de.png" :db/id #edb/ref 17592186563282} {:answer/id #uuid "b9bfadd0-e374-585c-b6a5-326839b56ad8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/28/285e69e8c0914643c1fb695d0146a5e83304d74f9e8fbd8efbc2100a7f32bd9e.png" :db/id #edb/ref 17592186563352} {:answer/id #uuid "cc03d8ac-77bf-5178-838d-353b0a613a52" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8e/8e7af01c65f51d61eb73eac91d4678d772eb00a6046d00efc50e675f573c07c4.png" :db/id #edb/ref 17592186563397}] :answer-field/correct {:answer/id #uuid "b9bfadd0-e374-585c-b6a5-326839b56ad8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/28/285e69e8c0914643c1fb695d0146a5e83304d74f9e8fbd8efbc2100a7f32bd9e.png" :db/id #edb/ref 17592186563352} :answer-field/id #uuid "e4e9db8c-de87-5771-b057-8503dbc84d01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563632}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "82de78d8-db02-58ba-afa8-a2bcae276094" :question/math-academy-id "q-69693" :question/problem "Which of the following diagrams shows the graph of $y={log}_{2}⁡x?$" :question/worked-solution "Let's recall some of the basic properties of $y={log}_{2}⁡x:$\n\n- The domain is $x>0$, and the range is $-\\infty <y<\\infty .$\n\n- The graph has the vertical asymptote $x=0.$\n\n- The function is an increasing function.\n\n- The graph passes through the point $(1,0).$\n\n- For $x>1$, the graph is positive and grows very slowly as we increase $x.$ We say that $y\\to \\infty $ (slowly) as $x\\to \\infty .$\n\nOf the given functions, the only one that has all of these properties is as follows:\n\n![](images/28/285e69e8c0914643c1fb695d0146a5e83304d74f9e8fbd8efbc2100a7f32bd9e.png)"}]}
