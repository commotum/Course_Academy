#{[{:db/id #edb/ref 17592186110302 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110676 :knowledge-point/id #uuid "c6914109-37d4-5b87-a64d-f919a124377d" :knowledge-point/title "Graphing Logarithmic Functions"}] :question/id #uuid "cb79d4e2-53ee-5a09-93ad-0b2e1bdc645e" :question/math-academy-id "e-10925" :question/problem "Which of the following plots is the graph of $y = \\log (x)?$\n\n![](images/5f/5f38ded6da0c01657574cf0a40d86d2c5d2ce6b9ff1c29ceaaefbbe82103a277.png)" :question/worked-solution "Let's recall some of the basic properties of $y=\\log (x)\\mathbin{:}$\n\n- The graph passes through the point $(1,0).$\n\n- For $x>1,$ the function is positive and grows very slowly as we increase $x.$ We say that $y\\rightarrow \\infty$ (slowly) as $x\\rightarrow \\infty.$\n\n- The domain is $x>0$, and the range is $-\\infty < y < \\infty.$ The function is not defined at $x=0.$\n\n- The function has the vertical asymptote $x=0.$\n\n- The function is an increasing function.\n\nOf the given plots, the only one that displays all of these properties is II. (For example, plots I, III, and IV all do not have a vertical asymptote $x=0.$)"}] [{:db/id #edb/ref 17592186110303 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110677 :knowledge-point/id #uuid "f5468f23-98bd-52d9-ba21-85e5eea058a9" :knowledge-point/title "Identifying the Domain and Range of a Logarithmic Function"}] :question/id #uuid "428c177d-8b83-50ad-9840-0dd3ffdf14ee" :question/math-academy-id "e-10926" :question/problem "What are the domain and range of the function $y=\\ln x ?$" :question/worked-solution "Let's recall the graph of $y = \\ln x.$\n\n![](images/00/004c1050017c1a0631d0dda46c8335248b4f05dad15645513b71e88588d4ed0c.png)\n\nThe domain of $y=\\ln x$ is $x \\in (0,\\infty)$ and the range is $y \\in (-\\infty,\\infty).$"}] [{:db/id #edb/ref 17592186110304 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110678 :knowledge-point/id #uuid "8f1fce29-a071-5a86-8a5e-0e7093558d0f" :knowledge-point/title "Identifying True Statements Regarding Logarithmic Functions"}] :question/id #uuid "b162bb35-509f-5ed3-896c-19eb9c52deb2" :question/math-academy-id "e-10927" :question/problem "Which of the following statements are true regarding the function $y=\\ln(x)?$\n\nI. $y\\rightarrow-\\infty$ as $x\\rightarrow 0^+$\n\nII. The curve passes through the point $(1,0)$\n\nIII. $y\\rightarrow\\infty$ as $x\\rightarrow -\\infty$" :question/worked-solution "First, let's plot the graph of $y=\\ln (x).$\n\n![](images/d9/d9ca282050c64ffc1ab1950dd6d89288e6d65d680e45bbc9ef29c1a4ae2c3a67.png)\n\nNow, let's consider each statement.\n\n- Statement I is true. As $x$ approaches $0^+,$ $y$ decreases without bound.\n\n- Statement II is true. Substituting $x=1$ into the equation of the curve gives a result of $0\\mathbin{:}$\n\n$$\n\\begin{aligned}y & =\\operatorname{ln}⁡(1)=0\\,✓\\end{aligned}\n$$\n\n- Statement III is false. The function is not defined for $x<0,$ so the function is not defined as $x \\to -\\infty.$\n\nIn conclusion, only statements I and II are true."}] [{:db/id #edb/ref 17592186110305 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110679 :knowledge-point/id #uuid "06ede1c9-b17d-504b-86a8-9284f7ded093" :knowledge-point/title "Finding the Zeros and Asymptotes of a Logarithmic Function"}] :question/id #uuid "8e8032c5-b7cb-5e25-bc37-0621362ac2fa" :question/math-academy-id "e-10932" :question/problem "What is the vertical asymptote of $y=\\log_{2} x?$" :question/worked-solution "Let's recall the graph of $y=\\log_{2} x.$\n\n![](images/96/96d7da4dd7415b769803b9cea8ebf91b65db2ba5afe0249af9d16521eb0f4818.png)\n\nFrom the graph, we see that the function $y=\\log_{2} x$ has the vertical asymptote at $x=0.$"}] [{:db/id #edb/ref 17592186563695 :knowledge-point/_questions [{:db/id #edb/ref 17592186110676 :knowledge-point/id #uuid "c6914109-37d4-5b87-a64d-f919a124377d" :knowledge-point/title "Graphing Logarithmic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d8576c7-cf28-59ab-aad4-68888834444a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/84/84b02de91145eb07f7953fc66990d0eb4c05ac4a472dfdd1c45897f603630ecc.png" :db/id #edb/ref 17592186563009} {:answer/id #uuid "4139f992-18c2-541d-a17f-bdc977442718" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/79/79996a9f196d55043211af691824a64337a1f9fb311caabc73c26cb11507a032.png" :db/id #edb/ref 17592186563095} {:answer/id #uuid "5e372c06-b64e-5e8e-886f-b67cf7c92ad5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f9/f9c4a79e5132b4759fbf8d9352c000a0963ea67ee4dfe225c12ae0bf9c2a8ba7.png" :db/id #edb/ref 17592186563159} {:answer/id #uuid "c9b18b20-9338-545b-83f7-9561c2d8b175" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5a/5a52b4fcfb2cc410c894f69771ff450ceef1366048438345d1444e35186d9d76.png" :db/id #edb/ref 17592186563391} {:answer/id #uuid "f8775698-5cd7-5b37-9787-6fd7662e068d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3d/3d64f2d38b0e063e58591eb2bac178e1a2edf07342fe2d1489c350201b2158aa.png" :db/id #edb/ref 17592186563500}] :answer-field/correct {:answer/id #uuid "c9b18b20-9338-545b-83f7-9561c2d8b175" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5a/5a52b4fcfb2cc410c894f69771ff450ceef1366048438345d1444e35186d9d76.png" :db/id #edb/ref 17592186563391} :answer-field/id #uuid "3d617350-105e-5169-869d-979d77b96b31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563557}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "66bc9e90-0e6b-5349-afc6-a4320dc355fe" :question/math-academy-id "q-156691" :question/problem "Which of the following diagrams shows the graph of $y={log}_{10}⁡x?$" :question/worked-solution "Let's recall some of the basic properties of $y={log}_{10}⁡x:$\n\n- The domain is $x>0$, and the range is $-\\infty <y<\\infty .$\n\n- The graph has the vertical asymptote $x=0.$\n\n- The function is an increasing function.\n\n- The graph passes through the point $(1,0).$\n\n- For $x>1$, the graph is positive and grows very slowly as we increase $x.$ We say that $y\\to \\infty $ (slowly) as $x\\to \\infty .$\n\nOf the given functions, the only one that has all of these properties is as follows:\n\n![](images/5a/5a52b4fcfb2cc410c894f69771ff450ceef1366048438345d1444e35186d9d76.png)"}] [{:db/id #edb/ref 17592186563745 :knowledge-point/_questions [{:db/id #edb/ref 17592186110677 :knowledge-point/id #uuid "f5468f23-98bd-52d9-ba21-85e5eea058a9" :knowledge-point/title "Identifying the Domain and Range of a Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cce0928-5c45-5cae-970c-3581244256ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y>10" :db/id #edb/ref 17592186563155} {:answer/id #uuid "a12457a1-2944-5ee5-95fb-ef1dd4a9cacb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "All real numbers" :db/id #edb/ref 17592186563308} {:answer/id #uuid "baa0d710-9a69-5b4a-9aee-891921c29ed3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\ge 0" :db/id #edb/ref 17592186563354} {:answer/id #uuid "bdb5963e-6fe9-557e-8a4d-23aede8af37e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y>0" :db/id #edb/ref 17592186563362} {:answer/id #uuid "beb08fdd-da79-59e0-ab59-9dd6f572e91f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\ge 1" :db/id #edb/ref 17592186563366}] :answer-field/correct {:answer/id #uuid "a12457a1-2944-