#{[{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186125663} :activity/id #uuid "54746d4e-16f7-5527-9c6f-def91a1f4b6e" :activity/scope {:db/id #edb/ref 17592186049828 :topic/id #uuid "171bc42f-1e67-52f7-92c6-e9af227f8d0f" :topic/math-academy-id 1882} :activity/steps [{:db/id #edb/ref 17592186125509 :step/content {:db/id #edb/ref 17592186124583 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124391 :question/id #uuid "59873e3c-c8ba-5844-874a-01cf298b361d" :question/math-academy-id "e-7992"} :knowledge-point/id #uuid "713fb1a0-5d7b-5cde-aafe-de5887086e1b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049072}] :knowledge-point/questions [{:db/id #edb/ref 17592186124869} {:db/id #edb/ref 17592186124930} {:db/id #edb/ref 17592186549945} {:db/id #edb/ref 17592186550005}] :knowledge-point/title "Finding the Domain of a Quadratic Function"} :step/id #uuid "e12eeac1-466a-5f3e-b414-d25fd0ed1c89" :step/math-academy-id 29837 :step/next {:db/id #edb/ref 17592186125559}} {:db/id #edb/ref 17592186125512 :step/content {:db/id #edb/ref 17592186124584 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124393 :question/id #uuid "d6a69eb7-e598-51e8-92e9-fad42b3c0978" :question/math-academy-id "e-8027"} :knowledge-point/id #uuid "56d457de-8511-5870-98e3-b81e72e60585" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049622} {:db/id #edb/ref 17592186049707}] :knowledge-point/questions [{:db/id #edb/ref 17592186124866} {:db/id #edb/ref 17592186125198} {:db/id #edb/ref 17592186549928} {:db/id #edb/ref 17592186549983}] :knowledge-point/title "Finding the Range of a Parabola Given in Vertex Form"} :step/id #uuid "e7d9de02-5d84-5776-9397-cf6b426b9eb4" :step/math-academy-id 29974 :step/next {:db/id #edb/ref 17592186125664}} {:db/id #edb/ref 17592186125559 :step/content {:db/id #edb/ref 17592186125846 :tutorial/content "The range of a quadratic function depends on the direction in which its graph opens. Regardless of whether the equation is written in standard form,\n\n$$\ny = ax^2 + bx + c,\n$$\n\nvertex form, \n\n$$\ny = a(x-h)^2 + k,\n$$\n\nor factored form,\n\n$$\ny = a(x-x_1)(x-x_2),\n$$\n\nit opens upwards if the leading coefficient $a$ is positive and downwards if $a$ is negative.\n\nNow, consider a parabola that opens upwards ($a>0$). In this case, the minimum output corresponds to the $y$-coordinate of the vertex, while there is no maximum output. Therefore, if the vertex is $(h,k),$ then the range is $y \\geq k.$\n\nFor example, in the graph below, the $y$-value of the vertex is $y=-2$, so the range of the function is $y \\geq -2.$\n\n![](images/ac/ac254aaa0bdab2999e07c46f82becd37fb4b8ee6e816ad91842d6e750eb90b86.png)" :tutorial/id #uuid "505edbed-bec8-50a0-8a52-67e25a936784" :tutorial/math-academy-id 5155 :tutorial/title "The Range of an Upward-Opening Parabola"} :step/id #uuid "cd9056e9-1e4b-5477-b146-89ad0b007f19" :step/math-academy-id 32412 :step/next {:db/id #edb/ref 17592186125665}} {:db/id #edb/ref 17592186125663 :step/content {:db/id #edb/ref 17592186125716 :tutorial/content "In this lesson, we will discuss the properties of quadratic functions. Specifically, we learn how to determine the domain and range of a quadratic function.\n\nRemember that a quadratic function takes the form\n\n$$\nf(x) = ax^2 + bx + c,\n$$\n\nwhere $a,b,$ and $c$ are constants.\n\nThe first thing to note is that the domain of *any* quadratic function is $x\\in (-\\infty, \\infty)$ because it is defined for all values of $x.$\n\nDetermining the range of a quadratic function is slightly more involved, as we'll see shortly." :tutorial/id #uuid "754107de-231b-53d3-9c87-0c63f43c0733" :tutorial/math-academy-id 1649 :tutorial/title "Introduction"} :step/id #uuid "382f3a3b-5fd1-5d9c-acfc-d0673b1bdd60" :step/math-academy-id 4602 :step/next {:db/id #edb/ref 17592186125509}} {:db/id #edb/ref 17592186125664 :step/content {:db/id #edb/ref 17592186124659 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124225 :question/id #uuid "d2479726-b486-5bc2-864f-98a3659d81d5" :question/math-academy-id "e-1470"} :knowledge-point/id #uuid "b1bc2396-f949-57a0-be50-d5606abe3372" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048398}] :knowledge-point/questions [{:db/id #edb/ref 17592186124865} {:db/id #edb/ref 17592186125237} {:db/id #edb/ref 17592186549930} {:db/id #edb/ref 17592186549948} {:db/id #edb/ref 17592186549973} {:db/id #edb/ref 17592186549998}] :knowledge-point/title "Finding the Range of a Parabola Given in Standard Form"} :step/id #uuid "967be501-fa9c-5999-83c9-e020f0c1112d" :step/math-academy-id 4604 :step/next {:db/id #edb/ref 17592186125666}} {:db/id #edb/ref 17592186125665 :step/content {:db/id #edb/ref 17592186125717 :tutorial/content "Now consider a parabola that opens downwards ($a<0$). In this case, there is no minimum output, but the maximum output corresponds to the $y$-coordinate of the vertex. Therefore, if the vertex is $(h,k),$ then the range is $y \\leq k.$\n\nFor example, in the graph below, the $y$-value of the vertex is $y=2$, so the range of the function is $y \\leq 2.$\n\n![](images/e4/e4390b9cec5d5fce67691421479151be3592967f95d22ddde307c6d56c630879.png)" :tutorial/id #uuid "886809b2-0204-52ae-8f7b-c83f91d56f41" :tutorial/math-academy-id 1651 :tutorial/title "The Range of a Downward-Opening Parabola"} :step/id #uuid "0db717c3-7b6a-5b97-8fd1-af369e6ff4d6" :step/math-academy-id 4609 :step/next {:db/id #edb/ref 17592186125512}} {:db/id #edb/ref 17592186125666 :step/content {:db/id #edb/ref 17592186124660 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124226 :question/id #uuid "f69335f5-b5df-5053-8127-a7489c711b5f" :question/math-academy-id "e-1472"} :knowledge-point/id #uuid "fb0d6e0e-bf61-5fe9-bf8a-ab15c5846e11" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050577}] :knowledge-point/questions [{:db/id #edb/ref 17592186124875} {:db/id #edb/ref 17592186125204} {:db/id #edb/ref 17592186549929}] :knowledge-point/title "Finding the Range of a Parabola Given in Factored Form"} :step/id #uuid "87f0d6e4-1968-5bc6-bd74-da8ebb01d739" :step/math-academy-id 4610}] :activity/title "Domain and Range of Quadratic Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186124689}]}
