r/validate]} {:db/id "answer-b53765b8-081b-5c81-b804-c9203ccfbed5" :answer/id #uuid "b53765b8-081b-5c81-b804-c9203ccfbed5" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-4)" :db/ensure [:answer/validate]} {:db/id "answer-6136aeb0-f1bb-5fc6-b66f-a1a71f228427" :answer/id #uuid "6136aeb0-f1bb-5fc6-b66f-a1a71f228427" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "question-0bc8d353-4f35-531e-9326-d4dcbc01bbdb" :question/id #uuid "0bc8d353-4f35-531e-9326-d4dcbc01bbdb" :question/math-academy-id "q-35908" :question/problem "What is the range of the function $y=f(x)=(x-1)^{2}-3?$" :question/worked-solution "The parabola is written in vertex form, \n\n$$\ny=a(x-h)^{2}+k,\n$$\n\nwhere $a$ is the leading coefficient and $(h,k)$ is the vertex. \n\n- Since $h=1$ and $k=-3,$ the vertex is $(1,-3).$\n\n- Since $a=1>0,$ the parabola opens upwards.\n\nBecause the parabola opens upwards, there is no maximum output, and the vertex corresponds to the minimum output. \n\nTherefore, the range is $[-3,\\infty ).$\n\nThe corresponding diagram is shown below.\n\n![](images/26/265532f4f4726151444ed873b875fc62c3c32a690a0ac859a318e2d4dc8fd285.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d506de6d-4e6d-5568-a53f-79ffc50374e1"] :db/ensure [:question/validate]} {:db/id "answer-field-d506de6d-4e6d-5568-a53f-79ffc50374e1" :answer-field/id #uuid "d506de6d-4e6d-5568-a53f-79ffc50374e1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ec8b8a2d-5b31-5cfd-aa2c-e0f8c2791516" :answer-field/choices ["answer-c5d59e6e-34b2-5e9c-b08e-8f2105c0bb6e" "answer-8e98df84-9ac6-56f7-ab33-a824ee4007cd" "answer-ec8b8a2d-5b31-5cfd-aa2c-e0f8c2791516" "answer-17490e92-f04a-51f7-b438-199eeb712801" "answer-f856d9c9-25b2-55b1-83a5-4041c1afdc91"] :db/ensure [:answer-field/validate]} {:db/id "answer-c5d59e6e-34b2-5e9c-b08e-8f2105c0bb6e" :answer/id #uuid "c5d59e6e-34b2-5e9c-b08e-8f2105c0bb6e" :answer/type :answer.type/math :answer/value "(-\\infty ,3]" :db/ensure [:answer/validate]} {:db/id "answer-8e98df84-9ac6-56f7-ab33-a824ee4007cd" :answer/id #uuid "8e98df84-9ac6-56f7-ab33-a824ee4007cd" :answer/type :answer.type/math :answer/value "(-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-ec8b8a2d-5b31-5cfd-aa2c-e0f8c2791516" :answer/id #uuid "ec8b8a2d-5b31-5cfd-aa2c-e0f8c2791516" :answer/type :answer.type/math :answer/value "[-3,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-17490e92-f04a-51f7-b438-199eeb712801" :answer/id #uuid "17490e92-f04a-51f7-b438-199eeb712801" :answer/type :answer.type/math :answer/value "[0,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-f856d9c9-25b2-55b1-83a5-4041c1afdc91" :answer/id #uuid "f856d9c9-25b2-55b1-83a5-4041c1afdc91" :answer/type :answer.type/math :answer/value "[3,\\infty )" :db/ensure [:answer/validate]} {:db/id "question-9acd8689-6770-5d1b-9670-f2ff78d7e31a" :question/id #uuid "9acd8689-6770-5d1b-9670-f2ff78d7e31a" :question/math-academy-id "q-106278" :question/problem "What is the range of the function $f(x)=(x-4)^{2}+19?$" :question/worked-solution "The parabola is written in vertex form, \n\n$$\ny=a(x-h)^{2}+k,\n$$\n\nwhere $a$ is the leading coefficient and $(h,k)$ is the vertex. \n\n- Since $h=4$ and $k=19,$ the vertex is $(4,19).$\n\n- Since $a=1>0,$ the parabola opens upwards.\n\nBecause the parabola opens upwards, there is no maximum output, and the vertex corresponds to the minimum output.\n\nTherefore, the range is $[19,\\infty ).$\n\n![](images/7f/7fbc9dc7839e439967d6f9f50e25d561ff7be8211b899c83ff269b019b4c61c5.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c611b6bd-39c2-5cd3-a50d-868b00e1145e"] :db/ensure [:question/validate]} {:db/id "answer-field-c611b6bd-39c2-5cd3-a50d-868b00e1145e" :answer-field/id #uuid "c611b6bd-39c2-5cd3-a50d-868b00e1145e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2fe99722-e163-5bb2-a90e-59a16c64cfd2" :answer-field/choices ["answer-41940498-39d4-5882-b1c4-e50157d147e4" "answer-a3036565-aed3-5af5-ba9a-54116f9b35c0" "answer-29049f46-2a3c-530f-bf65-510e941c269a" "answer-2fe99722-e163-5bb2-a90e-59a16c64cfd2" "answer-3eab0845-8b32-5998-9064-38cb5fecb9fb"] :db/ensure [:answer-field/validate]} {:db/id "answer-41940498-39d4-5882-b1c4-e50157d147e4" :answer/id #uuid "41940498-39d4-5882-b1c4-e50157d147e4" :answer/type :answer.type/math :answer/value "(\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-a3036565-aed3-5af5-ba9a-54116f9b35c0" :answer/id #uuid "a3036565-aed3-5af5-ba9a-54116f9b35c0" :answer/type :answer.type/math :answer/value "[-19,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-29049f46-2a3c-530f-bf65-510e941c269a" :answer/id #uuid "29049f46-2a3c-530f-bf65-510e941c269a" :answer/type :answer.type/math :answer/value "[-4,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-2fe99722-e163-5bb2-a90e-59a16c64cfd2" :answer/id #uuid "2fe99722-e163-5bb2-a90e-59a16c64cfd2" :answer/type :answer.type/math :answer/value "[19,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-3eab0845-8b32-5998-9064-38cb5fecb9fb" :answer/id #uuid "3eab0845-8b32-5998-9064-38cb5fecb9fb" :answer/type :answer.type/math :answer/value "[4,\\infty )" :db/ensure [:answer/validate]} {:db/id "question-c749b226-6df0-583d-9d39-da82636ab3b6" :question/id #uuid "c749b226-6df0-583d-9d39-da82636ab3b6" :question/math-academy-id "q-90975" :question/problem "What is the range of the function $f(x)={x}^{2}+1?$" :question/worked-solution "The given parabola is written in standard form,\n\n$$\ny=a{x}^{2}+bx+c,\n$$\n\nwith $a=1>0,$ $b=0,$ and $c=1.$\n\nBecause the leading coefficient is positive, the parabola opens upward. Consequently, there is no maximum output, and the vertex corresponds to the minimum output.\n\nThe $x$-coordinate of the vertex is given by\n\n$$\nx=-\\frac{b}{2a}=-\\frac{0}{2\\cdot 1}=0.\n$$\n\nNow, we substitute $x=0$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & ={x}^{2}+1 \\\\  & =(0)^{2}+1 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, the vertex is $(0,1),$ and the range of the function is $[1,\\infty ).$\n\n![](images/0a/0a0bb7cbd5494106b36e85f4b9f2604153d28623883c33f507e1ef36389999c4.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8696ee0d-200e-5d5f-b4a1-875cd5516de8"] :db/ensure [:question/validate]} {:db/id "answer-field-8696ee0d-200e-5d5f-b4a1-875cd5516de8" :answer-field/id #uuid "8696ee0d-200e-5d5f-b4a1-875cd5516de8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-28ae418f-d853-574e-aad6-2711015f76d1" :answer-field/choices ["answer-f8afb740-92b1-5a27-9a61-bb974a1e4d6f" "answer-720e13e8-4fcd-54db-bf77-f1e56dad5e3c" "answer-d04a0586-14b1-51f8-9ee4-74197f142b62" "answer-3342ac6c-a5ac-505a-9057-009d9aaad1b1" "answer-28ae418f-d853-574e-aad6-2711015f76d1"] :db/ensure [:answer-field/validate]} {:db/id "answer-f8afb740-92b1-5a27-9a61-bb974a1e4d6f" :answer/id #uuid "f8afb740-92b1-5a27-9a61-bb974a1e4d6f" :answer/type :answer.type/math :answer/value "(-\\infty ,0]" :db/ensure [:answer/validate]} {:db/id "answer-720e13e8-4fcd-54db-bf77-f1e56dad5e3c" :answer/id #uuid "720e13e8-4fcd-54db-bf77-f1e56dad5e3c" :answer/type :answer.type/math :answer/value "(-\\infty ,1]" :db/ensure [:answer/validate]} {:db/id "answer-d04a0586-14b1-51f8-9ee4-74197f142b62" :answer/id #uuid "d04a0586-14b1-51f8-9ee4-74197f142b62" :answer/type :answer.type/math :answer/value "[-1,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-3342ac6c-a5ac-505a-9057-009d9aaad1b1" :answer/id #uuid "3342ac6c-a5ac-505a-9057-009d9aaad1b1" :answer/type :answer.type/math :answer/value "[0,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-28ae418f-d853-574e-aad6-2711015f76d1" :answer/id #uuid "28ae418f-d853-574e-aad6-2711015f76d1" :answer/type :answer.type/math :answer/value "[1,\\infty )" :db/ensure [:answer/validate]} {:db/id "question-0eda0ab3-fc3e-57ae-8050-823c01afb804" :question/id #uuid "0eda0ab3-fc3e-57ae-8050-823c01afb804" :question/math-academy-id "q-250634" :question/problem "Find the range of the function $f(x)={x}^{2}-6x+10.$\n\n{{field-1}}{{field-2}}\n$f(x)<$\n{{field-3}}" :question/worked-solution "The given parabola is written in standard form,\n\n$$\ny=a{x}^{2}+bx+c,\n$$\n\nwith $a=1>0,$ $b=-6,$ and $c=10.$\n\nBecause the leading coefficient is positive, the parabola opens upward. Consequently, there is no maximum output, and the vertex corresponds to the minimum output.\n\nThe $x$-coordinate of the vertex is given by\n\n$$\nx=-\\frac{b}{2a}=-\\frac{(-6)}{2\\cdot 1}=3.\n$$\n\nNow, we substitute $x=3$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & ={x}^{2}-6x+10 \\\\  & =(3)^{2}-6(3)+10 \\\\  & =9-18+10 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, the vertex is $(3,1),$ and the range of the function is $[1,\\infty ),$ i.e. $1\\le f(x)<\\infty .$\n\n![](images/4a/4abd9af6ea0eb83d2c99e4d02e67b09c27ea67576d0d006dbad56dff7f1d3e0e.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-075d541c-fade-5cf1-b19a-7100801cc012" "answer-field-803ac4f9-cd71-5a22-b15d-05e1685e5d11" "answer-field-acac96dd-45f5-5370-b462-a995486d4f4b"] :db/ensure [:question/validate]} {:db/id "answer-field-075d541c-fade-5cf1-b19a-7100801cc012" :answer-field/id #uuid "075d541c-fade-5cf1-b19a-7100801cc012" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9ed33f15-c341-5c1d-87a3-f45c1af216cd" :answer-field/choices ["answer-9ed33f15-c341-5c1d-87a3-f45c1af216cd"] :db/ensure [:answer-field/validate]} {:db/id "answer-9ed33f15-c341-5c1d-87a3-f45c1af216cd" :answer/id #uuid "9ed33f15-c341-5c1d-87a3-f45c1af216cd" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-field-803ac4f9-cd71-5a22-b15d-05e1685e5d11" :answer-field/id #uuid "803ac4f9-cd71-5a22-b15d-05e1685e5d11" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-41b3f64d-78f1-5eab-926d-72594aa2a9d6" :answer-field/choices ["answer-41b3f64d-78f1-5eab-926d-72594aa2a9d6"] :db/ensure [:answer-field/validate]} {:db/id "answer-41b3f64d-78f1-5eab-926d-72594aa2a9d6" :answer/id #uuid "41b3f64d-78f1-5eab-926d-72594aa2a9d6" :answer/type :answer.type/math :answer/value "\\le" :db/ensure [:answer/validate]} {:db/id "answer-field-acac96dd-45f5-5370-b462-a995486d4f4b" :answer-field/id #uuid "acac96dd-45f5-5370-b462-a995486d4f4b" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-594221c2-ecdd-5e14-b646-47c1685bd2e6" :answer-field/choices ["answer-594221c2-ecdd-5e14-b646-47c1685bd2e6"] :db/ensure [:answer-field/validate]} {:db/id "answer-594221c2-ecdd-5e14-b646-47c1685bd2e6" :answer/id #uuid "594221c2-ecdd-5e14-b646-47c1685bd2e6" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "question-7dfd6f87-7029-50ed-aece-aeae8cb98e8c" :question/id #uuid "7dfd6f87-7029-50ed-aece-aeae8cb98e8c" :question/math-academy-id "q-90974" :question/problem "What is the range of the function $f(x)=2{x}^{2}-4x+4?$" :question/worked-solution "The given parabola is written in standard form,\n\n$$\ny=a{x}^{2}+bx+c,\n$$\n\nwith $a=2>0,$ $b=-4,$ and $c=4.$\n\nBecause the leading coefficient is positive, the parabola opens upward. Consequently, there is no maximum output, and the vertex corresponds to the minimum output.\n\nThe $x$-coordinate of the vertex is given by\n\n$$\nx=-\\frac{b}{2a}=-\\frac{(-4)}{2\\cdot 2}=1.\n$$\n\nNow, we substitute $x=1$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & =2{x}^{2}-4x+4 \\\\  & =2(1)^{2}-4(1)+4 \\\\  & =2-4+4 \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the vertex is $(1,2),$ and the range of the function is $[2,\\infty ).$\n\n![](images/5f/5f98a1b646aeab2a8a0f0a04014abb0a0a88794d88c880fb771d5f2f65afa4e7.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e08c3295-f9df-5c3a-b174-e94cf74e7e80"] :db/ensure [:question/validate]} {:db/id "answer-field-e08c3295-f9df-5c3a-b174-e94cf74e7e80" :answer-field/id #uuid "e08c3295-f9df-5c3a-b174-e94cf74e7e80" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9161c4d2-6ea4-54cf-a2fe-2e259b367b91" :answer-field/choices ["answer-3e2093c6-2b2c-500f-98e9-b4721e5beec3" "answer-fd46e073-fb43-5ced-b1cf-cfe1b42cac05" "answer-d00a9a87-81df-5892-9a04-4acd79ba07cd" "answer-7b0ef493-f727-5a5a-ad20-3c6dd0a77f56" "answer-9161c4d2-6ea4-54cf-a2fe-2e259b367b91"] :db/ensure [:answer-field/validate]} {:db/id "answer-3e2093c6-2b2c-500f-98e9-b4721e5beec3" :answer/id #uuid "3e2093c6-2b2c-500f-98e9-b4721e5beec3" :answer/type :answer.type/math :answer/value "(-\\infty ,1]" :db/ensure [:answer/validate]} {:db/id "answer-fd46e073-fb43-5ced-b1cf-cfe1b42cac05" :answer/id #uuid "fd46e073-fb43-5ced-b1cf-cfe1b42cac05" :answer/type :answer.type/math :answer/value "(-\\infty ,2]" :db/ensure [:answer/validate]} {:db/id "answer-d00a9a87-81df-5892-9a04-4acd79ba07cd" :answer/id #uuid "d00a9a87-81df-5892-9a04-4acd79ba07cd" :answer/type :answer.type/math :answer/value "[-2,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-7b0ef493-f727-5a5a-ad20-3c6dd0a77f56" :answer/id #uuid "7b0ef493-f727-5a5a-ad20-3c6dd0a77f56" :answer/type :answer.type/math :answer/value "[1,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-9161c4d2-6ea4-54cf-a2fe-2e259b367b91" :answer/id #uuid "9161c4d2-6ea4-54cf-a2fe-2e259b367b91" :answer/type :answer.type/math :answer/value "[2,\\infty )" :db/ensure [:answer/validate]} {:db/id "question-28ef6032-c464-5039-b5ee-d8d9a6314099" :question/id #uuid "28ef6032-c464-5039-b5ee-d8d9a6314099" :question/math-academy-id "q-90971" :question/problem "What is the range of the function $f(x)=-3{x}^{2}-12x-17?$" :question/worked-solution "The given parabola is written in standard form,\n\n$$\ny=a{x}^{2}+bx+c,\n$$\n\nwith $a=-3<0,$ $b=-12,$ and $c=-17.$\n\nBecause the leading coefficient is negative, the parabola opens downward. Consequently, there is no minimum output, and the vertex corresponds to the maximum output.\n\nThe $x$-coordinate of the vertex is given by\n\n$$\nx=-\\frac{b}{2a}=-\\frac{(-12)}{2\\cdot (-3)}=-2.\n$$\n\nNow, we substitute $x=-2$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & =-3{x}^{2}-12x-17 \\\\  & =-3(-2)^{2}-12(-2)-17 \\\\  & =-12+24-17 \\\\  & =-5\\end{aligned}\n$$\n\nTherefore, the vertex is $(-2,-5),$ and the range of the function is $(-\\infty ,-5].$\n\n![](images/3c/3c62a8826f68c3c36db191769fc23907ca6c64986bc1f47b5a7b21b2b97a91f2.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8165ca3e-61b4-511c-85ae-206dd344dfff"] :db/ensure [:question/validate]} {:db/id "answer-field-8165ca3e-61b4-511c-85ae-206dd344dfff" :answer-field/id #uuid "8165ca3e-61b4-511c-85ae-206dd344dfff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-db1049ca-7810-58af-93e6-7692d67f375f" :answer-field/choices ["answer-92b03c74-a465-57e8-aecb-79f01c72bb95" "answer-db1049ca-7810-58af-93e6-7692d67f375f" "answer-95804488-6e33-5c77-b393-9d6514ac1222" "answer-904523c9-842b-5cc2-95e9-7717ebb39188" "answer-766fca55-c0be-56b2-9f2f-ef654ccd9f83"] :db/ensure [:answer-field/validate]} {:db/id "answer-92b03c74-a465-57e8-aecb-79f01c72bb95" :answer/id #uuid "92b03c74-a465-57e8-aecb-79f01c72bb95" :answer/type :answer.type/math :answer/value "(-\\infty ,-2]" :db/ensure [:answer/validate]} {:db/id "answer-db1049ca-7810-58af-93e6-7692d67f375f" :answer/id #uuid "db1049ca-7810-58af-93e6-7692d67f375f" :answer/type :answer.type/math :answer/value "(-\\infty ,-5]" :db/ensure [:answer/validate]} {:db/id "answer-95804488-6e33-5c77-b393-9d6514ac1222" :answer/id #uuid "95804488-6e33-5c77-b393-9d6514ac1222" :answer/type :answer.type/math :answer/value "(-\\infty ,5]" :db/ensure [:answer/validate]} {:db/id "answer-904523c9-842b-5cc2-95e9-7717ebb39188" :answer/id #uuid "904523c9-842b-5cc2-95e9-7717ebb39188" :answer/type :answer.type/math :answer/value "[-2,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-766fca55-c0be-56b2-9f2f-ef654ccd9f83" :answer/id #uuid "766fca55-c0be-56b2-9f2f-ef654ccd9f83" :answer/type :answer.type/math :answer/value "[-5,\\infty )" :db/ensure [:answer/validate]} {:db/id 17592186124875 :question/problem "What is the range of the function $f(x)=-\\frac{1}{3}(x+2)(x-2)?$" :question/worked-solution "The given parabola is written in factored form,\n\n$$\ny=a(x-{x}_{1})(x-{x}_{2}),\n$$\n\nwith $a=-\\frac{1}{3}<0.$ \n\nBecause the leading coefficient is negative, the parabola opens downward. Consequently, there is no minimum output, and the vertex corresponds to the maximum output.\n\nThe two roots of the parabola are ${x}_{1}=-2$ and ${x}_{2}=2,$ and we can find the $x$-coordinate of the vertex by taking the average of the roots:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{-2+2}{2}=0\\end{aligned}\n$$\n\nThen, we substitute $x=0$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & =-\\frac{1}{3}(x+2)(x-2) \\\\  & =-\\frac{1}{3}(0+2)(0-2) \\\\  & =-\\frac{1}{3}\\cdot 2\\cdot (-2) \\\\  & =\\frac{4}{3}\\end{aligned}\n$$\n\nTherefore, the vertex is $(0,\\frac{4}{3}),$ and the range of the function is $(-\\infty ,\\frac{4}{3}].$\n\n![](images/d9/d9c96e13ab078005333cdf02d8939c96d41fe6802b7f4caf0d4bab041cf8a314.png)" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186121850 :answer-field/correct "answer-9f1dd293-3094-5184-81d3-8f43b189007b" :answer-field/choices ["answer-3d610a34-2b2c-5b7f-a6ee-1208ff230466" "answer-5d61e674-449f-5c1e-8470-6d7a912ecbd3" "answer-9f1dd293-3094-5184-81d3-8f43b189007b" "answer-f1f407d3-59e6-5e5d-8e6f-2e775ce3251f" "answer-0df9a543-b5df-589d-9923-b17fb9588714"] :db/ensure [:answer-field/validate]} {:db/id "answer-3d610a34-2b2c-5b7f-a6ee-1208ff230466" :answer/id #uuid "3d610a34-2b2c-5b7f-a6ee-1208ff230466" :answer/type :answer.type/math :answer/value "(-\\infty ,-\\frac{4}{3}]" :db/ensure [:answer/validate]} {:db/id "answer-5d61e674-449f-5c1e-8470-6d7a912ecbd3" :answer/id #uuid "5d61e674-449f-5c1e-8470-6d7a912ecbd3" :answer/type :answer.type/math :answer/value "(-\\infty ,\\frac{1}{3}]" :db/ensure [:answer/validate]} {:db/id "answer-9f1dd293-3094-5184-81d3-8f43b189007b" :answer/id #uuid "9f1dd293-3094-5184-81d3-8f43b189007b" :answer/type :answer.type/math :answer/value "(-\\infty ,\\frac{4}{3}]" :db/ensure [:answer/validate]} {:db/id "answer-f1f407d3-59e6-5e5d-8e6f-2e775ce3251f" :answer/id #uuid "f1f407d3-59e6-5e5d-8e6f-2e775ce3251f" :answer/type :answer.type/math :answer/value "[-\\frac{4}{3},\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-0df9a543-b5df-589d-9923-b17fb9588714" :answer/id #uuid "0df9a543-b5df-589d-9923-b17fb9588714" :answer/type :answer.type/math :answer/value "[\\frac{4}{3},\\infty )" :db/ensure [:answer/validate]} {:db/id "question-0dff1477-477e-5350-b60a-a888d8f2c5e5" :question/id #uuid "0dff1477-477e-5350-b60a-a888d8f2c5e5" :question/math-academy-id "q-250654" :question/problem "Find the range of the function $f(x)=-2(x+1)(x-3).$\n\n{{field-1}}\n$<f(x)$\n{{field-2}}{{field-3}}" :question/worked-solution "The given parabola is written in factored form,\n\n$$\ny=a(x-{x}_{1})(x-{x}_{2}),\n$$\n\nwith $a=-2<0.$ \n\nBecause the leading coefficient is negative, the parabola opens downward. Consequently, there is no minimum output, and the vertex corresponds to the maximum output.\n\nThe two roots of the parabola are ${x}_{1}=-1$ and ${x}_{2}=3,$ and we can find the $x$-coordinate of the vertex by taking the average of the roots:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{-1+3}{2}=1\\end{aligned}\n$$\n\nThen, we substitute $x=1$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & =-2(x+1)(x-3) \\\\  & =-2(1+1)(1-3) \\\\  & =-2\\cdot 2\\cdot (-2) \\\\  & =8\\end{aligned}\n$$\n\nTherefore, the vertex is $(1,8),$ and the range of the function is $(-\\infty ,8],$ i.e. $-\\infty <f(x)\\le 8.$\n\n![](images/a9/a9c15f73f41c2c58fdbc05eceb3031edfb6f04f12db9fa54450f6445b196d1df.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-79b5b98c-0fd7-5995-adf9-a282e1a404ce" "answer-field-b0e9531b-078f-5214-834b-c186b772332a" "answer-field-cf674f86-ce4f-5339-bbdc-9070efb2a858"] :db/ensure [:question/validate]} {:db/id "answer-field-79b5b98c-0fd7-5995-adf9-a282e1a404ce" :answer-field/id #uuid "79b5b98c-0fd7-5995-adf9-a282e1a404ce" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-1a29102e-cd54-52b0-9d03-2b418b6486b4" :answer-field/choices ["answer-1a29102e-cd54-52b0-9d03-2b418b6486b4"] :db/ensure [:answer-field/validate]} {:db/id "answer-1a29102e-cd54-52b0-9d03-2b418b6486b4" :answer/id #uuid "1a29102e-cd54-52b0-9d03-2b418b6486b4" :answer/type :answer.type/math :answer/value "-\\infty" :db/ensure [:answer/validate]} {:db/id "answer-field-b0e9531b-078f-5214-834b-c186b772332a" :answer-field/id #uuid "b0e9531b-078f-5214-834b-c186b772332a" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5bf95fec-06ee-5b1d-a62b-b525767e3bf4" :answer-field/choices ["answer-5bf95fec-06ee-5b1d-a62b-b525767e3bf4"] :db/ensure [:answer-field/validate]} {:db/id "answer-5bf95fec-06ee-5b1d-a62b-b525767e3bf4" :answer/id #uuid "5bf95fec-06ee-5b1d-a62b-b525767e3bf4" :answer/type :answer.type/math :answer/value "\\le" :db/ensure [:answer/validate]} {:db/id "answer-field-cf674f86-ce4f-5339-bbdc-9070efb2a858" :answer-field/id #uuid "cf674f86-ce4f-5339-bbdc-9070efb2a858" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c9413317-cd36-56a0-b590-2ecf59608bbc" :answer-field/choices ["answer-c9413317-cd36-56a0-b590-2ecf59608bbc"] :db/ensure [:answer-field/validate]} {:db/id "answer-c9413317-cd36-56a0-b590-2ecf59608bbc" :answer/id #uuid "c9413317-cd36-56a0-b590-2ecf59608bbc" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id 17592186125716 :tutorial/content "In this lesson, we will discuss the properties of quadratic functions. Specifically, we learn how to determine the domain and range of a quadratic function.\n\nRemember that a quadratic function takes the form\n\n$$\nf(x) = ax^2 + bx + c,\n$$\n\nwhere $a,b,$ and $c$ are constants.\n\nThe first thing to note is that the domain of *any* quadratic function is $x\\in (-\\infty, \\infty)$ because it is defined for all values of $x.$\n\nDetermining the range of a quadratic function is slightly more involved, as we'll see shortly." :db/ensure [:tutorial/validate]} {:db/id 17592186125846 :tutorial/content "The range of a quadratic function depends on the direction in which its graph opens. Regardless of whether the equation is written in standard form,\n\n$$\ny = ax^2 + bx + c,\n$$\n\nvertex form, \n\n$$\ny = a(x-h)^2 + k,\n$$\n\nor factored form,\n\n$$\ny = a(x-x_1)(x-x_2),\n$$\n\nit opens upwards if the leading coefficient $a$ is positive and downwards if $a$ is negative.\n\nNow, consider a parabola that opens upwards ($a>0$). In this case, the minimum output corresponds to the $y$-coordinate of the vertex, while there is no maximum output. Therefore, if the vertex is $(h,k),$ then the range is $y \\geq k.$\n\nFor example, in the graph below, the $y$-value of the vertex is $y=-2$, so the range of the function is $y \\geq -2.$\n\n![](images/ac/ac254aaa0bdab2999e07c46f82becd37fb4b8ee6e816ad91842d6e750eb90b86.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186125717 :tutorial/content "Now consider a parabola that opens downwards ($a<0$). In this case, there is no minimum output, but the maximum output corresponds to the $y$-coordinate of the vertex. Therefore, if the vertex is $(h,k),$ then the range is $y \\leq k.$\n\nFor example, in the graph below, the $y$-value of the vertex is $y=2$, so the range of the function is $y \\leq 2.$\n\n![](images/e4/e4390b9cec5d5fce67691421479151be3592967f95d22ddde307c6d56c630879.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186124689 :activity/expected-seconds 720.0 :db/ensure [:activity/validate]}] "assertions" [[17592186124391 :question/problem "What is the domain of the function $g(x)=\\dfrac{4}{3}x^2+5x -12?$"] [17592186124391 :question/worked-solution "A quadratic function is defined for all real numbers.\n\nTherefore, the domain of $g(x)$ is $x\\in(-\\infty,\\infty).$"] [17592186124393 :question/problem "What is the range of the function $f(x) = (x+3)^2-2?$"] [17592186124393 :question/worked-solution "The parabola is written in vertex form, \n\n$$\ny = a(x-h)^2 + k,\n$$\n\nwhere $a$ is the leading coefficient and $(h,k)$ is the vertex. \n\n- Since $h=-3$ and $k=-2,$ the vertex is $(-3,-2).$\n\n- Since $a=1>0,$ the parabola opens upwards.\n\nBecause the parabola opens upwards, the vertex corresponds to the minimum output, while there is no maximum output. \n\nTherefore, the range is $[-2,\\infty).$\n\nThe corresponding diagram is shown below.\n\n![](images/57/579eef7814c2b51c44cded6fb2dc64e36d1106d359864e1e7ec7354511f80681.png)"] [17592186124225 :question/problem "What is the range of the function $f(x)=x^2+4x+6?$"] [17592186124225 :question/worked-solution "The given parabola is written in standard form,\n\n$$\ny = ax^2+bx+c,\n$$\n\nwith $a=1>0,$ $b=4,$ and $c=6.$\n\nBecause the leading coefficient is positive, the parabola opens upward. Consequently, there is no maximum output, and the vertex corresponds to the minimum output.\n\nThe $x$-coordinate of the vertex is given by\n\n$$\nx= -\\dfrac{b}{2a} = -\\dfrac{4}{2 \\cdot 1} = -2.\n$$\n\nNow, we substitute $x=-2$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & ={x}^{2}+4x+6 \\\\  & =(-2)^{2}+4(-2)+6 \\\\  & =4-8+6 \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the vertex is $(-2,2),$ and the range of the function is $[2,\\infty).$\n\n![](images/41/41b7219793120c0e37b3d910ef6a8f3754c1d9f27b784f937381743d7b7a85df.png)"] [17592186124226 :question/problem "What is the range of the function $f(x) = -\\dfrac{1}{2}(x+3)(x-1)?$"] [17592186124226 :question/worked-solution "The given parabola is written in factored form,\n\n$$\ny = a(x-x_1)(x-x_2),\n$$\n\nwith $a = -\\dfrac{1}{2} <    0.$ \n\nBecause the leading coefficient is negative, the parabola opens downward. Consequently, there is no minimum output, and the vertex corresponds to the maximum output.\n\nThe two roots of the parabola are $x_1=-3$ and $x_2=1,$ and we can find the $x$-coordinate of the vertex by taking the average of the roots:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{-3+1}{2}=-1\\end{aligned}\n$$\n\nThen, we substitute $x=-1$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & =-\\frac{1}{2}(x+3)(x-1) \\\\  & =-\\frac{1}{2}(-1+3)(-1-1) \\\\  & =-\\frac{1}{2}\\cdot 2\\cdot (-2) \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the vertex is $(-1,2),$ and the range of the function is $(-\\infty,2].$\n\n![](images/2f/2f949680675dd0b0347adc154b8be6ce301ddb2f5b1b9ab0c077a5c00f81568f.png)"] ["question-df827c7e-ce3b-5b89-941a-437f86328b7a" :question/id #uuid "df827c7e-ce3b-5b89-941a-437f86328b7a"] ["question-df827c7e-ce3b-5b89-941a-437f86328b7a" :question/math-academy-id "q-106274"] ["question-df827c7e-ce3b-5b89-941a-437f86328b7a" :question/problem "What is the domain of the function $h(x)=8{x}^{2}-4x-1?$"] ["question-df827c7e-ce3b-5b89-941a-437f86328b7a" :question/worked-solution "A quadratic function is defined for all real numbers.\n\nTherefore, the domain of $h(x)$ is $x\\in (-\\infty ,\\infty ).$"] ["question-df827c7e-ce3b-5b89-941a-437f86328b7a" :question/difficulty :question.difficulty/easy] ["answer-field-829f5ab0-8ba8-548c-bb23-b5d76fbb4d22" :answer-field/id #uuid "829f5ab0-8ba8-548c-bb23-b5d76fbb4d22"] ["answer-db13116f-35b5-5cb0-bb88-3f745d6dbe2f" :answer/id #uuid "db13116f-35b5-5cb0-bb88-3f745d6dbe2f"] ["answer-db13116f-35b5-5cb0-bb88-3f745d6dbe2f" :answer/type :answer.type/math] ["answer-db13116f-35b5-5cb0-bb88-3f745d6dbe2f" :answer/value "x\\in (-\\infty ,\\infty )"] ["answer-902ebbab-7478-5af7-9256-7c8f862f93a6" :answer/id #uuid "902ebbab-7478-5af7-9256-7c8f862f93a6"] ["answer-902ebbab-7478-5af7-9256-7c8f862f93a6" :answer/type :answer.type/math] ["answer-902ebbab-7478-5af7-9256-7c8f862f93a6" :answer/value "x\\in [-1,4]"] ["answer-44c76b2d-2338-5b08-8808-f24cc8ea5181" :answer/id #uuid "44c76b2d-2338-5b08-8808-f24cc8ea5181"] ["answer-44c76b2d-2338-5b08-8808-f24cc8ea5181" :answer/type :answer.type/math] ["answer-44c76b2d-2338-5b08-8808-f24cc8ea5181" :answer/value "x\\in [-4,8]"] ["answer-99fd63fa-18e6-55ea-901a-0243576aa56a" :answer/id #uuid "99fd63fa-18e6-55ea-901a-0243576aa56a"] ["answer-99fd63fa-18e6-55ea-901a-0243576aa56a" :answer/type :answer.type/math] ["answer-99fd63fa-18e6-55ea-901a-0243576aa56a" :answer/value "x\\in [-5,7]"] ["answer-537557a3-a7a3-54ed-be9a-305c2144a33d" :answer/id #uuid "537557a3-a7a3-54ed-be9a-305c2144a33d"] ["answer-537557a3-a7a3-54ed-be9a-305c2144a33d" :answer/type :answer.type/math] ["answer-537557a3-a7a3-54ed-be9a-305c2144a33d" :answer/value "x\\in [4,8]"] ["answer-field-829f5ab0-8ba8-548c-bb23-b5d76fbb4d22" :answer-field/key "selection"] ["answer-field-829f5ab0-8ba8-548c-bb23-b5d76fbb4d22" :answer-field/type :answer-field.type/radio] ["answer-field-829f5ab0-8ba8-548c-bb23-b5d76fbb4d22" :answer-field/correct "answer-db13116f-35b5-5cb0-bb88-3f745d6dbe2f"] ["answer-field-829f5ab0-8ba8-548c-bb23-b5d76fbb4d22" :answer-field/choices "answer-db13116f-35b5-5cb0-bb88-3f745d6dbe2f"] ["answer-field-829f5ab0-8ba8-548c-bb23-b5d76fbb4d22" :answer-field/choices "answer-902ebbab-7478-5af7-9256-7c8f862f93a6"] ["answer-field-829f5ab0-8ba8-548c-bb23-b5d76fbb4d22" :answer-field/choices "answer-44c76b2d-2338-5b08-8808-f24cc8ea5181"] ["answer-field-829f5ab0-8ba8-548c-bb23-b5d76fbb4d22" :answer-field/choices "answer-99fd63fa-18e6-55ea-901a-0243576aa56a"] ["answer-field-829f5ab0-8ba8-548c-bb23-b5d76fbb4d22" :answer-field/choices "answer-537557a3-a7a3-54ed-be9a-305c2144a33d"] ["question-df827c7e-ce3b-5b89-941a-437f86328b7a" :question/answer-fields "answer-field-829f5ab0-8ba8-548c-bb23-b5d76fbb4d22"] [17592186124583 :knowledge-point/questions "question-df827c7e-ce3b-5b89-941a-437f86328b7a"] ["question-25370e2a-dfa1-5d6f-b02b-964c5925c1f3" :question/id #uuid "25370e2a-dfa1-5d6f-b02b-964c5925c1f3"] ["question-25370e2a-dfa1-5d6f-b02b-964c5925c1f3" :question/math-academy-id "q-90889"] ["question-25370e2a-dfa1-5d6f-b02b-964c5925c1f3" :question/problem "What is the domain of the function $h(x)=\\frac{2}{3}(x+4)^{2}-6?$"] ["question-25370e2a-dfa1-5d6f-b02b-964c5925c1f3" :question/worked-solution "A quadratic function is defined for all real numbers.\n\nTherefore, the domain of $h(x)$ is $x\\in (-\\infty ,\\infty ).$"] ["question-25370e2a-dfa1-5d6f-b02b-964c5925c1f3" :question/difficulty :question.difficulty/easy] ["answer-field-0edb58d1-dd55-5c4f-8f57-2b5ac741d819" :answer-field/id #uuid "0edb58d1-dd55-5c4f-8f57-2b5ac741d819"] ["answer-e832c5ea-c832-5188-9d8f-021d53729ba6" :answer/id #uuid "e832c5ea-c832-5188-9d8f-021d53729ba6"] ["answer-e832c5ea-c832-5188-9d8f-021d53729ba6" :answer/type :answer.type/math] ["answer-e832c5ea-c832-5188-9d8f-021d53729ba6" :answer/value "x\\in (-4,\\infty )"] ["answer-8531488d-d9b5-5125-95de-79bdf7e5e0d8" :answer/id #uuid "8531488d-d9b5-5125-95de-79bdf7e5e0d8"] ["answer-8531488d-d9b5-5125-95de-79bdf7e5e0d8" :answer/type :answer.type/math] ["answer-8531488d-d9b5-5125-95de-79bdf7e5e0d8" :answer/value "x\\in (-6,\\infty )"] ["answer-a08ee424-