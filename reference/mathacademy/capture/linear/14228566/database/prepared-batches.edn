531e-9326-d4dcbc01bbdb"] ["question-0bc8d353-4f35-531e-9326-d4dcbc01bbdb" :question/math-academy-id "q-35908"] ["question-0bc8d353-4f35-531e-9326-d4dcbc01bbdb" :question/problem "What is the range of the function $y=f(x)=(x-1)^{2}-3?$"] ["question-0bc8d353-4f35-531e-9326-d4dcbc01bbdb" :question/worked-solution "The parabola is written in vertex form, \n\n$$\ny=a(x-h)^{2}+k,\n$$\n\nwhere $a$ is the leading coefficient and $(h,k)$ is the vertex. \n\n- Since $h=1$ and $k=-3,$ the vertex is $(1,-3).$\n\n- Since $a=1>0,$ the parabola opens upwards.\n\nBecause the parabola opens upwards, there is no maximum output, and the vertex corresponds to the minimum output. \n\nTherefore, the range is $[-3,\\infty ).$\n\nThe corresponding diagram is shown below.\n\n![](images/26/265532f4f4726151444ed873b875fc62c3c32a690a0ac859a318e2d4dc8fd285.png)"] ["question-0bc8d353-4f35-531e-9326-d4dcbc01bbdb" :question/difficulty :question.difficulty/easy] ["answer-field-d506de6d-4e6d-5568-a53f-79ffc50374e1" :answer-field/id #uuid "d506de6d-4e6d-5568-a53f-79ffc50374e1"] ["answer-c5d59e6e-34b2-5e9c-b08e-8f2105c0bb6e" :answer/id #uuid "c5d59e6e-34b2-5e9c-b08e-8f2105c0bb6e"] ["answer-c5d59e6e-34b2-5e9c-b08e-8f2105c0bb6e" :answer/type :answer.type/math] ["answer-c5d59e6e-34b2-5e9c-b08e-8f2105c0bb6e" :answer/value "(-\\infty ,3]"] ["answer-8e98df84-9ac6-56f7-ab33-a824ee4007cd" :answer/id #uuid "8e98df84-9ac6-56f7-ab33-a824ee4007cd"] ["answer-8e98df84-9ac6-56f7-ab33-a824ee4007cd" :answer/type :answer.type/math] ["answer-8e98df84-9ac6-56f7-ab33-a824ee4007cd" :answer/value "(-\\infty ,\\infty )"] ["answer-ec8b8a2d-5b31-5cfd-aa2c-e0f8c2791516" :answer/id #uuid "ec8b8a2d-5b31-5cfd-aa2c-e0f8c2791516"] ["answer-ec8b8a2d-5b31-5cfd-aa2c-e0f8c2791516" :answer/type :answer.type/math] ["answer-ec8b8a2d-5b31-5cfd-aa2c-e0f8c2791516" :answer/value "[-3,\\infty )"] ["answer-17490e92-f04a-51f7-b438-199eeb712801" :answer/id #uuid "17490e92-f04a-51f7-b438-199eeb712801"] ["answer-17490e92-f04a-51f7-b438-199eeb712801" 