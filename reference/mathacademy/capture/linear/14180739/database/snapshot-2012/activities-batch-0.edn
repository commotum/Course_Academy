#{[{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186079531} :activity/id #uuid "2828ce66-5563-59d5-8c3e-194de1b4bc11" :activity/scope {:db/id #edb/ref 17592186048760 :topic/id #uuid "bc360b9e-12dd-5337-833b-984ed3eed6ff" :topic/math-academy-id 651} :activity/steps [{:db/id #edb/ref 17592186079531 :step/content {:db/id #edb/ref 17592186079717 :tutorial/content "Whenever we have a fraction in an equation, we apply the multiplication principle to get rid of it. For example, consider the equation below:\n\n$$\n\\dfrac{2x+12}{3} =6\n$$\n\nSince the opposite of dividing by $3$ is multiplying by $3$, we apply the multiplication principle and multiply both sides of the equation by $3$:\n\n$$\n\\require{cancel}\n\t\\eqalign{\n\t\t\\dfrac{2x+12}{3} &=6\\\n\t\t3 \\cdot \\left(\\dfrac{2x+12}{3}\\right) &= 3 \\cdot 6\\\t\n\t\t\\cancel{3} \\cdot \\left(\\dfrac{2x+12}{\\cancel{3}}\\right) &= 18 \\\t\n\t\t2x+12 &= 18\n\t}\n$$\n\nThe process of removing the fraction is called **clearing the rational expression**. We now have an equation that we can solve using the usual methods:\n\n$$\n\\eqalign{\n\t\t2x+12 &= 18\\\n\t\t2x+12-12 &=18-12 \\   \n\t\t2x &=6 \\   \n\t\t\\dfrac{2x}{2} &=\\dfrac{6}{2} \\\n\t\tx &=3\n\t}\n$$" :tutorial/id #uuid "addac451-9882-5c9f-8aa9-adc3fbd177e6" :tutorial/math-academy-id 8050 :tutorial/title "Introduction"} :step/id #uuid "354b4bf1-8360-5dc0-abda-b916470adda6" :step/math-academy-id 52855 :step/next {:db/id #edb/ref 17592186079532}} {:db/id #edb/ref 17592186079532 :step/content {:db/id #edb/ref 17592186078577 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078164 :question/id #uuid "7adb1612-0903-5a50-b5cd-75ebf1d0dd4a" :question/math-academy-id "e-12854"} :knowledge-point/id #uuid "d21b4ce3-d80e-5894-92ce-668e64d91649" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673}] :knowledge-point/questions [{:db/id #edb/ref 17592186078865} {:db/id #edb/ref 17592186078915} {:db/id #edb/ref 17592186487304} {:db/id #edb/ref 17592186487358}] :knowledge-point/title "Clearing a Rational Expression With a Variable on One Side"} :step/id #uuid "7b71965b-0dae-52f0-a849-f9e2309d6ddf" :step/math-academy-id 52856 :step/next {:db/id #edb/ref 17592186079533}} {:db/id #edb/ref 17592186079533 :step/content {:db/id #edb/ref 17592186078578 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078165 :question/id #uuid "c176f07d-e4ee-5f8a-8b7c-7b1c62898bd8" :question/math-academy-id "e-12855"} :knowledge-point/id #uuid "d31a29c9-e053-557b-8f5a-3dd49b340144" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048213}] :knowledge-point/questions [{:db/id #edb/ref 17592186078918} {:db/id #edb/ref 17592186079136} {:db/id #edb/ref 17592186487314} {:db/id #edb/ref 17592186487341} {:db/id #edb/ref 17592186487348} {:db/id #edb/ref 17592186496333}] :knowledge-point/title "Clearing a Rational Expression With a Variable on Both Sides"} :step/id #uuid "bd68dd5d-809b-5311-add4-86314ea0eb08" :step/math-academy-id 52859 :step/next {:db/id #edb/ref 17592186079534}} {:db/id #edb/ref 17592186079534 :step/content {:db/id #edb/ref 17592186078579 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078166 :question/id #uuid "31f9d893-26fd-5b2e-9730-57c5e6cc0615" :question/math-academy-id "e-12857"} :knowledge-point/id #uuid "f9d60309-32e0-535d-b5fa-ef55787336c8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050908}] :knowledge-point/questions [{:db/id #edb/ref 17592186078863} {:db/id #edb/ref 17592186079137} {:db/id #edb/ref 17592186487309} {:db/id #edb/ref 17592186487331} {:db/id #edb/ref 17592186496271} {:db/id #edb/ref 17592186496277}] :knowledge-point/title "Clearing a Rational Expression With Binomials on Both Sides"} :step/id #uuid "a52df58b-60ee-552e-9c9c-b36e2f232a47" :step/math-academy-id 52862 :step/next {:db/id #edb/ref 17592186079535}} {:db/id #edb/ref 17592186079535 :step/content {:db/id #edb/ref 17592186078580 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078167 :question/id #uuid "de18238b-ec8a-525d-b886-b869aa736d56" :question/math-academy-id "e-12858"} :knowledge-point/id #uuid "9f22f7b2-16a9-5742-9bef-c26d774c85de" :knowledge-point/questions [{:db/id #edb/ref 17592186078862} {:db/id #edb/ref 17592186079138} {:db/id #edb/ref 17592186487340} {:db/id #edb/ref 17592186487373} {:db/id #edb/ref 17592186496249}] :knowledge-point/title "Clearing a Rational Expression That Includes a Factored Expression"} :step/id #uuid "9eb577ed-c7b6-51c4-bfa2-a112f328da1b" :step/math-academy-id 52865}] :activity/title "Solving Linear Equations by Clearing a Rational Expression" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078673}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186496358} :activity/id #uuid "d553d002-0e4d-5513-9db5-e6d5e807e0c2" :activity/scope {:db/id #edb/ref 17592186048760 :topic/id #uuid "bc360b9e-12dd-5337-833b-984ed3eed6ff" :topic/math-academy-id 651} :activity/steps [{:db/id #edb/ref 17592186496350 :step/content {:db/id #edb/ref 17592186078918 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d10803c-dc1c-51df-b6d9-3387aaeb47cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{5}" :db/id #edb/ref 17592186495650} {:answer/id #uuid "53f63b04-ee5f-56b2-8bfc-7edc1aa13c63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=5" :db/id #edb/ref 17592186495700} {:answer/id #uuid "5c693399-2537-5d16-bc08-d75a0b068d68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2" :db/id #edb/ref 17592186495722} {:answer/id #uuid "698c317a-d46e-576c-8db8-e08affaa9755" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{6}" :db/id #edb/ref 17592186495744} {:answer/id #uuid "ed96295d-5ba0-5de6-8e42-1e7af9fedd21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{2}" :db/id #edb/ref 17592186496031}] :answer-field/correct {:db/id #edb/ref 17592186496031} :answer-field/id #uuid "77ddb2f4-a245-56c0-8428-a28384aa5396" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186076286}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "15d287cc-b41b-5ff3-a7dc-97c2e50422d7" :question/math-academy-id "q-44320" :question/problem "Solve the equation $\\frac{8y+5}{3}=6y.$" :question/worked-solution "First, we clear the rational expression by multiplying the equation through by $3$:\n\n$$\n\\begin{aligned}\\frac{8y+5}{3} & =6y \\\\ 3(\\frac{8y+5}{3}) & =3\\cdot 6y \\\\ \\cancel{3}\\cdot (\\frac{8y+5}{\\cancel{3}}) & =18y \\\\ 8y+5 & =18y\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}8y+5 & =18y \\\\ 8y+5-8y & =18y-8y \\\\ 5 & =10y \\\\ \\frac{5}{10} & =\\frac{10y}{10} \\\\ \\frac{1}{2} & =y\\end{aligned}\n$$\n\nThus, $y=\\frac{1}{2}.$"} :step/id #uuid "6028f492-ba55-501f-87da-d15709c17c82" :step/next {:db/id #edb/ref 17592186496374}} {:db/id #edb/ref 17592186496357 :step/content {:db/id #edb/ref 17592186496271 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86a95d46-89a3-5b06-8221-b59e68bab013" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h=\\frac{8}{5}" :db/id #edb/ref 17592186495801} {:answer/id #uuid "bfd1647f-a339-5240-b787-f6c0d05abdbb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h=-\\frac{7}{5}" :db/id #edb/ref 17592186495931} {:answer/id #uuid "e273f529-d3a2-5eba-a46e-b61afe82fb5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h=\\frac{6}{5}" :db/id #edb/ref 17592186496011} {:answer/id #uuid "f9adebf3-6330-575d-845f-896e038bb897" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h=2" :db/id #edb/ref 17592186496054} {:answer/id #uuid "f9eecf5b-4431-5988-ac24-8ec51e2c687c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h=-1" :db/id #edb/ref 17592186496057}] :answer-field/correct {:db/id #edb/ref 17592186495801} :answer-field/id #uuid "14966880-3ea7-59e7-a17e-fec0ac900176" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496083}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6bdf897b-5216-5fe0-b918-3faeb980f813" :question/math-academy-id "q-104472" :question/problem "Solve for $h$ where $\\frac{3h-4}{2}=2-h.$" :question/worked-solution "First, we clear the rational expression by multiplying both sides by $2.$ We must make sure that all of the terms on the right-hand side are multiplied by $2:$\n\n$$\n\\begin{aligned}\\frac{3h-4}{2} & =2-h \\\\ 2\\cdot (\\frac{3h-4}{2}) & =2\\cdot (2-h) \\\\ \\cancel{2}\\cdot (\\frac{3h-4}{\\cancel{2}}) & =2\\cdot 2-2\\cdot h \\\\ 3h-4 & =4-2h\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}3h-4 & =4-2h \\\\ 3h-4+2h & =4-2h+2h \\\\ 5h-4 & =4 \\\\ 5h-4+4 & =4+4 \\\\ 5h & =8 \\\\ \\frac{5h}{5} & =\\frac{8}{5} \\\\ h & =\\frac{8}{5}\\end{aligned}\n$$"} :step/id #uuid "7206ffec-4e93-51d5-9045-454b39491a19" :step/next {:db/id #edb/ref 17592186496387}} {:db/id #edb/ref 17592186496358 :step/content {:db/id #edb/ref 17592186496277 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "290bfc84-e444-5079-8d18-8f0f58f4d969" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{11}{25}" :db/id #edb/ref 17592186495600} {:answer/id #uuid "37c0081c-72ea-53b5-830f-01d721471189" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{22}{45}" :db/id #edb/ref 17592186495642} {:answer/id #uuid "95839550-f140-5f9e-a1e5-8aa2c82702bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{45}{11}" :db/id #edb/ref 17592186495842} {:answer/id #uuid "aaf85b04-9f5b-52ba-8d31-f3f78566da82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{25}{11}" :db/id #edb/ref 17592186495892} {:answer/id #uuid "b62f4a13-9b15-5386-ab05-2a22a1b14183" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{45}{22}" :db/id #edb/ref 17592186495918}] :answer-field/correct {:db/id #edb/ref 17592186495892} :answer-field/id #uuid "e82146a9-b8b1-5e83-aeec-05796f3d090e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496203}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7e49ab95-b651-5531-ac5c-90e4392b7705" :question/math-academy-id "q-31686" :question/problem "Solve for $x$ where $\\frac{5-x}{3}=7x-15.$" :question/worked-solution "First, we clear the rational expression by multiplying the equation through by $7$:\n\n$$\n\\begin{aligned}\\frac{5-x}{3} & =7x-15 \\\\ 3(\\frac{5-x}{3}) & =3(7x-15) \\\\ \\cancel{3}(\\frac{5-x}{\\cancel{3}}) & =21x-45 \\\\ 5-x & =21x-45\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}5-x & =21x-45 \\\\ 5-x+x & =21x-45+x \\\\ 5 & =22x-45 \\\\ 5+45 & =22x-45+45 \\\\ 50 & =22x \\\\ \\frac{50}{22} & =\\frac{22x}{22} \\\\ \\frac{25}{11} & =\\frac{\\cancel{22}x}{\\cancel{22}} \\\\ x & =\\frac{25}{11}\\end{aligned}\n$$"} :step/id #uuid "799a2f4f-2697-5ff1-b785-172536801285" :step/next {:db/id #edb/ref 17592186496350}} {:db/id #edb/ref 17592186496374 :step/content {:db/id #edb/ref 17592186496333 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fb757b8-2149-526a-af68-c96954680eb4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=-3" :db/id #edb/ref 17592186495548} {:answer/id #uuid "7d66aa7f-6693-5615-970b-c7da91b05cd5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=\\frac{1}{3}" :db/id #edb/ref 17592186495778} {:answer/id #uuid "9c952b49-23cd-5299-ab3b-0fd0ba05087c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=\\frac{1}{6}" :db/id #edb/ref 17592186495857} {:answer/id #uuid "9ee350b8-cb7d-5d53-877e-b380e44154a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=-\\frac{1}{3}" :db/id #edb/ref 17592186495865} {:answer/id #uuid "a4d94021-52b3-52e5-909c-4f0d63cad22c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=-\\frac{1}{6}" :db/id #edb/ref 17592186495880}] :answer-field/correct {:db/id #edb/ref 17592186495865} :answer-field/id #uuid "3de57bae-a1f3-5ae4-b2cb-ef29b2469101" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496099}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fcf291ca-08c9-536b-b233-ba6182878dc7" :question/math-academy-id "q-44329" :question/problem "Solve for $t$ where $-2t=\\frac{4-6t}{9}.$" :question/worked-solution "First, we clear the rational expression by multiplying the equation through by $9$:\n\n$$\n\\begin{aligned}-2t & =\\frac{4-6t}{9} \\\\ \\frac{4-6t}{9} & =-2t \\\\ 9(\\frac{4-6t}{9}) & =9(-2t) \\\\ \\cancel{9}(\\frac{4-6t}{\\cancel{9}}) & =-18t \\\\ 4-6t & =-18t\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}4-6t & =-18t \\\\ 4-6t+6t & =-18t+6t \\\\ 4 & =-12t \\\\ -12t & =4 \\\\ \\frac{-12t}{-12} & =\\frac{4}{-12} \\\\ \\frac{\\cancel{-12}t}{\\cancel{-12}} & =-\\frac{1}{3} \\\\ t & =-\\frac{1}{3}\\end{aligned}\n$$"} :step/id #uuid "aff5c2ca-053d-5601-be33-a76726d11b9c" :step/next {:db/id #edb/ref 17592186496357}} {:db/id #edb/ref 17592186496387 :step/content {:db/id #edb/ref 17592186496249 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2188e8eb-24f6-567f-b4a0-82bd8c14ebf9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{10}{9}" :db/id #edb/ref 17592186495582}] :answer-field/correct {:db/id #edb/ref 17592186495582} :answer-field/id #uuid "28157b7f-c2b1-5be6-a604-5bd03e2ba7ef" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186496092}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "470fa283-2b00-51e0-9a35-7c42b40fff42" :question/math-academy-id "q-171600" :question/problem "If $\\frac{3k-2}{6}=-(k+2),$ then $k=${{field-1}}." :question/worked-solution "First, we clear the rational expression by multiplying the equation through by $6$:\n\n$$\n\\begin{aligned}\\frac{3k-2}{6} & =-(k+2) \\\\ 6\\cdot (\\frac{3k-2}{6}) & =6\\cdot (-(k+2)) \\\\ \\cancel{6}\\cdot (\\frac{3k-2}{\\cancel{6}}) & =-6(k+2) \\\\ 3k-2 & =-6k-12\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}3k-2 & =-6k-12 \\\\ 3k-2+6k & =-6k-12+6k \\\\ 9k-2 & =-12 \\\\ 9k-2+2 & =-12+2 \\\\ 9k & =-10 \\\\ \\frac{9k}{9} & =\\frac{-10}{9} \\\\ k & =-\\frac{10}{9}\\end{aligned}\n$$"} :step/id #uuid "ebdfcf53-3aab-5152-8a64-f64e55ec050a"}] :activity/title "Solving Linear Equations by Clearing a Rational Expression" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186495506}]}
