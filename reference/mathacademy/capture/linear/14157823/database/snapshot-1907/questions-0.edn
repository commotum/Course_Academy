#{[{:db/id #edb/ref 17592186063984 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064214 :knowledge-point/id #uuid "4677d3e7-6833-514c-b035-0a7bbf0495fc" :knowledge-point/title "Multiplying Polynomials"}] :question/id #uuid "7361c770-5274-5ed2-8366-e4b7ba21ff9f" :question/math-academy-id "e-14301" :question/problem "Simplify $-3t^3\\left(3t^2+2t\\right).$" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}-3{t}^{3}(3{t}^{2}+2t) & = \\\\ (-3{t}^{3})\\cdot (3{t}^{2})+(-3{t}^{3})\\cdot (2t) & = \\\\ ((-3)\\cdot 3)({t}^{3}\\cdot {t}^{2})+((-3)\\cdot 2)({t}^{3}\\cdot t) & = \\\\ (-9)({t}^{3+2})+(-6)({t}^{3+1}) & = \\\\ (-9)({t}^{5})+(-6)({t}^{4}) & = \\\\ -9{t}^{5}-6{t}^{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063985 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064215 :knowledge-point/id #uuid "c0f2a4f3-5117-5796-b35c-524c1e0514cb" :knowledge-point/title "Cases Containing Two Negative Signs"}] :question/id #uuid "e8968548-b5a7-55c9-af2e-48aecb217cc6" :question/math-academy-id "e-14304" :question/problem "Simplify $-5x\\left(x^3-4\\right).$" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}-5x({x}^{3}-4) & = \\\\ (-5x)({x}^{3})+(-5x)(-4) & = \\\\ (-5)(x\\cdot {x}^{3})+((-5)\\cdot (-4))(x) & = \\\\ (-5){x}^{1+3}+(20)x & = \\\\ -5{x}^{4}+20x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063986 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064216 :knowledge-point/id #uuid "eb972b0c-3ca7-5d79-83f9-162ea8d4076e" :knowledge-point/title "Multiplying Polynomials Containing Fractions"}] :question/id #uuid "0317d27d-9501-5de5-a55a-b9a73ce39500" :question/math-academy-id "e-14306" :question/problem "Simplify $-6x^2\\left(\\dfrac{x^3}{2}+3x^2\\right).$" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}-6{x}^{2}(\\frac{{x}^{3}}{2}+3{x}^{2}) & = \\\\ (-6{x}^{2})(\\frac{{x}^{3}}{2})+(-6{x}^{2})(3{x}^{2}) & = \\\\ (-6{x}^{2})(\\frac{1}{2}{x}^{3})+(-6{x}^{2})(3{x}^{2}) & = \\\\ ((-6)\\cdot \\frac{1}{2})({x}^{3}\\cdot {x}^{2})+((-6)\\cdot 3)({x}^{2}\\cdot {x}^{2}) & = \\\\ (-3)({x}^{3+2})+(-18)({x}^{2+2}) & = \\\\ -3{x}^{5}-18{x}^{4}\\end{aligned}\n$$\n\n**Note:** We provide the answer in *standard form*, with the terms arranged by degree in descending order."}] [{:db/id #edb/ref 17592186063987 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064217 :knowledge-point/id #uuid "a437f9a3-60c1-563d-bd6d-1816d14ffe6e" :knowledge-point/title "Multiplying Multivariable Polynomials"}] :question/id #uuid "7e3162ad-ed76-548d-a020-142ea0c0976b" :question/math-academy-id "e-14309" :question/problem "Simplify $xy\\left(3x^2+xy+4\\right).$" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}xy(3{x}^{2}+xy+4) & = \\\\ (xy)\\cdot (3{x}^{2})+(xy)\\cdot (xy)+(xy)\\cdot 4 & = \\\\ 3(x\\cdot {x}^{2})(y)+(x\\cdot x)(y\\cdot y)+4(xy) & = \\\\ 3({x}^{3})(y)+({x}^{2})({y}^{2})+4xy & = \\\\ 3{x}^{3}y+{x}^{2}{y}^{2}+4xy & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481342 :knowledge-point/_questions [{:db/id #edb/ref 17592186064215 :knowledge-point/id #uuid "c0f2a4f3-5117-5796-b35c-524c1e0514cb" :knowledge-point/title "Cases Containing Two Negative Signs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2affc424-b64d-5e66-8ac0-e677197618b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x^{5}+5x^{4}" :db/id #edb/ref 17592186480818}] :answer-field/correct {:answer/id #uuid "2affc424-b64d-5e66-8ac0-e677197618b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x^{5}+5x^{4}" :db/id #edb/ref 17592186480818} :answer-field/id #uuid "73fd6360-f6ac-52b2-8f2e-d34673fe83c2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481278}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "02b8d95c-cd10-56fd-a2ee-19a46309a688" :question/math-academy-id "q-215318" :question/problem "Expand the following product. Write your answer in **standard form.**\n\n$-{x}^{3}(2{x}^{2}-5x)=$\n{{field-1}}" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}-{x}^{3}(2{x}^{2}-5x) & = \\\\ (-{x}^{3})(2{x}^{2})+(-{x}^{3})(-5x) & = \\\\ ((-1)\\cdot 2)({x}^{3}\\cdot {x}^{2})+((-1)\\cdot (-5))({x}^{3}\\cdot x) & = \\\\ (-2){x}^{3+2}+(5){x}^{3+1} & = \\\\ -2{x}^{5}+5{x}^{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481351 :knowledge-point/_questions [{:db/id #edb/ref 17592186064214 :knowledge-point/id #uuid "4677d3e7-6833-514c-b035-0a7bbf0495fc" :knowledge-point/title "Multiplying Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f23fdbd-3fd3-56f8-9056-aa6d59dc3eab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x^{6}+8x^{2}" :db/id #edb/ref 17592186480981}] :answer-field/correct {:answer/id #uuid "7f23fdbd-3fd3-56f8-9056-aa6d59dc3eab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x^{6}+8x^{2}" :db/id #edb/ref 17592186480981} :answer-field/id #uuid "5587de01-f6eb-59f8-8ec0-eb041dd8281c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481269}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1c4a8c11-58ca-529c-a377-f348add911e4" :question/math-academy-id "q-216986" :question/problem "Expand the following product. Write your answer in **standard form.**\n\n$2{x}^{2}(3{x}^{4}+4)=$\n{{field-1}}" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}2{x}^{2}(3{x}^{4}+4) & = \\\\ 2{x}^{2}\\cdot (3{x}^{4})+2{x}^{2}\\cdot 4 & = \\\\ 6{x}^{2+4}+8{x}^{2} & = \\\\ 6{x}^{6}+8{x}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481346 :knowledge-point/_questions [{:db/id #edb/ref 17592186064215 :knowledge-point/id #uuid "c0f2a4f3-5117-5796-b35c-524c1e0514cb" :knowledge-point/title "Cases Containing Two Negative Signs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eee98293-3395-5eb0-b143-f256c73f4a75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3x^{6}+x^{3}-2x^{2}" :db/id #edb/ref 17592186481196}] :answer-field/correct {:answer/id #uuid "eee98293-3395-5eb0-b143-f256c73f4a75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3x^{6}+x^{3}-2x^{2}" :db/id #edb/ref 17592186481196} :answer-field/id #uuid "d01f0664-679f-5f38-857f-275bf91d4556" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481316}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0b6d8c42-1d59-52b0-9958-cceeca4a3dbe" :question/math-academy-id "q-216998" :question/problem "Expand the following product. Write your answer in **standard form.**\n\n$-{x}^{2}(3{x}^{4}-x+2)=$\n{{field-1}}" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}-{x}^{2}(3{x}^{4}-x+2) & = \\\\ (-{x}^{2})(3{x}^{4})+(-{x}^{2})(-x)+(-{x}^{2})2 & = \\\\ ((-1)\\cdot 3)({x}^{2}\\cdot {x}^{4})+((-1)\\cdot (-1))({x}^{2}\\cdot x)+((-1)\\cdot 2)({x}^{2}) & = \\\\ (-3){x}^{2+4}+(1){x}^{2+1}+(-2){x}^{2} & = \\\\ -3{x}^{6}+{x}^{3}-2{x}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481401 :knowledge-point/_questions [{:db/id #edb/ref 17592186064216 :knowledge-point/id #uuid "eb972b0c-3ca7-5d79-83f9-162ea8d4076e" :knowledge-point/title "Multiplying Polynomials Containing Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dedb42c4-e00d-5bfa-8c63-1f4242d6fe90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3a^{5}-5a^{2}" :db/id #edb/ref 17592186481158}] :answer-field/correct {:answer/id #uuid "dedb42c4-e00d-5bfa-8c63-1f4242d6fe90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3a^{5}-5a^{2}" :db/id #edb/ref 17592186481158} :answer-field/id #uuid "e0d39888-088e-5d8c-98c5-3147b816b4d7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186481327}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a358c984-11c0-53e4-9e16-174bbfcc06eb" :question/math-academy-id "q-217022" :question/problem "Expand the following product. Write your answer in **standard form.**\n\n$\\frac{1}{3}a(9{a}^{4}-15a)=$\n{{field-1}}" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}\\frac{1}{3}a(9{a}^{4}-15a) & = \\\\ (\\frac{1}{3}a)(9{a}^{4})+(\\frac{1}{3}a)(-15a) & = \\\\ (\\frac{1}{3}\\cdot 9)({a}^{1}\\cdot {a}^{4})+(\\frac{1}{3}\\cdot (-15))(a\\cdot a) & = \\\\ (3)({a}^{1+4})+(-5)({a}^{1+1}) & = \\\\ 3{a}^{5}-5{a}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064599 :knowledge-point/_questions [{:db/id #edb/ref 17592186064216 :knowledge-point/id #uuid "eb972b0c-3ca7-5d79-83f9-162ea8d4076e" :knowledge-point/title "Multiplying Polynomials Containing Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "837f91b7-1b58-545a-96dd-2f97327fe650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{b}^{6}-\\frac{1}{2}{b}^{4}" :db/id #edb/ref 17592186480991}] :answer-field/correct {:answer/id #uuid "837f91b7-1b58-545a-96dd-2f97327fe650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{b}^{6}-\\frac{1}{2}{b}^{4}" :db/id #edb/ref 17592186480991} :answer-field/id #uuid "c7f9fb81-1660-5d2f-8367-cb9e54b394f9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186061696} {:answer-field/choices [{:answer/id #uuid "d8e4d1a5-111b-5483-8b45-254f42d5e582" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186481144}] :answer-field/correct {:answer/id #uuid "d8e4d1a5-111b-5483-8b45-254f42d5e582" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186481144} :answer-field/id #uuid "6a2673aa-48dc-51fb-bef1-5108cb413aa9" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186061697}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3b6f2199-f93d-54e4-a4b1-9693a8b2262c" :question/math-academy-id "q-217025" :question/problem "$2{b}^{3}(-\\frac{b}{4}+{b}^{3}-\\frac{1}{3})=${{field-1}}\n$\\,-$\n{{field-2}}${b}^{3}$" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}2{b}^{3}(-\\frac{b}{4}+{b}^{3}-\\frac{1}{3}) & = \\\\ 2{b}^{3}\\cdot (-\\frac{b}{4})+2{b}^{3}\\cdot {b}^{3}+2{b}^{3}\\cdot (-\\frac{1}{3}) & = \\\\ (-\\frac{1}{2})({b}^{3+1})+2({b}^{3+3})+(-\\frac{2}{3}){b}^{3} & = \\\\ -\\frac{1}{2}{b}^{4}+2{b}^{6}-\\frac{2}{3}{b}^{3} & = \\\\ 2{b}^{6}-\\frac{1}{2}{b}^{4}-\\frac{2}{3}{b}^{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481428 :knowledge-point/_questions [{:db/id #edb/ref 17592186064214 :knowledge-point/id #uuid "4677d3e7-6833-514c-b035-0a7bbf0495fc" :knowledge-point/title "Multiplying Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38f7e8e6-c1c7-508e-8d6a-3fd5596d3fe5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{w}^{6}-6{w}^{4}-4{w}^{3}" :db/id #edb/ref 17592186480851} {:answer/id #uuid "7f860bb7-7c51-532a-820b-6f6498f5e522" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{w}^{6}+3w+2" :db/id #edb/ref 17592186480984} {:answer/id #uuid "ca26b375-4a8c-5ae3-b1e9-dd7d05125d32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{w}^{6}-6{w}^{4}+4{w}^{3}" :db/id #edb/ref 17592186481122} {:answer/id #uuid "f7876760-d7ee-5fa6-8f80-c522e35eda1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{w}^{6}-6{w}^{4}+2" :db/id #edb/ref 17592186481216} {:answer/id #uuid "f9b42dee-7635-536d-b190-e1e49a5af093" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{w}^{6}-3{w}^{4}-2{w}^{3}" :db/id #edb/ref 17592186481223}] :answer-field/correct {:answer/id #uuid "38f7e8e6-c1c7-508e-8d6a-3fd5596d3fe5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{w}^{6}-6{w}^{4}-4{w}^{3}" :db/id #edb/ref 17592186480851} :answer-field/id #uuid "2ea4164d-199b-5fa8-988a-88bdda69d024" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186481256}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "dfaf6e99-1d8f-5b5e-92bd-9fd3c571d232" :question/math-academy-id "q-44642" :question/problem "$-2{w}^{3}({w}^{3}+3w+2)=$" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}-2{w}^{3}({w}^{3}+3w+2) & = \\\\ (-2{w}^{3})({w}^{3})+(-2{w}^{3})(3w)+(-2{w}^{3})(2) & = \\\\ (-2)({w}^{3}\\cdot {w}^{3})+((-2)\\cdot 3)({w}^{3}\\cdot w)+((-2)\\cdot 2)({w}^{3}) & = \\\\ (-2){w}^{3+3}+(-6){w}^{3+1}+(-4){w}^{3} & = \\\\ -2{w}^{6}-6{w}^{4}-4{w}^{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064784 :knowledge-point/_questions [{:db/id #edb/ref 17592186064217 :knowledge-point/id #uuid "a437f9a3-60c1-563d-bd6d-1816d14ffe6e" :knowledge-point/title "Multiplying Multivariable Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "109e6613-6e55-5b3c-b18a-2c3b10925fdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7{p}^{9}{q}^{2}+3{p}^{2}{q}^{5}" :db/id #edb/ref 17592186480769} {:answer/id #uuid "88bfa841-9ff2-5a6a-8e9a-04cdcb7136de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7{p}^{9}{q}^{2}-3{p}^{6}{q}^{5}" :db/id #edb/ref 17592186481003} {:answer/id #uuid "bc3aa44a-8098-5049-9b4d-ccf6de1b1ce3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7{p}^{9}{q}^{2}-3{p}^{6}{q}^{5}" :db/id #edb/ref 17592186481096} {:answer/id #uuid "cfc92d42-9d4c-57e8-aebe-b1e