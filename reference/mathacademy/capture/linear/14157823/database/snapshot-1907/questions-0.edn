}^{3+4})({b}^{2})+(-12)({a}^{3+2})+(-8)({a}^{3}) & = \\\\ -8{a}^{7}{b}^{2}-12{a}^{5}-8{a}^{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186481368 :knowledge-point/_questions [{:db/id #edb/ref 17592186064216 :knowledge-point/id #uuid "eb972b0c-3ca7-5d79-83f9-162ea8d4076e" :knowledge-point/title "Multiplying Polynomials Containing Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e4ba564-c701-5756-89b9-c57ee635a3fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}+{x}^{6}" :db/id #edb/ref 17592186480977} {:answer/id #uuid "9939d3e9-7f4e-5cc1-9753-721ee0a8d618" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-2{x}^{6}" :db/id #edb/ref 17592186481032} {:answer/id #uuid "cf656d9b-75ef-554a-9036-89079b6ca3d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{4}-2{x}^{6}" :db/id #edb/ref 17592186481126} {:answer/id #uuid "e6b65738-d03d-56a9-a07a-8e4b68fc5c09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}+2{x}^{3}" :db/id #edb/ref 17592186481180} {:answer/id #uuid "eccfdde5-d210-5907-b9d1-5dcc7cc45b70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{4}+{x}^{6}" :db/id #edb/ref 17592186481195}] :answer-field/correct {:answer/id #uuid "cf656d9b-75ef-554a-9036-89079b6ca3d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{4}-2{x}^{6}" :db/id #edb/ref 17592186481126} :answer-field/id #uuid "711cfcc8-2acd-5237-b383-a491ba95980c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186481277}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "526966d4-b472-58c0-be00-2ffec30b650e" :question/math-academy-id "q-74584" :question/problem "$6{x}^{3}(\\frac{x}{2}-\\frac{{x}^{3}}{3})=$" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}6{x}^{3}(\\frac{x}{2}-\\frac{{x}^{3}}{3}) & = \\\\ (6{x}^{3})(\\frac{x}{2})+(6{x}^{3})(-\\frac{{x}^{3}}{3}) & = \\\\ (6{x}^{3})(\\frac{1}{2}x)+(6{x}^{3})(-\\frac{1}{3}{x}^{3}) & = \\\\ (6\\cdot \\frac{1}{2})({x}^{3}\\cdot x)+(6\\cdot (-\\frac{1}{3}))({x}^{3}\\cdot {x}^{3}) & = \\\\ (3)({x}^{3+1})+(-2)\\cdot ({x}^{3+3}) & = \\\\ 3{x}^{4}-2{x}^{6}\\end{aligned}\n$$"}]}
