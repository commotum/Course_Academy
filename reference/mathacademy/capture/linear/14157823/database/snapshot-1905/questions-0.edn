#{[{:db/id #edb/ref 17592186063984 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064214 :knowledge-point/id #uuid "4677d3e7-6833-514c-b035-0a7bbf0495fc" :knowledge-point/title "Multiplying Polynomials"}] :question/id #uuid "7361c770-5274-5ed2-8366-e4b7ba21ff9f" :question/math-academy-id "e-14301" :question/problem "Simplify $-3t^3\\left(3t^2+2t\\right)$." :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}\n-3t^{3}(3t^{2} + 2t) &=  \\\\\n(-3t^{3}) \\cdot (3t^{2}) + (-3t^{3}) \\cdot (2t) &=  \\\\\n((-3) \\cdot 3)(t^{3} \\cdot t^{2}) + ((-3) \\cdot 2)(t^{3} \\cdot t) &=  \\\\\n(-9)(t^{3 + 2}) + (-6)(t^{3 + 1}) &=  \\\\\n(-9)(t^{5}) + (-6)(t^{4}) &=  \\\\\n&= - 9t^{5} - 6t^{4}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063985 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064215 :knowledge-point/id #uuid "c0f2a4f3-5117-5796-b35c-524c1e0514cb" :knowledge-point/title "Cases Containing Two Negative Signs"}] :question/id #uuid "e8968548-b5a7-55c9-af2e-48aecb217cc6" :question/math-academy-id "e-14304" :question/problem "Simplify $-5x\\left(x^3-4\\right)$." :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}\n-5x(x^{3} - 4) &=  \\\\\n(-5x)(x^{3}) + (-5x)(-4) &=  \\\\\n(-5)(x \\cdot x^{3}) + ((-5) \\cdot (-4))(x) &=  \\\\\n(-5)x^{1 + 3} + (20)x &=  \\\\\n&= - 5x^{4} + 20x\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063986 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064216 :knowledge-point/id #uuid "eb972b0c-3ca7-5d79-83f9-162ea8d4076e" :knowledge-point/title "Multiplying Polynomials Containing Fractions"}] :question/id #uuid "0317d27d-9501-5de5-a55a-b9a73ce39500" :question/math-academy-id "e-14306" :question/problem "Simplify $-6x^2\\left(\\dfrac{x^3}{2}+3x^2\\right)$." :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}\n-6x^{2}(\\frac{x^{3}}{2} + 3x^{2}) &=  \\\\\n(-6x^{2})(\\frac{x^{3}}{2}) + (-6x^{2})(3x^{2}) &=  \\\\\n(-6x^{2})(\\frac{1}{2}x^{3}) + (-6x^{2})(3x^{2}) &=  \\\\\n((-6) \\cdot \\frac{1}{2})(x^{3} \\cdot x^{2}) + ((-6) \\cdot 3)(x^{2} \\cdot x^{2}) &=  \\\\\n(-3)(x^{3 + 2}) + (-18)(x^{2 + 2}) &=  \\\\\n&= - 3x^{5} - 18x^{4}\n\\end{aligned}\n$$\n\n**Note:** We provide the answer in *standard form*, with the terms arranged by degree in descending order."}] [{:db/id #edb/ref 17592186063987 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064217 :knowledge-point/id #uuid "a437f9a3-60c1-563d-bd6d-1816d14ffe6e" :knowledge-point/title "Multiplying Multivariable Polynomials"}] :question/id #uuid "7e3162ad-ed76-548d-a020-142ea0c0976b" :question/math-academy-id "e-14309" :question/problem "Simplify $xy\\left(3x^2+xy+4\\right)$." :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}\nxy(3x^{2} + xy + 4) &=  \\\\\n(xy) \\cdot (3x^{2}) + (xy) \\cdot (xy) + (xy) \\cdot 4 &=  \\\\\n3(x \\cdot x^{2})(y) + (x \\cdot x)(y \\cdot y) + 4(xy) &=  \\\\\n3(x^{3})(y) + (x^{2})(y^{2}) + 4xy &=  \\\\\n&= 3x^{3}y + x^{2}y^{2} + 4xy\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064599 :knowledge-point/_questions [{:db/id #edb/ref 17592186064216 :knowledge-point/id #uuid "eb972b0c-3ca7-5d79-83f9-162ea8d4076e" :knowledge-point/title "Multiplying Polynomials Containing Fractions"}] :question/answer-fields [{:answer-field/id #uuid "c7f9fb81-1660-5d2f-8367-cb9e54b394f9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :an