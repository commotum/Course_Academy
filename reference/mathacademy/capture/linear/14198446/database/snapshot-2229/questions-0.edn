b/id #edb/ref 17592186514390 :knowledge-point/_questions [{:db/id #edb/ref 17592186064168 :knowledge-point/id #uuid "85af4ca3-5e66-522a-9e5a-6efb1c7114ba" :knowledge-point/title "Finding the Antiderivative of a Radical Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "877168ac-4c34-57ba-a846-5362369f5757" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{5}{x}^{3/2}+C" :db/id #edb/ref 17592186513885} {:answer/id #uuid "943d70e7-e52b-597e-9871-44857a8a7ae4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{3}{x}^{5/2}+C" :db/id #edb/ref 17592186513915} {:answer/id #uuid "c6b24cd8-5808-5ff4-8dd5-6d0e70ccaa9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{5}{x}^{5/2}+C" :db/id #edb/ref 17592186514052} {:answer/id #uuid "e25dd75d-4458-58ea-a630-3ccbc3fecb7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{7}{x}^{3/2}+C" :db/id #edb/ref 17592186514125} {:answer/id #uuid "e355f008-e331-5495-83d3-a7df50fe8e9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}{x}^{5/2}+C" :db/id #edb/ref 17592186514130}] :answer-field/correct {:answer/id #uuid "e355f008-e331-5495-83d3-a7df50fe8e9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}{x}^{5/2}+C" :db/id #edb/ref 17592186514130} :answer-field/id #uuid "15bc8d9e-bde6-57af-844a-0b82646dbe35" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514224}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "37cc1eff-0240-5120-ba5e-14ada8bc6fca" :question/math-academy-id "q-29665" :question/problem "$\\int \\sqrt{{x}^{3}}\\,\\text{d}x=$" :question/worked-solution "We start by writing the root as a rational power, $\\sqrt{{x}^{3}}={x}^{3/2}.$ So, we can apply the power rule with $n=\\frac{3}{2}$ and get\n\n$$\n\\begin{aligned}\\int \\sqrt{{x}^{3}}\\,\\text{d}x & =\\int {x}^{3/2}\\,\\text{d}x \\\\  & =\\frac{{x}^{3/2+1}}{(\\frac{3}{2}+1)}+C \\\\  & =\\frac{{x}^{5/2}}{(\\frac{5}{2})}+C \\\\  & =\\frac{2{x}^{5/2}}{5}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{2{x}^{5/2}}{5}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{2{x}^{5/2}}{5})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{2}{5}\\frac{\\text{d}}{\\text{d}x}({x}^{5/2})+0 & = \\\\ \\frac{2}{5}\\cdot \\frac{5}{2}{x}^{5/2-1} & = \\\\ {x}^{3/2}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514383 :knowledge-point/_questions [{:db/id #edb/ref 17592186064169 :knowledge-point/id #uuid "3174cae9-484e-5ca3-8e5c-3c9cddc86145" :knowledge-point/title "Finding the Antiderivative of a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06eef846-65a9-5990-acd0-b045e13d1cf7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{x}^{3/2}+C" :db/id #edb/ref 17592186513548} {:answer/id #uuid "393f1a37-77c6-5bbd-a580-db9adc219b01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{-1/3}+C" :db/id #edb/ref 17592186513680} {:answer/id #uuid "68568d39-43ec-5afd-b396-0468db1f01fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{-1/2}+C" :db/id #edb/ref 17592186513812} {:answer/id #uuid "b0ca349d-23a9-53ce-9e6b-be88f7c8ec44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{1/2}+C" :db/id #edb/ref 17592186513996} {:answer/id #uuid "c14ac74e-1927-56c7-a26e-5732f3c912ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{-3/2}+C" :db/id #edb/ref 17592186514042}] :answer-field/correct {:answer/id #uuid "68568d39-43ec-5afd-b396-0468db1f01fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{-1/2}+C" :db/id #edb/ref 17592186513812} :answer-field/id #uuid "eae9e030-db6a-548d-840a-748c2245c7ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514337}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "28f4ccc6-88e6-5461-934d-fc36db9c8ad4" :question/math-academy-id "q-29993" :question/problem "Given that $f(x)=\\frac{1}{\\sqrt{{x}^{3}}}$ and that ${F}^{′}(x)=f(x)$, calculate $F(x).$" :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{′}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{′}(x) & =f(x) \\\\ \\int {F}^{′}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNote that $\\frac{1}{\\sqrt{{x}^{3}}}={x}^{-3/2}.$ So, we can use the power rule with $n=-\\frac{3}{2}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int \\frac{1}{\\sqrt{{x}^{3}}}\\,\\text{d}x \\\\  & =\\int {x}^{-3/2}\\,\\text{d}x \\\\  & =\\frac{{x}^{-3/2+1}}{(-\\frac{3}{2}+1)}+C \\\\  & =\\frac{{x}^{-1/2}}{(-\\frac{1}{2})}+C \\\\  & =-2{x}^{-1/2}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514446 :knowledge-point/_questions [{:db/id #edb/ref 17592186064167 :knowledge-point/id #uuid "f2a4550c-7ed7-58aa-8928-23dd1cfd0cd7" :knowledge-point/title "Finding the Antiderivative of a Monomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0387228b-625c-57a2-b9a5-65db0be7f989" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{5}+C" :db/id #edb/ref 17592186513537} {:answer/id #uuid "6b8e57bc-7acc-5bac-a92c-82592c8e49c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{4}}{4}+C" :db/id #edb/ref 17592186513823} {:answer/id #uuid "78df9ad8-f292-595e-872f-5f8ef18126cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{x}^{5}+C" :db/id #edb/ref 17592186513850} {:answer/id #uuid "aaf0e947-1093-5e50-a47b-29c991bd99cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}+C" :db/id #edb/ref 17592186513977} {:answer/id #uuid "b224165e-2200-5c30-be67-560f8a090e5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{4}}{5}+C" :db/id #edb/ref 17592186513998}] :answer-field/correct {:answer/id #uuid "aaf0e947-1093-5e50-a47b-29c991bd99cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}+C" :db/id #edb/ref 17592186513977} :answer-field/id #uuid "ee20556c-e250-51aa-b85c-fc28797d2901" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514340}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a4e1eabf-8b25-5ba2-8660-9b7cb6a5610c" :question/math-academy-id "q-29994" :question/problem "Calculate $F(x)$ given that $f(x)={x}^{4}$ and ${F}^{′}(x)=f(x).$" :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{′}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{′}(x) & =f(x) \\\\ \\int {F}^{′}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe apply the power rule with $n=4$, and we get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{4}\\,\\text{d}x \\\\  & =\\frac{{x}^{4+1}}{4+1}+C \\\\  & =\\frac{{x}^{5}}{5}+C.\\end{aligned}\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{5}}{5}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{5}}{5})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{1}{5}\\frac{\\text{d}}{\\text{d}x}({x}^{5})+0 & = \\\\ \\frac{1}{5}\\cdot 5{x}^{4} & = \\\\ {x}^{4}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234299 :knowledge-point/_questions [{:db/id #edb/ref 17592186064169 :knowledge-point/id #uuid "3174cae9-484e-5ca3-8e5c-3c9cddc86145" :knowledge-point/title "Finding the Antiderivative of a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21fbeb51-6dc3-543d-a41d-b167ecce3c56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}{x}^{-6/7}+C" :db/id #edb/ref 17592186513623} {:answer/id #uuid "3a50a15f-c07f-5fc0-8f8a-c9858dca85ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{6}{x}^{6/7}+C" :db/id #edb/ref 17592186513684} {:answer/id #uuid "47d643d4-e671-5e72-9cf0-0a89cbdb8d8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}{x}^{1/7}+C" :db/id #edb/ref 17592186513726} {:answer/id #uuid "979719be-a5ae-506b-afac-4bb48471132a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{6}{x}^{5/7}+C" :db/id #edb/ref 17592186513925} {:answer/id #uuid "b3abc2ef-10c8-500f-8329-7a3eb25bffce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{6}{x}^{6/7}+C" :db/id #edb/ref 17592186514001}] :answer-field/correct {:answer/id #uuid "3a50a15f-c07f-5fc0-8f8a-c9858dca85ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{6}{x}^{6/7}+C" :db/id #edb/ref 17592186513684} :answer-field/id #uuid "f072598f-e1c5-599b-affc-4413eaf94190" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514344}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "44529618-fcf7-5581-8bd3-a0df68de242f" :question/math-academy-id "q-71100" :question/problem "Given that $f(x)={x}^{-1/7}$ and that ${F}^{′}(x)=f(x)$, calculate $F(x).$" :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{′}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{′}(x) & =f(x) \\\\ \\int {F}^{′}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe can use the power rule with $n=-\\frac{1}{7}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-1/7}\\,\\text{d}x \\\\  & =\\frac{{x}^{-1/7+1}}{(-\\frac{1}{7}+1)}+C \\\\  & =\\frac{{x}^{6/7}}{(\\frac{6}{7})}+C \\\\  & =\\frac{7}{6}{x}^{6/7}+C.\\end{aligned}\n$$"}]}
