m\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle></mtd><mtd><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mn>0</mn><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle></mtd></mtr></mtable></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>We now count the total number of decimal places in the two factors.</p>\n<p>There are <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"170\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle style=\"color: blue;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-mstyle></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle mathcolor=\"blue\"><mn>2</mn></mstyle></math></mjx-assistive-mml></mjx-container> decimal places in <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"171\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c33\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c><mjx-c class=\"mjx-c34\"></mjx-c><mjx-c class=\"mjx-c38\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3.48</mn><mo>.</mo></math></mjx-assistive-mml></mjx-container> \nTherefore, the product will also have <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"172\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle style=\"color: blue;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-mstyle></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle mathcolor=\"blue\"><mn>2</mn></mstyle></math></mjx-assistive-mml></mjx-container> decimal places.</p>\n<p>So, we take our value of <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"173\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c35\"></mjx-c><mjx-c class=\"mjx-c32\"></mjx-c><mjx-c class=\"mjx-c32\"></mjx-c><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5220</mn></math></mjx-assistive-mml></mjx-container> and add a decimal point to make a number with <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"174\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle style=\"color: blue;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-mstyle></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle mathcolor=\"blue\"><mn>2</mn></mstyle></math></mjx-assistive-mml></mjx-container> decimal places.</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"175\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c35\"></mjx-c><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-mstyle><mjx-mspace style=\"width: 0.167em;\"></mjx-mspace></mjx-mstyle><mjx-mover><mjx-over style=\"padding-bottom: 0.111em; padding-left: 0.074em;\"><mjx-mstyle size=\"s\" style=\"color: red;\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2193\"></mjx-c></mjx-mo></mjx-mstyle></mjx-over><mjx-base><mjx-mstyle style=\"color: red;\"><mjx-mstyle style=\"background-color: lightgray;\"><mjx-mpadded><mjx-block style=\"width: 0.501em; margin: 0.112em 0px; position: relative;\"><mjx-rbox style=\"left: 0.112em; top: 0px; max-width: 0.501em;\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle></mjx-mstyle></mjx-base></mjx-mover><mjx-mstyle style=\"width: 0px; margin-right: -0.167em;\"><mjx-mspace style=\"margin-right: -0.167em;\"></mjx-mspace></mjx-mstyle><mjx-mstyle style=\"width: 0px; margin-right: -0.167em;\"><mjx-mspace style=\"margin-right: -0.167em;\"></mjx-mspace></mjx-mstyle><mjx-mstyle style=\"width: 0px; margin-right: -0.167em;\"><mjx-mspace style=\"margin-right: -0.167em;\"></mjx-mspace></mjx-mstyle><mjx-munder space=\"2\"><mjx-row><mjx-base style=\"padding-left: 0.434em;\"><mjx-texatom texclass=\"OP\"><mjx-munder><mjx-row><mjx-base style=\"padding-left: 0.4em;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-base></mjx-row><mjx-row><mjx-under style=\"padding-top: 0.105em;\"><mjx-mo class=\"mjx-n\"><mjx-stretchy-h class=\"mjx-c23DF\" style=\"width: 1.8em;\"><mjx-beg><mjx-c></mjx-c></mjx-beg><mjx-ext><mjx-c></mjx-c></mjx-ext><mjx-mid><mjx-c></mjx-c></mjx-mid><mjx-ext><mjx-c></mjx-c></mjx-ext><mjx-end><mjx-c></mjx-c></mjx-end></mjx-stretchy-h></mjx-mo></mjx-under></mjx-row></mjx-munder></mjx-texatom></mjx-base></mjx-row><mjx-row><mjx-under style=\"padding-top: 0.062em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mstyle size=\"lg\"><mjx-mrow><mjx-texatom texclass=\"ORD\"><mjx-mstyle style=\"color: blue;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-mstyle></mjx-texatom><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-cA0\"></mjx-c><mjx-c class=\"mjx-c64\"></mjx-c><mjx-c class=\"mjx-c69\"></mjx-c><mjx-c class=\"mjx-c67\"></mjx-c><mjx-c class=\"mjx-c69\"></mjx-c><mjx-c class=\"mjx-c74\"></mjx-c><mjx-c class=\"mjx-c73\"></mjx-c></mjx-mtext></mjx-mrow></mjx-mstyle></mjx-texatom></mjx-under></mjx-row></mjx-munder></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mn>52</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mover><mstyle mathcolor=\"red\"><mstyle mathbackground=\"lightgray\"><mpadded height=\"+2px\" depth=\"+2px\" lspace=\"2px\" width=\"+4px\"><mo>.</mo></mpadded></mstyle></mstyle><mstyle mathcolor=\"red\"><mo stretchy=\"false\">↓</mo></mstyle></mover><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><munder><mrow data-mjx-texclass=\"OP\"><munder><mn>20</mn><mo>⏟</mo></munder></mrow><mrow data-mjx-texclass=\"ORD\"><mstyle mathsize=\"1.2em\"><mrow><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mn>2</mn></mstyle></mrow><mtext>&nbsp;digits</mtext></mrow></mstyle></mrow></munder></math></mjx-assistive-mml></mjx-container></p>\n<p>Therefore, Carmen must pay <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"176\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"m