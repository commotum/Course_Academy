\" width=\"60\">\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$5$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n</tbody></table>\n\nFinally, since $23\\times 5=115$, we subtract $23\\times 5$ from $115.$\n\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" bgcolor=\"#EBF5FB\" height=\"20\" width=\"60\">$50$</td>\n<td align=\"center\" bgcolor=\"#EBF5FB\" height=\"20\" width=\"60\">$30$</td>\n<td align=\"center\" bgcolor=\"#EBF5FB\" height=\"20\" width=\"60\">$5$</td>\n</tr>\n<tr>\n<td align=\"right\" height=\"15\" width=\"15\">\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td bgcolor=\"#EBF5FB\">\n$23$\n</td>\n</tr>\n</tbody></table>\n</td>\n<td align=\"center\" height=\"20\" width=\"60\">\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$9$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$5$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$5$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\,$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$5$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$0$</td>\n<td align=\"center\" height=\"20\" width=\"15\"