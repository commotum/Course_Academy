 is $1 \\, \\dfrac{13}{15}.$" #edb/ref 17592186045417] [17592186144084 #edb/ref 1065 8628 #edb/ref 17592186045417] [17592186144084 #edb/ref 1066 #uuid "0435613c-64c1-5d4e-88c5-4feb68728088" #edb/ref 17592186045417] [17592186144084 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186445299 #edb/ref 1043 #edb/ref 17592186445323 #edb/ref 17592186045417] [17592186445299 #edb/ref 1044 #edb/ref 17592186045461 #edb/ref 17592186045417] [17592186445299 #edb/ref 1045 "Decimal and Mixed Number Operations" #edb/ref 17592186045417] [17592186445299 #edb/ref 1046 #edb/ref 17592186445323 #edb/ref 17592186045417] [17592186445299 #edb/ref 1053 #uuid "09b38e22-7b38-5de6-a9ef-cbc7c03d99ac" #edb/ref 17592186045417] [17592186445300 #edb/ref 1080 "4\\frac{1}{20}" #edb/ref 17592186045417] [17592186445300 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186445300 #edb/ref 1083 #uuid "5adf5daf-1367-5822-9ec3-09c2b43dc829" #edb/ref 17592186045417] [17592186445301 #edb/ref 1080 "52.20" #edb/ref 17592186045417] [17592186445301 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186445301 #edb/ref 1083 #uuid "5bb55442-b865-5577-b007-562ca745e516" #edb/ref 17592186045417] [17592186445302 #edb/ref 1080 "3\\frac{3}{8}" #edb/ref 17592186045417] [17592186445302 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186445302 #edb/ref 1083 #uuid "80e8c721-00c6-52fa-9c87-aa630d796ce8" #edb/ref 17592186045417] [17592186445303 #edb/ref 1080 "\\frac{89}{42}" #edb/ref 17592186045417] [17592186445303 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186445303 #edb/ref 1083 #uuid "8a68bafd-e384-5f9b-83b4-e06cb2184c8c" #edb/ref 17592186045417] [17592186445304 #edb/ref 1080 "3.95" #edb/ref 17592186045417] [17592186445304 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186445304 #edb/ref 1083 #uuid "e6c8494f-b16a-5986-b04a-52437f83ffe9" #edb/ref 17592186045417] [17592186445305 #edb/ref 1080 "85" #edb/ref 175921