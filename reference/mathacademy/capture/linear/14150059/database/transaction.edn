 [17592186048953 17592186049142 17592186049549 17592186051030 17592186050610 17592186050131 17592186048566] :db/ensure [:assigned-problem/validate]} {:db/id "activity-09b38e22-7b38-5de6-a9ef-cbc7c03d99ac" :activity/id #uuid "09b38e22-7b38-5de6-a9ef-cbc7c03d99ac" :activity/title "Decimal and Mixed Number Operations" :activity/type :activity.type/assignment :activity/steps ["step-119b0ff0-218b-5f1e-9e69-3c7e87742c0b"] :activity/first-step "step-119b0ff0-218b-5f1e-9e69-3c7e87742c0b" :db/ensure [:activity/validate]} {:db/id "step-119b0ff0-218b-5f1e-9e69-3c7e87742c0b" :step/id #uuid "119b0ff0-218b-5f1e-9e69-3c7e87742c0b" :step/content "assigned-problem-7eb25ce0-3c37-558a-8ba0-0a7f51774d48" :db/ensure [:step/validate]}]
