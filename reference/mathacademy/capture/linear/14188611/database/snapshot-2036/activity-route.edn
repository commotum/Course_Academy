#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186501288} :activity/id #uuid "ea710b72-1ae9-594f-81f0-bb4e388075ac" :activity/scope {:db/id #edb/ref 17592186049840 :topic/id #uuid "17f87fcb-3fe5-5ecd-ba54-8883ffee898f" :topic/math-academy-id 839} :activity/steps [{:db/id #edb/ref 17592186501256 :step/content {:db/id #edb/ref 17592186501171 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ff46960-a634-5a81-ae1f-2ca39d897a7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x=4y-3" :db/id #edb/ref 17592186500593} {:answer/id #uuid "79487712-6da4-5496-8225-aac3af672e2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4y=3x+3" :db/id #edb/ref 17592186500719} {:answer/id #uuid "b8f9749e-7d8c-55a2-9037-1039c6ab8a8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-2y=-1" :db/id #edb/ref 17592186500852} {:answer/id #uuid "dd48f16b-2a4a-5029-a026-63bc2965823a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-4y+3=0" :db/id #edb/ref 17592186500938} {:answer/id #uuid "ec6efbc0-8d44-5de2-87c8-4041efd1a2f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-4y=-3" :db/id #edb/ref 17592186500972}] :answer-field/correct {:db/id #edb/ref 17592186500972} :answer-field/id #uuid "5ecaf1bd-48c2-52f6-ac2e-e2c732914f1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186501059}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "654a7d79-4ae5-544e-b9a0-d1ca56a9cbc1" :question/math-academy-id "q-109618" :question/problem "Write $3-4y=-3x$ in standard form." :question/worked-solution "Our goal is to write the equation in the form $ax+by=c,$ where $a,b,$ and $c$ are integers with no common factors and $a\\ge 0.$\n\nWe begin by moving all of the variables to the left-hand side and all of the constants to the right-hand side. This gives\n\n$$\n3x-4y=-3.\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a\\ge 0.$ So we are done!\n\nThe standard form of the line is $3x-4y=-3.$"} :step/id #uuid "20f07fd1-d467-5612-a99b-42e2c6facda8"} {:db/id #edb/ref 17592186501288 :step/content {:db/id #edb/ref 17592186501182 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4948554b-8702-53e2-9b75-d60c9757c1b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-2y=1" :db/id #edb/ref 17592186500613} {:answer/id #uuid "81c06851-5a55-515e-b014-4e1a61503690" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2y=3x-1" :db/id #edb/ref 17592186500734} {:answer/id #uuid "9a1bd908-d894-5634-a386-eae6d2558b62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7x-4y=0" :db/id #edb/ref 17592186500780} {:answer/id #uuid "ace9b919-181f-5f85-aacf-3f2308c62bcf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-\\frac{4}{7}\\,y=0" :db/id #edb/ref 17592186500824} {:answer/id #uuid "fc01bcb9-ef79-5851-a139-46cdb6164d5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4y=7x" :db/id #edb/ref 17592186501004}] :answer-field/correct {:db/id #edb/ref 17592186500780} :answer-field/id #uuid "cf0b3dce-d893-5070-8809-d9f2b47f02b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186501112}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7638fe82-2585-52d0-beb7-40611addaef6" :question/math-academy-id "q-44202" :question/problem "What is the equation of the line that passes through the points $(0,0)$ and $(4,7)$, expressed in standard form?" :question/worked-solution "First, we will construct the point-slope form of the line. Then, we will simplify it into standard form.\n\nTo construct the point-slope form of the line, we need a point and a slope. We already have two points, so we calculate the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{7-0}{4-0}=\\frac{7}{4}\\end{aligned}\n$$\n\nThen, we use this slope along with one of the points to write the point-slope form equation of the line. It doesn't matter which point we choose, but let's choose $(0,0).$ The point-slope equation is as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-0 & =\\frac{7}{4}(x-0) \\\\ y & =\\frac{7}{4}x\\end{aligned}\n$$\n\nTo simplify the point-slope formula into standard form, we first multiply by $4$ to get rid of the fraction:\n\n$$\n\\begin{aligned}y & =\\frac{7}{4}(x) \\\\ 4\\cdot (y) & =4\\cdot \\frac{7}{4}(x) \\\\ 4y & =7x\\end{aligned}\n$$\n\nThen, we move the variables to the left side and the constant to the right side:\n\n$$\n\\begin{aligned}4y & =7x \\\\ -7x+4y & =0\\end{aligned}\n$$\n\nFinally, we multiply by $-1$ to make the $x$-coefficient positive:\n\n$$\n\\begin{aligned}-7x+4y & =0 \\\\ (-1)\\cdot (-7x+4y) & =(-1)\\cdot 0 \\\\ 7x-4y & =0\\end{aligned}\n$$\n\nSo, the standard form of the equation is $7x-4y=0.$"} :step/id #uuid "b7421da9-e8bc-5823-9858-330f84d2ecf1" :step/next {:db/id #edb/ref 17592186501292}} {:db/id #edb/ref 17592186501292 :step/content {:db/id #edb/ref 17592186501213 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa1d2cc4-2934-5c01-acf3-e4688de64dff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4x-y=6" :db/id #edb/ref 17592186500819} {:answer/id #uuid "c0d0840e-b8f1-5833-899d-775ab6668a32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x-y=3" :db/id #edb/ref 17592186500867} {:answer/id #uuid "c3d3f7b4-e921-553d-88ad-be60876e12b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2x-3" :db/id #edb/ref 17592186500877} {:answer/id #uuid "ca9d0db1-1d42-546b-8c61-bc0bc89d225c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4x+y=-6" :db/id #edb/ref 17592186500896} {:answer/id #uuid "cf99202c-1f33-5c86-9aa3-ff042e4be5ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+2y=4" :db/id #edb/ref 17592186500913}] :answer-field/correct {:db/id #edb/ref 17592186500819} :answer-field/id #uuid "2ee1d5f3-79b0-529f-9d27-584c54dd513d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186501034}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b34b9e0f-ca1a-53ee-8948-5e07722771b6" :question/math-academy-id "q-72425" :question/problem "What is the equation of the line that passes through the points $(1,-2)$ and $(3,6)$, expressed in standard form?" :question/worked-solution "First, we will construct the point-slope form of the line. Then, we will simplify it into standard form.\n\nTo construct the point-slope form of the line, we need a point and a slope. We already have two points, so we calculate the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{6-(-2)}{3-1}=\\frac{8}{2}=4\\end{aligned}\n$$\n\nThen, we use this slope along with one of the points to write the point-slope form equation of the line. It doesn't matter which point we choose, but let's choose $(1,-2).$ The point-slope equation is as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-2) & =4(x-1) \\\\ y+2 & =4(x-1)\\end{aligned}\n$$\n\nNext, we simplify the point-slope formula into standard form, moving the variables to the left side and the constant to the right side:\n\n$$\n\\begin{aligned}y+2 & =4(x-1) \\\\ y+2 & =4x-4 \\\\ y & =4x-6 \\\\ -4x+y & =-6\\end{aligned}\n$$\n\nFinally, we multiply by $-1$ to make the $x$-coefficient positive:\n\n$$\n\\begin{aligned}-4x+y & =-6 \\\\ (-1)\\cdot (-4x+y) & =(-1)\\cdot (-6) \\\\ 4x-y & =6\\end{aligned}\n$$\n\nSo, the standard form of the equation is $4x-y=6.$"} :step/id #uuid "dbbb55d2-6ac7-5cb1-a4a3-8f1b82a1b491" :step/next {:db/id #edb/ref 17592186501256}}] :activity/title "Equations of Lines in Standard Form" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186500468}]}
