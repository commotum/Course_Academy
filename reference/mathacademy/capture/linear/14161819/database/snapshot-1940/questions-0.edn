#{[{:db/id #edb/ref 17592186054411 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054781 :knowledge-point/id #uuid "57c05c87-f04c-5f15-96f6-45287dd45876" :knowledge-point/title "Solving Linear Equations that Require Subtraction"}] :question/id #uuid "ca811d3a-a7be-536b-b997-dd2355cb00d4" :question/math-academy-id "e-12999" :question/problem "Find the solution to the equation $16 + x =10.$" :question/worked-solution "First, let's rewrite the left-hand-side so that it's similar to what we've seen before.\n\n$$\nx + 16 = 10\n$$\n\nTo isolate $x$, we need to perform the *opposite* of adding $16$ to $x$, which is *subtracting* $16$ from $x.$ Remember to perform the same operation on the right-hand side.\n\n$$\n\\eqalign{\n    \t\tx + 16 &= 10 \\\n    \t\tx + 16 - 16 &= 10 - 16 \\\n\t\tx + 0 &= -6 \\\n\t\tx &= -6\n\t}\n$$"}] [{:db/id #edb/ref 17592186054412 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054782 :knowledge-point/id #uuid "3163647c-e7ba-545e-b4a7-a8a3fff2125f" :knowledge-point/title "Solving Linear Equations that Require Addition"}] :question/id #uuid "094ae644-0ce0-51e7-849f-38320770df93" :question/math-academy-id "e-13000" :question/problem "Solve the equation $x-8 =6.$" :question/worked-solution "To isolate $x$, we need to perform the *opposite* of subtracting $8$ from $x$, which is *adding* $8$ to $x.$ Remember to perform the same operation on the right-hand side.\n\n$$\n\\eqalign{\n    \t\tx-8 &= 6 \\\n\t\tx-8+8 &= 6+8 \\\n\t\tx+0 &= 14 \\\n\t\tx &= 14\n\t}\n$$"}] [{:db/id #edb/ref 17592186054413 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054783 :knowledge-point/id #uuid "51a61370-93c1-503c-bb53-af6442794f20" :knowledge-point/title "Solving Linear Equations Containing Negative Constants"}] :question/id #uuid "2d414c47-6dff-54f2-a23a-ee071f8f43fb" :question/math-academy-id "e-13001" :question/problem "What is the solution to the equation $-15 = p - 12?$" :question/worked-solution "First, let's swap the left and right-hand sides so that the variable is on the left-hand side.\n\n$$\np-12 = -15\n$$\n\nTo isolate $p$, we need to perform the *opposite* of subtracting $12$ from $p$, which is *adding* $12$ to $p.$ Remember to perform the same operation on the right-hand side.\n\n$$\n\\eqalign{\np-12 \t\t&= -15\\\np-12 + 12 \t&= -15 + 12\\\np+0\t\t\t&=-3\\\np\t\t\t&=-3    \t\t\n}\n$$"}] [{:db/id #edb/ref 17592186054414 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054784 :knowledge-point/id #uuid "82b22101-e915-51b6-a5f3-78a1f286c2bf" :knowledge-point/title "Solving Linear Equations Containing Non-Integer Constants"}] :question/id #uuid "20d2de55-4713-570b-a5df-dc1a52b6fbc3" :question/math-academy-id "e-13002" :question/problem "Solve the equation $\\dfrac{1}{2} = \\dfrac{3}{4} + z.$" :question/worked-solution "First, let's swap the left and right-hand sides so that the variable is on the left-hand side.\n\n$$\n\\begin{aligned}\\frac{1}{2} & =\\frac{3}{4}+z \\\\ \\frac{3}{4}+z & =\\frac{1}{2} \\\\ z+\\frac{3}{4} & =\\frac{1}{2}\\end{aligned}\n$$\n\nTo isolate $z$, we need to perform the *opposite* of adding $\\dfrac{3}{4}$ to $z$, which is *subtracting* $\\dfrac{3}{4}$ from $z.$ Remember to perform the same operation on the right-hand side.\n\n$$\n\\begin{aligned}z+\\frac{3}{4} & =\\frac{1}{2} \\\\ z+\\frac{3}{4}-\\frac{3}{4} & =\\frac{1}{2}-\\frac{3}{4} \\\\ z+0 & =\\frac{2}{4}-\\frac{3}{4} \\\\ z & =\\frac{2-3}{4} \\\\ z & =-\\frac{1}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186486369 :knowledge-point/_questions [{:db/id #edb/ref 17592186054784 :knowledge-point/id #uuid "82b22101-e915-51b6-a5f3-78a1f286c2bf" :knowledge-point/title "Solving Linear Equations Containing Non-Integer Constants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ce9e899-4e9e-5205-b8a7-9b6f65874ee1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "d=\\frac{15}{14}" :db/id #edb/ref 17592186485788} {:answer/id #uuid "2601ce80-d32a-54c8-8faa-4baeaa794638" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "d=-\\frac{13}{7}" :db/id #edb/ref 17592186485827} {:answer/id #uuid "7e52f4c8-1fc0-53fc-a21d-5915f65c644a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "d=-\\frac{11}{7}" :db/id #edb/ref 17592186485988} {:answer/id #uuid "8c800a6e-5fa4-5650-a133-c6573f275d8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "d=-\\frac{11}{14}" :db/id #edb/ref 17592186486016} {:answer/id #uuid "e61a7d4c-1df7-5bb5-a280-59891e321012" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "d=\\frac{1}{3}" :db/id #edb/ref 17592186486187}] :answer-field/correct {:answer/id #uuid "8c800a6e-5fa4-5650-a133-c6573f275d8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "d=-\\frac{11}{14}" :db/id #edb/ref 17592186486016} :answer-field/id #uuid "d91f9ca7-2eef-5488-b918-4c1430e488c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486328}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "31487248-c436-55c5-bd35-253c54a69e52" :question/math-academy-id "q-101696" :question/problem "Solve the equation $-\\frac{3}{2}=d-\\frac{5}{7}.$" :question/worked-solution "First, let's swap the left and right-hand sides so that the variable is on the left-hand side.\n\n$$\n\\begin{aligned}-\\frac{3}{2} & =d-\\frac{5}{7} \\\\ d-\\frac{5}{7} & =-\\frac{3}{2}\\end{aligned}\n$$\n\nTo isolate $d$, we need to perform the *opposite* of subtracting $\\frac{5}{7}$ from $d$, which is *adding* $\\frac{5}{7}$ to $d.$ Remember to perform the same operation on the right-hand side.\n\n$$\n\\begin{aligned}\\begin{aligned}d-\\frac{5}{7} & =-\\frac{3}{2} \\\\ d-\\frac{5}{7}+(\\frac{5}{7}) & =-\\frac{3}{2}+(\\frac{5}{7}) \\\\ d+0 & =-\\frac{3}{2}+\\frac{5}{7} \\\\ d & =\\frac{-3\\cdot 7+5\\cdot 2}{14} \\\\ d & =-\\frac{11}{14}\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186486358 :knowledge-point/_questions [{:db/id #edb/ref 17592186054781 :knowledge-point/id #uuid "57c05c87-f04c-5f15-96f6-45287dd45876" :knowledge-point/title "Solving Linear Equations that Require Subtraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b7e41b4-6176-5188-9c37-eacb79e380ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186485949}] :answer-field/correct {:answer/id #uuid "6b7e41b4-6176-5188-9c37-eacb79e380ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186485949} :answer-field/id #uuid "943d82ef-cd35-58ad-815c-e497dd325956" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186486298}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c147dd4-dca0-552f-b867-ea163700b916" :question/math-academy-id "q-180980" :question/problem "If $10=y+6$, then $y=${{field-1}}." :question/worked-solution "First, let's swap the left and right-hand sides so that the variable is on the left-hand side:\n\n$$\ny+6=10\n$$\n\nTo isolate $y$, we need to perform the *opposite* of adding $6$ to $y$, which is *subtracting* $6$ from $y.$ Remember to perform the same operation on the right-hand side.\n\n$$\n\\begin{aligned}y+6 & =10 \\\\ y+6-6 & =10-6 \\\\ y+0 & =4 \\\\ y & =4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186486373 :knowledge-point/_questions [{:db/id #edb/ref 17592186054781 :knowledge-point/id #uuid "57c05c87-f04c-5f15-96f6-45287dd45876" :knowledge-point/title "Solving Linear Equations that Require Subtraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d50a984-cc4d-5057-a6bd-af41905e645d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186485951}] :answer-field/correct {:answer/id #uuid "6d50a984-cc4d-5057-a6bd-af41905e645d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186485951} :answer-field/id #uuid "83710749-ba21-5f55-9039-17b0efe16f24" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186486291}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3986cd63-77a3-5a6f-85dd-edfe43896dec" :question/math-academy-id "q-180984" :question/problem "If $9=24+x$, then $x=${{field-1}}." :question/worked-solution "First, let's swap the left and right-hand sides so that the variable is on the left-hand side:\n\n$$\n24+x=9\n$$\n\nNow, let's rewrite the left-hand side so that it's similar to what we've seen before.\n\n$$\nx+24=9\n$$\n\nTo isolate $x$, we need to perform the *opposite* of adding $24$ to $x$, which is *subtracting* $24$ from $x.$ Remember to perform the same operation on the right-hand side.\n\n$$\n\\begin{aligned}x+24 & =9 \\\\ x+24-24 & =9-24 \\\\ x+0 & =-15 \\\\ x & =-15\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186486399 :knowledge-point/_questions [{:db/id #edb/ref 17592186054783 :knowledge-point/id #uuid "51a61370-93c1-503c-bb53-af6442794f20" :knowledge-point/title "Solving Linear Equations Containing Negative Constants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cac9c78-dacd-5647-8379-091ce37e41aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186486046}] :answer-field/correct {:answer/id #uuid "9cac9c78-dacd-5647-8379-091ce37e41aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186486046} :answer-field/id #uuid "ecc76ff5-f206-5c3c-8076-84a236b35620" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186486337}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "736d5036-26f1-5b6e-8cfe-36a95468ae26" :question/math-academy-id "q-180989" :question/problem "If $-6+z=-10$, then $z=${{field-1}}." :question/worked-solution "First, let's rewrite the left-hand side so that the first term contains the variable.\n\n$$\nz-6=-10\n$$\n\nTo isolate $z$, we need to perform the *opposite* of subtracting $6$ from $z$, which is *adding* $6$ to $z.$ Remember to perform the same operation on the right-hand side.\n\n$$\n\\begin{aligned}z-6 & =-10 \\\\ z-6+6 & =-10+6 \\\\ z+0 & =-4 \\\\ z & =-4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186486354 :knowledge-point/_questions [{:db/id #edb/ref 17592186054783 :knowledge-point/id #uuid "51a61370-93c1-503c-bb53-af6442794f20" :knowledge-point/title "Solving Linear Equations Containing Negative Constants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7dd12503-6bd8-5ef9-930a-b3ef8afdfae5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186485986}] :answer-field/correct {:answer/id #uuid "7dd12503-6bd8-5ef9-930a-b3ef8afdfae5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186485986} :answer-field/id #uuid "04c99036-7c9c-54e0-b3d1-460c9227d8ea" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186486233}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "043ab138-84ef-5c4b-b56a-4e4fc7c053fd" :question/math-academy-id "q-180993" :question/problem "If $-6=x+10$, then $x=${{field-1}}." :question/worked-solution "First, let's swap the left and right-hand sides so that the variable is on the left-hand side:\n\n$$\nx+10=-6\n$$\n\nTo isolate $x$, we need to perform the *opposite* of adding $10$ to $x,$ which is *subtracting* $10$ from $x.$ Remember to perform the same operation on the right-hand side.\n\n$$\n\\begin{aligned}x+10 & =-6 \\\\ x+10-10 & =-6-10 \\\\ x+0 & =-16 \\\\ x & =-16\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186486401 :knowledge-point/_questions [{:db/id #edb/ref 17592186054782 :knowledge-point/id #uuid "3163647c-e7ba-545e-b4a7-a8a3fff2125f" :knowledge-point/title "Solving Linear Equations that Require Addition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28ecdb8e-44c9-59ad-bdfc-c9386de01c31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186485835}] :answer-field/correct {:answer/id #uuid "28ecdb8e-44c9-59ad-bdfc-c9386de01c31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186485835} :answer-field/id #uuid "39cbddcf-3b52-59f3-b6dc-9e70e1d68663" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186486259}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "77be8e09-9be9-505d-8aa2-d0adf8a864fa" :question/math-academy-id "q-181006" :question/problem "If $15=x-3$, then $x=${{field-1}}." :question/worked-solution "First, let's swap the left and right-hand sides so that the variable is on the left-hand side:\n\n$$\nx-3=15\n$$\n\nTo isolate $x$, we need to perform the *opposite* of subtracting $3$ from $x$, which is *adding* $3$ to $x.$ Remember to perform the same operation on the right-hand side.\n\n$$\n\\begin{aligned}x-3 & =15 \\\\ x-3+3 & =15+3 \\\\ x+0 & =18 \\\\ x & =18\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186486414 :knowledge-point/_questions [{:db/id #edb/ref 17592186054784 :knowledge-point/id #uuid "82b22101-e915-51b6-a5f3-78a1f286c2bf" :knowledge-point/title "Solving Linear Equations Containing Non-Integer Constants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fd23cb5-e0b2-55bf-b426-9e17d7324bcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.5" :db/id #edb/ref 17592186486023}] :answer-field/correct {:answer/id #uuid "8fd23cb5-e0b2-55bf-b426-9e17d7324bcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.5" :db/id #edb/ref 17592186486023} :answer-field/id #uuid "76a46df6-fe4f-5895-9720-9d0905f45ac5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186486287}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "941b508e-aebd-563b-866c-d5adaa00b1e5" :question/math-academy-id "q-181042" :question/problem "If $y-3=5.5$, then $y=${{field-1}}." :question/worked-solution "To isolate $y$, we need to perform the *opposite* of subtracting $3$ from $y$, which is *adding* $3$ to $y.$ Remember to perform the same operation on the right-hand side.\n\n$$\n\\begin{aligned}y-3 & =5.5 \\\\ y-3+3 & =5.5+3 \\\\ y+0 & =8.5 \\\\ y & =8.5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186486352 :knowledge-point/_questions [{:db/id #edb/ref 17592186054782 :knowledge-point/id #uuid "3163647c-e7ba-545e-b4a7-a8a3fff2125f" :knowledge-point/title "Solving Linear Equations that Require Addition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f7a255b-4a91-5596-9df1-aafd7a9adfbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186485817} {:answer/id #uuid "2fc5fe22-3209-5a7a-b2b2-9e678a15c74d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186485854} {:answer/id #uuid "395110e5-1076-5070-ba69-53775b81bab0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186485876} {:answer/id #uuid "c305a84e-ea0f-5f3e-896d-f367c6aa26d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186486115} {:answer/id #uuid "d2bda3b0-7850-52d9-ada7-c8caf05b38a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186486152}] :answer-field/correct {:answer/id #uuid "c305a84e-ea0f-5f3e-896d-f367c6aa26d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186486115} :answer-field/id #uuid "ad261364-702a-548e-ab79-71e6148c2a9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486309}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "01f80443-1b6b-56dd-8e11-094071306f79" :question/math-academy-id "q-75381" :question/problem "If $-22+x=11$, then $x=$" :question/worked-solution "First, let's rewrite the left-hand side so that the first term contains the variable.\n\n$$\nx-22=11\n$$\n\nTo isolate $x$, we need to perform the *opposite* of subtracting $22$ from $x$, which is *adding* $22$ to $x.$ Remember to perform the same operation on the right-hand side.\n\n$$\n\\begin{aligned}x-22 & =11 \\\\ x-22+22 & =11+22 \\\\ x+0 & =33 \\\\ x & =33\\end{aligned}\n$$"}]}
