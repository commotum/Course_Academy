d></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.6em 0.6em 0.6em 0.3em\"><mtr><mtd><mi>y</mi><mo>+</mo><mn>6</mn></mtd><mtd><mi></mi><mo>=</mo><mn>10</mn></mtd></mtr><mtr><mtd><mi>y</mi><mo>+</mo><mn>6</mn><mo>−</mo><mn>6</mn></mtd><mtd><mi></mi><mo>=</mo><mn>10</mn><mo>−</mo><mn>6</mn></mtd></mtr><mtr><mtd><mi>y</mi><mo>+</mo><mn>0</mn></mtd><mtd><mi></mi><mo>=</mo><mn>4</mn></mtd></mtr><mtr><mtd><mi>y</mi></mtd><mtd><mi></mi><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>4</mn></mpadded></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container> </p>\n</div></div>",
