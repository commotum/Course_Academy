#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186106737} :activity/id #uuid "2fb56d40-545a-510d-a693-25bf992fdb77" :activity/scope {:db/id #edb/ref 17592186048921 :topic/id #uuid "cc9dbee5-9d12-52e7-a3e4-6d1b31e3ecaf" :topic/math-academy-id 1386} :activity/steps [{:db/id #edb/ref 17592186106737 :step/content {:db/id #edb/ref 17592186107044 :tutorial/content "Consider the triangle $\\triangle ABC$ shown below.\n\n![](images/46/46a85010d46969ffb7df440efd72bb3fa8d1394b35cc2887ee4567cda15079c5.png)\n\nThe sum of the length of its sides is called the **perimeter**. Here, the perimeter of our triangle is\n\n$$\n\\begin{aligned}p & =AB+BC+AC \\\\  & =2+4.2+3.8 \\\\  & =10\\,\\text{cm}.\\end{aligned}\n$$" :tutorial/id #uuid "7664d7c3-e47c-57b6-97aa-1131f036852c" :tutorial/math-academy-id 2244 :tutorial/title "Introduction"} :step/id #uuid "2dd79ef0-aa4a-5d52-ba67-92d8d47fd909" :step/math-academy-id 623181 :step/next {:db/id #edb/ref 17592186106738}} {:db/id #edb/ref 17592186106738 :step/content {:db/id #edb/ref 17592186105806 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105528 :question/id #uuid "00942425-ab13-5a50-a63a-d29cf2f34889" :question/math-academy-id "e-2752"} :knowledge-point/id #uuid "b1d4b0c2-10d0-5c3a-8a58-4d7598dd9f96" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049027} {:db/id #edb/ref 17592186050410}] :knowledge-point/questions [{:db/id #edb/ref 17592186106137} {:db/id #edb/ref 17592186106384} {:db/id #edb/ref 17592186492074} {:db/id #edb/ref 17592186553559}] :knowledge-point/title "Calculating the Perimeter of a Triangle Given the Perimeter of Another Triangle"} :step/id #uuid "48b5c886-bff4-52b2-b702-6be7c990ade1" :step/math-academy-id 623182 :step/next {:db/id #edb/ref 17592186106739}} {:db/id #edb/ref 17592186106739 :step/content {:db/id #edb/ref 17592186107045 :tutorial/content "Suppose we have a quadrilateral $ABCD$ as shown below and it is known that ${AD} = 6\\,\\mathrm{m},$ ${AB} = 2\\,\\mathrm{m},$ ${BC} = 4\\,\\mathrm{m},$ and $CD=5\\,\\mathrm{m}.$ What is the perimeter of the quadrilateral?   \n\n![](images/a7/a74251f1c72eccad42b98e0d3fd9a7e7cd0a60018a6f03bb65ec2abc34eb1c88.png)\n\nRemember that the **perimeter** $p$ of a polygon is the sum of the measures of all its sides. So, we can simply calculate \n\n$$\n\\begin{aligned}p & =AD+AB+BC+CD \\\\  & =6+2+4+5 \\\\  & =17\\,m.\\end{aligned}\n$$" :tutorial/id #uuid "0428807f-e6a6-5280-81bc-ab454203aebf" :tutorial/math-academy-id 2246 :tutorial/title "Perimeters of Polygons"} :step/id #uuid "2154c4c2-efe1-5888-87e0-905e612555d4" :step/math-academy-id 623185 :step/next {:db/id #edb/ref 17592186106740}} {:db/id #edb/ref 17592186106740 :step/content {:db/id #edb/ref 17592186105807 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105529 :question/id #uuid "b4864184-6983-58ab-9787-524e04dc5c73" :question/math-academy-id "e-2754"} :knowledge-point/id #uuid "6f6c0ca1-297a-5f25-bccf-c74d0c565c24" :knowledge-point/questions [{:db/id #edb/ref 17592186106202} {:db/id #edb/ref 17592186106203} {:db/id #edb/ref 17592186492033} {:db/id #edb/ref 17592186492041} {:db/id #edb/ref 17592186508050} {:db/id #edb/ref 17592186508083} {:db/id #edb/ref 17592186554609} {:db/id #edb/ref 17592186554635}] :knowledge-point/title "Calculating the Perimeter of a Polygon"} :step/id #uuid "2896eab9-aca7-5163-8e08-2101c4fa2827" :step/math-academy-id 623186 :step/next {:db/id #edb/ref 17592186106741}} {:db/id #edb/ref 17592186106741 :step/content {:db/id #edb/ref 17592186107046 :tutorial/content "Let's take a look at the polygons depicted below and find their perimeters.\n\n![](images/69/69ef06a71f13625ad4525a03966f4a4c62ae2b2136b085e97b8dc02a6a6963cc.png)\n\nFrom the picture, we conclude that polygons I, II and III all have a perimeter of $10$ while polygon IV has a perimeter of $8.$ \n\nPolygons that have the same perimeter are called **isoperimetric**. So I, II and III are isoperimetric polygons." :tutorial/id #uuid "596db00e-9cf7-51e1-902e-73c6670780eb" :tutorial/math-academy-id 2247 :tutorial/title "Isoperimetric Polygons"} :step/id #uuid "ffc5ce2a-4bcb-5660-a1ce-e79bd1b4c604" :step/math-academy-id 623189 :step/next {:db/id #edb/ref 17592186106742}} {:db/id #edb/ref 17592186106742 :step/content {:db/id #edb/ref 17592186105808 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105530 :question/id #uuid "3de76784-4137-5093-9c35-847edd10ef62" :question/math-academy-id "e-2756"} :knowledge-point/id #uuid "b2c2a15f-617d-5515-98a8-ccdc525092b3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050613}] :knowledge-point/questions [{:db/id #edb/ref 17592186106204} {:db/id #edb/ref 17592186106205} {:db/id #edb/ref 17592186492007} {:db/id #edb/ref 17592186492071} {:db/id #edb/ref 17592186554555}] :knowledge-point/title "Determining the Value of Variables Given Two Isoperimetric Polygons"} :step/id #uuid "ec3bbafa-69db-5676-8013-221157e979a6" :step/math-academy-id 623190}] :activity/title "The Perimeter of a Polygon" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186106009}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186554667} :activity/id #uuid "4303ae32-a6ba-5a31-8a6a-e566692196a7" :activity/scope {:db/id #edb/ref 17592186048921 :topic/id #uuid "cc9dbee5-9d12-52e7-a3e4-6d1b31e3ecaf" :topic/math-academy-id 1386} :activity/steps [{:db/id #edb/ref 17592186554648 :step/content {:db/id #edb/ref 17592186554609 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b2e2633-7df5-5313-b16c-b0f4eabf3255" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\,cm" :db/id #edb/ref 17592186553893} {:answer/id #uuid "b01d977b-12e8-59fc-ac22-06c8c441998c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\,cm" :db/id #edb/ref 17592186554260} {:answer/id #uuid "ba644bff-0fa5-5829-99df-dc9253a8e3ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15\\,cm" :db/id #edb/ref 17592186554274} {:answer/id #uuid "da6cde5f-8797-5f63-b6e4-8ec5bc065aa6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9\\,cm" :db/id #edb/ref 17592186554346} {:answer/id #uuid "e97ec4f4-b752-5df9-97cf-87185fcd634e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16\\,cm" :db/id #edb/ref 17592186554377}] :answer-field/correct {:db/id #edb/ref 17592186554260} :answer-field/id #uuid "e9b51d7b-17fc-5ee3-a798-42015df0b697" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186554527}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9bda3ed0-c16c-5140-97eb-7ad72121a660" :question/math-academy-id "q-120787" :question/problem "In the regular octagon $ABCDEFGH$, we have $CD=1.5\\,cm.$ What is the perimeter of the octagon?" :question/worked-solution "The perimeter $p$ of a polygon is the sum of the measures of all its sides. Since all the sides of a regular octagon are equal and the measure of one of them is $1.5\\,cm$, we have \n\n$$\np=8\\cdot CD=8\\cdot 1.5=12\\,cm.\n$$"} :step/id #uuid "0c9bd898-fab7-54c1-83ae-93d8a8161ea8"} {:db/id #edb/ref 17592186554659 :step/content {:db/id #edb/ref 17592186554635 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b28ace1-d2a4-5cf6-bd0b-d54c77a0ca31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\,cm" :db/id #edb/ref 17592186553892} {:answer/id #uuid "7e64ef2b-f990-540e-ab94-68e997b2823f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16\\,cm" :db/id #edb/ref 17592186554123} {:answer/id #uuid "af42c5cf-a8f0-57e5-9328-b3b57686f2cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20\\,cm" :db/id #edb/ref 17592186554257} {:answer/id #uuid "c7ef95ce-2cfe-5f0c-9a38-55d3a654fdd3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\,cm" :db/id #edb/ref 17592186554308} {:answer/id #uuid "d59ef339-bd7c-5cf1-8181-b3eea9c355cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25\\,cm" :db/id #edb/ref 17592186554335}] :answer-field/correct {:db/id #edb/ref 17592186554308} :answer-field/id #uuid "ac754ef8-8a92-57f1-83bb-568d71efea89" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186554496}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ef8d594b-7df8-58f6-be78-cc667ee70380" :question/math-academy-id "q-67871" :question/problem "In a quadrilateral $ABCD,$ the measures of the sides are $AB=17\\,mm,$ $BC=14\\,mm,$ $CD=2\\,cm,$ and $DA=9\\,mm.$\nWhat is the perimeter of the quadrilateral?" :question/worked-solution "Most of the measures are given in $mm$ (millimeters), so we will start by converting all the measures to $mm$ and adding them up:\n\n$$\n\\begin{aligned}p & =17\\,mm+14\\,mm+\\overset{2\\,cm}{\\overset{⏞}{20\\,mm}}+9\\,mm \\\\  & =60\\,mm\\end{aligned}\n$$\n\nFinally, since the perimeter is a large quantity of $\\text{mm},$ we will convert to $\\text{cm}:$\n\n$$\np=60\\,mm=6\\,cm.\n$$"} :step/id #uuid "2fe99cc3-cf10-59ef-aaff-06e6316d17c8" :step/next {:db/id #edb/ref 17592186554648}} {:db/id #edb/ref 17592186554667 :step/content {:db/id #edb/ref 17592186554555 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b50dcf-3dca-5df9-809e-6982d942ec58" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ee/ee38f7125c6653ef45025cb37edc34859c689afe2989b9152cb71a4438315373.png" :db/id #edb/ref 17592186553868} {:answer/id #uuid "858e9dfa-a8de-51c4-817c-4d66fa093276" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/00/00bb0e381bc28260b29e35344882c609417b779874659b0fc1b22b18f8b7f36f.png" :db/id #edb/ref 17592186554144} {:answer/id #uuid "a6965421-5124-5c84-acc3-9ace456f77ee" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e4/e40d126b8304f762f95026016e13c193994fbb7f70f3173a86a35a08526a3bdb.png" :db/id #edb/ref 17592186554236} {:answer/id #uuid "f2d04142-0375-59e3-8b83-0d47326fe9ce" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/d7/d7b363e7150899daa28bb3097b6b31174b63beb0f01a9d0b0a6f8382ec5dcafd.png" :db/id #edb/ref 17592186554394} {:answer/id #uuid "fbd4d47a-0415-50ae-8e04-d71876767c8f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/09/091b2911311df4593655b7006bec4bb2c7bc459a3efcbdf5464f953620044a22.png" :db/id #edb/ref 17592186554414}] :answer-field/correct {:db/id #edb/ref 17592186554236} :answer-field/id #uuid "d2b10337-7261-5902-bb66-e43af38982e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186554519}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "29ae9066-cb5e-58ca-bc97-42812b49b53a" :question/math-academy-id "q-22657" :question/problem "![](images/6d/6d6009de9ef5df47144f36eb42393b7e9f77ab5c70e3606db09e48bf98289ecb.png)\n\nWhich of the following polygons has the same perimeter as the hexagon $ABCDEF$ shown above?" :question/worked-solution "The perimeter of the triangle shown below is $17$, as well as the perimeter of the given hexagon. Among the options given, the triangle is the only one that satisfies this. \n\n![](images/e4/e40d126b8304f762f95026016e13c193994fbb7f70f3173a86a35a08526a3bdb.png)"} :step/id #uuid "3e2e88f8-0f28-5880-a50b-2393532fb354" :step/next {:db/id #edb/ref 17592186554659}}] :activity/title "The Perimeter of a Polygon" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186553843}]}
