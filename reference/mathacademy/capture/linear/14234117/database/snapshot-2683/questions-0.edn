#{[{:db/id #edb/ref 17592186554609 :knowledge-point/_questions [{:db/id #edb/ref 17592186105807 :knowledge-point/id #uuid "6f6c0ca1-297a-5f25-bccf-c74d0c565c24" :knowledge-point/title "Calculating the Perimeter of a Polygon"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b2e2633-7df5-5313-b16c-b0f4eabf3255" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,cm" :db/id #edb/ref 17592186553893} {:answer/id #uuid "b01d977b-12e8-59fc-ac22-06c8c441998c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,cm" :db/id #edb/ref 17592186554260} {:answer/id #uuid "ba644bff-0fa5-5829-99df-dc9253a8e3ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15\\,cm" :db/id #edb/ref 17592186554274} {:answer/id #uuid "da6cde5f-8797-5f63-b6e4-8ec5bc065aa6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\,cm" :db/id #edb/ref 17592186554346} {:answer/id #uuid "e97ec4f4-b752-5df9-97cf-87185fcd634e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\,cm" :db/id #edb/ref 17592186554377}] :answer-field/correct {:answer/id #uuid "b01d977b-12e8-59fc-ac22-06c8c441998c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,cm" :db/id #edb/ref 17592186554260} :answer-field/id #uuid "e9b51d7b-17fc-5ee3-a798-42015df0b697" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554527}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9bda3ed0-c16c-5140-97eb-7ad72121a660" :question/math-academy-id "q-120787" :question/problem "In the regular octagon $ABCDEFGH$, we have $CD=1.5\\,cm.$ What is the perimeter of the octagon?" :question/worked-solution "The perimeter $p$ of a polygon is the sum of the measures of all its sides. Since all the sides of a regular octagon are equal and the measure of one of them is $1.5\\,cm$, we have \n\n$$\np=8\\cdot CD=8\\cdot 1.5=12\\,cm.\n$$"}] [{:db/id #edb/ref 17592186554555 :knowledge-point/_questions [{:db/id #edb/ref 17592186105808 :knowledge-point/id #uuid "b2c2a15f-617d-5515-98a8-ccdc525092b3" :knowledge-point/title "Determining the Value of Variables Given Two Isoperimetric Polygons"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b50dcf-3dca-5df9-809e-6982d942ec58" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ee/ee38f7125c6653ef45025cb37edc34859c689afe2989b9152cb71a4438315373.png" :db/id #edb/ref 17592186553868} {:answer/id #uuid "858e9dfa-a8de-51c4-817c-4d66fa093276" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/00/00bb0e381bc28260b29e35344882c609417b779874659b0fc1b22b18f8b7f36f.png" :db/id #edb/ref 17592186554144} {:answer/id #uuid "a6965421-5124-5c84-acc3-9ace456f77ee" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e4/e40d126b8304f762f95026016e13c193994fbb7f70f3173a86a35a08526a3bdb.png" :db/id #edb/ref 17592186554236} {:answer/id #uuid "f2d04142-0375-59e3-8b83-0d47326fe9ce" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d7/d7b363e7150899daa28bb3097b6b31174b63beb0f01a9d0b0a6f8382ec5dcafd.png" :db/id #edb/ref 17592186554394} {:answer/id #uuid "fbd4d47a-0415-50ae-8e04-d71876767c8f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/09/091b2911311df4593655b7006bec4bb2c7bc459a3efcbdf5464f953620044a22.png" :db/id #edb/ref 17592186554414}] :answer-field/correct {:answer/id #uuid "a6965421-5124-5c84-acc3-9ace456f77ee" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e4/e40d126b8304f762f95026016e13c193994fbb7f70f3173a86a35a08526a3bdb.png" :db/id #edb/ref 17592186554236} :answer-field/id #uuid "d2b10337-7261-5902-bb66-e43af38982e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554519}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "29ae9066-cb5e-58ca-bc97-42812b49b53a" :question/math-academy-id "q-22657" :question/problem "![](images/6d/6d6009de9ef5df47144f36eb42393b7e9f77ab5c70e3606db09e48bf98289ecb.png)\n\nWhich of the following polygons has the same perimeter as the hexagon $ABCDEF$ shown above?" :question/worked-solution "The perimeter of the triangle shown below is $17$, as well as the perimeter of the given hexagon. Among the options given, the triangle is the only one that satisfies this. \n\n![](images/e4/e40d126b8304f762f95026016e13c193994fbb7f70f3173a86a35a08526a3bdb.png)"}] [{:db/id #edb/ref 17592186554635 :knowledge-point/_questions [{:db/id #edb/ref 17592186105807 :knowledge-point/id #uuid "6f6c0ca1-297a-5f25-bccf-c74d0c565c24" :knowledge-point/title "Calculating the Perimeter of a Polygon"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b28ace1-d2a4-5cf6-bd0b-d54c77a0ca31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,cm" :db/id #edb/ref 17592186553892} {:answer/id #uuid "7e64ef2b-f990-540e-ab94-68e997b2823f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\,cm" :db/id #edb/ref 17592186554123} {:answer/id #uuid "af42c5cf-a8f0-57e5-9328-b3b57686f2cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20\\,cm" :db/id #edb/ref 17592186554257} {:answer/id #uuid "c7ef95ce-2cfe-5f0c-9a38-55d3a654fdd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,cm" :db/id #edb/ref 17592186554308} {:answer/id #uuid "d59ef339-bd7c-5cf1-8181-b3eea9c355cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25\\,cm" :db/id #edb/ref 17592186554335}] :answer-field/correct {:answer/id #uuid "c7ef95ce-2cfe-5f0c-9a38-55d3a654fdd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,cm" :db/id #edb/ref 17592186554308} :answer-field/id #uuid "ac754ef8-8a92-57f1-83bb-568d71efea89" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554496}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ef8d594b-7df8-58f6-be78-cc667ee70380" :question/math-academy-id "q-67871" :question/problem "In a quadrilateral $ABCD,$ the measures of the sides are $AB=17\\,mm,$ $BC=14\\,mm,$ $CD=2\\,cm,$ and $DA=9\\,mm.$\nWhat is the perimeter of the quadrilateral?" :question/worked-solution "Most of the measures are given in $mm$ (millimeters), so we will start by converting all the measures to $mm$ and adding them up:\n\n$$\n\\begin{aligned}p & =17\\,mm+14\\,mm+\\overset{2\\,cm}{\\overset{⏞}{20\\,mm}}+9\\,mm \\\\  & =60\\,mm\\end{aligned}\n$$\n\nFinally, since the perimeter is a large quantity of $\\text{mm},$ we will convert to $\\text{cm}:$\n\n$$\np=60\\,mm=6\\,cm.\n$$"}]}
