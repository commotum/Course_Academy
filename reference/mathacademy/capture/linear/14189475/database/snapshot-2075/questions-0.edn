#{[{:db/id #edb/ref 17592186179463 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179763 :knowledge-point/id #uuid "477301de-0888-5f46-84cc-5b2939516e7b" :knowledge-point/title "Simplifying Expressions Containing Radicals"}] :question/id #uuid "13f8fdac-32c2-5f2a-a818-cde14e59299e" :question/math-academy-id "e-1373" :question/problem "Simplify $9\\sqrt{p - 4} - 7\\sqrt{p - 4} .$" :question/worked-solution "We can combine the two $\\sqrt{p - 4}$ terms together, as follows:\n\n$$\n\\begin{aligned}9\\sqrt{p-4}-7\\sqrt{p-4} & = \\\\ (9-7)\\sqrt{p-4} & = \\\\ 2\\sqrt{p-4} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186179464 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179764 :knowledge-point/id #uuid "35580c97-b64e-55a3-b71e-9190dbcac10b" :knowledge-point/title "Simplifying Sums of Radicals Using the Product Rule"}] :question/id #uuid "eb35e7da-e6d0-5811-a2ee-92390f71c5f7" :question/math-academy-id "e-1374" :question/problem "Simplify $\\sqrt{12x}-\\sqrt{27x}.$" :question/worked-solution "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}\\sqrt{12x}-\\sqrt{27x} & = \\\\ \\sqrt{4\\cdot 3x}-\\sqrt{9\\cdot 3x} & = \\\\ \\sqrt{4}\\cdot \\sqrt{3x}-\\sqrt{9}\\cdot \\sqrt{3x} & = \\\\ 2\\cdot \\sqrt{3x}-3\\cdot \\sqrt{3x} & = \\\\ 2\\sqrt{3x}-3\\sqrt{3x}\\end{aligned}\n$$\n\nFinally, we combine like terms:\n\n$$\n\\begin{aligned}2\\sqrt{3x}-3\\sqrt{3x} & = \\\\ (2-3)\\cdot \\sqrt{3x} & = \\\\ (-1)\\cdot \\sqrt{3x} & = \\\\ -\\sqrt{3x}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186179619 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179751 :knowledge-point/id #uuid "79a1c2e0-4183-58c6-ac88-0a4856b751a2" :knowledge-point/title "Simplifying Sums of Radicals with Cube Roots"}] :question/id #uuid "213ad0ee-813b-5a4b-8926-5fbd1aed4906" :question/math-academy-id "e-9723" :question/problem "Simplify $10\\sqrt[3]{y} + 2\\sqrt[3]{y} - 7\\sqrt{y}.$" :question/worked-solution "We can combine the two $\\sqrt[3]{y}$ terms together, but we cannot combine the $\\sqrt[3]{y}$ and $\\sqrt{y}$ terms:\n\n$$\n\\eqalign{\n\t\t10\\sqrt[3]{y} + 2\\sqrt[3]{y} - 7\\sqrt{y} &= \\[5pt]\n\t\t(10 + 2)\\sqrt[3]{y} - 7\\sqrt{y} &= \\[5pt]\n\t\t12\\sqrt[3]{y}-7\\sqrt{y} &\n\t}\n$$"}]}
