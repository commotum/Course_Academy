#{[{:db/id #edb/ref 17592186179463 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179763 :knowledge-point/id #uuid "477301de-0888-5f46-84cc-5b2939516e7b" :knowledge-point/title "Simplifying Expressions Containing Radicals"}] :question/id #uuid "13f8fdac-32c2-5f2a-a818-cde14e59299e" :question/math-academy-id "e-1373" :question/problem "Simplify $9\\sqrt{p - 4} - 7\\sqrt{p - 4} .$" :question/worked-solution "We can combine the two $\\sqrt{p - 4}$ terms together, as follows:\n\n$$\n\\begin{aligned}9\\sqrt{p-4}-7\\sqrt{p-4} & = \\\\ (9-7)\\sqrt{p-4} & = \\\\ 2\\sqrt{p-4} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186179464 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179764 :knowledge-point/id #uuid "35580c97-b64e-55a3-b71e-9190dbcac10b" :knowledge-point/title "Simplifying Sums of Radicals Using the Product Rule"}] :question/id #uuid "eb35e7da-e6d0-5811-a2ee-92390f71c5f7" :question/math-academy-id "e-1374" :question/problem "Simplify $\\sqrt{12x}-\\sqrt{27x}.$" :question/worked-solution "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}\\sqrt{12x}-\\sqrt{27x} & = \\\\ \\sqrt{4\\cdot 3x}-\\sqrt{9\\cdot 3x} & = \\\\ \\sqrt{4}\\cdot \\sqrt{3x}-\\sqrt{9}\\cdot \\sqrt{3x} & = \\\\ 2\\cdot \\sqrt{3x}-3\\cdot \\sqrt{3x} & = \\\\ 2\\sqrt{3x}-3\\sqrt{3x}\\end{aligned}\n$$\n\nFinally, we combine like terms:\n\n$$\n\\begin{aligned}2\\sqrt{3x}-3\\sqrt{3x} & = \\\\ (2-3)\\cdot \\sqrt{3x} & = \\\\ (-1)\\cdot \\sqrt{3x} & = \\\\ -\\sqrt{3x}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186179619 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179751 :knowledge-point/id #uuid "79a1c2e0-4183-58c6-ac88-0a4856b751a2" :knowledge-point/title "Simplifying Sums of Radicals with Cube Roots"}] :question/id #uuid "213ad0ee-813b-5a4b-8926-5fbd1aed4906" :question/math-academy-id "e-9723" :question/problem "Simplify $10\\sqrt[3]{y} + 2\\sqrt[3]{y} - 7\\sqrt{y}.$" :question/worked-solution "We can combine the two $\\sqrt[3]{y}$ terms together, but we cannot combine the $\\sqrt[3]{y}$ and $\\sqrt{y}$ terms:\n\n$$\n\\eqalign{\n\t\t10\\sqrt[3]{y} + 2\\sqrt[3]{y} - 7\\sqrt{y} &= \\[5pt]\n\t\t(10 + 2)\\sqrt[3]{y} - 7\\sqrt{y} &= \\[5pt]\n\t\t12\\sqrt[3]{y}-7\\sqrt{y} &\n\t}\n$$"}] [{:db/id #edb/ref 17592186502133 :knowledge-point/_questions [{:db/id #edb/ref 17592186179764 :knowledge-point/id #uuid "35580c97-b64e-55a3-b71e-9190dbcac10b" :knowledge-point/title "Simplifying Sums of Radicals Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "013c5fbb-49f5-5cea-af95-36393c4411da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{n}^{2}\\sqrt{3n}" :db/id #edb/ref 17592186501468} {:answer/id #uuid "92318117-1a9a-54a3-b50a-b61d8666f7b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{n}^{2}\\sqrt{2n}" :db/id #edb/ref 17592186501746} {:answer/id #uuid "bbcd05f3-4d31-538b-823a-86edda099981" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5n\\sqrt{2n}" :db/id #edb/ref 17592186501841} {:answer/id #uuid "ca597711-da0d-5cd9-ade8-6b530651d1e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7n\\sqrt{5n}" :db/id #edb/ref 17592186501868} {:answer/id #uuid "d0217c62-f412-503b-b6a7-7eeb12cb43cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7{n}^{2}\\sqrt{3n}" :db/id #edb/ref 17592186501880}] :answer-field/correct {:answer/id #uuid "d0217c62-f412-503b-b6a7-7eeb12cb43cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7{n}^{2}\\sqrt{3n}" :db/id #edb/ref 17592186501880} :answer-field/id #uuid "2002b9bb-cf1e-5c50-866c-90d860508452" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501986}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ad9cae8a-9ebc-5c61-bc98-540e57a392b2" :question/math-academy-id "q-111028" :question/problem "${n}^{2}\\sqrt{27n}+\\sqrt{48{n}^{5}}=$" :question/worked-solution "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}{n}^{2}\\sqrt{27n}+\\sqrt{48{n}^{5}} & = \\\\ {n}^{2}\\sqrt{9\\cdot 3n}+\\sqrt{16{n}^{4}\\cdot 3n} & = \\\\ {n}^{2}\\sqrt{9}\\cdot \\sqrt{3n}+\\sqrt{16{n}^{4}}\\cdot \\sqrt{3n} & = \\\\ 3{n}^{2}\\sqrt{3n}+4{n}^{2}\\sqrt{3n} & \\end{aligned}\n$$\n\nFinally, we combine the like terms:\n\n$$\n\\begin{aligned}3{n}^{2}\\sqrt{3n}+4{n}^{2}\\sqrt{3n} & = \\\\ (3+4){n}^{2}\\sqrt{3n} & = \\\\ 7{n}^{2}\\sqrt{3n}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502098 :knowledge-point/_questions [{:db/id #edb/ref 17592186179751 :knowledge-point/id #uuid "79a1c2e0-4183-58c6-ac88-0a4856b751a2" :knowledge-point/title "Simplifying Sums of Radicals with Cube Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fd144af-d507-5334-8bb4-0403c5376fa2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(p-4)\\sqrt[3]{p}+\\sqrt{p}" :db/id #edb/ref 17592186501583} {:answer/id #uuid "7c01e360-4b50-5260-b311-2ea621722164" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(p+1)\\sqrt[3]{p}-2\\sqrt{p}" :db/id #edb/ref 17592186501698} {:answer/id #uuid "8b456b28-3a4a-5b14-a2fc-7ae17008160f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-p)\\sqrt{p}-4\\sqrt[3]{p}" :db/id #edb/ref 17592186501734} {:answer/id #uuid "a5345b39-e7c1-50d0-9c54-c658acc7bcb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(p+1)\\sqrt{p}-2\\sqrt[3]{p}" :db/id #edb/ref 17592186501785} {:answer/id #uuid "e2171678-dbe0-5c40-aba8-dc750a70794f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-p)\\sqrt[3]{p}-2\\sqrt{p}" :db/id #edb/ref 17592186501917}] :answer-field/correct {:answer/id #uuid "7c01e360-4b50-5260-b311-2ea621722164" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(p+1)\\sqrt[3]{p}-2\\sqrt{p}" :db/id #edb/ref 17592186501698} :answer-field/id #uuid "4914e07f-3d93-5356-b4b8-8517fb1d7635" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501997}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "40cade47-943f-50c4-8cf4-c4d5f9b88bc8" :question/math-academy-id "q-134506" :question/problem "$2\\sqrt{p}-\\sqrt{16p}+\\sqrt[3]{p}+\\sqrt[3]{{p}^{4}}=$" :question/worked-solution "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}2\\sqrt{p}-\\sqrt{16p}+\\sqrt[3]{p}+\\sqrt[3]{{p}^{4}} & = \\\\ 2\\sqrt{p}-\\sqrt{16\\cdot p}+\\sqrt[3]{p}+\\sqrt[3]{{p}^{3}\\cdot p} & = \\\\ 2\\sqrt{p}-\\sqrt{16}\\cdot \\sqrt{p}+\\sqrt[3]{p}+\\sqrt[3]{{p}^{3}}\\cdot \\sqrt[3]{p} & = \\\\ 2\\sqrt{p}-4\\sqrt{p}+\\sqrt[3]{p}+p\\sqrt[3]{p} & \\end{aligned}\n$$\n\nFinally, we combine the like terms:\n\n$$\n\\begin{aligned}2\\sqrt{p}-4\\sqrt{p}+\\sqrt[3]{p}+p\\sqrt[3]{p} & = \\\\ (2-4)\\sqrt{p}+(1+p)\\sqrt[3]{p} & = \\\\ -2\\sqrt{p}+(1+p)\\sqrt[3]{p} & = \\\\ (p+1)\\sqrt[3]{p}-2\\sqrt{p}\\end{aligned}\n$$\n\nNotice that we cannot combine the $\\sqrt[3]{p}$ and $\\sqrt{p}$ terms."}] [{:db/id #edb/ref 17592186502138 :knowledge-point/_questions [{:db/id #edb/ref 17592186179751 :knowledge-point/id #uuid "79a1c2e0-4183-58c6-ac88-0a4856b751a2" :knowledge-point/title "Simplifying Sums of Radicals with Cube Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cb30476-4c76-58e1-aa56-f618bffdd6d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(7+5t)\\sqrt[3]{2t}" :db/id #edb/ref 17592186501545} {:answer/id #uuid "3032bfa5-dbf0-5f11-91e9-fbf7414cabe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t+7\\sqrt[3]{2t}" :db/id #edb/ref 17592186501551} {:answer/id #uuid "30d278a9-e551-5555-b465-1a9126efba85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7+5t\\sqrt[3]{2t}" :db/id #edb/ref 17592186501552} {:answer/id #uuid "9da8cfd5-4237-5f1e-9ddc-17c0aa461cd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(t+7)\\sqrt[3]{2t}" :db/id #edb/ref 17592186501760} {:answer/id #uuid "a3012e8a-4fdb-529f-9953-c32624052358" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7(1+t)\\sqrt[3]{2t}" :db/id #edb/ref 17592186501778}] :answer-field/correct {:answer/id #uuid "30d278a9-e551-5555-b465-1a9126efba85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7+5t\\sqrt[3]{2t}" :db/id #edb/ref 17592186501552} :answer-field/id #uuid "9972e5ae-f3d9-5083-8d1b-be6157c6f289" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502030}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b5988724-f4b1-5a52-8719-b7ac5bee89d1" :question/math-academy-id "q-134508" :question/problem "$7-\\sqrt[3]{2{t}^{4}}+6t\\sqrt[3]{2t}=$" :question/worked-solution "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}7-\\sqrt[3]{2{t}^{4}}+6t\\sqrt[3]{2t} & = \\\\ 7-\\sqrt[3]{{t}^{3}\\cdot 2t}+6t\\sqrt[3]{2t} & = \\\\ 7-\\sqrt[3]{{t}^{3}}\\cdot \\sqrt[3]{2t}+6t\\sqrt[3]{2t} & = \\\\ 7-t\\sqrt[3]{2t}+6t\\sqrt[3]{2t} & \\end{aligned}\n$$\n\nFinally, we combine the like terms:\n\n$$\n\\begin{aligned}7-t\\sqrt[3]{2t}+6t\\sqrt[3]{2t} & = \\\\ 7+(-t+6t)\\sqrt[3]{2t} & = \\\\ 7+5t\\sqrt[3]{2t} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502101 :knowledge-point/_questions [{:db/id #edb/ref 17592186179764 :knowledge-point/id #uuid "35580c97-b64e-55a3-b71e-9190dbcac10b" :knowledge-point/title "Simplifying Sums of Radicals Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10416c63-126d-535c-8234-46889c821e2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{z}" :db/id #edb/ref 17592186501494} {:answer/id #uuid "1409de6f-8d4c-561a-bf02-e951797f383b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3z}" :db/id #edb/ref 17592186501504} {:answer/id #uuid "badeb28a-792c-5ea5-8883-c07f39f28e6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3z" :db/id #edb/ref 17592186501836} {:answer/id #uuid "c8a76dcc-4b19-5947-8692-6d6df0c64d65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{z}" :db/id #edb/ref 17592186501865} {:answer/id #uuid "f98bd692-ae23-58eb-8a79-31282bc0610f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{3z}" :db/id #edb/ref 17592186501963}] :answer-field/correct {:answer/id #uuid "1409de6f-8d4c-561a-bf02-e951797f383b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3z}" :db/id #edb/ref 17592186501504} :answer-field/id #uuid "21504cce-4e5d-5521-b05b-808c98517963" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501987}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "48442579-8421-52f2-adbc-f2ba91a631dd" :question/math-academy-id "q-34206" :question/problem "Simplify $\\sqrt{192z}-\\sqrt{147z}.$" :question/worked-solution "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}\\sqrt{192z}-\\sqrt{147z} & = \\\\ \\sqrt{64\\cdot 3z}-\\sqrt{49\\cdot 3z} & = \\\\ \\sqrt{64}\\cdot \\sqrt{3z}-\\sqrt{49}\\cdot \\sqrt{3z} & = \\\\ 8\\sqrt{3z}-7\\sqrt{3z} & \\end{aligned}\n$$\n\nFinally, we combine the like terms:\n\n$$\n\\begin{aligned}8\\sqrt{3z}-7\\sqrt{3z} & = \\\\ (8-7)\\sqrt{3z} & = \\\\ \\sqrt{3z} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502097 :knowledge-point/_questions [{:db/id #edb/ref 17592186179763 :knowledge-point/id #uuid "477301de-0888-5f46-84cc-5b2939516e7b" :knowledge-point/title "Simplifying Expressions Containing Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a3bbbb-3d58-5812-91fd-8458c0795915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186501464} {:answer/id #uuid "12288c26-42df-51dd-808b-20f205e3ddd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{x}" :db/id #edb/ref 17592186501497} {:answer/id #uuid "4c2fc26f-d391-5c9e-920f-520d82144c0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\sqrt{x}" :db/id #edb/ref 17592186501605} {:answer/id #uuid "4dfca826-0d43-5c60-a846-18bed3fc4466" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186501608} {:answer/id #uuid "97ddaa21-49aa-5eb8-9cbb-6265ff11235f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\sqrt{x}" :db/id #edb/ref 17592186501753}] :answer-field/correct {:answer/id #uuid "12288c26-42df-51dd-808b-20f205e3ddd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{x}" :db/id #edb/ref 17592186501497} :answer-field/id #uuid "7f247b26-452d-5f9b-bfd1-ec0918630ed5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502020}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3efd4daf-a1cf-5957-b4aa-c8ff94e19b4d" :question/math-academy-id "q-52391" :question/problem "$3\\sqrt{x}-2\\sqrt{x}=$" :question/worked-solution "We can combine the two $\\sqrt{x}$ terms together, as follows:\n\n$$\n\\begin{aligned}3\\sqrt{x}-2\\sqrt{x} & = \\\\ (3-2)\\sqrt{x} & = \\\\ \\sqrt{x} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502146 :knowledge-point/_questions [{:db/id #edb/ref 17592186179763 :knowledge-point/id #uuid "477301de-0888-5f46-84cc-5b2939516e7b" :knowledge-point/title "Simplifying Expressions Containing Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "248265cd-124a-59ae-9086-ddce3bd69527" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\sqrt{y}" :db/id #edb/ref 17592186501532} {:answer/id #uuid "6082565f-e6f0-5c5d-bb48-afa109edcba3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9y" :db/id #edb/ref 17592186501644} {:answer/id #uuid "bb99538f-3dd1-5ad6-bb88-f4133f077881" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\sqrt{y}" :db/id #edb/ref 17592186501838} {:answer/id #uuid "e85d285d-280a-5fa3-a0a7-67d21a36a2a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186501935} {:answer/id #uuid "edad2f10-b7c5-582c-bb71-7ac407fbd566" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14y" :db/id #edb/ref 17592186501944}] :answer-field/correct {:answer/id #uuid "248265cd-124a-59ae-9086-ddce3bd69527" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\sqrt{y}" :db/id #edb/ref 17592186501532} :answer-field/id #uuid "8e776382-1a74-592a-ba5a-3f4a958b9bf7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502027}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cf46068e-803c-5f09-a183-8df712f591aa" :question/math-academy-id "q-52392" :question/problem "$2\\sqrt{y}+7\\sqrt{y}=$" :question/worked-solution "We can combine the two $\\sqrt{y}$ terms together, as follows:\n\n$$\n\\begin{aligned}2\\sqrt{y}+7\\sqrt{y} & = \\\\ (2+7)\\sqrt{y} & = \\\\ 9\\sqrt{y} & \\end{aligned}\n$$"}]}
