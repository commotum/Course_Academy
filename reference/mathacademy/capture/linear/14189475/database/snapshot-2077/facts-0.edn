 1075 #edb/ref 17592186501532 #edb/ref 17592186045417] [17592186502027 #edb/ref 1075 #edb/ref 17592186501644 #edb/ref 17592186045417] [17592186502027 #edb/ref 1075 #edb/ref 17592186501838 #edb/ref 17592186045417] [17592186502027 #edb/ref 1075 #edb/ref 17592186501935 #edb/ref 17592186045417] [17592186502027 #edb/ref 1075 #edb/ref 17592186501944 #edb/ref 17592186045417] [17592186502027 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186502027 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186502027 #edb/ref 1078 #edb/ref 17592186501532 #edb/ref 17592186045417] [17592186502027 #edb/ref 1079 #uuid "8e776382-1a74-592a-ba5a-3f4a958b9bf7" #edb/ref 17592186045417] [17592186502030 #edb/ref 1075 #edb/ref 17592186501545 #edb/ref 17592186045417] [17592186502030 #edb/ref 1075 #edb/ref 17592186501551 #edb/ref 17592186045417] [17592186502030 #edb/ref 1075 #edb/ref 17592186501552 #edb/ref 17592186045417] [17592186502030 #edb/ref 1075 #edb/ref 17592186501760 #edb/ref 17592186045417] [17592186502030 #edb/ref 1075 #edb/ref 17592186501778 #edb/ref 17592186045417] [17592186502030 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186502030 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186502030 #edb/ref 1078 #edb/ref 17592186501552 #edb/ref 17592186045417] [17592186502030 #edb/ref 1079 #uuid "9972e5ae-f3d9-5083-8d1b-be6157c6f289" #edb/ref 17592186045417] [17592186502097 #edb/ref 1068 #edb/ref 17592186502020 #edb/ref 17592186045417] [17592186502097 #edb/ref 1069 "q-52391" #edb/ref 17592186045417] [17592186502097 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186502097 #edb/ref 1071 "$3\\sqrt{x}-2\\sqrt{x}=$" #edb/ref 17592186045417] [17592186502097 #edb/ref 1072 #uuid "3efd4daf-a1cf-5957-b4aa-c8ff94e19b4d" #edb/ref 17592186045417] [17592186502097 #edb/ref 1074 "We can combine the two $\\sqrt{x}$ terms together, as follows:\n\n$$\n\\begin{aligned}3\\sqrt{x}-2\\sqrt{x} & = \\\\ (3-2)\\sqrt{x} & = \\\\ \\sqrt{x} & \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186502098 #edb/ref 1068 #edb/ref 17592186501997 #edb/ref 17592186045417] [17592186502098 #edb/ref 1069 "q-134506" #edb/ref 17592186045417] [17592186502098 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186502098 #edb/ref 1071 "$2\\sqrt{p}-\\sqrt{16p}+\\sqrt[3]{p}+\\sqrt[3]{{p}^{4}}=$" #edb/ref 17592186045417] [17592186502098 #edb/ref 1072 #uuid "40cade47-943f-50c4-8cf4-c4d5f9b88bc8" #edb/ref 17592186045417] [17592186502098 #edb/ref 1074 "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}2\\sqrt{p}-\\sqrt{16p}+\\sqrt[3]{p}+\\sqrt[3]{{p}^{4}} & = \\\\ 2\\sqrt{p}-\\sqrt{16\\cdot p}+\\sqrt[3]{p}+\\sqrt[3]{{p}^{3}\\cdot p} & = \\\\ 2\\sqrt{p}-\\sqrt{16}\\cdot \\sqrt{p}+\\sqrt[3]{p}+\\sqrt[3]{{p}^{3}}\\cdot \\sqrt[3]{p} & = \\\\ 2\\sqrt{p}-4\\sqrt{p}+\\sqrt[3]{p}+p\\sqrt[3]{p} & \\end{aligned}\n$$\n\nFinally, we combine the like terms:\n\n$$\n\\begin{aligned}2\\sqrt{p}-4\\sqrt{p}+\\sqrt[3]{p}+p\\sqrt[3]{p} & = \\\\ (2-4)\\sqrt{p}+(1+p)\\sqrt[3]{p} & = \\\\ -2\\sqrt{p}+(1+p)\\sqrt[3]{p} & = \\\\ (p+1)\\sqrt[3]{p}-2\\sqrt{p}\\end{aligned}\n$$\n\nNotice that we cannot combine the $\\sqrt[3]{p}$ and $\\sqrt{p}$ terms." #edb/ref 17592186045417] [17592186502101 #edb/ref 1068 #edb/ref 17592186501987 #edb/ref 17592186045417] [17592186502101 #edb/ref 1069 "q-34206" #edb/ref 17592186045417] [17592186502101 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186502101 #edb/ref 1071 "Simplify $\\sqrt{192z}-\\sqrt{147z}.$" #edb/ref 17592186045417] [17592186502101 #edb/ref 1072 #uuid "48442579-8421-52f2-adbc-f2ba91a631dd" #edb/ref 17592186045417] [17592186502101 #edb/ref 1074 "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}\\sqrt{192z}-\\sqrt{147z} & = \\\\ \\sqrt{64\\cdot 3z}-\\sqrt{49\\cdot 3z} & = \\\\ \\sqrt{64}\\cdot \\sqrt{3z}-\\sqrt{49}\\cdot \\sqrt{3z} & = \\\\ 8\\sqrt{3z}-7\\sqrt{3z} & \\end{aligned}\n$$\n\nFinally, we combine the like terms:\n\n$$\n\\begin{aligned}8\\sqrt{3z}-7\\sqrt{3z} & = \\\\ (8-7)\\sqrt{3z} & = \\\\ \\sqrt{3z} & \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186502133 #edb/ref 1068 #edb/ref 17592186501986 #edb/ref 17592186045417] [17592186502133 #edb/ref 1069 "q-111028" #edb/ref 17592186045417] [17592186502133 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186502133 #edb/ref 1071 "${n}^{2}\\sqrt{27n}+\\sqrt{48{n}^{5}}=$" #edb/ref 17592186045417] [17592186502133 #edb/ref 1072 #uuid "ad9cae8a-9ebc-5c61-bc98-540e57a392b2" #edb/ref 17592186045417] [17592186502133 #edb/ref 1074 "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}{n}^{2}\\sqrt{27n}+\\sqrt{48{n}^{5}} & = \\\\ {n}^{2}\\sqrt{9\\cdot 3n}+\\sqrt{16{n}^{4}\\cdot 3n} & = \\\\ {n}^{2}\\sqrt{9}\\cdot \\sqrt{3n}+\\sqrt{16{n}^{4}}\\cdot \\sqrt{3n} & = \\\\ 3{n}^{2}\\sqrt{3n}+4{n}^{2}\\sqrt{3n} & \\end{aligned}\n$$\n\nFinally, we combine the like terms:\n\n$$\n\\begin{aligned}3{n}^{2}\\sqrt{3n}+4{n}^{2}\\sqrt{3n} & = \\\\ (3+4){n}^{2}\\sqrt{3n} & = \\\\ 7{n}^{2}\\sqrt{3n}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186502138 #edb/ref 1068 #edb/ref 17592186502030 #edb/ref 17592186045417] [17592186502138 #edb/ref 1069 "q-134508" #edb/ref 17592186045417] [17592186502138 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186502138 #edb/ref 1071 "$7-\\sqrt[3]{2{t}^{4}}+6t\\sqrt[3]{2t}=$" #edb/ref 17592186045417] [17592186502138 #edb/ref 1072 #uuid "b5988724-f4b1-5a52-8719-b7ac5bee89d1" #edb/ref 17592186045417] [17592186502138 #edb/ref 1074 "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}7-\\sqrt[3]{2{t}^{4}}+6t\\sqrt[3]{2t} & = \\\\ 7-\\sqrt[3]{{t}^{3}\\cdot 2t}+6t\\sqrt[3]{2t} & = \\\\ 7-\\sqrt[3]{{t}^{3}}\\cdot \\sqrt[3]{2t}+6t\\sqrt[3]{2t} & = \\\\ 7-t\\sqrt[3]{2t}+6t\\sqrt[3]{2t} & \\end{aligned}\n$$\n\nFinally, we combine the like terms:\n\n$$\n\\begin{aligned}7-t\\sqrt[3]{2t}+6t\\sqrt[3]{2t} & = \\\\ 7+(-t+6t)\\sqrt[3]{2t} & = \\\\ 7+5t\\sqrt[3]{2t} & \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186502146 #edb/ref 1068 #edb/ref 17592186502027 #edb/ref 17592186045417] [17592186502146 #edb/ref 1069 "q-52392" #edb/ref 17592186045417] [17592186502146 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186502146 #edb/ref 1071 "$2\\sqrt{y}+7\\sqrt{y}=$" #edb/ref 17592186045417] [17592186502146 #edb/ref 1072 #uuid "cf46068e-803c-5f09-a183-8df712f591aa" #edb/ref 17592186045417] [17592186502146 #edb/ref 1074 "We can combine the two $\\sqrt{y}$ terms together, as follows:\n\n$$\n\\begin{aligned}2\\sqrt{y}+7\\sqrt{y} & = \\\\ (2+7)\\sqrt{y} & = \\\\ 9\\sqrt{y} & \\end{aligned}\n$$" #edb/ref 17592186045417]}
