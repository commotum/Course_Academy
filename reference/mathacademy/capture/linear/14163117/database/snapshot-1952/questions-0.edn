#{[{:db/id #edb/ref 17592186110320 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110619 :knowledge-point/id #uuid "3ff2f965-b406-5c9a-bd41-73ccdce951eb" :knowledge-point/title "Cross-Multiplying with One Binomial"}] :question/id #uuid "7df7a073-8131-5732-b353-f89484052e38" :question/math-academy-id "e-13077" :question/problem "Solve the equation $\\dfrac{2x+5}{30} = \\dfrac{1}{2}.$" :question/worked-solution "First, we cross-multiply:\n\n$$\n\\begin{aligned}\\frac{2x+5}{30} & =\\frac{1}{2} \\\\ (2x+5)\\cdot 2 & =30\\cdot 1\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}(2x+5)\\cdot 2 & =30\\cdot 1 \\\\ 4x+10 & =30 \\\\ 4x+10-10 & =30-10 \\\\ 4x & =20 \\\\ \\frac{4x}{4} & =\\frac{20}{4} \\\\ x & =5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186110321 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110620 :knowledge-point/id #uuid "e880edeb-82ad-5943-a846-dc3246e3e3bd" :knowledge-point/title "Cross-Multiplying with Two Binomials"}] :question/id #uuid "4041cf6f-61b8-5794-9988-436722985bcd" :question/math-academy-id "e-13078" :question/problem "Solve for $x$, where $\\dfrac{6-2x}{2} = \\dfrac{6-x}{3}.$" :question/worked-solution "First, we cross-multiply:\n\n$$\n\\begin{aligned}\\frac{6-2x}{2} & =\\frac{6-x}{3} \\\\ (6-2x)\\cdot 3 & =2\\cdot (6-x)\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}(6-2x)\\cdot 3 & =2\\cdot (6-x) \\\\ 18-6x & =12-2x \\\\ 18-6x-18 & =12-2x-18 \\\\ -6x & =-2x-6 \\\\ -6x+2x & =-2x-6+2x \\\\ -4x & =-6 \\\\ \\frac{-4x}{-4} & =\\frac{-6}{-4} \\\\ x & =\\frac{6}{4} \\\\ x & =\\frac{3}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186110322 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110621 :knowledge-point/id #uuid "59230000-ef0e-56c0-ab06-17676d817d5a" :knowledge-point/title "Cross-Multiplying with a Negative Sign"}] :question/id #uuid "d97adcd5-65ea-5cf7-905a-db954e43904b" :question/math-academy-id "e-13079" :question/problem "Solve for $u$, where $\\dfrac{u+2}{3} = - \\dfrac{3-u}{2}.$" :question/worked-solution "We transfer the negative into the numerator of the fraction, and proceed with cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{u+2}{3} & =-\\frac{3-u}{2} \\\\ \\frac{u+2}{3} & =\\frac{-(3-u)}{2} \\\\ \\frac{u+2}{3} & =\\frac{-3+u}{2} \\\\ (u+2)\\cdot 2 & =3\\cdot (-3+u)\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}(u+2)\\cdot 2 & =3\\cdot (-3+u) \\\\ 2u+4 & =-9+3u \\\\ 2u+4-2u & =-9+3u-2u \\\\ 4 & =-9+u \\\\ 4+9 & =-9+u+9 \\\\ 13 & =u\\end{aligned}\n$$\n\nTherefore, $u=13.$"}] [{:db/id #edb/ref 17592186488277 :knowledge-point/_questions [{:db/id #edb/ref 17592186110619 :knowledge-point/id #uuid "3ff2f965-b406-5c9a-bd41-73ccdce951eb" :knowledge-point/title "Cross-Multiplying with One Binomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e8fad7b-e110-5c54-a02c-612c31dbd013" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\frac{5}{2}" :db/id #edb/ref 17592186487592} {:answer/id #uuid "2c4705ac-6d07-5768-90d9-1b8b9b795db7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=-\\frac{5}{3}" :db/id #edb/ref 17592186487652} {:answer/id #uuid "51d8442b-9890-51f1-8e28-0dd6e9564411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\frac{1}{2}" :db/id #edb/ref 17592186487730} {:answer/id #uuid "e0f10e68-0dbb-5745-b796-bc8aa4e7735d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=-\\frac{1}{3}" :db/id #edb/ref 17592186487995} {:answer/id #uuid "f47faa4f-394a-52a7-beaf-ca1cc41988dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\frac{3}{2}" :db/id #edb/ref 17592186488024}] :answer-field/correct {:answer/id #uuid "51d8442b-9890-51f1-8e28-0dd6e9564411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\frac{1}{2}" :db/id #edb/ref 17592186487730} :answer-field/id #uuid "91df46c5-2505-5488-abb9-11b4135c3293" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186488112}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ea7a15b7-4301-5282-88af-359487b5befc" :question/math-academy-id "q-101672" :question/problem "Solve for $k$ where $\\frac{5k+2}{3}=\\frac{3}{2}.$" :question/worked-solution "First, we cross-multiply:\n\n$$\n\\begin{aligned}\\frac{5k+2}{3} & =\\frac{3}{2} \\\\ (5k+2)\\cdot 2 & =3\\cdot (3)\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}(5k+2)\\cdot 2 & =3\\cdot (3) \\\\ 10k+4 & =9 \\\\ 10k+4-4 & =9-4 \\\\ 10k & =5 \\\\ \\frac{10k}{10} & =\\frac{5}{10} \\\\ k & =\\frac{1}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186488257 :knowledge-point/_questions [{:db/id #edb/ref 17592186110621 :knowledge-point/id #uuid "59230000-ef0e-56c0-ab06-17676d817d5a" :knowledge-point/title "Cross-Multiplying with a Negative Sign"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39497024-14bb-5050-895b-27fb6f5f066f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=-\\frac{3}{5}" :db/id #edb/ref 17592186487677} {:answer/id #uuid "48278a40-4f5d-5c0a-a5e7-ed2ecfeb6701" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=\\frac{5}{7}" :db/id #edb/ref 17592186487707} {:answer/id #uuid "d83e7926-8582-5c97-b830-6e4a6e2d1b6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=\\frac{3}{5}" :db/id #edb/ref 17592186487977} {:answer/id #uuid "df433e95-3bf7-5989-ba4b-f32798e0e17e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=\\frac{9}{10}" :db/id #edb/ref 17592186487993} {:answer/id #uuid "e93faed2-033d-5169-8048-997a878ad719" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=\\frac{9}{5}" :db/id #edb/ref 17592186488006}] :answer-field/correct {:answer/id #uuid "e93faed2-033d-5169-8048-997a878ad719" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=\\frac{9}{5}" :db/id #edb/ref 17592186488006} :answer-field/id #uuid "960915dd-4a4b-5d1c-93e4-ea54146411f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186488117}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c11f4c73-9d61-5e53-addf-f63464a71f44" :question/math-academy-id "q-101686" :question/problem "Solve for $q$ where $\\frac{3-2q}{3}=-\\frac{1}{5}.$" :question/worked-solution "We transfer the negative into the numerator of the fraction, and proceed with cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{3-2q}{3} & =-\\frac{1}{5} \\\\ (3-2q)\\cdot 5 & =3\\cdot (-1)\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}(3-2q)\\cdot 5 & =3\\cdot (-1) \\\\ 15-10q & =-3 \\\\ 15-10q-15 & =-3-15 \\\\ -10q & =-18 \\\\ \\frac{-10q}{-10} & =\\frac{-18}{-10} \\\\ q & =\\frac{18}{10} \\\\ q & =\\frac{9}{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186488196 :knowledge-point/_questions [{:db/id #edb/ref 17592186110620 :knowledge-point/id #uuid "e880edeb-82ad-5943-a846-dc3246e3e3bd" :knowledge-point/title "Cross-Multiplying with Two Binomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03338e67-3a5f-50b1-9e2b-348d85e8b90f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=\\frac{5}{4}" :db/id #edb/ref 17592186487573} {:answer/id #uuid "3e43b2e4-49f3-5882-8f62-2a13517060dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=\\frac{3}{2}" :db/id #edb/ref 17592186487687} {:answer/id #uuid "6e2ee15b-215a-5257-a4e4-14b6ee854a86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=-\\frac{2}{3}" :db/id #edb/ref 17592186487785} {:answer/id #uuid "c4ae25d6-edc0-50f2-9e62-f7145a4fa070" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=-\\frac{1}{5}" :db/id #edb/ref 17592186487940} {:answer/id #uuid "e2ea7bef-4f71-579c-a632-4c7089fcda72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=\\frac{5}{2}" :db/id #edb/ref 17592186488001}] :answer-field/correct {:answer/id #uuid "03338e67-3a5f-50b1-9e2b-348d85e8b90f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=\\frac{5}{4}" :db/id #edb/ref 17592186487573} :answer-field/id #uuid "bd1245c8-33c3-58b9-a2e6-9bc9ff66867d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186488138}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "246474dc-65ca-5dbb-80ff-e29f8ffb3cb5" :question/math-academy-id "q-104488" :question/problem "Solve for $w$ where $\\frac{w-3}{7}=\\frac{1-2w}{6}.$" :question/worked-solution "First, we cross-multiply:\n\n$$\n\\begin{aligned}\\frac{w-3}{7} & =\\frac{1-2w}{6} \\\\ (w-3)\\cdot 6 & =7\\cdot (1-2w)\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}(w-3)\\cdot 6 & =7\\cdot (1-2w) \\\\ 6w-18 & =7-14w \\\\ 6w-18+14w & =7-14w+14w \\\\ 20w-18 & =7 \\\\ 20w-18+18 & =7+18 \\\\ 20w & =25 \\\\ \\frac{20w}{20} & =\\frac{25}{20} \\\\ w & =\\frac{5}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186488255 :knowledge-point/_questions [{:db/id #edb/ref 17592186110621 :knowledge-point/id #uuid "59230000-ef0e-56c0-ab06-17676d817d5a" :knowledge-point/title "Cross-Multiplying with a Negative Sign"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "707bf8da-80d9-5773-82eb-bc5fc318d16a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186487792}] :answer-field/correct {:answer/id #uuid "707bf8da-80d9-5773-82eb-bc5fc318d16a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186487792} :answer-field/id #uuid "ec24edad-e55c-5bf9-bba7-969d534095d9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186488165}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bb61cd26-be58-5f6a-a7c8-fd462a5c81f3" :question/math-academy-id "q-171603" :question/problem "If $-\\frac{y+5}{3}=\\frac{4y+3}{5},$ then $y=${{field-1}}." :question/worked-solution "We transfer the negative into the numerator of the fraction, and proceed with cross-multiplication:\n\n$$\n\\begin{aligned}-\\frac{y+5}{3} & =\\frac{4y+3}{5} \\\\ \\frac{-(y+5)}{3} & =\\frac{4y+3}{5} \\\\ \\frac{-y-5}{3} & =\\frac{4y+3}{5} \\\\ (-y-5)\\cdot 5 & =3\\cdot (4y+3)\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}(-y-5)\\cdot 5 & =3\\cdot (4y+3) \\\\ -5y-25 & =12y+9 \\\\ -5y-25+5y & =12y+9+5y \\\\ -25 & =17y+9 \\\\ -25-9 & =17y+9-9 \\\\ -34 & =17y \\\\ \\frac{-34}{17} & =\\frac{17y}{17} \\\\ -2 & =y\\end{aligned}\n$$\n\nThus, $y=-2.$"}] [{:db/id #edb/ref 17592186488233 :knowledge-point/_questions [{:db/id #edb/ref 17592186110620 :knowledge-point/id #uuid "e880edeb-82ad-5943-a846-dc3246e3e3bd" :knowledge-point/title "Cross-Multiplying with Two Binomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10a7bd0b-b598-5e1a-b84b-fcaf6a4042be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "j=38" :db/id #edb/ref 17592186487594} {:answer/id #uuid "66442b7b-dbe0-5cd4-9364-3b3b982ebedf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "j=-36" :db/id #edb/ref 17592186487771} {:answer/id #uuid "915f50a1-efdd-572e-b98e-5b9389a72f9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "j=-56" :db/id #edb/ref 17592186487842} {:answer/id #uuid "953a511c-1edb-5adb-ad2a-33410e4e47c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "j=-\\frac{56}{5}" :db/id #edb/ref 17592186487846} {:answer/id #uuid "bc29baad-d175-5a61-938f-7d573c0d54ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "j=65" :db/id #edb/ref 17592186487921}] :answer-field/correct {:answer/id #uuid "915f50a1-efdd-572e-b98e-5b9389a72f9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "j=-56" :db/id #edb/ref 17592186487842} :answer-field/id #uuid "4c9eab71-bfb0-5eaf-bc3d-28f6d85e461b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186488079}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "80d602e5-e159-5437-af51-932d09f28858" :question/math-academy-id "q-27874" :question/problem "Solve for $j$ where $\\frac{j-4}{5}=\\frac{8+j}{4}.$" :question/worked-solution "First, we cross-multiply:\n\n$$\n\\begin{aligned}\\frac{j-4}{5} & =\\frac{8+j}{4} \\\\ (j-4)\\cdot 4 & =5\\cdot (8+j)\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}(j-4)\\cdot 4 & =5\\cdot (8+j) \\\\ 4j-16 & =40+5j \\\\ 4j-16-4j & =40+5j-4j \\\\ -16 & =40+j \\\\ -16-40 & =40+j-40 \\\\ -56 & =j\\end{aligned}\n$$\n\nThus, $j=-56.$"}] [{:db/id #edb/ref 17592186488259 :knowledge-point/_questions [{:db/id #edb/ref 17592186110619 :knowledge-point/id #uuid "3ff2f965-b406-5c9a-bd41-73ccdce951eb" :knowledge-point/title "Cross-Multiplying with One Binomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a45ca0d-d65f-513c-9002-45aaa9adc8a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\frac{6}{5}" :db/id #edb/ref 17592186487584} {:answer/id #uuid "1f3e710d-9fd5-5437-98b6-123729eb2da2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\frac{5}{12}" :db/id #edb/ref 17592186487632} {:answer/id #uuid "63cf2218-3815-5dcc-88a1-3d42ae5f9b8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\frac{5}{6}" :db/id #edb/ref 17592186487765} {:answer/id #uuid "6da8d60e-97ea-5928-b04b-cdbd9fcc3e85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\frac{1}{6}" :db/id #edb/ref 17592186487784} {:answer/id #uuid "91eed268-75cf-5793-8477-90881d0f9173" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\frac{1}{5}" :db/id #edb/ref 17592186487844}] :answer-field/correct {:answer/id #uuid "63cf2218-3815-5dcc-88a1-3d42ae5f9b8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\frac{5}{6}" :db/id #edb/ref 17592186487765} :answer-field/id #uuid "c54ab98f-d5bf-5d02-a021-f59b3a4bac35" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186488144}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c21712e7-21c4-5b84-b421-b21aa39ca232" :question/math-academy-id "q-44339" :question/problem "Solve for $k$ where $\\frac{9k-5}{6}=\\frac{k}{2}.$" :question/worked-solution "First, we cross-multiply:\n\n$$\n\\begin{aligned}\\frac{9k-5}{6} & =\\frac{k}{2} \\\\ (9k-5)\\cdot 2 & =6\\cdot k\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}(9k-5)\\cdot 2 & =6\\cdot k \\\\ 18k-10 & =6k \\\\ 18k-10-18k & =6k-18k \\\\ -10 & =-12k \\\\ \\frac{-10}{-12} & =\\frac{-12k}{-12} \\\\ \\frac{10}{12} & =k \\\\ \\frac{5}{6} & =k\\end{aligned}\n$$\n\nThus, $k=\\frac{5}{6}.$"}]}
