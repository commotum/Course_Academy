#{[{:db/id #edb/ref 17592186110320 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110619 :knowledge-point/id #uuid "3ff2f965-b406-5c9a-bd41-73ccdce951eb" :knowledge-point/title "Cross-Multiplying with One Binomial"}] :question/id #uuid "7df7a073-8131-5732-b353-f89484052e38" :question/math-academy-id "e-13077" :question/problem "Solve the equation $\\dfrac{2x+5}{30} = \\dfrac{1}{2}$." :question/worked-solution "First, we cross-multiply:\n\n$$\n\\begin{aligned}\n\\frac{2x + 5}{30} &= \\frac{1}{2} \\\\\n(2x + 5) \\cdot 2 &= 30 \\cdot 1\n\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}\n(2x + 5) \\cdot 2 &= 30 \\cdot 1 \\\\\n4x + 10 &= 30 \\\\\n4x + 10 - 10 &= 30 - 10 \\\\\n4x &= 20 \\\\\n\\frac{4x}{4} &= \\frac{20}{4} \\\\\nx &= 5\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186110321 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110620 :knowledge-point/id #uuid "e880edeb-82ad-5943-a846-dc3246e3e3bd" :knowledge-point/title "Cross-Multiplying with Two Binomials"}] :question/id #uuid "4041cf6f-61b8-5794-9988-436722985bcd" :question/math-academy-id "e-13078" :question/problem "Solve for $x$, where $\\dfrac{6-2x}{2} = \\dfrac{6-x}{3}$." :question/worked-solution "First, we cross-multiply:\n\n$$\n\\begin{aligned}\n\\frac{6 - 2x}{2} &= \\frac{6 - x}{3} \\\\\n(6 - 2x) \\cdot 3 &= 2 \\cdot (6 - x)\n\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}\n(6 - 2x) \\cdot 3 &= 2 \\cdot (6 - x) \\\\\n18 - 6x &= 12 - 2x \\\\\n18 - 6x - 18 &= 12 - 2x - 18 \\\\\n- 6x &= -2x - 6 \\\\\n- 6x + 2x &= -2x - 6 + 2x \\\\\n- 4x &= -6 \\\\\n\\frac{-4x}{-4} &= \\frac{-6}{-4} \\\\\nx &= \\frac{6}{4} \\\\\nx &= \\frac{3}{2}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186110322 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110621 :knowledge-point/id #uuid "59230000-ef0e-56c0-ab06-17676d817d5a" :knowledge-point/title "Cross-Multiplying with a Negative Sign"}] :question/id #uuid "d97adcd5-65ea-5cf7-905a-db954e43904b" :question/math-academy-id "e-13079" :question/problem "Solve for $u$, where $\\dfrac{u+2}{3} =-\\dfrac{3-u}{2}$." :question/worked-solution "We transfer the negative into the numerator of the fraction, and proceed with cross-multiplication:\n\n$$\n\\begin{aligned}\n\\frac{u + 2}{3} &= -\\frac{3 - u}{2} \\\\\n\\frac{u + 2}{3} &= (- (3 - u))/(2) \\\\\n\\frac{u + 2}{3} &= \\frac{-3 + u}{2} \\\\\n(u + 2) \\cdot 2 &= 3 \\cdot (-3 + u)\n\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}\n(u + 2) \\cdot 2 &= 3 \\cdot (-3 + u) \\\\\n2u + 4 &= -9 + 3u \\\\\n2u + 4 - 2u &= -9 + 3u - 2u \\\\\n4 &= -9 + u \\\\\n4 + 9 &= -9 + u + 9 \\\\\n13 &= u\n\\end{aligned}\n$$\n\nTherefore, $u=13$."}]}
