#{[{:activity/first-step {:db/id #edb/ref 17592186065236} :activity/id #uuid "ee2f5838-c8a6-5332-932d-ba9cbf1432c8" :activity/scope {:db/id #edb/ref 17592186048928 :topic/id #uuid "ccd0b2ba-3714-5783-a6c4-70021ded19c3" :topic/math-academy-id 370} :activity/steps [{:db/id #edb/ref 17592186065236 :step/content {:db/id #edb/ref 17592186065342 :tutorial/content "Let's remind ourselves of the difference of squares formula:\n\n$$\na^2-b^2 = (a+b)(a-b)\n$$\n\nWe can use this formula to factor the difference of two squared monomials.\n\nFor example, suppose that we want to factor the expression\n\n$$\nx^2 - 4\n$$\n\nThis expression is a difference of squares:\n\n$$\n\\begin{aligned}\nx^{2} - 4 &=  \\\\\n&= x^{2} - 2^{2}\n\\end{aligned}\n$$\n\nSo, we can factor the expression using the difference of squares formula with $a=x$ and $b=2$, as follows:\n\n$$\n\\begin{aligned}\nx^{2} - 4 &=  \\\\\nx^{2} - 2^{2} &=  \\\\\n&= (x + 2)(x - 2)\n\\end{aligned}\n$$" :tutorial/id #uuid "3f50b677-50fc-5584-82de-7ad393d19d72" :tutorial/math-academy-id 1599 :tutorial/title "Introduction"} :step/id #uuid "7189e486-f5a6-5ce7-9803-33bcfde7853b" :step/math-academy-id 4247 :step/next {:db/id #edb/ref 17592186065237}} {:db/id #edb/ref 17592186065237 :step/content {:db/id #edb/ref 17592186064328 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063963 :question/id #uuid "f1636f93-d678-581d-85a7-0ff93023fed9" :question/math-academy-id "e-1336"} :knowledge-point/id #uuid "20900ac7-ad4e-5895-8d95-d66b0e5f7360" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049943}] :knowledge-point/questions [{:db/id #edb/ref 17592186064681} {:db/id #edb/ref 17592186064691} {:db/id #edb/ref 17592186459295} {:db/id #edb/ref 17592186480664}] :knowledge-point/title "Factoring a Difference of Squares"} :step/id #uuid "2eef60d7-4f61-5c7d-9567-f51ed8b11f15" :step/math-academy-id 4251 :step/next {:db/id #edb/ref 17592186065238}} {:db/id #edb/ref 17592186065238 :step/content {:db/id #edb/ref 175921860