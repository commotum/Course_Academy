xt {:db/id #edb/ref 17592186485625}} {:db/id #edb/ref 17592186485607 :step/content {:db/id #edb/ref 17592186485546 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "206acbc9-87db-578e-b3b2-16b30eb642bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9-x)(9+x)" :db/id #edb/ref 17592186484877} {:answer/id #uuid "39335b45-13f8-58f6-bd9b-9a97b1c75cc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9-x)^{2}" :db/id #edb/ref 17592186484937} {:answer/id #uuid "64dfcde6-8a80-5dd4-b6fd-951b6b011f44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9+x)^{2}" :db/id #edb/ref 17592186485036} {:answer/id #uuid "6faf371b-64f9-55f0-8fd0-2ade74e5df26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x-9)(x+9)" :db/id #edb/ref 17592186485056} {:answer/id #uuid "8e7eccde-081c-5f5d-be03-c306f58839d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(18-x)(18+x)" :db/id #edb/ref 17592186485125}] :answer-field/correct {:db/id #edb/ref 17592186484877} :answer-field/id #uuid "8cab9527-ddd1-529a-ae51-224da9fcc4cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186485423}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7a010f5a-cc94-5c4d-81d2-4c21165ae9ab" :question/math-academy-id "q-44102" :question/problem "$81-{x}^{2}=$" :question/worked-solution "First, we write the expression as a difference of squares:\n\n$$\n81-{x}^{2}={9}^{2}-{x}^{2}\n$$\n\nThen, we factor the expression using the difference of squares formula:\n\n$$\n{9}^{2}-{x}^{2}=(9-x)(9+x)\n$$"} :step/id #uuid "2738148b-cedf-57d8-ae04-d09d72e66898"} {:db/id #edb/ref 17592186485625 :step/content {:db/id #edb/ref 17592186064692 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58d24321-d687-5666-b444-c67333ddf888" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2e-4f)(2e+4f)" :db/id #edb/ref 17592186485017} {:answer/id #uuid "883f8