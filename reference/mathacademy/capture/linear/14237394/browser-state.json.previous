rut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.6em 0.6em 0.3em\"><mtr><mtd><mi>m</mi><mi mathvariant=\"normal\">∠</mi><mi>B</mi><mi>O</mi><mi>C</mi></mtd><mtd><mi></mi><mo>=</mo><mi>m</mi><mi mathvariant=\"normal\">∠</mi><mi>B</mi><mi>O</mi><mi>D</mi><mo>−</mo><mi>m</mi><mi mathvariant=\"normal\">∠</mi><mi>C</mi><mi>O</mi><mi>D</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msup><mn>107</mn><mo>∘</mo></msup><mo>−</mo><msup><mn>73</mn><mo>∘</mo></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msup><mn>34</mn><mo>∘</mo></msup><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
