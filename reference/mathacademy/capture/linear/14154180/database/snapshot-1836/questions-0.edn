#{[{:db/id #edb/ref 17592186119524 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119958 :knowledge-point/id #uuid "32268c05-9166-5798-81fc-ac3a99d966e0" :knowledge-point/title "Finding the Cube Root of a Cubed Integer"}] :question/id #uuid "71372a52-1de2-5535-9216-6d90db0afc49" :question/math-academy-id "e-13374" :question/problem "What is $\\sqrt[3]{9^3}?$" :question/worked-solution "Since the number under the cube root ($\\sqrt[3]{\\phantom{x}}$) is already written as a cube, we obtain the answer instantly:\n\n$$\n\\sqrt[3]{9^3} = 9\n$$"}] [{:db/id #edb/ref 17592186119525 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119959 :knowledge-point/id #uuid "e588edf8-345e-57e7-b3ee-9c3666da08e6" :knowledge-point/title "Finding the Cube Root of a Positive Perfect Cube"}] :question/id #uuid "60f95f30-9f10-5fe5-b5b6-f7b74e219a57" :question/math-academy-id "e-13375" :question/problem "Calculate the value of $\\sqrt[3]{\\dfrac{1}{64}}.$" :question/worked-solution "First, notice that the numbers $1$ and $64$ are both perfect cubes. \n\nSo, to determine the value of $\\sqrt[3]{\\dfrac{1}{64}},$ we express $\\dfrac{1}{64}$ as a perfect cube:\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{1}{64}} & = \\\\ \\sqrt[3]{\\frac{{1}^{3}}{{4}^{3}}} & = \\\\ \\sqrt[3]{\\frac{1\\cdot 1\\cdot 1}{4\\cdot 4\\cdot 4}} & = \\\\ \\sqrt[3]{\\frac{1}{4}\\cdot \\frac{1}{4}\\cdot \\frac{1}{4}} & = \\\\ \\sqrt[3]{{(\\frac{1}{4})}^{3}} & = \\\\ \\frac{1}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186119526 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119960 :knowledge-point/id #uuid "4b9e5026-ab54-5f35-a8da-b647c0f68c1e" :knowledge-point/title "Finding the Cube Root of a Negative Perfect Cube"}] :question/id #uuid "5c5c9efb-7bff-5177-a736-b21ce6410871" :question/math-academy-id "e-13376" :question/problem "Calculate $\\sqrt[3]{-125}.$" :question/worked-solution "First, notice that the number $125$ is a perfect cube.\n\nSo, to determine the value of $\\sqrt[3]{-125},$ we express $-125$ as a perfect cube:\n\n$$\n\\begin{aligned}\\sqrt[3]{-125} & = \\\\ \\sqrt[3]{(-5)\\cdot (-5)\\cdot (-5)} & = \\\\ \\sqrt[3]{(-5)^{3}} & = \\\\ -5 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186119527 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119961 :knowledge-point/id #uuid "c331c742-c620-5e3c-ae77-37de9ded75cc" :knowledge-point/title "Finding the Cube of the Cube Root of a Positive or Negative Number"}] :question/id #uuid "fc571b6d-1dfe-5344-99c0-d6d2f5d1f0d5" :question/math-academy-id "e-13377" :question/problem "Find the value of $(\\sqrt[3]{216})^3.$" :question/worked-solution "The cube and the cube root cancel each other out. So, we have\n\n$$\n(\\sqrt[3]{216})^3 = 216.\n$$"}] [{:db/id #edb/ref 17592186475979 :knowledge-point/_questions [{:db/id #edb/ref 17592186119958 :knowledge-point/id #uuid "32268c05-9166-5798-81fc-ac3a99d966e0" :knowledge-point/title "Finding the Cube Root of a Cubed Integer"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ddcdd5c-482d-50db-aa90-c4742cf38272" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186475532}] :answer-field/correct {:answer/id #uuid "3ddcdd5c-482d-50db-aa90-c4742cf38272" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186475532} :answer-field/id #uuid "e7b0ae40-3af9-5eeb-b7b2-97b72a2ed108" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186475903}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ed24f84c-316f-5543-bb90-b4b0eb36754d" :question/math-academy-id "q-171383" :question/problem "Evaluate the following:\n\n$\\sqrt[3]{{(-3)}^{3}}=$\n{{field-1}}" :question/worked-solution "Since the number under the cube root ($\\sqrt[3]{}$) is already written as a cube, 