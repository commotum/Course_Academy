417] [17592186118899 #edb/ref 1080 "\\frac{1}{24}" #edb/ref 17592186045417] [17592186118899 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186118899 #edb/ref 1083 #uuid "b9c005b8-e1f3-5e3c-8b6c-db99fa0d269d" #edb/ref 17592186045417] [17592186118900 #edb/ref 1080 "\\frac{3}{2}" #edb/ref 17592186045417] [17592186118900 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186118900 #edb/ref 1083 #uuid "edf6245e-b4ad-542c-9ddf-15cf1457c403" #edb/ref 17592186045417] [17592186118901 #edb/ref 1080 "\\frac{1}{4}" #edb/ref 17592186045417] [17592186118901 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186118901 #edb/ref 1083 #uuid "f10c6f3f-56c2-5be7-9ff9-922dfe8a57fe" #edb/ref 17592186045417] [17592186118902 #edb/ref 1080 "\\frac{1}{2}" #edb/ref 17592186045417] [17592186118902 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186118902 #edb/ref 1083 #uuid "2d7fa26c-340e-5be8-bfc5-cecc408bbb57" #edb/ref 17592186045417] [17592186118903 #edb/ref 1080 "\\frac{3}{8}" #edb/ref 17592186045417] [17592186118903 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186118903 #edb/ref 1083 #uuid "66b3013b-5149-5199-8446-ab2d534ee91b" #edb/ref 17592186045417] [17592186119524 #edb/ref 1069 "e-13374" #edb/ref 17592186045417] [17592186119524 #edb/ref 1071 "What is $\\sqrt[3]{9^3}$?" #edb/ref 17592186045417] [17592186119524 #edb/ref 1072 #uuid "71372a52-1de2-5535-9216-6d90db0afc49" #edb/ref 17592186045417] [17592186119524 #edb/ref 1074 "Since the number under the cube root ($\\sqrt[3]{\\phantom{x}}$) is already written as a cube, we obtain the answer instantly:\n\n$$\n\\sqrt[3]{9^3} = 9\n$$" #edb/ref 17592186045417] [17592186119525 #edb/ref 1069 "e-13375" #edb/ref 17592186045417] [17592186119525 #edb/ref 1071 "Calculate the value of $\\sqrt[3]{\\dfrac{1}{64}}$." #edb/ref 17592186045417] [17592186119525 #edb/ref 1072 #uuid "60f95f30-9f10-5fe5-b5b6-f7b74e219a57" #edb/ref 17592186045417] [17592186119525 #edb/ref 1074 "First, notice that the numbers $1$ and $64$ are both perfect cubes.\n\nSo, to determine the value of\n\n$$\n\\sqrt[3]{\\dfrac{1}{64}}\n$$\n\nwe express\n\n$$\n\\dfrac{1}{64}\n$$\n\nas a perfect cube:\n\n$$\n\\begin{aligned}\n\\sqrt[3]{\\frac{1}{64}} &=  \\\\\n\\sqrt[3]{\\frac{1^{3}}{4^{3}}} &=  \\\\\n\\sqrt[3]{\\frac{1 \\cdot 1 \\cdot 1}{4 \\cdot 4 \\cdot 4}} &=  \\\\\n\\sqrt[3]{\\frac{1}{4} \\cdot \\frac{1}{4} \\cdot \\frac{1}{4}} &=  \\\\\n\\sqrt[3]{(\\frac{1}{4})^{3}} &=  \\\\\n&= \\frac{1}{4}\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186119526 #edb/ref 1069 "e-13376" #edb/ref 17592186045417] [17592186119526 #edb/ref 1071 "Calculate $\\sqrt[3]{-125}$." #edb/ref 17592186045417] [17592186119526 #edb/ref 1072 #uuid "5c5c9efb-7bff-5177-a736-b21ce6410871" #edb/ref 17592186045417] [17592186119526 #edb/ref 1074 "First, notice that the number $125$ is a perfect cube.\n\nSo, to determine the value of $\\sqrt[3]{-125}$, we express $-125$ as a perfect cube:\n\n$$\n\\begin{aligned}\n\\sqrt[3]{-125} &=  \\\\\n\\sqrt[3]{(-5) \\cdot (-5) \\cdot (-5)} &=  \\\\\n\\sqrt[3]{(-5)^{3}} &=  \\\\\n&= - 5\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186119527 #edb/ref 1069 "e-13377" #edb/ref 17592186045417] [17592186119527 #edb/ref 1071 "Find the value of $(\\sqrt[3]{216})^3$." #edb/ref 17592186045417] [17592186119527 #edb/ref 1072 #uuid "fc571b6d-1dfe-5344-99c0-d6d2f5d1f0d5" #edb/ref 17592186045417] [17592186119527 #edb/ref 1074 "The cube and the cube root cancel each other out. So, we have\n\n$$\n(\\sqrt[3]{216})^3 = 216\n$$" #edb/ref 17592186045417] [17592186119958 #edb/ref 1037 #edb/ref 17592186050358 #edb/ref 17592186045417] [17592186119958 #edb/ref 1037 #edb/ref 17592186050838 #edb/ref 17592186045417] [17592186119958 #edb/ref 1038 #edb/ref 17592186120417 #edb/ref 17592186045417] [17592186119958 #edb/ref 1038 #edb/ref 17592186120561 #edb/ref 17592186045417] [17592186119958 #edb/ref 1038 #edb/ref 17592186120562 #edb/ref 17592186045417] [17592186119