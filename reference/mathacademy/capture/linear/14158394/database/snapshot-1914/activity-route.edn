#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186482638} :activity/id #uuid "04996fb5-82c4-5a6e-b4f8-4ee95d452a28" :activity/scope {:db/id #edb/ref 17592186050306 :topic/id #uuid "3e940c02-4b9e-5ae3-9ac3-00ad626c7df8" :topic/math-academy-id 643} :activity/steps [{:db/id #edb/ref 17592186482632 :step/content {:db/id #edb/ref 17592186482609 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d4920b8-a0b3-52d7-b949-f47b2a45a0a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t-5b-5" :db/id #edb/ref 17592186481960} {:answer/id #uuid "771ee901-1425-5463-ba2b-f88c8bbf2f2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5t+5b+1" :db/id #edb/ref 17592186482051} {:answer/id #uuid "a2f9a64a-a6b7-51e5-83d8-71349f2789d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5t-5b+1" :db/id #edb/ref 17592186482161} {:answer/id #uuid "ac1f5891-3798-54aa-996d-4c2a95213fb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t-5+5b" :db/id #edb/ref 17592186482178} {:answer/id #uuid "b17687ec-6014-5b71-94d7-ab70a418a6e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t+5b+5" :db/id #edb/ref 17592186482194}] :answer-field/correct {:db/id #edb/ref 17592186482178} :answer-field/id #uuid "ac543dcf-e81f-50e7-95c6-f0e748a3d311" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186482469}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "eb6d88d8-f577-5f53-98e7-edda212d8c82" :question/math-academy-id "q-101231" :question/problem "Which of the following is equivalent to the expression $5b-5+t?$" :question/worked-solution "The expression $5b-5+t$ has three terms:  $5b$, $-5$, and $t.$ \n\nThe order in which we combine the terms doesn't matter. Therefore, we can also write this expression as \n\n$$\nt-5+5b.\n$$"} :step/id #uuid "3cff2d8d-df9e-5d2c-9d27-d77ba470ac28" :step/next {:db/id #edb/ref 17592186482644}} {:db/id #edb/ref 17592186482638 :step/content {:db/id #edb/ref 17592186482507 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cd13d57-925a-5982-ab14-c93eb0419f35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3k" :db/id #edb/ref 17592186481889} {:answer/id #uuid "83cba7a8-76fc-56db-aaf8-c3de0de6e5d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}n" :db/id #edb/ref 17592186482077} {:answer/id #uuid "99163600-3de1-51e9-8a72-aff574118385" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}l" :db/id #edb/ref 17592186482136} {:answer/id #uuid "9c5a9783-1695-5fd0-8b73-7833bcd112bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7m" :db/id #edb/ref 17592186482146} {:answer/id #uuid "fb51dbe3-7f5a-5148-baff-d67f34e4cffd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7m" :db/id #edb/ref 17592186482370}] :answer-field/correct {:db/id #edb/ref 17592186482146} :answer-field/id #uuid "033a56c7-e349-5192-bd8c-494f5d89f042" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186482379}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "04e6642c-b46c-5677-a772-7f923b6e600b" :question/math-academy-id "q-67051" :question/problem "What is the third term of the expression $-3k+2l-7m+\\frac{2}{3}n?$" :question/worked-solution "We put an addition symbol $(+)$ between each part and separate using parentheses:\n\n$$\n(-3k)+(2l)+(-7m)+(\\frac{2}{3}n)\n$$\n\nCounting off the terms:\n\n- the first term is $-3k,$\n\n- the second term is $2l,$\n\n- the third term is $-7m,$ and\n\n- the fourth term is $\\frac{2}{3}n.$\n\nIn particular, we are interested in the third term. The third term is $-7m.$"} :step/id #uuid "77569042-5472-5055-ba31-a89e9e453552" :step/next {:db/id #edb/ref 17592186482632}} {:db/id #edb/ref 17592186482644 :step/content {:db/id #edb/ref 17592186482560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bbc4662-17c8-566a-acb7-99e5248c37c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p+7r+2t" :db/id #edb/ref 17592186481796} {:answer/id #uuid "31c789bd-32b3-5605-873d-8d6d89e7324b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7r+p+2t" :db/id #edb/ref 17592186481895} {:answer/id #uuid "763eed8d-488c-5362-b25e-5ac87dac91fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7p+2r-t" :db/id #edb/ref 17592186482049} {:answer/id #uuid "843afc63-44b9-5f4b-885a-d51f3eda139c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7p+2r+t" :db/id #edb/ref 17592186482080} {:answer/id #uuid "be463875-24b8-51f1-95d1-5325543c9830" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7p+r-2t" :db/id #edb/ref 17592186482229}] :answer-field/correct {:db/id #edb/ref 17592186482049} :answer-field/id #uuid "1707db66-3e56-5bca-a5c5-8d6d15706954" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186482388}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8350b8fc-cebc-5d70-a81a-fd2cc02c4b2c" :question/math-academy-id "q-101234" :question/problem "Which of the following is equivalent to the expression $7p-t+2r?$" :question/worked-solution "The expression $7p-t+2r$ has three terms:  $7p$, $-t$, and $2r.$ \n\nThe order in which we combine the terms doesn't matter. Therefore, we can also write this expression as \n\n$$\n7p+2r-t.\n$$"} :step/id #uuid "a9868400-b4e0-57be-ad8c-50a08dea0277"}] :activity/title "Identifying Terms in Linear Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186481764}]}
