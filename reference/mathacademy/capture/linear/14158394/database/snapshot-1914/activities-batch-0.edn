#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186079589} :activity/id #uuid "644d008d-9b6c-5a98-bd2e-9f7418e77c4f" :activity/scope {:db/id #edb/ref 17592186050306 :topic/id #uuid "3e940c02-4b9e-5ae3-9ac3-00ad626c7df8" :topic/math-academy-id 643} :activity/steps [{:db/id #edb/ref 17592186079589 :step/content {:db/id #edb/ref 17592186079714 :tutorial/content "Let's take a look at the following algebraic expression:\n\n$$\n2x{\\,\\color{red}{-}\\,} 4y {\\,\\color{blue}{+}\\,} 7\n$$\n\nThe addition $({\\color{blue}{+}})$ and subtraction $({\\color{red}{-}})$ symbols separate this expression into three parts known as **terms**.  \n\nTo identify each term, we put an addition symbol $({\\color{blue}{+}})$ between each part and separate using parentheses:\n\n$$\n(2x) {\\,\\color{blue}{+}\\,} ({\\,\\color{red}{-}\\,} 4y) {\\,\\color{blue}{+}\\,} (7).\n$$\n\nSo, the terms of this expression are: \n\n$$\n2x,\\quad -4y,\\quad  \\quad 7\n$$\n\nWe say that $2x$ is the **first term**, $-4y$ is the **second term**, and $7$ is the **third term**. \n\nIn this example, the subtraction symbol gave us the term $-4y$. Whenever there is a subtraction symbol, the corresponding term will be negative." :tutorial/id #uuid "a3fedc83-1abf-5dae-af95-68dd8069bf3e" :tutorial/math-academy-id 8035 :tutorial/title "Introduction"} :step/id #uuid "f8931686-8ab0-55f7-ac91-27963af09ae5" :step/math-academy-id 75175 :step/next {:db/id #edb/ref 17592186079590}} {:db/id #edb/ref 17592186079590 :step/content {:db/id #edb/ref 17592186078613 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078158 :question/id #uuid "65cb74a2-b55a-58e7-951d-2e0c09662f68" :question/math-academy-id "e-12823"} :knowledge-point/id #uuid "ffb52c1b-a540-5255-8c13-a37940a0d6ec" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050618} {:db/id #edb/ref 17592186051009}] :knowledge-point/questions [{:db/id #edb/ref 17592186078812} {:db/id #edb/ref 17592186079038} {:db/id #edb/ref 17592186079039} {:db/id #edb/ref 17592186444245} {:db/id #edb/ref 17592186444248} {:db/id #edb/ref 17592186444251} {:db/id #edb/ref 17592186444254} {:db/id #edb/ref 17592186444255}] :knowledge-point/title "Listing the Terms of a Linear Expression"} :step/id #uuid "d3ccacbe-b3b1-59d6-aca9-544e52d96477" :step/math-academy-id 75176 :step/next {:db/id #edb/ref 17592186079591}} {:db/id #edb/ref 17592186079591 :step/content {:db/id #edb/ref 17592186078614 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078159 :question/id #uuid "4370fda3-97e7-5fc5-9459-4176f5922431" :question/math-academy-id "e-12824"} :knowledge-point/id #uuid "da99f266-f47f-5fda-8b91-2161c7e48a94" :knowledge-point/questions [{:db/id #edb/ref 17592186078900} {:db/id #edb/ref 17592186078901} {:db/id #edb/ref 17592186079175} {:db/id #edb/ref 17592186444246} {:db/id #edb/ref 17592186444249} {:db/id #edb/ref 17592186444250} {:db/id #edb/ref 17592186444252} {:db/id #edb/ref 17592186482507}] :knowledge-point/title "Identifying Particular Terms of an Expression"} :step/id #uuid "a41ca648-ff16-5981-9555-fc4f21dbf835" :step/math-academy-id 75180 :step/next {:db/id #edb/ref 17592186079592}} {:db/id #edb/ref 17592186079592 :step/content {:db/id #edb/ref 17592186079715 :tutorial/content "When two algebraic expressions contain exactly the same terms, they are said to be **equivalent**.\n\nFor example, the expression\n\n$$\n{\\color{blue}{x}} + {\\color{red}{2y}} + 3z\n$$\n\nis equivalent to \n\n$$\n3z+{\\color{blue}{x}} + {\\color{red}{2y}}\n$$\n\nbecause they both contain the exact same terms. Both expressions are also equivalent to\n\n$$\n{\\color{blue}{x}} + 3z+ {\\color{red}{2y}}.\n$$" :tutorial/id #uuid "ad9444b4-97b9-501f-a587-b712d00315a1" :tutorial/math-academy-id 8036 :tutorial/title "Equivalent Expressions"} :step/id #uuid "99d3eb64-ea42-5fb4-9098-6906b67605f3" :step/math-academy-id 75184 :step/next {:db/id #edb/ref 17592186079593}} {:db/id #edb/ref 17592186079593 :step/content {:db/id #edb/ref 17592186078615 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078160 :question/id #uuid "b8e3ac42-7ade-5b31-8388-1e1061ad3f33" :question/math-academy-id "e-12825"} :knowledge-point/id #uuid "48f63068-6837-522f-9268-efe63f9c2649" :knowledge-point/questions [{:db/id #edb/ref 17592186078756} {:db/id #edb/ref 17592186078914} {:db/id #edb/ref 17592186079121} {:db/id #edb/ref 17592186444247} {:db/id #edb/ref 17592186444253} {:db/id #edb/ref 17592186444256} {:db/id #edb/ref 17592186482560} {:db/id #edb/ref 17592186482609}] :knowledge-point/title "Equivalent Expressions"} :step/id #uuid "d5df34ea-2918-56a4-bca6-901f97786756" :step/math-academy-id 75185}] :activity/title "Identifying Terms in Linear Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078665}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186482638} :activity/id #uuid "04996fb5-82c4-5a6e-b4f8-4ee95d452a28" :activity/scope {:db/id #edb/ref 17592186050306 :topic/id #uuid "3e940c02-4b9e-5ae3-9ac3-00ad626c7df8" :topic/math-academy-id 643} :activity/steps [{:db/id #edb/ref 17592186482632 :step/content {:db/id #edb/ref 17592186482609 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d4920b8-a0b3-52d7-b949-f47b2a45a0a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t-5b-5" :db/id #edb/ref 17592186481960} {:answer/id #uuid "771ee901-1425-5463-ba2b-f88c8bbf2f2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5t+5b+1" :db/id #edb/ref 17592186482051} {:answer/id #uuid "a2f9a64a-a6b7-51e5-83d8-71349f2789d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5t-5b+1" :db/id #edb/ref 17592186482161} {:answer/id #uuid "ac1f5891-3798-54aa-996d-4c2a95213fb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t-5+5b" :db/id #edb/ref 17592186482178} {:answer/id #uuid "b17687ec-6014-5b71-94d7-ab70a418a6e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t+5b+5" :db/id #edb/ref 17592186482194}] :answer-field/correct {:db/id #edb/ref 17592186482178} :answer-field/id #uuid "ac543dcf-e81f-50e7-95c6-f0e748a3d311" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186482469}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "eb6d88d8-f577-5f53-98e7-edda212d8c82" :question/math-academy-id "q-101231" :question/problem "Which of the following is equivalent to the expression $5b-5+t?$" :question/worked-solution "The expression $5b-5+t$ has three terms:  $5b$, $-5$, and $t.$ \n\nThe order in which we combine the terms doesn't matter. Therefore, we can also write this expression as \n\n$$\nt-5+5b.\n$$"} :step/id #uuid "3cff2d8d-df9e-5d2c-9d27-d77ba470ac28" :step/next {:db/id #edb/ref 17592186482644}} {:db/id #edb/ref 17592186482638 :step/content {:db/id #edb/ref 17592186482507 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cd13d57-925a-5982-ab14-c93eb0419f35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3k" :db/id #edb/ref 17592186481889} {:answer/id #uuid "83cba7a8-76fc-56db-aaf8-c3de0de6e5d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}n" :db/id #edb/ref 17592186482077} {:answer/id #uuid "99163600-3de1-51e9-8a72-aff574118385" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}l" :db/id #edb/ref 17592186482136} {:answer/id #uuid "9c5a9783-1695-5fd0-8b73-7833bcd112bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7m" :db/id #edb/ref 17592186482146} {:answer/id #uuid "fb51dbe3-7f5a-5148-baff-d67f34e4cffd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7m" :db/id #edb/ref 17592186482370}] :answer-field/correct {:db/id #edb/ref 17592186482146} :answer-field/id #uuid "033a56c7-e349-5192-bd8c-494f5d89f042" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186482379}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "04e6642c-b46c-5677-a772-7f923b6e600b" :question/math-academy-id "q-67051" :question/problem "What is the third term of the expression $-3k+2l-7m+\\frac{2}{3}n?$" :question/worked-solution "We put an addition symbol $(+)$ between each part and separate using parentheses:\n\n$$\n(-3k)+(2l)+(-7m)+(\\frac{2}{3}n)\n$$\n\nCounting off the terms:\n\n- the first term is $-3k,$\n\n- the second term is $2l,$\n\n- the third term is $-7m,$ and\n\n- the fourth term is $\\frac{2}{3}n.$\n\nIn particular, we are interested in the third term. The third term is $-7m.$"} :step/id #uuid "77569042-5472-5055-ba31-a89e9e453552" :step/next {:db/id #edb/ref 17592186482632}} {:db/id #edb/ref 17592186482644 :step/content {:db/id #edb/ref 17592186482560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bbc4662-17c8-566a-acb7-99e5248c37c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p+7r+2t" :db/id #edb/ref 17592186481796} {:answer/id #uuid "31c789bd-32b3-5605-873d-8d6d89e7324b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7r+p+2t" :db/id #edb/ref 17592186481895} {:answer/id #uuid "763eed8d-488c-5362-b25e-5ac87dac91fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7p+2r-t" :db/id #edb/ref 17592186482049} {:answer/id #uuid "843afc63-44b9-5f4b-885a-d51f3eda139c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7p+2r+t" :db/id #edb/ref 17592186482080} {:answer/id #uuid "be463875-24b8-51f1-95d1-5325543c9830" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7p+r-2t" :db/id #edb/ref 17592186482229}] :answer-field/correct {:db/id #edb/ref 17592186482049} :answer-field/id #uuid "1707db66-3e56-5bca-a5c5-8d6d15706954" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186482388}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8350b8fc-cebc-5d70-a81a-fd2cc02c4b2c" :question/math-academy-id "q-101234" :question/problem "Which of the following is equivalent to the expression $7p-t+2r?$" :question/worked-solution "The expression $7p-t+2r$ has three terms:  $7p$, $-t$, and $2r.$ \n\nThe order in which we combine the terms doesn't matter. Therefore, we can also write this expression as \n\n$$\n7p+2r-t.\n$$"} :step/id #uuid "a9868400-b4e0-57be-ad8c-50a08dea0277"}] :activity/title "Identifying Terms in Linear Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186481764}]}
