#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186079589} :activity/id #uuid "644d008d-9b6c-5a98-bd2e-9f7418e77c4f" :activity/scope {:db/id #edb/ref 17592186050306 :topic/id #uuid "3e940c02-4b9e-5ae3-9ac3-00ad626c7df8" :topic/math-academy-id 643} :activity/steps [{:db/id #edb/ref 17592186079589 :step/content {:db/id #edb/ref 17592186079714 :tutorial/content "Let's take a look at the following algebraic expression:\n\n$$\n2x{\\,\\color{red}{-}\\,} 4y {\\,\\color{blue}{+}\\,} 7\n$$\n\nThe addition $({\\color{blue}{+}})$ and subtraction $({\\color{red}{-}})$ symbols separate this expression into three parts known as **terms**.  \n\nTo identify each term, we put an addition symbol $({\\color{blue}{+}})$ between each part and separate using parentheses:\n\n$$\n(2x) {\\,\\color{blue}{+}\\,} ({\\,\\color{red}{-}\\,} 4y) {\\,\\color{blue}{+}\\,} (7).\n$$\n\nSo, the terms of this expression are: \n\n$$\n2x,\\quad -4y,\\quad  \\quad 7\n$$\n\nWe say that $2x$ is the **first term**, $-4y$ is the **second term**, and $7$ is the **third term**. \n\nIn this example, the subtraction symbol gave us the term $-4y$. Whenever there is a subtraction symbol, the corresponding term will be negative." :tutorial/id #uuid "a3fedc83-1abf-5dae-af95-68dd8069bf3e" :tutorial/math-academy-id 8035 :tutorial/title "Introduction"} :step/id #uuid "f8931686-8ab0-55f7-ac91-27963af09ae5" :step/math-academy-id 75175 :step/next {:db/id #edb/ref 17592186079590}} {:db/id #edb/ref 17592186079590 :step/content {:db/id #edb/ref 17592186078613 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078158 :question/id #uuid "65cb74a2-b55a-58e7-951d-2e0c09662f68" :question/math-academy-id "e-12823"} :knowledge-point/id #uuid "ffb52c1b-a540-5255-8c13-a37940a0d6ec" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050618} {:db/id #edb/ref 17592186051009}] :knowledge-point/questions [{:db/id #edb/ref 17592186078812} {:db/id #edb/ref 17592186079038} {:db/id #edb/ref 17592186079039} {:db/id #edb/ref 17592186444245} {:db/id #edb/ref 17592186444248} {:db/id #edb/ref 17592186444251} {:db/id #edb/ref 17592186444254} {:db/id #edb/ref 17592186444255}] :knowledge-point/title "Listing the Terms of a Linear Expression"} :step/id #uuid "d3ccacbe-b3b1-59d6-aca9-544e52d96477" :step/math-academy-id 75176 :step/next {:db/id #edb/ref 17592186079591}} {:db/id #edb/ref 17592186079591 :step/content {:db/id #edb/ref 17592186078614 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078159 :question/id #uuid "4370fda3-97e7-5fc5-9459-4176f5922431" :question/math-academy-id "e-12824"} :knowledge-point/id #uuid "da99f266-f47f-5fda-8b91-2161c7e48a94" :knowledge-point/questions [{:db/id #edb/ref 17592186078900} {:db/id #edb/ref 17592186078901} {:db/id #edb/ref 17592186079175} {:db/id #edb/ref 17592186444246} {:db/id #edb/ref 17592186444249} {:db/id #edb/ref 17592186444250} {:db/id #edb/ref 17592186444252}] :knowledge-point/title "Identifying Particular Terms of an Expression"} :step/id #uuid "a41ca648-ff16-5981-9555-fc4f21dbf835" :step/math-academy-id 75180 :step/next {:db/id #edb/ref 17592186079592}} {:db/id #edb/ref 17592186079592 :step/content {:db/id #edb/ref 17592186079715 :tutorial/content "When two algebraic expressions contain exactly the same terms, they are said to be **equivalent**.\n\nFor example, the expression\n\n$$\n{\\color{blue}{x}} + {\\color{red}{2y}} + 3z\n$$\n\nis equivalent to \n\n$$\n3z+{\\color{blue}{x}} + {\\color{red}{2y}}\n$$\n\nbecause they both contain the exact same terms. Both expressions are also equivalent to\n\n$$\n{\\color{blue}{x}} + 3z+ {\\color{red}{2y}}.\n$$" :tutorial/id #uuid "ad9444b4-97b9-501f-a587-b712d00315a1" :tutorial/math-academy-id 8036 :tutorial/title "Equivalent Expressions"} :step/id #uuid "99d3eb64-ea42-5fb4-9098-6906b67605f3" :step/math-academy-id 75184 :step/next {:db/id #edb/ref 17592186079593}} {:db/id #edb/ref 17592186079593 :step/content {:db/id #edb/ref 17592186078615 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078160 :question/id #uuid "b8e3ac42-7ade-5b31-8388-1e1061ad3f33" :question/math-academy-id "e-12825"} :knowledge-point/id #uuid "48f63068-6837-522f-9268-efe63f9c2649" :knowledge-point/questions [{:db/id #edb/ref 17592186078756} {:db/id #edb/ref 17592186078914} {:db/id #edb/ref 17592186079121} {:db/id #edb/ref 17592186444247} {:db/id #edb/ref 17592186444253} {:db/id #edb/ref 17592186444256}] :knowledge-point/title "Equivalent Expressions"} :step/id #uuid "d5df34ea-2918-56a4-bca6-901f97786756" :step/math-academy-id 75185}] :activity/title "Identifying Terms in Linear Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078665}]}
