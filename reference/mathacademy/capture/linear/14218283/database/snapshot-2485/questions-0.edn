#{[{:db/id #edb/ref 17592186100668 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186100847 :knowledge-point/id #uuid "ac31493b-30d0-5ed1-8422-f1f475e3c576" :knowledge-point/title "Identifying Points that Must Lie on a Translated Curve"}] :question/id #uuid "8c6c748a-f067-527d-91aa-3ead12bb569d" :question/math-academy-id "e-4106" :question/problem "The point $P$ with coordinates $(3,4)$ lies on the curve $y=f(x)$. Find a point that must lie on $y=f(x)+3$?" :question/worked-solution "**Method 1**\n\nThe graph of $y = f(x)+3$ is obtained by translating the graph of $y=f(x)$ by $3$ units *up*. \n\nHence, if the point $(3,4)$ lies on $y=f(x)$, then the point \n\n$$\n(3,4+3) = (3,7)\n$$\n\nlies on $y=f(x) + 3.$\n\n![](images/57/577911187229d6a56a8885e4cea2e25752615ed7bb807768abf4b54c5073d177.png)\n\n**Method 2**\n\nAs $(3,4)$ lies on $y = f(x)$, we have that $f(3) = 4.$\n\nNow, if $x = 3$ then\n\n$$\n\\begin{aligned}y & =f(3)+3 \\\\  & =4+3 \\\\  & =7.\\end{aligned}\n$$\n\nSo, the point $(3,7)$ must lie on $y = f(x) + 3.$"}] [{:db/id #edb/ref 17592186100669 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186100848 :knowledge-point/id #uuid "a8224846-04e6-531d-9415-9a18d2afddb6" :knowledge-point/title "Identifying the Graph of a Translated Function"}] :question/id #uuid "7b856c88-45bf-54a5-80c4-134a7544742c" :question/math-academy-id "e-4107" :question/problem "The graph of $y=f(x)$ is shown below and the point $(0,9)$ lies on the curve. Sketch the graph of $y=f(x)-2.$\n\n![](images/b0/b0c3acc57c74ced95e7387e285d9de1c629e7724fe9e111b13df209198069e8d.png)" :question/worked-solution "The graph of $y = f(x)$ passes through the point $(0, 9)$ as shown in the diagram. \n\nThe graph of $y=f(x)-2$ can be obtained from $y=f(x)$ by translating it by $2$ units *down*. So, it must pass through the point $(0,7).$\n\nThe correct graph is shown below.\n\n![](images/27/27de6227dee35cb8a7eaf2873409dfd6ad8c3c5f8d0cbd0de9ac223925b3fd76.png)"}] [{:db/id #edb/ref 17592186100670 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186100849 :knowledge-point/id #uuid "10557b22-4b4b-5860-abcb-0dcd96a5743d" :knowledge-point/title "Identifying the Vertical Shift of a Translated Function"}] :question/id #uuid "85d2f012-deb3-55dc-8e38-51bfe62eab20" :question/math-academy-id "e-4108" :question/problem "The point $A$ with coordinates $(2,-1)$ lies on the curve $y = f(x)$ and the point $B$ with coordinates $(2,-4)$ lies on the curve $y = g(x).$ If the curve $y = g(x)$ is related to $y = f(x)$ via the transformation $g(x) = f(x) + k$, then what is the value of $k?$" :question/worked-solution "First, notice that the point $B(2, -4)$ lies $3$ units *below* the point $A(2, -1).$ So, the graph of $y = g(x)$ can be obtained from the graph of $y = f(x)$ by shifting it $3$ units *down*. \n\n![](images/46/4656ae5ff75132fc9b760b6a8f73b0b434a8f66ecd621fa974a265df1d0d8a2c.png)\n\nAs a result, $k = -3.$"}] [{:db/id #edb/ref 17592186100712 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186100887 :knowledge-point/id #uuid "d982b565-2c41-5687-8d00-86b971bfb18b" :knowledge-point/title "Identifying the Graph of an Original Function Given a Translated Function"}] :question/id #uuid "1c57d35a-24ad-51ae-b00d-0f55396f045d" :question/math-academy-id "e-5007" :question/problem "The graph of $y=f(x) +2$ is shown below. Sketch the graph of $y=f(x)?$\n\n![](images/f5/f5404d5fbf52098eaa7161f0219e4df98a3ae9f5b6b7b6b0220089d62abff82d.png)" :question/worked-solution "The graph of $y = f(x) + 2$ can be obtained from the graph of $y = f(x)$ by translating $2$ units *up*. \n\nSo, the graph $y = f(x)$ would be $2$ units *below* the graph of $y = f(x) + 2.$\n\n![](images/0c/0ce67d91fd6c15d97e882c785392f001a4f38ed9bedd50d8631b34e4d5543adc.png)"}] [{:db/id #edb/ref 17592186529146 :knowledge-point/_questions [{:db/id #edb/ref 17592186100848 :knowledge-point/id #uuid "a8224846-04e6-531d-9415-9a18d2afddb6" :knowledge-point/title "Identifying the Graph of a Translated Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d992e4a-61ac-52f1-bc1b-70dc3650f4cb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fc/fc18b58c55adbb3663f290e88238de9ff392bc00c13784bc61a07570cd3bfe61.png" :db/id #edb/ref 17592186528416} {:answer/id #uuid "536561c5-116e-5bc9-b117-97c9aa909d9f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/97/977514753990a2eabf8d9e91b3d99de13823c59809dc71d4063bcec8eaaeed50.png" :db/id #edb/ref 17592186528501} {:answer/id #uuid "8b85c6fd-b36c-5f3e-aa92-ef2e87392112" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fe/fefee0c17d1e620ba54934de06cf4467099233bfc6aec7e09f2cd27b2d239686.png" :db/id #edb/ref 17592186528634} {:answer/id #uuid "c10fae32-9c98-5d0c-ac63-9f70c6572aa6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/01/01e3f9c35d113349c65c2783bc23b3e43b728b722362b9786967d5229d62a4e2.png" :db/id #edb/ref 17592186528773} {:answer/id #uuid "c560d190-312c-5059-98d3-9dd7221f7fd9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b2/b20278280acb62ce22435242fc487e687b26c253a8c07029fae673f5b2e04544.png" :db/id #edb/ref 17592186528784}] :answer-field/correct {:answer/id #uuid "2d992e4a-61ac-52f1-bc1b-70dc3650f4cb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fc/fc18b58c55adbb3663f290e88238de9ff392bc00c13784bc61a07570cd3bfe61.png" :db/id #edb/ref 17592186528416} :answer-field/id #uuid "d53ea49b-a4ff-5e2f-a0e2-8747562b72f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186529060}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "856534cf-3669-5864-adb1-aa4947ae5494" :question/math-academy-id "q-108147" :question/problem "![](images/e5/e59a35140e008485fc092f716c318ff1ade67b68a8b9988150308af576759466.png)\n\nThe graph of $y=f(x)$ is shown above and the point $(0,3)$ lies on the curve. Which of the following is the graph of $y=f(x)-1?$" :question/worked-solution "The graph of $y=f(x)$ passes through the point $(0,3)$ as shown in the diagram. \n\nThe graph of $y=f(x)-1$ can be obtained from $y=f(x)$ by translating it by $1$ unit *down*. So, it must pass through the point $(0,2).$\n\nThe correct graph is shown below.\n\n![](images/56/56c48b2115d50b1d4e6ab105ba8214275a43efe0267857370976df55a205252a.png)"}] [{:db/id #edb/ref 17592186529167 :knowledge-point/_questions [{:db/id #edb/ref 17592186100887 :knowledge-point/id #uuid "d982b565-2c41-5687-8d00-86b971bfb18b" :knowledge-point/title "Identifying the Graph of an Original Function Given a Translated Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98dd34b6-5840-5ea1-8244-4ec9cda505b6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/85/853a7019b8e0938a9caccd53e5fc409b30df29f5fcc59812e06f091f18ef3f79.png" :db/id #edb/ref 17592186528663} {:answer/id #uuid "a7c36a5e-7610-531b-ba57-42084d7ad093" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/15/150e969c9641ddbbc6f16857f76a063c023ac5b69c74b38198896ca8700e071c.png" :db/id #edb/ref 17592186528706} {:answer/id #uuid "b8edbe13-ad24-55a2-838a-9badb0a431e7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/91/91a3746504a7a1fcf9dd701ea137e6dc980fd3b46b8587b3fc71ab599c027ad0.png" :db/id #edb/ref 17592186528750} {:answer/id #uuid "cff59d4d-bda6-5efd-a05d-310ba7549a9a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fe/fe52a89f7cc2b997962ff9043b9cca27b1810ab961766053f34a89f4434445d5.png" :db/id #edb/ref 17592186528814} {:answer/id #uuid "f0833b90-42ab-5855-a5cc-e97f6b7d1b68" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3c/3cd26cbfea5da41b6299dc075f51ad19fedcebd33e9d293daf5ae5c6a7a22ef8.png" :db/id #edb/ref 17592186528893}] :answer-field/correct {:answer/id #uuid "98dd34b6-5840-5ea1-8244-4ec9cda505b6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/85/853a7019b8e0938a9caccd53e5fc409b30df29f5fcc59812e06f091f18ef3f79.png" :db/id #edb/ref 17592186528663} :answer-field/id #uuid "664aa3e5-c609-577f-9bf0-0b5af2556766" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186529001}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c103a5cd-d8c5-5183-99b4-f60981d83dcb" :question/math-academy-id "q-108217" :question/problem "![](images/2f/2f877bbec2e880c8a64979997cb8694390f568ee7d2ad240d3a38f07de04157d.png)\n\nThe graph of $g(x)=f(x)+2$ is shown above. Which of the following is the graph of $y=f(x)?$" :question/worked-solution "From the diagram, the graph of $y=f(x)+2$ passes through the point $(0,-2).$\n\nThe graph of $y=f(x)+2$ can be obtained from the graph of $y=f(x)$ by translating $2$ units *up*. \n\nSo, the graph $y=f(x)$ would be $2$ units *below* the graph of $y=f(x)+2.$\n\n![](images/34/34927fd5b2a6245822c4d39ad38e15449d18b068b57dc6f7d7468037b1e53a59.png)"}] [{:db/id #edb/ref 17592186529106 :knowledge-point/_questions [{:db/id #edb/ref 17592186100849 :knowledge-point/id #uuid "10557b22-4b4b-5860-abcb-0dcd96a5743d" :knowledge-point/title "Identifying the Vertical Shift of a Translated Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "408388ae-c71c-5a75-be53-309c59afe320" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186528465} {:answer/id #uuid "5ee410dc-eac8-53e5-8eed-88265c9ceec3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186528522} {:answer/id #uuid "6d99fce5-7d01-55e5-b9e8-8992bc58bc16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186528562} {:answer/id #uuid "d078ba90-2068-5c7a-a111-9232a1285b20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186528815} {:answer/id #uuid "e2c17db8-79d4-5c91-98c2-303483103c80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186528858}] :answer-field/correct {:answer/id #uuid "e2c17db8-79d4-5c91-98c2-303483103c80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186528858} :answer-field/id #uuid "90936840-6505-56df-90f9-a2edfbec12cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186529019}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2b584399-1501-573d-8e9c-16d0bbc631a2" :question/math-academy-id "q-108226" :question/problem "![](images/71/7187ce3dfce771f3897b7073704b49fa8926bb8c1a16cd18af68e02978d2a526.png)\n\nConsider the solid curve $y=f(x)$ and the dashed curve $y=f(x)+c$ shown above. What is the value of $c?$" :question/worked-solution "The graph of $y=f(x)+c$ can be obtained from the graph of $y=f(x)$ by translating it $7$ units *up*. So, $c=7.$\n\n![](images/a5/a5322569c974effb49773ee06a38da3f1953e0d9fc55464d8fae367e45dc15af.png)"}] [{:db/id #edb/ref 17592186529184 :knowledge-point/_questions [{:db/id #edb/ref 17592186100847 :knowledge-point/id #uuid "ac31493b-30d0-5ed1-8422-f1f475e3c576" :knowledge-point/title "Identifying Points that Must Lie on a Translated Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1846fb2f-d11a-5c6c-8a8b-c56637894b4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,5)" :db/id #edb/ref 17592186528363} {:answer/id #uuid "218a5463-3916-500e-8478-33f18275f486" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,1)" :db/id #edb/ref 17592186528393} {:answer/id #uuid "4b9120fe-c1c3-53ef-a361-99b8cca626c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,7)" :db/id #edb/ref 17592186528488} {:answer/id #uuid "5c9182da-26b4-50dd-b999-b06ea4f26402" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-1)" :db/id #edb/ref 17592186528519} {:answer/id #uuid "7c0a67dc-b1bb-53f1-a28d-e4de8f2a5cf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,0)" :db/id #edb/ref 17592186528593}] :answer-field/correct {:answer/id #uuid "5c9182da-26b4-50dd-b999-b06ea4f26402" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-1)" :db/id #edb/ref 17592186528519} :answer-field/id #uuid "d83fabbc-abe9-5f4d-98e0-63937e6bc2ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186529062}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e09e1da8-e383-596f-bdbd-80147bb9fb19" :question/math-academy-id "q-108382" :question/problem "The point $P$ with coordinates $(-2,3)$ lies on the curve $y=f(x)+4.$ Which of the following points must lie on $y=f(x)?$" :question/worked-solution "**Method 1**\n\nThe graph of $y=f(x)$ is obtained by translating the graph of $y=f(x)+4$ by $4$ units *down.* \n\nHence, if the point $(-2,3)$ lies on $y=f(x)+4$, then the point \n\n$$\n(-2,3-4)=(-2,-1)\n$$\n\nlies on $y=f(x).$\n\n![](images/5f/5f74a8d57dc1766912c4490ab156d0f7f2ed0bbc9b4dbb9e53ae46c48ceb8bb5.png)\n\n**Method 2**\n\nAs $(-2,3)$ lies on $y=f(x)+4$, we have:\n\n$$\n\\begin{aligned}f(-2)+4 & =3 \\\\ f(-2) & =3-4 \\\\ f(-2) & =-1\\end{aligned}\n$$\n\nNow, if $x=-2$ then\n\n$$\n\\begin{aligned}y & =f(-2) \\\\  & =-1.\\end{aligned}\n$$\n\nSo, the point $(-2,-1)$ must lie on $y=f(x).$"}] [{:db/id #edb/ref 17592186101206 :knowledge-point/_questions [{:db/id #edb/ref 17592186100848 :knowledge-point/id #uuid "a8224846-04e6-531d-9415-9a18d2afddb6" :knowledge-point/title "Identifying the Graph of a Translated Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99857060-4593-5df7-bb86-6d13bb41052f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5d/5decf42f3a6059de5d197dbab0c82fe37a67f984bd8b2218fd2480d7bab38dcd.png" :db/id #edb/ref 17592186098572} {:answer/id #uuid "c5fe9c0b-e773-51cf-8f13-6e347d09961e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/94/94c0b61fb4cc7520c040429baa4b7377ce2705869346d6c2213155ea9557b100.png" :db/id #edb/ref 17592186098573} {:answer/id #uuid "d5bdadae-1e47-5327-b074-0eb473615370" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f2/f2ccec17cbdd53865b5915156cced1e5533d18fc0cccda566d942f521118216c.png" :db/id #edb/ref 17592186098574} {:answer/id #uuid "ee17b9c8-c085-5838-a10c-520080108563" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ff/ffbec42cd49ed7bb3c30b41e3a91b9c3aa592b0017813ea3debfc3e613b61b27.png" :db/id #edb/ref 17592186098575} {:answer/id #uuid "fab4872e-1342-5416-9585-f66b6910a517" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f1/f1a2f1b25cc02927d65d55de971b6579377629b570e08dad80d543a36e405cf9.png" :db/id #edb/ref 17592186098576}] :answer-field/correct {:answer/id #uuid "c5fe9c0b-e773-51cf-8f13-6e347d09961e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/94/94c0b61fb4cc7520c040429baa4b7377ce2705869346d6c2213155ea9557b100.png" :db/id #edb/ref 17592186098573} :answer-field/id #uuid "3626a35f-e2e4-5cf7-9463-6bab151822cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186098571}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c24cb6a5-e9b4-5b2a-b705-fcd1200bf566" :question/math-academy-id "q-15562" :question/problem "![](images/82/82012efd1fbf78238ce1b6ecc49819283976db8f39ac5f57ec232a5eda8029dc.png)\n\nThe graph of $y=f(x)$ is shown above and the point $(0,1)$ lies on the curve. Which of the following is the graph of $y=f(x)+2?$" :question/worked-solution "The graph of $y=f(x)$ passes through the point $(0,1)$ as shown in the diagram. \n\nThe graph of $y=f(x)+2$ can be obtained from $y=f(x)$ by translating it by $2$ units *up*. So, it must pass through the point $(0,3).$\n\nThe correct graph is shown below.\n\n![](images/5f/5f0a46e8f6ef1daac4acbaf49e5fb1ffc21046cbfc6260fe6dbe51d1814a1c12.png)"}] [{:db/id #edb/ref 17592186529192 :knowledge-point/_questions [{:db/id #edb/ref 17592186100887 :knowledge-point/id #uuid "d982b565-2c41-5687-8d00-86b971bfb18b" :knowledge-point/title "Identifying the Graph of an Original Function Given a Translated Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e1392d9-c3ad-52cb-8246-784f99d67d3d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d7/d77bb469fad643a6d6eb7d5ec1cae73a5a4d47c1519cb16bea4e702e5bf60ade.png" :db/id #edb/ref 17592186528600} {:answer/id #uuid "96c26e5b-56f5-5181-acd9-3794365e8114" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/54/54be772209a775494b9a29be3a00c796833be9697cfb93b70ec2460726015a24.png" :db/id #edb/ref 17592186528658} {:answer/id #uuid "ace28041-7ad9-5b57-94d8-6d9337e5852f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a3/a360c41302b317f2796fede233e8726bf53e44739e681d8d5688c135b2f70aa7.png" :db/id #edb/ref 17592186528722} {:answer/id #uuid "e9ae0929-cd53-5e34-b436-ab42a9d27ce4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6a/6ae7b8477bdf74fbf65690dc9c673c2e0308393b4162b6ed7db46654b16dfdbe.png" :db/id #edb/ref 17592186528876} {:answer/id #uuid "efea5a26-233a-5dd7-b6f9-3736355cb1c6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7d/7d082b4f60331a88b6a660f49d11dc528f8beeec090e69179674e2a2fcc06c4e.png" :db/id #edb/ref 17592186528890}] :answer-field/correct {:answer/id #uuid "96c26e5b-56f5-5181-acd9-3794365e8114" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/54/54be772209a775494b9a29be3a00c796833be9697cfb93b70ec2460726015a24.png" :db/id #edb/ref 17592186528658} :answer-field/id #uuid "f9126edb-4829-5fbd-872b-e65af4e696bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186529083}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f5dc650c-6521-56fb-b358-5191cc78caea" :question/math-academy-id "q-26133" :question/problem "![](images/17/17c126ec4e6f901d038d28ca52ce3dedfb79abcd630694cfb465a57720fa6a42.png)\n\nThe graph of $y=f(x)-2$ is shown above. Which of the following is the graph of $y=f(x)?$" :question/worked-solution "The graph of $y=f(x)-2$ can be obtained from the graph of $y=f(x)$ by translating $2$ units *down*. \n\nSo, the graph $y=f(x)$ would be $2$ units *above* the graph of $y=f(x)-2.$\n\n![](images/1f/1f44fbd262f38470c13ae55acc11601491dde2662909e1a312600086a78b7adb.png)"}] [{:db/id #edb/ref 17592186529163 :knowledge-point/_questions [{:db/id #edb/ref 17592186100847 :knowledge-point/id #uuid "ac31493b-30d0-5ed1-8422-f1f475e3c576" :knowledge-point/title "Identifying Points that Must Lie on a Translated Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02e3936f-735b-5739-9f09-3e74a82318f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,0)" :db/id #edb/ref 17592186528306} {:answer/id #uuid "9138bce0-3929-50d0-a3b3-2a59060c22de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-1)" :db/id #edb/ref 17592186528647} {:answer/id #uuid "bbf1a6b1-5480-5182-b8fd-9f38cf9f6d99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,1)" :db/id #edb/ref 17592186528757} {:answer/id #uuid "c2f46679-b601-5392-a4a4-0c4b58d5241e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,2)" :db/id #edb/ref 17592186528776} {:answer/id #uuid "ec7b4503-619f-5a8e-b675-a2ab33c15ae1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,1)" :db/id #edb/ref 17592186528884}] :answer-field/correct {:answer/id #uuid "02e3936f-735b-5739-9f09-3e74a82318f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,0)" :db/id #edb/ref 17592186528306} :answer-field/id #uuid "eda83d9c-61f5-554b-a3a6-fe587fe8ef1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186529078}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b9eb1708-044c-5408-bdf8-03d4b09b76eb" :question/math-academy-id "q-27000" :question/problem "The point $P$ with coordinates $(-3,1)$ lies on the curve $y=f(x)+1.$ Which of the following points must lie on $y=f(x)?$" :question/worked-solution "**Method 1**\n\nThe graph of $y=f(x)$ is obtained by translating the graph of $y=f(x)+1$ by $1$ unit *down.* \n\nHence, if the point $(-3,1)$ lies on $y=f(x)+1$, then the point \n\n$$\n(-3,1-1)=(-3,0)\n$$\n\nlies on $y=f(x).$\n\n![](images/2c/2c76b54e0dc12d52fbc6e41a601d5e87a105537e055a9d4cee4c758b0dd3ae63.png)\n\n**Method 2**\n\nAs $(-3,1)$ lies on $y=f(x)+1$, we have:\n\n$$\n\\begin{aligned}f(-3)+1 & =1 \\\\ f(-3) & =1-1 \\\\ f(-3) & =0\\end{aligned}\n$$\n\nNow, if $x=-3$ then\n\n$$\n\\begin{aligned}y & =f(-3) \\\\  & =0.\\end{aligned}\n$$\n\nSo, the point $(-3,0)$ must lie on $y=f(x).$"}] [{:db/id #edb/ref 17592186529108 :knowledge-point/_questions [{:db/id #edb/ref 17592186100849 :knowledge-point/id #uuid "10557b22-4b4b-5860-abcb-0dcd96a5743d" :knowledge-point/title "Identifying the Vertical Shift of a Translated Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bc8ce54-b742-59c6-9903-b78514719396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186528376} {:answer/id #uuid "1e2d58a8-eb6b-5ef4-954f-729d860e075d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186528381} {:answer/id #uuid "5fd49550-1b77-52c7-b0e0-8cf183055005" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186528525} {:answer/id #uuid "6da3e2a8-a432-5259-a55b-a51c0d3a0e48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186528563} {:answer/id #uuid "e58738c4-3bf2-5bfe-aa4f-5d3984b37392" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186528866}] :answer-field/correct {:answer/id #uuid "1bc8ce54-b742-59c6-9903-b78514719396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186528376} :answer-field/id #uuid "72225bb6-b5d8-56a1-ac12-0e99393c3266" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186529007}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3149eba2-f75e-505c-909c-9beed59b368d" :question/math-academy-id "q-70595" :question/problem "![](images/62/62474d31ab2981d6173671acb875ec401a51c230994e60e10421d385f2e099a9.png)\n\nConsider the solid curve $y=f(x)$ and the dashed curve $y=f(x)+b$ shown above. What is the value of $b?$" :question/worked-solution "The graph of $y=f(x)+b$ can be obtained from the graph of $y=f(x)$ by translating it $6$ units *down*. So, $b=-6.$\n\n![](images/3f/3fcbd6ce5ea6543fea0038df30e8f31db18c82ceefa975aaaec1854d85766eab.png)"}]}
