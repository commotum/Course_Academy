#{[{:activity/first-step {:db/id #edb/ref 17592186101638} :activity/id #uuid "fa3b0123-3cb4-59d6-8bc7-e2be683f501b" :activity/scope {:db/id #edb/ref 17592186050647 :topic/id #uuid "5c0a40b2-d1c1-52e2-9f18-dd59bcf6cdb7" :topic/math-academy-id 1251} :activity/steps [{:db/id #edb/ref 17592186101638 :step/content {:db/id #edb/ref 17592186101945 :tutorial/content "Suppose that we have the graph of $y=f(x)$ shown below. What would the graph of\n\n$$\ny=f(x)+2\n$$\n\nlook like, and how does it relate to the original curve?\n\n![](images/1a/1a55ebd7e9dc656f3a2488debf14e63e655ed7548b76f63c26498f09d96d65ca.png)\n\nFor each point on the graph of $y=f(x)$ there is a corresponding point on the graph of\n\n$$\ny=f(x)+2\n$$\n\nwith the same $x$-value and a $y$-value that is two units greater. So let's create a table of points.\n\n$$\n\\begin{bmatrix}Points on [math]y=f(x)[/math] & Points on [math]y=f(x)+2[/math] \\\\ (-2, 0) & (-2, 2) \\\\ (0, 1.5) & (0, 3.5) \\\\ (1, 2) & (1, 4) \\\\ (3,-3) & (3,-1)\\end{bmatrix}\n$$\n\nEvery point on the graph of\n\n$$\ny=f(x)+2\n$$\n\nis precisely two units above a point on the graph of $y=f(x)$. The graph of\n\n$$\ny=f(x)+2\n$$\n\nis an **upward vertical translation** of the graph of $y=f(x)$ by two units.\n\n![](images/66/6636d65acf9cd34d818d3d9e12a7b7de36dec4ceb70c7503a08751f971868855.png)\n\nOn the other hand, for each point on the graph of $y=f(x)$ there is a corresponding point on the graph of $y=f(x)-2$ with the same $x$-value and a $y$-value that is two units smaller. So let's create a table of points.\n\n$$\n\\begin{bmatrix}Points on [math]y=f(x)[/math] & Points on [math]y=f(x)-2[/math] \\\\ (-2, 0) & (-2,-2) \\\\ (0, 1.5) & (0,-0.5) \\\\ (1, 2) & (1, 0) \\\\ (3,-3) & (3,-5)\\end{bmatrix}\n$$\n\nEvery point on the graph of $y=f(x)-2$ is two units below a point on the graph of $y=f(x)$. The graph of $y=f(x)-2$ is a **downward vertical translation** of the graph of $y=f(x)$ by two units.\n\n![](images/72/72588aaa92f5b4bf9923c381cf5ad28ebb7288e77f6442549d0ffe1fdac3dc48.png)" :tutorial/id #uuid "198f4c8f-65df-5b93-951c-12fd4d9dfd12" :tutorial/math-academy-id 2809 :tutorial/title "Introduction"} :step/id #uuid "f72e4e92-9df5-551e-bf9d-c6db356cd3c2" :step/math-academy-id 14720 :step/next {:db/id #edb/ref 17592186101640}} {:db/id #edb/ref 17592186101639 :step/content {:db/id #edb/ref 17592186100847 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100668 :question/id #uuid "8c6c748a-f067-527d-91aa-3ead12bb569d" :question/math-academy-id "e-4106"} :knowledge-point/id #uuid "ac31493b-30d0-5ed1-8422-f1f475e3c576" :knowledge-point/questions [{:db/id #edb/ref 17592186101355} {:db/id #edb/ref 17592186101356}] :knowledge-point/title "Identifying Points that Must Lie on a Translated Curve"} :step/id #uuid "4f45cbb5-b569-58b3-95eb-fbb98b10614a" :step/math-academy-id 14721} {:db/id #edb/ref 17592186101640 :step/content {:db/id #edb/ref 17592186100848 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100669 :question/id #uuid "7b856c88-45bf-54a5-80c4-134a7544742c" :question/math-academy-id "e-4107"} :knowledge-point/id #uuid "a8224846-04e6-531d-9415-9a18d2afddb6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048838}] :knowledge-point/questions [{:db/id #edb/ref 17592186101203} {:db/id #edb/ref 17592186101206}] :knowledge-point/title "Identifying the Graph of a Translated Function"} :step/id #uuid "e7dee1eb-ff16-5f46-b872-2042f7c92dcc" :step/math-academy-id 14722 :step/next {:db/id #edb/ref 17592186101704}} {:db/id #edb/ref 17592186101641 :step/content {:db/id #edb/ref 17592186100849 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100670 :question/id #uuid "85d2f012-deb3-55dc-8e38-51bfe62eab20" :question/math-academy-id "e-4108"} :knowledge-point/id #uuid "10557b22-4b4b-5860-abcb-0dcd96a5743d" :knowledge-point/questions [{:db/id #edb/ref 17592186101215} {:db/id #edb/ref 17592186101354}] :knowledge-point/title "Identifying the Vertical Shift of a Translated Function"} :step/id #uuid "ba6cf136-6d59-5437-b6e3-d44b8ca10f7b" :step/math-academy-id 14723 :step/next {:db/id #edb/ref 17592186101639}} {:db/id #edb/ref 17592186101704 :step/content {:db/id #edb/ref 17592186100887 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100712 :question/id #uuid "1c57d35a-24ad-51ae-b00d-0f55396f045d" :question/math-academy-id "e-5007"} :knowledge-point/id #uuid "d982b565-2c41-5687-8d00-86b971bfb18b" :knowledge-point/questions [{:db/id #edb/ref 17592186101353} {:db/id #edb/ref 17592186101384}] :knowledge-point/title "Identifying the Graph of an Original Function Given a Translated Function"} :step/id #uuid "0612808f-4124-5dbf-a60c-734f4636a504" :step/math-academy-id 18128 :step/next {:db/id #edb/ref 17592186101705}} {:db/id #edb/ref 17592186101705 :step/content {:db/id #edb/ref 17592186101972 :tutorial/content "Consider the solid curve $y=f(x)$ and the dashed curve\n\n$$\ny=f(x)+b\n$$\n\nshown below. What is the value of $b$?\n\n![](images/b0/b058da1ea31e45f3029f1542642d802a35da7280f315a37ea92044e5c322fbd4.png)\n\nThe graph of\n\n$$\ny=f(x)+b\n$$\n\ncan be obtained from the graph of $y=f(x)$ by translating it $6$ units down. So, $b=-6$." :tutorial/id #uuid "f2c0aba0-7e3b-5a75-83b0-7386793a015b" :tutorial/math-academy-id 3295 :tutorial/title "Identifying the Shift"} :step/id #uuid "f13d8d49-a65d-58fb-9ad0-f736406fedbb" :step/math-academy-id 18130 :step/next {:db/id #edb/ref 17592186101641}}] :activity/title "Vertical Translations of Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186101091}]}
