        "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14108275/observations/step-t9213-b56c37d60e3860bac13d.html",
        "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14108275/observations/step-t9213-b56c37d60e3860bac13d.png",
        "source_url": "https://mathacademy.com/tasks/14108275/topics/3411/lesson",
        "captured_at": 1791694217.445872,
        "math_academy_id": "9213",
        "topic_id": "3411",
        "sequence_position": null,
        "source_step": {
