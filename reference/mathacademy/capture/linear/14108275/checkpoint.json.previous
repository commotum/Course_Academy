"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E3-MJMAIN-2B\" x=\"3780\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-31\" x=\"4780\" y=\"0\"></use>\n</g>\n<g transform=\"translate(0,-3625)\">\n <use xlink:href=\"#E3-MJMAIN-3D\" x=\"277\" y=\"0\"></use>\n<g transform=\"translate(1334,0)\">\n<g fill=\"red\" stroke=\"red\">\n<g fill=\"red\" stroke=\"red\">\n<g fill=\"red\" stroke=\"red\">\n<g fill=\"red\" stroke=\"red\">\n<g fill=\"red\" stroke=\"red\">\n <use xlink:href=\"#E3-MJMAIN-32\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E3-MJMAIN-D7\" x=\"2056\" y=\"0\"></use>\n<g transform=\"translate(3057,0)\">\n <use xlink:href=\"#E3-MJMAIN-28\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(389,0)\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n <use xlink:href=\"#E3-MJMAIN-2212\"></use>\n</g>\n<g fill=\"blue\" stroke=\"blue\" transform=\"translate(778,0)\">\n <use xlink:href=\"#E3-MJMAIN-39\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E3-MJMAIN-29\" x=\"1668\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E3-MJMAIN-2B\" x=\"5337\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-31\" x=\"6338\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n<p>In general, an integer <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.395ex\" height=\"1.676ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -576.1 600.5 721.6\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-4-Title\">\n<title id=\"MathJax-SVG-4-Title\">n</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E4-MJMATHI-6E\" d=\"M21 287Q22 293 24 303T36 341T56 388T89 425T135 442Q171 442 195 424T225 390T231 369Q231 367 232 367L243 378Q304 442 382 442Q436 442 469 415T503 336T465 179T427 52Q427 26 444 26Q450 26 453 27Q482 32 505 65T540 145Q542 153 560 153Q580 153 580 145Q580 144 576 130Q568 101 554 73T508 17T439 -10Q392 -10 371 17T350 73Q350 92 386 193T423 345Q423 404 379 404H374Q288 404 229 303L222 291L189 157Q156 26 151 16Q138 -11 108 -11Q95 -11 87 -5T76 7T74 17Q74 30 112 180T152 343Q153 348 153 366Q153 405 129 405Q91 405 66 305Q60 285 60 284Q58 278 41 278H27Q21 284 21 287Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E4-MJMATHI-6E\" x=\"0\" y=\"0\"></use>\n</g>\n</svg></span> is odd if it can be written as </p>\n<p><span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"10.888ex\" height=\"2.343ex\" style=\"vertical-align: -0.505ex;\" viewBox=\"0 -791.3 4688 1008.6\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-5-Title\">\n<title id=\"MathJax-SVG-5-Title\">\nn={\\color{red}{2}}{\\color{blue}{a}}+1\n</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E5-MJMATHI-6E\" d=\"M21 287Q22 293 24 303T36 341T56 388T89 425T135 442Q171 442 195 424T225 390T231 369Q231 367 232 367L243 378Q304 442 382 442Q436 442 469 415T503 336T465 179T427 52Q427 26 444 26Q450 26 453 27Q482 32 505 65T540 145Q542 153 560 153Q580 153 580 145Q580 144 576 130Q568 101 554 73T508 17T439 -10Q392 -10 371 17T350 73Q350 92 386 193T423 345Q423 404 379 404H374Q288 404 229 303L222 291L189 157Q156 26 151 16Q138 -11 108 -11Q95 -11 87 -5T76 7T74 17Q74 30 112 180T152 343Q153 348 153 366Q153 405 129 405Q91 405 66 305Q60 285 60 284Q58 278 41 278H27Q21 284 21 287Z\"></path>\n<path stroke-width=\"1\" id=\"E5-MJMAIN-3D\" d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\"></path>\n<path stroke-width=\"1\" id=\"E5-MJMAIN-32\" d=\"M109 429Q82 429 66 447T50 491Q50 562 103 614T235 666Q326 666 387 610T449 465