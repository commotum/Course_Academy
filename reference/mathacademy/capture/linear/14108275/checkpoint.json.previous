\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E9-MJMATHI-61\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E9-MJMAIN-3D\" x=\"807\" y=\"0\"></use>\n<g transform=\"translate(1863,0)\">\n<rect fill=\"Gainsboro\" stroke=\"none\" width=\"6257\" height=\"1517\" x=\"0\" y=\"-383\"></rect>\n<g>\n<g transform=\"translate(300,0)\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n <use xlink:href=\"#E9-MJMAIN-32\"></use>\n</g>\n<g fill=\"blue\" stroke=\"blue\" transform=\"translate(500,0)\">\n<g fill=\"blue\" stroke=\"blue\">\n <use xlink:href=\"#E9-MJMATHI-6D\"></use>\n</g>\n<g fill=\"blue\" stroke=\"blue\" transform=\"translate(878,362)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E9-MJMAIN-32\"></use>\n</g>\n</g>\n<g fill=\"blue\" stroke=\"blue\" transform=\"translate(2055,0)\">\n <use xlink:href=\"#E9-MJMAIN-2B\"></use>\n</g>\n<g fill=\"blue\" stroke=\"blue\" transform=\"translate(3055,0)\">\n <use xlink:href=\"#E9-MJMATHI-6D\"></use>\n</g>\n<g fill=\"blue\" stroke=\"blue\" transform=\"translate(4156,0)\">\n <use xlink:href=\"#E9-MJMAIN-2212\"></use>\n</g>\n<g fill=\"blue\" stroke=\"blue\" transform=\"translate(5157,0)\">\n <use xlink:href=\"#E9-MJMAIN-31\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n</svg></span> is an integer.</p>\n</blockquote>\n\n            </div>           \n        </div>",
