        "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14108275/observations/step-t9212-d6ae660a798d483400bd.html",
        "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14108275/observations/step-t9212-d6ae660a798d483400bd.png",
        "source_url": "https://mathacademy.com/tasks/14108275/topics/3411/lesson",
        "captured_at": 1791694218.1071777,
        "math_academy_id": "9212",
