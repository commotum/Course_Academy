      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14108275/observations/step-t8323-d61457fcda9568b632ef.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14108275/observations/step-t8323-d61457fcda9568b632ef.png",
