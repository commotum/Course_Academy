ked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}{(-{x}^{-3}y)}^{-5} & = \\\\ {(-{x}^{-3})}^{-5}{(y)}^{-5} & = \\\\ (-x)^{(-3)(-5)}\\cdot {y}^{-5} & = \\\\ (-x)^{15}\\cdot \\frac{1}{{y}^{5}} & = \\\\ -\\frac{{x}^{15}}{{y}^{5}} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186554559 :knowledge-point/_questions [{:db/id #edb/ref 17592186105852 :knowledge-point/id #uuid "ae5f5e65-7642-5ca1-bf84-013dbd3c7ae4" :knowledge-point/title "Using the Power of Product Rule with Three Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39a048f4-b696-5d88-9519-392e8e22e129" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16j{k}^{3}" :db/id #edb/ref 17592186553970} {:answer/id #uuid "713596cb-dbdf-583d-8df0-e7b6de0f53fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8j{k}^{2}" :db/id #edb/ref 17592186554098} {:answer/id #uuid "bd52da4c-f3c3-5018-81ce-5520be446816" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{j}^{2}{k}^{3}" :db/id #edb/ref 17592186554279} {:answer/id #uuid "bfa9d854-b690-557b-9cf8-00bc258e57e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8j{k}^{3}" :db/id #edb/ref 17592186554287} {:answer/id #uuid "d7caea2c-6c38-51d9-84aa-cab1a88d13e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4j{k}^{3}" :db/id #edb/ref 17592186554341}] :answer-field/correct {:answer/id #uuid "d7caea2c-6c38-51d9-84aa-cab1a88d13e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4j{k}^{3}" :db/id #edb/ref 17592186554341} :answer-field/id #uuid "8f6feef9-5b17-5501-a989-7991e5c6b599" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554489}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2ccfb4b8-1710-553d-964a-06ac5c1fded5" :question/math-academy-id "q-3925" :question/problem "${(16{j}^{2}{k}^{6})}^{1/2}=$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}{(16{j}^{2}{k}^{6})}^{1/2} & = \\\\ {({4}^{2}{j}^{2}{k}^{6})}^{1/2} & = \\\\ {({4}^{2})}^{1/2}\\cdot {({j}^{2})}^{1/2}\\cdot {({k}^{6})}^{1/2} & = \\\\ {4}^{2\\cdot (1/2)}\\cdot {j}^{2\\cdot (1/2)}\\cdot {k}^{6\\cdot (1/2)} & = \\\\ {4}^{2/2}\\cdot {j}^{2/2}\\cdot {k}^{6/2} & = \\\\ 4j{k}^{3} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186554603 :knowledge-point/_questions [{:db/id #edb/ref 17592186105851 :knowledge-point/id #uuid "85159201-5cf2-53da-91bf-ba7ef462a4fa" :knowledge-point/title "Using the Power of Product Rule with a Negative Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12d2c391-f724-56a7-827a-5b0ee1b7184c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{a}^{-12}" :db/id #edb/ref 17592186553907} {:answer/id #uuid "3476cf8d-22e9-5166-95b3-22c6d287fda7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2a" :db/id #edb/ref 17592186553962} {:answer/id #uuid "9eecc025-04bf-5f32-a413-b83d915ee7b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16a" :db/id #edb/ref 17592186554220} {:answer/id #uuid "b9c886d3-298f-5f9a-9fff-7c4c836fe3de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{a}^{-12}" :db/id #edb/ref 17592186554272} {:answer/id #uuid "ecded79e-f3fd-5eb2-b624-d0cb685b64e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{a}^{12}" :db/id #edb/ref 17592186554388}] :answer-field/correct {:answer/id #uuid "12d2c391-f724-56a7-827a-5b0ee1b7184c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{a}^{-12}" :db/id #edb/ref 17592186553907} :answer-field/id #uuid "b457e636-29ae-54cf-8fbb-773aa5b75aa5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554501}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "90c0de8b-ab19-5e68-9b86-0c6dd26a2646" :question/math-academy-id "q-72552" :question/problem "Which of the following is equivalent to ${(2{a}^{-3})}^{4}?$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}{(2{a}^{-3})}^{4} & = \\\\ {2}^{4}{({a}^{-3})}^{4} & = \\\\ 16\\cdot {a}^{-3\\cdot 4} & = \\\\ 16{a}^{-12} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186554644 :knowledge-point/_questions [{:db/id #edb/ref 17592186105851 :knowledge-point/id #uuid "85159201-5cf2-53da-91bf-ba7ef462a4fa" :knowledge-point/title "Using the Power of Product Rule with a Negative Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d1b1998-3649-527c-9f18-85f6ed4d186b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{-6}y" :db/id #edb/ref 17592186553897} {:answer/id #uuid "50b57b47-dd06-59e4-862a-1653f1f39acf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{6}{y}^{-3}" :db/id #edb/ref 17592186554027} {:answer/id #uuid "9c590931-8e73-502b-9ded-3f5d518bafca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{-5}{y}^{-2}" :db/id #edb/ref 17592186554211} {:answer/id #uuid "b0038dc0-b689-596e-9dc9-df1132a86d6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{-2}{y}^{-3}" :db/id #edb/ref 17592186554259} {:answer/id #uuid "fc30d189-cf7d-5f99-8f8f-388141bfd59a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{6}y" :db/id #edb/r