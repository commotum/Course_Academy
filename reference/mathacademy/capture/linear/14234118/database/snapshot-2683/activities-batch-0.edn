\ \\frac{49}{{x}^{10}}\\end{aligned}\n$$"} :step/id #uuid "b7a760a1-c69c-5443-b629-d0a8e1e4e722"} {:db/id #edb/ref 17592186499631 :step/content {:db/id #edb/ref 17592186499517 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01a0d9e9-f16f-5e35-91eb-3bd865760ce9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{-{x}^{8}{y}^{-3}}{6}" :db/id #edb/ref 17592186498733} {:answer/id #uuid "45914d4a-b895-5bc8-a1de-5a3d97104256" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{6}{y}^{-3}}{6}" :db/id #edb/ref 17592186498891} {:answer/id #uuid "49c8eea6-1485-5196-a051-14e2a91ed557" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{6}{y}^{-3}}{8}" :db/id #edb/ref 17592186498901} {:answer/id #uuid "d3a6ab37-02d3-5559-97f9-826e50636e02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{8}{y}^{3}}{6}" :db/id #edb/ref 17592186499201} {:answer/id #uuid "e19915ad-81b9-58ed-9cd8-716103a6d691" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{-{x}^{6}{y}^{-3}}{8}" :db/id #edb/ref 17592186499236}] :answer-field/correct {:db/id #edb/ref 17592186498901} :answer-field/id #uuid "010a4b8c-41ba-5ff0-99c3-e6f5f3685048" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186499307}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9d191fc2-9ac2-5981-97ca-4426376145b0" :question/math-academy-id "q-816" :question/problem "${(2{x}^{-2}y)}^{-3}=$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}(2{x}^{-2}y)^{-3} & = \\\\ {2}^{-3}{({x}^{-2})}^{-3}{({y}^{1})}^{-3} & = \\\\ \\frac{1}{{2}^{3}}\\cdot {x}^{(-2)(-3)}\\cdot {y}^{(1)(-3)} & = \\\\ \\frac{1}{8}\\cdot {x}^{6}\\cdot {y}^{-3} & = \\\\ \\frac{{x}^{6}{y}^{-3}}{8} & \\end{aligned}\n$$"} :step/id #uuid "eb000f88-82e2-5c2e-9847-f2d22f96de08" :step/next {:db/id #edb/ref 17592186499611}}] :activity/