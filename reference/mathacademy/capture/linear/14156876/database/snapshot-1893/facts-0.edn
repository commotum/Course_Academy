45417] [17592186053727 #edb/ref 1079 #uuid "3e485d8a-d83d-55b0-a881-7cee8f9d2502" #edb/ref 17592186045417] [17592186053728 #edb/ref 1080 "(5x)/(6(x + 1))" #edb/ref 17592186045417] [17592186053728 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186053728 #edb/ref 1083 #uuid "01e2d05f-c74e-59c8-81c3-f1c7aba76542" #edb/ref 17592186045417] [17592186053729 #edb/ref 1080 "\\frac{x}{x + 1}" #edb/ref 17592186045417] [17592186053729 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186053729 #edb/ref 1083 #uuid "1ebad0c4-5374-579d-ba2c-c91f1f73102c" #edb/ref 17592186045417] [17592186053730 #edb/ref 1080 "\\frac{5}{6}" #edb/ref 17592186045417] [17592186053730 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186053730 #edb/ref 1083 #uuid "277311aa-fc6b-5313-ab2d-b522f597d756" #edb/ref 17592186045417] [17592186053731 #edb/ref 1080 "(3x)/(4(x + 1))" #edb/ref 17592186045417] [17592186053731 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186053731 #edb/ref 1083 #uuid "506d6150-47f6-537f-ad1f-ad2d80924c6b" #edb/ref 17592186045417] [17592186053732 #edb/ref 1080 "(4(x + 1))/(3x)" #edb/ref 17592186045417] [17592186053732 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186053732 #edb/ref 1083 #uuid "64c4217d-7ed9-53e9-97fa-279aa2fb5fe7" #edb/ref 17592186045417] [17592186054495 #edb/ref 1069 "e-1608" #edb/ref 17592186045417] [17592186054495 #edb/ref 1071 "Simplify $\\dfrac{3y}{y(y+1)}$." #edb/ref 17592186045417] [17592186054495 #edb/ref 1072 #uuid "009e2843-42b0-5ba1-ae2b-ffd2b7ed39c7" #edb/ref 17592186045417] [17592186054495 #edb/ref 1074 "First, we decompose all of the terms into their prime factors.\n\n$$\n(3y)/(y(y + 1)) = (3 \\cdot y)/(y \\cdot (y + 1))\n$$\n\nThen, we cancel out all the pairs of common factors in the numerator and denominator. In this case, there is one pair of $y$'s.\n\n$$\n\\begin{aligned}\n(3 \\cdot y)/(y \\cdot (y + 1)) &=  \\\\\n(3 \\cdot y)/(y \\cdot (y + 1)) &=  \\\\\n&= \\frac{3}{y + 1}\n\\end{aligned}\n$$\n\nThus, the expression simplifies to\n\n$$\n\\dfrac{3}{y+1}\n$$" #edb/ref 17592186045417] [17592186054496 #edb/ref 1069 "e-1609" #edb/ref 17592186045417] [17592186054496 #edb/ref 1071 "Simplify $\\dfrac{20}{8(z-1)}$." #edb/ref 17592186045417] [17592186054496 #edb/ref 1072 #uuid "200bcd53-5cfe-5fc4-8efe-6de6d5c180c7" #edb/ref 17592186045417] [17592186054496 #edb/ref 1074 "First, we decompose all of the terms into their prime factors. The $20$ in the numerator becomes $2 \\cdot 2 \\cdot 5$, and the $8(z-1)$ in the denominator becomes $2 \\cdot 2 \\cdot 2 \\cdot (z-1)$.\n\n$$\n(20)/(8(z - 1)) = (2 \\cdot 2 \\cdot 5)/(2 \\cdot 2 \\cdot 2 \\cdot (z - 1))\n$$\n\nThen, we cancel out all the pairs of common factors in the numerator and denominator. In this case, there are two pairs of $2$'s.\n\n$$\n\\begin{aligned}\n(2 \\cdot 2 \\cdot 5)/(2 \\cdot 2 \\cdot 2 \\cdot (z - 1)) &=  \\\\\n(2 \\cdot 2 \\cdot 5)/(2 \\cdot 2 \\cdot 2 \\cdot (z - 1)) &=  \\\\\n(5)/(2 \\cdot (z - 1)) &=  \\\\\n&= (5)/(2(z - 1))\n\\end{aligned}\n$$\n\nThus, the expression simplifies to\n\n$$\n\\dfrac{5}{2(z-1)}\n$$" #edb/ref 17592186045417] [17592186054590 #edb/ref 1069 "e-838" #edb/ref 17592186045417] [17592186054590 #edb/ref 1071 "Simplify $\\dfrac{6y(x - 2)}{9yz}$." #edb/ref 17592186045417] [17592186054590 #edb/ref 1072 #uuid "3b2b92fa-7945-5609-8cc4-7ad230d396df" #edb/ref 17592186045417] [17592186054590 #edb/ref 1074 "First, we decompose all of the terms into their prime factors. The $6y(x-2)$ in the numerator becomes $2\\cdot 3 \\cdot y \\cdot (x-2)$, and the $9yz$ in the denominator becomes $3\\cdot 3 \\cdot y \\cdot z$.\n\n$$\n(6y(x - 2))/(9yz) = (2 \\cdot 3 \\cdot y \\cdot (x - 2))/(3 \\cdot 3 \\cdot y \\cdot z)\n$$\n\nThen, we cancel out all the pairs of common factors in the numerator and denominator. In this case, there is one pair of $3$'s and one pair of $y$'s.\n\n$$\n\\begin{aligned}\n(2 \\cdot 3 \\cdot y \\cdot (x - 2))/(3 \\cdot 3 \\cdot y \\cdot z) &=  \\\\\n(2 \\cdot 3 \\cdot y \\cdot (x - 2))/(3 \\cdot 3 \\cdot y \\cdot z) &=  \\\\\n(2 \\cdot (x - 2))/(3z) &=  \\\\\n&= (2(x - 2))/(3z)\n\\end{aligned}\n$$\n\nThus, the expression simplifies to\n\n$$\n\\dfrac{2(x - 2)}{3z}\n$$" #edb/ref 17592186045417] [17592186054591 #edb/ref 1069 "e-839" #edb/ref 17592186045417] [17592186054591 #edb/ref 1071 "Simplify $\\dfrac{6a(c+1)}{3b(c+1)}$." #edb/ref 17592186045417] [17592186054591 #edb/ref 1072 #uuid "d076b225-6e63-592e-b03e-2986c1f7685c" #edb/ref 17592186045417] [17592186054591 #edb/ref 1074 "First, we decompose all of the terms into their prime factors. The $6a(c+1)$ in the numerator becomes $2\\cdot 3 \\cdot a \\cdot (c+1)$, and the $3b(c+1)$ in the denominator becomes $3\\cdot b \\cdot (c+1)$.\n\n$$\n(6a(c + 1))/(3b(c + 1)) = (2 \\cdot 3 \\cdot a \\cdot (c + 1))/(3 \\cdot b \\cdot (c + 1))\n$$\n\nThen, we cancel out all the pairs of common factors in the numerator and denominator. In this case, there is one pair of $3$'s and one pair of $(c+1)$'s.\n\n$$\n\\begin{aligned}\n(2 \\cdot 3 \\cdot a \\cdot (c + 1))/(3 \\cdot b \\cdot (c + 1)) &=  \\\\\n(2 \\cdot 3 \\cdot a \\cdot (c + 1))/(3 \\cdot b \\cdot (c + 1)) &=  \\\\\n\\frac{2 \\cdot a}{b} &=  \\\\\n&= \\frac{2a}{b}\n\\end{aligned}\n$$\n\nThus, the expression simplifies to\n\n$$\n\\dfrac{2a}{b}\n$$" #edb/ref 17592186045417] [17592186054690 #edb/ref 1038 #edb/ref 17592186055413 #edb/ref 17592186045417] [17592186054690 #edb/ref 1038 #edb/ref 17592186055414 #edb/ref 17592186045417] [17592186054690 #edb/ref 1039 "Simplifying Rational Expressions with Common Monomial Factors" #edb/ref 17592186045417] [17592186054690 #edb/ref 1041 #edb/ref 17592186054590 #edb/ref 17592186045417] [17592186054690 #edb/ref 1042 #uuid "750b8a6b-49f4-5ba2-a985-e0153ef8909c" #edb/ref 17592186045417] [17592186054691 #edb/ref 1037 #edb/ref 17592186050998 #edb/ref 17592186045417] [17592186054691 #edb/ref 1038 #edb/ref 17592186055271 #edb/ref 17592186045417] [17592186054691 #edb