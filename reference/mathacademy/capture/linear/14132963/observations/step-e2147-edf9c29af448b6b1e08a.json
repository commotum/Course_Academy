  "html": "<div id=\"step-e2147\" class=\"step\" style=\"display: block;\">\n    \n                 \n                <div class=\"example\">\n                    <div class=\"stepHeader\">\n                        <div class=\"stepName\"><span class=\"stepType\">Example:</span> Finding the Volume of a Figure by Counting</div>       \n                        <div class=\"helpButton\" stepid=\"e2147\">?</div>\n                    </div>\n            \n                    <div class=\"exampleQuestion\">\n                        <p>If each cube represents one cubic unit, what is the volume of the figure?</p>\n<div id=\"graphic-822d789ca6a85348f13ef74170672459\" class=\"graphic\"><img src=\"/graphics/822d789ca6a85348f13ef74170672459\"></div>\n\n                    </div>     \n            \n                    <div class=\"exampleExplanationHeader\">EXPLANATION</div>\n            \n                    <div class=\"exampleExplanation\">\n                        <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                            float: none;\n  