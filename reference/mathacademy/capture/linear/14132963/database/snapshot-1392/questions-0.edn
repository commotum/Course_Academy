#{[{:db/id #edb/ref 17592186142704 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142883 :knowledge-point/id #uuid "6057e526-a6a3-562d-b6e5-d72ac184b968" :knowledge-point/title "Finding the Volume of a Figure by Counting"}] :question/id #uuid "c041baf7-07b4-5c1a-969d-4324a3417f92" :question/math-academy-id "e-2147" :question/problem "If each cube represents one cubic unit, what is the volume of the figure?\n\n![](images/54/544b5a74ce1d8c5545d32df665df7d10ba4853cdf166ca02a3a03b46e2a97259.png)" :question/worked-solution "The figure consists of $10$ cubes.\n\n![](images/df/dfa571cbacb1f3e06ce70e05c127239cb159fdbc9adbd937df6120a5f214b120.png)\n\nTherefore, the volume is $10$ cubic units."}] [{:db/id #edb/ref 17592186142705 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142884 :knowledge-point/id #uuid "12445ca3-d861-5cf8-98c2-603026cfe199" :knowledge-point/title "Finding the Volume of a Figure by Multiplying"}] :question/id #uuid "40f45207-a212-5fb2-8c5c-5625e367301f" :question/math-academy-id "e-2148" :question/problem "If each cube represents $1$ cubic unit, what is the volume of the figure?\n\n![](images/2e/2e9da7bdc1b3e20a197be4c7e2ab3a64abcbdd78dc16274bc314e73bdc6bd1ce.png)" :question/worked-solution "The figure consists of $3$ rows, and each row has $5$ cubes.\n\n![](images/ba/baa53ae50449e9d56821925d9fbe5d2ebf694badd4e1e5e3c604fdcbf698a16f.png)\n\nSo, there are $5 \\times 3 = 15$ cubes in total.\n\nTherefore, the volume of the figure is $15$ cubic units."}] [{:db/id #edb/ref 17592186142706 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142885 :knowledge-point/id #uuid "2ee3dbcf-50d2-542c-9519-fbdcd4ac5b52" :knowledge-point/title "Finding the Volume of a Figure Containing Multiple Layers"}] :question/id #uuid "5316b5a3-dec6-5e2c-a14e-ee19c1040916" :question/math-academy-id "e-2149" :question/problem "An object is assembled as shown below. Given that each small cube represents one cubic unit, what is the volume of the object?\n\n![](images/53/5304eed09b6d029958fbfcce95001c79a8a9dbdd91e7c8ae6eefa7d54db61a75.png)" :question/worked-solution "The figure consists of two layers:\n\n- The bottom layer consists of $4$ cubes.\n\n- The top layer consists of $1$ cube.\n\n![](images/4c/4c6372a05b21e7aa9f26717fdbb2cfe47e17d2d17215e9b7411e876b0e6473f5.png)\n\nTherefore, the volume is $4+1=5$ cubic units."}] [{:db/id #edb/ref 17592186143383 :knowledge-point/_questions [{:db/id #edb/ref 17592186142884 :knowledge-point/id #uuid "12445ca3-d861-5cf8-98c2-603026cfe199" :knowledge-point/title "Finding the Volume of a Figure by Multiplying"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c40b6ac8-a4e2-5e37-b839-2adc00e04f03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$19$ cubic units" :db/id #edb/ref 17592186141268} {:answer/id #uuid "db2773e1-ca0d-5b43-864a-204c5364aa46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$22$ cubic units" :db/id #edb/ref 17592186141269} {:answer/id #uuid "46bf847b-f46c-561e-9c25-52f7097a9113" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$21$ cubic units" :db/id #edb/ref 17592186141270} {:answer/id #uuid "48e32eea-9c2c-5151-8e52-f5695df7ed2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$18$ cubic units" :db/id #edb/ref 17592186141271} {:answer/id #uuid "5b3f9bd1-3bc9-54b8-9efd-b9d01d0c1795" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$20$ cubic units" :db/id #edb/ref 17592186141272}] :answer-field/id #uuid "e6f8586d-d161-5d33-ab99-6b47788f2821" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186141267}] :question/id #uuid "c72e6f69-6f71-5140-9634-c5721e647941" :question/math-academy-id "q-58107" :question/problem "![](images/a9/a9b3ea2fd75ea8cbaa