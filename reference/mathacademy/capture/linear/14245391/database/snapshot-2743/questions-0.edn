#{[{:db/id #edb/ref 17592186115621 :knowledge-point/_questions [{:db/id #edb/ref 17592186115274 :knowledge-point/id #uuid "57ef1e2c-07d4-5d04-9de8-8884cae17c00" :knowledge-point/title "Finding a Corresponding Point on a Horizontally and Vertically Translated Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c67961e-0611-52a4-9174-ce29a6181b78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-3)" :db/id #edb/ref 17592186112693} {:answer/id #uuid "ea37d0cc-c381-5bc8-a7c3-6dbf9967edab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-3)" :db/id #edb/ref 17592186112694} {:answer/id #uuid "7fbecf5f-a6d3-548d-a61b-8e5067de0e17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-3)" :db/id #edb/ref 17592186112697} {:answer/id #uuid "9a26e55d-9303-56e0-8288-9b23893be1a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,1)" :db/id #edb/ref 17592186561964} {:answer/id #uuid "a8df0157-21f6-5dc0-8a63-11b23288264d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,1)" :db/id #edb/ref 17592186562003}] :answer-field/correct {:answer/id #uuid "7fbecf5f-a6d3-548d-a61b-8e5067de0e17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-3)" :db/id #edb/ref 17592186112697} :answer-field/id #uuid "0daf5d66-da57-5a29-95e5-de75bdcb9cb6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186112692}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9695e1dd-b160-5733-82a1-4e31d27a5a99" :question/math-academy-id "q-26744" :question/problem "The point $P$ with coordinates $(1,-1)$ lies on the curve $y=f(x).$ Which of the following points must lie on $y=f(x+2)-2?$" :question/worked-solution "The graph of $y=f(x+2)-2$  is a translation of the graph of $y=f(x)$ by $2$ units to the *left* and $2$ units down. So the $y$-coordinate decreases by $2$ and the $x$-coordinate decreases by $2.$\n\nWe know that the point $(1,-1)$ lies on $y=f(x).$ Therefore, the point $(1-2,-1-2)=(-1,-3)$ must lie on $y=f(x+2)-2.$\n\n![](images/89/89f839666dc5471bfe43064d01c9c4f5c60a9ac4bfc8abe8cf83ac6d6592bf42.png)"}] [{:db/id #edb/ref 17592186562439 :knowledge-point/_questions [{:db/id #edb/ref 17592186115274 :knowledge-point/id #uuid "57ef1e2c-07d4-5d04-9de8-8884cae17c00" :knowledge-point/title "Finding a Corresponding Point on a Horizontally and Vertically Translated Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01918d4d-fe77-5a05-8182-1ca73078a2eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,6)" :db/id #edb/ref 17592186561585} {:answer/id #uuid "068de661-d540-5f22-87b3-55fc48d91411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-1)" :db/id #edb/ref 17592186561601} {:answer/id #uuid "3ce77541-fe64-5c39-9a3f-a8e633031c81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,8)" :db/id #edb/ref 17592186561733} {:answer/id #uuid "3e6e7b2e-b39e-5b4b-8716-7cb1355b03aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,7)" :db/id #edb/ref 17592186561735} {:answer/id #uuid "b4a411ae-b69e-55fa-bddb-288f2de2db05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,-1)" :db/id #edb/ref 17592186562032}] :answer-field/correct {:answer/id #uuid "3e6e7b2e-b39e-5b4b-8716-7cb1355b03aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,7)" :db/id #edb/ref 17592186561735} :answer-field/id #uuid "498ea766-5b7c-5a0e-8fa8-8e209932d275" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562269}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "629c55e3-c442-5e2d-bc74-813be7f9da46" :question/math-academy-id "q-70449" :question/problem "The point $P$ with coordinates $(1,3)$ lies on the curve $y=f(x).$ Which of the following points must lie on $y=f(x-4)+4?$" :question/worked-solution "The graph of $y=f(x-4)+4$  is a translation of the graph of $y=f(x)$ by $4$ units to the *right* and $4$ units up. So the $y$-coordinate increases by $4$ and the $x$-coordinate increases by $4.$\n\nWe know that the point $P(1,3)$ lies on $y=f(x).$ Therefore, the point $(1+4,3+4)=(5,7)$ must lie on $y=f(x-4)+4.$\n\n![](images/d3/d3779750f7ecf13b1f24eb10f7c0e694d784a079710771e70eb793327a6e9411.png)"}] [{:db/id #edb/ref 17592186562496 :knowledge-point/_questions [{:db/id #edb/ref 17592186115261 :knowledge-point/id #uuid "d7c84dd5-2c76-5584-81a1-53d2459afb94" :knowledge-point/title "Plotting Horizontal and Vertical Translations of a Given Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d888797-a845-5d16-b6cc-44af8297c7a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=-3,\\,b=-2" :db/id #edb/ref 17592186561625} {:answer/id #uuid "4556a0a8-e5ac-54c9-93aa-1d55f2fcd0fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=3,\\,b=-2" :db/id #edb/ref 17592186561755} {:answer/id #uuid "8e3e26d7-2dfd-56b5-aed1-8a6b847e743c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=3,\\,b=2" :db/id #edb/ref 17592186561938} {:answer/id #uuid "a1d8c6dd-5055-5751-bf41-1186eeb77f49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=2,\\,b=-3" :db/id #edb/ref 17592186561985} {:answer/id #uuid "f41d13fd-3390-5bfa-8b53-7626ff405aa9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=-2,\\,b=3" :db/id #edb/ref 17592186562189}] :answer-field/correct {:answer/id #uuid "4556a0a8-e5ac-54c9-93aa-1d55f2fcd0fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=3,\\,b=-2" :db/id #edb/ref 17592186561755} :answer-field/id #uuid "d9c953d2-beee-51b7-9873-9316ffb11e9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562360}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cd39d09c-a0fc-599a-b531-076d3a407865" :question/math-academy-id "q-72291" :question/problem "![](images/30/3083c6f4c7998d69857eb7d3a74d905265edd437b5bf73003e55868083993d5a.png)\n\nThe diagram above shows the graphs of $y=f(x)$ and $y=g(x)$, where $g(x)=f(x+a)+b.$ What are the values of $a$ and $b?$" :question/worked-solution "Notice that every point on the graph $y=g(x)$ is three units *to the left * and two units *down* of the corresponding point on the graph of $y=f(x).$ \n\nSo, we conclude that $g(x)=f(x+3)-2,$ and therefore $a=3$ and $b=-2.$"}]}
