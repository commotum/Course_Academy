#{[{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186116243} :activity/id #uuid "ab69be82-a737-5ca5-bd57-46d2a37c64bb" :activity/scope {:db/id #edb/ref 17592186050680 :topic/id #uuid "5e676adf-aa45-5e67-b4e5-57ec40661f6e" :topic/math-academy-id 1576} :activity/steps [{:db/id #edb/ref 17592186116243 :step/content {:db/id #edb/ref 17592186116417 :tutorial/content "Suppose we want to find all of the values of $x$ that satisfy *either* $4x+2 < 6$ *or* $2x \\geq 8.$\n\nTo do this, we solve each inequality individually and then compute the union of the two solutions.\n\nWe start by solving $4x+2 < 6\\mathbin{:}$\n\n$$\n\\begin{aligned}4x+2 & <6 \\\\ 4x & <4 \\\\ x & <1\\end{aligned}\n$$\n\n![](images/0d/0d36b8e68d9fd0b33b255502860481eeb525b60382029b17434bfb072cc39da2.png)\n\nThen, we solve $2x \\geq 8\\mathbin{:}$\n\n$$\n\\begin{aligned}2x & \\ge 8 \\\\ x & \\ge 4\\end{aligned}\n$$\n\n![](images/ed/edf5665b7cab7f51e3f252601a96d43c6f0cbfc64e5c9b8da81f0ef09d7b2f5a.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/5c/5c60839a626f2ba8a0fe4a24f4011af0fa52c00d79fbf80039bcfdbdf0a612c7.png)\n\nThus, the final solution is $x < 1$ or $x \\geq 4.$ We can write this using interval notation as\n\n$$\n(-\\infty, 1) \\cup [4,\\infty).\n$$" :tutorial/id #uuid "6d186c13-c1df-52d0-8ed6-a383185138a9" :tutorial/math-academy-id 1428 :tutorial/title "Introduction"} :step/id #uuid "cdc53761-47a4-5dc1-a8a0-b21a01b5b35a" :step/math-academy-id 3201 :step/next {:db/id #edb/ref 17592186116245}} {:db/id #edb/ref 17592186116244 :step/content {:db/id #edb/ref 17592186115321 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115153 :question/id #uuid "abae2e99-53b7-5d81-860c-9555ce50ec3a" :question/math-academy-id "e-965"} :knowledge-point/id #uuid "cdaed02f-09f2-5572-a70c-0e6979ef2167" :knowledge-point/questions [{:db/id #edb/ref 17592186115903} {:db/id #edb/ref 17592186115905} {:db/id #edb/ref 17592186510386} {:db/id #edb/ref 17592186557245} {:db/id #edb/ref 17592186557318}] :knowledge-point/title "Solving For the Union of Two Opposite-Sided Linear Inequalities that Overlap"} :step/id #uuid "eef16282-4281-509e-8f6c-106a707fcb20" :step/math-academy-id 3202 :step/next {:db/id #edb/ref 17592186116246}} {:db/id #edb/ref 17592186116245 :step/content {:db/id #edb/ref 17592186115322 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115154 :question/id #uuid "81405a9f-882c-50fb-8057-41bb54515d14" :question/math-academy-id "e-966"} :knowledge-point/id #uuid "91a5169c-6a92-535d-85e1-8b9363b49274" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049986} {:db/id #edb/ref 17592186050229}] :knowledge-point/questions [{:db/id #edb/ref 17592186115575} {:db/id #edb/ref 17592186115577} {:db/id #edb/ref 17592186510421} {:db/id #edb/ref 17592186510428}] :knowledge-point/title "Finding the Union of Two Linear Inequalities"} :step/id #uuid "a370cd83-ae02-58f0-b487-2c4e2f90db1d" :step/math-academy-id 3205 :step/next {:db/id #edb/ref 17592186116244}} {:db/id #edb/ref 17592186116246 :step/content {:db/id #edb/ref 17592186115323 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115155 :question/id #uuid "dced871e-e24d-5d06-a4bb-9faa933ecac7" :question/math-academy-id "e-967"} :knowledge-point/id #uuid "3e3a4ead-02d0-5023-a7a7-3aaaca19b563" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050734}] :knowledge-point/questions [{:db/id #edb/ref 17592186115576} {:db/id #edb/ref 17592186115906} {:db/id #edb/ref 17592186510414} {:db/id #edb/ref 17592186510418} {:db/id #edb/ref 17592186557264} {:db/id #edb/ref 17592186557310} {:db/id #edb/ref 17592186557323}] :knowledge-point/title "Finding the Union of Two Linear Inequalities When One Inequality is Compound"} :step/id #uuid "634432ad-9cd7-5544-b7bb-1b5664235ef4" :step/math-academy-id 3208}] :activity/title "Compound OR Inequalities" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115415}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186557402} :activity/id #uuid "c133fc81-f847-545b-9d93-4e162a569216" :activity/scope {:db/id #edb/ref 17592186050680 :topic/id #uuid "5e676adf-aa45-5e67-b4e5-57ec40661f6e" :topic/math-academy-id 1576} :activity/steps [{:db/id #edb/ref 17592186557343 :step/content {:db/id #edb/ref 17592186557310 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ba0595d-f06f-5885-b3b6-4271c00186cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,\\frac{11}{2})" :db/id #edb/ref 17592186556560} {:answer/id #uuid "9301892d-c921-55d8-b611-e0207b9724b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\frac{3}{2},\\frac{11}{2})" :db/id #edb/ref 17592186556785} {:answer/id #uuid "b5a81b1b-75e9-58dd-a9f3-58f8e6b21ed6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-\\frac{3}{2},\\infty )" :db/id #edb/ref 17592186556875} {:answer/id #uuid "f5463f09-2120-5a87-9ad6-afd48773e784" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,\\frac{3}{2})" :db/id #edb/ref 17592186557036} {:answer/id #uuid "fd6b49c9-3144-5f1b-860e-b009a0d8db9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[-\\frac{3}{2},\\infty )\\cup (-\\infty ,\\frac{11}{2})." :db/id #edb/ref 17592186557056}] :answer-field/correct {:db/id #edb/ref 17592186556875} :answer-field/id #uuid "de85a63e-a3d0-55fd-b8a5-f8452278c0c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557189}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cbe793da-7d16-5ef3-b7b6-788b5db16db0" :question/math-academy-id "q-25767" :question/problem "Find the set of values of $x$ that satisfy $5x-1>7$ or $2\\le 2x+5<16.$" :question/worked-solution "We start by solving $5x-1>7:$\n\n$$\n\\begin{aligned}5x-1 & >7 \\\\ 5x & >8 \\\\ x & >\\frac{8}{5}\\end{aligned}\n$$\n\n![](images/0e/0efcf15a3abee964ad2dfc0c1dac12a0f2f43c86180d2ead869fc2ee7b8e9c76.png)\n\nThen, we solve $2\\le 2x+5<16:$\n\n$$\n\\begin{aligned}2 & \\le 2x+5<16 \\\\ 2-5 & \\le 2x<16-5 \\\\ -3 & \\le 2x<11 \\\\ -\\frac{3}{2} & \\le x<\\frac{11}{2}\\end{aligned}\n$$\n\n![](images/22/22f51dad4248c565cd3afcf03ec9f5a8c50494ad79ed1366b3513083be27182a.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/e7/e769eea6e55f7138cbce08cb285253fc1c710c2e39384994a8b36bd43a41ea32.png)\n\nTherefore, the final solution is $x\\ge -\\frac{3}{2}.$  We can write this using interval notation as $[-\\frac{3}{2},\\infty ).$"} :step/id #uuid "18a200e9-cd70-5bff-86ec-4b2d64cebd6c" :step/next {:db/id #edb/ref 17592186557382}} {:db/id #edb/ref 17592186557350 :step/content {:db/id #edb/ref 17592186557323 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "391d070c-32c3-51d1-87a6-51e1deeeceda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,1)" :db/id #edb/ref 17592186556551} {:answer/id #uuid "70d62841-5a2b-56ce-b898-842b8ad2b793" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,-1)" :db/id #edb/ref 17592186556687} {:answer/id #uuid "77434d1a-9653-5239-9ffa-ed467133e340" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,-1)\\cup (-1,3)" :db/id #edb/ref 17592186556702} {:answer/id #uuid "83613639-e746-5cb9-a5b0-1fc25dcbfd60" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,3)" :db/id #edb/ref 17592186556735} {:answer/id #uuid "a900943b-143b-5bc3-a277-6290db942625" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,3)" :db/id #edb/ref 17592186556849}] :answer-field/correct {:db/id #edb/ref 17592186556702} :answer-field/id #uuid "a3e5e47e-db25-536a-83fd-f652100a1d2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557158}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f2b14810-a4bb-5d69-856a-68799a4e514a" :question/math-academy-id "q-104015" :question/problem "Find the set of values of $x$ that satisfy $-8<4x-4<8$ or $2-x>3.$" :question/worked-solution "We start by solving $-8<4x-4<8:$\n\n$$\n\\begin{aligned}-8 & <4x-4<8 \\\\ -4 & <4x<12 \\\\ -1 & <x<3\\end{aligned}\n$$\n\n![](images/fd/fdf77a12d535974088d36ca7508443a2aab00bb147fde65a17fc06cf5f0bce23.png)\n\nThen, we solve $2-x>3:$\n\n$$\n\\begin{aligned}2-x & >3 \\\\ -x & >1 \\\\ \\frac{-x}{-1} & <\\frac{1}{-1} \\\\ x & <-1\\end{aligned}\n$$\n\n![](images/8a/8a1af65f2cebbcaeb73c138be5d1cd67d714aacb8db1c995f29b930c06b953fe.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/be/be8cace3271cdfa133d1b647359400681db04f504560ad306e3e1807eb1502d9.png)\n\nTherefore, the final solution is $-1<x<3$ or $x<-1.$ We can write this using interval notation as $(-\\infty ,-1)\\cup (-1,3).$"} :step/id #uuid "33dd4d66-72f1-548e-a8ea-98c8e4f5383e"} {:db/id #edb/ref 17592186557380 :step/content {:db/id #edb/ref 17592186557264 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10c04a51-ef7c-5856-a076-fb47f0912018" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/25/25f4136a1e248ab30fc0c01feef1e27c331553c1adcf4a1c27c133764cca1ae1.png" :db/id #edb/ref 17592186556463} {:answer/id #uuid "44590ee1-bff9-5692-9fac-4d311f90612f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/1b/1b0700462c3957759abbe608c300fece27f92dfdb9b8c14dbeb44cc053de7784.png" :db/id #edb/ref 17592186556580} {:answer/id #uuid "919b4593-9094-5d6a-9ebe-1e8c3a9a60e5" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/25/253ccc2c3cb59b2e195cd9989b864356181ecffd3c09ab879db6d87208afb55a.png" :db/id #edb/ref 17592186556779} {:answer/id #uuid "d97b4d3f-a651-5195-9620-b1c69ade990e" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/85/8599cc4956010fe616c90f60153e9b656440a6d3751739ddd706434e1e272101.png" :db/id #edb/ref 17592186556969} {:answer/id #uuid "d9cf5b9b-04b8-58a6-9091-f70e73e01318" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ab/ab1b1f6494c00b463e7912ab3f9710aee553e3a99484822e678494b55268e398.png" :db/id #edb/ref 17592186556970}] :answer-field/correct {:db/id #edb/ref 17592186556463} :answer-field/id #uuid "cd3749e3-5087-5fa4-954a-a11f49413b13" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557180}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6d993076-511f-5d5a-b4e5-bf19ec4e8490" :question/math-academy-id "q-76082" :question/problem "What is the set of values of $x$ that satisfy $6\\le 3x+9\\le 15$ or $4x-3\\ge 5?$" :question/worked-solution "We start by solving $6\\le 3x+9\\le 15:$\n\n$$\n\\begin{aligned}6 & \\le 3x+9\\le 15 \\\\ -3 & \\le 3x\\le 6 \\\\ -1 & \\le x\\le 2\\end{aligned}\n$$\n\n![](images/ab/ab1b1f6494c00b463e7912ab3f9710aee553e3a99484822e678494b55268e398.png)\n\nThen, we solve $4x-3\\ge 5:$\n\n$$\n\\begin{aligned}4x-3 & \\ge 5 \\\\ 4x & \\ge 8 \\\\ x & \\ge 2\\end{aligned}\n$$\n\n![](images/1b/1b0700462c3957759abbe608c300fece27f92dfdb9b8c14dbeb44cc053de7784.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/25/25f4136a1e248ab30fc0c01feef1e27c331553c1adcf4a1c27c133764cca1ae1.png)\n\nTherefore, the final solution is $x\\ge -1.$"} :step/id #uuid "96826635-bbbd-5238-b2a0-5744527987c9" :step/next {:db/id #edb/ref 17592186557350}} {:db/id #edb/ref 17592186557382 :step/content {:db/id #edb/ref 17592186557318 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51a286f2-9f76-5594-9f40-1d8d30b4d6ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in [2,\\infty )" :db/id #edb/ref 17592186556616} {:answer/id #uuid "65032a8d-a4f3-517c-a748-1a00ee1aed26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-\\infty ,-2)\\cup [2,\\infty )" :db/id #edb/ref 17592186556663} {:answer/id #uuid "9ba2ca60-ef41-5208-8e4e-1de935cdae6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-2,2]" :db/id #edb/ref 17592186556810} {:answer/id #uuid "c6b0992f-1500-5142-a5f8-a0f17e4f6976" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186556907} {:answer/id #uuid "d7976712-61bc-5824-bdde-76934e8b24a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-\\infty ,-2)" :db/id #edb/ref 17592186556963}] :answer-field/correct {:db/id #edb/ref 17592186556907} :answer-field/id #uuid "2435bb7a-799d-59f0-ad2e-0c6284676d40" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557087}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e377c474-d1b6-5e34-ae2e-6bda298c1707" :question/math-academy-id "q-28966" :question/problem "Find all the values of $x$ that satisfy $3x+5>11$ or $2x-3\\le 1.$" :question/worked-solution "We start by solving $3x+5>11:$ \n\n$$\n\\begin{aligned}3x+5 & >11 \\\\ 3x & >6 \\\\ x & >2\\end{aligned}\n$$\n\n![](images/87/87831ea65f4caa557c8e8826faaa43a60737c3590393872902818921668787d0.png)\n\nThen, we solve $2x-3\\le 1:$\n\n$$\n\\begin{aligned}2x-3 & \\le 1 \\\\ 2x & \\le 4 \\\\ x & \\le 2\\end{aligned}\n$$\n\n![](images/49/4965930532798f18907e5319f2fd9fe5f17d9c1969c12d9795f9867a2cb13351.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/a9/a9543d5a2add249d869a667d16bea75780b0e44e4c0d2bde2cf460733d5e9634.png)\n\nTherefore, the final solution is $x\\le 2$ or $x>2.$ We can write this using interval notation as\n\n$$\nx\\in (-\\infty ,\\infty ).\n$$"} :step/id #uuid "9920cd70-713b-5652-a589-462984092c55" :step/next {:db/id #edb/ref 17592186557380}} {:db/id #edb/ref 17592186557402 :step/content {:db/id #edb/ref 17592186557245 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4208aa5a-ebcf-544c-bdab-57c640b053b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,10)" :db/id #edb/ref 17592186556576} {:answer/id #uuid "4fac84c7-58d6-5175-a114-10e9acc01ee6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,-3)\\cup (10,\\infty )" :db/id #edb/ref 17592186556607} {:answer/id #uuid "a9701182-7d89-5629-8529-d4fad7cef8ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,-10)\\cup (3,\\infty )" :db/id #edb/ref 17592186556850} {:answer/id #uuid "e67b06b1-5b7a-5ce7-a2e3-c9ca5a45bf11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-10,3)" :db/id #edb/ref 17592186556998} {:answer/id #uuid "f052b297-ca34-569f-a527-057e0db288ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,\\infty )" :db/id #edb/ref 17592186557022}] :answer-field/correct {:db/id #edb/ref 17592186557022} :answer-field/id #uuid "bfa95610-12f2-5abb-9640-0c55094b614f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557173}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "49cc684c-6a61-5a0a-9979-944836444765" :question/math-academy-id "q-25402" :question/problem "Find all the values of $x$ that satisfy $2x-5>1$ or $2x-7<13.$" :question/worked-solution "We start by solving $2x-5>1:$ \n\n$$\n\\begin{aligned}2x-5 & >1 \\\\ 2x & >6 \\\\ x & >3\\end{aligned}\n$$\n\n![](images/20/2048d360b427cfd94e92a16f7b9f8cd9ca9c88e808bf3b6205d60eebd71aa1cf.png)\n\nThen, we solve $2x-7<13:$\n\n$$\n\\begin{aligned}2x-7 & <13 \\\\ 2x & <20 \\\\ x & <10\\end{aligned}\n$$\n\n![](images/c1/c1a63d1c991f309dbc10a89f0416c910c2c31bde5fdf069682a6127a1f66987a.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/e0/e03d04e5d2d5d571f5b80353081253087f99b2bf58fd86ae56eff3af26415b92.png)\n\nTherefore, the final solution is $x<10$ or $x>3.$ We can write this using interval notation as $x\\in (-\\infty ,\\infty ).$"} :step/id #uuid "e397555c-38d7-597d-9eef-be097531f336" :step/next {:db/id #edb/ref 17592186557343}}] :activity/title "Compound OR Inequalities" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186556419}]}
