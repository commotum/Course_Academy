#{[{:db/id #edb/ref 17592186133511 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133738 :knowledge-point/id #uuid "39ed44f2-c5ca-5920-9bb0-4ea26ff3207a" :knowledge-point/title "Calculating the Cube of a Number"}] :question/id #uuid "3e2f3025-cfc0-5688-a5be-dbe7f98848e3" :question/math-academy-id "e-13248" :question/problem "What is the value of $70^3?$" :question/worked-solution "To work out $70^3,$ we multiply $70$ by itself and then multiply the result by $70$ once more:\n\n$$\n\\begin{aligned}{70}^{3} & =70\\cdot 70\\cdot 70 \\\\  & =4\\,900\\cdot 70 &  \\\\  & =343\\,000\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186133512 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133739 :knowledge-point/id #uuid "4cb81a65-ae88-591a-bb87-0ecb7124b154" :knowledge-point/title "Calculating the Cube of a Negative Number"}] :question/id #uuid "02fa99aa-811e-5d0a-b278-24ec7697a038" :question/math-academy-id "e-13249" :question/problem "Calculate the value of $\\left(-13\\right)^3.$" :question/worked-solution "To work out $\\left(-13\\right)^3,$ we multiply $-13$ by itself and then multiply the result by $-13$ again:\n\n$$\n\\begin{aligned}(-13)^{3} & =\\overset{169}{\\overset{⏞}{(-13)\\cdot (-13)}}\\cdot (-13) \\\\  & =169\\cdot (-13) \\\\  & =-2\\,197\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186133513 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133740 :knowledge-point/id #uuid "70e7585e-7380-5dbc-9272-b358f085429c" :knowledge-point/title "Calculating the Cube of a Fraction"}] :question/id #uuid "5468caae-f88a-59d2-98ab-7941bf7cd81a" :question/math-academy-id "e-13251" :question/problem "Find the value of $\\dfrac{3}{5}$ cubed." :question/worked-solution "To work out $\\left(\\dfrac{3}{5}\\right)^3,$ we multiply $\\dfrac{3}{5}$ by itself and then multiply the result by $\\dfrac{3}{5}$ again:\n\n$$\n\\begin{aligned}{(\\frac{3}{5})}^{3} & =\\frac{3}{5}\\cdot \\frac{3}{5}\\cdot \\frac{3}{5} \\\\  & =\\frac{3\\cdot 3\\cdot 3}{5\\cdot 5\\cdot 5} \\\\  & =\\frac{27}{125}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186133514 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133741 :knowledge-point/id #uuid "09de45b3-1a35-55e3-9886-2e0533f237d6" :knowledge-point/title "Calculating the Cube of a Decimal"}] :question/id #uuid "ba7b4d05-42b6-58a5-9607-b30742991005" :question/math-academy-id "e-13253" :question/problem "What is the cube of $(-0.5)?$" :question/worked-solution "To work out $\\left(-0.5\\right)^3,$ we multiply $-0.5$ by itself and then multiply the result by $-0.5$ once more:\n\n$$\n\\begin{aligned}(-0.5)^{3} & =\\overset{0.25}{\\overset{⏞}{(-0.5)\\cdot (-0.5)}}\\cdot (-0.5) \\\\  & =0.25\\cdot (-0.5) \\\\  & =-0.125\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186475968 :knowledge-point/_questions [{:db/id #edb/ref 17592186133741 :knowledge-point/id #uuid "09de45b3-1a35-55e3-9886-2e0533f237d6" :knowledge-point/title "Calculating the Cube of a Decimal"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f37a213b-2af3-5792-8bc6-42ec646e25a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.000001" :db/id #edb/ref 17592186475816}] :answer-field/correct {:answer/id #uuid "f37a213b-2af3-5792-8bc6-42ec646e25a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.000001" :db/id #edb/ref 17592186475816} :answer-field/id #uuid "ae9ef075-5be3-54ff-82e4-5df7ff9f7f28" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186475880}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cd92d947-d1af-50e2-a5d9-2edba3de1406" :question/math-academy-id "q-186209" :question/problem "Expressed as a decimal in its simplest form, $(0.01)^{3}=${{field-1}}." :question/worked-solution "To work out $(0.01)^{3},$ we multiply $0.01$ by itself and then multiply the result by $0.01$ once more:\n\n$$\n\\begin{aligned}{0.01}^{3} & =\\overset{0.000\\,1}{\\overset{⏞}{0.01\\cdot 0.01}}\\cdot 0.01 \\\\  & =0.000\\,1\\cdot 0.01 \\\\  & =0.000\\,001\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186475958 :knowledge-point/_questions [{:db/id #edb/ref 17592186133741 :knowledge-point/id #uuid "09de45b3-1a35-55e3-9886-2e0533f237d6" :knowledge-point/title "Calculating the Cube of a Decimal"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ee66ee4-6517-5668-9169-22b519673baf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4.096" :db/id #edb/ref 17592186475560}] :answer-field/correct {:answer/id #uuid "4ee66ee4-6517-5668-9169-22b519673baf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4.096" :db/id #edb/ref 17592186475560} :answer-field/id #uuid "ba768c88-4eb0-5381-9499-0a94fd8cffce" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186475883}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b50cc60c-3830-586d-ac40-7d3e6216a024" :question/math-academy-id "q-186215" :question/problem "Expressed as a decimal in its simplest form, $(-1.6)^{3}=${{field-1}}." :question/worked-solution "To work out $(-1.6)^{3},$ we multiply $-1.6$ by itself and then multiply the result by $-1.6$ once more:\n\n$$\n\\begin{aligned}(-1.6)^{3} & =\\overset{2.56}{\\overset{⏞}{(-1.6)\\cdot (-1.6)}}\\cdot (-1.6) \\\\  & =2.56\\cdot (-1.6) \\\\  & =-4.096\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186475917 :knowledge-point/_questions [{:db/id #edb/ref 17592186133739 :knowledge-point/id #uuid "4cb81a65-ae88-591a-bb87-0ecb7124b154" :knowledge-point/title "Calculating the Cube of a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32ef51bc-955a-5135-8645-81cf0166440e" :answer/type {:db/id 