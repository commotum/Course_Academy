#{[{:db/id #edb/ref 17592186133511 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133738 :knowledge-point/id #uuid "39ed44f2-c5ca-5920-9bb0-4ea26ff3207a" :knowledge-point/title "Calculating the Cube of a Number"}] :question/id #uuid "3e2f3025-cfc0-5688-a5be-dbe7f98848e3" :question/math-academy-id "e-13248" :question/problem "What is the value of $70^3$?" :question/worked-solution "To work out $70^3$, we multiply $70$ by itself and then multiply the result by $70$ once more:\n\n$$\n\\begin{aligned}\n70^{3} &= 70 \\cdot 70 \\cdot 70 \\\\\n&= 4900 \\cdot 70 \\\\\n&= 343000\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186133512 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133739 :knowledge-point/id #uuid "4cb81a65-ae88-591a-bb87-0ecb7124b154" :knowledge-point/title "Calculating the Cube of a Negative Number"}] :question/id #uuid "02fa99aa-811e-5d0a-b278-24ec7697a038" :question/math-academy-id "e-13249" :question/problem "Calculate the value of $\\left(-13\\right)^3$." :question/worked-solution "To work out\n\n$$\n\\left(-13\\right)^3\n$$\n\nwe multiply $-13$ by itself and then multiply the result by $-13$ again:\n\n$$\n\\begin{aligned}\n(-13)^{3} &= (-13) \\cdot (-13)^(⏞)^(169) \\cdot (-13) \\\\\n&= 169 \\cdot (-13) \\\\\n&=-2197\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186133513 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133740 :knowledge-point/id #uuid "70e7585e-7380-5dbc-9272-b358f085429c" :knowledge-point/title "Calculating the Cube of a Fraction"}] :question/id #uuid "5468caae-f88a-59d2-98ab-7941bf7cd81a" :question/math-academy-id "e-13251" :question/problem "Find the value of $\\dfrac{3}{5}$ cubed." :question/worked-solution "To work out\n\n$$\n\\left(\\dfrac{3}{5}\\right)^3\n$$\n\nwe multiply\n\n$$\n\\dfrac{3}{5}\n$$\n\nby itself and then multiply the result by\n\n$$\n\\dfrac{3}{5}\n$$\n\nagain:\n\n$$\n\\begin{aligned}\n(\\frac{3}{5})^{3} &= \\frac{3}{5} \\cdot \\frac{3}{5} \\cdot \\frac{3}{5} \\\\\n&= \\frac{3 \\cdot 3 \\cdot 3}{5 \\cdot 5 \\cdot 5} \\\\\n&= \\frac{27}{125}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186133514 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133741 :knowledge-point/id #uuid "09de45b3-1a35-55e3-9886-2e0533f237d6" :knowledge-point/title "Calculating the Cube of a Decimal"}] :question/id #uuid "ba7b4d05-42b6-58a5-9607-b30742991005" :question/math-academy-id "e-13253" :question/problem "What is the cube of $(-0.5)$?" :question/worked-solution "To work out\n\n$$\n\\left(-0.5\\right)^3\n$$\n\nwe multiply $-0.5$ by itself and then multiply the result by $-0.5$ once more:\n\n$$\n\\begin{aligned}\n(-0.5)^{3} &= (-0.5) \\cdot (-0.5)^(⏞)^(0.25) \\cdot (-0.5) \\\\\n&= 0.25 \\cdot (-0.5) \\\\\n&=-0.125\n\\end{aligned}\n$$"}]}
