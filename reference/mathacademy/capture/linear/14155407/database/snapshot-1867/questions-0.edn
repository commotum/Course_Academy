#{[{:db/id #edb/ref 17592186142606 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142982 :knowledge-point/id #uuid "bbee94b0-ad82-5461-81f0-84237abf0c85" :knowledge-point/title "Dividing Unit Fractions"}] :question/id #uuid "7e77df17-125b-5a13-9429-dc1fdc15cb26" :question/math-academy-id "e-13780" :question/problem "Find the value of $\\dfrac{1}{4} \\div \\dfrac{1}{8}.$" :question/worked-solution "Dividing a fraction by another fraction is equivalent to multiplying the first fraction by the reciprocal of the second fraction.\n\nThe reciprocal of $\\dfrac{\\color{blue}1}{\\color{red}8}$ is $\\dfrac{\\color{red}8}{\\color{blue}1}.$ So, we have:\n\n$$\n\\dfrac 1 4 \\div \\dfrac{\\color{blue}1}{\\color{red}8} = \\dfrac 1 4 \\times  \\dfrac{\\color{red}8}{\\color{blue}1}\n$$\n\n \n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac 1 {4} \\times \\dfrac{8}{1} =  \\dfrac {1\\times 8} {4\\times 1} = \\dfrac{8}{4}\n$$\n\nFinally, we simplify:\n\n$$\n8\\div 4=2\n$$\n\nTherefore,\n\n$$\n\\dfrac{1}{4} \\div \\dfrac{1}{8} = 2 \\, .\n$$"}] [{:db/id #edb/ref 17592186142607 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142983 :knowledge-point/id #uuid "008c73e1-62d2-51aa-a937-40a810d7d594" :knowledge-point/title "Dividing Fractions When Simplification Is Needed: Finding a Missing Number"}] :question/id #uuid "ff77c815-b89c-5157-9c1c-cf52bddda0fb" :question/math-academy-id "e-13781" :question/problem "What is the missing digit in the following equality?\n![](images/55/5524e309d086fbd7c3c1ec7e6ca5a54fdb148de2beaba638dbeb88f641aca0c3.svg)" :question/worked-solution "Dividing a fraction by another fraction is equivalent to multiplying the first fraction by the reciprocal of the second fraction.\n\nThe reciprocal of $\\dfrac{\\color{blue}4}{\\color{red}3}$ is $\\dfrac{\\color{red}3}{\\color{blue}4}.$ So, we have:\n\n$$\n\\dfrac 6 {7} \\div \\dfrac{\\color{blue}4}{\\color{red}3} = \\dfrac 6 {7} \\times  \\dfrac{\\color{red}3}{\\color{blue}4}\n$$\n\n \n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac 6 {7} \\times \\dfrac{3}{4} =  \\dfrac {6\\times 3} {7\\times 4} = \\dfrac{18}{28}\n$$\n\nFinally, we simplify:\n\n$$\n\\dfrac{18}{28} = \\dfrac{18\\div 2}{28\\div 2} = \\dfrac{\\color{blue}9}{14}\n$$\n\nTherefore,\n\n$$\n\\dfrac 6 {7}\\div \\dfrac 4 {3} = \\dfrac{\\color{blue}9}{14} \\, .\n$$\n\nWe conclude that the missing number is ${\\color{blue}{9}}.$"}] [{:db/id #edb/ref 17592186142608 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142984 :knowledge-point/id #uuid "0c20028f-c518-5353-9d1d-f69a7a62a0a8" :knowledge-point/title "Dividing Fractions When Simplification Is Needed"}] :question/id #uuid "4597d0ec-e04c-581a-ad9f-e78280182444" :question/math-academy-id "e-13784" :question/problem "Calculate the value of $\\dfrac{1}{12} \\div \\dfrac{2}{3}.$" :question/worked-solution "Dividing a fraction by another fraction is equivalent to multiplying the first fraction by the reciprocal of the second fraction.\n\nThe reciprocal of $\\dfrac{\\color{blue}2}{\\color{red}3}$ is $\\dfrac{\\color{red}3}{\\color{blue}2}.$ So, we have\n\n$$\n\\dfrac 1 {12} \\div \\dfrac{\\color{blue}2}{\\color{red}3} = \\dfrac 1 {12} \\times  \\dfrac{\\color{red}3}{\\color{blue}2}.\n$$\n\n \n\nNow, we multiply the fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac 1 {12} \\times \\dfrac{3}{2} =  \\dfrac {1\\times 3} {12\\times 2} = \\dfrac{3}{24}\n$$\n\nFinally, we simplify:\n\n$$\n\\dfrac{3}{24} = \\dfrac{3\\div 3}{24\\div 3} = \\dfrac{1}{8}\n$$\n\nTherefore,\n\n$$\n\\dfrac{1}{12} \\div \\dfrac{2}{3} = \\dfrac{1}{8} \\, .\n$$"}] [{:db/id #edb/ref 17592186142609 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142985 :knowledge-point/id #uuid "e3260562-39ce-5ec6-a367-679f736dd673" :knowledge-point/title "Dividing Fractions When the Result Is a Mixed Number"}] :question/id #uuid "d361a96a-7abd-50a3-801d-9eb26f0c119c" :question/math-academy-id "e-13786" :question/problem "Calculate the value of $\\dfrac{1}{3} \\div \\dfrac 2 {13}.$" :question/worked-solution "Dividing a fraction by another fraction is equivalent to multiplying the first fraction by the reciprocal of the second fraction.\n\nThe reciprocal of $\\dfrac{\\color{blue}2}{\\color{red}13}$ is $\\dfrac{\\color{red}13}{\\color{blue}2}.$ So, we have\n\n$$\n\\dfrac 1 {3} \\div \\dfrac{\\color{blue}2}{\\color{red}13} = \\dfrac 1 {3} \\times  \\dfrac{\\color{red}13}{\\color{blue}2}.\n$$\n\n \n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac 1 {3} \\times \\dfrac{13}{2} =  \\dfrac {1\\times 13} {3 \\times 2} = \\dfrac{13}{6}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\dfrac{13}{6} =2\\,\\textrm{R} 1 = 2\\,\\dfrac 1 {6}\n$$\n\nTherefore,\n\n$$\n\\dfrac{1}{3} \\div \\dfrac 2 {13} = 2\\,\\dfrac 1 {6} \\, .\n$$"}] [{:db/id #edb/ref 17592186478460 :knowledge-point/_questions [{:db/id #edb/ref 17592186142982 :knowledge-point/id #uuid "bbee94b0-ad82-5461-81f0-84237abf0c85" :knowledge-point/title "Dividing Unit Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00396e68-48e3-56b5-8d6a-cc1b4c4f0323" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186477733}] :answer-field/correct {:answer/id #uuid "00396e68-48e3-56b5-8d6a-cc1b4c4f0323" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186477733} :answer-field/id #uuid "9a407d7e-5cda-53b7-9564-d09d63d97026" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186478324}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f566cc7e-16bb-505a-9e70-89d88e0f6bda" :question/math-academy-id "q-196268" :question/problem "Expressed as a fraction in its simplest form or as an integer, $\\frac{1}{8}÷\\frac{1}{40}=${{field-1}}." :question/worked-solution "Dividing a fraction by another fraction is equivalent to multiplying the first fraction by the reciprocal of the second fraction.\n\nThe reciprocal of $\\frac{1}{40}$ is $\\frac{40}{1}.$ So we have\n\n$$\n\\frac{1}{8}÷\\frac{1}{40}=\\frac{1}{8}\\times \\frac{40}{1}\n$$\n\n \n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{1}{8}\\times \\frac{40}{1}=\\frac{1\\times 40}{8\\times 1}=\\frac{40}{8}\n$$\n\nFinally, we simplify:\n\n$$\n40÷8=5\n$$"}] [{:db/id #edb/ref 17592186478372 :knowledge-point/_questions [{:db/id #edb/ref 17592186142984 :knowledge-point/id #uuid "0c20028f-c518-5353-9d1d-f69a7a62a0a8" :knowledge-point/title "Dividing Fractions When Simplification Is Needed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7dff4eb1-658b-55f7-a324-466effd1a0fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186477994}] :answer-field/correct {:answer/id #uuid "7dff4eb1-658b-55f7-a324-466effd1a0fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186477994} :answer-field/id #uuid "1e2f8769-753b-5057-95e9-84f43322020d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186478261}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0d4e147c-1e80-5935-ab97-075efc2ca0dc" :question/math-academy-id "q-196288" :question/problem "Expressed as an **improper fraction** in its simplest form, $\\frac{2}{3}÷\\frac{4}{9}=${{field-1}}." :question/worked-solution "Dividing a fraction by another fraction is equivalent to multiplying the first fraction by the reciprocal of the second fraction.\n\nThe reciprocal of $\\frac{4}{9}$ is $\\frac{9}{4}.$ So we have\n\n$$\n\\frac{2}{3}÷\\frac{4}{9}=\\frac{2}{3}\\times \\frac{9}{4}\n$$\n\n \n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{2}{3}\\times \\frac{9}{4}=\\frac{2\\times 9}{3\\times 4}=\\frac{18}{12}\n$$\n\nFinally, we simplify:\n\n$$\n\\frac{18}{12}=\\frac{18÷6}{12÷6}=\\frac{3}{2}\n$$"}] [{:db/id #edb/ref 17592186478462 :knowledge-point/_questions [{:db/id #edb/ref 17592186142985 :knowledge-point/id #uuid "e3260562-39ce-5ec6-a367-679f736dd673" :knowledge-point/title "Dividing Fractions When the Result Is a Mixed Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b119cfee-b73a-5997-8a74-1292c9191928" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\frac{1}{5}" :db/id #edb/ref 17592186478080}] :answer-field/correct {:answer/id #uuid "b119cfee-b73a-5997-8a74-1292c9191928" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\frac{1}{5}" :db/id #edb/ref 17592186478080} :answer-field/id #uuid "462b1592-91a5-5d0c-8479-8e5ee6c16e17" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186478273}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f72c51cd-c795-582a-a4d9-ceda93dea841" :question/math-academy-id "q-196291" :question/problem "Expressed as a **mixed number** in lowest terms, $\\frac{9}{10}÷\\frac{3}{4}=${{field-1}}." :question/worked-solution "Dividing a fraction by another fraction is equivalent to multiplying the first fraction by the reciprocal of the second fraction.\n\nThe reciprocal of $\\frac{3}{4}$ is $\\frac{4}{3}.$ So we have\n\n$$\n\\frac{9}{10}÷\\frac{3}{4}=\\frac{9}{10}\\times \\frac{4}{3}\n$$\n\n \n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{9}{10}\\times \\frac{4}{3}=\\frac{9\\times 4}{10\\times 3}=\\frac{36}{30}=\\frac{6}{5}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{6}{5}=1\\,\\text{R}\\,1=1\\,\\frac{1}{5}\n$$"}] [{:db/id #edb/ref 17592186478419 :knowledge-point/_questions [{:db/id #edb/ref 17592186142985 :knowledge-point/id #uuid "e3260562-39ce-5ec6-a367-679f736dd673" :knowledge-point/title "Dividing Fractions When the Result Is a Mixed Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c12eda4a-61a5-5f12-953b-9b5cf1a4caa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\frac{2}{5}" :db/id #edb/ref 17592186478112}] :answer-field/correct {:answer/id #uuid "c12eda4a-61a5-5f12-953b-9b5cf1a4caa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\frac{2}{5}" :db/id #edb/ref 17592186478112} :answer-field/id #uuid "eb1ab689-2748-59b5-8be6-c5b1112482a8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186478360}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7779f547-8847-58f6-adc5-4d88825fc5bf" :question/math-academy-id "q-196294" :question/problem "Expressed as a **mixed number** in lowest terms, $\\frac{4}{5}÷\\frac{1}{3}=${{field-1}}." :question/worked-solution "Dividing a fraction by another fraction is equivalent to multiplying the first fraction by the reciprocal of the second fraction.\n\nThe reciprocal of $\\frac{1}{3}$ is $\\frac{3}{1}.$ So we have\n\n$$\n\\frac{4}{5}÷\\frac{1}{3}=\\frac{4}{5}\\times \\frac{3}{1}\n$$\n\n \n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{4}{5}\\times \\frac{3}{1}=\\frac{4\\times 3}{5\\times 1}=\\frac{12}{5}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{12}{5}=2\\,\\text{R}\\,2=2\\,\\frac{2}{5}\n$$"}] [{:db/id #edb/ref 17592186143316 :knowledge-point/_questions [{:db/id #edb/ref 17592186142982 :knowledge-point/id #uuid "bbee94b0-ad82-5461-81f0-84237abf0c85" :knowledge-point/title "Dividing Unit Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a36ee1d9-9efc-5ce0-99bf-a49f7a1fd5d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186140866} {:answer/id #uuid "2fee9a96-77fd-5020-ae63-a9c24b1332d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{18}" :db/id #edb/ref 17592186140867} {:answer/id #uuid "3a58237e-e03a-53c8-8d11-c00f4b60587f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186140868} {:answer/id #uuid "441375db-0f22-56d0-8dd3-d3f0906a55e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186140869} {:answer/id #uuid "6272b870-be0c-544d-a84f-e19501cd2ba6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186140870}] :answer-field/correct {:answer/id #uuid "3a58237e-e03a-53c8-8d11-c00f4b60587f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186140868} :answer-field/id #uuid "1dee6189-bbc1-58f2-9437-c05bf238c71d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186140865}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f4a85168-e506-52bb-a032-c782b4edf1cd" :question/math-academy-id "q-57191" :question/problem "$\\frac{1}{3}÷\\frac{1}{6}=$" :question/worked-solution "Dividing a fraction by another fraction is equivalent to multiplying the first fraction by the reciprocal of the second fraction.\n\nThe reciprocal of $\\frac{1}{6}$ is $\\frac{6}{1}.$ So we have\n\n$$\n\\frac{1}{3}÷\\frac{1}{6}=\\frac{1}{3}\\times \\frac{6}{1}\n$$\n\n \n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{1}{3}\\times \\frac{6}{1}=\\frac{1\\times 6}{3\\times 1}=\\frac{6}{3}\n$$\n\nFinally, we simplify:\n\n$$\n6÷3=2\n$$"}] [{:db/id #edb/ref 17592186143317 :knowledge-point/_questions [{:db/id #edb/ref 17592186142983 :knowledge-point/id #uuid "008c73e1-62d2-51aa-a937-40a810d7d594" :knowledge-point/title "Dividing Fractions When Simplification Is Needed: Finding a Missing Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea57df06-3e64-5c7e-8c01-1a12320e7135" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186140872} {:answer/id #uuid "0ead6ab5-14f4-5167-8bce-88d20213ead3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186140873} {:answer/id #uuid "2bf97a58-fe36-5120-8f5a-15c8dbe459d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186140874} {:answer/id #uuid "38796936-93a0-5500-b64a-544504988da7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186140875} {:answer/id #uuid "5d2d05cc-a860-58ca-9bd1-fbdaa75a5d42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186140876}] :answer-field/correct {:answer/id #uuid "ea57df06-3e64-5c7e-8c01-1a12320e7135" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186140872} :answer-field/id #uuid "b47932b5-84ab-54ef-a8d6-d29d631d6015" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186140871}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "40002e40-c1d3-54ac-866f-c5fed9ae22f7" :question/math-academy-id "q-57195" :question/problem "What is the missing digit in the following equality?\n\n$$\n\\frac{4}{7}÷\\frac{2}{5}=\\frac{\\,\\boxed{}}{7}\n$$" :question/worked-solution "Dividing a fraction by another fraction is equivalent to multiplying the first fraction by the reciprocal of the second fraction.\n\nThe reciprocal of $\\frac{2}{5}$ is $\\frac{5}{2}.$ So we have\n\n$$\n\\frac{4}{7}÷\\frac{2}{5}=\\frac{4}{7}\\times \\frac{5}{2}\n$$\n\n \n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{4}{7}\\times \\frac{5}{2}=\\frac{4\\times 5}{7\\times 2}=\\frac{20}{14}\n$$\n\nFinally, we simplify:\n\n$$\n\\frac{20}{14}=\\frac{20÷2}{14÷2}=\\frac{10}{7}\n$$\n\nTherefore, the missing number is $10.$"}] [{:db/id #edb/ref 17592186143332 :knowledge-point/_questions [{:db/id #edb/ref 17592186142983 :knowledge-point/id #uuid "008c73e1-62d2-51aa-a937-40a810d7d594" :knowledge-point/title "Dividing Fractions When Simplification Is Needed: Finding a Missing Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f77aa9b8-e9fe-5f45-8596-0321bdfccb94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186140962} {:answer/id #uuid "61852b28-dbda-513c-b216-dacced046cfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186140963} {:answer/id #uuid "667a387d-66a0-55d1-91b5-3177e8541b3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186140964} {:answer/id #uuid "740c3c54-c281-57e9-a360-10a0dfcf9ef5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186140965} {:answer/id #uuid "7f89f93e-7e58-5c02-ab52-5ecb64f4cfce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186140966}] :answer-field/correct {:answer/id #uuid "667a387d-66a0-55d1-91b5-3177e8541b3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186140964} :answer-field/id #uuid "daf651ed-c777-58ca-bd5d-7d3bcef782f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186140961}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "19e3cce1-7df6-5415-b9ad-eacd2d58a5ed" :question/math-academy-id "q-57372" :question/problem "What is the missing digit in the following equality?\n\n$$\n\\frac{3}{8}÷\\frac{3}{5}=\\frac{\\,\\boxed{}}{8}\n$$" :question/worked-solution "Dividing a fraction by another fraction is equivalent to multiplying the first fraction by the reciprocal of the second fraction.\n\nThe reciprocal of $\\frac{3}{5}$ is $\\frac{5}{3}.$ So we have\n\n$$\n\\frac{3}{8}÷\\frac{3}{5}=\\frac{3}{8}\\times \\frac{5}{3}\n$$\n\n \n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{3}{8}\\times \\frac{5}{3}=\\frac{3\\times 5}{8\\times 3}=\\frac{15}{24}\n$$\n\nFinally, we simplify:\n\n$$\n\\frac{15}{24}=\\frac{15÷3}{24÷3}=\\frac{5}{8}\n$$\n\nTherefore, the missing number is $5.$"}] [{:db/id #edb/ref 17592186478436 :knowledge-point/_questions [{:db/id #edb/ref 17592186142984 :knowledge-point/id #uuid "0c20028f-c518-5353-9d1d-f69a7a62a0a8" :knowledge-point/title "Dividing Fractions When Simplification Is Needed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b54f680-68aa-5a55-a3cc-73b533fd28f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186477845} {:answer/id #uuid "4fc4bea9-4fab-550a-b296-7d6d93ee9a3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{15}" :db/id #edb/ref 17592186477898} {:answer/id #uuid "af1b7950-e1ad-501b-9745-d0c66ce3ef9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{18}" :db/id #edb/ref 17592186478076} {:answer/id #uuid "b4ab99df-5caa-5a01-9979-777f754d4e1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186478089} {:answer/id #uuid "eb4fbb6e-bec0-5627-8267-c8209a338a91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{14}" :db/id #edb/ref 17592186478203}] :answer-field/correct {:answer/id #uuid "eb4fbb6e-bec0-5627-8267-c8209a338a91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{14}" :db/id #edb/ref 17592186478203} :answer-field/id #uuid "c31e730b-b0d8-50fd-804c-07bd3c1d131f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478334}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b712bd99-fd9d-578f-99be-b3722982cb29" :question/math-academy-id "q-92736" :question/problem "$\\frac{1}{21}÷\\frac{2}{3}=$" :question/worked-solution "Dividing a fraction by another fraction is equivalent to multiplying the first fraction by the reciprocal of the second fraction.\n\nThe reciprocal of $\\frac{2}{3}$ is $\\frac{3}{2}.$ So we have\n\n$$\n\\frac{1}{21}÷\\frac{2}{3}=\\frac{1}{21}\\times \\frac{3}{2}\n$$\n\n \n\nNow, we multiply fractions. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{1}{21}\\times \\frac{3}{2}=\\frac{1\\times 3}{21\\times 2}=\\frac{3}{42}\n$$\n\nFinally, we simplify:\n\n$$\n\\frac{3}{42}=\\frac{3÷3}{42÷3}=\\frac{1}{14}\n$$"}]}
