#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186434389} :activity/id #uuid "8fdc0e2d-e98a-546b-920a-d66ad029459e" :activity/scope {:db/id #edb/ref 17592186049531 :topic/id #uuid "fc9ea30d-c77e-520f-8dab-e177eee4a483" :topic/math-academy-id 2457} :activity/steps [{:db/id #edb/ref 17592186434389 :step/content {:db/id #edb/ref 17592186147797 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e3eaa45b-e95e-56ec-8a67-73501143f470" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "greater than" :db/id #edb/ref 17592186144527} {:answer/id #uuid "07152769-74bf-591a-aebb-ca667326355d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "smaller than" :db/id #edb/ref 17592186144528} {:answer/id #uuid "159f1862-a910-5b33-adae-2450e3202d3e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "equal to" :db/id #edb/ref 17592186144529}] :answer-field/correct {:db/id #edb/ref 17592186144528} :answer-field/id #uuid "43928eed-5b05-5d51-9f93-ead6691909e7" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186144526} {:answer-field/choices [{:answer/id #uuid "46fc5334-0c6a-5482-b87a-7c4318f09d38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186144531} {:answer/id #uuid "474395f7-2d91-5a70-a4d4-165bc3b7a704" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186144532} {:answer/id #uuid "4c9e9564-165a-5562-94b1-894dc7afe170" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186144533} {:answer/id #uuid "7308d008-65ca-5910-a2b3-b1bc12fd93af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186144534}] :answer-field/correct {:db/id #edb/ref 17592186144533} :answer-field/id #uuid "1809e6b8-eb6a-53bc-901a-eef9d1d4b809" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186144530}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7a5c264b-c2e7-5576-92a3-b7dd68b10806" :question/math-academy-id "q-348936" :question/problem "Select the options that make the statement below true.\n\n$\\,$\n$20%$ is equivalent to \n{{field-1}},\nwhich is \n{{field-2}}\n$\\frac{2}{5}.$" :question/worked-solution "To convert the percent to a fraction, we first write $20%$ as a fraction with a denominator $100:$\n\n$$\n20%=\\frac{20}{100}\n$$\n\nWe can simplify the fraction by dividing the numerator and denominator by $10:$\n\n$$\n\\frac{20}{100}=\\frac{20÷10}{100÷10}=\\frac{2}{10}\n$$\n\nThen, we divide the numerator and denominator by $2:$\n\n$$\n\\frac{2}{10}=\\frac{2÷2}{10÷2}=\\frac{1}{5}\n$$\n\nNow, notice that\n\n$$\n\\frac{1}{5}<\\frac{2}{5}.\n$$\n\nTherefore, $20%$ is equivalent to $\\frac{1}{5},$ \nwhich is $\\text{smaller than}$ $\\frac{2}{5}.$"} :step/id #uuid "334dd9af-1647-5c57-bfb3-97a4e3ad59e7" :step/next {:db/id #edb/ref 17592186434392}} {:db/id #edb/ref 17592186434390 :step/content {:db/id #edb/ref 17592186147801 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4f08fc0-fe2a-50b1-9757-0125a843874f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186144561} {:answer/id #uuid "1ee410c9-3598-5305-9b67-6d7874ec6987" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186144562} {:answer/id #uuid "617a7101-40ff-5835-8af1-774698d53116" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186144563} {:answer/id #uuid "69438504-11e1-507e-aec0-5a2eb343486b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186144564} {:answer/id #uuid "77799f28-8b1d-514a-af66-5e9854758919" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186144565}] :answer-field/correct {:db/id #edb/ref 17592186144562} :answer-field/id #uuid "f0b76fa2-8ce2-54d1-84d0-0c484f99e832" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186144560}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "436201f3-78ea-5cda-b175-c5331e2f77ae" :question/math-academy-id "q-348980" :question/problem "Lionel and David are youth soccer players. In the previous season, $12%$ of Lionel’s goals were scored from the penalty spot, while the decimal proportion of David’s goals scored from the penalty spot was $0.1.$\n\nWhich of the following statements are true?\n\nI. Less than half of Lionel's goals scored were from the penalty spot.\n\nII. More than half of David's goals scored were from the penalty spot.\n\nIII. Lionel had a greater percentage of goals scored from the penalty spot compared to David." :question/worked-solution "Let's examine our statements in turn.\n\n- Statement I is true. Indeed, since \n\n$$\n12%<50%,\n$$\n\nless than half of Lionel's goals scored were from the penalty spot.\n\n- Statement II is false. Notice that \n\n$$\n0.1<0.5.\n$$\n\nSo, less than half of David's goals scored were from the penalty spot.\n\n- Statement III is true. We can compare $12%$ and $0.1$ by converting the decimal into a percent. \n\nTo do this, we multiply it by $100:$\n\n$$\n0.1\\times 100=10%\n$$\n\nSince  $12%>10%,$ Lionel had a **greater** percentage of goals scored from the penalty spot compared to David.\n\nTherefore, the correct answer is \"I and III only\"."} :step/id #uuid "37767ed4-b4c6-547e-a639-f6aeaee3ddec" :step/next {:db/id #edb/ref 17592186434391}} {:db/id #edb/ref 17592186434391 :step/content {:db/id #edb/ref 17592186434387 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fc398c3-ef25-52ba-8a15-a914c2acb08b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "equal to" :db/id #edb/ref 17592186434378} {:answer/id #uuid "cb6ea343-a5aa-5d69-b351-d0c27cab6e7f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "greater than" :db/id #edb/ref 17592186434382} {:answer/id #uuid "f52cda3d-118c-5960-b7d2-b5e6e6485224" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "smaller than" :db/id #edb/ref 17592186434383}] :answer-field/correct {:db/id #edb/ref 17592186434382} :answer-field/id #uuid "0b435f79-e45f-54bc-a9c1-2ebc68f39df2" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186434385} {:answer-field/choices [{:answer/id #uuid "355f6139-1632-5fb9-a099-f60c0204143d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{17}{40}" :db/id #edb/ref 17592186434373} {:answer/id #uuid "43eb7fb9-45e1-5182-81e4-f59709d8a423" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16}{40}" :db/id #edb/ref 17592186434374} {:answer/id #uuid "4da1f349-69e6-5209-8396-1c722ffbf3d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{18}{40}" :db/id #edb/ref 17592186434375} {:answer/id #uuid "4e451e41-9d76-5570-9fd1-85be78bfe38d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{20}{40}" :db/id #edb/ref 17592186434376}] :answer-field/correct {:db/id #edb/ref 17592186434375} :answer-field/id #uuid "c1896846-f13a-5c11-a37a-ffc9a894ca42" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186434386}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "138791bc-5cad-58ca-ae3d-64015f9ea134" :question/math-academy-id "q-349678" :question/problem "Select the options that make the statement below true.\n\n$\\,$\n$45%$ is equivalent to \n{{field-1}},\nwhich is \n{{field-2}}\n$\\frac{17}{40}.$" :question/worked-solution "To convert the percent to a fraction, we first write $45%$ as a fraction with a denominator $100:$\n\n$$\n45%=\\frac{45}{100}\n$$\n\nWe can simplify the fraction by dividing the numerator and denominator by $5:$\n\n$$\n\\frac{45}{100}=\\frac{45÷5}{100÷5}=\\frac{9}{20}\n$$\n\nWe can write this with a denominator of $40$ by multiplying the numerator and denominator by $2:$\n\n$$\n\\frac{9}{20}=\\frac{9\\times 2}{20\\times 2}=\\frac{18}{40}\n$$\n\nNow, notice that\n\n$$\n\\frac{18}{40}>\\frac{17}{40}.\n$$\n\nTherefore, $45%$ is equivalent to $\\frac{18}{40},$ \nwhich is $\\text{greater than}$ $\\frac{17}{40}.$"} :step/id #uuid "63533d39-a10e-52e0-8ad1-5274656cd410" :step/next {:db/id #edb/ref 17592186434393}} {:db/id #edb/ref 17592186434392 :step/content {:db/id #edb/ref 17592186147799 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a67e790c-f268-5a24-94e8-ca5c04dedf83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "80%" :db/id #edb/ref 17592186144545} {:answer/id #uuid "c936d84b-d07f-525b-9bc9-6ff7f01e4d96" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15%" :db/id #edb/ref 17592186144546} {:answer/id #uuid "eadc4352-8c2c-59f9-9473-b7ec2bfbcf10" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "75%" :db/id #edb/ref 17592186144547} {:answer/id #uuid "3b38da8f-941c-53fd-91b1-d2edd954e611" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "34%" :db/id #edb/ref 17592186144548}] :answer-field/correct {:db/id #edb/ref 17592186144547} :answer-field/id #uuid "2653229a-ec4a-5e31-8fa9-9eb366c71a49" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186144544} {:answer-field/choices [{:answer/id #uuid "e538c8b1-a7d7-56df-8afa-ab47b7820cfa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "fewer" :db/id #edb/ref 17592186144550} {:answer/id #uuid "58139854-a8fc-5365-b0a4-5f76bb20339b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "more" :db/id #edb/ref 17592186144551}] :answer-field/correct {:db/id #edb/ref 17592186144551} :answer-field/id #uuid "c4996420-521b-5b75-b05e-f70a30820317" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186144549}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "57efd73d-0f59-56f1-a156-7f1ee9e1fa2b" :question/math-academy-id "q-348969" :question/problem "Matt and Abraham have the same number of marbles. A total of $63%$ of Matt's marbles are blue, while $\\frac{3}{4}$ of Abraham's marbles are blue. Select the options that make the statements below true.\n\n$\\,$\nA total of \n{{field-1}}\nof Abraham's marbles are blue. \n\n$\\,$\nTherefore, he has \n{{field-2}}\nblue marbles compared to Matt." :question/worked-solution "We need to compare $\\frac{3}{4}$ with $63%.$ We can do this by writing $\\frac{3}{4}$ as a percent.\n\nFirst, we write $\\frac{3}{4}$ as an equivalent fraction with $100$ as the denominator:\n\n$$\n\\frac{3}{4}=\\frac{3\\times 25}{4\\times 25}=\\frac{75}{100}\n$$\n\nNow, we can write this fraction as a percentage:\n\n$$\n\\frac{75}{100}=75%\n$$\n\nSince $75%>63%,$ we have the following:\n\n- A total of $75%$ of Abraham's marbles are blue.\n\n- Therefore, he has $\\text{more}$ blue marbles compared to Matt."} :step/id #uuid "cf9b1dbf-2308-5acb-ba12-635c8825ef8b" :step/next {:db/id #edb/ref 17592186434390}} {:db/id #edb/ref 17592186434393 :step/content {:db/id #edb/ref 17592186434388 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1129c1e9-1f22-5780-9696-b4a255e78851" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186434372} {:answer/id #uuid "585c654e-1a6c-5f56-ac8d-5f161ee40bff" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186434377} {:answer/id #uuid "739f06d6-c702-56c9-a051-08e032332d7a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186434379} {:answer/id #uuid "9ab8acb2-0f16-5f40-8fd6-1f3209f135e3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186434380} {:answer/id #uuid "c956c11a-2fd4-59e8-a085-706468c3a376" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186434381}] :answer-field/correct {:db/id #edb/ref 17592186434381} :answer-field/id #uuid "09954eee-e3cc-5394-bd09-4440f9d978a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186434384}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "16a4ed86-6ba4-5b08-b5bc-00c64da3da49" :question/math-academy-id "q-350266" :question/problem "Sana and Talia are students. In the previous semester, the decimal proportion of Sana’s homework assignments that were turned in early was $0.4,$ while $45%$ of Talia’s homework assignments were turned in early. \n\nWhich of the following statements are true?\n\nI. Less than half of Sana's homework assignments were turned in early.\n\nII. More than half of Talia's homework assignments were turned in early.\n\nIII. Sana had a greater percentage of homework assignments turned in early compared to Talia." :question/worked-solution "Let's examine our statements in turn.\n\n- Statement I is true. Indeed, since \n\n$$\n0.4<0.5,\n$$\n\nless than half of Sana's homework assignments were turned in early.\n\n- Statement II is false. Notice that \n\n$$\n45%<50%.\n$$\n\nSo, less than half of Talia's homework assignments were turned in early.\n\n- Statement III is false. We can compare $0.4$ and $45%$ by converting the decimal into a percent. \n\nTo do this, we multiply it by $100:$\n\n$$\n0.4\\times 100=40%\n$$\n\nSince  $40%<45%,$ Sana did not have a greater percentage of homework assignments turned in early compared to Talia.\n\nTherefore, the correct answer is \"I only\"."} :step/id #uuid "e00df753-1591-526d-a3e8-f3c5207c5bfd"}] :activity/title "Comparing Fractions, Percents, and Decimals" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186434371}]}
