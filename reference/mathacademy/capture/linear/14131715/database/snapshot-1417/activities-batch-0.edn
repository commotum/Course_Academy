#{[{:activity/first-step {:db/id #edb/ref 17592186148482} :activity/id #uuid "e30f8e58-bf46-5a3b-b6e5-78f40e3c48c1" :activity/scope {:db/id #edb/ref 17592186049531 :topic/id #uuid "fc9ea30d-c77e-520f-8dab-e177eee4a483" :topic/math-academy-id 2457} :activity/steps [{:db/id #edb/ref 17592186148482 :step/content {:db/id #edb/ref 17592186148698 :tutorial/content "When working with fractions, percents, and decimals, we often need to decide which number is greater or smaller. Since these numbers are written in different forms, it can be difficult to compare them directly.\n\nTo make comparisons easier, we can *convert them to a common form*.\n\nFor example, let's compare the percent $48\\%$ and the decimal $0.52$.\n\nOne way to do that is to convert the percent to a decimal. So, we divide the percent value by $100{:}$\n\n$$\n48 \\div 100 = 0.48\n$$\n\nThus, $48\\%$ is equivalent to $0.48$.\n\nNow, we can compare the two decimals:\n$0.48 < 0.52$\n\nTherefore, we can conclude that $48\\%$ is smaller than $0.52$.\n\nLet's see more examples." :tutorial/id #uuid "e6681afa-a432-5074-a46c-204561f2cf65" :tutorial/math-academy-id 2078 :tutorial/title "Introduction"} :step/id #uuid "d9c7592c-10c0-5cc3-b1ff-b5b67dfe08ba" :step/math-academy-id 632742 :step/next {:db/id #edb/ref 17592186148483}} {:db/id #edb/ref 17592186148483 :step/content {:db/id #edb/ref 17592186147542 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147245 :question/id #uuid "7dd3b106-ac45-522a-97ea-6dc4355f0247" :question/math-academy-id "e-2317"} :knowledge-point/id #uuid "6be40082-db16-5983-aa43-9b6ee8f59def" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049298} {:db/id #edb/ref 17592186050030}] :knowledge-point/questions [{:db/id #edb/ref 17592186147795} {:db/id #edb/ref 17592186147796}] :knowledge-point/title "Comparing a Decimal to a Percent"} :step/id #uuid "5df02fb6-3576-5996-8b1e-64978fa7b5d8" :step/math-academy-id 632743 :step/next {:db/id #edb/ref 17592186148484}} {:db/id #edb/ref 17592186148484 :step/content {:db/id #edb/ref 17592186147543 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147246 :question/id #uuid "22bfefb3-89b4-5d42-b305-732790c89fbd" :question/math-academy-id "e-2318"} :knowledge-point/id #uuid "37060efd-560b-5d57-b108-07c202e3abcc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049640} {:db/id #edb/ref 17592186050478}] :knowledge-point/questions [{:db/id #edb/ref 17592186147797} {:db/id #edb/ref 17592186147798}] :knowledge-point/title "Comparing a Percent to a Fraction"} :step/id #uuid "f6835341-5e27-57e3-ae67-a97b6df1ba75" :step/math-academy-id 632746 :step/next {:db/id #edb/ref 17592186148485}} {:db/id #edb/ref 17592186148485 :step/content {:db/id #edb/ref 17592186148670 :tutorial/content "Suppose Ethan and Ryan are baseball players. In the previous season, $24\\%$ of Ethan’s hits were home runs, while the decimal proportion of Ryan’s hits that were home runs was $0.3$.\n\nLet’s determine whether either Ethan or Ryan hit home runs on more than half of their total hits.\n\n- *For Ethan*, we compare his statistic to one-half written as a percentage, $50\\%$. Since\n$24\\% < 50\\%$,\nless than half of Ethan’s hits were home runs.\n- *For Ryan*, we compare his statistic to one-half written as a decimal, $0.5$. Since\n$0.3 < 0.5$,\nless than half of Ryan’s hits were home runs.\n\nTherefore, neither player hit home runs on more than half of their hits.\n\nNow, let’s see more concrete examples." :tutorial/id #uuid "fbb4d977-7db5-579e-baf0-bb8e13b6c15a" :tutorial/math-academy-id 14935 :tutorial/title "Comparing Decimals and Percents in Context"} :step/id #uuid "4ce04142-5c86-5b4c-a76f-55af88901484" :step/math-academy-id 632749 :step/next {:db/id #edb/ref 17592186148486}} {:db/id #edb/ref 17592186148486 :step/content {:db/id #edb/ref 17592186147544 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147235 :question/id #uuid "4016fd3c-d8b2-5ef2-8554-47ac5c183950" :question/math-academy-id "e-22017"} :knowledge-point/id #uuid "638e604b-5416-5d3c-a61f-5be645aa255b" :knowledge-point/questions [{:db/id #edb/ref 17592186147801} {:db/id #edb/ref 17592186147802}] :knowledge-point/title "Identifying True Statements in Context"} :step/id #uuid "c0e51654-69d7-5097-b27f-71f3c28bce97" :step/math-academy-id 632750 :step/next {:db/id #edb/ref 17592186148487}} {:db/id #edb/ref 17592186148487 :step/content {:db/id #edb/ref 17592186148671 :tutorial/content "Now, suppose Carlos and Henry have the same number of trading cards. A total of $32 \\%$ of Carlos's cards are rare cards, while\n\n$$\n\\dfrac{1}{4}\n$$\n\nof Henry's cards are rare cards.\n\nWho has more rare cards?\n\nTo answer this, we need to *compare the fraction and the percentage*:\n\n$$\n\\dfrac{1}{4} \\qquad\\text{and}\\qquad 32 \\%\n$$\n\nA common method is to convert the fraction to a percentage.\n\nFirst, we write\n\n$$\n\\dfrac{1}{4}\n$$\n\nas an equivalent fraction with $100$ as the denominator:\n\n$$\n\\dfrac{1}{4} = \\dfrac{1 \\times 25}{4 \\times 25} = \\dfrac{25}{100}\n$$\n\nNow, we can write this fraction as a percentage:\n\n$$\n\\dfrac{25}{100} = 25 \\%\n$$\n\nSince $25 \\% < 32 \\%$, we can conclude that Carlos has *more* rare cards than Carlos." :tutorial/id #uuid "4be68676-8fcc-56ce-a8ef-96b2a954a03c" :tutorial/math-academy-id 14937 :tutorial/title "Comparing Fractions and Percents in Context"} :step/id #uuid "99330381-c770-5a62-a3c7-a79ba13fcd0b" :step/math-academy-id 632753 :step/next {:db/id #edb/ref 17592186148488}} {:db/id #edb/ref 17592186148488 :step/content {:db/id #edb/ref 17592186147545 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147247 :question/id #uuid "e6b550b1-cd66-5a70-9d11-d37733ac4c5f" :question/math-academy-id "e-2319"} :knowledge-point/id #uuid "9d39373d-ba41-53aa-8119-4ecf5138a50a" :knowledge-point/questions [{:db/id #edb/ref 17592186147799} {:db/id #edb/ref 17592186147800} {:db/id #edb/ref 17592186424830}] :knowledge-point/title "Comparing Fractions and Percents: Word Problem"} :step/id #uuid "5102e680-a474-5349-a6c9-27bc67303b7a" :step/math-academy-id 632754}] :activity/title "Comparing Fractions, Percents, and Decimals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186147658}]}
