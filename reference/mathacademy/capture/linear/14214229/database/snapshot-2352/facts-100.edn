#{[17592186480059 #edb/ref 1068 #edb/ref 17592186480099 #edb/ref 17592186045443] [17592186480059 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045443] [17592186480059 #edb/ref 1071 "Given that $f(x)=7{e}^{x}-2{x}^{4}-2{x}^{2}$, find $f'(x)=$ {{field-1}}." #edb/ref 17592186045443] [17592186480059 #edb/ref 1072 #uuid "28f1a34b-c02b-5f32-a2d4-3b8647e374de" #edb/ref 17592186045443] [17592186480059 #edb/ref 1074 "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}f'(x) & =\\frac{\\text{d}}{\\text{d}x}(7{e}^{x}-2{x}^{4}-2{x}^{2}) \\\\ & =\\frac{\\text{d}}{\\text{d}x}(7{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(2{x}^{4})-\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}) \\\\ & =7\\frac{\\text{d}}{\\text{d}x}({e}^{x})-2\\frac{\\text{d}}{\\text{d}x}({x}^{4})-2\\frac{\\text{d}}{\\text{d}x}({x}^{2}) \\\\ & =7{e}^{x}-2(4{x}^{3})-2(2x) \\\\ & =7{e}^{x}-8{x}^{3}-4x.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186480063 #edb/ref 1068 #edb/ref 17592186480050 #edb/ref 17592186045443] [17592186480063 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045443] [17592186480063 #edb/ref 1071 "For $x<-3$, let $f(x)=4{e}^{x}-4{x}^{2}-6x$. Then $f'(x)=$ {{field-1}}." #edb/ref 17592186045443] [17592186480063 #edb/ref 1072 #uuid "39b1266c-5944-5dcf-b535-d35e41bcefcb" #edb/ref 17592186045443] [17592186480063 #edb/ref 1074 "For $x<-3,$ we use the expression $f(x)=4{e}^{x}-4{x}^{2}-6x,$ which is differentiable.\n\nUsing the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}-4{x}^{2}-6x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(4{x}^{2})-\\frac{\\text{d}}{\\text{d}x}(6x) \\\\  & =4{e}^{x}-8x-6.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186480079 #edb/ref 1068 #edb/ref 17592186480086 #edb/ref 17592186045443] [17592186480079 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186480079 #edb/ref 1071 "Given that $f(x) = 7{e}^{x} - 2{x}^{2} + 1$, find $f^{′}(x)$." #edb/ref 17592186045443] [17592186480079 #edb/ref 1072 #uuid "715a8ac6-fd66-549a-b175-7f154dd14992" #edb/ref 17592186045443] [17592186480079 #edb/ref 1074 "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}f'(x) & =\\frac{\\text{d}}{\\text{d}x}(7{e}^{x}-2{x}^{2}+1) \\\\ & =\\frac{\\text{d}}{\\text{d}x}(7{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(2{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(1) \\\\ & =7\\frac{\\text{d}}{\\text{d}x}({e}^{x})-2\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(1) \\\\ & =7{e}^{x}-2(2x)+0 \\\\ & =7{e}^{x}-4x.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186480081 #edb/ref 1068 #edb/ref 17592186480103 #edb/ref 17592186045443] [17592186480081 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045443] [17592186480081 #edb/ref 1071 "For $x<3$, let $g(x)=-2{e}^{x}-7{x}^{2}+2x$. Then $g'(x)=$ {{field-1}}." #edb/ref 17592186045443] [17592186480081 #edb/ref 1072 #uuid "79103b32-86de-5f9f-9f15-ae04d815512a" #edb/ref 17592186045443] [17592186480081 #edb/ref 1074 "For $x<3,$ we use the expression $g(x)=-2{e}^{x}-7{x}^{2}+2x,$ which is differentiable.\n\nUsing the addition and the power rules, we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-2{e}^{x}-7{x}^{2}+2x) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}(2{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(7{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(2x) \\\\  & =-2{e}^{x}-14x+2.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186480083 #edb/ref 1068 #edb/ref 17592186480076 #edb/ref 17592186045443] [17592186480083 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045443] [17592186480083 #edb/ref 1071 "Given that $h(x)=4{e}^{x}-2{x}^{7}+6{x}^{3}$, find $h'(x)=$ {{field-1}}." #edb/ref 17592186045443] [17592186480083 #edb/ref 1072 #uuid "7f89f273-a11f-549a-8a60-c366a1c603b1" #edb/ref 17592186045443] [17592186480083 #edb/ref 1074 "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}h'(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}-2{x}^{7}+6{x}^{3}) \\\\ & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(2{x}^{7})+\\frac{\\text{d}}{\\text{d}x}(6{x}^{3}) \\\\ & =4\\frac{\\text{d}}{\\text{d}x}({e}^{x})-2\\frac{\\text{d}}{\\text{d}x}({x}^{7})+6\\frac{\\text{d}}{\\text{d}x}({x}^{3}) \\\\ & =4{e}^{x}-2(7{x}^{6})+6(3{x}^{2}) \\\\ & =4{e}^{x}-14{x}^{6}+18{x}^{2}.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186480088 #edb/ref 1068 #edb/ref 17592186480064 #edb/ref 17592186045443] [17592186480088 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045443] [17592186480088 #edb/ref 1071 "Given that $h(x)=4{e}^{x}-4{x}^{4}-6{x}^{2}$, find $h'(x)=$ {{field-1}}." #edb/ref 17592186045443] [17592186480088 #edb/ref 1072 #uuid "a03b064f-d419-5044-8615-d5e461c22029" #edb/ref 17592186045443] [17592186480088 #edb/ref 1074 "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}h'(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}-4{x}^{4}-6{x}^{2}) \\\\ & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(4{x}^{4})-\\frac{\\text{d}}{\\text{d}x}(6{x}^{2}) \\\\ & =4\\frac{\\text{d}}{\\text{d}x}({e}^{x})-4\\frac{\\text{d}}{\\text{d}x}({x}^{4})-6\\frac{\\text{d}}{\\text{d}x}({x}^{2}) \\\\ & =4{e}^{x}-4(4{x}^{3})-6(2x) \\\\ & =4{e}^{x}-16{x}^{3}-12x.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186480089 #edb/ref 1068 #edb/ref 17592186480090 #edb/ref 17592186045443] [17592186480089 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045443] [17592186480089 #edb/ref 1071 "Given that $f(x) = 7{e}^{x} - 2{x}^{2} - 2x - 18$, find $f^{′}(x)$." #edb/ref 17592186045443] [17592186480089 #edb/ref 1072 #uuid "a8456306-9118-592b-ba3e-acf608603d3d" #edb/ref 17592186045443] [17592186480089 #edb/ref 1074 "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}f'(x) & =\\frac{\\text{d}}{\\text{d}x}(7{e}^{x}-2{x}^{2}-2x-18) \\\\ & =\\frac{\\text{d}}{\\text{d}x}(7{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(2{x}^{2})-\\frac{\\text{d}}{\\text{d}x}(2x)-\\frac{\\text{d}}{\\text{d}x}(18) \\\\ & =7\\frac{\\text{d}}{\\text{d}x}({e}^{x})-2\\frac{\\text{d}}{\\text{d}x}({x}^{2})-2\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(18) \\\\ & =7{e}^{x}-2(2x)-2(1)-0 \\\\ & =7{e}^{x}-4x-2.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186480091 #edb/ref 1068 #edb/ref 17592186480098 #edb/ref 17592186045443] [17592186480091 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045443] [17592186480091 #edb/ref 1071 "Given that $g(x) = 5{e}^{x} - 4{x}^{2} + x - 11$, find $g^{′}(x)$." #edb/ref 17592186045443] [17592186480091 #edb/ref 1072 #uuid "bbc1984d-8d4d-5124-b526-4edb9aabc7e9" #edb/ref 17592186045443] [17592186480091 #edb/ref 1074 "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}g'(x) & =\\frac{\\text{d}}{\\text{d}x}(5{e}^{x}-4{x}^{2}+x-11) \\\\ & =\\frac{\\text{d}}{\\text{d}x}(5{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(4{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(11) \\\\ & =5\\frac{\\text{d}}{\\text{d}x}({e}^{x})-4\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(11) \\\\ & =5{e}^{x}-4(2x)+(1)-0 \\\\ & =5{e}^{x}-8x+1.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186480092 #edb/ref 1068 #edb/ref 17592186480073 #edb/ref 17592186045443] [17592186480092 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186480092 #edb/ref 1071 "Let $f(x)={x}^{3}+6x$ and $g(x)={e}^{x}$. If $k(x)=g(x)-f(x)$, then $\\frac{\\text{d}k}{\\text{d}x}=$ {{field-1}}." #edb/ref 17592186045443] [17592186480092 #edb/ref 1072 #uuid "bd74a88f-3e9e-54af-946f-d004983e42ec" #edb/ref 17592186045443] [17592186480092 #edb/ref 1074 "Using the given definitions, we have\n\n$$\n\\begin{aligned}k(x) & =g(x)-f(x) \\\\  & ={e}^{x}-({x}^{3}+6x) \\\\  & ={e}^{x}-{x}^{3}-6x\\end{aligned}\n$$\n\nUsing the addition and power rules, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}k}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({e}^{x}-{x}^{3}-6x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({e}^{x})-\\frac{\\text{d}}{\\text{d}x}({x}^{3})-\\frac{\\text{d}}{\\text{d}x}(6x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({e}^{x})-\\frac{\\text{d}}{\\text{d}x}({x}^{3})-6\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & ={e}^{x}-3{x}^{2}-6.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186480093 #edb/ref 1068 #edb/ref 17592186480066 #edb/ref 17592186045443] [17592186480093 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186480093 #edb/ref 1071 "Given that $g(x)=4{e}^{x}-2{x}^{2}+8$, find the slope of the tangent at $x=1.$" #edb/ref 17592186045443] [17592186480093 #edb/ref 1072 #uuid "bf13a195-c5b0-5308-8807-0ec8ba1fef3d" #edb/ref 17592186045443] [17592186480093 #edb/ref 1074 "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}-2{x}^{2}+8) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(-2{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(8) \\\\  & =4\\frac{\\text{d}}{\\text{d}x}({e}^{x})-2\\frac{\\text{d}}{\\text{d}x}({x}^{2})+0 \\\\  & =4{e}^{x}-4x.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}g}{\\text{d}x}|}_{x=1} & ={(4{e}^{x}-4x)\\,|}_{x=1} \\\\  & =4{e}^{1}-4\\cdot 1 \\\\  & =-4 + 4 e.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186480107 #edb/ref 1068 #edb/ref 17592186480101 #edb/ref 17592186045443] [17592186480107 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045443] [17592186480107 #edb/ref 1071 "Given that $g(x)=4{e}^{x}-2{x}^{2}+6x+8$, find the slope of the tangent at $x=0.$" #edb/ref 17592186045443] [17592186480107 #edb/ref 1072 #uuid "fc8205dd-9383-5240-aa7c-245bff3c1e94" #edb/ref 17592186045443] [17592186480107 #edb/ref 1074 "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}-2{x}^{2}+6x+8) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(2{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(6x)+\\frac{\\text{d}}{\\text{d}x}(8) \\\\  & =4\\frac{\\text{d}}{\\text{d}x}({e}^{x})-2\\frac{\\text{d}}{\\text{d}x}({x}^{2})+6\\frac{\\text{d}}{\\text{d}x}(x)+\\frac{\\text{d}}{\\text{d}x}(8) \\\\  & =4{e}^{x}-2(2x)+6(1)+0 \\\\  & =4{e}^{x}-4x+6.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}g}{\\text{d}x}|}_{x=0} & ={(4{e}^{x}-4x+6)\\,|}_{x=0} \\\\  & =4{e}^{0}-4\\cdot 0+6 \\\\  & =4\\cdot 1+0+6 \\\\  & =4+6 \\\\  & =10.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186480109 #edb/ref 1168 "generate/scratch/17592186096611.py" #edb/ref 17592186045443] [17592186480109 #edb/ref 1169 #uuid "337ca211-135e-5973-81fe-043f1cf73b4b" #edb/ref 17592186045443]}
