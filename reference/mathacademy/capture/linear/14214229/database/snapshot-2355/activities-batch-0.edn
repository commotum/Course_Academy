#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186097413} :activity/id #uuid "64f2826e-10ec-5427-8fd0-5dacd740fef4" :activity/scope {:db/id #edb/ref 17592186048749 :topic/id #uuid "bad8d582-b827-501b-8a06-58b93e5ecdb0" :topic/math-academy-id 1114} :activity/steps [{:db/id #edb/ref 17592186097413 :step/content {:db/id #edb/ref 17592186097813 :tutorial/content "The exponential function  $f(x) = e^x$ has the special property that its derivative is the function itself:\n\n$$\n\\dfrac{\\textrm{d}}{ \\textrm{d} x}\\left( e^x \\right)= e^x\n$$\n\nSo, taking the derivative of an exponential function does nothing to the exponential function. The exponential function remains exactly the same. \n\nNote that the exponential function is the *only* function with this special property.\n\nWe'll justify this result at the end of the lesson. But for now, let's get some practice working with it." :tutorial/id #uuid "a71b1a8d-93f4-5e48-ab3a-bd7220d50f18" :tutorial/math-academy-id 2611 :tutorial/title "Introduction"} :step/id #uuid "9f76f2b2-574f-5f45-a54b-c55d5040cccd" :step/math-academy-id 12306 :step/next {:db/id #edb/ref 17592186097414}} {:db/id #edb/ref 17592186097414 :step/content {:db/id #edb/ref 17592186096610 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096410 :question/id #uuid "8e4367b2-f7bc-5588-b30b-d612915e3e68" :question/math-academy-id "e-3624"} :knowledge-point/id #uuid "bb40a0ff-c3b5-512d-a436-cc2fce456008" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048932}] :knowledge-point/question-generator {:db/id #edb/ref 17592186480049} :knowledge-point/questions [{:db/id #edb/ref 17592186097160} {:db/id #edb/ref 17592186097316} {:db/id #edb/ref 17592186237849} {:db/id #edb/ref 17592186237850} {:db/id #edb/ref 17592186314904} {:db/id #edb/ref 17592186314906} {:db/id #edb/ref 17592186338886} {:db/id #edb/ref 17592186480008} {:db/id #edb/ref 17592186480009} {:db/id #edb/ref 17592186480011} {:db/id #edb/ref 17592186480014} {:db/id #edb/ref 17592186480016} {:db/id #edb/ref 17592186480017} {:db/id #edb/ref 17592186480023} {:db/id #edb/ref 17592186480027} {:db/id #edb/ref 17592186480034} {:db/id #edb/ref 17592186480041} {:db/id #edb/ref 17592186480044} {:db/id #edb/ref 17592186480048} {:db/id #edb/ref 17592186524982} {:db/id #edb/ref 17592186525017}] :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Constant"} :step/id #uuid "49950076-5f24-57dd-96a0-b8b061b4f2cb" :step/math-academy-id 12307 :step/next {:db/id #edb/ref 17592186097415}} {:db/id #edb/ref 17592186097415 :step/content {:db/id #edb/ref 17592186096611 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096411 :question/id #uuid "48334c0c-a49e-5dfb-9f8a-8caa0c22d1f9" :question/math-academy-id "e-3625"} :knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/question-generator {:db/id #edb/ref 17592186480109} :knowledge-point/questions [{:db/id #edb/ref 17592186096989} {:db/id #edb/ref 17592186096990} {:db/id #edb/ref 17592186235457} {:db/id #edb/ref 17592186235471} {:db/id #edb/ref 17592186272085} {:db/id #edb/ref 17592186272086} {:db/id #edb/ref 17592186284688} {:db/id #edb/ref 17592186284689} {:db/id #edb/ref 17592186297289} {:db/id #edb/ref 17592186480052} {:db/id #edb/ref 17592186480057} {:db/id #edb/ref 17592186480059} {:db/id #edb/ref 17592186480063} {:db/id #edb/ref 17592186480079} {:db/id #edb/ref 17592186480081} {:db/id #edb/ref 17592186480083} {:db/id #edb/ref 17592186480088} {:db/id #edb/ref 17592186480089} {:db/id #edb/ref 17592186480091} {:db/id #edb/ref 17592186480092} {:db/id #edb/ref 17592186480093} {:db/id #edb/ref 17592186480107} {:db/id #edb/ref 17592186525040}] :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"} :step/id #uuid "ef920bbd-db8e-5c63-82fa-370c8e9f05e9" :step/math-academy-id 12308 :step/next {:db/id #edb/ref 17592186097416}} {:db/id #edb/ref 17592186097416 :step/content {:db/id #edb/ref 17592186097814 :tutorial/content "If we replace  the base $e$ of an exponential function by any other positive number $a$, then the derivative is as follows:\n\n$$\n\\dfrac{\\textrm{d}}{ \\textrm{d} x}\\left( a^x \\right)= a^x \\ln a\n$$\n\nWe just multiply the given exponential function by the natural logarithm of the base.\n\nNote that since $\\ln e =1$, our first formula is a particular case of this one!\n\n$$\n\\dfrac{\\textrm{d}}{ \\textrm{d} x}\\left( e^x \\right)= e^x \\ln e = e^x \\cdot 1 = e^x\n$$" :tutorial/id #uuid "061a5c54-700a-5793-b266-cf156584544a" :tutorial/math-academy-id 2612 :tutorial/title "Differentiating an Exponential Function with a Base Other Than e"} :step/id #uuid "ef1a628c-101c-57a3-a8d3-5ce0731832a5" :step/math-academy-id 12309 :step/next {:db/id #edb/ref 17592186097417}} {:db/id #edb/ref 17592186097417 :step/content {:db/id #edb/ref 17592186096612 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096412 :question/id #uuid "16b1a91c-ae83-5e6b-a11d-bb9d78e4d218" :question/math-academy-id "e-3626"} :knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/question-generator {:db/id #edb/ref 17592186479997} :knowledge-point/questions [{:db/id #edb/ref 17592186096991} {:db/id #edb/ref 17592186097155} {:db/id #edb/ref 17592186253334} {:db/id #edb/ref 17592186284697} {:db/id #edb/ref 17592186297290} {:db/id #edb/ref 17592186314919} {:db/id #edb/ref 17592186314920} {:db/id #edb/ref 17592186479956} {:db/id #edb/ref 17592186479960} {:db/id #edb/ref 17592186479964} {:db/id #edb/ref 17592186479971} {:db/id #edb/ref 17592186479973} {:db/id #edb/ref 17592186479974} {:db/id #edb/ref 17592186479976} {:db/id #edb/ref 17592186479981} {:db/id #edb/ref 17592186479982} {:db/id #edb/ref 17592186479989} {:db/id #edb/ref 17592186479990} {:db/id #edb/ref 17592186479993} {:db/id #edb/ref 17592186479996} {:db/id #edb/ref 17592186524984}] :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"} :step/id #uuid "d2eb3d3f-2d57-59c0-b5a0-4253946c9cf7" :step/math-academy-id 12310 :step/next {:db/id #edb/ref 17592186097418}} {:db/id #edb/ref 17592186097418 :step/content {:db/id #edb/ref 17592186097815 :tutorial/content "To derive the identity\n\n$$\n\\frac{\\mathrm{d}}{\\mathrm{d}x}(e^x) = e^x,\n$$\n\nwe begin with the definition of the derivative:\n\nwhere $f(x) = e^x$.\n\nSubstituting the function $f(x)$ into the definition of $f'(x),$ we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={lim}_{h\\to 0}\\frac{{e}^{x+h}-{e}^{x}}{h} \\\\  & ={lim}_{h\\to 0}\\frac{{e}^{x}\\cdot {e}^{h}-{e}^{x}}{h} \\\\  & ={lim}_{h\\to 0}\\frac{{e}^{x}\\cdot ({e}^{h}-1)}{h} \\\\  & ={e}^{x}\\cdot {lim}_{h\\to 0}\\frac{{e}^{h}-1}{h}.\\end{aligned}\n$$\n\nNow, it can be shown that\n\n$$\n\\lim_{h \\to 0} \\frac{e^h - 1}{h} = 1,\n$$\n\nwhich gives\n\n$$\nf'(x) = e^x \\cdot 1 = e^x.\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{\\mathrm{d}}{\\mathrm{d}x}(e^x) = e^x.\n$$" :tutorial/id #uuid "1b006e01-04f6-5f6b-b435-b0f89163d7a1" :tutorial/math-academy-id 2613 :tutorial/title "Justifying the Rule for the Derivative of the Exponential Function"} :step/id #uuid "be9c264f-1e13-55c5-83f7-3217ce14b437" :step/math-academy-id 12311 :step/next {:db/id #edb/ref 17592186097749}} {:db/id #edb/ref 17592186097749 :step/content {:db/id #edb/ref 17592186097806 :tutorial/content "Now, let's derive the rule\n![](images/77/77334bed6aafc3383552d90bcfc8da614d56493edce4e7ab89a2f28e01d3dbfa.svg)\n\nThe trick here is to write this in terms of ![](images/5b/5ba79af546498192229d0cdd5a4a922d1d015802402b8eec5910fe00f999820d.svg) \n\nFirst, note that since the natural logarithm is the inverse of the exponential function, we have\n![](images/09/091c69568c8472aacf8229a756a835e0edc26700677e4fa67de3d2f6ac0d96a2.svg)\n\nand by the power rule for logarithms, we can write this as\n\n![](images/c9/c9b146d550ef068823a4ee4b9f63eea89f46d6ceecedf0ad4baa6462f11d9127.svg)\n\nNow, the following result can be used (we'll prove it in the subsequent topics):\n\n![](images/ce/cedfc7ab127ac8b34cd72b21e8c3e527541e054721324d9d948d6df123cd61e0.svg)\n\nTherefore, we conclude that\n\n![](images/58/5880fb665abda7f3cef4ad7425c99c43b16e84c448c7b9e22ff32f76e36df87c.svg)\n\nas required." :tutorial/id #uuid "551a7005-80c0-5cee-b28e-f3b565aaf250" :tutorial/math-academy-id 13257 :tutorial/title "Justifying the Second Rule"} :step/id #uuid "91e627df-d8f4-581a-bf44-76bf1bb88674" :step/math-academy-id 461037}] :activity/title "Differentiating Exponential Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186096892}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/expected-seconds 270.0 :activity/first-step {:db/id #edb/ref 17592186479999} :activity/id #uuid "f1fdb787-c3cd-4a39-a6e0-2e71d411593d" :activity/scope {:db/id #edb/ref 17592186048749 :topic/id #uuid "bad8d582-b827-501b-8a06-58b93e5ecdb0" :topic/math-academy-id 1114} :activity/steps [{:db/id #edb/ref 17592186479999 :step/content {:db/id #edb/ref 17592186235471 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58606740-b081-5671-ab93-5b28309b7d77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{x}+2x+1" :db/id #edb/ref 17592186234683}] :answer-field/correct {:db/id #edb/ref 17592186234683} :answer-field/id #uuid "d0bd4a86-aed0-5919-98b7-ad23d53bddbe" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186235226}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cfc04756-ffae-5a03-8a05-d0ea5dfb5207" :question/math-academy-id "q-167694" :question/problem "For $x<1,$ ${f}^{′}(x)=$\n\n                            \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        ." :question/worked-solution "For $x<1,$ we use the expression $f(x)={e}^{x}+{x}^{2}+x,$ which is differentiable.\n\nUsing the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{x}+{x}^{2}+x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({e}^{x})+\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & ={e}^{x}+2x+1.\\end{aligned}\n$$"} :step/expected-seconds 90.0 :step/id #uuid "33ad21e0-2609-477f-8599-5b745a6fabda" :step/next {:db/id #edb/ref 17592186480000}} {:db/id #edb/ref 17592186480000 :step/content {:db/id #edb/ref 17592186479989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a9d9676-be2e-55f1-8608-d21cf8ae6b8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\ln{\\left(5 \\right)}}{5} + \\ln{\\left(2 \\right)} + 6" :db/id #edb/ref 17592186479944}] :answer-field/correct {:db/id #edb/ref 17592186479944} :answer-field/id #uuid "c6f7efb5-5352-5998-97f1-7e7dd561f8f9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186479984}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "cf41a068-fd0d-5f4b-9f3b-52ecb794226b" :question/problem "Given that $f(x)=1\\cdot {5}^{x}+2\\cdot {2}^{x}-3x^2+1$, find the instantaneous rate of change at $x=-1.$\n\n{{field-1}}" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}f'(x)&=\\frac{\\text{d}}{\\text{d}x}(1\\cdot {5}^{x}+2\\cdot {2}^{x}-3x^2+1) \\\\ &=1\\frac{\\text{d}}{\\text{d}x}({5}^{x})+2\\frac{\\text{d}}{\\text{d}x}({2}^{x})-3\\frac{\\text{d}}{\\text{d}x}(x^2)+\\frac{\\text{d}}{\\text{d}x}(1) \\\\ &=1({5}^{x}\\ln(5))+2({2}^{x}\\ln(2))-3(2x)+0 \\\\ &=1\\ln(5)\\cdot {5}^{x}+2\\ln(2)\\cdot {2}^{x}-6x.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=-1$ is\n\n$$\n\\begin{aligned}f'(-1)&=1\\ln(5)\\cdot {5}^{(-1)}+2\\ln(2)\\cdot {2}^{(-1)}-6(-1) \\\\ &=1(\\frac{1}{5})\\ln(5)+2(\\frac{1}{2})\\ln(2)-(6)(-1) \\\\ &=\\frac{\\ln{\\left(5 \\right)}}{5} + \\ln{\\left(2 \\right)} + 6.\\end{aligned}\n$$"} :step/expected-seconds 90.0 :step/id #uuid "f8f4561f-e1dc-46f4-bf5b-373c5c3b7779" :step/next {:db/id #edb/ref 17592186480001}} {:db/id #edb/ref 17592186480001 :step/content {:db/id #edb/ref 17592186272086 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1859eb59-5659-5101-b949-46d66d579831" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8e" :db/id #edb/ref 17592186269472} {:answer/id #uuid "1c0e81a7-1d07-50d3-b00e-dd0c50955d37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2+6e" :db/id #edb/ref 17592186269501} {:answer/id #uuid "2d71f9f8-72d8-5409-b4ca-0645cd6983b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+6e" :db/id #edb/ref 17592186269679} {:answer/id #uuid "c2ca486a-dc13-5bb9-932e-532847144371" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6e" :db/id #edb/ref 17592186270990} {:answer/id #uuid "c5a796d4-403d-5aad-82ff-004acd0b4a0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186271012}] :answer-field/correct {:db/id #edb/ref 17592186271012} :answer-field/id #uuid "d0c8b5dd-9fdc-5213-98ff-f269c094b6e2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186271882}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "578adda7-12d4-5f1e-a8c7-f591ce6d42cb" :question/math-academy-id "q-140432" :question/problem "Given that $f(x)={x}^{2}+2x+6{e}^{x}$, find the slope of the tangent at $x=0.$" :question/worked-solution "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}+2x+6{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(2x)+\\frac{\\text{d}}{\\text{d}x}(6{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})+2\\frac{\\text{d}}{\\text{d}x}(x)+6\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =2x+2+6{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(2x+2+6{e}^{x})\\,|}_{x=0} \\\\  & =2\\cdot 0+2+6\\cdot {e}^{0} \\\\  & =2+6\\cdot 1 \\\\  & =8.\\end{aligned}\n$$"} :step/expected-seconds 90.0 :step/id #uuid "6c7a0ccc-737a-46dc-a6da-45334c4508ff" :step/next {:db/id #edb/ref 17592186480002}} {:db/id #edb/ref 17592186480002 :step/content {:db/id #edb/ref 17592186479960 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e51092c-d3e1-5116-8c4b-6104b8f6691c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln 6+5" :db/id #edb/ref 17592186479945} {:answer/id #uuid "1f3f4162-2d0a-5c5d-82e4-1a26519c89c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186479947} {:answer/id #uuid "438a7220-979d-55dc-93b4-36a1d239218c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln 6+5e" :db/id #edb/ref 17592186479954} {:answer/id #uuid "556ea93d-c41f-51e1-a3d5-3a153a74e606" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln 6" :db/id #edb/ref 17592186479963} {:answer/id #uuid "c713293d-b983-5584-b151-359e1e3a8af8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186479985}] :answer-field/correct {:db/id #edb/ref 17592186479945} :answer-field/id #uuid "380060b1-e35e-58d8-84f1-6cb9bb1b875b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186479950}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "50148e2c-17f0-5238-804f-16d18ed920ad" :question/problem "Given that $f(x)={6}^{x}+5{e}^{x}$, find the instantaneous rate of change at $x=0.$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({6}^{x}+5{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})+\\frac{\\text{d}}{\\text{d}x}(5{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})+5\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & ={6}^{x}\\ln 6+5{e}^{x}\\,.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={({6}^{x}\\ln 6+5{e}^{x})|}_{x=0} \\\\  & ={6}^{0}\\ln 6+5{e}^{0} \\\\  & =1\\cdot \\ln 6+5\\cdot 1 \\\\  & =\\ln 6+5.\\end{aligned}\n$$"} :step/expected-seconds 90.0 :step/id #uuid "ce63fcf4-9592-481e-982a-405b6f12d7be" :step/next {:db/id #edb/ref 17592186480003}} {:db/id #edb/ref 17592186480003 :step/content {:db/id #edb/ref 17592186479993 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27addd41-1b34-5638-873b-b749efd9cbcc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}(9)+2" :db/id #edb/ref 17592186479948}] :answer-field/correct {:db/id #edb/ref 17592186479948} :answer-field/id #uuid "e1395a30-edad-54d2-9382-c62a8875aa3f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186479991}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ec00e600-a612-5a76-94ca-79ecaa3d171e" :question/problem "Given that $f(x)={9}^{x}-1{x}^{3}+2x-1$, the slope of the tangent at $x=0$ is{{field-1}}." :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({9}^{x}-1{x}^{3}+2x-1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({9}^{x})-\\frac{\\text{d}}{\\text{d}x}(1{x}^{3})+\\frac{\\text{d}}{\\text{d}x}(2x)-\\frac{\\text{d}}{\\text{d}x}(6) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({9}^{x})-1\\frac{\\text{d}}{\\text{d}x}({x}^{3})+2\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(6) \\\\  & =\\ln (9)\\cdot {9}^{x}-1(3{x}^{2})+2(1)-0 \\\\  & =\\ln (9)\\cdot {9}^{x}-3{x}^{2}+2.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(\\ln (9)\\cdot {9}^{x}-3{x}^{2}+2)|}_{x=0} \\\\  & =\\ln (9)\\cdot {9}^{0}-3(0)^{2}+2 \\\\  & =\\ln (9)\\cdot 1-0+2 \\\\  & =\\ln (9)+2.\\end{aligned}\n$$"} :step/expected-seconds 90.0 :step/id #uuid "fab70c36-4b77-4dae-b226-e0c0429677ee"}] :activity/title "Review: Differentiating Exponential Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186479998}]}
