#{[{:db/id #edb/ref 17592186096410 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186096610 :knowledge-point/id #uuid "bb40a0ff-c3b5-512d-a436-cc2fce456008" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Constant"}] :question/id #uuid "8e4367b2-f7bc-5588-b30b-d612915e3e68" :question/math-academy-id "e-3624" :question/problem "Given that $f(x)=3e^x + \\ln 3$, find $f'(x).$" :question/worked-solution "The derivative of $e^x$ is just $e^x$ itself. On the other hand, $\\ln 3$ is a constant, so its derivative is $0.$\n\nUsing the addition rule, then, we have \n\n$$\n\\eqalign{\nf'(x) &= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(3e^x + \\ln 3\\right)\\\n                                                  &= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left( 3e^x\\right) +  \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left( \\ln 3 \\right)\\\n                                                  &= 3\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(e^x\\right) + 0\\\n                                                  &= 3 e^x.\n}\n$$"}] [{:db/id #edb/ref 17592186096411 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186096611 :knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/id #uuid "48334c0c-a49e-5dfb-9f8a-8caa0c22d1f9" :question/math-academy-id "e-3625" :question/problem "Given that $f(x)=4e^x+ 3x^4 - x^2,$ find $f'(x).$" :question/worked-solution "Using the addition and the power rules, we get\n\n$$\n\\eqalign{ \n                          f'(x)             &= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(4e^x+3x^{4} - x^2 \\right)\\\n                                             &= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(4e^x\\right)+\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(3x^{4}\\right) -\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(x^{2}\\right) \\\n\t\t\t\t\t     &= 4\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(e^x\\right)+3\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(x^{4}\\right) - 2x \\\t\t\t\n                                             &=  4 e^x+  3 \\cdot 4x^{3} - 2x \\\n                                             &=  4 e^x+  12x^{3} - 2x.\n}\n$$"}] [{:db/id #edb/ref 17592186096412 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186096612 :knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/id #uuid "16b1a91c-ae83-5e6b-a11d-bb9d78e4d218" :question/math-academy-id "e-3626" :question/problem "Given that $f(x)=3 \\cdot 2^x$, find $f'(x).$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\eqalign{\n\t\tf'(x)      &= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(3 \\cdot 2^x\\right) \\\n                            &= 3 \\cdot \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(2^x\\right) \\\n                            &=  3 \\cdot 2^{x}\\ln(2) \\\n                            &=  3 \\ln(2) \\cdot 2^{x}.\n\t}\n$$"}] [{:db/id #edb/ref 17592186253334 :knowledge-point/_questions [{:db/id #edb/ref 17592186096612 :knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3232bdcf-d781-5e59-bb5b-56c10f0d7fa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}\\operatorname{ln}⁡6-10{x}^{2}+6x" :db/id #edb/ref 17592186250976} {:answer/id #uuid "37865371-b061-54aa-9810-81e59d0b835b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}-10{x}^{2}+6x-19" :db/id #edb/ref 17592186251009} {:answer/id #uuid "3d09661f-ce26-5e19-a8b8-2ae50263662e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}\\operatorname{ln}⁡6-10x+6" :db/id #edb/ref 17592186251060 :task-item/_responses [{:db/id #edb/ref 17592186409262}]} {:answer/id #uuid "9007950f-ce55-5f0c-a1f6-d3963f0294f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}-10x+6" :db/id #edb/ref 17592186251775} {:answer/id #uuid "bbf32e0c-8341-5060-b67e-c44870ab4cd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}\\operatorname{ln}⁡6-10{x}^{2}+6x-19" :db/id #edb/ref 17592186252214}] :answer-field/correct {:answer/id #uuid "3d09661f-ce26-5e19-a8b8-2ae50263662e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{x}\\operatorname{ln}⁡6-10x+6" :db/id #edb/ref 17592186251060} :answer-field/id #uuid "e849ca6e-9bda-5244-a669-0f22826facaa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253210}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "50678a5c-afcb-522f-98fb-80e9680afca6" :question/math-academy-id "q-11735" :question/problem "Given that $f(x)={6}^{x}-5{x}^{2}+6x-19$, find ${f}^{′}(x).$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({6}^{x}-5{x}^{2}+6x-19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-\\frac{\\text{d}}{\\text{d}x}(5{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(6x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-5\\frac{\\text{d}}{\\text{d}x}({x}^{2})+6\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =\\operatorname{ln}⁡6\\cdot {6}^{x}-5(2x)+6(1)-0 \\\\  & ={6}^{x}\\operatorname{ln}⁡6-10x+6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186524984 :knowledge-point/_questions [{:db/id #edb/ref 17592186096612 :knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0caca0a6-1e08-5ddf-bb83-3bec4e2484b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡2-2e" :db/id #edb/ref 17592186524404} {:answer/id #uuid "29c8efb8-570d-51ab-b67b-d69348dbbf78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2-4e" :db/id #edb/ref 17592186524458} {:answer/id #uuid "83f09c8c-036c-5988-8f2a-b6776804e7ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186524587} {:answer/id #uuid "ddfba5da-de74-5003-94d8-2da062180d72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡2+e" :db/id #edb/ref 17592186524760} {:answer/id #uuid "f466827c-355f-5cbc-b5b1-a9351be94db5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡2" :db/id #edb/ref 17592186524814}] :answer-field/correct {:answer/id #uuid "f466827c-355f-5cbc-b5b1-a9351be94db5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡2" :db/id #edb/ref 17592186524814} :answer-field/id #uuid "552b41e9-7a71-51a8-a342-aa77b81b7fa3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524874}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "46572da3-e0a7-57d7-a2f6-062b0d2adadb" :question/math-academy-id "q-140439" :question/problem "Given that $f(x)=4\\cdot {2}^{x}+{x}^{3}-{e}^{2}$,  find the slope of the tangent at $x=0.$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4\\cdot {2}^{x}+{x}^{3}-{e}^{2}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4\\cdot {2}^{x})+\\frac{\\text{d}}{\\text{d}x}({x}^{3})+\\frac{\\text{d}}{\\text{d}x}(-{e}^{2}) \\\\  & =4\\cdot {2}^{x}\\operatorname{ln}⁡2+\\frac{\\text{d}}{\\text{d}x}({x}^{3})+0 \\\\  & =4\\cdot {2}^{x}\\operatorname{ln}⁡2+3{x}^{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & =(4\\cdot {2}^{x}\\operatorname{ln}⁡2+3{x}^{2}){|}_{x=0} \\\\  & =4\\cdot {2}^{0}\\operatorname{ln}⁡2+3\\cdot {0}^{2} \\\\  & =4\\cdot 1\\cdot \\operatorname{ln}⁡2+3\\cdot 0 \\\\  & =4\\operatorname{ln}⁡2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186525017 :knowledge-point/_questions [{:db/id #edb/ref 17592186096610 :knowledge-point/id #uuid "bb40a0ff-c3b5-512d-a436-cc2fce456008" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25800a6b-d642-5c57-b91d-e8e45649680a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186524450}] :answer-field/correct {:answer/id #uuid "25800a6b-d642-5c57-b91d-e8e45649680a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186524450} :answer-field/id #uuid "ff484f27-c600-5f6e-a8a7-362f170f3f67" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186524955}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9cb89f9e-c6cf-5b21-994c-7efe5115b691" :question/math-academy-id "q-304018" :question/problem "Given that $f(x)=4{e}^{x}+17$, the slope of the tangent line at $x=\\operatorname{ln}⁡3$ is{{field-1}}." :question/worked-solution "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $17$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}+17) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(17) \\\\  & =4\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =4{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=\\operatorname{ln}⁡3$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=\\operatorname{ln}⁡3} & ={(4{e}^{x})\\,|}_{x=\\operatorname{ln}⁡3} \\\\  & =4{e}^{\\operatorname{ln}⁡3} \\\\  & =4\\cdot 3 \\\\  & =12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297289 :knowledge-point/_questions [{:db/id #edb/ref 17592186096611 :knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b89210db-d5da-5a48-8355-741becb1873c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42+\\frac{2}{e}" :db/id #edb/ref 17592186296232} {:answer/id #uuid "c4f887ee-f564-4711-a252-4f52754bf8ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42x^6+2e^{x}" :db/id #edb/ref 17592186409338 :task-item/_responses [{:db/id #edb/ref 17592186409255}]}] :answer-field/correct {:answer/id #uuid "b89210db-d5da-5a48-8355-741becb1873c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42+\\frac{2}{e}" :db/id #edb/ref 17592186296232} :answer-field/id #uuid "ca439fbc-124d-5dae-b8b3-a85cb6575e03" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186297054}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0f66d07e-3ca1-595a-b1d7-b4c775329676" :question/math-academy-id "q-304035" :question/problem "Given that $f(x)=6{x}^{7}+2{e}^{x}$, the exact value of the slope of the tangent line at $x=-1$ is{{field-1}}." :question/worked-solution "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(6{x}^{7}+2{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(6{x}^{7})+\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}) \\\\  & =6\\frac{\\text{d}}{\\text{d}x}({x}^{7})+2\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =6(7{x}^{6})+2{e}^{x} \\\\  & =42{x}^{6}+2{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=-1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-1} & ={(42{x}^{6}+2{e}^{x})\\,|}_{x=-1} \\\\  & =42(-1)^{6}+2{e}^{-1} \\\\  & =42\\cdot 1+\\frac{2}{e} \\\\  & =42+\\frac{2}{e}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297290 :knowledge-point/_questions [{:db/id #edb/ref 17592186096612 :knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3554bc38-45ed-5174-b2e0-b7a82dde78d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}(8){8}^{x}+12" :db/id #edb/ref 17592186295565} {:answer/id #uuid "f54d10f9-87ce-520f-be5c-16afa4e5c6a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\cdot8^{x}\\ln(8)+12" :db/id #edb/ref 17592186524815}] :answer-field/correct {:answer/id #uuid "f54d10f9-87ce-520f-be5c-16afa4e5c6a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\cdot8^{x}\\ln(8)+12" :db/id #edb/ref 17592186524815} :answer-field/id #uuid "0a6fdabb-ec35-5bee-8e6f-6b6e93c3ccd5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296661}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4df22161-f9b7-5077-b623-7a70a19c609f" :question/math-academy-id "q-304038" :question/problem "Given that $f(x)=3\\cdot {8}^{x}+12x+10$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {8}^{x}+12x+10) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {8}^{x})+\\frac{\\text{d}}{\\text{d}x}(12x)+\\frac{\\text{d}}{\\text{d}x}(10) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}({8}^{x})+12\\frac{\\text{d}}{\\text{d}x}(x)+\\frac{\\text{d}}{\\text{d}x}(10) \\\\  & =3(\\operatorname{ln}⁡(8){8}^{x})+12(1)+0 \\\\  & =3\\operatorname{ln}⁡(8){8}^{x}+12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186524982 :knowledge-point/_questions [{:db/id #edb/ref 17592186096610 :knowledge-point/id #uuid "bb40a0ff-c3b5-512d-a436-cc2fce456008" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53709e9e-7e4f-52ba-ab20-e6b13619abb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9e^{x}" :db/id #edb/ref 17592186524525}] :answer-field/correct {:answer/id #uuid "53709e9e-7e4f-52ba-ab20-e6b13619abb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9e^{x}" :db/id #edb/ref 17592186524525} :answer-field/id #uuid "321e32b9-7ce0-5a4e-9141-f36ce7923b8b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186524862}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "451b7f5e-73c7-5775-8944-779b29e93099" :question/math-academy-id "q-340053" :question/problem "Given that $f(x)=9{e}^{x}-11,$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $-11$ is a constant, so its derivative is $0.$\n\nUsing the addition rule, then, we have \n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(9{e}^{x}-11) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(9{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(-11) \\\\  & =9\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =9{e}^{x}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186525040 :knowledge-point/_questions [{:db/id #edb/ref 17592186096611 :knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13a8ae5e-2b27-5896-8bf1-0e1c78f29b99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)=4{e}^{x}-5{x}^{2}" :db/id #edb/ref 17592186524417} {:answer/id #uuid "a76babff-69cc-5977-a846-865ec261880c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)={e}^{x}-9x" :db/id #edb/ref 17592186524648} {:answer/id #uuid "abe87bd5-4230-5c4c-a3fa-4e14394a9de6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)=4{e}^{x}-10x-4" :db/id #edb/ref 17592186524657} {:answer/id #uuid "c7f7e59c-61a8-51bc-b810-b28f0b8fe05c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)={e}^{x}-15{x}^{2}-4" :db/id #edb/ref 17592186524706} {:answer/id #uuid "f62c6064-bf12-5a1a-94a5-4dec0bfb8ced" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)=4{e}^{x}-15{x}^{2}" :db/id #edb/ref 17592186524817}] :answer-field/correct {:answer/id #uuid "f62c6064-bf12-5a1a-94a5-4dec0bfb8ced" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)=4{e}^{x}-15{x}^{2}" :db/id #edb/ref 17592186524817} :answer-field/id #uuid "cb8c7399-82f9-563a-b941-a6a1414975f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524926}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c8792aa5-0567-5ee4-a5c8-0188d2815575" :question/math-academy-id "q-71061" :question/problem "Given that $f(x)=4{e}^{x}-5{x}^{3}-4$, find ${f}^{′}(x).$" :question/worked-solution "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}-5{x}^{3}-4) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(5{x}^{3})-\\frac{\\text{d}}{\\text{d}x}(4) \\\\  & =4\\frac{\\text{d}}{\\text{d}x}({e}^{x})-5\\frac{\\text{d}}{\\text{d}x}({x}^{3})-\\frac{\\text{d}}{\\text{d}x}(4) \\\\  & =4{e}^{x}-5(3{x}^{2})-0 \\\\  & =4{e}^{x}-15{x}^{2}.\\end{aligned}\n$$"}]}
