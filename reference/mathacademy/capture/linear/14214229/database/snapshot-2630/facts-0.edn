x}^{7})+2\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =6(7{x}^{6})+2{e}^{x} \\\\  & =42{x}^{6}+2{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=-1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-1} & ={(42{x}^{6}+2{e}^{x})\\,|}_{x=-1} \\\\  & =42(-1)^{6}+2{e}^{-1} \\\\  & =42\\cdot 1+\\frac{2}{e} \\\\  & =42+\\frac{2}{e}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186297290 #edb/ref 1068 #edb/ref 17592186296661 #edb/ref 17592186045417] [17592186297290 #edb/ref 1069 "q-304038" #edb/ref 17592186045417] [17592186297290 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186297290 #edb/ref 1071 "Given that $f(x)=3\\cdot {8}^{x}+12x+10$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" #edb/ref 17592186045417] [17592186297290 #edb/ref 1072 #uuid "4df22161-f9b7-5077-b623-7a70a19c609f" #edb/ref 17592186045417] [17592186297290 #edb/ref 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {8}^{x}+12x+10) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {8}^{x})+\\frac{\\text{d}}{\\text{d}x}(12x)+\\frac{\\text{d}}{\\text{d}x}(10) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}({8}^{x})+12\\frac{\\text{d}}{\\text{d}x}(x)+\\frac{\\text{d}}{\\text{d}x}(10) \\\\  & =3(\\operatorname{ln}⁡(8){8}^{x})+12(1)+0 \\\\  & =3\\operatorname{ln}⁡(8){8}^{x}+12.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186409255 #edb/ref 1146 #edb/ref 17592186409338 #edb/ref 17592186045416] [17592186409255 #edb/ref 1148 19.056 #edb/ref 17592186045443] [17592186409255 #edb/ref 1156 #edb/ref 17592186409256 #edb/ref 17592186045443] [17592186409255 #edb/ref 1158 #edb/ref 17592186297289 #edb/ref 17592186045443] [17592186409255 #edb/ref 1161 #uuid "5666f4fd-29fb-49fa-86c1-bbbc0bd3ca29" #edb/ref 17592186045443] [17592186409255 #edb/ref 1162 #edb/ref 17592186045572 #edb/ref 17592186045443] [17592186409262 #edb/ref 1146 #edb/ref 17592186251060 #edb/ref 17592186045416] [17592186409262 #edb/ref 114