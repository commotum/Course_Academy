6Q119 437 138 438T167 441T178 442H181V402Q181 364 182 364T187 369T199 384T218 402T247 421T285 437Q305 442 336 442Q450 438 463 329Q464 322 464 190V104Q464 66 466 59T477 49Q498 46 526 46H542V0H534L510 1Q487 2 460 2T422 3Q319 3 310 0H302V46H318Q379 46 379 62Q380 64 380 200Q379 335 378 343Q372 371 358 385T334 402T308 404Q263 404 229 370Q202 343 195 315T187 232V168V108Q187 78 188 68T191 55T200 49Q221 46 249 46H265V0H257L234 1Q210 2 183 2T145 3Q42 3 33 0H25V46H41Z\"></path>\n<path stroke-width=\"1\" id=\"E5-MJMAIN-22C5\" d=\"M78 250Q78 274 95 292T138 310Q162 310 180 294T199 251Q199 226 182 208T139 190T96 207T78 250Z\"></path>\n<path stroke-width=\"1\" id=\"E5-MJMAIN-31\" d=\"M213 578L200 573Q186 568 160 563T102 556H83V602H102Q149 604 189 617T245 641T273 663Q275 666 285 666Q294 666 302 660V361L303 61Q310 54 315 52T339 48T401 46H427V0H416Q395 3 257 3Q121 3 100 0H88V46H114Q136 46 152 46T177 47T193 50T201 52T207 57T213 61V578Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"1249\" height=\"60\" x=\"0\" y=\"220\"></rect>\n <use xlink:href=\"#E5-MJMAIN-64\" x=\"346\" y=\"676\"></use>\n<g transform=\"translate(60,-716)\">\n <use xlink:href=\"#E5-MJMAIN-64\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMATHI-78\" x=\"556\" y=\"0\"></use>\n</g>\n</g>\n<g transform=\"translate(1489,0)\">\n <use xlink:href=\"#E5-MJMAIN-28\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(389,0)\">\n <use xlink:href=\"#E5-MJMATHI-65\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E5-MJMATHI-78\" x=\"659\" y=\"583\"></use>\n</g>\n <use xlink:href=\"#E5-MJMAIN-29\" x=\"1360\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E5-MJMAIN-3D\" x=\"3517\" y=\"0\"></use>\n<g transform=\"translate(4573,0)\">\n <use xlink:href=\"#E5-MJMATHI-65\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E5-MJMATHI-78\" x=\"659\" y=\"583\"></use>\n</g>\n<g transform=\"translate(5711,0)\">\n <use xlink:href=\"#E5-MJMAIN-6C\"></use>\n <use xlink:href=\"#E5-MJMAIN-6E\" x=\"278\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E5-MJMATHI-65\" x=\"6713\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-3D\" x=\"7457\" y=\"0\"></use>\n<g transform=\"translate(8513,0)\">\n <use xlink:href=\"#E5-MJMATHI-65\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E5-MJMATHI-78\" x=\"659\" y=\"583\"></use>\n</g>\n <use xlink:href=\"#E5-MJMAIN-22C5\" x=\"9707\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-31\" x=\"10207\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-3D\" x=\"10986\" y=\"0\"></use>\n<g transform=\"translate(12042,0)\">\n <use xlink:href=\"#E5-MJMATHI-65\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E5-MJMATHI-78\" x=\"659\" y=\"583\"></use>\n</g>\n</g>\n</svg></span></p>\n\n        </div>",
      "errors": [],
