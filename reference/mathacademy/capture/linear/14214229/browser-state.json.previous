    "q-304038": {
      "dom_id": "step-q304038",
      "name": "Question 7",
      "problem": "Given that $f(x)=3\\cdot {8}^{x}+12x+10$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}",
      "worked_solution": "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {8}^{x}+12x+10) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {8}^{x})+\\frac{\\text{d}}{\\text{d}x}(12x)+\\frac{\\text{d}}{\\text{d}x}(10) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}({8}^{x})+12\\frac{\\text{d}}{\\text{d}x}(x)+\\frac{\\text{d}}{\\text{d}x}(10) \\\\  & =3(\\operatorname{ln}⁡(8){8}^{x})+12(1)+0 \\\\  & =3\\operatorname{ln}⁡(8){8}^{x}+12.\\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "field-1",
