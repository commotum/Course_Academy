mi>x</mi><mo stretchy=\"false\">)</mo></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mtext>d</mtext><mrow><mtext>d</mtext><mi>x</mi></mrow></mfrac></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>9</mn><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>x</mi></mrow></msup><mo>−</mo><mn>11</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mtext>d</mtext><mrow><mtext>d</mtext><mi>x</mi></mrow></mfrac></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>9</mn><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>x</mi></mrow></msup><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mtext>d</mtext><mrow><mtext>d</mtext><mi>x</mi></mrow></mfrac></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mo>−</mo><mn>11</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mn>9</mn><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mtext>d</mtext><mrow><mtext>d</mtext><mi>x</mi></mrow></mfrac></mstyle><mo stretchy=\"false\">(</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>x</mi></mrow></msup><mo stretchy=\"false\">)</mo><mo>+</mo><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>9</mn><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>x</mi></mrow></msup></mpadded></mstyle><mo>.</mo></mtd></mtr></mtable></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
