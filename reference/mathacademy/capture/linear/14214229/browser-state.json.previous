  "live_records": {
    "q-340053": {
      "dom_id": "step-q340053",
      "name": "Question 1",
      "problem": "Given that $f(x)=9{e}^{x}-11,$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}",
      "worked_solution": "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $-11$ is a constant, so its derivative is $0.$\n\nUsing the addition rule, then, we have \n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(9{e}^{x}-11) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(9{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(-11) \\\\  & =9\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =9{e}^{x}.\\end{aligned}\\end{aligned}\n$$",
      "calculator_instructions": "",
