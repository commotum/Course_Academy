d><mtd><mi></mi><mo>=</mo><msup><mn>180</mn><mo>∘</mo></msup></mtd></mtr><mtr><mtd><mi>m</mi><mi mathvariant=\"normal\">∠</mi><mrow data-mjx-texclass=\"ORD\"><mi>H</mi><mi>C</mi><mi>A</mi></mrow><mo>+</mo><msup><mn>150</mn><mo>∘</mo></msup></mtd><mtd><mi></mi><mo>=</mo><msup><mn>180</mn><mo>∘</mo></msup></mtd></mtr><mtr><mtd><mi>m</mi><mi mathvariant=\"normal\">∠</mi><mrow data-mjx-texclass=\"ORD\"><mi>H</mi><mi>C</mi><mi>A</mi></mrow></mtd><mtd><mi></mi><mo>=</mo><msup><mn>30</mn><mo>∘</mo></msup><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
