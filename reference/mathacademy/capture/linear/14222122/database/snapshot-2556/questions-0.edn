#{[{:db/id #edb/ref 17592186534970 :knowledge-point/_questions [{:db/id #edb/ref 17592186059793 :knowledge-point/id #uuid "7b024b05-1efe-594e-9a7e-6d51a28c0c78" :knowledge-point/title "Solving Logarithmic Equations by First Rearranging the Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bb7199e-65dd-5bd9-a79d-442fc232faa9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "425" :db/id #edb/ref 17592186534288} {:answer/id #uuid "6f1ae7c7-2dee-55e1-8b00-d4531dcc5579" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "362" :db/id #edb/ref 17592186534497} {:answer/id #uuid "cf067dd4-c8bc-5704-b97b-05088b2a487b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "343" :db/id #edb/ref 17592186534729} {:answer/id #uuid "e8cde56b-bba5-5c32-a43d-c79e4c3cdd75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "371" :db/id #edb/ref 17592186534782} {:answer/id #uuid "f3a6a46f-1b59-5281-b140-01c12fd66cf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "471" :db/id #edb/ref 17592186534807}] :answer-field/correct {:answer/id #uuid "f3a6a46f-1b59-5281-b140-01c12fd66cf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "471" :db/id #edb/ref 17592186534807} :answer-field/id #uuid "25a7aacd-0ade-5f57-a8d3-34286e4a41cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534854}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "00bde4d7-2128-56ee-87f4-eb818e9cb4e3" :question/math-academy-id "q-100626" :question/problem "If $-16{log}_{7}⁡(x-128)=-48$, then $x=$" :question/worked-solution "First, we rearrange our equation to isolate the logarithmic term:\n\n$$\n\\begin{aligned}-16{log}_{7}⁡(x-128) & =-48 \\\\ {log}_{7}⁡(x-128) & =\\frac{-48}{-16} \\\\ {log}_{7}⁡(x-128) & =3\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $7,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{7}⁡(x-128) & =3 \\\\ {7}^{{log}_{7}⁡(x-128)} & ={7}^{3}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${7}^{{log}_{7}⁡(x-128)}=x-128.$\n\nTherefore,\n\n$$\n\\begin{aligned}x-128 & ={7}^{3} \\\\ x-128 & =343 \\\\ x & =471.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059991 :knowledge-point/_questions [{:db/id #edb/ref 17592186059793 :knowledge-point/id #uuid "7b024b05-1efe-594e-9a7e-6d51a28c0c78" :knowledge-point/title "Solving Logarithmic Equations by First Rearranging the Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de1991f6-b528-5998-88b7-54673d5bf939" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186056305} {:answer/id #uuid "0b104d48-c89f-50d8-aa70-08caaff8e170" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49" :db/id #edb/ref 17592186056306} {:answer/id #uuid "299ea40c-ff2e-55e3-9ec0-9f7d8d31dedf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186056307} {:answer/id #uuid "3138227c-8c5f-52fb-8708-ee41e7e743dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186056308} {:answer/id #uuid "34747a1f-7188-5548-9064-656c70f5fa08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186056309}] :answer-field/correct {:answer/id #uuid "de1991f6-b528-5998-88b7-54673d5bf939" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186056305} :answer-field/id #uuid "d6ac5b0b-cfa5-5e6b-a1be-33551e6bff78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056304}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "38edf6bf-dbb8-50a2-9424-49395fd3a840" :question/math-academy-id "q-1120" :question/problem "If $\\frac{{log}_{7}⁡(x+1)}{2}=1$, then $x=$" :question/worked-solution "First, we rearrange our equation to isolate the logarithmic term:\n\n$$\n\\begin{aligned}\\frac{{log}_{7}⁡(x+1)}{2} & =1 \\\\ {log}_{7}⁡(x+1) & =2\\end{aligned}\n$$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $7,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{7}⁡(x+1) & =2 \\\\ {7}^{{log}_{7}⁡(x+1)} & ={7}^{2}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${7}^{{log}_{7}⁡(x+1)}=x+1.$\n\nTherefore,\n\n$$\n\\begin{aligned}x+1 & ={7}^{2} \\\\ x+1 & =49 \\\\ x & =48.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233679 :knowledge-point/_questions [{:db/id #edb/ref 17592186059695 :knowledge-point/id #uuid "98fb5d45-5215-506c-8b2a-99aaadb6631c" :knowledge-point/title "Solving Logarithmic Equations With Linear Arguments"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13d98f75-ec98-55b8-bd6d-557ed859ed11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{83}{4}" :db/id #edb/ref 17592186534309} {:answer/id #uuid "48c860bd-e06a-5669-aacd-322bd3817f4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{68}{3}" :db/id #edb/ref 17592186534403} {:answer/id #uuid "51a1eea1-22ad-5e39-840b-a993eeed3ec9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186534427} {:answer/id #uuid "c020f3d7-85a1-5452-a318-b9aba6af4d51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186534693} {:answer/id #uuid "e55c01a0-412d-5e01-991f-926ab7486bb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{62}{3}" :db/id #edb/ref 17592186534771}] :answer-field/correct {:answer/id #uuid "c020f3d7-85a1-5452-a318-b9aba6af4d51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186534693} :answer-field/id #uuid "2b66e190-3a44-5bcd-8fa8-92a479622c92" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534857}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "96612b32-04f7-536b-8298-ef008f709116" :question/math-academy-id "q-25135" :question/problem "Find $x$ such that ${log}_{4}⁡(3x-2)=3.$" :question/worked-solution "To remove the logarithm, we exponentiate both sides of the equation. The base of the logarithm is $4,$ so we use this base for the exponentiation as well:\n\n$$\n\\begin{aligned}{log}_{4}⁡(3x-2) & =3 \\\\ {4}^{{log}_{4}⁡(3x-2)} & ={4}^{3}\\end{aligned}\n$$\n\nNow, since exponentiation is the inverse function of the logarithm, we get ${4}^{{log}_{4}⁡(3x-2)}=3x-2.$\n\nTherefore,\n\n$$\n\\begin{aligned}3x-2 & ={4}^{3} \\\\ 3x-2 & =64 \\\\ 3x & =66 \\\\ x & =22.\\end{aligned}\n$$"}]}
