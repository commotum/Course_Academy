&=  \\\\\n\\frac{1}{16} \\cdot x^{-8} \\cdot y^{4} &=  \\\\\n\\frac{1}{16} \\cdot \\frac{1}{x^{8}} \\cdot y^{4} &=  \\\\\n&= \\frac{y^{4}}{16x^{8}}\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186105850 #edb/ref 1037 #edb/ref 17592186049861 #edb/ref 17592186045417] [17592186105850 #edb/ref 1037 #edb/ref 17592186051009 #edb/ref 17592186045417] [17592186105850 #edb/ref 1038 #edb/ref 17592186106200 #edb/ref 17592186045417] [17592186105850 #edb/ref 1038 #edb/ref 17592186106201 #edb/ref 17592186045417] [17592186105850 #edb/ref 1039 "Using the Power of Product Rule with a Positive Power" #edb/ref 17592186045417] [17592186105850 #edb/ref 1041 #edb/ref 17592186105441 #edb/ref 17592186045417] [17592186105850 #edb/ref 1042 #uuid "8b4ce383-37b4-5d5a-80ef-3886605bd56f" #edb/ref 17592186045417] [17592186105851 #edb/ref 1037 #edb/ref 17592186050208 #edb/ref 17592186045417] [17592186105851 #edb/ref 1038 #edb/ref 17592186106276 #edb/ref 17592186045417] [17592186105851 #edb/ref 1038 #edb/ref 17592186106385 #edb/ref 17592186045417] [17592186105851 #edb/ref 1039 "Using the Power of Product Rule with a Negative Power" #edb/ref 17592186045417] [17592186105851 #edb/ref 1041 #edb/ref 17592186105442 #edb/ref 17592186045417] [17592186105851 #edb/ref 1042 #uuid "85159201-5cf2-53da-91bf-ba7ef462a4fa" #edb/ref 17592186045417] [17592186105852 #edb/ref 1038 #edb/ref 17592186106250 #edb/ref 17592186045417] [17592186105852 #edb/ref 1038 #edb/ref 17592186106284 #edb/ref 17592186045417] [17592186105852 #edb/ref 1039 "Using the Power of Product Rule with Three Factors" #edb/ref 17592186045417] [17592186105852 #edb/ref 1041 #edb/ref 17592186105443 #edb/ref 17592186045417] [17592186105852 #edb/ref 1042 #uuid "ae5f5e65-7642-5ca1-bf84-013dbd3c7ae4" #edb/ref 17592186045417] [17592186105977 #edb/ref 1043 #edb/ref 17592186106814 #edb/ref 17592186045417] [17592186105977 #edb/ref 1043 #edb/ref 17592186106815 #edb/ref 17592186045417] [17592186105977 #edb/ref 1043 #edb/ref 17592186106816 #edb/ref 1759218