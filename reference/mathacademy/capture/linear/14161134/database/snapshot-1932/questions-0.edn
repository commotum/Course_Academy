#{[{:db/id #edb/ref 17592186105441 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105850 :knowledge-point/id #uuid "8b4ce383-37b4-5d5a-80ef-3886605bd56f" :knowledge-point/title "Using the Power of Product Rule with a Positive Power"}] :question/id #uuid "ac7cb5c7-c6f1-5418-92ea-025b88681439" :question/math-academy-id "e-1081" :question/problem "Simplify $\\left(2x\\right)^3$." :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}\n(2x)^{3} &=  \\\\\n(2)^{3} \\cdot (x)^{3} &=  \\\\\n(8) \\cdot (x^{3}) &=  \\\\\n&= 8x^{3}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105442 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105851 :knowledge-point/id #uuid "85159201-5cf2-53da-91bf-ba7ef462a4fa" :knowledge-point/title "Using the Power of Product Rule with a Negative Power"}] :question/id #uuid "c5803e29-de29-5394-8eb7-9a0c3beea3f4" :question/math-academy-id "e-1082" :question/problem "Simplify the expression $\\left(pq^{-2}\\right)^3$." :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}\n(pq^{-2})^{3} &=  \\\\\np^{3} \\cdot (q^{-2})^{3} &=  \\\\\np^{3} \\cdot q^{(-2)(3)} &=  \\\\\np^{3}q^{-6} &=  \\\\\n&= \\frac{p^{3}}{q^{6}}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105443 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105852 :knowledge-point/id #uuid "ae5f5e65-7642-5ca1-bf84-013dbd3c7ae4" :knowledge-point/title "Using the Power of Product Rule with Three Factors"}] :question/id #uuid "8a0ae6fe-6ba8-58bb-8835-a3e1546b0999" :question/math-academy-id "e-1083" :question/problem "Simplify $(2x^2y^{-1})^{-4}$." :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}\n(2x^{2}y^{-1})^{-4} &=  \\\\\n2^{-4} \\cdot (x^{2})^{-4} \\cdot (y^{-1})^{-4} &=  \\\\\n\\frac{1}{2^{4}} \\cdot x^{(2)(-4)} \\cdot y^{(-1)(-4)} &=  \\\\\n\\frac{1}{16} \\cdot x^{-8} \\cdot y^{4} &=  \\\\\n\\frac{1}{16} \\cdot \\frac{1}{x^{8}} \\cdot y^{4} &=  \\\\\n&= \\frac{y^{4}}{16x^{8}}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106276 :knowledge-point/_questions [{:db/id #edb/ref 17592186105851 :knowledge-point/id #uuid "85159201-5cf2-53da-91bf-ba7ef462a4fa" :knowledge-point/title "Using the Power of Product Rule with a Negative Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a5dfaec-442e-59af-9107-9b9ea895857e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a^{7}b^{7}" :db/id #edb/ref 17592186103805} {:answer/id #uuid "be1d214a-1971-5dd7-9651-413fb6ece98b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{a^{7}b^{7}}" :db/id #edb/ref 17592186103806} {:answer/id #uuid "0e6da818-eb43-5bb2-a848-fa482db6272f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(ab)^{8}" :db/id #edb/ref 17592186103807} {:answer/id #uuid "17a80b53-fc90-5bde-8197-4fcddb969e59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a^{8}b^{-8}" :db/id #edb/ref 17592186103808} {:answer/id #uuid "6c0ac4c6-c87b-5d97-933a-cdbca938b166" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{a^{7}}{b^{7}}" :db/id #edb/ref 17592186103809}] :answer-field/id #uuid "47e2ad5c-de7a-5416-a9a2-6d8aa7609b78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186103804}] :question/id #uuid "d38f35d2-b932-5341-8f86-5ad700292b4e" :question/math-academy-id "q-28736" :question/problem "What is $(a^{-1}b)^{-7}$?"}] [{:db/id #edb/ref 17592186106385 :knowledge-point/_questions [{:db/id #edb/ref 17592186105851 :knowledge-point/id #uuid "85159201-5cf2-53da-91bf-ba7ef462a4fa" :knowledge-point/title "Using the Power of Product Rule with a Negative Power"}] :question/answer-fields [{:answer-field