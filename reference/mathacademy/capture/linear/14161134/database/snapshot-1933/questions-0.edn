#{[{:db/id #edb/ref 17592186105441 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105850 :knowledge-point/id #uuid "8b4ce383-37b4-5d5a-80ef-3886605bd56f" :knowledge-point/title "Using the Power of Product Rule with a Positive Power"}] :question/id #uuid "ac7cb5c7-c6f1-5418-92ea-025b88681439" :question/math-academy-id "e-1081" :question/problem "Simplify $\\left(2x\\right)^3.$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}(2x)^{3} & = \\\\ (2)^{3}\\cdot (x)^{3} & = \\\\ (8)\\cdot ({x}^{3}) & = \\\\ 8{x}^{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105442 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105851 :knowledge-point/id #uuid "85159201-5cf2-53da-91bf-ba7ef462a4fa" :knowledge-point/title "Using the Power of Product Rule with a Negative Power"}] :question/id #uuid "c5803e29-de29-5394-8eb7-9a0c3beea3f4" :question/math-academy-id "e-1082" :question/problem "Simplify the expression $\\left(pq^{-2}\\right)^3.$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}{(p{q}^{-2})}^{3} & = \\\\ {p}^{3}\\cdot {({q}^{-2})}^{3} & = \\\\ {p}^{3}\\cdot {q}^{(-2)(3)} & = \\\\ {p}^{3}{q}^{-6} & = \\\\ \\frac{{p}^{3}}{{q}^{6}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105443 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105852 :knowledge-point/id #uuid "ae5f5e65-7642-5ca1-bf84-013dbd3c7ae4" :knowledge-point/title "Using the Power of Product Rule with Three Factors"}] :question/id #uuid "8a0ae6fe-6ba8-58bb-8835-a3e1546b0999" :question/math-academy-id "e-1083" :question/problem "Simplify $(2x^2y^{-1})^{-4}.$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}(2{x}^{2}{y}^{-1})^{-4} & = \\\\ {2}^{-4}\\cdot ({x}^{2})^{-4}\\cdot ({y}^{-1})^{-4} & = \\\\ \\frac{1}{{2}^{4}}\\cdot {x}^{(2)(-4)}\\cdot {y}^{(-1)(-4)} & = \\\\ \\frac{1}{16}\\cdot {x}^{-8}\\cdot {y}^{4} & = \\\\ \\frac{1}{16}\\cdot \\frac{1}{{x}^{8}}\\cdot {y}^{4} & = \\\\ \\frac{{y}^{4}}{16{x}^{8}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485549 :knowledge-point/_questions [{:db/id #edb/ref 17592186105850 :knowledge-point/id #uuid "8b4ce383-37b4-5d5a-80ef-3886605bd56f" :knowledge-point/title "Using the Power of Product Rule with a Positive Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f1b56f4-5312-5a1d-9090-9aa8edf36063" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12b" :db/id #edb/ref 17592186484847} {:answer/id #uuid "1e73fca2-d467-5d96-bd18-0876077189a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64{b}^{3}" :db/id #edb/ref 17592186484872} {:answer/id #uuid "2a2a8d78-d5d4-5ef9-897e-b199b87deb22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16{b}^{3}" :db/id #edb/ref 17592186484901} {:answer/id #uuid "ad9b06a7-56ba-59ed-8de1-eec7ce9ba740" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-64{b}^{3}" :db/id #edb/ref 17592186485191} {:answer/id #uuid "e863e271-50f0-5297-9ad5-9e8318153f0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12{b}^{3}" :db/id #edb/ref 17592186485306}] :answer-field/correct {:answer/id #uuid "1e73fca2-d467-5d96-bd18-0876077189a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64{b}^{3}" :db/id #edb/ref 17592186484872} :answer-field/id #uuid "a14b1298-3747-5fd1-899b-de85652e50c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485436}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7f18a486-2b6b-5f9e-8e38-324212260786" :question/math-academy-id "q-22334" :question/problem "Simplify $-(-4b)^{3}.$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}-(-4b)^{3} & = \\\\ -((-4)^{3}\\cdot {b}^{3}) & = \\\\ -(-64{b}^{3}) & = \\\\ 64{b}^{3} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106276 :knowledge-point/_questions [{:db/id #edb/ref 17592186105851 :knowledge-point/id #uuid "85159201-5cf2-53da-91bf-ba7ef462a4fa" :knowledge-point/title "Using the Power of Product Rule with a Negative Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e6da818-eb43-5bb2-a848-fa482db6272f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(ab)^{8}" :db/id #edb/ref 17592186103807} {:answer/id #uuid "687d14aa-ff54-5c9b-8a40-d8380a3b9c94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{7}{b}^{7}" :db/id #edb/ref 17592186485045} {:answer/id #uuid "70d0b8a3-28af-5be2-a31c-e77c97c45d41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{a}^{7}{b}^{7}}" :db/id #edb/ref 17592186485060} {:answer/id #uuid "93995dc1-54c8-5047-9c21-12b35d606201" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{8}{b}^{-8}" :db/id #edb/ref 17592186485136} {:answer/id #uuid "afd5fb21-1da5-53ab-8309-62489fc06914" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{a}^{7}}{{b}^{7}}" :db/id #edb/ref 17592186485199}] :answer-field/correct {:answer/id #uuid "afd5fb21-1da5-53ab-8309-62489fc06914" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{a}^{7}}{{b}^{7}}" :db/id #edb/ref 17592186485199} :answer-field/id #uuid "47e2ad5c-de7a-5416-a9a2-6d8aa7609b78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186103804}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d38f35d2-b932-5341-8f86-5ad700292b4e" :question/math-academy-id "q-28736" :question/problem "${({a}^{-1}b)}^{-7}=$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}{({a}^{-1}b)}^{-7} & = \\\\ {({a}^{-1})}^{-7}{(b)}^{-7} & = \\\\ {a}^{(-1)(-7)}\\cdot {b}^{-7} & = \\\\ {a}^{7}\\cdot {b}^{-7} & = \\\\ \\frac{{a}^{7}}{{b}^{7}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485582 :knowledge-point/_questions [{:db/id #edb/ref 17592186105851 :knowledge-point/id #uuid "85159201-5cf2-53da-91bf-ba7ef462a4fa" :knowledge-point/title "Using the Power of Product Rule with a Negative Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "296939f6-2b9b-50e6-ab06-68d7d605f6f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{1\\,000{p}^{6}}" :db/id #edb/ref 17592186484898} {:answer/id #uuid "8306d232-c66d-592b-83f7-03b3345b4fda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{p}^{6}}{1\\,000}" :db/id #edb/ref 17592186485098} {:answer/id #uuid "87ab9acb-0f0f-587a-a9b9-dd92ae5d0e1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1\\,000}{{p}^{9}}" :db/id #edb/ref 17592186485111} {:answer/id #uuid "c16ec5a9-54e2-5072-99f0-3a0626aa8324" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{p}^{9}}{1\\,000}" :db/id #edb/ref 17592186485231} {:answer/id #uuid "c6c9c830-b447-583e-8995-c9b3bce53b3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{1\\,000{p}^{9}}" :db/id #edb/ref 17592186485243}] :answer-field/correct {:answer/id #uuid "c16ec5a9-54e2-5072-99f0-3a0626aa8324" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{p}^{9}}{1\\,000}" :db/id #edb/ref 17592186485231} :answer-field/i