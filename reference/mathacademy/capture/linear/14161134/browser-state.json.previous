    "q-3321": {
      "dom_id": "step-q3321",
      "name": "Question 3",
      "problem": "Which of the following is equivalent to  $(-10{p}^{-3})^{-3}?$",
      "worked_solution": "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}(-10{p}^{-3})^{-3} & = \\\\ (-10)^{-3}{({p}^{-3})}^{-3} & = \\\\ \\frac{1}{(-10)^{3}}\\cdot {p}^{(-3)(-3)} & = \\\\ -\\frac{1}{1\\,000}\\cdot {p}^{9} & = \\\\ -\\frac{{p}^{9}}{1\\,000} & \\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-3321-a",
