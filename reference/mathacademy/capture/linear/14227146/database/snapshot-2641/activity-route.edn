#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186548144} :activity/id #uuid "03b3f378-60b1-52ee-9696-118ad875a350" :activity/scope {:db/id #edb/ref 17592186048677 :topic/id #uuid "b3fe0bdc-d6d3-510d-ba60-be31a59b4ba0" :topic/math-academy-id 1157} :activity/steps [{:db/id #edb/ref 17592186548144 :step/content {:db/id #edb/ref 17592186548006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e77a6f5-b85a-52a5-a006-9b7d292f2cc8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{401}{16}" :db/id #edb/ref 17592186547345} {:answer/id #uuid "13ad4530-88a4-53d4-8e25-b235bdfe115f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{209}{8}" :db/id #edb/ref 17592186547355} {:answer/id #uuid "16ac0b96-91a3-5dfc-b5ef-29cbc766835a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{417}{16}" :db/id #edb/ref 17592186547364} {:answer/id #uuid "80d7caca-10f2-5451-a96d-795017485bf5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{449}{16}" :db/id #edb/ref 17592186547591} {:answer/id #uuid "92e2c5b9-18da-53a6-8dd8-6cb2c77bfba7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{401}{8}" :db/id #edb/ref 17592186547642}] :answer-field/correct {:db/id #edb/ref 17592186547364} :answer-field/id #uuid "69965209-526e-5658-899a-44e6dd8b07be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186547892}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "510f41a7-5712-55db-b50d-5c80967bb9fb" :question/math-academy-id "q-12889" :question/problem "Given that\n\n$$\n{(\\frac{{x}^{2}}{2}+4)}^{4}=A{x}^{8}+B{x}^{6}+C{x}^{4}+128{x}^{2}+256\n$$\n\nwhere $A,B$ and $C$ are constants, find the value of $A+B+C.$" :question/worked-solution "First, let's compare our expression with the binomial\n\n$$\n(a+b)^{n}.\n$$\n\nHere we have that $n=4,$ $a=\\frac{{x}^{2}}{2},$ and $b=4.$ So, the exponents of the binomial expansion must follow the pattern\n\n$$\n{a}^{4}{b}^{0},\\,{a}^{3}{b}^{1},\\,{a}^{2}{b}^{2},\\,{a}^{1}{b}^{3},\\,{a}^{0}{b}^{4}.\n$$\n\nThe $4$th row in Pascal's Triangle is $(1,4,6,4,1).$ Therefore,\n\n$$\n\\begin{aligned}{(\\frac{{x}^{2}}{2}+4)}^{4} & =1{a}^{4}+4{a}^{3}b+6{a}^{2}{b}^{2}+4a{b}^{3}+1{b}^{4} \\\\  & =1{(\\frac{{x}^{2}}{2})}^{4}(4)^{0}+4{(\\frac{{x}^{2}}{2})}^{3}{(4)}^{1}+6{(\\frac{{x}^{2}}{2})}^{2}{(4)}^{2} \\\\  & \\,+4{(\\frac{{x}^{2}}{2})}^{1}{(4)}^{3}+1{(\\frac{{x}^{2}}{2})}^{0}{(4)}^{4} \\\\  & =1(\\frac{{x}^{8}}{16})(1)+4(\\frac{{x}^{6}}{8})(4)+6(\\frac{{x}^{4}}{4})(16) \\\\  & \\,+4(\\frac{{x}^{2}}{2})(64)+1(1)(256) \\\\  & =\\frac{{x}^{8}}{16}+\\frac{16{x}^{6}}{8}+\\frac{96{x}^{4}}{4}+\\frac{256{x}^{2}}{2}+256 \\\\  & =\\frac{{x}^{8}}{16}+2{x}^{6}+24{x}^{4}+128{x}^{2}+256.\\end{aligned}\n$$\n\nTherefore, we have $A=\\frac{1}{16},B=2$ and $C=24.$ So, finally\n\n$$\nA+B+C=\\frac{1}{16}+2+24=\\frac{417}{16}.\n$$"} :step/id #uuid "a849bf07-e1b9-58de-b318-85fa4f3d86aa" :step/next {:db/id #edb/ref 17592186548176}} {:db/id #edb/ref 17592186548176 :step/content {:db/id #edb/ref 17592186548051 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7869ea61-e97c-524e-a14d-1788d8383e87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{z}^{8}-4{z}^{6}+6{z}^{4}" :db/id #edb/ref 17592186547577} {:answer/id #uuid "863fbced-ba48-51fa-ac1c-071cd8741980" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{z}^{8}+2{z}^{6}-6{z}^{4}" :db/id #edb/ref 17592186547605} {:answer/id #uuid "a2e736b8-e40c-51d3-9a0e-4ad64eae66bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{z}^{8}-4{z}^{6}+18{z}^{4}" :db/id #edb/ref 17592186547671} {:answer/id #uuid "bbf1cdb0-233a-556a-92fd-fadf68dcfca7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{z}^{8}-4{z}^{6}+12{z}^{4}" :db/id #edb/ref 17592186547718} {:answer/id #uuid "fd90e06c-4204-5316-a4d6-0173539fd070" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{z}^{8}+2{z}^{6}-4{z}^{4}" :db/id #edb/ref 17592186547838}] :answer-field/correct {:db/id #edb/ref 17592186547577} :answer-field/id #uuid "a9807bbb-6450-5bec-9d6e-2cb5e0bc2c61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186547924}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c9b934c2-8c57-56f1-8a65-42f138da7b11" :question/math-academy-id "q-12891" :question/problem "Find, in descending powers of $z,$ the first three terms of the binomial expansion of ${(1-{z}^{2})}^{4}.$" :question/worked-solution "First, let's compare our expression with the binomial\n\n$$\n(a+b)^{n}.\n$$\n\nHere we have that $n=4,$ $a=1,$ and $b=-{z}^{2}.$ So, the exponents of the binomial expansion must follow the pattern\n\n$$\n{a}^{4}{b}^{0},\\,{a}^{3}{b}^{1},\\,{a}^{2}{b}^{2},\\,{a}^{1}{b}^{3},\\,{a}^{0}{b}^{4}.\n$$\n\nThe $4$th row in Pascal's Triangle is $(1,4,6,4,1).$ Therefore,\n\n$$\n\\begin{aligned}{(1-{z}^{2})}^{4} & =1{a}^{4}+4{a}^{3}b+6{a}^{2}{b}^{2}+4a{b}^{3}+1{b}^{4} \\\\  & =1(1)^{4}(-{z}^{2})^{0}+4(1)^{3}(-{z}^{2})^{1}+6(1)^{2}(-{z}^{2})^{2}+4(1)^{1}(-{z}^{2})^{3}+1(1)^{0}(-{z}^{2})^{4} \\\\  & =1(1)(1)+4(1)(-{z}^{2})+6(1)({z}^{4})+4(1)(-{z}^{6})+1(1)({z}^{8}) \\\\  & =1-4{z}^{2}+6{z}^{4}-4{z}^{6}+{z}^{8}.\\end{aligned}\n$$\n\nWe rewrite the binomial expansion in descending powers of $z$ as follows:\n\n$$\n(1-{z}^{2})^{4}={z}^{8}-4{z}^{6}+6{z}^{4}-4{z}^{2}+1\n$$\n\nFinally, in descending powers of $z,$ the first three terms of the binomial expansion are\n\n$$\n{z}^{8}-4{z}^{6}+6{z}^{4}.\n$$"} :step/id #uuid "de2d3f8a-b796-5c4a-80a9-88cbe5bf41a1" :step/next {:db/id #edb/ref 17592186548180}} {:db/id #edb/ref 17592186548180 :step/content {:db/id #edb/ref 17592186548014 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "209aed4f-131b-523e-a4e8-1446b6171323" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186547382} {:answer/id #uuid "3bcbebd1-5d2a-5581-b48c-489d2c32892b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186547446} {:answer/id #uuid "43b9c880-5fa3-575f-adb6-b7776ccb3b8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-24" :db/id #edb/ref 17592186547467} {:answer/id #uuid "47d804d7-6d7b-51dc-82a8-e898d3670e24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-16" :db/id #edb/ref 17592186547476} {:answer/id #uuid "ad8e8633-e525-5531-b1dd-16c1c9c6e25e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186547696}] :answer-field/correct {:db/id #edb/ref 17592186547476} :answer-field/id #uuid "fe5bbd0a-c356-5392-bd90-c3fba4a83d1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186547966}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "700411f4-106e-5592-a547-8738d64ef693" :question/math-academy-id "q-110676" :question/problem "Given that \n\n$$\n{(2s-{u}^{2})}^{4}=16{s}^{4}+A{s}^{3}{u}^{2}+B{s}^{2}{u}^{4}+Cs{u}^{6}+{u}^{8}\n$$\n\nwhere $A,B$ and $C$ are constants, determine the value of $A+B+C.$" :question/worked-solution "First, let's compare our expression with the binomial\n\n$$\n(a+b)^{n}.\n$$\n\nHere we have that $n=4,$ $a=2s,$ and $b=-{u}^{2}.$ So, the exponents of the binomial expansion must follow the pattern\n\n$$\n{a}^{4}{b}^{0},\\,{a}^{3}{b}^{1},\\,{a}^{2}{b}^{2},\\,{a}^{1}{b}^{3},\\,{a}^{0}{b}^{4}.\n$$\n\nThe $4$th row in Pascal's Triangle is $(1,4,6,4,1).$ Therefore,\n\n$$\n\\begin{aligned}(2s-{u}^{2})^{4} & =1{a}^{4}{b}^{0}+4{a}^{3}b+6{a}^{2}{b}^{2}+4a{b}^{3}+1{a}^{0}{b}^{4} \\\\  & =1(2s)^{4}{(-{u}^{2})}^{0}+4(2s)^{3}{(-{u}^{2})}^{1}+6(2s)^{2}{(-{u}^{2})}^{2} \\\\  & \\,+4(2s)^{1}{(-{u}^{2})}^{3}+1(2s)^{0}{(-{u}^{2})}^{4} \\\\  & =1(16{s}^{4})(1)+4(8{s}^{3})(-{u}^{2})+6(4{s}^{2})({u}^{4}) \\\\  & \\,+4(2s)(-{u}^{6})+1(1)({u}^{8}) \\\\  & =16{s}^{4}-32{s}^{3}{u}^{2}+24{s}^{2}{u}^{4}-8s{u}^{6}+{u}^{8}.\\end{aligned}\n$$\n\nTherefore, $A=-32,B=24,$ and $C=-8.$ Finally, then\n\n$$\nA+B+C=-32+24-8=-16.\n$$"} :step/id #uuid "e88238c8-1541-5000-9ad9-0ced66e4e120"}] :activity/title "Expanding Binomials Using Pascal's Triangle" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186547291}]}
