left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.8em 0.3em\"><mtr><mtd><msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>1</mn><mo>−</mo><msup><mi>z</mi><mn>2</mn></msup><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mn>4</mn></msup></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mn mathvariant=\"bold\">1</mn></mrow><msup><mi>a</mi><mn>4</mn></msup><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mn mathvariant=\"bold\">4</mn></mrow><msup><mi>a</mi><mn>3</mn></msup><mi>b</mi><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mn mathvariant=\"bold\">6</mn></mrow><msup><mi>a</mi><mn>2</mn></msup><msup><mi>b</mi><mn>2</mn></msup><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mn mathvariant=\"bold\">4</mn></mrow><mi>a</mi><msup><mi>b</mi><mn>3</mn></msup><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mn mathvariant=\"bold\">1</mn></mrow><msup><mi>b</mi><mn>4</mn></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mn mathvariant=\"bold\">1</mn></mrow><mo stretchy=\"false\">(</mo><mn>1</mn><msup><mo stretchy=\"false\">)</mo><mn>4</mn></msup><mo stretchy=\"false\">(</mo><mo>−</mo><msup><mi>z</mi><mn>2</mn></msup><msup><mo stretchy=\"false\">)</mo><mn>0</mn></msup><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mn mathvariant=\"bold\">4</mn></mrow><mo stretchy=\"false\">(</mo><mn>1</mn><msup><mo stretchy=\"false\">)</mo><mn>3</mn></msup><mo stretchy=\"false\">(</mo><mo>−</mo><msup><mi>z</mi><mn>2</mn></msup><msup><mo stretchy=\"false\">)</mo><mn>1</mn></msup><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mn mathvariant=\"bold\">6</mn></mrow><mo stretchy=\"false\">(</mo><mn>1</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo stretchy=\"false\">(</mo><mo>−</mo><msup><mi>z</mi><mn>2</mn></msup><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mn mathvariant=\"bold\">4</mn></mrow><mo stretchy=\"false\">(</mo><mn>1</mn><msup><mo stretchy=\"false\">)</mo><mn>1</mn></msup><mo stretchy=\"false\">(</mo><mo>−</mo><msup><mi>z</mi><mn>2</mn></msup><msup><mo stretchy=\"false\">)</mo><mn>3</mn></msup><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mn mathvariant=\"bold\">1</mn></mrow><mo stretchy=\"false\">(</mo><mn>1</mn><msup><mo stretchy=\"false\">)</mo><mn>0</mn></msup><mo stretchy=\"false\">(</mo><mo>−</mo><msup><mi>z</mi><mn>2</mn></msup><msup><mo stretchy=\"false\">)</mo><mn>4</mn></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mn mathvariant=\"bold\">1</mn></mrow><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mn mathvariant=\"bold\">4</mn></mrow><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mo>−</mo><msup><mi>z</mi><mn>2</mn></msup><mo stretchy=\"false\">)</mo><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mn mathvariant=\"bold\">6</mn></mrow><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><msup><mi>z</mi><mn>4</mn></msup><mo stretchy=\"false\">)</mo><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mn mathvariant=\"bold\">4</mn></mrow><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mo>−</mo><msup><mi>z</mi><mn>6</mn></msup><mo stretchy=\"false\">)</mo><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mn mathvariant=\"bold\">1</mn></mrow><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><msup><mi>z</mi><mn>8</mn></msup><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>1</mn><mo>−</mo><mn>4</mn><msup><mi>z</mi><mn>2</mn></msup><mo>+</mo><mn>6</mn><msup><mi>z</mi><mn>4</mn></msup><mo>−</mo><mn>4</mn><msup><mi>z</mi><mn>6</mn></msup><mo>+</mo><msup><mi>z</mi><mn>8</mn></msup><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>We rewrite the binomial expansion in descending powers of <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"35\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D467 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>z</mi></math></mjx-assistive-mml></mjx-container> as follows:\n<mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"36\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-msup space=\"3\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D467 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.413em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup><mjx-msup><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-script style=\"vertical-align: 0.413em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c34\"></mjx-c></mjx-mn></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-msup space=\"4\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D467 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.413em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c38\"></mjx-c></mjx-mn></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c34\"></mjx-c></mjx-mn><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D467 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.413em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c36\"></mjx-c></mjx-mn></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c36\"></mjx-c></mjx-mn><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D467 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.413em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c34\"></mjx-c></mjx-mn></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c34\"></mjx-c></mjx-mn><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D467 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.413em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mo stretchy=\"false\">(</mo><mn>1</mn><mo>−</mo><msup><mi>z</mi><mn>2</mn></msup><msup><mo stretchy=\"false\">)</mo><mn>4</mn></msup><mo>=</mo><msup><mi>z</mi><mn>8</mn></msup><mo>−</mo><mn>4</mn><msup><mi>z</mi><mn>6</mn></msup><mo>+</mo><mn>6</mn><msup><mi>z</mi><mn>4</mn></msup><mo>−</mo><mn>4</mn><msup><mi>z</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></math></mjx-assistive-mml></mjx-container></p>\n<p>Finally, in descending powers of <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"37\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D467 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>z</mi><mo>,</mo></math></mjx-assistive-mml></mjx-container> the first three terms of the binomial expansion are</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"38\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D467 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.413em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c38\"></mjx-c></mjx-mn></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c34\"></mjx-c></mjx-mn><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D467 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.413em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c36\"></mjx-c></mjx-mn></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c36\"></mjx-c></mjx-mn><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D467 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.413em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c34\"></mjx-c></mjx-mn></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><msup><mi>z</mi><mn>8</mn></msup><mo>−</mo><mn>4</mn><msup><mi>z</mi><mn>6</mn></msup><mo>+</mo><mn>6</mn><msup><mi>z</mi><mn>4</mn></msup><mo>.</mo></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
