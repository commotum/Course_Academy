          "dom_index": 0,
          "disabled": false,
          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:65px;\n                                        margin-left:2px;\n                                        margin-right:1px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"11\"><span mathquill-command-id=\"13\">1</span><span mathquill-command-id=\"15\">0</span><span class=\"mq-non-leaf\" mathquill-command-id=\"17\"><span class=\"mq-scaled mq-sqrt-prefix\" style=\"transform: scale(1, 0.943478);\">√</span><span class=\"mq-non-leaf mq-sqrt-stem\" mathquill-block-id=\"19\"><span mathquill-command-id=\"18\">1</span><span mathquill-command-id=\"20\">0</span></span></span></span></div></div>",
          "rendered_text": "10√10",
