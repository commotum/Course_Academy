  "live_records": {
    "q-81512": {
      "dom_id": "step-q81512",
      "name": "Question 1",
      "problem": "What is the amplitude of the function $f(x)=-2\\pi \\operatorname{cos}⁡(\\frac{\\pi }{2}x-1)?$",
      "worked_solution": "Given a function in the form $f(x)=A\\operatorname{cos}⁡(Bx+C)+D,$ the amplitude is $|A|.$\n\nSince $A=-2\\pi ,$ we have that the amplitude is $|A|=|-2\\pi |=2\\pi .$",
