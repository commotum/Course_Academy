#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186065261} :activity/id #uuid "4244c671-6d77-5104-ad59-c0003b164617" :activity/scope {:db/id #edb/ref 17592186048213 :topic/id #uuid "88c7b8d9-bc0d-58a6-8e2f-ba82db6413e5" :topic/math-academy-id 343} :activity/steps [{:db/id #edb/ref 17592186065261 :step/content {:db/id #edb/ref 17592186065419 :tutorial/content "To solve a linear equation with variables on both sides, we bring all variables to one side of the equation and all constants to the other side. \n\nFor example, let's solve the following equation: \n\n$$\n5x = 2x + 12\n$$\n\n \n\nNotice that we have $5x$ on the left-hand side and $2x$ on the right-hand side. Since the variable on the left-hand side has a larger coefficient, let's bring all the variables to this side.\n\nThe first step is to remove the $\\color{blue}2x$ from the right-hand side. We can do this by *subtracting* it from both sides of the equation, as follows:\n\n$$\n\\begin{aligned}5x & =2x+12 \\\\ 5x-2x & =2x+12-2x \\\\ 3x & =12\\end{aligned}\n$$\n\nFinally, we divide both sides of the equation by $3\\mathbin{:}$\n\n$$\n\\begin{aligned}3x & =12 \\\\ \\frac{3x}{3} & =\\frac{12}{3} \\\\ \\frac{\\cancel{3}x}{\\cancel{3}} & =4 \\\\ x & =4\\end{aligned}\n$$\n\nSo $x=4$ is our answer, and we're done. \n\nWe can check that $x=4$ is correct by substituting back into the original equation:\n\n$$\n\\begin{aligned}5x & \\overset{?}{=}2x+12 \\\\ 5(4) & \\overset{?}{=}2(4)+12 \\\\ 20 & =20\\,✓\\end{aligned}\n$$" :tutorial/id #uuid "b2c184ea-e365-5696-9066-7ea9d9b0f03f" :tutorial/math-academy-id 8129 :tutorial/title "Introduction"} :step/id #uuid "79ce541d-d0dc-53fc-ac4e-efdb0ff303b4" :step/math-academy-id 71433 :step/next {:db/id #edb/ref 17592186065262}} {:db/id #edb/ref 17592186065262 :step/content {:db/id #edb/ref 17592186064344 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063944 :question/id #uuid "931ca260-f460-5126-a410-e7e929c16dd7" :question/math-academy-id "e-13006"} :knowledge-point/id #uuid "9564e999-9aa4-5f44-bc9b-d2aad049900a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673} {:db/id #edb/ref 17592186050452}] :knowledge-point/questions [{:db/id #edb/ref 17592186064893} {:db/id #edb/ref 17592186064894} {:db/id #edb/ref 17592186064897} {:db/id #edb/ref 17592186487351} {:db/id #edb/ref 17592186487397}] :knowledge-point/title "Solving Two-Step Equations"} :step/id #uuid "754884f3-3e7e-5715-8ab1-6b12e91c3a1d" :step/math-academy-id 71434 :step/next {:db/id #edb/ref 17592186065263}} {:db/id #edb/ref 17592186065263 :step/content {:db/id #edb/ref 17592186065420 :tutorial/content "Let's now solve the following equation: \n\n$$\n9x -9= 1+4x\n$$\n\nTo solve this equation, we must bring all variables to one side of the equation and all constants to the other side. \n\nNotice that we have $9x$ on the left-hand side and $4x$ on the right-hand side. Since the variable on the left-hand side has a larger coefficient, let's bring all the variables to this side.\n\nThe first step is to remove the $4x$ from the right-hand side of the equation. We do this by subtracting ${\\color{blue}4x}$ from both sides:\n\n$$\n\\begin{aligned}9x-9 & =1+4x \\\\ 9x-9-4x & =1+4x-4x \\\\ 5x-9 & =1\\end{aligned}\n$$\n\nNext, we remove the $-9$ from the left-hand side. We do this by adding ${\\color{red}9}$ to both sides:\n\n$$\n\\begin{aligned}5x-9 & =1 \\\\ 5x-9+9 & =1+9 \\\\ 5x & =10\\end{aligned}\n$$\n\nFinally, we divide both sides of the equation by $5\\mathbin{:}$\n\n$$\n\\begin{aligned}5x & =10 \\\\ \\frac{5x}{5} & =\\frac{10}{5} \\\\ \\frac{\\cancel{5}x}{\\cancel{5}} & =2 \\\\ x & =2\\end{aligned}\n$$\n\nSo $x=2$ is our answer. We can check that this is correct by substituting back into the original equation:\n\n$$\n\\begin{aligned}9x-9 & =1+4x \\\\ 9(2)-9 & \\overset{?}{=}1+4(2) \\\\ 18-9 & \\overset{?}{=}9 \\\\ 9 & =9\\,✓\\end{aligned}\n$$" :tutorial/id #uuid "ee887dc8-c657-52b2-a4e8-358afc2d1c4c" :tutorial/math-academy-id 8130 :tutorial/title "Solving Equations With Variables and Constants on Both Sides"} :step/id #uuid "43870085-f75d-53d4-88ec-6e559a272772" :step/math-academy-id 71438 :step/next {:db/id #edb/ref 17592186065264}} {:db/id #edb/ref 17592186065264 :step/content {:db/id #edb/ref 17592186064345 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063945 :question/id #uuid "615f4a8c-a7d7-5533-badc-fc3d12678c95" :question/math-academy-id "e-13007"} :knowledge-point/id #uuid "24a6a642-f1c3-5550-b40e-78fc6730bcf3" :knowledge-point/questions [{:db/id #edb/ref 17592186064492} {:db/id #edb/ref 17592186064747} {:db/id #edb/ref 17592186064896} {:db/id #edb/ref 17592186487360} {:db/id #edb/ref 17592186487371}] :knowledge-point/title "Solving Three-Step Equations"} :step/id #uuid "669d301f-cff6-5abd-b2ce-62da6787c94d" :step/math-academy-id 71439 :step/next {:db/id #edb/ref 17592186065265}} {:db/id #edb/ref 17592186065265 :step/content {:db/id #edb/ref 17592186064346 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063946 :question/id #uuid "afb93968-87c1-5d28-8922-8143e6db77c7" :question/math-academy-id "e-13008"} :knowledge-point/id #uuid "75d27dfc-1297-5045-bedd-10e171209430" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050908}] :knowledge-point/questions [{:db/id #edb/ref 17592186064467} {:db/id #edb/ref 17592186064606} {:db/id #edb/ref 17592186064779} {:db/id #edb/ref 17592186233050} {:db/id #edb/ref 17592186487376} {:db/id #edb/ref 17592186487401}] :knowledge-point/title "Solving Equations Using the Distributive Law"} :step/id #uuid "e3cb28e7-6b17-5467-9725-8667d556cf6d" :step/math-academy-id 71443}] :activity/title "Solving Linear Equations With Variables on Both Sides" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064434}]}
