b/ref 17592186204089 #edb/ref 17592186045417] [17592186050884 #edb/ref 1028 #edb/ref 17592186204090 #edb/ref 17592186045417] [17592186050884 #edb/ref 1028 #edb/ref 17592186204091 #edb/ref 17592186045417] [17592186050884 #edb/ref 1028 #edb/ref 17592186204092 #edb/ref 17592186045417] [17592186050884 #edb/ref 1031 "Linear Equations With No Solutions" #edb/ref 17592186045417] [17592186050884 #edb/ref 1033 5572 #edb/ref 17592186045417] [17592186050884 #edb/ref 1034 0.6388794923182922 #edb/ref 17592186045436] [17592186050884 #edb/ref 1035 #uuid "6e36fc4f-7ad7-519b-88fa-4bc240d36c28" #edb/ref 17592186045417] [17592186050908 #edb/ref 1027 #edb/ref 17592186048213 #edb/ref 17592186045417] [17592186050908 #edb/ref 1027 #edb/ref 17592186048661 #edb/ref 17592186045417] [17592186050908 #edb/ref 1027 #edb/ref 17592186050575 #edb/ref 17592186045417] [17592186050908 #edb/ref 1027 #edb/ref 17592186050998 #edb/ref 17592186045417] [17592186050908 #edb/ref 1028 #edb/ref 17592186054777 #edb/ref 17592186045417] [17592186050908 #edb/ref 1028 #edb/ref 17592186054778 #edb/ref 17592186045417] [17592186050908 #edb/ref 1028 #edb/ref 17592186054779 #edb/ref 17592186045417] [17592186050908 #edb/ref 1028 #edb/ref 17592186054780 #edb/ref 17592186045417] [17592186050908 #edb/ref 1031 "Applying the Distributive Law With Linear Expressions" #edb/ref 17592186045417] [17592186050908 #edb/ref 1033 135 #edb/ref 17592186045417] [17592186050908 #edb/ref 1035 #uuid "704c70d6-1bf4-5b23-b4da-d122a744acda" #edb/ref 17592186045417] [17592186063944 #edb/ref 1069 "e-13006" #edb/ref 17592186045417] [17592186063944 #edb/ref 1071 "Given that $12 - 5m = 3m$, what is the value of $m$?" #edb/ref 17592186045417] [17592186063944 #edb/ref 1072 #uuid "931ca260-f460-5126-a410-e7e929c16dd7" #edb/ref 17592186045417] [17592186063944 #edb/ref 1074 "We must bring all variables to one side of the equation and all constants to the other side.\n\nNotice that we have $-5m$ on the left-hand side and $3m$ on the right-hand side. Since the variable on the right-hand side has a larger coefficient, let's bring all the variables to this side.\n\nThe first step is to remove the $-5m$ from the left-hand side. We do this by adding ${\\color{blue}5m}$ to both sides:\n\n$$\n\\begin{aligned}\n12 - 5m &= 3m \\\\\n12 - 5m + 5m &= 3m + 5m \\\\\n12 &= 8m\n\\end{aligned}\n$$\n\nFinally, we divide both sides of the equation by $8$:\n\n$$\n\\begin{aligned}\n12 &= 8m \\\\\n\\frac{12}{8} &= \\frac{8m}{8} \\\\\n\\frac{3}{2} &= \\frac{8m}{8} \\\\\n\\frac{3}{2} &= m \\\\\nm &= \\frac{3}{2}\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186063945 #edb/ref 1069 "e-13007" #edb/ref 17592186045417] [17592186063945 #edb/ref 1071 "Solve the equation $3x-12 = 5x + 8$." #edb/ref 17592186045417] [17592186063945 #edb/ref 1072 #uuid "615f4a8c-a7d7-5533-badc-fc3d12678c95" #edb/ref 17592186045417] [17592186063945 #edb/ref 1074 "We must bring all variables to one side of the equation and all constants to the other side.\n\nNotice that we have $3x$ on the left-hand side and $5x$ on the right-hand side. Since the variable on the right-hand side has a larger coefficient, let's bring all the variables to this side.\n\nThe first step is to remove the $3x$ from the left-hand side of the equation. We do this by subtracting ${\\color{blue}3x}$ from both sides:\n\n$$\n\\begin{aligned}\n3x - 12 &= 5x + 8 \\\\\n3x - 12 - 3x &= 5x + 8 - 3x \\\\\n- 12 &= 2x + 8\n\\end{aligned}\n$$\n\nNext, we remove the $8$ from the right-hand side. We do this by subtracting ${\\color{red}8}$ from both sides:\n\n$$\n\\begin{aligned}\n-12 &= 2x + 8 \\\\\n- 12 - 8 &= 2x + 8 - 8 \\\\\n- 20 &= 2x\n\\end{aligned}\n$$\n\nFinally, we divide both sides of the equation by $2$:\n\n$$\n\\begin{aligned}\n-20 &= 2x \\\\\n\\frac{-20}{2} &= \\frac{2x}{2} \\\\\n- 10 &= \\frac{2x}{2} \\\\\n- 10 &= x \\\\\nx &= -10\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186063946 #edb/ref 1069 "e-13008" #edb/ref 17592186045417] [17592186063946 #edb/ref 1071 "Solve for $t$ where $2(t+3)= 5t-3$." #edb/ref 17592186045417] [17592186063946 #edb/ref 1072 #uuid "afb93968-87c1-5d28-8922-8143e6db77c7" #edb/ref 17592186045417] [17592186063946 #edb/ref 1074 "First, we expand the parentheses on the left-hand-side:\n\n$$\n\\begin{aligned}\n2(t + 3) &= 5t - 3 \\\\\n2 \\cdot t + 2 \\cdot 3 &= 5t - 3 \\\\\n2t + 6 &= 5t - 3\n\\end{aligned}\n$$\n\nNow, we must now bring all variables to one side of the equation and all constants to the other side.\n\nNotice that we have $2t$ on the left-hand side and $5t$ on the right-hand side. Since the variable on the right-hand side has a larger coefficient, let's bring all the variables to this side.\n\nThe first step is to remove the $2t$ from the left-hand side of the equation. We do this by subtracting ${\\color{blue}2t}$ from both sides:\n\n$$\n\\begin{aligned}\n2t + 6 &= 5t - 3 \\\\\n2t + 6 - 2t &= 5t - 3 - 2t \\\\\n6 &= 3t - 3\n\\end{aligned}\n$$\n\nNext, we remove the $-3$ from the right-hand side. We do this by adding ${\\color{red}3}$ to both sides:\n\n$$\n\\begin{aligned}\n6 &= 3t - 3 \\\\\n6 + 3 &= 3t - 3 + 3 \\\\\n9 &= 3t\n\\end{aligned}\n$$\n\nFinally, we divide both sides of the equation by $3$:\n\n$$\n\\begin{aligned}\n9 &= 3t \\\\\n\\frac{9}{3} &= \\frac{3t}{3} \\\\\n3 &= \\frac{3t}{3} \\\\\n3 &= t \\\\\nt &= 3\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186064344 #edb/ref 1037 #edb/ref 17592186048673 #edb/ref 17592186045417] [17592186064344 #edb/ref 1037 #edb/ref 17592186050452 #edb/ref 17592186045417] [17592186064344 #edb/ref 1038 #edb/ref 17592186064893 #edb/ref 17592186045417] [17592186064344 #edb/ref 1038 #edb/ref 17592186064894 #edb/ref 17592186045417] [17592186064344 #edb/ref 1038 #edb/ref 17592186064897 #edb/ref 17592186045417] [17592186064344 #edb/ref 1039 "Solving Two-Step Equations" #edb/ref 17592186045417] [17592186064344 #edb/ref 1041 #edb/ref 17592186063944 #edb/ref 17592186045417] [17592186064344 #edb/ref 1042 #uuid "9564e999-9aa4-5f44-bc9b-d2aad049900a" #edb/ref 17592186045417] [17592186064345 #edb/ref 1038 #edb/ref 17592186064492 #edb/ref 17592186045417] [17592186064345 #edb/ref 1038 #edb/ref 17592186064747 #edb/ref 17592186045417] [17592186064345 #edb/ref 1038 #edb/ref 17592186064896 #edb/ref 17592186045417] [17592186064345 #edb/ref 1039 "Solving Three-Step Equations" #edb/ref 17592186045417] [17592186064345 #edb/ref 1041 #edb/ref 17592186063945 #edb/ref 17592186045417] [17592186064345 #edb/ref 1042 #uuid "24a6a642-f1c3-5550-b40e-78fc6730bcf3" #edb/ref 17592186045417] [17592186064346 #edb/ref 1037 #edb/ref 17592186050908 #edb/ref 17592186045417] [17592186064346 #edb/ref 1038 #edb/ref 17592186064467 #edb/ref 17592186045417] [17592186064346 #edb/ref 1038 #edb/ref 17592186064606 #edb/ref 17592186045417] [17592186064346 #edb/ref 1038 #edb/ref 17592186064779 #edb/ref 17592186045417] [17592186064346 #edb/ref 1038 #edb/ref 17592186233050 #edb/ref 17592186045417] [17592186064346 #edb/ref 1039 "Solving Equations Using the Distributive Law" #edb/ref 17592186045417] [17592186064346 #edb/ref 1041 #edb/ref 17592186063946 #edb/ref 17592186045417] [17592186064346 #edb/ref 1042 #uuid "75d27dfc-1297-5045-bedd-10e171209430" #edb/ref 17592186045417] [17592186064434 #edb/ref 1043 #edb/ref 17592186065261 #edb/ref 17592186045417] [17592186064434 #edb/ref 1043 #edb/ref 17592186065262 #edb/ref 17592186045417] [17592186064434 #edb/ref 1043 #edb/ref 17592186065263 #edb/ref 17592186045417] [17592186064434 #edb/ref 1043 #edb/ref 17592186065264 #edb/ref 17592186045417] [17592186064434 #edb/ref 1043 #edb/ref 17592186065265 #edb/ref 17592186045417] [17592186064434 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186064434 #edb/ref 1045 "Solving Linear Equations With Variables on Both Sides" #edb/ref 17592186045417] [17592186064434 #edb/ref 1046 #edb/ref 17592186065261 #edb/ref 17592186045417] [17592186064434 #edb/ref 1049 #edb/ref 17592186048213 #edb/ref 17592186045417] [17592186064434 #edb/ref 1053 #uuid "4244c671-6d77-5104-ad59-c0003b164617" #edb/ref 17592186045417] [17592186065261 #edb/ref 1058 #edb/ref 17592186065262 #edb/ref 17592186045417] [17592186065261 #edb/ref 1061 71433 #edb/ref 17592186045417] [17592186065261 #edb/ref 1062 #uuid "79ce541d-d0dc-53fc-ac4e-efdb0ff303b4" #edb/ref 17592186045417] [17592186065261 #edb/ref 1063 #edb/ref 17592186065419 #edb/ref 17592186045417] [17592186065262 #edb/ref 1058 #edb/ref 17592186065263 #edb/ref 17592186045417] [17592186065262 #edb/ref 1061 71434 #edb/ref 17592186045417] [17592186065262 #edb/ref 1062 #uuid "754884f3-3e7e-5715-8ab1-6b12e91c3a1d" #edb/ref 17592186045417] [17592186065262 #edb/ref 1063 #edb/ref 17592186064344 #edb/ref 17592186045417] [17592186065263 #edb/ref 1058 #edb/ref 17592186065264 #edb/ref 17592186045417] [17592186065263 #edb/ref 1061 71438 #edb/ref 17592186045417] [17592186065263 #edb/ref 1062 #uuid "43870085-f75d-53d4-88ec-6e559a272772" #edb/ref 17592186045417] [17592186065263 #edb/ref 1063 #edb/ref 17592186065420 #edb/ref 17592186045417] [17592186065264 #edb/ref 1058 #edb/ref 17592186065265 #edb/ref 17592186045417] [17592186065264 #edb/ref 1061 71439 #edb/ref 17592186045417] [17592186065264 #edb/ref 1062 #uuid "669d301f-cff6-5abd-b2ce-62da6787c94d" #edb/ref 17592186045417] [17592186065264 #edb/ref 1063 #edb/ref 17592186064345 #edb/ref 17592186045417] [17592186065265 #edb/ref 1061 71443 #edb/ref 17592186045417] [17592186065265 #edb/ref 1062 #uuid "e3cb28e7-6b17-5467-9725-8667d556cf6d" #edb/ref 17592186045417] [17592186065265 #edb/ref 1063 #edb/ref 17592186064346 #edb/ref 17592186045417] [17592186065419 #edb/ref 1064 "To solve a linear equation with variables on both sides, we bring all variables to one side of the equation and all constants to the other side.\n\nFor example, let's solve the following equation:\n\n$$\n5x = 2x + 12\n$$\n\nNotice that we have $5x$ on the left-hand side and $2x$ on the right-hand side. Since the variable on the left-hand side has a larger coefficient, let's bring all the variables to this side.\n\nThe first step is to remove the $\\color{blue}2x$ from the right-hand side. We can do this by *subtracting* it from both sides of the equation, as follows:\n\n$$\n\\begin{aligned}\n5x &= 2x + 12 \\\\\n5x - 2x &= 2x + 12 - 2x \\\\\n3x &= 12\n\\end{aligned}\n$$\n\nFinally, we divide both sides of the equation by $3$:\n\n$$\n\\begin{aligned}\n3x &= 12 \\\\\n\\frac{3x}{3} &= \\frac{12}{3} \\\\\n\\frac{3x}{3} &= 4 \\\\\nx &= 4\n\\end{aligned}\n$$\n\nSo $x=4$ is our answer, and we're done.\n\nWe can check that $x=4$ is correct by substituting back into the original equation:\n\n$$\n\\begin{aligned}\n5x &= ^(?)2x + 12 \\\\\n5(4) &= ^(?)2(4) + 12 \\\\\n20 &= 20✓\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186065419 #edb/ref 1065 8129 #edb/ref 17592186045417] [17592186065419 #edb/ref 1066 #uuid "b2c184ea-e365-5696-9066-7ea9d9b0f03f" #edb/ref 17592186045417] [17592186065419 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186065420 #edb/ref 1064 "Let's now solve the following equation:\n\n$$\n9x -9= 1+4x\n$$\n\nTo solve this equation, we must bring all variables to one side of the equation and all constants to the other side.\n\nNotice that we have $9x$ on the left-hand side and $4x$ on the right-hand side. Since the variable on the left-hand side has a larger coefficient, let's bring all the variables to this side.\n\nThe first step is to remove the $4x$ from the right-hand side of the equation. We do this by subtracting ${\\color{blue}4x}$ from both sides:\n\n$$\n\\begin{aligned}\n9x - 9 &= 1 + 4x \\\\\n9x - 9 - 4x &= 1 + 4x - 4x \\\\\n5x - 9 &= 1\n\\end{aligned}\n$$\n\nNext, we remove the $-9$ from the left-hand side. We do this by adding ${\\color{red}9}$ to both sides:\n\n$$\n\\begin{aligned}\n5x - 9 &= 1 \\\\\n5x - 9 + 9 &= 1 + 9 \\\\\n5x &= 10\n\\end{aligned}\n$$\n\nFinally, we divide both sides of the equation by $5$:\n\n$$\n\\begin{aligned}\n5x &= 10 \\\\\n\\frac{5x}{5} &= \\frac{10}{5} \\\\\n\\frac{5x}{5} &= 2 \\\\\nx &= 2\n\\end{aligned}\n$$\n\nSo $x=2$ is our answer. We can check that this is correct by substituting back into the original equation:\n\n$$\n\\begin{aligned}\n9x - 9 &= 1 + 4x \\\\\n9(2) - 9 &= ^(?)1 + 4(2) \\\\\n18 - 9 &= ^(?)9 \\\\\n9 &= 9✓\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186065420 #edb/ref 1065 8130 #edb/ref 17592186045417] [17592186065420 #edb/ref 1066 #uuid "ee887dc8-c657-52b2-a4e8-358afc2d1c4c" #edb/ref 17592186045417] [17592186065420 #edb/ref 1067 "Solving Equations With Variables and Constants on Both Sides" #edb/ref 17592186045417]}
