#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186116156} :activity/id #uuid "a4c1d15d-a43d-51de-bc2d-191d98aa4e53" :activity/scope {:db/id #edb/ref 17592186050676 :topic/id #uuid "5e0ed384-c5d0-57c1-be41-97361492eb5d" :topic/math-academy-id 1586} :activity/steps [{:db/id #edb/ref 17592186116156 :step/content {:db/id #edb/ref 17592186116506 :tutorial/content "Consider the function ![](images/44/44c838deb3fa8e3182fbd9d4a03f964dc2731730559d00328190e9259bf01762.svg) whose graph is shown below. How can we plot the graph of ![](images/12/120fd26f32d53872d244163d5a4d63931d0f881b62f3f5f7a924a9c06255ba1d.svg)\n\n![](images/1a/1a11bef66d0529418dde00e5713ed5e98f53a948c8a60f83fd056fd9e2c18698.png)\n\nWe can use some points on the graph of ![](images/44/44c838deb3fa8e3182fbd9d4a03f964dc2731730559d00328190e9259bf01762.svg) to find the corresponding points on the graphs of ![](images/a1/a142ed820c2bdafb8c1b7969028c7f4533c66fa772a73954c46f6b5eb91a050f.svg)\n\nFor example, let's take the point ![](images/8f/8f231df171077c673ad3f7611cfd99a5fb2753448232eb64a5a160a42a21a122.svg) The fact that it lies on the graph of ![](images/44/44c838deb3fa8e3182fbd9d4a03f964dc2731730559d00328190e9259bf01762.svg) means ![](images/53/5327a1cd77a2b8abb05cd13fa3d2c65cdd0a7ff447afd71e682a0282118e886c.svg) Then, if ![](images/06/068f771676e51ca5f58fb024dd4635c8da494dc49bd43398585945ce0920a425.svg) we have\n![](images/03/033afdad9ff42ad24f2d0f4388e6065adea3608bf49116364b5c13833ded06cf.svg) \n\nThis means the point ![](images/b2/b2f8b859ae7e2b4fe083670dc262b473bd79b7b1ee50a60712ae5bc13bffb954.svg) that lies on ![](images/44/44c838deb3fa8e3182fbd9d4a03f964dc2731730559d00328190e9259bf01762.svg) has a corresponding point ![](images/e2/e2e718c0eb1b8cf9581404873ddc1cc4512141d32e2fb42b70f516257ec31365.svg) that lies on ![](images/a1/a142ed820c2bdafb8c1b7969028c7f4533c66fa772a73954c46f6b5eb91a050f.svg)\n\nSo, for each point on the graph of ![](images/c9/c956e6cbfb2d94fa56a68a3173ec78f60fee33a9066c9c44ca4096d67d7b1cba.svg) there will be a point on the graph of ![](images/b9/b9b8d001be0277e544ff2d040e5b537ad8d7df49d33027a56021f4ba62497de3.svg) with the *same* ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-value and *one half* the ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg)-value:\n\n![](images/66/66e2a4dfc65fc35cd4b812ea418df3976c6e23cc002babaadd1921745353de6b.svg)\n\nFinally, we can plot the points and draw the graph of ![](images/29/2994084d895116512b0d26509c9108d059fa2e73bbc4ea785e8535fce4a7f75b.svg)\n\n![](images/8c/8ce6a8fd398025bfb9cd535fbc16db06a2a219e0d2451cf6278d81d4ab5c264a.png)\n\nThe graph of ![](images/b9/b9b8d001be0277e544ff2d040e5b537ad8d7df49d33027a56021f4ba62497de3.svg) is the graph of ![](images/44/44c838deb3fa8e3182fbd9d4a03f964dc2731730559d00328190e9259bf01762.svg) **horizontally scaled** by a factor of ![](images/d7/d7cae033e26adc59eeceb95b5807505dd0242e42982f350c36209152864cf261.svg)\n\nEquivalently, we can say that the original graph is **compressed** by a scale factor of ![](images/27/270d33581e0657a10d567c6cfaa529521b34e20a39c9a29550698cbf252fabfa.svg)\n\nIn general, the transformation ![](images/45/45950fa47c3a14fa07312805dd06e2638388335b9781c6ba1c07c76d7a5b108c.svg) scales the graph of ![](images/44/44c838deb3fa8e3182fbd9d4a03f964dc2731730559d00328190e9259bf01762.svg) horizontally by a factor of ![](images/aa/aad37c78cd66cde5ccbba8aa66a6d18afcb0fd5b7de52471203a690e0645e4c5.svg)\n\n- If ![](images/8d/8dc6f7e80ecaac9fa07890ce1881dd51de319597ae8b1dce821aa03c1f3eff06.svg) is greater than ![](images/76/76543f4805f22715457d55feb2a3c87d0d873bdcb9c1eed7a4f68539269dcf59.svg) the graph is compressed (or squished) towards the ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-axis by a scale factor of ![](images/c7/c7432bf7a520e569e53fdd1a7303ce6b9f940d99e68b5e7ea3196c51acfe2b69.svg)\n\n- If ![](images/8d/8dc6f7e80ecaac9fa07890ce1881dd51de319597ae8b1dce821aa03c1f3eff06.svg) is between ![](images/15/156b31ede73de5301befe67f02745a0202f1806a62f9fdecc6fc9ee3f21117ba.svg) and ![](images/76/76543f4805f22715457d55feb2a3c87d0d873bdcb9c1eed7a4f68539269dcf59.svg) the graph is stretched away from the ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-axis by a scale factor of ![](images/c7/c7432bf7a520e569e53fdd1a7303ce6b9f940d99e68b5e7ea3196c51acfe2b69.svg)" :tutorial/id #uuid "0f9522aa-685f-5492-a439-69c534d5bbef" :tutorial/math-academy-id 3285 :tutorial/title "Introduction"} :step/id #uuid "c0285e1d-13e9-58ab-bba4-cfc15f23ca69" :step/math-academy-id 18031 :step/next {:db/id #edb/ref 17592186116158}} {:db/id #edb/ref 17592186116157 :step/content {:db/id #edb/ref 17592186115264 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115093 :question/id #uuid "57ece1a0-70e5-523f-8f6d-73a2fef43492" :question/math-academy-id "e-4983"} :knowledge-point/id #uuid "bd783d1a-745d-5cd7-a5c3-9a109b6d1350" :knowledge-point/questions [{:db/id #edb/ref 17592186115517} {:db/id #edb/ref 17592186115520} {:db/id #edb/ref 17592186530509} {:db/id #edb/ref 17592186547989} {:db/id #edb/ref 17592186548062}] :knowledge-point/title "Plotting the Graph of a Horizontally Stretched Function"} :step/id #uuid "f833b0bd-73c5-5268-9213-0c6017d44609" :step/math-academy-id 18032 :step/next {:db/id #edb/ref 17592186116159}} {:db/id #edb/ref 17592186116158 :step/content {:db/id #edb/ref 17592186115265 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115094 :question/id #uuid "9da96071-1bed-5e17-9d59-45948a0aaa5f" :question/math-academy-id "e-4984"} :knowledge-point/id #uuid "d199ed2c-8188-5d80-9bb6-7b69ae684747" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048838}] :knowledge-point/questions [{:db/id #edb/ref 17592186115522} {:db/id #edb/ref 17592186115523} {:db/id #edb/ref 17592186530501} {:db/id #edb/ref 17592186530516}] :knowledge-point/title "Plotting the Graph of a Horizontally Compressed Function"} :step/id #uuid "e73f013f-5338-5d6d-9d71-6eed3918d6ff" :step/math-academy-id 18034 :step/next {:db/id #edb/ref 17592186116157}} {:db/id #edb/ref 17592186116159 :step/content {:db/id #edb/ref 17592186115266 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115095 :question/id #uuid "0063a610-8c9a-587f-bd0a-7296d778059b" :question/math-academy-id "e-4985"} :knowledge-point/id #uuid "03cffed8-0c7f-5175-907c-3285cc07b2ec" :knowledge-point/questions [{:db/id #edb/ref 17592186115629} {:db/id #edb/ref 17592186115953} {:db/id #edb/ref 17592186530435} {:db/id #edb/ref 17592186530449} {:db/id #edb/ref 17592186530451} {:db/id #edb/ref 17592186530471} {:db/id #edb/ref 17592186530523} {:db/id #edb/ref 17592186548020}] :knowledge-point/title "Finding a Point that Lies on a Horizontally Stretched Function"} :step/id #uuid "708280f8-6071-589c-9998-87930ecb29a9" :step/math-academy-id 18035}] :activity/title "Horizontal Stretches of Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115420}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186548124} :activity/id #uuid "8ba8307c-0927-500a-9059-3ec8e4b67d43" :activity/scope {:db/id #edb/ref 17592186050676 :topic/id #uuid "5e0ed384-c5d0-57c1-be41-97361492eb5d" :topic/math-academy-id 1586} :activity/steps [{:db/id #edb/ref 17592186548094 :step/content {:db/id #edb/ref 17592186548062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4763c363-04cb-5256-9ea2-4b8bec8c523b" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/59/59b1c2add545d32140218fd886da190b5e6df8ba129f9a46d73bcc08ac67d82c.png" :db/id #edb/ref 17592186547475} {:answer/id #uuid "9d6ef56e-b549-54f0-819a-fb9fce9fde13" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/db/db7c91f4a7041d85f55a800e791bd03f89b30285f5110126c5304ee21c197276.png" :db/id #edb/ref 17592186547659} {:answer/id #uuid "bb8ec659-c89b-58b5-8135-e398706146c1" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/4b/4b669fb58389bbe57e4e1c9c9cfb81631611163e5db3b92bb3d4b4081d32f726.png" :db/id #edb/ref 17592186547716} {:answer/id #uuid "d819a2a6-e5b3-547c-af82-631ab6a9d33b" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f2/f246bdc3d3d291e80089dd9c2f745923f7da92641e6c28602378543465b77b18.png" :db/id #edb/ref 17592186547773} {:answer/id #uuid "f9144efe-3cf6-5e18-826c-6e90ee15bf3b" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/6b/6b245838980c413d1f29912f5c8dfb51176057603c1c10743c602bc196c27c4b.png" :db/id #edb/ref 17592186547824}] :answer-field/correct {:db/id #edb/ref 17592186547824} :answer-field/id #uuid "833540e8-f57c-5001-94b6-f95ad72e285f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186547907}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d363b88c-fb75-5b26-bd10-c56875f40c1e" :question/math-academy-id "q-79427" :question/problem "![](images/75/75f479ff700f106f5cae6bafa94df87381d5fc0fca1758aad55f6bc5be1d7c38.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following is the graph of $y=f(\\frac{1}{4}x)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "To graph the function $y=f(\\frac{1}{4}x),$ we take the graph of $y=f(x)$ and stretch it by factor of $4$ parallel to the $x$-axis. This has the effect of multiplying the $x$-coordinates of all points on $y=f(x)$ by $4.$\n\nThe resulting graph is shown below.\n\n![](images/0f/0f3cf395fe5f442212e057f73ef48ab458370e914424e186611c70f1c9f29953.png)"} :step/id #uuid "2fd6cb82-b73f-5f34-aa6e-4be98186d7a6" :step/next {:db/id #edb/ref 17592186548129}} {:db/id #edb/ref 17592186548124 :step/content {:db/id #edb/ref 17592186547989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a3c7b4e-4a32-5c4b-a2b0-8a1ec78a4aac" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/98/98794731402303a4a3ecf117f3e7b8ec63eb4a43cb10ee18b3c366aefcc6aaba.png" :db/id #edb/ref 17592186547370} {:answer/id #uuid "2c930ef4-0f0c-547e-a098-8e05ad168b84" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/c1/c1620eef61866616e0c391269285d545672d423430789e6412f64ef79f5a8397.png" :db/id #edb/ref 17592186547405} {:answer/id #uuid "2cba8113-a2f6-54aa-bcc3-ce7a178f9605" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/75/75c30e74e1c90de6fcf76dfcc88968178049c796b7c21bc40eaad29e81dc6a49.png" :db/id #edb/ref 17592186547406} {:answer/id #uuid "bfb8665f-6599-50d0-940b-9c7bb36da2f9" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/d5/d50065e4fea4e110bac262b0734cb670e9c5a6e8e5538c6e91248f7fbe5ca40d.png" :db/id #edb/ref 17592186547728} {:answer/id #uuid "ceeef5b0-fdd7-58ba-94f7-3a65f57a0f6f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ef/ef009197f1b86d68aca70289966e769f03cdd498f92635009511da38061f7549.png" :db/id #edb/ref 17592186547760}] :answer-field/correct {:db/id #edb/ref 17592186547760} :answer-field/id #uuid "f0c44bb2-3c0d-5864-a1e0-28e654b1d9c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186547964}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "28d08449-f19d-5dae-9ff9-1b1d3bcb8500" :question/math-academy-id "q-17605" :question/problem "![](images/a6/a66ac2663dadacc0648b5a8993df40edafe8c7c2ee9dddac4ef932203b99dbd7.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following is the graph of $y=f(\\frac{1}{4}x)?$" :question/worked-solution "To graph the function $y=f(\\frac{1}{4}x),$ we take the graph of $y=f(x)$ and stretch it by factor of $4$ parallel to the $x$-axis. This has the effect of multiplying the $x$-coordinates of all points on $y=f(x)$ by $4.$\n\nThe resulting graph is shown below.\n\n![](images/f5/f5de147e69639b8cfbbe591241603d437650b88d523058df09dd30b60a6482da.png)"} :step/id #uuid "7de9a451-20cb-530d-be6d-f500ce4d71dc" :step/next {:db/id #edb/ref 17592186548094}} {:db/id #edb/ref 17592186548129 :step/content {:db/id #edb/ref 17592186548020 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60c7ef0e-ae5f-5788-8442-58796873f024" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-2,9)" :db/id #edb/ref 17592186547526} {:answer/id #uuid "84e944cf-269e-5563-8b06-449f37d3b2c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-6,27)" :db/id #edb/ref 17592186547601} {:answer/id #uuid "b2ab2f07-2154-5eaf-9f99-57f63be7b49d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-18,9)" :db/id #edb/ref 17592186547705} {:answer/id #uuid "d0e15f87-be8f-5c3b-8a1b-1ee813c884df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-6,3)" :db/id #edb/ref 17592186547764} {:answer/id #uuid "e91d2864-f866-5e4b-b852-31fa590ce52f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-2,3)" :db/id #edb/ref 17592186547801}] :answer-field/correct {:db/id #edb/ref 17592186547705} :answer-field/id #uuid "0dc935dc-f462-5bbc-b210-6779d4c833a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186547845}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7ec57449-f520-50b3-b823-1f98b4f880f3" :question/math-academy-id "q-79428" :question/problem "The point $P$ with coordinates $(-6,9)$ lies on the curve $y=f(x).$ Which of the following points must lie on $y=f(\\frac{1}{3}x)?$" :question/worked-solution "The function $y=f(\\frac{1}{3}x)$ represents a stretch of the function $y=f(x)$ by a factor of $3$ parallel to the $x$-axis. This has the effect of multiplying the $x$-coordinates of all points on $y=f(x)$ by $3.$\n\nTherefore, the point $(-6,9)$ on $f(x)$ is mapped to the point $(3\\cdot (-6),9)=(-18,9),$ and this point must lie on the graph of $y=f(\\frac{1}{3}x)$"} :step/id #uuid "88584094-7c93-5f8c-acd3-2211dd446362"}] :activity/title "Horizontal Stretches of Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186547302}]}
