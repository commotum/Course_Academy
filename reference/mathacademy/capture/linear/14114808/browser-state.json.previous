      "source_url": "https://mathacademy.com/tasks/14114808/topics/3027/lesson",
      "captured_at": 1791714798.067234,
      "math_academy_id": "q-105240",
      "topic_id": "3027",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q105240",
        "placement_id": null,
