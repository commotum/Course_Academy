      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14114808/observations/step-q105231-d78870c50d319d162bab.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14114808/observations/step-q105231-d78870c50d319d162bab.png",
