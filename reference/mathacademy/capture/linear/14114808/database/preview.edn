45417 true] [17592186420274 1080 "I and II only" 13194139534367 17592186045417 true] [17592186420274 1082 #edb/ref 17592186045499 13194139534367 17592186045417 true] [17592186420274 1083 #uuid "fdee9ac7-df88-5be7-8e6b-0c2c8b6fd156" 13194139534367 17592186045417 true] [17592186420275 1075 #edb/ref 17592186420270 13194139534367 17592186045417 true] [17592186420275 1075 #edb/ref 17592186420271 13194139534367 17592186045417 true] [17592186420275 1075 #edb/ref 17592186420272 13194139534367 17592186045417 true] [17592186420275 1075 #edb/ref 17592186420273 13194139534367 17592186045417 true] [17592186420275 1075 #edb/ref 17592186420274 13194139534367 17592186045417 true] [17592186420275 1076 #edb/ref 17592186045493 13194139534367 17592186045417 true] [17592186420275 1077 "selection" 13194139534367 17592186045417 true] [17592186420275 1078 #edb/ref 17592186420273 13194139534367 17592186045417 true] [17592186420275 1079 #uuid "ed30b9dd-3daf-5001-88c4-b9152d2bad1b" 13194139534367 17592186045417 true] [17592186420276 1068 #edb/ref 17592186420275 13194139534367 17592186045417 true] [17592186420276 1069 "q-232536" 13194139534367 17592186045417 true] [17592186420276 1070 #edb/ref 17592186045487 13194139534367 17592186045417 true] [17592186420276 1071 "Which of the following statements are true regarding the function $f:R\\to R$ which is given by $f(x)={3}^{x}+1?$\n\nI. The range of $f$ is $(1,\\infty )$\n\nII. $∀\\,y\\in (1,\\infty ),$ $∃\\,x\\in R$ such that $f(x)=y$\n\nIII. $f$ maps $R$ **into** $R$" 13194139534367 17592186045417 true] [17592186420276 1072 #uuid "ba992cb2-fd2f-5e4c-b95b-b82e7bb29b58" 13194139534367 17592186045417 true] [17592186420276 1074 "First, we graph the function.\n\n![](images/0c/0cb3e23cecdbd82803f5757827f21a424672bdde6da03782ca995d23e1c4d7b4.png)\n\nRecall that $f:X\\to Y$ is an *into* function if it is not a surjection. In other words, there exists an element $y$ in $Y$ such that it has no preimage in $X:$ \n\n$f:X\\to Y$ is an into function if $∃\\,y\\in Y$ such that $∀\\,x\\in X,$ we have $f(x)\\ne y.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement I is true. From the graph, the function takes all $y$-values greater than $y=1$, excluding $y=1$ itself. So the range of the function is indeed $(1,\\infty ).$\n\n- Statement II is true. Since the range of the function is $(1,\\infty )$, then for all $y$ contained within $(1,\\infty ),$ there exists some $x$ contained within $R$ such that $f(x)=y.$\n\n- Statement III is true. As we can see from the range, there is no real number $x$ such that $f(x)=0\\in R.$ So, $f$ maps $R$ *into* $R.$\n\nTherefore, the correct answer is \"I, II, and III.\"" 13194139534367 17592186045417 true]] :edb/tempids {"answer-1b642c0e-8b84-5e4a-891d-2e1beb9ad37e" 17592186420270 "answer-593420ae-cc21-52d8-a8ed-d92dcd3ab3f2" 17592186420271 "answer-b08a5b5d-77ac-5e98-91fc-de49ca37b422" 17592186420272 "answer-fda4827e-23cb-5c38-a966-819a735816cd" 17592186420273 "answer-fdee9ac7-df88-5be7-8e6b-0c2c8b6fd156" 17592186420274 "answer-field-ed30b9dd-3daf-5001-88c4-b9152d2bad1b" 17592186420275 "question-ba992cb2-fd2f-5e4c-b95b-b82e7bb29b58" 17592186420276} :edb/committed false :edb/speculative true}
