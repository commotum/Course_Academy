#{[{:activity/first-step {:db/id #edb/ref 17592186055656} :activity/id #uuid "0c86ff1c-1fc9-55e7-bf07-5e59726ce644" :activity/scope {:db/id #edb/ref 17592186049520 :topic/id #uuid "fc088d7c-dbfc-5873-80cb-82bec1e45e30" :topic/math-academy-id 85} :activity/steps [{:db/id #edb/ref 17592186055656 :step/content {:db/id #edb/ref 17592186055936 :tutorial/content "The **greatest common factor** (or $\\textrm{GCF}$) of $12$ and $18x$ is the largest expression that will divide *both* $12$ and $18x$ with no remainder.\n\nTo find the GCF, we first decompose each expression into its separate factors. We express each constant as a product of its prime factors, and we treat each variable in the product as a separate factor.\n\n$$\n\\begin{aligned}\n12 &= 2 \\cdot 2 \\cdot 3 \\\\\n18x &= 2 \\cdot 3 \\cdot 3 \\cdot x\n\\end{aligned}\n$$\n\nNext, we pair off the individual factors as much as possible.\n\n$$\n\\begin{aligned}\n12 &= 2_(―) \\cdot 2 \\cdot 3_(―) \\\\\n18x &= 2_(―) \\cdot 3_(―) \\cdot 3 \\cdot x\n\\end{aligned}\n$$\n\nFinally, we take one factor from each pair and multiply.\n\n$$\n\\textrm{GCF}(12,18x) = {\\color{red}2} \\cdot {\\color{blue}3} = 6\n$$\n\nThus, the greatest common factor of $12$ and $18x$ is $6$." :tutorial/id #uuid "b2b71877-6097-5d59-a2b8-7440bd0d5329" :tutorial/math-academy-id 1360 :tutorial/title "Introduction"} :step/id #uuid "c78d0b7d-678e-5655-a213-713eadefdc2c" :step/math-academy-id 2779 :step/next {:db/id #edb/ref 17592186055657}} {:db/id #edb/ref 17592186055657 :step/content {:db/id #edb/ref 17592186054687 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054588 :question/id #uuid "6ce77198-a3b2-5e9b-98d5-db8922addc1a" :question/math-academy-id "e-816"} :knowledge-point/id #uuid "92176bb0-84dc-5fa4-8154-e974c05fff06" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049540} {:db/id #edb/ref 17592186051009}] :knowledge-point/questions [{:db/id #edb/ref 17592186055262} {:db/id #edb/ref 17592186055400}] :knowledge-point/title 