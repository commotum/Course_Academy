 17592186564072} {:answer/id #uuid "884d7d58-379b-58e1-8ee4-764d1b74ee29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186564181} {:answer/id #uuid "8b157e9f-970f-5866-8d14-c91cf6f788b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186564184} {:answer/id #uuid "e51b98c1-401c-5ce1-8147-d9867318aac6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186564327}] :answer-field/correct {:answer/id #uuid "e51b98c1-401c-5ce1-8147-d9867318aac6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186564327} :answer-field/id #uuid "9141cb5f-904c-58f6-96bc-13f82b050944" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564421}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "20f5e3df-f068-575a-bd88-8cc274ff8c19" :question/math-academy-id "q-54514" :question/problem "${lim}_{x\\to {2}^{-}}{log}_{3}⁡(4-2x)=$" :question/worked-solution "Let's sketch the graph of $y={log}_{3}⁡(4-2x).$\n\n![](images/b1/b1d65d2df4e6a5a6b66e908ed8f776e2a1b8a4b24896506d3625e6569d9ea4e6.png)\n\nThe function is not defined for $x\\ge 2.$ Therefore,\n\n$$\n{lim}_{x\\to {2}^{+}}{log}_{3}⁡(4-2x)=\\text{DNE}.\n$$\n\nHowever, the function is defined for $x<2.$ Moreover,\n\n$$\n{lim}_{x\\to {2}^{-}}{log}_{3}⁡(4-2x)=-\\infty .\n$$"}] [{:db/id #edb/ref 17592186564509 :knowledge-point/_questions [{:db/id #edb/ref 17592186105726 :knowledge-point/id #uuid "d107785c-82d2-5dbf-9293-e66fad67ba54" :knowledge-point/title "Evaluating One-Sided Infinite Limits of Logarithmic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "297e3ba8-3ec2-51c0-8643-c2fb9