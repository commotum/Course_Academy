n" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e51b98c1-401c-5ce1-8147-d9867318aac6" :answer-field/choices ["answer-e51b98c1-401c-5ce1-8147-d9867318aac6" "answer-0cb7a4e4-ea0a-5cef-9d2b-0a7a3d825937" "answer-3d38f9ca-94fa-5d2a-8401-2c2cfc08d5c4" "answer-884d7d58-379b-58e1-8ee4-764d1b74ee29" "answer-8b157e9f-970f-5866-8d14-c91cf6f788b2"] :db/ensure [:answer-field/validate]} {:db/id "answer-e51b98c1-401c-5ce1-8147-d9867318aac6" :answer/id #uuid "e51b98c1-401c-5ce1-8147-d9867318aac6" :answer/type :answer.type/math :answer/value "-\\infty " :db/ensure [:answer/validate]} {:db/id "answer-0cb7a4e4-ea0a-5cef-9d2b-0a7a3d825937" :answer/id #uuid "0cb7a4e4-ea0a-5cef-9d2b-0a7a3d825937" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-3d38f9ca-94fa-5d2a-8401-2c2cfc08d5c4" :answer/id #uuid "3d38f9ca-94fa-5d2a-8401-2c2cfc08d5c4" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-884d7d58-379b-58e1-8ee4-764d1b74ee29" :answer/id #uuid "884d7d58-379b-58e1-8ee4-764d1b74ee29" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "answer-8b157e9f-970f-5866-8d14-c91cf6f788b2" :answer/id #uuid "8b157e9f-970f-5866-8d14-c91cf6f788b2" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "question-94ed6f2f-e6d7-5eca-a61d-41902b4a3cb4" :question/id #uuid "94ed6f2f-e6d7-5eca-a61d-41902b4a3cb4" :question/math-academy-id "q-67653" :question/problem "${lim}_{x\\to {3}^{-}}\\operatorname{ln}⁡(6-2x)=$" :question/worked-solution "Let's sketch the graph of $y=\\operatorname{ln}⁡(6-2x).$\n\n![](images/bb/bba697be09903e54cffc4bf0c0e05cbd30cbfc11975cac5097e964415baca113.png)\n\nThe function is not defined for $x>3.$ Therefore,\n\n$$\n{lim}_{x\\to {3}^{+}}\\operatorname{ln}⁡(6-2x)=\\text{DNE}.\n$$\n\nHowever, the function is defined for $x<3.$ Moreover,\n\n$$\n{lim}_{x\\to {3}^{-}}\\operatorname{ln}⁡(6-2x)=-\\infty .\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-7fca9031-9da9-5b3f-bdb6-33776b8b11df"] :db/ensure [:question/validate]} {:db/id "answer-field-7fca9031-9da9-5b3f-bdb6-33776b8b11df" :answer-field/id #uuid "7fca9031-9da9-5b3f-bdb6-33776b8b11df" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6803c870-457e-5570-b150-242064d877b7" :answer-field/choices ["answer-6803c870-457e-5570-b150-242064d877b7" "answer-ea4562b1-cb09-56bb-b332-50c8ff359486" "answer-297e3ba8-3ec2-51c0-8643-c2fb9b7d1c93" "answer-a285a759-8c2e-5fa1-8ef2-860eef0594a7" "answer-b4b289fa-1eee-5b83-b6eb-48dcbdf93bbe"] :db/ensure [:answer-field/validate]} {:db/id "answer-6803c870-457e-5570-b150-242064d877b7" :answer/id #uuid "6803c870-457e-5570-b150-242064d877b7" :answer/type :answer.type/math :answer/value "-\\infty " :db/ensure [:answer/validate]} {:db/id "answer-ea4562b1-cb09-56bb-b332-50c8ff359486" :answer/id #uuid "ea4562b1-cb09-56bb-b332-50c8ff359486" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-297e3ba8-3ec2-51c0-8643-c2fb9b7d1c93" :answer/id #uuid "297e3ba8-3ec2-51c0-8643-c2fb9b7d1c93" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-a285a759-8c2e-5fa1-8ef2-860eef0594a7" :answer/id #uuid "a285a759-8c2e-5fa1-8ef2-860eef0594a7" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "answer-b4b289fa-1eee-5b83-b6eb-48dcbdf93bbe" :answer/id #uuid "b4b289fa-1eee-5b83-b6eb-48dcbdf93bbe" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "question-29481c76-b7fa-575a-9ace-40d060b32844" :question/id #uuid "29481c76-b7fa-575a-9ace-40d060b32844" :question/math-academy-id "q-78102" :question/problem "Calculate ${lim}_{x\\to -3}{log}_{7}⁡(x+3).$" :question/worked-solution "Let's sketch the graph of $y={log}_{7}⁡(x+3).$\n\n![](images/0b/0b45cd648830ad88c2f21865c1bfd704783a7b5d9ce3510646ae55e98d2d95ac.png)\n\nThe function is not defined for $x\\le -3.$ Therefore,\n\n$$\n{lim}_{x\\to (-3)^{-}}{log}_{7}⁡(x+3)=\\text{DNE}.\n$$\n\nHowever, the function is defined for $x>-3.$ Moreover,\n\n$$\n{lim}_{x\\to (-3)^{+}}{log}_{7}⁡(x+3)=-\\infty .\n$$\n\nSince the left and right-sided limits are not equal, we have\n\n$$\n{lim}_{x\\to -3}{log}_{7}⁡(x+3)=\\text{DNE}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ef353a81-f085-5f7c-bea2-edd66e33a6a2"] :db/ensure [:question/validate]} {:db/id "answer-field-ef353a81-f085-5f7c-bea2-edd66e33a6a2" :answer-field/id #uuid "ef353a81-f085-5f7c-bea2-edd66e33a6a2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cf45625d-0eac-56fb-9026-80a2e5480905" :answer-field/choices ["answer-13b7b802-4cfb-59ae-8f7e-a0a096cb02e3" "answer-6532bdbf-67c3-5cb8-b17b-f39dc8c37c15" "answer-0cba6f4f-7f15-556c-a7f3-40384f4762be" "answer-77699979-865d-5845-a4a5-998145367451" "answer-cf45625d-0eac-56fb-9026-80a2e5480905"] :db/ensure [:answer-field/validate]} {:db/id "answer-13b7b802-4cfb-59ae-8f7e-a0a096cb02e3" :answer/id #uuid "13b7b802-4cfb-59ae-8f7e-a0a096cb02e3" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-6532bdbf-67c3-5cb8-b17b-f39dc8c37c15" :answer/id #uuid "6532bdbf-67c3-5cb8-b17b-f39dc8c37c15" :answer/type :answer.type/math :answer/value "-\\infty " :db/ensure [:answer/validate]} {:db/id "answer-0cba6f4f-7f15-556c-a7f3-40384f4762be" :answer/id #uuid "0cba6f4f-7f15-556c-a7f3-40384f4762be" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-77699979-865d-5845-a4a5-998145367451" :answer/id #uuid "77699979-865d-5845-a4a5-998145367451" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "answer-cf45625d-0eac-56fb-9026-80a2e5480905" :answer/id #uuid "cf45625d-0eac-56fb-9026-80a2e5480905" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "question-1d09c144-84e6-5d74-866a-0f1eb2fa303b" :question/id #uuid "1d09c144-84e6-5d74-866a-0f1eb2fa303b" :question/math-academy-id "q-67658" :question/problem "Calculate ${lim}_{x\\to (-2)}{log}_{2}⁡(x+2).$" :question/worked-solution "Let's sketch the graph of $y={log}_{2}⁡(x+2).$\n\n![](images/5c/5c4b062938cc4e3d64f11f9ad3bd8da9431581e9a1b0278a977a64c0d727c73d.png)\n\nThe function is not defined for $x\\le -2.$ Therefore,\n\n$$\n{lim}_{x\\to -{2}^{-}}{log}_{2}⁡(x+2)=\\text{DNE}.\n$$\n\nHowever, the function is defined for $x>-2.$ Moreover,\n\n$$\n{lim}_{x\\to -{2}^{+}}{log}_{2}⁡(x+2)=-\\infty .\n$$\n\nSince the left and right-sided limits are not equal, we have\n\n$$\n{lim}_{x\\to -2}{log}_{2}⁡(x+2)=\\text{DNE}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3e1c1c73-b29d-551a-9e59-e04e1561113d"] :db/ensure [:question/validate]} {:db/id "answer-field-3e1c1c73-b29d-551a-9e59-e04e1561113d" :answer-field/id #uuid "3e1c1c73-b29d-551a-9e59-e04e1561113d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-522c42bc-ffdf-5445-a281-9e67e13da065" :answer-field/choices ["answer-ce81e711-5293-5867-b8ca-b0091a8e51f5" "answer-784225b7-fdbd-5ed5-98bf-a5c7fd5f5031" "answer-dd67f345-0127-58ed-a1c4-1ae6514154f5" "answer-f2db4690-93ae-558e-9493-a372055b41d7" "answer-522c42bc-ffdf-5445-a281-9e67e13da065"] :db/ensure [:answer-field/validate]} {:db/id "answer-ce81e711-5293-5867-b8ca-b0091a8e51f5" :answer/id #uuid "ce81e711-5293-5867-b8ca-b0091a8e51f5" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-784225b7-fdbd-5ed5-98bf-a5c7fd5f5031" :answer/id #uuid "784225b7-fdbd-5ed5-98bf-a5c7fd5f5031" :answer/type :answer.type/math :answer/value "-\\infty " :db/ensure [:answer/validate]} {:db/id "answer-dd67f345-0127-58ed-a1c4-1ae6514154f5" :answer/id #uuid "dd67f345-0127-58ed-a1c4-1ae6514154f5" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-f2db4690-93ae-558e-9493-a372055b41d7" :answer/id #uuid "f2db4690-93ae-558e-9493-a372055b41d7" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "answer-522c42bc-ffdf-5445-a281-9e67e13da065" :answer/id #uuid "522c42bc-ffdf-5445-a281-9e67e13da065" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id 17592186107069 :tutorial/content "Let's look at the graph of $y=\\log_2{x}$ below.\n\n![](images/00/004265d2269924c6ce8905b6b92e9050b84066b3b5a3cc5383c75dd08e62f413.png)\n\nFrom the graph, we see that\n\n$$\n\\lim_{x\\to3}\\log_2{x} = \\log_2{3}\\approx 1.58.\n$$\n\nFor logarithmic functions, the limit at a point is equal to the value of the function at that point, so for any base $b \\gt 1$ we have\n\n$$\n\\lim_{x\\to c}\\log_b{x} = \\log_b{c}.\n$$\n\nRemember that logarithms are only defined for positive inputs $x\\gt 0,$ so we must have $c>0.$ Otherwise, the limit does not exist $\\textrm{(DNE}).$" :db/ensure [:tutorial/validate]} {:db/id 17592186107070 :tutorial/content "Let's take a look again at the function $y=\\log_2(x).$\n\n![](images/30/30a66b56ea1422fc61941d22aedbbf3f17e06810e66e6590490bd4b7188fd361.png)\n\nAs $x$ gets larger and larger, the curve increases without bound. So, we have\n\n$$\n\\lim_{x\\to\\infty} \\log_2{x}= \\infty.\n$$\n\nThe curve is not defined for $x\\leq 0,$ but as $x$ approaches zero from the right the curve *decreases* without bound. So\n\n$$\n\\lim_{x\\to0^+}\\log_2{x} = -\\infty.\n$$\n\nAlso, note that\n\n$$\n\\lim_{x\\to0^-}\\log_2{x} = \\textrm{DNE},\\qquad\\qquad \\lim_{x\\to0}\\log_2{x} = \\textrm{DNE}.\n$$\n\nThese properties are true for logarithms of any base $b\\gt 1.$" :db/ensure [:tutorial/validate]} {:db/id 17592186106004 :activity/expected-seconds 480.0 :db/ensure [:activity/validate]}] "assertions" [[17592186105580 :question/problem "Find $\\lim_\\limits{x \\to 4}\\log_2 (x+4) .$"] [17592186105580 :question/worked-solution "The function $\\log_2 (x+4)$ is defined for $x>-4,$ so the limit as $x \\to 4$ exists.\n\nTo find this limit, we substitute $x=4$ into the expression:\n\n$$\n\\begin{aligned}{lim}_{x\\to 4}{log}_{2}⁡(x+4) & ={log}_{2}⁡(4+4) \\\\  & ={log}_{2}⁡(8) \\\\  & ={log}_{2}⁡({2}^{3}) \\\\  & =3\\end{aligned}\n$$"] [17592186105581 :question/problem "Find $\\displaystyle{\\lim_{x\\to \\infty}  \\log_2 \\left(x-1\\right)}.$"] [17592186105581 :question/worked-solution "Let's sketch the graph of $y =  \\log_2 \\left(x-1\\right).$\n\n![](images/f0/f00e550e8b543f64effcbafb43aed9e43a4363a0c3060da4fcc23d18f76a872f.png)\n\nFrom the graph, we see that the function increases without bound as $x$ increases. Therefore,\n\n$$\n\\lim_{x\\to \\infty}  \\log_2 \\left(x-1\\right) = \\infty.\n$$"] [17592186105583 :question/problem "Calculate $\\lim_\\limits{x \\to (-2)^{-}} \\ln (x+2)$ and $\\lim_\\limits{x \\to (-2)^{+}} \\ln (x+2).$"] [17592186105583 :question/worked-solution "Let's sketch the graph of $y = \\ln(x+2).$\n\n![](images/90/906449fdcfacb0dc4aabcd51d363a71ca4842fd1a70c4b8537d38fe1f52ef7d8.png)\n\nThe function is not defined for $x\\leq -2.$ Therefore,\n\n$$\n\\lim_\\limits{x \\to (-2)^{-}} \\ln (x+2) = \\textrm{DNE}.\n$$\n\nHowever, the function is defined for $x\\gt -2.$ Therefore,\n\n$$\n\\lim_\\limits{x \\to (-2)^{+}} \\ln (x+2) = -\\infty.\n$$"] [17592186105582 :question/problem "Calculate $\\lim_\\limits{x \\to 2} \\ln (x-2).$"] [17592186105582 :question/worked-solution "Let's sketch the graph of $y = \\ln(x-2).$\n\n![](images/bf/bfe277aaf4c57d73d2649d8ade756cf04411ba23a049a6e1283d18c3e711a7fa.png)\n\nThe function is not defined for $x\\leq 2.$ Therefore,\n\n$$\n\\lim_\\limits{x \\to 2^{-}} \\ln (x-2) = \\textrm{DNE}.\n$$\n\nHowever, the function is defined for $x\\gt 2.$ Therefore,\n\n$$\n\\lim_\\limits{x \\to 2^{+}} \\ln (x-2) = -\\infty.\n$$\n\nSince the left and right-sided limits are not equal, we have\n\n$$\n\\lim_\\limits{x \\to 2} \\ln (x-2) = \\textrm{DNE}.\n$$"] ["question-d5bc96f7-1e4b-5204-9506-eaed8cba8e20" :question/id #uuid "d5bc96f7-1e4b-5204-9506-eaed8cba8e20"] ["question-d5bc96f7-1e4b-5204-9506-eaed8cba8e20" :question/math-academy-id "q-339829"] ["question-d5bc96f7-1e4b-5204-9506-eaed8cba8e20" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to 1}\\frac{\\operatorname{log}⁡(2x+8)}{2-x}=$\n\n{{field-1}}"] ["question-d5bc96f7-1e4b-5204-9506-eaed8cba8e20" :question/worked-solution "The function $\\frac{\\operatorname{log}⁡(2x+8)}{2-x}$ is well defined for $x>-4,$ and $x\\ne 2$ and so to find this limit we substitute $x=1$ into the above expression:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{\\operatorname{log}⁡(2x+8)}{2-x} & =\\frac{\\operatorname{log}⁡(2(1)+8)}{2-1} \\\\  & =\\frac{\\operatorname{log}⁡(10)}{1} \\\\  & =\\operatorname{log}⁡({10}^{1}) \\\\  & =1\\end{aligned}\n$$"] ["question-d5bc96f7-1e4b-5204-9506-eaed8cba8e20" :question/difficulty :question.difficulty/moderate] ["answer-field-52a6db62-005f-550b-8c07-96f59d9e4b2f" :answer-field/id #uuid "52a6db62-005f-550b-8c07-96f59d9e4b2f"] ["answer-e60bc47c-39ab-535f-af0a-0114fb9b73a7" :answer/id #uuid "e60bc47c-39ab-535f-af0a-0114fb9b73a7"] ["answer-e60bc47c-39ab-535f-af0a-0114fb9b73a7" :answer/type :answer.type/math] ["answer-e60bc47c-39ab-535f-af0a-0114fb9b73a7" :answer/value "1"] ["answer-field-52a6db62-005f-550b-8c07-96f59d9e4b2f" :answer-field/key "field-1"] ["answer-field-52a6db62-005f-550b-8c07-96f59d9e4b2f" :answer-field/type :answer-field.type/blank] ["answer-field-52a6db62-005f-550b-8c07-96f59d9e4b2f" :answer-field/correct "answer-e60bc47c-39ab-535f-af0a-0114fb9b73a7"] ["answer-field-52a6db62-005f-550b-8c07-96f59d9e4b2f" :answer-field/choices "answer-e60bc47c-39ab-535f-af0a-0114fb9b73a7"] ["question-d5bc96f7-1e4b-5204-9506-eaed8cba8e20" :question/answer-fields "answer-field-52a6db62-005f-550b-8c07-96f59d9e4b2f"] [17592186105723 :knowledge-point/questions "question-d5bc96f7-1e4b-5204-9506-eaed8cba8e20"] ["question-580b167f-860a-55e7-8509-7c52af963b20" :question/id #uuid "580b167f-860a-55e7-8509-7c52af963b20"] ["question-580b167f-860a-55e7-8509-7c52af963b20" :question/math-academy-id "q-54470"] ["question-580b167f-860a-55e7-8509-7c52af963b20" :question/problem "${lim}_{x\\to 4}{log}_{2}⁡(4x)=$"] ["question-580b167f-860a-55e7-8509-7c52af963b20" :question/worked-solution "The function ${log}_{2}⁡(4x)$ is well defined for $x>0,$ and so to find this limit we substitute $x=4$ into the above expression:\n\n$$\n\\begin{aligned}{lim}_{x\\to 4}{log}_{2}⁡(4x) & ={log}_{2}⁡(4\\cdot 4) \\\\  & ={log}_{2}⁡(16) \\\\  & ={log}_{2}⁡({2}^{4}) \\\\  & =4\\end{aligned}\n$$"] ["question-580b167f-860a-55e7-8509-7c52af963b20" :question/difficulty :question.difficulty/easy] ["answer-field-c5806411-08d6-5ddd-b363-c73129ba0cfe" :answer-field/id #uuid "c5806411-08d6-5ddd-b363-c73129ba0cfe"] ["answer-a1c2ea8b-9131-5dd2-9555-9cdde1b9d662" :answer/id #uuid "a1c2ea8b-9131-5dd2-9555-9cdde1b9d662"] ["answer-a1c2ea8b-9131-5dd2-9555-9cdde1b9d662" :answer/type :answer.type/math] ["answer-a1c2ea8b-9131-5dd2-9555-9cdde1b9d662" :answer/value "-\\infty "] ["answer-2446d45d-0402-58a6-91cf-846d84f2cdb5" :answer/id #uuid "2446d45d-0402-58a6-91cf-846d84f2cdb5"] ["answer-2446d45d-0402-58a6-91cf-846d84f2cdb5" :answer/type :answer.type/math] ["answer-2446d45d-0402-58a6-91cf-846d84f2cdb5" :answer/value "2"] ["answer-8c90079e-1664-5315-a4e8-b23619bb6336" :answer/id #uuid "8c90079e-1664-5315-a4e8-b23619bb6336"] ["answer-8c90079e-1664-5315-a4e8-b23619bb6336" :answer/type :answer.type/math] ["answer-8c90079e-1664-5315-a4e8-b23619bb6336" :answer/value "4"] ["answer-cf438cbb-e1b4-525e-bb7c-32d71029f2b6" :answer/id #uuid "cf438cbb-e1b4-525e-bb7c-32d71029f2b6"] ["answer-cf438cbb-e1b4-525e-bb7c-32d71029f2b6" :answer/type :answer.type/math] ["answer-cf438cbb-e1b4-525e-bb7c-32d71029f2b6" :answer/v