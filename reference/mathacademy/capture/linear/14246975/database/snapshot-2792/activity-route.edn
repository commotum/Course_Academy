#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186566300} :activity/id #uuid "b71da19e-d859-5f56-b0d6-c095ea38a156" :activity/scope {:db/id #edb/ref 17592186049126 :topic/id #uuid "dcb0f682-2f5d-57d5-ac9a-10eb5e8a8b36" :topic/math-academy-id 3591} :activity/steps [{:db/id #edb/ref 17592186566296 :step/content {:db/id #edb/ref 17592186268981 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88b47b3a-e1eb-56e3-8e5d-f4a75117a124" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186267359} {:answer/id #uuid "939eb21e-65d9-50c2-9f13-2a9c5beb9a7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186267466} {:answer/id #uuid "d0ce4537-3c51-5a6d-afe7-2fec5be72a5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186268011} {:answer/id #uuid "e9e26f0a-1b74-5e94-b5a5-bc4046928faa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6.5" :db/id #edb/ref 17592186268228} {:answer/id #uuid "fec05032-593e-5492-9092-712f5a38fa46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4.5" :db/id #edb/ref 17592186268386}] :answer-field/correct {:db/id #edb/ref 17592186267466} :answer-field/id #uuid "0c10a926-37e1-5762-a3bc-8007b371df78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268430}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0a871439-561a-57b5-a2c7-bd992bf74497" :question/math-academy-id "q-134173" :question/problem "| **Time Spent Practicing, \nin hours ($x$)** | $4$ | $5$ | $7$ | $8$ |\n| --- | --- | --- | --- | --- |\n| **Points Scored ($y$)** | $4$ | $8$ | $12$ | $16$ |\n\nThe table above shows Mary's time practicing her jump shot each week and the number of points she scores in the Friday varsity basketball game. Compute the covariance of the data sets given that the means are $\\overset{―}{x}=6$ and $\\overset{―}{y}=10.$" :question/worked-solution "The (population) covariance of the data sets $x=\\{{x}_{1},{x}_{2},…,{x}_{n}\\}$ and $y=\\{{y}_{1},{y}_{2},…,{y}_{n}\\}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(4-6)(4-10)+(5-6)(8-10)+(7-6)(12-10)+(8-6)(16-10)] \\\\  & =\\frac{1}{4}[(-2)(-6)+(-1)(-2)+(1)(2)+(2)(6)] \\\\  & =\\frac{1}{4}[12+2+2+12] \\\\  & =\\frac{1}{4}\\cdot 28 \\\\  & =7.\\end{aligned}\n$$"} :step/id #uuid "6dca6571-a5ec-5352-8411-48e22666e7db"} {:db/id #edb/ref 17592186566299 :step/content {:db/id #edb/ref 17592186268978 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20dc8ecd-d3e7-5b4f-99fd-e340125220ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "19" :db/id #edb/ref 17592186266439} {:answer/id #uuid "3bf4b541-acde-57aa-9576-c308680b6c1c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186266669} {:answer/id #uuid "756ab281-4dfc-522d-827d-e6219862d3f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186267179} {:answer/id #uuid "7bdc279d-d8bf-5db2-99d2-0230056971c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186267242} {:answer/id #uuid "9717bf9a-a903-59dd-8538-a467393f5b22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186267495}] :answer-field/correct {:db/id #edb/ref 17592186267242} :answer-field/id #uuid "4eb084b7-92a4-50b3-ab5e-874dc5122653" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268542}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e3d02030-a1e3-5cc4-b308-6cf0c2ca9175" :question/math-academy-id "q-134168" :question/problem "Calculate $\\text{Cov}(x,y)$ for the following data sets:\n\n$$\nx=\\{-4,\\,2,\\,6,\\,8\\},\\,y=\\{2,\\,-9,\\,3,\\,12\\}\n$$" :question/worked-solution "The (population) covariance of the data sets $x=\\{{x}_{1},{x}_{2},…,{x}_{n}\\}$ and $y=\\{{y}_{1},{y}_{2},…,{y}_{n}\\}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nFirst, we need to compute the means:\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{4}\\cdot ((-4)+2+6+8) \\\\  & =\\frac{1}{4}\\cdot 12 \\\\  & =3 \\\\ \\overset{―}{y} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i} \\\\  & =\\frac{1}{4}\\cdot (2+(-9)+3+12) \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(-4-3)(2-2)+(2-3)(-9-2)+(6-3)(3-2)+(8-3)(12-2)] \\\\  & =\\frac{1}{4}[(-7)(0)+(-1)(-11)+(3)(1)+(5)(10)] \\\\  & =\\frac{1}{4}[0+11+3+50] \\\\  & =\\frac{1}{4}\\cdot 64 \\\\  & =16.\\end{aligned}\n$$"} :step/id #uuid "9360c9ad-0d01-58c3-bea9-ccb29100787e" :step/next {:db/id #edb/ref 17592186566296}} {:db/id #edb/ref 17592186566300 :step/content {:db/id #edb/ref 17592186566235 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c9e72d7-60a7-512f-af6c-41536483d13a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186565876} {:answer/id #uuid "7d8c39eb-cc31-5a79-a9bd-500afe12c950" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-0.5" :db/id #edb/ref 17592186565878} {:answer/id #uuid "dc079189-f549-5385-8ccd-d06d3585f132" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186566035} {:answer/id #uuid "f0431254-6c69-543d-b05b-52b952950087" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186566075} {:answer/id #uuid "fe2cb0ca-1fb3-54af-9579-b241fc473f92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186566097}] :answer-field/correct {:db/id #edb/ref 17592186566035} :answer-field/id #uuid "b3bb762e-f253-556e-b239-591405629ea7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566175}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "64eb2650-1408-5539-acdf-62ad07765696" :question/math-academy-id "q-134161" :question/problem "Calculate $\\text{Cov}(x,y)$ for the following data sets:\n\n$$\nx=\\{4,\\,4,\\,-4,\\,4\\},\\,y=\\{-1,\\,-2,\\,7,\\,4\\}\n$$" :question/worked-solution "The (population) covariance of the data sets $x=\\{{x}_{1},{x}_{2},…,{x}_{n}\\}$ and $y=\\{{y}_{1},{y}_{2},…,{y}_{n}\\}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nFirst, we need to compute the means:\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{4}\\cdot (4+4+(-4)+4) \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2 \\\\ \\overset{―}{y} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i} \\\\  & =\\frac{1}{4}\\cdot ((-1)+(-2)+7+4) \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(4-2)(-1-2)+(4-2)(-2-2)+(-4-2)(7-2)+(4-2)(4-2)] \\\\  & =\\frac{1}{4}[(2)(-3)+(2)(-4)+(-6)(5)+(2)(2)] \\\\  & =\\frac{1}{4}[-6-8-30+4] \\\\  & =\\frac{1}{4}\\cdot (-40) \\\\  & =-10.\\end{aligned}\n$$"} :step/id #uuid "96cf8720-bbba-5c5c-9ffc-98b6e94d3c0b" :step/next {:db/id #edb/ref 17592186566299}}] :activity/title "Covariance" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186565672}]}
