      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14284587/observations/step-q338507-4322511148544bd44ff9.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14284587/observations/step-q338507-4322511148544bd44ff9.png",
      "source_url": "https://mathacademy.com/tasks/14284587/topics/626/lesson",
