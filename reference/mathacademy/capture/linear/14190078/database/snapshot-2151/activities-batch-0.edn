#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055618} :activity/id #uuid "a163662d-b871-5e67-90b7-3c408d42da30" :activity/scope {:db/id #edb/ref 17592186049330 :topic/id #uuid "ec62124a-ba1a-5287-92fd-a64e499120c1" :topic/math-academy-id 101} :activity/steps [{:db/id #edb/ref 17592186055618 :step/content {:db/id #edb/ref 17592186055982 :tutorial/content "Suppose we want to solve the following system of equations:\n![](images/01/01eee66dd39797b90503716f097ff604a4f339d8ea0a25ceef9b8ea7a0898ab4.svg)\n\nTo solve systems of equations *graphically*, we first draw each of the equations in the same coordinate system. Then, the solution of the system is given by the common points where the lines intersect.\n\nLet's see how this method works for the system above. To plot the functions given by the equations, we first rewrite them by making ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg) the subject in each equation.\n![](images/c7/c7778dd2c82032ef68ad8221a990abe1b2bafb4e36a7a0e2640a43856be58c5a.svg) \n\nThen, we draw the lines in the same coordinate system:\n\n![](images/47/47fb02cf8bb4668b24034302fd4265ec5261f4d244cd9d9d599afeffd91d2424.png)\n\nThe lines intersect at the point ![](images/d8/d87c68d6226f4bb9ecf52ab576a5ac45c83fbb02c83edd1af04ac235dd518467.svg), which is the solution to our system.\n\n![](images/b3/b3b95135ad9a758f891280b15e8bd6f6165bf9f47a76a1c99280af02dad78911.png)\n\nWe can also use the graphical method to solve systems of equations where the corresponding functions are not straight lines. These types of systems are called **nonlinear systems**. Let's consider such an example." :tutorial/id #uuid "e7d63cd6-92ea-5bb3-adc8-f9d09bf2d24d" :tutorial/math-academy-id 3407 :tutorial/title "Introduction"} :step/id #uuid "8d314c2a-668c-507d-a140-8f47f8422fff" :step/math-academy-id 19145 :step/next {:db/id #edb/ref 17592186055619}} {:db/id #edb/ref 17592186055619 :step/content {:db/id #edb/ref 17592186054664 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054561 :question/id #uuid "e8d3ec4c-5ab2-5bd1-9e8f-32d3526a7ca7" :question/math-academy-id "e-5204"} :knowledge-point/id #uuid "2812e564-d5a3-58f6-a679-f8d3d20c042e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048678} {:db/id #edb/ref 17592186048838}] :knowledge-point/questions [{:db/id #edb/ref 17592186054991} {:db/id #edb/ref 17592186054992} {:db/id #edb/ref 17592186508924} {:db/id #edb/ref 17592186508938} {:db/id #edb/ref 17592186509000}] :knowledge-point/title "Solving Systems of Equations Containing Quadratic Functions"} :step/id #uuid "487c6fc8-1141-5f82-85ea-4e560f81130f" :step/math-academy-id 19148 :step/next {:db/id #edb/ref 17592186055620}} {:db/id #edb/ref 17592186055620 :step/content {:db/id #edb/ref 17592186054665 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054562 :question/id #uuid "fced2a80-0cad-5405-b0bb-c12e4a7cce06" :question/math-academy-id "e-5205"} :knowledge-point/id #uuid "bd4dde78-84d1-5b33-a41a-9f10b24131b6" :knowledge-point/questions [{:db/id #edb/ref 17592186055258} {:db/id #edb/ref 17592186055259} {:db/id #edb/ref 17592186508941} {:db/id #edb/ref 17592186508942}] :knowledge-point/title "Solving System of Equations Graphically"} :step/id #uuid "74edc604-916f-54b2-899e-637369c1a92d" :step/math-academy-id 19149}] :activity/title "Solving Systems of Nonlinear Equations Using Graphs" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054864}]}
