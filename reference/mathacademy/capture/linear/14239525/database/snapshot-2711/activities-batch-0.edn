#{[{:activity/first-step {:db/id #edb/ref 17592186148518} :activity/id #uuid "3176a165-92bf-54c7-a633-b86e48288ee9" :activity/scope {:db/id #edb/ref 17592186048650 :topic/id #uuid "b227b0cb-b6cd-53a5-8a0d-c105c56b3477" :topic/math-academy-id 2465} :activity/steps [{:db/id #edb/ref 17592186148518 :step/content {:db/id #edb/ref 17592186148685 :tutorial/content "A scientist models the number of bacteria in a Petri dish using the function\n\n$$\ny(t) = 1\\,500 \\cdot 3^t\n$$\n\nHere, $y(t)$ gives the number of bacteria in the dish, and $t$ gives the number of days since the start of an experiment.\n\nWithout being given any more information, what can we deduce about the number of bacteria?\n\nThe first thing to notice is that the function above is an exponential growth function:\n\n$$\ny(t) = a \\cdot b^t\n$$\n\nComparing the function that the scientist is using with the general expression above, we can deduce the following:\n\n- $a=1\\,500$ represents the initial value. This tells us the number of bacteria at the start of the experiment.\n- $b = 3$ is the growth factor. This tells us that the number of bacteria increases by a factor of $3$ every day.\n- $t =$ is the time since the start of the observations, in days.\n\nIn this lesson, we'll get practice at interpreting the various parts of an exponential growth expression or function. The trick is to compare a given expression with\n\n$$\ny(t) = a\\cdot b^t\n$$" :tutorial/id #uuid "8371d43f-8a30-5681-87ef-fdaf05292068" :tutorial/math-academy-id 1938 :tutorial/title "Introduction"} :step/id #uuid "967e18a0-db67-52b9-a220-f5574fed735f" :step/math-academy-id 6881 :step/next {:db/id #edb/ref 17592186148520}} {:db/id #edb/ref 17592186148519 :step/content {:db/id #edb/ref 17592186147563 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147200 :question/id #uuid "1bec8657-1367-54e6-a6e3-942d1dcbe76a" :question/math-academy-id "e-1990"} :knowledge-point/id #uuid "373d4839-72d8-57df-bc72-c3312629e29e" :knowledge-point/questions [{:db/id #edb/ref 17592186147816} {:db/id #edb/ref 17592186147817} {:db/id #edb/ref 17592186459209} {:db/id #edb/ref 17592186480704} {:db/id #edb/ref 17592186487303} {:db/id #edb/ref 17592186489204} {:db/id #edb/ref 17592186489246} {:db/id #edb/ref 17592186491187} {:db/id #edb/ref 17592186498601}] :knowledge-point/title "Interpreting the Output of an Exponential Function"} :step/id #uuid "b015487b-7797-5d8c-8f27-79859901fce3" :step/math-academy-id 6883 :step/next {:db/id #edb/ref 17592186148531}} {:db/id #edb/ref 17592186148520 :step/content {:db/id #edb/ref 17592186147564 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147201 :question/id #uuid "af8404c1-6ca6-5d05-89c9-80de4c0e0fda" :question/math-academy-id "e-1991"} :knowledge-point/id #uuid "630c2d01-a650-582e-95ec-0156b1afa26d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048302}] :knowledge-point/questions [{:db/id #edb/ref 17592186147806} {:db/id #edb/ref 17592186147807}] :knowledge-point/title "Interpreting an Exponential Growth Expression"} :step/id #uuid "179e36f6-9acf-5f57-8fbd-951081caee77" :step/math-academy-id 6884 :step/next {:db/id #edb/ref 17592186148521}} {:db/id #edb/ref 17592186148521 :step/content {:db/id #edb/ref 17592186147565 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147202 :question/id #uuid "d3ba93df-8786-58c5-84cf-6427d5642459" :question/math-academy-id "e-1992"} :knowledge-point/id #uuid "8595b94a-f888-5cfb-b210-61970e15824c" :knowledge-point/questions [{:db/id #edb/ref 17592186147808} {:db/id #edb/ref 17592186147809} {:db/id #edb/ref 17592186558483}] :knowledge-point/title "Interpreting the Exponential Part of an Expression"} :step/id #uuid "e7eadd18-d952-5c8a-b3d9-ba0467187ca6" :step/math-academy-id 6885 :step/next {:db/id #edb/ref 17592186148519}} {:db/id #edb/ref 17592186148531 :step/content {:db/id #edb/ref 17592186147572 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147209 :question/id #uuid "768a334f-5b8f-5ff3-bf08-1230fe3674b9" :question/math-academy-id "e-2074"} :knowledge-point/id #uuid "934bce73-93c8-55ec-af95-13709d2887c0" :knowledge-point/questions [{:db/id #edb/ref 17592186148109} {:db/id #edb/ref 17592186148110} {:db/id #edb/ref 17592186489175}] :knowledge-point/title "Interpreting the Growth Rate In an Exponential Expression"} :step/id #uuid "d6a2e9ff-cef4-5f1e-a5c7-31c47383e32f" :step/math-academy-id 7126}] :activity/title "Interpreting Exponential Growth" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186147665}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186489361} :activity/id #uuid "e9225a93-dc03-57da-bec9-4f535a279d72" :activity/scope {:db/id #edb/ref 17592186048650 :topic/id #uuid "b227b0cb-b6cd-53a5-8a0d-c105c56b3477" :topic/math-academy-id 2465} :activity/steps [{:db/id #edb/ref 17592186489341 :step/content {:db/id #edb/ref 17592186489246 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "036eafb8-c49d-58cf-aba0-dbb85b8a6d63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,560" :db/id #edb/ref 17592186488476} {:answer/id #uuid "18adfc4b-40de-5736-b8ad-16bd94bf6b24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\,653" :db/id #edb/ref 17592186488523} {:answer/id #uuid "19915433-b6de-5ef5-93c0-b49e9f51d44a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\,096" :db/id #edb/ref 17592186488525} {:answer/id #uuid "292544c4-976c-5a08-ba6c-8e830e5ab925" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\,536" :db/id #edb/ref 17592186488557} {:answer/id #uuid "929acbf8-3e5b-5715-a98b-c7c7b5f2beba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,460" :db/id #edb/ref 17592186488764}] :answer-field/correct {:db/id #edb/ref 17592186488557} :answer-field/id #uuid "d469c932-3585-58b1-be22-0b73b73c3ef8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489139}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "978bca7b-e158-5bd2-ae01-fa65d0556739" :question/math-academy-id "q-45697" :question/problem "The population $M(t)$ of a colony of rodents is given by $M(t)=1\\,000\\cdot (1.6)^{t}$, where $t$ is the time in years since the beginning of the observations. How many additional rodents will be born in the colony between years $2$ and $3?$" :question/worked-solution "To find the growth in the population of rodents between year $2$ and year $3$, we need to subtract the population after year $2$ from the population after year $3.$ So we need to calculate\n\n$$\nM(3)-M(2).\n$$\n\nFirst, we find the population after the second year, $M(2)$:\n\n$$\n\\begin{aligned}M(2) & =1\\,000\\cdot (1.6)^{(2)} \\\\  & =1\\,000\\cdot 2.56 \\\\  & =2\\,560\\end{aligned}\n$$\n\nNext, we find $M(3),$ the population after the third year:\n\n$$\n\\begin{aligned}M(3) & =1\\,000\\cdot (1.6)^{(3)} \\\\  & =1\\,000\\cdot 4.096 \\\\  & =4\\,096\\end{aligned}\n$$\n\nTherefore, the growth in the population between year $2$ and year $3$ is\n\n$$\n\\begin{aligned}M(3)-M(2) & =4\\,096-2\\,560=1\\,536.\\end{aligned}\n$$\n\nSo, the population of rodents increased by $1\\,536$ between years $2$ and $3.$"} :step/id #uuid "92b6b921-bfab-5106-aebc-d9c7e4e38733" :step/next {:db/id #edb/ref 17592186489357}} {:db/id #edb/ref 17592186489357 :step/content {:db/id #edb/ref 17592186489175 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e8344b2-9e67-5157-94a5-d4ffcc91bb42" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The area covered by the bushes grows at a rate of $11%$ per year" :db/id #edb/ref 17592186488535} {:answer/id #uuid "90b44fdb-a8cc-514c-95fd-f7202dd8720f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The area covered by the bushes grows at a rate of $10%$ per year" :db/id #edb/ref 17592186488759} {:answer/id #uuid "b4c80e48-faec-5b72-aef4-f19de49c3f3f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The area covered by the bushes increases by a factor of $1.1$ every $8$ years" :db/id #edb/ref 17592186488834} {:answer/id #uuid "bc4ad3b6-0cd3-5e75-bd2f-774f75c48689" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The area covered by the bushes grows at a rate of $8%$ per year" :db/id #edb/ref 17592186488849} {:answer/id #uuid "fdfb7f6b-b500-55a3-b9aa-cd8cc691d7b6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The area covered by the bushes grows at a rate of $1.1%$ per year" :db/id #edb/ref 17592186489010}] :answer-field/correct {:db/id #edb/ref 17592186488759} :answer-field/id #uuid "365bcff0-9da9-51b5-b700-1716404308aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489046}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "065bbf88-3b11-5079-b0c1-f463dc0506a1" :question/math-academy-id "q-64102" :question/problem "The total area, in square meters,  covered by blueberry bushes in a forest can be modeled by the expression $800\\cdot (1.1)^{t},$ where $t$ is the number of years since the year $2015.$ What does the base of the exponential expression $(1.1)$ mean in this context?" :question/worked-solution "The answer choices require interpretation as a percent, and so we use the growth rate formula.\n\nThe given expression is an exponential growth expression of the form $y(t)=a\\cdot (1+r)^{t}$, where:\n\n- $a=800$ represents the initial area covered by the  blueberry bushes\n\n- $1+r=1.1,$ where $r$ is the growth rate\n\n- $t$ is the number of years since $2015$\n\nSolving for $r$:\n\n$$\n1+r=1.1\\,⟹\\,r=0.1\n$$\n\nNow, $0.1$ (expressed as a percent) is equal to $10%.$ Therefore, the area covered by the bushes grows at a rate of $10%$ per year."} :step/id #uuid "b2e8828f-e8f0-5f6b-8f2a-4544652c7ffc"} {:db/id #edb/ref 17592186489361 :step/content {:db/id #edb/ref 17592186489204 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01c8a340-3d84-5653-a1c7-a6b291ebaf8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11\\,{\\text{km}}^{2}" :db/id #edb/ref 17592186488471} {:answer/id #uuid "2888b44b-0869-5796-ade9-2cdfc7016b90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12.1\\,{\\text{km}}^{2}" :db/id #edb/ref 17592186488555} {:answer/id #uuid "782c49fd-1ec9-542f-9446-c12766d3d684" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.1\\,{\\text{km}}^{2}" :db/id #edb/ref 17592186488708} {:answer/id #uuid "7ca68bbc-a218-5b0c-a014-725824cd865d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.1\\,{\\text{km}}^{2}" :db/id #edb/ref 17592186488720} {:answer/id #uuid "bc8370e9-2478-56a9-9b58-f413970d8e02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\,{\\text{km}}^{2}" :db/id #edb/ref 17592186488852}] :answer-field/correct {:db/id #edb/ref 17592186488720} :answer-field/id #uuid "1bf52d0f-f83a-5aa3-b11c-feea28b4ef8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489035}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "38bb781d-e24d-5ca2-821e-7901089bd6a3" :question/math-academy-id "q-45601" :question/problem "The area of an oil patch, measured in square kilometers, is given by the function $A(t)=10\\cdot (1.1)^{t}$, where $t$ is the time in days since the pollution occurred. How many square kilometers does the area increase by between day $1$ and day $2?$" :question/worked-solution "To find the growth of the patch between day $1$ and day $2$, we need to subtract the area after day $1$ from the area after day $2.$ So we need to calculate\n\n$$\nA(2)-A(1).\n$$\n\nFirst, we find the area after the first day, $A(1)$:\n\n$$\n\\begin{aligned}A(1) & =10\\cdot (1.1)^{1} \\\\  & =10\\cdot 1.1 \\\\  & =11\\end{aligned}\n$$\n\nNext, we find $A(2),$ the area after the second day:\n\n$$\n\\begin{aligned}A(2) & =10\\cdot (1.1)^{2} \\\\  & =10\\cdot 1.21 \\\\  & =12.1\\end{aligned}\n$$\n\nTherefore, the growth of the patch between day $1$ and day $2$ is\n\n$$\n\\begin{aligned}A(2)-A(1) & =12.1-11=1.1.\\end{aligned}\n$$\n\nSo, the area increased by $1.1$ square kilometer between day $1$ and day $2.$"} :step/id #uuid "c81e5c67-ac42-5acf-b9ba-dd9c76587fb0" :step/next {:db/id #edb/ref 17592186489341}}] :activity/title "Interpreting Exponential Growth" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186488465}] [{:activity/expected-seconds 900.0 :activity/first-step {:db/id #edb/ref 17592186101573} :activity/id #uuid "89da6fec-55ed-53dd-b5e1-c3ef975373c3" :activity/scope {:db/id #edb/ref 17592186048677 :topic/id #uuid "b3fe0bdc-d6d3-510d-ba60-be31a59b4ba0" :topic/math-academy-id 1157} :activity/steps [{:db/id #edb/ref 17592186101573 :step/content {:db/id #edb/ref 17592186101977 :tutorial/content "One interesting number pattern is **Pascal's triangle**, named after Blaise Pascal, a famous French mathematician.\n\nPascal's triangle is made by rows of numbers that form a triangle.\nEach row has one more number than the row above.\nThe first two rows are made of three $1$s in a triangle:\n\n$$\n\\begin{aligned} &  & 1 \\\\  & 1 &  & 1 \\\\ ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nLet's construct the next row.\nThe first and last number in each row is always $1.$ \n\n$$\n\\begin{aligned} &  &  & 1 \\\\  &  & 1 &  & 1 \\\\  & 1 &  & ◻ &  & 1 \\\\ ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nThe other numbers are always greater than $1$ and can be found by adding the two closest numbers located in the previous row.\n\nIn our case, the numbers closest to the unknown number and located in the previous row are ${\\color{blue}1}$ and ${\\color{blue}1}.$\nTherefore, the unknown number is the sum of $\\color{blue}1$ and ${\\color{blue}1}\\mathbin{:}$\n\n$$\n{\\large\\square} = {\\color{blue}1} + {\\color{blue}1} = 2\n$$\n\nNow, we have the first three rows of Pascal's triangle.\n\n$$\n\\begin{aligned} &  &  & 1 \\\\  &  & 1 &  & 1 \\\\  & 1 &  & 2 &  & 1 \\\\ ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nIf we continue repeating this process for each row, we will get the following results for the first six rows of Pascal's triangle:\n\n$$\n\\begin{aligned} &  &  &  &  &  & 1 \\\\  &  &  &  &  & 1 &  & 1 \\\\  &  &  &  & 1 &  & 2 &  & 1 \\\\  &  &  & 1 &  & 3 &  & 3 &  & 1 \\\\  &  & 1 &  & 4 &  & 6 &  & 4 &  & 1 \\\\  & 1 &  & 5 &  & 10 &  & 10 &  & 5 &  & 1 \\\\ ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$" :tutorial/id #uuid "f708f697-814a-58cd-8926-d278c8e15fc4" :tutorial/math-academy-id 3392 :tutorial/title "Introduction"} :step/id #uuid "9bab1b86-237d-59f2-b5b8-117d4edfdf46" :step/math-academy-id 105243 :step/next {:db/id #edb/ref 17592186101574}} {:db/id #edb/ref 17592186101574 :step/content {:db/id #edb/ref 17592186100805 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100715 :question/id #uuid "4014e57c-3c50-5358-a9ae-280610aa6cfb" :question/math-academy-id "e-5107"} :knowledge-point/id #uuid "0392894c-6bbc-544a-8ab5-c0d2be332967" :knowledge-point/questions [{:db/id #edb/ref 17592186101525} {:db/id #edb/ref 17592186101526} {:db/id #edb/ref 17592186492024} {:db/id #edb/ref 17592186492069}] :knowledge-point/title "Finding the Missing Number in a Pascal's Triangle"} :step/id #uuid "fdd95bd0-6aef-5462-959d-c840b6c96482" :step/math-academy-id 105244 :step/next {:db/id #edb/ref 17592186101575}} {:db/id #edb/ref 17592186101575 :step/content {:db/id #edb/ref 17592186101975 :tutorial/content "Multiplying a binomial by itself $n$ times is known as a **binomial expansion**.\nFor instance, multiplying the binomial $(a + b)$ by itself gives\n\n$$\n(a + b)^2 = a^2 + 2ab + b^2.\n$$\n\nLet's consider the binomial expansion of \n\n$$\n(a+b)^n,\n$$\n\nwhere $n$ is a positive integer.\n\nTo write out the expansion, we use two patterns to simplify most of the hard work: the **exponent pattern** and the **coefficient pattern**.\n\n- The **exponent pattern** is\n \n\n$$\na^{\\color{red}n}b^{\\color{blue}0},\\quad  a^{\\color{red}{n-1}}b^{{\\color{blue}1}}, \\quad   a^{{\\color{red}n-2}}b^{\\color{blue}2}, \\quad  \\dots\\quad   a^{\\color{red}2}b^{{\\color{blue}n-2}},\\quad    a^{\\color{red}1}b^{{\\color{blue}n - 1}}, \\quad   a^{\\color{red}0}b^{{\\color{blue}n}}.\n$$\n\nThe exponents of $a$ start at $n$ and go down ($n, n-1, \\cdots, 1, 0$) while the exponents of $b$ increase from $0$ to $n.$ In every term, the two exponents always add up to $n.$\n\n- The **coefficient pattern** can be found using Pascal's Triangle:\n \n\n$$\n\\begin{aligned} &  &  &  &  &  & 1 \\\\  &  &  &  &  & 1 &  & 1 \\\\  &  &  &  & 1 &  & 2 &  & 1 \\\\  &  &  & 1 &  & 3 &  & 3 &  & 1 \\\\  &  & 1 &  & 4 &  & 6 &  & 4 &  & 1 \\\\  & 1 &  & 5 &  & 10 &  & 10 &  & 5 &  & 1 \\\\ ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nWe take the top row to be the $0$th row. Then, the $n$th row of Pascal's Triangle are the coefficients of $(a+b)^n.$\n\nLet's use this to expand the binomial \n\n$$\n(a+b)^3.\n$$\n\nThe exponent pattern is\n\n$$\na^{\\color{red}3}b^{\\color{blue}0},\\quad  a^{\\color{red}2}b^{\\color{blue}1}, \\quad a^{\\color{red}1}b^{\\color{blue}2}, \\quad  a^{\\color{red}0}b^{\\color{blue}3}.\n$$\n\nSince $n=3,$ the coefficient pattern is found using the $3$rd row in Pascal's Triangle: $(1,3,3,1).$ \n\nTherefore,\n\n$$\n(a + b)^3  \n= \\mathbf{1}a^{\\color{red}3}b^{\\color{blue}0} + \\mathbf{3}a^{\\color{red}2}b^{\\color{blue}1} + \\mathbf{3}a^{\\color{red}1}b^{\\color{blue}2} + \\mathbf{1}a^{\\color{red}0}b^{\\color{blue}3}.\n$$\n\nFinally, simplifying the above gives\n\n$$\n(a + b)^3= a^{3} + 3a^{2}b + 3ab^{2} + b^{3} ,\n$$\n\nand we're done!" :tutorial/id #uuid "5a75ca66-5c0a-578d-ad4a-170fe5297413" :tutorial/math-academy-id 3385 :tutorial/title "Expanding Binomials Using Pascal’s Triangle"} :step/id #uuid "cfeca023-2ab0-5fb8-acc2-eb8b7cb7c2b7" :step/math-academy-id 105247 :step/next {:db/id #edb/ref 17592186101576}} {:db/id #edb/ref 17592186101576 :step/content {:db/id #edb/ref 17592186101990 :tutorial/content "The following table shows the first six binomial expansions.\n\n| **Power** | **Pascal's Triangle** | **Binomial** | **Binomial Expansion** |\n| --- | --- | --- | --- |\n| $0$ | $\\mathbf{1}$ | $(a + b)^0$ | $\\mathbf{1}$ |\n| $1$ | $\\mathbf{1}\\quad\\mathbf{1}$ | $(a + b)^1$ | $\\mathbf{1}a + \\mathbf{1}b$ |\n| $2$ | $\\mathbf{1}\\quad\\mathbf{2}\\quad\\mathbf{1}$ | $(a + b)^2$ | $\\mathbf{1}a^2 + \\mathbf{2}ab + \\mathbf{1}b^2$ |\n| $3$ | $\\mathbf{1}\\quad\\mathbf{3}\\quad\\mathbf{3}\\quad\\mathbf{1}$ | $(a + b)^3$ | $\\mathbf{1}a^3 + \\mathbf{3}a^2b + \\mathbf{3}ab^2 + \\mathbf{1}b^3$ |\n| $4$ | $\\mathbf{1}\\quad\\mathbf{4}\\quad\\mathbf{6}\\quad\\mathbf{4}\\quad\\mathbf{1}$ | $(a + b)^4$ | $\\mathbf{1}a^4 + \\mathbf{4}a^3b + \\mathbf{6}a^2b^2 + \\mathbf{4}ab^3 + \\mathbf{1}b^4$ |\n| $5$ | $\\mathbf{1}\\quad\\!\\mathbf{5}\\quad\\!\\mathbf{10}\\!\\quad\\!\\mathbf{10}\\quad\\!\\mathbf{5}\\quad\\!\\mathbf{1}$ | $(a + b)^5$ | $\\mathbf{1}a^5 \\!+\\! \\mathbf{5}a^4b \\!+\\! \\mathbf{10}a^3b^2 \\!+\\! \\mathbf{10}a^2b^3 \\!+\\! \\mathbf{5}ab^4 \\!+\\! \\mathbf{1}b^5$ |" :tutorial/id #uuid "249c4559-4588-59e9-ae28-c70bc71b66d6" :tutorial/math-academy-id 3895 :tutorial/title "Table of Results"} :step/id #uuid "ad9aecb2-af07-5420-8809-96b51b344aea" :step/math-academy-id 105248 :step/next {:db/id #edb/ref 17592186101577}} {:db/id #edb/ref 17592186101577 :step/content {:db/id #edb/ref 17592186100806 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100716 :question/id #uuid "57c2e733-51b4-51f5-8774-ebbd6da2321d" :question/math-academy-id "e-5152"} :knowledge-point/id #uuid "f386de30-38b8-59b7-a6e8-ea5e386671d5" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049847} {:db/id #edb/ref 17592186050802}] :knowledge-point/questions [{:db/id #edb/ref 17592186101390} {:db/id #edb/ref 17592186101400} {:db/id #edb/ref 17592186492054} {:db/id #edb/ref 17592186503745} {:db/id #edb/ref 17592186548006} {:db/id #edb/ref 17592186548051}] :knowledge-point/title "Expanding a Binomial With One Variable"} :step/id #uuid "9cb6d0cd-cd5c-55dc-b0de-0c0f8e98c8f9" :step/math-academy-id 105249 :step/next {:db/id #edb/ref 17592186101578}} {:db/id #edb/ref 17592186101578 :step/content {:db/id #edb/ref 17592186100807 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100719 :question/id #uuid "bc866f37-17b6-59e0-9088-fd71a46c5b9a" :question/math-academy-id "e-5158"} :knowledge-point/id #uuid "dcb621ad-bcc5-57ea-9274-d2bbe93df2ce" :knowledge-point/questions [{:db/id #edb/ref 17592186101117} {:db/id #edb/ref 17592186101391} {:db/id #edb/ref 17592186492006} {:db/id #edb/ref 17592186492045} {:db/id #edb/ref 17592186492046} {:db/id #edb/ref 17592186503727} {:db/id #edb/ref 17592186503741} {:db/id #edb/ref 17592186548014} {:db/id #edb/ref 17592186555804} {:db/id #edb/ref 17592186558541}] :knowledge-point/title "Expanding a Binomial With More Than One Variable"} :step/id #uuid "c9695aa6-0e5e-5dde-9090-7b976e64abda" :step/math-academy-id 105252 :step/next {:db/id #edb/ref 17592186101579}} {:db/id #edb/ref 17592186101579 :step/content {:db/id #edb/ref 17592186100808 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100720 :question/id #uuid "b3546d6e-8399-5694-85db-c73f0a57b95c" :question/math-academy-id "e-5159"} :knowledge-point/id #uuid "7a99f4eb-5f34-565e-9375-7a35ec93a8c6" :knowledge-point/questions [{:db/id #edb/ref 17592186101114} {:db/id #edb/ref 17592186101116} {:db/id #edb/ref 17592186491994} {:db/id #edb/ref 17592186492016} {:db/id #edb/ref 17592186492029} {:db/id #edb/ref 17592186492051}] :knowledge-point/title "Finding the Coefficient of a Particular Term in a Binomial Expansion"} :step/id #uuid "0b37dfbf-fe94-576b-a926-3f916a97dffa" :step/math-academy-id 105255}] :activity/title "Expanding Binomials Using Pascal's Triangle" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186101026}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186503805} :activity/id #uuid "9b7f87c5-a873-5d35-a338-1eb6f31f95ee" :activity/scope {:db/id #edb/ref 17592186048677 :topic/id #uuid "b3fe0bdc-d6d3-510d-ba60-be31a59b4ba0" :topic/math-academy-id 1157} :activity/steps [{:db/id #edb/ref 17592186503765 :step/content {:db/id #edb/ref 17592186503727 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e0b8e5d-ea62-586b-acf8-47c7448fb9eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "328" :db/id #edb/ref 17592186503038} {:answer/id #uuid "3ad5cbb7-83ea-5127-9a88-0dafeb6f2337" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "136" :db/id #edb/ref 17592186503091} {:answer/id #uuid "6adb48dc-a33c-5da7-ae77-576efafa9e3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "168" :db/id #edb/ref 17592186503190} {:answer/id #uuid "83db7d2e-5441-54f0-9b72-b23bdd133079" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "320" :db/id #edb/ref 17592186503250} {:answer/id #uuid "eddbbe69-969c-5b54-965b-bba69c119ec3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "128" :db/id #edb/ref 17592186503469}] :answer-field/correct {:db/id #edb/ref 17592186503091} :answer-field/id #uuid "056e7899-7359-5aa3-9d75-0e24b35490d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186503516}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ab532852-8985-56d4-9487-9412ea181516" :question/math-academy-id "q-3564" :question/problem "Given that \n\n$$\n{(2{t}^{2}-3s)}^{4}=A{t}^{8}+B{t}^{6}s+C{t}^{4}{s}^{2}-216{t}^{2}{s}^{3}+81{s}^{4}\n$$\n\nwhere $A,B$ and $C$ are constants, determine the value of $A+B+C.$" :question/worked-solution "First, let's compare our expression with the binomial\n\n$$\n(a+b)^{n}.\n$$\n\nHere we have that $n=4,$ $a=2{t}^{2},$ and $b=-3s.$ So, the exponents of the binomial expansion must follow the pattern\n\n$$\n{a}^{4}{b}^{0},\\,{a}^{3}{b}^{1},\\,{a}^{2}{b}^{2},\\,{a}^{1}{b}^{3},\\,{a}^{0}{b}^{4}.\n$$\n\nThe $4$th row in Pascal's Triangle is $(1,4,6,4,1).$ Therefore,\n\n$$\n\\begin{aligned}(2{t}^{2}-3s)^{4} & =1{a}^{4}+4{a}^{3}b+6{a}^{2}{b}^{2}+4a{b}^{3}+1{b}^{4} \\\\  & =1{(2{t}^{2})}^{4}(-3s)^{0}+4{(2{t}^{2})}^{3}(-3s)^{1}+6{(2{t}^{2})}^{2}(-3s)^{2} \\\\  & \\,+4{(2{t}^{2})}^{1}(-3s)^{3}+1{(2{t}^{2})}^{0}(-3s)^{4} \\\\  & =1(16{t}^{8})(1)+4(8{t}^{6})(-3s)+6(4{t}^{4})(9{s}^{2}) \\\\  & \\,+4(2{t}^{2})(-27{s}^{3})+1(1)(81{s}^{4}) \\\\  & =16{t}^{8}-96{t}^{6}s+216{t}^{4}{s}^{2}-216{t}^{2}{s}^{3}+81{s}^{4}.\\end{aligned}\n$$\n\nTherefore, $A=16,B=-96,$ and $C=216.$ Finally,\n\n$$\nA+B+C=16-96+216=136.\n$$"} :step/id #uuid "0fcd4859-f70e-5b53-af4b-3bf056bd41ce" :step/next {:db/id #edb/ref 17592186503841}} {:db/id #edb/ref 17592186503805 :step/content {:db/id #edb/ref 17592186503745 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b600bcd-5006-5baf-9dca-4aab5033031d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{32}+\\frac{25y}{8}+125{y}^{2}" :db/id #edb/ref 17592186503008} {:answer/id #uuid "4c839c43-5c26-510d-85ac-e2e3c39a216c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{32}+\\frac{25y}{4}+145{y}^{2}" :db/id #edb/ref 17592186503128} {:answer/id #uuid "4fb998d5-d716-53e2-a50b-72e1271eb277" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{32}+\\frac{25y}{8}-100{y}^{2}" :db/id #edb/ref 17592186503133} {:answer/id #uuid "5135b701-cd58-5dde-8d9b-989995318cb4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{32}+\\frac{25y}{4}+100{y}^{2}" :db/id #edb/ref 17592186503136} {:answer/id #uuid "9799692b-0119-5014-ae4f-3ef5e9145c63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{32}+\\frac{25y}{8}+145{y}^{2}" :db/id #edb/ref 17592186503281}] :answer-field/correct {:db/id #edb/ref 17592186503008} :answer-field/id #uuid "ef1b5443-9d42-51aa-ac69-73ecc6958d74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186503635}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d6a9fa51-d96f-5308-9675-af7e9df7f105" :question/math-academy-id "q-3563" :question/problem "Find, in ascending powers of $y,$ the first three terms of the binomial expansion of ${(10y+\\frac{1}{2})}^{5}.$" :question/worked-solution "First, let's compare our expression with the binomial\n\n$$\n(a+b)^{n}.\n$$\n\nHere we have that $n=5,$ $a=10y,$ and $b=\\frac{1}{2}.$ So, the exponents of the binomial expansion must follow the pattern\n\n$$\n{a}^{5}{b}^{0},\\,{a}^{4}{b}^{1},\\,{a}^{3}{b}^{2},\\,{a}^{2}{b}^{3},\\,{a}^{1}{b}^{4},\\,{a}^{0}{b}^{5}.\n$$\n\nThe $5$th row in Pascal's Triangle is $(1,5,10,10,5,1).$ Therefore,\n\n$$\n\\begin{aligned}{(10y+\\frac{1}{2})}^{5} & =1{a}^{5}+5{a}^{4}b+10{a}^{3}{b}^{2}+10{a}^{2}{b}^{3}+5a{b}^{4}+1{b}^{5} \\\\  & =1(10y)^{5}{(\\frac{1}{2})}^{0}+5(10y)^{4}{(\\frac{1}{2})}^{1}+10(10y)^{3}{(\\frac{1}{2})}^{2} \\\\  & \\,+10(10y)^{2}{(\\frac{1}{2})}^{3}+5(10y)^{1}{(\\frac{1}{2})}^{4}+1(10y)^{0}{(\\frac{1}{2})}^{5} \\\\  & =1(100\\,000{y}^{5})(1)+5(10\\,000{y}^{4})(\\frac{1}{2})+10(1\\,000{y}^{3})(\\frac{1}{4}) \\\\  & \\,+10(100{y}^{2})(\\frac{1}{8})+5(10y)(\\frac{1}{16})+1(1)(\\frac{1}{32}) \\\\  & =100\\,000{y}^{5}+\\frac{50\\,000{y}^{4}}{2}+\\frac{10\\,000{y}^{3}}{4}+\\frac{1\\,000{y}^{2}}{8}+\\frac{50y}{16}+\\frac{1}{32} \\\\  & =100\\,000{y}^{5}+25\\,000{y}^{4}+2\\,500{y}^{3}+125{y}^{2}+\\frac{25y}{8}+\\frac{1}{32}.\\end{aligned}\n$$\n\nFinally, in ascending powers of $y$, the first three terms are\n\n$$\n\\frac{1}{32}+\\frac{25y}{8}+125{y}^{2}.\n$$"} :step/id #uuid "8cc0e099-5714-599b-80b4-eb693886b0be" :step/next {:db/id #edb/ref 17592186503765}} {:db/id #edb/ref 17592186503841 :step/content {:db/id #edb/ref 17592186503741 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bac5b62-4ee8-545a-966d-5c12ee806664" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{3}-3{y}^{2}x-10y{x}^{2}" :db/id #edb/ref 17592186503009} {:answer/id #uuid "24ced81d-498a-516a-95d5-fb01dede7a9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{3}-3{y}^{2}x+3y{x}^{2}" :db/id #edb/ref 17592186503051} {:answer/id #uuid "5e2cc4e3-3a7b-5190-9ba6-ed8c80cfcd59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{3}-3{y}^{2}x-6y{x}^{2}" :db/id #edb/ref 17592186503165} {:answer/id #uuid "6331dd90-d13b-5bdb-bc74-b83aa99db890" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{3}-4{y}^{2}x+10y{x}^{2}" :db/id #edb/ref 17592186503172} {:answer/id #uuid "c137176e-2ac9-58c5-84bd-949dafa76422" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{3}-4{y}^{2}x+6y{x}^{2}" :db/id #edb/ref 17592186503368}] :answer-field/correct {:db/id #edb/ref 17592186503051} :answer-field/id #uuid "8b892af4-e657-5e7b-967c-44dc67970e0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186503583}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c989ddc2-999c-5079-ab1b-dc05c9512624" :question/math-academy-id "q-12884" :question/problem "Find, in descending powers of $y$ and ascending powers of $x,$ the first three terms of the binomial expansion of ${(y-x)}^{3}.$" :question/worked-solution "First, let's compare our expression with the binomial\n\n$$\n(a+b)^{n}.\n$$\n\nHere we have that $n=3,$ $a=y,$ and $b=-x.$ So, the exponents of the binomial expansion must follow the pattern\n\n$$\n{a}^{3}{b}^{0},\\,{a}^{2}{b}^{1},\\,{a}^{1}{b}^{2},\\,{a}^{0}{b}^{3}.\n$$\n\nThe $3$rd row in Pascal's Triangle is $(1,3,3,1).$ Therefore,\n\n$$\n\\begin{aligned}{(y-x)}^{3} & =1{a}^{3}+3{a}^{2}b+3a{b}^{2}+1{b}^{3} \\\\  & =1(y)^{3}(-x)^{0}+3(y)^{2}(-x)^{1}+3(y)^{1}(-x)^{2}+1(y)^{0}(-x)^{3} \\\\  & =1({y}^{3})(1)+3({y}^{2})(-x)+3(y)({x}^{2})+1(1)(-{x}^{3}) \\\\  & ={y}^{3}-3{y}^{2}x+3y{x}^{2}-{x}^{3}.\\end{aligned}\n$$\n\nFinally, in descending powers of $y$ and ascending powers of $x,$ the first three terms are\n\n$$\n{y}^{3}-3{y}^{2}x+3y{x}^{2}.\n$$"} :step/id #uuid "febb20a8-7bec-598d-9521-3df7ff50a618"}] :activity/title "Expanding Binomials Using Pascal's Triangle" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186502971}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186548144} :activity/id #uuid "03b3f378-60b1-52ee-9696-118ad875a350" :activity/scope {:db/id #edb/ref 17592186048677 :topic/id #uuid "b3fe0bdc-d6d3-510d-ba60-be31a59b4ba0" :topic/math-academy-id 1157} :activity/steps [{:db/id #edb/ref 17592186548144 :step/content {:db/id #edb/ref 17592186548006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e77a6f5-b85a-52a5-a006-9b7d292f2cc8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{401}{16}" :db/id #edb/ref 17592186547345} {:answer/id #uuid "13ad4530-88a4-53d4-8e25-b235bdfe115f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{209}{8}" :db/id #edb/ref 17592186547355} {:answer/id #uuid "16ac0b96-91a3-5dfc-b5ef-29cbc766835a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{417}{16}" :db/id #edb/ref 17592186547364} {:answer/id #uuid "80d7caca-10f2-5451-a96d-795017485bf5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{449}{16}" :db/id #edb/ref 17592186547591} {:answer/id #uuid "92e2c5b9-18da-53a6-8dd8-6cb2c77bfba7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{401}{8}" :db/id #edb/ref 17592186547642}] :answer-field/correct {:db/id #edb/ref 17592186547364} :answer-field/id #uuid "69965209-526e-5658-899a-44e6dd8b07be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186547892}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "510f41a7-5712-55db-b50d-5c80967bb9fb" :question/math-academy-id "q-12889" :question/problem "Given that\n\n$$\n{(\\frac{{x}^{2}}{2}+4)}^{4}=A{x}^{8}+B{x}^{6}+C{x}^{4}+128{x}^{2}+256\n$$\n\nwhere $A,B$ and $C$ are constants, find the value of $A+B+C.$" :question/worked-solution "First, let's compare our expression with the binomial\n\n$$\n(a+b)^{n}.\n$$\n\nHere we have that $n=4,$ $a=\\frac{{x}^{2}}{2},$ and $b=4.$ So, the exponents of the binomial expansion must follow the pattern\n\n$$\n{a}^{4}{b}^{0},\\,{a}^{3}{b}^{1},\\,{a}^{2}{b}^{2},\\,{a}^{1}{b}^{3},\\,{a}^{0}{b}^{4}.\n$$\n\nThe $4$th row in Pascal's Triangle is $(1,4,6,4,1).$ Therefore,\n\n$$\n\\begin{aligned}{(\\frac{{x}^{2}}{2}+4)}^{4} & =1{a}^{4}+4{a}^{3}b+6{a}^{2}{b}^{2}+4a{b}^{3}+1{b}^{4} \\\\  & =1{(\\frac{{x}^{2}}{2})}^{4}(4)^{0}+4{(\\frac{{x}^{2}}{2})}^{3}{(4)}^{1}+6{(\\frac{{x}^{2}}{2})}^{2}{(4)}^{2} \\\\  & \\,+4{(\\frac{{x}^{2}}{2})}^{1}{(4)}^{3}+1{(\\frac{{x}^{2}}{2})}^{0}{(4)}^{4} \\\\  & =1(\\frac{{x}^{8}}{16})(1)+4(\\frac{{x}^{6}}{8})(4)+6(\\frac{{x}^{4}}{4})(16) \\\\  & \\,+4(\\frac{{x}^{2}}{2})(64)+1(1)(256) \\\\  & =\\frac{{x}^{8}}{16}+\\frac{16{x}^{6}}{8}+\\frac{96{x}^{4}}{4}+\\frac{256{x}^{2}}{2}+256 \\\\  & =\\frac{{x}^{8}}{16}+2{x}^{6}+24{x}^{4}+128{x}^{2}+256.\\end{aligned}\n$$\n\nTherefore, we have $A=\\frac{1}{16},B=2$ and $C=24.$ So, finally\n\n$$\nA+B+C=\\frac{1}{16}+2+24=\\frac{417}{16}.\n$$"} :step/id #uuid "a849bf07-e1b9-58de-b318-85fa4f3d86aa" :step/next {:db/id #edb/ref 17592186548176}} {:db/id #edb/ref 17592186548176 :step/content {:db/id #edb/ref 17592186548051 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7869ea61-e97c-524e-a14d-1788d8383e87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{z}^{8}-4{z}^{6}+6{z}^{4}" :db/id #edb/ref 17592186547577} {:answer/id #uuid "863fbced-ba48-51fa-ac1c-071cd8741980" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{z}^{8}+2{z}^{6}-6{z}^{4}" :db/id #edb/ref 17592186547605} {:answer/id #uuid "a2e736b8-e40c-51d3-9a0e-4ad64eae66bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{z}^{8}-4{z}^{6}+18{z}^{4}" :db/id #edb/ref 17592186547671} {:answer/id #uuid "bbf1cdb0-233a-556a-92fd-fadf68dcfca7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{z}^{8}-4{z}^{6}+12{z}^{4}" :db/id #edb/ref 17592186547718} {:answer/id #uuid "fd90e06c-4204-5316-a4d6-0173539fd070" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{z}^{8}+2{z}^{6}-4{z}^{4}" :db/id #edb/ref 17592186547838}] :answer-field/correct {:db/id #edb/ref 17592186547577} :answer-field/id #uuid "a9807bbb-6450-5bec-9d6e-2cb5e0bc2c61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186547924}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c9b934c2-8c57-56f1-8a65-42f138da7b11" :question/math-academy-id "q-12891" :question/problem "Find, in descending powers of $z,$ the first three terms of the binomial expansion of ${(1-{z}^{2})}^{4}.$" :question/worked-solution "First, let's compare our expression with the binomial\n\n$$\n(a+b)^{n}.\n$$\n\nHere we have that $n=4,$ $a=1,$ and $b=-{z}^{2}.$ So, the exponents of the binomial expansion must follow the pattern\n\n$$\n{a}^{4}{b}^{0},\\,{a}^{3}{b}^{1},\\,{a}^{2}{b}^{2},\\,{a}^{1}{b}^{3},\\,{a}^{0}{b}^{4}.\n$$\n\nThe $4$th row in Pascal's Triangle is $(1,4,6,4,1).$ Therefore,\n\n$$\n\\begin{aligned}{(1-{z}^{2})}^{4} & =1{a}^{4}+4{a}^{3}b+6{a}^{2}{b}^{2}+4a{b}^{3}+1{b}^{4} \\\\  & =1(1)^{4}(-{z}^{2})^{0}+4(1)^{3}(-{z}^{2})^{1}+6(1)^{2}(-{z}^{2})^{2}+4(1)^{1}(-{z}^{2})^{3}+1(1)^{0}(-{z}^{2})^{4} \\\\  & =1(1)(1)+4(1)(-{z}^{2})+6(1)({z}^{4})+4(1)(-{z}^{6})+1(1)({z}^{8}) \\\\  & =1-4{z}^{2}+6{z}^{4}-4{z}^{6}+{z}^{8}.\\end{aligned}\n$$\n\nWe rewrite the binomial expansion in descending powers of $z$ as follows:\n\n$$\n(1-{z}^{2})^{4}={z}^{8}-4{z}^{6}+6{z}^{4}-4{z}^{2}+1\n$$\n\nFinally, in descending powers of $z,$ the first three terms of the binomial expansion are\n\n$$\n{z}^{8}-4{z}^{6}+6{z}^{4}.\n$$"} :step/id #uuid "de2d3f8a-b796-5c4a-80a9-88cbe5bf41a1" :step/next {:db/id #edb/ref 17592186548180}} {:db/id #edb/ref 17592186548180 :step/content {:db/id #edb/ref 17592186548014 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "209aed4f-131b-523e-a4e8-1446b6171323" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186547382} {:answer/id #uuid "3bcbebd1-5d2a-5581-b48c-489d2c32892b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186547446} {:answer/id #uuid "43b9c880-5fa3-575f-adb6-b7776ccb3b8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-24" :db/id #edb/ref 17592186547467} {:answer/id #uuid "47d804d7-6d7b-51dc-82a8-e898d3670e24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-16" :db/id #edb/ref 17592186547476} {:answer/id #uuid "ad8e8633-e525-5531-b1dd-16c1c9c6e25e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186547696}] :answer-field/correct {:db/id #edb/ref 17592186547476} :answer-field/id #uuid "fe5bbd0a-c356-5392-bd90-c3fba4a83d1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186547966}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "700411f4-106e-5592-a547-8738d64ef693" :question/math-academy-id "q-110676" :question/problem "Given that \n\n$$\n{(2s-{u}^{2})}^{4}=16{s}^{4}+A{s}^{3}{u}^{2}+B{s}^{2}{u}^{4}+Cs{u}^{6}+{u}^{8}\n$$\n\nwhere $A,B$ and $C$ are constants, determine the value of $A+B+C.$" :question/worked-solution "First, let's compare our expression with the binomial\n\n$$\n(a+b)^{n}.\n$$\n\nHere we have that $n=4,$ $a=2s,$ and $b=-{u}^{2}.$ So, the exponents of the binomial expansion must follow the pattern\n\n$$\n{a}^{4}{b}^{0},\\,{a}^{3}{b}^{1},\\,{a}^{2}{b}^{2},\\,{a}^{1}{b}^{3},\\,{a}^{0}{b}^{4}.\n$$\n\nThe $4$th row in Pascal's Triangle is $(1,4,6,4,1).$ Therefore,\n\n$$\n\\begin{aligned}(2s-{u}^{2})^{4} & =1{a}^{4}{b}^{0}+4{a}^{3}b+6{a}^{2}{b}^{2}+4a{b}^{3}+1{a}^{0}{b}^{4} \\\\  & =1(2s)^{4}{(-{u}^{2})}^{0}+4(2s)^{3}{(-{u}^{2})}^{1}+6(2s)^{2}{(-{u}^{2})}^{2} \\\\  & \\,+4(2s)^{1}{(-{u}^{2})}^{3}+1(2s)^{0}{(-{u}^{2})}^{4} \\\\  & =1(16{s}^{4})(1)+4(8{s}^{3})(-{u}^{2})+6(4{s}^{2})({u}^{4}) \\\\  & \\,+4(2s)(-{u}^{6})+1(1)({u}^{8}) \\\\  & =16{s}^{4}-32{s}^{3}{u}^{2}+24{s}^{2}{u}^{4}-8s{u}^{6}+{u}^{8}.\\end{aligned}\n$$\n\nTherefore, $A=-32,B=24,$ and $C=-8.$ Finally, then\n\n$$\nA+B+C=-32+24-8=-16.\n$$"} :step/id #uuid "e88238c8-1541-5000-9ad9-0ced66e4e120"}] :activity/title "Expanding Binomials Using Pascal's Triangle" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186547291}] [{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186084277} :activity/id #uuid "38aff8ec-fcf4-52b8-8557-cb2bcff71738" :activity/scope {:db/id #edb/ref 17592186048719 :topic/id #uuid "b8656b86-9f88-52e9-adb0-d3cc15fbb7cc" :topic/math-academy-id 755} :activity/steps [{:db/id #edb/ref 17592186084277 :step/content {:db/id #edb/ref 17592186084484 :tutorial/content "The **lowest common multiple** (or $\\textrm{LCM}$) of two integers is the smallest multiple that's common to both numbers.\n\nTo find the lowest common multiple of two small numbers, we can list all multiples of the two numbers and identify the smallest multiple that they have in common.\n\nFor example, let's find the lowest common multiple of $4$ and $6.$ We start by listing all multiples of $4$ and $6\\mathbin{:}$\n\n$$\n\\begin{aligned}4 & \\,\\to \\,4,\\,8,\\,\\boxed{\\text{[math]12[/math]}},\\,16,\\,20,\\,24,\\,… \\\\ 6 & \\,\\to \\,6,\\,\\boxed{\\text{[math]12[/math]}},\\,18,\\,24,\\,30,\\,36,\\,…\\end{aligned}\n$$\n\nThe smallest multiple in both lists is ![](images/92/9285d37c7b455395acb42a54f78348bedfd8c9a72ad63d6e6ab7c2426148ea0d.svg) So $12$ is our answer, and we can write\n\n$$\n\\textrm{LCM}(4,6)= 12.\n$$\n\n**Note:** The lowest common multiple is also sometimes called the *least* common multiple." :tutorial/id #uuid "b16f2464-2c19-5166-bd61-97043695afcb" :tutorial/math-academy-id 5301 :tutorial/title "Introduction"} :step/id #uuid "853eea8e-7e8c-5972-b2df-6a996d469c6a" :step/math-academy-id 33113 :step/next {:db/id #edb/ref 17592186084281}} {:db/id #edb/ref 17592186084278 :step/content {:db/id #edb/ref 17592186083330 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083132 :question/id #uuid "f524667d-8cd2-5b91-a9e0-538fc64399e5" :question/math-academy-id "e-8869"} :knowledge-point/id #uuid "384f8f04-972d-50cb-a023-dba29924242e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049086} {:db/id #edb/ref 17592186050170} {:db/id #edb/ref 17592186050212}] :knowledge-point/questions [{:db/id #edb/ref 17592186083690} {:db/id #edb/ref 17592186083711} {:db/id #edb/ref 17592186493920}] :knowledge-point/title "Finding the Lowest Common Multiple of Two Integers"} :step/id #uuid "0c8932d3-46c6-5cd6-941d-98887b4bfb0e" :step/math-academy-id 33116 :step/next {:db/id #edb/ref 17592186084280}} {:db/id #edb/ref 17592186084279 :step/content {:db/id #edb/ref 17592186083331 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083133 :question/id #uuid "7c928766-9971-565a-b38b-5c97b2c3ee1d" :question/math-academy-id "e-8870"} :knowledge-point/id #uuid "c28dd57d-e6e5-5704-94a4-5f9bfb37f383" :knowledge-point/questions [{:db/id #edb/ref 17592186083689} {:db/id #edb/ref 17592186083929} {:db/id #edb/ref 17592186234048} {:db/id #edb/ref 17592186493909} {:db/id #edb/ref 17592186493965}] :knowledge-point/title "Finding the Lowest Common Denominator of Two Fractions"} :step/id #uuid "764cac2a-73a8-581d-8ccd-4d665b951e2b" :step/math-academy-id 33118} {:db/id #edb/ref 17592186084280 :step/content {:db/id #edb/ref 17592186083332 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083134 :question/id #uuid "1373d2e3-fc83-56f2-b779-8f1e2d10efea" :question/math-academy-id "e-8874"} :knowledge-point/id #uuid "746e99f3-561d-5212-ba2a-3d34b8bcdbee" :knowledge-point/questions [{:db/id #edb/ref 17592186083479} {:db/id #edb/ref 17592186083712} {:db/id #edb/ref 17592186493890} {:db/id #edb/ref 17592186493918} {:db/id #edb/ref 17592186493924} {:db/id #edb/ref 17592186493959} {:db/id #edb/ref 17592186558531}] :knowledge-point/title "Finding the Lowest Common Multiple of Three Integers"} :step/id #uuid "7e705e91-32b9-5486-b6d0-c6ebfbc45c9b" :step/math-academy-id 33136 :step/next {:db/id #edb/ref 17592186084279}} {:db/id #edb/ref 17592186084281 :step/content {:db/id #edb/ref 17592186084485 :tutorial/content "Now suppose that we want to find the lowest common multiple of two larger numbers. It would take a while to make long lists of multiples. Luckily, there is a faster method. \n\nLet's demonstrate by finding $\\textrm{LCM}(10,12).$ We start by writing the prime factorization of $10$ and $12$, writing any repeating factors as powers:\n\n$$\n\\begin{aligned}10 & =2\\cdot 5={2}^{1}\\cdot {5}^{1} \\\\ 12 & =2\\cdot 2\\cdot 3={2}^{2}\\cdot {3}^{1}\\end{aligned}\n$$\n\nThen, we write down each unique prime factor that appears in either of our decompositions. In our case, the unique prime factors are \n\n$$\n{\\color{red}2}, \\qquad {\\color{red}3}, \\qquad {\\color{red}5}.\n$$\n\nNow, for each number in our list, we look at *both* prime factorizations and we take the *largest* power shown for each prime factor:\n\n- The factors corresponding to ${\\color{red}2}$ are ${\\color{red}2}^{\\color{blue}1}$ and ${\\color{red}2}^{\\color{blue}2}.$ Of these, the larger power is ${\\color{red}2}^{\\color{blue}2}.$\n\n- There is only one factor corresponding to ${\\color{red}3}.$ It is ${\\color{red}3}^{\\color{blue}1}.$\n\n- There is only one factor corresponding to ${\\color{red}5}.$ It is ${\\color{red}5}^{\\color{blue}1}.$\n\nFinally, we multiply the largest powers of each factor together, and we get\n\n$$\n\\begin{aligned}\\text{LCM}(10,12) & ={2}^{2}\\cdot {3}^{1}\\cdot {5}^{1} \\\\  & =4\\cdot 3\\cdot 5 \\\\  & =60.\\end{aligned}\n$$" :tutorial/id #uuid "de44c642-c9d2-5c1d-8b59-8781a99559ef" :tutorial/math-academy-id 5489 :tutorial/title "Finding the Lowest Common Multiple of Two Larger Numbers"} :step/id #uuid "44919f35-fd65-50af-b639-7d5eb83ab3b0" :step/math-academy-id 34200 :step/next {:db/id #edb/ref 17592186084278}}] :activity/title "Finding Lowest Common Multiples Using Prime Factorization" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083445}] [{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186074657} :activity/id #uuid "7809af08-83ac-5450-986d-2614a3fd22d3" :activity/scope {:db/id #edb/ref 17592186048826 :topic/id #uuid "c375d3cc-e398-5a47-a69f-ddc853431752" :topic/math-academy-id 487} :activity/steps [{:db/id #edb/ref 17592186074657 :step/content {:db/id #edb/ref 17592186075033 :tutorial/content "Suppose that we want to solve, *without* using graphs, the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}x+y &=4 \\\\ x-2 &=y\\,\\end{aligned}\\right.\n$$\n\nIn order to solve the system without a graph, we will need to combine the equations into a single equation that can be solved using algebraic manipulation.\n\nOne way to combine the equations is called the **substitution method.** To use the substitution method, we substitute for one variable in terms of the other.\n\nFor instance, notice that we can make $y$ the subject of the second equation:\n\n$$\n\\color{red}y=x - 2\n$$\n\nSubstituting this expression for $y$ into the first equation, we get an equation that we can solve for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}x+y & =4 \\\\ x+(x-2) & =4 \\\\ 2x-2 & =4 \\\\ 2x & =6 \\\\ x & =3\\end{aligned}\n$$\n\nSo, the solution must have $x=3.$ But we also need to figure out what $y$ is. We can do this by substituting $x=3$ back into the second equation:\n\n$$\n\\begin{aligned}y & =x-2 \\\\ y & =3-2 \\\\ y & =1\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x = 3$ and $y = 1$, which can be written as $\\left(3, 1\\right).$\n\n**Note:** Whenever we isolate the variable in one equation, we have to substitute it into the *other* equation. We cannot substitute a variable into the same equation it came from, because this will not give us any more information about the variable." :tutorial/id #uuid "e1e8cb2d-3d4e-5cb9-8947-2bd9deb11b89" :tutorial/math-academy-id 8131 :tutorial/title "Introduction"} :step/id #uuid "413b9b90-7693-5568-a868-970271a5a258" :step/math-academy-id 197419 :step/next {:db/id #edb/ref 17592186074658}} {:db/id #edb/ref 17592186074658 :step/content {:db/id #edb/ref 17592186073752 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073445 :question/id #uuid "e9aae52c-65f3-5dff-bc6b-a530f8c7acc1" :question/math-academy-id "e-13009"} :knowledge-point/id #uuid "5e79a91b-c479-53da-9f06-59c082fa4187" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048678} {:db/id #edb/ref 17592186050622}] :knowledge-point/question-generator {:db/id #edb/ref 17592186508241} :knowledge-point/questions [{:db/id #edb/ref 17592186074030} {:db/id #edb/ref 17592186074172} {:db/id #edb/ref 17592186074185} {:db/id #edb/ref 17592186233560} {:db/id #edb/ref 17592186233567} {:db/id #edb/ref 17592186233574} {:db/id #edb/ref 17592186496226} {:db/id #edb/ref 17592186496255} {:db/id #edb/ref 17592186497411} {:db/id #edb/ref 17592186503753} {:db/id #edb/ref 17592186508171} {:db/id #edb/ref 17592186508174} {:db/id #edb/ref 17592186508179} {:db/id #edb/ref 17592186508187} {:db/id #edb/ref 17592186508204} {:db/id #edb/ref 17592186508205} {:db/id #edb/ref 17592186508207} {:db/id #edb/ref 17592186508210} {:db/id #edb/ref 17592186508214} {:db/id #edb/ref 17592186508215} {:db/id #edb/ref 17592186508227} {:db/id #edb/ref 17592186508233} {:db/id #edb/ref 17592186546971} {:db/id #edb/ref 17592186558573}] :knowledge-point/title "Solving a System of Linear Equations Using Substitution"} :step/id #uuid "99e9f36f-648c-5025-bfca-c63f6f77d9b1" :step/math-academy-id 197420 :step/next {:db/id #edb/ref 17592186074659}} {:db/id #edb/ref 17592186074659 :step/content {:db/id #edb/ref 17592186073753 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073446 :question/id #uuid "707504e8-a367-5dc2-a663-371a9dcf7224" :question/math-academy-id "e-13010"} :knowledge-point/id #uuid "b4352698-7af7-5d74-9c3a-0f951c3e6078" :knowledge-point/question-generator {:db/id #edb/ref 17592186505092} :knowledge-point/questions [{:db/id #edb/ref 17592186073997} {:db/id #edb/ref 17592186073998} {:db/id #edb/ref 17592186074047} {:db/id #edb/ref 17592186496252} {:db/id #edb/ref 17592186496314} {:db/id #edb/ref 17592186505001} {:db/id #edb/ref 17592186505002} {:db/id #edb/ref 17592186505004} {:db/id #edb/ref 17592186505005} {:db/id #edb/ref 17592186505044} {:db/id #edb/ref 17592186505050} {:db/id #edb/ref 17592186505053} {:db/id #edb/ref 17592186505059} {:db/id #edb/ref 17592186505062} {:db/id #edb/ref 17592186505067} {:db/id #edb/ref 17592186505080} {:db/id #edb/ref 17592186505081} {:db/id #edb/ref 17592186505084} {:db/id #edb/ref 17592186546991}] :knowledge-point/title "Solving a Challenging System of Linear Equations Using Substitution"} :step/id #uuid "30b3f613-45c5-50c5-bd79-5c12149aea27" :step/math-academy-id 197424}] :activity/title "Solving Systems of Equations by Substitution" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073923}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186547088} :activity/id #uuid "7311ef08-ecf2-579b-9876-4973ab9af82b" :activity/scope {:db/id #edb/ref 17592186048826 :topic/id #uuid "c375d3cc-e398-5a47-a69f-ddc853431752" :topic/math-academy-id 487} :activity/steps [{:db/id #edb/ref 17592186547088 :step/content {:db/id #edb/ref 17592186074185 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "831b8a12-3240-5543-8f0b-63a066174430" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186071349} {:answer/id #uuid "e71abec1-af90-564e-96cc-65f749dff99a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186071350} {:answer/id #uuid "f9bd14c8-f201-5c70-ba77-5489006197a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186071351} {:answer/id #uuid "30891c0a-e32e-5e99-9826-2629f5f5792b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186071352} {:answer/id #uuid "424e6c76-ef65-55f4-bb2c-05129500785f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186071353}] :answer-field/correct {:db/id #edb/ref 17592186071349} :answer-field/id #uuid "4ff0f62d-b46f-5fed-abea-e9c339cbff76" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186071348}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5c71bd6b-b9a3-5587-89f4-a14a2c760bc2" :question/math-academy-id "q-5179" :question/problem "Given the system of equations below, what is the value of $p-q?$\n\n$$\n\\{\\begin{aligned}3p=15 \\\\ p+2q=9.\\end{aligned}\n$$" :question/worked-solution "We will isolate a variable in one of the equations and then substitute it into the other equation. It doesn't matter which equation we pick first, so we choose the easiest one. In this case, the first equation looks like the easiest.\n\nUsing the first equation, we can isolate $p$ by dividing both sides of the equation by $3:$\n\n$$\n\\begin{aligned}3p & =15 \\\\ p & =5\\end{aligned}\n$$\n\nIf we now substitute $p=5$ into $p+2q=9,$ then we can find the value of $q:$\n\n$$\n\\begin{aligned}p+2q & =9 \\\\ (5)+2q & =9 \\\\ 2q & =4 \\\\ q & =2\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $p=5,\\,q=2.$ So,\n\n$$\np-q=5-2=3.\n$$"} :step/id #uuid "0a9225c0-5f39-5569-928a-3834451e9d52" :step/next {:db/id #edb/ref 17592186547152}} {:db/id #edb/ref 17592186547152 :step/content {:db/id #edb/ref 17592186546991 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b85cb2c-460d-5f91-86c0-674d13fae83e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186546309} {:answer/id #uuid "242eed59-c937-5dab-b478-b3a1accb9d4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186546329} {:answer/id #uuid "463e0a8b-5e11-54a2-8cdd-72b176626176" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186546407} {:answer/id #uuid "6a785a85-c477-5db9-a10d-570f963f9181" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186546485} {:answer/id #uuid "f5ff80ce-ffb0-542a-ba50-ce8557612884" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186546805}] :answer-field/correct {:db/id #edb/ref 17592186546309} :answer-field/id #uuid "e282d81b-1bfe-5c5b-abe6-d91779057814" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186546940}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3b789afd-79c7-56fc-b94a-f894f177dfe2" :question/math-academy-id "q-18555" :question/problem "Given the system of equations below, what is the value of $a+b?$\n\n$$\n\\{\\begin{aligned}2b=6a+14 \\\\ 5b+25=0\\end{aligned}\n$$" :question/worked-solution "We number the equations so that we can refer to them more easily:\n\n$$\n\\{\\begin{aligned}2b=6a+14 & \\,\\,(1) \\\\ 5b+25=0. & \\,\\,(2)\\end{aligned}\n$$\n\nWe will isolate a variable in one of the equations and then substitute it into the other equation. Using equation $(2),$ we can solve for $b$ as follows:\n\n$$\n\\begin{aligned}5b+25 & =0 \\\\ 5b & =-25 \\\\ b & =-5\\end{aligned}\n$$\n\nThen, we substitute $b=-5$ into equation $(1)$ and solve for $a:$\n\n$$\n\\begin{aligned}2(-5) & =6a+14 \\\\ -10 & =6a+14 \\\\ -10-14 & =6a \\\\ 6a & =-24 \\\\ a & =-4\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $a=-4,\\,b=-5.$ So,\n\n$$\na+b=-4+(-5)=-4-5=-9.\n$$"} :step/id #uuid "ca7de6ad-e459-52ba-851d-06dd86cc6059" :step/next {:db/id #edb/ref 17592186547164}} {:db/id #edb/ref 17592186547164 :step/content {:db/id #edb/ref 17592186546971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25d7a53c-5916-5db7-992b-ff7a626a51c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186546336} {:answer/id #uuid "51399b6f-2763-5014-9b02-635633f0dada" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186546427} {:answer/id #uuid "9e23c320-e17b-534f-8a91-354568ebc163" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186546603} {:answer/id #uuid "a3f272eb-ffc1-5fb6-b622-055a0def12d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186546617} {:answer/id #uuid "d9f37f2b-79d8-5ebd-8615-8e1bcfb28380" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186546732}] :answer-field/correct {:db/id #edb/ref 17592186546732} :answer-field/id #uuid "78ca5c4c-b502-5598-a6f0-d81d606b319e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186546881}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1ad70587-af92-55e0-95cf-31aa82c10e13" :question/math-academy-id "q-52115" :question/problem "Given the system of equations below, what is the value of $a-b?$\n\n$$\n\\{\\begin{aligned}a=7 \\\\ 3a+6b=15\\end{aligned}\n$$" :question/worked-solution "We will isolate a variable in one of the equations and then substitute it into the other equation. It so happens that the first equation is already solved for $a:$\n\n$$\na=7\n$$\n\nIf we now substitute $a=7$ into $3a+6b=15,$ then we can find the value of $b:$\n\n$$\n\\begin{aligned}3a+6b & =15 \\\\ 3(7)+6b & =15 \\\\ 6b & =-6 \\\\ b & =-1\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $a=7,\\,b=-1.$ So,\n\n$$\na-b=7-(-1)=7+1=8.\n$$"} :step/id #uuid "e5c9a09f-e906-5432-9fef-4ec9ba80344e"}] :activity/title "Solving Systems of Equations by Substitution" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186546244}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186134779} :activity/id #uuid "3675dcdc-e716-5cf3-815c-6104dee10ef7" :activity/scope {:db/id #edb/ref 17592186048925 :topic/id #uuid "ccad99ab-e070-516f-9254-b5d931a9723d" :topic/math-academy-id 2213} :activity/steps [{:db/id #edb/ref 17592186134779 :step/content {:db/id #edb/ref 17592186135012 :tutorial/content "The expression below gives the cost, in dollars, of sending a letter to Spain: \n\n$$\n2w + 1\n$$\n\nHere, $w$ is the letter's weight in ounces.\n\n$$\n\\overbrace{\\:{\\color{blue}2}\\!\\!\\!{\\underset{\\underset{\\Large\\textrm{weight}}{\\large\\uparrow}}{w}}\\!\\!\\!+{\\color{red}1}\\:}^{\\large\\textrm{total cost}}\n$$\n\nThe coefficient of $w$ is the cost for each additional ounce of weight.\n\nTo illustrate:\n\n- If $w=1$ (we have a $1$-ounce letter), the cost is ${\\color{blue}2} \\cdot 1 + {\\color{red}1} = \\[math]3.$\n\n- If $w=2$ (we have a $2$-ounce letter), the cost is ${\\color{blue}2} \\cdot 2 + {\\color{red}1} = \\[/math]5.$\n\n- If $w=3$ (we have a $3$-ounce letter), the cost is ${\\color{blue}2} \\cdot 3 + {\\color{red}1} = \\[math]7.$\n\nNote the following:\n\n- The number $\\color{blue}2$ in this expression represents a *unit rate.* Each time we increase the letter's weight by $1$ ounce, the cost increases by $\\color{blue}\\[/math]2$.\n\n- There is also a **base fee** of $\\color{red}\\[math]1$, which does not depend on the weight of the letter. We can think of this as the cost of sending a zero-ounce letter." :tutorial/id #uuid "4884ffa5-ca42-52e9-9661-39a00bd97ba4" :tutorial/math-academy-id 1363 :tutorial/title "Introduction"} :step/id #uuid "3727010c-1515-54c6-9fef-96ea2dc82e6d" :step/math-academy-id 2798 :step/next {:db/id #edb/ref 17592186134780}} {:db/id #edb/ref 17592186134780 :step/content {:db/id #edb/ref 17592186133849 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133673 :question/id #uuid "d580ba90-3479-5bc6-be3c-457485999ade" :question/math-academy-id "e-822"} :knowledge-point/id #uuid "ad5ad311-bf6f-58e9-a473-51ad651160fd" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049018} {:db/id #edb/ref 17592186050195}] :knowledge-point/questions [{:db/id #edb/ref 17592186134437} {:db/id #edb/ref 17592186134439} {:db/id #edb/ref 17592186495077} {:db/id #edb/ref 17592186495117}] :knowledge-point/title "Interpreting the Meaning of the Coefficient and Constant Term"} :step/id #uuid "da830df3-d6a9-51ba-bd81-b481445b0aa5" :step/math-academy-id 2799 :step/next {:db/id #edb/ref 17592186134781}} {:db/id #edb/ref 17592186134781 :step/content {:db/id #edb/ref 17592186133850 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133674 :question/id #uuid "2797cfc6-ae99-55a6-98a2-bb1f5be39b4e" :question/math-academy-id "e-824"} :knowledge-point/id #uuid "a926bb0a-acd8-529c-8705-f6c7b4bbc2c2" :knowledge-point/questions [{:db/id #edb/ref 17592186134440} {:db/id #edb/ref 17592186134486} {:db/id #edb/ref 17592186495120} {:db/id #edb/ref 17592186558562}] :knowledge-point/title "Constructing an Expression With a Constant Term"} :step/id #uuid "d4c12aa1-5cda-5b3b-9eb9-f006009f5e4f" :step/math-academy-id 2804 :step/next {:db/id #edb/ref 17592186134897}} {:db/id #edb/ref 17592186134782 :step/content {:db/id #edb/ref 17592186133851 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133675 :question/id #uuid "0c075047-3971-5f0b-a03b-c67be0032db4" :question/math-academy-id "e-825"} :knowledge-point/id #uuid "7a696afb-6edc-5445-a6e4-23b82f96c76b" :knowledge-point/questions [{:db/id #edb/ref 17592186134441} {:db/id #edb/ref 17592186134488} {:db/id #edb/ref 17592186495057} {:db/id #edb/ref 17592186495070} {:db/id #edb/ref 17592186495088} {:db/id #edb/ref 17592186495169}] :knowledge-point/title "Interpreting an Expression With Multiple Variables"} :step/id #uuid "70341f70-571d-537e-81a7-dfdece0049ef" :step/math-academy-id 2806} {:db/id #edb/ref 17592186134897 :step/content {:db/id #edb/ref 17592186135149 :tutorial/content "In many countries, a **sales tax** is charged whenever an individual or company makes a purchase. The tax is usually based on a certain percentage of the sale price.\n\nFor example, suppose a person purchases a bicycle for $\\[math] 200,$ and there is a sales tax of $5\\%.$ How much is this tax, and what is the total cost of the bicycle?\n\nTo determine the amount of the tax the person must pay, we multiply $200 \\times 5\\%$, as follows:\n\n$$\n\\begin{aligned}Tax & =\\text{\\[}/math]200\\times 5% \\\\  & =\\text{\\[}math]200\\times 0.05 \\\\  & =\\text{\\[}/math]10\\end{aligned}\n$$\n\nTherefore, the purchaser must pay a $\\[math]10$ sales tax. This means that the total amount the person needs to pay for the bicycle is\n\n$$\n\\[/math]200 + \\[math]10 = \\[/math]210.\n$$" :tutorial/id #uuid "683a47a7-4c0a-5da2-888c-d004b4167df5" :tutorial/math-academy-id 6218 :tutorial/title "Calculating Taxes"} :step/id #uuid "7365f275-4f44-5bdc-b64a-45158abcf6d5" :step/math-academy-id 37767 :step/next {:db/id #edb/ref 17592186134962}} {:db/id #edb/ref 17592186134962 :step/content {:db/id #edb/ref 17592186133947 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133538 :question/id #uuid "93b2ed4a-45ad-5fc4-bfe8-479f5a674595" :question/math-academy-id "e-1604"} :knowledge-point/id #uuid "758ce589-dcf8-5be8-8f15-ae72172050db" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049467}] :knowledge-point/questions [{:db/id #edb/ref 17592186134438} {:db/id #edb/ref 17592186134487} {:db/id #edb/ref 17592186495112} {:db/id #edb/ref 17592186495140} {:db/id #edb/ref 17592186495141} {:db/id #edb/ref 17592186495172}] :knowledge-point/title "Constructing an Expression With a Tax Term"} :step/id #uuid "4b073ed7-15e0-5244-aa23-477855194546" :step/math-academy-id 5156 :step/next {:db/id #edb/ref 17592186134782}}] :activity/title "Interpreting Linear Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186134048}] [{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186139365} :activity/id #uuid "2320ac0f-1ba4-5fab-8b23-0557556abfdc" :activity/scope {:db/id #edb/ref 17592186050076 :topic/id #uuid "2b568414-117a-54db-9c62-047f1acb1909" :topic/math-academy-id 2230} :activity/steps [{:db/id #edb/ref 17592186139365 :step/content {:db/id #edb/ref 17592186139596 :tutorial/content "The formula for the speed $S$ of a moving object is\n\n$$\nS=\\dfrac{D}{T},\n$$\n\nwhere $D$ is the distance covered, and $T$ is the time taken.\n\nFor example, if a car travels a distance of $600\\,\\textrm{m}$ within a time of $30\\,\\textrm{s},$ at constant speed, then we can find the speed of the car using the formula as follows:\n\n$$\n\\begin{aligned}S & =\\frac{D}{T} \\\\  & =\\frac{600}{30} \\\\  & =20\\end{aligned}\n$$\n\nBut what is the unit of speed? We can find it by substituting the units for distance and time into the formula:\n\n$$\n\\begin{aligned}S & =\\frac{D}{T} \\\\  & =\\frac{\\text{meters}}{\\text{seconds}} \\\\  & =\\frac{\\text{m}}{\\text{s}}\\end{aligned}\n$$\n\nSo, the speed of the car is $20\\,\\textrm{m}/\\textrm{s}.$ When the unit has a quotient like this, we say \"meters *per* second.\"" :tutorial/id #uuid "61193d89-1b00-531f-be9f-18801cc08970" :tutorial/math-academy-id 1399 :tutorial/title "Introduction"} :step/id #uuid "2c2e40d2-0cf6-5448-9925-a2a8ae44cc69" :step/math-academy-id 3018 :step/next {:db/id #edb/ref 17592186139367}} {:db/id #edb/ref 17592186139367 :step/content {:db/id #edb/ref 17592186138437 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138310 :question/id #uuid "36127b89-97ba-5f98-bd8e-b36ae1a261f4" :question/math-academy-id "e-896"} :knowledge-point/id #uuid "e447dc49-3549-568c-ade5-86601beeb3a6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049253} {:db/id #edb/ref 17592186051057}] :knowledge-point/questions [{:db/id #edb/ref 17592186138795} {:db/id #edb/ref 17592186138797} {:db/id #edb/ref 17592186496261} {:db/id #edb/ref 17592186496319} {:db/id #edb/ref 17592186496331}] :knowledge-point/title "Finding Units When There Is No Cancellation"} :step/id #uuid "2bfae739-4b1c-551e-8e72-be87c28b1bef" :step/math-academy-id 3019 :step/next {:db/id #edb/ref 17592186139368}} {:db/id #edb/ref 17592186139368 :step/content {:db/id #edb/ref 17592186138438 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138311 :question/id #uuid "ee3fa65e-1146-598a-a89d-33d287e88066" :question/math-academy-id "e-897"} :knowledge-point/id #uuid "4e1b4e78-8b4a-59ea-8fac-9092c2eeb67a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050843} {:db/id #edb/ref 17592186051029}] :knowledge-point/questions [{:db/id #edb/ref 17592186138793} {:db/id #edb/ref 17592186139082} {:db/id #edb/ref 17592186496290} {:db/id #edb/ref 17592186496329} {:db/id #edb/ref 17592186558530} {:db/id #edb/ref 17592186558558}] :knowledge-point/title "Finding Units When There Is Cancellation"} :step/id #uuid "82c13ded-0a7f-5183-b153-dbfb81baff87" :step/math-academy-id 3022 :step/next {:db/id #edb/ref 17592186139369}} {:db/id #edb/ref 17592186139369 :step/content {:db/id #edb/ref 17592186139597 :tutorial/content "Sometimes, we can be given a formula with values whose units are not the standard ones we know.\n\nFor instance, suppose the formula for a person's popularity $P$ is given by\n\n$$\nP=\\dfrac{2f}{s},\n$$\n\nwhere $f$ is the number of friends that person has, and $s$ is the number of siblings they have.\n\nIf we want to find the unit of popularity, then we need to substitute the units for the number of friends ($f$) and the number of siblings ($s$) into the formula.\n\n- The units for the number of friends is '$\\textrm{friends}$' since we say 'I have $5$ friends'.\n\n- Similarly, the units for the number of siblings is '$\\textrm{siblings}.$'\n\nSubstituting these units into the formula, we get\n\n$$\n\\begin{aligned}P & =\\frac{2f}{s} \\\\  & =\\frac{2\\cdot \\text{friends}}{\\text{siblings}} \\\\  & =2\\cdot \\frac{\\text{friends}}{\\text{siblings}}\\end{aligned}\n$$\n\nTherefore the appropriate unit is $\\dfrac{\\textrm{friends}}{\\textrm{siblings}}$, or \"friends per sibling.\" Here we ignore the constant $2$ since it does not affect the units." :tutorial/id #uuid "ab30765e-d9e3-53d5-a050-8bd889054974" :tutorial/math-academy-id 1400 :tutorial/title "Formulas With Non-Standard Units"} :step/id #uuid "976f91da-bd0c-5ab2-bca4-a77eb3665217" :step/math-academy-id 3024 :step/next {:db/id #edb/ref 17592186139370}} {:db/id #edb/ref 17592186139370 :step/content {:db/id #edb/ref 17592186138439 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138312 :question/id #uuid "b0212d4c-eb7a-5cec-8eb1-1c60be355f4e" :question/math-academy-id "e-898"} :knowledge-point/id #uuid "deb16829-8ec8-5cbb-b81f-2c526bce165e" :knowledge-point/questions [{:db/id #edb/ref 17592186138796} {:db/id #edb/ref 17592186139083} {:db/id #edb/ref 17592186496231} {:db/id #edb/ref 17592186496334} {:db/id #edb/ref 17592186558559} {:db/id #edb/ref 17592186558574}] :knowledge-point/title "Dividing Nonstandard Units"} :step/id #uuid "ecd1aeef-36e3-51c0-8e9f-f64384ff00d8" :step/math-academy-id 3025}] :activity/title "Determining Units in Formulas" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186138590}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186558693} :activity/id #uuid "c9887f59-1c5a-5806-9f1e-3964e8169168" :activity/scope {:db/id #edb/ref 17592186050076 :topic/id #uuid "2b568414-117a-54db-9c62-047f1acb1909" :topic/math-academy-id 2230} :activity/steps [{:db/id #edb/ref 17592186558588 :step/content {:db/id #edb/ref 17592186558530 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13280df4-2330-5e3f-a795-a4797d385b73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{m}}{\\text{s}}" :db/id #edb/ref 17592186557910} {:answer/id #uuid "92e3a44a-45f8-56a5-93ce-aadc94b4a4b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{s}}{\\text{m}}" :db/id #edb/ref 17592186558153} {:answer/id #uuid "aac98899-8115-5802-b963-acb140b5967b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{m}}{{\\text{s}}^{2}}" :db/id #edb/ref 17592186558204} {:answer/id #uuid "e59368b3-7a79-555b-bf69-9f407a1f2366" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{\\text{s}}^{2}}{{\\text{m}}^{2}}" :db/id #edb/ref 17592186558326} {:answer/id #uuid "e8401ebb-283d-5b15-a0db-c2b75fab6b15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{s}}{{\\text{m}}^{2}}" :db/id #edb/ref 17592186558331}] :answer-field/correct {:db/id #edb/ref 17592186557910} :answer-field/id #uuid "f8d533bf-32da-572b-b69a-5759fa85571d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558475}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7753ef82-1930-5153-93dc-89e284e045d1" :question/math-academy-id "q-46152" :question/problem "The speed of a car moving with a constant acceleration is given by the formula $v=at,$ where $a$ is the car's acceleration, and $t$ is the time passed. Given that the acceleration is measured in $\\frac{\\text{m}}{{\\text{s}}^{2}}$, determine the units of speed in terms of meters and seconds." :question/worked-solution "Acceleration is measured in $\\frac{\\text{m}}{{\\text{s}}^{2}}$ and time is measured in seconds. We can find the unit of speed by substituting the given units of acceleration and time into the formula and simplifying. \n\n$$\n\\begin{aligned}v & =a\\cdot t \\\\  & =\\frac{\\text{m}}{{\\text{s}}^{2}}\\cdot \\text{s} \\\\  & =\\frac{\\text{m}\\,\\cancel{\\text{s}}}{{\\text{s}}^{\\cancel{2}}} \\\\  & =\\frac{\\text{m}}{\\text{s}}\\end{aligned}\n$$\n\nThus, the unit of speed is $\\frac{\\text{m}}{\\text{s}}.$"} :step/id #uuid "11ad8382-e548-54e8-8797-9de5e2d6db1f"} {:db/id #edb/ref 17592186558681 :step/content {:db/id #edb/ref 17592186558558 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0087c9b5-6fa9-54cf-b875-8154f8e1a3e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{m}}{{\\text{s}}^{2}\\,{\\text{km}}^{3}}" :db/id #edb/ref 17592186557870} {:answer/id #uuid "16b3c8b4-9bbf-5a82-b8c2-9a041a21c8b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{m}}{\\text{km}\\,{\\text{s}}^{2}}" :db/id #edb/ref 17592186557920} {:answer/id #uuid "21442043-31fd-5aab-92ba-0f264502b9eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{\\text{s}}^{2}}{\\text{m}}" :db/id #edb/ref 17592186557937} {:answer/id #uuid "57ec2723-24ad-548e-bbe6-9d7bd87f30f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{m}}{\\text{s}}" :db/id #edb/ref 17592186558032} {:answer/id #uuid "6c26b31a-a05b-53fb-b0ed-1793466f9725" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{m}}{{\\text{s}}^{2}}" :db/id #edb/ref 17592186558077}] :answer-field/correct {:db/id #edb/ref 17592186558077} :answer-field/id #uuid "11e0e1ea-dc6c-5b3f-89da-7dc4c90d0d81" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558369}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b8a0ff68-2bfe-50b7-8470-09b73dbea458" :question/math-academy-id "q-46095" :question/problem "The acceleration $a$ of a body is related to applied force $F$ and mass $m$ by the equation $a=\\frac{F}{m}.$ If $F$ is measured in Newtons $(\\frac{\\text{kg}\\,\\text{m}}{{\\text{s}}^{2}})$ and $m$ is measured in kilograms, determine an appropriate measurement unit for acceleration." :question/worked-solution "We can find the unit of acceleration by substituting the given units of force and mass into the formula and simplifying.\n\n$$\n\\begin{aligned}a & =\\frac{F}{m} \\\\  & =\\frac{(\\frac{\\text{kg}\\,\\text{m}}{{\\text{s}}^{2}})}{\\text{kg}} \\\\  & =\\frac{\\cancel{\\text{kg}}\\,\\text{m}}{{\\text{s}}^{2}\\,\\cancel{\\text{kg}}} \\\\  & =\\frac{\\text{m}}{{\\text{s}}^{2}}\\end{aligned}\n$$\n\nThus, the unit of acceleration is $\\frac{\\text{m}}{{\\text{s}}^{2}}.$"} :step/id #uuid "ba3c538d-4be0-5fa1-aad7-7eb962e8f9ec" :step/next {:db/id #edb/ref 17592186558588}} {:db/id #edb/ref 17592186558693 :step/content {:db/id #edb/ref 17592186558574 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9df49a9f-7b13-5d0e-94bf-4077f92c9eef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{machines}}{\\text{ball}}" :db/id #edb/ref 17592186558179} {:answer/id #uuid "adc47bce-7d5b-5419-90c1-b6900875bc26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{\\text{balls}}^{2}}{\\text{machine}}" :db/id #edb/ref 17592186558214} {:answer/id #uuid "d44676fb-cfb9-5576-bfd7-4326efdf4071" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{balls}}{\\text{machine}}" :db/id #edb/ref 17592186558284} {:answer/id #uuid "db400d60-85d5-52eb-959c-6924766f7a85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{\\text{machines}}^{2}}{{\\text{ball}}^{2}}" :db/id #edb/ref 17592186558299} {:answer/id #uuid "e6f489c1-6d75-5a3e-8fdf-791aab447eda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{\\text{machines}}^{2}}{\\text{ball}}" :db/id #edb/ref 17592186558327}] :answer-field/correct {:db/id #edb/ref 17592186558284} :answer-field/id #uuid "d31a35ae-5ca8-5d6c-a47c-8b5b084ab4be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558460}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f55788bf-5fa6-5009-a74f-4343731f157e" :question/math-academy-id "q-46070" :question/problem "A factory with $150$ machines produces $600\\,000$ baseball balls weekly. To determine the number of balls produced by a machine on average, the owner of the factory uses the formula\n\n$$\nP=\\frac{b}{m},\n$$\n\n \nwhere $b$ is the number of balls produced by the factory weekly, and $m$ is the number of machines in the factory.\n\nWhat is an appropriate measurement unit for $P?$" :question/worked-solution "We are solving for measurement units, so we can ignore the quantities $150$ and $600\\,000.$ They do not matter, if we are just solving for units.\n\nSince $b$ represents $\\text{balls}$ and $m$ represents $\\text{machines},$ the appropriate measurement unit for $P=\\frac{b}{m}$ is $\\frac{\\text{balls}}{\\text{machines}}.$"} :step/id #uuid "d27593e5-46d5-5615-a52c-7eea72d15309" :step/next {:db/id #edb/ref 17592186558681}}] :activity/title "Determining Units in Formulas" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186557866}] [{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186069563} :activity/id #uuid "1f8c9db7-3784-53ad-acdf-c7009ab4e43d" :activity/scope {:db/id #edb/ref 17592186050635 :topic/id #uuid "5a901d31-08d1-5602-a6b3-9ae8fa80845b" :topic/math-academy-id 418} :activity/steps [{:db/id #edb/ref 17592186069563 :step/content {:db/id #edb/ref 17592186070020 :tutorial/content "The **point-slope form** of a line that passes through any point $(x_1,y_1)$ with slope $m$ is given by \n\n$$\ny - y_1 = m(x-x_1).\n$$\n\n \n\nFor example, consider the straight line graph which passes through the points $(3,1)$ and $(5,5)$, as shown below.\n\n![](images/e7/e7838ffcb8f56ebffd384763ff761990e15031bdc5cdf3f0cc1f964ed69a4806.png)\n\nWe know that the line passes through the point $(3,1),$ so we can use $(x_1,y_1) = (3,1)$ in our point-slope formula. All that remains is to compute $m,$ and we can do this using the given points.\n\nFirst, calculate the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{5-1}{5-3}=\\frac{4}{2}=2\\end{aligned}\n$$\n\nThen, we substitute $m=2$ and the point $(x_1,y_1) = (3,1)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =2(x-3)\\end{aligned}\n$$\n\n**Note:** If we simplify this point-slope formula, we obtain the slope-intercept form of the line:\n\n$$\n\\begin{aligned}y-1 & =2(x-3) \\\\ y-1 & =2x-6 \\\\ y & =2x-5\\end{aligned}\n$$\n\n**Watch out!** We could put $(x_1,y_1)=(5,5).$ In this case, the point-slope form will be different:\n\n$$\ny-5=2(x-5)\n$$\n\n \nBut the resulting simplified slope-intercept form will be the same:\n\n$$\ny = 2x-5\n$$" :tutorial/id #uuid "43f9e39e-fc27-549d-8ec4-b2bf4f375a33" :tutorial/math-academy-id 8695 :tutorial/title "Introduction"} :step/id #uuid "866e675a-4d40-5d4f-ab69-7850b06a40d3" :step/math-academy-id 114979 :step/next {:db/id #edb/ref 17592186069564}} {:db/id #edb/ref 17592186069564 :step/content {:db/id #edb/ref 17592186068692 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068478 :question/id #uuid "ccc054b8-db6c-5726-bb60-a744467a9f6d" :question/math-academy-id "e-13974"} :knowledge-point/id #uuid "8f2df46b-730d-54d0-9cfa-3636a3d37839" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049716}] :knowledge-point/questions [{:db/id #edb/ref 17592186069106} {:db/id #edb/ref 17592186069455} {:db/id #edb/ref 17592186492841} {:db/id #edb/ref 17592186492895}] :knowledge-point/title "Finding a Point-Slope Equation Given a Slope and a Point"} :step/id #uuid "81e196b1-7aa2-52a3-a840-bcf07eca8e5a" :step/math-academy-id 114980 :step/next {:db/id #edb/ref 17592186069565}} {:db/id #edb/ref 17592186069565 :step/content {:db/id #edb/ref 17592186068693 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068479 :question/id #uuid "2b89eb42-8f10-57e8-aaa1-db4a2854c93e" :question/math-academy-id "e-13975"} :knowledge-point/id #uuid "ef428368-9b55-5bbb-94ef-99e503ca9868" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049061}] :knowledge-point/questions [{:db/id #edb/ref 17592186069456} {:db/id #edb/ref 17592186069457} {:db/id #edb/ref 17592186492881} {:db/id #edb/ref 17592186492910} {:db/id #edb/ref 17592186502140} {:db/id #edb/ref 17592186502159} {:db/id #edb/ref 17592186558568}] :knowledge-point/title "Finding a Point-Slope Equation Given Two Points"} :step/id #uuid "d8550af5-658f-598e-b2b6-d122f4b6baeb" :step/math-academy-id 114983 :step/next {:db/id #edb/ref 17592186069566}} {:db/id #edb/ref 17592186069566 :step/content {:db/id #edb/ref 17592186068694 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068480 :question/id #uuid "88378710-e983-5b10-b56b-40397480e460" :question/math-academy-id "e-13978"} :knowledge-point/id #uuid "1a620c55-6fa6-52db-92c6-231f631c0b45" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050575}] :knowledge-point/questions [{:db/id #edb/ref 17592186069484} {:db/id #edb/ref 17592186069493} {:db/id #edb/ref 17592186069494} {:db/id #edb/ref 17592186492835} {:db/id #edb/ref 17592186492843} {:db/id #edb/ref 17592186492871} {:db/id #edb/ref 17592186492886} {:db/id #edb/ref 17592186502150}] :knowledge-point/title "Finding a Slope-Intercept Form Using Point-Slope Form"} :step/id #uuid "a58fbae9-fa8d-5cc2-8b3b-97a9b645d318" :step/math-academy-id 114986}] :activity/title "Equations of Lines in Point-Slope Form" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068952}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186502178} :activity/id #uuid "6e99407a-bbb3-5be2-9242-96bf986482bc" :activity/scope {:db/id #edb/ref 17592186050635 :topic/id #uuid "5a901d31-08d1-5602-a6b3-9ae8fa80845b" :topic/math-academy-id 418} :activity/steps [{:db/id #edb/ref 17592186502178 :step/content {:db/id #edb/ref 17592186502140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1769de88-881d-5956-99f5-096e2c3b7e1e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y-1=3(x-3)" :db/id #edb/ref 17592186501511} {:answer/id #uuid "4bf048cb-a4c7-5d36-91ca-c83dcdce6dc4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y+3=\\frac{3}{7}(x-1)" :db/id #edb/ref 17592186501603} {:answer/id #uuid "4fa5e41e-58fd-5a9c-8a80-07017c5e334c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y+3=3(x+1)" :db/id #edb/ref 17592186501611} {:answer/id #uuid "afaf01af-827d-5890-8956-ef74d5697985" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y+1=\\frac{3}{7}(x+3)" :db/id #edb/ref 17592186501814} {:answer/id #uuid "b7920225-86ca-5473-953d-d1acecfdfacd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y-1=\\frac{3}{7}(x+3)" :db/id #edb/ref 17592186501832}] :answer-field/correct {:db/id #edb/ref 17592186501814} :answer-field/id #uuid "5537ccfc-a1e3-5cdc-8038-6152a735dd0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502003}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bd240e88-fbe1-5844-ad36-74f8bed7e2a0" :question/math-academy-id "q-109537" :question/problem "Find, in point-slope form, the equation of the line that passes through the points $(-3,-1)$ and $(4,2).$" :question/worked-solution "We know that the line passes through the point $(-3,-1),$ so we can use $({x}_{1},{y}_{1})=(-3,-1)$ in our point-slope formula. All that remains is to compute $m,$ and we can do this using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{2-(-1)}{4-(-3)}=\\frac{2+1}{4+3}=\\frac{3}{7}\\end{aligned}\n$$\n\nThen, we substitute $m=\\frac{3}{7}$ and the point $({x}_{1},{y}_{1})=(-3,-1)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-1) & =\\frac{3}{7}(x-(-3)) \\\\ y+1 & =\\frac{3}{7}(x+3)\\end{aligned}\n$$"} :step/id #uuid "3fa47a77-5577-5668-bee3-ae8be829d8a6" :step/next {:db/id #edb/ref 17592186502191}} {:db/id #edb/ref 17592186502191 :step/content {:db/id #edb/ref 17592186502159 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f0e8229-9e05-5b49-a5bc-1c064268bc9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y+1=3(x-1)" :db/id #edb/ref 17592186501492} {:answer/id #uuid "70ebac15-8dee-54b4-967e-d6e875941a64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y-4=3(x+1)" :db/id #edb/ref 17592186501672} {:answer/id #uuid "81218ca0-1739-582b-ab48-ef0aaec2d811" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y+4=\\frac{1}{3}(x-1)" :db/id #edb/ref 17592186501714} {:answer/id #uuid "e304c12c-7b3f-5ccf-8257-ced519e507f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y-1=-\\frac{1}{3}(x-4)" :db/id #edb/ref 17592186501920} {:answer/id #uuid "fbd0be6f-c3bd-5524-aac0-617dc0483f3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y-4=-\\frac{1}{3}(x+1)" :db/id #edb/ref 17592186501966}] :answer-field/correct {:db/id #edb/ref 17592186501966} :answer-field/id #uuid "58cdb945-4167-5cc0-adcc-654b4ba82f97" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502005}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f088ab98-ea37-5733-acee-5703f82f16fe" :question/math-academy-id "q-109542" :question/problem "Find, in point-slope form, the equation of the line that passes through the points $(-1,4)$ and $(5,2).$" :question/worked-solution "We know that the line passes through the point $(-1,4),$ so we can use $({x}_{1},{y}_{1})=(-1,4)$ in our point-slope formula. All that remains is to compute $m,$ and we can do this using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{2-4}{5-(-1)}=\\frac{-2}{6}=-\\frac{1}{3}\\end{aligned}\n$$\n\nThen, we substitute $m=-\\frac{1}{3}$ and the point $({x}_{1},{y}_{1})=(-1,4)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-4 & =-\\frac{1}{3}(x-(-1)) \\\\ y-4 & =-\\frac{1}{3}(x+1)\\end{aligned}\n$$"} :step/id #uuid "8aba4594-51e5-51cc-b7f3-736cad45fe1b" :step/next {:db/id #edb/ref 17592186502200}} {:db/id #edb/ref 17592186502200 :step/content {:db/id #edb/ref 17592186502150 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a1f86cd-0086-5765-9ba9-5e0bcefb0ed1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-x-7" :db/id #edb/ref 17592186501487} {:answer/id #uuid "a044491e-9316-5e2b-828a-80ff38d98c4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-x-2" :db/id #edb/ref 17592186501766} {:answer/id #uuid "b1e543ad-cf33-5fd3-921e-3361e3489906" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-x+7" :db/id #edb/ref 17592186501822} {:answer/id #uuid "bf69e2dc-5d68-5e7a-8fda-ed88c91e4da7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=x+3" :db/id #edb/ref 17592186501852} {:answer/id #uuid "e78fada1-45c2-57a2-a158-de8b1d290184" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=x-2" :db/id #edb/ref 17592186501931}] :answer-field/correct {:db/id #edb/ref 17592186501766} :answer-field/id #uuid "8edbb288-1d9d-5e4c-bfd5-15eba8ff9406" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502028}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d43f31da-b163-56de-90b2-998690e787ff" :question/math-academy-id "q-109573" :question/problem "Calculate the equation of the line that passes through the points $(-5,3)$ and $(-1,-1).$" :question/worked-solution "First, we will construct the point-slope formula for the line. Then, we will simplify the point-slope formula into slope-intercept form.\n\nWe start by computing the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{-1-3}{-1-(-5)}=\\frac{-4}{4}=-1\\end{aligned}\n$$\n\nThen, we substitute $m=-1$ and the point $({x}_{1},{y}_{1})=(-5,3)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-3 & =-(x-(-5)) \\\\ y-3 & =-(x+5)\\end{aligned}\n$$\n\nFinally, we simplify the equation into slope-intercept form:\n\n$$\n\\begin{aligned}y-3 & =-(x+5) \\\\ y-3 & =-x-5 \\\\ y & =-x-2\\end{aligned}\n$$"} :step/id #uuid "c1bc04e5-5845-5fbc-b7bb-14ef8645487e"}] :activity/title "Equations of Lines in Point-Slope Form" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186501455}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186111591} :activity/id #uuid "f40ffb7e-1747-5f74-b124-0acd55b121f3" :activity/scope {:db/id #edb/ref 17592186050672 :topic/id #uuid "5dd12522-3288-519e-ab0e-5facb1a9d356" :topic/math-academy-id 1428} :activity/steps [{:db/id #edb/ref 17592186111591 :step/content {:db/id #edb/ref 17592186111823 :tutorial/content "The **power of quotient rule** states that if we want to raise the quotient $\\dfrac{x}{y}$ to some power $n,$ we must raise the numerator and denominator to the power $n$ as follows:\n\n$$\n\\left(\\dfrac{x}{y}\\right)^n=\\dfrac{x^n}{y^n}\n$$\n\nFor example,\n\n$$\n\\left(\\dfrac{x}{y}\\right)^4=\\dfrac{x^4}{y^4}.\n$$\n\nTo see why the power of quotient rule is true, let's take the above example and work it out again the long way. We get the same result:\n\n$$\n\\begin{aligned}{(\\frac{x}{y})}^{4} & = \\\\ \\frac{x}{y}\\cdot \\frac{x}{y}\\cdot \\frac{x}{y}\\cdot \\frac{x}{y} & = \\\\ \\frac{x\\cdot x\\cdot x\\cdot x}{y\\cdot y\\cdot y\\cdot y} & = \\\\ \\frac{{x}^{4}}{{y}^{4}}\\end{aligned}\n$$\n\nThe power of quotient rule is just a shortcut for the process above." :tutorial/id #uuid "9aedc7af-544c-5314-a986-2cd6ce64479b" :tutorial/math-academy-id 1484 :tutorial/title "Introduction"} :step/id #uuid "9b35013c-5ff4-5a7c-99fa-9b6c887c8c75" :step/math-academy-id 3552 :step/next {:db/id #edb/ref 17592186111592}} {:db/id #edb/ref 17592186111592 :step/content {:db/id #edb/ref 17592186110659 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110297 :question/id #uuid "dc436197-3170-5ed7-a8f8-2092dd72da21" :question/math-academy-id "e-1085"} :knowledge-point/id #uuid "95f11186-e295-5091-93c3-07072b0c18eb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048683} {:db/id #edb/ref 17592186051009}] :knowledge-point/questions [{:db/id #edb/ref 17592186110979} {:db/id #edb/ref 17592186110980} {:db/id #edb/ref 17592186493893} {:db/id #edb/ref 17592186493897} {:db/id #edb/ref 17592186553590} {:db/id #edb/ref 17592186558498}] :knowledge-point/title "Using the Power of Quotient Rule with One Fraction"} :step/id #uuid "8fb38c77-55f0-5928-8c35-70c3ff0de790" :step/math-academy-id 3553 :step/next {:db/id #edb/ref 17592186111593}} {:db/id #edb/ref 17592186111593 :step/content {:db/id #edb/ref 17592186110660 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110298 :question/id #uuid "7d8ea34f-b406-5bc8-9c00-de65d72e9d6d" :question/math-academy-id "e-1086"} :knowledge-point/id #uuid "422bde20-bd83-5a20-b708-734b585ac256" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049253} {:db/id #edb/ref 17592186049729} {:db/id #edb/ref 17592186050802}] :knowledge-point/questions [{:db/id #edb/ref 17592186110981} {:db/id #edb/ref 17592186111332} {:db/id #edb/ref 17592186493895} {:db/id #edb/ref 17592186493905} {:db/id #edb/ref 17592186493913} {:db/id #edb/ref 17592186553503}] :knowledge-point/title "Using the Power of Quotient Rule with Two Fractions"} :step/id #uuid "d9b9bca6-86d4-5640-8cb5-7659bf64aa00" :step/math-academy-id 3556}] :activity/title "The Power of Quotient Rule With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110819}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186553624} :activity/id #uuid "d839f9a6-94bb-560c-9839-0500be1e7733" :activity/scope {:db/id #edb/ref 17592186050672 :topic/id #uuid "5dd12522-3288-519e-ab0e-5facb1a9d356" :topic/math-academy-id 1428} :activity/steps [{:db/id #edb/ref 17592186553609 :step/content {:db/id #edb/ref 17592186110979 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39117031-8bd7-5923-9276-cdc1948c942c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{8{x}^{3}}{25}" :db/id #edb/ref 17592186552982} {:answer/id #uuid "9b9949b5-30a6-5762-a953-b694484a6125" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8{x}^{3}}{125}" :db/id #edb/ref 17592186553184} {:answer/id #uuid "c046ba94-1c02-5a90-b029-ab253fc5fbdb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{8{x}^{3}}{125}" :db/id #edb/ref 17592186553249} {:answer/id #uuid "d1256010-75cd-58d3-853b-29ed436d57c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4{x}^{3}}{125}" :db/id #edb/ref 17592186553287} {:answer/id #uuid "d90f2379-cc17-529b-b846-0f95dcc8aa0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8{x}^{3}}{25}" :db/id #edb/ref 17592186553303}] :answer-field/correct {:db/id #edb/ref 17592186553249} :answer-field/id #uuid "048eb519-af72-550a-859f-c10d6f6d508f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186107607}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3a3cc9e5-78e6-5bc2-8b9d-45b94201e0b1" :question/math-academy-id "q-22467" :question/problem "${(\\frac{-2x}{5})}^{3}=$" :question/worked-solution "First, we apply the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{-2x}{5})}^{3}=\\frac{(-2x)^{3}}{{5}^{3}}\\end{aligned}\n$$\n\nThen, we apply the power of product rule and simplify:\n\n$$\n\\begin{aligned}\\frac{(-2x)^{3}}{{5}^{3}} & = \\\\ \\frac{(-2)^{3}{x}^{3}}{125} & = \\\\ -\\frac{8{x}^{3}}{125}\\end{aligned}\n$$"} :step/id #uuid "28fd1bcd-2fe9-55e9-85ea-0661511252c1" :step/next {:db/id #edb/ref 17592186553672}} {:db/id #edb/ref 17592186553624 :step/content {:db/id #edb/ref 17592186553590 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1723e9e6-e3d4-5c92-884a-480d4b3096da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{3}^{4}}{{2}^{4}}" :db/id #edb/ref 17592186552908} {:answer/id #uuid "31d7b2f4-f18a-559c-ace0-d916afe65784" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186552965} {:answer/id #uuid "3e978287-ff14-526a-8959-0da6c17344b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{3}^{4}" :db/id #edb/ref 17592186552992} {:answer/id #uuid "7fc4dfa5-2ae6-59d3-b3af-d745124b5bd1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{2}^{4}}{{3}^{4}}" :db/id #edb/ref 17592186553127} {:answer/id #uuid "b2772045-ea3b-5d01-b1ee-fe20dc09c641" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{4}" :db/id #edb/ref 17592186553227}] :answer-field/correct {:db/id #edb/ref 17592186552908} :answer-field/id #uuid "6f62a198-63f6-5ace-982e-2254c7cebad3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186553427}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fc247476-de74-5773-8d25-47f3b046cb55" :question/math-academy-id "q-299" :question/problem "${(\\frac{3}{2})}^{4}=$" :question/worked-solution "We apply the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{3}{2})}^{4}=\\frac{{3}^{4}}{{2}^{4}}\\end{aligned}\n$$"} :step/id #uuid "5a36885b-76aa-5356-b939-a179350d8158" :step/next {:db/id #edb/ref 17592186553609}} {:db/id #edb/ref 17592186553672 :step/content {:db/id #edb/ref 17592186553503 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "100858d8-fbb8-53d1-94ff-c723fb8181a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3{v}^{2}{u}^{3}}" :db/id #edb/ref 17592186552890} {:answer/id #uuid "1012a099-490e-55a1-91fe-96513e31d553" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{{v}^{2}{u}^{3}}" :db/id #edb/ref 17592186552891} {:answer/id #uuid "b785f732-b7a8-5013-8b45-005925d7b461" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3vu}" :db/id #edb/ref 17592186553234} {:answer/id #uuid "f1e2a5a9-241f-5141-b300-982a2112367c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2{v}^{2}{u}^{3}}" :db/id #edb/ref 17592186553344} {:answer/id #uuid "ff2dc043-19d6-5231-9ee1-3d43616eb3b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3{v}^{2}{u}^{2}}" :db/id #edb/ref 17592186553375}] :answer-field/correct {:db/id #edb/ref 17592186552891} :answer-field/id #uuid "68afb3d3-4f53-59cf-a56f-7809a2483d3e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186553425}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "22efbe5c-dc42-517a-9c47-dc7951665162" :question/math-academy-id "q-22530" :question/problem "$\\frac{2}{3}{(\\frac{3}{v})}^{2}{(\\frac{1}{u})}^{3}=$" :question/worked-solution "We apply the power of quotient rule and simplify:\n\n$$\n\\begin{aligned}\\frac{2}{3}{(\\frac{3}{v})}^{2}{(\\frac{1}{u})}^{3} & = \\\\ \\frac{2}{3}\\cdot \\frac{{3}^{2}}{{v}^{2}}\\cdot \\frac{{1}^{3}}{{u}^{3}} & = \\\\ \\frac{2}{3}\\cdot \\frac{9}{{v}^{2}}\\cdot \\frac{1}{{u}^{3}} & = \\\\ \\frac{18}{3{v}^{2}{u}^{3}} & = \\\\ \\frac{6}{{v}^{2}{u}^{3}}\\end{aligned}\n$$"} :step/id #uuid "cdb37125-773c-5ee6-8809-c4e84ef5e493"}] :activity/title "The Power of Quotient Rule With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186552864}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186116230} :activity/id #uuid "b0012b09-9794-5364-a20b-bf1c5e744a22" :activity/scope {:db/id #edb/ref 17592186050828 :topic/id #uuid "69d7c525-79e4-514e-80ba-739018d9e137" :topic/math-academy-id 1587} :activity/steps [{:db/id #edb/ref 17592186116226 :step/content {:db/id #edb/ref 17592186115310 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115139 :question/id #uuid "977cdc31-054e-5910-a649-e604dc4ce31f" :question/math-academy-id "e-8052"} :knowledge-point/id #uuid "b936abcf-8e73-524c-a9bf-e59b55a48f5f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048187}] :knowledge-point/questions [{:db/id #edb/ref 17592186115978} {:db/id #edb/ref 17592186115979} {:db/id #edb/ref 17592186495082} {:db/id #edb/ref 17592186495083}] :knowledge-point/title "Solving Equations With Even Exponents"} :step/id #uuid "3cf6da35-b32f-503b-b8ea-94efb7441f1c" :step/math-academy-id 30068 :step/next {:db/id #edb/ref 17592186116227}} {:db/id #edb/ref 17592186116227 :step/content {:db/id #edb/ref 17592186115311 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115140 :question/id #uuid "3f41b040-6584-57cd-8d47-b01e071b0fa9" :question/math-academy-id "e-8064"} :knowledge-point/id #uuid "23e661ed-3a7b-598a-a7b1-fd5011fe4fb8" :knowledge-point/questions [{:db/id #edb/ref 17592186115980} {:db/id #edb/ref 17592186115981} {:db/id #edb/ref 17592186495103} {:db/id #edb/ref 17592186495166} {:db/id #edb/ref 17592186558496}] :knowledge-point/title "Solving Equations Containing an Expression Raised to an Even Power"} :step/id #uuid "c66f2f53-2687-55ab-8bb5-e1056e5074bc" :step/math-academy-id 30120} {:db/id #edb/ref 17592186116230 :step/content {:db/id #edb/ref 17592186116534 :tutorial/content "How do we solve an equation with a variable raised to an even exponent, such as\n\n$$\nx^6 = 64?\n$$\n\nWe can solve this equation by taking the $6$th root of each side and solving for $x.$ \n\nSince the exponent $(6)$ is even, there will be two real solutions (positive and negative):\n\n$$\n\\begin{aligned}{x}^{6} & =64 \\\\ \\sqrt[6]{{x}^{6}} & =\\pm \\sqrt[6]{64} \\\\ x & =\\pm \\sqrt[6]{{2}^{6}} \\\\ x & =\\pm 2\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm 2.$\n\nIn general, we have the following rule of thumb:\n\n*When $n$ is even, and we take the $n$th root of both sides of $x^n = a$ with $a \\geq 0,$ we get two solutions (positive and negative):* \n\n$$\nx = \\pm\\sqrt[n]{a}\n$$\n\n**Watch out!** If $a<0$ and $n$ is even, equation  $x^n = a$ has no solution since, in this case, $x^n \\geq 0$ for any real $x.$" :tutorial/id #uuid "6a9834f3-f04b-5340-b297-793072b594d9" :tutorial/math-academy-id 4833 :tutorial/title "Introduction"} :step/id #uuid "036c0d84-9bf6-5da8-986c-2ace277257a2" :step/math-academy-id 30128 :step/next {:db/id #edb/ref 17592186116226}}] :activity/title "Solving Equations With Even Exponents Using the Nth Root Method" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115421}] [{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186069792} :activity/id #uuid "2dc87c95-826a-555a-9423-36fffbf47e86" :activity/scope {:db/id #edb/ref 17592186051032 :topic/id #uuid "7bffda20-cdd5-5dc8-9399-950fa61fbd19" :topic/math-academy-id 382} :activity/steps [{:db/id #edb/ref 17592186069792 :step/content {:db/id #edb/ref 17592186069940 :tutorial/content "Sometimes, perfect square trinomials have a leading coefficient that is something other than $1.$ For example, the expression\n\n$$\n4x^2+12x+9\n$$\n\nhas a leading coefficient of $4,$ and it is a perfect square trinomial because it is the square of the binomial $(2x+3)$ as we can see below:\n\n$$\n\\begin{aligned}(2x+3)^{2} & = \\\\ (2x)^{2}+2(2x)(3)+(3)^{2} & = \\\\ 4{x}^{2}+12x+9 & \\end{aligned}\n$$\n\nTo factor a perfect square trinomial with a leading coefficient other than $1,$ we use the square of sum formula:\n\n$$\n\\begin{aligned}{a}^{2}+2ab+{b}^{2} & =(a+b)^{2}\\end{aligned}\n$$\n\nTo illustrate, let's factor the expression $4x^2+12x+9$ using the square of sum formula. We perform the following steps:\n\n1\\. Write both the quadratic term and the constant term as perfect squares:\n\n  $$\n  \\begin{aligned}4{x}^{2}+12x+9 & = \\\\ (2x)^{2}+12x+(3)^{2}\\end{aligned}\n  $$\n\n2\\. Factor a $2$ out of the linear term:\n\n  $$\n  \\begin{aligned}(2x)^{2}+2(6x)+(3)^{2}\\end{aligned}\n  $$\n\n3\\. Write the middle parentheses $(6x)$ as a product of $2x$ and ${\\color{blue}3}\\mathbin{:}$\n\n  $$\n  \\begin{aligned}(2x)^{2}+2(2x\\cdot 3)+(3)^{2}\\end{aligned}\n  $$\n\n4\\. Factor the trinomial using the square of sum formula. In this case, we have $a=2x$ and $b=3\\mathbin{:}$\n\n  $$\n  \\begin{aligned}(2x+3)^{2}\\end{aligned}\n  $$\n\n**Note:** This method works *only* when the trinomial is a perfect square! It will *not* work for every trinomial. But we will learn more general methods in the future." :tutorial/id #uuid "5d43b5e8-672e-5cdd-b7a3-8de29e6552f3" :tutorial/math-academy-id 1597 :tutorial/title "Introduction"} :step/id #uuid "8854423e-52a6-5077-ab8f-c9de25d23206" :step/math-academy-id 4236 :step/next {:db/id #edb/ref 17592186069793}} {:db/id #edb/ref 17592186069793 :step/content {:db/id #edb/ref 17592186068847 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068464 :question/id #uuid "99376061-f11c-50f9-8c6e-e67ad640afd1" :question/math-academy-id "e-1331"} :knowledge-point/id #uuid "0f4dc7f6-d085-5ad8-8ac3-95e5b9cc337f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049026}] :knowledge-point/questions [{:db/id #edb/ref 17592186069216} {:db/id #edb/ref 17592186069252} {:db/id #edb/ref 17592186484281} {:db/id #edb/ref 17592186484296}] :knowledge-point/title "Factoring a Perfect Square Trinomial Generated by the Square of a Sum"} :step/id #uuid "ac3a35ba-8b05-5a52-9f06-dc5add492619" :step/math-academy-id 4237 :step/next {:db/id #edb/ref 17592186069898}} {:db/id #edb/ref 17592186069794 :step/content {:db/id #edb/ref 17592186068848 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068465 :question/id #uuid "e9c8bdc9-696d-5a55-bb0d-d247008c5684" :question/math-academy-id "e-1333"} :knowledge-point/id #uuid "5f64efad-73ef-5caa-b38b-060d24ce13cf" :knowledge-point/questions [{:db/id #edb/ref 17592186069219} {:db/id #edb/ref 17592186069220} {:db/id #edb/ref 17592186484210} {:db/id #edb/ref 17592186542225} {:db/id #edb/ref 17592186549989} {:db/id #edb/ref 17592186558500} {:db/id #edb/ref 17592186558524}] :knowledge-point/title "Factoring a Perfect Square Trinomial Whose Terms Have a Common Factor"} :step/id #uuid "6a2dd26d-51b3-5cc1-8396-efeb5b1b8bb7" :step/math-academy-id 4242 :step/next {:db/id #edb/ref 17592186069795}} {:db/id #edb/ref 17592186069795 :step/content {:db/id #edb/ref 17592186069941 :tutorial/content "How can we factor a trinomial that has a negative leading coefficient, like\n\n$$\n-25y^2 + 20y - 4\\,?\n$$\n\n \nWe can reduce this to a more familiar problem by factoring out $−1$ from the entire expression:\n\n$$\n-(25y^2 - 20y + 4)\n$$\n\nNow, we factor the quadratic expression inside the parentheses using the square of a difference formula:\n\n$$\n\\begin{aligned}25{y}^{2}-20y+4 & = \\\\ (5y)^{2}-20y+{2}^{2} & = \\\\ (5y)^{2}-2(10y)+{2}^{2} & = \\\\ (5y)^{2}-2(5y\\cdot 2)+{2}^{2} & = \\\\ (5y-2)^{2} & \\end{aligned}\n$$\n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}-(25{y}^{2}-20y+4) & = \\\\ -(5y-2)^{2}\\end{aligned}\n$$" :tutorial/id #uuid "757d1827-0402-5d3d-b8da-a4dc88c254bb" :tutorial/math-academy-id 1598 :tutorial/title "Factoring a Perfect Square Trinomial With a Negative Leading Coefficient"} :step/id #uuid "3464306e-5c3f-55f3-9c10-87ab309dded2" :step/math-academy-id 4244 :step/next {:db/id #edb/ref 17592186069796}} {:db/id #edb/ref 17592186069796 :step/content {:db/id #edb/ref 17592186068849 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068466 :question/id #uuid "b74ed282-c54c-56f8-aa9f-8c5ef4465712" :question/math-academy-id "e-1334"} :knowledge-point/id #uuid "b67de190-3b32-506e-b375-bd18d4543bf6" :knowledge-point/questions [{:db/id #edb/ref 17592186069338} {:db/id #edb/ref 17592186069339} {:db/id #edb/ref 17592186484231} {:db/id #edb/ref 17592186484282} {:db/id #edb/ref 17592186484292} {:db/id #edb/ref 17592186484295} {:db/id #edb/ref 17592186542210} {:db/id #edb/ref 17592186558522}] :knowledge-point/title "Factoring a Perfect Square Trinomial With a Negative Leading Coefficient"} :step/id #uuid "3222e5cc-52d3-5afd-8468-ab3d87c483b2" :step/math-academy-id 4245} {:db/id #edb/ref 17592186069876 :step/content {:db/id #edb/ref 17592186068902 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068520 :question/id #uuid "b7141e58-61cf-5134-8443-a82d79a5506e" :question/math-academy-id "e-1593"} :knowledge-point/id #uuid "69a3b7a7-1042-511a-aaff-8b0911eae499" :knowledge-point/questions [{:db/id #edb/ref 17592186069215} {:db/id #edb/ref 17592186069251} {:db/id #edb/ref 17592186484249} {:db/id #edb/ref 17592186484291} {:db/id #edb/ref 17592186542124} {:db/id #edb/ref 17592186558532}] :knowledge-point/title "Factoring a Perfect Square Trinomial Generated by the Square of a Difference"} :step/id #uuid "d8accb58-b4d7-5dc8-9c5e-a5ca4f3588a2" :step/math-academy-id 5059 :step/next {:db/id #edb/ref 17592186069794}} {:db/id #edb/ref 17592186069898 :step/content {:db/id #edb/ref 17592186069954 :tutorial/content "Other perfect square trinomials can be factored as the square of a difference:\n\n$$\n\\begin{aligned}{a}^{2}-2ab+{b}^{2} & =(a-b)^{2}\\end{aligned}\n$$\n\nTo illustrate, let's factor the expression $9x^2-24x+16$ using the square of difference formula. We perform the following steps:\n\n1\\. Write both the quadratic term and the constant term as perfect squares:\n\n  $$\n  \\begin{aligned}9{x}^{2}-24x+16 & = \\\\ (3x)^{2}-24x+(4)^{2}\\end{aligned}\n  $$\n\n2\\. Factor a $2$ out of the linear term:\n\n  $$\n  \\begin{aligned}(3x)^{2}-24x+(4)^{2} & = \\\\ (3x)^{2}-2(12x)+(4)^{2}\\end{aligned}\n  $$\n\n3\\. Write the middle parentheses $(12x)$ as a product of $3x$ and ${\\color{blue}4}\\mathbin{:}$\n\n  $$\n  \\begin{aligned}(3x)^{2}-2(12x)+(4)^{2} & = \\\\ (3x)^{2}-2(3x\\cdot 4)+(4)^{2}\\end{aligned}\n  $$\n\n4\\. Factor the trinomial using the square of difference formula. In this case, we have $a=3x$ and $b=4\\mathbin{:}$\n\n  $$\n  \\begin{aligned}(3x)^{2}-2(3x\\cdot 4)+(4)^{2} & = \\\\ (3x-4)^{2}\\end{aligned}\n  $$\n\n**Note:** Once again, we note that this method works *only* when the trinomial is a perfect square! It will *not* work for every trinomial." :tutorial/id #uuid "609ce9b5-1b4e-5dfc-9d22-4ec6ea2d640b" :tutorial/math-academy-id 1856 :tutorial/title "Factoring a Perfect Square Trinomial Generated by the Square of a Difference"} :step/id #uuid "ecc30896-0712-5c97-a35e-e51485979c95" :step/math-academy-id 6170 :step/next {:db/id #edb/ref 17592186069876}}] :activity/title "Factoring Perfect Square Trinomials With Leading Coefficients" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068930}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186542265} :activity/id #uuid "f6b132f1-8395-5934-a798-3dc92cf19ca0" :activity/scope {:db/id #edb/ref 17592186051032 :topic/id #uuid "7bffda20-cdd5-5dc8-9399-950fa61fbd19" :topic/math-academy-id 382} :activity/steps [{:db/id #edb/ref 17592186542263 :step/content {:db/id #edb/ref 17592186542225 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "374194b8-85ae-5815-89c6-1a8f87cc6dbe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2(2x-3)^{2}" :db/id #edb/ref 17592186541540} {:answer/id #uuid "39ef85ad-8276-5ed8-b41e-7af905c91f91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x+3)^{2}" :db/id #edb/ref 17592186541548} {:answer/id #uuid "5bd98886-b613-531e-838d-f40fd260e8e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2x+1)^{2}" :db/id #edb/ref 17592186541605} {:answer/id #uuid "8c94784c-933a-51ab-b0f4-2713a3427fc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4(x-3)^{2}" :db/id #edb/ref 17592186541706} {:answer/id #uuid "bbb07f95-43b5-5477-a9d0-0c1c20b3c07b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4(2x-3)^{2}" :db/id #edb/ref 17592186541811}] :answer-field/correct {:db/id #edb/ref 17592186541811} :answer-field/id #uuid "5e25dd26-d9cd-5142-93e6-a7e8dbdac2b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542014}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f03b5992-4a97-5b3b-9545-c672d1a6e209" :question/math-academy-id "q-79002" :question/problem "Factor $16{x}^{2}-48x+36.$" :question/worked-solution "Notice that all of the terms have a common factor of $4.$ Therefore, we can simplify the expression by factoring out $4,$ as follows:\n\n$$\n\\begin{aligned}16{x}^{2}-48x+36 & = \\\\ 4(4{x}^{2}-12x+9)\\end{aligned}\n$$\n\nNow, let's factor the expression inside parentheses using the square of a difference formula: \n\n$$\n\\begin{aligned}4{x}^{2}-12x+9 & = \\\\ (2x)^{2}-12x+{3}^{2} & = \\\\ (2x)^{2}-2\\cdot (2x\\cdot 3)+{3}^{2} & = \\\\ (2x-3)^{2}\\end{aligned}\n$$\n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}4(4{x}^{2}-12x+9) & = \\\\ 4(2x-3)^{2}\\end{aligned}\n$$"} :step/id #uuid "77f81baa-f622-5822-ad79-2391b7a40d19"} {:db/id #edb/ref 17592186542265 :step/content {:db/id #edb/ref 17592186542124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bb9bce2-0c34-585a-9786-18cdbee30507" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3y-3)^{2}" :db/id #edb/ref 17592186541510} {:answer/id #uuid "41931e51-fe5c-5024-b27f-7666c39e6cec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(y-3)^{2}" :db/id #edb/ref 17592186541559} {:answer/id #uuid "b7268394-d3df-50dd-aefd-a1d483bd162e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3y-1)^{2}" :db/id #edb/ref 17592186541799} {:answer/id #uuid "bfc42d89-bdf4-5894-9f74-40a503a37160" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9(y-1)^{2}" :db/id #edb/ref 17592186541827} {:answer/id #uuid "c4b7e90c-e93d-59fc-87e0-2091f13f04ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3(y-1)^{2}" :db/id #edb/ref 17592186541835}] :answer-field/correct {:db/id #edb/ref 17592186541799} :answer-field/id #uuid "bbdf1e33-0fba-578c-aaad-d0ea6db8cbc2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542052}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1c00ad8d-9908-5ab2-b9e6-65ef0d5fcd94" :question/math-academy-id "q-31964" :question/problem "$9{y}^{2}-6y+1=$" :question/worked-solution "The \"square of a difference\" formula states that\n\n$$\n{a}^{2}-2ab+{b}^{2}=(a-b)^{2}.\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n9{y}^{2}-6y+1.\n$$\n\nFirst, we write both the quadratic term and the constant term as perfect squares:\n\n$$\n\\begin{aligned}(3y)^{2}-6y+(1)^{2}\\end{aligned}\n$$\n\nNext, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}(3y)^{2}-2(3y)+(1)^{2}\\end{aligned}\n$$\n\nThen, we write the middle parentheses $(3y)$ as a product of $3y$ and $1:$ \n\n$$\n\\begin{aligned}(3y)^{2}-2(3y\\cdot 1)+(1)^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of difference formula with $a=3y$ and $b=1.$ This gives \n\n$$\n\\begin{aligned}(3y-1)^{2}.\\end{aligned}\n$$"} :step/id #uuid "7da91827-5e59-5953-84fa-3077985bee0d" :step/next {:db/id #edb/ref 17592186542275}} {:db/id #edb/ref 17592186542275 :step/content {:db/id #edb/ref 17592186542210 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30bc40bd-0baa-53bc-b504-a2c240a14dc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-(2x-1)^{2}" :db/id #edb/ref 17592186541522} {:answer/id #uuid "37d6615e-66de-5728-ae8f-8e2fb4faec1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-(2x+1)^{2}" :db/id #edb/ref 17592186541541} {:answer/id #uuid "464d7d12-8513-5d3d-b8c3-79b6c483fb54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-(4x-1)^{2}" :db/id #edb/ref 17592186541571} {:answer/id #uuid "62b93017-abd9-5aa6-a8a4-50b59a42230d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x-2)^{2}" :db/id #edb/ref 17592186541625} {:answer/id #uuid "995306bc-ae35-5f95-966b-0932e6545022" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4x-1)^{2}" :db/id #edb/ref 17592186541741}] :answer-field/correct {:db/id #edb/ref 17592186541522} :answer-field/id #uuid "d785b8b3-293e-5ba6-866c-d51249e905eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186542068}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cf9a0034-0b04-5113-8b59-eaa614930923" :question/math-academy-id "q-44032" :question/problem "Factor $-4{x}^{2}+4x-1.$" :question/worked-solution "Notice that the leading coefficient is negative. To reduce the expression to a more familiar form, we can factor out $-1,$ as follows:\n\n$$\n\\begin{aligned}-4{x}^{2}+4x-1 & = \\\\ -(4{x}^{2}-4x+1)\\end{aligned}\n$$\n\nNow, we factor the quadratic expression inside the parentheses using the square of a difference formula:\n\n$$\n\\begin{aligned}4{x}^{2}-4x+1 & = \\\\ (2x)^{2}-4x+{1}^{2} & = \\\\ (2x)^{2}-2\\cdot (2x)+{1}^{2} & = \\\\ (2x-1)^{2} & \\end{aligned}\n$$\n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}-(4{x}^{2}-4x+1) & = \\\\ -(2x-1)^{2} & \\end{aligned}\n$$"} :step/id #uuid "bf2aa872-b9dd-51ab-a97f-7add7180d9e9" :step/next {:db/id #edb/ref 17592186542263}}] :activity/title "Factoring Perfect Square Trinomials With Leading Coefficients" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186541427}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186558685} :activity/id #uuid "556e988b-a172-55d1-a8bf-2ddafc6364c6" :activity/scope {:db/id #edb/ref 17592186051032 :topic/id #uuid "7bffda20-cdd5-5dc8-9399-950fa61fbd19" :topic/math-academy-id 382} :activity/steps [{:db/id #edb/ref 17592186558590 :step/content {:db/id #edb/ref 17592186558524 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11615e8c-79b7-5430-8245-0a55f42d7861" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2(r-2)^{2}" :db/id #edb/ref 17592186557903} {:answer/id #uuid "564d466f-3e14-571e-98fa-b5a61a8cfbed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4(r-2)^{2}" :db/id #edb/ref 17592186558028} {:answer/id #uuid "af67a4bf-7608-52ba-b8bb-4cfbeb581cb6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4(2r-1)^{2}" :db/id #edb/ref 17592186558215} {:answer/id #uuid "afb197b9-ef77-55c0-8d73-cfe31f69e11f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2(4r-1)^{2}" :db/id #edb/ref 17592186558216} {:answer/id #uuid "d5417484-3bdb-5d4d-ae0d-d6f710f8b199" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4(2r-4)^{2}" :db/id #edb/ref 17592186558286}] :answer-field/correct {:db/id #edb/ref 17592186558215} :answer-field/id #uuid "c99dfe19-b0ba-52de-a707-b226b7df9dfd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558454}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6b4b9fe6-eb97-5c93-8f7d-fda1228ca372" :question/math-academy-id "q-111641" :question/problem "Factor the expression $16{r}^{2}-16r+4.$" :question/worked-solution "Notice that all of the terms have a common factor of $4.$ Therefore, we can simplify the expression by factoring out $4,$ as follows:\n\n$$\n\\begin{aligned}16{r}^{2}-16r+4 & = \\\\ 4(4{r}^{2}-4r+1)\\end{aligned}\n$$\n\nNow, let's factor the expression inside parentheses using the square of a difference formula:\n\n$$\n\\begin{aligned}4{r}^{2}-4r+1 & = \\\\ (2r)^{2}-4r+{1}^{2} & = \\\\ (2r)^{2}-2\\cdot (2r\\cdot 1)+{1}^{2} & = \\\\ (2r-1)^{2}\\end{aligned}\n$$\n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}4(4{r}^{2}-4r+1) & = \\\\ 4(2r-1)^{2}\\end{aligned}\n$$"} :step/id #uuid "1bc2cdcc-6358-53c6-aabf-fcab9b35aa60"} {:db/id #edb/ref 17592186558682 :step/content {:db/id #edb/ref 17592186558522 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19f927e8-fd04-5b24-9051-6b5a918ad64c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{(3x-\\frac{1}{3})}^{2}" :db/id #edb/ref 17592186557925} {:answer/id #uuid "32f2a486-695a-5441-9417-59951b7b6c17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3{(x-\\frac{2}{3})}^{2}" :db/id #edb/ref 17592186557973} {:answer/id #uuid "4c6361cb-48a2-5f00-a113-53b05b147d44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3{(3x-\\frac{1}{3})}^{2}" :db/id #edb/ref 17592186558013} {:answer/id #uuid "be3f0de2-0bc3-54c5-b294-c07f2c0dc17f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{(3x-\\frac{2}{3})}^{2}" :db/id #edb/ref 17592186558247} {:answer/id #uuid "ef63b783-49af-546d-8cf4-f1476656f81b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{(3x+\\frac{4}{9})}^{2}" :db/id #edb/ref 17592186558342}] :answer-field/correct {:db/id #edb/ref 17592186558247} :answer-field/id #uuid "5b7c1f54-810f-55b1-ab45-181c23bc394b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558401}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6884ae1e-aa7f-516d-8c30-2f343ce00f89" :question/math-academy-id "q-79010" :question/problem "Factor $-9{x}^{2}+4x-\\frac{4}{9}.$" :question/worked-solution "Notice that the leading coefficient is negative. To reduce the expression to a more familiar form, we can factor out $-1,$ as follows:\n\n$$\n\\begin{aligned}-9{x}^{2}+4x-\\frac{4}{9} & = \\\\ -(9{x}^{2}-4x+\\frac{4}{9})\\end{aligned}\n$$\n\nNow, we factor the quadratic expression inside the parentheses using the square of a difference  formula: \n\n$$\n\\begin{aligned}9{x}^{2}-4x+\\frac{4}{9} & = \\\\ (3x)^{2}-4x+{(\\frac{2}{3})}^{2} & = \\\\ (3x)^{2}-2\\cdot (\\frac{2}{3}\\cdot 3x)+{(\\frac{2}{3})}^{2} & = \\\\ {(3x-\\frac{2}{3})}^{2} & \\end{aligned}\n$$\n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}-(9{x}^{2}-4x+\\frac{4}{9}) & = \\\\ -{(3x-\\frac{2}{3})}^{2} & \\end{aligned}\n$$"} :step/id #uuid "bb11de92-084a-57f2-b3da-26bfa73e05a2" :step/next {:db/id #edb/ref 17592186558590}} {:db/id #edb/ref 17592186558685 :step/content {:db/id #edb/ref 17592186558532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03fdc9f9-e821-5130-94c5-b047cb92adcc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3x+2)^{2}" :db/id #edb/ref 17592186557877} {:answer/id #uuid "7dcf9040-4fc0-56e1-866d-757572273d2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3x-4)^{2}" :db/id #edb/ref 17592186558111} {:answer/id #uuid "a0646697-4c1e-5318-a5ed-5b39405c2f09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3x+4)^{2}" :db/id #edb/ref 17592186558183} {:answer/id #uuid "a7f57c5f-876f-5134-b6a1-aefa35bdd924" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3x-2)^{2}" :db/id #edb/ref 17592186558197} {:answer/id #uuid "fb679a03-40d9-58cc-afc5-baf751a42497" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9x-2)^{2}" :db/id #edb/ref 17592186558361}] :answer-field/correct {:db/id #edb/ref 17592186558197} :answer-field/id #uuid "23e236f4-214d-5a90-ab31-d0cd6e1daf09" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558376}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "82da910d-da60-52ba-aecb-7ff9ed90f208" :question/math-academy-id "q-31979" :question/problem "Factor $9{x}^{2}-12x+4$" :question/worked-solution "The \"square of a difference\" formula states that\n\n$$\n{a}^{2}-2ab+{b}^{2}=(a-b)^{2}.\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n9{x}^{2}-12x+4.\n$$\n\nFirst, we write both the quadratic term and the constant term as perfect squares:\n\n$$\n\\begin{aligned}(3x)^{2}-12x+(2)^{2}\\end{aligned}\n$$\n\nNext, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}(3x)^{2}-2(6x)+(2)^{2}\\end{aligned}\n$$\n\nThen, we write the middle parentheses $(6x)$ as a product of $3x$ and $2:$\n\n$$\n\\begin{aligned}(3x)^{2}-2(3x\\cdot 2)+(2)^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of difference formula with $a=3x$ and $b=2.$ This gives \n\n$$\n\\begin{aligned}(3x-2)^{2}.\\end{aligned}\n$$"} :step/id #uuid "c1ad8542-52af-5573-9dd5-00ac5b8806c4" :step/next {:db/id #edb/ref 17592186558682}}] :activity/title "Factoring Perfect Square Trinomials With Leading Coefficients" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186557859}]}
