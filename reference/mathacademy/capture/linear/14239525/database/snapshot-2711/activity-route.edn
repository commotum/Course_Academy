#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186558579} :activity/id #uuid "424ba6e4-dc0e-5427-9652-73300792190d" :activity/steps [{:db/id #edb/ref 17592186558579 :step/content {:db/id #edb/ref 17592186558483 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15c9e461-7c4e-5cd3-a4f3-2d3220aa7ff4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The ant population grew by a factor of $(0.5)^{4}$ over the first $4$ months" :db/id #edb/ref 17592186557918} {:answer/id #uuid "399df585-eb06-5669-97c7-06f4d51d76dd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The ant population grew by a factor of $(1.5)^{4}$ over the first $4$ months" :db/id #edb/ref 17592186557985} {:answer/id #uuid "64892909-7364-58de-952f-fa0848ebe144" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The ant population grew by a factor of $(1.5)$ over the first $4$ months" :db/id #edb/ref 17592186558062} {:answer/id #uuid "7e085ae9-98ac-56f0-b5d5-d32c2e6deea6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The ant population grew by a factor of $(1.5)^{4}$ every month" :db/id #edb/ref 17592186558112} {:answer/id #uuid "a3a21755-e291-5e1c-97b3-dade2fb137bc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The ant population grew by a factor of $(0.5)$ every month" :db/id #edb/ref 17592186558192}] :answer-field/correct {:db/id #edb/ref 17592186557985} :answer-field/id #uuid "52506e60-eee5-5d08-b500-dab66c57dd87" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558394}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "087c8650-e701-5898-adf4-3590d90adcb5" :question/math-academy-id "q-86572" :question/problem "The population of an ant colony grew exponentially, and within $4$ months, the population was $1\\,000\\cdot (1.5)^{4}.$ What does the expression $(1.5)^{4}$ mean in this context?" :question/worked-solution "The given expression is an exponential growth expression of the form $y(t)=a\\cdot {b}^{t}$, where:\n\n- $a=1\\,000$ represents the initial population of ants\n\n- $b=1.5$ is the growth factor\n\n- $t=4$ is the time in months since the start of the observations\n\nFor the factor $(1.5)^{4},$ the growth rate $(1.5)$ means that the population grows by $50%$ per month, and the exponent $(4)$ gives the number of months. \n\nTherefore, the ant population grew by a factor of $(1.5)^{4}$ over the first $4$ months."} :step/id #uuid "03186a3d-c5ee-569a-a03d-2b6a3c51d524" :step/next {:db/id #edb/ref 17592186558715}} {:db/id #edb/ref 17592186558591 :step/content {:db/id #edb/ref 17592186558562 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17f6572f-b86d-54c5-bb49-7fa7bc5c2a36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25.08m" :db/id #edb/ref 17592186557922} {:answer/id #uuid "269fec6b-818b-5f70-98e1-a75bedd0363d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25.08" :db/id #edb/ref 17592186557944} {:answer/id #uuid "97ebf90f-51ba-5893-b02b-693524e03d37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.08m+25" :db/id #edb/ref 17592186558161} {:answer/id #uuid "b3389576-536a-5d11-8be6-2a1b24d73fd3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.08m+25m" :db/id #edb/ref 17592186558221} {:answer/id #uuid "d13a624e-cae6-5902-8803-8b2034eb6d4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25m+0.08" :db/id #edb/ref 17592186558282}] :answer-field/correct {:db/id #edb/ref 17592186558161} :answer-field/id #uuid "a8623f45-ebf2-537a-8e61-c7562666bd8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558440}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c762ecb0-e32e-5090-9c36-4c8778229991" :question/math-academy-id "q-110235" :question/problem "A car rental agency charges a fixed fee of $$25$ plus $$0.08$ per mile for the rental of a particular car.\n\nWhat expression gives the total cost, in dollars, if the car is driven for  $m$ miles?" :question/worked-solution "If $m$ is the number of miles that the car is driven, and the car rental agency charges a fee of $$0.08$ per mile, then the cost for $m$ miles must be $0.08m.$ \n\nThere is also a fixed fee of $$25.$ Consequently, the constant term of the expression should be $25.$\n\nTherefore, the expression that represents the total cost (in dollars) when the car is driven for  $m$ miles must be \n\n$$\n0.08m+25\n$$"} :step/id #uuid "1c1b618d-aae5-5ea0-95a9-b46b784b8741" :step/next {:db/id #edb/ref 17592186558630}} {:db/id #edb/ref 17592186558600 :step/content {:db/id #edb/ref 17592186558500 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34109e3d-3b0d-5003-a125-952c0bd2d86d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2(r+4)^{2}" :db/id #edb/ref 17592186557974} {:answer/id #uuid "4a6acba3-20a0-545b-bf46-336da2fad31d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(r+4)^{2}" :db/id #edb/ref 17592186558010} {:answer/id #uuid "8fb7a897-e757-5775-aca0-77aeb1d2bec0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4(r+2)^{2}" :db/id #edb/ref 17592186558148} {:answer/id #uuid "b4ea14d1-f64a-52c0-95f0-ce44bda17a42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2r+4)^{2}" :db/id #edb/ref 17592186558227} {:answer/id #uuid "ec2b8135-416e-5959-a1ee-51202d97ac35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(r+2)^{2}" :db/id #edb/ref 17592186558338}] :answer-field/correct {:db/id #edb/ref 17592186557974} :answer-field/id #uuid "8df196d8-9a07-500d-a8ae-b16af44641d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558428}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "275b1fab-422b-52b6-b4bd-24f3217dcda4" :question/math-academy-id "q-79007" :question/problem "Factor the expression $2{r}^{2}+16r+32.$" :question/worked-solution "Notice that all of the terms have a common factor of $2.$ Therefore, we can simplify the expression by factoring out $2,$ as follows:\n\n$$\n\\begin{aligned}2{r}^{2}+16r+32 & = \\\\ 2({r}^{2}+8r+16)\\end{aligned}\n$$\n\nNow, let's factor the expression inside parentheses using the square of a sum formula:\n\n$$\n\\begin{aligned}{r}^{2}+8r+16 & = \\\\ {r}^{2}+8r+{4}^{2} & = \\\\ {r}^{2}+2\\cdot 4r+{4}^{2} & = \\\\ (r+4)^{2}\\end{aligned}\n$$\n\n \n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}2({r}^{2}+8r+16) & = \\\\ 2(r+4)^{2}\\end{aligned}\n$$"} :step/id #uuid "24cac7e7-efc1-566c-a817-79333c9bfd52" :step/next {:db/id #edb/ref 17592186558705}} {:db/id #edb/ref 17592186558612 :step/content {:db/id #edb/ref 17592186558541 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "447fc2d9-e342-5d8f-a1d4-79984f1e26a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{m}^{3}+15{m}^{2}p-25m{p}^{2}" :db/id #edb/ref 17592186558003} {:answer/id #uuid "a803faa9-c286-5139-b61f-9fb173c0ef1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{m}^{3}+25{m}^{2}p-15m{p}^{2}" :db/id #edb/ref 17592186558198} {:answer/id #uuid "b782892a-5a08-5162-865f-654edcb91123" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{m}^{3}-15{m}^{2}p+15m{p}^{2}" :db/id #edb/ref 17592186558235} {:answer/id #uuid "cb2612d5-aaef-5a39-9436-92312929bfd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{m}^{3}-15{m}^{2}p+75m{p}^{2}" :db/id #edb/ref 17592186558273} {:answer/id #uuid "debcd650-c4b8-526f-aa81-69ba4678bf12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{m}^{3}-25{m}^{2}p+75m{p}^{2}" :db/id #edb/ref 17592186558309}] :answer-field/correct {:db/id #edb/ref 17592186558273} :answer-field/id #uuid "feec1631-31d9-531c-849d-52f889b504d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558477}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "974e81bd-58de-5f99-a98d-0d5e2c335ae7" :question/math-academy-id "q-110678" :question/problem "Find, in descending powers of $m$ and ascending powers of $p,$ the first three terms of the binomial expansion of ${(m-5p)}^{3}.$" :question/worked-solution "First, let's compare our expression with the binomial\n\n$$\n(a+b)^{n}.\n$$\n\nHere we have that $n=3,$ $a=m,$ and $b=-5p.$ So, the exponents of the binomial expansion must follow the pattern\n\n$$\n{a}^{3}{b}^{0},\\,{a}^{2}{b}^{1},\\,{a}^{1}{b}^{2},\\,{a}^{0}{b}^{3}.\n$$\n\nThe $3$rd row in Pascal's Triangle is $(1,3,3,1).$ Therefore,\n\n$$\n\\begin{aligned}{(m-5p)}^{3} & =1{a}^{3}{b}^{0}+3{a}^{2}b+3a{b}^{2}+1{a}^{0}{b}^{3} \\\\  & =1(m)^{3}(-5p)^{0}+3(m)^{2}(-5p)^{1}+3(m)^{1}(-5p)^{2}+1(m)^{0}(-5p)^{3} \\\\  & =1({m}^{3})(1)+3({m}^{2})(-5p)+3(m)(25{p}^{2})+1(1)(-125{p}^{3}) \\\\  & ={m}^{3}-15{m}^{2}p+75m{p}^{2}-125{p}^{3}.\\end{aligned}\n$$\n\nFinally, in descending powers of $m$ and ascending powers of $p,$ the first three terms are\n\n$$\n{m}^{3}-15{m}^{2}p+75m{p}^{2}.\n$$"} :step/id #uuid "396d86b8-1505-53aa-9124-4546fecbaee3" :step/next {:db/id #edb/ref 17592186558600}} {:db/id #edb/ref 17592186558620 :step/content {:db/id #edb/ref 17592186558559 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "031bf799-5c0f-501b-be96-6cbd79e1b490" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Squared minutes per squared word" :db/id #edb/ref 17592186557875} {:answer/id #uuid "7e28fd77-d740-550a-b58d-069aadbeeea6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Minutes per word" :db/id #edb/ref 17592186558113} {:answer/id #uuid "93a4d8c6-ea62-5e5d-b566-5edd14f62309" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Words per minute" :db/id #edb/ref 17592186558155} {:answer/id #uuid "9be2087c-c774-5557-8133-73f04cfd8ee9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Squared minutes per word" :db/id #edb/ref 17592186558173} {:answer/id #uuid "e8e4ee09-0ef0-5d0b-9aca-a61f1f2aa144" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Squared words per minute" :db/id #edb/ref 17592186558333}] :answer-field/correct {:db/id #edb/ref 17592186558155} :answer-field/id #uuid "07392a13-f0cf-5fb2-95c1-549901d90523" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558366}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bae6efb2-0046-5ab6-af30-8194a5982502" :question/math-academy-id "q-46088" :question/problem "An adult says $11\\,400$ words in $60$ minutes. If we want to determine the average of words spoken per minute, we use the formula $P=\\frac{w}{t},$ being $w$ the total number of words and $t$ the time in minutes.\n\nIn words, what is the appropriate measurement unit for $P?$" :question/worked-solution "We are solving for measurement units, so we can ignore the quantities $11\\,400$ and $60.$ They do not matter, if we are just solving for units.\n\nSince $w$ represents $\\text{words}$ and $t$ represents $\\text{minute},$ the appropriate measurement unit for $P=\\frac{w}{t}$ is $\\frac{\\text{words}}{\\text{minute}},$ that is, 'words per minute'."} :step/id #uuid "52894ffc-4454-536c-82ee-5b920e9bd6a7" :step/next {:db/id #edb/ref 17592186558660}} {:db/id #edb/ref 17592186558630 :step/content {:db/id #edb/ref 17592186558498 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "288914e4-d493-515b-808a-f912ce333ad3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2{a}^{3}}{3}" :db/id #edb/ref 17592186557949} {:answer/id #uuid "353136f8-ecf7-5c48-8473-c7eadd6d95e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4{a}^{3}}{9}" :db/id #edb/ref 17592186557975} {:answer/id #uuid "408e521d-947c-50e2-b5f6-7d4ba495fdc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16{a}^{3}}{9}" :db/id #edb/ref 17592186557996} {:answer/id #uuid "627caa3c-e441-5d00-9e01-34bb5014d364" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4{a}^{3}}{3}" :db/id #edb/ref 17592186558055} {:answer/id #uuid "b4c77165-e838-5062-b664-1874e30c4e8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16{a}^{3}}{3}" :db/id #edb/ref 17592186558226}] :answer-field/correct {:db/id #edb/ref 17592186557996} :answer-field/id #uuid "6615ef83-050b-5898-b15a-e3a3716fe011" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558408}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "21ebb6b3-86f2-53e7-bae9-ebede4e1482d" :question/math-academy-id "q-22491" :question/problem "Simplify $6{(\\frac{2a}{3})}^{3}.$" :question/worked-solution "First, we apply the power of quotient rule:\n\n$$\n\\begin{aligned}6{(\\frac{2a}{3})}^{3}=6\\cdot \\frac{(2a)^{3}}{{3}^{3}}\\end{aligned}\n$$\n\nThen, we apply the power of product rule and simplify:\n\n$$\n\\begin{aligned}6\\cdot \\frac{(2a)^{3}}{{3}^{3}} & = \\\\ 6\\cdot \\frac{{2}^{3}{a}^{3}}{{3}^{3}} & = \\\\ 6\\cdot \\frac{8{a}^{3}}{27} & = \\\\ \\frac{48{a}^{3}}{27} & = \\\\ \\frac{16{a}^{3}}{9}\\end{aligned}\n$$"} :step/id #uuid "625689c5-7219-5fe2-95ce-d90205ef1868" :step/next {:db/id #edb/ref 17592186558612}} {:db/id #edb/ref 17592186558648 :step/content {:db/id #edb/ref 17592186558568 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08e38fd4-78a0-5f72-8b08-948e187fd9c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y+1=\\frac{1}{2}(x-4)" :db/id #edb/ref 17592186557886} {:answer/id #uuid "1a3e90ef-c6ce-533a-a40f-d4ffc63dde0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y+1=\\frac{1}{2}(x+4)" :db/id #edb/ref 17592186557926} {:answer/id #uuid "30069e68-9995-5a59-8ed5-d245d97518da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y-1=\\frac{1}{2}(x-4)" :db/id #edb/ref 17592186557966} {:answer/id #uuid "48914b16-bfbe-5978-8349-6eb620ed5faf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y+1=2(x-4)" :db/id #edb/ref 17592186558009} {:answer/id #uuid "6e1c7934-c803-50f9-a50a-111b288201eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y-1=2(x+4)" :db/id #edb/ref 17592186558083}] :answer-field/correct {:db/id #edb/ref 17592186557886} :answer-field/id #uuid "01976aa1-1054-53a1-96ef-ee7af82a4c0f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558364}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d5f6ff3b-f39c-5102-ab5a-34006293061b" :question/math-academy-id "q-51967" :question/problem "Find, in point-slope form, the equation of the line that passes through the points $(4,-1)$ and $(-2,-4).$" :question/worked-solution "We know that the line passes through the point $(4,-1),$ so we can use $({x}_{1},{y}_{1})=(4,-1)$ in our point-slope formula. All that remains is to compute $m,$ and we can do this using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{-4-(-1)}{-2-4)}=\\frac{-3}{-6}=\\frac{1}{2}\\end{aligned}\n$$\n\nThen, we substitute $m=\\frac{1}{2}$ and the point $({x}_{1},{y}_{1})=(4,-1)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-1) & =\\frac{1}{2}(x-4) \\\\ y+1 & =\\frac{1}{2}(x-4)\\end{aligned}\n$$"} :step/id #uuid "7dc9c66a-b07c-5e94-9816-f7a50fb0d888" :step/next {:db/id #edb/ref 17592186558591}} {:db/id #edb/ref 17592186558660 :step/content {:db/id #edb/ref 17592186558531 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ac207e8-73fa-5e89-8fbc-af991bfbe602" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "300" :db/id #edb/ref 17592186558011} {:answer/id #uuid "5d2254a9-fc00-5581-9d5c-83ceba96c46c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "900" :db/id #edb/ref 17592186558046} {:answer/id #uuid "a94e24ce-736a-5cc0-82e3-efca673d1778" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "60" :db/id #edb/ref 17592186558201} {:answer/id #uuid "c74c4e99-03c0-5ebe-8a9d-254ff9d1cb79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "75" :db/id #edb/ref 17592186558263} {:answer/id #uuid "e07ce678-db48-59a1-815a-ba2e08a8b7d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\,500" :db/id #edb/ref 17592186558312}] :answer-field/correct {:db/id #edb/ref 17592186558011} :answer-field/id #uuid "4a480632-ae7b-5323-8948-482517326c3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558387}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7a0d5183-c49d-5331-96ab-591f74bbcbc1" :question/math-academy-id "q-103756" :question/problem "$\\text{LCM}(75,20,15)=$" :question/worked-solution "To find the lowest common multiple of three numbers, we first find their prime factorizations. \n\n- We start by finding the prime factorization of $75:$\n\n![](images/29/292ce7efadbf5b6797dc8fabe6efa2689ba3d000fcf00347f29b5f03f4cf5f3c.png)\n\nTherefore, $75=3\\cdot {5}^{2}.$\n\n- Next, we find the prime factorization of $20:$\n\n![](images/7e/7e03a139fc3afa7df4d7f32ecf42f8f30d19bfe0415725f47fe5be63301899b5.png)\n\nTherefore, $20={2}^{2}\\cdot 5.$\n\n- Then, we find the prime factorization of $15.$ We easily deduce that $15=3\\cdot 5.$\n\nSo, we have the following prime factorizations:\n\n$$\n\\begin{aligned}75 & =3\\cdot {5}^{2} \\\\ 20 & ={2}^{2}\\cdot 5 \\\\ 15 & =3\\cdot 5\\end{aligned}\n$$\n\nNow, we write down every prime factor that is shown above, and we raise each prime factor to the highest power given in any of the factorizations:\n\n- the highest power of $2$ is $2$\n\n- the highest power of $3$ is $1$\n\n- the highest power of $5$ is $2$\n\nTherefore, the lowest  common multiple of $75$, $20$  and $15$ is \n\n$$\n\\text{LCM}(75,20,15)={2}^{2}\\cdot 3\\cdot {5}^{2}=300.\n$$"} :step/id #uuid "94a757d5-404c-567b-b639-e95446077c0f"} {:db/id #edb/ref 17592186558705 :step/content {:db/id #edb/ref 17592186558496 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05485992-b85c-5225-9e72-440551dd15ee" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$10$ only" :db/id #edb/ref 17592186557879} {:answer/id #uuid "14b76520-50ac-5cd5-99c7-86524ce9ed90" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8$ only" :db/id #edb/ref 17592186557915} {:answer/id #uuid "5c7095a7-bdc8-5a9f-8d33-1c8194a65ae6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ and $8$" :db/id #edb/ref 17592186558043} {:answer/id #uuid "90fbd983-ad08-539f-8146-5de8b1a0602d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There are no real solutions" :db/id #edb/ref 17592186558152} {:answer/id #uuid "ed7eb51c-211b-5ca1-af3b-359144f9a660" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$6$ and $10$" :db/id #edb/ref 17592186558340}] :answer-field/correct {:db/id #edb/ref 17592186558340} :answer-field/id #uuid "56104f36-cdfd-5e90-8a25-90c8c06a89bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558399}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1f819e43-7e0b-5558-81ee-7d5d86950aea" :question/math-academy-id "q-111443" :question/problem "Find all of the real solutions to the equation $5(x-8)^{8}=1280.$" :question/worked-solution "We can solve this equation by isolating the $(x-8)^{8}$ term and then taking the $8$th root of each side.\n\nFirst, let's isolate the $(x-8)^{8}$ term on the left-hand side:\n\n$$\n\\begin{aligned}5(x-8)^{8} & =1280 \\\\ (x-8)^{8} & =256\\end{aligned}\n$$\n\nNow, we take the $8$th root of each side and solve for $x.$ Since the exponent $(8)$ is even, we consider both the positive and negative solutions:\n\n$$\n\\begin{aligned}(x-8)^{8} & =256 \\\\ \\sqrt[8]{(x-8)^{8}} & =\\pm \\sqrt[8]{256} \\\\ x-8 & =\\pm \\sqrt[8]{{2}^{8}} \\\\ x-8 & =\\pm 2 \\\\ x & =8\\pm 2\\end{aligned}\n$$\n\nTherefore, the solutions are $x=6$ and $x=10.$"} :step/id #uuid "ea9c4816-ac6a-5bcd-8e6d-e9fca0874b38" :step/next {:db/id #edb/ref 17592186558620}} {:db/id #edb/ref 17592186558715 :step/content {:db/id #edb/ref 17592186558573 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a889f65-4c3f-5f47-875f-97317df017a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186557955}] :answer-field/correct {:db/id #edb/ref 17592186557955} :answer-field/id #uuid "840ece26-ec00-5689-95c2-ab54661da979" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186558425} {:answer-field/choices [{:answer/id #uuid "b8d3e3a2-f855-5742-b719-5e9847e96aab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186558236}] :answer-field/correct {:db/id #edb/ref 17592186558236} :answer-field/id #uuid "e02a5fd5-c8b7-5c92-871b-d0cf8ac1eaf3" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186558466}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f2633cd2-d747-5eed-ad0b-333971ef5a97" :question/math-academy-id "q-181154" :question/problem "Consider the following system  of equations:\n\n$$\n\\{\\begin{aligned}2x=3 \\\\ x-y=1\\end{aligned}\n$$\n\nFind the solution $(x,y)$ to this system using the method of substitution.\n\n$(x,y)=($\n{{field-1}}\n$,$\n{{field-2}}\n$)$" :question/worked-solution "We will isolate a variable in one of the equations and then substitute it into the other equation. It doesn't matter which equation we pick first, so we choose the easiest one. In this case, the first equation looks like the easiest.\n\nUsing the first equation, we can isolate $x$ by dividing both sides of the equation by $2:$\n\n$$\n\\begin{aligned}2x & =3 \\\\ x & =\\frac{3}{2}\\end{aligned}\n$$\n\nIf we now substitute $x=\\frac{3}{2}$ into $x-y=1,$ then we can find the value of $y:$\n\n$$\n\\begin{aligned}x-y & =1 \\\\ \\frac{3}{2}-y & =1 \\\\ -y & =-\\frac{1}{2} \\\\ y & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=\\frac{3}{2},\\,y=\\frac{1}{2},$ which can be expressed as $(\\frac{3}{2},\\frac{1}{2}).$"} :step/id #uuid "ffda8c96-daa1-5849-a03c-4fd7a2a82010" :step/next {:db/id #edb/ref 17592186558648}}] :activity/title "Quiz 18" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186557858}]}
