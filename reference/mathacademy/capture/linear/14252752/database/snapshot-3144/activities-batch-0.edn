#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186106584} :activity/id #uuid "aa7f2ab0-ace7-558b-8680-463a0ed634bc" :activity/scope {:db/id #edb/ref 17592186049443 :topic/id #uuid "f580d418-6860-5b04-b964-2999aa08b42f" :topic/math-academy-id 1361} :activity/steps [{:db/id #edb/ref 17592186106584 :step/content {:db/id #edb/ref 17592186107146 :tutorial/content "Recall that for $x >0,$ we have \n\n$$\n\\dfrac{\\textrm d }{\\textrm d x}(\\ln{x}) = \\dfrac 1 x.\n$$\n\nWe can generalize this to all values $x\\neq 0$ by including an absolute value inside the natural logarithm: \n\n$$\n\\dfrac{\\textrm d }{\\textrm d x}(\\ln{|x|}) = \\dfrac 1 x.\n$$\n\nTherefore, the integral of the reciprocal function is\n\n$$\n\\int \\dfrac 1 x \\,\\textrm{d}x = \\ln |x| + C.\n$$" :tutorial/id #uuid "83cb4468-abfe-5dfb-9c34-b104314cb2f2" :tutorial/math-academy-id 706 :tutorial/title "Introduction"} :step/id #uuid "d2a51ea1-720f-590d-8ca3-9d61de971a01" :step/math-academy-id 1359 :step/next {:db/id #edb/ref 17592186106585}} {:db/id #edb/ref 17592186106585 :step/content {:db/id #edb/ref 17592186105715 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105573 :question/id #uuid "625c532a-d455-5b15-880d-e9fc5ae8ee72" :question/math-academy-id "e-374"} :knowledge-point/id #uuid "cf98ee24-7774-5674-8a1e-63f4f6d225c0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048442} {:db/id #edb/ref 17592186050690}] :knowledge-point/question-generator {:db/id #edb/ref 17592186484369} :knowledge-point/questions [{:db/id #edb/ref 17592186106281} {:db/id #edb/ref 17592186106366} {:db/id #edb/ref 17592186238000} {:db/id #edb/ref 17592186238028} {:db/id #edb/ref 17592186297248} {:db/id #edb/ref 17592186297250} {:db/id #edb/ref 17592186338893} {:db/id #edb/ref 17592186339052} {:db/id #edb/ref 17592186484366} {:db/id #edb/ref 17592186573896}] :knowledge-point/title "Integrating a Reciprocal Function"} :step/id #uuid "d0403fff-a722-5aff-aa14-4dcdf9fc1af2" :step/math-academy-id 1360 :step/next {:db/id #edb/ref 17592186106586}} {:db/id #edb/ref 17592186106586 :step/content {:db/id #edb/ref 17592186105716 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105574 :question/id #uuid "9c57c69e-efa2-5e82-992c-53570e61af09" :question/math-academy-id "e-375"} :knowledge-point/id #uuid "3c865ec2-5bed-5892-966b-a586097be923" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050321}] :knowledge-point/questions [{:db/id #edb/ref 17592186106279} {:db/id #edb/ref 17592186106280} {:db/id #edb/ref 17592186238001} {:db/id #edb/ref 17592186238029} {:db/id #edb/ref 17592186297251} {:db/id #edb/ref 17592186297252} {:db/id #edb/ref 17592186297253} {:db/id #edb/ref 17592186297254} {:db/id #edb/ref 17592186332660}] :knowledge-point/title "Integrating the Sum of a Reciprocal Function and a Power Function"} :step/id #uuid "d3461ccf-9881-578a-9071-ac64bd4fa34f" :step/math-academy-id 1363 :step/next {:db/id #edb/ref 17592186106587}} {:db/id #edb/ref 17592186106587 :step/content {:db/id #edb/ref 17592186107147 :tutorial/content "For any constant $C,$ we can always write $C = \\ln K,$ where $K>0$ is some other constant. Then, using the laws of logarithms, we can write\n\n$$\n\\begin{aligned}\\int \\frac{1}{x}\\,\\text{d}x & =\\operatorname{ln}⁡|x|+C \\\\  & =\\operatorname{ln}⁡|x|+\\operatorname{ln}⁡K \\\\  & =\\operatorname{ln}⁡(K|x|).\\end{aligned}\n$$" :tutorial/id #uuid "87815696-d64e-5c3f-a6e5-025001fb6e95" :tutorial/math-academy-id 709 :tutorial/title "Simplifying the Arbitrary Constant Using the Laws of Logarithms"} :step/id #uuid "e0bd70f8-6fa2-592c-b920-0cc8760e4406" :step/math-academy-id 1366 :step/next {:db/id #edb/ref 17592186106596}} {:db/id #edb/ref 17592186106596 :step/content {:db/id #edb/ref 17592186105720 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105575 :question/id #uuid "bf47e35e-da86-5f88-b1e7-0cc731c37b31" :question/math-academy-id "e-376"} :knowledge-point/id #uuid "df7dddc6-a4fd-5b1b-9b73-8528e5224ca9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049195}] :knowledge-point/question-generator {:db/id #edb/ref 17592186485703} :knowledge-point/questions [{:db/id #edb/ref 17592186106053} {:db/id #edb/ref 17592186106365} {:db/id #edb/ref 17592186238002} {:db/id #edb/ref 17592186238030} {:db/id #edb/ref 17592186238031} {:db/id #edb/ref 17592186275371} {:db/id #edb/ref 17592186297249} {:db/id #edb/ref 17592186332658} {:db/id #edb/ref 17592186485654} {:db/id #edb/ref 17592186485661} {:db/id #edb/ref 17592186485678} {:db/id #edb/ref 17592186485683} {:db/id #edb/ref 17592186485688} {:db/id #edb/ref 17592186485694} {:db/id #edb/ref 17592186485699} {:db/id #edb/ref 17592186573909} {:db/id #edb/ref 17592186573922}] :knowledge-point/title "Integrating a Reciprocal Function and Simplifying the Arbitrary Constant Using the Laws of Logarithms"} :step/id #uuid "5557c98c-0f30-5cf0-a00d-9cb8dd85111a" :step/math-academy-id 1367}] :activity/title "Integrating the Reciprocal Function" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186105994}]}
