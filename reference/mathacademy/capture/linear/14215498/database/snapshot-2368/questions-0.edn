f9ed577c7240f2f025729f9ab8e6354d1a19e8917671de7f5095.png)\n\n- Then, translate it up by $5$ units to get the graph of $y=3f(x)+5.$\n\n![](images/d5/d51fd0e1cc6b05182cca61b97a46970ab456dd9ba2ddebb0ba9c6d197f698a13.png)"}] [{:db/id #edb/ref 17592186526052 :knowledge-point/_questions [{:db/id #edb/ref 17592186100946 :knowledge-point/id #uuid "23014f0a-c381-5997-9f41-2734d3102280" :knowledge-point/title "Graph Transformations Containing Horizontal Translations and Stretches Only"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10ba17d2-20f2-532f-b2b8-01ad170b8ab3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f7/f7a231424813a4f7354349a9dcdb37f5f19d2d92514913450df9b49bd6fdad4d.png" :db/id #edb/ref 17592186525243} {:answer/id #uuid "606cf5af-4cac-5999-8c27-56e8457d1ffb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/27/27361a5a07750036a53052685245b07221b3b2d09e96bddb7a3259812364e710.png" :db/id #edb/ref 17592186525451} {:answer/id #uuid "c85a34f4-e759-5b15-b999-81a1c967aa5d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6b/6b0ebe20fba6691d8fc748e02dfbb2364f4314541d40be07214f1e2679e7617e.png" :db/id #edb/ref 17592186525710} {:answer/id #uuid "e3865444-5e48-5eff-b610-a04ed7daa0a6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ed/edaeb379b1807e8db385f3cdde1b92dd57b0596ca8d3bfed35b73f6d64a70bbf.png" :db/id #edb/ref 17592186525768} {:answer/id #uuid "fc35bcd5-4d13-514f-88ab-240d8dae3db7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3f/3f35b3d8c9325746a5c0832f416592a05ec705a8e5b174459d840132801f60c4.png" :db/id #edb/ref 17592186525831}] :answer-field/correct {:answer/id #uuid "e3865444-5e48-5eff-b610-a04ed7daa0a6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ed/edaeb379b1807e8db385f3cdde1b92dd57b0596ca8d3bfed35b73f6d64a70bbf.png" :db/id #edb/ref 17592186525768} :answer-field/id #uuid "4caabcd8-d675-5a22-887c-29b39f35e2d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525883}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8caa20be-200b-5ed3-94a3-d69e22805151" :question/math-academy-id "q-112621" :question/problem "![](images/b2/b2c3640581329789441015f744b3dd4fc06f5178a9044a844eefc1b8616f4ea4.png)\n\nThe diagram above shows the function $y=f(x).$ Which of the following gives the graph of $y=f(\\frac{1}{4}(x-3))?$" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches, followed by vertical translations.\n\nTo plot $y=f(\\frac{1}{4}(x-3)),$ we apply the following steps:\n\n- Take the curve $y=f(x).$\n\n- Stretch it by a scale factor of $\\frac{1}{(\\frac{1}{4})}=4$ parallel to the $x$-axis to get the graph of $y=f(\\frac{1}{4}x).$\n\n![](images/8a/8a427e6cf526ce00e227e5ffeae3a21bab23fe17d1f427c8419fe3c894a761b5.png)\n\n- Then, translate it right by $3$ units to get the graph of $y=f(\\frac{1}{4}(x-3)).$\n\n![](images/cd/cdaaa955e3848d06106737098260b218752aa2a82a7aa060435ff311ced57f34.png)"}] [{:db/id #edb/ref 17592186526095 :knowledge-point/_questions [{:db/id #edb/ref 17592186100947 :knowledge-point/id #uuid "8fb2265f-df80-53ac-bcab-90c7925a4e86" :knowledge-point/title "Graphing Transformations Containing Horizontal and Vertical Stretches Only"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b4ee965-ee13-58f6-a827-26081ab3b82e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e2/e214d2a7fae6d81697afbe77e1ef78ccb2628a0efcb0f2c50ab2c2c938c99cd9.png" :db/id #edb/ref 17592186525262} {:answer/id #uuid "c89e87c6-1fd3-5021-9e41-8b3861b06f3f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f9/f95830a2313c9721350369159975e18712a27df0f643f62d14fe26afc656f449.png" :db/id #edb/ref 17592186525711} {:answer/id #uuid "d406281f-a6e7-5ef5-9d56-6752ee28ba66" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/89/89f4c1aabab7e8e230f385c4b9d46de313b505fb12b4275f41c9acd4f7707e34.png" :db/id #edb/ref 17592186525734} {:answer/id #uuid "ec1472df-90c6-579b-b140-8fa053705204" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/59/59324e04752a0d293dbe038091e20a403c1f38ae64c03c92a1bb0f3027d1e001.png" :db/id #edb/ref 17592186525790} {:answer/id #uuid "f5786109-55a3-5413-9362-02ea61c05b28" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/76/7673ca70692f9bcd284d87c79df9b73c46e8aa5193944b265baed9698ce5791a.png" :db/id #edb/ref 17592186525817}] :answer-field/correct {:answer/id #uuid "ec1472df-90c6-579b-b140-8fa053705204" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/59/59324e04752a0d293dbe038091e20a403c1f38ae64c03c92a1bb0f3027d1e001.png" :db/id #edb/ref 17592186525790} :answer-field/id #uuid "28d1b654-1008-55cd-96c3-4a298a2d0bfa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525867}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "edd10633-a738-5506-bf9d-c3c2ab3f0a13" :question/math-academy-id "q-112763" :question/problem "![](images/69/699dc5f983ed428e6fa6adcb3c6f32a28e24e7022784a88b425835614760c34e.png)\n\nThe diagram above shows the function $y=f(x).$ Which of the following gives the graph of $y=\\frac{1}{4}f(2x)?$" :question/worked-solution "To perform transformations of functions with multiple operations, we must remember the following rule:\n\n1\\. First, we perform the transformations *inside* the argument of $f.$ We first carry out horizontal stretches, followed by horizontal translations.\n\n2\\. Then, we perform the transformations *outside* the argument of $f.$ We first carry out vertical stretches, followed by vertical translations.\n\nTo plot $y=\\frac{1}{4}f(2x),$ we apply the following steps:\n\n- Take the curve $y=f(x).$\n\n- Stretch it by a scale factor of $\\frac{1}{2}$ parallel to the $x$-axis to get the graph of $y=f(2x).$\n\n![](images/01/01de458656dbcc6b29236cf4db76c2dd1a1ee8f503c269759b25e13f7756def0.png)\n\n- Then, stretch it by a scale factor of $\\frac{1}{4}$ parallel to the $y$-axis to get the graph of $y=\\frac{1}{4}f(2x).$\n\n![](images/e4/e496df922bcae419f75857f7774212299ea5045c524c9b5dd906022fe5a5e5eb.png)"}] [{:db/id #edb/ref 17592186526053 :knowledge-point/_questions [{:db/id #edb/ref 17592186100947 :knowledge-point/id #uuid "8fb2265f-df80-53ac-bcab-90c7925a4e86" :knowledge-point/title "Graphing Transformations Containing Horizontal and Vertical Stretches Only"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "321c2ea4-7949-5b2d-816a-9a013600d200" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7c/7c73f15420ef3662e6cbc1bed3c05d53018bd3dee0a8166f6cd5b3a4443bf32d.png" :db/id #edb/ref 17592186525329} {:answer/id #uuid "6012fa34-51a1-5518-91e6-ab2ec5e02a75" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c6/c672357fafa309039d26ea629a9405fd0c9613fef12f9f6d55774a95e2e74e3d.png" :db/id #edb/ref 17592186525449} {:answer/id #uuid "bd141e51-c7f8-519a-831c-8b737e59ad2d" :answer/type {