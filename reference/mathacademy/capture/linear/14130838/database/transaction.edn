ield/choices ["answer-203deca7-0b1e-5c24-a2e3-760b82ca5d08" "answer-ef240870-c1b9-566a-aad3-55daca184236" "answer-ffb22a66-dd99-5a58-852d-1423c3d01f8d" "answer-7709236d-fa5c-557c-9475-3e2783e7aee5" "answer-b0eeeb58-8f49-59fd-b2c5-79d9024d8c1f"] :db/ensure [:answer-field/validate]} {:db/id "answer-203deca7-0b1e-5c24-a2e3-760b82ca5d08" :answer/id #uuid "203deca7-0b1e-5c24-a2e3-760b82ca5d08" :answer/type :answer.type/math :answer/value "\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "answer-ef240870-c1b9-566a-aad3-55daca184236" :answer/id #uuid "ef240870-c1b9-566a-aad3-55daca184236" :answer/type :answer.type/math :answer/value "\\frac{4}{7}" :db/ensure [:answer/validate]} {:db/id "answer-ffb22a66-dd99-5a58-852d-1423c3d01f8d" :answer/id #uuid "ffb22a66-dd99-5a58-852d-1423c3d01f8d" :answer/type :answer.type/math :answer/value "\\frac{5}{7}" :db/ensure [:answer/validate]} {:db/id "answer-7709236d-fa5c-557c-9475-3e2783e7aee5" :answer/id #uuid "7709236d-fa5c-557c-9475-3e2783e7aee5" :answer/type :answer.type/math :answer/value "\\frac{6}{7}" :db/ensure [:answer/validate]} {:db/id "answer-b0eeeb58-8f49-59fd-b2c5-79d9024d8c1f" :answer/id #uuid "b0eeeb58-8f49-59fd-b2c5-79d9024d8c1f" :answer/type :answer.type/math :answer/value "\\frac{8}{9}" :db/ensure [:answer/validate]} {:db/id "question-a0c12612-4312-5182-90fc-74e72ef9cb63" :question/id #uuid "a0c12612-4312-5182-90fc-74e72ef9cb63" :question/math-academy-id "q-223949" :question/problem "The reciprocal of $1\\,\\frac{4}{7}$ is{{field-1}}." :question/worked-solution "First, we convert the given mixed number to an improper fraction:\n\n$$\n1\\,\\frac{4}{7}=\\frac{(1\\times 7)+4}{7}=\\frac{11}{7}\n$$\n\nTo find the reciprocal of a fraction, we switch the numerator and the denominator:\n\n$$\n\\frac{11}{7}\\,\\to \\,\\frac{7}{11}\n$$\n\nSo, the reciprocal of $1\\frac{4}{7}$ is $\\frac{7}{11}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-af773dd1-936c-5d15-9632-98b53d6e321a"] :db/ensure [:question/validate]} {:db/id "answer-field-af773dd1-936c-5d15-9632-98b53d6e321a" :answer-field/id #uuid "af773dd1-936c-5d15-9632-98b53d6e321a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2044211b-ab46-539c-ab72-2da4d9eced2c" :answer-field/choices ["answer-2044211b-ab46-539c-ab72-2da4d9eced2c"] :db/ensure [:answer-field/validate]} {:db/id "answer-2044211b-ab46-539c-ab72-2da4d9eced2c" :answer/id #uuid "2044211b-ab46-539c-ab72-2da4d9eced2c" :answer/type :answer.type/math :answer/value "\\frac{7}{11}" :db/ensure [:answer/validate]} {:db/id "question-b0c97c18-5089-5b56-8eda-7c5d4d9b07d7" :question/id #uuid "b0c97c18-5089-5b56-8eda-7c5d4d9b07d7" :question/math-academy-id "q-223951" :question/problem "The reciprocal of $1\\,\\frac{7}{8}$ is{{field-1}}." :question/worked-solution "First, we convert the given mixed number to an improper fraction:\n\n$$\n1\\,\\frac{7}{8}=\\frac{(1\\times 8)+7}{8}=\\frac{15}{8}\n$$\n\nTo find the reciprocal of a fraction, we switch the numerator and the denominator:\n\n$$\n\\frac{15}{8}\\,\\to \\,\\frac{8}{15}\n$$\n\nSo, the reciprocal of $1\\frac{7}{8}$ is $\\frac{8}{15}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a90fc882-dd6d-54e1-8775-52683ce0b442"] :db/ensure [:question/validate]} {:db/id "answer-field-a90fc882-dd6d-54e1-8775-52683ce0b442" :answer-field/id #uuid "a90fc882-dd6d-54e1-8775-52683ce0b442" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f17a16b1-c312-5f3e-afd7-5e7b557c3cee" :answer-field/choices ["answer-f17a16b1-c312-5f3e-afd7-5e7b557c3cee"] :db/ensure [:answer-field/validate]} {:db/id "answer-f17a16b1-c312-5f3e-afd7-5e7b557c3cee" :answer/id #uuid "f17a16b1-c312-5f3e-afd7-5e7b557c3cee" :answer/type :answer.type/math :answer/value "\\frac{8}{15}" :db/ensure [:answer/validate]} {:db/id 17592186144074 :tutorial/content "The **reciprocal** of a fraction is a bit like turning it upside down: we switch the numerator and denominator.\n\nTo find the reciprocal of a $\\dfrac{1}{20},$ we switch the numerator and the denominator as follows:\n\n$$\n\\dfrac{\\color{blue}1}{\\color{red}20} \\quad\\rightarrow\\quad \\dfrac{\\color{red}20}{\\color{blue}1}\n$$\n\nNow we simplify:\n\n$$\n\\dfrac{20} 1 = 20\n$$\n\nSo the reciprocal of $\\dfrac{1}{20}$ is $20.$" :db/ensure [:tutorial/validate]} {:db/id 17592186144075 :tutorial/content "To find the reciprocal of a whole number, we must first write the number as a fraction.\n\nFor instance, let's write the number $2$ as a fraction:\n\n$$\n2= \\dfrac{2} 1\n$$\n\nTo find the reciprocal of a fraction, we switch the numerator and the denominator:\n\n$$\n\\dfrac{\\color{blue}2}{\\color{red}1} \\quad\\rightarrow\\quad \\dfrac{\\color{red}1}{\\color{blue}2}\n$$\n\nSo the reciprocal of $2$ is $\\dfrac{1}{2}.$" :db/ensure [:tutorial/validate]} {:db/id 17592186144076 :tutorial/content "To find the reciprocal of a mixed number, we must first convert it to an improper fraction.\n\nLet's find the reciprocal of $1\\,\\dfrac{2}{3}.$ First, we convert the given mixed number to an improper fraction:\n\n$$\n1\\,\\dfrac{2}{3} = \\dfrac{(1\\times 3)+2}{3}=\\dfrac{5}{3}\n$$\n\nTo find the reciprocal of a fraction, we switch the numerator and the denominator:\n\n$$\n\\dfrac{\\color{blue}5}{\\color{red}3} \\quad\\rightarrow\\quad \\dfrac{\\color{red}3}{\\color{blue}5}\n$$\n\nSo the reciprocal of $1\\,\\dfrac{2}{3}$ is $\\dfrac{3}{5}.$" :db/ensure [:tutorial/validate]} {:db/id 17592186143018 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
