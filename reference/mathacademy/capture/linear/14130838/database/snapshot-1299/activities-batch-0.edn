#{[{:activity/first-step {:db/id #edb/ref 17592186143728} :activity/id #uuid "91dfe0ab-ab42-5501-85e0-b0f434330678" :activity/scope {:db/id #edb/ref 17592186049356 :topic/id #uuid "ee4b1f44-89b8-542f-9f2c-2243b6b05c5b" :topic/math-academy-id 2388} :activity/steps [{:db/id #edb/ref 17592186143728 :step/content {:db/id #edb/ref 17592186144074 :tutorial/content "The **reciprocal** of a fraction is a bit like turning it upside down: we switch the numerator and denominator.\n\nTo find the reciprocal of a\n\n$$\n\\dfrac{1}{20}\n$$\n\nwe switch the numerator and the denominator as follows:\n\n$$\n\\dfrac{\\color{blue}1}{\\color{red}20} \\quad\\rightarrow\\quad \\dfrac{\\color{red}20}{\\color{blue}1}\n$$\n\nNow we simplify:\n\n$$\n\\dfrac{20} 1 = 20\n$$\n\nSo the reciprocal of\n\n$$\n\\dfrac{1}{20}\n$$\n\nis $20$." :tutorial/id #uuid "db280674-4a34-5dbd-99a3-c1c2c0ecf8be" :tutorial/math-academy-id 8576 :tutorial/title "Introduction"} :step/id #uuid "b9634965-7a0f-50bf-bc7a-b2626cc77c74" :step/math-academy-id 174394 :step/next {:db/id #edb/ref 17592186143729}} {:db/id #edb/ref 17592186143729 :step/content {:db/id #edb/ref 17592186142837 :knowledge-point/canonical-example {:db/id #edb/ref 17592186142599 :question/id #uuid "0028c4d7-e672-5dd7-b951-3966be4266a1" :question/math-academy-id "e-13731"} :knowledge-point/id #uuid "257a88af-0849-5cf9-b74a-2b2694ee7e6c" :knowledge-point/questions [{:db/id #edb/ref 17592186143250} {:db/id #edb/ref 17592186143300}] :knowledge-point/title "Finding the Reciprocal of a Fraction"} :step/id #uuid "86003208-694a-59f7-a78d-1d9cef22ac2b" :step/math-academy-id 174395 :step/next {:db/id #edb/ref 17592186143730}} {:db/id #edb/ref 17592186143730 :step/content {:db/id #edb/ref 17592186142838 :knowledge-point/canonical-example {:db/id #edb/ref 17592186142600 :question/id #uuid "bf0771a2-9eaa-5ad9-911e-18f529edcd35" :question/math-academy-id "e-13734"} :knowledge-point/id #uuid "e3ab73e9-c0fe-596c-90c6-9fede336df7a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050249}] :knowledge-point/questions [{:db/id #edb/ref 17592186143251} {:db/id #edb/ref 17592186143319}] :knowledge-point/title "Expressing the Reciprocal of a Fraction as a Mixed Number"} :step/id #uuid "00476cba-2f5d-5364-9604-f4ca1d6c706b" :step/math-academy-id 174398 :step/next {:db/id #edb/ref 17592186143731}} {:db/id #edb/ref 17592186143731 :step/content {:db/id #edb/ref 17592186144075 :tutorial/content "To find the reciprocal of a whole number, we must first write the number as a fraction.\n\nFor instance, let's write the number $2$ as a fraction:\n\n$$\n2= \\dfrac{2} 1\n$$\n\nTo find the reciprocal of a fraction, we switch the numerator and the denominator:\n\n$$\n\\dfrac{\\color{blue}2}{\\color{red}1} \\quad\\rightarrow\\quad \\dfrac{\\color{red}1}{\\color{blue}2}\n$$\n\nSo the reciprocal of $2$ is\n\n$$\n\\dfrac{1}{2}\n$$" :tutorial/id #uuid "439c60e5-dcf3-50b0-bc8f-a2d2ce74cdcc" :tutorial/math-academy-id 8577 :tutorial/title "The Reciprocal of a Whole Number"} :step/id #uuid "826383f3-7e5a-57f1-a9a9-8d7e2104cdbf" :step/math-academy-id 174401 :step/next {:db/id #edb/ref 17592186143732}} {:db/id #edb/ref 17592186143732 :step/content {:db/id #edb/ref 17592186142839 :knowledge-point/canonical-example {:db/id #edb/ref 17592186142601 :question/id #uuid "769b40a0-d0c9-58c1-b317-a80cb4b6a4bb" :question/math-academy-id "e-13736"} :knowledge-point/id #uuid "f4ec98e7-8bf6-53da-89fc-a816c495ee31" :knowledge-point/questions [{:db/id #edb/ref 17592186143252} {:db/id #edb/ref 17592186143315}] :knowledge-point/title "Finding the Reciprocal of a Whole Number"} :step/id #uuid "9043ac43-54a0-55ac-af0b-b8209415b37e" :step/math-academy-id 174402 :step/next {:db/id #edb/ref 17592186143733}} {:db/id #edb/ref 17592186143733 :step/content {:db/id #edb/ref 17592186144076 :tutorial/content "To find the reciprocal of a mixed number, we must first convert it to an improper fraction.\n\nLet's find the reciprocal of\n\n$$\n1\\,\\dfrac{2}{3}\n$$\n\nFirst, we convert the given mixed number to an improper fraction:\n\n$$\n1\\,\\dfrac{2}{3} = \\dfrac{(1\\times 3)+2}{3}=\\dfrac{5}{3}\n$$\n\nTo find the reciprocal of a fraction, we switch the numerator and the denominator:\n\n$$\n\\dfrac{\\color{blue}5}{\\color{red}3} \\quad\\rightarrow\\quad \\dfrac{\\color{red}3}{\\color{blue}5}\n$$\n\nSo the reciprocal of\n\n$$\n1\\,\\dfrac{2}{3}\n$$\n\nis\n\n$$\n\\dfrac{3}{5}\n$$" :tutorial/id #uuid "ae66510a-0eed-5ee9-8a6e-20d52291d930" :tutorial/math-academy-id 8578 :tutorial/title "The Reciprocal of a Mixed Number"} :step/id #uuid "cc73d26f-4867-5213-9687-4bb629751e8f" :step/math-academy-id 174405 :step/next {:db/id #edb/ref 17592186143734}} {:db/id #edb/ref 17592186143734 :step/content {:db/id #edb/ref 17592186142840 :knowledge-point/canonical-example {:db/id #edb/ref 17592186142602 :question/id #uuid "9fc449fc-a8f9-5e70-b670-b28eab0ef4c8" :question/math-academy-id "e-13737"} :knowledge-point/id #uuid "db24977e-2538-5cd2-8c31-2e8f0e8ac134" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049316}] :knowledge-point/questions [{:db/id #edb/ref 17592186143174} {:db/id #edb/ref 17592186143323} {:db/id #edb/ref 17592186424825}] :knowledge-point/title "Finding the Reciprocal of a Mixed Number"} :step/id #uuid "a54e63c9-f396-57e3-973b-4cb92a8cc901" :step/math-academy-id 174406}] :activity/title "Reciprocals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186143018}]}
