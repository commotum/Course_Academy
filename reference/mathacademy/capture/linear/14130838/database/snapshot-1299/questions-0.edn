#{[{:db/id #edb/ref 17592186142599 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142837 :knowledge-point/id #uuid "257a88af-0849-5cf9-b74a-2b2694ee7e6c" :knowledge-point/title "Finding the Reciprocal of a Fraction"}] :question/id #uuid "0028c4d7-e672-5dd7-b951-3966be4266a1" :question/math-academy-id "e-13731" :question/problem "What is the reciprocal of $\\dfrac{2}{7}$?" :question/worked-solution "To find the reciprocal of a fraction, we switch the numerator and the denominator:\n\n$$\n\\dfrac{\\color{blue}2}{\\color{red}7} \\quad\\rightarrow\\quad \\dfrac{\\color{red}7}{\\color{blue}2}\n$$\n\nSo the reciprocal of\n\n$$\n\\dfrac{2}{7}\n$$\n\nis\n\n$$\n\\dfrac{7}{2}\n$$"}] [{:db/id #edb/ref 17592186142600 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142838 :knowledge-point/id #uuid "e3ab73e9-c0fe-596c-90c6-9fede336df7a" :knowledge-point/title "Expressing the Reciprocal of a Fraction as a Mixed Number"}] :question/id #uuid "bf0771a2-9eaa-5ad9-911e-18f529edcd35" :question/math-academy-id "e-13734" :question/problem "What is the reciprocal of $\\dfrac{3}{14}$ as a mixed number?" :question/worked-solution "To find the reciprocal of a fraction, we switch the numerator and the denominator:\n\n$$\n\\dfrac{\\color{blue}3}{\\color{red}14} \\quad\\rightarrow\\quad \\dfrac{\\color{red}14}{\\color{blue}3}\n$$\n\nNow, we convert the resulting fraction to a mixed number:\n\n$$\n14\\div 3 = 4\\,\\textrm{R}2=4\\,\\dfrac 2 3\n$$\n\nSo the reciprocal of\n\n$$\n\\dfrac{3}{14}\n$$\n\nis\n\n$$\n4\\,\\dfrac{2}{3}\n$$"}] [{:db/id #edb/ref 17592186142601 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142839 :knowledge-point/id #uuid "f4ec98e7-8bf6-53da-89fc-a816c495ee31" :knowledge-point/title "Finding the Reciprocal of a Whole Number"}] :question/id #uuid "769b40a0-d0c9-58c1-b317-a80cb4b6a4bb" :question/math-academy-id "e-13736" :question/problem "What is the reciprocal of $9$?" :question/worked-solution "First, we write $9$ as a fraction:\n\n$$\n9= \\dfrac{9} 1\n$$\n\nTo find the reciprocal of a fraction, we switch the numerator and the denominator:\n\n$$\n\\dfrac{\\color{blue}9}{\\color{red}1} \\quad\\rightarrow\\quad \\dfrac{\\color{red}1}{\\color{blue}9}\n$$\n\nSo the reciprocal of $9$ is\n\n$$\n\\dfrac{1}{9}\n$$"}] [{:db/id #edb/ref 17592186142602 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142840 :knowledge-point/id #uuid "db24977e-2538-5cd2-8c31-2e8f0e8ac134" :knowledge-point/title "Finding the Reciprocal of a Mixed Number"}] :question/id #uuid "9fc449fc-a8f9-5e70-b670-b28eab0ef4c8" :question/math-academy-id "e-13737" :question/problem "What is the reciprocal of $2\\,\\dfrac{2}{5}$?" :question/worked-solution "First, we convert the given mixed number to an improper fraction:\n\n$$\n2\\,\\dfrac{2}{5} = \\dfrac{(2\\times 5)+2}{5}=\\dfrac{12}{5}\n$$\n\nTo find the reciprocal of a fraction, we switch the numerator and the denominator:\n\n$$\n\\dfrac{\\color{blue}12}{\\color{red}5} \\quad\\rightarrow\\quad \\dfrac{\\color{red}5}{\\color{blue}12}\n$$\n\nSo the reciprocal of\n\n$$\n2\\,\\dfrac{2}{5}\n$$\n\nis\n\n$$\n\\dfrac{5}{12}\n$$"}] [{:db/id #edb/ref 17592186143250 :knowledge-point/_questions [{:db/id #edb/ref 17592186142837 :knowledge-point/id #uuid "257a88af-0849-5cf9-b74a-2b2694ee7e6c" :knowledge-point/title "Finding the Reciprocal of a Fraction"}] :question/answer-fields [{:answer-field/id #uuid "d3b0d5e8-6d0d-507e-aa1c-559bf349db1b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186140496}] :question/id #uuid "6e3a86a8-9f02-5bd8-8f80-d342c6bc4697" :question/math-academy-id "q-223906" :question/problem "The reciprocal of $\\frac{1}{2}$ is {{field-1}}."}]}
