#{[{:db/id #edb/ref 17592186142599 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142837 :knowledge-point/id #uuid "257a88af-0849-5cf9-b74a-2b2694ee7e6c" :knowledge-point/title "Finding the Reciprocal of a Fraction"}] :question/id #uuid "0028c4d7-e672-5dd7-b951-3966be4266a1" :question/math-academy-id "e-13731" :question/problem "What is the reciprocal of $\\dfrac{2}{7}?$" :question/worked-solution "To find the reciprocal of a fraction, we switch the numerator and the denominator:\n\n$$\n\\dfrac{\\color{blue}2}{\\color{red}7} \\quad\\rightarrow\\quad \\dfrac{\\color{red}7}{\\color{blue}2}\n$$\n\nSo the reciprocal of $\\dfrac{2}{7}$ is $\\dfrac{7}{2}.$"}] [{:db/id #edb/ref 17592186142600 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142838 :knowledge-point/id #uuid "e3ab73e9-c0fe-596c-90c6-9fede336df7a" :knowledge-point/title "Expressing the Reciprocal of a Fraction as a Mixed Number"}] :question/id #uuid "bf0771a2-9eaa-5ad9-911e-18f529edcd35" :question/math-academy-id "e-13734" :question/problem "What is the reciprocal of ![](images/b0/b0457fff6548c5817dcb35ec967fed23638232180f1405587228652d21559806.svg) as a mixed number?" :question/worked-solution "To find the reciprocal of a fraction, we switch the numerator and the denominator:\n\n![](images/27/27bc9bf280e04972403b82aeaf4939901daccc74b009ae48f1df417ae6a14149.svg)\n\nNow, we convert the resulting fraction to a mixed number:\n\n![](images/cf/cfe6d2f9cfe9fdaf03a7ec3004faf9832675a42af5616625db5e3d5c3f8db4f6.svg)\n\nSo the reciprocal of ![](images/b0/b0457fff6548c5817dcb35ec967fed23638232180f1405587228652d21559806.svg) is ![](images/a0/a018cd3b3775dab8371577bfad0e8dc9eefee756e7c234b2359e28b6ba766600.svg)"}] [{:db/id #edb/ref 17592186142601 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142839 :knowledge-point/id #uuid "f4ec98e7-8bf6-53da-89fc-a816c495ee31" :knowledge-point/title "Finding the Reciprocal of a Whole Number"}] :question/id #uuid "769b40a0-d0c9-58c1-b317-a80cb4b6a4bb" :question/math-academy-id "e-13736" :question/problem "What is the reciprocal of $9?$" :question/worked-solution "First, we write $9$ as a fraction:\n\n$$\n9= \\dfrac{9} 1\n$$\n\nTo find the reciprocal of a fraction, we switch the numerator and the denominator:\n\n$$\n\\dfrac{\\color{blue}9}{\\color{red}1} \\quad\\rightarrow\\quad \\dfrac{\\color{red}1}{\\color{blue}9}\n$$\n\nSo the reciprocal of $9$ is $\\dfrac{1}{9}.$"}] [{:db/id #edb/ref 17592186142602 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142840 :knowledge-point/id #uuid "db24977e-2538-5cd2-8c31-2e8f0e8ac134" :knowledge-point/title "Finding the Reciprocal of a Mixed Number"}] :question/id #uuid "9fc449fc-a8f9-5e70-b670-b28eab0ef4c8" :question/math-academy-id "e-13737" :question/problem "What is the reciprocal of $2\\,\\dfrac{2}{5}?$" :question/worked-solution "First, we convert the given mixed number to an improper fraction:\n\n$$\n2\\,\\dfrac{2}{5} = \\dfrac{(2\\times 5)+2}{5}=\\dfrac{12}{5}\n$$\n\nTo find the reciprocal of a fraction, we switch the numerator and the denominator:\n\n$$\n\\dfrac{\\color{blue}12}{\\color{red}5} \\quad\\rightarrow\\quad \\dfrac{\\color{red}5}{\\color{blue}12}\n$$\n\nSo the reciprocal of $2\\,\\dfrac{2}{5}$ is $\\dfrac{5}{12}.$"}] [{:db/id #edb/ref 17592186427733 :knowledge-point/_questions [{:db/id #edb/ref 17592186142837 :knowledge-point/id #uuid "257a88af-0849-5cf9-b74a-2b2694ee7e6c" :knowledge-point/title "Finding the Reciprocal of a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f02f053-a274-524e-b136-56ea3c280a17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186427664}] :answer-field/correct {:answer/id #uuid "4f02f053-a274-524e-b136-56ea3c280a17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186427664} :answer-field/id #uuid "3428757f-66f3-5322-b377-981183