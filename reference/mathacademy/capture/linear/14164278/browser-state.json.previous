          "input_html": "<div class=\"matheditor-wrapper-answer\" style=\"min-width: 40px; margin-left: 4px; margin-right: 2px;\">\n                                             \n                                        <div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"7\"><span mathquill-command-id=\"39\">0</span><span mathquill-command-id=\"41\">.</span><span mathquill-command-id=\"43\">4</span><span mathquill-command-id=\"45\">2</span></span></div></div>",
