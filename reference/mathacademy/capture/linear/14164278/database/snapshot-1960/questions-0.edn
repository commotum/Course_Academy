#{[{:db/id #edb/ref 17592186489236 :knowledge-point/_questions [{:db/id #edb/ref 17592186147415 :knowledge-point/id #uuid "40344731-b251-5ba9-8e05-775144455c95" :knowledge-point/title "Squaring a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47cde53f-47d7-5ae4-8572-e9ac9bf6754d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{25}" :db/id #edb/ref 17592186488613}] :answer-field/correct {:answer/id #uuid "47cde53f-47d7-5ae4-8572-e9ac9bf6754d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{25}" :db/id #edb/ref 17592186488613} :answer-field/id #uuid "40a52d3e-493d-5f72-b1e1-ef146d9e54e7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186489053}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "83497943-4dd9-5808-bc36-db659744aaad" :question/math-academy-id "q-166797" :question/problem "Expressed as a single fraction, the exact area of the plot of land is$\\,${{field-1}}\n${\\text{mi}}^{2}.$" :question/worked-solution "The exact area of land is ${(\\frac{4}{5})}^{2}\\,{\\text{mi}}^{2}.$\n\nWriting ${(\\frac{4}{5})}^{2}$ with multiplication signs, we get\n\n$$\n\\begin{aligned}{(\\frac{4}{5})}^{2} & ={{\\frac{4}{5}\\times \\frac{4}{5}}_{⏟}}_{2\\text{ times}} \\\\  & =\\frac{4\\times 4}{5\\times 5} \\\\  & =\\frac{16}{25}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{(\\frac{4}{5})}^{2}=\\frac{16}{25}.\n$$"}] [{:db/id #edb/ref 17592186489188 :knowledge-point/_questions [{:db/id #edb/ref 17592186054858 :knowledge-point/id #uuid "ef1ed47e-ac17-5e98-8f3c-ea15497f7ff7" :knowledge-point/title "Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d1c2dc7-edf8-570a-812f-d15c687b21fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.84" :db/id #edb/ref 17592186488751}] :answer-field/correct {:answer/id #uuid "8d1c2dc7-edf8-570a-812f-d15c687b21fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.84" :db/id #edb/ref 17592186488751} :answer-field/id #uuid "a95f5153-0f06-5465-8815-86cb9c85319c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186489108}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "215d1b37-57d3-50ad-9730-b954c879d087" :question/math-academy-id "q-166798" :question/problem "Building company policy states that each ton of cement mixture should contain at least $0.7$ tons of sand. What's the minimum amount of sand in $1.2$ tons of cement mixture? Express your answer as a decimal.\n\nThere will be a minimum of\n{{field-1}}\ntons of sand in $1.2$ tons of cement mixture." :question/worked-solution "To determine how much sand is in $1.2$ tons of the cement mixture, we have to multiply $1.2$ by $0.7.$\n\nWe proceed by multiplying the two numbers just as we would with whole numbers.\n\nNotice that the second number has a leading $0$, which we ignore during the multiplication:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  & \\,\\,\\,\\,\\,\\begin{aligned} \\\\ 1\\end{aligned}\\,\\,\\,\\, &  \\\\  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,.2\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,.7\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $1$ decimal place in $1.2$ and there is $1$ decimal place in $0.7.$\nTherefore, their product will have $1+1=2$ decimal places.\n\nSo, we take our value of $84$ and add a decimal point to make a number with $2$ decimal places.\n\n$$\n\\,\\overset{↓}{.}\\,\\,\\,{{84}_{⏟}}_{2\\text{ digits}}\n$$\n\nHence, $1.2\\times 0.7=0.84.$\n\nWe conclude that there are $0.84$ tons of sand in $1.2$ tons of the cement mixture."}] [{:db/id #edb/ref 17592186489228 :knowledge-point/_questions [{:db/id #edb/ref 17592186138368 :knowledge-point/id #uuid "28d5aa07-8c26-5964-bb34-a500d8e0a9e9" :knowledge-point/title "Adding Numbers With One and Two Decimal Places"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b46221bb-c9ba-5b3b-af2a-aefe7602f145" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.29" :db/id #edb/ref 17592186488831}] :answer-field/correct {:answer/id #uuid "b46221bb-c9ba-5b3b-af2a-aefe7602f145" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.29" :db/id #edb/ref 17592186488831} :answer-field/id #uuid "02e8ab80-f28a-5a91-a4ee-5bbed7cc0309" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186489017}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6535052d-d80b-57f3-9a80-25b64c4c2047" :question/math-academy-id "q-166799" :question/problem "The building company combines $1.6$ tons of sand with $0.69$ tons of cement to make their cement mixture. What is the total weight of the mixture? Express your answer as a decimal.\n\nThe total weight of the mixture is\n{{field-1}}\ntons." :question/worked-solution "To find the total weight of the mixture, we need to calculate the sum $1.6+0.69.$\n\nThere is $1$ decimal place in $1.6$ and $2$ decimal places in $0.69.$\n\nTo add the numbers, they both need to have the same number of decimals. Hence, we rewrite the first number so that it has $2$ decimal places:\n\n$$\n1.6=1.60\n$$\n\nNext, we line up the decimal points:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, \\\\  &  &  & \\,\\,\\,\\,.\\,\\,\\,\\, &  & \\end{aligned}\n$$\n\nFinally, we proceed by adding the two numbers just as we would with whole numbers:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\,\\begin{aligned} \\\\ 1\\end{aligned}\\,\\,\\,\\, &  &  \\\\  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\,\\end{aligned}\n$$\n\nTherefore, the total weight of the mixture is $2.29$ tons."}] [{:db/id #edb/ref 17592186489287 :knowledge-point/_questions [{:db/id #edb/ref 17592186054862 :knowledge-point/id #uuid "f5d09700-00bd-5c67-93cf-f99c574732d7" :knowledge-point/title "Subtracting Decimals: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bcf24fbb-54b2-594a-834d-965cf812e613" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.42" :db/id #edb/ref 17592186488854}] :answer-field/correct {:answer/id #uuid "bcf24fbb-54b2-594a-834d-965cf812e613" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.42" :db/id #edb/ref 17592186488854} :answer-field/id #uuid "f34c47c7-21ad-5287-bc9c-731eacee1cb5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186489158}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ee99225f-5b1d-5184-84fe-979d439fc52f" :question/math-academy-id "q-166800" :question/problem "Of the cement mixture prepared, $1.87$ tons were used to construct the houses. How much cement mixture is left over?\n\nThere are\n{{field-1}}\ntons of cement mixture are left over." :question/worked-solution "In part 3, we found that the company prepared $2.29$ tons of cement mixture.\n\nTo determine the amount of cement mixture remaining, we need to calculate $2.29-1.87.$\n\nFirst, we line up the decimal points:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, \\\\ \\,\\,\\,\\,-\\,\\,\\,\\, &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, & \\,\\,\\,\\,7\\,\\,\\,\\, \\\\  &  &  & \\,\\,\\,\\,.\\,\\,\\,\\, &  & \\end{aligned}\n$$\n\nNext, we proceed by subtracting the two numbers just as we would with whole numbers:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\,\\,\\begin{aligned} \\\\ 1\\end{aligned}\\,\\,\\,\\, &  & \\,\\,\\,\\,\\,\\begin{aligned} \\\\ 12\\end{aligned}\\,\\,\\,\\, &  \\\\  &  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, \\\\ \\,\\,\\,\\,-\\,\\,\\,\\, &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, & \\,\\,\\,\\,7\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\,\\end{aligned}\n$$\n\nTherefore, $0.42$ tons of cement mixture are left over."}] [{:db/id #edb/ref 17592186489285 :knowledge-point/_questions [{:db/id #edb/ref 17592186073705 :knowledge-point/id #uuid "cb42b265-bcf6-58ef-aa08-489dec5d1104" :knowledge-point/title "Converting the Result to a Mixed Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dda3fa24-a3e1-52ae-b9a9-bebd3842e781" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,\\frac{3}{8}" :db/id #edb/ref 17592186488932}] :answer-field/correct {:answer/id #uuid "dda3fa24-a3e1-52ae-b9a9-bebd3842e781" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,\\frac{3}{8}" :db/id #edb/ref 17592186488932} :answer-field/id #uuid "89b6a21c-a813-55f9-b362-1ae1f8cff07b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186489090}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ecc24b66-1c17-5f12-9e7e-a64bd2e2d9c8" :question/math-academy-id "q-166801" :question/problem "One of the workers cuts $3\\,\\frac{3}{4}\\,\\text{ft}$ from a pipe measuring $5\\,\\frac{1}{8}\\,\\text{ft}.$ What is the length of the remaining pipe? Express your answer as a mixed number.\n\nThe length of the remaining pipe is$\\,$\n{{field-1}}\n$\\text{ft}.$" :question/worked-solution "The length of the remaining pipe is $(5\\,\\frac{1}{8}-3\\,\\frac{3}{4})\\text{ft}.$\n\nWriting $5\\,\\frac{1}{8}$ as an improper fraction, we have\n\n$$\n5\\,\\frac{1}{8}=\\frac{5\\times 8+1}{8}=\\frac{41}{8}.\n$$\n\nWriting $3\\,\\frac{3}{4}$ as an improper fraction, we have\n\n$$\n3\\,\\frac{3}{4}=\\frac{3\\times 4+3}{4}=\\frac{15}{4}.\n$$\n\nTherefore, our problem now is to work out the following:\n\n$$\n\\frac{41}{8}-\\frac{15}{4}\n$$\n\nTo subtract two fractions with unlike denominators, we need to express each fraction as an equivalent fraction with a common denominator.\n\nIn this question, we can make a common denominator of $8.$\n\nTo put $\\frac{15}{4}$ over a denominator of $8,$ we multiply the numerator and denominator by $2:$\n\n$$\n\\frac{15}{4}=\\frac{15\\times 2}{4\\times 2}=\\frac{30}{8}\n$$\n\nWe can now subtract the fractions. We keep the denominator the same, and we subtract the numerators:\n\n$$\n\\frac{41}{8}-\\frac{30}{8}=\\frac{11}{8}\n$$\n\nFinally, we convert back to a mixed number:\n\n$$\n\\frac{11}{8}=1\\,\\text{R}\\,3=1\\,\\frac{3}{8}\n$$\n\nTherefore, $1\\,\\frac{3}{8}\\,\\text{ft}$ of pipe remains."}] [{:db/id #edb/ref 17592186489186 :knowledge-point/_questions [{:db/id #edb/ref 17592186073676 :knowledge-point/id #uuid "e27e3a75-779a-5817-a2ae-27b58cbac913" :knowledge-point/title "Rounding to the Nearest Whole Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "988f552d-7fef-5802-8752-162edc8a6d1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186488776}] :answer-field/correct {:answer/id #uuid "988f552d-7fef-5802-8752-162edc8a6d1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186488776} :answer-field/id #uuid "07b47d55-bb99-56d8-b25e-ea951aea2d16" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186489022}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1e21dfbe-7205-50ca-b839-4d1dcb287bbd" :question/math-academy-id "q-166802" :question/problem "The company used $104.7\\,\\text{ft}$ of piping to construct $5$ identical houses. Estimate the length of piping used for each home by rounding the total piping length to the nearest whole number.\n\n{{field-1}}\n$\\text{ft}.$" :question/worked-solution "To estimate the length of piping used for each of the $5$ houses, we need to find an approximation for $104.7÷5.$\n\nSo, we round the dividend to the nearest whole number:\n\n$$\n104.7\\to 105\n$$\n\nNow, we divide $105$ by $5$ as usual:\n\n$$\n105÷5=21\n$$\n\nTherefore, the construction of each house used approximately $21\\,\\text{ft}$ of pipes."}]}
