#{[{:activity/first-step {:db/id #edb/ref 17592186153244} :activity/id #uuid "d2475369-4769-5aee-96aa-06851898810e" :activity/scope {:db/id #edb/ref 17592186048139 :topic/id #uuid "82869b1d-f321-5919-b531-5dbc3fc95c4d" :topic/math-academy-id 2679} :activity/steps [{:db/id #edb/ref 17592186153244 :step/content {:db/id #edb/ref 17592186153358 :tutorial/content "A function $f: X \\to Y$ is a **bijection** if it is both a surjection and an injection. Recall the following:\n\n- $f$ is a surjection if $\\forall\\, y \\in Y,$ $\\exists\\, x \\in X$ such that $f(x)=y.$\n- $f$ is an injection if $\\forall\\, x_1,x_2 \\in X,$ whenever $f(x_1)=f(x_2),$ we have $x_1=x_2.$\n\nFor example, this is an example of a bijection.\n\n![](images/06/06082039b7be1d9eda1c66bbec7a6c3b8a6ad9eca4686365c1538174d8ec2459.png)\n\nIntuitively, a function is a bijection if\n\n- the outputs of the function cover the entire range, and\n- every output comes from a unique input (no two inputs map to the same output).\n\n**Note:** A bijection is sometimes called a **one-to-one correspondence** because every element of the domain corresponds to exactly one element of the range, and vice versa." :tutorial/id #uuid "69907a1e-41e6-5fdb-b8c4-325f081b7406" :tutorial/math-academy-id 4005 :tutorial/title "Introduction"} :step/id #uuid "0f6fd9a2-1f64-58bd-b66a-d986fa422396" :step/math-academy-id 473752 :step/next {:db/id #edb/ref 17592186153245}} {:db/id #edb/ref 17592186153245 :step/content {:db/id #edb/ref 17592186152262 :knowledge-point/canonical-example {:db/id #edb/ref 17592186152011 :question/id #uuid "f9eae0d2-ccf0-57f6-82d3-c8d5d0aaf3d9" :question/math-academy-id "e-7238"} :knowledge-point/id #uuid "22bcdfb2-485a-5242-a5b5-dd9ef8cee027" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050525}] :knowledge-point/questions [{:db/id #edb/ref 17592186152841} {:db/id #edb/ref 17592186152842} {:db/id #edb/ref 17592186382771} {:db/id #edb/ref 17592186385768} {:db/id #edb/ref 17592186385775} {:db/id #e