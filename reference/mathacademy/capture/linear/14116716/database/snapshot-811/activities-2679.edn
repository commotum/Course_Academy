#{[{:activity/first-step {:db/id #edb/ref 17592186153244} :activity/id #uuid "d2475369-4769-5aee-96aa-06851898810e" :activity/scope {:db/id #edb/ref 17592186048139 :topic/id #uuid "82869b1d-f321-5919-b531-5dbc3fc95c4d" :topic/math-academy-id 2679} :activity/steps [{:db/id #edb/ref 17592186153244 :step/content {:db/id #edb/ref 17592186153358 :tutorial/content "A function $f: X \\to Y$ is a **bijection** if it is both a surjection and an injection. Recall the following:\n\n- $f$ is a surjection if $\\forall\\, y \\in Y,$ $\\exists\\, x \\in X$ such that $f(x)=y.$\n- $f$ is an injection if $\\forall\\, x_1,x_2 \\in X,$ whenever $f(x_1)=f(x_2),$ we have $x_1=x_2.$\n\nFor example, this is an example of a bijection.\n\n![](images/06/06082039b7be1d9eda1c66bbec7a6c3b8a6ad9eca4686365c1538174d8ec2459.png)\n\nIntuitively, a function is a bijection if\n\n- the outputs of the function cover the entire range, and\n- every output comes from a unique input (no two inputs map to the same output).\n\n**Note:** A bijection is sometimes called a **one-to-one correspondence** because every element of the domain corresponds to exactly one element of the range, and vice versa." :tutorial/id #uuid "69907a1e-41e6-5fdb-b8c4-325f081b7406" :tutorial/math-academy-id 4005 :tutorial/title "Introduction"} :step/id #uuid "0f6fd9a2-1f64-58bd-b66a-d986fa422396" :step/math-academy-id 473752 :step/next {:db/id #edb/ref 17592186153245}} {:db/id #edb/ref 17592186153245 :step/content {:db/id #edb/ref 17592186152262 :knowledge-point/canonical-example {:db/id #edb/ref 17592186152011 :question/id #uuid "f9eae0d2-ccf0-57f6-82d3-c8d5d0aaf3d9" :question/math-academy-id "e-7238"} :knowledge-point/id #uuid "22bcdfb2-485a-5242-a5b5-dd9ef8cee027" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050525}] :knowledge-point/questions [{:db/id #edb/ref 17592186152841} {:db/id #edb/ref 17592186152842} {:db/id #edb/ref 17592186382771} {:db/id #edb/ref 17592186385768} {:db/id #edb/ref 17592186385775} {:db/id #edb/ref 17592186385782}] :knowledge-point/title "Identifying Bijections For Functions Defined as Mapping Diagrams"} :step/id #uuid "69e03cce-a5d8-567b-85ab-ee409f7f9800" :step/math-academy-id 473753 :step/next {:db/id #edb/ref 17592186153246}} {:db/id #edb/ref 17592186153246 :step/content {:db/id #edb/ref 17592186152263 :knowledge-point/canonical-example {:db/id #edb/ref 17592186152012 :question/id #uuid "d522b068-d448-52bd-8e53-6aa16b452a25" :question/math-academy-id "e-7239"} :knowledge-point/id #uuid "bfbebc20-1b48-5718-a057-b743c8af8de1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049620} {:db/id #edb/ref 17592186050718}] :knowledge-point/questions [{:db/id #edb/ref 17592186152731} {:db/id #edb/ref 17592186152738} {:db/id #edb/ref 17592186382806} {:db/id #edb/ref 17592186382813} {:db/id #edb/ref 17592186385789} {:db/id #edb/ref 17592186385796} {:db/id #edb/ref 17592186410934}] :knowledge-point/title "Identifying Bijections For Functions Defined on the Set of Real Numbers"} :step/id #uuid "50060a60-568a-5b2f-aac3-bbae75b21dab" :step/math-academy-id 473756 :step/next {:db/id #edb/ref 17592186153247}} {:db/id #edb/ref 17592186153247 :step/content {:db/id #edb/ref 17592186152264 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151953 :question/id #uuid "77d930fe-9a75-59cb-a432-f13d203b093f" :question/math-academy-id "e-6467"} :knowledge-point/id #uuid "f12e21e5-0a96-5f87-9642-d63d23e0038a" :knowledge-point/questions [{:db/id #edb/ref 17592186152730} {:db/id #edb/ref 17592186152737} {:db/id #edb/ref 17592186382785} {:db/id #edb/ref 17592186382792} {:db/id #edb/ref 17592186382799} {:db/id #edb/ref 17592186385810} {:db/id #edb/ref 17592186410936} {:db/id #edb/ref 17592186410938}] :knowledge-point/title "Identifying Bijections For Functions Whose Domains or Codomains Are Real Intervals"} :step/id #uuid "3236adb8-87e2-59b8-ac14-8f815df3b21c" :step/math-academy-id 473759 :step/next {:db/id #edb/ref 17592186153248}} {:db/id #edb/ref 17592186153248 :step/content {:db/id #edb/ref 17592186152265 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151952 :question/id #uuid "c1e6833e-efac-5bd9-a6ff-e6ca401cdf9d" :question/math-academy-id "e-6466"} :knowledge-point/id #uuid "f237343d-2f8a-5a9f-9e5f-c9f22784547a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048789} {:db/id #edb/ref 17592186049313} {:db/id #edb/ref 17592186049474} {:db/id #edb/ref 17592186049528} {:db/id #edb/ref 17592186050294}] :knowledge-point/questions [{:db/id #edb/ref 17592186152735} {:db/id #edb/ref 17592186152736} {:db/id #edb/ref 17592186382778} {:db/id #edb/ref 17592186385631} {:db/id #edb/ref 17592186385659} {:db/id #edb/ref 17592186385803} {:db/id #edb/ref 17592186410935} {:db/id #edb/ref 17592186410937}] :knowledge-point/title "Identifying Bijections For Functions Functions Defined Algebraically"} :step/id #uuid "ac23f4b0-d4d3-5758-a24d-e96a6d0b5f74" :step/math-academy-id 473762}] :activity/title "Bijections" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186152346}] [{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186410939} :activity/id #uuid "a9fba945-4d08-5ecb-aefa-aa4571dbef95" :activity/scope {:db/id #edb/ref 17592186048139 :topic/id #uuid "82869b1d-f321-5919-b531-5dbc3fc95c4d" :topic/math-academy-id 2679} :activity/steps [{:db/id #edb/ref 17592186410939 :step/content {:db/id #edb/ref 17592186410937 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "116fbc73-ece6-5432-9602-545bf9688e8d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186410905} {:answer/id #uuid "501141cf-63c7-5482-ba0e-93e9b432d4ef" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186410910} {:answer/id #uuid "50b734df-b148-59de-b8f1-eb65a75a5857" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186410911} {:answer/id #uuid "7c6c0231-7d58-5c35-a738-06ae728ba9d9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186410916} {:answer/id #uuid "90d0ac0d-0a31-5b69-a4a2-e449bd7dcdbe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186410918}] :answer-field/correct {:db/id #edb/ref 17592186410916} :answer-field/id #uuid "26c1f05c-d5ac-55f3-a9f9-404f5c918451" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410930}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f181e810-d779-5077-8c9b-e3a1b446edcd" :question/math-academy-id "q-77480" :question/problem "Which of the following functions are bijections?\n\n- $f:R\\to R$ defined by $f(x)=x+1$\n- $g:Q\\to R$ defined by $g(x)={x}^{2}$\n- $h:Z\\to Q$ defined by $h(x)={2}^{x}$" :question/worked-solution "Recall that a function $f:X\\to Y$ is a bijection if it is both a surjection and an injection.\n\n- I is a bijection. First of all, it is a surjection because $∀\\,y\\in R,$ we can choose an $x\\in R$ such that $f(x)=y:$\n\n$$\n\\begin{aligned}f(x) & =y \\\\ x+1 & =y \\\\ x & =y-1\\in R\\end{aligned}\n$$\n\nWe verify that, \n\n$$\nf(x)=f(y-1)=(y-1)+1=y.\n$$\n\nSecond, it is an injection: \n\n$$\n\\begin{aligned}f({x}_{1}) & =f({x}_{2}) \\\\ {x}_{1}+1 & ={x}_{2}+1 \\\\ {x}_{1} & ={x}_{2}\\end{aligned}\n$$\n\nSince $f$ is both surjective and injective, $f$ is bijective.    \n\n- II is *not* a bijection because it is not surjective. As a counterexample, choose $y=2.$ Then there is no rational number $x$  such that $g(x)=2.$ The only numbers $x$ that satisfies ${x}^{2}=2$ are $x=\\pm \\sqrt{2}\\notin Q.$\n\n- III is *not* a bijection because it is not surjective. As a counterexample, choose $y=0.$ Then there is no integer $x$  such that $g(x)=0,$  because ${2}^{x}>0$ for all $x\\in Z.$\n\nTherefore, the correct answer is \"I only.\""} :step/id #uuid "927269ee-7d40-5f59-9c03-e0f6ef8e36d9" :step/next {:db/id #edb/ref 17592186410940}} {:db/id #edb/ref 17592186410940 :step/content {:db/id #edb/ref 17592186410934 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "354b080a-5175-5b69-aaab-afad022436b6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186410906} {:answer/id #uuid "3f36077b-cb80-5a78-868e-4f2fe236258b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186410909} {:answer/id #uuid "51fd3ae1-bd1b-5102-a9f6-5328bb9d2e09" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186410912} {:answer/id #uuid "c8b77850-35fc-595a-9daf-36d48cabc0cc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186410920} {:answer/id #uuid "fd71c98e-d1d9-58de-93b1-25edf334d81e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186410928}] :answer-field/correct {:db/id #edb/ref 17592186410920} :answer-field/id #uuid "0baeb570-ecf2-5138-be41-cee0d13033db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410929}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "00868f73-2a29-5bc5-b5fa-287f2fcfd175" :question/math-academy-id "q-82304" :question/problem "![](images/ef/ef3933fc56e981bd0ef6e88754c46f5ab00b15230cce5fc2ea224ecf7c1f8f0e.png)\n\nFor the function $f:R\\to R$ defined by $f(x)=2\\sqrt[3]{x}$, which of the following statements are true? \n\n- The function is an injection\n- The function is a surjection\n- The function is a bijection" :question/worked-solution "Recall that a function $f:X\\to Y$ is \n\n- an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ whenever $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2},$\n\n- a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y,$\n\n- a bijection if it is both a surjection and an injection.\n\nWith this in mind, let's check each statement.\n\n- Statement I is true. Any horizontal line (like the one depicted below) crosses the graph of $f(x)$ at most once.\n\n![](images/f0/f020379f306770bd87fc499ac1fef238dc6aa639fb36d5229502fcd7dd455610.png)\n\n        \n\n- Statement II is true. According to the graph, the range of $f(x)$ will cover the entire interval $(-\\infty ,\\infty ).$\n\n- Statement III is true because the function is both surjective and injective.\n\nTherefore, the correct answer is \"I, II, and III.\""} :step/id #uuid "9d23d682-6e0e-599a-8860-2201e4721ddf" :step/next {:db/id #edb/ref 17592186410942}} {:db/id #edb/ref 17592186410941 :step/content {:db/id #edb/ref 17592186410935 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "391004d2-2992-548b-b9a0-c0f456c1dbc4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186410907} {:answer/id #uuid "65c05b37-a9ce-53de-b879-c52f6f237a4f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186410913} {:answer/id #uuid "686b0b91-7c8b-5f63-985c-fe75123e3d3c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186410914} {:answer/id #uuid "d654ebe3-708a-515e-8a05-9d26007e466f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186410923} {:answer/id #uuid "ecc1b33a-da6f-5fa1-aa63-322df0372030" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186410925}] :answer-field/correct {:db/id #edb/ref 17592186410925} :answer-field/id #uuid "b94f51c3-8089-500c-bb22-065f6d87882e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410933}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6f4dc780-0892-5640-8a66-1c76dbdf69ef" :question/math-academy-id "q-170667" :question/problem "Which of the following functions are bijections?\n\n- $f:R\\to R$ defined by $f(x)=\\operatorname{arctan}⁡x$\n- $g:R\\to R$ defined by $g(x)=2x$\n- $h:Z\\to Z$ defined by $h(x)=2x$" :question/worked-solution "Recall that a function $f:X\\to Y$ is a bijection if it is both a surjection and an injection.\n\n- I is *not* a bijection because it is not surjective. Remember that the range of $\\operatorname{arctan}⁡x$ is $(-\\frac{\\pi }{2},\\frac{\\pi }{2}).$ This means that \n\n$$\n-\\frac{\\pi }{2}<\\operatorname{arctan}⁡x<\\frac{\\pi }{2}.\n$$\n\nSo, for example, there is no value $x\\in R$ such that $f(x)=4.$\n\n- II is a bijection. First of all, it is a surjection because $∀\\,y\\in R,$ we can choose an $x\\in R$ such that $g(x)=y:$\n\n$$\n\\begin{aligned}g(x) & =y \\\\ 2x & =y \\\\ x & =\\frac{y}{2}\\in R\\end{aligned}\n$$\n\nWe verify that\n\n$$\ng(x)=g(\\frac{y}{2})=2(\\frac{y}{2})=y.\n$$\n\nSecond, it is an injection: \n\n$$\n\\begin{aligned}g({x}_{1}) & =g({x}_{2}) \\\\ 2{x}_{1} & =2{x}_{2} \\\\ {x}_{1} & ={x}_{2}\\end{aligned}\n$$\n\nSince $g$ is both surjective and injective, $g$ is bijective.\n\n- III is *not* a bijection because it is not surjective. Notice that if $x$ is an integer number, then $h(x)=2x$ is an even number. This means that the range of $h$ is the set of even numbers.\nSo, for example, there is no value $x\\in Z$ such that $h(x)=3.$\n\nTherefore, the correct answer is \"II only.\""} :step/id #uuid "bc92c211-2667-5ebc-af13-727628b6831e"} {:db/id #edb/ref 17592186410942 :step/content {:db/id #edb/ref 17592186410938 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73b4beec-ad53-5851-aa5b-d9750cfb2468" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186410915} {:answer/id #uuid "8a7110b9-d4b3-5bfe-980b-063cd291d0b8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II  only" :db/id #edb/ref 17592186410917} {:answer/id #uuid "9c6c406e-0241-5402-873a-5818751247d1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186410919} {:answer/id #uuid "cf16a0c7-eef9-5edb-86fc-8aac55883795" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186410921} {:answer/id #uuid "cfdbea3b-43fd-5adf-bc03-99c4bf796e3a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III  only" :db/id #edb/ref 17592186410922}] :answer-field/correct {:db/id #edb/ref 17592186410921} :answer-field/id #uuid "9801aa3c-15d6-5b0a-98a6-d929fbad53c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410931}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f636c031-3e1e-5fb8-bd29-acadcf4da72e" :question/math-academy-id "q-82572" :question/problem "![](images/ce/ce68b2f27b88bd43d6eebfa5380a22c00e15e4194e0ad45e6778f761667a3ceb.png)\n\nFor the function $f:(0,\\infty )\\to R$ defined by $f(x)=x-2$, which of the following statements are true? \n\n- The function is an injection\n- The function is a surjection\n- The function is a bijection" :question/worked-solution "Recall that a function $f:X\\to Y$ is \n\n- an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ whenever $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2},$\n\n- a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y,$\n\n- a bijection if it is both a surjection and an injection.\n\nWith this in mind, let's check each statement.\n\n- Statement I is true. Any horizontal line (like the one depicted below) crosses the graph of $f(x)$ at most once.\n\n![](images/2f/2ff4c0183b91aa23d780f665aa0f038b374583e9f24e245951c4c69ea5f2e5b8.png)\n\n           \n\n- Statement II is false. There is no value $x$ for which $f(x)=-2\\in R.$\n\n- Statement III is false because the function is not a surjection.\n\n Therefore, the correct answer is \"I only.\""} :step/id #uuid "c5a61231-7175-5b82-8303-e11f6a972f03" :step/next {:db/id #edb/ref 17592186410943}} {:db/id #edb/ref 17592186410943 :step/content {:db/id #edb/ref 17592186410936 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "079dade0-aaba-549e-b166-40f1cd38be43" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186410904} {:answer/id #uuid "39fe438c-8f49-5303-b841-ca5ec6a58a98" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186410908} {:answer/id #uuid "d70eaee1-5c51-5c83-9b19-ebfef966d252" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186410924} {:answer/id #uuid "f6346406-ca9d-5e81-813a-255b33f59b9c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186410926} {:answer/id #uuid "fb760290-4b01-5e7a-bcfc-f281f74d98d5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186410927}] :answer-field/correct {:db/id #edb/ref 17592186410927} :answer-field/id #uuid "af3928a6-40a7-5b56-812b-bbcc73b73c7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410932}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "80ecff06-aa66-5d3f-b38e-164bc959ec2c" :question/math-academy-id "q-105321" :question/problem "![](images/63/63032bf65ec10d55f9a0b968a7179db934ad6f17b869d50999e4a0f710be9977.png)\n\nFor the function $f:(-1,\\infty )\\to R$ defined by $f(x)=-\\operatorname{ln}⁡(x+1)$, which of the following statements are true? \n\n- The function is an injection\n- The function is a surjection\n- The function is a bijection" :question/worked-solution "Recall that a function $f:X\\to Y$ is \n\n- an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ whenever $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2},$\n\n- a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y,$\n\n- a bijection if it is both a surjection and an injection.\n\nWith this in mind, let's check each statement.\n\n- Statement I is true. Any horizontal line (like the one depicted below) crosses the graph of $f(x)$ at most once.\n\n![](images/71/71bd13b2dd618fb60cd2e7f6c2e3807f3449e233ccb9b60e1cbd14cc928345b3.png)\n\n- Statement II is true. According to the graph, the range of $f(x)$ is $(-\\infty ,\\infty ).$\n\n- Statement III is true because the function is both surjective and injective.\n\nTherefore, the correct answer is \"I, II, and III.\""} :step/id #uuid "f11e74be-79d2-56e2-80bf-03e81668b5f6" :step/next {:db/id #edb/ref 17592186410941}}] :activity/title "Bijections" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186410903}]}
