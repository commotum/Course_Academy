#{[{:db/id #edb/ref 17592186543540 :knowledge-point/_questions [{:db/id #edb/ref 17592186068732 :knowledge-point/id #uuid "7e0c15b8-dc6e-570d-9392-4c679395cc87" :knowledge-point/title "Solving an Exponential Equation by Changing the Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2edcc807-3636-52ce-bfc5-aaeaf9e3c605" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3" :db/id #edb/ref 17592186542763} {:answer/id #uuid "712df8a0-8d70-5d49-b320-e800a8bdd2ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{125}" :db/id #edb/ref 17592186542938} {:answer/id #uuid "79e2e42a-4919-5f80-adf9-a1f3434370e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-125" :db/id #edb/ref 17592186542963} {:answer/id #uuid "8dd35fa6-7512-5340-9b7a-de251ebbb42e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-5" :db/id #edb/ref 17592186543011} {:answer/id #uuid "b5d42485-2e6e-5647-b440-f854c28552be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=5" :db/id #edb/ref 17592186543112}] :answer-field/correct {:answer/id #uuid "2edcc807-3636-52ce-bfc5-aaeaf9e3c605" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3" :db/id #edb/ref 17592186542763} :answer-field/id #uuid "8819a29e-57d4-59e0-a6c9-1c8665d8df6a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543385}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a79b6cc2-bbc0-53f7-9fa7-3b0e82f61fd9" :question/math-academy-id "q-45486" :question/problem "Solve the equation ${5}^{x}=\\frac{1}{125}.$" :question/worked-solution "First, we rewrite $125$ as ${5}^{3}$ to get:\n\n$$\n\\begin{aligned}{5}^{x} & =\\frac{1}{125} \\\\ {5}^{x} & =\\frac{1}{{5}^{3}} \\\\ {5}^{x} & ={5}^{-3}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(5)$, we equate the exponents:\n\n$$\n\\begin{aligned}{5}^{x} & ={5}^{-3} \\\\ x & =-3\\end{aligned}\n$$\n\nTherefore, the solution is $x=-3.$"}] [{:db/id #edb/ref 17592186543490 :knowledge-point/_questions [{:db/id #edb/ref 17592186068733 :knowledge-point/id #uuid "368d83db-e01e-543b-ba45-8fc9c63242e9" :knowledge-point/title "Rearranging and Solving an Exponential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c14bd25-60b1-5db9-a5b5-db353df1d229" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186542757} {:answer/id #uuid "6a19ff45-4f16-58c5-a481-27c3e6c6c4b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2" :db/id #edb/ref 17592186542925} {:answer/id #uuid "780d7c64-0c00-5d57-b7ce-66b2f26ef78a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1" :db/id #edb/ref 17592186542957} {:answer/id #uuid "9d1f2a50-d198-5902-817a-d0db539435f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{4}" :db/id #edb/ref 17592186543053} {:answer/id #uuid "9ed9741b-2e78-58ae-b8cc-62e01e46a889" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186543060}] :answer-field/correct {:answer/id #uuid "780d7c64-0c00-5d57-b7ce-66b2f26ef78a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1" :db/id #edb/ref 17592186542957} :answer-field/id #uuid "cd01a93c-d6e2-540b-8c0d-44c14937bd8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543444}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3044149e-5bfc-5de0-b490-60c442d8ed07" :question/math-academy-id "q-45533" :question/problem "What is the solution to  $2\\cdot {8}^{y}=\\frac{1}{4}?$" :question/worked-solution "First, we isolate the term with the variable exponent by dividing both sides by $2$:\n\n$$\n\\begin{aligned}2\\cdot {8}^{y} & =\\frac{1}{4} \\\\ \\frac{2\\cdot {8}^{y}}{2} & =\\frac{(\\frac{1}{4})}{2} \\\\ {8}^{y} & =\\frac{1}{8}\\end{aligned}\n$$\n\nNow, we rewrite $\\frac{1}{8}$ as ${8}^{-1}$ to get:\n\n$$\n\\begin{aligned}{8}^{y} & =\\frac{1}{8} \\\\ {8}^{y} & ={8}^{-1}\\end{aligned}\n$$\n\nFinally, since both sides of the equation share the same base $(8)$, we equate the exponents:\n\n$$\n\\begin{aligned}{8}^{y} & ={8}^{-1} \\\\ y & =-1\\end{aligned}\n$$\n\nTherefore, the solution is $y=-1.$"}] [{:db/id #edb/ref 17592186543583 :knowledge-point/_questions [{:db/id #edb/ref 17592186068732 :knowledge-point/id #uuid "7e0c15b8-dc6e-570d-9392-4c679395cc87" :knowledge-point/title "Solving an Exponential Equation by Changing the Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "408391ae-d464-521f-b3b1-0616515cdb2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{3}" :db/id #edb/ref 17592186542814} {:answer/id #uuid "4e83f3fd-bf6e-52e8-a020-7d0bc696a11b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186542853} {:answer/id #uuid "9a86847d-23cc-55e2-bcd7-a9694dcba515" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186543046} {:answer/id #uuid "d3491e51-ea1f-58eb-85da-ce79e7691031" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3" :db/id #edb/ref 17592186543184} {:answer/id #uuid "e06b7cc3-71e1-5a4d-8b96-8f5989ac4eb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186543211}] :answer-field/correct {:answer/id #uuid "4e83f3fd-bf6e-52e8-a020-7d0bc696a11b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186542853} :answer-field/id #uuid "9ca78635-18fa-5e3d-9d10-fbb809a1f37f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543397}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "eeaf419f-60bd-5e26-a56f-c339e863386b" :question/math-academy-id "q-80" :question/problem "Solve the equation ${3}^{y}=81.$" :question/worked-solution "First, we rewrite $81$ as ${3}^{4}$ to get:\n\n$$\n\\begin{aligned}{3}^{y} & =81 \\\\ {3}^{y} & ={3}^{4}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(3)$, we equate the exponents:\n\n$$\n\\begin{aligned}{3}^{y} & ={3}^{4} \\\\ y & =4\\end{aligned}\n$$\n\nTherefore, the solution is $y=4.$"}]}
